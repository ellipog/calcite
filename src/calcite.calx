/// Calcite's server: reads server.properties, loads the vanilla data pack, listens, answers the
/// server list, and logs players in and configures them, starting up, ticking and logging as
/// vanilla's `Main`, `DedicatedServer.initServer` and `MinecraftServer.runServer` do.
///
///     calx run --release src/calcite.calx
///
/// It runs in the folder it's started from, which holds server.properties and server-icon.png,
/// as vanilla's does, and calcite.properties, Calcite's own settings. The first time, it reads the
/// vanilla data from the game's client jar, if the game is installed, or else downloads that part
/// of the jar, and keeps it in cache/, with what it makes of it, which later starts read instead
/// (D140). As with vanilla's `java -D...`, `-Dminecraft.api.env=staging` or
/// `-Dminecraft.api.discovery.host=URL` on its command line picks the Mojang services it uses.
///
/// With `record-inputs=true` in calcite.properties, it records everything it's handed to a new
/// input log in recordings/. `--replay FILE` starts it from the same folder, with what that log
/// recorded where the network, the clock, Mojang's services and the system's random numbers would
/// be, and checks it sends and logs what it did as it was recorded: it says what it found, and
/// fails if it went another way (D21).
module calcite

import auth.services.{Environment, Services}
import chat.chat_type.{load_chat_types}
import chat.component.{Component}
import chat.language.{Language}
import pack.resources.{Pack, Resources}
import pack.vanilla.{data_path, vanilla_data, vanilla_language}
import protocol.ids.{game_version}
import registry.registries.{Registries}
import resources.identifier.{Identifier}
import server.boot.{Boot, cache_key, cache_path, load_boot, save_boot}
import server.config.{CalciteConfig, default_text}
import server.configuration.{CodeOfConduct, Configuration, ResourcePack, read_codes, resource_pack, server_links}
import server.link.{Link}
import server.log.{Entry, Level, log}
import server.network.{LoginSettings, Network, StatusInfo}
import server.play.{World, parse_seed, random_seed}
import server.properties.{ServerProperties, load}
import server.status.{ServerStatus, check_icon}
import std.crypto.{RsaKey}
import std.env.{args}
import std.fs.{append, is_file, make_dir_all, read, write}
import std.net.{Net, Event, NetError}
import std.thread.{Task}
import std.time.{Instant, Timestamp}

// Makes the server's key pair, on its own thread, so the server needn't wait for it to listen.
struct KeyMaker {
    out: Sender<RsaKey>
}

impl Task for KeyMaker {
    fn run(own self) {
        var out = self.out
        out.send(RsaKey.generate(1024))
    }
}

// Appends what the server's link records to the input log at `path`, on its own thread, so the
// server never waits for the disk. A piece that can't be written ends the log there, which is
// logged.
struct Recorder {
    path: String
    pieces: Receiver<List<u8>>
}

impl Task for Recorder {
    fn run(own self) {
        let path = self.path
        var pieces = self.pieces
        while let piece = pieces.wait() {
            match append(path, piece) {
                ok => {},
                err(_) => {
                    log("Recorder", Level.Error, "Failed to record inputs to {path}")
                    return
                },
            }
        }
    }
}

// The thread vanilla's lines name: `main` until the server starts, then `Server thread`.
fn main_log(e: Entry) {
    log("main", e.level, e.message)
}

fn info(message: String) {
    log("Server thread", Level.Info, message)
}

fn warn(message: String) {
    log("Server thread", Level.Warn, message)
}

fn error(message: String) {
    log("Server thread", Level.Error, message)
}

// What Java's `toString` of the bind's exception says, as near as the system's error allows.
fn bind_error(e: NetError) -> String {
    return match e {
        NetError.AddressInUse => String("java.net.BindException: Address already in use: bind"),
        NetError.BadAddress => String("java.net.UnknownHostException: no such host"),
        NetError.Refused => String("java.net.ConnectException: Connection refused"),
        NetError.Os(code) => "java.net.SocketException: error {code}",
    }
}

// The server icon from server-icon.png, if it's there and a 64 by 64 PNG, as vanilla's
// `loadStatusIcon` reads it.
fn status_icon() -> List<u8>? {
    let path = String("server-icon.png")
    if not is_file(path) {
        return none
    }
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            error("Couldn't load server icon: java.nio.file.AccessDeniedException: {path}")
            return none
        },
    }
    return match check_icon(bytes) {
        ok(png) => some(png),
        err(message) => {
            error(message)
            none
        },
    }
}

// The status, as vanilla's `buildServerStatus` makes it as the server starts. The network
// rebuilds it every 5 seconds.
fn status_info(props: ServerProperties, icon: own List<u8>?) -> StatusInfo {
    return StatusInfo { enabled: props.enable_status, status: ServerStatus.starting(Component.literal(props.motd), props.max_players, icon), motd: props.motd.copy() }
}

// calcite.properties, written with each setting at its default where there's none, or `none`
// where it can't be read or its settings stop the server, which is logged.
fn calcite_config() -> CalciteConfig? {
    let path = String("calcite.properties")
    if not is_file(path) {
        match write(path, default_text().to_bytes()) {
            ok => {},
            err(_) => log("main", Level.Warn, "Failed to save {path}"),
        }
        return some(CalciteConfig.defaults())
    }
    var problem: Entry? = none
    let file = match load(path, mut problem) {
        ok(p) => p,
        err(message) => {
            if let e = problem {
                main_log(e)
            }
            log("main", Level.Error, "Failed to start the minecraft server: {path}: {message}")
            return none
        },
    }
    if let e = problem {
        main_log(e)
    }
    let config = CalciteConfig.from(file)
    if let message = config.problem() {
        log("main", Level.Error, "Failed to start the minecraft server: {message}")
        return none
    }
    return some(config)
}

// The input log the command line names with `--replay FILE`.
fn replay_path(arguments: List<String>) -> String? {
    for i in 1..arguments.len() {
        if arguments[i - 1] == "--replay" {
            return some(arguments[i].copy())
        }
    }
    return none
}

// A link replaying the input log at `path`, which fails if it can't be read or isn't one.
fn replay_link(path: String) -> Link ! String {
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            fail "can't read the input log {path}"
        },
    }
    return match Link.replay(bytes) {
        ok(link) => link,
        err(message) => {
            fail "can't replay {path}: {message}"
        },
    }
}

fn two(n: i32) -> String {
    return if n < 10 { "0{n}" } else { "{n}" }
}

// A link recording what the server is handed to a new input log in recordings/, named for the
// day as vanilla names its old logs, `2026-10-28-1.inputs` and on, which the `Recorder` thread
// writes to. If the log can't be started, that's logged, and the server runs without one.
fn record_link(net: Net, recorder: mut Sender<List<u8>>?) -> Link {
    let now = unsafe { Timestamp.now() }
    let t = now.date_time(unsafe { now.local_offset() })
    let day = "{t.year}-{two(t.month)}-{two(t.day)}"
    var n = 1
    while is_file("recordings/{day}-{n}.inputs") {
        n += 1
    }
    let path = "recordings/{day}-{n}.inputs"
    var link = Link.record(net)
    let started = match make_dir_all("recordings") {
        ok => match write(path, link.take_log()) {
            ok => true,
            err(_) => false,
        },
        err(_) => false,
    }
    if not started {
        log("main", Level.Warn, "Failed to record inputs to {path}")
        return Link.live(net)
    }
    log("main", Level.Warn, "Recording every input to {path}, which holds what players send and the server's private key")
    let pieces = Receiver<List<u8>>()
    recorder = some(pieces.sender())
    _ = unsafe { Thread.spawn(Recorder { path: path, pieces: pieces }) }
    return link
}

// The value of the system property `name`, as Java's `-Dname=value` sets it: the last one given.
fn system_property(arguments: List<String>, name: String) -> String? {
    let prefix = "-D{name}="
    var value: String? = none
    for a in arguments {
        if a.starts_with(prefix) {
            value = some(a[prefix.len()..])
        }
    }
    return value
}

// What the data packs make: so far from the vanilla pack alone, from the stretch of Mojang's
// client jar that holds it. They load before the server starts, as vanilla's `Main` loads them,
// and what goes wrong stops it, as there, with what it logged. The server's language, which
// vanilla's `Language` reads from its jar as it starts, comes from the same data. What they make
// is kept in the boot cache, which later starts with the same build and data read instead, with
// the lines loading them logged, so they show as they did (D140).
fn load_data() -> Boot? {
    let key = cache_key()
    if let boot = load_boot(cache_path(), key) {
        for e in boot.logs {
            main_log(e)
        }
        return some(boot)
    }
    var lines = List<Entry>()
    let pack = match vanilla_data(data_path(), mut lines) {
        ok(p) => p,
        err(message) => {
            for e in lines {
                main_log(e)
            }
            log("main", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    for e in lines {
        main_log(e)
    }
    var made = List<Entry>()
    let language = match vanilla_language(pack, mut made) {
        ok(l) => l,
        err(message) => {
            for e in made {
                main_log(e)
            }
            log("main", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    let packs: List<Pack> = [pack]
    let resources = Resources.new(packs)
    let loaded = Registries.load(resources, mut made)
    for e in made {
        main_log(e)
    }
    let registries = loaded else {
        log("main", Level.Warn, "Failed to load datapacks, can't proceed with server load. You can either fix your datapacks or reset to vanilla with --safeMode")
        return none
    }
    let chat_types = match load_chat_types(resources, registries) {
        ok(c) => c,
        err(message) => {
            log("main", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    let boot = Boot { language: language, registries: registries, chat_types: chat_types, packs: resources.pack_info(), logs: made }
    match save_boot(cache_path(), key, boot) {
        ok => {},
        err(message) => log("main", Level.Warn, message),
    }
    return some(boot)
}

// What configuration sends every player, from the data packs, the server's language, and its
// world. Then the server's links and its code of conduct, which vanilla's `DedicatedServer`
// reads as it's made, the resource pack it offers, from server.properties.
fn load_configuration(props: ServerProperties, seed: i64, offer: own ResourcePack?, language: mut Language, world: mut World?) -> Configuration? {
    let boot = load_data() else return none
    language = boot.language
    let registries = boot.registries
    var warnings = List<Entry>()
    let links = server_links(props, mut warnings)
    for e in warnings {
        main_log(e)
    }
    var codes = List<CodeOfConduct>()
    if props.enable_code_of_conduct {
        codes = match read_codes("codeofconduct") {
            ok(c) => c,
            err(exception) => {
                log("main", Level.Error, "Failed to start the minecraft server: {exception}")
                return none
            },
        }
    }
    let features: List<Identifier> = [Identifier { namespace: "minecraft", path: "vanilla" }]
    match World.load(props, seed, registries, boot.chat_types) {
        ok(w) => world = some(w),
        err(message) => {
            log("main", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    var configuration = Configuration.new("calcite", links, features, registries, boot.packs)
    configuration.codes = codes
    configuration.pack = offer
    return some(configuration)
}

// A duration as Java's `String.format("%.3fs", seconds)` writes it.
fn seconds(ns: u64) -> String {
    let ms = (ns + 500000) / 1000000
    let frac = ms % 1000
    let pad = if frac < 10 { "00" } else if frac < 100 { "0" } else { "" }
    return "{ms / 1000}.{pad}{frac}s"
}

fn main() ! String {
    let arguments = args()
    let replaying = replay_path(arguments)
    var problem: Entry? = none
    let file = match load("server.properties", mut problem) {
        ok(p) => p,
        err(message) => {
            if let e = problem {
                main_log(e)
            }
            log("main", Level.Error, "Failed to start the minecraft server: java.lang.IllegalArgumentException: {message}")
            return
        },
    }
    if let e = problem {
        main_log(e)
    }
    let props = ServerProperties.from(file)
    var pack_warnings = List<Entry>()
    let pack = resource_pack(props, mut pack_warnings)
    for e in pack_warnings {
        main_log(e)
    }
    let config = calcite_config() else return

    // Everything from outside goes through the link (D21): the network's, or the input log's
    // when replaying, with no network.
    let start = unsafe { Instant.now() }
    var net: Net? = none
    var recorder: Sender<List<u8>>? = none
    var made: Link? = none
    if let path = replaying {
        made = some(try replay_link(path))
    } else {
        let n = match Net.new() {
            ok(n) => n,
            err(e) => {
                error("Failed to start the network: {bind_error(e)}")
                return
            },
        }
        made = some(if config.record_inputs { record_link(n, mut recorder) } else { Link.live(n) })
        net = some(n)
    }
    var link = made else return
    // Vanilla draws a random seed as it reads server.properties, if `level-seed` is empty.
    let seed = parse_seed(props.level_seed) ?? random_seed(link.random(8))

    // Mojang's services are found as vanilla's `Main` finds them, before the server starts, and
    // the discovery document is fetched while it does.
    let environment = Environment.from_properties(system_property(arguments, "minecraft.api.env"), system_property(arguments, "minecraft.api.discovery.host"))
    log("main", Level.Info, "Environment: {environment.to_string()}")
    var services = Services.new(environment)
    var fetched = List<Entry>()
    services.tick(0, mut fetched, mut link)
    for e in fetched {
        log(e.thread_or("main"), e.level, e.message)
    }
    var language = Language.empty()
    var loaded_world: World? = none
    let configuration = load_configuration(props, seed, pack, mut language, mut loaded_world) else return
    let world = loaded_world else return

    info("Starting minecraft server version {game_version()}")
    info("Loading properties")
    let settings = LoginSettings {
        online_mode: props.online_mode,
        accepts_transfers: props.accepts_transfers,
        compression_threshold: props.network_compression_threshold,
        log_ips: props.log_ips,
        prevent_proxy_connections: props.prevent_proxy_connections,
        velocity_secret: if config.velocity_forwarding { some(config.velocity_secret.copy()) } else { none },
        rate_limit: props.rate_limit,
        login_throttle: config.login_throttle,
    }
    // Vanilla makes the key pair here, before it listens. Calcite starts making it, and lets the
    // first online login wait for it. A replay has the recording's.
    info("Generating keypair")
    let keys = Receiver<RsaKey>()
    if replaying == none {
        _ = unsafe { Thread.spawn(KeyMaker { out: keys.sender() }) }
    }
    var network = Network.new(link, status_info(props, none), settings, language, services, keys, configuration, world)
    let host = if props.server_ip.is_empty() { String("*") } else { props.server_ip.copy() }
    info("Starting Minecraft server on {host}:{props.server_port}")
    let port = u16.try_from(props.server_port) ?? 0
    if port == 0 and props.server_port != 0 {
        warn("**** FAILED TO BIND TO PORT!")
        warn("The exception was: java.lang.IllegalArgumentException: port out of range:{props.server_port}")
        warn("Perhaps a server is already running on that port?")
        return
    }
    match network.listen(props.server_ip, port) {
        ok(_) => {},
        err(e) => {
            warn("**** FAILED TO BIND TO PORT!")
            warn("The exception was: {bind_error(e)}")
            warn("Perhaps a server is already running on that port?")
            return
        },
    }
    if config.velocity_forwarding {
        info("Velocity modern forwarding is on: players are let in only through the Velocity proxy, which authenticates them")
    } else if not props.online_mode {
        warn("**** SERVER IS RUNNING IN OFFLINE/INSECURE MODE!")
        warn("The server will make no attempt to authenticate usernames. Beware.")
        warn("While this makes the game possible to play without internet access, it also opens up the ability for hackers to connect with any username they choose.")
        warn("To change this, set \"online-mode\" to \"true\" in the server.properties file.")
    }
    info("Done ({seconds(unsafe { Instant.now() }.nanos_since(start))})! For help, type \"help\"")
    let icon = status_icon()
    if icon != none {
        network.set_status(status_info(props, icon))
    }

    if let path = replaying {
        try replay(mut network, path)
        return
    }
    run(net!, mut network, start, mut recorder)
}

// Replays the rest of the input log at `path`, logging what the server logs, then what the replay
// found. A replay that went another way than the recording fails, with where it first did.
fn replay(network: mut Network, path: String) ! String {
    while network.replay_step() {
        for e in network.take_logs() {
            log(e.thread_or("Server thread"), e.level, e.message)
        }
    }
    let report = network.report()
    if not report.same() {
        fail "the replay of {path} went another way: {report.to_string()}"
    }
    info("Replayed {path}: {report.to_string()}")
}

// 50 ms, the length of a tick at 20 ticks a second.
const TICK_NS: u64 = 50000000

// The server's ticks, 20 a second, with the network's events handled as they come between them,
// as vanilla's `runServer` runs them. A server more than 2 seconds behind warns, at most once in
// 15 seconds, and skips the ticks it missed. What the link records goes to `recorder`, after each
// turn of the loop.
fn run(net: Net, network: mut Network, start: Instant, recorder: mut Sender<List<u8>>?) {
    var events = List<Event>()
    var next = unsafe { Instant.now() }.nanos_since(start) + TICK_NS
    var last_warning: u64 = 0
    loop {
        let before = unsafe { Instant.now() }.nanos_since(start)
        let wait = if next > before { i64.wrap((next - before + 999999) / 1000000) } else { 0 }
        net.poll(wait, mut events)
        let now = unsafe { Instant.now() }.nanos_since(start)
        network.set_clock(unsafe { Timestamp.now() })
        for e in events {
            _ = network.handle(e, now)
        }
        if now >= next {
            let behind = now - next
            if behind > 2000000000 and (last_warning == 0 or next - last_warning >= 15000000000) {
                let ticks = behind / TICK_NS
                warn("Can't keep up! Is the server overloaded? Running {behind / 1000000}ms or {ticks} ticks behind")
                next += ticks * TICK_NS
                last_warning = next
            }
            next += TICK_NS
            network.tick(now)
            network.sweep(now)
        }
        for e in network.take_logs() {
            log(e.thread_or("Server thread"), e.level, e.message)
        }
        if let to = recorder.take() {
            var out = to
            out.send(network.take_log())
            recorder = some(out)
        }
    }
}
