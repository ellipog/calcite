/// Calcite's server: reads server.properties, loads the vanilla data pack, listens, answers the
/// server list, and logs players in and configures them, starting up, ticking and logging as
/// vanilla's `Main`, `DedicatedServer.initServer` and `MinecraftServer.runServer` do.
///
///     calx run --release src/calcite.calx
///
/// It runs in the folder it's started from, which holds server.properties and server-icon.png,
/// as vanilla's does, and calcite.properties, Calcite's own settings. The first time, it
/// downloads Mojang's server jar, for the data pack in it, to cache/. As with vanilla's `java -D...`, `-Dminecraft.api.env=staging` or
/// `-Dminecraft.api.discovery.host=URL` on its command line picks the Mojang services it uses.
module calcite

import auth.services.{Environment, Services}
import chat.component.{Component}
import chat.language.{Language}
import pack.resources.{Pack, Resources}
import pack.vanilla.{jar_path, vanilla_pack}
import protocol.common.{ServerLink}
import protocol.ids.{PROTOCOL_VERSION, game_version}
import registry.registries.{Registries}
import resources.identifier.{Identifier}
import server.config.{CalciteConfig, default_text}
import server.configuration.{Configuration}
import server.log.{Entry, Level, log}
import server.network.{Network, StatusInfo, LoginSettings}
import server.properties.{ServerProperties, load}
import server.status.{ServerStatus, check_icon}
import std.crypto.{RsaKey}
import std.env.{args}
import std.fs.{is_file, read, write}
import std.net.{Net, Event, NetError}
import std.time.{Instant}

// The thread vanilla's lines name: `main` until the server starts, then `Server thread`.
fn main_log(e: Entry) {
    log("main", e.level, e.message)
}

fn info(message: String) {
    log("Server thread", Level.Info, message)
}

fn warn(message: String) {
    log("Server thread", Level.Warn, message)
}

fn error(message: String) {
    log("Server thread", Level.Error, message)
}

// What Java's `toString` of the bind's exception says, as near as the system's error allows.
fn bind_error(e: NetError) -> String {
    return match e {
        NetError.AddressInUse => String("java.net.BindException: Address already in use: bind"),
        NetError.BadAddress => String("java.net.UnknownHostException: no such host"),
        NetError.Refused => String("java.net.ConnectException: Connection refused"),
        NetError.Os(code) => "java.net.SocketException: error {code}",
    }
}

// The server icon from server-icon.png, if it's there and a 64 by 64 PNG, as vanilla's
// `loadStatusIcon` reads it.
fn status_icon() -> List<u8>? {
    let path = String("server-icon.png")
    if not is_file(path) {
        return none
    }
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            error("Couldn't load server icon: java.nio.file.AccessDeniedException: {path}")
            return none
        },
    }
    return match check_icon(bytes) {
        ok(png) => some(png),
        err(message) => {
            error(message)
            none
        },
    }
}

// The status, as vanilla's `buildServerStatus` makes it. No one can join yet, so no one is
// online, and secure chat isn't enforced until signed chat is written.
fn status_info(props: ServerProperties, icon: own List<u8>?) -> StatusInfo {
    let status = ServerStatus {
        description: Component.literal(props.motd),
        max_players: props.max_players,
        online: 0,
        sample: [],
        version_name: game_version(),
        protocol: PROTOCOL_VERSION,
        favicon: icon,
        enforces_secure_chat: false,
    }
    return StatusInfo { enabled: props.enable_status, json: status.to_json(), motd: props.motd.copy(), online: 0, max_players: props.max_players }
}

// calcite.properties, written with each setting at its default where there's none, or `none`
// where it can't be read or its settings stop the server, which is logged.
fn calcite_config() -> CalciteConfig? {
    let path = String("calcite.properties")
    if not is_file(path) {
        match write(path, default_text().to_bytes()) {
            ok => {},
            err(_) => log("main", Level.Warn, "Failed to save {path}"),
        }
        return some(CalciteConfig.defaults())
    }
    var problem: Entry? = none
    let file = match load(path, mut problem) {
        ok(p) => p,
        err(message) => {
            if let e = problem {
                main_log(e)
            }
            log("main", Level.Error, "Failed to start the minecraft server: {path}: {message}")
            return none
        },
    }
    if let e = problem {
        main_log(e)
    }
    let config = CalciteConfig.from(file)
    if let message = config.problem() {
        log("main", Level.Error, "Failed to start the minecraft server: {message}")
        return none
    }
    return some(config)
}

// The value of the system property `name`, as Java's `-Dname=value` sets it: the last one given.
fn system_property(arguments: List<String>, name: String) -> String? {
    let prefix = "-D{name}="
    var value: String? = none
    for a in arguments {
        if a.starts_with(prefix) {
            value = some(a[prefix.len()..])
        }
    }
    return value
}

// What configuration sends every player, from the data packs: so far the vanilla pack alone,
// from Mojang's server jar, which is downloaded the first time. They load before the server
// starts, as vanilla's `Main` loads them, and what goes wrong stops it, as there.
fn load_configuration() -> Configuration? {
    var lines = List<Entry>()
    let pack = match vanilla_pack(jar_path(), true, mut lines) {
        ok(p) => p,
        err(message) => {
            for e in lines {
                main_log(e)
            }
            log("main", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    let packs: List<Pack> = [pack]
    let resources = Resources.new(packs)
    let loaded = Registries.load(resources, mut lines)
    for e in lines {
        main_log(e)
    }
    let registries = loaded else {
        log("main", Level.Warn, "Failed to load datapacks, can't proceed with server load. You can either fix your datapacks or reset to vanilla with --safeMode")
        return none
    }
    let links = List<ServerLink>()
    let features: List<Identifier> = [Identifier { namespace: "minecraft", path: "vanilla" }]
    return some(Configuration.new("calcite", links, features, registries, resources.pack_info()))
}

// A duration as Java's `String.format("%.3fs", seconds)` writes it.
fn seconds(ns: u64) -> String {
    let ms = (ns + 500000) / 1000000
    let frac = ms % 1000
    let pad = if frac < 10 { "00" } else if frac < 100 { "0" } else { "" }
    return "{ms / 1000}.{pad}{frac}s"
}

fn main() {
    var problem: Entry? = none
    let file = match load("server.properties", mut problem) {
        ok(p) => p,
        err(message) => {
            if let e = problem {
                main_log(e)
            }
            log("main", Level.Error, "Failed to start the minecraft server: java.lang.IllegalArgumentException: {message}")
            return
        },
    }
    if let e = problem {
        main_log(e)
    }
    let props = ServerProperties.from(file)
    let config = calcite_config() else return

    // Mojang's services are found as vanilla's `Main` finds them, before the server starts, and
    // the discovery document is fetched while it does.
    let start = unsafe { Instant.now() }
    let arguments = args()
    let environment = Environment.from_properties(system_property(arguments, "minecraft.api.env"), system_property(arguments, "minecraft.api.discovery.host"))
    log("main", Level.Info, "Environment: {environment.to_string()}")
    var services = Services.new(environment)
    var fetched = List<Entry>()
    services.tick(0, mut fetched)
    for e in fetched {
        log(e.thread_or("main"), e.level, e.message)
    }
    let configuration = load_configuration() else return

    info("Starting minecraft server version {game_version()}")
    info("Loading properties")
    let net = match Net.new() {
        ok(n) => n,
        err(e) => {
            error("Failed to start the network: {bind_error(e)}")
            return
        },
    }
    let settings = LoginSettings {
        online_mode: props.online_mode,
        accepts_transfers: props.accepts_transfers,
        compression_threshold: props.network_compression_threshold,
        log_ips: props.log_ips,
        prevent_proxy_connections: props.prevent_proxy_connections,
        velocity_secret: if config.velocity_forwarding { some(config.velocity_secret.copy()) } else { none },
    }
    info("Generating keypair")
    let key = RsaKey.generate(1024)
    var network = Network.new(net, status_info(props, none), settings, Language.empty(), services, key, configuration)
    let host = if props.server_ip.is_empty() { String("*") } else { props.server_ip.copy() }
    info("Starting Minecraft server on {host}:{props.server_port}")
    let port = u16.try_from(props.server_port) ?? 0
    if port == 0 and props.server_port != 0 {
        warn("**** FAILED TO BIND TO PORT!")
        warn("The exception was: java.lang.IllegalArgumentException: port out of range:{props.server_port}")
        warn("Perhaps a server is already running on that port?")
        return
    }
    match network.listen(props.server_ip, port) {
        ok(_) => {},
        err(e) => {
            warn("**** FAILED TO BIND TO PORT!")
            warn("The exception was: {bind_error(e)}")
            warn("Perhaps a server is already running on that port?")
            return
        },
    }
    if config.velocity_forwarding {
        info("Velocity modern forwarding is on: players are let in only through the Velocity proxy, which authenticates them")
    } else if not props.online_mode {
        warn("**** SERVER IS RUNNING IN OFFLINE/INSECURE MODE!")
        warn("The server will make no attempt to authenticate usernames. Beware.")
        warn("While this makes the game possible to play without internet access, it also opens up the ability for hackers to connect with any username they choose.")
        warn("To change this, set \"online-mode\" to \"true\" in the server.properties file.")
    }
    info("Done ({seconds(unsafe { Instant.now() }.nanos_since(start))})! For help, type \"help\"")
    let icon = status_icon()
    if icon != none {
        network.set_status(status_info(props, icon))
    }

    // Vanilla rebuilds the status every 5 seconds, for its player counts and sample. Nothing in
    // it changes yet, so it's built once.
    run(net, mut network, start)
}

// 50 ms, the length of a tick at 20 ticks a second.
const TICK_NS: u64 = 50000000

// The server's ticks, 20 a second, with the network's events handled as they come between them,
// as vanilla's `runServer` runs them. A server more than 2 seconds behind warns, at most once in
// 15 seconds, and skips the ticks it missed.
fn run(net: Net, network: mut Network, start: Instant) {
    var events = List<Event>()
    var next = unsafe { Instant.now() }.nanos_since(start) + TICK_NS
    var last_warning: u64 = 0
    loop {
        let before = unsafe { Instant.now() }.nanos_since(start)
        let wait = if next > before { i64.wrap((next - before + 999999) / 1000000) } else { 0 }
        net.poll(wait, mut events)
        let now = unsafe { Instant.now() }.nanos_since(start)
        for e in events {
            _ = network.handle(e, now)
        }
        if now >= next {
            let behind = now - next
            if behind > 2000000000 and (last_warning == 0 or next - last_warning >= 15000000000) {
                let ticks = behind / TICK_NS
                warn("Can't keep up! Is the server overloaded? Running {behind / 1000000}ms or {ticks} ticks behind")
                next += ticks * TICK_NS
                last_warning = next
            }
            next += TICK_NS
            network.tick(now)
            network.sweep(now)
        }
        for e in network.take_logs() {
            log(e.thread_or("Server thread"), e.level, e.message)
        }
    }
}
