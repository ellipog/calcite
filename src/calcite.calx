// Makes the server's key pair, on its own thread, so the server needn't wait for it to listen.
struct KeyMaker {
    out: Sender<RsaKey>
}

impl Task for KeyMaker {
    fn run(own self) {
        var out = self.out
        out.send(RsaKey.generate(1024))
    }
}

// Appends what the server's link records to the input log at `path`, on its own thread, so the
// server never waits for the disk. A piece that can't be written ends the log there, which is
// logged.
struct Recorder {
    path: String
    pieces: Receiver<List<u8>>
    out: Log
}

impl Task for Recorder {
    fn run(own self) {
        let path = self.path
        var pieces = self.pieces
        var out = self.out
        while let piece = pieces.wait() {
            match append(path, piece) {
                ok => {},
                err(_) => {
                    out.log("Recorder", Level.Error, "Failed to record inputs to {path}")
                    return
                },
            }
        }
    }
}

// The thread vanilla's lines name: `ServerMain` until the server starts, then `Server thread`.
fn main_log(out: mut Log, e: Entry) {
    out.entry("ServerMain", e)
}

fn info(out: mut Log, message: String) {
    out.log("Server thread", Level.Info, message)
}

fn error(out: mut Log, message: String) {
    out.log("Server thread", Level.Error, message)
}

// A line on the server thread that Calcite's style shows as `look`.
fn say(out: mut Log, level: Level, message: String, look: own Look) {
    out.write("Server thread", level, message, look)
}

// Why the server couldn't listen, in Calcite's words.
fn bind_words(e: NetError) -> String {
    return match e {
        NetError.AddressInUse => String("something else is listening there, such as another server"),
        NetError.BadAddress => String("server-ip isn't an address of this machine"),
        NetError.Refused => String("the system refused"),
        NetError.Os(code) => "the system's error {code}",
    }
}

// A duration in milliseconds, to a tenth.
fn millis(ns: u64) -> String {
    let tenths = (ns + 50000) / 100000
    return "{tenths / 10}.{tenths % 10} ms"
}

// What Java's `toString` of the bind's exception says, as near as the system's error allows.
fn bind_error(e: NetError) -> String {
    return match e {
        NetError.AddressInUse => String("java.net.BindException: Address already in use: bind"),
        NetError.BadAddress => String("java.net.UnknownHostException: no such host"),
        NetError.Refused => String("java.net.ConnectException: Connection refused"),
        NetError.Os(code) => "java.net.SocketException: error {code}",
    }
}

// The server icon from server-icon.png, if it's there and a 64 by 64 PNG, as vanilla's
// `loadStatusIcon` reads it.
fn status_icon(out: mut Log) -> List<u8>? {
    let path = String("server-icon.png")
    if not is_file(path) {
        return none
    }
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            error(mut out, "Couldn't load server icon: java.nio.file.AccessDeniedException: {path}")
            return none
        },
    }
    return match check_icon(bytes) {
        ok(png) => some(png),
        err(message) => {
            error(mut out, message)
            none
        },
    }
}

// The status, as vanilla's `buildServerStatus` makes it as the server starts. The network
// rebuilds it every 5 seconds.
fn status_info(props: ServerProperties, icon: own List<u8>?) -> StatusInfo {
    return StatusInfo { enabled: props.enable_status, status: ServerStatus.starting(Component.literal(props.motd), props.max_players, icon), motd: props.motd.copy() }
}

// calcite.properties, written with each setting at its default where there's none, or `none`
// where it can't be read or its settings stop the server, which is logged.
fn calcite_config(out: mut Log) -> CalciteConfig? {
    let path = String("calcite.properties")
    if not is_file(path) {
        match write(path, default_text().to_bytes()) {
            ok => {},
            err(_) => out.log("ServerMain", Level.Warn, "Failed to save {path}"),
        }
        return some(CalciteConfig.defaults())
    }
    var problem: Entry? = none
    let file = match load(path, mut problem) {
        ok(p) => p,
        err(message) => {
            if let e = problem {
                main_log(mut out, e)
            }
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {path}: {message}")
            return none
        },
    }
    if let e = problem {
        main_log(mut out, e)
    }
    let config = CalciteConfig.from(file)
    if let message = config.problem() {
        out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {message}")
        return none
    }
    return some(config)
}

// Writes server.properties back as vanilla's `Settings.store` does as it starts, with the date
// in Java's words, or logs vanilla's error. Whether it was written.
fn store_properties(out: mut Log, p: Properties) -> bool {
    let now = unsafe { Timestamp.now() }
    let offset = unsafe { now.local_offset() }
    let date = to_string(now, offset, zone_name(unsafe { now.zone_abbreviation() }, offset))
    match write("server.properties", p.store(some(String("Minecraft server properties")), date).to_bytes()) {
        ok => return true,
        err(_) => {
            out.log("ServerMain", Level.Error, "Failed to store properties to file: server.properties")
            return false
        },
    }
}

// The file the command line names after `name`, as with `--replay FILE`.
fn flag(arguments: List<String>, name: String) -> String? {
    for i in 1..arguments.len() {
        if arguments[i - 1] == name {
            return some(arguments[i].copy())
        }
    }
    return none
}

// A link replaying the input log at `path`, which fails if it can't be read or isn't one.
fn replay_link(path: String) -> Link ! String {
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            fail "can't read the input log {path}"
        },
    }
    return match Link.replay(bytes) {
        ok(link) => link,
        err(message) => {
            fail "can't replay {path}: {message}"
        },
    }
}

fn two(n: i32) -> String {
    return if n < 10 { "0{n}" } else { "{n}" }
}

// A link recording what the server is handed to a new input log in recordings/, named for the
// day as vanilla names its old logs, `2026-10-28-1.inputs` and on, which the `Recorder` thread
// writes to. If the log can't be started, that's logged, and the server runs without one.
fn record_link(net: Net, recorder: mut Sender<List<u8>>?, writer: mut Thread?, out: mut Log) -> Link {
    let now = unsafe { Timestamp.now() }
    let t = now.date_time(unsafe { now.local_offset() })
    let day = "{t.year}-{two(t.month)}-{two(t.day)}"
    var n = 1
    while is_file("recordings/{day}-{n}.inputs") {
        n += 1
    }
    let path = "recordings/{day}-{n}.inputs"
    var link = Link.record(net)
    let started = match make_dir_all("recordings") {
        ok => match write(path, link.take_log()) {
            ok => true,
            err(_) => false,
        },
        err(_) => false,
    }
    if not started {
        out.log("ServerMain", Level.Warn, "Failed to record inputs to {path}")
        return Link.live(net)
    }
    out.log("ServerMain", Level.Warn, "Recording every input to {path}, which holds what players send and the server's private key")
    let pieces = Receiver<List<u8>>()
    recorder = some(pieces.sender())
    writer = some(unsafe { Thread.spawn(Recorder { path: path, pieces: pieces, out: out.share() }) })
    return link
}

// The value of the system property `name`, as Java's `-Dname=value` sets it: the last one given.
fn system_property(arguments: List<String>, name: String) -> String? {
    let prefix = "-D{name}="
    var value: String? = none
    for a in arguments {
        if a.starts_with(prefix) {
            value = some(a[prefix.len()..])
        }
    }
    return value
}

// What the data packs make: vanilla's, from the stretch of Mojang's client jar that holds it,
// with its feature packs, and the world's own, in its `datapacks` folder, found and picked as
// vanilla's `PackRepository` and `configurePackRepository` find and pick them (D190). They load
// before the server starts, as vanilla's `Main` loads them, and what goes wrong stops it, as
// there, with what it logged. The server's language, which vanilla's `Language` reads from its
// jar as it starts, comes from the same data. What they make is kept in the boot cache, which
// later starts with the same build, data and packs read instead, with the lines loading them
// logged, so they show as they did (D140). Packs with a link among them aren't kept.
fn load_data(setup: Setup, allow: mut AllowList, out: mut Log) -> Boot? {
    var key: String? = none
    if let stamp = fingerprint(setup) {
        key = some(cache_key(stamp))
    }
    if let k = key {
        if let boot = load_boot(cache_path(), k) {
            for e in boot.logs {
                main_log(mut out, e)
            }
            return some(boot)
        }
    }
    var lines = List<Entry>()
    let zip = match vanilla_data(data_path(), mut lines) {
        ok(p) => p,
        err(message) => {
            for e in lines {
                main_log(mut out, e)
            }
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    for e in lines {
        main_log(mut out, e)
    }
    var made = List<Entry>()
    let language = match vanilla_language(zip, mut made) {
        ok(l) => l,
        err(message) => {
            for e in made {
                main_log(mut out, e)
            }
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    let repository = discover(zip, setup, mut allow, mut made)
    let selection = repository.select(setup, mut made)
    let selected = selection.packs.copy()
    let features = selection.features
    let resources = repository.open(selection, mut made)
    let loaded = load_registries(resources, some(language.copy()), mut made)
    for e in made {
        main_log(mut out, e)
    }
    let registries = loaded else {
        out.log("ServerMain", Level.Warn, "Failed to load datapacks, can't proceed with server load. You can either fix your datapacks or reset to vanilla with --safeMode")
        return none
    }
    let chat_types = match load_chat_types(resources, registries) {
        ok(c) => c,
        err(message) => {
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    let boot = Boot { language: language, registries: registries, chat_types: chat_types, packs: resources.pack_info(), selected: selected, features: features, logs: made }
    if let k = key {
        match save_boot(cache_path(), k, boot) {
            ok => {},
            err(message) => out.log("ServerMain", Level.Warn, message),
        }
    }
    return some(boot)
}

// The worldgen data of a world whose packs aren't only vanilla's: each file of `worldgen/` and
// `structure/` from the top pack that has it, as the registries are read, or `none` if it has no
// packs but vanilla's, or they can't be opened again, as they were when they loaded (CAL-92). The
// packs are found and opened again, which a start from the boot cache didn't, and what that logs
// was logged as they loaded.
fn world_data_of(setup: Setup, boot: Boot, allow: mut AllowList) -> Shared<Data>? {
    var owned = false
    for id in boot.selected.enabled {
        owned = owned or id.starts_with("file/")
    }
    if not owned {
        return none
    }
    var lines = List<Entry>()
    let zip = match vanilla_data(data_path(), mut lines) {
        ok(z) => z,
        err(_) => return none,
    }
    let repository = discover(zip, setup, mut allow, mut lines)
    let selection = repository.select(setup, mut lines)
    let resources = repository.open(selection, mut lines)
    let dirs: List<(String, String)> = [(String("worldgen"), String(".json")), (String("structure"), String(".nbt")), (String("dimension"), String(".json"))]
    return some(Shared(resources.data(dirs)))
}

// The world's dimensions as it runs with them, `WorldDimensions.bake`: each of `stems`, the world's
// settings', unless its packs have one of the same ID in `dimension/`, which stands in for it, as
// a world's packs' do every time it starts, without changing what's saved (CAL-92). A pack's that
// isn't JSON is left out here: the registries' loading would have stopped the server for it.
fn baked_stems(stems: JavaHashMap<String, Tag>, data: Shared<Data>?) -> JavaHashMap<String, Tag> {
    var out = stems.copy()
    let d = data else return out
    for i in 0..d.value.len() {
        let path = d.value.name(i)
        // `data/<namespace>/dimension/<path>.json`
        if not path.starts_with("data/") or not path.ends_with(".json") {
            continue
        }
        let rest = path[5..]
        let slash = rest.find("/") else continue
        let namespace = rest[..slash]
        let inside = rest[slash + 1..]
        if not inside.starts_with("dimension/") {
            continue
        }
        let id = "{namespace}:{inside[10..inside.len() - 5]}"
        let bytes = match d.value.read(i) {
            ok(b) => b,
            err(_) => continue,
        }
        match parse_strict(bytes) {
            ok(json) => out.insert(id, Tag.from_json(json)),
            err(_) => {},
        }
    }
    return out
}

// What configuration sends every player, from what the data packs made, the server's language,
// and its world. Then the server's links and its code of conduct, which vanilla's
// `DedicatedServer` reads as it's made, the resource pack it offers, from server.properties.
fn load_configuration(props: ServerProperties, seed: i64, stems: JavaHashMap<String, Tag>, offer: own ResourcePack?, boot: own Boot, language: mut Language, world: mut World?, out: mut Log) -> Configuration? {
    language = boot.language
    // Shared, not copied, so the generators read items against them too (D367).
    let registries = Shared(boot.registries)
    var warnings = List<Entry>()
    let links = server_links(props, mut warnings)
    for e in warnings {
        main_log(mut out, e)
    }
    var codes = List<CodeOfConduct>()
    if props.enable_code_of_conduct {
        codes = match read_codes("codeofconduct") {
            ok(c) => c,
            err(exception) => {
                out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {exception}")
                return none
            },
        }
    }
    let features = feature_ids(boot.features)
    match World.load(props, seed, registries.copy(), boot.chat_types, stems) {
        ok(w) => {
            // With the advancements, as `ServerAdvancementManager` puts them in their tree, and
            // the recipes, as `finalizeRecipeLoading` finishes them as the server is made.
            var made = w
            var lines = List<Entry>()
            made.advancements = some(Shared(Advancements.of(registries.value, mut lines)))
            made.recipes = some(Shared(Recipes.of(registries.value, Streams.new(), mut lines)))
            for e in lines {
                main_log(mut out, e)
            }
            world = some(made)
        },
        err(message) => {
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {message}")
            return none
        },
    }
    var configuration = Configuration.new("calcite", links, features, registries.value, boot.packs)
    configuration.codes = codes
    configuration.pack = offer
    return some(configuration)
}

// A duration as Java's `String.format("%.3fs", seconds)` writes it.
fn seconds(ns: u64) -> String {
    let ms = (ns + 500000) / 1000000
    let frac = ms % 1000
    let pad = if frac < 10 { "00" } else if frac < 100 { "0" } else { "" }
    return "{ms / 1000}.{pad}{frac}s"
}

// `respawn_radius` as the world's game rules have it, `minecraft:respawn_radius` in their saved
// data, or its default, 10, if they don't have it, or it's not a number from 0 up, which
// vanilla's codec doesn't read. Replaying, it's what the recording read.
// The world gen settings of a world that has a `level.dat`, as `readExistingSavedData` reads
// them from `data/minecraft/world_gen_settings.dat`, or, where an older world has none, as it kept
// them in `level.dat`, `older`, with `generate_features` as `generate_structures`, as the upgrade
// to 26.3 moves them. Settings that can't be read or parsed are logged as vanilla logs them, and
// the world gets a new random seed and the normal preset's dimensions, as vanilla's fall back.
fn world_gen_of(folder: WorldFolder?, older: own JavaHashMap<String, Tag>?, link: mut Link, out: mut Log) -> WorldGenSettings {
    let falling_back = "Unable to read or access the world gen settings file! Falling back to the default settings with a random world seed."
    var lines = List<Entry>()
    var found = FileRead.Absent
    if let f = folder {
        match read_world_gen(f) {
            ok(root) => found = FileRead.Read(root),
            err(message) => {
                if let g = older {
                    var data = g.copy()
                    if not data.contains("generate_structures") and data.contains("generate_features") {
                        data.insert("generate_structures", data["generate_features"].copy())
                    }
                    var root = JavaHashMap<String, Tag>()
                    root.insert("data", Tag.Compound(data))
                    found = FileRead.Read(root)
                } else {
                    lines.push(Entry.error("{falling_back} {message}"))
                    found = FileRead.Unreadable
                }
            },
        }
    }
    let given = link.file(found, mut lines)
    for e in lines {
        out.entry("Worker-Main-1", e)
    }
    match given {
        FileRead.Read(root) => {
            var data = JavaHashMap<String, Tag>()
            if root.contains("data") {
                match root["data"] {
                    Tag.Compound(d) => data = d.copy(),
                    _ => {},
                }
            }
            match WorldGenSettings.parse(data) {
                ok(s) => return s,
                err(e) => out.entry("Worker-Main-1", Entry.error("{falling_back} {e}")),
            }
        },
        _ => {},
    }
    return WorldGenSettings.new_world(random_seed(link.random(8)), true, String("minecraft:normal"))
}

// The pregen tasks the world's `data/calcite/pregen.dat` keeps, each with the name of the
// dimension it's in, read through the link, so a replay has what the recording read (CAL-71).
fn pregen_of(folder: WorldFolder?, link: mut Link, out: mut Log) -> List<(String, PregenTask)> {
    var lines = List<Entry>()
    var found = FileRead.Absent
    if let f = folder {
        if let data = SavedFiles.world(f).load(pregen_id(), mut lines) {
            found = FileRead.Read(data)
        }
    }
    let given = link.file(found, mut lines)
    for e in lines {
        main_log(mut out, e)
    }
    let root = match given {
        FileRead.Read(r) => r,
        _ => return List<(String, PregenTask)>(),
    }
    if not root.contains("data") {
        return List<(String, PregenTask)>()
    }
    return match root["data"] {
        Tag.Compound(d) => saved_tasks(d),
        _ => List<(String, PregenTask)>(),
    }
}

// The game rules Calcite reads, as the world's `data/minecraft/game_rules.dat` has them, each its
// default where it's missing or isn't what its codec reads: `respawn_radius`, a number from 0 up,
// and `advance_time`, `advance_weather` and the spawners' `spawn_mobs`, `spawn_monsters`,
// `spawn_phantoms`, `spawn_patrols` and `spawn_wandering_traders` (D314), true or false, and
// `random_tick_speed`, a number from 0 up (D318), `water_source_conversion` and
// `lava_source_conversion`, true or false (D328), `fire_spread_radius_around_player`, a number
// from -1 up (D338), `max_snow_accumulation_height`, a number from 0 to 8 (D340), and
// `natural_health_regeneration`, true or false (CAL-141), `block_drops`, true or false
// (CAL-153), `max_entity_cramming`, a number from 0 up (CAL-156), `mob_griefing` and
// `mob_drops`, true or false (CAL-158), `drowning_damage`, `fall_damage`, `fire_damage` and
// `freeze_damage`, true or false (D418), `player_movement_check`, true or false (D420),
// `players_nether_portal_default_delay`, a number from 0 up (D422), `keep_inventory` and
// `show_death_messages`, true or false (D427), `pvp`, true or false (CAL-162), `locator_bar`,
// true or false (CAL-174), `universal_anger`, `forgive_dead_players` and
// `projectiles_can_break_blocks`, true or false (CAL-159), and `show_advancement_messages`, true
// or false (CAL-164). Replaying, they're what the recording read.
struct Rules {
    respawn_radius: i32 = DEFAULT_RESPAWN_RADIUS
    random_tick_speed: i32 = 3
    fire_spread_radius: i32 = 128
    max_snow: i32 = 1
    water_source_conversion: bool = true
    lava_source_conversion: bool = false
    advance_time: bool = true
    advance_weather: bool = true
    natural_regeneration: bool = true
    block_drops: bool = true
    mob_griefing: bool = true
    mob_drops: bool = true
    damage: DamageRules = DamageRules()
    movement_check: bool = true
    portal_delay: i32 = 80
    keep_inventory: bool = false
    show_death_messages: bool = true
    show_advancement_messages: bool = true
    pvp: bool = true
    locator_bar: bool = true
    universal_anger: bool = false
    forgive_dead_players: bool = true
    projectiles_can_break_blocks: bool = true
    cramming: i32 = 24
    spawn: SpawnRules = SpawnRules()
}

fn rules_of(folder: WorldFolder?, link: mut Link, out: mut Log) -> Rules {
    var rules = Rules()
    let root = saved_root(folder, none, Identifier { namespace: "minecraft", path: "game_rules" }, mut link, mut out) else return rules
    if not root.contains("data") {
        return rules
    }
    match root["data"] {
        Tag.Compound(d) => {
            if d.contains("minecraft:respawn_radius") {
                if let n = d["minecraft:respawn_radius"].number_int() {
                    if n >= 0 {
                        rules.respawn_radius = n
                    }
                }
            }
            if d.contains("minecraft:advance_time") {
                if let b = d["minecraft:advance_time"].number_bool() {
                    rules.advance_time = b
                }
            }
            if d.contains("minecraft:advance_weather") {
                if let b = d["minecraft:advance_weather"].number_bool() {
                    rules.advance_weather = b
                }
            }
            rules.spawn.mobs = rule_bool(d, "minecraft:spawn_mobs")
            rules.spawn.monsters = rule_bool(d, "minecraft:spawn_monsters")
            rules.spawn.phantoms = rule_bool(d, "minecraft:spawn_phantoms")
            rules.spawn.patrols = rule_bool(d, "minecraft:spawn_patrols")
            rules.spawn.traders = rule_bool(d, "minecraft:spawn_wandering_traders")
            if d.contains("minecraft:random_tick_speed") {
                if let n = d["minecraft:random_tick_speed"].number_int() {
                    if n >= 0 {
                        rules.random_tick_speed = n
                    }
                }
            }
            if d.contains("minecraft:fire_spread_radius_around_player") {
                if let n = d["minecraft:fire_spread_radius_around_player"].number_int() {
                    if n >= -1 {
                        rules.fire_spread_radius = n
                    }
                }
            }
            if d.contains("minecraft:max_snow_accumulation_height") {
                if let n = d["minecraft:max_snow_accumulation_height"].number_int() {
                    if n >= 0 and n <= 8 {
                        rules.max_snow = n
                    }
                }
            }
            rules.water_source_conversion = rule_bool(d, "minecraft:water_source_conversion")
            rules.block_drops = rule_bool(d, "minecraft:block_drops")
            rules.mob_griefing = rule_bool(d, "minecraft:mob_griefing")
            rules.mob_drops = rule_bool(d, "minecraft:mob_drops")
            rules.damage.drowning = rule_bool(d, "minecraft:drowning_damage")
            rules.damage.fall = rule_bool(d, "minecraft:fall_damage")
            rules.damage.fire = rule_bool(d, "minecraft:fire_damage")
            rules.damage.freeze = rule_bool(d, "minecraft:freeze_damage")
            rules.movement_check = rule_bool(d, "minecraft:player_movement_check")
            rules.show_death_messages = rule_bool(d, "minecraft:show_death_messages")
            rules.show_advancement_messages = rule_bool(d, "minecraft:show_advancement_messages")
            rules.pvp = rule_bool(d, "minecraft:pvp")
            rules.locator_bar = rule_bool(d, "minecraft:locator_bar")
            rules.forgive_dead_players = rule_bool(d, "minecraft:forgive_dead_players")
            rules.projectiles_can_break_blocks = rule_bool(d, "minecraft:projectiles_can_break_blocks")
            if d.contains("minecraft:universal_anger") {
                rules.universal_anger = d["minecraft:universal_anger"].number_bool() ?? false
            }
            if d.contains("minecraft:keep_inventory") {
                rules.keep_inventory = d["minecraft:keep_inventory"].number_bool() ?? false
            }
            if d.contains("minecraft:players_nether_portal_default_delay") {
                if let n = d["minecraft:players_nether_portal_default_delay"].number_int() {
                    if n >= 0 {
                        rules.portal_delay = n
                    }
                }
            }
            if d.contains("minecraft:natural_health_regeneration") {
                if let b = d["minecraft:natural_health_regeneration"].number_bool() {
                    rules.natural_regeneration = b
                }
            }
            if d.contains("minecraft:max_entity_cramming") {
                if let n = d["minecraft:max_entity_cramming"].number_int() {
                    if n >= 0 {
                        rules.cramming = n
                    }
                }
            }
            if d.contains("minecraft:lava_source_conversion") {
                rules.lava_source_conversion = d["minecraft:lava_source_conversion"].number_bool() ?? false
            }
        },
        _ => {},
    }
    return rules
}

// A game rule that's true or false and on by default, as `game_rules.dat`'s `data` has it.
fn rule_bool(data: JavaHashMap<String, Tag>, name: str) -> bool {
    if not data.contains(name) {
        return true
    }
    return data[name].number_bool() ?? true
}

// The root of the saved data `id`, in the world's `data`, or in the dimension `dim`'s, read
// through the link, so a replay has what the recording read: `none` if there's no folder, no
// file, or one that can't be read, which is logged as vanilla logs it.
fn saved_root(folder: WorldFolder?, dim: Identifier?, id: Identifier, link: mut Link, out: mut Log) -> JavaHashMap<String, Tag>? {
    var lines = List<Entry>()
    var found = FileRead.Absent
    if let f = folder {
        let files = match dim {
            some(d) => SavedFiles.dimension(f, d, mut lines),
            none => SavedFiles.world(f),
        }
        if let data = files.load(id, mut lines) {
            found = FileRead.Read(data)
        }
    }
    let given = link.file(found, mut lines)
    for e in lines {
        main_log(mut out, e)
    }
    return match given {
        FileRead.Read(r) => some(r),
        _ => none,
    }
}

// What the world saved of its random sequences, `data/minecraft/random_sequences.dat`, which
// vanilla reads first, as the server's made, or fresh ones (CAL-153); then of its weather, clocks
// and borders (CAL-105): `data/minecraft/weather.dat`,
// `data/minecraft/world_clocks.dat` and each dimension's `data/minecraft/world_border.dat`, each
// as vanilla reads it, with what else the tick reads, and each level's random's seed, drawn from
// the system's generator, as vanilla seeds `Level.random`, through the link, which records it, or
// with `level_seed`, `level-random-seed`'s, from that and the level's dimension (D311). Then the
// wandering trader's `data/minecraft/wandering_trader.dat`, which vanilla reads the first time
// its spawner looks, and its random's seed, drawn the same way, with `level_seed` from that and
// the data's name (D314). Then each dimension's `data/minecraft/chunk_tickets.dat`, its tickets,
// which vanilla reads as the level's made (D319).
fn world_state_of(folder: WorldFolder?, world: World, rules: Rules, props: ServerProperties, level_seed: i64?, link: mut Link, out: mut Log) -> WorldState {
    var sequences = RandomSequences.fresh()
    if let root = saved_root(folder, none, sequences_id(), mut link, mut out) {
        var lines = List<Entry>()
        sequences = RandomSequences.load(root, mut lines)
        for e in lines {
            main_log(mut out, e)
        }
    }
    var weather = Weather()
    if let root = saved_root(folder, none, weather_id(), mut link, mut out) {
        var lines = List<Entry>()
        weather = Weather.load(root, mut lines)
        for e in lines {
            main_log(mut out, e)
        }
    }
    var names = List<Identifier>()
    for c in world.clocks.clocks {
        names.push(c.name.copy())
    }
    var clocks = Clocks.new(names)
    if let root = saved_root(folder, none, clocks_id(), mut link, mut out) {
        var lines = List<Entry>()
        clocks = Clocks.load(names, root, mut lines)
        for e in lines {
            main_log(mut out, e)
        }
    }
    var borders = List<BorderSettings>()
    for d in world.dims {
        var settings = BorderSettings.default()
        if let root = saved_root(folder, some(d.id.copy()), border_id(), mut link, mut out) {
            var lines = List<Entry>()
            settings = BorderSettings.load(root, mut lines)
            for e in lines {
                main_log(mut out, e)
            }
        }
        borders.push(settings)
    }
    var seeds = List<i64>()
    for d in world.dims {
        seeds.push(match level_seed {
            some(base) => level_random_seed(base, d.id),
            none => random_seed(link.random(8)),
        })
    }
    var trader = TraderData()
    if let root = saved_root(folder, none, trader_id(), mut link, mut out) {
        var lines = List<Entry>()
        trader = TraderData.load(root, mut lines)
        for e in lines {
            main_log(mut out, e)
        }
    }
    let trader_seed = match level_seed {
        some(base) => level_random_seed(base, trader_id()),
        none => random_seed(link.random(8)),
    }
    var tickets = List<TicketStorage?>()
    for d in world.dims {
        var saved: TicketStorage? = none
        if let root = saved_root(folder, some(d.id.copy()), tickets_id(), mut link, mut out) {
            var lines = List<Entry>()
            saved = TicketStorage.parse(root, mut lines)
            for e in lines {
                main_log(mut out, e)
            }
        }
        tickets.push(saved)
    }
    return WorldState { weather: weather, clocks: clocks, borders: borders, advance_time: rules.advance_time, advance_weather: rules.advance_weather, pause_when_empty: props.pause_when_empty_seconds, max_world_size: props.max_world_size, max_chained: props.max_chained_neighbor_updates, water_source_conversion: rules.water_source_conversion, lava_source_conversion: rules.lava_source_conversion, seeds: seeds, spawn_rules: rules.spawn, random_tick_speed: rules.random_tick_speed, fire_spread_radius: rules.fire_spread_radius, max_snow: rules.max_snow, natural_regeneration: rules.natural_regeneration, cramming: rules.cramming, trader: trader, trader_seed: trader_seed, tickets: tickets, sequences: sequences, block_drops: rules.block_drops, mob_griefing: rules.mob_griefing, mob_drops: rules.mob_drops, damage_rules: rules.damage, movement_check: rules.movement_check, allow_flight: props.allow_flight, portal_delay: rules.portal_delay, keep_inventory: rules.keep_inventory, show_death_messages: rules.show_death_messages, show_advancement_messages: rules.show_advancement_messages, pvp: rules.pvp, locator_bar: rules.locator_bar, universal_anger: rules.universal_anger, forgive_dead_players: rules.forgive_dead_players, projectiles_can_break_blocks: rules.projectiles_can_break_blocks }
}

fn main() ! String {
    let started = unsafe { Timestamp.now() }
    let arguments = args()
    let replaying = flag(arguments, "--replay")
    var out = if replaying == none { unsafe { Log.open("logs", started) } } else { Log.console() }
    let failed: String? = match serve(arguments, replaying, mut out) {
        ok => none,
        err(e) => some(e),
    }
    out.close()
    if let e = failed {
        fail e
    }
}

// The server, from server.properties to its ticks, logging to `out`. It returns only if it can't
// start, or once it's replayed an input log.
fn serve(arguments: List<String>, replaying: String?, out: mut Log) ! String {
    // The files a first start makes, which the card names.
    var first_files = List<String>()
    let first_start = not is_file("server.properties")
    var problem: Entry? = none
    let file = match load("server.properties", mut problem) {
        ok(p) => p,
        err(message) => {
            if let e = problem {
                main_log(mut out, e)
            }
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: java.lang.IllegalArgumentException: {message}")
            return
        },
    }
    if let e = problem {
        // A first start's has no file to read, which Calcite's style says on the card instead.
        main_log(mut out, if first_start { e.calcite(Look.Quiet) } else { e })
    }
    // Vanilla writes the file back at once, with every setting it knows. A replay leaves it be.
    let secret = if replaying == none { new_secret() } else { String() }
    let written = match settled(file, secret) {
        ok(p) => p,
        err(message) => {
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {message}")
            return
        },
    }
    if replaying == none {
        if store_properties(mut out, written) and first_start {
            first_files.push(String("server.properties"))
        }
    }
    var props = ServerProperties.from(file)
    var pack_warnings = List<Entry>()
    let pack = resource_pack(props, mut pack_warnings)
    for e in pack_warnings {
        main_log(mut out, e)
    }
    let had_config = is_file("calcite.properties")
    let config = calcite_config(mut out) else return
    if not had_config and is_file("calcite.properties") {
        first_files.push(String("calcite.properties"))
    }
    if config.console_style == "calcite" {
        out.set_style(Style.Calcite)
    } else if config.console_style == "vanilla" {
        out.set_style(Style.Vanilla)
    }

    // Everything from outside goes through the link (D21): the network's, or the input log's
    // when replaying, with no network.
    let start = unsafe { Instant.now() }
    var net: Net? = none
    var recorder: Sender<List<u8>>? = none
    var recorder_thread: Thread? = none
    var made: Link? = none
    // What's typed into the console, which a replay has in its log instead.
    let typed = Receiver<ConsoleInput>()
    if let path = replaying {
        made = some(try replay_link(path))
    } else {
        let n = match Net.new() {
            ok(n) => n,
            err(e) => {
                error(mut out, "Failed to start the network: {bind_error(e)}")
                return
            },
        }
        // Vanilla reads the console on a thread of its own from the start, and runs what's typed
        // once its loop runs. The dashboard reads it a key at a time instead, on a terminal it can
        // draw on, and is drawn from here on, so the log's other threads draw through it too.
        var drawing = false
        if let place = place_of(config.console_dashboard) {
            if unsafe { can_draw() } and raw() {
                match n.waker() {
                    ok(waker) => {
                        unsafe { out.draw(place, start, typed.sender(), waker) }
                        drawing = true
                    },
                    err(_) => cooked(),
                }
            }
        }
        if not drawing {
            match n.waker() {
                ok(waker) => _ = unsafe { Thread.spawn(ConsoleReader { to: typed.sender(), waker: waker }) },
                err(e) => out.log("ServerMain", Level.Warn, "Failed to read the console: {bind_error(e)}"),
            }
        }
        made = some(if config.record_inputs { record_link(n, mut recorder, mut recorder_thread, mut out) } else { Link.live(n) })
        net = some(n)
    }
    var link = made else return
    // Vanilla draws a random seed as it reads server.properties, if `level-seed` is empty. It's
    // a new world's; a world that has one keeps its own.
    var seed = parse_seed(props.level_seed) ?? random_seed(link.random(8))

    // Mojang's services are found as vanilla's `Main` finds them, before the server starts, and
    // the discovery document is fetched while it does.
    let environment = Environment.from_properties(system_property(arguments, "minecraft.api.env"), system_property(arguments, "minecraft.api.discovery.host"))
    // Calcite's style says which services only when they aren't Mojang's own.
    let services_look = if environment.name == "PROD" { Look.Quiet } else { Look.Words("Using Mojang's {environment.name} services, from {environment.discovery_url}") }
    out.write("ServerMain", Level.Info, "Environment: {environment.to_string()}", services_look)
    var services = Services.new(environment)
    var fetched = List<Entry>()
    services.tick(0, mut fetched, mut link)
    for e in fetched {
        out.entry("ServerMain", e)
    }
    // Then the world's folder is opened, as `validateAndCreateAccess` opens it: made if it's
    // missing, and locked. A replay reads the chunks its recording read from its log instead.
    var folder: WorldFolder? = none
    if replaying == none {
        var opened = List<Entry>()
        var failed: String? = none
        match WorldFolder.open(String("."), props.level_name, mut opened) {
            ok(f) => folder = some(f),
            err(message) => failed = some(message),
        }
        for e in opened {
            main_log(mut out, e)
        }
        if let message = failed {
            out.log("ServerMain", Level.Error, "Failed to start the minecraft server: {message}")
            return
        }
    }
    // Then its `level.dat`, as `Main` reads it once the folder's open, if it has one: one that
    // can't be read stops the server. Players new to the world spawn at its spawn, or a new
    // world's, the flat world's 0, 0.
    var level_lines = List<Entry>()
    var found = FileRead.Absent
    if let f = folder {
        if f.has_level() {
            let now = unsafe { Timestamp.now() }
            found = match f.load_level(now.date_time(unsafe { now.local_offset() }), mut level_lines) {
                some(data) => FileRead.Read(data),
                none => FileRead.Unreadable,
            }
        }
    }
    let level_dat = link.file(found, mut level_lines)
    for e in level_lines {
        main_log(mut out, e)
    }
    var spawn = Spawn { dimension: Identifier { namespace: "minecraft", path: "overworld" }, pos: BlockPos { x: 0, y: SURFACE_Y, z: 0 }, yaw: 0.0f32, pitch: 0.0f32 }
    var level_data: LevelData? = none
    var level_name = props.level_name.copy()
    // An older world's world gen settings, which it kept in `level.dat`.
    var older_gen: JavaHashMap<String, Tag>? = none
    match level_dat {
        FileRead.Read(data) => {
            let parsed = LevelData.parse(data)
            spawn = parsed.spawn.copy()
            level_name = parsed.name.copy()
            level_data = some(parsed)
            if data.contains("WorldGenSettings") {
                match data["WorldGenSettings"] {
                    Tag.Compound(g) => older_gen = some(g.copy()),
                    _ => {},
                }
            }
        },
        FileRead.Unreadable => {
            out.log("ServerMain", Level.Error, "Failed to load world data. World files may be corrupted. Shutting down.")
            return
        },
        FileRead.Absent => {},
    }
    // Then the data packs, as `Main` loads them: picked as the world's `level.dat` picks them, or
    // a new world's as server.properties does, from what's in its `datapacks` folder, which is
    // made if it's missing. A replay reads the folder as it is, and makes nothing.
    let safe = arguments.contains("--safeMode")
    if safe {
        out.log("ServerMain", Level.Warn, "Safe mode active, only vanilla datapack will be loaded")
    }
    let world_path = if props.level_name.is_empty() { String(".") } else { join(String("."), props.level_name) }
    var picks = DataPacks { enabled: ["vanilla"], disabled: [] }
    var flags = VANILLA_FEATURES
    var init = true
    if let d = level_data {
        if let p = d.packs {
            picks = p.copy()
        }
        flags = d.features
        init = false
    } else {
        picks = DataPacks { enabled: split_trimmed(props.initial_enabled_packs, 44), disabled: split_trimmed(props.initial_disabled_packs, 44) }
    }
    let setup = Setup { datapacks: join(world_path, String("datapacks")), make: replaying == none, safe: safe, init: init, config: picks, features: flags }
    var allow = AllowList.nothing()
    if let f = folder {
        allow = f.allow.copy()
    } else {
        var unlogged = List<Entry>()
        allow = read_allow_list(join(String("."), String("allowed_symlinks.txt")), mut unlogged)
    }
    let boot = load_data(setup, mut allow, mut out) else return
    // What the world generates from: its packs' data, if it has packs of its own (CAL-92).
    let world_data = world_data_of(setup, boot, mut allow)
    // Then what the world generates with, as `getLevelDataAndDimensions` reads it on a worker for
    // a world that has a `level.dat`: its seed and its Overworld's generator are the world's from
    // then on, whatever server.properties says. A new world's are server.properties' (D238).
    var gen_settings = WorldGenSettings.new_world(seed, props.generate_structures, props.level_type)
    if level_data != none {
        gen_settings = world_gen_of(folder, older_gen, mut link, mut out)
        seed = gen_settings.seed
        props.level_type = gen_settings.overworld_type()
    }
    // What they picked is what the world keeps. It's always written, even when it's only
    // `vanilla`, as vanilla's default is one object, which a pick never is.
    var picked: LevelData? = none
    if let d = level_data {
        var data = d.copy()
        data.packs = some(boot.selected.copy())
        data.features = boot.features
        picked = some(data)
    } else {
        // Vanilla logs it on a worker, once the registries are loaded.
        out.write("Worker-Main-1", Level.Info, "No existing world data, creating new world", Look.Quiet)
        picked = some(LevelData.new_world(props.level_name.copy(), props.gamemode, props.difficulty, props.hardcore, boot.selected.copy(), boot.features))
    }
    // The difficulty is server.properties', as `forceDifficulty` sets it as the server starts,
    // and a hardcore world's is hard.
    if let kept = picked.take() {
        var data = kept
        data.difficulty.difficulty = if data.difficulty.hardcore { Difficulty.Hard } else { props.difficulty }
        picked = some(data)
    }
    level_data = picked
    var language = Language.empty()
    var loaded_world: World? = none
    let configuration = load_configuration(props, seed, baked_stems(gen_settings.dimensions, world_data), pack, boot, mut language, mut loaded_world, mut out) else return
    var world = loaded_world else return
    if let d = world_data {
        world.set_data(d)
    }
    world.settings.force_view_distance = config.force_view_distance
    world.settings.chunk_send_cap = config.chunk_send_cap
    world.settings.chunk_send_multiplier = config.chunk_send_multiplier
    world.settings.chunk_send_boost = config.chunk_send_boost
    world.settings.chunk_workers = config.chunk_workers
    world.settings.stage_times = flag(arguments, "--stage-times")
    // The overworld's game rules, `data/minecraft/game_rules.dat`, of which the spawn search
    // reads `respawn_radius`.
    let rules = rules_of(folder, mut link, mut out)
    let respawn_radius = rules.respawn_radius
    // The pregen tasks the world kept, `data/calcite/pregen.dat`, which carry on (CAL-71).
    let pregen_tasks = pregen_of(folder, mut link, mut out)
    // The weather, the clocks and the borders it saved, and its levels' randoms' seeds (CAL-105).
    let world_state = world_state_of(folder, world, rules, props, parse_seed(config.level_random_seed), mut link, mut out)

    say(mut out, Level.Info, "Starting minecraft server version {game_version()}", Look.Quiet)
    say(mut out, Level.Info, "Loading properties", Look.Quiet)
    let settings = LoginSettings {
        online_mode: props.online_mode,
        accepts_transfers: props.accepts_transfers,
        compression_threshold: props.network_compression_threshold,
        log_ips: props.log_ips,
        prevent_proxy_connections: props.prevent_proxy_connections,
        velocity_secret: if config.velocity_forwarding { some(config.velocity_secret.copy()) } else { none },
        rate_limit: props.rate_limit,
        login_throttle: config.login_throttle,
    }
    // Vanilla makes the key pair here, before it listens. Calcite starts making it, and lets the
    // first online login wait for it. A replay has the recording's.
    say(mut out, Level.Info, "Generating keypair", Look.Quiet)
    let keys = Receiver<RsaKey>()
    if replaying == none {
        _ = unsafe { Thread.spawn(KeyMaker { out: keys.sender() }) }
    }
    let world_view = world.settings.chunk_radius()
    // Each dimension's chunks are read from its region files, as its `ChunkMap` reads them: the
    // Overworld's in the world's folder, the others' in their own (CAL-69).
    var regions = List<String>()
    // And its entities from its `entities` folder's (CAL-148).
    var entity_folders = List<String>()
    // And its points of interest from its `poi` folder's (CAL-160).
    var poi_folders = List<String>()
    if let f = folder {
        for d in world.dims {
            regions.push(join(f.dimension(d.id), String("region")))
            entity_folders.push(join(f.dimension(d.id), String("entities")))
            poi_folders.push(join(f.dimension(d.id), String("poi")))
        }
    }
    // The card names the world's preset as the create-world screen does, such as `Default` or
    // `Superflat`: the one its Overworld's generated as.
    let preset = match noise_settings_of(props.level_type) {
        none => "flat",
        some(s) => if s == "minecraft:large_biomes" { "large_biomes" } else if s == "minecraft:amplified" { "amplified" } else { "normal" },
    }
    let world_kind = language.get_or_default("generator.minecraft.{preset}", String(preset))
    var network = Network.new(link, status_info(props, none), settings, language, services, keys, configuration, world)
    var players: PlayerFiles? = none
    if let f = folder {
        players = some(PlayerFiles.open(f))
    }
    network.set_spawn(spawn, respawn_radius, players)
    if let f = folder {
        network.set_progress(some(ProgressFiles.advancements(f)))
        network.set_stats(some(ProgressFiles.stats(f)))
    }
    network.set_level(level_data, level_name, String("calcite"))
    network.set_world_state(world_state)
    let rng_tape = flag(arguments, "--rng-tape")
    if rng_tape != none {
        network.tape_levels()
    }
    let entity_trace = flag(arguments, "--entity-trace")
    if entity_trace != none {
        network.trace_entities()
    }
    if let base = parse_seed(config.level_random_seed) {
        network.seed_entities(base)
    }
    if let text = flag(arguments, "--rng-reseed") {
        let at = match parse_long(text.copy(), 10) {
            ok(t) => t,
            err(_) => fail "--rng-reseed takes a game time, not {text}",
        }
        let base = parse_seed(config.level_random_seed) else fail String("--rng-reseed needs level-random-seed in calcite.properties")
        network.reseed_levels(at, base)
    }
    network.set_world_gen(gen_settings.write())
    network.set_pregen(pregen_tasks)
    // Then what's saved is written on the saver's thread. A replay has no folder, and saves
    // nothing.
    if let f = folder {
        network.open_saving(PlayerFiles.open(f), f.path.copy())
    }
    network.open_world(regions)
    network.open_entities(entity_folders)
    network.open_pois(poi_folders)
    // Then each level's saved tickets are activated, and the first tick waits for the chunks
    // they load, as `prepareLevels` waits (D319).
    network.prepare_levels()
    // Vanilla's `DedicatedPlayerList` reads the bans, the ops and the whitelist as it's made, and
    // writes those that aren't there. A replay reads them too, as they were, and writes nothing.
    var access_warnings = List<Entry>()
    let access = Access.load(String("."), props.white_list, mut access_warnings)
    if replaying == none {
        Access.make_missing(String("."), mut access_warnings)
    }
    for e in access_warnings {
        main_log(mut out, e)
    }
    let whitelisted = if props.white_list { some(access.listed()) } else { none }
    network.set_access(access)
    let host = if props.server_ip.is_empty() { String("*") } else { props.server_ip.copy() }
    say(mut out, Level.Info, "Starting Minecraft server on {host}:{props.server_port}", Look.Quiet)
    // Where players reach it, in Calcite's words: from this machine, where it listens on every
    // address.
    let place = if props.server_ip.is_empty() { "localhost:{props.server_port}" } else { "{props.server_ip}:{props.server_port}" }
    let port = u16.try_from(props.server_port) ?? 0
    if port == 0 and props.server_port != 0 {
        say(mut out, Level.Warn, "**** FAILED TO BIND TO PORT!", Look.Words("Can't listen on port {props.server_port}: a port is from 0 to 65535"))
        say(mut out, Level.Warn, "The exception was: java.lang.IllegalArgumentException: port out of range:{props.server_port}", Look.Quiet)
        say(mut out, Level.Warn, "Perhaps a server is already running on that port?", Look.Quiet)
        return
    }
    match network.listen(props.server_ip, port) {
        ok(_) => {},
        err(e) => {
            say(mut out, Level.Warn, "**** FAILED TO BIND TO PORT!", Look.Words("Can't listen on {place}: {bind_words(e)}"))
            say(mut out, Level.Warn, "The exception was: {bind_error(e)}", Look.Quiet)
            say(mut out, Level.Warn, "Perhaps a server is already running on that port?", Look.Quiet)
            return
        },
    }
    if config.velocity_forwarding {
        say(mut out, Level.Info, "Velocity modern forwarding is on: players are let in only through the Velocity proxy, which authenticates them", Look.Quiet)
    } else if not props.online_mode {
        say(mut out, Level.Warn, "**** SERVER IS RUNNING IN OFFLINE/INSECURE MODE!", Look.Quiet)
        say(mut out, Level.Warn, "The server will make no attempt to authenticate usernames. Beware.", Look.Quiet)
        say(mut out, Level.Warn, "While this makes the game possible to play without internet access, it also opens up the ability for hackers to connect with any username they choose.", Look.Quiet)
        say(mut out, Level.Warn, "To change this, set \"online-mode\" to \"true\" in the server.properties file.", Look.Quiet)
    }
    let took = unsafe { Instant.now() }.nanos_since(start)
    say(mut out, Level.Info, "Done ({seconds(took)})! For help, type \"help\"", Look.Quiet)
    let accounts = if config.velocity_forwarding { Accounts.Velocity } else if props.online_mode { Accounts.Online } else { Accounts.Offline }
    out.show_card(Card {
        version: game_version(),
        took: millis(took),
        address: place,
        accounts: accounts,
        world: world_kind,
        view_distance: world_view,
        simulation_distance: props.simulation_distance,
        max_players: props.max_players,
        whitelisted: whitelisted,
        made: first_files,
    })
    let icon = status_icon(mut out)
    if icon != none {
        network.set_status(status_info(props, icon))
    }

    if let path = replaying {
        try replay(mut network, path, mut out)
        return
    }
    let bar = out.dashboard()
    run(net!, mut network, start, typed, mut recorder, bar, flag(arguments, "--tick-times"), rng_tape, entity_trace, mut out)
    // The last of the input log is written before the server ends.
    recorder = none
    if let t = recorder_thread.take() {
        t.join()
    }
    // The world's lock goes last, as `MinecraftServer.stopServer` closes its storage.
    if let f = folder.take() {
        var lines = List<Entry>()
        f.close(mut lines)
        for e in lines {
            main_log(mut out, e)
        }
    }
}

// Replays the rest of the input log at `path`, logging what the server logs, then what the replay
// found. A replay that went another way than the recording fails, with where it first did.
fn replay(network: mut Network, path: String, out: mut Log) ! String {
    while network.replay_step() {
        for e in network.take_logs() {
            out.entry("Server thread", e)
        }
    }
    let report = network.report()
    if not report.same() {
        fail "the replay of {path} went another way: {report.to_string()}"
    }
    info(mut out, "Replayed {path}: {report.to_string()}")
}

// 50 ms, the length of a tick at 20 ticks a second.
const TICK_NS: u64 = 50000000

// How long a stopping server waits for the players it told to go.
const DRAIN_NS: u64 = 3000000000

// The server's ticks, 20 a second, with the network's events handled as they come between them,
// as vanilla's `runServer` runs them, and what's typed into the console, as `tickConnection` runs
// it. A server more than 2 seconds behind warns, at most once in 15 seconds, and skips the ticks
// it missed. Light runs on a thread of its own, whose steps wake the poll as the IO thread's reads
// do (D264). What the link records goes to `recorder`, after each turn of the loop. Once the server is stopping, it ticks no more, and waits up to 3 seconds for
// the players it told to go.
//
// Where the dashboard is drawn, it's told how long each tick's turns took, and each second the
// players and chunks. With `--tick-times FILE`, the same times are kept, and written to the file
// as the server ends, a line `at busy` a tick, in nanoseconds since the start. Those times are
// for the bar and the benchmark alone: nothing the server does depends on them. With
// `--rng-tape FILE`, what the levels' randoms drew is written to the file as it ends (D312), and
// with `--entity-trace FILE`, each mob's state as each of its ticks was done (CAL-159).
fn run(net: Net, network: mut Network, start: Instant, typed: own Receiver<ConsoleInput>, recorder: mut Sender<List<u8>>?, dashboard: own Sender<ToConsole>?, tick_times: own String?, rng_tape: own String?, entity_trace: own String?, out: mut Log) {
    var console = typed
    var bar = dashboard
    let timed = match bar {
        some(_) => true,
        none => tick_times != none,
    }
    var times = String()
    var tape = String()
    var traced = String()
    var events = List<Event>()
    var next = unsafe { Instant.now() }.nanos_since(start) + TICK_NS
    var last_warning: u64 = 0
    var deadline: u64 = 0
    // The server thread's work since the last tick, and when the bar's next players and chunks
    // are due.
    var busy: u64 = 0
    var next_world: u64 = 0
    loop {
        let before = unsafe { Instant.now() }.nanos_since(start)
        let until = if network.stopping() { deadline } else { next }
        var wait = if until > before { i64.wrap((until - before + 999999) / 1000000) } else { 0 }
        // Past the deadline, a stopping server waits only for its saves, which wake the poll as
        // each is written.
        if network.stopping() and wait == 0 and network.saves_away() > 0 {
            wait = 1000
        }
        net.poll(wait, mut events)
        let now = unsafe { Instant.now() }.nanos_since(start)
        network.set_clock(unsafe { Timestamp.now() })
        for e in events {
            _ = network.handle(e, now)
        }
        var ticked = false
        if not network.stopping() {
            while let input = console.next() {
                match input {
                    ConsoleInput.Line(line) => network.command(line),
                    ConsoleInput.Halt => network.halt(),
                }
            }
            if network.stopping() {
                deadline = now + DRAIN_NS
            } else if now >= next {
                let behind = now - next
                if behind > 2000000000 and (last_warning == 0 or next - last_warning >= 15000000000) {
                    let ticks = behind / TICK_NS
                    say(mut out, Level.Warn, "Can't keep up! Is the server overloaded? Running {behind / 1000000}ms or {ticks} ticks behind", Look.Words("{behind / 1000000} ms behind, so {ticks} ticks are skipped. Is the machine too busy?"))
                    next += ticks * TICK_NS
                    last_warning = next
                }
                next += TICK_NS
                network.tick(now)
                network.sweep(now)
                ticked = true
                // A stop typed into the console stops the server in the tick that runs it (D432).
                if network.stopping() {
                    deadline = now + DRAIN_NS
                }
                if rng_tape != none {
                    tape.push_str(network.take_tape(false))
                }
                if entity_trace != none {
                    traced.push_str(network.take_trace())
                }
            }
        }
        for e in network.take_logs() {
            out.entry("Server thread", e)
        }
        record(mut network, mut recorder)
        if timed {
            let end = unsafe { Instant.now() }.nanos_since(start)
            busy += end - now
            if let to = bar.take() {
                var s = to
                if ticked {
                    s.send(ToConsole.Tick { at: now, busy: busy })
                }
                if end >= next_world {
                    s.send(ToConsole.World { players: network.players_online(), max: network.max_players(), chunks: network.chunks_in_view(), stopping: network.stopping(), pregen: network.pregen_shown() })
                    next_world = end + 1000000000
                }
                bar = some(s)
            }
            if ticked {
                if tick_times != none {
                    times.push_str("{now} {busy}\n")
                }
                busy = 0
            }
        }
        if network.stopping() and network.saves_away() == 0 and (network.closing() == 0 or now >= deadline) {
            if let path = tick_times {
                match write(path, times.to_bytes()) {
                    ok => {},
                    err(_) => say(mut out, Level.Warn, "Can't write the tick times to {path}", Look.Quiet),
                }
            }
            if let path = rng_tape {
                tape.push_str(network.take_tape(true))
                match write(path, tape.to_bytes()) {
                    ok => {},
                    err(_) => say(mut out, Level.Warn, "Can't write the RNG tape to {path}", Look.Quiet),
                }
            }
            if let path = entity_trace {
                match write(path, traced.to_bytes()) {
                    ok => {},
                    err(_) => say(mut out, Level.Warn, "Can't write the entity trace to {path}", Look.Quiet),
                }
            }
            return
        }
    }
}

// Sends what the link recorded since the last turn of the loop to the input log's thread.
fn record(network: mut Network, recorder: mut Sender<List<u8>>?) {
    if let to = recorder.take() {
        var pieces = to
        pieces.send(network.take_log())
        recorder = some(pieces)
    }
}
