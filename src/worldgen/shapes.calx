/// `updateShape`: what a block becomes when a neighbour changes, as vanilla's blocks work it out
/// by the class that declares the method, with the ticks some schedule. Features ask it where a
/// structure's or a tree's edge meets the world. It reads the blocks and schedules the ticks
/// through `BlockAccess`, a region's as chunks generate or the server's level's, each tick due in
/// the delay vanilla gives it (D324). A class Calcite doesn't know yet throws `Unimplemented`,
/// which the rig reports as such, rather than guessing.
module worldgen.shapes

import random.source.{RandomSource}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, EAST, FULL, Facts, NORTH, RIGID, SOUTH, UP, WATER_FLUID, WEST, clockwise, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.portal_shape.{find_any_shape}
import worldgen.region.{Region}
import worldgen.signals.{repeater_locked, wire_connections, wire_cross, wire_holds, wire_side}
import worldgen.survive.{Env, attaches_state, can_survive, direction_property, facing_of}

/// `BlockState.updateShape` of `state` at the block, toward `d`, where `neighbour` is.
pub fn update_shape<R: BlockAccess + RandomSource>(e: Env, r: mut R, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    return try shape_as(e, mut r, e.facts.shape_class(e.facts.block(state)), state, x, y, z, d, neighbour)
}

// `updateShape` as the class `kind` declares it, so a class's `super.updateShape` is its parent's.
fn shape_as<R: BlockAccess + RandomSource>(e: Env, r: mut R, kind: String, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    if kind == "BlockBehaviour" {
        return state
    }
    if kind == "LeavesBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        let from_neighbour = leaf_distance(e, neighbour) + 1
        if from_neighbour != 1 or (f.get_int(state, "distance") ?? 7) != from_neighbour {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        return state
    }
    if kind == "SnowyBlock" {
        if d == UP {
            return try f.with_bool(state, "snowy", f.in_set(neighbour, f.tag("minecraft:snow")))
        }
        return state
    }
    if kind == "LiquidBlock" {
        if f.is_source(state) or f.is_source(neighbour) {
            r.schedule_fluid(f.fluid(state), x, y, z)
        }
        if d == DOWN and f.fluid_in(state, "minecraft:bubble_column_can_occupy") and f.is_source(state) and f.fluid_amount(state) == 8 {
            let drag = f.in_set(neighbour, f.tag("minecraft:enables_bubble_column_drag_down"))
            if drag or f.in_set(neighbour, f.tag("minecraft:enables_bubble_column_push_up")) {
                r.schedule_block(block, x, y, z, 20, 0)
            }
        }
        return state
    }
    if kind == "VegetationBlock" or kind == "SnowLayerBlock" or kind == "CarpetBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "DoublePlantBlock" {
        let lower = (f.get_name(state, "half") ?? String("lower")) == "lower"
        var other_half = false
        if f.is(neighbour, block) {
            other_half = ((f.get_name(neighbour, "half") ?? String("lower")) == "lower") != lower
        }
        if (d == UP or d == DOWN) and lower == (d == UP) and not other_half {
            return f.ids.air_state
        }
        // Its own check below, then `VegetationBlock.updateShape`'s, which is the same.
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "VineBlock" {
        if d == DOWN {
            return state
        }
        let updated = try vine_updated(f, r, state, x, y, z)
        if not vine_has_faces(f, updated) {
            return f.ids.air_state
        }
        return updated
    }
    if kind == "ShelfMushroomBlock" {
        let facing = try facing_of(f, state)
        if d == opposite(facing) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "HugeMushroomBlock" {
        if f.is(neighbour, block) {
            return try f.with_bool(state, direction_property(d), false)
        }
        return state
    }
    if kind == "MangroveRootsBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        return state
    }
    if kind == "MangrovePropaguleBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        // Its own check toward up, then `VegetationBlock.updateShape`'s, which is the same.
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "MossyCarpetBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        let updated = try mossy_updated(f, r, block, state, x, y, z, false)
        if not mossy_has_faces(f, updated) {
            return f.ids.air_state
        }
        return updated
    }
    if kind == "HangingMossBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        return try f.with_bool(state, "tip", not f.is(try r.state(f, x, y - 1, z), block))
    }
    if kind == "CocoaBlock" {
        if d == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "BeehiveBlock" {
        if f.is_a(f.block(neighbour), "FireBlock") {
            fail Thrown { exception: "Unimplemented", message: "a beehive emptied by fire" }
        }
        return state
    }
    if kind == "ConcretePowderBlock" {
        if try touches_liquid(f, r, x, y, z) {
            return f.default_state(try concrete_of(f, block))
        }
        return try shape_as(e, mut r, "FallingBlock", state, x, y, z, d, neighbour)
    }
    if kind == "PitcherCropBlock" {
        // `isDouble`: grown to two blocks high, from age 3.
        if (f.get_int(state, "age") ?? 0) >= 3 {
            return try shape_as(e, mut r, "DoublePlantBlock", state, x, y, z, d, neighbour)
        }
        if try can_survive(e, r, state, x, y, z) {
            return state
        }
        return f.ids.air_state
    }
    if kind == "NoteBlock" {
        if d == UP or d == DOWN {
            return try note_instrument(f, r, state, x, y, z)
        }
        return state
    }
    if kind == "BubbleColumnBlock" {
        r.schedule_fluid(WATER_FLUID, x, y, z)
        let into = d == UP and not f.is(neighbour, block) and can_occupy(f, block, neighbour)
        if not try can_survive(e, r, state, x, y, z) or d == DOWN or into {
            r.schedule_block(block, x, y, z, 5, 0)
        }
        return state
    }
    if kind == "NetherPortalBlock" {
        let along_x = f.get_name(state, "axis") != some(String("z"))
        let across = (d == WEST or d == EAST) != along_x and d != UP and d != DOWN
        if not across and not f.is(neighbour, block) and not (try find_any_shape(e, r, x, y, z, along_x)).is_complete() {
            return f.ids.air_state
        }
        return state
    }
    if kind == "FallingBlock" or kind == "BrushableBlock" {
        r.schedule_block(block, x, y, z, if block == f.ids.dragon_egg { 5 } else { 2 }, 0)
        return state
    }
    if kind == "SlabBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        return state
    }
    if kind == "PotentSulfurBlock" {
        return try potent_sulfur(e, mut r, state, x, y, z)
    }
    if kind == "ChainBlock" or kind == "TrapDoorBlock" or kind == "BaseRailBlock" or kind == "EnderChestBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        return state
    }
    if kind == "StairBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        if d == UP or d == DOWN {
            return state
        }
        return try f.with_name(state, String("shape"), try stairs_shape(f, r, state, x, y, z))
    }
    if kind == "IronBarsBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        if d == UP or d == DOWN {
            return state
        }
        let sturdy = f.sturdy(neighbour, opposite(d), FULL)
        let attaches = (not exception_for_connection(f, neighbour) and sturdy) or f.is_a(f.block(neighbour), "IronBarsBlock") or f.in_set(neighbour, f.tag("minecraft:walls"))
        return try f.with_bool(state, direction_property(d), attaches)
    }
    if kind == "AbstractBedBlock" {
        // The other half: gone with it, else its occupied flag kept.
        let facing = try facing_of(f, state)
        let part = f.get_name(state, String("part")) ?? String("foot")
        let toward = if part == "foot" { facing } else { opposite(facing) }
        if d != toward {
            return state
        }
        if f.is(neighbour, block) and f.get_name(neighbour, String("part")) != some(part) {
            return try f.with_bool(state, String("occupied"), f.get_bool(neighbour, "occupied"))
        }
        return f.ids.air_state
    }
    if kind == "BaseTorchBlock" {
        if d == DOWN and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "WallTorchBlock" {
        if opposite(d) == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "WallBannerBlock" {
        if opposite(d) == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "LadderBlock" {
        if opposite(d) == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        return state
    }
    if kind == "WallBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        if d == DOWN {
            return state
        }
        // `topUpdate` and `sideUpdate`: the sides joined as they were, but the one toward the
        // neighbour, joined afresh; each tall where the block above covers it, low where not.
        let sides: List<i32> = [NORTH, EAST, SOUTH, WEST]
        let above = if d == UP { neighbour } else { try r.state(f, x, y + 1, z) }
        let cover = f.wall_cover(above)
        var s = state
        for i in 0..sides.len() {
            let side = sides[i]
            var joined = wall_side(f, state, side) != "none"
            if side == d {
                joined = try wall_connects(f, neighbour, opposite(d))
            }
            let value = if not joined { "none" } else if cover & (2u32 << u32.wrap(i)) != 0 { "tall" } else { "low" }
            s = try f.with_name(s, direction_property(side), String(value))
        }
        // `shouldRaisePost`: a post under a wall's post, at a corner or an end, or under what
        // covers the post's middle unless tall walls run straight through.
        var post = f.is_a(f.block(above), "WallBlock") and f.get_bool(above, "up")
        if not post {
            let north = wall_side(f, s, NORTH)
            let east = wall_side(f, s, EAST)
            let south = wall_side(f, s, SOUTH)
            let west = wall_side(f, s, WEST)
            let corner = (north == "none" and south == "none" and west == "none" and east == "none") or (north == "none") != (south == "none") or (west == "none") != (east == "none")
            if corner {
                post = true
            } else {
                let high = (north == "tall" and south == "tall") or (east == "tall" and west == "tall")
                post = not high and (f.in_set(above, f.tag("minecraft:wall_post_override")) or cover & 1 != 0)
            }
        }
        return try f.with_bool(s, "up", post)
    }
    if kind == "FenceBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        if d == UP or d == DOWN {
            return state
        }
        // `connectsTo`: a sturdy face that isn't an exception, a fence of the same kind, wooden
        // or not, or a gate turned across.
        let wooden = f.tag("minecraft:wooden_fences")
        let same = f.in_set(neighbour, f.tag("minecraft:fences")) and f.in_set(neighbour, wooden) == f.in_set(state, wooden)
        var gate = false
        if f.is_a(f.block(neighbour), "FenceGateBlock") {
            gate = axis_x(try facing_of(f, neighbour)) == axis_x(clockwise(opposite(d)))
        }
        let sturdy = f.sturdy(neighbour, opposite(d), FULL)
        let connects = (not exception_for_connection(f, neighbour) and sturdy) or same or gate
        return try f.with_bool(state, direction_property(d), connects)
    }
    if kind == "ChestBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        // `chestCanConnectTo`: the same block, or for a copper chest any copper chest.
        let copper = f.tag("minecraft:copper_chests")
        let connects = if f.in_set(state, copper) { f.in_set(neighbour, copper) and f.has(neighbour, String("type")) } else { f.is(neighbour, block) }
        if connects and d != UP and d != DOWN {
            let neighbour_type = f.get_name(neighbour, String("type")) ?? String("single")
            if (f.get_name(state, String("type")) ?? String("single")) == "single" and neighbour_type != "single" and f.get_name(state, String("facing")) == f.get_name(neighbour, String("facing")) and try chest_connected(f, neighbour) == opposite(d) {
                let other = if neighbour_type == "left" { "right" } else { "left" }
                return try f.with_name(state, String("type"), String(other))
            }
        } else if try chest_connected(f, state) == d {
            return try f.with_name(state, String("type"), String("single"))
        }
        return state
    }
    if kind == "PathBlock" {
        // Turned back to dirt a tick later when something solid lands on it.
        if d == UP and not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        return state
    }
    if kind == "SpeleothemBlock" {
        return try speleothem_updated(e, mut r, state, x, y, z, d)
    }
    if kind == "SeagrassBlock" {
        // `VegetationBlock.updateShape`, then its water ticked where it stays.
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        r.schedule_fluid(WATER_FLUID, x, y, z)
        return state
    }
    if kind == "GrowingPlantBodyBlock" {
        return try growing_body(e, mut r, state, x, y, z, d, neighbour)
    }
    if kind == "CampfireBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        // A signal fire over hay: `isSmokeSource`.
        if d == DOWN {
            return try f.with_bool(state, "signal_fire", f.is(neighbour, try f.named_block(String("hay_block"))))
        }
        return state
    }
    if kind == "SugarCaneBlock" {
        // Broken a tick later where it can't stay.
        if not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        return state
    }
    if kind == "BambooStalkBlock" {
        // Broken a tick later where it can't stay; a stalk under an older one ages with it.
        if not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        if d == UP and f.is(neighbour, block) {
            let age = f.get_int(state, String("age")) ?? 0
            if (f.get_int(neighbour, String("age")) ?? 0) > age {
                return try f.with_int(state, String("age"), (age + 1) % 2)
            }
        }
        return state
    }
    if kind == "DoorBlock" {
        // A half goes with the other, which it takes the rest of its state from; a lower half
        // goes with what it stands on.
        let half = f.get_name(state, String("half")) ?? String("lower")
        let lower = half == "lower"
        if (d != UP and d != DOWN) or lower != (d == UP) {
            if lower and d == DOWN and not try can_survive(e, r, state, x, y, z) {
                return f.ids.air_state
            }
            return state
        }
        if f.is_a(f.block(neighbour), "DoorBlock") and (f.get_name(neighbour, String("half")) ?? String("lower")) != half {
            return try f.with_name(neighbour, String("half"), half)
        }
        return f.ids.air_state
    }
    // Blocks whose own part is only their water's tick, over `Block`'s.
    if kind == "BarrierBlock" or kind == "CandleBlock" or kind == "ConduitBlock" or kind == "CopperGolemStatueBlock" or kind == "DecoratedPotBlock" or kind == "DriedGhastBlock" or kind == "HeavyCoreBlock" or kind == "LightBlock" or kind == "LightningRodBlock" or kind == "SculkSensorBlock" or kind == "SculkShriekerBlock" or kind == "ShelfBlock" or kind == "SignBlock" or kind == "WaterloggedTransparentBlock" {
        tick_water(f, mut r, state, x, y, z)
        return state
    }
    return try more_shape(e, mut r, kind, state, x, y, z, d, neighbour)
}

// `updateShape` of the classes `shape_as` doesn't take itself: plants and coral that grow by
// structures and trees, and what plain structure templates hold (CAL-90).
fn more_shape<R: BlockAccess + RandomSource>(e: Env, r: mut R, kind: String, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    if kind == "CoralBlock" {
        // Dies a while later where no water touches it, 60 ticks and up to 39 more, drawn from
        // the level's random.
        if not try touches_water(f, r, x, y, z) {
            let wait = 60 + r.next_int_below(40)
            r.schedule_block(block, x, y, z, wait, 0)
        }
        return state
    }
    if kind == "BaseCoralPlantTypeBlock" {
        tick_water(f, mut r, state, x, y, z)
        if d == DOWN and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "CoralPlantBlock" or kind == "CoralFanBlock" {
        if d == DOWN and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        try coral_die_tick(f, mut r, state, x, y, z)
        tick_water(f, mut r, state, x, y, z)
        return try shape_as(e, mut r, "BaseCoralPlantTypeBlock", state, x, y, z, d, neighbour)
    }
    if kind == "BaseCoralWallFanBlock" {
        tick_water(f, mut r, state, x, y, z)
        if opposite(d) == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "CoralWallFanBlock" {
        if opposite(d) == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        tick_water(f, mut r, state, x, y, z)
        try coral_die_tick(f, mut r, state, x, y, z)
        return try more_shape(e, mut r, "BaseCoralWallFanBlock", state, x, y, z, d, neighbour)
    }
    if kind == "GrowingPlantHeadBlock" {
        return try growing_head(e, mut r, state, x, y, z, d, neighbour)
    }
    if kind == "AmethystClusterBlock" {
        tick_water(f, mut r, state, x, y, z)
        if d == opposite(try facing_of(f, state)) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "MultifaceBlock" {
        tick_water(f, mut r, state, x, y, z)
        if not multiface_any(f, state) {
            return f.ids.air_state
        }
        if f.get_bool(state, direction_property(d)) and not attaches_state(f, neighbour, d) {
            let fewer = try f.with_bool(state, direction_property(d), false)
            return if multiface_any(f, fewer) { fewer } else { f.ids.air_state }
        }
        return state
    }
    if kind == "SeaPickleBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        tick_water(f, mut r, state, x, y, z)
        // `VegetationBlock.updateShape`'s check, the same as the one above.
        return state
    }
    if kind == "SmallDripleafBlock" {
        tick_water(f, mut r, state, x, y, z)
        return try shape_as(e, mut r, "DoublePlantBlock", state, x, y, z, d, neighbour)
    }
    if kind == "BigDripleafBlock" {
        if d == DOWN and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        tick_water(f, mut r, state, x, y, z)
        if d == UP and f.is(neighbour, block) {
            return copy_properties(f, f.default_state(f.ids.big_dripleaf_stem), state, ["facing", "waterlogged"])
        }
        return state
    }
    if kind == "BigDripleafStemBlock" {
        if (d == DOWN or d == UP) and not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        tick_water(f, mut r, state, x, y, z)
        return state
    }
    if kind == "HangingRootsBlock" {
        if d == UP and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        tick_water(f, mut r, state, x, y, z)
        return state
    }
    if kind == "SporeBlossomBlock" {
        if d == UP and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "CactusBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        return state
    }
    if kind == "ChorusFlowerBlock" {
        if d != UP and not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        return state
    }
    if kind == "ChorusPlantBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
            return state
        }
        let connects = f.is(neighbour, block) or f.is(neighbour, try f.named_block("chorus_flower")) or (d == DOWN and f.in_set(neighbour, f.tag("minecraft:supports_chorus_plant")))
        return try f.with_bool(state, direction_property(d), connects)
    }
    if kind == "BambooSaplingBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        let bamboo = try f.named_block("bamboo")
        if d == UP and f.is(neighbour, bamboo) {
            return f.default_state(bamboo)
        }
        return state
    }
    if kind == "CreakingHeartBlock" or kind == "ScaffoldingBlock" {
        if kind == "ScaffoldingBlock" {
            tick_water(f, mut r, state, x, y, z)
        }
        r.schedule_block(block, x, y, z, 1, 0)
        return state
    }
    if kind == "FrogspawnBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "FireBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return try fire_with_age(f, r, x, y, z, f.get_int(state, "age") ?? 0)
    }
    if kind == "SoulFireBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return f.default_state(block)
    }
    if kind == "AttachedStemBlock" {
        let name = f.codec.blocks.name(block)
        let (fruit, stem) = if name == "minecraft:attached_melon_stem" { ("melon", "melon_stem") } else { ("pumpkin", "pumpkin_stem") }
        if not f.is(neighbour, try f.named_block(String(fruit))) and d == try facing_of(f, state) {
            return f.try_name(f.default_state(try f.named_block(String(stem))), "age", "7")
        }
        return try shape_as(e, mut r, "VegetationBlock", state, x, y, z, d, neighbour)
    }
    if kind == "FarmlandBlock" {
        if d == UP and not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        }
        return state
    }
    if kind == "FenceGateBlock" {
        let facing = try facing_of(f, state)
        if axis_of(clockwise(facing)) != axis_of(d) {
            return state
        }
        let walls = f.tag("minecraft:walls")
        var in_wall = f.in_set(neighbour, walls)
        if not in_wall {
            let back = opposite(d)
            in_wall = f.in_set(try r.state(f, x + step_x(back), y + step_y(back), z + step_z(back)), walls)
        }
        return try f.with_bool(state, "in_wall", in_wall)
    }
    if kind == "FlowerPotBlock" or kind == "BannerBlock" or kind == "BasePressurePlateBlock" or kind == "CakeBlock" or kind == "CandleCakeBlock" {
        if d == DOWN and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "StandingSignBlock" or kind == "CeilingHangingSignBlock" or kind == "WallSignBlock" or kind == "WallHangingSignBlock" {
        // Each checks the side it hangs from, then `SignBlock`'s water.
        let toward = if kind == "StandingSignBlock" {
            d == DOWN
        } else if kind == "CeilingHangingSignBlock" {
            d == UP
        } else if kind == "WallSignBlock" {
            opposite(d) == try facing_of(f, state)
        } else {
            axis_of(d) == axis_of(clockwise(try facing_of(f, state)))
        }
        if toward and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return try shape_as(e, mut r, "SignBlock", state, x, y, z, d, neighbour)
    }
    if kind == "FaceAttachedHorizontalDirectionalBlock" {
        if opposite(try face_attached_toward(f, state)) == d and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "LanternBlock" {
        tick_water(f, mut r, state, x, y, z)
        let connected = if f.get_bool(state, "hanging") { DOWN } else { UP }
        if opposite(connected) == d and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "BellBlock" {
        return try bell_updated(e, r, state, x, y, z, d, neighbour)
    }
    if kind == "PistonHeadBlock" or kind == "RedstoneWallTorchBlock" or kind == "TripWireHookBlock" {
        if opposite(d) == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "ComparatorBlock" {
        if d == DOWN and not f.sturdy(neighbour, UP, RIGID) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "RepeaterBlock" {
        // Gone off what can't hold it, `canSurviveOn`; locked afresh as a side changes (CAL-116).
        if d == DOWN and not f.sturdy(neighbour, UP, RIGID) {
            return f.ids.air_state
        }
        if axis_of(d) != axis_of(try facing_of(f, state)) {
            return try f.with_bool(state, "locked", try repeater_locked(f, r, state, x, y, z))
        }
        return state
    }
    if kind == "ObserverBlock" {
        // `startSignal`, once.
        if try facing_of(f, state) == d and not f.get_bool(state, "powered") and not r.has_block_tick(block, x, y, z) {
            r.schedule_block(block, x, y, z, 2, 0)
        }
        return state
    }
    if kind == "TripWireBlock" {
        if d == UP or d == DOWN {
            return state
        }
        // `shouldConnectTo`: a hook facing back along the wire, or more wire.
        let hook = try f.named_block("tripwire_hook")
        let connects = if f.is(neighbour, hook) { try facing_of(f, neighbour) == opposite(d) } else { f.is(neighbour, block) }
        return try f.with_bool(state, direction_property(d), connects)
    }
    if kind == "CopperChestBlock" {
        let s = try shape_as(e, mut r, "ChestBlock", state, x, y, z, d, neighbour)
        // A double copper chest takes on the kind of its other half.
        if f.in_set(neighbour, f.tag("minecraft:copper_chests")) and f.has(neighbour, "type") {
            if (f.get_name(s, "type") ?? String("single")) != "single" and try chest_connected(f, s) == d {
                return copy_properties(f, f.default_state(f.block(neighbour)), s, ["facing", "type", "waterlogged"])
            }
        }
        return s
    }
    if kind == "RedstoneWireBlock" {
        return try wire_updated(f, r, state, x, y, z, d, neighbour)
    }
    fail Thrown { exception: "Unimplemented", message: "updateShape of {kind}" }
}

// Water's tick where the block holds water, as the `updateShape` of most blocks that can.
fn tick_water<R: BlockAccess + RandomSource>(f: Facts, r: mut R, state: u32, x: i32, y: i32, z: i32) {
    if f.get_bool(state, "waterlogged") {
        r.schedule_fluid(WATER_FLUID, x, y, z)
    }
}

// `Direction.getAxis`: 0 for y, 1 for z, 2 for x.
fn axis_of(d: i32) -> i32 {
    return d / 2
}

// `withPropertiesOf`, for the properties named: `to` with each of them `from` has set as it is.
fn copy_properties(f: Facts, to: u32, from: u32, names: List<str>) -> u32 {
    var s = to
    for name in names {
        if let value = f.get_name(from, String(name)) {
            s = f.try_name(s, String(name), value)
        }
    }
    return s
}

/// `ConcretePowderBlock.touchesLiquid`: water beside or above it whose face toward it isn't
/// sturdy. Below never counts: vanilla's first look, for down, is at the powder itself, which
/// holds no water.
pub fn touches_liquid<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> bool ! Thrown {
    for d in [UP, NORTH, SOUTH, WEST, EAST] {
        let s = try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        if f.fluid_in(s, "minecraft:water") and not f.sturdy(s, opposite(d), FULL) {
            return true
        }
    }
    return false
}

/// The concrete a powder sets to, its `concrete`, which `Blocks` gives each powder by its colour.
pub fn concrete_of(f: Facts, powder: u32) -> u32 ! Thrown {
    let name = f.codec.blocks.name(powder)
    let n = name.len()
    if n > 7 {
        if let b = f.block_named(name[..n - 7]) {
            return b
        }
    }
    fail Thrown { exception: "Unimplemented", message: "the concrete {name} sets to" }
}

/// `NoteBlock.setInstrument`: a head's instrument from above, or else the block below's, the harp
/// where that's a head's.
pub fn note_instrument<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let above = f.instrument(try r.state(f, x, y + 1, z))
    if f.plays_above(above) {
        return try f.with_name(state, "instrument", f.instrument_name(above))
    }
    let below = f.instrument(try r.state(f, x, y - 1, z))
    let played = if f.plays_above(below) { 0u32 } else { below }
    return try f.with_name(state, "instrument", f.instrument_name(played))
}

/// `BubbleColumnBlock.canOccupy`: a bubble column already, or a full source of a fluid bubble
/// columns can be in, as a liquid block.
pub fn can_occupy(f: Facts, column: u32, state: u32) -> bool {
    if f.is(state, column) {
        return true
    }
    return f.fluid_in(state, "minecraft:bubble_column_can_occupy") and f.is_a(f.block(state), "LiquidBlock") and f.is_source(state) and f.fluid_amount(state) >= 8
}

/// `CoralBlock.scanForWater`: water on any side, looked for in `Direction`'s order.
pub fn touches_water<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> bool ! Thrown {
    for d in 0..6 {
        if f.is_water(try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))) {
            return true
        }
    }
    return false
}

// `BaseCoralPlantTypeBlock.tryScheduleDieTick`: unless it holds water or water touches it, dies a
// while later, 60 ticks and up to 39 more, drawn from the level's random.
pub fn coral_die_tick<R: BlockAccess + RandomSource>(f: Facts, r: mut R, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if f.get_bool(state, "waterlogged") or try touches_water(f, r, x, y, z) {
        return
    }
    let wait = 60 + r.next_int_below(40)
    r.schedule_block(f.block(state), x, y, z, wait, 0)
}

// `GrowingPlantHeadBlock.updateShape`: broken a tick later where what it hangs from can't hold
// it; a body, a cave vine keeping its berries, where more of the plant is past it; else kelp's
// water ticked.
fn growing_head<R: BlockAccess + RandomSource>(e: Env, r: mut R, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let name = f.codec.blocks.name(block)
    let (body, grows, fluid) = if name == "minecraft:kelp" {
        (f.ids.kelp_plant, UP, true)
    } else if name == "minecraft:twisting_vines" {
        (try f.named_block("twisting_vines_plant"), UP, false)
    } else if name == "minecraft:weeping_vines" {
        (try f.named_block("weeping_vines_plant"), DOWN, false)
    } else {
        (try f.named_block("cave_vines_plant"), DOWN, false)
    }
    var made_body = false
    if d == opposite(grows) {
        if not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1, 0)
        } else {
            let past = try r.state(f, x, y + step_y(grows), z)
            made_body = f.is(past, block) or f.is(past, body)
        }
    }
    if not made_body and (d != grows or (not f.is(neighbour, block) and not f.is(neighbour, body))) {
        if fluid {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        return state
    }
    // `updateBodyAfterConvertedFromHead`.
    let made = f.default_state(body)
    if f.has(state, "berries") {
        return try f.with_bool(made, "berries", f.get_bool(state, "berries"))
    }
    return made
}

// `MultifaceBlock.hasAnyFace`.
fn multiface_any(f: Facts, state: u32) -> bool {
    for d in 0..6 {
        if f.get_bool(state, direction_property(d)) {
            return true
        }
    }
    return false
}

/// `FireBlock.getStateWithAge`: `BaseFireBlock.getState`, soul fire on what it burns on, else
/// fire as it's placed, with the age.
pub fn fire_with_age<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, age: i32) -> u32 ! Thrown {
    let below = try r.state(f, x, y - 1, z)
    if f.in_set(below, f.tag("minecraft:soul_fire_base_blocks")) {
        return f.default_state(try f.named_block("soul_fire"))
    }
    let fire = try f.named_block("fire")
    var s = f.default_state(fire)
    // `getStateForPlacement`: on what can't burn and isn't sturdy, each side but down that can.
    if not f.can_burn(below) and not f.sturdy(below, UP, FULL) {
        for d in 1..6 {
            s = try f.with_bool(s, direction_property(d), f.can_burn(try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))))
        }
    }
    return try f.with_int(s, "age", age)
}

// `FaceAttachedHorizontalDirectionalBlock.getConnectedDirection`: up on a floor, down from a
// ceiling, else its facing.
fn face_attached_toward(f: Facts, state: u32) -> i32 ! Thrown {
    let face = f.get_name(state, "face") ?? String("wall")
    if face == "ceiling" {
        return DOWN
    }
    if face == "floor" {
        return UP
    }
    return try facing_of(f, state)
}

// `BellBlock.updateShape`: gone where what holds it can't, unless it hangs between two walls; a
// bell between two walls hangs from one where the other goes, and from both where one comes.
fn bell_updated<R: BlockAccess>(e: Env, r: R, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let attachment = f.get_name(state, "attachment") ?? String("floor")
    let facing = try facing_of(f, state)
    let connected = opposite(try bell_toward(f, state))
    if connected == d and not try can_survive(e, r, state, x, y, z) and attachment != "double_wall" {
        return f.ids.air_state
    }
    if axis_of(d) == axis_of(facing) {
        if attachment == "double_wall" and not f.sturdy(neighbour, d, FULL) {
            let single = try f.with_name(state, "attachment", "single_wall")
            return try f.with_name(single, "facing", direction_property(opposite(d)))
        }
        if attachment == "single_wall" and opposite(connected) == d and f.sturdy(neighbour, facing, FULL) {
            return try f.with_name(state, "attachment", "double_wall")
        }
    }
    return state
}

// `BellBlock.getConnectedDirection`: up on a floor, down from a ceiling, else behind it.
fn bell_toward(f: Facts, state: u32) -> i32 ! Thrown {
    let attachment = f.get_name(state, "attachment") ?? String("floor")
    if attachment == "floor" {
        return UP
    }
    if attachment == "ceiling" {
        return DOWN
    }
    return opposite(try facing_of(f, state))
}

// `RedstoneWireBlock.updateShape`: gone off what can't hold it, joined afresh under a change
// above, else the side toward the neighbour joined again, and the rest worked out again where
// that turns a line into a cross or a dot.
fn wire_updated<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    if d == DOWN {
        return if try wire_holds(f, neighbour) { state } else { f.ids.air_state }
    }
    if d == UP {
        return try wire_connections(f, r, state, x, y, z)
    }
    let up = not f.redstone_conductor(try r.state(f, x, y + 1, z))
    let side = try wire_side(f, r, x, y, z, d, up)
    let name = direction_property(d)
    let was = f.get_name(state, name) ?? String("none")
    if (side != "none") == (was != "none") and not wire_cross(f, state) {
        return try f.with_name(state, name, side)
    }
    var cross = f.default_state(f.block(state))
    for i in 0..4 {
        cross = try f.with_name(cross, direction_property(horizontal(i)), "side")
    }
    cross = try f.with_int(cross, "power", f.get_int(state, "power") ?? 0)
    return try wire_connections(f, r, try f.with_name(cross, name, side), x, y, z)
}

// `GrowingPlantBodyBlock.updateShape`: broken a tick later where what it hangs from can't hold it;
// the head again, of a random age from the region's random, where what's past its growth is
// neither body nor head, a cave vine keeping its berries; else kelp's water ticked.
fn growing_body<R: BlockAccess + RandomSource>(e: Env, r: mut R, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let name = f.codec.blocks.name(block)
    let (head, grows, fluid) = if name == "minecraft:kelp_plant" {
        (f.ids.kelp, UP, true)
    } else if name == "minecraft:twisting_vines_plant" {
        (try f.named_block(String("twisting_vines")), UP, false)
    } else if name == "minecraft:weeping_vines_plant" {
        (try f.named_block(String("weeping_vines")), DOWN, false)
    } else {
        (try f.named_block(String("cave_vines")), DOWN, false)
    }
    if d == opposite(grows) and not try can_survive(e, r, state, x, y, z) {
        r.schedule_block(block, x, y, z, 1, 0)
    }
    if d == grows and not f.is(neighbour, block) and not f.is(neighbour, head) {
        // `GrowingPlantHeadBlock.getStateForPlacement(random)`.
        let age = r.next_int_below(25)
        var made = try f.with_int(f.default_state(head), String("age"), age)
        if f.has(state, String("berries")) {
            made = try f.with_bool(made, "berries", f.get_bool(state, "berries"))
        }
        return made
    }
    if fluid {
        r.schedule_fluid(WATER_FLUID, x, y, z)
    }
    return state
}

// `ChestBlock.getConnectedDirection`: where the other half of a double chest is, clockwise from
// the way a left half faces, counterclockwise from a right or single one's.
fn chest_connected(f: Facts, state: u32) -> i32 ! Thrown {
    let facing = try facing_of(f, state)
    if (f.get_name(state, String("type")) ?? String("single")) == "left" {
        return clockwise(facing)
    }
    return opposite(clockwise(facing))
}

// `Block.isExceptionForConnection`: what bars and panes don't join for its sturdy face.
// A wall's side toward `d`: none, low or tall.
fn wall_side(f: Facts, state: u32, d: i32) -> String {
    return f.get_name(state, direction_property(d)) ?? String("none")
}

// `WallBlock.connectsTo` of the block beside, by its side toward the wall: another wall, a
// sturdy face that isn't an exception, iron bars, or a gate turned across.
fn wall_connects(f: Facts, state: u32, d: i32) -> bool ! Thrown {
    let block = f.block(state)
    var gate = false
    if f.is_a(block, "FenceGateBlock") {
        gate = axis_x(try facing_of(f, state)) == axis_x(clockwise(d))
    }
    return f.in_set(state, f.tag("minecraft:walls")) or (not exception_for_connection(f, state) and f.sturdy(state, d, FULL)) or f.is_a(block, "IronBarsBlock") or gate
}

fn exception_for_connection(f: Facts, state: u32) -> bool {
    if f.is_a(f.block(state), "LeavesBlock") or f.in_set(state, f.tag("minecraft:shulker_boxes")) {
        return true
    }
    let name = f.codec.blocks.name(f.block(state))
    return name == "minecraft:barrier" or name == "minecraft:carved_pumpkin" or name == "minecraft:jack_o_lantern" or name == "minecraft:melon" or name == "minecraft:pumpkin"
}

// `StairBlock.getStairsShape`: outer where stairs behind turn across it, inner where stairs in
// front do, unless stairs beside it the same way stop the turn.
fn stairs_shape<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> String ! Thrown {
    let facing = try facing_of(f, state)
    let half = f.get_name(state, String("half"))
    let behind = try r.state(f, x + step_x(facing), y, z + step_z(facing))
    if f.is_a(f.block(behind), "StairBlock") and half == f.get_name(behind, String("half")) {
        let behind_facing = try facing_of(f, behind)
        if axis_x(behind_facing) != axis_x(facing) and try takes_shape(f, r, state, x, y, z, opposite(behind_facing)) {
            if behind_facing == opposite(clockwise(facing)) {
                return String("outer_left")
            }
            return String("outer_right")
        }
    }
    let front_d = opposite(facing)
    let front = try r.state(f, x + step_x(front_d), y, z + step_z(front_d))
    if f.is_a(f.block(front), "StairBlock") and half == f.get_name(front, String("half")) {
        let front_facing = try facing_of(f, front)
        if axis_x(front_facing) != axis_x(facing) and try takes_shape(f, r, state, x, y, z, front_facing) {
            if front_facing == opposite(clockwise(facing)) {
                return String("inner_left")
            }
            return String("inner_right")
        }
    }
    return String("straight")
}

// Whether a horizontal direction runs along x.
fn axis_x(d: i32) -> bool {
    return d == EAST or d == WEST
}

// `StairBlock.canTakeShape`: the block that way isn't stairs facing and set as these are.
fn takes_shape<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32, d: i32) -> bool ! Thrown {
    let other = try r.state(f, x + step_x(d), y, z + step_z(d))
    if not f.is_a(f.block(other), "StairBlock") {
        return true
    }
    return try facing_of(f, other) != try facing_of(f, state) or f.get_name(other, String("half")) != f.get_name(state, String("half"))
}

/// `Block.updateFromNeighbourShapes`: the state updated by each of its neighbours in
/// `UPDATE_SHAPE_ORDER`: west, east, north, south, down, up.
pub fn update_from_neighbours<R: BlockAccess + RandomSource>(e: Env, r: mut R, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    var s = state
    for d in [WEST, EAST, NORTH, SOUTH, DOWN, UP] {
        let neighbour = try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        s = try update_shape(e, mut r, s, x, y, z, d, neighbour)
    }
    return s
}

// `PotentSulfurBlock.validBlockState`: dry without a water source above, else as the block below
// makes it erupt.
fn potent_sulfur<R: BlockAccess + RandomSource>(e: Env, r: mut R, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let above = try r.state(f, x, y + 1, z)
    if f.fluid(above) != WATER_FLUID {
        return try f.with_name(state, "potent_sulfur_state", "dry")
    }
    let below = try r.state(f, x, y - 1, z)
    // `isSourceIfFluid`.
    let source = f.fluid(below) == 0 or f.is_source(below)
    if f.in_set(below, f.tag("minecraft:causes_continuous_geyser_eruptions")) and source {
        return try f.with_name(state, "potent_sulfur_state", "continuous")
    }
    if f.in_set(below, f.tag("minecraft:causes_periodic_geyser_eruptions")) and source {
        let now = f.get_name(state, "potent_sulfur_state") ?? String()
        if now != "erupting" and now != "dormant" {
            // `resetCountdown` of its block entity, whose countdown is -1 as it's made.
            _ = try r.block_entity(f, x, y, z)
        }
        if now == "erupting" {
            return state
        }
        return try f.with_name(state, "potent_sulfur_state", "dormant")
    }
    return try f.with_name(state, "potent_sulfur_state", "wet")
}

// `SpeleothemBlock.updateShape`.
fn speleothem_updated<R: BlockAccess + RandomSource>(e: Env, r: mut R, state: u32, x: i32, y: i32, z: i32, d: i32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    if f.get_bool(state, "waterlogged") {
        r.schedule_fluid(WATER_FLUID, x, y, z)
    }
    if d != UP and d != DOWN {
        return state
    }
    let tip = if (f.get_name(state, "vertical_direction") ?? String("up")) == "down" { DOWN } else { UP }
    if tip == DOWN and r.has_block_tick(block, x, y, z) {
        return state
    }
    if d == opposite(tip) and not try can_survive(e, r, state, x, y, z) {
        r.schedule_block(block, x, y, z, if tip == DOWN { 2 } else { 1 }, 0)
        return state
    }
    let merge = (f.get_name(state, "thickness") ?? String()) == "tip_merge"
    // `calculateSpeleothemThickness`.
    let base = opposite(tip)
    let front = try r.state(f, x, y + step_y(tip), z)
    let thickness = if speleothem_toward(f, front, base) and f.is(front, block) {
        if not merge and (f.get_name(front, "thickness") ?? String()) != "tip_merge" { "tip" } else { "tip_merge" }
    } else if not speleothem_toward(f, front, tip) {
        "tip"
    } else {
        let ahead = f.get_name(front, "thickness") ?? String()
        if ahead != "tip" and ahead != "tip_merge" {
            let behind = try r.state(f, x, y + step_y(base), z)
            if not speleothem_toward(f, behind, tip) { "base" } else { "middle" }
        } else {
            "frustum"
        }
    }
    return try f.with_name(state, "thickness", String(thickness))
}

// `SpeleothemBlock.isSpeleothemWithDirection`: a speleothem whose tip points `tip`.
fn speleothem_toward(f: Facts, state: u32, tip: i32) -> bool {
    if not f.in_set(state, f.tag("minecraft:speleothems")) {
        return false
    }
    let want = if tip == DOWN { "down" } else { "up" }
    return (f.get_name(state, "vertical_direction") ?? String()) == String(want)
}

/// `LeavesBlock.getDistanceAt`: 0 for what keeps leaves from decaying, a leaf's distance, else 7.
pub fn leaf_distance(e: Env, state: u32) -> i32 {
    let Env { facts: f, .. } = e
    if f.in_set(state, f.tag("minecraft:prevents_nearby_leaf_decay")) {
        return 0
    }
    if f.is_a(f.block(state), "LeavesBlock") {
        return f.get_int(state, "distance") ?? 7
    }
    return 7
}

// `VineBlock.getUpdatedState`: each face kept only where it can still hang.
fn vine_updated<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    var s = state
    if f.get_bool(s, "up") {
        // `isAcceptableNeighbour(level, abovePos, Direction.DOWN)`, as vanilla writes it.
        s = try f.with_bool(s, "up", attaches_state(f, try r.state(f, x, y + 1, z), DOWN))
    }
    var above: u32? = none
    for i in 0..4 {
        let d = horizontal(i)
        let name = direction_property(d)
        if f.get_bool(s, name) {
            var can = try vine_supported(f, r, x, y, z, d)
            if not can {
                if above == none {
                    above = some(try r.state(f, x, y + 1, z))
                }
                let a = above ?? 0
                can = f.is(a, f.block(state)) and f.get_bool(a, name)
            }
            s = try f.with_bool(s, name, can)
        }
    }
    return s
}

// `VineBlock.canSupportAtFace`, of a horizontal face.
fn vine_supported<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, d: i32) -> bool ! Thrown {
    if attaches_state(f, try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d)), d) {
        return true
    }
    let above = try r.state(f, x, y + 1, z)
    return f.is(above, f.ids.vine) and f.get_bool(above, direction_property(d))
}

// `VineBlock.hasFaces`.
fn vine_has_faces(f: Facts, state: u32) -> bool {
    return f.get_bool(state, "up") or f.get_bool(state, "north") or f.get_bool(state, "east") or f.get_bool(state, "south") or f.get_bool(state, "west")
}
/// `MossyCarpetBlock.getUpdatedState`: each side low where it can hang, tall under a hanging
// side, none over a carpet without that side.
pub fn mossy_updated<R: BlockAccess>(f: Facts, r: R, carpet: u32, state: u32, x: i32, y: i32, z: i32, create_sides: bool) -> u32 ! Thrown {
    var s = state
    var above: u32? = none
    var below: u32? = none
    let base = f.get_bool(state, "bottom")
    let create = create_sides or base
    for i in 0..4 {
        let d = horizontal(i)
        let name = direction_property(d)
        var side = String("none")
        if attaches_state(f, try r.state(f, x + step_x(d), y, z + step_z(d)), d) {
            side = if create { String("low") } else { f.get_name(s, name) ?? String("none") }
        }
        if side == "low" {
            if above == none {
                above = some(try r.state(f, x, y + 1, z))
            }
            let a = above ?? 0
            if f.is(a, carpet) and (f.get_name(a, name) ?? String("none")) != "none" and not f.get_bool(a, "bottom") {
                side = String("tall")
            }
            if not base {
                if below == none {
                    below = some(try r.state(f, x, y - 1, z))
                }
                let b = below ?? 0
                if f.is(b, carpet) and (f.get_name(b, name) ?? String("none")) == "none" {
                    side = String("none")
                }
            }
        }
        s = try f.with_name(s, name, side)
    }
    return s
}

/// `MossyCarpetBlock.hasFaces`.
pub fn mossy_has_faces(f: Facts, state: u32) -> bool {
    if f.get_bool(state, "bottom") {
        return true
    }
    for i in 0..4 {
        if (f.get_name(state, direction_property(horizontal(i))) ?? String("none")) != "none" {
            return true
        }
    }
    return false
}

// Edges.

/// A bounding box and the shape filled in it, as `BitSetDiscreteVoxelShape` holds one.
pub struct Shape {
    pub min_x: i32
    pub min_y: i32
    pub min_z: i32
    pub xs: i32
    pub ys: i32
    pub zs: i32
    pub full: List<bool>
}

impl Shape {
    /// An empty shape of the box from the corner, `xs` by `ys` by `zs`.
    pub fn new(min_x: i32, min_y: i32, min_z: i32, xs: i32, ys: i32, zs: i32) -> Shape {
        return Shape { min_x: min_x, min_y: min_y, min_z: min_z, xs: xs, ys: ys, zs: zs, full: [false; usize.wrap(xs * ys * zs)] }
    }

    pub fn inside(self, x: i32, y: i32, z: i32) -> bool {
        return x >= self.min_x and y >= self.min_y and z >= self.min_z and x < self.min_x + self.xs and y < self.min_y + self.ys and z < self.min_z + self.zs
    }

    pub fn index(self, x: i32, y: i32, z: i32) -> usize {
        return usize.wrap(((x - self.min_x) * self.ys + (y - self.min_y)) * self.zs + (z - self.min_z))
    }

    pub fn fill(mut self, x: i32, y: i32, z: i32) {
        let i = self.index(x, y, z)
        self.full[i] = true
    }

    pub fn is_full_local(self, x: i32, y: i32, z: i32) -> bool {
        if x < 0 or y < 0 or z < 0 or x >= self.xs or y >= self.ys or z >= self.zs {
            return false
        }
        return self.full[usize.wrap((x * self.ys + y) * self.zs + z)]
    }
}

/// `StructureTemplate.updateShapeAtEdge` with the update flags `flags`: each face of the shape
/// with nothing beside it, the block inside updated by its neighbour, then the neighbour by it,
/// as `DiscreteVoxelShape.forAllFaces` goes over them: along `z`, then `y`, then `x`. What
/// changes is set with `flags` without `UPDATE_NEIGHBORS`.
pub fn update_edges(e: Env, r: mut Region, shape: Shape, flags: i32) ! Thrown {
    // Faces across `z`: `x`, then `y`, then `z` along the line.
    for a in 0..shape.xs {
        for b in 0..shape.ys {
            try update_line(e, mut r, flags, shape, a, b, 0, shape.zs, 2)
        }
    }
    // Across `y`: `z`, then `x`.
    for a in 0..shape.zs {
        for b in 0..shape.xs {
            try update_line(e, mut r, flags, shape, b, 0, a, shape.ys, 1)
        }
    }
    // Across `x`: `y`, then `z`.
    for a in 0..shape.ys {
        for b in 0..shape.zs {
            try update_line(e, mut r, flags, shape, 0, a, b, shape.xs, 0)
        }
    }
}

// One line of `forAllAxisFaces` along the axis `axis` (0 `x`, 1 `y`, 2 `z`) from the local
// position given, where the shape starts and ends.
fn update_line(e: Env, r: mut Region, flags: i32, shape: Shape, x0: i32, y0: i32, z0: i32, size: i32, axis: i32) ! Thrown {
    let negative = if axis == 0 { WEST } else if axis == 1 { DOWN } else { NORTH }
    let positive = opposite(negative)
    var last = false
    for c in 0..size + 1 {
        let lx = if axis == 0 { c } else { x0 }
        let ly = if axis == 1 { c } else { y0 }
        let lz = if axis == 2 { c } else { z0 }
        let full = c != size and shape.is_full_local(lx, ly, lz)
        if not last and full {
            try update_face(e, mut r, flags, negative, shape.min_x + lx, shape.min_y + ly, shape.min_z + lz)
        }
        if last and not full {
            let px = if axis == 0 { c - 1 } else { x0 }
            let py = if axis == 1 { c - 1 } else { y0 }
            let pz = if axis == 2 { c - 1 } else { z0 }
            try update_face(e, mut r, flags, positive, shape.min_x + px, shape.min_y + py, shape.min_z + pz)
        }
        last = full
    }
}

// One face of `updateShapeAtEdge`: the block and its neighbour toward `d` each updated by the
// other, set with the flags without `UPDATE_NEIGHBORS` where they change.
fn update_face(e: Env, r: mut Region, flags: i32, d: i32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    let nx = x + step_x(d)
    let ny = y + step_y(d)
    let nz = z + step_z(d)
    let state = try r.state(f, x, y, z)
    let neighbour = try r.state(f, nx, ny, nz)
    let changed = try update_shape(e, mut r, state, x, y, z, d, neighbour)
    if changed != state {
        _ = r.set_block(f, x, y, z, changed, flags & -2)
    }
    let neighbour_changed = try update_shape(e, mut r, neighbour, nx, ny, nz, opposite(d), changed)
    if neighbour_changed != neighbour {
        _ = r.set_block(f, nx, ny, nz, neighbour_changed, flags & -2)
    }
}
