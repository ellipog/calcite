/// `updateShape`: what a block becomes when a neighbour changes, as vanilla's blocks work it out
/// by the class that declares the method, with the ticks some schedule. Features ask it where a
/// structure's or a tree's edge meets the world. A class Calcite doesn't know yet throws
/// `Unimplemented`, which the rig reports as such, rather than guessing.
module worldgen.shapes

import worldgen.facts.{DOWN, EAST, Facts, NORTH, SOUTH, UP, WATER_FLUID, WEST, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.region.{Region}
import worldgen.survive.{Env, attaches_state, can_survive, direction_property, facing_of}

/// `BlockState.updateShape` of `state` at the block, toward `d`, where `neighbour` is.
pub fn update_shape(e: Env, r: mut Region, state: u32, x: i32, y: i32, z: i32, d: i32, neighbour: u32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let kind = f.shape_class(block)
    if kind == "BlockBehaviour" {
        return state
    }
    if kind == "LeavesBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        let from_neighbour = leaf_distance(e, neighbour) + 1
        if from_neighbour != 1 or (f.get_int(state, "distance") ?? 7) != from_neighbour {
            r.schedule_block(block, x, y, z, 0)
        }
        return state
    }
    if kind == "SnowyBlock" {
        if d == UP {
            return try f.with_bool(state, "snowy", f.in_set(neighbour, f.tag("minecraft:snow")))
        }
        return state
    }
    if kind == "LiquidBlock" {
        if f.is_source(state) or f.is_source(neighbour) {
            r.schedule_fluid(f.fluid(state), x, y, z)
        }
        if d == DOWN and f.fluid_in(state, "minecraft:bubble_column_can_occupy") and f.is_source(state) and f.fluid_amount(state) == 8 {
            let drag = f.in_set(neighbour, f.tag("minecraft:enables_bubble_column_drag_down"))
            if drag or f.in_set(neighbour, f.tag("minecraft:enables_bubble_column_push_up")) {
                r.schedule_block(block, x, y, z, 0)
            }
        }
        return state
    }
    if kind == "VegetationBlock" or kind == "SnowLayerBlock" or kind == "CarpetBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "DoublePlantBlock" {
        let lower = (f.get_name(state, "half") ?? String("lower")) == "lower"
        var other_half = false
        if f.is(neighbour, block) {
            other_half = ((f.get_name(neighbour, "half") ?? String("lower")) == "lower") != lower
        }
        if (d == UP or d == DOWN) and lower == (d == UP) and not other_half {
            return f.ids.air_state
        }
        // Its own check below, then `VegetationBlock.updateShape`'s, which is the same.
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "VineBlock" {
        if d == DOWN {
            return state
        }
        let updated = try vine_updated(f, r, state, x, y, z)
        if not vine_has_faces(f, updated) {
            return f.ids.air_state
        }
        return updated
    }
    if kind == "ShelfMushroomBlock" {
        let facing = try facing_of(f, state)
        if d == opposite(facing) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "HugeMushroomBlock" {
        if f.is(neighbour, block) {
            return try f.with_bool(state, direction_property(d), false)
        }
        return state
    }
    if kind == "MangroveRootsBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        return state
    }
    if kind == "MangrovePropaguleBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        // Its own check toward up, then `VegetationBlock.updateShape`'s, which is the same.
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "MossyCarpetBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        let updated = try mossy_updated(f, r, block, state, x, y, z, false)
        if not mossy_has_faces(f, updated) {
            return f.ids.air_state
        }
        return updated
    }
    if kind == "HangingMossBlock" {
        if not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 0)
        }
        return try f.with_bool(state, "tip", not f.is(try r.state(f, x, y - 1, z), block))
    }
    if kind == "CocoaBlock" {
        if d == try facing_of(f, state) and not try can_survive(e, r, state, x, y, z) {
            return f.ids.air_state
        }
        return state
    }
    if kind == "BeehiveBlock" {
        if f.is_a(f.block(neighbour), "FireBlock") {
            fail Thrown { exception: "Unimplemented", message: "a beehive emptied by fire" }
        }
        return state
    }
    if kind == "FallingBlock" or kind == "BrushableBlock" {
        r.schedule_block(block, x, y, z, 0)
        return state
    }
    if kind == "SlabBlock" {
        if f.get_bool(state, "waterlogged") {
            r.schedule_fluid(WATER_FLUID, x, y, z)
        }
        return state
    }
    if kind == "PotentSulfurBlock" {
        return try potent_sulfur(e, mut r, state, x, y, z)
    }
    if kind == "PathBlock" {
        // Turned back to dirt a tick later when something solid lands on it.
        if d == UP and not try can_survive(e, r, state, x, y, z) {
            r.schedule_block(block, x, y, z, 1)
        }
        return state
    }
    if kind == "SpeleothemBlock" {
        return try speleothem_updated(e, mut r, state, x, y, z, d)
    }
    fail Thrown { exception: "Unimplemented", message: "updateShape of {kind}" }
}

/// `Block.updateFromNeighbourShapes`: the state updated by each of its neighbours in
/// `UPDATE_SHAPE_ORDER`: west, east, north, south, down, up.
pub fn update_from_neighbours(e: Env, r: mut Region, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    var s = state
    for d in [WEST, EAST, NORTH, SOUTH, DOWN, UP] {
        let neighbour = try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        s = try update_shape(e, mut r, s, x, y, z, d, neighbour)
    }
    return s
}

// `PotentSulfurBlock.validBlockState`: dry without a water source above, else as the block below
// makes it erupt.
fn potent_sulfur(e: Env, r: mut Region, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let above = try r.state(f, x, y + 1, z)
    if f.fluid(above) != WATER_FLUID {
        return try f.with_name(state, "potent_sulfur_state", "dry")
    }
    let below = try r.state(f, x, y - 1, z)
    // `isSourceIfFluid`.
    let source = f.fluid(below) == 0 or f.is_source(below)
    if f.in_set(below, f.tag("minecraft:causes_continuous_geyser_eruptions")) and source {
        return try f.with_name(state, "potent_sulfur_state", "continuous")
    }
    if f.in_set(below, f.tag("minecraft:causes_periodic_geyser_eruptions")) and source {
        let now = f.get_name(state, "potent_sulfur_state") ?? String()
        if now != "erupting" and now != "dormant" {
            // `resetCountdown` of its block entity, whose countdown is -1 as it's made.
            _ = try r.block_entity(f, x, y, z)
        }
        if now == "erupting" {
            return state
        }
        return try f.with_name(state, "potent_sulfur_state", "dormant")
    }
    return try f.with_name(state, "potent_sulfur_state", "wet")
}

// `SpeleothemBlock.updateShape`.
fn speleothem_updated(e: Env, r: mut Region, state: u32, x: i32, y: i32, z: i32, d: i32) -> u32 ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    if f.get_bool(state, "waterlogged") {
        r.schedule_fluid(WATER_FLUID, x, y, z)
    }
    if d != UP and d != DOWN {
        return state
    }
    let tip = if (f.get_name(state, "vertical_direction") ?? String("up")) == "down" { DOWN } else { UP }
    if tip == DOWN and r.has_block_tick(block, x, y, z) {
        return state
    }
    if d == opposite(tip) and not try can_survive(e, r, state, x, y, z) {
        r.schedule_block(block, x, y, z, 0)
        return state
    }
    let merge = (f.get_name(state, "thickness") ?? String()) == "tip_merge"
    // `calculateSpeleothemThickness`.
    let base = opposite(tip)
    let front = try r.state(f, x, y + step_y(tip), z)
    let thickness = if speleothem_toward(f, front, base) and f.is(front, block) {
        if not merge and (f.get_name(front, "thickness") ?? String()) != "tip_merge" { "tip" } else { "tip_merge" }
    } else if not speleothem_toward(f, front, tip) {
        "tip"
    } else {
        let ahead = f.get_name(front, "thickness") ?? String()
        if ahead != "tip" and ahead != "tip_merge" {
            let behind = try r.state(f, x, y + step_y(base), z)
            if not speleothem_toward(f, behind, tip) { "base" } else { "middle" }
        } else {
            "frustum"
        }
    }
    return try f.with_name(state, "thickness", String(thickness))
}

// `SpeleothemBlock.isSpeleothemWithDirection`: a speleothem whose tip points `tip`.
fn speleothem_toward(f: Facts, state: u32, tip: i32) -> bool {
    if not f.in_set(state, f.tag("minecraft:speleothems")) {
        return false
    }
    let want = if tip == DOWN { "down" } else { "up" }
    return (f.get_name(state, "vertical_direction") ?? String()) == String(want)
}

// `LeavesBlock.getDistanceAt`: 0 for what keeps leaves from decaying, a leaf's distance, else 7.
fn leaf_distance(e: Env, state: u32) -> i32 {
    let Env { facts: f, .. } = e
    if f.in_set(state, f.tag("minecraft:prevents_nearby_leaf_decay")) {
        return 0
    }
    if f.is_a(f.block(state), "LeavesBlock") {
        return f.get_int(state, "distance") ?? 7
    }
    return 7
}

// `VineBlock.getUpdatedState`: each face kept only where it can still hang.
fn vine_updated(f: Facts, r: Region, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    var s = state
    if f.get_bool(s, "up") {
        // `isAcceptableNeighbour(level, abovePos, Direction.DOWN)`, as vanilla writes it.
        s = try f.with_bool(s, "up", attaches_state(f, try r.state(f, x, y + 1, z), DOWN))
    }
    var above: u32? = none
    for i in 0..4 {
        let d = horizontal(i)
        let name = direction_property(d)
        if f.get_bool(s, name) {
            var can = try vine_supported(f, r, x, y, z, d)
            if not can {
                if above == none {
                    above = some(try r.state(f, x, y + 1, z))
                }
                let a = above ?? 0
                can = f.is(a, f.block(state)) and f.get_bool(a, name)
            }
            s = try f.with_bool(s, name, can)
        }
    }
    return s
}

// `VineBlock.canSupportAtFace`, of a horizontal face.
fn vine_supported(f: Facts, r: Region, x: i32, y: i32, z: i32, d: i32) -> bool ! Thrown {
    if attaches_state(f, try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d)), d) {
        return true
    }
    let above = try r.state(f, x, y + 1, z)
    return f.is(above, f.ids.vine) and f.get_bool(above, direction_property(d))
}

// `VineBlock.hasFaces`.
fn vine_has_faces(f: Facts, state: u32) -> bool {
    return f.get_bool(state, "up") or f.get_bool(state, "north") or f.get_bool(state, "east") or f.get_bool(state, "south") or f.get_bool(state, "west")
}
/// `MossyCarpetBlock.getUpdatedState`: each side low where it can hang, tall under a hanging
// side, none over a carpet without that side.
pub fn mossy_updated(f: Facts, r: Region, carpet: u32, state: u32, x: i32, y: i32, z: i32, create_sides: bool) -> u32 ! Thrown {
    var s = state
    var above: u32? = none
    var below: u32? = none
    let base = f.get_bool(state, "bottom")
    let create = create_sides or base
    for i in 0..4 {
        let d = horizontal(i)
        let name = direction_property(d)
        var side = String("none")
        if attaches_state(f, try r.state(f, x + step_x(d), y, z + step_z(d)), d) {
            side = if create { String("low") } else { f.get_name(s, name) ?? String("none") }
        }
        if side == "low" {
            if above == none {
                above = some(try r.state(f, x, y + 1, z))
            }
            let a = above ?? 0
            if f.is(a, carpet) and (f.get_name(a, name) ?? String("none")) != "none" and not f.get_bool(a, "bottom") {
                side = String("tall")
            }
            if not base {
                if below == none {
                    below = some(try r.state(f, x, y - 1, z))
                }
                let b = below ?? 0
                if f.is(b, carpet) and (f.get_name(b, name) ?? String("none")) == "none" {
                    side = String("none")
                }
            }
        }
        s = try f.with_name(s, name, side)
    }
    return s
}

/// `MossyCarpetBlock.hasFaces`.
pub fn mossy_has_faces(f: Facts, state: u32) -> bool {
    if f.get_bool(state, "bottom") {
        return true
    }
    for i in 0..4 {
        if (f.get_name(state, direction_property(horizontal(i))) ?? String("none")) != "none" {
            return true
        }
    }
    return false
}

// Edges.

/// A bounding box and the shape filled in it, as `BitSetDiscreteVoxelShape` holds one.
pub struct Shape {
    pub min_x: i32
    pub min_y: i32
    pub min_z: i32
    pub xs: i32
    pub ys: i32
    pub zs: i32
    pub full: List<bool>
}

impl Shape {
    /// An empty shape of the box from the corner, `xs` by `ys` by `zs`.
    pub fn new(min_x: i32, min_y: i32, min_z: i32, xs: i32, ys: i32, zs: i32) -> Shape {
        return Shape { min_x: min_x, min_y: min_y, min_z: min_z, xs: xs, ys: ys, zs: zs, full: [false; usize.wrap(xs * ys * zs)] }
    }

    pub fn inside(self, x: i32, y: i32, z: i32) -> bool {
        return x >= self.min_x and y >= self.min_y and z >= self.min_z and x < self.min_x + self.xs and y < self.min_y + self.ys and z < self.min_z + self.zs
    }

    pub fn index(self, x: i32, y: i32, z: i32) -> usize {
        return usize.wrap(((x - self.min_x) * self.ys + (y - self.min_y)) * self.zs + (z - self.min_z))
    }

    pub fn fill(mut self, x: i32, y: i32, z: i32) {
        let i = self.index(x, y, z)
        self.full[i] = true
    }

    pub fn is_full_local(self, x: i32, y: i32, z: i32) -> bool {
        if x < 0 or y < 0 or z < 0 or x >= self.xs or y >= self.ys or z >= self.zs {
            return false
        }
        return self.full[usize.wrap((x * self.ys + y) * self.zs + z)]
    }
}

/// `StructureTemplate.updateShapeAtEdge` with the update flags `flags`: each face of the shape
/// with nothing beside it, the block inside updated by its neighbour, then the neighbour by it,
/// as `DiscreteVoxelShape.forAllFaces` goes over them: along `z`, then `y`, then `x`. What
/// changes is set with `flags` without `UPDATE_NEIGHBORS`.
pub fn update_edges(e: Env, r: mut Region, shape: Shape, flags: i32) ! Thrown {
    // Faces across `z`: `x`, then `y`, then `z` along the line.
    for a in 0..shape.xs {
        for b in 0..shape.ys {
            try update_line(e, mut r, flags, shape, a, b, 0, shape.zs, 2)
        }
    }
    // Across `y`: `z`, then `x`.
    for a in 0..shape.zs {
        for b in 0..shape.xs {
            try update_line(e, mut r, flags, shape, b, 0, a, shape.ys, 1)
        }
    }
    // Across `x`: `y`, then `z`.
    for a in 0..shape.ys {
        for b in 0..shape.zs {
            try update_line(e, mut r, flags, shape, 0, a, b, shape.xs, 0)
        }
    }
}

// One line of `forAllAxisFaces` along the axis `axis` (0 `x`, 1 `y`, 2 `z`) from the local
// position given, where the shape starts and ends.
fn update_line(e: Env, r: mut Region, flags: i32, shape: Shape, x0: i32, y0: i32, z0: i32, size: i32, axis: i32) ! Thrown {
    let negative = if axis == 0 { WEST } else if axis == 1 { DOWN } else { NORTH }
    let positive = opposite(negative)
    var last = false
    for c in 0..size + 1 {
        let lx = if axis == 0 { c } else { x0 }
        let ly = if axis == 1 { c } else { y0 }
        let lz = if axis == 2 { c } else { z0 }
        let full = c != size and shape.is_full_local(lx, ly, lz)
        if not last and full {
            try update_face(e, mut r, flags, negative, shape.min_x + lx, shape.min_y + ly, shape.min_z + lz)
        }
        if last and not full {
            let px = if axis == 0 { c - 1 } else { x0 }
            let py = if axis == 1 { c - 1 } else { y0 }
            let pz = if axis == 2 { c - 1 } else { z0 }
            try update_face(e, mut r, flags, positive, shape.min_x + px, shape.min_y + py, shape.min_z + pz)
        }
        last = full
    }
}

// One face of `updateShapeAtEdge`: the block and its neighbour toward `d` each updated by the
// other, set with the flags without `UPDATE_NEIGHBORS` where they change.
fn update_face(e: Env, r: mut Region, flags: i32, d: i32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    let nx = x + step_x(d)
    let ny = y + step_y(d)
    let nz = z + step_z(d)
    let state = try r.state(f, x, y, z)
    let neighbour = try r.state(f, nx, ny, nz)
    let changed = try update_shape(e, mut r, state, x, y, z, d, neighbour)
    if changed != state {
        _ = r.set_block(f, x, y, z, changed, flags & -2)
    }
    let neighbour_changed = try update_shape(e, mut r, neighbour, nx, ny, nz, opposite(d), changed)
    if neighbour_changed != neighbour {
        _ = r.set_block(f, nx, ny, nz, neighbour_changed, flags & -2)
    }
}
