/// Vanilla's features, as 26.3 places them in a chunk's `features` step: the placed features of
/// `worldgen/placed_feature` and the features of `worldgen/feature`, read as their codecs read
/// them; the placement modifiers that turn a placed feature's origin into the positions it's
/// placed at, run as `FeaturePlacer` runs them; the features themselves; and the order
/// `FeatureSorter` puts each step's features in, which `applyBiomeDecoration` places them in.
///
/// A feature of a type Calcite doesn't place yet reads, and fails as it's placed with the
/// exception `Unimplemented`, which the rig reports as such.
module worldgen.features

import json.tree.{Json, Member, as_string}
import math.mth.{SinTable, floor}
import pack.zip.{Zip}
import random.legacy.{LegacyRandom}
import random.source.{RandomSource}
import random.worldgen.{WorldgenRandom}
import random.xoroshiro.{XoroshiroRandom}
import resources.identifier.{Identifier}
import std.java.math.{cos, sin}
import world.chunk.{MOTION_BLOCKING, OCEAN_FLOOR, OCEAN_FLOOR_WG, WORLD_SURFACE}
import worldgen.caves.{Cluster, Geode, LargeDripstone, Speleothem, place_cluster, place_geode, place_large_dripstone, place_speleothem, read_cluster, read_geode, read_large_dripstone, read_speleothem}
import worldgen.codec.{bool_of, double_of, field, float_range, float_range_field, int_field, int_of, int_range_field, map_of, optional_bool_field, type_of}
import worldgen.density.{data_json}
import worldgen.facts.{BlockSet, DOWN, EAST, EMPTY_FLUID, FLOWING_LAVA, FLOWING_WATER, FULL, Facts, LAVA_FLUID, NORTH, SOUTH, UP, WATER_FLUID, WEST, clockwise, direction_name, direction_named, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.multiface.{multiface_state, shuffle, spread_from_face}
import worldgen.nether.{Delta, HugeFungus, NeighborSpread, ReplaceBlobs, SteppedColumns, place_delta, place_huge_fungus, place_neighbor_spread, place_replace_blobs, place_stepped_columns, read_delta, read_huge_fungus, read_neighbor_spread, read_replace_blobs, read_stepped_columns}
import worldgen.noise.{Noise}
import worldgen.predicates.{Pred, Readers, Rule, list_of, read_block, read_blocks, read_direction, read_pred, read_rule, read_state, test, test_rule}
import worldgen.providers.{HeightProvider, IntProvider, int_provider_field, read_height}
import worldgen.region.{Region}
import worldgen.state_providers.{Providers, get_state, optional_state, pick}
import worldgen.survive.{Env, attaches_state, can_survive, direction_property}
import worldgen.sculk.{SculkPatch, place_sculk_patch, read_sculk_patch}
import worldgen.shapes.{mossy_has_faces, mossy_updated}
import worldgen.temperature.{Temperatures}
import worldgen.trees.{Decorator, Grow, Pos, Tree, TreeTags, axis_name, axis_of, by_y, decorate as decorate_tree, finish as finish_tree, grow as grow_tree, read_decorators, read_tree, set_decoration, shuffle_positions, tree_tags}

/// `GenerationStep.Decoration.values().length`: the steps a chunk is decorated in at least.
const DECORATION_STEPS: i32 = 11
/// `(float) Math.PI`.
const PI_F32: f32 = 3.1415927f32

/// A placement modifier.
pub enum Modifier {
    Biome
    Filter(Pred)
    CountOnEveryLayer(IntProvider)
    Count(IntProvider)
    EnvironmentScan { direction: i32, target: Pred, allowed: Pred, max_steps: i32 }
    /// The positions, as `x, y, z` in a row each.
    Fixed(List<i32>)
    HeightRange(HeightProvider)
    Heightmap(i32)
    InSquare
    NoiseBasedCount { ratio: i32, factor: f64, offset: f64 }
    NoiseThresholdCount { level: f64, below: i32, above: i32 }
    Offset { x: IntProvider, y: IntProvider, z: IntProvider }
    RandomChance(f32)
    RandomlySelected(List<Modifier>)
    Rarity(i32)
    SurfaceRelativeThreshold { heightmap: i32, min: i32, max: i32 }
    SurfaceWaterDepth(i32)
    Cuboid { xz: IntProvider, y: IntProvider, edges: bool, interior: bool }
}

/// An ore's `BlockReplacement`: the state put where the rule passes.
pub struct Replacement {
    pub rule: Rule
    pub state: u32
}

/// A feature. Others it places are indexes into the catalog's placed features.
pub enum Feature {
    NoOp
    Ore { targets: List<Replacement>, size: i32, discard: f32 }
    ScatteredOre { targets: List<Replacement>, size: i32, discard: f32 }
    SimpleBlock { provider: usize, schedule_tick: bool }
    RandomSelector { features: List<usize>, chances: List<f32>, fallback: usize }
    SimpleRandomSelector(List<usize>)
    RandomBooleanSelector { yes: usize, no: usize }
    WeightedRandomSelector { features: List<usize>, weights: List<i32>, total: i32 }
    Sequence(List<usize>)
    MonsterRoom
    /// A spring: the fluid by ID and the block it's placed as.
    Spring { fluid: u32, legacy: u32, below: bool, rocks: i32, holes: i32, valid: BlockSet }
    UnderwaterMagma { search: i32, radius: i32, chance: f32 }
    /// `lake`: its fluid and barrier, by provider, and its three predicates.
    Lake { fluid: usize, barrier: usize, can_place: Pred, air_or_fluid: Pred, barrier_ok: Pred }
    /// `disk`: its provider, target, radius and half height.
    Disk { provider: usize, target: Pred, radius: IntProvider, half: i32 }
    FreezeTopLayer
    /// `tree`.
    Tree(Tree)
    VegetationPatch(Patch)
    BlockColumn { heights: List<IntProvider>, providers: List<usize>, direction: i32, allowed: Pred, tip: bool }
    Overlay(List<usize>)
    BlockPile(usize)
    Vines
    BlueIce
    BlockBlob { state: u32, can_place_on: Pred }
    HugeMushroom { red: bool, cap: usize, stem: usize, radius: i32, can_place_on: Pred }
    Speleothem(Speleothem)
    SpeleothemCluster(Cluster)
    LargeDripstone(LargeDripstone)
    Geode(Geode)
    SculkPatch(SculkPatch)
    HugeFungus(HugeFungus)
    NeighborSpread(NeighborSpread)
    Delta(Delta)
    ReplaceBlobs(ReplaceBlobs)
    SteppedColumns(SteppedColumns)
    FallenTree { trunk: usize, length: IntProvider, stump: List<Decorator>, log: List<Decorator>, tags: TreeTags }
    /// `multiface_growth`: its block, search range, faces, chance of spreading and the blocks it
    /// grows on.
    MultifaceGrowth { block: u32, search: i32, on_floor: bool, ceiling: bool, wall: bool, chance: f32, on: BlockSet }
    /// A feature of a type that isn't placed yet, by the type's ID.
    Unsupported(String)
}

/// A `vegetation_patch` or `waterlogged_vegetation_patch`, as read.
pub struct Patch {
    replaceable: BlockSet
    ground: usize
    vegetation: usize
    ceiling: bool
    depth: IntProvider
    extra_bottom: f32
    vertical: i32
    chance: f32
    radius: IntProvider
    extra_edge: f32
    waterlogged: bool
}

/// A placed feature: its feature, by index, and its placement.
pub struct Placed {
    pub feature: usize
    pub placement: List<Modifier>
}

/// The features read, each read by reference once.
pub struct Catalog {
    pub placed: List<Placed>
    pub features: List<Feature>
    pub providers: Providers
    placed_ids: Map<String, usize>
    feature_ids: Map<String, usize>
}

impl Catalog {
    pub fn new() -> Catalog {
        return Catalog {
            placed: List<Placed>(),
            features: List<Feature>(),
            providers: Providers.new(),
            placed_ids: Map<String, usize>(),
            feature_ids: Map<String, usize>(),
        }
    }

    /// `PlacedFeature.CODEC`: a placed feature by its ID, or written out.
    pub fn read_placed(mut self, zip: Zip, facts: Facts, rd: Readers, value: Json) -> usize ! String {
        if let text = as_string(value) {
            let id = (try Identifier.parse(text)).to_string()
            if let i = self.placed_ids.get(id) {
                return i
            }
            let json = try data_json(zip, id.copy(), "placed_feature")
            let i = try self.read_placed_direct(zip, facts, rd, json)
            self.placed_ids.insert(id, i)
            return i
        }
        return try self.read_placed_direct(zip, facts, rd, value)
    }

    // `PlacedFeature.DIRECT_CODEC`.
    fn read_placed_direct(mut self, zip: Zip, facts: Facts, rd: Readers, value: Json) -> usize ! String {
        let m = try map_of(value)
        let f = field(m, "feature") else fail "No key feature in MapLike"
        let feature = try self.read_feature(zip, facts, rd, f)
        let p = field(m, "placement") else fail "No key placement in MapLike"
        var placement = List<Modifier>()
        for item in try list_of(p) {
            placement.push(try read_modifier(facts, rd, item))
        }
        self.placed.push(Placed { feature: feature, placement: placement })
        return self.placed.len() - 1
    }

    /// `PlacedFeature.LIST_CODEC`, or with `force_list` the lists of `LIST_OF_LISTS_CODEC`: a tag,
    /// a list of placed features, or without `force_list` one alone. Vanilla's pack has no
    /// placed feature tags, so every tag is missing.
    pub fn read_placed_set(mut self, zip: Zip, facts: Facts, rd: Readers, value: Json, force_list: bool) -> List<usize> ! String {
        if let text = as_string(value) {
            if text.starts_with("#") {
                fail "Missing tag: '{text[1..]}' in 'minecraft:worldgen/placed_feature'"
            }
        }
        let items = match value {
            Json.Array(a) => a.copy(),
            _ => {
                if force_list {
                    fail "Not a list: {value}"
                }
                return [try self.read_placed(zip, facts, rd, value)]
            },
        }
        var out = List<usize>()
        for item in items {
            out.push(try self.read_placed(zip, facts, rd, item))
        }
        return out
    }

    /// `Feature.CODEC`: a feature by its ID, or written out.
    fn read_feature(mut self, zip: Zip, facts: Facts, rd: Readers, value: Json) -> usize ! String {
        if let text = as_string(value) {
            let id = (try Identifier.parse(text)).to_string()
            if let i = self.feature_ids.get(id) {
                return i
            }
            let json = try data_json(zip, id.copy(), "feature")
            let i = try self.read_feature_direct(zip, facts, rd, json)
            self.feature_ids.insert(id, i)
            return i
        }
        return try self.read_feature_direct(zip, facts, rd, value)
    }

    // `Feature.DIRECT_CODEC`: by the feature type's codec.
    fn read_feature_direct(mut self, zip: Zip, facts: Facts, rd: Readers, value: Json) -> usize ! String {
        let m = try map_of(value)
        let kind = try type_of(m)
        let feature = try self.read_typed(zip, facts, rd, m, kind)
        self.features.push(feature)
        return self.features.len() - 1
    }

    fn read_typed(mut self, zip: Zip, facts: Facts, rd: Readers, m: List<Member>, kind: String) -> Feature ! String {
        if kind == "minecraft:no_op" {
            return Feature.NoOp
        }
        if kind == "minecraft:monster_room" {
            return Feature.MonsterRoom
        }
        if kind == "minecraft:spring_feature" {
            let s = field(m, "state") else fail "No key state in MapLike"
            let (fluid, legacy) = try read_fluid_state(facts, rd, s)
            var below = true
            if let v = field(m, "requires_block_below") {
                below = try bool_of(v)
            }
            var rocks = 4
            if let v = field(m, "rock_count") {
                rocks = try int_of(v)
            }
            var holes = 1
            if let v = field(m, "hole_count") {
                holes = try int_of(v)
            }
            let vb = field(m, "valid_blocks") else fail "No key valid_blocks in MapLike"
            let valid = try read_blocks(facts, rd.blocks, vb)
            return Feature.Spring { fluid: fluid, legacy: legacy, below: below, rocks: rocks, holes: holes, valid: valid }
        }
        if kind == "minecraft:tree" {
            var tree = try read_tree(mut self.providers, zip, facts, rd, m)
            // `pale_moss` places the registry's `pale_moss_patch`, if it has one.
            var i: usize = 0
            while i < tree.decorators.len() {
                var moss: (f32, f32, f32)? = none
                match tree.decorators[i] {
                    Decorator.PaleMoss { leaves, trunk, ground, .. } => moss = some((leaves, trunk, ground)),
                    _ => {},
                }
                if let (l, tr, gr) = moss {
                    let patch = match self.read_feature(zip, facts, rd, Json.Str(String("minecraft:pale_moss_patch"))) {
                        ok(p) => some(p),
                        err(_) => none,
                    }
                    tree.decorators[i] = Decorator.PaleMoss { leaves: l, trunk: tr, ground: gr, patch: patch }
                }
                i += 1
            }
            return Feature.Tree(tree)
        }
        if kind == "minecraft:vegetation_patch" or kind == "minecraft:waterlogged_vegetation_patch" {
            let rv = field(m, "replaceable") else fail "No key replaceable in MapLike"
            let replaceable = try read_blocks(facts, rd.blocks, rv)
            let gv = field(m, "ground_state") else fail "No key ground_state in MapLike"
            let ground = try self.providers.read(zip, facts, rd, gv)
            let vv = field(m, "vegetation_feature") else fail "No key vegetation_feature in MapLike"
            let vegetation = try self.read_placed(zip, facts, rd, vv)
            let sv = field(m, "surface") else fail "No key surface in MapLike"
            let surface = as_string(sv) else fail "Not a string: {sv}"
            if surface != "floor" and surface != "ceiling" {
                fail "Unknown element name:{surface}"
            }
            let depth = try int_provider_field(m, "depth", 1, 128)
            let extra_bottom = try float_range_field(m, "extra_bottom_block_chance", 0.0f32, 1.0f32)
            let vertical = try int_range_field(m, "vertical_range", 1, 256)
            let chance = try float_range_field(m, "vegetation_chance", 0.0f32, 1.0f32)
            let radius = try int_provider_field(m, "xz_radius", -2147483648, 2147483647)
            let extra_edge = try float_range_field(m, "extra_edge_column_chance", 0.0f32, 1.0f32)
            return Feature.VegetationPatch(Patch {
                replaceable: replaceable,
                ground: ground,
                vegetation: vegetation,
                ceiling: surface == "ceiling",
                depth: depth,
                extra_bottom: extra_bottom,
                vertical: vertical,
                chance: chance,
                radius: radius,
                extra_edge: extra_edge,
                waterlogged: kind == "minecraft:waterlogged_vegetation_patch",
            })
        }
        if kind == "minecraft:block_column" {
            let lv = field(m, "layers") else fail "No key layers in MapLike"
            var heights = List<IntProvider>()
            var providers = List<usize>()
            for item in try list_of(lv) {
                let lm = try map_of(item)
                heights.push(try int_provider_field(lm, "height", 0, 2147483647))
                let pv = field(lm, "provider") else fail "No key provider in MapLike"
                providers.push(try self.providers.read(zip, facts, rd, pv))
            }
            let dv = field(m, "direction") else fail "No key direction in MapLike"
            let direction = try read_direction(dv)
            let av = field(m, "allowed_placement") else fail "No key allowed_placement in MapLike"
            let allowed = try read_pred(facts, rd, av)
            let tv = field(m, "prioritize_tip") else fail "No key prioritize_tip in MapLike"
            return Feature.BlockColumn { heights: heights, providers: providers, direction: direction, allowed: allowed, tip: try bool_of(tv) }
        }
        if kind == "minecraft:overlay" {
            let v = field(m, "features") else fail "No key features in MapLike"
            let features = try self.read_placed_set(zip, facts, rd, v, false)
            if features.is_empty() {
                fail "Holder set must not be empty"
            }
            return Feature.Overlay(features)
        }
        if kind == "minecraft:speleothem" {
            return Feature.Speleothem(try read_speleothem(facts, rd, m))
        }
        if kind == "minecraft:speleothem_cluster" {
            return Feature.SpeleothemCluster(try read_cluster(facts, rd, m))
        }
        if kind == "minecraft:large_dripstone" {
            return Feature.LargeDripstone(try read_large_dripstone(facts, rd, m))
        }
        if kind == "minecraft:sculk_patch" {
            return Feature.SculkPatch(try read_sculk_patch(m))
        }
        if kind == "minecraft:huge_fungus" {
            return Feature.HugeFungus(try read_huge_fungus(facts, rd, m))
        }
        if kind == "minecraft:random_neighbor_spread" {
            return Feature.NeighborSpread(try read_neighbor_spread(mut self.providers, zip, facts, rd, m))
        }
        if kind == "minecraft:delta_feature" {
            return Feature.Delta(try read_delta(facts, m))
        }
        if kind == "minecraft:netherrack_replace_blobs" {
            return Feature.ReplaceBlobs(try read_replace_blobs(facts, m))
        }
        if kind == "minecraft:stepped_column_cluster" {
            return Feature.SteppedColumns(try read_stepped_columns(mut self.providers, zip, facts, rd, m))
        }
        if kind == "minecraft:geode" {
            return Feature.Geode(try read_geode(mut self.providers, zip, facts, rd, m))
        }
        if kind == "minecraft:vines" {
            return Feature.Vines
        }
        if kind == "minecraft:blue_ice" {
            return Feature.BlueIce
        }
        if kind == "minecraft:block_blob" {
            let sv = field(m, "state") else fail "No key state in MapLike"
            let state = try read_state(facts, sv)
            let pv = field(m, "can_place_on") else fail "No key can_place_on in MapLike"
            return Feature.BlockBlob { state: state, can_place_on: try read_pred(facts, rd, pv) }
        }
        if kind == "minecraft:huge_red_mushroom" or kind == "minecraft:huge_brown_mushroom" {
            let cv = field(m, "cap_provider") else fail "No key cap_provider in MapLike"
            let cap = try self.providers.read(zip, facts, rd, cv)
            let sv = field(m, "stem_provider") else fail "No key stem_provider in MapLike"
            let stem = try self.providers.read(zip, facts, rd, sv)
            var radius = 2
            if let v = field(m, "foliage_radius") {
                radius = try int_of(v)
            }
            let pv = field(m, "can_place_on") else fail "No key can_place_on in MapLike"
            let can_place_on = try read_pred(facts, rd, pv)
            return Feature.HugeMushroom { red: kind == "minecraft:huge_red_mushroom", cap: cap, stem: stem, radius: radius, can_place_on: can_place_on }
        }
        if kind == "minecraft:block_pile" {
            let v = field(m, "state_provider") else fail "No key state_provider in MapLike"
            return Feature.BlockPile(try self.providers.read(zip, facts, rd, v))
        }
        if kind == "minecraft:fallen_tree" {
            let tv = field(m, "trunk_provider") else fail "No key trunk_provider in MapLike"
            let trunk = try self.providers.read(zip, facts, rd, tv)
            let length = try int_provider_field(m, "log_length", 0, 16)
            let sv = field(m, "stump_decorators") else fail "No key stump_decorators in MapLike"
            let stump = try read_decorators(mut self.providers, zip, facts, rd, sv)
            let lv = field(m, "log_decorators") else fail "No key log_decorators in MapLike"
            let log = try read_decorators(mut self.providers, zip, facts, rd, lv)
            return Feature.FallenTree { trunk: trunk, length: length, stump: stump, log: log, tags: tree_tags(facts) }
        }
        if kind == "minecraft:freeze_top_layer" {
            return Feature.FreezeTopLayer
        }
        if kind == "minecraft:disk" {
            let pv = field(m, "state_provider") else fail "No key state_provider in MapLike"
            let provider = try self.providers.read(zip, facts, rd, pv)
            let tv = field(m, "target") else fail "No key target in MapLike"
            let target = try read_pred(facts, rd, tv)
            let radius = try int_provider_field(m, "radius", 0, 8)
            let half = try int_range_field(m, "half_height", 0, 4)
            return Feature.Disk { provider: provider, target: target, radius: radius, half: half }
        }
        if kind == "minecraft:multiface_growth" {
            let bv = field(m, "block") else fail "No key block in MapLike"
            let block = try read_block(facts, bv)
            if not facts.is_a(block, "MultifaceSpreadeableBlock") {
                fail "Growth block should be a multiface spreadeable block"
            }
            var search = 10
            if let v = field(m, "search_range") {
                search = try int_of(v)
                if search < 1 or search > 64 {
                    fail "Value {search} outside of range [1:64]"
                }
            }
            let on_floor = try optional_bool_field(m, "can_place_on_floor", false)
            let ceiling = try optional_bool_field(m, "can_place_on_ceiling", false)
            let wall = try optional_bool_field(m, "can_place_on_wall", false)
            var chance = 0.5f32
            if let v = field(m, "chance_of_spreading") {
                chance = try float_range(v, 0.0f32, 1.0f32)
            }
            let ov = field(m, "can_be_placed_on") else fail "No key can_be_placed_on in MapLike"
            let on = try read_blocks(facts, rd.blocks, ov)
            return Feature.MultifaceGrowth { block: block, search: search, on_floor: on_floor, ceiling: ceiling, wall: wall, chance: chance, on: on }
        }
        if kind == "minecraft:lake" {
            let fv = field(m, "fluid") else fail "No key fluid in MapLike"
            let fluid = try self.providers.read(zip, facts, rd, fv)
            let bv = field(m, "barrier") else fail "No key barrier in MapLike"
            let barrier = try self.providers.read(zip, facts, rd, bv)
            let pv = field(m, "can_place_feature") else fail "No key can_place_feature in MapLike"
            let av = field(m, "can_replace_with_air_or_fluid") else fail "No key can_replace_with_air_or_fluid in MapLike"
            let wv = field(m, "can_replace_with_barrier") else fail "No key can_replace_with_barrier in MapLike"
            return Feature.Lake { fluid: fluid, barrier: barrier, can_place: try read_pred(facts, rd, pv), air_or_fluid: try read_pred(facts, rd, av), barrier_ok: try read_pred(facts, rd, wv) }
        }
        if kind == "minecraft:underwater_magma" {
            let search = try int_range_field(m, "floor_search_range", 0, 512)
            let radius = try int_range_field(m, "placement_radius_around_floor", 0, 64)
            let chance = try float_range_field(m, "placement_probability_per_valid_position", 0.0f32, 1.0f32)
            return Feature.UnderwaterMagma { search: search, radius: radius, chance: chance }
        }
        if kind == "minecraft:ore" or kind == "minecraft:scattered_ore" {
            let t = field(m, "targets") else fail "No key targets in MapLike"
            var targets = List<Replacement>()
            for item in try list_of(t) {
                let tm = try map_of(item)
                let rule_value = field(tm, "target") else fail "No key target in MapLike"
                let state_value = field(tm, "state") else fail "No key state in MapLike"
                targets.push(Replacement { rule: try read_rule(facts, rule_value), state: try read_state(facts, state_value) })
            }
            let size = try int_range_field(m, "size", 0, 64)
            let discard = try float_range_field(m, "discard_chance_on_air_exposure", 0.0f32, 1.0f32)
            if kind == "minecraft:ore" {
                return Feature.Ore { targets: targets, size: size, discard: discard }
            }
            return Feature.ScatteredOre { targets: targets, size: size, discard: discard }
        }
        if kind == "minecraft:simple_block" {
            let v = field(m, "to_place") else fail "No key to_place in MapLike"
            let provider = try self.providers.read(zip, facts, rd, v)
            var schedule_tick = false
            if let s = field(m, "schedule_tick") {
                schedule_tick = try bool_of(s)
            }
            return Feature.SimpleBlock { provider: provider, schedule_tick: schedule_tick }
        }
        if kind == "minecraft:random_selector" {
            let v = field(m, "features") else fail "No key features in MapLike"
            var features = List<usize>()
            var chances = List<f32>()
            for item in try list_of(v) {
                let wm = try map_of(item)
                let fv = field(wm, "feature") else fail "No key feature in MapLike"
                features.push(try self.read_placed(zip, facts, rd, fv))
                chances.push(try float_range_field(wm, "chance", 0.0f32, 1.0f32))
            }
            let d = field(m, "default") else fail "No key default in MapLike"
            let fallback = try self.read_placed(zip, facts, rd, d)
            return Feature.RandomSelector { features: features, chances: chances, fallback: fallback }
        }
        if kind == "minecraft:simple_random_selector" or kind == "minecraft:sequence" {
            let v = field(m, "features") else fail "No key features in MapLike"
            let features = try self.read_placed_set(zip, facts, rd, v, false)
            if features.is_empty() {
                fail "Holder set must not be empty"
            }
            if kind == "minecraft:sequence" {
                return Feature.Sequence(features)
            }
            return Feature.SimpleRandomSelector(features)
        }
        if kind == "minecraft:random_boolean_selector" {
            let a = field(m, "feature_true") else fail "No key feature_true in MapLike"
            let b = field(m, "feature_false") else fail "No key feature_false in MapLike"
            let yes = try self.read_placed(zip, facts, rd, a)
            let no = try self.read_placed(zip, facts, rd, b)
            return Feature.RandomBooleanSelector { yes: yes, no: no }
        }
        if kind == "minecraft:weighted_random_selector" {
            let v = field(m, "features") else fail "No key features in MapLike"
            var features = List<usize>()
            var weights = List<i32>()
            var total: i64 = 0
            for item in try list_of(v) {
                let wm = try map_of(item)
                let d = field(wm, "data") else fail "No key data in MapLike"
                let w = field(wm, "weight") else fail "No key weight in MapLike"
                let weight = try int_of(w)
                if weight < 0 {
                    fail "Value must be non-negative: {weight}"
                }
                features.push(try self.read_placed(zip, facts, rd, d))
                weights.push(weight)
                total += i64(weight)
            }
            if total > 2147483647 {
                fail "Sum of weights must be <= 2147483647"
            }
            return Feature.WeightedRandomSelector { features: features, weights: weights, total: i32.wrap(total) }
        }
        if is_feature_type(kind) {
            return Feature.Unsupported(kind.copy())
        }
        fail "Unknown registry key in ResourceKey[minecraft:root / minecraft:worldgen/feature_type]: {kind}"
    }
}

// Whether `kind` is one of 26.3's feature types.
fn is_feature_type(kind: String) -> bool {
    let names: List<String> = [
        "bamboo", "block_blob", "block_column", "block_pile", "blue_ice", "bonus_chest", "chorus_plant", "coral_claw",
        "coral_tree", "delta_feature", "disk", "end_gateway", "end_island", "end_platform", "end_podium", "end_spike",
        "fallen_tree", "fill_layer", "fossil", "freeze_top_layer", "geode", "huge_brown_mushroom", "huge_fungus",
        "huge_red_mushroom", "iceberg", "lake", "large_dripstone", "monster_room", "multiface_growth",
        "netherrack_replace_blobs", "no_op", "ore", "overlay", "projected_random_patchy_square",
        "random_boolean_selector", "random_neighbor_spread", "random_selector", "replace_single_block", "root_system",
        "scattered_ore", "sculk_patch", "sequence", "simple_block", "simple_random_selector", "single_block_pillar",
        "speleothem", "speleothem_cluster", "spike", "spring_feature", "stepped_column_cluster", "template", "tree",
        "underwater_magma", "vegetation_patch", "vines", "void_start_platform", "waterlogged_vegetation_patch",
        "weighted_random_selector",
    ]
    for n in names {
        if kind == "minecraft:{n}" {
            return true
        }
    }
    return false
}

/// `Heightmap.Types.CODEC`: a heightmap by its name.
pub fn read_heightmap(value: Json) -> i32 ! String {
    let text = as_string(value) else fail "Not a string: {value}"
    let names: List<String> = ["WORLD_SURFACE_WG", "WORLD_SURFACE", "OCEAN_FLOOR_WG", "OCEAN_FLOOR", "MOTION_BLOCKING", "MOTION_BLOCKING_NO_LEAVES"]
    for i in 0..names.len() {
        if names[i] == text {
            return i32.wrap(i)
        }
    }
    fail "Unknown element name:{text}"
}

// `PlacementModifier.CODEC`: by the modifier type's codec.
fn read_modifier(facts: Facts, rd: Readers, value: Json) -> Modifier ! String {
    let m = try map_of(value)
    let kind = try type_of(m)
    if kind == "minecraft:biome" {
        return Modifier.Biome
    }
    if kind == "minecraft:in_square" {
        return Modifier.InSquare
    }
    if kind == "minecraft:block_predicate_filter" {
        let v = field(m, "predicate") else fail "No key predicate in MapLike"
        return Modifier.Filter(try read_pred(facts, rd, v))
    }
    if kind == "minecraft:count" {
        return Modifier.Count(try int_provider_field(m, "count", 0, 4096))
    }
    if kind == "minecraft:count_on_every_layer" {
        return Modifier.CountOnEveryLayer(try int_provider_field(m, "count", 0, 256))
    }
    if kind == "minecraft:environment_scan" {
        let d = field(m, "direction_of_search") else fail "No key direction_of_search in MapLike"
        let text = as_string(d) else fail "Not a string: {d}"
        let direction = if text == "up" { 1 } else if text == "down" { -1 } else { fail "Expected a vertical direction" }
        let t = field(m, "target_condition") else fail "No key target_condition in MapLike"
        let target = try read_pred(facts, rd, t)
        var allowed = Pred.True
        if let a = field(m, "allowed_search_condition") {
            allowed = try read_pred(facts, rd, a)
        }
        let max_steps = try int_range_field(m, "max_steps", 1, 32)
        return Modifier.EnvironmentScan { direction: direction, target: target, allowed: allowed, max_steps: max_steps }
    }
    if kind == "minecraft:fixed_placement" {
        let v = field(m, "positions") else fail "No key positions in MapLike"
        var positions = List<i32>()
        for item in try list_of(v) {
            let coords = try list_of(item)
            if coords.len() != 3 {
                fail "Input is not a list of 3 ints"
            }
            for c in coords {
                positions.push(try int_of(c))
            }
        }
        return Modifier.Fixed(positions)
    }
    if kind == "minecraft:height_range" {
        let v = field(m, "height") else fail "No key height in MapLike"
        return Modifier.HeightRange(try read_height(v))
    }
    if kind == "minecraft:heightmap" {
        let v = field(m, "heightmap") else fail "No key heightmap in MapLike"
        return Modifier.Heightmap(try read_heightmap(v))
    }
    if kind == "minecraft:noise_based_count" {
        let ratio = try int_field(m, "noise_to_count_ratio")
        let f = field(m, "noise_factor") else fail "No key noise_factor in MapLike"
        let factor = try double_of(f)
        var offset = 0.0
        if let o = field(m, "noise_offset") {
            offset = try double_of(o)
        }
        return Modifier.NoiseBasedCount { ratio: ratio, factor: factor, offset: offset }
    }
    if kind == "minecraft:noise_threshold_count" {
        let l = field(m, "noise_level") else fail "No key noise_level in MapLike"
        let level = try double_of(l)
        let below = try int_field(m, "below_noise")
        let above = try int_field(m, "above_noise")
        return Modifier.NoiseThresholdCount { level: level, below: below, above: above }
    }
    if kind == "minecraft:offset" {
        let x = try int_provider_field(m, "x", -16, 16)
        let y = try int_provider_field(m, "y", -16, 16)
        let z = try int_provider_field(m, "z", -16, 16)
        return Modifier.Offset { x: x, y: y, z: z }
    }
    if kind == "minecraft:random_chance" {
        return Modifier.RandomChance(try float_range_field(m, "chance", 0.0f32, 1.0f32))
    }
    if kind == "minecraft:randomly_selected" {
        let v = field(m, "placements") else fail "No key placements in MapLike"
        var placements = List<Modifier>()
        for item in try list_of(v) {
            placements.push(try read_modifier(facts, rd, item))
        }
        if placements.is_empty() {
            fail "List must have contents"
        }
        return Modifier.RandomlySelected(placements)
    }
    if kind == "minecraft:rarity_filter" {
        let chance = try int_field(m, "chance")
        if chance <= 0 {
            fail "Value must be positive: {chance}"
        }
        return Modifier.Rarity(chance)
    }
    if kind == "minecraft:surface_relative_threshold_filter" {
        let h = field(m, "heightmap") else fail "No key heightmap in MapLike"
        let heightmap = try read_heightmap(h)
        var min = i32.MIN
        if let v = field(m, "min_inclusive") {
            min = try int_of(v)
        }
        var max = i32.MAX
        if let v = field(m, "max_inclusive") {
            max = try int_of(v)
        }
        return Modifier.SurfaceRelativeThreshold { heightmap: heightmap, min: min, max: max }
    }
    if kind == "minecraft:surface_water_depth_filter" {
        return Modifier.SurfaceWaterDepth(try int_field(m, "max_water_depth"))
    }
    if kind == "minecraft:cuboid" {
        let xz = try int_provider_field(m, "xz_size", 1, 16)
        let y = try int_provider_field(m, "y_size", 1, 16)
        var edges = true
        if let v = field(m, "include_edges") {
            edges = try bool_of(v)
        }
        var interior = true
        if let v = field(m, "include_interior") {
            interior = try bool_of(v)
        }
        return Modifier.Cuboid { xz: xz, y: y, edges: edges, interior: interior }
    }
    fail "Unknown registry key in ResourceKey[minecraft:root / minecraft:worldgen/placement_modifier_type]: {kind}"
}

/// The order `FeatureSorter` gives each step's features, and the features each biome lists.
pub struct Decoration {
    /// Each step's features, by index into the catalog's placed features, in the order of their
    /// global indexes.
    pub steps: List<List<usize>>
    /// Each step's global index of each feature in it.
    index: List<Map<usize, i32>>
    /// The biomes the source can give, in its order.
    possible: List<i32>
    /// Each biome's features of each step, by the biome's ID.
    by_biome: List<List<List<usize>>>
    /// Each biome's features of every step: what `BiomeFilter` asks.
    in_biome: List<Set<usize>>
    /// Why the features couldn't be sorted, if they couldn't.
    cycle: bool
}

impl Decoration {
    /// No biomes' features, for placing features alone.
    pub fn empty() -> Decoration {
        return Decoration { steps: [], index: [], possible: [], by_biome: [], in_biome: [], cycle: false }
    }

    /// The features of the biomes in `possible`, the biome source's, from their JSON in the
    /// pack, read into `catalog` and sorted as `FeatureSorter.buildFeaturesPerStep` sorts them.
    pub fn of_biomes(catalog: mut Catalog, zip: Zip, facts: Facts, rd: Readers, possible: List<i32>) -> Decoration ! String {
        let count = rd.biomes.entries.len()
        var by_biome = List<List<List<usize>>>()
        var in_biome = List<Set<usize>>()
        for _ in 0..count {
            by_biome.push(List<List<usize>>())
            in_biome.push(Set<usize>())
        }
        for b in possible {
            let id = rd.biomes.entries[usize.wrap(b)].to_string()
            let json = try data_json(zip, id.copy(), "biome")
            let m = try map_of(json)
            let value = field(m, "features") else fail "biome `{id}` has no `features`"
            var steps = List<List<usize>>()
            for step in try list_of(value) {
                let set = try catalog.read_placed_set(zip, facts, rd, step, true)
                for p in set {
                    in_biome[usize.wrap(b)].insert(p)
                }
                steps.push(set)
            }
            by_biome[usize.wrap(b)] = steps
        }
        var d = Decoration { steps: [], index: [], possible: possible.copy(), by_biome: by_biome, in_biome: in_biome, cycle: false }
        d.sort()
        return d
    }

    // `FeatureSorter.buildFeaturesPerStep`: each feature of each step a node, keyed by its step
    // and the order it was first seen in, with an edge to the feature after it in each biome's
    // list of all its steps' features; the nodes in reverse of the order a depth-first search
    // from each in key order finishes them, split by step.
    fn sort(mut self) {
        var first_seen = Map<usize, i64>()
        var next: i64 = 0
        var node_feature = Map<i64, usize>()
        var edges = Map<i64, List<i64>>()
        var max_step: usize = 0
        for b in self.possible {
            let steps = self.by_biome[usize.wrap(b)].len()
            if steps > max_step {
                max_step = steps
            }
            var list = List<i64>()
            for i in 0..steps {
                for p in self.by_biome[usize.wrap(b)][i] {
                    let fi = match first_seen.get(p) {
                        some(v) => v,
                        none => {
                            first_seen.insert(p, next)
                            next += 1
                            next - 1
                        },
                    }
                    let key = (i64.wrap(i) << 32) | fi
                    node_feature.insert(key, p)
                    list.push(key)
                }
            }
            for i in 0..list.len() {
                if not edges.contains(list[i]) {
                    edges.insert(list[i], List<i64>())
                }
                if i + 1 < list.len() {
                    let after = list[i + 1]
                    if not edges[list[i]].contains(after) {
                        edges[list[i]].push(after)
                    }
                }
            }
        }
        var keys = List<i64>()
        for (k, _) in node_feature {
            keys.push(k)
        }
        keys.sort()
        for k in keys {
            edges[k].sort()
        }
        var discovered = Set<i64>()
        var visiting = Set<i64>()
        var sorted = List<i64>()
        for k in keys {
            if not discovered.contains(k) and depth_first(edges, mut discovered, mut visiting, mut sorted, k) {
                self.cycle = true
                return
            }
        }
        let last = sorted.len()
        for i in 0..last / 2 {
            sorted.swap(i, last - 1 - i)
        }
        for step in 0..max_step {
            var features = List<usize>()
            var index = Map<usize, i32>()
            for key in sorted {
                if (key >> 32) == i64.wrap(step) {
                    let p = node_feature.get(key) ?? 0
                    index.insert(p, i32.wrap(features.len()))
                    features.push(p)
                }
            }
            self.steps.push(features)
            self.index.push(index)
        }
    }
}

// `Graph.depthFirstSearch`: true if it found a cycle.
fn depth_first(edges: Map<i64, List<i64>>, discovered: mut Set<i64>, visiting: mut Set<i64>, sorted: mut List<i64>, current: i64) -> bool {
    if discovered.contains(current) {
        return false
    }
    if visiting.contains(current) {
        return true
    }
    visiting.insert(current)
    let n = edges[current].len()
    for i in 0..n {
        if depth_first(edges, mut discovered, mut visiting, mut sorted, edges[current][i]) {
            return true
        }
    }
    visiting.remove(current)
    discovered.insert(current)
    sorted.push(current)
    return false
}

/// What placing features reads: the facts of the blocks, the generation context, the features,
/// the biomes' features, and the noise and table vanilla keeps in statics.
pub struct Gen {
    pub env: Env
    pub catalog: Catalog
    pub decoration: Decoration
    /// `Biome.BIOME_INFO_NOISE`.
    pub info_noise: Noise
    pub sin: SinTable
    /// The biomes' temperatures.
    pub temps: Temperatures
}

impl Gen {
    pub fn new(env: own Env, catalog: own Catalog, decoration: own Decoration, temps: own Temperatures) -> Gen {
        var info = LegacyRandom.new(2345)
        return Gen { env: env, catalog: catalog, decoration: decoration, info_noise: Noise.simplex(mut info, true), sin: SinTable.new(), temps: temps }
    }
}

fn unimplemented(what: own String) -> Thrown {
    return Thrown { exception: "Unimplemented", message: what }
}

/// `ChunkGenerator.applyBiomeDecoration` of the region's center chunk, with no structures: each
/// step's features of the biomes in the nine chunks, the source can give, in the order of their
/// global indexes, each from its own seed.
pub fn decorate(g: Gen, r: mut Region, seed: i64) ! Thrown {
    let Gen { decoration: d, .. } = g
    if d.cycle {
        fail Thrown { exception: "IllegalStateException", message: "Feature order cycle found" }
    }
    let ox = r.cx << 4
    let oz = r.cz << 4
    var random = WorldgenRandom.new(XoroshiroRandom.new(0))
    let decoration_seed = random.set_decoration_seed(seed, ox, oz)
    var present = Set<i32>()
    for c in 0..r.zoom.chunks.len() {
        for b in r.zoom.chunks[c] {
            present.insert(b)
        }
    }
    let feature_steps = d.steps.len()
    let steps = if i32.wrap(feature_steps) > DECORATION_STEPS { i32.wrap(feature_steps) } else { DECORATION_STEPS }
    for step in 0..steps {
        let s = usize.wrap(step)
        if s >= feature_steps {
            continue
        }
        var chosen = Set<i32>()
        for b in d.possible {
            if not present.contains(b) {
                continue
            }
            if s < d.by_biome[usize.wrap(b)].len() {
                for p in d.by_biome[usize.wrap(b)][s] {
                    chosen.insert(d.index[s].get(p) ?? 0)
                }
            }
        }
        var order = List<i32>()
        for i in chosen {
            order.push(i)
        }
        order.sort()
        for gi in order {
            random.set_feature_seed(decoration_seed, gi, step)
            let oy = r.min_y
            _ = try place_placed(g, mut r, mut random, d.steps[s][usize.wrap(gi)], ox, oy, oz, true)
        }
    }
}

/// `FeaturePlacer.place`: the placed feature `p` from `x`, `y`, `z`, its modifiers run on a
/// stack, each position a modifier gives handed to the next one in order, and the feature placed
/// at each the last one gives. `top` is whether it's the step's own feature, which a biome filter
/// may check.
pub fn place_placed<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, p: usize, x: i32, y: i32, z: i32, top: bool) -> bool ! Thrown {
    let feature = g.catalog.placed[p].feature
    let n = g.catalog.placed[p].placement.len()
    if n == 0 {
        return try place_feature(g, mut r, mut rand, feature, x, y, z)
    }
    var placed_any = false
    var positions: List<(i32, i32, i32)> = [(x, y, z)]
    var indices: List<usize> = [0]
    var modified = List<(i32, i32, i32)>()
    while let at = positions.pop() {
        let mi = indices.pop() ?? 0
        let (px, py, pz) = at
        try modify(g, mut r, mut rand, g.catalog.placed[p].placement[mi], p, top, px, py, pz, mut modified)
        if mi + 1 < n {
            var i = modified.len()
            while i > 0 {
                i -= 1
                positions.push(modified[i])
                indices.push(mi + 1)
            }
        } else {
            for (mx, my, mz) in modified {
                if try place_feature(g, mut r, mut rand, feature, mx, my, mz) {
                    placed_any = true
                }
            }
        }
        modified.clear()
    }
    return placed_any
}

// `PlacementModifier.modify`: the positions the modifier gives from one, onto `out`.
fn modify<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, m: Modifier, p: usize, top: bool, x: i32, y: i32, z: i32, out: mut List<(i32, i32, i32)>) ! Thrown {
    let Env { facts: f, .. } = g.env
    match m {
        Modifier.Biome => {
            if not top {
                fail Thrown { exception: "IllegalStateException", message: "Tried to biome check an unregistered feature, or a feature that should not restrict the biome" }
            }
            let b = try r.biome(x, y, z)
            if g.decoration.in_biome[usize.wrap(b)].contains(p) {
                out.push((x, y, z))
            }
        },
        Modifier.Filter(pred) => {
            if try test(g.env, r, pred, x, y, z) {
                out.push((x, y, z))
            }
        },
        Modifier.CountOnEveryLayer(count) => {
            var layer = 0
            loop {
                var found = false
                var i = 0
                loop {
                    let n = try count.sample(mut rand)
                    if i >= n {
                        break
                    }
                    let ax = rand.next_int_below(16) + x
                    let az = rand.next_int_below(16) + z
                    let start = try r.get_height(f, MOTION_BLOCKING, ax, az)
                    let gy = try on_ground(f, r, ax, start, az, layer)
                    if gy != i32.MAX {
                        out.push((ax, gy, az))
                        found = true
                    }
                    i += 1
                }
                layer += 1
                if not found {
                    break
                }
            }
        },
        Modifier.Count(count) => {
            let n = try count.sample(mut rand)
            for _ in 0..n {
                out.push((x, y, z))
            }
        },
        Modifier.EnvironmentScan { direction, target, allowed, max_steps } => {
            var py = y
            if not try test(g.env, r, allowed, x, py, z) {
                return
            }
            for _ in 0..max_steps {
                if try test(g.env, r, target, x, py, z) {
                    out.push((x, py, z))
                    return
                }
                py += direction
                if r.outside(py) {
                    return
                }
                if not try test(g.env, r, allowed, x, py, z) {
                    break
                }
            }
            if try test(g.env, r, target, x, py, z) {
                out.push((x, py, z))
            }
        },
        Modifier.Fixed(positions) => {
            var i: usize = 0
            while i + 2 < positions.len() {
                let px = positions[i]
                let pz = positions[i + 2]
                if (px >> 4) == (x >> 4) and (pz >> 4) == (z >> 4) {
                    out.push((px, positions[i + 1], pz))
                }
                i += 3
            }
        },
        Modifier.HeightRange(h) => {
            let hy = try h.sample(mut rand, g.env.ctx)
            out.push((x, hy, z))
        },
        Modifier.Heightmap(kind) => {
            let h = try r.get_height(f, kind, x, z)
            if h > r.min_y {
                out.push((x, h, z))
            }
        },
        Modifier.InSquare => {
            let ax = rand.next_int_below(16) + x
            let az = rand.next_int_below(16) + z
            out.push((ax, y, az))
        },
        Modifier.NoiseBasedCount { ratio, factor, offset } => {
            let noise = f64(g.info_noise.get2(f64(x) / factor, f64(z) / factor))
            let n = i32.saturate(((noise + offset) * f64(ratio)).ceil())
            for _ in 0..n {
                out.push((x, y, z))
            }
        },
        Modifier.NoiseThresholdCount { level, below, above } => {
            let noise = f64(g.info_noise.get2(f64(x) / 200.0, f64(z) / 200.0))
            let n = if noise < level { below } else { above }
            for _ in 0..n {
                out.push((x, y, z))
            }
        },
        Modifier.Offset { x: ox, y: oy, z: oz } => {
            let dx = try ox.sample(mut rand)
            let dy = try oy.sample(mut rand)
            let dz = try oz.sample(mut rand)
            out.push((x + dx, y + dy, z + dz))
        },
        Modifier.RandomChance(chance) => {
            if rand.next_float() < chance {
                out.push((x, y, z))
            }
        },
        Modifier.RandomlySelected(list) => {
            let i = rand.next_int_below(i32.wrap(list.len()))
            try modify(g, mut r, mut rand, list[usize.wrap(i)], p, top, x, y, z, mut out)
        },
        Modifier.Rarity(chance) => {
            if rand.next_float() < 1.0f32 / f32.nearest(chance) {
                out.push((x, y, z))
            }
        },
        Modifier.SurfaceRelativeThreshold { heightmap, min, max } => {
            let surface = i64(try r.get_height(f, heightmap, x, z))
            if surface + i64(min) <= i64(y) and i64(y) <= surface + i64(max) {
                out.push((x, y, z))
            }
        },
        Modifier.SurfaceWaterDepth(max) => {
            let ocean = try r.get_height(f, OCEAN_FLOOR, x, z)
            let surface = try r.get_height(f, WORLD_SURFACE, x, z)
            if surface - ocean <= max {
                out.push((x, y, z))
            }
        },
        Modifier.Cuboid { xz, y: ys, edges, interior } => {
            let height = try ys.sample(mut rand)
            let width = try xz.sample(mut rand)
            let length = try xz.sample(mut rand)
            var a = 0
            while a <= width {
                var b = 0
                while b <= height {
                    var c = 0
                    while c <= length {
                        let ea = a != 0 and a != width
                        let eb = b != 0 and b != height
                        let ec = c != 0 and c != length
                        let shell = a == 0 or a == width or b == 0 or b == height or c == 0 or c == length
                        if (edges or ea or eb) and (edges or ec or eb) and (edges or ea or ec) and (interior or shell) {
                            out.push((x + a, y + b, z + c))
                        }
                        c += 1
                    }
                    b += 1
                }
                a += 1
            }
        },
    }
}

// `CountOnEveryLayerPlacement.findOnGroundYPosition`: the height above the `layer`th floor from
// `start` down, a floor being a block not air, water or lava, but not bedrock, under one that
// is; `i32.MAX` if there's none.
fn on_ground(f: Facts, r: Region, x: i32, start: i32, z: i32, layer: i32) -> i32 ! Thrown {
    var current_layer = 0
    var current = try r.state(f, x, start, z)
    var y = start
    while y >= r.min_y + 1 {
        let below = try r.state(f, x, y - 1, z)
        if not layer_empty(f, below) and layer_empty(f, current) and not f.is(below, f.ids.bedrock) {
            if current_layer == layer {
                return y
            }
            current_layer += 1
        }
        current = below
        y -= 1
    }
    return i32.MAX
}

fn layer_empty(f: Facts, state: u32) -> bool {
    return f.is_air(state) or f.is(state, f.ids.water) or f.is(state, f.ids.lava)
}

/// `Feature.place` of the feature `fi` at `x`, `y`, `z`.
pub fn place_feature<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, fi: usize, x: i32, y: i32, z: i32) -> bool ! Thrown {
    match g.catalog.features[fi] {
        Feature.NoOp => return true,
        Feature.Ore { targets, size, discard } => return try place_ore(g, mut r, mut rand, targets, size, discard, x, y, z),
        Feature.ScatteredOre { targets, size, discard } => return try place_scattered_ore(g, mut r, mut rand, targets, size, discard, x, y, z),
        Feature.SimpleBlock { provider, schedule_tick } => return try place_simple_block(g, mut r, mut rand, provider, schedule_tick, x, y, z),
        Feature.RandomSelector { features, chances, fallback } => {
            for i in 0..features.len() {
                if rand.next_float() < chances[i] {
                    return try place_placed(g, mut r, mut rand, features[i], x, y, z, false)
                }
            }
            return try place_placed(g, mut r, mut rand, fallback, x, y, z, false)
        },
        Feature.SimpleRandomSelector(features) => {
            let i = rand.next_int_below(i32.wrap(features.len()))
            return try place_placed(g, mut r, mut rand, features[usize.wrap(i)], x, y, z, false)
        },
        Feature.RandomBooleanSelector { yes, no } => {
            let which = if rand.next_boolean() { yes } else { no }
            return try place_placed(g, mut r, mut rand, which, x, y, z, false)
        },
        Feature.WeightedRandomSelector { features, weights, total } => {
            if total == 0 {
                return false
            }
            let i = pick(mut rand, weights, total)
            return try place_placed(g, mut r, mut rand, features[i], x, y, z, false)
        },
        Feature.Sequence(features) => {
            for p in features {
                if not try place_placed(g, mut r, mut rand, p, x, y, z, false) {
                    return false
                }
            }
            return true
        },
        Feature.MonsterRoom => return try place_monster_room(g, mut r, mut rand, x, y, z),
        Feature.Spring { fluid, legacy, below, rocks, holes, valid } => return try place_spring(g.env.facts, mut r, fluid, legacy, below, rocks, holes, valid, x, y, z),
        Feature.FreezeTopLayer => return try place_freeze_top_layer(g, mut r, x, z),
        Feature.Tree(t) => return try place_tree(g, mut r, mut rand, t, x, y, z),
        Feature.VegetationPatch(p) => return try place_vegetation_patch(g, mut r, mut rand, p, x, y, z),
        Feature.BlockColumn { heights, providers, direction, allowed, tip } => return try place_block_column(g, mut r, mut rand, heights, providers, direction, allowed, tip, x, y, z),
        Feature.Overlay(features) => {
            var any = false
            for p in features {
                if try place_placed(g, mut r, mut rand, p, x, y, z, false) {
                    any = true
                }
            }
            return any
        },
        Feature.Speleothem(s) => return try place_speleothem(g.env.facts, mut r, mut rand, s, x, y, z),
        Feature.SpeleothemCluster(c) => return try place_cluster(g.env.facts, mut r, mut rand, c, x, y, z),
        Feature.LargeDripstone(l) => return try place_large_dripstone(g.env.facts, g.sin, mut r, mut rand, l, x, y, z),
        Feature.Geode(geo) => return try place_geode(g.env, g.catalog.providers, mut r, mut rand, geo, x, y, z),
        Feature.SculkPatch(p) => return try place_sculk_patch(g.env.facts, mut r, mut rand, p, x, y, z),
        Feature.HugeFungus(h) => return try place_huge_fungus(g.env, g.env.gen_depth, mut r, mut rand, h, x, y, z),
        Feature.NeighborSpread(n) => return try place_neighbor_spread(g.env, g.catalog.providers, mut r, mut rand, n, x, y, z),
        Feature.Delta(d) => return try place_delta(g.env.facts, mut r, mut rand, d, x, y, z),
        Feature.ReplaceBlobs(b) => return try place_replace_blobs(g.env.facts, mut r, mut rand, b, x, y, z),
        Feature.SteppedColumns(c) => return try place_stepped_columns(g.env, g.catalog.providers, mut r, mut rand, c, x, y, z),
        Feature.Vines => return try place_vines(g.env.facts, mut r, x, y, z),
        Feature.BlueIce => return try place_blue_ice(g.env.facts, mut r, mut rand, x, y, z),
        Feature.BlockBlob { state, can_place_on } => return try place_block_blob(g, mut r, mut rand, state, can_place_on, x, y, z),
        Feature.HugeMushroom { red, cap, stem, radius, can_place_on } => return try place_huge_mushroom(g, mut r, mut rand, red, cap, stem, radius, can_place_on, x, y, z),
        Feature.BlockPile(provider) => return try place_block_pile(g, mut r, mut rand, provider, x, y, z),
        Feature.FallenTree { trunk, length, stump, log, tags } => return try place_fallen_tree(g, mut r, mut rand, trunk, length, stump, log, tags, x, y, z),
        Feature.Disk { provider, target, radius, half } => return try place_disk(g, mut r, mut rand, provider, target, radius, half, x, y, z),
        Feature.MultifaceGrowth { block, search, on_floor, ceiling, wall, chance, on } => return try place_multiface(g.env.facts, mut r, mut rand, block, search, on_floor, ceiling, wall, chance, on, x, y, z),
        Feature.Lake { fluid, barrier, can_place, air_or_fluid, barrier_ok } => return try place_lake(g, mut r, mut rand, fluid, barrier, can_place, air_or_fluid, barrier_ok, x, y, z),
        Feature.UnderwaterMagma { search, radius, chance } => return try place_underwater_magma(g.env.facts, mut r, mut rand, search, radius, chance, x, y, z),
        Feature.Unsupported(kind) => fail unimplemented("the feature type `{kind}`"),
    }
}

// `AbstractOreFeature.canPlaceOre`: the rule first, then, unless the chance skips it, that no
// neighbour is air, as `read` reads them.
fn can_place_ore<T: RandomSource>(f: Facts, r: Region, rand: mut T, rule: Rule, state: u32, discard: f32, x: i32, y: i32, z: i32, bulk: bool) -> bool ! Thrown {
    if not test_rule(f, rule, state, y, mut rand) {
        return false
    }
    // `shouldSkipAirCheck`.
    if discard <= 0.0f32 {
        return true
    }
    if discard < 1.0f32 and rand.next_float() >= discard {
        return true
    }
    // `isAdjacentToAir`, in `Direction.values()` order.
    let dxs: List<i32> = [0, 0, 0, 0, -1, 1]
    let dys: List<i32> = [-1, 1, 0, 0, 0, 0]
    let dzs: List<i32> = [0, 0, -1, 1, 0, 0]
    for d in 0..6usize {
        let nx = x + dxs[d]
        let ny = y + dys[d]
        let nz = z + dzs[d]
        let n = if bulk { try r.section_state(f, nx, ny, nz) } else { try r.state(f, nx, ny, nz) }
        if f.is_air(n) {
            return false
        }
    }
    return true
}

// `OreFeature.place`: a vein along a line through the origin at a random angle, of spheres that
// shrink toward its ends, set straight into the sections.
fn place_ore<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, targets: List<Replacement>, size: i32, discard: f32, ox: i32, oy: i32, oz: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    let dir = rand.next_float() * PI_F32
    let spread = f32.nearest(size) / 8.0f32
    let max_radius = ceil_f32((f32.nearest(size) / 16.0f32 * 2.0f32 + 1.0f32) / 2.0f32)
    let sd = sin(f64(dir))
    let cd = cos(f64(dir))
    let x0 = f64(ox) + sd * f64(spread)
    let x1 = f64(ox) - sd * f64(spread)
    let z0 = f64(oz) + cd * f64(spread)
    let z1 = f64(oz) - cd * f64(spread)
    let y0 = f64(oy + rand.next_int_below(3) - 2)
    let y1 = f64(oy + rand.next_int_below(3) - 2)
    let x_start = ox - ceil_f32(spread) - max_radius
    let y_start = oy - 2 - max_radius
    let z_start = oz - ceil_f32(spread) - max_radius
    let size_xz = 2 * (ceil_f32(spread) + max_radius)
    let size_y = 2 * (2 + max_radius)
    for xp in x_start..x_start + size_xz + 1 {
        for zp in z_start..z_start + size_xz + 1 {
            if y_start <= try r.get_height(f, OCEAN_FLOOR_WG, xp, zp) {
                return try ore_vein(g, mut r, mut rand, targets, size, discard, x0, x1, z0, z1, y0, y1, x_start, y_start, z_start, size_xz, size_y)
            }
        }
    }
    return false
}

// `OreFeature.doPlace`.
fn ore_vein<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, targets: List<Replacement>, size: i32, discard: f32, x0: f64, x1: f64, z0: f64, z1: f64, y0: f64, y1: f64, x_start: i32, y_start: i32, z_start: i32, size_xz: i32, size_y: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    var placed = 0
    // A `BitSet`, which grows: an index past the box wraps into the next row, as vanilla's does.
    var tested: List<bool> = [false; usize.wrap(size_xz * size_y * size_xz + size_xz * size_y + size_xz + 1)]
    var data: List<f64> = [0.0; usize.wrap(size * 4)]
    for i in 0..size {
        let step = f32.nearest(i) / f32.nearest(size)
        let xx = x0 + f64(step) * (x1 - x0)
        let yy = y0 + f64(step) * (y1 - y0)
        let zz = z0 + f64(step) * (z1 - z0)
        let ss = rand.next_double() * f64(size) / 16.0
        let radius = (f64(g.sin.sin(f64(PI_F32 * step)) + 1.0f32) * ss + 1.0) / 2.0
        let at = usize.wrap(i * 4)
        data[at] = xx
        data[at + 1] = yy
        data[at + 2] = zz
        data[at + 3] = radius
    }
    for i1 in 0..size - 1 {
        let a = usize.wrap(i1 * 4)
        if not (data[a + 3] <= 0.0) {
            for i2 in i1 + 1..size {
                let b = usize.wrap(i2 * 4)
                if not (data[b + 3] <= 0.0) {
                    let dx = data[a] - data[b]
                    let dy = data[a + 1] - data[b + 1]
                    let dz = data[a + 2] - data[b + 2]
                    let dr = data[a + 3] - data[b + 3]
                    if dr * dr > dx * dx + dy * dy + dz * dz {
                        if dr > 0.0 {
                            data[b + 3] = -1.0
                        } else {
                            data[a + 3] = -1.0
                        }
                    }
                }
            }
        }
    }
    for i in 0..size {
        let at = usize.wrap(i * 4)
        let radius = data[at + 3]
        if radius < 0.0 {
            continue
        }
        let xx = data[at]
        let yy = data[at + 1]
        let zz = data[at + 2]
        let x_min = floor(xx - radius).max(x_start)
        let y_min = floor(yy - radius).max(y_start)
        let z_min = floor(zz - radius).max(z_start)
        let x_max = floor(xx + radius).max(x_min)
        let y_max = floor(yy + radius).max(y_min)
        let z_max = floor(zz + radius).max(z_min)
        for x in x_min..x_max + 1 {
            let xd = (f64(x) + 0.5 - xx) / radius
            if not (xd * xd < 1.0) {
                continue
            }
            for y in y_min..y_max + 1 {
                let yd = (f64(y) + 0.5 - yy) / radius
                if not (xd * xd + yd * yd < 1.0) {
                    continue
                }
                for z in z_min..z_max + 1 {
                    let zd = (f64(z) + 0.5 - zz) / radius
                    if not (xd * xd + yd * yd + zd * zd < 1.0) or r.outside(y) {
                        continue
                    }
                    let bit = usize.wrap(x - x_start + (y - y_start) * size_xz + (z - z_start) * size_xz * size_y)
                    while bit >= tested.len() {
                        tested.push(false)
                    }
                    if tested[bit] {
                        continue
                    }
                    tested[bit] = true
                    if not r.can_write(x, z) {
                        continue
                    }
                    let state = try r.section_state(f, x, y, z)
                    for t in targets {
                        if try can_place_ore(f, r, mut rand, t.rule, state, discard, x, y, z, true) {
                            r.set_section(f, x, y, z, t.state)
                            placed += 1
                            break
                        }
                    }
                }
            }
        }
    }
    return placed > 0
}

// `Mth.ceil(float)`.
fn ceil_f32(v: f32) -> i32 {
    return i32.saturate(f64(v).ceil())
}

// `ScatteredOreFeature.place`: tries scattered ever further from the origin, up to 7 away.
fn place_scattered_ore<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, targets: List<Replacement>, size: i32, discard: f32, ox: i32, oy: i32, oz: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    let tries = rand.next_int_below(size + 1)
    for i in 0..tries {
        let reach = f32.nearest(i.min(7))
        let dx = i32.round((rand.next_float() - rand.next_float()) * reach)
        let dy = i32.round((rand.next_float() - rand.next_float()) * reach)
        let dz = i32.round((rand.next_float() - rand.next_float()) * reach)
        let x = ox + dx
        let y = oy + dy
        let z = oz + dz
        let state = try r.state(f, x, y, z)
        for t in targets {
            if try can_place_ore(f, r, mut rand, t.rule, state, discard, x, y, z, false) {
                _ = r.set_block(f, x, y, z, t.state, 2)
                break
            }
        }
    }
    return true
}

// `SimpleBlockFeature.place`.
fn place_simple_block<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, provider: usize, schedule_tick: bool, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    let s = try optional_state(g.env, g.catalog.providers, r, mut rand, provider, x, y, z) else return false
    if not try can_survive(g.env, r, s, x, y, z) {
        return false
    }
    let block = f.block(s)
    if f.is_a(block, "DoublePlantBlock") {
        let above = try r.state(f, x, y + 1, z)
        if not f.is_air(above) {
            let same_fluid = f.fluid(s) == f.fluid(above) and f.fluid_amount(s) == f.fluid_amount(above)
            if not same_fluid or not f.replaceable(above) {
                return false
            }
        }
        try place_double_plant(f, mut r, s, x, y, z, 2)
    } else if f.is_a(block, "MossyCarpetBlock") {
        try place_mossy_carpet(f, mut r, x, y, z, 2)
    } else {
        _ = r.set_block(f, x, y, z, s, 2)
    }
    if schedule_tick {
        let now = try r.state(f, x, y, z)
        r.schedule_block(f.block(now), x, y, z, 0)
    }
    return true
}

/// `DoublePlantBlock.placeAt`: the lower half, then the upper, each waterlogged if it can be and
/// water is there.
pub fn place_double_plant(f: Facts, r: mut Region, state: u32, x: i32, y: i32, z: i32, flags: i32) ! Thrown {
    let lower = try f.with_name(state, "half", "lower")
    let lower_here = try r.state(f, x, y, z)
    _ = r.set_block(f, x, y, z, copy_waterlogged(f, lower, lower_here), flags)
    let upper = try f.with_name(state, "half", "upper")
    let upper_here = try r.state(f, x, y + 1, z)
    _ = r.set_block(f, x, y + 1, z, copy_waterlogged(f, upper, upper_here), flags)
}

// `DoublePlantBlock.copyWaterloggedFrom`.
fn copy_waterlogged(f: Facts, state: u32, here: u32) -> u32 {
    if not f.has(state, "waterlogged") {
        return state
    }
    return f.try_bool(state, "waterlogged", f.is_water(here))
}

/// `Feature.safeSetBlock`: the block set with flags 2 if what's there may be replaced.
pub fn safe_set(f: Facts, r: mut Region, x: i32, y: i32, z: i32, state: u32, cannot: BlockSet) ! Thrown {
    let here = try r.state(f, x, y, z)
    if not f.in_set(here, cannot) {
        _ = r.set_block(f, x, y, z, state, 2)
    }
}

// `MonsterRoomFeature.place`: a room of 5 to 7 blocks across with a floor and ceiling of solid
// blocks and 1 to 5 openings in its walls at floor level, walled with cobblestone and a mossy
// floor, with up to two chests against a wall and a spawner in the middle.
fn place_monster_room<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, ox: i32, oy: i32, oz: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    let cannot = f.tag("minecraft:features_cannot_replace")
    let xr = rand.next_int_below(2) + 2
    let min_x = -xr - 1
    let max_x = xr + 1
    let zr = rand.next_int_below(2) + 2
    let min_z = -zr - 1
    let max_z = zr + 1
    var holes = 0
    for dx in min_x..max_x + 1 {
        for dy in -1..5 {
            for dz in min_z..max_z + 1 {
                let solid = f.is_solid(try r.state(f, ox + dx, oy + dy, oz + dz))
                if (dy == -1 or dy == 4) and not solid {
                    return false
                }
                let edge = dx == min_x or dx == max_x or dz == min_z or dz == max_z
                if edge and dy == 0 and f.is_air(try r.state(f, ox + dx, oy, oz + dz)) and f.is_air(try r.state(f, ox + dx, oy + 1, oz + dz)) {
                    holes += 1
                }
            }
        }
    }
    if holes < 1 or holes > 5 {
        return false
    }
    let cave_air = f.ids.cave_air_state
    for dx in min_x..max_x + 1 {
        var dy = 3
        while dy >= -1 {
            for dz in min_z..max_z + 1 {
                let x = ox + dx
                let y = oy + dy
                let z = oz + dz
                let wall = try r.state(f, x, y, z)
                if dx == min_x or dy == -1 or dz == min_z or dx == max_x or dz == max_z {
                    if y >= r.min_y and not f.is_solid(try r.state(f, x, y - 1, z)) {
                        _ = r.set_block(f, x, y, z, cave_air, 2)
                    } else if f.is_solid(wall) and not f.is(wall, f.ids.chest) {
                        if dy == -1 and rand.next_int_below(4) != 0 {
                            try safe_set(f, mut r, x, y, z, f.default_state(f.ids.mossy_cobblestone), cannot)
                        } else {
                            try safe_set(f, mut r, x, y, z, f.default_state(f.ids.cobblestone), cannot)
                        }
                    }
                } else if not f.is(wall, f.ids.chest) and not f.is(wall, f.ids.spawner) {
                    try safe_set(f, mut r, x, y, z, cave_air, cannot)
                }
            }
            dy -= 1
        }
    }
    for _ in 0..2 {
        for _ in 0..3 {
            let xc = ox + rand.next_int_below(xr * 2 + 1) - xr
            let zc = oz + rand.next_int_below(zr * 2 + 1) - zr
            if not f.is_air(try r.state(f, xc, oy, zc)) {
                continue
            }
            var walls = 0
            for i in 0..4 {
                let d = horizontal(i)
                if f.is_solid(try r.state(f, xc + step_x(d), oy, zc + step_z(d))) {
                    walls += 1
                }
            }
            if walls == 1 {
                let chest = try reorient(f, r, xc, oy, zc, f.default_state(f.ids.chest))
                try safe_set(f, mut r, xc, oy, zc, chest, cannot)
                // `RandomizableContainer.setBlockEntityLootTable`.
                if let kind = try r.block_entity(f, xc, oy, zc) {
                    if kind == "minecraft:chest" {
                        r.set_loot_table(xc, oy, zc, "minecraft:chests/simple_dungeon", rand.next_long())
                    }
                }
                break
            }
        }
    }
    try safe_set(f, mut r, ox, oy, oz, f.default_state(f.ids.spawner), cannot)
    if let kind = try r.block_entity(f, ox, oy, oz) {
        if kind == "minecraft:mob_spawner" {
            let mobs: List<String> = ["minecraft:skeleton", "minecraft:zombie", "minecraft:zombie", "minecraft:spider"]
            let mob = rand.next_int_below(4)
            r.set_spawner_entity(ox, oy, oz, mobs[usize.wrap(mob)].copy())
        }
    }
    return true
}

/// `StructurePiece.reorient`: a chest turned away from the one solid wall beside it, or, with
/// none or more, from its own facing on to one that isn't against a solid block. Next to
/// another chest, it stays as it is.
pub fn reorient(f: Facts, r: Region, x: i32, y: i32, z: i32, state: u32) -> u32 ! Thrown {
    var solid = -1
    for i in 0..4 {
        let d = horizontal(i)
        let s = try r.state(f, x + step_x(d), y, z + step_z(d))
        if f.is(s, f.ids.chest) {
            return state
        }
        if f.solid_render(s) {
            if solid != -1 {
                solid = -1
                break
            }
            solid = d
        }
    }
    if solid != -1 {
        return try f.with_name(state, "facing", direction_name(opposite(solid)))
    }
    let name = f.get_name(state, "facing") ?? String()
    var lock = direction_named(name) ?? 2
    if f.solid_render(try r.state(f, x + step_x(lock), y, z + step_z(lock))) {
        lock = opposite(lock)
    }
    if f.solid_render(try r.state(f, x + step_x(lock), y, z + step_z(lock))) {
        lock = clockwise(lock)
    }
    if f.solid_render(try r.state(f, x + step_x(lock), y, z + step_z(lock))) {
        lock = opposite(lock)
    }
    return try f.with_name(state, "facing", direction_name(lock))
}

/// `FluidState.CODEC`: a fluid by name and its properties, the default's where one isn't there or
/// isn't one of the property's values. Gives the fluid's ID and `createLegacyBlock`'s state.
pub fn read_fluid_state(f: Facts, rd: Readers, value: Json) -> (u32, u32) ! String {
    let m = try map_of(value)
    let id_value = field(m, "id") else fail "No key id in MapLike"
    let name = as_string(id_value) else fail "Not a string: {id_value}"
    let fid = try Identifier.parse(name)
    let found = rd.fluids.id(fid) else fail "Unknown registry key in ResourceKey[minecraft:root / minecraft:fluid]: {name}"
    let fluid = u32.wrap(found)
    // A flowing fluid's default state is `LEVEL` 7, not falling.
    var falling = false
    var amount = if fluid == FLOWING_WATER or fluid == FLOWING_LAVA { 7 } else { 8 }
    if let pv = field(m, "properties") {
        let props = try map_of(pv)
        if let fv = field(props, "falling") {
            if let text = as_string(fv) {
                if text == "true" {
                    falling = true
                } else if text == "false" {
                    falling = false
                }
            }
        }
        if fluid == FLOWING_WATER or fluid == FLOWING_LAVA {
            if let lv = field(props, "level") {
                if let text = as_string(lv) {
                    if let v = i32.parse(text) {
                        if v >= 1 and v <= 8 {
                            amount = v
                        }
                    }
                }
            }
        }
    }
    if fluid == EMPTY_FLUID {
        return (fluid, f.ids.air_state)
    }
    let source = fluid == WATER_FLUID or fluid == LAVA_FLUID
    // `getLegacyLevel`.
    let level = if source { 0 } else { 8 - amount.min(8) + (if falling { 8 } else { 0 }) }
    let block = if fluid == WATER_FLUID or fluid == FLOWING_WATER { f.ids.water } else { f.ids.lava }
    let state = match f.with_int(f.default_state(block), "level", level) {
        ok(s) => s,
        err(e) => fail e.message,
    }
    return (fluid, state)
}

// `SpringFeature.place`: the fluid where the block above, and if asked the one below, are valid,
// with as many valid blocks and empty ones beside and below it as it asks, and a tick for it.
fn place_spring(f: Facts, r: mut Region, fluid: u32, legacy: u32, below: bool, rocks: i32, holes: i32, valid: BlockSet, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not f.in_set(try r.state(f, x, y + 1, z), valid) {
        return false
    }
    if below and not f.in_set(try r.state(f, x, y - 1, z), valid) {
        return false
    }
    let here = try r.state(f, x, y, z)
    if not f.is_air(here) and not f.in_set(here, valid) {
        return false
    }
    // West, east, north, south, below.
    let dxs: List<i32> = [-1, 1, 0, 0, 0]
    let dys: List<i32> = [0, 0, 0, 0, -1]
    let dzs: List<i32> = [0, 0, -1, 1, 0]
    var rock_count = 0
    for i in 0..5usize {
        if f.in_set(try r.state(f, x + dxs[i], y + dys[i], z + dzs[i]), valid) {
            rock_count += 1
        }
    }
    var hole_count = 0
    for i in 0..5usize {
        if f.is_air(try r.state(f, x + dxs[i], y + dys[i], z + dzs[i])) {
            hole_count += 1
        }
    }
    if rock_count == rocks and hole_count == holes {
        _ = r.set_block(f, x, y, z, legacy, 2)
        r.schedule_fluid(fluid, x, y, z)
        return true
    }
    return false
}

// `UnderwaterMagmaFeature.place`: the floor of the water column at the origin, then each block
// within the radius of it, by chance, made magma where it's hidden from outside.
fn place_underwater_magma<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, search: i32, radius: i32, chance: f32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    // `Column.scan` with water inside and anything else as the edge: only its floor is used,
    // and scanning up reads nothing that could throw.
    if not f.is(try r.state(f, x, y, z), f.ids.water) {
        return false
    }
    var fy = y
    var i = 1
    while i < search and f.is(try r.state(f, x, fy, z), f.ids.water) {
        fy -= 1
        i += 1
    }
    if f.is(try r.state(f, x, fy, z), f.ids.water) {
        return false
    }
    var placed = 0
    for bz in z - radius..z + radius + 1 {
        for by in fy - radius..fy + radius + 1 {
            for bx in x - radius..x + radius + 1 {
                if not (rand.next_float() < chance) {
                    continue
                }
                if try magma_fits(f, r, bx, by, bz) {
                    _ = r.set_block(f, bx, by, bz, f.default_state(f.ids.magma_block), 2)
                    placed += 1
                }
            }
        }
    }
    return placed > 0
}

// `UnderwaterMagmaFeature.isValidPlacement`: not water or air, and covered below and on every
// side.
fn magma_fits(f: Facts, r: Region, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let here = try r.state(f, x, y, z)
    if f.is(here, f.ids.water) or f.is_air(here) {
        return false
    }
    if not f.occludes_face(try r.state(f, x, y - 1, z), UP) {
        return false
    }
    for i in 0..4 {
        let d = horizontal(i)
        if not f.occludes_face(try r.state(f, x + step_x(d), y, z + step_z(d)), opposite(d)) {
            return false
        }
    }
    return true
}

/// `Feature.markAboveForPostProcessing`: the two blocks above, up to the first air, marked.
pub fn mark_above(f: Facts, r: mut Region, x: i32, y: i32, z: i32) ! Thrown {
    for i in 1..3 {
        if f.is_air(try r.state(f, x, y + i, z)) {
            return
        }
        r.mark(x, y + i, z)
    }
}

/// `Biome.shouldFreeze` of `biome` without checking the neighbours: source water in a water
/// block, in the world, where the biome is too cold to rain. Blocks have no light while chunks
/// generate.
pub fn should_freeze(g: Gen, r: Region, biome: i32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    if g.temps.warm_enough_to_rain(biome, x, y, z, r.sea_level) {
        return false
    }
    if r.outside(y) {
        return false
    }
    let here = try r.state(f, x, y, z)
    return f.fluid(here) == WATER_FLUID and f.is(here, f.ids.water)
}

// The index of a block of a lake's 16×8×16 grid.
fn lake_index(xx: i32, yy: i32, zz: i32) -> usize {
    return usize.wrap((xx * 16 + zz) * 8 + yy)
}

// Whether a block of a lake's grid is outside the lake and beside it.
fn lake_edge(grid: List<bool>, xx: i32, yy: i32, zz: i32) -> bool {
    if grid[lake_index(xx, yy, zz)] {
        return false
    }
    return (xx < 15 and grid[lake_index(xx + 1, yy, zz)]) or
        (xx > 0 and grid[lake_index(xx - 1, yy, zz)]) or
        (zz < 15 and grid[lake_index(xx, yy, zz + 1)]) or
        (zz > 0 and grid[lake_index(xx, yy, zz - 1)]) or
        (yy < 7 and grid[lake_index(xx, yy + 1, zz)]) or
        (yy > 0 and grid[lake_index(xx, yy - 1, zz)])
}

// `LakeFeature.place`: four to seven ellipsoids in a 16×8×16 grid, given up if its edge has fluid
// above its middle or something not solid below it, then filled with the fluid below its middle
// and cave air above, walled with the barrier, and frozen on top where it's cold.
fn place_lake<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, fluid_p: usize, barrier_p: usize, can_place: Pred, air_or_fluid: Pred, barrier_ok: Pred, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    if y <= r.min_y + 4 {
        return false
    }
    let ox = x - 8
    let oy = y - 4
    let oz = z - 8
    var grid: List<bool> = [false; 2048]
    let spots = rand.next_int_below(4) + 4
    for _ in 0..spots {
        let xr = rand.next_double() * 6.0 + 3.0
        let yr = rand.next_double() * 4.0 + 2.0
        let zr = rand.next_double() * 6.0 + 3.0
        let xp = rand.next_double() * (16.0 - xr - 2.0) + 1.0 + xr / 2.0
        let yp = rand.next_double() * (8.0 - yr - 4.0) + 2.0 + yr / 2.0
        let zp = rand.next_double() * (16.0 - zr - 2.0) + 1.0 + zr / 2.0
        for xx in 1..15 {
            for zz in 1..15 {
                for yy in 1..7 {
                    let xd = (f64(xx) - xp) / (xr / 2.0)
                    let yd = (f64(yy) - yp) / (yr / 2.0)
                    let zd = (f64(zz) - zp) / (zr / 2.0)
                    if xd * xd + yd * yd + zd * zd < 1.0 {
                        grid[lake_index(xx, yy, zz)] = true
                    }
                }
            }
        }
    }
    let fluid = try get_state(g.env, g.catalog.providers, r, mut rand, fluid_p, ox, oy, oz)
    for xx in 0..16 {
        for zz in 0..16 {
            for yy in 0..8 {
                if lake_edge(grid, xx, yy, zz) {
                    let here = try r.state(f, ox + xx, oy + yy, oz + zz)
                    if yy >= 4 and f.is_liquid(here) {
                        return false
                    }
                    if yy < 4 and not f.is_solid(here) and here != fluid {
                        return false
                    }
                    if not try test(g.env, r, can_place, ox + xx, oy + yy, oz + zz) {
                        return false
                    }
                }
            }
        }
    }
    for xx in 0..16 {
        for zz in 0..16 {
            for yy in 0..8 {
                if grid[lake_index(xx, yy, zz)] {
                    let px = ox + xx
                    let py = oy + yy
                    let pz = oz + zz
                    if try test(g.env, r, air_or_fluid, px, py, pz) {
                        let air = yy >= 4
                        _ = r.set_block(f, px, py, pz, if air { f.ids.cave_air_state } else { fluid }, 2)
                        if air {
                            r.schedule_block(f.ids.cave_air, px, py, pz, 0)
                            try mark_above(f, mut r, px, py, pz)
                        }
                    }
                }
            }
        }
    }
    let barrier = try get_state(g.env, g.catalog.providers, r, mut rand, barrier_p, ox, oy, oz)
    if not f.is_air(barrier) {
        for xx in 0..16 {
            for zz in 0..16 {
                for yy in 0..8 {
                    if lake_edge(grid, xx, yy, zz) and (yy < 4 or rand.next_int_below(2) != 0) {
                        let px = ox + xx
                        let py = oy + yy
                        let pz = oz + zz
                        if f.is_solid(try r.state(f, px, py, pz)) and try test(g.env, r, barrier_ok, px, py, pz) {
                            _ = r.set_block(f, px, py, pz, barrier, 2)
                            try mark_above(f, mut r, px, py, pz)
                        }
                    }
                }
            }
        }
    }
    if f.fluid_in(fluid, "minecraft:water") {
        for xx in 0..16 {
            for zz in 0..16 {
                let px = ox + xx
                let py = oy + 4
                let pz = oz + zz
                if try should_freeze(g, r, try r.biome(px, py, pz), px, py, pz) and try test(g.env, r, air_or_fluid, px, py, pz) {
                    _ = r.set_block(f, px, py, pz, f.default_state(f.ids.ice), 2)
                }
            }
        }
    }
    return true
}

// `DiskFeature.place`: each column within the radius, from `half` above the origin to `half`
// below, its blocks that pass the target given the provider's state.
fn place_disk<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, provider: usize, target: Pred, radius: IntProvider, half: i32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let top = y + half
    let bottom = y - half - 1
    let rad = try radius.sample(mut rand)
    var any = false
    // `BlockPos.betweenClosed`: `x` fastest, then `z`.
    for cz in z - rad..z + rad + 1 {
        for cx in x - rad..x + rad + 1 {
            let xd = cx - x
            let zd = cz - z
            if xd * xd + zd * zd <= rad * rad {
                if try disk_column(g, mut r, mut rand, provider, target, top, bottom, cx, cz) {
                    any = true
                }
            }
        }
    }
    return any
}

// `DiskFeature.placeColumn`: down the column, each block the target passes set, the top of each
// run marked above.
fn disk_column<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, provider: usize, target: Pred, top: i32, bottom: i32, x: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    var any = false
    var above = false
    var y = top
    while y > bottom {
        if try test(g.env, r, target, x, y, z) {
            if let s = try optional_state(g.env, g.catalog.providers, r, mut rand, provider, x, y, z) {
                _ = r.set_block(f, x, y, z, s, 2)
                if not above {
                    try mark_above(f, mut r, x, y, z)
                }
                any = true
                above = true
            }
        } else {
            above = false
        }
        y -= 1
    }
    return any
}

// `MultifaceGrowthFeature.isAirOrWater`.
fn air_or_water(f: Facts, state: u32) -> bool {
    return f.is_air(state) or f.is(state, f.ids.water)
}

// `MultifaceGrowthFeature.placeGrowthIfPossible`: the face toward the first of `dirs` whose
// neighbour it can be placed on, if the block can be placed there, then perhaps spread.
fn multiface_grow<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, block: u32, chance: f32, on: BlockSet, old: u32, x: i32, y: i32, z: i32, dirs: List<i32>) -> bool ! Thrown {
    for d in dirs {
        let n = try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        if f.in_set(n, on) {
            let s = try multiface_state(f, r, block, old, x, y, z, d) else return false
            _ = r.set_block(f, x, y, z, s, 3)
            r.mark(x, y, z)
            if rand.next_float() < chance {
                try spread_from_face(f, mut r, mut rand, block, s, x, y, z, d, true)
            }
            return true
        }
    }
    return false
}

// `MultifaceGrowthFeature.validDirections`: up, down, then the horizontal ones in their order.
fn multiface_directions(ceiling: bool, on_floor: bool, wall: bool, except: i32) -> List<i32> {
    var out = List<i32>()
    if ceiling and except != UP {
        out.push(UP)
    }
    if on_floor and except != DOWN {
        out.push(DOWN)
    }
    if wall {
        for i in 0..4 {
            let d = horizontal(i)
            if d != except {
                out.push(d)
            }
        }
    }
    return out
}

// `MultifaceGrowthFeature.place`: the block grown at the origin if it's air or water, or else at
// the first block beside it, in shuffled directions, that it can be.
fn place_multiface<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, block: u32, search: i32, on_floor: bool, ceiling: bool, wall: bool, chance: f32, on: BlockSet, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let here = try r.state(f, x, y, z)
    if not air_or_water(f, here) {
        return false
    }
    var dirs = multiface_directions(ceiling, on_floor, wall, -1)
    shuffle(mut dirs, mut rand)
    if try multiface_grow(f, mut r, mut rand, block, chance, on, here, x, y, z, dirs) {
        return true
    }
    for sd in dirs {
        var placement = multiface_directions(ceiling, on_floor, wall, opposite(sd))
        shuffle(mut placement, mut rand)
        // Vanilla sets the position to the origin's neighbour each time round rather than moving
        // it, and a try that places nothing changes nothing, so its `searchRange` tries are the
        // same as one.
        if search > 0 {
            let px = x + step_x(sd)
            let py = y + step_y(sd)
            let pz = z + step_z(sd)
            let state = try r.state(f, px, py, pz)
            if air_or_water(f, state) or f.is(state, block) {
                if try multiface_grow(f, mut r, mut rand, block, chance, on, state, px, py, pz, placement) {
                    return true
                }
            }
        }
    }
    return false
}

/// `Biome.shouldSnow` of `biome`: snow falls there, the block is in the world, and it's air or
/// snow where snow can stay.
pub fn should_snow(g: Gen, r: Region, biome: i32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    if not g.temps.snows(biome, x, y, z, r.sea_level) {
        return false
    }
    if r.outside(y) {
        return false
    }
    let here = try r.state(f, x, y, z)
    if not f.is_air(here) and not f.is(here, f.ids.snow) {
        return false
    }
    return try can_survive(g.env, r, f.default_state(f.ids.snow), x, y, z)
}

// `SnowAndFreezeFeature.place`: each column of the origin's chunk, its water under the top frozen
// and snow laid on top, with the block under made snowy.
fn place_freeze_top_layer(g: Gen, r: mut Region, x: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    for dx in 0..16 {
        for dz in 0..16 {
            let px = x + dx
            let pz = z + dz
            let y = try r.get_height(f, MOTION_BLOCKING, px, pz)
            let biome = try r.biome(px, y, pz)
            if try should_freeze(g, r, biome, px, y - 1, pz) {
                _ = r.set_block(f, px, y - 1, pz, f.default_state(f.ids.ice), 2)
            }
            if try should_snow(g, r, biome, px, y, pz) {
                _ = r.set_block(f, px, y, pz, f.default_state(f.ids.snow), 2)
                let below = try r.state(f, px, y - 1, pz)
                if f.has(below, "snowy") {
                    _ = r.set_block(f, px, y - 1, pz, try f.with_bool(below, "snowy", true), 2)
                }
            }
        }
    }
    return true
}

// `TreeFeature.place`: the tree grown, its decorators run over its logs, leaves and roots sorted
// by height, and its leaves and edges updated.
fn place_tree<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, t: Tree, x: i32, y: i32, z: i32) -> bool ! Thrown {
    var grown = Grow.new()
    let placed = try grow_tree(g.env, g.catalog.providers, g.sin, mut r, mut rand, t, mut grown, x, y, z)
    if not placed or (grown.trunks.is_empty() and grown.foliage.is_empty()) {
        return false
    }
    if not t.decorators.is_empty() {
        let logs = by_y(grown.trunks)
        let leaves = by_y(grown.foliage)
        let roots = by_y(grown.roots)
        try run_decorators(g, mut r, mut rand, t.tags, mut grown, t.decorators, logs, leaves, roots)
    }
    return try finish_tree(g.env, mut r, t, grown)
}

// `PaleMossDecorator.place`: perhaps the moss patch under the lowest log, then hanging moss under
// logs and leaves.
fn pale_moss<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, grown: mut Grow, logs: List<Pos>, leaves: List<Pos>, leaves_p: f32, trunk_p: f32, ground_p: f32, patch: usize?) ! Thrown {
    let Env { facts: f, .. } = g.env
    var shuffled = logs.copy()
    shuffle_positions(mut shuffled, mut rand)
    if shuffled.is_empty() {
        return
    }
    // `Collections.min` by height: the first lowest.
    var origin = shuffled[0]
    for p in shuffled {
        if p.y < origin.y {
            origin = p
        }
    }
    if rand.next_float() < ground_p {
        if let fi = patch {
            _ = try place_feature(g, mut r, mut rand, fi, origin.x, origin.y + 1, origin.z)
        }
    }
    for p in logs {
        if rand.next_float() < trunk_p and f.is_air(try r.state(f, p.x, p.y - 1, p.z)) {
            try moss_hanger(f, mut r, mut rand, mut grown, p.x, p.y - 1, p.z)
        }
    }
    for p in leaves {
        if rand.next_float() < leaves_p and f.is_air(try r.state(f, p.x, p.y - 1, p.z)) {
            try moss_hanger(f, mut r, mut rand, mut grown, p.x, p.y - 1, p.z)
        }
    }
}

// `PaleMossDecorator.addMossHanger`: hanging moss down while there's air below and a coin says
// so, its tip at the end.
fn moss_hanger<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, grown: mut Grow, x: i32, y: i32, z: i32) ! Thrown {
    let moss = f.default_state(try f.named_block("pale_hanging_moss"))
    var py = y
    while f.is_air(try r.state(f, x, py - 1, z)) and not (f64(rand.next_float()) < 0.5) {
        set_decoration(f, mut r, mut grown, x, py, z, try f.with_bool(moss, "tip", false))
        py -= 1
    }
    set_decoration(f, mut r, mut grown, x, py, z, try f.with_bool(moss, "tip", true))
}

// `CaveSurface.getDirection`.
fn surface_direction(ceiling: bool) -> i32 {
    return if ceiling { UP } else { DOWN }
}

// `VegetationPatchFeature.place`, and `WaterloggedVegetationPatchFeature`'s: the ground patch,
// its sheltered blocks made water for the waterlogged one, and vegetation on it by chance.
fn place_vegetation_patch<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, p: Patch, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    let xr = try p.radius.sample(mut rand) + 1
    let zr = try p.radius.sample(mut rand) + 1
    var surface = try patch_ground(g, mut r, mut rand, p, x, y, z, xr, zr)
    if p.waterlogged {
        var water = JavaHashSet<Pos>()
        for s in surface {
            if not try patch_exposed(f, r, s.x, s.y, s.z) {
                water.insert(s)
            }
        }
        for s in water {
            _ = r.set_block(f, s.x, s.y, s.z, f.ids.water_state, 2)
        }
        surface = water
    }
    let outwards = opposite(surface_direction(p.ceiling))
    for s in surface {
        if p.chance > 0.0f32 and rand.next_float() < p.chance {
            if p.waterlogged {
                // `placeVegetation` of the block below, then the block made waterlogged.
                let vy = s.y - 1 + step_y(outwards)
                if try place_placed(g, mut r, mut rand, p.vegetation, s.x, vy, s.z, false) {
                    let placed = try r.state(f, s.x, s.y, s.z)
                    if f.has(placed, "waterlogged") and not f.get_bool(placed, "waterlogged") {
                        _ = r.set_block(f, s.x, s.y, s.z, try f.with_bool(placed, "waterlogged", true), 2)
                    }
                }
            } else {
                _ = try place_placed(g, mut r, mut rand, p.vegetation, s.x, s.y + step_y(outwards), s.z, false)
            }
        }
    }
    return not surface.is_empty()
}

// `VegetationPatchFeature.placeGroundPatch`: each column of the patch, but the corners and some
// of the edges, followed to the surface and given the ground.
fn patch_ground<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, p: Patch, x: i32, y: i32, z: i32, xr: i32, zr: i32) -> JavaHashSet<Pos> ! Thrown {
    let Env { facts: f, .. } = g.env
    let inwards = surface_direction(p.ceiling)
    let outwards = opposite(inwards)
    var surface = JavaHashSet<Pos>()
    for dx in -xr..xr + 1 {
        let x_edge = dx == -xr or dx == xr
        for dz in -zr..zr + 1 {
            let z_edge = dz == -zr or dz == zr
            let corner = x_edge and z_edge
            let edge_not_corner = (x_edge or z_edge) and not corner
            if corner {
                continue
            }
            if edge_not_corner and not (p.extra_edge != 0.0f32 and not (rand.next_float() > p.extra_edge)) {
                continue
            }
            let px = x + dx
            var py = y
            let pz = z + dz
            var offset = 0
            while f.is_air(try r.state(f, px, py, pz)) and offset < p.vertical {
                py += step_y(inwards)
                offset += 1
            }
            offset = 0
            while not f.is_air(try r.state(f, px, py, pz)) and offset < p.vertical {
                py += step_y(outwards)
                offset += 1
            }
            let by = py + step_y(inwards)
            let below = try r.state(f, px, by, pz)
            if f.is_air(try r.state(f, px, py, pz)) and f.sturdy(below, outwards, FULL) {
                let base = try p.depth.sample(mut rand)
                let extra = if p.extra_bottom > 0.0f32 and rand.next_float() < p.extra_bottom { 1 } else { 0 }
                if try patch_place_ground(g, mut r, mut rand, p, px, by, pz, base + extra, inwards) {
                    surface.insert(Pos { x: px, y: by, z: pz })
                }
            }
        }
    }
    return surface
}

// `VegetationPatchFeature.placeGround`: the ground's state down the column, `depth` times, until
// a block it may not replace; a block already the ground's block is left and tried again.
fn patch_place_ground<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, p: Patch, x: i32, y: i32, z: i32, depth: i32, inwards: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    var py = y
    for i in 0..depth {
        let s = try get_state(g.env, g.catalog.providers, r, mut rand, p.ground, x, py, z)
        let below = try r.state(f, x, py, z)
        if not f.is(s, f.block(below)) {
            if not f.in_set(below, p.replaceable) {
                return i != 0
            }
            _ = r.set_block(f, x, py, z, s, 2)
            py += step_y(inwards)
        }
    }
    return true
}

// `WaterloggedVegetationPatchFeature.isExposed`: open to the side or below.
fn patch_exposed(f: Facts, r: Region, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let ds: List<i32> = [NORTH, EAST, SOUTH, WEST, DOWN]
    for d in ds {
        let n = try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        if not f.sturdy(n, opposite(d), FULL) {
            return true
        }
    }
    return false
}

// `BlockColumnFeature.place`: each layer's height drawn, the column cut where the next block
// isn't allowed, from the tip or the base, then each layer's blocks placed along the direction.
fn place_block_column<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, heights: List<IntProvider>, providers: List<usize>, d: i32, allowed: Pred, tip: bool, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    var layer_heights = List<i32>()
    var total = 0
    for h in heights {
        let n = try h.sample(mut rand)
        layer_heights.push(n)
        total += n
    }
    if total == 0 {
        return false
    }
    var nx = x + step_x(d)
    var ny = y + step_y(d)
    var nz = z + step_z(d)
    for i in 0..total {
        if not try test(g.env, r, allowed, nx, ny, nz) {
            // `truncate`.
            var remove = total - i
            let count = i32.wrap(layer_heights.len())
            var k = if tip { 0 } else { count - 1 }
            let end = if tip { count } else { -1 }
            let step = if tip { 1 } else { -1 }
            while k != end and remove > 0 {
                let here = layer_heights[usize.wrap(k)]
                let take = here.min(remove)
                remove -= take
                layer_heights[usize.wrap(k)] = here - take
                k += step
            }
            break
        }
        nx += step_x(d)
        ny += step_y(d)
        nz += step_z(d)
    }
    var px = x
    var py = y
    var pz = z
    for i in 0..layer_heights.len() {
        for _ in 0..layer_heights[i] {
            let s = try get_state(g.env, g.catalog.providers, r, mut rand, providers[i], px, py, pz)
            _ = r.set_block(f, px, py, pz, s, 2)
            px += step_x(d)
            py += step_y(d)
            pz += step_z(d)
        }
    }
    return true
}

// `BlockPileFeature.place`: the blocks of a rough disc two high, each on solid ground.
fn place_block_pile<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, provider: usize, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    if y < r.min_y + 5 {
        return false
    }
    let xr = 2 + rand.next_int_below(2)
    let zr = 2 + rand.next_int_below(2)
    let path = try f.named_block("dirt_path")
    for bz in z - zr..z + zr + 1 {
        for by in y..y + 2 {
            for bx in x - xr..x + xr + 1 {
                let xd = x - bx
                let zd = z - bz
                let a = rand.next_float() * 10.0f32
                let b = rand.next_float() * 6.0f32
                var place = false
                if f32.nearest(xd * xd + zd * zd) <= a - b {
                    place = true
                } else if f64(rand.next_float()) < 0.031 {
                    place = true
                }
                if place and f.is_air(try r.state(f, bx, by, bz)) {
                    // `mayPlaceOn`.
                    let below = try r.state(f, bx, by - 1, bz)
                    let on = if f.is(below, path) { rand.next_boolean() } else { f.sturdy(below, UP, FULL) }
                    if on {
                        let s = try get_state(g.env, g.catalog.providers, r, mut rand, provider, bx, by, bz)
                        _ = r.set_block(f, bx, by, bz, s, 260)
                    }
                }
            }
        }
    }
    return true
}

// The decorators of a tree or a fallen tree run over its lists, `pale_moss` here, the rest in
// `trees`.
fn run_decorators<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, tags: TreeTags, grown: mut Grow, decorators: List<Decorator>, logs: List<Pos>, leaves: List<Pos>, roots: List<Pos>) ! Thrown {
    for d in decorators {
        match d {
            Decorator.PaleMoss { leaves: lp, trunk, ground, patch } => try pale_moss(g, mut r, mut rand, mut grown, logs, leaves, lp, trunk, ground, patch),
            _ => try decorate_tree(g.env, g.catalog.providers, mut r, mut rand, tags, mut grown, d, logs, leaves, roots),
        }
    }
}

// `FallenTreeFeature.placeLogBlock`: the trunk's state, turned to `axis` if 0 or more, set with
// updates and marked above.
fn fallen_log_block<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, trunk: usize, x: i32, y: i32, z: i32, log_axis: i32) -> Pos ! Thrown {
    let Env { facts: f, .. } = g.env
    var s = try get_state(g.env, g.catalog.providers, r, mut rand, trunk, x, y, z)
    if log_axis >= 0 {
        s = f.try_name(s, "axis", axis_name(log_axis))
    }
    _ = r.set_block(f, x, y, z, s, 3)
    try mark_above(f, mut r, x, y, z)
    return Pos { x: x, y: y, z: z }
}

// `FallenTreeFeature.isOverSolidGround`.
fn over_solid_ground(f: Facts, r: Region, x: i32, y: i32, z: i32) -> bool ! Thrown {
    return f.sturdy(try r.state(f, x, y - 1, z), UP, FULL)
}

// `TreeFeature.validTreePos`.
fn tree_pos_valid(f: Facts, r: Region, tags: TreeTags, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let s = try r.state(f, x, y, z)
    return f.is_air(s) or f.in_set(s, tags.replaceable)
}

// `FallenTreeFeature.place`: a stump, decorated, and a log beside it lying on the ground if it
// fits, decorated.
fn place_fallen_tree<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, trunk: usize, length: IntProvider, stump: List<Decorator>, log: List<Decorator>, tags: TreeTags, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    let stump_pos = try fallen_log_block(g, mut r, mut rand, trunk, x, y, z, -1)
    if not stump.is_empty() {
        var grown = Grow.new()
        let none_list = List<Pos>()
        try run_decorators(g, mut r, mut rand, tags, mut grown, stump, [stump_pos], none_list, none_list)
    }
    let d = horizontal(rand.next_int_below(4))
    let log_length = try length.sample(mut rand) - 2
    let distance = 2 + rand.next_int_below(2)
    let lx = x + step_x(d) * distance
    var ly = y + 1
    let lz = z + step_z(d) * distance
    for _ in 0..6 {
        if try tree_pos_valid(f, r, tags, lx, ly, lz) and try over_solid_ground(f, r, lx, ly, lz) {
            break
        }
        ly -= 1
    }
    var gap = 0
    var cx = lx
    var cz = lz
    for _ in 0..log_length {
        if not try tree_pos_valid(f, r, tags, cx, ly, cz) {
            return true
        }
        if not try over_solid_ground(f, r, cx, ly, cz) {
            gap += 1
            if gap > 2 {
                return true
            }
        } else {
            gap = 0
        }
        cx += step_x(d)
        cz += step_z(d)
    }
    var fallen = JavaHashSet<Pos>()
    cx = lx
    cz = lz
    for _ in 0..log_length {
        fallen.insert(try fallen_log_block(g, mut r, mut rand, trunk, cx, ly, cz, axis_of(d)))
        cx += step_x(d)
        cz += step_z(d)
    }
    if not log.is_empty() {
        var grown = Grow.new()
        let none_list = List<Pos>()
        try run_decorators(g, mut r, mut rand, tags, mut grown, log, by_y(fallen), none_list, none_list)
    }
    return true
}

// `VinesFeature.place`: a vine on the first face, but the bottom, it can hang from.
fn place_vines(f: Facts, r: mut Region, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not f.is_air(try r.state(f, x, y, z)) {
        return false
    }
    for d in 1..6 {
        if attaches_state(f, try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d)), d) {
            let vine = try f.with_bool(f.default_state(f.ids.vine), direction_property(d), true)
            _ = r.set_block(f, x, y, z, vine, 2)
            return true
        }
    }
    return false
}

// `BlueIceFeature.place`: blue ice under the sea in water by packed ice, and around it, by
// chance, where blue ice is beside.
fn place_blue_ice<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if y > r.sea_level - 1 {
        return false
    }
    if not f.is(try r.state(f, x, y, z), f.ids.water) and not f.is(try r.state(f, x, y - 1, z), f.ids.water) {
        return false
    }
    var packed = false
    for d in 1..6 {
        if f.is(try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d)), f.ids.packed_ice) {
            packed = true
            break
        }
    }
    if not packed {
        return false
    }
    let blue = f.default_state(f.ids.blue_ice)
    _ = r.set_block(f, x, y, z, blue, 2)
    for _ in 0..200 {
        let y_off = rand.next_int_below(5) - rand.next_int_below(6)
        var xz = 3
        if y_off < 2 {
            xz += y_off / 2
        }
        if xz >= 1 {
            let px = x + rand.next_int_below(xz) - rand.next_int_below(xz)
            let py = y + y_off
            let pz = z + rand.next_int_below(xz) - rand.next_int_below(xz)
            let s = try r.state(f, px, py, pz)
            if f.is_air(s) or f.is(s, f.ids.water) or f.is(s, f.ids.packed_ice) or f.is(s, f.ids.ice) {
                for d in 0..6 {
                    if f.is(try r.state(f, px + step_x(d), py + step_y(d), pz + step_z(d)), f.ids.blue_ice) {
                        _ = r.set_block(f, px, py, pz, blue, 2)
                        break
                    }
                }
            }
        }
    }
    return true
}

// `BlockBlobFeature.place`: down to where the predicate passes below, then three rough balls of
// the state, each from a step down and aside of the last.
fn place_block_blob<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, state: u32, can_place_on: Pred, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    var ox = x
    var oy = y
    var oz = z
    while oy > r.min_y + 3 and not try test(g.env, r, can_place_on, ox, oy - 1, oz) {
        oy -= 1
    }
    if oy <= r.min_y + 3 {
        return false
    }
    for _ in 0..3 {
        let xr = rand.next_int_below(2)
        let yr = rand.next_int_below(2)
        let zr = rand.next_int_below(2)
        let tr = f32.nearest(xr + yr + zr) * 0.333f32 + 0.5f32
        let limit = f64(tr * tr)
        for bz in oz - zr..oz + zr + 1 {
            for by in oy - yr..oy + yr + 1 {
                for bx in ox - xr..ox + xr + 1 {
                    let dx = f64(bx - ox)
                    let dy = f64(by - oy)
                    let dz = f64(bz - oz)
                    if dx * dx + dy * dy + dz * dz <= limit {
                        _ = r.set_block(f, bx, by, bz, state, 3)
                    }
                }
            }
        }
        ox += -1 + rand.next_int_below(2)
        oy += -rand.next_int_below(2)
        oz += -1 + rand.next_int_below(2)
    }
    return true
}

// `AbstractHugeMushroomFeature.placeMushroomBlock`: where it's air or a block mushrooms replace.
fn place_mushroom_block(f: Facts, r: mut Region, replaceable: BlockSet, x: i32, y: i32, z: i32, state: u32) ! Thrown {
    let here = try r.state(f, x, y, z)
    if f.is_air(here) or f.in_set(here, replaceable) {
        _ = r.set_block(f, x, y, z, state, 3)
    }
}

// `AbstractHugeMushroomFeature.place`: a height, room checked, the cap, then the stem.
fn place_huge_mushroom<T: RandomSource>(g: Gen, r: mut Region, rand: mut T, red: bool, cap: usize, stem: usize, radius: i32, can_place_on: Pred, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = g.env
    var height = rand.next_int_below(3) + 4
    if rand.next_int_below(12) == 0 {
        height *= 2
    }
    // `isValidPosition`.
    if y < r.min_y + 1 or y + height + 1 > r.min_y + r.height - 1 {
        return false
    }
    if not try test(g.env, r, can_place_on, x, y - 1, z) {
        return false
    }
    let leaves = f.tag_or_empty("minecraft:leaves")
    for dy in 0..height + 1 {
        // `getTreeRadiusForHeight(-1, -1, foliageRadius, dy)`, as vanilla calls it.
        let rad = if red { 0 } else if dy <= 3 { 0 } else { radius }
        for dx in -rad..rad + 1 {
            for dz in -rad..rad + 1 {
                let s = try r.state(f, x + dx, y + dy, z + dz)
                if not f.is_air(s) and not f.in_set(s, leaves) {
                    return false
                }
            }
        }
    }
    let replaceable = f.tag_or_empty("minecraft:replaceable_by_mushrooms")
    let Gen { catalog: Catalog { providers: ps, .. }, .. } = g
    if red {
        var dy = height - 3
        while dy <= height {
            let rad = if dy < height { radius } else { radius - 1 }
            let center = radius - 2
            for dx in -rad..rad + 1 {
                for dz in -rad..rad + 1 {
                    let x_edge = dx == -rad or dx == rad
                    let z_edge = dz == -rad or dz == rad
                    if dy >= height or x_edge != z_edge {
                        var s = try get_state(g.env, ps, r, mut rand, cap, x, y, z)
                        if f.has(s, "west") and f.has(s, "east") and f.has(s, "north") and f.has(s, "south") and f.has(s, "up") {
                            s = try f.with_bool(s, "up", dy >= height - 1)
                            s = try f.with_bool(s, "west", dx < -center)
                            s = try f.with_bool(s, "east", dx > center)
                            s = try f.with_bool(s, "north", dz < -center)
                            s = try f.with_bool(s, "south", dz > center)
                        }
                        try place_mushroom_block(f, mut r, replaceable, x + dx, y + dy, z + dz, s)
                    }
                }
            }
            dy += 1
        }
    } else {
        for dx in -radius..radius + 1 {
            for dz in -radius..radius + 1 {
                let min_x = dx == -radius
                let max_x = dx == radius
                let min_z = dz == -radius
                let max_z = dz == radius
                let x_edge = min_x or max_x
                let z_edge = min_z or max_z
                if not x_edge or not z_edge {
                    let west = min_x or (z_edge and dx == 1 - radius)
                    let east = max_x or (z_edge and dx == radius - 1)
                    let north = min_z or (x_edge and dz == 1 - radius)
                    let south = max_z or (x_edge and dz == radius - 1)
                    var s = try get_state(g.env, ps, r, mut rand, cap, x, y, z)
                    if f.has(s, "west") and f.has(s, "east") and f.has(s, "north") and f.has(s, "south") {
                        s = try f.with_bool(s, "west", west)
                        s = try f.with_bool(s, "east", east)
                        s = try f.with_bool(s, "north", north)
                        s = try f.with_bool(s, "south", south)
                    }
                    try place_mushroom_block(f, mut r, replaceable, x + dx, y + height, z + dz, s)
                }
            }
        }
    }
    // `placeTrunk`: the stem provider's state at the origin, up the stem.
    for dy in 0..height {
        let s = try get_state(g.env, ps, r, mut rand, stem, x, y, z)
        try place_mushroom_block(f, mut r, replaceable, x, y + dy, z, s)
    }
    return true
}

// `MossyCarpetBlock.placeAt` with the region's random: the carpet, then perhaps a topper above
// with each side kept on a coin, and the carpet updated under it.
fn place_mossy_carpet(f: Facts, r: mut Region, x: i32, y: i32, z: i32, flags: i32) ! Thrown {
    let carpet = try f.named_block("pale_moss_carpet")
    let simple = f.default_state(carpet)
    let adjusted = try mossy_updated(f, r, carpet, simple, x, y, z, true)
    _ = r.set_block(f, x, y, z, adjusted, flags)
    // `createTopperWithSideChance`.
    let previous = try r.state(f, x, y + 1, z)
    let is_carpet = f.is(previous, carpet)
    var topper = f.ids.air_state
    if (not is_carpet or not f.get_bool(previous, "bottom")) and (is_carpet or f.replaceable(previous)) {
        var s = try mossy_updated(f, r, carpet, try f.with_bool(simple, "bottom", false), x, y + 1, z, true)
        for i in 0..4 {
            let name = direction_property(horizontal(i))
            if (f.get_name(s, name) ?? String("none")) != "none" and not r.random.next_boolean() {
                s = try f.with_name(s, name, String("none"))
            }
        }
        if mossy_has_faces(f, s) and s != previous {
            topper = s
        }
    }
    if not f.is_air(topper) {
        _ = r.set_block(f, x, y + 1, z, topper, flags)
        let updated = try mossy_updated(f, r, carpet, adjusted, x, y, z, true)
        _ = r.set_block(f, x, y, z, updated, flags)
    }
}
