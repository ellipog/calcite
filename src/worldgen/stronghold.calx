/// Strongholds: a stair down, then corridors, crossings and rooms picked by weight and placed
/// where they fit, a pending piece at a time at random, laid out again from the next seed until
/// one has its portal room, as `StrongholdStructure` and `StrongholdPieces` lay them out.
module worldgen.stronghold

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.worldgen.{WorldgenRandom}
import worldgen.facts.{EAST, NORTH, SOUTH, WEST}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Field, Piece, PieceData, bool_field, collides, field_of, int_field, make_box, move_below_sea, orient_box, random_horizontal}
import worldgen.structure_world.{StructureWorld}
import worldgen.template.{Bounds}

// The kinds of piece, in the order of the weight table, then the filler and the start.
const STRAIGHT: i32 = 0
const PRISON_HALL: i32 = 1
const LEFT_TURN: i32 = 2
const RIGHT_TURN: i32 = 3
const ROOM_CROSSING: i32 = 4
const STRAIGHT_STAIRS_DOWN: i32 = 5
const STAIRS_DOWN: i32 = 6
const FIVE_CROSSING: i32 = 7
const CHEST_CORRIDOR: i32 = 8
const LIBRARY: i32 = 9
const PORTAL_ROOM: i32 = 10
const FILLER: i32 = 11
const START: i32 = 12

// A `PieceWeight`.
struct Weight {
    kind: i32
    weight: i32
    max: i32
    count: i32
}

// The layout: the pieces, their kinds, the choices their children read (a straight's left and
// right, a five-way crossing's four doors, as bits), the weights left, and the start's state.
struct Layout {
    pieces: List<Piece>
    kinds: List<i32>
    bits: List<i32>
    weights: List<Weight>
    previous: i32
    imposed: bool
    portal: bool
    pending: List<usize>
}

/// `StrongholdStructure`: none if the biome at the chunk's corner isn't allowed.
pub fn stronghold(w: mut StructureWorld, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    if not try w.valid_biome(cx << 4, 0, cz << 4, allowed) {
        return List<Piece>()
    }
    var tries = 0i64
    loop {
        random.set_large_feature_seed(w.seed + tries, cx, cz)
        tries += 1
        let d = random_horizontal(mut random)
        let fields: List<Field> = [door_field(0), bool_field("Source", true)]
        let start = Piece { kind: String("minecraft:shstart"), bb: make_box((cx << 4) + 2, 64, (cz << 4) + 2, d, 5, 11, 5), orientation: d, gen_depth: 0, data: PieceData.Fields(fields) }
        var l = Layout { pieces: [start], kinds: [START], bits: [0], weights: weights(), previous: -1, imposed: false, portal: false, pending: List<usize>() }
        add_children(mut l, 0, mut random)
        while not l.pending.is_empty() {
            let at = usize.wrap(random.next_int_below(i32.wrap(l.pending.len())))
            let i = l.pending.remove(at)
            add_children(mut l, i, mut random)
        }
        _ = move_below_sea(mut l.pieces, w.sea_level(), w.shape.min_y, mut random, 10)
        if l.portal {
            return l.pieces
        }
    }
}

// The weights, none placed.
fn weights() -> List<Weight> {
    return [
        Weight { kind: STRAIGHT, weight: 40, max: 0, count: 0 },
        Weight { kind: PRISON_HALL, weight: 5, max: 5, count: 0 },
        Weight { kind: LEFT_TURN, weight: 20, max: 0, count: 0 },
        Weight { kind: RIGHT_TURN, weight: 20, max: 0, count: 0 },
        Weight { kind: ROOM_CROSSING, weight: 10, max: 6, count: 0 },
        Weight { kind: STRAIGHT_STAIRS_DOWN, weight: 5, max: 5, count: 0 },
        Weight { kind: STAIRS_DOWN, weight: 5, max: 5, count: 0 },
        Weight { kind: FIVE_CROSSING, weight: 5, max: 4, count: 0 },
        Weight { kind: CHEST_CORRIDOR, weight: 5, max: 4, count: 0 },
        Weight { kind: LIBRARY, weight: 10, max: 2, count: 0 },
        Weight { kind: PORTAL_ROOM, weight: 20, max: 1, count: 0 },
    ]
}

// `SmallDoorType` by `randomSmallDoor`'s pick, saved by name.
fn door_field(pick: i32) -> Field {
    let name = match pick {
        2 => "WOOD_DOOR",
        3 => "GRATES",
        4 => "IRON_DOOR",
        _ => "OPENING",
    }
    return field_of("EntryDoor", Tag.Str(String(name)))
}

// Each kind's ID.
fn kind_id(kind: i32) -> str {
    return match kind {
        0 => "minecraft:shs",
        1 => "minecraft:shph",
        2 => "minecraft:shlt",
        3 => "minecraft:shrt",
        4 => "minecraft:shrc",
        5 => "minecraft:shssd",
        6 => "minecraft:shsd",
        7 => "minecraft:sh5c",
        8 => "minecraft:shcc",
        9 => "minecraft:shli",
        10 => "minecraft:shpr",
        11 => "minecraft:shfc",
        _ => "minecraft:shstart",
    }
}

// Each kind's box: its offset from the foot and its size. A library's is its tall one.
fn kind_box(kind: i32, fx: i32, fy: i32, fz: i32, d: i32) -> Bounds {
    return match kind {
        1 => orient_box(fx, fy, fz, -1, -1, 0, 9, 5, 11, d),
        2 => orient_box(fx, fy, fz, -1, -1, 0, 5, 5, 5, d),
        3 => orient_box(fx, fy, fz, -1, -1, 0, 5, 5, 5, d),
        4 => orient_box(fx, fy, fz, -4, -1, 0, 11, 7, 11, d),
        5 => orient_box(fx, fy, fz, -1, -7, 0, 5, 11, 8, d),
        6 => orient_box(fx, fy, fz, -1, -7, 0, 5, 11, 5, d),
        7 => orient_box(fx, fy, fz, -4, -3, 0, 10, 9, 11, d),
        9 => orient_box(fx, fy, fz, -4, -1, 0, 14, 11, 15, d),
        10 => orient_box(fx, fy, fz, -4, -1, 0, 11, 8, 16, d),
        // A straight and a chest corridor.
        _ => orient_box(fx, fy, fz, -1, -1, 0, 5, 5, 7, d),
    }
}

// `isOkBox` and no piece in the way.
fn fits(l: Layout, b: Bounds) -> bool {
    return b.min_y > 10 and not collides(l.pieces, b)
}

// A kind's `createPiece`: none where its box is too low or meets another piece; a library that
// can't stand tall tries its short box.
fn create(l: Layout, kind: i32, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32) -> (Piece, i32)? {
    var b = kind_box(kind, fx, fy, fz, d)
    if not fits(l, b) {
        if kind != LIBRARY {
            return none
        }
        b = orient_box(fx, fy, fz, -4, -1, 0, 14, 6, 15, d)
        if not fits(l, b) {
            return none
        }
    }
    var fields = List<Field>()
    var bits = 0
    if kind == PORTAL_ROOM {
        fields.push(door_field(0))
        fields.push(bool_field("Mob", false))
    } else {
        fields.push(door_field(random.next_int_below(5)))
        if kind == FIVE_CROSSING {
            let left_low = random.next_boolean()
            let left_high = random.next_boolean()
            let right_low = random.next_boolean()
            let right_high = random.next_int_below(3) > 0
            fields.push(bool_field("leftLow", left_low))
            fields.push(bool_field("leftHigh", left_high))
            fields.push(bool_field("rightLow", right_low))
            fields.push(bool_field("rightHigh", right_high))
            bits = bit(left_low, 1) | bit(left_high, 2) | bit(right_low, 4) | bit(right_high, 8)
        } else if kind == STRAIGHT {
            let to_left = random.next_int_below(2) == 0
            let to_right = random.next_int_below(2) == 0
            fields.push(bool_field("Left", to_left))
            fields.push(bool_field("Right", to_right))
            bits = bit(to_left, 1) | bit(to_right, 2)
        } else if kind == ROOM_CROSSING {
            fields.push(int_field("Type", random.next_int_below(5)))
        } else if kind == CHEST_CORRIDOR {
            fields.push(bool_field("Chest", false))
        } else if kind == LIBRARY {
            fields.push(bool_field("Tall", b.max_y - b.min_y + 1 > 6))
        } else if kind == STAIRS_DOWN {
            fields.push(bool_field("Source", false))
        }
    }
    return some((Piece { kind: String(kind_id(kind)), bb: b, orientation: d, gen_depth: depth, data: PieceData.Fields(fields) }, bits))
}

fn bit(on: bool, value: i32) -> i32 {
    return if on { value } else { 0 }
}

// `BoundingBox.intersects`.
fn meets(a: Bounds, b: Bounds) -> bool {
    return a.max_x >= b.min_x and a.min_x <= b.max_x and a.max_z >= b.min_z and a.min_z <= b.max_z and a.max_y >= b.min_y and a.min_y <= b.max_y
}

// `FillerCorridor.findPieceBox`: where the first piece in the way starts level with the
// corridor, the corridor up to it, one to three long.
fn filler_box(l: Layout, fx: i32, fy: i32, fz: i32, d: i32) -> Bounds? {
    let b = orient_box(fx, fy, fz, -1, -1, 0, 5, 5, 4, d)
    for p in l.pieces {
        if meets(p.bb, b) {
            if p.bb.min_y != b.min_y {
                return none
            }
            var depth = 2
            while depth >= 1 {
                let shorter = orient_box(fx, fy, fz, -1, -1, 0, 5, 5, depth, d)
                if not meets(p.bb, shorter) {
                    return some(orient_box(fx, fy, fz, -1, -1, 0, 5, 5, depth + 1, d))
                }
                depth -= 1
            }
            return none
        }
    }
    return none
}

// `generatePieceFromSmallDoor`: the imposed five-way crossing first, then a piece picked by
// weight, tried up to five times, each failed pick falling through to the kinds after it, or a
// filler corridor up to the piece in the way.
fn generate_piece(l: mut Layout, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32) -> (Piece, i32, i32)? {
    var any = false
    var total = 0
    for wt in l.weights {
        if wt.max > 0 and wt.count < wt.max {
            any = true
        }
        total += wt.weight
    }
    if not any {
        return none
    }
    if l.imposed {
        l.imposed = false
        if let (p, bits) = create(l, FIVE_CROSSING, mut random, fx, fy, fz, d, depth) {
            return some((p, FIVE_CROSSING, bits))
        }
    }
    var attempts = 0
    while attempts < 5 {
        attempts += 1
        var selection = random.next_int_below(total)
        for k in 0..l.weights.len() {
            let wt = l.weights[k]
            selection -= wt.weight
            if selection < 0 {
                let room = wt.max == 0 or wt.count < wt.max
                let deep = (wt.kind != LIBRARY or depth > 4) and (wt.kind != PORTAL_ROOM or depth > 5)
                if not (room and deep) or wt.kind == l.previous {
                    break
                }
                if let (p, bits) = create(l, wt.kind, mut random, fx, fy, fz, d, depth) {
                    l.weights[k].count += 1
                    l.previous = wt.kind
                    if not (l.weights[k].max == 0 or l.weights[k].count < l.weights[k].max) {
                        _ = l.weights.remove(k)
                    }
                    return some((p, wt.kind, bits))
                }
            }
        }
    }
    if let b = filler_box(l, fx, fy, fz, d) {
        if b.min_y > 1 {
            let steps = if d == NORTH or d == SOUTH { b.max_z - b.min_z + 1 } else { b.max_x - b.min_x + 1 }
            let fields: List<Field> = [door_field(0), int_field("Steps", steps)]
            return some((Piece { kind: String(kind_id(FILLER)), bb: b, orientation: d, gen_depth: depth, data: PieceData.Fields(fields) }, FILLER, 0))
        }
    }
    return none
}

// `generateAndAddPiece`: a piece at the foot, no deeper than 50 and within 112 blocks of the
// start, added and left to have its children.
fn add_piece(l: mut Layout, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32) {
    if depth > 50 {
        return
    }
    let start = l.pieces[0].bb
    if (fx - start.min_x).abs() <= 112 and (fz - start.min_z).abs() <= 112 {
        if let (p, kind, bits) = generate_piece(mut l, mut random, fx, fy, fz, d, depth + 1) {
            l.pieces.push(p)
            l.kinds.push(kind)
            l.bits.push(bits)
            l.pending.push(l.pieces.len() - 1)
        }
    }
}

// `generateSmallDoorChildForward`.
fn forward(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>, x_off: i32, y_off: i32) {
    let b = l.pieces[i].bb
    let d = l.pieces[i].orientation
    let depth = l.pieces[i].gen_depth
    if d == NORTH {
        add_piece(mut l, mut random, b.min_x + x_off, b.min_y + y_off, b.min_z - 1, d, depth)
    } else if d == SOUTH {
        add_piece(mut l, mut random, b.min_x + x_off, b.min_y + y_off, b.max_z + 1, d, depth)
    } else if d == WEST {
        add_piece(mut l, mut random, b.min_x - 1, b.min_y + y_off, b.min_z + x_off, d, depth)
    } else if d == EAST {
        add_piece(mut l, mut random, b.max_x + 1, b.min_y + y_off, b.min_z + x_off, d, depth)
    }
}

// `generateSmallDoorChildLeft`.
fn left(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>, y_off: i32, z_off: i32) {
    let b = l.pieces[i].bb
    let d = l.pieces[i].orientation
    let depth = l.pieces[i].gen_depth
    if d == NORTH or d == SOUTH {
        add_piece(mut l, mut random, b.min_x - 1, b.min_y + y_off, b.min_z + z_off, WEST, depth)
    } else if d == WEST or d == EAST {
        add_piece(mut l, mut random, b.min_x + z_off, b.min_y + y_off, b.min_z - 1, NORTH, depth)
    }
}

// `generateSmallDoorChildRight`.
fn right(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>, y_off: i32, z_off: i32) {
    let b = l.pieces[i].bb
    let d = l.pieces[i].orientation
    let depth = l.pieces[i].gen_depth
    if d == NORTH or d == SOUTH {
        add_piece(mut l, mut random, b.max_x + 1, b.min_y + y_off, b.min_z + z_off, EAST, depth)
    } else if d == WEST or d == EAST {
        add_piece(mut l, mut random, b.min_x + z_off, b.min_y + y_off, b.max_z + 1, SOUTH, depth)
    }
}

// `addChildren` of the piece, by its kind.
fn add_children(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>) {
    let kind = l.kinds[i]
    let d = l.pieces[i].orientation
    let bits = l.bits[i]
    if kind == START {
        // The start imposes a five-way crossing on its first child.
        l.imposed = true
        forward(mut l, i, mut random, 1, 1)
    } else if kind == STRAIGHT {
        forward(mut l, i, mut random, 1, 1)
        if bits & 1 != 0 {
            left(mut l, i, mut random, 1, 2)
        }
        if bits & 2 != 0 {
            right(mut l, i, mut random, 1, 2)
        }
    } else if kind == PRISON_HALL or kind == CHEST_CORRIDOR or kind == STAIRS_DOWN or kind == STRAIGHT_STAIRS_DOWN {
        forward(mut l, i, mut random, 1, 1)
    } else if kind == LEFT_TURN {
        if d != NORTH and d != EAST {
            right(mut l, i, mut random, 1, 1)
        } else {
            left(mut l, i, mut random, 1, 1)
        }
    } else if kind == RIGHT_TURN {
        if d != NORTH and d != EAST {
            left(mut l, i, mut random, 1, 1)
        } else {
            right(mut l, i, mut random, 1, 1)
        }
    } else if kind == ROOM_CROSSING {
        forward(mut l, i, mut random, 4, 1)
        left(mut l, i, mut random, 1, 4)
        right(mut l, i, mut random, 1, 4)
    } else if kind == FIVE_CROSSING {
        // Vanilla passes the doors' offsets along the side first, where the other children
        // pass their height.
        let flip = d == WEST or d == NORTH
        let a = if flip { 5 } else { 3 }
        let b = if flip { 3 } else { 5 }
        forward(mut l, i, mut random, 5, 1)
        if bits & 1 != 0 {
            left(mut l, i, mut random, a, 1)
        }
        if bits & 2 != 0 {
            left(mut l, i, mut random, b, 7)
        }
        if bits & 4 != 0 {
            right(mut l, i, mut random, a, 1)
        }
        if bits & 8 != 0 {
            right(mut l, i, mut random, b, 7)
        }
    } else if kind == PORTAL_ROOM {
        l.portal = true
    }
}
