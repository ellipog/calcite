/// Woodland mansions: a grid of corridors and rooms grown at random on three floors, then walls,
/// roofs, carpets, doors and rooms placed from it, each a template, as
/// `WoodlandMansionStructure` and `WoodlandMansionPieces` lay them out.
module worldgen.mansion

import std.zip.{Zip}
import random.legacy.{LegacyRandom}
import random.worldgen.{WorldgenRandom}
import worldgen.facts.{EAST, NORTH, SOUTH, UP, WEST, clockwise, horizontal, opposite, step_x, step_z}
import worldgen.interval.{Thrown}
import worldgen.multiface.{shuffle}
import worldgen.pieces.{Piece, PieceData, TemplateKind, TemplatePiece}
import worldgen.structure_world.{StructureWorld}
import worldgen.template.{CLOCKWISE_180, CLOCKWISE_90, COUNTERCLOCKWISE_90, FRONT_BACK, LEFT_RIGHT, MIRROR_NONE, ROTATION_NONE, Settings, rotate_direction}

// What a cell of the grid is.
const CLEAR: i32 = 0
const CORRIDOR: i32 = 1
const ROOM: i32 = 2
const START_ROOM: i32 = 3
const BLOCKED: i32 = 5

// What a cell of a floor's rooms holds: its room's kind and ID, and flags.
const ROOM_1X1: i32 = 65536
const ROOM_1X2: i32 = 131072
const ROOM_2X2: i32 = 262144
const ROOM_ORIGIN: i32 = 1048576
const ROOM_DOOR: i32 = 2097152
const ROOM_STAIRS: i32 = 4194304
const ROOM_CORRIDOR: i32 = 8388608
const ROOM_TYPE_MASK: i32 = 983040
const ROOM_ID_MASK: i32 = 65535

// `SimpleGrid`: cells by `x` then `y`, a value for those outside it.
struct Grid {
    cells: List<i32>
    width: i32
    height: i32
    outside: i32
}

impl Grid {
    fn new(width: i32, height: i32, outside: i32) -> Grid {
        var cells = List<i32>()
        for _ in 0..width * height {
            cells.push(0)
        }
        return Grid { cells: cells, width: width, height: height, outside: outside }
    }

    fn set(mut self, x: i32, y: i32, value: i32) {
        if x >= 0 and x < self.width and y >= 0 and y < self.height {
            self.cells[usize.wrap(x * self.height + y)] = value
        }
    }

    fn fill(mut self, x0: i32, y0: i32, x1: i32, y1: i32, value: i32) {
        for y in y0..y1 + 1 {
            for x in x0..x1 + 1 {
                self.set(x, y, value)
            }
        }
    }

    fn get(self, x: i32, y: i32) -> i32 {
        if x >= 0 and x < self.width and y >= 0 and y < self.height {
            return self.cells[usize.wrap(x * self.height + y)]
        }
        return self.outside
    }

    fn setif(mut self, x: i32, y: i32, if_value: i32, value: i32) {
        if self.get(x, y) == if_value {
            self.set(x, y, value)
        }
    }

    fn edges_to(self, x: i32, y: i32, value: i32) -> bool {
        return self.get(x - 1, y) == value or self.get(x + 1, y) == value or self.get(x, y + 1) == value or self.get(x, y - 1) == value
    }
}

// `MansionGrid`: the house's cells, the third floor's, and each floor's rooms.
struct Mansion {
    base: Grid
    third: Grid
    rooms: List<Grid>
}

const ENTRANCE_X: i32 = 7
const ENTRANCE_Y: i32 = 4

// `MansionGrid.isHouse`.
fn is_house(g: Grid, x: i32, y: i32) -> bool {
    let v = g.get(x, y)
    return v == 1 or v == 2 or v == 3 or v == 4
}

// `MansionGrid.isRoomId`.
fn is_room_id(m: Mansion, x: i32, y: i32, floor: i32, id: i32) -> bool {
    return (m.rooms[usize.wrap(floor)].get(x, y) & ROOM_ID_MASK) == id
}

// `MansionGrid.get1x2RoomDirection`: the side the rest of the room is on, or -1.
fn room_direction(m: Mansion, x: i32, y: i32, floor: i32, id: i32) -> i32 {
    for i in 0..4 {
        let d = horizontal(i)
        if is_room_id(m, x + step_x(d), y + step_z(d), floor, id) {
            return d
        }
    }
    return -1
}

// `Direction.from2DDataValue`.
fn from_2d(i: i32) -> i32 {
    return match i {
        0 => SOUTH,
        1 => WEST,
        2 => NORTH,
        _ => EAST,
    }
}

fn counter_clockwise(d: i32) -> i32 {
    return opposite(clockwise(d))
}

// The `MansionGrid` constructor.
fn mansion_grid(random: mut WorldgenRandom<LegacyRandom>) -> Mansion {
    var base = Grid.new(11, 11, BLOCKED)
    base.fill(ENTRANCE_X, ENTRANCE_Y, ENTRANCE_X + 1, ENTRANCE_Y + 1, START_ROOM)
    base.fill(ENTRANCE_X - 1, ENTRANCE_Y, ENTRANCE_X - 1, ENTRANCE_Y + 1, ROOM)
    base.fill(ENTRANCE_X + 2, ENTRANCE_Y - 2, ENTRANCE_X + 3, ENTRANCE_Y + 3, BLOCKED)
    base.fill(ENTRANCE_X + 1, ENTRANCE_Y - 2, ENTRANCE_X + 1, ENTRANCE_Y - 1, CORRIDOR)
    base.fill(ENTRANCE_X + 1, ENTRANCE_Y + 2, ENTRANCE_X + 1, ENTRANCE_Y + 3, CORRIDOR)
    base.set(ENTRANCE_X - 1, ENTRANCE_Y - 1, CORRIDOR)
    base.set(ENTRANCE_X - 1, ENTRANCE_Y + 2, CORRIDOR)
    base.fill(0, 0, 11, 1, BLOCKED)
    base.fill(0, 9, 11, 11, BLOCKED)
    corridor(mut base, mut random, ENTRANCE_X, ENTRANCE_Y - 2, WEST, 6)
    corridor(mut base, mut random, ENTRANCE_X, ENTRANCE_Y + 3, WEST, 6)
    corridor(mut base, mut random, ENTRANCE_X - 2, ENTRANCE_Y - 1, WEST, 3)
    corridor(mut base, mut random, ENTRANCE_X - 2, ENTRANCE_Y + 2, WEST, 3)
    while clean_edges(mut base) {}
    var first = Grid.new(11, 11, BLOCKED)
    var second = Grid.new(11, 11, BLOCKED)
    identify_rooms(base, mut first, mut random)
    identify_rooms(base, mut second, mut random)
    first.fill(ENTRANCE_X + 1, ENTRANCE_Y, ENTRANCE_X + 1, ENTRANCE_Y + 1, ROOM_CORRIDOR)
    second.fill(ENTRANCE_X + 1, ENTRANCE_Y, ENTRANCE_X + 1, ENTRANCE_Y + 1, ROOM_CORRIDOR)
    let third = Grid.new(base.width, base.height, BLOCKED)
    var m = Mansion { base: base, third: third, rooms: [first, second, Grid.new(11, 11, BLOCKED)] }
    setup_third_floor(mut m, mut random)
    var third_rooms = m.rooms[2].copy()
    identify_rooms(m.third, mut third_rooms, mut random)
    m.rooms[2] = third_rooms
    return m
}

// `recursiveCorridor`.
fn corridor(g: mut Grid, random: mut WorldgenRandom<LegacyRandom>, x: i32, y: i32, heading: i32, depth: i32) {
    if depth <= 0 {
        return
    }
    g.set(x, y, CORRIDOR)
    g.setif(x + step_x(heading), y + step_z(heading), CLEAR, CORRIDOR)
    for _ in 0..8 {
        let next = from_2d(random.next_int_below(4))
        if next != opposite(heading) and (next != EAST or not random.next_boolean()) {
            let nx = x + step_x(heading)
            let ny = y + step_z(heading)
            if g.get(nx + step_x(next), ny + step_z(next)) == CLEAR and g.get(nx + step_x(next) * 2, ny + step_z(next) * 2) == CLEAR {
                corridor(mut g, mut random, x + step_x(heading) + step_x(next), y + step_z(heading) + step_z(next), next, depth - 1)
                break
            }
        }
    }
    let cw = clockwise(heading)
    let ccw = counter_clockwise(heading)
    g.setif(x + step_x(cw), y + step_z(cw), CLEAR, ROOM)
    g.setif(x + step_x(ccw), y + step_z(ccw), CLEAR, ROOM)
    g.setif(x + step_x(heading) + step_x(cw), y + step_z(heading) + step_z(cw), CLEAR, ROOM)
    g.setif(x + step_x(heading) + step_x(ccw), y + step_z(heading) + step_z(ccw), CLEAR, ROOM)
    g.setif(x + step_x(heading) * 2, y + step_z(heading) * 2, CLEAR, ROOM)
    g.setif(x + step_x(cw) * 2, y + step_z(cw) * 2, CLEAR, ROOM)
    g.setif(x + step_x(ccw) * 2, y + step_z(ccw) * 2, CLEAR, ROOM)
}

fn house_count(g: Grid, a: (i32, i32), b: (i32, i32), c: (i32, i32), d: (i32, i32)) -> i32 {
    var n = 0
    for (x, y) in [a, b, c, d] {
        if is_house(g, x, y) {
            n += 1
        }
    }
    return n
}

// `cleanEdges`: clear cells mostly surrounded by the house made rooms.
fn clean_edges(g: mut Grid) -> bool {
    var touched = false
    for y in 0..g.height {
        for x in 0..g.width {
            if g.get(x, y) == CLEAR {
                let direct = house_count(g, (x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1))
                if direct >= 3 {
                    g.set(x, y, ROOM)
                    touched = true
                } else if direct == 2 {
                    let diagonal = house_count(g, (x + 1, y + 1), (x - 1, y + 1), (x + 1, y - 1), (x - 1, y - 1))
                    if diagonal <= 1 {
                        g.set(x, y, ROOM)
                        touched = true
                    }
                }
            }
        }
    }
    return touched
}

// `setupThirdFloor`.
fn setup_third_floor(m: mut Mansion, random: mut WorldgenRandom<LegacyRandom>) {
    var potential = List<(i32, i32)>()
    for y in 0..m.third.height {
        for x in 0..m.third.width {
            let data = m.rooms[1].get(x, y)
            if (data & ROOM_TYPE_MASK) == ROOM_1X2 and (data & ROOM_DOOR) == ROOM_DOOR {
                potential.push((x, y))
            }
        }
    }
    if potential.is_empty() {
        let w = m.third.width
        let h = m.third.height
        m.third.fill(0, 0, w, h, BLOCKED)
        return
    }
    let (rx, ry) = potential[usize.wrap(random.next_int_below(i32.wrap(potential.len())))]
    let data = m.rooms[1].get(rx, ry)
    m.rooms[1].set(rx, ry, data | ROOM_STAIRS)
    let dir = room_direction(m, rx, ry, 1, data & ROOM_ID_MASK)
    let end_x = rx + step_x(dir)
    let end_y = ry + step_z(dir)
    for y in 0..m.third.height {
        for x in 0..m.third.width {
            if not is_house(m.base, x, y) {
                m.third.set(x, y, BLOCKED)
            } else if x == rx and y == ry {
                m.third.set(x, y, START_ROOM)
            } else if x == end_x and y == end_y {
                m.third.set(x, y, START_ROOM)
                m.rooms[2].set(x, y, ROOM_CORRIDOR)
            }
        }
    }
    var corridors = List<i32>()
    for i in 0..4 {
        let d = horizontal(i)
        if m.third.get(end_x + step_x(d), end_y + step_z(d)) == CLEAR {
            corridors.push(d)
        }
    }
    if corridors.is_empty() {
        let w = m.third.width
        let h = m.third.height
        m.third.fill(0, 0, w, h, BLOCKED)
        m.rooms[1].set(rx, ry, data)
        return
    }
    let d = corridors[usize.wrap(random.next_int_below(i32.wrap(corridors.len())))]
    corridor(mut m.third, mut random, end_x + step_x(d), end_y + step_z(d), d, 4)
    while clean_edges(mut m.third) {}
}

// `identifyRooms`: the grid's room cells, shuffled, each that's free made the origin of a room
// as big as fits, two by two, then one by two, else one, with a door onto a corridor.
fn identify_rooms(from: Grid, rooms: mut Grid, random: mut WorldgenRandom<LegacyRandom>) {
    var cells = List<i32>()
    for y in 0..from.height {
        for x in 0..from.width {
            if from.get(x, y) == ROOM {
                cells.push((x << 8) | y)
            }
        }
    }
    shuffle(mut cells, mut random)
    var id = 10
    for cell in cells {
        let x = cell >> 8
        let y = cell & 255
        if rooms.get(x, y) != CLEAR {
            continue
        }
        var x0 = x
        var x1 = x
        var y0 = y
        var y1 = y
        var kind = ROOM_1X1
        if rooms.get(x + 1, y) == 0 and rooms.get(x, y + 1) == 0 and rooms.get(x + 1, y + 1) == 0 and from.get(x + 1, y) == ROOM and from.get(x, y + 1) == ROOM and from.get(x + 1, y + 1) == ROOM {
            x1 += 1
            y1 += 1
            kind = ROOM_2X2
        } else if rooms.get(x - 1, y) == 0 and rooms.get(x, y + 1) == 0 and rooms.get(x - 1, y + 1) == 0 and from.get(x - 1, y) == ROOM and from.get(x, y + 1) == ROOM and from.get(x - 1, y + 1) == ROOM {
            x0 -= 1
            y1 += 1
            kind = ROOM_2X2
        } else if rooms.get(x - 1, y) == 0 and rooms.get(x, y - 1) == 0 and rooms.get(x - 1, y - 1) == 0 and from.get(x - 1, y) == ROOM and from.get(x, y - 1) == ROOM and from.get(x - 1, y - 1) == ROOM {
            x0 -= 1
            y0 -= 1
            kind = ROOM_2X2
        } else if rooms.get(x + 1, y) == 0 and from.get(x + 1, y) == ROOM {
            x1 += 1
            kind = ROOM_1X2
        } else if rooms.get(x, y + 1) == 0 and from.get(x, y + 1) == ROOM {
            y1 += 1
            kind = ROOM_1X2
        } else if rooms.get(x - 1, y) == 0 and from.get(x - 1, y) == ROOM {
            x0 -= 1
            kind = ROOM_1X2
        } else if rooms.get(x, y - 1) == 0 and from.get(x, y - 1) == ROOM {
            y0 -= 1
            kind = ROOM_1X2
        }
        var door_x = if random.next_boolean() { x0 } else { x1 }
        var door_y = if random.next_boolean() { y0 } else { y1 }
        var door = ROOM_DOOR
        if not from.edges_to(door_x, door_y, CORRIDOR) {
            door_x = if door_x == x0 { x1 } else { x0 }
            door_y = if door_y == y0 { y1 } else { y0 }
            if not from.edges_to(door_x, door_y, CORRIDOR) {
                door_y = if door_y == y0 { y1 } else { y0 }
                if not from.edges_to(door_x, door_y, CORRIDOR) {
                    door_x = if door_x == x0 { x1 } else { x0 }
                    door_y = if door_y == y0 { y1 } else { y0 }
                    if not from.edges_to(door_x, door_y, CORRIDOR) {
                        door = 0
                        door_x = x0
                        door_y = y0
                    }
                }
            }
        }
        for ry in y0..y1 + 1 {
            for rx in x0..x1 + 1 {
                if rx == door_x and ry == door_y {
                    rooms.set(rx, ry, ROOM_ORIGIN | door | kind | id)
                } else {
                    rooms.set(rx, ry, kind | id)
                }
            }
        }
        id += 1
    }
}

// A block.
struct Pos {
    x: i32
    y: i32
    z: i32
}

// `BlockPos.relative` of a horizontal direction.
fn rel(p: Pos, d: i32, n: i32) -> Pos {
    return Pos { x: p.x + step_x(d) * n, y: p.y, z: p.z + step_z(d) * n }
}

fn above(p: Pos, n: i32) -> Pos {
    return Pos { x: p.x, y: p.y + n, z: p.z }
}

// `Rotation.getRotated`.
fn turned(r: i32, by: i32) -> i32 {
    return (r + by) % 4
}

// A piece to make: its template's name, where it's placed from, turned and mirrored.
struct Spec {
    name: String
    at: Pos
    rotation: i32
    mirror: i32
}

// `PlacementData`.
struct Walker {
    rotation: i32
    at: Pos
    wall: String
}

// `MansionPiecePlacer`: the pieces so far, and where the grid's start is.
struct Placer {
    specs: List<Spec>
    start_x: i32
    start_y: i32
}

impl Placer {
    fn add(mut self, name: str, at: Pos, rotation: i32, mirror: i32) {
        self.specs.push(Spec { name: String(name), at: at, rotation: rotation, mirror: mirror })
    }

    fn add_named(mut self, name: own String, at: Pos, rotation: i32, mirror: i32) {
        self.specs.push(Spec { name: name, at: at, rotation: rotation, mirror: mirror })
    }

    // Where a cell of a grid placed from `origin` starts.
    fn cell(self, origin: Pos, rotation: i32, x: i32, y: i32) -> Pos {
        let p = rel(origin, rotate_direction(rotation, SOUTH), 8 + (y - self.start_y) * 8)
        return rel(p, rotate_direction(rotation, EAST), (x - self.start_x) * 8)
    }
}

/// `WoodlandMansionStructure`: none where the corners five blocks out are below 60.
pub fn mansion(w: mut StructureWorld, zip: Zip, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    let x = (cx << 4) + 7
    let z = (cz << 4) + 7
    if not try w.valid_in_column(x, z, allowed) {
        return List<Piece>()
    }
    let rotation = random.next_int_below(4)
    // `getLowestYIn5by5Box`.
    var ox = 5
    var oz = 5
    if rotation == CLOCKWISE_90 {
        ox = -5
    } else if rotation == CLOCKWISE_180 {
        ox = -5
        oz = -5
    } else if rotation == COUNTERCLOCKWISE_90 {
        oz = -5
    }
    let y = try w.lowest_y(x, z, ox, oz)
    if y < 60 {
        return List<Piece>()
    }
    if not try w.valid_biome(x, y, z, allowed) {
        return List<Piece>()
    }
    let m = mansion_grid(mut random)
    var p = Placer { specs: List<Spec>(), start_x: 0, start_y: 0 }
    create_mansion(mut p, m, mut random, Pos { x: x, y: y, z: z }, rotation)
    var out = List<Piece>()
    for s in p.specs {
        let t = try w.template(zip, "minecraft:woodland_mansion/{s.name}")
        let settings = Settings { mirror: s.mirror, rotation: s.rotation }
        let bb = w.templates.list[t].bounding_box(settings, s.at.x, s.at.y, s.at.z)
        let data = TemplatePiece { name: s.name.copy(), template: t, x: s.at.x, y: s.at.y, z: s.at.z, rotation: s.rotation, mirror: s.mirror, pivot_x: 0, pivot_y: 0, pivot_z: 0, kind: TemplateKind.Mansion }
        out.push(Piece { kind: String("minecraft:wmp"), bb: bb, orientation: NORTH, gen_depth: 0, data: PieceData.Template(data) })
    }
    return out
}

// `createMansion`.
fn create_mansion(p: mut Placer, m: Mansion, random: mut WorldgenRandom<LegacyRandom>, origin: Pos, rotation: i32) {
    var data = Walker { rotation: rotation, at: origin, wall: String("wall_flat") }
    // `entrance`.
    p.add("entrance", rel(data.at, rotate_direction(data.rotation, WEST), 9), data.rotation, MIRROR_NONE)
    data.at = rel(data.at, rotate_direction(data.rotation, SOUTH), 16)
    var second = Walker { rotation: data.rotation, at: above(data.at, 8), wall: String("wall_window") }
    p.start_x = ENTRANCE_X + 1
    p.start_y = ENTRANCE_Y + 1
    let end_x = ENTRANCE_X + 1
    let end_y = ENTRANCE_Y
    let sx = p.start_x
    let sy = p.start_y
    outer_walls(mut p, mut data, m.base, SOUTH, sx, sy, end_x, end_y)
    outer_walls(mut p, mut second, m.base, SOUTH, sx, sy, end_x, end_y)
    var third = Walker { rotation: data.rotation, at: above(data.at, 19), wall: String("wall_window") }
    var done = false
    var y = 0
    while y < m.third.height and not done {
        var x = m.third.width - 1
        while x >= 0 and not done {
            if is_house(m.third, x, y) {
                third.at = rel(third.at, rotate_direction(rotation, SOUTH), 8 + (y - p.start_y) * 8)
                third.at = rel(third.at, rotate_direction(rotation, EAST), (x - p.start_x) * 8)
                wall_piece(mut p, mut third)
                outer_walls(mut p, mut third, m.third, SOUTH, x, y, x, y)
                done = true
            }
            x -= 1
        }
        y += 1
    }
    roof(mut p, above(origin, 16), rotation, m.base, some(m.third.copy()))
    roof(mut p, above(origin, 27), rotation, m.third, none)
    for floor in 0..3 {
        floor_pieces(mut p, m, mut random, origin, rotation, floor)
    }
}

// The rooms, corridors, carpets and inner walls of a floor.
fn floor_pieces(p: mut Placer, m: Mansion, random: mut WorldgenRandom<LegacyRandom>, origin: Pos, rotation: i32, floor: i32) {
    let floor_origin = above(origin, 8 * floor + (if floor == 2 { 3 } else { 0 }))
    let rooms = m.rooms[usize.wrap(floor)].copy()
    let grid = if floor == 2 { m.third.copy() } else { m.base.copy() }
    let south_piece = if floor == 0 { "carpet_south_1" } else { "carpet_south_2" }
    let west_piece = if floor == 0 { "carpet_west_1" } else { "carpet_west_2" }
    let east = rotate_direction(rotation, EAST)
    let south = rotate_direction(rotation, SOUTH)
    let west = rotate_direction(rotation, WEST)
    let north = rotate_direction(rotation, NORTH)
    for y in 0..grid.height {
        for x in 0..grid.width {
            if grid.get(x, y) != CORRIDOR {
                continue
            }
            let at = p.cell(floor_origin, rotation, x, y)
            p.add("corridor_floor", at, rotation, MIRROR_NONE)
            if grid.get(x, y - 1) == CORRIDOR or (rooms.get(x, y - 1) & ROOM_CORRIDOR) == ROOM_CORRIDOR {
                p.add("carpet_north", above(rel(at, east, 1), 1), rotation, MIRROR_NONE)
            }
            if grid.get(x + 1, y) == CORRIDOR or (rooms.get(x + 1, y) & ROOM_CORRIDOR) == ROOM_CORRIDOR {
                p.add("carpet_east", above(rel(rel(at, south, 1), east, 5), 1), rotation, MIRROR_NONE)
            }
            if grid.get(x, y + 1) == CORRIDOR or (rooms.get(x, y + 1) & ROOM_CORRIDOR) == ROOM_CORRIDOR {
                p.add(south_piece, rel(rel(at, south, 5), west, 1), rotation, MIRROR_NONE)
            }
            if grid.get(x - 1, y) == CORRIDOR or (rooms.get(x - 1, y) & ROOM_CORRIDOR) == ROOM_CORRIDOR {
                p.add(west_piece, rel(rel(at, west, 1), north, 1), rotation, MIRROR_NONE)
            }
        }
    }
    let wall_piece_name = if floor == 0 { "indoors_wall_1" } else { "indoors_wall_2" }
    let door_piece_name = if floor == 0 { "indoors_door_1" } else { "indoors_door_2" }
    for y in 0..grid.height {
        for x in 0..grid.width {
            var start_room = floor == 2 and grid.get(x, y) == START_ROOM
            if grid.get(x, y) != ROOM and not start_room {
                continue
            }
            let data = rooms.get(x, y)
            let kind = data & ROOM_TYPE_MASK
            let id = data & ROOM_ID_MASK
            start_room = start_room and (data & ROOM_CORRIDOR) == ROOM_CORRIDOR
            var doors = List<i32>()
            if (data & ROOM_DOOR) == ROOM_DOOR {
                for i in 0..4 {
                    let d = horizontal(i)
                    if grid.get(x + step_x(d), y + step_z(d)) == CORRIDOR {
                        doors.push(d)
                    }
                }
            }
            var door = -1
            if not doors.is_empty() {
                door = doors[usize.wrap(random.next_int_below(i32.wrap(doors.len())))]
            } else if (data & ROOM_ORIGIN) == ROOM_ORIGIN {
                door = UP
            }
            let room_at = rel(rel(floor_origin, south, 8 + (y - p.start_y) * 8), east, -1 + (x - p.start_x) * 8)
            if is_house(grid, x - 1, y) and not is_room_id(m, x - 1, y, floor, id) {
                p.add(if door == WEST { door_piece_name } else { wall_piece_name }, room_at, rotation, MIRROR_NONE)
            }
            if grid.get(x + 1, y) == CORRIDOR and not start_room {
                p.add(if door == EAST { door_piece_name } else { wall_piece_name }, rel(room_at, east, 8), rotation, MIRROR_NONE)
            }
            if is_house(grid, x, y + 1) and not is_room_id(m, x, y + 1, floor, id) {
                p.add(if door == SOUTH { door_piece_name } else { wall_piece_name }, rel(rel(room_at, south, 7), east, 7), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
            }
            if grid.get(x, y - 1) == CORRIDOR and not start_room {
                p.add(if door == NORTH { door_piece_name } else { wall_piece_name }, rel(rel(room_at, north, 1), east, 7), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
            }
            if kind == ROOM_1X1 {
                room_1x1(mut p, mut random, room_at, rotation, door, floor)
            } else if kind == ROOM_1X2 and door != -1 {
                let room_dir = room_direction(m, x, y, floor, id)
                let stairs = (data & ROOM_STAIRS) == ROOM_STAIRS
                room_1x2(mut p, mut random, room_at, rotation, room_dir, door, floor, stairs)
            } else if kind == ROOM_2X2 and door != -1 and door != UP {
                var room_dir = clockwise(door)
                if not is_room_id(m, x + step_x(room_dir), y + step_z(room_dir), floor, id) {
                    room_dir = opposite(room_dir)
                }
                room_2x2(mut p, mut random, room_at, rotation, room_dir, door, floor)
            } else if kind == ROOM_2X2 and door == UP {
                p.add("2x2_s1", rel(room_at, east, 1), rotation, MIRROR_NONE)
            }
        }
    }
}

// `traverseOuterWalls`: round the grid's edge from the start cell, a wall piece for each cell
// along it and a corner at each turn.
fn outer_walls(p: mut Placer, data: mut Walker, g: Grid, direction: i32, start_x: i32, start_y: i32, end_x: i32, end_y: i32) {
    var gx = start_x
    var gy = start_y
    var d = direction
    let start_direction = direction
    loop {
        if not is_house(g, gx + step_x(d), gy + step_z(d)) {
            turn(mut p, mut data)
            d = clockwise(d)
            if gx != end_x or gy != end_y or start_direction != d {
                wall_piece(mut p, mut data)
            }
        } else if is_house(g, gx + step_x(d) + step_x(counter_clockwise(d)), gy + step_z(d) + step_z(counter_clockwise(d))) {
            inner_turn(mut data)
            gx += step_x(d)
            gy += step_z(d)
            d = counter_clockwise(d)
        } else {
            gx += step_x(d)
            gy += step_z(d)
            if gx != end_x or gy != end_y or start_direction != d {
                wall_piece(mut p, mut data)
            }
        }
        if not (gx != end_x or gy != end_y or start_direction != d) {
            break
        }
    }
}

// `traverseWallPiece`.
fn wall_piece(p: mut Placer, data: mut Walker) {
    p.add_named(data.wall.copy(), rel(data.at, rotate_direction(data.rotation, EAST), 7), data.rotation, MIRROR_NONE)
    data.at = rel(data.at, rotate_direction(data.rotation, SOUTH), 8)
}

// `traverseTurn`.
fn turn(p: mut Placer, data: mut Walker) {
    data.at = rel(data.at, rotate_direction(data.rotation, SOUTH), -1)
    p.add("wall_corner", data.at, data.rotation, MIRROR_NONE)
    data.at = rel(data.at, rotate_direction(data.rotation, SOUTH), -7)
    data.at = rel(data.at, rotate_direction(data.rotation, WEST), -6)
    data.rotation = turned(data.rotation, CLOCKWISE_90)
}

// `traverseInnerTurn`.
fn inner_turn(data: mut Walker) {
    data.at = rel(data.at, rotate_direction(data.rotation, SOUTH), 6)
    data.at = rel(data.at, rotate_direction(data.rotation, EAST), 8)
    data.rotation = turned(data.rotation, COUNTERCLOCKWISE_90)
}

// `createRoof`: roofs over the grid's cells that have no floor above, their edges and corners,
// and low walls round the cells that do.
fn roof(p: mut Placer, origin: Pos, rotation: i32, g: Grid, above_grid: Grid?) {
    let east = rotate_direction(rotation, EAST)
    let south = rotate_direction(rotation, SOUTH)
    let west = rotate_direction(rotation, WEST)
    let north = rotate_direction(rotation, NORTH)
    for y in 0..g.height {
        for x in 0..g.width {
            let at = p.cell(origin, rotation, x, y)
            let is_above = if let a = above_grid { is_house(a, x, y) } else { false }
            if is_house(g, x, y) and not is_above {
                p.add("roof", above(at, 3), rotation, MIRROR_NONE)
                if not is_house(g, x + 1, y) {
                    p.add("roof_front", rel(at, east, 6), rotation, MIRROR_NONE)
                }
                if not is_house(g, x - 1, y) {
                    p.add("roof_front", rel(rel(at, east, 0), south, 7), turned(rotation, CLOCKWISE_180), MIRROR_NONE)
                }
                if not is_house(g, x, y - 1) {
                    p.add("roof_front", rel(at, west, 1), turned(rotation, COUNTERCLOCKWISE_90), MIRROR_NONE)
                }
                if not is_house(g, x, y + 1) {
                    p.add("roof_front", rel(rel(at, east, 6), south, 6), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
                }
            }
        }
    }
    if let a = above_grid {
        for y in 0..g.height {
            for x in 0..g.width {
                let at = p.cell(origin, rotation, x, y)
                if not (is_house(g, x, y) and is_house(a, x, y)) {
                    continue
                }
                if not is_house(g, x + 1, y) {
                    p.add("small_wall", rel(at, east, 7), rotation, MIRROR_NONE)
                }
                if not is_house(g, x - 1, y) {
                    p.add("small_wall", rel(rel(at, west, 1), south, 6), turned(rotation, CLOCKWISE_180), MIRROR_NONE)
                }
                if not is_house(g, x, y - 1) {
                    p.add("small_wall", rel(rel(at, west, 0), north, 1), turned(rotation, COUNTERCLOCKWISE_90), MIRROR_NONE)
                }
                if not is_house(g, x, y + 1) {
                    p.add("small_wall", rel(rel(at, east, 6), south, 7), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
                }
                if not is_house(g, x + 1, y) {
                    if not is_house(g, x, y - 1) {
                        p.add("small_wall_corner", rel(rel(at, east, 7), north, 2), rotation, MIRROR_NONE)
                    }
                    if not is_house(g, x, y + 1) {
                        p.add("small_wall_corner", rel(rel(at, east, 8), south, 7), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
                    }
                }
                if not is_house(g, x - 1, y) {
                    if not is_house(g, x, y - 1) {
                        p.add("small_wall_corner", rel(rel(at, west, 2), north, 1), turned(rotation, COUNTERCLOCKWISE_90), MIRROR_NONE)
                    }
                    if not is_house(g, x, y + 1) {
                        p.add("small_wall_corner", rel(rel(at, west, 1), south, 8), turned(rotation, CLOCKWISE_180), MIRROR_NONE)
                    }
                }
            }
        }
    }
    for y in 0..g.height {
        for x in 0..g.width {
            let at = p.cell(origin, rotation, x, y)
            let is_above = if let a = above_grid { is_house(a, x, y) } else { false }
            if not is_house(g, x, y) or is_above {
                continue
            }
            if not is_house(g, x + 1, y) {
                let p2 = rel(at, east, 6)
                if not is_house(g, x, y + 1) {
                    p.add("roof_corner", rel(p2, south, 6), rotation, MIRROR_NONE)
                } else if is_house(g, x + 1, y + 1) {
                    p.add("roof_inner_corner", rel(p2, south, 5), rotation, MIRROR_NONE)
                }
                if not is_house(g, x, y - 1) {
                    p.add("roof_corner", p2, turned(rotation, COUNTERCLOCKWISE_90), MIRROR_NONE)
                } else if is_house(g, x + 1, y - 1) {
                    p.add("roof_inner_corner", rel(rel(at, east, 9), north, 2), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
                }
            }
            if not is_house(g, x - 1, y) {
                let p2 = rel(rel(at, east, 0), south, 0)
                if not is_house(g, x, y + 1) {
                    p.add("roof_corner", rel(p2, south, 6), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
                } else if is_house(g, x - 1, y + 1) {
                    p.add("roof_inner_corner", rel(rel(p2, south, 8), west, 3), turned(rotation, COUNTERCLOCKWISE_90), MIRROR_NONE)
                }
                if not is_house(g, x, y - 1) {
                    p.add("roof_corner", p2, turned(rotation, CLOCKWISE_180), MIRROR_NONE)
                } else if is_house(g, x - 1, y - 1) {
                    p.add("roof_inner_corner", rel(p2, south, 1), turned(rotation, CLOCKWISE_180), MIRROR_NONE)
                }
            }
        }
    }
}

// The floors' rooms, as `FirstFloorRoomCollection` and `SecondFloorRoomCollection` name them;
// the third floor's are the second's.
fn name_1x1(random: mut WorldgenRandom<LegacyRandom>, floor: i32) -> String {
    if floor == 0 {
        return "1x1_a{random.next_int_below(5) + 1}"
    }
    return "1x1_b{random.next_int_below(5) + 1}"
}

fn name_1x1_secret(random: mut WorldgenRandom<LegacyRandom>) -> String {
    return "1x1_as{random.next_int_below(4) + 1}"
}

fn name_1x2_side(random: mut WorldgenRandom<LegacyRandom>, floor: i32, stairs: bool) -> String {
    if floor == 0 {
        return "1x2_a{random.next_int_below(9) + 1}"
    }
    if stairs {
        return String("1x2_c_stairs")
    }
    return "1x2_c{random.next_int_below(4) + 1}"
}

fn name_1x2_front(random: mut WorldgenRandom<LegacyRandom>, floor: i32, stairs: bool) -> String {
    if floor == 0 {
        return "1x2_b{random.next_int_below(5) + 1}"
    }
    if stairs {
        return String("1x2_d_stairs")
    }
    return "1x2_d{random.next_int_below(5) + 1}"
}

fn name_1x2_secret(random: mut WorldgenRandom<LegacyRandom>, floor: i32) -> String {
    if floor == 0 {
        return "1x2_s{random.next_int_below(2) + 1}"
    }
    return "1x2_se{random.next_int_below(1) + 1}"
}

fn name_2x2(random: mut WorldgenRandom<LegacyRandom>, floor: i32) -> String {
    if floor == 0 {
        return "2x2_a{random.next_int_below(4) + 1}"
    }
    return "2x2_b{random.next_int_below(5) + 1}"
}

// `addRoom1x1`.
fn room_1x1(p: mut Placer, random: mut WorldgenRandom<LegacyRandom>, room_at: Pos, rotation: i32, door: i32, floor: i32) {
    var piece_rot = ROTATION_NONE
    var name = name_1x1(mut random, floor)
    if door != EAST {
        if door == NORTH {
            piece_rot = turned(piece_rot, COUNTERCLOCKWISE_90)
        } else if door == WEST {
            piece_rot = turned(piece_rot, CLOCKWISE_180)
        } else if door == SOUTH {
            piece_rot = turned(piece_rot, CLOCKWISE_90)
        } else {
            name = name_1x1_secret(mut random)
        }
    }
    // `getZeroPositionWithTransform((1, 0, 0), NONE, pieceRot, 7, 7)`, turned by the mansion's.
    let (zx, zz) = match piece_rot {
        3 => (1, 6),
        1 => (7, 0),
        2 => (7, 6),
        _ => (1, 0),
    }
    let (ox, oz) = match rotation {
        1 => (-zz, zx),
        2 => (-zx, -zz),
        3 => (zz, -zx),
        _ => (zx, zz),
    }
    p.add_named(name, Pos { x: room_at.x + ox, y: room_at.y, z: room_at.z + oz }, turned(piece_rot, rotation), MIRROR_NONE)
}

// `addRoom1x2`.
fn room_1x2(p: mut Placer, random: mut WorldgenRandom<LegacyRandom>, room_at: Pos, rotation: i32, room_dir: i32, door: i32, floor: i32, stairs: bool) {
    let east = rotate_direction(rotation, EAST)
    let south = rotate_direction(rotation, SOUTH)
    let west = rotate_direction(rotation, WEST)
    let north = rotate_direction(rotation, NORTH)
    if door == EAST and room_dir == SOUTH {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(room_at, east, 1), rotation, MIRROR_NONE)
    } else if door == EAST and room_dir == NORTH {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(rel(room_at, east, 1), south, 6), rotation, LEFT_RIGHT)
    } else if door == WEST and room_dir == NORTH {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(rel(room_at, east, 7), south, 6), turned(rotation, CLOCKWISE_180), MIRROR_NONE)
    } else if door == WEST and room_dir == SOUTH {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(room_at, east, 7), rotation, FRONT_BACK)
    } else if door == SOUTH and room_dir == EAST {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(room_at, east, 1), turned(rotation, CLOCKWISE_90), LEFT_RIGHT)
    } else if door == SOUTH and room_dir == WEST {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(room_at, east, 7), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
    } else if door == NORTH and room_dir == WEST {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(rel(room_at, east, 7), south, 6), turned(rotation, CLOCKWISE_90), FRONT_BACK)
    } else if door == NORTH and room_dir == EAST {
        p.add_named(name_1x2_side(mut random, floor, stairs), rel(rel(room_at, east, 1), south, 6), turned(rotation, COUNTERCLOCKWISE_90), MIRROR_NONE)
    } else if door == SOUTH and room_dir == NORTH {
        p.add_named(name_1x2_front(mut random, floor, stairs), rel(rel(room_at, east, 1), north, 8), rotation, MIRROR_NONE)
    } else if door == NORTH and room_dir == SOUTH {
        p.add_named(name_1x2_front(mut random, floor, stairs), rel(rel(room_at, east, 7), south, 14), turned(rotation, CLOCKWISE_180), MIRROR_NONE)
    } else if door == WEST and room_dir == EAST {
        p.add_named(name_1x2_front(mut random, floor, stairs), rel(room_at, east, 15), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
    } else if door == EAST and room_dir == WEST {
        p.add_named(name_1x2_front(mut random, floor, stairs), rel(rel(room_at, west, 7), south, 6), turned(rotation, COUNTERCLOCKWISE_90), MIRROR_NONE)
    } else if door == UP and room_dir == EAST {
        p.add_named(name_1x2_secret(mut random, floor), rel(room_at, east, 15), turned(rotation, CLOCKWISE_90), MIRROR_NONE)
    } else if door == UP and room_dir == SOUTH {
        p.add_named(name_1x2_secret(mut random, floor), rel(rel(room_at, east, 1), north, 0), rotation, MIRROR_NONE)
    }
}

// `addRoom2x2`.
fn room_2x2(p: mut Placer, random: mut WorldgenRandom<LegacyRandom>, room_at: Pos, rotation: i32, room_dir: i32, door: i32, floor: i32) {
    var east = 0
    var south = 0
    var rot = rotation
    var mirror = MIRROR_NONE
    if door == EAST and room_dir == SOUTH {
        east = -7
    } else if door == EAST and room_dir == NORTH {
        east = -7
        south = 6
        mirror = LEFT_RIGHT
    } else if door == NORTH and room_dir == EAST {
        east = 1
        south = 14
        rot = turned(rotation, COUNTERCLOCKWISE_90)
    } else if door == NORTH and room_dir == WEST {
        east = 7
        south = 14
        rot = turned(rotation, COUNTERCLOCKWISE_90)
        mirror = LEFT_RIGHT
    } else if door == SOUTH and room_dir == WEST {
        east = 7
        south = -8
        rot = turned(rotation, CLOCKWISE_90)
    } else if door == SOUTH and room_dir == EAST {
        east = 1
        south = -8
        rot = turned(rotation, CLOCKWISE_90)
        mirror = LEFT_RIGHT
    } else if door == WEST and room_dir == NORTH {
        east = 15
        south = 6
        rot = turned(rotation, CLOCKWISE_180)
    } else if door == WEST and room_dir == SOUTH {
        east = 15
        mirror = FRONT_BACK
    }
    let at = rel(rel(room_at, rotate_direction(rotation, EAST), east), rotate_direction(rotation, SOUTH), south)
    p.add_named(name_2x2(mut random, floor), at, rot, mirror)
}
