/// Climate: the six values a biome is chosen by, and the lists of biomes that choose by them,
/// as vanilla's `Climate` has them. A list is searched through the tree vanilla builds of it, so
/// where two entries fit a point as well as each other, the one found first is the one vanilla
/// finds: which depends on the last one found, as vanilla's search starts from it.
module worldgen.climate

/// The values a point has: temperature, humidity, continentalness, erosion, depth and weirdness,
/// then 0 for an entry's offset, each as `quantize` makes it.
pub struct Target {
    pub values: [i64; 7]
}

/// `Climate.quantizeCoord`: a value as a whole number of ten-thousandths, truncated, as Java
/// casts a `float` to a `long`.
pub fn quantize(v: f32) -> i64 {
    return i64.saturate(v * 10000.0f32)
}

/// `Climate.target`.
pub fn target(temperature: f32, humidity: f32, continentalness: f32, erosion: f32, depth: f32, weirdness: f32) -> Target {
    return Target { values: [quantize(temperature), quantize(humidity), quantize(continentalness), quantize(erosion), quantize(depth), quantize(weirdness), 0] }
}

/// `Climate.Parameter`: a range of one value, its ends included.
pub struct Parameter {
    pub min: i64
    pub max: i64
}

/// `Parameter.span(float, float)`, for ends that are known to be in order.
pub fn span(min: f32, max: f32) -> Parameter {
    return Parameter { min: quantize(min), max: quantize(max) }
}

/// `Parameter.point`.
pub fn point(v: f32) -> Parameter {
    return span(v, v)
}

/// `Parameter.span(Parameter, Parameter)`: from the first's start to the second's end.
pub fn join(a: Parameter, b: Parameter) -> Parameter {
    return Parameter { min: a.min, max: b.max }
}

/// `Climate.ParameterPoint`: where an entry fits, the six ranges and its offset, which counts
/// against it as a distance along a seventh value that's always 0.
pub struct Point {
    pub mins: [i64; 7]
    pub maxs: [i64; 7]
}

/// A point from its six ranges and its offset, quantized.
pub fn point_of(temperature: Parameter, humidity: Parameter, continentalness: Parameter, erosion: Parameter, depth: Parameter, weirdness: Parameter, offset: i64) -> Point {
    return Point {
        mins: [temperature.min, humidity.min, continentalness.min, erosion.min, depth.min, weirdness.min, offset],
        maxs: [temperature.max, humidity.max, continentalness.max, erosion.max, depth.max, weirdness.max, offset],
    }
}

/// A point's offset.
pub fn offset_of(p: Point) -> i64 {
    return p.mins[6]
}

/// How many children a node of the tree has at most.
const CHILDREN: usize = 19

/// `Climate.RTree`: the entries' points as leaves, nodes 0 to n - 1, then the nodes that hold
/// them, each with the box its children fill.
pub struct Tree {
    // Each node's ranges, seven to a node, while the tree is built.
    mins: List<i64>
    maxs: List<i64>
    // A node's children are `kids[first[n]..first[n] + count[n]]`; a leaf has none.
    first: List<i32>
    count: List<i32>
    kids: List<i32>
    root: i32
    // The boxes of each node's children as the search reads them, a node's children together,
    // `WIDE` of each, so that one pass works out how far every child is (D250): from
    // `boxes_at[n]`, each child's part of its distance from a target along the offset, which
    // is 0 in every target, then for each of the seven values the children's least values and
    // then their greatest.
    boxes: List<i64> = List<i64>()
    boxes_at: List<u32> = List<u32>()
    // Where a leaf's part along the offset is in `boxes`; its least value of the first value
    // is `WIDE` after it, the rest `WIDE * 2` apart, and its greatest values `WIDE` after those.
    leaf_at: List<u32> = List<u32>()
}

/// How many children a node's boxes have room for: `CHILDREN` and one more, so that a pass over
/// them is five steps of four.
const WIDE: usize = 20

/// A node with its sort key: seven values compared in turn, equal keys kept in the order they
/// were in, as Java's `List.sort` keeps them.
struct Keyed {
    key: [i64; 7]
    node: i32
}

impl Order for Keyed {
    fn cmp(self, other: Self) -> Ordering {
        let seven: usize = 7
        for d in 0..seven {
            let c = self.key[d].cmp(other.key[d])
            if c != Ordering.Equal {
                return c
            }
        }
        return Ordering.Equal
    }
}

impl Tree {
    /// The tree of `points`, as `RTree.create` builds it with 19 children to a node; `points`
    /// mustn't be empty.
    pub fn new(points: List<Point>) -> Tree {
        var tree = Tree { mins: List<i64>(), maxs: List<i64>(), first: List<i32>(), count: List<i32>(), kids: List<i32>(), root: 0 }
        let n = points.len()
        tree.mins.reserve(n * 14)
        tree.maxs.reserve(n * 14)
        var leaves = List<i32>()
        for i in 0..n {
            let seven: usize = 7
            for d in 0..seven {
                tree.mins.push(points[i].mins[d])
                tree.maxs.push(points[i].maxs[d])
            }
            tree.first.push(0)
            tree.count.push(0)
            leaves.push(i32.wrap(i))
        }
        tree.root = tree.build(leaves)
        let nodes = tree.count.len()
        tree.leaf_at = [0u32; n]
        for node in 0..nodes {
            let k = usize.wrap(tree.count[node])
            tree.boxes_at.push(u32.wrap(tree.boxes.len()))
            if k == 0 {
                continue
            }
            let base = tree.boxes.len()
            let first = usize.wrap(tree.first[node])
            for j in 0..WIDE {
                var part: i64 = 0
                if j < k {
                    let c = usize.wrap(tree.kids[first + j]) * 7 + 6
                    let a = offset_away(tree.mins[c], tree.maxs[c])
                    part = a * a
                }
                tree.boxes.push(part)
            }
            let seven: usize = 7
            for d in 0..seven {
                for j in 0..WIDE {
                    tree.boxes.push(if j < k { tree.mins[usize.wrap(tree.kids[first + j]) * 7 + d] } else { 0 })
                }
                for j in 0..WIDE {
                    tree.boxes.push(if j < k { tree.maxs[usize.wrap(tree.kids[first + j]) * 7 + d] } else { 0 })
                }
            }
            for j in 0..k {
                let child = usize.wrap(tree.kids[first + j])
                if tree.count[child] == 0 {
                    tree.leaf_at[child] = u32.wrap(base + j)
                }
            }
        }
        // Only building reads the ranges as lists.
        tree.mins = List<i64>()
        tree.maxs = List<i64>()
        return tree
    }

    /// A tree of nothing, for a source with no list; searching it finds nothing.
    pub fn empty() -> Tree {
        return Tree { mins: List<i64>(), maxs: List<i64>(), first: List<i32>(), count: List<i32>(), kids: List<i32>(), root: -1 }
    }

    /// `RTree.build`: one node for `children`, all leaves.
    fn build(mut self, children: List<i32>) -> i32 {
        if children.len() == 1 {
            return children[0]
        }
        if children.len() <= CHILDREN {
            // A node's own children go nearest the middle of the space first.
            var keyed = List<Keyed>()
            for c in children {
                keyed.push(Keyed { key: [self.magnitude(c), 0, 0, 0, 0, 0, 0], node: c })
            }
            keyed.sort()
            var sorted = List<i32>()
            for k in keyed {
                sorted.push(k.node)
            }
            return self.node(sorted)
        }
        // Otherwise the children are split into buckets along whichever value gives buckets
        // with the least room in them, as a whole. Sorting each time from the order given is
        // the same as vanilla's sorting each time from the last sort's: keys compare all seven
        // values, so children that tie, tie in every sort, and keep the order they came in.
        var least = i64.MAX
        var best_dimension: usize = 0
        var best = List<List<i32>>()
        let seven: usize = 7
        for d in 0..seven {
            let sorted = self.sorted(children, d, false)
            let buckets = bucketize(sorted)
            var cost: i64 = 0
            for b in buckets {
                cost += self.cost(b)
            }
            if least > cost {
                least = cost
                best_dimension = d
                best = buckets
            }
        }
        // The buckets go nearest the middle first, along that value, then the next.
        var keyed = List<Keyed>()
        for i in 0..best.len() {
            var key: [i64; 7] = [0; 7]
            for k in 0..seven {
                let d = (best_dimension + k) % 7
                var lo = i64.MAX
                var hi = i64.MIN
                for c in best[i] {
                    let at = usize.wrap(c) * 7 + d
                    lo = lo.min(self.mins[at])
                    hi = hi.max(self.maxs[at])
                }
                key[k] = ((lo + hi) / 2).abs()
            }
            keyed.push(Keyed { key: key, node: i32.wrap(i) })
        }
        keyed.sort()
        var built = List<i32>()
        for k in keyed {
            built.push(self.build(best[usize.wrap(k.node)]))
        }
        return self.node(built)
    }

    /// `children` sorted by the middles of their ranges along `dimension`, then the next, and
    /// so on round all seven.
    fn sorted(self, children: List<i32>, dimension: usize, absolute: bool) -> List<i32> {
        var keyed = List<Keyed>()
        keyed.reserve(children.len())
        let seven: usize = 7
        for c in children {
            var key: [i64; 7] = [0; 7]
            let base = usize.wrap(c) * 7
            for k in 0..seven {
                let d = (dimension + k) % 7
                let center = (self.mins[base + d] + self.maxs[base + d]) / 2
                key[k] = if absolute { center.abs() } else { center }
            }
            keyed.push(Keyed { key: key, node: c })
        }
        keyed.sort()
        var out = List<i32>()
        out.reserve(children.len())
        for k in keyed {
            out.push(k.node)
        }
        return out
    }

    /// How far a leaf's ranges are from the middle of the space, summed.
    fn magnitude(self, node: i32) -> i64 {
        var total: i64 = 0
        let base = usize.wrap(node) * 7
        let seven: usize = 7
        for d in 0..seven {
            total += ((self.mins[base + d] + self.maxs[base + d]) / 2).abs()
        }
        return total
    }

    /// `RTree.cost` of the box that `children` fill.
    fn cost(self, children: List<i32>) -> i64 {
        var total: i64 = 0
        let seven: usize = 7
        for d in 0..seven {
            var lo = i64.MAX
            var hi = i64.MIN
            for c in children {
                let at = usize.wrap(c) * 7 + d
                lo = lo.min(self.mins[at])
                hi = hi.max(self.maxs[at])
            }
            total += (hi - lo).abs()
        }
        return total
    }

    /// A node holding `children`, in that order, with the box they fill.
    fn node(mut self, children: List<i32>) -> i32 {
        let id = i32.wrap(self.count.len())
        let seven: usize = 7
        for d in 0..seven {
            var lo = i64.MAX
            var hi = i64.MIN
            for c in children {
                let at = usize.wrap(c) * 7 + d
                lo = lo.min(self.mins[at])
                hi = hi.max(self.maxs[at])
            }
            self.mins.push(lo)
            self.maxs.push(hi)
        }
        self.first.push(i32.wrap(self.kids.len()))
        self.count.push(i32.wrap(children.len()))
        for c in children {
            self.kids.push(c)
        }
        return id
    }

    /// `Node.distance` of a leaf: the squares of how far `t` is outside its box along each
    /// value, summed, wrapping as Java's `long` does.
    fn leaf_distance(self, leaf: i32, t: Target) -> i64 {
        let at = usize(self.leaf_at[usize.wrap(leaf)]) + WIDE
        var total: i64 = 0
        let seven: usize = 7
        for d in 0..seven {
            let above = t.values[d] - self.boxes[at + d * WIDE * 2 + WIDE]
            let below = self.boxes[at + d * WIDE * 2] - t.values[d]
            let away = if above > 0 { above } else if below > 0 { below } else { 0 }
            total += away * away
        }
        return total
    }

    /// `RTree.search`: the leaf nearest `t`, starting from `last`, the leaf found last or -1,
    /// which it then sets to the leaf found. Gives -1 if no leaf is nearer than `i64.MAX`, where
    /// vanilla throws.
    pub fn search(self, t: Target, last: mut i32) -> i32 {
        if self.root < 0 {
            return -1
        }
        if self.count[usize.wrap(self.root)] == 0 {
            last = self.root
            return self.root
        }
        // Vanilla works out how far the leaf found so far is at each node it searches; it's
        // the nearest found, so it's carried down instead (D250).
        var least = if last < 0 { i64.MAX } else { self.leaf_distance(last, t) }
        let found = self.search_in(usize.wrap(self.root), t, last, mut least)
        last = found
        return found
    }

    // `Node.search` of the node `node`, which has children, with `candidate` the leaf found so
    // far and `least` how far it is, `i64.MAX` for none; `least` becomes how far the leaf it
    // gives is.
    fn search_in(self, node: usize, t: Target, candidate: i32, least: mut i64) -> i32 {
        // How far each child is, all at once: the sums `Node.distance` works out for each, which
        // wrap, so their order doesn't matter. The offset's part was worked out as the tree was
        // built, and a square is one 32-bit multiply while every child is less than 2^32 away
        // along every value, as real climates are; otherwise the node is worked out again whole.
        var away: [i64; 20] = [0; 20]
        unsafe {
            let p = self.boxes.as_ptr().add(usize(self.boxes_at[node]))
            for j in 0..WIDE {
                away[j] = p.add(j).read()
            }
            var outside: i64 = 0
            let six: usize = 6
            for d in 0..six {
                let v = t.values[d]
                let lo = p.add(WIDE + d * WIDE * 2)
                let hi = lo.add(WIDE)
                for j in 0..WIDE {
                    let above = v - hi.add(j).read()
                    let below = lo.add(j).read() - v
                    let a = if above > 0 { above } else if below > 0 { below } else { 0 }
                    outside |= a
                    let low = a & 0xFFFFFFFF
                    away[j] += low * low
                }
            }
            if outside >> 32 != 0 or t.values[6] != 0 {
                let seven: usize = 7
                for j in 0..WIDE {
                    away[j] = 0
                }
                for d in 0..seven {
                    let v = t.values[d]
                    let lo = p.add(WIDE + d * WIDE * 2)
                    let hi = lo.add(WIDE)
                    for j in 0..WIDE {
                        let above = v - hi.add(j).read()
                        let below = lo.add(j).read() - v
                        let a = if above > 0 { above } else if below > 0 { below } else { 0 }
                        away[j] += a * a
                    }
                }
            }
        }
        var closest = candidate
        let start = usize.wrap(self.first[node])
        let k = usize.wrap(self.count[node])
        for j in 0..k {
            if least > away[j] {
                let child = self.kids[start + j]
                let c = usize.wrap(child)
                if self.count[c] == 0 {
                    least = away[j]
                    closest = child
                } else {
                    // A child gives back the leaf it's given unless it finds a nearer one.
                    closest = self.search_in(c, t, closest, mut least)
                }
            }
        }
        return closest
    }
}

// How far 0, a target's offset, is outside a range, as `Node.distance` works it out.
fn offset_away(lo: i64, hi: i64) -> i64 {
    let above = 0 - hi
    return if above > 0 { above } else if lo > 0 { lo } else { 0 }
}

/// `RTree.bucketize`: `nodes` cut into runs of the largest power of 19 below their count, and
/// what's left.
fn bucketize(nodes: List<i32>) -> List<List<i32>> {
    // `(int) Math.pow(19, Math.floor(Math.log(n - 0.01) / Math.log(19)))`: n is a whole number,
    // so n - 0.01 is never within rounding of a power of 19, and this is exact.
    var expected: usize = 1
    while expected * CHILDREN < nodes.len() {
        expected *= CHILDREN
    }
    var buckets = List<List<i32>>()
    var bucket = List<i32>()
    for node in nodes {
        bucket.push(node)
        if bucket.len() >= expected {
            buckets.push(bucket)
            bucket = List<i32>()
        }
    }
    if bucket.len() > 0 {
        buckets.push(bucket)
    }
    return buckets
}
