/// Vanilla's `Interval`: the range of values a noise or a density function can give, which
/// worldgen works out once, as it makes them, in `f32`. Bounds are computed with vanilla's
/// operations in vanilla's order, so they're the same bits, and where vanilla throws, these
/// fail with the same exception and message.
module worldgen.interval

import std.java.math.{log, pow}

/// An exception vanilla throws: its class's simple name and its message.
pub struct Thrown {
    pub exception: String
    pub message: String
}

/// A range from `min` to `max`, both included, or `NaI`, not an interval, where vanilla's
/// arithmetic gave NaN.
pub struct Interval {
    pub min: f32
    pub max: f32
    invalid: bool = false
}

fn illegal_argument(message: own String) -> Thrown {
    return Thrown { exception: "IllegalArgumentException", message: message }
}

impl Interval {
    /// `Interval.NaI`.
    pub fn nai() -> Interval {
        return Interval { min: f32.NAN, max: f32.NAN, invalid: true }
    }

    /// `Interval.INFINITE`.
    pub fn infinite() -> Interval {
        return Interval { min: -f32.INFINITY, max: f32.INFINITY }
    }

    /// `Interval.of`, which throws on `max < min` and on a NaN bound.
    pub fn of(min: f32, max: f32) -> Interval ! Thrown {
        if max < min {
            fail illegal_argument("max ({max}) < min ({min})")
        }
        if min.is_nan() or max.is_nan() {
            fail illegal_argument("Bounds cannot include NaN [{min}; {max}]: use Interval.NaI explicitly")
        }
        return Interval { min: min, max: max }
    }

    pub fn symmetric(range: f32) -> Interval ! Thrown {
        return try Interval.of(-range, range)
    }

    pub fn exact(value: f32) -> Interval ! Thrown {
        return try Interval.of(value, value)
    }

    pub fn is_nai(self) -> bool {
        return self.invalid
    }

    pub fn contains(self, value: f32) -> bool {
        return value >= self.min and value <= self.max
    }

    /// `Interval.encapsulating(List)`: the least interval holding all of them, those that are
    /// NaI left out.
    pub fn encapsulating(intervals: List<Interval>) -> Interval ! Thrown {
        if intervals.is_empty() {
            fail illegal_argument("At least one interval required")
        }
        var min = f32.INFINITY
        var max = -f32.INFINITY
        for i in intervals {
            if not i.invalid {
                min = i.min.min(min)
                max = i.max.max(max)
            }
        }
        if max < min {
            return Interval.nai()
        }
        return try Interval.of(min, max)
    }

    /// `Interval.encapsulating(float, float)`: a NaN one left out.
    pub fn around(first: f32, second: f32) -> Interval ! Thrown {
        if first.is_nan() and second.is_nan() {
            return Interval.nai()
        }
        if first.is_nan() {
            return try Interval.exact(second)
        }
        if second.is_nan() {
            return try Interval.exact(first)
        }
        return try Interval.of(first.min(second), first.max(second))
    }

    /// The private `Interval.encapsulating(Interval, float)`.
    fn with(self, second: f32) -> Interval ! Thrown {
        if second.is_nan() {
            return self
        }
        if self.invalid {
            return try Interval.exact(second)
        }
        return try Interval.of(self.min.min(second), self.max.max(second))
    }

    /// `Interval.add`.
    pub fn add(self, other: Interval) -> Interval ! Thrown {
        let min = self.min + other.min
        let max = self.max + other.max
        if min.is_nan() or max.is_nan() {
            return Interval.nai()
        }
        return try Interval.of(min, max)
    }

    /// `Interval.sub`.
    pub fn sub(self, other: Interval) -> Interval ! Thrown {
        let min = self.min - other.max
        let max = self.max - other.min
        if min.is_nan() or max.is_nan() {
            return Interval.nai()
        }
        return try Interval.of(min, max)
    }

    /// `Interval.mul`: the least and greatest of the four products, where a zero bound times
    /// anything is zero, even an infinity.
    pub fn mul(self, other: Interval) -> Interval ! Thrown {
        if self.invalid or other.invalid {
            return Interval.nai()
        }
        let a = mul_bound(self.min, other.min)
        let b = mul_bound(self.min, other.max)
        let c = mul_bound(self.max, other.min)
        let d = mul_bound(self.max, other.max)
        return try Interval.of(a.min(b).min(c.min(d)), a.max(b).max(c.max(d)))
    }

    /// `Interval.reciprocal`.
    pub fn reciprocal(self) -> Interval ! Thrown {
        if self.invalid or (self.min == 0.0f32 and self.max == 0.0f32) {
            return Interval.nai()
        }
        if not self.contains(0.0f32) {
            return try Interval.of(1.0f32 / self.max, 1.0f32 / self.min)
        }
        if self.max == 0.0f32 {
            return try Interval.of(-f32.INFINITY, 1.0f32 / self.min)
        }
        if self.min == 0.0f32 {
            return try Interval.of(1.0f32 / self.max, f32.INFINITY)
        }
        return Interval.infinite()
    }

    pub fn div(self, other: Interval) -> Interval ! Thrown {
        return try self.mul(try other.reciprocal())
    }

    pub fn min_of(self, other: Interval) -> Interval ! Thrown {
        if self.invalid or other.invalid {
            return Interval.nai()
        }
        return try Interval.of(self.min.min(other.min), self.max.min(other.max))
    }

    pub fn max_of(self, other: Interval) -> Interval ! Thrown {
        if self.invalid or other.invalid {
            return Interval.nai()
        }
        return try Interval.of(self.min.max(other.min), self.max.max(other.max))
    }

    /// `Interval.clamp`.
    pub fn clamp(self, min: f32, max: f32) -> Interval ! Thrown {
        if min > max {
            fail illegal_argument("min ({min}) > max ({max})")
        }
        if self.invalid {
            return Interval.nai()
        }
        if self.min >= max {
            return try Interval.of(max, max)
        }
        if self.max <= min {
            return try Interval.of(min, min)
        }
        return try Interval.of(self.min.max(min), self.max.min(max))
    }

    pub fn abs(self) -> Interval ! Thrown {
        if self.invalid {
            return Interval.nai()
        }
        let max = self.min.abs().max(self.max.abs())
        if self.contains(0.0f32) {
            return try Interval.of(0.0f32, max)
        }
        return try Interval.of(self.min.abs().min(self.max.abs()), max)
    }

    pub fn square(self) -> Interval ! Thrown {
        if self.invalid {
            return Interval.nai()
        }
        let lo = self.min * self.min
        let hi = self.max * self.max
        let max = lo.max(hi)
        if self.contains(0.0f32) {
            return try Interval.of(0.0f32, max)
        }
        return try Interval.of(lo.min(hi), max)
    }

    /// `Interval.mapMonotonic` once the caller has mapped both bounds of an interval that isn't
    /// NaI: vanilla throws if either is NaN.
    pub fn mapped(a: f32, b: f32) -> Interval ! Thrown {
        if a.is_nan() or b.is_nan() {
            fail Thrown { exception: "IllegalStateException", message: "Monotonic operator should not produce NaN" }
        }
        return try Interval.of(a.min(b), a.max(b))
    }

    /// `Interval.log`.
    pub fn log(self) -> Interval ! Thrown {
        if self.max < 0.0f32 {
            return Interval.nai()
        }
        let clipped = try self.max_of(try Interval.exact(0.0f32))
        if clipped.invalid {
            return Interval.nai()
        }
        return try Interval.mapped(java_log(clipped.min), java_log(clipped.max))
    }

    /// `Interval.pow`.
    pub fn pow(self, exponent: Interval) -> Interval ! Thrown {
        if self.invalid or exponent.invalid {
            return Interval.nai()
        }
        if self.min == self.max {
            return try pow_of(self.min, exponent)
        }
        var result = try Interval.encapsulating([try pow_of(self.min, exponent), try pow_of(self.max, exponent)])
        if self.contains(0.0f32) {
            if self.max > 0.0f32 {
                result = try Interval.encapsulating([result, try pow_of(0.0f32, exponent)])
            }
            if self.min < 0.0f32 {
                result = try Interval.encapsulating([result, try pow_of(-0.0f32, exponent)])
            }
        }
        return result
    }

    /// `Interval.lerp(Interval, Interval, Interval)`.
    pub fn lerp(alpha: Interval, first: Interval, second: Interval) -> Interval ! Thrown {
        if alpha.invalid or first.invalid or second.invalid {
            return Interval.nai()
        }
        return try Interval.encapsulating([
            try lerp_bounds(alpha, first.min, second.min),
            try lerp_bounds(alpha, first.max, second.min),
            try lerp_bounds(alpha, first.min, second.max),
            try lerp_bounds(alpha, first.max, second.max),
        ])
    }

    /// `Interval.sign`.
    pub fn sign(self) -> Interval ! Thrown {
        if self.invalid {
            return Interval.nai()
        }
        if self.min == self.max {
            return try Interval.exact(signum(self.min))
        }
        if self.contains(0.0f32) {
            if self.min == 0.0f32 {
                return try Interval.of(0.0f32, 1.0f32)
            }
            if self.max == 0.0f32 {
                return try Interval.of(-1.0f32, 0.0f32)
            }
            return try Interval.of(-1.0f32, 1.0f32)
        }
        return try Interval.exact(if self.min > 0.0f32 { 1.0f32 } else { -1.0f32 })
    }
}

fn mul_bound(left: f32, right: f32) -> f32 {
    if left != 0.0f32 and right != 0.0f32 {
        return left * right
    }
    return 0.0f32
}

/// `Math.signum(float)`: the sign as 1 or -1, and zeros and NaN as themselves.
pub fn signum(x: f32) -> f32 {
    if x > 0.0f32 {
        return 1.0f32
    }
    if x < 0.0f32 {
        return -1.0f32
    }
    return x
}

/// `(float) Math.log(x)`.
pub fn java_log(x: f32) -> f32 {
    return f32.nearest(log(f64(x)))
}

/// `(float) Math.pow(base, exponent)`, from two doubles.
pub fn java_pow(base: f64, exponent: f64) -> f32 {
    return f32.nearest(pow(base, exponent))
}

fn is_finite(x: f32) -> bool {
    return not x.is_nan() and x.abs() != f32.INFINITY
}

fn is_infinite(x: f32) -> bool {
    return x.abs() == f32.INFINITY
}

/// The private `Interval.pow(float, Interval)`.
fn pow_of(base: f32, exponent: Interval) -> Interval ! Thrown {
    if base.is_nan() or exponent.invalid {
        return Interval.nai()
    }
    if exponent.min == exponent.max {
        let value = java_pow(f64(base), f64(exponent.min))
        if value.is_nan() {
            return Interval.nai()
        }
        return try Interval.exact(value)
    }
    if base == 0.0f32 {
        // `Math.copySign(1.0F, base)`: -1 for -0.
        let sign = if base.to_bits() == 0u32 { 1.0f32 } else { -1.0f32 }
        return try (try pow_zero_base(exponent)).mul(try Interval.exact(sign))
    }
    if base == 1.0f32 {
        return try Interval.exact(1.0f32)
    }
    if base > 0.0f32 {
        if is_finite(exponent.min) and is_finite(exponent.max) {
            return try Interval.around(java_pow(f64(base), f64(exponent.min)), java_pow(f64(base), f64(exponent.max)))
        }
        return try pow_infinite_exponent(base, exponent)
    }
    return try pow_negative_base(base, exponent)
}

fn pow_zero_base(exponent: Interval) -> Interval ! Thrown {
    if exponent.contains(0.0f32) {
        if exponent.max == 0.0f32 {
            return try Interval.of(1.0f32, f32.INFINITY)
        }
        if exponent.min == 0.0f32 {
            return try Interval.of(0.0f32, 1.0f32)
        }
        return try Interval.of(0.0f32, f32.INFINITY)
    }
    if exponent.max < 0.0f32 {
        return try Interval.exact(f32.INFINITY)
    }
    return try Interval.exact(0.0f32)
}

fn pow_infinite_exponent(base: f32, exponent: Interval) -> Interval ! Thrown {
    if is_infinite(exponent.min) and is_infinite(exponent.max) {
        return try Interval.of(0.0f32, f32.INFINITY)
    }
    if is_infinite(exponent.min) {
        let p = java_pow(f64(base), f64(exponent.max))
        if base < 1.0f32 {
            return try Interval.of(p, f32.INFINITY)
        }
        return try Interval.of(0.0f32, p)
    }
    let p = java_pow(f64(base), f64(exponent.min))
    if base < 1.0f32 {
        return try Interval.of(0.0f32, p)
    }
    return try Interval.of(p, f32.INFINITY)
}

fn pow_negative_base(base: f32, exponent: Interval) -> Interval ! Thrown {
    let min_int = f32.nearest(f64(exponent.min).ceil())
    let max_int = f32.nearest(f64(exponent.max).floor())
    if max_int < min_int {
        return Interval.nai()
    }
    let to_min = java_pow(f64(base), f64(min_int))
    let to_max = java_pow(f64(base), f64(max_int))
    var result = try Interval.around(to_min, to_max)
    if is_infinite(min_int) {
        result = try result.with(-to_min)
    } else if min_int + 1.0f32 < max_int {
        result = try result.with(java_pow(f64(base), f64(min_int + 1.0f32)))
    }
    if is_infinite(max_int) {
        result = try result.with(-to_max)
    } else if max_int - 1.0f32 > min_int {
        result = try result.with(java_pow(f64(base), f64(max_int - 1.0f32)))
    }
    return result
}

/// `Interval.lerp(Interval, float, float)`.
fn lerp_bounds(alpha: Interval, first: f32, second: f32) -> Interval ! Thrown {
    if alpha.invalid or first.is_nan() or second.is_nan() {
        return Interval.nai()
    }
    if is_finite(first) and is_finite(second) {
        return try Interval.around(first + mul_bound(alpha.min, second - first), first + mul_bound(alpha.max, second - first))
    }
    if first == second {
        return try Interval.exact(first)
    }
    let lo = lerp_infinite_bound(alpha.min, first, second)
    let hi = lerp_infinite_bound(alpha.max, first, second)
    if lo.is_nan() or hi.is_nan() {
        return Interval.nai()
    }
    return try Interval.around(lo, hi)
}

fn lerp_infinite_bound(alpha: f32, first: f32, second: f32) -> f32 {
    let first_part = mul_bound(1.0f32 - alpha, first)
    let second_part = mul_bound(alpha, second)
    if not is_infinite(first_part) or not is_infinite(second_part) {
        return first_part + second_part
    }
    if alpha <= 0.0f32 {
        return if second > first { -f32.INFINITY } else { f32.INFINITY }
    }
    if alpha >= 1.0f32 {
        return if second > first { f32.INFINITY } else { -f32.INFINITY }
    }
    return f32.NAN
}
