/// Vanilla's cave features: speleothems (pointed dripstone and its kin) and their clusters,
/// large dripstone, and geodes, read as their codecs read them and placed as 26.3 places them.
module worldgen.caves

import json.tree.{Member}
import math.mth.{SinTable}
import pack.data.{Data}
import random.any.{AnyRandom}
import random.legacy.{LegacyRandom}
import random.source.{RandomSource}
import std.java.math.{log, pow}
import world.chunk.{WORLD_SURFACE_WG}
import worldgen.codec.{bool_of, double_of, field, float_range, float_range_field, int_of, int_range_field, map_of}
import worldgen.facts.{BlockSet, DOWN, EMPTY_FLUID, Facts, UP, direction_name, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.normal.{parity}
import worldgen.predicates.{Readers, list_of, read_blocks, read_state}
import worldgen.providers.{FloatProvider, IntProvider, between_inclusive, clamp_float, float_between, float_provider_field, gaussian, int_provider_field, read_int_range}
import worldgen.region.{Region}
import worldgen.state_providers.{Providers, get_state}
import worldgen.survive.{Env}

/// `(float) (Math.PI * 2)`.
const TWO_PI_F32: f32 = 6.2831855f32
/// `(float) Math.PI`.
const PI_F32: f32 = 3.1415927f32

/// A `speleothem`: a pointed block, one or two long, from a patch of its base block.
pub struct Speleothem {
    base: u32
    pointed: u32
    replaceable: BlockSet
    taller: f32
    directional: f32
    radius2: f32
    radius3: f32
}

/// A `speleothem_cluster`: columns of pointed blocks from floor and ceiling, with pools.
pub struct Cluster {
    base: u32
    pointed: u32
    replaceable: BlockSet
    search: i32
    height: IntProvider
    radius: IntProvider
    height_diff: i32
    deviation: i32
    thickness: IntProvider
    density: FloatProvider
    wetness: FloatProvider
    edge_chance: f32
    edge_distance: i32
    center_distance: i32
}

/// A `large_dripstone`: a thick stalactite and stalagmite, perhaps bent by wind.
pub struct LargeDripstone {
    replaceable: BlockSet
    search: i32
    radius: IntProvider
    scale: FloatProvider
    ratio: f32
    stalactite: FloatProvider
    stalagmite: FloatProvider
    wind: FloatProvider
    wind_radius: i32
    wind_bluntness: f32
}

/// A `geode`: shells of blocks around points, a crack, and crystals inside.
pub struct Geode {
    filling: usize
    inner: usize
    alternate: usize
    middle: usize
    outer: usize
    placements: List<u32>
    cannot_replace: BlockSet
    invalid: BlockSet
    filling_layer: f64
    inner_layer: f64
    middle_layer: f64
    outer_layer: f64
    crack_chance: f64
    crack_size: f64
    crack_offset: i32
    potential_chance: f64
    alternate_chance: f64
    require_alternate: bool
    wall: IntProvider
    points: IntProvider
    point_offset: IntProvider
    min_offset: i32
    max_offset: i32
    noise_multiplier: f64
    invalid_threshold: i32
}

// Reading.

// `BlockState.CODEC.fieldOf(key)`, as the block it's of.
fn block_field(f: Facts, m: List<Member>, key: str) -> u32 ! String {
    let v = field(m, key) else fail "No key {key} in MapLike"
    return f.block(try read_state(f, v))
}

fn blocks_field(f: Facts, rd: Readers, m: List<Member>, key: str) -> BlockSet ! String {
    let v = field(m, key) else fail "No key {key} in MapLike"
    return try read_blocks(f, rd.blocks, v)
}

// `Codec.floatRange(low, high).optionalFieldOf(key, otherwise)`.
fn optional_float(m: List<Member>, key: str, low: f32, high: f32, otherwise: f32) -> f32 ! String {
    if let v = field(m, key) {
        return try float_range(v, low, high)
    }
    return otherwise
}

// `Codec.doubleRange(low, high).optionalFieldOf(key, otherwise)`.
fn optional_double(m: List<Member>, key: str, low: f64, high: f64, otherwise: f64) -> f64 ! String {
    if let v = field(m, key) {
        let d = try double_of(v)
        if d < low or d > high or d != d {
            fail "Value {d} outside of range [{low}:{high}]"
        }
        return d
    }
    return otherwise
}

fn optional_int(m: List<Member>, key: str, low: i32, high: i32, otherwise: i32) -> i32 ! String {
    if let v = field(m, key) {
        let i = try int_of(v)
        if i < low or i > high {
            fail "Value {i} outside of range [{low}:{high}]"
        }
        return i
    }
    return otherwise
}

fn optional_provider(m: List<Member>, key: str, low: i32, high: i32, min: i32, max: i32) -> IntProvider ! String {
    if let v = field(m, key) {
        return try read_int_range(v, low, high)
    }
    return IntProvider.Uniform { min: min, max: max }
}

pub fn read_speleothem(f: Facts, rd: Readers, m: List<Member>) -> Speleothem ! String {
    return Speleothem {
        base: try block_field(f, m, "base_block"),
        pointed: try block_field(f, m, "pointed_block"),
        replaceable: try blocks_field(f, rd, m, "replaceable_blocks"),
        taller: try optional_float(m, "chance_of_taller_generation", 0.0f32, 1.0f32, 0.2f32),
        directional: try optional_float(m, "chance_of_directional_spread", 0.0f32, 1.0f32, 0.7f32),
        radius2: try optional_float(m, "chance_of_spread_radius2", 0.0f32, 1.0f32, 0.5f32),
        radius3: try optional_float(m, "chance_of_spread_radius3", 0.0f32, 1.0f32, 0.5f32),
    }
}

pub fn read_cluster(f: Facts, rd: Readers, m: List<Member>) -> Cluster ! String {
    return Cluster {
        base: try block_field(f, m, "base_block"),
        pointed: try block_field(f, m, "pointed_block"),
        replaceable: try blocks_field(f, rd, m, "replaceable_blocks"),
        search: try int_range_field(m, "floor_to_ceiling_search_range", 1, 512),
        height: try int_provider_field(m, "height", 1, 128),
        radius: try int_provider_field(m, "radius", 1, 128),
        height_diff: try int_range_field(m, "max_stalagmite_stalactite_height_diff", 0, 64),
        deviation: try int_range_field(m, "height_deviation", 1, 64),
        thickness: try int_provider_field(m, "speleothem_block_layer_thickness", 0, 128),
        density: try float_provider_field(m, "density", some(0.0f32), some(2.0f32)),
        wetness: try float_provider_field(m, "wetness", some(0.0f32), some(2.0f32)),
        edge_chance: try float_range_field(m, "chance_of_speleothem_at_max_distance_from_center", 0.0f32, 1.0f32),
        edge_distance: try int_range_field(m, "max_distance_from_edge_affecting_chance_of_speleothem", 1, 64),
        center_distance: try int_range_field(m, "max_distance_from_center_affecting_height_bias", 1, 64),
    }
}

pub fn read_large_dripstone(f: Facts, rd: Readers, m: List<Member>) -> LargeDripstone ! String {
    return LargeDripstone {
        replaceable: try blocks_field(f, rd, m, "replaceable_blocks"),
        search: try optional_int(m, "floor_to_ceiling_search_range", 1, 512, 30),
        radius: try int_provider_field(m, "column_radius", 1, 16),
        scale: try float_provider_field(m, "height_scale", some(0.0f32), some(20.0f32)),
        ratio: try float_range_field(m, "max_column_radius_to_cave_height_ratio", 0.1f32, 1.0f32),
        stalactite: try float_provider_field(m, "stalactite_bluntness", some(0.1f32), some(10.0f32)),
        stalagmite: try float_provider_field(m, "stalagmite_bluntness", some(0.1f32), some(10.0f32)),
        wind: try float_provider_field(m, "wind_speed", some(0.0f32), some(2.0f32)),
        wind_radius: try int_range_field(m, "min_radius_for_wind", 0, 100),
        wind_bluntness: try float_range_field(m, "min_bluntness_for_wind", 0.0f32, 5.0f32),
    }
}

pub fn read_geode(ps: mut Providers, zip: Data, f: Facts, rd: Readers, m: List<Member>) -> Geode ! String {
    let bv = field(m, "blocks") else fail "No key blocks in MapLike"
    let b = try map_of(bv)
    let lv = field(m, "layers") else fail "No key layers in MapLike"
    let l = try map_of(lv)
    let cv = field(m, "crack") else fail "No key crack in MapLike"
    let c = try map_of(cv)
    let pv = field(b, "inner_placements") else fail "No key inner_placements in MapLike"
    var placements = List<u32>()
    for item in try list_of(pv) {
        placements.push(try read_state(f, item))
    }
    if placements.is_empty() {
        fail "List must have contents"
    }
    let threshold_value = field(m, "invalid_blocks_threshold") else fail "No key invalid_blocks_threshold in MapLike"
    var require_alternate = true
    if let v = field(m, "placements_require_layer0_alternate") {
        require_alternate = try bool_of(v)
    }
    var min_offset = -16
    if let v = field(m, "min_gen_offset") {
        min_offset = try int_of(v)
    }
    var max_offset = 16
    if let v = field(m, "max_gen_offset") {
        max_offset = try int_of(v)
    }
    return Geode {
        filling: try provider_field(mut ps, zip, f, rd, b, "filling_provider"),
        inner: try provider_field(mut ps, zip, f, rd, b, "inner_layer_provider"),
        alternate: try provider_field(mut ps, zip, f, rd, b, "alternate_inner_layer_provider"),
        middle: try provider_field(mut ps, zip, f, rd, b, "middle_layer_provider"),
        outer: try provider_field(mut ps, zip, f, rd, b, "outer_layer_provider"),
        placements: placements,
        cannot_replace: try blocks_field(f, rd, b, "cannot_replace"),
        invalid: try blocks_field(f, rd, b, "invalid_blocks"),
        filling_layer: try optional_double(l, "filling", 0.01, 50.0, 1.7),
        inner_layer: try optional_double(l, "inner_layer", 0.01, 50.0, 2.2),
        middle_layer: try optional_double(l, "middle_layer", 0.01, 50.0, 3.2),
        outer_layer: try optional_double(l, "outer_layer", 0.01, 50.0, 4.2),
        crack_chance: try optional_double(c, "generate_crack_chance", 0.0, 1.0, 1.0),
        crack_size: try optional_double(c, "base_crack_size", 0.0, 5.0, 2.0),
        crack_offset: try optional_int(c, "crack_point_offset", 0, 10, 2),
        potential_chance: try optional_double(m, "use_potential_placements_chance", 0.0, 1.0, 0.35),
        alternate_chance: try optional_double(m, "use_alternate_layer0_chance", 0.0, 1.0, 0.0),
        require_alternate: require_alternate,
        wall: try optional_provider(m, "outer_wall_distance", 1, 20, 4, 5),
        points: try optional_provider(m, "distribution_points", 1, 20, 3, 4),
        point_offset: try optional_provider(m, "point_offset", 0, 10, 1, 2),
        min_offset: min_offset,
        max_offset: max_offset,
        noise_multiplier: try optional_double(m, "noise_multiplier", 0.0, 1.0, 0.05),
        invalid_threshold: try int_of(threshold_value),
    }
}

fn provider_field(ps: mut Providers, zip: Data, f: Facts, rd: Readers, m: List<Member>, key: str) -> usize ! String {
    let v = field(m, key) else fail "No key {key} in MapLike"
    return try ps.read(zip, f, rd, v)
}

// `SpeleothemUtils`.

fn empty_or_water(f: Facts, s: u32) -> bool {
    return f.is_air(s) or f.is(s, f.ids.water)
}

fn empty_water_or_lava(f: Facts, s: u32) -> bool {
    return f.is_air(s) or f.is(s, f.ids.water) or f.is(s, f.ids.lava)
}

fn is_base(f: Facts, s: u32, base: u32, replaceable: BlockSet) -> bool {
    return f.is(s, base) or f.in_set(s, replaceable)
}

// `placeBaseBlockIfPossible`.
fn place_base(f: Facts, r: mut Region, x: i32, y: i32, z: i32, base: u32, replaceable: BlockSet) -> bool ! Thrown {
    if f.in_set(try r.state(f, x, y, z), replaceable) {
        _ = r.set_block(f, x, y, z, f.default_state(base), 2)
        return true
    }
    return false
}

// `growSpeleothem`: from the start toward the tip, base, middles, frustum and tip, where the
// block behind the start is a base.
fn grow_speleothem(f: Facts, r: mut Region, x: i32, y: i32, z: i32, tip: i32, height: i32, merged: bool, base: u32, pointed: u32, replaceable: BlockSet) ! Thrown {
    let back = opposite(tip)
    if not is_base(f, try r.state(f, x + step_x(back), y + step_y(back), z + step_z(back)), base, replaceable) {
        return
    }
    var parts = List<String>()
    if height >= 3 {
        parts.push(String("base"))
        for _ in 0..height - 3 {
            parts.push(String("middle"))
        }
    }
    if height >= 2 {
        parts.push(String("frustum"))
    }
    if height >= 1 {
        parts.push(if merged { String("tip_merge") } else { String("tip") })
    }
    var px = x
    var py = y
    var pz = z
    for part in parts {
        var state = try f.with_name(f.default_state(pointed), "vertical_direction", direction_name(tip))
        state = try f.with_name(state, "thickness", part)
        state = try f.with_bool(state, "waterlogged", f.is_water(try r.state(f, px, py, pz)))
        _ = r.set_block(f, px, py, pz, state, 2)
        px += step_x(tip)
        py += step_y(tip)
        pz += step_z(tip)
    }
}

/// `SpeleothemFeature.place`.
pub fn place_speleothem<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, s: Speleothem, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let above = is_base(f, try r.state(f, x, y + 1, z), s.base, s.replaceable)
    let below = is_base(f, try r.state(f, x, y - 1, z), s.base, s.replaceable)
    var tip = UP
    if above and below {
        tip = if rand.next_boolean() { DOWN } else { UP }
    } else if above {
        tip = DOWN
    } else if not below {
        return false
    }
    let back = opposite(tip)
    let rx = x + step_x(back)
    let ry = y + step_y(back)
    let rz = z + step_z(back)
    // `createPatchOfBaseBlocks`.
    _ = try place_base(f, mut r, rx, ry, rz, s.base, s.replaceable)
    for i in 0..4 {
        let d = horizontal(i)
        if not (rand.next_float() > s.directional) {
            let x1 = rx + step_x(d)
            let z1 = rz + step_z(d)
            _ = try place_base(f, mut r, x1, ry, z1, s.base, s.replaceable)
            if not (rand.next_float() > s.radius2) {
                let d2 = rand.next_int_below(6)
                let x2 = x1 + step_x(d2)
                let y2 = ry + step_y(d2)
                let z2 = z1 + step_z(d2)
                _ = try place_base(f, mut r, x2, y2, z2, s.base, s.replaceable)
                if not (rand.next_float() > s.radius3) {
                    let d3 = rand.next_int_below(6)
                    _ = try place_base(f, mut r, x2 + step_x(d3), y2 + step_y(d3), z2 + step_z(d3), s.base, s.replaceable)
                }
            }
        }
    }
    var height = 1
    if rand.next_float() < s.taller and empty_or_water(f, try r.state(f, x + step_x(tip), y + step_y(tip), z + step_z(tip))) {
        height = 2
    }
    try grow_speleothem(f, mut r, x, y, z, tip, height, false, s.base, s.pointed, s.replaceable)
    return true
}

// `Column`: a floor and a ceiling, either perhaps missing.
struct Column {
    floor: i32?
    ceiling: i32?
}

impl Column {
    fn height(self) -> i32? {
        let fl = self.floor else return none
        let c = self.ceiling else return none
        return some(c - fl - 1)
    }
}

// `Column.scan`, inside where it's empty or water: the edge as a block neither, or, for large
// dripstone, a base or lava.
fn scan(f: Facts, r: Region, x: i32, y: i32, z: i32, range: i32, large: bool, replaceable: BlockSet) -> Column? ! Thrown {
    if not empty_or_water(f, try r.state(f, x, y, z)) {
        return none
    }
    let ceiling = try scan_toward(f, r, x, y, z, range, large, replaceable, 1)
    let floor = try scan_toward(f, r, x, y, z, range, large, replaceable, -1)
    return some(Column { floor: floor, ceiling: ceiling })
}

fn scan_toward(f: Facts, r: Region, x: i32, y: i32, z: i32, range: i32, large: bool, replaceable: BlockSet, step: i32) -> i32? ! Thrown {
    var py = y
    var i = 1
    while i < range and empty_or_water(f, try r.state(f, x, py, z)) {
        py += step
        i += 1
    }
    let s = try r.state(f, x, py, z)
    let edge = if large {
        is_base(f, s, f.ids.dripstone_block, replaceable) or f.is(s, f.ids.lava)
    } else {
        not f.is_air(s) and not f.is(s, f.ids.water)
    }
    return if edge { some(py) } else { none }
}

// `Mth.clampedMap` of floats.
fn clamped_map_f32(v: f32, from_min: f32, from_max: f32, to_min: f32, to_max: f32) -> f32 {
    let t = (v - from_min) / (from_max - from_min)
    if t < 0.0f32 {
        return to_min
    }
    if t > 1.0f32 {
        return to_max
    }
    return to_min + t * (to_max - to_min)
}

// `Mth.clampedMap` of doubles.
fn clamped_map(v: f64, from_min: f64, from_max: f64, to_min: f64, to_max: f64) -> f64 {
    let t = (v - from_min) / (from_max - from_min)
    if t < 0.0 {
        return to_min
    }
    if t > 1.0 {
        return to_max
    }
    return to_min + t * (to_max - to_min)
}

/// `SpeleothemClusterFeature.place`.
pub fn place_cluster<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, c: Cluster, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not empty_or_water(f, try r.state(f, x, y, z)) {
        return false
    }
    let height = try c.height.sample(mut rand)
    let wetness = c.wetness.sample(mut rand)
    let density = c.density.sample(mut rand)
    let xr = try c.radius.sample(mut rand)
    let zr = try c.radius.sample(mut rand)
    for dx in -xr..xr + 1 {
        for dz in -zr..zr + 1 {
            let from_edge = (xr - dx.abs()).min(zr - dz.abs())
            let chance = f64(clamped_map_f32(f32.nearest(from_edge), 0.0f32, f32.nearest(c.edge_distance), c.edge_chance, 1.0f32))
            try cluster_column(f, mut r, mut rand, c, x + dx, y, z + dz, dx, dz, wetness, chance, height, density)
        }
    }
    return true
}

// `SpeleothemClusterFeature.placeColumn`.
fn cluster_column<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, c: Cluster, x: i32, y: i32, z: i32, dx: i32, dz: i32, wetness: f32, chance: f64, cluster_height: i32, density: f32) ! Thrown {
    let base = try scan(f, r, x, y, z, c.search, false, c.replaceable) else return
    let ceiling = base.ceiling
    if ceiling == none and base.floor == none {
        return
    }
    let want_pool = rand.next_float() < wetness
    var floor = base.floor
    if want_pool {
        if let fy = base.floor {
            if try can_place_pool(f, r, c, x, fy, z) {
                floor = some(fy - 1)
                _ = r.set_block(f, x, fy, z, f.ids.water_state, 2)
            }
        }
    }
    let column = Column { floor: floor, ceiling: ceiling }
    let want_stalactite = rand.next_double() < chance
    var stalactite = 0
    if let cy = ceiling {
        if want_stalactite and not f.is(try r.state(f, x, cy, z), f.ids.lava) {
            let thickness = try c.thickness.sample(mut rand)
            try replace_with_base(f, mut r, x, cy, z, thickness, 1, c.base, c.replaceable)
            var max_height = cluster_height
            if let fy = floor {
                max_height = cluster_height.min(cy - fy)
            }
            stalactite = speleothem_height(mut rand, c, dx, dz, density, max_height)
        }
    }
    let want_stalagmite = rand.next_double() < chance
    var stalagmite = 0
    if let fy = floor {
        if want_stalagmite and not f.is(try r.state(f, x, fy, z), f.ids.lava) {
            let thickness = try c.thickness.sample(mut rand)
            try replace_with_base(f, mut r, x, fy, z, thickness, -1, c.base, c.replaceable)
            if ceiling != none {
                let diff = try between_inclusive(mut rand, -c.height_diff, c.height_diff)
                stalagmite = (stalactite + diff).max(0)
            } else {
                stalagmite = speleothem_height(mut rand, c, dx, dz, density, cluster_height)
            }
        }
    }
    var actual_stalagmite = stalagmite
    var actual_stalactite = stalactite
    if let cy = ceiling {
        if let fy = floor {
            if cy - stalactite <= fy + stalagmite {
                let lowest = (cy - stalactite).max(fy + 1)
                let highest = (fy + stalagmite).min(cy - 1)
                let bottom = try between_inclusive(mut rand, lowest, highest + 1)
                actual_stalactite = cy - bottom
                actual_stalagmite = bottom - 1 - fy
            }
        }
    }
    var merge = rand.next_boolean() and actual_stalactite > 0 and actual_stalagmite > 0
    if merge {
        merge = match column.height() {
            some(h) => actual_stalactite + actual_stalagmite == h,
            none => false,
        }
    }
    if let cy = ceiling {
        try grow_speleothem(f, mut r, x, cy - 1, z, DOWN, actual_stalactite, merge, c.base, c.pointed, c.replaceable)
    }
    if let fy = floor {
        try grow_speleothem(f, mut r, x, fy + 1, z, UP, actual_stalagmite, merge, c.base, c.pointed, c.replaceable)
    }
}

// `getSpeleothemHeight`: none past the density, else a normal draw about a mean that falls from
// half the height at the center to none further out.
fn speleothem_height<T: RandomSource>(rand: mut T, c: Cluster, dx: i32, dz: i32, density: f32, max_height: i32) -> i32 {
    if rand.next_float() > density {
        return 0
    }
    let distance = dx.abs() + dz.abs()
    let mean = f32.nearest(clamped_map(f64(distance), 0.0, f64(c.center_distance), f64(max_height) / 2.0, 0.0))
    return i32.saturate(clamp_float(gaussian(mut rand, mean, f32.nearest(c.deviation)), 0.0f32, f32.nearest(max_height)))
}

// `canPlacePool`.
fn can_place_pool(f: Facts, r: Region, c: Cluster, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let s = try r.state(f, x, y, z)
    if f.is(s, f.ids.water) or f.is(s, c.base) or f.is(s, c.pointed) {
        return false
    }
    if f.is_water(try r.state(f, x, y + 1, z)) {
        return false
    }
    for i in 0..4 {
        let d = horizontal(i)
        if not try beside_water_ok(f, r, x + step_x(d), y, z + step_z(d)) {
            return false
        }
    }
    return try beside_water_ok(f, r, x, y - 1, z)
}

// `canBeAdjacentToWater`.
fn beside_water_ok(f: Facts, r: Region, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let s = try r.state(f, x, y, z)
    return f.in_set(s, f.tag("minecraft:base_stone_overworld")) or f.is_water(s)
}

// `replaceBlocksWithBaseBlocks`: up to `count` from the first, toward `step`, while each takes.
fn replace_with_base(f: Facts, r: mut Region, x: i32, y: i32, z: i32, count: i32, step: i32, base: u32, replaceable: BlockSet) ! Thrown {
    var py = y
    for _ in 0..count {
        if not try place_base(f, mut r, x, py, z, base, replaceable) {
            return
        }
        py += step
    }
}

// `LargeDripstoneFeature.WindOffsetter`.
struct Wind {
    on: bool
    origin_y: i32
    x: f64
    z: f64
    max: i32
}

impl Wind {
    fn offset_x(self, y: i32) -> i32 {
        if not self.on {
            return 0
        }
        let dy = f64(self.origin_y - y)
        return clamp_int(i32.saturate((self.x * dy).floor()), -self.max, self.max)
    }

    fn offset_z(self, y: i32) -> i32 {
        if not self.on {
            return 0
        }
        let dy = f64(self.origin_y - y)
        return clamp_int(i32.saturate((self.z * dy).floor()), -self.max, self.max)
    }
}

// `Mth.clamp(int, int, int)`.
fn clamp_int(v: i32, min: i32, max: i32) -> i32 {
    if v < min {
        return min
    }
    return v.min(max)
}

// `LargeDripstoneFeature.LargeDripstone`.
struct Drip {
    x: i32
    y: i32
    z: i32
    up: bool
    radius: i32
    bluntness: f64
    scale: f64
}

impl Drip {
    fn height_at(self, check: f32) -> i32 {
        return i32.saturate(spike_height(f64(check), f64(self.radius), self.scale, self.bluntness))
    }
}

// `SpeleothemUtils.getSpeleothemHeight`.
fn spike_height(distance: f64, radius: f64, scale: f64, bluntness: f64) -> f64 {
    var d = distance
    if d < bluntness {
        d = bluntness
    }
    let rr = d / radius * 0.384
    let part1 = 0.75 * pow(rr, 1.3333333333333333)
    let part2 = pow(rr, 0.6666666666666666)
    let part3 = 0.3333333333333333 * log(rr)
    var h = scale * (part1 - part2 - part3)
    if h < 0.0 {
        h = 0.0
    }
    return h / 0.384 * radius
}

/// `LargeDripstoneFeature.place`.
pub fn place_large_dripstone<T: RandomSource>(f: Facts, sin: SinTable, r: mut Region, rand: mut T, l: LargeDripstone, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not empty_or_water(f, try r.state(f, x, y, z)) {
        return false
    }
    let column = try scan(f, r, x, y, z, l.search, true, l.replaceable) else return false
    let fy = column.floor else return false
    let cy = column.ceiling else return false
    let height = cy - fy - 1
    if height < 4 {
        return false
    }
    let by_height = i32.saturate(f32.nearest(height) * l.ratio)
    let max_radius = clamp_int(by_height, l.radius.min(), l.radius.max())
    let radius = try between_inclusive(mut rand, l.radius.min(), max_radius)
    var stalactite = Drip { x: x, y: cy - 1, z: z, up: false, radius: radius, bluntness: f64(l.stalactite.sample(mut rand)), scale: f64(l.scale.sample(mut rand)) }
    var stalagmite = Drip { x: x, y: fy + 1, z: z, up: true, radius: radius, bluntness: f64(l.stalagmite.sample(mut rand)), scale: f64(l.scale.sample(mut rand)) }
    var wind = Wind { on: false, origin_y: 0, x: 0.0, z: 0.0, max: 0 }
    let suits = stalactite.radius >= l.wind_radius and stalactite.bluntness >= f64(l.wind_bluntness)
    if suits and stalagmite.radius >= l.wind_radius and stalagmite.bluntness >= f64(l.wind_bluntness) {
        let speed = l.wind.sample(mut rand)
        let direction = float_between(mut rand, 0.0f32, PI_F32)
        wind = Wind {
            on: true,
            origin_y: y,
            x: f64(sin.cos(f64(direction)) * speed),
            z: f64(sin.sin(f64(direction)) * speed),
            max: 16 - radius,
        }
    }
    let stalactite_ok = try move_back(f, sin, r, mut stalactite, wind)
    let stalagmite_ok = try move_back(f, sin, r, mut stalagmite, wind)
    if stalactite_ok {
        try place_drip(f, mut r, mut rand, stalactite, wind)
    }
    if stalagmite_ok {
        try place_drip(f, mut r, mut rand, stalagmite, wind)
    }
    return true
}

// `moveBackUntilBaseIsInsideStoneAndShrinkRadiusIfNecessary`.
fn move_back(f: Facts, sin: SinTable, r: Region, d: mut Drip, wind: Wind) -> bool ! Thrown {
    while d.radius > 1 {
        var ny = d.y
        let tries = 10.min(d.height_at(0.0f32))
        for _ in 0..tries {
            if f.is(try r.state(f, d.x, ny, d.z), f.ids.lava) {
                return false
            }
            if try embedded(f, sin, r, d.x + wind.offset_x(ny), ny, d.z + wind.offset_z(ny), d.radius) {
                d.y = ny
                return true
            }
            ny += if d.up { -1 } else { 1 }
        }
        d.radius /= 2
    }
    return false
}

// `SpeleothemUtils.isCircleMostlyEmbeddedInStone`.
fn embedded(f: Facts, sin: SinTable, r: Region, x: i32, y: i32, z: i32, radius: i32) -> bool ! Thrown {
    if empty_water_or_lava(f, try r.state(f, x, y, z)) {
        return false
    }
    let increment = 6.0f32 / f32.nearest(radius)
    var angle = 0.0f32
    while angle < TWO_PI_F32 {
        let dx = i32.saturate(sin.cos(f64(angle)) * f32.nearest(radius))
        let dz = i32.saturate(sin.sin(f64(angle)) * f32.nearest(radius))
        if empty_water_or_lava(f, try r.state(f, x + dx, y, z + dz)) {
            return false
        }
        angle += increment
    }
    return true
}

// `LargeDripstone.placeBlocks`.
fn place_drip<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, d: Drip, wind: Wind) ! Thrown {
    let block = f.default_state(f.ids.dripstone_block)
    let stone = f.tag("minecraft:base_stone_overworld")
    for dx in -d.radius..d.radius + 1 {
        for dz in -d.radius..d.radius + 1 {
            let current = f32.nearest(f64(f32.nearest(dx * dx + dz * dz)).sqrt())
            if not (current > f32.nearest(d.radius)) {
                var height = d.height_at(current)
                if height > 0 {
                    if f64(rand.next_float()) < 0.2 {
                        height = i32.saturate(f32.nearest(height) * float_between(mut rand, 0.8f32, 1.0f32))
                    }
                    let px = d.x + dx
                    var py = d.y
                    let pz = d.z + dz
                    var out = false
                    var max_y = i32.MAX
                    if d.up {
                        max_y = try r.get_height(f, WORLD_SURFACE_WG, px, pz)
                    }
                    var i = 0
                    while i < height and py < max_y {
                        let wx = px + wind.offset_x(py)
                        let wz = pz + wind.offset_z(py)
                        let s = try r.state(f, wx, py, wz)
                        if empty_water_or_lava(f, s) {
                            out = true
                            _ = r.set_block(f, wx, py, wz, block, 2)
                        } else if out and f.in_set(s, stone) {
                            break
                        }
                        py += if d.up { 1 } else { -1 }
                        i += 1
                    }
                }
            }
        }
    }
}

/// `GeodeFeature.place`.
pub fn place_geode<T: RandomSource>(e: Env, ps: Providers, r: mut Region, rand: mut T, g: Geode, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    var px = List<i32>()
    var py = List<i32>()
    var pz = List<i32>()
    var offsets = List<i32>()
    let count = try g.points.sample(mut rand)
    var seeded = AnyRandom.Legacy(LegacyRandom.new(r.seed))
    let noise = parity(-4, [1.0]).create(mut seeded)
    let adjustment = f64(count) / f64(g.wall.max())
    let inner_air = 1.0 / g.filling_layer.sqrt()
    let innermost = 1.0 / (g.inner_layer + adjustment).sqrt()
    let inner_crust = 1.0 / (g.middle_layer + adjustment).sqrt()
    let outer_crust = 1.0 / (g.outer_layer + adjustment).sqrt()
    let crack_size = 1.0 / (g.crack_size + rand.next_double() / 2.0 + (if count > 3 { adjustment } else { 0.0 })).sqrt()
    let crack = f64(rand.next_float()) < g.crack_chance
    var invalid = 0
    for _ in 0..count {
        let ox = try g.wall.sample(mut rand)
        let oy = try g.wall.sample(mut rand)
        let oz = try g.wall.sample(mut rand)
        let s = try r.state(f, x + ox, y + oy, z + oz)
        if f.is_air(s) or f.in_set(s, g.invalid) {
            invalid += 1
            if invalid > g.invalid_threshold {
                return false
            }
        }
        px.push(x + ox)
        py.push(y + oy)
        pz.push(z + oz)
        offsets.push(try g.point_offset.sample(mut rand))
    }
    var cx = List<i32>()
    var cy = List<i32>()
    var cz = List<i32>()
    if crack {
        let which = rand.next_int_below(4)
        let off = count * 2 + 1
        let ax = if which == 0 or which == 2 { off } else { 0 }
        let az = if which == 1 or which == 2 { off } else { 0 }
        for dy in [7, 5, 1] {
            cx.push(x + ax)
            cy.push(y + dy)
            cz.push(z + az)
        }
    }
    var potential = List<i32>()
    let lo = g.min_offset
    let hi = g.max_offset
    for bz in z + lo..z + hi + 1 {
        for by in y + lo..y + hi + 1 {
            for bx in x + lo..x + hi + 1 {
                let noise_offset = f64(noise.get(f64(bx), f64(by), f64(bz))) * g.noise_multiplier
                var shell = 0.0
                for i in 0..px.len() {
                    let ddx = f64(bx - px[i])
                    let ddy = f64(by - py[i])
                    let ddz = f64(bz - pz[i])
                    shell += 1.0 / (ddx * ddx + ddy * ddy + ddz * ddz + f64(offsets[i])).sqrt() + noise_offset
                }
                if shell < outer_crust {
                    continue
                }
                if shell >= inner_air {
                    let s = try get_state(e, ps, r, mut rand, g.filling, bx, by, bz)
                    try safe_set(f, mut r, g, bx, by, bz, s)
                    continue
                }
                var crack_sum = 0.0
                for i in 0..cx.len() {
                    let ddx = f64(bx - cx[i])
                    let ddy = f64(by - cy[i])
                    let ddz = f64(bz - cz[i])
                    crack_sum += 1.0 / (ddx * ddx + ddy * ddy + ddz * ddz + f64(g.crack_offset)).sqrt() + noise_offset
                }
                if crack and crack_sum >= crack_size {
                    try safe_set(f, mut r, g, bx, by, bz, f.ids.air_state)
                    for d in 0..6 {
                        let ax = bx + step_x(d)
                        let ay = by + step_y(d)
                        let az = bz + step_z(d)
                        let fluid = f.fluid(try r.state(f, ax, ay, az))
                        if fluid != EMPTY_FLUID {
                            r.schedule_fluid(fluid, ax, ay, az)
                        }
                    }
                } else if shell >= innermost {
                    let alternate = f64(rand.next_float()) < g.alternate_chance
                    let s = try get_state(e, ps, r, mut rand, if alternate { g.alternate } else { g.inner }, bx, by, bz)
                    try safe_set(f, mut r, g, bx, by, bz, s)
                    if (not g.require_alternate or alternate) and f64(rand.next_float()) < g.potential_chance {
                        potential.push(bx)
                        potential.push(by)
                        potential.push(bz)
                    }
                } else if shell >= inner_crust {
                    let s = try get_state(e, ps, r, mut rand, g.middle, bx, by, bz)
                    try safe_set(f, mut r, g, bx, by, bz, s)
                } else if shell >= outer_crust {
                    let s = try get_state(e, ps, r, mut rand, g.outer, bx, by, bz)
                    try safe_set(f, mut r, g, bx, by, bz, s)
                }
            }
        }
    }
    var i = 0usize
    while i < potential.len() {
        let gx = potential[i]
        let gy = potential[i + 1]
        let gz = potential[i + 2]
        var state = g.placements[usize.wrap(rand.next_int_below(i32.wrap(g.placements.len())))]
        for d in 0..6 {
            if f.has(state, "facing") {
                state = try f.with_name(state, "facing", direction_name(d))
            }
            let qx = gx + step_x(d)
            let qy = gy + step_y(d)
            let qz = gz + step_z(d)
            let there = try r.state(f, qx, qy, qz)
            if f.has(state, "waterlogged") {
                state = try f.with_bool(state, "waterlogged", f.is_source(there))
            }
            // `BuddingAmethystBlock.canClusterGrowAtState`.
            if f.is_air(there) or (f.is(there, f.ids.water) and f.fluid_amount(there) == 8) {
                try safe_set(f, mut r, g, qx, qy, qz, state)
                break
            }
        }
        i += 3
    }
    return true
}

// `Feature.safeSetBlock`, where the block isn't one the geode can't replace.
fn safe_set(f: Facts, r: mut Region, g: Geode, x: i32, y: i32, z: i32, state: u32) ! Thrown {
    if not f.in_set(try r.state(f, x, y, z), g.cannot_replace) {
        _ = r.set_block(f, x, y, z, state, 2)
    }
}
