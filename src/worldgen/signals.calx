/// Redstone's signals as vanilla reads them (CAL-116): `SignalGetter`'s, which the level and each
/// block ask of the blocks around, and each state's own, `getSignal`, `getDirectSignal` and
/// `isSignalSource`, as the class that declares each has them, from the facts' tables where the
/// state alone gives them. With them, redstone wire's connections, `getConnectionState`, which
/// say where its signal goes, and a repeater's lock. `wires` is wire's `shouldSignal`, which
/// vanilla keeps on its one block: whether wire gives a signal, which it doesn't while it reads
/// the signals around it.
module worldgen.signals

import nbt.tag.{Tag}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, FULL, Facts, SIGNAL_BLOCK, SIGNAL_COMPARATOR, SIGNAL_FROM_BLOCK_ENTITY, SIGNAL_FROM_WORLD, SIGNAL_REPEATER, SIGNAL_WIRE, UP, clockwise, direction_named, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{direction_property, facing_of}

/// `SignalGetter.getSignal`: the signal the block at x, y, z gives toward `d`, the way from the
/// block asking to it: its own, and where it conducts, the most it's strongly powered with,
/// `getDirectSignalTo`.
pub fn signal<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, d: i32, wires: bool) -> i32 ! Thrown {
    let state = try r.state(f, x, y, z)
    let given = try weak_of(f, r, state, x, y, z, d, wires)
    if f.redstone_conductor(state) {
        return given.max(try strongly_powered(f, r, x, y, z, wires))
    }
    return given
}

/// `SignalGetter.hasSignal`: whether the block at x, y, z gives a signal toward `d`.
pub fn has_signal<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, d: i32, wires: bool) -> bool ! Thrown {
    return try signal(f, r, x, y, z, d, wires) > 0
}

/// `SignalGetter.getDirectSignal`: the strong signal the block at x, y, z gives toward `d`.
pub fn direct_signal<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, d: i32, wires: bool) -> i32 ! Thrown {
    let state = try r.state(f, x, y, z)
    return try strong_of(f, r, state, x, y, z, d, wires)
}

/// `SignalGetter.getDirectSignalTo`: the most the six around x, y, z strongly power it with, in
/// `Direction`'s order, stopping at 15.
pub fn strongly_powered<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, wires: bool) -> i32 ! Thrown {
    var most = 0
    for d in 0..6 {
        most = most.max(try direct_signal(f, r, x + step_x(d), y + step_y(d), z + step_z(d), d, wires))
        if most >= 15 {
            return most
        }
    }
    return most
}

/// `SignalGetter.hasNeighborSignal`: whether any of the six around x, y, z gives it a signal, in
/// `Direction`'s order.
pub fn has_neighbour_signal<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, wires: bool) -> bool ! Thrown {
    for d in 0..6 {
        if try signal(f, r, x + step_x(d), y + step_y(d), z + step_z(d), d, wires) > 0 {
            return true
        }
    }
    return false
}

/// `SignalGetter.getBestNeighborSignal`: the most any of the six around x, y, z gives it, in
/// `Direction`'s order, stopping at 15.
pub fn best_neighbour_signal<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, wires: bool) -> i32 ! Thrown {
    var most = 0
    for d in 0..6 {
        let s = try signal(f, r, x + step_x(d), y + step_y(d), z + step_z(d), d, wires)
        if s >= 15 {
            return 15
        }
        if s > most {
            most = s
        }
    }
    return most
}

/// `SignalGetter.getControlInputSignal`: what the block at x, y, z gives the side of a diode,
/// toward `d`: a diode's strong signal; or, unless `diodes_only`, the redstone block's 15,
/// wire's power, or another source's strong signal.
pub fn control_input<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, d: i32, diodes_only: bool, wires: bool) -> i32 ! Thrown {
    let state = try r.state(f, x, y, z)
    let kind = f.signal_kind(f.block(state))
    if diodes_only {
        if kind == SIGNAL_REPEATER or kind == SIGNAL_COMPARATOR {
            return try strong_of(f, r, state, x, y, z, d, wires)
        }
        return 0
    }
    if kind == SIGNAL_BLOCK {
        return 15
    }
    if kind == SIGNAL_WIRE {
        return f.get_int(state, "power") ?? 0
    }
    if is_source(f, state, wires) {
        return try strong_of(f, r, state, x, y, z, d, wires)
    }
    return 0
}

/// `BlockState.isSignalSource`: as the state's class says, and wire's only while wire signals.
pub fn is_source(f: Facts, state: u32, wires: bool) -> bool {
    let block = f.block(state)
    if f.signal_kind(block) == SIGNAL_WIRE {
        return wires
    }
    return f.signal_source(block)
}

/// `BlockState.getSignal`: the weak signal `state`, at x, y, z, gives toward `d`.
pub fn weak_of<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32, d: i32, wires: bool) -> i32 ! Thrown {
    let w = f.weak_signal(state, d)
    if w <= 15 {
        return i32(w)
    }
    if w == SIGNAL_FROM_WORLD {
        return try wire_signal(f, r, state, x, y, z, d, wires)
    }
    if w == SIGNAL_FROM_BLOCK_ENTITY {
        return try block_entity_signal(r, x, y, z)
    }
    fail unknown(f, state)
}

/// `BlockState.getDirectSignal`: the strong signal `state`, at x, y, z, gives toward `d`;
/// wire's, `RedstoneWireBlock.getDirectSignal`, is its weak one while wire signals.
pub fn strong_of<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32, d: i32, wires: bool) -> i32 ! Thrown {
    let s = f.strong_signal(state, d)
    if s <= 15 {
        return i32(s)
    }
    if s == SIGNAL_FROM_WORLD {
        return if wires { try wire_signal(f, r, state, x, y, z, d, wires) } else { 0 }
    }
    if s == SIGNAL_FROM_BLOCK_ENTITY {
        return try block_entity_signal(r, x, y, z)
    }
    fail unknown(f, state)
}

// The signal its block entity gives where its state says so: a comparator's output, 15 from a
// powered test block's, `TestBlock.ownSignal` (CAL-124), or a jukebox's, 15 while it plays a song,
// `JukeboxBlock.ownSignal` (CAL-128): while it saves how long it's played its record's song, one
// the world has, up to the tick it stops (CAL-143); or a trapped chest's, how many have it open,
// up to 15, `TrappedChestBlock.getSignal` (CAL-144).
fn block_entity_signal<R: BlockAccess>(r: R, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let open = r.open_count(x, y, z)
    if open > 0 {
        // Only a trapped chest gives the signal of a container that counts who has it open.
        return open.min(15)
    }
    let saved = r.block_entity_tag(x, y, z) else return 0
    let id = match saved {
        Tag.Compound(m) => if m.contains("id") { m["id"].copy() } else { Tag.End },
        _ => Tag.End,
    }
    if id == Tag.Str(String("minecraft:jukebox")) {
        let Tag.Compound(m) = saved else return 0
        if not m.contains("ticks_since_song_started") or not m.contains("RecordItem") {
            return 0
        }
        let song = r.jukebox_song(m["RecordItem"].copy()) else return 0
        return if song.playing(m["ticks_since_song_started"].number_long() ?? 0) { 15 } else { 0 }
    }
    if id != Tag.Str(String("minecraft:test_block")) {
        return comparator_output(r, x, y, z)
    }
    return match saved {
        Tag.Compound(m) => if m.contains("powered") and m["powered"] == Tag.Byte(1) { 15 } else { 0 },
        _ => 0,
    }
}

/// `ComparatorBlock.getOutputSignal`: what the comparator at x, y, z holds, its block entity's
/// `OutputSignal`, 0 where it has none yet, as a fresh one holds (CAL-123).
pub fn comparator_output<R: BlockAccess>(r: R, x: i32, y: i32, z: i32) -> i32 {
    let saved = r.block_entity_tag(x, y, z) else return 0
    return match saved {
        Tag.Compound(m) => if m.contains("id") and m["id"] == Tag.Str(String("minecraft:comparator")) and m.contains("OutputSignal") {
            match m["OutputSignal"] {
                Tag.Int(v) => v,
                _ => 0,
            }
        } else {
            0
        },
        _ => 0,
    }
}

// What a signal Calcite doesn't have yet throws.
fn unknown(f: Facts, state: u32) -> Thrown {
    return Thrown { exception: "Unimplemented", message: "The signal of {f.class_name(f.block(state))}" }
}

// `RedstoneWireBlock.getSignal`: none while wire doesn't signal, or down; its power up, and toward
// a side it's joined to, as `getConnectionState` joins it afresh, else none.
fn wire_signal<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32, d: i32, wires: bool) -> i32 ! Thrown {
    if not wires or d == DOWN {
        return 0
    }
    let power = f.get_int(state, "power") ?? 0
    if power == 0 {
        return 0
    }
    if d == UP {
        return power
    }
    let joined = try wire_connections(f, r, state, x, y, z)
    return if (f.get_name(joined, direction_property(opposite(d))) ?? String("none")) != "none" { power } else { 0 }
}

/// `RepeaterBlock.isLocked`: whether a diode at either side of the repeater `state`, at x, y,
/// z, powers it, `getAlternateSignal` with `sideInputDiodesOnly`, its clockwise side first.
pub fn repeater_locked<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let facing = try facing_of(f, state)
    let cw = clockwise(facing)
    let ccw = opposite(cw)
    let a = try control_input(f, r, x + step_x(cw), y, z + step_z(cw), cw, true, true)
    let b = try control_input(f, r, x + step_x(ccw), y, z + step_z(ccw), ccw, true, true)
    return a.max(b) > 0
}

/// `RedstoneWireBlock.getConnectionState`: each side joined afresh, then a line with nothing
/// across it run out both ways, but a dot left a dot.
pub fn wire_connections<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let was_dot = wire_dot(f, state)
    // `getMissingConnections`, from a fresh wire of the same power.
    var s = try f.with_int(f.default_state(f.block(state)), "power", f.get_int(state, "power") ?? 0)
    let up = not f.redstone_conductor(try r.state(f, x, y + 1, z))
    for i in 0..4 {
        let d = horizontal(i)
        s = try f.with_name(s, direction_property(d), try wire_side(f, r, x, y, z, d, up))
    }
    if was_dot and wire_dot(f, s) {
        return s
    }
    let north = (f.get_name(s, "north") ?? String("none")) != "none"
    let south = (f.get_name(s, "south") ?? String("none")) != "none"
    let east = (f.get_name(s, "east") ?? String("none")) != "none"
    let west = (f.get_name(s, "west") ?? String("none")) != "none"
    let north_south_empty = not north and not south
    let east_west_empty = not east and not west
    if not west and north_south_empty {
        s = try f.with_name(s, "west", "side")
    }
    if not east and north_south_empty {
        s = try f.with_name(s, "east", "side")
    }
    if not north and east_west_empty {
        s = try f.with_name(s, "north", "side")
    }
    if not south and east_west_empty {
        s = try f.with_name(s, "south", "side")
    }
    return s
}

/// `RedstoneWireBlock.getConnectingSide`: up the side of what it can lie on, where wire is on
/// top; along the ground to what joins wire, or down to wire past what doesn't conduct; else
/// none.
pub fn wire_side<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, d: i32, up: bool) -> String ! Thrown {
    let nx = x + step_x(d)
    let nz = z + step_z(d)
    let next = try r.state(f, nx, y, nz)
    if up {
        let placeable = f.is_a(f.block(next), "TrapDoorBlock") or try wire_holds(f, next)
        if placeable and wire_joins(f, try r.state(f, nx, y + 1, nz), -1) {
            return String(if f.sturdy(next, opposite(d), FULL) { "up" } else { "side" })
        }
    }
    if wire_joins(f, next, d) {
        return String("side")
    }
    if f.redstone_conductor(next) or not wire_joins(f, try r.state(f, nx, y - 1, nz), -1) {
        return String("none")
    }
    return String("side")
}

/// `RedstoneWireBlock.canSurviveOn`: a sturdy top, or a hopper.
pub fn wire_holds(f: Facts, state: u32) -> bool ! Thrown {
    return f.sturdy(state, UP, FULL) or f.is(state, try f.named_block("hopper"))
}

// `shouldRedstoneWireConnectTo` toward `d`, -1 for none: wire always, an observer from behind, a
// repeater along it, any other signal source from a side.
fn wire_joins(f: Facts, state: u32, d: i32) -> bool {
    let block = f.block(state)
    if f.is_a(block, "RedstoneWireBlock") {
        return true
    }
    if d < 0 {
        return false
    }
    if f.is_a(block, "ObserverBlock") or f.is_a(block, "RepeaterBlock") {
        let facing = direction_named(f.get_name(state, "facing") ?? String()) ?? -1
        return facing == d or (f.is_a(block, "RepeaterBlock") and facing == opposite(d))
    }
    return f.signal_source(block)
}

/// `RedstoneWireBlock.isCross`.
pub fn wire_cross(f: Facts, state: u32) -> bool {
    for i in 0..4 {
        if (f.get_name(state, direction_property(horizontal(i))) ?? String("none")) == "none" {
            return false
        }
    }
    return true
}

// `RedstoneWireBlock.isDot`.
fn wire_dot(f: Facts, state: u32) -> bool {
    for i in 0..4 {
        if (f.get_name(state, direction_property(horizontal(i))) ?? String("none")) != "none" {
            return false
        }
    }
    return true
}
