/// A dimension as the server generates it (CAL-68, CAL-88, CAL-69): each chunk made as vanilla's
/// chunk statuses make it, with `worldgen`'s stages, from the structure starts to the features, in
/// jobs any thread can do. The Overworld, the Nether and the End are each made from their noise
/// settings, their biome source and their world's height, as their `LevelStem` names them.
///
/// A chunk's starts depend on nothing but where it is, and so do its biomes. Its terrain is its
/// fill with the beardifier of the structures it references, its materials and its carvers; it
/// needs the starts of the chunks within 8, and the biomes of the chunks around it. A chunk is
/// decorated, its structures placed and its features, as `applyBiomeDecoration` decorates it, in
/// a region of the chunks around it with their terrain, whose blocks any of the nine's
/// decorations may read and change, then finished as the server's chunk once the nine around it
/// are decorated. `worldgen.scheduler` says which job can be done when.
///
/// Decorations whose regions overlap are in a fixed order (D29), so what a chunk comes to is the
/// same whatever order chunks are asked for in, and on any thread. Chunks are colored by `x mod 3`
/// and `z mod 3`, and the colors are ranked; two chunks whose regions overlap, 2 or less apart,
/// never share a color. A chunk is decorated only after each chunk 2 or less from it of a lower
/// rank, which makes every overlap go the same way: the lower rank first. Of the 9! rankings, the
/// one here needs the fewest chunks decorated around those asked for, 5 to 8 more on each side of
/// an area (D214).
///
/// A `Worker` does jobs, each thread with its own: the noise settings' functions with their
/// caches, the features, and the template pools and templates it loads as starts need them. A
/// start made by one names its pools and templates by ID, so another can place it.
module worldgen.generator

import json.tree.{Json, Member, get}
import nbt.tag.{Tag}
import pack.data.{Data}
import pack.vanilla.{data_path, vanilla_data}
import registry.registry.{Registry}
import server.log.{Entry}
import std.math.{PI, sin, cos}
import std.palette.{PalettedContainer}
import storage.chunk.{ChunkRest, SavedTick}
import world.chunk.{AIR_STATE, BlockStates, Chunk, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES, OCEAN_FLOOR, Section, WORLD_SURFACE}
import worldgen.beardifier.{Beardifier, beard_kernel}
import worldgen.biome_manager.{SourceBiomes, Zoom}
import worldgen.biome_source.{BiomeSource, climate_of, holder_set, read_parameter, read_source}
import worldgen.carver.{Carvers, Corners, carve_chunk}
import worldgen.climate.{Parameter, quantize}
import worldgen.density.{Functions, data_json}
import worldgen.facts.{Facts}
import worldgen.features.{Catalog, Decoration, Gen}
import worldgen.interval.{Thrown}
import worldgen.jigsaw.{Pools}
import worldgen.material.{Materials, Rules, build_surface, materials, read_rules}
import worldgen.pieces.{PieceData, Start, template_id}
import worldgen.placing.{Placer, decorate_structured}
import worldgen.pool_pieces.{ElementCache}
import worldgen.predicates.{Readers}
import worldgen.references.{Refs, StartMap, registry_order}
import worldgen.region.{Region, RegionChunk}
import worldgen.sampler.{Context, sample}
import worldgen.structure_world.{StructureWorld}
import worldgen.structures.{RingSearch, Rings, StructureState, Structures, create_structures, ring_search}
import worldgen.survive.{Env}
import worldgen.template.{TemplateAsk, TemplateService, Templates}
import worldgen.terrain.{Filled, Shape, air_filled, clamped, fill_noise, read_shape}

/// The Overworld's bottom and height, which a `GenSetup` has unless it's given another's.
pub const MIN_Y: i32 = -64
pub const HEIGHT: i32 = 384

/// The chunks across a block of starts, or of biomes, that one job makes, as a shift.
pub const BLOCK_SHIFT: i32 = 2

// Each color's rank, by `x mod 3 + 3 * (z mod 3)`: the colors go (0, 0), (0, 1), (0, 2), (1, 2),
// (2, 2), (2, 1), (1, 1), (1, 0), (2, 0), as `(x mod 3, z mod 3)`.
const RANKS: [i32; 9] = [0, 7, 8, 1, 6, 5, 2, 3, 4]

/// The rank of the chunk at `x`, `z`'s color: of two chunks whose regions overlap, the one of
/// the lower rank is decorated first.
pub fn rank_of(x: i32, z: i32) -> i32 {
    let mx = ((x % 3) + 3) % 3
    let mz = ((z % 3) + 3) % 3
    return RANKS[usize.wrap(mx + 3 * mz)]
}

/// What a generator is made from: the noise settings, such as `minecraft:overworld`, the block,
/// fluid and biome registries, the block states' table, the blocks in `#uncarvable`, and the
/// world's seed; then the dimension's biome source, as its generator's `biome_source` is written,
/// or `none` for the Overworld's, its world's bottom and height, and whether it has sky light, as
/// its dimension type has them. Vanilla's data comes with it, as a generator is made on its own
/// thread.
pub struct GenSetup {
    pub settings: String
    pub blocks: Registry
    pub fluids: Registry
    pub biomes: Registry
    pub table: BlockStates
    pub uncarvable: List<i32>
    pub seed: i64
    pub source: Json? = none
    pub min_y: i32 = MIN_Y
    pub height: i32 = HEIGHT
    pub sky_light: bool = true
    /// The world's data, from its packs, where it has packs of its own, or `none` for vanilla's
    /// alone (CAL-92).
    pub data: Shared<Data>? = none
}

/// What `setup` generates from: the world's packs' data, or vanilla's, read from the data the
/// server keeps, with what reading it logs in `lines`.
pub fn setup_data(setup: GenSetup, lines: mut List<Entry>) -> Data ! String {
    if let d = setup.data {
        return d.value.copy()
    }
    return Data.of_zip(try vanilla_data(data_path(), mut lines))
}

// The noise settings' fields, and whether they use the legacy random source.
fn noise_settings(zip: Data, id: String) -> (List<Member>, bool) ! String {
    let json = try data_json(zip, id.copy(), String("noise_settings"))
    let members = match json {
        Json.Object(m) => m,
        _ => fail "the noise settings {id} aren't an object",
    }
    let legacy = match get(members, "legacy_random_source") {
        some(Json.Bool(b)) => b,
        _ => fail "the noise settings {id} have no `legacy_random_source`",
    }
    return (members, legacy)
}

/// The Overworld's biome source, `multi_noise` with the `overworld` preset, as every preset of a
/// normal world's Overworld has it.
pub fn overworld_source(zip: Data, biomes: Registry) -> BiomeSource ! String {
    let members: List<Member> = [Member { key: String("type"), value: Json.Str(String("minecraft:multi_noise")) }, Member { key: String("preset"), value: Json.Str(String("minecraft:overworld")) }]
    return try read_source(zip, biomes, Json.Object(members))
}

/// The biome source `setup` names, the Overworld's if it names none.
pub fn source_of(zip: Data, setup: GenSetup) -> BiomeSource ! String {
    let value = setup.source else return try overworld_source(zip, setup.biomes)
    return try read_source(zip, setup.biomes, value)
}

/// A chunk whose terrain is to be made: where, the beardifier of the structures it references,
/// gathered without its kernel, and the biomes of the chunk and the eight around it, from the
/// lower corner, `x` fastest.
pub struct TerrainJob {
    pub x: i32
    pub z: i32
    pub beard: Beardifier?
    pub biomes: List<List<i32>>
}

/// A chunk to decorate: the nine around it with their terrain, from the lower corner, `x`
/// fastest, and their biomes; the chunk's references; and a copy of each start they name, which
/// comes back as the decoration left it.
pub struct DecorateJob {
    pub x: i32
    pub z: i32
    pub chunks: List<RegionChunk>
    pub biomes: List<List<i32>>
    pub refs: List<Refs>
    pub starts: StartMap
}

/// A chunk decorated around, to make the server's chunk of, with its biomes, its references to
/// the structures started near it, and its own starts, which it saves (D288).
pub struct FinishJob {
    pub x: i32
    pub z: i32
    pub made: RegionChunk
    pub biomes: List<i32>
    pub refs: List<Refs>
    pub starts: List<Start>
}

/// What a worker does.
pub enum Job {
    /// One of the searches that place the strongholds' rings.
    Ring(RingSearch)
    /// The starts of the chunks of the block, by blocks `1 << BLOCK_SHIFT` chunks across, with
    /// the rings.
    Starts(i32, i32, Rings)
    /// The biomes of the chunks of the block.
    Biomes(i32, i32)
    Terrain(TerrainJob)
    Decorate(DecorateJob)
    Finish(FinishJob)
}

/// What a job made, with what went wrong making it, which leaves no starts, a chunk of air, or a
/// decoration stopped where it went wrong, as Calcite has no crash for it to be.
pub enum Made {
    /// A ring search's set, its place in the set's list, and the chunk it found.
    Ring(usize, usize, i32, i32, List<String>)
    /// The block's chunks' starts, `z` outer, `x` inner.
    Starts(i32, i32, List<List<Start>>, List<String>)
    /// The block's chunks' biomes, `z` outer, `x` inner, as `BiomeSource.chunk` gives them.
    Biomes(i32, i32, List<List<i32>>, List<String>)
    Terrain(i32, i32, RegionChunk, List<String>)
    /// The job back, with its chunks and its starts as the decoration left them.
    Decorated(DecorateJob, List<String>)
    /// The server's chunk, its heightmaps made from its blocks, and the rest of what it saves;
    /// its light is the server's to work out.
    Finished(i32, i32, Chunk, ChunkRest)
}

/// What makes chunks' terrain, on one thread: the noise settings' functions with their caches,
/// the shape, the materials and the carvers.
pub struct Terrain {
    functions: Functions
    shape: Shape
    biomes: SourceBiomes
    mat: Materials
    rules: Rules
    carvers: Carvers
    table: BlockStates
    seed: i64
    // The world's bottom and height.
    min_y: i32
    height: i32
    // The biome each chunk's carvers are picked by, kept for the chunks around it.
    corners: Corners
}

impl Terrain {
    /// What makes terrain as `setup` says, from vanilla's data in `zip`.
    pub fn new(zip: Data, setup: GenSetup) -> Terrain ! String {
        let facts = try Facts.new(setup.blocks, setup.fluids, setup.table.copy())
        let (members, legacy) = try noise_settings(zip, setup.settings)
        let source = try source_of(zip, setup)
        var functions = Functions.new(legacy, setup.seed)
        let rule_value = get(members, "material_rule") else fail "the noise settings {setup.settings} have no `material_rule`"
        let rules = try read_rules(mut functions, zip, setup.biomes, facts.codec, rule_value)
        let carvers = try Carvers.of_biomes(zip, setup.biomes, source.possible(), facts.codec, setup.uncarvable)
        let router = match get(members, "noise_router") {
            some(Json.Object(m)) => m,
            _ => fail "the noise settings {setup.settings} have no router",
        }
        let climate = try climate_of(mut functions, zip, router)
        let shape = try read_shape(mut functions, zip, members, facts.codec, facts.table)
        let mat = try materials(mut functions, zip, members, shape, facts.codec, setup.biomes, source.possible(), setup.min_y, setup.height)
        return Terrain { functions: functions, shape: shape, biomes: SourceBiomes.new(source, climate, setup.seed), mat: mat, rules: rules, carvers: carvers, table: facts.table.copy(), seed: setup.seed, min_y: setup.min_y, height: setup.height, corners: Corners.new() }
    }

    /// The chunk's terrain: filled, with its beardifier, then its materials, then carved.
    pub fn make(mut self, job: own TerrainJob) -> Filled ! Thrown {
        let x = job.x
        let z = job.z
        var zoom = Zoom { chunk_x: x, chunk_z: z, min_y: self.min_y, height: self.height, seed: self.biomes.seed, chunks: job.biomes }
        var ctx = Context.new(true)
        ctx.beard = job.beard
        let (made, noise_aquifer) = try fill_noise(mut self.functions, self.shape, self.table, mut ctx, x, z, self.min_y, self.height)
        var f = made
        var aquifer = noise_aquifer
        let (_, noise_height) = clamped(self.shape, self.min_y, self.height)
        if noise_height > 0 {
            try build_surface(mut f, mut self.functions, self.mat, self.rules, self.table, mut ctx, mut zoom, x, z)
            try carve_chunk(mut f, mut self.functions, self.shape, self.mat, self.rules, self.table, mut ctx, mut aquifer, mut self.biomes, mut self.corners, self.carvers, self.seed, x, z)
        }
        return f
    }
}

// One of a spawn target's parameters: the density function's sampler, and its range.
struct TargetParameter {
    sampler: usize
    range: Parameter
}

/// What does the generator's jobs on one thread.
pub struct Worker {
    // Vanilla's data, which every copy of the worker reads, so the archive is in memory once
    // however many threads make chunks (D220).
    zip: Shared<Data>
    rd: Readers
    g: Gen
    w: StructureWorld
    placer: Placer
    state: StructureState
    terrain: Terrain
    kernel: List<f32>
    seed: i64
    // The noise settings' `spawn_target`.
    targets: List<List<TargetParameter>>
}

impl Worker {
    /// The worker `setup` says, from vanilla's data in `zip`.
    pub fn new(zip: own Data, setup: GenSetup) -> Worker ! String {
        let terrain = try Terrain.new(zip, setup)
        let (members, legacy) = try noise_settings(zip, setup.settings)
        let source = try source_of(zip, setup)
        let facts = try Facts.new(setup.blocks, setup.fluids, setup.table.copy())
        let rd = Readers { blocks: setup.blocks.copy(), fluids: setup.fluids.copy(), biomes: setup.biomes.copy() }
        var catalog = Catalog.new()
        let decoration = try Decoration.of_biomes(mut catalog, zip, facts, rd, source.possible())
        // Structures sample the noise through functions of their own, as terrain does through
        // its own, so neither's caches are the other's.
        var functions = Functions.new(legacy, setup.seed)
        let router = match get(members, "noise_router") {
            some(Json.Object(m)) => m,
            _ => fail "the noise settings {setup.settings} have no router",
        }
        let climate = try climate_of(mut functions, zip, router)
        let shape = try read_shape(mut functions, zip, members, facts.codec, facts.table)
        var targets = List<List<TargetParameter>>()
        if let Json.Array(points) = get(members, "spawn_target") {
            for point in points {
                let Json.Object(entries) = point else fail "a spawn target isn't a map"
                var parameters = List<TargetParameter>()
                for e in entries {
                    let f = try functions.read(zip, Json.Str(e.key.copy()))
                    let s = match functions.sampler(f) {
                        ok(s) => s,
                        err(t) => fail "the spawn target's `{e.key}` doesn't compile: {t.exception}: {t.message}",
                    }
                    parameters.push(TargetParameter { sampler: s, range: try read_parameter(e.value) })
                }
                targets.push(parameters)
            }
        }
        let structures = try Structures.read(zip, setup.biomes)
        let state = StructureState.new(structures, source.possible(), setup.seed)
        let order = registry_order(structures)
        let blocking = try holder_set(setup.biomes, Json.Str(String("#minecraft:mineshaft_blocking")))
        let placer = Placer { structures: structures, pools: Pools.new(), order: order, elements: ElementCache.new(), mineshaft_blocking: blocking }
        let world_facts = facts.copy()
        let env = Env { facts: facts, ctx: terrain.mat.gen, sky_light: setup.sky_light, gen_depth: shape.height }
        let g = Gen.new(env, catalog, decoration, terrain.mat.temps.copy())
        let w = StructureWorld { functions: functions, shape: shape, facts: world_facts, biomes: SourceBiomes.new(source, climate, setup.seed), templates: Templates.new(), temps: terrain.mat.temps.copy(), level_min: setup.min_y, level_height: setup.height, seed: setup.seed }
        return Worker { zip: Shared(zip), rd: rd, g: g, w: w, placer: placer, state: state, terrain: terrain, kernel: beard_kernel(), seed: setup.seed, targets: targets }
    }

    /// Starts the service, on a thread of its own, that sees each structure template is loaded
    /// once for every copy of this worker, by the first to ask for it (D294), and points this
    /// worker at it, and so each copy made of it after. Gives a link to the service, which can
    /// tell it to let go of the templates it holds.
    pub fn serve_templates(mut self) -> Sender<TemplateAsk> {
        let asks = Receiver<TemplateAsk>()
        let link = asks.sender()
        self.w.templates.service = some(asks.sender())
        _ = unsafe { Thread.spawn(TemplateService { asks: asks }) }
        return link
    }

    /// The world's bottom and height.
    pub fn level(self) -> (i32, i32) {
        return (self.w.level_min, self.w.level_height)
    }

    /// The block states' table the chunks are made with.
    pub fn table(self) -> BlockStates {
        return self.g.env.facts.table.copy()
    }

    /// The structures, as the starts name them.
    pub fn structures(self) -> Structures {
        return self.placer.structures.copy()
    }

    /// The searches that place the strongholds' rings.
    pub fn ring_searches(self) -> List<RingSearch> {
        return self.state.ring_searches(self.placer.structures)
    }

    /// `NoiseBasedChunkGenerator.getOrigin`: the chunk a new world's spawn is looked for from, as
    /// `NoiseSpawnFinder` finds it, where the settings' spawn target fits best near the origin.
    /// The chunk at the origin if there's no target.
    pub fn origin(self) -> (i32, i32) ! Thrown {
        if self.targets.is_empty() {
            return (0, 0)
        }
        var ctx = Context.new(true)
        var best = (0, 0, try self.fitness(mut ctx, 0, 0))
        best = try self.radial(mut ctx, best, 2048.0f32, 512.0f32)
        best = try self.radial(mut ctx, best, 512.0f32, 32.0f32)
        let (x, z, _) = best
        return (x >> 4, z >> 4)
    }

    // `NoiseSpawnFinder.radialSearch`: rings around the best so far, `step` apart out to `most`,
    // each with a point every `step` along it. Java's `Math.sin` may be a bit off the true sine,
    // which `std.math.sin` is within half a unit of; only a product a hair from a whole number
    // could tell them apart.
    fn radial(self, ctx: mut Context, from: (i32, i32, i64), most: f32, step: f32) -> (i32, i32, i64) ! Thrown {
        var best = from
        let (ox, oz, _) = from
        var angle = 0.0f32
        var radius = step
        while radius <= most {
            let x = ox + i32.saturate(sin(f64(angle)) * f64(radius))
            let z = oz + i32.saturate(cos(f64(angle)) * f64(radius))
            let f = try self.fitness(mut ctx, x, z)
            let (_, _, best_fitness) = best
            if f < best_fitness {
                best = (x, z, f)
            }
            angle += step / radius
            if f64(angle) > PI * 2.0 {
                angle = 0.0f32
                radius += step
            }
        }
        return best
    }

    // `getSpawnPositionAndFitness`: how far the climate at the quart holding the block is from
    // the nearest target, scaled, plus the square of the distance to the origin.
    fn fitness(self, ctx: mut Context, x: i32, z: i32) -> i64 ! Thrown {
        let qx = (x >> 2) << 2
        let qz = (z >> 2) << 2
        var least = i64.MAX
        for point in self.targets {
            var fit: i64 = 0
            for p in point {
                let v = quantize(try sample(self.w.functions.program, mut ctx, p.sampler, qx, 0, qz))
                let above = v - p.range.max
                let below = p.range.min - v
                let d = if above > 0 { above } else { below.max(0) }
                fit += d * d
            }
            least = least.min(fit)
        }
        return least.wrapping_mul(2048 * 2048) + i64(x) * i64(x) + i64(z) * i64(z)
    }

    /// Does the job.
    pub fn run(mut self, job: own Job) -> Made {
        return match job {
            Job.Ring(r) => {
                let set = r.set
                let index = r.index
                match ring_search(mut self.w.biomes, self.w.functions.program, r) {
                    ok(c) => {
                        let (cx, cz) = c
                        Made.Ring(set, index, cx, cz, List<String>())
                    },
                    err(t) => Made.Ring(set, index, 0, 0, ["Couldn't place a stronghold ring position: {t.exception}: {t.message}"]),
                }
            },
            Job.Starts(bx, bz, rings) => {
                // The positions found so far, which hold every one the block's chunks can meet.
                self.state.set_rings(rings)
                self.starts(bx, bz)
            },
            Job.Biomes(bx, bz) => self.biomes(bx, bz),
            Job.Terrain(t) => self.make_terrain(t),
            Job.Decorate(d) => self.decorate(d),
            Job.Finish(f) => {
                let FinishJob { x: x, z: z, made: made, biomes: biomes, refs: refs, starts: starts } = f
                let rest = rest_of(self.g.env.facts, self.placer.structures, made, refs, starts)
                Made.Finished(x, z, to_chunk(self.g.env.facts.table, made, biomes), rest)
            },
        }
    }

    // `createStructures` for each chunk of the block.
    fn starts(mut self, bx: i32, bz: i32) -> Made {
        var lists = List<List<Start>>()
        var problems = List<String>()
        for z in bz << BLOCK_SHIFT..(bz + 1) << BLOCK_SHIFT {
            for x in bx << BLOCK_SHIFT..(bx + 1) << BLOCK_SHIFT {
                match create_structures(mut self.w, mut self.placer.pools, self.zip.value, self.placer.structures, mut self.state, x, z) {
                    ok(made) => lists.push(made),
                    err(t) => {
                        problems.push("Couldn't start the structures of chunk [{x}, {z}]: {t.exception}: {t.message}")
                        lists.push(List<Start>())
                    },
                }
            }
        }
        return Made.Starts(bx, bz, lists, problems)
    }

    // `BiomeSource.chunk` for each chunk of the block.
    fn biomes(mut self, bx: i32, bz: i32) -> Made {
        var lists = List<List<i32>>()
        var problems = List<String>()
        for z in bz << BLOCK_SHIFT..(bz + 1) << BLOCK_SHIFT {
            for x in bx << BLOCK_SHIFT..(bx + 1) << BLOCK_SHIFT {
                var b = List<i32>()
                match self.w.biomes.chunk(self.w.functions.program, x, z, self.w.level_min, self.w.level_height, mut b) {
                    ok => {},
                    err(t) => {
                        problems.push("Couldn't make the biomes of chunk [{x}, {z}]: {t.exception}: {t.message}")
                        b = [0; usize.wrap(self.w.level_height >> 2) * 16]
                    },
                }
                lists.push(b)
            }
        }
        return Made.Biomes(bx, bz, lists, problems)
    }

    // The chunk's terrain, its beardifier given its kernel here.
    fn make_terrain(mut self, job: own TerrainJob) -> Made {
        let x = job.x
        let z = job.z
        var j = job
        if let b = j.beard.take() {
            var beard = b
            beard.set_kernel(self.kernel.copy())
            j.beard = some(beard)
        }
        return match self.terrain.make(j) {
            ok(f) => Made.Terrain(x, z, RegionChunk.of(self.g.env.facts, f), List<String>()),
            err(t) => Made.Terrain(x, z, RegionChunk.of(self.g.env.facts, air_filled(self.w.level_min, self.w.level_height)), ["Couldn't make the terrain of chunk [{x}, {z}], so it's air: {t.exception}: {t.message}"]),
        }
    }

    // Decorates the job's chunk, in the region of the nine around it, its starts first pointed at
    // this worker's pools and templates.
    fn decorate(mut self, job: own DecorateJob) -> Made {
        let DecorateJob { x: x, z: z, chunks: chunks, biomes: biomes, refs: refs, starts: given } = job
        var starts = given
        var problems = List<String>()
        match self.localize(mut starts) {
            ok => {},
            err(t) => problems.push("Couldn't load the structures of chunk [{x}, {z}]: {t.exception}: {t.message}"),
        }
        let zoom = Zoom { chunk_x: x, chunk_z: z, min_y: self.w.level_min, height: self.w.level_height, seed: self.w.biomes.seed, chunks: biomes }
        var region_hash = self.w.functions.positional().from_hash_of(String("minecraft:worldgen_region_random"))
        let region_random = region_hash.fork_positional().at(x * 16, 0, z * 16)
        var r = Region.around(x, z, chunks, zoom, self.seed, self.w.shape.sea_level, region_random)
        if problems.is_empty() {
            match decorate_structured(self.g, self.w, self.placer, mut starts, refs, mut r, self.seed) {
                ok => {},
                err(t) => problems.push("Couldn't decorate chunk [{x}, {z}]: {t.exception}: {t.message}"),
            }
        }
        let Region { chunks: back, zoom: zoom_back, .. } = r
        return Made.Decorated(DecorateJob { x: x, z: z, chunks: back, biomes: zoom_back.chunks, refs: refs, starts: starts }, problems)
    }

    // Points the starts' pieces at this worker's pools and templates, which a start made on
    // another names by ID, and loads what their elements need.
    fn localize(mut self, starts: mut StartMap) ! Thrown {
        var keys = List<i64>()
        for (k, _) in starts.chunks {
            keys.push(k)
        }
        for k in keys {
            var list = starts.chunks.remove(k) else continue
            for s in 0..list.len() {
                for i in 0..list[s].pieces.len() {
                    let changed: PieceData? = match list[s].pieces[i].data {
                        PieceData.Jigsaw(j) => {
                            let pool = (try self.placer.pools.get(self.zip.value, j.pool_id)) else fail Thrown { exception: "IllegalStateException", message: "there's no template pool {j.pool_id}" }
                            if pool == j.pool {
                                none
                            } else {
                                var moved = j.copy()
                                moved.pool = pool
                                some(PieceData.Jigsaw(moved))
                            }
                        },
                        PieceData.Template(t) => {
                            let index = try self.w.template(self.zip.value, template_id(t))
                            if index == t.template {
                                none
                            } else {
                                var moved = t.copy()
                                moved.template = index
                                some(PieceData.Template(moved))
                            }
                        },
                        _ => none,
                    }
                    if let d = changed {
                        list[s].pieces[i].data = d
                    }
                }
                try self.placer.elements.prepare(mut self.g.catalog, mut self.w, self.placer.pools, self.zip.value, self.g.env.facts, self.rd, list[s].pieces)
            }
            starts.chunks.insert(k, list)
        }
    }
}

// The server's chunk from a finished chunk's blocks and its biomes, as `BiomeSource.chunk` gives
// them: a section at a time from the bottom, `x`, then `y`, then `z`.
/// What the chunk saves beside its blocks, biomes and heightmaps, as vanilla's `LevelChunk` made
/// from the `ProtoChunk` saves it once it's full (D288): its block entities, as
/// `saved_block_entities` gives them; its block and fluid ticks, each due now, as
/// `ProtoChunkTicks` keeps one scheduled while it's made; the blocks marked for post-processing
/// in each section; and its structures, its own starts by structure, and its references, each a
/// structure's chunks in their set's order, as `packStructureData` writes them.
pub fn rest_of(facts: Facts, structures: Structures, made: RegionChunk, refs: List<Refs>, starts: List<Start>) -> ChunkRest {
    var block_ticks = List<SavedTick>()
    for t in made.block_ticks {
        block_ticks.push(SavedTick { kind: t.kind, x: t.x, y: t.y, z: t.z, delay: 0, priority: t.priority })
    }
    var fluid_ticks = List<SavedTick>()
    for t in made.fluid_ticks {
        fluid_ticks.push(SavedTick { kind: t.kind, x: t.x, y: t.y, z: t.z, delay: 0, priority: t.priority })
    }
    var post = List<List<i16>?>()
    for i in 0..usize.wrap(made.filled.height) / 16 {
        var packed: List<i16>? = none
        if i < made.filled.marked.len() and not made.filled.marked[i].is_empty() {
            var list = List<i16>()
            for o in made.filled.marked[i] {
                list.push(i16.wrap(o))
            }
            packed = some(list)
        }
        post.push(packed)
    }
    var starts_tag = JavaHashMap<String, Tag>()
    for s in starts {
        starts_tag.insert(s.id.copy(), s.tag())
    }
    var refs_tag = JavaHashMap<String, Tag>()
    for r in refs {
        var longs = List<i64>()
        for k in r.chunks.values() {
            longs.push(k)
        }
        if not longs.is_empty() {
            refs_tag.insert(structures.structures[r.structure].id.copy(), Tag.LongArray(longs))
        }
    }
    var tag = JavaHashMap<String, Tag>()
    tag.insert("starts", Tag.Compound(starts_tag))
    tag.insert("References", Tag.Compound(refs_tag))
    return ChunkRest { block_entities: made.saved_block_entities(facts), block_ticks: block_ticks, fluid_ticks: fluid_ticks, post_processing: post, structures: Tag.Compound(tag) }
}

fn to_chunk(table: BlockStates, made: own RegionChunk, biomes: List<i32>) -> Chunk {
    let f = made.filled
    // The sections above the last the chunk kept are only air.
    let count = usize.wrap(f.height) / 16
    let stored = f.states.len() / 4096
    var sections = List<Section>()
    for s in 0..count {
        var states = PalettedContainer.new(AIR_STATE, table.block_strategy())
        let base = s * 4096
        if s < stored {
            for i in 0..4096usize {
                let v = u32(f.states[base + i])
                if v != AIR_STATE {
                    states.set_at(i, v)
                }
            }
        }
        let quarts = s * 64
        var b = PalettedContainer.new(u32.wrap(biomes[quarts]), table.biome_strategy())
        var i = quarts
        for x in 0..4 {
            for y in 0..4 {
                for z in 0..4 {
                    b.set(x, y, z, u32.wrap(biomes[i]))
                    i += 1
                }
            }
        }
        sections.push(Section.from(table, states, b))
    }
    var chunk = Chunk.of(f.min_y, sections)
    chunk.prime_heightmaps(table, [WORLD_SURFACE, OCEAN_FLOOR, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES])
    return chunk
}
