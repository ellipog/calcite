/// A Nether fortress's pieces placed as their chunks are decorated: bridges, their crossings
/// and ragged ends, the castle's rooms, corridors, stairs, balconies, entrance with its lava
/// well, stalk room with its nether wart, and the blaze spawner's throne; nether bricks filled
/// down under each to the ground, chests and the spawner placed once.
module worldgen.fortress_pieces

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.source.{RandomSource}
import worldgen.drawing.{Frame, UPDATE_CLIENTS, block_state, blocks, boxes, chest, facing, fill_down, place}
import worldgen.facts.{EAST, Facts, NORTH, SOUTH, WEST}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Field, Piece, PieceData, flag}
import worldgen.region.{Region}
import worldgen.template.{Bounds}

// The blocks a fortress is built of.
struct Bricks {
    bricks: u32
    air: u32
    fence: u32
    stairs: u32
    // Fences joined north and south, and west and east.
    ns: u32
    we: u32
}

/// `postProcess` of a fortress piece, by its type.
pub fn fortress_piece<T: RandomSource>(f: Facts, r: mut Region, random: mut T, piece: mut Piece, area: Bounds) ! Thrown {
    let fields = match piece.data {
        PieceData.Fields(list) => list.copy(),
        _ => fail Thrown { exception: "Unimplemented", message: "a {piece.kind} piece without its fields" },
    }
    let fr = Frame.of(piece)
    let fence = try block_state(f, "nether_brick_fence")
    let b = Bricks { bricks: try block_state(f, "nether_bricks"), air: f.ids.air_state, fence: fence, stairs: try block_state(f, "nether_brick_stairs"), ns: try joined(f, fence, true, false, true, false), we: try joined(f, fence, false, true, false, true) }
    let kind = piece.kind.copy()
    if kind == "minecraft:nebcr" or kind == "minecraft:nestart" {
        try bridge_crossing(f, mut r, fr, area, b)
    } else if kind == "minecraft:nebef" {
        try bridge_end(f, mut r, fr, area, b, int_field(fields, "Seed"))
    } else if kind == "minecraft:nebs" {
        try bridge_straight(f, mut r, fr, area, b)
    } else if kind == "minecraft:neccs" {
        try corridor_stairs(f, mut r, fr, area, b)
    } else if kind == "minecraft:nectb" {
        try t_balcony(f, mut r, fr, area, b)
    } else if kind == "minecraft:nece" {
        try entrance(f, mut r, fr, area, b)
    } else if kind == "minecraft:nescsc" {
        try boxes(f, mut r, fr, area, [0, 0, 0, 4, 1, 4], b.bricks)
        try boxes(f, mut r, fr, area, [0, 2, 0, 4, 5, 4], b.air)
        try boxes(f, mut r, fr, area, [0, 2, 0, 0, 5, 0, 4, 2, 0, 4, 5, 0, 0, 2, 4, 0, 5, 4, 4, 2, 4, 4, 5, 4, 0, 6, 0, 4, 6, 4], b.bricks)
        try fill_under(f, mut r, fr, area, b, 0, 4, 0, 4)
    } else if kind == "minecraft:nesclt" or kind == "minecraft:nescrt" {
        let left = kind == "minecraft:nesclt"
        var needs_chest = int_field(fields, "Chest") != 0
        try turn(f, mut r, mut random, fr, area, b, left, mut needs_chest)
        piece.data = PieceData.Fields(with_field(fields, "Chest", flag(needs_chest)))
    } else if kind == "minecraft:nesc" {
        try boxes(f, mut r, fr, area, [0, 0, 0, 4, 1, 4], b.bricks)
        try boxes(f, mut r, fr, area, [0, 2, 0, 4, 5, 4], b.air)
        try boxes(f, mut r, fr, area, [0, 2, 0, 0, 5, 4, 4, 2, 0, 4, 5, 4], b.bricks)
        try boxes(f, mut r, fr, area, [0, 3, 1, 0, 4, 1, 0, 3, 3, 0, 4, 3, 4, 3, 1, 4, 4, 1, 4, 3, 3, 4, 4, 3], b.ns)
        try boxes(f, mut r, fr, area, [0, 6, 0, 4, 6, 4], b.bricks)
        try fill_under(f, mut r, fr, area, b, 0, 4, 0, 4)
    } else if kind == "minecraft:necsr" {
        try stalk_room(f, mut r, fr, area, b)
    } else if kind == "minecraft:nemt" {
        var placed = int_field(fields, "Mob") != 0
        try throne(f, mut r, fr, area, b, mut placed)
        piece.data = PieceData.Fields(with_field(fields, "Mob", flag(placed)))
    } else if kind == "minecraft:nerc" {
        try boxes(f, mut r, fr, area, [0, 0, 0, 6, 1, 6], b.bricks)
        try boxes(f, mut r, fr, area, [0, 2, 0, 6, 7, 6], b.air)
        try boxes(f, mut r, fr, area, [0, 2, 0, 1, 6, 0, 0, 2, 6, 1, 6, 6, 5, 2, 0, 6, 6, 0, 5, 2, 6, 6, 6, 6, 0, 2, 0, 0, 6, 1, 0, 2, 5, 0, 6, 6, 6, 2, 0, 6, 6, 1, 6, 2, 5, 6, 6, 6, 2, 6, 0, 4, 6, 0], b.bricks)
        try boxes(f, mut r, fr, area, [2, 5, 0, 4, 5, 0], b.we)
        try boxes(f, mut r, fr, area, [2, 6, 6, 4, 6, 6], b.bricks)
        try boxes(f, mut r, fr, area, [2, 5, 6, 4, 5, 6], b.we)
        try boxes(f, mut r, fr, area, [0, 6, 2, 0, 6, 4], b.bricks)
        try boxes(f, mut r, fr, area, [0, 5, 2, 0, 5, 4], b.ns)
        try boxes(f, mut r, fr, area, [6, 6, 2, 6, 6, 4], b.bricks)
        try boxes(f, mut r, fr, area, [6, 5, 2, 6, 5, 4], b.ns)
        try fill_under(f, mut r, fr, area, b, 0, 6, 0, 6)
    } else if kind == "minecraft:nesr" {
        try boxes(f, mut r, fr, area, [0, 0, 0, 6, 1, 6], b.bricks)
        try boxes(f, mut r, fr, area, [0, 2, 0, 6, 10, 6], b.air)
        try boxes(f, mut r, fr, area, [0, 2, 0, 1, 8, 0, 5, 2, 0, 6, 8, 0, 0, 2, 1, 0, 8, 6, 6, 2, 1, 6, 8, 6, 1, 2, 6, 5, 8, 6], b.bricks)
        try boxes(f, mut r, fr, area, [0, 3, 2, 0, 5, 4, 6, 3, 2, 6, 5, 2, 6, 3, 4, 6, 5, 4], b.ns)
        place(f, mut r, fr, b.bricks, 5, 2, 5, area)
        try boxes(f, mut r, fr, area, [4, 2, 5, 4, 3, 5, 3, 2, 5, 3, 4, 5, 2, 2, 5, 2, 5, 5, 1, 2, 5, 1, 6, 5, 1, 7, 1, 5, 7, 4], b.bricks)
        try boxes(f, mut r, fr, area, [6, 8, 2, 6, 8, 4], b.air)
        try boxes(f, mut r, fr, area, [2, 6, 0, 4, 8, 0], b.bricks)
        try boxes(f, mut r, fr, area, [2, 5, 0, 4, 5, 0], b.we)
        try fill_under(f, mut r, fr, area, b, 0, 6, 0, 6)
    } else {
        fail Thrown { exception: "Unimplemented", message: "placing a {kind} piece" }
    }
}

fn int_field(fields: List<Field>, name: str) -> i32 {
    for each in fields {
        if each.name == String(name) {
            return each.value.number_int() ?? 0
        }
    }
    return 0
}

fn with_field(fields: List<Field>, name: str, value: own Tag) -> List<Field> {
    var out = fields.copy()
    for i in 0..out.len() {
        if out[i].name == String(name) {
            out[i].value = value.copy()
        }
    }
    return out
}

// A fence joined the ways given: north, east, south, west.
fn joined(f: Facts, fence: u32, north: bool, east: bool, south: bool, west: bool) -> u32 ! Thrown {
    var s = fence
    if north {
        s = try f.with_bool(s, String("north"), true)
    }
    if east {
        s = try f.with_bool(s, String("east"), true)
    }
    if south {
        s = try f.with_bool(s, String("south"), true)
    }
    if west {
        s = try f.with_bool(s, String("west"), true)
    }
    return s
}

// Nether bricks filled down from under each column of the piece in the ranges.
fn fill_under(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks, x0: i32, x1: i32, z0: i32, z1: i32) ! Thrown {
    for x in x0..x1 + 1 {
        for z in z0..z1 + 1 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
        }
    }
}

// `BridgeCrossing.postProcess`, which the start is too: two bridges crossing, their pillars
// filled down.
fn bridge_crossing(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    try boxes(f, mut r, fr, area, [7, 3, 0, 11, 4, 18, 0, 3, 7, 18, 4, 11], b.bricks)
    try boxes(f, mut r, fr, area, [8, 5, 0, 10, 7, 18, 0, 5, 8, 18, 7, 10], b.air)
    try boxes(f, mut r, fr, area, [7, 5, 0, 7, 5, 7, 7, 5, 11, 7, 5, 18, 11, 5, 0, 11, 5, 7, 11, 5, 11, 11, 5, 18, 0, 5, 7, 7, 5, 7, 11, 5, 7, 18, 5, 7, 0, 5, 11, 7, 5, 11, 11, 5, 11, 18, 5, 11, 7, 2, 0, 11, 2, 5, 7, 2, 13, 11, 2, 18, 7, 0, 0, 11, 1, 3, 7, 0, 15, 11, 1, 18], b.bricks)
    for x in 7..12 {
        for z in 0..3 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, 18 - z)
        }
    }
    try boxes(f, mut r, fr, area, [0, 2, 7, 5, 2, 11, 13, 2, 7, 18, 2, 11, 0, 0, 7, 3, 1, 11, 15, 0, 7, 18, 1, 11], b.bricks)
    for x in 0..3 {
        for z in 7..12 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
            try fill_down(f, mut r, fr, area, b.bricks, 18 - x, -1, z)
        }
    }
}

// `BridgeEndFiller.postProcess`: a bridge broken off, its rows of bricks cut at random lengths
// from its own seed.
fn bridge_end(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks, seed: i32) ! Thrown {
    var random = LegacyRandom.new(i64(seed))
    for x in 0..5 {
        for y in 3..5 {
            let z = random.next_int_below(8)
            try boxes(f, mut r, fr, area, [x, y, 0, x, y, z], b.bricks)
        }
    }
    var z = random.next_int_below(8)
    try boxes(f, mut r, fr, area, [0, 5, 0, 0, 5, z], b.bricks)
    z = random.next_int_below(8)
    try boxes(f, mut r, fr, area, [4, 5, 0, 4, 5, z], b.bricks)
    for x in 0..5 {
        let zx = random.next_int_below(5)
        try boxes(f, mut r, fr, area, [x, 2, 0, x, 2, zx], b.bricks)
    }
    for x in 0..5 {
        for y in 0..2 {
            let zx = random.next_int_below(3)
            try boxes(f, mut r, fr, area, [x, y, 0, x, y, zx], b.bricks)
        }
    }
}

// `BridgeStraight.postProcess`.
fn bridge_straight(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    try boxes(f, mut r, fr, area, [0, 3, 0, 4, 4, 18], b.bricks)
    try boxes(f, mut r, fr, area, [1, 5, 0, 3, 7, 18], b.air)
    try boxes(f, mut r, fr, area, [0, 5, 0, 0, 5, 18, 4, 5, 0, 4, 5, 18, 0, 2, 0, 4, 2, 5, 0, 2, 13, 4, 2, 18, 0, 0, 0, 4, 1, 3, 0, 0, 15, 4, 1, 18], b.bricks)
    for x in 0..5 {
        for z in 0..3 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, 18 - z)
        }
    }
    let nse = try f.with_bool(b.ns, String("east"), true)
    let nsw = try f.with_bool(b.ns, String("west"), true)
    try boxes(f, mut r, fr, area, [0, 1, 1, 0, 4, 1, 0, 3, 4, 0, 4, 4, 0, 3, 14, 0, 4, 14, 0, 1, 17, 0, 4, 17], nse)
    try boxes(f, mut r, fr, area, [4, 1, 1, 4, 4, 1, 4, 3, 4, 4, 4, 4, 4, 3, 14, 4, 4, 14, 4, 1, 17, 4, 4, 17], nsw)
}

// `CastleCorridorStairsPiece.postProcess`: a corridor stepping down, its roof following.
fn corridor_stairs(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    let stairs = try facing(f, b.stairs, SOUTH)
    for step in 0..10 {
        let floor = 1.max(7 - step)
        let roof = (floor + 5).max(14 - step).min(13)
        let z = step
        try boxes(f, mut r, fr, area, [0, 0, z, 4, floor, z], b.bricks)
        try boxes(f, mut r, fr, area, [1, floor + 1, z, 3, roof - 1, z], b.air)
        if step <= 6 {
            blocks(f, mut r, fr, area, [1, floor + 1, z, 2, floor + 1, z, 3, floor + 1, z], stairs)
        }
        try boxes(f, mut r, fr, area, [0, roof, z, 4, roof, z, 0, floor + 1, z, 0, roof - 1, z, 4, floor + 1, z, 4, roof - 1, z], b.bricks)
        if (step & 1) == 0 {
            try boxes(f, mut r, fr, area, [0, floor + 2, z, 0, floor + 3, z, 4, floor + 2, z, 4, floor + 3, z], b.ns)
        }
        for x in 0..5 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
        }
    }
}

// `CastleCorridorTBalconyPiece.postProcess`.
fn t_balcony(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    try boxes(f, mut r, fr, area, [0, 0, 0, 8, 1, 8], b.bricks)
    try boxes(f, mut r, fr, area, [0, 2, 0, 8, 5, 8], b.air)
    try boxes(f, mut r, fr, area, [0, 6, 0, 8, 6, 5, 0, 2, 0, 2, 5, 0, 6, 2, 0, 8, 5, 0], b.bricks)
    try boxes(f, mut r, fr, area, [1, 3, 0, 1, 4, 0, 7, 3, 0, 7, 4, 0], b.we)
    try boxes(f, mut r, fr, area, [0, 2, 4, 8, 2, 8], b.bricks)
    try boxes(f, mut r, fr, area, [1, 1, 4, 2, 2, 4, 6, 1, 4, 7, 2, 4], b.air)
    try boxes(f, mut r, fr, area, [1, 3, 8, 7, 3, 8], b.we)
    place(f, mut r, fr, try joined(f, b.fence, false, true, true, false), 0, 3, 8, area)
    place(f, mut r, fr, try joined(f, b.fence, false, false, true, true), 8, 3, 8, area)
    try boxes(f, mut r, fr, area, [0, 3, 6, 0, 3, 7, 8, 3, 6, 8, 3, 7], b.ns)
    try boxes(f, mut r, fr, area, [0, 3, 4, 0, 5, 5, 8, 3, 4, 8, 5, 5, 1, 3, 5, 2, 5, 5, 6, 3, 5, 7, 5, 5], b.bricks)
    try boxes(f, mut r, fr, area, [1, 4, 5, 1, 5, 5, 7, 4, 5, 7, 5, 5], b.we)
    for z in 0..6 {
        for x in 0..9 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
        }
    }
}

// The castle's tall rooms' shared walls, battlements and footings: the entrance's and the stalk
// room's.
fn castle_hall(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    try boxes(f, mut r, fr, area, [0, 3, 0, 12, 4, 12], b.bricks)
    try boxes(f, mut r, fr, area, [0, 5, 0, 12, 13, 12], b.air)
    try boxes(f, mut r, fr, area, [0, 5, 0, 1, 12, 12, 11, 5, 0, 12, 12, 12, 2, 5, 11, 4, 12, 12, 8, 5, 11, 10, 12, 12, 5, 9, 11, 7, 12, 12, 2, 5, 0, 4, 12, 1, 8, 5, 0, 10, 12, 1, 5, 9, 0, 7, 12, 1, 2, 11, 2, 10, 12, 10], b.bricks)
}

fn battlements(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    var i = 1
    while i <= 11 {
        try boxes(f, mut r, fr, area, [i, 10, 0, i, 11, 0, i, 10, 12, i, 11, 12], b.we)
        try boxes(f, mut r, fr, area, [0, 10, i, 0, 11, i, 12, 10, i, 12, 11, i], b.ns)
        blocks(f, mut r, fr, area, [i, 13, 0, i, 13, 12, 0, 13, i, 12, 13, i], b.bricks)
        if i != 11 {
            blocks(f, mut r, fr, area, [i + 1, 13, 0, i + 1, 13, 12], b.we)
            blocks(f, mut r, fr, area, [0, 13, i + 1, 12, 13, i + 1], b.ns)
        }
        i += 2
    }
    place(f, mut r, fr, try joined(f, b.fence, true, true, false, false), 0, 13, 0, area)
    place(f, mut r, fr, try joined(f, b.fence, false, true, true, false), 0, 13, 12, area)
    place(f, mut r, fr, try joined(f, b.fence, false, false, true, true), 12, 13, 12, area)
    place(f, mut r, fr, try joined(f, b.fence, true, false, false, true), 12, 13, 0, area)
}

fn hall_footing(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    try boxes(f, mut r, fr, area, [4, 2, 0, 8, 2, 12, 0, 2, 4, 12, 2, 8, 4, 0, 0, 8, 1, 3, 4, 0, 9, 8, 1, 12, 0, 0, 4, 3, 1, 8, 9, 0, 4, 12, 1, 8], b.bricks)
    for x in 4..9 {
        for z in 0..3 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, 12 - z)
        }
    }
    for x in 0..3 {
        for z in 4..9 {
            try fill_down(f, mut r, fr, area, b.bricks, x, -1, z)
            try fill_down(f, mut r, fr, area, b.bricks, 12 - x, -1, z)
        }
    }
}

// `CastleEntrance.postProcess`: the hall, its battlements, and a lava well in its middle.
fn entrance(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    try castle_hall(f, mut r, fr, area, b)
    try boxes(f, mut r, fr, area, [5, 8, 0, 7, 8, 0], b.fence)
    try battlements(f, mut r, fr, area, b)
    var z = 3
    while z <= 9 {
        try boxes(f, mut r, fr, area, [1, 7, z, 1, 8, z], try f.with_bool(b.ns, String("west"), true))
        try boxes(f, mut r, fr, area, [11, 7, z, 11, 8, z], try f.with_bool(b.ns, String("east"), true))
        z += 2
    }
    try hall_footing(f, mut r, fr, area, b)
    try boxes(f, mut r, fr, area, [5, 5, 5, 7, 5, 7], b.bricks)
    try boxes(f, mut r, fr, area, [6, 1, 6, 6, 4, 6], b.air)
    place(f, mut r, fr, b.bricks, 6, 0, 6, area)
    place(f, mut r, fr, f.default_state(f.ids.lava), 6, 5, 6, area)
    let wx = fr.x(6, 6)
    let wy = fr.y(5)
    let wz = fr.z(6, 6)
    if area.inside(wx, wy, wz) {
        r.schedule_fluid(f.fluid(f.default_state(f.ids.lava)), wx, wy, wz)
    }
}

// `CastleSmallCorridorLeftTurnPiece` and `...RightTurnPiece`: a corridor turning, a chest in
// its corner once if it wants one.
fn turn<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, b: Bricks, left: bool, needs_chest: mut bool) ! Thrown {
    try boxes(f, mut r, fr, area, [0, 0, 0, 4, 1, 4], b.bricks)
    try boxes(f, mut r, fr, area, [0, 2, 0, 4, 5, 4], b.air)
    let chest_x = if left { 3 } else { 1 }
    if left {
        try boxes(f, mut r, fr, area, [4, 2, 0, 4, 5, 4], b.bricks)
        try boxes(f, mut r, fr, area, [4, 3, 1, 4, 4, 1, 4, 3, 3, 4, 4, 3], b.ns)
        try boxes(f, mut r, fr, area, [0, 2, 0, 0, 5, 0, 0, 2, 4, 3, 5, 4], b.bricks)
    } else {
        try boxes(f, mut r, fr, area, [0, 2, 0, 0, 5, 4], b.bricks)
        try boxes(f, mut r, fr, area, [0, 3, 1, 0, 4, 1, 0, 3, 3, 0, 4, 3], b.ns)
        try boxes(f, mut r, fr, area, [4, 2, 0, 4, 5, 0, 1, 2, 4, 4, 5, 4], b.bricks)
    }
    try boxes(f, mut r, fr, area, [1, 3, 4, 1, 4, 4, 3, 3, 4, 3, 4, 4], b.we)
    if needs_chest and area.inside(fr.x(chest_x, 3), fr.y(2), fr.z(chest_x, 3)) {
        needs_chest = false
        _ = try chest(f, mut r, fr, area, mut random, chest_x, 2, 3, "minecraft:chests/nether_bridge")
    }
    try boxes(f, mut r, fr, area, [0, 6, 0, 4, 6, 4], b.bricks)
    try fill_under(f, mut r, fr, area, b, 0, 4, 0, 4)
}

// `CastleStalkRoom.postProcess`: the hall, its battlements, a stair up the middle, and soul
// sand beds of nether wart.
fn stalk_room(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks) ! Thrown {
    try castle_hall(f, mut r, fr, area, b)
    let nsw = try f.with_bool(b.ns, String("west"), true)
    let nse = try f.with_bool(b.ns, String("east"), true)
    try battlements(f, mut r, fr, area, b)
    var z = 3
    while z <= 9 {
        try boxes(f, mut r, fr, area, [1, 7, z, 1, 8, z], nsw)
        try boxes(f, mut r, fr, area, [11, 7, z, 11, 8, z], nse)
        z += 2
    }
    let stairs = try facing(f, b.stairs, NORTH)
    for i in 0..7 {
        let sz = i + 4
        for x in 5..8 {
            place(f, mut r, fr, stairs, x, 5 + i, sz, area)
        }
        if sz >= 5 and sz <= 8 {
            try boxes(f, mut r, fr, area, [5, 5, sz, 7, i + 4, sz], b.bricks)
        } else if sz >= 9 and sz <= 10 {
            try boxes(f, mut r, fr, area, [5, 8, sz, 7, i + 4, sz], b.bricks)
        }
        if i >= 1 {
            try boxes(f, mut r, fr, area, [5, 6 + i, sz, 7, 9 + i, sz], b.air)
        }
    }
    for x in 5..8 {
        place(f, mut r, fr, stairs, x, 12, 11, area)
    }
    try boxes(f, mut r, fr, area, [5, 6, 7, 5, 7, 7], nse)
    try boxes(f, mut r, fr, area, [7, 6, 7, 7, 7, 7], nsw)
    try boxes(f, mut r, fr, area, [5, 13, 12, 7, 13, 12], b.air)
    try boxes(f, mut r, fr, area, [2, 5, 2, 3, 5, 3, 2, 5, 9, 3, 5, 10, 2, 5, 4, 2, 5, 8, 9, 5, 2, 10, 5, 3, 9, 5, 9, 10, 5, 10, 10, 5, 4, 10, 5, 8], b.bricks)
    let east = try facing(f, stairs, EAST)
    let west = try facing(f, stairs, WEST)
    blocks(f, mut r, fr, area, [4, 5, 2, 4, 5, 3, 4, 5, 9, 4, 5, 10], west)
    blocks(f, mut r, fr, area, [8, 5, 2, 8, 5, 3, 8, 5, 9, 8, 5, 10], east)
    let soul_sand = try block_state(f, "soul_sand")
    let wart = try block_state(f, "nether_wart")
    try boxes(f, mut r, fr, area, [3, 4, 4, 4, 4, 8, 8, 4, 4, 9, 4, 8], soul_sand)
    try boxes(f, mut r, fr, area, [3, 5, 4, 4, 5, 8, 8, 5, 4, 9, 5, 8], wart)
    try hall_footing(f, mut r, fr, area, b)
}

// `MonsterThrone.postProcess`: the throne room, and the blaze spawner once.
fn throne(f: Facts, r: mut Region, fr: Frame, area: Bounds, b: Bricks, placed: mut bool) ! Thrown {
    try boxes(f, mut r, fr, area, [0, 2, 0, 6, 7, 7], b.air)
    try boxes(f, mut r, fr, area, [1, 0, 0, 5, 1, 7, 1, 2, 1, 5, 2, 7, 1, 3, 2, 5, 3, 7, 1, 4, 3, 5, 4, 7, 1, 2, 0, 1, 4, 2, 5, 2, 0, 5, 4, 2, 1, 5, 2, 1, 5, 3, 5, 5, 2, 5, 5, 3, 0, 5, 3, 0, 5, 8, 6, 5, 3, 6, 5, 8, 1, 5, 8, 5, 5, 8], b.bricks)
    let west = try joined(f, b.fence, false, false, false, true)
    let east = try joined(f, b.fence, false, true, false, false)
    place(f, mut r, fr, west, 1, 6, 3, area)
    place(f, mut r, fr, east, 5, 6, 3, area)
    place(f, mut r, fr, try joined(f, b.fence, true, true, false, false), 0, 6, 3, area)
    place(f, mut r, fr, try joined(f, b.fence, true, false, false, true), 6, 6, 3, area)
    try boxes(f, mut r, fr, area, [0, 6, 4, 0, 6, 7, 6, 6, 4, 6, 6, 7], b.ns)
    place(f, mut r, fr, try joined(f, b.fence, false, true, true, false), 0, 6, 8, area)
    place(f, mut r, fr, try joined(f, b.fence, false, false, true, true), 6, 6, 8, area)
    try boxes(f, mut r, fr, area, [1, 6, 8, 5, 6, 8], b.we)
    place(f, mut r, fr, east, 1, 7, 8, area)
    try boxes(f, mut r, fr, area, [2, 7, 8, 4, 7, 8], b.we)
    place(f, mut r, fr, west, 5, 7, 8, area)
    place(f, mut r, fr, east, 2, 8, 8, area)
    place(f, mut r, fr, b.we, 3, 8, 8, area)
    place(f, mut r, fr, west, 4, 8, 8, area)
    if not placed {
        let wx = fr.x(3, 5)
        let wy = fr.y(5)
        let wz = fr.z(3, 5)
        if area.inside(wx, wy, wz) {
            placed = true
            _ = r.set_block(f, wx, wy, wz, try block_state(f, "spawner"), UPDATE_CLIENTS)
            if let kind = try r.block_entity(f, wx, wy, wz) {
                if kind == "minecraft:mob_spawner" {
                    r.set_spawner_entity(wx, wy, wz, String("minecraft:blaze"))
                }
            }
        }
    }
    try fill_under(f, mut r, fr, area, b, 0, 6, 0, 6)
}
