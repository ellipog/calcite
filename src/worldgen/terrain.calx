/// A noise settings' terrain shape: its final density through its aquifer, as
/// `NoiseBasedChunkGenerator` fills a chunk before its surface and carvers (`doFill`), and as it
/// gives a column's base blocks and heights (`iterateNoiseColumn`), in 26.3.
module worldgen.terrain

import json.tree.{Json, Member, as_i32, get}
import nbt.tag.{Tag}
import pack.data.{Data}
import random.any.{AnyPositional}
import world.block_flags.{FLUID}
import world.chunk.{AIR_STATE, BlockStates, OCEAN_FLOOR_WG, WORLD_SURFACE_WG}
import world.states.{StateCodec}
import worldgen.beardifier.{Beardifier}
import worldgen.density.{Functions}
import worldgen.interval.{Thrown}
import worldgen.noise.{Volume}
import worldgen.sampler.{Boxes, Context, Program, bounds_over, cells_of, fill, sample, volume, zeros}

/// What `computeSubstance` gives for a block the density makes solid: `null`, the default block.
const SOLID: u32 = 0xFFFFFFFF
/// `DimensionType.WAY_BELOW_MIN_Y`: an aquifer with no fluid has its surface here.
const WAY_BELOW_MIN_Y: i32 = -32512
/// The aquifer's location cache before a cell's location is picked: `Long.MAX_VALUE`.
const NO_LOCATION: i64 = 0x7FFFFFFFFFFFFFFF
/// The most cells an aquifer's caches hold. Vanilla runs out of memory long before a chunk in
/// the world needs this many; only coordinates near the ends of `int` ask for more.
const MAX_CELLS: i32 = 16777216
/// `FLOWING_UPDATE_SIMULARITY`: `similarity(10 * 10, 12 * 12)`.
const FLOWING: f64 = -0.76

/// `Aquifer.Config`'s functions, as read.
struct AquiferFunctions {
    barrier: usize
    floodedness: usize
    spread: usize
    lava: usize
    exclusion: usize
    surface: usize
}

/// The compiled samplers of `AquiferFunctions`.
struct AquiferSamplers {
    barrier: usize
    floodedness: usize
    spread: usize
    lava: usize
    exclusion: usize
    surface: usize
}

/// What filling with a noise settings needs of it.
pub struct Shape {
    /// `noise.min_y` and `noise.height`.
    pub min_y: i32
    pub height: i32
    pub default_block: u32
    pub default_fluid: u32
    pub sea_level: i32
    /// The router's `final_density`, as read.
    final_density: usize
    aquifers: AquiferFunctions?
    /// `getOrCreateRandomFactory("minecraft:aquifer")`.
    random: AnyPositional
    /// Lava's default state, and whether the default fluid is lava, water or air.
    lava: u32
    fluid_lava: bool
    fluid_water: bool
    fluid_air: bool
}

impl Shape {
    /// The generator's global fluid picker: lava up to -54 below the sea, and the default fluid
    /// up to the sea level above it.
    fn global(self, y: i32) -> FluidStatus {
        if y < (-54).min(self.sea_level) {
            return FluidStatus { level: -54, state: self.lava }
        }
        return FluidStatus { level: self.sea_level, state: self.default_fluid }
    }

    // `is(Blocks.LAVA)`, `is(Blocks.WATER)` and `isAir()` of the states a fluid status holds:
    // air, lava's default state and the default fluid.
    fn is_lava(self, state: u32) -> bool {
        return state == self.lava or (state == self.default_fluid and self.fluid_lava)
    }

    fn is_water(self, state: u32) -> bool {
        return state == self.default_fluid and self.fluid_water
    }

    fn is_air(self, state: u32) -> bool {
        return state == AIR_STATE or (state == self.default_fluid and self.fluid_air)
    }
}

/// `Aquifer.FluidStatus`: a fluid, up to below a level.
struct FluidStatus {
    level: i32
    state: u32
}

impl FluidStatus {
    fn at(self, y: i32) -> u32 {
        return if y < self.level { self.state } else { AIR_STATE }
    }

    fn same(self, other: FluidStatus) -> bool {
        return self.level == other.level and self.state == other.state
    }
}

/// The noise settings `members` as the terrain reads them, with their functions read into
/// `functions`, made for the settings' seed and random source.
pub fn read_shape(functions: mut Functions, zip: Data, members: List<Member>, codec: StateCodec, states: BlockStates) -> Shape ! String {
    let noise = match get(members, String("noise")) {
        some(Json.Object(m)) => m,
        _ => fail "the noise settings have no `noise`",
    }
    let min_y = try int_member(noise, "min_y")
    let height = try int_member(noise, "height")
    let default_block = try state_member(members, "default_block", codec)
    let default_fluid = try state_member(members, "default_fluid", codec)
    let sea_level = try int_member(members, "sea_level")
    let router = match get(members, String("noise_router")) {
        some(Json.Object(m)) => m,
        _ => fail "the noise settings have no `noise_router`",
    }
    let final_value = get(router, String("final_density")) else fail "the router has no `final_density`"
    let final_density = try functions.read(zip, final_value)
    var aquifers: AquiferFunctions? = none
    match get(members, String("aquifers")) {
        some(Json.Object(m)) => {
            let barrier = try function_member(mut functions, zip, m, "barrier")
            let floodedness = try function_member(mut functions, zip, m, "fluid_level_floodedness")
            let spread = try function_member(mut functions, zip, m, "fluid_level_spread")
            let lava = try function_member(mut functions, zip, m, "lava")
            let exclusion = try function_member(mut functions, zip, m, "exclusion")
            let surface = try function_member(mut functions, zip, m, "surface_level")
            aquifers = some(AquiferFunctions { barrier: barrier, floodedness: floodedness, spread: spread, lava: lava, exclusion: exclusion, surface: surface })
        },
        some(_) => fail "the noise settings' `aquifers` isn't an object",
        none => {},
    }
    let lava_block = try codec.blocks.parse(String("minecraft:lava"))
    let water_block = try codec.blocks.parse(String("minecraft:water"))
    let fluid_block = codec.block_of(default_fluid)
    return Shape {
        min_y: min_y,
        height: height,
        default_block: default_block,
        default_fluid: default_fluid,
        sea_level: sea_level,
        final_density: final_density,
        aquifers: aquifers,
        random: functions.random_factory(String("minecraft:aquifer")),
        lava: codec.default_state(lava_block),
        fluid_lava: fluid_block == lava_block,
        fluid_water: fluid_block == water_block,
        fluid_air: states.is_air(default_fluid),
    }
}

fn int_member(members: List<Member>, key: str) -> i32 ! String {
    let value = get(members, String(key)) else fail "missing `{key}`"
    let v = as_i32(value) else fail "`{key}` must be an int"
    return v
}

fn state_member(members: List<Member>, key: str, codec: StateCodec) -> u32 ! String {
    let value = get(members, String(key)) else fail "missing `{key}`"
    return try codec.decode(Tag.from_json(value))
}

fn function_member(functions: mut Functions, zip: Data, members: List<Member>, key: str) -> usize ! String {
    let value = get(members, String(key)) else fail "the aquifers have no `{key}`"
    return try functions.read(zip, value)
}

/// A chunk filled before its surface: its blocks from the bottom of the world up, each section
/// in y, z, x order, as `u16`, which every state fits, so a chunk kept while it's made takes
/// half the memory; its two `_WG` heightmaps by x + 16z, and the blocks marked for
/// post-processing by section, each as `ProtoChunk.packOffsetCoordinates` packs it.
pub struct Filled {
    pub min_y: i32
    pub height: i32
    pub states: List<u16>
    pub ocean_floor: List<i32>
    pub world_surface: List<i32>
    pub marked: List<List<u16>>
}

/// A column's base blocks, from `min_y` up: `getBaseColumn`.
pub struct Column {
    pub min_y: i32
    pub states: List<u32>
}

/// `NoiseSettings.clampToHeightAccessor`: the part of the noise inside the world, as its bottom
/// and height, the height 0 or less when there's none.
pub fn clamped(s: Shape, level_min: i32, level_height: i32) -> (i32, i32) {
    let low = s.min_y.max(level_min)
    let high = (s.min_y + s.height).min(level_min + level_height - 1 + 1)
    return (low, high - low)
}

/// `buildTerrain`'s fill of the chunk at `cx`, `cz` in a world `level_height` blocks tall from
/// `level_min`, with no structures to beardify and nothing to blend: `doFill` in a new
/// `NoiseChunk`.
pub fn fill_chunk(functions: mut Functions, s: Shape, states: BlockStates, cx: i32, cz: i32, level_min: i32, level_height: i32) -> Filled ! Thrown {
    var ctx = Context.new(true)
    return try fill_in(mut functions, s, states, mut ctx, cx, cz, level_min, level_height)
}

/// `fill_chunk` with the chunk's structures' beardifier bound, as `buildTerrain`'s `NoiseChunk`
/// binds it; none for `Beardifier.EMPTY`.
pub fn fill_bearded(functions: mut Functions, s: Shape, states: BlockStates, beard: own Beardifier?, cx: i32, cz: i32, level_min: i32, level_height: i32) -> Filled ! Thrown {
    var ctx = Context.new(true)
    ctx.beard = beard
    return try fill_in(mut functions, s, states, mut ctx, cx, cz, level_min, level_height)
}

/// `fill_chunk` through `ctx`, the `NoiseChunk`'s caching samplers, which the chunk's surface
/// samples through after it (`worldgen.material`).
pub fn fill_in(functions: mut Functions, s: Shape, states: BlockStates, ctx: mut Context, cx: i32, cz: i32, level_min: i32, level_height: i32) -> Filled ! Thrown {
    let (f, _) = try fill_noise(mut functions, s, states, mut ctx, cx, cz, level_min, level_height)
    return f
}

/// A chunk of nothing but air, as one is before it's filled.
pub fn air_filled(level_min: i32, level_height: i32) -> Filled {
    var out = Filled {
        min_y: level_min,
        height: level_height,
        states: [u16.wrap(AIR_STATE); usize.wrap(level_height) * 256],
        ocean_floor: [level_min; 256],
        world_surface: [level_min; 256],
        marked: [],
    }
    for _ in 0..level_height >> 4 {
        out.marked.push(List<u16>())
    }
    return out
}

/// `fill_in`, with the `NoiseChunk`'s aquifer after it, which the carvers fill the blocks they
/// carve through (`worldgen.carver`): a disabled one where the noise doesn't reach the world.
pub fn fill_noise(functions: mut Functions, s: Shape, states: BlockStates, ctx: mut Context, cx: i32, cz: i32, level_min: i32, level_height: i32) -> (Filled, Aquifer) ! Thrown {
    var out = air_filled(level_min, level_height)
    let (low, height) = clamped(s, level_min, level_height)
    if height <= 0 {
        return (out, Aquifer.disabled(s))
    }
    let v = try volume(16, height, 16, cx << 4, low, cz << 4, 1, 1, 1)
    var aquifer = try Aquifer.new(mut functions, s, mut ctx, v)
    let fd = try functions.sampler(s.final_density)
    // The density is filled a column of cells at a time, small enough for what each step of it
    // works out to stay near at hand, with each interpolated function's corners worked out once
    // for the chunk; a point's density is the same whatever part it's filled with.
    ctx.whole = some(v)
    let tile = TILE
    let across = 16 / tile
    // The layers of cells up a tile, each from a multiple of `g` or the bottom of the volume, so
    // a part of the tile from a layer is filled as the whole tile would be.
    let g = cells_of(functions.program)
    let base = low.floor_div(g) * g
    let layers = (low + height - base + g - 1) / g
    var cells = Cells { kinds: [UNKNOWN_CELL; usize.wrap(across * across * layers)], base: base, g: g, layers: layers }
    var density = List<f32>()
    var rows: List<u8> = [FILLED_Y; usize.wrap(height)]
    var marks = List<u64>()
    for tz in 0..across {
        for tx in 0..across {
            let tile_index = tz * across + tx
            if tile_index == 1 {
                // The first tile kept the corners of the interpolated samplers it filled, which
                // bound the density over every other tile's cells.
                prove(mut cells, functions.program, ctx, fd, aquifer, cx, cz, tile, across, low, height)
            }
            // Only the layers from the lowest to the highest not proven are filled.
            var first = -1
            var last = -1
            for j in 0..layers {
                if cells.kinds[usize.wrap(tile_index * layers + j)] == UNKNOWN_CELL {
                    if first == -1 {
                        first = j
                    }
                    last = j
                }
            }
            var tv = Volume { size_x: tile, size_y: 0, size_z: tile, min_x: (cx << 4) + tx * tile, min_y: low, min_z: (cz << 4) + tz * tile }
            if first != -1 {
                let bottom = low.max(base + first * g)
                let top = (low + height).min(base + (last + 1) * g)
                tv = try volume(tile, top - bottom, tile, (cx << 4) + tx * tile, bottom, (cz << 4) + tz * tile, 1, 1, 1)
                let n = usize.wrap(tv.size())
                density.truncate(n)
                while density.len() < n {
                    density.push(0.0f32)
                }
                try fill(functions.program, mut ctx, fd, mut density, tv)
            }
            // What each height of the tile's columns is, from the bottom, and the highest that
            // isn't proven air.
            for j in 0..layers {
                let kind = cells.kinds[usize.wrap(tile_index * layers + j)]
                let bottom = low.max(base + j * g)
                let top = (low + height).min(base + (j + 1) * g)
                for by in bottom..top {
                    var k = FILLED_Y
                    if by < tv.min_y or by >= tv.min_y + tv.size_y {
                        k = if kind == SOLID_CELL { SOLID_Y } else if s.global(by).at(by) == AIR_STATE { SKY_AIR_Y } else { SKY_FLUID_Y }
                    }
                    rows[usize.wrap(by - low)] = k
                }
            }
            var highest = height - 1
            while highest >= 0 and rows[usize.wrap(highest)] == SKY_AIR_Y {
                highest -= 1
            }
            for lz in 0..tile {
                for lx in 0..tile {
                    let x = tx * tile + lx
                    let z = tz * tile + lz
                    try fill_column(mut out, mut aquifer, mut marks, functions.program, mut ctx, s, states, density, tv, rows, highest, lx, lz, x, z, cx, cz, low, height, level_min)
                }
            }
        }
    }
    ctx.whole = none
    // The fluids to update, marked in the order the chunk's columns are filled whole.
    marks.sort()
    for m in marks {
        let by = low + height - 1 - i32.wrap((m >> 16) & 0xFFFF)
        out.marked[usize.wrap((by - level_min) >> 4)].push(u16.wrap(m & 0xFFFF))
    }
    return (out, aquifer)
}

// The blocks across a tile of columns, in blocks: its columns' densities are filled together.
const TILE: i32 = 4

// What's proven of a layer of a tile's cells: nothing, that the density is above 0 at every
// block, or that it's at most 0 at every block and only its sign is read there.
const UNKNOWN_CELL: u8 = 0
const SOLID_CELL: u8 = 1
const SKY_CELL: u8 = 2

// What's proven of each tile's layers of cells, `layers` a tile, each `g` blocks from a multiple
// of `g` from `base`.
struct Cells {
    kinds: List<u8>
    base: i32
    g: i32
    layers: i32
}

// What a height of a tile's columns is: filled, or proven solid, proven to be the global fluid,
// or proven to be air, which isn't set.
const FILLED_Y: u8 = 0
const SOLID_Y: u8 = 1
const SKY_FLUID_Y: u8 = 2
const SKY_AIR_Y: u8 = 3

// How far from 0 a bound must be for a layer to be proven.
const PROOF_MARGIN: f64 = 0.0001

/// The layers of every tile but the first proven, where the final density's bounds over them,
/// from the corners the first tile kept, are above 0, or at most 0 above every aquifer, where
/// `substance` reads only the density's sign (D241).
fn prove(cells: mut Cells, p: Program, ctx: Context, fd: usize, aquifer: Aquifer, cx: i32, cz: i32, tile: i32, across: i32, low: i32, height: i32) {
    var boxes = Boxes.new(tile, tile)
    for t in 1..across * across {
        let x = (cx << 4) + (t % across) * tile
        let z = (cz << 4) + (t / across) * tile
        for j in 0..cells.layers {
            let bottom = low.max(cells.base + j * cells.g)
            let top = (low + height).min(cells.base + (j + 1) * cells.g)
            boxes.add(x, bottom, z, top - bottom)
        }
    }
    let bounds = bounds_over(p, ctx, fd, boxes)
    var k: usize = 0
    for t in 1..across * across {
        for j in 0..cells.layers {
            let at = usize.wrap(t * cells.layers + j)
            if bounds.low[k] > PROOF_MARGIN {
                cells.kinds[at] = SOLID_CELL
            } else if bounds.high[k] < -PROOF_MARGIN and (not aquifer.enabled or boxes.y[k] > aquifer.skip_above) {
                cells.kinds[at] = SKY_CELL
            }
            k += 1
        }
    }
}

// The column at `x`, `z` of the chunk, from the top down, from its densities at `lx`, `lz` of
// `tv` and what `rows` says is proven of each height outside it, from `highest`, above which it's
// air: a solid block wherever the density is above 0, else what the aquifer says. Each fluid to
// update is noted in `marks` by its column, `z` first, then from the top down.
fn fill_column(out: mut Filled, aquifer: mut Aquifer, marks: mut List<u64>, p: Program, ctx: mut Context, s: Shape, states: BlockStates, density: List<f32>, tv: Volume, rows: List<u8>, highest: i32, lx: i32, lz: i32, x: i32, z: i32, cx: i32, cz: i32, low: i32, height: i32, level_min: i32) ! Thrown {
    {
        {
            let column = usize.wrap(x + z * 16)
            // The air above the highest isn't set, and `substance` would only have said so.
            if highest < height - 1 and aquifer.enabled {
                aquifer.schedule = false
            }
            var y = highest
            var at = tv.index(lx, tv.size_y - 1, lz)
            while y >= 0 {
                let by = low + y
                let row = rows[usize.wrap(y)]
                // `computeSubstance` gives a solid block wherever the density is above 0, and
                // what it notes for the fluid's update is noted afresh with each block it's asked.
                var state = s.default_block
                if row == FILLED_Y {
                    let d = f64(density[usize.wrap(at)])
                    at -= 1
                    if not (d > 0.0) {
                        if aquifer.enabled and by > aquifer.skip_above {
                            // Above every aquifer it gives the global fluid, as `substance` would.
                            aquifer.schedule = false
                            state = s.global(by).at(by)
                        } else {
                            state = try aquifer.substance(p, mut ctx, s, (cx << 4) + x, by, (cz << 4) + z, d)
                            if state == SOLID {
                                state = s.default_block
                            }
                        }
                    }
                } else if row != SOLID_Y {
                    // At most 0 where only its sign is read: the global fluid, as `substance`
                    // gives it, whether the aquifer is on or not.
                    if aquifer.enabled {
                        aquifer.schedule = false
                    }
                    state = if row == SKY_AIR_Y { AIR_STATE } else { s.global(by).at(by) }
                }
                if state != AIR_STATE {
                    out.states[usize.wrap(((by - level_min) << 8) | (z << 4) | x)] = u16.wrap(state)
                    update(mut out.ocean_floor, out.states, states, OCEAN_FLOOR_WG, column, x, z, by, state, level_min)
                    update(mut out.world_surface, out.states, states, WORLD_SURFACE_WG, column, x, z, by, state, level_min)
                    if aquifer.schedule and states.flags(state) & FLUID != 0 {
                        let packed = x | ((by & 15) << 4) | (z << 8)
                        marks.push((u64(column) << 32) | (u64.wrap(height - 1 - y) << 16) | u64.wrap(packed))
                    }
                }
                y -= 1
            }
        }
    }
}

/// `Heightmap.update` of a column of `filled`, after the block at `y` became `state`.
pub fn update(heights: mut List<i32>, filled: List<u16>, states: BlockStates, kind: i32, column: usize, x: i32, z: i32, y: i32, state: u32, level_min: i32) {
    let first = heights[column]
    if y <= first - 2 {
        return
    }
    if states.counts_in(kind, state) {
        if y >= first {
            heights[column] = y + 1
        }
    } else if first - 1 == y {
        var below = y - 1
        while below >= level_min {
            if states.counts_in(kind, u32(filled[usize.wrap(((below - level_min) << 8) | (z << 4) | x)])) {
                heights[column] = below + 1
                return
            }
            below -= 1
        }
        heights[column] = level_min
    }
}

/// `getBaseColumn`: the column's blocks before the surface, or none where the noise doesn't
/// reach the world.
pub fn base_column(functions: mut Functions, s: Shape, x: i32, z: i32, level_min: i32, level_height: i32) -> Column? ! Thrown {
    let (low, height) = clamped(s, level_min, level_height)
    if height <= 0 {
        return none
    }
    let v = try volume(1, height, 1, x, low, z, 1, 1, 1)
    var ctx = Context.new(true)
    var aquifer = try Aquifer.new(mut functions, s, mut ctx, v)
    let fd = try functions.sampler(s.final_density)
    var density = try zeros(v.size())
    try fill(functions.program, mut ctx, fd, mut density, v)
    var column: List<u32> = [AIR_STATE; usize.wrap(height)]
    var y = height - 1
    while y >= 0 {
        let d = f64(density[usize.wrap(y)])
        var state = try aquifer.substance(functions.program, mut ctx, s, x, low + y, z, d)
        if state == SOLID {
            state = s.default_block
        }
        column[usize.wrap(y)] = state
        y -= 1
    }
    return some(Column { min_y: low, states: column })
}

/// `getBaseHeight`: one above the highest of the column's base blocks heightmap `kind` counts,
/// or the bottom of the world.
pub fn base_height(column: Column?, states: BlockStates, kind: i32, level_min: i32) -> i32 {
    if let c = column {
        var y = c.states.len()
        while y > 0 {
            y -= 1
            if states.counts_in(kind, c.states[y]) {
                return c.min_y + i32.wrap(y) + 1
            }
        }
    }
    return level_min
}

/// `NoiseBasedAquifer`, or the disabled aquifer of settings with none.
pub struct Aquifer {
    enabled: bool
    samplers: AquiferSamplers
    random: AnyPositional
    // `aquiferCache`: whether each cell's status is known, and the status.
    known: List<bool>
    levels: List<i32>
    fluids: List<u32>
    // `aquiferLocationCache`.
    locations: List<i64>
    /// `shouldScheduleFluidUpdate`, of the last block.
    schedule: bool
    skip_above: i32
    min_gx: i32
    min_gy: i32
    min_gz: i32
    size_x: i32
    size_z: i32
    surface_cache: Map<i64, i32>
    // The grid cell the twelve near cells were found about, and each one's index and location,
    // in the order `computeSubstance` looks at them.
    near_at: (i32, i32, i32)
    near_index: [usize; 12]
    near_x: [i32; 12]
    near_y: [i32; 12]
    near_z: [i32; 12]
}

impl Aquifer {
    /// `Aquifer.createDisabled`: the global fluid picker's fluid wherever the density isn't solid.
    fn disabled(s: Shape) -> Aquifer {
        return Aquifer {
            enabled: false,
            samplers: AquiferSamplers { barrier: 0, floodedness: 0, spread: 0, lava: 0, exclusion: 0, surface: 0 },
            random: s.random,
            known: [],
            levels: [],
            fluids: [],
            locations: [],
            schedule: false,
            skip_above: 0,
            min_gx: 0,
            min_gy: 0,
            min_gz: 0,
            size_x: 0,
            size_z: 0,
            surface_cache: Map<i64, i32>(),
            near_at: (i32.MIN, i32.MIN, i32.MIN),
            near_index: [0; 12],
            near_x: [0; 12],
            near_y: [0; 12],
            near_z: [0; 12],
        }
    }

    /// `NoiseChunk`'s aquifer for the volume: `Aquifer.Config.create`, or `createDisabled`.
    fn new(functions: mut Functions, s: Shape, ctx: mut Context, v: Volume) -> Aquifer ! Thrown {
        var a = Aquifer.disabled(s)
        let f = s.aquifers else return a
        a.enabled = true
        a.samplers = AquiferSamplers {
            barrier: try functions.sampler(f.barrier),
            floodedness: try functions.sampler(f.floodedness),
            spread: try functions.sampler(f.spread),
            lava: try functions.sampler(f.lava),
            exclusion: try functions.sampler(f.exclusion),
            surface: try functions.sampler(f.surface),
        }
        a.min_gx = (v.min_x + -5) >> 4
        let max_gx = ((v.max_block_x() + -5) >> 4) + 1
        a.size_x = max_gx - a.min_gx + 1
        a.min_gy = (v.min_y + 1).floor_div(12) + -1
        let max_gy = (v.max_block_y() + 1).floor_div(12) + 1
        let size_y = max_gy - a.min_gy + 1
        a.min_gz = (v.min_z + -5) >> 4
        let max_gz = ((v.max_block_z() + -5) >> 4) + 1
        a.size_z = max_gz - a.min_gz + 1
        let total = a.size_x * size_y * a.size_z
        if total < 0 {
            fail Thrown { exception: "NegativeArraySizeException", message: "{total}" }
        }
        if total > MAX_CELLS {
            fail Thrown { exception: "OutOfMemoryError", message: "Java heap space" }
        }
        let cells = usize.wrap(total)
        a.known = [false; cells]
        a.levels = [0; cells]
        a.fluids = [0; cells]
        a.locations = [NO_LOCATION; cells]
        let min_x = a.min_gx << 4
        let min_z = a.min_gz << 4
        let max_surface = try a.max_surface_level(functions.program, mut ctx, min_x, min_z, (max_gx << 4) + 9, (max_gz << 4) + 9)
        let skip_grid_y = (max_surface + 8 + 12).floor_div(12) - -1
        a.skip_above = skip_grid_y * 12 + 11 - 1
        return a
    }

    /// `maxSurfaceLevel`: the highest preliminary surface at the quarts of the box, sampled as
    /// a volume, which also fills the surface cache.
    fn max_surface_level(mut self, p: Program, ctx: mut Context, min_x: i32, min_z: i32, max_x: i32, max_z: i32) -> i32 ! Thrown {
        let min_qx = min_x >> 2
        let max_qx = max_x >> 2
        let min_qz = min_z >> 2
        let max_qz = max_z >> 2
        let v = try volume(max_qx - min_qx + 1, 1, max_qz - min_qz + 1, min_qx << 2, 0, min_qz << 2, 4, 1, 4)
        var buffer = try zeros(v.size())
        try fill(p, mut ctx, self.samplers.surface, mut buffer, v)
        var max_y = i32.MIN
        for z in 0..v.size_z {
            for x in 0..v.size_x {
                let level = floor(f64(buffer[usize.wrap(v.index(x, 0, z))]))
                self.surface_cache.insert(chunk_pack(v.block_x(x), v.block_z(z)), level)
                if level > max_y {
                    max_y = level
                }
            }
        }
        return max_y
    }

    /// `surfaceLevel`: the preliminary surface at the block's quart.
    fn surface_level(mut self, p: Program, ctx: mut Context, x: i32, z: i32) -> i32 ! Thrown {
        let qx = (x >> 2) << 2
        let qz = (z >> 2) << 2
        let key = chunk_pack(qx, qz)
        if let level = self.surface_cache.get(key) {
            return level
        }
        let level = floor(f64(try sample(p, mut ctx, self.samplers.surface, qx, 0, qz)))
        self.surface_cache.insert(key, level)
        return level
    }

    /// `getIndex`, with the bounds Java's arrays check.
    fn index(self, gx: i32, gy: i32, gz: i32) -> usize ! Thrown {
        let i = ((gy - self.min_gy) * self.size_z + (gz - self.min_gz)) * self.size_x + (gx - self.min_gx)
        if i < 0 or usize.wrap(i) >= self.locations.len() {
            fail Thrown { exception: "ArrayIndexOutOfBoundsException", message: "Index {i} out of bounds for length {self.locations.len()}" }
        }
        return usize.wrap(i)
    }

    /// `computeSubstance` at a block the carvers carve, of density 0: none where the barrier
    /// between two aquifers keeps it solid.
    pub fn carved(mut self, p: Program, ctx: mut Context, s: Shape, x: i32, y: i32, z: i32) -> u32? ! Thrown {
        let state = try self.substance(p, mut ctx, s, x, y, z, 0.0)
        if state == SOLID {
            return none
        }
        return some(state)
    }

    /// `shouldScheduleFluidUpdate`: whether the last block's fluid is at the edge of its
    /// aquifer, so it should flow once the chunk is in the world. Never for the disabled aquifer.
    pub fn schedules(self) -> bool {
        return self.schedule
    }

    /// `computeSubstance`: the block at a point of the given density, `SOLID` for the default
    /// block.
    fn substance(mut self, p: Program, ctx: mut Context, s: Shape, x: i32, y: i32, z: i32, density: f64) -> u32 ! Thrown {
        if not self.enabled {
            return if density > 0.0 { SOLID } else { s.global(y).at(y) }
        }
        if density > 0.0 {
            self.schedule = false
            return SOLID
        }
        let global = s.global(y)
        if y > self.skip_above {
            self.schedule = false
            return global.at(y)
        }
        if s.is_lava(global.at(y)) {
            self.schedule = false
            return s.lava
        }
        let xa = (x + -5) >> 4
        let ya = (y + 1).floor_div(12)
        let za = (z + -5) >> 4
        if self.near_at != (xa, ya, za) {
            try self.find_near(xa, ya, za)
        }
        // The four nearest, as vanilla's insertion keeps them: by distance, and of two as near,
        // the later first. Each cell's key is its distance, then 15 less its place, so the four
        // least keys are those four in that order. A cell is at most 25 blocks away on each
        // axis, so a key fits easily.
        var keys: [i32; 12] = [0; 12]
        for k in 0..12usize {
            let dx = self.near_x[k] - x
            let dy = self.near_y[k] - y
            let dz = self.near_z[k] - z
            keys[k] = ((dx * dx + dy * dy + dz * dz) << 4) | (15 - i32.wrap(k))
        }
        var k1 = i32.MAX
        for k in 0..12usize {
            k1 = k1.min(keys[k])
        }
        var k2 = i32.MAX
        for k in 0..12usize {
            let key = keys[k]
            k2 = if key > k1 { k2.min(key) } else { k2 }
        }
        let d1 = k1 >> 4
        let d2 = k2 >> 4
        let c1 = self.near_index[usize.wrap(15 - (k1 & 15))]
        let c2 = self.near_index[usize.wrap(15 - (k2 & 15))]
        let st1 = try self.status(p, mut ctx, s, c1)
        let sim12 = similarity(d1, d2)
        let fluid = st1.at(y)
        if sim12 <= 0.0 {
            if sim12 >= FLOWING {
                let st2 = try self.status(p, mut ctx, s, c2)
                self.schedule = not st1.same(st2)
            } else {
                self.schedule = false
            }
            return fluid
        }
        if s.is_water(fluid) and s.is_lava(s.global(y - 1).at(y - 1)) {
            self.schedule = true
            return fluid
        }
        // The third and fourth nearest, which only what's left needs.
        var k3 = i32.MAX
        for k in 0..12usize {
            let key = keys[k]
            k3 = if key > k2 { k3.min(key) } else { k3 }
        }
        var k4 = i32.MAX
        for k in 0..12usize {
            let key = keys[k]
            k4 = if key > k3 { k4.min(key) } else { k4 }
        }
        let d3 = k3 >> 4
        let d4 = k4 >> 4
        let c3 = self.near_index[usize.wrap(15 - (k3 & 15))]
        let c4 = self.near_index[usize.wrap(15 - (k4 & 15))]
        var barrier = f64.NAN
        let st2 = try self.status(p, mut ctx, s, c2)
        let b12 = sim12 * try self.pressure(p, mut ctx, s, x, y, z, mut barrier, st1, st2)
        if density + b12 > 0.0 {
            self.schedule = false
            return SOLID
        }
        let st3 = try self.status(p, mut ctx, s, c3)
        let sim13 = similarity(d1, d3)
        if sim13 > 0.0 {
            let b13 = sim12 * sim13 * try self.pressure(p, mut ctx, s, x, y, z, mut barrier, st1, st3)
            if density + b13 > 0.0 {
                self.schedule = false
                return SOLID
            }
        }
        let sim23 = similarity(d2, d3)
        if sim23 > 0.0 {
            let b23 = sim12 * sim23 * try self.pressure(p, mut ctx, s, x, y, z, mut barrier, st2, st3)
            if density + b23 > 0.0 {
                self.schedule = false
                return SOLID
            }
        }
        let flow12 = not st1.same(st2)
        let flow23 = sim23 >= FLOWING and not st2.same(st3)
        let flow13 = sim13 >= FLOWING and not st1.same(st3)
        if not flow12 and not flow23 and not flow13 {
            var schedule = false
            if sim13 >= FLOWING and similarity(d1, d4) >= FLOWING {
                let st4 = try self.status(p, mut ctx, s, c4)
                schedule = not st1.same(st4)
            }
            self.schedule = schedule
        } else {
            self.schedule = true
        }
        return fluid
    }

    // The twelve cells about the grid cell, each's location worked out the first time it's
    // needed, as `computeSubstance` goes over them: `x` outermost, then `y` from below, then `z`.
    fn find_near(mut self, xa: i32, ya: i32, za: i32) ! Thrown {
        var k: usize = 0
        for x1 in 0..2 {
            for y1 in -1..2 {
                for z1 in 0..2 {
                    let gx = xa + x1
                    let gy = ya + y1
                    let gz = za + z1
                    let index = try self.index(gx, gy, gz)
                    var location = self.locations[index]
                    if location == NO_LOCATION {
                        var r = self.random.at(gx, gy, gz)
                        let ox = r.next_int_below(10)
                        let oy = r.next_int_below(9)
                        let oz = r.next_int_below(10)
                        location = block_pack((gx << 4) + ox, gy * 12 + oy, (gz << 4) + oz)
                        self.locations[index] = location
                    }
                    self.near_index[k] = index
                    self.near_x[k] = block_x(location)
                    self.near_y[k] = block_y(location)
                    self.near_z[k] = block_z(location)
                    k += 1
                }
            }
        }
        self.near_at = (xa, ya, za)
    }

    /// `calculatePressure`: how much the barrier between two aquifers holds, sampling the
    /// barrier noise at most once for the block.
    fn pressure(self, p: Program, ctx: mut Context, s: Shape, x: i32, y: i32, z: i32, barrier: mut f64, a: FluidStatus, b: FluidStatus) -> f64 ! Thrown {
        let t1 = a.at(y)
        let t2 = b.at(y)
        if (s.is_lava(t1) and s.is_water(t2)) or (s.is_water(t1) and s.is_lava(t2)) {
            return 2.0
        }
        let diff = (a.level - b.level).abs()
        if diff == 0 {
            return 0.0
        }
        let average = 0.5 * f64(a.level + b.level)
        let above = f64(y) + 0.5 - average
        let base = f64(diff) / 2.0
        let toward = base - above.abs()
        var gradient: f64 = 0.0
        if above > 0.0 {
            let center = 0.0 + toward
            gradient = if center > 0.0 { center / 1.5 } else { center / 2.5 }
        } else {
            let center = 3.0 + toward
            gradient = if center > 0.0 { center / 3.0 } else { center / 10.0 }
        }
        var noise: f64 = 0.0
        if not (gradient < -2.0) and not (gradient > 2.0) {
            if barrier != barrier {
                let v = f64(try sample(p, mut ctx, self.samplers.barrier, x, y, z))
                barrier = v
                noise = v
            } else {
                noise = barrier
            }
        }
        return 2.0 * (noise + gradient)
    }

    /// `getAquiferStatus`: the fluid of a cell, worked out the first time it's asked for.
    fn status(mut self, p: Program, ctx: mut Context, s: Shape, index: usize) -> FluidStatus ! Thrown {
        if self.known[index] {
            return FluidStatus { level: self.levels[index], state: self.fluids[index] }
        }
        let location = self.locations[index]
        let st = try self.compute_fluid(p, mut ctx, s, block_x(location), block_y(location), block_z(location))
        self.known[index] = true
        self.levels[index] = st.level
        self.fluids[index] = st.state
        return st
    }

    /// `computeFluid`: an aquifer's fluid from the surface around its location.
    fn compute_fluid(mut self, p: Program, ctx: mut Context, s: Shape, x: i32, y: i32, z: i32) -> FluidStatus ! Thrown {
        let global = s.global(y)
        var lowest = i32.MAX
        let top = y + 12
        let bottom = y - 12
        var center_under = false
        let offsets: [i32; 26] = [0, 0, -2, -1, -1, -1, 0, -1, 1, -1, -3, 0, -2, 0, -1, 0, 1, 0, -2, 1, -1, 1, 0, 1, 1, 1]
        let count: usize = 13
        for i in 0..count {
            let ox = offsets[i * 2]
            let oz = offsets[i * 2 + 1]
            let sx = x + (ox << 4)
            let sz = z + (oz << 4)
            let level = try self.surface_level(p, mut ctx, sx, sz)
            let adjusted = level + 8
            let start = ox == 0 and oz == 0
            if start and bottom > adjusted {
                return global
            }
            let pokes = top > adjusted
            if pokes or start {
                let at_surface = s.global(adjusted)
                if not s.is_air(at_surface.at(adjusted)) {
                    if start {
                        center_under = true
                    }
                    if pokes {
                        return at_surface
                    }
                }
            }
            lowest = lowest.min(level)
        }
        let level = try self.surface_of(p, mut ctx, x, y, z, global, lowest, center_under)
        return FluidStatus { level: level, state: try self.fluid_type(p, mut ctx, s, x, y, z, global, level) }
    }

    /// `computeSurfaceLevel`: the aquifer's fluid level, from how flooded it is.
    fn surface_of(self, p: Program, ctx: mut Context, x: i32, y: i32, z: i32, global: FluidStatus, lowest: i32, center_under: bool) -> i32 ! Thrown {
        var partially: f64 = -1.0
        var fully: f64 = -1.0
        if f64(try sample(p, mut ctx, self.samplers.exclusion, x, y, z)) > 0.0 {
            partially = -1.0
            fully = -1.0
        } else {
            let below = lowest + 8 - y
            let factor = if center_under { clamped_map(f64(below), 0.0, 64.0, 1.0, 0.0) } else { 0.0 }
            let noise = clamp(f64(try sample(p, mut ctx, self.samplers.floodedness, x, y, z)), -1.0, 1.0)
            let fully_at = map(factor, 1.0, 0.0, -0.3, 0.8)
            let partially_at = map(factor, 1.0, 0.0, -0.8, 0.4)
            partially = noise - partially_at
            fully = noise - fully_at
        }
        if fully > 0.0 {
            return global.level
        }
        if partially > 0.0 {
            // `computeRandomizedFluidSurfaceLevel`.
            let cell_x = x.floor_div(16)
            let cell_y = y.floor_div(40)
            let cell_z = z.floor_div(16)
            let middle = cell_y * 40 + 20
            let spread = f64(try sample(p, mut ctx, self.samplers.spread, cell_x, cell_y, cell_z) * 10.0f32)
            let quantized = floor(spread / 3.0) * 3
            return lowest.min(middle + quantized)
        }
        return WAY_BELOW_MIN_Y
    }

    /// `computeFluidType`: lava instead of the global fluid, deep down where the lava noise is
    /// strong.
    fn fluid_type(self, p: Program, ctx: mut Context, s: Shape, x: i32, y: i32, z: i32, global: FluidStatus, level: i32) -> u32 ! Thrown {
        if level <= -10 and level != WAY_BELOW_MIN_Y and global.state != s.lava {
            let v = f64(try sample(p, mut ctx, self.samplers.lava, x.floor_div(64), y.floor_div(40), z.floor_div(64)))
            if v.abs() > 0.3 {
                return s.lava
            }
        }
        return global.state
    }
}

/// `similarity`: 1 where two aquifers are equally near, falling by 1 for every 25 the second's
/// squared distance is past the first's.
fn similarity(d1: i32, d2: i32) -> f64 {
    return 1.0 - f64(d2 - d1) / 25.0
}

/// `Mth.floor`.
fn floor(v: f64) -> i32 {
    return i32.saturate(v.floor())
}

/// `Mth.clamp(double, double, double)`.
fn clamp(v: f64, low: f64, high: f64) -> f64 {
    return if v < low { low } else { v.min(high) }
}

/// `Mth.map`: `lerp(inverseLerp(...))`.
fn map(v: f64, from_min: f64, from_max: f64, to_min: f64, to_max: f64) -> f64 {
    let t = (v - from_min) / (from_max - from_min)
    return to_min + t * (to_max - to_min)
}

/// `Mth.clampedMap`: `clampedLerp(inverseLerp(...))`.
fn clamped_map(v: f64, from_min: f64, from_max: f64, to_min: f64, to_max: f64) -> f64 {
    let t = (v - from_min) / (from_max - from_min)
    if t < 0.0 {
        return to_min
    }
    if t > 1.0 {
        return to_max
    }
    return to_min + t * (to_max - to_min)
}

/// `ChunkPos.pack`.
fn chunk_pack(x: i32, z: i32) -> i64 {
    return (i64(x) & 0xFFFFFFFF) | ((i64(z) & 0xFFFFFFFF) << 32)
}

/// `BlockPos.asLong`, and its `getX`, `getY` and `getZ`.
fn block_pack(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 0x3FFFFFF) << 38) | (i64(y) & 0xFFF) | ((i64(z) & 0x3FFFFFF) << 12)
}

fn block_x(packed: i64) -> i32 {
    return i32.wrap(packed >> 38)
}

fn block_y(packed: i64) -> i32 {
    return i32.wrap((packed << 52) >> 52)
}

fn block_z(packed: i64) -> i32 {
    return i32.wrap((packed << 26) >> 38)
}
