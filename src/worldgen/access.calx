/// What a block's shape and its survival read and change: vanilla's `LevelReader` and
/// `ScheduledTickAccess`, as far as `updateShape` and `canSurvive` take them (D324). A region
/// implements it as chunks generate, and the server's level as its blocks change, so both run
/// the same code. Each tick is scheduled with the delay vanilla gives it, which a region doesn't
/// keep, as `ProtoChunkTicks` saves each tick with none.
module worldgen.access

import nbt.tag.{Tag}
import registry.songs.{JukeboxSong}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

/// Where blocks are read and ticks scheduled.
pub interface BlockAccess {
    /// `getBlockState`: the state of the block at `x`, `y`, `z`.
    fn state(self, facts: Facts, x: i32, y: i32, z: i32) -> u32 ! Thrown
    /// `scheduleTick` of the block `block` at `x`, `y`, `z`, due in `delay` ticks with
    /// `priority`.
    fn schedule_block(mut self, block: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32)
    /// `scheduleTick` of the fluid `fluid` at `x`, `y`, `z`, due in its `getTickDelay`.
    fn schedule_fluid(mut self, fluid: u32, x: i32, y: i32, z: i32)
    /// `hasScheduledTick`: whether the block at `x`, `y`, `z` has a tick of `block` scheduled.
    fn has_block_tick(self, block: u32, x: i32, y: i32, z: i32) -> bool
    /// `getBlockEntity`: the type of the block entity at `x`, `y`, `z`, `none` if there's none.
    fn block_entity(mut self, facts: Facts, x: i32, y: i32, z: i32) -> String? ! Thrown
    /// The block entity at `x`, `y`, `z` as it saves, `saveWithFullMetadata`, `none` where
    /// there's none yet, which reads as a fresh one would (CAL-123).
    fn block_entity_tag(self, x: i32, y: i32, z: i32) -> Tag?
    /// `getRawBrightness(pos, 0)`: the light at `x`, `y`, `z`, the block's or the sky's,
    /// whichever's more, in a dimension with a sky if `sky_light`.
    fn raw_brightness(self, sky_light: bool, x: i32, y: i32, z: i32) -> i32
    /// `JukeboxSong.fromStack`: the jukebox song the stack `record` plays, as the world's songs
    /// have it, `none` where it plays none (CAL-143).
    fn jukebox_song(self, record: Tag) -> JukeboxSong?
    /// `ChestBlockEntity.getOpenCount`: how many have the chest at `x`, `y`, `z` open, as its
    /// `ContainerOpenersCounter` counts them, none where it's no chest (CAL-144).
    fn open_count(self, x: i32, y: i32, z: i32) -> i32
    /// `ComparatorBlock.getItemFrame`'s frame on the block at `x`, `y`, `z` facing `dir`, by its
    /// `get3DDataValue`: its signal, `getAnalogOutput`, where there's just the one (CAL-354).
    fn frame_signal(self, x: i32, y: i32, z: i32, dir: i32) -> i32?
    /// `DetectorRailBlock.getAnalogOutputSignal`'s read of the minecarts on the powered detector
    /// rail at `x`, `y`, `z` (CAL-386).
    fn detector_output(self, x: i32, y: i32, z: i32) -> i32
    /// `CreakingHeartBlockEntity.getAnalogOutputSignal` of the heart at `x`, `y`, `z`, its
    /// `outputSignal`, none where it hasn't ticked (CAL-412).
    fn heart_output(self, x: i32, y: i32, z: i32) -> i32 {
        _ = x + y + z
        return 0
    }
    /// `EnvironmentAttributes.CREAKING_ACTIVE` at `x`, `y`, `z`, whether creakings are about,
    /// false where nothing keeps the time (CAL-412).
    fn creaking_active_at(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }
}

/// Where a feature sets blocks, a region as chunks generate or the server's level as it runs, as
/// vanilla's `WorldGenLevel` is either (D595).
pub interface FeatureAccess {
    /// `setBlock` of `state` at `x`, `y`, `z` with `flags`: false if it can't be set there.
    fn feature_set(mut self, facts: Facts, x: i32, y: i32, z: i32, state: u32, flags: i32) -> bool
    /// `TheEndGatewayBlockEntity.setExitPosition` of the end gateway's block entity at `x`, `y`,
    /// `z`, where there's one: its exit `exit`, exact where `exact`.
    fn feature_gateway_exit(mut self, facts: Facts, x: i32, y: i32, z: i32, exit: List<i32>, exact: bool) ! Thrown
    /// `EndPodiumFeature.dropPreviousAndSetBlock` of `block` at `x`, `y`, `z`: where what's there
    /// isn't it, broken with its drops, `destroyBlock`, then it set, flags 3 (D625).
    fn feature_replace(mut self, facts: Facts, x: i32, y: i32, z: i32, block: u32) ! Thrown
    /// `markPosForPostprocessing` of `x`, `y`, `z`: a region's chunk marks it, the running level
    /// nothing.
    fn feature_mark(mut self, x: i32, y: i32, z: i32)
}
