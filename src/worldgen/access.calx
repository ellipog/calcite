/// What a block's shape and its survival read and change: vanilla's `LevelReader` and
/// `ScheduledTickAccess`, as far as `updateShape` and `canSurvive` take them (D324). A region
/// implements it as chunks generate, and the server's level as its blocks change, so both run
/// the same code. Each tick is scheduled with the delay vanilla gives it, which a region doesn't
/// keep, as `ProtoChunkTicks` saves each tick with none.
module worldgen.access

import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

/// Where blocks are read and ticks scheduled.
pub interface BlockAccess {
    /// `getBlockState`: the state of the block at `x`, `y`, `z`.
    fn state(self, facts: Facts, x: i32, y: i32, z: i32) -> u32 ! Thrown
    /// `scheduleTick` of the block `block` at `x`, `y`, `z`, due in `delay` ticks with
    /// `priority`.
    fn schedule_block(mut self, block: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32)
    /// `scheduleTick` of the fluid `fluid` at `x`, `y`, `z`, due in its `getTickDelay`.
    fn schedule_fluid(mut self, fluid: u32, x: i32, y: i32, z: i32)
    /// `hasScheduledTick`: whether the block at `x`, `y`, `z` has a tick of `block` scheduled.
    fn has_block_tick(self, block: u32, x: i32, y: i32, z: i32) -> bool
    /// `getBlockEntity`: the type of the block entity at `x`, `y`, `z`, `none` if there's none.
    fn block_entity(mut self, facts: Facts, x: i32, y: i32, z: i32) -> String? ! Thrown
    /// `getRawBrightness(pos, 0)`: the light at `x`, `y`, `z`, the block's or the sky's,
    /// whichever's more, in a dimension with a sky if `sky_light`.
    fn raw_brightness(self, sky_light: bool, x: i32, y: i32, z: i32) -> i32
}
