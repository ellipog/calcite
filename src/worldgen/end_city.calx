/// End cities: a house, then towers, bridges, fat towers, more houses and at most one ship, each
/// section kept only if it meets no piece but its parent's, as `EndCityStructure` and
/// `EndCityPieces` lay them out.
module worldgen.end_city

import std.zip.{Zip}
import random.legacy.{LegacyRandom}
import random.worldgen.{WorldgenRandom}
import worldgen.facts.{NORTH}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Piece, PieceData, TemplateKind, TemplatePiece}
import worldgen.structure_world.{StructureWorld}
import worldgen.template.{Bounds, CLOCKWISE_180, CLOCKWISE_90, COUNTERCLOCKWISE_90, MIRROR_NONE, ROTATION_NONE, Settings, transform}

// The section generators.
const HOUSE_TOWER: i32 = 0
const TOWER: i32 = 1
const TOWER_BRIDGE: i32 = 2
const FAT_TOWER: i32 = 3

// An `EndCityPiece`: its template, where it's placed from, turned, whether it overwrites, its
// box and its depth, which sections set to tell their pieces apart.
struct CityPiece {
    name: String
    template: usize
    x: i32
    y: i32
    z: i32
    rotation: i32
    overwrite: bool
    bb: Bounds
    depth: i32
}

// The pieces made, the ones in sections that were kept being listed by index, and whether the
// city has its ship.
struct City {
    arena: List<CityPiece>
    ship: bool
}

/// `EndCityStructure`: none where the corners five blocks out are below 60.
pub fn end_city(w: mut StructureWorld, zip: Zip, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    let x = (cx << 4) + 7
    let z = (cz << 4) + 7
    if not try w.valid_in_column(x, z, allowed) {
        return List<Piece>()
    }
    let rotation = random.next_int_below(4)
    var ox = 5
    var oz = 5
    if rotation == CLOCKWISE_90 {
        ox = -5
    } else if rotation == CLOCKWISE_180 {
        ox = -5
        oz = -5
    } else if rotation == COUNTERCLOCKWISE_90 {
        oz = -5
    }
    let y = try w.lowest_y(x, z, ox, oz)
    if y < 60 {
        return List<Piece>()
    }
    if not try w.valid_biome(x, y, z, allowed) {
        return List<Piece>()
    }
    // `startHouseTower`.
    var c = City { arena: List<CityPiece>(), ship: false }
    var pieces = List<usize>()
    var last = try make(mut w, zip, mut c, "base_floor", x, y, z, rotation, true)
    pieces.push(last)
    last = try add(mut w, zip, mut c, last, -1, 0, -1, "second_floor_1", rotation, false)
    pieces.push(last)
    last = try add(mut w, zip, mut c, last, -1, 4, -1, "third_floor_1", rotation, false)
    pieces.push(last)
    last = try add(mut w, zip, mut c, last, -1, 8, -1, "third_roof", rotation, true)
    pieces.push(last)
    _ = try children(mut w, zip, mut c, TOWER, 1, last, 0, 0, 0, mut pieces, mut random)
    var out = List<Piece>()
    for i in pieces {
        out.push(to_piece(c.arena[i]))
    }
    return out
}

// The piece as the start saves it.
fn to_piece(p: CityPiece) -> Piece {
    let data = TemplatePiece { name: p.name.copy(), template: p.template, x: p.x, y: p.y, z: p.z, rotation: p.rotation, mirror: MIRROR_NONE, pivot_x: 0, pivot_y: 0, pivot_z: 0, kind: TemplateKind.EndCity(p.overwrite) }
    return Piece { kind: String("minecraft:ecp"), bb: p.bb, orientation: NORTH, gen_depth: p.depth, data: PieceData.Template(data) }
}

// A piece of the template, placed from the block, turned.
fn make(w: mut StructureWorld, zip: Zip, c: mut City, name: str, x: i32, y: i32, z: i32, rotation: i32, overwrite: bool) -> usize ! Thrown {
    let t = try w.template(zip, "minecraft:end_city/{name}")
    let bb = w.templates.list[t].bounding_box(Settings { rotation: rotation }, x, y, z)
    c.arena.push(CityPiece { name: String(name), template: t, x: x, y: y, z: z, rotation: rotation, overwrite: overwrite, bb: bb, depth: 0 })
    return c.arena.len() - 1
}

// `addPiece`: a piece placed from the parent's position, moved by the offset as the parent is
// turned.
fn add(w: mut StructureWorld, zip: Zip, c: mut City, parent: usize, dx: i32, dy: i32, dz: i32, name: str, rotation: i32, overwrite: bool) -> usize ! Thrown {
    let (ox, oy, oz) = transform(dx, dy, dz, MIRROR_NONE, c.arena[parent].rotation, 0, 0)
    let px = c.arena[parent].x
    let py = c.arena[parent].y
    let pz = c.arena[parent].z
    return try make(mut w, zip, mut c, name, px + ox, py + oy, pz + oz, rotation, overwrite)
}

fn meets(a: Bounds, b: Bounds) -> bool {
    return a.max_x >= b.min_x and a.min_x <= b.max_x and a.max_z >= b.min_z and a.min_z <= b.max_z and a.max_y >= b.min_y and a.min_y <= b.max_y
}

// `recursiveChildren`: a section from the generator, kept if none of its pieces meets a piece
// already listed but of the parent's depth; all its pieces, its sections' too, are given a
// random depth of their own.
fn children(w: mut StructureWorld, zip: Zip, c: mut City, generator: i32, depth: i32, parent: usize, dx: i32, dy: i32, dz: i32, pieces: mut List<usize>, random: mut WorldgenRandom<LegacyRandom>) -> bool ! Thrown {
    if depth > 8 {
        return false
    }
    var child = List<usize>()
    let made = if generator == HOUSE_TOWER {
        try house_tower(mut w, zip, mut c, depth, parent, dx, dy, dz, mut child, mut random)
    } else if generator == TOWER {
        try tower(mut w, zip, mut c, depth, parent, mut child, mut random)
    } else if generator == TOWER_BRIDGE {
        try tower_bridge(mut w, zip, mut c, depth, parent, mut child, mut random)
    } else {
        try fat_tower(mut w, zip, mut c, depth, parent, mut child, mut random)
    }
    if not made {
        return false
    }
    let tag = random.next_int()
    for k in child {
        c.arena[k].depth = tag
        let b = c.arena[k].bb
        for i in pieces {
            if meets(c.arena[i].bb, b) {
                if c.arena[i].depth != c.arena[parent].depth {
                    return false
                }
                break
            }
        }
    }
    for k in child {
        pieces.push(k)
    }
    return true
}

// `HOUSE_TOWER_GENERATOR`.
fn house_tower(w: mut StructureWorld, zip: Zip, c: mut City, depth: i32, parent: usize, dx: i32, dy: i32, dz: i32, pieces: mut List<usize>, random: mut WorldgenRandom<LegacyRandom>) -> bool ! Thrown {
    if depth > 8 {
        return false
    }
    let rotation = c.arena[parent].rotation
    var last = try add(mut w, zip, mut c, parent, dx, dy, dz, "base_floor", rotation, true)
    pieces.push(last)
    let floors = random.next_int_below(3)
    if floors == 0 {
        last = try add(mut w, zip, mut c, last, -1, 4, -1, "base_roof", rotation, true)
        pieces.push(last)
    } else if floors == 1 {
        last = try add(mut w, zip, mut c, last, -1, 0, -1, "second_floor_2", rotation, false)
        pieces.push(last)
        last = try add(mut w, zip, mut c, last, -1, 8, -1, "second_roof", rotation, false)
        pieces.push(last)
        _ = try children(mut w, zip, mut c, TOWER, depth + 1, last, 0, 0, 0, mut pieces, mut random)
    } else if floors == 2 {
        last = try add(mut w, zip, mut c, last, -1, 0, -1, "second_floor_2", rotation, false)
        pieces.push(last)
        last = try add(mut w, zip, mut c, last, -1, 4, -1, "third_floor_2", rotation, false)
        pieces.push(last)
        last = try add(mut w, zip, mut c, last, -1, 8, -1, "third_roof", rotation, true)
        pieces.push(last)
        _ = try children(mut w, zip, mut c, TOWER, depth + 1, last, 0, 0, 0, mut pieces, mut random)
    }
    return true
}

// `TOWER_BRIDGES` and `FAT_TOWER_BRIDGES`: each bridge's turn and offset.
fn bridges(fat: bool) -> List<(i32, i32, i32, i32)> {
    if fat {
        return [(ROTATION_NONE, 4, -1, 0), (CLOCKWISE_90, 12, -1, 4), (COUNTERCLOCKWISE_90, 0, -1, 8), (CLOCKWISE_180, 8, -1, 12)]
    }
    return [(ROTATION_NONE, 1, -1, 0), (CLOCKWISE_90, 6, -1, 1), (COUNTERCLOCKWISE_90, 0, -1, 5), (CLOCKWISE_180, 5, -1, 6)]
}

// `TOWER_GENERATOR`.
fn tower(w: mut StructureWorld, zip: Zip, c: mut City, depth: i32, parent: usize, pieces: mut List<usize>, random: mut WorldgenRandom<LegacyRandom>) -> bool ! Thrown {
    let rotation = c.arena[parent].rotation
    let bx = 3 + random.next_int_below(2)
    let bz = 3 + random.next_int_below(2)
    var last = try add(mut w, zip, mut c, parent, bx, -3, bz, "tower_base", rotation, true)
    pieces.push(last)
    last = try add(mut w, zip, mut c, last, 0, 7, 0, "tower_piece", rotation, true)
    pieces.push(last)
    var bridge: usize? = if random.next_int_below(3) == 0 { some(last) } else { none }
    let height = 1 + random.next_int_below(3)
    for i in 0..height {
        last = try add(mut w, zip, mut c, last, 0, 4, 0, "tower_piece", rotation, true)
        pieces.push(last)
        if i < height - 1 and random.next_boolean() {
            bridge = some(last)
        }
    }
    if let from = bridge {
        for (turn, ox, oy, oz) in bridges(false) {
            if random.next_boolean() {
                let start = try add(mut w, zip, mut c, from, ox, oy, oz, "bridge_end", (rotation + turn) % 4, true)
                pieces.push(start)
                _ = try children(mut w, zip, mut c, TOWER_BRIDGE, depth + 1, start, 0, 0, 0, mut pieces, mut random)
            }
        }
    } else if depth != 7 {
        return try children(mut w, zip, mut c, FAT_TOWER, depth + 1, last, 0, 0, 0, mut pieces, mut random)
    }
    last = try add(mut w, zip, mut c, last, -1, 4, -1, "tower_top", rotation, true)
    pieces.push(last)
    return true
}

// `TOWER_BRIDGE_GENERATOR`: a bridge, then the city's ship or a house at its end.
fn tower_bridge(w: mut StructureWorld, zip: Zip, c: mut City, depth: i32, parent: usize, pieces: mut List<usize>, random: mut WorldgenRandom<LegacyRandom>) -> bool ! Thrown {
    let rotation = c.arena[parent].rotation
    let length = random.next_int_below(4) + 1
    var last = try add(mut w, zip, mut c, parent, 0, 0, -4, "bridge_piece", rotation, true)
    pieces.push(last)
    c.arena[last].depth = -1
    var next_y = 0
    for _ in 0..length {
        if random.next_boolean() {
            last = try add(mut w, zip, mut c, last, 0, next_y, -4, "bridge_piece", rotation, true)
            pieces.push(last)
            next_y = 0
        } else {
            if random.next_boolean() {
                last = try add(mut w, zip, mut c, last, 0, next_y, -4, "bridge_steep_stairs", rotation, true)
            } else {
                last = try add(mut w, zip, mut c, last, 0, next_y, -8, "bridge_gentle_stairs", rotation, true)
            }
            pieces.push(last)
            next_y = 4
        }
    }
    if not c.ship and random.next_int_below(10 - depth) == 0 {
        let sx = -8 + random.next_int_below(8)
        let sz = -70 + random.next_int_below(10)
        let ship = try add(mut w, zip, mut c, last, sx, next_y, sz, "ship", rotation, true)
        pieces.push(ship)
        c.ship = true
    } else if not try children(mut w, zip, mut c, HOUSE_TOWER, depth + 1, last, -3, next_y + 1, -11, mut pieces, mut random) {
        return false
    }
    last = try add(mut w, zip, mut c, last, 4, next_y, 0, "bridge_end", (rotation + CLOCKWISE_180) % 4, true)
    pieces.push(last)
    c.arena[last].depth = -1
    return true
}

// `FAT_TOWER_GENERATOR`.
fn fat_tower(w: mut StructureWorld, zip: Zip, c: mut City, depth: i32, parent: usize, pieces: mut List<usize>, random: mut WorldgenRandom<LegacyRandom>) -> bool ! Thrown {
    let rotation = c.arena[parent].rotation
    var last = try add(mut w, zip, mut c, parent, -3, 4, -3, "fat_tower_base", rotation, true)
    pieces.push(last)
    last = try add(mut w, zip, mut c, last, 0, 4, 0, "fat_tower_middle", rotation, true)
    pieces.push(last)
    var i = 0
    while i < 2 and random.next_int_below(3) != 0 {
        last = try add(mut w, zip, mut c, last, 0, 8, 0, "fat_tower_middle", rotation, true)
        pieces.push(last)
        for (turn, ox, oy, oz) in bridges(true) {
            if random.next_boolean() {
                let start = try add(mut w, zip, mut c, last, ox, oy, oz, "bridge_end", (rotation + turn) % 4, true)
                pieces.push(start)
                _ = try children(mut w, zip, mut c, TOWER_BRIDGE, depth + 1, start, 0, 0, 0, mut pieces, mut random)
            }
        }
        i += 1
    }
    last = try add(mut w, zip, mut c, last, -2, 8, -2, "fat_tower_top", rotation, true)
    pieces.push(last)
    return true
}
