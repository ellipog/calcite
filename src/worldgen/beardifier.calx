/// The beardifier: the density structures add to the terrain about them, as 26.3's `Beardifier`
/// works it out from the starts a chunk references: the ground built up to or dug down from each
/// piece by its structure's terrain adaptation, and smoothed about each jigsaw junction.
module worldgen.beardifier

import math.mth.{fast_inv_sqrt}
import std.java.math.{pow}
import worldgen.noise.{Volume}

/// `TerrainAdjustment`, as `worldgen.structures` numbers it, `none` being 0.
const BURY: i32 = 1
const BEARD_THIN: i32 = 2
const BEARD_BOX: i32 = 3
const ENCAPSULATE: i32 = 4

/// A box of blocks, as `BoundingBox` holds it.
pub struct Extent {
    pub min_x: i32
    pub min_y: i32
    pub min_z: i32
    pub max_x: i32
    pub max_y: i32
    pub max_z: i32
}

/// `Beardifier.Rigid`: a piece's box, its structure's adaptation and its ground's height in it.
pub struct Rigid {
    pub bb: Extent
    pub adjustment: i32
    pub ground_delta: i32
}

/// A `JigsawJunction` as the beardifier reads it: where it is and its ground's height.
pub struct Point {
    pub x: i32
    pub ground_y: i32
    pub z: i32
}

/// A `Beardifier`: the rigid pieces and junctions near a chunk, and the box they can change.
pub struct Beardifier {
    pub rigids: List<Rigid>
    pub junctions: List<Point>
    pub affected: Extent
    kernel: List<f32>
}

/// What `forStructuresInChunk` gathers from a chunk's starts, in their order: the rigid pieces
/// within 12 blocks of it, the junctions within 12 blocks, and the box about them all.
pub struct Gathered {
    rigids: List<Rigid>
    junctions: List<Point>
    any: Extent?
}

impl Gathered {
    pub fn new() -> Gathered {
        return Gathered { rigids: List<Rigid>(), junctions: List<Point>(), any: none }
    }

    /// A rigid piece.
    pub fn add_rigid(mut self, bb: Extent, adjustment: i32, ground_delta: i32) {
        self.rigids.push(Rigid { bb: bb, adjustment: adjustment, ground_delta: ground_delta })
        self.include(bb)
    }

    /// A junction.
    pub fn add_junction(mut self, x: i32, ground_y: i32, z: i32) {
        self.junctions.push(Point { x: x, ground_y: ground_y, z: z })
        self.include(Extent { min_x: x, min_y: ground_y, min_z: z, max_x: x, max_y: ground_y, max_z: z })
    }

    fn include(mut self, b: Extent) {
        if let a = self.any {
            self.any = some(Extent { min_x: a.min_x.min(b.min_x), min_y: a.min_y.min(b.min_y), min_z: a.min_z.min(b.min_z), max_x: a.max_x.max(b.max_x), max_y: a.max_y.max(b.max_y), max_z: a.max_z.max(b.max_z) })
        } else {
            self.any = some(b)
        }
    }

    /// The beardifier, its box everything gathered grown by 24; none, as `EMPTY`, where nothing
    /// was. `kernel` is `beard_kernel()`, or empty for a beardifier given it later with
    /// `Beardifier.set_kernel`.
    pub fn finish(self, kernel: own List<f32>) -> Beardifier? {
        let a = self.any else return none
        let affected = Extent { min_x: a.min_x - 24, min_y: a.min_y - 24, min_z: a.min_z - 24, max_x: a.max_x + 24, max_y: a.max_y + 24, max_z: a.max_z + 24 }
        return some(Beardifier { rigids: self.rigids.copy(), junctions: self.junctions.copy(), affected: affected, kernel: kernel })
    }
}

/// `BEARD_KERNEL`: `e` to the minus a sixteenth of the squared distance from each block of a cube
/// 24 across to its middle, half a block up, by `z`, `x`, then `y`.
pub fn beard_kernel() -> List<f32> {
    var k = List<f32>()
    for zi in 0..24 {
        for xi in 0..24 {
            for yi in 0..24 {
                let dx = f64(xi - 12)
                let dy = f64(yi - 12) + 0.5
                let dz = f64(zi - 12)
                let d = dx * dx + dy * dy + dz * dz
                k.push(f32.nearest(pow(2.718281828459045, -d / 16.0)))
            }
        }
    }
    return k
}

// `getBuryContribution`.
fn bury(dx: f32, dy: f32, dz: f32) -> f32 {
    let d = dx * dx + dy * dy + dz * dz
    if d >= 36.0f32 {
        return 0.0f32
    }
    return 1.0f32 - f32.nearest(f64(d).sqrt()) / 6.0f32
}

impl Beardifier {
    /// Gives it `beard_kernel()`, as one gathered on a thread that has none is given it on the
    /// thread it samples on.
    pub fn set_kernel(mut self, kernel: own List<f32>) {
        self.kernel = kernel
    }

    // `getBeardContribution`.
    fn beard(self, dx: i32, dy: i32, dz: i32, to_ground: i32) -> f32 {
        let xi = dx + 12
        let yi = dy + 12
        let zi = dz + 12
        if xi < 0 or xi >= 24 or yi < 0 or yi >= 24 or zi < 0 or zi >= 24 {
            return 0.0f32
        }
        let dy_offset = f32.nearest(f64(to_ground)) + 0.5f32
        let fx = f32.nearest(f64(dx))
        let fz = f32.nearest(f64(dz))
        let d = fx * fx + dy_offset * dy_offset + fz * fz
        let value = -dy_offset * f32.nearest(fast_inv_sqrt(f64(d / 2.0f32))) / 2.0f32
        return value * self.kernel[usize.wrap(zi * 24 * 24 + xi * 24 + yi)]
    }

    // `sampleValueUnchecked`.
    fn value_at(self, x: i32, y: i32, z: i32) -> f32 {
        var v = 0.0f32
        for r in self.rigids {
            let b = r.bb
            let dx = 0.max((b.min_x - x).max(x - b.max_x))
            let dz = 0.max((b.min_z - z).max(z - b.max_z))
            let ground = b.min_y + r.ground_delta
            let to_ground = y - ground
            let dy = if r.adjustment == BURY or r.adjustment == BEARD_THIN {
                to_ground
            } else if r.adjustment == BEARD_BOX {
                0.max((ground - y).max(y - b.max_y))
            } else if r.adjustment == ENCAPSULATE {
                0.max((b.min_y - y).max(y - b.max_y))
            } else {
                0
            }
            v += if r.adjustment == BURY {
                bury(f32.nearest(f64(dx)), f32.nearest(f64(dy)) / 2.0f32, f32.nearest(f64(dz)))
            } else if r.adjustment == BEARD_THIN or r.adjustment == BEARD_BOX {
                self.beard(dx, dy, dz, to_ground) * 0.8f32
            } else if r.adjustment == ENCAPSULATE {
                bury(f32.nearest(f64(dx)) / 2.0f32, f32.nearest(f64(dy)) / 2.0f32, f32.nearest(f64(dz)) / 2.0f32) * 0.8f32
            } else {
                0.0f32
            }
        }
        for j in self.junctions {
            let dx = x - j.x
            let dy = y - j.ground_y
            let dz = z - j.z
            v += self.beard(dx, dy, dz, dy) * 0.4f32
        }
        return v
    }

    /// `sampleValue`: nothing outside the box it can change.
    pub fn sample(self, x: i32, y: i32, z: i32) -> f32 {
        let a = self.affected
        if x >= a.min_x and x <= a.max_x and y >= a.min_y and y <= a.max_y and z >= a.min_z and z <= a.max_z {
            return self.value_at(x, y, z)
        }
        return 0.0f32
    }

    /// `sampleVolume`.
    pub fn fill(self, out: mut List<f32>, v: Volume) {
        for i in 0..out.len() {
            out[i] = 0.0f32
        }
        let a = self.affected
        if not (a.max_x >= v.min_x and a.min_x <= v.max_block_x() and a.max_z >= v.min_z and a.min_z <= v.max_block_z() and a.max_y >= v.min_y and a.min_y <= v.max_block_y()) {
            return
        }
        let min_x = floor_div(0.max(a.min_x - v.min_x), v.step_x)
        let min_y = floor_div(0.max(a.min_y - v.min_y), v.step_y)
        let min_z = floor_div(0.max(a.min_z - v.min_z), v.step_z)
        let max_x = (v.size_x - 1).min(floor_div(a.max_x - v.min_x, v.step_x))
        let max_y = (v.size_y - 1).min(floor_div(a.max_y - v.min_y, v.step_y))
        let max_z = (v.size_z - 1).min(floor_div(a.max_z - v.min_z, v.step_z))
        for z in min_z..max_z + 1 {
            let bz = v.block_z(z)
            for x in min_x..max_x + 1 {
                let bx = v.block_x(x)
                for y in min_y..max_y + 1 {
                    out[usize.wrap(v.index(x, y, z))] = self.value_at(bx, v.block_y(y), bz)
                }
            }
        }
    }
}

// `Math.floorDiv`.
fn floor_div(a: i32, b: i32) -> i32 {
    let q = a / b
    if (a % b != 0) and ((a < 0) != (b < 0)) {
        return q - 1
    }
    return q
}
