/// Jigsaw pieces placed as their chunks are decorated: `PoolElementStructurePiece.place`, its
/// element placed from the piece's position, turned: a single element's template through the
/// structure block's ignore, the jigsaw blocks' replacement, the element's processors and the
/// projection's, a feature element's placed feature, each of a list element's in turn, and
/// nothing for an empty one.
module worldgen.pool_pieces

import json.tree.{Json}
import pack.data.{Data}
import random.source.{RandomSource}
import nbt.tag.{Tag}
import world.chunk.{WORLD_SURFACE_WG}
import worldgen.facts.{BlockSet, Facts}
import worldgen.features.{Catalog, Gen, place_placed}
import worldgen.interval.{Thrown}
import worldgen.jigsaw.{Element, ElementKind, Pools}
import worldgen.pieces.{JigsawPiece, Piece, PieceData}
import worldgen.predicates.{Readers}
import worldgen.region.{Region}
import worldgen.structure_world.{StructureWorld}
import worldgen.survive.{Env}
import worldgen.template.{Bounds, Processor, Settings, place_in_world, read_processor_list}

/// What the elements of the pieces to place need, loaded before decoration: each single
/// element's template, each processor list by ID, and each feature element's placed feature in
/// the features' catalog.
pub struct ElementCache {
    pub templates: Map<String, usize>
    pub processors: Map<String, List<Processor>>
    pub features: Map<String, usize>
}

impl ElementCache {
    pub fn new() -> ElementCache {
        return ElementCache { templates: Map<String, usize>(), processors: Map<String, List<Processor>>(), features: Map<String, usize>() }
    }

    /// Loads what the jigsaw pieces' elements need.
    pub fn prepare(mut self, catalog: mut Catalog, w: mut StructureWorld, pools: Pools, zip: Data, facts: Facts, rd: Readers, pieces: List<Piece>) ! Thrown {
        for p in pieces {
            match p.data {
                PieceData.Jigsaw(j) => try self.load(mut catalog, mut w, zip, facts, rd, pools.list[j.pool].elements[j.index]),
                _ => {},
            }
        }
    }

    fn load(mut self, catalog: mut Catalog, w: mut StructureWorld, zip: Data, facts: Facts, rd: Readers, e: Element) ! Thrown {
        match e.kind {
            ElementKind.Single => try self.load_single(mut w, zip, facts, rd, e),
            ElementKind.Legacy => try self.load_single(mut w, zip, facts, rd, e),
            ElementKind.Feature => {
                if not self.features.contains(e.location) {
                    match catalog.read_placed(zip, facts, rd, Json.Str(e.location.copy())) {
                        ok(i) => self.features.insert(e.location.copy(), i),
                        err(m) => fail Thrown { exception: "IllegalStateException", message: m },
                    }
                }
            },
            ElementKind.List => {
                for c in e.children {
                    try self.load(mut catalog, mut w, zip, facts, rd, c)
                }
            },
            ElementKind.Empty => {},
        }
    }

    fn load_single(mut self, w: mut StructureWorld, zip: Data, facts: Facts, rd: Readers, e: Element) ! Thrown {
        if not self.templates.contains(e.location) {
            let t = try w.template(zip, e.location.copy())
            self.templates.insert(e.location.copy(), t)
        }
        let key = processors_key(e.processors)
        if not key.is_empty() and not self.processors.contains(key) {
            match read_processor_list(zip, facts, rd, Json.Str(key.copy())) {
                ok(list) => self.processors.insert(key, list),
                err(m) => fail Thrown { exception: "IllegalStateException", message: m },
            }
        }
    }
}

// A single element's processor list's ID, or nothing for an empty list written out.
fn processors_key(t: Tag) -> String {
    return match t {
        Tag.Str(id) => id.copy(),
        _ => String(),
    }
}

/// `PoolElementStructurePiece.postProcess`: the element placed from the piece's position, turned
/// as the piece is, with the chunk's area as its bounds.
pub fn place_jigsaw<T: RandomSource>(g: Gen, w: StructureWorld, c: ElementCache, pools: Pools, r: mut Region, random: mut T, j: JigsawPiece, area: Bounds, ref_x: i32, ref_y: i32, ref_z: i32) ! Thrown {
    _ = try place_element(g, w, c, mut r, mut random, pools.list[j.pool].elements[j.index], j.x, j.y, j.z, ref_x, ref_y, ref_z, j.rotation, area, j.ignore_waterlogging)
}

// `StructurePoolElement.place` of each kind.
fn place_element<T: RandomSource>(g: Gen, w: StructureWorld, c: ElementCache, r: mut Region, random: mut T, e: Element, x: i32, y: i32, z: i32, ref_x: i32, ref_y: i32, ref_z: i32, rotation: i32, area: Bounds, ignore_waterlogging: bool) -> bool ! Thrown {
    let Gen { env: env, .. } = g
    let Env { facts: f, .. } = env
    match e.kind {
        ElementKind.Empty => return true,
        ElementKind.Feature => {
            let p = c.features.get(e.location) else fail Thrown { exception: "IllegalStateException", message: "the feature {e.location} wasn't loaded" }
            return try place_placed(g, mut r, mut random, p, x, y, z, false)
        },
        ElementKind.List => {
            for child in e.children {
                if not try place_element(g, w, c, mut r, mut random, child, x, y, z, ref_x, ref_y, ref_z, rotation, area, ignore_waterlogging) {
                    return false
                }
            }
            return true
        },
        _ => {},
    }
    // A single element, or a legacy one, which ignores air too.
    let t = c.templates.get(e.location) else fail Thrown { exception: "IllegalStateException", message: "the template {e.location} wasn't loaded" }
    let structure_block = i32.wrap(try f.named_block(String("structure_block")))
    let legacy = e.kind == ElementKind.Legacy
    var processors = List<Processor>()
    if not legacy {
        processors.push(Processor.Ignore(BlockSet.of([structure_block], f.block_count)))
    }
    processors.push(Processor.JigsawReplacement)
    let key = processors_key(e.processors)
    if not key.is_empty() {
        if not c.processors.contains(key) {
            fail Thrown { exception: "IllegalStateException", message: "the processor list {key} wasn't loaded" }
        }
        for p in c.processors[key] {
            processors.push(p.copy())
        }
    }
    if not e.rigid {
        processors.push(Processor.Gravity { heightmap: WORLD_SURFACE_WG, offset: -1 })
    }
    if legacy {
        processors.push(Processor.Ignore(BlockSet.of([i32.wrap(f.ids.air), structure_block], f.block_count)))
    }
    let waterlogging = if e.liquid >= 0 { e.liquid == 1 } else { not ignore_waterlogging }
    let s = Settings { rotation: rotation, bounds: some(area), known_shape: true, waterlogging: waterlogging, processors: processors }
    // Data markers are run through the processors too, but a single element does nothing with
    // them.
    return try place_in_world(env, mut r, w.templates.list[t].value, x, y, z, ref_x, ref_y, ref_z, s, mut random, 18)
}
