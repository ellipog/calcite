/// Biome temperatures, as `Biome.getTemperature` gives them: a biome's base temperature, made 0.2
/// in a frozen biome's ice patches, falling with height above the snow line. The material rules'
/// `temperature` condition, the frozen oceans' icebergs and features that freeze water or lay snow
/// all ask it, and the server's level, where it rains (D339).
module worldgen.temperature

import json.tree.{Json, get}
import pack.data.{Data}
import random.legacy.{LegacyRandom}
import registry.registry.{Registry}
import worldgen.density.{data_json}
import worldgen.noise.{Noise}

/// `Biome.TEMPERATURE_NOISE`, `BIOME_INFO_NOISE` and the layers of `FROZEN_TEMPERATURE_NOISE`,
/// with each biome's base temperature, whether its temperature modifier is `frozen` and whether it
/// has precipitation, by ID, for the biomes a source can give.
pub struct Temperatures {
    temperature_noise: Noise
    info_noise: Noise
    frozen_noises: List<Noise>
    base: List<f32>
    frozen: List<bool>
    precipitation: List<bool>
}

impl Temperatures {
    /// The temperatures of the biomes `possible`, read from their JSON.
    pub fn read(zip: Data, biomes: Registry, possible: List<i32>) -> Temperatures ! String {
        var base: List<f32> = [0.0f32; biomes.entries.len()]
        var frozen: List<bool> = [false; biomes.entries.len()]
        var precipitation: List<bool> = [false; biomes.entries.len()]
        for b in possible {
            let id = biomes.entries[usize.wrap(b)].to_string()
            let json = try data_json(zip, id, "biome")
            let m = match json {
                Json.Object(m) => m,
                _ => fail "biome `{id}` isn't an object",
            }
            let text = match get(m, String("temperature")) {
                some(Json.Number(t)) => t,
                _ => fail "biome `{id}` has no `temperature`",
            }
            let t = f32.parse(text) else fail "biome `{id}`'s temperature isn't a number"
            base[usize.wrap(b)] = t
            precipitation[usize.wrap(b)] = match get(m, String("has_precipitation")) {
                some(Json.Bool(v)) => v,
                _ => fail "biome `{id}` has no `has_precipitation`",
            }
            match get(m, String("temperature_modifier")) {
                some(Json.Str(s)) => frozen[usize.wrap(b)] = s == "frozen",
                _ => {},
            }
        }
        return Temperatures.of(base, frozen, precipitation)
    }

    /// The temperatures of the biomes with the base temperatures `base`, whether their modifier
    /// is `frozen` and whether they have precipitation, by ID (D339).
    pub fn of(base: own List<f32>, frozen: own List<bool>, precipitation: own List<bool>) -> Temperatures {
        var temperature_random = LegacyRandom.new(1234)
        var info_random = LegacyRandom.new(2345)
        var frozen_random = LegacyRandom.new(3456)
        var frozen_noises = List<Noise>()
        for _ in 0..3 {
            frozen_noises.push(Noise.simplex(mut frozen_random, true))
        }
        return Temperatures {
            temperature_noise: Noise.simplex(mut temperature_random, true),
            info_noise: Noise.simplex(mut info_random, true),
            frozen_noises: frozen_noises,
            base: base,
            frozen: frozen,
            precipitation: precipitation,
        }
    }

    /// `Biome.getTemperature` of `biome` at the block, with the sea level `sea`. Vanilla keeps the
    /// last 1024 for each biome and thread by `BlockPos.asLong`, whose 26 bits of `x` and `z` wrap
    /// only past 33,554,431, beyond the world border, so the cache never changes a temperature and
    /// Calcite keeps none.
    pub fn at(self, biome: i32, x: i32, y: i32, z: i32, sea: i32) -> f32 {
        let b = usize.wrap(biome)
        var t = self.base[b]
        if self.frozen[b] {
            // `TemperatureModifier.FROZEN`.
            let large = f64(self.frozen_sum(f64(x) * 0.05, f64(z) * 0.05) * 7.0f32)
            let edge = f64(self.info_noise.get2(f64(x) * 0.2, f64(z) * 0.2))
            if large + edge < 0.3 {
                let small = f64(self.info_noise.get2(f64(x) * 0.09, f64(z) * 0.09))
                if small < 0.8 {
                    t = 0.2f32
                }
            }
        }
        let snow = sea + 17
        if y > snow {
            let v = self.temperature_noise.get2(f64(f32.nearest(x) / 8.0f32), f64(f32.nearest(z) / 8.0f32)) * 8.0f32
            return t - (v + f32.nearest(y) - f32.nearest(snow)) * 0.05f32 / 40.0f32
        }
        return t
    }

    /// `Biome.warmEnoughToRain`: a temperature of at least 0.15.
    pub fn warm_enough_to_rain(self, biome: i32, x: i32, y: i32, z: i32, sea: i32) -> bool {
        return self.at(biome, x, y, z, sea) >= 0.15f32
    }

    /// `Biome.getPrecipitationAt` is rain: the biome, by its ID, has precipitation and is warm
    /// enough to rain at the block, with the sea level `sea` (D339).
    pub fn rains(self, biome: i32, x: i32, y: i32, z: i32, sea: i32) -> bool {
        if biome < 0 or usize.wrap(biome) >= self.precipitation.len() {
            return false
        }
        return self.precipitation[usize.wrap(biome)] and self.warm_enough_to_rain(biome, x, y, z, sea)
    }

    /// `Biome.getPrecipitationAt` is snow: the biome has precipitation and is too cold to rain.
    pub fn snows(self, biome: i32, x: i32, y: i32, z: i32, sea: i32) -> bool {
        return self.precipitation[usize.wrap(biome)] and not self.warm_enough_to_rain(biome, x, y, z, sea)
    }

    /// `Biome.hasPrecipitation` of the biome, by its ID, false for one it doesn't know (D340).
    pub fn has_precipitation(self, biome: i32) -> bool {
        return biome >= 0 and usize.wrap(biome) < self.precipitation.len() and self.precipitation[usize.wrap(biome)]
    }

    /// `FROZEN_TEMPERATURE_NOISE.get(x, z)`: its three layers, summed in `float`.
    fn frozen_sum(self, x: f64, z: f64) -> f32 {
        var value: f32 = 0.0
        value += 0.14285715f32 * self.frozen_noises[0].get2(x * 1.0, z * 1.0)
        value += 0.2857143f32 * self.frozen_noises[1].get2(x * 0.5, z * 0.5)
        value += 0.5714286f32 * self.frozen_noises[2].get2(x * 0.25, z * 0.25)
        return value
    }
}
