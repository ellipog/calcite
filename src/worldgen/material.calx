/// A noise settings' materials: its material rule, read as `MaterialRule.CODEC` reads one, and
/// `MaterialSystem.buildSurface`, which gives a filled chunk its surface, bedrock, bandlands, ore
/// veins, eroded badlands pillars and frozen ocean icebergs, in 26.3.
///
/// The rule is read once and compiled for each chunk, as vanilla compiles it in the chunk's
/// `MaterialRuleContext`. Vanilla's conditions are pure functions of the block and its column
/// (the caches its lazy conditions keep only save work), so each condition here is worked out at
/// most once for a block, and a rule named twice compiles once.
module worldgen.material

import json.tree.{Json, Member, as_string, get}
import nbt.tag.{Tag}
import pack.data.{Data}
import random.any.{AnyPositional, AnyRandom}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.block_flags.{FLUID}
import world.chunk.{BlockStates, OCEAN_FLOOR_WG, WORLD_SURFACE_WG}
import world.states.{StateCodec}
import worldgen.biome_manager.{BlockBiomes}
import worldgen.biome_source.{holder_set}
import worldgen.codec.{bool_field, bool_of, double_field, field, float_range, identifier_field, int_field, type_of}
import worldgen.density.{Functions, data_json}
import worldgen.interval.{Thrown}
import worldgen.noise.{Layer, Stack, Volume}
import worldgen.normal.{NormalNoise, read_parameters}
import worldgen.providers.{Anchor, GenContext, anchor_field}
import worldgen.sampler.{Context, Program, fill, sample, volume, zeros}
import worldgen.temperature.{Temperatures}
import worldgen.terrain.{Filled, Shape, clamped, update}

/// What a rule gives where it gives nothing: vanilla's `null`.
pub const NONE: u32 = 0xFFFFFFFF
/// How many clay bands there are.
const BANDS: i32 = 192

/// A `MaterialCondition`, as read.
enum Condition {
    /// `biome`: whether the block's biome is one of these, by biome ID.
    Biomes(List<bool>)
    /// `noise_threshold`: the noise `noise` of `Rules.stacks` between `min` and `max`.
    Threshold { noise: usize, min: f64, max: f64, three_d: bool }
    /// `vertical_gradient`: true at and below one height, false at and above another, and
    /// randomly between.
    Gradient { random: AnyPositional, true_at: Anchor, false_at: Anchor }
    /// `y_above`.
    YAbove { anchor: Anchor, multiplier: i32, add: bool }
    /// `water`.
    Water { offset: i32, multiplier: i32, add: bool }
    /// `temperature`: cold enough to snow.
    Temperature
    /// `steep`.
    Steep
    /// `not`.
    Not(usize)
    /// `hole`: a column with no surface depth.
    Hole
    /// `above_preliminary_surface`.
    Preliminary
    /// `stone_depth`, from the floor or the ceiling.
    StoneDepth { offset: i32, add: bool, range: i32, ceiling: bool }
}

/// A `MaterialRule`, as read.
enum Rule {
    /// `block`: a state.
    Block(u32)
    /// `bandlands`: the clay band at the block's height.
    Bands
    /// `sequence`: the first of its rules that gives a block.
    Sequence(List<usize>)
    /// `condition`: its rule where its condition holds.
    If { condition: usize, then_run: usize }
    /// `ore_vein`: the vein of `Rules.ores`.
    Ore(usize)
}

/// An `ore_vein` rule: its states, its chance of raw ore, and its density functions, read into
/// the case's `Functions`.
struct OreRule {
    ore: u32
    raw: u32
    filler: u32
    chance: f32
    density: usize
    richness: usize
    gap: usize
}

/// A material rule, read: its rules and conditions, the noises its conditions name, and the
/// random its ore veins draw from.
pub struct Rules {
    rules: List<Rule> = List<Rule>()
    conditions: List<Condition> = List<Condition>()
    ores: List<OreRule> = List<OreRule>()
    /// The rule the case gives, or the settings' own.
    pub root: usize = 0
    /// The rules and conditions named by ID, read the first time they're named.
    rule_refs: Map<String, usize> = Map<String, usize>()
    condition_refs: Map<String, usize> = Map<String, usize>()
    /// The noises the conditions name, made as `RandomState.getOrCreateNoise` makes them, and
    /// which of them vanilla's data doesn't have: naming one throws when the rule compiles.
    stacks: List<Stack> = List<Stack>()
    missing: List<bool> = List<bool>()
    noise_ids: List<String> = List<String>()
    noise_index: Map<String, usize> = Map<String, usize>()
    /// `getOrCreateRandomFactory("minecraft:ore")`.
    ore_random: AnyPositional
}

impl Rules {
    fn add_rule(mut self, r: own Rule) -> usize {
        self.rules.push(r)
        return self.rules.len() - 1
    }

    fn add_condition(mut self, c: own Condition) -> usize {
        self.conditions.push(c)
        return self.conditions.len() - 1
    }
}

// Reading.

/// The material rule `value`, as `MaterialRule.CODEC` reads it, with vanilla's data for the
/// rules, conditions, biomes, noises and density functions it names. Fails where vanilla's codec
/// does; the message is only this reader's.
pub fn read_rules(functions: mut Functions, zip: Data, biomes: Registry, codec: StateCodec, value: Json) -> Rules ! String {
    var rules = Rules { ore_random: functions.random_factory(String("minecraft:ore")) }
    rules.root = try read_rule(mut rules, mut functions, zip, biomes, codec, value)
    return rules
}

/// `MaterialRule.CODEC`: a rule by its ID in the registry, or one written out.
fn read_rule(rules: mut Rules, functions: mut Functions, zip: Data, biomes: Registry, codec: StateCodec, value: Json) -> usize ! String {
    if let text = as_string(value) {
        match Identifier.parse(text) {
            ok(id) => {
                let key = id.to_string()
                if let r = rules.rule_refs.get(key) {
                    return r
                }
                let json = try data_json(zip, key, "material_rule")
                let r = try read_direct_rule(mut rules, mut functions, zip, biomes, codec, json)
                rules.rule_refs.insert(key, r)
                return r
            },
            // Not an ID: read as written out, which a string isn't.
            err(_) => {},
        }
    }
    return try read_direct_rule(mut rules, mut functions, zip, biomes, codec, value)
}

fn read_direct_rule(rules: mut Rules, functions: mut Functions, zip: Data, biomes: Registry, codec: StateCodec, value: Json) -> usize ! String {
    match value {
        Json.Object(members) => return try read_typed_rule(mut rules, mut functions, zip, biomes, codec, members),
        _ => {},
    }
    fail "Not a map: {value}"
}

fn read_typed_rule(rules: mut Rules, functions: mut Functions, zip: Data, biomes: Registry, codec: StateCodec, members: List<Member>) -> usize ! String {
    let kind = try type_of(members)
    if kind == "minecraft:block" {
        let state = try state_field(members, "result_state", codec)
        return rules.add_rule(Rule.Block(state))
    }
    if kind == "minecraft:bandlands" {
        return rules.add_rule(Rule.Bands)
    }
    if kind == "minecraft:sequence" {
        let list = match field(members, "sequence") {
            some(Json.Array(items)) => items,
            some(other) => fail "Not a list: {other}",
            none => fail "No key sequence in MapLike",
        }
        var entries = List<usize>()
        for item in list {
            entries.push(try read_rule(mut rules, mut functions, zip, biomes, codec, item))
        }
        return rules.add_rule(Rule.Sequence(entries))
    }
    if kind == "minecraft:condition" {
        let if_true = field(members, "if_true") else fail "No key if_true in MapLike"
        let then_value = field(members, "then_run") else fail "No key then_run in MapLike"
        let condition = try read_condition(mut rules, functions, zip, biomes, if_true)
        let then_run = try read_rule(mut rules, mut functions, zip, biomes, codec, then_value)
        return rules.add_rule(Rule.If { condition: condition, then_run: then_run })
    }
    if kind == "minecraft:ore_vein" {
        let ore = try state_field(members, "ore_block", codec)
        let raw = try state_field(members, "raw_ore_block", codec)
        let filler = try state_field(members, "filler_block", codec)
        let chance_value = field(members, "raw_ore_chance") else fail "No key raw_ore_chance in MapLike"
        let chance = try float_range(chance_value, 0.0f32, 1.0f32)
        let density = try function_field(mut functions, zip, members, "density")
        let richness = try function_field(mut functions, zip, members, "richness")
        let gap = try function_field(mut functions, zip, members, "filler_gap")
        rules.ores.push(OreRule { ore: ore, raw: raw, filler: filler, chance: chance, density: density, richness: richness, gap: gap })
        let k = rules.ores.len() - 1
        return rules.add_rule(Rule.Ore(k))
    }
    fail "Unknown material rule type: {kind}"
}

/// `MaterialCondition.CODEC`: a condition by its ID in the registry, or one written out.
fn read_condition(rules: mut Rules, functions: Functions, zip: Data, biomes: Registry, value: Json) -> usize ! String {
    if let text = as_string(value) {
        match Identifier.parse(text) {
            ok(id) => {
                let key = id.to_string()
                if let c = rules.condition_refs.get(key) {
                    return c
                }
                let json = try data_json(zip, key, "material_condition")
                let c = try read_direct_condition(mut rules, functions, zip, biomes, json)
                rules.condition_refs.insert(key, c)
                return c
            },
            err(_) => {},
        }
    }
    return try read_direct_condition(mut rules, functions, zip, biomes, value)
}

fn read_direct_condition(rules: mut Rules, functions: Functions, zip: Data, biomes: Registry, value: Json) -> usize ! String {
    match value {
        Json.Object(members) => return try read_typed_condition(mut rules, functions, zip, biomes, members),
        _ => {},
    }
    fail "Not a map: {value}"
}

fn read_typed_condition(rules: mut Rules, functions: Functions, zip: Data, biomes: Registry, members: List<Member>) -> usize ! String {
    let kind = try type_of(members)
    if kind == "minecraft:biome" {
        let value = field(members, "biome_is") else fail "No key biome_is in MapLike"
        let ids = try holder_set(biomes, value)
        var set: List<bool> = [false; biomes.entries.len()]
        for b in ids {
            set[usize.wrap(b)] = true
        }
        return rules.add_condition(Condition.Biomes(set))
    }
    if kind == "minecraft:noise_threshold" {
        let id = try identifier_field(members, "noise")
        let min = try double_field(members, "min_threshold")
        let max = try double_field(members, "max_threshold")
        var three_d = false
        if let v = field(members, "is_3d") {
            three_d = try bool_of(v)
        }
        let noise = try noise_named(mut rules, functions, zip, id)
        return rules.add_condition(Condition.Threshold { noise: noise, min: min, max: max, three_d: three_d })
    }
    if kind == "minecraft:vertical_gradient" {
        let name = try identifier_field(members, "random_name")
        let true_at = try anchor_field(members, "true_at_and_below")
        let false_at = try anchor_field(members, "false_at_and_above")
        return rules.add_condition(Condition.Gradient { random: functions.random_factory(name), true_at: true_at, false_at: false_at })
    }
    if kind == "minecraft:y_above" {
        let anchor = try anchor_field(members, "anchor")
        let multiplier = try multiplier_field(members)
        let add = try bool_field(members, "add_stone_depth")
        return rules.add_condition(Condition.YAbove { anchor: anchor, multiplier: multiplier, add: add })
    }
    if kind == "minecraft:water" {
        let offset = try int_field(members, "offset")
        let multiplier = try multiplier_field(members)
        let add = try bool_field(members, "add_stone_depth")
        return rules.add_condition(Condition.Water { offset: offset, multiplier: multiplier, add: add })
    }
    if kind == "minecraft:temperature" {
        return rules.add_condition(Condition.Temperature)
    }
    if kind == "minecraft:steep" {
        return rules.add_condition(Condition.Steep)
    }
    if kind == "minecraft:not" {
        let value = field(members, "invert") else fail "No key invert in MapLike"
        let inner = try read_condition(mut rules, functions, zip, biomes, value)
        return rules.add_condition(Condition.Not(inner))
    }
    if kind == "minecraft:hole" {
        return rules.add_condition(Condition.Hole)
    }
    if kind == "minecraft:above_preliminary_surface" {
        return rules.add_condition(Condition.Preliminary)
    }
    if kind == "minecraft:stone_depth" {
        let offset = try int_field(members, "offset")
        let add = try bool_field(members, "add_surface_depth")
        let range = try int_field(members, "secondary_depth_range")
        let surface = field(members, "surface_type") else fail "No key surface_type in MapLike"
        let name = as_string(surface) else fail "Not a string: {surface}"
        if name != "floor" and name != "ceiling" {
            fail "Unknown element name:{name}"
        }
        return rules.add_condition(Condition.StoneDepth { offset: offset, add: add, range: range, ceiling: name == "ceiling" })
    }
    fail "Unknown material condition type: {kind}"
}

/// The noise named `id`, made the first time it's named; one vanilla's data doesn't have is
/// kept as missing.
fn noise_named(rules: mut Rules, functions: Functions, zip: Data, id: String) -> usize ! String {
    if let n = rules.noise_index.get(id) {
        return n
    }
    var missing = true
    var stack = Stack.new(List<Layer>(), false)
    match data_json(zip, id, "noise") {
        ok(json) => {
            var error = String()
            let p = read_parameters(json, mut error) else fail "{id}: {error}"
            var r = functions.positional().from_hash_of(id)
            stack = NormalNoise.new(p).create(mut r)
            missing = false
        },
        err(_) => {},
    }
    rules.stacks.push(stack)
    rules.missing.push(missing)
    rules.noise_ids.push(id.copy())
    let n = rules.stacks.len() - 1
    rules.noise_index.insert(id.copy(), n)
    return n
}

// The codecs' pieces, as `JsonOps` reads JSON.

/// `BlockState.CODEC`.
fn state_field(members: List<Member>, key: str, codec: StateCodec) -> u32 ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try codec.decode(Tag.from_json(value))
}

/// `DensityFunction.CODEC`.
fn function_field(functions: mut Functions, zip: Data, members: List<Member>, key: str) -> usize ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try functions.read(zip, value)
}

/// `surface_depth_multiplier`: `Codec.intRange(-20, 20)`.
fn multiplier_field(members: List<Member>) -> i32 ! String {
    let v = try int_field(members, "surface_depth_multiplier")
    if v < -20 or v > 20 {
        fail "Value {v} outside of range [-20:20]"
    }
    return v
}

// The material system.

/// `MaterialSystem` and what its rules' context needs of the noise settings and the world: the
/// settings' default block and sea level, its preliminary surface, its noises and clay bands, the
/// biomes' temperatures, and the world's heights.
pub struct Materials {
    default_block: u32
    default_block_id: u32
    sea: i32
    /// The chunk's `WorldGenerationContext`: the world's bottom and depth, cut to the noise's.
    pub gen: GenContext
    /// The bottom of the noise inside the world.
    low: i32
    /// The router's `chunk_surface_level`, as read.
    preliminary: usize
    /// The `RandomState`'s positional random.
    noise_random: AnyPositional
    bands: List<u32>
    clay: Stack
    surface: Stack
    secondary: Stack
    badlands_pillar: Stack
    badlands_roof: Stack
    badlands_surface: Stack
    iceberg_pillar: Stack
    iceberg_roof: Stack
    iceberg_surface: Stack
    /// The temperatures of the biomes the source can give.
    pub temps: Temperatures
    water: u32
    packed_ice: u32
    snow_block: u32
    pub void_air: u32
    /// The biomes with extensions of their own, or -1.
    eroded_badlands: i32
    frozen_ocean: i32
    deep_frozen_ocean: i32
}

/// The material system of the noise settings `members`, with `shape` read from them, for a
/// world `level_height` blocks tall from `level_min` whose biomes are among `possible`.
pub fn materials(functions: mut Functions, zip: Data, members: List<Member>, shape: Shape, codec: StateCodec, biomes: Registry, possible: List<i32>, level_min: i32, level_height: i32) -> Materials ! String {
    let router = match get(members, String("noise_router")) {
        some(Json.Object(m)) => m,
        _ => fail "the noise settings have no `noise_router`",
    }
    let preliminary_value = get(router, String("chunk_surface_level")) else fail "the router has no `chunk_surface_level`"
    let preliminary = try functions.read(zip, preliminary_value)
    let (low, _) = clamped(shape, level_min, level_height)
    var band_random = functions.positional().from_hash_of(String("minecraft:clay_bands"))
    let bands = try generate_bands(mut band_random, codec)
    let temps = try Temperatures.read(zip, biomes, possible)
    return Materials {
        default_block: shape.default_block,
        default_block_id: codec.block_of(shape.default_block),
        sea: shape.sea_level,
        gen: GenContext.new(shape.min_y, shape.height, shape.sea_level, level_min, level_height),
        low: low,
        preliminary: preliminary,
        noise_random: functions.positional(),
        bands: bands,
        clay: try material_noise(functions, zip, "minecraft:clay_bands_offset"),
        surface: try material_noise(functions, zip, "minecraft:surface"),
        secondary: try material_noise(functions, zip, "minecraft:surface_secondary"),
        badlands_pillar: try material_noise(functions, zip, "minecraft:badlands_pillar"),
        badlands_roof: try material_noise(functions, zip, "minecraft:badlands_pillar_roof"),
        badlands_surface: try material_noise(functions, zip, "minecraft:badlands_surface"),
        iceberg_pillar: try material_noise(functions, zip, "minecraft:iceberg_pillar"),
        iceberg_roof: try material_noise(functions, zip, "minecraft:iceberg_pillar_roof"),
        iceberg_surface: try material_noise(functions, zip, "minecraft:iceberg_surface"),
        temps: temps,
        water: try codec.blocks.parse(String("minecraft:water")),
        packed_ice: try block_state(codec, "minecraft:packed_ice"),
        snow_block: try block_state(codec, "minecraft:snow_block"),
        void_air: try block_state(codec, "minecraft:void_air"),
        eroded_badlands: biome_id(biomes, "eroded_badlands"),
        frozen_ocean: biome_id(biomes, "frozen_ocean"),
        deep_frozen_ocean: biome_id(biomes, "deep_frozen_ocean"),
    }
}

/// `Noises.instantiate`: the noise `id` of vanilla's data, from the hash of its ID.
fn material_noise(functions: Functions, zip: Data, id: str) -> Stack ! String {
    let json = try data_json(zip, String(id), "noise")
    var error = String()
    let p = read_parameters(json, mut error) else fail "{id}: {error}"
    var r = functions.positional().from_hash_of(String(id))
    return NormalNoise.new(p).create(mut r)
}

fn block_state(codec: StateCodec, name: str) -> u32 ! String {
    let block = try codec.blocks.parse(String(name))
    return codec.default_state(block)
}

fn biome_id(biomes: Registry, path: str) -> i32 {
    let id = biomes.id(Identifier { namespace: "minecraft", path: String(path) }) else return -1
    return id
}

/// `generateBands`: terracotta, with orange every few blocks, bands of yellow, brown and red,
/// and white ones edged with light gray.
fn generate_bands(r: mut AnyRandom, codec: StateCodec) -> List<u32> ! String {
    let terracotta = try block_state(codec, "minecraft:terracotta")
    let orange = try block_state(codec, "minecraft:orange_terracotta")
    let yellow = try block_state(codec, "minecraft:yellow_terracotta")
    let brown = try block_state(codec, "minecraft:brown_terracotta")
    let red = try block_state(codec, "minecraft:red_terracotta")
    let white = try block_state(codec, "minecraft:white_terracotta")
    let light_gray = try block_state(codec, "minecraft:light_gray_terracotta")
    var bands: List<u32> = [terracotta; usize.wrap(BANDS)]
    var i = 0
    while i < BANDS {
        i += r.next_int_below(5) + 1
        if i < BANDS {
            bands[usize.wrap(i)] = orange
        }
        i += 1
    }
    make_bands(mut r, mut bands, 1, yellow)
    make_bands(mut r, mut bands, 2, brown)
    make_bands(mut r, mut bands, 1, red)
    let count = r.next_int_between(9, 15)
    var n = 0
    var start = 0
    while n < count and start < BANDS {
        bands[usize.wrap(start)] = white
        if start - 1 > 0 and r.next_boolean() {
            bands[usize.wrap(start - 1)] = light_gray
        }
        if start + 1 < BANDS and r.next_boolean() {
            bands[usize.wrap(start + 1)] = light_gray
        }
        n += 1
        start += r.next_int_below(16) + 4
    }
    return bands
}

/// `makeBands`.
fn make_bands(r: mut AnyRandom, bands: mut List<u32>, base: i32, state: u32) {
    let count = r.next_int_between(6, 15)
    for _ in 0..count {
        let width = base + r.next_int_below(3)
        let start = r.next_int_below(BANDS)
        var p = 0
        while start + p < BANDS and p < width {
            bands[usize.wrap(start + p)] = state
            p += 1
        }
    }
}

/// `getBand`: the clay band at the block, its height moved by the offset noise. A height far
/// enough below 0 makes the index negative, and Java's array throws.
fn band(mat: Materials, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let offset = i32.round(mat.clay.get(f64(x), 0.0, f64(z)) * 4.0f32)
    let i = (y + offset + BANDS) % BANDS
    if i < 0 {
        fail Thrown { exception: "ArrayIndexOutOfBoundsException", message: "Index {i} out of bounds for length {BANDS}" }
    }
    return mat.bands[usize.wrap(i)]
}

/// `Biome.getTemperature` at the block, with the sea level of the settings.
fn temperature(mat: Materials, biome: i32, x: i32, y: i32, z: i32) -> f32 {
    return mat.temps.at(biome, x, y, z, mat.sea)
}

/// `getSurfaceDepth`.
fn surface_depth(mat: Materials, x: i32, z: i32) -> i32 {
    let noise = f64(mat.surface.get(f64(x), 0.0, f64(z)))
    var r = mat.noise_random.at(x, 0, z)
    return i32.saturate(noise * 2.75 + 3.0 + r.next_double() * 0.25)
}

// Compiling, for a chunk.

/// An ore vein's samplers, and its density and richness over the chunk's filled part.
struct OreBuffers {
    density: usize
    richness: usize
    gap: usize
    density_values: List<f32>
}

/// A rule compiled for a chunk: the volume its prefilled densities cover, the preliminary
/// surface's volume and sampler, or what compiling it threw, and its ore veins'.
struct Compiled {
    narrowed: Volume
    preliminary_volume: Volume
    preliminary: usize
    preliminary_thrown: Thrown?
    ores: List<OreBuffers>
}

/// `compile` of the rule `i` and what it holds, each once, in vanilla's order.
fn compile_rule(functions: mut Functions, rules: Rules, ctx: mut Context, c: mut Compiled, seen: mut List<bool>, seen_conditions: mut List<bool>, i: usize) ! Thrown {
    if seen[i] {
        return
    }
    seen[i] = true
    match rules.rules[i] {
        Rule.Sequence(list) => {
            for r in list {
                try compile_rule(mut functions, rules, mut ctx, mut c, mut seen, mut seen_conditions, r)
            }
        },
        Rule.If { condition, then_run } => {
            try compile_condition(rules, mut seen_conditions, condition)
            try compile_rule(mut functions, rules, mut ctx, mut c, mut seen, mut seen_conditions, then_run)
        },
        Rule.Ore(k) => {
            // `getDensitiesInChunk`: the density prefilled, the gap not. Vanilla prefills the
            // richness too, but it's read only where a vein's density and random let it be,
            // about 70 blocks a chunk of the 32,768 the volume holds, so it's worked out where
            // it's read, the same value (D237). Its first point is worked out here, so what the
            // prefill throws is thrown where vanilla throws it.
            let ds = try functions.sampler(rules.ores[k].density)
            var dv = try zeros(c.narrowed.size())
            try fill(functions.program, mut ctx, ds, mut dv, c.narrowed)
            let rs = try functions.sampler(rules.ores[k].richness)
            if c.narrowed.size() > 0 {
                _ = try sample(functions.program, mut ctx, rs, c.narrowed.block_x(0), c.narrowed.block_y(0), c.narrowed.block_z(0))
            }
            let gs = try functions.sampler(rules.ores[k].gap)
            c.ores[k] = OreBuffers { density: ds, richness: rs, gap: gs, density_values: dv }
        },
        _ => {},
    }
}

/// `compile` of the condition `i`: a noise vanilla's data doesn't have throws, as
/// `RandomState.getOrCreateNoise` does.
fn compile_condition(rules: Rules, seen: mut List<bool>, i: usize) ! Thrown {
    if seen[i] {
        return
    }
    seen[i] = true
    match rules.conditions[i] {
        Condition.Threshold { noise, .. } => {
            if rules.missing[noise] {
                fail Thrown { exception: "IllegalStateException", message: "Missing element ResourceKey[minecraft:worldgen/noise / {rules.noise_ids[noise]}]" }
            }
        },
        Condition.Not(inner) => try compile_condition(rules, mut seen, inner),
        _ => {},
    }
}

// Applying.

/// `MaterialRuleContext`'s column, and what's been worked out for it, each for the update it was
/// worked out at.
struct Cursor {
    bx: i32 = 0
    bz: i32 = 0
    gx: i32 = 0
    gz: i32 = 0
    depth: i32 = 0
    /// `lastUpdateXZ`.
    xz: i64 = 0
    secondary_at: i64 = -1
    secondary: f64 = 0.0
    min_at: i64 = -1
    min_surface: i32 = 0
    noise2_at: List<i64>
    noise2: List<f64>
    /// Each 3D noise's value at the column's blocks, from its lowest, and the update each was
    /// worked out at, sampled where a condition first asks for it (D299).
    noise3: List<List<f32>> = List<List<f32>>()
    noise3_at: List<List<i64>> = List<List<i64>>()
    /// The preliminary surface over the chunk, sampled the first time it's needed.
    preliminary: List<f32> = List<f32>()
    preliminary_filled: bool = false
    /// What each biome condition gives every block of the chunk, by the biomes its blocks can
    /// have, worked out the first time it's asked: `UNKNOWN_VERDICT`, `NONE_HOLD`, `ALL_HOLD`, or
    /// `SOME_HOLD` where it's worked out at each block.
    verdicts: List<u8> = List<u8>()
    possible: List<i32> = List<i32>()
    possible_known: bool = false
}

const UNKNOWN_VERDICT: u8 = 0
const NONE_HOLD: u8 = 1
const ALL_HOLD: u8 = 2
const SOME_HOLD: u8 = 3

/// What the biome condition `i`, of the biomes `set`, gives the chunk's blocks: none or all of
/// them where the biomes they can have are all out of the set or all in it.
fn biome_verdict<B: BlockBiomes>(biomes: mut B, cur: mut Cursor, i: usize, set: List<bool>) -> u8 ! Thrown {
    if cur.verdicts.is_empty() {
        cur.verdicts = [UNKNOWN_VERDICT; i + 1]
    }
    while cur.verdicts.len() <= i {
        cur.verdicts.push(UNKNOWN_VERDICT)
    }
    if cur.verdicts[i] != UNKNOWN_VERDICT {
        return cur.verdicts[i]
    }
    if not cur.possible_known {
        cur.possible = try biomes.possible()
        cur.possible_known = true
    }
    var verdict = SOME_HOLD
    if not cur.possible.is_empty() {
        var any_in = false
        var any_out = false
        for b in cur.possible {
            if set[usize.wrap(b)] {
                any_in = true
            } else {
                any_out = true
            }
        }
        if not any_in {
            verdict = NONE_HOLD
        } else if not any_out {
            verdict = ALL_HOLD
        }
    }
    cur.verdicts[i] = verdict
    return verdict
}

impl Cursor {
    fn update_xz(mut self, mat: Materials, bx: i32, bz: i32, gx: i32, gz: i32) {
        self.xz += 1
        self.bx = bx
        self.bz = bz
        self.gx = gx
        self.gz = gz
        self.depth = surface_depth(mat, bx, bz)
    }
}

/// `getSurfaceSecondary`.
fn secondary(mat: Materials, cur: mut Cursor) -> f64 {
    if cur.secondary_at != cur.xz {
        cur.secondary = f64(mat.secondary.get(f64(cur.bx), 0.0, f64(cur.bz)))
        cur.secondary_at = cur.xz
    }
    return cur.secondary
}

/// `getMinSurfaceLevel`: 8 blocks less the surface depth below the preliminary surface. Vanilla
/// compiles the preliminary surface here, the first time it's needed, so a compile that throws
/// throws here.
fn min_surface(c: Compiled, p: Program, cur: mut Cursor, ctx: mut Context) -> i32 ! Thrown {
    if cur.min_at == cur.xz {
        return cur.min_surface
    }
    if let thrown = c.preliminary_thrown {
        fail thrown.copy()
    }
    let index = c.preliminary_volume.index_of_block(cur.bx, 0, cur.bz)
    var level: f32 = 0.0
    if index != -1 {
        if not cur.preliminary_filled {
            var buffer = try zeros(c.preliminary_volume.size())
            try fill(p, mut ctx, c.preliminary, mut buffer, c.preliminary_volume)
            cur.preliminary = buffer
            cur.preliminary_filled = true
        }
        level = cur.preliminary[usize.wrap(index)]
    } else {
        level = try sample(p, mut ctx, c.preliminary, cur.bx, 0, cur.bz)
    }
    cur.min_surface = floor(f64(level)) + cur.depth - 8
    cur.min_at = cur.xz
    return cur.min_surface
}

/// `getNoiseSampler`: the noise at the column.
fn noise_value(rules: Rules, cur: mut Cursor, n: usize) -> f64 {
    if cur.noise2_at[n] != cur.xz {
        cur.noise2[n] = f64(rules.stacks[n].get(f64(cur.bx), 0.0, f64(cur.bz)))
        cur.noise2_at[n] = cur.xz
    }
    return cur.noise2[n]
}

/// The 3D noise `n` at the blocks of `spans` in the column, kept in `cur.noise3` from the
/// column's `base`, `height` blocks: each stretch of them not yet worked out for this update
/// sampled as a volume a block across, which gives each block what `NoiseStack.get` would
/// (D299).
fn noise_column(rules: Rules, cur: mut Cursor, base: i32, height: usize, n: usize, spans: List<Span>) {
    while cur.noise3.len() <= n {
        cur.noise3.push(List<f32>())
        cur.noise3_at.push(List<i64>())
    }
    if cur.noise3[n].len() < height {
        cur.noise3[n] = [0.0f32; height]
        cur.noise3_at[n] = [-1; height]
    }
    for s in spans {
        var y = s.bottom
        while y <= s.top {
            if cur.noise3_at[n][usize.wrap(y - base)] == cur.xz {
                y += 1
                continue
            }
            var end = y + 1
            while end <= s.top and cur.noise3_at[n][usize.wrap(end - base)] != cur.xz {
                end += 1
            }
            let v = Volume { size_x: 1, size_y: end - y, size_z: 1, min_x: cur.bx, min_y: y, min_z: cur.bz }
            var values: List<f32> = [0.0f32; usize.wrap(end - y)]
            rules.stacks[n].add_to_volume(mut values, v, 1.0, 1.0, 1.0f32, List<u8>())
            for k in 0..end - y {
                let at = usize.wrap(y + k - base)
                cur.noise3[n][at] = values[usize.wrap(k)]
                cur.noise3_at[n][at] = cur.xz
            }
            y = end
        }
    }
}

/// A column's stretches of stone the rule is applied to, each from its top down, and what's
/// worked out at their blocks: each stretch's top and bottom, the stone above its top, counting
/// it, and the water's height over it, `i32.MIN` for none. In a stretch the stone above a block
/// grows by one a block down, and the stone below it to the ceiling is its height over the
/// stretch's bottom, counting it; the water over it is the same at each (D240).
struct Runs {
    top: List<i32> = List<i32>()
    bottom: List<i32> = List<i32>()
    above: List<i32> = List<i32>()
    water: List<i32> = List<i32>()
    /// The height of the column's first block in the lists below.
    base: i32
    /// What the rule gives each block, `NONE` where nothing yet; each block's biome, once it's
    /// asked for; and whether a condition worked out a block at a time holds there.
    made: List<u32>
    biomes: List<i32>
    asked: bool = false
    holds: List<bool>
}

/// A part of the stretch `run`, from `top` down to `bottom`.
struct Span {
    run: u32
    top: i32
    bottom: i32
}

impl Runs {
    /// Lists for the `height` blocks of a column from `base` up.
    fn new(base: i32, height: i32) -> Runs {
        let n = usize.wrap(height)
        return Runs { base: base, made: [NONE; n], biomes: [UNKNOWN_BIOME; n], holds: [false; n] }
    }

    /// The column's stretches, every block's biome forgotten.
    fn clear(mut self) {
        self.top.clear()
        self.bottom.clear()
        self.above.clear()
        self.water.clear()
        if self.asked {
            for i in 0..self.biomes.len() {
                self.biomes[i] = UNKNOWN_BIOME
            }
            self.asked = false
        }
    }

    fn add(mut self, top: i32, bottom: i32, above: i32, water: i32) {
        self.top.push(top)
        self.bottom.push(bottom)
        self.above.push(above)
        self.water.push(water)
    }

    /// Every stretch, whole.
    fn spans(self) -> List<Span> {
        var all = List<Span>()
        for r in 0..self.top.len() {
            all.push(Span { run: u32.wrap(r), top: self.top[r], bottom: self.bottom[r] })
        }
        return all
    }
}

// A block's biome not yet asked for.
const UNKNOWN_BIOME: i32 = -1

/// `getBiome` at the column's block at `y`, as the biome manager zooms to it, asked once.
fn block_biome<B: BlockBiomes>(p: Program, biomes: mut B, cur: Cursor, col: mut Runs, y: i32) -> i32 ! Thrown {
    let at = usize.wrap(y - col.base)
    if col.biomes[at] == UNKNOWN_BIOME {
        col.biomes[at] = try biomes.biome(p, cur.bx, y, cur.bz)
        col.asked = true
    }
    return col.biomes[at]
}

/// The span's blocks at `level` and above into `upper`, the rest into `lower`.
fn split_at(s: Span, level: i32, upper: mut List<Span>, lower: mut List<Span>) {
    if s.bottom >= level {
        upper.push(s)
    } else if s.top < level {
        lower.push(s)
    } else {
        upper.push(Span { run: s.run, top: s.top, bottom: level })
        lower.push(Span { run: s.run, top: level - 1, bottom: s.bottom })
    }
}

/// The span's blocks from `top` down to `bottom`, where there are any, by what `holds` says at
/// each: those it holds at into `yes`, the rest into `no`, a run of either kept as one span.
fn split_held(col: Runs, run: u32, top: i32, bottom: i32, yes: mut List<Span>, no: mut List<Span>) {
    if top < bottom {
        return
    }
    var start = top
    var held = col.holds[usize.wrap(top - col.base)]
    var y = top - 1
    while y >= bottom {
        let h = col.holds[usize.wrap(y - col.base)]
        if h != held {
            if held {
                yes.push(Span { run: run, top: start, bottom: y + 1 })
            } else {
                no.push(Span { run: run, top: start, bottom: y + 1 })
            }
            start = y
            held = h
        }
        y -= 1
    }
    if held {
        yes.push(Span { run: run, top: start, bottom: bottom })
    } else {
        no.push(Span { run: run, top: start, bottom: bottom })
    }
}

/// The span's blocks the rule gave nothing, into `rest`, a run of them kept as one span.
fn unmade(col: Runs, s: Span, rest: mut List<Span>) {
    var start = i32.MIN
    var y = s.top
    while y >= s.bottom {
        if col.made[usize.wrap(y - col.base)] == NONE {
            if start == i32.MIN {
                start = y
            }
        } else if start != i32.MIN {
            rest.push(Span { run: s.run, top: start, bottom: y + 1 })
            start = i32.MIN
        }
        y -= 1
    }
    if start != i32.MIN {
        rest.push(Span { run: s.run, top: start, bottom: s.bottom })
    }
}

/// `RuleEvaluator.tryApply` of the rule `i` at each of the column's blocks in `spans`, none of
/// which has a block yet: what it gives each, in the column's `made`, and the blocks it gives
/// nothing, as spans. A condition is worked out for the blocks that reach it, each at most once
/// where it's asked again, as vanilla's are pure functions of the block and its column; one that
/// holds over a stretch from a height up or down is worked out once for the span (D240).
fn apply_spans<B: BlockBiomes>(rules: Rules, c: Compiled, mat: Materials, p: Program, biomes: mut B, cur: mut Cursor, col: mut Runs, ctx: mut Context, i: usize, spans: own List<Span>) -> List<Span> ! Thrown {
    match rules.rules[i] {
        Rule.Block(state) => {
            for s in spans {
                var y = s.top
                while y >= s.bottom {
                    col.made[usize.wrap(y - col.base)] = state
                    y -= 1
                }
            }
            return List<Span>()
        },
        Rule.Bands => {
            var rest = List<Span>()
            for s in spans {
                var y = s.top
                while y >= s.bottom {
                    col.made[usize.wrap(y - col.base)] = try band(mat, cur.bx, y, cur.bz)
                    y -= 1
                }
                unmade(col, s, mut rest)
            }
            return rest
        },
        Rule.Sequence(list) => {
            var rest = spans
            for r in list {
                rest = try apply_spans(rules, c, mat, p, mut biomes, mut cur, mut col, mut ctx, r, rest)
                if rest.is_empty() {
                    break
                }
            }
            return rest
        },
        Rule.If { condition, then_run } => {
            var holding = List<Span>()
            var failing = List<Span>()
            try split(rules, c, mat, p, mut biomes, mut cur, mut col, mut ctx, condition, spans, mut holding, mut failing)
            if holding.is_empty() {
                return failing
            }
            let rest = try apply_spans(rules, c, mat, p, mut biomes, mut cur, mut col, mut ctx, then_run, holding)
            for s in rest {
                failing.push(s)
            }
            return failing
        },
        Rule.Ore(k) => {
            // Where the block's prefilled density is at most 0 the vein gives nothing, so only
            // the blocks above 0 are worked out.
            let nv = c.narrowed
            let rx = cur.bx - nv.min_x
            let rz = cur.bz - nv.min_z
            let flat = nv.step_x == 1 and nv.step_y == 1 and nv.step_z == 1 and rx >= 0 and rz >= 0 and rx < nv.size_x and rz < nv.size_z
            let first = if flat { nv.index(rx, 0, rz) } else { 0 }
            var rest = List<Span>()
            for s in spans {
                var any = false
                var y = s.top
                while y >= s.bottom {
                    if flat {
                        // The column's prefilled densities run up from its first, so the blocks
                        // of the span in the volume whose density is at most 0 are passed over
                        // together.
                        var ry = y - nv.min_y
                        if ry >= 0 and ry < nv.size_y {
                            let stop = s.bottom.max(nv.min_y) - nv.min_y
                            ry = last_positive(c.ores[k].density_values, first, ry, stop)
                            y = nv.min_y + ry
                            if ry < stop {
                                continue
                            }
                        }
                    }
                    let made = try ore_vein(rules.ores[k], c.ores[k], c.narrowed, rules.ore_random, p, cur.bx, y, cur.bz, mut ctx)
                    if made != NONE {
                        col.made[usize.wrap(y - col.base)] = made
                        any = true
                    }
                    y -= 1
                }
                if any {
                    unmade(col, s, mut rest)
                } else {
                    rest.push(s)
                }
            }
            return rest
        },
    }
}

/// The highest of a column's prefilled values, from its `ry`th, at or above its `stop`th, that
/// is above 0, starting from `first` in `values`; `stop - 1` where there's none.
fn last_positive(values: List<f32>, first: i32, ry: i32, stop: i32) -> i32 {
    var at = ry
    while at >= stop and values[usize.wrap(first + at)] <= 0.0f32 {
        at -= 1
    }
    return at
}

/// `ConditionEvaluator.test` of the condition `i` at each of the column's blocks in `spans`:
/// those it holds at into `yes`, the rest into `no`.
fn split<B: BlockBiomes>(rules: Rules, c: Compiled, mat: Materials, p: Program, biomes: mut B, cur: mut Cursor, col: mut Runs, ctx: mut Context, i: usize, spans: List<Span>, yes: mut List<Span>, no: mut List<Span>) ! Thrown {
    if spans.is_empty() {
        return
    }
    match rules.conditions[i] {
        Condition.Biomes(set) => {
            let v = try biome_verdict(mut biomes, mut cur, i, set)
            for s in spans {
                if v == NONE_HOLD {
                    no.push(s)
                } else if v == ALL_HOLD {
                    yes.push(s)
                } else {
                    var y = s.top
                    while y >= s.bottom {
                        let b = try block_biome(p, mut biomes, cur, mut col, y)
                        col.holds[usize.wrap(y - col.base)] = set[usize.wrap(b)]
                        y -= 1
                    }
                    split_held(col, s.run, s.top, s.bottom, mut yes, mut no)
                }
            }
        },
        Condition.Threshold { noise, min, max, three_d } => {
            if three_d {
                noise_column(rules, mut cur, col.base, col.holds.len(), noise, spans)
                for s in spans {
                    var y = s.top
                    while y >= s.bottom {
                        let v = f64(cur.noise3[noise][usize.wrap(y - col.base)])
                        col.holds[usize.wrap(y - col.base)] = v >= min and v <= max
                        y -= 1
                    }
                    split_held(col, s.run, s.top, s.bottom, mut yes, mut no)
                }
            } else {
                let v = noise_value(rules, mut cur, noise)
                let holds = v >= min and v <= max
                for s in spans {
                    if holds {
                        yes.push(s)
                    } else {
                        no.push(s)
                    }
                }
            }
        },
        Condition.Gradient { random, true_at, false_at } => {
            let t = mat.gen.resolve(true_at)
            let f = mat.gen.resolve(false_at)
            for s in spans {
                // At `t` and below it always holds; above that, at `f` and above it never does,
                // and between them its random decides.
                let hold_top = s.top.min(t)
                if hold_top >= s.bottom {
                    yes.push(Span { run: s.run, top: hold_top, bottom: s.bottom })
                }
                let fail_bottom = s.bottom.max(t + 1).max(f)
                if s.top >= fail_bottom {
                    no.push(Span { run: s.run, top: s.top, bottom: fail_bottom })
                }
                let high = s.top.min(f - 1)
                let low = s.bottom.max(t + 1)
                if high >= low {
                    var y = high
                    while y >= low {
                        // `Mth.map(y, t, f, 1, 0)`.
                        let probability = 1.0 + ((f64(y) - f64(t)) / (f64(f) - f64(t))) * (0.0 - 1.0)
                        var r = random.at(cur.bx, y, cur.bz)
                        col.holds[usize.wrap(y - col.base)] = f64(r.next_float()) < probability
                        y -= 1
                    }
                    split_held(col, s.run, high, low, mut yes, mut no)
                }
            }
        },
        Condition.YAbove { anchor, multiplier, add } => {
            let level = mat.gen.resolve(anchor) + cur.depth * multiplier
            for s in spans {
                if add {
                    // A block and the stone above it make the stretch's top and the stone above
                    // that, at each of its blocks.
                    let r = usize(s.run)
                    if col.top[r] + col.above[r] >= level {
                        yes.push(s)
                    } else {
                        no.push(s)
                    }
                } else {
                    split_at(s, level, mut yes, mut no)
                }
            }
        },
        Condition.Water { offset, multiplier, add } => {
            for s in spans {
                let r = usize(s.run)
                let water = col.water[r]
                if water == i32.MIN {
                    yes.push(s)
                } else {
                    let level = water + offset + cur.depth * multiplier
                    if add {
                        if col.top[r] + col.above[r] >= level {
                            yes.push(s)
                        } else {
                            no.push(s)
                        }
                    } else {
                        split_at(s, level, mut yes, mut no)
                    }
                }
            }
        },
        Condition.Temperature => {
            for s in spans {
                var y = s.top
                while y >= s.bottom {
                    let b = try block_biome(p, mut biomes, cur, mut col, y)
                    col.holds[usize.wrap(y - col.base)] = not (temperature(mat, b, cur.bx, y, cur.bz) >= 0.15f32)
                    y -= 1
                }
                split_held(col, s.run, s.top, s.bottom, mut yes, mut no)
            }
        },
        Condition.Steep => {
            let steep = cur.gx <= -4 or cur.gz >= 4
            for s in spans {
                if steep {
                    yes.push(s)
                } else {
                    no.push(s)
                }
            }
        },
        Condition.Not(inner) => {
            try split(rules, c, mat, p, mut biomes, mut cur, mut col, mut ctx, inner, spans, mut no, mut yes)
        },
        Condition.Hole => {
            let hole = cur.depth <= 0
            for s in spans {
                if hole {
                    yes.push(s)
                } else {
                    no.push(s)
                }
            }
        },
        Condition.Preliminary => {
            let level = try min_surface(c, p, mut cur, mut ctx)
            for s in spans {
                split_at(s, level, mut yes, mut no)
            }
        },
        Condition.StoneDepth { offset, add, range, ceiling } => {
            let surface = if add { cur.depth } else { 0 }
            var extra = 0
            if range != 0 {
                // `(int) Mth.map(secondary, -1, 1, 0, range)`.
                let v = secondary(mat, mut cur)
                extra = i32.saturate(0.0 + ((v - -1.0) / (1.0 - -1.0)) * (f64(range) - 0.0))
            }
            let most = 1 + offset + surface + extra
            for s in spans {
                let r = usize(s.run)
                if ceiling {
                    // The stone below a block is at most `most` up to `most - 1` over the
                    // stretch's bottom.
                    split_at(s, col.bottom[r] + most, mut no, mut yes)
                } else {
                    // The stone above it is at most `most` from `most` less than the stretch's
                    // top and the stone above that.
                    split_at(s, col.top[r] + col.above[r] - most, mut yes, mut no)
                }
            }
        },
    }
}

/// `OreVeinRule`'s evaluator: the vein's ore, raw ore or filler where its density and random
/// let it be.
fn ore_vein(o: OreRule, b: OreBuffers, narrowed: Volume, random: AnyPositional, p: Program, x: i32, y: i32, z: i32, ctx: mut Context) -> u32 ! Thrown {
    let density = try density_at(narrowed, b.density_values, b.density, p, mut ctx, x, y, z)
    if density <= 0.0f32 {
        return NONE
    }
    var r = random.at(x, y, z)
    if r.next_float() > density {
        return NONE
    }
    let richness = try sample(p, mut ctx, b.richness, x, y, z)
    if r.next_float() < richness {
        let gap = try sample(p, mut ctx, b.gap, x, y, z)
        if gap < 0.0f32 {
            return if r.next_float() < o.chance { o.raw } else { o.ore }
        }
    }
    return o.filler
}

/// A prefilled `DensityGetter`: the buffer's value at the block, or a sample outside it.
fn density_at(v: Volume, values: List<f32>, s: usize, p: Program, ctx: mut Context, x: i32, y: i32, z: i32) -> f32 ! Thrown {
    let index = v.index_of_block(x, y, z)
    if index == -1 {
        return try sample(p, mut ctx, s, x, y, z)
    }
    return values[usize.wrap(index)]
}

// Building the surface.

/// `MaterialSystem.buildSurface` of the chunk at `cx`, `cz`, filled into `f` through `ctx`, with
/// the biomes `biomes` gives: the rule compiled for the chunk, then each column from its top down,
/// with the eroded badlands' pillars before and the frozen oceans' icebergs after.
pub fn build_surface<B: BlockBiomes>(f: mut Filled, functions: mut Functions, mat: Materials, rules: Rules, states: BlockStates, ctx: mut Context, biomes: mut B, cx: i32, cz: i32) ! Thrown {
    let level_min = f.min_y
    var highest = -1
    var section = (f.height >> 4) - 1
    while section >= 0 {
        if filled_section(f, states, section) {
            highest = section
            break
        }
        section -= 1
    }
    let max_block_y = (highest + (level_min >> 4)) * 16 + 15
    let narrowed = try volume(16, (max_block_y - mat.low + 1).max(1), 16, cx << 4, mat.low, cz << 4, 1, 1, 1)
    let preliminary = try volume(16, 1, 16, cx << 4, 0, cz << 4, 1, 1, 1)
    let c = try compile(mut functions, mat, rules, mut ctx, narrowed, preliminary)
    var cur = cursor(rules)
    var col = Runs.new(level_min, f.height)
    for x in 0..16 {
        for z in 0..16 {
            let bx = (cx << 4) + x
            let bz = (cz << 4) + z
            let column = usize.wrap(x + z * 16)
            let starting = f.world_surface[column]
            let surface_biome = try biomes.biome(functions.program, bx, starting, bz)
            if surface_biome == mat.eroded_badlands {
                eroded_badlands(mut f, mat, states, bx, bz, x, z, starting)
            }
            let height = f.world_surface[column]
            let gx = f.world_surface[usize.wrap((x + 1).min(15) + z * 16)] - f.world_surface[usize.wrap((x - 1).max(0) + z * 16)]
            let gz = f.world_surface[usize.wrap(x + (z + 1).min(15) * 16)] - f.world_surface[usize.wrap(x + (z - 1).max(0) * 16)]
            cur.update_xz(mat, bx, bz, gx, gz)
            // The column's stretches of stone are read before any block is placed, as each
            // block's place is worked out from the blocks as they were.
            col.clear()
            var above = 0
            var water = i32.MIN
            // The top of the stretch the scan is in, `i32.MIN` for none, and the stone above it
            // and the water over it.
            var top = i32.MIN
            var top_above = 0
            var top_water = 0
            var y = height
            while y >= level_min {
                let old = block_at(f, mat.void_air, x, z, y)
                if states.is_air(old) {
                    if top != i32.MIN {
                        col.add(top, y + 1, top_above, top_water)
                        top = i32.MIN
                    }
                    above = 0
                    water = i32.MIN
                } else if states.flags(old) & FLUID != 0 {
                    if top != i32.MIN {
                        col.add(top, y + 1, top_above, top_water)
                        top = i32.MIN
                    }
                    if water == i32.MIN {
                        water = y + 1
                    }
                } else {
                    above += 1
                    if top == i32.MIN {
                        top = y
                        top_above = above
                        top_water = water
                    }
                }
                y -= 1
            }
            if top != i32.MIN {
                col.add(top, level_min, top_above, top_water)
            }
            if not col.top.is_empty() {
                let all = col.spans()
                _ = try apply_spans(rules, c, mat, functions.program, mut biomes, mut cur, mut col, mut ctx, rules.root, all)
                for r in 0..col.top.len() {
                    var at_y = col.top[r]
                    while at_y >= col.bottom[r] {
                        let at = usize.wrap(at_y - level_min)
                        let state = col.made[at]
                        if state != NONE {
                            set_block(mut f, states, x, z, at_y, state)
                            col.made[at] = NONE
                        }
                        at_y -= 1
                    }
                }
            }
            if surface_biome == mat.frozen_ocean or surface_biome == mat.deep_frozen_ocean {
                let level = try min_surface(c, functions.program, mut cur, mut ctx)
                frozen_ocean(mut f, mat, states, level, surface_biome, bx, bz, x, z, starting)
            }
        }
    }
}

/// The rule compiled over `narrowed`, the volume its ore veins prefill, with the preliminary
/// surface over `preliminary`: `ruleSource.compile` in a new `MaterialRuleContext`.
fn compile(functions: mut Functions, mat: Materials, rules: Rules, ctx: mut Context, narrowed: Volume, preliminary: Volume) -> Compiled ! Thrown {
    var c = Compiled { narrowed: narrowed, preliminary_volume: preliminary, preliminary: 0, preliminary_thrown: none, ores: [] }
    for _ in 0..rules.ores.len() {
        c.ores.push(OreBuffers { density: 0, richness: 0, gap: 0, density_values: [] })
    }
    var seen: List<bool> = [false; rules.rules.len()]
    var seen_conditions: List<bool> = [false; rules.conditions.len()]
    try compile_rule(mut functions, rules, mut ctx, mut c, mut seen, mut seen_conditions, rules.root)
    match functions.sampler(mat.preliminary) {
        ok(s) => c.preliminary = s,
        err(thrown) => c.preliminary_thrown = some(thrown),
    }
    return c
}

/// A new context's cursor, with nothing worked out yet.
fn cursor(rules: Rules) -> Cursor {
    let noises = rules.stacks.len()
    return Cursor {
        noise2_at: [-1; noises],
        noise2: [0.0; noises],
    }
}

/// `MaterialSystem.topMaterial`, which the carvers ask for the dirt under a carved grass or
/// mycelium block: the rule compiled for that one block, with no possible biomes, the column's
/// gradients from `f`'s world-surface heightmap, one block of stone above and below, and the
/// water just above if it's under a fluid. `NONE` where the rule gives nothing.
pub fn top_material<B: BlockBiomes>(f: Filled, functions: mut Functions, mat: Materials, rules: Rules, ctx: mut Context, biomes: mut B, x: i32, y: i32, z: i32, under_fluid: bool) -> u32 ! Thrown {
    let narrowed = try volume(1, 1, 1, x, y, z, 1, 1, 1)
    let preliminary = try volume(1, 1, 1, x, 0, z, 1, 1, 1)
    let c = try compile(mut functions, mat, rules, mut ctx, narrowed, preliminary)
    var cur = cursor(rules)
    let lx = x & 15
    let lz = z & 15
    let gx = f.world_surface[usize.wrap((lx + 1).min(15) + lz * 16)] - f.world_surface[usize.wrap((lx - 1).max(0) + lz * 16)]
    let gz = f.world_surface[usize.wrap(lx + (lz + 1).min(15) * 16)] - f.world_surface[usize.wrap(lx + (lz - 1).max(0) * 16)]
    cur.update_xz(mat, x, z, gx, gz)
    var col = Runs.new(y, 1)
    col.add(y, y, 1, if under_fluid { y + 1 } else { i32.MIN })
    let all = col.spans()
    _ = try apply_spans(rules, c, mat, functions.program, mut biomes, mut cur, mut col, mut ctx, rules.root, all)
    return col.made[0]
}

/// Whether the section `s` of the chunk has a block that isn't air: `hasOnlyAir`, negated.
fn filled_section(f: Filled, states: BlockStates, s: i32) -> bool {
    let start = usize.wrap(s) * 4096
    for i in start..start + 4096 {
        if not states.is_air(u32(f.states[i])) {
            return true
        }
    }
    return false
}

/// `ProtoChunk.getBlockState` in the column: void air outside the world.
pub fn block_at(f: Filled, void_air: u32, x: i32, z: i32, y: i32) -> u32 {
    if y < f.min_y or y >= f.min_y + f.height {
        return void_air
    }
    return u32(f.states[usize.wrap(((y - f.min_y) << 8) | (z << 4) | x)])
}

/// The column's `setBlock`: inside the world, the block and the `_WG` heightmaps, and the block
/// marked for post-processing if it holds a fluid.
pub fn set_block(f: mut Filled, states: BlockStates, x: i32, z: i32, y: i32, state: u32) {
    place(mut f, states, x, z, y, state)
    if states.flags(state) & FLUID != 0 {
        mark(mut f, x, z, y)
    }
}

/// `ProtoChunk.setBlockState` of a block in the chunk's column `x`, `z`: inside the world, the
/// block and the `_WG` heightmaps.
pub fn place(f: mut Filled, states: BlockStates, x: i32, z: i32, y: i32, state: u32) {
    if y < f.min_y or y >= f.min_y + f.height {
        return
    }
    let column = usize.wrap(x + z * 16)
    f.states[usize.wrap(((y - f.min_y) << 8) | (z << 4) | x)] = u16.wrap(state)
    update(mut f.ocean_floor, f.states, states, OCEAN_FLOOR_WG, column, x, z, y, state, f.min_y)
    update(mut f.world_surface, f.states, states, WORLD_SURFACE_WG, column, x, z, y, state, f.min_y)
}

/// `markPosForPostProcessing`: inside the world, the block marked, by its section.
pub fn mark(f: mut Filled, x: i32, z: i32, y: i32) {
    if y < f.min_y or y >= f.min_y + f.height {
        return
    }
    f.marked[usize.wrap((y - f.min_y) >> 4)].push(u16.wrap(x | ((y & 15) << 4) | (z << 8)))
}

/// `erodedBadlandsExtension`: a pillar of the default block up from the ground, where the
/// pillar noise is high and no water is under it.
fn eroded_badlands(f: mut Filled, mat: Materials, states: BlockStates, bx: i32, bz: i32, x: i32, z: i32, height: i32) {
    let surface = (f64(mat.badlands_surface.get(f64(bx), 0.0, f64(bz))) * 8.25).abs()
    let pillar = f64(mat.badlands_pillar.get(f64(bx) * 0.2, 0.0, f64(bz) * 0.2) * 15.0f32)
    let buffer = java_min(surface, pillar)
    if buffer <= 0.0 {
        return
    }
    let floor_value = (f64(mat.badlands_roof.get(f64(bx) * 0.75, 0.0, f64(bz) * 0.75)) * 1.5).abs()
    let top = 64.0 + java_min(buffer * buffer * 2.5, (floor_value * 50.0).ceil() + 24.0)
    let start = floor(top)
    if height > start {
        return
    }
    var y = start
    while y >= f.min_y {
        let old = states.block_of(block_at(f, mat.void_air, x, z, y))
        if old == mat.default_block_id {
            break
        }
        if old == mat.water {
            return
        }
        y -= 1
    }
    y = start
    while y >= f.min_y and states.is_air(block_at(f, mat.void_air, x, z, y)) {
        set_block(mut f, states, x, z, y, mat.default_block)
        y -= 1
    }
}

/// `frozenOceanExtension`: an iceberg of packed ice, snow on its top, where the iceberg noise is
/// high, from above the sea down to the column's least surface.
fn frozen_ocean(f: mut Filled, mat: Materials, states: BlockStates, lowest: i32, biome: i32, bx: i32, bz: i32, x: i32, z: i32, height: i32) {
    let surface = (f64(mat.iceberg_surface.get(f64(bx), 0.0, f64(bz))) * 8.25).abs()
    let pillar = f64(mat.iceberg_pillar.get(f64(bx) * 1.28, 0.0, f64(bz) * 1.28) * 15.0f32)
    let iceberg = java_min(surface, pillar)
    if iceberg <= 1.8 {
        return
    }
    let roof = (f64(mat.iceberg_roof.get(f64(bx) * 1.17, 0.0, f64(bz) * 1.17)) * 1.5).abs()
    var top = java_min(iceberg * iceberg * 1.2, (roof * 40.0).ceil() + 14.0)
    // `shouldMeltFrozenOceanIcebergSlightly` at the sea.
    if temperature(mat, biome, bx, mat.sea, bz) > 0.1f32 {
        top -= 2.0
    }
    if top <= 2.0 {
        return
    }
    let bottom = f64(mat.sea) - top - 7.0
    top += f64(mat.sea)
    let top_y = i32.saturate(top)
    let bottom_y = i32.saturate(bottom)
    var r = mat.noise_random.at(bx, 0, bz)
    let max_snow = 2 + r.next_int_below(4)
    let min_snow_height = mat.sea + 18 + r.next_int_below(10)
    var snow = 0
    var y = height.max(top_y + 1)
    while y >= lowest {
        let state = block_at(f, mat.void_air, x, z, y)
        let ice = (states.is_air(state) and y < top_y and r.next_double() > 0.01) or (states.block_of(state) == mat.water and y > bottom_y and y < mat.sea and r.next_double() > 0.15)
        if ice {
            if snow <= max_snow and y > min_snow_height {
                set_block(mut f, states, x, z, y, mat.snow_block)
                snow += 1
            } else {
                set_block(mut f, states, x, z, y, mat.packed_ice)
            }
        }
        y -= 1
    }
}

/// `Math.min(double, double)`, NaN if either is.
fn java_min(a: f64, b: f64) -> f64 {
    if a != a {
        return a
    }
    return if a <= b { a } else { b }
}

/// `Mth.floor`.
fn floor(v: f64) -> i32 {
    return i32.saturate(v.floor())
}
