/// What `StructurePiece` gives the hand-built pieces to place their blocks with: positions in the
/// piece's own frame turned into the world's by its orientation, blocks set only in the chunk
/// being decorated, mirrored and turned as the orientation says, boxes, spheres and columns of
/// them, and chests and dispensers with their loot tables.
module worldgen.drawing

import random.source.{RandomSource}
import worldgen.facts.{EAST, Facts, NORTH, SOUTH, WEST, direction_name, horizontal, opposite, clockwise, step_x, step_z}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Piece}
import worldgen.region.{Region}
import worldgen.template.{Bounds, CLOCKWISE_90, LEFT_RIGHT, MIRROR_NONE, ROTATION_NONE}
import world.chunk.{OCEAN_FLOOR_WG}

/// `Block.UPDATE_CLIENTS`, which pieces set their blocks with.
pub const UPDATE_CLIENTS: i32 = 2
/// `Block.UPDATE_ALL`, which `setBlockAndUpdate` sets with.
pub const UPDATE_ALL: i32 = 3

/// A piece as its helpers see it: its box, the direction it faces or -1, and the mirror and
/// rotation that direction gives its blocks.
pub struct Frame {
    pub bb: Bounds
    pub orientation: i32
    pub mirror: i32
    pub rotation: i32
}

impl Frame {
    /// `setOrientation`: south mirrors left to right, west mirrors and turns clockwise, east
    /// turns clockwise.
    pub fn of(p: Piece) -> Frame {
        return Frame.facing(p.bb, p.orientation)
    }

    pub fn facing(bb: Bounds, d: i32) -> Frame {
        var mirror = MIRROR_NONE
        var rotation = ROTATION_NONE
        if d == SOUTH {
            mirror = LEFT_RIGHT
        } else if d == WEST {
            mirror = LEFT_RIGHT
            rotation = CLOCKWISE_90
        } else if d == EAST {
            rotation = CLOCKWISE_90
        }
        return Frame { bb: bb, orientation: d, mirror: mirror, rotation: rotation }
    }

    /// `getWorldX`.
    pub fn x(self, x: i32, z: i32) -> i32 {
        if self.orientation == NORTH or self.orientation == SOUTH {
            return self.bb.min_x + x
        }
        if self.orientation == WEST {
            return self.bb.max_x - z
        }
        if self.orientation == EAST {
            return self.bb.min_x + z
        }
        return x
    }

    /// `getWorldY`.
    pub fn y(self, y: i32) -> i32 {
        return if self.orientation < 0 { y } else { y + self.bb.min_y }
    }

    /// `getWorldZ`.
    pub fn z(self, x: i32, z: i32) -> i32 {
        if self.orientation == NORTH {
            return self.bb.max_z - z
        }
        if self.orientation == SOUTH {
            return self.bb.min_z + z
        }
        if self.orientation == WEST or self.orientation == EAST {
            return self.bb.min_z + x
        }
        return z
    }
}

/// The default state of the block `minecraft:{name}`.
pub fn block_state(f: Facts, name: str) -> u32 ! Thrown {
    return f.default_state(try f.named_block(String(name)))
}

/// The state with its `facing` set to the direction.
pub fn facing(f: Facts, state: u32, d: i32) -> u32 ! Thrown {
    return try f.with_name(state, String("facing"), direction_name(d))
}

/// The state with its property set to the value named.
pub fn with(f: Facts, state: u32, name: str, value: str) -> u32 ! Thrown {
    return try f.with_name(state, String(name), String(value))
}

/// `placeBlock`: the block set at the piece's `x, y, z`, if that's in the chunk, mirrored and
/// turned as the piece is; a fluid there gets a tick, and a block whose shape its neighbours
/// decide is marked for post-processing.
pub fn place(f: Facts, r: mut Region, fr: Frame, state: u32, x: i32, y: i32, z: i32, area: Bounds) {
    let wx = fr.x(x, z)
    let wy = fr.y(y)
    let wz = fr.z(x, z)
    if not area.inside(wx, wy, wz) {
        return
    }
    try_place(f, mut r, fr, state, wx, wy, wz)
}

/// `placeBlock` past the check that the block's in the chunk, at a world position: what the
/// mineshaft's pieces, which may refuse a block, call once they've checked.
pub fn try_place(f: Facts, r: mut Region, fr: Frame, state: u32, wx: i32, wy: i32, wz: i32) {
    var s = state
    if fr.mirror != MIRROR_NONE {
        s = f.mirror(s, fr.mirror)
    }
    if fr.rotation != ROTATION_NONE {
        s = f.rotate(s, fr.rotation)
    }
    _ = r.set_block(f, wx, wy, wz, s, UPDATE_CLIENTS)
    let fluid = f.fluid(s)
    if fluid != 0 {
        r.schedule_fluid(fluid, wx, wy, wz)
    }
    if shape_checked(f, s) {
        r.mark(wx, wy, wz)
    }
}

// `SHAPE_CHECK_BLOCKS`.
fn shape_checked(f: Facts, state: u32) -> bool {
    let name = f.codec.blocks.name(f.block(state))
    let names: List<str> = ["nether_brick_fence", "torch", "wall_torch", "oak_fence", "spruce_fence", "dark_oak_fence", "pale_oak_fence", "acacia_fence", "birch_fence", "jungle_fence", "ladder", "iron_bars"]
    for n in names {
        if name == "minecraft:{n}" {
            return true
        }
    }
    return false
}

/// `getBlock`: the block at the piece's `x, y, z`, air if that isn't in the chunk.
pub fn get(f: Facts, r: Region, fr: Frame, x: i32, y: i32, z: i32, area: Bounds) -> u32 ! Thrown {
    let wx = fr.x(x, z)
    let wy = fr.y(y)
    let wz = fr.z(x, z)
    if not area.inside(wx, wy, wz) {
        return f.ids.air_state
    }
    return try r.state(f, wx, wy, wz)
}

/// `isInterior`: whether the block above is in the chunk and under the ocean floor.
pub fn interior(f: Facts, r: mut Region, fr: Frame, x: i32, y: i32, z: i32, area: Bounds) -> bool ! Thrown {
    let wx = fr.x(x, z)
    let wy = fr.y(y + 1)
    let wz = fr.z(x, z)
    if not area.inside(wx, wy, wz) {
        return false
    }
    return wy < try r.get_height(f, OCEAN_FLOOR_WG, wx, wz)
}

/// `generateBox`: `edge` on the box's faces and `fill` inside it, past what's air if
/// `skip_air`.
pub fn box(f: Facts, r: mut Region, fr: Frame, area: Bounds, x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, edge: u32, fill: u32, skip_air: bool) ! Thrown {
    for y in y0..y1 + 1 {
        for x in x0..x1 + 1 {
            for z in z0..z1 + 1 {
                if skip_air and f.is_air(try get(f, r, fr, x, y, z, area)) {
                    continue
                }
                if y != y0 and y != y1 and x != x0 and x != x1 and z != z0 and z != z1 {
                    place(f, mut r, fr, fill, x, y, z, area)
                } else {
                    place(f, mut r, fr, edge, x, y, z, area)
                }
            }
        }
    }
}

/// `generateAirBox`.
pub fn air_box(f: Facts, r: mut Region, fr: Frame, area: Bounds, x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32) {
    for y in y0..y1 + 1 {
        for x in x0..x1 + 1 {
            for z in z0..z1 + 1 {
                place(f, mut r, fr, f.ids.air_state, x, y, z, area)
            }
        }
    }
}

/// `generateMaybeBox`: each block placed with the chance, past what's air if `skip_air`, and
/// only where it's interior if `inside`.
pub fn maybe_box<T: RandomSource>(f: Facts, r: mut Region, fr: Frame, area: Bounds, random: mut T, chance: f32, x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, edge: u32, fill: u32, skip_air: bool, inside: bool) ! Thrown {
    for y in y0..y1 + 1 {
        for x in x0..x1 + 1 {
            for z in z0..z1 + 1 {
                if random.next_float() > chance {
                    continue
                }
                if skip_air and f.is_air(try get(f, r, fr, x, y, z, area)) {
                    continue
                }
                if inside and not try interior(f, mut r, fr, x, y, z, area) {
                    continue
                }
                if y != y0 and y != y1 and x != x0 and x != x1 and z != z0 and z != z1 {
                    place(f, mut r, fr, fill, x, y, z, area)
                } else {
                    place(f, mut r, fr, edge, x, y, z, area)
                }
            }
        }
    }
}

/// `maybeGenerateBlock`.
pub fn maybe_block<T: RandomSource>(f: Facts, r: mut Region, fr: Frame, area: Bounds, random: mut T, chance: f32, x: i32, y: i32, z: i32, state: u32) {
    if random.next_float() < chance {
        place(f, mut r, fr, state, x, y, z, area)
    }
}

/// `generateUpperHalfSphere`.
pub fn upper_half_sphere(f: Facts, r: mut Region, fr: Frame, area: Bounds, x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, fill: u32, skip_air: bool) ! Thrown {
    let diag_x = fl(x1 - x0 + 1)
    let diag_y = fl(y1 - y0 + 1)
    let diag_z = fl(z1 - z0 + 1)
    let cx = fl(x0) + diag_x / 2.0f32
    let cz = fl(z0) + diag_z / 2.0f32
    for y in y0..y1 + 1 {
        let ny = fl(y - y0) / diag_y
        for x in x0..x1 + 1 {
            let nx = (fl(x) - cx) / (diag_x * 0.5f32)
            for z in z0..z1 + 1 {
                let nz = (fl(z) - cz) / (diag_z * 0.5f32)
                if skip_air and f.is_air(try get(f, r, fr, x, y, z, area)) {
                    continue
                }
                let dist = nx * nx + ny * ny + nz * nz
                if dist <= 1.05f32 {
                    place(f, mut r, fr, fill, x, y, z, area)
                }
            }
        }
    }
}

/// `isReplaceableByStructures`: air, a liquid, glow lichen, seagrass or tall seagrass.
pub fn replaceable_by_structures(f: Facts, state: u32) -> bool ! Thrown {
    if f.is_air(state) or f.is_liquid(state) {
        return true
    }
    let b = f.block(state)
    return b == try f.named_block(String("glow_lichen")) or b == try f.named_block(String("seagrass")) or b == try f.named_block(String("tall_seagrass"))
}

/// `fillColumnDown`: the block set down from the piece's `x, y, z` through what structures
/// replace, to one above the world's bottom, if the top is in the chunk.
pub fn fill_down(f: Facts, r: mut Region, fr: Frame, area: Bounds, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let wx = fr.x(x, z)
    var wy = fr.y(y)
    let wz = fr.z(x, z)
    if not area.inside(wx, wy, wz) {
        return
    }
    while try replaceable_by_structures(f, try r.state(f, wx, wy, wz)) and wy > r.min_y + 1 {
        _ = r.set_block(f, wx, wy, wz, state, UPDATE_CLIENTS)
        wy -= 1
    }
}

/// `StructurePiece.reorient`: the chest facing away from its one solid neighbour, or turned from
/// the way it faces until it doesn't face one; as it is beside another chest.
pub fn reorient(f: Facts, r: Region, x: i32, y: i32, z: i32, state: u32) -> u32 ! Thrown {
    var solid = -1
    for i in 0..4 {
        let d = horizontal(i)
        let s = try r.state(f, x + step_x(d), y, z + step_z(d))
        if f.is(s, f.ids.chest) {
            return state
        }
        if f.solid_render(s) {
            if solid >= 0 {
                solid = -1
                break
            }
            solid = d
        }
    }
    if solid >= 0 {
        return try facing(f, state, opposite(solid))
    }
    let named = f.get_name(state, String("facing")) ?? String("north")
    var lock = NORTH
    for i in 0..4 {
        if direction_name(horizontal(i)) == named {
            lock = horizontal(i)
        }
    }
    if f.solid_render(try r.state(f, x + step_x(lock), y, z + step_z(lock))) {
        lock = opposite(lock)
    }
    if f.solid_render(try r.state(f, x + step_x(lock), y, z + step_z(lock))) {
        lock = clockwise(lock)
    }
    if f.solid_render(try r.state(f, x + step_x(lock), y, z + step_z(lock))) {
        lock = opposite(lock)
    }
    return try facing(f, state, lock)
}

/// `createChest` at a world position: a chest, turned by `reorient` unless `state` is given,
/// with the loot table and a seed from the random, if the position is in the chunk and isn't a
/// chest already.
pub fn chest_at<T: RandomSource>(f: Facts, r: mut Region, area: Bounds, random: mut T, x: i32, y: i32, z: i32, table: str, state: u32?) -> bool ! Thrown {
    if not area.inside(x, y, z) or f.is(try r.state(f, x, y, z), f.ids.chest) {
        return false
    }
    let s = state ?? try reorient(f, r, x, y, z, f.default_state(f.ids.chest))
    _ = r.set_block(f, x, y, z, s, UPDATE_CLIENTS)
    if let kind = try r.block_entity(f, x, y, z) {
        if kind == "minecraft:chest" {
            r.set_loot_table(x, y, z, String(table), random.next_long())
        }
    }
    return true
}

/// `createChest` at the piece's `x, y, z`.
pub fn chest<T: RandomSource>(f: Facts, r: mut Region, fr: Frame, area: Bounds, random: mut T, x: i32, y: i32, z: i32, table: str) -> bool ! Thrown {
    return try chest_at(f, mut r, area, mut random, fr.x(x, z), fr.y(y), fr.z(x, z), table, none)
}

/// `createDispenser`: a dispenser facing `d`, placed as the piece places blocks, with the loot
/// table and a seed from the random.
pub fn dispenser<T: RandomSource>(f: Facts, r: mut Region, fr: Frame, area: Bounds, random: mut T, x: i32, y: i32, z: i32, d: i32, table: str) -> bool ! Thrown {
    let wx = fr.x(x, z)
    let wy = fr.y(y)
    let wz = fr.z(x, z)
    let block = try f.named_block(String("dispenser"))
    if not area.inside(wx, wy, wz) or f.is(try r.state(f, wx, wy, wz), block) {
        return false
    }
    place(f, mut r, fr, try facing(f, f.default_state(block), d), x, y, z, area)
    if let kind = try r.block_entity(f, wx, wy, wz) {
        if kind == "minecraft:dispenser" {
            r.set_loot_table(wx, wy, wz, String(table), random.next_long())
        }
    }
    return true
}

// An int as Java makes it a float: the nearest.
fn fl(v: i32) -> f32 {
    return f32.nearest(f64(v))
}
