/// The structures of one piece or a few: buried treasure, desert pyramids, jungle temples,
/// swamp huts, igloos, shipwrecks, ocean ruins, Nether fossils and ruined portals, started as
/// their `Structure` classes start them.
module worldgen.scattered

import json.tree.{Json, Member, as_string}
import pack.zip.{Zip}
import random.legacy.{LegacyRandom}
import random.worldgen.{WorldgenRandom}
import world.chunk.{OCEAN_FLOOR_WG, WORLD_SURFACE_WG}
import worldgen.codec.{bool_field, field, float_range_field, map_of}
import worldgen.facts.{FULL, NORTH, UP}
import worldgen.interval.{Thrown}
import worldgen.pieces.{IN_MOUNTAIN, IN_NETHER, ON_OCEAN_FLOOR, PARTLY_BURIED, Piece, PieceData, PortalProperties, TemplateKind, TemplatePiece, UNDERGROUND, portal_placements, random_horizontal, scattered}
import worldgen.predicates.{list_of}
import worldgen.providers.{HeightProvider, between_inclusive, next_in}
import worldgen.structure_world.{StructureWorld, column_block}
import worldgen.template.{Bounds, FRONT_BACK, MIRROR_NONE, Settings, transform}
import worldgen.terrain.{Column}

/// `RuinedPortalStructure.Setup`.
pub struct PortalSetup {
    pub placement: i32
    pub air_pocket: f32
    pub mossiness: f32
    pub overgrown: bool
    pub vines: bool
    pub can_be_cold: bool
    pub blackstone: bool
    pub weight: f32
}

/// `RuinedPortalStructure.CODEC`'s `setups`: a list that isn't empty.
pub fn read_portal_setups(m: List<Member>) -> List<PortalSetup> ! String {
    let v = field(m, "setups") else fail "No key setups in MapLike"
    var out = List<PortalSetup>()
    for item in try list_of(v) {
        let s = try map_of(item)
        let pv = field(s, "placement") else fail "No key placement in MapLike"
        let name = as_string(pv) else fail "Not a string: {pv}"
        var placement = -1
        let placements = portal_placements()
        for i in 0..placements.len() {
            if name == String(placements[i]) {
                placement = i32.wrap(i)
            }
        }
        if placement < 0 {
            fail "Unknown element name:{name}"
        }
        let weight_value = field(s, "weight") else fail "No key weight in MapLike"
        let weight = match weight_value {
            Json.Number(text) => f32.parse(text) ?? 0.0f32,
            _ => fail "Not a number: {weight_value}",
        }
        if not (weight > 0.0f32) {
            fail "Value must be positive: {weight}"
        }
        out.push(PortalSetup {
            placement: placement,
            air_pocket: try float_range_field(s, "air_pocket_probability", 0.0f32, 1.0f32),
            mossiness: try float_range_field(s, "mossiness", 0.0f32, 1.0f32),
            overgrown: try bool_field(s, "overgrown"),
            vines: try bool_field(s, "vines"),
            can_be_cold: try bool_field(s, "can_be_cold"),
            blackstone: try bool_field(s, "replace_with_blackstone"),
            weight: weight,
        })
    }
    if out.is_empty() {
        fail "List must have contents"
    }
    return out
}

// `onTopOfChunkCenter`'s start: the middle of the chunk on the heightmap, if a biome the
// structure allows could be in its column and is where it starts.
fn center_start(w: mut StructureWorld, cx: i32, cz: i32, kind: i32, allowed: List<i32>) -> bool ! Thrown {
    if not try w.valid_at_center(cx, cz, allowed) {
        return false
    }
    let x = (cx << 4) + 8
    let z = (cz << 4) + 8
    let y = try w.first_occupied(x, z, kind)
    return try w.valid_biome(x, y, z, allowed)
}

/// `BuriedTreasureStructure`.
pub fn buried_treasure(w: mut StructureWorld, cx: i32, cz: i32, allowed: List<i32>) -> List<Piece> ! Thrown {
    if not try center_start(mut w, cx, cz, OCEAN_FLOOR_WG, allowed) {
        return List<Piece>()
    }
    let x = (cx << 4) + 9
    let z = (cz << 4) + 9
    let bb = Bounds { min_x: x, min_y: 90, min_z: z, max_x: x, max_y: 90, max_z: z }
    return [Piece { kind: String("minecraft:btp"), bb: bb, orientation: -1, gen_depth: 0, data: PieceData.Plain }]
}

/// `SinglePieceStructure`'s start for a piece `width` by `depth`: none where its corners are
/// below the sea.
fn single_piece_start(w: mut StructureWorld, cx: i32, cz: i32, width: i32, depth: i32, allowed: List<i32>) -> bool ! Thrown {
    if not try w.valid_at_center(cx, cz, allowed) {
        return false
    }
    if try w.lowest_y(cx << 4, cz << 4, width, depth) < w.sea_level() {
        return false
    }
    let x = (cx << 4) + 8
    let z = (cz << 4) + 8
    let y = try w.first_occupied(x, z, WORLD_SURFACE_WG)
    return try w.valid_biome(x, y, z, allowed)
}

/// `DesertPyramidStructure`.
pub fn desert_pyramid(w: mut StructureWorld, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    if not try single_piece_start(mut w, cx, cz, 21, 21, allowed) {
        return List<Piece>()
    }
    let d = random_direction(mut random)
    return [scattered("minecraft:tedp", cx << 4, 64, cz << 4, 21, 15, 21, d, ["hasPlacedChest0", "hasPlacedChest1", "hasPlacedChest2", "hasPlacedChest3"])]
}

/// `JungleTempleStructure`.
pub fn jungle_temple(w: mut StructureWorld, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    if not try single_piece_start(mut w, cx, cz, 12, 15, allowed) {
        return List<Piece>()
    }
    let d = random_direction(mut random)
    return [scattered("minecraft:tejp", cx << 4, 64, cz << 4, 12, 10, 15, d, ["placedMainChest", "placedHiddenChest", "placedTrap1", "placedTrap2"])]
}

/// `SwampHutStructure`.
pub fn swamp_hut(w: mut StructureWorld, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    if not try center_start(mut w, cx, cz, WORLD_SURFACE_WG, allowed) {
        return List<Piece>()
    }
    let d = random_direction(mut random)
    return [scattered("minecraft:tesh", cx << 4, 64, cz << 4, 7, 7, 9, d, ["Witch", "Cat"])]
}

// `getRandomHorizontalDirection`.
fn random_direction(random: mut WorldgenRandom<LegacyRandom>) -> i32 {
    return random_horizontal(mut random)
}

// A template piece of the kind: the template placed from the block, turned and mirrored about
// the pivot, its box the template's.
fn template_piece(w: mut StructureWorld, zip: Zip, piece: str, name: own String, x: i32, y: i32, z: i32, rotation: i32, mirror: i32, px: i32, py: i32, pz: i32, kind: own TemplateKind) -> Piece ! Thrown {
    let t = try w.template(zip, name.copy())
    let s = Settings { mirror: mirror, rotation: rotation, pivot_x: px, pivot_z: pz }
    let bb = w.templates.list[t].bounding_box(s, x, y, z)
    let data = TemplatePiece { name: name, template: t, x: x, y: y, z: z, rotation: rotation, mirror: mirror, pivot_x: px, pivot_y: py, pivot_z: pz, kind: kind }
    return Piece { kind: String(piece), bb: bb, orientation: NORTH, gen_depth: 0, data: PieceData.Template(data) }
}

/// `IglooStructure`: the igloo, and half the time a ladder down to its laboratory.
pub fn igloo(w: mut StructureWorld, zip: Zip, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    if not try center_start(mut w, cx, cz, WORLD_SURFACE_WG, allowed) {
        return List<Piece>()
    }
    let x = cx << 4
    let z = cz << 4
    let rotation = random.next_int_below(4)
    var out = List<Piece>()
    if random.next_double() < 0.5 {
        let depth = random.next_int_below(8) + 4
        out.push(try template_piece(mut w, zip, "minecraft:iglu", String("minecraft:igloo/bottom"), x, 90 - 3 - depth * 3, z - 2, rotation, MIRROR_NONE, 3, 6, 7, TemplateKind.Igloo))
        for i in 0..depth - 1 {
            out.push(try template_piece(mut w, zip, "minecraft:iglu", String("minecraft:igloo/middle"), x + 2, 90 - 3 - i * 3, z + 4, rotation, MIRROR_NONE, 1, 3, 1, TemplateKind.Igloo))
        }
    }
    out.push(try template_piece(mut w, zip, "minecraft:iglu", String("minecraft:igloo/top"), x, 90, z, rotation, MIRROR_NONE, 3, 5, 5, TemplateKind.Igloo))
    return out
}

fn beached_wrecks() -> List<str> {
    return [
    "with_mast", "sideways_full", "sideways_fronthalf", "sideways_backhalf", "rightsideup_full", "rightsideup_fronthalf", "rightsideup_backhalf",
    "with_mast_degraded", "rightsideup_full_degraded", "rightsideup_fronthalf_degraded", "rightsideup_backhalf_degraded",
]
}
fn ocean_wrecks() -> List<str> {
    return [
    "with_mast", "upsidedown_full", "upsidedown_fronthalf", "upsidedown_backhalf", "sideways_full", "sideways_fronthalf", "sideways_backhalf",
    "rightsideup_full", "rightsideup_fronthalf", "rightsideup_backhalf", "with_mast_degraded", "upsidedown_full_degraded",
    "upsidedown_fronthalf_degraded", "upsidedown_backhalf_degraded", "sideways_full_degraded", "sideways_fronthalf_degraded",
    "sideways_backhalf_degraded", "rightsideup_full_degraded", "rightsideup_fronthalf_degraded", "rightsideup_backhalf_degraded",
]
}

/// `ShipwreckStructure`: a wreck, and its height worked out now if it's too big to work out
/// when it's placed.
pub fn shipwreck(w: mut StructureWorld, zip: Zip, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>, beached: bool) -> List<Piece> ! Thrown {
    if not try center_start(mut w, cx, cz, if beached { WORLD_SURFACE_WG } else { OCEAN_FLOOR_WG }, allowed) {
        return List<Piece>()
    }
    let rotation = random.next_int_below(4)
    let names = if beached { beached_wrecks() } else { ocean_wrecks() }
    let name = names[usize.wrap(random.next_int_below(i32.wrap(names.len())))]
    var piece = try template_piece(mut w, zip, "minecraft:shipwreck", "minecraft:shipwreck/{name}", cx << 4, 90, cz << 4, rotation, MIRROR_NONE, 4, 0, 15, TemplateKind.Shipwreck { beached: beached, adjusted: false })
    let index = try w.template(zip, "minecraft:shipwreck/{name}")
    let size_x = w.templates.list[index].size_x
    let size_y = w.templates.list[index].size_y
    if size_x > 32 or size_y > 32 {
        let bb = piece.bb
        let x_span = bb.max_x - bb.min_x + 1
        let z_span = bb.max_z - bb.min_z + 1
        var height = 0
        if beached {
            // Vanilla passes the box's `x` span where `getLowestY` takes its `minZ`.
            let min_y = try w.lowest_y(bb.min_x, x_span, bb.min_z, z_span)
            height = min_y - size_y / 2 - random.next_int_below(3)
        } else {
            height = try w.mean_height(bb.min_x, x_span, bb.min_z, z_span)
        }
        // `adjustPositionHeight`: the template moves, and its box stays.
        let moved = match piece.data {
            PieceData.Template(t) => {
                var d = t.copy()
                d.y = height
                d.kind = TemplateKind.Shipwreck { beached: beached, adjusted: true }
                some(d)
            },
            _ => none,
        }
        if let d = moved {
            piece.data = PieceData.Template(d)
        }
    }
    return [piece]
}

fn warm_ruins() -> List<str> {
    return ["warm_1", "warm_2", "warm_3", "warm_4", "warm_5", "warm_6", "warm_7", "warm_8"]
}
fn big_warm_ruins() -> List<str> {
    return ["big_warm_4", "big_warm_5", "big_warm_6", "big_warm_7"]
}
fn ruins() -> List<str> {
    return ["1", "2", "3", "4", "5", "6", "7", "8"]
}
fn big_ruins() -> List<str> {
    return ["1", "2", "3", "8"]
}

/// `OceanRuinStructure`: a ruin, and around a large one sometimes a cluster of small ones.
pub fn ocean_ruin(w: mut StructureWorld, zip: Zip, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>, cold: bool, large_probability: f32, cluster_probability: f32) -> List<Piece> ! Thrown {
    if not try center_start(mut w, cx, cz, OCEAN_FLOOR_WG, allowed) {
        return List<Piece>()
    }
    let x = cx << 4
    let z = cz << 4
    let rotation = random.next_int_below(4)
    var out = List<Piece>()
    let large = random.next_float() <= large_probability
    try ruin(mut w, zip, mut out, mut random, x, 90, z, rotation, cold, large, if large { 0.9f32 } else { 0.8f32 })
    if large and random.next_float() <= cluster_probability {
        // `addClusterRuins`.
        let (ex, _, ez) = transform(15, 0, 15, MIRROR_NONE, rotation, 0, 0)
        let parent = Bounds.of_corners(x, 90, z, x + ex, 90, z + ez)
        let ox = x.min(x + ex)
        let oz = z.min(z + ez)
        var positions = List<(i32, i32)>()
        positions.push(try offset_pair(mut random, ox - 16, 1, 8, oz + 16, 1, 7))
        positions.push(try offset_pair(mut random, ox - 16, 1, 8, oz, 1, 7))
        positions.push(try offset_pair(mut random, ox - 16, 1, 8, oz - 16, 4, 8))
        positions.push(try offset_pair(mut random, ox, 1, 7, oz + 16, 1, 7))
        positions.push(try offset_pair(mut random, ox, 1, 7, oz - 16, 4, 6))
        positions.push(try offset_pair(mut random, ox + 16, 1, 7, oz + 16, 3, 8))
        positions.push(try offset_pair(mut random, ox + 16, 1, 7, oz, 1, 7))
        positions.push(try offset_pair(mut random, ox + 16, 1, 7, oz - 16, 4, 8))
        let count = try next_in(mut random, 4, 8)
        for _ in 0..count {
            if positions.is_empty() {
                continue
            }
            let idx = usize.wrap(random.next_int_below(i32.wrap(positions.len())))
            let (px, pz) = positions.remove(idx)
            let next = random.next_int_below(4)
            let (nx, _, nz) = transform(5, 0, 6, MIRROR_NONE, next, 0, 0)
            let b = Bounds.of_corners(px, 90, pz, px + nx, 90, pz + nz)
            if not intersects(b, parent) {
                try ruin(mut w, zip, mut out, mut random, px, 90, pz, next, cold, false, 0.8f32)
            }
        }
    }
    return out
}

// A position offset by `Mth.nextInt` in `x`, then `z`.
fn offset_pair(random: mut WorldgenRandom<LegacyRandom>, x: i32, x_min: i32, x_max: i32, z: i32, z_min: i32, z_max: i32) -> (i32, i32) ! Thrown {
    let dx = try next_in(mut random, x_min, x_max)
    let dz = try next_in(mut random, z_min, z_max)
    return (x + dx, z + dz)
}

// `OceanRuinPieces.addPiece`: a warm ruin, or a cold one as its bricks, cracks and moss.
fn ruin(w: mut StructureWorld, zip: Zip, out: mut List<Piece>, random: mut WorldgenRandom<LegacyRandom>, x: i32, y: i32, z: i32, rotation: i32, cold: bool, large: bool, integrity: f32) ! Thrown {
    if not cold {
        let names = if large { big_warm_ruins() } else { warm_ruins() }
        let name = names[usize.wrap(random.next_int_below(i32.wrap(names.len())))]
        out.push(try template_piece(mut w, zip, "minecraft:orp", "minecraft:underwater_ruin/{name}", x, y, z, rotation, MIRROR_NONE, 0, 0, 0, TemplateKind.OceanRuin { integrity: integrity, cold: false, large: large }))
        return
    }
    let numbers = if large { big_ruins() } else { ruins() }
    let n = numbers[usize.wrap(random.next_int_below(i32.wrap(numbers.len())))]
    let prefix = if large { "big_" } else { "" }
    out.push(try template_piece(mut w, zip, "minecraft:orp", "minecraft:underwater_ruin/{prefix}brick_{n}", x, y, z, rotation, MIRROR_NONE, 0, 0, 0, TemplateKind.OceanRuin { integrity: integrity, cold: true, large: large }))
    out.push(try template_piece(mut w, zip, "minecraft:orp", "minecraft:underwater_ruin/{prefix}cracked_{n}", x, y, z, rotation, MIRROR_NONE, 0, 0, 0, TemplateKind.OceanRuin { integrity: 0.7f32, cold: true, large: large }))
    out.push(try template_piece(mut w, zip, "minecraft:orp", "minecraft:underwater_ruin/{prefix}mossy_{n}", x, y, z, rotation, MIRROR_NONE, 0, 0, 0, TemplateKind.OceanRuin { integrity: 0.5f32, cold: true, large: large }))
}

/// `BoundingBox.intersects`.
pub fn intersects(a: Bounds, b: Bounds) -> bool {
    return a.max_x >= b.min_x and a.min_x <= b.max_x and a.max_z >= b.min_z and a.min_z <= b.max_z and a.max_y >= b.min_y and a.min_y <= b.max_y
}

/// `NetherFossilStructure`: a fossil on the first floor below a height, above the sea.
pub fn nether_fossil(w: mut StructureWorld, zip: Zip, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>, height: HeightProvider) -> List<Piece> ! Thrown {
    let x = (cx << 4) + random.next_int_below(16)
    let z = (cz << 4) + random.next_int_below(16)
    let sea = w.sea_level()
    var y = try height.sample(mut random, w.gen_context())
    let column = try w.column(x, z)
    while y > sea {
        let current = column_block(column, y)
        y -= 1
        let below = column_block(column, y)
        if w.facts.is_air(current) and (w.facts.block(below) == w.facts.ids.soul_sand or w.facts.sturdy(below, UP, FULL)) {
            break
        }
    }
    if y <= sea {
        return List<Piece>()
    }
    if not try w.valid_biome(x, y, z, allowed) {
        return List<Piece>()
    }
    let rotation = random.next_int_below(4)
    let n = random.next_int_below(14) + 1
    return [try template_piece(mut w, zip, "minecraft:nefos", "minecraft:nether_fossils/fossil_{n}", x, y, z, rotation, MIRROR_NONE, 0, 0, 0, TemplateKind.NetherFossil)]
}

/// `RuinedPortalStructure`: a portal of a setup picked by weight, at a height its placement
/// picks, lowered to where three of its corners stand on something.
pub fn ruined_portal(w: mut StructureWorld, zip: Zip, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>, setups: List<PortalSetup>) -> List<Piece> ! Thrown {
    var chosen = 0usize
    if setups.len() > 1 {
        var total = 0.0f32
        for s in setups {
            total += s.weight
        }
        var pick = random.next_float()
        var found = false
        for i in 0..setups.len() {
            pick -= setups[i].weight / total
            if pick < 0.0f32 {
                chosen = i
                found = true
                break
            }
        }
        if not found {
            fail Thrown { exception: "IllegalStateException", message: String() }
        }
    }
    let setup = setups[chosen]
    let air_pocket = if setup.air_pocket == 0.0f32 { false } else if setup.air_pocket == 1.0f32 { true } else { random.next_float() < setup.air_pocket }
    var name = String()
    if random.next_float() < 0.05f32 {
        name = "minecraft:ruined_portal/giant_portal_{random.next_int_below(3) + 1}"
    } else {
        name = "minecraft:ruined_portal/portal_{random.next_int_below(10) + 1}"
    }
    let t = try w.template(zip, name.copy())
    let rotation = random.next_int_below(4)
    let mirror = if random.next_float() < 0.5f32 { MIRROR_NONE } else { FRONT_BACK }
    let px = w.templates.list[t].size_x / 2
    let pz = w.templates.list[t].size_z / 2
    let bx = cx << 4
    let bz = cz << 4
    let s = Settings { mirror: mirror, rotation: rotation, pivot_x: px, pivot_z: pz }
    let bb = w.templates.list[t].bounding_box(s, bx, 0, bz)
    let center_x = bb.min_x + (bb.max_x - bb.min_x + 1) / 2
    let center_z = bb.min_z + (bb.max_z - bb.min_z + 1) / 2
    let kind = if setup.placement == ON_OCEAN_FLOOR { OCEAN_FLOOR_WG } else { WORLD_SURFACE_WG }
    let surface = try w.base_height(center_x, center_z, kind) - 1
    let y = try suitable_y(mut w, mut random, setup.placement, air_pocket, surface, bb.max_y - bb.min_y + 1, bb)
    if not try w.valid_biome(bx, y, bz, allowed) {
        return List<Piece>()
    }
    var cold = false
    if setup.can_be_cold {
        let biome = try w.noise_biome(bx >> 2, y >> 2, bz >> 2)
        cold = not w.temps.warm_enough_to_rain(biome, bx, y, bz, w.sea_level())
    }
    let props = PortalProperties { cold: cold, mossiness: setup.mossiness, air_pocket: air_pocket, overgrown: setup.overgrown, vines: setup.vines, blackstone: setup.blackstone }
    return [try template_piece(mut w, zip, "minecraft:rupo", name, bx, y, bz, rotation, mirror, px, 0, pz, TemplateKind.RuinedPortal { placement: setup.placement, props: props })]
}

// `findSuitableY`.
fn suitable_y(w: mut StructureWorld, random: mut WorldgenRandom<LegacyRandom>, placement: i32, air_pocket: bool, surface: i32, span: i32, bb: Bounds) -> i32 ! Thrown {
    let min_y = w.level_min + 15
    var y = surface
    if placement == IN_NETHER {
        if air_pocket {
            y = try between_inclusive(mut random, 32, 100)
        } else if random.next_float() < 0.5f32 {
            y = try between_inclusive(mut random, 27, 29)
        } else {
            y = try between_inclusive(mut random, 29, 100)
        }
    } else if placement == IN_MOUNTAIN {
        y = try within(mut random, 70, surface - span)
    } else if placement == UNDERGROUND {
        y = try within(mut random, min_y, surface - span)
    } else if placement == PARTLY_BURIED {
        y = surface - span + try between_inclusive(mut random, 2, 8)
    }
    var columns = List<Column?>()
    columns.push(try w.column(bb.min_x, bb.min_z))
    columns.push(try w.column(bb.max_x, bb.min_z))
    columns.push(try w.column(bb.min_x, bb.max_z))
    columns.push(try w.column(bb.max_x, bb.max_z))
    let kind = if placement == ON_OCEAN_FLOOR { OCEAN_FLOOR_WG } else { WORLD_SURFACE_WG }
    while y > min_y {
        var solid = 0
        for c in columns {
            if w.facts.table.counts_in(kind, column_block(c, y)) {
                solid += 1
                if solid == 3 {
                    return y
                }
            }
        }
        y -= 1
    }
    return y
}

// `getRandomWithinInterval`.
fn within(random: mut WorldgenRandom<LegacyRandom>, min: i32, max: i32) -> i32 ! Thrown {
    if min < max {
        return try between_inclusive(mut random, min, max)
    }
    return max
}
