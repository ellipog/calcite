/// Nether fortresses: a bridge crossing, then bridges and castle corridors picked by weight and
/// placed where they fit, a pending piece at a time at random, as `NetherFortressStructure` and
/// `NetherFortressPieces` lay them out.
module worldgen.fortress

import random.legacy.{LegacyRandom}
import random.worldgen.{WorldgenRandom}
import worldgen.facts.{EAST, NORTH, SOUTH, WEST}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Field, Piece, PieceData, bool_field, collides, int_field, make_box, move_pieces, orient_box, pieces_box, random_horizontal}
import worldgen.structure_world.{StructureWorld}
import worldgen.template.{Bounds}

// The kinds of piece, in the order of the weight tables.
const BRIDGE_STRAIGHT: i32 = 0
const BRIDGE_CROSSING: i32 = 1
const ROOM_CROSSING: i32 = 2
const STAIRS_ROOM: i32 = 3
const MONSTER_THRONE: i32 = 4
const CASTLE_ENTRANCE: i32 = 5
const SMALL_CORRIDOR: i32 = 6
const SMALL_CORRIDOR_CROSSING: i32 = 7
const RIGHT_TURN: i32 = 8
const LEFT_TURN: i32 = 9
const CORRIDOR_STAIRS: i32 = 10
const T_BALCONY: i32 = 11
const STALK_ROOM: i32 = 12
const END_FILLER: i32 = 13

// A `PieceWeight`.
struct Weight {
    kind: i32
    weight: i32
    max: i32
    in_row: bool
    count: i32
}

// The layout: the pieces, their kinds, and the weights left.
struct Layout {
    pieces: List<Piece>
    kinds: List<i32>
    bridge: List<Weight>
    castle: List<Weight>
    previous: i32
    pending: List<usize>
}

/// `NetherFortressStructure`: none if the biome where it starts isn't allowed.
pub fn fortress(w: mut StructureWorld, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>) -> List<Piece> ! Thrown {
    if not try w.valid_biome(cx << 4, 64, cz << 4, allowed) {
        return List<Piece>()
    }
    let d = random_horizontal(mut random)
    let bridge: List<Weight> = [
        Weight { kind: BRIDGE_STRAIGHT, weight: 30, max: 0, in_row: true, count: 0 },
        Weight { kind: BRIDGE_CROSSING, weight: 10, max: 4, in_row: false, count: 0 },
        Weight { kind: ROOM_CROSSING, weight: 10, max: 4, in_row: false, count: 0 },
        Weight { kind: STAIRS_ROOM, weight: 10, max: 3, in_row: false, count: 0 },
        Weight { kind: MONSTER_THRONE, weight: 5, max: 2, in_row: false, count: 0 },
        Weight { kind: CASTLE_ENTRANCE, weight: 5, max: 1, in_row: false, count: 0 },
    ]
    let castle: List<Weight> = [
        Weight { kind: SMALL_CORRIDOR, weight: 25, max: 0, in_row: true, count: 0 },
        Weight { kind: SMALL_CORRIDOR_CROSSING, weight: 15, max: 5, in_row: false, count: 0 },
        Weight { kind: RIGHT_TURN, weight: 5, max: 10, in_row: false, count: 0 },
        Weight { kind: LEFT_TURN, weight: 5, max: 10, in_row: false, count: 0 },
        Weight { kind: CORRIDOR_STAIRS, weight: 10, max: 3, in_row: true, count: 0 },
        Weight { kind: T_BALCONY, weight: 7, max: 2, in_row: false, count: 0 },
        Weight { kind: STALK_ROOM, weight: 5, max: 2, in_row: false, count: 0 },
    ]
    // The start is a bridge crossing, saved as one.
    let start = Piece { kind: String("minecraft:nebcr"), bb: make_box((cx << 4) + 2, 64, (cz << 4) + 2, d, 19, 10, 19), orientation: d, gen_depth: 0, data: PieceData.Fields(List<Field>()) }
    var l = Layout { pieces: [start], kinds: [BRIDGE_CROSSING], bridge: bridge, castle: castle, previous: -1, pending: List<usize>() }
    add_children(mut l, 0, mut random)
    while not l.pending.is_empty() {
        let at = usize.wrap(random.next_int_below(i32.wrap(l.pending.len())))
        let i = l.pending.remove(at)
        add_children(mut l, i, mut random)
    }
    // `moveInsideHeights(random, 48, 70)`.
    let b = pieces_box(l.pieces)
    let span = 70 - 48 + 1 - (b.max_y - b.min_y + 1)
    let y0 = if span > 1 { 48 + random.next_int_below(span) } else { 48 }
    move_pieces(mut l.pieces, y0 - b.min_y)
    return l.pieces
}

// Each kind's ID and box: its offset from the foot and its size.
fn kind_id(kind: i32) -> str {
    return match kind {
        0 => "minecraft:nebs",
        1 => "minecraft:nebcr",
        2 => "minecraft:nerc",
        3 => "minecraft:nesr",
        4 => "minecraft:nemt",
        5 => "minecraft:nece",
        6 => "minecraft:nesc",
        7 => "minecraft:nescsc",
        8 => "minecraft:nescrt",
        9 => "minecraft:nesclt",
        10 => "minecraft:neccs",
        11 => "minecraft:nectb",
        12 => "minecraft:necsr",
        _ => "minecraft:nebef",
    }
}

fn kind_box(kind: i32, fx: i32, fy: i32, fz: i32, d: i32) -> Bounds {
    return match kind {
        0 => orient_box(fx, fy, fz, -1, -3, 0, 5, 10, 19, d),
        1 => orient_box(fx, fy, fz, -8, -3, 0, 19, 10, 19, d),
        2 => orient_box(fx, fy, fz, -2, 0, 0, 7, 9, 7, d),
        3 => orient_box(fx, fy, fz, -2, 0, 0, 7, 11, 7, d),
        4 => orient_box(fx, fy, fz, -2, 0, 0, 7, 8, 9, d),
        5 => orient_box(fx, fy, fz, -5, -3, 0, 13, 14, 13, d),
        10 => orient_box(fx, fy, fz, -1, -7, 0, 5, 14, 10, d),
        11 => orient_box(fx, fy, fz, -3, 0, 0, 9, 7, 9, d),
        12 => orient_box(fx, fy, fz, -5, -3, 0, 13, 14, 13, d),
        13 => orient_box(fx, fy, fz, -1, -3, 0, 5, 10, 8, d),
        _ => orient_box(fx, fy, fz, -1, 0, 0, 5, 7, 5, d),
    }
}

// A kind's `createPiece`: none where its box is too low or meets another piece.
fn create(l: Layout, kind: i32, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32) -> Piece? {
    let b = kind_box(kind, fx, fy, fz, d)
    if b.min_y <= 10 or collides(l.pieces, b) {
        return none
    }
    var fields = List<Field>()
    if kind == END_FILLER {
        fields.push(int_field("Seed", random.next_int()))
    } else if kind == RIGHT_TURN or kind == LEFT_TURN {
        fields.push(bool_field("Chest", random.next_int_below(3) == 0))
    } else if kind == MONSTER_THRONE {
        fields.push(bool_field("Mob", false))
    }
    return some(Piece { kind: String(kind_id(kind)), bb: b, orientation: d, gen_depth: depth, data: PieceData.Fields(fields) })
}

// `generatePiece`: a piece picked by weight from the castle's or the bridge's, tried up to five
// times, each failed pick falling through to the kinds after it, or an end filler.
fn generate_piece(l: mut Layout, castle: bool, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32) -> (Piece, i32)? {
    let n = if castle { l.castle.len() } else { l.bridge.len() }
    var any = false
    var total = 0
    for k in 0..n {
        let wt = if castle { l.castle[k] } else { l.bridge[k] }
        if wt.max > 0 and wt.count < wt.max {
            any = true
        }
        total += wt.weight
    }
    if not any {
        total = -1
    }
    let try_it = total > 0 and depth <= 30
    var attempts = 0
    while attempts < 5 and try_it {
        attempts += 1
        var selection = random.next_int_below(total)
        for k in 0..n {
            let wt = if castle { l.castle[k] } else { l.bridge[k] }
            selection -= wt.weight
            if selection < 0 {
                let can = wt.max == 0 or wt.count < wt.max
                if not can or (wt.kind == l.previous and not wt.in_row) {
                    break
                }
                if let p = create(l, wt.kind, mut random, fx, fy, fz, d, depth) {
                    l.previous = wt.kind
                    if castle {
                        l.castle[k].count += 1
                        if not (l.castle[k].max == 0 or l.castle[k].count < l.castle[k].max) {
                            _ = l.castle.remove(k)
                        }
                    } else {
                        l.bridge[k].count += 1
                        if not (l.bridge[k].max == 0 or l.bridge[k].count < l.bridge[k].max) {
                            _ = l.bridge.remove(k)
                        }
                    }
                    return some((p, wt.kind))
                }
            }
        }
    }
    if let p = create(l, END_FILLER, mut random, fx, fy, fz, d, depth) {
        return some((p, END_FILLER))
    }
    return none
}

// `generateAndAddPiece`: a piece at the foot within 112 blocks of the start, added and left to
// have its children; farther out an end filler that's made and dropped.
fn add_piece(l: mut Layout, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32, castle: bool) {
    let start = l.pieces[0].bb
    if (fx - start.min_x).abs() <= 112 and (fz - start.min_z).abs() <= 112 {
        if let (p, kind) = generate_piece(mut l, castle, mut random, fx, fy, fz, d, depth + 1) {
            l.pieces.push(p)
            l.kinds.push(kind)
            l.pending.push(l.pieces.len() - 1)
        }
        return
    }
    _ = create(l, END_FILLER, mut random, fx, fy, fz, d, depth)
}

// `generateChildForward`.
fn forward(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>, x_off: i32, y_off: i32, castle: bool) {
    let b = l.pieces[i].bb
    let d = l.pieces[i].orientation
    let depth = l.pieces[i].gen_depth
    if d == NORTH {
        add_piece(mut l, mut random, b.min_x + x_off, b.min_y + y_off, b.min_z - 1, d, depth, castle)
    } else if d == SOUTH {
        add_piece(mut l, mut random, b.min_x + x_off, b.min_y + y_off, b.max_z + 1, d, depth, castle)
    } else if d == WEST {
        add_piece(mut l, mut random, b.min_x - 1, b.min_y + y_off, b.min_z + x_off, d, depth, castle)
    } else if d == EAST {
        add_piece(mut l, mut random, b.max_x + 1, b.min_y + y_off, b.min_z + x_off, d, depth, castle)
    }
}

// `generateChildLeft`.
fn left(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>, y_off: i32, z_off: i32, castle: bool) {
    let b = l.pieces[i].bb
    let d = l.pieces[i].orientation
    let depth = l.pieces[i].gen_depth
    if d == NORTH or d == SOUTH {
        add_piece(mut l, mut random, b.min_x - 1, b.min_y + y_off, b.min_z + z_off, WEST, depth, castle)
    } else if d == WEST or d == EAST {
        add_piece(mut l, mut random, b.min_x + z_off, b.min_y + y_off, b.min_z - 1, NORTH, depth, castle)
    }
}

// `generateChildRight`.
fn right(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>, y_off: i32, z_off: i32, castle: bool) {
    let b = l.pieces[i].bb
    let d = l.pieces[i].orientation
    let depth = l.pieces[i].gen_depth
    if d == NORTH or d == SOUTH {
        add_piece(mut l, mut random, b.max_x + 1, b.min_y + y_off, b.min_z + z_off, EAST, depth, castle)
    } else if d == WEST or d == EAST {
        add_piece(mut l, mut random, b.min_x + z_off, b.min_y + y_off, b.max_z + 1, SOUTH, depth, castle)
    }
}

// `addChildren` of the piece, by its kind.
fn add_children(l: mut Layout, i: usize, random: mut WorldgenRandom<LegacyRandom>) {
    let kind = l.kinds[i]
    if kind == BRIDGE_CROSSING {
        forward(mut l, i, mut random, 8, 3, false)
        left(mut l, i, mut random, 3, 8, false)
        right(mut l, i, mut random, 3, 8, false)
    } else if kind == BRIDGE_STRAIGHT {
        forward(mut l, i, mut random, 1, 3, false)
    } else if kind == ROOM_CROSSING {
        forward(mut l, i, mut random, 2, 0, false)
        left(mut l, i, mut random, 0, 2, false)
        right(mut l, i, mut random, 0, 2, false)
    } else if kind == STAIRS_ROOM {
        right(mut l, i, mut random, 6, 2, false)
    } else if kind == CASTLE_ENTRANCE {
        forward(mut l, i, mut random, 5, 3, true)
    } else if kind == SMALL_CORRIDOR or kind == CORRIDOR_STAIRS {
        forward(mut l, i, mut random, 1, 0, true)
    } else if kind == SMALL_CORRIDOR_CROSSING {
        forward(mut l, i, mut random, 1, 0, true)
        left(mut l, i, mut random, 0, 1, true)
        right(mut l, i, mut random, 0, 1, true)
    } else if kind == RIGHT_TURN {
        right(mut l, i, mut random, 0, 1, true)
    } else if kind == LEFT_TURN {
        left(mut l, i, mut random, 0, 1, true)
    } else if kind == T_BALCONY {
        let d = l.pieces[i].orientation
        let z_off = if d == WEST or d == NORTH { 5 } else { 1 }
        let left_castle = random.next_int_below(8) > 0
        left(mut l, i, mut random, 0, z_off, left_castle)
        let right_castle = random.next_int_below(8) > 0
        right(mut l, i, mut random, 0, z_off, right_castle)
    } else if kind == STALK_ROOM {
        forward(mut l, i, mut random, 5, 3, true)
        forward(mut l, i, mut random, 5, 11, true)
    }
}
