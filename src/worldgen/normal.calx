/// Vanilla 26.3's `NormalNoise`: the parameters of a noise in `worldgen/noise`, the octaves and
/// the normalization they give, and the stacks of Perlin noises made from them, both the usual
/// way and the legacy way the Nether's old biome noises were.
module worldgen.normal

import json.tree.{Json, Member, as_i32, get}
import random.any.{AnyRandom}
import random.source.{RandomSource}
import worldgen.interval.{Interval, Thrown}
import worldgen.noise.{Lattice, Layer, Stack, pow2}

/// `NormalNoise.INPUT_FACTOR`: the second noise of each octave is sampled at the input times this.
const INPUT_FACTOR: f64 = 1.0181268882175227
const TARGET_DEVIATION: f64 = 0.3333333333333333
/// One octave's estimated standard deviation, for an amplitude of 1.
const LAYER_DEVIATION: f64 = 0.2702247831245211
/// `Math.sqrt(2.0)`, which is correctly rounded.
const SQRT_2: f64 = 1.4142135623730951

/// `NormalNoise.Normalization`: whether the octaves' amplitudes are scaled so they sum to the
/// base amplitude, and whether the result is normalized as before 1.18.
pub enum Normalization {
    Disabled
    Enabled
    Legacy
}

/// `NormalNoise.Parameters`, as the codec reads them, so already checked: the base amplitude
/// from 1e-5 to 1e6, the base octave from -32 to 32, from 1 to 32 octaves, and the modifiers
/// either none or one per octave, each from 0 to 1e6.
pub struct Parameters {
    pub base_amplitude: f64
    pub base_octave: i32
    pub octave_count: i32
    pub normalize: Normalization
    pub modifiers: List<f64>
}

/// `NormalNoise.OctaveInfo`: an octave whose modifier isn't zero.
struct Octave {
    index: i32
    frequency: f64
    amplitude: f64
}

/// A `NormalNoise`: its parameters and what vanilla works out from them as it makes one.
pub struct NormalNoise {
    pub parameters: Parameters
    octaves: List<Octave>
    factor: f64
    /// `NormalNoise.range()`, wider than the range of the stacks it makes.
    pub range: Interval
}

impl NormalNoise {
    pub fn new(parameters: own Parameters) -> NormalNoise {
        let p = parameters
        let octaves = build_octaves(p.base_octave, p.base_amplitude, p.octave_count, not is_disabled(p.normalize), p.modifiers)
        var target = abs_sum(octaves)
        var factor = normalization_factor(target, octaves)
        if is_legacy(p.normalize) and factor != 0.0 {
            let old = parity_factor(p.base_amplitude, p.octave_count, p.modifiers)
            target *= old / factor
            factor = old
        }
        let range = Interval.symmetric(f32.nearest(target * TARGET_DEVIATION * 6.0))!
        return NormalNoise { parameters: p, octaves: octaves, factor: factor, range: range }
    }

    /// `NormalNoise.create`: two Perlin noises per octave, each from a factory forked from
    /// `random`, seeded by the octave's name.
    pub fn create(self, random: mut AnyRandom) -> Stack {
        let first = random.fork_positional()
        let second = random.fork_positional()
        var layers = List<Layer>()
        for octave in self.octaves {
            let seed = "octave_{octave.index}"
            var a = first.from_hash_of(seed)
            var b = second.from_hash_of(seed)
            let amplitude = f32.nearest(self.factor * octave.amplitude)
            layers.push(Layer { lattice: Lattice.new(mut a, 256.0), frequency: octave.frequency, amplitude: amplitude })
            layers.push(Layer { lattice: Lattice.new(mut b, 256.0), frequency: octave.frequency * INPUT_FACTOR, amplitude: amplitude })
        }
        return Stack.new(layers, false)
    }

    /// `NormalNoise.createForLegacyNetherBiome`: two stacks made one after the other from
    /// `random` itself, as before 1.18, with the modifiers as the amplitudes.
    pub fn legacy_nether<T: RandomSource>(self, random: mut T) -> Stack ! Thrown {
        var amplitudes = List<f64>()
        if self.parameters.modifiers.is_empty() {
            for _ in 0..self.parameters.octave_count {
                amplitudes.push(1.0)
            }
        } else {
            for m in self.parameters.modifiers {
                amplitudes.push(m)
            }
        }
        let first = try legacy_fbm(mut random, self.parameters.base_octave, amplitudes)
        let second = try legacy_fbm(mut random, self.parameters.base_octave, amplitudes)
        let amplitude = f32.nearest(self.factor * self.parameters.base_amplitude)
        var layers = List<Layer>()
        for layer in first {
            layers.push(Layer { lattice: layer.lattice, frequency: layer.frequency * 1.0, amplitude: layer.amplitude * amplitude })
        }
        for layer in second {
            layers.push(Layer { lattice: layer.lattice, frequency: layer.frequency * INPUT_FACTOR, amplitude: layer.amplitude * amplitude })
        }
        return Stack.new(layers, false)
    }
}

/// `NormalNoise.createParity`: a noise scaled to be normalized as before 1.18, with as many
/// octaves as amplitudes, and the amplitudes as modifiers unless they're all 1.
pub fn parity(first_octave: i32, amplitudes: List<f64>) -> NormalNoise {
    let count = i32.wrap(amplitudes.len())
    let octaves = build_octaves(first_octave, 1.0, count, true, amplitudes)
    let factor = normalization_factor(abs_sum(octaves), octaves)
    var base = 1.0
    if factor != 0.0 {
        base = parity_factor(1.0, count, amplitudes) / factor
    }
    var modifiers = List<f64>()
    var any = false
    for a in amplitudes {
        if a != 1.0 {
            any = true
        }
    }
    if any {
        for a in amplitudes {
            modifiers.push(a)
        }
    }
    return NormalNoise.new(Parameters { base_amplitude: base, base_octave: first_octave, octave_count: count, normalize: Normalization.Enabled, modifiers: modifiers })
}

/// `NormalNoise.Parameters.CODEC`, reading JSON as `JsonOps` gives it, with the codec's checks.
pub fn read_parameters(value: Json, error: mut String) -> Parameters? {
    match value {
        Json.Object(members) => return parameters_of(members, mut error),
        _ => {},
    }
    error = "Not a JSON object: {value}"
    return none
}

fn parameters_of(members: List<Member>, error: mut String) -> Parameters? {
    var base_amplitude = 1.0
    if let v = get(members, "base_amplitude") {
        let a = number(v, mut error) else return none
        if not (a >= f64(0.00001f32) and a <= 1000000.0) {
            error = "Value {a} outside of range [9.999999747378752E-6:1000000.0]"
            return none
        }
        base_amplitude = a
    }
    let octave_value = get(members, "base_octave") else {
        error = "No key base_octave in MapLike"
        return none
    }
    let base_octave = int(octave_value, -32, 32, mut error) else return none
    var octave_count: i32 = 1
    if let v = get(members, "octave_count") {
        let c = int(v, 1, 32, mut error) else return none
        octave_count = c
    }
    var normalize = Normalization.Enabled
    if let v = get(members, "normalize") {
        normalize = match v {
            Json.Bool(true) => Normalization.Enabled,
            Json.Bool(false) => Normalization.Disabled,
            Json.Str(s) => {
                if s != "legacy" {
                    error = "Invalid normalization type: {s}"
                    return none
                }
                Normalization.Legacy
            },
            _ => {
                error = "`normalize` must be a boolean or \"legacy\""
                return none
            },
        }
    }
    var modifiers = List<f64>()
    if let v = get(members, "amplitude_modifiers") {
        let items = match v {
            Json.Array(items) => items,
            _ => {
                error = "Not a list"
                return none
            },
        }
        if items.len() > 32 {
            error = "List too long: {items.len()} > 32"
            return none
        }
        for item in items {
            let m = number(item, mut error) else return none
            if not (m >= 0.0 and m <= 1000000.0) {
                error = "Value {m} outside of range [0.0:1000000.0]"
                return none
            }
            modifiers.push(m)
        }
    }
    if not modifiers.is_empty() and i64.wrap(modifiers.len()) != i64(octave_count) {
        error = "amplitude_modifiers had size {modifiers.len()}, but octave_count was {octave_count}"
        return none
    }
    return some(Parameters {
        base_amplitude: base_amplitude,
        base_octave: base_octave,
        octave_count: octave_count,
        normalize: normalize,
        modifiers: modifiers,
    })
}

fn number(value: Json, error: mut String) -> f64? {
    match value {
        Json.Number(text) => {
            if let v = f64.parse(text) {
                return some(v)
            }
        },
        _ => {},
    }
    error = "Not a number: {value}"
    return none
}

fn int(value: Json, min: i32, max: i32, error: mut String) -> i32? {
    let v = as_i32(value) else {
        error = "Not a 32-bit integer: {value}"
        return none
    }
    if v < min or v > max {
        error = "Value {v} outside of range [{min}:{max}]"
        return none
    }
    return some(v)
}

fn is_disabled(n: Normalization) -> bool {
    return match n {
        Normalization.Disabled => true,
        _ => false,
    }
}

fn is_legacy(n: Normalization) -> bool {
    return match n {
        Normalization.Legacy => true,
        _ => false,
    }
}

fn modifier(modifiers: List<f64>, i: i32) -> f64 {
    if modifiers.is_empty() {
        return 1.0
    }
    return modifiers[usize.wrap(i)]
}

/// `NormalNoise.buildOctaves`: from the base octave up, each at twice the frequency and half the
/// amplitude of the one before, those whose modifier is zero left out.
fn build_octaves(base_octave: i32, base_amplitude: f64, count: i32, normalize: bool, modifiers: List<f64>) -> List<Octave> {
    var frequency = pow2(base_octave)
    var amplitude = base_amplitude
    if normalize {
        amplitude *= pow2(count - 1) / (pow2(count) - 1.0)
    }
    var octaves = List<Octave>()
    for i in 0..count {
        let m = modifier(modifiers, i)
        if m != 0.0 {
            octaves.push(Octave { index: base_octave + i, frequency: frequency, amplitude: amplitude * m })
        }
        frequency *= 2.0
        amplitude *= 0.5
    }
    return octaves
}

/// The octaves' absolute amplitudes summed as `DoubleStream.sum` sums them: with Kahan's
/// compensation, then the simple sum only where the compensated one is NaN and it's infinite.
fn abs_sum(octaves: List<Octave>) -> f64 {
    var sum = 0.0
    var compensation = 0.0
    var simple = 0.0
    for octave in octaves {
        let v = octave.amplitude.abs()
        let tmp = v - compensation
        let next = sum + tmp
        compensation = (next - sum) - tmp
        sum = next
        simple += v
    }
    let total = sum - compensation
    if total.is_nan() and simple.abs() == f64.INFINITY {
        return simple
    }
    return total
}

/// `NormalNoise.computeNormalizationFactor`: what makes the sum of two noises per octave have
/// a third of the octaves' total amplitude as its standard deviation.
fn normalization_factor(target: f64, octaves: List<Octave>) -> f64 {
    var variance = 0.0
    for octave in octaves {
        let deviation = LAYER_DEVIATION * octave.amplitude.abs()
        variance += deviation * deviation
    }
    let deviation = variance.sqrt()
    if deviation == 0.0 {
        return 0.0
    }
    return target * TARGET_DEVIATION / (deviation * SQRT_2)
}

/// `NormalNoise.computeParityNormalizationFactor`: the factor before 1.18, from the span of the
/// octaves whose modifier isn't zero.
fn parity_factor(base_amplitude: f64, count: i32, modifiers: List<f64>) -> f64 {
    var min = i32.MAX
    var max = i32.MIN
    for i in 0..count {
        if modifier(modifiers, i) != 0.0 {
            min = min.min(i)
            max = max.max(i)
        }
    }
    let span = max - min
    return base_amplitude * 0.5 * TARGET_DEVIATION / (0.1 * (1.0 + 1.0 / f64(span + 1)))
}

/// `LegacyFbmInitializer.createForLegacyNetherBiome`: a noise for each nonzero amplitude, the
/// octave at frequency 1 made first and the lower ones after, highest first, a skipped one
/// drawing what it would have. Vanilla throws when an amplitude is above frequency 1.
fn legacy_fbm<T: RandomSource>(random: mut T, first_octave: i32, amplitudes: List<f64>) -> List<Layer> ! Thrown {
    let octaves = i32.wrap(amplitudes.len())
    let zero = -first_octave
    var levels = List<Lattice?>()
    for _ in 0..octaves {
        levels.push(none)
    }
    let zero_octave = Lattice.new(mut random, 256.0)
    if zero >= 0 and zero < octaves and amplitudes[usize.wrap(zero)] != 0.0 {
        levels[usize.wrap(zero)] = some(zero_octave)
    }
    var i = zero - 1
    while i >= 0 {
        if i < octaves and amplitudes[usize.wrap(i)] != 0.0 {
            levels[usize.wrap(i)] = some(Lattice.new(mut random, 256.0))
        } else {
            random.consume(262)
        }
        i -= 1
    }
    var made: usize = 0
    for level in levels {
        if level != none {
            made += 1
        }
    }
    var wanted: usize = 0
    for a in amplitudes {
        if a != 0.0 {
            wanted += 1
        }
    }
    if made != wanted {
        fail Thrown { exception: "IllegalStateException", message: "Failed to create correct number of noise levels for given non-zero amplitudes" }
    }
    if zero < octaves - 1 {
        fail Thrown { exception: "IllegalArgumentException", message: "Positive octaves are temporarily disabled" }
    }
    var factor = pow2(-zero)
    var amplitude = pow2(octaves - 1) / (pow2(octaves) - 1.0)
    var layers = List<Layer>()
    for k in 0..octaves {
        if let lattice = levels[usize.wrap(k)] {
            layers.push(Layer { lattice: lattice, frequency: factor, amplitude: f32.nearest(amplitude * amplitudes[usize.wrap(k)]) })
        }
        factor *= 2.0
        amplitude /= 2.0
    }
    return layers
}
