/// Some of the Overworld's features that stand alone: bamboo with its podzol, ice spikes, and
/// icebergs, read as their codecs read them and placed as 26.3 places them.
module worldgen.overworld

import json.tree.{Member}
import random.source.{RandomSource}
import std.java.math.{cos, sin}
import world.chunk.{WORLD_SURFACE}
import worldgen.codec.{field, float_range_field}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}
import worldgen.predicates.{Pred, Readers, read_pred, read_state, test}
import worldgen.providers.{clamp_float, next_below}
import worldgen.region.{Region}
import worldgen.survive.{Env, can_survive}

/// `Math.PI`.
const PI: f64 = 3.141592653589793

/// A `spike`: an ice spike's state and where it may stand and what it may replace.
pub struct Spike {
    state: u32
    can_place_on: Pred
    can_replace: Pred
}

pub fn read_bamboo(m: List<Member>) -> f32 ! String {
    return try float_range_field(m, "probability", 0.0f32, 1.0f32)
}

pub fn read_spike(f: Facts, rd: Readers, m: List<Member>) -> Spike ! String {
    let sv = field(m, "state") else fail "No key state in MapLike"
    let state = try read_state(f, sv)
    let pv = field(m, "can_place_on") else fail "No key can_place_on in MapLike"
    let can_place_on = try read_pred(f, rd, pv)
    let rv = field(m, "can_replace") else fail "No key can_replace in MapLike"
    return Spike { state: state, can_place_on: can_place_on, can_replace: try read_pred(f, rd, rv) }
}

pub fn read_iceberg(f: Facts, m: List<Member>) -> u32 ! String {
    let sv = field(m, "state") else fail "No key state in MapLike"
    return try read_state(f, sv)
}

// `Mth.ceil` of a float.
fn ceil_f32(v: f32) -> i32 {
    let i = i32.saturate(v)
    return if v > f32.nearest(i) { i + 1 } else { i }
}

// Bamboo.

/// `BambooFeature.place`: perhaps a disc of podzol under it, a stalk up to 16 tall, and leaves
/// at its top.
pub fn place_bamboo<T: RandomSource>(e: Env, r: mut Region, rand: mut T, probability: f32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if not f.is_air(try r.state(f, x, y, z)) {
        return false
    }
    let bamboo = f.default_state(f.ids.bamboo)
    if try can_survive(e, r, bamboo, x, y, z) {
        let height = rand.next_int_below(12) + 5
        if rand.next_float() < probability {
            let radius = rand.next_int_below(4) + 1
            let podzol = f.default_state(f.ids.podzol)
            let replaceable = f.tag("minecraft:beneath_bamboo_podzol_replaceable")
            for xx in x - radius..x + radius + 1 {
                for zz in z - radius..z + radius + 1 {
                    let xd = xx - x
                    let zd = zz - z
                    if xd * xd + zd * zd <= radius * radius {
                        let py = try r.get_height(f, WORLD_SURFACE, xx, zz) - 1
                        if f.in_set(try r.state(f, xx, py, zz), replaceable) {
                            _ = r.set_block(f, xx, py, zz, podzol, 2)
                        }
                    }
                }
            }
        }
        var trunk = try f.with_int(bamboo, "age", 1)
        trunk = try f.with_name(trunk, "leaves", String("none"))
        trunk = try f.with_int(trunk, "stage", 0)
        var py = y
        var i = 0
        while i < height and f.is_air(try r.state(f, x, py, z)) {
            _ = r.set_block(f, x, py, z, trunk, 2)
            py += 1
            i += 1
        }
        if py - y >= 3 {
            let top_large = try f.with_name(trunk, "leaves", String("large"))
            let final_large = try f.with_int(top_large, "stage", 1)
            let top_small = try f.with_name(trunk, "leaves", String("small"))
            _ = r.set_block(f, x, py, z, final_large, 2)
            _ = r.set_block(f, x, py - 1, z, top_large, 2)
            _ = r.set_block(f, x, py - 2, z, top_small, 2)
        }
    }
    return true
}

// Ice spikes.

/// `SpikeFeature.place`: down to the ground, then a spike tapering up, mirrored below while it's
/// wide, and a pillar under it down to 50.
pub fn place_spike<T: RandomSource>(e: Env, r: mut Region, rand: mut T, s: Spike, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    var oy = y
    while f.is_air(try r.state(f, x, oy, z)) and oy > r.min_y + 2 {
        oy -= 1
    }
    if not try test(e, r, s.can_place_on, x, oy, z) {
        return false
    }
    oy += rand.next_int_below(4)
    let height = rand.next_int_below(4) + 7
    let width = height / 4 + rand.next_int_below(2)
    if width > 1 and rand.next_int_below(60) == 0 {
        oy += 10 + rand.next_int_below(30)
    }
    for y_off in 0..height {
        let scale = (1.0f32 - f32.nearest(y_off) / f32.nearest(height)) * f32.nearest(width)
        let new_width = ceil_f32(scale)
        for xo in -new_width..new_width + 1 {
            let dx = f32.nearest(xo.abs()) - 0.25f32
            for zo in -new_width..new_width + 1 {
                let dz = f32.nearest(zo.abs()) - 0.25f32
                let inside = (xo == 0 and zo == 0) or not (dx * dx + dz * dz > scale * scale)
                if inside {
                    let edge = xo == -new_width or xo == new_width or zo == -new_width or zo == new_width
                    if not edge or not (rand.next_float() > 0.75f32) {
                        let here = try r.state(f, x + xo, oy + y_off, z + zo)
                        if f.is_air(here) or try test(e, r, s.can_replace, x + xo, oy + y_off, z + zo) {
                            _ = r.set_block(f, x + xo, oy + y_off, z + zo, s.state, 3)
                        }
                        if y_off != 0 and new_width > 1 {
                            let there = try r.state(f, x + xo, oy - y_off, z + zo)
                            if f.is_air(there) or try test(e, r, s.can_replace, x + xo, oy - y_off, z + zo) {
                                _ = r.set_block(f, x + xo, oy - y_off, z + zo, s.state, 3)
                            }
                        }
                    }
                }
            }
        }
    }
    let pillar = (width - 1).max(0).min(1)
    for xo in -pillar..pillar + 1 {
        for zo in -pillar..pillar + 1 {
            var cy = oy - 1
            var run = 50
            if xo.abs() == 1 and zo.abs() == 1 {
                run = rand.next_int_below(5)
            }
            while cy > 50 {
                let here = try r.state(f, x + xo, cy, z + zo)
                if not f.is_air(here) and not try test(e, r, s.can_replace, x + xo, cy, z + zo) and here != s.state {
                    break
                }
                _ = r.set_block(f, x + xo, cy, z + zo, s.state, 3)
                cy -= 1
                run -= 1
                if run <= 0 {
                    cy -= rand.next_int_below(5) + 1
                    run = rand.next_int_below(5)
                }
            }
        }
    }
    return true
}

// Icebergs.

// The iceberg's shape, drawn once.
struct Berg {
    state: u32
    snow_on_top: bool
    angle: f64
    ellipse_a: i32
    ellipse_c: i32
    ellipse: bool
}

/// `IcebergFeature.place`.
pub fn place_iceberg<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, state: u32, x: i32, z: i32) -> bool ! Thrown {
    let y = r.sea_level
    let snow_on_top = rand.next_double() > 0.7
    let angle = rand.next_double() * 2.0 * PI
    let ellipse_a = 11 - rand.next_int_below(5)
    let ellipse_c = 3 + rand.next_int_below(3)
    let ellipse = rand.next_double() > 0.7
    let b = Berg { state: state, snow_on_top: snow_on_top, angle: angle, ellipse_a: ellipse_a, ellipse_c: ellipse_c, ellipse: ellipse }
    var over = if ellipse { rand.next_int_below(6) + 6 } else { rand.next_int_below(15) + 3 }
    if not ellipse and rand.next_double() > 0.9 {
        over += rand.next_int_below(19) + 7
    }
    let under = (over + rand.next_int_below(11)).min(18)
    let width = (over + rand.next_int_below(7) - rand.next_int_below(5)).min(11)
    let a = if ellipse { ellipse_a } else { 11 }
    for xo in -a..a {
        for zo in -a..a {
            for y_off in 0..over {
                let radius = if ellipse { radius_ellipse(y_off, over, width) } else { radius_round(mut rand, y_off, over, width) }
                if ellipse or xo < radius {
                    try berg_block(f, mut r, mut rand, b, x, y, z, over, xo, y_off, zo, radius, a)
                }
            }
        }
    }
    try smooth(f, mut r, b, x, y, z, width, over)
    for xo in -a..a {
        for zo in -a..a {
            var y_off = -1
            while y_off > -under {
                let new_a = if ellipse {
                    ceil_f32(f32.nearest(a) * (1.0f32 - f32.nearest(f64(y_off * y_off)) / (f32.nearest(under) * 8.0f32)))
                } else {
                    a
                }
                let radius = radius_steep(mut rand, -y_off, under, width)
                if xo < radius {
                    try berg_block(f, mut r, mut rand, b, x, y, z, under, xo, y_off, zo, radius, new_a)
                }
                y_off -= 1
            }
        }
    }
    let cut = if ellipse { rand.next_double() > 0.1 } else { rand.next_double() > 0.7 }
    if cut {
        try cut_out(f, mut r, mut rand, b, width, over, x, y, z)
    }
    return true
}

// `generateCutOut`.
fn cut_out<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, b: Berg, width: i32, height: i32, x: i32, y: i32, z: i32) ! Thrown {
    let sign_x = if rand.next_boolean() { -1 } else { 1 }
    let sign_z = if rand.next_boolean() { -1 } else { 1 }
    var x_off = try next_below(mut rand, (width / 2 - 2).max(1))
    if rand.next_boolean() {
        x_off = width / 2 + 1 - try next_below(mut rand, (width - width / 2 - 1).max(1))
    }
    var z_off = try next_below(mut rand, (width / 2 - 2).max(1))
    if rand.next_boolean() {
        z_off = width / 2 + 1 - try next_below(mut rand, (width - width / 2 - 1).max(1))
    }
    if b.ellipse {
        x_off = try next_below(mut rand, (b.ellipse_a - 5).max(1))
        z_off = x_off
    }
    let lx = sign_x * x_off
    let lz = sign_z * z_off
    let angle = if b.ellipse { b.angle + PI / 2.0 } else { rand.next_double() * 2.0 * PI }
    for y_off in 0..height - 3 {
        let radius = radius_round(mut rand, y_off, height, width)
        try carve(f, mut r, b, radius, y_off, x, y, z, false, angle, lx, lz)
    }
    var y_off = -1
    while y_off > -height + rand.next_int_below(5) {
        let radius = radius_steep(mut rand, -y_off, height, width)
        try carve(f, mut r, b, radius, y_off, x, y, z, true, angle, lx, lz)
        y_off -= 1
    }
}

// `carve`: water below the sea and air above it where the berg was, in an ellipse.
fn carve(f: Facts, r: mut Region, b: Berg, radius: i32, y_off: i32, x: i32, y: i32, z: i32, under: bool, angle: f64, lx: i32, lz: i32) ! Thrown {
    let a = radius + 1 + b.ellipse_a / 3
    let c = (radius - 3).min(3) + b.ellipse_c / 2 - 1
    let snow_block = f.ids.snow_block
    for xo in -a..a {
        for zo in -a..a {
            if ellipse_distance(xo, zo, lx, lz, a, c, angle) < 0.0 {
                let px = x + xo
                let py = y + y_off
                let pz = z + zo
                let s = try r.state(f, px, py, pz)
                if berg_state(f, s) or f.is(s, snow_block) {
                    if under {
                        _ = r.set_block(f, px, py, pz, f.ids.water_state, 3)
                    } else {
                        _ = r.set_block(f, px, py, pz, f.ids.air_state, 3)
                        // `removeFloatingSnowLayer`.
                        if f.is(try r.state(f, px, py + 1, pz), f.ids.snow) {
                            _ = r.set_block(f, px, py + 1, pz, f.ids.air_state, 3)
                        }
                    }
                }
            }
        }
    }
}

// `generateIcebergBlock`.
fn berg_block<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, b: Berg, x: i32, y: i32, z: i32, height: i32, xo: i32, y_off: i32, zo: i32, radius: i32, a: i32) ! Thrown {
    var d = 0.0
    if b.ellipse {
        d = ellipse_distance(xo, zo, 0, 0, a, ellipse_c_at(y_off, height, b.ellipse_c), b.angle)
    } else {
        // `signedDistanceCircle`.
        let off = 10.0f32 * clamp_float(rand.next_float(), 0.2f32, 0.8f32) / f32.nearest(radius)
        d = f64(off) + f64(xo) * f64(xo) + f64(zo) * f64(zo) - f64(radius) * f64(radius)
    }
    if d < 0.0 {
        let compare = if b.ellipse { -0.5 } else { f64(-6 - rand.next_int_below(3)) }
        if d > compare and rand.next_double() > 0.9 {
            return
        }
        try berg_set(f, mut r, mut rand, b, x + xo, y + y_off, z + zo, height - y_off, height)
    }
}

// `setIcebergBlock`: snow near the top if the berg has it, else its state, where there was air,
// snow, ice or water.
fn berg_set<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, b: Berg, x: i32, y: i32, z: i32, h_diff: i32, height: i32) ! Thrown {
    let s = try r.state(f, x, y, z)
    let water = f.is(s, f.ids.water)
    if f.is_air(s) or f.is(s, f.ids.snow_block) or f.is(s, f.ids.ice) or water {
        let randomness = not b.ellipse or rand.next_double() > 0.05
        let divisor = if b.ellipse { 3 } else { 2 }
        var snow = false
        if b.snow_on_top and not water {
            snow = f64(h_diff) <= f64(try next_below(mut rand, 1.max(height / divisor))) + f64(height) * 0.6 and randomness
        }
        if snow {
            _ = r.set_block(f, x, y, z, f.default_state(f.ids.snow_block), 3)
        } else {
            _ = r.set_block(f, x, y, z, b.state, 3)
        }
    }
}

// `getEllipseC`.
fn ellipse_c_at(y_off: i32, height: i32, c: i32) -> i32 {
    if y_off > 0 and height - y_off <= 3 {
        return c - (4 - (height - y_off))
    }
    return c
}

// `signedDistanceEllipse`.
fn ellipse_distance(xo: i32, zo: i32, ox: i32, oz: i32, a: i32, c: i32, angle: f64) -> f64 {
    let dx = f64(xo - ox)
    let dz = f64(zo - oz)
    let p = (dx * cos(angle) - dz * sin(angle)) / f64(a)
    let q = (dx * sin(angle) + dz * cos(angle)) / f64(c)
    // `Math.pow(v, 2.0)`, which is `v * v`.
    return p * p + q * q - 1.0
}

// `heightDependentRadiusRound`.
fn radius_round<T: RandomSource>(rand: mut T, y_off: i32, height: i32, width: i32) -> i32 {
    let k = 3.5f32 - rand.next_float()
    var scale = (1.0f32 - f32.nearest(y_off * y_off) / (f32.nearest(height) * k)) * f32.nearest(width)
    if height > 15 + rand.next_int_below(5) {
        let temp = if y_off < 3 + rand.next_int_below(6) { y_off / 2 } else { y_off }
        scale = (1.0f32 - f32.nearest(temp) / (f32.nearest(height) * k * 0.4f32)) * f32.nearest(width)
    }
    return ceil_f32(scale / 2.0f32)
}

// `heightDependentRadiusEllipse`.
fn radius_ellipse(y_off: i32, height: i32, width: i32) -> i32 {
    let scale = (1.0f32 - f32.nearest(y_off * y_off) / (f32.nearest(height) * 1.0f32)) * f32.nearest(width)
    return ceil_f32(scale / 2.0f32)
}

// `heightDependentRadiusSteep`.
fn radius_steep<T: RandomSource>(rand: mut T, y_off: i32, height: i32, width: i32) -> i32 {
    let k = 1.0f32 + rand.next_float() / 2.0f32
    let scale = (1.0f32 - f32.nearest(y_off) / (f32.nearest(height) * k)) * f32.nearest(width)
    return ceil_f32(scale / 2.0f32)
}

// `isIcebergState`.
fn berg_state(f: Facts, s: u32) -> bool {
    return f.is(s, f.ids.packed_ice) or f.is(s, f.ids.snow_block) or f.is(s, f.ids.blue_ice)
}

// `smooth`: berg blocks over air taken away with what's above them, and those with three open
// sides.
fn smooth(f: Facts, r: mut Region, b: Berg, x: i32, y: i32, z: i32, width: i32, height: i32) ! Thrown {
    let a = if b.ellipse { b.ellipse_a } else { width / 2 }
    for dx in -a..a + 1 {
        for dz in -a..a + 1 {
            for y_off in 0..height + 1 {
                let px = x + dx
                let py = y + y_off
                let pz = z + dz
                let s = try r.state(f, px, py, pz)
                if berg_state(f, s) or f.is(s, f.ids.snow) {
                    if f.is_air(try r.state(f, px, py - 1, pz)) {
                        _ = r.set_block(f, px, py, pz, f.ids.air_state, 3)
                        _ = r.set_block(f, px, py + 1, pz, f.ids.air_state, 3)
                    } else if berg_state(f, s) {
                        var open = 0
                        if not berg_state(f, try r.state(f, px - 1, py, pz)) {
                            open += 1
                        }
                        if not berg_state(f, try r.state(f, px + 1, py, pz)) {
                            open += 1
                        }
                        if not berg_state(f, try r.state(f, px, py, pz - 1)) {
                            open += 1
                        }
                        if not berg_state(f, try r.state(f, px, py, pz + 1)) {
                            open += 1
                        }
                        if open >= 3 {
                            _ = r.set_block(f, px, py, pz, f.ids.air_state, 3)
                        }
                    }
                }
            }
        }
    }
}
