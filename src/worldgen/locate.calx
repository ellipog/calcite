/// The search for the nearest of some structures, as vanilla's `ChunkGenerator.findNearestMapStructure`
/// runs it for an eye of ender (D599): the structures a tag names, read as `TagLoader` reads a
/// tag's file, or one; each set the world may place one by, `getPlacementsForStructure`; for
/// those placed in rings, the ring positions in their order, each tried that's nearer than the
/// nearest found so far; and for those spread at random, the square of sectors about the chunk
/// at each distance in turn, out to the radius, the nearest of the first to find any taken,
/// `getNearestGeneratedStructure`; each chunk tried with its starts made as `STRUCTURE_STARTS`
/// makes them, `getStructureGeneratingAt`. What a chunk saved or loaded started,
/// `StructureCheck`'s look before it, is what its starts are made to be, as a chunk is a pure
/// function of where it is; vanilla saves the chunks it loads for the look, which Calcite doesn't
/// yet. And Calcite's own search, which `locate structure` runs (D600): the nearest anywhere; and
/// its search for biomes, which `locate biome` runs (D601).
module worldgen.locate

import json.tree.{Json, get, parse, as_string}
import pack.data.{Data}
import worldgen.biome_manager.{SourceBiomes}
import worldgen.density.{qualified}
import worldgen.interval.{Thrown}
import worldgen.jigsaw.{Pools}
import worldgen.pieces.{Start}
import worldgen.sampler.{Program}
import worldgen.structure_world.{StructureWorld}
import worldgen.structures.{Placement, Spreading, StructureState, Structures, create_structures, potential_chunk, start_of_set}

/// What a search is for: the structures a tag names, by the tag's ID, or one structure, by its
/// ID (D600); or biomes (D601).
pub enum Wanted {
    Tag(String)
    One(String)
    Biomes(BiomeAsk)
}

/// What a search for biomes is for (D601): the biomes, by their IDs, and the level's lowest block
/// and height, within which it samples.
pub struct BiomeAsk {
    pub biomes: List<i32>
    pub min_y: i32
    pub height: i32
}

/// How far a search looks: vanilla's way, out to so many sectors for what's spread at random,
/// taking the nearest of what's found at the first distance any is, as an eye of ender's does
/// (D599); or Calcite's, the nearest anywhere, as `locate structure`'s does (D600).
pub enum Reach {
    Sectors(i32)
    Anywhere
}

/// What a search found: where the nearest structure is, `getLocatePos`, none where there's none,
/// and which it is; whether what it was for isn't there, no such structure or tag, `getHolders`'
/// none; or the biome, by its ID, for a search for biomes (D601); whether the world places any of
/// it, which it doesn't where its biomes aren't the generator's; how far out it had looked, in
/// blocks, where Calcite's search stopped short; what it would have done that Calcite doesn't
/// yet, to be said missing; what went wrong, to be logged; and how long it took, in nanoseconds,
/// only told, as vanilla's log tells it.
pub struct Nearest {
    pub at: (i32, i32, i32)? = none
    pub structure: String = String()
    pub biome: i32 = -1
    pub invalid: bool = false
    pub placed: bool = false
    pub stopped_at: i64? = none
    pub missing: List<String> = List<String>()
    pub problems: List<String> = List<String>()
    pub nanos: u64 = 0
}

// How many sectors' chunks, and how many starts made, Calcite's search tries before it stops
// short, saying how far it had looked: far more than finding any of vanilla's structures takes.
const MOST_SECTORS_TRIED: i64 = 4000000
const MOST_STARTS_TRIED: i32 = 20000

// How far from the block a structure can be and still be in the world, in blocks: corner to
// corner across it, its border 29,999,984 out.
const FARTHEST: i64 = 85000000

// How far apart Calcite's search for biomes samples, in blocks, across and up, as vanilla's
// `locate biome` does (D601); and how many it samples before it stops short, saying how far it
// had looked, some fifteen times what vanilla's whole search samples.
const BIOME_STEP: i32 = 32
const BIOME_STEP_Y: i32 = 64
const MOST_BIOME_SAMPLES: i64 = 16000000

// What Calcite's search has tried: sectors' chunks, and starts made.
struct Tries {
    sectors: i64 = 0
    starts: i32 = 0
}

impl Nearest {
    /// A search that found nothing, as where nothing generates.
    pub fn nothing() -> Nearest {
        return Nearest {}
    }
}

/// The structures `wanted` is for, by their places in `s`: a tag's, `structure_tag`, or the one
/// named; none where there's no such tag or structure, with why for a tag that couldn't be read
/// (D600).
pub fn wanted_structures(zip: Data, s: Structures, wanted: Wanted) -> (List<usize>?, String?) {
    match wanted {
        Wanted.Tag(name) => {
            return match structure_tag(zip, s, name.copy()) {
                ok(list) => (some(list), none),
                err(e) => (none, some(e)),
            }
        },
        Wanted.One(name) => {
            let st = s.structure_ids.get(qualified(name)) else return (none, none)
            return (some([st]), none)
        },
        Wanted.Biomes(_) => return (none, none),
    }
}

/// The structures the tag `name` names, by their places in `s`, in its order, each once: its
/// file in `zip`, `data/<namespace>/tags/worldgen/structure/<path>.json`, its `values` each an
/// ID, a tag's ID after `#`, whose structures are among them in its place, or either with
/// `required`, false where one that isn't there is let go. A tag that names itself, or names what
/// isn't there and is required, fails, as vanilla's then has no such tag. A pack's file for it is
/// read alone, not added to vanilla's.
pub fn structure_tag(zip: Data, s: Structures, name: String) -> List<usize> ! String {
    var out = List<usize>()
    var visiting = List<String>()
    try tag_into(zip, s, qualified(name), mut out, mut visiting)
    return out
}

// The structures of the tag `name` put in `out`, those of the tags being read `visiting`.
fn tag_into(zip: Data, s: Structures, name: String, out: mut List<usize>, visiting: mut List<String>) ! String {
    if visiting.contains(name) {
        fail "Tag {name} is part of a cycle"
    }
    visiting.push(name.copy())
    let colon = name.find(":") else fail "`{name}` isn't an identifier"
    let path = "data/{name[..colon]}/tags/worldgen/structure/{name[colon + 1..]}.json"
    let at = zip.find(path) else fail "Missing tag {name} in minecraft:worldgen/structure"
    let bytes = try zip.read(at)
    let text = String.from_utf8(bytes) else fail "{path} isn't UTF-8"
    let value = parse(text) else fail "{path} isn't JSON"
    let Json.Object(members) = value else fail "{path} isn't an object"
    let values = get(members, String("values")) else fail "No key values in {path}"
    let Json.Array(entries) = values else fail "Not a list: {values}"
    for entry in entries {
        var named = as_string(entry)
        var required = true
        if named == none {
            if let Json.Object(m) = entry {
                if let id = get(m, String("id")) {
                    named = as_string(id)
                }
                if let Json.Bool(b) = get(m, String("required")) ?? Json.Null {
                    required = b
                }
            }
        }
        let entry_name = named else fail "Not a tag entry: {entry}"
        if entry_name.starts_with("#") {
            match tag_into(zip, s, qualified(entry_name[1..]), mut out, mut visiting) {
                ok => {},
                err(e) => {
                    if required {
                        fail e
                    }
                },
            }
        } else {
            let full = qualified(entry_name)
            if let st = s.structure_ids.get(full) {
                if not out.contains(st) {
                    out.push(st)
                }
            } else if required {
                fail "Missing element {full} in tag {name}"
            }
        }
    }
    _ = visiting.pop()
}

/// `findNearestMapStructure` of the structures `wanted` about the block x, y, z, without adding a
/// reference to what it finds: each set the world may place one by, in the order they're first
/// met, with the wanted structures it places, `getPlacementsForStructure`; the nearest of what's
/// found in each placed in rings; then, for those spread at random, at each distance in sectors
/// from 0 to `radius` in turn, the nearest of what each finds at it, taken at the first distance
/// any finds anything, with the rings' where that's nearer (D600). `w`, `pools`, `zip` and
/// `state` make the starts of the chunks it tries, its rings already found.
pub fn nearest_map_structure(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, wanted: List<usize>, x: i32, y: i32, z: i32, radius: i32) -> Nearest ! Thrown {
    var found = Nearest {}
    var sets = List<usize>()
    var placing = List<List<usize>>()
    placements(s, state, wanted, mut sets, mut placing)
    found.placed = not sets.is_empty()
    var nearest: ((i32, i32, i32), usize)? = none
    var nearest_d = f64.MAX
    var spread = List<usize>()
    for k in 0..sets.len() {
        match s.sets[sets[k]].placement {
            Placement.Rings { common, .. } => {
                if let (at, st) = try nearest_in_rings(mut w, mut pools, zip, s, mut state, sets[k], placing[k], common, x, y, z) {
                    let d = dist_sqr(x, y, z, at)
                    if d < nearest_d {
                        nearest_d = d
                        nearest = some((at, st))
                    }
                }
            },
            Placement.RandomSpread { .. } => spread.push(k),
            _ => {},
        }
    }
    if not spread.is_empty() {
        let (cx, cz) = (x >> 4, z >> 4)
        var r = 0
        var something = false
        while r <= radius and not something {
            for k in spread {
                let Placement.RandomSpread { common, spacing, separation, triangular } = s.sets[sets[k]].placement else continue
                if let (at, st) = try nearest_spread(mut w, mut pools, zip, s, mut state, placing[k], common, spacing, separation, triangular, cx, cz, r) {
                    something = true
                    let d = dist_sqr(x, y, z, at)
                    if d < nearest_d {
                        nearest_d = d
                        nearest = some((at, st))
                    }
                }
            }
            r += 1
        }
    }
    if let (at, st) = nearest {
        found.at = some(at)
        found.structure = s.structures[st].id.copy()
    }
    return found
}

/// Calcite's search for the nearest of the structures `wanted` about the block x, z, which does
/// better than vanilla's (D600): the nearest by the distance across `locate` shows, anywhere in
/// the world, where vanilla's looks out to 100 sectors, takes the first distance any is found
/// at, and the first found of each set there, which can be farther than one at the next. Each
/// set placed in rings tries its positions nearest first, till one starts. Those spread at random
/// take their squares of sectors outward, always the set's whose next square could hold the
/// nearest, each square's chunks nearest first, those no nearer than what's found left, till no
/// square left could hold one nearer. Past `MOST_SECTORS_TRIED` sectors or `MOST_STARTS_TRIED`
/// starts it stops short, saying how far it had looked. A chunk starts what `createStructures`
/// starts there by the set, its other sets' starts not made, as they don't change it.
pub fn nearest_structure(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, wanted: List<usize>, x: i32, z: i32) -> Nearest ! Thrown {
    var found = Nearest {}
    var sets = List<usize>()
    var placing = List<List<usize>>()
    placements(s, state, wanted, mut sets, mut placing)
    if sets.is_empty() {
        return found
    }
    found.placed = true
    var best: ((i32, i32, i32), usize)? = none
    var best_d = i64.MAX
    var tries = Tries {}
    var spread = List<usize>()
    var squares = List<i32>()
    for k in 0..sets.len() {
        match s.sets[sets[k]].placement {
            Placement.Rings { common, .. } => {
                let positions = (try state.ring_positions(s, mut w.biomes, w.functions.program, sets[k])) else continue
                var order = List<(i64, i32, i32)>()
                for (cx, cz) in positions {
                    order.push((flat_sqr(x, z, (cx << 4) + common.locate_x, (cz << 4) + common.locate_z), cx, cz))
                }
                order.sort()
                for (d, cx, cz) in order {
                    if d >= best_d {
                        break
                    }
                    if let st = try starts_at(mut w, mut pools, zip, s, mut state, sets[k], placing[k], cx, cz, mut tries) {
                        best = some((((cx << 4) + common.locate_x, common.locate_y, (cz << 4) + common.locate_z), st))
                        best_d = d
                        break
                    }
                }
            },
            Placement.RandomSpread { .. } => {
                spread.push(k)
                squares.push(0)
            },
            _ => {},
        }
    }
    let (cx, cz) = (x >> 4, z >> 4)
    loop {
        // The set whose next square could hold the nearest.
        var pick: usize? = none
        var pick_near = i64.MAX
        for i in 0..spread.len() {
            let Placement.RandomSpread { spacing, .. } = s.sets[sets[spread[i]]].placement else continue
            let near = square_nearest(squares[i], spacing)
            if near > FARTHEST or near * near >= best_d {
                continue
            }
            if near < pick_near {
                pick = some(i)
                pick_near = near
            }
        }
        let i = pick else break
        if tries.sectors > MOST_SECTORS_TRIED or tries.starts > MOST_STARTS_TRIED {
            found.stopped_at = some(pick_near)
            break
        }
        let k = spread[i]
        let Placement.RandomSpread { common, spacing, separation, triangular } = s.sets[sets[k]].placement else break
        let r = squares[i]
        var order = List<(i64, i32, i32)>()
        for dx in -r..r + 1 {
            if dx == -r or dx == r {
                for dz in -r..r + 1 {
                    sector_into(mut order, state.seed, common, spacing, separation, triangular, cx + spacing * dx, cz + spacing * dz, x, z, best_d)
                }
            } else {
                sector_into(mut order, state.seed, common, spacing, separation, triangular, cx + spacing * dx, cz - spacing * r, x, z, best_d)
                sector_into(mut order, state.seed, common, spacing, separation, triangular, cx + spacing * dx, cz + spacing * r, x, z, best_d)
            }
        }
        tries.sectors += if r == 0 { 1 } else { i64(r) * 8 }
        order.sort()
        for (d, px, pz) in order {
            if d >= best_d {
                break
            }
            if let st = try starts_at(mut w, mut pools, zip, s, mut state, sets[k], placing[k], px, pz, mut tries) {
                best = some((((px << 4) + common.locate_x, common.locate_y, (pz << 4) + common.locate_z), st))
                best_d = d
                break
            }
        }
        squares[i] = r + 1
    }
    if let (at, st) = best {
        found.at = some(at)
        found.structure = s.structures[st].id.copy()
    }
    return found
}

/// Calcite's search for the nearest of the biomes `ask` is for about the block x, y, z (D601),
/// which does better than vanilla's `findClosestBiome3d`. Vanilla's samples every 32 blocks
/// across and 64 up, out to 6400 blocks, in a square spiral, and takes the first it finds, which
/// can be farther than one later in the spiral. Calcite's samples the same places, with the
/// samplers' caches on as vanilla's are, `createCachingResolver`, in squares
/// outward, each column's heights nearest first, as `outFromOrigin` orders them, and takes the
/// nearest, stopping once no square left could hold one nearer; then every quart within a step
/// of it, at the block of each nearest the one searched from, to find the nearest there. None
/// where the source has none of them, `possibleBiomes`; past `MOST_BIOME_SAMPLES` it stops short,
/// saying how far it had looked.
pub fn nearest_biome(biomes: mut SourceBiomes, p: Program, ask: BiomeAsk, x: i32, y: i32, z: i32) -> Nearest ! Thrown {
    var found = Nearest {}
    for b in biomes.source.possible() {
        if ask.biomes.contains(b) {
            found.placed = true
        }
    }
    if not found.placed {
        return found
    }
    let low = ask.min_y + 1
    let high = ask.min_y + ask.height
    let ys = out_from_origin(y, low, high, BIOME_STEP_Y)
    var best: (i32, i32, i32, i32)? = none
    var best_d = i64.MAX
    var samples = 0i64
    var r = 0
    loop {
        let near = i64(r) * i64(BIOME_STEP)
        if near > FARTHEST or near * near >= best_d {
            break
        }
        if samples > MOST_BIOME_SAMPLES {
            found.stopped_at = some(near)
            break
        }
        for dx in -r..r + 1 {
            if dx == -r or dx == r {
                for dz in -r..r + 1 {
                    samples += try biome_column(mut biomes, p, ask.biomes, ys, x, y, z, x + dx * BIOME_STEP, z + dz * BIOME_STEP, mut best, mut best_d)
                }
            } else {
                samples += try biome_column(mut biomes, p, ask.biomes, ys, x, y, z, x + dx * BIOME_STEP, z - r * BIOME_STEP, mut best, mut best_d)
                samples += try biome_column(mut biomes, p, ask.biomes, ys, x, y, z, x + dx * BIOME_STEP, z + r * BIOME_STEP, mut best, mut best_d)
            }
        }
        r += 1
    }
    let (bx, by, bz, _) = best else return found
    // Every quart within a step of it, at the block of each nearest the one searched from.
    let low_y = (by - BIOME_STEP_Y / 2).max(low)
    let high_y = (by + BIOME_STEP_Y / 2).min(high)
    for qx in (bx - BIOME_STEP) >> 2..((bx + BIOME_STEP) >> 2) + 1 {
        for qz in (bz - BIOME_STEP) >> 2..((bz + BIOME_STEP) >> 2) + 1 {
            for qy in low_y >> 2..(high_y >> 2) + 1 {
                let b = try biomes.at_caching(p, qx, qy, qz)
                if not ask.biomes.contains(b) {
                    continue
                }
                let px = x.max(qx << 2).min((qx << 2) + 3)
                let py = y.max((qy << 2).max(low)).min(((qy << 2) + 3).min(high))
                let pz = z.max(qz << 2).min((qz << 2) + 3)
                let d = sqr3(x, y, z, px, py, pz)
                if d < best_d {
                    best_d = d
                    best = some((px, py, pz, b))
                }
            }
        }
    }
    let (fx, fy, fz, fb) = best else return found
    found.at = some((fx, fy, fz))
    found.biome = fb
    return found
}

// The column at bx, bz, sampled at the heights `ys`, nearest the block x, y, z first: the first of
// `wanted` it has taken, where it's nearer than `best`, and how many it sampled given.
fn biome_column(biomes: mut SourceBiomes, p: Program, wanted: List<i32>, ys: List<i32>, x: i32, y: i32, z: i32, bx: i32, bz: i32, best: mut (i32, i32, i32, i32)?, best_d: mut i64) -> i64 ! Thrown {
    let flat = flat_sqr(x, z, bx, bz)
    if flat >= best_d {
        return 0
    }
    var n = 0i64
    for by in ys {
        let dy = i64(by) - i64(y)
        let d = flat + dy * dy
        if d >= best_d {
            break
        }
        n += 1
        let b = try biomes.at_caching(p, bx >> 2, by >> 2, bz >> 2)
        if wanted.contains(b) {
            best_d = d
            best = some((bx, by, bz, b))
            break
        }
    }
    return n
}

// `Mth.outFromOrigin`: from `origin`, kept within `low` and `high`, outward `step` at a time,
// above then below, each while it's within them.
fn out_from_origin(origin: i32, low: i32, high: i32, step: i32) -> List<i32> {
    var out = List<i32>()
    if low > high {
        return out
    }
    let c = origin.max(low).min(high)
    var cursor = c
    loop {
        let d = (c - cursor).abs()
        if not (c - d >= low or c + d <= high) {
            break
        }
        out.push(cursor)
        let below = cursor <= c
        let can_rise = c + d + step <= high
        var next = c + d + step
        if not below or not can_rise {
            let tried = c - d - (if below { step } else { 0 })
            if tried >= low {
                next = tried
            }
        }
        cursor = next
    }
    return out
}

// The square of the distance from the block x, y, z to ax, ay, az.
fn sqr3(x: i32, y: i32, z: i32, ax: i32, ay: i32, az: i32) -> i64 {
    let dx = i64(ax) - i64(x)
    let dy = i64(ay) - i64(y)
    let dz = i64(az) - i64(z)
    return dx * dx + dy * dy + dz * dz
}

// `getPlacementsForStructure` of each of `wanted`: each set the world may place one by, in the
// order they're first met, put in `sets`, with the wanted structures it places in `placing`.
fn placements(s: Structures, state: StructureState, wanted: List<usize>, sets: mut List<usize>, placing: mut List<List<usize>>) {
    for st in wanted {
        for set in state.possible {
            if not state.places(s, set, st) {
                continue
            }
            var k = sets.len()
            for i in 0..sets.len() {
                if sets[i] == set {
                    k = i
                }
            }
            if k == sets.len() {
                sets.push(set)
                placing.push(List<usize>())
            }
            if not placing[k].contains(st) {
                placing[k].push(st)
            }
        }
    }
}

// The chunk of the sector of the chunk sx, sz that may start one, `getPotentialStructureChunk`,
// put in `order` with the square of its distance across from the block x, z, where that's less
// than `best_d`.
fn sector_into(order: mut List<(i64, i32, i32)>, seed: i64, common: Spreading, spacing: i32, separation: i32, triangular: bool, sx: i32, sz: i32, x: i32, z: i32, best_d: i64) {
    let (px, pz) = potential_chunk(seed, common.salt, spacing, separation, triangular, sx, sz)
    let d = flat_sqr(x, z, (px << 4) + common.locate_x, (pz << 4) + common.locate_z)
    if d < best_d {
        order.push((d, px, pz))
    }
}

// How near to the block a place in the square of sectors `r` out can be, in blocks, its sectors
// `spacing` chunks wide: the square's inside edge is `r - 1` sectors past the block's sector, and
// a place is at most 16 from its chunk's corner, `locate_offset`.
fn square_nearest(r: i32, spacing: i32) -> i64 {
    return (i64(r - 1) * i64(spacing) * 16 - 16).max(0)
}

// Which of `structures` the set `set` starts in the chunk cx, cz, if one: the set places there,
// `isStructureChunk`, and what `createStructures` starts by it has pieces, `isValid`, made only
// to see that, `probing`, so a jigsaw structure isn't put together.
fn starts_at(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, set: usize, structures: List<usize>, cx: i32, cz: i32, tries: mut Tries) -> usize? ! Thrown {
    if not try state.is_structure_chunk(s, mut w.biomes, w.functions.program, set, cx, cz) {
        return none
    }
    tries.starts += 1
    w.probing = true
    var made: Start? = none
    var thrown: Thrown? = none
    match start_of_set(mut w, mut pools, zip, s, set, cx, cz) {
        ok(m) => made = m,
        err(t) => thrown = some(t),
    }
    w.probing = false
    if let t = thrown {
        fail t
    }
    let start = made else return none
    for st in structures {
        if start.id == s.structures[st].id {
            return some(st)
        }
    }
    return none
}

// The square of the distance across from the block x, z to ax, az.
fn flat_sqr(x: i32, z: i32, ax: i32, az: i32) -> i64 {
    let dx = i64(ax) - i64(x)
    let dz = i64(az) - i64(z)
    return dx * dx + dz * dz
}

// `getNearestGeneratedStructure` of a set spread at random, its structures `structures`, at the
// distance `r` in sectors from the chunk cx, cz: each sector on the square's edge, `x` outer, its
// chunk that may start one, `getPotentialStructureChunk`, tried in turn, the first that does taken.
fn nearest_spread(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, structures: List<usize>, common: Spreading, spacing: i32, separation: i32, triangular: bool, cx: i32, cz: i32, r: i32) -> ((i32, i32, i32), usize)? ! Thrown {
    for dx in -r..r + 1 {
        let x_edge = dx == -r or dx == r
        for dz in -r..r + 1 {
            let z_edge = dz == -r or dz == r
            if not x_edge and not z_edge {
                continue
            }
            let (px, pz) = potential_chunk(state.seed, common.salt, spacing, separation, triangular, cx + spacing * dx, cz + spacing * dz)
            if let found = try generating_at(mut w, mut pools, zip, s, mut state, structures, common, px, pz) {
                return some(found)
            }
        }
    }
    return none
}

// `getNearestGeneratedStructure` of the set `set` placed in rings, its structures `structures`:
// each ring position in turn, its chunk's middle 32 up nearer to the block x, y, z than the
// nearest found so far, or the first, tried, and taken where one of them starts there.
fn nearest_in_rings(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, set: usize, structures: List<usize>, common: Spreading, x: i32, y: i32, z: i32) -> ((i32, i32, i32), usize)? ! Thrown {
    let positions = (try state.ring_positions(s, mut w.biomes, w.functions.program, set)) else fail Thrown { exception: "IllegalStateException", message: "Somehow tried to find structures for a placement that doesn't exist" }
    var closest: ((i32, i32, i32), usize)? = none
    var closest_d = f64.MAX
    for (cx, cz) in positions {
        let d = dist_sqr(x, y, z, ((cx << 4) + 8, 32, (cz << 4) + 8))
        if closest == none or d < closest_d {
            if let at = try generating_at(mut w, mut pools, zip, s, mut state, structures, common, cx, cz) {
                closest = some(at)
                closest_d = d
            }
        }
    }
    return closest
}

// `getStructureGeneratingAt` of the chunk cx, cz: its starts made, `createStructures`, as
// `getChunk` at `STRUCTURE_STARTS` makes them, and the first of `structures` with one there that
// has pieces, `isValid`, found at its chunk's corner moved by the placement's `locate_offset`,
// `getLocatePos`, with which it is.
fn generating_at(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, structures: List<usize>, common: Spreading, cx: i32, cz: i32) -> ((i32, i32, i32), usize)? ! Thrown {
    let starts = try create_structures(mut w, mut pools, zip, s, mut state, cx, cz)
    for st in structures {
        for start in starts {
            if start.id == s.structures[st].id and not start.pieces.is_empty() {
                return some((((start.chunk_x << 4) + common.locate_x, common.locate_y, (start.chunk_z << 4) + common.locate_z), st))
            }
        }
    }
    return none
}

// `Vec3i.distSqr`: the square of the distance from the block x, y, z to `at`.
fn dist_sqr(x: i32, y: i32, z: i32, at: (i32, i32, i32)) -> f64 {
    let (ax, ay, az) = at
    let dx = f64(ax) - f64(x)
    let dy = f64(ay) - f64(y)
    let dz = f64(az) - f64(z)
    return dx * dx + dy * dy + dz * dz
}
