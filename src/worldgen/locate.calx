/// The search for the nearest of some structures, as vanilla's `ChunkGenerator.findNearestMapStructure`
/// runs it for an eye of ender (D599): the structures a tag names, read as `TagLoader` reads a
/// tag's file; each set the world may place one by, `getPlacementsForStructure`; and, for those
/// placed in rings, the ring positions in their order, each tried that's nearer than the nearest
/// found so far, `getNearestGeneratedStructure`, where the chunk's starts are made as
/// `STRUCTURE_STARTS` makes them, `getStructureGeneratingAt`. What a chunk saved or loaded
/// started, `StructureCheck`'s look before it, is what its starts are made to be, as a chunk is a
/// pure function of where it is; vanilla saves the chunks it loads for the look, which Calcite
/// doesn't yet.
module worldgen.locate

import json.tree.{Json, get, parse, as_string}
import pack.data.{Data}
import worldgen.density.{qualified}
import worldgen.interval.{Thrown}
import worldgen.jigsaw.{Pools}
import worldgen.structure_world.{StructureWorld}
import worldgen.structures.{Placement, Spreading, StructureState, Structures, create_structures}

/// What a search found: where the nearest structure is, `getLocatePos`, none where there's none;
/// what it would have done that Calcite doesn't yet, to be said missing; and what went wrong, to
/// be logged.
pub struct Nearest {
    pub at: (i32, i32, i32)? = none
    pub missing: List<String> = List<String>()
    pub problems: List<String> = List<String>()
}

impl Nearest {
    /// A search that found nothing, as where nothing generates.
    pub fn nothing() -> Nearest {
        return Nearest {}
    }
}

/// The structures the tag `name` names, by their places in `s`, in its order, each once: its
/// file in `zip`, `data/<namespace>/tags/worldgen/structure/<path>.json`, its `values` each an
/// ID, a tag's ID after `#`, whose structures are among them in its place, or either with
/// `required`, false where one that isn't there is let go. A tag that names itself, or names what
/// isn't there and is required, fails, as vanilla's then has no such tag. A pack's file for it is
/// read alone, not added to vanilla's.
pub fn structure_tag(zip: Data, s: Structures, name: String) -> List<usize> ! String {
    var out = List<usize>()
    var visiting = List<String>()
    try tag_into(zip, s, qualified(name), mut out, mut visiting)
    return out
}

// The structures of the tag `name` put in `out`, those of the tags being read `visiting`.
fn tag_into(zip: Data, s: Structures, name: String, out: mut List<usize>, visiting: mut List<String>) ! String {
    if visiting.contains(name) {
        fail "Tag {name} is part of a cycle"
    }
    visiting.push(name.copy())
    let colon = name.find(":") else fail "`{name}` isn't an identifier"
    let path = "data/{name[..colon]}/tags/worldgen/structure/{name[colon + 1..]}.json"
    let at = zip.find(path) else fail "Missing tag {name} in minecraft:worldgen/structure"
    let bytes = try zip.read(at)
    let text = String.from_utf8(bytes) else fail "{path} isn't UTF-8"
    let value = parse(text) else fail "{path} isn't JSON"
    let Json.Object(members) = value else fail "{path} isn't an object"
    let values = get(members, String("values")) else fail "No key values in {path}"
    let Json.Array(entries) = values else fail "Not a list: {values}"
    for entry in entries {
        var named = as_string(entry)
        var required = true
        if named == none {
            if let Json.Object(m) = entry {
                if let id = get(m, String("id")) {
                    named = as_string(id)
                }
                if let Json.Bool(b) = get(m, String("required")) ?? Json.Null {
                    required = b
                }
            }
        }
        let entry_name = named else fail "Not a tag entry: {entry}"
        if entry_name.starts_with("#") {
            match tag_into(zip, s, qualified(entry_name[1..]), mut out, mut visiting) {
                ok => {},
                err(e) => {
                    if required {
                        fail e
                    }
                },
            }
        } else {
            let full = qualified(entry_name)
            if let st = s.structure_ids.get(full) {
                if not out.contains(st) {
                    out.push(st)
                }
            } else if required {
                fail "Missing element {full} in tag {name}"
            }
        }
    }
    _ = visiting.pop()
}

/// `findNearestMapStructure` of the structures `wanted` about the block x, y, z, without adding a
/// reference to what it finds: each set the world may place one by, in the order they're first
/// met, with the wanted structures it places, `getPlacementsForStructure`; the nearest of what's
/// found in each placed in rings. A set spread at random, which vanilla searches in squares about
/// the chunk, is said missing. `w`, `pools`, `zip` and `state` make the starts of the chunks it
/// tries, its rings already found.
pub fn nearest_map_structure(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, wanted: List<usize>, x: i32, y: i32, z: i32) -> Nearest ! Thrown {
    var found = Nearest {}
    var sets = List<usize>()
    var placing = List<List<usize>>()
    for st in wanted {
        for set in state.possible.copy() {
            if not state.places(s, set, st) {
                continue
            }
            var k = sets.len()
            for i in 0..sets.len() {
                if sets[i] == set {
                    k = i
                }
            }
            if k == sets.len() {
                sets.push(set)
                placing.push(List<usize>())
            }
            if not placing[k].contains(st) {
                placing[k].push(st)
            }
        }
    }
    var nearest: (i32, i32, i32)? = none
    var nearest_d = f64.MAX
    var spread = false
    for k in 0..sets.len() {
        match s.sets[sets[k]].placement {
            Placement.Rings { common, .. } => {
                if let at = try nearest_in_rings(mut w, mut pools, zip, s, mut state, sets[k], placing[k], common, x, y, z) {
                    let d = dist_sqr(x, y, z, at)
                    if d < nearest_d {
                        nearest_d = d
                        nearest = some(at)
                    }
                }
            },
            Placement.RandomSpread { .. } => spread = true,
            _ => {},
        }
    }
    if spread {
        found.missing.push(String("The search for the nearest structure a set spreads at random, in squares about the chunk"))
    }
    found.at = nearest
    return found
}

// `getNearestGeneratedStructure` of the set `set` placed in rings, its structures `structures`:
// each ring position in turn, its chunk's middle 32 up nearer to the block x, y, z than the
// nearest found so far, or the first, tried, and taken where one of them starts there.
fn nearest_in_rings(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, set: usize, structures: List<usize>, common: Spreading, x: i32, y: i32, z: i32) -> (i32, i32, i32)? ! Thrown {
    let positions = (try state.ring_positions(s, mut w.biomes, w.functions.program, set)) else fail Thrown { exception: "IllegalStateException", message: "Somehow tried to find structures for a placement that doesn't exist" }
    var closest: (i32, i32, i32)? = none
    var closest_d = f64.MAX
    for (cx, cz) in positions {
        let d = dist_sqr(x, y, z, ((cx << 4) + 8, 32, (cz << 4) + 8))
        if closest == none or d < closest_d {
            if let at = try generating_at(mut w, mut pools, zip, s, mut state, structures, common, cx, cz) {
                closest = some(at)
                closest_d = d
            }
        }
    }
    return closest
}

// `getStructureGeneratingAt` of the chunk cx, cz: its starts made, `createStructures`, as
// `getChunk` at `STRUCTURE_STARTS` makes them, and the first of `structures` with one there that
// has pieces, `isValid`, found at its chunk's corner moved by the placement's `locate_offset`,
// `getLocatePos`.
fn generating_at(w: mut StructureWorld, pools: mut Pools, zip: Data, s: Structures, state: mut StructureState, structures: List<usize>, common: Spreading, cx: i32, cz: i32) -> (i32, i32, i32)? ! Thrown {
    let starts = try create_structures(mut w, mut pools, zip, s, mut state, cx, cz)
    for st in structures {
        for start in starts {
            if start.id == s.structures[st].id and not start.pieces.is_empty() {
                return some(((start.chunk_x << 4) + common.locate_x, common.locate_y, (start.chunk_z << 4) + common.locate_z))
            }
        }
    }
    return none
}

// `Vec3i.distSqr`: the square of the distance from the block x, y, z to `at`.
fn dist_sqr(x: i32, y: i32, z: i32, at: (i32, i32, i32)) -> f64 {
    let (ax, ay, az) = at
    let dx = f64(ax) - f64(x)
    let dy = f64(ay) - f64(y)
    let dz = f64(az) - f64(z)
    return dx * dx + dy * dy + dz * dz
}
