/// The scattered structures' pieces placed as their chunks are decorated: buried treasure's
/// chest, and the `ScatteredFeaturePiece`s, desert pyramids, jungle temples and swamp huts, each
/// settled on the ground the first time it's placed.
module worldgen.scattered_pieces

import random.source.{RandomSource}
import worldgen.drawing.{UPDATE_ALL, chest_at}
import worldgen.facts.{Facts, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Piece}
import worldgen.region.{Region}
import worldgen.template.{Bounds}
import world.chunk.{OCEAN_FLOOR_WG}

/// `BuriedTreasurePiece.postProcess`: down from the ocean floor at the piece's corner to the
/// first block over sandstone, stone, andesite, granite or diorite; the open blocks around it
/// filled, with what's below where there's nothing under them, else with it or sand; and a chest
/// there, the piece's box shrunk to it.
pub fn buried_treasure<T: RandomSource>(f: Facts, r: mut Region, random: mut T, piece: mut Piece, area: Bounds) ! Thrown {
    let x = piece.bb.min_x
    let z = piece.bb.min_z
    var y = try r.get_height(f, OCEAN_FLOOR_WG, x, z)
    let floors: List<u32> = [f.ids.stone, try f.named_block(String("sandstone")), try f.named_block(String("andesite")), try f.named_block(String("granite")), try f.named_block(String("diorite"))]
    while y > r.min_y {
        let current = try r.state(f, x, y, z)
        let below = try r.state(f, x, y - 1, z)
        if floors.contains(f.block(below)) {
            let soft = if not f.is_air(current) and not liquid(f, current) { current } else { f.default_state(f.ids.sand) }
            for d in 0..6 {
                let nx = x + step_x(d)
                let ny = y + step_y(d)
                let nz = z + step_z(d)
                let near = try r.state(f, nx, ny, nz)
                if f.is_air(near) or liquid(f, near) {
                    let under = try r.state(f, nx, ny - 1, nz)
                    if (f.is_air(under) or liquid(f, under)) and d != 1 {
                        _ = r.set_block(f, nx, ny, nz, below, UPDATE_ALL)
                    } else {
                        _ = r.set_block(f, nx, ny, nz, soft, UPDATE_ALL)
                    }
                }
            }
            piece.bb = Bounds { min_x: x, min_y: y, min_z: z, max_x: x, max_y: y, max_z: z }
            _ = try chest_at(f, mut r, area, mut random, x, y, z, "minecraft:chests/buried_treasure", none)
            return
        }
        y -= 1
    }
}

// Water or lava.
fn liquid(f: Facts, state: u32) -> bool {
    return f.is(state, f.ids.water) or f.is(state, f.ids.lava)
}
