/// Which of the generator's jobs can be done when (CAL-88): a chunk's terrain once the starts
/// within 8 of it and the biomes around it are made, its decoration once the terrain of the nine
/// around it is and each chunk 2 or less from it of a lower rank is decorated (D214), and the
/// chunk finished once the nine around it are decorated. Starts and biomes are made a block of
/// chunks a job. A block's starts wait only for the strongholds' ring searches whose positions
/// its chunks, or the exclusion zones about them, can meet: a search moves its position at most
/// `RING_REACH` chunks, so the chunks near the origin never wait for one (D219). A search some
/// starts wait for goes out first, and the rest once nothing else is ready.
///
/// Each job is a node, which counts the nodes it needs that aren't done, and each node keeps the
/// nodes that wait for it, so a job is ready the moment the last it needs is done, with nothing
/// looked at again. What's ready goes out most urgent first: finishing, then decorating, then
/// terrain, biomes and starts, each in the order it came, so the chunks asked for first are
/// finished first and few are kept part made.
///
/// The scheduler keeps what the jobs made until the jobs that need it are out: the starts, which
/// it hands each decoration a copy of; each chunk's biomes and references; and the terrain of each
/// chunk not yet finished, which goes out with each decoration of the nine around it and comes
/// back. A decoration changes only pieces that reach its chunk, and a piece a decoration changes
/// is never more than 33 blocks across, so two decorations that change one piece are 2 or less
/// apart and go in rank order; the pieces a decoration hands back that reach its chunk replace
/// the scheduler's.
///
/// What's saved of a chunk is carried on from, as vanilla carries on from a chunk saved part-way
/// (D334). A chunk's terrain and its decoration first need a look at what's saved of it, which
/// isn't a worker's job but the caller's, who hands back what it found with `peeked`; what they
/// need then is worked out from it. A chunk saved with its terrain has what was saved read as its
/// terrain, and is decorated. One saved with its features too is read the same way and isn't
/// decorated again, and it's finished once the nine around it are decorated, as vanilla's still
/// takes what its neighbours' features put in it. A full chunk's decoration needs a look at the
/// eight around it: where each is saved decorated or full, and one at least decorated, as around
/// every full chunk vanilla saves, they have what its features put in them, so it isn't
/// decorated again. Any other full chunk, as one Calcite finished has, whose neighbours it
/// doesn't save, is made again from nothing, as before, so the chunks beside it come to what
/// they came to when it was made. A chunk saved with its terrain is decorated before the chunks
/// 2 or less from it that aren't, whatever their ranks, as vanilla goes on from it before it
/// makes the chunks past it; so a decoration needs a look at each chunk 2 or less from it too.
/// A world with no chunk saved part-way, as every world Calcite made is, is decorated in the
/// order it was.
///
/// `Generator` does the jobs one at a time on the thread it's on, as a check of the threads' and
/// for what wants a chunk at once.
module worldgen.scheduler

import storage.chunk.{ChunkData, ChunkRest}
import world.chunk.{BlockStates, Chunk}
import worldgen.beardifier.{Beardifier}
import worldgen.generator.{BLOCK_SHIFT, DecorateJob, FinishJob, GenSetup, HEIGHT, Job, MIN_Y, Made, TerrainJob, Worker, rank_of, source_of}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Start}
import worldgen.references.{Refs, StartMap, beardifier_for, chunk_key, create_references}
import worldgen.region.{RegionChunk}
import worldgen.structures.{RING_REACH, RingSearch, Rings, StructureState, Structures, UNKNOWN_RING}
import pack.data.{Data}

// The kinds of node, most urgent first: the workers' jobs, then a chunk's look at what's saved
// of it, which is the caller's (D334).
const FINISH: i64 = 0
const DECORATE: i64 = 1
const TERRAIN: i64 = 2
const BIOMES: i64 = 3
const STARTS: i64 = 4
const PEEK: i64 = 5
const KINDS: usize = 6
const JOBS: usize = 5

// What a look found saved of a chunk (D334).
const SAVED_NOTHING: u8 = 0
const SAVED_TERRAIN: u8 = 1
const SAVED_DECORATED: u8 = 2
const SAVED_FULL: u8 = 3

/// What's saved of a chunk, as a look at it finds it (D334): nothing to carry on from, which is
/// made from the start, as a chunk saved before its terrain, or by another version, is; its
/// terrain, at `minecraft:terrain`; its features too, from `minecraft:features` to
/// `minecraft:spawn`; or the chunk full.
pub enum Saved {
    Nothing
    Terrain(ChunkData)
    Decorated(ChunkData)
    Full
}

// What a node is doing.
const WAITING: u8 = 0
const READY: u8 = 1
const RUNNING: u8 = 2
const DONE: u8 = 3

// Coordinates are kept in 28 bits each, from this.
const OFFSET: i64 = 1 << 27
const MASK: i64 = (1 << 28) - 1

// A node's ID: its kind, and its chunk or block.
fn node(kind: i64, x: i32, z: i32) -> i64 {
    return (kind << 56) | (((i64(x) + OFFSET) & MASK) << 28) | ((i64(z) + OFFSET) & MASK)
}

fn kind_of(n: i64) -> i64 {
    return n >> 56
}

fn x_of(n: i64) -> i32 {
    return i32.wrap(((n >> 28) & MASK) - OFFSET)
}

fn z_of(n: i64) -> i32 {
    return i32.wrap((n & MASK) - OFFSET)
}

// A job: how many of the nodes it needs aren't done, what it's doing, and the nodes that wait
// for it.
struct Node {
    missing: u32
    state: u8
    dependents: List<i64>
}

/// What schedules the generator's jobs, with what they've made so far.
pub struct Scheduler {
    structures: Structures
    nodes: Map<i64, Node>
    // What's ready, by kind.
    queues: List<Deque<i64>>
    out: usize
    starts: StartMap
    biomes: Map<i64, List<i32>>
    refs: Map<i64, List<Refs>>
    protos: Map<i64, RegionChunk>
    // What a look found saved of each chunk, and of each whose terrain is saved, what was, until
    // its terrain goes out to be read (D334).
    seeds: Map<i64, u8>
    saved: Map<i64, ChunkData>
    // The ring searches, each until it goes out; where each starts and its set and place; whether
    // it's back; the starts' nodes that wait for it; those some node waits for, to go out first;
    // and the next to go out when nothing else is ready. The rings fill in as they come back.
    searches: List<RingSearch?>
    all_searches: List<RingSearch>
    search_origins: List<(i32, i32)>
    search_keys: List<(usize, usize)>
    search_done: List<bool>
    search_waiting: List<List<i64>>
    search_urgent: List<bool>
    urgent: Deque<usize>
    idle_search: usize
    // How far from a block's chunks a ring position matters to its starts: as far as a search
    // moves its position, and as far as a set's exclusion zone looks.
    ring_margin: i32
    rings: Rings
    // The chunks finished by `take`, to be taken.
    finished: Deque<(i32, i32, Chunk, ChunkRest)>
    // The world's bottom and height.
    level_min: i32 = MIN_Y
    level_height: i32 = HEIGHT
    /// What went wrong making chunks, to be logged, oldest first.
    pub problems: List<String>
}

impl Scheduler {
    /// A scheduler for chunks of the structures, as `Worker.structures` gives them, whose
    /// strongholds' rings the searches place, as `Worker.ring_searches` gives them.
    pub fn new(structures: own Structures, searches: own List<RingSearch>) -> Scheduler {
        var ready = List<Deque<i64>>()
        for _ in 0..KINDS {
            ready.push(Deque<i64>())
        }
        var rings = Rings { sets: List<usize>(), lists: List<List<(i32, i32)>>() }
        let all = searches.copy()
        var queue = List<RingSearch?>()
        var origins = List<(i32, i32)>()
        var keys = List<(usize, usize)>()
        var waiting = List<List<i64>>()
        var rest = searches
        while not rest.is_empty() {
            let r = rest.remove(0)
            if not rings.sets.contains(r.set) {
                rings.sets.push(r.set)
                rings.lists.push(List<(i32, i32)>())
            }
            for i in 0..rings.sets.len() {
                if rings.sets[i] == r.set {
                    rings.lists[i].push(UNKNOWN_RING)
                }
            }
            origins.push(r.origin())
            keys.push((r.set, r.index))
            waiting.push(List<i64>())
            queue.push(some(r))
        }
        let count = queue.len()
        let margin = RING_REACH + StructureState.most_exclusion(structures)
        return Scheduler {
            structures: structures,
            nodes: Map<i64, Node>(),
            queues: ready,
            out: 0,
            starts: StartMap.new(),
            biomes: Map<i64, List<i32>>(),
            refs: Map<i64, List<Refs>>(),
            protos: Map<i64, RegionChunk>(),
            seeds: Map<i64, u8>(),
            saved: Map<i64, ChunkData>(),
            searches: queue,
            all_searches: all,
            search_origins: origins,
            search_keys: keys,
            search_done: [false; count],
            search_waiting: waiting,
            search_urgent: [false; count],
            urgent: Deque<usize>(),
            idle_search: 0,
            ring_margin: margin,
            rings: rings,
            finished: Deque<(i32, i32, Chunk, ChunkRest)>(),
            problems: List<String>(),
        }
    }

    /// Sets the world's bottom and height, which are the Overworld's until they're set, as
    /// `Worker.level` gives them.
    pub fn set_level(mut self, level: (i32, i32)) {
        let (min_y, height) = level
        self.level_min = min_y
        self.level_height = height
    }

    /// Asks for the chunk at `x`, `z` finished, with every job it needs.
    pub fn want(mut self, x: i32, z: i32) {
        _ = self.need(node(FINISH, x, z))
    }

    /// Withdraws the chunk at `x`, `z`, which nothing asks for any more (D243): its finishing,
    /// and each job it needed that nothing still asked for needs, are dropped, unless they're out
    /// or done. What's out comes back and is kept as before, and what's done stays, until the
    /// scheduler starts again. Asked for again, the jobs dropped are made again.
    pub fn unwant(mut self, x: i32, z: i32) {
        self.drop_node(node(FINISH, x, z))
    }

    // Drops the node if nothing waits for it and it's waiting or ready; then each node it needed
    // has it waiting no more, and goes too if nothing else waits for it. A ready node dropped
    // stays in its queue, and `next` passes over it.
    fn drop_node(mut self, n: i64) {
        if not self.nodes.contains(n) {
            return
        }
        let state = self.nodes[n].state
        if state == RUNNING or state == DONE or not self.nodes[n].dependents.is_empty() {
            return
        }
        _ = self.nodes.remove(n)
        if kind_of(n) == FINISH {
            _ = self.refs.remove(chunk_key(x_of(n), z_of(n)))
        }
        if kind_of(n) == STARTS {
            for k in 0..self.search_waiting.len() {
                without(mut self.search_waiting[k], n)
            }
        }
        let deps = self.needs(n)
        for d in deps {
            if self.nodes.contains(d) {
                without(mut self.nodes[d].dependents, n)
                self.drop_node(d)
            }
        }
    }

    /// How many jobs there are, waiting, ready, out or done.
    pub fn jobs(self) -> usize {
        return self.nodes.len()
    }

    /// Whether the chunk at `x`, `z` is finished.
    pub fn is_finished(self, x: i32, z: i32) -> bool {
        let n = node(FINISH, x, z)
        return self.nodes.contains(n) and self.nodes[n].state == DONE
    }

    /// How many jobs are out.
    pub fn running(self) -> usize {
        return self.out
    }

    /// How many jobs are ready to go out.
    pub fn ready(self) -> usize {
        var n: usize = 0
        for k in 0..JOBS {
            n += self.queues[k].len()
        }
        return n
    }

    /// How many chunks' terrain is kept, to be decorated around and finished.
    pub fn kept(self) -> usize {
        return self.protos.len()
    }

    /// Whether it keeps anything but what its ring searches found: jobs to do, or what jobs made.
    pub fn holds_any(self) -> bool {
        return not self.nodes.is_empty() or not self.protos.is_empty() or not self.starts.chunks.is_empty() or not self.biomes.is_empty() or not self.saved.is_empty()
    }

    /// How many of each thing it keeps, for a look at what's using memory: nodes, starts,
    /// biomes, references, terrain, what's been looked at and what was saved.
    pub fn counts(self) -> String {
        return "nodes {self.nodes.len()} starts {self.starts.chunks.len()} biomes {self.biomes.len()} refs {self.refs.len()} protos {self.protos.len()} finished {self.finished.len()} seeds {self.seeds.len()} saved {self.saved.len()}"
    }

    /// How many chunks' terrain is kept outside `cells`, squares of chunks `1 << shift` a side,
    /// each by `chunk_key` of its place in squares.
    pub fn kept_outside(self, cells: Map<i64, u32>, shift: i32) -> usize {
        var n: usize = 0
        for (k, _) in self.protos {
            if not cells.contains(chunk_key(i32.wrap(k) >> shift, i32.wrap(k >> 32) >> shift)) {
                n += 1
            }
        }
        return n
    }

    /// A scheduler for the same structures with nothing made, but the strongholds' ring
    /// positions this one found, whose searches it doesn't make again. As a chunk is a pure
    /// function of where it is, what it makes is what this one would have (D220).
    pub fn renewed(own self) -> Scheduler {
        let Scheduler { structures: structures, all_searches: all, search_done: done, rings: rings, level_min: min_y, level_height: height, .. } = self
        var fresh = Scheduler.new(structures, all)
        fresh.set_level((min_y, height))
        for k in 0..done.len() {
            if done[k] {
                fresh.search_done[k] = true
                fresh.searches[k] = none
            }
        }
        fresh.rings = rings
        return fresh
    }

    /// The most urgent job that's ready, which is out until what it made is taken.
    /// A ring search some starts wait for goes out first; the others only once nothing else is
    /// ready, as the chunks near the origin never meet a ring.
    pub fn next(mut self) -> Job? {
        while let k = self.urgent.pop_first() {
            if let r = self.searches[k].take() {
                self.out += 1
                return some(Job.Ring(r))
            }
        }
        for k in 0..JOBS {
            while let n = self.queues[k].pop_first() {
                // One dropped while it was ready isn't there, or is there again, and queued
                // again, if it was asked for again (D243).
                if not self.nodes.contains(n) or self.nodes[n].state != READY {
                    continue
                }
                self.nodes[n].state = RUNNING
                self.out += 1
                return some(self.job(n))
            }
        }
        while self.idle_search < self.searches.len() {
            let k = self.idle_search
            self.idle_search += 1
            if let r = self.searches[k].take() {
                self.out += 1
                return some(Job.Ring(r))
            }
        }
        return none
    }

    /// The next chunk to look at what's saved of, which the caller finds and hands to `peeked`
    /// (D334), or none if no look is waiting.
    pub fn next_peek(mut self) -> (i32, i32)? {
        let q = usize.wrap(PEEK)
        while let n = self.queues[q].pop_first() {
            if not self.nodes.contains(n) or self.nodes[n].state != READY {
                continue
            }
            self.nodes[n].state = RUNNING
            return some((x_of(n), z_of(n)))
        }
        return none
    }

    /// Takes in what's saved of the chunk at `x`, `z`, as a look found it (D334). What's known of
    /// a chunk stays as it was first found, so what each node needs only grows: another look,
    /// such as one a scheduler before this one asked for, changes nothing.
    pub fn peeked(mut self, x: i32, z: i32, saved: own Saved) {
        let key = chunk_key(x, z)
        if self.seeds.contains(key) {
            return
        }
        var seed = SAVED_NOTHING
        match saved {
            Saved.Nothing => {},
            Saved.Terrain(d) => {
                self.saved.insert(key, d)
                seed = SAVED_TERRAIN
            },
            Saved.Decorated(d) => {
                self.saved.insert(key, d)
                seed = SAVED_DECORATED
            },
            Saved.Full => seed = SAVED_FULL,
        }
        self.seeds.insert(key, seed)
        let n = node(PEEK, x, z)
        if self.nodes.contains(n) and self.nodes[n].state != DONE {
            self.complete(n)
        }
    }

    /// A terrain job that's ready for a chunk next to the one at `x`, `z`, along a side or across
    /// a corner, taken ahead of its turn; none if there's none. A chunk's terrain is the same
    /// whenever it's made, so neighbours can go to one worker together, which then works out
    /// once what they share (D298). Its place in the queue is passed over later, as one taken.
    pub fn ready_terrain_near(mut self, x: i32, z: i32) -> Job? {
        let dxs: [i32; 8] = [1, 0, -1, 0, 1, -1, 1, -1]
        let dzs: [i32; 8] = [0, 1, 0, -1, 1, 1, -1, -1]
        for d in 0..8usize {
            let n = node(TERRAIN, x + dxs[d], z + dzs[d])
            if self.nodes.contains(n) and self.nodes[n].state == READY {
                self.nodes[n].state = RUNNING
                self.out += 1
                return some(self.job(n))
            }
        }
        return none
    }

    /// Takes in what a job made. A finished chunk is kept to be taken with `take_finished`.
    pub fn take(mut self, made: own Made) {
        match made {
            Made.Ring(set, index, cx, cz, problems) => {
                for i in 0..self.rings.sets.len() {
                    if self.rings.sets[i] == set {
                        self.rings.lists[i][index] = (cx, cz)
                    }
                }
                self.noted(problems)
                self.out -= 1
                for k in 0..self.search_keys.len() {
                    if self.search_keys[k] == (set, index) {
                        self.search_done[k] = true
                        let waiting = self.search_waiting[k].copy()
                        self.search_waiting[k].clear()
                        for n in waiting {
                            self.ready_one(n)
                        }
                    }
                }
            },
            Made.Starts(bx, bz, lists, problems) => {
                var rest = lists
                for z in bz << BLOCK_SHIFT..(bz + 1) << BLOCK_SHIFT {
                    for x in bx << BLOCK_SHIFT..(bx + 1) << BLOCK_SHIFT {
                        self.starts.chunks.insert(chunk_key(x, z), rest.remove(0))
                    }
                }
                self.noted(problems)
                self.done(node(STARTS, bx, bz))
            },
            Made.Biomes(bx, bz, lists, problems) => {
                var rest = lists
                for z in bz << BLOCK_SHIFT..(bz + 1) << BLOCK_SHIFT {
                    for x in bx << BLOCK_SHIFT..(bx + 1) << BLOCK_SHIFT {
                        self.biomes.insert(chunk_key(x, z), rest.remove(0))
                    }
                }
                self.noted(problems)
                self.done(node(BIOMES, bx, bz))
            },
            Made.Terrain(x, z, terrain, problems) => {
                self.protos.insert(chunk_key(x, z), terrain)
                self.noted(problems)
                self.done(node(TERRAIN, x, z))
            },
            Made.Decorated(job, problems) => {
                let DecorateJob { x: x, z: z, chunks: chunks, starts: starts, refs: refs, .. } = job
                // Its references, which its finishing saves, if it's to be finished (D288).
                if self.nodes.contains(node(FINISH, x, z)) {
                    self.refs.insert(chunk_key(x, z), refs)
                }
                var rest = chunks
                for dz in -1..2 {
                    for dx in -1..2 {
                        self.protos.insert(chunk_key(x + dx, z + dz), rest.remove(0))
                    }
                }
                self.merge(x, z, starts)
                self.noted(problems)
                self.done(node(DECORATE, x, z))
            },
            Made.Finished(x, z, chunk, rest) => {
                self.finished.push_last((x, z, chunk, rest))
                self.done(node(FINISH, x, z))
            },
        }
    }

    /// Takes in that the chunk at `x`, `z` was finished, as a thread that made the server's chunk
    /// of it and kept it says.
    pub fn finished_at(mut self, x: i32, z: i32) {
        self.done(node(FINISH, x, z))
    }

    /// The next chunk finished, by `take`, with where it is.
    pub fn take_finished(mut self) -> (i32, i32, Chunk, ChunkRest)? {
        return self.finished.pop_first()
    }

    // Makes the node, unless it's made, waiting for the nodes it needs; whether it's done. A look
    // at a chunk already looked at is done at once (D334).
    fn need(mut self, n: i64) -> bool {
        if self.nodes.contains(n) {
            return self.nodes[n].state == DONE
        }
        self.nodes.insert(n, Node { missing: 0, state: WAITING, dependents: List<i64>() })
        if kind_of(n) == PEEK {
            if self.seeds.contains(chunk_key(x_of(n), z_of(n))) {
                self.nodes[n].state = DONE
                return true
            }
            self.nodes[n].state = READY
            self.queues[usize.wrap(PEEK)].push_last(n)
            return false
        }
        var searching: u32 = 0
        if kind_of(n) == STARTS {
            // The ring searches whose position its chunks, or the exclusion zones about them, can
            // meet; a position found elsewhere doesn't change them.
            let reach = self.ring_margin
            let x0 = (x_of(n) << BLOCK_SHIFT) - reach
            let x1 = ((x_of(n) + 1) << BLOCK_SHIFT) - 1 + reach
            let z0 = (z_of(n) << BLOCK_SHIFT) - reach
            let z1 = ((z_of(n) + 1) << BLOCK_SHIFT) - 1 + reach
            for k in 0..self.search_origins.len() {
                let (ox, oz) = self.search_origins[k]
                if not self.search_done[k] and ox + RING_REACH >= x0 and ox - RING_REACH <= x1 and oz + RING_REACH >= z0 and oz - RING_REACH <= z1 {
                    searching += 1
                    self.search_waiting[k].push(n)
                    if not self.search_urgent[k] {
                        self.search_urgent[k] = true
                        self.urgent.push_last(k)
                    }
                }
            }
        }
        if searching > 0 {
            self.nodes[n].missing = searching
            return false
        }
        return self.expand(n)
    }

    // Works out what the node needs, as far as what's been looked at says, and waits for what of
    // it isn't done. With nothing to wait for it's ready, or, with no job to do, done (D334).
    // Whether it's done.
    fn expand(mut self, n: i64) -> bool {
        var missing: u32 = 0
        let deps = self.needs(n)
        for d in deps {
            if not self.need(d) {
                missing += 1
                self.nodes[d].dependents.push(n)
            }
        }
        self.nodes[n].missing = missing
        if missing > 0 {
            return false
        }
        if self.nothing_to_do(n) {
            self.complete(n)
            return true
        }
        self.nodes[n].state = READY
        self.queues[usize.wrap(kind_of(n))].push_last(n)
        return false
    }

    // Whether the node, with what it needs done, has no job to do (D334): the decoration of a
    // chunk saved decorated, or of a full one decorated already, as `beside_decorated` says.
    fn nothing_to_do(self, n: i64) -> bool {
        if kind_of(n) != DECORATE {
            return false
        }
        let seed = self.seeds.get(chunk_key(x_of(n), z_of(n))) ?? SAVED_NOTHING
        return seed == SAVED_DECORATED or (seed == SAVED_FULL and self.beside_decorated(x_of(n), z_of(n)) == some(true))
    }

    // Whether the full chunk at `x`, `z` is decorated already, for what's saved around it: each of
    // the eight around it saved decorated or full, and one at least decorated, as around each
    // full chunk vanilla saves, whose neighbours have what its features put in them (D334). Not,
    // where one isn't saved, as around a chunk Calcite finished. `none` while it can't be told,
    // as one of the eight hasn't been looked at.
    fn beside_decorated(self, x: i32, z: i32) -> bool? {
        var decorated = false
        for dz in -1..2 {
            for dx in -1..2 {
                if dx == 0 and dz == 0 {
                    continue
                }
                let seed = self.seeds.get(chunk_key(x + dx, z + dz)) else return none
                if seed == SAVED_DECORATED {
                    decorated = true
                } else if seed != SAVED_FULL {
                    return some(false)
                }
            }
        }
        return some(decorated)
    }

    // The node is done: each that waits for it needs one fewer, and what it needs is worked out
    // again with none.
    fn complete(mut self, n: i64) {
        self.nodes[n].state = DONE
        let waiting = self.nodes[n].dependents.copy()
        self.nodes[n].dependents = List<i64>()
        for d in waiting {
            self.ready_one(d)
        }
    }

    // A job's node is done, and it's no longer out.
    fn done(mut self, n: i64) {
        self.out -= 1
        self.complete(n)
    }

    // One fewer of what the node needs isn't done; with none, what it needs is worked out again.
    fn ready_one(mut self, n: i64) {
        self.nodes[n].missing -= 1
        if self.nodes[n].missing == 0 {
            _ = self.expand(n)
        }
    }

    fn noted(mut self, problems: own List<String>) {
        for p in problems {
            self.problems.push(p.copy())
        }
    }

    // The node's job, with what it's made from, moved out where nothing after it needs it.
    fn job(mut self, n: i64) -> Job {
        let kind = kind_of(n)
        let x = x_of(n)
        let z = z_of(n)
        if kind == STARTS {
            return Job.Starts(x, z, self.rings.copy())
        }
        if kind == BIOMES {
            return Job.Biomes(x, z)
        }
        if kind == TERRAIN {
            // One whose terrain was saved is read from what was (D334).
            if let data = self.saved.remove(chunk_key(x, z)) {
                return Job.Terrain(TerrainJob { x: x, z: z, beard: none, biomes: List<List<i32>>(), saved: some(data) })
            }
            let refs = self.refs_of(x, z)
            let beard: Beardifier? = beardifier_for(self.structures, self.starts, refs, x, z, List<f32>())
            return Job.Terrain(TerrainJob { x: x, z: z, beard: beard, biomes: self.around(x, z) })
        }
        if kind == DECORATE {
            var chunks = List<RegionChunk>()
            for dz in -1..2 {
                for dx in -1..2 {
                    // Each is there: its terrain is done, and nothing else has it out, as every
                    // decoration it's in is 2 or less from this one.
                    let c = self.protos.remove(chunk_key(x + dx, z + dz)) else panic("chunk {x + dx}, {z + dz} has no terrain to decorate with")
                    chunks.push(c)
                }
            }
            // Its terrain is made, and only its decoration reads its references after.
            let refs = self.refs.remove(chunk_key(x, z)) ?? self.refs_of(x, z)
            var starts = StartMap.new()
            for r in refs {
                for key in r.chunks.values() {
                    if not starts.chunks.contains(key) and self.starts.chunks.contains(key) {
                        starts.chunks.insert(key, self.starts.chunks[key].copy())
                    }
                }
            }
            return Job.Decorate(DecorateJob { x: x, z: z, chunks: chunks, biomes: self.around(x, z), refs: refs, starts: starts })
        }
        // Finishing: everything 1 or less from it is decorated, so nothing reads its terrain or
        // its biomes again.
        let key = chunk_key(x, z)
        let made = self.protos.remove(key) else panic("chunk {x}, {z} has no terrain to finish")
        let biomes = self.biomes.remove(key) else panic("chunk {x}, {z} has no biomes to finish with")
        let refs = self.refs.remove(key) ?? create_references(self.structures, self.starts, x, z)
        let starts = if self.starts.chunks.contains(key) { self.starts.chunks[key].copy() } else { List<Start>() }
        return Job.Finish(FinishJob { x: x, z: z, made: made, biomes: biomes, refs: refs, starts: starts })
    }

    // The nodes the node needs, as far as what's been looked at says (D334): a chunk's terrain
    // and its decoration first need a look at what's saved of it, and a full chunk's decoration a
    // look at the eight around it. What's known only grows, so what a node needs only does, and
    // it's worked out again once all it needed is done.
    fn needs(self, n: i64) -> List<i64> {
        let kind = kind_of(n)
        let x = x_of(n)
        let z = z_of(n)
        var out = List<i64>()
        if kind == TERRAIN {
            out.push(node(PEEK, x, z))
            if not self.seeds.contains(chunk_key(x, z)) {
                return out
            }
            // The starts within 8, and the biomes 1 or less away, by block, which a terrain read
            // from a save needs too: its references are made from the starts, and the
            // decorations around it read its biomes.
            for bz in (z - 8) >> BLOCK_SHIFT..((z + 8) >> BLOCK_SHIFT) + 1 {
                for bx in (x - 8) >> BLOCK_SHIFT..((x + 8) >> BLOCK_SHIFT) + 1 {
                    out.push(node(STARTS, bx, bz))
                }
            }
            for bz in (z - 1) >> BLOCK_SHIFT..((z + 1) >> BLOCK_SHIFT) + 1 {
                for bx in (x - 1) >> BLOCK_SHIFT..((x + 1) >> BLOCK_SHIFT) + 1 {
                    out.push(node(BIOMES, bx, bz))
                }
            }
        } else if kind == DECORATE {
            out.push(node(PEEK, x, z))
            let seed = self.seeds.get(chunk_key(x, z)) else return out
            if seed == SAVED_DECORATED {
                // Decorated already: its terrain is read from what was saved, and nothing else.
                out.push(node(TERRAIN, x, z))
                return out
            }
            // A look at each chunk 2 or less from it, which says whether a full one is decorated
            // already, and which of the decorations there go first.
            var known = true
            for dz in -2..3 {
                for dx in -2..3 {
                    if dx != 0 or dz != 0 {
                        out.push(node(PEEK, x + dx, z + dz))
                        known = known and self.seeds.contains(chunk_key(x + dx, z + dz))
                    }
                }
            }
            if seed == SAVED_FULL {
                match self.beside_decorated(x, z) {
                    some(false) => {},
                    _ => return out,
                }
            }
            if not known {
                return out
            }
            let order = self.order_of(x, z)
            for dz in -2..3 {
                for dx in -2..3 {
                    if self.order_of(x + dx, z + dz) < order {
                        out.push(node(DECORATE, x + dx, z + dz))
                    }
                }
            }
            for dz in -1..2 {
                for dx in -1..2 {
                    out.push(node(TERRAIN, x + dx, z + dz))
                }
            }
        } else if kind == FINISH {
            for dz in -1..2 {
                for dx in -1..2 {
                    out.push(node(DECORATE, x + dx, z + dz))
                }
            }
            // Its terrain, which the decorations it needs have made, but where it's a full
            // chunk decorated already, which only a chunk saved since it was asked for is.
            out.push(node(TERRAIN, x, z))
        }
        return out
    }

    // Where the decoration of the chunk at `x`, `z` goes among those 2 or less from it, the lower
    // first, as what's saved of it says (D334): a chunk saved with its terrain before any other,
    // as vanilla goes on from those before it makes the chunks past them, then by rank (D214). Of
    // two chunks 2 or less apart, one always goes first, as their ranks differ.
    fn order_of(self, x: i32, z: i32) -> i32 {
        let first = self.seeds.get(chunk_key(x, z)) == some(SAVED_TERRAIN)
        return rank_of(x, z) + if first { 0 } else { 9 }
    }

    // The chunk's references to the structures started within 8 of it, whose starts are all made.
    fn refs_of(mut self, x: i32, z: i32) -> List<Refs> {
        let key = chunk_key(x, z)
        if self.refs.contains(key) {
            return self.refs[key].copy()
        }
        let made = create_references(self.structures, self.starts, x, z)
        self.refs.insert(key, made.copy())
        return made
    }

    // The biomes of the chunk and the eight around it, from the lower corner, `x` fastest.
    fn around(self, x: i32, z: i32) -> List<List<i32>> {
        var out = List<List<i32>>()
        for dz in -1..2 {
            for dx in -1..2 {
                out.push(self.biomes[chunk_key(x + dx, z + dz)].copy())
            }
        }
        return out
    }

    // Takes back the pieces a decoration of the chunk at `x`, `z` may have changed: those that
    // reach its writable area, as `place_in_chunk` places them.
    fn merge(mut self, x: i32, z: i32, back: own StartMap) {
        let x0 = x << 4
        let z0 = z << 4
        let low = self.level_min + 1
        let high = self.level_min + self.level_height - 1
        var given = back
        var keys = List<i64>()
        for (k, _) in given.chunks {
            keys.push(k)
        }
        for k in keys {
            let list = given.chunks.remove(k) else continue
            if not self.starts.chunks.contains(k) {
                continue
            }
            for s in 0..list.len() {
                for i in 0..list[s].pieces.len() {
                    let b = self.starts.chunks[k][s].pieces[i].bb
                    if b.max_x >= x0 and b.min_x <= x0 + 15 and b.max_z >= z0 and b.min_z <= z0 + 15 and b.max_y >= low and b.min_y <= high {
                        self.starts.chunks[k][s].pieces[i] = list[s].pieces[i].copy()
                    }
                }
            }
        }
    }
}

/// The scheduler for a world as `setup` says, from vanilla's data in `zip`, made without a
/// worker.
pub fn scheduler_for(zip: Data, setup: GenSetup) -> Scheduler ! String {
    let structures = try Structures.read(zip, setup.biomes)
    let source = try source_of(zip, setup)
    let state = StructureState.new(structures, source.possible(), setup.seed)
    let searches = state.ring_searches(structures)
    var s = Scheduler.new(structures, searches)
    s.set_level((setup.min_y, setup.height))
    return s
}

// Takes `n` out of `list`, where it is, keeping the rest in order.
fn without(list: mut List<i64>, n: i64) {
    var i: usize = 0
    while i < list.len() {
        if list[i] == n {
            _ = list.remove(i)
            return
        }
        i += 1
    }
}


/// The Overworld's generator, making chunks on the thread it's on, a job at a time, and keeping
/// each it finishes.
pub struct Generator {
    worker: Worker
    s: Scheduler
    finished: Map<i64, (Chunk, ChunkRest)>
    // What's saved of each chunk, as `give` has it, for a look to find: nothing where it has
    // none, as this thread reads no save (D334).
    given: Map<i64, Saved>
    /// What went wrong making chunks, to be logged, oldest first.
    pub problems: List<String>
}

impl Generator {
    /// The generator `setup` says, from vanilla's data in `zip`.
    pub fn new(zip: own Data, setup: GenSetup) -> Generator ! String {
        let worker = try Worker.new(zip, setup)
        var s = Scheduler.new(worker.structures(), worker.ring_searches())
        s.set_level(worker.level())
        return Generator { worker: worker, s: s, finished: Map<i64, (Chunk, ChunkRest)>(), given: Map<i64, Saved>(), problems: List<String>() }
    }

    /// Has a look at what's saved of the chunk at `x`, `z` find `saved` (D334).
    pub fn give(mut self, x: i32, z: i32, saved: own Saved) {
        self.given.insert(chunk_key(x, z), saved)
    }

    /// The block states' table the chunks are made with.
    pub fn table(self) -> BlockStates {
        return self.worker.table()
    }

    /// `NoiseBasedChunkGenerator.getOrigin`, as `Worker.origin`.
    pub fn origin(self) -> (i32, i32) ! Thrown {
        return try self.worker.origin()
    }

    /// The chunk at `x`, `z` finished, as the server's chunk, with the rest of what it saves.
    pub fn full(mut self, x: i32, z: i32) -> (Chunk, ChunkRest) ! Thrown {
        let key = chunk_key(x, z)
        if not self.finished.contains(key) {
            self.s.want(x, z)
            while not self.s.is_finished(x, z) {
                if let at = self.s.next_peek() {
                    let (px, pz) = at
                    self.s.peeked(px, pz, self.given.remove(chunk_key(px, pz)) ?? Saved.Nothing)
                    continue
                }
                let job = self.s.next() else fail Thrown { exception: "IllegalStateException", message: "chunk {x}, {z} can't be finished" }
                self.s.take(self.worker.run(job))
            }
            while let (fx, fz, chunk, rest) = self.s.take_finished() {
                self.finished.insert(chunk_key(fx, fz), (chunk, rest))
            }
            for p in self.s.problems {
                self.problems.push(p.copy())
            }
            self.s.problems.clear()
        }
        return self.finished[key].copy()
    }
}
