/// Structure pieces and starts as vanilla holds and saves them: `StructurePiece` with its box,
/// orientation and depth, the fields each kind of piece adds, and `StructureStart.createTag`,
/// the compound a chunk's `structures.starts` saves.
module worldgen.pieces

import nbt.tag.{Tag}
import random.source.{RandomSource}
import worldgen.facts.{EAST, NORTH, SOUTH, WEST}
import worldgen.template.{Bounds}

/// A piece of a structure.
pub struct Piece {
    /// Its type's ID in `structure_piece`, as `minecraft:tedp`.
    pub kind: String
    pub bb: Bounds
    /// The direction it faces, or -1 for none.
    pub orientation: i32
    pub gen_depth: i32
    pub data: PieceData
}

/// What a kind of piece adds to `StructurePiece`.
pub enum PieceData {
    Plain
    /// `ScatteredFeaturePiece`: its size, the height it settled at, -1 until it settles, and its
    /// own flags by name, in the order it saves them.
    Scattered { width: i32, height: i32, depth: i32, hpos: i32, flags: List<Flag> }
    Template(TemplatePiece)
}

/// A flag a piece saves.
pub struct Flag {
    pub name: String
    pub value: bool
}

/// `TemplateStructurePiece`: the template, where it's placed from, turned and mirrored about its
/// pivot, and what its kind adds.
pub struct TemplatePiece {
    pub name: String
    pub template: usize
    pub x: i32
    pub y: i32
    pub z: i32
    pub rotation: i32
    pub mirror: i32
    pub pivot_x: i32
    pub pivot_y: i32
    pub pivot_z: i32
    pub kind: TemplateKind
}

/// What each kind of template piece adds.
pub enum TemplateKind {
    Igloo
    Shipwreck { beached: bool, adjusted: bool }
    OceanRuin { integrity: f32, cold: bool, large: bool }
    NetherFossil
    RuinedPortal { placement: i32, props: PortalProperties }
}

/// `RuinedPortalPiece.Properties`.
pub struct PortalProperties {
    pub cold: bool
    pub mossiness: f32
    pub air_pocket: bool
    pub overgrown: bool
    pub vines: bool
    pub blackstone: bool
}

/// `RuinedPortalPiece.VerticalPlacement`, in its order, by its serialized names.
pub fn portal_placements() -> List<str> {
    return ["on_land_surface", "partly_buried", "on_ocean_floor", "in_mountain", "underground", "in_nether"]
}
pub const ON_LAND_SURFACE: i32 = 0
pub const PARTLY_BURIED: i32 = 1
pub const ON_OCEAN_FLOOR: i32 = 2
pub const IN_MOUNTAIN: i32 = 3
pub const UNDERGROUND: i32 = 4
pub const IN_NETHER: i32 = 5

/// `Rotation` and `Mirror` by their enum names, as `LEGACY_CODEC` writes them.
fn rotation_names() -> List<str> {
    return ["NONE", "CLOCKWISE_90", "CLOCKWISE_180", "COUNTERCLOCKWISE_90"]
}
fn mirror_names() -> List<str> {
    return ["NONE", "LEFT_RIGHT", "FRONT_BACK"]
}

/// A structure start: the structure, by ID, its chunk, how many chunks reference it, and its
/// pieces.
pub struct Start {
    pub id: String
    pub chunk_x: i32
    pub chunk_z: i32
    pub references: i32
    pub pieces: List<Piece>
}

impl Start {
    /// `StructureStart.createTag` of a valid start.
    pub fn tag(self) -> Tag {
        var tag = JavaHashMap<String, Tag>()
        tag.insert("id", Tag.Str(self.id.copy()))
        tag.insert("ChunkX", Tag.Int(self.chunk_x))
        tag.insert("ChunkZ", Tag.Int(self.chunk_z))
        tag.insert("references", Tag.Int(self.references))
        var children = List<Tag>()
        for p in self.pieces {
            children.push(p.tag())
        }
        tag.insert("Children", Tag.List(children))
        return Tag.Compound(tag)
    }
}

impl Piece {
    /// `StructurePiece.createTag`.
    pub fn tag(self) -> Tag {
        var tag = JavaHashMap<String, Tag>()
        tag.insert("id", Tag.Str(self.kind.copy()))
        let b = self.bb
        tag.insert("BB", Tag.IntArray([b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z]))
        tag.insert("O", Tag.Int(if self.orientation < 0 { -1 } else { data_2d(self.orientation) }))
        tag.insert("GD", Tag.Int(self.gen_depth))
        match self.data {
            PieceData.Plain => {},
            PieceData.Scattered { width, height, depth, hpos, flags } => {
                tag.insert("Width", Tag.Int(width))
                tag.insert("Height", Tag.Int(height))
                tag.insert("Depth", Tag.Int(depth))
                tag.insert("HPos", Tag.Int(hpos))
                for f in flags {
                    tag.insert(f.name.copy(), flag(f.value))
                }
            },
            PieceData.Template(t) => {
                tag.insert("TPX", Tag.Int(t.x))
                tag.insert("TPY", Tag.Int(t.y))
                tag.insert("TPZ", Tag.Int(t.z))
                tag.insert("Template", Tag.Str(t.name.copy()))
                let rot = Tag.Str(String(rotation_names()[usize.wrap(t.rotation)]))
                match t.kind {
                    TemplateKind.Igloo => tag.insert("Rot", rot),
                    TemplateKind.NetherFossil => tag.insert("Rot", rot),
                    TemplateKind.Shipwreck { beached, adjusted } => {
                        tag.insert("isBeached", flag(beached))
                        tag.insert("Rot", rot)
                        tag.insert("height_adjusted", flag(adjusted))
                    },
                    TemplateKind.OceanRuin { integrity, cold, large } => {
                        tag.insert("Rot", rot)
                        tag.insert("Integrity", Tag.Float(integrity))
                        tag.insert("BiomeType", Tag.Str(String(if cold { "COLD" } else { "WARM" })))
                        tag.insert("IsLarge", flag(large))
                    },
                    TemplateKind.RuinedPortal { placement, props } => {
                        tag.insert("Rotation", rot)
                        tag.insert("Mirror", Tag.Str(String(mirror_names()[usize.wrap(t.mirror)])))
                        tag.insert("VerticalPlacement", Tag.Str(String(portal_placements()[usize.wrap(placement)])))
                        var p = JavaHashMap<String, Tag>()
                        p.insert("cold", flag(props.cold))
                        p.insert("mossiness", Tag.Float(props.mossiness))
                        p.insert("air_pocket", flag(props.air_pocket))
                        p.insert("overgrown", flag(props.overgrown))
                        p.insert("vines", flag(props.vines))
                        p.insert("replace_with_blackstone", flag(props.blackstone))
                        tag.insert("Properties", Tag.Compound(p))
                    },
                }
            },
        }
        return Tag.Compound(tag)
    }
}

// A boolean as a byte, as `putBoolean` and `NbtOps` write it.
fn flag(v: bool) -> Tag {
    return Tag.Byte(if v { 1i8 } else { 0i8 })
}

/// `Direction.get2DDataValue` of a horizontal direction: south, west, north, east.
pub fn data_2d(d: i32) -> i32 {
    return match d {
        3 => 0,
        4 => 1,
        2 => 2,
        _ => 3,
    }
}

/// `Direction.Plane.HORIZONTAL.getRandomDirection`: north, east, south or west.
pub fn random_horizontal<T: RandomSource>(r: mut T) -> i32 {
    let faces: List<i32> = [NORTH, EAST, SOUTH, WEST]
    return faces[usize.wrap(r.next_int_below(4))]
}

/// `StructurePiece.makeBoundingBox`: `width` across the direction, `depth` along it.
pub fn make_box(x: i32, y: i32, z: i32, d: i32, width: i32, height: i32, depth: i32) -> Bounds {
    if d == NORTH or d == SOUTH {
        return Bounds { min_x: x, min_y: y, min_z: z, max_x: x + width - 1, max_y: y + height - 1, max_z: z + depth - 1 }
    }
    return Bounds { min_x: x, min_y: y, min_z: z, max_x: x + depth - 1, max_y: y + height - 1, max_z: z + width - 1 }
}

/// A `ScatteredFeaturePiece` of the type, at its corner, facing `d`, with its flags unset.
pub fn scattered(kind: str, x: i32, y: i32, z: i32, width: i32, height: i32, depth: i32, d: i32, flags: List<str>) -> Piece {
    var fs = List<Flag>()
    for name in flags {
        fs.push(Flag { name: String(name), value: false })
    }
    let data = PieceData.Scattered { width: width, height: height, depth: depth, hpos: -1, flags: fs }
    return Piece { kind: String(kind), bb: make_box(x, y, z, d, width, height, depth), orientation: d, gen_depth: 0, data: data }
}
