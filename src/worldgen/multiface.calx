/// Blocks with a face on each side they cling to (glow lichen, sculk veins, resin): where one
/// may be placed, and `MultifaceSpreader`, which spreads one from a face to the faces around it,
/// with the sculk vein's own rules for what it may replace.
module worldgen.multiface

import random.source.{RandomSource}
import worldgen.facts.{EMPTY_FLUID, FULL, Facts, WATER_FLUID, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.region.{Region}
import worldgen.survive.{attaches_state, direction_property}

/// `Util.shuffle`: from the end, each element swapped with one at `nextInt` of its index and
/// one.
pub fn shuffle<T: RandomSource>(xs: mut List<i32>, rand: mut T) {
    var i = xs.len()
    while i > 1 {
        let j = usize.wrap(rand.next_int_below(i32.wrap(i)))
        xs.swap(i - 1, j)
        i -= 1
    }
}

/// `Direction.allShuffled`: the six directions in their order, shuffled.
pub fn all_shuffled<T: RandomSource>(rand: mut T) -> List<i32> {
    var ds: List<i32> = [0, 1, 2, 3, 4, 5]
    shuffle(mut ds, mut rand)
    return ds
}

/// `MultifaceBlock.isValidStateForPlacement`: the block has the face, `old` isn't the block with
/// it already, and the neighbour that way can be attached to.
pub fn multiface_valid(f: Facts, r: Region, block: u32, old: u32, x: i32, y: i32, z: i32, d: i32) -> bool ! Thrown {
    let name = direction_property(d)
    if not f.has(f.default_state(block), name) {
        return false
    }
    if f.is(old, block) and f.get_bool(old, name) {
        return false
    }
    return attaches_state(f, try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d)), d)
}

/// `MultifaceBlock.getStateForPlacement` of `old` at the position, given the face toward `d`: the
/// block as it is, or its default state, waterlogged in source water, with that face added.
pub fn multiface_state(f: Facts, r: Region, block: u32, old: u32, x: i32, y: i32, z: i32, d: i32) -> u32? ! Thrown {
    if not try multiface_valid(f, r, block, old, x, y, z, d) {
        return none
    }
    var s = f.default_state(block)
    if f.is(old, block) {
        s = old
    } else if f.fluid(old) == WATER_FLUID {
        s = f.try_bool(s, "waterlogged", true)
    }
    return some(f.try_bool(s, direction_property(d), true))
}

// `MultifaceSpreader`'s `canSpreadInto` of the block's config: the state there may be replaced,
// and the face may be placed on it.
fn can_spread_into(f: Facts, r: Region, block: u32, sx: i32, sy: i32, sz: i32, x: i32, y: i32, z: i32, face: i32) -> bool ! Thrown {
    let existing = try r.state(f, x, y, z)
    var replaceable = f.is_air(existing) or f.is(existing, block) or (f.is(existing, f.ids.water) and f.is_source(existing))
    if f.is_a(block, "SculkVeinBlock") {
        // `SculkVeinSpreaderConfig.stateCanBeReplaced`.
        let against = try r.state(f, x + step_x(face), y + step_y(face), z + step_z(face))
        let ab = f.block(against)
        if ab == f.ids.sculk or ab == f.ids.sculk_catalyst or ab == f.ids.moving_piston {
            return false
        }
        let manhattan = (sx - x).abs() + (sy - y).abs() + (sz - z).abs()
        if manhattan == 2 {
            let back = opposite(face)
            let n = try r.state(f, sx + step_x(back), sy + step_y(back), sz + step_z(back))
            if f.sturdy(n, face, FULL) {
                return false
            }
        }
        let fluid = f.fluid(existing)
        if fluid != EMPTY_FLUID and fluid != WATER_FLUID {
            return false
        }
        if f.in_set(existing, f.tag("minecraft:fire")) {
            return false
        }
        replaceable = f.replaceable(existing) or replaceable
    }
    return replaceable and try multiface_valid(f, r, block, existing, x, y, z, face)
}


// A direction's axis: 0 for `y`, 1 for `z`, 2 for `x`.
fn face_axis(d: i32) -> i32 {
    return d >> 1
}

// Whether the state can be spread from its face `from`: the sculk vein's spreader spreads from
// any block but a vein, and others from a face the state has.
fn can_spread_from(f: Facts, block: u32, state: u32, from: i32) -> bool {
    if f.is_a(block, "SculkVeinBlock") and not f.is(state, f.ids.sculk_vein) {
        return true
    }
    return f.get_bool(state, direction_property(from))
}

/// `MultifaceSpreader.spreadFromFaceTowardDirection`: the first of the spread types, or only
/// `SAME_POSITION` when `same_only`, that the block can spread into from the state's face
/// `from` toward `d`, and the face placed there. Whether it was.
pub fn spread_toward(f: Facts, r: mut Region, block: u32, state: u32, x: i32, y: i32, z: i32, from: i32, d: i32, same_only: bool, post_process: bool) -> bool ! Thrown {
    if face_axis(d) == face_axis(from) {
        return false
    }
    // `isOtherBlockValidAsSource`, or the face and not the one toward `d`.
    let other = f.is_a(block, "SculkVeinBlock") and not f.is(state, f.ids.sculk_vein)
    if not other and not (f.get_bool(state, direction_property(from)) and not f.get_bool(state, direction_property(d))) {
        return false
    }
    var px = x
    var py = y
    var pz = z
    var face = d
    if not try can_spread_into(f, r, block, x, y, z, x, y, z, d) {
        if same_only {
            return false
        }
        if try can_spread_into(f, r, block, x, y, z, x + step_x(d), y + step_y(d), z + step_z(d), from) {
            px = x + step_x(d)
            py = y + step_y(d)
            pz = z + step_z(d)
            face = from
        } else {
            let wx = x + step_x(d) + step_x(from)
            let wy = y + step_y(d) + step_y(from)
            let wz = z + step_z(d) + step_z(from)
            if not try can_spread_into(f, r, block, x, y, z, wx, wy, wz, opposite(d)) {
                return false
            }
            px = wx
            py = wy
            pz = wz
            face = opposite(d)
        }
    }
    // `spreadToFace`.
    let old = try r.state(f, px, py, pz)
    let s = try multiface_state(f, r, block, old, px, py, pz, face) else return false
    if post_process {
        r.mark(px, py, pz)
    }
    return r.set_block(f, px, py, pz, s, 2)
}

/// `MultifaceSpreader.spreadFromFaceTowardRandomDirection`: the six directions shuffled, and the
/// state spread from its face `from` toward the first that it can be.
pub fn spread_from_face<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, block: u32, state: u32, x: i32, y: i32, z: i32, from: i32, post_process: bool) ! Thrown {
    for d in all_shuffled(mut rand) {
        if try spread_toward(f, mut r, block, state, x, y, z, from, d, false, post_process) {
            return
        }
    }
}

/// `MultifaceSpreader.spreadAll`: from each face it can spread from, in order, toward every
/// direction; how many it spread to.
pub fn spread_all(f: Facts, r: mut Region, block: u32, state: u32, x: i32, y: i32, z: i32, same_only: bool, post_process: bool) -> i64 ! Thrown {
    var n: i64 = 0
    for from in 0..6 {
        if can_spread_from(f, block, state, from) {
            for d in 0..6 {
                if try spread_toward(f, mut r, block, state, x, y, z, from, d, same_only, post_process) {
                    n += 1
                }
            }
        }
    }
    return n
}
