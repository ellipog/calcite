/// The template pieces placed as their chunks are decorated: `TemplateStructurePiece.postProcess`
/// with what each kind adds. An igloo settles on the surface at its entrance and covers its
/// trapdoor when nothing's under it; a shipwreck settles once on the ocean floor or the beach; an
/// ocean ruin settles on the floor and gets its suspicious sand or gravel; a Nether fossil places
/// whole and maybe a dried ghast; a ruined portal places whole from the chunk its middle is in,
/// spreading netherrack and growing vines and leaves. Data markers then give chests their loot
/// and spawn drowned.
module worldgen.template_pieces

import random.legacy.{LegacyRandom}
import random.source.{RandomSource}
import nbt.tag.{Tag}
import world.chunk.{OCEAN_FLOOR_WG, WORLD_SURFACE_WG}
import worldgen.block_entities.{randomizable}
import worldgen.drawing.{UPDATE_ALL, UPDATE_CLIENTS, block_state, chest_at, facing, mob_draws, spawn_entity, spawn_mob}
import worldgen.facts.{BlockSet, EAST, Facts, NORTH, SOUTH, WEST, horizontal, opposite, direction_name, step_x, step_z}
import worldgen.interval.{Thrown}
import worldgen.pieces.{IN_NETHER, ON_LAND_SURFACE, ON_OCEAN_FLOOR, Piece, PieceData, PortalProperties, Start, TemplateKind, TemplatePiece}
import worldgen.predicates.{Rule}
import worldgen.providers.{IntProvider}
import worldgen.region.{Region}
import worldgen.structure_world.{StructureWorld}
import worldgen.survive.{Env}
import worldgen.template.{Bounds, Modifier, PosRule, Processor, ProcessorRule, Settings, Template, filter_blocks, parse_state, place_in_world, rotate_direction, transform}

/// `postProcess` of a template piece, by its kind. `area` is the chunk's writable area, which a
/// Nether fossil or a ruined portal grows to hold all of itself, for the start's pieces after it.
pub fn template_piece<T: RandomSource>(e: Env, w: StructureWorld, r: mut Region, random: mut T, piece: mut Piece, area: mut Bounds, ref_x: i32, ref_y: i32, ref_z: i32) ! Thrown {
    let tp = match piece.data {
        PieceData.Template(t) => t.copy(),
        _ => fail Thrown { exception: "Unimplemented", message: "placing a {piece.kind} piece" },
    }
    try place_kind(e, w.templates.list[tp.template].value, mut r, mut random, mut piece, mut area, tp, ref_x, ref_y, ref_z)
}

// The piece of its kind placed from its template.
fn place_kind<T: RandomSource>(e: Env, t: Template, r: mut Region, random: mut T, piece: mut Piece, area: mut Bounds, piece_data: own TemplatePiece, ref_x: i32, ref_y: i32, ref_z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    var tp = piece_data
    let structure_block = i32.wrap(try f.named_block(String("structure_block")))
    let air = i32.wrap(f.ids.air)
    match tp.kind {
        TemplateKind.Igloo => {
            let s = Settings { rotation: tp.rotation, pivot_x: tp.pivot_x, pivot_z: tp.pivot_z, waterlogging: false, processors: [Processor.Ignore(BlockSet.of([structure_block], f.block_count))] }
            let (ox, oz) = igloo_offset(tp.name)
            let (ex, _, ez) = transform(3 - ox, 0, -oz, s.mirror, s.rotation, s.pivot_x, s.pivot_z)
            let height = try r.get_height(f, WORLD_SURFACE_WG, tp.x + ex, tp.z + ez)
            let y = tp.y + height - 90 - 1
            try place_template(e, mut r, mut random, mut piece, t, tp, s, area, tp.x, y, tp.z, ref_x, ref_y, ref_z)
            if tp.name == "minecraft:igloo/top" {
                let (dx, dy, dz) = transform(3, 0, 5, s.mirror, s.rotation, s.pivot_x, s.pivot_z)
                let below = try r.state(f, tp.x + dx, y + dy - 1, tp.z + dz)
                if not f.is_air(below) and f.block(below) != try f.named_block(String("ladder")) {
                    _ = r.set_block(f, tp.x + dx, y + dy, tp.z + dz, try block_state(f, "snow_block"), UPDATE_ALL)
                }
            }
        },
        TemplateKind.Shipwreck { beached, adjusted } => {
            let s = Settings { rotation: tp.rotation, pivot_x: tp.pivot_x, pivot_z: tp.pivot_z, processors: [Processor.Ignore(BlockSet.of([structure_block, air], f.block_count))] }
            if not adjusted and not (t.size_x > 32 or t.size_y > 32) {
                // Settled once: on the beach under its lowest column, partly buried, or on the
                // ocean floor at its columns' mean.
                var lowest = r.min_y + r.height
                var mean = 0
                let kind = if beached { WORLD_SURFACE_WG } else { OCEAN_FLOOR_WG }
                let base = t.size_x * t.size_z
                if base == 0 {
                    mean = try r.get_height(f, kind, tp.x, tp.z)
                } else {
                    for z in tp.z..tp.z + t.size_z {
                        for x in tp.x..tp.x + t.size_x {
                            let h = try r.get_height(f, kind, x, z)
                            mean += h
                            lowest = lowest.min(h)
                        }
                    }
                    mean /= base
                }
                tp.y = if beached { lowest - t.size_y / 2 - random.next_int_below(3) } else { mean }
                tp.kind = TemplateKind.Shipwreck { beached: beached, adjusted: true }
                piece.data = PieceData.Template(tp.copy())
            }
            try place_template(e, mut r, mut random, mut piece, t, tp, s, area, tp.x, tp.y, tp.z, ref_x, ref_y, ref_z)
        },
        TemplateKind.OceanRuin { integrity, cold, large } => {
            let s = try ruin_settings(f, tp, integrity, cold)
            tp.y = try r.get_height(f, OCEAN_FLOOR_WG, tp.x, tp.z)
            let (cx, _, cz) = transform(t.size_x - 1, 0, t.size_z - 1, s.mirror, s.rotation, 0, 0)
            tp.y = try ruin_height(f, r, tp.x, tp.y, tp.z, tp.x + cx, tp.z + cz)
            piece.data = PieceData.Template(tp.copy())
            try place_template(e, mut r, mut random, mut piece, t, tp, s, area, tp.x, tp.y, tp.z, ref_x, ref_y, ref_z)
            _ = large
        },
        TemplateKind.NetherFossil => {
            let s = Settings { rotation: tp.rotation, pivot_x: tp.pivot_x, pivot_z: tp.pivot_z, processors: [Processor.Ignore(BlockSet.of([structure_block, air], f.block_count))] }
            let fossil = t.bounding_box(s, tp.x, tp.y, tp.z)
            area = encapsulate(area, fossil)
            try place_template(e, mut r, mut random, mut piece, t, tp, s, area, tp.x, tp.y, tp.z, ref_x, ref_y, ref_z)
            try dried_ghast(f, mut r, fossil, area)
        },
        TemplateKind.RuinedPortal { placement, props } => {
            let s = try portal_settings(f, tp, placement, props)
            let bb = t.bounding_box(s, tp.x, tp.y, tp.z)
            let (mx, my, mz) = center(bb)
            if not area.inside(mx, my, mz) {
                return
            }
            area = encapsulate(area, bb)
            try place_template(e, mut r, mut random, mut piece, t, tp, s, area, tp.x, tp.y, tp.z, ref_x, ref_y, ref_z)
            let p = Portal { placement: placement, props: props, bb: piece.bb }
            try spread_netherrack(f, mut r, mut random, p)
            try drip_columns(f, mut r, mut random, p)
            if props.vines or props.overgrown {
                // `BlockPos.betweenClosedStream`: x fastest, then y, then z.
                for z in p.bb.min_z..p.bb.max_z + 1 {
                    for y in p.bb.min_y..p.bb.max_y + 1 {
                        for x in p.bb.min_x..p.bb.max_x + 1 {
                            if props.vines {
                                try maybe_vines(f, mut r, mut random, x, y, z)
                            }
                            if props.overgrown {
                                try maybe_leaves(f, mut r, mut random, x, y, z)
                            }
                        }
                    }
                }
            }
        },
        TemplateKind.EndCity(overwrite) => {
            // `EndCityPiece.makeSettings`: turned, without its entities or structure blocks, and
            // without its air unless it overwrites what's there.
            var ignored = List<i32>()
            ignored.push(structure_block)
            if not overwrite {
                ignored.push(air)
            }
            let s = Settings { rotation: tp.rotation, ignore_entities: true, processors: [Processor.Ignore(BlockSet.of(ignored, f.block_count))] }
            try place_template(e, mut r, mut random, mut piece, t, tp, s, area, tp.x, tp.y, tp.z, ref_x, ref_y, ref_z)
        },
        TemplateKind.Mansion => {
            // `WoodlandMansionPiece.makeSettings`: mirrored and turned about its corner, without
            // its entities or structure blocks.
            let s = Settings { mirror: tp.mirror, rotation: tp.rotation, ignore_entities: true, processors: [Processor.Ignore(BlockSet.of([structure_block], f.block_count))] }
            try place_template(e, mut r, mut random, mut piece, t, tp, s, area, tp.x, tp.y, tp.z, ref_x, ref_y, ref_z)
        },
    }
}

/// `WoodlandMansionStructure.afterPlace`: under every column of the chunk where the mansion's
/// lowest floor is, inside one of its pieces, cobblestone down through air and liquid to the
/// ground.
pub fn mansion_after(f: Facts, r: mut Region, start: Start, area: Bounds) ! Thrown {
    if start.pieces.is_empty() {
        return
    }
    var bb = start.pieces[0].bb
    for p in start.pieces {
        bb = encapsulate(bb, p.bb)
    }
    let cobblestone = try block_state(f, "cobblestone")
    let y0 = bb.min_y
    for x in area.min_x..area.max_x + 1 {
        for z in area.min_z..area.max_z + 1 {
            if f.is_air(try r.state(f, x, y0, z)) or not bb.inside(x, y0, z) {
                continue
            }
            var inside = false
            for p in start.pieces {
                if p.bb.inside(x, y0, z) {
                    inside = true
                    break
                }
            }
            if not inside {
                continue
            }
            var y = y0 - 1
            while y > r.min_y {
                let here = try r.state(f, x, y, z)
                if not f.is_air(here) and not f.is_liquid(here) {
                    break
                }
                _ = r.set_block(f, x, y, z, cobblestone, UPDATE_CLIENTS)
                y -= 1
            }
        }
    }
}

// `OceanRuinPiece.makeSettings`: turned, blocks kept with the ruin's integrity, air left out,
// and up to five of its sand or gravel blocks made suspicious, with the ruin's archaeology loot.
fn ruin_settings(f: Facts, tp: TemplatePiece, integrity: f32, cold: bool) -> Settings ! Thrown {
    let structure_block = i32.wrap(try f.named_block(String("structure_block")))
    let (loose, suspicious, table) = if cold { ("gravel", "suspicious_gravel", "minecraft:archaeology/ocean_ruin_cold") } else { ("sand", "suspicious_sand", "minecraft:archaeology/ocean_ruin_warm") }
    let rule = ProcessorRule { input: Rule.Block(try f.named_block(String(loose))), location: Rule.AlwaysTrue, position: PosRule.AlwaysTrue, output: try block_state(f, suspicious), modifier: Modifier.AppendLoot(String(table)) }
    let delegate = Processor.Rules([rule])
    var processors = List<Processor>()
    processors.push(Processor.Rot { blocks: none, integrity: integrity })
    processors.push(Processor.Ignore(BlockSet.of([structure_block, i32.wrap(f.ids.air)], f.block_count)))
    processors.push(Processor.Capped { delegate: Box(delegate), limit: IntProvider.Constant(5) })
    return Settings { rotation: tp.rotation, pivot_x: tp.pivot_x, pivot_z: tp.pivot_z, processors: processors }
}

// `IglooPieces.OFFSETS` across: where each part sits from the top's corner.
fn igloo_offset(name: String) -> (i32, i32) {
    if name == "minecraft:igloo/middle" {
        return (2, 4)
    }
    if name == "minecraft:igloo/bottom" {
        return (0, -2)
    }
    return (0, 0)
}

// The middle of a box, as `BoundingBox.getCenter` rounds it.
fn center(b: Bounds) -> (i32, i32, i32) {
    return (b.min_x + (b.max_x - b.min_x + 1) / 2, b.min_y + (b.max_y - b.min_y + 1) / 2, b.min_z + (b.max_z - b.min_z + 1) / 2)
}

// `BoundingBox.encapsulate`.
fn encapsulate(a: Bounds, b: Bounds) -> Bounds {
    return Bounds { min_x: a.min_x.min(b.min_x), min_y: a.min_y.min(b.min_y), min_z: a.min_z.min(b.min_z), max_x: a.max_x.max(b.max_x), max_y: a.max_y.max(b.max_y), max_z: a.max_z.max(b.max_z) }
}

// `TemplateStructurePiece.postProcess` from the template's position `x, y, z`: the piece's box
// made the template's there, the template placed in `area`, then its data markers run and its
// jigsaw blocks set to their final states, those in `area`.
fn place_template<T: RandomSource>(e: Env, r: mut Region, random: mut T, piece: mut Piece, t: Template, tp: TemplatePiece, settings: Settings, area: Bounds, x: i32, y: i32, z: i32, ref_x: i32, ref_y: i32, ref_z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    var s = settings.copy()
    s.bounds = some(area)
    piece.bb = t.bounding_box(s, x, y, z)
    if not try place_in_world(e, mut r, t, x, y, z, ref_x, ref_y, ref_z, s, mut random, UPDATE_CLIENTS) {
        return
    }
    for m in filter_blocks(f, t, s, x, y, z, try f.named_block(String("structure_block"))) {
        let nbt = m.nbt else continue
        if string_of(nbt, "mode") == "DATA" {
            try data_marker(f, mut r, mut random, tp, string_of(nbt, "metadata"), m.x, m.y, m.z, area)
        }
    }
    for j in filter_blocks(f, t, s, x, y, z, try f.named_block(String("jigsaw"))) {
        let nbt = j.nbt else continue
        var text = string_of(nbt, "final_state")
        if not nbt.contains("final_state") {
            text = String("minecraft:air")
        }
        let state = parse_state(f, text) ?? f.ids.air_state
        _ = r.set_block(f, j.x, j.y, j.z, state, UPDATE_ALL)
    }
}

fn string_of(nbt: JavaHashMap<String, Tag>, key: str) -> String {
    if not nbt.contains(key) {
        return String()
    }
    return match nbt[key] {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}

// `handleDataMarker` of the piece's kind.
fn data_marker<T: RandomSource>(f: Facts, r: mut Region, random: mut T, tp: TemplatePiece, id: String, x: i32, y: i32, z: i32, area: Bounds) ! Thrown {
    match tp.kind {
        TemplateKind.Igloo => {
            if id == "chest" {
                _ = r.set_block(f, x, y, z, f.ids.air_state, UPDATE_ALL)
                if let kind = try r.block_entity(f, x, y - 1, z) {
                    if kind == "minecraft:chest" {
                        r.set_loot_table(x, y - 1, z, String("minecraft:chests/igloo_chest"), random.next_long())
                    }
                }
            }
        },
        TemplateKind.Shipwreck { .. } => {
            var table = String()
            if id == "map_chest" {
                table = String("minecraft:chests/shipwreck_map")
            } else if id == "treasure_chest" {
                table = String("minecraft:chests/shipwreck_treasure")
            } else if id == "supply_chest" {
                table = String("minecraft:chests/shipwreck_supply")
            }
            if not table.is_empty() {
                try container_loot(f, mut r, mut random, x, y - 1, z, table)
            }
        },
        TemplateKind.OceanRuin { large, .. } => {
            if id == "chest" {
                let water = f.fluid_in(try r.state(f, x, y, z), "minecraft:water")
                let chest = try f.with_bool(f.default_state(f.ids.chest), String("waterlogged"), water)
                _ = r.set_block(f, x, y, z, chest, UPDATE_CLIENTS)
                if let kind = try r.block_entity(f, x, y, z) {
                    if kind == "minecraft:chest" {
                        let table = if large { "minecraft:chests/underwater_ruin_big" } else { "minecraft:chests/underwater_ruin_small" }
                        r.set_loot_table(x, y, z, String(table), random.next_long())
                    }
                }
            } else if id == "drowned" {
                try spawn_mob(mut r, "minecraft:drowned", x, y, z)
                let state = if y > r.sea_level { f.ids.air_state } else { f.default_state(f.ids.water) }
                _ = r.set_block(f, x, y, z, state, UPDATE_CLIENTS)
            }
        },
        TemplateKind.NetherFossil => {},
        TemplateKind.RuinedPortal { .. } => {},
        TemplateKind.EndCity(_) => {
            if id.starts_with("Chest") {
                if area.inside(x, y - 1, z) {
                    try container_loot(f, mut r, mut random, x, y - 1, z, String("minecraft:chests/end_city_treasure"))
                }
            } else if area.inside(x, y, z) {
                if id.starts_with("Sentry") {
                    try spawn_mob(mut r, "minecraft:shulker", x, y, z)
                } else if id.starts_with("Elytra") {
                    // An item frame on the wall behind, facing south as the piece is turned.
                    let d = rotate_direction(tp.rotation, SOUTH)
                    let px = f64(x) + 0.5 - 0.46875 * f64(step_x(d))
                    let pz = f64(z) + 0.5 - 0.46875 * f64(step_z(d))
                    let quarter = if d == SOUTH { 0 } else if d == WEST { 1 } else if d == NORTH { 2 } else { 3 }
                    try spawn_entity(mut r, "minecraft:item_frame", px, f64(y) + 0.5, pz, f32.nearest(f64(quarter * 90)), x, z)
                }
            }
        },
        TemplateKind.Mansion => {
            if id.starts_with("Chest") {
                // A chest facing as the marker says, turned with the piece but not mirrored.
                var state = f.default_state(f.ids.chest)
                let sides: List<str> = ["ChestWest", "ChestEast", "ChestSouth", "ChestNorth"]
                let ways: List<i32> = [WEST, EAST, SOUTH, NORTH]
                for i in 0..sides.len() {
                    if id == String(sides[i]) {
                        state = try facing(f, state, rotate_direction(tp.rotation, ways[i]))
                    }
                }
                _ = try chest_at(f, mut r, area, mut random, x, y, z, "minecraft:chests/woodland_mansion", some(state))
                return
            }
            var mob: str = ""
            var count = 1
            if id == "Mage" {
                mob = "minecraft:evoker"
            } else if id == "Warrior" {
                mob = "minecraft:vindicator"
            } else if id == "Group of Allays" {
                mob = "minecraft:allay"
                count = r.random.next_int_below(3) + 1
            } else {
                return
            }
            for _ in 0..count {
                try spawn_mob(mut r, mob, x, y, z)
                mob_draws(mut r)
                if mob == "minecraft:vindicator" {
                    // `populateDefaultEquipmentEnchantments`: the chance its axe is enchanted,
                    // none in a world this young but drawn all the same.
                    _ = r.random.next_float()
                }
                _ = r.set_block(f, x, y, z, f.ids.air_state, UPDATE_CLIENTS)
            }
        },
    }
}

// `RandomizableContainer.setBlockEntityLootTable`: the loot table and a seed for a container at
// the block, if it's one.
fn container_loot<T: RandomSource>(f: Facts, r: mut Region, random: mut T, x: i32, y: i32, z: i32, table: String) ! Thrown {
    let kind = try r.block_entity(f, x, y, z) else return
    if randomizable(kind) {
        r.set_loot_table(x, y, z, table, random.next_long())
    }
}

// `OceanRuinPiece.getHeight`: one above the lowest floor under the ruin, past air, water and
// ice, if that's more than two below where it stands and most of its columns are that low;
// else where it stands.
fn ruin_height(f: Facts, r: Region, x: i32, y: i32, z: i32, cx: i32, cz: i32) -> i32 ! Thrown {
    var lowest = 512
    let top = y - 1
    var area = 0
    let ice = f.tag("minecraft:ice")
    for bz in z.min(cz)..z.max(cz) + 1 {
        for bx in x.min(cx)..x.max(cx) + 1 {
            var floor = y - 1
            var state = try r.state(f, bx, floor, bz)
            while (f.is_air(state) or f.fluid_in(state, "minecraft:water") or f.in_set(state, ice)) and floor > r.min_y + 1 {
                floor -= 1
                state = try r.state(f, bx, floor, bz)
            }
            lowest = lowest.min(floor)
            if floor < top - 2 {
                area += 1
            }
        }
    }
    let width = (x - cx).abs()
    if top - lowest > 2 and area > width - 2 {
        return lowest + 1
    }
    return y
}

// `NetherFossilPiece.placeDriedGhast`: half the time, from the world's seed at the fossil's
// middle, a dried ghast turned at random on a block of the fossil's bottom, if that's air and in
// the area.
fn dried_ghast(f: Facts, r: mut Region, fossil: Bounds, area: Bounds) ! Thrown {
    let (mx, my, mz) = center(fossil)
    var seeded = LegacyRandom.new(r.seed)
    var random = seeded.fork_positional().at(mx, my, mz)
    if random.next_float() >= 0.5f32 {
        return
    }
    let x = fossil.min_x + random.next_int_below(fossil.max_x - fossil.min_x + 1)
    let y = fossil.min_y
    let z = fossil.min_z + random.next_int_below(fossil.max_z - fossil.min_z + 1)
    if f.is_air(try r.state(f, x, y, z)) and area.inside(x, y, z) {
        let state = f.rotate(try block_state(f, "dried_ghast"), random.next_int_below(4))
        _ = r.set_block(f, x, y, z, state, UPDATE_CLIENTS)
    }
}

// `RuinedPortalPiece.makeSettings`: turned and mirrored about the template's middle; air kept
// out unless it's an air pocket; gold sometimes gone, lava as magma or netherrack, netherrack
// sometimes magma; aged; nothing over what features can't replace; lava kept; and blackstone
// for stone if it asks.
fn portal_settings(f: Facts, tp: TemplatePiece, placement: i32, props: PortalProperties) -> Settings ! Thrown {
    let structure_block = i32.wrap(try f.named_block(String("structure_block")))
    var ignored: List<i32> = [structure_block]
    if not props.air_pocket {
        ignored.push(i32.wrap(f.ids.air))
    }
    var rules = List<ProcessorRule>()
    rules.push(try replace_rule(f, "gold_block", 0.3f32, "air"))
    if placement == ON_OCEAN_FLOOR {
        rules.push(try replace_rule(f, "lava", 1.0f32, "magma_block"))
    } else if props.cold {
        rules.push(try replace_rule(f, "lava", 1.0f32, "netherrack"))
    } else {
        rules.push(try replace_rule(f, "lava", 0.2f32, "magma_block"))
    }
    if not props.cold {
        rules.push(try replace_rule(f, "netherrack", 0.07f32, "magma_block"))
    }
    var processors: List<Processor> = [Processor.Ignore(BlockSet.of(ignored, f.block_count)), Processor.Rules(rules), Processor.Age(props.mossiness), Processor.Protected(f.tag("minecraft:features_cannot_replace")), Processor.LavaSubmerged]
    if props.blackstone {
        processors.push(Processor.Blackstone)
    }
    return Settings { mirror: tp.mirror, rotation: tp.rotation, pivot_x: tp.pivot_x, pivot_z: tp.pivot_z, processors: processors }
}

// A rule replacing the block with another, always for a chance of 1, else with the chance.
fn replace_rule(f: Facts, from: str, chance: f32, to: str) -> ProcessorRule ! Thrown {
    let block = try f.named_block(String(from))
    let input = if chance >= 1.0f32 { Rule.Block(block) } else { Rule.RandomBlock { block: block, probability: chance } }
    return ProcessorRule { input: input, location: Rule.AlwaysTrue, position: PosRule.AlwaysTrue, output: try block_state(f, to), modifier: Modifier.Passthrough }
}

// A ruined portal once it's placed: how it was placed, what it is, and its box.
struct Portal {
    placement: i32
    props: PortalProperties
    bb: Bounds
}

// `canBlockBeReplacedByNetherrackOrMagma`: not plain air, obsidian or what features can't
// replace, nor lava unless in the Nether.
fn netherrack_replaces(f: Facts, p: Portal, state: u32) -> bool ! Thrown {
    if f.block(state) == f.ids.air or f.block(state) == try f.named_block(String("obsidian")) or f.in_set(state, f.tag("minecraft:features_cannot_replace")) {
        return false
    }
    return p.placement == IN_NETHER or not f.is(state, f.ids.lava)
}

// `placeNetherrackOrMagma`.
fn netherrack_or_magma<T: RandomSource>(f: Facts, r: mut Region, random: mut T, p: Portal, x: i32, y: i32, z: i32) ! Thrown {
    if not try netherrack_replaces(f, p, try r.state(f, x, y, z)) {
        return
    }
    if not p.props.cold and random.next_float() < 0.07f32 {
        _ = r.set_block(f, x, y, z, try block_state(f, "magma_block"), UPDATE_ALL)
    } else {
        _ = r.set_block(f, x, y, z, try block_state(f, "netherrack"), UPDATE_ALL)
    }
}

// `addNetherrackDripColumn`: netherrack or magma down from the block, one more half the time,
// up to nine.
fn drip_column<T: RandomSource>(f: Facts, r: mut Region, random: mut T, p: Portal, x: i32, y: i32, z: i32) ! Thrown {
    var at = y
    try netherrack_or_magma(f, mut r, mut random, p, x, at, z)
    var left = 8
    while left > 0 and random.next_float() < 0.5f32 {
        at -= 1
        left -= 1
        try netherrack_or_magma(f, mut r, mut random, p, x, at, z)
    }
}

// `addNetherrackDripColumnsBelowPortal`: a drip column under each netherrack block of the
// portal's bottom layer, inside its edge.
fn drip_columns<T: RandomSource>(f: Facts, r: mut Region, random: mut T, p: Portal) ! Thrown {
    let netherrack = try f.named_block(String("netherrack"))
    for x in p.bb.min_x + 1..p.bb.max_x {
        for z in p.bb.min_z + 1..p.bb.max_z {
            if f.block(try r.state(f, x, p.bb.min_y, z)) == netherrack {
                try drip_column(f, mut r, mut random, p, x, p.bb.min_y - 1, z)
            }
        }
    }
}

// `spreadNetherrack`: netherrack on the surface around the portal, thinning out with distance
// from its middle, each with its drip column, and leaves over it if overgrown.
fn spread_netherrack<T: RandomSource>(f: Facts, r: mut Region, random: mut T, p: Portal) ! Thrown {
    let follow = p.placement == ON_LAND_SURFACE or p.placement == ON_OCEAN_FLOOR
    let (cx, _, cz) = center(p.bb)
    let chances: List<f32> = [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 0.9f32, 0.9f32, 0.8f32, 0.7f32, 0.6f32, 0.4f32, 0.2f32]
    let most = 14
    let width = ((p.bb.max_x - p.bb.min_x + 1) + (p.bb.max_z - p.bb.min_z + 1)) / 2
    let adjust = random.next_int_below(1.max(8 - width / 2))
    let kind = if p.placement == ON_OCEAN_FLOOR { OCEAN_FLOOR_WG } else { WORLD_SURFACE_WG }
    for x in cx - most..cx + most + 1 {
        for z in cz - most..cz + most + 1 {
            let distance = 0.max((x - cx).abs() + (z - cz).abs() + adjust)
            if distance >= most {
                continue
            }
            if not (random.next_double() < f64(chances[usize.wrap(distance)])) {
                continue
            }
            let surface = try r.get_height(f, kind, x, z) - 1
            let y = if follow { surface } else { p.bb.min_y.min(surface) }
            if (y - p.bb.min_y).abs() <= 3 and try netherrack_replaces(f, p, try r.state(f, x, y, z)) {
                try netherrack_or_magma(f, mut r, mut random, p, x, y, z)
                if p.props.overgrown {
                    try maybe_leaves(f, mut r, mut random, x, y, z)
                }
                try drip_column(f, mut r, mut random, p, x, y - 1, z)
            }
        }
    }
}

// `maybeAddLeavesAbove`: half the time, persistent jungle leaves over netherrack with air above.
fn maybe_leaves<T: RandomSource>(f: Facts, r: mut Region, random: mut T, x: i32, y: i32, z: i32) ! Thrown {
    if random.next_float() < 0.5f32 and f.block(try r.state(f, x, y, z)) == try f.named_block(String("netherrack")) and f.is_air(try r.state(f, x, y + 1, z)) {
        let leaves = try f.with_bool(try block_state(f, "jungle_leaves"), String("persistent"), true)
        _ = r.set_block(f, x, y + 1, z, leaves, UPDATE_ALL)
    }
}

// `maybeAddVines`: from a block that isn't air or vines, a vine on the air beside it a way at
// random, if the block's face there is whole.
fn maybe_vines<T: RandomSource>(f: Facts, r: mut Region, random: mut T, x: i32, y: i32, z: i32) ! Thrown {
    let state = try r.state(f, x, y, z)
    let vine = try f.named_block(String("vine"))
    if f.is_air(state) or f.block(state) == vine {
        return
    }
    let d = horizontal(random.next_int_below(4))
    let nx = x + step_x(d)
    let nz = z + step_z(d)
    if not f.is_air(try r.state(f, nx, y, nz)) {
        return
    }
    if f.collision_face_full(state, d) {
        let placed = try f.with_bool(f.default_state(vine), direction_name(opposite(d)), true)
        _ = r.set_block(f, nx, y, nz, placed, UPDATE_ALL)
    }
}
