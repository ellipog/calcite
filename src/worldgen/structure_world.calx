/// What structures ask of the world they start in, as `Structure.GenerationContext` gives it:
/// the generator's base columns and heights, the biome source's biomes, the templates, and the
/// biomes' temperatures.
module worldgen.structure_world

import std.zip.{Zip}
import world.chunk.{AIR_STATE, WORLD_SURFACE_WG}
import worldgen.biome_manager.{SourceBiomes}
import worldgen.density.{Functions}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}
import worldgen.providers.{GenContext}
import worldgen.temperature.{Temperatures}
import worldgen.template.{Templates}
import worldgen.terrain.{Column, Shape, base_column, base_height}

/// A world's generator, as structures see it.
pub struct StructureWorld {
    pub functions: Functions
    pub shape: Shape
    pub facts: Facts
    pub biomes: SourceBiomes
    pub templates: Templates
    pub temps: Temperatures
    /// The world's bottom and height, as the chunk being generated has them.
    pub level_min: i32
    pub level_height: i32
    pub seed: i64
}

impl StructureWorld {
    /// `getBaseColumn`.
    pub fn column(mut self, x: i32, z: i32) -> Column? ! Thrown {
        return try base_column(mut self.functions, self.shape, x, z, self.level_min, self.level_height)
    }

    /// `getBaseHeight` for heightmap `kind`.
    pub fn base_height(mut self, x: i32, z: i32, kind: i32) -> i32 ! Thrown {
        let c = try self.column(x, z)
        return base_height(c, self.facts.table, kind, self.level_min)
    }

    /// `getFirstOccupiedHeight`: one below the base height.
    pub fn first_occupied(mut self, x: i32, z: i32, kind: i32) -> i32 ! Thrown {
        return try self.base_height(x, z, kind) - 1
    }

    /// The generator's sea level.
    pub fn sea_level(self) -> i32 {
        return self.shape.sea_level
    }

    /// `WorldGenerationContext` of the generator in the world.
    pub fn gen_context(self) -> GenContext {
        return GenContext.new(self.shape.min_y, self.shape.height, self.shape.sea_level, self.level_min, self.level_height)
    }

    /// The biome source's biome at a quart.
    pub fn noise_biome(mut self, qx: i32, qy: i32, qz: i32) -> i32 ! Thrown {
        return try self.biomes.at(self.functions.program, qx, qy, qz)
    }

    /// `GenerationContext.isValidBiome` of a start at the block.
    pub fn valid_biome(mut self, x: i32, y: i32, z: i32, allowed: List<i32>) -> bool ! Thrown {
        return allowed.contains(try self.noise_biome(x >> 2, y >> 2, z >> 2))
    }

    /// `couldValidBiomeExistInTerrainColumn`: whether any quart of the column, from one below
    /// the world to its top, has an allowed biome.
    pub fn valid_in_column(mut self, x: i32, z: i32, allowed: List<i32>) -> bool ! Thrown {
        let low = self.level_min - 1
        let high = self.level_min + self.level_height - 1
        return try self.valid_in_range(x, z, low, high, allowed)
    }

    /// `couldStructureExistInColumn`: whether any quart of the column between the blocks has an
    /// allowed biome.
    pub fn valid_in_range(mut self, x: i32, z: i32, min_y: i32, max_y: i32, allowed: List<i32>) -> bool ! Thrown {
        let low = min_y >> 2
        let high = max_y >> 2
        for qy in low..high + 1 {
            if allowed.contains(try self.noise_biome(x >> 2, qy, z >> 2)) {
                return true
            }
        }
        return false
    }

    /// `couldValidBiomeExistOnTopOfChunkCenter`.
    pub fn valid_at_center(mut self, cx: i32, cz: i32, allowed: List<i32>) -> bool ! Thrown {
        return try self.valid_in_column((cx << 4) + 8, (cz << 4) + 8, allowed)
    }

    /// The template, loaded once.
    pub fn template(mut self, zip: Zip, id: String) -> usize ! Thrown {
        match self.templates.get_or_create(zip, self.facts, id) {
            ok(i) => return i,
            err(e) => fail Thrown { exception: "IllegalStateException", message: e },
        }
    }

    // `Structure.getCornerHeights`, its arguments in vanilla's order.
    fn corner_heights(mut self, min_x: i32, size_x: i32, min_z: i32, size_z: i32) -> (i32, i32, i32, i32) ! Thrown {
        let a = try self.first_occupied(min_x, min_z, WORLD_SURFACE_WG)
        let b = try self.first_occupied(min_x, min_z + size_z, WORLD_SURFACE_WG)
        let c = try self.first_occupied(min_x + size_x, min_z, WORLD_SURFACE_WG)
        let d = try self.first_occupied(min_x + size_x, min_z + size_z, WORLD_SURFACE_WG)
        return (a, b, c, d)
    }

    /// `Structure.getMeanFirstOccupiedHeight`.
    pub fn mean_height(mut self, min_x: i32, size_x: i32, min_z: i32, size_z: i32) -> i32 ! Thrown {
        let (a, b, c, d) = try self.corner_heights(min_x, size_x, min_z, size_z)
        return (a + b + c + d) / 4
    }

    /// `Structure.getLowestY(context, minX, minZ, sizeX, sizeZ)`.
    pub fn lowest_y(mut self, min_x: i32, min_z: i32, size_x: i32, size_z: i32) -> i32 ! Thrown {
        let (a, b, c, d) = try self.corner_heights(min_x, size_x, min_z, size_z)
        return a.min(b).min(c.min(d))
    }
}

/// `NoiseColumn.getBlock`: air outside the column.
pub fn column_block(c: Column?, y: i32) -> u32 {
    if let col = c {
        let i = y - col.min_y
        if i >= 0 and i < i32.wrap(col.states.len()) {
            return col.states[usize.wrap(i)]
        }
    }
    return AIR_STATE
}
