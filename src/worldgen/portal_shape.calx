/// Vanilla's `PortalShape`: a nether portal's frame, found from a block inside it, as a portal
/// block checks that it still stands (D332).
module worldgen.portal_shape

import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, SOUTH, WEST, opposite, step_x, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env}

/// The widest and highest a portal's inside is, and the narrowest and lowest.
pub const MAX_WIDTH: i32 = 21
pub const MAX_HEIGHT: i32 = 21
pub const MIN_WIDTH: i32 = 2
pub const MIN_HEIGHT: i32 = 3

/// A frame as `PortalShape` finds it: along `x` or `z`, the inside's bottom left block, the way
/// to its right, how wide and high the inside is, 0 where the frame doesn't close, and how many of
/// its blocks are portal already.
pub struct PortalShape {
    pub along_x: bool
    pub right: i32
    pub x: i32
    pub y: i32
    pub z: i32
    pub width: i32
    pub height: i32
    pub portal_blocks: i32
}

impl PortalShape {
    /// `isValid`: 2 to 21 wide and 3 to 21 high.
    pub fn is_valid(self) -> bool {
        return self.width >= MIN_WIDTH and self.width <= MAX_WIDTH and self.height >= MIN_HEIGHT and self.height <= MAX_HEIGHT
    }

    /// `isComplete`: valid, and portal all through.
    pub fn is_complete(self) -> bool {
        return self.is_valid() and self.portal_blocks == self.width * self.height
    }
}

/// `PortalShape.findAnyShape`: the frame around `x`, `y`, `z`, along `x` or `z`, as far as there
/// is one. Down through what's empty, 21 blocks at most and not below the world, then left to the
/// frame, is the bottom left; from there right to the frame is the width, and up to where a side
/// or the inside stops is the height, if the frame's top is there.
pub fn find_any_shape<R: BlockAccess>(e: Env, r: R, x: i32, y: i32, z: i32, along_x: bool) -> PortalShape ! Thrown {
    let Env { facts: f, .. } = e
    let right = if along_x { WEST } else { SOUTH }
    var shape = PortalShape { along_x: along_x, right: right, x: x, y: y, z: z, width: 0, height: 0, portal_blocks: 0 }
    // `calculateBottomLeft`.
    let lowest = if e.ctx.min_y > y - 21 { e.ctx.min_y } else { y - 21 }
    var bottom = y
    while bottom > lowest and is_empty(f, try r.state(f, x, bottom - 1, z)) {
        bottom -= 1
    }
    let left = opposite(right)
    let edge = try edge_above_frame(f, r, x, bottom, z, left) - 1
    if edge < 0 {
        return shape
    }
    shape.x = x + step_x(left) * edge
    shape.y = bottom
    shape.z = z + step_z(left) * edge
    // `calculateWidth`.
    let width = try edge_above_frame(f, r, shape.x, shape.y, shape.z, right)
    if width < MIN_WIDTH or width > MAX_WIDTH {
        return shape
    }
    shape.width = width
    // `calculateHeight`, counting the portal blocks inside on the way up.
    let (height, blocks) = try until_top(f, r, shape, width)
    shape.portal_blocks = blocks
    if height >= MIN_HEIGHT and height <= MAX_HEIGHT and try top_frame(f, r, shape, width, height) {
        shape.height = height
    }
    return shape
}

// `isEmpty`: air, fire or portal.
fn is_empty(f: Facts, state: u32) -> bool {
    return f.is_air(state) or f.in_set(state, f.tag("minecraft:fire")) or f.is(state, f.ids.nether_portal)
}

// `FRAME`: the tag `nether_portal_frame`, obsidian.
fn is_frame(f: Facts, state: u32) -> bool {
    return f.in_set(state, f.tag("minecraft:nether_portal_frame"))
}

// `getDistanceUntilEdgeAboveFrame`: how far toward `d` the frame is, over empty blocks with frame
// under each, 21 at most, or 0 where something else is in the way or the frame under stops.
fn edge_above_frame<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32, d: i32) -> i32 ! Thrown {
    for i in 0..MAX_WIDTH + 1 {
        let at_x = x + step_x(d) * i
        let at_z = z + step_z(d) * i
        let state = try r.state(f, at_x, y, at_z)
        if not is_empty(f, state) {
            if is_frame(f, state) {
                return i
            }
            return 0
        }
        if not is_frame(f, try r.state(f, at_x, y - 1, at_z)) {
            return 0
        }
    }
    return 0
}

// `getDistanceUntilTop`: how many rows up from the bottom left have frame at both ends and only
// empty blocks between, 21 at most, and how many of those blocks were portal.
fn until_top<R: BlockAccess>(f: Facts, r: R, s: PortalShape, width: i32) -> (i32, i32) ! Thrown {
    var blocks = 0
    for height in 0..MAX_HEIGHT {
        let y = s.y + height
        if not is_frame(f, try r.state(f, s.x - step_x(s.right), y, s.z - step_z(s.right))) {
            return (height, blocks)
        }
        if not is_frame(f, try r.state(f, s.x + step_x(s.right) * width, y, s.z + step_z(s.right) * width)) {
            return (height, blocks)
        }
        for i in 0..width {
            let state = try r.state(f, s.x + step_x(s.right) * i, y, s.z + step_z(s.right) * i)
            if not is_empty(f, state) {
                return (height, blocks)
            }
            if f.is(state, f.ids.nether_portal) {
                blocks += 1
            }
        }
    }
    return (MAX_HEIGHT, blocks)
}

// `hasTopFrame`: frame all along the row above the inside.
fn top_frame<R: BlockAccess>(f: Facts, r: R, s: PortalShape, width: i32, height: i32) -> bool ! Thrown {
    for i in 0..width {
        if not is_frame(f, try r.state(f, s.x + step_x(s.right) * i, s.y + height, s.z + step_z(s.right) * i)) {
            return false
        }
    }
    return true
}
