/// What features ask of block states and blocks: which block a state is, its flags and the facts
/// `world.block_facts` holds, its fluid, its block's class and tags, its properties, and the faces
/// a fluid sees of it, `world.fluid_faces` (D327). Built once from the loaded block and fluid
/// registries.
module worldgen.facts

import random.source.{position_seed}
import registry.registry.{Registry}
import world.block_facts.{COLLISION_EMPTY, COLLISION_FACE_SHIFT, COLLISION_FULL_BLOCK, COLLISION_TOP_ANY, IGNITED_BY_LAVA, LIQUID, REDSTONE_CONDUCTOR, REPLACEABLE, SOLID, STURDY_CENTER_SHIFT, STURDY_FULL_SHIFT, STURDY_RIGID_SHIFT, block_classes, block_entity_blocks, block_entity_names, block_instruments, class_names, instrument_names, instruments_above, wall_cover, class_parents, dynamic_shape_blocks, fire_odds, flammable_blocks, outline_differs, liquid_containers, neighbour_classes, place_classes, place_on_classes, poi_states, precipitation_classes, random_tick_classes, removal_classes, shape_classes, tick_classes, state_facts, state_fluids, state_mirrors_front_back, state_mirrors_left_right, state_occlusion, state_turns, survive_classes, waterloggable_blocks}
import world.block_flags.{AIR, BLOCK_ENTITY, LIGHT_EMISSION_SHIFT, OFFSET, SOLID_RENDER, state_flags}
import world.chunk.{BlockStates}
import world.fluid_faces.{COVER_WORDS, FACE_FLOOR, FACE_UNIT, FLUID_FACE_BITS, face_rects, face_starts, fluid_covers, moving_boxes, moving_grids, moving_starts, moving_states, offset_blocks, state_fluid_faces}
import world.states.{Prop, StateCodec}
import worldgen.interval.{Thrown}

/// `Direction`, by its ordinal: down, up, north, south, west, east.
pub const DOWN: i32 = 0
pub const UP: i32 = 1
pub const NORTH: i32 = 2
pub const SOUTH: i32 = 3
pub const WEST: i32 = 4
pub const EAST: i32 = 5

/// A direction's step on each axis.
pub fn step_x(d: i32) -> i32 {
    return if d == WEST { -1 } else if d == EAST { 1 } else { 0 }
}

pub fn step_y(d: i32) -> i32 {
    return if d == DOWN { -1 } else if d == UP { 1 } else { 0 }
}

pub fn step_z(d: i32) -> i32 {
    return if d == NORTH { -1 } else if d == SOUTH { 1 } else { 0 }
}

/// The direction the other way.
// A coordinate of `world.fluid_faces`, in blocks.
fn units(c: u8) -> f64 {
    return f64(i32(c) + FACE_FLOOR) / f64(FACE_UNIT)
}

// `Mth.clamp` of doubles.
fn clamp(value: f64, low: f64, high: f64) -> f64 {
    return if value < low { low } else { value.min(high) }
}

// Sorts the numbers, few as they are, and keeps one of those within 1e-7 of the one before, as
// `IndirectMerger` joins two shapes' coordinates.
fn merged(values: own List<f64>) -> List<f64> {
    var xs = values
    for i in 1..xs.len() {
        var j = i
        while j > 0 and xs[j - 1] > xs[j] {
            xs.swap(j - 1, j)
            j -= 1
        }
    }
    var out = List<f64>()
    for x in xs {
        if out.len() == 0 or not (out[out.len() - 1] >= x - 0.0000001) {
            out.push(x)
        }
    }
    return out
}

// Adds `x` to `xs` if it's inside a block's face, between 0 and 1.
fn inside(xs: mut List<f64>, x: f64) {
    if x > 0.0 and x < 1.0 {
        xs.push(x)
    }
}

// Whether the rectangles, four numbers each, from u, v to u, v, cover a block's face, from 0, 0
// to 1, 1, between them: as `mergedFaceOccludes` asks `joinIsNotEmpty(block(), their union,
// ONLY_FIRST)`, each cell between their coordinates and the face's edges in one of them.
fn covers_face(rects: List<f64>) -> bool {
    var us: List<f64> = [0.0, 1.0]
    var vs: List<f64> = [0.0, 1.0]
    var r: usize = 0
    while r + 3 < rects.len() {
        inside(mut us, rects[r])
        inside(mut vs, rects[r + 1])
        inside(mut us, rects[r + 2])
        inside(mut vs, rects[r + 3])
        r += 4
    }
    let grid_u = merged(us)
    let grid_v = merged(vs)
    for i in 0..grid_u.len() - 1 {
        let cu = (grid_u[i] + grid_u[i + 1]) / 2.0
        for j in 0..grid_v.len() - 1 {
            let cv = (grid_v[j] + grid_v[j + 1]) / 2.0
            var covered = false
            var q: usize = 0
            while q + 3 < rects.len() and not covered {
                covered = rects[q] < cu and cu < rects[q + 2] and rects[q + 1] < cv and cv < rects[q + 3]
                q += 4
            }
            if not covered {
                return false
            }
        }
    }
    return true
}

pub fn opposite(d: i32) -> i32 {
    return d ^ 1
}

/// A direction's name, as vanilla's `Direction.getSerializedName`.
pub fn direction_name(d: i32) -> String {
    return match d {
        0 => "down",
        1 => "up",
        2 => "north",
        3 => "south",
        4 => "west",
        _ => "east",
    }
}

/// The direction named `name`, if one is.
pub fn direction_named(name: String) -> i32? {
    for d in 0..6 {
        if name == direction_name(d) {
            return some(d)
        }
    }
    return none
}

/// `Direction.Plane.HORIZONTAL`'s order: north, east, south, west.
pub fn horizontal(i: i32) -> i32 {
    return match i {
        0 => NORTH,
        1 => EAST,
        2 => SOUTH,
        _ => WEST,
    }
}

/// `Direction.getClockWise`, of a horizontal direction.
pub fn clockwise(d: i32) -> i32 {
    return match d {
        2 => EAST,
        5 => SOUTH,
        3 => WEST,
        _ => NORTH,
    }
}

/// `SupportType`.
pub const FULL: i32 = 0
pub const CENTER: i32 = 1
pub const RIGID: i32 = 2

/// The fluids, by their IDs in the fluid registry.
pub const EMPTY_FLUID: u32 = 0
pub const FLOWING_WATER: u32 = 1
pub const WATER_FLUID: u32 = 2
pub const FLOWING_LAVA: u32 = 3
pub const LAVA_FLUID: u32 = 4

/// A set of blocks, by ID.
pub struct BlockSet {
    words: List<u64>
}

impl BlockSet {
    /// No blocks, of `blocks` there are.
    pub fn empty(blocks: u32) -> BlockSet {
        return BlockSet { words: [0u64; usize((blocks + 63) / 64)] }
    }

    /// The blocks `ids` holds.
    pub fn of(ids: List<i32>, blocks: u32) -> BlockSet {
        var s = BlockSet.empty(blocks)
        for id in ids {
            s.add(u32.wrap(id))
        }
        return s
    }

    pub fn add(mut self, block: u32) {
        let w = usize(block >> 6)
        self.words[w] = self.words[w] | (1u64 << u64(block & 63))
    }

    pub fn contains(self, block: u32) -> bool {
        let w = usize(block >> 6)
        if w >= self.words.len() {
            return false
        }
        return self.words[w] & (1u64 << u64(block & 63)) != 0
    }
}

/// What features ask of block states and blocks.
pub struct Facts {
    pub codec: StateCodec
    /// Which heightmaps count each state.
    pub table: BlockStates
    pub block_count: u32
    /// Blocks features know by name.
    pub ids: Known
    // The tables, which every copy of these facts shares: each worker has a copy (D220).
    t: Shared<Tables>
}

// What `Facts` knows of each state and block.
struct Tables {
    blocks_of: List<u16>
    flag_bits: List<u32>
    facts: List<u32>
    fluids: List<u8>
    occlusion: List<u8>
    /// How far each state is from what it turns to clockwise a quarter, and what it mirrors to
    /// left to right and front to back.
    turns: List<i16>
    mirrors_left_right: List<i16>
    mirrors_front_back: List<i16>
    classes: List<u32>
    survive: List<u32>
    place_on: List<u32>
    shapes: List<u32>
    // The classes whose `neighborChanged`, `onPlace`, `affectNeighborsAfterRemoval` and `tick`
    // each block runs (D325), `randomTick` (D338) and `handlePrecipitation` (D340).
    neighbours: List<u32>
    places: List<u32>
    removals: List<u32>
    ticks: List<u32>
    random_ticks: List<u32>
    precipitation: List<u32>
    names: List<String>
    flammable: BlockSet
    // `FireBlock`'s odds of each block catching and of its burning away, by block ID (D339).
    ignite: List<u8>
    burn: List<u8>
    waterlogged_blocks: BlockSet
    containers: BlockSet
    dynamic: BlockSet
    parents: List<u32>
    tags: Map<String, BlockSet>
    fluid_tags: Map<String, u32>
    poi_types: Map<u32, i32>
    // Each block's block entity type, as an index into `entity_names`.
    entity_kinds: Map<u32, u32>
    // The states whose outline shape is full where their collision shape isn't, or the other
    // way round.
    outline_flipped: Set<u32>
    // What the states whose bottom doesn't cover all of `WallBlock`'s test shapes or none of
    // them cover.
    wall_covers: Map<u32, u32>
    entity_names: List<String>
    // Each state's six fluid faces, as an index into the different sets of them; for each face
    // the faces it and a fluid can't pass between, and its rectangles (D327).
    fluid_face_sets: List<u64>
    fluid_face_of: List<u16>
    fluid_covers: List<u64>
    face_starts: List<u16>
    face_rects: List<u8>
    // `FlowingFluid.canHoldAnyFluid`: the blocks that hold liquid, and those fluids wash away, by
    // the tag `washed_away_by_fluids` (D328).
    holds: BlockSet
    // The states that move, each as an index into the grids and the starts of their boxes, and
    // each block vanilla offsets by its position.
    moving: Map<u32, usize>
    moving_grids: List<u8>
    moving_starts: List<u16>
    moving_boxes: List<u8>
    offsets: Map<u32, Offset>
    // Each block's instrument, a note block's over it, by its index in `instrument_names`, and
    // the instruments that play from above one, a bit each (D332).
    instruments: List<u8>
    instrument_names: List<String>
    instruments_above: u64
}

// How a block is offset by its position: up and down too, or only across, and how far at most
// each way, `getMaxHorizontalOffset` and `getMaxVerticalOffset`.
struct Offset {
    xyz: bool
    horizontal: f32
    vertical: f32
}

/// The blocks features know by name, by ID, and some of their states.
pub struct Known {
    pub air: u32
    pub cave_air: u32
    pub void_air: u32
    pub water: u32
    pub lava: u32
    pub bedrock: u32
    pub stone: u32
    pub dirt: u32
    pub grass_block: u32
    pub snow: u32
    pub ice: u32
    pub packed_ice: u32
    pub blue_ice: u32
    pub snow_block: u32
    pub obsidian: u32
    pub sand: u32
    pub gravel: u32
    pub mycelium: u32
    pub podzol: u32
    pub farmland: u32
    pub moss_block: u32
    pub soul_sand: u32
    pub magma_block: u32
    pub spawner: u32
    pub chest: u32
    pub cobblestone: u32
    pub mossy_cobblestone: u32
    pub vine: u32
    pub bamboo: u32
    pub sugar_cane: u32
    pub cactus: u32
    pub lily_pad: u32
    pub kelp: u32
    pub kelp_plant: u32
    pub seagrass: u32
    pub tall_seagrass: u32
    pub sea_pickle: u32
    pub pointed_dripstone: u32
    pub dripstone_block: u32
    pub brown_mushroom: u32
    pub red_mushroom: u32
    pub big_dripleaf: u32
    pub big_dripleaf_stem: u32
    pub sculk: u32
    pub sculk_catalyst: u32
    pub sculk_vein: u32
    pub moving_piston: u32
    pub dragon_egg: u32
    pub soul_soil: u32
    pub basalt: u32
    pub redstone_wire: u32
    pub nether_portal: u32
    pub scaffolding: u32
    /// The states of air, cave air, void air, water and lava.
    pub air_state: u32
    pub cave_air_state: u32
    pub void_air_state: u32
    pub water_state: u32
    pub lava_state: u32
}

impl Facts {
    /// The facts of the blocks of `blocks` and the fluids of `fluids`, the `block` and `fluid`
    /// registries, with `table` the heightmaps' view of the states.
    pub fn new(blocks: Registry, fluids: Registry, table: own BlockStates) -> Facts ! String {
        let codec = StateCodec.new(blocks)
        let count = u32.wrap(blocks.entries.len())
        var block = List<u16>()
        block.reserve(usize(table.len()))
        for b in 0..count {
            let n = codec.state_count(b)
            for _ in 0..n {
                block.push(u16.wrap(b))
            }
        }
        var occlusion = List<u8>()
        for v in state_occlusion() {
            occlusion.push(u8.wrap(v))
        }
        let turns = deltas(state_turns())
        let left_right = deltas(state_mirrors_left_right())
        let front_back = deltas(state_mirrors_front_back())
        var fluid_facts = List<u8>()
        for v in state_fluids() {
            fluid_facts.push(u8.wrap(v))
        }
        var tags = Map<String, BlockSet>()
        for t in blocks.tags {
            tags.insert(t.name.to_string(), BlockSet.of(t.values, count))
        }
        var fluid_tags = Map<String, u32>()
        for t in fluids.tags {
            var mask: u32 = 0
            for v in t.values {
                mask |= 1u32 << u32.wrap(v)
            }
            fluid_tags.insert(t.name.to_string(), mask)
        }
        let known = try known_blocks(codec)
        var poi = Map<u32, i32>()
        var entity_kinds = Map<u32, u32>()
        let kinds = block_entity_blocks()
        var k: usize = 0
        while k + 1 < kinds.len() {
            entity_kinds.insert(kinds[k], kinds[k + 1])
            k += 2
        }
        var outline_flipped = Set<u32>()
        for s in outline_differs() {
            outline_flipped.insert(s)
        }
        var wall_covers = Map<u32, u32>()
        let covers = wall_cover()
        var c: usize = 0
        while c + 1 < covers.len() {
            wall_covers.insert(covers[c], covers[c + 1])
            c += 2
        }
        var entity_names = List<String>()
        for n in block_entity_names() {
            entity_names.push(String(n))
        }
        let pairs = poi_states()
        var i: usize = 0
        while i + 1 < pairs.len() {
            poi.insert(pairs[i], i32.wrap(pairs[i + 1]))
            i += 2
        }
        var holds = BlockSet.of(block_ids(waterloggable_blocks()), count)
        for b in liquid_containers() {
            holds.add(b)
        }
        for t in blocks.tags {
            if t.name.to_string() == "minecraft:washed_away_by_fluids" {
                for v in t.values {
                    holds.add(u32.wrap(v))
                }
            }
        }
        let (face_sets, face_of) = state_fluid_faces()
        var instruments = List<u8>()
        for v in block_instruments() {
            instruments.push(u8.wrap(v))
        }
        var played = List<String>()
        for n in instrument_names() {
            played.push(String(n))
        }
        if played.len() > 64 or played.is_empty() or played[0] != "harp" {
            fail String("note blocks' instruments aren't 64 at most from the harp")
        }
        var above: u64 = 0
        for held in instruments_above() {
            above |= 1u64 << u64(held)
        }
        var moving = Map<u32, usize>()
        let movers = moving_states()
        for m in 0..movers.len() {
            moving.insert(movers[m], m)
        }
        var offsets = Map<u32, Offset>()
        let offset_list = offset_blocks()
        var o: usize = 0
        while o + 3 < offset_list.len() {
            offsets.insert(offset_list[o], Offset { xyz: offset_list[o + 1] != 0, horizontal: f32.from_bits(offset_list[o + 2]), vertical: f32.from_bits(offset_list[o + 3]) })
            o += 4
        }
        // `FireBlock`'s ignite and burn odds, 0 for a block that isn't in its maps (D339).
        var ignite = List<u8>()
        var burn = List<u8>()
        for _ in 0..count {
            ignite.push(0)
            burn.push(0)
        }
        let odds = fire_odds()
        var at: usize = 0
        while at + 2 < odds.len() {
            ignite[usize(odds[at])] = u8.wrap(odds[at + 1])
            burn[usize(odds[at])] = u8.wrap(odds[at + 2])
            at += 3
        }
        return Facts {
            codec: codec,
            table: table,
            block_count: count,
            ids: known,
            t: Shared(Tables {
                blocks_of: block,
                flag_bits: state_flags(),
                facts: state_facts(),
                fluids: fluid_facts,
                occlusion: occlusion,
                turns: turns,
                mirrors_left_right: left_right,
                mirrors_front_back: front_back,
                classes: block_classes(),
                survive: survive_classes(),
                place_on: place_on_classes(),
                shapes: shape_classes(),
                neighbours: neighbour_classes(),
                places: place_classes(),
                removals: removal_classes(),
                ticks: tick_classes(),
                random_ticks: random_tick_classes(),
                precipitation: precipitation_classes(),
                flammable: BlockSet.of(block_ids(flammable_blocks()), count),
                ignite: ignite,
                burn: burn,
                waterlogged_blocks: BlockSet.of(block_ids(waterloggable_blocks()), count),
                containers: BlockSet.of(block_ids(liquid_containers()), count),
                dynamic: BlockSet.of(block_ids(dynamic_shape_blocks()), count),
                names: class_names(),
                parents: class_parents(),
                tags: tags,
                fluid_tags: fluid_tags,
                poi_types: poi,
                entity_kinds: entity_kinds,
                outline_flipped: outline_flipped,
                wall_covers: wall_covers,
                entity_names: entity_names,
                fluid_face_sets: face_sets,
                fluid_face_of: face_of,
                fluid_covers: fluid_covers(),
                face_starts: face_starts(),
                face_rects: face_rects(),
                holds: holds,
                moving: moving,
                moving_grids: moving_grids(),
                moving_starts: moving_starts(),
                moving_boxes: moving_boxes(),
                offsets: offsets,
                instruments: instruments,
                instrument_names: played,
                instruments_above: above,
            }),
        }
    }

    /// The face of the state's collision shape toward `d` a fluid sees, as `world.fluid_faces`
    /// numbers them: 0 empty, 1 whole. A state that moves has its face before it's offset here.
    pub fn fluid_face(self, state: u32, d: i32) -> u32 {
        let set = self.t.value.fluid_face_sets[usize(self.t.value.fluid_face_of[usize(state)])]
        return u32.wrap((set >> u64(FLUID_FACE_BITS * u32.wrap(d))) & 255)
    }

    /// Whether the faces `a` and `b` cover a face of a block between them, as
    /// `Shapes.mergedFaceOccludes` says of two faces of the same side.
    pub fn faces_cover(self, a: u32, b: u32) -> bool {
        let word = self.t.value.fluid_covers[usize(a * COVER_WORDS + b / 64)]
        return (word >> u64(b & 63)) & 1 != 0
    }

    /// `BlockStateBase.getOffset`: how far vanilla moves the state at x, z, across and up and
    /// down, as its block's offset function draws it from `Mth.getSeed`, or nothing if it has none.
    pub fn offset(self, state: u32, x: i32, z: i32) -> (f64, f64, f64) {
        if self.t.value.flag_bits[usize(state)] & OFFSET == 0 {
            return (0.0, 0.0, 0.0)
        }
        let block = self.block(state)
        if not self.t.value.offsets.contains(block) {
            return (0.0, 0.0, 0.0)
        }
        let xyz = self.t.value.offsets[block].xyz
        let vertical = self.t.value.offsets[block].vertical
        let seed = position_seed(x, 0, z)
        let most = f64(self.t.value.offsets[block].horizontal)
        let dx = clamp((f64(f32.nearest(seed & 15) / 15.0f32) - 0.5) * 0.5, -most, most)
        let dz = clamp((f64(f32.nearest((seed >> 8) & 15) / 15.0f32) - 0.5) * 0.5, -most, most)
        let dy = if xyz { (f64(f32.nearest((seed >> 4) & 15) / 15.0f32) - 1.0) * f64(vertical) } else { 0.0 }
        return (dx, dy, dz)
    }

    /// `FlowingFluid.canPassThroughWall`: whether a fluid passes between `state` at x, y, z and
    /// `neighbour`, the block toward `d` of it, as the faces between their collision shapes say:
    /// it doesn't where they cover a face of a block between them (D327). A state that moves has
    /// its face where it is worked out from its boxes, but where the other's face is whole.
    pub fn passes_wall(self, d: i32, x: i32, _y: i32, z: i32, state: u32, neighbour: u32) -> bool {
        let back = opposite(d)
        let a = self.fluid_face(state, d)
        let b = self.fluid_face(neighbour, back)
        let a_moves = self.moves(state)
        let b_moves = self.moves(neighbour)
        if not a_moves and not b_moves {
            return not self.faces_cover(a, b)
        }
        if (not a_moves and a == 1) or (not b_moves and b == 1) {
            return false
        }
        var rects = List<f64>()
        self.face_rects_at(mut rects, state, d, x, z, a_moves, a)
        self.face_rects_at(mut rects, neighbour, back, x + step_x(d), z + step_z(d), b_moves, b)
        return not covers_face(rects)
    }

    // Whether the state is one that moves: offset by its position, with a collision shape.
    fn moves(self, state: u32) -> bool {
        return self.t.value.flag_bits[usize(state)] & OFFSET != 0 and self.t.value.moving.contains(state)
    }

    // The rectangles of the state's face toward `d`, four numbers each, from u, v to u, v: its
    // face's, or, if it moves, those of its boxes that reach its grid's end that way, moved by its
    // offset at x, z, if its moved shape reaches that side of its block, as near as
    // `mergedFaceOccludes` asks, `DoubleMath.fuzzyEquals` within 1e-7.
    fn face_rects_at(self, rects: mut List<f64>, state: u32, d: i32, x: i32, z: i32, moves: bool, face: u32) {
        if not moves {
            let from = usize(self.t.value.face_starts[usize(face)])
            let to = usize(self.t.value.face_starts[usize(face) + 1])
            for r in from..to {
                rects.push(units(self.t.value.face_rects[4 * r]))
                rects.push(units(self.t.value.face_rects[4 * r + 1]))
                rects.push(units(self.t.value.face_rects[4 * r + 2]))
                rects.push(units(self.t.value.face_rects[4 * r + 3]))
            }
            return
        }
        let m = self.t.value.moving[state]
        let (ox, oy, oz) = self.offset(state, x, z)
        let off = [ox, oy, oz]
        let axis: usize = if d >= WEST { 0 } else if d >= NORTH { 2 } else { 1 }
        let positive = d % 2 == 1
        let u: usize = if axis == 0 { 1 } else { 0 }
        let v: usize = if axis == 2 { 1 } else { 2 }
        let side: usize = if positive { axis + 3 } else { axis }
        let from = usize(self.t.value.moving_starts[m])
        let to = usize(self.t.value.moving_starts[m + 1])
        var reach = units(self.t.value.moving_boxes[6 * from + side])
        for b in from..to {
            let c = units(self.t.value.moving_boxes[6 * b + side])
            if (positive and c > reach) or (not positive and c < reach) {
                reach = c
            }
        }
        let moved = reach + off[axis]
        let edge = if positive { 1.0 } else { 0.0 }
        if (moved - edge).abs() > 0.0000001 {
            return
        }
        let end = units(self.t.value.moving_grids[6 * m + side])
        for b in from..to {
            if units(self.t.value.moving_boxes[6 * b + side]) == end {
                rects.push(units(self.t.value.moving_boxes[6 * b + u]) + off[u])
                rects.push(units(self.t.value.moving_boxes[6 * b + v]) + off[v])
                rects.push(units(self.t.value.moving_boxes[6 * b + u + 3]) + off[u])
                rects.push(units(self.t.value.moving_boxes[6 * b + v + 3]) + off[v])
            }
        }
    }

    /// `BlockState.rotate`: the state turned `rotation`, in `Rotation` order: none, clockwise 90,
    /// 180, counterclockwise 90.
    pub fn rotate(self, state: u32, rotation: i32) -> u32 {
        var s = state
        for _ in 0..rotation {
            s = u32.wrap(i64(s) + i64(self.t.value.turns[usize(s)]))
        }
        return s
    }

    /// `BlockState.mirror`: the state mirrored `mirror`, in `Mirror` order: none, left to right
    /// (north and south swap), front to back (east and west).
    pub fn mirror(self, state: u32, mirror: i32) -> u32 {
        return match mirror {
            1 => u32.wrap(i64(state) + i64(self.t.value.mirrors_left_right[usize(state)])),
            2 => u32.wrap(i64(state) + i64(self.t.value.mirrors_front_back[usize(state)])),
            _ => state,
        }
    }

    /// The type of the block's block entity, as `minecraft:chest`, if it has one.
    pub fn block_entity_kind(self, block: u32) -> String? {
        let i = self.t.value.entity_kinds.get(block) else return none
        return some(self.t.value.entity_names[usize(i)].copy())
    }

    /// The point of interest type the state is, by its ID, or -1: `PoiTypes.forState`.
    pub fn poi(self, state: u32) -> i32 {
        return self.t.value.poi_types.get(state) ?? -1
    }

    /// The block the state is of.
    pub fn block(self, state: u32) -> u32 {
        return u32(self.t.value.blocks_of[usize(state)])
    }

    /// Whether the state is of the block `block`: `is(Block)`.
    pub fn is(self, state: u32, block: u32) -> bool {
        return u32(self.t.value.blocks_of[usize(state)]) == block
    }

    /// The block's default state.
    pub fn default_state(self, block: u32) -> u32 {
        return self.codec.default_state(block)
    }

    pub fn flags(self, state: u32) -> u32 {
        return self.t.value.flag_bits[usize(state)]
    }

    /// `isAir`.
    pub fn is_air(self, state: u32) -> bool {
        return self.t.value.flag_bits[usize(state)] & AIR != 0
    }

    /// `hasBlockEntity`.
    pub fn has_block_entity(self, state: u32) -> bool {
        return self.t.value.flag_bits[usize(state)] & BLOCK_ENTITY != 0
    }

    pub fn light_emission(self, state: u32) -> i32 {
        return i32.wrap((self.t.value.flag_bits[usize(state)] >> LIGHT_EMISSION_SHIFT) & 15)
    }

    /// Whether the state's occlusion shape covers its face toward `d` whole:
    /// `Block.isShapeFullBlock(getFaceOcclusionShape(d))`.
    pub fn occludes_face(self, state: u32, d: i32) -> bool {
        return u32(self.t.value.occlusion[usize(state)]) & (1u32 << u32.wrap(d)) != 0
    }

    /// `isSolidRender`: a whole cube that hides what's behind it.
    pub fn solid_render(self, state: u32) -> bool {
        return self.t.value.flag_bits[usize(state)] & SOLID_RENDER != 0
    }

    /// `isSolid`, the legacy solidity.
    pub fn is_solid(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & SOLID != 0
    }

    /// `canBeReplaced()`.
    pub fn replaceable(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & REPLACEABLE != 0
    }

    /// `liquid()`: water or lava itself.
    pub fn is_liquid(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & LIQUID != 0
    }

    pub fn ignited_by_lava(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & IGNITED_BY_LAVA != 0
    }

    pub fn redstone_conductor(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & REDSTONE_CONDUCTOR != 0
    }

    /// `Block.isShapeFullBlock` of the state's shape, its outline, where it stands alone.
    pub fn shape_full_block(self, state: u32) -> bool {
        return self.collision_full_block(state) != self.t.value.outline_flipped.contains(state)
    }

    /// `isCollisionShapeFullBlock`.
    pub fn collision_full_block(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & COLLISION_FULL_BLOCK != 0
    }

    /// `isFaceSturdy` of the face toward `d`, for `support`.
    pub fn sturdy(self, state: u32, d: i32, support: i32) -> bool {
        let shift = if support == FULL { STURDY_FULL_SHIFT } else if support == CENTER { STURDY_CENTER_SHIFT } else { STURDY_RIGID_SHIFT }
        return self.t.value.facts[usize(state)] & (1u32 << (shift + u32.wrap(d))) != 0
    }

    /// The state's fluid, by its ID in the fluid registry: `getFluidState().getType()`.
    pub fn fluid(self, state: u32) -> u32 {
        return u32(self.t.value.fluids[usize(state)]) >> 4
    }

    /// The state's fluid's amount, 0 to 8.
    pub fn fluid_amount(self, state: u32) -> i32 {
        return i32(self.t.value.fluids[usize(state)]) & 15
    }

    /// Whether the state's fluid is water, flowing or not: `is(FluidTags.WATER)` as vanilla's
    /// data has it.
    pub fn is_water(self, state: u32) -> bool {
        let f = self.fluid(state)
        return f == WATER_FLUID or f == FLOWING_WATER
    }

    pub fn is_lava(self, state: u32) -> bool {
        let f = self.fluid(state)
        return f == LAVA_FLUID or f == FLOWING_LAVA
    }

    /// Whether the state's fluid is a source: `FluidState.isSource`.
    pub fn is_source(self, state: u32) -> bool {
        let f = self.fluid(state)
        return f == WATER_FLUID or f == LAVA_FLUID
    }

    /// Whether the state's fluid is in the fluid tag `name`, as `minecraft:water`.
    pub fn fluid_in(self, state: u32, name: String) -> bool {
        let mask = self.t.value.fluid_tags.get(name) ?? 0
        return mask & (1u32 << self.fluid(state)) != 0
    }

    /// The block tag `name`, as `minecraft:dirt`: empty if there's none, as a `TagKey` that
    /// names no tag holds nothing.
    pub fn tag(self, name: String) -> BlockSet {
        return self.tag_or_empty(name)
    }

    /// The block tag `name`, as `minecraft:dirt`, empty if there's none.
    pub fn tag_or_empty(self, name: String) -> BlockSet {
        if self.t.value.tags.contains(name) {
            return self.t.value.tags[name].copy()
        }
        return BlockSet.empty(self.block_count)
    }

    /// The block tag `name`, if there's one.
    pub fn find_tag(self, name: String) -> BlockSet? {
        if self.t.value.tags.contains(name) {
            return some(self.t.value.tags[name].copy())
        }
        return none
    }

    /// Whether the state's block is in `set`.
    pub fn in_set(self, state: u32, set: BlockSet) -> bool {
        return set.contains(u32(self.t.value.blocks_of[usize(state)]))
    }

    /// The class whose `canSurvive` the block runs, as `VegetationBlock`.
    pub fn survive_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.survive[usize(block)])].copy()
    }

    /// `FireBlock.canBurn`: a block fire burns, not waterlogged.
    pub fn can_burn(self, state: u32) -> bool {
        return self.in_set(state, self.t.value.flammable) and not self.get_bool(state, "waterlogged")
    }

    /// `FireBlock.getIgniteOdds` of the state: how likely fire beside it is to catch it, 0 where
    /// it's waterlogged (D339).
    pub fn ignite_odds(self, state: u32) -> i32 {
        if self.get_bool(state, "waterlogged") {
            return 0
        }
        return i32(self.t.value.ignite[usize(self.t.value.blocks_of[usize(state)])])
    }

    /// `FireBlock.getBurnOdds` of the state: how likely fire beside it is to burn it away, 0
    /// where it's waterlogged (D339).
    pub fn burn_odds(self, state: u32) -> i32 {
        if self.get_bool(state, "waterlogged") {
            return 0
        }
        return i32(self.t.value.burn[usize(self.t.value.blocks_of[usize(state)])])
    }

    /// Whether the block is a `SimpleWaterloggedBlock`.
    pub fn waterloggable(self, block: u32) -> bool {
        return self.t.value.waterlogged_blocks.contains(block)
    }

    /// `Block.hasDynamicShape`: whether the block's shape can change where it stands.
    pub fn dynamic_shape(self, block: u32) -> bool {
        return self.t.value.dynamic.contains(block)
    }

    /// Whether the block is a `LiquidBlockContainer`: a `SimpleWaterloggedBlock`, or kelp or
    /// seagrass, which take no liquid.
    pub fn liquid_container(self, block: u32) -> bool {
        return self.t.value.waterlogged_blocks.contains(block) or self.t.value.containers.contains(block)
    }

    /// Whether the block is a `LiquidBlockContainer` that isn't a `SimpleWaterloggedBlock`: kelp
    /// or seagrass, whose `canPlaceLiquid` and `placeLiquid` say no.
    pub fn fixed_container(self, block: u32) -> bool {
        return self.t.value.containers.contains(block)
    }

    /// `FlowingFluid.canHoldAnyFluid`: whether the state's block holds liquid, or is one fluids
    /// wash away, in the tag `washed_away_by_fluids` (D328).
    pub fn holds_fluid(self, state: u32) -> bool {
        return self.t.value.holds.contains(self.block(state))
    }

    /// Whether the fluid, by its ID in the fluid registry, is in the fluid tag `name`, as
    /// `Fluid.is(TagKey)` asks.
    pub fn fluid_type_in(self, fluid: u32, name: String) -> bool {
        let mask = self.t.value.fluid_tags.get(name) ?? 0
        return mask & (1u32 << fluid) != 0
    }

    /// The class whose `updateShape` the block runs, as `LeavesBlock`.
    pub fn shape_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.shapes[usize(block)])].copy()
    }

    /// The class whose `neighborChanged` the block runs, as `LiquidBlock`, or `BlockBehaviour`'s,
    /// which does nothing (D325).
    pub fn neighbour_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.neighbours[usize(block)])].copy()
    }

    /// The class whose `onPlace` the block runs (D325).
    pub fn place_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.places[usize(block)])].copy()
    }

    /// The class whose `affectNeighborsAfterRemoval` the block runs (D325).
    pub fn removal_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.removals[usize(block)])].copy()
    }

    /// The class whose `tick`, what its scheduled tick does, the block runs (D325).
    pub fn tick_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.ticks[usize(block)])].copy()
    }

    /// The class whose `randomTick`, what it does as a random tick comes to it, the block runs
    /// (D338).
    pub fn random_tick_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.random_ticks[usize(block)])].copy()
    }

    /// The class whose `handlePrecipitation`, what it does as rain or snow falls on it, the block
    /// runs (D340).
    pub fn precipitation_class(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.precipitation[usize(block)])].copy()
    }

    /// The class whose `mayPlaceOn` the block runs, empty if none does.
    pub fn place_on_class(self, block: u32) -> String {
        let i = usize(self.t.value.place_on[usize(block)])
        if i >= self.t.value.names.len() {
            return String()
        }
        return self.t.value.names[i].copy()
    }

    /// Whether the block's class is `name` or extends it: `instanceof`.
    pub fn is_a(self, block: u32, name: String) -> bool {
        var c = usize(self.t.value.classes[usize(block)])
        while c < self.t.value.names.len() {
            if self.t.value.names[c] == name {
                return true
            }
            c = usize(self.t.value.parents[c])
        }
        return false
    }

    /// Whether the state's collision shape covers its face toward `d` whole: `Block.isFaceFull`.
    pub fn collision_face_full(self, state: u32, d: i32) -> bool {
        return self.t.value.facts[usize(state)] & (1u32 << (COLLISION_FACE_SHIFT + u32.wrap(d))) != 0
    }

    /// Which of `WallBlock`'s test shapes the bottom of the state's collision shape covers,
    /// `isCovered`: a bit for the post's, then the north, east, south and west wall's.
    pub fn wall_cover(self, state: u32) -> u32 {
        if let mask = self.t.value.wall_covers.get(state) {
            return mask
        }
        return if self.collision_face_full(state, DOWN) { 31 } else { 0 }
    }

    /// Whether the state's collision shape is empty: `getCollisionShape(level, pos).isEmpty()`.
    pub fn collision_empty(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & COLLISION_EMPTY != 0
    }

    /// Whether the state's collision shape touches the top of its block.
    pub fn collision_top_any(self, state: u32) -> bool {
        return self.t.value.facts[usize(state)] & COLLISION_TOP_ANY != 0
    }

    /// The block `minecraft:{name}`, which vanilla has.
    pub fn named_block(self, name: String) -> u32 ! Thrown {
        return match self.codec.blocks.parse("minecraft:{name}") {
            ok(b) => b,
            err(e) => fail Thrown { exception: "IllegalStateException", message: e },
        }
    }

    /// The instrument a note block plays over the state, `instrument()`, by its index in
    /// `NoteBlockInstrument`'s order, where the harp's 0 (D332).
    pub fn instrument(self, state: u32) -> u32 {
        return u32(self.t.value.instruments[usize(self.block(state))])
    }

    /// The instrument's name, as a note block's `instrument` has it.
    pub fn instrument_name(self, instrument: u32) -> String {
        return self.t.value.instrument_names[usize(instrument)].copy()
    }

    /// Whether the instrument plays from above a note block, a head's: `worksAboveNoteBlock`.
    pub fn plays_above(self, instrument: u32) -> bool {
        return self.t.value.instruments_above & (1u64 << u64(instrument)) != 0
    }

    /// The name of the class the block is, as `FlowerBlock`.
    pub fn class_name(self, block: u32) -> String {
        return self.t.value.names[usize(self.t.value.classes[usize(block)])].copy()
    }

    /// The block named `name`, as `minecraft:stone`.
    pub fn block_named(self, name: String) -> u32? {
        return match self.codec.blocks.parse(name) {
            ok(b) => some(b),
            err(_) => none,
        }
    }

    /// The property `name` of the state's block.
    pub fn prop(self, state: u32, name: String) -> Prop? {
        return self.codec.prop(self.block(state), name)
    }

    /// The state's value of its boolean property `name`, false if it has none.
    pub fn get_bool(self, state: u32, name: String) -> bool {
        let p = self.prop(state, name) else return false
        return p.get(state) == 0
    }

    /// The state's value of its integer property `name`.
    pub fn get_int(self, state: u32, name: String) -> i32? {
        let p = self.prop(state, name) else return none
        let low = self.codec.int_start(p) else return none
        return some(low + i32.wrap(p.get(state)))
    }

    /// The name of the state's value of its property `name`.
    pub fn get_name(self, state: u32, name: String) -> String? {
        let p = self.prop(state, name) else return none
        return some(self.codec.value_name(p, p.get(state)))
    }

    /// Whether the state's block has a property `name`.
    pub fn has(self, state: u32, name: String) -> bool {
        return self.prop(state, name) != none
    }

    /// The state with its boolean property `name` set to `value`: `setValue`, which vanilla
    /// throws on for a block without it.
    pub fn with_bool(self, state: u32, name: String, value: bool) -> u32 ! Thrown {
        let p = self.prop(state, name) else fail self.no_property(name, state)
        return p.set(state, if value { 0 } else { 1 })
    }

    /// `trySetValue`: the state unchanged if its block has no such property.
    pub fn try_bool(self, state: u32, name: String, value: bool) -> u32 {
        let p = self.prop(state, name) else return state
        return p.set(state, if value { 0 } else { 1 })
    }

    /// The state with its integer property `name` set to `value`.
    pub fn with_int(self, state: u32, name: String, value: i32) -> u32 ! Thrown {
        let p = self.prop(state, name) else fail self.no_property(name, state)
        let low = self.codec.int_start(p) else fail self.no_property(name, state)
        let i = value - low
        if i < 0 or u32.wrap(i) >= p.count {
            fail Thrown { exception: "IllegalArgumentException", message: "Cannot set property {name} to {value} on {self.codec.blocks.name(self.block(state))}, it is not an allowed value" }
        }
        return p.set(state, u32.wrap(i))
    }

    /// The state with its property `name` set to the value named `value`.
    pub fn with_name(self, state: u32, name: String, value: String) -> u32 ! Thrown {
        let p = self.prop(state, name) else fail self.no_property(name, state)
        let i = self.codec.index_of(p, value) else fail Thrown { exception: "IllegalArgumentException", message: "Cannot set property {name} to {value} on {self.codec.blocks.name(self.block(state))}, it is not an allowed value" }
        return p.set(state, i)
    }

    /// `trySetValue` by name.
    pub fn try_name(self, state: u32, name: String, value: String) -> u32 {
        let p = self.prop(state, name) else return state
        let i = self.codec.index_of(p, value) else return state
        return p.set(state, i)
    }

    // What `setValue` throws for a property the state doesn't have.
    fn no_property(self, name: String, state: u32) -> Thrown {
        return Thrown { exception: "IllegalArgumentException", message: "Cannot set property {name} as it does not exist in {self.codec.blocks.name(self.block(state))}" }
    }
}

fn known_blocks(codec: StateCodec) -> Known ! String {
    let air = try named(codec, "air")
    let cave_air = try named(codec, "cave_air")
    let void_air = try named(codec, "void_air")
    let water = try named(codec, "water")
    let lava = try named(codec, "lava")
    return Known {
        air: air,
        cave_air: cave_air,
        void_air: void_air,
        water: water,
        lava: lava,
        bedrock: try named(codec, "bedrock"),
        stone: try named(codec, "stone"),
        dirt: try named(codec, "dirt"),
        grass_block: try named(codec, "grass_block"),
        snow: try named(codec, "snow"),
        ice: try named(codec, "ice"),
        packed_ice: try named(codec, "packed_ice"),
        blue_ice: try named(codec, "blue_ice"),
        snow_block: try named(codec, "snow_block"),
        obsidian: try named(codec, "obsidian"),
        sand: try named(codec, "sand"),
        gravel: try named(codec, "gravel"),
        mycelium: try named(codec, "mycelium"),
        podzol: try named(codec, "podzol"),
        farmland: try named(codec, "farmland"),
        moss_block: try named(codec, "moss_block"),
        soul_sand: try named(codec, "soul_sand"),
        magma_block: try named(codec, "magma_block"),
        spawner: try named(codec, "spawner"),
        chest: try named(codec, "chest"),
        cobblestone: try named(codec, "cobblestone"),
        mossy_cobblestone: try named(codec, "mossy_cobblestone"),
        vine: try named(codec, "vine"),
        bamboo: try named(codec, "bamboo"),
        sugar_cane: try named(codec, "sugar_cane"),
        cactus: try named(codec, "cactus"),
        lily_pad: try named(codec, "lily_pad"),
        kelp: try named(codec, "kelp"),
        kelp_plant: try named(codec, "kelp_plant"),
        seagrass: try named(codec, "seagrass"),
        tall_seagrass: try named(codec, "tall_seagrass"),
        sea_pickle: try named(codec, "sea_pickle"),
        pointed_dripstone: try named(codec, "pointed_dripstone"),
        dripstone_block: try named(codec, "dripstone_block"),
        brown_mushroom: try named(codec, "brown_mushroom"),
        red_mushroom: try named(codec, "red_mushroom"),
        big_dripleaf: try named(codec, "big_dripleaf"),
        big_dripleaf_stem: try named(codec, "big_dripleaf_stem"),
        sculk: try named(codec, "sculk"),
        sculk_catalyst: try named(codec, "sculk_catalyst"),
        sculk_vein: try named(codec, "sculk_vein"),
        moving_piston: try named(codec, "moving_piston"),
        dragon_egg: try named(codec, "dragon_egg"),
        soul_soil: try named(codec, "soul_soil"),
        basalt: try named(codec, "basalt"),
        redstone_wire: try named(codec, "redstone_wire"),
        nether_portal: try named(codec, "nether_portal"),
        scaffolding: try named(codec, "scaffolding"),
        air_state: codec.default_state(air),
        cave_air_state: codec.default_state(cave_air),
        void_air_state: codec.default_state(void_air),
        water_state: codec.default_state(water),
        lava_state: codec.default_state(lava),
    }
}

fn named(codec: StateCodec, name: String) -> u32 ! String {
    return match codec.blocks.parse("minecraft:{name}") {
        ok(b) => b,
        err(e) => fail e,
    }
}

// Blocks' IDs, as `BlockSet.of` takes them.
fn block_ids(blocks: List<u32>) -> List<i32> {
    var out = List<i32>()
    for b in blocks {
        out.push(i32.wrap(b))
    }
    return out
}

// A table of how far states are from others, as u32s that wrap, as small signed numbers.
fn deltas(table: List<u32>) -> List<i16> {
    var out = List<i16>()
    out.reserve(table.len())
    for v in table {
        out.push(i16.wrap(i32.wrap(v)))
    }
    return out
}
