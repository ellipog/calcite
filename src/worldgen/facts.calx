/// What features ask of block states and blocks: which block a state is, its flags and the facts
/// `world.block_facts` holds, its fluid, its block's class and tags, and its properties. Built
/// once from the loaded block and fluid registries.
module worldgen.facts

import registry.registry.{Registry}
import world.block_facts.{COLLISION_FACE_SHIFT, COLLISION_FULL_BLOCK, COLLISION_TOP_ANY, IGNITED_BY_LAVA, LIQUID, REDSTONE_CONDUCTOR, REPLACEABLE, SOLID, STURDY_CENTER_SHIFT, STURDY_FULL_SHIFT, STURDY_RIGID_SHIFT, block_classes, class_names, class_parents, place_on_classes, poi_states, state_facts, state_fluids, state_occlusion, survive_classes}
import world.block_flags.{AIR, BLOCK_ENTITY, LIGHT_EMISSION_SHIFT, SOLID_RENDER, state_flags}
import world.chunk.{BlockStates}
import world.states.{Prop, StateCodec}
import worldgen.interval.{Thrown}

/// `Direction`, by its ordinal: down, up, north, south, west, east.
pub const DOWN: i32 = 0
pub const UP: i32 = 1
pub const NORTH: i32 = 2
pub const SOUTH: i32 = 3
pub const WEST: i32 = 4
pub const EAST: i32 = 5

/// A direction's step on each axis.
pub fn step_x(d: i32) -> i32 {
    return if d == WEST { -1 } else if d == EAST { 1 } else { 0 }
}

pub fn step_y(d: i32) -> i32 {
    return if d == DOWN { -1 } else if d == UP { 1 } else { 0 }
}

pub fn step_z(d: i32) -> i32 {
    return if d == NORTH { -1 } else if d == SOUTH { 1 } else { 0 }
}

/// The direction the other way.
pub fn opposite(d: i32) -> i32 {
    return d ^ 1
}

/// A direction's name, as vanilla's `Direction.getSerializedName`.
pub fn direction_name(d: i32) -> String {
    return match d {
        0 => "down",
        1 => "up",
        2 => "north",
        3 => "south",
        4 => "west",
        _ => "east",
    }
}

/// The direction named `name`, if one is.
pub fn direction_named(name: String) -> i32? {
    for d in 0..6 {
        if name == direction_name(d) {
            return some(d)
        }
    }
    return none
}

/// `Direction.Plane.HORIZONTAL`'s order: north, east, south, west.
pub fn horizontal(i: i32) -> i32 {
    return match i {
        0 => NORTH,
        1 => EAST,
        2 => SOUTH,
        _ => WEST,
    }
}

/// `Direction.getClockWise`, of a horizontal direction.
pub fn clockwise(d: i32) -> i32 {
    return match d {
        2 => EAST,
        5 => SOUTH,
        3 => WEST,
        _ => NORTH,
    }
}

/// `SupportType`.
pub const FULL: i32 = 0
pub const CENTER: i32 = 1
pub const RIGID: i32 = 2

/// The fluids, by their IDs in the fluid registry.
pub const EMPTY_FLUID: u32 = 0
pub const FLOWING_WATER: u32 = 1
pub const WATER_FLUID: u32 = 2
pub const FLOWING_LAVA: u32 = 3
pub const LAVA_FLUID: u32 = 4

/// A set of blocks, by ID.
pub struct BlockSet {
    words: List<u64>
}

impl BlockSet {
    /// No blocks, of `blocks` there are.
    pub fn empty(blocks: u32) -> BlockSet {
        return BlockSet { words: [0u64; usize((blocks + 63) / 64)] }
    }

    /// The blocks `ids` holds.
    pub fn of(ids: List<i32>, blocks: u32) -> BlockSet {
        var s = BlockSet.empty(blocks)
        for id in ids {
            s.add(u32.wrap(id))
        }
        return s
    }

    pub fn add(mut self, block: u32) {
        let w = usize(block >> 6)
        self.words[w] = self.words[w] | (1u64 << u64(block & 63))
    }

    pub fn contains(self, block: u32) -> bool {
        let w = usize(block >> 6)
        if w >= self.words.len() {
            return false
        }
        return self.words[w] & (1u64 << u64(block & 63)) != 0
    }
}

/// What features ask of block states and blocks.
pub struct Facts {
    pub codec: StateCodec
    /// Which heightmaps count each state.
    pub table: BlockStates
    blocks_of: List<u16>
    flag_bits: List<u32>
    facts: List<u32>
    fluids: List<u8>
    occlusion: List<u8>
    classes: List<u32>
    survive: List<u32>
    place_on: List<u32>
    names: List<String>
    parents: List<u32>
    tags: Map<String, BlockSet>
    fluid_tags: Map<String, u32>
    poi_types: Map<u32, i32>
    pub block_count: u32
    /// Blocks features know by name.
    pub ids: Known
}

/// The blocks features know by name, by ID, and some of their states.
pub struct Known {
    pub air: u32
    pub cave_air: u32
    pub void_air: u32
    pub water: u32
    pub lava: u32
    pub bedrock: u32
    pub stone: u32
    pub dirt: u32
    pub grass_block: u32
    pub snow: u32
    pub ice: u32
    pub packed_ice: u32
    pub blue_ice: u32
    pub snow_block: u32
    pub obsidian: u32
    pub sand: u32
    pub gravel: u32
    pub mycelium: u32
    pub podzol: u32
    pub farmland: u32
    pub moss_block: u32
    pub soul_sand: u32
    pub magma_block: u32
    pub spawner: u32
    pub chest: u32
    pub cobblestone: u32
    pub mossy_cobblestone: u32
    pub vine: u32
    pub bamboo: u32
    pub sugar_cane: u32
    pub cactus: u32
    pub lily_pad: u32
    pub kelp: u32
    pub kelp_plant: u32
    pub seagrass: u32
    pub tall_seagrass: u32
    pub sea_pickle: u32
    pub pointed_dripstone: u32
    pub dripstone_block: u32
    pub brown_mushroom: u32
    pub red_mushroom: u32
    pub big_dripleaf: u32
    pub big_dripleaf_stem: u32
    pub sculk: u32
    pub sculk_catalyst: u32
    pub sculk_vein: u32
    pub moving_piston: u32
    /// The states of air, cave air, void air, water and lava.
    pub air_state: u32
    pub cave_air_state: u32
    pub void_air_state: u32
    pub water_state: u32
    pub lava_state: u32
}

impl Facts {
    /// The facts of the blocks of `blocks` and the fluids of `fluids`, the `block` and `fluid`
    /// registries, with `table` the heightmaps' view of the states.
    pub fn new(blocks: Registry, fluids: Registry, table: own BlockStates) -> Facts ! String {
        let codec = StateCodec.new(blocks)
        let count = u32.wrap(blocks.entries.len())
        var block = List<u16>()
        block.reserve(usize(table.len()))
        for b in 0..count {
            let n = codec.state_count(b)
            for _ in 0..n {
                block.push(u16.wrap(b))
            }
        }
        var occlusion = List<u8>()
        for v in state_occlusion() {
            occlusion.push(u8.wrap(v))
        }
        var fluid_facts = List<u8>()
        for v in state_fluids() {
            fluid_facts.push(u8.wrap(v))
        }
        var tags = Map<String, BlockSet>()
        for t in blocks.tags {
            tags.insert(t.name.to_string(), BlockSet.of(t.values, count))
        }
        var fluid_tags = Map<String, u32>()
        for t in fluids.tags {
            var mask: u32 = 0
            for v in t.values {
                mask |= 1u32 << u32.wrap(v)
            }
            fluid_tags.insert(t.name.to_string(), mask)
        }
        let known = try known_blocks(codec)
        var poi = Map<u32, i32>()
        let pairs = poi_states()
        var i: usize = 0
        while i + 1 < pairs.len() {
            poi.insert(pairs[i], i32.wrap(pairs[i + 1]))
            i += 2
        }
        return Facts {
            codec: codec,
            table: table,
            blocks_of: block,
            flag_bits: state_flags(),
            facts: state_facts(),
            fluids: fluid_facts,
            occlusion: occlusion,
            classes: block_classes(),
            survive: survive_classes(),
            place_on: place_on_classes(),
            names: class_names(),
            parents: class_parents(),
            tags: tags,
            fluid_tags: fluid_tags,
            poi_types: poi,
            block_count: count,
            ids: known,
        }
    }

    /// The point of interest type the state is, by its ID, or -1: `PoiTypes.forState`.
    pub fn poi(self, state: u32) -> i32 {
        return self.poi_types.get(state) ?? -1
    }

    /// The block the state is of.
    pub fn block(self, state: u32) -> u32 {
        return u32(self.blocks_of[usize(state)])
    }

    /// Whether the state is of the block `block`: `is(Block)`.
    pub fn is(self, state: u32, block: u32) -> bool {
        return u32(self.blocks_of[usize(state)]) == block
    }

    /// The block's default state.
    pub fn default_state(self, block: u32) -> u32 {
        return self.codec.default_state(block)
    }

    pub fn flags(self, state: u32) -> u32 {
        return self.flag_bits[usize(state)]
    }

    /// `isAir`.
    pub fn is_air(self, state: u32) -> bool {
        return self.flag_bits[usize(state)] & AIR != 0
    }

    /// `hasBlockEntity`.
    pub fn has_block_entity(self, state: u32) -> bool {
        return self.flag_bits[usize(state)] & BLOCK_ENTITY != 0
    }

    pub fn light_emission(self, state: u32) -> i32 {
        return i32.wrap((self.flag_bits[usize(state)] >> LIGHT_EMISSION_SHIFT) & 15)
    }

    /// Whether the state's occlusion shape covers its face toward `d` whole:
    /// `Block.isShapeFullBlock(getFaceOcclusionShape(d))`.
    pub fn occludes_face(self, state: u32, d: i32) -> bool {
        return u32(self.occlusion[usize(state)]) & (1u32 << u32.wrap(d)) != 0
    }

    /// `isSolidRender`: a whole cube that hides what's behind it.
    pub fn solid_render(self, state: u32) -> bool {
        return self.flag_bits[usize(state)] & SOLID_RENDER != 0
    }

    /// `isSolid`, the legacy solidity.
    pub fn is_solid(self, state: u32) -> bool {
        return self.facts[usize(state)] & SOLID != 0
    }

    /// `canBeReplaced()`.
    pub fn replaceable(self, state: u32) -> bool {
        return self.facts[usize(state)] & REPLACEABLE != 0
    }

    /// `liquid()`: water or lava itself.
    pub fn is_liquid(self, state: u32) -> bool {
        return self.facts[usize(state)] & LIQUID != 0
    }

    pub fn ignited_by_lava(self, state: u32) -> bool {
        return self.facts[usize(state)] & IGNITED_BY_LAVA != 0
    }

    pub fn redstone_conductor(self, state: u32) -> bool {
        return self.facts[usize(state)] & REDSTONE_CONDUCTOR != 0
    }

    /// `isCollisionShapeFullBlock`.
    pub fn collision_full_block(self, state: u32) -> bool {
        return self.facts[usize(state)] & COLLISION_FULL_BLOCK != 0
    }

    /// `isFaceSturdy` of the face toward `d`, for `support`.
    pub fn sturdy(self, state: u32, d: i32, support: i32) -> bool {
        let shift = if support == FULL { STURDY_FULL_SHIFT } else if support == CENTER { STURDY_CENTER_SHIFT } else { STURDY_RIGID_SHIFT }
        return self.facts[usize(state)] & (1u32 << (shift + u32.wrap(d))) != 0
    }

    /// The state's fluid, by its ID in the fluid registry: `getFluidState().getType()`.
    pub fn fluid(self, state: u32) -> u32 {
        return u32(self.fluids[usize(state)]) >> 4
    }

    /// The state's fluid's amount, 0 to 8.
    pub fn fluid_amount(self, state: u32) -> i32 {
        return i32(self.fluids[usize(state)]) & 15
    }

    /// Whether the state's fluid is water, flowing or not: `is(FluidTags.WATER)` as vanilla's
    /// data has it.
    pub fn is_water(self, state: u32) -> bool {
        let f = self.fluid(state)
        return f == WATER_FLUID or f == FLOWING_WATER
    }

    pub fn is_lava(self, state: u32) -> bool {
        let f = self.fluid(state)
        return f == LAVA_FLUID or f == FLOWING_LAVA
    }

    /// Whether the state's fluid is a source: `FluidState.isSource`.
    pub fn is_source(self, state: u32) -> bool {
        let f = self.fluid(state)
        return f == WATER_FLUID or f == LAVA_FLUID
    }

    /// Whether the state's fluid is in the fluid tag `name`, as `minecraft:water`.
    pub fn fluid_in(self, state: u32, name: String) -> bool {
        let mask = self.fluid_tags.get(name) ?? 0
        return mask & (1u32 << self.fluid(state)) != 0
    }

    /// The block tag `name`, as `minecraft:dirt`: empty if there's none, as a `TagKey` that
    /// names no tag holds nothing.
    pub fn tag(self, name: String) -> BlockSet {
        return self.tag_or_empty(name)
    }

    /// The block tag `name`, as `minecraft:dirt`, empty if there's none.
    pub fn tag_or_empty(self, name: String) -> BlockSet {
        if self.tags.contains(name) {
            return self.tags[name].copy()
        }
        return BlockSet.empty(self.block_count)
    }

    /// The block tag `name`, if there's one.
    pub fn find_tag(self, name: String) -> BlockSet? {
        if self.tags.contains(name) {
            return some(self.tags[name].copy())
        }
        return none
    }

    /// Whether the state's block is in `set`.
    pub fn in_set(self, state: u32, set: BlockSet) -> bool {
        return set.contains(u32(self.blocks_of[usize(state)]))
    }

    /// The class whose `canSurvive` the block runs, as `VegetationBlock`.
    pub fn survive_class(self, block: u32) -> String {
        return self.names[usize(self.survive[usize(block)])].copy()
    }

    /// The class whose `mayPlaceOn` the block runs, empty if none does.
    pub fn place_on_class(self, block: u32) -> String {
        let i = usize(self.place_on[usize(block)])
        if i >= self.names.len() {
            return String()
        }
        return self.names[i].copy()
    }

    /// Whether the block's class is `name` or extends it: `instanceof`.
    pub fn is_a(self, block: u32, name: String) -> bool {
        var c = usize(self.classes[usize(block)])
        while c < self.names.len() {
            if self.names[c] == name {
                return true
            }
            c = usize(self.parents[c])
        }
        return false
    }

    /// Whether the state's collision shape covers its face toward `d` whole: `Block.isFaceFull`.
    pub fn collision_face_full(self, state: u32, d: i32) -> bool {
        return self.facts[usize(state)] & (1u32 << (COLLISION_FACE_SHIFT + u32.wrap(d))) != 0
    }

    /// Whether the state's collision shape touches the top of its block.
    pub fn collision_top_any(self, state: u32) -> bool {
        return self.facts[usize(state)] & COLLISION_TOP_ANY != 0
    }

    /// The block `minecraft:{name}`, which vanilla has.
    pub fn named_block(self, name: String) -> u32 ! Thrown {
        return match self.codec.blocks.parse("minecraft:{name}") {
            ok(b) => b,
            err(e) => fail Thrown { exception: "IllegalStateException", message: e },
        }
    }

    /// The name of the class the block is, as `FlowerBlock`.
    pub fn class_name(self, block: u32) -> String {
        return self.names[usize(self.classes[usize(block)])].copy()
    }

    /// The block named `name`, as `minecraft:stone`.
    pub fn block_named(self, name: String) -> u32? {
        return match self.codec.blocks.parse(name) {
            ok(b) => some(b),
            err(_) => none,
        }
    }

    /// The property `name` of the state's block.
    pub fn prop(self, state: u32, name: String) -> Prop? {
        return self.codec.prop(self.block(state), name)
    }

    /// The state's value of its boolean property `name`, false if it has none.
    pub fn get_bool(self, state: u32, name: String) -> bool {
        let p = self.prop(state, name) else return false
        return p.get(state) == 0
    }

    /// The state's value of its integer property `name`.
    pub fn get_int(self, state: u32, name: String) -> i32? {
        let p = self.prop(state, name) else return none
        let low = self.codec.int_start(p) else return none
        return some(low + i32.wrap(p.get(state)))
    }

    /// The name of the state's value of its property `name`.
    pub fn get_name(self, state: u32, name: String) -> String? {
        let p = self.prop(state, name) else return none
        return some(self.codec.value_name(p, p.get(state)))
    }

    /// Whether the state's block has a property `name`.
    pub fn has(self, state: u32, name: String) -> bool {
        return self.prop(state, name) != none
    }

    /// The state with its boolean property `name` set to `value`: `setValue`, which vanilla
    /// throws on for a block without it.
    pub fn with_bool(self, state: u32, name: String, value: bool) -> u32 ! Thrown {
        let p = self.prop(state, name) else fail self.no_property(name, state)
        return p.set(state, if value { 0 } else { 1 })
    }

    /// `trySetValue`: the state unchanged if its block has no such property.
    pub fn try_bool(self, state: u32, name: String, value: bool) -> u32 {
        let p = self.prop(state, name) else return state
        return p.set(state, if value { 0 } else { 1 })
    }

    /// The state with its integer property `name` set to `value`.
    pub fn with_int(self, state: u32, name: String, value: i32) -> u32 ! Thrown {
        let p = self.prop(state, name) else fail self.no_property(name, state)
        let low = self.codec.int_start(p) else fail self.no_property(name, state)
        let i = value - low
        if i < 0 or u32.wrap(i) >= p.count {
            fail Thrown { exception: "IllegalArgumentException", message: "Cannot set property {name} to {value} on {self.codec.blocks.name(self.block(state))}, it is not an allowed value" }
        }
        return p.set(state, u32.wrap(i))
    }

    /// The state with its property `name` set to the value named `value`.
    pub fn with_name(self, state: u32, name: String, value: String) -> u32 ! Thrown {
        let p = self.prop(state, name) else fail self.no_property(name, state)
        let i = self.codec.index_of(p, value) else fail Thrown { exception: "IllegalArgumentException", message: "Cannot set property {name} to {value} on {self.codec.blocks.name(self.block(state))}, it is not an allowed value" }
        return p.set(state, i)
    }

    /// `trySetValue` by name.
    pub fn try_name(self, state: u32, name: String, value: String) -> u32 {
        let p = self.prop(state, name) else return state
        let i = self.codec.index_of(p, value) else return state
        return p.set(state, i)
    }

    // What `setValue` throws for a property the state doesn't have.
    fn no_property(self, name: String, state: u32) -> Thrown {
        return Thrown { exception: "IllegalArgumentException", message: "Cannot set property {name} as it does not exist in {self.codec.blocks.name(self.block(state))}" }
    }
}

fn known_blocks(codec: StateCodec) -> Known ! String {
    let air = try named(codec, "air")
    let cave_air = try named(codec, "cave_air")
    let void_air = try named(codec, "void_air")
    let water = try named(codec, "water")
    let lava = try named(codec, "lava")
    return Known {
        air: air,
        cave_air: cave_air,
        void_air: void_air,
        water: water,
        lava: lava,
        bedrock: try named(codec, "bedrock"),
        stone: try named(codec, "stone"),
        dirt: try named(codec, "dirt"),
        grass_block: try named(codec, "grass_block"),
        snow: try named(codec, "snow"),
        ice: try named(codec, "ice"),
        packed_ice: try named(codec, "packed_ice"),
        blue_ice: try named(codec, "blue_ice"),
        snow_block: try named(codec, "snow_block"),
        obsidian: try named(codec, "obsidian"),
        sand: try named(codec, "sand"),
        gravel: try named(codec, "gravel"),
        mycelium: try named(codec, "mycelium"),
        podzol: try named(codec, "podzol"),
        farmland: try named(codec, "farmland"),
        moss_block: try named(codec, "moss_block"),
        soul_sand: try named(codec, "soul_sand"),
        magma_block: try named(codec, "magma_block"),
        spawner: try named(codec, "spawner"),
        chest: try named(codec, "chest"),
        cobblestone: try named(codec, "cobblestone"),
        mossy_cobblestone: try named(codec, "mossy_cobblestone"),
        vine: try named(codec, "vine"),
        bamboo: try named(codec, "bamboo"),
        sugar_cane: try named(codec, "sugar_cane"),
        cactus: try named(codec, "cactus"),
        lily_pad: try named(codec, "lily_pad"),
        kelp: try named(codec, "kelp"),
        kelp_plant: try named(codec, "kelp_plant"),
        seagrass: try named(codec, "seagrass"),
        tall_seagrass: try named(codec, "tall_seagrass"),
        sea_pickle: try named(codec, "sea_pickle"),
        pointed_dripstone: try named(codec, "pointed_dripstone"),
        dripstone_block: try named(codec, "dripstone_block"),
        brown_mushroom: try named(codec, "brown_mushroom"),
        red_mushroom: try named(codec, "red_mushroom"),
        big_dripleaf: try named(codec, "big_dripleaf"),
        big_dripleaf_stem: try named(codec, "big_dripleaf_stem"),
        sculk: try named(codec, "sculk"),
        sculk_catalyst: try named(codec, "sculk_catalyst"),
        sculk_vein: try named(codec, "sculk_vein"),
        moving_piston: try named(codec, "moving_piston"),
        air_state: codec.default_state(air),
        cave_air_state: codec.default_state(cave_air),
        void_air_state: codec.default_state(void_air),
        water_state: codec.default_state(water),
        lava_state: codec.default_state(lava),
    }
}

fn named(codec: StateCodec, name: String) -> u32 ! String {
    return match codec.blocks.parse("minecraft:{name}") {
        ok(b) => b,
        err(e) => fail e,
    }
}
