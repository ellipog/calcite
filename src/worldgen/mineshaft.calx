/// Mineshafts: a room, and corridors, crossings and stairs branching from it up to eight deep
/// and 80 blocks out, then moved below the sea, or for the badlands' to a height between the sea
/// and the surface, as `MineshaftStructure` and `MineshaftPieces` lay them out.
module worldgen.mineshaft

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.worldgen.{WorldgenRandom}
import world.chunk.{WORLD_SURFACE_WG}
import worldgen.facts.{EAST, NORTH, SOUTH, WEST}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Field, Piece, PieceData, bool_field, box_tag, data_2d, field_of, int_field, move_pieces, pieces_box}
import worldgen.providers.{between_inclusive}
import worldgen.structure_world.{StructureWorld}
import worldgen.template.{Bounds}

const CORRIDOR: i32 = 0
const CROSSING: i32 = 1
const ROOM: i32 = 2
const STAIRS: i32 = 3

// A piece while the mineshaft is laid out.
struct MPiece {
    kind: i32
    bb: Bounds
    orientation: i32
    depth: i32
    rails: bool
    spider: bool
    sections: i32
    direction: i32
    entrances: List<Bounds>
}

/// `MineshaftStructure.findGenerationPoint` and its pieces.
pub fn mineshaft(w: mut StructureWorld, cx: i32, cz: i32, allowed: List<i32>, random: mut WorldgenRandom<LegacyRandom>, mesa: bool) -> List<Piece> ! Thrown {
    _ = random.next_double()
    let west = (cx << 4) + 2
    let north = (cz << 4) + 2
    let ex = west + 7 + random.next_int_below(6)
    let ey = 54 + random.next_int_below(6)
    let ez = north + 7 + random.next_int_below(6)
    var pieces = List<MPiece>()
    pieces.push(MPiece { kind: ROOM, bb: Bounds { min_x: west, min_y: 50, min_z: north, max_x: ex, max_y: ey, max_z: ez }, orientation: -1, depth: 0, rails: false, spider: false, sections: 0, direction: -1, entrances: List<Bounds>() })
    add_children(mut pieces, 0, mut random)
    var out = List<Piece>()
    for p in pieces {
        out.push(to_piece(p, mesa))
    }
    let sea = w.sea_level()
    var dy = 0
    if mesa {
        let b = pieces_box(out)
        let center_x = b.min_x + (b.max_x - b.min_x + 1) / 2
        let center_y = b.min_y + (b.max_y - b.min_y + 1) / 2
        let center_z = b.min_z + (b.max_z - b.min_z + 1) / 2
        let surface = try w.base_height(center_x, center_z, WORLD_SURFACE_WG)
        let target = if surface <= sea { sea } else { try between_inclusive(mut random, sea, surface) }
        dy = target - center_y
    } else {
        // `moveBelowSeaLevel`, from the generator's bottom.
        let max_y = sea - 10
        let b = pieces_box(out)
        var y1 = (b.max_y - b.min_y + 1) + w.shape.min_y + 1
        if y1 < max_y {
            y1 += random.next_int_below(max_y - y1)
        }
        dy = y1 - b.max_y
    }
    move_pieces(mut out, dy)
    if not try w.valid_biome((cx << 4) + 8, 50 + dy, cz << 4, allowed) {
        return List<Piece>()
    }
    return out
}

// The piece as the start saves it.
fn to_piece(p: MPiece, mesa: bool) -> Piece {
    var fields = List<Field>()
    fields.push(int_field("MST", if mesa { 1 } else { 0 }))
    var kind = "minecraft:msstairs"
    if p.kind == CORRIDOR {
        kind = "minecraft:mscorridor"
        fields.push(bool_field("hr", p.rails))
        fields.push(bool_field("sc", p.spider))
        fields.push(bool_field("hps", false))
        fields.push(int_field("Num", p.sections))
    } else if p.kind == CROSSING {
        kind = "minecraft:mscrossing"
        fields.push(bool_field("tf", p.bb.max_y - p.bb.min_y + 1 > 3))
        fields.push(field_of("D", Tag.Byte(i8.wrap(data_2d(p.direction)))))
    } else if p.kind == ROOM {
        kind = "minecraft:msroom"
        var boxes = List<Tag>()
        for e in p.entrances {
            boxes.push(box_tag(e))
        }
        fields.push(field_of("Entrances", Tag.List(boxes)))
    }
    return Piece { kind: String(kind), bb: p.bb, orientation: p.orientation, gen_depth: p.depth, data: PieceData.Fields(fields) }
}

fn collides(pieces: List<MPiece>, b: Bounds) -> bool {
    for p in pieces {
        if p.bb.max_x >= b.min_x and p.bb.min_x <= b.max_x and p.bb.max_z >= b.min_z and p.bb.min_z <= b.max_z and p.bb.max_y >= b.min_y and p.bb.min_y <= b.max_y {
            return true
        }
    }
    return false
}

fn boxed(x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, fx: i32, fy: i32, fz: i32) -> Bounds {
    return Bounds { min_x: x0 + fx, min_y: y0 + fy, min_z: z0 + fz, max_x: x1 + fx, max_y: y1 + fy, max_z: z1 + fz }
}

// `generateAndAddPiece`: a piece at the foot, if it's no deeper than 8 and within 80 blocks
// of the start, with its children.
fn generate(pieces: mut List<MPiece>, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32) -> usize? {
    if depth > 8 {
        return none
    }
    if (fx - pieces[0].bb.min_x).abs() > 80 or (fz - pieces[0].bb.min_z).abs() > 80 {
        return none
    }
    let made = random_piece(pieces, mut random, fx, fy, fz, d, depth + 1) else return none
    pieces.push(made)
    let i = pieces.len() - 1
    add_children(mut pieces, i, mut random)
    return some(i)
}

// `createRandomShaftPiece`.
fn random_piece(pieces: List<MPiece>, random: mut WorldgenRandom<LegacyRandom>, fx: i32, fy: i32, fz: i32, d: i32, depth: i32) -> MPiece? {
    let selection = random.next_int_below(100)
    if selection >= 80 {
        let y1 = if random.next_int_below(4) == 0 { 6 } else { 2 }
        let b = match d {
            3 => boxed(-1, 0, 0, 3, y1, 4, fx, fy, fz),
            4 => boxed(-4, 0, -1, 0, y1, 3, fx, fy, fz),
            5 => boxed(0, 0, -1, 4, y1, 3, fx, fy, fz),
            _ => boxed(-1, 0, -4, 3, y1, 0, fx, fy, fz),
        }
        if collides(pieces, b) {
            return none
        }
        return some(MPiece { kind: CROSSING, bb: b, orientation: -1, depth: depth, rails: false, spider: false, sections: 0, direction: d, entrances: List<Bounds>() })
    }
    if selection >= 70 {
        let b = match d {
            3 => boxed(0, -5, 0, 2, 2, 8, fx, fy, fz),
            4 => boxed(-8, -5, 0, 0, 2, 2, fx, fy, fz),
            5 => boxed(0, -5, 0, 8, 2, 2, fx, fy, fz),
            _ => boxed(0, -5, -8, 2, 2, 0, fx, fy, fz),
        }
        if collides(pieces, b) {
            return none
        }
        return some(MPiece { kind: STAIRS, bb: b, orientation: d, depth: depth, rails: false, spider: false, sections: 0, direction: -1, entrances: List<Bounds>() })
    }
    // `findCorridorSize`: the longest of up to four sections that meets nothing.
    var length = random.next_int_below(3) + 2
    while length > 0 {
        let n = length * 5
        let b = match d {
            3 => boxed(0, 0, 0, 2, 2, n - 1, fx, fy, fz),
            4 => boxed(-(n - 1), 0, 0, 0, 2, 2, fx, fy, fz),
            5 => boxed(0, 0, 0, n - 1, 2, 2, fx, fy, fz),
            _ => boxed(0, 0, -(n - 1), 2, 2, 0, fx, fy, fz),
        }
        if not collides(pieces, b) {
            let rails = random.next_int_below(3) == 0
            let spider = not rails and random.next_int_below(23) == 0
            let sections = if d == NORTH or d == SOUTH { (b.max_z - b.min_z + 1) / 5 } else { (b.max_x - b.min_x + 1) / 5 }
            return some(MPiece { kind: CORRIDOR, bb: b, orientation: d, depth: depth, rails: rails, spider: spider, sections: sections, direction: -1, entrances: List<Bounds>() })
        }
        length -= 1
    }
    return none
}

// `addChildren` of the piece.
fn add_children(pieces: mut List<MPiece>, i: usize, random: mut WorldgenRandom<LegacyRandom>) {
    let kind = pieces[i].kind
    let b = pieces[i].bb
    let depth = pieces[i].depth
    if kind == CORRIDOR {
        let d = pieces[i].orientation
        corridor_children(mut pieces, b, d, depth, mut random)
    } else if kind == CROSSING {
        let d = pieces[i].direction
        if d == SOUTH {
            _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y, b.max_z + 1, SOUTH, depth)
            _ = generate(mut pieces, mut random, b.min_x - 1, b.min_y, b.min_z + 1, WEST, depth)
            _ = generate(mut pieces, mut random, b.max_x + 1, b.min_y, b.min_z + 1, EAST, depth)
        } else if d == WEST {
            _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y, b.min_z - 1, NORTH, depth)
            _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y, b.max_z + 1, SOUTH, depth)
            _ = generate(mut pieces, mut random, b.min_x - 1, b.min_y, b.min_z + 1, WEST, depth)
        } else if d == EAST {
            _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y, b.min_z - 1, NORTH, depth)
            _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y, b.max_z + 1, SOUTH, depth)
            _ = generate(mut pieces, mut random, b.max_x + 1, b.min_y, b.min_z + 1, EAST, depth)
        } else {
            _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y, b.min_z - 1, NORTH, depth)
            _ = generate(mut pieces, mut random, b.min_x - 1, b.min_y, b.min_z + 1, WEST, depth)
            _ = generate(mut pieces, mut random, b.max_x + 1, b.min_y, b.min_z + 1, EAST, depth)
        }
        if b.max_y - b.min_y + 1 > 3 {
            if random.next_boolean() {
                _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y + 4, b.min_z - 1, NORTH, depth)
            }
            if random.next_boolean() {
                _ = generate(mut pieces, mut random, b.min_x - 1, b.min_y + 4, b.min_z + 1, WEST, depth)
            }
            if random.next_boolean() {
                _ = generate(mut pieces, mut random, b.max_x + 1, b.min_y + 4, b.min_z + 1, EAST, depth)
            }
            if random.next_boolean() {
                _ = generate(mut pieces, mut random, b.min_x + 1, b.min_y + 4, b.max_z + 1, SOUTH, depth)
            }
        }
    } else if kind == ROOM {
        room_children(mut pieces, i, mut random)
    } else {
        let d = pieces[i].orientation
        if d == SOUTH {
            _ = generate(mut pieces, mut random, b.min_x, b.min_y, b.max_z + 1, SOUTH, depth)
        } else if d == WEST {
            _ = generate(mut pieces, mut random, b.min_x - 1, b.min_y, b.min_z, WEST, depth)
        } else if d == EAST {
            _ = generate(mut pieces, mut random, b.max_x + 1, b.min_y, b.min_z, EAST, depth)
        } else {
            _ = generate(mut pieces, mut random, b.min_x, b.min_y, b.min_z - 1, NORTH, depth)
        }
    }
}

// `MineShaftCorridor.addChildren`.
fn corridor_children(pieces: mut List<MPiece>, b: Bounds, d: i32, depth: i32, random: mut WorldgenRandom<LegacyRandom>) {
    let end = random.next_int_below(4)
    if d == SOUTH {
        if end <= 1 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.min_x, y, b.max_z + 1, d, depth)
        } else if end == 2 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.min_x - 1, y, b.max_z - 3, WEST, depth)
        } else {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.max_x + 1, y, b.max_z - 3, EAST, depth)
        }
    } else if d == WEST {
        if end <= 1 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.min_x - 1, y, b.min_z, d, depth)
        } else if end == 2 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.min_x, y, b.min_z - 1, NORTH, depth)
        } else {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.min_x, y, b.max_z + 1, SOUTH, depth)
        }
    } else if d == EAST {
        if end <= 1 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.max_x + 1, y, b.min_z, d, depth)
        } else if end == 2 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.max_x - 3, y, b.min_z - 1, NORTH, depth)
        } else {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.max_x - 3, y, b.max_z + 1, SOUTH, depth)
        }
    } else {
        if end <= 1 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.min_x, y, b.min_z - 1, d, depth)
        } else if end == 2 {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.min_x - 1, y, b.min_z, WEST, depth)
        } else {
            let y = b.min_y - 1 + random.next_int_below(3)
            _ = generate(mut pieces, mut random, b.max_x + 1, y, b.min_z, EAST, depth)
        }
    }
    if depth >= 8 {
        return
    }
    if d != NORTH and d != SOUTH {
        var x = b.min_x + 3
        while x + 3 <= b.max_x {
            let selection = random.next_int_below(5)
            if selection == 0 {
                _ = generate(mut pieces, mut random, x, b.min_y, b.min_z - 1, NORTH, depth + 1)
            } else if selection == 1 {
                _ = generate(mut pieces, mut random, x, b.min_y, b.max_z + 1, SOUTH, depth + 1)
            }
            x += 5
        }
    } else {
        var z = b.min_z + 3
        while z + 3 <= b.max_z {
            let selection = random.next_int_below(5)
            if selection == 0 {
                _ = generate(mut pieces, mut random, b.min_x - 1, b.min_y, z, WEST, depth + 1)
            } else if selection == 1 {
                _ = generate(mut pieces, mut random, b.max_x + 1, b.min_y, z, EAST, depth + 1)
            }
            z += 5
        }
    }
}

// `MineShaftRoom.addChildren`: corridors out of each side, each with its entrance.
fn room_children(pieces: mut List<MPiece>, i: usize, random: mut WorldgenRandom<LegacyRandom>) {
    let b = pieces[i].bb
    let depth = pieces[i].depth
    var space = (b.max_y - b.min_y + 1) - 3 - 1
    if space <= 0 {
        space = 1
    }
    let x_span = b.max_x - b.min_x + 1
    let z_span = b.max_z - b.min_z + 1
    for side in 0..4 {
        let span = if side < 2 { x_span } else { z_span }
        var pos = 0
        while pos < span {
            pos += random.next_int_below(span)
            if pos + 3 > span {
                break
            }
            let y = b.min_y + random.next_int_below(space) + 1
            let child = match side {
                0 => generate(mut pieces, mut random, b.min_x + pos, y, b.min_z - 1, NORTH, depth),
                1 => generate(mut pieces, mut random, b.min_x + pos, y, b.max_z + 1, SOUTH, depth),
                2 => generate(mut pieces, mut random, b.min_x - 1, y, b.min_z + pos, WEST, depth),
                _ => generate(mut pieces, mut random, b.max_x + 1, y, b.min_z + pos, EAST, depth),
            }
            if let c = child {
                let cb = pieces[c].bb
                let e = match side {
                    0 => Bounds { min_x: cb.min_x, min_y: cb.min_y, min_z: b.min_z, max_x: cb.max_x, max_y: cb.max_y, max_z: b.min_z + 1 },
                    1 => Bounds { min_x: cb.min_x, min_y: cb.min_y, min_z: b.max_z - 1, max_x: cb.max_x, max_y: cb.max_y, max_z: b.max_z },
                    2 => Bounds { min_x: b.min_x, min_y: cb.min_y, min_z: cb.min_z, max_x: b.min_x + 1, max_y: cb.max_y, max_z: cb.max_z },
                    _ => Bounds { min_x: b.max_x - 1, min_y: cb.min_y, min_z: cb.min_z, max_x: b.max_x, max_y: cb.max_y, max_z: cb.max_z },
                }
                pieces[i].entrances.push(e)
            }
            pos += 4
        }
    }
}
