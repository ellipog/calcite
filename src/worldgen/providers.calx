/// Vanilla's value providers, read as their codecs read them and sampled as vanilla samples
/// them: heights from vertical anchors (`VerticalAnchor`, `HeightProvider`), and ints and floats
/// (`IntProvider`, `FloatProvider`), which carvers and features draw their sizes and counts from.
module worldgen.providers

import json.tree.{Json, Member}
import random.source.{RandomSource}
import worldgen.codec.{field, float_field, float_of, int_field, int_of, map_of, type_of}
import worldgen.interval.{Thrown}

/// `DimensionType.MIN_Y` and `MAX_Y`, the range of a vertical anchor.
const ANCHOR_MIN: i32 = -2032
const ANCHOR_MAX: i32 = 2031

/// `VerticalAnchor`: a height, absolute or from the bottom or top of the generated world or from
/// the sea.
pub enum Anchor {
    Absolute(i32)
    AboveBottom(i32)
    BelowTop(i32)
    Sea(i32)
}

/// `WorldGenerationContext`: the generated world's bottom and depth, the world's cut to the
/// generator's, and the generator's sea level.
pub struct GenContext {
    pub min_y: i32
    pub depth: i32
    pub sea: i32
}

impl GenContext {
    /// The context of a generator whose noise starts at `noise_min` and is `noise_height` tall,
    /// in a world `level_height` blocks tall from `level_min`.
    pub fn new(noise_min: i32, noise_height: i32, sea: i32, level_min: i32, level_height: i32) -> GenContext {
        return GenContext { min_y: level_min.max(noise_min), depth: level_height.min(noise_height), sea: sea }
    }

    /// `VerticalAnchor.resolveY`.
    pub fn resolve(self, a: Anchor) -> i32 {
        return match a {
            Anchor.Absolute(v) => v,
            Anchor.AboveBottom(v) => self.min_y + v,
            Anchor.BelowTop(v) => self.depth - 1 + self.min_y - v,
            Anchor.Sea(v) => self.sea + v,
        }
    }
}

/// `VerticalAnchor.CODEC`: `xor(absolute, xor(above_bottom, xor(below_top,
/// relative_to_sea_level)))`, each a field of a map holding an int from -2032 to 2031. An `xor`
/// reads only if exactly one of its sides does.
pub fn read_anchor(value: Json) -> Anchor ! String {
    let m = try map_of(value)
    let absolute = anchor_part(m, "absolute")
    let bottom = anchor_part(m, "above_bottom")
    let top = anchor_part(m, "below_top")
    let sea = anchor_part(m, "relative_to_sea_level")
    var inner: Anchor? = none
    if let t = top {
        if sea == none {
            inner = some(Anchor.BelowTop(t))
        }
    } else if let s = sea {
        inner = some(Anchor.Sea(s))
    }
    var middle: Anchor? = none
    if let b = bottom {
        if inner == none {
            middle = some(Anchor.AboveBottom(b))
        }
    } else {
        middle = inner
    }
    if let a = absolute {
        if middle == none {
            return Anchor.Absolute(a)
        }
        fail "Both alternatives read successfully"
    }
    let anchor = middle else fail "No anchor"
    return anchor
}

pub fn anchor_field(members: List<Member>, key: str) -> Anchor ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try read_anchor(value)
}

/// One side of the anchor's `xor`: the field `key`, if it reads.
fn anchor_part(members: List<Member>, key: str) -> i32? {
    let value = field(members, key) else return none
    match int_of(value) {
        ok(v) => {
            if v >= ANCHOR_MIN and v <= ANCHOR_MAX {
                return some(v)
            }
        },
        err(_) => {},
    }
    return none
}

// Random numbers as vanilla draws them.

/// `nextInt(bound)`, throwing as vanilla does for a bound that isn't positive.
pub fn next_below<T: RandomSource>(r: mut T, bound: i32) -> i32 ! Thrown {
    if bound <= 0 {
        fail Thrown { exception: "IllegalArgumentException", message: "Bound must be positive" }
    }
    return r.next_int_below(bound)
}

/// `Mth.randomBetweenInclusive`: `nextInt(max - min + 1) + min`, the bound wrapping.
pub fn between_inclusive<T: RandomSource>(r: mut T, min: i32, max: i32) -> i32 ! Thrown {
    return try next_below(mut r, max - min + 1) + min
}

/// `Mth.nextInt`: `min` when the range is empty or one number.
pub fn next_in<T: RandomSource>(r: mut T, min: i32, max: i32) -> i32 ! Thrown {
    if min >= max {
        return min
    }
    return try next_below(mut r, max - min + 1) + min
}

/// `Mth.randomBetween`: a float from `min` up to `max`.
pub fn float_between<T: RandomSource>(r: mut T, min: f32, max: f32) -> f32 {
    return r.next_float() * (max - min) + min
}

/// `Mth.normal`.
pub fn gaussian<T: RandomSource>(r: mut T, mean: f32, deviation: f32) -> f32 {
    return mean + f32.nearest(r.next_gaussian()) * deviation
}

/// `Mth.clamp(float, float, float)`: `min` below it, else `Math.min` with `max`.
pub fn clamp_float(v: f32, min: f32, max: f32) -> f32 {
    if v < min {
        return min
    }
    return java_min_f32(v, max)
}

/// `Math.min(float, float)`: NaN if either is, and -0 below 0.
pub fn java_min_f32(a: f32, b: f32) -> f32 {
    if a != a {
        return a
    }
    if b != b {
        return b
    }
    if a == 0.0f32 and b == 0.0f32 {
        return if a.to_bits() != 0 { a } else { b }
    }
    return if a <= b { a } else { b }
}

// Int providers.

/// An `IntProvider`.
pub enum IntProvider {
    Constant(i32)
    Uniform { min: i32, max: i32 }
    Biased { min: i32, max: i32 }
    VeryBiased { min: i32, max: i32 }
    Clamped { source: Box<IntProvider>, min: i32, max: i32 }
    Weighted { entries: List<WeightedInt>, total: i32, min: i32, max: i32 }
    Normal { mean: f32, deviation: f32, min: i32, max: i32 }
    Trapezoid { min: i32, max: i32, plateau: i32 }
}

/// An entry of a `weighted_list`.
pub struct WeightedInt {
    value: IntProvider
    weight: i32
}

impl IntProvider {
    /// `minInclusive`.
    pub fn min(self) -> i32 {
        return match self {
            IntProvider.Constant(v) => v,
            IntProvider.Uniform { min, .. } => min,
            IntProvider.Biased { min, .. } => min,
            IntProvider.VeryBiased { min, .. } => min,
            IntProvider.Clamped { source, min, .. } => min.max(source.value.min()),
            IntProvider.Weighted { min, .. } => min,
            IntProvider.Normal { min, .. } => min,
            IntProvider.Trapezoid { min, .. } => min,
        }
    }

    /// `maxInclusive`.
    pub fn max(self) -> i32 {
        return match self {
            IntProvider.Constant(v) => v,
            IntProvider.Uniform { max, .. } => max,
            IntProvider.Biased { max, .. } => max,
            IntProvider.VeryBiased { max, .. } => max,
            IntProvider.Clamped { source, max, .. } => max.min(source.value.max()),
            IntProvider.Weighted { max, .. } => max,
            IntProvider.Normal { max, .. } => max,
            IntProvider.Trapezoid { max, .. } => max,
        }
    }

    /// `sample`.
    pub fn sample<T: RandomSource>(self, r: mut T) -> i32 ! Thrown {
        match self {
            IntProvider.Constant(v) => return v,
            IntProvider.Uniform { min, max } => return try between_inclusive(mut r, min, max),
            IntProvider.Biased { min, max } => {
                let inner = try next_below(mut r, max - min + 1)
                return min + try next_below(mut r, inner + 1)
            },
            IntProvider.VeryBiased { min, max } => {
                let a = try next_below(mut r, max - min + 1)
                let b = try next_below(mut r, a + 1)
                return min + try next_below(mut r, b + 1)
            },
            IntProvider.Clamped { source, min, max } => {
                let v = try source.value.sample(mut r)
                return v.max(min).min(max)
            },
            IntProvider.Weighted { entries, total, .. } => {
                var selection = try next_below(mut r, total)
                for e in entries {
                    selection -= e.weight
                    if selection < 0 {
                        return try e.value.sample(mut r)
                    }
                }
                fail Thrown { exception: "IllegalStateException", message: "{selection} exceeded total weight" }
            },
            IntProvider.Normal { mean, deviation, min, max } => {
                let v = clamp_float(gaussian(mut r, mean, deviation), f32.nearest(min), f32.nearest(max))
                return i32.saturate(f64(v))
            },
            IntProvider.Trapezoid { min, max, plateau } => {
                if plateau == 0 and max == -min {
                    let a = try next_below(mut r, max + 1)
                    return a - try next_below(mut r, max + 1)
                }
                let range = max - min
                if plateau == range {
                    return try between_inclusive(mut r, min, max)
                }
                let start = (range - plateau) / 2
                let end = range - start
                let a = try between_inclusive(mut r, 0, end)
                return min + a + try between_inclusive(mut r, 0, start)
            },
        }
    }
}

/// `IntProviders.CODEC`: an int as a constant, or a provider by its `type`.
pub fn read_int(value: Json) -> IntProvider ! String {
    match value {
        Json.Number(_) => return IntProvider.Constant(try int_of(value)),
        Json.Bool(_) => return IntProvider.Constant(try int_of(value)),
        _ => {},
    }
    let m = try map_of(value)
    let kind = try type_of(m)
    if kind == "minecraft:constant" {
        return IntProvider.Constant(try int_field(m, "value"))
    }
    if kind == "minecraft:uniform" or kind == "minecraft:biased_to_bottom" or kind == "minecraft:very_biased_to_bottom" {
        let min = try int_field(m, "min_inclusive")
        let max = try int_field(m, "max_inclusive")
        if max < min {
            fail "Max must be at least min, min_inclusive: {min}, max_inclusive: {max}"
        }
        if kind == "minecraft:uniform" {
            return IntProvider.Uniform { min: min, max: max }
        }
        if kind == "minecraft:biased_to_bottom" {
            return IntProvider.Biased { min: min, max: max }
        }
        return IntProvider.VeryBiased { min: min, max: max }
    }
    if kind == "minecraft:clamped" {
        let source_value = field(m, "source") else fail "No key source in MapLike"
        let source = try read_int(source_value)
        let min = try int_field(m, "min_inclusive")
        let max = try int_field(m, "max_inclusive")
        if max < min {
            fail "Max must be at least min, min_inclusive: {min}, max_inclusive: {max}"
        }
        return IntProvider.Clamped { source: Box(source), min: min, max: max }
    }
    if kind == "minecraft:weighted_list" {
        let list = match field(m, "distribution") {
            some(Json.Array(items)) => items,
            some(other) => fail "Not a list: {other}",
            none => fail "No key distribution in MapLike",
        }
        var entries = List<WeightedInt>()
        var total: i64 = 0
        var min = i32.MAX
        var max = i32.MIN
        for item in list {
            let em = try map_of(item)
            let data = field(em, "data") else fail "No key data in MapLike"
            let provider = try read_int(data)
            let weight = try int_field(em, "weight")
            if weight < 0 {
                fail "Value must be non-negative: {weight}"
            }
            total += i64(weight)
            min = min.min(provider.min())
            max = max.max(provider.max())
            entries.push(WeightedInt { value: provider, weight: weight })
        }
        if total > 2147483647 {
            fail "Sum of weights must be <= 2147483647"
        }
        if total == 0 {
            fail "Weighted list must contain at least one entry with non-zero weight"
        }
        return IntProvider.Weighted { entries: entries, total: i32.wrap(total), min: min, max: max }
    }
    if kind == "minecraft:clamped_normal" {
        let mean = try float_field(m, "mean")
        let deviation = try float_field(m, "deviation")
        let min = try int_field(m, "min_inclusive")
        let max = try int_field(m, "max_inclusive")
        if max < min {
            fail "Max must be larger than min: [{min}, {max}]"
        }
        return IntProvider.Normal { mean: mean, deviation: deviation, min: min, max: max }
    }
    if kind == "minecraft:trapezoid" {
        let min = try int_field(m, "min")
        let max = try int_field(m, "max")
        let plateau = try int_field(m, "plateau")
        if max < min {
            fail "Max must be larger than min: [{min}, {max}]"
        }
        if plateau > max - min {
            fail "Plateau can at most be the full span: [{min}, {max}]"
        }
        return IntProvider.Trapezoid { min: min, max: max, plateau: plateau }
    }
    fail "Unknown int provider type: {kind}"
}

/// `IntProviders.codec(low, high)`: a provider whose least and greatest values are within the
/// range.
pub fn read_int_range(value: Json, low: i32, high: i32) -> IntProvider ! String {
    let p = try read_int(value)
    if p.min() < low {
        fail "Value provider too low: {low} [{p.min()}-{p.max()}]"
    }
    if p.max() > high {
        fail "Value provider too high: {high} [{p.min()}-{p.max()}]"
    }
    return p
}

pub fn int_provider_field(members: List<Member>, key: str, low: i32, high: i32) -> IntProvider ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try read_int_range(value, low, high)
}

// Float providers.

/// A `FloatProvider`.
pub enum FloatProvider {
    Constant(f32)
    Uniform { min: f32, max: f32 }
    Normal { mean: f32, deviation: f32, min: f32, max: f32 }
    Trapezoid { min: f32, max: f32, plateau: f32 }
}

impl FloatProvider {
    pub fn min(self) -> f32 {
        return match self {
            FloatProvider.Constant(v) => v,
            FloatProvider.Uniform { min, .. } => min,
            FloatProvider.Normal { min, .. } => min,
            FloatProvider.Trapezoid { min, .. } => min,
        }
    }

    pub fn max(self) -> f32 {
        return match self {
            FloatProvider.Constant(v) => v,
            FloatProvider.Uniform { max, .. } => max,
            FloatProvider.Normal { max, .. } => max,
            FloatProvider.Trapezoid { max, .. } => max,
        }
    }

    pub fn sample<T: RandomSource>(self, r: mut T) -> f32 {
        return match self {
            FloatProvider.Constant(v) => v,
            FloatProvider.Uniform { min, max } => float_between(mut r, min, max),
            FloatProvider.Normal { mean, deviation, min, max } => clamp_float(gaussian(mut r, mean, deviation), min, max),
            FloatProvider.Trapezoid { min, max, plateau } => {
                let range = max - min
                let start = (range - plateau) / 2.0f32
                let end = range - start
                let a = r.next_float() * end
                min + a + r.next_float() * start
            },
        }
    }
}

/// `FloatProviders.CODEC`: a float as a constant, or a provider by its `type`.
pub fn read_float(value: Json) -> FloatProvider ! String {
    match value {
        Json.Number(_) => return FloatProvider.Constant(try float_of(value)),
        Json.Bool(_) => return FloatProvider.Constant(try float_of(value)),
        _ => {},
    }
    let m = try map_of(value)
    let kind = try type_of(m)
    if kind == "minecraft:constant" {
        return FloatProvider.Constant(try float_field(m, "value"))
    }
    if kind == "minecraft:uniform" {
        let min = try float_field(m, "min_inclusive")
        let max = try float_field(m, "max_exclusive")
        if max <= min {
            fail "Max must be larger than min, min: {min}, max: {max}"
        }
        return FloatProvider.Uniform { min: min, max: max }
    }
    if kind == "minecraft:clamped_normal" {
        let mean = try float_field(m, "mean")
        let deviation = try float_field(m, "deviation")
        let min = try float_field(m, "min")
        let max = try float_field(m, "max")
        if max < min {
            fail "Max must be larger than min: [{min}, {max}]"
        }
        return FloatProvider.Normal { mean: mean, deviation: deviation, min: min, max: max }
    }
    if kind == "minecraft:trapezoid" {
        let min = try float_field(m, "min")
        let max = try float_field(m, "max")
        let plateau = try float_field(m, "plateau")
        if max < min {
            fail "Max must be larger than min: [{min}, {max}]"
        }
        if plateau > max - min {
            fail "Plateau can at most be the full span: [{min}, {max}]"
        }
        return FloatProvider.Trapezoid { min: min, max: max, plateau: plateau }
    }
    fail "Unknown float provider type: {kind}"
}

/// `FloatProviders.codec(low, high)`: a provider whose least and greatest values are within the
/// range, either end optional.
pub fn read_float_range(value: Json, low: f32?, high: f32?) -> FloatProvider ! String {
    let p = try read_float(value)
    if let l = low {
        if p.min() < l {
            fail "Value provider too low: {l} [{p.min()}-{p.max()}]"
        }
    }
    if let h = high {
        if p.max() > h {
            fail "Value provider too high: {h} [{p.min()}-{p.max()}]"
        }
    }
    return p
}

pub fn float_provider_field(members: List<Member>, key: str, low: f32?, high: f32?) -> FloatProvider ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try read_float_range(value, low, high)
}

// Height providers.

/// A `HeightProvider`.
pub enum HeightProvider {
    Constant(Anchor)
    Uniform { min: Anchor, max: Anchor }
    Biased { min: Anchor, max: Anchor, inner: i32 }
    VeryBiased { min: Anchor, max: Anchor, inner: i32 }
    Trapezoid { min: Anchor, max: Anchor, plateau: i32 }
    Weighted { entries: List<WeightedHeight>, total: i32 }
}

/// An entry of a `weighted_list` of heights.
pub struct WeightedHeight {
    value: HeightProvider
    weight: i32
}

impl HeightProvider {
    /// `sample`. An empty range gives its bottom, as vanilla's does after it logs a warning.
    pub fn sample<T: RandomSource>(self, r: mut T, ctx: GenContext) -> i32 ! Thrown {
        match self {
            HeightProvider.Constant(a) => return ctx.resolve(a),
            HeightProvider.Uniform { min, max } => {
                let low = ctx.resolve(min)
                let high = ctx.resolve(max)
                if low > high {
                    return low
                }
                return try between_inclusive(mut r, low, high)
            },
            HeightProvider.Biased { min, max, inner } => {
                let low = ctx.resolve(min)
                let high = ctx.resolve(max)
                if high - low - inner + 1 <= 0 {
                    return low
                }
                let limit = try next_below(mut r, high - low - inner + 1)
                return try next_below(mut r, limit + inner) + low
            },
            HeightProvider.VeryBiased { min, max, inner } => {
                let low = ctx.resolve(min)
                let high = ctx.resolve(max)
                if high - low - inner + 1 <= 0 {
                    return low
                }
                let upper = try next_in(mut r, low + inner, high)
                let biased = try next_in(mut r, low, upper - 1)
                return try next_in(mut r, low, biased - 1 + inner)
            },
            HeightProvider.Trapezoid { min, max, plateau } => {
                let low = ctx.resolve(min)
                let high = ctx.resolve(max)
                if low > high {
                    return low
                }
                let range = high - low
                if plateau >= range {
                    return try between_inclusive(mut r, low, high)
                }
                let start = (range - plateau) / 2
                let end = range - start
                let a = try between_inclusive(mut r, 0, end)
                return low + a + try between_inclusive(mut r, 0, start)
            },
            HeightProvider.Weighted { entries, total } => {
                var selection = try next_below(mut r, total)
                for e in entries {
                    selection -= e.weight
                    if selection < 0 {
                        return try e.value.sample(mut r, ctx)
                    }
                }
                fail Thrown { exception: "IllegalStateException", message: "{selection} exceeded total weight" }
            },
        }
    }
}

/// `HeightProvider.CODEC`: an anchor as a constant, or a provider by its `type`.
pub fn read_height(value: Json) -> HeightProvider ! String {
    match read_anchor(value) {
        ok(a) => return HeightProvider.Constant(a),
        err(_) => {},
    }
    let m = try map_of(value)
    let kind = try type_of(m)
    if kind == "minecraft:constant" {
        return HeightProvider.Constant(try anchor_field(m, "value"))
    }
    if kind == "minecraft:uniform" {
        let min = try anchor_field(m, "min_inclusive")
        let max = try anchor_field(m, "max_inclusive")
        return HeightProvider.Uniform { min: min, max: max }
    }
    if kind == "minecraft:biased_to_bottom" or kind == "minecraft:very_biased_to_bottom" {
        let min = try anchor_field(m, "min_inclusive")
        let max = try anchor_field(m, "max_inclusive")
        var inner = 1
        if let v = field(m, "inner") {
            inner = try int_of(v)
            if inner < 1 {
                fail "Value {inner} outside of range [1:2147483647]"
            }
        }
        if kind == "minecraft:biased_to_bottom" {
            return HeightProvider.Biased { min: min, max: max, inner: inner }
        }
        return HeightProvider.VeryBiased { min: min, max: max, inner: inner }
    }
    if kind == "minecraft:trapezoid" {
        let min = try anchor_field(m, "min_inclusive")
        let max = try anchor_field(m, "max_inclusive")
        var plateau = 0
        if let v = field(m, "plateau") {
            plateau = try int_of(v)
        }
        return HeightProvider.Trapezoid { min: min, max: max, plateau: plateau }
    }
    if kind == "minecraft:weighted_list" {
        let list = match field(m, "distribution") {
            some(Json.Array(items)) => items,
            some(other) => fail "Not a list: {other}",
            none => fail "No key distribution in MapLike",
        }
        var entries = List<WeightedHeight>()
        var total: i64 = 0
        for item in list {
            let em = try map_of(item)
            let data = field(em, "data") else fail "No key data in MapLike"
            let provider = try read_height(data)
            let weight = try int_field(em, "weight")
            if weight < 0 {
                fail "Value must be non-negative: {weight}"
            }
            total += i64(weight)
            entries.push(WeightedHeight { value: provider, weight: weight })
        }
        if total > 2147483647 {
            fail "Sum of weights must be <= 2147483647"
        }
        if total == 0 {
            fail "Weighted list must contain at least one entry with non-zero weight"
        }
        return HeightProvider.Weighted { entries: entries, total: i32.wrap(total) }
    }
    fail "Unknown height provider type: {kind}"
}

pub fn height_field(members: List<Member>, key: str) -> HeightProvider ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try read_height(value)
}
