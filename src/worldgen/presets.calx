/// The parameter lists of vanilla's two multi-noise presets, `minecraft:overworld` and
/// `minecraft:nether`: each biome and the climate it fits, in the order vanilla's lists hold them,
/// which is the order their trees are built in.
module worldgen.presets

import worldgen.climate.{Parameter, Point, join, point, point_of, quantize, span}

/// One entry of a preset: where it fits, and its biome's ID.
pub struct Entry {
    pub point: Point
    pub biome: String
}

/// The `minecraft:nether` preset: five points, two with an offset.
pub fn nether() -> List<Entry> {
    var out = List<Entry>()
    nether_point(mut out, 0.0, 0.0, 0.0, "nether_wastes")
    nether_point(mut out, 0.0, -0.5, 0.0, "soul_sand_valley")
    nether_point(mut out, 0.4, 0.0, 0.0, "crimson_forest")
    nether_point(mut out, 0.0, 0.5, 0.375, "warped_forest")
    nether_point(mut out, -0.5, 0.0, 0.175, "basalt_deltas")
    return out
}

fn nether_point(out: mut List<Entry>, temperature: f32, humidity: f32, offset: f32, biome: str) {
    let zero = point(0.0)
    let p = point_of(point(temperature), point(humidity), zero, zero, zero, zero, quantize(offset))
    out.push(Entry { point: p, biome: "minecraft:{biome}" })
}

// The Overworld's bands of each value, by index: five of temperature and of humidity, seven of
// erosion, and the bands of continentalness from the sea inland.
const MUSHROOM: usize = 0
const DEEP_OCEAN: usize = 1
const OCEAN: usize = 2
const COAST: usize = 3
const INLAND: usize = 4
const NEAR: usize = 5
const MID: usize = 6
const FAR: usize = 7

// The biomes a band of temperature (rows) and of humidity (columns) gives, where nothing else
// decides; `-` where a variant table has none.
fn middle_table() -> str {
    return "snowy_plains snowy_plains snowy_plains snowy_taiga taiga plains plains forest taiga old_growth_spruce_taiga flower_forest plains forest birch_forest dark_forest savanna savanna forest jungle jungle desert desert desert desert desert"
}
// Where weirdness is 0 or more.
fn middle_variant_table() -> str {
    return "ice_spikes - snowy_taiga - - dappled_forest - - - old_growth_pine_taiga sunflower_plains - - old_growth_birch_forest - - - plains sparse_jungle bamboo_jungle - - - - -"
}
fn plateau_table() -> str {
    return "snowy_plains snowy_plains snowy_plains snowy_taiga snowy_taiga meadow meadow forest taiga old_growth_spruce_taiga meadow meadow meadow meadow pale_garden savanna_plateau savanna_plateau forest forest jungle badlands badlands badlands wooded_badlands wooded_badlands"
}
fn plateau_variant_table() -> str {
    return "ice_spikes - - - - cherry_grove - meadow meadow old_growth_pine_taiga cherry_grove cherry_grove forest birch_forest - - - - - - eroded_badlands eroded_badlands - - -"
}
fn shattered_table() -> str {
    return "windswept_gravelly_hills windswept_gravelly_hills windswept_hills windswept_forest windswept_forest windswept_gravelly_hills windswept_gravelly_hills windswept_hills windswept_forest windswept_forest windswept_hills windswept_hills windswept_hills windswept_forest windswept_forest - - - - - - - - - -"
}
// Oceans by temperature: deep, then not.
fn deep_oceans_table() -> str {
    return "deep_frozen_ocean deep_cold_ocean deep_ocean deep_lukewarm_ocean warm_ocean"
}
fn oceans_table() -> str {
    return "frozen_ocean cold_ocean ocean lukewarm_ocean warm_ocean"
}

/// How a row of a slice picks its biome for a band of temperature and humidity.
enum Pick {
    Middle
    // Badlands where it's hottest.
    MiddleOrBadlands
    // Badlands where it's hottest, slopes where it's coldest.
    MiddleOrBadlandsOrSlope
    Plateau
    Shattered
    ShatteredOrSavanna
    MiddleOrSavanna
    Slope
    // Slopes where it's coldest, plateaus elsewhere.
    SlopeOrPlateau
    Peak
    Beach
    ShatteredCoast
}

/// When a row of a slice applies.
enum When {
    Always
    // Where the slice's weirdness is below 0, or where it isn't.
    Negative
    NotNegative
    // In the coldest band.
    Frozen
}

/// A row that each band of temperature and humidity of a slice gets: the continentalness from
/// one band to another, and the erosion likewise.
struct Row {
    c: [usize; 2]
    e: [usize; 2]
    pick: Pick
    when: When = When.Always
}

/// A row a slice has once, for a span of temperature bands or all of them, every humidity:
/// its biome, and another where the slice's weirdness is below 0, if that differs.
struct Fixed {
    t: [i32; 2]
    c: [usize; 2]
    e: [usize; 2]
    biome: str
    negative: str = ""
}

/// What a slice of weirdness holds.
enum Slice {
    Peaks
    High
    Mid
    Low
    Valleys
}

struct Bands {
    temperatures: List<Parameter>
    humidities: List<Parameter>
    erosions: List<Parameter>
    continents: List<Parameter>
    full: Parameter
    middle: List<String>
    middle_variant: List<String>
    plateau: List<String>
    plateau_variant: List<String>
    shattered: List<String>
}

/// The `minecraft:overworld` preset: biomes off the coast, then inland slice by slice of
/// weirdness, then below ground.
pub fn overworld() -> List<Entry> {
    let b = bands()
    var out = List<Entry>()
    let full = b.full
    surface(mut out, full, full, b.continents[MUSHROOM], full, full, "mushroom_fields")
    let deep = words(deep_oceans_table())
    let shallow = words(oceans_table())
    for t in 0..b.temperatures.len() {
        surface(mut out, b.temperatures[t], full, b.continents[DEEP_OCEAN], full, full, deep[t])
        surface(mut out, b.temperatures[t], full, b.continents[OCEAN], full, full, shallow[t])
    }
    // Weirdness from -1 to 1: the slices meet at these, and each holds what its kind does.
    let edges: List<f32> = [-1.0, -0.93333334, -0.7666667, -0.56666666, -0.4, -0.26666668, -0.05, 0.05, 0.26666668, 0.4, 0.56666666, 0.7666667, 0.93333334, 1.0]
    let kinds: List<Slice> = [Slice.Mid, Slice.High, Slice.Peaks, Slice.High, Slice.Mid, Slice.Low, Slice.Valleys, Slice.Low, Slice.Mid, Slice.High, Slice.Peaks, Slice.High, Slice.Mid]
    for i in 0..kinds.len() {
        slice(mut out, b, kinds[i], span(edges[i], edges[i + 1]))
    }
    // Caves fill depths 0.2 to 0.9, the deep dark depth 1.1.
    let caves = span(0.2, 0.9)
    out.push(entry(full, full, span(0.8, 1.0), full, caves, full, "dripstone_caves"))
    out.push(entry(full, span(0.7, 1.0), full, full, caves, full, "lush_caves"))
    out.push(entry(full, full, join(b.continents[COAST], b.continents[INLAND]), join(b.erosions[5], b.erosions[6]), caves, span(-1.1, -0.85), "sulfur_caves"))
    out.push(entry(full, full, full, join(b.erosions[0], b.erosions[1]), point(1.1), full, "deep_dark"))
    return out
}

fn bands() -> Bands {
    let t: List<Parameter> = [span(-1.0, -0.45), span(-0.45, -0.15), span(-0.15, 0.2), span(0.2, 0.55), span(0.55, 1.0)]
    let h: List<Parameter> = [span(-1.0, -0.35), span(-0.35, -0.1), span(-0.1, 0.1), span(0.1, 0.3), span(0.3, 1.0)]
    let e: List<Parameter> = [span(-1.0, -0.78), span(-0.78, -0.375), span(-0.375, -0.2225), span(-0.2225, 0.05), span(0.05, 0.45), span(0.45, 0.55), span(0.55, 1.0)]
    let c: List<Parameter> = [span(-1.2, -1.05), span(-1.05, -0.455), span(-0.455, -0.19), span(-0.19, -0.11), span(-0.11, 0.55), span(-0.11, 0.03), span(0.03, 0.3), span(0.3, 1.0)]
    return Bands {
        temperatures: t, humidities: h, erosions: e, continents: c, full: span(-1.0, 1.0),
        middle: words(middle_table()), middle_variant: words(middle_variant_table()), plateau: words(plateau_table()),
        plateau_variant: words(plateau_variant_table()), shattered: words(shattered_table()),
    }
}

fn words(table: str) -> List<String> {
    var out = List<String>()
    var word = String()
    for ch in table.runes() {
        if ch == ' ' {
            out.push(word)
            word = String()
        } else {
            word.push(ch)
        }
    }
    out.push(word)
    return out
}

fn slice(out: mut List<Entry>, b: Bands, kind: Slice, w: Parameter) {
    let negative = w.max < 0
    for f in fixed_rows(kind) {
        let t = if f.t[0] < 0 { b.full } else { join(b.temperatures[usize.wrap(f.t[0])], b.temperatures[usize.wrap(f.t[1])]) }
        let biome = if negative and f.negative != "" { f.negative } else { f.biome }
        surface(mut out, t, b.full, join(b.continents[f.c[0]], b.continents[f.c[1]]), join(b.erosions[f.e[0]], b.erosions[f.e[1]]), w, String(biome))
    }
    let rows = rows_of(kind)
    for t in 0..b.temperatures.len() {
        for h in 0..b.humidities.len() {
            for r in rows {
                let applies = match r.when {
                    When.Always => true,
                    When.Negative => negative,
                    When.NotNegative => not negative,
                    When.Frozen => t == 0,
                }
                if applies {
                    let biome = pick(b, r.pick, t, h, negative)
                    surface(mut out, b.temperatures[t], b.humidities[h], join(b.continents[r.c[0]], b.continents[r.c[1]]), join(b.erosions[r.e[0]], b.erosions[r.e[1]]), w, biome)
                }
            }
        }
    }
}

fn fixed_rows(kind: Slice) -> List<Fixed> {
    match kind {
        Slice.Mid => return shores(),
        Slice.Low => return shores(),
        Slice.Valleys => {
            let all = [COAST, FAR]
            let wide = [INLAND, FAR]
            return [
                Fixed { t: [0, 0], c: [COAST, COAST], e: [0, 1], biome: "frozen_river", negative: "stony_shore" },
                Fixed { t: [1, 4], c: [COAST, COAST], e: [0, 1], biome: "river", negative: "stony_shore" },
                Fixed { t: [0, 0], c: [NEAR, NEAR], e: [0, 1], biome: "frozen_river" },
                Fixed { t: [1, 4], c: [NEAR, NEAR], e: [0, 1], biome: "river" },
                Fixed { t: [0, 0], c: all, e: [2, 5], biome: "frozen_river" },
                Fixed { t: [1, 4], c: all, e: [2, 5], biome: "river" },
                Fixed { t: [0, 0], c: [COAST, COAST], e: [6, 6], biome: "frozen_river" },
                Fixed { t: [1, 4], c: [COAST, COAST], e: [6, 6], biome: "river" },
                Fixed { t: [1, 2], c: wide, e: [6, 6], biome: "swamp" },
                Fixed { t: [3, 4], c: wide, e: [6, 6], biome: "mangrove_swamp" },
                Fixed { t: [0, 0], c: wide, e: [6, 6], biome: "frozen_river" },
            ]
        },
        _ => return List<Fixed>(),
    }
}

// The shore and the swamps that the mid and low slices begin with.
fn shores() -> List<Fixed> {
    return [
        Fixed { t: [-1, -1], c: [COAST, COAST], e: [0, 2], biome: "stony_shore" },
        Fixed { t: [1, 2], c: [NEAR, FAR], e: [6, 6], biome: "swamp" },
        Fixed { t: [3, 4], c: [NEAR, FAR], e: [6, 6], biome: "mangrove_swamp" },
    ]
}

fn rows_of(kind: Slice) -> List<Row> {
    let coast = [COAST, COAST]
    let near = [NEAR, NEAR]
    let mid = [MID, MID]
    let far = [FAR, FAR]
    let coast_near = [COAST, NEAR]
    let coast_far = [COAST, FAR]
    let near_mid = [NEAR, MID]
    let near_far = [NEAR, FAR]
    let mid_far = [MID, FAR]
    match kind {
        Slice.Peaks => return [
            Row { c: coast_far, e: [0, 0], pick: Pick.Peak },
            Row { c: coast_near, e: [1, 1], pick: Pick.MiddleOrBadlandsOrSlope },
            Row { c: mid_far, e: [1, 1], pick: Pick.Peak },
            Row { c: coast_near, e: [2, 3], pick: Pick.Middle },
            Row { c: mid_far, e: [2, 2], pick: Pick.Plateau },
            Row { c: mid, e: [3, 3], pick: Pick.MiddleOrBadlands },
            Row { c: far, e: [3, 3], pick: Pick.Plateau },
            Row { c: coast_far, e: [4, 4], pick: Pick.Middle },
            Row { c: coast_near, e: [5, 5], pick: Pick.ShatteredOrSavanna },
            Row { c: mid_far, e: [5, 5], pick: Pick.Shattered },
            Row { c: coast_far, e: [6, 6], pick: Pick.Middle },
        ],
        Slice.High => return [
            Row { c: coast, e: [0, 1], pick: Pick.Middle },
            Row { c: near, e: [0, 0], pick: Pick.Slope },
            Row { c: mid_far, e: [0, 0], pick: Pick.Peak },
            Row { c: near, e: [1, 1], pick: Pick.MiddleOrBadlandsOrSlope },
            Row { c: mid_far, e: [1, 1], pick: Pick.Slope },
            Row { c: coast_near, e: [2, 3], pick: Pick.Middle },
            Row { c: mid_far, e: [2, 2], pick: Pick.Plateau },
            Row { c: mid, e: [3, 3], pick: Pick.MiddleOrBadlands },
            Row { c: far, e: [3, 3], pick: Pick.Plateau },
            Row { c: coast_far, e: [4, 4], pick: Pick.Middle },
            Row { c: coast_near, e: [5, 5], pick: Pick.MiddleOrSavanna },
            Row { c: mid_far, e: [5, 5], pick: Pick.Shattered },
            Row { c: coast_far, e: [6, 6], pick: Pick.Middle },
        ],
        Slice.Mid => return [
            Row { c: near_far, e: [0, 0], pick: Pick.Slope },
            Row { c: near_mid, e: [1, 1], pick: Pick.MiddleOrBadlandsOrSlope },
            Row { c: far, e: [1, 1], pick: Pick.SlopeOrPlateau },
            Row { c: near, e: [2, 2], pick: Pick.Middle },
            Row { c: mid, e: [2, 2], pick: Pick.MiddleOrBadlands },
            Row { c: far, e: [2, 2], pick: Pick.Plateau },
            Row { c: coast_near, e: [3, 3], pick: Pick.Middle },
            Row { c: mid_far, e: [3, 3], pick: Pick.MiddleOrBadlands },
            Row { c: coast, e: [4, 4], pick: Pick.Beach, when: When.Negative },
            Row { c: near_far, e: [4, 4], pick: Pick.Middle, when: When.Negative },
            Row { c: coast_far, e: [4, 4], pick: Pick.Middle, when: When.NotNegative },
            Row { c: coast, e: [5, 5], pick: Pick.ShatteredCoast },
            Row { c: near, e: [5, 5], pick: Pick.MiddleOrSavanna },
            Row { c: mid_far, e: [5, 5], pick: Pick.Shattered },
            Row { c: coast, e: [6, 6], pick: Pick.Beach, when: When.Negative },
            Row { c: coast, e: [6, 6], pick: Pick.Middle, when: When.NotNegative },
            Row { c: near_far, e: [6, 6], pick: Pick.Middle, when: When.Frozen },
        ],
        Slice.Low => return [
            Row { c: near, e: [0, 1], pick: Pick.MiddleOrBadlands },
            Row { c: mid_far, e: [0, 1], pick: Pick.MiddleOrBadlandsOrSlope },
            Row { c: near, e: [2, 3], pick: Pick.Middle },
            Row { c: mid_far, e: [2, 3], pick: Pick.MiddleOrBadlands },
            Row { c: coast, e: [3, 4], pick: Pick.Beach },
            Row { c: near_far, e: [4, 4], pick: Pick.Middle },
            Row { c: coast, e: [5, 5], pick: Pick.ShatteredCoast },
            Row { c: near, e: [5, 5], pick: Pick.MiddleOrSavanna },
            Row { c: mid_far, e: [5, 5], pick: Pick.Middle },
            Row { c: coast, e: [6, 6], pick: Pick.Beach },
            Row { c: near_far, e: [6, 6], pick: Pick.Middle, when: When.Frozen },
        ],
        Slice.Valleys => return [
            Row { c: mid_far, e: [0, 1], pick: Pick.MiddleOrBadlands },
        ],
    }
}

fn pick(b: Bands, p: Pick, t: usize, h: usize, negative: bool) -> String {
    match p {
        Pick.Middle => return middle(b, t, h, negative),
        Pick.MiddleOrBadlands => return middle_or_badlands(b, t, h, negative),
        Pick.MiddleOrBadlandsOrSlope => return if t == 0 { slope(b, t, h, negative) } else { middle_or_badlands(b, t, h, negative) },
        Pick.Plateau => return plateau(b, t, h, negative),
        Pick.Shattered => return shattered(b, t, h, negative),
        Pick.ShatteredOrSavanna => return savanna_or(t, h, negative, shattered(b, t, h, negative)),
        Pick.MiddleOrSavanna => return savanna_or(t, h, negative, middle(b, t, h, negative)),
        Pick.Slope => return slope(b, t, h, negative),
        Pick.SlopeOrPlateau => return if t == 0 { slope(b, t, h, negative) } else { plateau(b, t, h, negative) },
        Pick.Peak => return peak(t, h, negative),
        Pick.Beach => return beach(t),
        Pick.ShatteredCoast => {
            let under = if negative { beach(t) } else { middle(b, t, h, negative) }
            return savanna_or(t, h, negative, under)
        },
    }
}

fn middle(b: Bands, t: usize, h: usize, negative: bool) -> String {
    let i = t * 5 + h
    if not negative and b.middle_variant[i] != "-" {
        return b.middle_variant[i].copy()
    }
    return b.middle[i].copy()
}

fn middle_or_badlands(b: Bands, t: usize, h: usize, negative: bool) -> String {
    if t == 4 {
        return badlands(h, negative)
    }
    return middle(b, t, h, negative)
}

fn badlands(h: usize, negative: bool) -> String {
    if h < 2 {
        return String(if negative { "badlands" } else { "eroded_badlands" })
    }
    return String(if h < 3 { "badlands" } else { "wooded_badlands" })
}

fn plateau(b: Bands, t: usize, h: usize, negative: bool) -> String {
    let i = t * 5 + h
    if not negative and b.plateau_variant[i] != "-" {
        return b.plateau_variant[i].copy()
    }
    return b.plateau[i].copy()
}

fn slope(b: Bands, t: usize, h: usize, negative: bool) -> String {
    if t >= 3 {
        return plateau(b, t, h, negative)
    }
    return String(if h <= 1 { "snowy_slopes" } else { "grove" })
}

fn shattered(b: Bands, t: usize, h: usize, negative: bool) -> String {
    let i = t * 5 + h
    if b.shattered[i] != "-" {
        return b.shattered[i].copy()
    }
    return middle(b, t, h, negative)
}

// Windswept savanna, where it's warm, not wettest, and weirdness isn't below 0.
fn savanna_or(t: usize, h: usize, negative: bool, under: own String) -> String {
    if t > 1 and h < 4 and not negative {
        return String("windswept_savanna")
    }
    return under
}

fn peak(t: usize, h: usize, negative: bool) -> String {
    if t <= 2 {
        return String(if negative { "jagged_peaks" } else { "frozen_peaks" })
    }
    if t == 3 {
        return String("stony_peaks")
    }
    return badlands(h, negative)
}

fn beach(t: usize) -> String {
    if t == 0 {
        return String("snowy_beach")
    }
    return String(if t == 4 { "desert" } else { "beach" })
}

/// A biome at the surface: two entries, at depth 0 and at depth 1.
fn surface(out: mut List<Entry>, t: Parameter, h: Parameter, c: Parameter, e: Parameter, w: Parameter, biome: String) {
    out.push(entry(t, h, c, e, point(0.0), w, biome.copy()))
    out.push(entry(t, h, c, e, point(1.0), w, biome))
}

fn entry(t: Parameter, h: Parameter, c: Parameter, e: Parameter, d: Parameter, w: Parameter, biome: String) -> Entry {
    return Entry { point: point_of(t, h, c, e, d, w, 0), biome: "minecraft:{biome}" }
}
