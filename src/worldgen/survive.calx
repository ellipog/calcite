/// Whether a block state can stay where it is: vanilla's `canSurvive`, each block running the
/// one its class declares or inherits, as features ask it before they place plants and the like
/// in a region. A class Calcite doesn't know yet throws `Unimplemented`, which the rig reports as
/// such, rather than guessing.
module worldgen.survive

import world.block_flags.{SOLID_RENDER}
import worldgen.facts.{CENTER, DOWN, FULL, Facts, UP, WATER_FLUID, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.providers.{GenContext}
import worldgen.region.{Region}

/// What features see of the world besides the region: the block facts, the generated world's
/// bounds and sea, and whether the dimension has skylight, which is all the light there is while
/// chunks generate.
pub struct Env {
    pub facts: Facts
    pub ctx: GenContext
    pub sky_light: bool
    /// `ChunkGenerator.getGenDepth`: the noise settings' height.
    pub gen_depth: i32
}

impl Env {
    /// `getRawBrightness` while chunks generate: no block has light yet, and every column's
    /// skylight is full until it's lit.
    pub fn raw_brightness(self) -> i32 {
        return if self.sky_light { 15 } else { 0 }
    }
}

/// `isFaceSturdy` of the block at the position, toward `d`.
pub fn sturdy_at(e: Env, r: Region, x: i32, y: i32, z: i32, d: i32) -> bool ! Thrown {
    return e.facts.sturdy(try r.state(e.facts, x, y, z), d, FULL)
}

/// `canSurvive` of `state` at the position.
pub fn can_survive(e: Env, r: Region, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let kind = f.survive_class(block)
    if kind == "BlockBehaviour" {
        return true
    }
    if kind == "VegetationBlock" {
        return try may_place_on(e, r, state, x, y - 1, z)
    }
    if kind == "FireBlock" {
        if f.sturdy(try r.state(f, x, y - 1, z), UP, FULL) {
            return true
        }
        // `isValidFireLocation`.
        for d in 0..6 {
            if f.can_burn(try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))) {
                return true
            }
        }
        return false
    }
    if kind == "SoulFireBlock" {
        return f.in_set(try r.state(f, x, y - 1, z), f.tag("minecraft:soul_fire_base_blocks"))
    }
    if kind == "PathBlock" {
        let above = try r.state(f, x, y + 1, z)
        return not f.is_solid(above) or f.is_a(f.block(above), "FenceGateBlock")
    }
    if kind == "CandleBlock" {
        return try supports_center(e, r, x, y - 1, z, UP)
    }
    if kind == "ChorusFlowerBlock" {
        let plant = try f.named_block("chorus_plant")
        let below = try r.state(f, x, y - 1, z)
        if f.is(below, plant) or f.in_set(below, f.tag("minecraft:supports_chorus_flower")) {
            return true
        }
        if not f.is_air(below) {
            return false
        }
        var one = false
        for i in 0..4 {
            let d = horizontal(i)
            let n = try r.state(f, x + step_x(d), y, z + step_z(d))
            if f.is(n, plant) {
                if one {
                    return false
                }
                one = true
            } else if not f.is_air(n) {
                return false
            }
        }
        return one
    }
    if kind == "DoublePlantBlock" {
        return try double_plant(e, r, state, x, y, z)
    }
    if kind == "MushroomBlock" {
        let below = try r.state(f, x, y - 1, z)
        if f.in_set(below, f.tag("minecraft:overrides_mushroom_light_requirement")) {
            return true
        }
        return e.raw_brightness() < 13 and try may_place_on(e, r, state, x, y - 1, z)
    }
    if kind == "TallSeagrassBlock" {
        if f.get_name(state, "half") == some(String("upper")) {
            let below = try r.state(f, x, y - 1, z)
            return f.is(below, block) and f.get_name(below, "half") == some(String("lower"))
        }
        let here = try r.state(f, x, y, z)
        return try may_place_on(e, r, state, x, y - 1, z) and f.is_water(here) and f.fluid_amount(here) == 8
    }
    if kind == "SeaPickleBlock" {
        let below = try r.state(f, x, y - 1, z)
        return f.collision_top_any(below) or f.sturdy(below, UP, FULL)
    }
    if kind == "SmallDripleafBlock" {
        if f.get_name(state, "half") == some(String("upper")) {
            return try double_plant(e, r, state, x, y, z)
        }
        return try may_place_on(e, r, state, x, y - 1, z)
    }
    if kind == "MangrovePropaguleBlock" {
        if f.get_bool(state, "hanging") {
            return f.in_set(try r.state(f, x, y + 1, z), f.tag("minecraft:supports_hanging_mangrove_propagule"))
        }
        return try may_place_on(e, r, state, x, y - 1, z)
    }
    if kind == "CropBlock" {
        return e.raw_brightness() >= 8 and try may_place_on(e, r, state, x, y - 1, z)
    }
    if kind == "BaseCoralPlantTypeBlock" {
        return try sturdy_at(e, r, x, y - 1, z, UP)
    }
    if kind == "BaseCoralWallFanBlock" or kind == "AmethystClusterBlock" or kind == "ShelfMushroomBlock" {
        let facing = try facing_of(f, state)
        let d = opposite(facing)
        return try sturdy_at(e, r, x + step_x(d), y + step_y(d), z + step_z(d), facing)
    }
    if kind == "GrowingPlantBlock" {
        return try growing_plant(e, r, state, x, y, z)
    }
    if kind == "MultifaceBlock" {
        var any = false
        for d in 0..6 {
            if f.get_bool(state, direction_property(d)) {
                if not try attaches(e, r, x + step_x(d), y + step_y(d), z + step_z(d), d) {
                    return false
                }
                any = true
            }
        }
        return any
    }
    if kind == "SnowLayerBlock" {
        let below = try r.state(f, x, y - 1, z)
        if f.in_set(below, f.tag("minecraft:cannot_support_snow_layer")) {
            return false
        }
        if f.in_set(below, f.tag("minecraft:support_override_snow_layer")) {
            return true
        }
        return f.collision_face_full(below, UP) or (f.is(below, block) and f.get_int(below, "layers") == some(8))
    }
    if kind == "CactusBlock" {
        for i in 0..4 {
            let d = horizontal(i)
            let n = try r.state(f, x + step_x(d), y, z + step_z(d))
            if f.is_solid(n) or f.is_lava(n) {
                return false
            }
        }
        let below = try r.state(f, x, y - 1, z)
        return (f.is(below, block) or f.in_set(below, f.tag("minecraft:supports_cactus"))) and not f.is_liquid(try r.state(f, x, y + 1, z))
    }
    if kind == "SugarCaneBlock" {
        let below = try r.state(f, x, y - 1, z)
        if f.is(below, block) {
            return true
        }
        if f.in_set(below, f.tag("minecraft:supports_sugar_cane")) {
            for i in 0..4 {
                let d = horizontal(i)
                let n = try r.state(f, x + step_x(d), y - 1, z + step_z(d))
                if f.fluid_in(n, "minecraft:supports_sugar_cane_adjacently") or f.in_set(n, f.tag("minecraft:supports_sugar_cane_adjacently")) {
                    return true
                }
            }
        }
        return false
    }
    if kind == "VineBlock" {
        return try vine_faces(e, r, state, x, y, z)
    }
    if kind == "CocoaBlock" {
        let d = try facing_of(f, state)
        return f.in_set(try r.state(f, x + step_x(d), y, z + step_z(d)), f.tag("minecraft:supports_cocoa"))
    }
    if kind == "ChorusPlantBlock" {
        return try chorus_plant(e, r, state, x, y, z)
    }
    if kind == "BambooSaplingBlock" or kind == "BambooStalkBlock" {
        return f.in_set(try r.state(f, x, y - 1, z), f.tag("minecraft:supports_bamboo"))
    }
    if kind == "SporeBlossomBlock" {
        return try supports_center(e, r, x, y + 1, z, DOWN) and not f.is_water(try r.state(f, x, y, z))
    }
    if kind == "LeafLitterBlock" {
        return try sturdy_at(e, r, x, y - 1, z, UP)
    }
    if kind == "BigDripleafBlock" {
        let below = try r.state(f, x, y - 1, z)
        return f.is(below, block) or f.is(below, f.ids.big_dripleaf_stem) or f.in_set(below, f.tag("minecraft:supports_big_dripleaf"))
    }
    if kind == "BigDripleafStemBlock" {
        let below = try r.state(f, x, y - 1, z)
        let above = try r.state(f, x, y + 1, z)
        return (f.is(below, block) or f.in_set(below, f.tag("minecraft:supports_big_dripleaf"))) and (f.is(above, block) or f.is(above, f.ids.big_dripleaf))
    }
    if kind == "WallTorchBlock" {
        let facing = try facing_of(f, state)
        let back = opposite(facing)
        return f.sturdy(try r.state(f, x + step_x(back), y, z + step_z(back)), facing, FULL)
    }
    if kind == "BaseTorchBlock" {
        return try supports_center(e, r, x, y - 1, z, UP)
    }
    if kind == "HangingRootsBlock" {
        return try sturdy_at(e, r, x, y + 1, z, DOWN)
    }
    if kind == "MossyCarpetBlock" {
        let below = try r.state(f, x, y - 1, z)
        if f.get_bool(state, "bottom") {
            return not f.is_air(below)
        }
        return f.is(below, block) and f.get_bool(below, "bottom")
    }
    if kind == "HangingMossBlock" {
        let above = try r.state(f, x, y + 1, z)
        return attaches_state(f, above, UP) or f.is(above, block)
    }
    if kind == "CarpetBlock" {
        return not f.is_air(try r.state(f, x, y - 1, z))
    }
    if kind == "SpeleothemBlock" {
        let tip = try direction_value(f, state, "vertical_direction")
        let d = opposite(tip)
        let behind = try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        if f.sturdy(behind, tip, FULL) {
            return true
        }
        return f.is(behind, block) and f.get_name(behind, "vertical_direction") == some(String(if tip == UP { "up" } else { "down" }))
    }
    if kind == "FrogspawnBlock" {
        let below = try r.state(f, x, y - 1, z)
        let above_fluid = f.fluid(try r.state(f, x, y, z))
        return (f.fluid_in(below, "minecraft:supports_frogspawn") or f.in_set(below, f.tag("minecraft:supports_frogspawn"))) and above_fluid == 0
    }
    fail Thrown { exception: "Unimplemented", message: "canSurvive of {kind}" }
}

/// `mayPlaceOn` of the block whose class declares it, for the block below at the position.
fn may_place_on(e: Env, r: Region, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let below = try r.state(f, x, y, z)
    let kind = f.place_on_class(f.block(state))
    if kind == "VegetationBlock" {
        return f.in_set(below, f.tag("minecraft:supports_vegetation"))
    }
    if kind == "MushroomBlock" {
        return f.flags(below) & SOLID_RENDER != 0
    }
    if kind == "DryVegetationBlock" {
        return f.in_set(below, f.tag("minecraft:supports_dry_vegetation"))
    }
    if kind == "AzaleaBlock" {
        return f.in_set(below, f.tag("minecraft:supports_azalea"))
    }
    if kind == "NetherSproutsBlock" {
        return f.in_set(below, f.tag("minecraft:supports_nether_sprouts"))
    }
    if kind == "WitherRoseBlock" {
        return f.in_set(below, f.tag("minecraft:supports_wither_rose"))
    }
    if kind == "SeagrassBlock" or kind == "TallSeagrassBlock" {
        return f.sturdy(below, UP, FULL) and not f.in_set(below, f.tag("minecraft:cannot_support_seagrass"))
    }
    if kind == "LilyPadBlock" {
        let above = try r.state(f, x, y + 1, z)
        return (f.fluid_in(below, "minecraft:supports_lily_pad") or f.in_set(below, f.tag("minecraft:supports_lily_pad"))) and f.fluid(above) == 0
    }
    if kind == "SmallDripleafBlock" {
        if f.in_set(below, f.tag("minecraft:supports_small_dripleaf")) {
            return true
        }
        let above = try r.state(f, x, y + 1, z)
        return f.fluid(above) == WATER_FLUID and f.in_set(below, f.tag("minecraft:supports_vegetation"))
    }
    if kind == "CactusFlowerBlock" {
        return f.in_set(below, f.tag("minecraft:support_override_cactus_flower")) or f.sturdy(below, UP, CENTER)
    }
    if kind == "MangrovePropaguleBlock" {
        return f.in_set(below, f.tag("minecraft:supports_mangrove_propagule"))
    }
    if kind == "CropBlock" or kind == "PitcherCropBlock" {
        return f.in_set(below, f.tag("minecraft:supports_crops"))
    }
    if kind == "NetherWartBlock" {
        return f.in_set(below, f.tag("minecraft:supports_nether_wart"))
    }
    if kind == "NetherFungusBlock" or kind == "NetherRootsBlock" or kind == "StemBlock" or kind == "AttachedStemBlock" {
        let tag = configured_support(f, f.block(state)) else fail Thrown { exception: "Unimplemented", message: "mayPlaceOn of {f.codec.blocks.name(f.block(state))}" }
        return f.in_set(below, f.tag(tag))
    }
    fail Thrown { exception: "Unimplemented", message: "mayPlaceOn of {kind}" }
}

/// The tag a block whose `mayPlaceOn` its constructor configures grows on, as `Blocks` makes it.
fn configured_support(f: Facts, block: u32) -> String? {
    let name = f.codec.blocks.name(block)
    if name == "minecraft:warped_fungus" {
        return some("minecraft:supports_warped_fungus")
    }
    if name == "minecraft:crimson_fungus" {
        return some("minecraft:supports_crimson_fungus")
    }
    if name == "minecraft:warped_roots" {
        return some("minecraft:supports_warped_roots")
    }
    if name == "minecraft:crimson_roots" {
        return some("minecraft:supports_crimson_roots")
    }
    if name == "minecraft:pumpkin_stem" or name == "minecraft:attached_pumpkin_stem" {
        return some("minecraft:supports_pumpkin_stem")
    }
    if name == "minecraft:melon_stem" or name == "minecraft:attached_melon_stem" {
        return some("minecraft:supports_melon_stem")
    }
    return none
}

// `DoublePlantBlock.canSurvive`: the lower half as its class's `mayPlaceOn` says, the upper on
// its lower half.
fn double_plant(e: Env, r: Region, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if f.get_name(state, "half") != some(String("upper")) {
        return try may_place_on(e, r, state, x, y - 1, z)
    }
    let below = try r.state(f, x, y - 1, z)
    return f.is(below, f.block(state)) and f.get_name(below, "half") == some(String("lower"))
}

// `GrowingPlantBlock.canSurvive`: on the block behind its growth, if it may attach to it, which
// is its own kind or sturdy toward it.
fn growing_plant(e: Env, r: Region, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let name = f.codec.blocks.name(block)
    // Kelp and twisting vines grow up, weeping and cave vines down.
    let (head, body, grows) = if name == "minecraft:kelp" or name == "minecraft:kelp_plant" {
        (f.ids.kelp, f.ids.kelp_plant, UP)
    } else if name == "minecraft:twisting_vines" or name == "minecraft:twisting_vines_plant" {
        (try f.named_block("twisting_vines"), try f.named_block("twisting_vines_plant"), UP)
    } else if name == "minecraft:weeping_vines" or name == "minecraft:weeping_vines_plant" {
        (try f.named_block("weeping_vines"), try f.named_block("weeping_vines_plant"), DOWN)
    } else {
        (try f.named_block("cave_vines"), try f.named_block("cave_vines_plant"), DOWN)
    }
    let d = opposite(grows)
    let ax = x + step_x(d)
    let ay = y + step_y(d)
    let az = z + step_z(d)
    let attached = try r.state(f, ax, ay, az)
    if head == f.ids.kelp and f.in_set(attached, f.tag("minecraft:cannot_support_kelp")) {
        return false
    }
    return f.is(attached, head) or f.is(attached, body) or f.sturdy(attached, grows, FULL)
}

// `VineBlock.canSurvive`: whether any face is left once each is checked.
fn vine_faces(e: Env, r: Region, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    if f.get_bool(state, "up") {
        if try attaches(e, r, x, y + 1, z, UP) {
            return true
        }
    }
    var above: u32? = none
    for i in 0..4 {
        let d = horizontal(i)
        let name = direction_property(d)
        if f.get_bool(state, name) {
            if try attaches(e, r, x + step_x(d), y, z + step_z(d), d) {
                return true
            }
            if above == none {
                above = some(try r.state(f, x, y + 1, z))
            }
            if let a = above {
                if f.is(a, block) and f.get_bool(a, name) {
                    return true
                }
            }
        }
    }
    return false
}

// `ChorusPlantBlock.canSurvive`.
fn chorus_plant(e: Env, r: Region, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let supports = f.tag("minecraft:supports_chorus_plant")
    let below = try r.state(f, x, y - 1, z)
    let above_or_below = not f.is_air(try r.state(f, x, y + 1, z)) and not f.is_air(below)
    for i in 0..4 {
        let d = horizontal(i)
        let nx = x + step_x(d)
        let nz = z + step_z(d)
        if f.is(try r.state(f, nx, y, nz), block) {
            if above_or_below {
                return false
            }
            let under = try r.state(f, nx, y - 1, nz)
            if f.is(under, block) or f.in_set(under, supports) {
                return true
            }
        }
    }
    return f.is(below, block) or f.in_set(below, supports)
}

/// `MultifaceBlock.canAttachTo` of the block at the position, which is toward `d`.
pub fn attaches(e: Env, r: Region, x: i32, y: i32, z: i32, d: i32) -> bool ! Thrown {
    return attaches_state(e.facts, try r.state(e.facts, x, y, z), d)
}

/// `MultifaceBlock.canAttachTo` of a neighbour's state toward `d`: its support shape or its
/// collision shape covers the face toward us.
pub fn attaches_state(f: Facts, neighbour: u32, d: i32) -> bool {
    let face = opposite(d)
    return f.sturdy(neighbour, face, FULL) or f.collision_face_full(neighbour, face)
}

/// `Block.canSupportCenter` of the block at the position, toward `d`.
pub fn supports_center(e: Env, r: Region, x: i32, y: i32, z: i32, d: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let s = try r.state(f, x, y, z)
    if d == DOWN and f.in_set(s, f.tag("minecraft:unstable_bottom_center")) {
        return false
    }
    return f.sturdy(s, d, CENTER)
}

/// The boolean property a multiface or vine block has for a face: the direction's name.
pub fn direction_property(d: i32) -> String {
    return match d {
        0 => "down",
        1 => "up",
        2 => "north",
        3 => "south",
        4 => "west",
        _ => "east",
    }
}

/// The state's `facing`.
pub fn facing_of(f: Facts, state: u32) -> i32 ! Thrown {
    return try direction_value(f, state, "facing")
}

/// The state's direction property `name`.
pub fn direction_value(f: Facts, state: u32, name: String) -> i32 ! Thrown {
    let text = f.get_name(state, name) else fail Thrown { exception: "IllegalArgumentException", message: "Cannot get property {name} as it does not exist in {f.codec.blocks.name(f.block(state))}" }
    for d in 0..6 {
        if text == direction_property(d) {
            return d
        }
    }
    fail Thrown { exception: "IllegalArgumentException", message: "not a direction: {text}" }
}

