/// Structures placed as a chunk is decorated, as `applyBiomeDecoration` places them before each
/// step's features: for each structure of the step, in the structure registry's order and each
/// from its own seed, the starts the chunk references, each placed by
/// `StructureStart.placeInChunk`: every piece whose box reaches the chunk post-processed in it,
/// then the structure's `afterPlace`.
module worldgen.placing

import random.source.{RandomSource}
import worldgen.features.{Decorating, Gen}
import worldgen.interval.{Thrown}
import worldgen.jigsaw.{Pools}
import worldgen.pieces.{Piece, PieceData, Start}
import worldgen.pool_pieces.{ElementCache, place_jigsaw}
import worldgen.references.{Refs, StartMap}
import worldgen.region.{Region}
import worldgen.fortress_pieces.{fortress_piece}
import worldgen.mineshaft_pieces.{mineshaft_piece}
import worldgen.monument_pieces.{monument_piece}
import worldgen.stronghold_pieces.{stronghold_piece}
import worldgen.scattered_pieces.{buried_treasure, desert_pyramid, desert_pyramid_after, jungle_temple, swamp_hut}
import worldgen.structure_world.{StructureWorld}
import worldgen.structures.{Structures}
import worldgen.template_pieces.{mansion_after, template_piece}
import worldgen.survive.{Env}
import worldgen.template.{Bounds}

/// What pieces read as they're placed: the decoration's features and the generator's
/// structures, templates and pools.
pub struct Placer {
    pub structures: Structures
    pub pools: Pools
    /// The structures in the registry's order.
    pub order: List<usize>
    /// What the jigsaw pieces' elements need, loaded before decoration.
    pub elements: ElementCache
    /// The biomes no mineshaft piece is placed in: `#mineshaft_blocking`.
    pub mineshaft_blocking: List<i32>
}

/// `applyBiomeDecoration` of the region's center chunk with structures: before each step's
/// features, its structures' starts the chunk references, `refs`, placed in it.
pub fn decorate_structured(g: Gen, w: StructureWorld, p: Placer, starts: mut StartMap, refs: List<Refs>, r: mut Region, seed: i64) ! Thrown {
    var d = try Decorating.new(g, r, seed)
    for step in 0..d.steps {
        try place_step(g, w, p, mut starts, refs, mut r, mut d, step)
        try d.features(g, mut r, step)
    }
}

/// The structures of the step placed in the region's center chunk: each structure of the step
/// gets the next feature seed, and each of its starts the chunk references, in `refs`' order, is
/// placed from it.
pub fn place_step(g: Gen, w: StructureWorld, p: Placer, starts: mut StartMap, refs: List<Refs>, r: mut Region, d: mut Decorating, step: i32) ! Thrown {
    var index = 0
    for st in p.order {
        if p.structures.structures[st].step != step {
            continue
        }
        d.random.set_feature_seed(d.seed, index, step)
        index += 1
        for found in refs {
            if found.structure != st {
                continue
            }
            for key in found.chunks.values() {
                // `getStartForStructure`: the start of the structure in the chunk, if it's valid.
                var list = starts.chunks.remove(key) else continue
                for i in 0..list.len() {
                    if list[i].id == p.structures.structures[st].id and not list[i].pieces.is_empty() {
                        try place_in_chunk(g, w, p, st, mut r, mut d.random, mut list[i])
                    }
                }
                starts.chunks.insert(key, list)
            }
        }
    }
}

/// `StructureStart.placeInChunk` in the region's center chunk: each piece whose box reaches the
/// chunk's writable area post-processed, from the reference of the first piece's box, its
/// middle across and its bottom; then the structure's `afterPlace`.
pub fn place_in_chunk<T: RandomSource>(g: Gen, w: StructureWorld, p: Placer, st: usize, r: mut Region, random: mut T, start: mut Start) ! Thrown {
    if start.pieces.is_empty() {
        return
    }
    let first = start.pieces[0].bb
    let ref_x = first.min_x + (first.max_x - first.min_x + 1) / 2
    let ref_z = first.min_z + (first.max_z - first.min_z + 1) / 2
    let ref_y = first.min_y
    // `getWritableArea`.
    let x0 = r.cx << 4
    let z0 = r.cz << 4
    var area = Bounds { min_x: x0, min_y: r.min_y + 1, min_z: z0, max_x: x0 + 15, max_y: r.min_y + r.height - 1, max_z: z0 + 15 }
    for i in 0..start.pieces.len() {
        let b = start.pieces[i].bb
        let meets = b.max_x >= area.min_x and b.min_x <= area.max_x and b.max_z >= area.min_z and b.min_z <= area.max_z and b.max_y >= area.min_y and b.min_y <= area.max_y
        if meets {
            try post_process(g, w, p, mut r, mut random, mut start.pieces[i], mut area, ref_x, ref_y, ref_z)
        }
    }
    try after_place(g, mut r, p, st, start, area)
}

// `StructurePiece.postProcess` of the piece, by its kind.
fn post_process<T: RandomSource>(g: Gen, w: StructureWorld, p: Placer, r: mut Region, random: mut T, piece: mut Piece, area: mut Bounds, ref_x: i32, ref_y: i32, ref_z: i32) ! Thrown {
    let Gen { env: Env { facts: f, .. }, .. } = g
    match piece.data {
        PieceData.Jigsaw(j) => {
            try place_jigsaw(g, w, p.elements, p.pools, mut r, mut random, j, area, ref_x, ref_y, ref_z)
            return
        },
        _ => {},
    }
    if piece.kind == "minecraft:btp" {
        try buried_treasure(f, mut r, mut random, mut piece, area)
        return
    }
    if piece.kind == "minecraft:tesh" {
        try swamp_hut(f, mut r, mut piece, area)
        return
    }
    if piece.kind == "minecraft:tejp" {
        try jungle_temple(f, mut r, mut random, mut piece, area)
        return
    }
    if piece.kind == "minecraft:tedp" {
        try desert_pyramid(f, mut r, mut random, mut piece, area)
        return
    }
    if is_fortress_piece(piece.kind) {
        try fortress_piece(f, mut r, mut random, mut piece, area)
        return
    }
    if is_stronghold_piece(piece.kind) {
        try stronghold_piece(f, mut r, mut random, mut piece, area)
        return
    }
    if piece.kind == "minecraft:omb" {
        try monument_piece(f, mut r, mut random, piece, area)
        return
    }
    if piece.kind.starts_with("minecraft:ms") {
        try mineshaft_piece(f, mut r, mut random, mut piece, area, p.mineshaft_blocking)
        return
    }
    match piece.data {
        PieceData.Template(_) => {
            let Gen { env: env, .. } = g
            try template_piece(env, w, mut r, mut random, mut piece, mut area, ref_x, ref_y, ref_z)
            return
        },
        _ => {},
    }
    fail Thrown { exception: "Unimplemented", message: "placing a {piece.kind} piece" }
}

// Whether the piece is one of a stronghold's.
fn is_stronghold_piece(kind: String) -> bool {
    let kinds: List<str> = ["shstart", "shs", "shph", "shlt", "shrt", "shrc", "shssd", "shsd", "sh5c", "shcc", "shli", "shpr", "shfc"]
    for k in kinds {
        if kind == "minecraft:{k}" {
            return true
        }
    }
    return false
}

// Whether the piece is one of a Nether fortress's.
fn is_fortress_piece(kind: String) -> bool {
    let kinds: List<str> = ["nestart", "nebcr", "nebef", "nebs", "neccs", "nectb", "nece", "nescsc", "nesclt", "nescrt", "nesc", "necsr", "nemt", "nerc", "nesr"]
    for k in kinds {
        if kind == "minecraft:{k}" {
            return true
        }
    }
    return false
}

// `Structure.afterPlace`: what a mansion or a desert pyramid does once its pieces are placed.
fn after_place(g: Gen, r: mut Region, p: Placer, st: usize, start: Start, area: Bounds) ! Thrown {
    let Gen { env: Env { facts: f, .. }, .. } = g
    let kind = p.structures.structures[st].kind.copy()
    if kind == "minecraft:desert_pyramid" {
        try desert_pyramid_after(f, mut r, start, area)
    }
    if kind == "minecraft:woodland_mansion" {
        try mansion_after(f, mut r, start, area)
    }
}
