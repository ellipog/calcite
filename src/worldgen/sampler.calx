/// Vanilla's density samplers: what a `RandomState` compiles density functions into
/// (worldgen.density), kept as a program of samplers that refer to each other by index, and
/// sampled at a block or over a volume, through a context that holds the caches. Each sampler
/// works in `float` with vanilla's operations in vanilla's order, takes the buffers vanilla takes
/// and fills them as vanilla does, so a value is the same bits vanilla gives, and where vanilla
/// throws, sampling fails with the same exception and message.
module worldgen.sampler

import worldgen.beardifier.{Beardifier}
import worldgen.interval.{Thrown, java_log, java_pow, signum}
import worldgen.noise.{Noise, Volume}

/// An axis, as `Direction.Axis`.
pub enum Axis {
    X
    Y
    Z
}

/// A gradient's `TilingMode`.
pub enum Tiling {
    Clamp
    Repeat
    Mirrored
}

/// `DistanceMetric`.
pub enum Metric {
    Euclidean
    Squared
    Manhattan
    Chebyshev
}

/// `UnaryFunction.Type`.
pub enum UnaryOp {
    Abs
    Square
    Cube
    Sqrt
    HalfNegative
    QuarterNegative
    Reciprocal
    Negate
    Squeeze
    Log
    Sign
}

/// `RoundFunction.Type`.
pub enum RoundOp {
    Floor
    Round
    Ceil
    Truncate
}

/// The samplers of `BinaryFunction` with a constant side: `Sub` is the constant minus the input
/// and `Div` the constant over it.
pub enum ConstOp {
    Add
    Sub
    Mul
    Div
    Min
    Max
}

/// One of vanilla's samplers. Fields that are samplers are indices into `Program.samplers`.
pub enum Sampler {
    Constant(f32)
    /// `NoiseFunction.Sampler`: noise `noise` at the block times the scales.
    Noise { noise: usize, xz: f64, ys: f64 }
    /// `NoiseFunction.ShiftedXzSampler`.
    ShiftedXz { sx: usize, sz: usize, noise: usize, xz: f64, ys: f64 }
    /// `NoiseFunction.ShiftedXyzSampler`.
    ShiftedXyz { sx: usize, sy: usize, sz: usize, noise: usize, xz: f64, ys: f64 }
    /// `ShiftNoiseFunction.ShiftB`'s sampler.
    ShiftB { noise: usize }
    /// `EndIslandFunction.Sampler`, over a simplex noise.
    EndIslands { noise: usize }
    /// `DistanceToPointFunction.Sampler`.
    Distance { px: i32, py: i32, pz: i32, metric: Metric }
    /// A `GradientFunction` sampler: `low` and `high` are the clamped one's bounds and `span` the
    /// repeating ones' `coordinateRange`.
    Gradient { axis: Axis, tiling: Tiling, from: i32, low: i32, high: i32, span: i32, from_value: f32, factor: f32 }
    Unary { op: UnaryOp, input: usize }
    Add { left: usize, right: usize }
    Sub { left: usize, right: usize }
    Mul { left: usize, right: usize }
    Div { left: usize, right: usize }
    /// `MinSampler`, which skips the right side where the left is at most its least value.
    Min { left: usize, right: usize, bound: f32 }
    /// `MaxSampler`, which skips the right side where the left is at least its greatest value.
    Max { left: usize, right: usize, bound: f32 }
    Const { op: ConstOp, input: usize, value: f32 }
    ConstBasePow { base: f64, exponent: usize }
    ConstExponentPow { base: usize, exponent: f64 }
    Pow { base: usize, exponent: usize }
    /// `RoundFunction.IntegerMultipleSampler`: rounded to a whole number.
    RoundInteger { op: RoundOp, input: usize }
    Round { op: RoundOp, input: usize, multiple: usize }
    Lerp { alpha: usize, first: usize, second: usize }
    LerpConstFirst { alpha: usize, first: f32, second: usize }
    LerpConstSecond { alpha: usize, first: usize, second: f32 }
    Clamp { input: usize, low: f32, high: f32 }
    /// `RangeChoiceFunction.ConstSampler`: `inside` where `low <= input < high`, else `outside`.
    ChoiceConst { input: usize, low: f32, high: f32, inside: f32, outside: f32 }
    Choice { input: usize, low: f32, high: f32, inside: usize, outside: usize }
    /// `IntervalSelectFunction.SingleThresholdSampler`.
    SelectOne { input: usize, threshold: f32, below: usize, above: usize }
    /// `IntervalSelectFunction.Sampler`: `thresholds` indexes `Program.floats` and `functions`
    /// `Program.lists`.
    Select { input: usize, thresholds: usize, functions: usize }
    /// `SplineFunction.Sampler`: curve `curve`, over `count` coordinates.
    Spline { curve: usize, count: usize }
    /// `CachingDensitySampler`, cache `id` of the context.
    Caching { id: usize, input: usize }
    Interpolated { input: usize, xz: i32, ys: i32, xz_inv: f32, y_inv: f32 }
    SliceX { input: usize, at: i32 }
    SliceY { input: usize, at: i32 }
    SliceZ { input: usize, at: i32 }
    /// `SliceFunction.XzSampler`: slices in X and Z at once.
    SliceXz { input: usize, x_at: i32, z_at: i32 }
    /// `FindTopSurfaceFunction`'s sampler, under a slice at Y 0.
    FindTop { density: usize, upper: usize, lower: i32, cell: i32 }
    /// The `beardifier` marker, bound to the context's beardifier: 0 without one, as `EMPTY`.
    Beard
}

/// A cubic spline as a spline sampler holds it, `CubicSpline` with its coordinates compiled.
pub enum Curve {
    Constant(f32)
    /// `coordinate` is the coordinate's index in its spline sampler and `sampler` its sampler.
    /// `locations` and `derivatives` index `Program.floats`, and `values`, which are curves,
    /// `Program.lists`. `constants` indexes `Program.floats` too: each value's constant where it's
    /// one, else NaN (D307).
    Points { coordinate: usize, sampler: usize, locations: usize, derivatives: usize, values: usize, constants: usize }
}

/// Compiled samplers, the noises they sample and the lists they hold.
pub struct Program {
    pub samplers: List<Sampler>
    pub noises: List<Noise>
    pub curves: List<Curve>
    pub floats: List<List<f32>>
    pub lists: List<List<usize>>
}

impl Program {
    pub fn new() -> Program {
        return Program { samplers: [], noises: [], curves: [], floats: [], lists: [] }
    }

    pub fn add(mut self, s: Sampler) -> usize {
        self.samplers.push(s)
        return self.samplers.len() - 1
    }
}

/// `SamplerContext.CacheCell`: the volume last sampled and its values, and the block last
/// sampled and its value.
struct Cell {
    filled: bool
    volume: Volume
    buffer: List<f32>
    key: i64
    value: f32
}

// The input of an interpolated sampler at the corners of a volume's cells, kept for the parts of
// that volume filled after it.
struct Grid {
    sampler: usize
    corners: Volume
    values: List<f32>
}

/// `SamplerContext`: with caches, as `enableCaches` makes one, or without, as `EMPTY_UNCACHED`.
pub struct Context {
    cached: bool
    cells: List<Cell>
    /// The chunk's beardifier, which `NoiseChunk` binds the marker to; none for `EMPTY`.
    pub beard: Beardifier?
    /// A volume filled a part at a time: each interpolated sampler filled over a part of it works
    /// out its input at the corners of the whole volume's cells once, as filling it whole would,
    /// and the parts after take theirs from those. None to fill each volume as it comes.
    pub whole: Volume? = none
    grids: List<Grid> = List<Grid>()
    /// The corners a worker's chunks kept on their sides, which the corners of a whole chunk's
    /// volume take theirs on its west and north sides from; none for a chunk's own (D301).
    pub faces: CornerFaces? = none
}

impl Context {
    pub fn new(cached: bool) -> Context {
        return Context { cached: cached, cells: [], beard: none }
    }

    fn cell(mut self, id: usize) {
        while self.cells.len() <= id {
            self.cells.push(Cell {
                filled: false,
                volume: Volume { size_x: 0, size_y: 0, size_z: 0, min_x: 0, min_y: 0, min_z: 0 },
                buffer: [],
                key: 0,
                value: f32.NAN,
            })
        }
    }
}

// The side of the window of chunks whose corners `CornerFaces` keeps, and its places; a chunk
// key for none; and how far from 0, in blocks, a chunk's corners are kept, so nothing about them
// comes near the ends of `int`.
const FACE_SIDE: i32 = 8
const FACE_PLACES: usize = 64
const NO_FACE: i64 = i64.MIN
const FAR_FACES: i32 = 33554432

/// The corners of the cells of each interpolated sampler on each chunk's east and south sides, as
/// a worker's fills of its chunks worked them out, kept for the chunks east and south of it, on
/// whose west and north sides they are. A corner's value is the sampler's input at that point,
/// whichever chunk it's worked out for, unless the input reads the beardifier and the chunk has
/// one; then they're neither kept nor taken. A chunk's are at its x and z modulo 8, until one 8
/// chunks from it takes their place: for each sampler, a table of 64 chunks' sides, 125 KB for
/// vanilla's, from when it's first asked to keep one (D301).
pub struct CornerFaces {
    tables: List<FaceTable> = List<FaceTable>()
}

impl CornerFaces {
    pub fn new() -> CornerFaces {
        return CornerFaces {}
    }
}

// One interpolated sampler's kept corners, of chunks whose corners are at the heights `min_y`
// up, `size_y` of them `step_y` apart, and `side` columns `step_xz` apart along each side.
// Each place's chunk, `NO_FACE` for none, and the corners on its east side, then on its south,
// each column from the north or west, `size_y` from the bottom.
struct FaceTable {
    sampler: usize
    bearded: bool
    min_y: i32
    size_y: i32
    step_y: i32
    step_xz: i32
    side: i32
    keys: List<i64>
    values: List<f32>
}

// The key of the chunk at `x`, `z`.
fn face_key(x: i32, z: i32) -> i64 {
    return (i64(x) << 32) | i64(u32.wrap(z))
}

// Where the chunk at `x`, `z` is kept.
fn face_place(x: i32, z: i32) -> usize {
    return usize.wrap((x & (FACE_SIDE - 1)) | ((z & (FACE_SIDE - 1)) * FACE_SIDE))
}

fn illegal_argument(message: own String) -> Thrown {
    return Thrown { exception: "IllegalArgumentException", message: message }
}

/// `new DensityVolume(...)`, with its checks.
pub fn volume(sx: i32, sy: i32, sz: i32, mx: i32, my: i32, mz: i32, tx: i32, ty: i32, tz: i32) -> Volume ! Thrown {
    if sx <= 0 or sy <= 0 or sz <= 0 {
        fail illegal_argument("Size must be positive, was: {sx}x{sy}x{sz}")
    }
    if not (tx > 0 and ty > 0 and tz > 0) {
        fail illegal_argument("Step must be positive, was: {tx}; {ty}; {tz}")
    }
    return Volume { size_x: sx, size_y: sy, size_z: sz, min_x: mx, min_y: my, min_z: mz, step_x: tx, step_y: ty, step_z: tz }
}

/// A buffer as `DensityBufferArena.GLOBAL` gives one: `new float[size]`, all zeros.
pub fn zeros(size: i32) -> List<f32> ! Thrown {
    if size < 0 {
        fail Thrown { exception: "NegativeArraySizeException", message: "{size}" }
    }
    return [0.0f32; usize.wrap(size)]
}

fn at(i: i32) -> usize {
    return usize.wrap(i)
}

/// `Arrays.fill(values, from, from + count, value)`.
fn set_range(out: mut List<f32>, from: i32, count: i32, value: f32) {
    var i = from
    let end = from + count
    while i < end {
        out[at(i)] = value
        i += 1
    }
}

/// `Mth.lerp`.
fn lerp(alpha: f32, first: f32, second: f32) -> f32 {
    return first + alpha * (second - first)
}

/// `Mth.clamp(float, float, float)`.
fn clamp(v: f32, low: f32, high: f32) -> f32 {
    return if v < low { low } else { v.min(high) }
}

/// `BlockPos.asLong`.
fn block_key(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 0x3FFFFFF) << 38) | ((i64(z) & 0x3FFFFFF) << 12) | (i64(y) & 0xFFF)
}

/// A unary function's value, as its sampler gives it.
pub fn unary(op: UnaryOp, x: f32) -> f32 {
    return match op {
        Abs => x.abs(),
        Square => x * x,
        Cube => x * x * x,
        Sqrt => f32.nearest(f64(x).sqrt()),
        HalfNegative => if x > 0.0f32 { x } else { x * 0.5f32 },
        QuarterNegative => if x > 0.0f32 { x } else { x * 0.25f32 },
        Reciprocal => 1.0f32 / x,
        Negate => -x,
        Squeeze => {
            let c = clamp(x, -1.0f32, 1.0f32)
            c / 2.0f32 - c * c * c / 24.0f32
        },
        Log => java_log(x),
        Sign => signum(x),
    }
}

// Element-wise passes over a volume's values. Each is bounded by every list it reads, so none of
// its reads can fail and the compiler can do it several values at a time; the lists are always
// of one volume, so the bound is each one's length.

// The lists must be of one length.
fn same_length(a: usize, b: usize) {
    if a != b {
        panic("a pass over buffers of {a} and {b} values")
    }
}

/// `unary` of each value, the function picked once.
fn unary_all(op: UnaryOp, out: mut List<f32>) {
    let n = out.len()
    match op {
        Abs => {
            for i in 0..n {
                out[i] = out[i].abs()
            }
        },
        Square => {
            for i in 0..n {
                let x = out[i]
                out[i] = x * x
            }
        },
        Cube => {
            for i in 0..n {
                let x = out[i]
                out[i] = x * x * x
            }
        },
        Negate => {
            for i in 0..n {
                out[i] = -out[i]
            }
        },
        HalfNegative => {
            for i in 0..n {
                let x = out[i]
                out[i] = if x > 0.0f32 { x } else { x * 0.5f32 }
            }
        },
        QuarterNegative => {
            for i in 0..n {
                let x = out[i]
                out[i] = if x > 0.0f32 { x } else { x * 0.25f32 }
            }
        },
        Squeeze => {
            for i in 0..n {
                let c = clamp(out[i], -1.0f32, 1.0f32)
                out[i] = c / 2.0f32 - c * c * c / 24.0f32
            }
        },
        _ => {
            for i in 0..n {
                out[i] = unary(op, out[i])
            }
        },
    }
}

fn add_all(out: mut List<f32>, r: List<f32>) {
    same_length(out.len(), r.len())
    let n = out.len().min(r.len())
    for i in 0..n {
        out[i] = out[i] + r[i]
    }
}

fn sub_all(out: mut List<f32>, r: List<f32>) {
    same_length(out.len(), r.len())
    let n = out.len().min(r.len())
    for i in 0..n {
        out[i] = out[i] + -r[i]
    }
}

fn mul_all(out: mut List<f32>, r: List<f32>) {
    same_length(out.len(), r.len())
    let n = out.len().min(r.len())
    for i in 0..n {
        out[i] = out[i] * r[i]
    }
}

fn div_all(out: mut List<f32>, r: List<f32>) {
    same_length(out.len(), r.len())
    let n = out.len().min(r.len())
    for i in 0..n {
        out[i] = out[i] / r[i]
    }
}

/// `r` where it's less than `out`, as `MinSampler` keeps the right where `right < left`.
fn min_all(out: mut List<f32>, r: List<f32>) {
    same_length(out.len(), r.len())
    let n = out.len().min(r.len())
    for i in 0..n {
        let a = out[i]
        let b = r[i]
        out[i] = if b < a { b } else { a }
    }
}

/// `r` where it's more than `out`.
fn max_all(out: mut List<f32>, r: List<f32>) {
    same_length(out.len(), r.len())
    let n = out.len().min(r.len())
    for i in 0..n {
        let a = out[i]
        let b = r[i]
        out[i] = if b > a { b } else { a }
    }
}

/// `RoundFunction.Type.roundToInteger`.
pub fn round_to_integer(op: RoundOp, x: f32) -> f32 {
    return match op {
        Floor => x.floor(),
        Round => f32.nearest(i32.round(x)),
        Ceil => x.ceil(),
        Truncate => if x > 0.0f32 { x.floor() } else { x.ceil() },
    }
}

fn round_multiple(op: RoundOp, x: f32, multiple: f32) -> f32 {
    if multiple == 0.0f32 {
        return x
    }
    return round_to_integer(op, x / multiple) * multiple
}

fn metric(m: Metric, dx: f32, dy: f32, dz: f32) -> f32 {
    return match m {
        Euclidean => f32.nearest(f64(dx * dx + dy * dy + dz * dz).sqrt()),
        Squared => dx * dx + dy * dy + dz * dz,
        Manhattan => dx.abs() + dy.abs() + dz.abs(),
        Chebyshev => dx.abs().max(dy.abs()).max(dz.abs()),
    }
}

fn divide_by_zero() -> Thrown {
    return Thrown { exception: "ArithmeticException", message: "/ by zero" }
}

fn gradient(tiling: Tiling, c: i32, from: i32, low: i32, high: i32, span: i32, from_value: f32, factor: f32) -> f32 ! Thrown {
    match tiling {
        Clamp => {
            let rel = (if c < low { low } else { c.min(high) }) - from
            return from_value + f32.nearest(rel) * factor
        },
        Repeat => {
            if span == 0 {
                fail divide_by_zero()
            }
            return from_value + f32.nearest((c - from).floor_mod(span)) * factor
        },
        Mirrored => {
            if span == 0 {
                fail divide_by_zero()
            }
            let rel = c - from
            let tile = rel.floor_div(span)
            let local = rel - tile * span
            if (tile & 1) == 0 {
                return from_value + f32.nearest(local) * factor
            }
            return from_value + f32.nearest(span - local) * factor
        },
    }
}

/// `EndIslandFunction.getHeightValue`.
fn island_height(noise: Noise, section_x: i32, section_z: i32) -> f32 {
    let chunk_x = section_x / 2
    let chunk_z = section_z / 2
    let sub_x = section_x % 2
    let sub_z = section_z % 2
    var doffs = -100.0f32
    for xo in -12..13 {
        for zo in -12..13 {
            let tx = i64(chunk_x + xo)
            let tz = i64(chunk_z + zo)
            if tx * tx + tz * tz > 4096 and noise.get2(f64.nearest(tx), f64.nearest(tz)) < -0.9f32 {
                let size = (f32.nearest(tx).abs() * 3439.0f32 + f32.nearest(tz).abs() * 147.0f32) % 13.0f32 + 9.0f32
                let xd = f32.nearest(sub_x - xo * 2)
                let zd = f32.nearest(sub_z - zo * 2)
                let nd = clamp(100.0f32 - f32.nearest(f64(xd * xd + zd * zd).sqrt()) * size, -100.0f32, 80.0f32)
                doffs = doffs.max(nd)
            }
        }
    }
    return doffs
}

fn island_value(noise: Noise, x: i32, z: i32) -> f32 {
    return (island_height(noise, x / 8, z / 8) - 8.0f32) / 128.0f32
}

/// What a spline's coordinates are sampled from: a block, each coordinate sampled once
/// (`PointSplineInput`), or a volume, each coordinate's buffer filled the first time it's
/// needed (`BufferSplineInput`).
struct SplineInput {
    point: bool
    x: i32
    y: i32
    z: i32
    values: List<f32>
    filled: List<bool>
    buffers: List<List<f32>>
    volume: Volume
    index: usize
    /// Over a volume, the coordinates the point being worked out has read, a bit each, and
    /// whether it read one past the 64th (D302).
    reads: u64 = 0
    wide: bool = false
}

fn coordinate(p: Program, ctx: mut Context, input: mut SplineInput, sampler: usize, k: usize) -> f32 ! Thrown {
    if input.point {
        let cached = input.values[k]
        if not cached.is_nan() {
            return cached
        }
        let v = try sample(p, mut ctx, sampler, input.x, input.y, input.z)
        input.values[k] = v
        return v
    }
    if not input.filled[k] {
        var buffer = try zeros(input.volume.size())
        try fill(p, mut ctx, sampler, mut buffer, input.volume)
        input.buffers[k] = buffer
        input.filled[k] = true
    }
    if k < 64 {
        input.reads = input.reads | (1u64 << u64(k))
    } else {
        input.wide = true
    }
    return input.buffers[k][input.index]
}

// Whether each coordinate of `reads` is the same, to the bit, at the volume's points `a` and `b`.
fn same_reads(input: SplineInput, reads: u64, a: usize, b: usize) -> bool {
    var left = reads
    var k: usize = 0
    while left != 0 {
        if (left & 1) != 0 and input.buffers[k][a].to_bits() != input.buffers[k][b].to_bits() {
            return false
        }
        left = left >> 1
        k += 1
    }
    return true
}

/// `Mth.binarySearch(0, n, i -> x < locations[i])`: the first location above `x`.
fn search(locations: List<f32>, x: f32) -> i32 {
    var from: i32 = 0
    var len = i32.wrap(locations.len())
    while len > 0 {
        let half = len / 2
        let mid = from + half
        if x < locations[at(mid)] {
            len = half
        } else {
            from = mid + 1
            len -= half + 1
        }
    }
    return from
}

fn extend(x: f32, location: f32, value: f32, derivative: f32) -> f32 {
    return if derivative == 0.0f32 { value } else { value + derivative * (x - location) }
}

/// `CubicSpline.Multipoint.sample`.
fn curve(p: Program, ctx: mut Context, input: mut SplineInput, c: usize) -> f32 ! Thrown {
    match p.curves[c] {
        Constant(v) => return v,
        Points { coordinate: k, sampler, locations, derivatives, values, constants } => {
            let x = try coordinate(p, mut ctx, mut input, sampler, k)
            return try points(p, mut ctx, mut input, x, p.floats[locations], p.floats[derivatives], p.lists[values], p.floats[constants])
        },
    }
}

/// The curve's value `i`: its constant where it's one, as most are, else its curve's value.
fn value_at(p: Program, ctx: mut Context, input: mut SplineInput, vs: List<usize>, cs: List<f32>, i: usize) -> f32 ! Thrown {
    let c = cs[i]
    if not c.is_nan() {
        return c
    }
    return try curve(p, mut ctx, mut input, vs[i])
}

fn points(p: Program, ctx: mut Context, input: mut SplineInput, x: f32, locs: List<f32>, ds: List<f32>, vs: List<usize>, cs: List<f32>) -> f32 ! Thrown {
    let start = search(locs, x) - 1
    let last = locs.len() - 1
    if start < 0 {
        let y = try value_at(p, mut ctx, mut input, vs, cs, 0)
        return extend(x, locs[0], y, ds[0])
    }
    let s = at(start)
    if s == last {
        let y = try value_at(p, mut ctx, mut input, vs, cs, last)
        return extend(x, locs[last], y, ds[last])
    }
    let x1 = locs[s]
    let x2 = locs[s + 1]
    let t = (x - x1) / (x2 - x1)
    let d1 = ds[s]
    let d2 = ds[s + 1]
    let y1 = try value_at(p, mut ctx, mut input, vs, cs, s)
    let y2 = try value_at(p, mut ctx, mut input, vs, cs, s + 1)
    let a = d1 * (x2 - x1) - (y2 - y1)
    let b = -d2 * (x2 - x1) + (y2 - y1)
    return lerp(t, y1, y2) + t * (1.0f32 - t) * lerp(t, a, b)
}

/// The first of `functions` whose threshold is above `x`, or the last if none is.
fn select(x: f32, thresholds: List<f32>, functions: List<usize>) -> usize {
    for i in 0..thresholds.len() {
        if x < thresholds[i] {
            return functions[i]
        }
    }
    return functions[functions.len() - 1]
}

/// `sampleValue`: sampler `s` at the block.
pub fn sample(p: Program, ctx: mut Context, s: usize, bx: i32, by: i32, bz: i32) -> f32 ! Thrown {
    match p.samplers[s] {
        Constant(v) => return v,
        Beard => {
            if let b = ctx.beard {
                return b.sample(bx, by, bz)
            }
            return 0.0f32
        },
        Noise { noise, xz, ys } => return p.noises[noise].get(f64(bx) * xz, f64(by) * ys, f64(bz) * xz),
        ShiftedXz { sx, sz, noise, xz, ys } => {
            let x = f64(bx) * xz + f64(try sample(p, mut ctx, sx, bx, by, bz))
            let y = f64(by) * ys
            let z = f64(bz) * xz + f64(try sample(p, mut ctx, sz, bx, by, bz))
            return p.noises[noise].get(x, y, z)
        },
        ShiftedXyz { sx, sy, sz, noise, xz, ys } => {
            let x = f64(bx) * xz + f64(try sample(p, mut ctx, sx, bx, by, bz))
            let y = f64(by) * ys + f64(try sample(p, mut ctx, sy, bx, by, bz))
            let z = f64(bz) * xz + f64(try sample(p, mut ctx, sz, bx, by, bz))
            return p.noises[noise].get(x, y, z)
        },
        ShiftB { noise } => return p.noises[noise].get(f64(bz) * 0.25, f64(bx) * 0.25, 0.0) * 4.0f32,
        EndIslands { noise } => return island_value(p.noises[noise], bx, bz),
        Distance { px, py, pz, metric: m } => return metric(m, f32.nearest(px - bx), f32.nearest(py - by), f32.nearest(pz - bz)),
        Gradient { axis, tiling, from, low, high, span, from_value, factor } => {
            let c = match axis {
                X => bx,
                Y => by,
                Z => bz,
            }
            return try gradient(tiling, c, from, low, high, span, from_value, factor)
        },
        Unary { op, input } => return unary(op, try sample(p, mut ctx, input, bx, by, bz)),
        Add { left, right } => {
            let l = try sample(p, mut ctx, left, bx, by, bz)
            return l + try sample(p, mut ctx, right, bx, by, bz)
        },
        Sub { left, right } => {
            let l = try sample(p, mut ctx, left, bx, by, bz)
            return l - try sample(p, mut ctx, right, bx, by, bz)
        },
        Mul { left, right } => {
            let l = try sample(p, mut ctx, left, bx, by, bz)
            if l == 0.0f32 {
                return 0.0f32
            }
            return l * try sample(p, mut ctx, right, bx, by, bz)
        },
        Div { left, right } => {
            let l = try sample(p, mut ctx, left, bx, by, bz)
            if l == 0.0f32 {
                return 0.0f32
            }
            return l / try sample(p, mut ctx, right, bx, by, bz)
        },
        Min { left, right, bound } => {
            let l = try sample(p, mut ctx, left, bx, by, bz)
            if l <= bound {
                return l
            }
            return l.min(try sample(p, mut ctx, right, bx, by, bz))
        },
        Max { left, right, bound } => {
            let l = try sample(p, mut ctx, left, bx, by, bz)
            if l >= bound {
                return l
            }
            return l.max(try sample(p, mut ctx, right, bx, by, bz))
        },
        Const { op, input, value: c } => {
            let v = try sample(p, mut ctx, input, bx, by, bz)
            return match op {
                Add => v + c,
                Sub => c - v,
                Mul => v * c,
                Div => c / v,
                Min => v.min(c),
                Max => v.max(c),
            }
        },
        ConstBasePow { base, exponent } => return java_pow(base, f64(try sample(p, mut ctx, exponent, bx, by, bz))),
        ConstExponentPow { base, exponent } => return java_pow(f64(try sample(p, mut ctx, base, bx, by, bz)), exponent),
        Pow { base, exponent } => {
            let b = try sample(p, mut ctx, base, bx, by, bz)
            return java_pow(f64(b), f64(try sample(p, mut ctx, exponent, bx, by, bz)))
        },
        RoundInteger { op, input } => return round_to_integer(op, try sample(p, mut ctx, input, bx, by, bz)),
        Round { op, input, multiple } => {
            let v = try sample(p, mut ctx, input, bx, by, bz)
            return round_multiple(op, v, try sample(p, mut ctx, multiple, bx, by, bz))
        },
        Lerp { alpha, first, second } => {
            let a = try sample(p, mut ctx, alpha, bx, by, bz)
            if a == 0.0f32 {
                return try sample(p, mut ctx, first, bx, by, bz)
            }
            if a == 1.0f32 {
                return try sample(p, mut ctx, second, bx, by, bz)
            }
            let f = try sample(p, mut ctx, first, bx, by, bz)
            return lerp(a, f, try sample(p, mut ctx, second, bx, by, bz))
        },
        LerpConstFirst { alpha, first, second } => {
            let a = try sample(p, mut ctx, alpha, bx, by, bz)
            if a == 0.0f32 {
                return first
            }
            if a == 1.0f32 {
                return try sample(p, mut ctx, second, bx, by, bz)
            }
            return lerp(a, first, try sample(p, mut ctx, second, bx, by, bz))
        },
        LerpConstSecond { alpha, first, second } => {
            let a = try sample(p, mut ctx, alpha, bx, by, bz)
            if a == 0.0f32 {
                return try sample(p, mut ctx, first, bx, by, bz)
            }
            if a == 1.0f32 {
                return second
            }
            return lerp(a, try sample(p, mut ctx, first, bx, by, bz), second)
        },
        Clamp { input, low, high } => return clamp(try sample(p, mut ctx, input, bx, by, bz), low, high),
        ChoiceConst { input, low, high, inside, outside } => {
            let v = try sample(p, mut ctx, input, bx, by, bz)
            return if v >= low and v < high { inside } else { outside }
        },
        Choice { input, low, high, inside, outside } => {
            let v = try sample(p, mut ctx, input, bx, by, bz)
            if v >= low and v < high {
                return try sample(p, mut ctx, inside, bx, by, bz)
            }
            return try sample(p, mut ctx, outside, bx, by, bz)
        },
        SelectOne { input, threshold, below, above } => {
            let v = try sample(p, mut ctx, input, bx, by, bz)
            if v < threshold {
                return try sample(p, mut ctx, below, bx, by, bz)
            }
            return try sample(p, mut ctx, above, bx, by, bz)
        },
        Select { input, thresholds, functions } => {
            let v = try sample(p, mut ctx, input, bx, by, bz)
            return try sample(p, mut ctx, select(v, p.floats[thresholds], p.lists[functions]), bx, by, bz)
        },
        Spline { curve: c, count } => {
            var input = SplineInput {
                point: true,
                x: bx,
                y: by,
                z: bz,
                values: [f32.NAN; count],
                filled: [],
                buffers: [],
                volume: Volume { size_x: 0, size_y: 0, size_z: 0, min_x: 0, min_y: 0, min_z: 0 },
                index: 0,
            }
            return try curve(p, mut ctx, mut input, c)
        },
        Caching { id, input } => {
            if not ctx.cached {
                return try sample(p, mut ctx, input, bx, by, bz)
            }
            ctx.cell(id)
            let key = block_key(bx, by, bz)
            let held = ctx.cells[id].value
            if ctx.cells[id].key == key and not held.is_nan() {
                return held
            }
            if ctx.cells[id].filled {
                let i = ctx.cells[id].volume.index_of_block(bx, by, bz)
                if i != -1 {
                    return ctx.cells[id].buffer[at(i)]
                }
            }
            let v = try sample(p, mut ctx, input, bx, by, bz)
            ctx.cells[id].key = key
            ctx.cells[id].value = v
            return v
        },
        Interpolated { input, xz, ys, xz_inv: _, y_inv: _ } => {
            let xi = bx.floor_mod(xz)
            let yi = by.floor_mod(ys)
            let zi = bz.floor_mod(xz)
            if xi == 0 and yi == 0 and zi == 0 {
                return try sample(p, mut ctx, input, bx, by, bz)
            }
            let v = try volume(2, 2, 2, bx - xi, by - yi, bz - zi, xz, ys, xz)
            var buf = try zeros(v.size())
            try fill(p, mut ctx, input, mut buf, v)
            let a1 = f32.nearest(xi) / f32.nearest(xz)
            let a2 = f32.nearest(yi) / f32.nearest(ys)
            let a3 = f32.nearest(zi) / f32.nearest(xz)
            let x00 = lerp(a1, buf[at(v.index(0, 0, 0))], buf[at(v.index(1, 0, 0))])
            let x10 = lerp(a1, buf[at(v.index(0, 1, 0))], buf[at(v.index(1, 1, 0))])
            let x01 = lerp(a1, buf[at(v.index(0, 0, 1))], buf[at(v.index(1, 0, 1))])
            let x11 = lerp(a1, buf[at(v.index(0, 1, 1))], buf[at(v.index(1, 1, 1))])
            return lerp(a3, lerp(a2, x00, x10), lerp(a2, x01, x11))
        },
        SliceX { input, at: c } => return try sample(p, mut ctx, input, c, by, bz),
        SliceY { input, at: c } => return try sample(p, mut ctx, input, bx, c, bz),
        SliceZ { input, at: c } => return try sample(p, mut ctx, input, bx, by, c),
        SliceXz { input, x_at, z_at } => return try sample(p, mut ctx, input, x_at, by, z_at),
        FindTop { density, upper, lower, cell } => {
            let u = try sample(p, mut ctx, upper, bx, by, bz)
            return try find_top(p, mut ctx, density, lower, cell, bx, bz, u)
        },
    }
}

/// `FindTopSurfaceFunction`'s search: from the cell at or below `upper` down to `lower`, the
/// first block where the density is above 0.
fn find_top(p: Program, ctx: mut Context, density: usize, lower: i32, cell: i32, x: i32, z: i32, upper: f32) -> f32 ! Thrown {
    let top = i32.saturate(f64(upper / f32.nearest(cell)).floor()) * cell
    if top <= lower {
        return f32.nearest(lower)
    }
    var y = top
    while y >= lower {
        if try sample(p, mut ctx, density, x, y, z) > 0.0f32 {
            return f32.nearest(y)
        }
        y -= cell
    }
    return f32.nearest(lower)
}

/// `sampleVolume`: sampler `s` over `v`, into `out`, which holds `v.size()` values.
pub fn fill(p: Program, ctx: mut Context, s: usize, out: mut List<f32>, v: Volume) ! Thrown {
    match p.samplers[s] {
        Constant(c) => {
            for i in 0..out.len() {
                out[i] = c
            }
        },
        Beard => {
            if let b = ctx.beard {
                b.fill(mut out, v)
            } else {
                for i in 0..out.len() {
                    out[i] = 0.0f32
                }
            }
        },
        Noise { noise, xz, ys } => {
            for i in 0..out.len() {
                out[i] = 0.0f32
            }
            p.noises[noise].add_to_volume(mut out, v, xz, ys, 1.0f32)
        },
        ShiftedXz { sx, sz, noise, xz, ys } => {
            try fill(p, mut ctx, sx, mut out, v)
            var zs = try zeros(v.size())
            try fill(p, mut ctx, sz, mut zs, v)
            var i: usize = 0
            for z in 0..v.size_z {
                let base_z = f64(v.block_z(z)) * xz
                for x in 0..v.size_x {
                    let base_x = f64(v.block_x(x)) * xz
                    for y in 0..v.size_y {
                        let nx = base_x + f64(out[i])
                        let ny = f64(v.block_y(y)) * ys
                        let nz = base_z + f64(zs[i])
                        out[i] = p.noises[noise].get(nx, ny, nz)
                        i += 1
                    }
                }
            }
        },
        ShiftedXyz { sx, sy, sz, noise, xz, ys } => {
            try fill(p, mut ctx, sx, mut out, v)
            var yb = try zeros(v.size())
            try fill(p, mut ctx, sy, mut yb, v)
            var zs = try zeros(v.size())
            try fill(p, mut ctx, sz, mut zs, v)
            var i: usize = 0
            for z in 0..v.size_z {
                let base_z = f64(v.block_z(z)) * xz
                for x in 0..v.size_x {
                    let base_x = f64(v.block_x(x)) * xz
                    for y in 0..v.size_y {
                        let nx = base_x + f64(out[i])
                        let ny = f64(v.block_y(y)) * ys + f64(yb[i])
                        let nz = base_z + f64(zs[i])
                        out[i] = p.noises[noise].get(nx, ny, nz)
                        i += 1
                    }
                }
            }
        },
        ShiftB { noise } => {
            // The noise is sampled at (z, x), so over a volume with x and z swapped.
            let tv = try volume(v.size_z, v.size_x, 1, v.min_z, v.min_x, 0, v.step_z, v.step_x, 1)
            var buf = try zeros(tv.size())
            p.noises[noise].add_to_volume(mut buf, tv, 0.25, 0.25, 4.0f32)
            for z in 0..v.size_z {
                for x in 0..v.size_x {
                    let value = buf[at(tv.index(z, x, 0))]
                    set_range(mut out, v.index(x, 0, z), v.size_y, value)
                }
            }
        },
        EndIslands { noise } => {
            for z in 0..v.size_z {
                let bz = v.block_z(z)
                for x in 0..v.size_x {
                    let bx = v.block_x(x)
                    set_range(mut out, v.index(x, 0, z), v.size_y, island_value(p.noises[noise], bx, bz))
                }
            }
        },
        Distance { px, py, pz, metric: m } => {
            var i: usize = 0
            for z in 0..v.size_z {
                let bz = v.block_z(z)
                for x in 0..v.size_x {
                    let bx = v.block_x(x)
                    for y in 0..v.size_y {
                        let by = v.block_y(y)
                        out[i] = metric(m, f32.nearest(px - bx), f32.nearest(py - by), f32.nearest(pz - bz))
                        i += 1
                    }
                }
            }
        },
        Gradient { axis, tiling, from, low, high, span, from_value, factor } => {
            match axis {
                X => {
                    for x in 0..v.size_x {
                        let g = try gradient(tiling, v.block_x(x), from, low, high, span, from_value, factor)
                        for z in 0..v.size_z {
                            set_range(mut out, v.index(x, 0, z), v.size_y, g)
                        }
                    }
                },
                Y => {
                    for y in 0..v.size_y {
                        let g = try gradient(tiling, v.block_y(y), from, low, high, span, from_value, factor)
                        for z in 0..v.size_z {
                            for x in 0..v.size_x {
                                out[at(v.index(x, y, z))] = g
                            }
                        }
                    }
                },
                Z => {
                    for z in 0..v.size_z {
                        let g = try gradient(tiling, v.block_z(z), from, low, high, span, from_value, factor)
                        set_range(mut out, v.index(0, 0, z), v.size_x * v.size_y, g)
                    }
                },
            }
        },
        Unary { op, input } => {
            try fill(p, mut ctx, input, mut out, v)
            unary_all(op, mut out)
        },
        Add { left, right } => {
            try fill(p, mut ctx, left, mut out, v)
            let r = try sampled(p, mut ctx, right, v)
            add_all(mut out, r)
        },
        Sub { left, right } => {
            try fill(p, mut ctx, left, mut out, v)
            let r = try sampled(p, mut ctx, right, v)
            sub_all(mut out, r)
        },
        Mul { left, right } => {
            try fill(p, mut ctx, left, mut out, v)
            let r = try sampled(p, mut ctx, right, v)
            mul_all(mut out, r)
        },
        Div { left, right } => {
            try fill(p, mut ctx, left, mut out, v)
            let r = try sampled(p, mut ctx, right, v)
            div_all(mut out, r)
        },
        Min { left, right, bound: _ } => {
            try fill(p, mut ctx, left, mut out, v)
            let r = try sampled(p, mut ctx, right, v)
            min_all(mut out, r)
        },
        Max { left, right, bound: _ } => {
            try fill(p, mut ctx, left, mut out, v)
            let r = try sampled(p, mut ctx, right, v)
            max_all(mut out, r)
        },
        Const { op, input, value: c } => {
            try fill(p, mut ctx, input, mut out, v)
            match op {
                Add => {
                    for i in 0..out.len() {
                        out[i] = out[i] + c
                    }
                },
                Sub => {
                    for i in 0..out.len() {
                        out[i] = c - out[i]
                    }
                },
                Mul => {
                    for i in 0..out.len() {
                        out[i] = out[i] * c
                    }
                },
                Div => {
                    for i in 0..out.len() {
                        out[i] = c / out[i]
                    }
                },
                Min => {
                    for i in 0..out.len() {
                        let a = out[i]
                        out[i] = if c < a { c } else { a }
                    }
                },
                Max => {
                    for i in 0..out.len() {
                        let a = out[i]
                        out[i] = if c > a { c } else { a }
                    }
                },
            }
        },
        ConstBasePow { base, exponent } => {
            try fill(p, mut ctx, exponent, mut out, v)
            for i in 0..out.len() {
                out[i] = java_pow(base, f64(out[i]))
            }
        },
        ConstExponentPow { base, exponent } => {
            try fill(p, mut ctx, base, mut out, v)
            for i in 0..out.len() {
                out[i] = java_pow(f64(out[i]), exponent)
            }
        },
        Pow { base, exponent } => {
            try fill(p, mut ctx, base, mut out, v)
            let e = try sampled(p, mut ctx, exponent, v)
            for i in 0..out.len() {
                out[i] = java_pow(f64(out[i]), f64(e[i]))
            }
        },
        RoundInteger { op, input } => {
            try fill(p, mut ctx, input, mut out, v)
            for i in 0..out.len() {
                out[i] = round_to_integer(op, out[i])
            }
        },
        Round { op, input, multiple } => {
            try fill(p, mut ctx, input, mut out, v)
            let m = try sampled(p, mut ctx, multiple, v)
            for i in 0..out.len() {
                out[i] = round_multiple(op, out[i], m[i])
            }
        },
        Lerp { alpha, first, second } => {
            if v.size_y >= 16 and by_y_only(p, alpha) {
                try lerp_by_y(p, mut ctx, alpha, some(first), 0.0f32, some(second), 0.0f32, mut out, v)
                return
            }
            try fill(p, mut ctx, alpha, mut out, v)
            // The first side is read where the alpha isn't 1, the second where it isn't 0.
            let f = try sampled_unless(p, mut ctx, first, v, out, 1.0f32)
            let s2 = try sampled_unless(p, mut ctx, second, v, out, 0.0f32)
            same_length(out.len(), f.len())
            same_length(out.len(), s2.len())
            for i in 0..out.len().min(f.len()).min(s2.len()) {
                let a = out[i]
                out[i] = if a == 0.0f32 { f[i] } else if a == 1.0f32 { s2[i] } else { lerp(a, f[i], s2[i]) }
            }
        },
        LerpConstFirst { alpha, first, second } => {
            if v.size_y >= 16 and by_y_only(p, alpha) {
                try lerp_by_y(p, mut ctx, alpha, none, first, some(second), 0.0f32, mut out, v)
                return
            }
            try fill(p, mut ctx, alpha, mut out, v)
            let s2 = try sampled(p, mut ctx, second, v)
            same_length(out.len(), s2.len())
            for i in 0..out.len().min(s2.len()) {
                let a = out[i]
                out[i] = if a == 0.0f32 { first } else if a == 1.0f32 { s2[i] } else { lerp(a, first, s2[i]) }
            }
        },
        LerpConstSecond { alpha, first, second } => {
            if v.size_y >= 16 and by_y_only(p, alpha) {
                try lerp_by_y(p, mut ctx, alpha, some(first), 0.0f32, none, second, mut out, v)
                return
            }
            try fill(p, mut ctx, alpha, mut out, v)
            let f = try sampled(p, mut ctx, first, v)
            same_length(out.len(), f.len())
            for i in 0..out.len().min(f.len()) {
                let a = out[i]
                out[i] = if a == 0.0f32 { f[i] } else if a == 1.0f32 { second } else { lerp(a, f[i], second) }
            }
        },
        Clamp { input, low, high } => {
            try fill(p, mut ctx, input, mut out, v)
            for i in 0..out.len() {
                out[i] = clamp(out[i], low, high)
            }
        },
        ChoiceConst { input, low, high, inside, outside } => {
            try fill(p, mut ctx, input, mut out, v)
            for i in 0..out.len() {
                let x = out[i]
                out[i] = if x >= low and x < high { inside } else { outside }
            }
        },
        Choice { input, low, high, inside, outside } => {
            if v.size_y >= 16 and by_y_only(p, input) {
                try choose_by_y(p, mut ctx, input, low, high, inside, outside, mut out, v)
                return
            }
            if v.size_y >= 16 {
                try choose_by_cells(p, mut ctx, input, low, high, inside, outside, mut out, v)
                return
            }
            try fill(p, mut ctx, inside, mut out, v)
            let ins = try sampled(p, mut ctx, input, v)
            let outs = try sampled(p, mut ctx, outside, v)
            same_length(out.len(), ins.len())
            same_length(out.len(), outs.len())
            for i in 0..out.len().min(ins.len()).min(outs.len()) {
                let x = ins[i]
                let a = out[i]
                let b = outs[i]
                out[i] = if x >= low and x < high { a } else { b }
            }
        },
        SelectOne { input, threshold, below, above } => {
            try fill(p, mut ctx, input, mut out, v)
            let lo = try sampled(p, mut ctx, below, v)
            let hi = try sampled(p, mut ctx, above, v)
            same_length(out.len(), lo.len())
            same_length(out.len(), hi.len())
            for i in 0..out.len().min(lo.len()).min(hi.len()) {
                out[i] = if out[i] < threshold { lo[i] } else { hi[i] }
            }
        },
        Select { input, thresholds, functions } => {
            try fill(p, mut ctx, input, mut out, v)
            var bufs = List<List<f32>>()
            for f in p.lists[functions] {
                bufs.push(try sampled(p, mut ctx, f, v))
            }
            var order = List<usize>()
            for k in 0..p.lists[functions].len() {
                order.push(k)
            }
            for i in 0..out.len() {
                out[i] = bufs[select(out[i], p.floats[thresholds], order)][i]
            }
        },
        Spline { curve: c, count } => {
            var input = SplineInput {
                point: false,
                x: 0,
                y: 0,
                z: 0,
                values: [],
                filled: [false; count],
                buffers: [],
                volume: v,
                index: 0,
            }
            for _ in 0..count {
                input.buffers.push([])
            }
            // A point's value is what the coordinates its way through the spline read give, so a
            // point where those coordinates are the same, to the bit, goes the same way to the
            // same value, and it's copied: from the point at its height in the column before,
            // as where the spline reads only the height, or from the point below it, as where
            // it reads only what's of the column. `reads` is what each height's last value
            // read, and `below` what the point below's did (D302).
            let ny = usize.wrap(v.size_y)
            var reads: List<u64> = [0; ny]
            var below: u64 = 0
            for i in 0..out.len() {
                let y = i % ny
                if not input.wide {
                    if i >= ny and reads[y] != 0 and same_reads(input, reads[y], i - ny, i) {
                        out[i] = out[i - ny]
                        below = reads[y]
                        continue
                    }
                    if y > 0 and below != 0 and same_reads(input, below, i - 1, i) {
                        out[i] = out[i - 1]
                        reads[y] = below
                        continue
                    }
                }
                input.index = i
                input.reads = 0
                out[i] = try curve(p, mut ctx, mut input, c)
                reads[y] = input.reads
                below = input.reads
            }
        },
        Caching { id, input } => {
            if not ctx.cached {
                try fill(p, mut ctx, input, mut out, v)
                return
            }
            ctx.cell(id)
            if ctx.cells[id].filled and ctx.cells[id].volume != v {
                // A part of the volume it holds, starting where a cell does, is each value as
                // filling the part would give it, so it's copied out.
                let cv = ctx.cells[id].volume
                if covers(cv, v) and (v.min_y == cv.min_y or v.min_y.floor_mod(cell_height(p)) == 0) {
                    let ox = (v.min_x - cv.min_x) / cv.step_x
                    let oy = (v.min_y - cv.min_y) / cv.step_y
                    let oz = (v.min_z - cv.min_z) / cv.step_z
                    var i: usize = 0
                    for z in 0..v.size_z {
                        for x in 0..v.size_x {
                            var j = at(cv.index(x + ox, oy, z + oz))
                            for _ in 0..v.size_y {
                                out[i] = ctx.cells[id].buffer[j]
                                i += 1
                                j += 1
                            }
                        }
                    }
                    return
                }
            }
            if not ctx.cells[id].filled or ctx.cells[id].volume != v {
                ctx.cells[id].volume = v
                var buf = try zeros(v.size())
                try fill(p, mut ctx, input, mut buf, v)
                ctx.cells[id].buffer = buf
                ctx.cells[id].filled = true
            }
            let n = ctx.cells[id].buffer.len()
            if n != out.len() {
                fail illegal_argument("Cannot copy from buffer with size={n}, expected{out.len()}")
            }
            for i in 0..n {
                out[i] = ctx.cells[id].buffer[i]
            }
        },
        Interpolated { input, xz, ys, xz_inv, y_inv } => {
            let steps = (v.step_x == xz or v.size_x == 1) and (v.step_y == ys or v.size_y == 1) and (v.step_z == xz or v.size_z == 1)
            if steps and v.min_x.floor_mod(xz) == 0 and v.min_y.floor_mod(ys) == 0 and v.min_z.floor_mod(xz) == 0 {
                try fill(p, mut ctx, input, mut out, v)
            } else if v.step_x == 1 and v.step_y == 1 and v.step_z == 1 {
                try interpolate(p, mut ctx, s, input, xz, ys, xz_inv, y_inv, mut out, v)
            } else {
                let bv = try volume(v.size_x * v.step_x, v.size_y * v.step_y, v.size_z * v.step_z, v.min_x, v.min_y, v.min_z, 1, 1, 1)
                var buf = try zeros(bv.size())
                try interpolate(p, mut ctx, s, input, xz, ys, xz_inv, y_inv, mut buf, bv)
                for z in 0..v.size_z {
                    for x in 0..v.size_x {
                        for y in 0..v.size_y {
                            out[at(v.index(x, y, z))] = buf[at(bv.index(x * v.step_x, y * v.step_y, z * v.step_z))]
                        }
                    }
                }
            }
        },
        SliceX { input, at: c } => {
            if v.size_x == 1 and v.min_x == c {
                try fill(p, mut ctx, input, mut out, v)
                return
            }
            let iv = try volume(1, v.size_y, v.size_z, c, v.min_y, v.min_z, v.step_x, v.step_y, v.step_z)
            let buf = try sampled(p, mut ctx, input, iv)
            var i: usize = 0
            for z in 0..v.size_z {
                for _ in 0..v.size_x {
                    for y in 0..v.size_y {
                        out[i] = buf[at(iv.index(0, y, z))]
                        i += 1
                    }
                }
            }
        },
        SliceY { input, at: c } => {
            if v.size_y == 1 and v.min_y == c {
                try fill(p, mut ctx, input, mut out, v)
                return
            }
            let iv = try volume(v.size_x, 1, v.size_z, v.min_x, c, v.min_z, v.step_x, v.step_y, v.step_z)
            let buf = try sampled(p, mut ctx, input, iv)
            for z in 0..v.size_z {
                for x in 0..v.size_x {
                    set_range(mut out, v.index(x, 0, z), v.size_y, buf[at(iv.index(x, 0, z))])
                }
            }
        },
        SliceZ { input, at: c } => {
            if v.size_z == 1 and v.min_z == c {
                try fill(p, mut ctx, input, mut out, v)
                return
            }
            let iv = try volume(v.size_x, v.size_y, 1, v.min_x, v.min_y, c, v.step_x, v.step_y, v.step_z)
            let buf = try sampled(p, mut ctx, input, iv)
            var i: usize = 0
            for _ in 0..v.size_z {
                for x in 0..v.size_x {
                    for y in 0..v.size_y {
                        out[i] = buf[at(iv.index(x, y, 0))]
                        i += 1
                    }
                }
            }
        },
        SliceXz { input, x_at, z_at } => {
            if v.size_x == 1 and v.size_z == 1 and v.min_x == x_at and v.min_z == z_at {
                try fill(p, mut ctx, input, mut out, v)
                return
            }
            let iv = try volume(1, v.size_y, 1, x_at, v.min_y, z_at, v.step_x, v.step_y, v.step_z)
            let buf = try sampled(p, mut ctx, input, iv)
            for y in 0..v.size_y {
                let value = buf[at(iv.index(0, y, 0))]
                var i = v.index(0, y, 0)
                for _ in 0..v.size_z {
                    for _ in 0..v.size_x {
                        out[at(i)] = value
                        i += v.size_y
                    }
                }
            }
        },
        FindTop { density, upper, lower, cell } => {
            if v.size_y != 1 {
                fail illegal_argument("Cannot sample with sizeY={v.size_y}")
            }
            try fill(p, mut ctx, upper, mut out, v)
            var i: usize = 0
            for z in 0..v.size_z {
                let bz = v.block_z(z)
                for x in 0..v.size_x {
                    let bx = v.block_x(x)
                    out[i] = try find_top(p, mut ctx, density, lower, cell, bx, bz, out[i])
                    i += 1
                }
            }
        },
    }
}

/// Whether the sampler or any it reads, through its curves too, is the `beardifier` marker, so
/// its value at a block depends on the chunk's structures, not on the block alone.
pub fn reads_beardifier(p: Program, s: usize) -> bool {
    var seen: List<bool> = [false; p.samplers.len()]
    var seen_curves: List<bool> = [false; p.curves.len()]
    var samplers: List<usize> = [s]
    var curves: List<usize> = []
    while not samplers.is_empty() or not curves.is_empty() {
        if let c = curves.pop() {
            if seen_curves[c] {
                continue
            }
            seen_curves[c] = true
            match p.curves[c] {
                Curve.Constant(_) => {},
                Curve.Points { coordinate: _, sampler, locations: _, derivatives: _, values, constants: _ } => {
                    samplers.push(sampler)
                    for v in p.lists[values] {
                        curves.push(v)
                    }
                },
            }
            continue
        }
        let next = samplers.pop() else break
        if seen[next] {
            continue
        }
        seen[next] = true
        match p.samplers[next] {
            Beard => return true,
            Constant(_) => {},
            Noise { .. } => {},
            ShiftB { .. } => {},
            EndIslands { .. } => {},
            Distance { .. } => {},
            Gradient { .. } => {},
            ShiftedXz { sx, sz, .. } => {
                samplers.push(sx)
                samplers.push(sz)
            },
            ShiftedXyz { sx, sy, sz, .. } => {
                samplers.push(sx)
                samplers.push(sy)
                samplers.push(sz)
            },
            Unary { input, .. } => samplers.push(input),
            Add { left, right } => {
                samplers.push(left)
                samplers.push(right)
            },
            Sub { left, right } => {
                samplers.push(left)
                samplers.push(right)
            },
            Mul { left, right } => {
                samplers.push(left)
                samplers.push(right)
            },
            Div { left, right } => {
                samplers.push(left)
                samplers.push(right)
            },
            Min { left, right, .. } => {
                samplers.push(left)
                samplers.push(right)
            },
            Max { left, right, .. } => {
                samplers.push(left)
                samplers.push(right)
            },
            Const { input, .. } => samplers.push(input),
            ConstBasePow { exponent, .. } => samplers.push(exponent),
            ConstExponentPow { base, .. } => samplers.push(base),
            Pow { base, exponent } => {
                samplers.push(base)
                samplers.push(exponent)
            },
            RoundInteger { input, .. } => samplers.push(input),
            Round { input, multiple, .. } => {
                samplers.push(input)
                samplers.push(multiple)
            },
            Lerp { alpha, first, second } => {
                samplers.push(alpha)
                samplers.push(first)
                samplers.push(second)
            },
            LerpConstFirst { alpha, second, .. } => {
                samplers.push(alpha)
                samplers.push(second)
            },
            LerpConstSecond { alpha, first, .. } => {
                samplers.push(alpha)
                samplers.push(first)
            },
            Clamp { input, .. } => samplers.push(input),
            ChoiceConst { input, .. } => samplers.push(input),
            Choice { input, inside, outside, .. } => {
                samplers.push(input)
                samplers.push(inside)
                samplers.push(outside)
            },
            SelectOne { input, below, above, .. } => {
                samplers.push(input)
                samplers.push(below)
                samplers.push(above)
            },
            Select { input, functions, .. } => {
                samplers.push(input)
                for f in p.lists[functions] {
                    samplers.push(f)
                }
            },
            Spline { curve: c, .. } => curves.push(c),
            Caching { input, .. } => samplers.push(input),
            Interpolated { input, .. } => samplers.push(input),
            SliceX { input, .. } => samplers.push(input),
            SliceY { input, .. } => samplers.push(input),
            SliceZ { input, .. } => samplers.push(input),
            SliceXz { input, .. } => samplers.push(input),
            FindTop { density, upper, .. } => {
                samplers.push(density)
                samplers.push(upper)
            },
        }
    }
    return false
}

// Whether the sampler's value is of the block's height alone.
fn by_y_only(p: Program, s: usize) -> bool {
    return match p.samplers[s] {
        Gradient { axis, .. } => match axis {
            Y => true,
            _ => false,
        },
        _ => false,
    }
}

// The height every interpolated sampler's cells start at a multiple of: their heights' least
// common multiple.
fn cell_height(p: Program) -> i32 {
    var out = 1
    for s in p.samplers {
        match s {
            Interpolated { ys, .. } => {
                var a = out
                var b = ys
                while b != 0 {
                    let t = a % b
                    a = b
                    b = t
                }
                out = out / a * ys
            },
            _ => {},
        }
    }
    return out
}

/// A range choice on the height alone over `v`: each layer of `v` in the range takes `inside`,
/// the rest `outside`, as the full choice gives them, with each side filled only over the layers
/// it's taken at. Each side's part starts at a layer an interpolated sampler's cells start at, or
/// at the bottom of `v`, so every point of it is worked out as filling `v` whole would.
fn choose_by_y(p: Program, ctx: mut Context, input: usize, low: f32, high: f32, inside: usize, outside: usize, out: mut List<f32>, v: Volume) ! Thrown {
    let layers = try volume(1, v.size_y, 1, v.min_x, v.min_y, v.min_z, v.step_x, v.step_y, v.step_z)
    let g = try sampled(p, mut ctx, input, layers)
    let ny = v.size_y
    var first = -1
    var last = -1
    for y in 0..ny {
        let x = g[at(y)]
        if x >= low and x < high {
            if first == -1 {
                first = y
            }
            last = y
        }
    }
    if first == -1 {
        try fill(p, mut ctx, outside, mut out, v)
        return
    }
    if first == 0 and last == ny - 1 {
        try fill(p, mut ctx, inside, mut out, v)
        return
    }
    // A gradient's in-range layers are one run; any others are filled whole.
    for y in first..last + 1 {
        let x = g[at(y)]
        if not (x >= low and x < high) {
            try fill(p, mut ctx, inside, mut out, v)
            let outs = try sampled(p, mut ctx, outside, v)
            for i in 0..out.len() {
                let yi = i32.wrap(i % usize.wrap(ny))
                let gy = g[at(yi)]
                if not (gy >= low and gy < high) {
                    out[i] = outs[i]
                }
            }
            return
        }
    }
    let cell = cell_height(p)
    // `inside` over the layers from the start of the cell the first is in to the end of the last.
    let in_low = aligned_down(v, cell, first)
    let in_high = aligned_up(v, cell, last + 1)
    try fill_layers(p, mut ctx, inside, mut out, v, in_low, in_high, first, last + 1)
    // `outside` below the first and above the last.
    if first > 0 {
        try fill_layers(p, mut ctx, outside, mut out, v, 0, aligned_up(v, cell, first), 0, first)
    }
    if last + 1 < ny {
        try fill_layers(p, mut ctx, outside, mut out, v, aligned_down(v, cell, last + 1), ny, last + 1, ny)
    }
}

/// A range choice over `v`: the input first, then each side filled only over the runs of cells'
/// layers it's taken at somewhere in, and taken where it is. A run starts where a cell does, as
/// in `choose_by_y`.
fn choose_by_cells(p: Program, ctx: mut Context, input: usize, low: f32, high: f32, inside: usize, outside: usize, out: mut List<f32>, v: Volume) ! Thrown {
    let ins = try sampled(p, mut ctx, input, v)
    let ny = usize.wrap(v.size_y)
    same_length(out.len(), ins.len())
    // Whether each layer has a point inside the range, and one outside it.
    var has_in: List<u8> = [0u8; ny]
    var has_out: List<u8> = [0u8; ny]
    let columns = ins.len() / ny
    for c in 0..columns {
        let base = c * ny
        for y in 0..ny.min(has_in.len()).min(has_out.len()) {
            let a = ins[base + y]
            let inside_here: u8 = if a >= low and a < high { 1 } else { 0 }
            has_in[y] = has_in[y] | inside_here
            has_out[y] = has_out[y] | (1u8 - inside_here)
        }
    }
    let cell = cell_height(p)
    try fill_runs(p, mut ctx, inside, mut out, v, has_in, cell)
    var outs = try zeros(v.size())
    try fill_runs(p, mut ctx, outside, mut outs, v, has_out, cell)
    let n = out.len().min(ins.len()).min(outs.len())
    for i in 0..n {
        let a = ins[i]
        let kept = out[i]
        let other = outs[i]
        out[i] = if a >= low and a < high { kept } else { other }
    }
}

// Copies `n` values from `src` at `from` to `dst` at `to`.
fn copy_run(dst: mut List<f32>, to: usize, src: List<f32>, from: usize, n: usize) {
    if to + n > dst.len() or from + n > src.len() {
        panic("a run of {n} from {from} of {src.len()} to {to} of {dst.len()}")
    }
    unsafe {
        let d = dst.as_mut_ptr().add(to)
        let s = src.as_ptr().add(from)
        for k in 0..n {
            d.add(k).write(s.add(k).read())
        }
    }
}

// The side `s` of a range choice over each run of whole cells' layers with a layer in `wanted`,
// put in `out` over those layers.
fn fill_runs(p: Program, ctx: mut Context, s: usize, out: mut List<f32>, v: Volume, wanted: List<u8>, cell: i32) ! Thrown {
    let ny = v.size_y
    var y = 0
    while y < ny {
        if wanted[at(y)] == 0 {
            y += 1
            continue
        }
        // The run: from the start of this layer's cell to the end of the last cell with a
        // wanted layer after it, cell by cell.
        let from = aligned_down(v, cell, y)
        var to = aligned_up(v, cell, y + 1)
        while to < ny {
            let next = aligned_up(v, cell, to + 1)
            var any = false
            for k in to..next {
                if wanted[at(k)] != 0 {
                    any = true
                }
            }
            if not any {
                break
            }
            to = next
        }
        let part = try volume(v.size_x, to - from, v.size_z, v.min_x, v.min_y + from * v.step_y, v.min_z, v.step_x, v.step_y, v.step_z)
        let buf = try sampled(p, mut ctx, s, part)
        for z in 0..v.size_z {
            for x in 0..v.size_x {
                copy_run(mut out, at(v.index(x, from, z)), buf, at(part.index(x, 0, z)), at(to - from))
            }
        }
        y = to
    }
}

// A side of a lerp filled over some of a volume's layers: from the layer `from`, over `part`.
struct Side {
    from: i32
    part: Volume
    values: List<f32>
}

impl Side {
    fn at(self, x: i32, y: i32, z: i32) -> f32 {
        return self.values[at(self.part.index(x, y - self.from, z))]
    }
}

// The side `s` over the layers of `v` from `first` to `last` widened to whole cells, or over all
// of `v` if `whole`; none where `first` is -1, as no layer takes it.
fn side_over(p: Program, ctx: mut Context, s: usize, v: Volume, first: i32, last: i32, whole: bool, cell: i32) -> Side? ! Thrown {
    if first == -1 {
        return none
    }
    let from = if whole { 0 } else { aligned_down(v, cell, first) }
    let to = if whole { v.size_y } else { aligned_up(v, cell, last + 1) }
    let part = try volume(v.size_x, to - from, v.size_z, v.min_x, v.min_y + from * v.step_y, v.min_z, v.step_x, v.step_y, v.step_z)
    return some(Side { from: from, part: part, values: try sampled(p, mut ctx, s, part) })
}

/// A lerp whose alpha is of the height alone over `v`, `Mth.lerp` as its sampler gives it at each
/// point, with the first side, a sampler or `first_value`, filled only over the layers whose alpha
/// isn't 1, and the second only over those whose alpha isn't 0. Each part starts where a cell
/// does, as in `choose_by_y`.
fn lerp_by_y(p: Program, ctx: mut Context, alpha: usize, first: usize?, first_value: f32, second: usize?, second_value: f32, out: mut List<f32>, v: Volume) ! Thrown {
    let layers = try volume(1, v.size_y, 1, v.min_x, v.min_y, v.min_z, v.step_x, v.step_y, v.step_z)
    let g = try sampled(p, mut ctx, alpha, layers)
    let ny = v.size_y
    // The layers each side is taken at, and whether they're one run.
    var f_first = -1
    var f_last = -1
    var s_first = -1
    var s_last = -1
    for y in 0..ny {
        let a = g[at(y)]
        if a != 1.0f32 {
            if f_first == -1 {
                f_first = y
            }
            f_last = y
        }
        if a != 0.0f32 {
            if s_first == -1 {
                s_first = y
            }
            s_last = y
        }
    }
    var f_whole = false
    var s_whole = false
    if f_first != -1 {
        for y in f_first..f_last + 1 {
            if g[at(y)] == 1.0f32 {
                f_whole = true
            }
        }
    }
    if s_first != -1 {
        for y in s_first..s_last + 1 {
            if g[at(y)] == 0.0f32 {
                s_whole = true
            }
        }
    }
    let cell = cell_height(p)
    var fs: Side? = none
    if let f = first {
        fs = try side_over(p, mut ctx, f, v, f_first, f_last, f_whole, cell)
    }
    var ss: Side? = none
    if let s = second {
        ss = try side_over(p, mut ctx, s, v, s_first, s_last, s_whole, cell)
    }
    var i: usize = 0
    for z in 0..v.size_z {
        for x in 0..v.size_x {
            for y in 0..ny {
                let a = g[at(y)]
                var value: f32 = 0.0
                if a == 0.0f32 {
                    value = if let f = fs { f.at(x, y, z) } else { first_value }
                } else if a == 1.0f32 {
                    value = if let s = ss { s.at(x, y, z) } else { second_value }
                } else {
                    let fv = if let f = fs { f.at(x, y, z) } else { first_value }
                    let sv = if let s = ss { s.at(x, y, z) } else { second_value }
                    value = lerp(a, fv, sv)
                }
                out[i] = value
                i += 1
            }
        }
    }
}

// The highest layer of `v` at or below `y` a cell starts at, or its bottom.
fn aligned_down(v: Volume, cell: i32, y: i32) -> i32 {
    var i = y
    while i > 0 and (v.min_y + i * v.step_y).floor_mod(cell) != 0 {
        i -= 1
    }
    return i
}

// The lowest layer of `v` at or above `y` a cell starts at, or its top.
fn aligned_up(v: Volume, cell: i32, y: i32) -> i32 {
    var i = y
    while i < v.size_y and (v.min_y + i * v.step_y).floor_mod(cell) != 0 {
        i += 1
    }
    return i
}

// The sampler over the layers `from` to `to` of `v`, its values at the layers `keep_from` to
// `keep_to`, which they hold, put in `out` where they are in `v`.
fn fill_layers(p: Program, ctx: mut Context, s: usize, out: mut List<f32>, v: Volume, from: i32, to: i32, keep_from: i32, keep_to: i32) ! Thrown {
    let part = try volume(v.size_x, to - from, v.size_z, v.min_x, v.min_y + from * v.step_y, v.min_z, v.step_x, v.step_y, v.step_z)
    let buf = try sampled(p, mut ctx, s, part)
    let n = keep_to - keep_from
    for z in 0..v.size_z {
        for x in 0..v.size_x {
            var i = at(v.index(x, keep_from, z))
            var j = at(part.index(x, keep_from - from, z))
            for _ in 0..n {
                out[i] = buf[j]
                i += 1
                j += 1
            }
        }
    }
}

/// Sampler `s` over `v` as `sampled` gives it, at least at the points where `alpha` isn't
/// `skip`: a noise is worked out only where it's needed.
fn sampled_unless(p: Program, ctx: mut Context, s: usize, v: Volume, alpha: List<f32>, skip: f32) -> List<f32> ! Thrown {
    match p.samplers[s] {
        Noise { noise, xz, ys } => {
            var mask: List<u8> = [0u8; alpha.len()]
            var any = false
            for i in 0..alpha.len().min(mask.len()) {
                let needed: u8 = if alpha[i] != skip { 1 } else { 0 }
                mask[i] = needed
            }
            for i in 0..mask.len() {
                if mask[i] != 0 {
                    any = true
                    break
                }
            }
            var buf = try zeros(v.size())
            if any {
                p.noises[noise].add_where(mut buf, v, xz, ys, 1.0f32, mask)
            }
            return buf
        },
        _ => return try sampled(p, mut ctx, s, v),
    }
}

/// Sampler `s` over `v`, into a buffer of its own, as `acquireBuffer` gives one.
fn sampled(p: Program, ctx: mut Context, s: usize, v: Volume) -> List<f32> ! Thrown {
    var buf = try zeros(v.size())
    try fill(p, mut ctx, s, mut buf, v)
    return buf
}

/// The corners of the cells of `xz` by `ys` blocks that `v` touches, as `sampleWithBlockStep`
/// samples its input at.
fn corners_of(v: Volume, xz: i32, ys: i32) -> Volume ! Thrown {
    let min_cx = v.min_x.floor_div(xz)
    let min_cy = v.min_y.floor_div(ys)
    let min_cz = v.min_z.floor_div(xz)
    let count_x = v.max_block_x().floor_div(xz) - min_cx + 1
    let count_y = v.max_block_y().floor_div(ys) - min_cy + 1
    let count_z = v.max_block_z().floor_div(xz) - min_cz + 1
    return try volume(
        if v.max_block_x().floor_mod(xz) == 0 { count_x } else { count_x + 1 },
        if v.max_block_y().floor_mod(ys) == 0 { count_y } else { count_y + 1 },
        if v.max_block_z().floor_mod(xz) == 0 { count_z } else { count_z + 1 },
        min_cx * xz, min_cy * ys, min_cz * xz, xz, ys, xz,
    )
}

// Whether the points of `inner` are all points of `outer`, with the same steps.
fn covers(outer: Volume, inner: Volume) -> bool {
    if outer.step_x != inner.step_x or outer.step_y != inner.step_y or outer.step_z != inner.step_z {
        return false
    }
    let dx = inner.min_x - outer.min_x
    let dy = inner.min_y - outer.min_y
    let dz = inner.min_z - outer.min_z
    if dx < 0 or dy < 0 or dz < 0 or dx.floor_mod(outer.step_x) != 0 or dy.floor_mod(outer.step_y) != 0 or dz.floor_mod(outer.step_z) != 0 {
        return false
    }
    return dx / outer.step_x + inner.size_x <= outer.size_x and dy / outer.step_y + inner.size_y <= outer.size_y and dz / outer.step_z + inner.size_z <= outer.size_z
}

/// The input of the interpolated sampler `s` at the corners `cv`: from the corners kept for it
/// where they hold `cv`, else sampled over the corners of the context's whole volume where that
/// holds `cv`, and kept, else sampled over `cv`. Each corner's value is the input at that point,
/// whatever volume it's sampled over.
fn corner_values(p: Program, ctx: mut Context, s: usize, input: usize, xz: i32, ys: i32, cv: Volume) -> List<f32> ! Thrown {
    var g = ctx.grids.len()
    for i in 0..ctx.grids.len() {
        if ctx.grids[i].sampler == s and covers(ctx.grids[i].corners, cv) {
            g = i
            break
        }
    }
    if g == ctx.grids.len() {
        let w = ctx.whole else return try sampled(p, mut ctx, input, cv)
        let wc = try corners_of(w, xz, ys)
        if not covers(wc, cv) {
            return try sampled(p, mut ctx, input, cv)
        }
        let values = try sampled_sides(p, mut ctx, s, input, xz, wc)
        ctx.grids.push(Grid { sampler: s, corners: wc, values: values })
    }
    let gc = ctx.grids[g].corners
    let ox = (cv.min_x - gc.min_x) / gc.step_x
    let oy = (cv.min_y - gc.min_y) / gc.step_y
    let oz = (cv.min_z - gc.min_z) / gc.step_z
    var out: List<f32> = [0.0f32; usize.wrap(cv.size())]
    var i: usize = 0
    for z in 0..cv.size_z {
        for x in 0..cv.size_x {
            var j = usize.wrap(gc.index(x + ox, oy, z + oz))
            for _ in 0..cv.size_y {
                out[i] = ctx.grids[g].values[j]
                i += 1
                j += 1
            }
        }
    }
    return out
}

/// The input of the interpolated sampler `s` at `wc`, the corners of the cells `xz` across of
/// a whole chunk's volume: with the context's faces, the columns on its west and north sides
/// taken from the chunks there where they're kept, the rest sampled, and its east and south
/// sides kept for the chunks there (D301).
fn sampled_sides(p: Program, ctx: mut Context, s: usize, input: usize, xz: i32, wc: Volume) -> List<f32> ! Thrown {
    if xz <= 0 or 16 % xz != 0 {
        return try sampled(p, mut ctx, input, wc)
    }
    let side = 16 / xz
    let shaped = wc.step_x == xz and wc.step_z == xz and wc.size_x == side + 1 and wc.size_z == side + 1 and (wc.min_x & 15) == 0 and (wc.min_z & 15) == 0
    let near = wc.min_x > -FAR_FACES and wc.min_x < FAR_FACES and wc.min_z > -FAR_FACES and wc.min_z < FAR_FACES
    if not shaped or not near {
        return try sampled(p, mut ctx, input, wc)
    }
    let kept = ctx.faces.take() else return try sampled(p, mut ctx, input, wc)
    var faces = kept
    var t = faces.tables.len()
    for i in 0..faces.tables.len() {
        if faces.tables[i].sampler == s {
            t = i
            break
        }
    }
    let n = wc.size_x
    let ny = wc.size_y
    let column = usize.wrap(ny)
    if t == faces.tables.len() {
        faces.tables.push(FaceTable { sampler: s, bearded: reads_beardifier(p, input), min_y: wc.min_y, size_y: ny, step_y: wc.step_y, step_xz: xz, side: n, keys: [NO_FACE; FACE_PLACES], values: [0.0f32; FACE_PLACES * 2 * usize.wrap(n) * column] })
    } else if faces.tables[t].min_y != wc.min_y or faces.tables[t].size_y != ny or faces.tables[t].step_y != wc.step_y or faces.tables[t].step_xz != xz or faces.tables[t].side != n {
        faces.tables[t] = FaceTable { sampler: s, bearded: faces.tables[t].bearded, min_y: wc.min_y, size_y: ny, step_y: wc.step_y, step_xz: xz, side: n, keys: [NO_FACE; FACE_PLACES], values: [0.0f32; FACE_PLACES * 2 * usize.wrap(n) * column] }
    }
    // Where the chunk has a beardifier its input reads, its corners are its own.
    let has_beard = match ctx.beard {
        some(_) => true,
        none => false,
    }
    if faces.tables[t].bearded and has_beard {
        ctx.faces = some(faces)
        return try sampled(p, mut ctx, input, wc)
    }
    let cx = wc.min_x >> 4
    let cz = wc.min_z >> 4
    let per = 2 * usize.wrap(n) * column
    let west_place = face_place(cx - 1, cz)
    let north_place = face_place(cx, cz - 1)
    let west = faces.tables[t].keys[west_place] == face_key(cx - 1, cz)
    let north = faces.tables[t].keys[north_place] == face_key(cx, cz - 1)
    var out: List<f32> = [0.0f32; usize.wrap(wc.size())]
    // The west chunk's east side is this one's west, and the north chunk's south side its north.
    if west {
        let from = west_place * per
        for z in 0..n {
            copy_run(mut out, usize.wrap(wc.index(0, 0, z)), faces.tables[t].values, from + usize.wrap(z) * column, column)
        }
    }
    if north {
        let from = north_place * per + usize.wrap(n) * column
        for x in 0..n {
            copy_run(mut out, usize.wrap(wc.index(x, 0, 0)), faces.tables[t].values, from + usize.wrap(x) * column, column)
        }
    }
    let x0 = if west { 1 } else { 0 }
    let z0 = if north { 1 } else { 0 }
    // The faces are given back before sampling, so a sampler inside this one fills as it would.
    ctx.faces = some(faces)
    let sub = try volume(n - x0, ny, n - z0, wc.min_x + x0 * xz, wc.min_y, wc.min_z + z0 * xz, xz, wc.step_y, xz)
    let part = try sampled(p, mut ctx, input, sub)
    for z in 0..n - z0 {
        for x in 0..n - x0 {
            copy_run(mut out, usize.wrap(wc.index(x + x0, 0, z + z0)), part, usize.wrap(sub.index(x, 0, z)), column)
        }
    }
    let back = ctx.faces.take() else return out
    faces = back
    let place = face_place(cx, cz)
    faces.tables[t].keys[place] = face_key(cx, cz)
    let to = place * per
    for z in 0..n {
        copy_run(mut faces.tables[t].values, to + usize.wrap(z) * column, out, usize.wrap(wc.index(n - 1, 0, z)), column)
    }
    for x in 0..n {
        copy_run(mut faces.tables[t].values, to + usize.wrap(n + x) * column, out, usize.wrap(wc.index(x, 0, n - 1)), column)
    }
    ctx.faces = some(faces)
    return out
}

/// `InterpolatedFunction.Sampler.sampleWithBlockStep`: the input at the corners of each cell
/// the volume touches, and the volume's blocks lerped between them.
fn interpolate(p: Program, ctx: mut Context, s: usize, input: usize, xz: i32, ys: i32, xz_inv: f32, y_inv: f32, out: mut List<f32>, v: Volume) ! Thrown {
    let count_x = v.max_block_x().floor_div(xz) - v.min_x.floor_div(xz) + 1
    let count_y = v.max_block_y().floor_div(ys) - v.min_y.floor_div(ys) + 1
    let count_z = v.max_block_z().floor_div(xz) - v.min_z.floor_div(xz) + 1
    let cv = try corners_of(v, xz, ys)
    let cells = try corner_values(p, mut ctx, s, input, xz, ys, cv)
    for cz in 0..count_z {
        let nz = (cz + 1).min(cv.size_z - 1)
        for cx in 0..count_x {
            let nx = (cx + 1).min(cv.size_x - 1)
            var v000 = cells[at(cv.index(cx, 0, cz))]
            var v100 = cells[at(cv.index(nx, 0, cz))]
            var v001 = cells[at(cv.index(cx, 0, nz))]
            var v101 = cells[at(cv.index(nx, 0, nz))]
            for cy in 0..count_y {
                let ny = (cy + 1).min(cv.size_y - 1)
                let v010 = cells[at(cv.index(cx, ny, cz))]
                let v110 = cells[at(cv.index(nx, ny, cz))]
                let v011 = cells[at(cv.index(cx, ny, nz))]
                let v111 = cells[at(cv.index(nx, ny, nz))]
                let ox = cv.block_x(cx) - v.min_x
                let oy = cv.block_y(cy) - v.min_y
                let oz = cv.block_z(cz) - v.min_z
                let x0 = (0).max(-ox)
                let y0 = (0).max(-oy)
                let z0 = (0).max(-oz)
                let x1 = xz.min(v.size_x - ox) - 1
                let y1 = ys.min(v.size_y - oy) - 1
                let z1 = xz.min(v.size_z - oz) - 1
                var z = z0
                while z <= z1 {
                    let out_z = oz + z
                    let az = f32.nearest(z) * xz_inv
                    let v00 = lerp(az, v000, v001)
                    let v01 = lerp(az, v010, v011)
                    let v10 = lerp(az, v100, v101)
                    let v11 = lerp(az, v110, v111)
                    var x = x0
                    while x <= x1 {
                        let ax = f32.nearest(x) * xz_inv
                        let w0 = lerp(ax, v00, v10)
                        let w1 = lerp(ax, v01, v11)
                        let step = (w1 - w0) * y_inv
                        var value = w0 + step * f32.nearest(y0)
                        var i = v.index(ox + x, oy + y0, out_z)
                        var y = y0
                        while y <= y1 {
                            out[at(i)] = value
                            i += 1
                            value += step
                            y += 1
                        }
                        x += 1
                    }
                    z += 1
                }
                v000 = v010
                v100 = v110
                v001 = v011
                v101 = v111
            }
        }
    }
}

// Bounds over boxes of blocks (D241).

/// Boxes of blocks: each from its lowest corner `x`, `y`, `z`, `sx` by `sy` by `sz` blocks.
pub struct Boxes {
    pub x: List<i32> = List<i32>()
    pub y: List<i32> = List<i32>()
    pub z: List<i32> = List<i32>()
    pub sy: List<i32> = List<i32>()
    pub sx: i32
    pub sz: i32
}

impl Boxes {
    /// No boxes yet, each `sx` by `sz` blocks across.
    pub fn new(sx: i32, sz: i32) -> Boxes {
        return Boxes { sx: sx, sz: sz }
    }

    pub fn add(mut self, x: i32, y: i32, z: i32, sy: i32) {
        self.x.push(x)
        self.y.push(y)
        self.z.push(z)
        self.sy.push(sy)
    }

    pub fn len(self) -> usize {
        return self.x.len()
    }
}

/// Bounds of a sampler over each of some boxes: from `low` to `high`, each a little wider than
/// its values can be, or infinite.
pub struct Bounds {
    pub low: List<f64>
    pub high: List<f64>
}

/// The bounds of nothing known over `n` boxes.
fn unbounded(n: usize) -> Bounds {
    return Bounds { low: [f64.NEG_INFINITY; n], high: [f64.INFINITY; n] }
}

/// The same bounds over `n` boxes.
fn exactly(n: usize, low: f64, high: f64) -> Bounds {
    return Bounds { low: [low; n], high: [high; n] }
}

/// The bounds at `i` grown by a hundred-thousandth of the larger's size and a millionth, more
/// than the rounding of the few `float` operations between them can move a value; unbounded
/// where either is NaN or past 1e30, where a `float` could overflow.
fn widen(b: mut Bounds, i: usize) {
    let low = b.low[i]
    let high = b.high[i]
    let m = low.abs().max(high.abs())
    if low != low or high != high or m > 1e30 {
        b.low[i] = f64.NEG_INFINITY
        b.high[i] = f64.INFINITY
        return
    }
    let e = m * 1e-5 + 1e-6
    b.low[i] = low - e
    b.high[i] = high + e
}

// The least and greatest of four products, into `out` at `i`.
fn products(out: mut Bounds, i: usize, a: f64, b: f64, c: f64, d: f64) {
    let p = a * c
    let q = a * d
    let r = b * c
    let s = b * d
    out.low[i] = p.min(q).min(r).min(s)
    out.high[i] = p.max(q).max(r).max(s)
    widen(mut out, i)
}

/// The cell height every interpolated sampler's cells start at a multiple of, which a part of a
/// volume filled on its own starts at to give each point what filling it whole would.
pub fn cells_of(p: Program) -> i32 {
    return cell_height(p)
}

/// Bounds of what the sampler `s` gives at every block of each of the boxes `b`. An
/// interpolated sampler's blocks are lerped between the corners of their cells, so they lie
/// between the least and greatest of the corners the context keeps for it, and what's worked
/// out from them a block at a time is bounded as its operations bound it. Any other sampler a
/// block at a time is unbounded, as is an interpolated one whose corners aren't kept (D241).
pub fn bounds_over(p: Program, ctx: Context, s: usize, b: Boxes) -> Bounds {
    let n = b.len()
    match p.samplers[s] {
        Constant(v) => {
            var out = exactly(n, f64(v), f64(v))
            for i in 0..n {
                widen(mut out, i)
            }
            return out
        },
        Beard => {
            let beard = ctx.beard else return exactly(n, 0.0, 0.0)
            var out = exactly(n, 0.0, 0.0)
            for i in 0..n {
                let (low, high) = beard.bounds(b.x[i], b.y[i], b.z[i], b.x[i] + b.sx - 1, b.y[i] + b.sy[i] - 1, b.z[i] + b.sz - 1)
                out.low[i] = low
                out.high[i] = high
            }
            return out
        },
        Caching { input, .. } => return bounds_over(p, ctx, input, b),
        Interpolated { xz, ys, .. } => return corner_bounds(ctx, s, xz, ys, b),
        Add { left, right } => {
            var out = bounds_over(p, ctx, left, b)
            let r = bounds_over(p, ctx, right, b)
            for i in 0..n {
                out.low[i] = out.low[i] + r.low[i]
                out.high[i] = out.high[i] + r.high[i]
                widen(mut out, i)
            }
            return out
        },
        Sub { left, right } => {
            var out = bounds_over(p, ctx, left, b)
            let r = bounds_over(p, ctx, right, b)
            for i in 0..n {
                out.low[i] = out.low[i] - r.high[i]
                out.high[i] = out.high[i] - r.low[i]
                widen(mut out, i)
            }
            return out
        },
        Mul { left, right } => {
            var out = bounds_over(p, ctx, left, b)
            let r = bounds_over(p, ctx, right, b)
            for i in 0..n {
                let a = out.low[i]
                let c = out.high[i]
                products(mut out, i, a, c, r.low[i], r.high[i])
            }
            return out
        },
        Min { left, right, .. } => {
            var out = bounds_over(p, ctx, left, b)
            let r = bounds_over(p, ctx, right, b)
            for i in 0..n {
                out.low[i] = out.low[i].min(r.low[i])
                out.high[i] = out.high[i].min(r.high[i])
            }
            return out
        },
        Max { left, right, .. } => {
            var out = bounds_over(p, ctx, left, b)
            let r = bounds_over(p, ctx, right, b)
            for i in 0..n {
                out.low[i] = out.low[i].max(r.low[i])
                out.high[i] = out.high[i].max(r.high[i])
            }
            return out
        },
        Const { op, input, value } => {
            var out = bounds_over(p, ctx, input, b)
            let v = f64(value)
            for i in 0..n {
                let a = out.low[i]
                let c = out.high[i]
                match op {
                    ConstOp.Add => {
                        out.low[i] = a + v
                        out.high[i] = c + v
                        widen(mut out, i)
                    },
                    ConstOp.Sub => {
                        out.low[i] = v - c
                        out.high[i] = v - a
                        widen(mut out, i)
                    },
                    ConstOp.Mul => products(mut out, i, a, c, v, v),
                    ConstOp.Min => {
                        out.low[i] = a.min(v)
                        out.high[i] = c.min(v)
                    },
                    ConstOp.Max => {
                        out.low[i] = a.max(v)
                        out.high[i] = c.max(v)
                    },
                    ConstOp.Div => {
                        out.low[i] = f64.NEG_INFINITY
                        out.high[i] = f64.INFINITY
                    },
                }
            }
            return out
        },
        Unary { op, input } => {
            var out = bounds_over(p, ctx, input, b)
            for i in 0..n {
                unary_bounds(op, mut out, i)
            }
            return out
        },
        Clamp { input, low, high } => {
            var out = bounds_over(p, ctx, input, b)
            let lo = f64(low)
            let hi = f64(high)
            for i in 0..n {
                let a = out.low[i]
                let c = out.high[i]
                out.low[i] = if a < lo { lo } else { a.min(hi) }
                out.high[i] = if c < lo { lo } else { c.min(hi) }
            }
            return out
        },
        ChoiceConst { input, low, high, inside, outside } => {
            var out = bounds_over(p, ctx, input, b)
            let i_v = f64(inside)
            let o_v = f64(outside)
            for i in 0..n {
                let side = choice_side(out.low[i], out.high[i], f64(low), f64(high))
                if side == INSIDE_ONLY {
                    out.low[i] = i_v
                    out.high[i] = i_v
                } else if side == OUTSIDE_ONLY {
                    out.low[i] = o_v
                    out.high[i] = o_v
                } else {
                    out.low[i] = i_v.min(o_v)
                    out.high[i] = i_v.max(o_v)
                }
            }
            return out
        },
        Choice { input, low, high, inside, outside } => {
            var out = bounds_over(p, ctx, input, b)
            // Each side is bounded only where some box can take it.
            var any_in = false
            var any_out = false
            var sides = List<i32>()
            for i in 0..n {
                let side = choice_side(out.low[i], out.high[i], f64(low), f64(high))
                sides.push(side)
                any_in = any_in or side & INSIDE_ONLY != 0
                any_out = any_out or side & OUTSIDE_ONLY != 0
            }
            let ins = if any_in { bounds_over(p, ctx, inside, b) } else { unbounded(n) }
            let outs = if any_out { bounds_over(p, ctx, outside, b) } else { unbounded(n) }
            for i in 0..n {
                let side = sides[i]
                if side == INSIDE_ONLY {
                    out.low[i] = ins.low[i]
                    out.high[i] = ins.high[i]
                } else if side == OUTSIDE_ONLY {
                    out.low[i] = outs.low[i]
                    out.high[i] = outs.high[i]
                } else {
                    out.low[i] = ins.low[i].min(outs.low[i])
                    out.high[i] = ins.high[i].max(outs.high[i])
                }
            }
            return out
        },
        Lerp { alpha, first, second } => {
            let a = bounds_over(p, ctx, alpha, b)
            var out = bounds_over(p, ctx, first, b)
            let r = bounds_over(p, ctx, second, b)
            for i in 0..n {
                out.low[i] = out.low[i].min(r.low[i])
                out.high[i] = out.high[i].max(r.high[i])
                lerp_bounds(mut out, i, a.low[i], a.high[i])
            }
            return out
        },
        LerpConstFirst { alpha, first, second } => {
            let a = bounds_over(p, ctx, alpha, b)
            var out = bounds_over(p, ctx, second, b)
            for i in 0..n {
                out.low[i] = out.low[i].min(f64(first))
                out.high[i] = out.high[i].max(f64(first))
                lerp_bounds(mut out, i, a.low[i], a.high[i])
            }
            return out
        },
        LerpConstSecond { alpha, first, second } => {
            let a = bounds_over(p, ctx, alpha, b)
            var out = bounds_over(p, ctx, first, b)
            for i in 0..n {
                out.low[i] = out.low[i].min(f64(second))
                out.high[i] = out.high[i].max(f64(second))
                lerp_bounds(mut out, i, a.low[i], a.high[i])
            }
            return out
        },
        Gradient { axis, tiling, from, low, high, span, from_value, factor } => {
            // A clamped gradient runs one way along its axis, so its ends bound it.
            let clamped = match tiling {
                Tiling.Clamp => true,
                _ => false,
            }
            if not clamped {
                return unbounded(n)
            }
            var out = exactly(n, 0.0, 0.0)
            for i in 0..n {
                let (c0, c1) = match axis {
                    Axis.X => (b.x[i], b.x[i] + b.sx - 1),
                    Axis.Y => (b.y[i], b.y[i] + b.sy[i] - 1),
                    Axis.Z => (b.z[i], b.z[i] + b.sz - 1),
                }
                let g0 = match gradient(tiling, c0, from, low, high, span, from_value, factor) {
                    ok(g) => f64(g),
                    err(_) => return unbounded(n),
                }
                let g1 = match gradient(tiling, c1, from, low, high, span, from_value, factor) {
                    ok(g) => f64(g),
                    err(_) => return unbounded(n),
                }
                out.low[i] = g0.min(g1)
                out.high[i] = g0.max(g1)
                widen(mut out, i)
            }
            return out
        },
        _ => return unbounded(n),
    }
}

// Which sides of a range choice an input from `a` to `b` can take.
const INSIDE_ONLY: i32 = 1
const OUTSIDE_ONLY: i32 = 2

fn choice_side(a: f64, b: f64, low: f64, high: f64) -> i32 {
    if a >= low and b < high {
        return INSIDE_ONLY
    }
    if b < low or a >= high {
        return OUTSIDE_ONLY
    }
    return INSIDE_ONLY | OUTSIDE_ONLY
}

// A lerp's bounds at `i`, its sides' hull there, where its alpha, from `a` to `c`, is from 0 to
// 1, so its value is between its sides'; else unbounded.
fn lerp_bounds(out: mut Bounds, i: usize, a: f64, c: f64) {
    if a >= -1e-6 and c <= 1.0 + 1e-6 {
        widen(mut out, i)
    } else {
        out.low[i] = f64.NEG_INFINITY
        out.high[i] = f64.INFINITY
    }
}

/// Bounds of a unary function at `i` of an input bounded there, for those that run one way, or
/// one way each side of 0.
fn unary_bounds(op: UnaryOp, out: mut Bounds, i: usize) {
    let a = out.low[i]
    let b = out.high[i]
    match op {
        Abs => {
            if a >= 0.0 {
                return
            }
            if b <= 0.0 {
                out.low[i] = -b
                out.high[i] = -a
            } else {
                out.low[i] = 0.0
                out.high[i] = (-a).max(b)
            }
        },
        Square => {
            let m = if a >= 0.0 { a } else if b <= 0.0 { -b } else { 0.0 }
            let k = (-a).max(b)
            out.low[i] = m * m
            out.high[i] = k * k
            widen(mut out, i)
        },
        Cube => {
            out.low[i] = a * a * a
            out.high[i] = b * b * b
            widen(mut out, i)
        },
        Negate => {
            out.low[i] = -b
            out.high[i] = -a
        },
        HalfNegative => {
            out.low[i] = if a > 0.0 { a } else { a * 0.5 }
            out.high[i] = if b > 0.0 { b } else { b * 0.5 }
            widen(mut out, i)
        },
        QuarterNegative => {
            out.low[i] = if a > 0.0 { a } else { a * 0.25 }
            out.high[i] = if b > 0.0 { b } else { b * 0.25 }
            widen(mut out, i)
        },
        Squeeze => {
            out.low[i] = squeezed(a)
            out.high[i] = squeezed(b)
            widen(mut out, i)
        },
        _ => {
            out.low[i] = f64.NEG_INFINITY
            out.high[i] = f64.INFINITY
        },
    }
}

// `squeeze` in `double`, which runs one way.
fn squeezed(v: f64) -> f64 {
    let c = if v < -1.0 { -1.0 } else { v.min(1.0) }
    return c / 2.0 - c * c * c / 24.0
}

/// Bounds of the interpolated sampler `s` over each box: the least and greatest of the corners
/// of the cells it touches, from those the context keeps for `s`; unbounded where it keeps none
/// that hold them, or one is NaN.
fn corner_bounds(ctx: Context, s: usize, xz: i32, ys: i32, b: Boxes) -> Bounds {
    let n = b.len()
    var g = ctx.grids.len()
    for i in 0..ctx.grids.len() {
        if ctx.grids[i].sampler == s {
            g = i
            break
        }
    }
    if g == ctx.grids.len() {
        return unbounded(n)
    }
    let gc = ctx.grids[g].corners
    if gc.step_x != xz or gc.step_y != ys or gc.step_z != xz {
        return unbounded(n)
    }
    var out = unbounded(n)
    let one_cell = b.sx == xz and b.sz == xz
    for k in 0..n {
        if one_cell and b.sy[k] == ys and b.x[k].floor_mod(xz) == 0 and b.y[k].floor_mod(ys) == 0 and b.z[k].floor_mod(xz) == 0 {
            cell_hull(ctx.grids[g].values, gc, (b.x[k] - gc.min_x) / xz, (b.y[k] - gc.min_y) / ys, (b.z[k] - gc.min_z) / xz, mut out, k)
        } else {
            corner_hull(ctx.grids[g].values, gc, xz, ys, b.x[k], b.y[k], b.z[k], b.sx, b.sy[k], b.sz, mut out, k)
        }
    }
    return out
}

// The least and greatest of the eight corners of the cell from the kept corner `cx`, `cy`, `cz`,
// into `out` at `k`, where they're all kept and none is NaN.
fn cell_hull(values: List<f32>, gc: Volume, cx: i32, cy: i32, cz: i32, out: mut Bounds, k: usize) {
    if cx < 0 or cy < 0 or cz < 0 or cx + 1 >= gc.size_x or cy + 1 >= gc.size_y or cz + 1 >= gc.size_z {
        return
    }
    let a = usize.wrap(gc.index(cx, cy, cz))
    let b = usize.wrap(gc.index(cx + 1, cy, cz))
    let c = usize.wrap(gc.index(cx, cy, cz + 1))
    let d = usize.wrap(gc.index(cx + 1, cy, cz + 1))
    let v0 = values[a]
    let v1 = values[a + 1]
    let v2 = values[b]
    let v3 = values[b + 1]
    let v4 = values[c]
    let v5 = values[c + 1]
    let v6 = values[d]
    let v7 = values[d + 1]
    // A NaN makes the sum NaN.
    let sum = f64(v0) + f64(v1) + f64(v2) + f64(v3) + f64(v4) + f64(v5) + f64(v6) + f64(v7)
    if sum != sum {
        return
    }
    // None is NaN, so plain comparisons find the least and greatest.
    let l01 = if v1 < v0 { v1 } else { v0 }
    let l23 = if v3 < v2 { v3 } else { v2 }
    let l45 = if v5 < v4 { v5 } else { v4 }
    let l67 = if v7 < v6 { v7 } else { v6 }
    let l03 = if l23 < l01 { l23 } else { l01 }
    let l47 = if l67 < l45 { l67 } else { l45 }
    let h01 = if v1 > v0 { v1 } else { v0 }
    let h23 = if v3 > v2 { v3 } else { v2 }
    let h45 = if v5 > v4 { v5 } else { v4 }
    let h67 = if v7 > v6 { v7 } else { v6 }
    let h03 = if h23 > h01 { h23 } else { h01 }
    let h47 = if h67 > h45 { h67 } else { h45 }
    out.low[k] = f64(if l47 < l03 { l47 } else { l03 })
    out.high[k] = f64(if h47 > h03 { h47 } else { h03 })
    widen(mut out, k)
}

// The least and greatest of the kept corners `values`, over `gc`, of the cells the box touches,
// into `out` at `k`; past the last corner, the last, as `interpolate` takes it.
fn corner_hull(values: List<f32>, gc: Volume, xz: i32, ys: i32, x: i32, y: i32, z: i32, sx: i32, sy: i32, sz: i32, out: mut Bounds, k: usize) {
    let x0 = (x.floor_div(xz) * xz - gc.min_x) / xz
    let y0 = (y.floor_div(ys) * ys - gc.min_y) / ys
    let z0 = (z.floor_div(xz) * xz - gc.min_z) / xz
    if x0 < 0 or y0 < 0 or z0 < 0 or x0 >= gc.size_x or y0 >= gc.size_y or z0 >= gc.size_z {
        return
    }
    let x1 = (((x + sx - 1).floor_div(xz) * xz - gc.min_x) / xz + 1).min(gc.size_x - 1)
    let y1 = (((y + sy - 1).floor_div(ys) * ys - gc.min_y) / ys + 1).min(gc.size_y - 1)
    let z1 = (((z + sz - 1).floor_div(xz) * xz - gc.min_z) / xz + 1).min(gc.size_z - 1)
    var low = f64.INFINITY
    var high = f64.NEG_INFINITY
    for cz in z0..z1 + 1 {
        for cx in x0..x1 + 1 {
            var i = usize.wrap(gc.index(cx, y0, cz))
            for _ in y0..y1 + 1 {
                let v = f64(values[i])
                if v != v {
                    return
                }
                low = low.min(v)
                high = high.max(v)
                i += 1
            }
        }
    }
    out.low[k] = low
    out.high[k] = high
    widen(mut out, k)
}
