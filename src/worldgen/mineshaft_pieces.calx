/// A mineshaft's pieces placed as their chunks are decorated: none where the piece's edge in the
/// chunk meets a liquid or its middle is in a biome that blocks mineshafts; else corridors with
/// their supports, cobwebs, rails, chest minecarts and cave spider spawner, crossings with their
/// pillars, rooms hollowed under their domes, and stairs. Their wood, planks, fences and chains
/// are never placed over.
module worldgen.mineshaft_pieces

import nbt.tag.{Tag}
import random.source.{RandomSource}
import worldgen.drawing.{Frame, UPDATE_CLIENTS, block_state, box, facing, get, interior, maybe_block, maybe_box, place, replaceable_by_structures, upper_half_sphere, with}
import worldgen.facts.{CENTER, DOWN, FULL, Facts, NORTH, SOUTH, UP, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Field, Piece, PieceData, flag}
import worldgen.region.{Region}
import worldgen.template.{Bounds}

// A mineshaft's woods: the normal one's oak, the mesa's dark oak.
struct Woods {
    log: u32
    planks: u32
    fence: u32
}

/// `postProcess` of a mineshaft piece: `mscorridor`, `mscrossing`, `msroom` or `msstairs`.
pub fn mineshaft_piece<T: RandomSource>(f: Facts, r: mut Region, random: mut T, piece: mut Piece, area: Bounds, blocking: List<i32>) ! Thrown {
    let fields = match piece.data {
        PieceData.Fields(list) => list.copy(),
        _ => fail Thrown { exception: "Unimplemented", message: "a {piece.kind} piece without its fields" },
    }
    let mesa = int_field(fields, "MST") == 1
    var woods = Woods { log: try block_state(f, "oak_log"), planks: try block_state(f, "oak_planks"), fence: try block_state(f, "oak_fence") }
    if mesa {
        woods = Woods { log: try block_state(f, "dark_oak_log"), planks: try block_state(f, "dark_oak_planks"), fence: try block_state(f, "dark_oak_fence") }
    }
    var fr = Frame.of(piece)
    fr.keep = [f.block(woods.log), f.block(woods.planks), f.block(woods.fence), try f.named_block(String("iron_chain"))]
    if try invalid(f, r, piece.bb, area, blocking) {
        return
    }
    if piece.kind == "minecraft:mscorridor" {
        var placed_spider = bool_field(fields, "hps")
        try corridor(f, mut r, mut random, fr, area, woods, bool_field(fields, "hr"), bool_field(fields, "sc"), mut placed_spider, int_field(fields, "Num"))
        var updated = fields.copy()
        for i in 0..updated.len() {
            if updated[i].name == "hps" {
                updated[i].value = flag(placed_spider)
            }
        }
        piece.data = PieceData.Fields(updated)
        return
    }
    if piece.kind == "minecraft:mscrossing" {
        try crossing(f, mut r, fr, area, woods, bool_field(fields, "tf"))
        return
    }
    if piece.kind == "minecraft:msroom" {
        try room(f, mut r, fr, area, fields)
        return
    }
    if piece.kind == "minecraft:msstairs" {
        let air = try block_state(f, "cave_air")
        try box(f, mut r, fr, area, 0, 5, 0, 2, 7, 1, air, air, false)
        try box(f, mut r, fr, area, 0, 0, 7, 2, 2, 8, air, air, false)
        for i in 0..5 {
            try box(f, mut r, fr, area, 0, 5 - i - (if i < 4 { 1 } else { 0 }), 2 + i, 2, 7 - i, 2 + i, air, air, false)
        }
        return
    }
    fail Thrown { exception: "Unimplemented", message: "placing a {piece.kind} piece" }
}

fn int_field(fields: List<Field>, name: str) -> i32 {
    for each in fields {
        if each.name == String(name) {
            return each.value.number_int() ?? 0
        }
    }
    return 0
}

fn bool_field(fields: List<Field>, name: str) -> bool {
    return int_field(fields, name) != 0
}

// `isInInvalidLocation`: the piece's box grown by one, cut to the chunk; whether its middle's
// biome blocks mineshafts, or any block of its faces is a liquid.
fn invalid(f: Facts, r: Region, bb: Bounds, area: Bounds, blocking: List<i32>) -> bool ! Thrown {
    let x0 = (bb.min_x - 1).max(area.min_x)
    let y0 = (bb.min_y - 1).max(area.min_y)
    let z0 = (bb.min_z - 1).max(area.min_z)
    let x1 = (bb.max_x + 1).min(area.max_x)
    let y1 = (bb.max_y + 1).min(area.max_y)
    let z1 = (bb.max_z + 1).min(area.max_z)
    if blocking.contains(try r.biome((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)) {
        return true
    }
    for x in x0..x1 + 1 {
        for z in z0..z1 + 1 {
            if f.is_liquid(try r.state(f, x, y0, z)) or f.is_liquid(try r.state(f, x, y1, z)) {
                return true
            }
        }
    }
    for x in x0..x1 + 1 {
        for y in y0..y1 + 1 {
            if f.is_liquid(try r.state(f, x, y, z0)) or f.is_liquid(try r.state(f, x, y, z1)) {
                return true
            }
        }
    }
    for z in z0..z1 + 1 {
        for y in y0..y1 + 1 {
            if f.is_liquid(try r.state(f, x0, y, z)) or f.is_liquid(try r.state(f, x1, y, z)) {
                return true
            }
        }
    }
    return false
}

// `setPlanksBlock`: planks under the piece's `x, y, z` where it's interior, unless the block's
// top is sturdy already.
fn planks_at(f: Facts, r: mut Region, fr: Frame, area: Bounds, planks: u32, x: i32, y: i32, z: i32) ! Thrown {
    if not try interior(f, mut r, fr, x, y, z, area) {
        return
    }
    let wx = fr.x(x, z)
    let wy = fr.y(y)
    let wz = fr.z(x, z)
    if not f.sturdy(try r.state(f, wx, wy, wz), UP, FULL) {
        _ = r.set_block(f, wx, wy, wz, planks, UPDATE_CLIENTS)
    }
}

// `MineShaftCorridor.postProcess`.
fn corridor<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, woods: Woods, rails: bool, spider: bool, placed_spider: mut bool, sections: i32) ! Thrown {
    let air = try block_state(f, "cave_air")
    let length = sections * 5 - 1
    try box(f, mut r, fr, area, 0, 0, 0, 2, 1, length, air, air, false)
    try maybe_box(f, mut r, fr, area, mut random, 0.8f32, 0, 2, 0, 2, 2, length, air, air, false, false)
    if spider {
        try maybe_box(f, mut r, fr, area, mut random, 0.6f32, 0, 0, 0, 2, 1, length, try block_state(f, "cobweb"), air, false, true)
    }
    for section in 0..sections {
        let z = 2 + section * 5
        try support(f, mut r, mut random, fr, area, woods, 0, 0, z, 2, 2)
        let webs: List<i32> = [0, z - 1, 2, z - 1, 0, z + 1, 2, z + 1, 0, z - 2, 2, z - 2, 0, z + 2, 2, z + 2]
        for k in 0..8 {
            let chance = if k < 4 { 0.1f32 } else { 0.05f32 }
            try cobweb(f, mut r, mut random, fr, area, chance, webs[usize.wrap(k * 2)], 2, webs[usize.wrap(k * 2 + 1)])
        }
        if random.next_int_below(100) == 0 {
            try minecart(f, mut r, mut random, fr, area, 2, 0, z - 1)
        }
        if random.next_int_below(100) == 0 {
            try minecart(f, mut r, mut random, fr, area, 0, 0, z + 1)
        }
        if spider and not placed_spider {
            let sz = z - 1 + random.next_int_below(3)
            let wx = fr.x(1, sz)
            let wy = fr.y(0)
            let wz = fr.z(1, sz)
            if area.inside(wx, wy, wz) and try interior(f, mut r, fr, 1, 0, sz, area) {
                placed_spider = true
                _ = r.set_block(f, wx, wy, wz, try block_state(f, "spawner"), UPDATE_CLIENTS)
                if let kind = try r.block_entity(f, wx, wy, wz) {
                    if kind == "minecraft:mob_spawner" {
                        r.set_spawner_entity(wx, wy, wz, String("minecraft:cave_spider"))
                    }
                }
            }
        }
    }
    for x in 0..3 {
        for z in 0..length + 1 {
            try planks_at(f, mut r, fr, area, woods.planks, x, -1, z)
        }
    }
    try double_support(f, mut r, fr, area, woods, 0, -1, 2)
    if sections > 1 {
        try double_support(f, mut r, fr, area, woods, 0, -1, length - 2)
    }
    if rails {
        let rail = try with(f, try block_state(f, "rail"), "shape", "north_south")
        for z in 0..length + 1 {
            let floor = try get(f, r, fr, 1, -1, z, area)
            if not f.is_air(floor) and f.solid_render(floor) {
                let chance = if try interior(f, mut r, fr, 1, 0, z, area) { 0.7f32 } else { 0.9f32 }
                maybe_block(f, mut r, fr, area, mut random, chance, 1, 0, z, rail)
            }
        }
    }
}

// `placeSupport`: where the ceiling holds, fence posts each side and a plank beam, or just the
// planks over the posts one time in four, a torch now and then under the beam.
fn support<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, woods: Woods, x0: i32, y0: i32, z: i32, y1: i32, x1: i32) ! Thrown {
    // `isSupportingBox`: nothing open over the beam.
    for x in x0..x1 + 1 {
        if f.is_air(try get(f, r, fr, x, y1 + 1, z, area)) {
            return
        }
    }
    let air = try block_state(f, "cave_air")
    try box(f, mut r, fr, area, x0, y0, z, x0, y1 - 1, z, try f.with_bool(woods.fence, String("west"), true), air, false)
    try box(f, mut r, fr, area, x1, y0, z, x1, y1 - 1, z, try f.with_bool(woods.fence, String("east"), true), air, false)
    if random.next_int_below(4) == 0 {
        try box(f, mut r, fr, area, x0, y1, z, x0, y1, z, woods.planks, air, false)
        try box(f, mut r, fr, area, x1, y1, z, x1, y1, z, woods.planks, air, false)
    } else {
        try box(f, mut r, fr, area, x0, y1, z, x1, y1, z, woods.planks, air, false)
        let torch = try block_state(f, "wall_torch")
        maybe_block(f, mut r, fr, area, mut random, 0.05f32, x0 + 1, y1, z - 1, try facing(f, torch, SOUTH))
        maybe_block(f, mut r, fr, area, mut random, 0.05f32, x0 + 1, y1, z + 1, try facing(f, torch, NORTH))
    }
}

// `maybePlaceCobWeb`: a cobweb, with the chance, where it's interior and two of its
// neighbours in the chunk are sturdy toward it.
fn cobweb<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, chance: f32, x: i32, y: i32, z: i32) ! Thrown {
    if not try interior(f, mut r, fr, x, y, z, area) {
        return
    }
    if random.next_float() >= chance {
        return
    }
    let wx = fr.x(x, z)
    let wy = fr.y(y)
    let wz = fr.z(x, z)
    var sturdy = 0
    for d in 0..6 {
        let nx = wx + step_x(d)
        let ny = wy + step_y(d)
        let nz = wz + step_z(d)
        if area.inside(nx, ny, nz) and f.sturdy(try r.state(f, nx, ny, nz), opposite(d), FULL) {
            sturdy += 1
            if sturdy >= 2 {
                place(f, mut r, fr, try block_state(f, "cobweb"), x, y, z, area)
                return
            }
        }
    }
}

// `MineShaftCorridor.createChest`: on open ground in the chunk, a rail one way or the other at
// random and a chest minecart on it with the mineshaft's loot.
fn minecart<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, x: i32, y: i32, z: i32) ! Thrown {
    let wx = fr.x(x, z)
    let wy = fr.y(y)
    let wz = fr.z(x, z)
    if not area.inside(wx, wy, wz) or not f.is_air(try r.state(f, wx, wy, wz)) or f.is_air(try r.state(f, wx, wy - 1, wz)) {
        return
    }
    let shape = if random.next_boolean() { "north_south" } else { "east_west" }
    place(f, mut r, fr, try with(f, try block_state(f, "rail"), "shape", shape), x, y, z, area)
    var tag = JavaHashMap<String, Tag>()
    tag.insert("id", Tag.Str(String("minecraft:chest_minecart")))
    tag.insert("Pos", Tag.List([Tag.Double(f64(wx) + 0.5), Tag.Double(f64(wy) + 0.5), Tag.Double(f64(wz) + 0.5)]))
    tag.insert("Rotation", Tag.List([Tag.Float(0.0f32), Tag.Float(0.0f32)]))
    tag.insert("LootTable", Tag.Str(String("minecraft:chests/abandoned_mineshaft")))
    tag.insert("LootTableSeed", Tag.Long(random.next_long()))
    try r.add_entity(wx, wz, Tag.Compound(tag))
}

// `placeDoubleLowerOrUpperSupport`: under each side of the corridor's floor where it's planks,
// a log pillar down or a chain up.
fn double_support(f: Facts, r: mut Region, fr: Frame, area: Bounds, woods: Woods, x: i32, y: i32, z: i32) ! Thrown {
    for side in [x, x + 2] {
        if f.block(try get(f, r, fr, side, y, z, area)) == f.block(woods.planks) {
            try pillar_or_chain(f, mut r, fr, area, woods, side, y, z)
        }
    }
}

// `fillPillarDownOrChainUp`: looking down and up a block further at a time, a log pillar down
// to the first sturdy ground within 20 past what structures replace, or a fence and chain up to
// the first ceiling that holds within 50, whichever comes first.
fn pillar_or_chain(f: Facts, r: mut Region, fr: Frame, area: Bounds, woods: Woods, x: i32, y: i32, z: i32) ! Thrown {
    let wx = fr.x(x, z)
    let wy = fr.y(y)
    let wz = fr.z(x, z)
    if not area.inside(wx, wy, wz) {
        return
    }
    let top = r.min_y + r.height - 1
    var distance = 1
    var below = true
    var above = true
    while below or above {
        if below {
            let at = wy - distance
            let state = try r.state(f, wx, at, wz)
            let empty = try replaceable_by_structures(f, state) and not f.is(state, f.ids.lava)
            if not empty and f.sturdy(state, UP, FULL) {
                for py in at + 1..wy {
                    _ = r.set_block(f, wx, py, wz, woods.log, UPDATE_CLIENTS)
                }
                return
            }
            below = distance <= 20 and empty and at > r.min_y + 1
        }
        if above {
            let at = wy + distance
            let state = try r.state(f, wx, at, wz)
            let empty = try replaceable_by_structures(f, state)
            if not empty and f.sturdy(state, DOWN, CENTER) and not f.is_a(f.block(state), "FallingBlock") {
                _ = r.set_block(f, wx, wy + 1, wz, woods.fence, UPDATE_CLIENTS)
                let chain = try block_state(f, "iron_chain")
                for py in wy + 2..at {
                    _ = r.set_block(f, wx, py, wz, chain, UPDATE_CLIENTS)
                }
                return
            }
            above = distance <= 50 and empty and at < top
        }
        distance += 1
    }
}

// `MineShaftCrossing.postProcess`: the crossing hollowed, one floor or two, planks pillars at
// its inner corners where the ceiling holds, and planks under it.
fn crossing(f: Facts, r: mut Region, fr: Frame, area: Bounds, woods: Woods, two_floors: bool) ! Thrown {
    let air = try block_state(f, "cave_air")
    let b = fr.bb
    if two_floors {
        try box(f, mut r, fr, area, b.min_x + 1, b.min_y, b.min_z, b.max_x - 1, b.min_y + 2, b.max_z, air, air, false)
        try box(f, mut r, fr, area, b.min_x, b.min_y, b.min_z + 1, b.max_x, b.min_y + 2, b.max_z - 1, air, air, false)
        try box(f, mut r, fr, area, b.min_x + 1, b.max_y - 2, b.min_z, b.max_x - 1, b.max_y, b.max_z, air, air, false)
        try box(f, mut r, fr, area, b.min_x, b.max_y - 2, b.min_z + 1, b.max_x, b.max_y, b.max_z - 1, air, air, false)
        try box(f, mut r, fr, area, b.min_x + 1, b.min_y + 3, b.min_z + 1, b.max_x - 1, b.min_y + 3, b.max_z - 1, air, air, false)
    } else {
        try box(f, mut r, fr, area, b.min_x + 1, b.min_y, b.min_z, b.max_x - 1, b.max_y, b.max_z, air, air, false)
        try box(f, mut r, fr, area, b.min_x, b.min_y, b.min_z + 1, b.max_x, b.max_y, b.max_z - 1, air, air, false)
    }
    let corners: List<i32> = [b.min_x + 1, b.min_z + 1, b.min_x + 1, b.max_z - 1, b.max_x - 1, b.min_z + 1, b.max_x - 1, b.max_z - 1]
    for k in 0..4 {
        let x = corners[usize.wrap(k * 2)]
        let z = corners[usize.wrap(k * 2 + 1)]
        if not f.is_air(try get(f, r, fr, x, b.max_y + 1, z, area)) {
            try box(f, mut r, fr, area, x, b.min_y, z, x, b.max_y, z, woods.planks, air, false)
        }
    }
    for x in b.min_x..b.max_x + 1 {
        for z in b.min_z..b.max_z + 1 {
            try planks_at(f, mut r, fr, area, woods.planks, x, b.min_y - 1, z)
        }
    }
}

// `MineShaftRoom.postProcess`: the room's floor hollowed, its entrances opened, and a dome of
// air over it.
fn room(f: Facts, r: mut Region, fr: Frame, area: Bounds, fields: List<Field>) ! Thrown {
    let air = try block_state(f, "cave_air")
    let b = fr.bb
    try box(f, mut r, fr, area, b.min_x, b.min_y + 1, b.min_z, b.max_x, (b.min_y + 3).min(b.max_y), b.max_z, air, air, false)
    for each in fields {
        if each.name != "Entrances" {
            continue
        }
        match each.value {
            Tag.List(boxes) => {
                for e in boxes {
                    match e {
                        Tag.IntArray(v) => {
                            if v.len() == 6 {
                                try box(f, mut r, fr, area, v[0], v[4] - 2, v[2], v[3], v[4], v[5], air, air, false)
                            }
                        },
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    try upper_half_sphere(f, mut r, fr, area, b.min_x, b.min_y + 4, b.min_z, b.max_x, b.max_y, b.max_z, air, false)
}
