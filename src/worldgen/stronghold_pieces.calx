/// A stronghold's pieces placed as their chunks are decorated: its stairs down, corridors,
/// turns, prison halls, crossings, libraries and the portal room, walled in stone bricks that
/// come out cracked, mossy or infested now and then, with their doors, torches, chests and the
/// silverfish spawner, each placed once.
module worldgen.stronghold_pieces

import nbt.tag.{Tag}
import random.source.{RandomSource}
import worldgen.drawing.{Frame, Selector, UPDATE_CLIENTS, block_state, blocks, boxes, chest, facing, maybe_block, maybe_box, place, select_box, with}
import worldgen.facts.{EAST, Facts, NORTH, SOUTH, WEST}
import worldgen.interval.{Thrown}
import worldgen.pieces.{Field, Piece, PieceData, flag}
import worldgen.region.{Region}
import worldgen.template.{Bounds}

// The blocks every piece is built of.
struct Stones {
    bricks: u32
    air: u32
    slab: u32
    bars: u32
    torch: u32
}

/// `postProcess` of a stronghold piece, by its type.
pub fn stronghold_piece<T: RandomSource>(f: Facts, r: mut Region, random: mut T, piece: mut Piece, area: Bounds) ! Thrown {
    let fields = match piece.data {
        PieceData.Fields(list) => list.copy(),
        _ => fail Thrown { exception: "Unimplemented", message: "a {piece.kind} piece without its fields" },
    }
    let fr = Frame.of(piece)
    let s = Stones {
        bricks: try block_state(f, "stone_bricks"),
        air: try block_state(f, "cave_air"),
        slab: try block_state(f, "smooth_stone_slab"),
        bars: try block_state(f, "iron_bars"),
        torch: try block_state(f, "wall_torch"),
    }
    let door = text_field(fields, "EntryDoor")
    let kind = piece.kind.copy()
    if kind == "minecraft:shstart" or kind == "minecraft:shsd" {
        try stairs_down(f, mut r, mut random, fr, area, s, door)
    } else if kind == "minecraft:shs" {
        try sel(f, mut r, fr, area, mut random, 0, 0, 0, 4, 4, 6, true)
        try small_door(f, mut r, fr, area, s, door, 1, 1, 0)
        try small_door(f, mut r, fr, area, s, String("OPENING"), 1, 1, 6)
        let east = try facing(f, s.torch, EAST)
        let west = try facing(f, s.torch, WEST)
        maybe_block(f, mut r, fr, area, mut random, 0.1f32, 1, 2, 1, east)
        maybe_block(f, mut r, fr, area, mut random, 0.1f32, 3, 2, 1, west)
        maybe_block(f, mut r, fr, area, mut random, 0.1f32, 1, 2, 5, east)
        maybe_block(f, mut r, fr, area, mut random, 0.1f32, 3, 2, 5, west)
        if int_field(fields, "Left") != 0 {
            try boxes(f, mut r, fr, area, [0, 1, 2, 0, 3, 4], s.air)
        }
        if int_field(fields, "Right") != 0 {
            try boxes(f, mut r, fr, area, [4, 1, 2, 4, 3, 4], s.air)
        }
    } else if kind == "minecraft:shph" {
        try prison_hall(f, mut r, mut random, fr, area, s, door)
    } else if kind == "minecraft:shlt" or kind == "minecraft:shrt" {
        try sel(f, mut r, fr, area, mut random, 0, 0, 0, 4, 4, 4, true)
        try small_door(f, mut r, fr, area, s, door, 1, 1, 0)
        // A left turn opens on its right facing south or west, a right turn on its left.
        let turned = fr.orientation != NORTH and fr.orientation != EAST
        let left = kind == "minecraft:shlt"
        if turned == left {
            try boxes(f, mut r, fr, area, [4, 1, 1, 4, 3, 3], s.air)
        } else {
            try boxes(f, mut r, fr, area, [0, 1, 1, 0, 3, 3], s.air)
        }
    } else if kind == "minecraft:shrc" {
        try room_crossing(f, mut r, mut random, fr, area, s, door, int_field(fields, "Type"))
    } else if kind == "minecraft:shssd" {
        try sel(f, mut r, fr, area, mut random, 0, 0, 0, 4, 10, 7, true)
        try small_door(f, mut r, fr, area, s, door, 1, 7, 0)
        try small_door(f, mut r, fr, area, s, String("OPENING"), 1, 1, 7)
        let stairs = try facing(f, try block_state(f, "cobblestone_stairs"), SOUTH)
        for i in 0..6 {
            blocks(f, mut r, fr, area, [1, 6 - i, 1 + i, 2, 6 - i, 1 + i, 3, 6 - i, 1 + i], stairs)
            if i < 5 {
                blocks(f, mut r, fr, area, [1, 5 - i, 1 + i, 2, 5 - i, 1 + i, 3, 5 - i, 1 + i], s.bricks)
            }
        }
    } else if kind == "minecraft:sh5c" {
        try five_crossing(f, mut r, mut random, fr, area, s, door, fields)
    } else if kind == "minecraft:shcc" {
        try sel(f, mut r, fr, area, mut random, 0, 0, 0, 4, 4, 6, true)
        try small_door(f, mut r, fr, area, s, door, 1, 1, 0)
        try small_door(f, mut r, fr, area, s, String("OPENING"), 1, 1, 6)
        try boxes(f, mut r, fr, area, [3, 1, 2, 3, 1, 4], s.bricks)
        let slab = try block_state(f, "stone_brick_slab")
        blocks(f, mut r, fr, area, [3, 1, 1, 3, 1, 5, 3, 2, 2, 3, 2, 4, 2, 1, 2, 2, 1, 3, 2, 1, 4], slab)
        if int_field(fields, "Chest") == 0 and area.inside(fr.x(3, 3), fr.y(2), fr.z(3, 3)) {
            piece.data = PieceData.Fields(with_field(fields, "Chest", flag(true)))
            _ = try chest(f, mut r, fr, area, mut random, 3, 2, 3, "minecraft:chests/stronghold_corridor")
        }
    } else if kind == "minecraft:shli" {
        try library(f, mut r, mut random, fr, area, s, door, int_field(fields, "Tall") != 0)
    } else if kind == "minecraft:shpr" {
        var placed = int_field(fields, "Mob") != 0
        try portal_room(f, mut r, mut random, fr, area, s, mut placed)
        piece.data = PieceData.Fields(with_field(fields, "Mob", flag(placed)))
    } else if kind == "minecraft:shfc" {
        for i in 0..int_field(fields, "Steps") {
            blocks(f, mut r, fr, area, [0, 0, i, 1, 0, i, 2, 0, i, 3, 0, i, 4, 0, i], s.bricks)
            for y in 1..4 {
                place(f, mut r, fr, s.bricks, 0, y, i, area)
                blocks(f, mut r, fr, area, [1, y, i, 2, y, i, 3, y, i], s.air)
                place(f, mut r, fr, s.bricks, 4, y, i, area)
            }
            blocks(f, mut r, fr, area, [0, 4, i, 1, 4, i, 2, 4, i, 3, 4, i, 4, 4, i], s.bricks)
        }
    } else {
        fail Thrown { exception: "Unimplemented", message: "placing a {kind} piece" }
    }
}

fn int_field(fields: List<Field>, name: str) -> i32 {
    for each in fields {
        if each.name == String(name) {
            return each.value.number_int() ?? 0
        }
    }
    return 0
}

fn text_field(fields: List<Field>, name: str) -> String {
    for each in fields {
        if each.name == String(name) {
            return match each.value {
                Tag.Str(text) => text.copy(),
                _ => String(),
            }
        }
    }
    return String()
}

fn with_field(fields: List<Field>, name: str, value: own Tag) -> List<Field> {
    var out = fields.copy()
    for i in 0..out.len() {
        if out[i].name == String(name) {
            out[i].value = value.copy()
        }
    }
    return out
}

// `generateBox` with `SMOOTH_STONE_SELECTOR`.
fn sel<T: RandomSource>(f: Facts, r: mut Region, fr: Frame, area: Bounds, random: mut T, x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, skip_air: bool) ! Thrown {
    try select_box(f, mut r, fr, area, mut random, x0, y0, z0, x1, y1, z1, skip_air, Selector.SmoothStone)
}

// Iron bars joined the ways given: north, east, south, west.
fn bars(f: Facts, s: Stones, north: bool, east: bool, south: bool, west: bool) -> u32 ! Thrown {
    return try joined(f, s.bars, north, east, south, west)
}

// A fence or bars joined the ways given: north, east, south, west.
fn joined(f: Facts, block: u32, north: bool, east: bool, south: bool, west: bool) -> u32 ! Thrown {
    var out = block
    if north {
        out = try f.with_bool(out, String("north"), true)
    }
    if east {
        out = try f.with_bool(out, String("east"), true)
    }
    if south {
        out = try f.with_bool(out, String("south"), true)
    }
    if west {
        out = try f.with_bool(out, String("west"), true)
    }
    return out
}

// `generateSmallDoor` of the kind its `SmallDoorType` names.
fn small_door(f: Facts, r: mut Region, fr: Frame, area: Bounds, s: Stones, kind: String, x: i32, y: i32, z: i32) ! Thrown {
    if kind == "WOOD_DOOR" or kind == "IRON_DOOR" {
        blocks(f, mut r, fr, area, [x, y, z, x, y + 1, z, x, y + 2, z, x + 1, y + 2, z, x + 2, y + 2, z, x + 2, y + 1, z, x + 2, y, z], s.bricks)
        let lower = try block_state(f, if kind == "WOOD_DOOR" { "oak_door" } else { "iron_door" })
        place(f, mut r, fr, lower, x + 1, y, z, area)
        place(f, mut r, fr, try with(f, lower, "half", "upper"), x + 1, y + 1, z, area)
        if kind == "IRON_DOOR" {
            let button = try block_state(f, "stone_button")
            place(f, mut r, fr, try facing(f, button, NORTH), x + 2, y + 1, z + 1, area)
            place(f, mut r, fr, try facing(f, button, SOUTH), x + 2, y + 1, z - 1, area)
        }
    } else if kind == "GRATES" {
        blocks(f, mut r, fr, area, [x + 1, y, z, x + 1, y + 1, z], s.air)
        let west = try bars(f, s, false, false, false, true)
        let east = try bars(f, s, false, true, false, false)
        let both = try bars(f, s, false, true, false, true)
        blocks(f, mut r, fr, area, [x, y, z, x, y + 1, z], west)
        blocks(f, mut r, fr, area, [x, y + 2, z, x + 1, y + 2, z, x + 2, y + 2, z], both)
        blocks(f, mut r, fr, area, [x + 2, y + 1, z, x + 2, y, z], east)
    } else {
        try boxes(f, mut r, fr, area, [x, y, z, x + 2, y + 2, z], s.air)
    }
}

// `StairsDown`, the start's too.
fn stairs_down<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, s: Stones, door: String) ! Thrown {
    try sel(f, mut r, fr, area, mut random, 0, 0, 0, 4, 10, 4, true)
    try small_door(f, mut r, fr, area, s, door, 1, 7, 0)
    try small_door(f, mut r, fr, area, s, String("OPENING"), 1, 1, 4)
    blocks(f, mut r, fr, area, [2, 6, 1, 1, 5, 1], s.bricks)
    place(f, mut r, fr, s.slab, 1, 6, 1, area)
    blocks(f, mut r, fr, area, [1, 5, 2, 1, 4, 3], s.bricks)
    place(f, mut r, fr, s.slab, 1, 5, 3, area)
    blocks(f, mut r, fr, area, [2, 4, 3, 3, 3, 3], s.bricks)
    place(f, mut r, fr, s.slab, 3, 4, 3, area)
    blocks(f, mut r, fr, area, [3, 3, 2, 3, 2, 1], s.bricks)
    place(f, mut r, fr, s.slab, 3, 3, 1, area)
    blocks(f, mut r, fr, area, [2, 2, 1, 1, 1, 1], s.bricks)
    place(f, mut r, fr, s.slab, 1, 2, 1, area)
    place(f, mut r, fr, s.bricks, 1, 1, 2, area)
    place(f, mut r, fr, s.slab, 1, 1, 3, area)
}

// `PrisonHall`: four cells behind bars and iron doors.
fn prison_hall<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, s: Stones, door: String) ! Thrown {
    try sel(f, mut r, fr, area, mut random, 0, 0, 0, 8, 4, 10, true)
    try small_door(f, mut r, fr, area, s, door, 1, 1, 0)
    try boxes(f, mut r, fr, area, [1, 1, 10, 3, 3, 10], s.air)
    try sel(f, mut r, fr, area, mut random, 4, 1, 1, 4, 3, 1, false)
    try sel(f, mut r, fr, area, mut random, 4, 1, 3, 4, 3, 3, false)
    try sel(f, mut r, fr, area, mut random, 4, 1, 7, 4, 3, 7, false)
    try sel(f, mut r, fr, area, mut random, 4, 1, 9, 4, 3, 9, false)
    let ns = try bars(f, s, true, false, true, false)
    let nse = try bars(f, s, true, true, true, false)
    let we = try bars(f, s, false, true, false, true)
    for y in 1..4 {
        place(f, mut r, fr, ns, 4, y, 4, area)
        place(f, mut r, fr, nse, 4, y, 5, area)
        place(f, mut r, fr, ns, 4, y, 6, area)
        blocks(f, mut r, fr, area, [5, y, 5, 6, y, 5, 7, y, 5], we)
    }
    blocks(f, mut r, fr, area, [4, 3, 2, 4, 3, 8], ns)
    let bottom = try facing(f, try block_state(f, "iron_door"), WEST)
    let top = try with(f, bottom, "half", "upper")
    place(f, mut r, fr, bottom, 4, 1, 2, area)
    place(f, mut r, fr, top, 4, 2, 2, area)
    place(f, mut r, fr, bottom, 4, 1, 8, area)
    place(f, mut r, fr, top, 4, 2, 8, area)
}

// `RoomCrossing`, of its type: a pillar with torches, a fountain, or a gallery with a chest.
fn room_crossing<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, s: Stones, door: String, kind: i32) ! Thrown {
    try sel(f, mut r, fr, area, mut random, 0, 0, 0, 10, 6, 10, true)
    try small_door(f, mut r, fr, area, s, door, 4, 1, 0)
    try boxes(f, mut r, fr, area, [4, 1, 10, 6, 3, 10, 0, 1, 4, 0, 3, 6, 10, 1, 4, 10, 3, 6], s.air)
    if kind == 0 {
        blocks(f, mut r, fr, area, [5, 1, 5, 5, 2, 5, 5, 3, 5], s.bricks)
        place(f, mut r, fr, try facing(f, s.torch, WEST), 4, 3, 5, area)
        place(f, mut r, fr, try facing(f, s.torch, EAST), 6, 3, 5, area)
        place(f, mut r, fr, try facing(f, s.torch, SOUTH), 5, 3, 4, area)
        place(f, mut r, fr, try facing(f, s.torch, NORTH), 5, 3, 6, area)
        blocks(f, mut r, fr, area, [4, 1, 4, 4, 1, 5, 4, 1, 6, 6, 1, 4, 6, 1, 5, 6, 1, 6, 5, 1, 4, 5, 1, 6], s.slab)
    } else if kind == 1 {
        for i in 0..5 {
            blocks(f, mut r, fr, area, [3, 1, 3 + i, 7, 1, 3 + i, 3 + i, 1, 3, 3 + i, 1, 7], s.bricks)
        }
        blocks(f, mut r, fr, area, [5, 1, 5, 5, 2, 5, 5, 3, 5], s.bricks)
        place(f, mut r, fr, try block_state(f, "water"), 5, 4, 5, area)
    } else if kind == 2 {
        let cobblestone = try block_state(f, "cobblestone")
        for z in 1..10 {
            blocks(f, mut r, fr, area, [1, 3, z, 9, 3, z], cobblestone)
        }
        for x in 1..10 {
            blocks(f, mut r, fr, area, [x, 3, 1, x, 3, 9], cobblestone)
        }
        blocks(f, mut r, fr, area, [5, 1, 4, 5, 1, 6, 5, 3, 4, 5, 3, 6, 4, 1, 5, 6, 1, 5, 4, 3, 5, 6, 3, 5], cobblestone)
        for y in 1..4 {
            blocks(f, mut r, fr, area, [4, y, 4, 6, y, 4, 4, y, 6, 6, y, 6], cobblestone)
        }
        place(f, mut r, fr, s.torch, 5, 3, 5, area)
        let planks = try block_state(f, "oak_planks")
        for z in 2..9 {
            blocks(f, mut r, fr, area, [2, 3, z, 3, 3, z], planks)
            if z <= 3 or z >= 7 {
                blocks(f, mut r, fr, area, [4, 3, z, 5, 3, z, 6, 3, z], planks)
            }
            blocks(f, mut r, fr, area, [7, 3, z, 8, 3, z], planks)
        }
        let ladder = try facing(f, try block_state(f, "ladder"), WEST)
        blocks(f, mut r, fr, area, [9, 1, 3, 9, 2, 3, 9, 3, 3], ladder)
        _ = try chest(f, mut r, fr, area, mut random, 3, 4, 8, "minecraft:chests/stronghold_crossing")
    }
}

// `FiveCrossing`: openings on each side as it chose, a platform with stairs of slabs.
fn five_crossing<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, s: Stones, door: String, fields: List<Field>) ! Thrown {
    try sel(f, mut r, fr, area, mut random, 0, 0, 0, 9, 8, 10, true)
    try small_door(f, mut r, fr, area, s, door, 4, 3, 0)
    if int_field(fields, "leftLow") != 0 {
        try boxes(f, mut r, fr, area, [0, 3, 1, 0, 5, 3], s.air)
    }
    if int_field(fields, "rightLow") != 0 {
        try boxes(f, mut r, fr, area, [9, 3, 1, 9, 5, 3], s.air)
    }
    if int_field(fields, "leftHigh") != 0 {
        try boxes(f, mut r, fr, area, [0, 5, 7, 0, 7, 9], s.air)
    }
    if int_field(fields, "rightHigh") != 0 {
        try boxes(f, mut r, fr, area, [9, 5, 7, 9, 7, 9], s.air)
    }
    try boxes(f, mut r, fr, area, [5, 1, 10, 7, 3, 10], s.air)
    try sel(f, mut r, fr, area, mut random, 1, 2, 1, 8, 2, 6, false)
    try sel(f, mut r, fr, area, mut random, 4, 1, 5, 4, 4, 9, false)
    try sel(f, mut r, fr, area, mut random, 8, 1, 5, 8, 4, 9, false)
    try sel(f, mut r, fr, area, mut random, 1, 4, 7, 3, 4, 9, false)
    try sel(f, mut r, fr, area, mut random, 1, 3, 5, 3, 3, 6, false)
    try boxes(f, mut r, fr, area, [1, 3, 4, 3, 3, 4, 1, 4, 6, 3, 4, 6], s.slab)
    try sel(f, mut r, fr, area, mut random, 5, 1, 7, 7, 1, 8, false)
    try boxes(f, mut r, fr, area, [5, 1, 9, 7, 1, 9, 5, 2, 7, 7, 2, 7, 4, 5, 7, 4, 5, 9, 8, 5, 7, 8, 5, 9], s.slab)
    try boxes(f, mut r, fr, area, [5, 5, 7, 7, 5, 9], try with(f, s.slab, "type", "double"))
    place(f, mut r, fr, try facing(f, s.torch, SOUTH), 6, 5, 6, area)
}

// `Library`: shelves along the walls and in rows, a chest, and if it's tall a gallery with a
// chandelier, a ladder up and a second chest.
fn library<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, s: Stones, door: String, tall: bool) ! Thrown {
    let height = if tall { 11 } else { 6 }
    try sel(f, mut r, fr, area, mut random, 0, 0, 0, 13, height - 1, 14, true)
    try small_door(f, mut r, fr, area, s, door, 4, 1, 0)
    let cobweb = try block_state(f, "cobweb")
    try maybe_box(f, mut r, fr, area, mut random, 0.07f32, 2, 1, 1, 11, 4, 13, cobweb, cobweb, false, false)
    let planks = try block_state(f, "oak_planks")
    let shelf = try block_state(f, "bookshelf")
    let east = try facing(f, s.torch, EAST)
    let west = try facing(f, s.torch, WEST)
    for d in 1..14 {
        if (d - 1) % 4 == 0 {
            try boxes(f, mut r, fr, area, [1, 1, d, 1, 4, d, 12, 1, d, 12, 4, d], planks)
            place(f, mut r, fr, east, 2, 3, d, area)
            place(f, mut r, fr, west, 11, 3, d, area)
            if tall {
                try boxes(f, mut r, fr, area, [1, 6, d, 1, 9, d, 12, 6, d, 12, 9, d], planks)
            }
        } else {
            try boxes(f, mut r, fr, area, [1, 1, d, 1, 4, d, 12, 1, d, 12, 4, d], shelf)
            if tall {
                try boxes(f, mut r, fr, area, [1, 6, d, 1, 9, d, 12, 6, d, 12, 9, d], shelf)
            }
        }
    }
    var d = 3
    while d < 12 {
        try boxes(f, mut r, fr, area, [3, 1, d, 4, 3, d, 6, 1, d, 7, 3, d, 9, 1, d, 10, 3, d], shelf)
        d += 2
    }
    if tall {
        try boxes(f, mut r, fr, area, [1, 5, 1, 3, 5, 13, 10, 5, 1, 12, 5, 13, 4, 5, 1, 9, 5, 2, 4, 5, 12, 9, 5, 13], planks)
        blocks(f, mut r, fr, area, [9, 5, 11, 8, 5, 11, 9, 5, 10], planks)
        let fence = try block_state(f, "oak_fence")
        let we = try joined(f, fence, false, true, false, true)
        let ns = try joined(f, fence, true, false, true, false)
        try boxes(f, mut r, fr, area, [3, 6, 3, 3, 6, 11, 10, 6, 3, 10, 6, 9], ns)
        try boxes(f, mut r, fr, area, [4, 6, 2, 9, 6, 2, 4, 6, 12, 7, 6, 12], we)
        place(f, mut r, fr, try joined(f, fence, true, true, false, false), 3, 6, 2, area)
        place(f, mut r, fr, try joined(f, fence, false, true, true, false), 3, 6, 12, area)
        place(f, mut r, fr, try joined(f, fence, true, false, false, true), 10, 6, 2, area)
        let south_west = try joined(f, fence, false, false, true, true)
        let north_east = try joined(f, fence, true, true, false, false)
        for i in 0..3 {
            place(f, mut r, fr, south_west, 8 + i, 6, 12 - i, area)
            if i != 2 {
                place(f, mut r, fr, north_east, 8 + i, 6, 11 - i, area)
            }
        }
        let ladder = try facing(f, try block_state(f, "ladder"), SOUTH)
        for y in 1..8 {
            place(f, mut r, fr, ladder, 10, y, 13, area)
        }
        let e = try joined(f, fence, false, true, false, false)
        let w = try joined(f, fence, false, false, false, true)
        place(f, mut r, fr, e, 6, 9, 7, area)
        place(f, mut r, fr, w, 7, 9, 7, area)
        place(f, mut r, fr, e, 6, 8, 7, area)
        place(f, mut r, fr, w, 7, 8, 7, area)
        let all = try joined(f, fence, true, true, true, true)
        blocks(f, mut r, fr, area, [6, 7, 7, 7, 7, 7], all)
        place(f, mut r, fr, e, 5, 7, 7, area)
        place(f, mut r, fr, w, 8, 7, 7, area)
        place(f, mut r, fr, try joined(f, fence, true, true, false, false), 6, 7, 6, area)
        place(f, mut r, fr, try joined(f, fence, false, true, true, false), 6, 7, 8, area)
        place(f, mut r, fr, try joined(f, fence, true, false, false, true), 7, 7, 6, area)
        place(f, mut r, fr, try joined(f, fence, false, false, true, true), 7, 7, 8, area)
        blocks(f, mut r, fr, area, [5, 8, 7, 8, 8, 7, 6, 8, 6, 6, 8, 8, 7, 8, 6, 7, 8, 8], try block_state(f, "torch"))
    }
    _ = try chest(f, mut r, fr, area, mut random, 3, 3, 5, "minecraft:chests/stronghold_library")
    if tall {
        place(f, mut r, fr, s.air, 12, 9, 1, area)
        _ = try chest(f, mut r, fr, area, mut random, 12, 8, 1, "minecraft:chests/stronghold_library")
    }
}

// `PortalRoom`: lava, the stairs up to the portal's frame with each eye in it one time in ten,
// the portal if they're all there, and the silverfish spawner once.
fn portal_room<T: RandomSource>(f: Facts, r: mut Region, random: mut T, fr: Frame, area: Bounds, s: Stones, placed: mut bool) ! Thrown {
    try sel(f, mut r, fr, area, mut random, 0, 0, 0, 10, 7, 15, false)
    try small_door(f, mut r, fr, area, s, String("GRATES"), 4, 1, 0)
    try sel(f, mut r, fr, area, mut random, 1, 6, 1, 1, 6, 14, false)
    try sel(f, mut r, fr, area, mut random, 9, 6, 1, 9, 6, 14, false)
    try sel(f, mut r, fr, area, mut random, 2, 6, 1, 8, 6, 2, false)
    try sel(f, mut r, fr, area, mut random, 2, 6, 14, 8, 6, 14, false)
    try sel(f, mut r, fr, area, mut random, 1, 1, 1, 2, 1, 4, false)
    try sel(f, mut r, fr, area, mut random, 8, 1, 1, 9, 1, 4, false)
    let lava = try block_state(f, "lava")
    try boxes(f, mut r, fr, area, [1, 1, 1, 1, 1, 3, 9, 1, 1, 9, 1, 3], lava)
    try sel(f, mut r, fr, area, mut random, 3, 1, 8, 7, 1, 12, false)
    try boxes(f, mut r, fr, area, [4, 1, 9, 6, 1, 11], lava)
    let ns = try bars(f, s, true, false, true, false)
    let we = try bars(f, s, false, true, false, true)
    var z = 3
    while z < 14 {
        try boxes(f, mut r, fr, area, [0, 3, z, 0, 4, z, 10, 3, z, 10, 4, z], ns)
        z += 2
    }
    var x = 2
    while x < 9 {
        try boxes(f, mut r, fr, area, [x, 3, 15, x, 4, 15], we)
        x += 2
    }
    let stairs = try facing(f, try block_state(f, "stone_brick_stairs"), NORTH)
    try sel(f, mut r, fr, area, mut random, 4, 1, 5, 6, 1, 7, false)
    try sel(f, mut r, fr, area, mut random, 4, 2, 6, 6, 2, 7, false)
    try sel(f, mut r, fr, area, mut random, 4, 3, 7, 6, 3, 7, false)
    for sx in 4..7 {
        blocks(f, mut r, fr, area, [sx, 1, 4, sx, 2, 5, sx, 3, 6], stairs)
    }
    var eyes = List<bool>()
    var all = true
    for _ in 0..12 {
        let eye = random.next_float() > 0.9f32
        eyes.push(eye)
        all = all and eye
    }
    let frame = try block_state(f, "end_portal_frame")
    // Each frame block: where it is and the way it faces, in the order vanilla places them.
    let at: List<i32> = [4, 3, 8, 5, 3, 8, 6, 3, 8, 4, 3, 12, 5, 3, 12, 6, 3, 12, 3, 3, 9, 3, 3, 10, 3, 3, 11, 7, 3, 9, 7, 3, 10, 7, 3, 11]
    let ways: List<i32> = [NORTH, NORTH, NORTH, SOUTH, SOUTH, SOUTH, EAST, EAST, EAST, WEST, WEST, WEST]
    for i in 0..ways.len() {
        let state = try f.with_bool(try facing(f, frame, ways[i]), String("eye"), eyes[i])
        place(f, mut r, fr, state, at[i * 3], at[i * 3 + 1], at[i * 3 + 2], area)
    }
    if all {
        blocks(f, mut r, fr, area, [4, 3, 9, 5, 3, 9, 6, 3, 9, 4, 3, 10, 5, 3, 10, 6, 3, 10, 4, 3, 11, 5, 3, 11, 6, 3, 11], try block_state(f, "end_portal"))
    }
    if not placed {
        let wx = fr.x(5, 6)
        let wy = fr.y(3)
        let wz = fr.z(5, 6)
        if area.inside(wx, wy, wz) {
            placed = true
            _ = r.set_block(f, wx, wy, wz, try block_state(f, "spawner"), UPDATE_CLIENTS)
            if let kind = try r.block_entity(f, wx, wy, wz) {
                if kind == "minecraft:mob_spawner" {
                    r.set_spawner_entity(wx, wy, wz, String("minecraft:silverfish"))
                }
            }
        }
    }
}
