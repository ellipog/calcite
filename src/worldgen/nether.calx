/// The Nether's features: huge fungi with their weeping vines, blocks spread beside their kind
/// (glowstone, vines), basalt deltas, blobs replacing netherrack, and stepped basalt columns,
/// read as their codecs read them and placed as 26.3 places them.
module worldgen.nether

import json.tree.{Member}
import pack.zip.{Zip}
import random.source.{RandomSource}
import worldgen.codec.{bool_of, field}
import worldgen.facts.{BlockSet, Facts, UP, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.predicates.{Pred, Readers, read_blocks, read_pred, read_state, test}
import worldgen.providers.{IntProvider, int_provider_field, next_in}
import worldgen.region.{Region}
import worldgen.state_providers.{Providers, get_state}
import worldgen.survive.{Env}

/// A `huge_fungus`.
pub struct HugeFungus {
    base: u32
    stem: u32
    hat: u32
    decor: u32
    replaceable: Pred
    planted: bool
}

/// A `random_neighbor_spread`.
pub struct NeighborSpread {
    block: usize
    accepted: BlockSet
    can_replace: Pred
    attempts: IntProvider
    xz: IntProvider
    y: IntProvider
}

/// A `delta_feature`.
pub struct Delta {
    contents: u32
    rim: u32
    size: IntProvider
    rim_size: IntProvider
}

/// A `netherrack_replace_blobs`.
pub struct ReplaceBlobs {
    target: u32
    state: u32
    radius: IntProvider
}

/// A `stepped_column_cluster`.
pub struct SteppedColumns {
    block: usize
    continue_through: Pred
    can_replace: Pred
    cannot_place_on: BlockSet
    cluster_reach: IntProvider
    count: IntProvider
    column_reach: IntProvider
    height: IntProvider
}

fn state_field(f: Facts, m: List<Member>, key: str) -> u32 ! String {
    let v = field(m, key) else fail "No key {key} in MapLike"
    return try read_state(f, v)
}

fn pred_field(f: Facts, rd: Readers, m: List<Member>, key: str) -> Pred ! String {
    let v = field(m, key) else fail "No key {key} in MapLike"
    return try read_pred(f, rd, v)
}

fn provider_field(ps: mut Providers, zip: Zip, f: Facts, rd: Readers, m: List<Member>, key: str) -> usize ! String {
    let v = field(m, key) else fail "No key {key} in MapLike"
    return try ps.read(zip, f, rd, v)
}

fn blocks_field(f: Facts, rd: Readers, m: List<Member>, key: str) -> BlockSet ! String {
    let v = field(m, key) else fail "No key {key} in MapLike"
    return try read_blocks(f, rd.blocks, v)
}

pub fn read_huge_fungus(f: Facts, rd: Readers, m: List<Member>) -> HugeFungus ! String {
    var planted = false
    let base = try state_field(f, m, "valid_base_block")
    let stem = try state_field(f, m, "stem_state")
    let hat = try state_field(f, m, "hat_state")
    let decor = try state_field(f, m, "decor_state")
    let replaceable = try pred_field(f, rd, m, "replaceable_blocks")
    if let v = field(m, "planted") {
        planted = try bool_of(v)
    }
    return HugeFungus { base: base, stem: stem, hat: hat, decor: decor, replaceable: replaceable, planted: planted }
}

pub fn read_neighbor_spread(ps: mut Providers, zip: Zip, f: Facts, rd: Readers, m: List<Member>) -> NeighborSpread ! String {
    return NeighborSpread {
        block: try provider_field(mut ps, zip, f, rd, m, "block"),
        accepted: try blocks_field(f, rd, m, "accepted_neighbors"),
        can_replace: try pred_field(f, rd, m, "can_replace"),
        attempts: try int_provider_field(m, "attempts", 1, 3000),
        xz: try int_provider_field(m, "xz_offset", -16, 16),
        y: try int_provider_field(m, "y_offset", -16, 16),
    }
}

pub fn read_delta(f: Facts, m: List<Member>) -> Delta ! String {
    return Delta {
        contents: try state_field(f, m, "contents"),
        rim: try state_field(f, m, "rim"),
        size: try int_provider_field(m, "size", 0, 16),
        rim_size: try int_provider_field(m, "rim_size", 0, 16),
    }
}

pub fn read_replace_blobs(f: Facts, m: List<Member>) -> ReplaceBlobs ! String {
    return ReplaceBlobs {
        target: try state_field(f, m, "target"),
        state: try state_field(f, m, "state"),
        radius: try int_provider_field(m, "radius", 0, 12),
    }
}

pub fn read_stepped_columns(ps: mut Providers, zip: Zip, f: Facts, rd: Readers, m: List<Member>) -> SteppedColumns ! String {
    return SteppedColumns {
        block: try provider_field(mut ps, zip, f, rd, m, "block"),
        continue_through: try pred_field(f, rd, m, "continue_through"),
        can_replace: try pred_field(f, rd, m, "can_replace"),
        cannot_place_on: try blocks_field(f, rd, m, "cannot_place_on"),
        cluster_reach: try int_provider_field(m, "cluster_reach", 0, 13),
        count: try int_provider_field(m, "column_count", 1, 150),
        column_reach: try int_provider_field(m, "column_reach", 0, 3),
        height: try int_provider_field(m, "height", 1, 10),
    }
}

// Huge fungi.

/// `HugeFungusFeature.place`.
pub fn place_huge_fungus<T: RandomSource>(e: Env, gen_depth: i32, r: mut Region, rand: mut T, h: HugeFungus, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if not f.is(try r.state(f, x, y - 1, z), f.block(h.base)) {
        return false
    }
    var height = try next_in(mut rand, 4, 13)
    if rand.next_int_below(12) == 0 {
        height *= 2
    }
    if not h.planted and y + height + 1 >= gen_depth {
        return false
    }
    let huge = not h.planted and rand.next_float() < 0.06f32
    _ = r.set_block(f, x, y, z, f.ids.air_state, 260)
    // `placeStem`.
    let stem_radius = if huge { 1 } else { 0 }
    for dx in -stem_radius..stem_radius + 1 {
        for dz in -stem_radius..stem_radius + 1 {
            let corner = huge and dx.abs() == stem_radius and dz.abs() == stem_radius
            for dy in 0..height {
                let px = x + dx
                let py = y + dy
                let pz = z + dz
                if try fungus_replaceable(e, r, h, px, py, pz, true) {
                    if h.planted {
                        try destroy(f, mut r, px, py, pz)
                        _ = r.set_block(f, px, py, pz, h.stem, 3)
                    } else if corner {
                        if rand.next_float() < 0.1f32 {
                            _ = r.set_block(f, px, py, pz, h.stem, 3)
                        }
                    } else {
                        _ = r.set_block(f, px, py, pz, h.stem, 3)
                    }
                }
            }
        }
    }
    // `placeHat`.
    let vines = f.is(h.hat, try f.named_block("nether_wart_block"))
    let hat_height = (rand.next_int_below(1 + height / 3) + 5).min(height)
    let start = height - hat_height
    for dy in start..height + 1 {
        var radius = if dy < height - rand.next_int_below(3) { 2 } else { 1 }
        if hat_height > 8 and dy < start + 4 {
            radius = 3
        }
        if huge {
            radius += 1
        }
        for dx in -radius..radius + 1 {
            for dz in -radius..radius + 1 {
                let edge_x = dx == -radius or dx == radius
                let edge_z = dz == -radius or dz == radius
                let inside = not edge_x and not edge_z and dy != height
                let corner = edge_x and edge_z
                let bottom = dy < start + 3
                let px = x + dx
                let py = y + dy
                let pz = z + dz
                if try fungus_replaceable(e, r, h, px, py, pz, false) {
                    if h.planted and not f.is_air(try r.state(f, px, py - 1, pz)) {
                        try destroy(f, mut r, px, py, pz)
                    }
                    if bottom {
                        if not inside {
                            // `placeHatDropBlock`.
                            if f.is(try r.state(f, px, py - 1, pz), f.block(h.hat)) {
                                _ = r.set_block(f, px, py, pz, h.hat, 3)
                            } else if f64(rand.next_float()) < 0.15 {
                                _ = r.set_block(f, px, py, pz, h.hat, 3)
                                if vines and rand.next_int_below(11) == 0 {
                                    try weeping_vines(f, mut r, mut rand, px, py, pz)
                                }
                            }
                        }
                    } else if inside {
                        try hat_block(f, mut r, mut rand, h, px, py, pz, 0.1f32, 0.2f32, if vines { 0.1f32 } else { 0.0f32 })
                    } else if corner {
                        try hat_block(f, mut r, mut rand, h, px, py, pz, 0.01f32, 0.7f32, if vines { 0.083f32 } else { 0.0f32 })
                    } else {
                        try hat_block(f, mut r, mut rand, h, px, py, pz, 0.0005f32, 0.98f32, if vines { 0.07f32 } else { 0.0f32 })
                    }
                }
            }
        }
    }
    return true
}

// `HugeFungusFeature.isReplaceable`: a block that can be replaced, or for the stem one of the
// plants the fungus may.
fn fungus_replaceable(e: Env, r: Region, h: HugeFungus, x: i32, y: i32, z: i32, plants: bool) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if f.replaceable(try r.state(f, x, y, z)) {
        return true
    }
    return plants and try test(e, r, h.replaceable, x, y, z)
}

// `WorldGenRegion.destroyBlock`: air where the block isn't, with nothing dropped.
fn destroy(f: Facts, r: mut Region, x: i32, y: i32, z: i32) ! Thrown {
    if not f.is_air(try r.state(f, x, y, z)) {
        _ = r.set_block(f, x, y, z, f.ids.air_state, 3)
    }
}

// `placeHatBlock`.
fn hat_block<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, h: HugeFungus, x: i32, y: i32, z: i32, decor: f32, hat: f32, vines: f32) ! Thrown {
    if rand.next_float() < decor {
        _ = r.set_block(f, x, y, z, h.decor, 3)
    } else if rand.next_float() < hat {
        _ = r.set_block(f, x, y, z, h.hat, 3)
        if rand.next_float() < vines {
            try weeping_vines(f, mut r, mut rand, x, y, z)
        }
    }
}

// `tryPlaceWeepingVines`: a column of weeping vines under the hat block, if there's air.
fn weeping_vines<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, x: i32, y: i32, z: i32) ! Thrown {
    if not f.is_air(try r.state(f, x, y - 1, z)) {
        return
    }
    var goal = try next_in(mut rand, 1, 5)
    if rand.next_int_below(7) == 0 {
        goal *= 2
    }
    let head = try f.named_block("weeping_vines")
    let plant = f.default_state(try f.named_block("weeping_vines_plant"))
    var py = y - 1
    for height in 0..goal + 1 {
        if f.is_air(try r.state(f, x, py, z)) {
            if height == goal or not f.is_air(try r.state(f, x, py - 1, z)) {
                let age = try next_in(mut rand, 23, 25)
                _ = r.set_block(f, x, py, z, try f.with_int(f.default_state(head), "age", age), 2)
                break
            }
            _ = r.set_block(f, x, py, z, plant, 2)
        }
        py -= 1
    }
}

// Neighbour spread.

/// `RandomNeighborSpreadFeature.place`.
pub fn place_neighbor_spread<T: RandomSource>(e: Env, ps: Providers, r: mut Region, rand: mut T, n: NeighborSpread, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let first = try get_state(e, ps, r, mut rand, n.block, x, y, z)
    _ = r.set_block(f, x, y, z, first, 2)
    let attempts = try n.attempts.sample(mut rand)
    for _ in 0..attempts {
        let px = x + try n.xz.sample(mut rand)
        let py = y + try n.y.sample(mut rand)
        let pz = z + try n.xz.sample(mut rand)
        if try test(e, r, n.can_replace, px, py, pz) {
            var neighbours = 0
            for d in 0..6 {
                if f.in_set(try r.state(f, px + step_x(d), py + step_y(d), pz + step_z(d)), n.accepted) {
                    neighbours += 1
                }
                if neighbours > 1 {
                    break
                }
            }
            if neighbours == 1 {
                let s = try get_state(e, ps, r, mut rand, n.block, px, py, pz)
                _ = r.set_block(f, px, py, pz, s, 2)
            }
        }
    }
    return true
}

// Deltas and blobs.

/// `BlockPos.withinBoxByManhattanDistance`'s offsets, as `x, y, z` in a row each, in its order:
/// by distance out to `depth`, then `x`, then `y`, each `z` and then its mirror.
pub fn manhattan_box(rx: i32, ry: i32, rz: i32, depth: i32) -> List<i32> {
    var out = List<i32>()
    for d in 0..depth + 1 {
        let max_x = rx.min(d)
        for dx in -max_x..max_x + 1 {
            let max_y = ry.min(d - dx.abs())
            for dy in -max_y..max_y + 1 {
                let dz = d - dx.abs() - dy.abs()
                if dz <= rz {
                    out.push(dx)
                    out.push(dy)
                    out.push(dz)
                    if dz != 0 {
                        out.push(dx)
                        out.push(dy)
                        out.push(-dz)
                    }
                }
            }
        }
    }
    return out
}

/// `DeltaFeature.place`.
pub fn place_delta<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, d: Delta, x: i32, y: i32, z: i32) -> bool ! Thrown {
    var any = false
    let spawn_rim = rand.next_double() < 0.9
    let rim_x = if spawn_rim { try d.rim_size.sample(mut rand) } else { 0 }
    let rim_z = if spawn_rim { try d.rim_size.sample(mut rand) } else { 0 }
    let has_rim = spawn_rim and rim_x != 0 and rim_z != 0
    let radius_x = try d.size.sample(mut rand)
    let radius_z = try d.size.sample(mut rand)
    let limit = radius_x.max(radius_z)
    let offsets = manhattan_box(radius_x, 0, radius_z, limit.min(radius_x + radius_z))
    var i = 0usize
    while i < offsets.len() {
        let px = x + offsets[i]
        let py = y + offsets[i + 1]
        let pz = z + offsets[i + 2]
        i += 3
        if try delta_clear(f, r, d, px, py, pz) {
            if has_rim {
                any = true
                _ = r.set_block(f, px, py, pz, d.rim, 3)
            }
            if try delta_clear(f, r, d, px + rim_x, py, pz + rim_z) {
                any = true
                _ = r.set_block(f, px + rim_x, py, pz + rim_z, d.contents, 3)
            }
        }
    }
    return any
}

// `DeltaFeature.isClear`: not the contents or a block deltas keep off, air above and nothing but
// air not around it.
fn delta_clear(f: Facts, r: Region, d: Delta, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let s = try r.state(f, x, y, z)
    if f.is(s, f.block(d.contents)) {
        return false
    }
    let b = f.block(s)
    for name in ["bedrock", "nether_bricks", "nether_brick_fence", "nether_brick_stairs", "nether_wart", "chest", "spawner"] {
        if b == try f.named_block(String(name)) {
            return false
        }
    }
    for dd in 0..6 {
        let air = f.is_air(try r.state(f, x + step_x(dd), y + step_y(dd), z + step_z(dd)))
        if (air and dd != UP) or (not air and dd == UP) {
            return false
        }
    }
    return true
}

/// `ReplaceBlobsFeature.place`.
pub fn place_replace_blobs<T: RandomSource>(f: Facts, r: mut Region, rand: mut T, b: ReplaceBlobs, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let target = f.block(b.target)
    let max_y = r.min_y + r.height - 1
    var cy = y
    if cy < r.min_y + 1 {
        cy = r.min_y + 1
    } else if cy > max_y {
        cy = max_y
    }
    // `findTarget`.
    var found = false
    while cy > r.min_y + 1 {
        if f.is(try r.state(f, x, cy, z), target) {
            found = true
            break
        }
        cy -= 1
    }
    if not found {
        return false
    }
    let rx = try b.radius.sample(mut rand)
    let ry = try b.radius.sample(mut rand)
    let rz = try b.radius.sample(mut rand)
    let limit = rx.max(ry.max(rz))
    let offsets = manhattan_box(rx, ry, rz, limit.min(rx + ry + rz))
    var any = false
    var i = 0usize
    while i < offsets.len() {
        let px = x + offsets[i]
        let py = cy + offsets[i + 1]
        let pz = z + offsets[i + 2]
        i += 3
        if f.is(try r.state(f, px, py, pz), target) {
            _ = r.set_block(f, px, py, pz, b.state, 3)
            any = true
        }
    }
    return any
}

// Basalt columns.

/// `SteppedColumnClusterFeature.place`.
pub fn place_stepped_columns<T: RandomSource>(e: Env, ps: Providers, r: mut Region, rand: mut T, c: SteppedColumns, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not try column_can_place(e, r, c, x, y, z) {
        return false
    }
    let height = try c.height.sample(mut rand)
    let reach = height.min(try c.cluster_reach.sample(mut rand))
    let count = try c.count.sample(mut rand)
    var placed = false
    let width = reach * 2 + 1
    for _ in 0..count {
        // `BlockPos.randomBetweenClosed`, drawn as each is reached.
        let px = x - reach + rand.next_int_below(width)
        let py = y + rand.next_int_below(1)
        let pz = z - reach + rand.next_int_below(width)
        let to_place = height - ((px - x).abs() + (py - y).abs() + (pz - z).abs())
        if to_place >= 0 {
            let column_reach = try c.column_reach.sample(mut rand)
            if try place_column(e, ps, mut r, mut rand, c, px, py, pz, to_place, column_reach) {
                placed = true
            }
        }
    }
    return placed
}

// `placeColumn`.
fn place_column<T: RandomSource>(e: Env, ps: Providers, r: mut Region, rand: mut T, c: SteppedColumns, x: i32, y: i32, z: i32, height: i32, reach: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    var any = false
    for pz in z - reach..z + reach + 1 {
        for px in x - reach..x + reach + 1 {
            let step_limit = (px - x).abs() + (pz - z).abs()
            var found: i32? = none
            if try test(e, r, c.can_replace, px, y, pz) {
                // `findSurface`.
                var cy = y
                var limit = step_limit
                while cy > r.min_y + 1 and limit > 0 {
                    limit -= 1
                    if try column_can_place(e, r, c, px, cy, pz) {
                        found = some(cy)
                        break
                    }
                    cy -= 1
                }
            } else {
                // `findAir`.
                var cy = y
                var limit = step_limit
                while cy <= r.min_y + r.height - 1 and limit > 0 {
                    limit -= 1
                    let s = try r.state(f, px, cy, pz)
                    if f.in_set(s, c.cannot_place_on) {
                        break
                    }
                    if f.is_air(s) {
                        found = some(cy)
                        break
                    }
                    cy += 1
                }
            }
            if let start = found {
                var blocks = height - step_limit / 2
                var cy = start
                while blocks >= 0 {
                    if try test(e, r, c.can_replace, px, cy, pz) {
                        let s = try get_state(e, ps, r, mut rand, c.block, px, cy, pz)
                        _ = r.set_block(f, px, cy, pz, s, 3)
                        cy += 1
                        any = true
                    } else {
                        if not try test(e, r, c.continue_through, px, cy, pz) {
                            break
                        }
                        cy += 1
                    }
                    blocks -= 1
                }
            }
        }
    }
    return any
}

// `canPlaceAt`: replaceable, on a block that isn't air or one columns can't stand on.
fn column_can_place(e: Env, r: Region, c: SteppedColumns, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if not try test(e, r, c.can_replace, x, y, z) {
        return false
    }
    let below = try r.state(f, x, y - 1, z)
    return not f.is_air(below) and not f.in_set(below, c.cannot_place_on)
}
