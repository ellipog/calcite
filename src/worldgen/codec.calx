/// Worldgen's data as vanilla's codecs read it from JSON, through DataFixerUpper's `JsonOps`: the
/// fields of a map, the numbers, booleans and identifiers in them, and the ranges codecs check.
/// Errors carry this reader's own message: callers compare only that a value doesn't read, as the
/// rig's probes do, since DataFixerUpper's messages are made for a person to read.
module worldgen.codec

import json.gson.{int_value}
import json.tree.{Json, Member, as_string, get}
import resources.identifier.{Identifier}

/// The value of the last member named `key`, a JSON null being no value, as `JsonOps` reads a
/// map.
pub fn field(members: List<Member>, key: str) -> Json? {
    let value = get(members, String(key)) else return none
    match value {
        Json.Null => return none,
        _ => {},
    }
    return some(value)
}

/// The members of a map, or an error for anything else.
pub fn map_of(value: Json) -> List<Member> ! String {
    match value {
        Json.Object(members) => return members.copy(),
        _ => {},
    }
    fail "Not a map: {value}"
}

/// A dispatched type, `type`: an identifier, with its namespace.
pub fn type_of(members: List<Member>) -> String ! String {
    let value = field(members, "type") else fail "No key type in MapLike"
    let text = as_string(value) else fail "Not a string: {value}"
    let id = try Identifier.parse(text)
    return id.to_string()
}

/// `Identifier.CODEC` of the field `key`, with its namespace.
pub fn identifier_field(members: List<Member>, key: str) -> String ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    let text = as_string(value) else fail "Not a string: {value}"
    let id = try Identifier.parse(text)
    return id.to_string()
}

/// `Codec.INT`: a number's `intValue`, or a boolean's 1 or 0.
pub fn int_of(value: Json) -> i32 ! String {
    match value {
        Json.Number(text) => {
            let v = int_value(text) else fail "Not a number: {text}"
            return v
        },
        Json.Bool(b) => return if b { 1 } else { 0 },
        _ => {},
    }
    fail "Not a number: {value}"
}

pub fn int_field(members: List<Member>, key: str) -> i32 ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try int_of(value)
}

/// `Codec.intRange(low, high)` of the field `key`.
pub fn int_range_field(members: List<Member>, key: str, low: i32, high: i32) -> i32 ! String {
    let v = try int_field(members, key)
    if v < low or v > high {
        fail "Value {v} outside of range [{low}:{high}]"
    }
    return v
}

/// `Codec.BOOL`: a boolean, or a number whose `byteValue` isn't 0.
pub fn bool_of(value: Json) -> bool ! String {
    match value {
        Json.Bool(b) => return b,
        Json.Number(text) => {
            let v = int_value(text) else fail "Not a number: {text}"
            return (v & 0xFF) != 0
        },
        _ => {},
    }
    fail "Not a boolean: {value}"
}

pub fn bool_field(members: List<Member>, key: str) -> bool ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try bool_of(value)
}

/// `Codec.BOOL.optionalFieldOf(key, otherwise)`: a value that's there must read.
pub fn optional_bool_field(members: List<Member>, key: str, otherwise: bool) -> bool ! String {
    let value = field(members, key) else return otherwise
    return try bool_of(value)
}

/// `Codec.DOUBLE`: a number's `doubleValue`, or a boolean's 1 or 0.
pub fn double_of(value: Json) -> f64 ! String {
    match value {
        Json.Number(text) => {
            let v = f64.parse(text) else fail "Not a number: {text}"
            return v
        },
        Json.Bool(b) => return if b { 1.0 } else { 0.0 },
        _ => {},
    }
    fail "Not a number: {value}"
}

pub fn double_field(members: List<Member>, key: str) -> f64 ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try double_of(value)
}

/// `Codec.FLOAT`: a number's `floatValue`, or a boolean's 1 or 0.
pub fn float_of(value: Json) -> f32 ! String {
    match value {
        Json.Number(text) => {
            let v = f32.parse(text) else fail "Not a number: {text}"
            return v
        },
        Json.Bool(b) => return if b { 1.0f32 } else { 0.0f32 },
        _ => {},
    }
    fail "Not a number: {value}"
}

pub fn float_field(members: List<Member>, key: str) -> f32 ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try float_of(value)
}

/// `Codec.floatRange(low, high)`, which compares as `Float.compareTo` does: -0 is below 0, and
/// NaN above everything.
pub fn float_range(value: Json, low: f32, high: f32) -> f32 ! String {
    let v = try float_of(value)
    if float_compare(v, low) < 0 or float_compare(v, high) > 0 {
        fail "Value {v} outside of range [{low}:{high}]"
    }
    return v
}

pub fn float_range_field(members: List<Member>, key: str, low: f32, high: f32) -> f32 ! String {
    let value = field(members, key) else fail "No key {key} in MapLike"
    return try float_range(value, low, high)
}

/// `Float.compare`: by value, then -0 below 0 and every NaN equal and above everything.
pub fn float_compare(a: f32, b: f32) -> i32 {
    if a < b {
        return -1
    }
    if a > b {
        return 1
    }
    let x = float_bits(a)
    let y = float_bits(b)
    return if x == y { 0 } else if x < y { -1 } else { 1 }
}

/// `Float.floatToIntBits`: the bits, with every NaN as `0x7fc00000`.
fn float_bits(v: f32) -> i32 {
    if v != v {
        return 0x7fc00000
    }
    return i32.wrap(v.to_bits())
}
