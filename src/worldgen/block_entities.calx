/// What block entities save, as `BlockEntity.saveAdditional` writes it for each type: for a
/// fresh one, and for one loaded from data by `loadWithComponents`, as a structure template
/// loads what it places. A field read with a default is written back with its type; what a type
/// keeps through a codec (patterns, sign text, a vault's data, a sensor's listener) is kept as
/// the data had it. Items are read with vanilla's codecs, `registry.components.ItemCodecs`
/// (D367). A type, or a part of one, Calcite doesn't know yet is `none`.
module worldgen.block_entities

import chat.component.{Component}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.components.{ItemCodecs}
import resources.identifier.{Identifier}

/// The containers that keep a loot table and its seed in place of their items until opened:
/// `RandomizableContainer`.
pub fn randomizable(kind: String) -> bool {
    let kinds: List<str> = ["barrel", "chest", "trapped_chest", "crafter", "dispenser", "dropper", "hopper", "shulker_box", "decorated_pot"]
    for k in kinds {
        if kind == "minecraft:{k}" {
            return true
        }
    }
    return false
}

// The containers that save their items, or their loot table, and a lock and name.
fn container(kind: String) -> bool {
    let kinds: List<str> = ["barrel", "chest", "trapped_chest", "dispenser", "dropper", "hopper", "shulker_box"]
    for k in kinds {
        if kind == "minecraft:{k}" {
            return true
        }
    }
    return false
}

fn furnace(kind: String) -> bool {
    return kind == "minecraft:furnace" or kind == "minecraft:blast_furnace" or kind == "minecraft:smoker"
}

/// What a fresh block entity of the type saves.
pub fn fresh(kind: String) -> JavaHashMap<String, Tag>? {
    var t = JavaHashMap<String, Tag>()
    if container(kind) {
        // `saveAllItems`, which a shulker box asks not to write with none.
        if kind != "minecraft:shulker_box" {
            t.insert("Items", Tag.List([]))
        }
        if kind == "minecraft:hopper" {
            t.insert("TransferCooldown", Tag.Int(-1))
        }
        return some(t)
    }
    if furnace(kind) {
        t.insert("cooking_time_spent", Tag.Int(0))
        t.insert("cooking_total_time", Tag.Int(0))
        t.insert("lit_time_remaining", Tag.Int(0))
        t.insert("lit_total_time", Tag.Int(0))
        t.insert("speed_multiplier", Tag.Float(1.0f32))
        t.insert("Items", Tag.List([]))
        t.insert("RecipesUsed", Tag.Compound(JavaHashMap<String, Tag>()))
        return some(t)
    }
    if kind == "minecraft:campfire" {
        t.insert("Items", Tag.List([]))
        t.insert("CookingTimes", Tag.IntArray([0, 0, 0, 0]))
        t.insert("CookingTotalTimes", Tag.IntArray([0, 0, 0, 0]))
        return some(t)
    }
    if kind == "minecraft:brewing_stand" {
        t.insert("BrewTime", Tag.Int(0))
        t.insert("total_brew_time", Tag.Int(400))
        t.insert("Items", Tag.List([]))
        t.insert("Fuel", Tag.Int(0))
        t.insert("total_fuel", Tag.Int(20))
        t.insert("speed_multiplier", Tag.Float(1.0f32))
        return some(t)
    }
    if kind == "minecraft:mob_spawner" {
        t.insert("Delay", Tag.Short(20))
        t.insert("MinSpawnDelay", Tag.Short(200))
        t.insert("MaxSpawnDelay", Tag.Short(800))
        t.insert("SpawnCount", Tag.Short(4))
        t.insert("MaxNearbyEntities", Tag.Short(6))
        t.insert("RequiredPlayerRange", Tag.Short(16))
        t.insert("SpawnRange", Tag.Short(4))
        t.insert("SpawnPotentials", Tag.List([]))
        return some(t)
    }
    if kind == "minecraft:beehive" {
        t.insert("bees", Tag.List([]))
        return some(t)
    }
    if kind == "minecraft:potent_sulfur" {
        t.insert("countdown", Tag.Int(-1))
        return some(t)
    }
    if kind == "minecraft:end_gateway" {
        t.insert("Age", Tag.Long(0))
        return some(t)
    }
    if kind == "minecraft:comparator" {
        t.insert("OutputSignal", Tag.Int(0))
        return some(t)
    }
    if kind == "minecraft:sculk_sensor" or kind == "minecraft:calibrated_sculk_sensor" {
        t.insert("last_vibration_frequency", Tag.Int(0))
        t.insert("listener", default_listener())
        return some(t)
    }
    if kind == "minecraft:vault" {
        t.insert("config", Tag.Compound(vault_config(JavaHashMap<String, Tag>(), true)))
        t.insert("shared_data", Tag.Compound(JavaHashMap<String, Tag>()))
        t.insert("server_data", Tag.Compound(JavaHashMap<String, Tag>()))
        return some(t)
    }
    if kind == "minecraft:trial_spawner" {
        // `TrialSpawner.store`: its state and its configs through codecs whose fields are each
        // left out at their default, which a new one's all are.
        return some(t)
    }
    if kind == "minecraft:sign" or kind == "minecraft:hanging_sign" {
        t.insert("front_text", empty_sign_text())
        t.insert("back_text", empty_sign_text())
        t.insert("is_waxed", Tag.Byte(0))
        return some(t)
    }
    if kind == "minecraft:piston" {
        // A moving piston's block, air, and how far along it is.
        t.insert("blockState", Tag.Str("minecraft:air"))
        t.insert("facing", Tag.Byte(0))
        t.insert("progress", Tag.Float(0.0f32))
        t.insert("extending", Tag.Byte(0))
        t.insert("source", Tag.Byte(0))
        return some(t)
    }
    if kind == "minecraft:beacon" {
        t.insert("Levels", Tag.Int(0))
        return some(t)
    }
    if kind == "minecraft:structure_block" {
        return some(structure_block(JavaHashMap<String, Tag>()))
    }
    if kind == "minecraft:command_block" {
        return match command_block(JavaHashMap<String, Tag>(), none) {
            ok(fields) => some(fields),
            err(_) => none,
        }
    }
    if kind == "minecraft:sculk_catalyst" {
        t.insert("cursors", Tag.List([]))
        return some(t)
    }
    if kind == "minecraft:sculk_shrieker" {
        t.insert("warning_level", Tag.Int(0))
        t.insert("listener", default_listener())
        return some(t)
    }
    if kind == "minecraft:chiseled_bookshelf" {
        t.insert("Items", Tag.List([]))
        t.insert("last_interacted_slot", Tag.Int(-1))
        return some(t)
    }
    if kind == "minecraft:shelf" {
        t.insert("Items", Tag.List([]))
        t.insert("align_items_to_bottom", Tag.Byte(0))
        return some(t)
    }
    if kind == "minecraft:crafter" {
        t.insert("Items", Tag.List([]))
        t.insert("crafting_ticks_remaining", Tag.Int(0))
        t.insert("disabled_slots", Tag.IntArray(List<i32>()))
        t.insert("triggered", Tag.Int(0))
        return some(t)
    }
    if kind == "minecraft:test_block" {
        t.insert("message", Tag.Str(String()))
        t.insert("mode", Tag.Str("fail"))
        t.insert("powered", Tag.Byte(0))
        return some(t)
    }
    if kind == "minecraft:test_instance_block" {
        // `TestInstanceBlockEntity.Data`, new: no test, cleared, no size.
        var d = JavaHashMap<String, Tag>()
        d.insert("ignore_entities", Tag.Byte(0))
        d.insert("rotation", Tag.Str("none"))
        d.insert("size", Tag.IntArray([0, 0, 0]))
        d.insert("status", Tag.Str("cleared"))
        t.insert("data", Tag.Compound(d))
        return some(t)
    }
    if kind == "minecraft:jigsaw" {
        return some(jigsaw_fields())
    }
    let plain: List<str> = ["brushable_block", "bell", "ender_chest", "lectern", "skull", "banner", "decorated_pot", "creaking_heart", "copper_golem_statue", "enchanting_table", "daylight_detector", "jukebox", "end_portal", "conduit"]
    for k in plain {
        if kind == "minecraft:{k}" {
            return some(t)
        }
    }
    return none
}

// `VibrationSystem.Data`, new: no event, a selector with none, no delay.
fn default_listener() -> Tag {
    var selector = JavaHashMap<String, Tag>()
    selector.insert("tick", Tag.Long(-1))
    var t = JavaHashMap<String, Tag>()
    t.insert("selector", Tag.Compound(selector))
    t.insert("event_delay", Tag.Int(0))
    return Tag.Compound(t)
}

// `VaultConfig.CODEC`'s output for a config read from `data`, or for `VaultConfig.DEFAULT`: the
// fields that differ from the default's, but for the key item, which `loaded` reads. The key
// item has no default in the codec, so the default config writes its trial key, and a config
// read without one has none.
fn vault_config(data: JavaHashMap<String, Tag>, default: bool) -> JavaHashMap<String, Tag> {
    var t = JavaHashMap<String, Tag>()
    if default {
        var key = JavaHashMap<String, Tag>()
        key.insert("count", Tag.Int(1))
        key.insert("id", Tag.Str("minecraft:trial_key"))
        t.insert("key_item", Tag.Compound(key))
        return t
    }
    if let table = string(data, "loot_table") {
        if table != "minecraft:chests/trial_chambers/reward" {
            t.insert("loot_table", Tag.Str(table))
        }
    }
    if data.contains("activation_range") {
        let range = data["activation_range"].number_double() ?? 4.0
        if range != 4.0 {
            t.insert("activation_range", Tag.Double(range))
        }
    }
    if data.contains("deactivation_range") {
        let range = data["deactivation_range"].number_double() ?? 4.5
        if range != 4.5 {
            t.insert("deactivation_range", Tag.Double(range))
        }
    }
    if let table = string(data, "override_loot_table_to_display") {
        t.insert("override_loot_table_to_display", Tag.Str(table))
    }
    return t
}

// `SignText.EMPTY`: four empty lines, black, not glowing.
fn empty_sign_text() -> Tag {
    var t = JavaHashMap<String, Tag>()
    t.insert("messages", Tag.List([Tag.Str(String()), Tag.Str(String()), Tag.Str(String()), Tag.Str(String())]))
    t.insert("color", Tag.Str("black"))
    t.insert("has_glowing_text", Tag.Byte(0))
    return Tag.Compound(t)
}

// A side of a sign as `loadAdditional` reads it with `SignText.CODEC` and `saveAdditional` writes
// it again, with `items`' codecs: four lines of `ComponentSerialization.CODEC`, the first four of
// more and none of fewer; the filtered lines, read leniently and written only if they aren't the
// lines; the color, black if it isn't a dye's; and whether it glows. A side that doesn't read is
// `SignText`'s own, empty (D370). Without `items`, each line is read as `Component` reads it.
fn sign_text(tag: Tag, items: Shared<ItemCodecs>?) -> Tag {
    if let c = items {
        return c.value.sign(tag) ?? empty_sign_text()
    }
    let Tag.Compound(m) = tag else return empty_sign_text()
    if not m.contains("messages") {
        return empty_sign_text()
    }
    let messages = match sign_lines(m["messages"]) {
        ok(some(l)) => l,
        ok(none) => return empty_sign_text(),
        err(_) => return tag.copy(),
    }
    var t = JavaHashMap<String, Tag>()
    t.insert("messages", Tag.List(messages.copy()))
    if m.contains("filtered_messages") {
        match sign_lines(m["filtered_messages"]) {
            ok(some(filtered)) => {
                var same = true
                for i in 0..4usize {
                    same = same and filtered[i].to_snbt() == messages[i].to_snbt()
                }
                if not same {
                    t.insert("filtered_messages", Tag.List(filtered))
                }
            },
            ok(none) => {},
            err(_) => return tag.copy(),
        }
    }
    let dyes: List<str> = ["white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black"]
    var color = String("black")
    if let c = string(m, "color") {
        for d in dyes {
            if c == String(d) {
                color = c.copy()
            }
        }
    }
    t.insert("color", Tag.Str(color))
    t.insert("has_glowing_text", flag(bool_or(m, "has_glowing_text", false)))
    return Tag.Compound(t)
}

// A sign's four lines, each written again as `ComponentSerialization.CODEC` writes it: `none` if
// they aren't a list of four or more that each read, and an error for a line with contents Calcite
// doesn't read yet.
fn sign_lines(value: Tag) -> List<Tag>? ! String {
    let Tag.List(items) = value else return none
    if items.len() < 4 {
        return none
    }
    var out = List<Tag>()
    for i in 0..4usize {
        let line = match items[i] {
            Tag.Str(_) => items[i].copy(),
            Tag.Compound(_) => (try Component.from_nbt(items[i])).to_nbt(),
            Tag.List(_) => (try Component.from_nbt(items[i])).to_nbt(),
            _ => return none,
        }
        out.push(line)
    }
    return some(out)
}

/// What a block entity of the type saves after `loadWithComponents` of `data`, its items read
/// with `items`: an error for a type or a field Calcite doesn't load yet, with what it is, and
/// for an item without `items`.
pub fn loaded(kind: String, data: JavaHashMap<String, Tag>, items: Shared<ItemCodecs>?) -> JavaHashMap<String, Tag> ! String {
    var t = fresh(kind) else fail "a {kind} loaded from data"
    let crafter = kind == "minecraft:crafter"
    if container(kind) or crafter or kind == "minecraft:decorated_pot" or kind == "minecraft:brushable_block" {
        if kind == "minecraft:decorated_pot" and data.contains("sherds") {
            // `PotDecorations.CODEC`: each side an `ItemStackTemplate`, in its order, a side
            // that doesn't read left out, and nothing where it isn't a compound; written unless
            // there are none.
            match data["sherds"] {
                Tag.Compound(m) => {
                    var sherds = JavaHashMap<String, Tag>()
                    for side in ["back", "left", "right", "front"] {
                        if m.contains(side) {
                            if let sherd = try item_template(m[side], items) {
                                sherds.insert(String(side), sherd)
                            }
                        }
                    }
                    if not sherds.is_empty() {
                        t.insert("sherds", Tag.Compound(sherds))
                    }
                },
                _ => {},
            }
        }
        // `tryLoadLootTable`, else the items.
        if let table = string(data, "LootTable") {
            _ = t.remove("Items")
            t.insert("LootTable", Tag.Str(table))
            let seed = long_or(data, "LootTableSeed", 0)
            if seed != 0 {
                t.insert("LootTableSeed", Tag.Long(seed))
            }
        } else if container(kind) or crafter {
            let kept = try container_items(data, slots_of(kind), items)
            if kept.is_empty() and kind == "minecraft:shulker_box" {
                _ = t.remove("Items")
            } else {
                t.insert("Items", Tag.List(kept))
            }
        } else if data.contains("item") {
            // A pot's or a brushable block's one item, `ItemStack.CODEC`.
            if let stack = try item_stack(data["item"], items) {
                t.insert("item", stack)
            }
        }
        if kind == "minecraft:hopper" {
            t.insert("TransferCooldown", Tag.Int(int_or(data, "TransferCooldown", -1)))
        }
        if crafter {
            // The slots it has disabled, of its nine, in order; and its two counts as read.
            t.insert("crafting_ticks_remaining", Tag.Int(int_or(data, "crafting_ticks_remaining", 0)))
            var disabled = List<i32>()
            if data.contains("disabled_slots") {
                match data["disabled_slots"] {
                    Tag.IntArray(a) => {
                        for slot in 0..9 {
                            for v in a {
                                if v == slot and not disabled.contains(slot) {
                                    disabled.push(slot)
                                }
                            }
                        }
                    },
                    _ => {},
                }
            }
            t.insert("disabled_slots", Tag.IntArray(disabled))
            t.insert("triggered", Tag.Int(int_or(data, "triggered", 0)))
        }
        custom_name(mut t, data, "CustomName", items)
        if data.contains("lock") {
            fail "a {kind} loaded with a lock"
        }
        return t
    }
    if furnace(kind) {
        t.insert("Items", Tag.List(try container_items(data, 3, items)))
        for key in ["cooking_time_spent", "cooking_total_time", "lit_time_remaining", "lit_total_time"] {
            t.insert(String(key), Tag.Int(int_or(data, key, 0)))
        }
        t.insert("speed_multiplier", Tag.Float(float_or(data, "speed_multiplier", 1.0f32)))
        try keep(mut t, data, "RecipesUsed")
        custom_name(mut t, data, "CustomName", items)
        return t
    }
    if kind == "minecraft:campfire" {
        t.insert("Items", Tag.List(try container_items(data, 4, items)))
        for key in ["CookingTimes", "CookingTotalTimes"] {
            var four: List<i32> = [0, 0, 0, 0]
            if data.contains(key) {
                match data[key] {
                    Tag.IntArray(a) => {
                        for i in 0..a.len().min(4) {
                            four[i] = a[i]
                        }
                    },
                    _ => {},
                }
            }
            t.insert(String(key), Tag.IntArray(four))
        }
        return t
    }
    if kind == "minecraft:brewing_stand" {
        t.insert("Items", Tag.List(try container_items(data, 5, items)))
        t.insert("BrewTime", Tag.Int(int_or(data, "BrewTime", 0)))
        t.insert("total_brew_time", Tag.Int(int_or(data, "total_brew_time", 400)))
        t.insert("Fuel", Tag.Int(int_or(data, "Fuel", 0)))
        t.insert("total_fuel", Tag.Int(int_or(data, "total_fuel", 20)))
        t.insert("speed_multiplier", Tag.Float(float_or(data, "speed_multiplier", 1.0f32)))
        custom_name(mut t, data, "CustomName", items)
        return t
    }
    if kind == "minecraft:comparator" {
        t.insert("OutputSignal", Tag.Int(int_or(data, "OutputSignal", 0)))
        return t
    }
    if kind == "minecraft:sculk_sensor" or kind == "minecraft:calibrated_sculk_sensor" {
        t.insert("last_vibration_frequency", Tag.Int(int_or(data, "last_vibration_frequency", 0)))
        t.insert("listener", try vibration_listener(data))
        return t
    }
    if kind == "minecraft:sculk_shrieker" {
        t.insert("warning_level", Tag.Int(int_or(data, "warning_level", 0)))
        t.insert("listener", try vibration_listener(data))
        return t
    }
    if kind == "minecraft:sculk_catalyst" {
        // `SculkSpreader.load`: the cursors that read, at most 32.
        var cursors = List<Tag>()
        if data.contains("cursors") {
            match data["cursors"] {
                Tag.List(l) => {
                    for c in l {
                        if cursors.len() < 32 {
                            if let cursor = charge_cursor(c) {
                                cursors.push(cursor)
                            }
                        }
                    }
                },
                _ => {},
            }
        }
        t.insert("cursors", Tag.List(cursors))
        return t
    }
    if kind == "minecraft:sign" or kind == "minecraft:hanging_sign" {
        if bool_or(data, "allow_op_features", false) {
            t.insert("allow_op_features", Tag.Byte(1))
        }
        t.insert("front_text", if data.contains("front_text") { sign_text(data["front_text"], items) } else { empty_sign_text() })
        t.insert("back_text", if data.contains("back_text") { sign_text(data["back_text"], items) } else { empty_sign_text() })
        t.insert("is_waxed", flag(bool_or(data, "is_waxed", false)))
        return t
    }
    if kind == "minecraft:enchanting_table" {
        custom_name(mut t, data, "CustomName", items)
        return t
    }
    if kind == "minecraft:jukebox" {
        // The record `ItemStack.CODEC` reads, and how long its song has played, kept only for a
        // record with a song, `JukeboxSong.fromStack`: its `jukebox_playable`.
        if data.contains("RecordItem") {
            if let record = try item_stack(data["RecordItem"], items) {
                let song = has_component(record, "minecraft:jukebox_playable", items)
                t.insert("RecordItem", record)
                if song and data.contains("ticks_since_song_started") {
                    if let ticks = data["ticks_since_song_started"].long_value() {
                        t.insert("ticks_since_song_started", Tag.Long(ticks))
                    }
                }
            }
        }
        return t
    }
    if kind == "minecraft:piston" {
        // `BlockState.CODEC` of the moving block, which reads a block's bare ID as its default
        // state and anything else, properties or a compound, as air; the facing as
        // `Direction.LEGACY_ID_CODEC` reads it, a byte whose remainder by 6 it takes without its
        // sign.
        if data.contains("blockState") {
            match data["blockState"] {
                Tag.Str(s) => t.insert("blockState", Tag.Str(builtin_id("block", s) ?? String("minecraft:air"))),
                _ => {},
            }
        }
        if data.contains("facing") {
            if let n = data["facing"].number_int() {
                let b = i32(i8.wrap(n))
                t.insert("facing", Tag.Byte(i8.wrap((b % 6).abs())))
            }
        }
        t.insert("progress", Tag.Float(float_or(data, "progress", 0.0f32)))
        t.insert("extending", flag(bool_or(data, "extending", false)))
        t.insert("source", flag(bool_or(data, "source", false)))
        return t
    }
    if kind == "minecraft:beacon" {
        // Its effects where they're ones a beacon gives; its levels aren't read, since it counts
        // them again as it ticks.
        let effects: List<str> = ["minecraft:speed", "minecraft:haste", "minecraft:resistance", "minecraft:jump_boost", "minecraft:strength", "minecraft:regeneration"]
        for key in ["primary_effect", "secondary_effect"] {
            if let given = string(data, key) {
                if let id = builtin_id("mob_effect", given) {
                    for e in effects {
                        if id == String(e) {
                            t.insert(String(key), Tag.Str(id.copy()))
                        }
                    }
                }
            }
        }
        custom_name(mut t, data, "CustomName", items)
        if data.contains("lock") {
            fail "a beacon loaded with a lock"
        }
        return t
    }
    if kind == "minecraft:structure_block" {
        return structure_block(data)
    }
    if kind == "minecraft:command_block" {
        return try command_block(data, items)
    }
    if kind == "minecraft:conduit" {
        // `UUIDUtil.CODEC`: four ints, or the first four of more.
        if data.contains("Target") {
            var error: String? = none
            if let ints = data["Target"].fixed_ints(4, mut error) {
                t.insert("Target", Tag.IntArray(ints))
            }
        }
        return t
    }
    if kind == "minecraft:chiseled_bookshelf" {
        t.insert("Items", Tag.List(try container_items(data, 6, items)))
        t.insert("last_interacted_slot", Tag.Int(int_or(data, "last_interacted_slot", -1)))
        return t
    }
    if kind == "minecraft:shelf" {
        t.insert("Items", Tag.List(try container_items(data, 3, items)))
        t.insert("align_items_to_bottom", flag(bool_or(data, "align_items_to_bottom", false)))
        return t
    }
    if kind == "minecraft:test_block" {
        t.insert("message", Tag.Str(string(data, "message") ?? String()))
        t.insert("mode", Tag.Str(named(data, "mode", ["start", "log", "fail", "accept"], "fail")))
        t.insert("powered", flag(bool_or(data, "powered", false)))
        return t
    }
    if kind == "minecraft:test_instance_block" and data.contains("data") {
        fail "a test instance block loaded with its data"
    }
    if kind == "minecraft:jigsaw" {
        // Its IDs where they read; its joint, which without one is its facing's, which isn't
        // known here.
        t.insert("name", Tag.Str(identifier_or(data, "name", "minecraft:empty")))
        t.insert("target", Tag.Str(identifier_or(data, "target", "minecraft:empty")))
        t.insert("pool", Tag.Str(identifier_or(data, "pool", "minecraft:empty")))
        t.insert("final_state", Tag.Str(string(data, "final_state") ?? String("minecraft:air")))
        let joint = named(data, "joint", ["rollable", "aligned"], "")
        if joint.is_empty() {
            fail "a jigsaw whose joint is its facing's"
        }
        t.insert("joint", Tag.Str(joint))
        t.insert("placement_priority", Tag.Int(int_or(data, "placement_priority", 0)))
        t.insert("selection_priority", Tag.Int(int_or(data, "selection_priority", 0)))
        return t
    }
    if kind == "minecraft:end_gateway" {
        t.insert("Age", Tag.Long(long_or(data, "Age", 0)))
        if data.contains("exit_portal") {
            if let p = block_pos(data["exit_portal"]) {
                t.insert("exit_portal", p)
            }
        }
        if bool_or(data, "ExactTeleport", false) {
            t.insert("ExactTeleport", Tag.Byte(1))
        }
        return t
    }
    if kind == "minecraft:potent_sulfur" {
        t.insert("countdown", Tag.Int(int_or(data, "countdown", -1)))
        return t
    }
    if kind == "minecraft:banner" {
        if data.contains("patterns") {
            let empty = match data["patterns"] {
                Tag.List(l) => l.is_empty(),
                _ => false,
            }
            if not empty {
                t.insert("patterns", data["patterns"].copy())
            }
        }
        custom_name(mut t, data, "CustomName", items)
        return t
    }
    if kind == "minecraft:skull" {
        // `ResolvableProfile.CODEC` and `Identifier.CODEC`, each left out where it doesn't read.
        if let c = items {
            for key in ["profile", "note_block_sound"] {
                let k = String(key)
                if data.contains(k) {
                    let read = if key == "profile" { c.value.owner(data[k]) } else { c.value.identifier(data[k]) }
                    if let v = read {
                        t.insert(k.copy(), v)
                    }
                }
            }
        } else {
            try keep(mut t, data, "profile")
            try keep(mut t, data, "note_block_sound")
        }
        custom_name(mut t, data, "custom_name", items)
        return t
    }
    if kind == "minecraft:lectern" {
        // The book `ItemStack.CODEC` reads, written back, which `resolveBook` leaves as it is in a
        // chunk that's generating, with no level; and the page `Mth.clamp`ed to the book's
        // pages, which is -1 for a book with none.
        if data.contains("Book") {
            let read = try item_stack(data["Book"], items)
            let book = read else return t
            let pages = page_count(book, items)
            t.insert("Book", book)
            t.insert("Page", Tag.Int(int_or(data, "Page", 0).max(0).min(pages - 1)))
        }
        return t
    }
    if kind == "minecraft:vault" {
        // The config read back through its codec, or the default; the shared and server data
        // only when there's none, as a template's vaults have.
        if data.contains("config") {
            match data["config"] {
                Tag.Compound(c) => {
                    var config = vault_config(c, false)
                    if c.contains("key_item") {
                        if let key = try lenient_stack(c["key_item"], items) {
                            config.insert("key_item", key)
                        }
                    }
                    t.insert("config", Tag.Compound(config))
                },
                _ => fail "a vault loaded with a config that isn't a compound",
            }
        }
        for key in ["shared_data", "server_data"] {
            if data.contains(key) {
                let empty = match data[key] {
                    Tag.Compound(m) => m.is_empty(),
                    _ => false,
                }
                if not empty {
                    fail "a vault loaded with its {key}"
                }
            }
        }
        return t
    }
    if kind == "minecraft:trial_spawner" {
        // `TrialSpawner.load` then `store`: each field of the state and the configs written back
        // unless it's its default; the configs, read as holders, as the data names them.
        for key in ["registered_players", "current_mobs"] {
            if data.contains(key) {
                let empty = match data[key] {
                    Tag.List(l) => l.is_empty(),
                    _ => false,
                }
                if not empty {
                    t.insert(String(key), data[key].copy())
                }
            }
        }
        for key in ["cooldown_ends_at", "next_mob_spawns_at"] {
            let v = codec_long_or(data, key, 0)
            if v != 0 {
                t.insert(String(key), Tag.Long(v))
            }
        }
        let total = codec_int_or(data, "total_mobs_spawned", 0)
        if total > 0 {
            t.insert("total_mobs_spawned", Tag.Int(total))
        }
        try keep(mut t, data, "spawn_data")
        try keep(mut t, data, "ejecting_loot_table")
        try keep(mut t, data, "normal_config")
        try keep(mut t, data, "ominous_config")
        let cooldown = codec_int_or(data, "target_cooldown_length", 36000)
        if cooldown != 36000 {
            t.insert("target_cooldown_length", Tag.Int(cooldown))
        }
        let range = codec_int_or(data, "required_player_range", 14)
        if range != 14 {
            t.insert("required_player_range", Tag.Int(range))
        }
        return t
    }
    if kind == "minecraft:creaking_heart" and data.contains("creaking") {
        fail "a creaking heart loaded with its creaking"
    }
    if kind == "minecraft:mob_spawner" {
        return spawner(data)
    }
    if kind == "minecraft:beehive" {
        // The bees `Occupant.LIST_CODEC` reads, a bee that doesn't left out as the list's partial
        // result leaves it, none where `bees` isn't a list; and the flower's position where
        // `BlockPos.CODEC` reads it.
        var bees = List<Tag>()
        if data.contains("bees") {
            match data["bees"] {
                Tag.List(l) => {
                    for b in l {
                        if let bee = try occupant(b) {
                            bees.push(bee)
                        }
                    }
                },
                _ => {},
            }
        }
        t.insert("bees", Tag.List(bees))
        if data.contains("flower_pos") {
            if let p = block_pos(data["flower_pos"]) {
                t.insert("flower_pos", p)
            }
        }
        return t
    }
    return t
}

// `BeehiveBlockEntity.Occupant.CODEC` of `tag`, written back: its entity's data with its `id`
// as `EntityType.CODEC` names the type, and its two counts as ints, or `none` where it doesn't
// read.
fn occupant(tag: Tag) -> Tag? ! String {
    let Tag.Compound(m) = tag else return none
    if not m.contains("entity_data") or not m.contains("ticks_in_hive") or not m.contains("min_ticks_in_hive") {
        return none
    }
    // `CustomData.COMPOUND_TAG_CODEC`, which reads SNBT in a string too.
    var entity = match m["entity_data"] {
        Tag.Compound(d) => d.copy(),
        Tag.Str(_) => fail "a bee whose data is SNBT in a string",
        _ => return none,
    }
    let given = string(entity, "id") else return none
    let id = builtin_id("entity_type", given) else return none
    let ticks = m["ticks_in_hive"].number_int() else return none
    let least = m["min_ticks_in_hive"].number_int() else return none
    // `TypedEntityData`: the `id` taken out as it's read, and put back as it's written.
    _ = entity.remove("id")
    entity.insert("id", Tag.Str(id))
    var out = JavaHashMap<String, Tag>()
    out.insert("entity_data", Tag.Compound(entity))
    out.insert("ticks_in_hive", Tag.Int(ticks))
    out.insert("min_ticks_in_hive", Tag.Int(least))
    return some(Tag.Compound(out))
}

// A built-in registry's `holderByNameCodec`, such as `EntityType.CODEC` and `Item.CODEC`: the
// entry `id` names in `registry`, as its key, or `none` where it names none.
fn builtin_id(registry: str, id: String) -> String? {
    let parsed = match Identifier.parse(id) {
        ok(i) => i,
        err(_) => return none,
    }
    if parsed.namespace != "minecraft" {
        return none
    }
    let names = builtin_names()
    for i in 0..names.len() {
        if names[i] == String(registry) {
            for name in builtin_entries(i) {
                if name == parsed.path {
                    return some(parsed.to_string())
                }
            }
        }
    }
    return none
}

// The slots of the container `kind`, one that keeps a loot table in place of its items.
fn slots_of(kind: String) -> usize {
    if kind == "minecraft:hopper" {
        return 5
    }
    if kind == "minecraft:dispenser" or kind == "minecraft:dropper" or kind == "minecraft:crafter" {
        return 9
    }
    return 27
}

// The items `ContainerHelper.loadAllItems` loads into `size` slots and `saveAllItems` saves:
// each of `Items` that `ItemStackWithSlot.CODEC` reads, or reads in part, in its slot where
// that's one of the container's, a later one over an earlier, written in the slots' order;
// none where `Items` isn't a list.
fn container_items(data: JavaHashMap<String, Tag>, size: usize, items: Shared<ItemCodecs>?) -> List<Tag> ! String {
    var slots = List<Tag?>()
    for _ in 0..size {
        slots.push(none)
    }
    if data.contains("Items") {
        match data["Items"] {
            Tag.List(l) => {
                for each in l {
                    let got = try read_with(each, items, Kind.Slotted)
                    let read = got else continue
                    let slot = match read {
                        Tag.Compound(m) => match m["Slot"] {
                            Tag.Byte(b) => usize(u8.wrap(b)),
                            _ => continue,
                        },
                        _ => continue,
                    }
                    if slot < size {
                        slots[slot] = some(read)
                    }
                }
            },
            _ => {},
        }
    }
    var out = List<Tag>()
    for each in slots {
        if let stack = each {
            out.push(stack.copy())
        }
    }
    return out
}

// Which of the item codecs reads.
enum Kind {
    Stack
    Lenient
    Template
    Slotted
}

// `t` read with the codec `kind` of `items`, as `ValueInput.read` takes it: the value, or its
// partial value, but for a lenient field's, or `none`. Without `items`, an item can't be read.
fn read_with(t: Tag, items: Shared<ItemCodecs>?, kind: Kind) -> Tag? ! String {
    return match items {
        some(c) => match kind {
            Kind.Stack => c.value.stack(t, true),
            Kind.Lenient => c.value.stack(t, false),
            Kind.Template => c.value.template(t),
            Kind.Slotted => c.value.slotted(t),
        },
        none => {
            fail String("an item, which Calcite reads only with the registries")
        },
    }
}

// `ItemStack.CODEC` of `t`, written back, or `none`.
fn item_stack(t: Tag, items: Shared<ItemCodecs>?) -> Tag? ! String {
    return try read_with(t, items, Kind.Stack)
}

// `ItemStack.lenientOptionalFieldOf`: the stack where it reads in full, or `none`.
fn lenient_stack(t: Tag, items: Shared<ItemCodecs>?) -> Tag? ! String {
    return try read_with(t, items, Kind.Lenient)
}

// `ItemStackTemplate.CODEC` of `t`, written back, or `none`.
fn item_template(t: Tag, items: Shared<ItemCodecs>?) -> Tag? ! String {
    return try read_with(t, items, Kind.Template)
}

// Whether `stack`, as the codec writes it, has the component `name`.
fn has_component(stack: Tag, name: str, items: Shared<ItemCodecs>?) -> bool {
    return match items {
        some(c) => c.value.component(stack, String(name)) != none,
        none => false,
    }
}

// `LecternBlockEntity.getPageCount`: the pages of the book's written content where it has
// some, else of its writable content, else none.
fn page_count(book: Tag, items: Shared<ItemCodecs>?) -> i32 {
    let c = match items {
        some(c) => c.copy(),
        none => return 0,
    }
    for name in ["minecraft:written_book_content", "minecraft:writable_book_content"] {
        if let content = c.value.component(book, String(name)) {
            return match content {
                Tag.Compound(m) => if m.contains("pages") {
                    match m["pages"] {
                        Tag.List(pages) => i32.wrap(pages.len()),
                        _ => 0,
                    }
                } else {
                    0
                },
                _ => 0,
            }
        }
    }
    return 0
}

// `VibrationSystem.Data.CODEC` of a listener, written back: its delay, and its selector, whose
// tick is -1 without an event, as `VibrationSelector` keeps a tick only with one; a new
// listener's where the data doesn't read.
fn vibration_listener(data: JavaHashMap<String, Tag>) -> Tag ! String {
    if not data.contains("listener") {
        return default_listener()
    }
    let Tag.Compound(m) = data["listener"] else return default_listener()
    if m.contains("event") {
        fail "a vibration listener with an event"
    }
    if not m.contains("selector") {
        return default_listener()
    }
    let Tag.Compound(s) = m["selector"] else return default_listener()
    if s.contains("event") {
        fail "a vibration selector with an event"
    }
    if not s.contains("tick") or s["tick"].number_long() == none {
        return default_listener()
    }
    var delay = 0
    if m.contains("event_delay") {
        let d = m["event_delay"].number_int() else return default_listener()
        if d < 0 {
            return default_listener()
        }
        delay = d
    }
    var selector = JavaHashMap<String, Tag>()
    selector.insert("tick", Tag.Long(-1))
    var t = JavaHashMap<String, Tag>()
    t.insert("selector", Tag.Compound(selector))
    t.insert("event_delay", Tag.Int(delay))
    return Tag.Compound(t)
}

// `SculkSpreader.ChargeCursor.CODEC` of `t`, written back, or `none` where it has no position:
// its charge from 0 to 1000, its decay delay 0 or 1 and its update delay not negative, each at
// its default where it's out of its range and left out at its default; its facings where they
// all read.
fn charge_cursor(t: Tag) -> Tag? {
    let Tag.Compound(m) = t else return none
    if not m.contains("pos") {
        return none
    }
    let pos = block_pos(m["pos"]) else return none
    var out = JavaHashMap<String, Tag>()
    out.insert("pos", pos)
    let charge = ranged(m, "charge", 0, 1000, 0)
    if charge != 0 {
        out.insert("charge", Tag.Int(charge))
    }
    let decay = ranged(m, "decay_delay", 0, 1, 1)
    if decay != 1 {
        out.insert("decay_delay", Tag.Int(decay))
    }
    let update = ranged(m, "update_delay", 0, 2147483647, 0)
    if update != 0 {
        out.insert("update_delay", Tag.Int(update))
    }
    if m.contains("facings") {
        let directions: List<str> = ["down", "up", "north", "south", "west", "east"]
        var all = false
        match m["facings"] {
            Tag.List(l) => {
                all = true
                for f in l {
                    var known = false
                    match f {
                        Tag.Str(s) => {
                            for d in directions {
                                if s == String(d) {
                                    known = true
                                }
                            }
                        },
                        _ => {},
                    }
                    if not known {
                        all = false
                    }
                }
            },
            _ => {},
        }
        if all {
            out.insert("facings", m["facings"].copy())
        }
    }
    return some(Tag.Compound(out))
}

// A structure block as `StructureBlockEntity.loadAdditional` reads `data` and `saveAdditional`
// writes it: its name an ID or empty, its offset clamped to 48 either way and its size to 0 to
// 48, its rotation, mirror and mode by name or else their defaults, and the rest as read.
fn structure_block(data: JavaHashMap<String, Tag>) -> JavaHashMap<String, Tag> {
    var t = JavaHashMap<String, Tag>()
    var name = String()
    if let given = string(data, "name") {
        match Identifier.parse(given) {
            ok(i) => name = i.to_string(),
            err(_) => {},
        }
    }
    t.insert("name", Tag.Str(name))
    t.insert("author", Tag.Str(string(data, "author") ?? String()))
    t.insert("metadata", Tag.Str(string(data, "metadata") ?? String()))
    t.insert("posX", Tag.Int(int_or(data, "posX", 0).max(-48).min(48)))
    t.insert("posY", Tag.Int(int_or(data, "posY", 1).max(-48).min(48)))
    t.insert("posZ", Tag.Int(int_or(data, "posZ", 0).max(-48).min(48)))
    t.insert("sizeX", Tag.Int(int_or(data, "sizeX", 0).max(0).min(48)))
    t.insert("sizeY", Tag.Int(int_or(data, "sizeY", 0).max(0).min(48)))
    t.insert("sizeZ", Tag.Int(int_or(data, "sizeZ", 0).max(0).min(48)))
    t.insert("rotation", Tag.Str(named(data, "rotation", ["NONE", "CLOCKWISE_90", "CLOCKWISE_180", "COUNTERCLOCKWISE_90"], "NONE")))
    t.insert("mirror", Tag.Str(named(data, "mirror", ["NONE", "LEFT_RIGHT", "FRONT_BACK"], "NONE")))
    t.insert("mode", Tag.Str(named(data, "mode", ["SAVE", "LOAD", "CORNER", "DATA"], "DATA")))
    t.insert("ignoreEntities", flag(bool_or(data, "ignoreEntities", true)))
    t.insert("strict", flag(bool_or(data, "strict", false)))
    t.insert("powered", flag(bool_or(data, "powered", false)))
    t.insert("showair", flag(bool_or(data, "showair", false)))
    t.insert("showboundingbox", flag(bool_or(data, "showboundingbox", true)))
    t.insert("integrity", Tag.Float(float_or(data, "integrity", 1.0f32)))
    t.insert("seed", Tag.Long(long_or(data, "seed", 0)))
    return t
}

// A command block as `BaseCommandBlock.load` and `CommandBlockEntity.loadAdditional` read `data`
// and their saves write it back: its last output only while it tracks output, and when it last
// ran only while it keeps that and it isn't -1.
fn command_block(data: JavaHashMap<String, Tag>, items: Shared<ItemCodecs>?) -> JavaHashMap<String, Tag> ! String {
    var t = JavaHashMap<String, Tag>()
    t.insert("Command", Tag.Str(string(data, "Command") ?? String()))
    t.insert("SuccessCount", Tag.Int(int_or(data, "SuccessCount", 0)))
    custom_name(mut t, data, "CustomName", items)
    let track = bool_or(data, "TrackOutput", true)
    t.insert("TrackOutput", flag(track))
    if track {
        custom_name(mut t, data, "LastOutput", items)
    }
    let update = bool_or(data, "UpdateLastExecution", true)
    t.insert("UpdateLastExecution", flag(update))
    if update {
        let last = long_or(data, "LastExecution", -1)
        if last != -1 {
            t.insert("LastExecution", Tag.Long(last))
        }
    }
    t.insert("powered", flag(bool_or(data, "powered", false)))
    t.insert("conditionMet", flag(bool_or(data, "conditionMet", false)))
    t.insert("auto", flag(bool_or(data, "auto", false)))
    return t
}

// `JigsawBlockEntity`'s fields, new: empty IDs, air, and a rollable joint.
fn jigsaw_fields() -> JavaHashMap<String, Tag> {
    var t = JavaHashMap<String, Tag>()
    t.insert("name", Tag.Str("minecraft:empty"))
    t.insert("target", Tag.Str("minecraft:empty"))
    t.insert("pool", Tag.Str("minecraft:empty"))
    t.insert("final_state", Tag.Str("minecraft:air"))
    t.insert("joint", Tag.Str("rollable"))
    t.insert("placement_priority", Tag.Int(0))
    t.insert("selection_priority", Tag.Int(0))
    return t
}

// `BlockPos.CODEC` of `tag`, with what `TagValueInput` takes of an error: the first three
// numbers of at least three, as an int array.
fn block_pos(tag: Tag) -> Tag? {
    var error: String? = none
    let ints = tag.fixed_ints(3, mut error) else return none
    return some(Tag.IntArray(ints))
}

// A mob spawner as `BaseSpawner.load` reads `data` and `save` writes it back: its delay and counts
// as numbers of any type, written as shorts; its next spawn's data if `SpawnData.CODEC` reads it;
// and its potentials if `LIST_CODEC` reads them, or else one, the next spawn's data or an empty
// entity's, weighted 1, as `WeightedList.of` makes it. What the codecs keep is kept as the data
// had it.
fn spawner(data: JavaHashMap<String, Tag>) -> JavaHashMap<String, Tag> {
    var t = JavaHashMap<String, Tag>()
    t.insert("Delay", Tag.Short(i16.wrap(int_or(data, "Delay", 20))))
    let counts: List<(str, i32)> = [("MinSpawnDelay", 200), ("MaxSpawnDelay", 800), ("SpawnCount", 4), ("MaxNearbyEntities", 6), ("RequiredPlayerRange", 16), ("SpawnRange", 4)]
    for (key, default) in counts {
        t.insert(String(key), Tag.Short(i16.wrap(int_or(data, key, default))))
    }
    var next: Tag? = none
    if data.contains("SpawnData") {
        next = spawn_data(data["SpawnData"])
    }
    var potentials: Tag? = none
    if data.contains("SpawnPotentials") {
        potentials = weighted_spawns(data["SpawnPotentials"])
    }
    var one = empty_spawn()
    if let n = next {
        one = n.copy()
        t.insert("SpawnData", n.copy())
    }
    if let p = potentials {
        t.insert("SpawnPotentials", p.copy())
    } else {
        var entry = JavaHashMap<String, Tag>()
        entry.insert("data", one.copy())
        entry.insert("weight", Tag.Int(1))
        t.insert("SpawnPotentials", Tag.List([Tag.Compound(entry)]))
    }
    return t
}

// `SpawnData.CODEC` of `tag`: its entity, a compound, and its spawn rules and equipment if it has
// them, or `none` where it has no entity.
fn spawn_data(tag: Tag) -> Tag? {
    let Tag.Compound(fields) = tag else return none
    if not fields.contains("entity") {
        return none
    }
    match fields["entity"] {
        Tag.Compound(_) => {},
        _ => return none,
    }
    var out = JavaHashMap<String, Tag>()
    for key in ["entity", "custom_spawn_rules", "equipment"] {
        if fields.contains(key) {
            out.insert(String(key), fields[key].copy())
        }
    }
    return some(Tag.Compound(out))
}

// `SpawnData.LIST_CODEC` of `tag`: each entry's spawn data and weight, a number no less than 0, or
// `none` where one isn't, as the list then doesn't read.
fn weighted_spawns(tag: Tag) -> Tag? {
    let Tag.List(entries) = tag else return none
    var out = List<Tag>()
    for e in entries {
        let Tag.Compound(fields) = e else return none
        if not fields.contains("data") or not fields.contains("weight") {
            return none
        }
        let d = spawn_data(fields["data"]) else return none
        let weight = fields["weight"].number_int() else return none
        if weight < 0 {
            return none
        }
        var entry = JavaHashMap<String, Tag>()
        entry.insert("data", d)
        entry.insert("weight", Tag.Int(weight))
        out.push(Tag.Compound(entry))
    }
    return some(Tag.List(out))
}

// `new SpawnData()`: an empty entity.
fn empty_spawn() -> Tag {
    var out = JavaHashMap<String, Tag>()
    out.insert("entity", Tag.Compound(JavaHashMap<String, Tag>()))
    return Tag.Compound(out)
}

// Keeps a field the type reads through a codec, as the data had it.
// A name, or a command block's last output, as `parseCustomNameSafe` reads it with
// `ComponentSerialization.CODEC` and its block entity's save writes it again, with `items`' codecs:
// left out where it doesn't read, and kept in part where it reads in part. Without `items`, as
// `Component` reads it (D370).
fn custom_name(t: mut JavaHashMap<String, Tag>, data: JavaHashMap<String, Tag>, key: str, items: Shared<ItemCodecs>?) {
    if not data.contains(key) {
        return
    }
    let name = match items {
        some(c) => c.value.name_text(data[key]),
        none => match Component.from_nbt(data[key]) {
            ok(n) => some(n.to_nbt()),
            err(_) => none,
        },
    }
    if let n = name {
        t.insert(String(key), n)
    }
}

fn keep(t: mut JavaHashMap<String, Tag>, data: JavaHashMap<String, Tag>, key: str) ! String {
    if data.contains(key) {
        t.insert(String(key), data[key].copy())
    }
}

fn string(data: JavaHashMap<String, Tag>, key: str) -> String? {
    if not data.contains(key) {
        return none
    }
    return match data[key] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

// `getIntOr`: a number of any type as `NumericTag.intValue` gives it, a float rounded down.
fn int_or(data: JavaHashMap<String, Tag>, key: str, default: i32) -> i32 {
    if not data.contains(key) {
        return default
    }
    return data[key].int_value() ?? default
}

// `getLongOr`: a number of any type as `NumericTag.longValue` gives it.
fn long_or(data: JavaHashMap<String, Tag>, key: str, default: i64) -> i64 {
    if not data.contains(key) {
        return default
    }
    return data[key].long_value() ?? default
}

// `getBooleanOr`: whether a number's `byteValue` isn't 0, so 256 is false.
fn bool_or(data: JavaHashMap<String, Tag>, key: str, default: bool) -> bool {
    if not data.contains(key) {
        return default
    }
    return match data[key].byte_value() {
        some(b) => b != 0,
        none => default,
    }
}

// A field `Codec.INT` reads with a default, as a codec's lenient optional field does: a number
// cut toward zero.
fn codec_int_or(data: JavaHashMap<String, Tag>, key: str, default: i32) -> i32 {
    if not data.contains(key) {
        return default
    }
    return data[key].number_int() ?? default
}

// A field `Codec.LONG` reads with a default.
fn codec_long_or(data: JavaHashMap<String, Tag>, key: str, default: i64) -> i64 {
    if not data.contains(key) {
        return default
    }
    return data[key].number_long() ?? default
}

// A field `intRange(least, most)` reads with `orElse(default)`: the default where it isn't
// there, isn't a number or is out of the range.
fn ranged(data: JavaHashMap<String, Tag>, key: str, least: i32, most: i32, default: i32) -> i32 {
    if not data.contains(key) {
        return default
    }
    let n = data[key].number_int() else return default
    if n < least or n > most {
        return default
    }
    return n
}

// An enum field read by its name, as `StringRepresentable`'s codecs and `valueOf` read it: the
// name where it's one of `names`, else `default`.
fn named(data: JavaHashMap<String, Tag>, key: str, names: List<str>, default: str) -> String {
    if let s = string(data, key) {
        for n in names {
            if s == String(n) {
                return s
            }
        }
    }
    return String(default)
}

// An `Identifier.CODEC` field: the ID, namespaced, or `default` where it isn't one.
fn identifier_or(data: JavaHashMap<String, Tag>, key: str, default: str) -> String {
    if let s = string(data, key) {
        match Identifier.parse(s) {
            ok(i) => return i.to_string(),
            err(_) => {},
        }
    }
    return String(default)
}

fn flag(b: bool) -> Tag {
    return Tag.Byte(if b { 1i8 } else { 0i8 })
}

fn float_or(data: JavaHashMap<String, Tag>, key: str, default: f32) -> f32 {
    if not data.contains(key) {
        return default
    }
    return data[key].number_float() ?? default
}
