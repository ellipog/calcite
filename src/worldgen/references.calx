/// Structure references and the beardifier made from them: which starts reach a chunk, as
/// `ChunkGenerator.createReferences` records them, and the rigid pieces and junctions of those
/// that adapt the terrain, as `Beardifier.forStructuresInChunk` gathers them through
/// `StructureManager.startsForStructure`.
module worldgen.references

import java.long_set.{LongOpenHashSet}
import worldgen.beardifier.{Beardifier, Extent, Gathered}
import worldgen.pieces.{Piece, PieceData, Start, pieces_box}
import worldgen.structures.{ADAPT_NONE, Structures}

/// `ChunkPos.pack`.
pub fn chunk_key(x: i32, z: i32) -> i64 {
    return i64(u32.wrap(x)) | (i64(u32.wrap(z)) << 32)
}

/// A chunk's references to one structure: the chunks its starts are in, in a fastutil set's order.
pub struct Refs {
    pub structure: usize
    pub chunks: LongOpenHashSet
}

/// Every chunk's starts, by `chunk_key`.
pub struct StartMap {
    pub chunks: Map<i64, List<Start>>
}

impl StartMap {
    pub fn new() -> StartMap {
        return StartMap { chunks: Map<i64, List<Start>>() }
    }
}

// The structure registry's order, as each structure's place in it: by path, then namespace.
fn ranks(s: Structures) -> List<usize> {
    var out = List<usize>()
    for i in 0..s.structures.len() {
        var rank = 0usize
        for j in 0..s.structures.len() {
            if before(s.structures[j].id, s.structures[i].id) {
                rank += 1
            }
        }
        out.push(rank)
    }
    return out
}

// Whether ID `a` sorts before `b`, as `Identifier.compareTo`.
fn before(a: String, b: String) -> bool {
    let (an, ap) = split(a)
    let (bn, bp) = split(b)
    if ap != bp {
        return ap < bp
    }
    return an < bn
}

fn split(id: String) -> (String, String) {
    if let colon = id.find(":") {
        return (id[..colon].copy(), id[colon + 1..].copy())
    }
    return (String("minecraft"), id.copy())
}

/// `createReferences` for the chunk: for each structure, the chunks within 8 of it whose start
/// reaches it, its box grown by 12 where the structure adapts the terrain, `x` outer; in the
/// structure registry's order.
pub fn create_references(s: Structures, starts: StartMap, cx: i32, cz: i32) -> List<Refs> {
    var refs = List<Refs>()
    let bx = cx << 4
    let bz = cz << 4
    for sx in cx - 8..cx + 9 {
        for sz in cz - 8..cz + 9 {
            let key = chunk_key(sx, sz)
            if not starts.chunks.contains(key) {
                continue
            }
            for start in starts.chunks[key] {
                let st = s.structure_ids.get(start.id) else continue
                if start.pieces.is_empty() {
                    continue
                }
                var b = pieces_box(start.pieces)
                if s.structures[st].adaptation != ADAPT_NONE {
                    b.min_x -= 12
                    b.min_z -= 12
                    b.max_x += 12
                    b.max_z += 12
                }
                if b.max_x >= bx and b.min_x <= bx + 15 and b.max_z >= bz and b.min_z <= bz + 15 {
                    var at: usize? = none
                    for i in 0..refs.len() {
                        if refs[i].structure == st {
                            at = some(i)
                        }
                    }
                    if let i = at {
                        _ = refs[i].chunks.add(key)
                    } else {
                        var set = LongOpenHashSet.new()
                        _ = set.add(key)
                        refs.push(Refs { structure: st, chunks: set })
                    }
                }
            }
        }
    }
    // In the registry's order.
    let rank = ranks(s)
    for i in 1..refs.len() {
        var j = i
        while j > 0 and rank[refs[j - 1].structure] > rank[refs[j].structure] {
            refs.swap(j - 1, j)
            j -= 1
        }
    }
    return refs
}

/// `Beardifier.forStructuresInChunk`: the starts the chunk references of structures that adapt
/// the terrain, in the references' order, their pieces near the chunk gathered; none for `EMPTY`.
pub fn beardifier_for(s: Structures, starts: StartMap, refs: List<Refs>, cx: i32, cz: i32, kernel: own List<f32>) -> Beardifier? {
    var g = Gathered.new()
    for r in refs {
        let adjustment = s.structures[r.structure].adaptation
        if adjustment == ADAPT_NONE {
            continue
        }
        for key in r.chunks.values() {
            if not starts.chunks.contains(key) {
                continue
            }
            for start in starts.chunks[key] {
                if s.structure_ids.get(start.id) == some(r.structure) and not start.pieces.is_empty() {
                    gather(mut g, start.pieces, adjustment, cx, cz)
                }
            }
        }
    }
    return g.finish(kernel)
}

fn extent(p: Piece) -> Extent {
    return Extent { min_x: p.bb.min_x, min_y: p.bb.min_y, min_z: p.bb.min_z, max_x: p.bb.max_x, max_y: p.bb.max_y, max_z: p.bb.max_z }
}

// A start's pieces within 12 blocks of the chunk: a jigsaw piece's box if it's rigid and its
// junctions within 12 blocks, any other piece's box.
fn gather(g: mut Gathered, pieces: List<Piece>, adjustment: i32, cx: i32, cz: i32) {
    let x0 = cx << 4
    let z0 = cz << 4
    for p in pieces {
        let b = p.bb
        if not (b.max_x >= x0 - 12 and b.min_x <= x0 + 15 + 12 and b.max_z >= z0 - 12 and b.min_z <= z0 + 15 + 12) {
            continue
        }
        match p.data {
            PieceData.Jigsaw(j) => {
                if j.rigid {
                    g.add_rigid(extent(p), adjustment, j.ground)
                }
                for jn in j.junctions {
                    if jn.x > x0 - 12 and jn.z > z0 - 12 and jn.x < x0 + 15 + 12 and jn.z < z0 + 15 + 12 {
                        g.add_junction(jn.x, jn.ground_y, jn.z)
                    }
                }
            },
            _ => g.add_rigid(extent(p), adjustment, 0),
        }
    }
}
