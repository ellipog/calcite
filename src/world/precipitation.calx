/// Precipitation, as `ServerLevel.tickPrecipitation` brings it to a column each time a chunk's
/// roll of one in 48 comes up, `random_tick_speed` rolls a tick (D340): water at the top freezing
/// where it's cold enough, and, while it rains, snow laid on top or one more layer of it, up to
/// the game rule `max_snow_accumulation_height`, and what the block at the top does as rain or
/// snow falls on it, by the class that declares its `handlePrecipitation`: an empty cauldron
/// fills, one time in 20 in the rain with water and one in ten in the snow with powder snow, and a
/// filled one fills a level more with what it holds. What vanilla leaves to entities, snow
/// pushing up those in its way, and to game events, a cauldron's, is left out.
module world.precipitation

import random.source.{RandomSource}
import world.block_level.{BlockLevel}
import world.chunk.{MOTION_BLOCKING}
import world.level_writer.{LevelWriter, UPDATE_ALL}
import world.natural.{SpawnLevel}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, WATER_FLUID}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env, can_survive}
import worldgen.temperature.{Temperatures}

// What each block does as rain or snow falls on it, by the class that declares its
// `handlePrecipitation`.
const NOTHING: u8 = 0
const CAULDRON: u8 = 1
const LAYERED_CAULDRON: u8 = 2
const OTHER: u8 = 3

/// What precipitation reads of the blocks: what each does as rain or snow falls on it, and the
/// cauldrons it fills.
pub struct Precipitation {
    kinds: List<u8>
    water_cauldron: u32
    powder_snow_cauldron: u32
}

impl Precipitation {
    pub fn new(facts: Facts) -> Precipitation ! String {
        var kinds = List<u8>()
        for b in 0..facts.block_count {
            kinds.push(kind_of(facts.precipitation_class(b)))
        }
        let water = facts.block_named(String("minecraft:water_cauldron")) else fail "there's no block minecraft:water_cauldron"
        let powder = facts.block_named(String("minecraft:powder_snow_cauldron")) else fail "there's no block minecraft:powder_snow_cauldron"
        return Precipitation { kinds: kinds, water_cauldron: water, powder_snow_cauldron: powder }
    }

    /// `tickPrecipitation` of the column at `x`, `z`, with the biomes' `climate` and the game rule
    /// `max_snow_accumulation_height`, `max_snow`: at the top of `MOTION_BLOCKING`, in the biome
    /// there, zoomed as `getBiome` zooms it, the water under freezes if it should, then, while it
    /// rains, snow's laid on top if it should be, and the block under, where there's rain or snow,
    /// does what it does with it. Each change is `setBlockAndUpdate`'s.
    pub fn tick<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel>(self, e: Env, level: mut L, climate: Temperatures, max_snow: i32, x: i32, z: i32) ! Thrown {
        let Env { facts: f, .. } = e
        let sea = e.ctx.sea
        let top = level.surface(MOTION_BLOCKING, x, z)
        let below = top - 1
        let biome = level.biome(x, top, z)
        if biome < 0 {
            fail Thrown { exception: "Unimplemented", message: "Precipitation where the biome isn't known" }
        }
        if should_freeze(f, level, climate, sea, biome, x, below, z) {
            _ = level.set_block(x, below, z, f.default_state(f.ids.ice), UPDATE_ALL)
        }
        if not level.raining() {
            return
        }
        if max_snow > 0 and try should_snow(e, level, climate, sea, biome, x, top, z) {
            let here = level.spawn_state(x, top, z)
            if f.is(here, f.ids.snow) {
                let layers = f.get_int(here, String("layers")) ?? 1
                if layers < max_snow.min(8) {
                    // `pushEntitiesUp` moves the entities in the way of the higher snow, which
                    // draws nothing.
                    let higher = try f.with_int(here, String("layers"), layers + 1)
                    _ = level.set_block(x, top, z, higher, UPDATE_ALL)
                }
            } else {
                _ = level.set_block(x, top, z, f.default_state(f.ids.snow), UPDATE_ALL)
            }
        }
        if not climate.has_precipitation(biome) {
            return
        }
        // `getPrecipitationAt` the block under: snow where it's too cold to rain.
        let snow = not climate.warm_enough_to_rain(biome, x, below, z, sea)
        let state = level.spawn_state(x, below, z)
        try self.handle(f, mut level, state, x, below, z, snow)
    }

    // `handlePrecipitation` of the block's class, with snow or rain.
    fn handle<L: LevelWriter + RandomSource>(self, f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, snow: bool) ! Thrown {
        let block = f.block(state)
        let kind = self.kinds[usize(block)]
        if kind == NOTHING {
            return
        }
        if kind == CAULDRON {
            // `CauldronBlock.handlePrecipitation`: filled with water in the rain, powder snow in
            // the snow.
            if not handles(mut level, snow) {
                return
            }
            let filled = if snow { self.powder_snow_cauldron } else { self.water_cauldron }
            _ = level.set_block(x, y, z, f.default_state(filled), UPDATE_ALL)
            return
        }
        if kind == LAYERED_CAULDRON {
            // `LayeredCauldronBlock.handlePrecipitation`: a level more, short of full, of what it
            // holds, water from rain and powder snow from snow.
            if not handles(mut level, snow) {
                return
            }
            let holds_snow = block == self.powder_snow_cauldron
            let level_now = f.get_int(state, String("level")) ?? 3
            if level_now == 3 or holds_snow != snow {
                return
            }
            _ = level.set_block(x, y, z, try f.with_int(state, String("level"), level_now + 1), UPDATE_ALL)
            return
        }
        fail Thrown { exception: "Unimplemented", message: "handlePrecipitation of {f.precipitation_class(block)}" }
    }
}

// `CauldronBlock.shouldHandlePrecipitation`: one time in 20 in the rain, one in ten in the snow.
fn handles<L: RandomSource>(level: mut L, snow: bool) -> bool {
    if snow {
        return level.next_float() < 0.1f32
    }
    return level.next_float() < 0.05f32
}

// `Biome.shouldFreeze` with its neighbours checked: too cold to rain at the block, which is in
// the world, with block light under 10, a water source in its liquid block, not with water on
// all four sides.
fn should_freeze<L: SpawnLevel + BlockLevel>(f: Facts, level: L, climate: Temperatures, sea: i32, biome: i32, x: i32, y: i32, z: i32) -> bool {
    if climate.warm_enough_to_rain(biome, x, y, z, sea) {
        return false
    }
    if not level.in_height(y) or level.light(false, x, y, z) >= 10 {
        return false
    }
    let here = level.spawn_state(x, y, z)
    if f.fluid(here) != WATER_FLUID or not f.is(here, f.ids.water) {
        return false
    }
    let surrounded = f.is_water(level.spawn_state(x - 1, y, z)) and f.is_water(level.spawn_state(x + 1, y, z)) and
        f.is_water(level.spawn_state(x, y, z - 1)) and f.is_water(level.spawn_state(x, y, z + 1))
    return not surrounded
}

// `Biome.shouldSnow`: snow falls at the block, which is in the world, with block light under 10,
// air or snow where snow can stay.
fn should_snow<L: SpawnLevel + BlockLevel + BlockAccess>(e: Env, level: L, climate: Temperatures, sea: i32, biome: i32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if not climate.snows(biome, x, y, z, sea) {
        return false
    }
    if not level.in_height(y) or level.light(false, x, y, z) >= 10 {
        return false
    }
    let here = level.spawn_state(x, y, z)
    if not f.is_air(here) and not f.is(here, f.ids.snow) {
        return false
    }
    return try can_survive(e, level, f.default_state(f.ids.snow), x, y, z)
}

// What a block does as rain or snow falls on it, by the name of the class that declares its
// `handlePrecipitation`.
fn kind_of(name: String) -> u8 {
    if name == "Block" {
        return NOTHING
    }
    if name == "CauldronBlock" {
        return CAULDRON
    }
    if name == "LayeredCauldronBlock" {
        return LAYERED_CAULDRON
    }
    return OTHER
}
