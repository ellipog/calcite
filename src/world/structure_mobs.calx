module world.structure_mobs

// The mobs structures spawn as worldgen places their pieces (CAL-87), made by the world's own
// code and given to worldgen through `StructureMobs`, which it can't name: each made as
// `EntityType.create` makes one with the reason `STRUCTURE`, placed, persistent where its piece
// makes it so, finalized from the region's random at the difficulty the world gives, and saved
// whole, as `ProtoChunk.addEntity` saves what a decoration adds. The IDs and UUIDs they're made
// with don't matter: the server draws each its own as it takes in the chunk (D588).

import nbt.tag.{Tag}
import pack.data.{Data}
import random.any.{AnyRandom}
import registry.builtin.{builtin_entries}
import server.log.{Entry}
import world.living.{LivingFacts}
import world.mob.{Making, Mob, Occasion, species_named, type_name}
import world.variants.{MobFacts, SpawnAt, Variants}
import worldgen.locate.{structure_tag}
import worldgen.region.{StructureMobs}
import worldgen.structures.{Structures}

// The `entity_type` registry's place among the built-in ones.
const ENTITY_TYPES: usize = 6

/// What makes structures' mobs (CAL-87): the facts a mob's made with, the difficulty they're
/// finalized at, and the moon's brightness they're finalized under, a full moon's, as a new
/// world's first day has it.
pub struct WorldgenMobs {
    pub lf: Shared<LivingFacts>
    pub facts: Shared<MobFacts>
    pub occasion: Occasion
    pub moon: f32 = 1.0f32
}

impl WorldgenMobs {
    /// Structures' mobs made with `lf` and `facts`, finalized at `occasion`.
    pub fn new(lf: own LivingFacts, facts: own MobFacts, occasion: Occasion) -> WorldgenMobs {
        return WorldgenMobs { lf: Shared(lf), facts: Shared(facts), occasion: occasion }
    }

    // What finalizing a mob of the type named `id` Calcite doesn't make draws from `random`, in
    // the biome `biome` and inside pieces of the structures `inside`, its follow range with a
    // random spawn bonus where `bonus`, for the types it knows those of: an iron golem's and an
    // elder guardian's `Mob.finalizeSpawn`'s alone; a cat's, `Cat.finalizeSpawn`, then its
    // variant, of those it may spawn as there, `VariantUtils.selectVariantToSpawn`, and its sound
    // variant, any of theirs, `pickRandomSoundVariant`, its group none so `AgeableMob`'s draws
    // for no baby. A drowned's aren't known yet (CAL-87).
    fn drawn(self, id: String, biome: i32, inside: List<String>, bonus: bool, random: mut AnyRandom) {
        if id != "minecraft:iron_golem" and id != "minecraft:elder_guardian" and id != "minecraft:cat" {
            return
        }
        // `Mob.finalizeSpawn`: the random spawn bonus where there's none, and the hand.
        if not bonus {
            _ = random.triangle(0.0, 0.11485000000000001)
        }
        _ = random.next_float()
        if id == "minecraft:cat" {
            let spawnable = self.facts.value.cat.spawnable_at(SpawnAt { biome: biome, moon: some(self.moon), inside: inside.copy() })
            if not spawnable.is_empty() {
                _ = random.next_int_below(i32.wrap(spawnable.len()))
            }
            let sounds = self.facts.value.cat_sounds.len()
            if sounds > 0 {
                _ = random.next_int_below(i32.wrap(sounds))
            }
        }
    }
}

/// `facts` with the tags its variants' structure conditions name, after `#`, resolved to their
/// structures by name, by the worldgen's data in `zip`, `structure_tag`; one that can't be read
/// holds in none.
pub fn with_structure_tags(facts: own MobFacts, zip: Data, s: Structures) -> MobFacts {
    var out = facts
    out.cow = resolved(out.cow.copy(), zip, s)
    out.pig = resolved(out.pig.copy(), zip, s)
    out.chicken = resolved(out.chicken.copy(), zip, s)
    out.cat = resolved(out.cat.copy(), zip, s)
    return out
}

fn resolved(v: own Variants, zip: Data, s: Structures) -> Variants {
    var out = v
    for i in 0..out.selectors.len() {
        for j in 0..out.selectors[i].len() {
            let names = out.selectors[i][j].structures.copy() else continue
            var all = List<String>()
            for name in names {
                if not name.starts_with("#") {
                    all.push(name.copy())
                    continue
                }
                let ok(list) = structure_tag(zip, s, name[1..]) else continue
                for st in list {
                    all.push(s.structures[st].id.copy())
                }
            }
            out.selectors[i][j].structures = some(all)
        }
    }
    return out
}

// Whether the saved mob `tag`'s follow range has its random spawn bonus, as `Mob.finalizeSpawn`
// looks before it draws one.
fn has_spawn_bonus(tag: JavaHashMap<String, Tag>) -> bool {
    if not tag.contains("attributes") {
        return false
    }
    let Tag.List(attributes) = tag["attributes"] else return false
    for a in attributes {
        let Tag.Compound(fields) = a else continue
        if not fields.contains("id") or not fields.contains("modifiers") {
            continue
        }
        let Tag.Str(id) = fields["id"] else continue
        if id != "minecraft:follow_range" and id != "follow_range" {
            continue
        }
        let Tag.List(modifiers) = fields["modifiers"] else continue
        for m in modifiers {
            let Tag.Compound(mf) = m else continue
            if mf.contains("id") {
                if let Tag.Str(mid) = mf["id"] {
                    if mid == "minecraft:random_spawn_bonus" or mid == "random_spawn_bonus" {
                        return true
                    }
                }
            }
        }
    }
    return false
}

// The ID in the `entity_type` registry of the type named `name`, or 0.
fn type_id(name: str) -> u32 {
    let entries = builtin_entries(ENTITY_TYPES)
    let short = if name.starts_with("minecraft:") { name[10..] } else { name }
    for i in 0..entries.len() {
        if entries[i] == short {
            return u32.wrap(i)
        }
    }
    return 0
}

// What a structure mob's finalizing makes besides it, a jockey's mount or rider, made as it is.
struct GenMaking {
    lf: Shared<LivingFacts>
    facts: Shared<MobFacts>
    made: List<Mob> = List<Mob>()
    riders: List<Mob> = List<Mob>()
}

impl Making for GenMaking {
    fn make_kind(mut self, species: i32, x: f64, y: f64, z: f64, biome: i32) -> Mob? {
        var mob = Mob.made(self.lf.value, self.facts.value, species, type_id(type_name(species)), 0, 0, x, y, z)
        mob.spawning_in(self.facts.value, biome)
        return some(mob)
    }

    fn add_made(mut self, mob: own Mob) {
        self.made.push(mob)
    }

    fn add_passenger(mut self, mob: own Mob) {
        self.riders.push(mob)
    }
}

impl StructureMobs for WorldgenMobs {
    fn spawn(mut self, id: str, x: f64, y: f64, z: f64, yaw: f32, pitch: f32, persistent: bool, finalize: bool, biome: i32, inside: List<String>, random: mut AnyRandom) -> List<Tag>? {
        let species = species_named(String(id)) else {
            if finalize {
                self.drawn(String(id), biome, inside, false, mut random)
            }
            return none
        }
        var mob = Mob.made(self.lf.value, self.facts.value, species, type_id(id), 0, 0, x, y, z)
        if persistent {
            mob.persistence_required = true
        }
        mob.living.snap_to(x, y, z, yaw, pitch)
        var maker = GenMaking { lf: self.lf.copy(), facts: self.facts.copy() }
        if finalize {
            mob.spawning_in(self.facts.value, biome)
            _ = mob.finalize_spawn(none, self.occasion, mut maker, mut random)
        }
        return some(saved_with(mob, maker))
    }

    fn placed(mut self, tag: JavaHashMap<String, Tag>, x: f64, y: f64, z: f64, yaw: f32, pitch: f32, finalize: bool, biome: i32, inside: List<String>, random: mut AnyRandom) -> List<Tag>? {
        if not tag.contains("id") {
            return none
        }
        let Tag.Str(name) = tag["id"] else return none
        let species = species_named(name.copy()) else {
            if finalize {
                self.drawn(name.copy(), biome, inside, has_spawn_bonus(tag), mut random)
            }
            return none
        }
        // What reading it logs isn't kept: vanilla's `createEntityIgnoreException` reports only
        // what it can't make.
        var lines = List<Entry>()
        var mob = Mob.loaded(self.lf.value, self.facts.value, type_id(type_name(species)), 0, 0, tag, mut lines) else return none
        mob.living.snap_to(x, y, z, yaw, pitch)
        mob.living.y_body_rot = yaw
        mob.living.y_head_rot = yaw
        var maker = GenMaking { lf: self.lf.copy(), facts: self.facts.copy() }
        if finalize {
            mob.spawning_in(self.facts.value, biome)
            _ = mob.finalize_spawn(none, self.occasion, mut maker, mut random)
        }
        return some(saved_with(mob, maker))
    }
}

// What `addFreshEntityWithPassengers` puts in a chunk of a mob and what its finalizing made with
// it: those made first, as they're added before it, then it, then its riders.
fn saved_with(mob: Mob, maker: GenMaking) -> List<Tag> {
    var out = List<Tag>()
    for m in maker.made {
        out.push(m.saved())
    }
    out.push(mob.saved())
    for m in maker.riders {
        out.push(m.saved())
    }
    return out
}
