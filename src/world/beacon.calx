/// Beacons ([CAL-163], D520), as vanilla's `BeaconBlockEntity.tick` runs them on a server: its
/// beam looked for, ten blocks a tick, from the beacon up to the top of its column; every 80 ticks
/// of the game, with a beam, its levels read off its base, `updateBase`, and with any its effects
/// given the players in its range, `applyEffects`, which the network gives them, and its ambient
/// sound; and, as each look ends, the beam it found kept, with the beacon's sound as it comes on
/// or goes off. The beam's colours, which the client draws, the server only counts sections of,
/// so only whether there are any is kept. Its menu's data, `beacon_data`, and the effects it may
/// pick, `valid_effects`, are here too (D521).
///
/// [CAL-163]: https://acta.aaenz.no/aaen-studios/calcite#CAL-163
module world.beacon

import nbt.tag.{Tag}
import world.block_level.{BeaconPulse, BlockLevel}
import world.effects.{ActiveEffect, effect_id}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

/// `BeaconBlockEntity.tick` of the beacon at `x`, `y`, `z` (D520). Its look for a beam starts
/// again at the beacon where it's looked below it, `lastCheckY` under its height, else goes on
/// from where it got to, so one made below 1 starts at 1 first, `lastCheckY`'s 0, and finds
/// nothing then; up to ten blocks, while under its column's top, `WORLD_SURFACE`: a beacon, stained
/// glass or a stained glass pane, a `BeaconBeamBlock`, a section of beam; another block, with no
/// section yet or as dark as 15, `getLightDampening`, but bedrock, ends the look with none, the
/// rest lengthen the section. Every 80 ticks of the game, with a beam, its levels are read off
/// its base, and with any its effects pulse, `beacon_pulse`, and its ambient sound plays. Once
/// the look reaches the top, it starts below the world next; the beam found is kept, and where
/// the levels went from none to some the activation sound plays, the `construct_beacon`
/// criterion said missing, and from some to none the deactivation. Its saved `Levels` follow its
/// levels.
pub fn beacon_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    var b = level.beacon(x, y, z)
    var check_y = 0
    if b.last_check_y < y {
        check_y = y
        b.checking = false
        b.last_check_y = y - 1
    } else {
        check_y = b.last_check_y + 1
    }
    let top = level.world_surface(x, z)
    var i = 0
    while i < 10 and check_y <= top {
        let state = try level.state(f, x, check_y, z)
        if beam_block(f, state) {
            b.checking = true
        } else if not b.checking or (f.light_dampening(state) >= 15 and f.block(state) != f.ids.bedrock) {
            b.checking = false
            b.last_check_y = top
            break
        }
        check_y += 1
        b.last_check_y += 1
        i += 1
    }
    let previous = b.levels
    let (cx, cy, cz) = (f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)
    if level.time_now() % 80 == 0 {
        if b.beam {
            b.levels = try base_levels(f, level, x, y, z)
        }
        if b.levels > 0 and b.beam {
            let tags = level.block_entity_tag(x, y, z)
            level.beacon_pulse(BeaconPulse { x: x, y: y, z: z, levels: b.levels, primary: power(tags.copy(), "primary_effect"), secondary: power(tags, "secondary_effect") })
            level.play_sound_at(cx, cy, cz, String("block.beacon.ambient"), 1.0f32, 1.0f32)
        }
    }
    if b.last_check_y >= top {
        b.last_check_y = level.min_y() - 1
        b.beam = b.checking
        let was = previous > 0
        let now = b.levels > 0
        if not was and now {
            level.play_sound_at(cx, cy, cz, String("block.beacon.activate"), 1.0f32, 1.0f32)
            level.unimplemented(String("The construct_beacon criterion of the players by a beacon as it comes on"))
        } else if was and not now {
            level.play_sound_at(cx, cy, cz, String("block.beacon.deactivate"), 1.0f32, 1.0f32)
        }
    }
    if b.levels != previous {
        level.keep_block_entity_value(x, y, z, "Levels", Tag.Int(b.levels))
    }
    level.set_beacon(x, y, z, b)
}

/// The effect a beacon of `levels` gives a player, `new MobEffectInstance(power, (9 + levels * 2)
/// * 20, amplifier, true, true)` (D520): its effect `name` for 9 seconds and 2 more a level, at
/// `amplifier`, ambient, its particles and icon shown; none where `name` isn't an effect.
pub fn beacon_effect(name: own String, levels: i32, amplifier: i32) -> ActiveEffect? {
    var made = JavaHashMap<String, Tag>()
    made.insert(String("id"), Tag.Str(name))
    made.insert(String("duration"), Tag.Int((9 + levels * 2) * 20))
    made.insert(String("amplifier"), Tag.Byte(i8.wrap(amplifier)))
    made.insert(String("ambient"), Tag.Byte(1i8))
    made.insert(String("show_particles"), Tag.Byte(1i8))
    made.insert(String("show_icon"), Tag.Byte(1i8))
    return ActiveEffect.read(Tag.Compound(made))
}

/// A beacon's block entity as `loadAdditional` leaves it, from its saved `tag` (D520): its levels
/// 0, as `Levels` is saved but not read, till its base is next read.
pub fn loaded_beacon(tag: own Tag) -> Tag {
    let Tag.Compound(m) = tag.copy() else return tag
    if not m.contains("id") {
        return tag
    }
    let Tag.Str(id) = m["id"] else return tag
    if id != "minecraft:beacon" {
        return tag
    }
    var out = m.copy()
    if out.contains("Levels") {
        out.insert(String("Levels"), Tag.Int(0))
    }
    return Tag.Compound(out)
}

/// A beacon's menu's data slots, as its `dataAccess` reads them (D521): its `levels`, then its
/// primary and secondary effects from its saved `tags`, each `BeaconMenu.encodeEffect`'s, its ID
/// in the `mob_effect` registry and 1 more, 0 for none.
pub fn beacon_data(levels: i32, tags: Tag?) -> List<i32> {
    return [levels, encoded(power(tags.copy(), "primary_effect")), encoded(power(tags, "secondary_effect"))]
}

/// `BeaconBlockEntity.validateEffects` (D521): whether a beacon of `levels` may give the effects
/// `primary` and `secondary`, named with `minecraft:`, empty for none, as its menu picks them: no
/// secondary under 4 levels; neither of a tier above its levels, one that's no beacon's above
/// them all, `getRequiredLevelsFor`; a primary of the first three tiers; and a secondary of none,
/// of the fourth or the primary again. A secondary of the first three with no primary, which
/// vanilla's `primary.equals` would throw at, isn't.
pub fn valid_effects(primary: String, secondary: String, levels: i32) -> bool {
    if not secondary.is_empty() and levels < 4 {
        return false
    }
    let (p, s) = (tier(primary.copy()), tier(secondary.copy()))
    if p > levels or s > levels or p >= 4 {
        return false
    }
    return s == 0 or s >= 4 or (not primary.is_empty() and primary == secondary)
}

// `getRequiredLevelsFor`: the tier of `BEACON_EFFECTS` the effect `name` is in, speed and haste
// the first, resistance and jump boost the second, strength the third and regeneration the
// fourth; 0 for none, and the most an int holds for one that's no beacon's.
fn tier(name: String) -> i32 {
    if name.is_empty() {
        return 0
    }
    if name == "minecraft:speed" or name == "minecraft:haste" {
        return 1
    }
    if name == "minecraft:resistance" or name == "minecraft:jump_boost" {
        return 2
    }
    if name == "minecraft:strength" {
        return 3
    }
    if name == "minecraft:regeneration" {
        return 4
    }
    return 2147483647
}

// `BeaconMenu.encodeEffect` of the effect `name`: its ID and 1 more, 0 for none.
fn encoded(name: String) -> i32 {
    if name.is_empty() {
        return 0
    }
    return (effect_id(name) ?? -1) + 1
}

// Whether the block `state` is of a `BeaconBeamBlock`: a beacon, stained glass or a stained glass
// pane.
fn beam_block(f: Facts, state: u32) -> bool {
    let class = f.class_name(f.block(state))
    return class == "BeaconBlock" or class == "StainedGlassBlock" or class == "StainedGlassPaneBlock"
}

// `updateBase` of the beacon at `x`, `y`, `z`: its levels, how many of the 3 by 3, 5 by 5, 7 by 7
// and 9 by 9 layers under it, from the top, within the world, are all `#beacon_base_blocks`.
fn base_levels<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let base = f.tag(String("minecraft:beacon_base_blocks"))
    var levels = 0
    var step = 1
    while step <= 4 {
        let ly = y - step
        if ly < level.min_y() {
            break
        }
        var whole = true
        var lx = x - step
        while lx <= x + step and whole {
            var lz = z - step
            while lz <= z + step {
                if not base.contains(f.block(try level.state(f, lx, ly, lz))) {
                    whole = false
                    break
                }
                lz += 1
            }
            lx += 1
        }
        if not whole {
            break
        }
        levels = step
        step += 1
    }
    return levels
}

// The effect a beacon's saved `key` names, `loadEffect`, by its name with its namespace: one of
// `BEACON_EFFECTS`', speed, haste, resistance, jump boost, strength or regeneration, else none,
// empty.
fn power(tags: Tag?, key: str) -> String {
    let t = tags else return String()
    let Tag.Compound(m) = t else return String()
    if not m.contains(key) {
        return String()
    }
    let Tag.Str(named) = m[key] else return String()
    let bare = if named.starts_with("minecraft:") { named[10..].copy() } else { named.copy() }
    let valid: List<str> = ["speed", "haste", "resistance", "jump_boost", "strength", "regeneration"]
    for v in valid {
        if bare == String(v) {
            return "minecraft:{bare}"
        }
    }
    return String()
}
