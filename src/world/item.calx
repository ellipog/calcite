/// Item stacks, as vanilla's `ItemStack` holds them, with the components each changes of its
/// item's, and as `ItemStack.OPTIONAL_STREAM_CODEC` reads and sends them, with
/// `registry.streams` and the registries, as vanilla's `RegistryFriendlyByteBuf` has them
/// (CAL-77, D366). A packet's `Wire` has no registries, so a packet holds a stack as a
/// `SentStack`, which `ItemStack.sent` writes, and a merchant's offers as `SentOffers` (CAL-160).
module world.item

import json.tree.{Json}
import nbt.tag.{Tag}
import protocol.wire.{DecodeError, Reader, Wire, Writer}
import registry.codec.{Codecs}
import registry.components.{apply_wire}
import registry.registries.{Registries}
import registry.streams.{Decoded, Streams}

/// Some of an item, or nothing in a slot.
pub struct ItemStack {
    /// Its item's whole ID, `minecraft:air` for nothing.
    pub item: String
    /// How many, 0 for nothing.
    pub count: i32 = 0
    /// What it changes of its item's components, in the order its patch keeps them: each type's
    /// whole ID, or `!` and the ID of one taken away, with its value as its codec writes it to
    /// NBT, and as the network gave it, whose maps' order it's sent again in.
    pub patch: List<(String, Tag, Json)>
}

impl ItemStack {
    /// Nothing, as `ItemStack.EMPTY`.
    pub fn empty() -> ItemStack {
        return ItemStack { item: String("minecraft:air"), count: 0, patch: List<(String, Tag, Json)>() }
    }

    /// `count` of `item`, a whole ID, with its item's components.
    pub fn of(item: own String, count: i32) -> ItemStack {
        return ItemStack { item: item, count: count, patch: List<(String, Tag, Json)>() }
    }

    /// The stack `t` is, as `ItemStack.CODEC` writes it: its `id`, its `count`, 1 where it has
    /// none, and its `components`, in their order, each value as it is, or `!` and the ID of one
    /// taken away. Anything else is nothing.
    pub fn from_saved(t: Tag) -> ItemStack {
        let Tag.Compound(m) = t else return ItemStack.empty()
        if not m.contains("id") {
            return ItemStack.empty()
        }
        let item = match m["id"] {
            Tag.Str(s) => s.copy(),
            _ => return ItemStack.empty(),
        }
        var count: i32 = 1
        if m.contains("count") {
            match m["count"] {
                Tag.Int(n) => count = n,
                _ => {},
            }
        }
        var patch = List<(String, Tag, Json)>()
        if m.contains("components") {
            match m["components"] {
                Tag.Compound(p) => {
                    for (k, v) in p {
                        if k.starts_with("!") {
                            patch.push((k.copy(), Tag.Compound(JavaHashMap<String, Tag>()), Json.Null))
                        } else {
                            patch.push((k.copy(), v.copy(), v.to_typed_json()))
                        }
                    }
                },
                _ => {},
            }
        }
        return ItemStack { item: item, count: count, patch: patch }
    }

    /// Whether it's nothing, as `ItemStack.isEmpty`: air, or none of anything.
    pub fn is_empty(self) -> bool {
        return self.count <= 0 or self.item == "minecraft:air"
    }

    /// Reads a stack as `ItemStack.OPTIONAL_STREAM_CODEC` does, with `streams` and the registries
    /// `r`, and makes it as `ItemStack`'s constructor does, with `c`, whose `item_defaults` are
    /// its item's components: its patch applied to them, which leaves out what's the same as the
    /// item's. What vanilla throws is the error, as its `toString` gives it.
    pub fn read(rd: mut Reader, streams: Streams, c: mut Codecs, r: Registries) -> ItemStack ! DecodeError {
        return match streams.read_stack(mut rd, c, r) {
            Decoded.Empty => ItemStack.empty(),
            Decoded.Bad(message) => {
                fail DecodeError { message: message }
            },
            Decoded.Missing(name) => {
                fail DecodeError { message: "Calcite reads the stream of {name} not yet" }
            },
            Decoded.Stack(s) => {
                let applied = apply_wire(mut c, s, r)
                ItemStack { item: s.item.copy(), count: s.count, patch: applied.patch }
            },
        }
    }

    /// The stack as `ItemStack.OPTIONAL_STREAM_CODEC` writes it, with `streams` and the
    /// registries `r`, for a packet to send: its count, 0 for nothing, its item by its network
    /// ID, and its patch.
    pub fn sent(self, streams: Streams, r: Registries) -> SentStack {
        var w = Writer.new()
        streams.write_parts(self.item.copy(), self.count, self.patch, r, mut w)
        let problem = w.problem()
        return SentStack { bytes: w.into_bytes(), problem: problem }
    }
}

/// A stack in a packet, written as `ItemStack.OPTIONAL_STREAM_CODEC` writes it by
/// `ItemStack.sent`, with the registries a packet's `Wire` doesn't have.
pub struct SentStack {
    bytes: List<u8>
    // Why it couldn't be written, a type or an entry the registries don't have, which only a
    // broken build gives, and which stops the packet as an encoder's exception does.
    problem: String?
}

impl SentStack {
    /// Nothing, a count of 0.
    pub fn empty() -> SentStack {
        return SentStack { bytes: [0], problem: none }
    }
}

/// A merchant's offers in a packet, each as `MerchantOffer.CODEC` saves it, written as
/// `MerchantOffers.STREAM_CODEC` writes them by `SentOffers.of`, with the registries a packet's
/// `Wire` doesn't have (CAL-160).
pub struct SentOffers {
    bytes: List<u8>
    // Why they couldn't be written, as a stack's.
    problem: String?
}

impl SentOffers {
    /// The offers `offers`, written with `streams` and the registries `r`.
    pub fn of(offers: List<Tag>, streams: Streams, r: Registries) -> SentOffers {
        var w = Writer.new()
        streams.write_offers(offers, r, mut w)
        let problem = w.problem()
        return SentOffers { bytes: w.into_bytes(), problem: problem }
    }
}

/// Offers as a packet holds them. Reading them takes the registries, which no reader of a
/// packet's has, so only none are read.
impl Wire for SentOffers {
    fn read(r: mut Reader) -> SentOffers ! DecodeError {
        let count = try r.varint()
        if count != 0 {
            fail DecodeError { message: String("a merchant's offers are read with the registries") }
        }
        return SentOffers { bytes: [0], problem: none }
    }

    fn write(self, w: mut Writer) {
        if let p = self.problem {
            w.refuse(p.copy())
            return
        }
        w.raw(self.bytes)
    }
}

/// An entity's equipment as `ClientboundSetEquipmentPacket` sends it (CAL-156): each slot by its
/// place in `EquipmentSlot`'s order, with 128 where another follows, then its stack.
pub struct WornSlots {
    pub slots: List<WornSlot>
}

/// A slot of it, and its stack.
pub struct WornSlot {
    pub slot: i32
    pub stack: SentStack
}

impl Wire for WornSlots {
    fn read(r: mut Reader) -> WornSlots ! DecodeError {
        var out = List<WornSlot>()
        loop {
            let b = i32(try r.u8())
            let stack = try SentStack.read(mut r)
            out.push(WornSlot { slot: b & 127, stack: stack })
            if b & 128 == 0 {
                break
            }
        }
        return WornSlots { slots: out }
    }

    fn write(self, w: mut Writer) {
        for i in 0..self.slots.len() {
            let more = if i + 1 < self.slots.len() { 128 } else { 0 }
            w.u8(u8.wrap(self.slots[i].slot | more))
            self.slots[i].stack.write(mut w)
        }
    }
}

/// A stack as a packet holds it. Reading one with components takes the registries, so a packet
/// with such a stack is read with `ItemStack.read`.
impl Wire for SentStack {
    fn read(r: mut Reader) -> SentStack ! DecodeError {
        let count = try r.varint()
        if count <= 0 {
            return SentStack.empty()
        }
        let item = try r.varint()
        let added = try r.varint()
        let removed = try r.varint()
        if added != 0 or removed != 0 {
            fail DecodeError { message: String("a stack's components are read with the registries, by `ItemStack.read`") }
        }
        var w = Writer.new()
        w.varint(count)
        w.varint(item)
        w.varint(0)
        w.varint(0)
        return SentStack { bytes: w.into_bytes(), problem: none }
    }

    fn write(self, w: mut Writer) {
        if let p = self.problem {
            w.refuse(p.copy())
            return
        }
        w.raw(self.bytes)
    }
}
