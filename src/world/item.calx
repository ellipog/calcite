/// Item stacks, as vanilla's `ItemStack` holds them and `ItemStack.OPTIONAL_STREAM_CODEC` sends
/// them. Calcite has no item components yet, so a stack is its item and count.
module world.item

import protocol.wire.{Reader, Writer, DecodeError, Wire}

/// Some of an item, or nothing in a slot.
pub struct ItemStack {
    /// The item's ID in the `item` registry.
    pub item: i32 = 0
    /// How many, 0 for an empty stack.
    pub count: i32 = 0
}

impl ItemStack {
    /// Nothing, as `ItemStack.EMPTY`.
    pub fn empty() -> ItemStack {
        return ItemStack()
    }

    pub fn is_empty(self) -> bool {
        return self.count <= 0
    }
}

/// A stack as vanilla's optional codec sends it: its count, then for one that isn't empty, its
/// item and the components it changes from its item's, which Calcite can't read yet.
impl Wire for ItemStack {
    fn read(r: mut Reader) -> ItemStack ! DecodeError {
        let count = try r.varint()
        if count <= 0 {
            return ItemStack.empty()
        }
        let item = try r.varint()
        let added = try r.varint()
        let removed = try r.varint()
        if added != 0 or removed != 0 {
            fail DecodeError { message: "Calcite can't read item components yet" }
        }
        return ItemStack { item: item, count: count }
    }

    fn write(self, w: mut Writer) {
        if self.is_empty() {
            w.varint(0)
            return
        }
        w.varint(self.count)
        w.varint(self.item)
        w.varint(0)
        w.varint(0)
    }
}
