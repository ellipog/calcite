/// The scoreboard, vanilla's `ServerScoreboard` (CAL-164): its objectives, each with its criteria,
/// its display name and how its scores are shown; each holder's scores, a player's by their name;
/// which objective each display slot shows, `DisplaySlot`; and the teams, with their players. Read
/// from the world's saved data `scoreboard`, `ScoreboardSaveData`, as vanilla reads it, and saved
/// as it packs it, in its maps' orders: the objectives and the holders by fastutil's tables at a
/// load factor of 0.5, a holder's scores in the order they came, where vanilla's go by its
/// objectives' identity hashes, so not in the same order from run to run, the teams by fastutil's
/// table, and a team's players as Java's `HashSet` keeps them. Its components, display names,
/// prefixes and the like, are kept as NBT, as the codecs wrote them, which is what they're sent as.
/// Commands, which change the rest of it, come with P6.6.
module world.scoreboard

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data type the scoreboard is saved as, `ScoreboardSaveData.TYPE`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "scoreboard" }
}

/// How many display slots there are, `DisplaySlot.values()`.
pub const SLOTS: usize = 19

/// The name of the display slot `id`, as `DisplaySlot` serializes it: `list`, `sidebar`,
/// `below_name`, then the sidebars of the teams of each color, by the colors' IDs.
pub fn slot_name(id: usize) -> String {
    return match id {
        0 => String("list"),
        1 => String("sidebar"),
        2 => String("below_name"),
        _ => "sidebar.team.{color_name(i32.wrap(id) - 3)}",
    }
}

// The ID of the display slot named `name`, if there's one.
fn slot_of(name: String) -> usize? {
    for id in 0..SLOTS {
        if slot_name(id) == name {
            return some(id)
        }
    }
    return none
}

/// The name of the team color `id`, `TeamColor`, which is that of the chat formatting it colors
/// with.
pub fn color_name(id: i32) -> str {
    return match id {
        0 => "black",
        1 => "dark_blue",
        2 => "dark_green",
        3 => "dark_aqua",
        4 => "dark_red",
        5 => "dark_purple",
        6 => "gold",
        7 => "gray",
        8 => "dark_gray",
        9 => "blue",
        10 => "green",
        11 => "aqua",
        12 => "red",
        13 => "light_purple",
        14 => "yellow",
        _ => "white",
    }
}

// The ID of the team color named `name`, if there's one.
fn color_of(name: String) -> i32? {
    for id in 0..16 {
        if name == String(color_name(id)) {
            return some(id)
        }
    }
    return none
}

// The names of a team's `Visibility`s, by their IDs, and of its `CollisionRule`s.
fn visibility_name(id: i32) -> str {
    return match id {
        1 => "never",
        2 => "hideForOtherTeams",
        3 => "hideForOwnTeam",
        _ => "always",
    }
}

fn collision_name(id: i32) -> str {
    return match id {
        1 => "never",
        2 => "pushOtherTeams",
        3 => "pushOwnTeam",
        _ => "always",
    }
}

// The ID of the visibility or collision rule named `name`, by `names`, if there's one.
fn rule_of(name: String, collision: bool) -> i32? {
    for id in 0..4 {
        let known = if collision { collision_name(id) } else { visibility_name(id) }
        if name == String(known) {
            return some(id)
        }
    }
    return none
}

/// An objective, `Objective`: its name, its criteria's name, as `dummy` or a stat's, such as
/// `minecraft.custom:minecraft.jump`, its display name, whether its scores are shown as hearts,
/// `RenderType.HEARTS`, whether its scores' display names follow their holders',
/// `displayAutoUpdate`, and its number format, as NBT, where it has one.
pub struct Objective {
    pub name: String
    pub criteria: String
    pub display_name: Tag
    pub hearts: bool = false
    pub auto_update: bool = false
    pub format: Tag? = none
}

/// A holder's score of an objective, `Score`: its value, whether it's locked, which a new one
/// is, the text shown for its holder and its own number format, where it has them.
pub struct Score {
    pub value: i32 = 0
    pub locked: bool = true
    pub display: Tag? = none
    pub format: Tag? = none
}

/// A team, `PlayerTeam`: its display name, its color's ID where it has one, whether its players
/// may hurt each other and see each other invisible, their names' prefix and suffix, the IDs of
/// its name tags' and death messages' visibilities and of its collision rule, and its players'
/// names, as its `HashSet` keeps them.
pub struct Team {
    pub name: String
    pub display_name: Tag
    pub color: i32? = none
    pub friendly_fire: bool = true
    pub see_invisibles: bool = true
    pub prefix: Tag
    pub suffix: Tag
    pub name_tags: i32 = 0
    pub death_messages: i32 = 0
    pub collision: i32 = 0
    pub players: JavaHashSet<String> = JavaHashSet<String>()
}

impl Team {
    /// Its options, `packOptions`: friendly fire 1, seeing friendly invisibles 2.
    pub fn options(self) -> i8 {
        var out: i8 = 0
        if self.friendly_fire {
            out |= 1
        }
        if self.see_invisibles {
            out |= 2
        }
        return out
    }
}

/// A score the players are to be told of, its objective being shown, as `onScoreChanged` sends
/// one: whose, of which objective, and the score.
pub struct ScoreSent {
    pub owner: String
    pub objective: String
    pub value: i32
    pub display: Tag?
    pub format: Tag?
}

/// The scoreboard.
pub struct Scoreboard {
    /// The objectives, by name, `objectivesByName`, and their names in the order they were
    /// added, as `objectivesByCriteria`'s lists have them.
    pub objectives: OpenHashMap<String, Objective> = OpenHashMap<String, Objective>(16, 0.5f32)
    pub added: List<String> = List<String>()
    /// Each holder's scores, by objective, `playerScores`.
    pub scores: OpenHashMap<String, LinkedMap<String, Score>> = OpenHashMap<String, LinkedMap<String, Score>>(16, 0.5f32)
    /// The objective each display slot shows, by its ID, `displayObjectives`: none for each, or
    /// none at all for a scoreboard made without `fresh`, as a test's world's.
    pub display: List<String?> = List<String?>()
    /// The teams by name, `teamsByName`, and each player's team, `teamsByPlayer`.
    pub teams: OpenHashMap<String, Team> = OpenHashMap<String, Team>(16, 0.75f32)
    pub team_of: OpenHashMap<String, String> = OpenHashMap<String, String>(16, 0.75f32)
    // What it was last read or saved as, which it's saved again only once it's no longer, as
    // `setData` marks it; none where it's to be saved, as a new one is.
    last: Tag? = none
}

impl Scoreboard {
    /// An empty one, as `computeIfAbsent` makes it where there's no file: to be saved.
    pub fn fresh() -> Scoreboard {
        var out = Scoreboard()
        for _ in 0..SLOTS {
            out.display.push(none)
        }
        return out
    }

    /// The scoreboard in the saved data's `root`, as `ServerScoreboard.load` loads what
    /// `ScoreboardSaveData.Packed.CODEC` reads: its objectives, then its scores, a score of an
    /// objective there isn't left out with vanilla's error, then its display slots, then its
    /// teams, each player put in its team. It's saved again only once it's changed. What isn't
    /// as vanilla writes it is left out.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Scoreboard {
        var out = Scoreboard.fresh()
        let data = match at(root, "data") {
            some(Tag.Compound(d)) => d.copy(),
            some(other) => {
                lines.push(parse_failed(saved_id(), "Not a map: {other.to_snbt()}"))
                return out
            },
            none => {
                lines.push(parse_failed(saved_id(), String("Not a map: null")))
                return out
            },
        }
        if let Tag.List(each) = at(data, "Objectives") ?? Tag.End {
            for t in each {
                if let Tag.Compound(o) = t {
                    out.load_objective(o)
                }
            }
        }
        if let Tag.List(each) = at(data, "PlayerScores") ?? Tag.End {
            for t in each {
                if let Tag.Compound(s) = t {
                    out.load_score(s, mut lines)
                }
            }
        }
        if let Tag.Compound(slots) = at(data, "DisplaySlots") ?? Tag.End {
            for (slot, name) in slots {
                if let id = slot_of(slot.copy()) {
                    if let Tag.Str(n) = name {
                        out.display[id] = if out.objectives.contains(n) { some(n.copy()) } else { none }
                    }
                }
            }
        }
        if let Tag.List(each) = at(data, "Teams") ?? Tag.End {
            for t in each {
                if let Tag.Compound(m) = t {
                    out.load_team(m, mut lines)
                }
            }
        }
        out.last = some(out.pack())
        return out
    }

    // `loadObjective`, `addObjective`: one whose name's taken already is left out.
    fn load_objective(mut self, o: JavaHashMap<String, Tag>) {
        let name = text(o, "Name") else return
        let shown = at(o, "DisplayName") else return
        if self.objectives.contains(name) {
            return
        }
        let objective = Objective {
            name: name.copy(),
            criteria: text(o, "CriteriaName") ?? String("dummy"),
            display_name: shown.copy(),
            hearts: text(o, "RenderType") == some(String("hearts")),
            auto_update: flag(o, "display_auto_update", false),
            format: at(o, "format"),
        }
        self.objectives.insert(name.copy(), objective)
        self.added.push(name)
    }

    // `loadPlayerScore`: the score set, `setScore`, of an objective there is.
    fn load_score(mut self, s: JavaHashMap<String, Tag>, lines: mut List<Entry>) {
        let owner = text(s, "Name") else return
        let objective = text(s, "Objective") else return
        if not self.objectives.contains(objective) {
            lines.push(Entry.error("Unknown objective {objective} for name {owner}, ignoring"))
            return
        }
        let score = Score {
            value: match at(s, "Score") {
                some(t) => t.number_int() ?? 0,
                none => 0,
            },
            locked: flag(s, "Locked", false),
            display: at(s, "display"),
            format: at(s, "format"),
        }
        if not self.scores.contains(owner) {
            self.scores.insert(owner.copy(), LinkedMap<String, Score>())
        }
        self.scores[owner].insert(objective, score)
    }

    // `loadPlayerTeam`: the team added, `addPlayerTeam`, which warns of one that's there already
    // and keeps it, then set as it was saved, then each of its players put in it, out of any
    // other.
    fn load_team(mut self, m: JavaHashMap<String, Tag>, lines: mut List<Entry>) {
        let name = text(m, "Name") else return
        if self.teams.contains(name) {
            lines.push(Entry.warn("Requested creation of existing team '{name}'"))
        } else {
            let made = Team { name: name.copy(), display_name: Tag.Str(name.copy()), prefix: Tag.Str(String()), suffix: Tag.Str(String()) }
            self.teams.insert(name.copy(), made)
        }
        if let shown = at(m, "DisplayName") {
            self.teams[name].display_name = shown
        }
        self.teams[name].color = match text(m, "TeamColor") {
            some(c) => color_of(c),
            none => none,
        }
        self.teams[name].friendly_fire = flag(m, "AllowFriendlyFire", true)
        self.teams[name].see_invisibles = flag(m, "SeeFriendlyInvisibles", true)
        self.teams[name].prefix = at(m, "MemberNamePrefix") ?? Tag.Str(String())
        self.teams[name].suffix = at(m, "MemberNameSuffix") ?? Tag.Str(String())
        self.teams[name].name_tags = rule(m, "NameTagVisibility", false)
        self.teams[name].death_messages = rule(m, "DeathMessageVisibility", false)
        self.teams[name].collision = rule(m, "CollisionRule", true)
        if let Tag.List(players) = at(m, "Players") ?? Tag.End {
            for p in players {
                if let Tag.Str(player) = p {
                    self.join(player.copy(), name.copy())
                }
            }
        }
    }

    // `addPlayerToTeam`: the player out of the team they were in, then in `team`.
    fn join(mut self, player: String, team: String) {
        if self.team_of.contains(player) {
            let was = self.team_of[player].copy()
            if self.teams.contains(was) {
                self.teams[was].players.remove(player)
            }
        }
        self.team_of.insert(player.copy(), team.copy())
        self.teams[team].players.insert(player.copy())
    }

    /// `ScoreboardSaveData.Packed` as `store` packs it and its codec writes it: each list or map
    /// that isn't empty, and in each, the fields that aren't their defaults. Vanilla packs its
    /// maps through streams, whose spliterators go over fastutil's tables from the front, where
    /// their iterators, which the join's packets come in the order of, go from the back; a name is
    /// never the null key. So the objectives, the holders and the teams go the other way round.
    pub fn pack(self) -> Tag {
        var data = JavaHashMap<String, Tag>()
        var objectives = List<Tag>()
        for (name, o) in self.objectives {
            var m = JavaHashMap<String, Tag>()
            m.insert(String("Name"), Tag.Str(name.copy()))
            if o.criteria != "dummy" {
                m.insert(String("CriteriaName"), Tag.Str(o.criteria.copy()))
            }
            m.insert(String("DisplayName"), o.display_name.copy())
            if o.hearts {
                m.insert(String("RenderType"), Tag.Str(String("hearts")))
            }
            if o.auto_update {
                m.insert(String("display_auto_update"), Tag.Byte(1))
            }
            if let f = o.format {
                m.insert(String("format"), f.copy())
            }
            objectives.push(Tag.Compound(m))
        }
        if not objectives.is_empty() {
            data.insert(String("Objectives"), Tag.List(backwards(objectives)))
        }
        var holders = List<List<Tag>>()
        for (owner, held) in self.scores {
            var scores = List<Tag>()
            for (objective, s) in held {
                var m = JavaHashMap<String, Tag>()
                m.insert(String("Name"), Tag.Str(owner.copy()))
                m.insert(String("Objective"), Tag.Str(objective.copy()))
                if s.value != 0 {
                    m.insert(String("Score"), Tag.Int(s.value))
                }
                if s.locked {
                    m.insert(String("Locked"), Tag.Byte(1))
                }
                if let d = s.display {
                    m.insert(String("display"), d.copy())
                }
                if let f = s.format {
                    m.insert(String("format"), f.copy())
                }
                scores.push(Tag.Compound(m))
            }
            holders.push(scores)
        }
        var scores = List<Tag>()
        var h = holders.len()
        while h > 0 {
            h -= 1
            for t in holders[h] {
                scores.push(t.copy())
            }
        }
        if not scores.is_empty() {
            data.insert(String("PlayerScores"), Tag.List(scores))
        }
        var slots = JavaHashMap<String, Tag>()
        for id in 0..self.display.len() {
            if let name = self.display[id] {
                slots.insert(slot_name(id), Tag.Str(name.copy()))
            }
        }
        if not slots.is_empty() {
            data.insert(String("DisplaySlots"), Tag.Compound(slots))
        }
        var teams = List<Tag>()
        for (name, t) in self.teams {
            var m = JavaHashMap<String, Tag>()
            m.insert(String("Name"), Tag.Str(name.copy()))
            m.insert(String("DisplayName"), t.display_name.copy())
            if let c = t.color {
                m.insert(String("TeamColor"), Tag.Str(String(color_name(c))))
            }
            if not t.friendly_fire {
                m.insert(String("AllowFriendlyFire"), Tag.Byte(0))
            }
            if not t.see_invisibles {
                m.insert(String("SeeFriendlyInvisibles"), Tag.Byte(0))
            }
            if t.prefix != Tag.Str(String()) {
                m.insert(String("MemberNamePrefix"), t.prefix.copy())
            }
            if t.suffix != Tag.Str(String()) {
                m.insert(String("MemberNameSuffix"), t.suffix.copy())
            }
            if t.name_tags != 0 {
                m.insert(String("NameTagVisibility"), Tag.Str(String(visibility_name(t.name_tags))))
            }
            if t.death_messages != 0 {
                m.insert(String("DeathMessageVisibility"), Tag.Str(String(visibility_name(t.death_messages))))
            }
            if t.collision != 0 {
                m.insert(String("CollisionRule"), Tag.Str(String(collision_name(t.collision))))
            }
            var players = List<Tag>()
            for p in t.players {
                players.push(Tag.Str(p.copy()))
            }
            if not players.is_empty() {
                m.insert(String("Players"), Tag.List(players))
            }
            teams.push(Tag.Compound(m))
        }
        if not teams.is_empty() {
            data.insert(String("Teams"), Tag.List(backwards(teams)))
        }
        return Tag.Compound(data)
    }

    /// What's to be saved, as `storeToSaveDataIfDirty` packs it and `setData` marks it: none where
    /// it's what it was last read or saved as.
    pub fn take_save(mut self) -> Tag? {
        let now = self.pack()
        if self.last == some(now.copy()) {
            return none
        }
        self.last = some(now.copy())
        return some(now)
    }

    /// Whether the objective `name` is shown in a display slot, so its scores are sent as they
    /// change, `trackedObjectives`, as loading it starts tracking those shown.
    pub fn tracked(self, name: String) -> bool {
        for id in 0..self.display.len() {
            if self.display[id] == some(name.copy()) {
                return true
            }
        }
        return false
    }

    /// Whether any objective is shown, so that a holder's scores all going is sent.
    pub fn any_tracked(self) -> bool {
        for id in 0..self.display.len() {
            if self.display[id] != none {
                return true
            }
        }
        return false
    }

    /// Whether any objective's scores follow their holders' display names, `displayAutoUpdate`,
    /// which only then are made.
    pub fn follows_names(self) -> bool {
        for (_, o) in self.objectives {
            if o.auto_update {
                return true
            }
        }
        return false
    }

    /// `forAllObjectives` resetting each of the holder's scores of the criteria `criteria`,
    /// `ScoreAccess.reset`: made where there's none, as `getOrCreatePlayerScore` makes it, then
    /// taken away, `resetSinglePlayerScore`, and the holder with it where they've no other. What
    /// the players are to be told of, in turn: the holder, and the objective, or none where it's
    /// the last of the holder's scores that went, sent where any objective's shown.
    pub fn reset_for(mut self, criteria: String, holder: String) -> List<(String, String?)> {
        var out = List<(String, String?)>()
        for name in self.added.copy() {
            if self.objectives[name].criteria != criteria {
                continue
            }
            if not self.scores.contains(holder) {
                self.scores.insert(holder.copy(), LinkedMap<String, Score>())
            }
            if not self.scores[holder].contains(name) {
                self.scores[holder].insert(name.copy(), Score())
            }
            _ = self.scores[holder].remove(name)
            if self.scores[holder].is_empty() {
                _ = self.scores.remove(holder)
                if self.any_tracked() {
                    out.push((holder.copy(), none))
                }
            } else if self.tracked(name.copy()) {
                out.push((holder.copy(), some(name.copy())))
            }
        }
        return out
    }

    /// The team the player `name` is in, `getPlayersTeam`, if they're in one.
    pub fn team(self, name: String) -> Team? {
        if not self.team_of.contains(name) {
            return none
        }
        let t = self.team_of[name].copy()
        if not self.teams.contains(t) {
            return none
        }
        return some(self.teams[t].copy())
    }

    /// The scores of the objective `name`, `listPlayerScores`, in the holders' order.
    pub fn scores_of(self, name: String) -> List<ScoreSent> {
        var out = List<ScoreSent>()
        for (owner, held) in self.scores {
            if held.contains(name) {
                let s = held[name].copy()
                out.push(ScoreSent { owner: owner.copy(), objective: name.copy(), value: s.value, display: s.display, format: s.format })
            }
        }
        return out
    }

    /// `forAllObjectives(criteria, holder, ...)` adding `count` to each of the holder's scores of
    /// the objectives of the criteria `criteria`, `ScoreAccess.add`, those they haven't made,
    /// `getOrCreatePlayerScore`. `shown` is the holder's display name, which an objective that
    /// follows it sets on its score. What the players are to be told of, in turn.
    pub fn add_for(mut self, criteria: String, holder: String, shown: Tag?, count: i32) -> List<ScoreSent> {
        return self.for_all(criteria, holder, shown, count, none)
    }

    /// `forAllObjectives` setting each of the holder's scores of the criteria `criteria` to
    /// `value`, `ScoreAccess.set`, as `updateScoreForCriteria` sets health and the like.
    pub fn set_for(mut self, criteria: String, holder: String, shown: Tag?, value: i32) -> List<ScoreSent> {
        return self.for_all(criteria, holder, shown, 0, some(value))
    }

    // Each objective of `criteria`, in the order they were added, its score of `holder` made
    // where there's none, then set to `value` where it's given, else added `count` to: what's
    // changed, or is new, sent where its objective's shown, as `ScoreAccess.set` does.
    fn for_all(mut self, criteria: String, holder: String, shown: Tag?, count: i32, value: i32?) -> List<ScoreSent> {
        var out = List<ScoreSent>()
        for name in self.added.copy() {
            if self.objectives[name].criteria != criteria {
                continue
            }
            if not self.scores.contains(holder) {
                self.scores.insert(holder.copy(), LinkedMap<String, Score>())
            }
            var fresh = false
            if not self.scores[holder].contains(name) {
                self.scores[holder].insert(name.copy(), Score())
                fresh = true
            }
            let before = self.scores[holder][name].value
            let target = value ?? before.wrapping_add(count)
            var changed = fresh
            if self.objectives[name].auto_update {
                if let d = shown {
                    if self.scores[holder][name].display != some(d.copy()) {
                        self.scores[holder][name].display = some(d.copy())
                        changed = true
                    }
                }
            }
            if target != before {
                self.scores[holder][name].value = target
                changed = true
            }
            if changed and self.tracked(name.copy()) {
                let s = self.scores[holder][name].copy()
                out.push(ScoreSent { owner: holder.copy(), objective: name.copy(), value: s.value, display: s.display, format: s.format })
            }
        }
        return out
    }
}

/// A number format as it's saved, `NumberFormatTypes.CODEC`'s, as it's sent: its type's ID in
/// `number_format_type`, blank 0, styled 1 or fixed 2, and a styled one's style or a fixed one's
/// text; none for none, or one that isn't one of the three.
pub fn format_on_wire(saved: Tag?) -> (i32, Tag?)? {
    let t = saved else return none
    let Tag.Compound(m) = t else return none
    let kind = text(m, "type") else return none
    if kind == "blank" or kind == "minecraft:blank" {
        return some((0, none))
    }
    if kind == "fixed" or kind == "minecraft:fixed" {
        let value = at(m, "value") else return none
        return some((2, some(value)))
    }
    if kind != "styled" and kind != "minecraft:styled" {
        return none
    }
    var style = m.copy()
    _ = style.remove("type")
    return some((1, some(Tag.Compound(style))))
}

// `xs` the other way round.
fn backwards(xs: List<Tag>) -> List<Tag> {
    var out = List<Tag>()
    var i = xs.len()
    while i > 0 {
        i -= 1
        out.push(xs[i].copy())
    }
    return out
}

// The tag at `key` in `m`, if there's one.
fn at(m: JavaHashMap<String, Tag>, key: str) -> Tag? {
    if not m.contains(key) {
        return none
    }
    return some(m[key].copy())
}

// The string at `key` in `m`, if it's one.
fn text(m: JavaHashMap<String, Tag>, key: str) -> String? {
    return match at(m, key) {
        some(Tag.Str(s)) => some(s.copy()),
        _ => none,
    }
}

// The boolean at `key` in `m`, as a number, else `default`.
fn flag(m: JavaHashMap<String, Tag>, key: str, default: bool) -> bool {
    return match at(m, key) {
        some(t) => t.number_bool() ?? default,
        none => default,
    }
}

// The ID of the visibility, or the collision rule where `collision`, named at `key` in `m`, else
// `always`'s, 0.
fn rule(m: JavaHashMap<String, Tag>, key: str, collision: bool) -> i32 {
    let name = text(m, key) else return 0
    return rule_of(name, collision) ?? 0
}
