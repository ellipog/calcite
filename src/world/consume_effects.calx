/// What an item does as it's used up, vanilla's `ConsumeEffect`s ([CAL-163], D518), as
/// `ConsumeEffect.CODEC` reads them, each by its `type`: `apply_effects`, effects given where a
/// draw from the user's random is under their `probability`; `remove_effects`, effects of some
/// kinds taken off; `clear_all_effects`; `teleport_randomly`, within a `diameter`; and
/// `play_sound`. A totem of undying's `death_protection` holds a list of them, its
/// `death_effects`, which its holder's put through as it saves them,
/// `DeathProtection.applyEffects`; food and potions' `consumable`s come with them. What each does
/// to a living thing is `world.living`'s, to a player `server.network`'s.
///
/// [CAL-163]: https://acta.aaenz.no/aaen-studios/calcite#CAL-163
module world.consume_effects

import nbt.tag.{Tag}
import world.effects.{ActiveEffect, effect_id}

/// One thing a used-up item does, `ConsumeEffect`.
pub enum ConsumeEffect {
    /// `ApplyStatusEffectsConsumeEffect`: each effect added, a copy of it, where a float drawn
    /// from the user's random is under the probability.
    Apply(List<ActiveEffect>, f32)
    /// `RemoveStatusEffectsConsumeEffect`: the effects of these kinds taken off, in their order.
    Remove(List<i32>)
    /// `ClearAllStatusEffectsConsumeEffect`: every effect taken off.
    ClearAll
    /// `TeleportRandomlyConsumeEffect`: the user teleported within the diameter, as chorus fruit
    /// does.
    Teleport(f32)
    /// `PlaySoundConsumeEffect`: the sound, from the user, of its sound source.
    Sound(String)
    /// What Calcite can't read yet: the effects of a mob effect tag.
    Unknown(String)
}

/// The consume effects of the list `tag`, as `ConsumeEffect.CODEC.listOf()` reads it: none where
/// it isn't a list or one of them doesn't read, as the codec fails on one.
pub fn read_consume_effects(tag: Tag) -> List<ConsumeEffect>? {
    let Tag.List(items) = tag else return none
    var out = List<ConsumeEffect>()
    for item in items {
        let e = read_one(item) else return none
        out.push(e)
    }
    return some(out)
}

/// The death effects of `protection`, a `death_protection` component as `DeathProtection.CODEC`
/// reads it: its `death_effects`, none where it has none, `List.of()`, or they don't read.
pub fn death_effects(protection: Tag) -> List<ConsumeEffect> {
    let Tag.Compound(m) = protection else return List<ConsumeEffect>()
    if not m.contains("death_effects") {
        return List<ConsumeEffect>()
    }
    return read_consume_effects(m["death_effects"].copy()) ?? List<ConsumeEffect>()
}

// One consume effect, `tag`, as its `type`'s codec reads it; none where it doesn't read.
fn read_one(tag: Tag) -> ConsumeEffect? {
    let Tag.Compound(m) = tag else return none
    if not m.contains("type") {
        return none
    }
    let Tag.Str(named) = m["type"] else return none
    let kind = if named.starts_with("minecraft:") { named[10..].copy() } else { named.copy() }
    if kind == "apply_effects" {
        if not m.contains("effects") {
            return none
        }
        let Tag.List(list) = m["effects"] else return none
        var effects = List<ActiveEffect>()
        for each in list {
            let e = ActiveEffect.read(each) else return none
            effects.push(e)
        }
        var probability = 1.0f32
        if m.contains("probability") {
            let p = m["probability"].number_float() else return none
            // `Codec.floatRange(0.0F, 1.0F)`.
            if not (p >= 0.0f32 and p <= 1.0f32) {
                return none
            }
            probability = p
        }
        return some(ConsumeEffect.Apply(effects, probability))
    }
    if kind == "remove_effects" {
        if not m.contains("effects") {
            return none
        }
        return removed_of(m["effects"].copy())
    }
    if kind == "clear_all_effects" {
        return some(ConsumeEffect.ClearAll)
    }
    if kind == "teleport_randomly" {
        var diameter = 16.0f32
        if m.contains("diameter") {
            let v = m["diameter"].number_float() else return none
            // `ExtraCodecs.POSITIVE_FLOAT`.
            if not (v > 0.0f32) {
                return none
            }
            diameter = v
        }
        return some(ConsumeEffect.Teleport(diameter))
    }
    if kind == "play_sound" {
        if not m.contains("sound") {
            return none
        }
        let s = sound_of(m["sound"].copy()) else return none
        return some(ConsumeEffect.Sound(s))
    }
    return none
}

/// The sound `tag` names, as `SoundEvent.CODEC` reads it: a sound's name, or one made in place,
/// by its `sound_id` (D519); none where it's neither.
pub fn sound_of(tag: Tag) -> String? {
    if let Tag.Str(s) = tag.copy() {
        return some(s.copy())
    }
    let Tag.Compound(made) = tag else return none
    if not made.contains("sound_id") {
        return none
    }
    let Tag.Str(s) = made["sound_id"] else return none
    return some(s.copy())
}

// `remove_effects`' `effects`, a holder set of mob effects as `RegistryCodecs.holderSet` reads
// it: one effect's name, or a list of them, by their kinds; a tag of them is what Calcite can't
// read yet. None where a name isn't an effect's.
fn removed_of(set: Tag) -> ConsumeEffect? {
    match set {
        Tag.Str(s) => {
            if s.starts_with("#") {
                return some(ConsumeEffect.Unknown("The mob effect tag {s} of a remove_effects consume effect"))
            }
            let id = effect_id(s.copy()) else return none
            return some(ConsumeEffect.Remove([id]))
        },
        Tag.List(names) => {
            var ids = List<i32>()
            for n in names {
                let Tag.Str(s) = n else return none
                let id = effect_id(s.copy()) else return none
                ids.push(id)
            }
            return some(ConsumeEffect.Remove(ids))
        },
        _ => return none,
    }
}
