/// Placing blocks as vanilla's `BlockItem` places them (CAL-139): what a placement reads of
/// vanilla's tables, `PlaceFacts`; where the block goes, `BlockPlaceContext`, as `Placement`;
/// whether the block there can be replaced, `canBeReplaced`, as each block's class has it; the
/// directions the player looks along, `Direction.orderedByNearest`; and the state each block is
/// placed as, `getStateForPlacement`, as each block's class has it, with what a block item adds:
/// a standing block's wall block (`StandingAndWallBlockItem`) and a game master block's
/// permission (`GameMasterBlockItem`). A class not here yet places nothing and is told of.
module world.placing

import math.mth.{table_cos, table_sin}
import nbt.tag.{Tag}
import random.source.{RandomSource}
import world.block_facts.{block_item_kind_names, block_items, class_names, items_of_blocks, place_sound_names, place_sound_pitches, place_sound_volumes, placed_by_classes, placement_classes, replace_classes, state_place_sounds, use_classes, use_item_classes, wall_block_items}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, EAST, FULL, Facts, NORTH, SOUTH, UP, WATER_FLUID, WEST, clockwise, direction_name, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.shapes.{concrete_of, leaf_distance, note_instrument, touches_liquid, update_shape}
import worldgen.signals.{has_neighbour_signal, repeater_locked, wire_connections}
import worldgen.survive.{Env, can_survive, direction_property, facing_of}

/// What placing a block reads of vanilla's tables (CAL-139), made once and shared by its copies:
/// the classes whose `getStateForPlacement`, `canBeReplaced`, `setPlacedBy`, `useItemOn` and
/// `useWithoutItem` each block runs; each block item's block, class and wall block; each block's
/// item; and each state's place sound.
pub struct PlaceFacts {
    t: Shared<PlaceTables>
}

// The tables themselves.
struct PlaceTables {
    names: List<String>
    placement: List<u32>
    replace: List<u32>
    placed_by: List<u32>
    use_item: List<u32>
    use_without: List<u32>
    kinds: List<String>
    // By item ID: its block's ID, or -1 for an item that isn't a block item; its class, by its
    // index in `kinds`; and a standing block's wall block, -1 for none, and the direction it's
    // attached toward.
    item_blocks: List<i32>
    item_kinds: List<i32>
    item_walls: List<i32>
    item_attach: List<i32>
    block_items: List<u32>
    sound_names: List<String>
    volumes: List<f32>
    pitches: List<f32>
    state_sounds: List<u32>
}

impl PlaceFacts {
    /// The tables, read.
    pub fn new() -> PlaceFacts {
        var kinds = List<String>()
        for k in block_item_kind_names() {
            kinds.push(String(k))
        }
        let triples = block_items()
        var most = 0
        for k in 0..triples.len() / 3 {
            most = most.max(i32.wrap(triples[k * 3]))
        }
        let size = usize.wrap(most + 1)
        var item_blocks: List<i32> = [-1; size]
        var item_kinds: List<i32> = [-1; size]
        var item_walls: List<i32> = [-1; size]
        var item_attach: List<i32> = [-1; size]
        for k in 0..triples.len() / 3 {
            let item = usize(triples[k * 3])
            item_blocks[item] = i32.wrap(triples[k * 3 + 1])
            item_kinds[item] = i32.wrap(triples[k * 3 + 2])
        }
        let walls = wall_block_items()
        for k in 0..walls.len() / 3 {
            let item = usize(walls[k * 3])
            item_walls[item] = i32.wrap(walls[k * 3 + 1])
            item_attach[item] = i32.wrap(walls[k * 3 + 2])
        }
        var sounds = List<String>()
        for s in place_sound_names() {
            sounds.push(String(s))
        }
        return PlaceFacts { t: Shared(PlaceTables {
            names: class_names(),
            placement: placement_classes(),
            replace: replace_classes(),
            placed_by: placed_by_classes(),
            use_item: use_item_classes(),
            use_without: use_classes(),
            kinds: kinds,
            item_blocks: item_blocks,
            item_kinds: item_kinds,
            item_walls: item_walls,
            item_attach: item_attach,
            block_items: items_of_blocks(),
            sound_names: sounds,
            volumes: place_sound_volumes(),
            pitches: place_sound_pitches(),
            state_sounds: state_place_sounds(),
        }) }
    }

    // The name of the class at `at` in `class_names`, or empty for none.
    fn class_at(self, at: u32) -> String {
        let i = usize(at)
        if i >= self.t.value.names.len() {
            return String()
        }
        return self.t.value.names[i].copy()
    }

    /// The class whose `getStateForPlacement` the block runs.
    pub fn placement_class(self, block: u32) -> String {
        return self.class_at(self.t.value.placement[usize(block)])
    }

    /// The class whose `canBeReplaced` for a placement the block runs.
    pub fn replace_class(self, block: u32) -> String {
        return self.class_at(self.t.value.replace[usize(block)])
    }

    /// The class whose `setPlacedBy` the block runs.
    pub fn placed_by_class(self, block: u32) -> String {
        return self.class_at(self.t.value.placed_by[usize(block)])
    }

    /// The class whose `useItemOn` the block runs.
    pub fn use_item_class(self, block: u32) -> String {
        return self.class_at(self.t.value.use_item[usize(block)])
    }

    /// The class whose `useWithoutItem` the block runs.
    pub fn use_class(self, block: u32) -> String {
        return self.class_at(self.t.value.use_without[usize(block)])
    }

    /// The block the item `item`, by ID, places, if it's a block item.
    pub fn block_of(self, item: i32) -> u32? {
        if item < 0 or usize.wrap(item) >= self.t.value.item_blocks.len() {
            return none
        }
        let b = self.t.value.item_blocks[usize.wrap(item)]
        if b < 0 {
            return none
        }
        return some(u32.wrap(b))
    }

    /// The class of the block item `item`, as `BlockItem` or `DoubleHighBlockItem`, or empty for
    /// an item that isn't one.
    pub fn kind_of(self, item: i32) -> String {
        if item < 0 or usize.wrap(item) >= self.t.value.item_kinds.len() {
            return String()
        }
        let k = self.t.value.item_kinds[usize.wrap(item)]
        if k < 0 {
            return String()
        }
        return self.t.value.kinds[usize.wrap(k)].copy()
    }

    /// A `StandingAndWallBlockItem`'s wall block and the direction it's attached toward,
    /// `attachmentDirection`, by its 3D data value.
    pub fn wall_of(self, item: i32) -> (u32, i32)? {
        if item < 0 or usize.wrap(item) >= self.t.value.item_walls.len() {
            return none
        }
        let w = self.t.value.item_walls[usize.wrap(item)]
        if w < 0 {
            return none
        }
        return some((u32.wrap(w), self.t.value.item_attach[usize.wrap(item)]))
    }

    /// The block's item, `asItem`, by ID: 0, air's, for a block with none.
    pub fn item_of(self, block: u32) -> i32 {
        return i32.wrap(self.t.value.block_items[usize(block)])
    }

    /// The sound the state's placed with, by the sound event's name, as `block.stone.place`, and
    /// its sound type's volume and pitch.
    pub fn place_sound(self, state: u32) -> (String, f32, f32) {
        let i = usize(self.t.value.state_sounds[usize(state)])
        return (self.t.value.sound_names[i].copy(), self.t.value.volumes[i], self.t.value.pitches[i])
    }
}

/// Where a block's placed, `BlockPlaceContext` (CAL-139): the block it goes in, the block clicked
/// if that's replaced, else the one beside its face; the block clicked, the face, where it was
/// hit, and whether the eyes were inside it; and what of the player placing it the blocks read.
pub struct Placement {
    pub x: i32
    pub y: i32
    pub z: i32
    pub clicked_x: i32
    pub clicked_y: i32
    pub clicked_z: i32
    pub face: i32
    pub at_x: f64
    pub at_y: f64
    pub at_z: f64
    pub inside: bool
    /// `replaceClicked`: whether the block goes in the block clicked.
    pub replace_clicked: bool = true
    /// What's held, by item ID, -1 for nothing, and the stack.
    pub item: i32 = -1
    pub held: Tag? = none
    /// The player's turn and tilt, `getYRot` and `getXRot`; whether they sneak,
    /// `isSecondaryUseActive`; and whether they may use game master blocks.
    pub y_rot: f32 = 0.0f32
    pub x_rot: f32 = 0.0f32
    pub sneaking: bool = false
    pub game_master: bool = false
    /// The world's top, `getMaxY`.
    pub max_y: i32 = 319
    /// The world border's west, north, east and south edges.
    pub border_min_x: f64 = -29999984.0
    pub border_min_z: f64 = -29999984.0
    pub border_max_x: f64 = 29999984.0
    pub border_max_z: f64 = 29999984.0
}

impl Placement {
    /// The context for a click on the block at `x`, `y`, `z`, on its face `face`, at `at_x`,
    /// `at_y`, `at_z`, placing in the block clicked, as the context starts before it's asked
    /// whether that's replaced.
    pub fn new(x: i32, y: i32, z: i32, face: i32, at_x: f64, at_y: f64, at_z: f64, inside: bool) -> Placement {
        return Placement { x: x, y: y, z: z, clicked_x: x, clicked_y: y, clicked_z: z, face: face, at_x: at_x, at_y: at_y, at_z: at_z, inside: inside }
    }

    /// `getHorizontalDirection`: the player's `getDirection`, from their turn.
    pub fn horizontal_direction(self) -> i32 {
        return from_y_rot(f64(self.y_rot))
    }

    /// `getNearestLookingDirections`: the directions nearest the player's look first, the clicked
    /// face's opposite put first where the block goes beside the one clicked.
    pub fn looking_directions(self) -> List<i32> {
        let ordered = ordered_by_nearest(self.y_rot, self.x_rot)
        if self.replace_clicked {
            return ordered
        }
        let first = opposite(self.face)
        var out: List<i32> = [first]
        for d in ordered {
            if d != first {
                out.push(d)
            }
        }
        return out
    }

    /// `WorldBorder.isWithinBounds` of the block column at `x`, `z`.
    pub fn in_border(self, x: i32, z: i32) -> bool {
        let bx = f64(x)
        let bz = f64(z)
        return bx >= self.border_min_x and bx < self.border_max_x and bz >= self.border_min_z and bz < self.border_max_z
    }

    /// `getNearestLookingDirection`: the direction nearest the player's look.
    pub fn nearest_direction(self) -> i32 {
        return ordered_by_nearest(self.y_rot, self.x_rot)[0]
    }
}

/// `Direction.fromYRot`: the horizontal direction a turn faces, from its 2D data value.
pub fn from_y_rot(y_rot: f64) -> i32 {
    let v = i32.saturate((y_rot / 90.0 + 0.5).floor()) & 3
    return match v {
        0 => SOUTH,
        1 => WEST,
        2 => NORTH,
        _ => EAST,
    }
}

/// `Direction.orderedByNearest`: the six directions, the nearest to where the player looks
/// first, as the sine table turns their tilt and turn.
pub fn ordered_by_nearest(y_rot: f32, x_rot: f32) -> List<i32> {
    let radians = f32.nearest(3.141592653589793 / 180.0)
    let pitch = x_rot * radians
    let yaw = -y_rot * radians
    let pitch_sin = table_sin(f64(pitch))
    let pitch_cos = table_cos(f64(pitch))
    let yaw_sin = table_sin(f64(yaw))
    let yaw_cos = table_cos(f64(yaw))
    let x_pos = yaw_sin > 0.0f32
    let y_pos = pitch_sin < 0.0f32
    let z_pos = yaw_cos > 0.0f32
    let x_yaw = if x_pos { yaw_sin } else { -yaw_sin }
    let y_mag = if y_pos { -pitch_sin } else { pitch_sin }
    let z_yaw = if z_pos { yaw_cos } else { -yaw_cos }
    let x_mag = x_yaw * pitch_cos
    let z_mag = z_yaw * pitch_cos
    let ax = if x_pos { EAST } else { WEST }
    let ay = if y_pos { UP } else { DOWN }
    let az = if z_pos { SOUTH } else { NORTH }
    if x_yaw > z_yaw {
        if y_mag > x_mag {
            return arranged(ay, ax, az)
        }
        if z_mag > y_mag {
            return arranged(ax, az, ay)
        }
        return arranged(ax, ay, az)
    }
    if y_mag > z_mag {
        return arranged(ay, az, ax)
    }
    if x_mag > y_mag {
        return arranged(az, ax, ay)
    }
    return arranged(az, ay, ax)
}

// `makeDirectionArray`: three directions, then their opposites the other way round.
fn arranged(a: i32, b: i32, c: i32) -> List<i32> {
    return [a, b, c, opposite(c), opposite(b), opposite(a)]
}

/// `RotationSegment.convertToSegment(float)`: a turn in degrees as one of 16 segments,
/// `Math.round` of a sixteenth's share.
pub fn rotation_segment(degrees: f32) -> i32 {
    let share = degrees * (16.0f32 / 360.0f32)
    return i32.saturate((f64(share) + 0.5).floor()) & 15
}

/// `RotationSegment.convertToSegment(Direction)`: a horizontal direction's 2D data value, four
/// segments each.
pub fn direction_segment(d: i32) -> i32 {
    return match d {
        3 => 0,
        4 => 4,
        2 => 8,
        5 => 12,
        _ => 0,
    }
}

// The axis of a direction, as `axis` names it.
fn axis_name(d: i32) -> String {
    if d == DOWN or d == UP {
        return String("y")
    }
    if d == NORTH or d == SOUTH {
        return String("z")
    }
    return String("x")
}

// Whether the direction's horizontal.
fn flat(d: i32) -> bool {
    return d != DOWN and d != UP
}

// `getCounterClockWise`.
fn counter_clockwise(d: i32) -> i32 {
    return opposite(clockwise(d))
}

// `getFluidState(pos).is(Fluids.WATER)`: whether the block at `x`, `y`, `z` holds a water source.
fn water_source<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    return f.fluid(try level.state(f, x, y, z)) == WATER_FLUID
}

// `fluidState.is(FluidTags.WATER) && fluidState.isFull()`: water, of any kind, that's full.
fn full_water<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let s = try level.state(f, x, y, z)
    return f.is_water(s) and f.fluid_amount(s) == 8
}

// The state with the property `name` set to `value`.
fn set(f: Facts, state: u32, name: String, value: String) -> u32 ! Thrown {
    return try f.with_name(state, name, value)
}

// The state with the direction property `name` set to `d`.
fn facing(f: Facts, state: u32, name: str, d: i32) -> u32 ! Thrown {
    return try f.with_name(state, String(name), direction_name(d))
}

// The state waterlogged where the block it goes in holds a water source, as most of them are.
fn logged<L: BlockAccess>(f: Facts, level: L, state: u32, c: Placement) -> u32 ! Thrown {
    return try f.with_bool(state, "waterlogged", try water_source(f, level, c.x, c.y, c.z))
}

/// `BlockState.canBeReplaced(BlockPlaceContext)` of `state`, as its class has it: whether the
/// block placed may go where `state` is.
pub fn can_be_replaced<L: BlockAccess>(e: Env, p: PlaceFacts, level: L, state: u32, c: Placement) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let kind = p.replace_class(block)
    let mine = c.item >= 0 and c.item == p.item_of(block)
    if kind == "SlabBlock" {
        if f.get_name(state, "type") == some(String("double")) or not mine {
            return false
        }
        if not c.replace_clicked {
            return true
        }
        let above = c.at_y - f64(c.y) > 0.5
        if f.get_name(state, "type") == some(String("bottom")) {
            return c.face == UP or (above and flat(c.face))
        }
        return c.face == DOWN or (not above and flat(c.face))
    }
    if kind == "CandleBlock" {
        if not c.sneaking and mine and (f.get_int(state, "candles") ?? 4) < 4 {
            return true
        }
    } else if kind == "SeaPickleBlock" {
        if not c.sneaking and mine and (f.get_int(state, "pickles") ?? 4) < 4 {
            return true
        }
    } else if kind == "TurtleEggBlock" {
        if not c.sneaking and mine and (f.get_int(state, "eggs") ?? 4) < 4 {
            return true
        }
    } else if kind == "FlowerBedBlock" {
        if not c.sneaking and mine and (f.get_int(state, "flower_amount") ?? 4) < 4 {
            return true
        }
    } else if kind == "LeafLitterBlock" {
        if not c.sneaking and mine and (f.get_int(state, "segment_amount") ?? 4) < 4 {
            return true
        }
    } else if kind == "SnowLayerBlock" {
        let layers = f.get_int(state, "layers") ?? 1
        if not mine or layers >= 8 {
            return layers == 1
        }
        return if c.replace_clicked { c.face == UP } else { true }
    } else if kind == "ScaffoldingBlock" {
        return mine
    } else if kind == "PitcherCropBlock" {
        return false
    } else if kind == "VineBlock" {
        let clicked = try level.state(f, c.x, c.y, c.z)
        if f.is(clicked, block) {
            var faces = 0
            for name in ["up", "north", "east", "south", "west"] {
                if f.get_bool(clicked, String(name)) {
                    faces += 1
                }
            }
            return faces < 5
        }
    } else if kind == "MultifaceBlock" {
        if not mine {
            return true
        }
        for d in 0..6 {
            let name = direction_name(d)
            if f.has(state, name) and not f.get_bool(state, name) {
                return true
            }
        }
        return false
    } else if kind == "GrowingPlantBodyBlock" {
        let replaced = default_replaced(f, p, state, c)
        let name = f.codec.blocks.name(block)
        let n = name.len()
        if replaced and n > 6 {
            if let head = f.block_named(name[..n - 6]) {
                if c.item >= 0 and c.item == p.item_of(head) {
                    return false
                }
            }
        }
        return replaced
    }
    return default_replaced(f, p, state, c)
}

// `BlockBehaviour.canBeReplaced`: a replaceable state, unless what's held is its own block's item.
fn default_replaced(f: Facts, p: PlaceFacts, state: u32, c: Placement) -> bool {
    return f.replaceable(state) and (c.item < 0 or c.item != p.item_of(f.block(state)))
}

/// `BlockItem.getPlacementState` of the block item `item` placing the block `block` as `c` says,
/// before its `canPlace`: its block's `getStateForPlacement`, or for a
/// `StandingAndWallBlockItem` its wall block's or its own by where the player looks, each that
/// can survive tried, or none. What isn't here yet is put in `missing` and places nothing.
pub fn placement_state<L: BlockAccess + RandomSource>(e: Env, p: PlaceFacts, level: mut L, block: u32, c: Placement, missing: mut List<String>) -> u32? ! Thrown {
    let kind = p.kind_of(c.item)
    if kind == "GameMasterBlockItem" and not c.game_master {
        return none
    }
    if let w = p.wall_of(c.item) {
        let (wall, attach) = w
        let wall_state = try state_for(e, p, mut level, wall, c, mut missing)
        for d in c.looking_directions() {
            if d == opposite(attach) {
                continue
            }
            let possible = if d == attach { try state_for(e, p, mut level, block, c, mut missing) } else { wall_state }
            let s = possible else continue
            if try can_survive(e, level, s, c.x, c.y, c.z) {
                return some(s)
            }
        }
        return none
    }
    return try state_for(e, p, mut level, block, c, mut missing)
}

/// `getStateForPlacement` of the block `block`, as its class has it, placed as `c` says, or
/// none where it can't go there. What isn't here yet is put in `missing` and places nothing.
pub fn state_for<L: BlockAccess + RandomSource>(e: Env, p: PlaceFacts, level: mut L, block: u32, c: Placement, missing: mut List<String>) -> u32? ! Thrown {
    let Env { facts: f, .. } = e
    let kind = p.placement_class(block)
    let s = f.default_state(block)
    let horizontal_dir = c.horizontal_direction()
    if kind == "Block" or kind == "PitcherCropBlock" {
        return some(s)
    }
    if kind == "RotatedPillarBlock" or kind == "InfestedRotatedPillarBlock" {
        return some(try set(f, s, "axis", axis_name(c.face)))
    }
    if kind == "ChainBlock" {
        return some(try logged(f, level, try set(f, s, "axis", axis_name(c.face)), c))
    }
    if kind == "SlabBlock" {
        let here = try level.state(f, c.x, c.y, c.z)
        if f.is(here, block) {
            return some(try f.with_bool(try set(f, here, "type", String("double")), "waterlogged", false))
        }
        let bottom = try logged(f, level, try set(f, s, "type", String("bottom")), c)
        if c.face != DOWN and (c.face == UP or not (c.at_y - f64(c.y) > 0.5)) {
            return some(bottom)
        }
        return some(try set(f, bottom, "type", String("top")))
    }
    if kind == "StairBlock" {
        let half = if c.face != DOWN and (c.face == UP or not (c.at_y - f64(c.y) > 0.5)) { "bottom" } else { "top" }
        let dry = try set(f, try facing(f, s, "facing", horizontal_dir), "half", String(half))
        // `getStairsShape`, as a side's shape update works it out, dry so it schedules nothing.
        let north = try level.state(f, c.x, c.y, c.z - 1)
        let shaped = try update_shape(e, mut level, try f.with_bool(dry, "waterlogged", false), c.x, c.y, c.z, NORTH, north)
        return some(try logged(f, level, shaped, c))
    }
    if kind == "FenceBlock" or kind == "IronBarsBlock" or kind == "WallBlock" or kind == "TripWireBlock" {
        // Each side's connection, as a shape update toward it works it out, dry so it schedules
        // nothing; a wall's post from what's above too.
        var shaped = if f.has(s, "waterlogged") { try f.with_bool(s, "waterlogged", false) } else { s }
        for i in 0..4 {
            let d = horizontal(i)
            let beside = try level.state(f, c.x + step_x(d), c.y, c.z + step_z(d))
            shaped = try update_shape(e, mut level, shaped, c.x, c.y, c.z, d, beside)
        }
        if kind == "WallBlock" {
            let above = try level.state(f, c.x, c.y + 1, c.z)
            shaped = try update_shape(e, mut level, shaped, c.x, c.y, c.z, UP, above)
        }
        if f.has(s, "waterlogged") {
            shaped = try logged(f, level, shaped, c)
        }
        return some(shaped)
    }
    if kind == "LeavesBlock" {
        var distance = 7
        for d in 0..6 {
            distance = distance.min(leaf_distance(e, try level.state(f, c.x + step_x(d), c.y + step_y(d), c.z + step_z(d))) + 1)
            if distance == 1 {
                break
            }
        }
        let leaf = try logged(f, level, try f.with_bool(s, "persistent", true), c)
        return some(try f.with_int(leaf, "distance", distance))
    }
    if kind == "AbstractFurnaceBlock" or kind == "BeehiveBlock" or kind == "CarvedPumpkinBlock" or kind == "ChiseledBookShelfBlock" or kind == "GlazedTerracottaBlock" or kind == "LoomBlock" or kind == "StonecutterBlock" or kind == "VaultBlock" or kind == "DiodeBlock" {
        return some(try facing(f, s, "facing", opposite(horizontal_dir)))
    }
    if kind == "EndPortalFrameBlock" {
        return some(try f.with_bool(try facing(f, s, "facing", opposite(horizontal_dir)), "eye", false))
    }
    if kind == "EnderChestBlock" or kind == "CopperGolemStatueBlock" {
        return some(try logged(f, level, try facing(f, s, "facing", opposite(horizontal_dir)), c))
    }
    if kind == "RepeaterBlock" {
        let faced = try facing(f, s, "facing", opposite(horizontal_dir))
        return some(try f.with_bool(faced, "locked", try repeater_locked(f, level, faced, c.x, c.y, c.z)))
    }
    if kind == "AnvilBlock" {
        return some(try facing(f, s, "facing", clockwise(horizontal_dir)))
    }
    if kind == "BarrelBlock" or kind == "CommandBlock" or kind == "DispenserBlock" {
        return some(try facing(f, s, "facing", opposite(c.nearest_direction())))
    }
    if kind == "PistonBaseBlock" {
        return some(try f.with_bool(try facing(f, s, "facing", opposite(c.nearest_direction())), "extended", false))
    }
    if kind == "ObserverBlock" {
        return some(try facing(f, s, "facing", c.nearest_direction()))
    }
    if kind == "ShulkerBoxBlock" {
        return some(try facing(f, s, "facing", c.face))
    }
    if kind == "LightningRodBlock" or kind == "AmethystClusterBlock" {
        return some(try logged(f, level, try facing(f, s, "facing", c.face), c))
    }
    if kind == "EndRodBlock" {
        let behind = try level.state(f, c.x - step_x(c.face), c.y - step_y(c.face), c.z - step_z(c.face))
        if f.is(behind, block) and try facing_of(f, behind) == c.face {
            return some(try facing(f, s, "facing", opposite(c.face)))
        }
        return some(try facing(f, s, "facing", c.face))
    }
    if kind == "HopperBlock" {
        let toward = opposite(c.face)
        let d = if flat(toward) { toward } else { DOWN }
        return some(try f.with_bool(try facing(f, s, "facing", d), "enabled", true))
    }
    if kind == "BarrierBlock" or kind == "WaterloggedTransparentBlock" or kind == "HeavyCoreBlock" or kind == "SculkSensorBlock" or kind == "SculkShriekerBlock" or kind == "MangroveRootsBlock" or kind == "HangingRootsBlock" {
        return some(try logged(f, level, s, c))
    }
    if kind == "CalibratedSculkSensorBlock" {
        return some(try logged(f, level, try facing(f, s, "facing", horizontal_dir), c))
    }
    if kind == "BaseCoralPlantTypeBlock" or kind == "ConduitBlock" {
        return some(try f.with_bool(s, "waterlogged", try full_water(f, level, c.x, c.y, c.z)))
    }
    if kind == "BaseCoralWallFanBlock" {
        let wet = try f.with_bool(s, "waterlogged", try full_water(f, level, c.x, c.y, c.z))
        for d in c.looking_directions() {
            if flat(d) {
                let fan = try facing(f, wet, "facing", opposite(d))
                if try can_survive(e, level, fan, c.x, c.y, c.z) {
                    return some(fan)
                }
            }
        }
        return none
    }
    if kind == "MangrovePropaguleBlock" {
        return some(try f.with_int(try logged(f, level, s, c), "age", 4))
    }
    if kind == "DecoratedPotBlock" {
        let faced = try logged(f, level, try facing(f, s, "facing", horizontal_dir), c)
        return some(try f.with_bool(faced, "cracked", false))
    }
    if kind == "CampfireBlock" {
        let water = try water_source(f, level, c.x, c.y, c.z)
        let hay = f.block_named(String("minecraft:hay_block")) ?? 0
        let smoke = f.is(try level.state(f, c.x, c.y - 1, c.z), hay)
        var fire = try f.with_bool(s, "waterlogged", water)
        fire = try f.with_bool(fire, "signal_fire", smoke)
        fire = try f.with_bool(fire, "lit", not water)
        return some(try facing(f, fire, "facing", horizontal_dir))
    }
    if kind == "LanternBlock" {
        for d in c.looking_directions() {
            if not flat(d) {
                let lantern = try f.with_bool(s, "hanging", d == UP)
                if try can_survive(e, level, lantern, c.x, c.y, c.z) {
                    return some(try logged(f, level, lantern, c))
                }
            }
        }
        return none
    }
    if kind == "LadderBlock" {
        if not c.replace_clicked {
            let behind = try level.state(f, c.x - step_x(c.face), c.y - step_y(c.face), c.z - step_z(c.face))
            if f.is(behind, block) and try facing_of(f, behind) == c.face {
                return none
            }
        }
        for d in c.looking_directions() {
            if flat(d) {
                let ladder = try facing(f, s, "facing", opposite(d))
                if try can_survive(e, level, ladder, c.x, c.y, c.z) {
                    return some(try logged(f, level, ladder, c))
                }
            }
        }
        return none
    }
    if kind == "WallTorchBlock" or kind == "WallBannerBlock" or kind == "WallSignBlock" or kind == "TripWireHookBlock" or kind == "ShelfMushroomBlock" {
        var base = s
        if kind == "TripWireHookBlock" {
            base = try f.with_bool(try f.with_bool(s, "powered", false), "attached", false)
        }
        for d in c.looking_directions() {
            if flat(d) {
                let on_wall = try facing(f, base, "facing", opposite(d))
                if try can_survive(e, level, on_wall, c.x, c.y, c.z) {
                    if kind == "WallSignBlock" {
                        return some(try logged(f, level, on_wall, c))
                    }
                    return some(on_wall)
                }
            }
        }
        return none
    }
    if kind == "CocoaBlock" {
        for d in c.looking_directions() {
            if flat(d) {
                let pod = try facing(f, s, "facing", d)
                if try can_survive(e, level, pod, c.x, c.y, c.z) {
                    return some(pod)
                }
            }
        }
        return none
    }
    if kind == "RedstoneWallTorchBlock" {
        let torch = f.block_named(String("minecraft:wall_torch")) ?? block
        let on_wall = try state_for(e, p, mut level, torch, c, mut missing) else return none
        return some(try facing(f, s, "facing", try facing_of(f, on_wall)))
    }
    if kind == "StandingSignBlock" {
        return some(try logged(f, level, try f.with_int(s, "rotation", rotation_segment(c.y_rot + 180.0f32)), c))
    }
    if kind == "BannerBlock" {
        return some(try f.with_int(s, "rotation", rotation_segment(c.y_rot + 180.0f32)))
    }
    if kind == "AbstractSkullBlock" or kind == "SkullBlock" or kind == "WallSkullBlock" {
        let powered = try f.with_bool(s, "powered", try has_neighbour_signal(f, level, c.x, c.y, c.z, true))
        if kind == "SkullBlock" {
            return some(try f.with_int(powered, "rotation", rotation_segment(c.y_rot)))
        }
        if kind == "WallSkullBlock" {
            for d in c.looking_directions() {
                if flat(d) {
                    let skull = try facing(f, powered, "facing", opposite(d))
                    let there = try level.state(f, c.x + step_x(d), c.y + step_y(d), c.z + step_z(d))
                    if not try can_be_replaced(e, p, level, there, c) {
                        return some(skull)
                    }
                }
            }
            return none
        }
        return some(powered)
    }
    if kind == "DoorBlock" {
        if c.y >= c.max_y or not try can_be_replaced(e, p, level, try level.state(f, c.x, c.y + 1, c.z), c) {
            return none
        }
        let powered = try has_neighbour_signal(f, level, c.x, c.y, c.z, true) or try has_neighbour_signal(f, level, c.x, c.y + 1, c.z, true)
        var door = try facing(f, s, "facing", horizontal_dir)
        door = try set(f, door, "hinge", try hinge(f, level, c, horizontal_dir))
        door = try f.with_bool(try f.with_bool(door, "powered", powered), "open", powered)
        return some(try set(f, door, "half", String("lower")))
    }
    if kind == "DoublePlantBlock" or kind == "TallSeagrassBlock" or kind == "SmallDripleafBlock" {
        if c.y >= c.max_y or not try can_be_replaced(e, p, level, try level.state(f, c.x, c.y + 1, c.z), c) {
            return none
        }
        if kind == "TallSeagrassBlock" {
            return if try full_water(f, level, c.x, c.y + 1, c.z) { some(s) } else { none }
        }
        if kind == "SmallDripleafBlock" {
            // `copyWaterloggedFrom`: waterlogged where there's water of any kind, `isWaterAt`.
            let faced = try facing(f, s, "facing", opposite(horizontal_dir))
            return some(try f.with_bool(faced, "waterlogged", f.is_water(try level.state(f, c.x, c.y, c.z))))
        }
        return some(s)
    }
    if kind == "TrapDoorBlock" {
        var hatch = s
        if not c.replace_clicked and flat(c.face) {
            hatch = try facing(f, hatch, "facing", c.face)
            hatch = try set(f, hatch, "half", String(if c.at_y - f64(c.y) > 0.5 { "top" } else { "bottom" }))
        } else {
            hatch = try facing(f, hatch, "facing", opposite(horizontal_dir))
            hatch = try set(f, hatch, "half", String(if c.face == UP { "bottom" } else { "top" }))
        }
        if try has_neighbour_signal(f, level, c.x, c.y, c.z, true) {
            hatch = try f.with_bool(try f.with_bool(hatch, "open", true), "powered", true)
        }
        return some(try logged(f, level, hatch, c))
    }
    if kind == "FenceGateBlock" {
        let open = try has_neighbour_signal(f, level, c.x, c.y, c.z, true)
        let walls = f.tag("minecraft:walls")
        var in_wall = false
        if horizontal_dir == NORTH or horizontal_dir == SOUTH {
            in_wall = f.in_set(try level.state(f, c.x - 1, c.y, c.z), walls) or f.in_set(try level.state(f, c.x + 1, c.y, c.z), walls)
        } else {
            in_wall = f.in_set(try level.state(f, c.x, c.y, c.z - 1), walls) or f.in_set(try level.state(f, c.x, c.y, c.z + 1), walls)
        }
        var gate = try facing(f, s, "facing", horizontal_dir)
        gate = try f.with_bool(try f.with_bool(gate, "open", open), "powered", open)
        return some(try f.with_bool(gate, "in_wall", in_wall))
    }
    if kind == "RedstoneLampBlock" {
        return some(try f.with_bool(s, "lit", try has_neighbour_signal(f, level, c.x, c.y, c.z, true)))
    }
    if kind == "SnowyBlock" {
        let above = try level.state(f, c.x, c.y + 1, c.z)
        return some(try update_shape(e, mut level, s, c.x, c.y, c.z, UP, above))
    }
    if kind == "HugeMushroomBlock" {
        var cap = s
        for d in 0..6 {
            let there = try level.state(f, c.x + step_x(d), c.y + step_y(d), c.z + step_z(d))
            cap = try f.with_bool(cap, direction_property(d), not f.is(there, block))
        }
        return some(cap)
    }
    if kind == "FaceAttachedHorizontalDirectionalBlock" {
        for d in c.looking_directions() {
            var attached = s
            if not flat(d) {
                attached = try set(f, attached, "face", String(if d == UP { "ceiling" } else { "floor" }))
                attached = try facing(f, attached, "facing", horizontal_dir)
            } else {
                attached = try set(f, attached, "face", String("wall"))
                attached = try facing(f, attached, "facing", opposite(d))
            }
            if try can_survive(e, level, attached, c.x, c.y, c.z) {
                return some(attached)
            }
        }
        return none
    }
    if kind == "AbstractBedBlock" {
        let hx = c.x + step_x(horizontal_dir)
        let hz = c.z + step_z(horizontal_dir)
        if try can_be_replaced(e, p, level, try level.state(f, hx, c.y, hz), c) and c.in_border(hx, hz) {
            return some(try facing(f, s, "facing", horizontal_dir))
        }
        return none
    }
    if kind == "BaseRailBlock" {
        let shape = if horizontal_dir == EAST or horizontal_dir == WEST { "east_west" } else { "north_south" }
        return some(try logged(f, level, try set(f, s, "shape", String(shape)), c))
    }
    if kind == "CandleBlock" or kind == "SeaPickleBlock" or kind == "TurtleEggBlock" or kind == "SnowLayerBlock" {
        let here = try level.state(f, c.x, c.y, c.z)
        if f.is(here, block) {
            if kind == "CandleBlock" {
                return some(try f.with_int(here, "candles", (f.get_int(here, "candles") ?? 1) % 4 + 1))
            }
            if kind == "SeaPickleBlock" {
                return some(try f.with_int(here, "pickles", ((f.get_int(here, "pickles") ?? 1) + 1).min(4)))
            }
            if kind == "TurtleEggBlock" {
                return some(try f.with_int(here, "eggs", ((f.get_int(here, "eggs") ?? 1) + 1).min(4)))
            }
            return some(try f.with_int(here, "layers", ((f.get_int(here, "layers") ?? 1) + 1).min(8)))
        }
        if kind == "CandleBlock" or kind == "SeaPickleBlock" {
            return some(try logged(f, level, s, c))
        }
        return some(s)
    }
    if kind == "FlowerBedBlock" or kind == "LeafLitterBlock" {
        let amount = String(if kind == "FlowerBedBlock" { "flower_amount" } else { "segment_amount" })
        let here = try level.state(f, c.x, c.y, c.z)
        if f.is(here, block) {
            return some(try f.with_int(here, amount.copy(), ((f.get_int(here, amount.copy()) ?? 1) + 1).min(4)))
        }
        return some(try facing(f, s, "facing", opposite(horizontal_dir)))
    }
    if kind == "KelpBlock" or kind == "SeagrassBlock" {
        if not try full_water(f, level, c.x, c.y, c.z) {
            return none
        }
        if kind == "SeagrassBlock" {
            return some(s)
        }
        return try growing_plant(e, mut level, block, s, c, UP)
    }
    if kind == "GrowingPlantBlock" {
        let name = f.codec.blocks.name(block)
        let toward = if name.ends_with("weeping_vines") or name.ends_with("cave_vines") { DOWN } else { UP }
        return try growing_plant(e, mut level, block, s, c, toward)
    }
    if kind == "ConcretePowderBlock" {
        let here = try level.state(f, c.x, c.y, c.z)
        if f.is_water(here) or try touches_liquid(f, level, c.x, c.y, c.z) {
            return some(f.default_state(try concrete_of(f, block)))
        }
        return some(s)
    }
    if kind == "FarmlandBlock" {
        if not try can_survive(e, level, s, c.x, c.y, c.z) {
            return some(f.default_state(f.block_named(String("minecraft:dirt")) ?? block))
        }
        return some(s)
    }
    if kind == "NoteBlock" {
        return some(try note_instrument(f, level, s, c.x, c.y, c.z))
    }
    if kind == "RedstoneWireBlock" {
        var cross = s
        for i in 0..4 {
            cross = try set(f, cross, direction_property(horizontal(i)), String("side"))
        }
        return some(try wire_connections(f, level, cross, c.x, c.y, c.z))
    }
    if kind == "CrafterBlock" or kind == "JigsawBlock" {
        var front = c.face
        var top = UP
        if kind == "CrafterBlock" {
            front = opposite(c.nearest_direction())
            top = if front == DOWN { opposite(horizontal_dir) } else if front == UP { horizontal_dir } else { UP }
        } else if not flat(front) {
            top = opposite(horizontal_dir)
        }
        let oriented = try set(f, s, "orientation", "{direction_name(front)}_{direction_name(top)}")
        if kind == "CrafterBlock" {
            return some(try f.with_bool(oriented, "triggered", try has_neighbour_signal(f, level, c.x, c.y, c.z, true)))
        }
        return some(oriented)
    }
    if kind == "ShelfBlock" {
        let faced = try facing(f, s, "facing", opposite(horizontal_dir))
        let powered = try f.with_bool(faced, "powered", try has_neighbour_signal(f, level, c.x, c.y, c.z, true))
        return some(try logged(f, level, powered, c))
    }
    if kind == "BigDripleafBlock" {
        let below = try level.state(f, c.x, c.y - 1, c.z)
        let leaf = f.block_named(String("minecraft:big_dripleaf")) ?? block
        let stem = f.block_named(String("minecraft:big_dripleaf_stem")) ?? block
        let d = if f.is(below, leaf) or f.is(below, stem) { try facing_of(f, below) } else { opposite(horizontal_dir) }
        return some(try facing(f, try logged(f, level, s, c), "facing", d))
    }
    if kind == "DriedGhastBlock" {
        return some(try facing(f, try logged(f, level, s, c), "facing", opposite(horizontal_dir)))
    }
    if kind == "LecternBlock" {
        var book = false
        if c.game_master {
            if let entity = component_of(c.held, "minecraft:block_entity_data") {
                if let Tag.Compound(m) = entity {
                    book = m.contains("Book")
                }
            }
        }
        return some(try f.with_bool(try facing(f, s, "facing", opposite(horizontal_dir)), "has_book", book))
    }
    if kind == "BellBlock" {
        return try bell(e, level, s, c, horizontal_dir)
    }
    if kind == "ChestBlock" {
        return some(try chest(f, level, block, s, c, horizontal_dir))
    }
    if kind == "CoralBlock" {
        var wet = false
        for d in 0..6 {
            if f.is_water(try level.state(f, c.x + step_x(d), c.y + step_y(d), c.z + step_z(d))) {
                wet = true
                break
            }
        }
        if not wet {
            let delay = 60 + level.next_int_below(40)
            level.schedule_block(block, c.x, c.y, c.z, delay, 0)
        }
        return some(s)
    }
    missing.push("Placing {f.codec.blocks.name(block)}, a {kind}")
    return none
}

// `GrowingPlantBlock.getStateForPlacement`: the plant's body where its own head or body is the
// way it grows, else a head of an age the level's random draws, below 25.
fn growing_plant<L: BlockAccess + RandomSource>(e: Env, level: mut L, block: u32, s: u32, c: Placement, toward: i32) -> u32? ! Thrown {
    let Env { facts: f, .. } = e
    let name = f.codec.blocks.name(block)
    let body = f.block_named("{name}_plant") ?? block
    let there = try level.state(f, c.x + step_x(toward), c.y + step_y(toward), c.z + step_z(toward))
    if f.is(there, block) or f.is(there, body) {
        return some(f.default_state(body))
    }
    return some(try f.with_int(s, "age", level.next_int_below(25)))
}

// `BellBlock.getStateForPlacement`: on the floor or the ceiling where the face clicked is the top
// or the bottom; else on the wall, or between two where both sides are sturdy, then on the floor
// or ceiling where it can't hang.
fn bell<L: BlockAccess>(e: Env, level: L, s: u32, c: Placement, horizontal_dir: i32) -> u32? ! Thrown {
    let Env { facts: f, .. } = e
    if not flat(c.face) {
        let attach = if c.face == DOWN { "ceiling" } else { "floor" }
        let b = try facing(f, try set(f, s, "attachment", String(attach)), "facing", horizontal_dir)
        return if try can_survive(e, level, b, c.x, c.y, c.z) { some(b) } else { none }
    }
    let x_axis = c.face == EAST or c.face == WEST
    var double = false
    if x_axis {
        double = f.sturdy(try level.state(f, c.x - 1, c.y, c.z), EAST, FULL) and f.sturdy(try level.state(f, c.x + 1, c.y, c.z), WEST, FULL)
    } else {
        double = f.sturdy(try level.state(f, c.x, c.y, c.z - 1), SOUTH, FULL) and f.sturdy(try level.state(f, c.x, c.y, c.z + 1), NORTH, FULL)
    }
    var b = try facing(f, s, "facing", opposite(c.face))
    b = try set(f, b, "attachment", String(if double { "double_wall" } else { "single_wall" }))
    if try can_survive(e, level, b, c.x, c.y, c.z) {
        return some(b)
    }
    let below = f.sturdy(try level.state(f, c.x, c.y - 1, c.z), UP, FULL)
    b = try set(f, b, "attachment", String(if below { "floor" } else { "ceiling" }))
    return if try can_survive(e, level, b, c.x, c.y, c.z) { some(b) } else { none }
}

// `ChestBlock.getStateForPlacement`: facing the player, joined, sneaking, to the single chest
// clicked where it faces across the face clicked, or else, not sneaking, to a single chest beside
// it facing the same way, on the left or the right.
fn chest<L: BlockAccess>(f: Facts, level: L, block: u32, s: u32, c: Placement, horizontal_dir: i32) -> u32 ! Thrown {
    var kind = "single"
    var toward = opposite(horizontal_dir)
    if flat(c.face) and c.sneaking {
        if let partner = try partner_facing(f, level, block, c, opposite(c.face)) {
            if axis_name(partner) != axis_name(c.face) {
                toward = partner
                kind = if counter_clockwise(toward) == opposite(c.face) { "right" } else { "left" }
            }
        }
    }
    if kind == "single" and not c.sneaking {
        if try partner_facing(f, level, block, c, clockwise(toward)) == some(toward) {
            kind = "left"
        } else if try partner_facing(f, level, block, c, counter_clockwise(toward)) == some(toward) {
            kind = "right"
        }
    }
    let faced = try set(f, try facing(f, s, "facing", toward), "type", String(kind))
    return try logged(f, level, faced, c)
}

// `ChestBlock.candidatePartnerFacing`: the facing of the single chest of the same kind the way
// `d` from where the chest goes, if there's one.
fn partner_facing<L: BlockAccess>(f: Facts, level: L, block: u32, c: Placement, d: i32) -> i32? ! Thrown {
    let there = try level.state(f, c.x + step_x(d), c.y, c.z + step_z(d))
    if f.is(there, block) and f.get_name(there, "type") == some(String("single")) {
        return some(try facing_of(f, there))
    }
    return none
}

// `DoorBlock.getHinge`: toward the side with fewer full blocks beside the door and above it, or
// away from a door beside it, else by which half of the block was clicked.
fn hinge<L: BlockAccess>(f: Facts, level: L, c: Placement, d: i32) -> String ! Thrown {
    let left = counter_clockwise(d)
    let right = clockwise(d)
    let left_state = try level.state(f, c.x + step_x(left), c.y, c.z + step_z(left))
    let left_above = try level.state(f, c.x + step_x(left), c.y + 1, c.z + step_z(left))
    let right_state = try level.state(f, c.x + step_x(right), c.y, c.z + step_z(right))
    let right_above = try level.state(f, c.x + step_x(right), c.y + 1, c.z + step_z(right))
    var balance = 0
    if f.collision_full_block(left_state) {
        balance -= 1
    }
    if f.collision_full_block(left_above) {
        balance -= 1
    }
    if f.collision_full_block(right_state) {
        balance += 1
    }
    if f.collision_full_block(right_above) {
        balance += 1
    }
    let door_left = f.is_a(f.block(left_state), "DoorBlock") and f.get_name(left_state, "half") == some(String("lower"))
    let door_right = f.is_a(f.block(right_state), "DoorBlock") and f.get_name(right_state, "half") == some(String("lower"))
    if (not door_left or door_right) and balance <= 0 {
        if (not door_right or door_left) and balance >= 0 {
            let sx = step_x(d)
            let sz = step_z(d)
            let cx = c.at_x - f64(c.x)
            let cz = c.at_z - f64(c.z)
            let left_side = (sx >= 0 or not (cz < 0.5)) and (sx <= 0 or not (cz > 0.5)) and (sz >= 0 or not (cx > 0.5)) and (sz <= 0 or not (cx < 0.5))
            return String(if left_side { "left" } else { "right" })
        }
        return String("left")
    }
    return String("right")
}

/// The item of the stack `held`, as `minecraft:stone`, or empty for none.
pub fn stack_item(held: Tag?) -> String {
    let stack = held.copy() else return String()
    let Tag.Compound(m) = stack else return String()
    if not m.contains("id") {
        return String()
    }
    let Tag.Str(id) = m["id"] else return String()
    return id.copy()
}

/// One empty bucket, as `BucketItem.getEmptySuccessItem` leaves a player without infinite
/// materials.
pub fn bucket_stack() -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String("minecraft:bucket")))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

/// Whether the stack has a component patch.
pub fn has_components(stack: Tag) -> bool {
    let Tag.Compound(m) = stack else return false
    if not m.contains("components") {
        return false
    }
    let Tag.Compound(c) = m["components"] else return false
    return not c.is_empty()
}

/// The component `name` in the stack's patch, as `minecraft:block_entity_data`, if it has it.
pub fn component_of(held: Tag?, name: str) -> Tag? {
    let stack = held.copy() else return none
    let Tag.Compound(m) = stack else return none
    if not m.contains("components") {
        return none
    }
    let Tag.Compound(c) = m["components"] else return none
    if not c.contains(name) {
        return none
    }
    return some(c[name].copy())
}
