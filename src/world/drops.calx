/// What broken blocks drop (CAL-153): `Block.dropResources` and `getDrops`, each block's loot
/// table rolled with what `getDrops` gives it, drawing from the table's random sequence, the
/// server's, or the level's random where it has none; then each stack popped as
/// `Block.popResource` pops it, its place drawn from the level's random, an item entity where
/// it isn't empty and the game rule `block_drops` is on; then `spawnAfterBreak`. A block entity
/// gives its components as `collectComponents` collects them, for a table to copy.
module world.drops

import nbt.tag.{Tag}
import random.source.{RandomSource}
import random.taped.{TapedRandom}
import registry.components.{ItemCodecs}
import world.block_facts.{loot_table_blocks, loot_table_names}
import world.block_level.{BlockLevel}
import world.loot.{Loot, LootParams, random_sequence, roll_table}
import world.random_sequences.{SequenceRandom}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}

/// What dropping asks of a level beyond its blocks.
pub interface DropLevel {
    /// The world's loot, or none for a world made without its registries.
    fn world_loot(self) -> Shared<Loot>?
    /// The server's random sequence `name`, lent out to draw from, as `getRandomSequence` gives
    /// it, or none where the level hasn't the sequences.
    fn lend_sequence(mut self, name: String) -> SequenceRandom?
    /// Gives back the sequence `lend_sequence` lent.
    fn give_back_sequence(mut self, name: String, random: SequenceRandom)
    /// The level's own random, lent out, for a table with no sequence.
    fn lend_level_random(mut self) -> TapedRandom
    /// Gives back the random `lend_level_random` lent.
    fn give_back_level_random(mut self, random: own TapedRandom)
    /// `addFreshEntity` of an item entity of `stack` at x, y, z, with `setDefaultPickUpDelay`.
    fn add_dropped(mut self, x: f64, y: f64, z: f64, stack: own Tag)
    /// The game rule `block_drops`.
    fn drops_on(self) -> bool
}

/// `Block.dropResources(state, level, pos, blockEntity, breaker, tool)`: the stacks the block
/// `state` at x, y, z drops, `block_entity` the block entity's saved data, `breaker` the entity
/// that broke it, and `tool` what it was broken with, none for `ItemStack.EMPTY`; each popped,
/// then what `spawnAfterBreak` gives.
pub fn drop_block_resources<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, block_entity: Tag?, breaker: i32?, tool: Tag?) {
    let stacks = get_drops(f, mut level, state, x, y, z, block_entity, breaker, tool)
    for s in stacks {
        pop_resource(mut level, x, y, z, s.copy())
    }
    spawn_after_break(f, mut level, state)
}

/// `Block.getDrops`, then `BlockBehaviour.getDrops`: the stacks the block's loot table gives,
/// with `ORIGIN` its middle, `TOOL`, `THIS_ENTITY` and `BLOCK_ENTITY` where there are those, and
/// `BLOCK_STATE`; a moving piston's those of the state it moves, a liquid's none, and a
/// decorated pot's and a shulker box's with their dynamic drops, the pot's sherds and the box's
/// contents.
pub fn get_drops<L: BlockAccess + BlockLevel + DropLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, block_entity: Tag?, breaker: i32?, tool: Tag?) -> List<Tag?> {
    var out = List<Tag?>()
    let block = f.block(state)
    if f.is_a(block, "MovingPistonBlock") {
        let m = level.moving_piston(x, y, z) else return out
        return get_drops(f, mut level, m.moved, x, y, z, block_entity, breaker, tool)
    }
    if f.is_a(block, "LiquidBlock") {
        return out
    }
    let table = loot_table_of(f, block) else return out
    let shared = level.world_loot() else {
        level.unimplemented(String("What a broken block drops"))
        return out
    }
    var params = LootParams { origin: some((f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)), has_tool: true, tool: tool.copy(), this_entity: breaker != none, state: some(state) }
    if let be = block_entity {
        params.block_entity = some(collect_components(shared.value.items, be))
        let kind = kind_of(be)
        if f.is_a(block, "DecoratedPotBlock") and kind == "minecraft:decorated_pot" {
            params.dynamic.push((String("minecraft:sherds"), sherds_of(shared.value.items, be)))
        }
        if f.is_a(block, "ShulkerBoxBlock") and kind == "minecraft:shulker_box" {
            params.dynamic.push((String("minecraft:contents"), slots_of(be, 27)))
        }
    }
    var missing = List<String>()
    match random_sequence(shared.value, table.copy()) {
        some(name) => {
            var random = level.lend_sequence(name.copy()) else {
                level.unimplemented(String("Random sequences where a level hasn't them"))
                return out
            }
            out = roll_table(shared.value, f, level, mut random, params, table, mut missing)
            level.give_back_sequence(name, random)
        },
        none => {
            var random = level.lend_level_random()
            out = roll_table(shared.value, f, level, mut random, params, table, mut missing)
            level.give_back_level_random(random)
        },
    }
    for m in missing {
        level.unimplemented(m.copy())
    }
    return out
}

/// `Block.popResource`: an item of `stack` at the block's middle, a quarter of a block either
/// way at most on each axis, drawn from the level's random, and lowered by half an item's
/// height, made where the stack isn't empty and the game rule `block_drops` is on.
pub fn pop_resource<L: DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, stack: own Tag?) {
    // `EntityTypes.ITEM`'s height is 0.25.
    let half = 0.125
    let px = f64(x) + 0.5 + next_double(mut level, -0.25, 0.25)
    let py = f64(y) + 0.5 + next_double(mut level, -0.25, 0.25) - half
    let pz = f64(z) + 0.5 + next_double(mut level, -0.25, 0.25)
    let s = stack else return
    if level.drops_on() {
        level.add_dropped(px, py, pz, s)
    }
}

// `Mth.nextDouble`.
fn next_double<R: RandomSource>(random: mut R, min: f64, max: f64) -> f64 {
    if min >= max {
        return min
    }
    return random.next_double() * (max - min) + min
}

// `spawnAfterBreak`, with experience dropped: what a block gives once it's broken, which comes
// with experience orbs and silverfish.
fn spawn_after_break<L: BlockLevel>(f: Facts, level: mut L, state: u32) {
    let block = f.block(state)
    let kinds: List<str> = ["DropExperienceBlock", "RedStoneOreBlock", "SculkCatalystBlock", "SculkSensorBlock", "SculkShriekerBlock", "SpawnerBlock"]
    for k in kinds {
        if f.is_a(block, String(k)) {
            level.unimplemented(String("The experience a broken block drops"))
            return
        }
    }
    if f.is_a(block, "InfestedBlock") {
        level.unimplemented(String("The silverfish a broken infested block lets out"))
    }
}

/// `getLootTable`: the block's loot table, `blocks/` and its name, or the one `loot_table_names`
/// gives it, or none for one with none.
pub fn loot_table_of(f: Facts, block: u32) -> String? {
    let blocks = loot_table_blocks()
    for i in 0..blocks.len() {
        if blocks[i] == block {
            let name = loot_table_names()[i]
            if name == "" {
                return none
            }
            return some(String(name))
        }
    }
    let full = f.codec.blocks.name(block)
    let colon = full.find(":") ?? 0
    return some("{full[..colon]}:blocks/{full[colon + 1..]}")
}

// The block entity's type, as its saved data's `id` names it.
fn kind_of(be: Tag) -> String {
    let Tag.Compound(m) = be else return String()
    if not m.contains("id") {
        return String()
    }
    return match m["id"] {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}

/// `BlockEntity.collectComponents` of the block entity whose saved data is `be`: its own
/// `components`, then what its type sets of what it holds, each taken away where it holds none:
/// a container's name, lock and items, and its loot table where it has one; a banner's patterns
/// and name; a beacon's name and lock; an enchanting table's name; a beehive's bees; a decorated
/// pot's sherds and item; a skull's profile, sound and name; a chiseled bookshelf's, a shelf's
/// and a campfire's items; and a sign's two sides and whether it's waxed.
pub fn collect_components(items: ItemCodecs, be: Tag) -> JavaHashMap<String, Tag> {
    var out = JavaHashMap<String, Tag>()
    let Tag.Compound(m) = be else return out
    if m.contains("components") {
        if let Tag.Compound(c) = m["components"] {
            out = c.copy()
        }
    }
    let kind = kind_of(be)
    let size = container_size(kind)
    if size > 0 {
        set_from(mut out, m, "minecraft:custom_name", "CustomName")
        lock_from(mut out, m)
        out.insert(String("minecraft:container"), contents(items, slots_of(be, size)))
        if randomizable(kind) and m.contains("LootTable") {
            var loot = JavaHashMap<String, Tag>()
            loot.insert(String("loot_table"), m["LootTable"].copy())
            if m.contains("LootTableSeed") {
                if (m["LootTableSeed"].number_long() ?? 0) != 0 {
                    loot.insert(String("seed"), m["LootTableSeed"].copy())
                }
            }
            out.insert(String("minecraft:container_loot"), Tag.Compound(loot))
        }
    } else if kind == "minecraft:banner" {
        out.insert(String("minecraft:banner_patterns"), if m.contains("patterns") { m["patterns"].copy() } else { Tag.List([]) })
        set_from(mut out, m, "minecraft:custom_name", "CustomName")
    } else if kind == "minecraft:beacon" {
        set_from(mut out, m, "minecraft:custom_name", "CustomName")
        lock_from(mut out, m)
    } else if kind == "minecraft:enchanting_table" {
        set_from(mut out, m, "minecraft:custom_name", "CustomName")
    } else if kind == "minecraft:beehive" {
        out.insert(String("minecraft:bees"), if m.contains("bees") { m["bees"].copy() } else { Tag.List([]) })
    } else if kind == "minecraft:decorated_pot" {
        out.insert(String("minecraft:pot_decorations"), decorations_of(items, be))
        var held = List<Tag?>()
        held.push(if m.contains("item") { some(m["item"].copy()) } else { none })
        out.insert(String("minecraft:container"), contents(items, held))
    } else if kind == "minecraft:skull" {
        set_from(mut out, m, "minecraft:profile", "profile")
        set_from(mut out, m, "minecraft:note_block_sound", "note_block_sound")
        set_from(mut out, m, "minecraft:custom_name", "custom_name")
    } else if kind == "minecraft:sign" or kind == "minecraft:hanging_sign" {
        set_from(mut out, m, "minecraft:sign_text_front", "front_text")
        set_from(mut out, m, "minecraft:sign_text_back", "back_text")
        if m.contains("is_waxed") and (m["is_waxed"].number_bool() ?? false) {
            out.insert(String("minecraft:waxed"), Tag.Compound(JavaHashMap<String, Tag>()))
        }
    }
    return out
}

// `components.set(name, value)` from the saved field `key`, taken away where it hasn't one.
fn set_from(out: mut JavaHashMap<String, Tag>, m: JavaHashMap<String, Tag>, name: str, key: str) {
    if m.contains(key) {
        out.insert(String(name), m[key].copy())
    } else {
        _ = out.remove(String(name))
    }
}

// The lock, `LockCode.fromTag`'s `lock`, set where it isn't `NO_LOCK`, which is no predicate.
fn lock_from(out: mut JavaHashMap<String, Tag>, m: JavaHashMap<String, Tag>) {
    if not m.contains("lock") {
        return
    }
    if let Tag.Compound(l) = m["lock"] {
        if l.is_empty() {
            return
        }
    }
    out.insert(String("minecraft:lock"), m["lock"].copy())
}

// How many slots the container block entity `kind` has, `getContainerSize`, or 0 for one whose
// items aren't a container's: those `BaseContainerBlockEntity`'s components come from, and the
// others with their items as a container.
fn container_size(kind: String) -> usize {
    let sizes: List<(str, usize)> = [
        ("minecraft:chest", 27), ("minecraft:trapped_chest", 27), ("minecraft:barrel", 27), ("minecraft:shulker_box", 27),
        ("minecraft:dispenser", 9), ("minecraft:dropper", 9), ("minecraft:crafter", 9), ("minecraft:hopper", 5),
        ("minecraft:furnace", 3), ("minecraft:blast_furnace", 3), ("minecraft:smoker", 3), ("minecraft:brewing_stand", 5),
        ("minecraft:chiseled_bookshelf", 6), ("minecraft:shelf", 3), ("minecraft:campfire", 4),
    ]
    for (k, n) in sizes {
        if kind == String(k) {
            return n
        }
    }
    return 0
}

// Whether the block entity `kind` is a `RandomizableContainerBlockEntity`, whose loot table is
// one of its components.
fn randomizable(kind: String) -> bool {
    let kinds: List<str> = ["minecraft:chest", "minecraft:trapped_chest", "minecraft:barrel", "minecraft:shulker_box", "minecraft:dispenser", "minecraft:dropper", "minecraft:crafter", "minecraft:hopper"]
    for k in kinds {
        if kind == String(k) {
            return true
        }
    }
    return false
}

// A block entity's `size` slots, as `ContainerHelper.loadAllItems` reads its `Items`: each by its
// `Slot`, a later one in the same slot over an earlier, and one past the last left out; none for
// an empty one.
fn slots_of(be: Tag, size: usize) -> List<Tag?> {
    var out = List<Tag?>()
    for _ in 0..size {
        out.push(none)
    }
    let Tag.Compound(m) = be else return out
    if not m.contains("Items") {
        return out
    }
    let Tag.List(items) = m["Items"] else return out
    for each in items {
        let Tag.Compound(item) = each else continue
        let slot = if item.contains("Slot") { (item["Slot"].number_int() ?? 0) & 255 } else { 0 }
        if usize.wrap(slot) >= size {
            continue
        }
        var stack = item.copy()
        _ = stack.remove(String("Slot"))
        out[usize.wrap(slot)] = some(Tag.Compound(stack))
    }
    return out
}

// `ItemContainerContents.fromItems(stacks)`, as its codec writes it: each stack that isn't empty
// with its slot, in their order, the stack as `ItemStackTemplate.fromNonEmptyStack` makes it a
// template, which leaves out a count of 1.
fn contents(items: ItemCodecs, stacks: List<Tag?>) -> Tag {
    var out = List<Tag>()
    for i in 0..stacks.len() {
        let s = stacks[i].copy() else continue
        if let Tag.Compound(m) = s {
            if m.contains("count") and (m["count"].number_int() ?? 1) <= 0 {
                continue
            }
        }
        var entry = JavaHashMap<String, Tag>()
        entry.insert(String("slot"), Tag.Int(i32.wrap(i)))
        entry.insert(String("item"), items.template(s) ?? s.copy())
        out.push(Tag.Compound(entry))
    }
    return Tag.List(out)
}

// The pot's `sherds`, as `PotDecorations.CODEC` reads them and writes them back: each side
// there, `back`, `left`, `right` and `front`, as a template, bricks too; none, as
// `PotDecorations.EMPTY` has them, where it hasn't them or a side doesn't read.
fn decorations_of(items: ItemCodecs, be: Tag) -> Tag {
    var out = JavaHashMap<String, Tag>()
    let Tag.Compound(m) = be else return Tag.Compound(out)
    if not m.contains("sherds") {
        return Tag.Compound(out)
    }
    let Tag.Compound(sides) = m["sherds"] else return Tag.Compound(out)
    let names: List<str> = ["back", "left", "right", "front"]
    for side in names {
        if not sides.contains(side) {
            continue
        }
        let read = items.template(sides[side]) else return Tag.Compound(JavaHashMap<String, Tag>())
        out.insert(String(side), read)
    }
    return Tag.Compound(out)
}

// A decorated pot's sherds as `DecoratedPotBlock.getDrops` gives them: its left, back, front and
// right sides' items, each its template's `create`, as `ItemStack.CODEC` writes it.
fn sherds_of(items: ItemCodecs, be: Tag) -> List<Tag?> {
    var out = List<Tag?>()
    let Tag.Compound(sides) = decorations_of(items, be) else return out
    let order: List<str> = ["left", "back", "front", "right"]
    for side in order {
        if not sides.contains(side) {
            continue
        }
        let Tag.Compound(t) = sides[side] else continue
        var stack = t.copy()
        if not stack.contains("count") {
            stack.insert(String("count"), Tag.Int(1))
        }
        out.push(some(Tag.Compound(stack)))
    }
    return out
}
