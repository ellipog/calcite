/// Chunk levels as vanilla works them out, its `DynamicGraphMinFixedPoint` and `ChunkTracker`
/// (D176). A chunk's level is the least of its own source's level and one more than each of its
/// eight neighbours', and the tracker settles that one queued chunk at a time, lowest first. The
/// loading tracker, the simulation tracker and the player distance trackers are all this graph,
/// each with its own levels and sources, which the tracker is given as it works and doesn't keep.
///
/// The order chunks settle in is vanilla's, so a tracker that sets a level and does something
/// for it, as the loading tracker schedules a chunk's holder, does those things in vanilla's
/// order: the queue of each level is in the order chunks joined it, and a chunk's neighbours are
/// checked `x` first, from the lowest, then `z`.
module world.levels

import world.pos.{ChunkPos}

/// The chunk every chunk's own source is read from, vanilla's `INVALID_CHUNK_POS`, `x` and `z`
/// 1875066, past the world's edge. It's a source, not a chunk, so its own level is never worked
/// out, and a chunk next to it reads its source there too.
pub const SOURCE_CHUNK: i64 = 8053347149716602

// What `computed` holds for a chunk whose level is settled: vanilla's map gives -1 for a chunk
// it doesn't have, and keeps the low byte of a level, so 255 is that either way.
const SETTLED: i32 = 255

/// A tracker's levels: where it keeps them, and what it does as one changes.
pub interface ChunkLevels {
    /// The chunk's level, vanilla's `getLevel`: the one the tracker last set, or the one a chunk
    /// with none has.
    fn level(self, chunk: i64) -> i32
    /// Sets the chunk's level as it settles, vanilla's `setLevel`.
    fn set_level(mut self, chunk: i64, level: i32)
}

/// Where a tracker's levels come from, vanilla's `getLevelFromSource`, read from `S`: a
/// dimension's tickets, or who's in each chunk.
pub interface LevelSources<S> {
    /// The level the chunk's own source gives it, from `sources`.
    fn source_level(self, sources: S, chunk: i64) -> i32
}

// Vanilla's `LeveledPriorityQueue`: a queue for each of `count` levels, in the order chunks
// joined it, and the lowest level that may have one, `count` when none does.
struct LeveledQueue {
    queues: List<LinkedSet<i64>>
    count: i32
    first: i32
}

impl LeveledQueue {
    fn new(level_count: i32) -> LeveledQueue {
        var queues = List<LinkedSet<i64>>()
        for _ in 0..level_count {
            queues.push(LinkedSet<i64>())
        }
        return LeveledQueue { queues: queues, count: level_count, first: level_count }
    }

    fn is_empty(self) -> bool {
        return self.first >= self.count
    }

    // Takes the first chunk of the lowest queue, `removeFirstLong`. The queue isn't empty.
    fn pop(mut self) -> i64 {
        let at = usize.wrap(self.first)
        let node = self.queues[at].pop_first() else {
            panic("level {self.first}'s queue is empty")
        }
        if self.queues[at].is_empty() {
            let count = self.count
            self.find_first(count)
        }
        return node
    }

    // Takes `node` from the queue of `level`, `dequeue`. If that was the lowest and is now empty,
    // the lowest is the next one below `upper` that isn't, or `upper`.
    fn remove(mut self, node: i64, level: i32, upper: i32) {
        let at = usize.wrap(level)
        self.queues[at].remove(node)
        if self.queues[at].is_empty() and self.first == level {
            self.find_first(upper)
        }
    }

    // Queues `node` at `level`, or leaves it where it is in that queue, `enqueue`.
    fn add(mut self, node: i64, level: i32) {
        self.queues[usize.wrap(level)].insert(node)
        if self.first > level {
            self.first = level
        }
    }

    // `checkFirstQueuedLevel`: the first queue past the lowest that isn't empty, looking no
    // further than `upper`.
    fn find_first(mut self, upper: i32) {
        let old = self.first
        self.first = upper
        for i in (old + 1)..upper {
            if not self.queues[usize.wrap(i)].is_empty() {
                self.first = i
                return
            }
        }
    }
}

/// A graph of chunk levels, vanilla's `ChunkTracker`: the chunks waiting to settle, each with
/// the level it's working out to. The levels themselves are the `ChunkLevels` a tracker is given.
pub struct ChunkTracker {
    /// How many levels there are. A chunk's level is from 0 to one less, the highest meaning
    /// it isn't reached.
    pub level_count: i32
    queue: LeveledQueue
    computed: Map<i64, u8>
}

impl ChunkTracker {
    /// A graph of `level_count` levels: 46 for loading, 34 for simulation, and two more than
    /// the distance for a player distance tracker.
    pub fn new(level_count: i32) -> ChunkTracker {
        return ChunkTracker { level_count: level_count, queue: LeveledQueue.new(level_count), computed: Map<i64, u8>() }
    }

    /// Whether chunks are waiting to settle, vanilla's `hasWork`.
    pub fn has_work(self) -> bool {
        return not self.queue.is_empty()
    }

    /// How many chunks are working out a level, vanilla's `getQueueSize`.
    pub fn queue_size(self) -> usize {
        return self.computed.len()
    }

    /// The chunk's source now gives it `level`, vanilla's `update`. `only_decreased` says it
    /// can only have gone down, as when a ticket's added, which needs no look at the neighbours.
    /// The chunk joins the queue, and nothing settles until `run_updates`, so this reads the
    /// levels but neither sets them nor reads the sources, and a ticket storage can call it as it
    /// changes.
    pub fn update<L: ChunkLevels>(mut self, chunk: i64, level: i32, only_decreased: bool, levels: L) {
        if chunk == SOURCE_CHUNK {
            return
        }
        let level_to = levels.level(chunk)
        let stored = self.stored(chunk)
        var found = 0
        if not only_decreased {
            // Vanilla's `getComputedLevel` with the source as the known parent, so the source
            // isn't read again: only the neighbours are.
            found = self.clamp(from_neighbours(chunk, SOURCE_CHUNK, self.clamp(level), levels))
        }
        self.check_edge(chunk, level, level_to, stored, only_decreased, found)
    }

    /// Settles up to `count` queued chunks, lowest first, setting their levels and queueing their
    /// neighbours, vanilla's `runUpdates`, and gives how many of `count` are left.
    pub fn run_updates<S, L: ChunkLevels + LevelSources<S>>(mut self, count: i32, levels: mut L, sources: S) -> i32 {
        var left = count
        while not self.queue.is_empty() and left > 0 {
            left -= 1
            let node = self.queue.pop()
            let level = self.clamp(levels.level(node))
            let computed = match self.computed.remove(node) {
                some(c) => i32(c),
                none => SETTLED,
            }
            if computed < level {
                levels.set_level(node, computed)
                self.check_neighbours(node, computed, true, levels, sources)
            } else if computed > level {
                let top = self.level_count - 1
                levels.set_level(node, top)
                if computed != top {
                    self.queue.add(node, self.priority(top, computed))
                    self.computed.insert(node, u8.wrap(computed))
                }
                self.check_neighbours(node, level, false, levels, sources)
            }
        }
        return left
    }

    fn clamp(self, level: i32) -> i32 {
        if level < 0 {
            return 0
        }
        return level.min(self.level_count - 1)
    }

    fn stored(self, chunk: i64) -> i32 {
        return match self.computed.get(chunk) {
            some(c) => i32(c),
            none => SETTLED,
        }
    }

    fn priority(self, level: i32, computed: i32) -> i32 {
        return level.min(computed).min(self.level_count - 1)
    }

    // Vanilla's private `checkEdge`, for `to` that isn't the source: `from_level` is the level
    // the edge gives it, `level_to` its level and `stored` what `computed` holds for it. A check
    // that isn't `only_decreased` works the level out again, which is `found`.
    fn check_edge(mut self, to: i64, from_level: i32, level_to: i32, stored: i32, only_decreased: bool, found: i32) {
        let from = self.clamp(from_level)
        let at = self.clamp(level_to)
        let settled = stored == SETTLED
        let old = if settled { at } else { stored }
        let new = if only_decreased { old.min(from) } else { found }
        let old_priority = self.priority(at, old)
        if at != new {
            let new_priority = self.priority(at, new)
            if old_priority != new_priority and not settled {
                self.queue.remove(to, old_priority, new_priority)
            }
            self.queue.add(to, new_priority)
            self.computed.insert(to, u8.wrap(new))
        } else if not settled {
            let count = self.level_count
            self.queue.remove(to, old_priority, count)
            _ = self.computed.remove(to)
        }
    }

    // Vanilla's `checkNeighborsAfterUpdate`: `node` settled at `level`, so each neighbour that
    // can take a level from it is checked. A level two below the top can't give a neighbour a
    // level when it only went down.
    fn check_neighbours<S, L: ChunkLevels + LevelSources<S>>(mut self, node: i64, level: i32, only_decreased: bool, levels: L, sources: S) {
        if only_decreased and level >= self.level_count - 2 {
            return
        }
        let x = i32.wrap(node)
        let z = i32.wrap(node >> 32)
        for dx in -1..2 {
            for dz in -1..2 {
                let neighbour = ChunkPos { x: x + dx, z: z + dz }.pack()
                if neighbour != node {
                    self.check_neighbour(node, neighbour, level, only_decreased, levels, sources)
                }
            }
        }
    }

    // Vanilla's `checkNeighbor`: `from` is at `level`. If its level only went down, `to` may
    // go down with it. If it went up, `to` is worked out again only if its level came from `from`.
    // `from` is a chunk, never the source, so the edge gives `to` one more than `level`.
    fn check_neighbour<S, L: ChunkLevels + LevelSources<S>>(mut self, from: i64, to: i64, level: i32, only_decreased: bool, levels: L, sources: S) {
        let stored = self.stored(to)
        let from_level = self.clamp(level + 1)
        if only_decreased {
            if to != SOURCE_CHUNK {
                self.check_edge(to, from_level, levels.level(to), stored, true, 0)
            }
            return
        }
        let settled = stored == SETTLED
        let old = if settled { self.clamp(levels.level(to)) } else { stored }
        if from_level != old or to == SOURCE_CHUNK {
            return
        }
        let level_to = if settled { old } else { levels.level(to) }
        let top = self.level_count - 1
        var found = from_neighbours(to, from, top, levels)
        if found > 0 {
            found = found.min(levels.source_level(sources, to))
        }
        let clamped = self.clamp(found)
        self.check_edge(to, top, level_to, stored, false, clamped)
    }
}

// Vanilla's `getComputedLevel` without the source: the lowest of `known`, which `parent`
// gives `node`, and one more than each other neighbour's level. Vanilla takes the source's
// level in with them, as `node` itself and as a neighbour that's the source, unless the
// source is `parent`. It stops at 0, and the level is clamped to 0 after, so the least of
// them is the same whenever the source is read, and it's read only if the neighbours don't
// give 0.
fn from_neighbours<L: ChunkLevels>(node: i64, parent: i64, known: i32, levels: L) -> i32 {
    var lowest = known
    let x = i32.wrap(node)
    let z = i32.wrap(node >> 32)
    for dx in -1..2 {
        for dz in -1..2 {
            let neighbour = ChunkPos { x: x + dx, z: z + dz }.pack()
            if neighbour != node and neighbour != SOURCE_CHUNK and neighbour != parent {
                lowest = lowest.min(levels.level(neighbour) + 1)
                if lowest <= 0 {
                    return lowest
                }
            }
        }
    }
    return lowest
}
