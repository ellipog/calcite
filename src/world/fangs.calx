/// An evoker's fangs, vanilla's `EvokerFangs` (CAL-200): 0.5 by 0.8, their values only `Entity`'s,
/// turned the way they were cast, `setYRot` of the radians times 180 over pi in floats, and owned by
/// the one that cast them, by UUID, `owner`. They wait `warmup` ticks, `warmupDelayTicks`; the first
/// tick after, their bite is shown to those who see them, entity event 4, which their clients
/// sound; 8 ticks after they're done waiting, they bite the living things their box meets, grown
/// 0.2 across, which their level does, `dealDamageTo`; and they're gone 23 ticks after they're
/// done waiting, `lifeTicks`. Nothing hurts them, `hurtServer`. Their level sends them as
/// `ClientboundAddEntityPacket` does, run every 2 ticks, seen 6 chunks off, their motion never
/// sent as it changes, `dontTrackDeltas`.
module world.fangs

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, bool_or, int_or}
import world.uuids.{uuid_of, uuid_tag}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, knot_data}

/// What fangs do this tick that their level does: show their bite, entity event 4, and bite.
pub struct FangsTick {
    pub spike: bool = false
    pub bite: bool = false
}

/// Fangs.
pub struct EvokerFangs {
    pub body: Body
    pub data: EntityData
    /// Their ticks left to wait, `warmupDelayTicks`, below 0 once they're done.
    pub warmup: i32 = 0
    // Whether their bite was shown, `sentSpikeEvent`, and their ticks left once they're done
    // waiting, `lifeTicks`.
    sent_spike: bool = false
    life: i32 = 22
    /// Who cast them, by UUID, `owner`.
    pub owner: (i64, i64)? = none
}

impl EvokerFangs {
    /// Fangs cast at x, y, z, turned `radians`, to wait `warmup` ticks, by `owner`,
    /// `EvokerFangs(level, x, y, z, rotationRadians, warmupDelayTicks, owner)`: `Entity`'s fields,
    /// its random first, then its UUID; then their warmup, owner and turn; then their place,
    /// `setPos`, which has them synced.
    pub fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, radians: f32, warmup: i32, owner: (i64, i64)?) -> EvokerFangs {
        var body = Body.made(id, seed, x, y, z, 0.5f32, 0.8f32, 0.8f32 * 0.85f32, 0.0)
        body.y_rot = radians * (180.0f32 / 3.1415927f32)
        body.needs_sync = true
        return EvokerFangs { body: body, data: knot_data(), warmup: warmup, owner: owner }
    }

    /// Fangs as `EntityType.create` makes them, `EvokerFangs(type, level)`, waiting none and
    /// owned by no one, read from `tag` as `Entity.load` reads them in (CAL-165); `none` where they
    /// don't load, logged in `lines`.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> EvokerFangs? {
        var f = EvokerFangs { body: Body.made(id, seed, 0.0, 0.0, 0.0, 0.5f32, 0.8f32, 0.8f32 * 0.85f32, 0.0), data: knot_data() }
        if not f.load_onto(tag, mut lines) {
            return none
        }
        return some(f)
    }

    /// `Entity.load` onto them as they are, as `data` changes an entity's data (CAL-165): what
    /// every entity reads, their values from it, how long they wait, `Warmup`, 0 where it's
    /// missing, and who cast them, `Owner`; their life and whether their bite was shown kept.
    pub fn load_onto(mut self, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.data.set(AIR_SUPPLY, Value.Number(self.body.air))
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.warmup = int_or(tag, "Warmup", 0)
        self.owner = uuid_of(tag, "Owner")
        return true
    }

    /// Their tick, `EvokerFangs.tick`, at the level's bottom `min_y`: gone below the world; else,
    /// done waiting, their bite at the 8th tick after, their bite shown the first tick after, and
    /// gone once their life's out.
    pub fn tick(mut self, min_y: i32) -> FangsTick {
        var out = FangsTick()
        self.body.tick_count += 1
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
            return out
        }
        self.warmup -= 1
        if self.warmup < 0 {
            if self.warmup == -8 {
                out.bite = true
            }
            if not self.sent_spike {
                out.spike = true
                self.sent_spike = true
            }
            self.life -= 1
            if self.life < 0 {
                self.body.removed = true
            }
        }
        return out
    }

    /// What it's saved as, `saveWithoutId` with its type: what every entity saves, then how long it
    /// waits, `Warmup`, and its owner where it has one, `Owner`.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:evoker_fangs")
        t.insert(String("Warmup"), Tag.Int(self.warmup))
        if let o = self.owner {
            t.insert(String("Owner"), uuid_tag(o))
        }
        return Tag.Compound(t)
    }

    /// Whether they're silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }
}
