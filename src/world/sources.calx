/// The blocks that make a signal of their own (CAL-128): buttons, levers, pressure plates, the
/// tripwire hook and tripwire, targets, lightning rods, lecterns and sculk sensors, as each
/// class's `onPlace`, `affectNeighborsAfterRemoval` and `tick` has them, from javap. Their signals
/// are their states', in `worldgen.facts`' tables; the detector rail's hooks are `world.rails`'.
/// What presses them is entities, and the level has none but its players: a pressure plate or a
/// tripwire counts the players in it, each by a standing player's box, and the arrows a wooden
/// button looks for aren't there. Stepping onto one, `entityInside`, comes with Phase 6's
/// entities, as do the game events these blocks send, which only sculk sensors hear.
module world.sources

import random.source.{RandomSource}
import world.block_level.{BlockLevel}
import world.level_writer.{UPDATE_LIMIT}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, SOUTH, WEST, connected_direction, direction_name, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{facing_of}

// How far a tripwire hook looks for the other, `TripWireHookBlock`'s 42, and `TripWireBlock`'s
// for the hooks.
const HOOK_REACH: i32 = 42

/// `onPlace` of a source, where the block `state` is set at `x`, `y`, `z` where `old` was: whether
/// `kind`, the class whose `onPlace` it runs, is a source's, having run it.
pub fn source_placed<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, kind: String, state: u32, x: i32, y: i32, z: i32, old: u32) -> bool ! Thrown {
    let block = f.block(state)
    if kind == "TripWireBlock" {
        // Where it wasn't tripwire, the hooks it joins told, `updateSource`.
        if f.block(old) != block {
            try update_source(f, mut level, state, x, y, z)
        }
        return true
    }
    if kind == "TargetBlock" or kind == "SculkSensorBlock" {
        // Set with power where it wasn't of its kind, as a command or a structure sets it, with no
        // tick of its own waiting to take it away: set without it at once, with flags 18.
        if f.block(old) != block and (f.get_int(state, "power") ?? 0) > 0 and not level.has_block_tick(block, x, y, z) {
            _ = level.set_block_limited(x, y, z, try f.with_int(state, "power", 0), 18, UPDATE_LIMIT)
        }
        return true
    }
    if kind == "LightningRodBlock" {
        // Set powered where it wasn't of its kind, with no tick waiting: its tick to let go, 8 on.
        if f.block(old) != block and f.get_bool(state, "powered") and not level.has_block_tick(block, x, y, z) {
            level.schedule_block(block, x, y, z, 8, 0)
        }
        return true
    }
    return false
}

/// `affectNeighborsAfterRemoval` of a source, the block `old` replaced at `x`, `y`, `z`, `moved` if
/// a piston moved it: whether `kind`, the class whose hook it runs, is a source's, having run it.
pub fn source_removed<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, kind: String, old: u32, x: i32, y: i32, z: i32, moved: bool) -> bool ! Thrown {
    let block = f.block(old)
    if kind == "ButtonBlock" or kind == "LeverBlock" {
        if not moved and f.get_bool(old, "powered") {
            try attached_neighbours(f, mut level, old, x, y, z)
        }
        return true
    }
    if kind == "BasePressurePlateBlock" {
        if not moved and plate_signal(f, old) > 0 {
            plate_neighbours(mut level, block, x, y, z)
        }
        return true
    }
    if kind == "TripWireHookBlock" {
        if not moved {
            try hook_removed(f, mut level, old, x, y, z)
        }
        return true
    }
    if kind == "TripWireBlock" {
        // The hooks it joined told it went, as though it were powered, which a hook takes as
        // its wire tripped.
        if not moved {
            try update_source(f, mut level, try f.with_bool(old, "powered", true), x, y, z)
        }
        return true
    }
    if kind == "LightningRodBlock" {
        if f.get_bool(old, "powered") {
            try rod_neighbours(f, mut level, old, x, y, z)
        }
        return true
    }
    if kind == "LecternBlock" {
        // `updateBelow`.
        if f.get_bool(old, "powered") {
            level.update_neighbours(x, y - 1, z, block)
        }
        return true
    }
    if kind == "SculkSensorBlock" {
        if sculk_phase(f, old) == "active" {
            sculk_neighbours(mut level, block, x, y, z)
        }
        return true
    }
    return false
}

/// `tick` of a source, the block `state` at `x`, `y`, `z`: whether `kind`, the class whose `tick`
/// it runs, is a source's, having run it.
pub fn source_tick<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, kind: String, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let block = f.block(state)
    if kind == "ButtonBlock" {
        if f.get_bool(state, "powered") {
            try button_check(f, mut level, state, x, y, z)
        }
        return true
    }
    if kind == "BasePressurePlateBlock" {
        let signal = plate_signal(f, state)
        if signal > 0 {
            try plate_check(f, mut level, state, x, y, z, signal)
        }
        return true
    }
    if kind == "TripWireHookBlock" {
        try calculate_state(f, mut level, state, x, y, z, false, true, -1, none)
        return true
    }
    if kind == "TripWireBlock" {
        // As the level has it now, which the tick's state is.
        if f.get_bool(try level.state(f, x, y, z), "powered") {
            try tripwire_check(f, mut level, x, y, z)
        }
        return true
    }
    if kind == "TargetBlock" {
        if (f.get_int(state, "power") ?? 0) != 0 {
            _ = level.set_block_limited(x, y, z, try f.with_int(state, "power", 0), 3, UPDATE_LIMIT)
        }
        return true
    }
    if kind == "LightningRodBlock" {
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", false), 3, UPDATE_LIMIT)
        try rod_neighbours(f, mut level, state, x, y, z)
        return true
    }
    if kind == "LecternBlock" {
        // `changePowered`, off, then `updateBelow`.
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", false), 3, UPDATE_LIMIT)
        level.update_neighbours(x, y - 1, z, block)
        return true
    }
    if kind == "SculkSensorBlock" {
        try sculk_tick(f, mut level, state, x, y, z)
        return true
    }
    if kind == "ChestBlock" {
        // `ChestBlockEntity.recheckOpen`: nobody can have a container open in Calcite yet, so
        // none is counted, as none was, and nothing changes.
        return true
    }
    return false
}

/// `ButtonBlock.updateNeighbours` and `LeverBlock`'s: the blocks around it told, then those around
/// the block it's fixed to.
pub fn attached_neighbours<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let block = f.block(state)
    let face = f.get_name(state, "face") ?? String("wall")
    let d = opposite(connected_direction(face, try facing_of(f, state)))
    level.update_neighbours(x, y, z, block)
    level.update_neighbours(x + step_x(d), y + step_y(d), z + step_z(d), block)
}

// `ButtonBlock.checkPressed`: pressed while an arrow is in it, for a button an arrow presses, and
// Calcite has no arrows, so a pressed one is let go, set with flags 3, the blocks around told and
// its sound played; it ticks again only while pressed.
fn button_check<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if not f.get_bool(state, "powered") {
        return
    }
    _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", false), 3, UPDATE_LIMIT)
    try attached_neighbours(f, mut level, state, x, y, z)
    click(f, mut level, f.block(state), x, y, z, false)
}

// A button's or pressure plate's sound as it's pressed, if `on`, or let go, from its
// `BlockSetType`, at full volume and pitch, `playSound(player, pos, sound, BLOCKS)`.
fn click<L: BlockLevel>(f: Facts, level: mut L, block: u32, x: i32, y: i32, z: i32, on: bool) {
    let sound = f.toggle_sound(block, on) else return
    level.play_sound(x, y, z, sound, 1.0f32, 1.0f32)
}

// `BasePressurePlateBlock.getSignalForState`: a wooden or stone plate's 15 while powered, a
// weighted one's `power`.
fn plate_signal(f: Facts, state: u32) -> i32 {
    if f.has(state, "powered") {
        return if f.get_bool(state, "powered") { 15 } else { 0 }
    }
    return f.get_int(state, "power") ?? 0
}

// `setSignalForState`.
fn with_plate_signal(f: Facts, state: u32, signal: i32) -> u32 ! Thrown {
    if f.has(state, "powered") {
        return try f.with_bool(state, "powered", signal > 0)
    }
    return try f.with_int(state, "power", signal)
}

// `getSignalStrength`, of the entities in `TOUCH_AABB`, `Block.column(14, 0, 4)` moved to the
// plate, but spectators and those ignoring block triggers: the players. A wooden or stone plate
// gives 15 for any, whether it counts every entity or the living ones; a weighted one,
// `ceil(min(count, maxWeight) / maxWeight * 15)` in floats.
fn plate_strength<L: BlockLevel>(f: Facts, level: L, block: u32, x: i32, y: i32, z: i32) -> i32 {
    let count = level.players_touching(f64(x) + 0.0625, f64(y), f64(z) + 0.0625, f64(x) + 0.9375, f64(y) + 0.25, f64(z) + 0.9375)
    let max = f.plate_weight(block)
    if max == 0 {
        return if count > 0 { 15 } else { 0 }
    }
    let n = count.min(max)
    if n <= 0 {
        return 0
    }
    let share = f32.nearest(f64(max.min(n))) / f32.nearest(f64(max))
    return ceil_float(share * 15.0f32)
}

// `Mth.ceil` of a float.
fn ceil_float(v: f32) -> i32 {
    let i = i32.saturate(f64(v))
    return if v > f32.nearest(f64(i)) { i + 1 } else { i }
}

// `BasePressurePlateBlock.checkPressed`, from its tick, the plate `state` at x, y, z giving
// `signal`: set to what the entities on it give now with flags 2, then the blocks around it and
// under it told; its sound as it's let go or pressed; and its tick again while pressed, 20 on, or
// a weighted one's 10.
fn plate_check<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, signal: i32) ! Thrown {
    let block = f.block(state)
    let now = plate_strength(f, level, block, x, y, z)
    let was_on = signal > 0
    let on = now > 0
    if signal != now {
        _ = level.set_block_limited(x, y, z, try with_plate_signal(f, state, now), 2, UPDATE_LIMIT)
        plate_neighbours(mut level, block, x, y, z)
    }
    if not on and was_on {
        click(f, mut level, block, x, y, z, false)
    } else if on and not was_on {
        click(f, mut level, block, x, y, z, true)
    }
    if on {
        level.schedule_block(block, x, y, z, if f.plate_weight(block) > 0 { 10 } else { 20 }, 0)
    }
}

// `BasePressurePlateBlock.updateNeighbours`: the blocks around it told, then those around the
// block under it.
fn plate_neighbours<L: BlockLevel>(level: mut L, block: u32, x: i32, y: i32, z: i32) {
    level.update_neighbours(x, y, z, block)
    level.update_neighbours(x, y - 1, z, block)
}

// `LightningRodBlock.updateNeighbours`: the blocks around the one it's fixed to told.
fn rod_neighbours<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let d = opposite(try facing_of(f, state))
    level.update_neighbours(x + step_x(d), y + step_y(d), z + step_z(d), f.block(state))
}

// The sculk sensor's `sculk_sensor_phase`.
fn sculk_phase(f: Facts, state: u32) -> String {
    return f.get_name(state, "sculk_sensor_phase") ?? String("inactive")
}

// `SculkSensorBlock.updateNeighbours`: the blocks around it told, then those around the block
// under it.
fn sculk_neighbours<L: BlockLevel>(level: mut L, block: u32, x: i32, y: i32, z: i32) {
    level.update_neighbours(x, y, z, block)
    level.update_neighbours(x, y - 1, z, block)
}

// `SculkSensorBlock.tick`: an active sensor goes to its cooldown with no power, `deactivate`,
// ticking again 10 on, and the blocks around it and under it told; one cooling down goes
// inactive, with its clicking stopping unless it's under water. What makes one active is a game
// event it hears, which comes with entities.
fn sculk_tick<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let block = f.block(state)
    let phase = sculk_phase(f, state)
    if phase == "active" {
        let cooling = try f.with_int(try f.with_name(state, "sculk_sensor_phase", "cooldown"), "power", 0)
        _ = level.set_block_limited(x, y, z, cooling, 3, UPDATE_LIMIT)
        level.schedule_block(block, x, y, z, 10, 0)
        sculk_neighbours(mut level, block, x, y, z)
        return
    }
    if phase == "cooldown" {
        _ = level.set_block_limited(x, y, z, try f.with_name(state, "sculk_sensor_phase", "inactive"), 3, UPDATE_LIMIT)
        if not f.get_bool(state, "waterlogged") {
            let pitch = level.next_float() * 0.2f32 + 0.8f32
            level.play_sound(x, y, z, "block.sculk_sensor.clicking_stop", 1.0f32, pitch)
        }
    }
}

// `TripWireBlock.updateSource`: from the tripwire `state` at x, y, z, south then west, along the
// tripwire to a hook facing back along it, if one is within 42, which works out its state with
// this wire as its source, `calculateState`.
fn update_source<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let ways: List<i32> = [SOUTH, WEST]
    for d in ways {
        var i = 1
        while i < HOOK_REACH {
            let (px, py, pz) = (x + step_x(d) * i, y + step_y(d) * i, z + step_z(d) * i)
            let s = try level.state(f, px, py, pz)
            if f.block(s) == f.ids.tripwire_hook {
                if try facing_of(f, s) == opposite(d) {
                    try calculate_state(f, mut level, s, px, py, pz, false, true, i, some(state))
                }
                break
            }
            if f.block(s) != f.ids.tripwire {
                break
            }
            i += 1
        }
    }
}

// `TripWireBlock.tick`'s `checkPressed`: the entities in its shape, `SHAPE_ATTACHED`'s
// `column(16, 1, 2.5)` while it's attached, else `SHAPE_NOT_ATTACHED`'s `column(16, 0, 8)`, but
// spectators: the players.
fn tripwire_check<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    let state = try level.state(f, x, y, z)
    let (low, high) = if f.get_bool(state, "attached") { (0.0625, 0.15625) } else { (0.0, 0.5) }
    let count = level.players_touching(f64(x), f64(y) + low, f64(z), f64(x) + 1.0, f64(y) + high, f64(z) + 1.0)
    try tripwire_pressed(f, mut level, x, y, z, count > 0)
}

// `TripWireBlock.checkPressed` with the entities found: set powered or not with flags 3 as that
// changes, with its hooks told; then its tick 10 on while pressed, or 1 on as it's let go.
fn tripwire_pressed<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, pressed: bool) ! Thrown {
    let state = try level.state(f, x, y, z)
    let was = f.get_bool(state, "powered")
    if pressed != was {
        let next = try f.with_bool(state, "powered", pressed)
        _ = level.set_block_limited(x, y, z, next, 3, UPDATE_LIMIT)
        try update_source(f, mut level, next, x, y, z)
    }
    if pressed {
        level.schedule_block(f.ids.tripwire, x, y, z, 10, 0)
    } else if was {
        level.schedule_block(f.ids.tripwire, x, y, z, 1, 0)
    }
}

// `TripWireHookBlock.onRemoved`: a hook taken away that was attached or powered works its line
// out again as one being destroyed, and one that was powered tells the blocks around it and
// around the block it was fixed to.
fn hook_removed<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let attached = f.get_bool(state, "attached")
    let powered = f.get_bool(state, "powered")
    if attached or powered {
        try calculate_state(f, mut level, state, x, y, z, true, false, -1, none)
    }
    if powered {
        hook_neighbours(mut level, f.block(state), x, y, z, try facing_of(f, state))
    }
}

// `TripWireHookBlock.notifyNeighbors`: the blocks around the hook at x, y, z told, then those
// around the block it's fixed to, behind it as it faces `d`.
fn hook_neighbours<L: BlockLevel>(level: mut L, block: u32, x: i32, y: i32, z: i32, d: i32) {
    let back = opposite(d)
    level.update_neighbours(x, y, z, block)
    level.update_neighbours(x + step_x(back), y + step_y(back), z + step_z(back), block)
}

// `TripWireHookBlock.calculateState`, of the hook `state` at x, y, z, `destroyed` as it's taken
// away, telling the blocks around it if `notify`, with the tripwire `source` along from it, if
// it's 1 or more, as `source_state`, which a wire just set or taken away gives. Along the way it
// faces, to 41 blocks, it looks for another hook facing back, which ends the line wherever it's
// met, as does anything but tripwire or the source; each tripwire on the way is kept, and its
// line is tripped where one that isn't disarmed is powered. At the source it ticks again 10 on,
// and a disarmed source detaches it. It's attached where it isn't being taken away, the line is
// all tripwire to another hook more than one along, and powered only while attached. The other
// hook is set to match, facing back, with its sound, unless this one was taken away by then,
// when that is worked out instead; then its own sound, its state set facing the way it did, and,
// as it's attached or detached, each tripwire kept on the line that's still tripwire or a hook.
fn calculate_state<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, destroyed: bool, notify: bool, source: i32, source_state: u32?) ! Thrown {
    if not f.has(state, "facing") {
        return
    }
    let d = try facing_of(f, state)
    let was_attached = f.get_bool(state, "attached")
    let was_powered = f.get_bool(state, "powered")
    let block = f.block(state)
    var attached = not destroyed
    var powered = false
    var receiver = 0
    var wires = List<u32?>()
    wires.push(none)
    var i = 1
    while i < HOOK_REACH {
        let (px, py, pz) = (x + step_x(d) * i, y + step_y(d) * i, z + step_z(d) * i)
        var s = try level.state(f, px, py, pz)
        if f.block(s) == f.ids.tripwire_hook {
            if try facing_of(f, s) == opposite(d) {
                receiver = i
            }
            break
        }
        if f.block(s) == f.ids.tripwire or i == source {
            if i == source {
                s = source_state ?? s
            }
            let armed = not f.get_bool(s, "disarmed")
            powered = powered or (armed and f.get_bool(s, "powered"))
            wires.push(some(s))
            if i == source {
                level.schedule_block(block, x, y, z, 10, 0)
                attached = attached and armed
            }
        } else {
            wires.push(none)
            attached = false
        }
        i += 1
    }
    attached = attached and receiver > 1
    powered = powered and attached
    let fresh = f.try_bool(f.try_bool(f.default_state(block), "attached", attached), "powered", powered)
    if receiver > 0 {
        let (ox, oy, oz) = (x + step_x(d) * receiver, y + step_y(d) * receiver, z + step_z(d) * receiver)
        let back = opposite(d)
        _ = level.set_block_limited(ox, oy, oz, try f.with_name(fresh, "facing", direction_name(back)), 3, UPDATE_LIMIT)
        hook_neighbours(mut level, block, ox, oy, oz, back)
        if f.block(try level.state(f, x, y, z)) != f.ids.tripwire_hook {
            try hook_removed(f, mut level, fresh, x, y, z)
            return
        }
        emit_state(mut level, ox, oy, oz, attached, powered, was_attached, was_powered)
    }
    emit_state(mut level, x, y, z, attached, powered, was_attached, was_powered)
    if not destroyed {
        _ = level.set_block_limited(x, y, z, try f.with_name(fresh, "facing", direction_name(d)), 3, UPDATE_LIMIT)
        if notify {
            hook_neighbours(mut level, block, x, y, z, d)
        }
    }
    if was_attached == attached {
        return
    }
    var j = 1
    while j < receiver {
        let kept = wires[usize.wrap(j)]
        if let w = kept {
            let (wx, wy, wz) = (x + step_x(d) * j, y + step_y(d) * j, z + step_z(d) * j)
            let now = f.block(try level.state(f, wx, wy, wz))
            if now == f.ids.tripwire or now == f.ids.tripwire_hook {
                _ = level.set_block_limited(wx, wy, wz, f.try_bool(w, "attached", attached), 3, UPDATE_LIMIT)
            }
        }
        j += 1
    }
}

// `TripWireHookBlock.emitState`: a hook's sound as its line is tripped or let go, else as it's
// attached or detached, at volume 0.4, a detached one's pitch drawn from the level's random.
fn emit_state<L: BlockLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, attached: bool, powered: bool, was_attached: bool, was_powered: bool) {
    if powered and not was_powered {
        level.play_sound(x, y, z, "block.tripwire.click_on", 0.4f32, 0.6f32)
    } else if not powered and was_powered {
        level.play_sound(x, y, z, "block.tripwire.click_off", 0.4f32, 0.5f32)
    } else if attached and not was_attached {
        level.play_sound(x, y, z, "block.tripwire.attach", 0.4f32, 0.7f32)
    } else if not attached and was_attached {
        let pitch = 1.2f32 / (level.next_float() * 0.2f32 + 0.9f32)
        level.play_sound(x, y, z, "block.tripwire.detach", 0.4f32, pitch)
    }
}
