/// An anvil's work, as vanilla's `AnvilMenu` does it (CAL-338): what its two inputs make,
/// `createResult`, repaired by a material, mended with another of the item, with an enchanted
/// book's or the other's enchantments put on, renamed, and what that costs in levels.
module world.anvil

import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import world.enchanting.{Enchanting}
import world.grindstone.{crafting_enchantments, damage_value, damageable, enchantments_type, level_in, levels_of, max_damage, set_component, set_damage}

/// An anvil's menu beyond its slots: the name typed, `itemName`, none before one's typed; what
/// taking its result costs, its data slot; how many of the material repairing takes,
/// `repairItemCountCost`; and whether it only renames, `onlyRenaming`.
pub struct Anvil {
    pub name: String? = none
    pub cost: i32 = 0
    pub repair_count: i32 = 0
    pub only_renaming: bool = false
}

/// `createResult` of `input` and `addition`, the first's name being `hover`, `getHoverName`'s
/// text, for a player with infinite materials or not: what it makes, none for nothing, with what
/// it costs and takes set in `state`; and whether it broadcast its changes, `broadcastChanges`,
/// which it does wherever the input can hold enchantments and nothing refuses it first.
pub fn anvil_result(state: mut Anvil, input: Tag?, addition: Tag?, hover: String, infinite: bool, items: ItemCodecs, enchanting: Enchanting) -> (Tag?, bool) {
    state.only_renaming = false
    state.cost = 1
    let a = input else {
        state.cost = 0
        return (none, false)
    }
    // `canStoreEnchantments`: its enchantments component, whichever it has, there.
    if items.component(a, String(enchantments_type(a))) == none {
        state.cost = 0
        return (none, false)
    }
    var result = a.copy()
    var levels = levels_of(items.component(result, String(enchantments_type(result))) ?? Tag.End)
    var price: i32 = 0
    var tax: i64 = i64(repair_cost(some(a.copy()), items)) + i64(repair_cost(addition.copy(), items))
    var naming: i32 = 0
    state.repair_count = 0
    if let b = addition.copy() {
        let using_book = items.component(b, String("minecraft:stored_enchantments")) != none
        if damageable(result, items) and repairs(a, b, items) {
            var amount = damage_value(result, items).min(max_damage(result, items) / 4)
            if amount <= 0 {
                state.cost = 0
                return (none, false)
            }
            var n: i32 = 0
            while amount > 0 and n < count(some(b.copy())) {
                result = set_damage(result, damage_value(result, items) - amount, items)
                price += 1
                amount = damage_value(result, items).min(max_damage(result, items) / 4)
                n += 1
            }
            state.repair_count = n
        } else {
            if not using_book and (item(result) != item(b) or not damageable(result, items)) {
                state.cost = 0
                return (none, false)
            }
            if damageable(result, items) and not using_book {
                let remaining1 = max_damage(a, items) - damage_value(a, items)
                let remaining2 = max_damage(b, items) - damage_value(b, items)
                let additional = remaining2 + max_damage(result, items) * 12 / 100
                let remaining = remaining1 + additional
                let damage = (max_damage(result, items) - remaining).max(0)
                if damage < damage_value(result, items) {
                    result = set_damage(result, damage, items)
                    price += 2
                }
            }
            var any_compatible = false
            var any_not = false
            for (name, given) in crafting_enchantments(b, items) {
                let id = enchanting.id_of(name.copy()) else continue
                let def = enchanting.defs[usize.wrap(id)].copy()
                let current = level_in(levels, name.copy())
                var level = if current == given { given + 1 } else { given.max(current) }
                var compatible = def.supports(item(a))
                if infinite or item(a) == "minecraft:enchanted_book" {
                    compatible = true
                }
                for (other, _) in levels {
                    if other == name {
                        continue
                    }
                    let other_id = enchanting.id_of(other.copy()) else continue
                    if not enchanting.compatible(id, other_id) {
                        compatible = false
                        price += 1
                    }
                }
                if not compatible {
                    any_not = true
                } else {
                    any_compatible = true
                    if level > def.max_level {
                        level = def.max_level
                    }
                    // `ItemEnchantments.Mutable.set`: none at a level below 1.
                    if level <= 0 {
                        _ = levels.remove(name.copy())
                    } else {
                        levels.insert(name.copy(), Tag.Int(level))
                    }
                    var fee = def.anvil_cost
                    if using_book {
                        fee = (fee / 2).max(1)
                    }
                    price += fee * level
                    if count(some(a.copy())) > 1 {
                        price = 40
                    }
                }
            }
            if any_not and not any_compatible {
                state.cost = 0
                return (none, false)
            }
        }
    }
    if let typed = state.name.copy() {
        if not blank(typed.copy()) {
            if typed != hover {
                naming = 1
                price += naming
                result = set_component(result, "minecraft:custom_name", Tag.Str(typed), items)
            }
        } else if items.component(a, String("minecraft:custom_name")) != none {
            naming = 1
            price += naming
            result = remove_component(result, "minecraft:custom_name", items)
        }
    } else if items.component(a, String("minecraft:custom_name")) != none {
        naming = 1
        price += naming
        result = remove_component(result, "minecraft:custom_name", items)
    }
    tax += i64(price)
    state.cost = if price <= 0 { 0 } else if tax > 2147483647 { 2147483647 } else if tax < 0 { 0 } else { i32.wrap(tax) }
    var out: Tag? = some(result.copy())
    if price <= 0 {
        out = none
    }
    if naming == price and naming > 0 {
        if state.cost >= 40 {
            state.cost = 39
        }
        state.only_renaming = true
    }
    if state.cost >= 40 and not infinite {
        out = none
    }
    if let r = out.copy() {
        var base = repair_cost(some(r.copy()), items).max(repair_cost(addition.copy(), items))
        if naming != price or naming == 0 {
            base = increased_repair_cost(base)
        }
        var made = set_component(r, "minecraft:repair_cost", Tag.Int(base), items)
        let kind = enchantments_type(made)
        made = set_component(made, kind, Tag.Compound(levels), items)
        out = some(made)
    }
    return (out, true)
}

/// `calculateIncreasedRepairCost`: twice and one more, at most an int's most.
pub fn increased_repair_cost(base: i32) -> i32 {
    let next = i64(base) * 2 + 1
    return if next > 2147483647 { 2147483647 } else { i32.wrap(next) }
}

/// `validateName` of a name typed, `StringUtil.filterText`: what's left without the section sign,
/// control characters and delete; none where that's more than 50.
pub fn valid_name(name: String) -> String? {
    var out = String()
    for r in name.runes() {
        let v = u32(r)
        if v == 167 or v < 32 or v == 127 {
            continue
        }
        out.push(r)
    }
    // Its length in UTF-16 units, as Java counts it.
    if out.utf16_len() > 50 {
        return none
    }
    return some(out)
}

// `StringUtil.isBlank`: nothing but whitespace.
fn blank(s: String) -> bool {
    return s.trim().is_empty()
}

// `isValidRepairItem`: the input's `repairable` items holding the addition's item.
fn repairs(input: Tag, addition: Tag, items: ItemCodecs) -> bool {
    let found = items.component(input, String("minecraft:repairable")) else return false
    let Tag.Compound(r) = found else return false
    if not r.contains("items") {
        return false
    }
    let id = items.builtin_id("item", item(addition)) else return false
    return items.holder_set_has("item", r["items"].copy(), id)
}

// `getOrDefault(REPAIR_COST, 0)`.
fn repair_cost(stack: Tag?, items: ItemCodecs) -> i32 {
    let s = stack else return 0
    return match items.component(s, String("minecraft:repair_cost")) {
        some(t) => t.number_int() ?? 0,
        none => 0,
    }
}

// `ItemStack.remove`: the component `name` out of the stack's patch, or marked taken away where
// its item has it.
pub fn remove_component(stack: Tag, name: str, items: ItemCodecs) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    var patch = JavaHashMap<String, Tag>()
    if m.contains("components") {
        if let Tag.Compound(p) = m["components"].copy() {
            patch = p
        }
    }
    _ = patch.remove(String(name))
    if items.default_component(item(stack), String(name)) != none {
        patch.insert("!{name}", Tag.Compound(JavaHashMap<String, Tag>()))
    }
    if patch.is_empty() {
        _ = out.remove(String("components"))
    } else {
        out.insert(String("components"), Tag.Compound(patch))
    }
    return Tag.Compound(out)
}

fn item(stack: Tag) -> String {
    let Tag.Compound(m) = stack else return String("minecraft:air")
    if not m.contains("id") {
        return String("minecraft:air")
    }
    return match m["id"].copy() {
        Tag.Str(s) => s,
        _ => String("minecraft:air"),
    }
}

fn count(stack: Tag?) -> i32 {
    let s = stack else return 0
    let Tag.Compound(m) = s else return 0
    if not m.contains("count") {
        return 1
    }
    return m["count"].number_int() ?? 1
}
