/// Golems built of blocks, `CarvedPumpkinBlock.trySpawnGolem` (CAL-201): a carved pumpkin or jack
/// o'lantern set where it wasn't looks for a snow golem's pattern about it, then an iron golem's,
/// then a copper golem's, `BlockPattern.find`, and where one matches its blocks are cleared, each
/// heard broken, the golem made, `spawnGolemInWorld`, and the blocks about them told.
module world.golem_building

import world.block_level.{BLOCK_BROKEN, BlockLevel}
import world.end_portal.{turned}
import world.level_writer.{UPDATE_LIMIT}
import world.pos.{BlockPos}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, clockwise, direction_name, opposite, step_x, step_z}
import worldgen.survive.{facing_of}
import worldgen.interval.{Thrown}

/// A snow golem, built of two snow blocks under a pumpkin.
pub const SNOW_GOLEM_BUILT: i32 = 0
/// An iron golem, built of four iron blocks in a T under a pumpkin, air at the arms' feet and
/// beside the head.
pub const IRON_GOLEM_BUILT: i32 = 1
/// A copper golem, built of a block of copper under a pumpkin, its weathering, 0 to 3, added
/// (CAL-317).
pub const COPPER_GOLEM_BUILT: i32 = 2

// The blocks the patterns are of, by their IDs.
struct Blocks {
    carved: u32
    lantern: u32
    snow: u32
    iron: u32
    // Whether it's the pattern's base, its pumpkin's place any block (CAL-378).
    base: bool = false
    // The wither skeleton's skulls, on the floor and on a wall (CAL-401).
    skull: u32 = 0
    wall_skull: u32 = 0
}

/// `trySpawnGolem(level, pos)` for the pumpkin at x, y, z: the snow golem's pattern found from
/// there, `getOrCreateSnowGolemFull`, then the iron golem's, `getOrCreateIronGolemFull`, then
/// the copper golem's, `getOrCreateCopperGolemFull`, and the first found built. A snow golem is
/// made at its pattern's foot, `getBlock(0, 2, 0)`, an iron golem at its, `getBlock(1, 2, 0)`,
/// made by a player, `setPlayerCreated`; a copper golem at its pumpkin's place, `getBlock(0, 0, 0)`,
/// its block of copper then a copper chest, `replaceCopperBlockWithChest`, and the golem as
/// weathered as the copper was, `spawn` (CAL-317).
pub fn try_spawn_golem<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    let b = Blocks {
        carved: try f.named_block(String("carved_pumpkin")),
        lantern: try f.named_block(String("jack_o_lantern")),
        snow: try f.named_block(String("snow_block")),
        iron: try f.named_block(String("iron_block")),
    }
    if let m = try find(f, level, b, SNOW_GOLEM_BUILT, x, y, z) {
        try spawn_in_world(f, mut level, m, SNOW_GOLEM_BUILT, 1, 3, 0, 2)
        return
    }
    if let m = try find(f, level, b, IRON_GOLEM_BUILT, x, y, z) {
        try spawn_in_world(f, mut level, m, IRON_GOLEM_BUILT, 3, 3, 1, 2)
        return
    }
    if let m = try find(f, level, b, COPPER, x, y, z) {
        let head = m.at(0, 0)
        let base = m.at(0, 1)
        let pumpkin = try level.state(f, head.x, head.y, head.z)
        let copper = try level.state(f, base.x, base.y, base.z)
        let at = copper_index(f, copper)
        let (_, _, weather) = copper_chests()[at]
        try spawn_in_world(f, mut level, m, COPPER_GOLEM_BUILT + weather, 1, 2, 0, 0)
        let chest = try copper_chest_for(f, level, at, try facing_of(f, pumpkin), base.x, base.y, base.z)
        _ = level.set_block_limited(base.x, base.y, base.z, chest, 2, UPDATE_LIMIT)
    }
}

// The blocks of copper and their copper chests, `COPPER_TO_COPPER_CHEST_MAPPING`, each with how
// weathered it is, the unwaxed first, then the waxed in the same order (CAL-317).
fn copper_chests() -> List<(str, str, i32)> {
    return [
        ("minecraft:copper_block", "minecraft:copper_chest", 0),
        ("minecraft:exposed_copper", "minecraft:exposed_copper_chest", 1),
        ("minecraft:weathered_copper", "minecraft:weathered_copper_chest", 2),
        ("minecraft:oxidized_copper", "minecraft:oxidized_copper_chest", 3),
        ("minecraft:waxed_copper_block", "minecraft:waxed_copper_chest", 0),
        ("minecraft:waxed_exposed_copper", "minecraft:waxed_exposed_copper_chest", 1),
        ("minecraft:waxed_weathered_copper", "minecraft:waxed_weathered_copper_chest", 2),
        ("minecraft:waxed_oxidized_copper", "minecraft:waxed_oxidized_copper_chest", 3),
    ]
}

// Where the block of copper `state` is in `copper_chests`, an unaffected one's where it's none,
// `getOrDefault` and `getWeatherStateFromPattern` (CAL-317).
fn copper_index(f: Facts, state: u32) -> usize {
    let name = f.codec.blocks.name(f.block(state))
    let table = copper_chests()
    for i in 0..table.len() {
        let (block, _, _) = table[i]
        if name == block {
            return i
        }
    }
    return 0
}

// Where the copper chest `state` is in `copper_chests`, none where it's none (CAL-317).
fn chest_index(f: Facts, state: u32) -> usize? {
    let name = f.codec.blocks.name(f.block(state))
    let table = copper_chests()
    for i in 0..table.len() {
        let (_, chest, _) = table[i]
        if name == chest {
            return some(i)
        }
    }
    return none
}

// `CopperChestBlock.getFromCopperBlock` of the copper at `at` in `copper_chests`, turned `facing`,
// at x, y, z (CAL-317): its copper chest facing that way, joined to a single copper chest beside
// it facing the same way, on its left, else on its right, `getChestType`; then, joined to a copper
// chest, the less weathered of the two, both taken unwaxed where one of them is,
// `getLeastOxidizedChestOfConnectedBlocks`.
fn copper_chest_for<L: BlockAccess>(f: Facts, level: L, at: usize, facing: i32, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    let left = clockwise(facing)
    let right = opposite(clockwise(facing))
    var kind = "single"
    if try partner_facing(f, level, x + step_x(left), y, z + step_z(left)) == some(facing) {
        kind = "left"
    } else if try partner_facing(f, level, x + step_x(right), y, z + step_z(right)) == some(facing) {
        kind = "right"
    }
    var pick = at
    if kind != "single" {
        let toward = if kind == "left" { left } else { right }
        let other = try level.state(f, x + step_x(toward), y, z + step_z(toward))
        if let theirs_at = chest_index(f, other) {
            var mine = at
            var theirs = theirs_at
            if (mine >= 4) != (theirs >= 4) {
                mine = mine % 4
                theirs = theirs % 4
            }
            let (_, _, own_weather) = copper_chests()[at]
            let (_, _, their_weather) = copper_chests()[theirs_at]
            pick = if own_weather <= their_weather { mine } else { theirs }
        }
    }
    let (_, chest, _) = copper_chests()[pick]
    let block = match f.codec.blocks.parse(String(chest)) {
        ok(b) => b,
        err(e) => fail Thrown { exception: "IllegalStateException", message: e },
    }
    let faced = try f.with_name(f.default_state(block), String("facing"), direction_name(facing))
    return try f.with_name(faced, String("type"), String(kind))
}

// `ChestBlock.candidatePartnerFacing` for a copper chest, `CopperChestBlock.chestCanConnectTo`:
// the facing of the single copper chest at x, y, z, none where it's no single copper chest.
fn partner_facing<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> i32? ! Thrown {
    let there = try level.state(f, x, y, z)
    if f.in_set(there, f.tag(String("minecraft:copper_chests"))) and f.has(there, String("type")) and f.get_name(there, String("type")) == some(String("single")) {
        return some(try facing_of(f, there))
    }
    return none
}

/// `CarvedPumpkinBlock.canSpawnGolem` at x, y, z (CAL-378): whether the snow golem's, the iron
/// golem's or the copper golem's base is found from there, `getOrCreateSnowGolemBase` and the
/// others, their patterns with any block where the pumpkin goes.
pub fn can_spawn_golem<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let b = Blocks {
        carved: try f.named_block(String("carved_pumpkin")),
        lantern: try f.named_block(String("jack_o_lantern")),
        snow: try f.named_block(String("snow_block")),
        iron: try f.named_block(String("iron_block")),
        base: true,
    }
    for kind in [SNOW_GOLEM_BUILT, IRON_GOLEM_BUILT, COPPER] {
        if try find(f, level, b, kind, x, y, z) != none {
            return true
        }
    }
    return false
}

// The copper golem's pattern, a pumpkin over a block of `#copper`.
const COPPER: i32 = 2
// The wither's base, `getOrCreateWitherBase`: "   ", "###", "~#~", `#` a block of
// `#wither_summon_base_blocks`, `~` air (CAL-378).
const WITHER_BASE: i32 = 3

// The wither's pattern, `getOrCreateWitherFull`: "^^^", "###", "~#~", `^` a wither skeleton's
// skull on the floor or a wall (CAL-401).
const WITHER_FULL: i32 = 4

/// `WitherSkullBlock.checkSpawn` at x, y, z, a wither skeleton's skull there (CAL-401): not below
/// the level's bottom, `min_y`, nor in peaceful, the wither's pattern found from there, its blocks
/// cleared, `clearPatternBlocks`, each heard broken as it was, across then down; the wither made at
/// the bottom of its middle, `getBlock(1, 2, 0)`, its middle across and 0.55 up, turned 0 where the
/// pattern faces along X, else 90, its body too, invulnerable, `makeInvulnerable`, which its level
/// does; then the blocks about each told it's air, `updatePatternBlocks`.
pub fn check_wither_spawn<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32, min_y: i32) ! Thrown {
    if y < min_y or level.difficulty() == 0 {
        return
    }
    let b = Blocks {
        carved: try f.named_block(String("carved_pumpkin")),
        lantern: try f.named_block(String("jack_o_lantern")),
        snow: try f.named_block(String("snow_block")),
        iron: try f.named_block(String("iron_block")),
        skull: try f.named_block(String("wither_skeleton_skull")),
        wall_skull: try f.named_block(String("wither_skeleton_wall_skull")),
    }
    let m = try find(f, level, b, WITHER_FULL, x, y, z) else return
    for i in 0..3 {
        for j in 0..3 {
            let at = m.at(i, j)
            let was = try level.state(f, at.x, at.y, at.z)
            _ = level.set_block_limited(at.x, at.y, at.z, f.ids.air_state, 2, UPDATE_LIMIT)
            level.level_event(BLOCK_BROKEN, at.x, at.y, at.z, i32.wrap(was))
        }
    }
    let foot = m.at(1, 2)
    // West and east, 4 and 5, are along X.
    let yaw = if m.forwards == 4 or m.forwards == 5 { 0.0f32 } else { 90.0f32 }
    level.build_wither(f64(foot.x) + 0.5, f64(foot.y) + 0.55, f64(foot.z) + 0.5, yaw)
    for i in 0..3 {
        for j in 0..3 {
            let at = m.at(i, j)
            level.update_neighbours(at.x, at.y, at.z, f.ids.air)
        }
    }
}

/// `WitherSkullBlock.canSpawnMob` at x, y, z for a wither skeleton skull (CAL-378): at least 2
/// above the level's bottom, `min_y`, not in peaceful, and the wither's base found from there.
pub fn can_spawn_wither<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32, min_y: i32) -> bool ! Thrown {
    if y < min_y + 2 or level.difficulty() == 0 {
        return false
    }
    let b = Blocks {
        carved: try f.named_block(String("carved_pumpkin")),
        lantern: try f.named_block(String("jack_o_lantern")),
        snow: try f.named_block(String("snow_block")),
        iron: try f.named_block(String("iron_block")),
        base: true,
    }
    return try find(f, level, b, WITHER_BASE, x, y, z) != none
}

// Where a pattern matched and how it's turned, a `BlockPatternMatch`.
struct Match {
    x: i32
    y: i32
    z: i32
    forwards: i32
    up: i32
}

impl Match {
    // `getBlock(right, down, 0)`.
    fn at(self, right: i32, down: i32) -> BlockPos {
        return turned(self.x, self.y, self.z, self.forwards, self.up, right, down, 0)
    }
}

// `BlockPattern.find(level, pos)` of the pattern `kind`: the first place, from x, y, z to the
// pattern's largest side less one past it each way, in `betweenClosed`'s order, x first, then y,
// then z, and the first way it's turned, each forwards in `Direction`'s order and each up that
// isn't along it, that the pattern matches.
fn find<L: BlockAccess + BlockLevel>(f: Facts, level: L, b: Blocks, kind: i32, x: i32, y: i32, z: i32) -> Match? ! Thrown {
    let reach = if kind == COPPER { 2 } else { 3 }
    for dz in 0..reach {
        for dy in 0..reach {
            for dx in 0..reach {
                for forwards in 0..6 {
                    for up in 0..6 {
                        if up == forwards or up == opposite(forwards) {
                            continue
                        }
                        let m = Match { x: x + dx, y: y + dy, z: z + dz, forwards: forwards, up: up }
                        if try matches(f, level, b, kind, m) {
                            return some(m)
                        }
                    }
                }
            }
        }
    }
    return none
}

// `BlockPattern.matches(origin, forwards, up)`: whether each of the pattern's blocks is where
// `translateAndRotate` puts it. A block in a chunk that isn't there matches nothing, as
// `BlockInWorld` reads none there.
fn matches<L: BlockAccess + BlockLevel>(f: Facts, level: L, b: Blocks, kind: i32, m: Match) -> bool ! Thrown {
    let width = if kind == IRON_GOLEM_BUILT or kind == WITHER_BASE or kind == WITHER_FULL { 3 } else { 1 }
    let height = if kind == COPPER { 2 } else { 3 }
    for right in 0..width {
        for down in 0..height {
            if b.base and down == 0 and (right == 1 or kind != IRON_GOLEM_BUILT) {
                continue
            }
            let at = m.at(right, down)
            if not level.is_loaded(at.x, at.y, at.z) {
                return false
            }
            let state = try level.state(f, at.x, at.y, at.z)
            if not holds(f, b, kind, right, down, state) {
                return false
            }
        }
    }
    return true
}

// Whether `state` is what the pattern `kind` has at `right`, `down`: the snow golem's
// "^", "#", "#", the iron golem's "~^~", "###", "~#~" and the copper golem's "^", "#"; `^` a
// pumpkin, `PUMPKINS_PREDICATE`, `#` the pattern's block, `~` air.
fn holds(f: Facts, b: Blocks, kind: i32, right: i32, down: i32, state: u32) -> bool {
    let block = f.block(state)
    if kind == WITHER_FULL {
        if down == 0 {
            return block == b.skull or block == b.wall_skull
        }
        if down == 1 or right == 1 {
            return f.in_set(state, f.tag(String("minecraft:wither_summon_base_blocks")))
        }
        return f.is_air(state)
    }
    if kind == WITHER_BASE {
        if down == 1 or right == 1 {
            return f.in_set(state, f.tag(String("minecraft:wither_summon_base_blocks")))
        }
        return f.is_air(state)
    }
    if kind == IRON_GOLEM_BUILT {
        if down == 0 and right == 1 {
            return block == b.carved or block == b.lantern
        }
        if down == 1 or right == 1 {
            return block == b.iron
        }
        return f.is_air(state)
    }
    if down == 0 {
        return block == b.carved or block == b.lantern
    }
    if kind == COPPER {
        return f.in_set(state, f.tag(String("minecraft:copper")))
    }
    return block == b.snow
}

// `spawnGolemInWorld`: the pattern's blocks, `width` across and `height` down, cleared,
// `clearPatternBlocks`, each set to air with flags 2 and heard broken as it was, across then
// down; the golem `kind` made at `getBlock(right, down, 0)`, its middle across and 0.05 up,
// `snapTo` at no turn, `addFreshEntity`, the players by it told they summoned it, which its level
// does; then the blocks about each told it's air, `updatePatternBlocks`.
fn spawn_in_world<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, m: Match, kind: i32, width: i32, height: i32, right: i32, down: i32) ! Thrown {
    for i in 0..width {
        for j in 0..height {
            let at = m.at(i, j)
            let was = try level.state(f, at.x, at.y, at.z)
            _ = level.set_block_limited(at.x, at.y, at.z, f.ids.air_state, 2, UPDATE_LIMIT)
            level.level_event(BLOCK_BROKEN, at.x, at.y, at.z, i32.wrap(was))
        }
    }
    let foot = m.at(right, down)
    level.build_golem(kind, f64(foot.x) + 0.5, f64(foot.y) + 0.05, f64(foot.z) + 0.5)
    for i in 0..width {
        for j in 0..height {
            let at = m.at(i, j)
            level.update_neighbours(at.x, at.y, at.z, f.ids.air)
        }
    }
}
