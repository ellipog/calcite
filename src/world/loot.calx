/// Vanilla's loot (CAL-153): a loot table rolled as `LootTable.getRandomItems` rolls it, with the
/// parameters `LootParams` gives it, each draw from the random it's given, in vanilla's order.
/// The tables, predicates, item modifiers and number providers are the reloadable registries'
/// entries, as `registry.loot_tables`' codecs read them, each read again from its NBT as it's
/// used, so nothing's made of them as the server starts.
///
/// What block tables use is here: the entries `item`, `empty`, `loot_table`, `dynamic`, `tag`,
/// `alternatives`, `sequence` and `group`; the conditions `survives_explosion`, `match_block`,
/// `match_tool`, `table_bonus`, `random_chance`, `location_check` of a block, `entity_properties`
/// asking only that there's an entity, `inverted`, `any_of` and `all_of`, and named predicates;
/// the modifiers `set_count`, `explosion_decay`, `apply_bonus`, `limit_count`, `copy_state`,
/// `copy_components` from a block entity or the tool, and `sequence`, and named ones; and the
/// numbers `constant`, `uniform` and `binomial`, and named ones. Whatever else a table uses is
/// said to be missing, and the roll goes on as if it weren't there. A weapon's enchantments'
/// effects against a mob are tested and worked out here too, with the same predicates (D438).
/// The modifiers `enchant_with_levels` and `enchant_randomly` enchant as `world.enchanting` does
/// (D522); `set_random_dyes`, `set_potion`, `set_random_potion` and `set_stew_effect` dye, brew
/// and season as vanilla's do, and the int providers `add`, `sub`, `mul`, `min`, `max`, `negate`
/// and `abs` are worked out, any of them overflowing making the whole 0 (D523). An enchantment's
/// location-changed effects are listed and tested here, `location_entries` and `location_holds`,
/// and the blocks frost walker's disk sets found, `disk_blocks`, with the entity predicates
/// `movement`, `movement_affected_by` and `periodic_tick` and the flags on the ground and flying
/// (D524).
module world.loot

import nbt.tag.{Accounter, Tag, read_any}
import random.source.{RandomSource}
import registry.components.{ItemCodecs}
import std.java.math.{pow}
import registry.registries.{Registries}
import resources.identifier.{Identifier}
import world.attributes.{group_has, slot_names}
import world.block_level.{BlockLevel}
import world.collision.{Aabb}
import world.crafting.{dye_name, mixed_dyes}
import world.damage.{damage_tag_names}
import world.digging.{value_effect}
import world.effects.{effect_facts, effect_id}
import world.enchanting.{Enchanting, enchanting_of, upgrade}
import world.recipes.{Smelting, smelting_of}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}

// The registries loot reads, by their places in `Loot.places`.
const TABLES: usize = 0
const PREDICATES: usize = 1
const MODIFIERS: usize = 2
const INTS: usize = 3
const FLOATS: usize = 4
const TRADES: usize = 5
const TRADE_SETS: usize = 6
const SLOT_SOURCES: usize = 7

/// The world's loot tables, predicates, item modifiers and number providers, by name, with the
/// item codecs its stacks are made with, and the smelting recipes `furnace_smelt` cooks by
/// (D436), and the enchantments as enchanting sees them (D522). Nothing changes it, so the levels
/// share one.
pub struct Loot {
    registries: Shared<Registries>
    pub items: ItemCodecs
    pub enchanting: Enchanting
    smelting: List<Smelting>
    // Each registry's place among the reloadable ones, and its entries' places by name.
    places: List<usize?>
    names: List<JavaHashMap<String, usize>>
}

impl Loot {
    /// The loot of `registries`' reloadable registries.
    pub fn new(registries: own Shared<Registries>) -> Loot {
        let kinds: List<str> = ["loot_table", "predicate", "item_modifier", "context_int_provider", "context_float_provider", "villager_trade", "trade_set", "slot_source"]
        var places = List<usize?>()
        var names = List<JavaHashMap<String, usize>>()
        for k in kinds {
            let at = registries.value.find_reloadable(String(k))
            var by = JavaHashMap<String, usize>()
            if let a = at {
                for i in 0..registries.value.reloadable[a].entries.len() {
                    by.insert(registries.value.reloadable[a].entries[i].to_string(), i)
                }
            }
            places.push(at)
            names.push(by)
        }
        let items = ItemCodecs.new(registries.copy())
        let smelting = smelting_of(registries.value)
        let enchanting = enchanting_of(registries.value)
        return Loot { registries: registries, items: items, enchanting: enchanting, smelting: smelting, places: places, names: names }
    }

    /// The loot table `name`, a whole ID, as its codec wrote it.
    pub fn table(self, name: String) -> Tag? {
        return self.entry(TABLES, name)
    }

    /// The slot source `name`, a whole ID, as its codec wrote it (D571).
    pub fn slot_source(self, name: String) -> Tag? {
        return self.entry(SLOT_SOURCES, name)
    }

    // The entry `name` of the registry `kind`, read from its NBT.
    fn entry(self, kind: usize, name: String) -> Tag? {
        let at = self.places[kind] else return none
        if not self.names[kind].contains(name.copy()) {
            return none
        }
        let i = self.names[kind][name]
        if i >= self.registries.value.reloadable[at].contents.len() {
            return none
        }
        var pos: usize = 0
        var accounter = Accounter.unlimited()
        return match read_any(self.registries.value.reloadable[at].contents[i], mut pos, mut accounter) {
            ok(t) => some(t),
            err(_) => none,
        }
    }

    // Whether the enchantment `name` is in `set`, a `HolderSet` of the `enchantment` registry as
    // its codec writes it: an ID, a list of them, or a tag, `#` and its name.
    fn enchantment_in(self, set: Tag, name: String) -> bool {
        match set {
            Tag.Str(s) => {
                if not s.starts_with("#") {
                    return s == name
                }
                let place = self.registries.value.find(String("minecraft:enchantment")) else return false
                let tag = match Identifier.parse(s[1..].copy()) {
                    ok(t) => t,
                    err(_) => return false,
                }
                let key = match Identifier.parse(name) {
                    ok(k) => k,
                    err(_) => return false,
                }
                let n = self.registries.value.synced[place].id(key) else return false
                for v in self.registries.value.synced[place].tag_ids(tag) {
                    if v == n {
                        return true
                    }
                }
                return false
            },
            Tag.List(entries) => {
                for each in entries {
                    if self.enchantment_in(each, name.copy()) {
                        return true
                    }
                }
                return false
            },
            _ => return false,
        }
    }
}

/// What a table is rolled with, `LootParams`, each parameter `none` where it isn't given.
pub struct LootParams {
    /// `ORIGIN`.
    pub origin: (f64, f64, f64)? = none
    /// Whether `TOOL` is given, and the stack, `none` for `ItemStack.EMPTY`, as `ItemStack.CODEC`
    /// writes it.
    pub has_tool: bool = false
    pub tool: Tag? = none
    /// Whether there's a `THIS_ENTITY`, as what breaks a block or a mob that dies, and what entity
    /// predicates read of it where they may, `none` where they mayn't yet (D416).
    pub this_entity: bool = false
    pub this: LootEntity? = none
    /// `DAMAGE_SOURCE`, a mob's death's, whether it's given; its `ATTACKING_ENTITY` and
    /// `DIRECT_ATTACKING_ENTITY`, the entity that killed a mob and the one that dealt the blow,
    /// `getEntity` and `getDirectEntity`, which for an attack are the same; and whether there's a
    /// `LAST_DAMAGE_PLAYER`, a player who hurt it lately (D416).
    pub damage_source: bool = false
    pub attacker: LootEntity? = none
    pub direct_attacker: LootEntity? = none
    pub killed_by_player: bool = false
    /// Whether the damage is direct, `DamageSource.isDirect`: what caused it dealt it, as an
    /// attack's does (D438).
    pub direct: bool = true
    /// The bits of the tags of the damage's type, as world.damage keeps them, where they're given
    /// (D439).
    pub damage_tags: u32? = none
    /// `BLOCK_STATE`.
    pub state: u32? = none
    /// `BLOCK_ENTITY`'s components, as `collectComponents` gives them, by their whole IDs.
    pub block_entity: JavaHashMap<String, Tag>? = none
    /// `EXPLOSION_RADIUS`.
    pub explosion_radius: f32? = none
    pub luck: f32 = 0.0f32
    /// The dynamic drops, `withDynamicDrop`: each one's name and its stacks, `none` for an empty
    /// one.
    pub dynamic: List<(String, List<Tag?>)> = List<(String, List<Tag?>)>()
    /// `ADDITIONAL_COST_COMPONENT_ALLOWED`, which a trade's loot is given, so enchanting adds the
    /// cost the item adds to a trade (D522).
    pub additional_cost: bool = false
    /// `ENCHANTMENT_ACTIVE`, a location-changed effect's context's: whether the effect held as the
    /// entity's block last changed (D524).
    pub enchantment_active: bool? = none
}

/// What a loot table's entity predicates read of an entity, `EntityPredicate` (D416): its type,
/// as `minecraft:cow`; whether it's on fire and a baby; what's in its main hand, as
/// `ItemStack.CODEC` writes it, `none` for nothing; a sheep's wool's colour's name and whether it's
/// shorn; a cube mob's size, `-1` for what isn't one; and a villager's type, its
/// `minecraft:villager/variant`, as `minecraft:plains` (CAL-160). Nothing rides anything yet, so
/// none has a vehicle.
pub struct LootEntity {
    pub kind: String
    pub on_fire: bool = false
    pub baby: bool = false
    pub hand: Tag? = none
    pub sheep_color: String? = none
    pub sheared: bool = false
    pub cube_size: i32 = -1
    pub villager_type: String? = none
    /// Its flags `onGround` and flying, a player's by their abilities, or either's gliding,
    /// `isFallFlying`; its known movement a tick, `getKnownMovement`, and how far it's fallen,
    /// `fallDistance`; the block below it that its movement's affected by,
    /// `getBlockPosBelowThatAffectsMyMovement`, where it's known; and its ticks, `tickCount`
    /// (D524).
    pub on_ground: bool = false
    pub flying: bool = false
    pub moved_x: f64 = 0.0
    pub moved_y: f64 = 0.0
    pub moved_z: f64 = 0.0
    pub fall_distance: f64 = 0.0
    pub affected_by: (i32, i32, i32)? = none
    pub tick_count: i32 = 0
    /// Where it is, `getX`, `getY` and `getZ`, where that's known; and what it wears and holds,
    /// by `EquipmentSlot`'s order, `getItemBySlot`, where that's known, else only its main hand
    /// is (CAL-164).
    pub at: (f64, f64, f64)? = none
    pub worn: List<Tag?> = List<Tag?>()
}

// A stack as loot makes it, `ItemStack`: its item, its count, which a modifier can take to 0 and
// back again, and its components as a patch of its item's, as `ItemStack.CODEC` writes them.
struct Stack {
    id: String
    count: i32
    patch: JavaHashMap<String, Tag>
}

impl Stack {
    fn of(id: String) -> Stack {
        return Stack { id: id.copy(), count: 1, patch: JavaHashMap<String, Tag>() }
    }

    // `ItemStack.CODEC`'s form of a stack, or none for `ItemStack.EMPTY`.
    fn from(t: Tag?) -> Stack? {
        let given = t else return none
        let Tag.Compound(m) = given else return none
        if not m.contains("id") {
            return none
        }
        let id = match m["id"] {
            Tag.Str(s) => s.copy(),
            _ => return none,
        }
        var count = 1
        if m.contains("count") {
            count = m["count"].number_int() ?? 1
        }
        var patch = JavaHashMap<String, Tag>()
        if m.contains("components") {
            if let Tag.Compound(c) = m["components"] {
                patch = c.copy()
            }
        }
        return some(Stack { id: id, count: count, patch: patch })
    }

    // `isEmpty`.
    fn empty(self) -> bool {
        return self.count <= 0 or self.id == "minecraft:air"
    }

    // The stack as `ItemStack.CODEC` writes it, none where it's empty.
    fn tag(self) -> Tag? {
        if self.empty() {
            return none
        }
        var m = JavaHashMap<String, Tag>()
        m.insert(String("id"), Tag.Str(self.id.copy()))
        m.insert(String("count"), Tag.Int(self.count))
        if not self.patch.is_empty() {
            m.insert(String("components"), Tag.Compound(self.patch.copy()))
        }
        return some(Tag.Compound(m))
    }

    // Its component `name`, a whole ID: its patch's, none where its patch takes it away, or
    // else its item's.
    fn component(self, items: ItemCodecs, name: String) -> Tag? {
        if self.patch.contains(name.copy()) {
            return some(self.patch[name].copy())
        }
        if self.patch.contains("!{name}") {
            return none
        }
        return items.default_component(self.id.copy(), name)
    }

    // `set(name, value)`: in its patch unless it's its item's own, as `PatchedDataComponentMap`
    // keeps it.
    fn set(mut self, items: ItemCodecs, name: String, value: own Tag) {
        _ = self.patch.remove("!{name}")
        if items.default_component(self.id.copy(), name.copy()) == some(value.copy()) {
            _ = self.patch.remove(name)
            return
        }
        self.patch.insert(name.copy(), value)
    }
}

// Where a roll is: what it met that Calcite hasn't, and the tables and modifiers it's going
// through by name, as `LootContext.visitedElements` keeps them, so one that names itself stops;
// and the level of the enchantment whose effect it tests, `ENCHANTMENT_LEVEL`, where there's one
// (D442); and how many times it met what Calcite hasn't, each time counted (CAL-160).
struct Roll {
    missing: List<String>
    visited: List<String>
    enchanted_at: i32? = none
    misses: i32 = 0
}

impl Roll {
    fn miss(mut self, what: String) {
        self.misses += 1
        for m in self.missing {
            if m == what {
                return
            }
        }
        self.missing.push(what.copy())
    }
}

/// `LootTable.getRandomItems(params)`: the stacks the table `name`, a whole ID, gives, rolled with
/// `random`, each split as `createStackSplitter` splits a stack bigger than it can be, with
/// those a modifier left empty as `none`, which `popResource` draws for all the same. What it
/// met that Calcite hasn't yet goes in `missing`, once each. A table that isn't there gives
/// nothing, as `getLootTable` gives `LootTable.EMPTY`.
pub fn roll_table<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, name: String, missing: mut List<String>) -> List<Tag?> {
    var out = List<Tag?>()
    let table = loot.table(name.copy()) else return out
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    var made = List<Stack>()
    table_items(loot, f, level, mut random, params, mut r, table, some(name.copy()), [], mut made)
    for s in made {
        let most = loot.items.max_stack_size(s.tag() ?? Tag.End).max(1)
        if s.count < most {
            out.push(s.tag())
            continue
        }
        var count = s.count
        while count > 0 {
            var copy = Stack { id: s.id.copy(), count: count.min(most), patch: s.patch.copy() }
            count -= copy.count
            out.push(copy.tag())
            copy.count = 0
        }
    }
    missing.clear()
    for m in r.missing {
        missing.push(m.copy())
    }
    return out
}

/// What the enchantments on the weapon `stack` make of `amount`, `EnchantmentHelper.modifyDamage`
/// and `modifyKnockback` (D438): each of their value effects of the component `name`,
/// `minecraft:damage` or `minecraft:knockback`, whose requirements hold of `params`, a damage's
/// context as `Enchantment.damageContext` makes it, tested with the level's random `random`, in
/// the enchantments' order, as `modifyDamageFilteredValue` goes, drawing where it draws from the
/// victim's random `drawn`: sharpness's damage, smite's and bane of arthropods' where the victim's
/// type is in their tags, and knockback's. What they ask that loot can't tell is said to be
/// missing.
pub fn enchanted_amount<R: RandomSource, V: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, drawn: mut V, stack: Tag, name: str, params: LootParams, amount: f32, missing: mut List<String>) -> f32 {
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    let value = stack_amount(loot, f, level, mut random, mut drawn, stack, none, name, params, amount, mut r)
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return value
}

/// The value effects of the component `name` of the enchantments on the weapon `stack` whose
/// requirements hold of the damage's context `params`, tested with `random`, each with its
/// enchantment's level, in the enchantments' order (D443): breach's
/// `minecraft:armor_effectiveness`, which `EnchantmentHelper.modifyArmorEffectiveness` works out
/// on the armor's share of a hurt once `CombatRules.getDamageAfterAbsorb` has it, so they're kept
/// to work out there. What they ask that loot can't tell is said to be missing.
pub fn weapon_effects<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, stack: Tag, name: str, params: LootParams, missing: mut List<String>) -> List<(Tag, i32)> {
    var out = List<(Tag, i32)>()
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    for (lv, definition) in loot.items.enchantments(stack) {
        for m in effects_of(definition, name) {
            if m.contains("requirements") {
                if not test(loot, f, level, mut random, params, mut r, m["requirements"].copy()) {
                    continue
                }
            }
            if m.contains("effect") {
                out.push((m["effect"].copy(), lv))
            }
        }
    }
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return out
}

/// What the enchantments on `worn`, a living entity's equipment by slot in `slot_names`' order,
/// make of `amount` with their value effects of the component `name`, each enchantment for its
/// slot, `runIterationOnEquipment` (D439): `minecraft:damage_protection`'s, protection's and the
/// like's, `EnchantmentHelper.getDamageProtection`, each as `enchanted_amount` makes it.
pub fn worn_amount<R: RandomSource, V: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, drawn: mut V, worn: List<Tag?>, name: str, params: LootParams, amount: f32, missing: mut List<String>) -> f32 {
    var value = amount
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    for slot in 0..worn.len() {
        let stack = worn[slot].copy() else continue
        value = stack_amount(loot, f, level, mut random, mut drawn, stack, some(slot), name, params, value, mut r)
    }
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return value
}

/// Whether one of the enchantments on `worn`, each for its slot, has a `minecraft:damage_immunity`
/// effect whose requirements hold of the damage's context `params`, tested with `random`,
/// `EnchantmentHelper.isImmuneToDamage` (D439): frost walker's, against what burns from stepping.
/// Once one has, none after it is tested.
pub fn worn_immune<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, worn: List<Tag?>, params: LootParams, missing: mut List<String>) -> bool {
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    var immune = false
    for slot in 0..worn.len() {
        let stack = worn[slot].copy() else continue
        for (_, definition) in loot.items.enchantments(stack) {
            if immune or not in_slot(definition, slot) {
                continue
            }
            for m in effects_of(definition, "minecraft:damage_immunity") {
                if immune {
                    continue
                }
                if not m.contains("requirements") {
                    immune = true
                } else if test(loot, f, level, mut random, params, mut r, m["requirements"].copy()) {
                    immune = true
                }
            }
        }
    }
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return immune
}

// `amount` as the enchantments on `stack`, those for the slot `slot` where it's given, change it
// with their value effects of the component `name` whose requirements hold of `params`, tested
// with `random`, drawing where they draw from `drawn` (D438, D439).
fn stack_amount<R: RandomSource, V: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, drawn: mut V, stack: Tag, slot: usize?, name: str, params: LootParams, amount: f32, r: mut Roll) -> f32 {
    var value = amount
    for (lv, definition) in loot.items.enchantments(stack) {
        if let s = slot {
            if not in_slot(definition, s) {
                continue
            }
        }
        for m in effects_of(definition, name) {
            if m.contains("requirements") {
                if not test(loot, f, level, mut random, params, mut r, m["requirements"].copy()) {
                    continue
                }
            }
            if m.contains("effect") {
                value = value_effect(m["effect"].copy(), lv, value, mut drawn)
            }
        }
    }
    return value
}

/// A random that gives nothing and keeps whether it was drawn from (D439), for what vanilla's own
/// data never draws for, as armor's protection and immunity against a damage, where the randoms
/// it would draw from aren't to hand, so that a pack's that does is told of.
pub struct Drawless {
    pub drawn: bool = false
}

impl RandomSource for Drawless {
    fn set_seed(mut self, seed: i64) {
        _ = seed
        self.drawn = true
    }

    fn next_int(mut self) -> i32 {
        self.drawn = true
        return 0
    }

    fn next_int_below(mut self, bound: i32) -> i32 {
        _ = bound
        self.drawn = true
        return 0
    }

    fn next_long(mut self) -> i64 {
        self.drawn = true
        return 0i64
    }

    fn next_boolean(mut self) -> bool {
        self.drawn = true
        return false
    }

    fn next_float(mut self) -> f32 {
        self.drawn = true
        return 0.0f32
    }

    fn next_double(mut self) -> f64 {
        self.drawn = true
        return 0.0
    }

    fn next_gaussian(mut self) -> f64 {
        self.drawn = true
        return 0.0
    }
}

// The bit world.damage keeps the damage type tag `id`, a whole ID, as, none for one it doesn't
// keep (D439).
fn damage_tag_bit(id: String) -> u32? {
    let names = damage_tag_names()
    for i in 0..names.len() {
        if id == "minecraft:{names[i]}" {
            return some(1u32 << u32.wrap(i))
        }
    }
    return none
}

/// What an enchantment's post-attack effect does, `EnchantmentEntityEffect.apply` (D438):
/// `ignite`, on fire for its seconds, `igniteForSeconds`; `apply_mob_effect`, one of its `to_apply`
/// effects, by their IDs, drawn (D512), for between its durations, in seconds, at between its
/// amplifiers; `damage_entity`, hurt by its damage type, by its ID, between its least and most
/// damage, the enchanted item's owner causing it; `change_item_damage`, the enchanted item worn by
/// its amount (D442); or another kind, by its ID. An `all_of`'s effects are each found in turn.
pub enum Attacked {
    Ignite(f32)
    Effect(List<i32>, f32, f32, f32, f32)
    Damage(String, f32, f32)
    ItemDamage(f32)
    Other(String)
}

/// A post-attack effect `post_attack_effects` finds: whom it's done to, its `affected`,
/// `attacker`, `damaging_entity` or `victim`, and what (D438).
pub struct PostAttack {
    pub affected: String
    pub what: Attacked
}

/// The post-attack effects of the enchantments on `stack`, worn in the slot `slot`,
/// `EnchantmentHelper.runIterationOnItem` (D438): of each enchantment for that slot,
/// `matchingSlot`, in the enchantments' order, each `minecraft:post_attack` effect for
/// `enchanted`, `attacker` for the weapon or `victim` for what the victim wears,
/// `Enchantment.doPostAttack`, whose requirements hold of the damage's context `params`, tested
/// with the level's random `random` before any is done, as vanilla's own don't tell apart: fire
/// aspect's and bane of arthropods'. What they ask that loot can't tell is said to be missing.
pub fn post_attack_effects<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, stack: Tag, slot: usize, enchanted: str, params: LootParams, missing: mut List<String>) -> List<PostAttack> {
    var out = List<PostAttack>()
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    for (lv, definition) in loot.items.enchantments(stack) {
        if not in_slot(definition, slot) {
            continue
        }
        for m in effects_of(definition, "minecraft:post_attack") {
            if text_of(m, "enchanted") != String(enchanted) or not m.contains("effect") {
                continue
            }
            if m.contains("requirements") {
                r.enchanted_at = some(lv)
                let met = test(loot, f, level, mut random, params, mut r, m["requirements"].copy())
                r.enchanted_at = none
                if not met {
                    continue
                }
            }
            let Tag.Compound(effect) = m["effect"] else continue
            for what in attacked_by(loot, mut r, effect.copy(), lv) {
                out.push(PostAttack { affected: text_of(m, "affected"), what: what.copy() })
            }
        }
    }
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return out
}

/// The effects of the enchantments on `stack` as a projectile shot from it or made of it comes
/// into its level, `EnchantmentHelper.onProjectileSpawned` (CAL-159): of each enchantment,
/// whatever its slots, in the enchantments' order, each `minecraft:projectile_spawned` effect whose
/// requirements hold of `params`, the projectile's context, `Enchantment.entityContext`, tested
/// with the level's random `random` before any is done, as vanilla's own have none: flame's
/// `ignite`. What they ask that loot can't tell is said to be missing.
pub fn spawned_effects<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, stack: Tag, params: LootParams, missing: mut List<String>) -> List<Attacked> {
    var out = List<Attacked>()
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    for (lv, definition) in loot.items.enchantments(stack) {
        for m in effects_of(definition, "minecraft:projectile_spawned") {
            if not m.contains("effect") {
                continue
            }
            if m.contains("requirements") {
                r.enchanted_at = some(lv)
                let met = test(loot, f, level, mut random, params, mut r, m["requirements"].copy())
                r.enchanted_at = none
                if not met {
                    continue
                }
            }
            let Tag.Compound(effect) = m["effect"] else continue
            for what in attacked_by(loot, mut r, effect.copy(), lv) {
                out.push(what.copy())
            }
        }
    }
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return out
}

// What the entity effect `effect` of an enchantment at the level `lv` does, as
// `post_attack_effects` finds it (D438): an `all_of`'s effects, each in turn (D442), else the one.
fn attacked_by(loot: Loot, r: mut Roll, effect: JavaHashMap<String, Tag>, lv: i32) -> List<Attacked> {
    var out = List<Attacked>()
    let kind = text_of(effect, "type")
    if kind == "minecraft:all_of" {
        if effect.contains("effects") {
            if let Tag.List(list) = effect["effects"] {
                for each in list {
                    if let Tag.Compound(e) = each {
                        for a in attacked_by(loot, mut r, e.copy(), lv) {
                            out.push(a.copy())
                        }
                    }
                }
            }
        }
        return out
    }
    if kind == "minecraft:ignite" {
        out.push(Attacked.Ignite(if effect.contains("duration") { level_based(mut r, effect["duration"].copy(), lv) } else { 0.0f32 }))
    } else if kind == "minecraft:apply_mob_effect" {
        let n = if effect.contains("to_apply") { effect_choices(loot, effect["to_apply"].copy()) } else { List<i32>() }
        let low = if effect.contains("min_duration") { level_based(mut r, effect["min_duration"].copy(), lv) } else { 0.0f32 }
        let high = if effect.contains("max_duration") { level_based(mut r, effect["max_duration"].copy(), lv) } else { 0.0f32 }
        let weak = if effect.contains("min_amplifier") { level_based(mut r, effect["min_amplifier"].copy(), lv) } else { 0.0f32 }
        let strong = if effect.contains("max_amplifier") { level_based(mut r, effect["max_amplifier"].copy(), lv) } else { 0.0f32 }
        out.push(Attacked.Effect(n, low, high, weak, strong))
    } else if kind == "minecraft:damage_entity" {
        let low = if effect.contains("min_damage") { level_based(mut r, effect["min_damage"].copy(), lv) } else { 0.0f32 }
        let high = if effect.contains("max_damage") { level_based(mut r, effect["max_damage"].copy(), lv) } else { 0.0f32 }
        out.push(Attacked.Damage(text_of(effect, "damage_type"), low, high))
    } else if kind == "minecraft:change_item_damage" {
        out.push(Attacked.ItemDamage(if effect.contains("amount") { level_based(mut r, effect["amount"].copy(), lv) } else { 0.0f32 }))
    } else {
        out.push(Attacked.Other(kind.copy()))
    }
    return out
}

// The mob effects, by their IDs, `set`, a `HolderSet` of them as its codec writes it, holds, in
// its order: an ID's, a list's, or the tag's, `#` and its name (D512). One that isn't an effect
// is left out, as its codec wouldn't read it.
fn effect_choices(loot: Loot, set: Tag) -> List<i32> {
    var out = List<i32>()
    match set {
        Tag.Str(s) => {
            if not s.starts_with("#") {
                if let id = effect_id(s.copy()) {
                    out.push(id)
                }
                return out
            }
            let at = loot.registries.value.find_builtin(String("mob_effect")) else return out
            let tag = match Identifier.parse(s[1..].copy()) {
                ok(t) => t,
                err(_) => return out,
            }
            return loot.registries.value.builtin[at].tag_ids(tag)
        },
        Tag.List(l) => {
            for each in l {
                if let Tag.Str(s) = each {
                    if let id = effect_id(s.copy()) {
                        out.push(id)
                    }
                }
            }
            return out
        },
        _ => return out,
    }
}

// The conditional effects of the component `name` in the enchantment `definition`'s `effects`,
// each a compound, none where it has none (D438).
fn effects_of(definition: JavaHashMap<String, Tag>, name: str) -> List<JavaHashMap<String, Tag>> {
    var out = List<JavaHashMap<String, Tag>>()
    if not definition.contains("effects") {
        return out
    }
    let Tag.Compound(effects) = definition["effects"] else return out
    if not effects.contains(name) {
        return out
    }
    let Tag.List(list) = effects[name] else return out
    for each in list {
        if let Tag.Compound(m) = each {
            out.push(m.copy())
        }
    }
    return out
}

// Whether the enchantment `definition` is for the equipment slot `slot`, a place in
// `slot_names`, `Enchantment.matchingSlot`: one of its `slots` groups has it (D438).
fn in_slot(definition: JavaHashMap<String, Tag>, slot: usize) -> bool {
    if not definition.contains("slots") {
        return false
    }
    match definition["slots"] {
        Tag.List(groups) => {
            for g in groups {
                if let Tag.Str(s) = g {
                    if group_has(s.copy(), slot) {
                        return true
                    }
                }
            }
            return false
        },
        Tag.Str(s) => return group_has(s.copy(), slot),
        _ => return false,
    }
}

/// What a location-based effect of an enchantment does, `EnchantmentLocationBasedEffect` (D524):
/// `attribute`'s modifier, its ID for the slot, `idForSlot`, its attribute, amount at the level
/// and operation, put on as the effect starts to hold and taken off as it stops; and those it does
/// each time it holds, as `EnchantmentEntityEffect`s do, `replace_disk`'s, as its codec writes it,
/// and `change_item_damage`'s amount; and, as a tick's effects do too, `spawn_particles`' and
/// `play_sound`'s, as their codecs write them (D525); anything else by its type, which Calcite
/// hasn't.
pub enum Located {
    Attribute(String, String, f64, String)
    Disk(JavaHashMap<String, Tag>)
    ItemDamage(i32)
    Particles(JavaHashMap<String, Tag>)
    Sound(JavaHashMap<String, Tag>)
    Other(String)
}

/// One of the `location_changed` effects of an enchantment on a stack in its slot (D524): the
/// enchantment's name, the effect's place among them, the enchantment's level, its requirements,
/// where it has any, and what it does, an `all_of`'s each in turn.
pub struct LocatedEntry {
    pub enchantment: String
    pub index: usize
    pub lv: i32
    pub requirements: Tag?
    pub what: List<Located>
}

/// The `location_changed` effects of the enchantments on `stack` worn in the slot `slot`, a place
/// in `slot_names` (D524): of each enchantment for that slot, `matchingSlot`, in the enchantments'
/// order, as `runIterationOnItem` visits them, each in turn.
pub fn location_entries(loot: Loot, stack: Tag, slot: usize) -> List<LocatedEntry> {
    return slot_entries(loot, stack, slot, "minecraft:location_changed")
}

/// The `tick` effects of the enchantments on `stack` worn in the slot `slot`, as
/// `location_entries` has a location's (D525), which `Enchantment.tick` runs each tick.
pub fn tick_entries(loot: Loot, stack: Tag, slot: usize) -> List<LocatedEntry> {
    return slot_entries(loot, stack, slot, "minecraft:tick")
}

/// `EnchantmentHelper.processEquipmentDropChance` of a mob's drop chance `chance` (D526), as
/// `Mob.dropCustomDeathLoot` calls it with what killed it, a living thing, as both its victim and
/// its attacker: of what the killer wears and holds, `worn` by slot, each `equipment_drops`
/// effect of each enchantment for the slot enchanted on the victim, then each enchanted on the
/// attacker, as looting's is, tested in the damage's context `params`, the killer as `this`, with
/// the level's random, its value effect drawing from the killer's own random `theirs`. What they
/// ask that loot can't tell is said to be missing.
pub fn equipment_drop_chance<R: RandomSource, E: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, theirs: mut E, worn: List<Tag?>, params: LootParams, chance: f32, missing: mut List<String>) -> f32 {
    var out = chance
    let targets: List<str> = ["victim", "attacker"]
    for target in targets {
        for slot in 0..worn.len() {
            let stack = worn[slot].copy() else continue
            for (_, lv, definition) in loot.items.named_enchantments(stack) {
                if not in_slot(definition, slot) {
                    continue
                }
                for m in effects_of(definition, "minecraft:equipment_drops") {
                    if text_of(m, "enchanted") != String(target) or not m.contains("effect") {
                        continue
                    }
                    var holds = true
                    if m.contains("requirements") {
                        var r = Roll { missing: missing.copy(), visited: List<String>() }
                        r.enchanted_at = some(lv)
                        holds = test(loot, f, level, mut random, params, mut r, m["requirements"].copy())
                        missing.clear()
                        for each in r.missing {
                            missing.push(each.copy())
                        }
                    }
                    if holds {
                        out = value_effect(m["effect"].copy(), lv, out, mut theirs)
                    }
                }
            }
        }
    }
    return out
}

// The effects of the component `component` of the enchantments on `stack` for the slot `slot`,
// each enchantment's in turn (D524, D525).
fn slot_entries(loot: Loot, stack: Tag, slot: usize, component: str) -> List<LocatedEntry> {
    var out = List<LocatedEntry>()
    let names = slot_names()
    for (name, lv, definition) in loot.items.named_enchantments(stack) {
        if not in_slot(definition, slot) {
            continue
        }
        var i: usize = 0
        for m in effects_of(definition, component) {
            var roll = Roll { missing: List<String>(), visited: List<String>() }
            var what = List<Located>()
            if m.contains("effect") {
                if let Tag.Compound(effect) = m["effect"] {
                    located(mut roll, effect.copy(), lv, names[slot].copy(), mut what)
                }
            }
            let requirements: Tag? = if m.contains("requirements") { some(m["requirements"].copy()) } else { none }
            out.push(LocatedEntry { enchantment: name.copy(), index: i, lv: lv, requirements: requirements, what: what })
            i += 1
        }
    }
    return out
}

/// Whether the location-changed effect `entry` holds in the context `params`,
/// `Enchantment.locationContext`: the entity and where it is, the enchantment's level, and
/// `was_active`, whether it held before, `ENCHANTMENT_ACTIVE`, tested with the level's random
/// (D524). What it asks that loot can't tell is said to be missing.
pub fn location_holds<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, entry: LocatedEntry, params: LootParams, was_active: bool, missing: mut List<String>) -> bool {
    var context = params.copy()
    context.enchantment_active = some(was_active)
    return entry_holds(loot, f, level, mut random, entry, context, mut missing)
}

/// Whether the tick effect `entry` holds in the context `params`, `Enchantment.entityContext`:
/// the entity, where it is and the enchantment's level, tested with the level's random (D525).
/// What it asks that loot can't tell is said to be missing.
pub fn tick_holds<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, entry: LocatedEntry, params: LootParams, missing: mut List<String>) -> bool {
    return entry_holds(loot, f, level, mut random, entry, params, mut missing)
}

/// Whether the loot condition `condition` holds in `params`, `LootItemCondition.test`, as an
/// advancement's criterion tests its player's in `EntityPredicate.createContext` (CAL-164),
/// drawing from `random`. What it asks that loot can't tell is said to be missing.
pub fn condition_holds<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, condition: Tag, params: LootParams, missing: mut List<String>) -> bool {
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    let holds = test(loot, f, level, mut random, params, mut r, condition)
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return holds
}

/// `LootItemFunction.apply` of the item modifier `md` to `stack`, `none` for `ItemStack.EMPTY`, as
/// `item` applies one (D571), drawing from `random`: the stack it gives, `none` where that's
/// empty. An empty stack goes through it too, as vanilla's does, drawing what it draws. What it
/// asks that loot can't do is said to be missing.
pub fn modify_stack<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, md: Tag, stack: Tag?, missing: mut List<String>) -> Tag? {
    let given = Stack.from(stack) ?? Stack { id: String("minecraft:air"), count: 0, patch: JavaHashMap<String, Tag>() }
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    let out = modify(loot, f, level, mut random, params, mut r, given, md)
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return out.tag()
}

/// `ItemPredicate.test` of `stack`, `none` for `ItemStack.EMPTY`, as an advancement's criterion
/// tests one (CAL-164). What it asks that loot can't tell is said to be missing.
pub fn item_holds(loot: Loot, predicate: Tag, stack: Tag?, missing: mut List<String>) -> bool {
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    let holds = item_matches(loot, mut r, predicate, stack)
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return holds
}

// `ConditionalEffect.matches` of `entry` in `context`, at the enchantment's level (D524, D525).
fn entry_holds<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, entry: LocatedEntry, context: LootParams, missing: mut List<String>) -> bool {
    let requirements = entry.requirements.copy() else return true
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    r.enchanted_at = some(entry.lv)
    let holds = test(loot, f, level, mut random, context, mut r, requirements)
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return holds
}

// What the location-based effect `effect` of an enchantment at the level `lv` in the slot named
// `slot` does, put on `out` (D524): an `all_of`'s, each in turn, else the one.
fn located(r: mut Roll, effect: JavaHashMap<String, Tag>, lv: i32, slot: String, out: mut List<Located>) {
    let kind = text_of(effect, "type")
    if kind == "minecraft:all_of" {
        if effect.contains("effects") {
            if let Tag.List(list) = effect["effects"] {
                for each in list {
                    if let Tag.Compound(e) = each {
                        located(mut r, e.copy(), lv, slot.copy(), mut out)
                    }
                }
            }
        }
        return
    }
    if kind == "minecraft:attribute" {
        let amount = if effect.contains("amount") { level_based(mut r, effect["amount"].copy(), lv) } else { 0.0f32 }
        let id = text_of(effect, "id")
        out.push(Located.Attribute("{id}/{slot}", text_of(effect, "attribute"), f64(amount), text_of(effect, "operation")))
    } else if kind == "minecraft:replace_disk" {
        out.push(Located.Disk(effect.copy()))
    } else if kind == "minecraft:change_item_damage" {
        let amount = if effect.contains("amount") { level_based(mut r, effect["amount"].copy(), lv) } else { 0.0f32 }
        out.push(Located.ItemDamage(i32.saturate(f64(amount))))
    } else if kind == "minecraft:spawn_particles" {
        out.push(Located.Particles(effect.copy()))
    } else if kind == "minecraft:play_sound" {
        out.push(Located.Sound(effect.copy()))
    } else {
        out.push(Located.Other(kind.copy()))
    }
}

/// The blocks `ReplaceDisk.apply` may set for the entity at x, y, z at the enchantment's level
/// `lv` (D524), `effect` as its codec writes it: each block of the disk around the block it's in
/// moved by `offset`, its `radius` across and `height` up at the level, in `betweenClosed`'s
/// order, whose middle's nearer it across than the radius, with the state its `block_state` names.
/// Each is set where `disk_holds`, asked as it comes to be set. A state or a level-based value
/// Calcite can't tell is said to be missing.
pub fn disk_blocks(f: Facts, effect: JavaHashMap<String, Tag>, lv: i32, x: f64, y: f64, z: f64, missing: mut List<String>) -> List<(i32, i32, i32, u32)> {
    var out = List<(i32, i32, i32, u32)>()
    var r = Roll { missing: List<String>(), visited: List<String>() }
    let state = disk_state(f, if effect.contains("block_state") { effect["block_state"].copy() } else { Tag.End }) else {
        missing.push(String("A disk's block state"))
        return out
    }
    let (ox, oy, oz) = if effect.contains("offset") { vec3_of(effect["offset"]) } else { (0, 0, 0) }
    let cx = i32.saturate(x.floor()) + ox
    let cy = i32.saturate(y.floor()) + oy
    let cz = i32.saturate(z.floor()) + oz
    let dist = i32.saturate(f64(if effect.contains("radius") { level_based(mut r, effect["radius"].copy(), lv) } else { 0.0f32 }))
    let height = i32.saturate(f64(if effect.contains("height") { level_based(mut r, effect["height"].copy(), lv) } else { 0.0f32 }))
    // `betweenClosed` takes the lower of each pair as its start, so a height below 1 reaches a
    // block down.
    let top = cy + (height - 1).min(0)
    let (low, high) = (cy.min(top), cy.max(top))
    var bz = cz - dist
    while bz <= cz + dist {
        var by = low
        while by <= high {
            var bx = cx - dist
            while bx <= cx + dist {
                let dx = f64(bx) + 0.5 - x
                let dz = f64(bz) + 0.5 - z
                if dx * dx + dz * dz < f64(dist * dist) {
                    out.push((bx, by, bz, state))
                }
                bx += 1
            }
            by += 1
        }
        bz += 1
    }
    for each in r.missing {
        missing.push(each.copy())
    }
    return out
}

/// Whether `replace_disk`'s `predicate`, `effect` as its codec writes it, holds of the block at
/// x, y, z of `level` (D524), none holding of every block. What blocks building there are
/// `blocking`, the boxes of the entities that do, which `unobstructed` asks of. What it asks that
/// loot can't tell is said to be missing.
pub fn disk_holds<B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, effect: JavaHashMap<String, Tag>, x: i32, y: i32, z: i32, blocking: List<Aabb>, missing: mut List<String>) -> bool {
    if not effect.contains("predicate") {
        return true
    }
    var r = Roll { missing: missing.copy(), visited: List<String>() }
    let holds = disk_test(loot, f, level, mut r, effect["predicate"].copy(), x, y, z, blocking)
    missing.clear()
    for each in r.missing {
        missing.push(each.copy())
    }
    return holds
}

// The state a disk sets, its `block_state`: a block's ID and properties, as the data writes it,
// or a state as `BlockState.CODEC` writes it, or a simple state provider's (D524).
fn disk_state(f: Facts, t: Tag) -> u32? {
    let Tag.Compound(m) = t else return none
    if m.contains("state") {
        return disk_state(f, m["state"].copy())
    }
    let name = if m.contains("id") { text_of(m, "id") } else { text_of(m, "Name") }
    let block = f.block_named(name) else return none
    var state = f.default_state(block)
    let key = if m.contains("properties") { "properties" } else { "Properties" }
    if m.contains(key) {
        if let Tag.Compound(props) = m[key] {
            for (k, v) in props {
                if let Tag.Str(value) = v {
                    state = f.try_name(state, k.copy(), value.copy())
                }
            }
        }
    }
    return some(state)
}

// `BlockPredicate.test` of the block at x, y, z of `level`, as a disk's predicate asks it (D524):
// `all_of`, `any_of`, `not` and `true`; `matching_blocks`, `matching_block_tag` and
// `matching_fluids` at their offsets; and `unobstructed`, which vanilla's tests at the block
// itself whatever its offset, nothing that blocks building in it. Anything else is said to be
// missing.
fn disk_test<B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, r: mut Roll, t: Tag, x: i32, y: i32, z: i32, blocking: List<Aabb>) -> bool {
    let Tag.Compound(m) = t else return false
    let kind = text_of(m, "type")
    if kind == "minecraft:all_of" or kind == "minecraft:any_of" {
        let any = kind == "minecraft:any_of"
        if m.contains("predicates") {
            if let Tag.List(list) = m["predicates"].copy() {
                for each in list {
                    if disk_test(loot, f, level, mut r, each, x, y, z, blocking) == any {
                        return any
                    }
                }
            }
        }
        return not any
    }
    if kind == "minecraft:not" {
        if not m.contains("predicate") {
            return false
        }
        return not disk_test(loot, f, level, mut r, m["predicate"].copy(), x, y, z, blocking)
    }
    if kind == "minecraft:true" {
        return true
    }
    if kind == "minecraft:unobstructed" {
        for b in blocking {
            if b.intersects(f64(x), f64(y), f64(z), f64(x + 1), f64(y + 1), f64(z + 1)) {
                return false
            }
        }
        return true
    }
    let (ox, oy, oz) = if m.contains("offset") { vec3_of(m["offset"]) } else { (0, 0, 0) }
    let (bx, by, bz) = (x + ox, y + oy, z + oz)
    let state = match level.state(f, bx, by, bz) {
        ok(st) => st,
        err(e) => {
            r.miss(e.message.copy())
            return false
        },
    }
    if kind == "minecraft:matching_blocks" {
        return m.contains("blocks") and block_in(f, m["blocks"], state)
    }
    if kind == "minecraft:matching_block_tag" {
        let tag = text_of(m, "tag")
        return block_in(f, Tag.Str("#{tag}"), state)
    }
    if kind == "minecraft:matching_fluids" {
        return m.contains("fluids") and loot.items.holder_set_has("fluid", m["fluids"], i32.wrap(f.fluid(state)))
    }
    r.miss("The block predicate {kind} in a disk")
    return false
}

// A `Vec3i` as its codec writes it, a list of three ints, or an int array.
fn vec3_of(t: Tag) -> (i32, i32, i32) {
    match t {
        Tag.List(l) => {
            if l.len() == 3 {
                return (l[0].number_int() ?? 0, l[1].number_int() ?? 0, l[2].number_int() ?? 0)
            }
        },
        Tag.IntArray(a) => {
            if a.len() == 3 {
                return (a[0], a[1], a[2])
            }
        },
        _ => {},
    }
    return (0, 0, 0)
}

/// `MinMaxBounds.Doubles.matches`: `v` within the bounds `b`, a number for one value alone or its
/// `min` and `max` (D524).
pub fn doubles_match(b: Tag, v: f64) -> bool {
    match b {
        Tag.Compound(m) => {
            if m.contains("min") {
                if (m["min"].number_double() ?? 0.0) > v {
                    return false
                }
            }
            if m.contains("max") {
                if (m["max"].number_double() ?? 0.0) < v {
                    return false
                }
            }
            return true
        },
        other => return (other.number_double() ?? v) == v,
    }
}

/// `DistancePredicate.matches` from `x0`, `y0`, `z0` to `x1`, `y1`, `z1` (CAL-164): each axis's
/// distance, as a float, within `x`, `y` and `z`, then the square of the distance across and of
/// the whole distance within `horizontal`'s and `absolute`'s.
pub fn distance_holds(p: Tag, x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) -> bool {
    let Tag.Compound(m) = p else return false
    let xd = f32.nearest(x0 - x1)
    let yd = f32.nearest(y0 - y1)
    let zd = f32.nearest(z0 - z1)
    for (key, v) in [("x", xd), ("y", yd), ("z", zd)] {
        if m.contains(key) and not doubles_match(m[key], f64(v.abs())) {
            return false
        }
    }
    if m.contains("horizontal") and not doubles_match_sqr(m["horizontal"], f64(xd * xd + zd * zd)) {
        return false
    }
    return not m.contains("absolute") or doubles_match_sqr(m["absolute"], f64(xd * xd + yd * yd + zd * zd))
}

// `MinMaxBounds.Doubles.matchesSqr`: the square `v` within the bounds' squares (D524).
fn doubles_match_sqr(b: Tag, v: f64) -> bool {
    match b {
        Tag.Compound(m) => {
            if m.contains("min") {
                let low = m["min"].number_double() ?? 0.0
                if low * low > v {
                    return false
                }
            }
            if m.contains("max") {
                let high = m["max"].number_double() ?? 0.0
                if high * high < v {
                    return false
                }
            }
            return true
        },
        other => {
            let at = other.number_double() ?? 0.0
            return at * at == v
        },
    }
}

/// The random sequence the table `name` draws from, `random_sequence`, or `none` where it has
/// none, or there's no such table, and it draws from the level's random.
pub fn random_sequence(loot: Loot, name: String) -> String? {
    let table = loot.table(name) else return none
    let Tag.Compound(m) = table else return none
    if not m.contains("random_sequence") {
        return none
    }
    return match m["random_sequence"] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

/// The random sequence the trade set `name`, a whole ID, draws from, `TradeSet.randomSequence`,
/// or none where it names none or isn't there (CAL-160).
pub fn trade_sequence(loot: Loot, name: String) -> String? {
    let set = loot.entry(TRADE_SETS, name) else return none
    let Tag.Compound(m) = set else return none
    if not m.contains("random_sequence") {
        return none
    }
    return match m["random_sequence"] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

/// `AbstractVillager.addOffersFromTradeSet` of the trade set `name`, a whole ID (CAL-160): how
/// many offers it makes, `calculateNumberOfTrades`, then its trades drawn one by one,
/// `nextInt` of how many are left, each made an offer as `VillagerTrade.getOffer` makes it; one
/// that makes none taken out, and, where the set mayn't give one again, each drawn taken out
/// first, `addOffersFromItemListingsWithoutDuplicates`. Each offer as `MerchantOffer.CODEC`
/// writes it. None for a set that isn't there, which vanilla logs. A trade that needs what
/// Calcite hasn't made yet makes no offer, and what it needs goes in `missing`.
pub fn trade_offers<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, name: String, missing: mut List<String>) -> List<Tag> {
    var out = List<Tag>()
    let set = match loot.entry(TRADE_SETS, name) {
        some(Tag.Compound(m)) => m,
        _ => return out,
    }
    var roll = Roll { missing: List<String>(), visited: List<String>() }
    let amount = if set.contains("amount") { int_value(loot, mut random, mut roll, set["amount"]) } else { 0 }
    let again = if set.contains("allow_duplicates") { set["allow_duplicates"].number_bool() ?? false } else { false }
    var left = List<String>()
    if set.contains("trades") {
        if let Tag.List(ids) = set["trades"] {
            for t in ids {
                if let Tag.Str(s) = t {
                    left.push(s.copy())
                }
            }
        }
    }
    var found = 0
    while found < amount and not left.is_empty() {
        let at = usize.wrap(random.next_int_below(i32.wrap(left.len())))
        let id = left[at].copy()
        if not again {
            _ = left.remove(at)
        }
        let had = roll.misses
        let made = trade_offer(loot, f, level, mut random, params, mut roll, id)
        var offer: Tag? = made
        if roll.misses > had {
            offer = none
        }
        match offer {
            some(o) => {
                out.push(o)
                found += 1
            },
            none => {
                if again {
                    _ = left.remove(at)
                }
            },
        }
    }
    for m in roll.missing {
        missing.push(m.copy())
    }
    return out
}

// `VillagerTrade.getOffer` of the trade `id`: none where the merchant isn't what it must be;
// what it gives made, and changed as its modifier says, none where that leaves nothing; the
// cost the item adds taken off it, `ADDITIONAL_TRADE_COST`, doubled where it has a stored
// enchantment of those the trade names; then what it wants, its count with that cost added,
// and what more it wants, each none below 1; and its uses, at least 1, its experience, at least
// 0, and its discount, at least 0, in that order.
fn trade_offer<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, id: String) -> Tag? {
    let trade = match loot.entry(TRADES, id) {
        some(Tag.Compound(m)) => m,
        _ => return none,
    }
    if trade.contains("merchant_predicate") {
        if not test(loot, f, level, mut random, params, mut roll, trade["merchant_predicate"]) {
            return none
        }
    }
    let gives: Tag? = if trade.contains("gives") { some(trade["gives"].copy()) } else { none }
    var result = Stack.from(gives) ?? Stack { id: String("minecraft:air"), count: 0, patch: JavaHashMap<String, Tag>() }
    var extra = 0
    if trade.contains("given_item_modifier") {
        result = modify(loot, f, level, mut random, params, mut roll, result, trade["given_item_modifier"])
        if result.empty() {
            return none
        }
    }
    if result.patch.contains("minecraft:additional_trade_cost") {
        extra += result.patch["minecraft:additional_trade_cost"].number_int() ?? 0
        _ = result.patch.remove("minecraft:additional_trade_cost")
    }
    if trade.contains("double_trade_price_enchantments") {
        if let Tag.Compound(stored) = result.component(loot.items, String("minecraft:stored_enchantments")) ?? Tag.End {
            for (name, _) in stored {
                if loot.enchantment_in(trade["double_trade_price_enchantments"], name.copy()) {
                    extra *= 2
                    break
                }
            }
        }
    }
    let wants: Tag = if trade.contains("wants") { trade["wants"].copy() } else { Tag.End }
    let buy = trade_cost(loot, mut random, mut roll, wants, extra) else return none
    var buy_b: Tag? = none
    if trade.contains("additional_wants") {
        let more = trade_cost(loot, mut random, mut roll, trade["additional_wants"], 0) else return none
        buy_b = some(more)
    }
    let uses = if trade.contains("max_uses") { int_value(loot, mut random, mut roll, trade["max_uses"]) } else { 4 }
    let xp = if trade.contains("xp") { int_value(loot, mut random, mut roll, trade["xp"]) } else { 1 }
    let discount = if trade.contains("reputation_discount") { float_value(loot, mut random, mut roll, trade["reputation_discount"]) } else { 0.0f32 }
    let sell = result.tag() else return none
    var o = JavaHashMap<String, Tag>()
    o.insert(String("buy"), buy)
    if let b = buy_b {
        o.insert(String("buyB"), b)
    }
    o.insert(String("sell"), sell)
    // What `MerchantOffer.CODEC` leaves out at its defaults: none used, 4 uses, experience
    // rewarded, no special price or demand, a multiplier of 0 and 1 experience.
    let max_uses = uses.max(1)
    if max_uses != 4 {
        o.insert(String("maxUses"), Tag.Int(max_uses))
    }
    let multiplier = discount.max(0.0f32)
    if multiplier != 0.0f32 {
        o.insert(String("priceMultiplier"), Tag.Float(multiplier))
    }
    let reward = xp.max(0)
    if reward != 1 {
        o.insert(String("xp"), Tag.Int(reward))
    }
    return some(Tag.Compound(o))
}

// `TradeCost.toItemCost`: the item `cost` wants, its count drawn and `extra` added, kept within 0
// and the item's own most in a stack, and its components, as `ItemCost.CODEC` writes it, the
// count always; none below 1.
fn trade_cost<R: RandomSource>(loot: Loot, random: mut R, roll: mut Roll, cost: Tag, extra: i32) -> Tag? {
    let Tag.Compound(m) = cost else return none
    if not m.contains("id") {
        return none
    }
    let id = match m["id"] {
        Tag.Str(s) => s.copy(),
        _ => return none,
    }
    let drawn = if m.contains("count") { int_value(loot, mut random, mut roll, m["count"]) } else { 1 }
    let most = match loot.items.default_component(id.copy(), String("minecraft:max_stack_size")) {
        some(t) => t.number_int() ?? 64,
        none => 64,
    }
    let count = (drawn + extra).max(0).min(most)
    if count < 1 {
        return none
    }
    var out = JavaHashMap<String, Tag>()
    out.insert(String("id"), Tag.Str(id))
    out.insert(String("count"), Tag.Int(count))
    if m.contains("components") {
        if let Tag.Compound(c) = m["components"] {
            if not c.is_empty() {
                out.insert(String("components"), Tag.Compound(c.copy()))
            }
        }
    }
    return some(Tag.Compound(out))
}

// `getRandomItemsRaw`: each pool's items, each through the table's modifier, then `chain`, the
// modifiers whose output it goes to, into `out`. A table named again inside itself gives
// nothing, as `pushVisitedElement` stops it.
fn table_items<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, table: Tag, name: String?, chain: List<Tag>, out: mut List<Stack>) {
    let Tag.Compound(m) = table else return
    let mark = match name {
        some(n) => some("table {n}"),
        none => none,
    }
    if let k = mark {
        for v in roll.visited {
            if v == k {
                return
            }
        }
        roll.visited.push(k.copy())
    }
    var wrapped = chain.copy()
    if m.contains("modifier") {
        wrapped.insert(0, m["modifier"].copy())
    }
    if m.contains("pools") {
        if let Tag.List(pools) = m["pools"] {
            for pool in pools {
                pool_items(loot, f, level, mut random, params, mut roll, pool, wrapped, mut out)
            }
        }
    }
    if let k = mark {
        var i = roll.visited.len()
        while i > 0 {
            i -= 1
            if roll.visited[i] == k {
                _ = roll.visited.remove(i)
                break
            }
        }
    }
}

// An entry as a pool weighs it, `LootPoolEntry`: the singleton entry, its weight, and the
// modifiers its stacks go through, the innermost first, as `adjustOutput` wraps them; or, for
// one of a tag's items an expanded tag entry gives, that item.
struct Weighed {
    entry: Tag
    weight: i32
    modifiers: List<Tag>
    item: String? = none
}

// `LootPool.addRandomItems`: if its condition holds, `rolls` and `bonus_rolls` times its luck
// rolls, each a weighted pick of the entries that expand.
fn pool_items<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, pool: Tag, chain: List<Tag>, out: mut List<Stack>) {
    let Tag.Compound(m) = pool else return
    if m.contains("condition") {
        let c = m["condition"].copy()
        if not test(loot, f, level, mut random, params, mut roll, c) {
            return
        }
    }
    var wrapped = chain.copy()
    if m.contains("modifier") {
        wrapped.insert(0, m["modifier"].copy())
    }
    let rolls = if m.contains("rolls") { int_value(loot, mut random, mut roll, m["rolls"]) } else { 0 }
    let bonus = if m.contains("bonus_rolls") { float_value(loot, mut random, mut roll, m["bonus_rolls"]) } else { 0.0f32 }
    let count = rolls + floor_f32(bonus * params.luck)
    var i = 0
    while i < count {
        i += 1
        var valid = List<Weighed>()
        if m.contains("entries") {
            if let Tag.List(entries) = m["entries"] {
                for e in entries {
                    _ = expand(loot, f, level, mut random, params, mut roll, e, mut valid)
                }
            }
        }
        var total = 0
        var kept = List<Weighed>()
        for w in valid {
            let weight = w.weight
            if weight > 0 {
                total += weight
                kept.push(w.copy())
            }
        }
        if total == 0 or kept.is_empty() {
            continue
        }
        if kept.len() == 1 {
            create(loot, f, level, mut random, params, mut roll, kept[0], wrapped, mut out)
            continue
        }
        var index = random.next_int_below(total)
        for w in kept {
            index -= w.weight
            if index < 0 {
                create(loot, f, level, mut random, params, mut roll, w, wrapped, mut out)
                break
            }
        }
    }
}

// `LootPoolEntryContainer.expand`: whether `entry`, if its condition holds, gave what it can be
// picked as, into `out`, each with its own modifier wrapped round it.
fn expand<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, entry: Tag, out: mut List<Weighed>) -> bool {
    let Tag.Compound(m) = entry else return false
    if m.contains("condition") {
        let c = m["condition"].copy()
        if not test(loot, f, level, mut random, params, mut roll, c) {
            return false
        }
    }
    let kind = text_of(m, "type")
    var mine = List<Weighed>()
    var expanded = false
    if kind == "minecraft:alternatives" or kind == "minecraft:sequence" or kind == "minecraft:group" {
        let children = if m.contains("children") { m["children"].copy() } else { Tag.List([]) }
        let Tag.List(each) = children else return false
        // As `compose` has them: `alternatives` stops at the first child that expands, and with
        // none expands nothing; `sequence` stops at the first that doesn't, and with none
        // expands; `group` expands them all and says it did, but for one child, whose answer
        // is its own.
        if kind == "minecraft:alternatives" {
            for c in each {
                if expand(loot, f, level, mut random, params, mut roll, c, mut mine) {
                    expanded = true
                    break
                }
            }
        } else if kind == "minecraft:sequence" {
            expanded = true
            for c in each {
                if not expand(loot, f, level, mut random, params, mut roll, c, mut mine) {
                    expanded = false
                    break
                }
            }
        } else {
            expanded = true
            for c in each {
                let one = expand(loot, f, level, mut random, params, mut roll, c, mut mine)
                if each.len() == 1 {
                    expanded = one
                }
            }
        }
    } else if kind == "minecraft:tag" and (if m.contains("expand") { m["expand"].number_bool() ?? false } else { false }) {
        // `addExpandedEntries`: each of the tag's items its own entry, of the entry's weight.
        let weight = weight_of(m, params.luck)
        for item in tag_items(loot, text_of(m, "name")) {
            mine.push(Weighed { entry: entry.copy(), weight: weight, modifiers: [], item: some(item.copy()) })
        }
        expanded = true
    } else if kind == "minecraft:slots" {
        roll.miss(String("Slot sources in loot tables"))
        return false
    } else {
        mine.push(Weighed { entry: entry.copy(), weight: weight_of(m, params.luck), modifiers: [] })
        expanded = true
    }
    let modifier: Tag? = if m.contains("modifier") { some(m["modifier"].copy()) } else { none }
    for w in mine {
        var adjusted = w.copy()
        if let md = modifier {
            adjusted.modifiers.push(md.copy())
        }
        out.push(adjusted)
    }
    return expanded
}

// `getWeight(luck)`: `weight` and `quality` times the luck, rounded down, at least 0.
fn weight_of(m: JavaHashMap<String, Tag>, luck: f32) -> i32 {
    let weight = if m.contains("weight") { m["weight"].number_int() ?? 1 } else { 1 }
    let quality = if m.contains("quality") { m["quality"].number_int() ?? 0 } else { 0 }
    return floor_f32(f32.nearest(weight) + f32.nearest(quality) * luck).max(0)
}

// `createItemStack`: the stacks the picked entry makes, each through its modifiers and then
// `chain`.
fn create<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, w: Weighed, chain: List<Tag>, out: mut List<Stack>) {
    var through = w.modifiers.copy()
    for c in chain {
        through.push(c.copy())
    }
    if let item = w.item {
        emit(loot, f, level, mut random, params, mut roll, Stack.of(item.copy()), through, mut out)
        return
    }
    let Tag.Compound(m) = w.entry else return
    let kind = text_of(m, "type")
    if kind == "minecraft:item" {
        emit(loot, f, level, mut random, params, mut roll, Stack.of(text_of(m, "name")), through, mut out)
    } else if kind == "minecraft:loot_table" {
        // `NestedLootTable`: a table by its ID, or one given whole.
        if not m.contains("value") {
            return
        }
        match m["value"] {
            Tag.Str(id) => {
                let nested = loot.table(id.copy()) else return
                table_items(loot, f, level, mut random, params, mut roll, nested, some(id.copy()), through, mut out)
            },
            other => table_items(loot, f, level, mut random, params, mut roll, other.copy(), none, through, mut out),
        }
    } else if kind == "minecraft:dynamic" {
        let name = text_of(m, "name")
        for (n, stacks) in params.dynamic {
            if n != name {
                continue
            }
            for s in stacks {
                let given = Stack.from(s.copy()) ?? Stack { id: String("minecraft:air"), count: 0, patch: JavaHashMap<String, Tag>() }
                emit(loot, f, level, mut random, params, mut roll, given, through, mut out)
            }
        }
    } else if kind == "minecraft:tag" {
        for item in tag_items(loot, text_of(m, "name")) {
            emit(loot, f, level, mut random, params, mut roll, Stack.of(item), through, mut out)
        }
    }
}

// A stack made, through each of `chain` in turn, into `out`, as `LootItemFunction.decorate`'s
// consumers pass it on.
fn emit<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, stack: own Stack, chain: List<Tag>, out: mut List<Stack>) {
    var s = stack
    for md in chain {
        s = modify(loot, f, level, mut random, params, mut roll, s, md)
    }
    out.push(s)
}

// The items of the item tag `name`, by name, in the tag's order.
fn tag_items(loot: Loot, name: String) -> List<String> {
    var out = List<String>()
    let id = match Identifier.parse(name) {
        ok(i) => i,
        err(_) => return out,
    }
    let at = loot.registries.value.find_builtin(String("item")) else return out
    for n in loot.registries.value.builtin[at].tag_ids(id) {
        if let item = loot.items.builtin_name("item", n) {
            out.push(item)
        }
    }
    return out
}

// An item modifier, `LootItemFunction.apply`, on `stack`: by its ID, a list of them in turn, or
// one given whole, which a condition can stop, as `LootItemConditionalFunction.apply` does.
fn modify<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, stack: own Stack, md: Tag) -> Stack {
    var s = stack
    match md {
        Tag.Str(id) => {
            let k = "modifier {id}"
            for v in roll.visited {
                if v == k {
                    return s
                }
            }
            let named = loot.entry(MODIFIERS, id.copy()) else return s
            roll.visited.push(k.copy())
            s = modify(loot, f, level, mut random, params, mut roll, s, named)
            _ = roll.visited.pop()
            return s
        },
        Tag.List(each) => {
            for one in each {
                s = modify(loot, f, level, mut random, params, mut roll, s, one)
            }
            return s
        },
        Tag.Compound(m) => {
            if m.contains("condition") {
                let c = m["condition"].copy()
                if not test(loot, f, level, mut random, params, mut roll, c) {
                    return s
                }
            }
            return run(loot, f, level, mut random, params, mut roll, s, m)
        },
        _ => return s,
    }
}

// A modifier's own work, `run`, once its condition holds.
fn run<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, stack: own Stack, m: JavaHashMap<String, Tag>) -> Stack {
    var s = stack
    let kind = text_of(m, "type")
    if kind == "minecraft:set_count" {
        let add = if m.contains("add") { m["add"].number_bool() ?? false } else { false }
        let base = if add { s.count } else { 0 }
        let n = if m.contains("count") { int_value(loot, mut random, mut roll, m["count"]) } else { 0 }
        s.count = base + n
    } else if kind == "minecraft:explosion_decay" {
        if let radius = params.explosion_radius {
            let p = 1.0f32 / radius
            var kept = 0
            var i = 0
            while i < s.count {
                i += 1
                if random.next_float() <= p {
                    kept += 1
                }
            }
            s.count = kept
        }
    } else if kind == "minecraft:apply_bonus" {
        if params.has_tool {
            let lv = enchantment_level(loot, params.tool, text_of(m, "enchantment"))
            s.count = bonus_count(m, mut random, s.count, lv)
        }
    } else if kind == "minecraft:enchanted_count_increase" {
        // `EnchantedCountIncreaseFunction`: by the attacker's level of the enchantment, as its main
        // hand has it, nothing drawn at 0 (D416).
        if let a = params.attacker {
            let lv = enchantment_level(loot, a.hand.copy(), text_of(m, "enchantment"))
            if lv > 0 {
                let per = if m.contains("count") { float_value(loot, mut random, mut roll, m["count"]) } else { 0.0f32 }
                let extra = f32.nearest(f64(lv)) * per
                s.count += i32.saturate((f64(extra) + 0.5).floor())
                let limit = if m.contains("limit") { m["limit"].number_int() ?? 0 } else { 0 }
                if limit > 0 {
                    s.count = s.count.min(limit)
                }
            }
        }
    } else if kind == "minecraft:limit_count" {
        if m.contains("limit") {
            s.count = limited(loot, mut random, mut roll, m["limit"], s.count)
        }
    } else if kind == "minecraft:copy_state" {
        if let state = params.state {
            s = copied_state(loot, f, s, m, state)
        }
    } else if kind == "minecraft:copy_components" {
        s = copied_components(loot, params, mut roll, s, m)
    } else if kind == "minecraft:furnace_smelt" {
        let each = if m.contains("use_input_count") { m["use_input_count"].number_bool() ?? true } else { true }
        s = smelted(loot, s, each)
    } else if kind == "minecraft:sequence" {
        if m.contains("functions") {
            if let Tag.List(each) = m["functions"] {
                for one in each {
                    s = modify(loot, f, level, mut random, params, mut roll, s, one)
                }
            }
        }
    } else if kind == "minecraft:filtered" {
        // `FilteredFunction` (CAL-160): `on_pass` where the stack is what `item_filter` asks,
        // else `on_fail`, where there's one.
        let pass = if m.contains("item_filter") { item_matches(loot, mut roll, m["item_filter"], s.tag()) } else { false }
        let then = if pass { "on_pass" } else { "on_fail" }
        if m.contains(then) {
            s = modify(loot, f, level, mut random, params, mut roll, s, m[then])
        }
    } else if kind == "minecraft:discard" {
        // `DiscardItem`: nothing, `ItemStack.EMPTY`.
        s = Stack { id: String("minecraft:air"), count: 0, patch: JavaHashMap<String, Tag>() }
    } else if kind == "minecraft:set_random_dyes" {
        // `SetRandomDyesFunction` (D523): as many dyes as `number_of_dyes` comes to, each of the
        // 16 by an even draw, `Util.getRandom`, mixed into its colour, `DyedItemColor.applyDyes`,
        // one of it; as it was where that's none.
        let rolls = if m.contains("number_of_dyes") { int_value(loot, mut random, mut roll, m["number_of_dyes"]) } else { 0 }
        if rolls > 0 {
            var dyes = List<String>()
            var i = 0
            while i < rolls {
                dyes.push(dye_name(random.next_int_below(16)))
                i += 1
            }
            let current = s.component(loot.items, String("minecraft:dyed_color"))
            s.count = 1
            s.set(loot.items, String("minecraft:dyed_color"), Tag.Int(mixed_dyes(current, dyes)))
        }
    } else if kind == "minecraft:set_potion" {
        // `SetPotionFunction` (D523): its potion contents' potion `id`, `withPotion`.
        if m.contains("id") {
            if let Tag.Str(name) = m["id"] {
                s = with_potion(loot, s, name.copy())
            }
        }
    } else if kind == "minecraft:set_random_potion" {
        // `SetRandomPotionFunction` (D523): one of its `options` by an even draw, or of every
        // potion, `getRandom`, as its potion contents' potion; as it was where there's none.
        var ids = List<i32>()
        if m.contains("options") {
            ids = loot.items.holder_set_entries("potion", m["options"])
        } else {
            var n = 0
            while loot.items.builtin_name("potion", n) != none {
                ids.push(n)
                n += 1
            }
        }
        if not ids.is_empty() {
            let id = ids[usize.wrap(random.next_int_below(i32.wrap(ids.len())))]
            if let name = loot.items.builtin_name("potion", id) {
                s = with_potion(loot, s, name)
            }
        }
    } else if kind == "minecraft:set_stew_effect" {
        // `SetStewEffectFunction` (D523): on suspicious stew, one of its effects by an even draw,
        // for its duration in seconds, or in ticks for an instant one, added to the stew's,
        // `withEffectAdded`.
        if s.id == "minecraft:suspicious_stew" and m.contains("effects") {
            if let Tag.List(effects) = m["effects"].copy() {
                if not effects.is_empty() {
                    let picked = effects[usize.wrap(random.next_int_below(i32.wrap(effects.len())))].copy()
                    if let Tag.Compound(entry) = picked {
                        let name = text_of(entry, "type")
                        var duration = if entry.contains("duration") { int_value(loot, mut random, mut roll, entry["duration"]) } else { 0 }
                        let facts = effect_facts()
                        if let e = effect_id(name.copy()) {
                            if not facts[usize.wrap(e)].instantaneous() {
                                duration *= 20
                            }
                        }
                        var had = List<Tag>()
                        if let Tag.List(was) = s.component(loot.items, String("minecraft:suspicious_stew_effects")) ?? Tag.End {
                            had = was.copy()
                        }
                        var added = JavaHashMap<String, Tag>()
                        added.insert(String("id"), Tag.Str(whole_name(name)))
                        if duration != 160 {
                            added.insert(String("duration"), Tag.Int(duration))
                        }
                        had.push(Tag.Compound(added))
                        s.set(loot.items, String("minecraft:suspicious_stew_effects"), Tag.List(had))
                    }
                }
            }
        }
    } else if kind == "minecraft:enchant_with_levels" {
        // `EnchantWithLevelsFunction` (D522): enchanted for its levels from its options, or all
        // the enchantments, `enchantItem`; where it adds the cost and may, those levels as the
        // cost it adds to a trade.
        let cost = if m.contains("levels") { int_value(loot, mut random, mut roll, m["levels"]) } else { 0 }
        let source = if m.contains("options") { loot.enchanting.set_ids(m["options"]) } else { loot.enchanting.all() }
        s = enchanted_item(loot, mut random, s, cost, source)
        let adds = if m.contains("include_additional_cost_component") { m["include_additional_cost_component"].number_bool() ?? false } else { false }
        if adds and params.additional_cost and not s.empty() and cost > 0 {
            s.set(loot.items, String("minecraft:additional_trade_cost"), Tag.Int(cost))
        }
    } else if kind == "minecraft:enchant_randomly" {
        // `EnchantRandomlyFunction` (D522): one of its options, or of all the enchantments, that
        // goes on the item, `canEnchant`, unless it's a book or it's told not to look,
        // `only_compatible`, at a level drawn for it, a book made an enchanted book; where it adds
        // the cost and may, a cost drawn from its level. With none to pick, it's as it was, which
        // vanilla warns of.
        let book = s.id == "minecraft:book"
        let only = if m.contains("only_compatible") { m["only_compatible"].number_bool() ?? true } else { true }
        let source = if m.contains("options") { loot.enchanting.set_ids(m["options"]) } else { loot.enchanting.all() }
        if let (id, lv) = loot.enchanting.pick_one(mut random, s.id.copy(), book or not only, source) {
            if book {
                s = Stack.of(String("minecraft:enchanted_book"))
            }
            s = enchant_stack(loot, s, loot.enchanting.name(id), lv)
            let adds = if m.contains("include_additional_cost_component") { m["include_additional_cost_component"].number_bool() ?? false } else { false }
            if adds and params.additional_cost {
                let cost = 2 + random.next_int_below(5 + lv * 10) + 3 * lv
                s.set(loot.items, String("minecraft:additional_trade_cost"), Tag.Int(cost))
            }
        }
    } else {
        roll.miss("The item modifier {kind}")
    }
    return s
}

// `EnchantmentHelper.enchantItem` (D522): what the cost `cost` picks for the stack from the
// enchantments `source`, `selectEnchantment`, by its `enchantable` value; a book made an
// enchanted book, of one; then each picked put on it, in turn.
fn enchanted_item<R: RandomSource>(loot: Loot, random: mut R, stack: own Stack, cost: i32, source: List<i32>) -> Stack {
    var s = stack
    let picked = loot.enchanting.select(mut random, s.id.copy(), enchantable_value(loot, s), cost, source)
    if s.id == "minecraft:book" {
        s = Stack.of(String("minecraft:enchanted_book"))
    }
    for (id, lv) in picked {
        s = enchant_stack(loot, s, loot.enchanting.name(id), lv)
    }
    return s
}

/// `EnchantmentHelper.enchantItemFromProvider` with `mob_spawn_equipment` (D522): the stack
/// `stack`, as `ItemStack.CODEC` writes it, with what vanilla's provider of that name,
/// `EnchantmentsByCostWithDifficulty` of `#on_mob_spawn_equipment` from a cost of 5 with up to 17
/// more by the special multiplier `special`, puts on it: a cost drawn from that range, the
/// enchantments it picks for the stack, `selectEnchantment`, each raised to its level on it. As
/// it was, nothing drawn, where it hasn't the enchantments component, as `updateEnchantments`
/// leaves it. The world's `enchantment_provider` registry has no contents in Calcite, so a data
/// pack's provider of that name isn't read yet (CAL-217).
pub fn spawn_enchanted<R: RandomSource>(loot: Loot, random: mut R, stack: Tag, special: f32) -> Tag {
    let s = Stack.from(some(stack.copy())) else return stack.copy()
    let key = if s.id == "minecraft:enchanted_book" { "minecraft:stored_enchantments" } else { "minecraft:enchantments" }
    if s.component(loot.items, String(key)) == none {
        return stack.copy()
    }
    let least = 5
    let cost = random.next_int_below(i32.saturate(f64(special * 17.0f32).floor()) + 1) + least
    let source = loot.enchanting.set_ids(Tag.Str(String("#minecraft:on_mob_spawn_equipment")))
    let picked = loot.enchanting.select(mut random, s.id.copy(), enchantable_value(loot, s), cost, source)
    var out = s
    for (id, lv) in picked {
        out = enchant_stack(loot, out, loot.enchanting.name(id), lv)
    }
    return out.tag() ?? stack.copy()
}

// `PotionContents.withPotion` on the stack's potion contents (D523): their potion `name`, the
// rest as they were, set as `update` sets it.
fn with_potion(loot: Loot, stack: own Stack, name: own String) -> Stack {
    var s = stack
    var contents = JavaHashMap<String, Tag>()
    match s.component(loot.items, String("minecraft:potion_contents")) {
        some(Tag.Compound(had)) => contents = had.copy(),
        some(Tag.Str(only)) => contents.insert(String("potion"), Tag.Str(only.copy())),
        _ => {},
    }
    contents.insert(String("potion"), Tag.Str(whole_name(name)))
    s.set(loot.items, String("minecraft:potion_contents"), Tag.Compound(contents))
    return s
}

// The whole ID of `name`, `minecraft:` where it names no namespace.
fn whole_name(name: own String) -> String {
    if name.contains(":") {
        return name
    }
    return "minecraft:{name}"
}

/// `EnchantmentHelper.enchantItem` (D522) on the stack `stack`, as `ItemStack.CODEC` writes it,
/// with the cost `cost` and the enchantments `source`, as `enchant_with_levels` enchants: what
/// it's made, as that codec writes it, `none` where it's empty.
pub fn enchant_item<R: RandomSource>(loot: Loot, random: mut R, stack: Tag, cost: i32, source: List<i32>) -> Tag? {
    let s = Stack.from(some(stack.copy())) else return none
    return enchanted_item(loot, mut random, s, cost, source).tag()
}

// The stack's `enchantable` value, which enchanting goes by, none where it hasn't one.
fn enchantable_value(loot: Loot, s: Stack) -> i32? {
    if let Tag.Compound(e) = s.component(loot.items, String("minecraft:enchantable")) ?? Tag.End {
        if e.contains("value") {
            return e["value"].number_int()
        }
    }
    return none
}

// `ItemStack.enchant` (D522): the enchantment `name` raised to `level` on the stack, among its
// stored enchantments for an enchanted book, else its enchantments, `updateEnchantments`; nothing
// where it hasn't that component at all.
fn enchant_stack(loot: Loot, stack: own Stack, name: own String, level: i32) -> Stack {
    var s = stack
    let key = if s.id == "minecraft:enchanted_book" { "minecraft:stored_enchantments" } else { "minecraft:enchantments" }
    let had = s.component(loot.items, String(key)) else return s
    let Tag.Compound(levels) = had else return s
    var now = levels.copy()
    upgrade(mut now, name, level)
    s.set(loot.items, String(key), Tag.Compound(now))
    return s
}

// `SmeltItemFunction` on `stack` (D436): the first smelting recipe whose ingredient takes it, its
// result, as many as the stack had where `each`, `use_input_count`, else one, times the result's
// count, no more than the result's most; else the stack as it was, which vanilla warns of.
fn smelted(loot: Loot, stack: own Stack, each: bool) -> Stack {
    if stack.empty() {
        return stack
    }
    for recipe in loot.smelting {
        if not recipe.input.items.contains(stack.id) {
            continue
        }
        var result = Stack.from(some(recipe.result.copy())) ?? Stack.of(String("minecraft:air"))
        if result.empty() {
            break
        }
        let n = (if each { stack.count } else { 1 }) * result.count
        let most = match result.component(loot.items, String("minecraft:max_stack_size")) {
            some(Tag.Int(k)) => k,
            _ => 1,
        }
        result.count = n.min(most)
        return result
    }
    return stack
}

// `ApplyBonusCount`'s formula on `count` at the enchantment's level `lv`.
fn bonus_count<R: RandomSource>(m: JavaHashMap<String, Tag>, random: mut R, count: i32, lv: i32) -> i32 {
    let formula = text_of(m, "formula")
    let parameters = if m.contains("parameters") { m["parameters"].copy() } else { Tag.End }
    if formula == "minecraft:binomial_with_bonus_count" {
        let Tag.Compound(p) = parameters else return count
        let extra = if p.contains("extra") { p["extra"].number_int() ?? 0 } else { 0 }
        let probability = if p.contains("probability") { p["probability"].number_float() ?? 0.0f32 } else { 0.0f32 }
        var n = count
        var i = 0
        while i < lv + extra {
            i += 1
            if random.next_float() < probability {
                n += 1
            }
        }
        return n
    }
    if formula == "minecraft:ore_drops" {
        if lv <= 0 {
            return count
        }
        let bonus = (random.next_int_below(lv + 2) - 1).max(0)
        return count * (bonus + 1)
    }
    if formula == "minecraft:uniform_bonus_count" {
        let Tag.Compound(p) = parameters else return count
        let multiplier = if p.contains("bonusMultiplier") { p["bonusMultiplier"].number_int() ?? 0 } else { 0 }
        return count + random.next_int_below(multiplier * lv + 1)
    }
    return count
}

// `IntLimit.clamp`: `count` held to `min` and `max`, each drawn as it's needed, the least first.
fn limited<R: RandomSource>(loot: Loot, random: mut R, roll: mut Roll, limit: Tag, count: i32) -> i32 {
    let Tag.Compound(m) = limit else return count
    let has_min = m.contains("min")
    let has_max = m.contains("max")
    if has_min and has_max {
        let low = int_value(loot, mut random, mut roll, m["min"])
        let high = int_value(loot, mut random, mut roll, m["max"])
        if count < low {
            return low
        }
        return count.min(high)
    }
    if has_min {
        return int_value(loot, mut random, mut roll, m["min"]).max(count)
    }
    if has_max {
        return int_value(loot, mut random, mut roll, m["max"]).min(count)
    }
    return count
}

// `CopyBlockState`: each of `properties` the named block has, which the broken state has too,
// set in the stack's `block_state` to the state's value of it.
fn copied_state(loot: Loot, f: Facts, stack: own Stack, m: JavaHashMap<String, Tag>, state: u32) -> Stack {
    var s = stack
    let named = f.block_named(text_of(m, "block")) else return s
    let default = f.default_state(named)
    var values = match s.component(loot.items, String("minecraft:block_state")) {
        some(Tag.Compound(v)) => v.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
    if m.contains("properties") {
        if let Tag.List(names) = m["properties"] {
            for n in names {
                let Tag.Str(prop) = n else continue
                let wanted = f.prop(default, prop.copy()) else continue
                let have = f.prop(state, prop.copy()) else continue
                if have.id != wanted.id {
                    continue
                }
                values.insert(prop.copy(), Tag.Str(f.codec.value_name(have, have.get(state))))
            }
        }
    }
    s.set(loot.items, String("minecraft:block_state"), Tag.Compound(values))
    return s
}

// `CopyComponentsFunction`: from a block entity's components, those `include` names and
// `exclude` doesn't, each set on the stack; from the tool's, the same of each component it has,
// in the order its item's and patch's give them. From an entity comes with entities.
fn copied_components(loot: Loot, params: LootParams, roll: mut Roll, stack: own Stack, m: JavaHashMap<String, Tag>) -> Stack {
    var s = stack
    let source = text_of(m, "source")
    let include: List<String>? = names_of(m, "include")
    let exclude = names_of(m, "exclude") ?? List<String>()
    var given = JavaHashMap<String, Tag>()
    if source == "block_entity" {
        let found = params.block_entity else return s
        given = found.copy()
    } else if source == "tool" {
        let tool = Stack.from(params.tool.copy()) else return s
        if params.tool == none {
            return s
        }
        let defaults = loot.items.default_components(tool.id.copy())
        for (k, v) in defaults {
            if not tool.patch.contains("!{k}") and not tool.patch.contains(k.copy()) {
                given.insert(k.copy(), v.copy())
            }
        }
        for (k, v) in tool.patch {
            if not k.starts_with("!") {
                given.insert(k.copy(), v.copy())
            }
        }
    } else {
        roll.miss("Copying components from {source}")
        return s
    }
    for (k, v) in given {
        var wanted = true
        if let only = include {
            wanted = false
            for n in only {
                if n == k {
                    wanted = true
                }
            }
        }
        for n in exclude {
            if n == k {
                wanted = false
            }
        }
        if wanted {
            s.set(loot.items, k.copy(), v.copy())
        }
    }
    return s
}

// The component names a list field of `m` gives, or none where it has none.
fn names_of(m: JavaHashMap<String, Tag>, key: str) -> List<String>? {
    if not m.contains(key) {
        return none
    }
    let Tag.List(each) = m[key] else return none
    var out = List<String>()
    for t in each {
        if let Tag.Str(s) = t {
            out.push(s.copy())
        }
    }
    return some(out)
}

// `EnchantmentHelper.getItemEnchantmentLevel`: the level of the enchantment `name` on `tool`, 0
// for none or for no tool.
fn enchantment_level(loot: Loot, tool: Tag?, name: String) -> i32 {
    let t = tool else return 0
    let found = loot.items.component(t, String("minecraft:enchantments")) else return 0
    let Tag.Compound(levels) = found else return 0
    if not levels.contains(name.copy()) {
        return 0
    }
    return levels[name].number_int() ?? 0
}

// A condition, `LootItemCondition.test`: by its ID, a named predicate, or given whole.
fn test<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, c: Tag) -> bool {
    match c {
        Tag.Str(id) => {
            let k = "predicate {id}"
            for v in roll.visited {
                if v == k {
                    return false
                }
            }
            let named = loot.entry(PREDICATES, id.copy()) else return false
            roll.visited.push(k.copy())
            let holds = test(loot, f, level, mut random, params, mut roll, named)
            _ = roll.visited.pop()
            return holds
        },
        Tag.Compound(m) => return test_typed(loot, f, level, mut random, params, mut roll, m),
        _ => return false,
    }
}

fn test_typed<R: RandomSource, B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, random: mut R, params: LootParams, roll: mut Roll, m: JavaHashMap<String, Tag>) -> bool {
    let kind = text_of(m, "type")
    if kind == "minecraft:survives_explosion" {
        let radius = params.explosion_radius else return true
        return random.next_float() <= 1.0f32 / radius
    }
    if kind == "minecraft:inverted" {
        if not m.contains("term") {
            return true
        }
        let term = m["term"].copy()
        return not test(loot, f, level, mut random, params, mut roll, term)
    }
    if kind == "minecraft:any_of" or kind == "minecraft:all_of" {
        let any = kind == "minecraft:any_of"
        if not m.contains("terms") {
            return not any
        }
        let Tag.List(terms) = m["terms"] else {
            roll.miss(String("Predicate tags in loot"))
            return false
        }
        for t in terms {
            let holds = test(loot, f, level, mut random, params, mut roll, t)
            if any and holds {
                return true
            }
            if not any and not holds {
                return false
            }
        }
        return not any
    }
    if kind == "minecraft:random_chance" {
        let p = if m.contains("chance") { float_value(loot, mut random, mut roll, m["chance"]) } else { 0.0f32 }
        return random.next_float() < p
    }
    if kind == "minecraft:table_bonus" {
        let lv = if params.has_tool { enchantment_level(loot, params.tool, text_of(m, "enchantment")) } else { 0 }
        let chances = if m.contains("chances") { m["chances"].floats() ?? List<f32>() } else { List<f32>() }
        if chances.is_empty() {
            return false
        }
        let at = usize.wrap(lv.max(0)).min(chances.len() - 1)
        return random.next_float() < chances[at]
    }
    if kind == "minecraft:match_block" {
        let state = params.state else return false
        return block_matches(f, mut roll, m, state, params.block_entity != none)
    }
    if kind == "minecraft:match_tool" {
        if not params.has_tool {
            return false
        }
        if not m.contains("predicate") {
            return true
        }
        return item_matches(loot, mut roll, m["predicate"], params.tool)
    }
    if kind == "minecraft:location_check" {
        let (x, y, z) = params.origin else return false
        if not m.contains("predicate") {
            return true
        }
        let ox = if m.contains("offsetX") { m["offsetX"].number_int() ?? 0 } else { 0 }
        let oy = if m.contains("offsetY") { m["offsetY"].number_int() ?? 0 } else { 0 }
        let oz = if m.contains("offsetZ") { m["offsetZ"].number_int() ?? 0 } else { 0 }
        return location_matches(loot, f, level, mut roll, m["predicate"], x + f64(ox), y + f64(oy), z + f64(oz))
    }
    if kind == "minecraft:entity_properties" {
        let target = text_of(m, "entity")
        let known = if target == "this" { params.this.copy() } else if target == "attacker" { params.attacker.copy() } else if target == "direct_attacker" { params.direct_attacker.copy() } else { none }
        let present = known != none or (target == "this" and params.this_entity)
        if not present {
            return false
        }
        if not m.contains("predicate") {
            return true
        }
        let Tag.Compound(p) = m["predicate"] else return false
        if p.is_empty() {
            return true
        }
        let e = known else {
            roll.miss(String("Entity predicates in loot"))
            return false
        }
        return entity_matches(loot, f, level, mut roll, p, e, params.origin)
    }
    if kind == "minecraft:killed_by_player" {
        return params.killed_by_player
    }
    if kind == "minecraft:enchantment_active_check" {
        // `EnchantmentActiveCheck` (D524): whether the location-changed effect held before, as
        // `active` asks.
        let was = params.enchantment_active else return false
        let wanted = if m.contains("active") { m["active"].number_bool() ?? false } else { false }
        return was == wanted
    }
    if kind == "minecraft:damage_source_properties" {
        // `DamageSourceCondition`, with a damage source and an origin given: its predicate's
        // `source_entity` of the entity that caused it, `direct_entity` of the one that dealt it,
        // `is_direct`, whether they're the same, and `tags`, its type's.
        if not params.damage_source or params.origin == none {
            return false
        }
        if not m.contains("predicate") {
            return true
        }
        let Tag.Compound(p) = m["predicate"] else return false
        for (key, value) in p {
            if key == "is_direct" {
                // `isDirect`, what caused it having dealt it (D438).
                if (value.number_bool() ?? false) != params.direct {
                    return false
                }
                continue
            }
            if key == "tags" {
                // `tags`, each a damage type tag, `#` and its name, its type's in or isn't,
                // `TagPredicate`, of those world.damage keeps (D439).
                let known = params.damage_tags else {
                    roll.miss(String("Damage type tags in loot"))
                    return false
                }
                let Tag.List(wanted) = value else return false
                for w in wanted {
                    let Tag.Compound(t) = w else return false
                    let written = text_of(t, "id")
                    let id = if written.starts_with("#") { written[1..].copy() } else { written.copy() }
                    let expected = if t.contains("expected") { t["expected"].number_bool() ?? false } else { false }
                    let bit = damage_tag_bit(id.copy()) else {
                        roll.miss("The damage type tag {id} in loot")
                        return false
                    }
                    if (known & bit != 0u32) != expected {
                        return false
                    }
                }
                continue
            }
            let who = if key == "source_entity" { params.attacker.copy() } else if key == "direct_entity" { params.direct_attacker.copy() } else {
                roll.miss("The damage source predicate {key} in loot")
                return false
            }
            let e = who else return false
            let Tag.Compound(q) = value else return false
            if not entity_matches(loot, f, level, mut roll, q, e, params.origin) {
                return false
            }
        }
        return true
    }
    if kind == "minecraft:random_chance_with_enchanted_bonus" {
        // By the attacker's level of the enchantment, `enchanted_chance` at it where it's above
        // 0, else `unenchanted_chance`, then a float drawn below it.
        var lv = 0
        if let a = params.attacker {
            lv = enchantment_level(loot, a.hand.copy(), text_of(m, "enchantment"))
        }
        var chance = if m.contains("unenchanted_chance") { m["unenchanted_chance"].number_float() ?? 0.0f32 } else { 0.0f32 }
        if lv > 0 {
            chance = if m.contains("enchanted_chance") { level_based(mut roll, m["enchanted_chance"], lv) } else { 0.0f32 }
        }
        return random.next_float() < chance
    }
    roll.miss("The loot condition {kind}")
    return false
}

// `EntityPredicate.matches` of what Calcite knows of the entity `e` (D416): its type,
// `minecraft:entity_type`, by name, among a list or in a tag (D438); its flags' `is_on_fire` and
// `is_baby`, and `is_on_ground` and `is_flying` (D524); what's in its main hand,
// `minecraft:equipment`; its vehicle, none; a sheep's colour, `minecraft:components`'
// `minecraft:sheep/color`; a villager's type, `minecraft:predicates`' `minecraft:villager/variant`
// (CAL-160); `minecraft:type_specific/sheep`'s `sheared` and `minecraft:type_specific/cube_mob`'s
// `size`; and its movement a second, `minecraft:movement`, the block its movement's affected by in
// `level`, `minecraft:movement_affected_by`, and its ticks, `minecraft:periodic_tick` (D524);
// and how far it is from `origin`, the context's, `minecraft:distance` (CAL-164). Anything else it
// asks is said to be missing.
fn entity_matches<B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, roll: mut Roll, p: JavaHashMap<String, Tag>, e: LootEntity, origin: (f64, f64, f64)?) -> bool {
    for (key, value) in p {
        if key == "minecraft:entity_type" {
            // `EntityTypePredicate`: an ID, a list of them or a tag, `#` and its name (D438).
            if not loot.items.entity_allowed(value.copy(), e.kind.copy()) {
                return false
            }
        } else if key == "minecraft:flags" {
            let Tag.Compound(flags) = value else return false
            for (flag, wanted) in flags {
                if flag == "is_on_fire" or flag == "is_baby" or flag == "is_on_ground" or flag == "is_flying" {
                    let has = if flag == "is_baby" { e.baby } else if flag == "is_on_ground" { e.on_ground } else if flag == "is_flying" { e.flying } else { e.on_fire }
                    if (wanted.number_bool() ?? false) != has {
                        return false
                    }
                } else {
                    roll.miss("The entity flag {flag} in loot")
                    return false
                }
            }
        } else if key == "minecraft:equipment" {
            // `EntityEquipmentPredicate`: what's in each slot it names, by `EquipmentSlot`'s
            // name, where what it wears is known (CAL-164), else only its main hand.
            let Tag.Compound(slots) = value else return false
            for (slot, wanted) in slots {
                let n = equipment_slot(slot) else {
                    roll.miss("The equipment slot {slot} in loot")
                    return false
                }
                let stack = if n < e.worn.len() { e.worn[n].copy() } else if n == 0 { e.hand.copy() } else {
                    roll.miss("The equipment slot {slot} in loot")
                    return false
                }
                if not item_matches(loot, mut roll, wanted.copy(), stack) {
                    return false
                }
            }
        } else if key == "minecraft:location" {
            // `EntityLocationPredicate`: a location predicate of where it is (CAL-164).
            let (x, y, z) = e.at else {
                roll.miss(String("Where an entity is, in loot"))
                return false
            }
            if not location_matches(loot, f, level, mut roll, value.copy(), x, y, z) {
                return false
            }
        } else if key == "minecraft:components" {
            let Tag.Compound(wanted) = value else return false
            for (name, v) in wanted {
                if name != "minecraft:sheep/color" {
                    roll.miss("The entity component {name} in loot")
                    return false
                }
                let color = e.sheep_color.copy() else return false
                let Tag.Str(c) = v else return false
                if c != color {
                    return false
                }
            }
        } else if key == "minecraft:type_specific/sheep" {
            if e.sheep_color == none {
                return false
            }
            let Tag.Compound(q) = value else return false
            if q.contains("sheared") {
                if (q["sheared"].number_bool() ?? false) != e.sheared {
                    return false
                }
            }
        } else if key == "minecraft:predicates" {
            // `DataComponentMatchers`' partial predicates of the entity's components, of which a
            // villager's type, `minecraft:villager/variant`, a set of types, is here (CAL-160).
            let Tag.Compound(wanted) = value else return false
            for (name, v) in wanted {
                if name != "minecraft:villager/variant" {
                    roll.miss("The entity component predicate {name} in loot")
                    return false
                }
                let kind = e.villager_type.copy() else return false
                let n = loot.items.builtin_id("villager_type", kind) ?? -1
                if not loot.items.holder_set_has("villager_type", v.copy(), n) {
                    return false
                }
            }
        } else if key == "minecraft:vehicle" {
            // `getVehicle`, none, which no predicate matches.
            return false
        } else if key == "minecraft:movement" {
            // `MovementPredicate`, of its known movement a second, `getKnownMovement` by 20: each
            // way's, its speed's and its speed across's squares, its speed up or down, and its
            // fall (D524).
            let Tag.Compound(q) = value else return false
            let (x, y, z) = (e.moved_x * 20.0, e.moved_y * 20.0, e.moved_z * 20.0)
            for (k, b) in q {
                let holds = if k == "x" { doubles_match(b, x) } else if k == "y" { doubles_match(b, y) } else if k == "z" { doubles_match(b, z) } else if k == "speed" { doubles_match_sqr(b, x * x + y * y + z * z) } else if k == "horizontal_speed" { doubles_match_sqr(b, x * x + z * z) } else if k == "vertical_speed" { doubles_match(b, y.abs()) } else if k == "fall_distance" { doubles_match(b, e.fall_distance) } else {
                    roll.miss("The movement predicate {k} in loot")
                    false
                }
                if not holds {
                    return false
                }
            }
        } else if key == "minecraft:distance" {
            // `DistanceToPlayerPredicate`: a `DistancePredicate` from the origin to where it is,
            // never where there's no origin (CAL-164).
            let (x0, y0, z0) = origin else return false
            let (x, y, z) = e.at else {
                roll.miss(String("Where an entity is, in loot"))
                return false
            }
            if not distance_holds(value.copy(), x0, y0, z0, x, y, z) {
                return false
            }
        } else if key == "minecraft:movement_affected_by" {
            // `MovementAffectedByPredicate`: a location predicate of the middle of the block its
            // movement's affected by (D524).
            let (bx, by, bz) = e.affected_by else return false
            if not location_matches(loot, f, level, mut roll, value.copy(), f64(bx) + 0.5, f64(by) + 0.5, f64(bz) + 0.5) {
                return false
            }
        } else if key == "minecraft:periodic_tick" {
            // `PeriodicEntityTickPredicate`: every so many of its ticks (D524).
            let n = value.number_int() ?? 1
            if n == 0 or e.tick_count % n != 0 {
                return false
            }
        } else if key == "minecraft:type_specific/cube_mob" {
            if e.cube_size < 0 {
                return false
            }
            let Tag.Compound(q) = value else return false
            if q.contains("size") {
                if not bounds_match(q["size"], e.cube_size) {
                    return false
                }
            }
        } else {
            roll.miss("The entity predicate {key} in loot")
            return false
        }
    }
    return true
}

// `LevelBasedValue.calculate(lv)`: a constant, a number or `constant`'s `value`; `linear`, `base`
// and `per_level_above_first` for each level past the first; and, as frost walker's radius has
// one, `clamped`, `fraction`, 0 over a denominator of 0, `levels_squared`, `exponent`,
// `Math.pow` in doubles made a float, and `lookup`, its fallback past its values (D524); anything
// else said to be missing.
fn level_based(roll: mut Roll, v: Tag, lv: i32) -> f32 {
    if let n = v.number_float() {
        return n
    }
    let Tag.Compound(m) = v else return 0.0f32
    let kind = text_of(m, "type")
    if kind == "minecraft:constant" {
        return float_field(m, "value")
    }
    if kind == "minecraft:linear" {
        return float_field(m, "base") + float_field(m, "per_level_above_first") * f32.nearest(f64(lv - 1))
    }
    if kind == "minecraft:clamped" {
        let value = level_field(mut roll, m, "value", lv)
        let low = float_field(m, "min")
        if value < low {
            return low
        }
        return value.min(float_field(m, "max"))
    }
    if kind == "minecraft:fraction" {
        let denominator = level_field(mut roll, m, "denominator", lv)
        if denominator == 0.0f32 {
            return 0.0f32
        }
        return level_field(mut roll, m, "numerator", lv) / denominator
    }
    if kind == "minecraft:levels_squared" {
        return f32.nearest(f64(lv.wrapping_mul(lv))) + float_field(m, "added")
    }
    if kind == "minecraft:exponent" {
        let base = level_field(mut roll, m, "base", lv)
        return f32.nearest(pow(f64(base), f64(level_field(mut roll, m, "power", lv))))
    }
    if kind == "minecraft:lookup" {
        if lv >= 1 and m.contains("values") {
            if let Tag.List(values) = m["values"] {
                if usize.wrap(lv) <= values.len() {
                    return values[usize.wrap(lv - 1)].number_float() ?? 0.0f32
                }
            }
        }
        return level_field(mut roll, m, "fallback", lv)
    }
    roll.miss("The level based value {kind}")
    return 0.0f32
}

/// `FloatProvider.sample` of `t` from `random`, as `FloatProviders.CODEC` writes it (D525): a
/// number or `constant`'s `value`; `uniform`, `Mth.randomBetween`; `clamped_normal`, a gaussian
/// draw about its mean, clamped; and `trapezoid`, two floats. Anything else is 0.
pub fn float_sample<R: RandomSource>(random: mut R, t: Tag) -> f32 {
    if let n = t.number_float() {
        return n
    }
    let Tag.Compound(m) = t else return 0.0f32
    let kind = text_of(m, "type")
    if kind == "minecraft:constant" {
        return float_field(m, "value")
    }
    if kind == "minecraft:uniform" {
        let low = float_field(m, "min_inclusive")
        return random.next_float() * (float_field(m, "max_exclusive") - low) + low
    }
    if kind == "minecraft:clamped_normal" {
        let value = float_field(m, "mean") + f32.nearest(random.next_gaussian()) * float_field(m, "deviation")
        let low = float_field(m, "min")
        if value < low {
            return low
        }
        return value.min(float_field(m, "max"))
    }
    if kind == "minecraft:trapezoid" {
        let low = float_field(m, "min")
        let range = float_field(m, "max") - low
        let start = (range - float_field(m, "plateau")) / 2.0f32
        let end = range - start
        let a = random.next_float() * end
        return low + a + random.next_float() * start
    }
    return 0.0f32
}

// The float `key` of `m`, 0 where it hasn't one (D524).
fn float_field(m: JavaHashMap<String, Tag>, key: str) -> f32 {
    if not m.contains(key) {
        return 0.0f32
    }
    return m[key].number_float() ?? 0.0f32
}

// The level-based value `key` of `m` at the level `lv`, 0 where it hasn't one (D524).
fn level_field(roll: mut Roll, m: JavaHashMap<String, Tag>, key: str, lv: i32) -> f32 {
    if not m.contains(key) {
        return 0.0f32
    }
    return level_based(mut roll, m[key].copy(), lv)
}

// `BlockPredicate.matchesState`, with `matchesBlockEntity` said to be missing where it asks
// for data or components: whether `state`'s block is among `blocks` and its properties match
// `state`'s.
fn block_matches(f: Facts, roll: mut Roll, m: JavaHashMap<String, Tag>, state: u32, has_entity: bool) -> bool {
    if m.contains("blocks") {
        if not block_in(f, m["blocks"], state) {
            return false
        }
    }
    if m.contains("state") {
        if not properties_match(f, m["state"], state) {
            return false
        }
    }
    if m.contains("nbt") or m.contains("components") or m.contains("predicates") {
        roll.miss(String("Block entity data in block predicates"))
        return false
    }
    _ = has_entity
    return true
}

// Whether `state`'s block is in `set`, a block `HolderSet`: an ID, a tag, or a list.
fn block_in(f: Facts, set: Tag, state: u32) -> bool {
    match set {
        Tag.Str(s) => {
            if s.starts_with("#") {
                let tag = f.find_tag(s[1..].copy()) else return false
                return f.in_set(state, tag)
            }
            let b = f.block_named(s.copy()) else return false
            return f.block(state) == b
        },
        Tag.List(each) => {
            for one in each {
                if block_in(f, one, state) {
                    return true
                }
            }
            return false
        },
        _ => return false,
    }
}

// `StatePropertiesPredicate.matches`: each named property of `state`'s block, which it must have,
// its value the one given, or within `min` and `max`, as the property's values compare.
fn properties_match(f: Facts, given: Tag, state: u32) -> bool {
    let Tag.Compound(m) = given else return true
    for (name, want) in m {
        let p = f.prop(state, name.copy()) else return false
        let have = p.get(state)
        match want {
            Tag.Str(v) => {
                let at = f.codec.value_of(p, v.copy()) else return false
                if at != have {
                    return false
                }
            },
            Tag.Compound(range) => {
                if range.contains("min") {
                    let Tag.Str(v) = range["min"] else return false
                    let at = f.codec.value_of(p, v.copy()) else return false
                    if f.codec.compare(p, have, at) < 0 {
                        return false
                    }
                }
                if range.contains("max") {
                    let Tag.Str(v) = range["max"] else return false
                    let at = f.codec.value_of(p, v.copy()) else return false
                    if f.codec.compare(p, have, at) > 0 {
                        return false
                    }
                }
            },
            _ => return false,
        }
    }
    return true
}

/// `EnterBlockTrigger.TriggerInstance.matches` of `state` (CAL-164): its block in `blocks`, a
/// block `HolderSet`, where that's given, and the properties `wanted` holding of it, as
/// `StatePropertiesPredicate` has them, where they're given.
pub fn state_holds(f: Facts, blocks: Tag, wanted: Tag, state: u32) -> bool {
    if blocks != Tag.End and not block_in(f, blocks, state) {
        return false
    }
    return wanted == Tag.End or properties_match(f, wanted, state)
}

// The slot of `EquipmentSlot`'s order an equipment predicate names, `EntityEquipmentPredicate`'s
// fields, `none` for another (CAL-164).
fn equipment_slot(name: String) -> usize? {
    var i: usize = 0
    for each in ["mainhand", "offhand", "feet", "legs", "chest", "head", "body"] {
        if name == String(each) {
            return some(i)
        }
        i += 1
    }
    return none
}

// `LocationPredicate.matches` at x, y, z, in its order (CAL-164): `position`, each way's bounds;
// `dimension`, the level's; then, at the block there, `biomes`, holding the biome there, loaded;
// `light`, the light there, `getMaxLocalRawBrightness`, loaded; `block`, the block there, loaded,
// as `BlockPredicate.matches` reads it; and `can_see_sky`, the sky's light there 15. Its
// `structures`, `smokey` and `fluid` are said to be missing where they're asked.
fn location_matches<B: BlockAccess + BlockLevel>(loot: Loot, f: Facts, level: B, roll: mut Roll, given: Tag, x: f64, y: f64, z: f64) -> bool {
    let Tag.Compound(m) = given else return false
    for (k, _) in m {
        if k != "block" and k != "position" and k != "dimension" and k != "biomes" and k != "light" and k != "can_see_sky" and k != "structures" and k != "smokey" and k != "fluid" {
            roll.miss("The location predicate's {k}")
            return false
        }
    }
    if m.contains("position") {
        let Tag.Compound(p) = m["position"] else return false
        for (k, v) in [("x", x), ("y", y), ("z", z)] {
            if p.contains(k) and not doubles_match(p[k], v) {
                return false
            }
        }
    }
    if m.contains("dimension") and m["dimension"] != Tag.Str(level.dimension_key()) {
        return false
    }
    let bx = i32.saturate(x.floor())
    let by = i32.saturate(y.floor())
    let bz = i32.saturate(z.floor())
    let loaded = level.is_loaded(bx, by, bz)
    if m.contains("biomes") {
        if not loaded or not loot.items.synced_set_has("worldgen/biome", m["biomes"], level.biome_at(bx, by, bz)) {
            return false
        }
    }
    for k in ["structures", "smokey"] {
        if m.contains(k) {
            if not loaded {
                return false
            }
            roll.miss("The location predicate's {k}")
            return false
        }
    }
    if m.contains("light") {
        let Tag.Compound(l) = m["light"] else return false
        if not loaded {
            return false
        }
        if l.contains("light") and not bounds_match(l["light"], level.local_brightness(bx, by, bz)) {
            return false
        }
    }
    if m.contains("block") {
        if not loaded or not block_holds(f, level, mut roll, m["block"], bx, by, bz) {
            return false
        }
    }
    if m.contains("fluid") {
        roll.miss(String("The location predicate's fluid"))
        return false
    }
    if m.contains("can_see_sky") {
        let wanted = m["can_see_sky"].number_bool() ?? false
        if wanted != (level.sky_light(bx, by, bz) >= 15) {
            return false
        }
    }
    return true
}

// `BlockPredicate.matches` of the block at x, y, z, loaded, as it reads it.
fn block_holds<B: BlockAccess + BlockLevel>(f: Facts, level: B, roll: mut Roll, given: Tag, bx: i32, by: i32, bz: i32) -> bool {
    let state = match level.state(f, bx, by, bz) {
        ok(s) => s,
        err(e) => {
            roll.miss(e.message.copy())
            return false
        },
    }
    let Tag.Compound(b) = given else return false
    return block_matches(f, mut roll, b, state, level.block_entity_tag(bx, by, bz) != none)
}

// `ItemPredicate.test` of `stack`, `none` for `ItemStack.EMPTY`: its item among `items`, its
// count within `count`, its components exactly `components`, and `predicates` holding, of which
// `enchantments` and `stored_enchantments` are here.
fn item_matches(loot: Loot, roll: mut Roll, given: Tag, stack: Tag?) -> bool {
    let Tag.Compound(m) = given else return false
    let s = Stack.from(stack.copy()) ?? Stack { id: String("minecraft:air"), count: 0, patch: JavaHashMap<String, Tag>() }
    if m.contains("items") {
        let id = loot.items.builtin_id("item", if s.empty() { String("minecraft:air") } else { s.id.copy() }) ?? -1
        if not loot.items.holder_set_has("item", m["items"], id) {
            return false
        }
    }
    if m.contains("count") {
        if not bounds_match(m["count"], if s.empty() { 0 } else { s.count }) {
            return false
        }
    }
    if m.contains("components") {
        if let Tag.Compound(exact) = m["components"] {
            for (k, v) in exact {
                if s.empty() {
                    return false
                }
                if s.component(loot.items, k.copy()) != some(v.copy()) {
                    return false
                }
            }
        }
    }
    if m.contains("predicates") {
        if let Tag.Compound(partial) = m["predicates"] {
            for (k, v) in partial {
                if k != "minecraft:enchantments" and k != "minecraft:stored_enchantments" {
                    // `DataComponentPredicate.Type`'s codec: a predicate type of its name, of
                    // which only the enchantments are here; else a component's, `AnyValue`,
                    // which holds where the item has it (D523).
                    if loot.items.builtin_id("data_component_predicate_type", k.copy()) != none or loot.items.builtin_id("data_component_type", k.copy()) == none {
                        roll.miss("The item predicate {k}")
                        return false
                    }
                    if s.empty() or s.component(loot.items, k.copy()) == none {
                        return false
                    }
                    continue
                }
                if s.empty() {
                    return false
                }
                let found = s.component(loot.items, k.copy()) else return false
                let Tag.Compound(levels) = found else return false
                let Tag.List(each) = v else return false
                for p in each {
                    if not enchantment_matches(loot, p, levels) {
                        return false
                    }
                }
            }
        }
    }
    return true
}

// `EnchantmentPredicate.containedIn`: of `levels`, the item's enchantments, one of those named at
// a level within `levels`' bounds; any at such a level where none are named; or any at all.
fn enchantment_matches(loot: Loot, p: Tag, levels: JavaHashMap<String, Tag>) -> bool {
    let Tag.Compound(m) = p else return false
    let bounds: Tag? = if m.contains("levels") { some(m["levels"].copy()) } else { none }
    if m.contains("enchantments") {
        for (name, lv) in levels {
            if not loot.enchantment_in(m["enchantments"], name.copy()) {
                continue
            }
            let n = lv.number_int() ?? 0
            if n == 0 {
                continue
            }
            match bounds {
                some(b) => if bounds_match(b, n) {
                    return true
                },
                none => return true,
            }
        }
        return false
    }
    if let b = bounds {
        for (_, lv) in levels {
            if bounds_match(b, lv.number_int() ?? 0) {
                return true
            }
        }
        return false
    }
    return not levels.is_empty()
}

/// `MinMaxBounds.Ints.matches` of `n`: the range `b`, as its codec wrote it, holds it; any
/// range for `Tag.End`, a range left out (CAL-164).
pub fn ints_hold(b: Tag, n: i32) -> bool {
    if b == Tag.End {
        return true
    }
    return bounds_match(b, n)
}

// `MinMaxBounds.Ints.matches`: a number exactly, or `min` and `max`, each optional.
fn bounds_match(b: Tag, n: i32) -> bool {
    match b {
        Tag.Compound(m) => {
            if m.contains("min") {
                if (m["min"].number_int() ?? i32.MIN) > n {
                    return false
                }
            }
            if m.contains("max") {
                if (m["max"].number_int() ?? i32.MAX) < n {
                    return false
                }
            }
            return true
        },
        other => return (other.number_int() ?? n) == n,
    }
}

/// `ContextIntProvider.getInt` of `t` (D523), as a loot table writes one, from `random`, with
/// what it uses that Calcite hasn't in `missing`.
pub fn context_int<R: RandomSource>(loot: Loot, random: mut R, t: Tag, missing: mut List<String>) -> i32 {
    var roll = Roll { missing: List<String>(), visited: List<String>() }
    let v = int_value(loot, mut random, mut roll, t)
    for m in roll.missing {
        missing.push(m.copy())
    }
    return v
}

// `ContextIntProvider.getInt`: `getIntUnsafe`, 0 where anything in it overflows (D523).
fn int_value<R: RandomSource>(loot: Loot, random: mut R, roll: mut Roll, t: Tag) -> i32 {
    return int_unsafe(loot, mut random, mut roll, t) ?? 0
}

// `ContextIntProvider.getIntUnsafe`: a constant, a named provider, or one given whole, of which
// `constant`, `uniform` and `binomial` are here, and the arithmetic `add`, `sub`, `mul`, `min`,
// `max`, `negate` and `abs` (D523), each of its inputs in turn; none where one overflows an int,
// `ArithmeticException`.
fn int_unsafe<R: RandomSource>(loot: Loot, random: mut R, roll: mut Roll, t: Tag) -> i32? {
    match t {
        Tag.Str(id) => {
            let named = loot.entry(INTS, id.copy()) else return some(0)
            return int_unsafe(loot, mut random, mut roll, named)
        },
        Tag.Compound(m) => {
            let kind = text_of(m, "type")
            if kind == "minecraft:constant" {
                return some(if m.contains("value") { m["value"].number_int() ?? 0 } else { 0 })
            }
            if kind == "minecraft:uniform" {
                let low = int_field(loot, mut random, mut roll, m, "min") else return none
                let high = int_field(loot, mut random, mut roll, m, "max") else return none
                // `Mth.nextInt`, which draws nothing where the range is one number or none.
                if low >= high {
                    return some(low)
                }
                return some(random.next_int_below(high - low + 1) + low)
            }
            if kind == "minecraft:add" or kind == "minecraft:mul" or kind == "minecraft:min" or kind == "minecraft:max" {
                // `Sum` and `Product` in a long, then back to an int; `Minimum` and `Maximum` from
                // the int's most and least.
                var total: i64 = if kind == "minecraft:add" { 0 } else if kind == "minecraft:mul" { 1 } else if kind == "minecraft:min" { i64(i32.MAX) } else { i64(i32.MIN) }
                if m.contains("inputs") {
                    if let Tag.List(inputs) = m["inputs"].copy() {
                        for input in inputs {
                            let v = int_unsafe(loot, mut random, mut roll, input) else return none
                            if kind == "minecraft:add" {
                                total = total.wrapping_add(i64(v))
                            } else if kind == "minecraft:mul" {
                                total = total.wrapping_mul(i64(v))
                            } else if kind == "minecraft:min" {
                                total = total.min(i64(v))
                            } else {
                                total = total.max(i64(v))
                            }
                        }
                    }
                }
                if total < i64(i32.MIN) or total > i64(i32.MAX) {
                    return none
                }
                return some(i32.wrap(total))
            }
            if kind == "minecraft:sub" {
                // `Difference`, `Math.subtractExact`.
                let left = int_field(loot, mut random, mut roll, m, "left") else return none
                let right = int_field(loot, mut random, mut roll, m, "right") else return none
                let d = i64(left) - i64(right)
                if d < i64(i32.MIN) or d > i64(i32.MAX) {
                    return none
                }
                return some(i32.wrap(d))
            }
            if kind == "minecraft:negate" or kind == "minecraft:abs" {
                // `Negate` and `Absolute`, `negateExact` and `absExact`, which the int's least
                // overflows.
                let v = int_field(loot, mut random, mut roll, m, "input") else return none
                if v == i32.MIN {
                    return none
                }
                return some(if kind == "minecraft:negate" or v < 0 { -v } else { v })
            }
            if kind == "minecraft:binomial" {
                let n = int_field(loot, mut random, mut roll, m, "n") else return none
                let p = if m.contains("p") { float_value(loot, mut random, mut roll, m["p"]) } else { 0.0f32 }
                var got = 0
                var i = 0
                while i < n {
                    i += 1
                    if random.next_float() < p {
                        got += 1
                    }
                }
                return some(got)
            }
            if kind == "minecraft:enchantment_level" {
                // `NumberProvider.getInt`, `Math.round` of its float.
                return some(i32.saturate((f64(float_value(loot, mut random, mut roll, Tag.Compound(m.copy()))) + 0.5).floor()))
            }
            roll.miss("The number provider {kind}")
            return some(0)
        },
        other => return some(other.number_int() ?? 0),
    }
}

// The int provider `key` of `m` worked out, `int_unsafe`, 0 where there's none (D523).
fn int_field<R: RandomSource>(loot: Loot, random: mut R, roll: mut Roll, m: JavaHashMap<String, Tag>, key: str) -> i32? {
    if not m.contains(key) {
        return some(0)
    }
    return int_unsafe(loot, mut random, mut roll, m[key])
}

// `ContextFloatProvider.getFloat`: a constant, a named provider, or one given whole, of which
// `constant` and `uniform` are here, and `enchantment_level`, its `amount` at the level of the
// enchantment the roll tests, `EnchantmentLevelProvider` (D442); 0 for one that isn't finite.
fn float_value<R: RandomSource>(loot: Loot, random: mut R, roll: mut Roll, t: Tag) -> f32 {
    let v = match t {
        Tag.Str(id) => {
            let named = loot.entry(FLOATS, id.copy()) else return 0.0f32
            float_value(loot, mut random, mut roll, named)
        },
        Tag.Compound(m) => {
            let kind = text_of(m, "type")
            if kind == "minecraft:constant" {
                if m.contains("value") { m["value"].number_float() ?? 0.0f32 } else { 0.0f32 }
            } else if kind == "minecraft:uniform" {
                let low = if m.contains("min") { float_value(loot, mut random, mut roll, m["min"]) } else { 0.0f32 }
                let high = if m.contains("max") { float_value(loot, mut random, mut roll, m["max"]) } else { 0.0f32 }
                // `Mth.nextFloat`, which draws nothing where the range is one number or none.
                if low >= high { low } else { random.next_float() * (high - low) + low }
            } else if kind == "minecraft:enchantment_level" and roll.enchanted_at != none {
                let lv = roll.enchanted_at ?? 0
                if m.contains("amount") { level_based(mut roll, m["amount"].copy(), lv) } else { 0.0f32 }
            } else {
                roll.miss("The number provider {kind}")
                0.0f32
            }
        },
        other => other.number_float() ?? 0.0f32,
    }
    if v != v or v == f32.INFINITY or v == -f32.INFINITY {
        return 0.0f32
    }
    return v
}

// `Mth.floor` of a float.
fn floor_f32(v: f32) -> i32 {
    let i = i32.saturate(v)
    return if v < f32.nearest(i) { i - 1 } else { i }
}

// The string field `key` of `m`, empty where it isn't one.
fn text_of(m: JavaHashMap<String, Tag>, key: str) -> String {
    if not m.contains(key) {
        return String()
    }
    return match m[key] {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}
