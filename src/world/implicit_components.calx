/// What a block entity takes of the item it's placed from (CAL-399), as `BlockItem.place` gives
/// it: the item's `block_entity_data` merged onto what it saves, `updateCustomBlockEntityTag`, then
/// each component its kind reads, `applyImplicitComponents`, in place of what it saves for it, and
/// the rest kept as its `components`, `BlockEntity.applyComponents`.
module world.implicit_components

import nbt.tag.{Tag, merge_compound}

/// The types whose `block_entity_data` only an operator may set, `OP_ONLY_CUSTOM_DATA`.
pub fn op_only(kind: String) -> bool {
    return kind == "minecraft:command_block" or kind == "minecraft:lectern" or kind == "minecraft:sign" or kind == "minecraft:hanging_sign" or kind == "minecraft:mob_spawner" or kind == "minecraft:trial_spawner"
}

/// What the block entity of the type `kind`, saving `saved`, saves once it's taken the item's
/// `components` (CAL-399). Its `block_entity_data` first, where it's of this type and, for an
/// operator's type, `op`: merged onto what it saves but its place and type, `TypedEntityData.loadInto`.
/// Then what its kind reads, `applyImplicitComponents`: each component it asks for, there or not,
/// counted as read; and the item's other components, but those it removes, its `components`.
pub fn with_item_components(kind: String, saved: JavaHashMap<String, Tag>, components: JavaHashMap<String, Tag>, op: bool) -> JavaHashMap<String, Tag> {
    var out = saved.copy()
    if components.contains("minecraft:block_entity_data") {
        if let Tag.Compound(data) = components["minecraft:block_entity_data"] {
            let typed = data.contains("id") and data["id"] == Tag.Str(kind.copy())
            if typed and (op or not op_only(kind.copy())) {
                var extra = data.copy()
                _ = extra.remove("id")
                merge_compound(mut out, extra)
            }
        }
    }
    var read = List<String>()
    read.push(String("minecraft:block_entity_data"))
    read.push(String("minecraft:block_state"))
    let k = kind.copy()
    let size = container_size(k.copy())
    if size > 0 {
        // `BaseContainerBlockEntity`: its name, its lock and its items.
        named(mut out, components, mut read, "CustomName")
        set_or_drop(mut out, components, mut read, "minecraft:lock", "lock")
        out.insert(String("Items"), Tag.List(container_items(components, size)))
        read.push(String("minecraft:container"))
        if randomizable(k.copy()) {
            // `RandomizableContainerBlockEntity`: its loot table and seed, where it has them.
            read.push(String("minecraft:container_loot"))
            if components.contains("minecraft:container_loot") {
                if let Tag.Compound(loot) = components["minecraft:container_loot"] {
                    if loot.contains("loot_table") {
                        out.insert(String("LootTable"), loot["loot_table"].copy())
                    }
                    if loot.contains("seed") {
                        out.insert(String("LootTableSeed"), loot["seed"].copy())
                    } else {
                        _ = out.remove("LootTableSeed")
                    }
                }
            }
        }
    } else if k == "minecraft:banner" {
        set_or_drop(mut out, components, mut read, "minecraft:banner_patterns", "patterns")
        named(mut out, components, mut read, "CustomName")
    } else if k == "minecraft:beacon" {
        named(mut out, components, mut read, "CustomName")
        set_or_drop(mut out, components, mut read, "minecraft:lock", "lock")
    } else if k == "minecraft:beehive" {
        read.push(String("minecraft:bees"))
        let bees = if components.contains("minecraft:bees") { components["minecraft:bees"].copy() } else { Tag.List(List<Tag>()) }
        out.insert(String("bees"), bees)
    } else if k == "minecraft:campfire" {
        out.insert(String("Items"), Tag.List(container_items(components, 4)))
        read.push(String("minecraft:container"))
    } else if k == "minecraft:chiseled_bookshelf" {
        out.insert(String("Items"), Tag.List(container_items(components, 6)))
        read.push(String("minecraft:container"))
    } else if k == "minecraft:shelf" {
        out.insert(String("Items"), Tag.List(container_items(components, 3)))
        read.push(String("minecraft:container"))
    } else if k == "minecraft:command_block" {
        named(mut out, components, mut read, "CustomName")
    } else if k == "minecraft:decorated_pot" {
        set_or_drop(mut out, components, mut read, "minecraft:pot_decorations", "sherds")
        // Its item, the first of the contents, `copyOne`.
        read.push(String("minecraft:container"))
        _ = out.remove("item")
        for t in container_items(components, 1) {
            if let Tag.Compound(m) = t {
                var item = m.copy()
                _ = item.remove("Slot")
                out.insert(String("item"), Tag.Compound(item))
            }
        }
    } else if k == "minecraft:enchanting_table" {
        named(mut out, components, mut read, "CustomName")
    } else if k == "minecraft:sign" or k == "minecraft:hanging_sign" {
        for (component, key) in [("minecraft:sign_text_front", "front_text"), ("minecraft:sign_text_back", "back_text")] {
            read.push(String(component))
            if components.contains(component) {
                out.insert(String(key), components[component].copy())
            }
        }
        read.push(String("minecraft:waxed"))
        out.insert(String("is_waxed"), Tag.Byte(if components.contains("minecraft:waxed") { 1i8 } else { 0i8 }))
    } else if k == "minecraft:skull" {
        set_or_drop(mut out, components, mut read, "minecraft:profile", "profile")
        set_or_drop(mut out, components, mut read, "minecraft:note_block_sound", "note_block_sound")
        set_or_drop(mut out, components, mut read, "minecraft:custom_name", "custom_name")
    }
    // What it didn't read, as the item added them, `patch.forget(...).split().added()`.
    var kept = JavaHashMap<String, Tag>()
    for (key, value) in components {
        if key.starts_with("!") or read.contains(key.copy()) {
            continue
        }
        kept.insert(key.copy(), value.copy())
    }
    out.insert(String("components"), Tag.Compound(kept))
    return out
}

// The item's custom name as the block entity's `key`, or none.
fn named(out: mut JavaHashMap<String, Tag>, components: JavaHashMap<String, Tag>, read: mut List<String>, key: str) {
    set_or_drop(mut out, components, mut read, "minecraft:custom_name", key)
}

// The component `component` as the field `key` where the item has it, else no `key`; read.
fn set_or_drop(out: mut JavaHashMap<String, Tag>, components: JavaHashMap<String, Tag>, read: mut List<String>, component: str, key: str) {
    read.push(String(component))
    if components.contains(component) {
        out.insert(String(key), components[component].copy())
    } else {
        _ = out.remove(key)
    }
}

// `ItemContainerContents.copyInto` a container of `size` slots, as it saves them, `Items`: each
// of the item's `container` within it, by its slot.
fn container_items(components: JavaHashMap<String, Tag>, size: i32) -> List<Tag> {
    var out = List<Tag>()
    if not components.contains("minecraft:container") {
        return out
    }
    let Tag.List(entries) = components["minecraft:container"] else return out
    for e in entries {
        let Tag.Compound(m) = e else continue
        let slot = match if m.contains("slot") { m["slot"].copy() } else { Tag.End } {
            Tag.Int(n) => n,
            _ => -1,
        }
        if slot < 0 or slot >= size or not m.contains("item") {
            continue
        }
        let Tag.Compound(item) = m["item"] else continue
        var saved = item.copy()
        saved.insert(String("Slot"), Tag.Byte(i8.wrap(slot)))
        out.push(Tag.Compound(saved))
    }
    return out
}

// The slots of a `BaseContainerBlockEntity` of the type `kind`, or 0 for one that isn't.
fn container_size(kind: String) -> i32 {
    if kind == "minecraft:chest" or kind == "minecraft:trapped_chest" or kind == "minecraft:barrel" or kind == "minecraft:shulker_box" {
        return 27
    }
    if kind == "minecraft:dispenser" or kind == "minecraft:dropper" or kind == "minecraft:crafter" {
        return 9
    }
    if kind == "minecraft:hopper" or kind == "minecraft:brewing_stand" {
        return 5
    }
    if kind == "minecraft:furnace" or kind == "minecraft:blast_furnace" or kind == "minecraft:smoker" {
        return 3
    }
    return 0
}

// Whether the container type `kind` is a `RandomizableContainerBlockEntity`.
fn randomizable(kind: String) -> bool {
    return kind == "minecraft:chest" or kind == "minecraft:trapped_chest" or kind == "minecraft:barrel" or kind == "minecraft:shulker_box" or kind == "minecraft:dispenser" or kind == "minecraft:dropper" or kind == "minecraft:hopper" or kind == "minecraft:crafter"
}
