/// An experience orb, as vanilla's `ExperienceOrb` makes and runs it (CAL-154): made with its
/// random's UUID, a spin and a motion up to 0.2 across either way and up to 0.4 up; then each tick
/// as `ServerLevel.tickNonPassenger` and `ExperienceOrb.tick` run it. With its eyes in water it's
/// held up and slowed, else it falls 0.03 a tick unless it's in a block; in lava it jumps about;
/// every 20 ticks it looks for orbs of its value to take in, `scanForMerges`; it follows the
/// nearest player within 8 blocks who isn't a spectator or dead, faster the nearer; stuck in a
/// block with nowhere to go, it's pushed out the nearest way; it moves as every entity does,
/// `world.body`, slowed by the air and the block it's on, all three ways, and bounces off what it
/// lands on at 0.4 of its fall; and it's gone after 6000 ticks.
///
/// What blocks do to it, `applyEffectsFromBlocks`, as fire and lava burning it, and its being hurt,
/// aren't in Calcite yet, as an item's aren't; nor is `unstuckIfPossible`, where it's made inside a
/// block.
///
/// It's saved as `saveAsPassenger` saves it, `saved`, and loaded as `EntityType.create` makes one
/// and `load` reads it in, `loaded`.
module world.experience_orb

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, BodyFacts, EntitySound, int_or, short_or}
import world.collision.{Aabb, CollisionBlocks}
import world.movement.{Mover, MovementStates, moved}
import worldgen.facts.{Facts}

/// How many ticks an orb lasts, `LIFETIME`.
pub const ORB_LIFETIME: i32 = 6000

/// A player an orb may follow, as `getNearestPlayer` and `followNearbyPlayer` see them: their
/// entity ID, where they are, their eyes' height, and whether they're a spectator or dead. And as
/// a mob pushing them sees them (CAL-156): their box by their pose, where they may be pushed,
/// `isPushable`, and none where they may not.
pub struct Follower {
    pub id: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub eyes: f32
    pub spectator: bool
    pub dead: bool
    pub pushable: Aabb? = none
    /// Whether it's holding its sneak key, `isDiscrete`, which mobs see it less for (CAL-158).
    pub discrete: bool = false
}

/// An experience orb.
pub struct ExperienceOrb {
    /// What every entity has, `world.body`'s: 0.5 by 0.5, its eyes 0.85 of that up, falling 0.03.
    pub body: Body
    /// How much experience it's worth, `DATA_VALUE`, and how many orbs of it it is.
    pub value: i32
    /// Whether its value is to be sent, `isDirty`: set by `setValue` as it's made or read where
    /// it isn't 0, the default, and sent by its tracker's next run.
    pub value_changed: bool = false
    pub count: i32 = 1
    pub age: i32 = 0
    pub health: i32 = 5
    /// The player it follows, by entity ID.
    pub following: i32? = none
    /// Whether it's due to look for orbs to take in this tick.
    pub merge_due: bool = false
    // Whether it was in a block as its tick began, which it moves by.
    colliding: bool = false
}

impl ExperienceOrb {
    /// An orb worth `value` at x, y, z, with its own random seeded `seed`, as `new ExperienceOrb(
    /// level, pos, Vec3.ZERO, value)` makes one: its UUID, then its spin, then its motion. With no
    /// direction to go in it's made where it's asked to be.
    pub fn new(id: i32, seed: i64, x: f64, y: f64, z: f64, value: i32) -> ExperienceOrb {
        var o = ExperienceOrb.made(id, seed, x, y, z, value)
        o.body.y_rot = o.body.random.next_float() * 360.0f32
        let a = o.body.random.next_double()
        let b = o.body.random.next_double()
        let c = o.body.random.next_double()
        o.body.vx = (a * 0.2 - 0.1) * 2.0
        o.body.vy = b * 0.2 * 2.0
        o.body.vz = (c * 0.2 - 0.1) * 2.0
        return o
    }

    // `Entity`'s fields, its random first, then its UUID.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, value: i32) -> ExperienceOrb {
        let body = Body.made(id, seed, x, y, z, 0.5f32, 0.5f32, 0.5f32 * 0.85f32, 0.03)
        return ExperienceOrb { body: body, value: value, value_changed: value != 0 }
    }

    /// What `saveAsPassenger` saves of it, in the order vanilla puts it: its type and what every
    /// entity saves, `world.body`'s; then its health, age and value as shorts, and its count.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:experience_orb")
        t.insert(String("Health"), Tag.Short(i16.wrap(self.health)))
        t.insert(String("Age"), Tag.Short(i16.wrap(self.age)))
        t.insert(String("Value"), Tag.Short(i16.wrap(self.value)))
        t.insert(String("Count"), Tag.Int(self.count))
        return Tag.Compound(t)
    }

    /// The orb `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `Entity.load` and `readAdditionalSaveData` read it in: what every entity
    /// reads, `world.body`'s; its health, age and value, as shorts, with vanilla's defaults, and its
    /// count where it's a positive int, else 1. `none` where it's somewhere that isn't a number,
    /// which vanilla's load throws on, logged in `lines` as `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> ExperienceOrb? {
        var o = ExperienceOrb.made(id, seed, 0.0, 0.0, 0.0, 0)
        if not o.body.load_from(tag, mut lines) {
            return none
        }
        o.health = i32(short_or(tag, "Health", 5i16))
        o.age = i32(short_or(tag, "Age", 0i16))
        o.value = i32(short_or(tag, "Value", 0i16))
        o.value_changed = o.value != 0
        let count = int_or(tag, "Count", 1)
        o.count = if count > 0 { count } else { 1 }
        return some(o)
    }

    /// The first part of its tick, up to where it looks for orbs to take in, as
    /// `tickNonPassenger` and `ExperienceOrb.tick` run it among `blocks`, in a level whose floor
    /// is `min_y`, where lava's fast if `fast_lava`: `merge_due` says whether it's to look.
    pub fn tick_start<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool) {
        self.merge_due = false
        // `commonTick`.
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        // `baseTick`: its portal cooldown, its fluids, with no splash, `doWaterSplashEffect`
        // being nothing; then halving the fall in lava, then below the level.
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        var none_heard = List<EntitySound>()
        _ = self.body.update_fluids(f, t, blocks, fast_lava, false, mut none_heard)
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        self.body.first_tick = false
        self.colliding = blocked(f, m, blocks, self.body.bounding_box())
        if self.body.water_eyes {
            // `setUnderwaterMovement`.
            let up = self.body.vy + f64(5.0e-4f32)
            let most = f64(0.06f32)
            self.body.vx = self.body.vx * f64(0.99f32)
            self.body.vy = if up < most { up } else { most }
            self.body.vz = self.body.vz * f64(0.99f32)
        } else if not self.colliding {
            let g = self.body.gravity_now()
            if g != 0.0 {
                self.body.vy = self.body.vy + -g
            }
        }
        let (bx, by, bz) = self.body.block()
        if f.is_lava(blocks.collision_state(bx, by, bz) ?? 0) {
            let a = self.body.random.next_float()
            let b = self.body.random.next_float()
            let c = self.body.random.next_float()
            let d = self.body.random.next_float()
            self.body.vx = f64((a - b) * 0.2f32)
            self.body.vy = f64(0.2f32)
            self.body.vz = f64((c - d) * 0.2f32)
        }
        self.merge_due = self.body.tick_count % 20 == 1
    }

    /// The rest of its tick, after it's looked for orbs to take in: following the nearest of
    /// `players`, in the level's order, out of a block it's stuck in, its move, its slowing and
    /// bounce, and its age.
    pub fn tick_rest<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, players: List<Follower>) {
        self.follow(players)
        if self.following == none and self.colliding {
            let b = self.body.bounding_box()
            if blocked(f, m, blocks, moved(b, self.body.vx, self.body.vy, self.body.vz)) {
                let (x, z) = (self.body.x, self.body.z)
                self.body.closest_space(f, blocks, x, (b.min_y + b.max_y) / 2.0, z)
                self.body.needs_sync = true
            }
        }
        let fall_speed = self.body.vy
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        self.body.move_by(f, m, t, blocks, vx, vy, vz)
        // `applyEffectsFromBlocks`, what blocks do to it, isn't in Calcite.
        var friction = 0.98f32
        if self.body.on_ground {
            let (bx, by, bz) = self.body.on_pos(f, t, blocks, 0.999999f32)
            friction = friction * m.friction(f.block(blocks.collision_state(bx, by, bz) ?? 0))
        }
        let scale = f64(friction)
        self.body.vx = self.body.vx * scale
        self.body.vy = self.body.vy * scale
        self.body.vz = self.body.vz * scale
        if self.body.vertical_below and fall_speed < -self.body.gravity_now() {
            self.body.vy = -fall_speed * 0.4
        }
        self.age += 1
        if self.age >= ORB_LIFETIME {
            self.body.removed = true
        }
    }

    // `followNearbyPlayer`: the player it follows kept while they're no spectator and within 8
    // blocks, else the nearest of `players` within 8 who isn't a spectator, if they aren't dead,
    // `getNearestPlayer`; then pulled toward the middle of their eyes' height, the harder the
    // nearer.
    fn follow(mut self, players: List<Follower>) {
        var at: usize? = none
        if let id = self.following {
            for i in 0..players.len() {
                if players[i].id == id {
                    at = some(i)
                }
            }
        }
        let keep = match at {
            some(i) => not players[i].spectator and self.distance_to(players[i]) <= 64.0,
            none => false,
        }
        if not keep {
            var best = -1.0
            var nearest: usize? = none
            for i in 0..players.len() {
                if players[i].spectator {
                    continue
                }
                let d = self.distance_to(players[i])
                if d < 64.0 and (best == -1.0 or d < best) {
                    best = d
                    nearest = some(i)
                }
            }
            at = none
            self.following = none
            if let i = nearest {
                if not players[i].spectator and not players[i].dead {
                    at = some(i)
                    self.following = some(players[i].id)
                }
            }
        }
        let i = at else return
        let p = players[i]
        let dx = p.x - self.body.x
        let dy = p.y + f64(p.eyes) / 2.0 - self.body.y
        let dz = p.z - self.body.z
        let length = dx * dx + dy * dy + dz * dz
        let power = 1.0 - length.sqrt() / 8.0
        let (nx, ny, nz) = normalize(dx, dy, dz)
        let pull = power * power * 0.1
        self.body.vx = self.body.vx + nx * pull
        self.body.vy = self.body.vy + ny * pull
        self.body.vz = self.body.vz + nz * pull
    }

    // `distanceToSqr` from the player `p`.
    fn distance_to(self, p: Follower) -> f64 {
        let dx = p.x - self.body.x
        let dy = p.y - self.body.y
        let dz = p.z - self.body.z
        return dx * dx + dy * dy + dz * dz
    }

    /// Whether it may take in `other`, `canMerge`: another orb, not gone, whose ID is a multiple
    /// of 40 from its own, of the same value.
    pub fn takes_in(self, other: ExperienceOrb) -> bool {
        return other.body.id != self.body.id and can_merge(other, self.body.id, self.value)
    }

    /// `merge`: `other`'s orbs counted in with its own, and the younger age kept; `other` goes.
    pub fn take_in(mut self, other: mut ExperienceOrb) {
        self.count = self.count + other.count
        if other.age < self.age {
            self.age = other.age
        }
        other.body.removed = true
    }
}

/// `canMerge(orb, id, value)`: `orb` not gone, its ID a multiple of 40 from `id`, worth `value`.
pub fn can_merge(orb: ExperienceOrb, id: i32, value: i32) -> bool {
    return not orb.body.removed and (orb.body.id.wrapping_sub(id)) % 40 == 0 and orb.value == value
}

/// `getExperienceValue`: the most an orb of `most` or less experience is worth, one of vanilla's
/// sizes.
pub fn orb_value(most: i32) -> i32 {
    let sizes: List<i32> = [2477, 1237, 617, 307, 149, 73, 37, 17, 7, 3]
    for s in sizes {
        if most >= s {
            return s
        }
    }
    return 1
}

/// The orbs `ExperienceOrb.award` splits `amount` into, the biggest first, each as
/// `getExperienceValue` sizes it from what's left.
pub fn orb_values(amount: i32) -> List<i32> {
    var out = List<i32>()
    var left = amount
    while left > 0 {
        let v = orb_value(left)
        left -= v
        out.push(v)
    }
    return out
}

// `noCollision(box)` with no entity, as an orb asks it: whether a block's shape meets `b`, as an
// empty collision context sees them, always above and never falling.
fn blocked<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, b: Aabb) -> bool {
    return not m.colliders(f, blocks, b, Mover { y: f64.MAX, fall: 0.0 }).is_empty()
}

// `Vec3.normalize`: none where it's shorter than 1.0E-5F.
fn normalize(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let d = (x * x + y * y + z * z).sqrt()
    if d < f64(1.0e-5f32) {
        return (0.0, 0.0, 0.0)
    }
    return (x / d, y / d, z / d)
}
