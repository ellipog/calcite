/// A dragon fireball, as vanilla's `DragonFireball` and its `AbstractHurtingProjectile` and
/// `Projectile` make and run it (D618): 1 by 1, its eyes 0.85 up, with no gravity; its values
/// `Entity`'s alone, `defineSynchedData` adding none; and its acceleration, `accelerationPower`,
/// 0.1 till it's read otherwise. It's seen 4 chunks off and sent every 10 ticks,
/// `EntityType.DRAGON_FIREBALL`'s, its motion sent with its acceleration,
/// `ClientboundProjectilePowerPacket`, as `ServerEntity.sendChanges` sends an accelerating
/// projectile's.
///
/// Each tick, as `ServerLevel.tickNonPassenger` and `AbstractHurtingProjectile.tick` run it: it
/// speeds up along its motion by its acceleration, then slows to 0.95, or 0.8 in water,
/// `applyInertia`, its bubbles the server's level doesn't show; its owner's never one that's gone,
/// `getOwner`, and its chunk's always there where it's ticked, `hasChunkAt`, so it goes on: the
/// first block on its way, `clip` with `ClipContext.Block.COLLIDER`, held by the world border,
/// and before that the nearest entity whose box, grown by a margin of up to 0.3, its way goes
/// into, among those its level found in its reach that it may hit, `canHitEntity`, which an
/// ender dragon's parts are among, `getHitResultOnMoveVector`; it turns a fifth of the way toward
/// where it's going, `rotateTowardsMovement`; it goes to what it met, or along its motion,
/// `setPos`; what blocks do to it, `applyEffectsFromBlocks`, which never hurts it,
/// `hurtServer`; `Projectile.tick`'s, shot, and whether it's left its owner's box,
/// `checkLeftOwner`; and `baseTick`, its fire never set, `shouldBurn`. Then, where it met an
/// entity, the world border, or a block that isn't air by then, it hits it,
/// `hitTargetOrDeflectSelf`; and where that isn't its owner, `ownedBy`, what it hit,
/// `FireballHit`, is its level's to deal, `onHit`: a cloud of dragon's breath where it is, or
/// where the first living thing within 4 of it is, its level event and it's gone.
///
/// It's saved as `saveAsPassenger` saves it, `saved`, and loaded as `EntityType.create` makes one
/// and `load` reads it in, `loaded`.
module world.fireball

import math.mth.{RAD_TO_DEG, table_atan2}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.arrow.{OwnerView, Target}
import world.body.{Body, BodyFacts, EntitySound, PROJECTILE_PORTAL_DELAY, bool_or, int_or, uuid_of, uuid_tag}
import world.clip.{BlockHit, clip_including_border}
import world.collision.{Aabb, CollisionBlocks}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, ON_FIRE_FLAG, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, thrown_data}
import world.inside.{Acted, Gateways, Rain}
import world.movement.{MovementStates}
import world.thrown.{ThrownHit, nearest_of, projectile_blocks_act, reach_of}
import worldgen.facts.{Facts}

/// `LevelEvent.PARTICLES_DRAGON_FIREBALL_SPLASH`, sent where a dragon fireball hits, its data -1
/// where it's silent, else 1.
pub const FIREBALL_SPLASH: i32 = 2006

/// What a dragon fireball hit, which its level deals, `DragonFireball.onHit` (D618): its ID; its
/// owner's UUID; where it is, at what it hit; its box there, which its level looks about for
/// living things; and whether it's silent.
pub struct FireballHit {
    pub id: i32
    pub owner: (i64, i64)?
    pub x: f64
    pub y: f64
    pub z: f64
    pub bounds: Aabb
    pub silent: bool
}

/// A dragon fireball.
pub struct DragonFireball {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s alone, as a thrown
    /// potion's but its stack.
    pub body: Body
    pub data: EntityData
    /// Its owner's UUID, `Projectile.owner`; whether it's been out of its owner's box,
    /// `leftOwner`; whether it's been shot, `hasBeenShot`; and its acceleration,
    /// `accelerationPower`.
    pub owner: (i64, i64)? = none
    pub left_owner: bool = false
    pub shot: bool = false
    pub acceleration: f64 = 0.1
    /// The block its way meets this tick, `clipIncludingBorder`'s.
    pub way: BlockHit
    /// What blocks did that its level's to do, with how many of its tick's sounds came before.
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
    // What it keeps to save as it was read, `can_break`.
    kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
}

impl DragonFireball {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64) -> DragonFireball {
        let body = Body.made(id, seed, x, y, z, 1.0f32, 1.0f32, 0.85f32, 0.0)
        let way = BlockHit { x: x, y: y, z: z, face: 0, bx: 0, by: 0, bz: 0, missed: true }
        return DragonFireball { body: body, data: thrown_data(), way: way }
    }

    /// The fireball an ender dragon of the UUID `owner` shoots along xd, yd, zd as it strafes,
    /// with the ID `id` and a random seeded `seed`, `new DragonFireball(level, dragon, direction
    /// .normalize())` (D619): its motion that way made a unit long and again, as
    /// `assignDirectionalMovement` makes the way it's given a unit long, times its acceleration,
    /// sent again, `needsSync`; owned by the dragon; then put at x, y, z, facing nought, `snapTo`.
    pub fn fired(id: i32, seed: i64, x: f64, y: f64, z: f64, owner: (i64, i64), xd: f64, yd: f64, zd: f64) -> DragonFireball {
        var b = DragonFireball.made(id, seed, x, y, z)
        let (ux, uy, uz) = unit(xd, yd, zd)
        let (wx, wy, wz) = unit(ux, uy, uz)
        b.body.vx = wx * b.acceleration
        b.body.vy = wy * b.acceleration
        b.body.vz = wz * b.acceleration
        b.body.needs_sync = true
        b.owner = some(owner)
        return b
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// `Projectile`'s owner, as a UUID, whether it's left them where it has, whether it's been
    /// shot, and its `can_break` as it was read; then its acceleration, `acceleration_power`.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:dragon_fireball")
        if let o = self.owner {
            t.insert(String("Owner"), uuid_tag(o))
        }
        if self.left_owner {
            t.insert(String("LeftOwner"), Tag.Byte(1i8))
        }
        t.insert(String("HasBeenShot"), Tag.Byte(if self.shot { 1i8 } else { 0i8 }))
        for (k, v) in self.kept {
            t.insert(k.copy(), v.copy())
        }
        t.insert(String("acceleration_power"), Tag.Double(self.acceleration))
        return Tag.Compound(t)
    }

    /// The dragon fireball `tag` saves, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes one and `Entity.load` and `readAdditionalSaveData` read it in:
    /// what every entity reads, `world.body`'s, and its values from it; its owner, whether it left
    /// them and whether it was shot; and its acceleration where it's a number, else 0.1,
    /// `getDoubleOr`. `none` where it's somewhere that isn't a number, logged in `lines` as
    /// `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> DragonFireball? {
        var b = DragonFireball.made(id, seed, 0.0, 0.0, 0.0)
        if not b.body.load_from(tag, mut lines) {
            return none
        }
        b.data.set(AIR_SUPPLY, Value.Number(b.body.air))
        if b.body.extras.contains("CustomName") {
            b.data.set(CUSTOM_NAME, Value.Name(b.body.extras["CustomName"].copy()))
        }
        b.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        b.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        b.data.set(NO_GRAVITY, Value.Bool(b.body.no_gravity))
        b.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        b.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        b.owner = uuid_of(tag, "Owner")
        b.left_owner = bool_or(tag, "LeftOwner")
        b.shot = bool_or(tag, "HasBeenShot")
        if tag.contains("can_break") {
            b.kept.insert(String("can_break"), tag["can_break"].copy())
        }
        if tag.contains("acceleration_power") {
            if let power = tag["acceleration_power"].number_double() {
                b.acceleration = power
            }
        }
        return some(b)
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// The first part of its tick, as `tickNonPassenger` and `AbstractHurtingProjectile.tick` run
    /// it among `blocks`, up to where its level looks for what it may hit: its motion sped up by
    /// its acceleration along it, made a unit long, `normalize`, none where it's shorter than a
    /// float's `1.0E-5`, then slowed, in water to 0.8, else to 0.95, `applyInertia`; and the
    /// first block on its way, `way`, held by the world border `border`, its west, north, east
    /// and south edges.
    pub fn tick_start<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, border: (f64, f64, f64, f64)) {
        // `commonTick`.
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        let (ux, uy, uz) = unit(vx, vy, vz)
        let inertia = f64(if self.body.in_water { 0.8f32 } else { 0.95f32 })
        self.body.vx = (vx + ux * self.acceleration) * inertia
        self.body.vy = (vy + uy * self.acceleration) * inertia
        self.body.vz = (vz + uz * self.acceleration) * inertia
        let from = (self.body.x, self.body.y, self.body.z)
        let to = (self.body.x + self.body.vx, self.body.y + self.body.vy, self.body.z + self.body.vz)
        self.way = clip_including_border(f, m, blocks, self.body.mover(), from, to, border)
    }

    /// Its box stretched along its motion and a block bigger, where its level looks for what it
    /// may hit, as a thrown potion's.
    pub fn reach(self) -> Aabb {
        return reach_of(self.body)
    }

    /// The nearest of `targets` its way meets, as a thrown potion's, `getEntityHitResult`.
    pub fn nearest(self, targets: List<Target>) -> ThrownHit? {
        return nearest_of(self.body, self.way, targets)
    }

    /// From the start of its tick to its hits, `hit` the entity its way met: it turns a fifth of
    /// the way toward where it's going, `rotateTowardsMovement(0.2F)`, where it's moving; it goes
    /// to what it met, else to the block its way met or the end of its motion, `setPos`; and what
    /// blocks do to it along the way, `applyEffectsFromBlocks`, which nothing hurting it marks.
    pub fn go<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, blocks: B, hit: ThrownHit?, sounds: mut List<EntitySound>) {
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        if vx * vx + vy * vy + vz * vz != 0.0 {
            let across = (vx * vx + vz * vz).sqrt()
            let y_to = f32.nearest((table_atan2(vz, vx) ?? 0.0) * RAD_TO_DEG) + 90.0f32
            let x_to = set_pitch(f32.nearest((table_atan2(across, vy) ?? 0.0) * RAD_TO_DEG) - 90.0f32)
            self.body.x_rot = set_pitch(lerp_toward(self.body.x_rot, x_to))
            self.body.y_rot = lerp_toward(self.body.y_rot, y_to)
        }
        if let h = hit {
            self.body.x = h.x
            self.body.y = h.y
            self.body.z = h.z
        } else {
            self.body.x = self.way.x
            self.body.y = self.way.y
            self.body.z = self.way.z
        }
        let moves = self.body.final_moves()
        projectile_blocks_act(mut self.body, mut self.data, mut self.acted, mut self.acted_after, false, f, blocks, moves, mut sounds)
    }

    /// The end of its tick: `Projectile.tick`'s, shot, and whether it's out of its owner's box,
    /// `checkLeftOwner`, its owner as its level found them, `owner`; then `baseTick`, its way
    /// through a portal it's in, its fluids, the currents pushing it, with a splash coming into
    /// water, its fire, which never hurts it, its fall halved in lava, gone below the level, and
    /// its flag.
    pub fn tick_end<B: CollisionBlocks + Gateways>(mut self, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, owner: OwnerView?, sounds: mut List<EntitySound>) {
        self.shot = true
        if not self.left_owner {
            self.left_owner = self.outside_owner(owner)
        }
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        // Its way through the portal it's in, which it may take as it's alive and riding nothing,
        // `Entity.canUsePortal`, its cooldown then a projectile's 2,
        // `Projectile.getDimensionChangingDelay`.
        if let p = self.body.portal_goes(true, PROJECTILE_PORTAL_DELAY) {
            if p.gateway {
                if let done = self.body.gateway_goes(p, blocks, false, true) {
                    self.acted.push(done)
                    self.acted_after.push(sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.body.travel(p, saved)
                self.acted.push(Acted.Travel(way))
                self.acted_after.push(sounds.len())
            }
        }
        _ = self.body.update_fluids_pushed(f, t, blocks, fast_lava, true, true, mut sounds)
        _ = self.body.fire_tick(false)
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let shown = self.body.fire_shown()
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, shown)
        self.body.first_tick = false
    }

    // `isOutsideOwnerCollisionRange`: its reach meets nothing of its owner that may be picked;
    // true with no owner found, or one that can't be picked, as an ender dragon can't.
    fn outside_owner(self, owner: OwnerView?) -> bool {
        let o = owner else return true
        let ob = o.bounds else return true
        let b = self.reach()
        return not ob.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z)
    }

    /// What it hit as `hitTargetOrDeflectSelf` and `DragonFireball.onHit` have it, `hit` the
    /// entity its way met, with `state` the block its way met as it is now, and `owner` its owner
    /// as its level found them, `FireballHit`: the entity, but for its owner, `ownedBy`, which it
    /// goes on through; else the world border, which it doesn't bounce off; else a block that
    /// isn't air; else nothing.
    pub fn hit(self, f: Facts, hit: ThrownHit?, state: u32, owner: OwnerView?) -> FireballHit? {
        if let h = hit {
            if let o = owner {
                if o.id == h.target {
                    return none
                }
            }
        } else if self.way.missed {
            return none
        } else if not self.way.border and f.is_air(state) {
            return none
        }
        return some(FireballHit { id: self.body.id, owner: self.owner, x: self.body.x, y: self.body.y, z: self.body.z, bounds: self.body.bounding_box(), silent: self.silent() })
    }
}

// `Vec3.normalize` of x, y, z: made a unit long, none where it's shorter than a float's `1.0E-5`.
fn unit(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let dist = (x * x + y * y + z * z).sqrt()
    if dist < f64(1.0e-5f32) {
        return (0.0, 0.0, 0.0)
    }
    return (x / dist, y / dist, z / dist)
}

// `setXRot`'s keeping of a pitch, `Math.clamp(xRot % 360.0F, -90.0F, 90.0F)`.
fn set_pitch(v: f32) -> f32 {
    let p = v % 360.0f32
    if p < -90.0f32 {
        return -90.0f32
    }
    return if p > 90.0f32 { 90.0f32 } else { p }
}

// `rotateTowardsMovement`'s turn from `from`, the angle as its tick began, `xRotO` or `yRotO`,
// brought within half a turn of `to`, a fifth of the way there, `Mth.lerp(0.2F, ...)`.
fn lerp_toward(from: f32, to: f32) -> f32 {
    var o = from
    while to - o < -180.0f32 {
        o -= 360.0f32
    }
    while to - o >= 180.0f32 {
        o += 360.0f32
    }
    return o + 0.2f32 * (to - o)
}
