        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!JJ!uj|:x*|;|<",
        "|=x)|>x(|?|@|A|B|C|D|E|F|Gx'|Hx&|I|J|Kx%|Lx$|M|N|O|P|Q|R|S|T|U|V|W|X|Y|Z|[|]|^|_|`|a|b|c|d|e|f|g",
        "|hx#|ix!|j|k|lw~|mw||n|o|p|q|r|s|t|u|vwz|wwy|x|y|zwx||ww!|~vF~!~#~$vE~%vD~&~'~(~)~*~+~,~-~.vC~/",
        "vB~0~1~2vA~3v@~4~5~6~7~8~9~:~;~<~=~>~?~@~A~B~C~D~E~F~G~H~I~J~K~L~M~Nv?~Ov>~P~Q~Rv=~Sv<~T~U~V~W~X",
        "~Y~Z~[~]v;~^v:~_~`~av9~bv8~cTvbvbulul!",
    ]
    let alphabet = "!#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz|~"
    var digit: List<u32> = []
    for _ in 0..128 {
        digit.push(0)
    }
    for i in 0..alphabet.len() {
        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)
    }
    var shapes: List<u16> = []
    shapes.reserve(35723)
    for line in lines {
        var i: usize = 0
        while i < line.len() {
            let d = digit[usize(line.byte_at(i))]
            if d >= 81 {
                shapes.push(values[usize(81 + (d - 81) * 90 + digit[usize(line.byte_at(i + 1))])])
                i += 2
            } else {
                shapes.push(values[usize(d)])
                i += 1
            }
        }
    }
    return shapes
}

