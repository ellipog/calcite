/// A villager's gossip, as vanilla's `GossipContainer` keeps it (CAL-160): what it's heard of each
/// entity, by the entity's UUID, in the order a `HashMap` of UUIDs goes over them, and of each
/// entity each type of gossip with its value; added to, decayed once a day, weighed into a
/// reputation, and saved as `GossipContainer.CODEC` saves it, a list of `Target`, `Type` and
/// `Value`. An entity's types are kept in the order they came, where vanilla's
/// `Object2IntOpenHashMap` of them goes by the types' identity hashes, which a run sets.
module world.gossip

import nbt.tag.{Tag}
import world.body.{uuid_of, uuid_tag}

/// The types of gossip, `GossipType`, in its order.
pub const MAJOR_NEGATIVE: i32 = 0
pub const MINOR_NEGATIVE: i32 = 1
pub const MINOR_POSITIVE: i32 = 2
pub const MAJOR_POSITIVE: i32 = 3
pub const TRADING: i32 = 4
const TYPES: i32 = 5

/// The type's name, as it's saved.
pub fn gossip_name(kind: i32) -> str {
    return match kind {
        0 => "major_negative",
        1 => "minor_negative",
        2 => "minor_positive",
        3 => "major_positive",
        _ => "trading",
    }
}

/// The type of the name `name`, if there's one.
pub fn gossip_named(name: String) -> i32? {
    for kind in 0..TYPES {
        if name == String(gossip_name(kind)) {
            return some(kind)
        }
    }
    return none
}

// What the type weighs in a reputation, `weight`.
fn weight(kind: i32) -> i32 {
    return match kind {
        0 => -5,
        1 => -1,
        2 => 1,
        3 => 5,
        _ => 1,
    }
}

// The most it may be, `max`.
fn most(kind: i32) -> i32 {
    return match kind {
        0 => 100,
        1 => 200,
        2 => 25,
        3 => 20,
        _ => 25,
    }
}

// What it loses each day, `decayPerDay`.
fn decay_per_day(kind: i32) -> i32 {
    return match kind {
        0 => 10,
        1 => 20,
        2 => 1,
        3 => 0,
        _ => 2,
    }
}

/// Below this a gossip's dropped, `DISCARD_THRESHOLD`.
const DISCARD_THRESHOLD: i32 = 2

/// A UUID, as a key that hashes as `UUID.hashCode` does.
pub struct Uuid {
    pub most: i64
    pub least: i64
}

impl JavaHash for Uuid {
    fn java_hash(self) -> i32 {
        let hilo = self.most ^ self.least
        return i32.wrap(hilo >> 32) ^ i32.wrap(hilo)
    }
}

/// A type of gossip heard and its value.
pub struct Heard {
    pub kind: i32
    pub value: i32
}

/// What a villager's heard, `GossipContainer`.
pub struct Gossips {
    pub of: JavaHashMap<Uuid, List<Heard>> = JavaHashMap<Uuid, List<Heard>>()
}

impl Gossips {
    /// `add`: `amount` of the type `kind` heard of `target`, summed with what was, held to the
    /// type's most as `mergeValuesForAddition` holds it, and dropped where it's under 2, the entity
    /// with it where that leaves nothing of it.
    pub fn add(mut self, target: (i64, i64), kind: i32, amount: i32) {
        let (most_bits, least_bits) = target
        let key = Uuid { most: most_bits, least: least_bits }
        _ = self.of.compute_if_absent(key, List<Heard>())
        var at: usize? = none
        for i in 0..self.of[key].len() {
            if self.of[key][i].kind == kind {
                let was = self.of[key][i].value
                let sum = was + amount
                self.of[key][i].value = if sum <= most(kind) { sum } else if was > most(kind) { was } else { most(kind) }
                at = some(i)
            }
        }
        if at == none {
            self.of[key].push(Heard { kind: kind, value: amount })
            at = some(self.of[key].len() - 1)
        }
        // `makeSureValueIsntTooLowOrTooHigh`: held to the type's most, and dropped under 2.
        let i = at ?? 0usize
        if self.of[key][i].value > most(kind) {
            self.of[key][i].value = most(kind)
        }
        if self.of[key][i].value < DISCARD_THRESHOLD {
            _ = self.of[key].remove(i)
        }
        if self.of[key].is_empty() {
            _ = self.of.remove(key)
        }
    }

    /// `decay`, once a day: each gossip less its type's day's decay, dropped where that's under
    /// 2, and each entity with nothing left forgotten, taken out of the map it's in as vanilla's
    /// `removeIf` takes it, so those left keep their order.
    pub fn decay(mut self) {
        var keys = List<Uuid>()
        for (key, _) in self.of {
            keys.push(key)
        }
        for key in keys {
            var kept = List<Heard>()
            for h in self.of[key] {
                let v = h.value - decay_per_day(h.kind)
                if v >= DISCARD_THRESHOLD {
                    kept.push(Heard { kind: h.kind, value: v })
                }
            }
            if kept.is_empty() {
                _ = self.of.remove(key)
            } else {
                self.of[key] = kept
            }
        }
    }

    /// `getReputation` of `target`, every type: each value by its type's weight, summed.
    pub fn reputation(self, target: (i64, i64)) -> i32 {
        let (most_bits, least_bits) = target
        let key = Uuid { most: most_bits, least: least_bits }
        if not self.of.contains(key) {
            return 0
        }
        var sum = 0
        for h in self.of[key] {
            sum += h.value * weight(h.kind)
        }
        return sum
    }

    /// As `GossipContainer.CODEC` saves it: each entity's gossips in turn, its UUID, type and
    /// value.
    pub fn saved(self) -> Tag {
        var out = List<Tag>()
        for (key, heard) in self.of {
            for h in heard {
                var m = JavaHashMap<String, Tag>()
                m.insert(String("Target"), uuid_tag((key.most, key.least)))
                m.insert(String("Type"), Tag.Str(String(gossip_name(h.kind))))
                m.insert(String("Value"), Tag.Int(h.value))
                out.push(Tag.Compound(m))
            }
        }
        return Tag.List(out)
    }

    /// The gossips `tag` saves, as `GossipContainer.CODEC` reads them: each entry put in turn,
    /// one of a type it's heard already taking its place. A list that isn't one of entries, or an
    /// entry it can't read, a value under 1 among them, reads as none, as the codec fails.
    pub fn read(tag: Tag) -> Gossips {
        var g = Gossips()
        let Tag.List(entries) = tag else return g
        for e in entries {
            let Tag.Compound(m) = e else return Gossips()
            let target = uuid_of(m, "Target") else return Gossips()
            let Tag.Str(name) = m["Type"] else return Gossips()
            let kind = gossip_named(name.copy()) else return Gossips()
            if not m.contains("Value") {
                return Gossips()
            }
            let value = m["Value"].int_value() else return Gossips()
            if value < 1 {
                return Gossips()
            }
            g.put(target, kind, value)
        }
        return g
    }

    // `entries.put`: the type's value set, as the codec's entries are.
    fn put(mut self, target: (i64, i64), kind: i32, value: i32) {
        let (most_bits, least_bits) = target
        let key = Uuid { most: most_bits, least: least_bits }
        _ = self.of.compute_if_absent(key, List<Heard>())
        var found = false
        for i in 0..self.of[key].len() {
            if self.of[key][i].kind == kind {
                self.of[key][i].value = value
                found = true
            }
        }
        if not found {
            self.of[key].push(Heard { kind: kind, value: value })
        }
    }
}
