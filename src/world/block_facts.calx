/// The instruments a note block plays, by name, in `NoteBlockInstrument`'s order.
pub fn instrument_names() -> List<str> {
    return [
        "harp",
        "basedrum",
        "snare",
        "hat",
        "bass",
        "flute",
        "bell",
        "guitar",
        "chime",
        "xylophone",
        "iron_xylophone",
        "cow_bell",
        "didgeridoo",
        "bit",
        "banjo",
        "pling",
        "trumpet",
        "trumpet_exposed",
        "trumpet_oxidized",
        "trumpet_weathered",
        "zombie",
        "skeleton",
        "creeper",
        "dragon",
        "wither_skeleton",
        "piglin",
        "custom_head",
    ]
}

