        "!!!!!!!!!!!!!!!5555555588888888!!!!KQ!KQ!KQ!KQ!KQ!KQ!KQ!KQ!KQL!KL!KL!KL!KL!KL!KL!KL!KL!KRL!RL!RL",
        "!RL!RL!RL!RL!RL!RL!!KQ!KQ!KQ!KQ!KQ!KQ!KQ!KQ!KQL!KL!KL!KL!KL!KL!KL!KL!KL!KRL!RL!RL!RL!RL!RL!RL!RL",
        "!RL!!!!!!!!",
    ]
    let alphabet = "!#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz|~"
    var digit: List<u32> = []
    for _ in 0..128 {
        digit.push(0)
    }
    for i in 0..alphabet.len() {
        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)
    }
    let pair = alphabet.byte_at(89)
    var mirrors: List<u32> = []
    mirrors.reserve(35723)
    for line in lines {
        var i: usize = 0
        while i < line.len() {
            let b = line.byte_at(i)
            if b == pair {
                mirrors.push(values[usize(89 + digit[usize(line.byte_at(i + 1))])])
                i += 2
            } else {
                mirrors.push(values[usize(digit[usize(b)])])
                i += 1
            }
        }
    }
    return mirrors
}

