        "2!'~aA0B$~b~[~!H').5#&L~k~_~i~j~l~mM~Y&,4~_I~`/+*~Y~(-42!!!!!!!!",
    ]
    let alphabet = "!#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz|~"
    var digit: List<u32> = []
    for _ in 0..128 {
        digit.push(0)
    }
    for i in 0..alphabet.len() {
        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)
    }
    let pair = alphabet.byte_at(89)
    var turns: List<u32> = []
    turns.reserve(35723)
    for line in lines {
        var i: usize = 0
        while i < line.len() {
            let b = line.byte_at(i)
            if b == pair {
                turns.push(values[usize(89 + digit[usize(line.byte_at(i + 1))])])
                i += 2
            } else {
                turns.push(values[usize(digit[usize(b)])])
                i += 1
            }
        }
    }
    return turns
}

