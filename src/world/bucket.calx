/// A bucket used in the air (CAL-214): what `BucketItem.emptyContents` does with a bucket of water
/// or lava where the player looks, and what `BucketPickup.pickupBlock` takes up with an empty one.
module world.bucket

import random.source.{RandomSource}
import world.block_level.{BlockLevel, destroy_block}
import world.flowing.{Liquid, is_source, legacy, liquid_of, place_liquid}
import world.level_writer.{UPDATE_LIMIT}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, LAVA_FLUID, WATER_FLUID, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env, can_survive}

/// `levelEvent`'s type for a block broken, which powder snow taken up shows.
const BLOCK_BROKEN: i32 = 2001

/// What a bucket took up, `pickupBlock`: the bucket it's now, as `minecraft:water_bucket`, and
/// the block's `getPickupSound`.
pub struct Taken {
    pub item: String
    pub sound: String
}

/// How a bucket was emptied, `emptyContents`: not; at the block where its empty sound's heard,
/// `playEmptySound`, which its caller plays, as a fish bucket's is its own; or hissing, where
/// water evaporated.
pub enum Poured {
    No
    At((i32, i32, i32))
    Hissed
}

/// `BucketItem.emptyContents` of a bucket of lava where `lava`, else of water, at x, y, z, by the
/// player whose entity is `player`, sneaking where `shift`, in creative mode where `creative`;
/// `hit` the block they looked at and its face, none where it's tried again: how it was emptied.
/// The block there is replaced where it gives way to the fluid, `canBeReplaced(Fluid)`,
/// air, replaceable or not solid but an end portal's or gateway's, or takes it, a
/// `LiquidBlockContainer` whose `canPlaceLiquid` says yes. Where it's air, or so and they're not
/// sneaking or it's tried again: water where it evaporates hisses, `block.fire.extinguish` at 2.2
/// to 3.0 drawn from the level's random, with 8 large smoke at the block's corner; water goes into
/// a container, `placeLiquid`; else a block that gave way is broken with its drops, unless it's a
/// liquid, and the fluid's source set with flags 11, which failing where the block's fluid wasn't
/// a source fails it. Each but the hiss is where its empty sound's heard. Else, where there's a
/// block they looked at, it's tried again in the block beside it on the face they looked at,
/// `hitResult.getBlockPos().relative(hitResult.getDirection())`, which, where it wasn't emptied
/// into the block itself, is where it was just tried, and so fails as it did.
pub fn empty_contents<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, lava: bool, player: i32, shift: bool, creative: bool, x: i32, y: i32, z: i32, hit: (i32, i32, i32, i32)?) -> Poured ! Thrown {
    let Env { facts: f, .. } = e
    let state = try level.state(f, x, y, z)
    let block = f.block(state)
    let portal = f.is_a(block, String("EndPortalBlock")) or f.is_a(block, String("EndGatewayBlock"))
    let may_replace = not portal and (f.replaceable(state) or not f.is_solid(state))
    let container = f.liquid_container(block)
    let place = may_replace or (container and can_place_liquid(f, block, state, lava, creative))
    if f.is_air(state) or (place and (not shift or hit == none)) {
        if not lava and level.water_evaporates() {
            let a = level.next_float()
            let b = level.next_float()
            level.play_sound_from(player, x, y, z, String("block.fire.extinguish"), 0.5f32, 2.6f32 + (a - b) * 0.8f32)
            level.send_particles_alternative("minecraft:large_smoke", f64(x), f64(y), f64(z), 8, 1.0, 1.0, 1.0, 0.0)
            return Poured.Hissed
        }
        if container and not lava {
            try place_liquid(f, mut level, x, y, z, state, Liquid { fluid: WATER_FLUID, amount: 8, falling: false })
            return Poured.At((x, y, z))
        }
        if may_replace and not f.is_liquid(state) {
            _ = try destroy_block(e, mut level, x, y, z, true, none, UPDATE_LIMIT)
        }
        let source = try legacy(f, Liquid { fluid: if lava { LAVA_FLUID } else { WATER_FLUID }, amount: 8, falling: false })
        if not level.set_block_limited(x, y, z, source, 11, UPDATE_LIMIT) and not is_source(liquid_of(f, state)) {
            return Poured.No
        }
        return Poured.At((x, y, z))
    }
    let (hx, hy, hz, d) = hit else return Poured.No
    return try empty_contents(e, mut level, lava, player, shift, creative, hx + step_x(d), hy + step_y(d), hz + step_z(d), none)
}

/// `BucketPickup.pickupBlock` of the block at x, y, z by a player, in creative mode where
/// `creative`, as each class has it: a liquid's source set to air with flags 11, a bucket of it;
/// a bubble column so, a bucket of water; powder snow so, shown broken, level event 2001, a bucket
/// of it; a waterlogged block's water let out, flags 3, and the block broken with its drops where
/// it can't stay as it was, a bucket of water, though a barrier gives none up but to a creative
/// player. None where it gives nothing up.
pub fn pickup_block<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, creative: bool) -> Taken? ! Thrown {
    let Env { facts: f, .. } = e
    let state = try level.state(f, x, y, z)
    let block = f.block(state)
    let kind = f.class_name(block)
    if kind == "LiquidBlock" {
        if (f.get_int(state, "level") ?? 0) != 0 {
            return none
        }
        let lava = f.is_lava(state)
        _ = level.set_block_limited(x, y, z, f.ids.air_state, 11, UPDATE_LIMIT)
        if lava {
            return some(Taken { item: String("minecraft:lava_bucket"), sound: String("item.bucket.fill_lava") })
        }
        return some(Taken { item: String("minecraft:water_bucket"), sound: String("item.bucket.fill") })
    }
    if kind == "BubbleColumnBlock" {
        _ = level.set_block_limited(x, y, z, f.ids.air_state, 11, UPDATE_LIMIT)
        return some(Taken { item: String("minecraft:water_bucket"), sound: String("item.bucket.fill") })
    }
    if kind == "PowderSnowBlock" {
        _ = level.set_block_limited(x, y, z, f.ids.air_state, 11, UPDATE_LIMIT)
        level.level_event(BLOCK_BROKEN, x, y, z, i32.wrap(state))
        return some(Taken { item: String("minecraft:powder_snow_bucket"), sound: String("item.bucket.fill_powder_snow") })
    }
    if not f.waterloggable(block) or (kind == "BarrierBlock" and not creative) or not f.get_bool(state, "waterlogged") {
        return none
    }
    _ = level.set_block_limited(x, y, z, try f.with_bool(state, "waterlogged", false), 3, UPDATE_LIMIT)
    if not try can_survive(e, level, state, x, y, z) {
        _ = try destroy_block(e, mut level, x, y, z, true, none, UPDATE_LIMIT)
    }
    return some(Taken { item: String("minecraft:water_bucket"), sound: String("item.bucket.fill") })
}

// `LiquidBlockContainer.canPlaceLiquid` of the block `block`, `state`, for lava where `lava`, else
// water, by a player, in creative mode where `creative`: a waterlogged kind's takes water, but a
// double slab, and a barrier but for a creative player; kelp and seagrass take none.
fn can_place_liquid(f: Facts, block: u32, state: u32, lava: bool, creative: bool) -> bool {
    if lava or f.fixed_container(block) {
        return false
    }
    if f.is_a(block, String("SlabBlock")) and (f.get_name(state, String("type")) ?? String()) == "double" {
        return false
    }
    return not f.is_a(block, String("BarrierBlock")) or creative
}

