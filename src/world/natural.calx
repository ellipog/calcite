/// Natural spawning, as vanilla's `NaturalSpawner` picks where mobs spawn as each chunk mobs may
/// spawn in ticks (P6.1, D317).
///
/// Each category that may spawn this tick, in `MobCategory` order, gets a place in the chunk: a
/// random column and a height up to its surface. From there, three packs each wander up to four
/// steps, and at each step the place is checked as vanilla checks it: far enough from the nearest
/// player and the world's spawn, in a chunk whose entities tick, a mob picked from what spawns
/// there by weight the first time, with its pack's size, and then the type's checks: its
/// category, how far it spawns from players, whether that mob spawns there, its placement on the
/// ground, in water or in lava, its spawn rule, and room for its box. Every draw is made from the
/// level's random in vanilla's order.
///
/// Where a place passes all of them, the mob is made, `getMobForSpawn`, by a `MobMaker`, and
/// turned at random; where Calcite doesn't make its type yet, it stops there for the chunk's
/// category, as vanilla stops where it can't make one (CAL-156). The mob is checked where it
/// stands, `isValidPositionForMob`, finalized with its pack's group by the difficulty at its block,
/// `getCurrentDifficultyAt`, `finalizeSpawn`, and added to the level, with what its finalizing
/// made, a jockey's mount before it and its rider after; at the fourth at a place, its category's
/// done there.
///
/// What spawns is held to each category's caps, `SpawnState`, counted from the level's mobs as
/// the tick begins and those it spawns: the level's, its most a chunk over the chunks the natural
/// spawn counter counts, for it to spawn at all this tick; and the local one, its most a chunk
/// near some player near the chunk, for it to spawn in the chunk. The spawn potential,
/// `PotentialCalculator`, isn't kept: no mob Calcite makes has a spawn cost in any biome, so it
/// would hold only the costs of mobs Calcite keeps as they were read, which it leaves out, and
/// the check that reads it passes.
///
/// What spawns at a place is the biome's `minecraft:gameplay/natural_mob_spawns` over the
/// dimension type's, as `ChunkGenerator.getMobsAt` reads it when no structure there spawns its
/// own. Structures' spawns, and the Nether fortress's, come with structures, and the spawn rules
/// of the types `rule_of` doesn't know yet hold nowhere, drawing nothing.
module world.natural

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.source.{RandomSource}
import resources.identifier.{Identifier}
import world.chunk.{WORLD_SURFACE}
import world.collision.{Aabb, CollisionBlocks, CollisionStates}
import world.entity_facts.{AMBIENT, AXOLOTLS, CREATURE, FAR, FIRE_IMMUNE, IN_LAVA, IN_WATER, MISC, MONSTER, NO_RESTRICTIONS, PEACEFUL, SIGNAL_SOURCE, SUMMON, TypeFacts, UNDERGROUND_WATER_CREATURE, VALID_SPAWN_SHIFT, WATER_AMBIENT, WATER_CREATURE, categories, category_names, immune_tags, rules, state_spawn_facts, types}
import world.difficulty.{LocalDifficulty}
import world.mob.{ENDERMAN, MOOSHROOM, Making, Mob, Occasion, SLIME, SpawnGroup, despawn_distance}
import world.modes.{Difficulty}
import world.spawners.{SpawnerPlayer}
import worldgen.facts.{BlockSet, Facts}
import worldgen.interval.{Thrown}
import worldgen.providers.{IntProvider, read_int}

/// A mob a place may spawn, `MobSpawnSettings.SpawnerData`, by its type's ID, with how many come
/// in its pack, and its weight.
pub struct Spawner {
    pub type_id: i32
    pub count: IntProvider
    pub weight: i32
}

impl Spawner {
    /// `SpawnerData.equals`: the same type and count, whatever the weight.
    pub fn same(self, other: Spawner) -> bool {
        return self.type_id == other.type_id and self.count == other.count
    }
}

/// The mobs that spawn at a place, `MobSpawnSettings`: each category's, in `MobCategory` order,
/// or none where the settings don't name the category.
pub struct MobSettings {
    pub lists: List<List<Spawner>?>
}

impl MobSettings {
    /// `MobSpawnSettings.EMPTY`, the attribute's default: no mobs.
    pub fn empty() -> MobSettings {
        var lists = List<List<Spawner>?>()
        for _ in categories() {
            lists.push(none)
        }
        return MobSettings { lists: lists }
    }

    /// The category's mobs, `getMobsToSpawn`: none where it isn't named.
    pub fn mobs(self, category: i32) -> List<Spawner> {
        if let l = self.lists[usize.wrap(category)] {
            return l.copy()
        }
        return List<Spawner>()
    }

    /// The `overlay` modifier: each category `top` names is its, the others these settings'.
    pub fn overlay(self, top: MobSettings) -> MobSettings {
        var lists = List<List<Spawner>?>()
        for i in 0..self.lists.len() {
            lists.push(if top.lists[i] != none { top.lists[i].copy() } else { self.lists[i].copy() })
        }
        return MobSettings { lists: lists }
    }

    /// These settings with the attribute map entry `entry` applied, as a map's entry is: its
    /// value alone overrides, and `{modifier, argument}` names its operation, `override` or
    /// `overlay`. `entity_types` are the entity types' IDs, in ID order; a mob of a type that
    /// isn't one is left out.
    pub fn applied(self, entry: Tag, entity_types: List<Identifier>) -> MobSettings {
        if entry == Tag.End {
            return MobSettings { lists: self.lists.copy() }
        }
        match field(entry, "modifier") {
            Tag.Str(op) => {
                let argument = settings_of(field(entry, "argument"), entity_types)
                if op == "overlay" {
                    return self.overlay(argument)
                }
                return argument
            },
            _ => return settings_of(entry, entity_types),
        }
    }
}

// Mob spawn settings as the codec writes them in NBT: `spawns_by_category`, by each category's
// serialized name, each a list of `{type, count, weight}`.
fn settings_of(tag: Tag, entity_types: List<Identifier>) -> MobSettings {
    var out = MobSettings.empty()
    let by = field(tag, "spawns_by_category")
    let names = category_names()
    for c in 0..names.len() {
        let Tag.List(items) = field_named(by, names[c]) else continue
        var list = List<Spawner>()
        for item in items {
            let Tag.Str(name) = field(item, "type") else continue
            let id = match Identifier.parse(name) {
                ok(i) => i,
                err(_) => continue,
            }
            var type_id: i32? = none
            for i in 0..entity_types.len() {
                if entity_types[i] == id {
                    type_id = some(i32.wrap(i))
                    break
                }
            }
            let t = type_id else continue
            let weight = match field(item, "weight") {
                Tag.Int(w) => w,
                _ => 0,
            }
            list.push(Spawner { type_id: t, count: count_of(field(item, "count")), weight: weight })
        }
        out.lists[c] = some(list)
    }
    return out
}

// A pack's size as the codec writes it, an int provider: the registries have read it, so it
// reads.
fn count_of(tag: Tag) -> IntProvider {
    return match read_int(tag.to_json()) {
        ok(p) => p,
        err(_) => IntProvider.Constant(1),
    }
}

/// An int provider as a codec writes it in NBT, as the dimension type's
/// `monster_spawn_light_level`: `none` where it doesn't read.
pub fn int_provider_of(tag: Tag) -> IntProvider? {
    return match read_int(tag.to_json()) {
        ok(p) => some(p),
        err(_) => none,
    }
}

fn field(tag: Tag, key: str) -> Tag {
    return field_named(tag, String(key))
}

fn field_named(tag: Tag, key: String) -> Tag {
    match tag {
        Tag.Compound(fields) => {
            if fields.contains(key) {
                return fields[key].copy()
            }
            return Tag.End
        },
        _ => return Tag.End,
    }
}

/// The spawn rules Calcite checks, from the methods `SpawnPlacements` registers.
pub enum Rule {
    /// `Mob.checkMobSpawnRules`.
    Mob
    /// `Monster.checkMonsterSpawnRules`, `checkAnyLightMonsterSpawnRules` and
    /// `checkSurfaceMonstersSpawnRules`.
    Monster
    AnyLightMonster
    SurfaceMonster
    /// `Animal.checkAnimalSpawnRules`.
    Animal
    /// `MushroomCow.checkMushroomSpawnRules`.
    Mushroom
    /// `Bat.checkBatSpawnRules`.
    Bat
    /// `Slime.checkSlimeSpawnRules`.
    Slime
    /// `GlowSquid.checkGlowSquidSpawnRules`.
    GlowSquid
    /// `WaterAnimal.checkSurfaceWaterAnimalSpawnRules`, and
    /// `AgeableWaterCreature.checkSurfaceAgeableWaterCreatureSpawnRules`, the same.
    SurfaceWater
    /// One Calcite doesn't check yet: it holds nowhere.
    Unknown
}

/// The rule the method `name`, as `Owner.method`, checks.
pub fn rule_of(name: String) -> Rule {
    if name == "Mob.checkMobSpawnRules" {
        return Rule.Mob
    }
    if name == "Monster.checkMonsterSpawnRules" {
        return Rule.Monster
    }
    if name == "Monster.checkAnyLightMonsterSpawnRules" {
        return Rule.AnyLightMonster
    }
    if name == "Monster.checkSurfaceMonstersSpawnRules" {
        return Rule.SurfaceMonster
    }
    if name == "Animal.checkAnimalSpawnRules" {
        return Rule.Animal
    }
    if name == "MushroomCow.checkMushroomSpawnRules" {
        return Rule.Mushroom
    }
    if name == "Bat.checkBatSpawnRules" {
        return Rule.Bat
    }
    if name == "Slime.checkSlimeSpawnRules" {
        return Rule.Slime
    }
    if name == "GlowSquid.checkGlowSquidSpawnRules" {
        return Rule.GlowSquid
    }
    if name == "WaterAnimal.checkSurfaceWaterAnimalSpawnRules" or name == "AgeableWaterCreature.checkSurfaceAgeableWaterCreatureSpawnRules" {
        return Rule.SurfaceWater
    }
    return Rule.Unknown
}

/// What natural spawning reads of a level: its blocks, heights, biomes and light, and which
/// chunks' entities tick. Each is asked only of a loaded chunk, or one beside it.
pub interface SpawnLevel {
    /// The state at the block, as `getBlockState` gives it: air outside the world's height.
    fn spawn_state(self, x: i32, y: i32, z: i32) -> u32
    /// The height of the column in heightmap `kind`, one above the highest block it counts, as
    /// `Level.getHeight` gives it.
    fn surface(self, kind: i32, x: i32, z: i32) -> i32
    /// The biome at the block, by its ID, as `getBiome` zooms it.
    fn biome(mut self, x: i32, y: i32, z: i32) -> i32
    /// The biome of the quart, by its ID, as `getNoiseBiome` gives it.
    fn noise_biome(self, qx: i32, qy: i32, qz: i32) -> i32
    /// The light at the block, the sky's if `sky`, as `getBrightness` gives it.
    fn light(self, sky: bool, x: i32, y: i32, z: i32) -> i32
    /// Whether the chunk's entities tick, `PersistentEntitySectionManager.canPositionTick`.
    fn entities_tick(self, chunk_x: i32, chunk_z: i32) -> bool
    /// How long players have been near the chunk, `getInhabitedTime`, where it's loaded in full;
    /// none where it isn't (CAL-156).
    fn inhabited_at(self, chunk_x: i32, chunk_z: i32) -> i64?
    /// Whether players may be near the chunk for mobs to spawn, `hasPlayersNearby` as
    /// `getPlayersCloseForSpawning` reads it, where they're looked for unless it's sure they
    /// aren't.
    fn players_near(mut self, chunk_x: i32, chunk_z: i32) -> bool
}

/// What natural spawning makes its mobs with (CAL-156).
pub interface MobMaker {
    /// `getMobForSpawn`: a new mob of the type `type_id` at x, y, z, its ID and its own random
    /// taken as its constructor takes them; none where Calcite doesn't make the type yet.
    fn make(mut self, type_id: i32, x: f64, y: f64, z: f64) -> Mob?
    /// Where the mob's to be finalized, in the biome `biome` where it stands: what its kind draws
    /// by there, a farm animal's variants to spawn as and a sheep's climate.
    fn spawning_in(self, mob: mut Mob, biome: i32)
    /// `isUnobstructed`: whether nothing that blocks building, `blocksBuilding`, isn't gone and
    /// isn't a spectator has a box that meets `b`.
    fn unobstructed(self, b: Aabb) -> bool
    /// `addFreshEntityWithPassengers`: the mob in the level.
    fn add(mut self, mob: own Mob)
}

/// What natural spawning counts of a level's mobs this tick, `SpawnState` (CAL-156): how many
/// chunks the natural spawn counter counts; how many mobs the level has of each category, of
/// those that needn't stay; and for each of its players, those in the chunks they're near,
/// `LocalMobCapCalculator`. A player is near a chunk for spawning within 128 blocks of its
/// middle, unless a spectator, where it may have players nearby.
pub struct SpawnState {
    pub chunks: i32
    pub counts: List<i32>
    players: List<SpawnerPlayer>
    // The players near each chunk asked of, by `ChunkPos.pack`, as the tick has them; and each
    // player's counts, none until one's counted near them.
    near: Map<i64, List<usize>> = Map<i64, List<usize>>()
    local: List<List<i32>?>
}

impl SpawnState {
    /// None counted, for `chunks` chunks and the level's `players`, in its order.
    pub fn new(chunks: i32, players: own List<SpawnerPlayer>) -> SpawnState {
        var counts = List<i32>()
        for _ in categories() {
            counts.push(0)
        }
        var local = List<List<i32>?>()
        for _ in players {
            local.push(none)
        }
        return SpawnState { chunks: chunks, counts: counts, players: players, local: local }
    }

    /// `createState`'s count of a mob of `category` at x, z that needn't stay, in a loaded chunk:
    /// one more of its category, and of it near each player near its chunk; none of `MISC`.
    pub fn count<L: SpawnLevel>(mut self, level: mut L, category: i32, x: f64, z: f64) {
        if category == MISC {
            return
        }
        self.add_mob(mut level, category, x, z)
    }

    /// `afterSpawn`: the mob of `category` spawned at x, z counted.
    pub fn after_spawn<L: SpawnLevel>(mut self, level: mut L, category: i32, x: f64, z: f64) {
        self.add_mob(mut level, category, x, z)
    }

    // One more of `category`, and of it near each player near the chunk of x, z, `addMob`.
    fn add_mob<L: SpawnLevel>(mut self, level: mut L, category: i32, x: f64, z: f64) {
        let c = usize.wrap(category)
        self.counts[c] += 1
        let near = self.players_near(mut level, i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
        for p in near {
            var counts = List<i32>()
            if let l = self.local[p] {
                counts = l.copy()
            } else {
                for _ in categories() {
                    counts.push(0)
                }
            }
            counts[c] += 1
            self.local[p] = some(counts)
        }
    }

    /// Whether `category` may spawn at all this tick, `canSpawnForCategoryGlobal`: fewer of it
    /// than its most a chunk over the chunks counted.
    pub fn can_spawn_global(self, category: i32) -> bool {
        return self.counts[usize.wrap(category)] < max_per_chunk(category) * self.chunks / 289
    }

    /// Whether `category` may spawn in the chunk, `canSpawnForCategoryLocal`: a player near it
    /// has none counted, or fewer of it than its most a chunk.
    pub fn can_spawn_local<L: SpawnLevel>(mut self, level: mut L, category: i32, chunk_x: i32, chunk_z: i32) -> bool {
        let near = self.players_near(mut level, chunk_x, chunk_z)
        for p in near {
            if let l = self.local[p] {
                if l[usize.wrap(category)] < max_per_chunk(category) {
                    return true
                }
            } else {
                return true
            }
        }
        return false
    }

    // The players near the chunk for spawning, `getPlayersCloseForSpawning`, by their places in
    // the level's order, kept for the tick as vanilla keeps them.
    fn players_near<L: SpawnLevel>(mut self, level: mut L, chunk_x: i32, chunk_z: i32) -> List<usize> {
        let k = (i64(chunk_z) << 32) | (i64(chunk_x) & 4294967295)
        if self.near.contains(k) {
            return self.near[k].copy()
        }
        var out = List<usize>()
        if level.players_near(chunk_x, chunk_z) {
            let mid_x = f64(chunk_x * 16 + 8)
            let mid_z = f64(chunk_z * 16 + 8)
            for i in 0..self.players.len() {
                let p = self.players[i]
                if p.spectator {
                    continue
                }
                let dx = mid_x - p.x
                let dz = mid_z - p.z
                if dx * dx + dz * dz < 16384.0 {
                    out.push(i)
                }
            }
        }
        self.near.insert(k, out.copy())
        return out
    }
}

/// What natural spawning knows of the world's blocks and entity types, the same for every level.
pub struct Natural {
    pub types: List<TypeFacts>
    rules: List<Rule>
    spawn_facts: List<u32>
    pub facts: Facts
    collisions: CollisionStates
    // Whether each state is a liquid, water or lava itself, which has no shape for a mob's room.
    liquid: List<bool>
    prevent_inside: BlockSet
    fire: BlockSet
    campfires: BlockSet
    animals_on: BlockSet
    mooshrooms_on: BlockSet
    bats_on: BlockSet
    // The tags types are immune to, in `immune_tags`' order.
    immune_sets: List<BlockSet>
    lava: u32
    magma_block: u32
    lava_cauldron: u32
    wither_rose: u32
    sweet_berry_bush: u32
    cactus: u32
    powder_snow: u32
    water: u32
    mycelium: u32
    grass_block: u32
}

impl Natural {
    /// What spawning reads, from `facts`, the world's blocks, fluids and their tags.
    pub fn new(facts: own Facts) -> Natural ! String {
        let all = types()
        let spawn_facts = state_spawn_facts()
        if spawn_facts.len() != usize(facts.table.len()) {
            fail "{spawn_facts.len()} states' spawn facts for {facts.table.len()} states"
        }
        var rules_by = List<Rule>()
        for name in rules() {
            rules_by.push(rule_of(name))
        }
        var immune_sets = List<BlockSet>()
        for name in immune_tags() {
            immune_sets.push(facts.tag(name))
        }
        let prevent_inside = facts.tag(String("minecraft:prevent_mob_spawning_inside"))
        let fire = facts.tag(String("minecraft:fire"))
        let campfires = facts.tag(String("minecraft:campfires"))
        let animals_on = facts.tag(String("minecraft:animals_spawnable_on"))
        let mooshrooms_on = facts.tag(String("minecraft:mooshrooms_spawnable_on"))
        let bats_on = facts.tag(String("minecraft:bats_spawnable_on"))
        let lava = try block_id(facts, "minecraft:lava")
        let magma_block = try block_id(facts, "minecraft:magma_block")
        let lava_cauldron = try block_id(facts, "minecraft:lava_cauldron")
        let wither_rose = try block_id(facts, "minecraft:wither_rose")
        let sweet_berry_bush = try block_id(facts, "minecraft:sweet_berry_bush")
        let cactus = try block_id(facts, "minecraft:cactus")
        let powder_snow = try block_id(facts, "minecraft:powder_snow")
        let water = try block_id(facts, "minecraft:water")
        let mycelium = try block_id(facts, "minecraft:mycelium")
        let grass_block = try block_id(facts, "minecraft:grass_block")
        var liquid = List<bool>()
        for s in 0..facts.table.len() {
            liquid.push(facts.is_liquid(s))
        }
        return Natural {
            types: all,
            rules: rules_by,
            spawn_facts: spawn_facts,
            facts: facts,
            collisions: CollisionStates.new(),
            liquid: liquid,
            prevent_inside: prevent_inside,
            fire: fire,
            campfires: campfires,
            animals_on: animals_on,
            mooshrooms_on: mooshrooms_on,
            bats_on: bats_on,
            immune_sets: immune_sets,
            lava: lava,
            magma_block: magma_block,
            lava_cauldron: lava_cauldron,
            wither_rose: wither_rose,
            sweet_berry_bush: sweet_berry_bush,
            cactus: cactus,
            powder_snow: powder_snow,
            water: water,
            mycelium: mycelium,
            grass_block: grass_block,
        }
    }

    // `containsAnyLiquid`: whether a block from the one at the box's least corner to the one at
    // its greatest has a fluid.
    fn any_fluid<L: SpawnLevel>(self, level: L, b: Aabb) -> bool {
        let x1 = i32.saturate(b.max_x.floor())
        let y1 = i32.saturate(b.max_y.floor())
        let z1 = i32.saturate(b.max_z.floor())
        for x in i32.saturate(b.min_x.floor())..=x1 {
            for y in i32.saturate(b.min_y.floor())..=y1 {
                for z in i32.saturate(b.min_z.floor())..=z1 {
                    if self.facts.fluid(level.spawn_state(x, y, z)) != 0 {
                        return true
                    }
                }
            }
        }
        return false
    }

    // `isValidSpawn` of the state for the type: `BlockState.isValidSpawn`, by its group.
    fn valid_spawn(self, state: u32, t: TypeFacts) -> bool {
        return self.spawn_facts[usize(state)] & (1u32 << (VALID_SPAWN_SHIFT + u32.wrap(t.spawn_group))) != 0
    }

    // `NodeEvaluator.isBurningBlock`.
    fn burning(self, state: u32) -> bool {
        if self.facts.in_set(state, self.fire) or self.facts.is(state, self.lava) or self.facts.is(state, self.magma_block) {
            return true
        }
        if self.facts.in_set(state, self.campfires) and self.facts.get_bool(state, String("lit")) {
            return true
        }
        return self.facts.is(state, self.lava_cauldron)
    }

    // `EntityType.isBlockDangerous`.
    fn dangerous(self, type_id: i32, state: u32) -> bool {
        let t = self.types[usize.wrap(type_id)]
        if self.facts.in_set(state, self.immune_sets[usize.wrap(t.immune_to)]) {
            return false
        }
        if t.flags & FIRE_IMMUNE == 0 and self.burning(state) {
            return true
        }
        return self.facts.is(state, self.wither_rose) or self.facts.is(state, self.sweet_berry_bush) or self.facts.is(state, self.cactus) or self.facts.is(state, self.powder_snow)
    }

    // `NaturalSpawner.isValidEmptySpawnBlock`.
    fn empty_spawn_block(self, state: u32, type_id: i32) -> bool {
        if self.facts.collision_full_block(state) {
            return false
        }
        if self.spawn_facts[usize(state)] & SIGNAL_SOURCE != 0 {
            return false
        }
        if self.facts.fluid(state) != 0 {
            return false
        }
        if self.facts.in_set(state, self.prevent_inside) {
            return false
        }
        return not self.dangerous(type_id, state)
    }

    // Whether the state's fluid is in the fluid tag `name`, as `FluidState.is` reads it.
    fn fluid_in(self, state: u32, name: str) -> bool {
        return self.facts.fluid_in(state, String(name))
    }
}

// The block `name`'s ID.
fn block_id(facts: Facts, name: str) -> u32 ! String {
    let b = facts.block_named(String(name)) else fail "there's no block {name}"
    return b
}

/// What spawning reads of a dimension that stays the same: what spawns in each biome, and the
/// biome tags and attributes its rules read.
pub struct Mobs {
    /// Each biome's mobs, by the biome's ID: the biome's `natural_mob_spawns` over the dimension
    /// type's.
    pub by_biome: List<MobSettings>
    /// Each biome's attribute map, as the registries keep it, and whether it's in
    /// `#reduced_water_ambient_spawns` and `#allows_surface_slime_spawns`.
    pub attributes: List<Tag>
    pub reduced_water: List<bool>
    pub surface_slimes: List<bool>
}

/// What spawning reads of a level this tick.
pub struct SpawnPlace {
    /// The world's bottom and the generator's sea level.
    pub min_y: i32
    pub sea_level: i32
    /// The world's seed, which slime chunks hang on.
    pub seed: i64
    pub peaceful: bool
    pub thundering: bool
    /// How far the sky's light is under 15, `skyDarken`.
    pub sky_darken: i32
    /// The border's edges, as `isWithinBounds` reads them.
    pub min_x: f64
    pub max_x: f64
    pub min_z: f64
    pub max_z: f64
    /// The world's spawn, `getRespawnData`'s position, where it's in this level.
    pub respawn: (i32, i32, i32)?
    /// The level's players, in the order `players()` has them.
    pub players: List<SpawnerPlayer>
    /// The dimension type's `monster_spawn_light_level` and `monster_spawn_block_light_limit`, and
    /// its `ambient_light`.
    pub light_test: IntProvider
    pub block_light_limit: i32
    pub ambient_light: f32 = 0.0f32
    /// Each biome's `surface_slime_spawn_chance` this tick, by its ID.
    pub slime_chances: List<f32>
    /// What local difficulty reads (CAL-156): the world's difficulty, the overworld clock's ticks,
    /// `getOverworldClockTime`, and the moon's brightness, `getMoonBrightness`; and whether it's
    /// Halloween.
    pub difficulty: Difficulty = Difficulty.Normal
    pub clock: i64 = 0
    pub moon: f32 = 0.0f32
    pub halloween: bool = false
}

impl SpawnPlace {
    // `WorldBorder.isWithinBounds(x, z)`.
    fn within(self, x: f64, z: f64) -> bool {
        return x >= self.min_x and x < self.max_x and z >= self.min_z and z < self.max_z
    }
}

/// `MobCategory.isFriendly` and `isPersistent`, and `getMaxInstancesPerChunk`.
pub fn friendly(category: i32) -> bool {
    return category != MONSTER
}

pub fn persistent(category: i32) -> bool {
    return category == CREATURE or category == MISC
}

pub fn max_per_chunk(category: i32) -> i32 {
    if category == MONSTER {
        return 70
    }
    if category == CREATURE {
        return 10
    }
    if category == AMBIENT {
        return 15
    }
    if category == WATER_AMBIENT {
        return 20
    }
    if category == MISC {
        return -1
    }
    return 5
}

/// The categories that may spawn this tick, `getFilteredSpawningCategories`: each but `MISC`, in
/// order, that's friendly or `enemies` lets spawn, that isn't persistent or `persistent` lets
/// spawn, and that's under the level's cap for it, as `state` counts.
pub fn spawning_categories(enemies: bool, persistent_too: bool, state: SpawnState) -> List<i32> {
    var out = List<i32>()
    for c in [MONSTER, CREATURE, AMBIENT, AXOLOTLS, UNDERGROUND_WATER_CREATURE, WATER_CREATURE, WATER_AMBIENT] {
        if not enemies and not friendly(c) {
            continue
        }
        if not persistent_too and persistent(c) {
            continue
        }
        if state.can_spawn_global(c) {
            out.push(c)
        }
    }
    return out
}

/// `Mth.ceil` of a float.
fn ceil_float(f: f32) -> i32 {
    let i = i32.saturate(f64(f))
    return if f > f32.nearest(i) { i + 1 } else { i }
}

/// `NaturalSpawner.spawnForChunk` for the chunk at `chunk_x`, `chunk_z`: each of `spawning` in
/// turn that's under its local cap there, as `state` counts, as `spawnCategoryForChunk` spawns
/// it, drawing from `r`, the level's random, its mobs made by `maker`.
pub fn spawn_for_chunk<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, state: mut SpawnState, chunk_x: i32, chunk_z: i32, spawning: List<i32>, r: mut T) ! Thrown {
    for c in spawning {
        if state.can_spawn_local(mut level, c, chunk_x, chunk_z) {
            try spawn_category_for_chunk(n, mobs, place, mut level, mut maker, mut state, chunk_x, chunk_z, c, mut r)
        }
    }
}

// `spawnCategoryForChunk`: a place in the chunk, as `getRandomPosWithin` picks it, a column and
// a height from the world's bottom up to one above the column's top. One at the bottom spawns
// nothing.
fn spawn_category_for_chunk<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, state: mut SpawnState, chunk_x: i32, chunk_z: i32, category: i32, r: mut T) ! Thrown {
    let x = chunk_x * 16 + r.next_int_below(16)
    let z = chunk_z * 16 + r.next_int_below(16)
    let surface = level.surface(WORLD_SURFACE, x, z)
    let y = r.next_int_below(surface - place.min_y + 1) + place.min_y
    if y < place.min_y + 1 {
        return
    }
    try spawn_category_for_position(n, mobs, place, mut level, mut maker, mut state, chunk_x, chunk_z, category, x, y, z, mut r)
}

// `spawnCategoryForPosition`: nothing in a block that conducts redstone. Then three packs, each
// of up to four steps, each a random walk of up to five blocks on x and z from the place, the
// first step's place picking the pack's mob and its size, which bounds the pack's steps from
// there. At each step whose place passes, its mob is made, turned, checked and finalized with
// the pack's group, and added; at the fourth from the place, that's all.
fn spawn_category_for_position<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, state: mut SpawnState, chunk_x: i32, chunk_z: i32, category: i32, x: i32, y: i32, z: i32, r: mut T) ! Thrown {
    if n.facts.redstone_conductor(level.spawn_state(x, y, z)) {
        return
    }
    var cluster = 0
    for _ in 0..3 {
        var px = x
        var pz = z
        var data: Spawner? = none
        var group: SpawnGroup? = none
        var size = ceil_float(r.next_float() * 4.0f32)
        var step = 0
        while step < size {
            px += r.next_int_below(6) - r.next_int_below(6)
            pz += r.next_int_below(6) - r.next_int_below(6)
            step += 1
            let fx = f64(px) + 0.5
            let fz = f64(pz) + 0.5
            let found = nearest_player(place.players, fx, f64(y), fz) else continue
            let (_, d) = found
            if not right_distance(place, level, chunk_x, chunk_z, px, y, pz, d) {
                continue
            }
            if data == none {
                let picked = try random_mob(mobs, mut level, category, px, y, pz, mut r) else break
                size = try picked.count.sample(mut r)
                data = some(picked)
            }
            let spawner = data else continue
            if not try valid_position_for_type(n, mobs, place, mut level, category, spawner, px, y, pz, d, mut r) {
                continue
            }
            // `extraTest`, `SpawnState.canSpawn`: the spawn potential, with nothing in it, lets
            // any spawn.
            var mob = maker.make(spawner.type_id, fx, f64(y), fz) else return
            let turn = r.next_float() * 360.0f32
            mob.living.snap_to(fx, f64(y), fz, turn, 0.0f32)
            if not valid_position_for_mob(n, place, level, maker, mob, px, y, pz, d) {
                continue
            }
            let biome = level.biome(px, y, pz)
            maker.spawning_in(mut mob, biome)
            let o = Occasion { local: difficulty_at(place, level, px, pz), halloween: place.halloween }
            group = mob.finalize_spawn(group, o, mut maker, mut r)
            cluster += 1
            let kind = mob.category
            let most = mob.max_cluster
            maker.add(mob)
            state.after_spawn(mut level, kind, fx, fz)
            if cluster >= most {
                return
            }
        }
    }
}

// `isValidPositionForMob` of the mob at x, y, z, the nearest player `d` blocks squared away: none
// past its category's despawn distance that would go there, `removeWhenFarAway`; then its spawn
// rules, `checkSpawnRules`, a pathfinding mob's walk target's value where it stands no less than
// 0; and its room, `checkSpawnObstruction`, no fluid in a block its box is in and nothing in its
// box that blocks building.
fn valid_position_for_mob<L: SpawnLevel, M: MobMaker>(n: Natural, place: SpawnPlace, level: L, maker: M, mob: Mob, x: i32, y: i32, z: i32, d: f64) -> bool {
    let far = despawn_distance(mob.category)
    if d > f64(far * far) and mob.removed_far_away(d) {
        return false
    }
    if walk_target_value(n, place, level, mob.species, mob.monster, x, y, z) < 0.0f32 {
        return false
    }
    let b = mob.living.body.bounding_box()
    if n.any_fluid(level, b) {
        return false
    }
    return maker.unobstructed(b)
}

// `getWalkTargetValue` of a mob of the kind `species` at x, y, z: a monster's, `Monster`'s, what the
// light there costs, `getPathfindingCostFromLightLevels`, the light's curve lerped to 1 by the
// dimension's ambient light, less a half, negated, so it spawns only where that's no more than a
// half (CAL-156); a slime's 0, `PathfinderMob`'s, so it spawns in any light, and an enderman's 0,
// its own, though its spawn rules want it dark; a mooshroom's 10 on mycelium, another animal's on
// a grass block, `Animal`'s, and otherwise the cost itself.
fn walk_target_value<L: SpawnLevel>(n: Natural, place: SpawnPlace, level: L, species: i32, monster: bool, x: i32, y: i32, z: i32) -> f32 {
    if species == SLIME or species == ENDERMAN {
        return 0.0f32
    }
    if not monster {
        let below = level.spawn_state(x, y - 1, z)
        let on = if species == MOOSHROOM { n.mycelium } else { n.grass_block }
        if n.facts.is(below, on) {
            return 10.0f32
        }
    }
    let v = f32.nearest(raw_brightness(level, x, y, z, place.sky_darken)) / 15.0f32
    let curved = v / (4.0f32 - 3.0f32 * v)
    let cost = curved + place.ambient_light * (1.0f32 - curved) - 0.5f32
    return if monster { -cost } else { cost }
}

// `getCurrentDifficultyAt` the block at x, z (CAL-156): the chunk's inhabited time and the moon's
// brightness where it's loaded in full, neither where it isn't.
fn difficulty_at<L: SpawnLevel>(place: SpawnPlace, level: L, x: i32, z: i32) -> LocalDifficulty {
    var local: i64 = 0
    var moon = 0.0f32
    if let t = level.inhabited_at(x >> 4, z >> 4) {
        local = t
        moon = place.moon
    }
    return LocalDifficulty.new(place.difficulty, place.clock, local, moon)
}

// The nearest player to the place that isn't a spectator, and their distance squared, as
// `getNearestPlayer` with no limit finds them: the first of the nearest, in the level's order.
fn nearest_player(players: List<SpawnerPlayer>, x: f64, y: f64, z: f64) -> (usize, f64)? {
    var best: (usize, f64)? = none
    for i in 0..players.len() {
        let p = players[i]
        if p.spectator {
            continue
        }
        let dx = p.x - x
        let dy = p.y - y
        let dz = p.z - z
        let d = dx * dx + dy * dy + dz * dz
        match best {
            some((_, b)) => {
                if d < b {
                    best = some((i, d))
                }
            },
            none => best = some((i, d)),
        }
    }
    return best
}

// `isRightDistanceToPlayerAndSpawnPoint`: more than 24 blocks from the player, and from the
// middle of the world's spawn if it's in this level, in the chunk being spawned in or one whose
// entities tick within the border.
fn right_distance<L: SpawnLevel>(place: SpawnPlace, level: L, chunk_x: i32, chunk_z: i32, x: i32, y: i32, z: i32, d: f64) -> bool {
    if d <= 576.0 {
        return false
    }
    if let (sx, sy, sz) = place.respawn {
        let dx = f64(sx) + 0.5 - (f64(x) + 0.5)
        let dy = f64(sy) + 0.5 - f64(y)
        let dz = f64(sz) + 0.5 - (f64(z) + 0.5)
        if dx * dx + dy * dy + dz * dz < 576.0 {
            return false
        }
    }
    let cx = x >> 4
    let cz = z >> 4
    if cx == chunk_x and cz == chunk_z {
        return true
    }
    return spawns_in(place, level, cx, cz)
}

/// `ServerLevel.canSpawnEntitiesInChunk`: its entities tick, and it's within the border, both its
/// least and its greatest corner.
pub fn spawns_in<L: SpawnLevel>(place: SpawnPlace, level: L, cx: i32, cz: i32) -> bool {
    if not level.entities_tick(cx, cz) {
        return false
    }
    return place.within(f64(cx * 16), f64(cz * 16)) and place.within(f64(cx * 16 + 15), f64(cz * 16 + 15))
}

// `getRandomSpawnMobAt`: in a biome of `#reduced_water_ambient_spawns`, a water ambient mob only
// one time in fifty; otherwise one of what spawns there, by weight, if any.
fn random_mob<L: SpawnLevel, T: RandomSource>(mobs: Mobs, level: mut L, category: i32, x: i32, y: i32, z: i32, r: mut T) -> Spawner? ! Thrown {
    let biome = level.biome(x, y, z)
    if category == WATER_AMBIENT and flag_of(mobs.reduced_water, biome) and r.next_float() < 0.98f32 {
        return none
    }
    let list = mobs_at(mobs, biome, category)
    var total = 0
    for s in list {
        total += s.weight
    }
    if total == 0 {
        return none
    }
    var pick = r.next_int_below(total)
    for s in list {
        pick -= s.weight
        if pick < 0 {
            return some(s.copy())
        }
    }
    return none
}

fn flag_of(flags: List<bool>, biome: i32) -> bool {
    return biome >= 0 and usize.wrap(biome) < flags.len() and flags[usize.wrap(biome)]
}

// `mobsAt`: what spawns of the category in the biome.
fn mobs_at(mobs: Mobs, biome: i32, category: i32) -> List<Spawner> {
    if biome < 0 or usize.wrap(biome) >= mobs.by_biome.len() {
        return List<Spawner>()
    }
    return mobs.by_biome[usize.wrap(biome)].mobs(category)
}

// `isValidSpawnPostitionForType`, in its order.
fn valid_position_for_type<L: SpawnLevel + CollisionBlocks, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, category: i32, data: Spawner, x: i32, y: i32, z: i32, d: f64, r: mut T) -> bool ! Thrown {
    let t = n.types[usize.wrap(data.type_id)]
    if t.category == MISC {
        return false
    }
    let far = despawn_distance(t.category)
    if t.flags & FAR == 0 and d > f64(far * far) {
        return false
    }
    if t.flags & SUMMON == 0 {
        return false
    }
    var there = false
    for s in mobs_at(mobs, level.biome(x, y, z), category) {
        if s.same(data) {
            there = true
            break
        }
    }
    if not there {
        return false
    }
    if not position_ok(n, place, level, data.type_id, x, y, z) {
        return false
    }
    if not try spawn_rules(n, mobs, place, mut level, data.type_id, x, y, z, mut r) {
        return false
    }
    let fx = f64(x) + 0.5
    let fz = f64(z) + 0.5
    let half = f64(t.half_width)
    let b = Aabb { min_x: fx - half, min_y: f64(y), min_z: fz - half, max_x: fx + half, max_y: f64(y) + f64(t.height), max_z: fz + half }
    return n.collisions.no_collision_without_fluids(level, b, n.liquid)
}

// `SpawnPlacements.isSpawnPositionOk`: the type's placement's check, within the border.
fn position_ok<L: SpawnLevel>(n: Natural, place: SpawnPlace, level: L, type_id: i32, x: i32, y: i32, z: i32) -> bool {
    let t = n.types[usize.wrap(type_id)]
    let placement = t.placement ?? NO_RESTRICTIONS
    if placement == NO_RESTRICTIONS {
        return true
    }
    if not place.within(f64(x), f64(z)) {
        return false
    }
    if placement == IN_WATER {
        return n.fluid_in(level.spawn_state(x, y, z), "minecraft:water") and not n.facts.redstone_conductor(level.spawn_state(x, y + 1, z))
    }
    if placement == IN_LAVA {
        return n.fluid_in(level.spawn_state(x, y, z), "minecraft:lava")
    }
    // On the ground: on a block it may spawn on, with room in its block and the one above.
    if not n.valid_spawn(level.spawn_state(x, y - 1, z), t) {
        return false
    }
    return n.empty_spawn_block(level.spawn_state(x, y, z), type_id) and n.empty_spawn_block(level.spawn_state(x, y + 1, z), type_id)
}

// `SpawnPlacements.checkSpawnRules`: none in peaceful for a type that isn't allowed in it, then
// its rule, if it's registered one.
fn spawn_rules<L: SpawnLevel, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, type_id: i32, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    let t = n.types[usize.wrap(type_id)]
    if t.flags & PEACEFUL == 0 and place.peaceful {
        return false
    }
    let at = t.rule else return true
    let rule = n.rules[usize.wrap(at)]
    return match rule {
        Rule.Mob => mob_rules(n, level, t, x, y, z),
        Rule.Monster => try monster_rules(n, place, level, t, x, y, z, mut r),
        Rule.AnyLightMonster => mob_rules(n, level, t, x, y, z),
        Rule.SurfaceMonster => try monster_rules(n, place, level, t, x, y, z, mut r) and level.light(true, x, y, z) >= 15,
        Rule.Animal => {
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.animals_on) and bright
        },
        Rule.Mushroom => {
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.mooshrooms_on) and bright
        },
        Rule.Bat => bat_rules(n, place, level, t, x, y, z, mut r),
        Rule.Slime => try slime_rules(n, mobs, place, mut level, t, x, y, z, mut r),
        Rule.GlowSquid => y <= place.sea_level - 33 and raw_brightness(level, x, y, z, 0) == 0 and n.facts.is(level.spawn_state(x, y, z), n.water),
        Rule.SurfaceWater => y >= place.sea_level - 13 and y <= place.sea_level and n.fluid_in(level.spawn_state(x, y - 1, z), "minecraft:water") and n.facts.is(level.spawn_state(x, y + 1, z), n.water),
        Rule.Unknown => false,
    }
}

// `Mob.checkMobSpawnRules`: on a block the type may spawn on.
fn mob_rules<L: SpawnLevel>(n: Natural, level: L, t: TypeFacts, x: i32, y: i32, z: i32) -> bool {
    return n.valid_spawn(level.spawn_state(x, y - 1, z), t)
}

// `Monster.checkMonsterSpawnRules`: dark enough, as `isDarkEnoughToSpawn` says, and
// `checkMobSpawnRules`.
fn monster_rules<L: SpawnLevel, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, t: TypeFacts, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    if not try dark_enough(place, level, x, y, z, mut r) {
        return false
    }
    return mob_rules(n, level, t, x, y, z)
}

// `Monster.isDarkEnoughToSpawn`: the sky's light under a draw of 32, the blocks' no more than
// the type's limit, and the brightest light there, the sky's darkened as in a thunderstorm in
// one, no more than a draw of the type's test.
fn dark_enough<L: SpawnLevel, T: RandomSource>(place: SpawnPlace, level: L, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    if level.light(true, x, y, z) > r.next_int_below(32) {
        return false
    }
    if place.block_light_limit < 15 and level.light(false, x, y, z) > place.block_light_limit {
        return false
    }
    let darken = if place.thundering { 10 } else { place.sky_darken }
    let light = raw_brightness(level, x, y, z, darken)
    return light <= try place.light_test.sample(mut r)
}

/// `getMaxLocalRawBrightness` with `darken`: the block's light or the sky's less `darken`,
/// whichever's more; 15 past 30,000,000 blocks out.
pub fn raw_brightness<L: SpawnLevel>(level: L, x: i32, y: i32, z: i32, darken: i32) -> i32 {
    if x < -30000000 or z < -30000000 or x >= 30000000 or z >= 30000000 {
        return 15
    }
    let sky = level.light(true, x, y, z) - darken
    let block = level.light(false, x, y, z)
    return if block > sky { block } else { sky }
}

// `Bat.checkBatSpawnRules`: below the surface, half the time, in light under a draw of 4, on a
// block bats spawn on.
fn bat_rules<L: SpawnLevel, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, t: TypeFacts, x: i32, y: i32, z: i32, r: mut T) -> bool {
    if y >= level.surface(WORLD_SURFACE, x, z) {
        return false
    }
    if r.next_boolean() {
        return false
    }
    if raw_brightness(level, x, y, z, place.sky_darken) > r.next_int_below(4) {
        return false
    }
    if not n.facts.in_set(level.spawn_state(x, y - 1, z), n.bats_on) {
        return false
    }
    return mob_rules(n, level, t, x, y, z)
}

// `Slime.checkSlimeSpawnRules`: none in peaceful. In a biome of `#allows_surface_slime_spawns`
// from 51 to 69 high, at the biome's chance and in light no more than a draw of 8; otherwise one
// in ten in a slime chunk under 40 high, the draw made whatever the chunk.
fn slime_rules<L: SpawnLevel, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, t: TypeFacts, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    if place.peaceful {
        return false
    }
    if flag_of(mobs.surface_slimes, level.biome(x, y, z)) and y > 50 and y < 70 {
        let quart = level.noise_biome(x >> 2, y >> 2, z >> 2)
        let chance = if quart >= 0 and usize.wrap(quart) < place.slime_chances.len() { place.slime_chances[usize.wrap(quart)] } else { 0.0f32 }
        if r.next_float() < chance and raw_brightness(level, x, y, z, place.sky_darken) <= r.next_int_below(8) {
            return mob_rules(n, level, t, x, y, z)
        }
    }
    let in_slime_chunk = slime_chunk(x >> 4, z >> 4, place.seed)
    if r.next_int_below(10) == 0 and in_slime_chunk and y < 40 {
        return mob_rules(n, level, t, x, y, z)
    }
    return false
}

/// Whether the chunk is a slime chunk, as `WorldgenRandom.seedSlimeChunk` seeds a random for it
/// with the world's `seed`: one in ten.
pub fn slime_chunk(cx: i32, cz: i32, seed: i64) -> bool {
    let s = (seed + i64(cx * cx * 4987142) + i64(cx * 5947611) + i64(cz * cz) * 4392871 + i64(cz * 389711)) ^ 987234911
    var r = LegacyRandom.new(s)
    return r.next_int_below(10) == 0
}
