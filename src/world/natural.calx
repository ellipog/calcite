import world.entity_facts.{AMBIENT, AXOLOTLS, COMPUTATION_LAND, CREATURE, FAR, FIRE_IMMUNE, IN_LAVA, IN_WATER, MISC, MONSTER, NO_RESTRICTIONS, ON_GROUND, PEACEFUL, SIGNAL_SOURCE, SUMMON, TypeFacts, UNDERGROUND_WATER_CREATURE, VALID_SPAWN_SHIFT, WATER_AMBIENT, WATER_CREATURE, categories, category_names, immune_tags, rules, state_spawn_facts, types}
import world.difficulty.{LocalDifficulty}
import world.block_flags.{COLLISION_TOP_FULL}
import math.mth.{wrap_degrees}
import world.mob.{cube_kind, water_kind, STRIDER, TROPICAL_FISH, DROWNED, OCELOT, ENDERMAN, HUSK, MOOSHROOM, Making, Mob, Occasion, SpawnGroup, despawn_distance}
import world.modes.{Difficulty}
import world.paths.{PathStates}
import world.spawners.{SpawnerPlayer}
import worldgen.facts.{BlockSet, Facts}
import worldgen.interval.{Thrown}
import worldgen.providers.{IntProvider, read_int}

/// A mob a place may spawn, `MobSpawnSettings.SpawnerData`, by its type's ID, with how many come
/// in its pack, and its weight.
pub struct Spawner {
    pub type_id: i32
    pub count: IntProvider
    pub weight: i32
}

impl Spawner {
    /// `SpawnerData.equals`: the same type and count, whatever the weight.
    pub fn same(self, other: Spawner) -> bool {
        return self.type_id == other.type_id and self.count == other.count
    }
}

/// The mobs that spawn at a place, `MobSpawnSettings`: each category's, in `MobCategory` order,
/// or none where the settings don't name the category.
pub struct MobSettings {
    pub lists: List<List<Spawner>?>
}

impl MobSettings {
    /// `MobSpawnSettings.EMPTY`, the attribute's default: no mobs.
    pub fn empty() -> MobSettings {
        var lists = List<List<Spawner>?>()
        for _ in categories() {
            lists.push(none)
        }
        return MobSettings { lists: lists }
    }

    /// The category's mobs, `getMobsToSpawn`: none where it isn't named.
    pub fn mobs(self, category: i32) -> List<Spawner> {
        if let l = self.lists[usize.wrap(category)] {
            return l.copy()
        }
        return List<Spawner>()
    }

    /// The `overlay` modifier: each category `top` names is its, the others these settings'.
    pub fn overlay(self, top: MobSettings) -> MobSettings {
        var lists = List<List<Spawner>?>()
        for i in 0..self.lists.len() {
            lists.push(if top.lists[i] != none { top.lists[i].copy() } else { self.lists[i].copy() })
        }
        return MobSettings { lists: lists }
    }

    /// These settings with the attribute map entry `entry` applied, as a map's entry is: its
    /// value alone overrides, and `{modifier, argument}` names its operation, `override` or
    /// `overlay`. `entity_types` are the entity types' IDs, in ID order; a mob of a type that
    /// isn't one is left out.
    pub fn applied(self, entry: Tag, entity_types: List<Identifier>) -> MobSettings {
        if entry == Tag.End {
            return MobSettings { lists: self.lists.copy() }
        }
        match field(entry, "modifier") {
            Tag.Str(op) => {
                let argument = settings_of(field(entry, "argument"), entity_types)
                if op == "overlay" {
                    return self.overlay(argument)
                }
                return argument
            },
            _ => return settings_of(entry, entity_types),
        }
    }
}

// Mob spawn settings as the codec writes them in NBT: `spawns_by_category`, by each category's
// serialized name, each a list of `{type, count, weight}`.
fn settings_of(tag: Tag, entity_types: List<Identifier>) -> MobSettings {
    var out = MobSettings.empty()
    let by = field(tag, "spawns_by_category")
    let names = category_names()
    for c in 0..names.len() {
        let Tag.List(items) = field_named(by, names[c]) else continue
        out.lists[c] = some(spawners_of(items, entity_types))
    }
    return out
}

// A pack's size as the codec writes it, an int provider: the registries have read it, so it
// reads.
fn count_of(tag: Tag) -> IntProvider {
    return match read_int(tag.to_json()) {
        ok(p) => p,
        err(_) => IntProvider.Constant(1),
    }
}

/// An int provider as a codec writes it in NBT, as the dimension type's
/// `monster_spawn_light_level`: `none` where it doesn't read.
pub fn int_provider_of(tag: Tag) -> IntProvider? {
    return match read_int(tag.to_json()) {
        ok(p) => some(p),
        err(_) => none,
    }
}

fn field(tag: Tag, key: str) -> Tag {
    return field_named(tag, String(key))
}

fn field_named(tag: Tag, key: String) -> Tag {
    match tag {
        Tag.Compound(fields) => {
            if fields.contains(key) {
                return fields[key].copy()
            }
            return Tag.End
        },
        _ => return Tag.End,
    }
}

/// The spawn rules Calcite checks, from the methods `SpawnPlacements` registers.
pub enum Rule {
    /// `Mob.checkMobSpawnRules`.
    Mob
    /// `Monster.checkMonsterSpawnRules`, `checkAnyLightMonsterSpawnRules` and
    /// `checkSurfaceMonstersSpawnRules`.
    Monster
    AnyLightMonster
    SurfaceMonster
    /// `Animal.checkAnimalSpawnRules`.
    Animal
    /// `MushroomCow.checkMushroomSpawnRules`.
    Mushroom
    /// `Armadillo.checkArmadilloSpawnRules` (CAL-160).
    Armadillo
    /// `Wolf.checkWolfSpawnRules` (CAL-201).
    Wolf
    /// `Bat.checkBatSpawnRules`.
    Bat
    /// `Slime.checkSlimeSpawnRules`.
    Slime
    /// `MagmaCube.checkMagmaCubeSpawnRules`: not in peaceful (CAL-200).
    MagmaCube
    /// `Ghast.checkGhastSpawnRules`: not in peaceful, one draw in 20, then `checkMobSpawnRules`
    /// (CAL-200).
    Ghast
    /// `ZombifiedPiglin.checkZombifiedPiglinSpawnRules`: not in peaceful, nor on a nether wart
    /// block (CAL-200).
    ZombifiedPiglin
    /// `Hoglin.checkHoglinSpawnRules`: not on a nether wart block (CAL-200).
    Hoglin
    /// `Stray.checkStraySpawnRules` (CAL-175).
    Stray
    /// `Drowned.checkDrownedSpawnRules` (CAL-175).
    Drowned
    /// `Ocelot.checkOcelotSpawnRules`: two draws in three, `nextInt(3) != 0` (CAL-201).
    Ocelot
    /// `Rabbit.checkRabbitSpawnRules`: on `#rabbits_spawnable_on`, bright enough,
    /// `isBrightEnoughToSpawn` (CAL-201).
    Rabbit
    /// `Goat.checkGoatSpawnRules`: on `#goats_spawnable_on`, bright enough (CAL-207).
    Goat
    /// `Camel.checkCamelSpawnRules`: on `#camels_spawnable_on`, bright enough (CAL-207).
    Camel
    /// `PolarBear.checkPolarBearSpawnRules`: in a biome of `#polar_bears_spawn_on_alternate_blocks`
    /// on `#polar_bears_spawnable_on_alternate`, bright enough, else an animal's (CAL-201).
    PolarBear
    /// `Fox.checkFoxSpawnRules`: on `#foxes_spawnable_on`, bright enough (CAL-201).
    Fox
    /// `Parrot.checkParrotSpawnRules`: on `#parrots_spawnable_on`, bright enough (CAL-201).
    Parrot
    /// `Turtle.checkTurtleSpawnRules`: under 4 above the sea, on sand, `TurtleEggBlock.onSand`,
    /// bright enough (CAL-201).
    Turtle
    /// `GlowSquid.checkGlowSquidSpawnRules`.
    GlowSquid
    /// `TropicalFish.checkTropicalFishSpawnRules`: water below and above, at any height in a biome
    /// of `#allows_tropical_fish_spawns_at_any_height`, else near the sea's top as
    /// `SurfaceWater` (CAL-201).
    TropicalFish
    /// `WaterAnimal.checkSurfaceWaterAnimalSpawnRules`, and
    /// `AgeableWaterCreature.checkSurfaceAgeableWaterCreatureSpawnRules`, the same.
    SurfaceWater
    /// `Strider.checkStriderSpawnRules`: air above the lava it's in, as many blocks up as that
    /// goes (CAL-392).
    Strider
    /// `AbstractNautilus.checkNautilusSpawnRules`: from 25 to 5 below the sea, water below and
    /// above (CAL-316).
    Nautilus
    /// One Calcite doesn't check yet: it holds nowhere.
    Unknown
}

/// The rule the method `name`, as `Owner.method`, checks.
pub fn rule_of(name: String) -> Rule {
    if name == "Mob.checkMobSpawnRules" {
        return Rule.Mob
    }
    if name == "Monster.checkMonsterSpawnRules" {
        return Rule.Monster
    }
    if name == "Monster.checkAnyLightMonsterSpawnRules" {
        return Rule.AnyLightMonster
    }
    if name == "Monster.checkSurfaceMonstersSpawnRules" {
        return Rule.SurfaceMonster
    }
    if name == "Animal.checkAnimalSpawnRules" {
        return Rule.Animal
    }
    if name == "MushroomCow.checkMushroomSpawnRules" {
        return Rule.Mushroom
    }
    if name == "Armadillo.checkArmadilloSpawnRules" {
        return Rule.Armadillo
    }
    if name == "Wolf.checkWolfSpawnRules" {
        return Rule.Wolf
    }
    if name == "Bat.checkBatSpawnRules" {
        return Rule.Bat
    }
    if name == "MagmaCube.checkMagmaCubeSpawnRules" {
        return Rule.MagmaCube
    }
    if name == "Ghast.checkGhastSpawnRules" {
        return Rule.Ghast
    }
    if name == "ZombifiedPiglin.checkZombifiedPiglinSpawnRules" {
        return Rule.ZombifiedPiglin
    }
    if name == "Hoglin.checkHoglinSpawnRules" {
        return Rule.Hoglin
    }
    if name == "Slime.checkSlimeSpawnRules" {
        return Rule.Slime
    }
    if name == "Stray.checkStraySpawnRules" {
        return Rule.Stray
    }
    if name == "Drowned.checkDrownedSpawnRules" {
        return Rule.Drowned
    }
    if name == "Ocelot.checkOcelotSpawnRules" {
        return Rule.Ocelot
    }
    if name == "Rabbit.checkRabbitSpawnRules" {
        return Rule.Rabbit
    }
    if name == "Goat.checkGoatSpawnRules" {
        return Rule.Goat
    }
    if name == "Camel.checkCamelSpawnRules" {
        return Rule.Camel
    }
    if name == "PolarBear.checkPolarBearSpawnRules" {
        return Rule.PolarBear
    }
    if name == "Fox.checkFoxSpawnRules" {
        return Rule.Fox
    }
    if name == "Parrot.checkParrotSpawnRules" {
        return Rule.Parrot
    }
    if name == "Turtle.checkTurtleSpawnRules" {
        return Rule.Turtle
    }
    if name == "Strider.checkStriderSpawnRules" {
        return Rule.Strider
    }
    if name == "AbstractNautilus.checkNautilusSpawnRules" {
        return Rule.Nautilus
    }
    if name == "GlowSquid.checkGlowSquidSpawnRules" {
        return Rule.GlowSquid
    }
    if name == "TropicalFish.checkTropicalFishSpawnRules" {
        return Rule.TropicalFish
    }
    if name == "WaterAnimal.checkSurfaceWaterAnimalSpawnRules" or name == "AgeableWaterCreature.checkSurfaceAgeableWaterCreatureSpawnRules" {
        return Rule.SurfaceWater
    }
    return Rule.Unknown
}

/// What natural spawning reads of a level: its blocks, heights, biomes and light, and which
/// chunks' entities tick. Each is asked only of a loaded chunk, or one beside it.
pub interface SpawnLevel {
    /// The state at the block, as `getBlockState` gives it: air outside the world's height.
    fn spawn_state(self, x: i32, y: i32, z: i32) -> u32
    /// The height of the column in heightmap `kind`, one above the highest block it counts, as
    /// `Level.getHeight` gives it.
    fn surface(self, kind: i32, x: i32, z: i32) -> i32
    /// The biome at the block, by its ID, as `getBiome` zooms it.
    fn biome(mut self, x: i32, y: i32, z: i32) -> i32
    /// The biome of the quart, by its ID, as `getNoiseBiome` gives it.
    fn noise_biome(self, qx: i32, qy: i32, qz: i32) -> i32
    /// The light at the block, the sky's if `sky`, as `getBrightness` gives it.
    fn light(self, sky: bool, x: i32, y: i32, z: i32) -> i32
    /// Whether the chunk's entities tick, `PersistentEntitySectionManager.canPositionTick`.
    fn entities_tick(self, chunk_x: i32, chunk_z: i32) -> bool
    /// How long players have been near the chunk, `getInhabitedTime`, where it's loaded in full;
    /// none where it isn't (CAL-156).
    fn inhabited_at(self, chunk_x: i32, chunk_z: i32) -> i64?
    /// Whether players may be near the chunk for mobs to spawn, `hasPlayersNearby` as
    /// `getPlayersCloseForSpawning` reads it, where they're looked for unless it's sure they
    /// aren't.
    fn players_near(mut self, chunk_x: i32, chunk_z: i32) -> bool
    /// The structures' starts the block's chunk refers to, `getAllStructuresAt` and
    /// `fillStartsForStructure`, in the order of its references; none of those that aren't held
    /// (CAL-309).
    fn starts_at(self, x: i32, y: i32, z: i32) -> List<StartAt>
}

/// What natural spawning makes its mobs with (CAL-156).
pub interface MobMaker {
    /// `getMobForSpawn`: a new mob of the type `type_id` at x, y, z, its ID and its own random
    /// taken as its constructor takes them; none where Calcite doesn't make the type yet.
    fn make(mut self, type_id: i32, x: f64, y: f64, z: f64) -> Mob?
    /// Where the mob's to be finalized, in the biome `biome` where it stands: what its kind draws
    /// by there, a farm animal's variants to spawn as and a sheep's climate.
    fn spawning_in(self, mob: mut Mob, biome: i32)
    /// `isUnobstructed`: whether nothing that blocks building, `blocksBuilding`, isn't gone and
    /// isn't a spectator has a box that meets `b`.
    fn unobstructed(self, b: Aabb) -> bool
    /// `addFreshEntityWithPassengers`: the mob in the level.
    fn add(mut self, mob: own Mob)
}

/// What natural spawning counts of a level's mobs this tick, `SpawnState` (CAL-156): how many
/// chunks the natural spawn counter counts; how many mobs the level has of each category, of
/// those that needn't stay; and for each of its players, those in the chunks they're near,
/// `LocalMobCapCalculator`. A player is near a chunk for spawning within 128 blocks of its
/// middle, unless a spectator, where it may have players nearby.
pub struct SpawnState {
    pub chunks: i32
    pub counts: List<i32>
    players: List<SpawnerPlayer>
    // The players near each chunk asked of, by `ChunkPos.pack`, as the tick has them; and each
    // player's counts, none until one's counted near them.
    near: Map<i64, List<usize>> = Map<i64, List<usize>>()
    local: List<List<i32>?>
}

impl SpawnState {
    /// None counted, for `chunks` chunks and the level's `players`, in its order.
    pub fn new(chunks: i32, players: own List<SpawnerPlayer>) -> SpawnState {
        var counts = List<i32>()
        for _ in categories() {
            counts.push(0)
        }
        var local = List<List<i32>?>()
        for _ in players {
            local.push(none)
        }
        return SpawnState { chunks: chunks, counts: counts, players: players, local: local }
    }

    /// `createState`'s count of a mob of `category` at x, z that needn't stay, in a loaded chunk:
    /// one more of its category, and of it near each player near its chunk; none of `MISC`.
    pub fn count<L: SpawnLevel>(mut self, level: mut L, category: i32, x: f64, z: f64) {
        if category == MISC {
            return
        }
        self.add_mob(mut level, category, x, z)
    }

    /// `afterSpawn`: the mob of `category` spawned at x, z counted.
    pub fn after_spawn<L: SpawnLevel>(mut self, level: mut L, category: i32, x: f64, z: f64) {
        self.add_mob(mut level, category, x, z)
    }

    // One more of `category`, and of it near each player near the chunk of x, z, `addMob`.
    fn add_mob<L: SpawnLevel>(mut self, level: mut L, category: i32, x: f64, z: f64) {
        let c = usize.wrap(category)
        self.counts[c] += 1
        let near = self.players_near(mut level, i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
        for p in near {
            var counts = List<i32>()
            if let l = self.local[p] {
                counts = l.copy()
            } else {
                for _ in categories() {
                    counts.push(0)
                }
            }
            counts[c] += 1
            self.local[p] = some(counts)
        }
    }

    /// Whether `category` may spawn at all this tick, `canSpawnForCategoryGlobal`: fewer of it
    /// than its most a chunk over the chunks counted.
    pub fn can_spawn_global(self, category: i32) -> bool {
        return self.counts[usize.wrap(category)] < max_per_chunk(category) * self.chunks / 289
    }

    /// Whether `category` may spawn in the chunk, `canSpawnForCategoryLocal`: a player near it
    /// has none counted, or fewer of it than its most a chunk.
    pub fn can_spawn_local<L: SpawnLevel>(mut self, level: mut L, category: i32, chunk_x: i32, chunk_z: i32) -> bool {
        let near = self.players_near(mut level, chunk_x, chunk_z)
        for p in near {
            if let l = self.local[p] {
                if l[usize.wrap(category)] < max_per_chunk(category) {
                    return true
                }
            } else {
                return true
            }
        }
        return false
    }

    // The players near the chunk for spawning, `getPlayersCloseForSpawning`, by their places in
    // the level's order, kept for the tick as vanilla keeps them.
    fn players_near<L: SpawnLevel>(mut self, level: mut L, chunk_x: i32, chunk_z: i32) -> List<usize> {
        let k = (i64(chunk_z) << 32) | (i64(chunk_x) & 4294967295)
        if self.near.contains(k) {
            return self.near[k].copy()
        }
        var out = List<usize>()
        if level.players_near(chunk_x, chunk_z) {
            let mid_x = f64(chunk_x * 16 + 8)
            let mid_z = f64(chunk_z * 16 + 8)
            for i in 0..self.players.len() {
                let p = self.players[i]
                if p.spectator {
                    continue
                }
                let dx = mid_x - p.x
                let dz = mid_z - p.z
                if dx * dx + dz * dz < 16384.0 {
                    out.push(i)
                }
            }
        }
        self.near.insert(k, out.copy())
        return out
    }
}

/// What natural spawning knows of the world's blocks and entity types, the same for every level.
pub struct Natural {
    pub types: List<TypeFacts>
    rules: List<Rule>
    spawn_facts: List<u32>
    pub facts: Facts
    collisions: CollisionStates
    // Whether each state is a liquid, water or lava itself, which has no shape for a mob's room.
    liquid: List<bool>
    prevent_inside: BlockSet
    fire: BlockSet
    campfires: BlockSet
    animals_on: BlockSet
    // `#leaves`, which an ocelot spawns on, as on a grass block (CAL-201).
    leaves: BlockSet
    // `#rabbits_spawnable_on`, which a rabbit spawns on (CAL-201).
    rabbits_on: BlockSet
    // `#goats_spawnable_on`, which a goat spawns on (CAL-207).
    goats_on: BlockSet
    // `#camels_spawnable_on`, which a camel spawns on (CAL-207).
    camels_on: BlockSet
    // `#foxes_spawnable_on`, which a fox spawns on, and `#parrots_spawnable_on`, which a parrot
    // does (CAL-201).
    foxes_on: BlockSet
    parrots_on: BlockSet
    // `#sand`, which a turtle spawns on (CAL-201).
    sand: BlockSet
    // `#polar_bears_spawnable_on_alternate`, which a polar bear spawns on in the biomes that say
    // so (CAL-201).
    polar_alternate: BlockSet
    mooshrooms_on: BlockSet
    armadillos_on: BlockSet
    wolves_on: BlockSet
    bats_on: BlockSet
    // The tags types are immune to, in `immune_tags`' order.
    immune_sets: List<BlockSet>
    lava: u32
    magma_block: u32
    lava_cauldron: u32
    wither_rose: u32
    sweet_berry_bush: u32
    cactus: u32
    powder_snow: u32
    water: u32
    mycelium: u32
    grass_block: u32
    nether_wart_block: u32
    // Each state's path facts, for `isPathfindable` (CAL-161).
    paths: PathStates
    // Whether each state is one an iron golem a villager summons won't stand on whatever's above,
    // `SpawnUtil.Strategy.LEGACY_IRON_GOLEM`'s blocks (CAL-201).
    golem_refused: List<bool>
    // Whether each state may be the ground of one, solid in the legacy way or powder snow.
    golem_ground: List<bool>
}

impl Natural {
    /// What spawning reads, from `facts`, the world's blocks, fluids and their tags.
    pub fn new(facts: own Facts) -> Natural ! String {
        let all = types()
        let spawn_facts = state_spawn_facts()
        if spawn_facts.len() != usize(facts.table.len()) {
            fail "{spawn_facts.len()} states' spawn facts for {facts.table.len()} states"
        }
        var rules_by = List<Rule>()
        for name in rules() {
            rules_by.push(rule_of(name))
        }
        var immune_sets = List<BlockSet>()
        for name in immune_tags() {
            immune_sets.push(facts.tag(name))
        }
        let prevent_inside = facts.tag(String("minecraft:prevent_mob_spawning_inside"))
        let fire = facts.tag(String("minecraft:fire"))
        let campfires = facts.tag(String("minecraft:campfires"))
        let animals_on = facts.tag(String("minecraft:animals_spawnable_on"))
        let leaves = facts.tag(String("minecraft:leaves"))
        let rabbits_on = facts.tag(String("minecraft:rabbits_spawnable_on"))
        let goats_on = facts.tag(String("minecraft:goats_spawnable_on"))
        let camels_on = facts.tag(String("minecraft:camels_spawnable_on"))
        let foxes_on = facts.tag(String("minecraft:foxes_spawnable_on"))
        let parrots_on = facts.tag(String("minecraft:parrots_spawnable_on"))
        let sand = facts.tag(String("minecraft:sand"))
        let polar_alternate = facts.tag(String("minecraft:polar_bears_spawnable_on_alternate"))
        let mooshrooms_on = facts.tag(String("minecraft:mooshrooms_spawnable_on"))
        let armadillos_on = facts.tag(String("minecraft:armadillo_spawnable_on"))
        let wolves_on = facts.tag(String("minecraft:wolves_spawnable_on"))
        let bats_on = facts.tag(String("minecraft:bats_spawnable_on"))
        let lava = try block_id(facts, "minecraft:lava")
        let magma_block = try block_id(facts, "minecraft:magma_block")
        let lava_cauldron = try block_id(facts, "minecraft:lava_cauldron")
        let wither_rose = try block_id(facts, "minecraft:wither_rose")
        let sweet_berry_bush = try block_id(facts, "minecraft:sweet_berry_bush")
        let cactus = try block_id(facts, "minecraft:cactus")
        let powder_snow = try block_id(facts, "minecraft:powder_snow")
        let water = try block_id(facts, "minecraft:water")
        let mycelium = try block_id(facts, "minecraft:mycelium")
        let grass_block = try block_id(facts, "minecraft:grass_block")
        let nether_wart_block = try block_id(facts, "minecraft:nether_wart_block")
        var liquid = List<bool>()
        for s in 0..facts.table.len() {
            liquid.push(facts.is_liquid(s))
        }
        let paths = PathStates.new(facts)
        let (golem_refused, golem_ground) = golem_states(facts, powder_snow)
        return Natural {
            types: all,
            rules: rules_by,
            spawn_facts: spawn_facts,
            facts: facts,
            collisions: CollisionStates.new(),
            liquid: liquid,
            prevent_inside: prevent_inside,
            fire: fire,
            campfires: campfires,
            animals_on: animals_on,
            leaves: leaves,
            rabbits_on: rabbits_on,
            goats_on: goats_on,
            camels_on: camels_on,
            foxes_on: foxes_on,
            parrots_on: parrots_on,
            sand: sand,
            polar_alternate: polar_alternate,
            mooshrooms_on: mooshrooms_on,
            armadillos_on: armadillos_on,
            wolves_on: wolves_on,
            bats_on: bats_on,
            immune_sets: immune_sets,
            lava: lava,
            magma_block: magma_block,
            lava_cauldron: lava_cauldron,
            wither_rose: wither_rose,
            sweet_berry_bush: sweet_berry_bush,
            cactus: cactus,
            powder_snow: powder_snow,
            water: water,
            mycelium: mycelium,
            grass_block: grass_block,
            nether_wart_block: nether_wart_block,
            paths: paths,
            golem_refused: golem_refused,
            golem_ground: golem_ground,
        }
    }

    // `NaturalSpawner.isValidEmptySpawnBlock` of the state with its fluid taken as none,
    // `Fluids.EMPTY`'s, as `IronGolem.checkSpawnObstruction` asks of its own block (CAL-201).
    fn empty_spawn_block_dry(self, state: u32, type_id: i32) -> bool {
        if self.facts.collision_full_block(state) or self.spawn_facts[usize(state)] & SIGNAL_SOURCE != 0 {
            return false
        }
        if self.facts.in_set(state, self.prevent_inside) {
            return false
        }
        return not self.dangerous(type_id, state)
    }

    // `containsAnyLiquid`: whether a block from the one at the box's least corner to the one at
    // its greatest has a fluid.
    fn any_fluid<L: SpawnLevel>(self, level: L, b: Aabb) -> bool {
        let x1 = i32.saturate(b.max_x.floor())
        let y1 = i32.saturate(b.max_y.floor())
        let z1 = i32.saturate(b.max_z.floor())
        for x in i32.saturate(b.min_x.floor())..=x1 {
            for y in i32.saturate(b.min_y.floor())..=y1 {
                for z in i32.saturate(b.min_z.floor())..=z1 {
                    if self.facts.fluid(level.spawn_state(x, y, z)) != 0 {
                        return true
                    }
                }
            }
        }
        return false
    }

    // `isValidSpawn` of the state for the type: `BlockState.isValidSpawn`, by its group.
    fn valid_spawn(self, state: u32, t: TypeFacts) -> bool {
        return self.spawn_facts[usize(state)] & (1u32 << (VALID_SPAWN_SHIFT + u32.wrap(t.spawn_group))) != 0
    }

    // `NodeEvaluator.isBurningBlock`.
    fn burning(self, state: u32) -> bool {
        if self.facts.in_set(state, self.fire) or self.facts.is(state, self.lava) or self.facts.is(state, self.magma_block) {
            return true
        }
        if self.facts.in_set(state, self.campfires) and self.facts.get_bool(state, String("lit")) {
            return true
        }
        return self.facts.is(state, self.lava_cauldron)
    }

    // `EntityType.isBlockDangerous`.
    fn dangerous(self, type_id: i32, state: u32) -> bool {
        let t = self.types[usize.wrap(type_id)]
        if self.facts.in_set(state, self.immune_sets[usize.wrap(t.immune_to)]) {
            return false
        }
        if t.flags & FIRE_IMMUNE == 0 and self.burning(state) {
            return true
        }
        return self.facts.is(state, self.wither_rose) or self.facts.is(state, self.sweet_berry_bush) or self.facts.is(state, self.cactus) or self.facts.is(state, self.powder_snow)
    }

    // `NaturalSpawner.isValidEmptySpawnBlock`.
    pub fn empty_spawn_block(self, state: u32, type_id: i32) -> bool {
        if self.facts.collision_full_block(state) {
            return false
        }
        if self.spawn_facts[usize(state)] & SIGNAL_SOURCE != 0 {
            return false
        }
        if self.facts.fluid(state) != 0 {
            return false
        }
        if self.facts.in_set(state, self.prevent_inside) {
            return false
        }
        return not self.dangerous(type_id, state)
    }

    // Whether the state's fluid is in the fluid tag `name`, as `FluidState.is` reads it.
    fn fluid_in(self, state: u32, name: str) -> bool {
        return self.facts.fluid_in(state, String(name))
    }
}

// The block `name`'s ID.
fn block_id(facts: Facts, name: str) -> u32 ! String {
    let b = facts.block_named(String(name)) else fail "there's no block {name}"
    return b
}

/// What spawning reads of a dimension that stays the same: what spawns in each biome, and the
/// biome tags and attributes its rules read.
pub struct Mobs {
    /// Each biome's mobs, by the biome's ID: the biome's `natural_mob_spawns` over the dimension
    /// type's.
    pub by_biome: List<MobSettings>
    /// Each biome's attribute map, as the registries keep it, and whether it's in
    /// `#reduced_water_ambient_spawns` and `#allows_surface_slime_spawns`.
    pub attributes: List<Tag>
    pub reduced_water: List<bool>
    pub surface_slimes: List<bool>
    /// And whether it's in `#more_frequent_drowned_spawns` (CAL-175).
    pub frequent_drowned: List<bool> = List<bool>()
    /// And whether it's in `#polar_bears_spawn_on_alternate_blocks` (CAL-201).
    pub polar_alternate: List<bool> = List<bool>()
    /// And whether it's in `#allows_tropical_fish_spawns_at_any_height` (CAL-201).
    pub tropical_anywhere: List<bool> = List<bool>()
    /// The structures that spawn their own mobs, by ID (CAL-309), and
    /// `NetherFortressStructure.FORTRESS_ENEMIES`.
    pub structures: Map<String, StructureSpawns> = Map<String, StructureSpawns>()
    pub fortress: List<Spawner> = List<Spawner>()
}

/// What a structure spawns in place of the biome's, `Structure.spawnOverrides` (CAL-309): by its
/// ID, whether its box is grown by 12 for its terrain adaptation, `adjustBoundingBox`, and each
/// category's override, in `MobCategory` order, none where it hasn't one: whether it holds by
/// pieces rather than the whole box, `BoundingBoxType.PIECE`, and its mobs.
pub struct StructureSpawns {
    pub id: String
    pub adapted: bool
    /// Whether it's in `#cats_spawn_in`, where `CatSpawner` spawns a cat.
    pub cats: bool
    pub overrides: List<(bool, List<Spawner>)?>
}

/// A structure's start that a place's chunk refers to (CAL-309): its structure's ID, whether one
/// of its pieces holds the place, and the box about its pieces, before its structure adjusts it.
pub struct StartAt {
    pub structure: String
    pub piece: bool
    pub min_x: i32
    pub min_y: i32
    pub min_z: i32
    pub max_x: i32
    pub max_y: i32
    pub max_z: i32
}

impl StartAt {
    /// Whether its box, grown by `by`, holds the block, `BoundingBox.isInside`.
    pub fn holds(self, by: i32, x: i32, y: i32, z: i32) -> bool {
        return x >= self.min_x - by and x <= self.max_x + by and y >= self.min_y - by and y <= self.max_y + by and z >= self.min_z - by and z <= self.max_z + by
    }
}

/// The mobs of `items`, a spawn list as the codec writes it in NBT, each `{type, count, weight}`;
/// `entity_types` are the entity types' IDs, in ID order, and one of a type that isn't one is
/// left out.
pub fn spawners_of(items: List<Tag>, entity_types: List<Identifier>) -> List<Spawner> {
    var list = List<Spawner>()
    for item in items {
        let Tag.Str(name) = field(item, "type") else continue
        let id = match Identifier.parse(name) {
            ok(i) => i,
            err(_) => continue,
        }
        var type_id: i32? = none
        for i in 0..entity_types.len() {
            if entity_types[i] == id {
                type_id = some(i32.wrap(i))
                break
            }
        }
        let t = type_id else continue
        let weight = match field(item, "weight") {
            Tag.Int(w) => w,
            Tag.Short(w) => i32(w),
            Tag.Byte(w) => i32(w),
            _ => 0,
        }
        list.push(Spawner { type_id: t, count: count_of(field(item, "count")), weight: weight })
    }
    return list
}

/// A structure's spawns as Calcite keeps them in its `calcite:structure_spawns` registry: `id`,
/// and `tag`, `{adapted, overrides, cats}`, `overrides` each category's `{piece, spawns}` by its
/// serialized name.
pub fn structure_spawns_of(id: own String, tag: Tag, entity_types: List<Identifier>) -> StructureSpawns {
    let adapted = match field(tag, "adapted") {
        Tag.Byte(b) => b != 0,
        _ => false,
    }
    let by = field(tag, "overrides")
    var overrides = List<(bool, List<Spawner>)?>()
    for name in category_names() {
        let o = field_named(by, name)
        if o == Tag.End {
            overrides.push(none)
            continue
        }
        let piece = match field(o, "piece") {
            Tag.Byte(b) => b != 0,
            _ => false,
        }
        let items = match field(o, "spawns") {
            Tag.List(l) => l.copy(),
            _ => List<Tag>(),
        }
        overrides.push(some((piece, spawners_of(items, entity_types))))
    }
    let cats = match field(tag, "cats") {
        Tag.Byte(b) => b != 0,
        _ => false,
    }
    return StructureSpawns { id: id, adapted: adapted, cats: cats, overrides: overrides }
}

/// Whether a piece of a structure in `#cats_spawn_in` holds the place, of those whose starts are
/// `starts`: `getStructureWithPieceAt(pos, CATS_SPAWN_IN).isValid()` (CAL-309).
pub fn cats_spawn_in(mobs: Mobs, starts: List<StartAt>) -> bool {
    for s in starts {
        if s.piece and mobs.structures.contains(s.structure) and mobs.structures[s.structure].cats {
            return true
        }
    }
    return false
}

/// What spawning reads of a level this tick.
pub struct SpawnPlace {
    /// The world's bottom and the generator's sea level.
    pub min_y: i32
    pub sea_level: i32
    /// The world's seed, which slime chunks hang on.
    pub seed: i64
    pub peaceful: bool
    pub thundering: bool
    /// How far the sky's light is under 15, `skyDarken`.
    pub sky_darken: i32
    /// The border's edges, as `isWithinBounds` reads them.
    pub min_x: f64
    pub max_x: f64
    pub min_z: f64
    pub max_z: f64
    /// The world's spawn, `getRespawnData`'s position, where it's in this level.
    pub respawn: (i32, i32, i32)?
    /// The level's players, in the order `players()` has them.
    pub players: List<SpawnerPlayer>
    /// The dimension type's `monster_spawn_light_level` and `monster_spawn_block_light_limit`, and
    /// its `ambient_light`.
    pub light_test: IntProvider
    pub block_light_limit: i32
    pub ambient_light: f32 = 0.0f32
    /// Each biome's `surface_slime_spawn_chance` this tick, by its ID.
    pub slime_chances: List<f32>
    /// What local difficulty reads (CAL-156): the world's difficulty, the overworld clock's ticks,
    /// `getOverworldClockTime`, and the moon's brightness, `getMoonBrightness`; and whether it's
    /// Halloween.
    pub difficulty: Difficulty = Difficulty.Normal
    pub clock: i64 = 0
    pub moon: f32 = 0.0f32
    pub halloween: bool = false
    /// Whether it spawns monsters, `isSpawningMonsters`, as what's finalized reads (CAL-392).
    pub monsters: bool = true
    /// The level's game time, `getGameTime`, as a camel's pose counts from it (CAL-207).
    pub game_time: i64 = 0
}

impl SpawnPlace {
    // `WorldBorder.isWithinBounds(x, z)`.
    fn within(self, x: f64, z: f64) -> bool {
        return x >= self.min_x and x < self.max_x and z >= self.min_z and z < self.max_z
    }

    // `hasNearbyAlivePlayer`: a player alive and not spectating nearer x, y, z than `range`.
    fn alive_player_within(self, x: f64, y: f64, z: f64, range: f64) -> bool {
        for p in self.players {
            if p.spectator or not p.alive {
                continue
            }
            let dx = p.x - x
            let dy = p.y - y
            let dz = p.z - z
            if dx * dx + dy * dy + dz * dz < range * range {
                return true
            }
        }
        return false
    }
}

/// `Zombie.hurtServer`'s reinforcements for `zombie`, hurt on hard by a draw under its chance
/// (CAL-159), coming for `target`. A mob of its type is made first, `EntityType.create` with
/// `REINFORCEMENT`, its ID taken whether or not it's placed. Then up to 50 tries, each a place 7 to
/// 40 blocks off on each axis or none, by six of the zombie's own draws, `Mth.nextInt`: at the
/// first where its type may be placed and its spawn rules let it, `isSpawnPositionOk` and
/// `checkSpawnRules` with the level's random `r`, it's put at the place's corner, `setPos`; and
/// where no player alive and not spectating is within 7, nothing that blocks building meets its
/// box, no block collides with it and no fluid's in it, it's finalized with the local difficulty
/// there, its target taken up first, added, and the two charged, `charge_reinforcement`, which
/// its finalizing's chance doesn't touch. Whether one came.
pub fn reinforce<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, zombie: mut Mob, target: i32, r: mut T) -> bool ! Thrown {
    let type_id = i32.wrap(zombie.living.kind)
    let x = i32.saturate(zombie.living.body.x.floor())
    let y = i32.saturate(zombie.living.body.y.floor())
    let z = i32.saturate(zombie.living.body.z.floor())
    var made = maker.make(type_id, 0.0, 0.0, 0.0) else return false
    for _ in 0..50 {
        let xt = x + (zombie.living.body.random.next_int_below(34) + 7) * (zombie.living.body.random.next_int_below(3) - 1)
        let yt = y + (zombie.living.body.random.next_int_below(34) + 7) * (zombie.living.body.random.next_int_below(3) - 1)
        let zt = z + (zombie.living.body.random.next_int_below(34) + 7) * (zombie.living.body.random.next_int_below(3) - 1)
        if not position_ok(n, place, level, type_id, xt, yt, zt) {
            continue
        }
        if not try spawn_rules(n, mobs, place, mut level, type_id, xt, yt, zt, mut r) {
            continue
        }
        made.living.body.x = f64(xt)
        made.living.body.y = f64(yt)
        made.living.body.z = f64(zt)
        // Where it was as its first tick begins, `setOldPosAndRot`, the same.
        made.living.body.xo = f64(xt)
        made.living.body.yo = f64(yt)
        made.living.body.zo = f64(zt)
        let b = made.living.body.bounding_box()
        if place.alive_player_within(f64(xt), f64(yt), f64(zt), 7.0) or not maker.unobstructed(b) {
            continue
        }
        // A drowned's may be in a liquid, `canSpawnInLiquids` (CAL-175).
        if not n.collisions.no_collision_without_fluids(level, b, n.liquid) or (made.species != DROWNED and n.any_fluid(level, b)) {
            continue
        }
        made.take_target(target)
        maker.spawning_in(mut made, level.biome(xt, yt, zt))
        let o = Occasion { local: difficulty_at(place, level, xt, zt), halloween: place.halloween, natural: false }
        _ = made.finalize_spawn(none, o, mut maker, mut r)
        zombie.charge_reinforcement(mut made)
        maker.add(made)
        return true
    }
    return false
}

/// `SpawnUtil.trySpawnMob` of the iron golem of the type `type_id` that a villager whose block is
/// x, y, z summons, `spawnGolemIfNeeded` (CAL-201), `MOB_SUMMONED`, by `LEGACY_IRON_GOLEM`, no
/// collisions checked. Up to 10 tries, each a column up to 8 off on each axis, by two of the
/// level's draws, `Mth.randomBetweenInclusive`, within the border, looked down from 6 above to 6
/// below for ground it may stand on, `moveToPossibleSpawnPosition`: where there's some, a golem
/// made above it, its ID and own random taken, `EntityType.create`, at its middle facing a draw,
/// `snapTo`, its head and body that way, finalized, `finalizeSpawn`; then kept where its spawn
/// rules let it, a pathfinding mob's walk target's value 0 here, and it has room,
/// `IronGolem.checkSpawnObstruction`, added, `addFreshEntityWithPassengers`, its ambient sound
/// none. Whether one came.
pub fn summon_golem<L: SpawnLevel, M: MobMaker + Making, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, maker: mut M, type_id: i32, x: i32, y: i32, z: i32, r: mut T) -> bool {
    for _ in 0..10 {
        let sx = x + r.next_int_below(17) - 8
        let sz = z + r.next_int_below(17) - 8
        if not place.within(f64(sx), f64(sz)) {
            continue
        }
        let sy = ground_for_golem(n, level, sx, y + 6, sz) else continue
        let (gx, gy, gz) = (f64(sx) + 0.5, f64(sy), f64(sz) + 0.5)
        var golem = maker.make(type_id, gx, gy, gz) else return false
        let yaw = wrap_degrees(r.next_float() * 360.0f32)
        golem.living.snap_to(gx, gy, gz, yaw, 0.0f32)
        golem.living.y_head_rot = yaw
        golem.living.y_body_rot = yaw
        let o = Occasion { local: difficulty_at(place, level, sx, sz), halloween: place.halloween, natural: false }
        _ = golem.finalize_spawn(none, o, mut maker, mut r)
        if golem_room(n, level, maker, golem, type_id, sx, sy, sz) {
            maker.add(golem)
            return true
        }
    }
    return false
}

/// `SpawnUtil.trySpawnMob` of a warden, of the type `type_id`, that the sculk shrieker at x, y, z
/// calls, `trySummonWarden` (CAL-207), `TRIGGERED`, by `ON_TOP_OF_COLLIDER`, no collisions
/// checked: up to 20 tries, each a column up to 5 off on each axis across, by two of the level's
/// draws, within the border, looked down from 6 above to 6 below for a block whose collision's
/// top is full under one with none, `moveToPossibleSpawnPosition`: where there's one, a warden
/// made above it as `summon_golem` makes a golem, finalized, `finalizeSpawn`, emerging and heard
/// agitated; then kept where it has room, `checkSpawnObstruction`, no liquid nor anything in its
/// box as it emerges and no block in its box as it stands, added; its spawn rules,
/// `PathfinderMob.checkSpawnRules`, let it anywhere, its walk target's value 0 everywhere. Where
/// each warden made was heard, and whether one came. Entities' collisions aren't in Calcite's
/// spawns yet.
pub fn summon_warden<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, maker: mut M, type_id: i32, x: i32, y: i32, z: i32, r: mut T) -> (List<(f64, f64, f64)>, bool) {
    var heard = List<(f64, f64, f64)>()
    for _ in 0..20 {
        let sx = x + r.next_int_below(11) - 5
        let sz = z + r.next_int_below(11) - 5
        if not place.within(f64(sx), f64(sz)) {
            continue
        }
        let sy = on_top_of_collider(n, level, sx, y + 6, sz) else continue
        let (wx, wy, wz) = (f64(sx) + 0.5, f64(sy), f64(sz) + 0.5)
        var warden = maker.make(type_id, wx, wy, wz) else return (heard, false)
        let yaw = wrap_degrees(r.next_float() * 360.0f32)
        warden.living.snap_to(wx, wy, wz, yaw, 0.0f32)
        warden.living.y_head_rot = yaw
        warden.living.y_body_rot = yaw
        let o = Occasion { local: difficulty_at(place, level, sx, sz), halloween: place.halloween, natural: false }
        _ = warden.finalize_spawn(none, o, mut maker, mut r)
        warden.warden_emerging()
        heard.push((wx, wy, wz))
        let b = warden.living.body.bounding_box()
        let half = f64(0.9f32) / 2.0
        let full = Aabb { min_x: wx - half, min_y: wy, min_z: wz - half, max_x: wx + half, max_y: wy + f64(2.9f32), max_z: wz + half }
        if not n.any_fluid(level, b) and maker.unobstructed(b) and n.collisions.no_collision_without_fluids(level, full, n.liquid) {
            maker.add(warden)
            return (heard, true)
        }
    }
    return (heard, false)
}

/// `SpawnUtil.trySpawnMob` of a creaking, of the type `type_id`, that the creaking heart at x, y,
/// z spawns, `spawnProtector` (CAL-412), `SPAWNER`, by `ON_TOP_OF_COLLIDER_NO_LEAVES`, collisions
/// checked: up to 5 tries, each a column up to 16 off on each axis across, by two of the level's
/// draws, within the border, looked down from 8 above to 8 below for a block whose collision's top
/// is full and that isn't `#leaves`, under one with none, `moveToPossibleSpawnPosition`, where
/// there's no collision in a creaking's box above it, `noCollision`: a creaking made there, facing
/// where the level's random draws, finalized, `finalizeSpawn`; kept where it has room,
/// `Mob.checkSpawnObstruction`, no liquid nor anything that blocks building in its box. Its spawn
/// rules, `PathfinderMob.checkSpawnRules`, let it anywhere, its walk target's value 0 everywhere.
/// Entities' collisions aren't in Calcite's spawns yet.
pub fn spawn_creaking<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, maker: mut M, type_id: i32, x: i32, y: i32, z: i32, r: mut T) -> Mob? {
    for _ in 0..5 {
        let sx = x + r.next_int_below(33) - 16
        let sz = z + r.next_int_below(33) - 16
        if not place.within(f64(sx), f64(sz)) {
            continue
        }
        let sy = on_top_of_collider_from(n, level, sx, y + 8, sz, 17, true) else continue
        let (wx, wy, wz) = (f64(sx) + 0.5, f64(sy), f64(sz) + 0.5)
        let half = f64(0.9f32) / 2.0
        let room = Aabb { min_x: wx - half, min_y: wy, min_z: wz - half, max_x: wx + half, max_y: wy + f64(2.7f32), max_z: wz + half }
        if not n.collisions.no_collision_without_fluids(level, room, n.liquid) {
            continue
        }
        var creaking = maker.make(type_id, wx, wy, wz) else return none
        let yaw = wrap_degrees(r.next_float() * 360.0f32)
        creaking.living.snap_to(wx, wy, wz, yaw, 0.0f32)
        creaking.living.y_head_rot = yaw
        creaking.living.y_body_rot = yaw
        let o = Occasion { local: difficulty_at(place, level, sx, sz), halloween: place.halloween, natural: false }
        _ = creaking.finalize_spawn(none, o, mut maker, mut r)
        let b = creaking.living.body.bounding_box()
        if not n.any_fluid(level, b) and maker.unobstructed(b) {
            return some(creaking)
        }
    }
    return none
}

// `moveToPossibleSpawnPosition` down the column x, z from `top`, `tries` blocks, by
// `ON_TOP_OF_COLLIDER`, or `ON_TOP_OF_COLLIDER_NO_LEAVES` where `no_leaves` (CAL-412): the block
// above the first whose collision's top is full, and that isn't `#leaves` where `no_leaves`, with
// one above it with no collision; none where there's none.
fn on_top_of_collider_from<L: SpawnLevel>(n: Natural, level: L, x: i32, top: i32, z: i32, tries: i32, no_leaves: bool) -> i32? {
    var above = level.spawn_state(x, top, z)
    var y = top
    for _ in 0..tries {
        y -= 1
        let state = level.spawn_state(x, y, z)
        if n.collisions.shapeless(above, n.liquid) and not (no_leaves and n.facts.in_set(state, n.leaves)) and n.facts.flags(state) & COLLISION_TOP_FULL != 0 {
            return some(y + 1)
        }
        above = state
    }
    return none
}

// `moveToPossibleSpawnPosition` by `ON_TOP_OF_COLLIDER` down the column x, z from `top` (CAL-207):
// the block above the first, going down from just under `top` 13 blocks, whose collision's top is
// full, `isFaceFull`, with one above it with no collision; none where there's none.
fn on_top_of_collider<L: SpawnLevel>(n: Natural, level: L, x: i32, top: i32, z: i32) -> i32? {
    var above = level.spawn_state(x, top, z)
    var y = top
    for _ in 0..13 {
        y -= 1
        let state = level.spawn_state(x, y, z)
        if n.collisions.shapeless(above, n.liquid) and n.facts.flags(state) & COLLISION_TOP_FULL != 0 {
            return some(y + 1)
        }
        above = state
    }
    return none
}

// `moveToPossibleSpawnPosition` by `LEGACY_IRON_GOLEM` down the column x, z from `top`: the block
// above the first, going down from just under `top` 13 blocks, that isn't one of the strategy's
// and is solid or powder snow, with air or a liquid above it; none where there's none.
fn ground_for_golem<L: SpawnLevel>(n: Natural, level: L, x: i32, top: i32, z: i32) -> i32? {
    var above = level.spawn_state(x, top, z)
    var y = top
    for _ in 0..13 {
        y -= 1
        let state = level.spawn_state(x, y, z)
        if not n.golem_refused[usize(state)] and (n.facts.is_air(above) or n.liquid[usize(above)]) and n.golem_ground[usize(state)] {
            return some(y + 1)
        }
        above = state
    }
    return none
}

// `IronGolem.checkSpawnObstruction` of `golem` at the block x, y, z: the block below one it may
// stand on, `entityCanStandOn`, the top of its collision shape full, scaffolding's as it's above
// it; the two above it valid empty spawn blocks, `isValidEmptySpawnBlock`, and its own one taken
// as dry; and nothing that blocks building in its box, `isUnobstructed`.
fn golem_room<L: SpawnLevel, M: MobMaker>(n: Natural, level: L, maker: M, golem: Mob, type_id: i32, x: i32, y: i32, z: i32) -> bool {
    let below = level.spawn_state(x, y - 1, z)
    let scaffolding = n.facts.block_named(String("minecraft:scaffolding")) == some(n.facts.block(below))
    if not scaffolding and n.facts.flags(below) & COLLISION_TOP_FULL == 0 {
        return false
    }
    for i in 1..3 {
        if not n.empty_spawn_block(level.spawn_state(x, y + i, z), type_id) {
            return false
        }
    }
    return n.empty_spawn_block_dry(level.spawn_state(x, y, z), type_id) and maker.unobstructed(golem.living.body.bounding_box())
}

// For each state of `facts`, whether it's one of `LEGACY_IRON_GOLEM`'s blocks, which a summoned
// golem won't stand on: cobweb, cactus, glass and glass panes, stained, tinted or not, leaves,
// conduits, ice and frosted ice, TNT, glowstone, beacons and sea lanterns; and whether it's
// ground it may stand on, `isSolid` or powder snow (CAL-201).
fn golem_states(facts: Facts, powder_snow: u32) -> (List<bool>, List<bool>) {
    var named = List<u32>()
    for name in ["cobweb", "cactus", "glass_pane", "conduit", "ice", "tnt", "glowstone", "beacon", "sea_lantern", "frosted_ice", "tinted_glass", "glass"] {
        if let b = facts.block_named("minecraft:{name}") {
            named.push(b)
        }
    }
    var refused = List<bool>()
    var ground = List<bool>()
    var last = u32.MAX
    var last_refused = false
    for s in 0..facts.table.len() {
        let state = s
        let block = facts.block(state)
        if block != last {
            last = block
            let class = facts.class_name(block)
            last_refused = named.contains(block) or class == "StainedGlassBlock" or class == "StainedGlassPaneBlock" or class.ends_with("LeavesBlock")
        }
        refused.push(last_refused)
        ground.push(facts.is_solid(state) or block == powder_snow)
    }
    return (refused, ground)
}

/// `MobCategory.isFriendly` and `isPersistent`, and `getMaxInstancesPerChunk`.
pub fn friendly(category: i32) -> bool {
    return category != MONSTER
}

pub fn persistent(category: i32) -> bool {
    return category == CREATURE or category == MISC
}

pub fn max_per_chunk(category: i32) -> i32 {
    if category == MONSTER {
        return 70
    }
    if category == CREATURE {
        return 10
    }
    if category == AMBIENT {
        return 15
    }
    if category == WATER_AMBIENT {
        return 20
    }
    if category == MISC {
        return -1
    }
    return 5
}

/// The categories that may spawn this tick, `getFilteredSpawningCategories`: each but `MISC`, in
/// order, that's friendly or `enemies` lets spawn, that isn't persistent or `persistent` lets
/// spawn, and that's under the level's cap for it, as `state` counts.
pub fn spawning_categories(enemies: bool, persistent_too: bool, state: SpawnState) -> List<i32> {
    var out = List<i32>()
    for c in [MONSTER, CREATURE, AMBIENT, AXOLOTLS, UNDERGROUND_WATER_CREATURE, WATER_CREATURE, WATER_AMBIENT] {
        if not enemies and not friendly(c) {
            continue
        }
        if not persistent_too and persistent(c) {
            continue
        }
        if state.can_spawn_global(c) {
            out.push(c)
        }
    }
    return out
}

/// `Mth.ceil` of a float.
fn ceil_float(f: f32) -> i32 {
    let i = i32.saturate(f64(f))
    return if f > f32.nearest(i) { i + 1 } else { i }
}

/// `NaturalSpawner.spawnForChunk` for the chunk at `chunk_x`, `chunk_z`: each of `spawning` in
/// turn that's under its local cap there, as `state` counts, as `spawnCategoryForChunk` spawns
/// it, drawing from `r`, the level's random, its mobs made by `maker`.
pub fn spawn_for_chunk<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, state: mut SpawnState, chunk_x: i32, chunk_z: i32, spawning: List<i32>, r: mut T) ! Thrown {
    for c in spawning {
        if state.can_spawn_local(mut level, c, chunk_x, chunk_z) {
            try spawn_category_for_chunk(n, mobs, place, mut level, mut maker, mut state, chunk_x, chunk_z, c, mut r)
        }
    }
}

// `spawnCategoryForChunk`: a place in the chunk, as `getRandomPosWithin` picks it, a column and
// a height from the world's bottom up to one above the column's top. One at the bottom spawns
// nothing.
fn spawn_category_for_chunk<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, state: mut SpawnState, chunk_x: i32, chunk_z: i32, category: i32, r: mut T) ! Thrown {
    let x = chunk_x * 16 + r.next_int_below(16)
    let z = chunk_z * 16 + r.next_int_below(16)
    let surface = level.surface(WORLD_SURFACE, x, z)
    let y = r.next_int_below(surface - place.min_y + 1) + place.min_y
    if y < place.min_y + 1 {
        return
    }
    try spawn_category_for_position(n, mobs, place, mut level, mut maker, mut state, chunk_x, chunk_z, category, x, y, z, mut r)
}

// `spawnCategoryForPosition`: nothing in a block that conducts redstone. Then three packs, each
// of up to four steps, each a random walk of up to five blocks on x and z from the place, the
// first step's place picking the pack's mob and its size, which bounds the pack's steps from
// there. At each step whose place passes, its mob is made, turned, checked and finalized with
// the pack's group, and added; at the fourth from the place, that's all.
fn spawn_category_for_position<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, state: mut SpawnState, chunk_x: i32, chunk_z: i32, category: i32, x: i32, y: i32, z: i32, r: mut T) ! Thrown {
    if n.facts.redstone_conductor(level.spawn_state(x, y, z)) {
        return
    }
    var cluster = 0
    for _ in 0..3 {
        var px = x
        var pz = z
        var data: Spawner? = none
        var group: SpawnGroup? = none
        var size = ceil_float(r.next_float() * 4.0f32)
        var step = 0
        while step < size {
            px += r.next_int_below(6) - r.next_int_below(6)
            pz += r.next_int_below(6) - r.next_int_below(6)
            step += 1
            let fx = f64(px) + 0.5
            let fz = f64(pz) + 0.5
            let found = nearest_player(place.players, fx, f64(y), fz) else continue
            let (_, d) = found
            if not right_distance(place, level, chunk_x, chunk_z, px, y, pz, d) {
                continue
            }
            if data == none {
                let picked = try random_mob(n, mobs, mut level, category, px, y, pz, mut r) else break
                size = try picked.count.sample(mut r)
                data = some(picked)
            }
            let spawner = data else continue
            if not try valid_position_for_type(n, mobs, place, mut level, category, spawner, px, y, pz, d, mut r) {
                continue
            }
            // `extraTest`, `SpawnState.canSpawn`: the spawn potential, with nothing in it, lets
            // any spawn.
            var mob = maker.make(spawner.type_id, fx, f64(y), fz) else return
            let turn = r.next_float() * 360.0f32
            mob.living.snap_to(fx, f64(y), fz, turn, 0.0f32)
            if not valid_position_for_mob(n, place, level, maker, mob, px, y, pz, d) {
                continue
            }
            let biome = level.biome(px, y, pz)
            maker.spawning_in(mut mob, biome)
            var o = Occasion { local: difficulty_at(place, level, px, pz), halloween: place.halloween, monsters: place.monsters, frequent_drowned: flag_of(mobs.frequent_drowned, biome), game_time: place.game_time }
            if mob.species == HUSK {
                // A camel husk's spawn box, 1.7 across and 2.375 high, at the middle of the block
                // the husk's in, as `Husk.finalizeSpawn` asks of it (CAL-175).
                let (hx, hy, hz) = (f64(px) + 0.5, f64(y), f64(pz) + 0.5)
                let half = f64(1.7f32 / 2.0f32)
                let camel = Aabb { min_x: hx - half, min_y: hy, min_z: hz - half, max_x: hx + half, max_y: hy + f64(2.375f32), max_z: hz + half }
                o.camel_room = n.collisions.no_collision_without_fluids(level, camel, n.liquid)
            }
            group = mob.finalize_spawn(group, o, mut maker, mut r)
            cluster += 1
            let kind = mob.category
            let most = mob.max_cluster
            // `isMaxGroupSizeReached`: a tropical fish's whose school's closed (CAL-201).
            let full = mob.species == TROPICAL_FISH and not mob.school
            maker.add(mob)
            state.after_spawn(mut level, kind, fx, fz)
            if cluster >= most {
                return
            }
            if full {
                break
            }
        }
    }
}

// `isValidPositionForMob` of the mob at x, y, z, the nearest player `d` blocks squared away: none
// past its category's despawn distance that would go there, `removeWhenFarAway`; then its spawn
// rules, `checkSpawnRules`, a pathfinding mob's walk target's value where it stands no less than
// 0; and its room, `checkSpawnObstruction`, no fluid in a block its box is in and nothing in its
// box that blocks building.
fn valid_position_for_mob<L: SpawnLevel, M: MobMaker>(n: Natural, place: SpawnPlace, level: L, maker: M, mob: Mob, x: i32, y: i32, z: i32, d: f64) -> bool {
    let far = despawn_distance(mob.category)
    if d > f64(far * far) and mob.removed_far_away(d) {
        return false
    }
    if walk_target_value(n, place, level, mob.species, mob.monster, x, y, z) < 0.0f32 {
        return false
    }
    return spawn_room(n, place, level, maker, mob)
}

// `checkSpawnObstruction` of `mob` where it is: no fluid in a block its box is in and nothing in
// its box that blocks building, as `valid_position_for_mob` and spawners ask it (CAL-408).
fn spawn_room<L: SpawnLevel, M: MobMaker>(n: Natural, place: SpawnPlace, level: L, maker: M, mob: Mob) -> bool {
    let b = mob.living.body.bounding_box()
    // A drowned's room is only what blocks building, `Drowned.checkSpawnObstruction` (CAL-175), and
    // a water animal's, `WaterAnimal.checkSpawnObstruction` (CAL-178).
    if mob.species != DROWNED and not water_kind(mob.species) and n.any_fluid(level, b) {
        return false
    }
    if not maker.unobstructed(b) {
        return false
    }
    // An ocelot's, `Ocelot.checkSpawnObstruction`, at the sea's level or above, on a grass block
    // or leaves (CAL-201).
    if mob.species == OCELOT {
        let (bx, by, bz) = (i32.saturate(mob.living.body.x.floor()), i32.saturate(mob.living.body.y.floor()), i32.saturate(mob.living.body.z.floor()))
        if by < place.sea_level {
            return false
        }
        let below = level.spawn_state(bx, by - 1, bz)
        return n.facts.is(below, n.grass_block) or n.facts.in_set(below, n.leaves)
    }
    return true
}

// `getWalkTargetValue` of a mob of the kind `species` at x, y, z: a monster's, `Monster`'s, what the
// light there costs, `getPathfindingCostFromLightLevels`, the light's curve lerped to 1 by the
// dimension's ambient light, less a half, negated, so it spawns only where that's no more than a
// half (CAL-156); a slime's and a cod's 0, `PathfinderMob`'s, so it spawns in any light (CAL-178),
// and an enderman's 0, its own, though its spawn rules want it dark; a mooshroom's 10 on mycelium,
// another animal's on a grass block, `Animal`'s, and otherwise the cost itself.
fn walk_target_value<L: SpawnLevel>(n: Natural, place: SpawnPlace, level: L, species: i32, monster: bool, x: i32, y: i32, z: i32) -> f32 {
    if cube_kind(species) or species == ENDERMAN or water_kind(species) or species == STRIDER {
        // A strider's 0 where it spawns, above lava and not in it, `Strider.getWalkTargetValue`
        // (CAL-392).
        return 0.0f32
    }
    if not monster {
        let below = level.spawn_state(x, y - 1, z)
        let on = if species == MOOSHROOM { n.mycelium } else { n.grass_block }
        if n.facts.is(below, on) {
            return 10.0f32
        }
    }
    let v = f32.nearest(raw_brightness(level, x, y, z, place.sky_darken)) / 15.0f32
    let curved = v / (4.0f32 - 3.0f32 * v)
    let cost = curved + place.ambient_light * (1.0f32 - curved) - 0.5f32
    return if monster { -cost } else { cost }
}

/// `PhantomSpawner.tick` for each player, once it's due and the sky's dark enough (CAL-200), with
/// `r` the level's random: of `place`'s players in their order, each not spectating, where the
/// level has sky light only those as high as the sea or higher who see the sky, `canSeeSky`; then
/// where the difficulty at their block beats a draw up to 3, `isHarderThan`, and a draw under how
/// long since they rested, 1 at least, `TIME_SINCE_REST`, is 72,000 or more, three days, a block
/// 20 to 34 above theirs and up to 10 off east and south, drawn in that order. Where that's a
/// block a phantom may spawn in, `isValidEmptySpawnBlock`, 1 to the difficulty's ID and 1
/// phantoms, of the type `phantom_type`, made at its bottom middle, unturned, `snapTo`, finalized
/// as natural spawning finalizes them, their group handed on, and added in turn,
/// `addFreshEntityWithPassengers`.
pub fn spawn_phantoms<L: SpawnLevel, M: MobMaker + Making, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, maker: mut M, phantom_type: i32, sky_light: bool, r: mut T) {
    for p in place.players {
        if p.spectator {
            continue
        }
        let bx = i32.saturate(p.x.floor())
        let by = i32.saturate(p.y.floor())
        let bz = i32.saturate(p.z.floor())
        if sky_light and not (by >= place.sea_level and level.light(true, bx, by, bz) >= 15) {
            continue
        }
        let local = difficulty_at(place, level, bx, bz)
        if not (local.effective > r.next_float() * 3.0f32) {
            continue
        }
        let since = if p.since_rest < 1 { 1 } else { p.since_rest }
        if r.next_int_below(since) < 72000 {
            continue
        }
        let y = by + 20 + r.next_int_below(15)
        let x = bx + (-10 + r.next_int_below(21))
        let z = bz + (-10 + r.next_int_below(21))
        if not n.empty_spawn_block(level.spawn_state(x, y, z), phantom_type) {
            continue
        }
        var group: SpawnGroup? = none
        let count = 1 + r.next_int_below(place.difficulty.id() + 1)
        let (fx, fy, fz) = (f64(x) + 0.5, f64(y), f64(z) + 0.5)
        for _ in 0..count {
            var mob = maker.make(phantom_type, fx, fy, fz) else continue
            mob.living.snap_to(fx, fy, fz, 0.0f32, 0.0f32)
            let o = Occasion { local: local, halloween: place.halloween }
            group = mob.finalize_spawn(group, o, mut maker, mut r)
            maker.add(mob)
        }
    }
}

/// `PatrolSpawner.tick`'s patrol of `group` of the type `pillager` from the block x, z on
/// (CAL-167), its checks before it passed: each at the top there, `MOTION_BLOCKING_NO_LEAVES`, the
/// first its leader, the patrol given up where it can't be made; between them the place moved
/// up to 4 each way across, drawn. Each member where its block's one it may spawn in,
/// `isValidEmptySpawnBlock`, the blocks' light there no more than 8, not on peaceful and on a
/// block it may spawn on, `checkPatrollingMonsterSpawnRules`: made, a leader leading and given
/// its target off the level's origin, where it still is, `findPatrolTarget`; put at the block's
/// corner, `setPos`; finalized as a patrol's by the difficulty there; and added.
pub fn spawn_patrol<L: SpawnLevel, M: MobMaker + Making, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, maker: mut M, pillager: i32, x: i32, z: i32, group: i32, r: mut T) {
    var px = x
    var pz = z
    for i in 0..group {
        let py = level.surface(MOTION_BLOCKING_NO_LEAVES, px, pz)
        let made = patrol_member(n, place, level, mut maker, pillager, px, py, pz, i == 0, mut r)
        if i == 0 and not made {
            break
        }
        let ax = r.next_int_below(5)
        let bx = r.next_int_below(5)
        px = px + ax - bx
        let az = r.next_int_below(5)
        let bz = r.next_int_below(5)
        pz = pz + az - bz
    }
}

// `PatrolSpawner.spawnPatrolMember` at the block x, y, z (CAL-167).
fn patrol_member<L: SpawnLevel, M: MobMaker + Making, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, maker: mut M, pillager: i32, x: i32, y: i32, z: i32, leader: bool, r: mut T) -> bool {
    if not n.empty_spawn_block(level.spawn_state(x, y, z), pillager) {
        return false
    }
    if level.light(false, x, y, z) > 8 or place.peaceful {
        return false
    }
    if not mob_rules(n, level, n.types[usize.wrap(pillager)], x, y, z) {
        return false
    }
    var mob = maker.make(pillager, 0.0, 0.0, 0.0) else return false
    if leader {
        mob.patrol_leader = true
        mob.find_patrol_target()
    }
    mob.living.body.x = f64(x)
    mob.living.body.y = f64(y)
    mob.living.body.z = f64(z)
    let o = Occasion { local: difficulty_at(place, level, x, z), halloween: place.halloween, natural: false, patrol: true }
    _ = mob.finalize_spawn(none, o, mut maker, mut r)
    maker.add(mob)
    return true
}

/// `Monster.checkMonsterSpawnRules` of the type `type_id` at the block x, y, z for an event, as
/// `VillageSiege` asks it (CAL-167): dark enough, drawn, and on a block it may spawn on.
pub fn monster_spawn_rules<L: SpawnLevel, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, type_id: i32, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    return try monster_rules(n, place, level, n.types[usize.wrap(type_id)], x, y, z, mut r)
}

// `getCurrentDifficultyAt` the block at x, z (CAL-156): the chunk's inhabited time and the moon's
// brightness where it's loaded in full, neither where it isn't.
fn difficulty_at<L: SpawnLevel>(place: SpawnPlace, level: L, x: i32, z: i32) -> LocalDifficulty {
    var local: i64 = 0
    var moon = 0.0f32
    if let t = level.inhabited_at(x >> 4, z >> 4) {
        local = t
        moon = place.moon
    }
    return LocalDifficulty.new(place.difficulty, place.clock, local, moon)
}

// The nearest player to the place that isn't a spectator, and their distance squared, as
// `getNearestPlayer` with no limit finds them: the first of the nearest, in the level's order.
fn nearest_player(players: List<SpawnerPlayer>, x: f64, y: f64, z: f64) -> (usize, f64)? {
    var best: (usize, f64)? = none
    for i in 0..players.len() {
        let p = players[i]
        if p.spectator {
            continue
        }
        let dx = p.x - x
        let dy = p.y - y
        let dz = p.z - z
        let d = dx * dx + dy * dy + dz * dz
        match best {
            some((_, b)) => {
                if d < b {
                    best = some((i, d))
                }
            },
            none => best = some((i, d)),
        }
    }
    return best
}

// `isRightDistanceToPlayerAndSpawnPoint`: more than 24 blocks from the player, and from the
// middle of the world's spawn if it's in this level, in the chunk being spawned in or one whose
// entities tick within the border.
fn right_distance<L: SpawnLevel>(place: SpawnPlace, level: L, chunk_x: i32, chunk_z: i32, x: i32, y: i32, z: i32, d: f64) -> bool {
    if d <= 576.0 {
        return false
    }
    if let (sx, sy, sz) = place.respawn {
        let dx = f64(sx) + 0.5 - (f64(x) + 0.5)
        let dy = f64(sy) + 0.5 - f64(y)
        let dz = f64(sz) + 0.5 - (f64(z) + 0.5)
        if dx * dx + dy * dy + dz * dz < 576.0 {
            return false
        }
    }
    let cx = x >> 4
    let cz = z >> 4
    if cx == chunk_x and cz == chunk_z {
        return true
    }
    return spawns_in(place, level, cx, cz)
}

/// `NaturalSpawner.spawnMobsForChunkGeneration` of the chunk at `chunk_x`, `chunk_z` (CAL-161), as
/// `NoiseBasedChunkGenerator.spawnOriginalMobs` has it with the chunk's own random `r`, seeded for
/// its decoration, and the region's, `region`, `getRandom`, which the types' spawn rules and the
/// mobs' finalizing draw from; `top` the world's highest block, `getMaxY`, and `ceiling` whether
/// the dimension has one. The creatures of the biome at the chunk's corner at the top, packs of
/// them while a draw is under the biome's `creature_world_gen_spawn_probability` there, each pack
/// at a column of the chunk, each of its mobs tried at most 4 times, wandering a little in the
/// chunk between tries: at the top of the column where nothing collides, where the type may be
/// summoned, its placement holds and its box, kept in the chunk, has no block in it and its
/// spawn rules hold, a mob made and turned; finalized and added where its own spawn rules and room
/// hold, `checkSpawnRules` and `checkSpawnObstruction`, with nothing in the region to be in its
/// way, by the difficulty there with no inhabited time. `place` is the region's, whose sky
/// doesn't darken. A type Calcite doesn't make yet ends the chunk's spawning, as the draws after
/// it would be vanilla's for a mob that isn't there; it's the type's ID, else none.
pub fn spawn_for_generation<L: SpawnLevel + CollisionBlocks, M: MobMaker + Making, T: RandomSource, U: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, maker: mut M, chunk_x: i32, chunk_z: i32, top: i32, ceiling: bool, r: mut T, region: mut U) -> i32? ! Thrown {
    let xo = chunk_x * 16
    let zo = chunk_z * 16
    // `NATURAL_MOB_SPAWNS` reads the biome there in full, and the chance its quart's.
    let list = biome_mobs(mobs, level.biome(xo, top, zo), CREATURE)
    if list.is_empty() {
        return none
    }
    let chance = creature_probability(mobs, level.noise_biome(xo >> 2, top >> 2, zo >> 2))
    var total = 0
    for s in list {
        total += s.weight
    }
    while r.next_float() < chance {
        // `WeightedList.getRandom`: none, and nothing drawn, where they weigh nothing.
        if total == 0 {
            continue
        }
        var pick = r.next_int_below(total)
        var data: Spawner? = none
        for s in list {
            pick -= s.weight
            if pick < 0 {
                data = some(s.copy())
                break
            }
        }
        let spawner = data else continue
        let count = try spawner.count.sample(mut r)
        var group: SpawnGroup? = none
        var x = xo + r.next_int_below(16)
        var z = zo + r.next_int_below(16)
        let start_x = x
        let start_z = z
        let t = n.types[usize.wrap(spawner.type_id)]
        for _ in 0..count {
            var success = false
            var attempts = 0
            while not success and attempts < 4 {
                attempts += 1
                let y = top_non_colliding(n, level, t, x, z, ceiling, place.min_y)
                if t.flags & SUMMON != 0 and position_ok(n, place, level, spawner.type_id, x, y, z) {
                    let width = f64(t.half_width * 2.0f32)
                    let fx = clamp(f64(x), f64(xo) + width, f64(xo) + 16.0 - width)
                    let fz = clamp(f64(z), f64(zo) + width, f64(zo) + 16.0 - width)
                    let half = f64(t.half_width)
                    let b = Aabb { min_x: fx - half, min_y: f64(y), min_z: fz - half, max_x: fx + half, max_y: f64(y) + f64(t.height), max_z: fz + half }
                    // A box with a block in it, or spawn rules that don't hold, try again where
                    // it is, `continue`, with no wandering.
                    if not n.collisions.no_collision_without_fluids(level, b, n.liquid) {
                        continue
                    }
                    let bx = i32.saturate(fx.floor())
                    let bz = i32.saturate(fz.floor())
                    if not try spawn_rules(n, mobs, place, mut level, spawner.type_id, bx, y, bz, mut region) {
                        continue
                    }
                    var mob = maker.make(spawner.type_id, fx, f64(y), fz) else return some(spawner.type_id)
                    let turn = r.next_float() * 360.0f32
                    mob.living.snap_to(fx, f64(y), fz, turn, 0.0f32)
                    let mb = mob.living.body.bounding_box()
                    // The region has no entities, so none's in its way, those made before it
                    // included, which wait in the chunk as tags.
                    if walk_target_value(n, place, level, mob.species, mob.monster, bx, y, bz) >= 0.0f32 and not n.any_fluid(level, mb) {
                        let biome = level.biome(bx, y, bz)
                        maker.spawning_in(mut mob, biome)
                        let o = Occasion { local: LocalDifficulty.new(place.difficulty, place.clock, 0, place.moon), halloween: place.halloween, natural: false, game_time: place.game_time }
                        group = mob.finalize_spawn(group, o, mut maker, mut region)
                        maker.add(mob)
                        success = true
                    }
                }
                // The pack wanders a step in the chunk, back near its start where it'd leave.
                x += r.next_int_below(5) - r.next_int_below(5)
                z += r.next_int_below(5) - r.next_int_below(5)
                while x < xo or x >= xo + 16 or z < zo or z >= zo + 16 {
                    x = start_x + r.next_int_below(5) - r.next_int_below(5)
                    z = start_z + r.next_int_below(5) - r.next_int_below(5)
                }
            }
        }
    }
    return none
}

// `Mth.clamp` of doubles: the least where it's under it, else the most where it's over it.
fn clamp(v: f64, least: f64, most: f64) -> f64 {
    if v < least {
        return least
    }
    return v.min(most)
}

// `CREATURE_WORLD_GEN_SPAWN_PROBABILITY` in the biome: its attribute map's, a number or what an
// `override` gives, else the attribute's default, 0.1 (CAL-161).
fn creature_probability(mobs: Mobs, biome: i32) -> f32 {
    if biome < 0 or usize.wrap(biome) >= mobs.attributes.len() {
        return 0.1f32
    }
    var entry = field(mobs.attributes[usize.wrap(biome)], "minecraft:gameplay/creature_world_gen_spawn_probability")
    if let Tag.Str(op) = field(entry, "modifier") {
        if op != "override" {
            return 0.1f32
        }
        entry = field(entry, "argument")
    }
    return match entry {
        Tag.Float(f) => f,
        Tag.Double(d) => f32.nearest(d),
        Tag.Int(i) => f32.nearest(f64(i)),
        _ => 0.1f32,
    }
}

// `getTopNonCollidingPos` for a mob of the type `t` at x, z (CAL-161): the height of its
// placement's heightmap there; under a ceiling, down from it through what isn't air, then through
// the air to what isn't, no lower than the world's bottom `min_y`; then, on the ground, the block
// below where it's pathfindable on land, `adjustSpawnPosition`.
fn top_non_colliding<L: SpawnLevel>(n: Natural, level: L, t: TypeFacts, x: i32, z: i32, ceiling: bool, min_y: i32) -> i32 {
    var y = level.surface(t.heightmap, x, z)
    if ceiling {
        y -= 1
        while not n.facts.is_air(level.spawn_state(x, y, z)) {
            y -= 1
        }
        y -= 1
        while n.facts.is_air(level.spawn_state(x, y, z)) and y > min_y {
            y -= 1
        }
    }
    if (t.placement ?? NO_RESTRICTIONS) == ON_GROUND and n.paths.pathfindable(level.spawn_state(x, y - 1, z), COMPUTATION_LAND) {
        return y - 1
    }
    return y
}

/// `ServerLevel.canSpawnEntitiesInChunk`: its entities tick, and it's within the border, both its
/// least and its greatest corner.
pub fn spawns_in<L: SpawnLevel>(place: SpawnPlace, level: L, cx: i32, cz: i32) -> bool {
    if not level.entities_tick(cx, cz) {
        return false
    }
    return place.within(f64(cx * 16), f64(cz * 16)) and place.within(f64(cx * 16 + 15), f64(cz * 16 + 15))
}

// `getRandomSpawnMobAt`: in a biome of `#reduced_water_ambient_spawns`, a water ambient mob only
// one time in fifty; otherwise one of what spawns there, by weight, if any.
fn random_mob<L: SpawnLevel, T: RandomSource>(n: Natural, mobs: Mobs, level: mut L, category: i32, x: i32, y: i32, z: i32, r: mut T) -> Spawner? ! Thrown {
    let biome = level.biome(x, y, z)
    if category == WATER_AMBIENT and flag_of(mobs.reduced_water, biome) and r.next_float() < 0.98f32 {
        return none
    }
    let list = mobs_at(n, mobs, level, biome, category, x, y, z)
    var total = 0
    for s in list {
        total += s.weight
    }
    if total == 0 {
        return none
    }
    var pick = r.next_int_below(total)
    for s in list {
        pick -= s.weight
        if pick < 0 {
            return some(s.copy())
        }
    }
    return none
}

fn flag_of(flags: List<bool>, biome: i32) -> bool {
    return biome >= 0 and usize.wrap(biome) < flags.len() and flags[usize.wrap(biome)]
}

// `mobsAt`: what spawns of the category at x, y, z, in the biome `biome` there: a fortress's
// enemies, `isInNetherFortressBounds`; else a structure's, `getMobsAt`, the first whose
// override of the category holds there, by a piece or the whole box; else the biome's.
fn mobs_at<L: SpawnLevel>(n: Natural, mobs: Mobs, level: L, biome: i32, category: i32, x: i32, y: i32, z: i32) -> List<Spawner> {
    if mobs.structures.is_empty() {
        return biome_mobs(mobs, biome, category)
    }
    let starts = level.starts_at(x, y, z)
    let bricks = n.facts.block_named(String("minecraft:nether_bricks")) == some(n.facts.block(level.spawn_state(x, y - 1, z)))
    return structure_mobs(mobs, starts, bricks, category, x, y, z) ?? biome_mobs(mobs, biome, category)
}

/// What the structures whose starts are `starts` spawn of the category at x, y, z, where it isn't
/// the biome's mobs (CAL-309): a fortress's enemies, for a monster on nether bricks, `bricks`,
/// within a fortress's box, `isInNetherFortressBounds`; else the first structure's whose override
/// of the category holds there, by a piece or the whole box, `getMobsAt`.
pub fn structure_mobs(mobs: Mobs, starts: List<StartAt>, bricks: bool, category: i32, x: i32, y: i32, z: i32) -> List<Spawner>? {
    let fortress = String("minecraft:fortress")
    if category == MONSTER and bricks and mobs.structures.contains(fortress) {
        let by = if mobs.structures[fortress].adapted { 12 } else { 0 }
        for s in starts {
            if s.structure == fortress and s.holds(by, x, y, z) {
                return some(mobs.fortress.copy())
            }
        }
    }
    var seen = List<String>()
    for s in starts {
        if seen.contains(s.structure) or not mobs.structures.contains(s.structure) {
            continue
        }
        seen.push(s.structure.copy())
        let (piece, list) = mobs.structures[s.structure].overrides[usize.wrap(category)].copy() else continue
        let by = if mobs.structures[s.structure].adapted { 12 } else { 0 }
        for t in starts {
            if t.structure == s.structure and (if piece { t.piece } else { t.holds(by, x, y, z) }) {
                return some(list.copy())
            }
        }
    }
    return none
}

// What spawns of the category in the biome, `getMobSettings().getMobs`.
fn biome_mobs(mobs: Mobs, biome: i32, category: i32) -> List<Spawner> {
    if biome < 0 or usize.wrap(biome) >= mobs.by_biome.len() {
        return List<Spawner>()
    }
    return mobs.by_biome[usize.wrap(biome)].mobs(category)
}

// `isValidSpawnPostitionForType`, in its order.
fn valid_position_for_type<L: SpawnLevel + CollisionBlocks, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, category: i32, data: Spawner, x: i32, y: i32, z: i32, d: f64, r: mut T) -> bool ! Thrown {
    let t = n.types[usize.wrap(data.type_id)]
    if t.category == MISC {
        return false
    }
    let far = despawn_distance(t.category)
    if t.flags & FAR == 0 and d > f64(far * far) {
        return false
    }
    if t.flags & SUMMON == 0 {
        return false
    }
    var there = false
    let biome = level.biome(x, y, z)
    for s in mobs_at(n, mobs, level, biome, category, x, y, z) {
        if s.same(data) {
            there = true
            break
        }
    }
    if not there {
        return false
    }
    if not position_ok(n, place, level, data.type_id, x, y, z) {
        return false
    }
    if not try spawn_rules(n, mobs, place, mut level, data.type_id, x, y, z, mut r) {
        return false
    }
    let fx = f64(x) + 0.5
    let fz = f64(z) + 0.5
    let half = f64(t.half_width)
    let b = Aabb { min_x: fx - half, min_y: f64(y), min_z: fz - half, max_x: fx + half, max_y: f64(y) + f64(t.height), max_z: fz + half }
    return n.collisions.no_collision_without_fluids(level, b, n.liquid)
}

// `SpawnPlacements.isSpawnPositionOk`: the type's placement's check, within the border.
fn position_ok<L: SpawnLevel>(n: Natural, place: SpawnPlace, level: L, type_id: i32, x: i32, y: i32, z: i32) -> bool {
    let t = n.types[usize.wrap(type_id)]
    let placement = t.placement ?? NO_RESTRICTIONS
    if placement == NO_RESTRICTIONS {
        return true
    }
    if not place.within(f64(x), f64(z)) {
        return false
    }
    if placement == IN_WATER {
        return n.fluid_in(level.spawn_state(x, y, z), "minecraft:water") and not n.facts.redstone_conductor(level.spawn_state(x, y + 1, z))
    }
    if placement == IN_LAVA {
        return n.fluid_in(level.spawn_state(x, y, z), "minecraft:lava")
    }
    // On the ground: on a block it may spawn on, with room in its block and the one above.
    if not n.valid_spawn(level.spawn_state(x, y - 1, z), t) {
        return false
    }
    return n.empty_spawn_block(level.spawn_state(x, y, z), type_id) and n.empty_spawn_block(level.spawn_state(x, y + 1, z), type_id)
}

/// `SpawnPlacements.isSpawnPositionOk` of the type `type_id` at the block x, y, z, as
/// `CatSpawner` asks it of a cat (CAL-201): `position_ok`'s.
pub fn spawn_position_ok<L: SpawnLevel>(n: Natural, place: SpawnPlace, level: L, type_id: i32, x: i32, y: i32, z: i32) -> bool {
    return position_ok(n, place, level, type_id, x, y, z)
}

/// `SpawnPlacements.checkSpawnRules` of the type `type_id` at the block x, y, z for a spawner,
/// `EntitySpawnReason.SPAWNER` (CAL-408): none in peaceful for a type that isn't allowed in it;
/// then its rule as a spawner has it. A mob's and a light-ignoring monster's take any block,
/// `isSpawner`. A monster's and a surface monster's want it dark enough, as `isDarkEnoughToSpawn`
/// draws, since only a trial spawner ignores the light. The rules that don't read the reason are
/// as natural spawning has them. None for a rule whose spawner form Calcite hasn't.
pub fn spawner_rules<L: SpawnLevel, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, type_id: i32, x: i32, y: i32, z: i32, r: mut T) -> bool? ! Thrown {
    let t = n.types[usize.wrap(type_id)]
    if t.flags & PEACEFUL == 0 and place.peaceful {
        return some(false)
    }
    let at = t.rule else return some(true)
    let rule = n.rules[usize.wrap(at)]
    let natural = match rule {
        Rule.Mob => return some(true),
        Rule.AnyLightMonster => return some(true),
        Rule.Monster => return some(try dark_enough(place, level, x, y, z, mut r)),
        Rule.SurfaceMonster => return some(try dark_enough(place, level, x, y, z, mut r)),
        Rule.MagmaCube => true,
        Rule.ZombifiedPiglin => true,
        Rule.Hoglin => true,
        Rule.Animal => true,
        Rule.Mushroom => true,
        Rule.Armadillo => true,
        Rule.Wolf => true,
        Rule.Rabbit => true,
        Rule.Goat => true,
        Rule.Camel => true,
        Rule.Fox => true,
        Rule.Parrot => true,
        Rule.Turtle => true,
        Rule.Strider => true,
        Rule.Nautilus => true,
        _ => false,
    }
    if not natural {
        return none
    }
    return some(try spawn_rules(n, mobs, place, mut level, type_id, x, y, z, mut r))
}

/// `checkSpawnRules` and `checkSpawnObstruction` of `mob`, made by a spawner, where it is
/// (CAL-408): its walk target's value at its block no less than 0, as natural spawning has it,
/// unless `checked` is false, as with custom spawn rules; then its room, `spawn_room`.
pub fn spawner_mob_ok<L: SpawnLevel, M: MobMaker>(n: Natural, place: SpawnPlace, level: L, maker: M, mob: Mob, checked: bool) -> bool {
    let (x, y, z) = (i32.saturate(mob.living.body.x.floor()), i32.saturate(mob.living.body.y.floor()), i32.saturate(mob.living.body.z.floor()))
    if checked and walk_target_value(n, place, level, mob.species, mob.monster, x, y, z) < 0.0f32 {
        return false
    }
    return spawn_room(n, place, level, maker, mob)
}

/// A type's spawn box at x, y, z, `getSpawnAABB`: half its width each way across, its height up
/// (CAL-408).
pub fn spawn_box(n: Natural, type_id: i32, x: f64, y: f64, z: f64) -> Aabb {
    let t = n.types[usize.wrap(type_id)]
    let half = f64(t.half_width)
    return Aabb { min_x: x - half, min_y: y, min_z: z - half, max_x: x + half, max_y: y + f64(t.height), max_z: z + half }
}

/// Whether `b` meets no block of the level, as `noCollision` with no entity, as natural spawning
/// checks a mob's room (CAL-408).
pub fn spawn_box_free<L: SpawnLevel + CollisionBlocks>(n: Natural, level: L, b: Aabb) -> bool {
    return n.collisions.no_collision_without_fluids(level, b, n.liquid)
}

// `SpawnPlacements.checkSpawnRules`: none in peaceful for a type that isn't allowed in it, then
// its rule, if it's registered one.
fn spawn_rules<L: SpawnLevel, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, type_id: i32, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    let t = n.types[usize.wrap(type_id)]
    if t.flags & PEACEFUL == 0 and place.peaceful {
        return false
    }
    let at = t.rule else return true
    let rule = n.rules[usize.wrap(at)]
    return match rule {
        Rule.Mob => mob_rules(n, level, t, x, y, z),
        Rule.Monster => try monster_rules(n, place, level, t, x, y, z, mut r),
        Rule.AnyLightMonster => mob_rules(n, level, t, x, y, z),
        Rule.SurfaceMonster => try monster_rules(n, place, level, t, x, y, z, mut r) and level.light(true, x, y, z) >= 15,
        Rule.Animal => {
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.animals_on) and bright
        },
        Rule.Mushroom => {
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.mooshrooms_on) and bright
        },
        Rule.Armadillo => {
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.armadillos_on) and bright
        },
        Rule.Wolf => {
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.wolves_on) and bright
        },
        Rule.Bat => bat_rules(n, place, level, t, x, y, z, mut r),
        Rule.Slime => try slime_rules(n, mobs, place, mut level, t, x, y, z, mut r),
        Rule.MagmaCube => not place.peaceful,
        Rule.ZombifiedPiglin => not place.peaceful and not n.facts.is(level.spawn_state(x, y - 1, z), n.nether_wart_block),
        Rule.Hoglin => not n.facts.is(level.spawn_state(x, y - 1, z), n.nether_wart_block),
        Rule.Ghast => not place.peaceful and r.next_int_below(20) == 0 and mob_rules(n, level, t, x, y, z),
        Rule.Stray => try monster_rules(n, place, level, t, x, y, z, mut r) and sees_sky_over_snow(n, level, x, y, z),
        Rule.Drowned => try drowned_rules(n, mobs, place, mut level, x, y, z, mut r),
        Rule.Ocelot => r.next_int_below(3) != 0,
        Rule.Rabbit => {
            // `Rabbit.checkRabbitSpawnRules` (CAL-201).
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.rabbits_on) and bright
        },
        Rule.Goat => {
            // `Goat.checkGoatSpawnRules` (CAL-207).
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.goats_on) and bright
        },
        Rule.Camel => {
            // `Camel.checkCamelSpawnRules` (CAL-207).
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.camels_on) and bright
        },
        Rule.PolarBear => {
            // `PolarBear.checkPolarBearSpawnRules` (CAL-201): its biome's where it is, `getBiome`.
            let bright = raw_brightness(level, x, y, z, 0) > 8
            if flag_of(mobs.polar_alternate, level.biome(x, y, z)) {
                bright and n.facts.in_set(level.spawn_state(x, y - 1, z), n.polar_alternate)
            } else {
                n.facts.in_set(level.spawn_state(x, y - 1, z), n.animals_on) and bright
            }
        },
        Rule.Fox => {
            // `Fox.checkFoxSpawnRules` (CAL-201).
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.foxes_on) and bright
        },
        Rule.Parrot => {
            // `Parrot.checkParrotSpawnRules` (CAL-201).
            let bright = raw_brightness(level, x, y, z, 0) > 8
            n.facts.in_set(level.spawn_state(x, y - 1, z), n.parrots_on) and bright
        },
        Rule.Turtle => {
            // `Turtle.checkTurtleSpawnRules` (CAL-201), whatever its reason.
            y < place.sea_level + 4 and n.facts.in_set(level.spawn_state(x, y - 1, z), n.sand) and raw_brightness(level, x, y, z, 0) > 8
        },
        Rule.GlowSquid => y <= place.sea_level - 33 and raw_brightness(level, x, y, z, 0) == 0 and n.facts.is(level.spawn_state(x, y, z), n.water),
        Rule.SurfaceWater => y >= place.sea_level - 13 and y <= place.sea_level and n.fluid_in(level.spawn_state(x, y - 1, z), "minecraft:water") and n.facts.is(level.spawn_state(x, y + 1, z), n.water),
        Rule.TropicalFish => {
            // `TropicalFish.checkTropicalFishSpawnRules` (CAL-201): its biome's where it is.
            let watered = n.fluid_in(level.spawn_state(x, y - 1, z), "minecraft:water") and n.facts.is(level.spawn_state(x, y + 1, z), n.water)
            watered and (flag_of(mobs.tropical_anywhere, level.biome(x, y, z)) or (y >= place.sea_level - 13 and y <= place.sea_level))
        },
        Rule.Strider => {
            var above = y + 1
            while n.fluid_in(level.spawn_state(x, above, z), "minecraft:lava") {
                above += 1
            }
            n.facts.is_air(level.spawn_state(x, above, z))
        },
        Rule.Nautilus => y >= place.sea_level - 25 and y <= place.sea_level - 5 and n.fluid_in(level.spawn_state(x, y - 1, z), "minecraft:water") and n.facts.is(level.spawn_state(x, y + 1, z), n.water),
        Rule.Unknown => false,
    }
}

// `Stray.checkStraySpawnRules`'s sky, as natural spawning has it, no spawner's (CAL-175): the block
// above x, y, z and on up through powder snow, then under the first that isn't, that one's sky
// light full, `canSeeSky`.
fn sees_sky_over_snow<L: SpawnLevel>(n: Natural, level: L, x: i32, y: i32, z: i32) -> bool {
    var above = y + 1
    while n.facts.is(level.spawn_state(x, above, z), n.powder_snow) {
        above += 1
    }
    return level.light(true, x, above - 1, z) >= 15
}

// `Drowned.checkDrownedSpawnRules` as natural spawning has it, no spawner's nor reinforcements'
// (CAL-175): water below; then whether a monster may spawn, not peaceful, dark enough, as
// `isDarkEnoughToSpawn` draws, and in water; then in a biome of `#more_frequent_drowned_spawns`
// one in 15, else one in 40 where it's more than 5 below the sea's level, each drawn first.
fn drowned_rules<L: SpawnLevel, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    if not n.fluid_in(level.spawn_state(x, y - 1, z), "minecraft:water") {
        return false
    }
    let biome = level.biome(x, y, z)
    var monster = not place.peaceful
    if monster {
        monster = try dark_enough(place, level, x, y, z, mut r)
    }
    monster = monster and n.fluid_in(level.spawn_state(x, y, z), "minecraft:water")
    if flag_of(mobs.frequent_drowned, biome) {
        return r.next_int_below(15) == 0 and monster
    }
    return r.next_int_below(40) == 0 and y < place.sea_level - 5 and monster
}

// `Mob.checkMobSpawnRules`: on a block the type may spawn on.
fn mob_rules<L: SpawnLevel>(n: Natural, level: L, t: TypeFacts, x: i32, y: i32, z: i32) -> bool {
    return n.valid_spawn(level.spawn_state(x, y - 1, z), t)
}

// `Monster.checkMonsterSpawnRules`: dark enough, as `isDarkEnoughToSpawn` says, and
// `checkMobSpawnRules`.
fn monster_rules<L: SpawnLevel, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, t: TypeFacts, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    if not try dark_enough(place, level, x, y, z, mut r) {
        return false
    }
    return mob_rules(n, level, t, x, y, z)
}

// `Monster.isDarkEnoughToSpawn`: the sky's light under a draw of 32, the blocks' no more than
// the type's limit, and the brightest light there, the sky's darkened as in a thunderstorm in
// one, no more than a draw of the type's test.
fn dark_enough<L: SpawnLevel, T: RandomSource>(place: SpawnPlace, level: L, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    if level.light(true, x, y, z) > r.next_int_below(32) {
        return false
    }
    if place.block_light_limit < 15 and level.light(false, x, y, z) > place.block_light_limit {
        return false
    }
    let darken = if place.thundering { 10 } else { place.sky_darken }
    let light = raw_brightness(level, x, y, z, darken)
    return light <= try place.light_test.sample(mut r)
}

/// A spawner's spawn by its custom spawn rules, `SpawnData.CustomSpawnRules` (CAL-413), in place
/// of its type's: none of a type that isn't friendly on peaceful; else the block's light within
/// `block` and its sky's less how dark the sky is, `getEffectiveSkyBrightness`, within `sky`, each
/// range's least and most taken in, `isValidPosition`.
pub fn custom_spawn_ok<L: SpawnLevel>(n: Natural, place: SpawnPlace, level: L, type_id: i32, block: (i32, i32), sky: (i32, i32), x: i32, y: i32, z: i32) -> bool {
    if n.types[usize.wrap(type_id)].flags & PEACEFUL == 0 and place.peaceful {
        return false
    }
    let lit = level.light(false, x, y, z)
    let open = level.light(true, x, y, z) - place.sky_darken
    let (bl, bh) = block
    let (sl, sh) = sky
    return lit >= bl and lit <= bh and open >= sl and open <= sh
}

/// `getMaxLocalRawBrightness` with `darken`: the block's light or the sky's less `darken`,
/// whichever's more; 15 past 30,000,000 blocks out.
pub fn raw_brightness<L: SpawnLevel>(level: L, x: i32, y: i32, z: i32, darken: i32) -> i32 {
    if x < -30000000 or z < -30000000 or x >= 30000000 or z >= 30000000 {
        return 15
    }
    let sky = level.light(true, x, y, z) - darken
    let block = level.light(false, x, y, z)
    return if block > sky { block } else { sky }
}

// `Bat.checkBatSpawnRules`: below the surface, half the time, in light under a draw of 4, on a
// block bats spawn on.
fn bat_rules<L: SpawnLevel, T: RandomSource>(n: Natural, place: SpawnPlace, level: L, t: TypeFacts, x: i32, y: i32, z: i32, r: mut T) -> bool {
    if y >= level.surface(WORLD_SURFACE, x, z) {
        return false
    }
    if r.next_boolean() {
        return false
    }
    if raw_brightness(level, x, y, z, place.sky_darken) > r.next_int_below(4) {
        return false
    }
    if not n.facts.in_set(level.spawn_state(x, y - 1, z), n.bats_on) {
        return false
    }
    return mob_rules(n, level, t, x, y, z)
}

// `Slime.checkSlimeSpawnRules`: none in peaceful. In a biome of `#allows_surface_slime_spawns`
// from 51 to 69 high, at the biome's chance and in light no more than a draw of 8; otherwise one
// in ten in a slime chunk under 40 high, the draw made whatever the chunk.
fn slime_rules<L: SpawnLevel, T: RandomSource>(n: Natural, mobs: Mobs, place: SpawnPlace, level: mut L, t: TypeFacts, x: i32, y: i32, z: i32, r: mut T) -> bool ! Thrown {
    if place.peaceful {
        return false
    }
    if flag_of(mobs.surface_slimes, level.biome(x, y, z)) and y > 50 and y < 70 {
        let quart = level.noise_biome(x >> 2, y >> 2, z >> 2)
        let chance = if quart >= 0 and usize.wrap(quart) < place.slime_chances.len() { place.slime_chances[usize.wrap(quart)] } else { 0.0f32 }
        if r.next_float() < chance and raw_brightness(level, x, y, z, place.sky_darken) <= r.next_int_below(8) {
            return mob_rules(n, level, t, x, y, z)
        }
    }
    let in_slime_chunk = slime_chunk(x >> 4, z >> 4, place.seed)
    if r.next_int_below(10) == 0 and in_slime_chunk and y < 40 {
        return mob_rules(n, level, t, x, y, z)
    }
    return false
}

/// Whether the chunk is a slime chunk, as `WorldgenRandom.seedSlimeChunk` seeds a random for it
/// with the world's `seed`: one in ten.
pub fn slime_chunk(cx: i32, cz: i32, seed: i64) -> bool {
    let s = (seed + i64(cx * cx * 4987142) + i64(cx * 5947611) + i64(cz * cz) * 4392871 + i64(cz * 389711)) ^ 987234911
    var r = LegacyRandom.new(s)
    return r.next_int_below(10) == 0
}
