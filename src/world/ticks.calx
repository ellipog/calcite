/// Scheduled block and fluid ticks, as vanilla's `LevelTicks` and `LevelChunkTicks` keep and run
/// them (D322, CAL-106).
///
/// Each chunk has its ticks of each kind, a `ChunkTicks`, from when it's full until it unloads,
/// as `registerTickContainerInLevel` adds them: those it was saved with wait, as they were saved,
/// until the chunk ticks, when `unpack` schedules them from the game time then, each in as many
/// ticks as it had left, and those scheduled since are in a `PriorityQueue` drained by time, then
/// priority, then the order they were scheduled in. A block has one tick of a kind at a time.
///
/// A level's `LevelTicks` keeps, for each chunk with ticks, the time its first is due at, and
/// each tick, `collect` takes those due, as vanilla's `collectTicks` does: the chunks whose first
/// tick is due go, in the order fastutil's iterator meets them in the table of those times, into
/// a queue by their first tick's priority and order, and each chunk drained from the queue gives
/// its ticks until its next is later than another chunk's first, at most `max` in all. Every
/// queue is Calx's `PriorityQueue`, which moves its elements as Java's does, and the table is
/// fastutil's, which `remove_marked` takes keys out of as its iterator does, so the ticks come
/// out in vanilla's order, ties and all.
module world.ticks

import storage.chunk.{SavedTick}
import world.pos.{BlockPos, ChunkPos}

/// A tick scheduled for a block or a fluid, vanilla's `ScheduledTick`: the block's or the
/// fluid's ID, where, the game time it's due at, its priority, from -3, first, to 3, and its
/// order among the level's ticks, `subTickOrder`, from the level's count of those scheduled, or
/// from -n up for the n ticks a chunk was saved with. `==` compares every field, as the record's
/// `equals` does.
pub struct ScheduledTick {
    pub kind: u32
    pub x: i32
    pub y: i32
    pub z: i32
    pub trigger: i64
    pub priority: i32
    pub sub: i64
}

// `DRAIN_ORDER`: the time it's due at, then its priority, then its order.
impl Order for ScheduledTick {
    fn cmp(self, other: Self) -> Ordering {
        if self.trigger != other.trigger {
            return self.trigger.cmp(other.trigger)
        }
        if self.priority != other.priority {
            return self.priority.cmp(other.priority)
        }
        return self.sub.cmp(other.sub)
    }
}

impl ScheduledTick {
    /// The tick, saved as it would be at `game_time`, as `toSavedTick` saves it: due in as many
    /// ticks as it has left, in Java's `int`.
    pub fn saved(self, game_time: i64) -> SavedTick {
        return SavedTick { kind: self.kind, x: self.x, y: self.y, z: self.z, delay: i32.wrap(self.trigger - game_time), priority: self.priority }
    }
}

// A chunk in the queue of those with ticks due, by its first tick, as `CONTAINER_DRAIN_ORDER`
// compares them with `INTRA_TICK_DRAIN_ORDER`: its priority, then its order. The chunk comes
// along, uncompared, so two chunks whose first ticks tie are where Java's queue puts them.
struct Due {
    priority: i32
    sub: i64
    chunk: i64
}

impl Order for Due {
    fn cmp(self, other: Self) -> Ordering {
        if self.priority != other.priority {
            return self.priority.cmp(other.priority)
        }
        return self.sub.cmp(other.sub)
    }
}

// The key `UNIQUE_TICK_HASH` tells ticks apart by: the place, as `BlockPos.asLong`, and the kind.
fn place_of(kind: u32, x: i32, y: i32, z: i32) -> (i64, u32) {
    return (BlockPos { x: x, y: y, z: z }.pack(), kind)
}

/// A chunk's ticks of one kind, block or fluid, vanilla's `LevelChunkTicks`.
pub struct ChunkTicks {
    // Those scheduled, least first in `DRAIN_ORDER`.
    queue: PriorityQueue<ScheduledTick> = PriorityQueue<ScheduledTick>()
    // Those it was saved with, until it ticks, `pendingTicks`.
    pending: List<SavedTick>? = none
    // The place and kind of each, those saved too, `ticksPerPosition`.
    places: Set<(i64, u32)> = Set<(i64, u32)>()
}

impl ChunkTicks {
    /// A chunk's ticks, with none scheduled or saved.
    pub fn new() -> ChunkTicks {
        return ChunkTicks {}
    }

    /// A chunk's ticks as it was saved with `saved`, as `LevelChunkTicks(List)` keeps them: as
    /// they are until `unpack`, with their places taken.
    pub fn saved(saved: own List<SavedTick>) -> ChunkTicks {
        var out = ChunkTicks {}
        for t in saved {
            out.places.insert(place_of(t.kind, t.x, t.y, t.z))
        }
        out.pending = some(saved)
        return out
    }

    /// Its first tick, `peek`.
    pub fn peek(self) -> ScheduledTick? {
        return self.queue.peek()
    }

    /// Takes its first tick out, `poll`, and frees its place.
    pub fn poll(mut self) -> ScheduledTick? {
        let t = self.queue.pop() else return none
        self.places.remove(place_of(t.kind, t.x, t.y, t.z))
        return some(t)
    }

    /// Whether it has a tick of `kind` at `x`, `y`, `z`, scheduled or saved,
    /// `hasScheduledTick`.
    pub fn has(self, kind: u32, x: i32, y: i32, z: i32) -> bool {
        return self.places.contains(place_of(kind, x, y, z))
    }

    /// How many ticks it has, scheduled and saved, `count`.
    pub fn count(self) -> usize {
        var n = self.queue.len()
        if let p = self.pending {
            n += p.len()
        }
        return n
    }

    /// Its ticks as they're saved at `game_time`, `pack`: those it was saved with first, as they
    /// were, then those scheduled, by their order, as Java's stable sort leaves those of the
    /// same order in the queue's.
    pub fn pack(self, game_time: i64) -> List<SavedTick> {
        var out = List<SavedTick>()
        if let p = self.pending {
            for t in p {
                out.push(t)
            }
        }
        var ticks = List<ScheduledTick>()
        var order = List<(i64, usize)>()
        for t in self.queue {
            order.push((t.sub, ticks.len()))
            ticks.push(t)
        }
        order.sort()
        for (_, i) in order {
            out.push(ticks[i].saved(game_time))
        }
        return out
    }

    // Schedules `tick` if its place doesn't have one of its kind, `schedule`, and whether it's
    // the first now, as the level's told then.
    fn schedule(mut self, tick: ScheduledTick) -> bool {
        let place = place_of(tick.kind, tick.x, tick.y, tick.z)
        if self.places.contains(place) {
            return false
        }
        self.places.insert(place)
        self.queue.push(tick)
        return self.queue.peek() == some(tick)
    }
}

/// A level's ticks of one kind, block or fluid, vanilla's `LevelTicks`: each full chunk's, and
/// when each chunk with ticks has its first due.
pub struct LevelTicks {
    containers: OpenHashMap<i64, ChunkTicks> = OpenHashMap<i64, ChunkTicks>()
    // `nextTickForContainer`: the time each chunk's first tick is due at, as last told.
    next_tick: OpenHashMap<i64, i64> = OpenHashMap<i64, i64>()
}

impl LevelTicks {
    /// A level's ticks, with no chunks.
    pub fn new() -> LevelTicks {
        return LevelTicks {}
    }

    /// Takes in the ticks of the chunk at `chunk`, packed, as it comes to be full,
    /// `addContainer`.
    pub fn add_container(mut self, chunk: i64, ticks: own ChunkTicks) {
        let first = ticks.peek()
        self.containers.insert(chunk, ticks)
        if let t = first {
            self.next_tick.insert(chunk, t.trigger)
        }
    }

    /// Takes out the ticks of the chunk at `chunk`, packed, as it unloads, `removeContainer`.
    pub fn remove_container(mut self, chunk: i64) -> ChunkTicks? {
        let gone = self.containers.remove(chunk)
        _ = self.next_tick.remove(chunk)
        return gone
    }

    /// Whether it has the ticks of the chunk at `chunk`.
    pub fn has_container(self, chunk: i64) -> bool {
        return self.containers.contains(chunk)
    }

    /// Schedules `tick` in its chunk, `schedule`, unless its place has one of its kind; `false`
    /// if its chunk isn't full, where vanilla logs that it's trying to schedule a tick in a
    /// position that isn't loaded, and drops it.
    pub fn schedule(mut self, tick: ScheduledTick) -> bool {
        let chunk = ChunkPos { x: tick.x >> 4, z: tick.z >> 4 }.pack()
        if not self.containers.contains(chunk) {
            return false
        }
        if self.containers[chunk].schedule(tick) {
            self.next_tick.insert(chunk, tick.trigger)
        }
        return true
    }

    /// Schedules the ticks the chunk at `chunk` was saved with, as it comes to tick, at
    /// `game_time`, `unpack`: each due in as many ticks as it had left, its order -n up for its
    /// n ticks, as they were saved.
    pub fn unpack(mut self, chunk: i64, game_time: i64) {
        if not self.containers.contains(chunk) {
            return
        }
        let saved = self.containers[chunk].pending.take() else return
        var sub = -i64.wrap(saved.len())
        for s in saved {
            let tick = ScheduledTick { kind: s.kind, x: s.x, y: s.y, z: s.z, trigger: game_time + i64(s.delay), priority: s.priority, sub: sub }
            sub += 1
            self.containers[chunk].queue.push(tick)
            if self.containers[chunk].queue.peek() == some(tick) {
                self.next_tick.insert(chunk, tick.trigger)
            }
        }
    }

    /// Whether there's a tick of `kind` at `x`, `y`, `z`, scheduled or saved,
    /// `hasScheduledTick`.
    pub fn has(self, kind: u32, x: i32, y: i32, z: i32) -> bool {
        let chunk = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        if not self.containers.contains(chunk) {
            return false
        }
        return self.containers[chunk].has(kind, x, y, z)
    }

    /// How many ticks every chunk has, scheduled and saved, `count`.
    pub fn count(self) -> usize {
        var n: usize = 0
        for (_, c) in self.containers {
            n += c.count()
        }
        return n
    }

    /// The chunk at `chunk`'s ticks as they're saved at `game_time`, if it has them.
    pub fn pack(self, chunk: i64, game_time: i64) -> List<SavedTick>? {
        if not self.containers.contains(chunk) {
            return none
        }
        return some(self.containers[chunk].pack(game_time))
    }

    /// The time each chunk's first tick is due at, as last told, in the table's order, for the
    /// rig's `ticks` probe.
    pub fn next_ticks(self) -> List<(i64, i64)> {
        var out = List<(i64, i64)>()
        for (k, at) in self.next_tick {
            out.push((k, at))
        }
        return out
    }

    /// The ticks scheduled in the chunk at `chunk`, in its queue's order, for the rig's `ticks`
    /// probe.
    pub fn scheduled(self, chunk: i64) -> List<ScheduledTick> {
        var out = List<ScheduledTick>()
        if self.containers.contains(chunk) {
            for t in self.containers[chunk].queue {
                out.push(t)
            }
        }
        return out
    }

    /// How many ticks the chunk at `chunk` has, scheduled and saved.
    pub fn count_in(self, chunk: i64) -> usize {
        if not self.containers.contains(chunk) {
            return 0
        }
        return self.containers[chunk].count()
    }

    /// The chunks `collect` at `time` asks whether they tick, in no set order: those whose first
    /// tick is due by then.
    pub fn due(self, time: i64) -> List<i64> {
        var out = List<i64>()
        for (k, at) in self.next_tick {
            if at > time or not self.containers.contains(k) {
                continue
            }
            if let first = self.containers[k].peek() {
                if first.trigger <= time {
                    out.push(k)
                }
            }
        }
        return out
    }

    /// Takes out the ticks due at `time`, at most `max`, in the order they're to run, as
    /// `collectTicks` takes them, from the chunks of `ticking`, as vanilla's `tickCheck` has them
    /// tick. The rest wait.
    pub fn collect(mut self, time: i64, max: usize, ticking: OpenHashSet<i64>) -> List<ScheduledTick> {
        var queue = PriorityQueue<Due>()
        self.sort_due(time, ticking, mut queue)
        var run = List<ScheduledTick>()
        // `drainContainers`.
        while run.len() < max {
            let due = queue.pop() else break
            let k = due.chunk
            let first = self.containers[k].poll() else continue
            run.push(first)
            // `drainFromCurrentContainer`: its ticks due, until one comes after the next
            // chunk's first.
            let other = queue.peek()
            while run.len() < max {
                let next = self.containers[k].peek() else break
                if next.trigger > time {
                    break
                }
                if let o = other {
                    if next.priority > o.priority or (next.priority == o.priority and next.sub > o.sub) {
                        break
                    }
                }
                _ = self.containers[k].poll()
                run.push(next)
            }
            if let next = self.containers[k].peek() {
                if next.trigger <= time and run.len() < max {
                    queue.push(Due { priority: next.priority, sub: next.sub, chunk: k })
                } else {
                    self.next_tick.insert(k, next.trigger)
                }
            }
        }
        // `rescheduleLeftoverContainers`, in the queue's order.
        for due in queue {
            if let first = self.containers[due.chunk].peek() {
                self.next_tick.insert(due.chunk, first.trigger)
            }
        }
        return run
    }

    // `sortContainersToTick`: each chunk whose first tick was due by `time` as last told is
    // taken out of the table if it has none, or if it's due and its chunk ticks, which puts it
    // in `queue`, in the order fastutil's iterator meets them as it takes them out; one whose
    // first tick is later now is told so.
    fn sort_due(mut self, time: i64, ticking: OpenHashSet<i64>, queue: mut PriorityQueue<Due>) {
        var keys = List<i64>()
        var marks = List<bool>()
        var queued = List<bool>()
        var later = List<(i64, i64)>()
        for (k, at) in self.next_tick {
            keys.push(k)
            var mark = false
            var goes = false
            if at <= time {
                if not self.containers.contains(k) {
                    mark = true
                } else if let first = self.containers[k].peek() {
                    if first.trigger > time {
                        later.push((k, first.trigger))
                    } else if ticking.contains(k) {
                        mark = true
                        goes = true
                    }
                } else {
                    mark = true
                }
            }
            marks.push(mark)
            queued.push(goes)
        }
        // `setValue` moves no key, so it's the same done before the keys come out.
        for (k, at) in later {
            self.next_tick.insert(k, at)
        }
        if keys.is_empty() {
            return
        }
        for i in self.next_tick.remove_marked(marks) {
            if not queued[i] {
                continue
            }
            let k = keys[i]
            if let first = self.containers[k].peek() {
                queue.push(Due { priority: first.priority, sub: first.sub, chunk: k })
            }
        }
    }
}
