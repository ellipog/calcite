/// Where an entity comes out of a nether portal (D577): the largest rectangle of portal blocks
/// about a block, `BlockUtil.getLargestRectangleAround`; where in the portal it went in,
/// `PortalShape.getRelativePosition`; where in the other it comes out,
/// `NetherPortalBlock.createDimensionTransition`; and a place there free of the blocks about it,
/// `PortalShape.findCollisionFreePosition`, as `CollisionGetter.findFreePosition` finds it.
module world.portal

import world.collision.{Aabb, CollisionBlocks}
import world.movement.{MovementStates, Mover}
import world.paths.{state_at}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}

/// A rectangle of blocks, `BlockUtil.FoundRectangle`: its least corner, and how many blocks it is
/// along its axis, `x` or `z`, and up.
pub struct Rect {
    pub x: i32
    pub y: i32
    pub z: i32
    pub width: i32
    pub height: i32
}

/// `getLargestRectangleAround(center, axis, limit, Y, up, pos -> state == want)`: the largest
/// rectangle of `want` about the block x, y, z, along `x` where `along_x` and `z` else, and up, at
/// most `limit` each way along and `up` each way up from it.
pub fn largest_rectangle<B: CollisionBlocks>(blocks: B, x: i32, y: i32, z: i32, along_x: bool, limit: i32, up: i32, want: u32) -> Rect {
    let (ax, az) = if along_x { (1, 0) } else { (0, 1) }
    let back = reach(blocks, want, x, y, z, -ax, 0, -az, limit)
    let ahead = reach(blocks, want, x, y, z, ax, 0, az, limit)
    let center = back
    let count = usize.wrap(back + 1 + ahead)
    var downs = List<i32>()
    var ups = List<i32>()
    for _ in 0..count {
        downs.push(0)
        ups.push(0)
    }
    let c = usize.wrap(center)
    downs[c] = reach(blocks, want, x, y, z, 0, -1, 0, up)
    ups[c] = reach(blocks, want, x, y, z, 0, 1, 0, up)
    let center_up = downs[c]
    for i in 1..=back {
        let last = usize.wrap(center - (i - 1))
        let (lo, hi) = (downs[last], ups[last])
        let at = usize.wrap(center - i)
        downs[at] = reach(blocks, want, x - ax * i, y, z - az * i, 0, -1, 0, lo)
        ups[at] = reach(blocks, want, x - ax * i, y, z - az * i, 0, 1, 0, hi)
    }
    for i in 1..=ahead {
        let last = usize.wrap(center + i - 1)
        let (lo, hi) = (downs[last], ups[last])
        let at = usize.wrap(center + i)
        downs[at] = reach(blocks, want, x + ax * i, y, z + az * i, 0, -1, 0, lo)
        ups[at] = reach(blocks, want, x + ax * i, y, z + az * i, 0, 1, 0, hi)
    }
    var min_along = 0
    var min_up = 0
    var size_along = 0
    var size_up = 0
    var columns = List<i32>()
    for _ in 0..count {
        columns.push(0)
    }
    var i2 = center_up
    while i2 >= 0 {
        for i1 in 0..count {
            let lo = center_up - downs[i1]
            let hi = center_up + ups[i1]
            columns[i1] = if i2 >= lo and i2 <= hi { hi + 1 - i2 } else { 0 }
        }
        let (start, end, height) = max_rectangle_location(columns)
        let along = 1 + end - start
        if along * height > size_along * size_up {
            min_along = start
            min_up = i2
            size_along = along
            size_up = height
        }
        i2 -= 1
    }
    return Rect { x: x + ax * (min_along - center), y: y + (min_up - center_up), z: z + az * (min_along - center), width: size_along, height: size_up }
}

// `getLimit`: how many blocks of `want` there are on from x, y, z by dx, dy, dz, at most `most`.
fn reach<B: CollisionBlocks>(blocks: B, want: u32, x: i32, y: i32, z: i32, dx: i32, dy: i32, dz: i32, most: i32) -> i32 {
    var n = 0
    while n < most and state_at(blocks, x + dx * (n + 1), y + dy * (n + 1), z + dz * (n + 1)) == want {
        n += 1
    }
    return n
}

/// `getMaxRectangleLocation`: the largest rectangle under the heights `columns`, as the columns it
/// starts and ends at and its height, the first of the largest, as a stack finds it.
pub fn max_rectangle_location(columns: List<i32>) -> (i32, i32, i32) {
    var max_start = 0
    var max_end = 0
    var max_height = 0
    var stack = List<usize>()
    stack.push(0)
    let n = columns.len()
    for column in 1..=n {
        let height = if column == n { 0 } else { columns[column] }
        while not stack.is_empty() {
            let stack_height = columns[stack[stack.len() - 1]]
            if height >= stack_height {
                stack.push(column)
                break
            }
            _ = stack.pop()
            let start = if stack.is_empty() { 0 } else { i32.wrap(stack[stack.len() - 1]) + 1 }
            let c = i32.wrap(column)
            if stack_height * (c - start) > max_height * (max_end - max_start) {
                max_end = c
                max_start = start
                max_height = stack_height
            }
        }
        if stack.is_empty() {
            stack.push(column)
        }
    }
    return (max_start, max_end - 1, max_height)
}

/// `PortalShape.getRelativePosition`: where an entity `width` wide and `height` tall at x, y, z is
/// in the portal `r` along `x` where `along_x` and `z` else: how far along and up it is, each from
/// 0 to 1, and how far in front of the portal's middle.
pub fn relative_position(r: Rect, along_x: bool, x: f64, y: f64, z: f64, width: f32, height: f32) -> (f64, f64, f64) {
    let room = f64(r.width) - f64(width)
    let headroom = f64(r.height) - f64(height)
    let (at, start, forward, front) = if along_x { (x, r.x, z, r.z) } else { (z, r.z, x, r.x) }
    var right = 0.5
    if room > 0.0 {
        let bottom_start = f64(start) + f64(width) / 2.0
        right = clamp(inverse_lerp(at - bottom_start, 0.0, room), 0.0, 1.0)
    }
    var up = 0.0
    if headroom > 0.0 {
        up = clamp(inverse_lerp(y - f64(r.y), 0.0, headroom), 0.0, 1.0)
    }
    return (right, up, forward - (f64(front) + 0.5))
}

/// `createDimensionTransition`'s target: where an entity `width` wide and `height` tall comes out
/// of the portal `r`, along `x` where `along_x`, from `offset`, where it was in the one it went
/// into.
pub fn exit_target(r: Rect, along_x: bool, offset: (f64, f64, f64), width: f32, height: f32) -> (f64, f64, f64) {
    let (ox, oy, oz) = offset
    let right = f64(width) / 2.0 + (f64(r.width) - f64(width)) * ox
    let up = (f64(r.height) - f64(height)) * oy
    let forward = 0.5 + oz
    let x = f64(r.x) + (if along_x { right } else { forward })
    let z = f64(r.z) + (if along_x { forward } else { right })
    return (x, f64(r.y) + up, z)
}

/// `findCollisionFreePosition`: the bottom middle of an entity `width` wide and `height` tall
/// about `bottom`, where the blocks around it leave it room, `findFreePosition`: of the centers
/// within its width across and a block up from `bottom`'s, the nearest to it that no block's
/// shape, grown by half the entity's size, takes, those of shapes outside the world border
/// `border` left out; `bottom` itself where none is, or where the entity is over 4 wide or tall.
/// `mover` is the entity, for the blocks whose shapes depend on it.
pub fn free_position<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, border: (f64, f64, f64, f64), bottom: (f64, f64, f64), width: f32, height: f32, mover: Mover) -> (f64, f64, f64) {
    if width > 4.0f32 or height > 4.0f32 {
        return bottom
    }
    let (bx, by, bz) = bottom
    let half = f64(height) / 2.0
    let (cx, cy, cz) = (bx, by + half, bz)
    let w = f64(width)
    let h = f64(height)
    // `AABB.ofSize(center, width, 0, width).expandTowards(0, 1, 0).inflate(1.0E-6)`.
    let allowed = Aabb { min_x: cx - w / 2.0 - 1.0e-6, min_y: cy - 1.0e-6, min_z: cz - w / 2.0 - 1.0e-6, max_x: cx + w / 2.0 + 1.0e-6, max_y: cy + 1.0 + 1.0e-6, max_z: cz + w / 2.0 + 1.0e-6 }
    let search = Aabb { min_x: allowed.min_x - w, min_y: allowed.min_y - h, min_z: allowed.min_z - w, max_x: allowed.max_x + w, max_y: allowed.max_y + h, max_z: allowed.max_z + w }
    let near = m.colliders(f, blocks, search, mover)
    let (west, north, east, south) = border
    var grown = List<Aabb>()
    var first: usize = 0
    for s in 0..near.ends.len() {
        let end = near.ends[s]
        var b = near.boxes[first]
        for i in first + 1..end {
            b = union(b, near.boxes[i])
        }
        // `WorldBorder.isWithinBounds(AABB)`: its least corner and its greatest, less 1.0E-5.
        let max_x = b.max_x - f64(1.0e-5f32)
        let max_z = b.max_z - f64(1.0e-5f32)
        if within(west, north, east, south, b.min_x, b.min_z) and within(west, north, east, south, max_x, max_z) {
            for i in first..end {
                let a = near.boxes[i]
                grown.push(Aabb { min_x: a.min_x - w / 2.0, min_y: a.min_y - h / 2.0, min_z: a.min_z - w / 2.0, max_x: a.max_x + w / 2.0, max_y: a.max_y + h / 2.0, max_z: a.max_z + w / 2.0 })
            }
        }
        first = end
    }
    let at = closest_free(allowed, grown, cx, cy, cz) else return bottom
    let (px, py, pz) = at
    return (px, py - half, pz)
}

// `Shapes.join(allowed, grown, ONLY_FIRST).closestPointTo(x, y, z)`: the shape split into cells by
// every box's faces within it, those of `allowed` that no box of `grown` holds, and of them the
// point nearest x, y, z, each clamped into its cell. None where every cell's taken. The nearest
// is the same as of the boxes vanilla merges the cells into; of two as near, it's the first by y,
// then x, then z, as vanilla goes through them, which can differ from its first only where the
// merged boxes go another way.
fn closest_free(allowed: Aabb, grown: List<Aabb>, x: f64, y: f64, z: f64) -> (f64, f64, f64)? {
    var xs: List<f64> = [allowed.min_x, allowed.max_x]
    var ys: List<f64> = [allowed.min_y, allowed.max_y]
    var zs: List<f64> = [allowed.min_z, allowed.max_z]
    for g in grown {
        add_cut(mut xs, g.min_x, allowed.min_x, allowed.max_x)
        add_cut(mut xs, g.max_x, allowed.min_x, allowed.max_x)
        add_cut(mut ys, g.min_y, allowed.min_y, allowed.max_y)
        add_cut(mut ys, g.max_y, allowed.min_y, allowed.max_y)
        add_cut(mut zs, g.min_z, allowed.min_z, allowed.max_z)
        add_cut(mut zs, g.max_z, allowed.min_z, allowed.max_z)
    }
    sort(mut xs)
    sort(mut ys)
    sort(mut zs)
    var best: (f64, f64, f64)? = none
    var best_d = 0.0
    for j in 0..ys.len() - 1 {
        for i in 0..xs.len() - 1 {
            for k in 0..zs.len() - 1 {
                let mx = (xs[i] + xs[i + 1]) / 2.0
                let my = (ys[j] + ys[j + 1]) / 2.0
                let mz = (zs[k] + zs[k + 1]) / 2.0
                var taken = false
                for g in grown {
                    if mx > g.min_x and mx < g.max_x and my > g.min_y and my < g.max_y and mz > g.min_z and mz < g.max_z {
                        taken = true
                        break
                    }
                }
                if taken {
                    continue
                }
                let px = clamp(x, xs[i], xs[i + 1])
                let py = clamp(y, ys[j], ys[j + 1])
                let pz = clamp(z, zs[k], zs[k + 1])
                let d = (x - px) * (x - px) + (y - py) * (y - py) + (z - pz) * (z - pz)
                if best == none or d < best_d {
                    best = some((px, py, pz))
                    best_d = d
                }
            }
        }
    }
    return best
}

// Adds the cut `v` to `cuts` where it's within `lo` to `hi` and not within 1.0E-7 of one there,
// as `IndirectMerger` merges them.
fn add_cut(cuts: mut List<f64>, v: f64, lo: f64, hi: f64) {
    if v <= lo + 1.0e-7 or v >= hi - 1.0e-7 {
        return
    }
    for c in cuts {
        if (c - v).abs() < 1.0e-7 {
            return
        }
    }
    cuts.push(v)
}

// Sorts `values` from the least.
fn sort(values: mut List<f64>) {
    for i in 1..values.len() {
        var j = i
        while j > 0 and values[j - 1] > values[j] {
            let t = values[j]
            values[j] = values[j - 1]
            values[j - 1] = t
            j -= 1
        }
    }
}

/// What `PortalForcer.createPortal` reads of the level it builds a portal in (D577): a block's
/// state, air where its chunk isn't there, and a column's height on `MOTION_BLOCKING`, one above
/// its highest block it counts, `getHeight`, where its chunk's full.
pub interface PortalLevel {
    fn portal_state(self, x: i32, y: i32, z: i32) -> u32
    fn motion_height(self, x: i32, z: i32) -> i32
}

/// Where `createPortal` builds a portal: the least corner of its inside, and whether it's built on
/// a floor made for it, where no column would hold its frame.
pub struct PortalSite {
    pub x: i32
    pub y: i32
    pub z: i32
    pub platform: bool
}

/// The level a portal's built in: its lowest block, its height, and how high portals reach in it,
/// its logical height.
pub struct Heights {
    pub min_y: i32
    pub height: i32
    pub logical: i32
}

/// Where `createPortal` builds a portal along `x` where `along_x` and `z` else about `origin` in
/// `level`, of `heights`, within the world border `border`: of the columns within 16 across of
/// it, going round from it, `spiralAround`, inside the border with the column after them along
/// the portal, from the top of `MOTION_BLOCKING`, or the top of where portals reach where that's
/// lower, down, the bottom of each run of blocks that can be replaced and hold no fluid, one
/// block or four high or more, the top of a frame on it within where portals reach, where its
/// frame's sides and inside can be replaced and the blocks under it are solid, `canHostFrame`:
/// the nearest with the same in front and behind, else the nearest; where there's neither, a
/// block before `origin` along the portal, at its height within 70, or a block over the bottom,
/// and 10 under where portals reach, within the border, on a floor made for it; none where that
/// can't be. A column whose chunk isn't in `known`, as one that isn't there, has
/// `getHeight`'s bottom of the level; each block read, as reading it loads its chunk, puts its
/// chunk in `known`.
pub fn portal_site<L: PortalLevel>(f: Facts, level: L, known: mut Set<i64>, origin: (i32, i32, i32), along_x: bool, border: (f64, f64, f64, f64), heights: Heights) -> PortalSite? {
    let (ox, oy, oz) = origin
    let min_y = heights.min_y
    // `Direction.get(POSITIVE, axis)`, east or south, and its `getClockWise`, south or west.
    let (sx, sz) = if along_x { (1, 0) } else { (0, 1) }
    let (cx, cz) = if along_x { (0, 1) } else { (-1, 0) }
    let top = (min_y + heights.height - 1).min(min_y + heights.logical - 1)
    var full_d = -1.0
    var full = (0, 0, 0)
    var partial_d = -1.0
    var partial = (0, 0, 0)
    for (x, z) in spiral(ox, oz, 16) {
        let height = top.min(column_height(level, known, x, z, min_y))
        if not (border_holds(border, x, z) and border_holds(border, x + sx, z + sz)) {
            continue
        }
        var y = height
        while y >= min_y {
            if can_replace(f, level, mut known, x, y, z) {
                let first_empty = y
                while y > min_y and can_replace(f, level, mut known, x, y - 1, z) {
                    y -= 1
                }
                if y + 4 <= top {
                    let delta = first_empty - y
                    if delta <= 0 or delta >= 3 {
                        if can_host(f, level, mut known, x, y, z, sx, sz, cx, cz, 0) {
                            let d = dist_sqr(origin, x, y, z)
                            if can_host(f, level, mut known, x, y, z, sx, sz, cx, cz, -1) and can_host(f, level, mut known, x, y, z, sx, sz, cx, cz, 1) and (full_d == -1.0 or full_d > d) {
                                full_d = d
                                full = (x, y, z)
                            }
                            if full_d == -1.0 and (partial_d == -1.0 or partial_d > d) {
                                partial_d = d
                                partial = (x, y, z)
                            }
                        }
                    }
                }
            }
            y -= 1
        }
    }
    if full_d == -1.0 and partial_d != -1.0 {
        full = partial
        full_d = partial_d
    }
    if full_d == -1.0 {
        let lowest = (min_y + 1).max(70)
        let highest = top - 9
        if highest < lowest {
            return none
        }
        // `clampToBounds`: within the border, less 1.0E-5 at its far sides, floored.
        let (west, north, east, south) = border
        let bx = clamp(f64(ox - sx), west, east - f64(1.0e-5f32)).floor()
        let bz = clamp(f64(oz - sz), north, south - f64(1.0e-5f32)).floor()
        return some(PortalSite { x: i32.saturate(bx), y: oy.max(lowest).min(highest), z: i32.saturate(bz), platform: true })
    }
    let (px, py, pz) = full
    return some(PortalSite { x: px, y: py, z: pz, platform: false })
}

/// `BlockPos.spiralAround(x, z, radius, EAST, SOUTH)`: the columns within `radius` across of
/// x, z, from it out, each turn going east, south, west, then north.
pub fn spiral(x: i32, z: i32, radius: i32) -> List<(i32, i32)> {
    let steps: List<(i32, i32)> = [(1, 0), (0, 1), (-1, 0), (0, -1)]
    var out = List<(i32, i32)>()
    var (lx, lz) = (x, z + 1)
    let legs = 4 * radius
    var leg = -1
    var size = 0
    var index = 0
    loop {
        let (dx, dz) = steps[usize.wrap((leg + 4) % 4)]
        lx += dx
        lz += dz
        if index >= size {
            if leg >= legs {
                return out
            }
            leg += 1
            index = 0
            size = leg / 2 + 1
        }
        index += 1
        out.push((lx, lz))
    }
}

// `getHeight` of `MOTION_BLOCKING` at x, z: the level's bottom where its chunk isn't in `known`.
fn column_height<L: PortalLevel>(level: L, known: Set<i64>, x: i32, z: i32, min_y: i32) -> i32 {
    if not known.contains(chunk_key(x, z)) {
        return min_y
    }
    return level.motion_height(x, z)
}

// The state at x, y, z, its chunk then in `known`, as reading it loads it.
fn read<L: PortalLevel>(level: L, known: mut Set<i64>, x: i32, y: i32, z: i32) -> u32 {
    known.insert(chunk_key(x, z))
    return level.portal_state(x, y, z)
}

// `canPortalReplaceBlock`: whether the block at x, y, z can be replaced, `canBeReplaced`, and has
// no fluid.
fn can_replace<L: PortalLevel>(f: Facts, level: L, known: mut Set<i64>, x: i32, y: i32, z: i32) -> bool {
    let state = read(level, mut known, x, y, z)
    return f.replaceable(state) and f.fluid(state) == 0u32
}

// `canHostFrame` of a frame whose inside's least corner is x, y, z, along sx, sz, moved `offset`
// along cx, cz: each block of its columns, from a block before it to two after, under it solid,
// `isSolid`, and up to four over it replaceable.
fn can_host<L: PortalLevel>(f: Facts, level: L, known: mut Set<i64>, x: i32, y: i32, z: i32, sx: i32, sz: i32, cx: i32, cz: i32, offset: i32) -> bool {
    for width in -1..3 {
        for height in -1..4 {
            let (bx, by, bz) = (x + sx * width + cx * offset, y + height, z + sz * width + cz * offset)
            if height < 0 and not f.is_solid(read(level, mut known, bx, by, bz)) {
                return false
            }
            if height >= 0 and not can_replace(f, level, mut known, bx, by, bz) {
                return false
            }
        }
    }
    return true
}

// `distSqr` of two blocks.
fn dist_sqr(a: (i32, i32, i32), x: i32, y: i32, z: i32) -> f64 {
    let (ax, ay, az) = a
    let dx = f64(ax) - f64(x)
    let dy = f64(ay) - f64(y)
    let dz = f64(az) - f64(z)
    return dx * dx + dy * dy + dz * dz
}

// `WorldBorder.isWithinBounds` of a block's x and z.
fn border_holds(border: (f64, f64, f64, f64), x: i32, z: i32) -> bool {
    let (west, north, east, south) = border
    return within(west, north, east, south, f64(x), f64(z))
}

/// `ChunkPos.pack` of the chunk holding x, z.
pub fn chunk_key(x: i32, z: i32) -> i64 {
    return ChunkPos { x: x >> 4, z: z >> 4 }.pack()
}

// The box holding both `a` and `b`, `AABB.minmax`.
fn union(a: Aabb, b: Aabb) -> Aabb {
    return Aabb { min_x: a.min_x.min(b.min_x), min_y: a.min_y.min(b.min_y), min_z: a.min_z.min(b.min_z), max_x: a.max_x.max(b.max_x), max_y: a.max_y.max(b.max_y), max_z: a.max_z.max(b.max_z) }
}

// `WorldBorder.isWithinBounds(x, z)`.
fn within(west: f64, north: f64, east: f64, south: f64, x: f64, z: f64) -> bool {
    return x >= west and x < east and z >= north and z < south
}

// `Mth.inverseLerp`.
fn inverse_lerp(value: f64, start: f64, end: f64) -> f64 {
    return (value - start) / (end - start)
}

// `Mth.clamp` of a double.
fn clamp(value: f64, lo: f64, hi: f64) -> f64 {
    if value < lo {
        return lo
    }
    return value.min(hi)
}
