/// An ender dragon's own state, as vanilla's `EnderDragon` and its `EnderDragonPhaseManager` keep
/// it (D608): its phase, which its values show, `DATA_PHASE`; its death's ticks, the damage it's
/// taken sitting, the end crystal nearest it, and its eight parts, `EnderDragonPart`, each an
/// entity of its own with the entity ID after the one before, the dragon's first, never saved,
/// sent or ticked, at 0, 0, 0 as they're made. A dragon's mob, `world.mob`'s, ticks it as its
/// `aiStep` and `tickDeath` have it, its flight's phases not yet.
module world.dragon

/// The phases, `EnderDragonPhase`, by their IDs, as they're saved, `DragonPhase`, and shown.
pub const HOLDING_PATTERN: i32 = 0
pub const STRAFE_PLAYER: i32 = 1
pub const LANDING_APPROACH: i32 = 2
pub const LANDING: i32 = 3
pub const TAKEOFF: i32 = 4
pub const SITTING_FLAMING: i32 = 5
pub const SITTING_SCANNING: i32 = 6
pub const SITTING_ATTACKING: i32 = 7
pub const CHARGING_PLAYER: i32 = 8
pub const DYING: i32 = 9
pub const HOVERING: i32 = 10

/// How many parts it has, and which of them its head and neck are, which a hurt doesn't lessen.
pub const PARTS: usize = 8
pub const HEAD: usize = 0
pub const NECK: usize = 1
pub const BODY: usize = 2

/// The experience its death gives, `xpCount`: 500, or 12,000 where it's its fight's first killed,
/// which Calcite's fights don't have yet.
pub const DEATH_EXPERIENCE: i32 = 500

/// The phase of the ID `id`, `EnderDragonPhase.getById`: the holding pattern for one out of range.
pub fn phase_of(id: i32) -> i32 {
    return if id >= 0 and id <= HOVERING { id } else { HOLDING_PATTERN }
}

/// Whether a phase is one it sits in, `isSitting`: hovering, `DragonHoverPhase`'s, and the three
/// of `AbstractDragonSittingPhase`.
pub fn sits(phase: i32) -> bool {
    return phase == HOVERING or phase == SITTING_FLAMING or phase == SITTING_SCANNING or phase == SITTING_ATTACKING
}

/// The part whose entity ID is `id`, the dragon's being `owner`: its place among them, or none for
/// an ID that isn't one of theirs.
pub fn part_index(owner: i32, id: i32) -> usize? {
    let at = id - owner - 1
    return if at >= 0 and at < i32.wrap(PARTS) { some(usize.wrap(at)) } else { none }
}

/// A part's size, its width then its height, `EnderDragonPart`'s, in the order `subEntities` has
/// them: its head, neck and body, its tail's three and its two wings.
pub fn part_size(i: usize) -> (f32, f32) {
    return match i {
        0 => (1.0f32, 1.0f32),
        1 => (3.0f32, 3.0f32),
        2 => (5.0f32, 3.0f32),
        6 => (4.0f32, 2.0f32),
        7 => (4.0f32, 2.0f32),
        _ => (2.0f32, 2.0f32),
    }
}

/// An ender dragon's own state.
pub struct Dragon {
    /// Its phase, `getCurrentPhase().getPhase()`, hovering as it's made.
    pub phase: i32 = HOVERING
    /// Its death's ticks, `dragonDeathTime`, and the damage it's taken sitting since it last took
    /// off, `sittingDamageReceived`, both saved.
    pub death_time: i32 = 0
    pub sitting_damage: f32 = 0.0f32
    /// The end crystal nearest it as it last looked, `nearestCrystal`, by its entity ID; and what
    /// its level found for it before its tick, the nearest within 32 of its box and whether the one
    /// it has is gone, `isRemoved`.
    pub nearest_crystal: i32? = none
    pub found_crystal: i32? = none
    pub crystal_gone: bool = false
    /// Its parts' places, each where its feet are.
    pub parts: List<(f64, f64, f64)> = List<(f64, f64, f64)>()
}

impl Dragon {
    /// A dragon as its constructor makes it: hovering, `EnderDragonPhaseManager`'s, its parts at
    /// 0, 0, 0, where `Entity`'s constructor puts them.
    pub fn made() -> Dragon {
        var d = Dragon()
        for _ in 0..PARTS {
            d.parts.push((0.0, 0.0, 0.0))
        }
        return d
    }

    /// Whether it sits, `isSitting`, as its phase has it.
    pub fn sitting(self) -> bool {
        return sits(self.phase)
    }

    /// The box of its part `i`, as `EntityDimensions.scalable` makes it about its place: its width
    /// across each way and its height up.
    pub fn part_box(self, i: usize) -> (f64, f64, f64, f64, f64, f64) {
        let (x, y, z) = self.parts[i]
        let (w, h) = part_size(i)
        let half = f64(w) / 2.0
        return (x - half, y, z - half, x + half, y + f64(h), z + half)
    }

    /// Each part moved by dx, dy, dz, `setPos(position().add(...))`, as its death lifts it.
    pub fn move_parts(mut self, dx: f64, dy: f64, dz: f64) {
        for i in 0..PARTS {
            let (x, y, z) = self.parts[i]
            self.parts[i] = (x + dx, y + dy, z + dz)
        }
    }
}
