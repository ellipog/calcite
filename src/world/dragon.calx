/// An ender dragon's own state, as vanilla's `EnderDragon` and its `EnderDragonPhaseManager` keep
/// it (D608): its phase, which its values show, `DATA_PHASE`; its death's ticks, the damage it's
/// taken sitting, the end crystal nearest it, and its eight parts, `EnderDragonPart`, each an
/// entity of its own with the entity ID after the one before, the dragon's first, never saved,
/// sent or ticked, at 0, 0, 0 as they're made. A dragon's mob, `world.mob`'s, ticks it as its
/// `aiStep` and `tickDeath` have it; with AI it flies toward its phase's target and its parts are
/// placed about it from its flight's history (D611), in its hover or its holding pattern, which
/// flies a path over 24 nodes about its fight's middle, `findPath` (D613).
module world.dragon

import math.mth.{RAD_TO_DEG, table_atan2, table_cos, table_sin, wrap_degrees, wrap_degrees_f64}
import world.collision.{Aabb}

/// The phases, `EnderDragonPhase`, by their IDs, as they're saved, `DragonPhase`, and shown.
pub const HOLDING_PATTERN: i32 = 0
pub const STRAFE_PLAYER: i32 = 1
pub const LANDING_APPROACH: i32 = 2
pub const LANDING: i32 = 3
pub const TAKEOFF: i32 = 4
pub const SITTING_FLAMING: i32 = 5
pub const SITTING_SCANNING: i32 = 6
pub const SITTING_ATTACKING: i32 = 7
pub const CHARGING_PLAYER: i32 = 8
pub const DYING: i32 = 9
pub const HOVERING: i32 = 10

/// How many parts it has, and which of them its head and neck are, which a hurt doesn't lessen.
pub const PARTS: usize = 8
pub const HEAD: usize = 0
pub const NECK: usize = 1
pub const BODY: usize = 2
/// Where its tail's three parts begin among them, and its two wings.
const TAIL: usize = 3
const TAILS: usize = 3
const WING: usize = 6

/// How many ticks of its flight it keeps, `DragonFlightHistory.LENGTH`.
const HISTORY: i32 = 64

/// How many nodes its paths go over, `nodes`: 12 on a circle 60 out, 8 on one 40 out and 4 on
/// one 20 out; and the first of the inner two, which a dragon without a fight, or one whose fight
/// has no crystals left, keeps to (D613).
pub const NODES: usize = 24
pub const INNER: usize = 12

/// `Math.PI`, which the nodes' circles are turned by.
const PI: f64 = 3.141592653589793

/// `(float) (Math.PI / 180.0)`, which turns its degrees to radians.
const DEG_TO_RAD: f32 = 0.017453292f32

/// The experience its death gives, `xpCount`: 500, or 12,000 where it's its fight's first killed,
/// which Calcite's fights don't have yet.
pub const DEATH_EXPERIENCE: i32 = 500

/// The phase of the ID `id`, `EnderDragonPhase.getById`: the holding pattern for one out of range.
pub fn phase_of(id: i32) -> i32 {
    return if id >= 0 and id <= HOVERING { id } else { HOLDING_PATTERN }
}

/// Whether a phase is one it sits in, `isSitting`: hovering, `DragonHoverPhase`'s, and the three
/// of `AbstractDragonSittingPhase`.
pub fn sits(phase: i32) -> bool {
    return phase == HOVERING or phase == SITTING_FLAMING or phase == SITTING_SCANNING or phase == SITTING_ATTACKING
}

/// The part whose entity ID is `id`, the dragon's being `owner`: its place among them, or none for
/// an ID that isn't one of theirs.
pub fn part_index(owner: i32, id: i32) -> usize? {
    let at = id - owner - 1
    return if at >= 0 and at < i32.wrap(PARTS) { some(usize.wrap(at)) } else { none }
}

/// A part's size, its width then its height, `EnderDragonPart`'s, in the order `subEntities` has
/// them: its head, neck and body, its tail's three and its two wings.
pub fn part_size(i: usize) -> (f32, f32) {
    return match i {
        0 => (1.0f32, 1.0f32),
        1 => (3.0f32, 3.0f32),
        2 => (5.0f32, 3.0f32),
        6 => (4.0f32, 2.0f32),
        7 => (4.0f32, 2.0f32),
        _ => (2.0f32, 2.0f32),
    }
}

/// How fast a phase climbs or falls toward its target, `getFlySpeed`: hovering 1, landing 1.5,
/// charging a player and dying 3, the rest 0.6, `AbstractDragonPhaseInstance`'s.
pub fn fly_speed(phase: i32) -> f32 {
    if phase == HOVERING {
        return 1.0f32
    }
    if phase == LANDING {
        return 1.5f32
    }
    if phase == CHARGING_PLAYER or phase == DYING {
        return 3.0f32
    }
    return 0.6f32
}

/// Where it is, its motion and its turn, which its flight moves.
pub struct Flight {
    pub x: f64
    pub y: f64
    pub z: f64
    pub vx: f64
    pub vy: f64
    pub vz: f64
    pub y_rot: f32
}

/// An ender dragon's own state.
pub struct Dragon {
    /// Its phase, `getCurrentPhase().getPhase()`, hovering as it's made.
    pub phase: i32 = HOVERING
    /// Its death's ticks, `dragonDeathTime`, and the damage it's taken sitting since it last took
    /// off, `sittingDamageReceived`, both saved.
    pub death_time: i32 = 0
    pub sitting_damage: f32 = 0.0f32
    /// The end crystal nearest it as it last looked, `nearestCrystal`, by its entity ID; and what
    /// its level found for it before its tick, the nearest within 32 of its box and whether the one
    /// it has is gone, `isRemoved`.
    pub nearest_crystal: i32? = none
    pub found_crystal: i32? = none
    pub crystal_gone: bool = false
    /// Its parts' places, each where its feet are.
    pub parts: List<(f64, f64, f64)> = List<(f64, f64, f64)>()
    /// Its flight's history, `DragonFlightHistory`: its height and turn in each of its last 64
    /// ticks with AI, the newest at `history_head`, -1 before the first, which fills them all.
    pub history: List<(f64, f32)> = List<(f64, f32)>()
    pub history_head: i32 = -1
    /// How fast it's turning, `yRotA`, and whether its head, neck or body is in a block it
    /// couldn't break, `inWall`, which slows its flight.
    pub y_rot_a: f32 = 0.0f32
    pub in_wall: bool = false
    /// Where its phase flies it, `getFlyTargetLocation`, none where it doesn't fly it, as the
    /// sitting phases don't; and the path it flies, the places of the nodes it goes over, and the
    /// next it's to fly to, none where it has none. Each phase keeps its own, `targetLocation` and
    /// `currentPath`, but each forgets them as it begins, so one of each serves them all (D613).
    pub target: (f64, f64, f64)? = none
    pub path: List<(i32, i32, i32)>? = none
    pub path_next: usize = 0
    /// Which way round its holding pattern flies, the other way 1 in 8, drawn, kept as the phase
    /// begins again, `clockwise`; and the nodes' places, `nodes`, made the first time it looks for
    /// the nearest, empty till then (D613).
    pub clockwise: bool = false
    pub nodes: List<(i32, i32, i32)> = List<(i32, i32, i32)>()
    /// The phases' own counts (D613): a takeoff's first tick, `firstTick`; its scan's ticks,
    /// `scanningTime`; its roar's, `attackingTicks`; and its breath's ticks and how many times it's
    /// breathed since it last landed, `flameTicks` and `flameCount`.
    pub first_tick: bool = false
    pub scan_time: i32 = 0
    pub attack_ticks: i32 = 0
    pub flame_ticks: i32 = 0
    pub flame_count: i32 = 0
    /// The ticks since its charge got where it charged, `timeSinceCharge` (D613).
    pub charge_time: i32 = 0
    /// The player it's to strafe, by entity ID, `DragonStrafePlayerPhase.setTarget` (D613); its
    /// strafe's charge toward its fireball, `fireballCharge`, and the way it flies round as it
    /// strafes, `holdingPatternClockwise`, its strafe's own, which no strafe's begin forgets
    /// (D619).
    pub strafe_target: i32? = none
    pub fireball_charge: i32 = 0
    pub strafe_clockwise: bool = false
    /// What its wings' knockback and its head's and neck's hurt reach in its last tick with AI,
    /// where it wasn't hurt lately, `wasHurtRecently`: its wings' boxes 4 wider, 2 taller and 2
    /// lower, then its head's and neck's a block wider, as they were before it placed them,
    /// which its level looks among.
    pub strikes: List<Aabb> = List<Aabb>()
    /// Whether, in that tick, it flew into something it would break, its level to break once its
    /// strikes are dealt, as `checkWalls` comes after them (D615).
    pub walls_due: bool = false
    /// Its breath's cloud, by entity ID, `flame`, none where it has none; and the one to go as
    /// its breath ended, `end`, which its tick says to its level (D617).
    pub flame: i32? = none
    pub quench: i32? = none
}

impl Dragon {
    /// A dragon as its constructor makes it: hovering, `EnderDragonPhaseManager`'s, its parts at
    /// 0, 0, 0, where `Entity`'s constructor puts them, and its flight's history all at 0.
    pub fn made() -> Dragon {
        var d = Dragon()
        for _ in 0..PARTS {
            d.parts.push((0.0, 0.0, 0.0))
        }
        for _ in 0..HISTORY {
            d.history.push((0.0, 0.0f32))
        }
        return d
    }

    /// Whether it sits, `isSitting`, as its phase has it.
    pub fn sitting(self) -> bool {
        return sits(self.phase)
    }

    /// Its phase set to `phase`, a new one, and begun, `begin` (D613): its target and path
    /// forgotten, as each phase's are; a takeoff at its first tick, a scan's, a roar's and a
    /// charge's ticks none, and a breath's none, counted.
    pub fn begin(mut self, phase: i32) {
        self.phase = phase
        self.target = none
        self.path = none
        self.path_next = 0
        if phase == TAKEOFF {
            self.first_tick = true
        } else if phase == SITTING_SCANNING {
            self.scan_time = 0
        } else if phase == SITTING_ATTACKING {
            self.attack_ticks = 0
        } else if phase == SITTING_FLAMING {
            self.flame_ticks = 0
            self.flame_count += 1
        } else if phase == CHARGING_PLAYER {
            self.charge_time = 0
        } else if phase == STRAFE_PLAYER {
            self.fireball_charge = 0
            self.strafe_target = none
        }
    }

    /// Whether its path is flown, `Path.isDone`, where it has one.
    pub fn path_done(self) -> bool {
        let path = self.path else return false
        return self.path_next >= path.len()
    }

    /// Its path moved on, `advance`.
    pub fn advance(mut self) {
        self.path_next += 1
    }

    /// The place of its path's next node, where it hasn't flown it, and the path moved on past
    /// it, `getNextNodePos` and `advance` (D613).
    pub fn next_node(mut self) -> (i32, i32, i32)? {
        var at = (0, 0, 0)
        if let path = self.path {
            if self.path_next >= path.len() {
                return none
            }
            at = path[self.path_next]
        } else {
            return none
        }
        self.path_next += 1
        return some(at)
    }

    /// The node nearest x, y, z of those from `first` on, `findClosestNode(double, double,
    /// double)`: by the squared distance from the block it's in, those 100 or more off left out,
    /// the first if there's none nearer (D613).
    pub fn closest_node(self, x: f64, y: f64, z: f64, first: usize) -> usize {
        var closest_dist = 10000.0f32
        var closest: usize = 0
        let at = (i32.saturate(x.floor()), i32.saturate(y.floor()), i32.saturate(z.floor()))
        for i in first..NODES {
            if i >= self.nodes.len() {
                continue
            }
            let d = node_distance_sqr(self.nodes[i], at)
            if d < closest_dist {
                closest_dist = d
                closest = i
            }
        }
        return closest
    }

    /// The path from the node `from` to the node `to`, `findPath` (D613): A* over the nodes from
    /// `first` on that neighbour each other, `nodeAdjacency`, by their distances, from its open
    /// set's cheapest, `BinaryHeap`'s; where it can't reach `to`, the path to the node it reached
    /// nearest it, none where that's `from` itself; the places of its nodes, and `last` after them
    /// where there's one, `finalNode`.
    pub fn find_path(self, from: usize, to: usize, first: usize, last: (i32, i32, i32)?) -> List<(i32, i32, i32)>? {
        let found = self.search(from, to, first) else return none
        var places = List<(i32, i32, i32)>()
        for n in found {
            places.push(self.nodes[n])
        }
        if let l = last {
            places.push(l)
        }
        return some(places)
    }

    // `findPath`'s search, its nodes by their places among them.
    fn search(self, from: usize, to: usize, first: usize) -> List<usize>? {
        var s = Search.new()
        s.g[from] = 0.0f32
        s.h[from] = node_distance(self.nodes[from], self.nodes[to])
        s.f[from] = s.h[from]
        s.insert(from)
        var closest = from
        while s.size > 0 {
            let open = s.pop()
            if open == to {
                return some(s.back_from(to))
            }
            if node_distance(self.nodes[open], self.nodes[to]) < node_distance(self.nodes[closest], self.nodes[to]) {
                closest = open
            }
            s.closed[open] = true
            for i in first..NODES {
                if (adjacency(open) & (1 << i32.wrap(i))) <= 0 or s.closed[i] {
                    continue
                }
                let tentative = s.g[open] + node_distance(self.nodes[open], self.nodes[i])
                let in_open = s.heap_idx[i] >= 0
                if not in_open or tentative < s.g[i] {
                    s.came_from[i] = i32.wrap(open)
                    s.g[i] = tentative
                    s.h[i] = node_distance(self.nodes[i], self.nodes[to])
                    if in_open {
                        let cost = s.g[i] + s.h[i]
                        s.change_cost(i, cost)
                    } else {
                        s.f[i] = s.g[i] + s.h[i]
                        s.insert(i)
                    }
                }
            }
        }
        if closest == from {
            return none
        }
        return some(s.back_from(closest))
    }

    /// Its height and turn kept as its flight's newest, `DragonFlightHistory.record`, the first
    /// filling them all.
    pub fn record(mut self, y: f64, y_rot: f32) {
        if self.history_head < 0 {
            for i in 0..HISTORY {
                self.history[usize.wrap(i)] = (y, y_rot)
            }
        }
        self.history_head += 1
        if self.history_head == HISTORY {
            self.history_head = 0
        }
        self.history[usize.wrap(self.history_head)] = (y, y_rot)
    }

    /// Its height and turn `delay` ticks before its newest, `DragonFlightHistory.get`.
    pub fn sample(self, delay: i32) -> (f64, f32) {
        return self.history[usize.wrap((self.history_head - delay) & (HISTORY - 1))]
    }

    /// Its flight in a tick with AI toward `target`, from `at`, as `aiStep` has it (D611): its
    /// climb or fall to it, as steep as its phase's speed lets, added to its motion; turned,
    /// `wrapDegrees`; where it's off to one side, its turn toward it sped up, by at most 50
    /// degrees a tick at its phase's turn speed, `getTurnSpeed`, and a tenth of that turned; then
    /// pushed forward, `moveRelative`, the more where it faces the target and the nearer it is,
    /// and moved by its motion, eight tenths of it in a wall, with no physics, its motion then
    /// slowed, the more across where it isn't going the way it faces.
    pub fn fly(mut self, at: Flight, target: (f64, f64, f64)) -> Flight {
        var b = at
        let (tx, ty, tz) = target
        let xdd = tx - b.x
        var ydd = ty - b.y
        let zdd = tz - b.z
        let distance = xdd * xdd + ydd * ydd + zdd * zdd
        let most = f64(fly_speed(self.phase))
        let across = (xdd * xdd + zdd * zdd).sqrt()
        if across > 0.0 {
            ydd = clamp(ydd / across, -most, most)
        }
        b.vx = b.vx + 0.0
        b.vy = b.vy + ydd * 0.01
        b.vz = b.vz + 0.0
        b.y_rot = wrap_degrees(b.y_rot)
        let (ax, ay, az) = normalized(tx - b.x, ty - b.y, tz - b.z)
        let facing = b.y_rot * DEG_TO_RAD
        let (fx, fy, fz) = normalized(f64(table_sin(f64(facing))), b.vy, f64(-table_cos(f64(facing))))
        let dot = most_of((f32.nearest(fx * ax + fy * ay + fz * az) + 0.5f32) / 1.5f32, 0.0f32)
        let least = f64(1.0e-5f32)
        if xdd.abs() > least or zdd.abs() > least {
            // `Mth.atan2` gives none for no place it's given, NaN's angle being NaN.
            let toward = f32.nearest(table_atan2(xdd, zdd) ?? f64.NAN) * f32.nearest(RAD_TO_DEG)
            let y_rot_d = clamp_float(wrap_degrees(180.0f32 - toward - b.y_rot), -50.0f32, 50.0f32)
            self.y_rot_a = self.y_rot_a * 0.8f32
            self.y_rot_a = self.y_rot_a + y_rot_d * turn_speed(self.phase, b.vx, b.vz)
            let turned = b.y_rot + self.y_rot_a * 0.1f32
            // `setYRot`, which keeps its turn where the new one isn't finite.
            if turned - turned == 0.0f32 {
                b.y_rot = turned
            }
        }
        let span = f32.nearest(2.0 / (distance + 1.0))
        let speed = f64(0.06f32 * (dot * span + (1.0f32 - span)))
        // `moveRelative` forward, (0, 0, -1) scaled by its speed and turned as it's turned.
        let mx = 0.0 * speed
        let my = 0.0 * speed
        let mz = -1.0 * speed
        let turn = b.y_rot * DEG_TO_RAD
        let sin = f64(table_sin(f64(turn)))
        let cos = f64(table_cos(f64(turn)))
        b.vx = b.vx + (mx * cos - mz * sin)
        b.vy = b.vy + my
        b.vz = b.vz + (mz * cos + mx * sin)
        if self.in_wall {
            let slower = f64(0.8f32)
            b.x = b.x + b.vx * slower
            b.y = b.y + b.vy * slower
            b.z = b.z + b.vz * slower
        } else {
            b.x = b.x + b.vx
            b.y = b.y + b.vy
            b.z = b.z + b.vz
        }
        let (nx, ny, nz) = normalized(b.vx, b.vy, b.vz)
        let slide = 0.8 + 0.15 * (nx * fx + ny * fy + nz * fz + 1.0) / 2.0
        b.vx = b.vx * slide
        b.vy = b.vy * f64(0.91f32)
        b.vz = b.vz * slide
        return b
    }

    /// Its parts placed about it after its flight, at `x`, `y`, `z` turned `y_rot`, as `aiStep`
    /// places them (D611): its body and wings by its turn; where it's `struck`, not hurt lately,
    /// what its wings and its head and neck reach, `strikes`, its head's and neck's as they were;
    /// its head and neck ahead of it, tilted as it climbed or fell from 10 ticks to 5 before, a
    /// block below where it sits, else as it fell in the last 5, and turned back as it turns; and
    /// its tail's three behind, each as it was turned and as high as it was 12, 14 and 16 ticks
    /// before against 5.
    pub fn place_parts(mut self, x: f64, y: f64, z: f64, y_rot: f32, struck: bool) {
        let (y5, r5) = self.sample(5)
        let (y10, _) = self.sample(10)
        let tilt = f32.nearest(y5 - y10) * 10.0f32 * DEG_TO_RAD
        let cc_tilt = table_cos(f64(tilt))
        let ss_tilt = table_sin(f64(tilt))
        let rot1 = y_rot * DEG_TO_RAD
        let ss1 = table_sin(f64(rot1))
        let cc1 = table_cos(f64(rot1))
        self.parts[BODY] = (x + f64(ss1 * 0.5f32), y + 0.0, z + f64(-cc1 * 0.5f32))
        self.parts[WING] = (x + f64(cc1 * 4.5f32), y + 2.0, z + f64(ss1 * 4.5f32))
        self.parts[WING + 1] = (x + f64(cc1 * -4.5f32), y + 2.0, z + f64(ss1 * -4.5f32))
        self.strikes = List<Aabb>()
        if struck {
            for k in [WING, WING + 1] {
                let w = self.boxed(k)
                self.strikes.push(Aabb { min_x: w.min_x - 4.0, min_y: w.min_y - 2.0 - 2.0, min_z: w.min_z - 4.0, max_x: w.max_x + 4.0, max_y: w.max_y + 2.0 - 2.0, max_z: w.max_z + 4.0 })
            }
            for k in [HEAD, NECK] {
                let near = self.boxed(k)
                self.strikes.push(near.inflate(1.0, 1.0, 1.0))
            }
        }
        let rot2 = y_rot * DEG_TO_RAD - self.y_rot_a * 0.01f32
        let ss2 = table_sin(f64(rot2))
        let cc2 = table_cos(f64(rot2))
        let (y0, _) = self.sample(0)
        let y_offset = if self.sitting() { -1.0f32 } else { f32.nearest(y5 - y0) }
        self.parts[HEAD] = (x + f64(ss2 * 6.5f32 * cc_tilt), y + f64(y_offset + ss_tilt * 6.5f32), z + f64(-cc2 * 6.5f32 * cc_tilt))
        self.parts[NECK] = (x + f64(ss2 * 5.5f32 * cc_tilt), y + f64(y_offset + ss_tilt * 5.5f32), z + f64(-cc2 * 5.5f32 * cc_tilt))
        let lengths = [2.0f32, 4.0f32, 6.0f32]
        for i in 0..TAILS {
            let (p0y, p0r) = self.sample(12 + i32.wrap(i) * 2)
            let rot = y_rot * DEG_TO_RAD + f32.nearest(wrap_degrees_f64(f64(p0r - r5))) * DEG_TO_RAD
            let ss = table_sin(f64(rot))
            let cc = table_cos(f64(rot))
            let dd = lengths[i]
            let up = p0y - y5 - f64((dd + 1.5f32) * ss_tilt) + 1.5
            self.parts[TAIL + i] = (x + f64(-(ss1 * 1.5f32 + ss * dd) * cc_tilt), y + up, z + f64((cc1 * 1.5f32 + cc * dd) * cc_tilt))
        }
    }

    /// The box of its part `i`, as `part_box` has it.
    pub fn boxed(self, i: usize) -> Aabb {
        let (x0, y0, z0, x1, y1, z1) = self.part_box(i)
        return Aabb { min_x: x0, min_y: y0, min_z: z0, max_x: x1, max_y: y1, max_z: z1 }
    }

    /// The box of its part `i`, as `EntityDimensions.scalable` makes it about its place: its width
    /// across each way and its height up.
    pub fn part_box(self, i: usize) -> (f64, f64, f64, f64, f64, f64) {
        let (x, y, z) = self.parts[i]
        let (w, h) = part_size(i)
        let half = f64(w) / 2.0
        return (x - half, y, z - half, x + half, y + f64(h), z + half)
    }

    /// Each part moved by dx, dy, dz, `setPos(position().add(...))`, as its death lifts it.
    pub fn move_parts(mut self, dx: f64, dy: f64, dz: f64) {
        for i in 0..PARTS {
            let (x, y, z) = self.parts[i]
            self.parts[i] = (x + dx, y + dy, z + dz)
        }
    }
}

// How fast the phase `phase` turns it toward its target, `getTurnSpeed`, as its motion across
// is `vx`, `vz`: the slower the faster, `AbstractDragonPhaseInstance`'s, and landing's that
// speed, at most 40, over itself, `DragonLandingPhase`'s (D613).
fn turn_speed(phase: i32, vx: f64, vz: f64) -> f32 {
    let rot_speed = f32.nearest((vx * vx + vz * vz).sqrt()) + 1.0f32
    let most = if rot_speed > 40.0f32 { 40.0f32 } else { rot_speed }
    if phase == LANDING {
        return most / rot_speed
    }
    return 0.7f32 / most / rot_speed
}

// `Vec3.normalize`: none where it's shorter than 1e-5.
fn normalized(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let length = (x * x + y * y + z * z).sqrt()
    if length < f64(1.0e-5f32) {
        return (0.0, 0.0, 0.0)
    }
    return (x / length, y / length, z / length)
}

// `Mth.clamp` for doubles and floats, NaN kept as `Math.min` keeps it.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}

fn clamp_float(v: f32, lo: f32, hi: f32) -> f32 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}

// `Math.max` for floats, NaN kept.
fn most_of(v: f32, floor: f32) -> f32 {
    return if v < floor { floor } else { v }
}

/// Where the node `i` is across, about 0, 0, and how far above the ground it flies,
/// `findClosestNode` making `nodes` (D613): 12 on a circle 60 out and 4 on one 20 out, 5 above it,
/// and 8 on one 40 out between, 15 above it, each circle from its east, turned twice its share of
/// a half turn on, `Mth.cos` and `Mth.sin` in floats, rounded down.
pub fn node_across(i: usize) -> (i32, i32, i32) {
    let k = i32.wrap(i)
    let (radius, share, m, above) = if k < 12 { (60.0f32, f32.nearest(PI / 12.0), k, 5) } else if k < 20 { (40.0f32, f32.nearest(PI / 8.0), k - 12, 15) } else { (20.0f32, f32.nearest(PI / 4.0), k - 20, 5) }
    let angle = 2.0f32 * (f32.nearest(-PI) + share * f32.nearest(f64(m)))
    let x = i32.saturate(f64(radius * table_cos(f64(angle))).floor())
    let z = i32.saturate(f64(radius * table_sin(f64(angle))).floor())
    return (x, z, above)
}

/// The nodes the node `i` neighbours, `nodeAdjacency`, a bit for each (D613).
pub fn adjacency(i: usize) -> i32 {
    let all = [6146, 8197, 8202, 16404, 32808, 32848, 65696, 131392, 131712, 263424, 526848, 525313, 1581057, 3166214, 2138120, 6373424, 4358208, 12910976, 9044480, 9706496, 15216640, 13688832, 11763712, 8257536]
    return all[i]
}

// `Node.distanceToSqr` and `Node.distanceTo`: the differences of their blocks in floats, the
// root `Mth.sqrt`'s.
fn node_distance_sqr(a: (i32, i32, i32), b: (i32, i32, i32)) -> f32 {
    let (ax, ay, az) = a
    let (bx, by, bz) = b
    let xd = f32.nearest(f64(bx - ax))
    let yd = f32.nearest(f64(by - ay))
    let zd = f32.nearest(f64(bz - az))
    return xd * xd + yd * yd + zd * zd
}

fn node_distance(a: (i32, i32, i32), b: (i32, i32, i32)) -> f32 {
    return f32.nearest(f64(node_distance_sqr(a, b)).sqrt())
}

// A path's search over the nodes, `findPath`'s: each node's costs, `f`, `g` and `h`, whether it's
// closed, the node it was come to from, and its place in the open set, `BinaryHeap`'s, -1 where
// it isn't in it, which keeps them by `f`.
struct Search {
    f: List<f32>
    g: List<f32>
    h: List<f32>
    closed: List<bool>
    came_from: List<i32>
    heap_idx: List<i32>
    heap: List<usize>
    size: usize = 0
}

impl Search {
    fn new() -> Search {
        return Search { f: [0.0f32; 24], g: [0.0f32; 24], h: [0.0f32; 24], closed: [false; 24], came_from: [-1; 24], heap_idx: [-1; 24], heap: [0; 24] }
    }

    // `BinaryHeap.insert`, `pop`, `changeCost`, `upHeap` and `downHeap`.
    fn insert(mut self, n: usize) {
        self.heap[self.size] = n
        self.heap_idx[n] = i32.wrap(self.size)
        let at = self.size
        self.size += 1
        self.up_heap(at)
    }

    fn pop(mut self) -> usize {
        let popped = self.heap[0]
        self.size -= 1
        self.heap[0] = self.heap[self.size]
        if self.size > 0 {
            self.down_heap(0)
        }
        self.heap_idx[popped] = -1
        return popped
    }

    fn change_cost(mut self, n: usize, cost: f32) {
        let old = self.f[n]
        self.f[n] = cost
        let at = usize.wrap(self.heap_idx[n])
        if cost < old {
            self.up_heap(at)
        } else {
            self.down_heap(at)
        }
    }

    fn up_heap(mut self, from: usize) {
        var idx = from
        let n = self.heap[idx]
        let cost = self.f[n]
        while idx > 0 {
            let parent_idx = (idx - 1) / 2
            let parent = self.heap[parent_idx]
            if not (cost < self.f[parent]) {
                break
            }
            self.heap[idx] = parent
            self.heap_idx[parent] = i32.wrap(idx)
            idx = parent_idx
        }
        self.heap[idx] = n
        self.heap_idx[n] = i32.wrap(idx)
    }

    fn down_heap(mut self, from: usize) {
        var idx = from
        let n = self.heap[idx]
        let cost = self.f[n]
        loop {
            let left_idx = 1 + idx * 2
            let right_idx = left_idx + 1
            if left_idx >= self.size {
                break
            }
            let left = self.heap[left_idx]
            let left_cost = self.f[left]
            let right_cost = if right_idx >= self.size { f32.INFINITY } else { self.f[self.heap[right_idx]] }
            if left_cost < right_cost {
                if not (left_cost < cost) {
                    break
                }
                self.heap[idx] = left
                self.heap_idx[left] = i32.wrap(idx)
                idx = left_idx
            } else {
                if not (right_cost < cost) {
                    break
                }
                let right = self.heap[right_idx]
                self.heap[idx] = right
                self.heap_idx[right] = i32.wrap(idx)
                idx = right_idx
            }
        }
        self.heap[idx] = n
        self.heap_idx[n] = i32.wrap(idx)
    }

    // `reconstructPath`: the nodes from the start to `to`, each from the one it was come to from.
    fn back_from(self, to: usize) -> List<usize> {
        var back = List<usize>()
        back.push(to)
        var n = to
        while self.came_from[n] >= 0 {
            n = usize.wrap(self.came_from[n])
            back.push(n)
        }
        var path = List<usize>()
        var i = back.len()
        while i > 0 {
            i -= 1
            path.push(back[i])
        }
        return path
    }
}
