/// An ender dragon's own state, as vanilla's `EnderDragon` and its `EnderDragonPhaseManager` keep
/// it (D608): its phase, which its values show, `DATA_PHASE`; its death's ticks, the damage it's
/// taken sitting, the end crystal nearest it, and its eight parts, `EnderDragonPart`, each an
/// entity of its own with the entity ID after the one before, the dragon's first, never saved,
/// sent or ticked, at 0, 0, 0 as they're made. A dragon's mob, `world.mob`'s, ticks it as its
/// `aiStep` and `tickDeath` have it; with AI it flies toward its phase's target and its parts are
/// placed about it from its flight's history (D611), its hover's phase the only one yet.
module world.dragon

import math.mth.{RAD_TO_DEG, table_atan2, table_cos, table_sin, wrap_degrees, wrap_degrees_f64}
import world.collision.{Aabb}

/// The phases, `EnderDragonPhase`, by their IDs, as they're saved, `DragonPhase`, and shown.
pub const HOLDING_PATTERN: i32 = 0
pub const STRAFE_PLAYER: i32 = 1
pub const LANDING_APPROACH: i32 = 2
pub const LANDING: i32 = 3
pub const TAKEOFF: i32 = 4
pub const SITTING_FLAMING: i32 = 5
pub const SITTING_SCANNING: i32 = 6
pub const SITTING_ATTACKING: i32 = 7
pub const CHARGING_PLAYER: i32 = 8
pub const DYING: i32 = 9
pub const HOVERING: i32 = 10

/// How many parts it has, and which of them its head and neck are, which a hurt doesn't lessen.
pub const PARTS: usize = 8
pub const HEAD: usize = 0
pub const NECK: usize = 1
pub const BODY: usize = 2
/// Where its tail's three parts begin among them, and its two wings.
const TAIL: usize = 3
const TAILS: usize = 3
const WING: usize = 6

/// How many ticks of its flight it keeps, `DragonFlightHistory.LENGTH`.
const HISTORY: i32 = 64

/// `(float) (Math.PI / 180.0)`, which turns its degrees to radians.
const DEG_TO_RAD: f32 = 0.017453292f32

/// The experience its death gives, `xpCount`: 500, or 12,000 where it's its fight's first killed,
/// which Calcite's fights don't have yet.
pub const DEATH_EXPERIENCE: i32 = 500

/// The phase of the ID `id`, `EnderDragonPhase.getById`: the holding pattern for one out of range.
pub fn phase_of(id: i32) -> i32 {
    return if id >= 0 and id <= HOVERING { id } else { HOLDING_PATTERN }
}

/// Whether a phase is one it sits in, `isSitting`: hovering, `DragonHoverPhase`'s, and the three
/// of `AbstractDragonSittingPhase`.
pub fn sits(phase: i32) -> bool {
    return phase == HOVERING or phase == SITTING_FLAMING or phase == SITTING_SCANNING or phase == SITTING_ATTACKING
}

/// The part whose entity ID is `id`, the dragon's being `owner`: its place among them, or none for
/// an ID that isn't one of theirs.
pub fn part_index(owner: i32, id: i32) -> usize? {
    let at = id - owner - 1
    return if at >= 0 and at < i32.wrap(PARTS) { some(usize.wrap(at)) } else { none }
}

/// A part's size, its width then its height, `EnderDragonPart`'s, in the order `subEntities` has
/// them: its head, neck and body, its tail's three and its two wings.
pub fn part_size(i: usize) -> (f32, f32) {
    return match i {
        0 => (1.0f32, 1.0f32),
        1 => (3.0f32, 3.0f32),
        2 => (5.0f32, 3.0f32),
        6 => (4.0f32, 2.0f32),
        7 => (4.0f32, 2.0f32),
        _ => (2.0f32, 2.0f32),
    }
}

/// How fast a phase climbs or falls toward its target, `getFlySpeed`: hovering 1, landing 1.5,
/// charging a player and dying 3, the rest 0.6, `AbstractDragonPhaseInstance`'s.
pub fn fly_speed(phase: i32) -> f32 {
    if phase == HOVERING {
        return 1.0f32
    }
    if phase == LANDING {
        return 1.5f32
    }
    if phase == CHARGING_PLAYER or phase == DYING {
        return 3.0f32
    }
    return 0.6f32
}

/// Where it is, its motion and its turn, which its flight moves.
pub struct Flight {
    pub x: f64
    pub y: f64
    pub z: f64
    pub vx: f64
    pub vy: f64
    pub vz: f64
    pub y_rot: f32
}

/// An ender dragon's own state.
pub struct Dragon {
    /// Its phase, `getCurrentPhase().getPhase()`, hovering as it's made.
    pub phase: i32 = HOVERING
    /// Its death's ticks, `dragonDeathTime`, and the damage it's taken sitting since it last took
    /// off, `sittingDamageReceived`, both saved.
    pub death_time: i32 = 0
    pub sitting_damage: f32 = 0.0f32
    /// The end crystal nearest it as it last looked, `nearestCrystal`, by its entity ID; and what
    /// its level found for it before its tick, the nearest within 32 of its box and whether the one
    /// it has is gone, `isRemoved`.
    pub nearest_crystal: i32? = none
    pub found_crystal: i32? = none
    pub crystal_gone: bool = false
    /// Its parts' places, each where its feet are.
    pub parts: List<(f64, f64, f64)> = List<(f64, f64, f64)>()
    /// Its flight's history, `DragonFlightHistory`: its height and turn in each of its last 64
    /// ticks with AI, the newest at `history_head`, -1 before the first, which fills them all.
    pub history: List<(f64, f32)> = List<(f64, f32)>()
    pub history_head: i32 = -1
    /// How fast it's turning, `yRotA`, and whether its head, neck or body is in a block it
    /// couldn't break, `inWall`, which slows its flight.
    pub y_rot_a: f32 = 0.0f32
    pub in_wall: bool = false
    /// Where its hover holds it, `DragonHoverPhase.targetLocation`: where it was as it first
    /// hovered since its hover began.
    pub hover_target: (f64, f64, f64)? = none
    /// What its wings' knockback and its head's and neck's hurt reach in its last tick with AI,
    /// where it wasn't hurt lately, `wasHurtRecently`: its wings' boxes 4 wider, 2 taller and 2
    /// lower, then its head's and neck's a block wider, as they were before it placed them,
    /// which its level looks among.
    pub strikes: List<Aabb> = List<Aabb>()
}

impl Dragon {
    /// A dragon as its constructor makes it: hovering, `EnderDragonPhaseManager`'s, its parts at
    /// 0, 0, 0, where `Entity`'s constructor puts them, and its flight's history all at 0.
    pub fn made() -> Dragon {
        var d = Dragon()
        for _ in 0..PARTS {
            d.parts.push((0.0, 0.0, 0.0))
        }
        for _ in 0..HISTORY {
            d.history.push((0.0, 0.0f32))
        }
        return d
    }

    /// Whether it sits, `isSitting`, as its phase has it.
    pub fn sitting(self) -> bool {
        return sits(self.phase)
    }

    /// Its phase set to `phase`, a new one, and begun, `begin`: a hover's target forgotten. The
    /// other phases' own state comes with their flight.
    pub fn begin(mut self, phase: i32) {
        self.phase = phase
        if phase == HOVERING {
            self.hover_target = none
        }
    }

    /// Its height and turn kept as its flight's newest, `DragonFlightHistory.record`, the first
    /// filling them all.
    pub fn record(mut self, y: f64, y_rot: f32) {
        if self.history_head < 0 {
            for i in 0..HISTORY {
                self.history[usize.wrap(i)] = (y, y_rot)
            }
        }
        self.history_head += 1
        if self.history_head == HISTORY {
            self.history_head = 0
        }
        self.history[usize.wrap(self.history_head)] = (y, y_rot)
    }

    /// Its height and turn `delay` ticks before its newest, `DragonFlightHistory.get`.
    pub fn sample(self, delay: i32) -> (f64, f32) {
        return self.history[usize.wrap((self.history_head - delay) & (HISTORY - 1))]
    }

    /// Its flight in a tick with AI toward `target`, from `at`, as `aiStep` has it (D611): its
    /// climb or fall to it, as steep as its phase's speed lets, added to its motion; turned,
    /// `wrapDegrees`; where it's off to one side, its turn toward it sped up, by at most 50
    /// degrees a tick at its phase's turn speed, `getTurnSpeed`, and a tenth of that turned; then
    /// pushed forward, `moveRelative`, the more where it faces the target and the nearer it is,
    /// and moved by its motion, eight tenths of it in a wall, with no physics, its motion then
    /// slowed, the more across where it isn't going the way it faces.
    pub fn fly(mut self, at: Flight, target: (f64, f64, f64)) -> Flight {
        var b = at
        let (tx, ty, tz) = target
        let xdd = tx - b.x
        var ydd = ty - b.y
        let zdd = tz - b.z
        let distance = xdd * xdd + ydd * ydd + zdd * zdd
        let most = f64(fly_speed(self.phase))
        let across = (xdd * xdd + zdd * zdd).sqrt()
        if across > 0.0 {
            ydd = clamp(ydd / across, -most, most)
        }
        b.vx = b.vx + 0.0
        b.vy = b.vy + ydd * 0.01
        b.vz = b.vz + 0.0
        b.y_rot = wrap_degrees(b.y_rot)
        let (ax, ay, az) = normalized(tx - b.x, ty - b.y, tz - b.z)
        let facing = b.y_rot * DEG_TO_RAD
        let (fx, fy, fz) = normalized(f64(table_sin(f64(facing))), b.vy, f64(-table_cos(f64(facing))))
        let dot = most_of((f32.nearest(fx * ax + fy * ay + fz * az) + 0.5f32) / 1.5f32, 0.0f32)
        let least = f64(1.0e-5f32)
        if xdd.abs() > least or zdd.abs() > least {
            // `Mth.atan2` gives none for no place it's given, NaN's angle being NaN.
            let toward = f32.nearest(table_atan2(xdd, zdd) ?? f64.NAN) * f32.nearest(RAD_TO_DEG)
            let y_rot_d = clamp_float(wrap_degrees(180.0f32 - toward - b.y_rot), -50.0f32, 50.0f32)
            self.y_rot_a = self.y_rot_a * 0.8f32
            self.y_rot_a = self.y_rot_a + y_rot_d * turn_speed(b.vx, b.vz)
            let turned = b.y_rot + self.y_rot_a * 0.1f32
            // `setYRot`, which keeps its turn where the new one isn't finite.
            if turned - turned == 0.0f32 {
                b.y_rot = turned
            }
        }
        let span = f32.nearest(2.0 / (distance + 1.0))
        let speed = f64(0.06f32 * (dot * span + (1.0f32 - span)))
        // `moveRelative` forward, (0, 0, -1) scaled by its speed and turned as it's turned.
        let mx = 0.0 * speed
        let my = 0.0 * speed
        let mz = -1.0 * speed
        let turn = b.y_rot * DEG_TO_RAD
        let sin = f64(table_sin(f64(turn)))
        let cos = f64(table_cos(f64(turn)))
        b.vx = b.vx + (mx * cos - mz * sin)
        b.vy = b.vy + my
        b.vz = b.vz + (mz * cos + mx * sin)
        if self.in_wall {
            let slower = f64(0.8f32)
            b.x = b.x + b.vx * slower
            b.y = b.y + b.vy * slower
            b.z = b.z + b.vz * slower
        } else {
            b.x = b.x + b.vx
            b.y = b.y + b.vy
            b.z = b.z + b.vz
        }
        let (nx, ny, nz) = normalized(b.vx, b.vy, b.vz)
        let slide = 0.8 + 0.15 * (nx * fx + ny * fy + nz * fz + 1.0) / 2.0
        b.vx = b.vx * slide
        b.vy = b.vy * f64(0.91f32)
        b.vz = b.vz * slide
        return b
    }

    /// Its parts placed about it after its flight, at `x`, `y`, `z` turned `y_rot`, as `aiStep`
    /// places them (D611): its body and wings by its turn; where it's `struck`, not hurt lately,
    /// what its wings and its head and neck reach, `strikes`, its head's and neck's as they were;
    /// its head and neck ahead of it, tilted as it climbed or fell from 10 ticks to 5 before, a
    /// block below where it sits, else as it fell in the last 5, and turned back as it turns; and
    /// its tail's three behind, each as it was turned and as high as it was 12, 14 and 16 ticks
    /// before against 5.
    pub fn place_parts(mut self, x: f64, y: f64, z: f64, y_rot: f32, struck: bool) {
        let (y5, r5) = self.sample(5)
        let (y10, _) = self.sample(10)
        let tilt = f32.nearest(y5 - y10) * 10.0f32 * DEG_TO_RAD
        let cc_tilt = table_cos(f64(tilt))
        let ss_tilt = table_sin(f64(tilt))
        let rot1 = y_rot * DEG_TO_RAD
        let ss1 = table_sin(f64(rot1))
        let cc1 = table_cos(f64(rot1))
        self.parts[BODY] = (x + f64(ss1 * 0.5f32), y + 0.0, z + f64(-cc1 * 0.5f32))
        self.parts[WING] = (x + f64(cc1 * 4.5f32), y + 2.0, z + f64(ss1 * 4.5f32))
        self.parts[WING + 1] = (x + f64(cc1 * -4.5f32), y + 2.0, z + f64(ss1 * -4.5f32))
        self.strikes = List<Aabb>()
        if struck {
            for k in [WING, WING + 1] {
                let w = self.boxed(k)
                self.strikes.push(Aabb { min_x: w.min_x - 4.0, min_y: w.min_y - 2.0 - 2.0, min_z: w.min_z - 4.0, max_x: w.max_x + 4.0, max_y: w.max_y + 2.0 - 2.0, max_z: w.max_z + 4.0 })
            }
            for k in [HEAD, NECK] {
                let near = self.boxed(k)
                self.strikes.push(near.inflate(1.0, 1.0, 1.0))
            }
        }
        let rot2 = y_rot * DEG_TO_RAD - self.y_rot_a * 0.01f32
        let ss2 = table_sin(f64(rot2))
        let cc2 = table_cos(f64(rot2))
        let (y0, _) = self.sample(0)
        let y_offset = if self.sitting() { -1.0f32 } else { f32.nearest(y5 - y0) }
        self.parts[HEAD] = (x + f64(ss2 * 6.5f32 * cc_tilt), y + f64(y_offset + ss_tilt * 6.5f32), z + f64(-cc2 * 6.5f32 * cc_tilt))
        self.parts[NECK] = (x + f64(ss2 * 5.5f32 * cc_tilt), y + f64(y_offset + ss_tilt * 5.5f32), z + f64(-cc2 * 5.5f32 * cc_tilt))
        let lengths = [2.0f32, 4.0f32, 6.0f32]
        for i in 0..TAILS {
            let (p0y, p0r) = self.sample(12 + i32.wrap(i) * 2)
            let rot = y_rot * DEG_TO_RAD + f32.nearest(wrap_degrees_f64(f64(p0r - r5))) * DEG_TO_RAD
            let ss = table_sin(f64(rot))
            let cc = table_cos(f64(rot))
            let dd = lengths[i]
            let up = p0y - y5 - f64((dd + 1.5f32) * ss_tilt) + 1.5
            self.parts[TAIL + i] = (x + f64(-(ss1 * 1.5f32 + ss * dd) * cc_tilt), y + up, z + f64((cc1 * 1.5f32 + cc * dd) * cc_tilt))
        }
    }

    /// The box of its part `i`, as `part_box` has it.
    pub fn boxed(self, i: usize) -> Aabb {
        let (x0, y0, z0, x1, y1, z1) = self.part_box(i)
        return Aabb { min_x: x0, min_y: y0, min_z: z0, max_x: x1, max_y: y1, max_z: z1 }
    }

    /// The box of its part `i`, as `EntityDimensions.scalable` makes it about its place: its width
    /// across each way and its height up.
    pub fn part_box(self, i: usize) -> (f64, f64, f64, f64, f64, f64) {
        let (x, y, z) = self.parts[i]
        let (w, h) = part_size(i)
        let half = f64(w) / 2.0
        return (x - half, y, z - half, x + half, y + f64(h), z + half)
    }

    /// Each part moved by dx, dy, dz, `setPos(position().add(...))`, as its death lifts it.
    pub fn move_parts(mut self, dx: f64, dy: f64, dz: f64) {
        for i in 0..PARTS {
            let (x, y, z) = self.parts[i]
            self.parts[i] = (x + dx, y + dy, z + dz)
        }
    }
}

// How fast a phase turns it toward its target, `AbstractDragonPhaseInstance.getTurnSpeed`, as its
// motion across is `vx`, `vz`: the slower the faster, landing's own not yet.
fn turn_speed(vx: f64, vz: f64) -> f32 {
    let rot_speed = f32.nearest((vx * vx + vz * vz).sqrt()) + 1.0f32
    let most = if rot_speed > 40.0f32 { 40.0f32 } else { rot_speed }
    return 0.7f32 / most / rot_speed
}

// `Vec3.normalize`: none where it's shorter than 1e-5.
fn normalized(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let length = (x * x + y * y + z * z).sqrt()
    if length < f64(1.0e-5f32) {
        return (0.0, 0.0, 0.0)
    }
    return (x / length, y / length, z / length)
}

// `Mth.clamp` for doubles and floats, NaN kept as `Math.min` keeps it.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}

fn clamp_float(v: f32, lo: f32, hi: f32) -> f32 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}

// `Math.max` for floats, NaN kept.
fn most_of(v: f32, floor: f32) -> f32 {
    return if v < floor { floor } else { v }
}
