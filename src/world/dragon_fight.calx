/// The End's dragon fight as far as Calcite has it (D586), vanilla's `EnderDragonFight`: what its
/// saved data, `data/minecraft/ender_dragon_fight.dat` in its dimension's folder, says of it, as
/// its codec reads it, and the players its tick last found about its arena, its boss bar's,
/// while it has whom it puts its `dragon` ticket. A fight that's over, its state known and its
/// dragon killed, does nothing more, its boss bar unseen; another's scan of its arena, its dragon
/// and its respawn aren't in Calcite yet.
module world.dragon_fight

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data type a fight is saved as, `EnderDragonFight.TYPE`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "ender_dragon_fight" }
}

/// How far from its arena's middle, 0, 128, 0, a player's about it, `validPlayer`'s
/// `withinDistance`; and how many ticks its looks for them are apart,
/// `TIME_BETWEEN_PLAYER_SCANS`.
pub const ARENA_REACH: f64 = 192.0
pub const PLAYER_SCANS: i32 = 20

/// A dimension's dragon fight.
pub struct DragonFight {
    /// `needs_state_scanning`, `dragon_killed` and `previously_killed`, whether it's respawning
    /// its dragon, `respawn_stage`, and whether it has one, `dragon_uuid`, as its codec reads
    /// them, a new world's where they're missing.
    pub scanning: bool = true
    pub killed: bool = false
    pub previously_killed: bool = false
    pub respawning: bool = false
    pub dragon: bool = false
    /// The ticks since it last looked for players, `ticksSinceLastPlayerScan`, 21 as it's made, so
    /// its first tick looks; and the entity IDs of those it found, its boss bar's players.
    pub since_scan: i32 = 21
    pub players: List<i32> = List<i32>()
}

impl DragonFight {
    /// The fight the saved data's `root` holds, as `EnderDragonFight.CODEC` reads it: a new
    /// world's, with vanilla's error, where its `data` isn't a map; each flag its default where
    /// it's missing or isn't a number.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> DragonFight {
        if not root.contains("data") {
            lines.push(parse_failed(saved_id(), String("Not a map: null")))
            return DragonFight()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(saved_id(), "Not a map: {root["data"].to_snbt()}"))
                return DragonFight()
            },
        }
        return DragonFight { scanning: flag(data, "needs_state_scanning", true), killed: flag(data, "dragon_killed", false), previously_killed: flag(data, "previously_killed", false), respawning: data.contains("respawn_stage"), dragon: data.contains("dragon_uuid") }
    }

    /// Whether all it does is what Calcite has: its state known, `needsStateScanning` done, its
    /// dragon killed and none to respawn.
    pub fn over(self) -> bool {
        return not self.scanning and self.killed and not self.respawning
    }
}

// The flag `name` of `data`, a number not 0, or `missing` where it's missing or isn't a number.
fn flag(data: JavaHashMap<String, Tag>, name: str, missing: bool) -> bool {
    if not data.contains(name) {
        return missing
    }
    return match data[name].number_int() {
        some(v) => v != 0,
        none => missing,
    }
}
