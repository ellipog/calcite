/// The End's dragon fight as far as Calcite has it (D586, D623, D624), vanilla's
/// `EnderDragonFight`: its state, read from and saved to its saved data,
/// `data/minecraft/ender_dragon_fight.dat` in its dimension's folder, as its codec reads and
/// writes it; what its level's made gives it, `init`, its boss bar and its gateways' order; and
/// its boss bar, `dragonEvent`, shown to the players its tick last found about its arena, unseen
/// once its dragon's killed, while it has whom it puts its `dragon` ticket. A fight that's over,
/// its state known and its dragon killed, does nothing more; another's scan of its arena, its
/// dragon and its respawn aren't in Calcite yet.
module world.dragon_fight

import chat.component.{Component}
import java.uuid.{Uuid}
import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}
import world.boss_bars.{BossBar, BossSent, Viewer}
import world.pos.{BlockPos}

/// The saved data type a fight is saved as, `EnderDragonFight.TYPE`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "ender_dragon_fight" }
}

/// How far from its arena's middle, 0, 128, 0, a player's about it, `validPlayer`'s
/// `withinDistance`; and how many ticks its looks for them are apart,
/// `TIME_BETWEEN_PLAYER_SCANS`.
pub const ARENA_REACH: f64 = 192.0
pub const PLAYER_SCANS: i32 = 20

/// How many ticks it goes without word from its dragon before it looks for one, or makes one,
/// `findOrCreateDragon`; and how many apart its counts of its crystals are (D626).
pub const UNSEEN_TICKS: i32 = 1200
pub const CRYSTAL_SCANS: i32 = 100

/// The bottom and top of any level, `DimensionType.MIN_Y` and `MAX_Y`, which a spike's top box
/// reaches from and to, `getTopBoundingBox` (D626).
pub const LOWEST: f64 = -2032.0
pub const HIGHEST: f64 = 2031.0

/// How many end gateways a fight has to make, one each time its dragon's killed,
/// `GATEWAY_COUNT`; and the height it makes each at, `spawnNewGateway` (D627).
pub const GATEWAYS: i32 = 20
pub const GATEWAY_Y: i32 = 75

// Its boss bar's color, pink, and its notches, none, `BossBarColor.PINK` and
// `BossBarOverlay.PROGRESS` by their ordinals.
const PINK: i32 = 0
const PROGRESS: i32 = 0

/// A dimension's dragon fight.
pub struct DragonFight {
    /// `needs_state_scanning`, `dragon_killed` and `previously_killed`.
    pub scanning: bool = true
    pub killed: bool = false
    pub previously_killed: bool = false
    /// The stage of its dragon's respawn, `respawn_stage`, as its place among
    /// `DragonRespawnStage`'s, 0 for `start` to 4 for `end`, none where it isn't respawning;
    /// and the ticks it's been at that stage, `respawn_time`.
    pub respawn_stage: i32? = none
    pub respawn_time: i32 = 0
    /// Its dragon's UUID, `dragon_uuid`, where it has one; the place of its exit portal,
    /// `exit_portal_location`, where it's found it; the gateways it's yet to make, by their
    /// places about its arena, 0 to 19, the next first, `gateways`; and the end crystals its
    /// respawn's begun with, `respawn_crystals`.
    pub dragon: Uuid? = none
    pub exit_portal: BlockPos? = none
    pub gateways: List<i32> = List<i32>()
    pub respawn_crystals: List<Uuid> = List<Uuid>()
    /// Its boss bar, `dragonEvent`, which `init` makes, none till then, shown to the players it
    /// last found about its arena.
    pub bar: BossBar? = none
    /// The ticks since it last looked for players, `ticksSinceLastPlayerScan`, 21 as it's made, so
    /// its first tick looks.
    pub since_scan: i32 = 21
    /// The ticks since its dragon last told it it was seen, `ticksSinceDragonSeen`; the end
    /// crystals it counted alive on the spikes' tops, `aliveCrystals`; and the ticks since it
    /// counted them, `ticksSinceCrystalsScanned` (D626), none of which it's saved with.
    pub since_seen: i32 = 0
    pub alive_crystals: i32 = 0
    pub since_crystals: i32 = 0
    /// Whether it's changed since it was last saved, `setDirty`.
    pub dirty: bool = false
}

impl DragonFight {
    /// The fight the saved data's `root` holds, as `EnderDragonFight.CODEC` reads it: a new
    /// world's, with vanilla's error, where its `data` isn't a map. A field that's there but
    /// can't be read is its default, as `resultOrPartial` keeps what the rest made, its problem
    /// logged; `dragon_uuid`, `exit_portal_location` and `gateways` are read leniently, as
    /// though they weren't there, without a word.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> DragonFight {
        if not root.contains("data") {
            lines.push(parse_failed(saved_id(), String("Not a map: null")))
            return DragonFight()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(saved_id(), "Not a map: {root["data"].to_snbt()}"))
                return DragonFight()
            },
        }
        var problems = List<String>()
        var fight = DragonFight()
        fight.scanning = flag(data, "needs_state_scanning", true, mut problems)
        fight.killed = flag(data, "dragon_killed", false, mut problems)
        fight.previously_killed = flag(data, "previously_killed", false, mut problems)
        if data.contains("respawn_stage") {
            match data["respawn_stage"] {
                Tag.Str(name) => match stage_named(name.copy()) {
                    some(stage) => fight.respawn_stage = some(stage),
                    none => problems.push("Unknown element name:{name}"),
                },
                _ => problems.push(String("Not a string")),
            }
        }
        if data.contains("respawn_time") {
            match data["respawn_time"].number_int() {
                some(t) => fight.respawn_time = t,
                none => problems.push(String("Not a number")),
            }
        }
        if data.contains("dragon_uuid") {
            var error: String? = none
            if let ints = data["dragon_uuid"].fixed_ints(4, mut error) {
                if error == none {
                    fight.dragon = some(Uuid.from_ints(ints))
                }
            }
        }
        if data.contains("exit_portal_location") {
            var error: String? = none
            if let ints = data["exit_portal_location"].fixed_ints(3, mut error) {
                if error == none {
                    fight.exit_portal = some(BlockPos { x: ints[0], y: ints[1], z: ints[2] })
                }
            }
        }
        if data.contains("gateways") {
            fight.gateways = data["gateways"].int_stream() ?? List<i32>()
        }
        if data.contains("respawn_crystals") {
            fight.respawn_crystals = crystals(data["respawn_crystals"], mut problems)
        }
        if not problems.is_empty() {
            var joined = String()
            for p in problems {
                if not joined.is_empty() {
                    joined.push_str("; ")
                }
                joined.push_str(p)
            }
            lines.push(parse_failed(saved_id(), joined))
        }
        return fight
    }

    /// What its level's made gives it, `init`: its boss bar, a `ServerBossEvent` of the UUID
    /// `bar`, drawn from the level's random, `createInsecureUUID`, named for the ender dragon,
    /// pink, a bar without notches, full, playing boss music and making fog, shown to no one
    /// yet; and, where it has no gateways yet to make, all 20 in an order shuffled with a random
    /// of the world's `seed`, `Util.shuffle`, marked to be saved.
    pub fn init(mut self, bar: Uuid, seed: i64) {
        let name = Component.translatable(String("entity.minecraft.ender_dragon"), List<Component>())
        self.bar = some(BossBar { id: Identifier { namespace: "minecraft", path: "ender_dragon" }, uuid: bar, name: name, progress: 1.0f32, color: PINK, overlay: PROGRESS, music: true, fog: true })
        if self.gateways.is_empty() {
            var order = List<i32>()
            for i in 0..GATEWAYS {
                order.push(i)
            }
            var random = LegacyRandom.new(seed)
            var i = order.len()
            while i > 1 {
                let to = usize.wrap(random.next_int_below(i32.wrap(i)))
                let moved = order[i - 1]
                order[i - 1] = order[to]
                order[to] = moved
                i -= 1
            }
            self.gateways = order
            self.dirty = true
        }
    }

    /// Whether all it does is what Calcite has: its state known, `needsStateScanning` done, its
    /// dragon killed and none to respawn.
    pub fn over(self) -> bool {
        return not self.scanning and self.killed and self.respawn_stage == none
    }

    /// `setVisible(!dragonKilled)`, as its tick begins: its boss bar shown to those it's shown to
    /// where its dragon isn't killed, taken from them where it is, as that changes.
    pub fn show_bar(mut self, sent: mut List<BossSent>) {
        var bar = self.bar.take() else return
        bar.set_visible(not self.killed, mut sent)
        self.bar = some(bar)
    }

    /// `updatePlayers`: its boss bar shown to each of `found`, the players about its arena, in
    /// their order, `addPlayer`, sent to those it's new to where it's shown; then taken from each
    /// it was shown to that isn't among them, in the order they came, `removePlayer`.
    pub fn update_players(mut self, found: List<Viewer>, sent: mut List<BossSent>) {
        var bar = self.bar.take() else return
        for v in found {
            _ = bar.show_to(v, mut sent)
        }
        for v in bar.viewers.copy() {
            if not among(found, v) {
                _ = bar.stop_showing(v, mut sent)
            }
        }
        self.bar = some(bar)
    }

    /// Whether its boss bar's shown to anyone, `getPlayers().isEmpty()` not, as its tick asks
    /// whether there are players about its arena.
    pub fn has_players(self) -> bool {
        return match self.bar {
            some(b) => not b.viewers.is_empty(),
            none => false,
        }
    }

    /// Its `data` to save, where it's changed since it was last saved, as the codec writes it:
    /// its three flags, its respawn's stage where it's respawning, its respawn's ticks, its
    /// dragon's UUID and its exit portal's place where it has them, and its gateways and its
    /// respawn's crystals where it has any.
    pub fn take_save(mut self) -> Tag? {
        if not self.dirty {
            return none
        }
        self.dirty = false
        var m = JavaHashMap<String, Tag>()
        m.insert(String("needs_state_scanning"), byte_of(self.scanning))
        m.insert(String("dragon_killed"), byte_of(self.killed))
        m.insert(String("previously_killed"), byte_of(self.previously_killed))
        if let stage = self.respawn_stage {
            m.insert(String("respawn_stage"), Tag.Str(String(stage_name(stage))))
        }
        m.insert(String("respawn_time"), Tag.Int(self.respawn_time))
        if let u = self.dragon {
            m.insert(String("dragon_uuid"), Tag.IntArray(u.ints()))
        }
        if let p = self.exit_portal {
            m.insert(String("exit_portal_location"), Tag.IntArray([p.x, p.y, p.z]))
        }
        if not self.gateways.is_empty() {
            var items = List<Tag>()
            for g in self.gateways {
                items.push(Tag.Int(g))
            }
            m.insert(String("gateways"), Tag.List(items))
        }
        if not self.respawn_crystals.is_empty() {
            var items = List<Tag>()
            for c in self.respawn_crystals {
                items.push(Tag.IntArray(c.ints()))
            }
            m.insert(String("respawn_crystals"), Tag.List(items))
        }
        return some(Tag.Compound(m))
    }
}

/// The name of the respawn stage `stage`, `DragonRespawnStage.getSerializedName`.
pub fn stage_name(stage: i32) -> str {
    return match stage {
        0 => "start",
        1 => "preparing_to_summon_pillars",
        2 => "summoning_pillars",
        3 => "summoning_dragon",
        _ => "end",
    }
}

// The respawn stage of the name `name`, none for one that isn't.
fn stage_named(name: String) -> i32? {
    for stage in 0..5 {
        if name == String(stage_name(stage)) {
            return some(stage)
        }
    }
    return none
}

// The flag `name` of `data`, `Codec.BOOL`'s, a number not 0, or `missing` where it's missing,
// and where it isn't a number, which is a problem.
fn flag(data: JavaHashMap<String, Tag>, name: str, missing: bool, problems: mut List<String>) -> bool {
    if not data.contains(name) {
        return missing
    }
    return match data[name].number_bool() {
        some(v) => v,
        none => {
            problems.push(String("Not a number"))
            missing
        },
    }
}

// The end crystals' UUIDs a list holds, as `Codec.list(EntityReference.codec())` reads them: each
// that reads, one of more than four ints its first four; a problem for each that doesn't, and
// none at all for what isn't a list.
fn crystals(tag: Tag, problems: mut List<String>) -> List<Uuid> {
    let items = match tag {
        Tag.List(l) => l.copy(),
        Tag.ByteArray(a) => {
            var out = List<Tag>()
            for v in a {
                out.push(Tag.Byte(v))
            }
            out
        },
        Tag.IntArray(a) => {
            var out = List<Tag>()
            for v in a {
                out.push(Tag.Int(v))
            }
            out
        },
        Tag.LongArray(a) => {
            var out = List<Tag>()
            for v in a {
                out.push(Tag.Long(v))
            }
            out
        },
        other => {
            problems.push("Not a list: {other.to_snbt()}")
            return List<Uuid>()
        },
    }
    var out = List<Uuid>()
    for item in items {
        var error: String? = none
        if let ints = item.fixed_ints(4, mut error) {
            out.push(Uuid.from_ints(ints))
        }
        if let e = error {
            problems.push(e)
        }
    }
    return out
}

// Whether `v`, a player of a life, is among `found`.
fn among(found: List<Viewer>, v: Viewer) -> bool {
    for f in found {
        if f.entity == v.entity and f.serial == v.serial {
            return true
        }
    }
    return false
}

// A flag as `Codec.BOOL` writes it, a byte.
fn byte_of(v: bool) -> Tag {
    return Tag.Byte(if v { 1i8 } else { 0i8 })
}
