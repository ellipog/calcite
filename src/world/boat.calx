/// A boat or a raft, plain or with a chest, as vanilla's `AbstractBoat` makes and runs it
/// (CAL-315): 1.375 by 0.5625, its eyes at its top, falling 0.04 a tick; its values `Entity`'s,
/// then `VehicleEntity`'s and its own, `boat_data`; the item it drops, its type's own.
///
/// Each tick, as `ServerLevel.tickNonPassenger` and `AbstractBoat.tick` run it: where it is in
/// water and how, `getStatus`, kept with what it was; 60 ticks under water, out of control, it
/// lets its riders go; its hurt time and damage a tick less; `Entity.baseTick`: its portal, the
/// fluids it's in pushing it, its fire, the bottom of the world; then, with no player steering
/// it, its paddles still, its float, `floatBoat`, and its move, `Entity.move`, against the blocks,
/// its fall its own, `checkFallDamage`; what the blocks along its move do to it, twice, as
/// `applyEffectsFromBlocks` runs twice; and a bubble column under it lifting or sinking it once its
/// time runs out, `tickBubbleColumn`.
///
/// It's hurt as `VehicleEntity.hurtServer` has it: rocked, shown hurt for 10 ticks, its damage
/// ten times the hurt more, and broken past 40, or at once by a creative player, gone with its
/// item dropped where the game rule `entity_drops` is on. It's saved as `saveAsPassenger` saves
/// it, `saved`, and loaded as `EntityType.create` makes one and `load` reads it in, `loaded`.
///
/// A chest boat holds 27 slots, `AbstractChestBoat`, or a loot table they're yet to be filled from;
/// its level opens, fills and spills them.
module world.boat

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, BodyFacts, EntitySound, PORTAL_DELAY, bool_or, int_or}
import world.collision.{Aabb, CollisionBlocks}
import world.currents.{height}
import world.damage.{BYPASSES_INVULNERABILITY, DamageTypes}
import world.entity_data.{AIR_SUPPLY, BOAT_BUBBLE_TIME, BOAT_PADDLE_LEFT, BOAT_PADDLE_RIGHT, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, ON_FIRE_FLAG, SHARED_FLAGS, SILENT, TICKS_FROZEN, VEHICLE_DAMAGE, VEHICLE_HURT, VEHICLE_HURT_DIR, Value, boat_data}
import world.flowing.{is_source, liquid_of}
import world.living.{view_vector}
import world.inside.{Acted, BlockEffect, CLEAR_FREEZE, Collector, EXTINGUISH, FIRE_IGNITE, FREEZE, Gateways, LAVA_IGNITE, Movement, Rain, Touched, bubble_open_above, fluid_effects, inside_blocks, touch_block}
import world.movement.{MovementStates, Mover, meets}
import worldgen.facts.{Facts}

/// Where a boat is, `AbstractBoat.Status`, by its ordinals.
pub const IN_WATER: i32 = 0
pub const UNDER_WATER: i32 = 1
pub const UNDER_FLOWING_WATER: i32 = 2
pub const ON_LAND: i32 = 3
pub const IN_AIR: i32 = 4
// What it is before its first tick finds it, null.
const NO_STATUS: i32 = -1

/// The boats' and rafts' types, by name, `EntityTypes`' `boatFactory`, `chestBoatFactory`,
/// `raftFactory` and `chestRaftFactory`, each dropping the item of its own name.
pub fn boat_kinds() -> List<str> {
    return ["minecraft:oak_boat", "minecraft:spruce_boat", "minecraft:birch_boat", "minecraft:jungle_boat", "minecraft:acacia_boat", "minecraft:cherry_boat", "minecraft:dark_oak_boat", "minecraft:pale_oak_boat", "minecraft:mangrove_boat", "minecraft:bamboo_raft", "minecraft:oak_chest_boat", "minecraft:spruce_chest_boat", "minecraft:birch_chest_boat", "minecraft:jungle_chest_boat", "minecraft:acacia_chest_boat", "minecraft:cherry_chest_boat", "minecraft:dark_oak_chest_boat", "minecraft:pale_oak_chest_boat", "minecraft:mangrove_chest_boat", "minecraft:bamboo_chest_raft"]
}

/// Whether `name` is a boat's or a raft's type, and so its item's.
pub fn is_boat_kind(name: String) -> bool {
    for k in boat_kinds() {
        if name == k {
            return true
        }
    }
    return false
}

/// A boat.
pub struct Boat {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s and its own.
    pub body: Body
    pub data: EntityData
    /// Its type, as `minecraft:oak_boat`, which is the item it drops too, `getDropItem`.
    pub kind: String
    /// Where it is in water and was last tick, `status` and `oldStatus`.
    status: i32 = NO_STATUS
    old_status: i32 = NO_STATUS
    /// How long it's been under water, `outOfControlTicks`.
    out_of_control: f32 = 0.0f32
    /// How fast it turns, `deltaRotation`, which its float slows.
    pub delta_rotation: f32 = 0.0f32
    /// The water's top where it floats, `waterLevel`; the blocks' friction under it, `landFriction`;
    /// how fast it fell as it last moved, `lastYd`.
    water_level: f64 = 0.0
    land_friction: f32 = 0.0f32
    last_yd: f64 = 0.0
    /// Whether a bubble column's under it this tick, and whether that drags it down.
    above_bubble: bool = false
    bubble_down: bool = false
    /// Its leash as it was read, `writeLeashData`, saved back as it was (CAL-315).
    pub leash: Tag? = none
    /// What its tick had its level do, each after so many of the tick's sounds, which its level
    /// takes as it's ticked: its way through a portal, what's missing, and its drop as it breaks.
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
    /// Whether it rose from or sank in a bubble column this tick, entity event 72 or 71, for its
    /// level to send.
    pub bubbled: i8? = none
    /// How far round each paddle is, left then right, `paddlePositions`.
    paddle_left: f32 = 0.0f32
    paddle_right: f32 = 0.0f32
    /// A chest boat's 27 slots, `itemStacks`, each a stack as it's saved or none, and the loot
    /// table it's yet to be filled from and its seed, `lootTable` and `lootTableSeed`.
    pub items: List<Tag?> = List<Tag?>()
    pub loot_table: String? = none
    pub loot_seed: i64 = 0
}

impl Boat {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z, of the type `kind`.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, kind: own String) -> Boat {
        let body = Body.made(id, seed, x, y, z, 1.375f32, 0.5625f32, 0.5625f32, 0.04)
        var b = Boat { body: body, data: boat_data(), kind: kind }
        if b.has_chest() {
            for _ in 0..27 {
                b.items.push(none)
            }
        }
        return b
    }

    /// The boat of the type `kind` its item places at x, y, z, turned `y_rot`, as `BoatItem.use`
    /// makes it, `setInitialPos` then `setYRot`, where it was before its first tick there too.
    pub fn placed(id: i32, seed: i64, x: f64, y: f64, z: f64, y_rot: f32, kind: own String) -> Boat {
        var b = Boat.made(id, seed, x, y, z, kind)
        b.body.xo = x
        b.body.yo = y
        b.body.zo = z
        b.body.y_rot = y_rot
        return b
    }

    /// Its type's name, `EntityType.getKey`, as its saved data's `id`.
    pub fn type_name(self) -> str {
        for k in boat_kinds() {
            if self.kind == k {
                return k
            }
        }
        return "minecraft:oak_boat"
    }

    /// Whether it's a raft, whose riders sit higher, `Raft`.
    pub fn raft(self) -> bool {
        return self.kind.ends_with("_raft")
    }

    /// Whether it has a chest, `AbstractChestBoat`.
    pub fn has_chest(self) -> bool {
        return self.kind.ends_with("_chest_boat") or self.kind.ends_with("_chest_raft")
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// Whether it's under water, `isUnderWater`, as its status last found.
    pub fn under_water(self) -> bool {
        return self.status == UNDER_WATER or self.status == UNDER_FLOWING_WATER
    }

    /// How long it's been out of control under water, which keeps players from boarding it at 60.
    pub fn out_of_control_ticks(self) -> f32 {
        return self.out_of_control
    }

    /// Its paddles as the player steering it works them, `setPaddleState`.
    pub fn set_paddles(mut self, left: bool, right: bool) {
        self.data.set(BOAT_PADDLE_LEFT, Value.Bool(left))
        self.data.set(BOAT_PADDLE_RIGHT, Value.Bool(right))
    }

    /// Its tick among `blocks`, as `tickNonPassenger` and `AbstractBoat.tick` run it, `steered`
    /// where a player steers it, its first rider, `getControllingPassenger`, in a level whose
    /// floor is `min_y`, where lava's fast if `fast_lava`, its hurts of `types`. Whether it's to
    /// let its riders go, 60 ticks under water.
    pub fn tick<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, blocks: B, min_y: i32, fast_lava: bool, drops: bool, steered: bool, sounds: mut List<EntitySound>) -> bool {
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        self.old_status = self.status
        self.status = self.find_status(f, m, blocks)
        if self.status != UNDER_WATER and self.status != UNDER_FLOWING_WATER {
            self.out_of_control = 0.0f32
        } else {
            self.out_of_control += 1.0f32
        }
        let eject = self.out_of_control >= 60.0f32
        let hurt_time = self.data.number(VEHICLE_HURT)
        if hurt_time > 0 {
            self.data.set(VEHICLE_HURT, Value.Number(hurt_time - 1))
        }
        let damage = self.data.float(VEHICLE_DAMAGE)
        if damage > 0.0f32 {
            self.data.set(VEHICLE_DAMAGE, Value.Float(damage - 1.0f32))
        }
        self.base_tick(f, t, types, blocks, min_y, fast_lava, drops, mut sounds)
        if self.body.removed {
            return eject
        }
        if steered {
            // Its player's client moves it, so the server's keeps it still,
            // `isLocalInstanceAuthoritative`.
            self.body.vx = 0.0
            self.body.vy = 0.0
            self.body.vz = 0.0
            self.delta_rotation = 0.0f32
        } else {
            // The server's with no player steering it: no rider works its paddles.
            self.set_paddles(false, false)
            self.float_boat(f, m, blocks)
            let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
            self.move_boat(f, m, t, blocks, vx, vy, vz)
        }
        for _ in 0..2 {
            let moves = self.body.final_moves()
            self.blocks_act(f, t, types, blocks, moves, drops, mut sounds)
        }
        self.tick_bubble_column()
        let left = self.paddle_left
        self.paddle_left = self.paddle(f, m, blocks, 0, left, steered, mut sounds)
        let right = self.paddle_right
        self.paddle_right = self.paddle(f, m, blocks, 1, right, steered, mut sounds)
        return eject
    }

    // The paddle `side`, 0 the left, at `at`, a sixteenth of the way further round where it's
    // worked by a player steering it, `getPaddleState`, else back at 0; heard as it dips, unless
    // it's silent, beside it where it is, as it is in water or on land as found again then,
    // `getPaddleSound`, which keeps what that finds of the water and the blocks under it. Where
    // it's round to now.
    fn paddle<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, side: i32, at: f32, steered: bool, sounds: mut List<EntitySound>) -> f32 {
        let worked = steered and self.data.flag(if side == 0 { BOAT_PADDLE_LEFT } else { BOAT_PADDLE_RIGHT })
        if not worked {
            return 0.0f32
        }
        let turn = 6.2831855f32
        let eighth = 0.7853982f32
        let sixteenth = 0.3926991f32
        if not self.silent() and at % turn <= eighth and (at + sixteenth) % turn >= eighth {
            let status = self.find_status(f, m, blocks)
            let sound = if status == IN_WATER or status == UNDER_WATER or status == UNDER_FLOWING_WATER { "entity.boat.paddle_water" } else if status == ON_LAND { "entity.boat.paddle_land" } else { "" }
            if sound != "" {
                let (vx, _, vz) = view_vector(self.body.x_rot, self.body.y_rot)
                let dx = if side == 1 { -vz } else { vz }
                let dz = if side == 1 { vx } else { -vx }
                let pitch = 0.8f32 + 0.4f32 * self.body.random.next_float()
                sounds.push(EntitySound { sound: String(sound), x: self.body.x + dx, y: self.body.y, z: self.body.z + dz, volume: 1.0f32, pitch: pitch, source: self.body.sound_source })
            }
        }
        return at + sixteenth
    }

    /// `Entity.move` of it by `MoverType.PLAYER` by dx, dy, dz, as its player's client moved it,
    /// `handleMoveVehicle` (CAL-315), as its own tick moves it.
    pub fn moved_by<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64) {
        self.move_boat(f, m, t, blocks, dx, dy, dz)
    }

    /// The end of `handleMoveVehicle` for it, its player's client having moved it by dx, dy, dz,
    /// on the ground or not, `ground` (CAL-315): on the ground as the client says,
    /// `setOnGroundWithMovement`, then its own fall, `doCheckFallDamage` and `checkFallDamage`.
    pub fn client_landed<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, dx: f64, dy: f64, dz: f64, ground: bool) {
        self.body.set_on_ground(f, m, blocks, ground, dx, dz)
        self.fall_after(f, blocks, dy)
    }

    // `checkFallDamage` after a move down by `dy`: its motion down as it last moved, `lastYd`;
    // riding nothing, its fall forgotten on the ground, else growing where there's no water
    // under it.
    fn fall_after<B: CollisionBlocks>(mut self, f: Facts, blocks: B, dy: f64) {
        self.last_yd = self.body.vy
        if self.body.vehicle == none {
            if self.body.on_ground {
                self.body.reset_fall()
            } else {
                let (bx, by, bz) = self.body.block()
                let below = blocks.collision_state(bx, by - 1, bz) ?? 0
                if not f.is_water(below) and dy < 0.0 {
                    self.body.fall = self.body.fall - f64(f32.nearest(dy))
                }
            }
        }
    }

    /// `canAddPassenger`: fewer riders than it seats, two, or one with a chest, and its eyes out
    /// of water.
    pub fn has_room(self) -> bool {
        let most: usize = if self.has_chest() { 1 } else { 2 }
        return self.body.passengers.len() < most and not self.body.water_eyes
    }

    /// Where it seats the `index`th of its riders, an animal or not, before its turn,
    /// `getPassengerAttachmentPoint`: up its ride height, a third of its height, or 0.8888889 of
    /// it for a raft; and along it by 0.15 alone with a chest, else none; with two, the first 0.2
    /// forward and the second 0.6 back, an animal 0.2 forward of that.
    pub fn seat(self, index: usize, animal: bool) -> (f64, f64, f64) {
        var offset = if self.has_chest() { 0.15f32 } else { 0.0f32 }
        if self.body.passengers.len() > 1 {
            offset = if index == 0 { 0.2f32 } else { -0.6f32 }
            if animal {
                offset += 0.2f32
            }
        }
        let rise = if self.raft() { self.body.height * 0.8888889f32 } else { self.body.height / 3.0f32 }
        return (0.0, f64(rise), f64(offset))
    }

    // `Entity.baseTick`: its portal's cooldown and its way through a portal it's in, its cooldown
    // then 300, what it saves then its level's to take on (D578); the fluids it's in, which push it
    // and splash where it falls in; its fire burning it, 1 of `on_fire` every 20 ticks out of lava;
    // its fall halved in lava; gone 64 below the world; and its flag of being on fire.
    fn base_tick<B: CollisionBlocks + Gateways>(mut self, f: Facts, t: BodyFacts, types: DamageTypes, blocks: B, min_y: i32, fast_lava: bool, drops: bool, sounds: mut List<EntitySound>) {
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        let alive = not self.body.removed
        if let p = self.body.portal_goes(alive, PORTAL_DELAY) {
            if p.gateway {
                if let done = self.body.gateway_goes(p, blocks, false, true) {
                    self.act(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.body.travel(p, saved)
                self.act(Acted.Travel(way), sounds.len())
            }
        }
        _ = self.body.update_fluids(f, t, blocks, fast_lava, true, mut sounds)
        if self.body.fire > 0 {
            if self.body.fire_tick(false) {
                _ = self.hurt(types, types.id("on_fire"), 1.0f32, false, drops, sounds.len())
            }
        }
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let shown = self.body.fire_shown()
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, shown)
        self.body.first_tick = false
    }

    // `getStatus`: under water, `isUnderwater`, its top at the water level; else in water,
    // `checkInWater`; else on land where the blocks under it have friction, `getGroundFriction`,
    // which it keeps; else in the air.
    fn find_status<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B) -> i32 {
        if let under = self.underwater(f, blocks) {
            self.water_level = self.body.bounding_box().max_y
            return under
        }
        if self.check_in_water(f, blocks) {
            return IN_WATER
        }
        let friction = self.ground_friction(f, m, blocks)
        if friction > 0.0f32 {
            self.land_friction = friction
            return ON_LAND
        }
        return IN_AIR
    }

    // `isUnderwater`: water over its top in a block its top's in, flowing water first found
    // giving `UNDER_FLOWING_WATER`, else a source `UNDER_WATER`; none where there's neither.
    fn underwater<B: CollisionBlocks>(self, f: Facts, blocks: B) -> i32? {
        let b = self.body.bounding_box()
        let top = b.max_y + 0.001
        let x0 = i32.saturate(b.min_x.floor())
        let x1 = i32.saturate(b.max_x.ceil())
        let y0 = i32.saturate(b.max_y.floor())
        let y1 = i32.saturate(top.ceil())
        let z0 = i32.saturate(b.min_z.floor())
        let z1 = i32.saturate(b.max_z.ceil())
        var under = false
        for x in x0..x1 {
            for y in y0..y1 {
                for z in z0..z1 {
                    let state = blocks.collision_state(x, y, z) ?? 0
                    if not f.is_water(state) {
                        continue
                    }
                    let l = liquid_of(f, state)
                    if top < f64(f32.nearest(y) + height(f, blocks, l, x, y, z)) {
                        if not is_source(l) {
                            return some(UNDER_FLOWING_WATER)
                        }
                        under = true
                    }
                }
            }
        }
        return if under { some(UNDER_WATER) } else { none }
    }

    // `checkInWater`: whether water in the blocks its bottom's in comes above its bottom, the
    // water level the highest such water's top.
    fn check_in_water<B: CollisionBlocks>(mut self, f: Facts, blocks: B) -> bool {
        let b = self.body.bounding_box()
        let x0 = i32.saturate(b.min_x.floor())
        let x1 = i32.saturate(b.max_x.ceil())
        let y0 = i32.saturate(b.min_y.floor())
        let y1 = i32.saturate((b.min_y + 0.001).ceil())
        let z0 = i32.saturate(b.min_z.floor())
        let z1 = i32.saturate(b.max_z.ceil())
        var wet = false
        self.water_level = -1.7976931348623157e308
        for x in x0..x1 {
            for y in y0..y1 {
                for z in z0..z1 {
                    let state = blocks.collision_state(x, y, z) ?? 0
                    if not f.is_water(state) {
                        continue
                    }
                    let top = f32.nearest(y) + height(f, blocks, liquid_of(f, state), x, y, z)
                    if f64(top) > self.water_level {
                        self.water_level = f64(top)
                    }
                    wet = wet or b.min_y < f64(top)
                }
            }
        }
        return wet
    }

    // `getGroundFriction`: the friction of the blocks whose shapes meet a slab a thousandth deep
    // under it, but lily pads, on average, among those a block around but the corners and the
    // edges' top and bottom; 0 where there are none, and NaN, as vanilla's is, where none counts.
    fn ground_friction<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B) -> f32 {
        let bb = self.body.bounding_box()
        let slab = Aabb { min_x: bb.min_x, min_y: bb.min_y - 0.001, min_z: bb.min_z, max_x: bb.max_x, max_y: bb.min_y, max_z: bb.max_z }
        let x0 = i32.saturate(slab.min_x.floor()) - 1
        let x1 = i32.saturate(slab.max_x.ceil()) + 1
        let y0 = i32.saturate(slab.min_y.floor()) - 1
        let y1 = i32.saturate(slab.max_y.ceil()) + 1
        let z0 = i32.saturate(slab.min_z.floor()) - 1
        let z1 = i32.saturate(slab.max_z.ceil()) + 1
        var friction = 0.0f32
        var count = 0
        let empty = Mover { y: -1.0e300, fall: 0.0 }
        for x in x0..x1 {
            for z in z0..z1 {
                let edges = (if x != x0 and x != x1 - 1 { 0 } else { 1 }) + (if z != z0 and z != z1 - 1 { 0 } else { 1 })
                if edges == 2 {
                    continue
                }
                for y in y0..y1 {
                    if edges > 0 and (y == y0 or y == y1 - 1) {
                        continue
                    }
                    let state = blocks.collision_state(x, y, z) ?? 0
                    let block = f.block(state)
                    if f.is_a(block, String("LilyPadBlock")) {
                        continue
                    }
                    var meets_it = false
                    for part in m.boxes_at(f, blocks, state, x, y, z, empty) {
                        let moved = Aabb { min_x: part.min_x + f64(x), min_y: part.min_y + f64(y), min_z: part.min_z + f64(z), max_x: part.max_x + f64(x), max_y: part.max_y + f64(y), max_z: part.max_z + f64(z) }
                        if meets(moved, slab) {
                            meets_it = true
                            break
                        }
                    }
                    if meets_it {
                        friction += m.friction(block)
                        count += 1
                    }
                }
            }
        }
        return friction / f32.nearest(count)
    }

    // `floatBoat`: just come down from the air into water, set on the water where nothing's in
    // the way, `getWaterLevelAbove`, its fall across kept, and in water now; else its fall and its
    // slowing by where it is, `invFriction`, and buoyed up in water by how deep it's in.
    fn float_boat<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B) {
        var vspeed = -self.body.gravity_now()
        var buoyancy = 0.0
        var inv = 0.05f32
        if self.old_status == IN_AIR and self.status != IN_AIR and self.status != ON_LAND {
            self.water_level = self.body.y + f64(self.body.height)
            let target = f64(self.water_level_above(f, blocks) - self.body.height) + 0.101
            let b = self.body.bounding_box()
            let dy = target - self.body.y
            let there = Aabb { min_x: b.min_x, min_y: b.min_y + dy, min_z: b.min_z, max_x: b.max_x, max_y: b.max_y + dy, max_z: b.max_z }
            if m.colliders(f, blocks, there, self.body.mover()).is_empty() {
                self.body.y = target
                self.body.vy = 0.0
                self.last_yd = 0.0
            }
            self.status = IN_WATER
            return
        }
        if self.status == IN_WATER {
            buoyancy = (self.water_level - self.body.y) / f64(self.body.height)
            inv = 0.9f32
        } else if self.status == UNDER_FLOWING_WATER {
            vspeed = -7.0e-4
            inv = 0.9f32
        } else if self.status == UNDER_WATER {
            buoyancy = f64(0.01f32)
            inv = 0.45f32
        } else if self.status == IN_AIR {
            inv = 0.9f32
        } else if self.status == ON_LAND {
            inv = self.land_friction
        }
        self.body.vx = self.body.vx * f64(inv)
        self.body.vy = self.body.vy + vspeed
        self.body.vz = self.body.vz * f64(inv)
        self.delta_rotation = self.delta_rotation * inv
        if buoyancy > 0.0 {
            self.body.vy = (self.body.vy + buoyancy * (0.04 / 0.65)) * 0.75
        }
    }

    // `getWaterLevelAbove`: from the block its top's in up to where its last fall would take its
    // top, the first layer not full of water across its box, where its water comes up to; else a
    // block above the last.
    fn water_level_above<B: CollisionBlocks>(self, f: Facts, blocks: B) -> f32 {
        let b = self.body.bounding_box()
        let x0 = i32.saturate(b.min_x.floor())
        let x1 = i32.saturate(b.max_x.ceil())
        let y0 = i32.saturate(b.max_y.floor())
        let y1 = i32.saturate((b.max_y - self.last_yd).ceil())
        let z0 = i32.saturate(b.min_z.floor())
        let z1 = i32.saturate(b.max_z.ceil())
        for y in y0..y1 {
            var top = 0.0f32
            var full = false
            for x in x0..x1 {
                for z in z0..z1 {
                    let state = blocks.collision_state(x, y, z) ?? 0
                    if f.is_water(state) {
                        let h = height(f, blocks, liquid_of(f, state), x, y, z)
                        if h > top {
                            top = h
                        }
                    }
                    if top >= 1.0f32 {
                        full = true
                        break
                    }
                }
                if full {
                    break
                }
            }
            if not full and top < 1.0f32 {
                return f32.nearest(y) + top
            }
        }
        return f32.nearest(y1 + 1)
    }

    // `Entity.move` by dx, dy, dz for itself, as `move_by` but for its fall, `checkFallDamage`:
    // how fast it was falling kept, `lastYd`, and, riding nothing, its fall forgotten on the ground,
    // else added to where it moved down out of water below. No block's `fallOn` is anything to it.
    fn move_boat<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64) {
        let (sx, sy, sz) = self.body.unstuck_move(dx, dy, dz)
        let went = self.body.collide_move(f, m, t, blocks, sx, sy, sz) else return
        self.fall_after(f, blocks, went.my)
        if self.body.removed {
            return
        }
        self.body.bounce_after(f, m, t, went)
        self.body.slow_by_block(f, m, t, blocks)
    }

    // `applyEffectsFromBlocks` along `moves`, where blocks act on it, as they don't on what's
    // gone: what the block it's on does, `stepOn`; then what it's inside, the fluids' gathered and
    // applied in their order, fire setting it alight and hurting it, lava too, a bubble column
    // under open water acting on it as a boat's, `onAboveBubbleColumn`; then the rain.
    fn blocks_act<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, t: BodyFacts, types: DamageTypes, blocks: B, moves: List<Movement>, drops: bool, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        if let a = self.body.step_on_block(f, t, blocks, false) {
            self.act(a, sounds.len())
        }
        let froze = self.body.extras.contains("TicksFrozen")
        let was = (self.body.burning(false), froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height, self.body.fall) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                match touch_block(f, i, mut c, false, false, self.body.on_ground, self.body.y) {
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Plate(at) => self.act(Acted.Plate(at), sounds.len()),
                    Touched.Tripwire(at) => self.act(Acted.Tripwire(at), sounds.len()),
                    Touched.Dripleaf(at) => self.act(Acted.Dripleaf(at), sounds.len()),
                    Touched.Rail(at) => self.act(Acted.Rail(at), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, false),
                    Touched.EndPortal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, true),
                    Touched.Gateway(g) => {
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if not self.body.removed and blocks.gateway_open(gx, gy, gz) {
                            self.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.act(Acted.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    Touched.Web => self.body.web(),
                    Touched.Honey((hx, hy, hz)) => {
                        if self.body.honey_slide(hx, hy, hz) {
                            let at: ((f64, f64, f64), i32)? = if self.silent() { none } else { some(((self.body.x, self.body.y, self.body.z), self.body.sound_source)) }
                            self.act(Acted.Honey(at), sounds.len())
                        }
                    },
                    Touched.PowderSnow((_, sy, _)) => {
                        if self.body.powder_snow() {
                            let at = (self.body.x, f64(sy + 1), self.body.z)
                            self.act(Acted.Snow(at), sounds.len())
                        }
                    },
                    Touched.Bubble((drag, (bx, by, bz))) => {
                        if bubble_open_above(f, blocks, bx, by, bz) {
                            self.on_above_bubble(drag)
                        } else {
                            self.body.bubble_column(drag, false)
                        }
                    },
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => {
                    if kind == CLEAR_FREEZE {
                        _ = self.body.extras.remove("TicksFrozen")
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == FIRE_IGNITE {
                        if self.body.fire_ignite(false, 0) {
                            _ = self.body.extras.remove("TicksFrozen")
                            self.data.set(TICKS_FROZEN, Value.Number(0))
                        }
                    } else if kind == LAVA_IGNITE {
                        self.body.ignite_for(300)
                        _ = self.body.extras.remove("TicksFrozen")
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == EXTINGUISH {
                        self.body.put_out()
                    } else if kind == FREEZE {
                        _ = self.body.freeze()
                        self.data.set(TICKS_FROZEN, Value.Number(self.body.frozen()))
                    }
                },
                BlockEffect.InFire(amount) => {
                    _ = self.hurt(types, types.id("in_fire"), amount, false, drops, sounds.len())
                },
                BlockEffect.LavaHurt => {
                    if self.hurt(types, types.id("lava"), 4.0f32, false, drops, sounds.len()) and not self.silent() {
                        let pitch = 2.0f32 + self.body.random.next_float() * 0.4f32
                        sounds.push(EntitySound { sound: String("entity.generic.burn"), x: self.body.x, y: self.body.y, z: self.body.z, volume: 0.4f32, pitch: pitch, source: self.body.sound_source })
                    }
                },
                BlockEffect.Doused(at) => {
                    if self.body.burning(false) {
                        self.act(Acted.Doused(at), sounds.len())
                    }
                },
                BlockEffect.Melted(at) => {
                    if self.body.burning(false) {
                        self.act(Acted.Melted(at), sounds.len())
                    }
                },
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.body.extras.contains("TicksFrozen")
        self.body.after_inside(false, was, freezing, rained, mut sounds)
    }

    // `AbstractBoat.onAboveBubbleColumn` on the server: a bubble column under it this tick,
    // dragging it down where `drag`, its time begun at 60 where it had none; and, out of water,
    // one time in 100, the splash's pitch and place drawn from its random, which only a client
    // hears and sees.
    fn on_above_bubble(mut self, drag: bool) {
        self.above_bubble = true
        self.bubble_down = drag
        if self.data.number(BOAT_BUBBLE_TIME) == 0 {
            self.data.set(BOAT_BUBBLE_TIME, Value.Number(60))
        }
        if not self.under_water() and self.body.random.next_int_below(100) == 0 {
            _ = self.body.random.next_float()
            _ = self.body.random.next_float()
            _ = self.body.random.next_float()
        }
    }

    // `tickBubbleColumn` on the server: with no bubble column under it, its time gone; else its
    // time a tick less, and as it runs out, a column dragging down lets its riders go and sinks
    // it, entity event 71, and one pushing up lifts it, 72, `handleBubbleColumnEffect`.
    fn tick_bubble_column(mut self) {
        if not self.above_bubble {
            self.data.set(BOAT_BUBBLE_TIME, Value.Number(0))
        }
        var time = self.data.number(BOAT_BUBBLE_TIME)
        if time > 0 {
            time -= 1
            self.data.set(BOAT_BUBBLE_TIME, Value.Number(time))
            let diff = 60 - time - 1
            if diff > 0 and time == 0 {
                self.data.set(BOAT_BUBBLE_TIME, Value.Number(0))
                if self.bubble_down {
                    self.bubbled = some(71i8)
                    self.body.vy = self.body.vy + -0.7
                } else {
                    self.bubbled = some(72i8)
                    self.body.vy = 0.6
                }
            }
            self.above_bubble = false
        }
    }

    /// `VehicleEntity.hurtServer` by `amount` of the damage `kind`, by a player in creative mode
    /// where `creative`: nothing where it's gone, or invulnerable to it, `isInvulnerableToBase`;
    /// else rocked the other way, shown hurt for 10 ticks, its motion sent, `markHurt`, and its
    /// damage ten times the hurt more; gone at once by a creative player, `discard`, else broken
    /// past 40, `destroy`, its item dropped, named as it is, where `drops`, the game rule
    /// `entity_drops`, after `heard` of its tick's sounds. Whether it took it.
    pub fn hurt(mut self, types: DamageTypes, kind: i32, amount: f32, creative: bool, drops: bool, heard: usize) -> bool {
        if self.body.removed {
            return true
        }
        if self.body.invulnerable and not types.is(kind, BYPASSES_INVULNERABILITY) and not creative {
            return false
        }
        let dir = self.data.number(VEHICLE_HURT_DIR)
        self.data.set(VEHICLE_HURT_DIR, Value.Number(-dir))
        self.data.set(VEHICLE_HURT, Value.Number(10))
        self.body.sync_velocity = true
        let damage = self.data.float(VEHICLE_DAMAGE) + amount * 10.0f32
        self.data.set(VEHICLE_DAMAGE, Value.Float(damage))
        if creative {
            self.body.removed = true
        } else if damage > 40.0f32 {
            self.body.removed = true
            if drops {
                var stack = JavaHashMap<String, Tag>()
                stack.insert(String("id"), Tag.Str(self.kind.copy()))
                stack.insert(String("count"), Tag.Int(1))
                if self.body.extras.contains("CustomName") {
                    var components = JavaHashMap<String, Tag>()
                    components.insert(String("minecraft:custom_name"), self.body.extras["CustomName"].copy())
                    stack.insert(String("components"), Tag.Compound(components))
                }
                let dropped = Acted.Dropped(((self.body.x, self.body.y, self.body.z), Tag.Compound(stack)))
                self.act(dropped, heard)
            }
        }
        return true
    }

    /// The stacks it dropped as it broke, each where it's made, `spawnAtLocation`, taken out of
    /// what it did, which is then cleared, for a level hurting it outside its tick.
    pub fn take_drops(mut self) -> List<((f64, f64, f64), Tag)> {
        var out = List<((f64, f64, f64), Tag)>()
        for a in self.acted {
            if let Acted.Dropped((at, stack)) = a {
                out.push((at, stack.copy()))
            }
        }
        self.acted.clear()
        self.acted_after.clear()
        return out
    }

    // What a block or its breaking did that its level's to do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// then its leash, where it has one, and a chest boat's loot table or items,
    /// `addChestVehicleSaveData`.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, self.type_name())
        if let leash = self.leash {
            t.insert(String("leash"), leash.copy())
        }
        if self.has_chest() {
            // `addChestVehicleSaveData`: its loot table and seed where it has one, else its items,
            // each with its `Slot`, `ContainerHelper.saveAllItems`.
            if let table = self.loot_table {
                t.insert(String("LootTable"), Tag.Str(table.copy()))
                if self.loot_seed != 0 {
                    t.insert(String("LootTableSeed"), Tag.Long(self.loot_seed))
                }
            } else {
                t.insert(String("Items"), slotted(self.items))
            }
        }
        return Tag.Compound(t)
    }

    /// The boat `tag` saves, of the type `kind`, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes one and `Entity.load` and `readAdditionalSaveData` read it in.
    /// `none` where it's somewhere that isn't a number, logged in `lines`.
    pub fn loaded(id: i32, seed: i64, kind: own String, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Boat? {
        var b = Boat.made(id, seed, 0.0, 0.0, 0.0, kind)
        if not b.load_onto(tag, mut lines) {
            return none
        }
        return some(b)
    }

    /// `Entity.load` onto it as it is, as `data` changes an entity's data, and as `loaded` reads a
    /// fresh one: what every entity reads, its values from it, and its leash. False where it
    /// doesn't load, logged in `lines`.
    pub fn load_onto(mut self, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.data.set(AIR_SUPPLY, Value.Number(self.body.air))
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.leash = if tag.contains("leash") { some(tag["leash"].copy()) } else { none }
        if self.has_chest() {
            self.read_chest(tag)
        }
        return true
    }

    // `readChestVehicleSaveData`: its slots emptied, then its loot table and seed, and where it has
    // no table, its items by their `Slot`, `ContainerHelper.loadAllItems`.
    fn read_chest(mut self, tag: JavaHashMap<String, Tag>) {
        self.items = List<Tag?>()
        for _ in 0..27 {
            self.items.push(none)
        }
        self.loot_table = none
        if let Tag.Str(t) = tag.find("LootTable") {
            self.loot_table = some(t.copy())
        }
        self.loot_seed = 0
        if let Tag.Long(l) = tag.find("LootTableSeed") {
            self.loot_seed = l
        }
        if self.loot_table != none or not tag.contains("Items") {
            return
        }
        let Tag.List(list) = tag["Items"].copy() else return
        for t in list {
            let Tag.Compound(m) = t else continue
            let Tag.Byte(b) = m.find("Slot") else continue
            let slot = i32(u8.wrap(b))
            if slot < 0 or slot >= 27 {
                continue
            }
            var stack = m.copy()
            _ = stack.remove("Slot")
            self.items[usize.wrap(slot)] = some(Tag.Compound(stack))
        }
    }
}

// `ContainerHelper.saveAllItems`: each stack held with its `Slot`, in order.
fn slotted(slots: List<Tag?>) -> Tag {
    var list = List<Tag>()
    for i in 0..slots.len() {
        let stack = slots[i].copy() else continue
        let Tag.Compound(m) = stack else continue
        var with_slot = JavaHashMap<String, Tag>()
        with_slot.insert(String("Slot"), Tag.Byte(i8.wrap(i32.wrap(i))))
        for (k, v) in m {
            with_slot.insert(k.copy(), v.copy())
        }
        list.push(Tag.Compound(with_slot))
    }
    return Tag.List(list)
}
