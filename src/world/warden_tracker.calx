/// A player's `WardenSpawnTracker` (CAL-275): how near the shriekers they set off are to calling a
/// warden. It's saved as `warden_spawn_tracker`, ticked with the player, and kept when they respawn.
module world.warden_tracker

import nbt.tag.{Tag}

/// The most a warning level gets, `MAX_WARNING_LEVEL`; the ticks after a warning before the
/// level goes down by one; and the ticks after a warning before another can raise it.
pub const MOST_WARNINGS: i32 = 4
pub const WARNING_FADES: i32 = 12000
pub const WARNING_COOLDOWN: i32 = 200

/// `WardenSpawnTracker`: the ticks since the last warning, the warning level, and the ticks left
/// before another warning can raise it.
pub struct WardenTracker {
    pub since_warning: i32 = 0
    pub level: i32 = 0
    pub cooldown: i32 = 0
}

impl WardenTracker {
    /// The tracker saved as `tag`, as `WardenSpawnTracker.CODEC` reads it: each field 0 where it's
    /// missing, and all of it new where one's negative or not a number.
    pub fn from_tag(tag: Tag?) -> WardenTracker {
        let saved = tag else return WardenTracker {}
        let Tag.Compound(m) = saved else return WardenTracker {}
        var fields = List<i32>()
        for key in ["ticks_since_last_warning", "warning_level", "cooldown_ticks"] {
            if not m.contains(key) {
                fields.push(0)
                continue
            }
            let n = m[key].number_int() else return WardenTracker {}
            if n < 0 {
                return WardenTracker {}
            }
            fields.push(n)
        }
        return WardenTracker { since_warning: fields[0], level: fields[1], cooldown: fields[2] }
    }

    /// The tracker as `WardenSpawnTracker.CODEC` saves it, each field always there.
    pub fn to_tag(self) -> Tag {
        var m = JavaHashMap<String, Tag>()
        m.insert(String("ticks_since_last_warning"), Tag.Int(self.since_warning))
        m.insert(String("warning_level"), Tag.Int(self.level))
        m.insert(String("cooldown_ticks"), Tag.Int(self.cooldown))
        return Tag.Compound(m)
    }

    /// `tick`: the level down one each `WARNING_FADES` ticks without a warning, and the cooldown
    /// counted down.
    pub fn tick(mut self) {
        if self.since_warning >= WARNING_FADES {
            self.level = clamp_level(self.level - 1)
            self.since_warning = 0
        } else {
            self.since_warning += 1
        }
        if self.cooldown > 0 {
            self.cooldown -= 1
        }
    }

    /// `onCooldown`.
    pub fn on_cooldown(self) -> bool {
        return self.cooldown > 0
    }

    /// `increaseWarningLevel`: off cooldown, the level up one, the cooldown started again and the
    /// ticks since a warning back to 0.
    pub fn increase(mut self) {
        if self.on_cooldown() {
            return
        }
        self.since_warning = 0
        self.cooldown = WARNING_COOLDOWN
        self.level = clamp_level(self.level + 1)
    }
}

// `setWarningLevel`'s clamp to 0 through `MOST_WARNINGS`.
fn clamp_level(n: i32) -> i32 {
    if n < 0 {
        return 0
    }
    return if n > MOST_WARNINGS { MOST_WARNINGS } else { n }
}

/// `WardenSpawnTracker.tryWarn` over the trackers of the players it reaches, `trackers`, the
/// one who set it off among them: none where any is on cooldown; else the highest level's tracker
/// raised and copied to all of them, and its level.
pub fn try_warn(trackers: mut List<WardenTracker>) -> i32? {
    if trackers.is_empty() {
        return none
    }
    for t in trackers {
        if t.on_cooldown() {
            return none
        }
    }
    var highest = 0usize
    for k in 1..trackers.len() {
        if trackers[k].level > trackers[highest].level {
            highest = k
        }
    }
    var raised = trackers[highest]
    raised.increase()
    for k in 0..trackers.len() {
        trackers[k] = raised
    }
    return some(raised.level)
}
