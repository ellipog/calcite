/// What made a game event, `GameEvent.Context.sourceEntity`, kept apart from `world.vibrations`
/// so entities' bodies can name it (CAL-275).
module world.event_source

/// What made a game event, its `GameEvent.Context.sourceEntity`, as listeners ask about it: its
/// ID and UUID, a projectile's owner's UUID, whether it's a spectator or a player, whether it's
/// stepping carefully, `isSteppingCarefully`, and whether it dampens vibrations,
/// `dampensVibrations`. None made it where its ID is -1.
pub struct EventSource {
    pub id: i32 = -1
    pub uuid: (i64, i64)? = none
    pub owner: (i64, i64)? = none
    pub spectator: bool = false
    pub player: bool = false
    pub careful: bool = false
    pub dampens: bool = false
}
