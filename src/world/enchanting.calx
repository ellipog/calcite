/// Enchanting as vanilla's `EnchantmentHelper` does it ([CAL-163], D522): what each enchantment
/// is to enchanting, its `EnchantmentDefinition`, read from the `enchantment` registry, with its
/// weight, its levels and their costs, the items it goes on and is first for, and the
/// enchantments it can't be with; the enchantments a cost picks for an item, `selectEnchantment`;
/// one picked at random from those that go on it, as `EnchantRandomlyFunction` picks it, at a
/// level drawn for it; and an item's enchantments raised to a level, `ItemEnchantments.upgrade`.
///
/// [CAL-163]: https://acta.aaenz.no/aaen-studios/calcite#CAL-163
module world.enchanting

import nbt.tag.{Accounter, Tag, read_any}
import random.source.{RandomSource}
import registry.registries.{Registries}
import resources.identifier.{Identifier}

/// What enchanting asks of an enchantment, its `EnchantmentDefinition`: its name, as
/// `minecraft:sharpness`; its weight; its most level, its least being 1; its least and most cost
/// at its first level and each level above it, `Cost`; the items it goes on, `supported_items`,
/// and is first for, `primary_items`, by their names, none meaning all it goes on; and the
/// enchantments it can't be with, `exclusive_set`, by their IDs.
pub struct Definition {
    pub name: String
    pub weight: i32 = 1
    pub max_level: i32 = 1
    pub min_base: i32 = 0
    pub min_per: i32 = 0
    pub max_base: i32 = 0
    pub max_per: i32 = 0
    pub supported: List<String> = List<String>()
    pub primary: List<String>? = none
    pub exclusive: List<i32> = List<i32>()
}

impl Definition {
    /// `getMinCost`, `Cost.calculate`: its least cost at `level`.
    pub fn min_cost(self, level: i32) -> i32 {
        return self.min_base + self.min_per * (level - 1)
    }

    /// `getMaxCost`: its most cost at `level`.
    pub fn max_cost(self, level: i32) -> i32 {
        return self.max_base + self.max_per * (level - 1)
    }

    /// `canEnchant` and `isSupportedItem`: whether it goes on the item `item`, by its name.
    pub fn supports(self, item: String) -> bool {
        return named_in(self.supported, item)
    }

    /// `isPrimaryItem`: whether it goes on the item `item` and is first for it.
    pub fn primary_for(self, item: String) -> bool {
        if not self.supports(item.copy()) {
            return false
        }
        let first = self.primary else return true
        return named_in(first, item)
    }
}

/// The world's enchantments as enchanting sees them, each `Definition` by its ID in the
/// `enchantment` registry, with that registry's names and tags, which an enchantment's set is
/// read by.
pub struct Enchanting {
    pub defs: List<Definition> = List<Definition>()
    names: List<String> = List<String>()
    tags: List<(String, List<i32>)> = List<(String, List<i32>)>()
}

/// The enchantments of `registries`' `enchantment` registry, as its entries' contents give them,
/// with the item tags their items are named by; none where there's no such registry.
pub fn enchanting_of(registries: Registries) -> Enchanting {
    var out = Enchanting()
    let place = registries.find(String("minecraft:enchantment")) else return out
    let items = registries.find_builtin(String("item"))
    for tag in registries.synced[place].tags {
        out.tags.push((tag.name.to_string(), tag.values.copy()))
    }
    for i in 0..registries.synced[place].entries.len() {
        out.names.push(registries.synced[place].entries[i].to_string())
    }
    for i in 0..registries.synced[place].entries.len() {
        var def = Definition { name: registries.synced[place].entries[i].to_string() }
        if i < registries.synced[place].contents.len() {
            var at: usize = 0
            var accounter = Accounter.unlimited()
            let read = match read_any(registries.synced[place].contents[i], mut at, mut accounter) {
                ok(t) => t,
                err(_) => Tag.End,
            }
            if let Tag.Compound(m) = read {
                def.weight = int_of(m, "weight", 1)
                def.max_level = int_of(m, "max_level", 1)
                if m.contains("min_cost") {
                    if let Tag.Compound(c) = m["min_cost"].copy() {
                        def.min_base = int_of(c, "base", 0)
                        def.min_per = int_of(c, "per_level_above_first", 0)
                    }
                }
                if m.contains("max_cost") {
                    if let Tag.Compound(c) = m["max_cost"].copy() {
                        def.max_base = int_of(c, "base", 0)
                        def.max_per = int_of(c, "per_level_above_first", 0)
                    }
                }
                if m.contains("supported_items") {
                    def.supported = item_names(registries, items, m["supported_items"])
                }
                if m.contains("primary_items") {
                    def.primary = some(item_names(registries, items, m["primary_items"]))
                }
                if m.contains("exclusive_set") {
                    def.exclusive = out.set_ids(m["exclusive_set"])
                }
            }
        }
        out.defs.push(def)
    }
    return out
}

impl Enchanting {
    /// Every enchantment's ID, in the registry's order, as `listElements` streams them.
    pub fn all(self) -> List<i32> {
        var out = List<i32>()
        for i in 0..self.defs.len() {
            out.push(i32.wrap(i))
        }
        return out
    }

    /// The IDs of the enchantments in `set`, a `HolderSet` as its codec writes it, in its order:
    /// an ID, a list of them, or a tag, `#` and its name; one that isn't there left out.
    pub fn set_ids(self, set: Tag) -> List<i32> {
        var out = List<i32>()
        match set {
            Tag.Str(s) => {
                if s.starts_with("#") {
                    let name = whole(s[1..].copy())
                    for (tag, values) in self.tags {
                        if tag == name {
                            return values.copy()
                        }
                    }
                    return out
                }
                let name = whole(s.copy())
                for i in 0..self.names.len() {
                    if self.names[i] == name {
                        out.push(i32.wrap(i))
                    }
                }
            },
            Tag.List(each) => {
                for one in each {
                    for id in self.set_ids(one) {
                        out.push(id)
                    }
                }
            },
            _ => {},
        }
        return out
    }

    /// `selectEnchantment` (D522): the enchantments the cost `cost` picks for the item `item`, by
    /// their IDs and levels, from those of `source`, in its order, with the item's `enchantable`
    /// value, none where it has none. The cost's raised by two draws of up to a quarter of that
    /// value and 1, then spread by up to 15% either way, `randomSpan`, rounded, at least 1; the
    /// enchantments of `source` the item's first for, or all for a book, each at its highest level
    /// whose costs hold it, `getAvailableEnchantmentResults`; one by weight, then while a draw of
    /// 50 is no more than the cost, the rest that can be with the last cut down to, another by
    /// weight, the cost halved each time.
    pub fn select<R: RandomSource>(self, random: mut R, item: String, enchantable: i32?, cost: i32, source: List<i32>) -> List<(i32, i32)> {
        var picked = List<(i32, i32)>()
        let value = enchantable else return picked
        var c = cost + 1 + random.next_int_below(value / 4 + 1) + random.next_int_below(value / 4 + 1)
        let span = (random.next_float() + random.next_float() - 1.0f32) * 0.15f32
        let spread = f32.nearest(f64(c)) + f32.nearest(f64(c)) * span
        c = i32.saturate((f64(spread) + 0.5).floor()).max(1)
        var open = self.available(c, item, source)
        if open.is_empty() {
            return picked
        }
        if let first = self.weighted(mut random, open) {
            picked.push(first)
        }
        while random.next_int_below(50) <= c {
            if picked.len() > 0 {
                let (last, _) = picked[picked.len() - 1]
                var kept = List<(i32, i32)>()
                for (id, level) in open {
                    if self.compatible(last, id) {
                        kept.push((id, level))
                    }
                }
                open = kept
            }
            if open.is_empty() {
                break
            }
            if let next = self.weighted(mut random, open) {
                picked.push(next)
            }
            c /= 2
        }
        return picked
    }

    /// `EnchantRandomlyFunction`'s pick (D522): one of the enchantments of `source` the item `item`
    /// takes, `canEnchant`, or of all where `any`, by an even draw, at a level drawn from 1 to its
    /// most, `Mth.nextInt`; none where there's none to pick.
    pub fn pick_one<R: RandomSource>(self, random: mut R, item: String, any: bool, source: List<i32>) -> (i32, i32)? {
        var takes = List<i32>()
        for id in source {
            if any or self.defs[usize.wrap(id)].supports(item.copy()) {
                takes.push(id)
            }
        }
        if takes.is_empty() {
            return none
        }
        let id = takes[usize.wrap(random.next_int_below(i32.wrap(takes.len())))]
        let most = self.defs[usize.wrap(id)].max_level
        let level = if 1 >= most { 1 } else { random.next_int_below(most) + 1 }
        return some((id, level))
    }

    /// The name of the enchantment `id`, as `minecraft:sharpness`.
    pub fn name(self, id: i32) -> String {
        return self.defs[usize.wrap(id)].name.copy()
    }

    // `getAvailableEnchantmentResults`: each enchantment of `source` the item's first for, or
    // any for a book, at its highest level whose least and most costs hold `value`.
    fn available(self, value: i32, item: String, source: List<i32>) -> List<(i32, i32)> {
        let book = item == "minecraft:book"
        var out = List<(i32, i32)>()
        for id in source {
            let d = usize.wrap(id)
            if not book and not self.defs[d].primary_for(item.copy()) {
                continue
            }
            var level = self.defs[d].max_level
            while level >= 1 {
                if value >= self.defs[d].min_cost(level) and value <= self.defs[d].max_cost(level) {
                    out.push((id, level))
                    break
                }
                level -= 1
            }
        }
        return out
    }

    // `WeightedRandom.getRandomItem` by each one's weight: a draw below their sum, none where
    // that's 0, then the one it falls in.
    fn weighted<R: RandomSource>(self, random: mut R, from: List<(i32, i32)>) -> (i32, i32)? {
        var total = 0
        for (id, _) in from {
            total += self.defs[usize.wrap(id)].weight
        }
        if total <= 0 {
            return none
        }
        var index = random.next_int_below(total)
        for (id, level) in from {
            index -= self.defs[usize.wrap(id)].weight
            if index < 0 {
                return some((id, level))
            }
        }
        return none
    }

    // `Enchantment.areCompatible`: two that aren't the same, neither in the other's exclusive
    // set.
    fn compatible(self, a: i32, b: i32) -> bool {
        if a == b {
            return false
        }
        for e in self.defs[usize.wrap(a)].exclusive {
            if e == b {
                return false
            }
        }
        for e in self.defs[usize.wrap(b)].exclusive {
            if e == a {
                return false
            }
        }
        return true
    }
}

/// `ItemEnchantments.Mutable.upgrade` (D522): the enchantment `name` in `levels`, an
/// enchantments component as its codec writes it, raised to `level`, at most 255, where it's
/// higher than what it has; nothing for a level below 1.
pub fn upgrade(levels: mut JavaHashMap<String, Tag>, name: own String, level: i32) {
    if level <= 0 {
        return
    }
    let now = level.min(255)
    let had = if levels.contains(name.copy()) { levels[name.copy()].number_int() ?? 0 } else { 0 }
    levels.insert(name, Tag.Int(had.max(now)))
}

// Whether `names` has `name`.
fn named_in(names: List<String>, name: String) -> bool {
    for n in names {
        if n == name {
            return true
        }
    }
    return false
}

// The whole ID of `name`, `minecraft:` where it names no namespace.
fn whole(name: own String) -> String {
    if name.contains(":") {
        return name
    }
    return "minecraft:{name}"
}

// The int `key` of `m`, `fallback` where it has none.
fn int_of(m: JavaHashMap<String, Tag>, key: str, fallback: i32) -> i32 {
    if not m.contains(key) {
        return fallback
    }
    return m[key].number_int() ?? fallback
}

// The names of the items in `set`, an item `HolderSet` as its codec writes it, by the built-in
// `item` registry at `items`: an ID, a list of them, or a tag, `#` and its name.
fn item_names(registries: Registries, items: usize?, set: Tag) -> List<String> {
    var out = List<String>()
    match set {
        Tag.Str(s) => {
            if not s.starts_with("#") {
                out.push(whole(s.copy()))
                return out
            }
            let at = items else return out
            let tag = match Identifier.parse(s[1..].copy()) {
                ok(t) => t,
                err(_) => return out,
            }
            for id in registries.builtin[at].tag_ids(tag) {
                out.push(registries.builtin[at].entries[usize.wrap(id)].to_string())
            }
        },
        Tag.List(each) => {
            for one in each {
                for n in item_names(registries, items, one) {
                    out.push(n.copy())
                }
            }
        },
        _ => {},
    }
    return out
}
