/// The world's game rules as it saves them, vanilla's `GameRuleMap`, in
/// `data/minecraft/game_rules.dat` (CAL-170). The server asks `computeIfAbsent` for them as it
/// starts, and `GameRules` gives each rule the world's features enable that the map lacks its
/// default, and takes out each they don't, each marking it to be saved: so a new world saves every
/// rule at its first save, and one missing some saves them again. What the server reads of them is
/// in `Rules`; the `gamerule` command changes them as it does those (CAL-298).
module world.game_rule_map

import nbt.tag.{Tag}
import resources.identifier.{Identifier}

/// The saved data type they're saved as, `GameRuleMap.TYPE`.
pub fn game_rules_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "game_rules" }
}

/// Each game rule 26.3 registers, in the order it registers them: its name, whether it's a number
/// rather than true or false, its default, as `GameRules` registers it, and, for a number, the
/// range its codec, `Codec.intRange`, reads.
const RULES: [(str, bool, i32, i32, i32); 59] = [
    ("advance_time", false, 1, 0, 0),
    ("advance_weather", false, 1, 0, 0),
    ("allow_entering_nether_using_portals", false, 1, 0, 0),
    ("block_drops", false, 1, 0, 0),
    ("block_explosion_drop_decay", false, 1, 0, 0),
    ("command_blocks_work", false, 1, 0, 0),
    ("command_block_output", false, 1, 0, 0),
    ("drowning_damage", false, 1, 0, 0),
    ("elytra_movement_check", false, 1, 0, 0),
    ("ender_pearls_vanish_on_death", false, 1, 0, 0),
    ("entity_drops", false, 1, 0, 0),
    ("fall_damage", false, 1, 0, 0),
    ("fire_damage", false, 1, 0, 0),
    ("fire_spread_radius_around_player", true, 128, -1, 2147483647),
    ("forgive_dead_players", false, 1, 0, 0),
    ("freeze_damage", false, 1, 0, 0),
    ("global_sound_events", false, 1, 0, 0),
    ("immediate_respawn", false, 0, 0, 0),
    ("keep_inventory", false, 0, 0, 0),
    ("lava_source_conversion", false, 0, 0, 0),
    ("limited_crafting", false, 0, 0, 0),
    ("locator_bar", false, 1, 0, 0),
    ("log_admin_commands", false, 1, 0, 0),
    ("max_block_modifications", true, 32768, 1, 2147483647),
    ("max_command_forks", true, 65536, 0, 2147483647),
    ("max_command_sequence_length", true, 65536, 0, 2147483647),
    ("max_entity_cramming", true, 24, 0, 2147483647),
    ("max_minecart_speed", true, 8, 1, 1000),
    ("max_snow_accumulation_height", true, 1, 0, 8),
    ("mob_drops", false, 1, 0, 0),
    ("mob_explosion_drop_decay", false, 1, 0, 0),
    ("mob_griefing", false, 1, 0, 0),
    ("natural_health_regeneration", false, 1, 0, 0),
    ("player_movement_check", false, 1, 0, 0),
    ("players_nether_portal_creative_delay", true, 0, 0, 2147483647),
    ("players_nether_portal_default_delay", true, 80, 0, 2147483647),
    ("players_sleeping_percentage", true, 100, 0, 2147483647),
    ("projectiles_can_break_blocks", false, 1, 0, 0),
    ("pvp", false, 1, 0, 0),
    ("raids", false, 1, 0, 0),
    ("random_tick_speed", true, 3, 0, 2147483647),
    ("reduced_debug_info", false, 0, 0, 0),
    ("respawn_radius", true, 10, 0, 2147483647),
    ("send_command_feedback", false, 1, 0, 0),
    ("show_advancement_messages", false, 1, 0, 0),
    ("show_death_messages", false, 1, 0, 0),
    ("spawner_blocks_work", false, 1, 0, 0),
    ("spawn_mobs", false, 1, 0, 0),
    ("spawn_monsters", false, 1, 0, 0),
    ("spawn_patrols", false, 1, 0, 0),
    ("spawn_phantoms", false, 1, 0, 0),
    ("spawn_wandering_traders", false, 1, 0, 0),
    ("spawn_wardens", false, 1, 0, 0),
    ("spectators_generate_chunks", false, 1, 0, 0),
    ("spread_vines", false, 1, 0, 0),
    ("tnt_explodes", false, 1, 0, 0),
    ("tnt_explosion_drop_decay", false, 0, 0, 0),
    ("universal_anger", false, 0, 0, 0),
    ("water_source_conversion", false, 1, 0, 0),
]

/// The one rule only a feature that isn't on by default enables, `minecart_improvements`.
const MINECART_RULE: str = "max_minecart_speed"

/// The rules the world saves, by their IDs, and whether they've changed since they were saved.
pub struct GameRuleMap {
    values: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    pub dirty: bool = false
}

impl GameRuleMap {
    /// Each rule the world's features enable at its default, as a world without the file, or
    /// with one that can't be read, has them: marked to be saved. `minecarts` is whether
    /// `minecart_improvements` is on.
    pub fn fresh(minecarts: bool) -> GameRuleMap {
        var out = GameRuleMap()
        out.fill(minecarts)
        out.dirty = true
        return out
    }

    /// The rules of the file's `data`, each as its codec reads it, where it does: a rule the
    /// registry doesn't have, or whose value its codec doesn't read, is left out, as the
    /// dispatched map's partial result leaves it. Then, as `GameRules` makes them, each rule the
    /// world's features enable that's missing gets its default, and each they don't goes, either
    /// marking them to be saved.
    pub fn load(data: JavaHashMap<String, Tag>, minecarts: bool) -> GameRuleMap {
        var out = GameRuleMap()
        for (name, is_int, _, min, max) in RULES {
            let id = "minecraft:{name}"
            if not data.contains(id) {
                continue
            }
            if is_int {
                if let n = data[id].number_int() {
                    if n >= min and n <= max {
                        out.values.insert(id, Tag.Int(n))
                    }
                }
            } else if let b = data[id].number_bool() {
                out.values.insert(id, Tag.Byte(if b { 1i8 } else { 0i8 }))
            }
        }
        out.fill(minecarts)
        return out
    }

    // `GameRules`' constructor: each rule enabled and missing reset to its default, each not
    // enabled and there taken out, each marking the map.
    fn fill(mut self, minecarts: bool) {
        for (name, is_int, value, _, _) in RULES {
            let id = "minecraft:{name}"
            let enabled = name != MINECART_RULE or minecarts
            if enabled and not self.values.contains(id) {
                self.values.insert(id, if is_int { Tag.Int(value) } else { Tag.Byte(i8.wrap(value)) })
                self.dirty = true
            } else if not enabled and self.values.contains(id) {
                _ = self.values.remove(id)
                self.dirty = true
            }
        }
    }

    /// The rule `name`, without its namespace, as a flag: on where its value isn't 0, its default
    /// where the map hasn't it (CAL-286).
    pub fn flag(self, name: str) -> bool {
        let id = "minecraft:{name}"
        if self.values.contains(id) {
            return (self.values[id].number_int() ?? 0) != 0
        }
        for (rule, _, value, _, _) in RULES {
            if rule == name {
                return value != 0
            }
        }
        return false
    }

    /// The rule `name`'s value, without its namespace, true as 1 and false as 0: its default where
    /// the map hasn't it, none where it's no rule (CAL-298).
    pub fn value_of(self, name: String) -> i32? {
        let id = "minecraft:{name}"
        if self.values.contains(id) {
            return self.values[id].number_int()
        }
        for (rule, _, value, _, _) in RULES {
            if rule == name {
                return some(value)
            }
        }
        return none
    }

    /// The rule `name` set to `value`, true as 1 and false as 0, as its codec saves it, marking the
    /// map to be saved (CAL-298).
    pub fn set(mut self, name: String, value: i32) {
        let id = "minecraft:{name}"
        let number = rule_is_number(name.copy()) ?? false
        self.values.insert(id, if number { Tag.Int(value) } else { Tag.Byte(if value != 0 { 1i8 } else { 0i8 }) })
        self.dirty = true
    }

    /// Their `data`, as the codec writes it: each rule by its ID.
    pub fn pack(self) -> Tag {
        return Tag.Compound(self.values.copy())
    }
}

/// Whether the rule `name`, without its namespace, is a number, `IntegerGameRule`, rather than
/// true or false; none where it's no rule (CAL-298).
pub fn rule_is_number(name: String) -> bool? {
    for (rule, number, _, _, _) in RULES {
        if rule == name {
            return some(number)
        }
    }
    return none
}
