/// Vanilla's `BlockGetter.clip` for what `Entity.move` asks of it, whether a fast fall passes
/// through what resets it (D422): the blocks along a line in `traverseBlocks`' order, each one
/// whole where `ClipContext.Block.FALLDAMAGE_RESETTING` has it so, and its water up to its height,
/// `ClipContext.Fluid.WATER`; met where the line starts inside a shape, `VoxelShape.clip`, or
/// crosses a face of it, `AABB.clip`. Only whether the line meets one matters, not where, so the
/// nearer of a block and its water isn't sought. Vanilla keeps the shape of each fluid state at
/// the height it had where it was first asked for, `FlowingFluid.shapes`; Calcite asks the height
/// at each place, which differs only for water with water over it that a line meets before the
/// water over it.
module world.clip

import world.collision.{CollisionBlocks}
import world.currents.{height}
import world.flowing.{liquid_of}
import worldgen.facts.{BlockSet, Facts}

/// What a fall's clip finds whole: the blocks in `minecraft:fall_damage_resetting`, and, for a
/// player, end portals and gateways, and nether portals where the game rule
/// `players_nether_portal_default_delay` is 0.
pub struct ResetFacts {
    pub resetting: BlockSet
    pub end_portal: u32
    pub end_gateway: u32
    pub nether_portal: u32
}

impl ResetFacts {
    /// As `f` has them, the tag as its level loaded it.
    pub fn new(f: Facts) -> ResetFacts {
        return ResetFacts {
            resetting: f.tag_or_empty(String("minecraft:fall_damage_resetting")),
            end_portal: f.block_named(String("minecraft:end_portal")) ?? u32.MAX,
            end_gateway: f.block_named(String("minecraft:end_gateway")) ?? u32.MAX,
            nether_portal: f.block_named(String("minecraft:nether_portal")) ?? u32.MAX,
        }
    }
}

/// Whether the line from `from` to `to` meets what resets a fall, `level.clip` with
/// `FALLDAMAGE_RESETTING` and `WATER` not missing: by a `player`, and one for whom a nether portal
/// is whole, `portal`. A block whose chunk isn't there meets nothing.
pub fn resets_fall<B: CollisionBlocks>(f: Facts, r: ResetFacts, blocks: B, player: bool, portal: bool, from: (f64, f64, f64), to: (f64, f64, f64)) -> bool {
    if from == to {
        return false
    }
    let (ax, ay, az) = from
    let (bx, by, bz) = to
    let to_x = lerp(-1.0e-7, bx, ax)
    let to_y = lerp(-1.0e-7, by, ay)
    let to_z = lerp(-1.0e-7, bz, az)
    let from_x = lerp(-1.0e-7, ax, bx)
    let from_y = lerp(-1.0e-7, ay, by)
    let from_z = lerp(-1.0e-7, az, bz)
    var x = i32.saturate(from_x.floor())
    var y = i32.saturate(from_y.floor())
    var z = i32.saturate(from_z.floor())
    if meets(f, r, blocks, player, portal, from, to, x, y, z) {
        return true
    }
    let dx = to_x - from_x
    let dy = to_y - from_y
    let dz = to_z - from_z
    let sx = sign(dx)
    let sy = sign(dy)
    let sz = sign(dz)
    let step_x = if sx == 0 { f64.MAX } else { f64(sx) / dx }
    let step_y = if sy == 0 { f64.MAX } else { f64(sy) / dy }
    let step_z = if sz == 0 { f64.MAX } else { f64(sz) / dz }
    var tx = step_x * (if sx > 0 { 1.0 - frac(from_x) } else { frac(from_x) })
    var ty = step_y * (if sy > 0 { 1.0 - frac(from_y) } else { frac(from_y) })
    var tz = step_z * (if sz > 0 { 1.0 - frac(from_z) } else { frac(from_z) })
    while tx <= 1.0 or ty <= 1.0 or tz <= 1.0 {
        if tx < ty {
            if tx < tz {
                x += sx
                tx = tx + step_x
            } else {
                z += sz
                tz = tz + step_z
            }
        } else if ty < tz {
            y += sy
            ty = ty + step_y
        } else {
            z += sz
            tz = tz + step_z
        }
        if meets(f, r, blocks, player, portal, from, to, x, y, z) {
            return true
        }
    }
    return false
}

// `BlockGetter.clip`'s look at the block at x, y, z: its shape for the clip, whole or none, then
// its water's, a box up to its height, `FluidState.getShape`, each met as `VoxelShape.clip` meets
// it.
fn meets<B: CollisionBlocks>(f: Facts, r: ResetFacts, blocks: B, player: bool, portal: bool, from: (f64, f64, f64), to: (f64, f64, f64), x: i32, y: i32, z: i32) -> bool {
    let state = blocks.collision_state(x, y, z) else return false
    let block = f.block(state)
    let whole = f.in_set(state, r.resetting) or (player and (block == r.end_portal or block == r.end_gateway)) or (portal and block == r.nether_portal)
    if whole and box_meets(from, to, x, y, z, 1.0) {
        return true
    }
    if not f.is_water(state) {
        return false
    }
    let top = height(f, blocks, liquid_of(f, state), x, y, z)
    return box_meets(from, to, x, y, z, f64(top))
}

// `VoxelShape.clip` of the box from the block at x, y, z's corner up to `top`, a whole block
// across: none for a line under 1e-7 long squared; met where a thousandth along the line is
// inside it, `isFullWide`; else where the line crosses one of its faces, `AABB.clip`.
fn box_meets(from: (f64, f64, f64), to: (f64, f64, f64), x: i32, y: i32, z: i32, top: f64) -> bool {
    let (ax, ay, az) = from
    let (bx, by, bz) = to
    let dx = bx - ax
    let dy = by - ay
    let dz = bz - az
    if dx * dx + dy * dy + dz * dz < 1.0e-7 {
        return false
    }
    let px = ax + dx * 0.001 - f64(x)
    let py = ay + dy * 0.001 - f64(y)
    let pz = az + dz * 0.001 - f64(z)
    if px >= 0.0 and px < 1.0 and py >= 0.0 and py < top and pz >= 0.0 and pz < 1.0 {
        return true
    }
    let min_x = 0.0 + f64(x)
    let min_y = 0.0 + f64(y)
    let min_z = 0.0 + f64(z)
    let max_x = 1.0 + f64(x)
    let max_y = top + f64(y)
    let max_z = 1.0 + f64(z)
    if dx > 1.0e-7 {
        if crosses(dx, dy, dz, min_x, min_y, max_y, min_z, max_z, ax, ay, az) {
            return true
        }
    } else if dx < -1.0e-7 {
        if crosses(dx, dy, dz, max_x, min_y, max_y, min_z, max_z, ax, ay, az) {
            return true
        }
    }
    if dy > 1.0e-7 {
        if crosses(dy, dz, dx, min_y, min_z, max_z, min_x, max_x, ay, az, ax) {
            return true
        }
    } else if dy < -1.0e-7 {
        if crosses(dy, dz, dx, max_y, min_z, max_z, min_x, max_x, ay, az, ax) {
            return true
        }
    }
    if dz > 1.0e-7 {
        return crosses(dz, dx, dy, min_z, min_x, max_x, min_y, max_y, az, ax, ay)
    }
    if dz < -1.0e-7 {
        return crosses(dz, dx, dy, max_z, min_x, max_x, min_y, max_y, az, ax, ay)
    }
    return false
}

// `AABB.clipPoint`: whether the line crosses the face at `point` along its first axis, within
// the face's bounds on the other two less and more 1e-7, between its start and end. A face
// crossed further than another still counts, as only whether one is matters.
fn crosses(da: f64, db: f64, dc: f64, point: f64, min_b: f64, max_b: f64, min_c: f64, max_c: f64, from_a: f64, from_b: f64, from_c: f64) -> bool {
    let s = (point - from_a) / da
    let pb = from_b + s * db
    let pc = from_c + s * dc
    return 0.0 < s and s < 1.0 and min_b - 1.0e-7 < pb and pb < max_b + 1.0e-7 and min_c - 1.0e-7 < pc and pc < max_c + 1.0e-7
}

// `Mth.lerp`.
fn lerp(delta: f64, a: f64, b: f64) -> f64 {
    return a + delta * (b - a)
}

// `Mth.sign`: 0, 1 or -1.
fn sign(v: f64) -> i32 {
    if v == 0.0 {
        return 0
    }
    return if v > 0.0 { 1 } else { -1 }
}

// `Mth.frac`: what's above the floor.
fn frac(v: f64) -> f64 {
    return v - v.floor()
}
