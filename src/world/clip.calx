/// Vanilla's `BlockGetter.clip` for what `Entity.move` asks of it, whether a fast fall passes
/// through what resets it (D422): the blocks along a line in `traverseBlocks`' order, each one
/// whole where `ClipContext.Block.FALLDAMAGE_RESETTING` has it so, and its water up to its height,
/// `ClipContext.Fluid.WATER`; met where the line starts inside a shape, `VoxelShape.clip`, or
/// crosses a face of it, `AABB.clip`. Only whether the line meets one matters, not where, so the
/// nearer of a block and its water isn't sought. Vanilla keeps the shape of each fluid state at
/// the height it had where it was first asked for, `FlowingFluid.shapes`; Calcite asks the height
/// at each place, which differs only for water with water over it that a line meets before the
/// water over it.
///
/// And `clip` with `ClipContext.Block.COLLIDER` and `Fluid.NONE`, as a projectile asks it
/// (CAL-159), `clip_collider`: where along the line it first meets a block's collision shape, and
/// through which face.
module world.clip

import world.collision.{Aabb, CollisionBlocks}
import world.currents.{height}
import world.flowing.{liquid_of}
import world.movement.{Mover, MovementStates}
import worldgen.facts.{BlockSet, DOWN, EAST, Facts, NORTH, SOUTH, UP, WEST}

/// Where a line meets a block, `BlockHitResult`: where, the face it went in through, by
/// `Direction`'s ID, and the block's place; or a miss, `missed`, at the line's end, facing back
/// along it, at the block there.
pub struct BlockHit {
    pub x: f64
    pub y: f64
    pub z: f64
    pub face: i32
    pub bx: i32
    pub by: i32
    pub bz: i32
    pub missed: bool
}

/// `BlockGetter.clip` with `ClipContext.Block.COLLIDER` and `Fluid.NONE` (CAL-159): the blocks
/// along the line from `from` to `to`, in `traverseBlocks`' order, each one's collision shape as
/// `mover` sees it, `getCollisionShape(level, pos, context)`; the first whose shape the line
/// meets, as `VoxelShape.clip` meets it, `shape_clip`, is the hit; with none, a miss at `to`,
/// `BlockHitResult.miss`, facing the way back, `Direction.getApproximateNearest`. A block whose
/// chunk isn't there has no shape. The interaction shape, which only turns the face of a hit where
/// it's met nearer, `clipWithInteractionOverride`, isn't read, nor the world border,
/// `clipIncludingBorder`.
pub fn clip_collider<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, mover: Mover, from: (f64, f64, f64), to: (f64, f64, f64)) -> BlockHit {
    let (ax, ay, az) = from
    let (bx, by, bz) = to
    if from == to {
        return missed_at(from, to)
    }
    let to_x = lerp(-1.0e-7, bx, ax)
    let to_y = lerp(-1.0e-7, by, ay)
    let to_z = lerp(-1.0e-7, bz, az)
    let from_x = lerp(-1.0e-7, ax, bx)
    let from_y = lerp(-1.0e-7, ay, by)
    let from_z = lerp(-1.0e-7, az, bz)
    var x = i32.saturate(from_x.floor())
    var y = i32.saturate(from_y.floor())
    var z = i32.saturate(from_z.floor())
    if let hit = block_clip(f, m, blocks, mover, from, to, x, y, z) {
        return hit
    }
    let dx = to_x - from_x
    let dy = to_y - from_y
    let dz = to_z - from_z
    let sx = sign(dx)
    let sy = sign(dy)
    let sz = sign(dz)
    let step_x = if sx == 0 { f64.MAX } else { f64(sx) / dx }
    let step_y = if sy == 0 { f64.MAX } else { f64(sy) / dy }
    let step_z = if sz == 0 { f64.MAX } else { f64(sz) / dz }
    var tx = step_x * (if sx > 0 { 1.0 - frac(from_x) } else { frac(from_x) })
    var ty = step_y * (if sy > 0 { 1.0 - frac(from_y) } else { frac(from_y) })
    var tz = step_z * (if sz > 0 { 1.0 - frac(from_z) } else { frac(from_z) })
    while tx <= 1.0 or ty <= 1.0 or tz <= 1.0 {
        if tx < ty {
            if tx < tz {
                x += sx
                tx = tx + step_x
            } else {
                z += sz
                tz = tz + step_z
            }
        } else if ty < tz {
            y += sy
            ty = ty + step_y
        } else {
            z += sz
            tz = tz + step_z
        }
        if let hit = block_clip(f, m, blocks, mover, from, to, x, y, z) {
            return hit
        }
    }
    return missed_at(from, to)
}

// The miss at the end of the line from `from` to `to`, `BlockHitResult.miss`: facing back along
// it, at the block `to` is in, `BlockPos.containing`.
fn missed_at(from: (f64, f64, f64), to: (f64, f64, f64)) -> BlockHit {
    let (ax, ay, az) = from
    let (bx, by, bz) = to
    let face = nearest_direction(ax - bx, ay - by, az - bz)
    return BlockHit { x: bx, y: by, z: bz, face: face, bx: i32.saturate(bx.floor()), by: i32.saturate(by.floor()), bz: i32.saturate(bz.floor()), missed: true }
}

// The clip's look at the block at x, y, z: its collision shape for `mover`, met by the line as
// `shape_clip` meets it.
fn block_clip<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, mover: Mover, from: (f64, f64, f64), to: (f64, f64, f64), x: i32, y: i32, z: i32) -> BlockHit? {
    let state = blocks.collision_state(x, y, z) else return none
    let boxes = m.state_boxes(f, state, x, y, z, mover)
    return shape_clip(boxes, from, to, x, y, z)
}

/// `VoxelShape.clip` of the shape of `boxes`, from the least corner of the block at x, y, z, by
/// the line from `from` to `to`: none for no shape or a line under 1e-7 long squared; where a
/// thousandth along the line is inside it, `isFullWide`, there, facing back the way the line goes;
/// else the nearest crossing of a face of its boxes, moved to the block, in their order, each's
/// faces that face the line, x's, y's then z's, `AABB.clip`; none where it crosses none.
pub fn shape_clip(boxes: List<Aabb>, from: (f64, f64, f64), to: (f64, f64, f64), x: i32, y: i32, z: i32) -> BlockHit? {
    if boxes.is_empty() {
        return none
    }
    let (ax, ay, az) = from
    let (bx, by, bz) = to
    let dx = bx - ax
    let dy = by - ay
    let dz = bz - az
    if dx * dx + dy * dy + dz * dz < 1.0e-7 {
        return none
    }
    let tx = ax + dx * 0.001
    let ty = ay + dy * 0.001
    let tz = az + dz * 0.001
    let (px, py, pz) = (tx - f64(x), ty - f64(y), tz - f64(z))
    for b in boxes {
        if px >= b.min_x and px < b.max_x and py >= b.min_y and py < b.max_y and pz >= b.min_z and pz < b.max_z {
            let face = opposite_direction(nearest_direction(dx, dy, dz))
            return some(BlockHit { x: tx, y: ty, z: tz, face: face, bx: x, by: y, bz: z, missed: false })
        }
    }
    var scale = 1.0
    var face: i32? = none
    for part in boxes {
        let b = Aabb { min_x: part.min_x + f64(x), min_y: part.min_y + f64(y), min_z: part.min_z + f64(z), max_x: part.max_x + f64(x), max_y: part.max_y + f64(y), max_z: part.max_z + f64(z) }
        if dx > 1.0e-7 {
            if let s = clip_point(scale, dx, dy, dz, b.min_x, b.min_y, b.max_y, b.min_z, b.max_z, ax, ay, az) {
                scale = s
                face = some(WEST)
            }
        } else if dx < -1.0e-7 {
            if let s = clip_point(scale, dx, dy, dz, b.max_x, b.min_y, b.max_y, b.min_z, b.max_z, ax, ay, az) {
                scale = s
                face = some(EAST)
            }
        }
        if dy > 1.0e-7 {
            if let s = clip_point(scale, dy, dz, dx, b.min_y, b.min_z, b.max_z, b.min_x, b.max_x, ay, az, ax) {
                scale = s
                face = some(DOWN)
            }
        } else if dy < -1.0e-7 {
            if let s = clip_point(scale, dy, dz, dx, b.max_y, b.min_z, b.max_z, b.min_x, b.max_x, ay, az, ax) {
                scale = s
                face = some(UP)
            }
        }
        if dz > 1.0e-7 {
            if let s = clip_point(scale, dz, dx, dy, b.min_z, b.min_x, b.max_x, b.min_y, b.max_y, az, ax, ay) {
                scale = s
                face = some(NORTH)
            }
        } else if dz < -1.0e-7 {
            if let s = clip_point(scale, dz, dx, dy, b.max_z, b.min_x, b.max_x, b.min_y, b.max_y, az, ax, ay) {
                scale = s
                face = some(SOUTH)
            }
        }
    }
    let side = face else return none
    return some(BlockHit { x: ax + scale * dx, y: ay + scale * dy, z: az + scale * dz, face: side, bx: x, by: y, bz: z, missed: false })
}

// `AABB.clipPoint`: how far along the line it crosses the face at `point` of its first axis, where
// that's past its start, nearer than `scale`, and within the face's bounds but for 1e-7.
fn clip_point(scale: f64, da: f64, db: f64, dc: f64, point: f64, min_b: f64, max_b: f64, min_c: f64, max_c: f64, from_a: f64, from_b: f64, from_c: f64) -> f64? {
    let s = (point - from_a) / da
    let pb = from_b + s * db
    let pc = from_c + s * dc
    if 0.0 < s and s < scale and min_b - 1.0e-7 < pb and pb < max_b + 1.0e-7 and min_c - 1.0e-7 < pc and pc < max_c + 1.0e-7 {
        return some(s)
    }
    return none
}

/// `Direction.getApproximateNearest`, its arguments made floats: the direction whose normal the
/// way's most along, of `Direction.values()`' order, the first where they tie; north for none.
pub fn nearest_direction(dx: f64, dy: f64, dz: f64) -> i32 {
    let (x, y, z) = (f32.nearest(dx), f32.nearest(dy), f32.nearest(dz))
    let dots: List<f32> = [-y, y, -z, z, -x, x]
    var best = NORTH
    // `Float.MIN_VALUE`, the least float above 0.
    var highest = f32.from_bits(1u32)
    for d in 0..6 {
        if dots[usize.wrap(d)] > highest {
            highest = dots[usize.wrap(d)]
            best = d
        }
    }
    return best
}

// `Direction.getOpposite`.
fn opposite_direction(d: i32) -> i32 {
    return d ^ 1
}

/// What a fall's clip finds whole: the blocks in `minecraft:fall_damage_resetting`, and, for a
/// player, end portals and gateways, and nether portals where the game rule
/// `players_nether_portal_default_delay` is 0.
pub struct ResetFacts {
    pub resetting: BlockSet
    pub end_portal: u32
    pub end_gateway: u32
    pub nether_portal: u32
}

impl ResetFacts {
    /// As `f` has them, the tag as its level loaded it.
    pub fn new(f: Facts) -> ResetFacts {
        return ResetFacts {
            resetting: f.tag_or_empty(String("minecraft:fall_damage_resetting")),
            end_portal: f.block_named(String("minecraft:end_portal")) ?? u32.MAX,
            end_gateway: f.block_named(String("minecraft:end_gateway")) ?? u32.MAX,
            nether_portal: f.block_named(String("minecraft:nether_portal")) ?? u32.MAX,
        }
    }
}

/// Whether the line from `from` to `to` meets what resets a fall, `level.clip` with
/// `FALLDAMAGE_RESETTING` and `WATER` not missing: by a `player`, and one for whom a nether portal
/// is whole, `portal`. A block whose chunk isn't there meets nothing.
pub fn resets_fall<B: CollisionBlocks>(f: Facts, r: ResetFacts, blocks: B, player: bool, portal: bool, from: (f64, f64, f64), to: (f64, f64, f64)) -> bool {
    if from == to {
        return false
    }
    let (ax, ay, az) = from
    let (bx, by, bz) = to
    let to_x = lerp(-1.0e-7, bx, ax)
    let to_y = lerp(-1.0e-7, by, ay)
    let to_z = lerp(-1.0e-7, bz, az)
    let from_x = lerp(-1.0e-7, ax, bx)
    let from_y = lerp(-1.0e-7, ay, by)
    let from_z = lerp(-1.0e-7, az, bz)
    var x = i32.saturate(from_x.floor())
    var y = i32.saturate(from_y.floor())
    var z = i32.saturate(from_z.floor())
    if meets(f, r, blocks, player, portal, from, to, x, y, z) {
        return true
    }
    let dx = to_x - from_x
    let dy = to_y - from_y
    let dz = to_z - from_z
    let sx = sign(dx)
    let sy = sign(dy)
    let sz = sign(dz)
    let step_x = if sx == 0 { f64.MAX } else { f64(sx) / dx }
    let step_y = if sy == 0 { f64.MAX } else { f64(sy) / dy }
    let step_z = if sz == 0 { f64.MAX } else { f64(sz) / dz }
    var tx = step_x * (if sx > 0 { 1.0 - frac(from_x) } else { frac(from_x) })
    var ty = step_y * (if sy > 0 { 1.0 - frac(from_y) } else { frac(from_y) })
    var tz = step_z * (if sz > 0 { 1.0 - frac(from_z) } else { frac(from_z) })
    while tx <= 1.0 or ty <= 1.0 or tz <= 1.0 {
        if tx < ty {
            if tx < tz {
                x += sx
                tx = tx + step_x
            } else {
                z += sz
                tz = tz + step_z
            }
        } else if ty < tz {
            y += sy
            ty = ty + step_y
        } else {
            z += sz
            tz = tz + step_z
        }
        if meets(f, r, blocks, player, portal, from, to, x, y, z) {
            return true
        }
    }
    return false
}

// `BlockGetter.clip`'s look at the block at x, y, z: its shape for the clip, whole or none, then
// its water's, a box up to its height, `FluidState.getShape`, each met as `VoxelShape.clip` meets
// it.
fn meets<B: CollisionBlocks>(f: Facts, r: ResetFacts, blocks: B, player: bool, portal: bool, from: (f64, f64, f64), to: (f64, f64, f64), x: i32, y: i32, z: i32) -> bool {
    let state = blocks.collision_state(x, y, z) else return false
    let block = f.block(state)
    let whole = f.in_set(state, r.resetting) or (player and (block == r.end_portal or block == r.end_gateway)) or (portal and block == r.nether_portal)
    if whole and box_meets(from, to, x, y, z, 1.0) {
        return true
    }
    if not f.is_water(state) {
        return false
    }
    let top = height(f, blocks, liquid_of(f, state), x, y, z)
    return box_meets(from, to, x, y, z, f64(top))
}

// `VoxelShape.clip` of the box from the block at x, y, z's corner up to `top`, a whole block
// across: none for a line under 1e-7 long squared; met where a thousandth along the line is
// inside it, `isFullWide`; else where the line crosses one of its faces, `AABB.clip`.
fn box_meets(from: (f64, f64, f64), to: (f64, f64, f64), x: i32, y: i32, z: i32, top: f64) -> bool {
    let (ax, ay, az) = from
    let (bx, by, bz) = to
    let dx = bx - ax
    let dy = by - ay
    let dz = bz - az
    if dx * dx + dy * dy + dz * dz < 1.0e-7 {
        return false
    }
    let px = ax + dx * 0.001 - f64(x)
    let py = ay + dy * 0.001 - f64(y)
    let pz = az + dz * 0.001 - f64(z)
    if px >= 0.0 and px < 1.0 and py >= 0.0 and py < top and pz >= 0.0 and pz < 1.0 {
        return true
    }
    let min_x = 0.0 + f64(x)
    let min_y = 0.0 + f64(y)
    let min_z = 0.0 + f64(z)
    let max_x = 1.0 + f64(x)
    let max_y = top + f64(y)
    let max_z = 1.0 + f64(z)
    if dx > 1.0e-7 {
        if crosses(dx, dy, dz, min_x, min_y, max_y, min_z, max_z, ax, ay, az) {
            return true
        }
    } else if dx < -1.0e-7 {
        if crosses(dx, dy, dz, max_x, min_y, max_y, min_z, max_z, ax, ay, az) {
            return true
        }
    }
    if dy > 1.0e-7 {
        if crosses(dy, dz, dx, min_y, min_z, max_z, min_x, max_x, ay, az, ax) {
            return true
        }
    } else if dy < -1.0e-7 {
        if crosses(dy, dz, dx, max_y, min_z, max_z, min_x, max_x, ay, az, ax) {
            return true
        }
    }
    if dz > 1.0e-7 {
        return crosses(dz, dx, dy, min_z, min_x, max_x, min_y, max_y, az, ax, ay)
    }
    if dz < -1.0e-7 {
        return crosses(dz, dx, dy, max_z, min_x, max_x, min_y, max_y, az, ax, ay)
    }
    return false
}

// `AABB.clipPoint`: whether the line crosses the face at `point` along its first axis, within
// the face's bounds on the other two less and more 1e-7, between its start and end. A face
// crossed further than another still counts, as only whether one is matters.
fn crosses(da: f64, db: f64, dc: f64, point: f64, min_b: f64, max_b: f64, min_c: f64, max_c: f64, from_a: f64, from_b: f64, from_c: f64) -> bool {
    let s = (point - from_a) / da
    let pb = from_b + s * db
    let pc = from_c + s * dc
    return 0.0 < s and s < 1.0 and min_b - 1.0e-7 < pb and pb < max_b + 1.0e-7 and min_c - 1.0e-7 < pc and pc < max_c + 1.0e-7
}

// `Mth.lerp`.
fn lerp(delta: f64, a: f64, b: f64) -> f64 {
    return a + delta * (b - a)
}

// `Mth.sign`: 0, 1 or -1.
fn sign(v: f64) -> i32 {
    if v == 0.0 {
        return 0
    }
    return if v > 0.0 { 1 } else { -1 }
}

// `Mth.frac`: what's above the floor.
fn frac(v: f64) -> f64 {
    return v - v.floor()
}
