/// Random ticks, as `ServerLevel.tickChunk` gives a chunk's blocks theirs, and what a block does
/// with its tick, by the class that declares its `randomTick`, as vanilla's own says (P6.1, D318,
/// D338).
///
/// Each chunk whose blocks tick picks `random_tick_speed` places in each of its sections with a
/// block or fluid that ticks at random, through `BlockRandom`, the level's `getBlockRandomPos`,
/// and ticks the block there if it ticks at random, then its fluid if that does, which is lava's.
/// What a block does with its tick draws from the level's random, and it sets the blocks it
/// changes through the level (D321). Grass and mycelium spread, drawing 12 times where the light
/// above them is 9 or more, and die back to dirt; budding amethyst grows a bud one time in five
/// (D320). Lava draws where fire may spread from it, near a player, twice for each tick, its
/// block's and its fluid's, and sets the fire (D339); ice melts and snow goes in block light over
/// 11; a mushroom spreads one time in 25; sugar cane grows; decaying leaves go; and a nether
/// portal draws nothing in a peaceful world (D338). What those leave out, what snow and leaves
/// drop and a portal's piglins, and every other class's tick, is reported once and left out.
module world.random_ticks

import random.source.{RandomSource}
import world.block_flags.{FLUID_RANDOMLY_TICKING, RANDOMLY_TICKING}
import world.block_level.{BlockLevel, remove_block}
import world.block_updates.{fire_state}
import world.light.{LightStates, UP}
import world.level_writer.{LevelWriter, UPDATE_ALL}
import world.natural.{SpawnLevel, raw_brightness}
import worldgen.access.{BlockAccess}
import worldgen.facts.{BlockSet, Facts, WATER_FLUID, direction_name, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env, can_survive}

/// `Level.randValue`, which `getBlockRandomPos` steps to pick where random ticks and
/// precipitation land, a linear congruential generator of its own, apart from the level's
/// random.
pub struct BlockRandom {
    pub value: i32 = 0
}

impl BlockRandom {
    /// `getBlockRandomPos`: a place in the 16 by 16 columns from `x`, `z`, up from `y` by the
    /// bits under `mask`, as the value steps on.
    pub fn next_pos(mut self, x: i32, y: i32, z: i32, mask: i32) -> (i32, i32, i32) {
        self.value = self.value * 3 + 1013904223
        let v = self.value >> 2
        return (x + (v & 15), y + ((v >> 16) & mask), z + ((v >> 8) & 15))
    }
}

/// What a level's block ticks read of it besides its blocks, random and scheduled, the same for
/// each in a tick, which the level holds (D338, D339): how much the sky's darkened, where the
/// players who aren't spectators are, how far from them fire spreads, the game rule
/// `fire_spread_radius_around_player`, whether the dimension's water evaporates, the difficulty,
/// by its ID, whether it's raining, `isRaining`, whether fire lights portals there, as it does in
/// the Overworld and the Nether, `inPortalDimension`, the block tag of what burns forever there,
/// the dimension type's `infiniburn`, and `INCREASED_FIRE_BURNOUT`, as the dimension has it and
/// as each biome that sets it has it; and how many layers of snow precipitation lays, the game
/// rule `max_snow_accumulation_height` (D340).
pub struct TickPlace {
    pub darken: i32 = 0
    pub players: List<(f64, f64, f64)> = List<(f64, f64, f64)>()
    pub fire_radius: i32 = 128
    pub evaporates: bool = false
    pub difficulty: i32 = 2
    pub raining: bool = false
    pub portals: bool = false
    pub infiniburn: String = String()
    pub burnout: bool = false
    pub burnout_biomes: List<(i32, bool)> = List<(i32, bool)>()
    pub max_snow: i32 = 1
    /// Whether the level is the End's (CAL-127).
    pub end: bool = false
    /// The world border's west, north, east and south edges, as `getMinX` and the rest give them
    /// this tick (CAL-125).
    pub border_min_x: f64 = -29999984.0
    pub border_min_z: f64 = -29999984.0
    pub border_max_x: f64 = 29999984.0
    pub border_max_z: f64 = 29999984.0
    /// `SUN_ANGLE`, in degrees, as the dimension has it this tick and as each biome that sets it
    /// has it, which a daylight detector reads (CAL-130).
    pub sun_angle: f32 = 0.0f32
    pub sun_biomes: List<(i32, f32)> = List<(i32, f32)>()
    /// The players who aren't spectators with a container's menu open, which a chest's recheck
    /// counts (CAL-144).
    pub viewers: List<Viewer> = List<Viewer>()
    /// The dimension type's `ambient_light`, and whether monsters burn in daylight in the
    /// dimension, `MONSTERS_BURN`, which a mob's tick reads (CAL-156).
    pub ambient_light: f32 = 0.0f32
    pub monsters_burn: bool = false
}

/// A player who isn't a spectator with a container's menu open (CAL-144): where they stand, how
/// far they reach blocks, `getContainerInteractionRange`, and the block entities the container's
/// of, or the ender chest it's open at, `isOwnContainer`.
pub struct Viewer {
    pub x: f64
    pub y: f64
    pub z: f64
    pub range: f64
    pub parts: List<(i32, i32, i32)>
}

impl TickPlace {
    /// `SUN_ANGLE` in the biome `biome`, by its ID: the biome's own where it sets it, else the
    /// dimension's (CAL-130).
    pub fn sun_angle_in(self, biome: i32) -> f32 {
        for (b, value) in self.sun_biomes {
            if b == biome {
                return value
            }
        }
        return self.sun_angle
    }

    /// `hasNearbyAlivePlayer`: whether a player who isn't a spectator stands nearer than `range`
    /// to `x`, `y`, `z`, by `distanceToSqr`, or any does if `range` is under 0 (CAL-130).
    pub fn player_within(self, x: f64, y: f64, z: f64, range: f64) -> bool {
        for (px, py, pz) in self.players {
            let dx = px - x
            let dy = py - y
            let dz = pz - z
            if range < 0.0 or dx * dx + dy * dy + dz * dz < range * range {
                return true
            }
        }
        return false
    }

    /// How many of the players are in the box from `min_x`, `min_y`, `min_z` to `max_x`, `max_y`,
    /// `max_z`, by `AABB.intersects`, each a standing player's box, `EntityDimensions
    /// .makeBoundingBox`: 0.6 wide and 1.8 tall, in floats, about where it stands (CAL-128).
    pub fn players_touching(self, min_x: f64, min_y: f64, min_z: f64, max_x: f64, max_y: f64, max_z: f64) -> i32 {
        let w = f64(0.3f32)
        let h = f64(1.8f32)
        var n = 0
        for (px, py, pz) in self.players {
            if px - w < max_x and px + w > min_x and py < max_y and py + h > min_y and pz - w < max_z and pz + w > min_z {
                n += 1
            }
        }
        return n
    }

    /// `ContainerOpenersCounter.getEntitiesWithContainerOpen` of the block entity at `x`, `y`,
    /// `z` (CAL-144): how many of the viewers have its container open, their standing boxes in
    /// its block's grown by `range`, as `players_touching` has them, and the most any of them
    /// reaches.
    pub fn viewers_of(self, x: i32, y: i32, z: i32, range: f64) -> (i32, f64) {
        let w = f64(0.3f32)
        let h = f64(1.8f32)
        let (x0, y0, z0) = (f64(x) - range, f64(y) - range, f64(z) - range)
        let (x1, y1, z1) = (f64(x) + 1.0 + range, f64(y) + 1.0 + range, f64(z) + 1.0 + range)
        var n = 0
        var most = 0.0
        for v in self.viewers {
            var theirs = false
            for (px, py, pz) in v.parts {
                if px == x and py == y and pz == z {
                    theirs = true
                }
            }
            if theirs and v.x - w < x1 and v.x + w > x0 and v.y < y1 and v.y + h > y0 and v.z - w < z1 and v.z + w > z0 {
                n += 1
                if v.range > most {
                    most = v.range
                }
            }
        }
        return (n, most)
    }

    /// `WorldBorder.isWithinBounds` of the block column at `x`, `z` (CAL-125).
    pub fn in_border(self, x: i32, z: i32) -> bool {
        let bx = f64(x)
        let bz = f64(z)
        return bx >= self.border_min_x and bx < self.border_max_x and bz >= self.border_min_z and bz < self.border_max_z
    }

    /// `INCREASED_FIRE_BURNOUT` in the biome `biome`, by its ID, -1 for none: the biome's own
    /// where it sets it, else the dimension's.
    pub fn burnout_in(self, biome: i32) -> bool {
        for (b, value) in self.burnout_biomes {
            if b == biome {
                return value
            }
        }
        return self.burnout
    }

    /// `ServerLevel.canSpreadFireAround`: the game rule at -1, or a player nearer than it to the
    /// block's corner, as `ChunkMap.anyPlayerCloseEnoughTo` measures it.
    pub fn fire_spreads(self, x: i32, y: i32, z: i32) -> bool {
        if self.fire_radius == -1 {
            return true
        }
        let radius = f64(self.fire_radius)
        for (px, py, pz) in self.players {
            let dx = px - f64(x)
            let dy = py - f64(y)
            let dz = pz - f64(z)
            if (dx * dx + dy * dy + dz * dz).sqrt() < radius {
                return true
            }
        }
        return false
    }
}

// What each block's random tick is, by the class that declares its `randomTick`.
const NOTHING: u8 = 0
const SPREADING: u8 = 1
const BUDDING: u8 = 2
const LIQUID: u8 = 3
const ICE: u8 = 4
const SNOW_LAYER: u8 = 5
const MUSHROOM: u8 = 6
const SUGAR_CANE: u8 = 7
const LEAVES: u8 = 8
const NETHER_PORTAL: u8 = 9
const OTHER: u8 = 255

/// What random ticks read of the blocks, made once: each block's tick, by the class that
/// declares it, the blocks the ticks make, the blocks that make grass snowy, `BlockTags.SNOW`,
/// those lava's fire doesn't spread past, `BlockTags.BLOCKS_LAVA_FIRE_SPREAD`, and how light goes
/// between states, which grass and ice read.
pub struct RandomTicks {
    light: LightStates
    kinds: List<u8>
    grass: u32
    mycelium: u32
    snow: u32
    dirt: u32
    water: u32
    small_bud: u32
    medium_bud: u32
    large_bud: u32
    cluster: u32
    snowy: BlockSet
    stops_fire: BlockSet
}

impl RandomTicks {
    pub fn new(facts: Facts) -> RandomTicks ! String {
        var kinds = List<u8>()
        for b in 0..facts.block_count {
            kinds.push(kind_of(facts.random_tick_class(b)))
        }
        return RandomTicks {
            light: LightStates.new(),
            kinds: kinds,
            grass: try block_id(facts, "minecraft:grass_block"),
            mycelium: try block_id(facts, "minecraft:mycelium"),
            snow: try block_id(facts, "minecraft:snow"),
            dirt: try block_id(facts, "minecraft:dirt"),
            water: try block_id(facts, "minecraft:water"),
            small_bud: try block_id(facts, "minecraft:small_amethyst_bud"),
            medium_bud: try block_id(facts, "minecraft:medium_amethyst_bud"),
            large_bud: try block_id(facts, "minecraft:large_amethyst_bud"),
            cluster: try block_id(facts, "minecraft:amethyst_cluster"),
            snowy: facts.tag(String("minecraft:snow")),
            stops_fire: facts.tag(String("minecraft:blocks_lava_fire_spread")),
        }
    }

    /// The random tick of the block `state` at `x`, `y`, `z`, `BlockState.randomTick`, if it
    /// ticks at random, then of its fluid, `FluidState.randomTick`, if that does, as `tickChunk`
    /// gives them, with what the level's `TickPlace` says of it, drawing from the level's random
    /// and setting the blocks they change in the level (D323, D338).
    pub fn tick<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel>(self, e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
        let Env { facts: f, .. } = e
        let flags = f.flags(state)
        if flags & RANDOMLY_TICKING != 0 {
            try self.block_tick(e, mut level, state, x, y, z)
        }
        // The fluid of the state as it was before its block's tick, as vanilla reads it.
        if flags & FLUID_RANDOMLY_TICKING != 0 {
            try self.lava_tick(f, mut level, x, y, z)
        }
    }

    // `BlockState.randomTick`, by the class that declares it.
    fn block_tick<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel>(self, e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
        let Env { facts: f, .. } = e
        let block = f.block(state)
        let kind = self.kinds[usize(block)]
        if kind == NOTHING {
            return
        }
        if kind == SPREADING {
            let darken = level.sky_darken()
            self.spread(f, mut level, state, x, y, z, darken)
        } else if kind == BUDDING {
            self.grow_bud(f, mut level, x, y, z)
        } else if kind == LIQUID {
            // `LiquidBlock.randomTick`: its fluid's, which `tickChunk` gives it again after.
            try self.lava_tick(f, mut level, x, y, z)
        } else if kind == ICE {
            try self.melt_ice(f, mut level, state, x, y, z)
        } else if kind == SNOW_LAYER {
            // `SnowLayerBlock.randomTick`: in block light over 11 it drops what it drops and goes.
            if level.light(false, x, y, z) > 11 {
                level.drop_resources(f, state, x, y, z, none, none, none)
                _ = try remove_block(f, mut level, x, y, z)
            }
        } else if kind == MUSHROOM {
            try spread_mushroom(e, mut level, state, x, y, z)
        } else if kind == SUGAR_CANE {
            try grow_cane(f, mut level, state, x, y, z)
        } else if kind == LEAVES {
            // `LeavesBlock.randomTick`: leaves decaying, far from a log and not placed, drop what
            // they drop and go; only those tick at random.
            if not f.get_bool(state, "persistent") and f.get_int(state, String("distance")) == some(7) {
                level.drop_resources(f, state, x, y, z, none, none, none)
                _ = try remove_block(f, mut level, x, y, z)
            }
        } else if kind == NETHER_PORTAL {
            // `NetherPortalBlock.randomTick` draws only where monsters spawn, and spawns a
            // zombified piglin, which comes with entities.
            if level.difficulty() != 0 {
                level.unimplemented(String("randomTick of NetherPortalBlock"))
            }
        } else {
            level.unimplemented("randomTick of {f.random_tick_class(block)}")
        }
    }

    // `SpreadingSnowyBlock.randomTick`: where it can't stay alive, it turns to dirt, its base
    // block; where it can and the light above it is 9 or more, it tries four places around it,
    // each drawn, and spreads to each that's dirt it can stay alive on with no water above it,
    // `canPropagate`, snowy where what's above that is snow, as `isSnowySetting` has it (D321).
    fn spread<L: SpawnLevel + LevelWriter + RandomSource>(self, facts: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, darken: i32) {
        if not self.stays_alive(facts, level, state, x, y, z) {
            _ = level.set_block(x, y, z, facts.default_state(self.dirt), UPDATE_ALL)
            return
        }
        if raw_brightness(level, x, y + 1, z, darken) < 9 {
            return
        }
        let spreading = facts.default_state(facts.block(state))
        for _ in 0..4 {
            // `pos.offset(nextInt(3) - 1, nextInt(5) - 3, nextInt(3) - 1)`, its arguments drawn
            // in order.
            let tx = x + level.next_int_below(3) - 1
            let ty = y + level.next_int_below(5) - 3
            let tz = z + level.next_int_below(3) - 1
            if not facts.is(level.spawn_state(tx, ty, tz), self.dirt) {
                continue
            }
            if not self.stays_alive(facts, level, spreading, tx, ty, tz) or facts.is_water(level.spawn_state(tx, ty + 1, tz)) {
                continue
            }
            let snowy = facts.in_set(level.spawn_state(tx, ty + 1, tz), self.snowy)
            _ = level.set_block(tx, ty, tz, facts.try_bool(spreading, String("snowy"), snowy), UPDATE_ALL)
        }
    }

    // `BuddingAmethystBlock.randomTick`: one time in five, a side, drawn from `Direction.values()`;
    // a small bud grows there where it's air or full water, `canClusterGrowAtState`, and a bud
    // that faces that way grows on, small to medium to large to a cluster, facing that way, and
    // waterlogged where what was there was water's source (D321).
    fn grow_bud<L: SpawnLevel + LevelWriter + RandomSource>(self, facts: Facts, level: mut L, x: i32, y: i32, z: i32) {
        if level.next_int_below(5) != 0 {
            return
        }
        let d = level.next_int_below(6)
        let tx = x + step_x(d)
        let ty = y + step_y(d)
        let tz = z + step_z(d)
        let there = level.spawn_state(tx, ty, tz)
        var facing = false
        if let name = facts.get_name(there, String("facing")) {
            facing = name == direction_name(d)
        }
        var grown: u32? = none
        if facts.is_air(there) or (facts.is(there, self.water) and facts.fluid_amount(there) == 8) {
            grown = some(self.small_bud)
        } else if facts.is(there, self.small_bud) and facing {
            grown = some(self.medium_bud)
        } else if facts.is(there, self.medium_bud) and facing {
            grown = some(self.large_bud)
        } else if facts.is(there, self.large_bud) and facing {
            grown = some(self.cluster)
        }
        let b = grown else return
        let faced = facts.try_name(facts.default_state(b), String("facing"), direction_name(d))
        _ = level.set_block(tx, ty, tz, facts.try_bool(faced, String("waterlogged"), facts.fluid(there) == WATER_FLUID), UPDATE_ALL)
    }

    // `SpreadingSnowyBlock.canStayAlive`: under one layer of snow, or under a block that's no
    // full fluid and lets light into it from below, `getLightDampeningInto` under 15.
    fn stays_alive<L: SpawnLevel>(self, facts: Facts, level: L, state: u32, x: i32, y: i32, z: i32) -> bool {
        let above = level.spawn_state(x, y + 1, z)
        if facts.is(above, self.snow) and facts.get_int(above, String("layers")) == some(1) {
            return true
        }
        if facts.fluid_amount(above) == 8 {
            return false
        }
        return self.light.dampening_into(state, above, UP) < 15
    }

    // `LavaFluid.randomTick`, where fire may spread around it: up to two blocks up and about it,
    // drawn, or three beside it, drawn, each in a loaded chunk. Fire goes in the first air above
    // the lava by something lava sets alight, and that's all; or above each block beside it lava
    // sets alight with air over it, as `BaseFireBlock.getState` has fire in the block below,
    // which vanilla asks (D339). Rising, it stops at a block that stops it,
    // `BLOCKS_LAVA_FIRE_SPREAD`.
    fn lava_tick<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel>(self, f: Facts, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
        if not level.fire_spreads(x, y, z) {
            return
        }
        let passes = level.next_int_below(3)
        if passes > 0 {
            var tx = x
            var ty = y
            var tz = z
            for _ in 0..passes {
                tx += level.next_int_below(3) - 1
                ty += 1
                tz += level.next_int_below(3) - 1
                if not level.is_loaded(tx, ty, tz) {
                    return
                }
                let there = level.spawn_state(tx, ty, tz)
                if f.is_air(there) {
                    if flammable_beside(f, level, tx, ty, tz) {
                        let fire = try fire_state(f, level, tx, ty, tz)
                        _ = level.set_block(tx, ty, tz, fire, UPDATE_ALL)
                        return
                    }
                } else if f.in_set(there, self.stops_fire) {
                    return
                }
            }
            return
        }
        for _ in 0..3 {
            let tx = x + level.next_int_below(3) - 1
            let tz = z + level.next_int_below(3) - 1
            if not level.is_loaded(tx, y, tz) {
                return
            }
            if f.is_air(level.spawn_state(tx, y + 1, tz)) and flammable(f, level, tx, y, tz) {
                let fire = try fire_state(f, level, tx, y, tz)
                _ = level.set_block(tx, y + 1, tz, fire, UPDATE_ALL)
            }
        }
    }

    // `IceBlock.randomTick`: in block light over 11 less its own dampening, it melts, `melt`: it
    // goes where water evaporates, and is water elsewhere, which is told its block changed.
    fn melt_ice<L: SpawnLevel + LevelWriter + BlockAccess + BlockLevel>(self, f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
        if level.light(false, x, y, z) <= 11 - self.light.dampening(state) {
            return
        }
        if level.water_evaporates() {
            _ = try remove_block(f, mut level, x, y, z)
            return
        }
        _ = level.set_block(x, y, z, f.ids.water_state, UPDATE_ALL)
        level.neighbour_changed(x, y, z, f.ids.water)
    }
}

// `LavaFluid.hasFlammableNeighbours`: one of the six around, in `Direction`'s order, lava
// sets alight.
fn flammable_beside<L: SpawnLevel + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool {
    for d in 0..6 {
        if flammable(f, level, x + step_x(d), y + step_y(d), z + step_z(d)) {
            return true
        }
    }
    return false
}

// `LavaFluid.isFlammable`: not in a chunk that isn't loaded, inside the world's height, else
// what's there lava sets alight, `ignitedByLava`.
fn flammable<L: SpawnLevel + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool {
    if level.in_height(y) and not level.is_loaded(x, y, z) {
        return false
    }
    return f.ignited_by_lava(level.spawn_state(x, y, z))
}

// `MushroomBlock.randomTick`: one time in 25, where at most 4 of it are in the 9 by 3 by 9
// around it, `canSpread`, it looks five times at a place drawn about where it's got to,
// moving there each time it's air it can stay in, and grows in the last, set with flags 2.
fn spread_mushroom<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    if level.next_int_below(25) != 0 {
        return
    }
    let block = f.block(state)
    var found = 0
    for ax in x - 4..x + 5 {
        for ay in y - 1..y + 2 {
            for az in z - 4..z + 5 {
                if f.is(level.spawn_state(ax, ay, az), block) {
                    found += 1
                }
            }
        }
    }
    if found > 4 {
        return
    }
    var at_x = x
    var at_y = y
    var at_z = z
    // `pos.offset(nextInt(3) - 1, nextInt(2) - nextInt(2), nextInt(3) - 1)`, drawn in order.
    var tx = at_x + level.next_int_below(3) - 1
    var ty = at_y + level.next_int_below(2)
    ty -= level.next_int_below(2)
    var tz = at_z + level.next_int_below(3) - 1
    for _ in 0..4 {
        if f.is_air(level.spawn_state(tx, ty, tz)) and try can_survive(e, level, state, tx, ty, tz) {
            at_x = tx
            at_y = ty
            at_z = tz
        }
        tx = at_x + level.next_int_below(3) - 1
        ty = at_y + level.next_int_below(2)
        ty -= level.next_int_below(2)
        tz = at_z + level.next_int_below(3) - 1
    }
    if f.is_air(level.spawn_state(tx, ty, tz)) and try can_survive(e, level, state, tx, ty, tz) {
        _ = level.set_block(tx, ty, tz, state, 2)
    }
}

// `SugarCaneBlock.randomTick`: with air above, and fewer than three of it in its stack down
// from it, it ages, set with flags 260; at 15 it grows a new cane above, `setBlockAndUpdate`,
// and goes back to 0.
fn grow_cane<L: SpawnLevel + LevelWriter>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if not f.is_air(level.spawn_state(x, y + 1, z)) {
        return
    }
    let block = f.block(state)
    var height = 1
    while f.is(level.spawn_state(x, y - height, z), block) {
        height += 1
    }
    if height >= 3 {
        return
    }
    let age = f.get_int(state, String("age")) ?? 0
    if age == 15 {
        _ = level.set_block(x, y + 1, z, f.default_state(block), UPDATE_ALL)
        _ = level.set_block(x, y, z, try f.with_int(state, String("age"), 0), 260)
    } else {
        _ = level.set_block(x, y, z, try f.with_int(state, String("age"), age + 1), 260)
    }
}

// A block's random tick, by the name of the class that declares its `randomTick`.
fn kind_of(name: String) -> u8 {
    if name == "BlockBehaviour" {
        return NOTHING
    }
    if name == "SpreadingSnowyBlock" {
        return SPREADING
    }
    if name == "BuddingAmethystBlock" {
        return BUDDING
    }
    if name == "LiquidBlock" {
        return LIQUID
    }
    if name == "IceBlock" {
        return ICE
    }
    if name == "SnowLayerBlock" {
        return SNOW_LAYER
    }
    if name == "MushroomBlock" {
        return MUSHROOM
    }
    if name == "SugarCaneBlock" {
        return SUGAR_CANE
    }
    if name == "LeavesBlock" {
        return LEAVES
    }
    if name == "NetherPortalBlock" {
        return NETHER_PORTAL
    }
    return OTHER
}

// The block named `name`, which the data has.
fn block_id(facts: Facts, name: str) -> u32 ! String {
    let b = facts.block_named(String(name)) else fail "there's no block {name}"
    return b
}
