/// Random ticks, as `ServerLevel.tickChunk` gives a chunk's blocks theirs, and what a block does
/// with its tick, as far as Calcite has it (P6.1, D318).
///
/// Each chunk whose blocks tick picks `random_tick_speed` places in each of its sections with a
/// block or fluid that ticks at random, through `BlockRandom`, the level's `getBlockRandomPos`,
/// and ticks the block there if it ticks at random. What a block does with its tick draws from
/// the level's random: Calcite has grass's and mycelium's, which spread, drawing 12 times where
/// the light above them is 9 or more, and budding amethyst's, which picks a side to grow a bud
/// on one time in five (D320). Each sets the blocks it changes through the level, as vanilla's
/// `setBlockAndUpdate` (D321): grass and mycelium spread to dirt and die back to it, and buds
/// grow. The other blocks' ticks, and lava's, come with CAL-106.
module world.random_ticks

import random.source.{RandomSource}
import world.block_flags.{RANDOMLY_TICKING}
import world.light.{LightStates, UP}
import world.level_writer.{LevelWriter, UPDATE_ALL}
import world.natural.{SpawnLevel, raw_brightness}
import worldgen.facts.{BlockSet, Facts, WATER_FLUID, direction_name, step_x, step_y, step_z}

/// `Level.randValue`, which `getBlockRandomPos` steps to pick where random ticks and
/// precipitation land, a linear congruential generator of its own, apart from the level's
/// random.
pub struct BlockRandom {
    pub value: i32 = 0
}

impl BlockRandom {
    /// `getBlockRandomPos`: a place in the 16 by 16 columns from `x`, `z`, up from `y` by the
    /// bits under `mask`, as the value steps on.
    pub fn next_pos(mut self, x: i32, y: i32, z: i32, mask: i32) -> (i32, i32, i32) {
        self.value = self.value * 3 + 1013904223
        let v = self.value >> 2
        return (x + (v & 15), y + ((v >> 16) & mask), z + ((v >> 8) & 15))
    }
}

/// What random ticks read of the blocks, made once: the blocks whose ticks Calcite has and those
/// they make, the blocks that make grass snowy, `BlockTags.SNOW`, and how light goes between
/// states, which grass reads.
pub struct RandomTicks {
    light: LightStates
    budding: u32
    grass: u32
    mycelium: u32
    snow: u32
    dirt: u32
    water: u32
    small_bud: u32
    medium_bud: u32
    large_bud: u32
    cluster: u32
    snowy: BlockSet
}

impl RandomTicks {
    pub fn new(facts: Facts) -> RandomTicks ! String {
        return RandomTicks {
            light: LightStates.new(),
            budding: try block_id(facts, "minecraft:budding_amethyst"),
            grass: try block_id(facts, "minecraft:grass_block"),
            mycelium: try block_id(facts, "minecraft:mycelium"),
            snow: try block_id(facts, "minecraft:snow"),
            dirt: try block_id(facts, "minecraft:dirt"),
            water: try block_id(facts, "minecraft:water"),
            small_bud: try block_id(facts, "minecraft:small_amethyst_bud"),
            medium_bud: try block_id(facts, "minecraft:medium_amethyst_bud"),
            large_bud: try block_id(facts, "minecraft:large_amethyst_bud"),
            cluster: try block_id(facts, "minecraft:amethyst_cluster"),
            snowy: facts.tag(String("minecraft:snow")),
        }
    }

    /// The random tick of the block `state` at `x`, `y`, `z`, `BlockState.randomTick`, if it
    /// ticks at random, with the sky darkened by `darken`, drawing from the level's random and
    /// setting the blocks it changes in the level, as one (D323).
    pub fn tick<L: SpawnLevel + LevelWriter + RandomSource>(self, facts: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, darken: i32) {
        if facts.flags(state) & RANDOMLY_TICKING == 0 {
            return
        }
        let block = facts.block(state)
        if block == self.grass or block == self.mycelium {
            self.spread(facts, mut level, state, x, y, z, darken)
        } else if block == self.budding {
            self.grow_bud(facts, mut level, x, y, z)
        }
    }

    // `SpreadingSnowyBlock.randomTick`: where it can't stay alive, it turns to dirt, its base
    // block; where it can and the light above it is 9 or more, it tries four places around it,
    // each drawn, and spreads to each that's dirt it can stay alive on with no water above it,
    // `canPropagate`, snowy where what's above that is snow, as `isSnowySetting` has it (D321).
    fn spread<L: SpawnLevel + LevelWriter + RandomSource>(self, facts: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, darken: i32) {
        if not self.stays_alive(facts, level, state, x, y, z) {
            _ = level.set_block(x, y, z, facts.default_state(self.dirt), UPDATE_ALL)
            return
        }
        if raw_brightness(level, x, y + 1, z, darken) < 9 {
            return
        }
        let spreading = facts.default_state(facts.block(state))
        for _ in 0..4 {
            // `pos.offset(nextInt(3) - 1, nextInt(5) - 3, nextInt(3) - 1)`, its arguments drawn
            // in order.
            let tx = x + level.next_int_below(3) - 1
            let ty = y + level.next_int_below(5) - 3
            let tz = z + level.next_int_below(3) - 1
            if not facts.is(level.spawn_state(tx, ty, tz), self.dirt) {
                continue
            }
            if not self.stays_alive(facts, level, spreading, tx, ty, tz) or facts.is_water(level.spawn_state(tx, ty + 1, tz)) {
                continue
            }
            let snowy = facts.in_set(level.spawn_state(tx, ty + 1, tz), self.snowy)
            _ = level.set_block(tx, ty, tz, facts.try_bool(spreading, String("snowy"), snowy), UPDATE_ALL)
        }
    }

    // `BuddingAmethystBlock.randomTick`: one time in five, a side, drawn from `Direction.values()`;
    // a small bud grows there where it's air or full water, `canClusterGrowAtState`, and a bud
    // that faces that way grows on, small to medium to large to a cluster, facing that way, and
    // waterlogged where what was there was water's source (D321).
    fn grow_bud<L: SpawnLevel + LevelWriter + RandomSource>(self, facts: Facts, level: mut L, x: i32, y: i32, z: i32) {
        if level.next_int_below(5) != 0 {
            return
        }
        let d = level.next_int_below(6)
        let tx = x + step_x(d)
        let ty = y + step_y(d)
        let tz = z + step_z(d)
        let there = level.spawn_state(tx, ty, tz)
        var facing = false
        if let name = facts.get_name(there, String("facing")) {
            facing = name == direction_name(d)
        }
        var grown: u32? = none
        if facts.is_air(there) or (facts.is(there, self.water) and facts.fluid_amount(there) == 8) {
            grown = some(self.small_bud)
        } else if facts.is(there, self.small_bud) and facing {
            grown = some(self.medium_bud)
        } else if facts.is(there, self.medium_bud) and facing {
            grown = some(self.large_bud)
        } else if facts.is(there, self.large_bud) and facing {
            grown = some(self.cluster)
        }
        let b = grown else return
        let faced = facts.try_name(facts.default_state(b), String("facing"), direction_name(d))
        _ = level.set_block(tx, ty, tz, facts.try_bool(faced, String("waterlogged"), facts.fluid(there) == WATER_FLUID), UPDATE_ALL)
    }

    // `SpreadingSnowyBlock.canStayAlive`: under one layer of snow, or under a block that's no
    // full fluid and lets light into it from below, `getLightDampeningInto` under 15.
    fn stays_alive<L: SpawnLevel>(self, facts: Facts, level: L, state: u32, x: i32, y: i32, z: i32) -> bool {
        let above = level.spawn_state(x, y + 1, z)
        if facts.is(above, self.snow) and facts.get_int(above, String("layers")) == some(1) {
            return true
        }
        if facts.fluid_amount(above) == 8 {
            return false
        }
        return self.light.dampening_into(state, above, UP) < 15
    }
}

// The block named `name`, which the data has.
fn block_id(facts: Facts, name: str) -> u32 ! String {
    let b = facts.block_named(String(name)) else fail "there's no block {name}"
    return b
}
