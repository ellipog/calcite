/// The server's recipes, as vanilla's `RecipeManager` holds them once its resources load
/// (CAL-146): each recipe of the `recipe` registry, in its order, with what its codec read, and
/// what `finalizeRecipeLoading` makes of them for clients: the property sets, the items a
/// furnace, a smithing table or a brewing stand takes in each of its slots, and the stonecutter's
/// recipes, each input and what it makes, which `update_recipes` sends every player as they join.
/// A recipe that isn't special and has an ingredient of no items, an empty tag's, is left out of
/// them, with vanilla's warning. Every item is taken to be enabled, as Calcite has no features
/// that turn items off.
///
/// The crafting recipes are kept too with their ingredients' items, `Crafting`, which
/// `world.crafting` matches a grid against (CAL-147).
module world.recipes

import json.tree.{Json}
import nbt.tag.{Accounter, Tag, read_any}
import protocol.wire.{DecodeError, Reader, Wire, Writer}
import registry.recipes.{characters, shrunk}
import registry.registries.{Registries}
import registry.registry.{Registry}
import registry.streams.{Streams, network_id}
import resources.identifier.{Identifier}
import server.log.{Entry}

/// A recipe: its ID, the serializer its `type` names, and its value as its codec read it.
pub struct Recipe {
    pub id: Identifier
    pub kind: String
    pub value: Tag
}

/// The recipes, and what clients are sent of them.
pub struct Recipes {
    pub all: List<Recipe> = List<Recipe>()
    /// Each property set's key and its items' network IDs, in order, as
    /// `getSynchronizedItemProperties` gives them.
    pub item_sets: List<(Identifier, List<i32>)> = List<(Identifier, List<i32>)>()
    /// The stonecutter's recipes, as `update_recipes` sends them.
    pub stonecutter: Stonecutting = Stonecutting()
    /// The crafting recipes, `RecipeType.CRAFTING`'s, in the registry's order, as `RecipeMap`
    /// lists them for a grid to be matched against (CAL-147).
    pub crafting: List<Crafting> = List<Crafting>()
    /// The recipe book's displays of them (CAL-164).
    book: Book = Book()
    // Each recipe's place in `all`, by its whole ID.
    by_id: JavaHashMap<String, usize> = JavaHashMap<String, usize>()
}

/// The recipe book's displays of the recipes, as `RecipeManager.unpackRecipeInfo` makes them once
/// they're loaded (CAL-164): each recipe's displays, `Recipe.display`, numbered in the registry's
/// order, each written with the registries as `RecipeDisplayEntry.STREAM_CODEC` writes it: its
/// number, the display, its recipe's group, numbered as the groups first come, its recipe's book
/// category, and the ingredients its recipe's `PlacementInfo` has, but for a special recipe's,
/// which has none to give. A special recipe has no displays.
struct Book {
    // Each display, by its number.
    entries: List<List<u8>> = List<List<u8>>()
    // The numbers of each recipe's displays, by its place in `Recipes.all`.
    of: List<List<usize>> = List<List<usize>>()
    // Whether each recipe tells the player as it's added, `showNotification`.
    notify: List<bool> = List<bool>()
    // Why they couldn't be written, an item, a category or a display the registries don't have,
    // which only a broken build gives.
    problem: String? = none
}

/// A player's recipe book, as vanilla's `ServerRecipeBook` keeps it (CAL-164): the recipes they
/// know, `known`, and those they're yet to look at, `highlight`, by their places in
/// `Recipes.all`.
pub struct RecipeBook {
    known: Set<usize> = Set<usize>()
    highlight: Set<usize> = Set<usize>()
}

impl RecipeBook {
    /// Whether they know the recipe `i`.
    pub fn knows(self, i: usize) -> bool {
        return self.known.contains(i)
    }

    /// `addRecipes`' part for the recipe `i` of `recipes`: where they didn't know it and it isn't
    /// special, known and highlighted. Whether it was.
    pub fn learn(mut self, recipes: Recipes, i: usize) -> bool {
        if i >= recipes.all.len() or self.known.contains(i) or special(recipes.all[i].kind) {
            return false
        }
        self.known.insert(i)
        self.highlight.insert(i)
        return true
    }
}

/// An ingredient, as `Ingredient` tests a stack: the items it holds, by their whole IDs.
pub struct Ingredient {
    pub items: Set<String> = Set<String>()
}

impl Ingredient {
    /// `Ingredient.test`: whether `stack` is of one of its items, which nothing isn't.
    pub fn test(self, stack: Tag?) -> bool {
        match stack {
            some(Tag.Compound(m)) => {
                if not m.contains(String("id")) {
                    return false
                }
                return match m[String("id")] {
                    Tag.Str(id) => self.items.contains(id),
                    _ => false,
                }
            },
            _ => return false,
        }
    }

    /// Whether it holds no items, as an empty tag's doesn't, `Ingredient.isEmpty`.
    pub fn is_empty(self) -> bool {
        return self.items.is_empty()
    }
}

/// A smelting recipe as `SmeltItemFunction` matches a stack against it (D436): its ingredient,
/// and what it makes, `result`, as `ItemStackTemplate`'s codec writes it.
pub struct Smelting {
    pub input: Ingredient
    pub result: Tag
}

/// The smelting recipes of `r`'s `recipe` registry, `RecipeType.SMELTING`'s, in the registry's
/// order, as `RecipeMap` lists them for `getRecipeFor`, but those it leaves out as impossible to
/// place, an ingredient of no items (D436).
pub fn smelting_of(r: Registries) -> List<Smelting> {
    let at = r.find_reloadable(String("recipe")) else return List<Smelting>()
    let i = r.find_builtin(String("item")) else return List<Smelting>()
    return smelting_in(r.reloadable[at], r.builtin[i])
}

// The smelting recipes of `registry`, against the item registry `items`.
fn smelting_in(registry: Registry, items: Registry) -> List<Smelting> {
    var out = List<Smelting>()
    for k in 0..registry.entries.len() {
        if k >= registry.contents.len() {
            break
        }
        var pos: usize = 0
        var accounter = Accounter.unlimited()
        let value = match read_any(registry.contents[k], mut pos, mut accounter) {
            ok(v) => v,
            err(_) => continue,
        }
        let kind = text(field(value, "type"))
        if kind != "minecraft:smelting" {
            continue
        }
        let recipe = Recipe { id: registry.entries[k].copy(), kind: kind, value: value }
        if not placeable(recipe, items) {
            continue
        }
        out.push(Smelting { input: ingredient_of(field(recipe.value, "ingredient"), items), result: field(recipe.value, "result") })
    }
    return out
}

/// A crafting recipe as a grid is matched against it (CAL-147): its place in `Recipes.all`, its
/// serializer, and its ingredients with their items. A shaped one's pattern, shrunk, is `width`
/// by `height` cells, each the place of its symbol's ingredient in `ingredients` or -1 for a
/// space; a shapeless one's ingredients are `ingredients`; the other kinds' are by their fields'
/// names in `parts`, a firework star's shapes as `shape:` and the shape.
pub struct Crafting {
    pub at: usize
    pub kind: String
    pub width: usize = 0
    pub height: usize = 0
    pub cells: List<i32> = List<i32>()
    pub ingredients: List<Ingredient> = List<Ingredient>()
    pub parts: List<(String, Ingredient)> = List<(String, Ingredient)>()
}

impl Crafting {
    /// Whether the ingredient of the field `name` takes `stack`, which one it hasn't doesn't.
    pub fn tests(self, name: str, stack: Tag?) -> bool {
        for (n, ingredient) in self.parts {
            if n == String(name) {
                return ingredient.test(stack)
            }
        }
        return false
    }

    /// Whether it has the field `name`.
    pub fn has_part(self, name: str) -> bool {
        for (n, _) in self.parts {
            if n == String(name) {
                return true
            }
        }
        return false
    }
}

/// The stonecutter's recipes, vanilla's `SelectableRecipe.SingleInputSet`, written with the
/// registries as `SingleInputSet.noRecipeCodec` writes them: how many, then each input as
/// `Ingredient.CONTENTS_STREAM_CODEC` writes it and what it makes as a `SlotDisplay`. A
/// packet's `Wire` has no registries, so `Recipes.of` writes them. Nothing written is none.
pub struct Stonecutting {
    bytes: List<u8> = List<u8>()
    // Why they couldn't be written, an item or a slot display the registries don't have, which
    // only a broken build gives, and which stops the packet as an encoder's exception does.
    problem: String? = none
}

/// The stonecutter's recipes as a packet holds them. Ones there are can only be read with the
/// registries, which a packet's `Wire` hasn't, so only none read.
impl Wire for Stonecutting {
    fn read(r: mut Reader) -> Stonecutting ! DecodeError {
        if try r.varint() != 0 {
            fail DecodeError { message: String("the stonecutter's recipes are read with the registries") }
        }
        return Stonecutting()
    }

    fn write(self, w: mut Writer) {
        if let p = self.problem {
            w.refuse(p.copy())
            return
        }
        if self.bytes.is_empty() {
            w.varint(0)
            return
        }
        w.raw(self.bytes)
    }
}

impl Recipes {
    /// The recipes of `r`'s `recipe` registry, and what clients are sent of them, written with
    /// `streams`, with a warning in `logs` for each left out for an ingredient of no items.
    pub fn of(r: Registries, streams: Streams, logs: mut List<Entry>) -> Recipes {
        let at = r.find_reloadable(String("recipe")) else return Recipes()
        let i = r.find_builtin(String("item")) else return Recipes()
        return made(r.reloadable[at], r.builtin[i], r, streams, mut logs)
    }

    /// The recipe of the whole ID `id`, by its place in `all`, `RecipeManager.byKey`.
    pub fn find(self, id: String) -> usize? {
        return self.by_id.get(id)
    }

    /// How many displays the recipe book has of the recipe `i`.
    pub fn displays(self, i: usize) -> usize {
        if i >= self.book.of.len() {
            return 0
        }
        return self.book.of[i].len()
    }

    /// The recipe `i`'s displays as `recipe_book_add` sends them, each a
    /// `ClientboundRecipeBookAddPacket.Entry`: the display's entry, then its flags, 1 where its
    /// recipe tells the player, `showNotification`, as `addRecipes` has it where `notify`, and 2
    /// where it's `highlight`ed.
    pub fn write_entries(self, i: usize, notify: bool, highlight: bool, w: mut Writer) {
        if let p = self.book.problem {
            w.refuse(p.copy())
            return
        }
        if i >= self.book.of.len() {
            return
        }
        var flags: i8 = 0
        if notify and self.book.notify[i] {
            flags = 1
        }
        if highlight {
            flags = flags | 2
        }
        for n in self.book.of[i] {
            w.raw(self.book.entries[n])
            w.i8(flags)
        }
    }
}

// The recipes of `registry`, with what clients are sent of them, against the item registry
// `items`.
fn made(registry: Registry, items: Registry, r: Registries, streams: Streams, logs: mut List<Entry>) -> Recipes {
    var out = Recipes()
    for k in 0..registry.entries.len() {
        if k >= registry.contents.len() {
            break
        }
        var pos: usize = 0
        var accounter = Accounter.unlimited()
        let value = match read_any(registry.contents[k], mut pos, mut accounter) {
            ok(v) => v,
            err(_) => continue,
        }
        let kind = text(field(value, "type"))
        if kind.starts_with("minecraft:crafting_") {
            out.crafting.push(crafting_of(out.all.len(), kind, value, items))
        }
        out.all.push(Recipe { id: registry.entries[k].copy(), kind: kind, value: value })
    }
    // The property sets' ingredients, by set, in `RECIPE_PROPERTY_SETS`' order, and the
    // stonecutter's recipes, from each recipe that can be placed, in the registry's order.
    let keys: List<String> = ["smithing_base", "smithing_template", "smithing_addition", "furnace_input", "blast_furnace_input", "smoker_input", "campfire_input", "brewing_input", "brewing_reagent"]
    var sets = List<List<i32>>()
    for _ in keys {
        sets.push(List<i32>())
    }
    var cut = Writer.new()
    var cuts: i32 = 0
    var entries = Writer.new()
    for recipe in out.all {
        if not special(recipe.kind) and not placeable(recipe, items) {
            logs.push(Entry.warn("Recipe {recipe.id.to_string()} can't be placed due to empty ingredients and will be ignored"))
            continue
        }
        for s in 0..keys.len() {
            let input = property_input(recipe, keys[s]) else continue
            for id in item_ids(input, items) {
                sets[s].push(id)
            }
        }
        if recipe.kind == "minecraft:stonecutting" {
            write_ingredient(field(recipe.value, "ingredient"), items, mut entries)
            write_display(field(recipe.value, "result"), streams, r, mut entries)
            cuts += 1
        }
    }
    for s in 0..keys.len() {
        out.item_sets.push((Identifier { namespace: "minecraft", path: keys[s].copy() }, distinct(sets[s])))
    }
    cut.varint(cuts)
    let problem = entries.problem()
    cut.raw(entries.into_bytes())
    out.stonecutter = Stonecutting { bytes: cut.into_bytes(), problem: problem }
    for k in 0..out.all.len() {
        out.by_id.insert(out.all[k].id.to_string(), k)
    }
    out.book = book_of(out.all, items, streams, r)
    return out
}

// `unpackRecipeInfo` of `all`, every recipe, in the registry's order, those left out as
// impossible to place too: each one's displays, numbered as they come, each with its recipe's
// group, numbered as the groups first come, `Object2IntMap.computeIfAbsent`'s.
fn book_of(all: List<Recipe>, items: Registry, streams: Streams, r: Registries) -> Book {
    var out = Book()
    var groups = JavaHashMap<String, i32>()
    for recipe in all {
        let group = text(field(recipe.value, "group"))
        var group_id: i32 = -1
        if not group.is_empty() {
            group_id = match groups.get(group) {
                some(n) => n,
                none => {
                    let n = i32.wrap(groups.len())
                    groups.insert(group.copy(), n)
                    n
                },
            }
        }
        out.notify.push(not special(recipe.kind) and field(recipe.value, "show_notification") != Tag.Byte(0i8))
        var numbers = List<usize>()
        var problems = List<String>()
        let shown = recipe_displays(recipe, items, streams, r, mut problems)
        if not problems.is_empty() and out.problem == none {
            out.problem = some(problems[0].copy())
        }
        if not shown.is_empty() {
            var head = Writer.new()
            head.varint(group_id + 1)
            let category = book_category(recipe)
            match network_id(r, String("minecraft:recipe_book_category"), "minecraft:{category}") {
                some(n) => head.varint(n),
                none => head.refuse("no recipe book category minecraft:{category}"),
            }
            match placement(recipe, items) {
                some(ingredients) => {
                    head.bool(true)
                    head.count(ingredients.len())
                    for ingredient in ingredients {
                        write_ingredient(ingredient, items, mut head)
                    }
                },
                none => head.bool(false),
            }
            if let p = head.problem() {
                out.problem = some(p)
            }
            let tail = head.into_bytes()
            for display in shown {
                let n = out.entries.len()
                var w = Writer.new()
                w.varint(i32.wrap(n))
                w.raw(display)
                w.raw(tail)
                out.entries.push(w.into_bytes())
                numbers.push(n)
            }
        }
        out.of.push(numbers)
    }
    return out
}

// The recipe book category `recipe` is in, `Recipe.recipeBookCategory`, by its path: a crafting
// recipe's by its book's `category`, a cooking one's by its kind and its book's.
fn book_category(recipe: Recipe) -> String {
    let category = text(field(recipe.value, "category"))
    let kind = recipe.kind.copy()
    if kind == "minecraft:smelting" {
        if category == "blocks" {
            return String("furnace_blocks")
        }
        if category == "food" {
            return String("furnace_food")
        }
        return String("furnace_misc")
    }
    if kind == "minecraft:blasting" {
        if category == "blocks" {
            return String("blast_furnace_blocks")
        }
        return String("blast_furnace_misc")
    }
    if kind == "minecraft:smoking" {
        return String("smoker_food")
    }
    if kind == "minecraft:campfire_cooking" {
        return String("campfire")
    }
    if kind == "minecraft:stonecutting" {
        return String("stonecutter")
    }
    if kind == "minecraft:smithing_transform" or kind == "minecraft:smithing_trim" {
        return String("smithing")
    }
    if category == "building" {
        return String("crafting_building_blocks")
    }
    if category == "redstone" {
        return String("crafting_redstone")
    }
    if category == "equipment" {
        return String("crafting_equipment")
    }
    return String("crafting_misc")
}

// The ingredients `recipe`'s `PlacementInfo` has, as each kind's `createPlacementInfo` makes it,
// none at all where one of them holds no items, `NOT_PLACEABLE`'s; or none where it's special.
fn placement(recipe: Recipe, items: Registry) -> List<Tag>? {
    if special(recipe.kind) {
        return none
    }
    let v = recipe.value.copy()
    let kind = recipe.kind.copy()
    var out = List<Tag>()
    if kind == "minecraft:crafting_shaped" {
        for cell in shaped_cells(v) {
            if cell != Tag.End {
                out.push(cell.copy())
            }
        }
    } else if kind == "minecraft:crafting_shapeless" {
        if let Tag.List(list) = field(v, "ingredients") {
            for ingredient in list {
                out.push(ingredient.copy())
            }
        }
    } else if kind == "minecraft:crafting_transmute" {
        out.push(field(v, "input"))
        let (_, most) = material_counts(v)
        for _ in 0..most {
            out.push(field(v, "material"))
        }
    } else if kind == "minecraft:crafting_dye" {
        out.push(field(v, "target"))
        out.push(field(v, "dye"))
    } else if kind == "minecraft:crafting_imbue" {
        for n in 0..9 {
            out.push(if n == 4 { field(v, "source") } else { field(v, "material") })
        }
    } else if kind == "minecraft:smithing_transform" or kind == "minecraft:smithing_trim" {
        for name in ["template", "base", "addition"] {
            let ingredient = field(v, name)
            if ingredient != Tag.End {
                out.push(ingredient)
            }
        }
    } else {
        out.push(field(v, "ingredient"))
    }
    for ingredient in out {
        if item_ids(ingredient, items).is_empty() {
            return some(List<Tag>())
        }
    }
    return some(out)
}

// A shaped recipe's pattern, shrunk, as `ShapedRecipePattern.ingredients` has it: each cell's
// ingredient, row by row, or `Tag.End` for a space.
fn shaped_cells(value: Tag) -> List<Tag> {
    var lines = List<String>()
    if let Tag.List(rows) = field(value, "pattern") {
        for row in rows {
            lines.push(text(row))
        }
    }
    let key = field(value, "key")
    var out = List<Tag>()
    for row in shrunk(lines) {
        for cell in characters(row) {
            let ingredient = match key {
                Tag.Compound(m) => if m.contains(cell) { m[cell].copy() } else { Tag.End },
                _ => Tag.End,
            }
            out.push(ingredient)
        }
    }
    return out
}

// How wide a shaped recipe's pattern is, shrunk, and how high.
fn shaped_size(value: Tag) -> (i32, i32) {
    var lines = List<String>()
    if let Tag.List(rows) = field(value, "pattern") {
        for row in rows {
            lines.push(text(row))
        }
    }
    let rows = shrunk(lines)
    if rows.is_empty() {
        return (0, 0)
    }
    return (i32.wrap(characters(rows[0]).len()), i32.wrap(rows.len()))
}

// A transmute's material counts, the fewest and the most, `minMaterialCount` and
// `maxMaterialCount`: its `material_count` bounds, exactly 1 where it gives none, a bound left
// out 1 and 8.
fn material_counts(value: Tag) -> (i32, i32) {
    return match field(value, "material_count") {
        Tag.Int(n) => (n, n),
        Tag.Compound(_) => {
            let bounds = field(value, "material_count")
            let fewest = match field(bounds, "min") {
                Tag.Int(n) => n,
                _ => 1,
            }
            let most = match field(bounds, "max") {
                Tag.Int(n) => n,
                _ => 8,
            }
            (fewest, most)
        },
        _ => (1, 1),
    }
}

// `recipe`'s displays, `Recipe.display`, each as `RecipeDisplay.STREAM_CODEC` writes it: its
// type's network ID, then its slots' displays, as each kind makes them; why any couldn't be
// written in `problems`.
fn recipe_displays(recipe: Recipe, items: Registry, streams: Streams, r: Registries, problems: mut List<String>) -> List<List<u8>> {
    var out = List<List<u8>>()
    let v = recipe.value.copy()
    let kind = recipe.kind.copy()
    if kind == "minecraft:crafting_shaped" {
        var w = Writer.new()
        display_kind(r, "crafting_shaped", mut w)
        let (width, height) = shaped_size(v)
        w.varint(width)
        w.varint(height)
        let cells = shaped_cells(v)
        w.count(cells.len())
        for cell in cells {
            if cell == Tag.End {
                slot_kind(r, "empty", mut w)
            } else {
                ingredient_display(cell, items, r, mut w)
            }
        }
        write_display(field(v, "result"), streams, r, mut w)
        item_display("minecraft:crafting_table", r, mut w)
        out.push(finished(w, mut problems))
    } else if kind == "minecraft:crafting_shapeless" {
        var w = Writer.new()
        display_kind(r, "crafting_shapeless", mut w)
        let ingredients = match field(v, "ingredients") {
            Tag.List(list) => list.copy(),
            _ => List<Tag>(),
        }
        w.count(ingredients.len())
        for ingredient in ingredients {
            ingredient_display(ingredient, items, r, mut w)
        }
        write_display(field(v, "result"), streams, r, mut w)
        item_display("minecraft:crafting_table", r, mut w)
        out.push(finished(w, mut problems))
    } else if kind == "minecraft:crafting_transmute" {
        let (fewest, most) = material_counts(v)
        let result = field(v, "result")
        let base = match field(result, "count") {
            Tag.Int(n) => n,
            _ => 1,
        }
        let added = field(v, "add_material_count_to_result") == Tag.Byte(1i8)
        var count = fewest
        while count <= most {
            var w = Writer.new()
            display_kind(r, "crafting_shapeless", mut w)
            w.varint(count + 1)
            ingredient_display(field(v, "input"), items, r, mut w)
            for _ in 0..count {
                ingredient_display(field(v, "material"), items, r, mut w)
            }
            let size = if added { count + base } else { base }
            transmuted_display(result, field(v, "input"), size, items, streams, r, mut w)
            item_display("minecraft:crafting_table", r, mut w)
            out.push(finished(w, mut problems))
            count += 1
        }
    } else if kind == "minecraft:crafting_dye" {
        var w = Writer.new()
        display_kind(r, "crafting_shapeless", mut w)
        w.varint(2)
        ingredient_display(field(v, "target"), items, r, mut w)
        dyes_display(field(v, "dye"), items, r, mut w)
        slot_kind(r, "dyed", mut w)
        dyes_display(field(v, "dye"), items, r, mut w)
        ingredient_display(field(v, "target"), items, r, mut w)
        item_display("minecraft:crafting_table", r, mut w)
        out.push(finished(w, mut problems))
    } else if kind == "minecraft:crafting_imbue" {
        var w = Writer.new()
        display_kind(r, "crafting_shaped", mut w)
        w.varint(3)
        w.varint(3)
        w.varint(9)
        for n in 0..9 {
            if n == 4 {
                slot_kind(r, "with_any_potion", mut w)
                ingredient_display(field(v, "source"), items, r, mut w)
            } else {
                ingredient_display(field(v, "material"), items, r, mut w)
            }
        }
        slot_kind(r, "with_any_potion", mut w)
        write_display(field(v, "result"), streams, r, mut w)
        item_display("minecraft:crafting_table", r, mut w)
        out.push(finished(w, mut problems))
    } else if kind == "minecraft:smelting" or kind == "minecraft:blasting" or kind == "minecraft:smoking" or kind == "minecraft:campfire_cooking" {
        let station = if kind == "minecraft:smelting" {
            "minecraft:furnace"
        } else if kind == "minecraft:blasting" {
            "minecraft:blast_furnace"
        } else if kind == "minecraft:smoking" {
            "minecraft:smoker"
        } else {
            "minecraft:campfire"
        }
        var w = Writer.new()
        display_kind(r, "furnace", mut w)
        ingredient_display(field(v, "ingredient"), items, r, mut w)
        slot_kind(r, "any_fuel", mut w)
        write_display(field(v, "result"), streams, r, mut w)
        item_display(station, r, mut w)
        w.varint(match field(v, "cookingtime") {
            Tag.Int(n) => n,
            _ => 0,
        })
        w.f32(match field(v, "experience") {
            Tag.Float(x) => x,
            _ => 0.0f32,
        })
        out.push(finished(w, mut problems))
    } else if kind == "minecraft:stonecutting" {
        var w = Writer.new()
        display_kind(r, "stonecutter", mut w)
        ingredient_display(field(v, "ingredient"), items, r, mut w)
        write_display(field(v, "result"), streams, r, mut w)
        item_display("minecraft:stonecutter", r, mut w)
        out.push(finished(w, mut problems))
    } else if kind == "minecraft:smithing_transform" {
        var w = Writer.new()
        display_kind(r, "smithing", mut w)
        optional_display(field(v, "template"), items, r, mut w)
        ingredient_display(field(v, "base"), items, r, mut w)
        optional_display(field(v, "addition"), items, r, mut w)
        write_display(field(v, "result"), streams, r, mut w)
        item_display("minecraft:smithing_table", r, mut w)
        out.push(finished(w, mut problems))
    } else if kind == "minecraft:smithing_trim" {
        var w = Writer.new()
        display_kind(r, "smithing", mut w)
        ingredient_display(field(v, "template"), items, r, mut w)
        ingredient_display(field(v, "base"), items, r, mut w)
        ingredient_display(field(v, "addition"), items, r, mut w)
        slot_kind(r, "smithing_trim", mut w)
        ingredient_display(field(v, "base"), items, r, mut w)
        ingredient_display(field(v, "addition"), items, r, mut w)
        match field(v, "pattern") {
            Tag.Str(pattern) => {
                match network_id(r, String("minecraft:trim_pattern"), pattern.copy()) {
                    some(n) => w.varint(n + 1),
                    none => w.refuse("no trim pattern {pattern}"),
                }
            },
            _ => w.refuse(String("a trim pattern given in full, which Calcite can't send yet")),
        }
        item_display("minecraft:smithing_table", r, mut w)
        out.push(finished(w, mut problems))
    }
    return out
}

// What `w` wrote, or nothing where it refused, its refusal kept in `problems`.
fn finished(w: own Writer, problems: mut List<String>) -> List<u8> {
    if let p = w.problem() {
        problems.push(p)
        return List<u8>()
    }
    return w.into_bytes()
}

// The recipe display type `kind`'s network ID, as `RecipeDisplay.STREAM_CODEC` writes it first.
fn display_kind(r: Registries, kind: str, w: mut Writer) {
    match network_id(r, String("minecraft:recipe_display"), "minecraft:{kind}") {
        some(n) => w.varint(n),
        none => w.refuse("no recipe display minecraft:{kind}"),
    }
}

// The slot display type `kind`'s network ID, as `SlotDisplay.STREAM_CODEC` writes it first.
fn slot_kind(r: Registries, kind: str, w: mut Writer) {
    match network_id(r, String("minecraft:slot_display"), "minecraft:{kind}") {
        some(n) => w.varint(n),
        none => w.refuse("no slot display minecraft:{kind}"),
    }
}

// `Ingredient.display` of `ingredient`, a `TagSlotDisplay` of its holder set, its tag or its
// items.
fn ingredient_display(ingredient: Tag, items: Registry, r: Registries, w: mut Writer) {
    slot_kind(r, "tag", mut w)
    write_ingredient(ingredient, items, mut w)
}

// `Ingredient.optionalIngredientToDisplay`: an ingredient's display, or `Empty` where there's
// none.
fn optional_display(ingredient: Tag, items: Registry, r: Registries, w: mut Writer) {
    if ingredient == Tag.End {
        slot_kind(r, "empty", mut w)
        return
    }
    ingredient_display(ingredient, items, r, mut w)
}

// A dye recipe's dyes, those of `dye` with the `minecraft:dye` component, `OnlyWithComponent`.
fn dyes_display(dye: Tag, items: Registry, r: Registries, w: mut Writer) {
    slot_kind(r, "only_with_component", mut w)
    ingredient_display(dye, items, r, mut w)
    match network_id(r, String("minecraft:data_component_type"), String("minecraft:dye")) {
        some(n) => w.varint(n),
        none => w.refuse(String("no data component type minecraft:dye")),
    }
}

// An `ItemSlotDisplay` of the item `item`, a whole ID.
fn item_display(item: str, r: Registries, w: mut Writer) {
    slot_kind(r, "item", mut w)
    match network_id(r, String("minecraft:item"), String(item)) {
        some(n) => w.varint(n),
        none => w.refuse("no item {item}"),
    }
}

// A transmute's `resultDisplay` of `size`: its result's item, with its components, `size` of
// them; or, where it names none, each of `input`'s items so, in a `Composite`.
fn transmuted_display(result: Tag, input: Tag, size: i32, items: Registry, streams: Streams, r: Registries, w: mut Writer) {
    let components = field(result, "components")
    if let Tag.Str(id) = field(result, "id") {
        write_stack_display(id, size, components, streams, r, mut w)
        return
    }
    let ids = item_ids(input, items)
    slot_kind(r, "composite", mut w)
    w.count(ids.len())
    for n in ids {
        if n >= 0 and usize.wrap(n) < items.entries.len() {
            write_stack_display(items.entries[usize.wrap(n)].to_string(), size, components, streams, r, mut w)
        } else {
            w.refuse("no item numbered {n}")
        }
    }
}

// The crafting recipe at `at` of the serializer `kind`, `value`, with its ingredients' items.
fn crafting_of(at: usize, kind: String, value: Tag, items: Registry) -> Crafting {
    var c = Crafting { at: at, kind: kind.copy() }
    if kind == "minecraft:crafting_shaped" {
        var symbols = List<String>()
        match field(value, "key") {
            Tag.Compound(key) => {
                for (symbol, ingredient) in key {
                    symbols.push(symbol.copy())
                    c.ingredients.push(ingredient_of(ingredient, items))
                }
            },
            _ => {},
        }
        var lines = List<String>()
        match field(value, "pattern") {
            Tag.List(rows) => {
                for row in rows {
                    lines.push(text(row))
                }
            },
            _ => {},
        }
        let rows = shrunk(lines)
        c.height = rows.len()
        for row in rows {
            let cells = characters(row)
            c.width = cells.len()
            for cell in cells {
                var place: i32 = -1
                for i in 0..symbols.len() {
                    if symbols[i] == cell {
                        place = i32.wrap(i)
                    }
                }
                c.cells.push(place)
            }
        }
        return c
    }
    if kind == "minecraft:crafting_shapeless" {
        match field(value, "ingredients") {
            Tag.List(list) => {
                for ingredient in list {
                    c.ingredients.push(ingredient_of(ingredient, items))
                }
            },
            _ => {},
        }
        return c
    }
    for name in ["input", "material", "target", "dye", "source", "back", "left", "right", "front", "map", "shell", "fuel", "star", "trail", "twinkle", "banner"] {
        let ingredient = field(value, name)
        match ingredient {
            Tag.End => {},
            _ => c.parts.push((String(name), ingredient_of(ingredient, items))),
        }
    }
    match field(value, "shapes") {
        Tag.Compound(shapes) => {
            for (shape, ingredient) in shapes {
                c.parts.push(("shape:{shape}", ingredient_of(ingredient, items)))
            }
        },
        _ => {},
    }
    return c
}

// The ingredient `ingredient`, as its codec writes it, with its items' whole IDs.
fn ingredient_of(ingredient: Tag, items: Registry) -> Ingredient {
    var out = Ingredient()
    for n in item_ids(ingredient, items) {
        if n >= 0 and usize.wrap(n) < items.entries.len() {
            out.items.insert(items.entries[usize.wrap(n)].to_string())
        }
    }
    return out
}

// Whether the recipe of the serializer `kind` is special, as `Recipe.isSpecial` has it: a
// `CustomRecipe`'s or a brewing recipe's, which the recipe book doesn't show and which needn't be
// placeable.
fn special(kind: String) -> bool {
    return kind.starts_with("minecraft:crafting_special_") or kind == "minecraft:crafting_decorated_pot" or kind == "minecraft:brewing"
}

// Whether each of the ingredients a recipe's `PlacementInfo` has holds an item: a shaped
// recipe's key's, a shapeless one's list's, and the other kinds' named ones.
fn placeable(recipe: Recipe, items: Registry) -> bool {
    if recipe.kind == "minecraft:crafting_shaped" {
        match field(recipe.value, "key") {
            Tag.Compound(key) => {
                for (_, ingredient) in key {
                    if item_ids(ingredient, items).is_empty() {
                        return false
                    }
                }
            },
            _ => {},
        }
        return true
    }
    if recipe.kind == "minecraft:crafting_shapeless" {
        match field(recipe.value, "ingredients") {
            Tag.List(list) => {
                for ingredient in list {
                    if item_ids(ingredient, items).is_empty() {
                        return false
                    }
                }
            },
            _ => {},
        }
        return true
    }
    for name in ["ingredient", "input", "material", "target", "dye", "source", "template", "base", "addition"] {
        let ingredient = field(recipe.value, name)
        match ingredient {
            Tag.End => {},
            _ => {
                if item_ids(ingredient, items).is_empty() {
                    return false
                }
            },
        }
    }
    return true
}

// The ingredient of `recipe` that goes in the property set `key`, if it gives one, as each of
// `RECIPE_PROPERTY_SETS`' extractors finds it.
fn property_input(recipe: Recipe, key: String) -> Tag? {
    let smithing = recipe.kind == "minecraft:smithing_transform" or recipe.kind == "minecraft:smithing_trim"
    let input = if key == "smithing_base" and smithing {
        field(recipe.value, "base")
    } else if key == "smithing_template" and smithing {
        field(recipe.value, "template")
    } else if key == "smithing_addition" and smithing {
        field(recipe.value, "addition")
    } else if key == "furnace_input" and recipe.kind == "minecraft:smelting" {
        field(recipe.value, "ingredient")
    } else if key == "blast_furnace_input" and recipe.kind == "minecraft:blasting" {
        field(recipe.value, "ingredient")
    } else if key == "smoker_input" and recipe.kind == "minecraft:smoking" {
        field(recipe.value, "ingredient")
    } else if key == "campfire_input" and recipe.kind == "minecraft:campfire_cooking" {
        field(recipe.value, "ingredient")
    } else if key == "brewing_input" and recipe.kind == "minecraft:brewing" {
        field(field(recipe.value, "input"), "item")
    } else if key == "brewing_reagent" and recipe.kind == "minecraft:brewing" {
        field(field(recipe.value, "reagent"), "item")
    } else {
        Tag.End
    }
    return match input {
        Tag.End => none,
        _ => some(input),
    }
}

/// The network IDs of the items the ingredient `ingredient` holds, as its codec writes it: a tag
/// of items as `#` and its ID, an item's ID, or a list of them, in their order.
pub fn item_ids(ingredient: Tag, items: Registry) -> List<i32> {
    var out = List<i32>()
    match ingredient {
        Tag.Str(s) => {
            if s.starts_with("#") {
                if let id = parsed(s[1..]) {
                    return items.tag_ids(id)
                }
            } else if let id = parsed(s) {
                if let n = items.id(id) {
                    out.push(n)
                }
            }
        },
        Tag.List(list) => {
            for one in list {
                for n in item_ids(one, items) {
                    out.push(n)
                }
            }
        },
        _ => {},
    }
    return out
}

// The identifier `s`, or `none` where it isn't one.
fn parsed(s: String) -> Identifier? {
    return match Identifier.parse(s) {
        ok(id) => some(id),
        err(_) => none,
    }
}

// `ids` each once, in order of their IDs, as a set of them, which `Set.copyOf` makes, has no
// order to keep.
fn distinct(ids: List<i32>) -> List<i32> {
    var sorted = ids.copy()
    sorted.sort()
    var out = List<i32>()
    for n in sorted {
        if out.is_empty() or out[out.len() - 1] != n {
            out.push(n)
        }
    }
    return out
}

// The ingredient `ingredient` as `Ingredient.CONTENTS_STREAM_CODEC` writes it, a holder set of
// items: 0 and a tag's ID, or how many items there are plus one and each's network ID.
fn write_ingredient(ingredient: Tag, items: Registry, w: mut Writer) {
    match ingredient {
        Tag.Str(s) => {
            if s.starts_with("#") {
                w.varint(0)
                w.string(s[1..], 32767)
                return
            }
        },
        _ => {},
    }
    let ids = item_ids(ingredient, items)
    w.varint(i32.wrap(ids.len()) + 1)
    for n in ids {
        w.varint(n)
    }
}

// What a recipe makes, the template `result`, as `SlotDisplay.STREAM_CODEC` writes an
// `ItemStackSlotDisplay`, its item, its count and its components.
fn write_display(result: Tag, streams: Streams, r: Registries, w: mut Writer) {
    let count = match field(result, "count") {
        Tag.Int(n) => n,
        _ => 1,
    }
    write_stack_display(text(field(result, "id")), count, field(result, "components"), streams, r, mut w)
}

// An `ItemStackSlotDisplay` of `count` of the item `item`, a whole ID, with the patch
// `components`: the slot display type's network ID, then the template as
// `ItemStackTemplate.STREAM_CODEC` writes it, its item, its count and its patch.
fn write_stack_display(item: String, count: i32, components: Tag, streams: Streams, r: Registries, w: mut Writer) {
    slot_kind(r, "item_stack", mut w)
    let item_id = network_id(r, String("minecraft:item"), item.copy()) else {
        w.refuse("no item {item}")
        return
    }
    w.varint(item_id)
    w.varint(count)
    var patch = List<(String, Tag, Json)>()
    match components {
        Tag.Compound(m) => {
            for (k, v) in m {
                patch.push((k.copy(), v.copy(), Json.Null))
            }
        },
        _ => {},
    }
    streams.write_patch(patch, r, mut w)
}

// The field `key` of the compound `value`, or `Tag.End` where it has none.
fn field(value: Tag, key: str) -> Tag {
    match value {
        Tag.Compound(m) => {
            if m.contains(String(key)) {
                return m[String(key)].copy()
            }
        },
        _ => {},
    }
    return Tag.End
}

// The text of the string tag `t`, or nothing.
fn text(t: Tag) -> String {
    return match t {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}
