/// The server's recipes, as vanilla's `RecipeManager` holds them once its resources load
/// (CAL-146): each recipe of the `recipe` registry, in its order, with what its codec read, and
/// what `finalizeRecipeLoading` makes of them for clients: the property sets, the items a
/// furnace, a smithing table or a brewing stand takes in each of its slots, and the stonecutter's
/// recipes, each input and what it makes, which `update_recipes` sends every player as they join.
/// A recipe that isn't special and has an ingredient of no items, an empty tag's, is left out of
/// them, with vanilla's warning. Every item is taken to be enabled, as Calcite has no features
/// that turn items off.
///
/// The crafting recipes are kept too with their ingredients' items, `Crafting`, which
/// `world.crafting` matches a grid against (CAL-147).
module world.recipes

import json.tree.{Json}
import nbt.tag.{Accounter, Tag, read_any}
import protocol.wire.{DecodeError, Reader, Wire, Writer}
import registry.recipes.{characters, shrunk}
import registry.registries.{Registries}
import registry.registry.{Registry}
import registry.streams.{Streams, network_id}
import resources.identifier.{Identifier}
import server.log.{Entry}

/// A recipe: its ID, the serializer its `type` names, and its value as its codec read it.
pub struct Recipe {
    pub id: Identifier
    pub kind: String
    pub value: Tag
}

/// The recipes, and what clients are sent of them.
pub struct Recipes {
    pub all: List<Recipe> = List<Recipe>()
    /// Each property set's key and its items' network IDs, in order, as
    /// `getSynchronizedItemProperties` gives them.
    pub item_sets: List<(Identifier, List<i32>)> = List<(Identifier, List<i32>)>()
    /// The stonecutter's recipes, as `update_recipes` sends them.
    pub stonecutter: Stonecutting = Stonecutting()
    /// The crafting recipes, `RecipeType.CRAFTING`'s, in the registry's order, as `RecipeMap`
    /// lists them for a grid to be matched against (CAL-147).
    pub crafting: List<Crafting> = List<Crafting>()
}

/// An ingredient, as `Ingredient` tests a stack: the items it holds, by their whole IDs.
pub struct Ingredient {
    pub items: Set<String> = Set<String>()
}

impl Ingredient {
    /// `Ingredient.test`: whether `stack` is of one of its items, which nothing isn't.
    pub fn test(self, stack: Tag?) -> bool {
        match stack {
            some(Tag.Compound(m)) => {
                if not m.contains(String("id")) {
                    return false
                }
                return match m[String("id")] {
                    Tag.Str(id) => self.items.contains(id),
                    _ => false,
                }
            },
            _ => return false,
        }
    }

    /// Whether it holds no items, as an empty tag's doesn't, `Ingredient.isEmpty`.
    pub fn is_empty(self) -> bool {
        return self.items.is_empty()
    }
}

/// A smelting recipe as `SmeltItemFunction` matches a stack against it (D436): its ingredient,
/// and what it makes, `result`, as `ItemStackTemplate`'s codec writes it.
pub struct Smelting {
    pub input: Ingredient
    pub result: Tag
}

/// The smelting recipes of `r`'s `recipe` registry, `RecipeType.SMELTING`'s, in the registry's
/// order, as `RecipeMap` lists them for `getRecipeFor`, but those it leaves out as impossible to
/// place, an ingredient of no items (D436).
pub fn smelting_of(r: Registries) -> List<Smelting> {
    let at = r.find_reloadable(String("recipe")) else return List<Smelting>()
    let i = r.find_builtin(String("item")) else return List<Smelting>()
    return smelting_in(r.reloadable[at], r.builtin[i])
}

// The smelting recipes of `registry`, against the item registry `items`.
fn smelting_in(registry: Registry, items: Registry) -> List<Smelting> {
    var out = List<Smelting>()
    for k in 0..registry.entries.len() {
        if k >= registry.contents.len() {
            break
        }
        var pos: usize = 0
        var accounter = Accounter.unlimited()
        let value = match read_any(registry.contents[k], mut pos, mut accounter) {
            ok(v) => v,
            err(_) => continue,
        }
        let kind = text(field(value, "type"))
        if kind != "minecraft:smelting" {
            continue
        }
        let recipe = Recipe { id: registry.entries[k].copy(), kind: kind, value: value }
        if not placeable(recipe, items) {
            continue
        }
        out.push(Smelting { input: ingredient_of(field(recipe.value, "ingredient"), items), result: field(recipe.value, "result") })
    }
    return out
}

/// A crafting recipe as a grid is matched against it (CAL-147): its place in `Recipes.all`, its
/// serializer, and its ingredients with their items. A shaped one's pattern, shrunk, is `width`
/// by `height` cells, each the place of its symbol's ingredient in `ingredients` or -1 for a
/// space; a shapeless one's ingredients are `ingredients`; the other kinds' are by their fields'
/// names in `parts`, a firework star's shapes as `shape:` and the shape.
pub struct Crafting {
    pub at: usize
    pub kind: String
    pub width: usize = 0
    pub height: usize = 0
    pub cells: List<i32> = List<i32>()
    pub ingredients: List<Ingredient> = List<Ingredient>()
    pub parts: List<(String, Ingredient)> = List<(String, Ingredient)>()
}

impl Crafting {
    /// Whether the ingredient of the field `name` takes `stack`, which one it hasn't doesn't.
    pub fn tests(self, name: str, stack: Tag?) -> bool {
        for (n, ingredient) in self.parts {
            if n == String(name) {
                return ingredient.test(stack)
            }
        }
        return false
    }

    /// Whether it has the field `name`.
    pub fn has_part(self, name: str) -> bool {
        for (n, _) in self.parts {
            if n == String(name) {
                return true
            }
        }
        return false
    }
}

/// The stonecutter's recipes, vanilla's `SelectableRecipe.SingleInputSet`, written with the
/// registries as `SingleInputSet.noRecipeCodec` writes them: how many, then each input as
/// `Ingredient.CONTENTS_STREAM_CODEC` writes it and what it makes as a `SlotDisplay`. A
/// packet's `Wire` has no registries, so `Recipes.of` writes them. Nothing written is none.
pub struct Stonecutting {
    bytes: List<u8> = List<u8>()
    // Why they couldn't be written, an item or a slot display the registries don't have, which
    // only a broken build gives, and which stops the packet as an encoder's exception does.
    problem: String? = none
}

/// The stonecutter's recipes as a packet holds them. Ones there are can only be read with the
/// registries, which a packet's `Wire` hasn't, so only none read.
impl Wire for Stonecutting {
    fn read(r: mut Reader) -> Stonecutting ! DecodeError {
        if try r.varint() != 0 {
            fail DecodeError { message: String("the stonecutter's recipes are read with the registries") }
        }
        return Stonecutting()
    }

    fn write(self, w: mut Writer) {
        if let p = self.problem {
            w.refuse(p.copy())
            return
        }
        if self.bytes.is_empty() {
            w.varint(0)
            return
        }
        w.raw(self.bytes)
    }
}

impl Recipes {
    /// The recipes of `r`'s `recipe` registry, and what clients are sent of them, written with
    /// `streams`, with a warning in `logs` for each left out for an ingredient of no items.
    pub fn of(r: Registries, streams: Streams, logs: mut List<Entry>) -> Recipes {
        let at = r.find_reloadable(String("recipe")) else return Recipes()
        let i = r.find_builtin(String("item")) else return Recipes()
        return made(r.reloadable[at], r.builtin[i], r, streams, mut logs)
    }
}

// The recipes of `registry`, with what clients are sent of them, against the item registry
// `items`.
fn made(registry: Registry, items: Registry, r: Registries, streams: Streams, logs: mut List<Entry>) -> Recipes {
    var out = Recipes()
    for k in 0..registry.entries.len() {
        if k >= registry.contents.len() {
            break
        }
        var pos: usize = 0
        var accounter = Accounter.unlimited()
        let value = match read_any(registry.contents[k], mut pos, mut accounter) {
            ok(v) => v,
            err(_) => continue,
        }
        let kind = text(field(value, "type"))
        if kind.starts_with("minecraft:crafting_") {
            out.crafting.push(crafting_of(out.all.len(), kind, value, items))
        }
        out.all.push(Recipe { id: registry.entries[k].copy(), kind: kind, value: value })
    }
    // The property sets' ingredients, by set, in `RECIPE_PROPERTY_SETS`' order, and the
    // stonecutter's recipes, from each recipe that can be placed, in the registry's order.
    let keys: List<String> = ["smithing_base", "smithing_template", "smithing_addition", "furnace_input", "blast_furnace_input", "smoker_input", "campfire_input", "brewing_input", "brewing_reagent"]
    var sets = List<List<i32>>()
    for _ in keys {
        sets.push(List<i32>())
    }
    var cut = Writer.new()
    var cuts: i32 = 0
    var entries = Writer.new()
    for recipe in out.all {
        if not special(recipe.kind) and not placeable(recipe, items) {
            logs.push(Entry.warn("Recipe {recipe.id.to_string()} can't be placed due to empty ingredients and will be ignored"))
            continue
        }
        for s in 0..keys.len() {
            let input = property_input(recipe, keys[s]) else continue
            for id in item_ids(input, items) {
                sets[s].push(id)
            }
        }
        if recipe.kind == "minecraft:stonecutting" {
            write_ingredient(field(recipe.value, "ingredient"), items, mut entries)
            write_display(field(recipe.value, "result"), streams, r, mut entries)
            cuts += 1
        }
    }
    for s in 0..keys.len() {
        out.item_sets.push((Identifier { namespace: "minecraft", path: keys[s].copy() }, distinct(sets[s])))
    }
    cut.varint(cuts)
    let problem = entries.problem()
    cut.raw(entries.into_bytes())
    out.stonecutter = Stonecutting { bytes: cut.into_bytes(), problem: problem }
    return out
}

// The crafting recipe at `at` of the serializer `kind`, `value`, with its ingredients' items.
fn crafting_of(at: usize, kind: String, value: Tag, items: Registry) -> Crafting {
    var c = Crafting { at: at, kind: kind.copy() }
    if kind == "minecraft:crafting_shaped" {
        var symbols = List<String>()
        match field(value, "key") {
            Tag.Compound(key) => {
                for (symbol, ingredient) in key {
                    symbols.push(symbol.copy())
                    c.ingredients.push(ingredient_of(ingredient, items))
                }
            },
            _ => {},
        }
        var lines = List<String>()
        match field(value, "pattern") {
            Tag.List(rows) => {
                for row in rows {
                    lines.push(text(row))
                }
            },
            _ => {},
        }
        let rows = shrunk(lines)
        c.height = rows.len()
        for row in rows {
            let cells = characters(row)
            c.width = cells.len()
            for cell in cells {
                var place: i32 = -1
                for i in 0..symbols.len() {
                    if symbols[i] == cell {
                        place = i32.wrap(i)
                    }
                }
                c.cells.push(place)
            }
        }
        return c
    }
    if kind == "minecraft:crafting_shapeless" {
        match field(value, "ingredients") {
            Tag.List(list) => {
                for ingredient in list {
                    c.ingredients.push(ingredient_of(ingredient, items))
                }
            },
            _ => {},
        }
        return c
    }
    for name in ["input", "material", "target", "dye", "source", "back", "left", "right", "front", "map", "shell", "fuel", "star", "trail", "twinkle", "banner"] {
        let ingredient = field(value, name)
        match ingredient {
            Tag.End => {},
            _ => c.parts.push((String(name), ingredient_of(ingredient, items))),
        }
    }
    match field(value, "shapes") {
        Tag.Compound(shapes) => {
            for (shape, ingredient) in shapes {
                c.parts.push(("shape:{shape}", ingredient_of(ingredient, items)))
            }
        },
        _ => {},
    }
    return c
}

// The ingredient `ingredient`, as its codec writes it, with its items' whole IDs.
fn ingredient_of(ingredient: Tag, items: Registry) -> Ingredient {
    var out = Ingredient()
    for n in item_ids(ingredient, items) {
        if n >= 0 and usize.wrap(n) < items.entries.len() {
            out.items.insert(items.entries[usize.wrap(n)].to_string())
        }
    }
    return out
}

// Whether the recipe of the serializer `kind` is special, as `Recipe.isSpecial` has it: a
// `CustomRecipe`'s or a brewing recipe's, which the recipe book doesn't show and which needn't be
// placeable.
fn special(kind: String) -> bool {
    return kind.starts_with("minecraft:crafting_special_") or kind == "minecraft:crafting_decorated_pot" or kind == "minecraft:brewing"
}

// Whether each of the ingredients a recipe's `PlacementInfo` has holds an item: a shaped
// recipe's key's, a shapeless one's list's, and the other kinds' named ones.
fn placeable(recipe: Recipe, items: Registry) -> bool {
    if recipe.kind == "minecraft:crafting_shaped" {
        match field(recipe.value, "key") {
            Tag.Compound(key) => {
                for (_, ingredient) in key {
                    if item_ids(ingredient, items).is_empty() {
                        return false
                    }
                }
            },
            _ => {},
        }
        return true
    }
    if recipe.kind == "minecraft:crafting_shapeless" {
        match field(recipe.value, "ingredients") {
            Tag.List(list) => {
                for ingredient in list {
                    if item_ids(ingredient, items).is_empty() {
                        return false
                    }
                }
            },
            _ => {},
        }
        return true
    }
    for name in ["ingredient", "input", "material", "target", "dye", "source", "template", "base", "addition"] {
        let ingredient = field(recipe.value, name)
        match ingredient {
            Tag.End => {},
            _ => {
                if item_ids(ingredient, items).is_empty() {
                    return false
                }
            },
        }
    }
    return true
}

// The ingredient of `recipe` that goes in the property set `key`, if it gives one, as each of
// `RECIPE_PROPERTY_SETS`' extractors finds it.
fn property_input(recipe: Recipe, key: String) -> Tag? {
    let smithing = recipe.kind == "minecraft:smithing_transform" or recipe.kind == "minecraft:smithing_trim"
    let input = if key == "smithing_base" and smithing {
        field(recipe.value, "base")
    } else if key == "smithing_template" and smithing {
        field(recipe.value, "template")
    } else if key == "smithing_addition" and smithing {
        field(recipe.value, "addition")
    } else if key == "furnace_input" and recipe.kind == "minecraft:smelting" {
        field(recipe.value, "ingredient")
    } else if key == "blast_furnace_input" and recipe.kind == "minecraft:blasting" {
        field(recipe.value, "ingredient")
    } else if key == "smoker_input" and recipe.kind == "minecraft:smoking" {
        field(recipe.value, "ingredient")
    } else if key == "campfire_input" and recipe.kind == "minecraft:campfire_cooking" {
        field(recipe.value, "ingredient")
    } else if key == "brewing_input" and recipe.kind == "minecraft:brewing" {
        field(field(recipe.value, "input"), "item")
    } else if key == "brewing_reagent" and recipe.kind == "minecraft:brewing" {
        field(field(recipe.value, "reagent"), "item")
    } else {
        Tag.End
    }
    return match input {
        Tag.End => none,
        _ => some(input),
    }
}

/// The network IDs of the items the ingredient `ingredient` holds, as its codec writes it: a tag
/// of items as `#` and its ID, an item's ID, or a list of them, in their order.
pub fn item_ids(ingredient: Tag, items: Registry) -> List<i32> {
    var out = List<i32>()
    match ingredient {
        Tag.Str(s) => {
            if s.starts_with("#") {
                if let id = parsed(s[1..]) {
                    return items.tag_ids(id)
                }
            } else if let id = parsed(s) {
                if let n = items.id(id) {
                    out.push(n)
                }
            }
        },
        Tag.List(list) => {
            for one in list {
                for n in item_ids(one, items) {
                    out.push(n)
                }
            }
        },
        _ => {},
    }
    return out
}

// The identifier `s`, or `none` where it isn't one.
fn parsed(s: String) -> Identifier? {
    return match Identifier.parse(s) {
        ok(id) => some(id),
        err(_) => none,
    }
}

// `ids` each once, in order of their IDs, as a set of them, which `Set.copyOf` makes, has no
// order to keep.
fn distinct(ids: List<i32>) -> List<i32> {
    var sorted = ids.copy()
    sorted.sort()
    var out = List<i32>()
    for n in sorted {
        if out.is_empty() or out[out.len() - 1] != n {
            out.push(n)
        }
    }
    return out
}

// The ingredient `ingredient` as `Ingredient.CONTENTS_STREAM_CODEC` writes it, a holder set of
// items: 0 and a tag's ID, or how many items there are plus one and each's network ID.
fn write_ingredient(ingredient: Tag, items: Registry, w: mut Writer) {
    match ingredient {
        Tag.Str(s) => {
            if s.starts_with("#") {
                w.varint(0)
                w.string(s[1..], 32767)
                return
            }
        },
        _ => {},
    }
    let ids = item_ids(ingredient, items)
    w.varint(i32.wrap(ids.len()) + 1)
    for n in ids {
        w.varint(n)
    }
}

// What a stonecutter makes, the template `result`, as `SlotDisplay.STREAM_CODEC` writes an
// `ItemStackSlotDisplay`: the slot display type's network ID, then the template as
// `ItemStackTemplate.STREAM_CODEC` writes it, its item, its count and its patch.
fn write_display(result: Tag, streams: Streams, r: Registries, w: mut Writer) {
    let display = network_id(r, String("minecraft:slot_display"), String("minecraft:item_stack")) else {
        w.refuse(String("no slot display minecraft:item_stack"))
        return
    }
    w.varint(display)
    let item = text(field(result, "id"))
    let item_id = network_id(r, String("minecraft:item"), item.copy()) else {
        w.refuse("no item {item}")
        return
    }
    w.varint(item_id)
    let count = match field(result, "count") {
        Tag.Int(n) => n,
        _ => 1,
    }
    w.varint(count)
    var components = List<(String, Tag, Json)>()
    match field(result, "components") {
        Tag.Compound(patch) => {
            for (k, v) in patch {
                components.push((k.copy(), v.copy(), Json.Null))
            }
        },
        _ => {},
    }
    streams.write_patch(components, r, mut w)
}

// The field `key` of the compound `value`, or `Tag.End` where it has none.
fn field(value: Tag, key: str) -> Tag {
    match value {
        Tag.Compound(m) => {
            if m.contains(String(key)) {
                return m[String(key)].copy()
            }
        },
        _ => {},
    }
    return Tag.End
}

// The text of the string tag `t`, or nothing.
fn text(t: Tag) -> String {
    return match t {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}
