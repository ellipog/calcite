/// Shelves joined side by side (CAL-124): `SideChainPartBlock`, as a powered wooden shelf joins
/// the powered ones facing the same way beside it, to its left and right as it faces, three to a
/// chain at most, each one's `side_chain` saying which sides it's joined on; and `ShelfBlock`'s
/// hooks, a shelf joining or letting go of its neighbours as it's set powered or not, a signal
/// powering it with its sound, and its removal letting go of them.
module world.shelves

import world.block_level.{BlockLevel}
import world.level_writer.{UPDATE_LIMIT}
import world.pos.{BlockPos}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, clockwise, opposite, step_x, step_z}
import worldgen.interval.{Thrown}
import worldgen.signals.{has_neighbour_signal}
import worldgen.survive.{facing_of}

// `SideChainPart`'s values, by their ordinals, and a chain's most shelves,
// `ShelfBlock.getMaxChainLength`.
const UNCONNECTED: i32 = 0
const RIGHT: i32 = 1
const CENTER: i32 = 2
const LEFT: i32 = 3
const MAX_CHAIN: i32 = 3

fn part_name(p: i32) -> String {
    let names: List<str> = ["unconnected", "right", "center", "left"]
    return String(names[usize.wrap(p)])
}

fn part_of(f: Facts, state: u32) -> i32 {
    let name = f.get_name(state, "side_chain") ?? String("unconnected")
    for p in 0..4 {
        if name == part_name(p) {
            return p
        }
    }
    return UNCONNECTED
}

// `whenConnectedToTheRight` and the others.
fn connected_to_right(p: i32) -> i32 {
    return if p == UNCONNECTED or p == LEFT { LEFT } else { CENTER }
}

fn connected_to_left(p: i32) -> i32 {
    return if p == UNCONNECTED or p == RIGHT { RIGHT } else { CENTER }
}

fn disconnected_from_right(p: i32) -> i32 {
    return if p == UNCONNECTED or p == LEFT { UNCONNECTED } else { RIGHT }
}

fn disconnected_from_left(p: i32) -> i32 {
    return if p == UNCONNECTED or p == RIGHT { UNCONNECTED } else { LEFT }
}

// `ShelfBlock.isConnectable`: a powered wooden shelf.
fn connectable(f: Facts, state: u32) -> bool {
    return f.in_set(state, f.tag("minecraft:wooden_shelves")) and f.has(state, "powered") and f.get_bool(state, "powered")
}

// A shelf beside the one at the middle of a chain, as `Neighbors` reads it: its place, and its part
// where it's a powered shelf facing the same way, `SideChainNeighbor`, else -1, `EmptyNeighbor`.
struct Neighbour {
    x: i32
    y: i32
    z: i32
    part: i32
}

// The neighbour `i` along from x, y, z to the left of `facing`, clockwise of it, or to the right.
fn beside<L: BlockAccess>(f: Facts, level: L, facing: i32, x: i32, y: i32, z: i32, i: i32, left: bool) -> Neighbour ! Thrown {
    let d = if left { clockwise(facing) } else { opposite(clockwise(facing)) }
    let nx = x + step_x(d) * i
    let nz = z + step_z(d) * i
    let s = try level.state(f, nx, y, nz)
    var part = -1
    if connectable(f, s) and try facing_of(f, s) == facing {
        part = part_of(f, s)
    }
    return Neighbour { x: nx, y: y, z: nz, part: part }
}

// `getAllBlocksConnectedTo(level, pos).size()`: the shelf at x, y, z and those joined to it
// either way, none where it's not a powered shelf.
fn chain_length<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    return i32.wrap((try chain_of(f, level, x, y, z)).len())
}

/// `getAllBlocksConnectedTo`: the shelf at x, y, z and those joined to it either way, from its
/// chain's left end to its right as it faces (CAL-143); none where it's not a powered shelf.
pub fn chain_of<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> List<BlockPos> ! Thrown {
    var out = List<BlockPos>()
    let s = try level.state(f, x, y, z)
    if not connectable(f, s) {
        return out
    }
    let facing = try facing_of(f, s)
    var lefts = List<BlockPos>()
    var rights = List<BlockPos>()
    let sides: List<bool> = [true, false]
    for left in sides {
        // `addBlocksConnectingTowards`: on while each joins toward the middle, `isConnectionTowards`,
        // stopping past a chain's end, `isUnconnectableOrChainEnd`.
        let towards = if left { LEFT } else { RIGHT }
        var i = 1
        while i < MAX_CHAIN {
            let n = try beside(f, level, facing, x, y, z, i, left)
            if n.part >= 0 and (n.part == CENTER or n.part == towards) {
                if left {
                    lefts.push(BlockPos { x: n.x, y: n.y, z: n.z })
                } else {
                    rights.push(BlockPos { x: n.x, y: n.y, z: n.z })
                }
            }
            if n.part < 0 or n.part != CENTER {
                break
            }
            i += 1
        }
    }
    // Those to the left go in front, each in front of the last, `addFirst`.
    var i = lefts.len()
    while i > 0 {
        i -= 1
        out.push(lefts[i])
    }
    out.push(BlockPos { x: x, y: y, z: z })
    for r in rights {
        out.push(r)
    }
    return out
}

// `setPart`: the shelf at x, y, z given the part `p`, set with flags 3 where it changes.
fn set_part<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32, p: i32) ! Thrown {
    let s = try level.state(f, x, y, z)
    if part_of(f, s) != p {
        _ = level.set_block_limited(x, y, z, try f.with_name(s, "side_chain", part_name(p)), 3, UPDATE_LIMIT)
    }
}

// `updateSelfAndNeighborsOnPoweringUp`: unless a neighbour joining it set it, a powered shelf
// joins the chain to its left where the two fit in three, then the one to its right where all do.
fn powering_up<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, old: u32) ! Thrown {
    if not connectable(f, state) {
        return
    }
    // `isBeingUpdatedByNeighbor`.
    if part_of(f, state) != UNCONNECTED or (connectable(f, old) and part_of(f, old) != UNCONNECTED) {
        return
    }
    let facing = try facing_of(f, state)
    let l = try beside(f, level, facing, x, y, z, 1, true)
    let left_count = if l.part >= 0 { try chain_length(f, level, l.x, l.y, l.z) } else { 0 }
    let r = try beside(f, level, facing, x, y, z, 1, false)
    let right_count = if r.part >= 0 { try chain_length(f, level, r.x, r.y, r.z) } else { 0 }
    var part = UNCONNECTED
    var total = 1
    // `canConnect`.
    if left_count > 0 and total + left_count <= MAX_CHAIN {
        part = connected_to_left(part)
        try set_part(f, mut level, l.x, l.y, l.z, connected_to_right(l.part))
        total += left_count
    }
    if right_count > 0 and total + right_count <= MAX_CHAIN {
        part = connected_to_right(part)
        try set_part(f, mut level, r.x, r.y, r.z, connected_to_left(r.part))
    }
    try set_part(f, mut level, x, y, z, part)
}

/// `updateNeighborsAfterPoweringDown`: the shelf `state` at x, y, z lets go of the shelf to its
/// left, then of the one to its right.
pub fn powering_down<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let facing = try facing_of(f, state)
    let l = try beside(f, level, facing, x, y, z, 1, true)
    if l.part >= 0 {
        try set_part(f, mut level, l.x, l.y, l.z, disconnected_from_right(l.part))
    }
    let r = try beside(f, level, facing, x, y, z, 1, false)
    if r.part >= 0 {
        try set_part(f, mut level, r.x, r.y, r.z, disconnected_from_left(r.part))
    }
}

/// `ShelfBlock.onPlace`, as any state of it's set: a powered one joins its neighbours, and
/// another lets go of them.
pub fn shelf_placed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, old: u32) ! Thrown {
    if f.get_bool(state, "powered") {
        try powering_up(f, mut level, state, x, y, z, old)
    } else {
        try powering_down(f, mut level, state, x, y, z)
    }
}

/// `ShelfBlock.neighborChanged`: set powered or not with flags 3 as that changes, a shelf let go
/// unjoined, with its sound at full volume and pitch.
pub fn shelf_neighbour_changed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let powered = try has_neighbour_signal(f, level, x, y, z, true)
    if f.get_bool(state, "powered") == powered {
        return
    }
    var next = try f.with_bool(state, "powered", powered)
    if not powered {
        next = try f.with_name(next, "side_chain", part_name(UNCONNECTED))
    }
    _ = level.set_block_limited(x, y, z, next, 3, UPDATE_LIMIT)
    level.play_sound(x, y, z, if powered { "block.shelf.activate" } else { "block.shelf.deactivate" }, 1.0f32, 1.0f32)
}
