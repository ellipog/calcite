/// A lightning bolt, vanilla's `LightningBolt` (CAL-326): 0 by 0, with only `Entity`'s values, never
/// saved, `noSave`, and nothing hurts it, `hurtServer`. As it's made it draws its seed, which its
/// clients draw its shape from, and its flashes, 1 to 3, from its own random. It strikes as it first
/// ticks, which its level does: fire at it, and at 4 more places about it on normal and hard, its
/// lightning rod struck, copper about it scraped and the `lightning_strike` game event. Then it
/// lasts 2 ticks, and each flash after another 2, coming 0 to 9 ticks after the last ends, each
/// setting fire at it again, until it has none left and is gone, its viewers told,
/// `lightning_strike`. While it lasts, what's alive in its box, 3 about it and 6 more up, is struck,
/// `thunderHit`, each tick, unless it's only for show, `visualOnly`. Its level sends it as
/// `ClientboundAddEntityPacket` does, seen 16 chunks off, never updated, `updateInterval`
/// `Integer.MAX_VALUE`.
module world.lightning

import nbt.tag.{Tag}

import world.body.{Body}
import world.entity_data.{EntityData, SILENT, knot_data}

/// What a bolt does this tick that its level does.
pub struct BoltTick {
    /// It strikes, its first tick: fire, its rod, copper and its game event.
    pub strike: bool = false
    /// A flash comes, which sets fire at it again, `spawnFire(0)`.
    pub flash: bool = false
    /// What's alive in its box is struck.
    pub hits: bool = false
    /// It's gone, its viewers told, `LIGHTNING_STRIKE`.
    pub gone: bool = false
}

/// A lightning bolt.
pub struct LightningBolt {
    pub body: Body
    pub data: EntityData
    /// Its ticks left of its flash, `life`.
    pub life: i32 = 2
    /// What its shape's drawn from, `seed`.
    pub seed: i64 = 0
    /// Its flashes left, `flashes`.
    pub flashes: i32 = 1
    /// Whether it's only for show, `visualOnly`: no fire and nothing struck.
    pub visual_only: bool = false
    /// The player whose trident brought it, by entity ID, `cause`, told what it struck,
    /// `channeled_lightning`.
    pub cause: i32? = none
    /// What it's struck, by entity ID, `hitEntities`.
    pub struck: List<i32> = []
    /// How many fires it set, `blocksSetOnFire`.
    pub fires: i32 = 0
}

impl LightningBolt {
    /// A bolt at x, y, z, `LightningBolt(type, level)`: `Entity`'s fields, its random first, then
    /// its UUID; then its seed and its flashes from its random; then its place, `moveTo`.
    pub fn made(id: i32, seed: i64, x: f64, y: f64, z: f64) -> LightningBolt {
        var body = Body.made(id, seed, x, y, z, 0.0f32, 0.0f32, 0.0f32, 0.0)
        let shape = body.random.next_long()
        let flashes = body.random.next_int_below(3) + 1
        body.needs_sync = true
        return LightningBolt { body: body, data: knot_data(), seed: shape, flashes: flashes }
    }

    /// Its tick, `LightningBolt.tick`, at the level's bottom `min_y`: gone below the world, as
    /// `Entity.baseTick` has it; it strikes as its life is 2; then its life runs down, and once it's
    /// out, it's gone where it has no flashes left, else, at a tick 0 to 9 after, drawn each tick,
    /// a flash comes, its life 1 again and its seed new; and while its life lasts, it strikes what's
    /// in its box.
    pub fn tick(mut self, min_y: i32) -> BoltTick {
        var out = BoltTick()
        self.body.tick_count += 1
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
            return out
        }
        if self.life == 2 {
            out.strike = true
        }
        self.life -= 1
        if self.life < 0 {
            if self.flashes == 0 {
                out.gone = true
                self.body.removed = true
            } else if self.life < -self.body.random.next_int_below(10) {
                self.flashes -= 1
                self.life = 1
                self.seed = self.body.random.next_long()
                out.flash = true
            }
        }
        if self.life >= 0 and not self.visual_only {
            out.hits = true
        }
        return out
    }

    /// Where one more fire goes about `x`, `y`, `z`, `spawnFire`'s offsets, each of -1 to 1 drawn
    /// from its random, x, then y, then z.
    pub fn fire_about(mut self, x: i32, y: i32, z: i32) -> (i32, i32, i32) {
        let dx = self.body.random.next_int_below(3) - 1
        let dy = self.body.random.next_int_below(3) - 1
        let dz = self.body.random.next_int_below(3) - 1
        return (x + dx, y + dy, z + dz)
    }

    /// What it would be saved as, `saveWithoutId` with its type, which `data get` reads: what every
    /// entity saves, and nothing of its own, `addAdditionalSaveData`. Its chunk never saves it.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:lightning_bolt")
        return Tag.Compound(t)
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }
}

/// `Entity.thunderHit`'s fire on what a bolt strikes: its fire ticks one more, and where that's
/// 0, alight for 8 seconds, `igniteForSeconds(8)`. Its hurt, 5 by `lightning_bolt`, its level
/// deals.
pub fn thunder_fire(b: mut Body) {
    b.fire += 1
    if b.fire == 0 {
        b.ignite_for(160)
    }
}

/// What a bolt did this tick that its level does, as `Shown.Bolt` (CAL-326): the bolt by ID,
/// where it is, and what it struck before, with its tick's `strike`, `flash`, `hits` and `gone`.
/// A bolt that's gone has left its level by then, so where it was and what it struck come with it.
pub struct BoltDue {
    pub id: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub strike: bool
    pub flash: bool
    pub hits: bool
    pub gone: bool
    pub struck: List<i32>
}
