/// A grindstone's work, as vanilla's `GrindstoneMenu` does it (CAL-338): what its slots take, what
/// its two stacks make, `computeResult`, mended together where they're the same and their
/// enchantments but the curses taken off, and the experience taking the result gives.
module world.grindstone

import nbt.tag.{Tag}
import registry.codec.{same}
import registry.components.{ItemCodecs}

/// `mayPlace` of its two input slots: what can be damaged, `isDamageableItem`, or has
/// enchantments, `EnchantmentHelper.hasAnyEnchantments`.
pub fn grindable(stack: Tag, items: ItemCodecs) -> bool {
    return damageable(stack, items) or enchanted(stack, items)
}

/// `computeResult(input, additional)`: nothing where both are empty or either is more than one;
/// one alone, where it has enchantments, its curses kept and the rest taken off,
/// `removeNonCursesFrom`; both, mended together, `mergeItems`.
pub fn grind_result(input: Tag?, additional: Tag?, items: ItemCodecs) -> Tag? {
    if input == none and additional == none {
        return none
    }
    if count(input.copy()) > 1 or count(additional.copy()) > 1 {
        return none
    }
    let a = input.copy() else {
        let b = additional.copy() else return none
        return alone(b, items)
    }
    let b = additional.copy() else return alone(a, items)
    return merged(a, b, items)
}

/// `getExperienceAmount`'s sum, before it's halved and drawn: each of `input`'s and
/// `additional`'s enchantments for crafting but the curses, its least cost at its level,
/// `getMinCost`.
pub fn grind_experience(input: Tag?, additional: Tag?, items: ItemCodecs) -> i32 {
    var amount: i32 = 0
    for stack in [input.copy(), additional.copy()] {
        let s = stack.copy() else continue
        for (name, level) in crafting_enchantments(s, items) {
            if items.is_curse(name.copy()) {
                continue
            }
            amount += min_cost(name, level, items)
        }
    }
    return amount
}

// One stack alone: none without enchantments, else its curses kept.
fn alone(stack: Tag, items: ItemCodecs) -> Tag? {
    if not enchanted(stack, items) {
        return none
    }
    return some(without_non_curses(stack, items))
}

// `mergeItems`: none for two items; both's durability left, and a twentieth of the more lasting's,
// in one stack of the more lasting's durability, or two of an item that can't be damaged and
// stacks, where they're the same stack; with the second's enchantments for crafting raised into
// it, a curse only where it hasn't it; then its curses kept.
fn merged(input: Tag, additional: Tag, items: ItemCodecs) -> Tag? {
    if item(input) != item(additional) {
        return none
    }
    let durability = max_damage(input, items).max(max_damage(additional, items))
    let remaining1 = max_damage(input, items) - damage_value(input, items)
    let remaining2 = max_damage(additional, items) - damage_value(additional, items)
    let remaining = remaining1 + remaining2 + durability * 5 / 100
    var n: i32 = 1
    if not damageable(input, items) {
        if items.max_stack_size(input) < 2 or not same(input, additional) {
            return none
        }
        n = 2
    }
    var made = with_count(input, n)
    if damageable(made, items) {
        made = set_component(made, "minecraft:max_damage", Tag.Int(durability), items)
        made = set_damage(made, (durability - remaining).max(0), items)
    }
    let kind = enchantments_type(made)
    if let current = items.component(made, String(kind)) {
        var levels = levels_of(current)
        for (name, level) in crafting_enchantments(additional, items) {
            if not items.is_curse(name.copy()) or level_in(levels, name.copy()) == 0 {
                levels = upgraded(levels, name, level)
            }
        }
        made = set_component(made, kind, Tag.Compound(levels), items)
    }
    return some(without_non_curses(made, items))
}

// `removeNonCursesFrom`: its enchantments but the curses taken off; an enchanted book left with
// none a book, `transmuteCopy`; and its `repair_cost` one step on for each that's left,
// `calculateIncreasedRepairCost` from 0.
fn without_non_curses(stack: Tag, items: ItemCodecs) -> Tag {
    var out = stack.copy()
    let kind = enchantments_type(out)
    var left: usize = 0
    if let current = items.component(out, String(kind)) {
        var kept = JavaHashMap<String, Tag>()
        for (name, level) in levels_of(current) {
            if items.is_curse(name.copy()) {
                kept.insert(name.copy(), level.copy())
            }
        }
        left = kept.len()
        out = set_component(out, kind, Tag.Compound(kept), items)
    }
    if item(out) == "minecraft:enchanted_book" and left == 0 {
        out = with_item(out, "minecraft:book")
    }
    var cost: i32 = 0
    for _ in 0..left {
        cost = cost * 2 + 1
    }
    return set_component(out, "minecraft:repair_cost", Tag.Int(cost), items)
}

// `ItemEnchantments.Mutable.upgrade`: `name` at `level`, kept to 255, where that's more than it has.
fn upgraded(levels: JavaHashMap<String, Tag>, name: String, level: i32) -> JavaHashMap<String, Tag> {
    var out = levels.copy()
    if level <= 0 {
        return out
    }
    let given = level.min(255)
    if given > level_in(levels, name.copy()) {
        out.insert(name.copy(), Tag.Int(given))
    }
    return out
}

fn level_in(levels: JavaHashMap<String, Tag>, name: String) -> i32 {
    if not levels.contains(name.copy()) {
        return 0
    }
    return levels[name].number_int() ?? 0
}

// An enchantments component's levels, by their names.
fn levels_of(t: Tag) -> JavaHashMap<String, Tag> {
    return match t {
        Tag.Compound(m) => m.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

// `getEnchantmentsForCrafting`: an enchanted book's `stored_enchantments`, anything else's
// `enchantments`, each by its name with its level.
fn crafting_enchantments(stack: Tag, items: ItemCodecs) -> List<(String, i32)> {
    var out = List<(String, i32)>()
    let found = items.component(stack, String(enchantments_type(stack))) else return out
    for (name, level) in levels_of(found) {
        out.push((name.copy(), level.number_int() ?? 0))
    }
    return out
}

// `EnchantmentHelper.getComponentType`.
fn enchantments_type(stack: Tag) -> str {
    return if item(stack) == "minecraft:enchanted_book" { "minecraft:stored_enchantments" } else { "minecraft:enchantments" }
}

// `hasAnyEnchantments`: some `enchantments` or `stored_enchantments`.
fn enchanted(stack: Tag, items: ItemCodecs) -> bool {
    for kind in ["minecraft:enchantments", "minecraft:stored_enchantments"] {
        if let found = items.component(stack, String(kind)) {
            if not levels_of(found).is_empty() {
                return true
            }
        }
    }
    return false
}

// `getMinCost` of the enchantment `name` at `level`, its definition's `min_cost`, `base` and
// `per_level_above_first`.
fn min_cost(name: String, level: i32, items: ItemCodecs) -> i32 {
    let definition = items.enchantment_definition(name) else return 0
    if not definition.contains("min_cost") {
        return 0
    }
    let Tag.Compound(cost) = definition["min_cost"] else return 0
    let base = if cost.contains("base") { cost["base"].number_int() ?? 0 } else { 0 }
    let per = if cost.contains("per_level_above_first") { cost["per_level_above_first"].number_int() ?? 0 } else { 0 }
    return base + per * (level - 1)
}

// `isDamageableItem`: a `max_damage` and a `damage`, and not `unbreakable`.
fn damageable(stack: Tag, items: ItemCodecs) -> bool {
    return items.component(stack, String("minecraft:max_damage")) != none and items.component(stack, String("minecraft:unbreakable")) == none and items.component(stack, String("minecraft:damage")) != none
}

// `getMaxDamage`.
fn max_damage(stack: Tag, items: ItemCodecs) -> i32 {
    return match items.component(stack, String("minecraft:max_damage")) {
        some(t) => t.number_int() ?? 0,
        none => 0,
    }
}

// `getDamageValue`: its `damage`, kept from 0 to its most.
fn damage_value(stack: Tag, items: ItemCodecs) -> i32 {
    let d = match items.component(stack, String("minecraft:damage")) {
        some(t) => t.number_int() ?? 0,
        none => 0,
    }
    return d.max(0).min(max_damage(stack, items))
}

// `setDamageValue`: kept from 0 to its most.
fn set_damage(stack: Tag, damage: i32, items: ItemCodecs) -> Tag {
    return set_component(stack, "minecraft:damage", Tag.Int(damage.max(0).min(max_damage(stack, items))), items)
}

/// `ItemStack.set`: `stack` with the component `name`, a whole ID, set to `value` in its patch,
/// or out of it where that's its item's own, as `PatchedDataComponentMap.set` leaves it.
pub fn set_component(stack: Tag, name: str, value: own Tag, items: ItemCodecs) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    var patch = JavaHashMap<String, Tag>()
    if m.contains("components") {
        if let Tag.Compound(p) = m["components"].copy() {
            patch = p
        }
    }
    _ = patch.remove("!{name}")
    let own_value = items.default_component(item(stack), String(name))
    let is_own = match own_value {
        some(d) => same(d, value),
        none => false,
    }
    if is_own {
        _ = patch.remove(String(name))
    } else {
        patch.insert(String(name), value)
    }
    if patch.is_empty() {
        _ = out.remove(String("components"))
    } else {
        out.insert(String("components"), Tag.Compound(patch))
    }
    return Tag.Compound(out)
}

fn item(stack: Tag) -> String {
    let Tag.Compound(m) = stack else return String("minecraft:air")
    if not m.contains("id") {
        return String("minecraft:air")
    }
    return match m["id"].copy() {
        Tag.Str(s) => s,
        _ => String("minecraft:air"),
    }
}

fn with_item(stack: Tag, id: str) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("id"), Tag.Str(String(id)))
    return Tag.Compound(out)
}

fn count(stack: Tag?) -> i32 {
    let s = stack else return 0
    let Tag.Compound(m) = s else return 0
    if not m.contains("count") {
        return 1
    }
    return m["count"].number_int() ?? 1
}

fn with_count(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}
