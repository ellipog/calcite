/// What a living entity's been hurt by lately, vanilla's `CombatTracker` (D427): each hurt that
/// took any of its health, with where a fall it was in began and how far it had fallen, kept till
/// it's gone 100 ticks without one, or 300 in combat, or it's died; and its death's message, made
/// of them.
///
/// A death message that names who or what killed it, or caused a fall it died of, names them as
/// they were when they hurt it, `Blame`, which the caller gives with the hurt (D442).
module world.combat

import chat.component.{ClickEvent, Component, EntityTooltip, HoverEvent, Style}
import java.uuid.{Uuid}
import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import world.damage.{ALWAYS_MOST_SIGNIFICANT_FALL, DamageTypes, FALL_VARIANTS, INTENTIONAL_GAME_DESIGN, IS_FALL}

/// Where a fall began, vanilla's `FallLocation`, by its place in `fall_location_names`.
pub const GENERIC_FALL: u8 = 0u8
pub const LADDER_FALL: u8 = 1u8
pub const VINES_FALL: u8 = 2u8
pub const WEEPING_VINES_FALL: u8 = 3u8
pub const TWISTING_VINES_FALL: u8 = 4u8
pub const SCAFFOLDING_FALL: u8 = 5u8
pub const OTHER_CLIMBABLE_FALL: u8 = 6u8
pub const WATER_FALL: u8 = 7u8

/// The fall locations' IDs, which their messages' keys end in, `death.fell.accident.ID`.
pub fn fall_location_names() -> List<str> {
    return ["generic", "ladder", "vines", "weeping_vines", "twisting_vines", "scaffolding", "other_climbable", "water"]
}

/// A hurt, vanilla's `CombatEntry`: its damage type, by its ID; the entities that caused it and
/// dealt it, by their IDs, -1 for none; how much it took; and where the fall it was in began, if
/// one did, and how far it had fallen; and the names of those entities, as `Blame` has them
/// (D442).
pub struct CombatEntry {
    pub kind: i32
    pub cause: i32 = -1
    pub direct: i32 = -1
    pub damage: f32
    pub fall_location: u8? = none
    pub fall_distance: f32
    pub cause_name: Component? = none
    pub direct_name: Component? = none
    pub weapon: Component? = none
}

/// Who a hurt came from, as a death message names them (D442): the display names of the entity
/// that caused it, `getEntity`, and of the one that dealt it, `getDirectEntity`, as they were
/// then, and the display name of what the one that caused it held in its main hand, where that
/// has a custom name, `item_display_name`, which the message names too, `.item` (D448).
pub struct Blame {
    pub cause: Component? = none
    pub direct: Component? = none
    pub weapon: Component? = none
}

/// A stack's name as vanilla shows it, `ItemStack.getDisplayName` (D448), for the saved stack
/// `stack`, as `ItemStack.CODEC` writes it, with the custom name `custom`, of the rarity
/// `rarity`, its `minecraft:rarity` or its item's, `none` for common, and enchanted or not: the
/// name, `getHoverName`, in italics, as a custom name is, in square brackets,
/// `chat.square_brackets`, in its rarity's color, `getRarity` raising a common or uncommon one
/// to rare and a rare one to epic where it's enchanted, and showing the item when pointed at,
/// `ItemStackTemplate.fromNonEmptyStack`: its ID, its count where that isn't 1, and its
/// components where it has any, as `ItemStackTemplate.MAP_CODEC` leaves out its defaults.
pub fn item_display_name(stack: Tag, custom: Component, rarity: String?, enchanted: bool) -> Component {
    var name = Component.empty()
    name.extra.push(custom.copy())
    name.style.italic = some(true)
    let base = rarity.copy() ?? String("common")
    var raised = base.copy()
    if enchanted {
        if base == "common" or base == "uncommon" {
            raised = String("rare")
        } else if base == "rare" {
            raised = String("epic")
        }
    }
    let color = if raised == "uncommon" { "yellow" } else if raised == "rare" { "aqua" } else if raised == "epic" { "light_purple" } else { "white" }
    var template = JavaHashMap<String, Tag>()
    match stack {
        Tag.Compound(m) => {
            if m.contains("id") {
                template.insert(String("id"), m["id"].copy())
            }
            if m.contains("count") and (m["count"].number_int() ?? 1) != 1 {
                template.insert(String("count"), m["count"].copy())
            }
            if m.contains("components") {
                match m["components"] {
                    Tag.Compound(c) => {
                        if not c.is_empty() {
                            template.insert(String("components"), m["components"].copy())
                        }
                    },
                    _ => {},
                }
            }
        },
        _ => {},
    }
    var shown = Component.translatable(String("chat.square_brackets"), [name]).colored(String(color))
    shown.style.hover_event = some(HoverEvent.ShowItem(Tag.Compound(template)))
    return shown
}

/// An entity's name as vanilla shows it, `Entity.getDisplayName` with no team (D442), for an
/// entity of the type `kind`, such as `minecraft:zombie`, the UUID `uuid` and the custom name
/// `custom`, if it has one: that name without what clicking it would do, `removeAction`, else its
/// type's, `entity.minecraft.zombie`, `getName`, a type's path having no slashes for the dots
/// vanilla's description IDs would put there; hovering shows its type, UUID and that name,
/// `createHoverEvent`, and shift-clicking puts its UUID in the chat box, `getStringUUID`.
pub fn entity_display_name(kind: String, uuid: Uuid, custom: Component?) -> Component {
    let id = match Identifier.parse(kind.copy()) {
        ok(i) => i,
        err(_) => Identifier { namespace: String("minecraft"), path: kind.copy() },
    }
    let name = match custom {
        some(c) => without_clicks(c),
        none => Component.translatable("entity.{id.namespace}.{id.path}", List<Component>()),
    }
    let tooltip = EntityTooltip { kind: id, uuid: uuid, name: some(Box(name.copy())) }
    var shown = name
    shown.style.hover_event = some(HoverEvent.ShowEntity(tooltip))
    shown.style.insertion = some(uuid.to_string())
    return shown
}

// `Entity.removeAction`: `c` and its siblings without their click events.
fn without_clicks(c: Component) -> Component {
    var out = c.copy()
    out.style.click_event = none
    out.extra = List<Component>()
    for sibling in c.extra {
        out.extra.push(without_clicks(sibling))
    }
    return out
}

/// The hurts, and whether and since when it's been taking damage or in combat, by its ticks.
pub struct CombatTracker {
    pub entries: List<CombatEntry> = List<CombatEntry>()
    last_damage_time: i32 = 0
    combat_start: i32 = 0
    combat_end: i32 = 0
    in_combat: bool = false
    taking_damage: bool = false
}

impl CombatTracker {
    /// `recordDamage` of `entry` at the entity's tick `tick`, alive or not: its status looked at
    /// again, `recheck`, then the hurt kept; where it isn't in combat and is alive, and a living
    /// entity caused it, `living_cause`, it's in combat from now. How long it had been in combat
    /// where the recheck took it out, `onLeaveCombat` (D442), and whether it came into combat,
    /// `onEnterCombat`.
    pub fn record(mut self, entry: own CombatEntry, tick: i32, alive: bool, living_cause: bool) -> (i32?, bool) {
        let left: i32? = if self.recheck(tick, alive) { some(self.duration(tick)) } else { none }
        self.entries.push(entry)
        self.last_damage_time = tick
        self.taking_damage = true
        if not self.in_combat and alive and living_cause {
            self.in_combat = true
            self.combat_start = tick
            self.combat_end = tick
            return (left, true)
        }
        return (left, false)
    }

    /// `recheckStatus` at the entity's tick `tick`, alive or not: where it's been taking damage
    /// and it's died, or gone 100 ticks without a hurt, or 300 in combat, it's out of both and
    /// its hurts are forgotten. Whether it left combat, `onLeaveCombat`.
    pub fn recheck(mut self, tick: i32, alive: bool) -> bool {
        let reset = if self.in_combat { 300 } else { 100 }
        if self.taking_damage and (not alive or tick - self.last_damage_time > reset) {
            let was = self.in_combat
            self.taking_damage = false
            self.in_combat = false
            self.combat_end = tick
            self.entries.clear()
            return was
        }
        return false
    }

    /// How long it's been in combat, at its tick `tick`, or was last, `getCombatDuration`.
    pub fn duration(self, tick: i32) -> i32 {
        return if self.in_combat { tick - self.combat_start } else { self.combat_end - self.combat_start }
    }

    /// `getDeathMessage` of the entity named `victim`, the types of damage `types`, and the name
    /// of who gets the credit for its death, `getKillCredit`, if anyone: `death.attack.generic`
    /// without a hurt; where the last hurt's type is told by its falls and the most significant
    /// fall is known, that fall's, `getFallMessage`: by where it began where it was a fall
    /// itself; else, where an entity caused it other than what caused the last hurt,
    /// `death.fell.assist` naming it; where only the last hurt's was, `death.fell.finish` naming
    /// that; else `death.fell.killer` (D442). For the type the bug report's link,
    /// `INTENTIONAL_GAME_DESIGN`; else the type's own, `getLocalizedDeathMessage`: naming the
    /// entity that caused the last hurt, or else dealt it, where one did (D442), else the credit's
    /// name where there's one. Where the entity that caused it held a weapon with a custom name,
    /// its message's `.item` names that too, `getDisplayName` (D448). A name not given is said to
    /// be missing, `death.attack.generic` instead.
    pub fn death_message(self, types: DamageTypes, victim: Component, credit: Component?, missing: mut List<String>) -> Component {
        if self.entries.is_empty() {
            return Component.translatable(String("death.attack.generic"), [victim.copy()])
        }
        let killing = self.entries[self.entries.len() - 1].copy()
        let told = types.death_message_of(killing.kind)
        if told == FALL_VARIANTS {
            if let at = self.most_significant_fall(types) {
                let knock_off = self.entries[at].copy()
                if not types.is(knock_off.kind, IS_FALL) and not types.is(knock_off.kind, ALWAYS_MOST_SIGNIFICANT_FALL) {
                    // Who caused the hurt that knocked it off, unless that's who caused the last.
                    if knock_off.cause >= 0 and knock_off.cause != killing.cause {
                        return assisted(victim, knock_off.cause_name, knock_off.weapon, String("death.fell.assist"), mut missing)
                    }
                    if killing.cause >= 0 {
                        return assisted(victim, killing.cause_name, killing.weapon, String("death.fell.finish"), mut missing)
                    }
                    return Component.translatable(String("death.fell.killer"), [victim.copy()])
                }
                let names = fall_location_names()
                let location = knock_off.fall_location ?? GENERIC_FALL
                let key = "death.fell.accident.{names[usize(location)]}"
                return Component.translatable(key, [victim.copy()])
            }
        }
        let message = "death.attack.{types.msg_id(killing.kind)}"
        if told == INTENTIONAL_GAME_DESIGN {
            let tip = Component.literal(String("MCPE-28723"))
            let style = Style { click_event: some(ClickEvent.OpenUrl(String("https://bugs.mojang.com/browse/MCPE-28723"))), hover_event: some(HoverEvent.ShowText(Box(tip))) }
            let link = Component.translatable(String("chat.square_brackets"), [Component.translatable("{message}.link", List<Component>())]).styled(style)
            return Component.translatable("{message}.message", [victim.copy(), link])
        }
        if killing.cause >= 0 {
            return assisted(victim, killing.cause_name, killing.weapon, message, mut missing)
        }
        if killing.direct >= 0 {
            return assisted(victim, killing.direct_name, none, message, mut missing)
        }
        if let who = credit {
            return Component.translatable("{message}.player", [victim.copy(), who.copy()])
        }
        return Component.translatable(message, [victim.copy()])
    }

    // `getMostSignificantFall`, by its place among the hurts: the farthest fall that hurt it, or
    // the hurt before it, where it's over 5; else the hurt that took most where a fall began,
    // where that's over 5; else none. A hurt that's always the most significant fall falls the
    // farthest.
    fn most_significant_fall(self, types: DamageTypes) -> usize? {
        var result: usize? = none
        var alternative: usize? = none
        var alt_damage = 0.0f32
        var best_fall = 0.0f32
        for i in 0..self.entries.len() {
            let e = self.entries[i].copy()
            let fake = types.is(e.kind, ALWAYS_MOST_SIGNIFICANT_FALL)
            let fall = if fake { f32.MAX } else { e.fall_distance }
            if (types.is(e.kind, IS_FALL) or fake) and fall > 0.0f32 and (result == none or fall > best_fall) {
                result = some(if i > 0 { i - 1 } else { i })
                best_fall = fall
            }
            if e.fall_location != none and (alternative == none or e.damage > alt_damage) {
                alternative = some(i)
                alt_damage = e.damage
            }
        }
        if best_fall > 5.0f32 and result != none {
            return result
        }
        if alt_damage > 5.0f32 and alternative != none {
            return alternative
        }
        return none
    }
}

// The message `key` of the entity named `victim` that `name` hurt, `getMessageForAssistedFall`
// and `getLocalizedDeathMessage`'s (D442): naming them, where their name's given, and their
// weapon with a custom name, `weapon`, where they held one, in the message's `.item` (D448).
fn assisted(victim: Component, name: Component?, weapon: Component?, key: String, missing: mut List<String>) -> Component {
    let who = name else {
        missing.push(String("Death messages naming an entity whose name wasn't given"))
        return Component.translatable(String("death.attack.generic"), [victim.copy()])
    }
    if let w = weapon {
        return Component.translatable("{key}.item", [victim.copy(), who.copy(), w.copy()])
    }
    return Component.translatable(key, [victim.copy(), who.copy()])
}
