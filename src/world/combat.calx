/// What a living entity's been hurt by lately, vanilla's `CombatTracker` (D427): each hurt that
/// took any of its health, with where a fall it was in began and how far it had fallen, kept till
/// it's gone 100 ticks without one, or 300 in combat, or it's died; and its death's message, made
/// of them.
///
/// A death message that names who or what killed it, or caused a fall it died of, needs that
/// entity's name, which the caller has; `death_message` gives none for those.
module world.combat

import chat.component.{ClickEvent, Component, HoverEvent, Style}
import world.damage.{ALWAYS_MOST_SIGNIFICANT_FALL, DamageTypes, FALL_VARIANTS, INTENTIONAL_GAME_DESIGN, IS_FALL}

/// Where a fall began, vanilla's `FallLocation`, by its place in `fall_location_names`.
pub const GENERIC_FALL: u8 = 0u8
pub const LADDER_FALL: u8 = 1u8
pub const VINES_FALL: u8 = 2u8
pub const WEEPING_VINES_FALL: u8 = 3u8
pub const TWISTING_VINES_FALL: u8 = 4u8
pub const SCAFFOLDING_FALL: u8 = 5u8
pub const OTHER_CLIMBABLE_FALL: u8 = 6u8
pub const WATER_FALL: u8 = 7u8

/// The fall locations' IDs, which their messages' keys end in, `death.fell.accident.ID`.
pub fn fall_location_names() -> List<str> {
    return ["generic", "ladder", "vines", "weeping_vines", "twisting_vines", "scaffolding", "other_climbable", "water"]
}

/// A hurt, vanilla's `CombatEntry`: its damage type, by its ID; the entities that caused it and
/// dealt it, by their IDs, -1 for none; how much it took; and where the fall it was in began, if
/// one did, and how far it had fallen.
pub struct CombatEntry {
    pub kind: i32
    pub cause: i32 = -1
    pub direct: i32 = -1
    pub damage: f32
    pub fall_location: u8? = none
    pub fall_distance: f32
}

/// The hurts, and whether and since when it's been taking damage or in combat, by its ticks.
pub struct CombatTracker {
    pub entries: List<CombatEntry> = List<CombatEntry>()
    last_damage_time: i32 = 0
    combat_start: i32 = 0
    combat_end: i32 = 0
    in_combat: bool = false
    taking_damage: bool = false
}

impl CombatTracker {
    /// `recordDamage` of `entry` at the entity's tick `tick`, alive or not: its status looked at
    /// again, `recheck`, then the hurt kept; where it isn't in combat and is alive, and a living
    /// entity caused it, `living_cause`, it's in combat from now. Whether it came into combat,
    /// `onEnterCombat`.
    pub fn record(mut self, entry: own CombatEntry, tick: i32, alive: bool, living_cause: bool) -> bool {
        _ = self.recheck(tick, alive)
        self.entries.push(entry)
        self.last_damage_time = tick
        self.taking_damage = true
        if not self.in_combat and alive and living_cause {
            self.in_combat = true
            self.combat_start = tick
            self.combat_end = tick
            return true
        }
        return false
    }

    /// `recheckStatus` at the entity's tick `tick`, alive or not: where it's been taking damage
    /// and it's died, or gone 100 ticks without a hurt, or 300 in combat, it's out of both and
    /// its hurts are forgotten. Whether it left combat, `onLeaveCombat`.
    pub fn recheck(mut self, tick: i32, alive: bool) -> bool {
        let reset = if self.in_combat { 300 } else { 100 }
        if self.taking_damage and (not alive or tick - self.last_damage_time > reset) {
            let was = self.in_combat
            self.taking_damage = false
            self.in_combat = false
            self.combat_end = tick
            self.entries.clear()
            return was
        }
        return false
    }

    /// How long it's been in combat, at its tick `tick`, or was last, `getCombatDuration`.
    pub fn duration(self, tick: i32) -> i32 {
        return if self.in_combat { tick - self.combat_start } else { self.combat_end - self.combat_start }
    }

    /// `getDeathMessage` of the entity named `victim`, the types of damage `types`, and the name
    /// of who gets the credit for its death, `getKillCredit`, if anyone: `death.attack.generic`
    /// without a hurt; where the last hurt's type is told by its falls and the most significant
    /// fall is known, that fall's, `getFallMessage`, by where it began, or `death.fell.killer`
    /// where it wasn't a fall itself; for the type the bug report's link,
    /// `INTENTIONAL_GAME_DESIGN`; else the type's own, `getLocalizedDeathMessage`, with the
    /// credit's name where there's one. None where it'd name an entity a hurt came from.
    pub fn death_message(self, types: DamageTypes, victim: Component, credit: Component?) -> Component? {
        if self.entries.is_empty() {
            return some(Component.translatable(String("death.attack.generic"), [victim.copy()]))
        }
        let killing = self.entries[self.entries.len() - 1]
        if killing.cause >= 0 or killing.direct >= 0 {
            return none
        }
        let told = types.death_message_of(killing.kind)
        if told == FALL_VARIANTS {
            if let at = self.most_significant_fall(types) {
                let knock_off = self.entries[at]
                if not types.is(knock_off.kind, IS_FALL) and not types.is(knock_off.kind, ALWAYS_MOST_SIGNIFICANT_FALL) {
                    if knock_off.cause >= 0 {
                        return none
                    }
                    return some(Component.translatable(String("death.fell.killer"), [victim.copy()]))
                }
                let names = fall_location_names()
                let location = knock_off.fall_location ?? GENERIC_FALL
                let key = "death.fell.accident.{names[usize(location)]}"
                return some(Component.translatable(key, [victim.copy()]))
            }
        }
        let message = "death.attack.{types.msg_id(killing.kind)}"
        if told == INTENTIONAL_GAME_DESIGN {
            let tip = Component.literal(String("MCPE-28723"))
            let style = Style { click_event: some(ClickEvent.OpenUrl(String("https://bugs.mojang.com/browse/MCPE-28723"))), hover_event: some(HoverEvent.ShowText(Box(tip))) }
            let link = Component.translatable(String("chat.square_brackets"), [Component.translatable("{message}.link", List<Component>())]).styled(style)
            return some(Component.translatable("{message}.message", [victim.copy(), link]))
        }
        if let who = credit {
            return some(Component.translatable("{message}.player", [victim.copy(), who.copy()]))
        }
        return some(Component.translatable(message, [victim.copy()]))
    }

    // `getMostSignificantFall`, by its place among the hurts: the farthest fall that hurt it, or
    // the hurt before it, where it's over 5; else the hurt that took most where a fall began,
    // where that's over 5; else none. A hurt that's always the most significant fall falls the
    // farthest.
    fn most_significant_fall(self, types: DamageTypes) -> usize? {
        var result: usize? = none
        var alternative: usize? = none
        var alt_damage = 0.0f32
        var best_fall = 0.0f32
        for i in 0..self.entries.len() {
            let e = self.entries[i]
            let fake = types.is(e.kind, ALWAYS_MOST_SIGNIFICANT_FALL)
            let fall = if fake { f32.MAX } else { e.fall_distance }
            if (types.is(e.kind, IS_FALL) or fake) and fall > 0.0f32 and (result == none or fall > best_fall) {
                result = some(if i > 0 { i - 1 } else { i })
                best_fall = fall
            }
            if e.fall_location != none and (alternative == none or e.damage > alt_damage) {
                alternative = some(i)
                alt_damage = e.damage
            }
        }
        if best_fall > 5.0f32 and result != none {
            return result
        }
        if alt_damage > 5.0f32 and alternative != none {
            return alternative
        }
        return none
    }
}
