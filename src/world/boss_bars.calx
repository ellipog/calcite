/// The boss bars `bossbar` makes, vanilla's `CustomBossEvents` and `CustomBossEvent` (D606): each
/// by its ID, in a `HashMap`'s order, with its UUID, its name, its progress, color and notches,
/// its flags, whether it's shown, its value and its most, the UUIDs of its players, `players`,
/// and those of them in play it's shown to, `ServerBossEvent.players`. Read from and saved to
/// `data/minecraft/custom_boss_events.dat` as `CustomBossEvent.Packed`, each a fresh random UUID
/// as it's read, `UUID.randomUUID`.
///
/// Those it's shown to are players as vanilla's `ServerPlayer`s are, each one life: a player who
/// respawns is another, as `PlayerList.respawn` makes a new one, so the one who died stays among
/// those it's shown to, still sent its packets on the same connection, and the one who lives
/// isn't added, its UUID already among its players. Leaving, the one who lives is taken out, the
/// one who died isn't, as vanilla's `onPlayerDisconnect` leaves it.
module world.boss_bars

import auth.profile.{GameProfile}
import chat.component.{Component, HoverEvent, TextColor}
import java.uuid.{Uuid}
import nbt.tag.{Tag}
import protocol.play.{BossOperation, BossShown}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data type the bars are saved as, `CustomBossEvents.TYPE`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: String("minecraft"), path: String("custom_boss_events") }
}

/// A bar's colors, `BossEvent.BossBarColor`, by their ordinals: pink 0, blue 1, red 2, green 3,
/// yellow 4, purple 5 and white 6, which a bar's made with.
pub const WHITE: i32 = 6

/// A color's name, as it's saved and as `bossbar set color` names it.
pub fn color_name(color: i32) -> String {
    let names = ["pink", "blue", "red", "green", "yellow", "purple", "white"]
    return String(names[usize.wrap(color)])
}

/// The color named `name`, if there's one.
pub fn color_named(name: String) -> i32? {
    for c in 0..7 {
        if color_name(c) == name {
            return some(c)
        }
    }
    return none
}

// The chat formatting of a color, `getFormatting`, by its name: pink's red, red's dark red and
// purple's dark blue.
fn formatting_of(color: i32) -> String {
    let names = ["red", "blue", "dark_red", "green", "yellow", "dark_blue", "white"]
    return String(names[usize.wrap(color)])
}

/// A bar's notches, `BossEvent.BossBarOverlay`, by their ordinals: none, `progress`, 0, and 6,
/// 10, 12 and 20 notches, 1 to 4.
pub fn overlay_name(overlay: i32) -> String {
    let names = ["progress", "notched_6", "notched_10", "notched_12", "notched_20"]
    return String(names[usize.wrap(overlay)])
}

/// The notches named `name`, if there are such.
pub fn overlay_named(name: String) -> i32? {
    for o in 0..5 {
        if overlay_name(o) == name {
            return some(o)
        }
    }
    return none
}

/// A player a bar's shown to, one of vanilla's `ServerPlayer`s: their entity's ID, which life of
/// the player's it is, `serial`, and their profile, by which they're named.
pub struct Viewer {
    pub entity: i32
    pub serial: i64
    pub profile: GameProfile
}

/// A packet for a player: to whom, by their entity's ID, the bar's UUID and what it does.
pub struct BossSent {
    pub to: i32
    pub id: Uuid
    pub operation: BossOperation
}

/// A bar, `CustomBossEvent`.
pub struct BossBar {
    pub id: Identifier
    pub uuid: Uuid
    pub name: Component
    /// As a custom bar's made, 0, `setProgress(0)`.
    pub progress: f32 = 0.0f32
    pub color: i32 = WHITE
    pub overlay: i32 = 0
    pub darkens: bool = false
    pub music: bool = false
    pub fog: bool = false
    /// Whether it's shown, as `ServerBossEvent` has it, so a bar's made shown.
    pub visible: bool = true
    pub value: i32 = 0
    pub max: i32 = 100
    /// Its players' UUIDs, `CustomBossEvent.players`, as Java's `HashSet` keeps them.
    pub players: JavaHashSet<Uuid> = JavaHashSet<Uuid>()
    /// Those in play it's shown to, `ServerBossEvent.players`, in the order they came.
    pub viewers: List<Viewer> = List<Viewer>()
}

impl BossBar {
    /// `getDisplayName`: its name in brackets, in its color's formatting, showing its ID when
    /// pointed at and putting it in the chat box when shift-clicked.
    pub fn display_name(self) -> Component {
        var c = Component.translatable(String("chat.square_brackets"), [self.name.copy()])
        c.style.color = TextColor.named(formatting_of(self.color))
        c.style.hover_event = some(HoverEvent.ShowText(Box(Component.literal(self.id.to_string()))))
        c.style.insertion = some(self.id.to_string())
        return c
    }

    /// Its flags, `encodeProperties`.
    pub fn flags(self) -> u8 {
        var f: u8 = 0
        if self.darkens {
            f = f | 1
        }
        if self.music {
            f = f | 2
        }
        if self.fog {
            f = f | 4
        }
        return f
    }

    /// `createAddPacket`'s operation: all it has.
    pub fn shown(self) -> BossOperation {
        return BossOperation.Add(BossShown { name: self.name.copy(), progress: self.progress, color: self.color, overlay: self.overlay, flags: self.flags() })
    }

    // `broadcast`: `operation` to each it's shown to, where it's shown.
    fn broadcast(self, operation: BossOperation, sent: mut List<BossSent>) {
        if not self.visible {
            return
        }
        for v in self.viewers {
            sent.push(BossSent { to: v.entity, id: self.uuid, operation: operation.copy() })
        }
    }

    /// `setProgress`, where it changes, which a NaN always does.
    pub fn set_progress(mut self, progress: f32, sent: mut List<BossSent>) {
        if progress != self.progress {
            self.progress = progress
            self.broadcast(BossOperation.Progress(progress), mut sent)
        }
    }

    /// `setColor`, where it changes.
    pub fn set_color(mut self, color: i32, sent: mut List<BossSent>) {
        if color != self.color {
            self.color = color
            self.broadcast(BossOperation.Style(self.color, self.overlay), mut sent)
        }
    }

    /// `setOverlay`, where it changes.
    pub fn set_overlay(mut self, overlay: i32, sent: mut List<BossSent>) {
        if overlay != self.overlay {
            self.overlay = overlay
            self.broadcast(BossOperation.Style(self.color, self.overlay), mut sent)
        }
    }

    /// `setDarkenScreen`, `setPlayBossMusic` and `setCreateWorldFog`, each where it changes.
    pub fn set_flags(mut self, darkens: bool, music: bool, fog: bool, sent: mut List<BossSent>) {
        if darkens != self.darkens {
            self.darkens = darkens
            self.broadcast(BossOperation.Properties(self.flags()), mut sent)
        }
        if music != self.music {
            self.music = music
            self.broadcast(BossOperation.Properties(self.flags()), mut sent)
        }
        if fog != self.fog {
            self.fog = fog
            self.broadcast(BossOperation.Properties(self.flags()), mut sent)
        }
    }

    /// `setName`, where it changes, as `Objects.equal` compares them.
    pub fn set_name(mut self, name: Component, sent: mut List<BossSent>) {
        if not same_text(name, self.name) {
            self.name = name.copy()
            self.broadcast(BossOperation.Name(name.copy()), mut sent)
        }
    }

    /// `setValue`: the value, its progress the value over its most, between 0 and 1.
    pub fn set_value(mut self, value: i32, sent: mut List<BossSent>) {
        self.value = value
        let progress = progress_of(value, self.max)
        self.set_progress(progress, mut sent)
    }

    /// `setMax`: its most, its progress its value over that, between 0 and 1.
    pub fn set_max(mut self, max: i32, sent: mut List<BossSent>) {
        self.max = max
        let progress = progress_of(self.value, max)
        self.set_progress(progress, mut sent)
    }

    /// `setVisible`, where it changes: each it's shown to shown it, or have it taken away.
    pub fn set_visible(mut self, visible: bool, sent: mut List<BossSent>) {
        if visible == self.visible {
            return
        }
        self.visible = visible
        for v in self.viewers {
            let operation = if visible { self.shown() } else { BossOperation.Remove }
            sent.push(BossSent { to: v.entity, id: self.uuid, operation: operation })
        }
    }

    /// Whether it's shown to the player `v` is, by their life, `players.contains`.
    pub fn shows(self, v: Viewer) -> bool {
        for w in self.viewers {
            if w.entity == v.entity and w.serial == v.serial {
                return true
            }
        }
        return false
    }

    /// `ServerBossEvent.addPlayer`: shown to `v`, sent all it has where it's shown; whether it
    /// wasn't shown to them, as a dragon fight's bar is shown (D624).
    pub fn show_to(mut self, v: Viewer, sent: mut List<BossSent>) -> bool {
        if self.shows(v) {
            return false
        }
        self.viewers.push(v.copy())
        if self.visible {
            sent.push(BossSent { to: v.entity, id: self.uuid, operation: self.shown() })
        }
        return true
    }

    /// `CustomBossEvent.addPlayer`: shown to `v`, `show_to`, and their UUID among its players;
    /// whether that's new to it.
    pub fn add_player(mut self, v: Viewer, sent: mut List<BossSent>) -> bool {
        _ = self.show_to(v, mut sent)
        if self.players.contains(v.profile.id) {
            return false
        }
        self.players.insert(v.profile.id)
        return true
    }

    /// `ServerBossEvent.removePlayer`: no longer shown to `v`, who has it taken away where it's
    /// shown; whether it was.
    pub fn stop_showing(mut self, v: Viewer, sent: mut List<BossSent>) -> bool {
        for i in 0..self.viewers.len() {
            if self.viewers[i].entity == v.entity and self.viewers[i].serial == v.serial {
                _ = self.viewers.remove(i)
                if self.visible {
                    sent.push(BossSent { to: v.entity, id: self.uuid, operation: BossOperation.Remove })
                }
                return true
            }
        }
        return false
    }

    /// `CustomBossEvent.removePlayer`: no longer shown to `v`, and their UUID no longer among its
    /// players; whether that was.
    pub fn remove_player(mut self, v: Viewer, sent: mut List<BossSent>) -> bool {
        _ = self.stop_showing(v, mut sent)
        if not self.players.contains(v.profile.id) {
            return false
        }
        self.players.remove(v.profile.id)
        return true
    }

    /// `removeAllPlayers`: taken from each it's shown to, in turn, then no players.
    pub fn remove_all(mut self, sent: mut List<BossSent>) {
        let shown = self.viewers.copy()
        for v in shown {
            _ = self.remove_player(v, mut sent)
        }
        self.players.clear()
    }

    /// `setPlayers`: each of its players' UUIDs not among `targets`' taken out, the first it's
    /// shown to of that UUID no longer shown it, then each of `targets` not among them added;
    /// whether any were.
    pub fn set_players(mut self, targets: List<Viewer>, sent: mut List<BossSent>) -> bool {
        var gone = JavaHashSet<Uuid>()
        for u in self.players {
            var found = false
            for t in targets {
                if t.profile.id == u {
                    found = true
                    break
                }
            }
            if not found {
                gone.insert(u)
            }
        }
        var added = List<Viewer>()
        for t in targets {
            if not self.players.contains(t.profile.id) and not has_uuid(added, t.profile.id) {
                added.push(t.copy())
            }
        }
        for u in gone {
            for v in self.viewers.copy() {
                if v.profile.id == u {
                    _ = self.remove_player(v, mut sent)
                    break
                }
            }
            self.players.remove(u)
        }
        for t in added {
            _ = self.add_player(t, mut sent)
        }
        return not gone.is_empty() or not added.is_empty()
    }

    /// `pack`, as `CustomBossEvent.Packed.CODEC` writes it: its name, then each else that isn't
    /// its default, its players as many as it has, `Set.copyOf`'s, whose order vanilla draws
    /// afresh each run, so the rig compares them sorted.
    pub fn pack(self) -> Tag {
        var m = JavaHashMap<String, Tag>()
        m.insert(String("Name"), self.name.to_nbt())
        if self.visible {
            m.insert(String("Visible"), Tag.Byte(1))
        }
        if self.value != 0 {
            m.insert(String("Value"), Tag.Int(self.value))
        }
        if self.max != 100 {
            m.insert(String("Max"), Tag.Int(self.max))
        }
        if self.color != WHITE {
            m.insert(String("Color"), Tag.Str(color_name(self.color)))
        }
        if self.overlay != 0 {
            m.insert(String("Overlay"), Tag.Str(overlay_name(self.overlay)))
        }
        if self.darkens {
            m.insert(String("DarkenScreen"), Tag.Byte(1))
        }
        if self.music {
            m.insert(String("PlayBossMusic"), Tag.Byte(1))
        }
        if self.fog {
            m.insert(String("CreateWorldFog"), Tag.Byte(1))
        }
        if not self.players.is_empty() {
            var players = List<Tag>()
            for u in self.players {
                players.push(Tag.IntArray(u.ints()))
            }
            m.insert(String("Players"), Tag.List(players))
        }
        return Tag.Compound(m)
    }
}

// Whether a player of `uuid` is among `vs`.
fn has_uuid(vs: List<Viewer>, uuid: Uuid) -> bool {
    for v in vs {
        if v.profile.id == uuid {
            return true
        }
    }
    return false
}

// `Mth.clamp((float)value / max, 0, 1)`: a NaN, of 0 over 0, stays one.
fn progress_of(value: i32, max: i32) -> f32 {
    let p = f32.nearest(value) / f32.nearest(max)
    if p < 0.0f32 {
        return 0.0f32
    }
    if p > 1.0f32 {
        return 1.0f32
    }
    return p
}

/// Whether two names are the same, as `equals` compares components: as their codec writes them.
pub fn same_text(a: Component, b: Component) -> bool {
    return a.to_nbt().to_snbt() == b.to_nbt().to_snbt()
}

/// The bars.
pub struct BossBars {
    pub bars: JavaHashMap<Identifier, BossBar> = JavaHashMap<Identifier, BossBar>()
    /// Whether they've changed since they were read or saved, `setDirty`.
    pub dirty: bool = false
}

impl BossBars {
    /// None, as a world without the file, or with one that can't be read, starts:
    /// `computeIfAbsent` makes them, marked to be saved.
    pub fn fresh() -> BossBars {
        return BossBars { dirty: true }
    }

    /// The bars of a saved file's root, as the codec reads them: each that reads in its
    /// compound's order, as `CustomBossEvent.load` makes it, of a fresh random UUID, which marks
    /// them to be saved, as its `setValue` does; each that doesn't, logged, and left out, as
    /// `resultOrPartial` keeps the rest. A file whose `data` isn't a map starts them afresh.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> BossBars {
        if not root.contains("data") {
            lines.push(parse_failed(saved_id(), String("Not a map: null")))
            return BossBars.fresh()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            other => {
                lines.push(parse_failed(saved_id(), "Not a map: {other.to_snbt()}"))
                return BossBars.fresh()
            },
        }
        var out = BossBars()
        var problems = List<String>()
        for (key, value) in data {
            match read_bar(key, value) {
                ok(bar) => {
                    out.bars.insert(bar.id.copy(), bar)
                    out.dirty = true
                },
                err(p) => problems.push(p),
            }
        }
        if not problems.is_empty() {
            var joined = String()
            for p in problems {
                if not joined.is_empty() {
                    joined.push_str("; ")
                }
                joined.push_str(p)
            }
            lines.push(parse_failed(saved_id(), joined))
        }
        return out
    }

    /// The bars to save, `data`'s, where they've changed, as the codec writes them: each of its
    /// ID's text, in the bars' order.
    pub fn take_save(mut self) -> Tag? {
        if not self.dirty {
            return none
        }
        self.dirty = false
        var m = JavaHashMap<String, Tag>()
        for (id, bar) in self.bars {
            m.insert(id.to_string(), bar.pack())
        }
        return some(Tag.Compound(m))
    }

    /// The bar of `id`, `get`, as it is, if there's one.
    pub fn get(self, id: Identifier) -> BossBar? {
        if not self.bars.contains(id) {
            return none
        }
        return some(self.bars[id].copy())
    }

    /// `bar` put back as it's changed, marked to be saved where `changed`.
    pub fn put(mut self, bar: own BossBar, changed: bool) {
        self.bars.insert(bar.id.copy(), bar)
        if changed {
            self.dirty = true
        }
    }

    /// `remove`: the bar of `id` gone, if there was one.
    pub fn remove(mut self, id: Identifier) {
        if self.bars.remove(id) != none {
            self.dirty = true
        }
    }

    /// The bars' IDs, `getIds`, in their order.
    pub fn ids(self) -> List<Identifier> {
        var out = List<Identifier>()
        for (id, _) in self.bars {
            out.push(id.copy())
        }
        return out
    }

    /// `onPlayerConnect`: each bar whose players `v`'s UUID is among shown to them, sent all it
    /// has where it's shown.
    pub fn connected(mut self, v: Viewer, sent: mut List<BossSent>) {
        for id in self.ids() {
            var bar = self.bars[id].copy()
            if bar.players.contains(v.profile.id) {
                _ = bar.add_player(v, mut sent)
                self.bars.insert(id.copy(), bar)
            }
        }
    }

    /// `onPlayerDisconnect`: no bar shown to `v` any longer, their UUID kept among its players.
    /// What it sends them, as they're leaving, isn't sent.
    pub fn disconnected(mut self, v: Viewer) {
        var unsent = List<BossSent>()
        for id in self.ids() {
            var bar = self.bars[id].copy()
            if bar.stop_showing(v, mut unsent) {
                self.bars.insert(id.copy(), bar)
            }
        }
    }
}

// A bar as the codec reads its entry: its ID, then `Packed`'s fields, its name needed, the rest
// their defaults where they're missing.
fn read_bar(key: String, value: Tag) -> BossBar ! String {
    let id = match Identifier.parse(key.copy()) {
        ok(i) => i,
        err(e) => fail "Not a valid resource location: {key} {e}",
    }
    let m = match value {
        Tag.Compound(c) => c.copy(),
        other => fail "Not a map: {other.to_snbt()}",
    }
    if not m.contains("Name") {
        fail "No key Name in MapLike[{value.to_snbt()}]"
    }
    let name = try Component.from_nbt(m["Name"])
    var bar = BossBar { id: id.copy(), uuid: Uuid.random(), name: name }
    var unsent = List<BossSent>()
    // `load`: shown or not, its value then its most, its color, notches and flags, then its
    // players.
    bar.set_visible(try bool_field(m, "Visible"), mut unsent)
    bar.set_value(try int_field(m, "Value", 0), mut unsent)
    bar.set_max(try int_field(m, "Max", 100), mut unsent)
    if m.contains("Color") {
        let text = try string_field(m, "Color")
        let color = color_named(text.copy()) else fail "Unknown element name:{text}"
        bar.set_color(color, mut unsent)
    }
    if m.contains("Overlay") {
        let text = try string_field(m, "Overlay")
        let overlay = overlay_named(text.copy()) else fail "Unknown element name:{text}"
        bar.set_overlay(overlay, mut unsent)
    }
    bar.set_flags(try bool_field(m, "DarkenScreen"), try bool_field(m, "PlayBossMusic"), try bool_field(m, "CreateWorldFog"), mut unsent)
    if m.contains("Players") {
        let items = match m["Players"] {
            Tag.List(l) => l.copy(),
            other => fail "Not a list: {other.to_snbt()}",
        }
        for item in items {
            match item {
                Tag.IntArray(a) => {
                    if a.len() != 4 {
                        fail "Input is not a list of 4 ints"
                    }
                    bar.players.insert(Uuid.from_ints(a))
                },
                other => fail "Not an int array: {other.to_snbt()}",
            }
        }
    }
    return bar
}

// A flag of `m`, `Codec.BOOL`'s, false where it's missing: a number's not 0.
fn bool_field(m: JavaHashMap<String, Tag>, name: str) -> bool ! String {
    if not m.contains(name) {
        return false
    }
    let v = m[name].number_int() else fail "Not a number: {m[name].to_snbt()}"
    return v != 0
}

// A number of `m`, `Codec.INT`'s, `missing` where it's missing.
fn int_field(m: JavaHashMap<String, Tag>, name: str, missing: i32) -> i32 ! String {
    if not m.contains(name) {
        return missing
    }
    let v = m[name].number_int() else fail "Not a number: {m[name].to_snbt()}"
    return v
}

// A string of `m`.
fn string_field(m: JavaHashMap<String, Tag>, name: str) -> String ! String {
    return match m[name] {
        Tag.Str(s) => s.copy(),
        other => fail "Not a string: {other.to_snbt()}",
    }
}
