/// A lodestone compass's tracker as it ticks, vanilla's `LodestoneTracker.tick` from
/// `CompassItem.inventoryTick`: in a player's inventory and equipment (D603), and in a mob's or an
/// armor stand's equipment, `EntityEquipment.tick` in `LivingEntity.aiStep` (D607).
module world.lodestone

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import world.placing.{component_of, stack_item}
import world.poi.{LODESTONE, Pois}
import world.pos.{BlockPos, ChunkPos}

/// What a stack's tracker did as it ticked.
pub enum TrackerTick {
    /// It stays as it is: the stack isn't a lodestone compass tracking a target in this level, or
    /// its lodestone's there.
    Kept
    /// The stack with its tracker's target gone, `{}`: its target's out of the world,
    /// `isInWorldBounds`, or no lodestone's point of interest is there, `existsAtPosition`.
    Lost(Tag)
    /// Its target's chunk's points of interest aren't read yet, which vanilla reads then and
    /// there, `getOrLoad`, and Calcite asks for, the stack kept till they're known.
    Unknown(ChunkPos)
}

/// `LodestoneTracker.tick` for the stack `stack` ticked in the level named `dimension`, whose
/// points of interest are `pois`: where it's a compass whose tracker, tracking, has its target in
/// this level.
pub fn lodestone_tick(stack: Tag?, dimension: String, pois: Pois) -> TrackerTick {
    let s = stack.copy() else return TrackerTick.Kept
    if stack_item(some(s.copy())) != "minecraft:compass" {
        return TrackerTick.Kept
    }
    let Tag.Compound(t) = component_of(some(s.copy()), "minecraft:lodestone_tracker") ?? Tag.End else return TrackerTick.Kept
    if t.contains("tracked") and ((t["tracked"].number_int() ?? 1) & 255) == 0 {
        return TrackerTick.Kept
    }
    if not t.contains("target") {
        return TrackerTick.Kept
    }
    let Tag.Compound(target) = t["target"].copy() else return TrackerTick.Kept
    if not target.contains("dimension") or not target.contains("pos") {
        return TrackerTick.Kept
    }
    let Tag.Str(name) = target["dimension"].copy() else return TrackerTick.Kept
    let named = match Identifier.parse(name.copy()) {
        ok(i) => i.to_string(),
        err(_) => return TrackerTick.Kept,
    }
    if named != dimension {
        return TrackerTick.Kept
    }
    let pos = match target["pos"].copy() {
        Tag.IntArray(p) => p.copy(),
        Tag.List(l) => {
            var p = List<i32>()
            for e in l {
                p.push(e.number_int() ?? 0)
            }
            p
        },
        _ => return TrackerTick.Kept,
    }
    if pos.len() != 3 {
        return TrackerTick.Kept
    }
    let at = BlockPos { x: pos[0], y: pos[1], z: pos[2] }
    let min_y = pois.min_y()
    let max_y = min_y + pois.height() - 1
    let inside = at.y >= min_y and at.y <= max_y and at.x >= -30000000 and at.z >= -30000000 and at.x < 30000000 and at.z < 30000000
    if inside {
        if not pois.knows(at.chunk()) {
            return TrackerTick.Unknown(at.chunk())
        }
        if pois.type_at(at) == some(LODESTONE) {
            return TrackerTick.Kept
        }
    }
    return TrackerTick.Lost(with_component(s, "minecraft:lodestone_tracker", Tag.Compound(JavaHashMap<String, Tag>())))
}

/// The stack `stack` with its component `name`, a whole ID, set to `value` in its patch,
/// `ItemStack.set` (D603).
pub fn with_component(stack: Tag, name: str, value: own Tag) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    var patch = JavaHashMap<String, Tag>()
    if m.contains("components") {
        patch = match m["components"] {
            Tag.Compound(c) => c.copy(),
            _ => JavaHashMap<String, Tag>(),
        }
    }
    _ = patch.remove("!{name}")
    patch.insert(String(name), value)
    out.insert(String("components"), Tag.Compound(patch))
    return Tag.Compound(out)
}

/// Whether the stack `stack` in a hand is a map that draws what's about whoever holds it,
/// `MapItem.inventoryTick`'s `update`, which Calcite has no maps for yet: a filled map with its
/// ID, whose saved data Calcite doesn't keep.
pub fn draws_map(stack: Tag?) -> bool {
    return stack != none and stack_item(stack) == "minecraft:filled_map"
}
