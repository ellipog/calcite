/// What pathfinding makes of blocks (CAL-157), as vanilla's `WalkNodeEvaluator` reads them: each
/// state's path type, `getPathTypeFromState`, worked out once from the state's path facts
/// (`world.entity_facts`, from vanilla's own classes) and the world's tags, and for which
/// computations `isPathfindable` holds for it; and a block's path type, `getPathTypeStatic`, which
/// asks of the block below one that's open and of those around it, `checkNeighbourBlocks`, each
/// block's read through a level's `PathTypeCache` as a server's are.
///
/// A block whose chunk isn't loaded full is air, as `PathNavigationRegion` gives an empty chunk's
/// void air there, which is open as air is.
module world.paths

import world.chunk.{AIR_STATE}
import world.collision.{CollisionBlocks}
import world.entity_facts.{COMPUTATION_LAND, PATHFINDABLE_ALWAYS, PATHFINDABLE_IN_WATER, PATHFINDABLE_NOT_IN_LAVA, PATH_BLOCKED, PATH_COCOA, PATH_DAMAGE_CAUTIOUS, PATH_DAMAGING, PATH_DAMAGING_IN_NEIGHBOR, PATH_DOOR_IRON_CLOSED, PATH_DOOR_OPEN, PATH_DOOR_WOOD_CLOSED, PATH_FENCE, PATH_FIRE, PATH_FIRE_IN_NEIGHBOR, PATH_KIND_DOOR_BY_HAND, PATH_KIND_DOOR_OPEN, PATH_KIND_DOOR_SHUT, PATH_KIND_GATE_SHUT, PATH_KIND_LEAVES, PATH_KIND_RAIL, PATH_KIND_SHIFT, PATH_LAVA, PATH_LEAVES, PATH_ON_TOP_OF_POWDER_SNOW, PATH_ON_TOP_OF_TRAPDOOR, PATH_OPEN, PATH_POWDER_SNOW, PATH_RAIL, PATH_STICKY_HONEY, PATH_TRAPDOOR, PATH_WALKABLE, PATH_WATER, PATH_WATER_BORDER, state_path_facts}
import worldgen.facts.{BlockSet, Facts}

// A slot of `PathTypeCache` that holds no type.
const NO_TYPE: u8 = 255
// How many slots it has, and the mask of a slot's index.
const CACHE_SLOTS: usize = 4096
const CACHE_MASK: i64 = 4095

/// A level's `PathTypeCache`: the path types `getPathTypeFromState` gave 4096 places, each in the
/// slot its packed position's mixed hash picks, kept until the place's block is sent again,
/// `sendBlockUpdated`, or another place takes its slot. What it holds is what was read, so a place
/// read while its chunk wasn't loaded stays open after it loads until its block is sent again, as
/// in vanilla.
pub struct PathTypeCache {
    positions: List<i64> = List<i64>()
    types: List<u8> = List<u8>()
}

impl PathTypeCache {
    /// Empty, every slot's position 0, 0, 0 with no type, as vanilla's arrays start. One made as
    /// `PathTypeCache()` makes its slots as it first keeps a type.
    pub fn new() -> PathTypeCache {
        return PathTypeCache { positions: [0i64; CACHE_SLOTS], types: [NO_TYPE; CACHE_SLOTS] }
    }

    /// `invalidate`: the type of the place `x`, `y`, `z` forgotten, if its slot holds it.
    pub fn invalidate(mut self, x: i32, y: i32, z: i32) {
        if self.positions.is_empty() {
            return
        }
        let key = pack(x, y, z)
        let i = slot(key)
        if self.positions[i] == key {
            self.types[i] = NO_TYPE
        }
    }

    /// `getOrCompute`: the type its slot holds for `x`, `y`, `z`, or the state's there, kept.
    pub fn get_or_compute<B: CollisionBlocks>(mut self, p: PathStates, blocks: B, x: i32, y: i32, z: i32) -> u8 {
        if self.positions.is_empty() {
            self.positions = [0i64; CACHE_SLOTS]
            self.types = [NO_TYPE; CACHE_SLOTS]
        }
        let key = pack(x, y, z)
        let i = slot(key)
        if self.positions[i] == key and self.types[i] != NO_TYPE {
            return self.types[i]
        }
        let t = p.of(state_at(blocks, x, y, z))
        self.positions[i] = key
        self.types[i] = t
        return t
    }
}

// The place packed in a long, `BlockPos.asLong`.
fn pack(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 0x3FFFFFF) << 38) | ((i64(z) & 0x3FFFFFF) << 12) | (i64(y) & 0xFFF)
}

// The slot of a packed place, `HashCommon.mix` of it masked.
fn slot(key: i64) -> usize {
    let h = key.wrapping_mul(-7046029254386353131)
    let a = h ^ i64.wrap(u64.wrap(h) >> 32)
    let mixed = a ^ i64.wrap(u64.wrap(a) >> 16)
    return usize.wrap(i64(i32.wrap(mixed)) & CACHE_MASK)
}

/// What pathfinding reads of each state, with the world's tags: its path type,
/// `getPathTypeFromState`, and for which of `COMPUTATION_LAND`, `COMPUTATION_WATER` and
/// `COMPUTATION_AIR` `isPathfindable` holds, a bit each; and the fluids mobs float in,
/// `#entity_floatable`, a bit each by ID.
pub struct PathStates {
    types: List<u8>
    computations: List<u8>
    pub floatable: u32
}

// What `getPathTypeFromState` reads of the world's tags and blocks.
struct Reads {
    trapdoors: BlockSet
    speleothems: BlockSet
    fences: BlockSet
    walls: BlockSet
    fire: BlockSet
    campfires: BlockSet
    lily_pad: u32
    big_dripleaf: u32
    powder_snow: u32
    cactus: u32
    sweet_berry_bush: u32
    honey_block: u32
    cocoa: u32
    wither_rose: u32
    lava: u32
    magma_block: u32
    lava_cauldron: u32
}

// The block `name`, or one no state is of where the world has none of that name.
fn named(f: Facts, name: str) -> u32 {
    return f.block_named(String(name)) ?? u32.MAX
}

// The fluids, a bit each by ID, in the fluid tag `name`.
fn fluid_mask(f: Facts, name: str) -> u32 {
    var mask = 0u32
    for fluid in 0..32 {
        if f.fluid_type_in(u32.wrap(fluid), String(name)) {
            mask = mask | (1u32 << u32.wrap(fluid))
        }
    }
    return mask
}

impl PathStates {
    /// As `f` has them, its tags those its level loaded.
    pub fn new(f: Facts) -> PathStates {
        let r = Reads {
            trapdoors: f.tag_or_empty(String("minecraft:trapdoors")),
            speleothems: f.tag_or_empty(String("minecraft:speleothems")),
            fences: f.tag_or_empty(String("minecraft:fences")),
            walls: f.tag_or_empty(String("minecraft:walls")),
            fire: f.tag_or_empty(String("minecraft:fire")),
            campfires: f.tag_or_empty(String("minecraft:campfires")),
            lily_pad: named(f, "minecraft:lily_pad"),
            big_dripleaf: named(f, "minecraft:big_dripleaf"),
            powder_snow: named(f, "minecraft:powder_snow"),
            cactus: named(f, "minecraft:cactus"),
            sweet_berry_bush: named(f, "minecraft:sweet_berry_bush"),
            honey_block: named(f, "minecraft:honey_block"),
            cocoa: named(f, "minecraft:cocoa"),
            wither_rose: named(f, "minecraft:wither_rose"),
            lava: named(f, "minecraft:lava"),
            magma_block: named(f, "minecraft:magma_block"),
            lava_cauldron: named(f, "minecraft:lava_cauldron"),
        }
        let water_mask = fluid_mask(f, "minecraft:water")
        let lava_mask = fluid_mask(f, "minecraft:lava")
        let facts = state_path_facts()
        var types = List<u8>()
        var computations = List<u8>()
        types.reserve(facts.len())
        computations.reserve(facts.len())
        for s in 0..facts.len() {
            let state = u32.wrap(s)
            let bits = facts[s]
            let fluid = 1u32 << f.fluid(state)
            let water = water_mask & fluid != 0
            let lava = lava_mask & fluid != 0
            var able = 0u32
            for t in 0..3 {
                let code = (bits >> u32.wrap(2 * t)) & 3
                if code == PATHFINDABLE_ALWAYS or (code == PATHFINDABLE_IN_WATER and water) or (code == PATHFINDABLE_NOT_IN_LAVA and not lava) {
                    able = able | (1u32 << u32.wrap(t))
                }
            }
            computations.push(u8.wrap(able))
            types.push(from_state(f, r, state, bits, water, lava, able & (1u32 << COMPUTATION_LAND) != 0))
        }
        return PathStates { types: types, computations: computations, floatable: fluid_mask(f, "minecraft:entity_floatable") }
    }

    /// The state's path type, `getPathTypeFromState`.
    pub fn of(self, state: u32) -> u8 {
        return self.types[usize(state)]
    }

    /// Whether `isPathfindable` holds for the state in `computation`, `COMPUTATION_LAND`,
    /// `COMPUTATION_WATER` or `COMPUTATION_AIR`.
    pub fn pathfindable(self, state: u32, computation: u32) -> bool {
        return u32(self.computations[usize(state)]) & (1u32 << computation) != 0
    }

    /// The path type of the block at `x`, `y`, `z`, `getPathTypeStatic`: an open block over the
    /// lowest of a level whose least y is `min_y` is open over an open, water, lava or walkable
    /// one, on fire, damaging, sticky with honey or cautious over one that is, on top of powder
    /// snow or a trapdoor over one, and over any other walkable, unless a block around it says
    /// otherwise. Each block's type is read through `cache`.
    pub fn at<B: CollisionBlocks>(self, blocks: B, cache: mut PathTypeCache, min_y: i32, x: i32, y: i32, z: i32) -> u8 {
        let t = cache.get_or_compute(self, blocks, x, y, z)
        if t != PATH_OPEN or y < min_y + 1 {
            return t
        }
        let below = cache.get_or_compute(self, blocks, x, y - 1, z)
        if below == PATH_OPEN or below == PATH_WATER or below == PATH_LAVA or below == PATH_WALKABLE {
            return PATH_OPEN
        }
        if below == PATH_FIRE or below == PATH_DAMAGING or below == PATH_STICKY_HONEY or below == PATH_DAMAGE_CAUTIOUS {
            return below
        }
        if below == PATH_POWDER_SNOW {
            return PATH_ON_TOP_OF_POWDER_SNOW
        }
        if below == PATH_TRAPDOOR {
            return PATH_ON_TOP_OF_TRAPDOOR
        }
        return self.around(blocks, mut cache, x, y, z, PATH_WALKABLE)
    }

    /// `checkNeighbourBlocks`: the first of the blocks around `x`, `y`, `z`, those beside it, above
    /// and below them, and above and below it, by x, then y, then z, from the least, that's
    /// damaging, on fire or lava, water or cautious makes it damaging, on fire, a water border or
    /// cautious in a neighbour; else it's `otherwise`.
    pub fn around<B: CollisionBlocks>(self, blocks: B, cache: mut PathTypeCache, x: i32, y: i32, z: i32, otherwise: u8) -> u8 {
        for dx in -1..2 {
            for dy in -1..2 {
                for dz in -1..2 {
                    if dx != 0 or dz != 0 {
                        let t = cache.get_or_compute(self, blocks, x + dx, y + dy, z + dz)
                        if t == PATH_DAMAGING {
                            return PATH_DAMAGING_IN_NEIGHBOR
                        }
                        if t == PATH_FIRE or t == PATH_LAVA {
                            return PATH_FIRE_IN_NEIGHBOR
                        }
                        if t == PATH_WATER {
                            return PATH_WATER_BORDER
                        }
                        if t == PATH_DAMAGE_CAUTIOUS {
                            return PATH_DAMAGE_CAUTIOUS
                        }
                    }
                }
            }
        }
        return otherwise
    }
}

/// The state at `x`, `y`, `z`, air where its chunk isn't loaded full.
pub fn state_at<B: CollisionBlocks>(blocks: B, x: i32, y: i32, z: i32) -> u32 {
    return blocks.collision_state(x, y, z) ?? AIR_STATE
}

// `getPathTypeFromState`, of the state's path facts `bits`, whether its fluid is in `#water` and
// `#lava`, and whether it's pathfindable on land.
fn from_state(f: Facts, r: Reads, state: u32, bits: u32, water: bool, lava: bool, land: bool) -> u8 {
    if f.is_air(state) {
        return PATH_OPEN
    }
    let b = f.block(state)
    if f.in_set(state, r.trapdoors) or b == r.lily_pad or b == r.big_dripleaf {
        return PATH_TRAPDOOR
    }
    if b == r.powder_snow {
        return PATH_POWDER_SNOW
    }
    if b == r.cactus or b == r.sweet_berry_bush {
        return PATH_DAMAGING
    }
    if b == r.honey_block {
        return PATH_STICKY_HONEY
    }
    if b == r.cocoa {
        return PATH_COCOA
    }
    if b == r.wither_rose or f.in_set(state, r.speleothems) {
        return PATH_DAMAGE_CAUTIOUS
    }
    if lava {
        return PATH_LAVA
    }
    // `isBurningBlock`, a lit campfire's `isLitCampfire`.
    if f.in_set(state, r.fire) or b == r.lava or b == r.magma_block or b == r.lava_cauldron {
        return PATH_FIRE
    }
    if f.in_set(state, r.campfires) and f.get_bool(state, String("lit")) {
        return PATH_FIRE
    }
    let kind = bits >> PATH_KIND_SHIFT
    if kind == PATH_KIND_DOOR_OPEN {
        return PATH_DOOR_OPEN
    }
    if kind == PATH_KIND_DOOR_BY_HAND {
        return PATH_DOOR_WOOD_CLOSED
    }
    if kind == PATH_KIND_DOOR_SHUT {
        return PATH_DOOR_IRON_CLOSED
    }
    if kind == PATH_KIND_RAIL {
        return PATH_RAIL
    }
    if kind == PATH_KIND_LEAVES {
        return PATH_LEAVES
    }
    if f.in_set(state, r.fences) or f.in_set(state, r.walls) or kind == PATH_KIND_GATE_SHUT {
        return PATH_FENCE
    }
    if not land {
        return PATH_BLOCKED
    }
    return if water { PATH_WATER } else { PATH_OPEN }
}
