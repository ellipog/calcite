/// A player's inventory, as vanilla's `Inventory` and the `PlayerEquipment` it shares with the
/// player hold it: 36 slots, the hotbar's 9 first, and the equipment, each slot a stack as
/// `ItemStack.CODEC` writes it, or nothing. Read from a player's data as
/// `Player.readAdditionalSaveData` reads it, written back as `addAdditionalSaveData` writes it,
/// and laid out as the inventory menu's slots, `InventoryMenu`'s (D372).
module world.inventory

import nbt.tag.{Tag}
import registry.components.{ItemCodecs}

/// The inventory's own slots, `Inventory.INVENTORY_SIZE`: the hotbar's 9, then 27 more.
pub const SLOTS: usize = 36

/// The inventory menu's slots: the crafting result and its 2 by 2 grid, the armor, head first,
/// the 27, the hotbar and the offhand.
pub const MENU_SLOTS: usize = 46

// `EquipmentSlot`s, by their place in its order.
const OFFHAND: usize = 1
const FEET: usize = 2
const LEGS: usize = 3
const CHEST: usize = 4
const HEAD: usize = 5
const EQUIPMENT: usize = 8

/// `EquipmentSlot`'s names, as its codec has them, in its order, which `EntityEquipment`'s map
/// keeps them in.
pub fn equipment_names() -> List<String> {
    return ["mainhand", "offhand", "feet", "legs", "chest", "head", "body", "saddle"]
}

/// A player's inventory. Made with `Inventory()`, it has nothing in any slot too.
pub struct Inventory {
    /// The 36 slots.
    pub items: List<Tag?> = List<Tag?>()
    /// The equipment, by `EquipmentSlot`'s order. A player's main hand is the hotbar slot they
    /// hold, so a stack a save has under `mainhand` is only kept, as `EntityEquipment.setAll`
    /// keeps it, and written back.
    pub equipment: List<Tag?> = List<Tag?>()
    /// The inventory menu's crafting grid, which isn't saved.
    pub crafting: List<Tag?> = List<Tag?>()
    /// `Inventory` and `equipment` as the player's data had them, for data saved before 26.3,
    /// which Calcite doesn't upgrade yet (D169): written back as they were until the inventory
    /// changes, so nothing an older version wrote is lost for not reading as 26.3's.
    kept: (Tag?, Tag?)? = none
}

impl Inventory {
    /// Nothing in any slot.
    pub fn empty() -> Inventory {
        return Inventory { items: nothing(SLOTS), equipment: nothing(EQUIPMENT), crafting: nothing(4), kept: none }
    }

    /// The inventory in a player's `data`, as `readAdditionalSaveData` reads it with `items`'
    /// codecs: `Inventory`, a list, each stack in it as `ItemStackWithSlot.CODEC` reads it, or
    /// what of it reads, in its slot where that's from 0 to 35, a later stack in place of an
    /// earlier; and `equipment`, a compound, each stack by its slot's name as
    /// `EntityEquipment.CODEC` reads it, one that doesn't read, or under a name that isn't a
    /// slot's, left out. `older` is whether the data was saved before 26.3.
    pub fn read(data: JavaHashMap<String, Tag>, items: ItemCodecs, older: bool) -> Inventory {
        var inv = Inventory.empty()
        if data.contains("Inventory") {
            match data["Inventory"] {
                Tag.List(list) => {
                    for each in list {
                        let read = items.slotted(each) else continue
                        let Tag.Compound(m) = read else continue
                        let slot = match m["Slot"] {
                            Tag.Byte(b) => usize(u8.wrap(b)),
                            _ => continue,
                        }
                        if slot < SLOTS {
                            var stack = m.copy()
                            _ = stack.remove("Slot")
                            inv.items[slot] = some(Tag.Compound(stack))
                        }
                    }
                },
                _ => {},
            }
        }
        if data.contains("equipment") {
            match data["equipment"] {
                Tag.Compound(m) => {
                    let names = equipment_names()
                    for (k, v) in m {
                        var named: usize? = none
                        for i in 0..names.len() {
                            if names[i] == k {
                                named = some(i)
                            }
                        }
                        let i = named else continue
                        if let stack = items.stack(v, true) {
                            inv.equipment[i] = some(stack)
                        }
                    }
                },
                _ => {},
            }
        }
        if older {
            let saved_items = if data.contains("Inventory") { some(data["Inventory"].copy()) } else { none }
            let saved_equipment = if data.contains("equipment") { some(data["equipment"].copy()) } else { none }
            inv.kept = some((saved_items, saved_equipment))
        }
        return inv
    }

    /// Writes the inventory into `data` as `addAdditionalSaveData` writes it: `Inventory`, a
    /// list, empty or not, of each stack with its `Slot`, as `ItemStackWithSlot.CODEC` writes
    /// it; and `equipment`, each stack by its slot's name, where `PlayerEquipment.isEmpty` says
    /// there's something, which it does too where the player holds something in the hotbar slot
    /// `selected`, and else none.
    pub fn write(self, data: mut JavaHashMap<String, Tag>, selected: i32) {
        var saved_items: Tag? = none
        var saved_equipment: Tag? = none
        let keeping = self.kept != none
        if let (i, e) = self.kept {
            saved_items = i.copy()
            saved_equipment = e.copy()
        }
        if let i = saved_items {
            data.insert(String("Inventory"), i)
        } else {
            var list = List<Tag>()
            for i in 0..SLOTS {
                if let stack = at(self.items, i) {
                    let Tag.Compound(m) = stack else continue
                    var slotted = JavaHashMap<String, Tag>()
                    slotted.insert(String("Slot"), Tag.Byte(i8.wrap(i32.wrap(i))))
                    for (k, v) in m {
                        slotted.insert(k.copy(), v.copy())
                    }
                    list.push(Tag.Compound(slotted))
                }
            }
            data.insert(String("Inventory"), Tag.List(list))
        }
        if keeping {
            if let e = saved_equipment {
                data.insert(String("equipment"), e)
            } else {
                _ = data.remove("equipment")
            }
            return
        }
        var worn = JavaHashMap<String, Tag>()
        let names = equipment_names()
        for i in 0..EQUIPMENT {
            if let stack = at(self.equipment, i) {
                worn.insert(names[i].copy(), stack.copy())
            }
        }
        if worn.is_empty() and self.selected(selected) == none {
            _ = data.remove("equipment")
        } else {
            data.insert(String("equipment"), Tag.Compound(worn))
        }
    }

    /// The stack in the hotbar slot `selected`, which is in the player's main hand.
    pub fn selected(self, selected: i32) -> Tag? {
        if selected < 0 or selected >= 9 {
            return none
        }
        return at(self.items, usize.wrap(selected))
    }

    /// The stack in the inventory menu's slot `n`: 0 the crafting result, which is nothing until
    /// Calcite has recipes, 1 to 4 the crafting grid, 5 to 8 the armor, head first, 9 to 35 the
    /// inventory's own, 36 to 44 the hotbar, and 45 the offhand.
    pub fn menu_slot(self, n: usize) -> Tag? {
        if n >= 1 and n <= 4 {
            return at(self.crafting, n - 1)
        }
        if n >= 5 and n <= 8 {
            return at(self.equipment, armor(n))
        }
        if n >= 9 and n <= 35 {
            return at(self.items, n)
        }
        if n >= 36 and n <= 44 {
            return at(self.items, n - 36)
        }
        if n == 45 {
            return at(self.equipment, OFFHAND)
        }
        return none
    }

    /// Puts `stack` in the inventory menu's slot `n`, from 1 to 45, as `Slot.set` puts it: the stack
    /// alone, where `world.menu`'s `put_by_player` also equips it, as `Slot.setByPlayer` does.
    pub fn set_menu_slot(mut self, n: usize, stack: own Tag?) {
        self.kept = none
        fill(mut self.items, SLOTS)
        fill(mut self.equipment, EQUIPMENT)
        fill(mut self.crafting, 4)
        if n >= 1 and n <= 4 {
            self.crafting[n - 1] = stack
        } else if n >= 5 and n <= 8 {
            self.equipment[armor(n)] = stack
        } else if n >= 9 and n <= 35 {
            self.items[n] = stack
        } else if n >= 36 and n <= 44 {
            self.items[n - 36] = stack
        } else if n == 45 {
            self.equipment[OFFHAND] = stack
        }
    }
}

// The equipment slot of the inventory menu's armor slot `n`, 5 to 8: `InventoryMenu.SLOT_IDS`,
// the head, chest, legs and feet.
fn armor(n: usize) -> usize {
    return if n == 5 { HEAD } else if n == 6 { CHEST } else if n == 7 { LEGS } else { FEET }
}

// The stack at `i` of `list`, nothing past its end, as an inventory made with `Inventory()` has.
fn at(list: List<Tag?>, i: usize) -> Tag? {
    if i < list.len() {
        return list[i].copy()
    }
    return none
}

// Makes `list` `n` slots long.
fn fill(list: mut List<Tag?>, n: usize) {
    while list.len() < n {
        list.push(none)
    }
}

fn nothing(n: usize) -> List<Tag?> {
    var out = List<Tag?>()
    for _ in 0..n {
        out.push(none)
    }
    return out
}
