/// Copper's stages as lightning scrapes them (CAL-326): `WeatheringCopper`'s steps from unaffected
/// to exposed, weathered and oxidized, read off the blocks' names as vanilla's maps pair them,
/// `copper_block` with `exposed_copper` and the rest by a prefix, and the waxed blocks, which
/// `HoneycombItem.WAX_OFF_BY_BLOCK` pairs with the copper they were.
module world.copper

import worldgen.facts.{Facts}
import worldgen.state_providers.{with_properties_of}

// The classes that weather, `WeatheringCopper`'s.
const WEATHERING: [str; 13] = ["WeatheringCopperBarsBlock", "WeatheringCopperBulbBlock", "WeatheringCopperChainBlock", "WeatheringCopperChestBlock", "WeatheringCopperDoorBlock", "WeatheringCopperFullBlock", "WeatheringCopperGolemStatueBlock", "WeatheringCopperGrateBlock", "WeatheringCopperSlabBlock", "WeatheringCopperStairBlock", "WeatheringCopperTrapDoorBlock", "WeatheringLanternBlock", "WeatheringLightningRodBlock"]

// The stages past unaffected, as their blocks' names begin.
const STAGES: [str; 3] = ["exposed_", "weathered_", "oxidized_"]

/// Whether the block weathers, `instanceof WeatheringCopper`.
pub fn weathers(f: Facts, block: u32) -> bool {
    for c in WEATHERING {
        if f.is_a(block, String(c)) {
            return true
        }
    }
    return false
}

/// Whether the block is waxed copper, a key of `WAX_OFF_BY_BLOCK`: `waxed_` and a block that
/// weathers.
pub fn waxed(f: Facts, block: u32) -> bool {
    let name = path_of(f, block)
    if not name.starts_with("waxed_") {
        return false
    }
    let plain = f.block_named("minecraft:{name[6..name.len()]}") else return false
    return weathers(f, plain)
}

/// The stage the state's block is at, `getAge`: 0 unaffected to 3 oxidized.
pub fn age(f: Facts, state: u32) -> i32 {
    let (stage, _) = stage_of(path_of(f, f.block(state)))
    return stage
}

/// `WeatheringCopper.getNext`: the state a stage on, its properties kept, none where it's
/// oxidized.
pub fn next(f: Facts, state: u32) -> u32? {
    let (stage, base) = stage_of(path_of(f, f.block(state)))
    if stage >= 3 {
        return none
    }
    return at_stage(f, state, base, stage + 1)
}

/// `WeatheringCopper.getFirst`: the state its block has unaffected, its properties kept, or the
/// state itself where its block doesn't weather.
pub fn first(f: Facts, state: u32) -> u32 {
    let block = f.block(state)
    let (stage, base) = stage_of(path_of(f, block))
    if stage == 0 {
        return state
    }
    return at_stage(f, state, base, 0) ?? state
}

/// `WeatheringCopper.getPrevious`: the state a stage back, its properties kept, none where it's
/// unaffected.
pub fn previous(f: Facts, state: u32) -> u32? {
    let block = f.block(state)
    let (stage, base) = stage_of(path_of(f, block))
    if stage == 0 {
        return none
    }
    return at_stage(f, state, base, stage - 1)
}

// The block's name without `minecraft:`.
fn path_of(f: Facts, block: u32) -> String {
    let name = f.codec.blocks.name(block)
    if name.starts_with("minecraft:") {
        return name[10..name.len()]
    }
    return name
}

// The stage a block's name is at, 0 unaffected to 3 oxidized, and its name unaffected:
// `exposed_copper`'s is `copper_block`.
fn stage_of(name: String) -> (i32, String) {
    for (i, p) in STAGES.enumerate() {
        if name.starts_with(p) {
            let rest = name[p.len()..name.len()]
            let base = if rest == "copper" { String("copper_block") } else { rest }
            return (i32.wrap(i) + 1, base)
        }
    }
    return (0, name.copy())
}

// `state` as the block `base` at `stage`, its properties kept, `withPropertiesOf`.
fn at_stage(f: Facts, state: u32, base: String, stage: i32) -> u32? {
    let name = if stage == 0 {
        base.copy()
    } else {
        let rest = if base == "copper_block" { String("copper") } else { base.copy() }
        "{STAGES[usize.wrap(stage - 1)]}{rest}"
    }
    let block = f.block_named("minecraft:{name}") else return none
    return some(with_properties_of(f, f.default_state(block), state))
}
