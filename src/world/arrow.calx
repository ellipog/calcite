/// An arrow, as vanilla's `Arrow` and its `AbstractArrow` and `Projectile` make and run it
/// (CAL-159): 0.5 by 0.5, its eyes 0.13 up, falling 0.05 a tick, its values `Entity`'s and its own,
/// `arrow_data`. Each tick, as `ServerLevel.tickNonPassenger` and `AbstractArrow.tick` run it:
/// inside the collision shape of the block it's in, with physics, it stops there, in the ground;
/// its shake from a landing goes down; water or rain puts its fire out. In the ground, where the
/// block it's in isn't the one it landed in and nothing's around it, `shouldFall`, it falls again,
/// its motion cut to a fifth or less each way, drawn, `startFalling`, or else it counts toward its
/// despawn, gone after 1200 ticks, `tickDespawn`; then what blocks do to it. In the air, water
/// slows it to 0.6; it turns a fifth of the way toward where it's going, `lerpRotation`; it looks
/// whether it's left its owner's box, `checkLeftOwner`; and with physics it goes along its motion,
/// `stepMoveAndHit`: the first block on its way, `clip` with `ClipContext.Block.COLLIDER`, held by
/// the world border, `clipIncludingBorder`, and the entities it may hit before that, `hits`, the
/// nearest first. Its level finds those and deals each hit (`world.entities`): it goes to the hit,
/// what blocks it went through act on it, and it hits, `strike` then `struck`, going on through
/// more where it pierces; or, with none, it goes to the block, and where it met one, lands,
/// `hit_block`, or where it met the border, bounces off it, `turn_back`. Without physics it goes
/// its motion whole. Then
/// the air slows it to 0.99 where it isn't in water; it falls, with physics, where it's not in the
/// ground; and `baseTick`, its fluids, its fire and its fall below the level, `tick_end`.
///
/// A hit on an entity, `onHitEntity`, deals the ceiling of its speed times its damage, more where
/// it's crit, drawn, of the type `arrow`, by it and caused by its owner, or itself where it has
/// none; a piercing arrow passes over what it's hit and goes once it's hit one more than its
/// level. Hurt, the entity has an arrow more in it, unless it pierces, and the arrow's hit sound's
/// heard, its pitch drawn, and it's gone unless it pierces; else it's turned back, a tenth as fast,
/// half round and a draw more, `deflect(REVERSE)`, and nearly stopped it's gone, dropping itself
/// where it may be picked up. Landing, `onHitBlock`, it keeps the block's state, moves back 0.05
/// along its way, stops, its sound heard, its pitch drawn, and lies in the ground, shaking 7 ticks,
/// neither crit nor piercing, its sound the hit's again. A player who touches it in the ground and
/// not shaking takes it, `playerTouch`, where it's theirs to take: a player's own, or one in
/// creative where only creative players may.
///
/// What blocks do to it, `applyEffectsFromBlocks`, is as for an orb (D435): fire and lava light
/// it, water and rain put it out, and its hurts are none but to have its motion sent, as
/// `Projectile.hurtServer` has it. What a block it lands on does of it, `onProjectileHit`, its
/// level deals where it's Calcite's to deal, `struck_by_level`, before it lands, `block_due`:
/// amethyst's chime, a burning arrow's lighting a campfire or a candle, a chorus flower's or a
/// decorated pot's breaking (CAL-159), a target block's signal, a bell's ring and a big dripleaf's
/// tilt. A wooden button it goes into its level presses, `Acted.Pressed`. Not yet: a burning
/// arrow's lighting TNT, `hit_missing`.
///
/// A tipped arrow's colour is its pickup item's potion's, `updateColor`, as it's made and loaded;
/// 600 ticks in the ground, its potion wears off, its puff shown, entity event 0, and it's a plain
/// arrow to pick up (D513). What its potion does to what it hurts, its level does.
///
/// It's saved as `saveAsPassenger` saves it, `saved`, and loaded as `EntityType.create` makes one
/// and `load` reads it in, `loaded`.
module world.arrow

import math.mth.{RAD_TO_DEG, table_atan2}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, BodyFacts, EntitySound, PROJECTILE_PORTAL_DELAY, bool_or, int_or, short_or, uuid_of, uuid_tag}
import world.clip.{BlockHit, clip_including_border}
import world.collision.{Aabb, CollisionBlocks}
import world.effects.{contents_color, contents_empty}
import world.entity_data.{AIR_SUPPLY, ARROW_FLAGS, CRIT_FLAG, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EFFECT_COLOR, EntityData, GLOWING_FLAG, IN_GROUND, NO_GRAVITY, ON_FIRE_FLAG, PIERCE_LEVEL, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, arrow_data}
import world.inside.{Acted, BlockEffect, Collector, EXTINGUISH, FIRE_IGNITE, LAVA_IGNITE, Movement, Rain, Touched, box_clip, doused, fluid_effects, inside_blocks, touch_block}
import world.loot.{LootEntity}
import world.movement.{Mover, MovementStates}
import worldgen.facts.{Facts}

/// Who may pick an arrow up, `AbstractArrow.Pickup`'s ordinals: no one, anyone, or only a player
/// in creative.
pub const DISALLOWED: i32 = 0
pub const ALLOWED: i32 = 1
pub const CREATIVE_ONLY: i32 = 2

/// How many ticks an arrow lies in the ground before it's gone, `tickDespawn`.
pub const ARROW_LIFE: i32 = 1200

/// How many ticks a tipped arrow lies in the ground before its potion wears off,
/// `EXPOSED_POTION_DECAY_TIME` (D513).
pub const POTION_DECAY: i32 = 600


/// What an arrow's level found of its owner, `getOwner`, for its tick: its entity ID; its box,
/// where it may be picked, `EntitySelector.CAN_BE_PICKED`, alive and not a spectator, which
/// `checkLeftOwner` looks for; and whether it's a player, with the name of their team, where
/// they're in one, and whether it allows friendly fire, `canHarmPlayer` (CAL-164).
pub struct OwnerView {
    pub id: i32
    pub bounds: Aabb?
    pub player: bool
    pub team: String? = none
    pub friendly_fire: bool = true
}

/// An entity its level found that an arrow may hit, `canBeHitByProjectile`, alive and pickable,
/// whose box meets the arrow's stretched along its motion and a block bigger: its ID, its box,
/// where it is, and whether it's a player.
pub struct Target {
    pub id: i32
    pub bounds: Aabb
    pub x: f64
    pub y: f64
    pub z: f64
    pub player: bool
}

/// An entity an arrow's way met, `EntityHitResult`: its ID, where, and whether it's a player.
pub struct ArrowHit {
    pub target: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub player: bool
}

/// The block an arrow struck, which its level deals before it lands, `onProjectileHit` (CAL-159):
/// where, its state, the face it met and where on it, whether the arrow's on fire, its owner's
/// UUID, and whether it has its own `can_break`, which an owner may need to break the block.
pub struct BlockStruck {
    pub x: i32
    pub y: i32
    pub z: i32
    pub state: u32
    pub face: i32
    pub at: (f64, f64, f64)
    pub burning: bool
    pub owner: (i64, i64)?
    pub can_break: bool
}

/// An arrow.
pub struct Arrow {
    /// What every entity has, `world.body`'s.
    pub body: Body
    /// Its values, `arrow_data`: on fire, its name and silence, its flags, crit and without
    /// physics, its pierce level and whether it's in the ground.
    pub data: EntityData
    /// Its owner's UUID, `Projectile.owner`; whether it's been out of its owner's box,
    /// `leftOwner`; and whether it's been shot, `hasBeenShot`, as its first tick in the air
    /// makes it.
    pub owner: (i64, i64)? = none
    pub left_owner: bool = false
    pub shot: bool = false
    /// Its ticks in the ground toward its despawn, `life`, and since it landed, `inGroundTime`.
    pub life: i32 = 0
    pub in_ground_time: i32 = 0
    /// The state of the block it landed on, `lastState`, and that state as it's saved,
    /// `inBlockState`.
    pub last_state: u32? = none
    pub in_block: Tag? = none
    /// How long it shakes from its landing, `shakeTime`; who may pick it up, `pickup`; its damage
    /// before its speed, `baseDamage`; the sound its hits make, `soundEvent`, by name.
    pub shake: i32 = 0
    pub pickup: i32 = 0
    pub base_damage: f64 = 2.0
    pub sound: String
    /// What it's picked up as, `pickupItemStack`, and the weapon it was shot from,
    /// `firedFromWeapon`.
    pub item: Tag
    pub weapon: Tag? = none
    /// The entities a piercing arrow's hit, `piercingIgnoreEntityIds`, and those of them it's
    /// killed, `piercedAndKilledEntities`, as they were as it killed them, for its owner's
    /// `KILLED_BY_ARROW` (CAL-164); both none till it pierces.
    pub pierced: List<i32>? = none
    pub pierced_killed: List<LootEntity>? = none
    /// The block its way meets this tick, the end of its steps, `stepMoveAndHit`'s.
    pub way: BlockHit
    /// The state of the block it struck, which it lands on once its level has dealt what the
    /// block does of it, `onProjectileHit`, `struck_by_level` (CAL-159).
    pub block_due: u32? = none
    /// What blocks did that its level's to do, with how many of its tick's sounds came before.
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
    // What it keeps to save as it was read, `can_break`.
    kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
}

impl Arrow {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z; nothing to pick up as but an
    // arrow, `getDefaultPickupItem`.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64) -> Arrow {
        let body = Body.made(id, seed, x, y, z, 0.5f32, 0.5f32, 0.13f32, 0.05)
        let way = BlockHit { x: x, y: y, z: z, face: 0, bx: 0, by: 0, bz: 0, missed: true }
        return Arrow { body: body, data: arrow_data(), sound: hit_sound(), item: default_item(), way: way }
    }

    /// The arrow a mob of the UUID `owner` shoots, `ArrowItem.createArrow` with it the shooter
    /// (CAL-159), with the ID `id` and a random seeded `seed`: at x, y, z, a tenth below its eyes
    /// as the caller has it, picked up as `item`, one of what it shoots, and shot from `weapon`;
    /// its owner the mob, which leaves no one to pick it up, as a mob's arrows are. What a tipped
    /// arrow's potion and the weapon's piercing do comes with them.
    pub fn fired(id: i32, seed: i64, x: f64, y: f64, z: f64, owner: (i64, i64), item: Tag, weapon: Tag) -> Arrow {
        var a = Arrow.made(id, seed, x, y, z)
        a.item = item.copy()
        a.update_color()
        a.weapon = some(weapon.copy())
        a.owner = some(owner)
        return a
    }

    /// `setBaseDamageFromMob` with the bow drawn to `power`, on the difficulty of the ID
    /// `difficulty` (CAL-159): twice the power and its random's triangle draw about a ninth of the
    /// difficulty's ID.
    pub fn base_from_mob(mut self, power: f32, difficulty: i32) {
        self.base_damage = f64(power * 2.0f32) + self.body.random.triangle(f64(difficulty) * 0.11, 0.57425)
    }

    /// `AbstractArrow.shoot` along xd, yd, zd at `pow` blocks a tick, `uncertainty` off
    /// (CAL-159): the way made a unit long, none where it's shorter than `1.0E-5F`, its random's
    /// three triangle draws across it added, x's first, then made `pow` long; facing that way,
    /// sent again, `needsSync`, and its ticks in the ground none.
    pub fn shoot(mut self, xd: f64, yd: f64, zd: f64, pow: f32, uncertainty: f32) {
        let dist = (xd * xd + yd * yd + zd * zd).sqrt()
        var x = 0.0
        var y = 0.0
        var z = 0.0
        if not (dist < f64(1.0e-5f32)) {
            x = xd / dist
            y = yd / dist
            z = zd / dist
        }
        let spread = 0.0172275 * f64(uncertainty)
        let ax = self.body.random.triangle(0.0, spread)
        let ay = self.body.random.triangle(0.0, spread)
        let az = self.body.random.triangle(0.0, spread)
        self.body.vx = (x + ax) * f64(pow)
        self.body.vy = (y + ay) * f64(pow)
        self.body.vz = (z + az) * f64(pow)
        self.body.needs_sync = true
        let across = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
        self.body.y_rot = f32.nearest((table_atan2(self.body.vx, self.body.vz) ?? 0.0) * RAD_TO_DEG)
        self.body.x_rot = f32.nearest((table_atan2(self.body.vy, across) ?? 0.0) * RAD_TO_DEG)
        self.life = 0
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// `Projectile`'s owner, as a UUID, whether it's left them where it has, and whether it's
    /// been shot; then its ticks in the ground, as a short, the state it landed on, its shake as
    /// a byte, whether it's in the ground, who may pick it up as a byte, its damage, whether it's
    /// crit, its pierce level, its hit sound's name, its item and its weapon; and what it kept.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:arrow")
        if let o = self.owner {
            t.insert(String("Owner"), uuid_tag(o))
        }
        if self.left_owner {
            t.insert(String("LeftOwner"), Tag.Byte(1i8))
        }
        t.insert(String("HasBeenShot"), flag(self.shot))
        t.insert(String("life"), Tag.Short(i16.wrap(self.life)))
        if let state = self.in_block {
            t.insert(String("inBlockState"), state.copy())
        }
        t.insert(String("shake"), Tag.Byte(i8.wrap(self.shake)))
        t.insert(String("inGround"), flag(self.in_ground()))
        t.insert(String("pickup"), Tag.Byte(i8.wrap(self.pickup)))
        t.insert(String("damage"), Tag.Double(self.base_damage))
        t.insert(String("crit"), flag(self.crit()))
        t.insert(String("PierceLevel"), Tag.Byte(self.pierce()))
        t.insert(String("SoundEvent"), Tag.Str(self.sound.copy()))
        t.insert(String("item"), self.item.copy())
        if let w = self.weapon {
            t.insert(String("weapon"), w.copy())
        }
        for (k, v) in self.kept {
            t.insert(k.copy(), v.copy())
        }
        return Tag.Compound(t)
    }

    /// The arrow `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `Entity.load` and `readAdditionalSaveData` read it in: what every entity
    /// reads, `world.body`'s, and its values from it; its owner, whether it left them and whether
    /// it was shot; its ticks in the ground, its shake as an unsigned byte, whether it's in the
    /// ground, its damage, 2 by default, who may pick it up, no one where it's not one of the
    /// three, whether it's crit, its pierce level and its hit sound, each with vanilla's
    /// defaults. Its item and weapon are as the caller read them with their codec, `item` none
    /// for an arrow, `weapon` none for none, and the state it landed on as the caller read it,
    /// `state`, its saved form kept. `none` where it's somewhere that isn't a number, logged in
    /// `lines` as `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, item: Tag?, weapon: Tag?, state: u32?, lines: mut List<Entry>) -> Arrow? {
        var a = Arrow.made(id, seed, 0.0, 0.0, 0.0)
        if not a.body.load_from(tag, mut lines) {
            return none
        }
        a.data.set(AIR_SUPPLY, Value.Number(a.body.air))
        if a.body.extras.contains("CustomName") {
            a.data.set(CUSTOM_NAME, Value.Name(a.body.extras["CustomName"].copy()))
        }
        a.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        a.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        a.data.set(NO_GRAVITY, Value.Bool(a.body.no_gravity))
        a.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        a.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        a.owner = uuid_of(tag, "Owner")
        a.left_owner = bool_or(tag, "LeftOwner")
        a.shot = bool_or(tag, "HasBeenShot")
        if tag.contains("can_break") {
            a.kept.insert(String("can_break"), tag["can_break"].copy())
        }
        a.life = i32(short_or(tag, "life", 0i16))
        if state != none and tag.contains("inBlockState") {
            a.last_state = state
            a.in_block = some(tag["inBlockState"].copy())
        }
        a.shake = int_or(tag, "shake", 0) & 255
        a.set_in_ground(bool_or(tag, "inGround"))
        a.base_damage = 2.0
        if tag.contains("damage") {
            a.base_damage = tag["damage"].number_double() ?? 2.0
        }
        let pickup = int_or(tag, "pickup", 0)
        a.pickup = if pickup >= 0 and pickup <= 2 { pickup } else { DISALLOWED }
        a.set_flag(CRIT_FLAG, bool_or(tag, "crit"))
        a.data.set(PIERCE_LEVEL, Value.Byte(i8.wrap(int_or(tag, "PierceLevel", 0))))
        if tag.contains("SoundEvent") {
            if let Tag.Str(name) = tag["SoundEvent"] {
                a.sound = namespaced(name.copy())
            }
        }
        if let stack = item {
            a.item = stack.copy()
        }
        a.update_color()
        a.weapon = weapon.copy()
        return some(a)
    }

    /// Whether it's in the ground, `isInGround`.
    pub fn in_ground(self) -> bool {
        return self.data.flag(IN_GROUND)
    }

    /// Whether it's crit, `isCritArrow`.
    pub fn crit(self) -> bool {
        return i32(self.data.byte(ARROW_FLAGS)) & CRIT_FLAG != 0
    }

    /// Its pierce level, `getPierceLevel`.
    pub fn pierce(self) -> i8 {
        return self.data.byte(PIERCE_LEVEL)
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// Its potion's colour, -1 for none.
    pub fn color(self) -> i32 {
        return self.data.number(EFFECT_COLOR)
    }

    /// Its colour as its pickup item's potion has it, `updateColor` (D513): -1 where that's
    /// `PotionContents.EMPTY`, else the potion's, `getColor`.
    fn update_color(mut self) {
        var color = -1
        if let contents = held_potion(self.item) {
            if not contents_empty(contents.copy()) {
                color = contents_color(contents)
            }
        }
        self.data.set(EFFECT_COLOR, Value.Number(color))
    }

    // Whether its pickup item holds a potion that isn't `PotionContents.EMPTY`.
    fn tipped(self) -> bool {
        let contents = held_potion(self.item) else return false
        return not contents_empty(contents)
    }

    fn set_in_ground(mut self, on: bool) {
        self.data.set(IN_GROUND, Value.Bool(on))
    }

    // `setFlag` of its own flags.
    fn set_flag(mut self, bit: i32, on: bool) {
        self.data.set_flag(ARROW_FLAGS, bit, on)
    }

    /// The first part of its tick, as `tickNonPassenger` and `AbstractArrow.tick` run it among
    /// `blocks`, in a level whose floor is `min_y`, where lava's fast if `fast_lava`, its owner as
    /// its level found them, `owner`, up to its steps along its way: whether it's to step, in the
    /// air with physics, toward `way`, held by the world border `border`, its west, north, east and
    /// south edges. Else its tick's done but where it has no physics, which `tick_end` ends here.
    /// Its sounds go to `sounds`.
    pub fn tick_start<B: CollisionBlocks + Rain>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, owner: OwnerView?, border: (f64, f64, f64, f64), sounds: mut List<EntitySound>) -> bool {
        // `commonTick`.
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        let physics = not self.body.no_physics
        let (bx, by, bz) = self.body.block()
        let state = blocks.collision_state(bx, by, bz) ?? 0
        if not f.is_air(state) and physics {
            for b in m.state_boxes(f, state, bx, by, bz, empty_context()) {
                let (px, py, pz) = (self.body.x - f64(bx), self.body.y - f64(by), self.body.z - f64(bz))
                if px >= b.min_x and px < b.max_x and py >= b.min_y and py < b.max_y and pz >= b.min_z and pz < b.max_z {
                    self.body.vx = 0.0
                    self.body.vy = 0.0
                    self.body.vz = 0.0
                    self.set_in_ground(true)
                    break
                }
            }
        }
        if self.shake > 0 {
            self.shake -= 1
        }
        if self.body.in_water or self.body.in_rain(blocks) {
            self.body.put_out()
        }
        if self.in_ground() and physics {
            if self.last_state != some(state) and self.should_fall(f, m, blocks) {
                self.start_falling()
            } else {
                self.life += 1
                if self.life >= ARROW_LIFE {
                    self.body.removed = true
                }
            }
            self.in_ground_time += 1
            if not self.body.removed {
                let moves = self.body.final_moves()
                self.blocks_act(f, blocks, moves, mut sounds)
            }
            let shown = self.body.fire_shown()
            self.set_on_fire(shown)
            // `Arrow.tick`'s, after: a tipped arrow long enough in the ground loses its potion,
            // its puff shown, and it's a plain arrow to pick up (D513). Gone, it's seen by no one.
            if not self.body.removed and self.in_ground() and self.in_ground_time >= POTION_DECAY and self.tipped() {
                self.act(Acted.Event(0i8), sounds.len())
                self.item = default_item()
                self.update_color()
            }
            return false
        }
        self.in_ground_time = 0
        if self.body.in_water {
            let slow = f64(0.6f32)
            self.body.vx = self.body.vx * slow
            self.body.vy = self.body.vy * slow
            self.body.vz = self.body.vz * slow
        }
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        let across = (vx * vx + vz * vz).sqrt()
        let aim_y = if physics { table_atan2(vx, vz) ?? 0.0 } else { table_atan2(-vx, -vz) ?? 0.0 }
        let aim_x = table_atan2(vy, across) ?? 0.0
        self.body.x_rot = lerp_rotation(self.body.x_rot, f32.nearest(aim_x * RAD_TO_DEG))
        self.body.y_rot = lerp_rotation(self.body.y_rot, f32.nearest(aim_y * RAD_TO_DEG))
        if not self.left_owner {
            self.left_owner = self.outside_owner(owner)
        }
        let from = (self.body.x, self.body.y, self.body.z)
        let to = (self.body.x + vx, self.body.y + vy, self.body.z + vz)
        if physics {
            self.way = clip_including_border(f, m, blocks, self.body.mover(), from, to, border)
            return true
        }
        self.body.x = self.body.x + vx
        self.body.y = self.body.y + vy
        self.body.z = self.body.z + vz
        let moves = self.body.final_moves()
        self.blocks_act(f, blocks, moves, mut sounds)
        self.tick_end(f, t, blocks, min_y, fast_lava, mut sounds)
        return false
    }

    // `isOutsideOwnerCollisionRange`: its box stretched along its motion and a block bigger meets
    // nothing of its owner that may be picked; true with no owner found.
    fn outside_owner(self, owner: OwnerView?) -> bool {
        let o = owner else return true
        let ob = o.bounds else return true
        let b = self.reach()
        return not ob.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z)
    }

    /// Its box stretched along its motion, `expandTowards`, and a block bigger, `inflate(1.0)`,
    /// where its level looks for what it may hit.
    pub fn reach(self) -> Aabb {
        var b = self.body.bounding_box()
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        if vx < 0.0 {
            b.min_x = b.min_x + vx
        } else if vx > 0.0 {
            b.max_x = b.max_x + vx
        }
        if vy < 0.0 {
            b.min_y = b.min_y + vy
        } else if vy > 0.0 {
            b.max_y = b.max_y + vy
        }
        if vz < 0.0 {
            b.min_z = b.min_z + vz
        } else if vz > 0.0 {
            b.max_z = b.max_z + vz
        }
        return Aabb { min_x: b.min_x - 1.0, min_y: b.min_y - 1.0, min_z: b.min_z - 1.0, max_x: b.max_x + 1.0, max_y: b.max_y + 1.0, max_z: b.max_z + 1.0 }
    }

    /// Whether it may hit the entity `id`, a player or not, as `canHitEntity` asks past its being
    /// alive and pickable: not a player where its owner's a player who may not harm them, as
    /// `harms_players` says, `canHarmPlayer`; not its owner while it hasn't left them,
    /// `isPassengerOfSameVehicle`; nor what it's pierced.
    pub fn may_hit(self, id: i32, player: bool, owner: OwnerView?, harms_players: bool) -> bool {
        if let o = owner {
            if player and o.player and not harms_players {
                return false
            }
            if not self.left_owner and o.id == id {
                return false
            }
        }
        if let ids = self.pierced {
            if ids.contains(id) {
                return false
            }
        }
        return true
    }

    /// `findHitEntities` from `from` to `to`, `getManyEntityHitResult` among `targets`, those it
    /// may hit in the order its level found them: each whose box the line goes into, there; else,
    /// past its second tick, where the line goes into its box grown by a margin, up to 0.3 a
    /// fiftieth a tick on, and the way from there to the box's middle, up to a block it meets, goes
    /// into the box, at where it went into the margin, that way held by the world border `border`,
    /// `clipIncludingBorder` (CAL-159). Then nearest first, by where each is from `from`, the order
    /// kept where they tie.
    pub fn hits<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, targets: List<Target>, from: (f64, f64, f64), to: (f64, f64, f64), border: (f64, f64, f64, f64)) -> List<ArrowHit> {
        var found = List<ArrowHit>()
        var near = List<f64>()
        let raw = f32.nearest(self.body.tick_count - 2) / 20.0f32
        let margin = f64(if raw < 0.3f32 { if raw > 0.0f32 { raw } else { 0.0f32 } } else { 0.3f32 })
        let (fx, fy, fz) = from
        for t in targets {
            let b = t.bounds
            var at = box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, from, to)
            if at == none and margin > 0.0 {
                if let outside = box_clip(b.min_x - margin, b.min_y - margin, b.min_z - margin, b.max_x + margin, b.max_y + margin, b.max_z + margin, from, to) {
                    let middle = (b.min_x + 0.5 * (b.max_x - b.min_x), b.min_y + 0.5 * (b.max_y - b.min_y), b.min_z + 0.5 * (b.max_z - b.min_z))
                    let way = clip_including_border(f, m, blocks, self.body.mover(), outside, middle, border)
                    if box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, outside, (way.x, way.y, way.z)) != none {
                        at = some(outside)
                    }
                }
            }
            let hit = at else continue
            let (hx, hy, hz) = hit
            let (dx, dy, dz) = (t.x - fx, t.y - fy, t.z - fz)
            let d = dx * dx + dy * dy + dz * dz
            // Kept in order, each after those as near or nearer, as a stable sort leaves them.
            var k = found.len()
            while k > 0 and near[k - 1] > d {
                k -= 1
            }
            found.insert(k, ArrowHit { target: t.id, x: hx, y: hy, z: hz, player: t.player })
            near.insert(k, d)
        }
        return found
    }

    /// `applyEffectsFromBlocks` of its step from `from` to where it is now (D435), as its
    /// `stepMoveAndHit` has it.
    pub fn step_acts<B: CollisionBlocks + Rain>(mut self, f: Facts, blocks: B, from: (f64, f64, f64), sounds: mut List<EntitySound>) {
        var moves = List<Movement>()
        moves.push(Movement { from: from, to: (self.body.x, self.body.y, self.body.z) })
        self.blocks_act(f, blocks, moves, mut sounds)
    }

    /// The damage its hit on the entity `id` deals, `onHitEntity` up to the hurt, `damage` its
    /// damage before its speed, its weapon's enchantments as its level made them: the ceiling of
    /// its speed, a float, times it, within an int; for a piercing arrow, what it kills kept from
    /// then on, and the entity kept as hit, unless it's hit as many as one more than its level,
    /// when it's gone and deals none; for a crit one, a draw of up to half that and 2 more added.
    pub fn strike(mut self, id: i32, damage: f64) -> i32? {
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        let pow = f32.nearest((vx * vx + vy * vy + vz * vz).sqrt())
        let raw = f64(pow) * damage
        let held = if raw < 0.0 { 0.0 } else if raw > 2.147483647e9 { 2.147483647e9 } else { raw }
        var dealt = i32.saturate(held.ceil())
        if self.pierce() > 0i8 {
            var ids = self.pierced.take() ?? List<i32>()
            let killed = self.pierced_killed.take() ?? List<LootEntity>()
            self.pierced_killed = some(killed)
            if ids.len() >= usize.wrap(i32(self.pierce()) + 1) {
                self.pierced = some(ids)
                self.body.removed = true
                return none
            }
            ids.push(id)
            self.pierced = some(ids)
        }
        if self.crit() {
            let more = i64(self.body.random.next_int_below(dealt / 2 + 2))
            let sum = more + i64(dealt)
            dealt = if sum > 2147483647 { 2147483647 } else { i32.wrap(sum) }
        }
        return some(dealt)
    }

    /// What follows its hit as `onHitEntity` goes on from the hurt, `hurt` whether it hurt what it
    /// hit: hurt, its hit sound, its pitch drawn, and gone unless it pierces; else turned back,
    /// `deflect(REVERSE)` at a fifth of its power, half round and up to 20 degrees more, drawn, a
    /// tenth as fast the other way, and nearly stopped, gone. Whether it then drops itself, where
    /// it may be picked up by anyone, `spawnAtLocation`.
    pub fn struck(mut self, hurt: bool, sounds: mut List<EntitySound>) -> bool {
        if hurt {
            self.play_hit(mut sounds)
            if self.pierce() <= 0i8 {
                self.body.removed = true
            }
            return false
        }
        self.turn_back()
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        if vx * vx + vy * vy + vz * vz < 1.0e-7 {
            self.body.removed = true
            return self.pickup == ALLOWED
        }
        return false
    }

    /// `deflect(REVERSE)` at a fifth of its power, as an arrow's turned back by what it didn't
    /// hurt or bounces off the world border, `shouldBounceOnWorldBorder` (CAL-159): half round
    /// and up to 20 degrees more, drawn, a tenth as fast the other way, and sent again,
    /// `needsSync`. Its owner stays its owner.
    pub fn turn_back(mut self) {
        let turn = 170.0f32 + self.body.random.next_float() * 20.0f32
        let back = -0.2 * 0.5
        self.body.vx = self.body.vx * back
        self.body.vy = self.body.vy * back
        self.body.vz = self.body.vz * back
        self.body.y_rot = self.body.y_rot + turn
        self.body.needs_sync = true
    }

    // `playSound` of its hit sound, at full volume, its pitch drawn whether it's heard or not.
    fn play_hit(mut self, sounds: mut List<EntitySound>) {
        let pitch = 1.2f32 / (self.body.random.next_float() * 0.2f32 + 0.9f32)
        if not self.silent() {
            sounds.push(EntitySound { sound: plain(self.sound), x: self.body.x, y: self.body.y, z: self.body.z, volume: 1.0f32, pitch: pitch, source: self.body.sound_source })
        }
    }

    /// `onHitBlock` of the block its way met, whose state is `state`, saved as `saved`: what the
    /// block does of it, `onProjectileHit`, said to be missing where it'd act, `hit_missing`;
    /// then it keeps the state, moves back 0.05 along its way, stops, its hit sound heard with its
    /// pitch drawn, and lies in the ground, shaking 7 ticks, neither crit nor piercing, its sound
    /// the hit's again and what it pierced and killed forgotten, `resetPiercedEntities`.
    pub fn hit_block(mut self, state: u32, saved: Tag, sounds: mut List<EntitySound>) {
        self.last_state = some(state)
        self.in_block = some(saved.copy())
        let back = f64(0.05f32)
        self.body.x = self.body.x - signum(self.body.vx) * back
        self.body.y = self.body.y - signum(self.body.vy) * back
        self.body.z = self.body.z - signum(self.body.vz) * back
        self.body.vx = 0.0
        self.body.vy = 0.0
        self.body.vz = 0.0
        self.play_hit(mut sounds)
        self.set_in_ground(true)
        self.shake = 7
        self.set_flag(CRIT_FLAG, false)
        self.data.set(PIERCE_LEVEL, Value.Byte(0i8))
        self.sound = hit_sound()
        let had = match self.pierced {
            some(_) => true,
            none => false,
        }
        if had {
            self.pierced = some(List<i32>())
        }
        let killed = match self.pierced_killed {
            some(_) => true,
            none => false,
        }
        if killed {
            self.pierced_killed = some(List<LootEntity>())
        }
    }

    /// What a block it lands on, of the state `state`, does of it that Calcite doesn't do yet,
    /// `onProjectileHit`, to be said: where it's on fire, TNT lit.
    pub fn hit_missing(self, f: Facts, state: u32) -> String? {
        let block = f.block(state)
        if self.body.fire > 0 and f.is_a(block, String("TntBlock")) {
            return some(String("TNT lit by burning projectiles"))
        }
        return none
    }

    /// Whether what a block of the state `state` does of it as it lands is its level's to deal
    /// first, `onProjectileHit` (CAL-159): amethyst's chime, a campfire's or a candle's lighting
    /// where it's on fire, a chorus flower's or a decorated pot's breaking, a target block's
    /// signal, a bell's ring and a big dripleaf's tilt.
    pub fn struck_by_level(self, f: Facts, state: u32) -> bool {
        let block = f.block(state)
        for cls in ["AmethystBlock", "ChorusFlowerBlock", "DecoratedPotBlock", "TargetBlock", "BellBlock", "BigDripleafBlock"] {
            if f.is_a(block, String(cls)) {
                return true
            }
        }
        return self.body.fire > 0 and (f.is_a(block, String("CampfireBlock")) or f.is_a(block, String("AbstractCandleBlock")))
    }

    /// The block of the state `state` its way met, `way`, as its level's to deal, `BlockStruck`.
    pub fn struck_block(self, state: u32) -> BlockStruck {
        return BlockStruck { x: self.way.bx, y: self.way.by, z: self.way.bz, state: state, face: self.way.face, at: (self.way.x, self.way.y, self.way.z), burning: self.body.fire > 0, owner: self.owner, can_break: self.kept.contains("can_break") }
    }

    /// The end of its tick, after its steps: the air's slowing, to 0.99, where it isn't in water;
    /// its fall, with physics, where it's not in the ground; then `Projectile.tick`'s, shot, and
    /// `baseTick`, as `tickNonPassenger` ends it.
    pub fn tick_end<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        if not self.body.in_water {
            let drag = f64(0.99f32)
            self.body.vx = self.body.vx * drag
            self.body.vy = self.body.vy * drag
            self.body.vz = self.body.vz * drag
        }
        if not self.body.no_physics and not self.in_ground() {
            let g = self.body.gravity_now()
            if g != 0.0 {
                self.body.vy = self.body.vy + -g
            }
        }
        self.shot = true
        // `baseTick`: its portal cooldown, and its way through the nether portal it's in, where
        // it's alive, its cooldown then a projectile's 2 (D578); its fluids, the currents pushing
        // it where it's not in the ground, `isPushedByFluid`, with a splash coming into water; its
        // fire, a tick of it gone, its hurt every 20 out of lava only its motion to be sent; its
        // fall halved in lava; gone below the level; and its flag.
        self.handle_portal(sounds.len())
        let pushed = not self.in_ground()
        _ = self.body.update_fluids_pushed(f, t, blocks, fast_lava, true, pushed, mut sounds)
        if self.body.fire_tick(false) {
            self.hurt_marked()
        }
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let shown = self.body.fire_shown()
        self.set_on_fire(shown)
        self.body.first_tick = false
    }

    /// `stepMoveAndHit`'s look at the nether portal its step took it into (D578): in one this
    /// tick, it's handled there and then, `handlePortal`, so it goes with the motion it had as
    /// its tick began, before the air slows it and it falls; `heard` the sounds of its tick so far.
    pub fn step_portal(mut self, heard: usize) {
        let p = self.body.portal_process else return
        if p.inside {
            self.handle_portal(heard)
        }
    }

    // `handlePortal` (D578): its portal cooldown counted down, then its way through the nether
    // portal it's in, where it's alive, its cooldown then a projectile's 2, `heard` the sounds of
    // its tick so far.
    fn handle_portal(mut self, heard: usize) {
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        let alive = not self.body.removed
        if let p = self.body.portal_goes(alive, PROJECTILE_PORTAL_DELAY) {
            let saved = self.saved()
            let way = self.body.travel(p, saved)
            self.act(Acted.Travel(way), heard)
        }
    }

    /// Whether a player may take it, as `playerTouch` asks before its pickup: in the ground or
    /// without physics, done shaking, and theirs to take, `tryPickup`, a creative player where only
    /// they may; anyone may take one where it fits in their inventory, which the caller tries.
    pub fn touchable(self) -> bool {
        return not self.body.removed and (self.in_ground() or self.body.no_physics) and self.shake <= 0
    }

    // `Projectile.hurtServer`'s look: its motion to be sent, `markHurt`, unless it's invulnerable.
    fn hurt_marked(mut self) {
        if not self.body.removed and not self.body.invulnerable {
            self.body.sync_velocity = true
        }
    }

    // `shouldFall`: in the ground with nothing around its place, 0.06 each way, that it'd meet,
    // `noCollision`, as an empty collision context sees blocks.
    fn should_fall<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B) -> bool {
        let (x, y, z) = (self.body.x, self.body.y, self.body.z)
        let b = Aabb { min_x: x - 0.06, min_y: y - 0.06, min_z: z - 0.06, max_x: x + 0.06, max_y: y + 0.06, max_z: z + 0.06 }
        return self.in_ground() and m.colliders(f, blocks, b, empty_context()).is_empty()
    }

    // `startFalling`: out of the ground, its motion each way cut to up to a fifth, drawn in turn,
    // and its ticks toward its despawn begun again.
    fn start_falling(mut self) {
        self.set_in_ground(false)
        let a = self.body.random.next_float() * 0.2f32
        let b = self.body.random.next_float() * 0.2f32
        let c = self.body.random.next_float() * 0.2f32
        self.body.vx = self.body.vx * f64(a)
        self.body.vy = self.body.vy * f64(b)
        self.body.vz = self.body.vz * f64(c)
        self.life = 0
    }

    // `applyEffectsFromBlocks` along `moves` (D435), as an orb's but for its hurts, which only
    // have its motion sent, and a wooden button's press, said to be missing.
    fn blocks_act<B: CollisionBlocks + Rain>(mut self, f: Facts, blocks: B, moves: List<Movement>, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        let froze = self.data.number(TICKS_FROZEN) > 0
        let was = (self.body.burning(false), froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                let block = f.block(i.state)
                // `ButtonBlock.entityInside`: a button arrows press, a wooden one, not pressed
                // yet, its level presses, `checkPressed` (CAL-159).
                if f.is_a(block, String("ButtonBlock")) and not f.get_bool(i.state, String("powered")) {
                    let name = f.codec.blocks.name(block)
                    if name != "minecraft:stone_button" and name != "minecraft:polished_blackstone_button" {
                        self.act(Acted.Pressed((i.x, i.y, i.z)), sounds.len())
                    }
                }
                match touch_block(f, i, mut c, false, false, self.body.on_ground, self.body.y) {
                    Touched.Cactus => self.hurt_marked(),
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.body.inside_portal(px, py, pz, PROJECTILE_PORTAL_DELAY),
                    Touched.EndPortal(_) => self.act(Acted.Missing(String("End portals taking what isn't a player")), sounds.len()),
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => {
                    if kind == FIRE_IGNITE {
                        if self.body.fire_ignite(false, 0) {
                            self.data.set(TICKS_FROZEN, Value.Number(0))
                        }
                    } else if kind == LAVA_IGNITE {
                        self.body.ignite_for(300)
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == EXTINGUISH {
                        self.body.put_out()
                    } else {
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    }
                },
                BlockEffect.InFire(_) => self.hurt_marked(),
                BlockEffect.LavaHurt => self.hurt_marked(),
                BlockEffect.Doused(_) => {
                    if self.body.burning(false) {
                        self.act(Acted.Missing(doused()), sounds.len())
                    }
                },
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.data.number(TICKS_FROZEN) > 0
        self.body.after_inside(false, was, freezing, rained, mut sounds)
    }

    // `setSharedFlagOnFire`.
    fn set_on_fire(mut self, on: bool) {
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, on)
    }

    // What a block did that its level's to do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }
}

// An empty collision context, `CollisionContext.empty()`, as an arrow's own look at the block it's
// in and around it has it: always above, never falling.
fn empty_context() -> Mover {
    return Mover { y: f64.MAX, fall: 0.0 }
}

/// The sound an arrow's hits make till it's told another, `SoundEvents.ARROW_HIT`.
pub fn hit_sound() -> String {
    return String("minecraft:entity.arrow.hit")
}

// The potion contents the stack `stack`'s own components hold, none where they hold none: an
// arrow's item, whose type gives it none but `PotionContents.EMPTY` (D513).
fn held_potion(stack: Tag) -> Tag? {
    let Tag.Compound(m) = stack else return none
    if not m.contains("components") {
        return none
    }
    let Tag.Compound(c) = m["components"] else return none
    if not c.contains("minecraft:potion_contents") {
        return none
    }
    return some(c["minecraft:potion_contents"].copy())
}

/// What an arrow's picked up as where it's told nothing else, `new ItemStack(Items.ARROW)`.
pub fn default_item() -> Tag {
    var stack = JavaHashMap<String, Tag>()
    stack.insert(String("id"), Tag.Str(String("minecraft:arrow")))
    stack.insert(String("count"), Tag.Int(1))
    return Tag.Compound(stack)
}

// `Projectile.lerpRotation`: from `from` a fifth of the way to `to`, the nearer way round.
fn lerp_rotation(from: f32, to: f32) -> f32 {
    var o = from
    while to - o < -180.0f32 {
        o -= 360.0f32
    }
    while to - o >= 180.0f32 {
        o += 360.0f32
    }
    return o + 0.2f32 * (to - o)
}

// `Math.signum`.
fn signum(v: f64) -> f64 {
    if v > 0.0 {
        return 1.0
    }
    if v < 0.0 {
        return -1.0
    }
    return v
}

// A boolean as `putBoolean` saves it.
fn flag(b: bool) -> Tag {
    return Tag.Byte(if b { 1i8 } else { 0i8 })
}

// The sound's name with its namespace, `minecraft:` where it has none.
fn namespaced(name: String) -> String {
    if name.contains(":") {
        return name.copy()
    }
    return "minecraft:{name}"
}

// The sound's name as Calcite plays it, without `minecraft:`.
fn plain(name: String) -> String {
    if name.starts_with("minecraft:") {
        return name[10..].copy()
    }
    return name.copy()
}
