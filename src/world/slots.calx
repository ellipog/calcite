/// The slots `item` reaches and what goes in them (D571): `SlotRanges`' names and the slots each
/// stands for, a slot source's slots as `SlotCollection` keeps them, the stacks put in them in
/// turn, `ItemProvider`, and which are picked, `SlotSelector`.
module world.slots

import nbt.tag.{Tag}

/// A slot of something that holds items, by its place in the list the caller keeps of them and
/// the slot's number, as `SlotProvider.getSlot` takes it.
pub struct SlotRef {
    pub owner: usize
    pub id: i32
}

/// What a slot source gives, `SlotCollection`: slots in turn; collections one after another,
/// `concat`; the slots of a collection whose stacks hold to an item predicate, `Filtered`; or as
/// many of a collection's as a limit lets in, `Limited`.
pub enum SlotSet {
    Of(List<SlotRef>)
    Concat(List<SlotSet>)
    Filtered(Box<SlotSet>, Tag)
    Limited(Box<SlotSet>, i32)
}

/// Which slots are picked, `SlotSelector`, as `item` makes it: `tracking`, with one count of
/// those picked for the whole command, so a limit inside lowers its limit on that same count, as
/// `TrackingSelector.limit` does; a slot with something in it only, where `non_empty`, as
/// `item modify` picks; and the item predicates its stack must hold to, as `filter` adds them.
pub struct Pick {
    pub limit: i32 = i32.MAX
    pub non_empty: bool = false
    pub filters: List<Tag> = List<Tag>()
}

impl Pick {
    /// `limit(n)`: the same, with `n` its limit where that's lower.
    pub fn limited(self, n: i32) -> Pick {
        var p = self.copy()
        if n < p.limit {
            p.limit = n
        }
        return p
    }

    /// `filter(predicate)`: the same, its stack also holding to `predicate`.
    pub fn filtered(self, predicate: Tag) -> Pick {
        var p = self.copy()
        p.filters.push(predicate.copy())
        return p
    }
}

/// The stacks `item replace`, `fill` and `override` put in turn, `ItemProvider`: `of`, each once;
/// `cycle`, round again for as long as there are slots; and `orElseProvide(EMPTY)`, each once and
/// then nothing for each slot left, `FallbackItemProvider`. Each target starts it again,
/// `restart`.
pub struct Provider {
    items: List<Tag?>
    at: usize = 0
    cycled: bool = false
    fallback: bool = false
    falling: bool = false
}

impl Provider {
    /// `ItemProvider.of(items)`.
    pub fn of(items: own List<Tag?>) -> Provider {
        return Provider { items: items }
    }

    /// `ItemProvider.cycle(items)`.
    pub fn cycle(items: own List<Tag?>) -> Provider {
        return Provider { items: items, cycled: true }
    }

    /// `ItemProvider.of(items).orElseProvide(ItemStack.EMPTY)`.
    pub fn or_empty(items: own List<Tag?>) -> Provider {
        return Provider { items: items, fallback: true }
    }

    /// `restart`.
    pub fn restart(mut self) {
        self.at = 0
        self.falling = false
    }

    /// `hasNext`.
    pub fn has_next(self) -> bool {
        if self.fallback {
            return true
        }
        if self.cycled {
            return not self.items.is_empty()
        }
        return self.at < self.items.len()
    }

    /// `next`: a copy of the next stack, `none` for `ItemStack.EMPTY`. Only called where
    /// `has_next` says there's one.
    pub fn next(mut self) -> Tag? {
        if self.fallback {
            if not self.falling {
                if self.at < self.items.len() {
                    self.at += 1
                    return self.items[self.at - 1].copy()
                }
                self.falling = true
            }
            return none
        }
        if self.items.is_empty() {
            return none
        }
        let i = if self.cycled { self.at % self.items.len() } else { self.at }
        self.at += 1
        if i >= self.items.len() {
            return none
        }
        return self.items[i].copy()
    }
}

/// The slots `SlotRanges` names `name` stands for, by their numbers, in its order, or `none` for
/// a name it hasn't: `contents`, 0; `container.` 0 to 53 from 0, `hotbar.` 0 to 8 from 0,
/// `inventory.` 0 to 26 from 9, `enderchest.` 0 to 26 from 200, `mob.inventory.` 0 to 7 from 300
/// and `horse.` 0 to 14 from 500, each alone and all with `*`; the hands, `weapon` the main one,
/// from 98; the armor, from 100, the body 105; the saddle 106; a horse's chest and a player's
/// cursor, 499; and a player's crafting grid, from 500.
pub fn range_slots(name: String) -> List<i32>? {
    if name == "contents" {
        return some([0])
    }
    let singles: List<(str, List<i32>)> = [
        ("weapon", [98]), ("weapon.mainhand", [98]), ("weapon.offhand", [99]), ("weapon.*", [98, 99]),
        ("armor.head", [103]), ("armor.chest", [102]), ("armor.legs", [101]), ("armor.feet", [100]), ("armor.body", [105]),
        ("armor.*", [103, 102, 101, 100, 105]), ("saddle", [106]), ("horse.chest", [499]), ("player.cursor", [499]),
    ]
    for (n, ids) in singles {
        if name == String(n) {
            return some(ids.copy())
        }
    }
    let ranges: List<(str, i32, i32)> = [("container.", 0, 54), ("hotbar.", 0, 9), ("inventory.", 9, 27), ("enderchest.", 200, 27), ("mob.inventory.", 300, 8), ("horse.", 500, 15), ("player.crafting.", 500, 4)]
    for (prefix, from, size) in ranges {
        if not name.starts_with(prefix) {
            continue
        }
        let rest = name[prefix.len()..].copy()
        if rest == "*" {
            var all = List<i32>()
            for i in 0..size {
                all.push(from + i)
            }
            return some(all)
        }
        for i in 0..size {
            if rest == "{i}" {
                return some([from + i])
            }
        }
        return none
    }
    return none
}
