/// How entities move against blocks, as vanilla's `Entity.move` collides them (CAL-148): the
/// blocks' shapes near a moving box, as `BlockCollisions` gives them, how far the box gets along
/// each axis before it meets one, `Shapes.collide`, in `Entity.collideWithShapes`' order; and each
/// block's friction, speed factor, jump factor, bounce and how much of a fall onto it it takes away.
///
/// Each state's shape is its collision shape as an entity sees it (`world.movement_shapes`). A
/// liquid has none, as `LiquidBlock` gives none to an entity that can't stand on fluids, and no
/// entity Calcite moves can. Bamboo, pointed dripstone and sulfur spikes are offset by where they
/// are, as `getOffset` says. Scaffolding is whole for an entity above its top that isn't going
/// down, and otherwise has only its bottom's slab, for one above its bottom, if it's unstable,
/// as `ScaffoldingBlock` says. Powder snow has a box 0.9 tall for an entity that has fallen more
/// than 2.5 blocks and none otherwise, as for every entity but a falling block and those that walk
/// on it. A shulker box's shape grows with its lid as it opens, half its progress along its
/// facing, as its block entity has it, `CollisionBlocks.shulker_progress`, and like every dynamic
/// shape it's looked for beside the box too (D695). A moving piston's shape, which comes from its
/// block entity, isn't here: it has none.
///
/// The blocks gone through are those within one of the box, as `Cursor3D` gives them, x fastest,
/// then y, then z: those it's in, those beside them on one face only if their shape can reach out
/// of their block, and none on an edge or a corner, as only moving pistons are checked there. A
/// block whose chunk isn't loaded full isn't one. A whole block is kept if it overlaps the box by
/// more than nothing; any other shape if one of its boxes overlaps it by more than 1.0E-7 on every
/// axis, as `Shapes.joinIsNotEmpty`'s merger takes coordinates closer than that for one.
///
/// `VoxelShape.collide` goes over a shape's grid of cells; here a shape is its boxes, which gives
/// the same distance for a box that doesn't overlap the shape, as an entity's doesn't while it has
/// physics: the nearest box ahead stops it, of those the moving box overlaps on the other two
/// axes, as `findIndex` rounds them, by more than 1.0E-7 one way and at least it the other, unless
/// that box is more than 1.0E-7 behind. Calcite's test checks vanilla's own cases.
///
/// Other entities' shapes, as a boat's, and the world border aren't among the shapes yet.
module world.movement

import world.block_flags.{LARGE_COLLISION, OFFSET}
import world.collision.{Aabb, CollisionBlocks, facing_steps, lid_grown}
import world.collision_shapes.{BOX_FLOOR, BOX_UNIT}
import world.movement_shapes.{factor_blocks, factors, grid_lines, grid_starts, shape_boxes, shape_starts, state_shapes}
import world.outline.{Outlines}
import worldgen.facts.{Facts}

/// The axes, as `Direction.Axis` numbers them.
pub const AXIS_X: i32 = 0
pub const AXIS_Y: i32 = 1
pub const AXIS_Z: i32 = 2

// The states whose shape isn't just their table's: those offset by where they are, scaffolding,
// stable or not, powder snow, and shulker boxes, whose lids open (D695).
const PLAIN: u8 = 0
const MOVED: u8 = 1
const SCAFFOLD: u8 = 2
const SCAFFOLD_UNSTABLE: u8 = 3
const POWDER_SNOW: u8 = 4
const SHULKER: u8 = 5
// Lava, a source and flowing, which what stands on lava stands on, a source's top half
// (CAL-392).
const LAVA_SOURCE: u8 = 6
const LAVA_FLOWING: u8 = 7

// What a state's visual shape is, `getVisualShape`, which a clip by sight reads (CAL-412): its
// collision shape; none, `TransparentBlock`'s, `IronBarsBlock`'s and powder snow's; a whole
// block, mud's and soul sand's; or its outline, a fence's and a snow layer's.
const SEEN_COLLIDER: u8 = 0
const SEEN_EMPTY: u8 = 1
const SEEN_FULL: u8 = 2
const SEEN_OUTLINE: u8 = 3

// The kind of `block`'s visual shape, by the class that gives it, `getVisualShape` (CAL-412).
fn visual_kind(f: Facts, block: u32, powder_snow: u32) -> u8 {
    if block == powder_snow or f.is_a(block, "TransparentBlock") or f.is_a(block, "IronBarsBlock") {
        return SEEN_EMPTY
    }
    if f.is_a(block, "MudBlock") or f.is_a(block, "SoulSandBlock") {
        return SEEN_FULL
    }
    if f.is_a(block, "FenceBlock") or f.is_a(block, "SnowLayerBlock") {
        return SEEN_OUTLINE
    }
    return SEEN_COLLIDER
}

/// What an entity is as its collisions see it, vanilla's `EntityCollisionContext`: how high its
/// feet are, `getY`, how far it has fallen, `fallDistance`, and whether it's going down, as a
/// player crouching is; whether it walks on powder snow, `canEntityWalkOnPowderSnow` (D698); and
/// whether it's a placement's context, `isPlacement`, as `getPreMoveCollisions` makes one, in
/// which powder snow and scaffolding have no shape (D698); and whether it stands on lava,
/// `canStandOnFluid`, a strider (CAL-392).
pub struct Mover {
    pub y: f64
    pub fall: f64
    pub descending: bool = false
    pub walks_on_snow: bool = false
    pub placement: bool = false
    pub stands_on_lava: bool = false
    /// Blocks whose shapes it meets none of, `MinecartCollisionContext` (CAL-315).
    pub skip_a: (i32, i32, i32)? = none
    pub skip_b: (i32, i32, i32)? = none
}

/// The shapes near a moving box, each moved to where it is, in the order `BlockCollisions` gives
/// them: their boxes, where each shape's end among them, and each one's block, which no shape of
/// an entity has. Each block's shape also has its number and where it was moved to, its offset
/// and then its place, which its grid of cells, `VoxelShape.getCoords`, is moved by, from
/// `table`; a shape of one box laid anywhere has none, its grid being that box's edges (CAL-338).
pub struct Colliders {
    pub boxes: List<Aabb>
    pub ends: List<usize>
    pub at: List<(i32, i32, i32)>
    pub grids: List<(u32, f64, f64, f64)?> = List<(u32, f64, f64, f64)?>()
    pub table: Shared<ShapeGrids>? = none
}

/// Every movement shape's grid, the lines its cells lie between on each axis,
/// `VoxelShape.getCoords`, as `world.movement_shapes` has them (CAL-338).
pub struct ShapeGrids {
    starts: List<u16>
    lines: List<u8>
}

impl Colliders {
    /// No shapes.
    pub fn new() -> Colliders {
        return Colliders { boxes: List<Aabb>(), ends: List<usize>(), at: List<(i32, i32, i32)>() }
    }

    /// Whether there are none.
    pub fn is_empty(self) -> bool {
        return self.ends.is_empty()
    }

    /// How many there are.
    pub fn len(self) -> usize {
        return self.ends.len()
    }

    /// Adds a shape of one box.
    pub fn add_box(mut self, b: Aabb) {
        self.boxes.push(b)
        self.ends.push(self.boxes.len())
        self.grids.push(none)
    }

    /// The shapes of the entities `boxes`, a box each, then these, as `collideBoundingBox` puts
    /// what `getEntityCollisions` found before the blocks' (CAL-315).
    pub fn after_entities(self, boxes: List<Aabb>) -> Colliders {
        if boxes.is_empty() {
            return self.copy()
        }
        var out = Colliders.new()
        for b in boxes {
            out.add_box(b)
        }
        let first = out.boxes.len()
        for b in self.boxes {
            out.boxes.push(b)
        }
        for e in self.ends {
            out.ends.push(e + first)
        }
        for k in 0..self.ends.len() {
            out.grids.push(if k < self.grids.len() { self.grids[k] } else { none })
        }
        out.at = self.at.copy()
        out.table = self.table.copy()
        return out
    }
}

/// What entities moving see of each block state and block.
pub struct MovementStates {
    // Each state's shape, and what kind of state it is.
    shapes: List<u16>
    kinds: List<u8>
    // The way each shulker box state's lid opens, its `facing`'s steps (D695).
    lids: Map<u32, (i32, i32, i32)>
    // Where each shape's boxes start in `boxes`, in boxes, and the boxes, six coordinates each.
    starts: List<u16>
    boxes: List<u8>
    // Where each block whose friction, speed factor, jump factor, bounce or fall distance reduction
    // isn't the default has them in `factors`, five each.
    factor_at: Map<u32, usize>
    factors: List<f32>
    // Every state's outline shape, which a clip by outlines reads (CAL-159).
    outlines: Outlines
    // Every state's visual shape, what kind it is, which a clip by sight reads (CAL-412).
    visuals: List<u8>
    // Every shape's grid (CAL-338).
    grids: Shared<ShapeGrids>
}

impl MovementStates {
    /// Every state's shape and every block's factors, the kinds of state as `f` says.
    pub fn new(f: Facts) -> MovementStates {
        let shapes = state_shapes()
        let scaffolding = f.block_named("minecraft:scaffolding") else panic("no scaffolding block")
        let powder_snow = f.block_named("minecraft:powder_snow") else panic("no powder snow block")
        let lava = f.block_named("minecraft:lava") else panic("no lava block")
        var kinds = List<u8>()
        var lids = Map<u32, (i32, i32, i32)>()
        kinds.reserve(shapes.len())
        for s in 0..shapes.len() {
            let state = u32.wrap(s)
            let block = f.block(state)
            if block == scaffolding {
                let distance = f.get_int(state, "distance") ?? 0
                kinds.push(if distance != 0 and f.get_bool(state, "bottom") { SCAFFOLD_UNSTABLE } else { SCAFFOLD })
            } else if block == powder_snow {
                kinds.push(POWDER_SNOW)
            } else if block == lava {
                kinds.push(if (f.get_int(state, "level") ?? 0) == 0 { LAVA_SOURCE } else { LAVA_FLOWING })
            } else if f.is_a(block, "ShulkerBoxBlock") {
                kinds.push(SHULKER)
                lids.insert(state, facing_steps(f.get_name(state, "facing") ?? String("up")))
            } else if f.flags(state) & OFFSET != 0 and shapes[s] != 0 {
                kinds.push(MOVED)
            } else {
                kinds.push(PLAIN)
            }
        }
        var factor_at = Map<u32, usize>()
        let blocks = factor_blocks()
        for i in 0..blocks.len() {
            factor_at.insert(blocks[i], i * 5)
        }
        var values = List<f32>()
        for bits in factors() {
            values.push(f32.from_bits(bits))
        }
        let grids = Shared(ShapeGrids { starts: grid_starts(), lines: grid_lines() })
        // Each block's visual shape's kind asked once, its states together (CAL-412).
        var visuals = List<u8>()
        visuals.reserve(shapes.len())
        var last = u32.MAX
        var seen = SEEN_COLLIDER
        for s in 0..shapes.len() {
            let block = f.block(u32.wrap(s))
            if block != last {
                last = block
                seen = visual_kind(f, block, powder_snow)
            }
            visuals.push(seen)
        }
        return MovementStates { shapes: shapes, kinds: kinds, lids: lids, starts: shape_starts(), boxes: shape_boxes(), factor_at: factor_at, factors: values, outlines: Outlines.new(), visuals: visuals, grids: grids }
    }

    /// Every shape's grid, shared (CAL-338).
    pub fn grid_table(self) -> Shared<ShapeGrids> {
        return self.grids.copy()
    }

    /// The boxes of `state`'s visual shape at x, y, z for an entity as `mover` is,
    /// `getVisualShape`, which a clip by sight reads (CAL-412): none for glass, bars, panes and
    /// powder snow; a whole block for mud and soul sand; a fence's and a snow layer's outline;
    /// else its collision shape, `boxes_at`.
    pub fn visual_boxes<B: CollisionBlocks>(self, f: Facts, blocks: B, state: u32, x: i32, y: i32, z: i32, mover: Mover) -> List<Aabb> {
        let seen = self.visuals[usize(state)]
        if seen == SEEN_EMPTY {
            return List<Aabb>()
        }
        if seen == SEEN_FULL {
            return [Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 }]
        }
        if seen == SEEN_OUTLINE {
            return self.outline_boxes(f, state, x, z)
        }
        return self.boxes_at(f, blocks, state, x, y, z, mover)
    }

    /// The outline shape of `state` at x, z, `getShape(level, pos)` with an empty context, as
    /// `world.outline` has it (CAL-159).
    pub fn outline_boxes(self, f: Facts, state: u32, x: i32, z: i32) -> List<Aabb> {
        return self.outlines.state_boxes(f, state, x, z)
    }

    /// The block's friction, `getFriction`: 0.6 but for ice and the like.
    pub fn friction(self, block: u32) -> f32 {
        return self.factor(block, 0, 0.6f32)
    }

    /// The block's speed factor, `getSpeedFactor`: 1 but for soul sand, honey and the like.
    pub fn speed_factor(self, block: u32) -> f32 {
        return self.factor(block, 1, 1.0f32)
    }

    /// The block's jump factor, `getJumpFactor`: 1 but for honey and the like.
    pub fn jump_factor(self, block: u32) -> f32 {
        return self.factor(block, 2, 1.0f32)
    }

    /// How much of its speed an entity falling on the block keeps going up, `getBounceRestitution`:
    /// 0 but for beds and slime.
    pub fn bounce(self, block: u32) -> f32 {
        return self.factor(block, 3, 0.0f32)
    }

    /// How much of a fall onto the block it takes away, `getFallDistanceReduction`: 0 but for beds
    /// and shelf mushrooms, which take half.
    pub fn fall_reduction(self, block: u32) -> f32 {
        return self.factor(block, 4, 0.0f32)
    }

    fn factor(self, block: u32, at: usize, normal: f32) -> f32 {
        if self.factor_at.contains(block) {
            return self.factors[self.factor_at[block] + at]
        }
        return normal
    }

    /// The top of the state's collision shape with an empty context at `x`, `z`, which an offset
    /// shape is moved by, `getCollisionShape(level, pos).max(Y)`, from its block's bottom: none
    /// where it has no shape, as pathfinding's floor levels read it (CAL-157).
    pub fn shape_top(self, f: Facts, state: u32, x: i32, z: i32) -> f64? {
        let shape = usize(self.shapes[usize(state)])
        if shape == 0 {
            return none
        }
        var oy = 0.0
        if self.kinds[usize(state)] == MOVED {
            let (_, y, _) = f.offset(state, x, z)
            oy = y
        }
        if shape == 1 {
            return some(1.0 + oy)
        }
        var top = 0.0
        for i in usize(self.starts[shape])..usize(self.starts[shape + 1]) {
            let max_y = self.coordinate(i * 6 + 4)
            if i == usize(self.starts[shape]) or max_y > top {
                top = max_y
            }
        }
        return some(top + oy)
    }

    /// Whether the state is a shulker box's, whose shape is its lid's (D695).
    pub fn is_lid(self, state: u32) -> bool {
        return self.kinds[usize(state)] == SHULKER
    }

    /// `state_boxes` in `blocks`, where a shulker box's lid opens as its block entity has it, its
    /// shape growing with it, `lid_box` (D695).
    pub fn boxes_at<B: CollisionBlocks>(self, f: Facts, blocks: B, state: u32, x: i32, y: i32, z: i32, mover: Mover) -> List<Aabb> {
        if self.kinds[usize(state)] == SHULKER {
            return [self.lid_box(state, blocks.shulker_progress(x, y, z))]
        }
        if self.on_lava(blocks, state, x, y, z, mover) {
            return [Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 0.5, max_z: 1.0 }]
        }
        return self.state_boxes(f, state, x, y, z, mover)
    }

    // Whether `mover` stands on the lava `state` at x, y, z, as `LiquidBlock.getCollisionShape`
    // gives what stands on lava a source's top half, `getLiquidCollisionShape`, where it's above
    // that, `isAbove`, and no lava's above it, `canStandOnFluid` (CAL-392).
    fn on_lava<B: CollisionBlocks>(self, blocks: B, state: u32, x: i32, y: i32, z: i32, mover: Mover) -> bool {
        if not mover.stands_on_lava or self.kinds[usize(state)] != LAVA_SOURCE {
            return false
        }
        if not (mover.y > f64(y) + 0.5 - f64(1.0e-5f32)) {
            return false
        }
        if let above = blocks.collision_state(x, y + 1, z) {
            let k = self.kinds[usize(above)]
            return k != LAVA_SOURCE and k != LAVA_FLOWING
        }
        return true
    }

    /// The boxes of the state's collision shape at x, y, z for an entity as `mover` is, from its
    /// block's least corner, as `getCollisionShape(level, pos, context)` gives them: an offset
    /// shape's moved, a scaffold's whole where the entity's above it and not going down or its
    /// unstable bottom's slab where it's above that, and powder snow's where it's falling (CAL-158);
    /// a shulker box's as it's shut, which `boxes_at` opens.
    pub fn state_boxes(self, f: Facts, state: u32, x: i32, y: i32, z: i32, mover: Mover) -> List<Aabb> {
        var out = List<Aabb>()
        let kind = self.kinds[usize(state)]
        let shape = usize(self.shapes[usize(state)])
        let fy = f64(y)
        if kind == SHULKER {
            out.push(Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 })
            return out
        }
        if kind == PLAIN {
            if shape == 1 {
                out.push(Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 })
            } else if shape != 0 {
                self.push_boxes(mut out, shape, 0.0, 0.0, 0.0)
            }
            return out
        }
        if kind == MOVED {
            let (ox, oy, oz) = f.offset(state, x, z)
            self.push_boxes(mut out, shape, ox, oy, oz)
            return out
        }
        if mover.placement and (kind == SCAFFOLD or kind == SCAFFOLD_UNSTABLE or kind == POWDER_SNOW) {
            return out
        }
        if kind == SCAFFOLD or kind == SCAFFOLD_UNSTABLE {
            if mover.y > fy + 1.0 - f64(1.0e-5f32) and not mover.descending {
                self.push_boxes(mut out, shape, 0.0, 0.0, 0.0)
            } else if kind == SCAFFOLD_UNSTABLE and mover.y > fy + 0.0 - f64(1.0e-5f32) {
                out.push(Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 0.125, max_z: 1.0 })
            }
            return out
        }
        if kind == POWDER_SNOW {
            if mover.fall > 2.5 {
                out.push(Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: f64(0.9f32), max_z: 1.0 })
            } else if mover.walks_on_snow and mover.y > fy + 1.0 - f64(1.0e-5f32) and not mover.descending {
                out.push(Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 })
            }
        }
        return out
    }

    /// Whether the state's collision shape at x, y, z for no entity, `CollisionContext.empty()`,
    /// meets a post 4 pixels across up the middle of its block, `CampfireBlock.SHAPE_VIRTUAL_POST`,
    /// so it stops a campfire's smoke, as `isSmokeyPos` finds it (CAL-177, CAL-221).
    pub fn stops_smoke(self, f: Facts, state: u32, x: i32, y: i32, z: i32) -> bool {
        for b in self.state_boxes(f, state, x, y, z, Mover { y: -1.0e300, fall: 0.0 }) {
            if b.min_x < 0.625 and b.max_x > 0.375 and b.min_z < 0.625 and b.max_z > 0.375 and b.min_y < 1.0 and b.max_y > 0.0 {
                return true
            }
        }
        return false
    }

    // The boxes of the shape `shape`, offset by ox, oy, oz, as `VoxelShape.move` makes them.
    fn push_boxes(self, out: mut List<Aabb>, shape: usize, ox: f64, oy: f64, oz: f64) {
        for i in usize(self.starts[shape])..usize(self.starts[shape + 1]) {
            let at = i * 6
            out.push(Aabb {
                min_x: self.coordinate(at) + ox,
                min_y: self.coordinate(at + 1) + oy,
                min_z: self.coordinate(at + 2) + oz,
                max_x: self.coordinate(at + 3) + ox,
                max_y: self.coordinate(at + 4) + oy,
                max_z: self.coordinate(at + 5) + oz,
            })
        }
    }

    /// Whether the states `a` and `b` at `x`, `z` have the same collision shape with an empty
    /// context, so `Shapes.joinIsNotEmpty(NOT_SAME)` finds nothing between them: the same shape,
    /// offset the same (CAL-157). Shapes are kept by their boxes, so two that hold the same space
    /// in different boxes are taken as different, which no two states' are known to.
    pub fn same_shape(self, f: Facts, a: u32, b: u32, x: i32, z: i32) -> bool {
        let shape = self.shapes[usize(a)]
        if shape != self.shapes[usize(b)] {
            return false
        }
        if shape == 0 {
            return true
        }
        let moved_a = self.kinds[usize(a)] == MOVED
        let moved_b = self.kinds[usize(b)] == MOVED
        if not moved_a and not moved_b {
            return true
        }
        let (ax, ay, az) = if moved_a { f.offset(a, x, z) } else { (0.0, 0.0, 0.0) }
        let (bx, by, bz) = if moved_b { f.offset(b, x, z) } else { (0.0, 0.0, 0.0) }
        return ax == bx and ay == by and az == bz
    }

    /// The boxes of the shape `shape`, where its block's least corner is 0, 0, 0. For tests.
    pub fn boxes_of(self, shape: u32) -> List<Aabb> {
        var out = List<Aabb>()
        let s = usize(shape)
        for i in usize(self.starts[s])..usize(self.starts[s + 1]) {
            let at = i * 6
            out.push(Aabb {
                min_x: self.coordinate(at),
                min_y: self.coordinate(at + 1),
                min_z: self.coordinate(at + 2),
                max_x: self.coordinate(at + 3),
                max_y: self.coordinate(at + 4),
                max_z: self.coordinate(at + 5),
            })
        }
        return out
    }

    /// The shapes of `blocks` near `b`, the box an entity sweeps as it moves, as `BlockCollisions`
    /// gives them for `mover`, each with its block.
    pub fn colliders<B: CollisionBlocks>(self, f: Facts, blocks: B, b: Aabb, mover: Mover) -> Colliders {
        var out = Colliders.new()
        out.table = some(self.grids.copy())
        // `Shapes.create` makes nothing of a box thinner than 1.0E-7, which meets no shape but a
        // whole block.
        let sized = not (b.max_x - b.min_x < 1.0e-7) and not (b.max_y - b.min_y < 1.0e-7) and not (b.max_z - b.min_z < 1.0e-7)
        let x0 = i32.saturate((b.min_x - 1.0e-7).floor()) - 1
        let x1 = i32.saturate((b.max_x + 1.0e-7).floor()) + 1
        let y0 = i32.saturate((b.min_y - 1.0e-7).floor()) - 1
        let y1 = i32.saturate((b.max_y + 1.0e-7).floor()) + 1
        let z0 = i32.saturate((b.min_z - 1.0e-7).floor()) - 1
        let z1 = i32.saturate((b.max_z + 1.0e-7).floor()) + 1
        for z in z0..=z1 {
            for y in y0..=y1 {
                for x in x0..=x1 {
                    var edges = 0
                    if x == x0 or x == x1 {
                        edges += 1
                    }
                    if y == y0 or y == y1 {
                        edges += 1
                    }
                    if z == z0 or z == z1 {
                        edges += 1
                    }
                    if edges >= 2 {
                        continue
                    }
                    let state = blocks.collision_state(x, y, z) else continue
                    if mover.skip_a == some((x, y, z)) or mover.skip_b == some((x, y, z)) {
                        continue
                    }
                    // A shulker box's shape is its block entity's, so it may be large,
                    // `hasLargeCollisionShape` for a dynamic shape (D695).
                    let lid = self.kinds[usize(state)] == SHULKER
                    if edges == 1 and f.flags(state) & LARGE_COLLISION == 0 and not lid {
                        continue
                    }
                    let had = out.ends.len()
                    if lid {
                        self.add_lid(mut out, state, blocks.shulker_progress(x, y, z), x, y, z, b, sized)
                    } else if self.on_lava(blocks, state, x, y, z, mover) {
                        let fx = f64(x)
                        let fy = f64(y)
                        let fz = f64(z)
                        let top = Aabb { min_x: fx, min_y: fy, min_z: fz, max_x: 1.0 + fx, max_y: 0.5 + fy, max_z: 1.0 + fz }
                        if sized and meets(top, b) {
                            out.add_box(top)
                        }
                    } else {
                        self.add_shape(f, mut out, state, x, y, z, b, mover, sized)
                    }
                    if out.ends.len() > had {
                        out.at.push((x, y, z))
                    }
                }
            }
        }
        return out
    }

    // The shape of the shulker box `state`, its lid `progress` open, from its block's least corner
    // (D695): `ShulkerBoxBlock.getShape`, `Shapes.create(getBoundingBox(state))`, the block grown
    // half its progress along its facing, `Shulker.getProgressAabb`, worked out from its bottom's
    // middle as vanilla works it out, `lid_grown`.
    fn lid_box(self, state: u32, progress: f32) -> Aabb {
        return lid_grown(self.lids.get(state) ?? (0, 1, 0), progress)
    }

    // Adds the shape of the shulker box `state` at x, y, z, its lid `progress` open, `lid_box`, to
    // `out` if it meets `b` (D695): shut, the whole block, kept where it overlaps the box by more
    // than nothing, and open, kept where it overlaps it by more than 1.0E-7.
    fn add_lid(self, out: mut Colliders, state: u32, progress: f32, x: i32, y: i32, z: i32, b: Aabb, sized: bool) {
        let fx = f64(x)
        let fy = f64(y)
        let fz = f64(z)
        let rel = self.lid_box(state, progress)
        let whole = rel.min_x == 0.0 and rel.min_y == 0.0 and rel.min_z == 0.0 and rel.max_x == 1.0 and rel.max_y == 1.0 and rel.max_z == 1.0
        let part = Aabb { min_x: rel.min_x + fx, min_y: rel.min_y + fy, min_z: rel.min_z + fz, max_x: rel.max_x + fx, max_y: rel.max_y + fy, max_z: rel.max_z + fz }
        if whole {
            if b.intersects(fx, fy, fz, fx + 1.0, fy + 1.0, fz + 1.0) {
                out.add_box(part)
            }
            return
        }
        if sized and meets(part, b) {
            out.add_box(part)
        }
    }

    // Adds the state's shape at x, y, z to `out` if it has one and meets `b`, as `BlockCollisions`
    // keeps it.
    fn add_shape(self, f: Facts, out: mut Colliders, state: u32, x: i32, y: i32, z: i32, b: Aabb, mover: Mover, sized: bool) {
        let kind = self.kinds[usize(state)]
        let shape = usize(self.shapes[usize(state)])
        let fx = f64(x)
        let fy = f64(y)
        let fz = f64(z)
        if kind == PLAIN {
            if shape == 0 {
                return
            }
            if shape == 1 {
                // `Shapes.block()`, kept where it overlaps the box by more than nothing.
                if b.intersects(fx, fy, fz, fx + 1.0, fy + 1.0, fz + 1.0) {
                    out.add_box(Aabb { min_x: fx, min_y: fy, min_z: fz, max_x: fx + 1.0, max_y: fy + 1.0, max_z: fz + 1.0 })
                }
                return
            }
            self.add_boxes(mut out, shape, 0.0, 0.0, 0.0, fx, fy, fz, b, sized)
            return
        }
        if kind == MOVED {
            let (ox, oy, oz) = f.offset(state, x, z)
            self.add_boxes(mut out, shape, ox, oy, oz, fx, fy, fz, b, sized)
            return
        }
        // A placement's context, `isPlacement`, as before a player's move (D698): none of
        // scaffolding's or powder snow's.
        if mover.placement and (kind == SCAFFOLD or kind == SCAFFOLD_UNSTABLE or kind == POWDER_SNOW) {
            return
        }
        if kind == SCAFFOLD or kind == SCAFFOLD_UNSTABLE {
            // `isAbove`: the entity's feet more than 1.0E-5F below the shape's top.
            if mover.y > fy + 1.0 - f64(1.0e-5f32) and not mover.descending {
                self.add_boxes(mut out, shape, 0.0, 0.0, 0.0, fx, fy, fz, b, sized)
            } else if kind == SCAFFOLD_UNSTABLE and mover.y > fy + 0.0 - f64(1.0e-5f32) {
                // `SHAPE_UNSTABLE_BOTTOM`, `Block.column(16, 0, 2)`.
                let slab = Aabb { min_x: fx, min_y: fy, min_z: fz, max_x: 1.0 + fx, max_y: 0.125 + fy, max_z: 1.0 + fz }
                if sized and meets(slab, b) {
                    out.add_box(slab)
                }
            }
            return
        }
        if kind == POWDER_SNOW and mover.fall > 2.5 {
            // `FALLING_COLLISION_SHAPE`, `Shapes.box(0, 0, 0, 1, 0.9F, 1)`.
            let snow = Aabb { min_x: fx, min_y: fy, min_z: fz, max_x: 1.0 + fx, max_y: f64(0.9f32) + fy, max_z: 1.0 + fz }
            if sized and meets(snow, b) {
                out.add_box(snow)
            }
        } else if kind == POWDER_SNOW and mover.walks_on_snow and mover.y > fy + 1.0 - f64(1.0e-5f32) and not mover.descending {
            // What walks on it, above it and not going down, `isAbove(Shapes.block(), pos, false)`:
            // a full block (D698).
            let snow = Aabb { min_x: fx, min_y: fy, min_z: fz, max_x: 1.0 + fx, max_y: 1.0 + fy, max_z: 1.0 + fz }
            if sized and meets(snow, b) {
                out.add_box(snow)
            }
        }
    }

    // Adds the shape `shape`, offset by ox, oy, oz and then moved to x, y, z as `VoxelShape.move`
    // adds each, to `out` if one of its boxes meets `b`.
    fn add_boxes(self, out: mut Colliders, shape: usize, ox: f64, oy: f64, oz: f64, x: f64, y: f64, z: f64, b: Aabb, sized: bool) {
        if not sized {
            return
        }
        let first = out.boxes.len()
        var met = false
        for i in usize(self.starts[shape])..usize(self.starts[shape + 1]) {
            let at = i * 6
            let part = Aabb {
                min_x: (self.coordinate(at) + ox) + x,
                min_y: (self.coordinate(at + 1) + oy) + y,
                min_z: (self.coordinate(at + 2) + oz) + z,
                max_x: (self.coordinate(at + 3) + ox) + x,
                max_y: (self.coordinate(at + 4) + oy) + y,
                max_z: (self.coordinate(at + 5) + oz) + z,
            }
            if not met and meets(part, b) {
                met = true
            }
            out.boxes.push(part)
        }
        if met {
            out.ends.push(out.boxes.len())
            out.grids.push(some((u32.wrap(shape), ox + x, oy + y, oz + z)))
        } else {
            out.boxes.truncate(first)
        }
    }

    // A box's coordinate, in blocks from its block's least corner: a 32nd, so exactly vanilla's.
    fn coordinate(self, at: usize) -> f64 {
        return f64(i32(self.boxes[at]) + BOX_FLOOR) / f64(BOX_UNIT)
    }
}

/// Whether `a` overlaps `b` by more than 1.0E-7 on every axis, as their shapes join (D420).
pub fn meets(a: Aabb, b: Aabb) -> bool {
    return overlap(a.min_x, a.max_x, b.min_x, b.max_x) and overlap(a.min_y, a.max_y, b.min_y, b.max_y) and overlap(a.min_z, a.max_z, b.min_z, b.max_z)
}

fn overlap(a0: f64, a1: f64, b0: f64, b1: f64) -> bool {
    let low = if a0 > b0 { a0 } else { b0 }
    let high = if a1 < b1 { a1 } else { b1 }
    return high - low > 1.0e-7
}

/// How far `b` moves by dx, dy, dz among the shapes `c`, `Entity.collideWithShapes`: along y
/// first, then along whichever of x and z it moves less on, then the other, each from where the
/// last left it, as `Direction.axisStepOrder` says. With no shapes at all it moves the whole way.
pub fn collide_with(c: Colliders, b: Aabb, dx: f64, dy: f64, dz: f64) -> (f64, f64, f64) {
    if c.is_empty() {
        return (dx, dy, dz)
    }
    var rx = 0.0
    var ry = 0.0
    var rz = 0.0
    if dy != 0.0 {
        ry = collide_along(c, AXIS_Y, moved(b, rx, ry, rz), dy)
    }
    if dx.abs() < dz.abs() {
        if dz != 0.0 {
            rz = collide_along(c, AXIS_Z, moved(b, rx, ry, rz), dz)
        }
        if dx != 0.0 {
            rx = collide_along(c, AXIS_X, moved(b, rx, ry, rz), dx)
        }
    } else {
        if dx != 0.0 {
            rx = collide_along(c, AXIS_X, moved(b, rx, ry, rz), dx)
        }
        if dz != 0.0 {
            rz = collide_along(c, AXIS_Z, moved(b, rx, ry, rz), dz)
        }
    }
    return (rx, ry, rz)
}

/// The box moved by x, y, z, `AABB.move`.
pub fn moved(b: Aabb, x: f64, y: f64, z: f64) -> Aabb {
    return Aabb { min_x: b.min_x + x, min_y: b.min_y + y, min_z: b.min_z + z, max_x: b.max_x + x, max_y: b.max_y + y, max_z: b.max_z + z }
}

/// The box stretched by x, y, z toward where it moves, `AABB.expandTowards`: the box it sweeps.
pub fn swept(b: Aabb, x: f64, y: f64, z: f64) -> Aabb {
    var out = Aabb { min_x: b.min_x, min_y: b.min_y, min_z: b.min_z, max_x: b.max_x, max_y: b.max_y, max_z: b.max_z }
    if x < 0.0 {
        out.min_x += x
    } else if x > 0.0 {
        out.max_x += x
    }
    if y < 0.0 {
        out.min_y += y
    } else if y > 0.0 {
        out.max_y += y
    }
    if z < 0.0 {
        out.min_z += z
    } else if z > 0.0 {
        out.max_z += z
    }
    return out
}

/// How far `b` moves along `axis` by `distance` among the shapes `c`, `Shapes.collide`: each in
/// turn cuts it short, and once it's less than 1.0E-7 either way it's nothing.
pub fn collide_along(c: Colliders, axis: i32, b: Aabb, distance: f64) -> f64 {
    var d = distance
    var start: usize = 0
    for k in 0..c.ends.len() {
        let stop = c.ends[k]
        if d.abs() < 1.0e-7 {
            return 0.0
        }
        let grid = if k < c.grids.len() { c.grids[k] } else { none }
        d = collide_shape(c.boxes, start, stop, c.table, grid, axis, b, d)
        start = stop
    }
    return d
}

/// How far `b` moves along `axis` by `distance` against the shape of `boxes` from `from` to `to`,
/// `VoxelShape.collide`: as far as the first of its cells ahead that's full where `b` is on the
/// other two axes. That's the nearest of its boxes ahead that `b` overlaps on those axes, or
/// where `b` is already in one of them, the first line of its grid past `b`'s edge, `findIndex`,
/// where that box goes on past it, so what starts inside a shape can't move through it. The grid
/// is the shape `grid` names of `table`, moved to where `grid` says, else its boxes' edges
/// (CAL-338).
pub fn collide_shape(boxes: List<Aabb>, from: usize, to: usize, table: Shared<ShapeGrids>?, grid: (u32, f64, f64, f64)?, axis: i32, b: Aabb, distance: f64) -> f64 {
    if from == to {
        return distance
    }
    if distance.abs() < 1.0e-7 {
        return 0.0
    }
    let low = lo(b, axis)
    let high = hi(b, axis)
    let p = (axis + 1) % 3
    let q = (axis + 2) % 3
    var found = false
    var nearest = 0.0
    if distance > 0.0 {
        for i in from..to {
            if not across(boxes, i, p, b) or not across(boxes, i, q, b) {
                continue
            }
            var start = box_lo(boxes, i, axis)
            if start <= high - 1.0e-7 {
                // `b` is in it: the first line past its edge, where this box fills the cell after.
                let line = grid_line(boxes, from, to, table, grid, axis, high - 1.0e-7, true) else continue
                if box_hi(boxes, i, axis) <= line + 1.0e-7 {
                    continue
                }
                start = line
            }
            if not found or start < nearest {
                nearest = start
                found = true
            }
        }
        if found {
            let gap = nearest - high
            if gap >= -1.0e-7 and gap < distance {
                return gap
            }
        }
        return distance
    }
    if distance < 0.0 {
        for i in from..to {
            if not across(boxes, i, p, b) or not across(boxes, i, q, b) {
                continue
            }
            var stop = box_hi(boxes, i, axis)
            if stop > low + 1.0e-7 {
                let line = grid_line(boxes, from, to, table, grid, axis, low + 1.0e-7, false) else continue
                if box_lo(boxes, i, axis) >= line - 1.0e-7 {
                    continue
                }
                stop = line
            }
            if not found or stop > nearest {
                nearest = stop
                found = true
            }
        }
        if found {
            let gap = nearest - low
            if gap <= 1.0e-7 and gap > distance {
                return gap
            }
        }
    }
    return distance
}

// The line of the grid of the shape of `boxes` from `from` to `to` along `axis` nearest past
// `value`: the first above it where `up`, else the last at or below it, none where there's none.
// The grid is the shape `grid` names of `table`, its lines moved to where `grid` says, as
// `VoxelShape.move` moves them; else, for a shape of one box laid anywhere, `Shapes.create`'s, that
// box's edges.
fn grid_line(boxes: List<Aabb>, from: usize, to: usize, table: Shared<ShapeGrids>?, grid: (u32, f64, f64, f64)?, axis: i32, value: f64, up: bool) -> f64? {
    var found = false
    var best = 0.0
    if let t = table {
        if let (shape, ox, oy, oz) = grid {
            let o = if axis == AXIS_X { ox } else if axis == AXIS_Y { oy } else { oz }
            let at = usize(shape) * 3 + usize.wrap(axis)
            if at + 1 < t.value.starts.len() {
                for i in usize(t.value.starts[at])..usize(t.value.starts[at + 1]) {
                    let line = f64(i32(t.value.lines[i]) + BOX_FLOOR) / f64(BOX_UNIT) + o
                    let past = if up { line > value } else { line <= value }
                    if past and (not found or (up and line < best) or (not up and line > best)) {
                        best = line
                        found = true
                    }
                }
                return if found { some(best) } else { none }
            }
        }
    }
    for i in from..to {
        for edge in [box_lo(boxes, i, axis), box_hi(boxes, i, axis)] {
            let past = if up { edge > value } else { edge <= value }
            if past and (not found or (up and edge < best) or (not up and edge > best)) {
                best = edge
                found = true
            }
        }
    }
    return if found { some(best) } else { none }
}

// Whether box `i` of `boxes` is within `b` on `axis` as `VoxelShape.collideX` counts its cells:
// one of them starts at least 1.0E-7 below `b`'s top and ends more than it above `b`'s bottom.
fn across(boxes: List<Aabb>, i: usize, axis: i32, b: Aabb) -> bool {
    return box_lo(boxes, i, axis) <= hi(b, axis) - 1.0e-7 and box_hi(boxes, i, axis) > lo(b, axis) + 1.0e-7
}

fn box_lo(boxes: List<Aabb>, i: usize, axis: i32) -> f64 {
    if axis == AXIS_X {
        return boxes[i].min_x
    }
    if axis == AXIS_Y {
        return boxes[i].min_y
    }
    return boxes[i].min_z
}

fn box_hi(boxes: List<Aabb>, i: usize, axis: i32) -> f64 {
    if axis == AXIS_X {
        return boxes[i].max_x
    }
    if axis == AXIS_Y {
        return boxes[i].max_y
    }
    return boxes[i].max_z
}

fn lo(b: Aabb, axis: i32) -> f64 {
    if axis == AXIS_X {
        return b.min_x
    }
    if axis == AXIS_Y {
        return b.min_y
    }
    return b.min_z
}

fn hi(b: Aabb, axis: i32) -> f64 {
    if axis == AXIS_X {
        return b.max_x
    }
    if axis == AXIS_Y {
        return b.max_y
    }
    return b.max_z
}


/// `CampfireBlock.isLitCampfire`: a campfire, `#campfires`, that's lit (CAL-177, CAL-221).
pub fn lit_campfire(f: Facts, state: u32) -> bool {
    return f.in_set(state, f.tag(String("minecraft:campfires"))) and f.get_bool(state, String("lit"))
}
