/// Vanilla's `RandomSequences` (CAL-153): the server's random sequences, the saved data
/// `random_sequences`, which a loot table with a random sequence draws from. Each is made the
/// first time it's asked for, from the world's seed, the salt and the sequence's name, as
/// `RandomSequence` makes it, and saved with the state it's drawn to.
module world.random_sequences

import nbt.tag.{Tag}
import random.source.{RandomSource}
import random.xoroshiro.{XoroshiroRandom, hash_of, mix_stafford13, unmixed}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data type the sequences are saved as, `RandomSequences.TYPE`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "random_sequences" }
}

/// The server's random sequences, by their names.
pub struct RandomSequences {
    /// What a new sequence's seed is mixed with, and whether the world's seed and the
    /// sequence's name go into it, as `/random reset` sets them.
    pub salt: i32 = 0
    pub include_world_seed: bool = true
    pub include_sequence_id: bool = true
    /// Each sequence's random, by its name in full, which a `JavaHashMap` keeps in the order
    /// vanilla's `CompoundTag` writes them.
    pub sequences: JavaHashMap<String, XoroshiroRandom> = JavaHashMap<String, XoroshiroRandom>()
    /// Whether it's changed since it was saved, as `setDirty` marks it: drawn from, or made
    /// afresh, as `computeIfAbsent` marks data it makes.
    pub dirty: bool = false
}

/// A sequence's random lent out to draw from, as `RandomSequences.get` wraps it in a
/// `DirtyMarkingRandomSource`: whether it's been drawn from, which marks the sequences to be
/// saved once it's given back.
pub struct SequenceRandom {
    pub random: XoroshiroRandom
    pub drew: bool = false
}

impl RandomSource for SequenceRandom {
    fn set_seed(mut self, seed: i64) {
        self.drew = true
        self.random.set_seed(seed)
    }

    fn next_int(mut self) -> i32 {
        self.drew = true
        return self.random.next_int()
    }

    fn next_int_below(mut self, bound: i32) -> i32 {
        self.drew = true
        return self.random.next_int_below(bound)
    }

    fn next_long(mut self) -> i64 {
        self.drew = true
        return self.random.next_long()
    }

    fn next_boolean(mut self) -> bool {
        self.drew = true
        return self.random.next_boolean()
    }

    fn next_float(mut self) -> f32 {
        self.drew = true
        return self.random.next_float()
    }

    fn next_double(mut self) -> f64 {
        self.drew = true
        return self.random.next_double()
    }

    fn next_gaussian(mut self) -> f64 {
        self.drew = true
        return self.random.next_gaussian()
    }
}

/// `RandomSequence.createSequence`: the random of a sequence from `seed`, with the name's hash
/// mixed in where there's one, as `Seed128bit.xor` and `mixed` mix them.
pub fn sequence_of(seed: i64, name: String?) -> XoroshiroRandom {
    var (lo, hi) = unmixed(seed)
    if let n = name {
        let (a, b) = hash_of(n)
        lo ^= a
        hi ^= b
    }
    return XoroshiroRandom.of(mix_stafford13(lo), mix_stafford13(hi))
}

impl RandomSequences {
    /// New sequences, as `computeIfAbsent` makes them where there's no file, or one that
    /// can't be read: marked to be saved.
    pub fn fresh() -> RandomSequences {
        return RandomSequences { dirty: true }
    }

    /// The sequence `name`, made from `world_seed` if it's not been asked for yet, as `get` makes
    /// it, lent out to draw from until it's given back with `give_back`.
    pub fn lend(mut self, name: String, world_seed: i64) -> SequenceRandom {
        if not self.sequences.contains(name) {
            let made = self.made(name, world_seed)
            self.sequences.insert(name.copy(), made)
        }
        return SequenceRandom { random: self.sequences[name] }
    }

    /// Gives back the sequence `name` that `lend` lent, as it's been drawn to, marking the
    /// sequences to be saved if it was drawn from.
    pub fn give_back(mut self, name: String, random: SequenceRandom) {
        if random.drew {
            self.dirty = true
        }
        self.sequences.insert(name.copy(), random.random)
    }

    // `createSequence(key, worldSeed)`, with the defaults the sequences have.
    fn made(self, name: String, world_seed: i64) -> XoroshiroRandom {
        let seed = (if self.include_world_seed { world_seed } else { 0 }) ^ i64(self.salt)
        return sequence_of(seed, if self.include_sequence_id { some(name.copy()) } else { none })
    }

    /// The sequences in the saved data's `root`, as `RandomSequences.CODEC` reads it with
    /// `resultOrPartial`: with vanilla's error for what can't be read, or `fresh` ones where
    /// nothing could be, as `computeIfAbsent` makes them. A sequence that can't be read is left
    /// out, and one whose source has more than two longs keeps the first two.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> RandomSequences {
        if not root.contains("data") {
            lines.push(parse_failed(saved_id(), String("Not a map: null")))
            return RandomSequences.fresh()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(saved_id(), "Not a map: {root["data"].to_snbt()}"))
                return RandomSequences.fresh()
            },
        }
        // Each field's error, in the fields' order, and whether it left nothing to go on: an
        // optional field that isn't what it should be is its default, as `optionalFieldOf`
        // reads it, with its error.
        var errors = List<String>()
        var whole = true
        var out = RandomSequences()
        if not data.contains("salt") {
            errors.push(no_key(data, "salt"))
            whole = false
        } else {
            match data["salt"].number_int() {
                some(v) => out.salt = v,
                none => {
                    errors.push(String("Not a number"))
                    whole = false
                },
            }
        }
        if data.contains("include_world_seed") {
            match data["include_world_seed"].number_bool() {
                some(v) => out.include_world_seed = v,
                none => errors.push(String("Not a number")),
            }
        }
        if data.contains("include_sequence_id") {
            match data["include_sequence_id"].number_bool() {
                some(v) => out.include_sequence_id = v,
                none => errors.push(String("Not a number")),
            }
        }
        if not data.contains("sequences") {
            errors.push(no_key(data, "sequences"))
            whole = false
        } else if let Tag.Compound(m) = data["sequences"] {
            // `unboundedMap`: each entry its name and its sequence, those that can't be read
            // noted, with what they were, after the errors, which are joined the last entry's
            // first, and within an entry its sequence's before its name's.
            var missed = JavaHashMap<String, Tag>()
            var message = String()
            for (key, value) in m {
                var got: XoroshiroRandom? = none
                var error = String()
                match Identifier.parse(key.copy()) {
                    ok(id) => {
                        match source_of(value) {
                            ok(r) => got = some(r),
                            err(e) => {
                                let (partial, text) = e
                                got = partial
                                error = text
                            },
                        }
                        // Two names the same once read, `a` and `minecraft:a`, keep the first.
                        if let r = got {
                            let name = id.to_string()
                            if out.sequences.contains(name) {
                                error = "Duplicate entry for key: '{name}'"
                            } else {
                                out.sequences.insert(name, r)
                            }
                        }
                    },
                    err(e) => {
                        error = "Not a valid resource location: {key} {e}"
                        match source_of(value) {
                            ok(_) => {},
                            err(f) => {
                                let (_, text) = f
                                error = "{text}; {error}"
                            },
                        }
                    },
                }
                if not error.is_empty() {
                    missed.insert(key.copy(), value.copy())
                    if not message.is_empty() {
                        error.push_str("; ")
                        error.push_str(message)
                    }
                    message = error
                }
            }
            if not message.is_empty() {
                message.push_str(" missed input: ")
                message.push_str(Tag.Compound(missed).to_snbt())
                errors.push(message)
            }
        } else {
            errors.push("Not a map: {data["sequences"].to_snbt()}")
            whole = false
        }
        if not errors.is_empty() {
            // Joined as the record codec joins them, the last field's first.
            var message = String()
            var i = errors.len()
            while i > 0 {
                i -= 1
                if not message.is_empty() {
                    message.push_str("; ")
                }
                message.push_str(errors[i])
            }
            lines.push(parse_failed(saved_id(), message))
            if not whole {
                return RandomSequences.fresh()
            }
        }
        return out
    }

    /// The sequences as `RandomSequences.CODEC` writes them, the file's `data`: the flags only
    /// where they're not their defaults, as `optionalFieldOf` writes them, and each source its
    /// state as two longs.
    pub fn pack(self) -> Tag {
        var fields = JavaHashMap<String, Tag>()
        fields.insert(String("salt"), Tag.Int(self.salt))
        if not self.include_world_seed {
            fields.insert(String("include_world_seed"), Tag.Byte(0))
        }
        if not self.include_sequence_id {
            fields.insert(String("include_sequence_id"), Tag.Byte(0))
        }
        var sequences = JavaHashMap<String, Tag>()
        for (name, r) in self.sequences {
            let (lo, hi) = r.seeds()
            var source = JavaHashMap<String, Tag>()
            source.insert(String("source"), Tag.LongArray([lo, hi]))
            sequences.insert(name.copy(), Tag.Compound(source))
        }
        fields.insert(String("sequences"), Tag.Compound(sequences))
        return Tag.Compound(fields)
    }
}

fn no_key(data: JavaHashMap<String, Tag>, name: str) -> String {
    return "No key {name} in MapLike[{Tag.Compound(data.copy()).to_snbt()}]"
}

// A sequence, `RandomSequence.CODEC`'s `source`, `XoroshiroRandomSource.CODEC`: a stream of
// two longs, as `NbtOps.getLongStream` reads a long array, or any list of numbers. Its error,
// with what it read anyway where it had more than two.
fn source_of(value: Tag) -> XoroshiroRandom ! (XoroshiroRandom?, String) {
    let m = match value {
        Tag.Compound(c) => c.copy(),
        _ => fail (none, "Not a map: {value.to_snbt()}"),
    }
    if not m.contains("source") {
        fail (none, no_key(m, "source"))
    }
    var longs = List<i64>()
    match m["source"] {
        Tag.LongArray(a) => longs = a.copy(),
        Tag.IntArray(a) => {
            for v in a {
                longs.push(i64(v))
            }
        },
        Tag.ByteArray(a) => {
            for v in a {
                longs.push(i64(v))
            }
        },
        Tag.List(items) => {
            for t in items {
                let v = t.number_long() else fail (none, "Some elements are not longs: {m["source"].to_snbt()}")
                longs.push(v)
            }
        },
        _ => fail (none, String("Not a list")),
    }
    if longs.len() != 2 {
        let message = String("Input is not a list of 2 longs")
        if longs.len() > 2 {
            fail (some(XoroshiroRandom.of(longs[0], longs[1])), message)
        }
        fail (none, message)
    }
    return XoroshiroRandom.of(longs[0], longs[1])
}
