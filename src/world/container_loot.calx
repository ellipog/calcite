/// Where a container's loot goes as it's first opened or looked into (CAL-295): the stacks a loot
/// table gave, split and put in its empty slots, as `LootTable.fill` does.
module world.container_loot

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.source.{RandomSource, shuffle}
import world.block_level.{BlockLevel, update_output_signal}
import world.drops.{DropLevel}
import world.loot.{LootEntity, LootParams, random_sequence, roll_table}
import world.menu.{count_of, with_count}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

/// `LootTable.fill` of a container whose slots are `filled` where they hold something, with the
/// stacks `items` its table gave, drawing from `random` as vanilla does: the empty slots shuffled,
/// `getAvailableSlots`; the stacks split to spread over them, `shuffleAndSplitItems`; then each
/// put in the last of the slots left, which it takes. What goes where, by slot; `true` after it
/// where there were more stacks than slots, as vanilla warns "Tried to over-fill a container".
pub fn fill_slots<R: RandomSource>(items: List<Tag?>, filled: List<bool>, random: mut R) -> (List<(usize, Tag)>, bool) {
    var slots = List<usize>()
    for i in 0..filled.len() {
        if not filled[i] {
            slots.push(i)
        }
    }
    shuffle(mut slots, mut random)
    let stacks = split_items(items, slots.len(), mut random)
    var out = List<(usize, Tag)>()
    for s in stacks {
        let slot = slots.pop() else return (out, true)
        out.push((slot, s.copy()))
    }
    return (out, false)
}

// `shuffleAndSplitItems`: nothing left out; each stack of more than one set aside to split; then,
// while the slots outnumber the stacks, one set aside, picked at random, split in two at random up
// to half of it, each part of more than one set aside again on a coin's toss; then the rest after
// the others, all of them shuffled.
fn split_items<R: RandomSource>(items: List<Tag?>, slots: usize, random: mut R) -> List<Tag> {
    var result = List<Tag>()
    var splittable = List<Tag>()
    for item in items {
        let s = item else continue
        let n = count_of(some(s.copy()))
        if n <= 0 {
            continue
        }
        if n > 1 {
            splittable.push(s.copy())
        } else {
            result.push(s.copy())
        }
    }
    while slots > result.len() + splittable.len() and not splittable.is_empty() {
        let at = usize.wrap(next_int(mut random, 0, i32.wrap(splittable.len()) - 1))
        let stack = splittable.remove(at)
        let count = count_of(some(stack.copy()))
        let remove = next_int(mut random, 1, count / 2)
        // `split`: the part taken, and what's left.
        let taken = remove.min(count)
        let rest = with_count(stack.copy(), count - taken)
        let part = with_count(stack, taken)
        set_aside(rest, mut splittable, mut result, mut random)
        set_aside(part, mut splittable, mut result, mut random)
    }
    for s in splittable {
        result.push(s.copy())
    }
    shuffle(mut result, mut random)
    return result
}

// A part of a split stack: set aside to split again where it's more than one and a coin says so,
// else among the stacks to put. Neither part of a split is empty, as it takes at most half.
fn set_aside<R: RandomSource>(part: own Tag?, splittable: mut List<Tag>, result: mut List<Tag>, random: mut R) {
    let s = part else return
    if count_of(some(s.copy())) > 1 and random.next_boolean() {
        splittable.push(s)
    } else {
        result.push(s)
    }
}

// `Mth.nextInt`: `min` itself where it's not below `max`, drawing nothing.
fn next_int<R: RandomSource>(random: mut R, min: i32, max: i32) -> i32 {
    if min >= max {
        return min
    }
    return random.next_int_below(max - min + 1) + min
}


/// `RandomizableContainer.unpackLootTable` of the container `state` at x, y, z as it's opened or
/// looked into, by `this`, a player of `luck`, where one is given (CAL-295): where it still has a
/// `LootTable`, the table's taken away with its seed, its loot made, `made`, and each stack put in
/// the container in turn, each `setItem`'s `setChanged` telling the comparators by it; a
/// decorated pot's one stack its `item`, `setTheItem`, which tells none (CAL-335). The table it had,
/// for `GENERATE_LOOT`; `none` where it had none.
pub fn unpack_loot<L: BlockAccess + BlockLevel + DropLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, this: LootEntity?, luck: f32) -> String? ! Thrown {
    let saved = level.block_entity_tag(x, y, z) else return none
    let table = loot_table_of(some(saved.copy())) else return none
    level.remove_block_entity_value(x, y, z, "LootTable")
    level.remove_block_entity_value(x, y, z, "LootTableSeed")
    let size = slots_for(saved.copy())
    var slots = List<Tag?>()
    for _ in 0..size {
        slots.push(none)
    }
    let pot = is_pot(saved.copy())
    for (slot, stack) in made(f, mut level, saved, x, y, z, this, luck) {
        slots[slot] = some(stack.copy())
        if pot {
            level.set_block_entity_value(x, y, z, "item", stack.copy())
            continue
        }
        level.set_block_entity_value(x, y, z, "Items", items_of(slots))
        try update_output_signal(f, mut level, f.block(state), x, y, z)
    }
    return some(table)
}

/// What the container `state` at x, y, z, saved as `saved`, holds once its loot's made, as it's
/// removed, `Containers.dropContents`'s `getItem`, `unpackLootTable` for no one (CAL-295): its
/// slots, each `setItem`'s `setChanged` telling the comparators by it of the block it was, but a
/// decorated pot's (CAL-335). `none` where it has no loot table.
pub fn removed_loot<L: BlockAccess + BlockLevel + DropLevel>(f: Facts, level: mut L, saved: Tag, state: u32, x: i32, y: i32, z: i32) -> List<Tag?>? ! Thrown {
    if loot_table_of(some(saved.copy())) == none {
        return none
    }
    var slots = List<Tag?>()
    for _ in 0..slots_for(saved.copy()) {
        slots.push(none)
    }
    let pot = is_pot(saved.copy())
    for (slot, stack) in made(f, mut level, saved, x, y, z, none, 0.0f32) {
        slots[slot] = some(stack.copy())
        if not pot {
            try update_output_signal(f, mut level, f.block(state), x, y, z)
        }
    }
    return some(slots)
}

// The loot the container at x, y, z, saved as `saved`, makes, by slot, in the order `fill` puts
// it: its table rolled with the block's centre for its origin and `this` for `THIS_ENTITY`,
// drawing from a random of its seed where that isn't 0, `withOptionalRandomSeed`, else from the
// table's random sequence, else the level's random. Its items aren't read while it has a table,
// `tryLoadLootTable`, so every slot's empty.
fn made<L: BlockAccess + BlockLevel + DropLevel>(f: Facts, level: mut L, saved: Tag, x: i32, y: i32, z: i32, this: LootEntity?, luck: f32) -> List<(usize, Tag)> {
    let table = loot_table_of(some(saved.copy())) else return List<(usize, Tag)>()
    let Tag.Compound(tags) = saved else return List<(usize, Tag)>()
    let seed = if tags.contains("LootTableSeed") { tags["LootTableSeed"].number_long() ?? 0 } else { 0i64 }
    let shared = level.world_loot() else {
        level.unimplemented(String("The loot a container makes as it's first opened"))
        return List<(usize, Tag)>()
    }
    let params = LootParams { origin: some((f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)), this_entity: this != none, this: this.copy(), luck: luck }
    var missing = List<String>()
    var filled = List<bool>()
    for _ in 0..slots_for(Tag.Compound(tags.copy())) {
        filled.push(false)
    }
    var got = (List<(usize, Tag)>(), false)
    if seed != 0 {
        var random = LegacyRandom.new(seed)
        let items = roll_table(shared.value, f, level, mut random, params, table.copy(), mut missing)
        got = fill_slots(items, filled, mut random)
    } else if let name = random_sequence(shared.value, table.copy()) {
        var random = level.lend_sequence(name.copy()) else {
            level.unimplemented(String("Random sequences where a level hasn't them"))
            return List<(usize, Tag)>()
        }
        let items = roll_table(shared.value, f, level, mut random, params, table.copy(), mut missing)
        got = fill_slots(items, filled, mut random)
        level.give_back_sequence(name, random)
    } else {
        var random = level.lend_level_random()
        let items = roll_table(shared.value, f, level, mut random, params, table.copy(), mut missing)
        got = fill_slots(items, filled, mut random)
        level.give_back_level_random(random)
    }
    let (placed, over) = got
    if over {
        level.warn(String("Tried to over-fill a container"))
    }
    for m in missing {
        level.unimplemented(m.copy())
    }
    return placed
}
/// The loot table a container's saved data `saved` still has to make, by its whole ID, as
/// `getLootTable` gives it; `none` where it has none.
pub fn loot_table_of(saved: Tag?) -> String? {
    let s = saved else return none
    let Tag.Compound(tags) = s else return none
    if not tags.contains("LootTable") {
        return none
    }
    let Tag.Str(table) = tags["LootTable"].copy() else return none
    return some(whole_id(table))
}

/// An ID with the namespace `minecraft` where it names none, as `Identifier.parse` reads it.
pub fn whole_id(id: own String) -> String {
    if id.contains(":") {
        return id
    }
    return "minecraft:{id}"
}

// How many slots a container that keeps a loot table has, `getContainerSize`, by its saved `id`.
fn slots_for(saved: Tag) -> usize {
    var kind = String()
    if let Tag.Compound(m) = saved {
        if m.contains("id") {
            if let Tag.Str(k) = m["id"] {
                kind = k.copy()
            }
        }
    }
    if kind == "minecraft:dispenser" or kind == "minecraft:dropper" or kind == "minecraft:crafter" {
        return 9
    }
    if kind == "minecraft:hopper" {
        return 5
    }
    // A decorated pot's one, `ContainerSingleItem` (CAL-335).
    if kind == "minecraft:decorated_pot" {
        return 1
    }
    return 27
}

// Whether the saved data `saved` is a decorated pot's, which keeps its one stack as `item`.
fn is_pot(saved: Tag) -> bool {
    let Tag.Compound(m) = saved else return false
    if not m.contains("id") {
        return false
    }
    let Tag.Str(k) = m["id"].copy() else return false
    return k == "minecraft:decorated_pot"
}

// `ContainerHelper.saveAllItems`: each stack held with its `Slot`, in order.
pub fn items_of(slots: List<Tag?>) -> Tag {
    var list = List<Tag>()
    for i in 0..slots.len() {
        let stack = slots[i].copy() else continue
        let Tag.Compound(m) = stack else continue
        var slotted = JavaHashMap<String, Tag>()
        slotted.insert(String("Slot"), Tag.Byte(i8.wrap(i32.wrap(i))))
        for (k, v) in m {
            slotted.insert(k.copy(), v.copy())
        }
        list.push(Tag.Compound(slotted))
    }
    return Tag.List(list)
}
