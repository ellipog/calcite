/// A flat world as vanilla's classic superflat preset makes it, in a dimension of the overworld's
/// height: bedrock at the bottom, two layers of dirt and grass on top, and plains everywhere, so
/// every chunk is the same and is written once for them all.
module world.flat

import protocol.play.{ChunkData, ClientboundLevelChunkWithLight, Heightmap, LightData, LightLayer}
import protocol.state.{State}
import protocol.wire.{Writer}

/// The lowest block of the overworld, and how many sections of 16 blocks it has.
pub const MIN_Y: i32 = -64
pub const SECTIONS: i32 = 24

/// The first block above the ground, where a player stands.
pub const SURFACE_Y: i32 = -60

/// The block states a flat chunk is made of, by their IDs, and its biome's ID in the
/// `worldgen/biome` registry.
pub struct FlatBlocks {
    pub air: i32
    pub bedrock: i32
    pub dirt: i32
    pub grass_block: i32
    pub biome: i32
}

/// Every chunk of the world, ready to send: the bytes of a `level_chunk_with_light` after its
/// position, which are the same for each.
pub struct FlatWorld {
    body: List<u8>
}

impl FlatWorld {
    pub fn new(blocks: FlatBlocks) -> FlatWorld {
        let chunk = ChunkData { heightmaps: heightmaps(), sections: sections(blocks), block_entities: [] }
        var w = Writer.new()
        chunk.write(mut w)
        light().write(mut w)
        return FlatWorld { body: w.into_bytes() }
    }

    /// The chunk at `x`, `z` as a play packet, its ID and fields.
    pub fn chunk_packet(self, x: i32, z: i32) -> List<u8> {
        var w = Writer.new()
        w.varint(ClientboundLevelChunkWithLight.id(State.Play))
        w.i32(x)
        w.i32(z)
        w.raw(self.body)
        return w.into_bytes()
    }
}

// Each section as `LevelChunkSection.write` writes it: how many blocks aren't air and how many
// hold a fluid, then the block states and the biomes, each a palette and the values packed in
// longs. The bottom section's palette lists its states as generating it adds them, from the
// bottom layer up, after the air it starts as; with 4 states, each takes 4 bits, 16 to a long.
// The sections above are all air.
fn sections(b: FlatBlocks) -> List<u8> {
    var w = Writer.new()
    w.i16(1024)
    w.i16(0)
    w.u8(4)
    w.varint(4)
    w.varint(b.air)
    w.varint(b.bedrock)
    w.varint(b.dirt)
    w.varint(b.grass_block)
    // A layer is 256 blocks, so 16 longs, of one value.
    let layers: [i64; 4] = [0x1111111111111111, 0x2222222222222222, 0x2222222222222222, 0x3333333333333333]
    for v in layers {
        for _ in 0..16 {
            w.i64(v)
        }
    }
    for _ in 0..192 {
        w.i64(0)
    }
    single(mut w, b.biome)
    for _ in 1..SECTIONS {
        w.i16(0)
        w.i16(0)
        single(mut w, b.air)
        single(mut w, b.biome)
    }
    return w.into_bytes()
}

// A palette of one value, which needs no bits and so no longs.
fn single(w: mut Writer, id: i32) {
    w.u8(0)
    w.varint(id)
}

// The heightmaps the client is sent, the surface, what blocks motion and the same without
// leaves, as `Heightmap.Types` numbers them. Each column's height is one above its top block,
// from the bottom of the world, so 4, in 9 bits, 7 to a long.
fn heightmaps() -> List<Heightmap> {
    var full: i64 = 0
    for k in 0..7 {
        full |= i64(4) << (i64(k) * 9)
    }
    var last: i64 = 0
    for k in 0..4 {
        last |= i64(4) << (i64(k) * 9)
    }
    var data = List<i64>()
    for _ in 0..36 {
        data.push(full)
    }
    data.push(last)
    var out = List<Heightmap>()
    for kind in [1, 4, 5] {
        out.push(Heightmap { kind: kind, data: data.copy() })
    }
    return out
}

// The light vanilla's engines keep for a flat chunk: only for the sections next to one with
// blocks, the one below the world up to the second section. There's no block light. Sky
// light is 15 where the sky reaches, from the surface up, and 0 in the ground and below the
// world. Each layer is a nibble a block, two to a byte, in `y`, `z`, `x` order.
fn light() -> LightData {
    var bottom = List<u8>()
    for i in 0..2048 {
        bottom.push(if i < 512 { 0 } else { 0xFF })
    }
    var above = List<u8>()
    for _ in 0..2048 {
        above.push(0xFF)
    }
    return LightData { sky_mask: [6], block_mask: [], empty_sky_mask: [1], empty_block_mask: [7], sky: [LightLayer { data: bottom }, LightLayer { data: above }], block: [] }
}
