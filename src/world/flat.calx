/// A flat world as vanilla's classic superflat preset makes it, in a dimension of the overworld's
/// height: bedrock at the bottom, two layers of dirt and grass on top, and plains everywhere, so
/// every chunk is the same and is written once for them all.
module world.flat

import protocol.play.{ClientboundLevelChunkWithLight, LightData}
import protocol.state.{State}
import protocol.wire.{Writer}
import world.chunk.{BlockStates, Chunk}
import world.light.{Light, LightChunks, LightStates, SectionStates, SkySources, light_sources, section_bytes, section_states}

/// The lowest block of the overworld, and how many sections of 16 blocks it has.
pub const MIN_Y: i32 = -64
pub const SECTIONS: i32 = 24

/// The first block above the ground, where a player stands.
pub const SURFACE_Y: i32 = -60

/// The block states a flat chunk is made of, by their IDs, and its biome's ID in the
/// `worldgen/biome` registry.
pub struct FlatBlocks {
    pub bedrock: u32
    pub dirt: u32
    pub grass_block: u32
    pub biome: u32
}

/// Every chunk of the world, ready to send: the bytes of a `level_chunk_with_light` after its
/// position, which are the same for each. With them, until the level takes it, the chunk as light
/// sees it.
pub struct FlatWorld {
    body: List<u8>
    chunk: FlatChunk?
    // Each chunk's light, as it's sent.
    light_data: LightData
}

impl FlatWorld {
    /// The world, with each chunk made as vanilla's `FlatLevelSource.buildTerrain` makes it: a
    /// layer at a time from the bottom, each block set as `LevelChunk.setBlockState` sets it.
    /// So the bottom section's palette lists the states in the order they're added, after the
    /// air it starts as, and every heightmap is 4 above the bottom of the world.
    pub fn new(blocks: FlatBlocks, table: BlockStates) -> FlatWorld {
        var chunk = Chunk.new(table, MIN_Y, SECTIONS, blocks.biome)
        let layers = [blocks.bedrock, blocks.dirt, blocks.dirt, blocks.grass_block]
        var y = MIN_Y
        for state in layers {
            for x in 0..16 {
                for z in 0..16 {
                    _ = chunk.set_block(table, x, y, z, state)
                }
            }
            y += 1
        }
        var w = Writer.new()
        chunk.chunk_data().write(mut w)
        let made = FlatChunk.of(chunk)
        let light = made.light()
        light.write(mut w)
        return FlatWorld { body: w.into_bytes(), chunk: some(made), light_data: light }
    }

    /// A world of air from `min_y`, `sections` sections high, of the biome `biome`: the ground of
    /// a dimension that's generated, which has light's block states, and whose chunks are what's
    /// sent for one that isn't there, which a world that's opened doesn't send (CAL-69).
    pub fn empty(table: BlockStates, min_y: i32, sections: i32, biome: u32) -> FlatWorld {
        let chunk = Chunk.new(table, min_y, sections, biome)
        var w = Writer.new()
        chunk.chunk_data().write(mut w)
        let made = FlatChunk.of(chunk)
        let light = made.light()
        light.write(mut w)
        return FlatWorld { body: w.into_bytes(), chunk: some(made), light_data: light }
    }

    /// Each chunk's light, as it's sent, which natural spawning reads (D317).
    pub fn light(self) -> LightData {
        return self.light_data.copy()
    }

    /// The chunk as light sees it, for the level, which lights each flat chunk it has as vanilla
    /// does, and `none` once it's been taken.
    pub fn take_chunk(mut self) -> FlatChunk? {
        return self.chunk.take()
    }

    /// The chunk at `x`, `z` as a play packet, its ID and fields.
    pub fn chunk_packet(self, x: i32, z: i32) -> List<u8> {
        var w = Writer.new()
        w.varint(ClientboundLevelChunkWithLight.id(State.Play))
        w.i32(x)
        w.i32(z)
        w.raw(self.body)
        return w.into_bytes()
    }
}

/// The light of a flat chunk among others, `FlatChunk.light`.
pub fn flat_light(chunk: own Chunk) -> LightData {
    return FlatChunk.of(chunk).light()
}

/// A flat chunk as light sees it: its blocks, its sky's sources, and the block states' light
/// properties, which the level lights its other chunks with too. As `LightChunks`, it's a world of
/// this chunk everywhere.
pub struct FlatChunk {
    pub chunk: Chunk
    pub sources: SkySources
    pub states: LightStates
}

impl FlatChunk {
    /// The chunk, with its sky's sources worked out from its blocks, and its sections shared,
    /// so each copy the level and light make holds them once (D331).
    pub fn of(chunk: own Chunk) -> FlatChunk {
        var c = chunk
        c.share()
        let states = LightStates.new()
        var sources = SkySources.new(c.min_y())
        sources.fill_from(c, states)
        return FlatChunk { chunk: c, sources: sources, states: states }
    }

    /// Its light among chunks like it, as `world.light` lights a chunk a server makes: its
    /// sections with blocks told, a run, its light off and not kept, then its sources spread and a
    /// run. Every chunk around it is the same, so light from them changes nothing: it's what
    /// vanilla sends for any flat chunk whose neighbours are flat too. Light is kept only for the
    /// sections next to one with blocks, the one below the world up to the second; there's no
    /// block light, and the sky's is 15 from the surface up and 0 in the ground and below the
    /// world.
    pub fn light(self) -> LightData {
        let min_y = self.chunk.min_y()
        let count = i32.wrap(self.chunk.section_count())
        var light = Light.new(min_y, count * 16, true)
        for i in 0..self.chunk.section_count() {
            if not self.chunk.section_only_air(i) {
                light.update_section_status(0, (min_y >> 4) + i32.wrap(i), 0, false)
            }
        }
        _ = light.run(self.states, self)
        light.set_light_enabled(self, 0, 0, false)
        light.retain_data(0, 0, false)
        light.propagate_light_sources(self.states, self, 0, 0)
        _ = light.run(self.states, self)
        return light.light_data(0, 0)
    }
}

impl LightChunks for FlatChunk {
    fn light_state(self, x: i32, y: i32, z: i32) -> u32? {
        return some(self.chunk.block(x & 15, y, z & 15))
    }

    fn light_section(self, chunk_x: i32, section_y: i32, chunk_z: i32) -> SectionStates? {
        return some(section_states(self.chunk, section_y))
    }

    fn light_bytes(self, chunk_x: i32, section_y: i32, chunk_z: i32, table: List<u8>, out: mut List<u8>) -> i32 {
        return section_bytes(self.chunk, section_y, table, mut out)
    }

    fn lowest_sky_source(self, x: i32, z: i32) -> i32? {
        return some(self.sources.lowest_source_y(x & 15, z & 15))
    }

    fn highest_sky_source(self, chunk_x: i32, chunk_z: i32) -> i32? {
        return some(self.sources.highest_lowest_source_y())
    }

    fn light_sources_in(self, chunk_x: i32, chunk_z: i32) -> List<i64> {
        return light_sources(self.chunk, self.states, chunk_x, chunk_z)
    }
}
