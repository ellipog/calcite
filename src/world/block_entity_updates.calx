/// A chunk's block entities (CAL-115): the chunk's map of them by place, from those its rest
/// saved, which a level keeps as blocks with them are set and removed; what a client is sent of
/// them, each one's place, type and update tag, as
/// `ClientboundLevelChunkPacketData.BlockEntityInfo.create` makes them, in the order of the map;
/// and the order the chunk saves them in.
///
/// The map is fastutil's `Object2ObjectOpenHashMap`, `ChunkAccess.blockEntities`, an
/// `OpenHashMap` here, whose order depends on the order they're put in it: a chunk that wasn't
/// saved whole waits with them in a `HashMap`, `pendingBlockEntities`, till
/// `LevelChunk.postProcessGeneration` makes them in its order, a `JavaHashMap` here; one saved
/// whole makes them in the order they were saved, which was a `HashSet`'s, `getBlockEntitiesPos`,
/// so the same. Each is kept as it saves, `saveWithFullMetadata`.
///
/// The update tag is what the block entity's class's `getUpdateTag` writes, worked out from what
/// it saved, which is `saveWithFullMetadata`'s: `saveAdditional`'s, its components, and its type
/// and place, with the chunk's `keepPacked`. Most classes send nothing; signs, skulls, beacons,
/// conduits, creaking hearts, decorated pots, jigsaws, structure and test blocks and end gateways
/// send all their own, `saveCustomOnly`; a banner its own and its components,
/// `saveWithoutMetadata`; a spawner its own but `SpawnPotentials`; a campfire its items, a shelf
/// its items and whether they're at the bottom; a brushable block its item; a vault its shared
/// data; and a trial spawner its next spawn, and when its next mob spawns while it's active.
module world.block_entity_updates

import nbt.tag.{Tag}
import protocol.play.{BlockEntityInfo}
import registry.builtin.{builtin_entries}
import world.pos.{BlockPos}

/// The index of the built-in `block_entity_type` registry among `builtin_names`.
const BLOCK_ENTITY_TYPES: usize = 10

/// The `block_entity_type` registry's IDs by name, as the built-in registry has them.
pub fn block_entity_ids() -> OpenHashMap<String, i32> {
    var out = OpenHashMap<String, i32>()
    let entries = builtin_entries(BLOCK_ENTITY_TYPES)
    for i in 0..entries.len() {
        let name = entries[i].copy()
        let full = if name.contains(":") { name } else { "minecraft:{name}" }
        out.insert(full, i32.wrap(i))
    }
    return out
}

/// The chunk's map of the block entities its rest saved, `saved`, by place, put in it as the
/// module says, a later one at a place in place of an earlier, as `put` has it. One with no place
/// isn't in it.
pub fn block_entity_map(saved: List<Tag>) -> OpenHashMap<BlockPos, Tag> {
    var pending = JavaHashMap<BlockPos, usize>()
    for i in 0..saved.len() {
        let pos = place_of(saved[i]) else continue
        pending.insert(pos, i)
    }
    var map = OpenHashMap<BlockPos, Tag>()
    for (pos, i) in pending {
        map.insert(pos, saved[i].copy())
    }
    return map
}

/// What the chunk's packet sends of the block entities in its map, `map`, each one's place, type
/// and update tag, or none where that's empty, in the map's order. `active` has the places, packed,
/// of those whose block is a trial spawner that's active. One of a type the registry hasn't isn't
/// sent.
pub fn block_entity_infos(map: OpenHashMap<BlockPos, Tag>, active: Set<i64>, ids: OpenHashMap<String, i32>) -> List<BlockEntityInfo> {
    var out = List<BlockEntityInfo>()
    for (pos, saved) in map {
        let tags = compound_of(saved) else continue
        let kind = text_at(tags, "id") else continue
        let id = ids.get(kind) else continue
        let update = update_tag(kind, tags, active.contains(pos.pack()))
        out.push(BlockEntityInfo {
            packed_xz: u8.wrap(((pos.x & 15) << 4) | (pos.z & 15)),
            y: i16.wrap(pos.y),
            kind: id,
            data: if update.is_empty() { none } else { some(Tag.Compound(update)) },
        })
    }
    return out
}

/// The update tag of the block entity of type `kind` that saved `saved`, as its class's
/// `getUpdateTag` writes it; `active` for a trial spawner whose block's state is active.
pub fn update_tag(kind: String, saved: JavaHashMap<String, Tag>, active: bool) -> JavaHashMap<String, Tag> {
    var out = JavaHashMap<String, Tag>()
    for name in ["minecraft:beacon", "minecraft:conduit", "minecraft:creaking_heart", "minecraft:decorated_pot", "minecraft:jigsaw", "minecraft:sign", "minecraft:hanging_sign", "minecraft:skull", "minecraft:structure_block", "minecraft:test_block", "minecraft:test_instance_block", "minecraft:end_gateway"] {
        if kind == String(name) {
            return own_of(saved, false, "")
        }
    }
    if kind == "minecraft:banner" {
        return own_of(saved, true, "")
    }
    if kind == "minecraft:mob_spawner" {
        return own_of(saved, false, "SpawnPotentials")
    }
    if kind == "minecraft:campfire" {
        out.insert(String("Items"), copy_at(saved, "Items") ?? Tag.List(List<Tag>()))
        return out
    }
    if kind == "minecraft:shelf" {
        out.insert(String("Items"), copy_at(saved, "Items") ?? Tag.List(List<Tag>()))
        out.insert(String("align_items_to_bottom"), copy_at(saved, "align_items_to_bottom") ?? Tag.Byte(0))
        return out
    }
    if kind == "minecraft:brushable_block" {
        // Its hit direction isn't saved, and goes once it's brushed; its item is saved where it
        // has one.
        if let item = copy_at(saved, "item") {
            out.insert(String("item"), item)
        }
        return out
    }
    if kind == "minecraft:vault" {
        out.insert(String("shared_data"), copy_at(saved, "shared_data") ?? Tag.Compound(JavaHashMap<String, Tag>()))
        return out
    }
    if kind == "minecraft:trial_spawner" {
        // `TrialSpawnerStateData.getUpdateTag`.
        if active {
            out.insert(String("next_mob_spawns_at"), copy_at(saved, "next_mob_spawns_at") ?? Tag.Long(0))
        }
        if let data = copy_at(saved, "spawn_data") {
            out.insert(String("spawn_data"), data)
        }
        return out
    }
    return out
}

// What a block entity saved of its own, `saveCustomOnly`, with its components if `components`,
// `saveWithoutMetadata`: all but its type and place and the chunk's `keepPacked`, put in a new
// compound in the order they were saved, as the class puts them, and `without` left out.
fn own_of(saved: JavaHashMap<String, Tag>, components: bool, without: str) -> JavaHashMap<String, Tag> {
    var out = JavaHashMap<String, Tag>()
    for (key, value) in saved {
        if key == "id" or key == "x" or key == "y" or key == "z" or key == "keepPacked" or key == String(without) {
            continue
        }
        if key == "components" and not components {
            continue
        }
        out.insert(key.copy(), value.copy())
    }
    return out
}

/// The block entities in the chunk's map, `map`, as the chunk saves them: in the order of
/// `getBlockEntitiesPos`, a `HashSet` of their places put in it in the map's order, each with
/// `keepPacked` false, as `getBlockEntityNbtForSaving` saves one the chunk holds.
pub fn saved_block_entities(map: OpenHashMap<BlockPos, Tag>) -> List<Tag> {
    var places = JavaHashMap<BlockPos, bool>()
    for (pos, _) in map {
        places.insert(pos, true)
    }
    var out = List<Tag>()
    for (pos, _) in places {
        let found = compound_of(map[pos]) else continue
        var tags = found
        tags.insert(String("keepPacked"), Tag.Byte(0))
        out.push(Tag.Compound(tags))
    }
    return out
}

/// A block entity of type `kind` made at `pos` that saves `own_data` of its own,
/// `saveAdditional`'s, as it saves: that, its components, none, then its type and place,
/// `saveMetadata`.
pub fn made_block_entity(kind: String, own_data: JavaHashMap<String, Tag>, pos: BlockPos) -> Tag {
    var tags = own_data.copy()
    tags.insert(String("components"), Tag.Compound(JavaHashMap<String, Tag>()))
    tags.insert(String("id"), Tag.Str(kind.copy()))
    tags.insert(String("x"), Tag.Int(pos.x))
    tags.insert(String("y"), Tag.Int(pos.y))
    tags.insert(String("z"), Tag.Int(pos.z))
    return Tag.Compound(tags)
}

/// A saved block entity's type, its `id`.
pub fn kind_of(saved: Tag) -> String? {
    let tags = compound_of(saved) else return none
    return text_at(tags, "id")
}

/// Whether a saved block entity holds anything its removal would drop, with
/// `preRemoveSideEffects`: a container's items or the loot table it would fill them from, a
/// jukebox's disc or a lectern's book.
pub fn holds_anything(saved: Tag) -> bool {
    let tags = compound_of(saved) else return false
    if tags.contains("LootTable") or tags.contains("RecordItem") or tags.contains("Book") {
        return true
    }
    if tags.contains("item") and (text_at(tags, "id") ?? String()) == "minecraft:decorated_pot" {
        return true
    }
    if not tags.contains("Items") {
        return false
    }
    return match tags["Items"] {
        Tag.List(items) => not items.is_empty(),
        _ => false,
    }
}

/// A saved block entity's place, from its `x`, `y` and `z`.
pub fn place_of(saved: Tag) -> BlockPos? {
    let tags = compound_of(saved) else return none
    let x = int_at(tags, "x") else return none
    let y = int_at(tags, "y") else return none
    let z = int_at(tags, "z") else return none
    return some(BlockPos { x: x, y: y, z: z })
}

fn compound_of(t: Tag) -> JavaHashMap<String, Tag>? {
    return match t {
        Tag.Compound(m) => some(m.copy()),
        _ => none,
    }
}

fn int_at(tags: JavaHashMap<String, Tag>, key: str) -> i32? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Int(v) => some(v),
        _ => none,
    }
}

fn text_at(tags: JavaHashMap<String, Tag>, key: str) -> String? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

fn copy_at(tags: JavaHashMap<String, Tag>, key: str) -> Tag? {
    if not tags.contains(key) {
        return none
    }
    return some(tags[key].copy())
}
