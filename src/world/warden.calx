/// A warden's `AngerManagement` (CAL-207): how angry it is at each suspect, kept sorted as its
/// `Sorter` has them, the anger at those it lost track of by UUID, and its save, `anger`; and the
/// anger levels, `AngerLevel`.
module world.warden

import nbt.tag.{Tag}
import world.uuids.{uuid_of, uuid_tag}

/// `AngerManagement.MAX_ANGER`.
const MAX_ANGER: i32 = 150
/// `AngerLevel.AGITATED`'s and `ANGRY`'s least anger.
pub const AGITATED: i32 = 40
pub const ANGRY: i32 = 80

/// The sound of an anger level, `AngerLevel`: its ambient one, or, where `listening`, the one it
/// makes as it hears something, `getListeningSound`.
pub fn warden_anger_sound(anger: i32, listening: bool) -> str {
    if anger >= ANGRY {
        return if listening { "entity.warden.listening_angry" } else { "entity.warden.angry" }
    }
    if anger >= AGITATED {
        return if listening { "entity.warden.listening_angry" } else { "entity.warden.agitated" }
    }
    return if listening { "entity.warden.listening" } else { "entity.warden.ambient" }
}

/// One it's angry at, by entity ID and UUID, whether it's a player, and how angry.
pub struct Suspect {
    pub id: i32
    pub uuid: (i64, i64)
    pub player: bool
    pub anger: i32
}

/// What happened to a suspect as its anger ticked: still there and one it may target, gone in a
/// way that keeps its anger by UUID, `CHANGED_DIMENSION`, `UNLOADED_TO_CHUNK` and
/// `UNLOADED_WITH_PLAYER`, or else.
pub const SUSPECT_VALID: i32 = 0
pub const SUSPECT_AWAY: i32 = 1
pub const SUSPECT_GONE: i32 = 2

/// `AngerManagement`: its suspects, sorted, their anger in each, the anger by UUID of those it
/// lost track of, in the order it came by them, the highest anger as its sort found it, and the
/// ticks till it looks up those by UUID again, `conversionDelay`, which vanilla draws from 0 to 2
/// from a random of its thread's own, here 2.
pub struct Anger {
    pub suspects: List<Suspect> = List<Suspect>()
    pub by_uuid: List<((i64, i64), i32)> = List<((i64, i64), i32)>()
    pub highest: i32 = 0
    pub conversion_delay: i32 = 2
}

impl Anger {
    /// `AngerManagement.codec`'s: `suspects`, each its `uuid` and `anger`.
    pub fn from_tag(tag: Tag) -> Anger {
        var out = Anger {}
        let Tag.Compound(m) = tag else return out
        if not m.contains("suspects") {
            return out
        }
        let Tag.List(items) = m["suspects"].copy() else return out
        for item in items {
            let Tag.Compound(c) = item else continue
            let uuid = uuid_of(c, "uuid") else continue
            if not c.contains("anger") {
                continue
            }
            let anger = c["anger"].number_int() ?? -1
            if anger < 0 {
                continue
            }
            out.by_uuid.push((uuid, anger))
        }
        return out
    }

    /// As it's saved, `createUuidAngerPairs`: its suspects, then those by UUID; none at all where
    /// there are none, the field's default left out.
    pub fn to_tag(self) -> Tag {
        var m = JavaHashMap<String, Tag>()
        var list = List<Tag>()
        for s in self.suspects {
            list.push(pair_tag(s.uuid, s.anger))
        }
        for (uuid, anger) in self.by_uuid {
            list.push(pair_tag(uuid, anger))
        }
        if not list.is_empty() {
            m.insert(String("suspects"), Tag.List(list))
        }
        return Tag.Compound(m)
    }

    /// The suspect of the ID `id`'s place among them, if it is one.
    pub fn index_of(self, id: i32) -> usize? {
        for i in 0..self.suspects.len() {
            if self.suspects[i].id == id {
                return some(i)
            }
        }
        return none
    }

    /// `angerBySuspect.getInt`: how angry it is at the one of ID `id`, 0 for one it isn't.
    pub fn anger_at(self, id: i32) -> i32 {
        let i = self.index_of(id) else return 0
        return self.suspects[i].anger
    }

    /// `getActiveAnger`: at its target, where it has one, else its highest.
    pub fn active_anger(self, target: i32?) -> i32 {
        let t = target else return self.highest
        return self.anger_at(t)
    }

    /// `increaseAnger` of `by` at the one `who`: its anger at most 150, and a new suspect's what
    /// was kept of it by UUID more; the suspects sorted again. Its anger now.
    pub fn increase(mut self, who: Suspect, by: i32) -> i32 {
        if let i = self.index_of(who.id) {
            self.suspects[i].anger = (self.suspects[i].anger + by).min(MAX_ANGER)
            let now = self.suspects[i].anger
            self.sort()
            return now
        }
        var anger = by.min(MAX_ANGER)
        var k = 0usize
        while k < self.by_uuid.len() {
            let (uuid, kept) = self.by_uuid[k]
            if uuid == who.uuid {
                anger += kept
                _ = self.by_uuid.remove(k)
                break
            }
            k += 1
        }
        self.suspects.push(Suspect { id: who.id, uuid: who.uuid, player: who.player, anger: anger })
        self.sort()
        return anger
    }

    /// `clearAnger`: the one of ID `id` no longer a suspect; the rest sorted again.
    pub fn clear(mut self, id: i32) {
        if let i = self.index_of(id) {
            _ = self.suspects.remove(i)
        }
        self.sort()
    }

    /// `AngerManagement.tick`'s start: where it's time, those kept by UUID that `found` has, as
    /// suspects again, `convertFromUuids`, then those kept by UUID calmer by 1, gone at 1.
    pub fn tick_kept(mut self, found: List<Suspect>) {
        self.conversion_delay -= 1
        if self.conversion_delay <= 0 {
            var kept = List<((i64, i64), i32)>()
            for (uuid, anger) in self.by_uuid {
                var back = false
                for f in found {
                    if f.uuid == uuid {
                        self.suspects.push(Suspect { id: f.id, uuid: uuid, player: f.player, anger: anger })
                        back = true
                        break
                    }
                }
                if not back {
                    kept.push((uuid, anger))
                }
            }
            self.by_uuid = kept
            self.conversion_delay = 2
        }
        var calmer = List<((i64, i64), i32)>()
        for (uuid, anger) in self.by_uuid {
            if anger > 1 {
                calmer.push((uuid, anger - 1))
            }
        }
        self.by_uuid = calmer
    }

    /// `AngerManagement.tick`'s rest, `state` what became of each suspect, by its place: each
    /// calmer by 1 that's there and may be targeted, the rest no longer suspects, their anger
    /// kept by UUID where they went away; then sorted again.
    pub fn tick_suspects(mut self, state: List<i32>) {
        var kept = List<Suspect>()
        for i in 0..self.suspects.len() {
            let s = self.suspects[i]
            let st = if i < state.len() { state[i] } else { SUSPECT_GONE }
            if s.anger > 1 and st == SUSPECT_VALID {
                kept.push(Suspect { id: s.id, uuid: s.uuid, player: s.player, anger: s.anger - 1 })
            } else if s.anger > 1 and st == SUSPECT_AWAY {
                self.by_uuid.push((s.uuid, s.anger - 1))
            }
        }
        self.suspects = kept
        self.sort()
    }

    /// `sortAndUpdateHighestAnger`: the suspects sorted, `Sorter`, stably, as `List.sort` is: those
    /// it's angry at first, then players, then the angrier; its highest anger the highest its
    /// sort compared, which is every suspect's where there are two or more, the one's where one.
    pub fn sort(mut self) {
        self.highest = 0
        let n = self.suspects.len()
        for i in 1..n {
            var j = i
            while j > 0 and goes_before(self.suspects[j], self.suspects[j - 1]) {
                self.suspects.swap(j - 1, j)
                j -= 1
            }
        }
        if n == 1 {
            self.highest = self.suspects[0].anger
        } else {
            for s in self.suspects {
                self.highest = self.highest.max(s.anger)
            }
        }
    }
}

// Whether `a` sorts before `b`, `AngerManagement.Sorter`.
fn goes_before(a: Suspect, b: Suspect) -> bool {
    let (angry_a, angry_b) = (a.anger >= ANGRY, b.anger >= ANGRY)
    if angry_a != angry_b {
        return angry_a
    }
    if a.player != b.player {
        return a.player
    }
    return a.anger > b.anger
}

// A suspect as it's saved, `SUSPECT_ANGER_PAIR`.
fn pair_tag(uuid: (i64, i64), anger: i32) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("uuid"), uuid_tag(uuid))
    m.insert(String("anger"), Tag.Int(anger))
    return Tag.Compound(m)
}
