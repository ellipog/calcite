/// A villager's brain, as `Villager.BRAIN_PROVIDER` and `VillagerGoalPackages` make it
/// (CAL-160): its activities and their behaviors by priority, each with the points of interest
/// its profession holds and may take, `heldJobSite` and `acquirableJobSite`; and its gates'
/// randoms seeded in the order vanilla makes their `ShufflingList`s, as the rig's agent seeds
/// them.
///
/// The behaviors Calcite doesn't have yet are `Behavior.Unmade`, which never start but register
/// the memories vanilla's do, so the brain holds and saves what vanilla's does.
module world.villager_brain

import world.brain.{ACTIVITY_CORE, ACTIVITY_HIDE, ACTIVITY_IDLE, ACTIVITY_MEET, ACTIVITY_PANIC, ACTIVITY_PLAY, ACTIVITY_PRE_RAID, ACTIVITY_RAID, ACTIVITY_REST, ACTIVITY_WORK, Acquire, Activity, Behavior, Deed, Doing, Interact, LookAt, MEMORY_BREED_TARGET, MEMORY_HOME, MEMORY_HURT_BY_ENTITY, MEMORY_INTERACTION_TARGET, MEMORY_JOB_SITE, MEMORY_MEETING_POINT, MEMORY_NEAREST_HOSTILE, MEMORY_POTENTIAL_JOB_SITE, MEMORY_VISIBLE_VILLAGER_BABIES, Need, PLAYER, STATUS_ABSENT, STATUS_PRESENT, UNMADE_CELEBRATE, UNMADE_GO_TO_VILLAGE, UNMADE_HIDE_STATE, UNMADE_HOME_WALK, UNMADE_INSIDE_WALK, UNMADE_LOCATE_HIDING, UNMADE_MEET_GATE, UNMADE_PLAY_TAG, UNMADE_PRE_RAID_GATE, UNMADE_RAID_HIDE, UNMADE_RAID_RESET, UNMADE_RAID_SKY, UNMADE_RING_BELL, UNMADE_SLEEP, WalkToPoi, Weighted, deed, gate, gate_ordered, gate_seed}
import world.entity_facts.{AXOLOTLS, CREATURE, MONSTER, UNDERGROUND_WATER_CREATURE, WATER_AMBIENT, WATER_CREATURE}
import world.poi.{HOME, MEETING}

/// The professions, `VILLAGER_PROFESSION`, by their IDs, those this module asks after.
pub const NO_PROFESSION: i32 = 0
pub const FARMER: i32 = 5
pub const NITWIT: i32 = 11

/// The species of `world.mob`'s numbering a villager's behaviors look for.
const VILLAGER: i32 = 17
const CAT: i32 = 100

/// The point of interest type a profession works at, its `heldJobSite`'s, -1 for none or a
/// nitwit's: armorer to mason, 1 to 10, at 0 to 9; shepherd, toolsmith and weaponsmith, 12 to 14,
/// at 10 to 12.
pub fn job_site_of(profession: i32) -> i32 {
    if profession >= 1 and profession <= 10 {
        return profession - 1
    }
    if profession >= 12 and profession <= 14 {
        return profession - 2
    }
    return -1
}

/// The first profession whose job site is the type `kind`, as `AssignProfessionFromJobSite`
/// finds it going over the professions in their order, -1 for none.
pub fn profession_at(kind: i32) -> i32 {
    if kind >= 0 and kind <= 9 {
        return kind + 1
    }
    if kind >= 10 and kind <= 12 {
        return kind + 2
    }
    return -1
}

/// The types of point a villager of `profession` holds as its job site, `heldJobSite`, as bits
/// by type: its own, or none for none or a nitwit.
pub fn held_sites(profession: i32) -> u32 {
    let k = job_site_of(profession)
    return if k < 0 { 0u32 } else { 1u32 << u32.wrap(k) }
}

/// The types of point a villager of `profession` may take as its job site, `acquirableJobSite`:
/// any job site for one with none, `ALL_ACQUIRABLE_JOBS`; none for a nitwit; else its own.
pub fn acquirable_sites(profession: i32) -> u32 {
    if profession == NO_PROFESSION {
        return (1u32 << 13u32) - 1u32
    }
    return held_sites(profession)
}

// A `RunOne` entry of `kind`, weighted `weight`, running from `min` to `max` ticks.
fn weighted(kind: Behavior, min: i32, max: i32, weight: i32) -> Weighted {
    return Weighted { deed: deed(kind, min, max), weight: weight }
}

// `SetEntityLookTarget.create(type, 8)` as a `RunOne` entry.
fn look_at_species(species: i32, weight: i32) -> Weighted {
    return weighted(Behavior.LookAt(LookAt { species: species, category: -1, max_dist: 8.0f32 }), 1, 1, weight)
}

// `SetEntityLookTarget.create(category, 8)` as a `RunOne` entry.
fn look_at_category(category: i32, weight: i32) -> Weighted {
    return weighted(Behavior.LookAt(LookAt { species: -100, category: category, max_dist: 8.0f32 }), 1, 1, weight)
}

// `getFullLookBehavior`: a `RunOne` of looking at a cat within 8, a villager, a player, a mob of
// each category but the ambient and misc, or nothing for 30 to 60 ticks.
fn full_look(seed: i64, k: i64) -> Deed {
    var entries = List<Weighted>()
    entries.push(look_at_species(CAT, 8))
    entries.push(look_at_species(VILLAGER, 2))
    entries.push(look_at_species(PLAYER, 2))
    entries.push(look_at_category(CREATURE, 1))
    entries.push(look_at_category(WATER_CREATURE, 1))
    entries.push(look_at_category(AXOLOTLS, 1))
    entries.push(look_at_category(UNDERGROUND_WATER_CREATURE, 1))
    entries.push(look_at_category(WATER_AMBIENT, 1))
    entries.push(look_at_category(MONSTER, 1))
    entries.push(weighted(Behavior.Idle(0), 30, 60, 2))
    return gate(entries, List<Need>(), gate_seed(seed, k))
}

// `getMinimalLookBehavior`: a `RunOne` of looking at a villager within 8, a player, or nothing for
// 30 to 60 ticks.
fn minimal_look(seed: i64, k: i64) -> Deed {
    var entries = List<Weighted>()
    entries.push(look_at_species(VILLAGER, 2))
    entries.push(look_at_species(PLAYER, 2))
    entries.push(weighted(Behavior.Idle(0), 30, 60, 8))
    return gate(entries, List<Need>(), gate_seed(seed, k))
}

// `InteractWith.of(type, 8, memory, 0.5, 2)`, breeding where so, as a `RunOne` entry.
fn interact(species: i32, memory: i32, breed: bool, weight: i32) -> Weighted {
    return weighted(Behavior.InteractWith(Interact { species: species, range: 8, memory: memory, speed: 0.5f32, stop: 2, breed: breed }), 1, 1, weight)
}

// `SetWalkTargetFromBlockMemory.create(memory, 0.5, close, too_far, too_long)`.
fn walk_to_poi(memory: i32, close: i32, too_far: i32, too_long: i32) -> Deed {
    return deed(Behavior.WalkToPoi(WalkToPoi { memory: memory, speed: 0.5f32, close: close, too_far: too_far, too_long: too_long }), 1, 1)
}

// A behavior Calcite doesn't have yet.
fn unmade(n: i32, min: i32, max: i32) -> Deed {
    return deed(Behavior.Unmade(n), min, max)
}

/// A villager's activities, `BRAIN_PROVIDER`'s, of `profession`, a baby's where `baby`, its
/// gates' randoms seeded from `seed`, its own random's, `gate_seed`, counting them in the order
/// vanilla makes them: a grown villager's work or a baby's play first, then core, meet, rest,
/// idle, panic, the raid's, and hiding.
pub fn villager_activities(seed: i64, profession: i32, baby: bool) -> List<Activity> {
    var out = List<Activity>()
    if baby {
        out.push(play(seed))
    } else {
        out.push(work(seed, profession))
    }
    out.push(core(profession))
    out.push(meet(seed))
    out.push(rest(seed))
    out.push(idle(seed))
    out.push(panic_package(seed))
    out.push(pre_raid(seed))
    out.push(raid(seed))
    out.push(hide(seed))
    return out
}

// An activity with its behaviors at their priorities.
fn activity(a: i32, deeds: own List<(i32, Deed)>) -> Activity {
    return Activity { doing: Doing { activity: a }, deeds: deeds }
}

// `getCorePackage(profession, 0.5)`.
fn core(profession: i32) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((0, deed(Behavior.Swim(0.8f32), 60, 60)))
    d.push((0, deed(Behavior.Doors(0), 1, 1)))
    d.push((0, deed(Behavior.LookAtTarget(0), 45, 90)))
    d.push((0, deed(Behavior.VillagerPanic(0), 60, 60)))
    d.push((0, deed(Behavior.WakeUp(0), 1, 1)))
    d.push((0, deed(Behavior.ReactToBell(0), 1, 1)))
    d.push((0, deed(Behavior.RaidStatus(0), 1, 1)))
    d.push((0, deed(Behavior.ValidatePoi((MEMORY_JOB_SITE, held_sites(profession))), 1, 1)))
    d.push((0, deed(Behavior.ValidatePoi((MEMORY_POTENTIAL_JOB_SITE, acquirable_sites(profession))), 1, 1)))
    d.push((1, deed(Behavior.MoveToTarget(false), 150, 250)))
    d.push((2, deed(Behavior.CompetitorScan(0), 1, 1)))
    d.push((3, deed(Behavior.FollowTrader(0.5f32), 2147483647, 2147483647)))
    d.push((5, deed(Behavior.GoToItem((0.5f32, false, 4)), 1, 1)))
    d.push((6, deed(Behavior.AcquirePoi(Acquire { kinds: acquirable_sites(profession), validate: MEMORY_JOB_SITE, memory: MEMORY_POTENTIAL_JOB_SITE, adult_only: true, event: -1, bed: false }), 1, 1)))
    d.push((7, deed(Behavior.GoToJobSite(0.5f32), 1200, 1200)))
    d.push((8, deed(Behavior.YieldJobSite(0.5f32), 1, 1)))
    d.push((10, deed(Behavior.AcquirePoi(Acquire { kinds: 1u32 << u32.wrap(HOME), validate: MEMORY_HOME, memory: MEMORY_HOME, adult_only: false, event: 14, bed: true }), 1, 1)))
    d.push((10, deed(Behavior.AcquirePoi(Acquire { kinds: 1u32 << u32.wrap(MEETING), validate: MEMORY_MEETING_POINT, memory: MEMORY_MEETING_POINT, adult_only: true, event: 14, bed: false }), 1, 1)))
    d.push((10, deed(Behavior.AssignProfession(0), 1, 1)))
    d.push((10, deed(Behavior.ResetProfession(0), 1, 1)))
    return activity(ACTIVITY_CORE, d)
}

// `getWorkPackage(profession, 0.5)`: its gates the 1st and 2nd made, from 0.
fn work(seed: i64, profession: i32) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((5, minimal_look(seed, 0)))
    let farmer = profession == FARMER
    var jobs = List<Weighted>()
    jobs.push(weighted(Behavior.WorkAtPoi(farmer), 60, 60, 7))
    jobs.push(weighted(Behavior.StrollAroundPoi((MEMORY_JOB_SITE, 0.4f32, 4)), 1, 1, 2))
    jobs.push(weighted(Behavior.StrollToPoi((MEMORY_JOB_SITE, 0.4f32, 1, 10)), 1, 1, 5))
    jobs.push(weighted(Behavior.StrollToPoiList((0.5f32, 1, 6)), 1, 1, 5))
    jobs.push(Weighted { deed: deed(Behavior.Harvest(0), 60, 60), weight: if farmer { 2 } else { 5 } })
    jobs.push(Weighted { deed: deed(Behavior.Bonemeal(0), 60, 60), weight: if farmer { 4 } else { 7 } })
    d.push((5, gate(jobs, List<Need>(), gate_seed(seed, 1))))
    d.push((10, deed(Behavior.ShowTrades(0), 400, 1600)))
    d.push((10, deed(Behavior.LookAndInteract(4), 1, 1)))
    d.push((2, walk_to_poi(MEMORY_JOB_SITE, 9, 100, 1200)))
    d.push((3, deed(Behavior.HeroGift(0), 100, 100)))
    d.push((99, deed(Behavior.Schedule(0), 1, 1)))
    var a = activity(ACTIVITY_WORK, d)
    a.doing.needs.push(Need { memory: MEMORY_JOB_SITE, status: STATUS_PRESENT })
    return a
}

// `getPlayPackage(0.5)`, a baby's: its gates the 1st and 2nd made.
fn play(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((0, deed(Behavior.MoveToTarget(false), 80, 120)))
    d.push((5, full_look(seed, 0)))
    d.push((5, unmade(UNMADE_PLAY_TAG, 1, 1)))
    var plays = List<Weighted>()
    plays.push(interact(VILLAGER, MEMORY_INTERACTION_TARGET, false, 2))
    plays.push(interact(CAT, MEMORY_INTERACTION_TARGET, false, 1))
    plays.push(weighted(Behavior.VillageStroll((0.5f32, 10, 7)), 1, 1, 1))
    plays.push(weighted(Behavior.WalkToLook((0.5f32, 2)), 1, 1, 1))
    plays.push(weighted(Behavior.JumpOnBed(0.5f32), 60, 60, 2))
    plays.push(weighted(Behavior.Idle(0), 20, 40, 2))
    var absent = List<Need>()
    absent.push(Need { memory: MEMORY_VISIBLE_VILLAGER_BABIES, status: STATUS_ABSENT })
    d.push((5, gate(plays, absent, gate_seed(seed, 1))))
    d.push((99, deed(Behavior.Schedule(0), 1, 1)))
    return activity(ACTIVITY_PLAY, d)
}

// `getMeetPackage(0.5)`: its gates the 3rd to 5th made.
fn meet(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((2, unmade(UNMADE_MEET_GATE, 1, 1)))
    d.push((10, deed(Behavior.ShowTrades(0), 400, 1600)))
    d.push((10, deed(Behavior.LookAndInteract(4), 1, 1)))
    d.push((2, walk_to_poi(MEMORY_MEETING_POINT, 6, 100, 200)))
    d.push((3, deed(Behavior.HeroGift(0), 100, 100)))
    d.push((3, deed(Behavior.ValidatePoi((MEMORY_MEETING_POINT, 1u32 << u32.wrap(MEETING))), 1, 1)))
    var trades = List<Weighted>()
    trades.push(weighted(Behavior.TradeWithVillager(0), 60, 60, 1))
    d.push((3, gate_ordered(trades, [MEMORY_INTERACTION_TARGET], gate_seed(seed, 3))))
    d.push((5, full_look(seed, 4)))
    d.push((99, deed(Behavior.Schedule(0), 1, 1)))
    var a = activity(ACTIVITY_MEET, d)
    a.doing.needs.push(Need { memory: MEMORY_MEETING_POINT, status: STATUS_PRESENT })
    return a
}

// `getRestPackage(0.5)`: its gates the 6th and 7th made.
fn rest(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((2, walk_to_poi(MEMORY_HOME, 1, 150, 1200)))
    d.push((3, deed(Behavior.ValidatePoi((MEMORY_HOME, 1u32 << u32.wrap(HOME))), 1, 1)))
    d.push((3, unmade(UNMADE_SLEEP, 60, 60)))
    var homeless = List<Weighted>()
    homeless.push(Weighted { deed: unmade(UNMADE_HOME_WALK, 1, 1), weight: 1 })
    homeless.push(Weighted { deed: unmade(UNMADE_INSIDE_WALK, 1, 1), weight: 4 })
    homeless.push(Weighted { deed: unmade(UNMADE_GO_TO_VILLAGE, 1, 1), weight: 2 })
    homeless.push(weighted(Behavior.Idle(0), 20, 40, 2))
    var absent = List<Need>()
    absent.push(Need { memory: MEMORY_HOME, status: STATUS_ABSENT })
    d.push((5, gate(homeless, absent, gate_seed(seed, 5))))
    d.push((5, minimal_look(seed, 6)))
    d.push((99, deed(Behavior.Schedule(0), 1, 1)))
    return activity(ACTIVITY_REST, d)
}

// `getIdlePackage(0.5)`: its gates the 8th to 11th made.
fn idle(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    var idles = List<Weighted>()
    idles.push(interact(VILLAGER, MEMORY_INTERACTION_TARGET, false, 2))
    idles.push(interact(VILLAGER, MEMORY_BREED_TARGET, true, 1))
    idles.push(interact(CAT, MEMORY_INTERACTION_TARGET, false, 1))
    idles.push(weighted(Behavior.VillageStroll((0.5f32, 10, 7)), 1, 1, 1))
    idles.push(weighted(Behavior.WalkToLook((0.5f32, 2)), 1, 1, 1))
    idles.push(weighted(Behavior.JumpOnBed(0.5f32), 60, 60, 1))
    idles.push(weighted(Behavior.Idle(0), 30, 60, 1))
    d.push((2, gate(idles, List<Need>(), gate_seed(seed, 7))))
    d.push((3, deed(Behavior.HeroGift(0), 100, 100)))
    d.push((3, deed(Behavior.LookAndInteract(4), 1, 1)))
    d.push((3, deed(Behavior.ShowTrades(0), 400, 1600)))
    var trades = List<Weighted>()
    trades.push(weighted(Behavior.TradeWithVillager(0), 60, 60, 1))
    d.push((3, gate_ordered(trades, [MEMORY_INTERACTION_TARGET], gate_seed(seed, 8))))
    var loves = List<Weighted>()
    loves.push(weighted(Behavior.VillagerLove(0), 350, 350, 1))
    d.push((3, gate_ordered(loves, [MEMORY_BREED_TARGET], gate_seed(seed, 9))))
    d.push((5, full_look(seed, 10)))
    d.push((99, deed(Behavior.Schedule(0), 1, 1)))
    return activity(ACTIVITY_IDLE, d)
}

// `getPanicPackage(0.5)`, running away at 0.75: its gate the 12th made.
fn panic_package(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((0, deed(Behavior.CalmDown(0), 1, 1)))
    d.push((1, deed(Behavior.AwayFrom((MEMORY_NEAREST_HOSTILE, 0.75f32, 6)), 1, 1)))
    d.push((1, deed(Behavior.AwayFrom((MEMORY_HURT_BY_ENTITY, 0.75f32, 6)), 1, 1)))
    d.push((3, deed(Behavior.VillageStroll((0.75f32, 2, 2)), 1, 1)))
    d.push((5, minimal_look(seed, 11)))
    return activity(ACTIVITY_PANIC, d)
}

// `getPreRaidPackage(0.5)`: its gates the 13th and 14th made.
fn pre_raid(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((0, unmade(UNMADE_RING_BELL, 1, 1)))
    d.push((0, unmade(UNMADE_PRE_RAID_GATE, 1, 1)))
    d.push((5, minimal_look(seed, 13)))
    d.push((99, unmade(UNMADE_RAID_RESET, 1, 1)))
    return activity(ACTIVITY_PRE_RAID, d)
}

// `getRaidPackage(0.5)`: its gates the 15th and 16th made.
fn raid(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((0, unmade(UNMADE_RAID_SKY, 1, 1)))
    d.push((0, unmade(UNMADE_CELEBRATE, 600, 600)))
    d.push((2, unmade(UNMADE_RAID_HIDE, 1, 1)))
    d.push((5, minimal_look(seed, 15)))
    d.push((99, unmade(UNMADE_RAID_RESET, 1, 1)))
    return activity(ACTIVITY_RAID, d)
}

// `getHidePackage(0.5)`: its gate the 17th made.
fn hide(seed: i64) -> Activity {
    var d = List<(i32, Deed)>()
    d.push((0, unmade(UNMADE_HIDE_STATE, 1, 1)))
    d.push((1, unmade(UNMADE_LOCATE_HIDING, 1, 1)))
    d.push((5, minimal_look(seed, 16)))
    return activity(ACTIVITY_HIDE, d)
}
