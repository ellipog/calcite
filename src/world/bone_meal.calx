/// Bone meal (CAL-381): `BoneMealItem.growCrop`, what a `BonemealableBlock` does as bone meal is
/// used on it, `isValidBonemealTarget`, `isBonemealSuccess` and `performBonemeal`, each class's,
/// and `growWaterPlant`, seagrass and coral grown in water. Its player's use and a dispenser's
/// show it, level event 1505, and use the bone meal up.
module world.bone_meal

import nbt.tag.{Tag}
import random.source.{RandomSource, shuffle}
import world.block_flags.{PROPAGATES_SKYLIGHT_DOWN}
import world.block_level.{BlockLevel, remove_block}
import world.block_use.{item_stack}
import world.drops.{DropLevel, pop_resource}
import world.level_writer.{LevelWriter, UPDATE_ALL}
import world.natural.{SpawnLevel, raw_brightness}
import world.random_ticks.{RandomTicks, bamboo_grows}
import world.trees.{advance_tree, grow_tree, sapling_can_grow}
import worldgen.access.{BlockAccess, FeatureAccess}
import worldgen.shapes.{mossy_has_faces, mossy_updated}
import worldgen.multiface.{can_spread_any, spread_from_random_face}
import worldgen.facts.{BlockSet, DOWN, EAST, EMPTY_FLUID, Facts, NORTH, SOUTH, UP, WATER_FLUID, WEST, direction_name, horizontal, step_x, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env, can_survive}

/// `levelEvent`'s type for bone meal's particles, with 15 for their count.
pub const BONE_MEAL_USE: i32 = 1505

/// What bone meal did to a block: nothing, as it isn't one that grows by it or can't now; or it
/// was used, `growCrop`'s true, whether it grew or not.
pub enum Meal {
    No
    Used
}

/// `BoneMealItem.growCrop` of the block at x, y, z, as a player's or a dispenser's use has it:
/// where the block's class grows by bone meal and it can now, `isValidBonemealTarget`, a draw of
/// whether it does, `isBonemealSuccess`, for the classes that draw, and its growth,
/// `performBonemeal`. `Used` where it could, the bone meal to be used up, else `No`. A class
/// Calcite doesn't grow yet is told of, and `No`.
pub fn grow_crop<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel + DropLevel + FeatureAccess>(e: Env, ticks: RandomTicks, level: mut L, x: i32, y: i32, z: i32) -> Meal ! Thrown {
    let Env { facts: f, .. } = e
    let state = try level.state(f, x, y, z)
    let block = f.block(state)
    let name = f.codec.blocks.name(block)
    if f.is_a(block, String("CropBlock")) {
        // `CropBlock`: not at its most; 2 to 5 years more, a third of that for beetroot and 1,
        // drawing nothing, for a torchflower crop, at most its most, `growCrops`, flags 2; a
        // torchflower crop at 2 a torchflower, `getStateForAge`.
        let age = f.get_int(state, String("age")) ?? 0
        let most = f.crop_max_age(block)
        if age >= most {
            return Meal.No
        }
        let torch = f.is_a(block, String("TorchflowerCropBlock"))
        var more = if torch { 1 } else { 2 + level.next_int_below(4) }
        if f.is_a(block, String("BeetrootBlock")) {
            more = more / 3
        }
        let grown = (age + more).min(most)
        let to = if torch and grown == 2 { f.default_state(try f.named_block(String("torchflower"))) } else { try f.with_int(f.default_state(block), String("age"), grown) }
        _ = level.set_block(x, y, z, to, 2)
        return Meal.Used
    }
    if f.is_a(block, String("StemBlock")) {
        // `StemBlock`: under 7; 2 to 5 more, at most 7, flags 2, and at 7 its random tick, which
        // may grow its fruit.
        let age = f.get_int(state, String("age")) ?? 0
        if age == 7 {
            return Meal.No
        }
        let grown = (age + 2 + level.next_int_below(4)).min(7)
        let to = try f.with_int(state, String("age"), grown)
        _ = level.set_block(x, y, z, to, 2)
        if grown == 7 {
            try ticks.tick(e, mut level, to, x, y, z)
        }
        return Meal.Used
    }
    if f.is_a(block, String("SweetBerryBushBlock")) {
        // Under 3, a year more, flags 2.
        let age = f.get_int(state, String("age")) ?? 0
        if age >= 3 {
            return Meal.No
        }
        _ = level.set_block(x, y, z, try f.with_int(state, String("age"), age + 1), 2)
        return Meal.Used
    }
    if f.is_a(block, String("CocoaBlock")) {
        // Under 2, a year more, flags 2.
        let age = f.get_int(state, String("age")) ?? 0
        if age >= 2 {
            return Meal.No
        }
        _ = level.set_block(x, y, z, try f.with_int(state, String("age"), age + 1), 2)
        return Meal.Used
    }
    if name == "minecraft:cave_vines" or name == "minecraft:cave_vines_plant" {
        // `CaveVinesBlock` and `CaveVinesPlantBlock`: without berries, berries, flags 2.
        if f.get_bool(state, String("berries")) {
            return Meal.No
        }
        _ = level.set_block(x, y, z, try f.with_bool(state, String("berries"), true), 2)
        return Meal.Used
    }
    if f.is_a(block, String("GrowingPlantHeadBlock")) {
        return try grow_head(f, mut level, state, x, y, z)
    }
    if f.is_a(block, String("GrowingPlantBodyBlock")) {
        // `GrowingPlantBodyBlock`: its head, past its body along its growth, `getTopConnectedBlock`,
        // grows as a head does.
        let (head, step) = heads(name) else return Meal.No
        var hy = y
        var at = state
        while f.block(at) == block {
            hy += step
            at = try level.state(f, x, hy, z)
        }
        if f.codec.blocks.name(f.block(at)) != head {
            return Meal.No
        }
        return try grow_head(f, mut level, at, x, hy, z)
    }
    if name == "minecraft:seagrass" {
        // `SeagrassBlock`: with water above, tall seagrass, its lower half then its upper,
        // flags 2.
        if not try seagrass_grows(f, level, x, y, z) {
            return Meal.No
        }
        let tall = f.default_state(try f.named_block(String("tall_seagrass")))
        _ = level.set_block(x, y, z, try f.with_name(tall, String("half"), String("lower")), 2)
        _ = level.set_block(x, y + 1, z, try f.with_name(tall, String("half"), String("upper")), 2)
        return Meal.Used
    }
    if f.is_a(block, String("TallGrassBlock")) {
        // `TallGrassBlock`: short grass's tall grass, a fern's large fern, where it can stay, with
        // air above in the world; `DoublePlantBlock.placeAt`, flags 2, each half waterlogged where
        // there's water.
        let grown = f.default_state(try f.named_block(String(if name == "minecraft:fern" { "large_fern" } else { "tall_grass" })))
        if not try can_survive(e, level, grown, x, y, z) or not f.is_air(try level.state(f, x, y + 1, z)) or not level.in_height(y + 1) {
            return Meal.No
        }
        try place_double(f, mut level, grown, x, y, z)
        return Meal.Used
    }
    if f.is_a(block, String("TallFlowerBlock")) {
        // `TallFlowerBlock`: one of it dropped, `popResource`.
        pop_resource(mut level, x, y, z, some(item_of(name)))
        return Meal.Used
    }
    if f.is_a(block, String("FlowerBedBlock")) {
        // `FlowerBedBlock`: under 4 flowers, one more, flags 2; else one of it dropped.
        let amount = f.get_int(state, String("flower_amount")) ?? 1
        if amount < 4 {
            _ = level.set_block(x, y, z, try f.with_int(state, String("flower_amount"), amount + 1), 2)
        } else {
            pop_resource(mut level, x, y, z, some(item_of(name)))
        }
        return Meal.Used
    }
    if f.is_a(block, String("SaplingBlock")) {
        // `SaplingBlock`: where it can grow, `sapling_can_grow`; a draw under 0.45, then
        // `advanceTree`: at stage 0, stage 1, flags 260; else its tree, `TreeGrower.growTree`.
        if not try sapling_can_grow(f, mut level, state, x, y, z) {
            return Meal.No
        }
        if level.next_float() < 0.45f32 {
            try advance_tree(f, mut level, state, x, y, z)
        }
        return Meal.Used
    }
    if name == "minecraft:mangrove_propagule" {
        // `MangrovePropaguleBlock`: hanging and not yet 4, a year more, flags 2; else as a
        // sapling's, a draw under 0.45 and `advanceTree`.
        if f.get_bool(state, String("hanging")) {
            let age = f.get_int(state, String("age")) ?? 0
            if age >= 4 {
                return Meal.No
            }
            _ = level.set_block(x, y, z, try f.with_int(state, String("age"), age + 1), 2)
            return Meal.Used
        }
        if level.next_float() < 0.45f32 {
            try advance_tree(f, mut level, state, x, y, z)
        }
        return Meal.Used
    }
    if f.is_a(block, String("AzaleaBlock")) {
        // `AzaleaBlock`: where its tree's least height, its trunk's base of 4, and 2 more above it
        // are in the world, with no fluid above it; a draw under 0.45, then its tree,
        // `TreeGrower.AZALEA`.
        if not level.in_height(y + 6) or f.fluid(try level.state(f, x, y + 1, z)) != EMPTY_FLUID {
            return Meal.No
        }
        if level.next_float() < 0.45f32 {
            _ = try grow_tree(f, mut level, state, x, y, z)
        }
        return Meal.Used
    }
    if name == "minecraft:mangrove_leaves" {
        // `MangroveLeavesBlock`: with air below, a new hanging propagule there, flags 2.
        if not f.is_air(try level.state(f, x, y - 1, z)) {
            return Meal.No
        }
        let propagule = f.default_state(try f.named_block(String("mangrove_propagule")))
        _ = level.set_block(x, y - 1, z, try f.with_int(try f.with_bool(propagule, String("hanging"), true), String("age"), 0), 2)
        return Meal.Used
    }
    if name == "minecraft:rooted_dirt" {
        // `RootedDirtBlock`: with air below in the world, hanging roots there, flags 3.
        if not f.is_air(try level.state(f, x, y - 1, z)) or not level.in_height(y - 1) {
            return Meal.No
        }
        _ = level.set_block(x, y - 1, z, f.default_state(try f.named_block(String("hanging_roots"))), UPDATE_ALL)
        return Meal.Used
    }
    if f.is_a(block, String("BushBlock")) or f.is_a(block, String("FireflyBushBlock")) or f.is_a(block, String("TallDryGrassBlock")) {
        // `BushBlock`, `FireflyBushBlock` and `TallDryGrassBlock`: where it, or short dry grass
        // for tall dry grass, can stay in air beside it, the sides drawn in a shuffled order,
        // `findSpreadableNeighbourPos`, it there, flags 3.
        let spread = if f.is_a(block, String("TallDryGrassBlock")) { f.default_state(try f.named_block(String("short_dry_grass"))) } else { f.default_state(block) }
        var any = false
        for d in [NORTH, EAST, SOUTH, WEST] {
            if try spreads_to(e, level, spread, x + step_x(d), y, z + step_z(d)) {
                any = true
            }
        }
        if not any {
            return Meal.No
        }
        var ways: List<i32> = [NORTH, EAST, SOUTH, WEST]
        shuffle(mut ways, mut level)
        for d in ways {
            if try spreads_to(e, level, spread, x + step_x(d), y, z + step_z(d)) {
                _ = level.set_block(x + step_x(d), y, z + step_z(d), spread, UPDATE_ALL)
                break
            }
        }
        return Meal.Used
    }
    if f.is_a(block, String("ShortDryGrassBlock")) {
        // `ShortDryGrassBlock`: tall dry grass, flags 3.
        _ = level.set_block(x, y, z, f.default_state(try f.named_block(String("tall_dry_grass"))), UPDATE_ALL)
        return Meal.Used
    }
    if f.is_a(block, String("HangingMossBlock")) {
        // `HangingMossBlock`: below its tip, past its own blocks, air in the world, its tip there,
        // flags 3.
        var ty = y - 1
        while f.block(try level.state(f, x, ty, z)) == block {
            ty -= 1
        }
        if not f.is_air(try level.state(f, x, ty, z)) or not level.in_height(ty) {
            return Meal.No
        }
        _ = level.set_block(x, ty, z, try f.with_bool(state, String("tip"), true), UPDATE_ALL)
        return Meal.Used
    }
    if f.is_a(block, String("ShelfMushroomBlock")) {
        // `ShelfMushroomBlock`: under 1, a year more, flags 2.
        let age = f.get_int(state, String("age")) ?? 0
        if age >= 1 {
            return Meal.No
        }
        _ = level.set_block(x, y, z, try f.with_int(state, String("age"), age + 1), 2)
        return Meal.Used
    }
    if f.is_a(block, String("NyliumBlock")) {
        // `NyliumBlock`: with air above in the world, `nylium_bonemeal` placed above.
        if not f.is_air(try level.state(f, x, y + 1, z)) or not level.in_height(y + 1) {
            return Meal.No
        }
        _ = try level.grow_feature(String("minecraft:nylium_bonemeal"), x, y + 1, z)
        return Meal.Used
    }
    if f.is_a(block, String("MushroomBlock")) {
        // `MushroomBlock`: where its huge mushroom's least height, 4 and its cap's radius, is in
        // the world above it; a draw under 0.4, then `growMushroom`: it's taken away, flags 3, and
        // its huge mushroom placed, it put back, flags 3, where that doesn't place.
        let red = name == "minecraft:red_mushroom"
        if not level.in_height(y + if red { 6 } else { 7 }) {
            return Meal.No
        }
        if level.next_float() < 0.4f32 {
            _ = try remove_block(f, mut level, x, y, z)
            if not try level.grow_feature(String(if red { "minecraft:huge_red_mushroom" } else { "minecraft:huge_brown_mushroom" }), x, y, z) {
                _ = level.set_block(x, y, z, state, UPDATE_ALL)
            }
        }
        return Meal.Used
    }
    if f.is_a(block, String("NetherFungusBlock")) {
        // `NetherFungusBlock`: on its nylium with the block above in the world; a draw under 0.4,
        // then its planted fungus placed.
        let crimson = name == "minecraft:crimson_fungus"
        let nylium = try f.named_block(String(if crimson { "crimson_nylium" } else { "warped_nylium" }))
        if f.block(try level.state(f, x, y - 1, z)) != nylium or not level.in_height(y + 1) {
            return Meal.No
        }
        if level.next_float() < 0.4f32 {
            _ = try level.grow_feature(String(if crimson { "minecraft:crimson_fungus_planted" } else { "minecraft:warped_fungus_planted" }), x, y, z)
        }
        return Meal.Used
    }
    if f.is_a(block, String("BonemealableFeaturePlacerBlock")) {
        // `BonemealableFeaturePlacerBlock`, moss and pale moss: with air above, its patch placed
        // there.
        if not f.is_air(try level.state(f, x, y + 1, z)) {
            return Meal.No
        }
        _ = try level.grow_feature(String(if name == "minecraft:pale_moss_block" { "minecraft:pale_moss_patch_bonemeal" } else { "minecraft:moss_patch_bonemeal" }), x, y + 1, z)
        return Meal.Used
    }
    if name == "minecraft:small_dripleaf" {
        // `SmallDripleafBlock`: from its lower half, the upper one's fluid's block set, flags 18,
        // and a big dripleaf of 2 to 5 drawn grown there, `placeWithRandomHeight`.
        let low = if (f.get_name(state, String("half")) ?? String()) == "lower" { y } else { y - 1 }
        let lower = try level.state(f, x, low, z)
        let facing = f.get_name(lower, String("facing")) ?? String("north")
        let up = try level.state(f, x, low + 1, z)
        _ = level.set_block(x, low + 1, z, if f.fluid(up) == WATER_FLUID { f.default_state(f.ids.water) } else { f.default_state(f.ids.air) }, 18)
        let wanted = 2 + level.next_int_below(4)
        var height = 0
        while height < wanted and try dripleaf_fits(f, level, x, low + height, z) {
            height += 1
        }
        let leaf_y = low + height - 1
        var at = low
        while at < leaf_y {
            try place_dripleaf(f, mut level, "big_dripleaf_stem", x, at, z, facing.copy())
            at += 1
        }
        try place_dripleaf(f, mut level, "big_dripleaf", x, at, z, facing)
        return Meal.Used
    }
    if name == "minecraft:big_dripleaf" {
        // `BigDripleafBlock`: where the leaf can grow into the block above, `canGrowInto`, its
        // stem here and the leaf above, each waterlogged where there's water's source, flags 3.
        if not try dripleaf_fits(f, level, x, y + 1, z) {
            return Meal.No
        }
        let facing = f.get_name(state, String("facing")) ?? String("north")
        try place_dripleaf(f, mut level, "big_dripleaf_stem", x, y, z, facing.copy())
        try place_dripleaf(f, mut level, "big_dripleaf", x, y + 1, z, facing)
        return Meal.Used
    }
    if name == "minecraft:big_dripleaf_stem" {
        // `BigDripleafStemBlock`: its leaf, past its stem up, `getTopConnectedBlock`, where it can
        // grow above, grown as a leaf is.
        var ty = y + 1
        while f.block(try level.state(f, x, ty, z)) == block {
            ty += 1
        }
        let leaf = try level.state(f, x, ty, z)
        if f.codec.blocks.name(f.block(leaf)) != "minecraft:big_dripleaf" or not try dripleaf_fits(f, level, x, ty + 1, z) {
            return Meal.No
        }
        let facing = f.get_name(state, String("facing")) ?? String("north")
        try place_dripleaf(f, mut level, "big_dripleaf_stem", x, ty, z, facing.copy())
        try place_dripleaf(f, mut level, "big_dripleaf", x, ty + 1, z, facing)
        return Meal.Used
    }
    if name == "minecraft:bamboo_sapling" {
        // `BambooSaplingBlock`: with air above, bamboo with small leaves there, flags 3,
        // `growBamboo`.
        if not f.is_air(try level.state(f, x, y + 1, z)) {
            return Meal.No
        }
        let bamboo = try f.named_block(String("bamboo"))
        _ = level.set_block(x, y + 1, z, try f.with_name(f.default_state(bamboo), String("leaves"), String("small")), UPDATE_ALL)
        return Meal.Used
    }
    if name == "minecraft:bamboo" {
        // `BambooStalkBlock`: with its bamboo, above and below up to 16 each, less than 16 high
        // and its top still growing; one or two drawn, each grown at the top while that holds
        // and there's air above it, `growBamboo`.
        var above = 0
        while above < 16 and f.block(try level.state(f, x, y + above + 1, z)) == block {
            above += 1
        }
        var below = 0
        while below < 16 and f.block(try level.state(f, x, y - below - 1, z)) == block {
            below += 1
        }
        var total = above + below + 1
        let top = try level.state(f, x, y + above, z)
        if total >= 16 or f.get_int(top, String("stage")) == some(1) {
            return Meal.No
        }
        let more = 1 + level.next_int_below(2)
        for _ in 0..more {
            let ty = y + above
            let t = try level.state(f, x, ty, z)
            if total >= 16 or f.get_int(t, String("stage")) == some(1) or not f.is_air(try level.state(f, x, ty + 1, z)) {
                return Meal.Used
            }
            try bamboo_grows(f, mut level, t, x, ty, z, total)
            above += 1
            total += 1
        }
        return Meal.Used
    }
    if name == "minecraft:pitcher_crop" {
        // `PitcherCropBlock`: its lower half, a year older, where it isn't 4, is in a light of 8,
        // has the block above in the world and, from 3, air or pitcher crop above; flags 2, and
        // from 3 its upper half above, flags 3.
        let low = if (f.get_name(state, String("half")) ?? String()) == "lower" { y } else { y - 1 }
        let lower = try level.state(f, x, low, z)
        if f.block(lower) != block or (f.get_name(lower, String("half")) ?? String()) != "lower" {
            return Meal.No
        }
        let was = f.get_int(lower, String("age")) ?? 0
        let age = (was + 1).min(4)
        if was >= 4 or raw_brightness(level, x, low, z, 0) < 8 or not level.in_height(low + 1) {
            return Meal.No
        }
        if age >= 3 {
            let up = try level.state(f, x, low + 1, z)
            if not f.is_air(up) and f.block(up) != block {
                return Meal.No
            }
        }
        let grown = try f.with_int(lower, String("age"), age)
        _ = level.set_block(x, low, z, grown, 2)
        if age >= 3 {
            _ = level.set_block(x, low + 1, z, try f.with_name(grown, String("half"), String("upper")), UPDATE_ALL)
        }
        return Meal.Used
    }
    if f.is_a(block, String("GlowLichenBlock")) {
        // `GlowLichenBlock`: where it can spread from one of its faces toward any direction,
        // `canSpreadInAnyDirection`; spread from a random face toward a random direction,
        // `spreadFromRandomFaceTowardRandomDirection`.
        var any = false
        for from in 0..6 {
            if try can_spread_any(f, level, block, state, x, y, z, from) {
                any = true
                break
            }
        }
        if not any {
            return Meal.No
        }
        _ = try spread_from_random_face(f, mut level, block, state, x, y, z)
        return Meal.Used
    }
    if f.is_a(block, String("MossyCarpetBlock")) {
        // `MossyCarpetBlock`: a carpet's base with a topper above, `createTopperWithSideChance`
        // with every side kept; it set there, flags 3.
        if not f.get_bool(state, String("bottom")) {
            return Meal.No
        }
        let previous = try level.state(f, x, y + 1, z)
        let on = f.block(previous) == block
        if (on and f.get_bool(previous, String("bottom"))) or not (on or f.replaceable(previous)) {
            return Meal.No
        }
        let topper = try mossy_updated(f, level, block, try f.with_bool(f.default_state(block), String("bottom"), false), x, y + 1, z, true)
        if not mossy_has_faces(f, topper) or topper == previous {
            return Meal.No
        }
        _ = level.set_block(x, y + 1, z, topper, UPDATE_ALL)
        return Meal.Used
    }
    if name == "minecraft:grass_block" {
        // `GrassBlock`: with air above in the world; 128 tries from above it, each walking a
        // sixteenth of its number of steps, each step at most 1 each way, drawn x, then y, then a
        // draw of 3 it's multiplied by and halved, then z, given up off grass below or into a
        // block whose collision is full, `stopBonemealSpread`; `placeBonemealEffect` where it
        // ends.
        if not f.is_air(try level.state(f, x, y + 1, z)) or not level.in_height(y + 1) {
            return Meal.No
        }
        for attempt in 0..128 {
            var tx = x
            var ty = y + 1
            var tz = z
            var stopped = false
            let steps = attempt / 16
            for _ in 0..steps {
                let dx = level.next_int_below(3) - 1
                let up = level.next_int_below(3) - 1
                let dy = up * level.next_int_below(3) / 2
                let dz = level.next_int_below(3) - 1
                tx += dx
                ty += dy
                tz += dz
                if f.block(try level.state(f, tx, ty - 1, tz)) != block or f.collision_full_block(try level.state(f, tx, ty, tz)) {
                    stopped = true
                    break
                }
            }
            if not stopped {
                try meal_effect(e, ticks, mut level, tx, ty, tz)
            }
        }
        return Meal.Used
    }
    if name == "minecraft:netherrack" {
        return try grow_netherrack(f, mut level, x, y, z)
    }
    if name == "minecraft:sea_pickle" {
        return try grow_pickles(f, mut level, state, x, y, z)
    }
    return Meal.No
}

// The head block of the growing plant body `name` and the way it grows, up 1 or down -1.
fn heads(name: String) -> (str, i32)? {
    if name == "minecraft:kelp_plant" {
        return some(("minecraft:kelp", 1))
    }
    if name == "minecraft:twisting_vines_plant" {
        return some(("minecraft:twisting_vines", 1))
    }
    if name == "minecraft:weeping_vines_plant" {
        return some(("minecraft:weeping_vines", -1))
    }
    return none
}

// `GrowingPlantHeadBlock` of the head `state` at x, y, z: where the block past it along its
// growth is what it grows into, water for kelp and air for the vines, in the world; that many
// blocks of it, kelp's 1 and the nether vines' as many as draws under 0.826 to the power of how
// many came before, `NetherVines.getBlocksToGrowWhenBonemealed`, while what's there is what it
// grows into in the world, each a year older than the last, at most 25, flags 3.
fn grow_head<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> Meal ! Thrown {
    let name = f.codec.blocks.name(f.block(state))
    let kelp = name == "minecraft:kelp"
    let step = if kelp or name == "minecraft:twisting_vines" { 1 } else { -1 }
    if not grows_into(f, kelp, try level.state(f, x, y + step, z)) or not level.in_height(y + step) {
        return Meal.No
    }
    var age = ((f.get_int(state, String("age")) ?? 0) + 1).min(25)
    var count = 1
    if not kelp {
        count = 0
        var chance = 1.0
        while level.next_double() < chance {
            count += 1
            chance *= 0.826
        }
    }
    var at = y + step
    for _ in 0..count {
        if not grows_into(f, kelp, try level.state(f, x, at, z)) or not level.in_height(at) {
            break
        }
        _ = level.set_block(x, at, z, try f.with_int(state, String("age"), age), UPDATE_ALL)
        at += step
        age = (age + 1).min(25)
    }
    return Meal.Used
}

// `canGrowInto`: water for kelp, else air.
fn grows_into(f: Facts, kelp: bool, state: u32) -> bool {
    return if kelp { f.block(state) == f.ids.water } else { f.is_air(state) }
}

// `DoublePlantBlock.placeAt` of `plant` at x, y, z with flags 2: its lower half there and its
// upper above, each waterlogged where it can be as there's water, `copyWaterloggedFrom`.
fn place_double<L: BlockAccess + LevelWriter>(f: Facts, level: mut L, plant: u32, x: i32, y: i32, z: i32) ! Thrown {
    for (dy, half) in [(0, "lower"), (1, "upper")] {
        var s = try f.with_name(plant, String("half"), String(half))
        if f.get_name(s, String("waterlogged")) != none {
            s = try f.with_bool(s, String("waterlogged"), f.is_water(try level.state(f, x, y + dy, z)))
        }
        _ = level.set_block(x, y + dy, z, s, 2)
    }
}

// `NetherrackBlock`: where what's above lets skylight down and nylium is in the 3 by 3 by 3 about
// it, `findBlocksIn`; with both kinds, one drawn, else the one found, set with flags 3.
fn grow_netherrack<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32) -> Meal ! Thrown {
    if f.flags(try level.state(f, x, y + 1, z)) & PROPAGATES_SKYLIGHT_DOWN == 0 {
        return Meal.No
    }
    let nylium = f.tag(String("minecraft:nylium"))
    let warped = try f.named_block(String("warped_nylium"))
    let crimson = try f.named_block(String("crimson_nylium"))
    var red = false
    var blue = false
    var any = false
    for dx in -1..2 {
        for dy in -1..2 {
            for dz in -1..2 {
                let s = try level.state(f, x + dx, y + dy, z + dz)
                if f.in_set(s, nylium) {
                    any = true
                    if f.block(s) == warped {
                        blue = true
                    } else if f.block(s) == crimson {
                        red = true
                    }
                }
            }
        }
    }
    if not any {
        return Meal.No
    }
    if blue and red {
        let drawn = if level.next_boolean() { warped } else { crimson }
        _ = level.set_block(x, y, z, f.default_state(drawn), UPDATE_ALL)
    } else if blue {
        _ = level.set_block(x, y, z, f.default_state(warped), UPDATE_ALL)
    } else if red {
        _ = level.set_block(x, y, z, f.default_state(crimson), UPDATE_ALL)
    }
    return Meal.Used
}

// `SeaPickleBlock`: waterlogged on a coral block. Across 5 columns west to east, widening to 5
// and back, the two blocks from here down, each but this one one time in 6 drawn and in water,
// sea pickles on a coral block, 1 to 4 drawn, flags 3; then this one 4, flags 2.
fn grow_pickles<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> Meal ! Thrown {
    if not f.get_bool(state, String("waterlogged")) or not f.in_set(try level.state(f, x, y - 1, z), f.tag(String("minecraft:coral_blocks"))) {
        return Meal.No
    }
    let corals = f.tag(String("minecraft:coral_blocks"))
    let pickle = f.block(state)
    var span = 1
    var back = 0
    for dx in 0..5 {
        for dz in 0..span {
            for py in (y - 1)..(y + 1) {
                let px = x - 2 + dx
                let pz = z - back + dz
                if (px != x or py != y or pz != z) and level.next_int_below(6) == 0 and f.block(try level.state(f, px, py, pz)) == f.ids.water {
                    if f.in_set(try level.state(f, px, py - 1, pz), corals) {
                        let n = level.next_int_below(4) + 1
                        _ = level.set_block(px, py, pz, try f.with_int(f.default_state(pickle), String("pickles"), n), UPDATE_ALL)
                    }
                }
            }
        }
        if dx < 2 {
            span += 2
            back += 1
        } else {
            span -= 2
            back -= 1
        }
    }
    _ = level.set_block(x, y, z, try f.with_int(state, String("pickles"), 4), 2)
    return Meal.Used
}

// One of the item `name`, as `new ItemStack(this)` makes it.
fn item_of(name: String) -> Tag {
    return item_stack(name)
}


// `hasSpreadableNeighbourPos`'s test of x, y, z: air, `isEmptyBlock`, where `state` can stay.
fn spreads_to<L: BlockAccess>(e: Env, level: L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    return f.is_air(try level.state(f, x, y, z)) and try can_survive(e, level, state, x, y, z)
}

// `BigDripleafBlock.canGrowInto`: in the world, air, water or a small dripleaf, `canReplace`.
fn dripleaf_fits<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not level.in_height(y) {
        return false
    }
    let s = try level.state(f, x, y, z)
    return f.is_air(s) or f.block(s) == f.ids.water or f.codec.blocks.name(f.block(s)) == "minecraft:small_dripleaf"
}

// `BigDripleafBlock.place` or `BigDripleafStemBlock.place` of `name` at x, y, z facing `facing`,
// waterlogged where there's water's source, flags 3.
fn place_dripleaf<L: BlockAccess + LevelWriter>(f: Facts, level: mut L, name: str, x: i32, y: i32, z: i32, facing: String) ! Thrown {
    let wet = f.fluid(try level.state(f, x, y, z)) == WATER_FLUID
    var s = f.default_state(try f.named_block(String(name)))
    s = try f.with_bool(s, String("waterlogged"), wet)
    s = try f.with_name(s, String("facing"), facing)
    _ = level.set_block(x, y, z, s, UPDATE_ALL)
}

// `GrassBlock.placeBonemealEffect` at x, y, z: short grass there given bone meal one time in 10,
// by a float drawn, where it can be; then where there was air in the world, one time in 8 by a
// float drawn one of the biome's bone-meal features, else `grass_bonemeal`, placed there.
fn meal_effect<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel + DropLevel + FeatureAccess>(e: Env, ticks: RandomTicks, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    let s = try level.state(f, x, y, z)
    if f.codec.blocks.name(f.block(s)) == "minecraft:short_grass" and level.next_float() < 0.1f32 {
        _ = try grow_crop(e, ticks, mut level, x, y, z)
    }
    if f.is_air(s) and level.in_height(y) {
        if level.next_float() < 0.125f32 {
            _ = try level.grow_bone_meal_feature(x, y, z)
        } else {
            _ = try level.grow_placed(String("minecraft:grass_bonemeal"), x, y, z)
        }
    }
}

/// `BoneMealItem.growWaterPlant` at x, y, z, beside the face `face` of the block used, none from a
/// dispenser (CAL-381): only in full water's own block; 128 tries from there, each walking a
/// sixteenth of its number of steps as grass's do, given up into a block whose collision is full.
/// Each grows seagrass, or in a biome bone meal grows coral in, on the first try from a side used,
/// a wall coral drawn, `#wall_corals`, facing that side, else one time in 4 an underwater plant
/// drawn, `#underwater_bonemeals`; a wall coral turned a drawn way, up to 4 times, while it can't
/// stay. Where it can stay, it's set in full water, flags 3, or seagrass there is given bone meal
/// one time in 10 where it can be. Whether it was water.
pub fn grow_water_plant<L: SpawnLevel + LevelWriter + RandomSource + BlockAccess + BlockLevel + DropLevel + FeatureAccess>(e: Env, ticks: RandomTicks, level: mut L, x: i32, y: i32, z: i32, face: i32?) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let here = try level.state(f, x, y, z)
    if f.block(here) != f.ids.water or f.fluid_amount(here) != 8 {
        return false
    }
    let seagrass = f.default_state(try f.named_block(String("seagrass")))
    let walls = f.tag(String("minecraft:wall_corals"))
    for attempt in 0..128 {
        var tx = x
        var ty = y
        var tz = z
        var stopped = false
        let steps = attempt / 16
        for _ in 0..steps {
            let dx = level.next_int_below(3) - 1
            let up = level.next_int_below(3) - 1
            let dy = up * level.next_int_below(3) / 2
            let dz = level.next_int_below(3) - 1
            tx += dx
            ty += dy
            tz += dz
            if f.collision_full_block(try level.state(f, tx, ty, tz)) {
                stopped = true
                break
            }
        }
        if stopped {
            continue
        }
        var grow = seagrass
        if level.coral_biome(tx, ty, tz) {
            if attempt == 0 and face != none and face != some(UP) and face != some(DOWN) {
                if let s = random_of(f, mut level, walls) {
                    grow = f.try_name(s, String("facing"), direction_name(face ?? NORTH))
                }
            } else if level.next_int_below(4) == 0 {
                if let s = random_of(f, mut level, f.tag(String("minecraft:underwater_bonemeals"))) {
                    grow = s
                }
            }
        }
        if f.in_set(grow, walls) and f.has(grow, String("facing")) {
            var turns = 0
            while turns < 4 and not try can_survive(e, level, grow, tx, ty, tz) {
                grow = f.try_name(grow, String("facing"), direction_name(horizontal(level.next_int_below(4))))
                turns += 1
            }
        }
        if not try can_survive(e, level, grow, tx, ty, tz) {
            continue
        }
        let there = try level.state(f, tx, ty, tz)
        if f.block(there) == f.ids.water and f.fluid_amount(there) == 8 {
            _ = level.set_block(tx, ty, tz, grow, UPDATE_ALL)
        } else if f.block(there) == f.block(seagrass) and try seagrass_grows(f, level, tx, ty, tz) and level.next_int_below(10) == 0 {
            _ = try grow_crop(e, ticks, mut level, tx, ty, tz)
        }
    }
    return true
}

// `getRandomElementOf`: one of the blocks in `set` drawn, in their order, which is the tag's, as
// vanilla's coral tags list them; none from an empty one, without a draw.
fn random_of<R: RandomSource>(f: Facts, random: mut R, set: BlockSet) -> u32? {
    var blocks = List<u32>()
    for b in 0..f.block_count {
        if set.contains(b) {
            blocks.push(b)
        }
    }
    if blocks.is_empty() {
        return none
    }
    return some(f.default_state(blocks[usize.wrap(random.next_int_below(i32.wrap(blocks.len())))]))
}

// `SeagrassBlock.isValidBonemealTarget`: water above.
fn seagrass_grows<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    return f.block(try level.state(f, x, y + 1, z)) == f.ids.water
}
