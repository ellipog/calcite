/// Block transformers, `BlockTransformer` (CAL-434): what an item with a `block_transformer`
/// component makes of the block it's used on, as an axe strips, scrapes and takes wax off, a hoe
/// tills and a shovel flattens. Each is read from the `block_transformer` registry as its codec
/// reads it, its states' providers among the worldgen ones, and asked of the level as it runs.
module world.transformers

import json.tree.{Json, as_string, parse}
import pack.data.{Data}
import random.source.{RandomSource}
import resources.identifier.{Identifier}
import worldgen.access.{BlockAccess}
import worldgen.codec.{bool_of, field, int_of, map_of}
import worldgen.facts.{Facts, direction_named}
import worldgen.interval.{Thrown}
import worldgen.predicates.{PredAccess, Readers}
import worldgen.state_providers.{Providers, optional_state}
import worldgen.survive.{Env}

/// One of a transformer's transforms, `BlockTransformData`: the state it makes, by its provider
/// among the transformers' providers; the sound heard, empty for `intentionally_empty`; the level
/// event its particle sends, `TransformParticle`, 0 for none; the faces it isn't used from; the
/// loot table it drops, popped from the clicked face, `clicked_face`, or the block's middle;
/// whether its state's made again from its neighbours' shapes; whether it's a copper chest's,
/// `COPPER_CHEST`; and how much of a stack it uses, one of a stackable one where `consume`, else
/// `damage` of a tool's durability.
pub struct Transform {
    pub provider: usize
    pub sound: String
    pub event: i32
    pub disallowed: List<i32>
    pub loot: String?
    pub from_face: bool
    pub update_shape: bool
    pub copper_chest: bool
    pub consume: bool
    pub damage: i32
}

/// The transformers read, each by its ID once, as lists of transforms.
pub struct Transformers {
    pub providers: Providers
    pub list: List<List<Transform>>
    ids: Map<String, usize>
}

impl Transformers {
    pub fn new() -> Transformers {
        return Transformers { providers: Providers.new(), list: List<List<Transform>>(), ids: Map<String, usize>() }
    }

    /// The transformer `id`'s place among those read, from `data/<namespace>/block_transformer/
    /// <path>.json` of `zip` the first time it's asked for; `DIRECT_CODEC`, 1 to 200 transforms.
    pub fn read(mut self, zip: Data, facts: Facts, rd: Readers, id: String) -> usize ! String {
        let key = (try Identifier.parse(id.copy())).to_string()
        if let i = self.ids.get(key) {
            return i
        }
        let colon = key.find(":") else fail "`{key}` isn't an identifier"
        let path = "data/{key[..colon]}/block_transformer/{key[colon + 1..]}.json"
        if zip.find(path.copy()) == none {
            fail "Unknown registry key in ResourceKey[minecraft:root / minecraft:block_transformer]: {key}"
        }
        let bytes = try zip.read_named(path.copy())
        let text = String.from_utf8(bytes) else fail "{path} isn't UTF-8"
        let value = parse(text) else fail "{path} isn't JSON"
        let Json.Array(each) = value else fail "{path} isn't a list"
        if each.is_empty() or each.len() > 200 {
            fail "{path} has {each.len()} transforms, not 1 to 200"
        }
        var transforms = List<Transform>()
        for t in each {
            transforms.push(try self.read_transform(zip, facts, rd, t))
        }
        let i = self.list.len()
        self.list.push(transforms)
        self.ids.insert(key, i)
        return i
    }

    // `BlockTransformData.CODEC`, its fields' defaults its codec's.
    fn read_transform(mut self, zip: Data, facts: Facts, rd: Readers, value: Json) -> Transform ! String {
        let m = try map_of(value)
        let given = field(m, "block_state_provider") else fail "No key block_state_provider"
        let provider = try self.providers.read(zip, facts, rd, given)
        var sound = String()
        if let s = field(m, "sound") {
            let name = as_string(s) else fail "a transform's sound isn't an ID"
            let id = (try Identifier.parse(name)).to_string()
            if id != "minecraft:intentionally_empty" {
                sound = id
            }
        }
        var event = 0
        if let p = field(m, "particle") {
            let name = as_string(p) ?? String()
            let names: List<str> = ["none", "scrape", "wax_on", "wax_off"]
            let events: List<i32> = [0, 3005, 3003, 3004]
            var found = false
            for k in 0..names.len() {
                if name == names[k] {
                    event = events[k]
                    found = true
                }
            }
            if not found {
                fail "Unknown element name:{name}"
            }
        }
        var disallowed = List<i32>()
        if let Json.Array(faces) = field(m, "disallowed_faces") ?? Json.Null {
            for face in faces {
                let name = as_string(face) ?? String()
                let d = direction_named(name.copy()) else fail "Unknown element name:{name}"
                disallowed.push(d)
            }
        }
        var loot: String? = none
        if let l = field(m, "loot") {
            let name = as_string(l) else fail "a transform's loot isn't an ID"
            loot = some((try Identifier.parse(name)).to_string())
        }
        var from_face = false
        if let d = field(m, "drop_strategy") {
            let name = as_string(d) ?? String()
            if name != "clicked_face" and name != "from_middle" {
                fail "Unknown element name:{name}"
            }
            from_face = name == "clicked_face"
        }
        var copper_chest = false
        if let t = field(m, "transform_type") {
            let name = as_string(t) ?? String()
            if name != "copper_chest" and name != "single_block" {
                fail "Unknown element name:{name}"
            }
            copper_chest = name == "copper_chest"
        }
        let update_shape = if let u = field(m, "update_from_neighbors") { try bool_of(u) } else { true }
        let consume = if let c = field(m, "consume_on_use") { try bool_of(c) } else { true }
        let damage = if let d = field(m, "item_damage_per_use") { try int_of(d) } else { 0 }
        if damage < 0 {
            fail "Value must be non-negative: {damage}"
        }
        return Transform { provider: provider, sound: sound, event: event, disallowed: disallowed, loot: loot, from_face: from_face, update_shape: update_shape, copper_chest: copper_chest, consume: consume, damage: damage }
    }
}

/// `transformBlock`'s pick of the transformer `which` used on the block at x, y, z from the face
/// `face`: the first transform not disallowed from that face whose provider makes a state there,
/// `getOptionalState`, with `rand` the level's random; which it is, and the state. None where
/// none does, which passes.
pub fn transform_at<T: RandomSource, R: BlockAccess + PredAccess>(e: Env, ts: Transformers, r: R, rand: mut T, which: usize, face: i32, x: i32, y: i32, z: i32) -> (usize, u32)? ! Thrown {
    for i in 0..ts.list[which].len() {
        if ts.list[which][i].disallowed.contains(face) {
            continue
        }
        if let s = try optional_state(e, ts.providers, r, mut rand, ts.list[which][i].provider, x, y, z) {
            return some((i, s))
        }
    }
    return none
}
