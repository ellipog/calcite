/// What a hopper reaches of its level's entities as the level's block entities tick, `HopperWorld`
/// (CAL-277): the item entities, which it takes in from its suck box, `getItemsAtAndAbove`, and
/// the container entities, chest minecarts and chest boats, which it pushes into and pulls from
/// where there's no block container, `getEntityContainer`. Its level's server takes them as they
/// are just before, and puts back what changed just after: an item's stack, gone where it's all
/// taken in, `discard`, and a container's slots. Each comes in the order the level's entity
/// sections give them, `getEntitiesOfClass`.
module world.hopper_reach

import nbt.tag.{Tag}
import world.collision.{Aabb}

/// An item entity: its ID, box and stack, none once it's all taken in, whether that changed,
/// `setItem`, and where it comes among the level's entities, its section's X, its section by
/// `SectionPos.asLong` and its place in the section.
pub struct ReachedItem {
    pub id: i32
    pub bounds: Aabb
    pub stack: Tag?
    pub changed: bool = false
    pub order: (i32, i64, usize)
}

/// A container entity, a chest minecart's or a chest boat's: its ID, box and slots, whether its
/// loot's still to come, and whether its slots changed; and where it comes, as `ReachedItem`'s.
pub struct ReachedBox {
    pub id: i32
    pub bounds: Aabb
    pub slots: List<Tag?>
    pub loot: bool = false
    pub changed: bool = false
    pub order: (i32, i64, usize)
}

/// What a hopper reaches of a level's entities.
pub struct HopperWorld {
    pub items: List<ReachedItem> = List<ReachedItem>()
    pub boxes: List<ReachedBox> = List<ReachedBox>()
}

impl HopperWorld {
    /// The item entities with something in their stacks whose boxes meet `b`, by their places in
    /// `items`, in the level's order.
    pub fn items_in(self, b: Aabb) -> List<usize> {
        var found = List<(i32, i64, usize, usize)>()
        for (k, i) in self.items.enumerate() {
            if i.stack == none {
                continue
            }
            if i.bounds.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                let (sx, key, at) = i.order
                found.push((sx, key, at, k))
            }
        }
        return in_order(found)
    }

    /// The container entities whose boxes meet `b`, by their places in `boxes`, in the level's
    /// order.
    pub fn boxes_in(self, b: Aabb) -> List<usize> {
        var found = List<(i32, i64, usize, usize)>()
        for (k, c) in self.boxes.enumerate() {
            if c.bounds.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                let (sx, key, at) = c.order
                found.push((sx, key, at, k))
            }
        }
        return in_order(found)
    }
}

// The last of each of `found` sorted by the rest, as `Entities.found` walks the sections: by
// section X, then section, then place in it.
fn in_order(found: List<(i32, i64, usize, usize)>) -> List<usize> {
    var sorted = found.copy()
    var i = 1usize
    while i < sorted.len() {
        var j = i
        while j > 0 and before(sorted[j], sorted[j - 1]) {
            let t = sorted[j - 1]
            sorted[j - 1] = sorted[j]
            sorted[j] = t
            j -= 1
        }
        i += 1
    }
    var out = List<usize>()
    for (_, _, _, k) in sorted {
        out.push(k)
    }
    return out
}

fn before(a: (i32, i64, usize, usize), b: (i32, i64, usize, usize)) -> bool {
    let (ax, ak, aa, _) = a
    let (bx, bk, ba, _) = b
    if ax != bx {
        return ax < bx
    }
    if ak != bk {
        return ak < bk
    }
    return aa < ba
}
