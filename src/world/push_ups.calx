/// What a level does of what stands where a block grows (CAL-204): `Block.pushEntitiesUp`, which
/// farmland and dirt paths turning to dirt and snow piling up ask of it.
module world.push_ups

import world.collision.{Aabb}

/// A level that pushes up what's in the way of the part a block grows by.
pub interface PushUps {
    /// `Block.pushEntitiesUp` of what's in the way of `slab`, the part a block grows by, players
    /// too, in its turn among what's dropped.
    fn add_push_up(mut self, slab: Aabb)
}
