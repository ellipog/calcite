/// Positions in a world: a block's, and a chunk's, as vanilla's `BlockPos` and `ChunkPos` hold
/// them.
module world.pos

import protocol.wire.{Reader, Writer, DecodeError, Wire}

/// A block's position, vanilla's `BlockPos`. It goes over the wire as one long: 26 bits of `x`,
/// then 26 of `z`, then 12 of `y`, as `BlockPos.asLong` packs it.
pub struct BlockPos {
    pub x: i32
    pub y: i32
    pub z: i32
}

impl BlockPos {
    /// The position packed in a long, as `asLong`.
    pub fn pack(self) -> i64 {
        return ((i64(self.x) & 0x3FFFFFF) << 38) | ((i64(self.z) & 0x3FFFFFF) << 12) | (i64(self.y) & 0xFFF)
    }

    /// The position a long packs, as `BlockPos.of`.
    pub fn unpack(v: i64) -> BlockPos {
        return BlockPos { x: i32.wrap(v >> 38), y: i32.wrap((v << 52) >> 52), z: i32.wrap((v << 26) >> 38) }
    }

    /// The chunk the block is in.
    pub fn chunk(self) -> ChunkPos {
        return ChunkPos { x: self.x >> 4, z: self.z >> 4 }
    }
}

impl Wire for BlockPos {
    fn read(r: mut Reader) -> BlockPos ! DecodeError {
        return BlockPos.unpack(try r.i64())
    }

    fn write(self, w: mut Writer) {
        w.i64(self.pack())
    }
}

/// A chunk's position, in chunks: a block's `x` and `z` shifted right by 4, vanilla's
/// `ChunkPos`.
pub struct ChunkPos {
    pub x: i32
    pub z: i32
}

impl ChunkPos {
    /// The chunk holding the point `x`, `z`, as `ChunkPos.containing`.
    pub fn containing(x: f64, z: f64) -> ChunkPos {
        return ChunkPos { x: i32.saturate(x.floor()) >> 4, z: i32.saturate(z.floor()) >> 4 }
    }

    /// The square of the distance to `other`, in chunks, as `distanceSquared`.
    pub fn distance_squared(self, other: ChunkPos) -> i32 {
        let dx = self.x - other.x
        let dz = self.z - other.z
        return dx * dx + dz * dz
    }

    /// The chunk packed in a long, `x` in the low half, as `ChunkPos.pack`.
    pub fn pack(self) -> i64 {
        return (i64(self.x) & 0xFFFFFFFF) | ((i64(self.z) & 0xFFFFFFFF) << 32)
    }
}

impl Wire for ChunkPos {
    fn read(r: mut Reader) -> ChunkPos ! DecodeError {
        let v = try r.i64()
        return ChunkPos { x: i32.wrap(v), z: i32.wrap(v >> 32) }
    }

    fn write(self, w: mut Writer) {
        w.i64(self.pack())
    }
}
