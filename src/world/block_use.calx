/// What a block does as a player uses it, as `ServerPlayerGameMode.useItemOn` asks it before the
/// item's own use (CAL-139): `useItemOn` with what's held, then `useWithoutItem` for the main hand,
/// each as its block's class has it. Whether the use consumes the click is worked out as vanilla
/// works it out, so a block is placed against a block exactly where vanilla's would be; what the
/// use does, a menu opened, a door swung, a note tuned, waits for using blocks and is told of.
/// Redstone ore lights, as it does when it's hit.
///
/// Where the answer hangs on a block entity's contents Calcite doesn't read yet it's taken as an
/// empty one's: a decorated pot is empty, and a sign has no click commands and isn't waxed.
module world.block_use

import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import world.block_level.{BlockLevel}
import world.level_writer.{UPDATE_LIMIT}
import world.placing.{PlaceFacts, component_of}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, Facts, UP, opposite}
import worldgen.interval.{Thrown}
import worldgen.survive.{facing_of}

/// What a block's use came to, as `ServerPlayerGameMode.useItemOn` reads its
/// `InteractionResult`: `Pass` and `Fail` go on to the item's use; `Empty`,
/// `TRY_WITH_EMPTY_HAND`, to the use without an item, for the main hand; `Done` ends the click,
/// a `Success` or `CONSUME`.
pub enum Used {
    Pass
    Empty
    Done
}

/// Who uses the block and how (CAL-139): what's held in the hand used, by its item's ID, as
/// `minecraft:shears`, empty for nothing, with the stack and its ID in the item registry; the hand,
/// 0 for the main; what's in the off hand; whether they may build, may use game master blocks, may
/// eat, which an invulnerable or hungry player may, and sneak; where the block was hit and on which
/// face; and whether what's held, a block item, could go where the click puts it,
/// `BlockPlaceContext.canPlace`.
pub struct User {
    pub item: String
    pub held: Tag?
    pub item_id: i32
    pub hand: i32
    pub offhand: String
    pub may_build: bool
    pub game_master: bool
    pub can_eat: bool
    pub face: i32
    pub at_y: f64
    pub block_item: bool
    pub can_place: bool
}

// Whether what's held is in the item tag `tag`, as `minecraft:candles`.
fn tagged(items: ItemCodecs, u: User, tag: str) -> bool {
    if u.item_id < 0 {
        return false
    }
    return items.holder_set_has("item", Tag.Str("#{tag}"), u.item_id)
}

// Whether what's held is the item `name`.
fn holds(u: User, name: str) -> bool {
    return u.item == String(name)
}

// The block's name without its namespace, as `water_cauldron`.
fn short_name(f: Facts, block: u32) -> String {
    let name = f.codec.blocks.name(block)
    if name.starts_with("minecraft:") {
        return name[10..].copy()
    }
    return name
}

/// `BlockState.useItemOn` of the block `state` at `x`, `y`, `z`, used as `u` says, as its class
/// has it. What the use does is put in `missing`, but redstone ore's lighting.
pub fn use_item_on<L: BlockAccess + BlockLevel>(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut L, state: u32, x: i32, y: i32, z: i32, u: User, missing: mut List<String>) -> Used ! Thrown {
    let block = f.block(state)
    let kind = p.use_item_class(block)
    let name = short_name(f, block)
    if kind == "BlockBehaviour" {
        return Used.Empty
    }
    if kind == "RedStoneOreBlock" {
        if not f.get_bool(state, "lit") {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "lit", true), 3, UPDATE_LIMIT)
        }
        return if u.block_item and u.can_place { Used.Pass } else { Used.Done }
    }
    var done = String()
    var used = Used.Empty
    if kind == "AbstractCauldronBlock" {
        let level_of = f.get_int(state, "level") ?? 0
        if holds(u, "minecraft:lava_bucket") or holds(u, "minecraft:water_bucket") or holds(u, "minecraft:powder_snow_bucket") {
            used = Used.Done
        } else if name == "cauldron" {
            if holds(u, "minecraft:potion") and water_potion(u.held) {
                used = Used.Done
            }
        } else if name == "water_cauldron" {
            if holds(u, "minecraft:bucket") {
                used = if level_of == 3 { Used.Done } else { Used.Empty }
            } else if holds(u, "minecraft:glass_bottle") {
                used = Used.Done
            } else if holds(u, "minecraft:potion") {
                used = if level_of != 3 and water_potion(u.held) { Used.Done } else { Used.Empty }
            } else if tagged(items, u, "minecraft:cauldron_can_remove_dye") {
                used = if component_of(u.held, "minecraft:dyed_color") != none { Used.Done } else { Used.Empty }
            } else if u.item.ends_with("_banner") {
                used = if has_patterns(u.held) { Used.Done } else { Used.Empty }
            } else if u.item.ends_with("_shulker_box") {
                used = Used.Done
            }
        } else if name == "lava_cauldron" {
            if holds(u, "minecraft:bucket") {
                used = Used.Done
            }
        } else if name == "powder_snow_cauldron" {
            if holds(u, "minecraft:bucket") {
                used = if level_of == 3 { Used.Done } else { Used.Empty }
            }
        }
        done = String("Using cauldrons")
    } else if kind == "BeehiveBlock" {
        if (f.get_int(state, "honey_level") ?? 0) >= 5 and (holds(u, "minecraft:shears") or holds(u, "minecraft:glass_bottle")) {
            used = Used.Done
        }
        done = String("Taking honey from hives")
    } else if kind == "CakeBlock" {
        let block_held = if let b = p.block_of(u.item_id) { f.is_a(b, "CandleBlock") } else { false }
        if tagged(items, u, "minecraft:candles") and (f.get_int(state, "bites") ?? 0) == 0 and block_held {
            used = Used.Done
        }
        done = String("Putting candles on cakes")
    } else if kind == "CampfireBlock" {
        let foods: List<str> = ["minecraft:beef", "minecraft:chicken", "minecraft:cod", "minecraft:kelp", "minecraft:mutton", "minecraft:porkchop", "minecraft:potato", "minecraft:rabbit", "minecraft:salmon"]
        for food in foods {
            if holds(u, food) {
                used = Used.Done
            }
        }
        if tagged(items, u, "minecraft:douses_campfires") and f.get_bool(state, "lit") {
            used = Used.Done
        }
        done = String("Cooking on and dousing campfires")
    } else if kind == "CandleBlock" {
        if u.held == none and u.may_build and f.get_bool(state, "lit") {
            used = Used.Done
        }
        done = String("Putting out candles")
    } else if kind == "CandleCakeBlock" {
        if holds(u, "minecraft:flint_and_steel") or holds(u, "minecraft:fire_charge") {
            return Used.Pass
        }
        if u.at_y - f64(y) > 0.5 and u.held == none and f.get_bool(state, "lit") {
            used = Used.Done
        }
        done = String("Putting out candles")
    } else if kind == "ChiseledBookShelfBlock" {
        if not tagged(items, u, "minecraft:bookshelf_books") {
            return Used.Empty
        }
        if u.face != try facing_of(f, state) {
            return Used.Pass
        }
        missing.push(String("Putting books in chiseled bookshelves"))
        return Used.Done
    } else if kind == "ComposterBlock" {
        if (f.get_int(state, "level") ?? 0) < 8 and component_of_item(items, u, "minecraft:compostable") {
            used = Used.Done
        }
        done = String("Composting")
    } else if kind == "CopperGolemStatueBlock" or kind == "WeatheringCopperGolemStatueBlock" {
        if tagged(items, u, "minecraft:axes") {
            return Used.Pass
        }
        if kind == "WeatheringCopperGolemStatueBlock" and holds(u, "minecraft:honeycomb") {
            return Used.Pass
        }
        used = Used.Done
        done = String("Posing copper golem statues")
    } else if kind == "DecoratedPotBlock" {
        if u.held != none {
            used = Used.Done
        }
        done = String("Putting items in decorated pots")
    } else if kind == "FlowerPotBlock" {
        let potted = if let b = p.block_of(u.item_id) { f.block_named("minecraft:potted_{short_name(f, b)}") != none } else { false }
        if not potted {
            return Used.Empty
        }
        used = Used.Done
        if name == "flower_pot" {
            done = String("Potting plants")
        }
    } else if kind == "JukeboxBlock" {
        if f.get_bool(state, "has_record") {
            return Used.Empty
        }
        if component_of_item(items, u, "minecraft:jukebox_playable") {
            used = Used.Done
        }
        done = String("Playing records in jukeboxes")
    } else if kind == "LecternBlock" {
        if f.get_bool(state, "has_book") {
            return Used.Empty
        }
        if tagged(items, u, "minecraft:lectern_books") {
            missing.push(String("Putting books on lecterns"))
            return Used.Done
        }
        return if u.held == none and u.hand == 0 { Used.Pass } else { Used.Empty }
    } else if kind == "NoteBlock" {
        if tagged(items, u, "minecraft:note_block_top_instruments") and u.face == UP {
            return Used.Pass
        }
        return Used.Empty
    } else if kind == "PumpkinBlock" {
        if holds(u, "minecraft:shears") {
            used = Used.Done
        }
        done = String("Carving pumpkins")
    } else if kind == "RespawnAnchorBlock" {
        let charge = f.get_int(state, "charge") ?? 0
        if holds(u, "minecraft:glowstone") and charge < 4 {
            used = Used.Done
        } else if u.hand == 0 and u.offhand == "minecraft:glowstone" and charge < 4 {
            return Used.Pass
        }
        done = String("Charging respawn anchors")
    } else if kind == "ShelfBlock" {
        if u.hand != 0 or u.face != try facing_of(f, state) {
            return Used.Pass
        }
        if u.held == none {
            missing.push(String("Taking items off shelves"))
            return Used.Pass
        }
        used = Used.Done
        done = String("Putting items on shelves")
    } else if kind == "SignBlock" or kind == "CeilingHangingSignBlock" or kind == "WallHangingSignBlock" {
        if kind != "SignBlock" and p.kind_of(u.item_id) == "HangingSignItem" {
            let under = kind == "CeilingHangingSignBlock" and u.face == DOWN
            let beside = kind == "WallHangingSignBlock" and u.face == DOWN
            if under or beside {
                return Used.Pass
            }
        }
        let applies = holds(u, "minecraft:glow_ink_sac") or holds(u, "minecraft:ink_sac") or holds(u, "minecraft:honeycomb") or u.item.ends_with("_dye")
        if applies and u.may_build {
            used = Used.Done
        }
        done = String("Dyeing, glowing and waxing signs")
    } else if kind == "SweetBerryBushBlock" {
        if (f.get_int(state, "age") ?? 0) < 3 and holds(u, "minecraft:bone_meal") {
            return Used.Pass
        }
        return Used.Empty
    } else if kind == "TntBlock" {
        if holds(u, "minecraft:flint_and_steel") or holds(u, "minecraft:fire_charge") {
            used = Used.Done
        }
        done = String("Lighting TNT")
    } else if kind == "VaultBlock" {
        if u.held != none and f.get_name(state, "vault_state") == some(String("active")) {
            used = Used.Done
        }
        done = String("Opening vaults")
    } else {
        missing.push("Using {name}, a {kind}, with an item")
        return Used.Done
    }
    match used {
        Used.Done => {
            if not done.is_empty() {
                missing.push(done)
            }
        },
        _ => {},
    }
    return used
}

/// `BlockState.useWithoutItem` of the block `state` at `x`, `y`, `z`, used as `u` says, as its
/// class has it. What the use does is put in `missing`, but a moving piston's going, which has no
/// block entity to finish it.
pub fn use_without_item<L: BlockAccess + BlockLevel>(f: Facts, p: PlaceFacts, level: mut L, state: u32, x: i32, y: i32, z: i32, u: User, missing: mut List<String>) -> Used ! Thrown {
    let block = f.block(state)
    let kind = p.use_class(block)
    let name = short_name(f, block)
    if kind == "BlockBehaviour" or kind == "FenceBlock" {
        // A fence ties the player's leashed mobs to it, and Calcite has no mobs.
        return Used.Pass
    }
    let menus: List<str> = ["AbstractFurnaceBlock", "AnvilBlock", "BarrelBlock", "BeaconBlock", "BrewingStandBlock", "CartographyTableBlock", "ChestBlock", "CrafterBlock", "CraftingTableBlock", "DispenserBlock", "EnchantingTableBlock", "EnderChestBlock", "GrindstoneBlock", "HopperBlock", "LoomBlock", "ShulkerBoxBlock", "SmithingTableBlock", "StonecutterBlock"]
    for m in menus {
        if kind == String(m) {
            missing.push("Opening {name}'s menu")
            return Used.Done
        }
    }
    if kind == "MovingPistonBlock" {
        if level.moving_piston(x, y, z) == none {
            _ = level.set_block_limited(x, y, z, f.ids.air_state, 3, UPDATE_LIMIT)
            return Used.Done
        }
        return Used.Pass
    }
    var done = String()
    if kind == "AbstractBedBlock" {
        done = String("Sleeping in beds")
    } else if kind == "BellBlock" {
        if not bell_hit(f, state, u) {
            return Used.Pass
        }
        done = String("Ringing bells")
    } else if kind == "ButtonBlock" {
        if f.get_bool(state, "powered") {
            return Used.Done
        }
        done = String("Pressing buttons")
    } else if kind == "CakeBlock" or kind == "CandleCakeBlock" {
        if not u.can_eat {
            return Used.Pass
        }
        done = String("Eating cake")
    } else if kind == "CaveVinesBlock" or kind == "CaveVinesPlantBlock" {
        if not f.get_bool(state, "berries") {
            return Used.Pass
        }
        done = String("Picking glow berries")
    } else if kind == "ChiseledBookShelfBlock" {
        if u.face != try facing_of(f, state) {
            return Used.Pass
        }
        done = String("Taking books from chiseled bookshelves")
    } else if kind == "CommandBlock" or kind == "JigsawBlock" or kind == "StructureBlock" or kind == "TestBlock" or kind == "TestInstanceBlock" {
        if not u.game_master {
            return Used.Pass
        }
        done = "Editing {name}"
    } else if kind == "ComparatorBlock" or kind == "RepeaterBlock" or kind == "DaylightDetectorBlock" {
        if not u.may_build {
            return Used.Pass
        }
        done = "Switching {name}"
    } else if kind == "ComposterBlock" {
        if (f.get_int(state, "level") ?? 0) != 8 {
            return Used.Pass
        }
        done = String("Taking bone meal from composters")
    } else if kind == "DecoratedPotBlock" {
        done = String("Wobbling decorated pots")
    } else if kind == "DoorBlock" or kind == "TrapDoorBlock" {
        if name.starts_with("iron_") {
            return Used.Pass
        }
        done = "Opening {name}"
    } else if kind == "DragonEggBlock" {
        done = String("Dragon eggs teleporting")
    } else if kind == "FenceGateBlock" {
        done = String("Opening fence gates")
    } else if kind == "FlowerPotBlock" {
        if name == "flower_pot" {
            return Used.Done
        }
        done = String("Taking plants from pots")
    } else if kind == "JukeboxBlock" {
        if not f.get_bool(state, "has_record") {
            return Used.Pass
        }
        done = String("Taking records from jukeboxes")
    } else if kind == "LecternBlock" {
        if not f.get_bool(state, "has_book") {
            return Used.Done
        }
        done = String("Reading books on lecterns")
    } else if kind == "LeverBlock" {
        done = String("Pulling levers")
    } else if kind == "LightBlock" {
        if not u.game_master {
            return Used.Done
        }
        done = String("Turning light blocks")
    } else if kind == "NoteBlock" {
        done = String("Tuning note blocks")
    } else if kind == "RedstoneWireBlock" {
        if not u.may_build or not wire_alone(f, state) {
            return Used.Pass
        }
        done = String("Turning redstone dust between a dot and a cross")
    } else if kind == "RespawnAnchorBlock" {
        if (f.get_int(state, "charge") ?? 0) == 0 {
            return Used.Pass
        }
        done = String("Setting the spawn at respawn anchors")
    } else if kind == "SignBlock" {
        if not u.may_build {
            return Used.Pass
        }
        done = String("Editing signs")
    } else if kind == "SweetBerryBushBlock" {
        if (f.get_int(state, "age") ?? 0) <= 1 {
            return Used.Pass
        }
        done = String("Picking sweet berries")
    } else {
        missing.push("Using {name}, a {kind}")
        return Used.Done
    }
    if not done.is_empty() {
        missing.push(done)
    }
    return Used.Done
}

// `BellBlock.isProperHit`: a side that isn't the top or bottom, below its top 3/16, across a bell
// on the floor, along one on a wall, and any for one on the ceiling.
fn bell_hit(f: Facts, state: u32, u: User) -> bool {
    if u.face == DOWN or u.face == UP or u.at_y > f64(0.8124f32) {
        return false
    }
    let facing = match facing_of(f, state) {
        ok(d) => d,
        err(_) => 2,
    }
    let same_axis = facing == u.face or facing == opposite(u.face)
    let attach = f.get_name(state, "attachment") ?? String("floor")
    if attach == "floor" {
        return same_axis
    }
    if attach == "single_wall" or attach == "double_wall" {
        return not same_axis
    }
    return attach == "ceiling"
}

// `RedstoneWireBlock.isCross` or `isDot`: every side joined, or none.
fn wire_alone(f: Facts, state: u32) -> bool {
    var joined = 0
    for side in ["north", "east", "south", "west"] {
        if (f.get_name(state, String(side)) ?? String("none")) != "none" {
            joined += 1
        }
    }
    return joined == 0 or joined == 4
}

// Whether the potion held is water, `PotionContents.is(Potions.WATER)`.
fn water_potion(held: Tag?) -> bool {
    let contents = component_of(held, "minecraft:potion_contents") else return false
    return match contents {
        Tag.Str(s) => s == "minecraft:water",
        Tag.Compound(m) => {
            if not m.contains("potion") {
                return false
            }
            let potion = m["potion"].copy()
            match potion {
                Tag.Str(s) => s == "minecraft:water",
                _ => false,
            }
        },
        _ => false,
    }
}

// Whether the banner held has patterns, `BANNER_PATTERNS`' layers.
fn has_patterns(held: Tag?) -> bool {
    let patterns = component_of(held, "minecraft:banner_patterns") else return false
    return match patterns {
        Tag.List(l) => not l.is_empty(),
        _ => false,
    }
}

// Whether what's held has the component `name`, its item's own or its stack's.
fn component_of_item(items: ItemCodecs, u: User, name: str) -> bool {
    let stack = u.held.copy() else return false
    return items.component(stack, String(name)) != none
}
