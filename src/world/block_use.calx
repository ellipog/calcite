/// What a block does as a player uses it, as `ServerPlayerGameMode.useItemOn` asks it before the
/// item's own use (CAL-139): `useItemOn` with what's held, then `useWithoutItem` for the main hand,
/// each as its block's class has it. Whether the use consumes the click is worked out as vanilla
/// works it out, so a block is placed against a block exactly where vanilla's would be. Doors,
/// trapdoors and fence gates swing, levers are pulled and buttons pressed, repeaters, comparators
/// and daylight detectors switched, redstone dust turned, note blocks tuned, bells rung and light
/// blocks turned (CAL-140),
/// and redstone ore lights. Cauldrons are filled and emptied with buckets and bottles and wash dye
/// and patterns off, composters fill, flower pots are planted and emptied, candles put out, cakes
/// take candles and are eaten, lecterns take books, chiseled bookshelves take and give them, and
/// decorated pots take items and wobble (CAL-142), what that does to the player's hand, inventory and
/// food a `Handed` for `server.network` to do. Chests, barrels, ender chests, shulker boxes,
/// dispensers, droppers and hoppers open their menus, `Handed.Open`, as `world.containers` has
/// them (CAL-144), and so do crafting tables (CAL-147). What other uses do, another menu opened,
/// is told of. The game events and stats
/// they send wait for what hears and counts them.
///
/// Where the answer hangs on a block entity's contents Calcite doesn't read yet it's taken as an
/// empty one's: a decorated pot is empty, and a sign has no click commands and isn't waxed.
module world.block_use

import nbt.tag.{Tag}
import random.source.{RandomSource}
import registry.components.{ItemCodecs}
import world.block_entity_ticks.{play_song, playing_song, song_changed, stop_song, update_signal_strength}
import world.block_level.{BlockLevel, remove_block, update_output_signal}
import world.containers.{Opening, opening}
import world.drops.{DropLevel}
import world.digging.{interact_ore}
import world.block_updates.{comparator_refresh, play_note}
import world.level_writer.{UPDATE_LIMIT}
import world.placing.{PlaceFacts, component_of, from_y_rot}
import world.shelves.{chain_of}
import world.sources.{attached_neighbours}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, EAST, Facts, NORTH, SOUTH, UP, WATER_FLUID, WEST, direction_name, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.signals.{wire_connections}
import worldgen.survive.{direction_property, facing_of}

/// What a block's use came to, as `ServerPlayerGameMode.useItemOn` reads its
/// `InteractionResult`: `Pass` and `Fail` go on to the item's use; `Empty`,
/// `TRY_WITH_EMPTY_HAND`, to the use without an item, for the main hand; `Done` ends the click,
/// a `Success` or `CONSUME`.
pub enum Used {
    Pass
    Empty
    Done
}

/// What a block's use does to the player besides the level (CAL-142), which `server.network` does
/// to them: `Spent`, one of the stack used gone, `consume(1, player)`, unless they've infinite
/// materials; `Filled`, the stack used made the stack given, `ItemUtils.createFilledResult`, a
/// player with infinite materials keeping theirs, and given the new one where they've none like
/// it, where the flag, `limitCreativeStackSize`, is set; `Changed`, the stack used made the one
/// given, as one has its dye washed off; `Added`, a stack given them, `Player.addItem`, dropped
/// where it doesn't fit; and `Ate`, food eaten, `FoodData.eat`, its nutrition and its saturation's
/// modifier.
pub enum Handed {
    Spent
    Filled(Tag, bool)
    Changed(Tag)
    Added(Tag)
    Ate(i32, f32)
    /// What's held swapped for what was in a shelf's slot, or for nothing: the player holds it,
    /// but one with infinite materials who's given nothing keeps theirs (CAL-143).
    Swapped(Tag?)
    /// The hotbar's slot set to a stack, or emptied, as a powered shelf swaps it (CAL-143).
    Slot(i32, Tag?)
    /// The player's arm swung by the server, `SUCCESS_SERVER`, which they're sent too (CAL-143).
    Swing
    /// A container's menu opened for them, `Player.openMenu` (CAL-144).
    Open(Opening)
    /// One more of their statistic of the type and the value named, `awardStat` (CAL-164), as
    /// `minecraft:custom` and `minecraft:open_chest`.
    Stat(String, String)
    /// A bed used, by its head, which they sleep in where they may, `startSleepInBed` (D574).
    Bed(i32, i32, i32)
}

/// Who uses the block and how (CAL-139): what's held in the hand used, by its item's ID, as
/// `minecraft:shears`, empty for nothing, with the stack and its ID in the item registry; the hand,
/// 0 for the main; what's in the off hand; whether they may build, may use game master blocks, may
/// eat, which an invulnerable or hungry player may, and sneak; where the block was hit, its height
/// in the world, and on which face, and across, `at_x` and `at_z` (CAL-142); whether what's held, a block item, could go where the click
/// puts it, `BlockPlaceContext.canPlace`; and the player's entity ID, whom the sounds they make
/// leave out, and their turn (CAL-140).
pub struct User {
    pub item: String
    pub held: Tag?
    pub item_id: i32
    pub hand: i32
    pub offhand: String
    pub may_build: bool
    pub game_master: bool
    pub can_eat: bool
    pub face: i32
    pub at_y: f64
    pub at_x: f64 = 0.0
    pub at_z: f64 = 0.0
    pub block_item: bool
    pub can_place: bool
    pub player: i32 = -1
    pub y_rot: f32 = 0.0f32
    /// The player's hotbar, its 9 slots, which a powered shelf swaps with (CAL-143).
    pub hotbar: List<Tag?> = List<Tag?>()
    /// Whether they've infinite materials, `hasInfiniteMaterials`, as in creative mode, so what
    /// they use isn't spent (CAL-164).
    pub infinite: bool = false
}

// Whether what's held is in the item tag `tag`, as `minecraft:candles`.
fn tagged(items: ItemCodecs, u: User, tag: str) -> bool {
    if u.item_id < 0 {
        return false
    }
    return items.holder_set_has("item", Tag.Str("#{tag}"), u.item_id)
}

// Whether what's held is the item `name`.
fn holds(u: User, name: str) -> bool {
    return u.item == String(name)
}

// The block's name without its namespace, as `water_cauldron`.
fn short_name(f: Facts, block: u32) -> String {
    let name = f.codec.blocks.name(block)
    if name.starts_with("minecraft:") {
        return name[10..].copy()
    }
    return name
}

/// `BlockState.useItemOn` of the block `state` at `x`, `y`, `z`, used as `u` says, as its class
/// has it, what it does to the player put in `handed` (CAL-142). Redstone ore lights; cauldrons,
/// composters, flower pots, candles, candle cakes, cakes, lecterns, chiseled bookshelves and
/// decorated pots do what vanilla's do; what other uses do is put in `missing`.
pub fn use_item_on<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut L, state: u32, x: i32, y: i32, z: i32, u: User, handed: mut List<Handed>, missing: mut List<String>) -> Used ! Thrown {
    let block = f.block(state)
    let kind = p.use_item_class(block)
    let name = short_name(f, block)
    if kind == "BlockBehaviour" {
        return Used.Empty
    }
    if kind == "RedStoneOreBlock" {
        try interact_ore(f, mut level, state, x, y, z)
        return if u.block_item and u.can_place { Used.Pass } else { Used.Done }
    }
    var done = String()
    var used = Used.Empty
    if kind == "AbstractCauldronBlock" {
        return try use_cauldron(f, items, mut level, name, state, x, y, z, u, mut handed)
    } else if kind == "BeehiveBlock" {
        if (f.get_int(state, "honey_level") ?? 0) >= 5 and (holds(u, "minecraft:shears") or holds(u, "minecraft:glass_bottle")) {
            used = Used.Done
        }
        done = String("Taking honey from hives")
    } else if kind == "CakeBlock" {
        // A candle on an uneaten cake: spent, its sound for everyone, and the cake its candle's,
        // set with flags 3; the candle's `ITEM_USED` (CAL-164).
        if not tagged(items, u, "minecraft:candles") or (f.get_int(state, "bites") ?? 0) != 0 {
            return Used.Empty
        }
        let candle = p.block_of(u.item_id) else return Used.Empty
        if not f.is_a(candle, "CandleBlock") {
            return Used.Empty
        }
        let cake = f.block_named("{f.codec.blocks.name(candle)}_cake") else return Used.Empty
        handed.push(Handed.Spent)
        level.play_sound(x, y, z, "block.cake.add_candle", 1.0f32, 1.0f32)
        _ = level.set_block_limited(x, y, z, f.default_state(cake), 3, UPDATE_LIMIT)
        handed.push(used_stat(u.item))
        return Used.Done
    } else if kind == "CampfireBlock" {
        let foods: List<str> = ["minecraft:beef", "minecraft:chicken", "minecraft:cod", "minecraft:kelp", "minecraft:mutton", "minecraft:porkchop", "minecraft:potato", "minecraft:rabbit", "minecraft:salmon"]
        for food in foods {
            if holds(u, food) {
                used = Used.Done
            }
        }
        if tagged(items, u, "minecraft:douses_campfires") and f.get_bool(state, "lit") {
            used = Used.Done
        }
        done = String("Cooking on and dousing campfires")
    } else if kind == "CandleBlock" {
        if u.held == none and u.may_build and f.get_bool(state, "lit") {
            try extinguish(f, mut level, state, x, y, z)
            return Used.Done
        }
        return Used.Empty
    } else if kind == "CandleCakeBlock" {
        if holds(u, "minecraft:flint_and_steel") or holds(u, "minecraft:fire_charge") {
            return Used.Pass
        }
        // Its candle hit, above the cake's middle.
        if u.at_y - f64(y) > 0.5 and u.held == none and f.get_bool(state, "lit") {
            try extinguish(f, mut level, state, x, y, z)
            return Used.Done
        }
        return Used.Empty
    } else if kind == "ChiseledBookShelfBlock" {
        // `addBook`: the book's `ITEM_USED` (CAL-164), and one of it in the slot hit, if it's
        // empty, spent, its sound for everyone.
        if not tagged(items, u, "minecraft:bookshelf_books") {
            return Used.Empty
        }
        let slot = shelf_slot(u, x, y, z, try facing_of(f, state), 2) else return Used.Pass
        if f.get_bool(state, "slot_{slot}_occupied") {
            return Used.Empty
        }
        let stack = u.held.copy() else return Used.Pass
        let sound = if holds(u, "minecraft:enchanted_book") { "block.chiseled_bookshelf.insert.enchanted" } else { "block.chiseled_bookshelf.insert" }
        handed.push(used_stat(u.item))
        handed.push(Handed.Spent)
        try set_book(f, mut level, state, x, y, z, slot, some(one_of(stack)))
        level.play_sound(x, y, z, String(sound), 1.0f32, 1.0f32)
        return Used.Done
    } else if kind == "ComposterBlock" {
        // A compostable stack, under 7, spent and its layers added, the composter set with flags 3
        // and ticked 20 on where that fills it to 7, its event for everyone saying whether it
        // rose, and the stack's `ITEM_USED` (CAL-164); at 7 the use's taken with nothing done.
        let fill = f.get_int(state, "level") ?? 0
        let stack = u.held.copy() else return Used.Empty
        let compost = items.component(stack, String("minecraft:compostable")) else return Used.Empty
        if fill >= 8 {
            return Used.Empty
        }
        if fill < 7 {
            let layers = try compost_layers(compost, fill, mut level)
            var now = state
            if layers > 0 {
                let filled = (fill + layers).min(7)
                now = try f.with_int(state, "level", filled)
                _ = level.set_block_limited(x, y, z, now, 3, UPDATE_LIMIT)
                if filled == 7 {
                    level.schedule_block(block, x, y, z, 20, 0)
                }
            }
            level.level_event(COMPOSTER_FILL, x, y, z, if now != state { 1 } else { 0 })
            handed.push(used_stat(u.item))
            handed.push(Handed.Spent)
        }
        return Used.Done
    } else if kind == "CopperGolemStatueBlock" or kind == "WeatheringCopperGolemStatueBlock" {
        if tagged(items, u, "minecraft:axes") {
            return Used.Pass
        }
        if kind == "WeatheringCopperGolemStatueBlock" and holds(u, "minecraft:honeycomb") {
            return Used.Pass
        }
        used = Used.Done
        done = String("Posing copper golem statues")
    } else if kind == "DecoratedPotBlock" {
        // One of what's held in the pot, if it's empty or holds the same with room, spent: its
        // wobble, its `ITEM_USED` (CAL-164), its sound, higher the fuller it is, for everyone, the
        // dust it puffs, and `setChanged`, the comparators by it told (CAL-143). A pot with a loot
        // table unpacks it first, which waits for loot.
        let stack = u.held.copy() else return Used.Empty
        let tag = level.block_entity_tag(x, y, z) ?? Tag.Compound(JavaHashMap<String, Tag>())
        let Tag.Compound(pot) = tag else return Used.Pass
        if pot.contains("LootTable") {
            missing.push(String("A decorated pot's loot"))
            return Used.Done
        }
        var inside: Tag? = none
        if pot.contains("item") {
            inside = some(pot["item"].copy())
        }
        var count = 1
        if let had = inside {
            let most = items.max_stack_size(had)
            let have = count_of(had)
            if not same_stack_kind(had, stack) or have >= most {
                return Used.Empty
            }
            count = have + 1
        }
        level.block_event(x, y, z, block, 1, 0)
        handed.push(used_stat(u.item))
        handed.push(Handed.Spent)
        let most = items.max_stack_size(stack)
        level.set_block_entity_value(x, y, z, "item", with_count(inside ?? stack, count))
        let bend = f32.nearest(f64(count)) / f32.nearest(f64(most))
        level.play_sound(x, y, z, "block.decorated_pot.insert", 1.0f32, 0.7f32 + 0.5f32 * bend)
        level.send_particles("dust_plume", f64(x) + 0.5, f64(y) + 1.2, f64(z) + 0.5, 7, 0.0, 0.0, 0.0, 0.0)
        try update_output_signal(f, mut level, block, x, y, z)
        return Used.Done
    } else if kind == "FlowerPotBlock" {
        // A plant that pots goes in an empty pot, set with flags 3, `POT_FLOWER` (CAL-164), and
        // spent; a full pot takes the use.
        let plant = p.block_of(u.item_id) else return Used.Empty
        let pot = potted(f, plant) else return Used.Empty
        if name != "flower_pot" {
            return Used.Done
        }
        _ = level.set_block_limited(x, y, z, f.default_state(pot), 3, UPDATE_LIMIT)
        handed.push(custom_stat("pot_flower"))
        handed.push(Handed.Spent)
        return Used.Done
    } else if kind == "JukeboxBlock" {
        // `JukeboxPlayable.tryInsertIntoJukebox`: one of a stack that plays in jukeboxes, spent,
        // `setTheItem`: kept as its record, the jukebox set with a record with flags 2, and the
        // song it plays, if the world has it, played from its start; then `PLAY_RECORD`
        // (CAL-164). Its game events wait for them.
        if f.get_bool(state, "has_record") {
            return Used.Empty
        }
        if not component_of_item(items, u, "minecraft:jukebox_playable") {
            return Used.Empty
        }
        let stack = u.held.copy() else return Used.Empty
        handed.push(Handed.Spent)
        let record = with_count(stack, 1)
        let song = level.jukebox_song(record.copy())
        level.set_block_entity_value(x, y, z, "RecordItem", record)
        let full = try f.with_bool(state, "has_record", true)
        _ = level.set_block_limited(x, y, z, full, 2, UPDATE_LIMIT)
        if let playing = song {
            try play_song(f, mut level, block, playing, x, y, z)
        }
        handed.push(custom_stat("play_record"))
        return Used.Done
    } else if kind == "LecternBlock" {
        if f.get_bool(state, "has_book") {
            return Used.Empty
        }
        if tagged(items, u, "minecraft:lectern_books") {
            // `placeBook`: one of the book in its block entity at its first page, spent, and
            // `setChanged`, the comparators by it told (CAL-143); the lectern set unpowered with a
            // book, with flags 3, the block under it told; its sound for everyone. A written
            // book's text is resolved first, which waits for it.
            let stack = u.held.copy() else return Used.Pass
            if let content = items.component(stack, String("minecraft:written_book_content")) {
                if not resolved(content) {
                    missing.push(String("Resolving a written book's text on a lectern"))
                }
            }
            handed.push(Handed.Spent)
            level.set_block_entity_value(x, y, z, "Book", one_of(stack))
            level.set_block_entity_value(x, y, z, "Page", Tag.Int(0))
            try update_output_signal(f, mut level, block, x, y, z)
            let now = try f.with_bool(try f.with_bool(state, "powered", false), "has_book", true)
            _ = level.set_block_limited(x, y, z, now, 3, UPDATE_LIMIT)
            level.update_neighbours(x, y - 1, z, block)
            level.play_sound(x, y, z, "item.book.put", 1.0f32, 1.0f32)
            return Used.Done
        }
        return if u.held == none and u.hand == 0 { Used.Pass } else { Used.Empty }
    } else if kind == "NoteBlock" {
        if tagged(items, u, "minecraft:note_block_top_instruments") and u.face == UP {
            return Used.Pass
        }
        return Used.Empty
    } else if kind == "PumpkinBlock" {
        if holds(u, "minecraft:shears") {
            used = Used.Done
        }
        done = String("Carving pumpkins")
    } else if kind == "RespawnAnchorBlock" {
        let charge = f.get_int(state, "charge") ?? 0
        if holds(u, "minecraft:glowstone") and charge < 4 {
            used = Used.Done
        } else if u.hand == 0 and u.offhand == "minecraft:glowstone" and charge < 4 {
            return Used.Pass
        }
        done = String("Charging respawn anchors")
    } else if kind == "ShelfBlock" {
        // `ShelfBlock.useItemOn`, by the main hand, on its front, by the slot hit of the 3 across
        // it (CAL-143). Unpowered, what's held, or nothing, swaps with what's in the slot; the
        // shelf's `setChanged`, with its game event, which waits for game events; and its sound as
        // something's taken, swapped or put, a use of nothing on nothing passing. Powered, its
        // chain's slots swap with the hotbar's, the chain's last with the hotbar's last, each shelf
        // `setChanged`; its sound where anything swapped.
        if u.hand != 0 {
            return Used.Pass
        }
        let facing = try facing_of(f, state)
        let slot = shelf_slot(u, x, y, z, facing, 1) else return Used.Pass
        if not f.get_bool(state, "powered") {
            let removed = try book_in(level, x, y, z, slot)
            try set_shelf_item(mut level, x, y, z, slot, u.held.copy())
            handed.push(Handed.Swapped(removed.copy()))
            try shelf_changed(f, mut level, block, x, y, z)
            if removed != none {
                level.play_sound(x, y, z, if u.held == none { String("block.shelf.take_item") } else { String("block.shelf.single_swap") }, 1.0f32, 1.0f32)
            } else {
                if u.held == none {
                    return Used.Pass
                }
                level.play_sound(x, y, z, "block.shelf.place_item", 1.0f32, 1.0f32)
            }
            handed.push(Handed.Swing)
            return Used.Done
        }
        let chain = try chain_of(f, level, x, y, z)
        let n = i32.wrap(chain.len())
        var swapped = false
        for i in 0..chain.len() {
            let at = chain[i]
            let part = try level.state(f, at.x, at.y, at.z)
            if level.block_entity_tag(at.x, at.y, at.z) == none and f.block_entity_kind(f.block(part)) == none {
                continue
            }
            for s in 0..3 {
                let hotbar = 9 - (n - i32.wrap(i)) * 3 + s
                if hotbar < 0 or hotbar > 36 {
                    continue
                }
                let placed = if hotbar < 9 and usize.wrap(hotbar) < u.hotbar.len() { u.hotbar[usize.wrap(hotbar)].copy() } else { none }
                let taken = try book_in(level, at.x, at.y, at.z, s)
                try set_shelf_item(mut level, at.x, at.y, at.z, s, placed.copy())
                if placed != none or taken != none {
                    handed.push(Handed.Slot(hotbar, taken.copy()))
                    swapped = true
                }
            }
            try shelf_changed(f, mut level, f.block(part), at.x, at.y, at.z)
        }
        if swapped {
            level.play_sound(x, y, z, "block.shelf.multi_swap", 1.0f32, 1.0f32)
            handed.push(Handed.Swing)
        }
        return Used.Done
    } else if kind == "SignBlock" or kind == "CeilingHangingSignBlock" or kind == "WallHangingSignBlock" {
        if kind != "SignBlock" and p.kind_of(u.item_id) == "HangingSignItem" {
            let under = kind == "CeilingHangingSignBlock" and u.face == DOWN
            let beside = kind == "WallHangingSignBlock" and u.face == DOWN
            if under or beside {
                return Used.Pass
            }
        }
        let applies = holds(u, "minecraft:glow_ink_sac") or holds(u, "minecraft:ink_sac") or holds(u, "minecraft:honeycomb") or u.item.ends_with("_dye")
        if applies and u.may_build {
            used = Used.Done
        }
        done = String("Dyeing, glowing and waxing signs")
    } else if kind == "SweetBerryBushBlock" {
        if (f.get_int(state, "age") ?? 0) < 3 and holds(u, "minecraft:bone_meal") {
            return Used.Pass
        }
        return Used.Empty
    } else if kind == "TntBlock" {
        if holds(u, "minecraft:flint_and_steel") or holds(u, "minecraft:fire_charge") {
            used = Used.Done
        }
        done = String("Lighting TNT")
    } else if kind == "VaultBlock" {
        if u.held != none and f.get_name(state, "vault_state") == some(String("active")) {
            used = Used.Done
        }
        done = String("Opening vaults")
    } else {
        missing.push("Using {name}, a {kind}, with an item")
        return Used.Done
    }
    match used {
        Used.Done => {
            if not done.is_empty() {
                missing.push(done)
            }
        },
        _ => {},
    }
    return used
}

/// `BlockState.useWithoutItem` of the block `state` at `x`, `y`, `z`, used as `u` says, as its
/// class has it: a door, trapdoor or fence gate swung, a lever pulled, a button pressed, a
/// repeater's delay, a comparator's mode or a daylight detector turned, redstone dust turned
/// between a dot and a cross, a note block tuned, a bell rung, a light block's level turned, and a
/// moving piston with no block entity to finish it taken away (CAL-140); a cake eaten, a full
/// composter emptied and a plant taken from its pot, what that does to the player put in `handed`
/// (CAL-142). What other uses do is put in `missing`.
pub fn use_without_item<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, p: PlaceFacts, level: mut L, state: u32, x: i32, y: i32, z: i32, u: User, handed: mut List<Handed>, missing: mut List<String>) -> Used ! Thrown {
    let block = f.block(state)
    let kind = p.use_class(block)
    let name = short_name(f, block)
    if kind == "BlockBehaviour" or kind == "FenceBlock" {
        // A fence ties the player's leashed mobs to it, and Calcite has no mobs.
        return Used.Pass
    }
    let containers: List<str> = ["BarrelBlock", "BeaconBlock", "ChestBlock", "CraftingTableBlock", "DispenserBlock", "EnderChestBlock", "HopperBlock", "ShulkerBoxBlock"]
    for c in containers {
        if kind == String(c) {
            // `useWithoutItem`: the menu opened where there's one, and `SUCCESS` either way
            // (CAL-144); a crafting table's always is (CAL-147); a beacon's where it has its block
            // entity (D521). Opening it counts its statistic, `open_stat` (CAL-164).
            if let o = try opening(f, mut level, kind.copy(), state, x, y, z, false, mut missing) {
                handed.push(Handed.Open(o))
                handed.push(custom_stat(open_stat(kind.copy(), name.copy())))
            }
            return Used.Done
        }
    }
    let menus: List<str> = ["AbstractFurnaceBlock", "AnvilBlock", "BrewingStandBlock", "CartographyTableBlock", "CrafterBlock", "EnchantingTableBlock", "GrindstoneBlock", "LoomBlock", "SmithingTableBlock", "StonecutterBlock"]
    for m in menus {
        if kind == String(m) {
            missing.push("Opening {name}'s menu")
            return Used.Done
        }
    }
    if kind == "MovingPistonBlock" {
        if level.moving_piston(x, y, z) == none {
            _ = level.set_block_limited(x, y, z, f.ids.air_state, 3, UPDATE_LIMIT)
            return Used.Done
        }
        return Used.Pass
    }
    var done = String()
    if kind == "AbstractBedBlock" {
        // `AbstractBedBlock.useWithoutItem` (D574): where the bed's other half is there, its
        // head is what the player uses, which `server.network` does for them, and the server
        // swings their arm, `SUCCESS_SERVER`; else nothing, `CONSUME`.
        let part = f.get_name(state, "part") ?? String()
        let facing = try facing_of(f, state)
        let toward = if part == "foot" { facing } else { opposite(facing) }
        let other = try level.state(f, x + step_x(toward), y, z + step_z(toward))
        if f.block(other) == block and (f.get_name(other, "part") ?? String()) != part {
            let (hx, hz) = if part != "head" { (x + step_x(facing), z + step_z(facing)) } else { (x, z) }
            handed.push(Handed.Bed(hx, y, hz))
            handed.push(Handed.Swing)
        }
        return Used.Done
    } else if kind == "BellBlock" {
        if not proper_bell_hit(f, state, y, u.face, u.at_y) {
            return Used.Pass
        }
        // `attemptToRing` toward the face hit: its block entity's block event, then its sound for
        // everyone; and `BELL_RING` (CAL-164).
        level.block_event(x, y, z, block, 1, u.face)
        level.play_sound(x, y, z, "block.bell.use", 2.0f32, 1.0f32)
        handed.push(custom_stat("bell_ring"))
        return Used.Done
    } else if kind == "ButtonBlock" {
        if f.get_bool(state, "powered") {
            return Used.Done
        }
        // `press`: set pressed with flags 3, the blocks around it and its own told, its tick to
        // let go waiting, its click for all but the player.
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", true), 3, UPDATE_LIMIT)
        try attached_neighbours(f, mut level, state, x, y, z)
        level.schedule_block(block, x, y, z, f.button_ticks(block), 0)
        if let sound = f.toggle_sound(block, true) {
            level.play_sound_from(u.player, x, y, z, sound, 1.0f32, 1.0f32)
        }
        return Used.Done
    } else if kind == "CakeBlock" or kind == "CandleCakeBlock" {
        // `CakeBlock.eat`: `EAT_CAKE_SLICE` (CAL-164), a slice, 2 food with a modifier of 0.1,
        // then the cake a bite further,
        // set with flags 3, or gone after its last. A candle cake is eaten as a whole cake, and
        // its candle dropped, `dropResources`: its loot, one candle, which draws nothing, popped
        // where the level's random puts it, `popResource`, which comes with item entities
        // (CAL-143).
        if not u.can_eat {
            return Used.Pass
        }
        handed.push(custom_stat("eat_cake_slice"))
        handed.push(Handed.Ate(2, 0.1f32))
        var cake = state
        if kind == "CandleCakeBlock" {
            let whole = f.block_named(String("minecraft:cake")) else return Used.Done
            cake = f.default_state(whole)
        }
        let bites = f.get_int(cake, "bites") ?? 0
        if bites < 6 {
            _ = level.set_block_limited(x, y, z, try f.with_int(cake, "bites", bites + 1), 3, UPDATE_LIMIT)
        } else {
            _ = try remove_block(f, mut level, x, y, z)
        }
        if kind == "CandleCakeBlock" {
            _ = level.next_double()
            _ = level.next_double()
            _ = level.next_double()
            missing.push(String("The candle a candle cake drops as it's eaten"))
        }
        return Used.Done
    } else if kind == "CaveVinesBlock" or kind == "CaveVinesPlantBlock" {
        if not f.get_bool(state, "berries") {
            return Used.Pass
        }
        done = String("Picking glow berries")
    } else if kind == "ChiseledBookShelfBlock" {
        // `removeBook`: the book in the slot hit taken, its sound for everyone, and given the
        // player; an empty slot takes the use.
        let slot = shelf_slot(u, x, y, z, try facing_of(f, state), 2) else return Used.Pass
        if not f.get_bool(state, "slot_{slot}_occupied") {
            return Used.Done
        }
        let book = try book_in(level, x, y, z, slot)
        try set_book(f, mut level, state, x, y, z, slot, none)
        if let b = book {
            let enchanted = match b {
                Tag.Compound(m) => match m["id"] {
                    Tag.Str(id) => id == "minecraft:enchanted_book",
                    _ => false,
                },
                _ => false,
            }
            level.play_sound(x, y, z, if enchanted { "block.chiseled_bookshelf.pickup.enchanted" } else { "block.chiseled_bookshelf.pickup" }, 1.0f32, 1.0f32)
            handed.push(Handed.Added(b.copy()))
        } else {
            level.play_sound(x, y, z, "block.chiseled_bookshelf.pickup", 1.0f32, 1.0f32)
        }
        return Used.Done
    } else if kind == "CommandBlock" or kind == "JigsawBlock" or kind == "StructureBlock" or kind == "TestBlock" or kind == "TestInstanceBlock" {
        if not u.game_master {
            return Used.Pass
        }
        done = "Editing {name}"
    } else if kind == "ComparatorBlock" or kind == "RepeaterBlock" or kind == "DaylightDetectorBlock" {
        if not u.may_build {
            return Used.Pass
        }
        try switch(f, mut level, kind, state, x, y, z, u)
        return Used.Done
    } else if kind == "ComposterBlock" {
        // `extractProduce`: bone meal thrown up from it, 1.01 above its floor's corner and half a
        // block in, up to 0.35 either way across, drawn from the level's random,
        // `offsetRandomXZ`, its default pickup delay (CAL-160); then it's emptied with flags 3,
        // its sound for everyone.
        if (f.get_int(state, "level") ?? 0) != 8 {
            return Used.Pass
        }
        let dx = f64((level.next_float() - 0.5f32) * 0.7f32)
        let dz = f64((level.next_float() - 0.5f32) * 0.7f32)
        level.add_dropped(f64(x) + 0.5 + dx, f64(y) + 1.01, f64(z) + 0.5 + dz, item_stack(String("minecraft:bone_meal")))
        _ = level.set_block_limited(x, y, z, try f.with_int(state, "level", 0), 3, UPDATE_LIMIT)
        level.play_sound(x, y, z, "block.composter.empty", 1.0f32, 1.0f32)
        return Used.Done
    } else if kind == "DecoratedPotBlock" {
        // Its sound that nothing went in, for everyone, and its other wobble.
        level.play_sound(x, y, z, "block.decorated_pot.insert_fail", 1.0f32, 1.0f32)
        level.block_event(x, y, z, block, 1, 1)
        return Used.Done
    } else if kind == "DoorBlock" or kind == "TrapDoorBlock" {
        // Iron's `BlockSetType` can't be opened by hand.
        if name.starts_with("iron_") {
            return Used.Pass
        }
        let open = not f.get_bool(state, "open")
        let swung = try f.with_bool(state, "open", open)
        if kind == "DoorBlock" {
            // Set with flags 10, the other half following as its shape updates.
            _ = level.set_block_limited(x, y, z, swung, 10, UPDATE_LIMIT)
        } else {
            // `toggle`: set with flags 2, its water ticked where it's waterlogged.
            _ = level.set_block_limited(x, y, z, swung, 2, UPDATE_LIMIT)
            if f.get_bool(swung, "waterlogged") {
                level.schedule_fluid(WATER_FLUID, x, y, z)
            }
        }
        swing_sound(f, mut level, block, x, y, z, open, u)
        return Used.Done
    } else if kind == "DragonEggBlock" {
        done = String("Dragon eggs teleporting")
    } else if kind == "FenceGateBlock" {
        // Shut if it's open; else opened away from the player, turned to face the way they do
        // where it faced them; set with flags 10.
        var swung = try f.with_bool(state, "open", not f.get_bool(state, "open"))
        if not f.get_bool(state, "open") {
            let looking = from_y_rot(f64(u.y_rot))
            if try facing_of(f, state) == opposite(looking) {
                swung = try f.with_name(swung, "facing", direction_name(looking))
            }
        }
        _ = level.set_block_limited(x, y, z, swung, 10, UPDATE_LIMIT)
        swing_sound(f, mut level, block, x, y, z, f.get_bool(swung, "open"), u)
        return Used.Done
    } else if kind == "FlowerPotBlock" {
        // A full pot's plant given the player, and the pot emptied, set with flags 3.
        if name == "flower_pot" {
            return Used.Done
        }
        let empty = f.block_named(String("minecraft:flower_pot")) else return Used.Done
        handed.push(Handed.Added(item_stack(pot_plant(name))))
        _ = level.set_block_limited(x, y, z, f.default_state(empty), 3, UPDATE_LIMIT)
        return Used.Done
    } else if kind == "JukeboxBlock" {
        // `popOutTheItem`: its record taken out, `setTheItem` of nothing: the jukebox set without
        // a record with flags 2 and its song stopped if it plays one; then the record's drawn where
        // it lands, from the level's random, as an item, which waits for item entities, and the
        // blocks around told again, `onSongChanged`.
        if not f.get_bool(state, "has_record") {
            return Used.Pass
        }
        let tags = level.block_entity_tag(x, y, z) ?? Tag.Compound(JavaHashMap<String, Tag>())
        let Tag.Compound(box) = tags else return Used.Done
        if not box.contains("RecordItem") {
            return Used.Done
        }
        let playing = playing_song(level, box) != none
        level.remove_block_entity_value(x, y, z, "RecordItem")
        let empty = try f.with_bool(state, "has_record", false)
        _ = level.set_block_limited(x, y, z, empty, 2, UPDATE_LIMIT)
        if playing {
            try stop_song(f, mut level, empty, x, y, z)
        }
        _ = level.next_float()
        _ = level.next_float()
        missing.push(String("The record a jukebox gives back"))
        try song_changed(f, mut level, f.block(state), x, y, z)
        return Used.Done
    } else if kind == "LecternBlock" {
        if not f.get_bool(state, "has_book") {
            return Used.Done
        }
        done = String("Reading books on lecterns")
    } else if kind == "LeverBlock" {
        // `pull`: switched with flags 3, the blocks around it and its own told, its click heard by
        // everyone, the player too.
        let pulled = try f.with_bool(state, "powered", not f.get_bool(state, "powered"))
        _ = level.set_block_limited(x, y, z, pulled, 3, UPDATE_LIMIT)
        try attached_neighbours(f, mut level, pulled, x, y, z)
        level.play_sound(x, y, z, "block.lever.click", 0.3f32, if f.get_bool(pulled, "powered") { 0.6f32 } else { 0.5f32 })
        return Used.Done
    } else if kind == "LightBlock" {
        if not u.game_master {
            return Used.Done
        }
        // Its level turned one up, from 15 round to 0, with flags 2, the arm swung by the server
        // (CAL-143).
        let lit = ((f.get_int(state, "level") ?? 15) + 1) % 16
        _ = level.set_block_limited(x, y, z, try f.with_int(state, "level", lit), 2, UPDATE_LIMIT)
        handed.push(Handed.Swing)
        return Used.Done
    } else if kind == "NoteBlock" {
        // Tuned a semitone up, from 24 round to 0, set with flags 3, then played; and
        // `TUNE_NOTEBLOCK` (CAL-164).
        let tuned = try f.with_int(state, "note", ((f.get_int(state, "note") ?? 0) + 1) % 25)
        _ = level.set_block_limited(x, y, z, tuned, 3, UPDATE_LIMIT)
        try play_note(f, mut level, tuned, x, y, z)
        handed.push(custom_stat("tune_noteblock"))
        return Used.Done
    } else if kind == "RedstoneWireBlock" {
        if not u.may_build or not wire_alone(f, state) {
            return Used.Pass
        }
        return try turn_wire(f, mut level, state, x, y, z)
    } else if kind == "RespawnAnchorBlock" {
        if (f.get_int(state, "charge") ?? 0) == 0 {
            return Used.Pass
        }
        done = String("Setting the spawn at respawn anchors")
    } else if kind == "SignBlock" {
        if not u.may_build {
            return Used.Pass
        }
        done = String("Editing signs")
    } else if kind == "SweetBerryBushBlock" {
        if (f.get_int(state, "age") ?? 0) <= 1 {
            return Used.Pass
        }
        done = String("Picking sweet berries")
    } else {
        missing.push("Using {name}, a {kind}")
        return Used.Done
    }
    if not done.is_empty() {
        missing.push(done)
    }
    return Used.Done
}

// One more of the player's custom statistic `minecraft:{name}`, `Stats.CUSTOM` (CAL-164).
fn custom_stat(name: str) -> Handed {
    return Handed.Stat(String("minecraft:custom"), "minecraft:{name}")
}

// One more of the player's `ITEM_USED` of the item `item` (CAL-164).
fn used_stat(item: String) -> Handed {
    return Handed.Stat(String("minecraft:used"), item.copy())
}

// The custom statistic opening a container of the class `kind`, the block `name`, counts
// (CAL-164): a chest's `OPEN_CHEST`, a trapped chest's `TRIGGER_TRAPPED_CHEST`, a barrel's
// `OPEN_BARREL`, a beacon's `INTERACT_WITH_BEACON`, a crafting table's
// `INTERACT_WITH_CRAFTING_TABLE`, a dispenser's `INSPECT_DISPENSER`, a dropper's
// `INSPECT_DROPPER`, an ender chest's `OPEN_ENDERCHEST`, a hopper's `INSPECT_HOPPER` and a
// shulker box's `OPEN_SHULKER_BOX`.
fn open_stat(kind: String, name: String) -> str {
    if kind == "ChestBlock" {
        return if name == "trapped_chest" { "trigger_trapped_chest" } else { "open_chest" }
    }
    if kind == "DispenserBlock" {
        return if name == "dropper" { "inspect_dropper" } else { "inspect_dispenser" }
    }
    if kind == "BarrelBlock" {
        return "open_barrel"
    }
    if kind == "BeaconBlock" {
        return "interact_with_beacon"
    }
    if kind == "CraftingTableBlock" {
        return "interact_with_crafting_table"
    }
    if kind == "EnderChestBlock" {
        return "open_enderchest"
    }
    if kind == "HopperBlock" {
        return "inspect_hopper"
    }
    return "open_shulker_box"
}

// The slot of a chiseled bookshelf facing `facing` a hit on that face is in, as
// `SelectableSlotContainer.getHitSlot` finds it in its 2 rows of 3, from where it was hit across
// the face, as floats; none on another face.
fn shelf_slot(u: User, x: i32, y: i32, z: i32, facing: i32, rows: i32) -> i32? {
    if u.face != facing {
        return none
    }
    let rx = u.at_x - f64(x + step_x(facing))
    let ry = u.at_y - f64(y + step_y(facing))
    let rz = u.at_z - f64(z + step_z(facing))
    var across = 0.0f32
    if facing == NORTH {
        across = f32.nearest(1.0 - rx)
    } else if facing == SOUTH {
        across = f32.nearest(rx)
    } else if facing == WEST {
        across = f32.nearest(rz)
    } else if facing == EAST {
        across = f32.nearest(1.0 - rz)
    } else {
        return none
    }
    let row = section(1.0f32 - f32.nearest(ry), rows)
    let column = section(across, 3)
    return some(column + row * 3)
}

// `getSection`: which of `most` sections along a face, by its pixels, `along` is in.
fn section(along: f32, most: i32) -> i32 {
    let pixel = along * 16.0f32
    let size = 16.0f32 / f32.nearest(f64(most))
    return i32.saturate(f64(pixel / size).floor()).max(0).min(most - 1)
}

// The book in a chiseled bookshelf's slot `slot`, from its block entity's `Items`.
fn book_in<L: BlockAccess>(level: L, x: i32, y: i32, z: i32, slot: i32) -> Tag? ! Thrown {
    let tag = level.block_entity_tag(x, y, z) else return none
    let Tag.Compound(m) = tag else return none
    if not m.contains("Items") {
        return none
    }
    let books = m["Items"].copy()
    let Tag.List(l) = books else return none
    for t in l {
        if slot_of(t) == slot {
            let Tag.Compound(b) = t else continue
            var out = b.copy()
            _ = out.remove("Slot")
            return some(Tag.Compound(out))
        }
    }
    return none
}

// A shelf's slot `slot` given `stack`, or emptied, `swapItemNoUpdate`: its block entity's
// `Items`, by slot, `ContainerHelper.saveAllItems` (CAL-143).
fn set_shelf_item<L: BlockAccess + BlockLevel>(level: mut L, x: i32, y: i32, z: i32, slot: i32, stack: Tag?) ! Thrown {
    var items = List<Tag>()
    for i in 0..3 {
        let kept = if i == slot { stack.copy() } else { try book_in(level, x, y, z, i) }
        if let k = kept {
            if let Tag.Compound(m) = k {
                var entry = m.copy()
                entry.insert(String("Slot"), Tag.Byte(i8.wrap(i)))
                items.push(Tag.Compound(entry))
            }
        }
    }
    level.set_block_entity_value(x, y, z, "Items", Tag.List(items))
}

// `ShelfBlockEntity.setChanged`: the shelf `block` at x, y, z sent again with its items, and the
// comparators by it told, `BlockEntity.setChanged` (CAL-143).
fn shelf_changed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, block: u32, x: i32, y: i32, z: i32) ! Thrown {
    try update_output_signal(f, mut level, block, x, y, z)
    level.send_block_updated(x, y, z)
}

// A chiseled bookshelf's slot `slot` given `book`, or emptied: its block entity's `Items`, by
// slot, `ContainerHelper.saveAllItems`, and `last_interacted_slot`; then `updateState`, each
// slot's `occupied` as its items have it, set with flags 3.
fn set_book<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, slot: i32, book: Tag?) ! Thrown {
    var kept = List<Tag>()
    if let tag = level.block_entity_tag(x, y, z) {
        if let Tag.Compound(m) = tag {
            if m.contains("Items") {
                if let Tag.List(l) = m["Items"] {
                    for t in l {
                        if slot_of(t) != slot {
                            kept.push(t.copy())
                        }
                    }
                }
            }
        }
    }
    var books = List<Tag>()
    var now = state
    for i in 0..6 {
        var occupied = false
        if i == slot {
            if let b = book {
                if let Tag.Compound(m) = b {
                    var entry = JavaHashMap<String, Tag>()
                    entry.insert(String("Slot"), Tag.Byte(i8.wrap(slot)))
                    for (k, v) in m {
                        entry.insert(k.copy(), v.copy())
                    }
                    books.push(Tag.Compound(entry))
                    occupied = true
                }
            }
        } else {
            for t in kept {
                if slot_of(t) == i {
                    books.push(t.copy())
                    occupied = true
                }
            }
        }
        now = try f.with_bool(now, "slot_{i}_occupied", occupied)
    }
    level.set_block_entity_value(x, y, z, "Items", Tag.List(books))
    level.set_block_entity_value(x, y, z, "last_interacted_slot", Tag.Int(slot))
    _ = level.set_block_limited(x, y, z, now, 3, UPDATE_LIMIT)
}

// The `Slot` of a saved stack, -1 for none.
fn slot_of(t: Tag) -> i32 {
    let Tag.Compound(m) = t else return -1
    if not m.contains("Slot") {
        return -1
    }
    return m["Slot"].number_int() ?? -1
}

// Whether a written book's content is resolved, `WrittenBookContent.resolved`.
fn resolved(content: Tag) -> bool {
    let Tag.Compound(m) = content else return false
    if not m.contains("resolved") {
        return false
    }
    return (m["resolved"].number_int() ?? 0) != 0
}

// One of the stack, `consumeAndReturn(1)`'s copy.
fn one_of(stack: Tag) -> Tag {
    return with_count(stack, 1)
}

// The stack with `count` of it.
fn with_count(stack: Tag, count: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(count))
    return Tag.Compound(out)
}

// How many the stack holds.
fn count_of(stack: Tag) -> i32 {
    let Tag.Compound(m) = stack else return 0
    if not m.contains("count") {
        return 1
    }
    return m["count"].number_int() ?? 1
}

// Whether two stacks are of the same item with the same components, `isSameItemSameComponents`.
fn same_stack_kind(a: Tag, b: Tag) -> bool {
    let Tag.Compound(x) = a else return false
    let Tag.Compound(y) = b else return false
    let ix = if x.contains("id") { x["id"].copy() } else { Tag.End }
    let iy = if y.contains("id") { y["id"].copy() } else { Tag.End }
    if ix.to_snbt() != iy.to_snbt() {
        return false
    }
    return Tag.Compound(patch_of(x)).to_snbt() == Tag.Compound(patch_of(y)).to_snbt()
}

/// `ComposterBlock`'s level event as it's filled, its data 1 where it rose.
pub const COMPOSTER_FILL: i32 = 1500

// `AbstractCauldronBlock.useItemOn` (CAL-142): what `CauldronInteractions` does with what's held,
// its tags' first, then its item's, each sound for everyone and each block set with flags 3. Any
// cauldron is filled by a water, lava or powder snow bucket, the bucket given back, but under
// water, where lava and powder snow take the use and do nothing. An empty one takes a water
// bottle; a water cauldron washes dye off what can lose it, gives a bucket of water from 3 levels
// and a water bottle from one, takes a water bottle up to 3, and washes a banner's last pattern
// off and a dyed shulker box clean, each wash a level; lava gives a bucket of lava, and powder
// snow a bucket of it from 3. Each counts its statistics (CAL-164): a bucket emptied
// `FILL_CAULDRON`, one filled, a bottle filled or a water bottle emptied `USE_CAULDRON`, each with
// what's held's `ITEM_USED`; and each wash `CLEAN_ARMOR`, `CLEAN_BANNER` or `CLEAN_SHULKER_BOX`.
fn use_cauldron<L: BlockAccess + BlockLevel>(f: Facts, items: ItemCodecs, level: mut L, name: String, state: u32, x: i32, y: i32, z: i32, u: User, handed: mut List<Handed>) -> Used ! Thrown {
    let fill = f.get_int(state, "level") ?? 0
    let stack = u.held.copy() else return Used.Empty
    if name == "water_cauldron" and tagged(items, u, "minecraft:cauldron_can_remove_dye") {
        // `dyedItemIteration`.
        if items.component(stack, String("minecraft:dyed_color")) == none {
            return Used.Empty
        }
        handed.push(Handed.Changed(without_component(stack, "minecraft:dyed_color")))
        handed.push(custom_stat("clean_armor"))
        try lower_fill(f, mut level, state, x, y, z)
        return Used.Done
    }
    if holds(u, "minecraft:water_bucket") {
        return try empty_bucket(f, mut level, u.item, x, y, z, "minecraft:water_cauldron", 3, "item.bucket.empty", mut handed)
    }
    if holds(u, "minecraft:lava_bucket") or holds(u, "minecraft:powder_snow_bucket") {
        if f.is_water(try level.state(f, x, y + 1, z)) {
            return Used.Done
        }
        if holds(u, "minecraft:lava_bucket") {
            return try empty_bucket(f, mut level, u.item, x, y, z, "minecraft:lava_cauldron", 0, "item.bucket.empty_lava", mut handed)
        }
        return try empty_bucket(f, mut level, u.item, x, y, z, "minecraft:powder_snow_cauldron", 3, "item.bucket.empty_powder_snow", mut handed)
    }
    if name == "cauldron" {
        if not holds(u, "minecraft:potion") or not water_potion(u.held) {
            return Used.Empty
        }
        handed.push(Handed.Filled(item_stack(String("minecraft:glass_bottle")), true))
        handed.push(custom_stat("use_cauldron"))
        handed.push(used_stat(u.item))
        let water = f.block_named(String("minecraft:water_cauldron")) else return Used.Done
        _ = level.set_block_limited(x, y, z, f.default_state(water), 3, UPDATE_LIMIT)
        level.play_sound(x, y, z, "item.bottle.empty", 1.0f32, 1.0f32)
        return Used.Done
    }
    if name == "water_cauldron" {
        if holds(u, "minecraft:bucket") {
            if fill != 3 {
                return Used.Empty
            }
            return try fill_bucket(f, mut level, u.item, x, y, z, "minecraft:water_bucket", "item.bucket.fill", mut handed)
        }
        if holds(u, "minecraft:glass_bottle") {
            handed.push(Handed.Filled(water_bottle(), true))
            handed.push(custom_stat("use_cauldron"))
            handed.push(used_stat(u.item))
            try lower_fill(f, mut level, state, x, y, z)
            level.play_sound(x, y, z, "item.bottle.fill", 1.0f32, 1.0f32)
            return Used.Done
        }
        if holds(u, "minecraft:potion") {
            if fill == 3 or not water_potion(u.held) {
                return Used.Empty
            }
            handed.push(Handed.Filled(item_stack(String("minecraft:glass_bottle")), true))
            handed.push(custom_stat("use_cauldron"))
            // Vanilla reads the item for `ITEM_USED` from their hand once it's emptied, which is
            // air where the potion was their last and they've no infinite materials.
            let last = count_of(stack) <= 1 and not u.infinite
            handed.push(used_stat(if last { String("minecraft:air") } else { u.item.copy() }))
            _ = level.set_block_limited(x, y, z, try f.with_int(state, "level", fill + 1), 3, UPDATE_LIMIT)
            level.play_sound(x, y, z, "item.bottle.empty", 1.0f32, 1.0f32)
            return Used.Done
        }
        if u.item.ends_with("_banner") {
            // `bannerInteraction`: one banner, its last pattern washed off.
            let cleaned = without_last_pattern(stack) else return Used.Empty
            handed.push(Handed.Filled(cleaned, false))
            handed.push(custom_stat("clean_banner"))
            try lower_fill(f, mut level, state, x, y, z)
            return Used.Done
        }
        if u.item.ends_with("_shulker_box") {
            // `shulkerBoxInteraction`: one plain shulker box, `transmuteCopy`.
            handed.push(Handed.Filled(transmuted(stack, "minecraft:shulker_box"), false))
            handed.push(custom_stat("clean_shulker_box"))
            try lower_fill(f, mut level, state, x, y, z)
            return Used.Done
        }
        return Used.Empty
    }
    if holds(u, "minecraft:bucket") {
        if name == "lava_cauldron" {
            return try fill_bucket(f, mut level, u.item, x, y, z, "minecraft:lava_bucket", "item.bucket.fill_lava", mut handed)
        }
        if name == "powder_snow_cauldron" and fill == 3 {
            return try fill_bucket(f, mut level, u.item, x, y, z, "minecraft:powder_snow_bucket", "item.bucket.fill_powder_snow", mut handed)
        }
    }
    return Used.Empty
}

// `CauldronInteractions.fillBucket`: the bucket, `item`, made the one `filled`, the cauldron
// emptied.
fn fill_bucket<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, item: String, x: i32, y: i32, z: i32, filled: str, sound: str, handed: mut List<Handed>) -> Used ! Thrown {
    handed.push(Handed.Filled(item_stack(String(filled)), true))
    handed.push(custom_stat("use_cauldron"))
    handed.push(used_stat(item))
    let empty = f.block_named(String("minecraft:cauldron")) else return Used.Done
    _ = level.set_block_limited(x, y, z, f.default_state(empty), 3, UPDATE_LIMIT)
    level.play_sound(x, y, z, String(sound), 1.0f32, 1.0f32)
    return Used.Done
}

// `CauldronInteractions.emptyBucket`: the bucket, `item`, given back empty, the cauldron the one
// `cauldron`, at the level `fill` where it has levels.
fn empty_bucket<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, item: String, x: i32, y: i32, z: i32, cauldron: str, fill: i32, sound: str, handed: mut List<Handed>) -> Used ! Thrown {
    handed.push(Handed.Filled(item_stack(String("minecraft:bucket")), true))
    handed.push(custom_stat("fill_cauldron"))
    handed.push(used_stat(item))
    let b = f.block_named(String(cauldron)) else return Used.Done
    var now = f.default_state(b)
    if fill > 0 {
        now = try f.with_int(now, "level", fill)
    }
    _ = level.set_block_limited(x, y, z, now, 3, UPDATE_LIMIT)
    level.play_sound(x, y, z, String(sound), 1.0f32, 1.0f32)
    return Used.Done
}

// `LayeredCauldronBlock.lowerFillLevel`: a level lower, an empty cauldron after the last.
fn lower_fill<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let fill = (f.get_int(state, "level") ?? 1) - 1
    var now = state
    if fill == 0 {
        let empty = f.block_named(String("minecraft:cauldron")) else return
        now = f.default_state(empty)
    } else {
        now = try f.with_int(state, "level", fill)
    }
    _ = level.set_block_limited(x, y, z, now, 3, UPDATE_LIMIT)
}

// `AbstractCandleBlock.extinguish`: put out with flags 11, its smoke the client's own, its sound
// for everyone.
fn extinguish<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    _ = level.set_block_limited(x, y, z, try f.with_bool(state, "lit", false), 11, UPDATE_LIMIT)
    level.play_sound(x, y, z, "block.candle.extinguish", 1.0f32, 1.0f32)
}

/// The layers a compostable component's `layers` add to a composter at `fill`, as vanilla's
/// `compostable/*` providers roll them: one always, or one for an empty composter and otherwise
/// one in so many hundred, from the level's random. Another provider throws.
pub fn compost_layers<L: RandomSource>(compost: Tag, fill: i32, level: mut L) -> i32 ! Thrown {
    let Tag.Compound(m) = compost else fail Thrown { exception: "Unimplemented", message: "Composting by an inline provider" }
    if not m.contains("layers") {
        fail Thrown { exception: "Unimplemented", message: "Composting by an inline provider" }
    }
    let layers = m["layers"].copy()
    let Tag.Str(key) = layers else fail Thrown { exception: "Unimplemented", message: "Composting by an inline provider" }
    if key == "minecraft:compostable/always_add_one" {
        return 1
    }
    var chance = -1
    if key == "minecraft:compostable/low" {
        chance = 30
    } else if key == "minecraft:compostable/low_medium" {
        chance = 50
    } else if key == "minecraft:compostable/medium" {
        chance = 65
    } else if key == "minecraft:compostable/medium_high" {
        chance = 85
    }
    if chance < 0 {
        fail Thrown { exception: "Unimplemented", message: "Composting by {key}" }
    }
    if fill == 0 {
        return 1
    }
    return if level.next_int_below(100) < chance { 1 } else { 0 }
}

// The pot `plant` goes in, `FlowerPotBlock.POTTED_BY_CONTENT`: its `potted_` block, an azalea's
// a bush's.
fn potted(f: Facts, plant: u32) -> u32? {
    let name = short_name(f, plant)
    let pot = if name == "azalea" or name == "flowering_azalea" { "minecraft:potted_{name}_bush" } else { "minecraft:potted_{name}" }
    let b = f.block_named(pot) else return none
    return if f.is_a(b, "FlowerPotBlock") { some(b) } else { none }
}

// The item of the plant in the pot `pot`, by its block's name.
fn pot_plant(pot: String) -> String {
    var plant = if pot.starts_with("potted_") { pot[7..].copy() } else { pot.copy() }
    if plant == "azalea_bush" or plant == "flowering_azalea_bush" {
        plant = plant[..plant.len() - 5].copy()
    }
    return "minecraft:{plant}"
}

// One of the item `item`, with nothing else.
fn item_stack(item: String) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(item.copy()))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

// A water bottle, `PotionContents.createItemStack(POTION, WATER)`.
fn water_bottle() -> Tag {
    var contents = JavaHashMap<String, Tag>()
    contents.insert(String("potion"), Tag.Str(String("minecraft:water")))
    var patch = JavaHashMap<String, Tag>()
    patch.insert(String("minecraft:potion_contents"), Tag.Compound(contents))
    let Tag.Compound(m) = item_stack(String("minecraft:potion")) else return Tag.End
    var out = m.copy()
    out.insert(String("components"), Tag.Compound(patch))
    return Tag.Compound(out)
}

// The stack's components, `components`, empty where it has none.
fn patch_of(m: JavaHashMap<String, Tag>) -> JavaHashMap<String, Tag> {
    if not m.contains("components") {
        return JavaHashMap<String, Tag>()
    }
    return match m["components"] {
        Tag.Compound(c) => c.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

// `m` with the components `patch`, none where it's empty.
fn with_patch(m: JavaHashMap<String, Tag>, patch: own JavaHashMap<String, Tag>) -> Tag {
    var out = m.copy()
    if patch.is_empty() {
        _ = out.remove("components")
    } else {
        out.insert(String("components"), Tag.Compound(patch))
    }
    return Tag.Compound(out)
}

// The stack without its component `name`, `ItemStack.remove`: out of its patch, or marked gone
// where its item has it.
fn without_component(stack: Tag, name: str) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var patch = patch_of(m)
    if patch.contains(name) {
        _ = patch.remove(name)
    } else {
        patch.insert("!{name}", Tag.Compound(JavaHashMap<String, Tag>()))
    }
    return with_patch(m, patch)
}

// One banner like `stack`, its last pattern taken off, the patterns gone where none are left, as
// a banner's own are none; none where it has none.
fn without_last_pattern(stack: Tag) -> Tag? {
    let Tag.Compound(m) = stack else return none
    var patch = patch_of(m)
    if not patch.contains("minecraft:banner_patterns") {
        return none
    }
    let layers = patch["minecraft:banner_patterns"].copy()
    let Tag.List(l) = layers else return none
    if l.is_empty() {
        return none
    }
    var kept = l.copy()
    _ = kept.pop()
    if kept.is_empty() {
        _ = patch.remove("minecraft:banner_patterns")
    } else {
        patch.insert(String("minecraft:banner_patterns"), Tag.List(kept))
    }
    var one = m.copy()
    one.insert(String("count"), Tag.Int(1))
    return some(with_patch(one, patch))
}

// `transmuteCopy(item, 1)`: one of `item` with the stack's components.
fn transmuted(stack: Tag, item: str) -> Tag {
    let Tag.Compound(m) = stack else return item_stack(String(item))
    var out = m.copy()
    out.insert(String("id"), Tag.Str(String(item)))
    out.insert(String("count"), Tag.Int(1))
    return Tag.Compound(out)
}

// A door's, trapdoor's or fence gate's sound as it opens, if `open`, or shuts, from its
// `BlockSetType` or `WoodType`, at full volume and a pitch of 0.9 to 1, for all but the player.
fn swing_sound<L: BlockLevel + RandomSource>(f: Facts, level: mut L, block: u32, x: i32, y: i32, z: i32, open: bool, u: User) {
    let pitch = level.next_float() * 0.1f32 + 0.9f32
    if let sound = f.toggle_sound(block, open) {
        level.play_sound_from(u.player, x, y, z, sound, 1.0f32, pitch)
    }
}

// A repeater's delay turned one up, from 4 round to 1, set with flags 3; a comparator's mode
// switched, with its click for all but the player, set with flags 2 and its output refreshed; or
// a daylight detector inverted, set with flags 2, and its signal worked out again.
fn switch<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, kind: String, state: u32, x: i32, y: i32, z: i32, u: User) ! Thrown {
    if kind == "RepeaterBlock" {
        let delay = (f.get_int(state, "delay") ?? 1) % 4 + 1
        _ = level.set_block_limited(x, y, z, try f.with_int(state, "delay", delay), 3, UPDATE_LIMIT)
        return
    }
    if kind == "ComparatorBlock" {
        let subtract = (f.get_name(state, "mode") ?? String("compare")) == "compare"
        let switched = try f.with_name(state, "mode", String(if subtract { "subtract" } else { "compare" }))
        level.play_sound_from(u.player, x, y, z, "block.comparator.click", 0.3f32, if subtract { 0.55f32 } else { 0.5f32 })
        _ = level.set_block_limited(x, y, z, switched, 2, UPDATE_LIMIT)
        if f.is(try level.state(f, x, y, z), f.block(state)) {
            try comparator_refresh(f, mut level, switched, x, y, z)
        }
        return
    }
    let inverted = try f.with_bool(state, "inverted", not f.get_bool(state, "inverted"))
    _ = level.set_block_limited(x, y, z, inverted, 2, UPDATE_LIMIT)
    try update_signal_strength(f, mut level, inverted, x, y, z)
}

/// `BellBlock.isProperHit` of the bell `state` at the height `y`, met on the face `face` at the
/// height `at_y`: a side that isn't the top or bottom, below its top 3/16, across a bell on the
/// floor, along one on a wall, and any for one on the ceiling.
pub fn proper_bell_hit(f: Facts, state: u32, y: i32, face: i32, at_y: f64) -> bool {
    if face == DOWN or face == UP or at_y - f64(y) > f64(0.8124f32) {
        return false
    }
    let facing = match facing_of(f, state) {
        ok(d) => d,
        err(_) => 2,
    }
    let same_axis = facing == face or facing == opposite(face)
    let attach = f.get_name(state, "attachment") ?? String("floor")
    if attach == "floor" {
        return same_axis
    }
    if attach == "single_wall" or attach == "double_wall" {
        return not same_axis
    }
    return attach == "ceiling"
}

// `RedstoneWireBlock.useWithoutItem` of a dot or a cross: made the other, of the same power, then
// joined as the blocks around it let it be; where that changed it, set with flags 3, and the
// conductors beside it whose side it joins or leaves told, all but from it, `updatesOnShapeChange`.
fn turn_wire<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> Used ! Thrown {
    var turned = f.default_state(f.block(state))
    if wire_dot(f, state) {
        for i in 0..4 {
            turned = try f.with_name(turned, direction_property(horizontal(i)), String("side"))
        }
    }
    turned = try f.with_int(turned, "power", f.get_int(state, "power") ?? 0)
    turned = try wire_connections(f, level, turned, x, y, z)
    if turned == state {
        return Used.Pass
    }
    _ = level.set_block_limited(x, y, z, turned, 3, UPDATE_LIMIT)
    for i in 0..4 {
        let d = horizontal(i)
        let side = direction_property(d)
        let was = (f.get_name(state, side.copy()) ?? String("none")) != "none"
        let now = (f.get_name(turned, side) ?? String("none")) != "none"
        let (nx, nz) = (x + step_x(d), z + step_z(d))
        if was != now and f.redstone_conductor(try level.state(f, nx, y, nz)) {
            level.update_neighbours_except(nx, y, nz, f.block(turned), opposite(d))
        }
    }
    return Used.Done
}

// Whether the wire joins no side, `isDot`.
fn wire_dot(f: Facts, state: u32) -> bool {
    for side in ["north", "east", "south", "west"] {
        if (f.get_name(state, String(side)) ?? String("none")) != "none" {
            return false
        }
    }
    return true
}

// `RedstoneWireBlock.isCross` or `isDot`: every side joined, or none.
fn wire_alone(f: Facts, state: u32) -> bool {
    var joined = 0
    for side in ["north", "east", "south", "west"] {
        if (f.get_name(state, String(side)) ?? String("none")) != "none" {
            joined += 1
        }
    }
    return joined == 0 or joined == 4
}

// Whether the potion held is water, `PotionContents.is(Potions.WATER)`.
fn water_potion(held: Tag?) -> bool {
    let contents = component_of(held, "minecraft:potion_contents") else return false
    return match contents {
        Tag.Str(s) => s == "minecraft:water",
        Tag.Compound(m) => {
            if not m.contains("potion") {
                return false
            }
            let potion = m["potion"].copy()
            match potion {
                Tag.Str(s) => s == "minecraft:water",
                _ => false,
            }
        },
        _ => false,
    }
}

// Whether what's held has the component `name`, its item's own or its stack's.
fn component_of_item(items: ItemCodecs, u: User, name: str) -> bool {
    let stack = u.held.copy() else return false
    return items.component(stack, String(name)) != none
}
