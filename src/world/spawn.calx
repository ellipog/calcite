/// Where a player new to the world joins it, as vanilla's `PlayerSpawnFinder` finds the place
/// (CAL-75): a column near the world's spawn, from candidates in a square around it taken in a
/// walk that starts at random, the first whose surface a player can stand on, or else the spawn
/// itself, moved up or down to where a player fits.
///
/// The square reaches `respawn_radius` from the spawn, or the world border if that's nearer.
/// Its columns, up to 1024, are numbered row by row from its least corner, and the walk goes
/// from a random one in steps of a number that shares no factor with how many there are, 17 or
/// one less than the count, so it comes to each once. Each candidate's chunk is loaded full with
/// a `spawn_search` ticket before it's checked, which the caller does.
///
/// A column is stood on, as `getLevelRespawnPos` has it, where the block below its highest that
/// blocks motion is one the player can stand on, with no liquid above it, and it's not under
/// water: one whose surface is no higher than what blocks motion, and above the ocean floor, is
/// left. The player's box there has to meet no block, liquids included.
module world.spawn

import world.chunk.{Chunk, MOTION_BLOCKING, OCEAN_FLOOR, WORLD_SURFACE}
import world.collision.{CollisionBlocks, CollisionStates, player_box}
import world.pos.{BlockPos}

/// The most candidates a search has, `ABSOLUTE_MAX_ATTEMPTS`.
pub const MOST_CANDIDATES: i32 = 1024
/// `respawn_radius`'s default.
pub const DEFAULT_RESPAWN_RADIUS: i32 = 10
/// Half the default world border's width, which is centred on the origin.
pub const BORDER_HALF: f64 = 29999984.0

/// How far from `x`, `z` the default world border is, inside it, as
/// `WorldBorder.getDistanceToBorder`: less than nothing outside it.
pub fn border_distance(x: i32, z: i32) -> f64 {
    let fx = f64(x)
    let fz = f64(z)
    let from_west = fx + BORDER_HALF
    let from_east = BORDER_HALF - fx
    let from_north = fz + BORDER_HALF
    let from_south = BORDER_HALF - fz
    return from_west.min(from_east).min(from_north).min(from_south)
}

/// How far around the spawn a search goes, as `findSpawn` works it out: `respawn_radius`, at
/// least 0, or the distance to the world border, rounded down, if that's less, and at least 1
/// if the border is 1 away or less.
pub fn search_radius(respawn_radius: i32, border: f64) -> i32 {
    var radius = respawn_radius.max(0)
    let to_border = i32.saturate(border.floor())
    if to_border < radius {
        radius = to_border
    }
    if to_border <= 1 {
        radius = 1
    }
    return radius
}

/// How many candidates a search of `radius` has: the columns of its square, at most 1024.
pub fn candidate_count(radius: i32) -> i32 {
    let side = i64(radius) * 2 + 1
    return i32.wrap(side.saturating_mul(side).min(i64(MOST_CANDIDATES)))
}

/// A column to check, or the spawn itself, once every candidate's been.
pub struct Candidate {
    pub x: i32
    pub z: i32
    /// Whether it's the spawn, after every candidate, where the player goes whatever's there,
    /// moved up or down to where they fit.
    pub last: bool
}

/// A search around the spawn, as `PlayerSpawnFinder` keeps it.
pub struct SpawnSearch {
    /// The world's spawn, the search's centre.
    pub origin: BlockPos
    pub radius: i32
    candidates: i32
    coprime: i32
    offset: i32
    taken: i32 = 0
}

impl SpawnSearch {
    /// A search of `radius` around `origin`, from candidate `offset`, which vanilla draws from 0
    /// up to `candidate_count(radius)` with a new random source. Panics if it's outside them.
    @track_caller
    pub fn new(origin: BlockPos, radius: i32, offset: i32) -> SpawnSearch {
        let count = candidate_count(radius)
        if offset < 0 or offset >= count {
            panic("candidate {offset} of a search with {count}")
        }
        let coprime = if count <= 16 { count - 1 } else { 17 }
        return SpawnSearch { origin: origin, radius: radius, candidates: count, coprime: coprime, offset: offset }
    }

    /// How many candidates it has.
    pub fn count(self) -> i32 {
        return self.candidates
    }

    /// The next column to check, as `scheduleNext` takes it: a candidate, or after the last of
    /// them the spawn, and the spawn again after that.
    pub fn next(mut self) -> Candidate {
        let i = self.taken
        if i >= self.candidates {
            return Candidate { x: self.origin.x, z: self.origin.z, last: true }
        }
        self.taken += 1
        let value = (self.offset + self.coprime * i) % self.candidates
        let side = self.radius * 2 + 1
        return Candidate { x: self.origin.x + value % side - self.radius, z: self.origin.z + value / side - self.radius, last: false }
    }
}

/// The block a player would stand in at `x`, `z` of `chunk`, the chunk holding that column, as
/// `getLevelRespawnPos` finds it in a dimension with no ceiling: above the highest block below
/// the top of `MOTION_BLOCKING` that something can stand on, unless a liquid comes first, the
/// column is under water, or there's nothing.
pub fn respawn_pos(states: CollisionStates, chunk: Chunk, x: i32, z: i32) -> BlockPos? {
    let cx = x & 15
    let cz = z & 15
    let min_y = chunk.min_y()
    let top = chunk.height(MOTION_BLOCKING, cx, cz) - 1
    if top < min_y {
        return none
    }
    let surface = chunk.height(WORLD_SURFACE, cx, cz) - 1
    if surface <= top and surface > chunk.height(OCEAN_FLOOR, cx, cz) - 1 {
        return none
    }
    var y = top + 1
    while y >= min_y {
        let state = chunk.block(cx, y, cz)
        if states.has_fluid(state) {
            return none
        }
        if states.top_full(state) {
            return some(BlockPos { x: x, y: y + 1, z: z })
        }
        y -= 1
    }
    return none
}

/// The block a player can stand in, in the column at `x`, `z` of `chunk`, from `top` down: the
/// highest they fit in, liquids counting as blocks, above a block something can stand on that
/// isn't a liquid, or `none` where the column has none. `blocks` has the column's chunk.
pub fn standing_y<B: CollisionBlocks>(states: CollisionStates, chunk: Chunk, blocks: B, x: i32, top: i32, z: i32) -> i32? {
    let cx = x & 15
    let cz = z & 15
    var y = top
    while y > chunk.min_y() {
        let below = chunk.block(cx, y - 1, cz)
        if states.top_full(below) and not states.has_fluid(below) and fits(states, blocks, x, y, z) {
            return some(y)
        }
        y -= 1
    }
    return none
}

/// Whether a player standing at the bottom middle of `x`, `y`, `z` meets no block, liquids
/// included, as `noCollisionNoLiquid`.
pub fn fits<B: CollisionBlocks>(states: CollisionStates, blocks: B, x: i32, y: i32, z: i32) -> bool {
    return states.no_collision(blocks, player_box(x, y, z))
}

/// Where a player at `x`, `y`, `z` goes, as `fixupSpawnHeight` moves them: up until they fit,
/// or to `max_y`, then down while they'd still fit a block lower, to `min_y` at the lowest. The
/// `y` of the block they stand in.
pub fn fixup_height<B: CollisionBlocks>(states: CollisionStates, blocks: B, x: i32, y: i32, z: i32, min_y: i32, max_y: i32) -> i32 {
    var at = y
    while not fits(states, blocks, x, at, z) and at < max_y {
        at += 1
    }
    at -= 1
    while fits(states, blocks, x, at, z) and at > min_y {
        at -= 1
    }
    return at + 1
}
