/// Infested blocks and the blocks they hide in (CAL-172): `InfestedBlock`'s `BLOCK_BY_HOST_BLOCK`,
/// each infested block's host, the block its name is with `infested_` taken off, as vanilla
/// registers `INFESTED_STONE` on `STONE` and the rest alike; and a state of one taken to the
/// other with the properties both have, `infestedStateByHost` and `hostStateByInfested`, as
/// `getNewStateWithProperties` copies them.
module world.infested

import worldgen.facts.{Facts}

/// The infested blocks and their hosts, by their IDs, side by side, in ID order.
pub struct Infested {
    pub infested: List<u32>
    pub hosts: List<u32>
}

impl Infested {
    /// The pairs `f` has: each `InfestedBlock` and the block named as it is without `infested_`.
    pub fn new(f: Facts) -> Infested {
        var infested = List<u32>()
        var hosts = List<u32>()
        for block in 0u32..f.codec.blocks.len() {
            if not f.is_a(block, String("InfestedBlock")) {
                continue
            }
            let name = f.codec.blocks.name(block)
            if not name.starts_with("minecraft:infested_") {
                continue
            }
            let host_name = "minecraft:{name["minecraft:infested_".len()..]}"
            let host = f.block_named(host_name) else continue
            infested.push(block)
            hosts.push(host)
        }
        return Infested { infested: infested, hosts: hosts }
    }

    /// Whether the state's block is one an infested block hides in, `isCompatibleHostBlock`.
    pub fn is_host(self, f: Facts, state: u32) -> bool {
        let block = f.block(state)
        for h in self.hosts {
            if h == block {
                return true
            }
        }
        return false
    }

    /// The infested state of a host's state, `infestedStateByHost`, none for a state that isn't
    /// a host's.
    pub fn infested_of(self, f: Facts, state: u32) -> u32? {
        let block = f.block(state)
        for i in 0..self.hosts.len() {
            if self.hosts[i] == block {
                return some(with_properties(f, state, self.infested[i]))
            }
        }
        return none
    }

    /// The host's state of an infested state, `hostStateByInfested`, none for a state that isn't
    /// an infested block's.
    pub fn host_of(self, f: Facts, state: u32) -> u32? {
        let block = f.block(state)
        for i in 0..self.infested.len() {
            if self.infested[i] == block {
                return some(with_properties(f, state, self.hosts[i]))
            }
        }
        return none
    }
}

// `getNewStateWithProperties`: the default state of `block` with each property `state` has that
// it has too set as `state` has it, `copyProperty`.
fn with_properties(f: Facts, state: u32, block: u32) -> u32 {
    var out = f.default_state(block)
    let to = f.codec.props(block)
    for p in f.codec.props(f.block(state)) {
        for q in to {
            if q.id == p.id {
                out = q.set(out, p.get(state))
            }
        }
    }
    return out
}
