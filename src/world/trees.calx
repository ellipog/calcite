/// Trees grown from saplings, `TreeGrower.growTree` (CAL-381), as a sapling's random tick and bone
/// meal grow them: each grower's trees, 2 by 2 trees and trees by flowers, its tree feature placed
/// on the level as `place feature` places one.
module world.trees

import random.source.{RandomSource}
import world.block_level.{BlockLevel}
import world.level_writer.{LevelWriter, UPDATE_LIMIT}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

// A `TreeGrower`: its trees, its 2 by 2 trees and its trees by flowers, `WeightedList`s of
// feature IDs, each with its weight, and its shortest tree's trunk's base height,
// `getMinimumHeight`, 0 for none.
struct Grower {
    trees: List<(str, i32)>
    mega: List<(str, i32)>
    flowers: List<(str, i32)>
    shortest: i32 = 0
}

// The grower of the sapling `name`, `TreeGrower`'s: none for a block that isn't one.
fn grower_of(name: String) -> Grower? {
    if name == "minecraft:oak_sapling" {
        return some(Grower { trees: [("minecraft:oak", 9), ("minecraft:fancy_oak", 1)], mega: [], flowers: [("minecraft:oak_bees_005", 9), ("minecraft:fancy_oak_bees_005", 1)], shortest: 4 })
    }
    if name == "minecraft:spruce_sapling" {
        return some(Grower { trees: [("minecraft:spruce", 1)], mega: [("minecraft:mega_spruce", 1), ("minecraft:mega_pine", 1)], flowers: [], shortest: 5 })
    }
    if name == "minecraft:mangrove_propagule" {
        return some(Grower { trees: [("minecraft:mangrove", 15), ("minecraft:tall_mangrove", 85)], mega: [], flowers: [], shortest: 2 })
    }
    if name == "minecraft:azalea" or name == "minecraft:flowering_azalea" {
        return some(Grower { trees: [("minecraft:azalea_tree", 1)], mega: [], flowers: [], shortest: 4 })
    }
    if name == "minecraft:birch_sapling" {
        return some(Grower { trees: [("minecraft:birch", 1)], mega: [], flowers: [("minecraft:birch_bees_005", 1)], shortest: 5 })
    }
    if name == "minecraft:jungle_sapling" {
        return some(Grower { trees: [("minecraft:jungle_tree_no_vine", 1)], mega: [("minecraft:mega_jungle_tree", 1)], flowers: [], shortest: 4 })
    }
    if name == "minecraft:acacia_sapling" {
        return some(Grower { trees: [("minecraft:acacia", 1)], mega: [], flowers: [], shortest: 5 })
    }
    if name == "minecraft:cherry_sapling" {
        return some(Grower { trees: [("minecraft:cherry", 1)], mega: [], flowers: [("minecraft:cherry_bees_005", 1)], shortest: 7 })
    }
    if name == "minecraft:dark_oak_sapling" {
        return some(Grower { trees: [], mega: [("minecraft:dark_oak", 1)], flowers: [] })
    }
    if name == "minecraft:pale_oak_sapling" {
        return some(Grower { trees: [], mega: [("minecraft:pale_oak_bonemeal", 1)], flowers: [] })
    }
    if name == "minecraft:poplar_sapling" {
        return some(Grower { trees: [("minecraft:red_poplar", 1), ("minecraft:orange_poplar", 1), ("minecraft:yellow_poplar", 1)], mega: [], flowers: [], shortest: 7 })
    }
    return none
}

// `WeightedList.getRandom`: none from an empty list, without a draw; else a draw below the total
// weight, and the first whose weights so far pass it.
fn pick<R: RandomSource>(random: mut R, list: List<(str, i32)>) -> str? {
    if list.is_empty() {
        return none
    }
    var total = 0
    for (_, w) in list {
        total += w
    }
    var drawn = random.next_int_below(total)
    for (id, w) in list {
        if drawn < w {
            return some(id)
        }
        drawn -= w
    }
    return none
}

/// `TreeGrower.growTree` of the sapling `state` at x, y, z: where its grower has 2 by 2 trees, one
/// drawn, and where it's one of four of its block, `findTwoByTwoSaplingPos`, from this corner
/// west and north, the four taken away, `removeSapling`, and the tree placed at the north-west
/// one, the four put back with flags 260 where it doesn't. Else one of its trees drawn, of those
/// by flowers where a flower's in the 5 by 3 by 5 about it and it has them, `hasFlowers`; the
/// sapling taken away, its fluid's block set with flags 818, and the tree placed there, the
/// sapling put back where it doesn't. Whether a tree grew.
pub fn grow_tree<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let g = grower_of(f.codec.blocks.name(f.block(state))) else return false
    if let mega = pick(mut level, g.mega) {
        if let (dx, dz) = try two_by_two(f, level, state, x, y, z) {
            var four = List<(i32, i32, u32)>()
            for (ox, oz) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
                four.push((x + dx + ox, z + dz + oz, try level.state(f, x + dx + ox, y, z + dz + oz)))
            }
            for (sx, sz, _) in four {
                try remove_sapling(f, mut level, sx, y, sz)
            }
            if try level.grow_feature(String(mega), x + dx, y, z + dz) {
                return true
            }
            for (sx, sz, s) in four {
                _ = level.set_block_limited(sx, y, sz, s, 260, UPDATE_LIMIT)
            }
            return false
        }
    }
    let flowers = try has_flowers(f, level, x, y, z)
    let list = if flowers and not g.flowers.is_empty() { g.flowers } else { g.trees }
    let id = pick(mut level, list) else return false
    try remove_sapling(f, mut level, x, y, z)
    if try level.grow_feature(String(id), x, y, z) {
        return true
    }
    _ = level.set_block_limited(x, y, z, state, 260, UPDATE_LIMIT)
    return false
}

/// `SaplingBlock.isValidBonemealTarget` of the sapling `state` at x, y, z: its grower's tree drawn,
/// of those by flowers where it has them and there's one about, then its 2 by 2 tree,
/// `TreeGrower.canGrow`; with no tree but a 2 by 2 one, only where it's one of four, and its
/// shortest tree's base height above it in the world.
pub fn sapling_can_grow<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let g = grower_of(f.codec.blocks.name(f.block(state))) else return false
    let flowers = try has_flowers(f, level, x, y, z)
    let tree = pick(mut level, if flowers and not g.flowers.is_empty() { g.flowers } else { g.trees })
    let mega = pick(mut level, g.mega)
    if tree == none and mega != none and try two_by_two(f, level, state, x, y, z) == none {
        return false
    }
    return level.in_height(y + g.shortest)
}

// `findTwoByTwoSaplingPos`: from this corner west and north, the offset of the north-west of
// four of the sapling `state`'s block, where it's one of four.
fn two_by_two<L: BlockAccess>(f: Facts, level: L, state: u32, x: i32, y: i32, z: i32) -> (i32, i32)? ! Thrown {
    for dx in [0, -1] {
        for dz in [0, -1] {
            var all = true
            for (ox, oz) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
                if f.block(try level.state(f, x + dx + ox, y, z + dz + oz)) != f.block(state) {
                    all = false
                }
            }
            if all {
                return some((dx, dz))
            }
        }
    }
    return none
}

// `removeSapling`: the block its fluid leaves, `createLegacyBlock`, set with flags 818.
fn remove_sapling<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    let s = try level.state(f, x, y, z)
    let left = if f.is_water(s) { f.default_state(f.ids.water) } else { f.default_state(f.ids.air) }
    _ = level.set_block_limited(x, y, z, left, 818, UPDATE_LIMIT)
}

// `hasFlowers`: a flower, `BlockTags.FLOWERS`, from 2 west, 1 down and 2 north to 2 east, 1 up
// and 2 south of x, y, z.
fn has_flowers<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let flowers = f.tag(String("minecraft:flowers"))
    for dx in -2..3 {
        for dy in -1..2 {
            for dz in -2..3 {
                if f.in_set(try level.state(f, x + dx, y + dy, z + dz), flowers) {
                    return true
                }
            }
        }
    }
    return false
}

/// `SaplingBlock.advanceTree` of the sapling `state` at x, y, z: at stage 0, stage 1, flags 260;
/// else its tree, `TreeGrower.growTree`.
pub fn advance_tree<L: BlockAccess + BlockLevel + RandomSource + LevelWriter>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if f.get_int(state, String("stage")) == some(0) {
        _ = level.set_block(x, y, z, try f.with_int(state, String("stage"), 1), 260)
        return
    }
    _ = try grow_tree(f, mut level, state, x, y, z)
}
