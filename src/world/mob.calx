            // players within 8 and at guardians within 12, one in a hundred; looking around; and
            // its target goal, of players more than 3 from it, seen, one in ten tries.
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.GuardianAttack(0))
            self.goals.add(5, FLAG_MOVE | FLAG_LOOK, false, Goal.Restrict(Restrict { speed: 1.0 }))
            let interval = if s == ELDER_GUARDIAN { 400 } else { 80 }
            self.goals.add(7, FLAG_MOVE | FLAG_LOOK, false, Goal.Stroll(Stroll { speed: 1.0, interval: interval, water_avoiding: false }))
            self.goals.add(8, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(8, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 12.0f32, probability: 0.01f32, of: LOOK_GUARDIANS }))
            self.goals.add(9, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.targets.add(1, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_PLAYER, interval: reduced_tick_delay(10), targeting: Targeting { must_see: true }, guardian: true }))
            return
