            // A polar bear, `PolarBear` (CAL-201): water slows it less, `getWaterSlowDown`.
            mb.living.water_slow_down = 0.98f32
        } else if species == FOX {
            // A fox, `Fox` (CAL-201): it may pick up loot, `setCanPickUpLoot`.
            mb.can_pick_up_loot = true
        } else if species == PARROT {
            // A parrot, `Parrot` (CAL-201), a `TamableAnimal`: through the air alike every way,
