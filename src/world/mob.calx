            // sensors put off by its random, its gates seeded from its own seed.
            mb.category = MONSTER
            mb.peaceful_ok = false
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.body.quiet_splash = some(String("entity.hostile.splash"))
            mb.living.swim = String("entity.hostile.swim")
            mb.brain = some(Brain.made(hoglin_sensors(), hoglin_activities(seed), mut mb.living.body.random))
        }
        if species == ZOMBIE_HORSE {
            // A monster by its category, burning in daylight, `#burn_in_daylight`.
            mb.category = MONSTER
            mb.burns = true
            // Undead, it breathes under water, `#can_breathe_under_water` (CAL-175).
            mb.living.breathes_water = true
        }
        if species == SKELETON_HORSE {
