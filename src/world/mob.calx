    /// A phantom's own (CAL-200).
    pub phantom: PhantomLife = PhantomLife()
    /// A wolf's own (CAL-201).
    pub wolf: WolfLife = WolfLife()
    /// A rabbit's own (CAL-201).
    pub rabbit: RabbitLife = RabbitLife()
