import world.entity_data.{AGE_LOCKED, BABY, CUSTOM_NAME_VISIBLE, EntityData, HEALTH, LEFT_HANDED_FLAG, MOB_FLAGS, MOOSHROOM_TYPE, NO_AI_FLAG, NO_GRAVITY, ON_FIRE_FLAG, SHARED_FLAGS, SILENT, Value, chicken_data, cow_data, creeper_data, donkey_data, enderman_data, horse_data, mooshroom_data, pig_data, sheep_data, skeleton_data, slime_data, spider_data, witch_data, zombie_data, zombie_horse_data, zombie_villager_data}
import world.entity_facts.{CREATURE, MONSTER, PATH_FIRE, PATH_FIRE_IN_NEIGHBOR, PATH_WATER, WATER_AMBIENT}
