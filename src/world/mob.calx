            mb.variant = facts.wolf.default
            mb.variant_names = facts.wolf.names.copy()
            mb.sound_variant = facts.wolf_sounds.default
            mb.sounds = some(facts.wolf_sounds.copy())
            mb.max_cluster = 8
            // What hurts it kept, its death told its owner where it's tame (CAL-201).
            mb.living.combat = some(CombatTracker())
        } else if species == RABBIT {
            // A rabbit, `Rabbit` (CAL-201): its idle animation's timeout drawn as it's made,
