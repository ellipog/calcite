/// A mob, as vanilla's `Mob` has it (CAL-156): a living entity (`world.living`) of a category that
/// natural spawning counts, made by its type and finalized as `finalizeSpawn` finalizes it, from
/// the level's random: its follow range's random spawn bonus, `triangle(0, 0.11485)`, and whether
/// it's left-handed, 1 in 20, after what its kind draws first. It has its own flags, without AI,
/// left-handed and aggressive; whether it must stay, `PersistenceRequired`, and may pick up
/// loot; how long it's done nothing, `noActionTime`; and now and then its ambient sound, `baseTick`'s
/// draw from its own random against how long since its last, which starts again at less its
/// interval, 80 a mob's and 120 an animal's, `getAmbientSoundInterval`.
///
/// An ageable mob, `AgeableMob`, has an age: below 0 a baby growing up a tick at a time, unless
/// its age is locked, above 0 how long until it can breed, counting down. A pack of them is
/// finalized together, each after the first a baby 1 in 20, as `AgeableMobGroupData` has it. An
/// animal, `Animal`, has its love, which its age being anything but 0 takes away.
///
/// The first kind is the mooshroom, `MushroomCow`: an animal 0.9 across and 1.4 high, its eyes 1.3
/// up, a calf 0.45 by 0.7 with its eyes 0.69 up, red or brown, that moos and steps as a cow does,
/// `entity.cow.ambient` at 0.4 and `entity.cow.step`.
///
/// Each tick, before its tick, it may go, `checkDespawn`: in peaceful where its type isn't allowed
/// in it; and where it needn't stay, past its category's despawn distance from the nearest player,
/// or after 600 ticks doing nothing one in 800 past 32 blocks, where it's removed far away, which
/// no animal is. Within 32 blocks of a player, its ticks doing nothing start again.
///
/// Not yet: its thinking, `serverAiStep`'s sensing, goals, navigation and controls, and its body
/// turning toward its head, `BodyRotationControl` (CAL-157, CAL-158), so it moves only as it's
/// moved; picking up loot; burning in daylight; and its effects and equipment, kept as they were
/// loaded.
module world.mob

import nbt.tag.{Tag}
import random.source.{RandomSource}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.attributes.{ADD_MULTIPLIED_BASE, Modifier, attribute_id}
import world.body.{BodyFacts, EntitySound, bool_or, int_or}
import world.collision.{CollisionBlocks}
import world.entity_data.{AGE_LOCKED, BABY, LEFT_HANDED_FLAG, MOB_FLAGS, MOOSHROOM_TYPE, NO_AI_FLAG, Value, mooshroom_data}
import world.entity_facts.{CREATURE, WATER_AMBIENT}
import world.living.{Living, LivingFacts}
import world.movement.{MovementStates}
import worldgen.facts.{Facts}

/// A baby's age as it's made one, `getBabyStartAge`.
pub const BABY_START_AGE: i32 = -24000

/// What a pack's mobs share as each is finalized, `SpawnGroupData`: for an ageable pack,
/// `AgeableMobGroupData`, whether it may have babies, how many of it have been finalized, and the
/// chance each after the first is one.
pub struct SpawnGroup {
    pub ageable: bool = false
    pub babies: bool = true
    pub size: i32 = 0
    pub baby_chance: f32 = 0.05f32
}

/// The kinds of mob Calcite makes.
pub const MOOSHROOM: i32 = 0

/// How far from the nearest player a mob of `category` may be before it goes at once,
/// `MobCategory.getDespawnDistance`; and within how far it never goes, `getNoDespawnDistance`.
pub fn despawn_distance(category: i32) -> i32 {
    return if category == WATER_AMBIENT { 64 } else { 128 }
}

pub const NO_DESPAWN_DISTANCE: i32 = 32

/// A mob.
pub struct Mob {
    /// What every living entity has; its kind, and its type's category.
    pub living: Living
    pub species: i32
    pub category: i32
    /// Whether it must stay, and may pick up loot; how long it's done nothing; how long since its
    /// last ambient sound, `ambientSoundTime`, below 0 just after one; and that sound, with how
    /// loud it's played, `getSoundVolume`.
    pub persistence_required: bool = false
    pub can_pick_up_loot: bool = false
    pub no_action_time: i32 = 0
    pub ambient_sound_time: i32 = 0
    pub ambient_interval: i32 = 80
    pub ambient: String? = none
    pub sound_volume: f32 = 1.0f32
    /// Whether its type is allowed in peaceful, `isAllowedInPeaceful`, and it's an animal, `Animal`.
    pub peaceful_ok: bool = true
    pub animal: bool = false
    /// Whether it ages, and an ageable mob's age and forced age; an animal's love, `inLove`.
    pub ageable: bool = false
    pub age: i32 = 0
    pub forced_age: i32 = 0
    pub in_love: i32 = 0
    /// Its size grown, and a baby's, `BABY_DIMENSIONS`.
    width: f32
    height: f32
    eyes: f32
    baby_width: f32
    baby_height: f32
    baby_eyes: f32
    /// What it was loaded with that Calcite doesn't run yet, by the keys it's saved under: its drop
    /// chances, leash, home, death loot table and seed, its love's cause, and a mooshroom's stew
    /// effects.
    pub kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
}

impl Mob {
    /// A mooshroom of the type `kind` at x, y, z with its own random seeded `seed`, as
    /// `MushroomCow`'s constructor makes it: red, grown.
    pub fn mooshroom(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> Mob {
        var l = Living.made(lf, kind, id, seed, x, y, z, 0.9f32, 1.4f32, 1.3f32, mooshroom_data())
        l.own_step = some(String("entity.cow.step"))
        return Mob { living: l, species: MOOSHROOM, category: CREATURE, ambient: some(String("entity.cow.ambient")), ambient_interval: 120, sound_volume: 0.4f32, animal: true, ageable: true, width: 0.9f32, height: 1.4f32, eyes: 1.3f32, baby_width: 0.45f32, baby_height: 0.7f32, baby_eyes: 0.69f32 }
    }

    /// Its flags, `DATA_MOB_FLAGS_ID`, and whether it's without AI, `isNoAi`, and left-handed.
    pub fn flags(self) -> i32 {
        return i32(self.living.data.byte(MOB_FLAGS))
    }

    pub fn no_ai(self) -> bool {
        return self.flags() & NO_AI_FLAG != 0
    }

    pub fn left_handed(self) -> bool {
        return self.flags() & LEFT_HANDED_FLAG != 0
    }

    fn set_flag(mut self, bit: i32, on: bool) {
        self.living.data.set_flag(MOB_FLAGS, bit, on)
    }

    /// Whether it may go where the nearest player is `d` blocks squared away, `removeWhenFarAway`:
    /// an animal never does.
    pub fn removed_far_away(self, d: f64) -> bool {
        _ = d
        return not self.animal
    }

    /// `checkDespawn` in a chunk that ticks entities, in peaceful where `peaceful`, with the
    /// nearest player that isn't a spectator `nearest` blocks squared away, if there's one:
    /// whether it goes, `discard`. Its chance after 600 ticks doing nothing is drawn from its own
    /// random only where it needn't stay.
    pub fn check_despawn(mut self, peaceful: bool, nearest: f64?) -> bool {
        if peaceful and not self.peaceful_ok {
            return true
        }
        let d = nearest else return false
        let stays = self.persistence_required
        let far = despawn_distance(self.category)
        if not stays and d > f64(far * far) and self.removed_far_away(d) {
            return true
        }
        let near = f64(NO_DESPAWN_DISTANCE * NO_DESPAWN_DISTANCE)
        if not stays and self.no_action_time > 600 and self.living.body.random.next_int_below(800) == 0 and d > near and self.removed_far_away(d) {
            return true
        }
        if d < near {
            self.no_action_time = 0
        }
        return false
    }

    /// Whether it's a baby, `isBaby`, an ageable one whose age is below 0.
    pub fn baby(self) -> bool {
        return self.ageable and self.age < 0
    }

    /// `AgeableMob.setAge`: its age, and whether it's a baby where that crosses 0, its size made
    /// again, `refreshDimensions`, as `onSyncedDataUpdated` makes it.
    pub fn set_age(mut self, age: i32) {
        let old = self.age
        self.age = age
        if (old < 0 and age >= 0) or (old >= 0 and age < 0) {
            self.living.data.set(BABY, Value.Bool(age < 0))
            let baby = age < 0
            self.living.body.width = if baby { self.baby_width } else { self.width }
            self.living.body.height = if baby { self.baby_height } else { self.height }
            self.living.body.eyes = if baby { self.baby_eyes } else { self.eyes }
        }
    }

    /// `finalizeSpawn` as natural spawning finalizes it, with `given` its pack's group so far,
    /// drawing from `r`, the level's random: an ageable mob's group made where there's none, and
    /// each after the first a baby by its chance; then `Mob`'s, its follow range's random spawn
    /// bonus where it hasn't one and whether it's left-handed. The group, for the next.
    pub fn finalize_spawn<R: RandomSource>(mut self, given: own SpawnGroup?, r: mut R) -> SpawnGroup? {
        var group = given
        if self.ageable {
            var g = group ?? SpawnGroup { ageable: true }
            if g.babies and g.size > 0 and r.next_float() <= g.baby_chance {
                self.set_age(BABY_START_AGE)
            }
            g.size += 1
            group = some(g)
        }
        let follow = attribute_id("minecraft:follow_range") ?? panic("no follow range")
        let bonus = Identifier { namespace: "minecraft", path: "random_spawn_bonus" }
        _ = self.living.attributes.instance(follow)
        if not self.living.attributes.has_modifier(follow, bonus) {
            let amount = r.triangle(0.0, 0.11485000000000001)
            self.living.attributes.add_permanent(follow, Modifier { id: bonus, amount: amount, operation: ADD_MULTIPLIED_BASE })
        }
        self.set_flag(LEFT_HANDED_FLAG, r.next_float() < 0.05f32)
        return group
    }

    /// Its tick, as `tickNonPassenger` and `Mob.tick` run it among `blocks`, in a level whose floor
    /// is `min_y`, where lava's fast if `fast_lava`: `baseTick`, with its ambient sound now and
    /// then; `aiStep`, the ticks it's done nothing counted where it thinks, then its move, and
    /// after it an ageable mob's age and an animal's love; and its turns kept near.
    pub fn tick<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.living.base_tick(lf, f, t, blocks, min_y, fast_lava, mut sounds)
        if self.living.alive() {
            let drawn = self.living.body.random.next_int_below(1000)
            let due = drawn < self.ambient_sound_time
            self.ambient_sound_time += 1
            if due {
                self.ambient_sound_time = -self.ambient_interval
                let held = self.ambient.copy()
                if let sound = held {
                    let pitch = self.voice_pitch()
                    self.living.play(mut sounds, sound, self.sound_volume, pitch)
                }
            }
        }
        if not self.living.body.removed {
            let thinks = self.living.ai_start() and not self.no_ai()
            if thinks {
                self.no_action_time += 1
                self.animal_step()
            }
            let moves = not self.no_ai()
            self.living.ai_rest(lf, f, m, t, blocks, fast_lava, moves, mut sounds)
            if self.ageable and self.living.alive() {
                let locked = self.living.data.flag(AGE_LOCKED)
                if self.baby() and not locked {
                    let older = self.age + 1
                    self.set_age(older)
                } else if self.age > 0 {
                    let younger = self.age - 1
                    self.set_age(younger)
                }
            }
            self.animal_step()
            if self.in_love > 0 {
                self.in_love -= 1
            }
        }
        self.living.tick_end()
    }

    // `Animal`'s: its love gone where its age is anything but 0.
    fn animal_step(mut self) {
        if self.animal and self.age != 0 {
            self.in_love = 0
        }
    }

    // `getVoicePitch`: about 1, or 1.5 for a baby, from its own random.
    fn voice_pitch(mut self) -> f32 {
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        return (a - b) * 0.2f32 + (if self.baby() { 1.5f32 } else { 1.0f32 })
    }

    /// The mob `tag` saves, of the type `kind`, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes it and `load` reads it in; none where it isn't a kind Calcite
    /// makes or doesn't read, logged in `lines`.
    pub fn loaded(lf: LivingFacts, kind: u32, id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Mob? {
        let Tag.Str(name) = tag["id"] else return none
        if name != "minecraft:mooshroom" {
            return none
        }
        var mob = Mob.mooshroom(lf, kind, id, seed, 0.0, 0.0, 0.0)
        if not mob.living.load_from(lf, tag, mut lines) {
            return none
        }
        let turn = mob.living.body.y_rot
        mob.living.y_head_rot = turn
        mob.living.y_head_rot_o = turn
        mob.living.y_body_rot = turn
        mob.living.y_body_rot_o = turn
        mob.can_pick_up_loot = bool_or(tag, "CanPickUpLoot")
        mob.persistence_required = bool_or(tag, "PersistenceRequired")
        mob.set_flag(LEFT_HANDED_FLAG, bool_or(tag, "LeftHanded"))
        mob.set_flag(NO_AI_FLAG, bool_or(tag, "NoAI"))
        if mob.ageable {
            mob.set_age(int_or(tag, "Age", 0))
            mob.forced_age = int_or(tag, "ForcedAge", 0)
            mob.living.data.set(AGE_LOCKED, Value.Bool(bool_or(tag, "AgeLocked")))
            mob.in_love = int_or(tag, "InLove", 0)
        }
        if mob.species == MOOSHROOM {
            var brown = false
            if tag.contains("Type") {
                if let Tag.Str(variant) = tag["Type"] {
                    brown = variant == "brown"
                }
            }
            mob.living.data.set(MOOSHROOM_TYPE, Value.Number(if brown { 1 } else { 0 }))
        }
        for key in ["drop_chances", "leash", "home_radius", "home_pos", "DeathLootTable", "DeathLootTableSeed", "LoveCause", "stew_effects"] {
            if tag.contains(key) {
                mob.kept.insert(String(key), tag[key].copy())
            }
        }
        return some(mob)
    }

    /// What `saveAsPassenger` saves of it: what every living entity saves; then `Mob`'s, whether
    /// it may pick up loot and must stay, whether it's left-handed and without AI where it is,
    /// with what it keeps; an ageable mob's age, forced age and age lock; an animal's love; and a
    /// mooshroom's type.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.living.save_into(mut t, type_name(self.species))
        t.insert(String("CanPickUpLoot"), flag_tag(self.can_pick_up_loot))
        t.insert(String("PersistenceRequired"), flag_tag(self.persistence_required))
        self.put_kept(mut t, "drop_chances")
        self.put_kept(mut t, "leash")
        self.put_kept(mut t, "home_radius")
        self.put_kept(mut t, "home_pos")
        t.insert(String("LeftHanded"), flag_tag(self.left_handed()))
        self.put_kept(mut t, "DeathLootTable")
        self.put_kept(mut t, "DeathLootTableSeed")
        if self.no_ai() {
            t.insert(String("NoAI"), flag_tag(true))
        }
        if self.ageable {
            t.insert(String("Age"), Tag.Int(self.age))
            t.insert(String("ForcedAge"), Tag.Int(self.forced_age))
            t.insert(String("AgeLocked"), flag_tag(self.living.data.flag(AGE_LOCKED)))
            t.insert(String("InLove"), Tag.Int(self.in_love))
            self.put_kept(mut t, "LoveCause")
        }
        if self.species == MOOSHROOM {
            let brown = self.living.data.number(MOOSHROOM_TYPE) == 1
            t.insert(String("Type"), Tag.Str(String(if brown { "brown" } else { "red" })))
            self.put_kept(mut t, "stew_effects")
        }
        return Tag.Compound(t)
    }

    fn put_kept(self, t: mut JavaHashMap<String, Tag>, key: str) {
        if self.kept.contains(key) {
            t.insert(String(key), self.kept[key].copy())
        }
    }
}

/// The type's name of the kind `species`.
pub fn type_name(species: i32) -> str {
    return if species == MOOSHROOM { "minecraft:mooshroom" } else { "minecraft:pig" }
}

// A flag as a byte, as `putBoolean` saves it.
fn flag_tag(on: bool) -> Tag {
    return Tag.Byte(if on { 1i8 } else { 0i8 })
}
