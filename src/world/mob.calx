pub const CHICKEN: i32 = 3
pub const SHEEP: i32 = 4
pub const HORSE: i32 = 5
pub const DONKEY: i32 = 6
pub const CREEPER: i32 = 7
pub const ZOMBIE: i32 = 8
pub const SKELETON: i32 = 9
pub const SPIDER: i32 = 10
pub const SLIME: i32 = 11
pub const ENDERMAN: i32 = 12
pub const WITCH: i32 = 13
pub const ZOMBIE_VILLAGER: i32 = 14
pub const ZOMBIE_HORSE: i32 = 15
pub const ARMADILLO: i32 = 16
pub const VILLAGER: i32 = 17
pub const ENDERMITE: i32 = 18
pub const ENDER_DRAGON: i32 = 19

/// An armadillo's states, `ArmadilloState`, by their IDs (CAL-160).
pub const ARMADILLO_IDLE: i32 = 0
pub const ARMADILLO_ROLLING: i32 = 1
pub const ARMADILLO_SCARED: i32 = 2
pub const ARMADILLO_UNROLLING: i32 = 3

// What a brain's `findClosest` looks for, `world.mob`'s `find_closest`: a player, a grown one of
// its kind, or a partner; and `find_closest_of`'s, one of a kind, one of a mob category, or a
// hostile a villager fears (CAL-160).
const PICK_PLAYER: i32 = 0
const PICK_ADULT: i32 = 1
const PICK_PARTNER: i32 = 2
const PICK_SPECIES: i32 = 3
const PICK_CATEGORY: i32 = 4
const PICK_HOSTILE: i32 = 5
const PICK_BREEDABLE: i32 = 6

// `PoiManager.find` for `MoveThroughVillageGoal` (D605): the first point of interest of a
// village's types, taken, `IS_OCCUPIED`, within 10 of `at`, in `getInRange`'s order, that isn't
// one of those `visited`, `hasNotVisited`.
fn unvisited_poi(pois: Pois, at: BlockPos, visited: List<BlockPos>) -> BlockPos? {
    for r in pois.in_range(village_types(), at, 10, Occupancy.IsOccupied) {
        var seen = false
        for v in visited {
            if v.x == r.pos.x and v.y == r.pos.y and v.z == r.pos.z {
                seen = true
            }
        }
        if not seen {
            return some(r.pos)
        }
    }
    return none
}

// `VillagerHostilesSensor`'s distances, `ACCEPTABLE_DISTANCE_FROM_HOSTILES`: how near a mob of the
// kind `species` must be for a villager to fear it, of those Calcite makes, a zombie's and a zombie
// villager's 8; 0 for one it doesn't fear (CAL-160).
fn hostile_distance(species: i32) -> f64 {
    if species == ZOMBIE or species == ZOMBIE_VILLAGER {
        return 8.0
    }
    return 0.0
}

// `AcquirePoi.JitteredLinearRetry.markAttempt` at the game time `now`: tried then, and put off
// longer each try, 40 to 79 ticks more, drawn from the level's random, 400 at most.
fn mark_attempt(r: mut Retry, now: i64, random: mut TapedRandom) {
    r.previous = now
    let suggested = r.delay + random.next_int_below(40) + 40
    r.delay = if suggested < 400 { suggested } else { 400 }
    r.next = now + i64(r.delay)
}

// Whether the block at `pos` is a bed a villager may sleep in, `#villagers_can_sleep_on_bed`,
// that someone's in, its `OCCUPIED`; none where it's no such bed. A bed for `validateBedPoi` is
// one no one's in, and `ValidateNearbyPoi`'s bed taken one someone is (CAL-160).
fn bed_in_use<B: CollisionBlocks>(f: Facts, blocks: B, pos: BlockPos) -> bool? {
    let state = state_at(blocks, pos.x, pos.y, pos.z)
    if not f.tag(String("minecraft:villagers_can_sleep_on_bed")).contains(f.block(state)) {
        return none
    }
    return some(f.get_bool(state, String("occupied")))
}

// An insertion sort of `found` by distance, the nearest first, stable as `List.sort` is.
fn sort_nearest(found: mut List<(f64, i32)>) {
    for i in 1..found.len() {
        var j = i
        while j > 0 {
            let (a, _) = found[j - 1]
            let (c, _) = found[j]
            if a <= c {
                break
            }
            found.swap(j - 1, j)
            j -= 1
        }
    }
}

/// Where a kind's own values start, after an ageable mob's: a mooshroom's type, a sheep's wool, a
/// cow's and chicken's variant then sound variant, a pig's after its boost time, and a horse's and
/// donkey's flags, `DATA_ID_FLAGS`, then a horse's variant and markings and a donkey's chest; and
/// a slime's size.
pub const OWN: usize = 18

/// Where a monster's own values start, after `Mob`'s flags: a creeper's swell's direction, then
/// whether it's powered and ignited; a zombie's baby, special type and drowned conversion, and a
/// zombie villager's then its cure, villager data and whether that's final; a skeleton's stray
/// conversion; a spider's flags; an enderman's carried block, creepiness and being stared at; and
/// a witch's celebrating, then drinking.
pub const MONSTER_OWN: usize = 16

/// An ender dragon's phase, `EnderDragon.DATA_PHASE`, its own first value after `Mob`'s flags,
/// as it's no monster (D608).
pub const DRAGON_PHASE: usize = 16

/// How far from the nearest player a mob of `category` may be before it goes at once,
/// `MobCategory.getDespawnDistance`; and within how far it never goes, `getNoDespawnDistance`.
pub fn despawn_distance(category: i32) -> i32 {
    return if category == WATER_AMBIENT { 64 } else { 128 }
}

pub const NO_DESPAWN_DISTANCE: i32 = 32

/// A mob.
pub struct Mob {
    /// What every living entity has; its kind, and its type's category.
    pub living: Living
    pub species: i32
    pub category: i32
    /// Whether it must stay, and may pick up loot; how long it's done nothing; how long since its
    /// last ambient sound, `ambientSoundTime`, below 0 just after one, and its interval; and that
    /// sound, with how loud it's played, `getSoundVolume`.
    pub persistence_required: bool = false
    /// An endermite's ticks alive where it needn't stay, `life`, saved as `Lifetime` (D583).
    pub life: i32 = 0
    /// An ender dragon's own state, `world.dragon`'s, none for any other (D608).
    pub dragon: Dragon? = none
    pub can_pick_up_loot: bool = false
    pub no_action_time: i32 = 0
    pub ambient_sound_time: i32 = 0
    pub ambient_interval: i32 = 80
    pub ambient: String? = none
    pub sound_volume: f32 = 1.0f32
    /// Whether its type is allowed in peaceful, `isAllowedInPeaceful`, and it's an animal, `Animal`.
    pub peaceful_ok: bool = true
    pub animal: bool = false
    /// Whether it ages, and an ageable mob's age and forced age; an animal's love, `inLove`; and
    /// how many ticks more a baby fed older shows it, `forcedAgeTimer`, which isn't saved (D415).
    pub ageable: bool = false
    pub age: i32 = 0
    pub forced_age: i32 = 0
    pub forced_age_timer: i32 = 0
    pub in_love: i32 = 0
    /// A cow's, pig's or chicken's variant and sound variant, by their IDs in their registries,
    /// with its kind's variants' names and its sound variants; the variants it may spawn as where
    /// it's made, which `finalize_spawn` draws from; and a sheep's climate there, which its colors
    /// are drawn by.
    pub variant: i32 = 0
    pub sound_variant: i32 = 0
    variant_names: List<String> = List<String>()
    sounds: Sounds? = none
    spawn_variants: List<i32> = List<i32>()
    climate: i32 = 0
    /// A chicken's ticks until it lays, `eggTime`, and whether it's a jockey's mount.
    pub egg_time: i32 = 0
    pub jockey: bool = false
    /// A horse's or donkey's temper, and how long it's been eating, `eatingCounter`.
    pub temper: i32 = 0
    eating_counter: i32 = 0
    /// How many of its pack may spawn at a place, `getMaxSpawnClusterSize`.
    pub max_cluster: i32 = 4
    /// Whether it's a monster, `Monster`, and burns in daylight, `#burn_in_daylight` (CAL-156).
    pub monster: bool = false
    pub burns: bool = false
    /// A zombie's: whether it may break doors.
    pub can_break_doors: bool = false
    /// A zombie's or skeleton's conversion, `ConversionTracker`: how long it's been in water to its
    /// eyes or in powder snow, and how long until it converts once it's converting, which its
    /// values show.
    pub affliction_time: i32 = 0
    pub conversion_time: i32 = 0
    /// A creeper's swell, its fuse, `Fuse`, and its explosion's radius.
    pub swell: i32 = 0
    pub max_swell: i32 = 30
    pub explosion_radius: i32 = 3
    /// A slime's: whether it was on the ground as its last tick ended, `wasOnGround`.
    pub was_on_ground: bool = false
    /// An enderman's: the game time its anger ends, `persistentAngerEndTime`, 0 for none yet; and
    /// the time it has left angry, `AngerTime`, as it was saved before the end was, for its level
    /// to read as its game time plus it, `anger_from` (CAL-159).
    pub anger_end_time: i64 = 0
    pub legacy_anger: i32? = none
    /// A raider's, as a witch is: whether it leads a patrol and is patrolling, its raid's wave and
    /// whether it may join a raid.
    pub patrol_leader: bool = false
    pub patrolling: bool = false
    // A witch's ticks left drinking, `usingTime` (CAL-159).
    using_time: i32 = 0
    pub wave: i32 = 0
    pub can_join_raid: bool = false
    /// A zombie villager's: its villager experience, `villagerXp`; how long until it's cured where
    /// it's being cured; and the villager type the biome gives where it's made.
    pub villager_xp: i32 = 0
    pub cure_time: i32 = 0
    villager_type: i32 = 2
    /// A villager's (CAL-160): its gossip; its food, `foodLevel`; when it last restocked, how often
    /// today, and when its gossip last decayed; and the overworld's day it last looked at as it
    /// restocked, `lastRestockCheckDay`, which isn't saved.
    pub gossips: Gossips = Gossips()
    food_level: i32 = 0
    last_restock: i64 = 0
    restocks_today: i32 = 0
    last_gossip_decay: i64 = 0
    last_restock_check_day: i64 = 0
    /// A villager's inventory, its `SimpleContainer` of 8 slots, each stack as `ItemStack.CODEC`
    /// writes it, read from what it saved, `Inventory`, as it's first looked into with what's
    /// known of items, `inventory_read`, what it saved kept as it was till then (CAL-160).
    pub inventory: List<Tag?> = List<Tag?>()
    inventory_read: bool = false
    /// When a villager last gossiped with another, `lastGossipTime`, which isn't saved; and what
    /// its behaviors did to others this tick, which the level does once it's done (CAL-160).
    pub last_gossip: i64 = 0
    pub told: List<Told> = List<Told>()
    /// The player a villager's trading with, `tradingPlayer`, and the one it last traded with,
    /// whose trade it hears of as its AI steps, `lastTradedPlayer`, neither saved (CAL-160).
    pub trading: Trader? = none
    last_traded: (i64, i64)? = none
    /// Whether a behavior changed its profession in its brain's tick, so its brain's made again
    /// then and there, `refreshBrain` (CAL-160).
    refresh_due: bool = false
    /// Whether a behavior swung a door or broke a block, so its brain's tick stops for its level
    /// to do it, as vanilla does it then and there; and where its tick stopped, to go on from
    /// (CAL-160).
    stop_due: bool = false
    held_brain: HeldBrain? = none
    /// The biome it was made in, by its ID, for what its finalizing makes beside it.
    spawn_biome: i32 = -1
    /// Its size grown, and a baby's, `BABY_DIMENSIONS`.
    width: f32
    height: f32
    eyes: f32
    baby_width: f32
    baby_height: f32
    baby_eyes: f32
    /// Its navigation, `GroundPathNavigation`, and its controls: its move control, its look
    /// control, whether its jump control's to jump, and its body's turning (CAL-157).
    pub navigation: Navigation
    pub moves: MoveControl = MoveControl()
    /// Whether its AI ran its goals this tick, the rest of its AI to come, `think_after`
    /// (CAL-159).
    thought: bool = false
    pub look: LookControl = LookControl()
    pub jump: bool = false
    body_turn: BodyRotation = BodyRotation()
    /// Its goals, `goalSelector`; what it's found it can see this tick, `Sensing`; and a horse's
    /// count to the end of its standing, `standCounter` (CAL-158).
    pub goals: GoalSelector = GoalSelector()
    sensing: Sensing = Sensing()
    stand_counter: i32 = 0
    /// Its target goals, `targetSelector`; its target, by ID, `target`, which its goals read only
    /// where it's still one, `getTarget`; the one it last hurt and its tick count then,
    /// `lastHurtMob`; the target a `HurtByTargetGoal` of its alerts the mobs of its class near it
    /// to this tick, which its level does as its tick's done; its swing, `SwingState`, the ticks
    /// since it began and how long it is, -1 for none; and, as its tick began, what its main hand's
    /// attack swings as, `attack_animation`'s type by ID and its ticks, and whether it's a spear,
    /// `KINETIC_WEAPON`, its component kept, or reaches as its own, `ATTACK_RANGE`, its reach
    /// kept; and what its use of a spear asks of its level this tick, `damageEntities` (CAL-159).
    pub targets: GoalSelector = GoalSelector()
    pub target: i32? = none
    pub last_hurt_mob: i32? = none
    pub last_hurt_mob_stamp: i32 = 0
    pub alerted: i32? = none
    swing_ticks: i32 = 0
    swing_duration: i32 = -1
    attack_kind: i32 = 1
    attack_ticks: i32 = 6
    held_kinetic: bool = false
    held_range: bool = false
    held_spear: Kinetic? = none
    held_reach: Reach? = none
    pub stab_due: StabDue? = none
    /// Whether its level's game rule `mob_griefing` lets it break blocks, and whether
    /// `universal_anger` has it, where it's neutral and a player hurt it, angry at all players, as
    /// its level says before it ticks (CAL-159).
    pub mob_griefing: bool = true
    pub universal_anger: bool = false
    /// The mobs near it its goals look among for a parent or a partner, as its level found them
    /// for this tick where it may look, `wants_kin`, and whether its level's game rule `mob_drops`
    /// lets its breeding make an orb, as its level says before it ticks (CAL-158).
    pub kin: List<Kin> = List<Kin>()
    pub mob_drops: bool = true
    /// The level's game time this tick, as its level says before it ticks, which its panic reads
    /// its last hurt by (D416); and whether it's on hard, which a zombie hurt in its own tick
    /// draws for reinforcements on (D424).
    pub game_time: i64 = 0
    pub hard: bool = false
    /// The ID of the world's difficulty, which how far its paths may drop with a target reads
    /// (CAL-159).
    pub difficulty: i32 = 2
    /// An enderman's tick count as it last took up a target or let one go, `targetChangeTime`,
    /// and whom it's angry at, `persistentAngerTarget`, by UUID (CAL-159).
    target_change_time: i32 = 0
    pub anger_target: (i64, i64)? = none
    // Its movement speed's attribute, which an enderman's attacking speed goes on (CAL-159).
    speed_attribute: u32 = 0
    // Whether an enderman's hurt would have it teleport, which it does where it has its blocks, and
    // its level's floor as its tick began (CAL-159).
    teleport_due: bool = false
    /// Whether a projectile's hurt left it, an enderman, to dodge it, `repeatedlyTryToTeleport`, as
    /// its level does then (CAL-159).
    pub dodge_due: bool = false
    /// Its level's world border, its west, north, east and south edges, which hold the places it
    /// teleports to, as its level says before it ticks or teleports, none for the widest
    /// (CAL-159).
    pub border: (f64, f64, f64, f64)? = none
    // Whether a stop of its sleep is to get it up as its brain's tick goes on (CAL-160).
    wake_due: bool = false
    // The random `InsideBrownianWalk` shuffles the blocks around it with, which vanilla's draws
    // from `Collections`' own, seeded from the clock, and the rig's agent from one of each mob's
    // own seeded from its seed, as this is, made as it first shuffles (CAL-160).
    shuffle_random: LegacyRandom? = none
    floor_y: i32 = -64
    /// A skeleton's weapon goal it isn't using, kept with its state as `AbstractSkeleton` keeps
    /// both, `bowGoal` and `meleeGoal`, for its weapon goal's set to put back (CAL-159).
    spare_bow: Bow? = none
    spare_melee: Melee? = none
    /// A brain mob's brain, `Brain`, as its kind makes it, none for one that has goals; the level's
    /// random, which its behaviors draw their durations from, as its level lends it for its tick;
    /// the range its brain's sensors last set their targeting to, `TARGET_CONDITIONS`', which
    /// vanilla keeps for every brain, its follow range's, 16 so far; and the living entities its
    /// level found near it for its brain this tick, `near` (CAL-160).
    pub brain: Brain? = none
    pub level_random: TapedRandom? = none
    sensor_range: f64 = 16.0
    pub near: List<Near> = List<Near>()
    /// A villager's (CAL-160): the seed its gates' randoms are seeded from, its own random's,
    /// which its brain's made again with; the level's points of interest, as its level lends
    /// them for its tick; whether there are items its item sensor would look over; and the
    /// activities its level's schedules have this tick, a grown villager's and a baby's, and its
    /// dimension's name, as its level says before it ticks; and the overworld's day's count, as
    /// its level says then, which its restocks go by. The items near it, `near_items`, are those
    /// its item sensor looks over, in its box grown 32 across and 16 up and down, as
    /// `getEntitiesOfClass` finds them, and those its memories hold, gone or not.
    pub brain_seed: i64 = 0
    pub pois: Pois? = none
    pub near_items: List<Near> = List<Near>()
    pub villager_activity: i32 = 1
    pub baby_activity: i32 = 1
    pub dimension: String = String()
    pub day: i64 = 0
    /// An armadillo's ticks in its state, `inStateTicks`, and till it next sheds a scute,
    /// `scuteTime` (CAL-160).
    in_state_ticks: i64 = 0
    pub scute_time: i32 = 0
    /// What it was loaded with that Calcite doesn't run yet, by the keys it's saved under: its drop
    /// chances, leash, home, death loot table and seed, its love's cause, a mooshroom's stew
    /// effects, and a horse's owner and a donkey's chest's items.
    pub kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
}

impl Mob {
    /// A mooshroom of the type `kind` at x, y, z with its own random seeded `seed`, as
    /// `MushroomCow`'s constructor makes it: red, grown.
    pub fn mooshroom(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> Mob {
        let facts = MobFacts.vanilla(0, List<i32>(), List<i32>())
        return Mob.made(lf, facts, MOOSHROOM, kind, id, seed, x, y, z)
    }

    /// A mob of the kind `species` and the type `kind` at x, y, z with its own random seeded
    /// `seed`, as its constructor makes it: grown, of its default variants, and a chicken's ticks
    /// until it lays drawn from its own random after its turn, 6,000 to 11,999.
    pub fn made(lf: LivingFacts, facts: MobFacts, species: i32, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> Mob {
        let (w, h, eyes, bw, bh, beyes) = shape(species)
        // A zombie villager's profession is drawn from its own random as its values are defined,
        // `initializeZombieVillagerData`, any of `VILLAGER_PROFESSION`'s.
        let professions = if species == ZOMBIE_VILLAGER { i32.wrap(builtin_entries(24).len()) } else { 0 }
        let (l, profession) = Living.made_drawing(lf, kind, id, seed, x, y, z, w, h, eyes, data_of(species, facts), professions)
        // `PathNavigation`'s constructor reads its follow range's base, as many nodes a search as
        // 16 times that.
        let follow = l.attributes.base(lf.follow_range)
        if species == SLIME {
            // A cube mob, `AbstractCubeMob`: an ageable mob that's never a baby, `canBeABaby`, and
            // no monster, its sounds the hostile source's, of size 1 as it's made.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, peaceful_ok: false, sound_volume: 0.4f32, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.cube = true
            // `CubeMobMoveControl`'s way, made from its turn as it's made.
            mb.moves.cube_y_rot = 180.0f32 * mb.living.body.y_rot / 3.1415927f32
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == CREEPER or species == ZOMBIE or species == SKELETON or species == SPIDER or species == ENDERMAN or species == WITCH or species == ZOMBIE_VILLAGER or species == ENDERMITE {
            // A monster, `Monster`, its sounds the hostile source's.
            let burns = species == ZOMBIE or species == SKELETON or species == ZOMBIE_VILLAGER
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, peaceful_ok: false, monster: true, burns: burns, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.body.quiet_splash = some(String("entity.hostile.splash"))
            mb.living.small_fall = String("entity.hostile.small_fall")
            mb.living.big_fall = String("entity.hostile.big_fall")
            mb.living.swim = String("entity.hostile.swim")
            if species == ZOMBIE_VILLAGER {
                mb.living.data.redefine(MONSTER_OWN + 4, Value.Villager(PLAINS_VILLAGERS, profession, 1))
            }
            mb.living.magic_resistant = species == WITCH
            // An endermite's steps and swims emit game events but no sound,
            // `MovementEmission.EVENTS` (D583).
            mb.living.emits_sounds = species != ENDERMITE
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == ENDER_DRAGON {
            // `EnderDragon`, an enemy but no monster, its sounds the hostile source's, 5 loud,
            // `getSoundVolume`: fire immune, with no physics, `noPhysics`, its phase hovering and
            // so taking no knockback, through no portal, with no effects and its own death's tick
            // (D608).
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, sound_volume: 5.0f32, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes, dragon: some(Dragon.made()) }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.fire_immune = true
            mb.living.body.no_physics = true
            mb.living.knock_proof = true
            mb.living.uses_portals = false
            mb.living.takes_effects = false
            mb.living.own_death = true
            mb.refresh_sounds()
            return mb
        }
        if species == VILLAGER {
            // `AbstractVillager`, an ageable mob but no animal, of the misc category: its brain
            // made in `LivingEntity`'s constructor right after its turn's drawn, its sensors put
            // off by its random; and one that may pick up loot (CAL-160).
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MISC, ageable: true, can_pick_up_loot: true, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes, brain_seed: seed }
            mb.brain = some(mb.villager_brain())
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        let volume = if species == MOOSHROOM or species == COW { 0.4f32 } else { 1.0f32 }
        var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: CREATURE, ambient_interval: 120, sound_volume: volume, animal: true, ageable: true, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
        if species == ARMADILLO {
            // Its brain, made in `LivingEntity`'s constructor right after its turn's drawn, its
            // sensors put off by its random, `randomlyDelayStart`, its gates seeded from its own
            // seed; then its time till it sheds, its constructor's (CAL-160).
            mb.brain = some(Brain.made(armadillo_sensors(), armadillo_activities(seed), mut mb.living.body.random))
            mb.scute_time = mb.pick_scute_time()
        }
        if species == ZOMBIE_HORSE {
            // A monster by its category, burning in daylight, `#burn_in_daylight`.
            mb.category = MONSTER
            mb.burns = true
        }
        if mb.equine() {
            mb.ambient_interval = 400
            mb.sound_volume = 0.8f32
            mb.max_cluster = 6
            mb.living.step_by_block = true
        }
        if species == COW {
            mb.variant = facts.cow.default
            mb.variant_names = facts.cow.names.copy()
            mb.sound_variant = facts.cow_sounds.default
            mb.sounds = some(facts.cow_sounds.copy())
        } else if species == PIG {
            mb.variant = facts.pig.default
            mb.variant_names = facts.pig.names.copy()
            mb.sound_variant = facts.pig_sounds.default
            mb.sounds = some(facts.pig_sounds.copy())
        } else if species == CHICKEN {
            mb.variant = facts.chicken.default
            mb.variant_names = facts.chicken.names.copy()
            mb.sound_variant = facts.chicken_sounds.default
            mb.sounds = some(facts.chicken_sounds.copy())
            mb.living.fall_immune = true
            mb.egg_time = mb.living.body.random.next_int_below(6000) + 6000
        }
        mb.refresh_sounds()
        mb.navigate_as_kind(lf)
        return mb
    }

    // What its kind's constructor makes of its navigation: an animal's malus beside fire 16 and in
    // it -1, `Animal`'s; a chicken's in water 0 and an enderman's -1; and floating, which
    // `FloatGoal` and a cube mob's float goal turn on as `registerGoals` makes them, for all but
    // the zombies and skeletons. And its movement speed's attribute kept, for an enderman's target.
    fn navigate_as_kind(mut self, lf: LivingFacts) {
        if self.animal or self.species == VILLAGER {
            // An animal's, `Animal`'s constructor, and a villager's, `AbstractVillager`'s.
            self.navigation.maluses[usize(PATH_FIRE_IN_NEIGHBOR)] = 16.0f32
            self.navigation.maluses[usize(PATH_FIRE)] = -1.0f32
        }
        if self.species == VILLAGER {
            // `Villager`'s constructor: it opens doors, floats, and finds paths at least 48 long
            // (CAL-160).
            self.navigation.can_open_doors = true
            self.navigation.set_required_length(48.0f32)
        }
        if self.species == CHICKEN {
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
        } else if self.species == ENDERMAN {
            self.navigation.maluses[usize(PATH_WATER)] = -1.0f32
        }
        self.navigation.can_float = not (self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER or self.species == SKELETON)
        self.speed_attribute = lf.movement_speed
        if self.species == SPIDER {
            // A spider's `WallClimberNavigation`, and its climbing by its flags (CAL-159).
            self.navigation.climber = true
            self.living.climber = true
        }
        self.register_goals()
    }

    // `registerGoals`, as its kind's constructor makes them on a server, in their order, with their
    // priorities, controls and speeds, a skeleton's as `AbstractSkeleton`'s, its weapon goal, a
    // `MeleeAttackGoal` as it holds nothing yet, after them (CAL-159); a cow's and mooshroom's,
    // `AbstractCow`'s; a pig's, tempted by a carrot on a stick and by its food; a sheep's, eating
    // among them; a chicken's; a horse's or donkey's, `AbstractHorse`'s then `addBehaviourGoals`; a
    // zombie horse's, its own behaviour goals; a zombie's and zombie villager's, `Zombie`'s, then
    // `addBehaviourGoals`, its target goals among them (CAL-159). The other monsters' come with
    // CAL-159.
    fn register_goals(mut self) {
        let s = self.species
        if s == ZOMBIE or s == ZOMBIE_VILLAGER {
            self.goals.add(4, FLAG_MOVE | FLAG_JUMP, true, Goal.RemoveBlock(RemoveBlock { block: String("minecraft:turtle_egg"), speed: 1.0, vertical: 3 }))
            self.goals.add(8, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(8, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, false, Goal.SpearUse(SpearUse()))
            self.goals.add(3, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: false, zombie: true }))
            self.goals.add(6, FLAG_MOVE, false, Goal.ThroughVillage(ThroughVillage { speed: 1.0, only_at_night: true, distance_to_poi: 4, poi: BlockPos { x: 0, y: 0, z: 0 } }))
            self.add_stroll(7, 1.0)
            // `HurtByTargetGoal(this).setAlertOthers(ZombifiedPiglin.class)`, then those that look
            // for players, seen; villagers, unseen; iron golems, seen; and baby turtles on land,
            // seen, one in ten tries.
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true } }))
            self.add_seek(2, SEEK_PLAYER, 10, true)
            self.add_seek(3, SEEK_VILLAGER, 10, false)
            self.add_seek(3, SEEK_GOLEM, 10, true)
            self.add_seek(5, SEEK_TURTLE, 10, true)
            return
        }
        if s == SKELETON {
            self.goals.add(2, 0, false, Goal.RestrictSun(0))
            self.goals.add(3, FLAG_MOVE, false, Goal.FleeSun(FleeSun { speed: 1.0 }))
            self.goals.add(3, FLAG_MOVE, false, Goal.Later(LATER_AVOID_WOLF))
            self.add_stroll(5, 1.0)
            self.goals.add(6, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(6, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: false, targeting: Targeting { must_see: true } }))
            self.add_seek(2, SEEK_PLAYER, 10, true)
            self.add_seek(3, SEEK_GOLEM, 10, true)
            self.add_seek(3, SEEK_TURTLE, 10, true)
            self.reassess_weapon(false)
            return
        }
        if s == ENDERMAN {
            // `Enderman.registerGoals`: its stroll always to a place on land, and its target goals
            // the player who stares at it or that it's angry at, the one who hurt it, endermites,
            // and its universal anger's reset.
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_JUMP | FLAG_MOVE, false, Goal.Freeze(-1))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: false, zombie: false }))
            self.goals.add(7, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: 1.0, probability: 0.0f32 }))
            self.goals.add(8, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(8, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.goals.add(10, 0, false, Goal.LeaveBlock(0))
            self.goals.add(11, 0, false, Goal.TakeBlock(0))
            self.targets.add(1, FLAG_TARGET, false, Goal.EnderLook(EnderLook { targeting: Targeting { must_see: false } }))
            self.targets.add(2, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: false, targeting: Targeting { must_see: true } }))
            self.add_seek(3, SEEK_ENDERMITE, 10, true)
            self.targets.add(4, 0, false, Goal.ResetAnger(0))
            return
        }
        if s == SLIME {
            // `AbstractCubeMob.registerGoals`, a slime's: floating in liquids at 1, turning a way
            // of its own at 4 and keeping on jumping at 5, then its attack at 2; its target goals
            // players seen within 4 blocks up or down, then iron golems seen.
            self.goals.add(1, FLAG_JUMP | FLAG_MOVE, true, Goal.CubeFloat(0))
            self.goals.add(4, FLAG_LOOK, false, Goal.CubeDirection((0.0f32, 0)))
            self.goals.add(5, FLAG_JUMP | FLAG_MOVE, false, Goal.CubeJumping(0))
            self.goals.add(2, FLAG_LOOK, true, Goal.CubeAttack(0))
            self.targets.add(1, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_PLAYER, interval: reduced_tick_delay(10), targeting: Targeting { must_see: true }, max_dy: 4.0 }))
            self.add_seek(3, SEEK_GOLEM, 10, true)
            return
        }
        if s == WITCH {
            // `Witch.registerGoals`, after `Raider`'s and `PatrollingMonster`'s: the patrol's walk
            // at 4, and the raid's banner, path, village and celebration goals at 1, 3, 4 and 5,
            // which wait for patrols and raids; then floating at 1, its `RangedAttackGoal` at 2,
            // every 3 seconds from within 10 blocks, the stroll at 2, and looking at players and
            // about at 3. Its target goals the one who hurt it, not a raider; then the raiders it'd
            // heal, which a raid needs; then players seen, `NearestAttackableWitchTargetGoal`,
            // which may always attack while its healing's cooldown is out, as it always is without
            // raids.
            self.goals.add(4, FLAG_MOVE, false, Goal.Later(LATER_PATROL))
            self.goals.add(1, FLAG_MOVE, false, Goal.Later(LATER_RAID))
            self.goals.add(3, FLAG_MOVE, false, Goal.Later(LATER_RAID))
            self.goals.add(4, FLAG_MOVE, false, Goal.Later(LATER_RAID))
            self.goals.add(5, FLAG_MOVE, false, Goal.Later(LATER_RAID))
            self.goals.add(1, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, true, Goal.Ranged(Ranged { speed: 1.0, interval_min: 60, interval_max: 60, radius: 10.0f32 }))
            self.add_stroll(2, 1.0)
            self.goals.add(3, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(3, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: false, targeting: Targeting { must_see: true } }))
            self.targets.add(2, FLAG_TARGET, false, Goal.HealRaider(0))
            self.add_seek(3, SEEK_PLAYER, 10, true)
            return
        }
        if s == CREEPER {
            // `Creeper.registerGoals`: its `SwellGoal` at 2, before the rest, and its target goals
            // players seen first, then the one who hurt it.
            self.goals.add(1, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(2, FLAG_MOVE, true, Goal.Swell(-1))
            self.goals.add(3, FLAG_MOVE, false, Goal.Later(LATER_AVOID_OCELOT))
            self.goals.add(3, FLAG_MOVE, false, Goal.Later(LATER_AVOID_CAT))
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: false, zombie: false }))
            self.add_stroll(5, 0.8)
            self.goals.add(6, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(6, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.add_seek(1, SEEK_PLAYER, 10, true)
            self.targets.add(2, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: false, targeting: Targeting { must_see: true } }))
            return
        }
        if s == ENDERMITE {
            // `Endermite.registerGoals` (D583): floating and climbing powder snow at 1, its
            // attack at 2 not following its target unseen, its stroll away from water at 3, and
            // looking at players and about; its target goals the one who hurt it, alerting the
            // endermites near it, then players seen.
            self.goals.add(1, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_JUMP, true, Goal.Later(LATER_POWDER_SNOW))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: false, zombie: false }))
            self.add_stroll(3, 1.0)
            self.goals.add(7, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(8, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true } }))
            self.add_seek(2, SEEK_PLAYER, 10, true)
            return
        }
        if s == SPIDER {
            // `Spider.registerGoals`, its attack goal a `MeleeAttackGoal` that follows its target
            // unseen, its target goals for players and iron golems ones that don't in the light.
            self.goals.add(1, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(2, FLAG_MOVE, false, Goal.Later(LATER_AVOID_ARMADILLO))
            self.goals.add(3, FLAG_JUMP | FLAG_MOVE, false, Goal.Leap(0.4f32))
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: true, zombie: false }))
            self.add_stroll(5, 0.8)
            self.goals.add(6, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(6, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: false, targeting: Targeting { must_see: true } }))
            self.add_seek(2, SEEK_PLAYER, 10, true)
            self.add_seek(3, SEEK_GOLEM, 10, true)
            return
        }
        if s == COW or s == MOOSHROOM or s == CHICKEN {
            let chicken = s == CHICKEN
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: if chicken { 1.4 } else { 2.0 } }))
            self.add_breed(2)
            if chicken {
                self.add_tempt(3, TEMPT_CHICKEN, 1.0)
                self.add_follow(4, 1.1)
            } else {
                self.add_tempt(3, TEMPT_COW, 1.25)
                self.add_follow(4, 1.25)
            }
            self.add_stroll(5, 1.0)
            self.add_looks(6)
        } else if s == PIG {
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.25 }))
            self.add_breed(3)
            self.add_tempt(4, TEMPT_PIG_STICK, 1.2)
            self.add_tempt(4, TEMPT_PIG, 1.2)
            self.add_follow(5, 1.1)
            self.add_stroll(6, 1.0)
            self.add_looks(7)
        } else if s == SHEEP {
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.25 }))
            self.add_breed(2)
            self.add_tempt(3, TEMPT_SHEEP, 1.1)
            self.add_follow(4, 1.1)
            self.goals.add(5, FLAG_MOVE | FLAG_LOOK | FLAG_JUMP, false, Goal.EatBlock(EatBlock()))
            self.add_stroll(6, 1.0)
            self.add_looks(7)
        } else if self.equine() {
            self.goals.add(1, FLAG_MOVE, false, Goal.Later(LATER_RUN_AROUND))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, false, Goal.Later(LATER_BREED))
            self.add_follow(4, 1.0)
            self.add_stroll(6, 0.7)
            self.add_looks(7)
            // `RandomStandGoal`, its count from minus its ambient interval as it's made.
            self.goals.add(9, 0, true, Goal.Stand(Stand { next: -self.ambient_interval }))
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            if s == ZOMBIE_HORSE {
                self.add_tempt(3, TEMPT_ZOMBIE_HORSE, 1.25)
            } else {
                self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.2 }))
                self.add_tempt(3, TEMPT_HORSE, 1.25)
            }
        }
    }

    /// `AbstractSkeleton.reassessWeaponGoal`, on hard where `hard` (CAL-159): its weapon goal taken
    /// out, stopped where it ran and kept aside; then, at 4 after its other goals, its
    /// `RangedBowAttackGoal` where it holds a bow, as `getWeaponHoldingHand` finds it, at 1, 15
    /// blocks, its least ticks between shots 20 on hard and 40 else, or else its
    /// `MeleeAttackGoal`, at 1.2, aggressive as it runs; each with the state it was kept with.
    pub fn reassess_weapon(mut self, hard: bool) {
        if self.species != SKELETON {
            return
        }
        if let taken = self.goals.take_weapon_goal() {
            let (g, ran) = taken
            match g {
                Goal.Bow(b) => {
                    var s = b
                    if ran {
                        self.set_flag(AGGRESSIVE_FLAG, false)
                        s.see_time = 0
                        s.attack_time = -1
                        self.living.stop_using()
                    }
                    self.spare_bow = some(s)
                },
                Goal.Melee(held) => {
                    if ran {
                        self.set_flag(AGGRESSIVE_FLAG, false)
                        self.navigation.stop()
                    }
                    self.spare_melee = some(held)
                },
                _ => {},
            }
        }
        if self.holding_bow() {
            var b = self.spare_bow.take() ?? Bow { speed: 1.0, interval: 20, radius_sqr: 225.0f32 }
            b.interval = if hard { 20 } else { 40 }
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Bow(b))
        } else {
            let ml = self.spare_melee.take() ?? Melee { speed: 1.2, follow_unseen: false, zombie: false }
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(ml))
        }
    }

    // Whether it holds a bow in either hand, `isHolding(Items.BOW)`, and in its main hand,
    // `getWeaponHoldingHand` (CAL-159).
    fn holding_bow(self) -> bool {
        return self.main_is_bow() or held_name(self.living.equipment[1]) == "minecraft:bow"
    }

    fn main_is_bow(self) -> bool {
        return held_name(self.living.equipment[0]) == "minecraft:bow"
    }

    // `NearestAttackableTargetGoal` at `priority` in its target goals, looking for the `SEEK_` kind
    // `seek` one in `interval` of its tries, halved, `reducedTickDelay`, keeping only a target it
    // sees where `must_see` (CAL-159).
    fn add_seek(mut self, priority: i32, seek: i32, interval: i32, must_see: bool) {
        self.targets.add(priority, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: seek, interval: reduced_tick_delay(interval), targeting: Targeting { must_see: must_see } }))
    }

    // `TemptGoal` at `priority`, toward a player holding what's in the set `bit`, at `speed`, not
    // scared off.
    fn add_tempt(mut self, priority: i32, bit: u32, speed: f64) {
        self.goals.add(priority, FLAG_MOVE | FLAG_LOOK, false, Goal.Tempt(Tempt { bit: bit, speed: speed }))
    }

    // `BreedGoal` at `priority`, at 1, for a partner of its own kind.
    fn add_breed(mut self, priority: i32) {
        self.goals.add(priority, FLAG_MOVE | FLAG_LOOK, false, Goal.Breed(Breed { speed: 1.0 }))
    }

    // `FollowParentGoal` at `priority`, at `speed`, taking no controls.
    fn add_follow(mut self, priority: i32, speed: f64) {
        self.goals.add(priority, 0, false, Goal.FollowParent(FollowParent { speed: speed }))
    }

    /// Whether its brain's item sensor looks over the items near it, `NearestItemSensor`, which
    /// its level tells it are there, `items_near`: a villager's (CAL-160).
    pub fn wants_items(self) -> bool {
        return self.species == VILLAGER
    }

    /// Whether its goals may look among the mobs near it this tick, which its level finds for it,
    /// `kin`: a baby's of a kind that follows its parents, and one's in love or breeding (CAL-158).
    pub fn wants_kin(self) -> bool {
        let s = self.species
        let follows = s == COW or s == MOOSHROOM or s == PIG or s == CHICKEN or s == SHEEP or self.equine()
        return follows and (self.age < 0 or self.in_love > 0 or self.goals.breeding())
    }

    /// What a baby of its breeding takes of it, `Kin.variant`: a cow's, pig's or chicken's variant,
    /// a mooshroom's type or a sheep's wool's colour, by their IDs.
    pub fn breed_variant(self) -> i32 {
        let s = self.species
        if s == MOOSHROOM {
            return self.living.data.number(MOOSHROOM_TYPE)
        }
        if s == SHEEP {
            return self.color()
        }
        return self.variant
    }

    /// A baby of breeding's variant set, `setVariant`, as `breed_variant` has it.
    pub fn set_breed_variant(mut self, v: i32) {
        let s = self.species
        if s == MOOSHROOM {
            self.living.data.set(MOOSHROOM_TYPE, Value.Number(v))
        } else if s == SHEEP {
            self.set_color(v)
        } else if s == COW or s == PIG or s == CHICKEN {
            self.set_variant(v)
        }
    }

    /// Its partner's part of `finalizeSpawnChildFromBreeding`: 6000 ticks from breeding again,
    /// `setAge`, and out of love, `resetLove`.
    pub fn bred_again(mut self) {
        self.set_age(6000)
        self.in_love = 0
    }

    // `WaterAvoidingRandomStrollGoal` at `priority`, at `speed`.
    fn add_stroll(mut self, priority: i32, speed: f64) {
        self.goals.add(priority, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: speed }))
    }

    // `LookAtPlayerGoal` within 6 at `priority`, then `RandomLookAroundGoal` after it.
    fn add_looks(mut self, priority: i32) {
        self.goals.add(priority, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 6.0f32 }))
        self.goals.add(priority + 1, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
    }

    /// Where natural spawning makes it, in the biome `biome`: the variants it may spawn as there,
    /// `VariantUtils.selectVariantToSpawn`'s, and a sheep's climate, which `finalize_spawn` draws
    /// by.
    pub fn spawning_in(mut self, facts: MobFacts, biome: i32) {
        self.spawn_biome = biome
        if self.species == COW {
            self.spawn_variants = facts.cow.spawnable(biome)
        } else if self.species == PIG {
            self.spawn_variants = facts.pig.spawnable(biome)
        } else if self.species == CHICKEN {
            self.spawn_variants = facts.chicken.spawnable(biome)
        }
        self.climate = facts.climate(biome)
        self.villager_type = facts.villager_type(biome)
    }

    /// Its flags, `DATA_MOB_FLAGS_ID`, and whether it's without AI, `isNoAi`, and left-handed.
    pub fn flags(self) -> i32 {
        return i32(self.living.data.byte(MOB_FLAGS))
    }

    pub fn no_ai(self) -> bool {
        return self.flags() & NO_AI_FLAG != 0
    }

    pub fn left_handed(self) -> bool {
        return self.flags() & LEFT_HANDED_FLAG != 0
    }

    fn set_flag(mut self, bit: i32, on: bool) {
        self.living.data.set_flag(MOB_FLAGS, bit, on)
    }

    /// A cow's, pig's or chicken's variant, set and synced.
    pub fn set_variant(mut self, id: i32) {
        self.variant = id
        let at = if self.species == PIG { OWN + 1 } else { OWN }
        self.living.data.set(at, Value.Number(id))
    }

    /// Its sound variant, set and synced, its sounds with it.
    pub fn set_sound_variant(mut self, id: i32) {
        self.sound_variant = id
        let at = if self.species == PIG { OWN + 2 } else { OWN + 1 }
        self.living.data.set(at, Value.Number(id))
        self.refresh_sounds()
    }

    /// A horse's or donkey's flag `bit`, `getFlag`: 2 tame, 8 bred, 16 eating, 32 standing and 64
    /// its mouth open; and set, `setFlag`.
    pub fn horse_flag(self, bit: i32) -> bool {
        return i32(self.living.data.byte(OWN)) & bit != 0
    }

    pub fn set_horse_flag(mut self, bit: i32, on: bool) {
        let flags = i32(self.living.data.byte(OWN))
        let next = if on { flags | bit } else { flags & ~bit }
        self.living.data.set(OWN, Value.Byte(i8.wrap(next)))
    }

    /// A horse's variant and markings, `getTypeVariant`, its variant's ID in the low byte and its
    /// markings' above.
    pub fn horse_variant(self) -> i32 {
        return self.living.data.number(OWN + 1)
    }

    /// A sheep's wool's color, by its ID, `setColor`, kept shorn or not.
    pub fn set_color(mut self, color: i32) {
        let wool = i32(self.living.data.byte(OWN))
        self.living.data.set(OWN, Value.Byte(i8.wrap((wool & 240) | (color & 15))))
    }

    /// A sheep's wool's color's ID, and whether it's shorn.
    pub fn color(self) -> i32 {
        return i32(self.living.data.byte(OWN)) & 15
    }

    pub fn sheared(self) -> bool {
        return i32(self.living.data.byte(OWN)) & 16 != 0
    }

    // Its ambient and step sounds, `getSoundSet`'s for its sound variant, a baby's where it's one;
    // a monster's its kind's, a creeper's none and the block's steps; a slime's none and the
    // block's steps.
    fn refresh_sounds(mut self) {
        if self.species == ENDER_DRAGON {
            // `EnderDragon.getAmbientSound`; it never steps, as it never travels (D608).
            self.ambient = some(String("entity.ender_dragon.ambient"))
            self.living.own_step = none
            return
        }
        if self.species == SLIME {
            self.ambient = none
            self.living.own_step = none
            return
        }
        if self.monster {
            let (ambient, step) = if self.species == ZOMBIE { ("entity.zombie.ambient", "entity.zombie.step") } else if self.species == ZOMBIE_VILLAGER { ("entity.zombie_villager.ambient", "entity.zombie_villager.step") } else if self.species == SKELETON { ("entity.skeleton.ambient", "entity.skeleton.step") } else if self.species == ENDERMITE { ("entity.endermite.ambient", "entity.endermite.step") } else { ("entity.spider.ambient", "entity.spider.step") }
            if self.species == CREEPER {
                self.ambient = none
                self.living.own_step = none
            } else if self.species == ENDERMAN or self.species == WITCH {
                // Not creepy, an enderman's ambient sound isn't its scream; each steps as the block.
                self.ambient = some(String(if self.species == ENDERMAN { "entity.enderman.ambient" } else { "entity.witch.ambient" }))
                self.living.own_step = none
            } else {
                self.ambient = some(String(ambient))
                self.living.own_step = some(String(step))
            }
            return
        }
        if self.equine() {
            let baby = self.baby()
            self.ambient = some(String(if self.species == DONKEY { "entity.donkey.ambient" } else if self.species == ZOMBIE_HORSE { "entity.zombie_horse.ambient" } else if baby { "entity.baby_horse.ambient" } else { "entity.horse.ambient" }))
            self.living.own_step = some(String(if baby { "entity.baby_horse.step" } else { "entity.horse.step" }))
            return
        }
        if self.species == VILLAGER {
            // `Villager.getAmbientSound`: none while it sleeps, else a trade's while it trades;
            // the block's steps (CAL-160).
            self.ambient = if self.living.sleeping != none { none } else { some(String(if self.trading != none { "entity.villager.trade" } else { "entity.villager.ambient" })) }
            self.living.own_step = none
            return
        }
        if self.species == ARMADILLO {
            // `Armadillo.getAmbientSound`: none while it's scared (CAL-160).
            self.ambient = if self.scared() { none } else { some(String("entity.armadillo.ambient")) }
            self.living.own_step = some(String("entity.armadillo.step"))
            return
        }
        if self.species == SHEEP {
            self.ambient = some(String("entity.sheep.ambient"))
            self.living.own_step = some(String("entity.sheep.step"))
            return
        }
        var chosen: SoundSet? = none
        if let s = self.sounds {
            chosen = some(s.set_of(self.sound_variant, self.baby()))
        }
        if let set = chosen {
            self.ambient = some(set.ambient.copy())
            self.living.own_step = some(set.step.copy())
            return
        }
        self.ambient = some(String("entity.cow.ambient"))
        self.living.own_step = some(String("entity.cow.step"))
    }

    /// Whether it may go where the nearest player is `d` blocks squared away, `removeWhenFarAway`:
    /// an animal never does; a zombie villager only where it isn't being cured and has no
    /// experience; a witch only where it isn't patrolling, or past 128 blocks; and a zombie horse
    /// always.
    pub fn removed_far_away(self, d: f64) -> bool {
        if self.species == ZOMBIE_HORSE {
            return true
        }
        if self.species == ZOMBIE_VILLAGER {
            return not self.living.data.flag(MONSTER_OWN + 3) and self.villager_xp == 0
        }
        if self.species == WITCH {
            return not self.patrolling or d > 16384.0
        }
        if self.species == VILLAGER {
            return false
        }
        return not self.animal
    }

    /// Whether it's a horse, `AbstractHorse`: a horse, a donkey or a zombie horse.
    pub fn equine(self) -> bool {
        return self.species == HORSE or self.species == DONKEY or self.species == ZOMBIE_HORSE
    }

    /// `requiresCustomPersistence`: an enderman carrying a block stays.
    pub fn custom_persistence(self) -> bool {
        return self.carried() != none
    }

    /// The block an enderman carries, `getCarriedBlock`, by its state, or none (CAL-159).
    pub fn carried(self) -> u32? {
        if self.species != ENDERMAN {
            return none
        }
        let n = self.living.data.number(MONSTER_OWN)
        return if n == 0 { none } else { some(u32.wrap(n)) }
    }

    /// An enderman's legacy anger, `AngerTime` saved where its end isn't, read as it's loaded at
    /// the game time `now`: its anger ends at `now` plus it, `setTimeToRemainAngry` (CAL-159).
    pub fn anger_from(mut self, now: i64) {
        if let t = self.legacy_anger {
            self.anger_end_time = now + i64(t)
            self.legacy_anger = none
        }
    }

    /// An enderman's carried block set to `state`, `setCarriedBlock`, shown to those who see it,
    /// and kept as it's saved, `tag`, its `carriedBlockState`, none for none (CAL-159).
    pub fn set_carried(mut self, state: u32?, tag: Tag?) {
        match state {
            some(s) => self.living.data.set(MONSTER_OWN, Value.Number(i32.wrap(s))),
            none => self.living.data.set(MONSTER_OWN, Value.Empty),
        }
        _ = self.kept.remove(String("carriedBlockState"))
        if let t = tag {
            self.kept.insert(String("carriedBlockState"), t.copy())
        }
    }

    /// `isPushable` (CAL-156), its chunk ticking its entities as `ticking` says: a horse, donkey or
    /// zombie horse unless something rides it, `AbstractHorse`'s, which nothing does yet; another
    /// in a chunk that ticks, alive and not on what's climbable, `onClimbable`, a spider where it's
    /// climbing, `Spider`'s.
    pub fn pushable<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, ticking: bool) -> bool {
        if self.equine() {
            return true
        }
        if not ticking or not self.living.alive() {
            return false
        }
        if self.species == SPIDER {
            return i32(self.living.data.byte(MONSTER_OWN)) & 1 == 0
        }
        return not self.living.on_climbable(lf, f, blocks)
    }

    /// `checkDespawn` in a chunk that ticks entities, in peaceful where `peaceful`, with the
    /// nearest player that isn't a spectator `nearest` blocks squared away, if there's one:
    /// whether it goes, `discard`. Its chance after 600 ticks doing nothing is drawn from its own
    /// random only where it needn't stay.
    pub fn check_despawn(mut self, peaceful: bool, nearest: f64?) -> bool {
        if self.species == ENDER_DRAGON {
            // `EnderDragon.checkDespawn`, which does nothing (D608).
            return false
        }
        if peaceful and not self.peaceful_ok {
            return true
        }
        let d = nearest else return false
        let stays = self.persistence_required or self.custom_persistence()
        let far = despawn_distance(self.category)
        if not stays and d > f64(far * far) and self.removed_far_away(d) {
            return true
        }
        let near = f64(NO_DESPAWN_DISTANCE * NO_DESPAWN_DISTANCE)
        if not stays and self.no_action_time > 600 and self.living.body.random.next_int_below(800) == 0 and d > near and self.removed_far_away(d) {
            return true
        }
        if d < near {
            self.no_action_time = 0
        }
        return false
    }

    /// Whether it's a baby, `isBaby`: an ageable one whose age is below 0, or a zombie or zombie
    /// villager whose values say so.
    pub fn baby(self) -> bool {
        if self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER {
            return self.living.data.flag(BABY)
        }
        return self.ageable and self.age < 0
    }

    // `refreshDimensions`: its size a sleeper's, 0.2 by 0.2, its eyes 0.2 up, `SLEEPING_DIMENSIONS`
    // (CAL-160), or a baby's or grown, as it is.
    fn refresh_size(mut self) {
        if self.living.sleeping != none {
            self.living.body.width = 0.2f32
            self.living.body.height = 0.2f32
            self.living.body.eyes = 0.2f32
            return
        }
        let baby = self.baby()
        self.living.body.width = if baby { self.baby_width } else { self.width }
        self.living.body.height = if baby { self.baby_height } else { self.height }
        self.living.body.eyes = if baby { self.baby_eyes } else { self.eyes }
    }

    /// `Zombie.setBaby`: a baby or not in its values, its speed's `minecraft:baby` modifier, half
    /// again on its base, on a baby only, and its size made again.
    pub fn set_zombie_baby(mut self, on: bool) {
        self.living.data.set(BABY, Value.Bool(on))
        let speed = attribute("movement_speed")
        if on {
            self.living.attributes.replace(speed, Modifier { id: Identifier { namespace: "minecraft", path: "baby" }, amount: 0.5, operation: ADD_MULTIPLIED_BASE })
        } else {
            self.living.attributes.take_off(speed, Identifier { namespace: "minecraft", path: "baby" })
        }
        self.refresh_size()
    }

    /// `AgeableMob.setAge`: its age, and whether it's a baby where that crosses 0, its size made
    /// again, `refreshDimensions`, as `onSyncedDataUpdated` makes it, and its sounds.
    pub fn set_age(mut self, age: i32) {
        let old = self.age
        self.age = age
        if (old < 0 and age >= 0) or (old >= 0 and age < 0) {
            self.living.data.set(BABY, Value.Bool(age < 0))
            self.refresh_size()
            self.refresh_sounds()
            if self.species == VILLAGER {
                // `Villager.ageBoundaryReached`: its brain made again (CAL-160).
                self.refresh_brain()
            }
        }
    }

    /// A slime's size, `getSize`.
    pub fn slime_size(self) -> i32 {
        return self.living.data.number(OWN)
    }

    /// `AbstractCubeMob.setSize`, with `Slime`'s: its size, from 1 to 127, in its values, and where
    /// that changes it, turned as its head is, `onSyncedDataUpdated`; 0.52 across and high by its
    /// size and its eyes 0.325, `refreshDimensions`, where it stands; its most health its size
    /// squared, its speed 0.2 and a tenth of its size, its attack its size; its sounds 0.4 as loud
    /// by its size; and its health its most where `heal`. In water as its size changes, vanilla's
    /// splashes 1 in 20 by its own random, `doWaterSplashEffect`, which never comes here: its size
    /// is set only as it's made, loaded or split, before it's ever looked for water,
    /// `wasTouchingWater`, and a command that sets one's size in the world, which would, isn't in
    /// yet (CAL-159).
    pub fn set_slime_size(mut self, size: i32, heal: bool) {
        let actual = if size < 1 { 1 } else if size > 127 { 127 } else { size }
        if actual != self.slime_size() {
            self.living.data.set(OWN, Value.Number(actual))
            let head = self.living.y_head_rot
            self.living.body.y_rot = head
            self.living.y_body_rot = head
        }
        let scale = f32.nearest(actual)
        self.width = 0.52f32 * scale
        self.height = 0.52f32 * scale
        self.eyes = 0.325f32 * scale
        self.baby_width = self.width
        self.baby_height = self.height
        self.baby_eyes = self.eyes
        self.refresh_size()
        self.set_base("minecraft:max_health", f64(actual * actual))
        self.set_base("minecraft:movement_speed", f64(0.2f32 + 0.1f32 * scale))
        self.set_base("minecraft:attack_damage", f64(actual))
        self.sound_volume = 0.4f32 * scale
        if heal {
            let most = attribute("max_health")
            self.living.data.set(HEALTH, Value.Float(f32.nearest(self.living.attributes.value(most))))
        }
    }

    /// `finalizeSpawn` as natural spawning finalizes it at `o`, with `given` its pack's group so
    /// far, drawing from `r`, the level's random, what it makes besides it made by `maker`: a
    /// cow's, pig's or chicken's variant, one of those it may spawn as, and its sound variant, any;
    /// a sheep's color; then an ageable mob's group made where there's none, and each after the
    /// first a baby by its chance; then `Mob`'s, its follow range's random spawn bonus where it
    /// hasn't one and whether it's left-handed; a monster's after `Mob`'s, and a slime's. The
    /// group, for the next.
    pub fn finalize_spawn<R: RandomSource, K: Making>(mut self, given: own SpawnGroup?, o: Occasion, maker: mut K, r: mut R) -> SpawnGroup? {
        if self.monster {
            return self.finalize_monster(given, o, mut maker, mut r)
        }
        if self.species == SLIME {
            return self.finalize_slime(given, o, mut r)
        }
        if self.species == COW or self.species == PIG or self.species == CHICKEN {
            let choices = self.spawn_variants.copy()
            if not choices.is_empty() {
                let pick = r.next_int_below(i32.wrap(choices.len()))
                self.set_variant(choices[usize.wrap(pick)])
            }
            var count = 0
            if let s = self.sounds {
                count = i32.wrap(s.variants.len())
            }
            if count > 0 {
                let sound = r.next_int_below(count)
                self.set_sound_variant(sound)
            }
        } else if self.species == SHEEP {
            let color = sheep_color(self.climate, mut r)
            self.set_color(color)
        }
        var group = given
        if self.species == HORSE {
            // `Horse.finalizeSpawn`: the pack's variant, drawn for its first, then its markings,
            // each `Util.getRandom` of their values; the pack's group a horses', a baby 1 in 20.
            var variant = -1
            if let g = group {
                variant = g.variant
            }
            if variant < 0 {
                variant = r.next_int_below(7)
                group = some(SpawnGroup { ageable: true, variant: variant })
            }
            let markings = r.next_int_below(5)
            self.living.data.set(OWN + 1, Value.Number((variant & 255) | ((markings << 8) & 65280)))
        }
        if self.species == ZOMBIE_HORSE and o.natural {
            self.zombie_rider(o, mut maker, mut r)
        }
        if self.equine() {
            // `AbstractHorse.finalizeSpawn`: a group, a baby 1 in 5, where there's none yet; then
            // `randomizeAttributes`, a horse's and donkey's most health, and a horse's speed and
            // jump; a zombie horse's own, its jump and then its speed.
            if group == none {
                group = some(SpawnGroup { ageable: true, baby_chance: 0.2f32 })
            }
        }
        if self.species == ZOMBIE_HORSE {
            let j1 = r.next_double()
            let j2 = r.next_double()
            let j3 = r.next_double()
            self.set_base("minecraft:jump_strength", 0.5 + j1 * 0.06666666666666667 + j2 * 0.06666666666666667 + j3 * 0.06666666666666667)
            let s1 = r.next_double()
            let s2 = r.next_double()
            let s3 = r.next_double()
            self.set_base("minecraft:movement_speed", (9.0 + s1 * 1.0 + s2 * 1.0 + s3 * 1.0) / f64(42.16f32))
        }
        if self.species == HORSE or self.species == DONKEY {
            let a = r.next_int_below(8)
            let b = r.next_int_below(9)
            self.set_base("minecraft:max_health", f64(15.0f32 + f32.nearest(a) + f32.nearest(b)))
            if self.species == HORSE {
                let s1 = r.next_double()
                let s2 = r.next_double()
                let s3 = r.next_double()
                self.set_base("minecraft:movement_speed", (f64(0.45f32) + s1 * 0.3 + s2 * 0.3 + s3 * 0.3) * 0.25)
                let j1 = r.next_double()
                let j2 = r.next_double()
                let j3 = r.next_double()
                self.set_base("minecraft:jump_strength", f64(0.4f32) + j1 * 0.2 + j2 * 0.2 + j3 * 0.2)
            }
        }
        if self.species == VILLAGER {
            // `Villager.finalizeSpawn`: its type the biome's where its data isn't final, then
            // `AgeableMob`'s and `Mob`'s (CAL-160).
            self.finalize_villager_type(OWN + 1)
        }
        if self.ageable {
            var g = group ?? SpawnGroup { ageable: true }
            if g.babies and g.size > 0 and r.next_float() <= g.baby_chance {
                self.set_age(BABY_START_AGE)
            }
            g.size += 1
            group = some(g)
        }
        self.finalize_mob(mut r)
        return group
    }

    // `Mob.finalizeSpawn`'s: its follow range's random spawn bonus where it hasn't one, and whether
    // it's left-handed, 1 in 20.
    fn finalize_mob<R: RandomSource>(mut self, r: mut R) {
        let follow = attribute("follow_range")
        let bonus = Identifier { namespace: "minecraft", path: "random_spawn_bonus" }
        _ = self.living.attributes.instance(follow)
        if not self.living.attributes.has_modifier(follow, bonus) {
            let amount = r.triangle(0.0, 0.11485000000000001)
            self.living.attributes.add_permanent(follow, Modifier { id: bonus, amount: amount, operation: ADD_MULTIPLIED_BASE })
        }
        self.set_flag(LEFT_HANDED_FLAG, r.next_float() < 0.05f32)
    }

    // `Slime.finalizeSpawn`: its pack's group an ageable one without babies where there's none, so
    // `AgeableMob`'s makes none, only counting it; `Mob`'s draws; then its size, `setSpawnSize`, 1,
    // 2 or 4, its power of 2 drawn from 0 to 2, then up one where under 2 by half the special
    // multiplier, its health its most.
    fn finalize_slime<R: RandomSource>(mut self, given: own SpawnGroup?, o: Occasion, r: mut R) -> SpawnGroup? {
        var g = given ?? SpawnGroup { ageable: true, babies: false }
        g.size += 1
        self.finalize_mob(mut r)
        var scale = r.next_int_below(3)
        if scale < 2 and r.next_float() < 0.5f32 * o.local.special() {
            scale += 1
        }
        self.set_slime_size(1 << scale, true)
        return some(g)
    }

    // A monster's `finalizeSpawn`, each after `Mob`'s. A zombie's: whether it picks up loot; its
    // pack's group made where there's none, a baby 1 in 20; a baby's jockey; whether it breaks
    // doors; its equipment and their enchanting's draws; a Halloween pumpkin; then its attributes,
    // from its own random. A skeleton's: its equipment, its bow, their enchanting's draws, whether
    // it picks up loot, and a Halloween pumpkin. A spider's: 1 in 100 its rider, then its pack's
    // group where there's none, with its effect drawn on hard. A creeper's is `Mob`'s alone.
    fn finalize_monster<R: RandomSource, K: Making>(mut self, given: own SpawnGroup?, o: Occasion, maker: mut K, r: mut R) -> SpawnGroup? {
        if self.species == WITCH {
            // `Raider.finalizeSpawn`: a witch spawned naturally may join no raid, any other may;
            // then `PatrollingMonster.finalizeSpawn`'s draw for a patrol's leader, which a witch
            // can't be, `canBeLeader`, before `Mob`'s.
            self.can_join_raid = not o.natural
            _ = r.next_float() < 0.06f32
        } else if self.species == ZOMBIE_VILLAGER {
            self.finalize_villager_type(MONSTER_OWN + 4)
        }
        self.finalize_mob(mut r)
        let special = o.local.special()
        var group = given
        if self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER {
            self.can_pick_up_loot = r.next_float() < 0.55f32 * special
            if group == none {
                group = some(SpawnGroup { zombie: true, baby: r.next_float() < 0.05f32 })
            }
            var zombies = false
            var baby = false
            var jockey = false
            if let g = group {
                zombies = g.zombie
                baby = g.baby
                jockey = g.jockey
            }
            if zombies {
                if baby {
                    self.set_zombie_baby(true)
                    if jockey {
                        self.chicken_jockey(o, mut maker, mut r)
                    }
                }
                self.can_break_doors = r.next_float() < special * 0.1f32
                self.navigation.can_open_doors = self.can_break_doors
                self.populate_equipment(o, mut r)
                self.enchant_equipment(special, maker.world_loot(), mut r)
            }
            self.halloween(o, mut r)
            self.zombie_attributes(special)
        } else if self.species == SKELETON {
            self.populate_equipment(o, mut r)
            self.enchant_equipment(special, maker.world_loot(), mut r)
            self.reassess_weapon(o.local.hard())
            self.can_pick_up_loot = r.next_float() < 0.55f32 * special
            self.halloween(o, mut r)
        } else if self.species == SPIDER {
            if r.next_int_below(100) == 0 {
                self.skeleton_jockey(o, mut maker, mut r)
            }
            if group == none {
                var g = SpawnGroup { spider: true }
                if o.local.hard() and r.next_float() < 0.1f32 * special {
                    g.effect = r.next_int_below(5)
                }
                group = some(g)
            }
            // The pack's effect, for ever (CAL-163).
            if let g = group {
                if g.spider and g.effect >= 0 {
                    let kinds: List<i32> = [SPEED, SPEED, STRENGTH, REGENERATION, INVISIBILITY]
                    maker.add_effect(mut self, ActiveEffect.new(kinds[usize.wrap(g.effect)], -1, 0))
                }
            }
        }
        return group
    }

    // `finalizeVillagerType`: where its villager data, at `at` in its values, isn't final, the
    // flag after it, its type the biome's where it's made, then final.
    fn finalize_villager_type(mut self, at: usize) {
        if self.living.data.flag(at + 1) {
            return
        }
        let (_, profession, level) = self.living.data.villager(at)
        self.living.data.set(at, Value.Villager(self.villager_type, profession, level))
        self.living.data.set(at + 1, Value.Bool(true))
    }

    // A baby zombie's jockey: 1 in 20 a chicken near that nothing rides, which it would ride, not
    // yet; else 1 in 20 a new chicken, made where it stands and turned as it is, finalized at `o`
    // with no group, a jockey's mount, and in the level before it.
    fn chicken_jockey<R: RandomSource, K: Making>(self, o: Occasion, maker: mut K, r: mut R) {
        if r.next_float() < 0.05f32 {
            return
        }
        if not (r.next_float() < 0.05f32) {
            return
        }
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        var chicken = maker.make_kind(CHICKEN, x, y, z, self.spawn_biome) else return
        chicken.living.snap_to(x, y, z, self.living.body.y_rot, 0.0f32)
        _ = chicken.finalize_spawn(none, o, mut maker, mut r)
        chicken.jockey = true
        maker.add_made(chicken)
    }

    // `ZombieHorse.finalizeSpawn`'s, spawned naturally: a zombie made where it stands and turned as
    // it is, finalized at `o` with no group, then holding an iron spear, its rider, added after it;
    // riding it, not yet (CAL-173).
    fn zombie_rider<R: RandomSource, K: Making>(self, o: Occasion, maker: mut K, r: mut R) {
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        var zombie = maker.make_kind(ZOMBIE, x, y, z, self.spawn_biome) else return
        zombie.living.snap_to(x, y, z, self.living.body.y_rot, 0.0f32)
        _ = zombie.finalize_spawn(none, o, mut maker, mut r)
        zombie.living.equipment[0] = some(stack_of(String("minecraft:iron_spear")))
        maker.add_passenger(zombie)
    }

    // A spider's jockey: a skeleton made where it stands and turned as it is, finalized at `o`
    // with no group, its rider, added after it; riding it, not yet.
    fn skeleton_jockey<R: RandomSource, K: Making>(self, o: Occasion, maker: mut K, r: mut R) {
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        var skeleton = maker.make_kind(SKELETON, x, y, z, self.spawn_biome) else return
        skeleton.living.snap_to(x, y, z, self.living.body.y_rot, 0.0f32)
        _ = skeleton.finalize_spawn(none, o, mut maker, mut r)
        maker.add_passenger(skeleton)
    }

    // `populateDefaultEquipmentSlots`: by 15 in 100 of the special multiplier, armor of a tier
    // drawn from 0 to 2 and up one each of three times 1087 in 10,000, leather, copper, gold,
    // chainmail, iron then diamond, its head's first then, each after a quarter's draw, a tenth's
    // on hard, that it stops at, its chest's, legs' and feet's, each where it wears nothing. Then
    // a zombie's weapon, 1 in 100, 1 in 20 on hard, an iron sword, spear or shovel 4 in 6; and a
    // skeleton's bow.
    fn populate_equipment<R: RandomSource>(mut self, o: Occasion, r: mut R) {
        if r.next_float() < 0.15f32 * o.local.special() {
            var tier = r.next_int_below(3)
            for _ in 0..3 {
                if r.next_float() < 0.1087f32 {
                    tier += 1
                }
            }
            let partial = if o.local.hard() { 0.1f32 } else { 0.25f32 }
            var first = true
            for slot in [5usize, 4usize, 3usize, 2usize] {
                if not first and r.next_float() < partial {
                    break
                }
                first = false
                if self.living.equipment[slot] == none {
                    if let item = armor_for(slot, tier) {
                        self.living.equipment[slot] = some(stack_of(item.copy()))
                    }
                }
            }
        }
        if self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER {
            if r.next_float() < (if o.local.hard() { 0.05f32 } else { 0.01f32 }) {
                let pick = r.next_int_below(6)
                let weapon = if pick == 0 { "minecraft:iron_sword" } else if pick == 1 { "minecraft:iron_spear" } else { "minecraft:iron_shovel" }
                self.living.equipment[0] = some(stack_of(String(weapon)))
            }
        } else if self.species == SKELETON {
            self.living.equipment[0] = some(stack_of(String("minecraft:bow")))
        }
    }

    // `populateDefaultEquipmentEnchantments` (D522): the main hand's draw, a quarter by the special
    // multiplier, then each armor slot's, feet first, half by it, each where it holds something;
    // where one comes up, what it holds enchanted from `mob_spawn_equipment`,
    // `enchantItemFromProvider`, by the world's loot `loot`, or only drawn for without it.
    fn enchant_equipment<R: RandomSource>(mut self, special: f32, loot: Shared<Loot>?, r: mut R) {
        for (slot, chance) in [(0usize, 0.25f32), (2usize, 0.5f32), (3usize, 0.5f32), (4usize, 0.5f32), (5usize, 0.5f32)] {
            let held = self.living.equipment[slot].copy() else continue
            if not (r.next_float() < chance * special) {
                continue
            }
            if let l = loot {
                self.living.equipment[slot] = some(spawn_enchanted(l.value, mut r, held, special))
            }
        }
    }

    // On Halloween, where its head is bare, 1 in 4 a pumpkin on it, a jack o'lantern 1 in 10, never
    // dropped.
    fn halloween<R: RandomSource>(mut self, o: Occasion, r: mut R) {
        if self.living.equipment[5] != none or not o.halloween {
            return
        }
        if not (r.next_float() < 0.25f32) {
            return
        }
        let lantern = r.next_float() < 0.1f32
        self.living.equipment[5] = some(stack_of(String(if lantern { "minecraft:jack_o_lantern" } else { "minecraft:carved_pumpkin" })))
        var chances = JavaHashMap<String, Tag>()
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(had) = self.kept["drop_chances"] {
                chances = had.copy()
            }
        }
        chances.insert(String("head"), Tag.Float(0.0f32))
        self.kept.insert(String("drop_chances"), Tag.Compound(chances))
    }

    // `Zombie.handleAttributes`, from its own random: its reinforcements' chance's base, up to a
    // tenth; its knockback resistance's random spawn bonus, up to a twentieth; its follow range's,
    // where a draw of 1.5 by the special multiplier is over 1, on its total; and, by a twentieth of
    // the multiplier, a leader's bonuses, a half to three quarters more reinforcements' chance and
    // its most health one to four times again, its health that, breaking doors.
    fn zombie_attributes(mut self, special: f32) {
        let reinforcements = attribute("spawn_reinforcements")
        let base = self.living.body.random.next_double() * f64(0.1f32)
        self.living.attributes.set_base(reinforcements, base)
        let knockback = attribute("knockback_resistance")
        let resist = self.living.body.random.next_double() * f64(0.05f32)
        self.add_or_replace(knockback, Modifier { id: Identifier { namespace: "minecraft", path: "random_spawn_bonus" }, amount: resist, operation: ADD_VALUE })
        let follow = self.living.body.random.next_double() * 1.5 * f64(special)
        if follow > 1.0 {
            self.add_or_replace(attribute("follow_range"), Modifier { id: Identifier { namespace: "minecraft", path: "zombie_random_spawn_bonus" }, amount: follow, operation: ADD_MULTIPLIED_TOTAL })
        }
        if self.living.body.random.next_float() < special * 0.05f32 {
            let more = self.living.body.random.next_double() * 0.25 + 0.5
            self.add_or_replace(reinforcements, Modifier { id: Identifier { namespace: "minecraft", path: "leader_zombie_bonus" }, amount: more, operation: ADD_VALUE })
            let health = self.living.body.random.next_double() * 3.0 + 1.0
            let most = attribute("max_health")
            self.add_or_replace(most, Modifier { id: Identifier { namespace: "minecraft", path: "leader_zombie_bonus" }, amount: health, operation: ADD_MULTIPLIED_TOTAL })
            self.living.data.set(HEALTH, Value.Float(f32.nearest(self.living.attributes.value(most))))
            self.can_break_doors = true
            self.navigation.can_open_doors = true
        }
    }

    // `addOrReplacePermanentModifier` on `a`.
    fn add_or_replace(mut self, a: u32, m: Modifier) {
        self.living.attributes.take_off(a, m.id.copy())
        self.living.attributes.add_permanent(a, m)
    }

    // `setBaseValue` of the attribute `name`.
    fn set_base(mut self, name: str, base: f64) {
        let a = attribute_id(String(name)) ?? panic("no attribute {name}")
        _ = self.living.attributes.instance(a)
        self.living.attributes.set_base(a, base)
    }

    /// Its tick, as `tickNonPassenger` and `Mob.tick` run it among `blocks`, in a level whose floor
    /// is `min_y`, where lava's fast if `fast_lava`: `baseTick`, with its ambient sound now and
    /// then; its equipment's changes, as `items` reads them, `detectEquipmentUpdates`; `aiStep`, a horse's tail first, the ticks it's done nothing counted where it thinks,
    /// then its move, and after it an ageable mob's age, an animal's love, a chicken's slow fall
    /// and eggs, and a horse's healing and grazing; and its health kept within its most and its
    /// turns kept near. A door its brain swings is left for what holds it to swing, as nothing
    /// here can; its tick goes on past it.
    pub fn tick<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        let entered = self.tick_thinking(lf, f, m, t, blocks, items, mut cache, players, min_y, fast_lava, mut sounds)
        while self.tick_rest(entered, lf, f, m, t, blocks, items, mut cache, players, min_y, fast_lava, mut sounds) {}
    }

    /// Whether what it showed of its tick so far has an attack on a player, which its level deals
    /// before its tick goes on (CAL-159).
    pub fn attacked(self) -> bool {
        for w in self.living.shown {
            if let Shown.Attack(_) = w {
                return true
            }
        }
        return false
    }

    /// Its tick up to and through its AI's goals, `serverAiStep`'s, where it may attack a player,
    /// which its level deals before `tick_rest` goes on with the rest of its AI, as vanilla's
    /// `doHurtTarget` comes before its navigation, its own step and its controls, then `travel` and
    /// `pushEntities` (CAL-159). Whether it wasn't gone as its `aiStep` began, which `tick_rest`
    /// is told.
    pub fn tick_thinking<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        self.tick_using(lf, f, m, t, blocks, items, players, min_y, fast_lava, mut sounds)
        // A spear's hits, which only its level deals, aren't dealt where it ticks on its own.
        self.stab_due = none
        return self.tick_thinking_on(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds)
    }

    /// Its tick up to and through its use of what it holds, `updatingUsingItem`, where a spear's
    /// use may ask its level to deal its hits, `stab_due`, which its level deals before
    /// `tick_thinking_on` goes on, as vanilla's `damageEntities` comes before the rest of its tick
    /// (CAL-159).
    pub fn tick_using<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.species == ENDERMITE {
            // `Endermite.tick`'s, before the rest: its body turned as it is (D583).
            self.living.y_body_rot = self.living.body.y_rot
        }
        self.floor_y = min_y
        // An enderman's hurt between its ticks, as its level dealt it, teleports it now (CAL-159).
        self.hurt_teleport(lf, f, m, blocks, mut sounds)
        if self.species == SKELETON {
            // `Skeleton.tick`'s, before the rest: freezing toward a stray in powder snow, which
            // Calcite doesn't find it in yet.
            self.convert_step(false, MONSTER_OWN, 140, 300)
        } else if self.species == CREEPER {
            self.swell_step(mut sounds)
        }
        self.base_tick(lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
        if let left = self.living.updating_using() {
            self.kinetic_tick(left)
        }
    }

    // `KineticWeapon.damageEntities` up to the entities its use meets, `left` the ticks its use
    // had left as it ticked (CAL-159): where it's using a spear, once its use is past the delay,
    // what it asks of its level, `stab_due`: the ticks past it, its eyes, its look and its head's,
    // its speed, `getMotion`, its known speed 20 times over, as it rides nothing, its motion, its
    // reach with the spear, and the base of its attack damage, `getAttributeBaseValue`.
    fn kinetic_tick(mut self, left: i32) {
        let k = self.living.use_kinetic else return
        let used = 72000 - left
        if used < k.delay {
            return
        }
        let (sx, sy, sz) = (self.living.body.known_dx, self.living.body.known_dy, self.living.body.known_dz)
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        let (x_rot, y_rot) = (self.living.body.x_rot, self.living.body.y_rot)
        self.stab_due = some(StabDue {
            ticks: used - k.delay,
            eye: (x, y + f64(self.living.body.eyes), z),
            look: view_vector(x_rot, y_rot),
            head_look: view_vector(x_rot, self.living.y_head_rot),
            speed: (sx * 20.0, sy * 20.0, sz * 20.0),
            movement: (self.living.body.vx, self.living.body.vy, self.living.body.vz),
            reach: self.held_reach ?? reach_of(none),
            kinetic: k,
            base_damage: self.living.attributes.base(attribute_id(String("attack_damage")) ?? 0),
        })
    }

    /// The rest of its tick up to and through its AI's goals, after `tick_using` (CAL-159), as
    /// `tick_thinking` has it.
    pub fn tick_thinking_on<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        self.living.arrows_tick()
        self.living.detect_equipment(items, sounds.len())
        if self.living.alive() {
            let drawn = self.living.body.random.next_int_below(1000)
            let due = drawn < self.ambient_sound_time
            self.ambient_sound_time += 1
            if due {
                self.ambient_sound_time = -self.ambient_interval
                var held = self.ambient.copy()
                if self.species == ENDERMAN and self.living.data.flag(MONSTER_OWN + 1) {
                    // `Enderman.getAmbientSound`: creepy, it screams.
                    held = some(String("entity.enderman.scream"))
                }
                if let sound = held {
                    let pitch = self.voice_pitch()
                    self.living.play(mut sounds, sound, self.sound_volume, pitch)
                }
            }
        }
        // `LivingEntity.tick`'s, before its `aiStep`: where it sleeps but can't act on its level
        // any more or its bed's gone, `checkBedExists`, it gets up (CAL-160).
        if let at = self.living.sleeping {
            let (bx, by, bz) = at
            if not self.living.alive() or self.living.body.removed or bed_sleep_height(f, m, blocks, bx, by, bz) == none {
                self.wake_now(f, m, blocks, sounds)
            }
        }
        if self.living.body.removed {
            return false
        }
        if self.species == ENDER_DRAGON {
            // Its own `aiStep`, none of a mob's, so it isn't said to have entered a mob's (D608).
            self.dragon_step(lf, f, blocks, sounds.len())
            return false
        }
        let horse = self.equine()
        if horse {
            // `AbstractHorse.aiStep`: its tail swishes 1 in 200, which only clients show.
            _ = self.living.body.random.next_int_below(200)
        }
        if self.species == ENDERMAN {
            // `Enderman.aiStep`'s, before the rest: its anger kept up, `updatePersistentAnger`.
            self.update_anger(players)
        }
        if self.species == WITCH {
            self.witch_step(lf, players, mut sounds)
            // `Raider.updateNoActionTime`, in any light.
            self.no_action_time += 2
        } else if self.monster and self.magic_light(blocks) > 0.5f32 {
            // `Monster.updateNoActionTime`, in light.
            self.no_action_time += 2
        }
        // `isImmobile`: dying, or a horse that's eating or standing, which thinks of nothing even
        // dying as no one rides it.
        let immobile = if horse { self.horse_flag(16) or self.horse_flag(32) } else { self.living.dead_or_dying() }
        let thinks = self.living.ai_start_as(immobile) and not self.no_ai()
        if thinks {
            self.no_action_time += 1
            if self.monster {
                self.read_held(items)
            }
            self.think(lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        }
        return true
    }

    /// The rest of its tick, after `tick_thinking`, which says whether it `entered` its `aiStep`'s
    /// own part, not gone as it began (CAL-159): the rest of its AI after its goals, where they
    /// ran, `think_after`; its travel and pushes, and its tick's end. Whether it stopped there for
    /// its level to swing a door its brain swung, to be called again to go on (CAL-160).
    pub fn tick_rest<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, entered: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        if self.thought {
            if self.think_after(lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                return true
            }
            self.thought = false
        }
        if entered {
            let horse = self.equine()
            let moves = not self.no_ai()
            self.living.ai_rest(lf, f, m, t, blocks, fast_lava, moves, mut sounds)
            self.fall_hurt(lf, blocks, items, mut sounds)
            // What the block it's on does to it, `stepOn`, magma's burn its own hurt (D431).
            match self.living.step_on_block(f, t, blocks) {
                Stepped.Magma => self.hurt_self(lf, blocks, items, "hot_floor", 1.0f32, mut sounds),
                Stepped.Ore(at) => self.living.show(Shown.Lit(at), sounds.len()),
                Stepped.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                Stepped.Nothing => {},
            }
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
            self.inside_walk(lf, f, blocks, items, mut sounds)
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
            self.living.ai_end(lf, f, t, blocks)
            if self.species == ENDERMAN and (self.living.body.in_water or self.living.body.in_rain(blocks)) {
                // `aiStep`'s last, after its pushes: water hurts it, `isSensitiveToWater`, in it
                // or the rain, `drown` (CAL-159).
                self.hurt_self(lf, blocks, items, "drown", 1.0f32, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
            if self.burns {
                self.burn_undead(blocks, items, sounds.len())
            }
            if self.ageable and self.forced_age_timer > 0 {
                // `AgeableMob.aiStep`: each 4th tick of the 40, a happy villager's particle the
                // server sends, `getRandomX(1)`, `getRandomY` half a block up and
                // `getRandomZ(1)`, drawn (D415).
                if self.forced_age_timer % 4 == 0 {
                    let width = f64(self.living.body.width)
                    let x = self.living.body.x + width * (2.0 * self.living.body.random.next_double() - 1.0)
                    let y = self.living.body.y + f64(self.living.body.height) * self.living.body.random.next_double() + 0.5
                    let z = self.living.body.z + width * (2.0 * self.living.body.random.next_double() - 1.0)
                    self.living.show(Shown.Particle(Sent { particle: String("happy_villager"), x: x, y: y, z: z }), sounds.len())
                }
                self.forced_age_timer -= 1
            }
            if self.ageable and self.living.alive() {
                if self.can_age_up() {
                    let older = self.age + 1
                    self.set_age(older)
                } else if self.age > 0 {
                    let younger = self.age - 1
                    self.set_age(younger)
                }
            }
            self.animal_step()
            if self.in_love > 0 {
                self.in_love -= 1
                if self.in_love % 10 == 0 {
                    // A heart, `addParticle`, which only clients show: its motion, then its
                    // place, `getRandomX(1)`, `getRandomY` and `getRandomZ(1)`, drawn (CAL-158).
                    for _ in 0..3 {
                        _ = self.living.body.random.next_gaussian()
                    }
                    for _ in 0..3 {
                        _ = self.living.body.random.next_double()
                    }
                }
            }
            if self.species == CHICKEN {
                self.chicken_step(mut sounds)
            }
            if horse {
                self.horse_step(lf, f, blocks)
            }
            if self.species == ENDERMITE {
                // `Endermite.aiStep`'s, after the rest: a tick more of its life where it needn't
                // stay, and at 2400 it's gone, `discard` (D583).
                if not self.persistence_required {
                    self.life += 1
                }
                if self.life >= 2400 {
                    self.living.body.removed = true
                }
            }
        }
        // `tickHeadTurn`, its head kept within its reach, `getMaxHeadYRot`; an armadillo's body not
        // turned while it's scared, its own `BodyRotationControl` (CAL-160).
        if not self.scared() {
            let reach = self.max_head_y_rot()
            self.body_turn.tick(mut self.living, reach)
        }
        // `LivingEntity.tick`'s: asleep, its pitch level (CAL-160).
        if self.living.sleeping != none {
            self.living.body.x_rot = 0.0f32
        }
        self.living.keep_health(lf)
        self.living.tick_end()
        if self.species == ZOMBIE {
            // `Zombie.tick`'s, after the rest: becoming a drowned in water to its eyes.
            let wet = self.living.body.water_eyes
            self.convert_step(wet, MONSTER_OWN + 2, 600, 300)
        } else if self.species == SPIDER {
            // `Spider.tick`'s: climbing where it bumped into something across.
            let flags = i32(self.living.data.byte(MONSTER_OWN))
            let climbing = self.living.body.horizontal_collision
            self.living.data.set(MONSTER_OWN, Value.Byte(i8.wrap(if climbing { flags | 1 } else { flags & -2 })))
        } else if self.species == SLIME {
            self.cube_landing(mut sounds)
        } else if self.species == ARMADILLO {
            // `Armadillo.tick`'s, after the rest: scared, its head kept to its body,
            // `clampHeadRotationToBody`; and its ticks in its state counted (CAL-160).
            if self.scared() {
                self.clamp_head()
            }
            self.in_state_ticks += 1
        } else if self.species == VILLAGER {
            // `Villager.tick`'s, after the rest: its unhappiness counted down, and its gossip
            // decayed a day after it last did, `maybeDecayGossip` (CAL-160).
            let unhappy = self.living.data.number(OWN)
            if unhappy > 0 {
                self.living.data.set(OWN, Value.Number(unhappy - 1))
            }
            let now = self.game_time
            if self.last_gossip_decay == 0 {
                self.last_gossip_decay = now
            } else if now >= self.last_gossip_decay + 24000 {
                self.gossips.decay()
                self.last_gossip_decay = now
            }
        }
        if self.equine() and self.stand_counter > 0 {
            // `AbstractHorse.tick`'s, after the rest: its standing counted down, and let go at 0,
            // `clearStanding`.
            self.stand_counter -= 1
            if self.stand_counter <= 0 {
                self.set_horse_flag(32, false)
                self.stand_counter = 0
            }
        }
        return false
    }

    // `AbstractCubeMob.tick`'s, after the rest: landing, its particles' draws from its own random,
    // two for each of 16 a block of twice its width, which only clients show, then its squish,
    // `entity.slime.squish`, a size 1 slime's its own, as loud as its sounds, its pitch drawn from
    // its own random. How it squishes, `targetSquish`, only clients show.
    fn cube_landing(mut self, sounds: mut List<EntitySound>) {
        let on = self.living.body.on_ground
        if on and not self.was_on_ground {
            let across = self.living.body.width * 2.0f32
            var i = 0
            while f32.nearest(i) < across * 16.0f32 {
                _ = self.living.body.random.next_float()
                _ = self.living.body.random.next_float()
                i += 1
            }
            let sound = if self.slime_size() <= 1 { "entity.slime.squish_small" } else { "entity.slime.squish" }
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, String(sound), self.sound_volume, ((a - b) * 0.2f32 + 1.0f32) / 0.8f32)
        }
        self.was_on_ground = on
    }

    // `Witch.aiStep`'s, alive (CAL-159). Drinking, its ticks out, it stops, `setUsingItem`, what's
    // in its main hand gone, a potion's effects added, `forEachEffect` (CAL-163), and its drinking
    // slowness taken off; the drink's game event comes with game events. Else the potions it might
    // drink, each drawn for from its own random in turn: water breathing with its eyes in water,
    // fire resistance on fire or hurt by fire in the last 40 ticks, healing hurt, and swiftness at
    // a target past 11 blocks, each where it hasn't the effect; one to drink in its main hand,
    // `PotionContents.createItemStack`, for 32 ticks, `getUseDuration`, drinking, its drink sound,
    // its pitch drawn, unless it's silent, and slowed by a quarter, `SPEED_MODIFIER_DRINKING`. Then
    // 1 in about 1,333 its particles, entity event 15, shown after the `heard` sounds of its tick.
    fn witch_step(mut self, lf: LivingFacts, players: List<Follower>, sounds: mut List<EntitySound>) {
        if not self.living.alive() {
            return
        }
        let drinking = Identifier { namespace: "minecraft", path: String("drinking") }
        if self.living.data.flag(MONSTER_OWN + 1) {
            let left = self.using_time
            self.using_time -= 1
            if left <= 0 {
                self.living.data.set(MONSTER_OWN + 1, Value.Bool(false))
                let held = self.living.equipment[0].copy()
                self.living.equipment[0] = none
                if stack_named(held, "minecraft:potion") {
                    for e in potion_of(held) {
                        _ = self.add_effect(lf, e.copy(), mut sounds)
                    }
                }
                self.living.attributes.take_off(lf.movement_speed, drinking)
            }
        } else {
            var potion: str? = none
            let wet = self.living.body.water_eyes and not self.living.has_effect(WATER_BREATHING)
            let burning = (self.living.on_fire() or self.living.recently_hurt_by(self.game_time, IS_FIRE)) and not self.living.has_effect(FIRE_RESISTANCE)
            let hurt = self.living.data.float(HEALTH) < f32.nearest(self.living.attributes.value(attribute("max_health")))
            var far = false
            if let p = self.target_in(players) {
                far = not self.living.has_effect(SPEED) and self.distance_sqr_to(p.x, p.y, p.z) > 121.0
            }
            if self.living.body.random.next_float() < 0.15f32 and wet {
                potion = some("minecraft:water_breathing")
            } else if self.living.body.random.next_float() < 0.15f32 and burning {
                potion = some("minecraft:fire_resistance")
            } else if self.living.body.random.next_float() < 0.05f32 and hurt {
                potion = some("minecraft:healing")
            } else if self.living.body.random.next_float() < 0.5f32 and far {
                potion = some("minecraft:swiftness")
            }
            if let drink = potion {
                self.living.equipment[0] = some(potion_stack("minecraft:potion", drink))
                self.using_time = 32
                self.living.data.set(MONSTER_OWN + 1, Value.Bool(true))
                if not self.living.data.flag(SILENT) {
                    let pitch = 0.8f32 + self.living.body.random.next_float() * 0.4f32
                    self.living.play(mut sounds, String("entity.witch.drink"), 1.0f32, pitch)
                }
                self.living.attributes.take_off(lf.movement_speed, drinking.copy())
                self.living.attributes.replace(lf.movement_speed, Modifier { id: drinking, amount: -0.25, operation: ADD_VALUE })
            }
        }
        if self.living.body.random.next_float() < 0.00075f32 {
            self.living.show(Shown.Event(15i8), sounds.len())
        }
    }

    // `CubeMobAttackGoal` (CAL-159), `left` its ticks till it grows tired: used while it has a
    // target it may attack, for 150 ticks of its goals, `growTiredTimer`; each tick turned to them
    // at once, 10 degrees, `Mob.lookAt`, and its way theirs, after them where it may hurt them,
    // `canDealDamage`.
    fn cube_attack_goal(mut self, left: mut i32, call: i32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            return self.target_in(players) != none
        }
        if call == GOAL_CONTINUE {
            if self.target_in(players) == none {
                return false
            }
            left -= 1
            return left > 0
        }
        if call == GOAL_START {
            left = reduced_tick_delay(300)
        } else if call == GOAL_TICK {
            if let p = self.target_in(players) {
                self.look_at_now(p, 10.0f32, 10.0f32)
            }
            let y_rot = self.living.body.y_rot
            self.moves.set_direction(y_rot, self.cube_hurts())
        }
        return false
    }

    /// `AbstractCubeMob.canDealDamage` (CAL-159): a slime bigger than the least, thinking.
    pub fn cube_hurts(self) -> bool {
        return self.species == SLIME and self.slime_size() > 1 and not self.no_ai()
    }

    /// Whether a slime may hurt the player `p` it touches, as `dealDamage` asks (CAL-159): alive,
    /// with them within its reach, `isWithinMeleeAttackRange`, and in its sight from its eyes to
    /// theirs, `LivingEntity.hasLineOfSight`; teams come with teams.
    pub fn cube_reaches<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, p: Follower) -> bool {
        if not self.living.alive() or not self.within_melee(p, 0) {
            return false
        }
        let me = self.looker()
        return sees(m, f, blocks, me.mover, me.x, me.eye_y, me.z, p.x, p.y + f64(p.eyes), p.z)
    }

    /// A slime's attack sound as it hurts a player it touched (CAL-159), its pitch drawn.
    pub fn cube_attacked(mut self, sounds: mut List<EntitySound>) {
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        self.living.play(mut sounds, String("entity.slime.attack"), 1.0f32, (a - b) * 0.2f32 + 1.0f32)
    }

    // A `RangedAttackGoal` (CAL-159): used while it has a target that's alive, going on while it
    // does, or while the target it took up is alive and its path isn't done. Each tick, its sight
    // of them counted, `seeTime`; within its radius and seen for 5 ticks, its path stopped, else
    // it goes for them; looking at their eyes, 30 degrees; its attack's ticks counted down, and
    // out, seen, its attack, `performRangedAttack`, then as many ticks again as how far they are
    // of its radius says, between its least and most; else with none drawn up, that many.
    fn ranged_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Ranged, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            if let p = self.target_in(players) {
                g.target = p.id
                return true
            }
            if call == GOAL_CAN_USE {
                return false
            }
            for p in players {
                if p.id == g.target and not p.dead {
                    return not self.navigation.is_done()
                }
            }
            return false
        }
        if call == GOAL_STOP {
            g.target = -1
            g.see_time = 0
            g.attack_time = -1
        } else if call == GOAL_TICK {
            let at = player_at(players, g.target) else return false
            let p = players[at].copy()
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            let me = self.looker()
            let sight = sees_player(m, f, blocks, mut self.sensing, me, p)
            if sight {
                g.see_time += 1
            } else {
                g.see_time = 0
            }
            if not (d > f64(g.radius * g.radius)) and g.see_time >= 5 {
                self.navigation.stop()
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, g.speed)
            }
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
            g.attack_time -= 1
            if g.attack_time == 0 {
                if not sight {
                    return false
                }
                let dist = f32.nearest(d.sqrt()) / g.radius
                self.witch_throw(p, mut sounds)
                g.attack_time = floor_of(f64(dist * f32.nearest(f64(g.interval_max - g.interval_min)) + f32.nearest(f64(g.interval_min))))
            } else if g.attack_time < 0 {
                let a = d.sqrt() / f64(g.radius)
                g.attack_time = floor_of(f64(g.interval_min) + a * f64(g.interval_max - g.interval_min))
            }
        }
        return false
    }

    // `Witch.performRangedAttack` at the player `p` (CAL-159), not drinking: where they'll be,
    // their movement ahead, and how far across; a splash potion of harming, or of slowness 8 blocks
    // off or more, else of poison where they've 8 health or more, else of weakness within 3 blocks
    // 1 in 4, drawn, each where they haven't its effect, `hasEffect` (D514); the potion thrown,
    // `Shown.Hurled`, which its level makes, from a tenth below its eyes toward them, 1.1 below
    // their eyes and a fifth of the way across above that, at 0.75 blocks a tick, 0.45 within 2
    // blocks, 8 off on every difficulty, `Witch.rangedAttackUncertainty` (D528); and its throw
    // sound, its pitch drawn, unless it's silent.
    fn witch_throw(mut self, p: Follower, sounds: mut List<EntitySound>) {
        if self.living.data.flag(MONSTER_OWN + 1) {
            return
        }
        let xd = p.x + p.vx - self.living.body.x
        let zd = p.z + p.vz - self.living.body.z
        let dist = (xd * xd + zd * zd).sqrt()
        var potion = "harming"
        if dist >= 8.0 and not p.has_effect(SLOWNESS) {
            potion = "slowness"
        } else if p.health >= 8.0f32 and not p.has_effect(POISON) {
            potion = "poison"
        } else if dist <= 3.0 and not p.has_effect(WEAKNESS) and self.living.body.random.next_float() < 0.25f32 {
            potion = "weakness"
        }
        let yd = p.y + f64(p.eyes) - f64(1.1f32) - self.living.body.y
        let thrown = Hurled {
            owner: self.living.body.uuid,
            x: self.living.body.x,
            y: self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32),
            z: self.living.body.z,
            xd: xd,
            yd: yd + dist * 0.2,
            zd: zd,
            power: if dist <= 2.0 { 0.45f32 } else { 0.75f32 },
            uncertainty: 8.0f32,
            potion: "minecraft:{potion}",
        }
        self.living.show(Shown.Hurled(thrown), sounds.len())
        if not self.living.data.flag(SILENT) {
            let pitch = 0.8f32 + self.living.body.random.next_float() * 0.4f32
            self.living.play(mut sounds, String("entity.witch.throw"), 1.0f32, pitch)
        }
    }

    /// `addEffect` of `e`, as `Living.add_effect` has it, its type's `canBeAffected` with it, its
    /// sound in `sounds`; whether it changed (CAL-163).
    pub fn add_effect(mut self, lf: LivingFacts, e: ActiveEffect, sounds: mut List<EntitySound>) -> bool {
        return self.living.add_effect(lf, e, mut sounds)
    }

    // `tickEffects` (CAL-163): each of its effects in their order, `tickServer`: its act,
    // `Living.effect_act`, a hurt it gives dealt as its own, `hurt_self`, an enderman's teleport
    // after, as `Enderman.hurtServer` has it; then its count down, `Living.effect_end`. Undead
    // mobs are harmed by healing and healed by harming, `#inverted_healing_and_harm`.
    fn tick_effects<B: CollisionBlocks + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let inverted = self.living.inverted(lf)
        var i: usize = 0
        while i < self.living.effects.len() {
            let (kept, hurt, amount) = self.living.effect_act(lf, i, inverted)
            if hurt == MAGIC_HURT or hurt == WITHER_HURT {
                self.hurt_self(lf, blocks, items, if hurt == MAGIC_HURT { "magic" } else { "wither" }, amount, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
            if self.living.effect_end(lf, i, kept) {
                i += 1
            }
        }
    }

    // The light where its eyes are, `getLightLevelDependentMagicValue`.
    fn magic_light<B: MobLight>(self, blocks: B) -> f32 {
        let x = i32.saturate(self.living.body.x.floor())
        let y = i32.saturate((self.living.body.y + f64(self.living.body.eyes)).floor())
        let z = i32.saturate(self.living.body.z.floor())
        return blocks.magic_light(x, y, z)
    }

    // `Mob.burnUndead` (D437), `heard` the sounds before: alive where monsters burn, the light at
    // its eyes over half and a draw from its own random under what's more, out of water and rain,
    // and its eyes' block seeing the sky, `isSunBurnTick`, what's on its head takes the sun, worn
    // by 0 or 1, drawn, where it can be, which its level does with its random,
    // `hurtAndBreak`; with nothing on its head, it's lit for 8 seconds, `igniteForSeconds`.
    // Powder snow, which would keep it from burning, comes with powder snow.
    fn burn_undead<B: MobLight + Rain, W: Wearing>(mut self, blocks: B, items: W, heard: usize) {
        if not self.living.alive() {
            return
        }
        let x = i32.saturate(self.living.body.x.floor())
        let y = i32.saturate(self.living.body.y.floor())
        let z = i32.saturate(self.living.body.z.floor())
        if not blocks.monsters_burn(x, y, z) {
            return
        }
        let light = self.magic_light(blocks)
        if not (light > 0.5f32) {
            return
        }
        if not (self.living.body.random.next_float() * 30.0f32 < (light - 0.4f32) * 2.0f32) {
            return
        }
        if self.living.body.in_water or self.living.body.in_rain(blocks) {
            return
        }
        let ey = i32.saturate((self.living.body.y + f64(self.living.body.eyes)).floor())
        if not blocks.sees_sky(x, ey, z) {
            return
        }
        let head: usize = 5
        if let worn = self.living.equipment[head].copy() {
            let damageable = items.worn_component(worn.copy(), String("minecraft:max_damage")) != none and items.worn_component(worn.copy(), String("minecraft:unbreakable")) == none and items.worn_component(worn.copy(), String("minecraft:damage")) != none
            if damageable {
                let amount = self.living.body.random.next_int_below(2)
                if amount > 0 {
                    self.living.show(Shown.Wore((head, amount)), heard)
                }
            }
            return
        }
        self.living.ignite_for_ticks(160)
    }

    // `ConversionTracker.tick`, alive and thinking: `afflicted`, it counts how long, and at
    // `total_affliction` starts converting, its value at `at` on, for `total_conversion` ticks,
    // counted down, after which it would become another, `doConversion`, not yet; not, it's
    // neither.
    fn convert_step(mut self, afflicted: bool, at: usize, total_affliction: i32, total_conversion: i32) {
        if not self.living.alive() or self.no_ai() {
            return
        }
        if not afflicted {
            self.affliction_time = -1
            self.living.data.set(at, Value.Bool(false))
            return
        }
        if self.living.data.flag(at) {
            self.conversion_time -= 1
            return
        }
        self.affliction_time += 1
        if self.affliction_time >= total_affliction {
            self.conversion_time = total_conversion
            self.living.data.set(at, Value.Bool(true))
        }
    }

    // `Creeper.tick`'s, alive, before the rest: ignited, or as its `SwellGoal` has it, it swells,
    // its primed sound as it starts; at its fuse it would explode, `explodeCreeper`, which waits
    // for explosions (CAL-182), said missing, so it stays swollen.
    fn swell_step(mut self, sounds: mut List<EntitySound>) {
        if not self.living.alive() {
            return
        }
        if self.living.data.flag(MONSTER_OWN + 2) {
            self.living.data.set(MONSTER_OWN, Value.Number(1))
        }
        let dir = self.living.data.number(MONSTER_OWN)
        if dir > 0 and self.swell == 0 {
            self.living.play(mut sounds, String("entity.creeper.primed"), 1.0f32, 0.5f32)
        }
        self.swell += dir
        if self.swell < 0 {
            self.swell = 0
        }
        if self.swell >= self.max_swell {
            self.swell = self.max_swell
            // `explodeCreeper`, which waits for explosions (CAL-182), so it stays swollen.
            self.living.show(Shown.Missing(String("A creeper's explosion, explodeCreeper")), sounds.len())
        }
    }

    // `AbstractHorse.aiStep`'s, alive: healed a point 1 in 900; and, not eating and ridden by
    // none, it starts eating 1 in 300 on a grass block, `setEating`, and stops 50 ticks after.
    // A bred foal following its mother, `followMommy`, waits for AI.
    fn horse_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) {
        if not self.living.alive() {
            return
        }
        if self.living.body.random.next_int_below(900) == 0 and self.living.death_time == 0 {
            self.living.heal(lf, 1.0f32)
        }
        if not self.horse_flag(16) and self.living.body.random.next_int_below(300) == 0 {
            let x = i32.saturate(self.living.body.x.floor())
            let y = i32.saturate(self.living.body.y.floor())
            let z = i32.saturate(self.living.body.z.floor())
            if let below = blocks.collision_state(x, y - 1, z) {
                if f.block_named(String("minecraft:grass_block")) == some(f.block(below)) {
                    self.set_horse_flag(16, true)
                }
            }
        }
        if self.horse_flag(16) {
            self.eating_counter += 1
            if self.eating_counter > 50 {
                self.eating_counter = 0
                self.set_horse_flag(16, false)
            }
        }
    }

    // `Chicken.aiStep`'s: falling slowly, 0.6 of its fall kept in the air; and, grown, alive and
    // no jockey's mount, its ticks until it lays counted down, at 0 its egg laid, then its sound
    // drawn from its own random where it laid one, and its ticks drawn again.
    fn chicken_step(mut self, sounds: mut List<EntitySound>) {
        if not self.living.body.on_ground and self.living.body.vy < 0.0 {
            self.living.body.vy *= 0.6
        }
        if not self.living.alive() or self.baby() or self.jockey {
            return
        }
        self.egg_time -= 1
        if self.egg_time > 0 {
            return
        }
        if let item = self.egg() {
            let laid = Laid { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, item: item, table: String("minecraft:gameplay/chicken_lay") }
            self.living.show(Shown.Laid(laid), sounds.len())
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, String("entity.chicken.egg"), 1.0f32, (a - b) * 0.2f32 + 1.0f32)
        }
        self.egg_time = self.living.body.random.next_int_below(6000) + 6000
    }

    /// The egg a chicken lays, `gameplay/chicken_lay`'s by its variant: an egg for the temperate, a
    /// brown one for the warm and a blue one for the cold; none for another, which lays nothing.
    pub fn egg(self) -> String? {
        if self.variant < 0 or usize.wrap(self.variant) >= self.variant_names.len() {
            return none
        }
        let name = self.variant_names[usize.wrap(self.variant)].copy()
        if name == "minecraft:temperate" {
            return some(String("minecraft:egg"))
        }
        if name == "minecraft:warm" {
            return some(String("minecraft:brown_egg"))
        }
        if name == "minecraft:cold" {
            return some(String("minecraft:blue_egg"))
        }
        return none
    }

    /// Whether it's an armadillo that's scared, `isScared`: in any state but idle (CAL-160).
    pub fn scared(self) -> bool {
        return self.species == ARMADILLO and self.living.data.number(OWN) != ARMADILLO_IDLE
    }

    /// An armadillo's state, `getState`, by its ID.
    pub fn armadillo_state(self) -> i32 {
        return self.living.data.number(OWN)
    }

    // `switchToState`: its state set, and where that changed it its ticks in it counted from 0
    // again, `onSyncedDataUpdated`, and its ambient sound as it is now.
    fn switch_to_state(mut self, state: i32) {
        if self.living.data.number(OWN) == state {
            return
        }
        self.living.data.set(OWN, Value.Number(state))
        self.in_state_ticks = 0
        self.refresh_sounds()
    }

    // `makeSound`: the sound as loud as its sounds, its voice's pitch drawn.
    fn make_sound(mut self, sounds: mut List<EntitySound>, sound: str) {
        let pitch = self.voice_pitch()
        self.living.play(mut sounds, String(sound), self.sound_volume, pitch)
    }

    // `Mob.stopInPlace`: its navigation stopped, still, `setSpeed(0)` its forward too, and its
    // motion none, where `body` and its body's not stopped already, as its hurt stops it.
    // Leashes come with CAL-179.
    fn stop_in_place(mut self, body: bool) {
        self.navigation.stop()
        if body {
            self.living.xxa = 0.0f32
            self.living.yya = 0.0f32
            self.living.speed = 0.0f32
            self.living.zza = 0.0f32
            self.living.body.vx = 0.0
            self.living.body.vy = 0.0
            self.living.body.vz = 0.0
        }
    }

    // `Armadillo.rollUp`: where it isn't scared, stopped in place, its body too where `body`,
    // out of love, `resetLove`, its roll heard, `makeSound`, and rolling. Its game event comes
    // with game events.
    fn roll_up(mut self, body: bool, sounds: mut List<EntitySound>) {
        if self.scared() {
            return
        }
        self.stop_in_place(body)
        self.in_love = 0
        self.make_sound(mut sounds, "entity.armadillo.roll")
        self.switch_to_state(ARMADILLO_ROLLING)
    }

    // `Armadillo.rollOut`: where it's scared, its unrolling's end heard and idle.
    fn roll_out(mut self, sounds: mut List<EntitySound>) {
        if not self.scared() {
            return
        }
        self.make_sound(mut sounds, "entity.armadillo.unroll_finish")
        self.switch_to_state(ARMADILLO_IDLE)
    }

    // `canStayRolledUp`: not panicking nor in a liquid. Leashes and riding come later.
    fn can_stay_rolled_up(self) -> bool {
        return not self.panicking() and not self.in_liquid()
    }

    // `isInLiquid`: in water or lava.
    fn in_liquid(self) -> bool {
        return self.living.body.in_water or self.living.body.in_lava()
    }

    /// Whether it panics, `PathfinderMob.isPanicking`: a brain mob where its brain holds
    /// `IS_PANICKING`, any other where a `PanicGoal` of its runs.
    pub fn panicking(self) -> bool {
        if let b = self.brain {
            return b.has(MEMORY_IS_PANICKING)
        }
        return self.goals.panicking()
    }

    /// Whether it's undead, `#undead`: a zombie, skeleton, zombie villager or zombie horse.
    pub fn undead(self) -> bool {
        let s = self.species
        return s == ZOMBIE or s == SKELETON or s == ZOMBIE_VILLAGER or s == ZOMBIE_HORSE
    }

    /// How far it turns its head from its body, `getMaxHeadYRot`: an armadillo's 32, none while
    /// it's scared; any other's 75.
    pub fn max_head_y_rot(self) -> f32 {
        if self.species == ARMADILLO {
            return if self.scared() { 0.0f32 } else { 32.0f32 }
        }
        return MAX_HEAD_Y_ROT
    }

    // `Mob.clampHeadRotationToBody`: its head kept within its reach of its body.
    fn clamp_head(mut self) {
        let limit = self.max_head_y_rot()
        let head = self.living.y_head_rot
        let delta = wrap_degrees(self.living.y_body_rot - head)
        let target = clamp(wrap_degrees(self.living.y_body_rot - head), -limit, limit)
        self.living.y_head_rot = head + delta - target
    }

    // `pickNextScuteDropTime`: 6,000 to 11,999 ticks, drawn.
    fn pick_scute_time(mut self) -> i32 {
        return self.living.body.random.next_int_below(6000) + 6000
    }

    // `ArmadilloBallUp.pickNextPeekTimer`: its scared animation's 50 ticks and 100 to 400 more,
    // drawn.
    fn pick_peek(mut self) -> i32 {
        return animation_of(ARMADILLO_SCARED) + self.living.body.random.next_int_between(100, 400)
    }

    /// The living entity `id` near it, as its level found it for its brain this tick, if it did.
    pub fn near_of(self, id: i32) -> Near? {
        for n in self.near {
            if n.id == id {
                return some(n)
            }
        }
        for n in self.near_items {
            if n.id == id {
                return some(n)
            }
        }
        return none
    }

    /// The IDs of the entities its brain's memories hold, which its level finds for it as it
    /// ticks wherever they are, `near`: the living entities its sensor found, its partner, what
    /// hurt it, the adult and player it follows, and its look and walk targets'; and the player
    /// it trades with (CAL-160).
    pub fn watched(self) -> List<i32> {
        var out = List<i32>()
        let b = self.brain else return out
        if let t = self.trading {
            out.push(t.id)
        }
        for id in b.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            out.push(id)
        }
        let held: List<i32> = [MEMORY_BREED_TARGET, MEMORY_HURT_BY_ENTITY, MEMORY_NEAREST_VISIBLE_ADULT, MEMORY_TEMPTING_PLAYER, MEMORY_NEAREST_VISIBLE_WANTED_ITEM]
        for m in held {
            if let id = b.entity(m) {
                out.push(id)
            }
        }
        if let t = b.tracker(MEMORY_LOOK_TARGET) {
            if let Tracker.Entity(e) = t {
                out.push(e.id)
            }
        }
        if let w = b.walk(MEMORY_WALK_TARGET) {
            if let Tracker.Entity(e) = w.target {
                out.push(e.id)
            }
        }
        return out
    }

    // Where the tracker `t` is now, `currentPosition`: a place's own, or an entity's feet or eyes;
    // none for an entity its level didn't find.
    fn tracked_place(self, t: Tracker) -> (f64, f64, f64)? {
        match t {
            Tracker.Block(s) => return some((s.px, s.py, s.pz)),
            Tracker.Entity(e) => {
                let n = self.near_of(e.id) else return none
                return some((n.x, if e.eyes { n.y + f64(n.eyes) } else { n.y }, n.z))
            },
        }
    }

    // The block the tracker `t` is at now, `currentBlockPosition`: a place's own, or the block of
    // an entity's feet or, `targetEyeHeight`, its eyes.
    fn tracked_block(self, t: Tracker) -> (i32, i32, i32)? {
        match t {
            Tracker.Block(s) => return some((s.x, s.y, s.z)),
            Tracker.Entity(e) => {
                let n = self.near_of(e.id) else return none
                let y = if e.target_eyes { n.y + f64(n.eyes) } else { n.y }
                return some((floor_of(n.x), floor_of(y), floor_of(n.z)))
            },
        }
    }

    // `Sensor.isEntityTargetable`, its brain's sight test of the living entity `e`,
    // `TargetingConditions.forNonCombat` at the range sensors last set theirs to, `sensor_range`:
    // not itself, seen by anyone, `canBeSeenByAnyone`, alive and not spectating; within the range
    // times how visible it is to it, 2 at least, from its feet to theirs; and in its sight, as its
    // sensing remembers it for the tick (CAL-160).
    fn targetable<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, e: Near) -> bool {
        if e.id == self.living.body.id or not e.alive or e.spectator {
            return false
        }
        let within = (self.sensor_range * e.visibility).max(2.0)
        if self.distance_sqr_to(e.x, e.y, e.z) > within * within {
            return false
        }
        if let k = self.sensing.known(e.id) {
            return k
        }
        let who = self.looker()
        let seen = sees(m, f, blocks, who.mover, who.x, who.eye_y, who.z, e.x, e.y + f64(e.eyes), e.z)
        self.sensing.note(e.id, seen)
        return seen
    }

    // Whether its brain may see the `i`th of its visible living entities `seen`,
    // `lineOfSightTest`, as it found the first time it was asked, else found and kept now.
    fn visible_at<B: CollisionBlocks>(mut self, seen: mut Visible, i: usize, f: Facts, m: MovementStates, blocks: B) -> bool {
        if seen.seen[i] >= 0i8 {
            return seen.seen[i] == 1i8
        }
        var fine = false
        if let e = self.near_of(seen.ids[i]) {
            fine = self.targetable(f, m, blocks, e)
        }
        seen.seen[i] = if fine { 1i8 } else { 0i8 }
        return fine
    }

    // `NearestVisibleLivingEntities.contains`: whether `id` is among its brain's visible living
    // entities, and it may see it.
    fn sees_near<B: CollisionBlocks>(mut self, brain: mut Brain, id: i32, f: Facts, m: MovementStates, blocks: B) -> bool {
        var seen = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) else return false
        var out = false
        for i in 0..seen.ids.len() {
            if seen.ids[i] == id {
                out = self.visible_at(mut seen, i, f, m, blocks)
                break
            }
        }
        brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
        return out
    }

    // `PositionTracker.isVisibleBy`: a place always, and an entity that isn't living, an item; a
    // living one where it's alive and among its brain's visible living entities, which it may see.
    fn tracker_visible<B: CollisionBlocks>(mut self, brain: mut Brain, t: Tracker, f: Facts, m: MovementStates, blocks: B) -> bool {
        match t {
            Tracker.Block(_) => return true,
            Tracker.Entity(e) => {
                let n = self.near_of(e.id) else return false
                if n.species == ITEM {
                    return true
                }
                if not n.alive {
                    return false
                }
                return self.sees_near(mut brain, e.id, f, m, blocks)
            },
        }
    }

    // `NearestVisibleLivingEntities.findClosest`: the nearest of its brain's visible living
    // entities of the kind `pick` asks for, which it may see, its sight tested only of those the
    // kind fits, in their order: `PICK_PLAYER` a player within `within` squared of it; `PICK_ADULT`
    // a grown one of its own kind; and `PICK_PARTNER` one of its kind in love, as it is, not
    // panicking, `canMate`.
    fn find_closest<B: CollisionBlocks>(mut self, brain: mut Brain, pick: i32, within: f64, f: Facts, m: MovementStates, blocks: B) -> i32? {
        var seen = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) else return none
        var out: i32? = none
        for i in 0..seen.ids.len() {
            let e = self.near_of(seen.ids[i]) else continue
            var fits = false
            if pick == PICK_PLAYER {
                fits = e.species == PLAYER and self.distance_sqr_to(e.x, e.y, e.z) <= within
            } else if pick == PICK_ADULT {
                fits = e.species == self.species and not e.baby
            } else {
                fits = e.species == self.species and self.in_love > 0 and e.in_love and not e.panicking
            }
            if fits and self.visible_at(mut seen, i, f, m, blocks) {
                out = some(e.id)
                break
            }
        }
        brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
        return out
    }

    // `Brain.tick` (CAL-160): its memories that may run out a tick nearer it,
    // `forgetOutdatedMemories`; each sensor that's due scanning, `tickSensors`; each behavior not
    // running of an activity that's on tried, `startEachNonRunningBehavior`; then each running as
    // the starts left them ticked, or stopped where it can't go on, `tickEachRunningBehavior`; all
    // in the brain's order at the level's game time, durations drawn from the level's random,
    // which its level lent it. A behavior that swung a door stops it there, for its level to set
    // the door as vanilla's sets it then and there, and finding the paths it's on again, before
    // it goes on with the next behavior, and one whose tick broke a block stops it for its level
    // to break it, before the next running behavior ticks: whether it stopped (CAL-160).
    fn tick_brain<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        var brain = self.brain.take() else return false
        let lent = self.level_random.take()
        let had = lent != none
        if not had {
            self.living.show(Shown.Missing(String("A brain's tick without its level's random")), sounds.len())
        }
        var random = lent ?? TapedRandom.new(0i64)
        let now = self.game_time
        // A stop of its sleep since its last tick, where the blocks around it weren't there.
        self.wake_if_due(mut brain, f, m, blocks, now, sounds)
        var runs = List<Run>()
        // The brain its behaviors were taken from, once a behavior's made it again, `refreshBrain`:
        // as vanilla's `Brain.tick` goes on over its own behaviors by its own activities, which
        // read and change the mob's new brain, `getBrain`.
        var old: Brain? = none
        var from: usize = 0
        var ticking: List<usize>? = none
        var tick_from: usize = 0
        if let held = self.held_brain.take() {
            runs = held.runs
            old = held.old
            from = held.at
            ticking = held.ticking
            tick_from = held.tick_at
        } else {
            brain.forget_outdated()
            for i in 0..brain.sensors.len() {
                if brain.sensor_due(i) {
                    let kind = brain.sensors[i].kind
                    if kind == SENSOR_NEAREST_BED {
                        self.sense_bed(mut brain, i, now, mut random, lf, f, m, blocks, mut cache, min_y)
                    } else {
                        self.sense(mut brain, kind, lf, f, m, blocks, players, sounds)
                    }
                }
            }
            runs = brain.take_runs()
        }
        for i in from..runs.len() {
            let on = if let o = old { o.is_active(runs[i].activity) } else { brain.is_active(runs[i].activity) }
            if not runs[i].deed.running and on {
                _ = self.try_start(mut brain, mut runs[i].deed, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds)
                if self.refresh_due {
                    self.refresh_due = false
                    // `refreshBrain`: its behaviors running stopped, `stopAll`, and a brain made
                    // for its profession now with its memories, its schedule's activity on.
                    for j in 0..runs.len() {
                        if runs[j].deed.running {
                            self.do_stop(mut brain, mut runs[j].deed, mut random, mut sounds)
                        }
                    }
                    self.wake_if_due(mut brain, f, m, blocks, now, sounds)
                    var made = self.villager_brain()
                    made.unpack(brain.packed())
                    let scheduled = made.scheduled(self.villager_activity, self.baby_activity)
                    made.update_from_schedule(now, scheduled)
                    old = some(brain)
                    brain = made
                }
                if self.stop_due {
                    self.stop_due = false
                    self.held_brain = some(HeldBrain { runs: runs, at: i + 1, old: old })
                    self.brain = some(brain)
                    if had {
                        self.level_random = some(random)
                    }
                    return true
                }
            }
        }
        var running = List<usize>()
        if let held = ticking {
            running = held
        } else {
            for i in 0..runs.len() {
                if runs[i].deed.running {
                    running.push(i)
                }
            }
        }
        for k in tick_from..running.len() {
            let i = running[k]
            self.tick_or_stop(mut brain, mut runs[i].deed, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds)
            self.wake_if_due(mut brain, f, m, blocks, now, sounds)
            if self.stop_due {
                // A behavior's tick broke a block, which its level breaks then and there, its
                // drops drawn, before the next running behavior ticks (CAL-160).
                self.stop_due = false
                let all = runs.len()
                self.held_brain = some(HeldBrain { runs: runs, at: all, old: old, ticking: some(running), tick_at: k + 1 })
                self.brain = some(brain)
                if had {
                    self.level_random = some(random)
                }
                return true
            }
        }
        if old == none {
            brain.give_back_runs(runs)
        }
        self.brain = some(brain)
        if had {
            self.level_random = some(random)
        }
        return false
    }

    // The sensor of the kind `kind` scanning, `doTick`, after the range of the sensors' targeting
    // is set to its follow range, `updateTargetingConditionRanges`.
    fn sense<B: CollisionBlocks>(mut self, brain: mut Brain, kind: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, _sounds: List<EntitySound>) {
        let follow = self.living.attributes.value(lf.follow_range)
        self.sensor_range = follow
        if kind == SENSOR_NEAREST_LIVING {
            // `NearestLivingEntitySensor`: the living entities alive whose boxes meet its own grown
            // by its follow range, nearest first, and as its visible ones, none tested yet.
            let b = self.living.body.bounding_box()
            let (x0, y0, z0) = (b.min_x - follow, b.min_y - follow, b.min_z - follow)
            let (x1, y1, z1) = (b.max_x + follow, b.max_y + follow, b.max_z + follow)
            var found = List<(f64, i32)>()
            for n in self.near {
                if n.alive and n.id != self.living.body.id and n.bounds.intersects(x0, y0, z0, x1, y1, z1) {
                    found.push((self.distance_sqr_to(n.x, n.y, n.z), n.id))
                }
            }
            // An insertion sort by distance, stable as `List.sort` is.
            for i in 1..found.len() {
                var j = i
                while j > 0 {
                    let (a, _) = found[j - 1]
                    let (c, _) = found[j]
                    if a <= c {
                        break
                    }
                    found.swap(j - 1, j)
                    j -= 1
                }
            }
            var ids = List<i32>()
            var tested = List<i8>()
            for (_, id) in found {
                ids.push(id)
                tested.push(-1i8)
            }
            brain.set(MEMORY_NEAREST_LIVING_ENTITIES, Memo.Entities(ids.copy()))
            brain.set(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, Memo.Visible(Visible { ids: ids, seen: tested }))
        } else if kind == SENSOR_HURT_BY {
            // `HurtBySensor`: what last hurt it within 40 ticks, and the living entity behind it;
            // that one forgotten once it isn't alive or here.
            match self.living.recent_damage(self.game_time) {
                some(d) => {
                    let by = if d.player != none or d.living_cause { some(d.cause) } else { none }
                    brain.set(MEMORY_HURT_BY, Memo.Hurt(HurtMemo { kind: d.kind, tags: self.living.last_damage_tags, by: by }))
                    if let id = by {
                        brain.set(MEMORY_HURT_BY_ENTITY, Memo.Entity(id))
                    }
                },
                none => brain.erase(MEMORY_HURT_BY),
            }
            if let id = brain.entity(MEMORY_HURT_BY_ENTITY) {
                let alive = if let n = self.near_of(id) { n.alive } else { false }
                if not alive {
                    brain.erase(MEMORY_HURT_BY_ENTITY)
                }
            }
        } else if kind == SENSOR_FOOD_TEMPTATIONS {
            // `TemptingSensor.forAnimal`: of the level's players, not spectating, those its
            // `TEMPT_TARGETING` finds within its tempt range, sight not needed, holding its food in
            // either hand; the nearest, the first of those as near.
            let range = self.living.attributes.value(lf.tempt_range)
            let food = self.food_set()
            var best = -1.0
            var found: i32? = none
            for p in players {
                if p.spectator or p.dead or p.tempts & food == 0u32 {
                    continue
                }
                let within = (range * p.visibility(i32.wrap(self.living.kind))).max(2.0)
                let d = self.distance_sqr_to(p.x, p.y, p.z)
                if d > within * within {
                    continue
                }
                if found == none or d < best {
                    best = d
                    found = some(p.id)
                }
            }
            match found {
                some(id) => brain.set(MEMORY_TEMPTING_PLAYER, Memo.Entity(id)),
                none => brain.erase(MEMORY_TEMPTING_PLAYER),
            }
        } else if kind == SENSOR_NEAREST_ADULT {
            // `AdultSensor`: the nearest of its visible living entities of its kind that's grown.
            if brain.has(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) {
                match self.find_closest(mut brain, PICK_ADULT, 0.0, f, m, blocks) {
                    some(id) => brain.set(MEMORY_NEAREST_VISIBLE_ADULT, Memo.Entity(id)),
                    none => brain.erase(MEMORY_NEAREST_VISIBLE_ADULT),
                }
            }
        } else if kind == SENSOR_ARMADILLO_SCARE {
            // `MobSensor` of `Armadillo.isScaredBy`: where it can stay rolled up, danger seen for
            // 80 ticks where any of the living its sensor found scares it; else that forgotten.
            if not self.can_stay_rolled_up() {
                brain.erase(MEMORY_DANGER_DETECTED_RECENTLY)
            } else {
                var scared = false
                for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
                    if let n = self.near_of(id) {
                        if self.scared_by(n) {
                            scared = true
                            break
                        }
                    }
                }
                if scared {
                    brain.set_for(MEMORY_DANGER_DETECTED_RECENTLY, Memo.Flag(true), 80)
                }
            }
        } else if kind == SENSOR_NEAREST_PLAYERS {
            // `PlayerSensor`: the players not spectating nearer than its follow range, nearest
            // first, and the nearest of them it may see. Those it may attack aren't kept, as no
            // villager's behavior reads them.
            var found = List<(f64, i32)>()
            for n in self.near {
                if n.species == PLAYER and not n.spectator {
                    let d = self.distance_sqr_to(n.x, n.y, n.z)
                    if d < follow * follow {
                        found.push((d, n.id))
                    }
                }
            }
            sort_nearest(mut found)
            var ids = List<i32>()
            for (_, id) in found {
                ids.push(id)
            }
            var visible: i32? = none
            for id in ids {
                let n = self.near_of(id) else continue
                if self.targetable(f, m, blocks, n) {
                    visible = some(id)
                    break
                }
            }
            brain.set(MEMORY_NEAREST_PLAYERS, Memo.Entities(ids))
            match visible {
                some(id) => brain.set(MEMORY_NEAREST_VISIBLE_PLAYER, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_VISIBLE_PLAYER),
            }
        } else if kind == SENSOR_NEAREST_ITEMS {
            // `NearestItemSensor`: of the items its level found around it, nearest first, those
            // as near in the order found, the first it wants, nearer than 32, that it may see,
            // `hasLineOfSight`, its eyes to the item's; or none.
            var order = List<(f64, usize)>()
            for i in 0..self.near_items.len() {
                let n = self.near_items[i]
                if n.gone or not n.wanted {
                    continue
                }
                order.push((self.distance_sqr_to(n.x, n.y, n.z), i))
            }
            for i in 1..order.len() {
                var j = i
                while j > 0 {
                    let (p, _) = order[j - 1]
                    let (q, _) = order[j]
                    if p <= q {
                        break
                    }
                    order.swap(j - 1, j)
                    j -= 1
                }
            }
            var found: i32? = none
            let who = self.looker()
            for (d, i) in order {
                if not (d < 1024.0) {
                    continue
                }
                let n = self.near_items[i]
                if sees(m, f, blocks, who.mover, who.x, who.eye_y, who.z, n.x, n.y + f64(n.eyes), n.z) {
                    found = some(n.id)
                    break
                }
            }
            match found {
                some(id) => brain.set(MEMORY_NEAREST_VISIBLE_WANTED_ITEM, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_VISIBLE_WANTED_ITEM),
            }
        } else if kind == SENSOR_VILLAGER_HOSTILES {
            // `VillagerHostilesSensor`: the nearest of its visible living entities that's a
            // hostile within that kind's distance of it, or none.
            match self.find_closest_of(mut brain, PICK_HOSTILE, 0, -1.0, f, m, blocks) {
                some(id) => brain.set(MEMORY_NEAREST_HOSTILE, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_HOSTILE),
            }
        } else if kind == SENSOR_VILLAGER_BABIES {
            // `VillagerBabiesSensor`: its visible living entities that are baby villagers, which
            // it may see, in their order.
            var babies = List<i32>()
            if let held = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) {
                var seen = held
                for i in 0..seen.ids.len() {
                    let e = self.near_of(seen.ids[i]) else continue
                    if e.species == VILLAGER and e.baby and self.visible_at(mut seen, i, f, m, blocks) {
                        babies.push(e.id)
                    }
                }
                brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
            }
            brain.set(MEMORY_VISIBLE_VILLAGER_BABIES, Memo.Entities(babies))
        } else if kind == SENSOR_SECONDARY_POIS {
            // `SecondaryPoiSensor`: the blocks within 4 across and 2 up or down its profession
            // works at too, `secondaryPoi`, a farmer's farmland, x, then y, then z.
            let (_, profession, _) = self.living.data.villager(OWN + 1)
            var sites = List<GlobalPos>()
            if profession == FARMER {
                let farmland = f.block_named(String("minecraft:farmland")) ?? u32.MAX
                let (cx, cy, cz) = self.block_position()
                for x in -4..5 {
                    for y in -2..3 {
                        for z in -4..5 {
                            if f.block(state_at(blocks, cx + x, cy + y, cz + z)) == farmland {
                                sites.push(GlobalPos { dimension: self.dimension.copy(), pos: BlockPos { x: cx + x, y: cy + y, z: cz + z } })
                            }
                        }
                    }
                }
            }
            if sites.is_empty() {
                brain.erase(MEMORY_SECONDARY_JOB_SITE)
            } else {
                brain.set(MEMORY_SECONDARY_JOB_SITE, Memo.Places(sites))
            }
        }
        // `GolemSensor`'s iron golem among the living its sensor found is one Calcite doesn't make
        // yet, so it never finds one.
    }

    // `NearestBedSensor` of the sensor `i` (CAL-160): a baby's, its tries started again and the
    // game time it says it is drawn from the level's random, up to 19 ticks on; then the beds
    // within 48 of it, of those not tried lately, the first 4, each not tried again till 40 ticks
    // after that time; the nearest it can reach of them, `findPathToPois`, its nearest bed; else,
    // where it tried fewer than 5, those whose time's before then tried again.
    fn sense_bed<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, i: usize, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        if not self.baby() {
            return
        }
        var s = brain.sensors[i].copy()
        s.tried = 0
        s.last_update = now + i64(random.next_int_below(20))
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        var targets = List<(i32, i32, i32)>()
        for r in pois.in_range(types_of(1u32 << u32.wrap(HOME)), center, 48, Occupancy.Any) {
            let key = r.pos.pack()
            if s.tried_beds.contains(key) {
                continue
            }
            s.tried += 1
            if s.tried >= 5 {
                continue
            }
            s.tried_beds.insert(key, s.last_update + 40)
            targets.push((r.pos.x, r.pos.y, r.pos.z))
        }
        var found = false
        if not targets.is_empty() {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path_to_any(lf, f, nf, m, blocks, mut cache, w, targets, 1) {
                if p.reached {
                    found = true
                    let (tx, ty, tz) = p.target
                    let target = BlockPos { x: tx, y: ty, z: tz }
                    if pois.type_at(target) != none {
                        brain.set(MEMORY_NEAREST_BED, Memo.Block(target))
                    }
                }
            }
        }
        if not found and s.tried < 5 {
            var stale = List<i64>()
            for (k, t) in s.tried_beds {
                if t < s.last_update {
                    stale.push(k)
                }
            }
            for k in stale {
                _ = s.tried_beds.remove(k)
            }
        }
        self.pois = some(pois)
        brain.sensors[i] = s
    }

    // `NearestVisibleLivingEntities.findClosest` of a kind (CAL-160): the nearest of its brain's
    // visible living entities that `pick` fits, within `within` squared of it where that isn't
    // below 0, which it may see, its sight tested only of those that fit, in their order:
    // `PICK_SPECIES` one of the kind `which`, `PICK_CATEGORY` one of the mob category `which`, and
    // `PICK_HOSTILE` a hostile a villager fears within that kind's distance of it.
    fn find_closest_of<B: CollisionBlocks>(mut self, brain: mut Brain, pick: i32, which: i32, within: f64, f: Facts, m: MovementStates, blocks: B) -> i32? {
        var seen = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) else return none
        var out: i32? = none
        for i in 0..seen.ids.len() {
            let e = self.near_of(seen.ids[i]) else continue
            let d = self.distance_sqr_to(e.x, e.y, e.z)
            var fits = false
            if pick == PICK_SPECIES {
                fits = e.species == which
            } else if pick == PICK_BREEDABLE {
                fits = e.species == which and e.can_breed
            } else if pick == PICK_CATEGORY {
                fits = e.category == which
            } else {
                let h = hostile_distance(e.species)
                fits = h > 0.0 and d <= h * h
            }
            if fits and within >= 0.0 {
                fits = d <= within
            }
            if fits and self.visible_at(mut seen, i, f, m, blocks) {
                out = some(e.id)
                break
            }
        }
        brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
        return out
    }

    // `Armadillo.isScaredBy`: what's within 7 across and 2 up or down of its box, and undead, or
    // what last hurt it, or a player not spectating who sprints or rides.
    fn scared_by(self, n: Near) -> bool {
        let b = self.living.body.bounding_box()
        if not n.bounds.intersects(b.min_x - 7.0, b.min_y - 2.0, b.min_z - 7.0, b.max_x + 7.0, b.max_y + 2.0, b.max_z + 7.0) {
            return false
        }
        if n.undead {
            return true
        }
        if let by = self.living.hurt_by_mob {
            if by == n.uuid {
                return true
            }
        }
        if n.species == PLAYER {
            return not n.spectator and (n.sprinting or n.passenger)
        }
        return false
    }

    // `tryStart` of the behavior `d` at the game time `now`, as its kind starts: a gate where it
    // has its memories, shuffled, the first of its behaviors not running that starts, or a
    // `TriggerGate`'s first that has its memories and does what it does; any other where it has its
    // memories and its kind's conditions hold, its duration drawn and its start.
    fn try_start<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, d: mut Deed, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if let Behavior.Gate(_) = d.kind {
            var g = d.gate.take() else return false
            if not brain.meets(g.needs) {
                d.gate = some(g)
                return false
            }
            d.running = true
            if not g.ordered {
                g.shuffle()
            }
            if g.trigger {
                for i in 0..g.entries.len() {
                    let kind = g.entries[i].deed.kind
                    if brain.meets(entry_of(g.entries[i].deed)) and self.may_start(mut brain, kind, mut g.entries[i].deed.keep, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds) {
                        break
                    }
                }
                d.gate = some(g)
                return true
            }
            for i in 0..g.entries.len() {
                if not g.entries[i].deed.running and self.try_start(mut brain, mut g.entries[i].deed, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds) {
                    break
                }
            }
            d.gate = some(g)
            return true
        }
        if not brain.meets(entry_of(d)) {
            return false
        }
        let kind = d.kind
        if not self.may_start(mut brain, kind, mut d.keep, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds) {
            return false
        }
        d.running = true
        if timed(kind) {
            start_deed(mut d, now, mut random)
            self.start_behavior(mut brain, kind, mut d.keep, now, mut random, lf, f, m, blocks, min_y, mut sounds)
        }
        return true
    }

    // Whether the behavior of the kind `kind` may start, `checkExtraStartConditions`, or a
    // one-shot's trigger, which does what it does then and there.
    fn may_start<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        match kind {
            Behavior.Swim(_) => return self.floats(),
            Behavior.Panic(_) => {
                // `AnimalPanic`'s: hurt by what panics it, an armadillo
                // `#panic_environmental_causes`, or panicking.
                if let h = brain.hurt(MEMORY_HURT_BY) {
                    if h.tags & PANIC_ENVIRONMENTAL_CAUSES != 0u32 {
                        return true
                    }
                }
                return brain.has(MEMORY_IS_PANICKING)
            },
            Behavior.MoveToTarget(armadillo) => {
                if armadillo and self.scared() {
                    return false
                }
                if keep.cooldown > 0 {
                    keep.cooldown -= 1
                    return false
                }
                let walk = brain.walk(MEMORY_WALK_TARGET) else return false
                let reached = self.reached(walk)
                if not reached and self.compute_path(mut brain, walk, mut keep, now, lf, f, m, blocks, mut cache, min_y) {
                    keep.last_target = self.tracked_block(walk.target)
                    return true
                }
                brain.erase(MEMORY_WALK_TARGET)
                if reached {
                    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                }
                return false
            },
            Behavior.RollOut(_) => {
                if self.scared() {
                    self.roll_out(mut sounds)
                    return true
                }
                return false
            },
            Behavior.LookSometimes(look) => {
                let found = self.find_closest(mut brain, PICK_PLAYER, f64(look.max_dist_sqr), f, m, blocks) else return false
                // `Ticker.tickDownAndCheck`: at 0, its count drawn from the level's random less
                // one, not yet; else down one, and now where that's 0.
                if keep.ticks == 0 {
                    keep.ticks = random.next_int_between(look.min_interval, look.max_interval) - 1
                    return false
                }
                keep.ticks -= 1
                if keep.ticks != 0 {
                    return false
                }
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: found, eyes: true })))
                return true
            },
            // `AnimalMakeLove.checkExtraStartConditions`: in love, with a partner it sees,
            // `findValidBreedPartner`.
            Behavior.MakeLove(_) => return self.in_love > 0 and self.find_closest(mut brain, PICK_PARTNER, 0.0, f, m, blocks) != none,
            Behavior.FollowAdult(follow) => {
                let (least, most, speed) = follow
                if not self.baby() {
                    return false
                }
                let adult = brain.entity(MEMORY_NEAREST_VISIBLE_ADULT) else return false
                let n = self.near_of(adult) else return false
                let d = self.distance_sqr_to(n.x, n.y, n.z)
                let far = f64(most + 1)
                let near = f64(least)
                if d < far * far and not (d < near * near) {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: adult, eyes: false }), speed: speed, close_enough: least - 1 }))
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: adult, eyes: true })))
                    return true
                }
                return false
            },
            Behavior.Stroll(speed) => {
                match self.random_place(true, 10, 7, lf, f, blocks, mut cache, min_y) {
                    some(p) => {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                    },
                    none => brain.erase(MEMORY_WALK_TARGET),
                }
                return true
            },
            Behavior.WalkToLook(walk) => {
                let (speed, close) = walk
                let t = brain.tracker(MEMORY_LOOK_TARGET) else return false
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: t, speed: speed, close_enough: close }))
                return true
            },
            Behavior.BallUp(_) => return self.living.body.on_ground and not self.in_liquid(),
            Behavior.Doors(_) => {
                // `InteractWithDoor` (CAL-160): where the path its `PATH` memory holds is started
                // and not done, the same next node as it last checked counted 20 again, else
                // nothing while that counts down; then the door at the node it last passed opened
                // where it's shut, and kept to close, and the one at its next node opened and kept
                // where it's shut; then those it keeps closed behind it, `close_doors`. What it
                // swings its level does as its brain's tick stops for it, before the rest.
                let id = brain.path(MEMORY_PATH) else return false
                let about = self.navigation.about_path(id) else return false
                let (passed, ahead) = about
                var same = false
                if let last = keep.last_node {
                    same = last == ahead
                }
                if same {
                    keep.cooldown = 20
                } else {
                    keep.cooldown -= 1
                    if keep.cooldown > 0 {
                        return false
                    }
                }
                keep.last_node = some(ahead)
                var swung = List<(i32, i32, i32, u32)>()
                let (ax, ay, az) = passed
                let from_state = door_state(blocks, swung, ax, ay, az)
                if mob_door(f, from_state) {
                    if not f.get_bool(from_state, "open") {
                        self.swing_door(f, blocks, mut swung, passed, from_state, true, mut random, mut sounds)
                    }
                    remember_door(mut brain, self.dimension, passed)
                }
                let (bx, by, bz) = ahead
                let to_state = door_state(blocks, swung, bx, by, bz)
                if mob_door(f, to_state) and not f.get_bool(to_state, "open") {
                    self.swing_door(f, blocks, mut swung, ahead, to_state, true, mut random, mut sounds)
                    remember_door(mut brain, self.dimension, ahead)
                }
                if brain.has(MEMORY_DOORS_TO_CLOSE) {
                    self.close_doors(mut brain, some(passed), some(ahead), f, blocks, mut swung, mut random, mut sounds)
                }
                return true
            },
            // `ReactToBell`: having heard a bell, and with no raid where it is, as there never is
            // yet, its hiding on where it may hide, else its default activity.
            Behavior.ReactToBell(_) => {
                brain.set_if_possible(ACTIVITY_HIDE)
                return true
            },
            Behavior.HideState(h) => return self.hide_state(mut brain, mut keep, h, now),
            Behavior.LocateHiding(l) => return self.locate_hiding(mut brain, l),
            // `SetRaidStatus`: one tick in 20, drawn from the level's random, a raid's activity on
            // where there's a raid there, which there never is yet.
            Behavior.RaidStatus(_) => return random.next_int_below(20) == 0,
            Behavior.ValidatePoi(v) => {
                let (memory, kinds) = v
                return self.validate_poi(mut brain, memory, kinds, f, blocks)
            },
            Behavior.CompetitorScan(_) => {
                self.scan_competitors(mut brain)
                return true
            },
            Behavior.FollowTrader(_) => return self.follows_trader(),
            Behavior.GoToItem(g) => {
                // `GoToWantedItem`: the item it wants, where it's waited out its pickup cooldown,
                // nearer than so many blocks, its block within the world border, and it may pick
                // things up, `canPickUpLoot`, looked at and walked to.
                let (speed, _, within) = g
                let id = brain.entity(MEMORY_NEAREST_VISIBLE_WANTED_ITEM) else return false
                if brain.has(MEMORY_ITEM_PICKUP_COOLDOWN_TICKS) {
                    return false
                }
                let n = self.near_of(id) else return false
                if not (self.distance_sqr_to(n.x, n.y, n.z) < f64(within * within)) {
                    return false
                }
                let (west, north, east, south) = self.border ?? widest_border()
                let bx = f64(floor_of(n.x))
                let bz = f64(floor_of(n.z))
                if not (bx >= west and bx < east and bz >= north and bz < south) or not self.can_pick_up_loot {
                    return false
                }
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: speed, close_enough: 0 }))
                return true
            },
            Behavior.AcquirePoi(a) => return self.acquire_poi(mut brain, a, mut keep, now, mut random, lf, f, m, blocks, mut cache, min_y, sounds),
            Behavior.GoToJobSite(_) => {
                // `GoToPotentialJobSite.checkExtraStartConditions`: its activity other than its
                // core one idle, work or play, or none.
                return match brain.active_non_core() {
                    some(a) => a == ACTIVITY_IDLE or a == ACTIVITY_WORK or a == ACTIVITY_PLAY,
                    none => true,
                }
            },
            Behavior.YieldJobSite(speed) => return self.yield_job_site(mut brain, speed, sounds),
            Behavior.AssignProfession(_) => return self.assign_profession(mut brain, sounds),
            Behavior.ResetProfession(_) => {
                // `ResetProfession`: one with a profession, but a nitwit, no experience and at
                // level 1 at most, with no job site, losing it, its brain made again.
                let (vtype, profession, level) = self.living.data.villager(OWN + 1)
                if profession == NO_PROFESSION or profession == NITWIT or self.villager_xp != 0 or level > 1 {
                    return false
                }
                self.set_profession(vtype, NO_PROFESSION, level)
                return true
            },
            Behavior.InteractWith(i) => {
                // `InteractWith.of`: where it may, `selfFilter`, any of the kind among its visible
                // living entities it may see that may be, `targetFilter`; the nearest such within
                // its range, if any, its target, looked at and walked to till it's as near as it
                // stops. Breeding's filters are both `canBreed`.
                if i.breed and not self.villager_can_breed() {
                    return false
                }
                let pick = if i.breed { PICK_BREEDABLE } else { PICK_SPECIES }
                if self.find_closest_of(mut brain, pick, i.species, -1.0, f, m, blocks) == none {
                    return false
                }
                let range = f64(i.range * i.range)
                if let id = self.find_closest_of(mut brain, pick, i.species, range, f, m, blocks) {
                    brain.set(i.memory, Memo.Entity(id))
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: i.speed, close_enough: i.stop }))
                }
                return true
            },
            Behavior.VillageStroll(s) => {
                let (speed, h, v) = s
                match self.village_stroll_place(h, v, lf, f, blocks, mut cache, min_y) {
                    some(p) => {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                    },
                    none => brain.erase(MEMORY_WALK_TARGET),
                }
                return true
            },
            // `JumpOnBed.checkExtraStartConditions`: a baby near a bed, as one with its nearest bed
            // always is.
            Behavior.JumpOnBed(_) => return self.baby(),
            // `GiveGiftToHero`: no player is a hero of the village yet.
            Behavior.HeroGift(_) => return false,
            Behavior.LookAndInteract(range) => {
                // `SetLookAndInteract`: the nearest player it may see within `range`, its target,
                // looked at.
                let within = f64(range * range)
                let id = self.find_closest_of(mut brain, PICK_SPECIES, PLAYER, within, f, m, blocks) else return false
                brain.set(MEMORY_INTERACTION_TARGET, Memo.Entity(id))
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                return true
            },
            Behavior.ShowTrades(_) => return self.shows_trades(brain),
            Behavior.TradeWithVillager(_) => return self.trades_with(mut brain, f, m, blocks),
            Behavior.VillagerLove(_) => return self.breeding_possible(mut brain, f, m, blocks),
            Behavior.LookAt(l) => {
                // `SetEntityLookTarget`: the nearest it may see within its distance of the kind or
                // mob category it looks at, looked at.
                let within = f64(l.max_dist * l.max_dist)
                let by_category = l.species == -100
                let pick = if by_category { PICK_CATEGORY } else { PICK_SPECIES }
                let which = if by_category { l.category } else { l.species }
                let id = self.find_closest_of(mut brain, pick, which, within, f, m, blocks) else return false
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                return true
            },
            Behavior.Schedule(_) => {
                // `UpdateActivityFromSchedule`.
                let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
                brain.update_from_schedule(now, scheduled)
                return true
            },
            Behavior.CalmDown(_) => {
                // `VillagerCalmDown`: where it's no longer hurt, sees no hostile, and what hurt it
                // is farther than 6 or gone, those forgotten and its schedule gone by.
                var scared = brain.has(MEMORY_HURT_BY) or brain.has(MEMORY_NEAREST_HOSTILE)
                if not scared {
                    if let id = brain.entity(MEMORY_HURT_BY_ENTITY) {
                        if let n = self.near_of(id) {
                            scared = self.distance_sqr_to(n.x, n.y, n.z) <= 36.0
                        }
                    }
                }
                if not scared {
                    brain.erase(MEMORY_HURT_BY)
                    brain.erase(MEMORY_HURT_BY_ENTITY)
                    let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
                    brain.update_from_schedule(now, scheduled)
                }
                return true
            },
            Behavior.AwayFrom(a) => {
                // `SetWalkTargetAwayFrom.entity`, not interrupting a walk: where it has none and
                // what the memory holds is nearer than `dist`, of 10 tries, the first place found
                // up to 16 away from it, `LandRandomPos.getPosAway`, walked to.
                let (memory, speed, dist) = a
                if brain.walk(MEMORY_WALK_TARGET) != none {
                    return false
                }
                let id = brain.entity(memory) else return false
                let n = self.near_of(id) else return false
                if not (self.distance_sqr_to(n.x, n.y, n.z) < f64(dist * dist)) {
                    return false
                }
                for _ in 0..10 {
                    if let p = self.pos_away(lf, f, blocks, mut cache, min_y, 0.0, 16.0, (n.x, n.y, n.z)) {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                        break
                    }
                }
                return true
            },
            Behavior.WorkAtPoi(_) => {
                // `WorkAtPoi.checkExtraStartConditions`: 300 ticks of the game since it last
                // looked, then one in two, drawn from the level's random, its look then; and its
                // job site's middle within 1.73 of it, in its dimension.
                if now - keep.last_check < 300 {
                    return false
                }
                if random.next_int_below(2) != 0 {
                    return false
                }
                keep.last_check = now
                let g = brain.place(MEMORY_JOB_SITE) else return false
                return g.dimension == self.dimension and self.near_middle(g.pos, 1.73)
            },
            Behavior.StrollAroundPoi(s) => {
                // `StrollAroundPoi`: within so many blocks of the place's middle, in its
                // dimension, a place on land up to 8 across and 6 up or down walked to,
                // `LandRandomPos.getPos`, else its walk target forgotten, where 180 ticks have gone
                // by since it last did.
                let (memory, speed, within) = s
                let g = brain.place(memory) else return false
                if g.dimension != self.dimension or not self.near_middle(g.pos, f64(within)) {
                    return false
                }
                if now <= keep.next_start {
                    return true
                }
                match self.random_place(true, 8, 6, lf, f, blocks, mut cache, min_y) {
                    some(p) => {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 1)))
                    },
                    none => brain.erase(MEMORY_WALK_TARGET),
                }
                keep.next_start = now + 180
                return true
            },
            Behavior.HomeWalk(speed) => return self.home_walk(mut brain, speed, mut keep, now, mut random, lf, f, m, blocks, mut cache, min_y),
            Behavior.BrownianWalk(speed) => return self.brownian_walk(mut brain, speed, f, m, blocks),
            Behavior.ToVillage(v) => {
                let (speed, close) = v
                return self.to_village(mut brain, speed, close, lf, f, blocks, mut cache, min_y)
            },
            Behavior.PlayTag(_) => return self.play_tag(mut brain, mut random, lf, f, blocks, mut cache, min_y),
            Behavior.SocializeAtBell(_) => {
                // `SocializeAtBell`: one time in 100, from the level's random, where its meeting
                // point's in its dimension within 4 of its middle and it sees a villager, the
                // nearest it sees within 32 squared its target, looked at and walked to at 0.3,
                // near enough within 1; done once it's drawn, whether or not one's that near.
                if random.next_int_below(100) != 0 {
                    return false
                }
                let g = brain.place(MEMORY_MEETING_POINT) else return false
                if g.dimension != self.dimension or not self.near_middle(g.pos, 4.0) {
                    return false
                }
                if self.find_closest_of(mut brain, PICK_SPECIES, VILLAGER, -1.0, f, m, blocks) == none {
                    return false
                }
                if let id = self.find_closest_of(mut brain, PICK_SPECIES, VILLAGER, 32.0, f, m, blocks) {
                    brain.set(MEMORY_INTERACTION_TARGET, Memo.Entity(id))
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: 0.3f32, close_enough: 1 }))
                }
                return true
            },
            Behavior.StrollToPoi(s) => {
                // `StrollToPoi`: within so many blocks of the place's middle, in its dimension,
                // the place walked to, where 80 ticks have gone by since it last was.
                let (memory, speed, close, within) = s
                let g = brain.place(memory) else return false
                if g.dimension != self.dimension or not self.near_middle(g.pos, f64(within)) {
                    return false
                }
                if now <= keep.next_start {
                    return true
                }
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(g.pos.x, g.pos.y, g.pos.z)), speed: speed, close_enough: close }))
                keep.next_start = now + 80
                return true
            },
            Behavior.StrollToPoiList(s) => {
                // `StrollToPoiList`: one of its job site's other places drawn from the level's
                // random; where it's in its dimension and its job site's middle within so many
                // blocks of it, that walked to, where 100 ticks have gone by since it last was.
                let (speed, close, within) = s
                let places = brain.places(MEMORY_SECONDARY_JOB_SITE)
                let stay = brain.place(MEMORY_JOB_SITE) else return false
                if places.is_empty() {
                    return false
                }
                let target = places[usize.wrap(random.next_int_below(i32.wrap(places.len())))].copy()
                if target.dimension != self.dimension or not self.near_middle(stay.pos, f64(within)) {
                    return false
                }
                if now > keep.next_start {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(target.pos.x, target.pos.y, target.pos.z)), speed: speed, close_enough: close }))
                    keep.next_start = now + 100
                }
                return true
            },
            Behavior.WalkToPoi(w) => return self.walk_to_poi(mut brain, w, now, lf, f, blocks, mut cache, min_y),
            Behavior.Harvest(_) => {
                // `HarvestFarmland.checkExtraStartConditions`: where mob griefing's on, a farmer's
                // blocks around it, 1 each way from where it is, x, then y, then z, that are ripe
                // crops or air on farmland, `validPos`, the one it'll work drawn of them from the
                // level's random, `getValidFarmland`.
                if not self.mob_griefing {
                    return false
                }
                let (_, profession, _) = self.living.data.villager(OWN + 1)
                if profession != FARMER {
                    return false
                }
                keep.farmland.clear()
                let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                for dx in -1..2 {
                    for dy in -1..2 {
                        for dz in -1..2 {
                            let (px, py, pz) = (floor_of(x + f64(dx)), floor_of(y + f64(dy)), floor_of(z + f64(dz)))
                            if workable(f, blocks, px, py, pz) {
                                keep.farmland.push((px, py, pz))
                            }
                        }
                    }
                }
                keep.last_target = pick_farmland(keep.farmland, mut random)
                return keep.last_target != none
            },
            Behavior.Bonemeal(_) => {
                // `UseBonemeal.checkExtraStartConditions`: on each 10th of its ticks, 160 or more
                // after it last stopped, with bone meal in its inventory, a crop around it short of
                // its last age, `pickNextTarget`.
                let ticks = i64(self.living.body.tick_count)
                if ticks % 10 != 0 or not (keep.last_check == 0 or keep.last_check + 160 <= ticks) {
                    return false
                }
                if self.inventory_count("minecraft:bone_meal") <= 0 {
                    return false
                }
                keep.last_target = self.pick_crop(f, blocks, none, mut random)
                return keep.last_target != none
            },
            Behavior.Sleep(_) => {
                // `SleepInBed.checkExtraStartConditions`: its home in its dimension, not woken in
                // the 100 ticks before, its home's middle within 2, and a bed villagers sleep on
                // there that no one's in. It rides nothing, as no mob does yet.
                let g = brain.place(MEMORY_HOME) else return false
                if g.dimension != self.dimension {
                    return false
                }
                if let woken = brain.long(MEMORY_LAST_WOKEN) {
                    let since = now - woken
                    if since > 0 and since < 100 {
                        return false
                    }
                }
                return self.near_middle(g.pos, 2.0) and bed_in_use(f, blocks, g.pos) == some(false)
            },
            Behavior.WakeUp(_) => {
                // `WakeUp`: out of its rest asleep, it gets up.
                if brain.is_active(ACTIVITY_REST) or self.living.sleeping == none {
                    return false
                }
                self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
                return true
            },
            Behavior.Unmade(n) => {
                self.living.show(Shown.Missing("A villager's {unmade_name(n)}"), sounds.len())
                return false
            },
            _ => return true,
        }
    }

    // Whether the block `pos`'s middle is nearer it than `dist`, `closerToCenterThan`.
    fn near_middle(self, pos: BlockPos, dist: f64) -> bool {
        return self.distance_sqr_to(f64(pos.x) + 0.5, f64(pos.y) + 0.5, f64(pos.z) + 0.5) < dist * dist
    }

    // `SetWalkTargetFromBlockMemory` (CAL-160): where the place `w.memory` holds is in its
    // dimension and it hasn't gone unable to reach its walk target too long, a place toward it
    // walked to where it's too far, `DefaultRandomPos.getPosTowards` within a right angle either
    // way, 15 across and 7 up or down, tried till one's near enough, or else the place itself where
    // it's farther than near enough, by blocks along each axis; a place it gives up on, there or
    // after 1000 tries, given back, `releasePoi`, and forgotten, it then unable to reach since now.
    fn walk_to_poi<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, w: WalkToPoi, now: i64, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let g = brain.place(w.memory) else return false
        var reachable = g.dimension == self.dimension
        if reachable {
            if let since = brain.long(MEMORY_CANT_REACH_WALK_TARGET_SINCE) {
                reachable = now - since <= i64(w.too_long)
            }
        }
        if not reachable {
            self.give_up_poi(mut brain, w.memory, now)
            return true
        }
        let (bx, by, bz) = self.block_position()
        let far = (g.pos.x - bx).abs() + (g.pos.y - by).abs() + (g.pos.z - bz).abs()
        if far > w.too_far {
            var toward: (f64, f64, f64)? = none
            var tries = 0
            loop {
                if let t = toward {
                    let (tx, ty, tz) = t
                    let s = Spot.of_place(tx, ty, tz)
                    if (s.x - bx).abs() + (s.y - by).abs() + (s.z - bz).abs() <= w.too_far {
                        break
                    }
                }
                let dir = (f64(g.pos.x) + 0.5 - self.living.body.x, f64(g.pos.z) + 0.5 - self.living.body.z)
                toward = self.place_towards(15, 7, dir, lf, f, blocks, mut cache, min_y)
                tries += 1
                if tries == 1000 {
                    self.give_up_poi(mut brain, w.memory, now)
                    return true
                }
            }
            let (x, y, z) = toward ?? (0.0, 0.0, 0.0)
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, w.speed, w.close)))
        } else if far > w.close {
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(g.pos.x, g.pos.y, g.pos.z)), speed: w.speed, close_enough: w.close }))
        }
        return true
    }

    // A place `SetWalkTargetFromBlockMemory` gives up on: given back, `releasePoi`, forgotten,
    // and it unable to reach its walk target since `now`.
    fn give_up_poi(mut self, brain: mut Brain, memory: i32, now: i64) {
        self.release_poi(brain, memory)
        brain.erase(memory)
        brain.set(MEMORY_CANT_REACH_WALK_TARGET_SINCE, Memo.Long(now))
    }

    // `Villager.releasePoi` of the place `memory` holds (CAL-160): where there's a point of
    // interest there of a type the memory's for, a home's, its job site's for its profession,
    // `heldJobSite`, a job site it may take's, `acquirableJobSite`, or a meeting point's, its
    // ticket given back. One in another dimension is said to be missing.
    fn release_poi(mut self, brain: Brain, memory: i32) {
        let g = brain.place(memory) else return
        if g.dimension != self.dimension {
            self.living.show(Shown.Missing(String("A villager's giving back a point of interest's ticket in another dimension, releasePoi")), 0)
            return
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let kinds = if memory == MEMORY_HOME { 1u32 << u32.wrap(HOME) } else if memory == MEMORY_JOB_SITE { held_sites(profession) } else if memory == MEMORY_POTENTIAL_JOB_SITE { acquirable_sites(profession) } else if memory == MEMORY_MEETING_POINT { 1u32 << u32.wrap(MEETING) } else { 0u32 }
        var pois = self.pois.take() ?? Pois.new(0, 0)
        if pois.exists(g.pos, types_of(kinds)) {
            _ = pois.release(g.pos)
        }
        self.pois = some(pois)
    }

    // `DefaultRandomPos.getPosTowards`, up to `h` across and `v` up or down, within a right angle
    // either side of the way `dir` across: of the 10 places tried, as `best_place` picks.
    fn place_towards<B: CollisionBlocks + MobLight + NavLevel>(mut self, h: i32, v: i32, dir: (f64, f64), lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y() }
        let tries = towards_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, w, h, v, dir)
        return self.best_place(lf, f, blocks, tries)
    }

    // How many of the item `id` a villager's inventory holds, `countItem`.
    fn inventory_count(self, id: str) -> i32 {
        let wanted = String(id)
        var n = 0
        for t in self.stacks() {
            let Tag.Compound(c) = t else continue
            if not c.contains("id") {
                continue
            }
            let Tag.Str(item) = c["id"] else continue
            if item == wanted {
                n += int_or(c, "count", 1)
            }
        }
        return n
    }

    // `playWorkSound`: its profession's work sound, `entity.villager.work_*`, as `makeSound`
    // makes it, its pitch drawn; none for no profession or a nitwit, which have none.
    fn play_work_sound(mut self, sounds: mut List<EntitySound>) {
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let name = builtin_name(24, profession)
        if name == "minecraft:none" or name == "minecraft:nitwit" {
            return
        }
        let at = name.find(":") ?? 0
        let pitch = self.voice_pitch()
        self.living.play(mut sounds, "entity.villager.work_{name[at + 1..]}", self.sound_volume, pitch)
    }

    // `WorkAtComposter.useWorkstation`, where its job site's a composter (CAL-160): bread made of
    // its wheat, `makeBread`, then its seeds composted, `compostItems`.
    fn use_composter<B: CollisionBlocks>(mut self, pos: BlockPos, lf: LivingFacts, f: Facts, blocks: B, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let state = state_at(blocks, pos.x, pos.y, pos.z)
        if f.poi(state) != job_site_of(FARMER) {
            return
        }
        self.ready_inventory(f)
        self.make_bread(f, sounds)
        self.compost_items(pos, lf, f, state, mut random, mut sounds)
    }

    // `WorkAtComposter.makeBread`: where it has no more than 36 bread, as many as 3 made of its
    // wheat, 3 each, the wheat taken from its last slot back, `removeItemType`, and the bread
    // added, `addItem`, what there's no room for dropped half a block up from it,
    // `spawnAtLocation`, which its level makes.
    fn make_bread(mut self, f: Facts, sounds: List<EntitySound>) {
        if self.inventory_count("minecraft:bread") > 36 {
            return
        }
        let make = min_i32(3, self.inventory_count("minecraft:wheat") / 3)
        if make == 0 {
            return
        }
        self.remove_item_type("minecraft:wheat", make * 3)
        var slots = self.inventory.copy()
        let left = add_to(mut slots, stack_of_count(stack_of(String("minecraft:bread")), make), f)
        self.inventory = slots
        let over = left else return
        let spilled = Spilled { x: self.living.body.x, y: self.living.body.y + 0.5, z: self.living.body.z, stack: over }
        self.living.show(Shown.Spilled(spilled), sounds.len())
    }

    // `SimpleContainer.removeItemType` of `n` of the item `id` from its inventory, from its last
    // slot back, whatever their components.
    fn remove_item_type(mut self, id: str, n: i32) {
        let wanted = String(id)
        var removed = 0
        var i = self.inventory.len()
        while i > 0 and removed < n {
            i -= 1
            let t = self.inventory[i].copy() else continue
            if held_name(some(t.copy())) != wanted {
                continue
            }
            let have = count_of(some(t.copy()))
            let took = min_i32(have, n - removed)
            if took >= have {
                self.inventory[i] = none
            } else {
                self.inventory[i] = some(stack_of_count(t, have - took))
            }
            removed += took
        }
    }

    // `WorkAtComposter.compostItems` at its composter at `pos`, of the state `state` (CAL-160): a
    // full one's bone meal taken first, `extractProduce`; then, from its last slot back, its wheat
    // and beetroot seeds but 10 of each, 20 in all at most, put in one by one, `insertItem`, their
    // layers drawn as `addLayer` draws them, till it's at 7; the composter set to where that
    // leaves it, which its level does, ticked 20 on where a layer filled it to 7; and its fill
    // shown, level event 1500, 1 where it changed after its bone meal was taken.
    fn compost_items(mut self, pos: BlockPos, lf: LivingFacts, f: Facts, state: u32, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let was = f.get_int(state, "level") ?? 0
        var start = was
        if was == 8 {
            self.extract_produce(pos, mut random, mut sounds)
            start = 0
        }
        var fill = start
        let seeds: List<String> = [String("minecraft:wheat_seeds"), String("minecraft:beetroot_seeds")]
        var seen: List<i32> = [0, 0]
        var left = 20
        var i = self.inventory.len()
        var full = false
        while i > 0 and left > 0 and not full {
            i -= 1
            let t = self.inventory[i].copy() else continue
            let item = held_name(some(t.copy()))
            var k = seeds.len()
            for j in 0..seeds.len() {
                if item == seeds[j] {
                    k = j
                }
            }
            if k == seeds.len() {
                continue
            }
            let size = count_of(some(t))
            seen[k] += size
            let using = min_i32(min_i32(seen[k] - 10, left), size)
            if using <= 0 {
                continue
            }
            left -= using
            for _ in 0..using {
                if fill < 7 and k < lf.composts.len() {
                    if let compost = lf.composts[k].copy() {
                        match compost_layers(compost, fill, mut random) {
                            ok(layers) => fill = min_i32(fill + layers, 7),
                            err(thrown) => {
                                self.living.show(Shown.Missing(thrown.message.copy()), sounds.len())
                                return
                            },
                        }
                        self.shrink_slot(i)
                    }
                }
                if fill == 7 {
                    full = true
                    break
                }
            }
        }
        if fill != was {
            match f.with_int(state, "level", fill) {
                ok(now) => self.living.show(Shown.Composted((pos.x, pos.y, pos.z, now, fill == 7 and fill != start)), sounds.len()),
                err(thrown) => self.living.show(Shown.Missing(thrown.message.copy()), sounds.len()),
            }
        }
        self.living.show(Shown.Level((1500, pos.x, pos.y, pos.z, if fill != start { 1 } else { 0 })), sounds.len())
    }

    // `ComposterBlock.extractProduce` of its full composter at `pos` (CAL-160): bone meal thrown
    // up from it, 1.01 above its floor's corner and half a block in, up to 0.35 either way
    // across, drawn from the level's random, `offsetRandomXZ`, which its level makes with its
    // default pickup delay; and the composter's sound for everyone, from its middle. The
    // composter's emptied as it's set once its seeds are in.
    fn extract_produce(mut self, pos: BlockPos, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let dx = f64((random.next_float() - 0.5f32) * 0.7f32)
        let dz = f64((random.next_float() - 0.5f32) * 0.7f32)
        let at = Spilled { x: f64(pos.x) + 0.5 + dx, y: f64(pos.y) + 1.01, z: f64(pos.z) + 0.5 + dz, stack: stack_of(String("minecraft:bone_meal")) }
        self.living.show(Shown.Spilled(at), sounds.len())
        sounds.push(EntitySound { sound: String("block.composter.empty"), x: f64(pos.x) + 0.5, y: f64(pos.y) + 0.5, z: f64(pos.z) + 0.5, volume: 1.0f32, pitch: 1.0f32, source: BLOCKS_SOURCE })
    }

    // `Villager.shouldRestock` at the game time `now` (CAL-160): a new day where half of one's
    // gone by since it last restocked, or where the overworld's day's count is past the one it
    // last looked at, which it looks at again; on a new day, its last restock now and its
    // restocks today none again, `resetNumberOfRestocks`, their demand caught up first,
    // `catchUpDemand`: for each restock it missed today of 2, its offers' uses none again and
    // their demand updated, `updateDemand`, then priced again for the player trading with it;
    // then, where it may restock, none yet today, or fewer than 2 and 2400 ticks since the last,
    // whether any of its offers has been used, `needsToRestock`. Its offers asked for where
    // they're still to make are counted in `fresh`, as `ask_offers` has them.
    fn should_restock(mut self, now: i64, fresh: mut i32?, sounds: List<EntitySound>) -> bool {
        var new_day = now > self.last_restock + 12000
        let current = self.day
        new_day = new_day or (self.last_restock_check_day > 0 and current > self.last_restock_check_day)
        self.last_restock_check_day = current
        if new_day {
            self.last_restock = now
            let missed = 2 - self.restocks_today
            if missed > 0 {
                ask_offers(self.kept.contains("Offers"), mut fresh)
                self.reset_uses()
                for _ in 0..missed {
                    self.update_demand()
                    if let k = fresh {
                        fresh = some(k + 1)
                    }
                }
            }
            if self.reprice() {
                self.living.show(Shown.Repriced, sounds.len())
            }
            self.restocks_today = 0
        }
        if not (self.restocks_today == 0 or (self.restocks_today < 2 and now > self.last_restock + 2400)) {
            return false
        }
        ask_offers(self.kept.contains("Offers"), mut fresh)
        for o in self.offers() {
            let Tag.Compound(c) = o else continue
            if int_or(c, "uses", 0) > 0 {
                return true
            }
        }
        return false
    }

    // `Villager.restock` at the game time `now` (CAL-160): its offers' demand updated, then their
    // uses none again, then priced again for the player trading with it, sent them; and its last
    // restock now, one more today.
    fn restock(mut self, now: i64, sounds: List<EntitySound>) {
        self.update_demand()
        self.reset_uses()
        if self.reprice() {
            self.living.show(Shown.Repriced, sounds.len())
        }
        self.last_restock = now
        self.restocks_today += 1
    }

    // Each of its offers' uses none again, `resetUses`, left out as `MerchantOffer.CODEC` leaves
    // out what's its default.
    fn reset_uses(mut self) {
        if not self.kept.contains("Offers") {
            return
        }
        var offers = self.offers()
        for i in 0..offers.len() {
            let Tag.Compound(o) = offers[i].copy() else continue
            var offer = o.copy()
            _ = offer.remove("uses")
            offers[i] = Tag.Compound(offer)
        }
        self.set_offers(offers)
    }

    /// Each of its offers' demand updated, `MerchantOffer.updateDemand`: up by its uses, less the
    /// uses it had left, 0 left out as `MerchantOffer.CODEC` leaves it out (CAL-160).
    pub fn update_demand(mut self) {
        if not self.kept.contains("Offers") {
            return
        }
        var offers = self.offers()
        for i in 0..offers.len() {
            let Tag.Compound(o) = offers[i].copy() else continue
            var offer = o.copy()
            let uses = int_or(offer, "uses", 0)
            let demand = int_or(offer, "demand", 0) + uses - (int_or(offer, "maxUses", 4) - uses)
            if demand == 0 {
                _ = offer.remove("demand")
            } else {
                offer.insert(String("demand"), Tag.Int(demand))
            }
            offers[i] = Tag.Compound(offer)
        }
        self.set_offers(offers)
    }

    // What the behavior of the kind `kind` does as it starts at the game time `now`, `start`.
    fn start_behavior<B: CollisionBlocks + NavLevel>(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) {
        match kind {
            Behavior.Harvest(_) => {
                // `HarvestFarmland.start`: past its next start, the block it'll work looked at
                // and walked to at half speed, near enough within 1.
                if now > keep.next_start {
                    if let t = keep.last_target {
                        let (x, y, z) = t
                        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: 0.5f32, close_enough: 1 }))
                    }
                }
            },
            Behavior.Bonemeal(_) => {
                // `UseBonemeal.start`: its crop looked at and walked to, `setCurrentCropAsTarget`;
                // a bone meal in its main hand, `setItemSlot`; its work from now, none worked yet.
                target_crop(mut brain, keep.last_target)
                self.living.equipment[0] = some(stack_of(String("minecraft:bone_meal")))
                keep.next_start = now
                keep.ticks = 0
            },
            Behavior.WorkAtPoi(composter) => {
                // `WorkAtPoi.start`: when it worked remembered, its job site looked at, its
                // profession's work sound, its workstation used, a farmer's composter as
                // `WorkAtComposter` uses it, and its offers restocked where it should.
                brain.set(MEMORY_LAST_WORKED_AT_POI, Memo.Long(now))
                let site = brain.place(MEMORY_JOB_SITE)
                if let g = site {
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(g.pos.x, g.pos.y, g.pos.z))))
                }
                self.play_work_sound(mut sounds)
                if composter {
                    if let g = site {
                        self.use_composter(g.pos, lf, f, blocks, mut random, mut sounds)
                    }
                }
                var fresh: i32? = none
                if self.should_restock(now, mut fresh, sounds) {
                    self.restock(now, sounds)
                }
                if let k = fresh {
                    let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    self.living.show(Shown.Offers((x, y, z, k)), sounds.len())
                }
            },
            Behavior.Panic(_) => {
                // `ArmadilloPanic.start`: rolled out first, then `AnimalPanic`'s.
                if self.species == ARMADILLO {
                    self.roll_out(mut sounds)
                }
                brain.set(MEMORY_IS_PANICKING, Memo.Flag(true))
                brain.erase(MEMORY_WALK_TARGET)
                self.navigation.stop()
            },
            Behavior.MoveToTarget(_) => self.follow_path(mut brain, mut keep, lf, f, blocks, min_y),
            Behavior.LookAround(look) => {
                let r = self.living.body.random.next_float()
                let pitch = clamp(r * look.pitch_range + look.min_pitch, -90.0f32, 90.0f32)
                let t = self.living.body.random.next_float()
                let rotation = wrap_degrees(self.living.body.y_rot + 2.0f32 * t * look.max_yaw - look.max_yaw)
                let (lx, ly, lz) = direction_from_rotation(pitch, rotation)
                let (x, y, z) = (self.living.body.x, self.living.body.y + f64(self.living.body.eyes), self.living.body.z)
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_place(x + lx, y + ly, z + lz))))
                let gaze = self.living.body.random.next_int_between(look.min_interval, look.max_interval)
                brain.set(MEMORY_GAZE_COOLDOWN_TICKS, Memo.Int(gaze))
            },
            Behavior.BallUp(_) => self.roll_up(true, mut sounds),
            Behavior.VillagerPanic(_) => {
                // `VillagerPanicTrigger.start`: hurt or seeing a hostile, where it isn't panicking
                // its path, walk and look targets, partner and what it interacts with forgotten,
                // and panic on.
                if brain.has(MEMORY_HURT_BY) or brain.has(MEMORY_NEAREST_HOSTILE) {
                    if not brain.is_active(ACTIVITY_PANIC) {
                        for memory in [MEMORY_PATH, MEMORY_WALK_TARGET, MEMORY_LOOK_TARGET, MEMORY_BREED_TARGET, MEMORY_INTERACTION_TARGET] {
                            brain.erase(memory)
                        }
                    }
                    brain.set_if_possible(ACTIVITY_PANIC)
                }
            },
            Behavior.ShowTrades(_) => {
                // `ShowTradesToPlayer.start`: the player looked at, for 40 ticks to begin with,
                // its first item shown first.
                _ = look_at_interaction(mut brain)
                keep.cycle = 0
                keep.display_index = 0
                keep.look_time = 40
            },
            Behavior.FollowTrader(speed) => self.follow_trader(mut brain, speed),
            Behavior.Sleep(_) => {
                // `SleepInBed.start`, from its next start: the doors it opened or passed closed,
                // `closeDoorsThatIHaveOpenedOrPassedThrough`; asleep in its home's bed, its time
                // asleep remembered where it lay down; its walk and its trouble reaching it
                // forgotten.
                if now > keep.next_start {
                    if brain.has(MEMORY_DOORS_TO_CLOSE) {
                        var swung = List<(i32, i32, i32, u32)>()
                        self.close_doors(mut brain, none, none, f, blocks, mut swung, mut random, mut sounds)
                    }
                    if let g = brain.place(MEMORY_HOME) {
                        if self.start_sleeping(f, m, blocks, g.pos.x, g.pos.y, g.pos.z, sounds) {
                            brain.set(MEMORY_LAST_SLEPT, Memo.Long(now))
                        }
                    }
                    brain.erase(MEMORY_WALK_TARGET)
                    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                }
            },
            Behavior.MakeLove(l) => {
                // `AnimalMakeLove.start`: its partner its breed target, and it the partner's, the
                // partner's done by its level once its tick is; their gazes locked and walking to
                // each other; the baby to come 60 to 109 ticks on, from its own random.
                if let id = self.find_closest(mut brain, PICK_PARTNER, 0.0, f, m, blocks) {
                    brain.set(MEMORY_BREED_TARGET, Memo.Entity(id))
                    self.told.push(Told.BreedWith((id, self.living.body.id)))
                    self.lock_gaze_at(mut brain, id, l.speed, l.close_enough)
                    keep.child_at = now + i64(60 + self.living.body.random.next_int_below(50))
                }
            },
            Behavior.VillagerLove(_) => {
                // `VillagerMakeLove.start`: it and the villager it breeds with lock their gazes and
                // walk to each other, `lockGazeAndWalkToEachOther`, entity event 18 shown of the
                // other, then of it; the baby to come 275 to 324 ticks on, from its own random.
                if let id = brain.entity(MEMORY_BREED_TARGET) {
                    self.lock_gaze(mut brain, id)
                    self.living.show(Shown.EventOf((id, 18i8)), sounds.len())
                    self.living.show(Shown.Event(18i8), sounds.len())
                    keep.child_at = now + i64(275 + self.living.body.random.next_int_below(50))
                }
            },
            Behavior.TradeWithVillager(_) => {
                // `TradeWithVillager.start`: it and the villager it's interacting with lock their
                // gazes and walk to each other, `lockGazeAndWalkToEachOther`; and what it's
                // willing to throw the other, what the other's profession asks for and its own
                // doesn't, `figureOutWhatIAmWillingToTrade`, a farmer's wheat, seeds and bone meal
                // where the other's a farmer and it isn't.
                if let id = brain.entity(MEMORY_INTERACTION_TARGET) {
                    self.lock_gaze(mut brain, id)
                    keep.trades = List<String>()
                    let (_, mine, _) = self.living.data.villager(OWN + 1)
                    if let n = self.near_of(id) {
                        if n.profession == FARMER and mine != FARMER {
                            keep.trades = farmer_requests()
                        }
                    }
                }
            },
            Behavior.JumpOnBed(speed) => {
                // `JumpOnBed.start`: its nearest bed its target, 100 ticks to reach it, 3 to 6
                // jumps, drawn from the level's random, none to wait, and walked to.
                if let bed = brain.block(MEMORY_NEAREST_BED) {
                    keep.bed = some((bed.x, bed.y, bed.z))
                    keep.to_reach = 100
                    keep.jumps = 3 + random.next_int_below(4)
                    keep.jump_wait = 0
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(bed.x, bed.y, bed.z)), speed: speed, close_enough: 0 }))
                }
            },
            _ => {},
        }
    }

    // `JumpOnBed.onOrOverBed`: in a block a baby jumps on, or just over one.
    fn on_or_over_bed<B: CollisionBlocks>(self, f: Facts, blocks: B) -> bool {
        let (x, y, z) = self.block_position()
        return jumpable(f, blocks, x, y, z) or jumpable(f, blocks, x, y - 1, z)
    }

    // `setVillagerData` of its type, profession and level, its offers forgotten where its
    // profession changes, and its brain made again in its tick, `refreshBrain`.
    fn set_profession(mut self, kind: i32, profession: i32, level: i32) {
        let (_, was, _) = self.living.data.villager(OWN + 1)
        if was != profession {
            _ = self.kept.remove(String("Offers"))
        }
        self.living.data.set(OWN + 1, Value.Villager(kind, profession, level))
        self.refresh_due = true
    }

    // `AssignProfessionFromJobSite`: within 2 of the middle of the job site it found, that its
    // job site, shown, entity event 14; and where it has no profession, the profession whose job
    // site the point there is, `heldJobSite`, its brain made again, `refreshBrain`.
    fn assign_profession(mut self, brain: mut Brain, sounds: List<EntitySound>) -> bool {
        let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) else return false
        if self.distance_sqr_to(f64(g.pos.x) + 0.5, f64(g.pos.y) + 0.5, f64(g.pos.z) + 0.5) >= 4.0 {
            return false
        }
        brain.erase(MEMORY_POTENTIAL_JOB_SITE)
        brain.set(MEMORY_JOB_SITE, Memo.Place(g.copy()))
        self.living.show(Shown.Event(14i8), sounds.len())
        let (kind, profession, level) = self.living.data.villager(OWN + 1)
        if profession != NO_PROFESSION {
            return true
        }
        if g.dimension != self.dimension {
            self.living.show(Shown.Missing(String("A villager's taking a profession at a job site in another dimension, AssignProfessionFromJobSite")), sounds.len())
            return true
        }
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let at = pois.type_at(g.pos)
        self.pois = some(pois)
        if let k = at {
            let p = profession_at(k)
            if p >= 0 {
                self.set_profession(kind, p, level)
            }
        }
        return true
    }

    // `PoiCompetitorScan` (CAL-160): where its job site's a point of interest in its level,
    // `getType`, the villagers near it alive holding that job site, in its dimension, with a
    // profession that works there, in the order its sensor found them, each against the one
    // keeping it so far, starting with itself: the one with more experience keeps it, the other,
    // a tie's keeper, forgetting it, `selectWinner`, another's forgotten by the level once its
    // tick's done.
    fn scan_competitors(mut self, brain: mut Brain) {
        let g = brain.place(MEMORY_JOB_SITE) else return
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let at = pois.type_at(g.pos)
        self.pois = some(pois)
        let k = at else return
        let me = self.living.body.id
        let here = g.dimension == self.dimension
        let pos = g.pos.pack()
        var keeper = me
        var keeper_xp = self.villager_xp
        for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            let n = self.near_of(id) else continue
            if id == me or n.species != VILLAGER or not n.alive {
                continue
            }
            let same = if let p = n.job_site { here and n.job_site_here and p == pos } else { false }
            if not same or held_sites(n.profession) & (1u32 << u32.wrap(k)) == 0u32 {
                continue
            }
            var loser = id
            if keeper_xp <= n.villager_xp {
                loser = keeper
                keeper = id
                keeper_xp = n.villager_xp
            }
            if loser == me {
                brain.erase(MEMORY_JOB_SITE)
            } else {
                self.told.push(Told.Erase((loser, MEMORY_JOB_SITE)))
            }
        }
    }

    // `YieldJobSite` at the speed (CAL-160): a grown one with no profession, where the job site it
    // found is a point of interest in its level, giving it up to the first villager near it,
    // alive, that's found none, whose profession works there and that holds that place, by its
    // place alone, or, holding none, can reach it, its walk and look targets and the site
    // forgotten, and where that one holds none, the site the one it found, walked to by the level
    // once its tick's done. Whether another can reach it is a Missing notice, as that's another's
    // path; it's taken as not.
    fn yield_job_site(mut self, brain: mut Brain, speed: f32, sounds: List<EntitySound>) -> bool {
        if self.baby() {
            return false
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        if profession != NO_PROFESSION {
            return false
        }
        let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) else return false
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let at = pois.type_at(g.pos)
        self.pois = some(pois)
        let k = at else return true
        let me = self.living.body.id
        let pos = g.pos.pack()
        for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            let n = self.near_of(id) else continue
            if id == me or n.species != VILLAGER or not n.alive or n.seeks_job_site {
                continue
            }
            if held_sites(n.profession) & (1u32 << u32.wrap(k)) == 0u32 {
                continue
            }
            var wants = false
            if let p = n.job_site {
                wants = p == pos
            } else {
                self.living.show(Shown.Missing(String("A villager's finding whether another can reach the job site it yields, YieldJobSite")), sounds.len())
            }
            if not wants {
                continue
            }
            brain.erase(MEMORY_WALK_TARGET)
            brain.erase(MEMORY_LOOK_TARGET)
            brain.erase(MEMORY_POTENTIAL_JOB_SITE)
            if n.job_site == none {
                self.told.push(Told.JobSite((id, g.pos.x, g.pos.y, g.pos.z, speed)))
            }
            return true
        }
        return true
    }

    // `DoorBlock.setOpen` by it (CAL-160): the door at `pos`, of the state `state`, opened or shut,
    // `open`, set with flags 10, its other half following as its shape updates, which its level
    // does as its brain's tick stops for it, `Shown.Door`; till then both halves kept in `swung`
    // as it reads them. Its sound's pitch drawn from the level's random after, as it's played from
    // the blocks at the door's middle. Its game event comes with game events.
    fn swing_door<B: CollisionBlocks>(mut self, f: Facts, blocks: B, swung: mut List<(i32, i32, i32, u32)>, pos: (i32, i32, i32), state: u32, open: bool, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let (x, y, z) = pos
        let now = match f.with_bool(state, "open", open) {
            ok(s) => s,
            err(_) => return,
        }
        swung.push((x, y, z, now))
        let half = f.get_name(state, "half") ?? String("lower")
        let other_y = if half == "lower" { y + 1 } else { y - 1 }
        let other = door_state(blocks, swung, x, other_y, z)
        let other_half = f.get_name(other, "half") ?? String("lower")
        if f.block(other) == f.block(state) and other_half != half {
            match f.with_name(now, "half", other_half) {
                ok(s) => swung.push((x, other_y, z, s)),
                err(_) => {},
            }
        }
        self.living.show(Shown.Door((x, y, z, open)), sounds.len())
        self.stop_due = true
        let pitch = random.next_float() * 0.1f32 + 0.9f32
        if let sound = f.toggle_sound(f.block(state), open) {
            sounds.push(EntitySound { sound: sound, x: f64(x) + 0.5, y: f64(y) + 0.5, z: f64(z) + 0.5, volume: 1.0f32, pitch: pitch, source: BLOCKS_SOURCE })
        }
    }

    // `closeDoorsThatIHaveOpenedOrPassedThrough` (CAL-160): each door it keeps to close but those
    // at the node it last passed and its next, `from` and `to`, let go of where it's in another
    // dimension or 3 or more from its middle, isn't a door mobs open any more, isn't open, or a
    // villager within 2 of its middle comes through it, `isMobComingThroughDoor`; else shut,
    // `swing_door`, and let go of. In the order they were kept: vanilla's `HashSet` of them goes in
    // an order its dimension's identity hash sets, which differs from run to run.
    fn close_doors<B: CollisionBlocks>(mut self, brain: mut Brain, from: (i32, i32, i32)?, to: (i32, i32, i32)?, f: Facts, blocks: B, swung: mut List<(i32, i32, i32, u32)>, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let doors = brain.places(MEMORY_DOORS_TO_CLOSE)
        var kept = List<GlobalPos>()
        for g in doors {
            let p = (g.pos.x, g.pos.y, g.pos.z)
            if from == some(p) or to == some(p) {
                kept.push(g.copy())
                continue
            }
            if g.dimension != self.dimension or self.distance_sqr_to(f64(g.pos.x) + 0.5, f64(g.pos.y) + 0.5, f64(g.pos.z) + 0.5) >= 9.0 {
                continue
            }
            let state = door_state(blocks, swung, g.pos.x, g.pos.y, g.pos.z)
            if not mob_door(f, state) or not f.get_bool(state, "open") or self.others_coming(brain, p) {
                continue
            }
            self.swing_door(f, blocks, mut swung, p, state, false, mut random, mut sounds)
        }
        brain.set(MEMORY_DOORS_TO_CLOSE, Memo.Places(kept))
    }

    // `areOtherMobsComingThroughDoor` (CAL-160): of the living entities it last found near it, a
    // mob of its own kind within 2 of the door's middle whose `PATH` memory's path is started and
    // not done, and has last passed the door or heads for it.
    fn others_coming(self, brain: Brain, door: (i32, i32, i32)) -> bool {
        let (x, y, z) = door
        for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            let n = self.near_of(id) else continue
            if n.species != self.species {
                continue
            }
            let dx = f64(x) + 0.5 - n.x
            let dy = f64(y) + 0.5 - n.y
            let dz = f64(z) + 0.5 - n.z
            if dx * dx + dy * dy + dz * dz >= 4.0 {
                continue
            }
            let t = n.through else continue
            let (a, b) = t
            if a == door or b == door {
                return true
            }
        }
        return false
    }

    /// Its `PATH` memory's path's last node passed and next, where it's started and not done, as
    /// a mob near it sees them (CAL-160).
    pub fn path_about(self) -> ((i32, i32, i32), (i32, i32, i32))? {
        let b = self.brain else return none
        let id = b.path(MEMORY_PATH) else return none
        return self.navigation.about_path(id)
    }

    /// A villager's profession, experience and job site as a mob near it sees them (CAL-160): its
    /// job site's place, `BlockPos.asLong`, and whether it's in `dimension`; and whether it's
    /// found one to take. Nothing for another mob.
    pub fn job_seen(self, dimension: String) -> (i32, i32, i64?, bool, bool) {
        if self.species != VILLAGER {
            return (0, 0, none, false, false)
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        var site: i64? = none
        var here = false
        var seeks = false
        if let b = self.brain {
            if let g = b.place(MEMORY_JOB_SITE) {
                site = some(g.pos.pack())
                here = g.dimension == dimension
            }
            seeks = b.has(MEMORY_POTENTIAL_JOB_SITE)
        }
        return (profession, self.villager_xp, site, here, seeks)
    }

    /// What another's behavior did to it, `Told.Erase`: the memory forgotten (CAL-160).
    pub fn forget(mut self, memory: i32) {
        var brain = self.brain.take() else return
        brain.erase(memory)
        self.brain = some(brain)
    }

    /// What another's behavior did to it, `Told.JobSite`: it looks at and walks to the place at
    /// the speed till it's within 1, `setWalkAndLookTargetMemories`, and remembers it as the job
    /// site it found, in `dimension` (CAL-160).
    pub fn take_job_site(mut self, x: i32, y: i32, z: i32, speed: f32, dimension: own String) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: speed, close_enough: 1 }))
        brain.set(MEMORY_POTENTIAL_JOB_SITE, Memo.Place(GlobalPos { dimension: dimension, pos: BlockPos { x: x, y: y, z: z } }))
        self.brain = some(brain)
    }

    // `TradeWithVillager.checkExtraStartConditions`, `BehaviorUtils.targetIsValid`: what it
    // interacts with a villager, alive, that it may see.
    fn trades_with<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B) -> bool {
        let id = brain.entity(MEMORY_INTERACTION_TARGET) else return false
        let n = self.near_of(id) else return false
        return n.species == VILLAGER and n.alive and self.sees_near(mut brain, id, f, m, blocks)
    }

    // `VillagerMakeLove.isBreedingPossible` (CAL-160): what it would breed with a villager, alive
    // and among its brain's visible living entities, which it may see, `targetIsValid`; and both
    // may breed, `canBreed`.
    fn breeding_possible<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B) -> bool {
        let id = brain.entity(MEMORY_BREED_TARGET) else return false
        let n = self.near_of(id) else return false
        if n.species != VILLAGER or not n.alive or not self.sees_near(mut brain, id, f, m, blocks) {
            return false
        }
        return self.villager_can_breed() and n.can_breed
    }

    // `VillagerMakeLove.tick` (CAL-160): within about 2 of the villager it breeds with, 5 squared,
    // their gazes locked again; at the baby's time, both eat and digest, `eatAndDigestFood`, the
    // other's done by its level once its tick is, and the baby tried for, `tryToGiveBirth`; else
    // one time in 35, from its own random, entity event 12 shown of the other, then of it.
    fn make_love_tick<B: CollisionBlocks + NavLevel>(mut self, brain: mut Brain, keep: Keep, now: i64, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: List<EntitySound>) {
        let id = brain.entity(MEMORY_BREED_TARGET) else return
        let n = self.near_of(id) else return
        if self.distance_sqr_to(n.x, n.y, n.z) > 5.0 {
            return
        }
        self.lock_gaze(mut brain, id)
        if now >= keep.child_at {
            self.eat_and_digest(f)
            self.told.push(Told.Digest(id))
            self.give_birth(n, lf, f, m, blocks, mut cache, min_y, sounds)
        } else if self.living.body.random.next_int_below(35) == 0 {
            self.living.show(Shown.EventOf((id, 12i8)), sounds.len())
            self.living.show(Shown.Event(12i8), sounds.len())
        }
    }

    // `VillagerMakeLove.tryToGiveBirth` with the villager `n` (CAL-160): a bed taken for the baby,
    // `takeVacantBed`, of the beds within 48 of its block with a ticket free, in their order, the
    // first a path found to it, `createPath` within its type's valid range, reaches, `canReach`;
    // with none, entity event 13 shown of the other, then of it. Else the baby's type drawn from
    // its own random, `getBreedOffspring`: under a half the biome's at its block, under three
    // quarters its own, else the other's; it 6000 ticks from breeding again, `setAge`, as the
    // other is, and the baby made, with the bed its home, `Bred`, which its level does.
    fn give_birth<B: CollisionBlocks + NavLevel>(mut self, n: Near, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: List<EntitySound>) {
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let homes = types_of(1u32 << u32.wrap(HOME))
        var bed: BlockPos? = none
        for r in pois.in_range(homes.copy(), center, 48, Occupancy.HasSpace) {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, w, r.pos.x, r.pos.y, r.pos.z, valid_range(i32.wrap(r.kind))) {
                if p.reached {
                    bed = some(r.pos)
                    break
                }
            }
        }
        let taken = bed else {
            self.pois = some(pois)
            self.living.show(Shown.EventOf((n.id, 13i8)), sounds.len())
            self.living.show(Shown.Event(13i8), sounds.len())
            return
        }
        _ = pois.take(homes, some(taken), center, 48)
        self.pois = some(pois)
        let roll = self.living.body.random.next_double()
        var kind = -1
        if roll >= 0.75 {
            kind = n.villager_type
        } else if roll >= 0.5 {
            kind = self.villager_kind()
        }
        self.set_age(6000)
        let (x, y, z, made_as) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.kind)
        self.living.show(Shown.Bred(Bred { partner: n.id, species: VILLAGER, kind: made_as, variant: kind, partner_variant: n.villager_type, x: x, y: y, z: z, orb: 0, block: some((bx, by, bz)), bed: some((taken.x, taken.y, taken.z)) }), sounds.len())
    }

    /// `Villager.eatAndDigestFood` (CAL-160): where it's hungry, its food under 12, its villager
    /// food eaten from its first slot on, one by one till it's full, `eatUntilFull`; then 12 of its
    /// food digested, `digestFood`.
    pub fn eat_and_digest(mut self, f: Facts) {
        self.ready_inventory(f)
        if self.food_level < 12 {
            let size = self.inventory.len()
            for i in 0..size {
                let t = self.inventory[i].copy() else continue
                let value = villager_food(held_name(some(t.copy())))
                if value == 0 {
                    continue
                }
                let have = count_of(some(t.copy()))
                var eaten = 0
                while eaten < have and self.food_level < 12 {
                    self.food_level += value
                    eaten += 1
                }
                self.inventory[i] = if eaten >= have { none } else { some(stack_of_count(t, have - eaten)) }
                if self.food_level >= 12 {
                    break
                }
            }
        }
        self.food_level -= 12
    }

    /// Whether it may breed, `canBreed` (CAL-160): a villager's, `Villager.canBreed`; never any
    /// other mob, `AgeableMob`'s.
    pub fn can_breed(self) -> bool {
        return self.species == VILLAGER and self.villager_can_breed()
    }

    /// A villager's type, by its ID in `VILLAGER_TYPE`, plains for any other mob (CAL-160).
    pub fn villager_kind(self) -> i32 {
        if self.species != VILLAGER {
            return PLAINS_VILLAGERS
        }
        let (kind, _, _) = self.living.data.villager(OWN + 1)
        return kind
    }

    /// A villager baby's data as `getBreedOffspring` sets it (CAL-160): of the type `kind`, with no
    /// profession, and final.
    pub fn born_villager(mut self, kind: i32) {
        let (_, _, level) = self.living.data.villager(OWN + 1)
        self.living.data.set(OWN + 1, Value.Villager(kind, NO_PROFESSION, level))
        self.living.data.set(OWN + 2, Value.Bool(true))
    }

    /// `VillagerMakeLove.giveBedToChild`: the bed at the place its home, in the dimension
    /// (CAL-160).
    pub fn given_home(mut self, x: i32, y: i32, z: i32, dimension: String) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_HOME, Memo.Place(GlobalPos { dimension: dimension.copy(), pos: BlockPos { x: x, y: y, z: z } }))
        self.brain = some(brain)
    }

    // `AnimalMakeLove.canStillUse` (CAL-160): what it breeds with of its partner's kind, alive,
    // in love as it is, `canMate`, among its brain's visible living entities, which it may see,
    // the baby's time not past, and neither panicking.
    fn still_mating<B: CollisionBlocks>(mut self, brain: mut Brain, l: MakeLove, child_at: i64, now: i64, f: Facts, m: MovementStates, blocks: B) -> bool {
        let id = brain.entity(MEMORY_BREED_TARGET) else return false
        let n = self.near_of(id) else return false
        if n.species != l.species or not n.alive or not (self.in_love > 0 and n.in_love) {
            return false
        }
        if not self.sees_near(mut brain, id, f, m, blocks) {
            return false
        }
        return now <= child_at and not self.panicking() and not n.panicking
    }

    // `AnimalMakeLove.tick` (CAL-160): their gazes locked again; within 3 of its partner at the
    // baby's time, the baby made, `spawnChildFromBreeding`, as a farm animal's breeding makes it,
    // and both forget what they breed with, the partner's done by its level once its tick is.
    fn mate_tick(mut self, brain: mut Brain, l: MakeLove, child_at: i64, now: i64, sounds: List<EntitySound>) {
        let id = brain.entity(MEMORY_BREED_TARGET) else return
        let n = self.near_of(id) else return
        self.lock_gaze_at(mut brain, id, l.speed, l.close_enough)
        if self.distance_sqr_to(n.x, n.y, n.z) < 9.0 and now >= child_at {
            let k = Kin { id: n.id, species: n.species, x: n.x, y: n.y, z: n.z, eyes: n.eyes, bounds: n.bounds, age: 0, in_love: n.in_love, alive: n.alive, panicking: n.panicking, variant: 0 }
            self.breed(k, sounds.len())
            brain.erase(MEMORY_BREED_TARGET)
            self.told.push(Told.Erase((id, MEMORY_BREED_TARGET)))
        }
    }

    /// What another's `AnimalMakeLove` told it, `Told.BreedWith`: the mob `with` what it breeds
    /// with, where its brain has the memory (CAL-160).
    pub fn breed_with(mut self, with: i32) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_BREED_TARGET, Memo.Entity(with))
        self.brain = some(brain)
    }

    // `BehaviorUtils.lockGazeAndWalkToEachOther` of it and the entity `id`, at `speed` till
    // they're `close` apart: each looks at the other's eyes and walks to them, the other's done
    // by the level once its tick is.
    fn lock_gaze_at(mut self, brain: mut Brain, id: i32, speed: f32, close: i32) {
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: true }), speed: speed, close_enough: close }))
        self.told.push(Told.WalkTo((id, self.living.body.id, speed, close)))
    }

    // `BehaviorUtils.lockGazeAndWalkToEachOther` of it and the entity `id`, at half speed till
    // they're 2 apart: each looks at the other's eyes and walks to them, the other's done by the
    // level once its tick is.
    fn lock_gaze(mut self, brain: mut Brain, id: i32) {
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: true }), speed: 0.5f32, close_enough: 2 }))
        self.told.push(Told.WalkTo((id, self.living.body.id, 0.5f32, 2)))
    }

    // `TradeWithVillager.tick`: within about 2 of the villager it's interacting with, 5 squared,
    // their gazes locked again, the two gossiping, `gossip`, which the level does once its tick is
    // done; then half a stack thrown to the other, `throwHalfStack`: of its food, where it has
    // more than it needs, `hasExcessFood`, and is a farmer or the other wants more,
    // `wantsMoreFood`; of a farmer's wheat, past half a stack; and of what it's willing to throw,
    // `keep.trades`.
    fn trade_with_villager_tick(mut self, brain: mut Brain, keep: Keep, now: i64, f: Facts, sounds: List<EntitySound>) {
        let id = brain.entity(MEMORY_INTERACTION_TARGET) else return
        let n = self.near_of(id) else return
        if self.distance_sqr_to(n.x, n.y, n.z) > 5.0 {
            return
        }
        self.lock_gaze(mut brain, id)
        self.told.push(Told.Gossip((self.living.body.id, id, now)))
        self.ready_inventory(f)
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let farmer = profession == FARMER
        let to = (n.x, n.y, n.z)
        if self.food_points() >= 24 and (farmer or n.food < 12) {
            self.throw_half_stack(f, villager_foods(), to, sounds)
        }
        if farmer and self.inventory_count("minecraft:wheat") > 32 {
            self.throw_half_stack(f, [String("minecraft:wheat")], to, sounds)
        }
        if not keep.trades.is_empty() {
            self.throw_half_stack(f, keep.trades.copy(), to, sounds)
        }
    }

    // `TradeWithVillager.throwHalfStack` to `to`: the first of its stacks of the items `kinds`
    // with more than half the most it stacks to, half of it, or with more than 24, all but 24,
    // split off, `split`, and thrown, `throwItem`.
    fn throw_half_stack(mut self, f: Facts, kinds: List<String>, to: (f64, f64, f64), sounds: List<EntitySound>) {
        for i in 0..self.inventory.len() {
            let t = self.inventory[i].copy() else continue
            if not kinds.contains(held_name(some(t.copy()))) {
                continue
            }
            let have = count_of(some(t.copy()))
            var count = 0
            if have > stack_limit(f, t.copy()) / 2 {
                count = have / 2
            } else if have > 24 {
                count = have - 24
            } else {
                continue
            }
            self.inventory[i] = some(stack_of_count(t.copy(), have - count))
            self.throw_item(stack_of_count(t, count), to, sounds)
            return
        }
    }

    // `BehaviorUtils.throwItem` of `stack` to `to`, where the one it's thrown to stands: an item
    // 0.3 below its eyes, which its level makes as `new ItemEntity` makes one, moving 0.3 a tick
    // toward there, `normalize`, not at all where it's there already, its thrower it, with its
    // default pickup delay.
    fn throw_item(mut self, stack: own Tag, to: (f64, f64, f64), sounds: List<EntitySound>) {
        let (tx, ty, tz) = to
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        let (dx, dy, dz) = (tx - x, ty - y, tz - z)
        let length = (dx * dx + dy * dy + dz * dz).sqrt()
        let speed = f64(0.3f32)
        var thrown = Tossed { x: x, y: y + f64(self.living.body.eyes) - f64(0.3f32), z: z, vx: 0.0, vy: 0.0, vz: 0.0, stack: stack, thrower: self.living.body.uuid }
        if length >= f64(1.0e-5f32) {
            thrown.vx = dx / length * speed
            thrown.vy = dy / length * speed
            thrown.vz = dz / length * speed
        }
        self.living.show(Shown.Tossed(thrown), sounds.len())
    }

    /// `Villager.gossip` of it with the villager `other` at the game time `now` (CAL-160): where
    /// neither gossiped in the 1200 ticks before, what the other's heard passed on, 10 picked from
    /// its random, `transferFrom`; both gossiped now; an iron golem summoned where five villagers
    /// near want one, `spawnGolemIfNeeded`, a Missing notice where it wants one; and where it
    /// heard anything, its offers priced again for the player trading with it, sent them.
    pub fn gossip_with(mut self, other: mut Mob, now: i64, heard: usize) {
        let mine = now < self.last_gossip or now >= self.last_gossip + 1200
        let theirs = now < other.last_gossip or now >= other.last_gossip + 1200
        if not mine or not theirs {
            return
        }
        var known = self.gossips.copy()
        let fresh = known.transfer_from(other.gossips, mut self.living.body.random, 10)
        self.gossips = known
        self.last_gossip = now
        other.last_gossip = now
        var wants = false
        if let b = self.brain {
            if let slept = b.long(MEMORY_LAST_SLEPT) {
                wants = now - slept < 24000 and not b.has(MEMORY_GOLEM_DETECTED_RECENTLY)
            }
        }
        if wants {
            self.living.show(Shown.Missing(String("A villager's summoning an iron golem, spawnGolemIfNeeded")), heard)
        }
        if fresh > 0 and self.reprice() {
            self.living.show(Shown.Repriced, heard)
        }
    }

    /// What another's behavior did to it, `Told.WalkTo`: it looks at and walks to `to`'s eyes at
    /// the speed till it's as near as `stop`, where its brain has those memories (CAL-160).
    pub fn walk_to(mut self, to: i32, speed: f32, stop: i32) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: to, eyes: true })))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: to, eyes: true }), speed: speed, close_enough: stop }))
        self.brain = some(brain)
    }

    // `ShowTradesToPlayer.checkExtraStartConditions`: what it interacts with a player alive, it
    // grown, and the player within about 4 of it, 17 squared.
    fn shows_trades(self, brain: Brain) -> bool {
        let id = brain.entity(MEMORY_INTERACTION_TARGET) else return false
        let n = self.near_of(id) else return false
        return n.species == PLAYER and n.alive and not self.baby() and self.distance_sqr_to(n.x, n.y, n.z) <= 17.0
    }

    // `LookAndFollowTradingPlayerSink.checkExtraStartConditions`, and `canStillUse` (CAL-160):
    // alive and trading with a player its level found, not in water, not hurt lately,
    // `wasHurtRecently`, and within 4 of them.
    fn follows_trader(self) -> bool {
        let t = self.trading else return false
        let n = self.near_of(t.id) else return false
        return self.living.alive() and not self.living.body.in_water and self.living.hurt_time <= 0 and self.distance_sqr_to(n.x, n.y, n.z) <= 16.0
    }

    // `LookAndFollowTradingPlayerSink.followPlayer`: the player it trades with walked to at
    // `speed` till it's within 2, and their eyes looked at.
    fn follow_trader(self, brain: mut Brain, speed: f32) {
        let t = self.trading else return
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: t.id, eyes: false }), speed: speed, close_enough: 2 }))
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: t.id, eyes: true })))
    }

    // `ShowTradesToPlayer.tick`: the player looked at; where what's in their main hand isn't what
    // was, `isSameItem`, what it shows forgotten, and where it isn't nothing, what the offers it
    // pays for give shown, `findItemsToDisplay`, its offers made as they're first asked for,
    // `getOffers`: none for no trades, else by its level once its tick's done, `Shown.Offers`,
    // which looks for what to show again then, `offers_made`. With something to show, it's held
    // in turn, `displayCyclingItems`; else its main hand's emptied and 40 ticks left at most. And
    // a tick less.
    fn show_trades_tick(mut self, brain: mut Brain, keep: mut Keep, sounds: List<EntitySound>) {
        let id = look_at_interaction(mut brain) else return
        let n = self.near_of(id) else return
        let changed = if let had = keep.player_item { had != n.main_hand } else { true }
        if changed {
            keep.player_item = some(n.main_hand)
            keep.display = List<Tag>()
            if n.main_hand != 0 {
                let (_, profession, _) = self.living.data.villager(OWN + 1)
                let name = builtin_name(24, profession)
                if self.kept.contains("Offers") {
                    self.find_display(mut keep, n.main_hand)
                } else if name != "minecraft:none" and name != "minecraft:nitwit" {
                    keep.awaiting_offers = true
                    let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    self.living.show(Shown.Offers((x, y, z, 0)), sounds.len())
                } else {
                    self.kept.insert(String("Offers"), Tag.Compound(JavaHashMap<String, Tag>()))
                }
            }
        }
        self.show_rest(mut keep)
    }

    // The rest of `ShowTradesToPlayer.tick`, after what to show's been looked for: with something
    // to show, it's held in turn; else its main hand's emptied and 40 ticks left at most; and a
    // tick less.
    fn show_rest(mut self, keep: mut Keep) {
        if keep.display.is_empty() {
            self.clear_held_item()
            keep.look_time = keep.look_time.min(40)
        } else if keep.display.len() >= 2 {
            // `displayCyclingItems`: each 40 ticks, the next held, back to the first after the
            // last.
            keep.cycle += 1
            if keep.cycle >= 40 {
                keep.display_index += 1
                keep.cycle = 0
                if usize.wrap(keep.display_index) > keep.display.len() - 1 {
                    keep.display_index = 0
                }
                self.hold_shown(keep.display[usize.wrap(keep.display_index)].copy())
            }
        }
        keep.look_time -= 1
    }

    // `updateDisplayItems` for the player's item of the name's hash `hand`: of its offers in their
    // order, what each that isn't out of stock gives, `assemble`, where the item's what it costs,
    // either of its costs, `isSameItem`; with any, 900 ticks to look, and the first held,
    // `displayFirstItem`.
    fn find_display(mut self, keep: mut Keep, hand: i32) {
        for o in self.offers() {
            let Tag.Compound(c) = o else continue
            if int_or(c, "uses", 0) >= int_or(c, "maxUses", 4) {
                continue
            }
            var pays = false
            for cost in ["buy", "buyB"] {
                if c.contains(cost) and string_hash(held_name(some(c[cost].copy()))) == hand {
                    pays = true
                }
            }
            if pays and c.contains("sell") {
                keep.display.push(c["sell"].copy())
            }
        }
        if not keep.display.is_empty() {
            keep.look_time = 900
            self.hold_shown(keep.display[0].copy())
        }
    }

    // `ShowTradesToPlayer.displayAsHeldItem`: the stack in its main hand, never dropped.
    fn hold_shown(mut self, stack: own Tag) {
        self.living.equipment[0] = some(stack)
        var chances = JavaHashMap<String, Tag>()
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(had) = self.kept["drop_chances"] {
                chances = had.copy()
            }
        }
        chances.insert(String("mainhand"), Tag.Float(0.0f32))
        self.kept.insert(String("drop_chances"), Tag.Compound(chances))
    }

    /// Its offers made by its level once its tick's done (CAL-160), where `ShowTradesToPlayer`
    /// asked for them as it looked for what to show: what the player's item pays for looked for
    /// again, and the rest of that tick done again from there, as vanilla's tick does it with
    /// the offers made then and there.
    pub fn offers_made(mut self) {
        var brain = self.brain.take() else return
        var runs = brain.take_runs()
        for i in 0..runs.len() {
            if let Behavior.ShowTrades(_) = runs[i].deed.kind {
                if runs[i].deed.keep.awaiting_offers {
                    var keep = runs[i].deed.keep.copy()
                    keep.awaiting_offers = false
                    let hand = keep.player_item ?? 0
                    self.find_display(mut keep, hand)
                    if not keep.display.is_empty() {
                        self.show_rest(mut keep)
                    }
                    runs[i].deed.keep = keep
                }
            }
        }
        brain.give_back_runs(runs)
        self.brain = some(brain)
    }

    // `ShowTradesToPlayer.clearHeldItem`: its main hand emptied, and its chance of dropping what's
    // there the default, 0.085, as `drop_chances` leaves it out.
    fn clear_held_item(mut self) {
        self.living.equipment[0] = none
        if not self.kept.contains("drop_chances") {
            return
        }
        var chances = JavaHashMap<String, Tag>()
        if let Tag.Compound(had) = self.kept["drop_chances"] {
            chances = had.copy()
        }
        _ = chances.remove(String("mainhand"))
        if chances.is_empty() {
            _ = self.kept.remove(String("drop_chances"))
        } else {
            self.kept.insert(String("drop_chances"), Tag.Compound(chances))
        }
    }

    // `MoveToTargetSink.start`: its path the brain's, by its number, and followed at its speed,
    // which leaves the navigation's where it's the same.
    fn follow_path<B: CollisionBlocks + NavLevel>(mut self, brain: mut Brain, keep: mut Keep, lf: LivingFacts, f: Facts, blocks: B, min_y: i32) {
        let found = keep.found.take()
        let id = if let p = found { some(p.id) } else { none }
        brain.set_or_erase(MEMORY_PATH, if let n = id { some(Memo.Path(n)) } else { none })
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        _ = self.navigation.move_along(lf, f, nf, blocks, w, found, f64(keep.speed))
    }

    // `MoveToTargetSink.tryComputePath`: a path made to the block its walk target `walk` is at,
    // and its speed kept; where it's reached it, whether it can reach it forgotten and no more;
    // else whether it can kept, `CANT_REACH_WALK_TARGET_SINCE` from `now` where it can't, then
    // whether it has a path, else one made toward a place drawn on the way to it,
    // `DefaultRandomPos.getPosTowards`.
    fn compute_path<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, walk: Walk, keep: mut Keep, now: i64, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let (tx, ty, tz) = self.tracked_block(walk.target) ?? self.block_position()
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        let found = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, w, tx, ty, tz, 0)
        keep.speed = walk.speed
        let can_reach = if let p = found { p.reached } else { false }
        let has = found != none
        keep.path = if let p = found { some(p.id) } else { none }
        keep.found = found
        if self.reached(walk) {
            brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
            return false
        }
        if can_reach {
            brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
        } else if not brain.has(MEMORY_CANT_REACH_WALK_TARGET_SINCE) {
            brain.set(MEMORY_CANT_REACH_WALK_TARGET_SINCE, Memo.Long(now))
        }
        if has {
            return true
        }
        let wander = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y() }
        let dir = (f64(tx) + 0.5 - self.living.body.x, f64(tz) + 0.5 - self.living.body.z)
        let tries = towards_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, wander, 10, 7, dir)
        let partial = self.best_place(lf, f, blocks, tries) else return false
        let (px, py, pz) = partial
        let towards = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, w, floor_of(px), floor_of(py), floor_of(pz), 0)
        keep.path = if let p = towards { some(p.id) } else { none }
        keep.found = towards
        return keep.path != none
    }

    // `MoveToTargetSink.reachedTarget`: its walk target's block within its near enough of its own
    // block, `distManhattan`.
    fn reached(self, walk: Walk) -> bool {
        let (tx, ty, tz) = self.tracked_block(walk.target) else return false
        let (x, y, z) = self.block_position()
        return (tx - x).abs() + (ty - y).abs() + (tz - z).abs() <= walk.close_enough
    }

    // `tickOrStop` of the running behavior `d`: a gate's running behaviors each, then stopped
    // where none runs; a one-shot stopped; `DoNothing` stopped once its time's out; any other
    // ticked while it isn't timed out and can go on, `canStillUse`, else stopped, `doStop`.
    fn tick_or_stop<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, d: mut Deed, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) {
        if let Behavior.Gate(_) = d.kind {
            var g = d.gate.take() else return
            for i in 0..g.entries.len() {
                if g.entries[i].deed.running {
                    self.tick_or_stop(mut brain, mut g.entries[i].deed, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds)
                }
            }
            if not g.any_running() {
                // `doStop`: what it forgets as it stops, `exitErasedMemories`, forgotten.
                d.running = false
                for e in g.erases {
                    brain.erase(e)
                }
            }
            d.gate = some(g)
            return
        }
        let kind = d.kind
        if not timed(kind) {
            d.running = false
            return
        }
        if let Behavior.Idle(_) = kind {
            if now > d.end {
                d.running = false
            }
            return
        }
        // `JumpOnBed` never times out, `timedOut`.
        let out = if let Behavior.JumpOnBed(_) = kind { false } else { timed_out(d, now) }
        if not out and self.still_on(mut brain, kind, d.keep, now, f, m, blocks) {
            self.tick_behavior(mut brain, kind, mut d.keep, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds)
        } else {
            d.running = false
            self.stop_behavior(mut brain, kind, mut d.keep, mut random, mut sounds)
        }
    }

    // Whether the behavior of the kind `kind` can go on, `canStillUse`.
    fn still_on<B: CollisionBlocks>(mut self, brain: mut Brain, kind: Behavior, keep: Keep, now: i64, f: Facts, m: MovementStates, blocks: B) -> bool {
        match kind {
            Behavior.Swim(_) => return self.floats(),
            Behavior.Panic(_) => return true,
            Behavior.LookAtTarget(_) => {
                let t = brain.tracker(MEMORY_LOOK_TARGET) else return false
                return self.tracker_visible(mut brain, t, f, m, blocks)
            },
            Behavior.MoveToTarget(_) => {
                if keep.path == none or keep.last_target == none {
                    return false
                }
                let walk = brain.walk(MEMORY_WALK_TARGET) else return false
                var spectator = false
                if let Tracker.Entity(e) = walk.target {
                    if let n = self.near_of(e.id) {
                        spectator = n.spectator
                    }
                }
                return not self.navigation.is_done() and not self.reached(walk) and not spectator
            },
            Behavior.CountDown(memory) => return (brain.int(memory) ?? 0) > 0,
            Behavior.Tempted(_) => return brain.has(MEMORY_TEMPTING_PLAYER) and not brain.has(MEMORY_BREED_TARGET) and not brain.has(MEMORY_IS_PANICKING),
            Behavior.BallUp(_) => return self.scared(),
            Behavior.VillagerPanic(_) => return brain.has(MEMORY_HURT_BY) or brain.has(MEMORY_NEAREST_HOSTILE),
            Behavior.ShowTrades(_) => return self.shows_trades(brain) and keep.look_time > 0 and brain.has(MEMORY_INTERACTION_TARGET),
            Behavior.FollowTrader(_) => return self.follows_trader(),
            Behavior.TradeWithVillager(_) => return self.trades_with(mut brain, f, m, blocks),
            Behavior.MakeLove(l) => return self.still_mating(mut brain, l, keep.child_at, now, f, m, blocks),
            // `VillagerMakeLove.canStillUse`: the baby's time not past, and breeding possible.
            Behavior.VillagerLove(_) => return now <= keep.child_at and self.breeding_possible(mut brain, f, m, blocks),
            Behavior.GoToJobSite(_) => return brain.has(MEMORY_POTENTIAL_JOB_SITE),
            Behavior.WorkAtPoi(_) => {
                // `WorkAtPoi.canStillUse`: its job site's middle still within 1.73 of it, in its
                // dimension.
                let g = brain.place(MEMORY_JOB_SITE) else return false
                return g.dimension == self.dimension and self.near_middle(g.pos, 1.73)
            },
            Behavior.Harvest(_) => return keep.ticks < 200,
            Behavior.Bonemeal(_) => return keep.ticks < 80 and keep.last_target != none,
            Behavior.Sleep(_) => {
                // `SleepInBed.canStillUse`: in its rest, above its home's bed by 0.4 and within
                // 1.14 of its middle.
                let g = brain.place(MEMORY_HOME) else return false
                return brain.is_active(ACTIVITY_REST) and self.living.body.y > f64(g.pos.y) + 0.4 and self.near_middle(g.pos, 1.14)
            },
            Behavior.JumpOnBed(_) => {
                // `JumpOnBed.canStillUse`: a baby whose bed's still one to jump on, not tired of
                // walking to it, off it with no ticks left, nor of jumping, on or over it with no
                // jumps left.
                let (bx, by, bz) = keep.bed else return false
                if not self.baby() or not jumpable(f, blocks, bx, by, bz) {
                    return false
                }
                let over = self.on_or_over_bed(f, blocks)
                return (over or keep.to_reach > 0) and not (over and keep.jumps <= 0)
            },
            _ => return false,
        }
    }

    // What the running behavior of the kind `kind` does each tick, `tick`.
    fn tick_behavior<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) {
        match kind {
            Behavior.Harvest(_) => self.harvest_tick(mut brain, mut keep, now, mut random, lf, f, blocks, mut sounds),
            Behavior.Bonemeal(_) => self.bonemeal_tick(mut brain, mut keep, now, mut random, f, blocks, sounds),
            Behavior.Swim(chance) => {
                if self.living.body.random.next_float() < chance {
                    self.jump = true
                }
            },
            Behavior.Panic(speed) => {
                if self.navigation.is_done() {
                    if let p = self.panic_place(lf, f, m, blocks, mut cache, min_y) {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                    }
                }
            },
            Behavior.LookAtTarget(_) => {
                if let t = brain.tracker(MEMORY_LOOK_TARGET) {
                    if let p = self.tracked_place(t) {
                        let (x, y, z) = p
                        self.look.set_look_at(x, y, z, HEAD_ROT_SPEED, MAX_HEAD_X_ROT)
                    }
                }
            },
            Behavior.MoveToTarget(_) => {
                // Its path as its navigation has it now, where that's another, and where its walk
                // target's moved more than 2 blocks from where it last made one to, a new one
                // followed.
                let now_path = self.navigation.path_id()
                let has = now_path != none
                if now_path != keep.path {
                    keep.path = now_path
                    brain.set_or_erase(MEMORY_PATH, if let n = now_path { some(Memo.Path(n)) } else { none })
                }
                if has and keep.last_target != none {
                    let walk = brain.walk(MEMORY_WALK_TARGET) else return
                    let (lx, ly, lz) = keep.last_target ?? (0, 0, 0)
                    if let at = self.tracked_block(walk.target) {
                        let (tx, ty, tz) = at
                        let (dx, dy, dz) = (f64(tx - lx), f64(ty - ly), f64(tz - lz))
                        if dx * dx + dy * dy + dz * dz > 4.0 and self.compute_path(mut brain, walk, mut keep, now, lf, f, m, blocks, mut cache, min_y) {
                            keep.last_target = some(at)
                            self.follow_path(mut brain, mut keep, lf, f, blocks, min_y)
                        }
                    }
                }
            },
            Behavior.CountDown(memory) => {
                let left = brain.int(memory) ?? 0
                brain.set(memory, Memo.Int(left - 1))
            },
            Behavior.Tempted(speed) => {
                let player = brain.entity(MEMORY_TEMPTING_PLAYER) else return
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: player, eyes: true })))
                let close = if self.baby() { 1.0 } else { 2.0 }
                let n = self.near_of(player) else return
                if self.distance_sqr_to(n.x, n.y, n.z) < close * close {
                    brain.erase(MEMORY_WALK_TARGET)
                } else {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: player, eyes: false }), speed: speed, close_enough: 2 }))
                }
            },
            Behavior.BallUp(_) => self.ball_up_tick(brain, mut keep, mut sounds),
            Behavior.VillagerPanic(_) => {
                // Every 100 ticks of the game, an iron golem summoned where enough villagers near
                // want one, `spawnGolemIfNeeded`, a Missing notice so far; one wants one only where
                // it slept in the last day and hasn't seen a golem lately.
                if now % 100 == 0 {
                    if let slept = brain.long(MEMORY_LAST_SLEPT) {
                        if now - slept < 24000 and not brain.has(MEMORY_GOLEM_DETECTED_RECENTLY) {
                            self.living.show(Shown.Missing(String("A villager's summoning an iron golem, spawnGolemIfNeeded")), sounds.len())
                        }
                    }
                }
            },
            Behavior.ShowTrades(_) => self.show_trades_tick(mut brain, mut keep, sounds),
            Behavior.FollowTrader(speed) => self.follow_trader(mut brain, speed),
            Behavior.TradeWithVillager(_) => self.trade_with_villager_tick(mut brain, keep, now, f, sounds),
            Behavior.VillagerLove(_) => self.make_love_tick(mut brain, keep, now, lf, f, m, blocks, mut cache, min_y, sounds),
            Behavior.MakeLove(l) => self.mate_tick(mut brain, l, keep.child_at, now, sounds),
            Behavior.GoToJobSite(speed) => {
                // `GoToPotentialJobSite.tick`: the job site it found looked at and walked to till
                // it's within 1, `setWalkAndLookTargetMemories`.
                if let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) {
                    let (x, y, z) = (g.pos.x, g.pos.y, g.pos.z)
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: speed, close_enough: 1 }))
                }
            },
            Behavior.JumpOnBed(_) => {
                // `JumpOnBed.tick`: off its bed, a tick less to reach it; on or over it, a tick
                // less to wait, else, on its surface, a jump, a jump less and 5 ticks till the
                // next.
                if not self.on_or_over_bed(f, blocks) {
                    keep.to_reach -= 1
                } else if keep.jump_wait > 0 {
                    keep.jump_wait -= 1
                } else {
                    let (x, y, z) = self.block_position()
                    if jumpable(f, blocks, x, y, z) {
                        self.jump = true
                        keep.jumps -= 1
                        keep.jump_wait = 5
                    }
                }
            },
            _ => {},
        }
    }

    // `ArmadilloBallUp.tick`: its peek a tick nearer; rolled long enough, scared, landing heard on
    // the ground; else, as the danger seen runs out, more than 75 ticks left counting as about,
    // its peek drawn again as that changes; scared, peeking on the ground while danger's about,
    // entity event 64, and starting to unroll once fewer than 30 are left, `UNROLLING`'s length;
    // unrolling, scared again where more are.
    fn ball_up_tick(mut self, brain: Brain, keep: mut Keep, sounds: mut List<EntitySound>) {
        if keep.peek > 0 {
            keep.peek -= 1
        }
        if self.armadillo_state() == ARMADILLO_ROLLING and self.in_state_ticks > i64(animation_of(ARMADILLO_ROLLING)) {
            self.switch_to_state(ARMADILLO_SCARED)
            if self.living.body.on_ground {
                self.living.play(mut sounds, String("entity.armadillo.land"), 1.0f32, 1.0f32)
            }
            return
        }
        let state = self.armadillo_state()
        let left = brain.ttl(MEMORY_DANGER_DETECTED_RECENTLY)
        let about = left > 75
        if about != keep.danger_was {
            keep.peek = self.pick_peek()
        }
        keep.danger_was = about
        let unrolling = i64(animation_of(ARMADILLO_UNROLLING))
        if state == ARMADILLO_SCARED {
            if keep.peek == 0 and self.living.body.on_ground and about {
                self.living.show(Shown.Event(64), sounds.len())
                keep.peek = self.pick_peek()
            }
            if left < unrolling {
                self.living.play(mut sounds, String("entity.armadillo.unroll_start"), 1.0f32, 1.0f32)
                self.switch_to_state(ARMADILLO_UNROLLING)
            }
        } else if state == ARMADILLO_UNROLLING and left > unrolling {
            self.switch_to_state(ARMADILLO_SCARED)
        }
    }

    // What the behavior of the kind `kind` does as it stops, `stop`.
    fn stop_behavior(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        match kind {
            Behavior.Sleep(_) => {
                // `SleepInBed.stop`: asleep, it gets up, which it does as its brain's tick goes
                // on, where the blocks around it are; its next start 40 ticks on.
                if self.living.sleeping != none {
                    self.wake_due = true
                    keep.next_start = self.game_time + 40
                }
            },
            Behavior.Harvest(_) => {
                // `HarvestFarmland.stop`: its look and walk forgotten, its ticks worked none
                // again, and its next start 40 ticks on.
                brain.erase(MEMORY_LOOK_TARGET)
                brain.erase(MEMORY_WALK_TARGET)
                keep.ticks = 0
                keep.next_start = self.game_time + 40
            },
            Behavior.Bonemeal(_) => {
                // `UseBonemeal.stop`: its main hand empty again, and its tick count kept.
                self.living.equipment[0] = none
                keep.last_check = i64(self.living.body.tick_count)
            },
            Behavior.Panic(_) => brain.erase(MEMORY_IS_PANICKING),
            Behavior.LookAtTarget(_) => brain.erase(MEMORY_LOOK_TARGET),
            Behavior.MoveToTarget(_) => {
                // Stuck short of its walk target, it waits up to 39 ticks, drawn from the level's
                // random, before it tries again.
                if let walk = brain.walk(MEMORY_WALK_TARGET) {
                    if not self.reached(walk) and self.navigation.stuck {
                        keep.cooldown = random.next_int_below(40)
                    }
                }
                self.navigation.stop()
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_PATH)
                keep.path = none
                keep.found = none
            },
            Behavior.CountDown(memory) => brain.erase(memory),
            Behavior.Tempted(_) => {
                brain.set(MEMORY_TEMPTATION_COOLDOWN_TICKS, Memo.Int(100))
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_LOOK_TARGET)
            },
            Behavior.BallUp(_) => {
                if not self.can_stay_rolled_up() {
                    self.roll_out(mut sounds)
                }
            },
            Behavior.ShowTrades(_) => {
                brain.erase(MEMORY_INTERACTION_TARGET)
                self.clear_held_item()
                keep.player_item = none
            },
            Behavior.TradeWithVillager(_) => brain.erase(MEMORY_INTERACTION_TARGET),
            Behavior.VillagerLove(_) => brain.erase(MEMORY_BREED_TARGET),
            Behavior.MakeLove(_) => {
                // `AnimalMakeLove.stop`: its breed, walk and look targets forgotten, and no baby
                // to come.
                brain.erase(MEMORY_BREED_TARGET)
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_LOOK_TARGET)
                keep.child_at = 0
            },
            Behavior.FollowTrader(_) => {
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_LOOK_TARGET)
            },
            Behavior.GoToJobSite(_) => {
                // `GoToPotentialJobSite.stop`: where the job site it found is a point of interest
                // still, its ticket given back, and the site forgotten.
                if let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) {
                    if g.dimension != self.dimension {
                        self.living.show(Shown.Missing(String("A villager's giving back a job site's ticket in another dimension, GoToPotentialJobSite")), sounds.len())
                    } else {
                        var pois = self.pois.take() ?? Pois.new(0, 0)
                        if pois.exists(g.pos, types_of(u32.MAX)) {
                            _ = pois.release(g.pos)
                        }
                        self.pois = some(pois)
                    }
                }
                brain.erase(MEMORY_POTENTIAL_JOB_SITE)
            },
            Behavior.JumpOnBed(_) => {
                keep.bed = none
                keep.to_reach = 0
                keep.jumps = 0
                keep.jump_wait = 0
            },
            _ => {},
        }
    }

    // `Swim`'s and `FloatGoal`'s: deeper in water than it jumps out of, `getFluidJumpThreshold`,
    // 0.4 or 0 for eyes below 0.4, or in lava.
    fn floats(self) -> bool {
        let threshold = if f64(self.living.body.eyes) < 0.4 { 0.0 } else { 0.4 }
        return self.living.body.water > threshold or self.living.body.in_lava()
    }

    // `AnimalPanic.getPanicPos`: on fire, the nearest water, `lookForWater`; else a place on land
    // up to 5 across and 4 up or down, `LandRandomPos.getPos`.
    fn panic_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        if self.living.on_fire() {
            if let w = self.look_for_water(f, m, blocks) {
                let (wx, wy, wz) = w
                return some((f64(wx) + 0.5, f64(wy), f64(wz) + 0.5))
            }
        }
        return self.random_place(true, 5, 4, lf, f, blocks, mut cache, min_y)
    }

    // `Armadillo.customServerAiStep`, before `Animal`'s (CAL-160): its brain's tick; its activity,
    // `updateActivity`, panic where danger's been seen and it isn't panicking, else idle; then,
    // alive, its scute time a tick less, and at 0 where it drops loot, a scute shed,
    // `gameplay/armadillo_shed`, as its level drops it, its sound's pitch drawn, and its time drawn
    // again. The game event of its shedding comes with game events.
    fn armadillo_step<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        // Its brain swings no doors, so its tick never stops.
        _ = self.tick_brain(lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        if let held = self.brain.take() {
            var brain = held
            let order: List<i32> = [ACTIVITY_PANIC, ACTIVITY_IDLE]
            brain.set_first_valid(order)
            self.brain = some(brain)
        }
        if not self.living.alive() {
            return
        }
        self.scute_time -= 1
        if self.scute_time <= 0 and self.mob_drops and not self.baby() {
            let laid = Laid { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, item: String("minecraft:armadillo_scute"), table: String("minecraft:gameplay/armadillo_shed") }
            self.living.show(Shown.Laid(laid), sounds.len())
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, String("entity.armadillo.scute_drop"), 1.0f32, (a - b) * 0.2f32 + 1.0f32)
            self.scute_time = self.pick_scute_time()
        }
    }

    // `HarvestFarmland.tick` (CAL-160): where it has a block to work, once that's within 1 of it,
    // past its next start: a ripe crop there broken with its drops, `destroyBlock`, which stops
    // its brain's tick for its level to break it then; air on farmland there planted, `plant_at`,
    // where it has seeds, `hasFarmSeeds`; and a crop there still growing given up for another
    // drawn of those left, walked to and looked at, 20 ticks on. What's there is read as it was
    // as the tick began, so a crop it breaks isn't planted till its next. Its ticks worked
    // counted where it has no block to work or it's near enough.
    fn harvest_tick<B: CollisionBlocks>(mut self, brain: mut Brain, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, blocks: B, sounds: mut List<EntitySound>) {
        if let t = keep.last_target {
            let (tx, ty, tz) = t
            if not self.near_middle(BlockPos { x: tx, y: ty, z: tz }, 1.0) {
                return
            }
            if now > keep.next_start {
                let state = state_at(blocks, tx, ty, tz)
                let block = f.block(state)
                let crop = f.is_a(block, String("CropBlock"))
                let ripe = crop and (f.get_int(state, String("age")) ?? 0) >= f.crop_max_age(block)
                if ripe {
                    self.living.show(Shown.Harvested((tx, ty, tz)), sounds.len())
                    self.stop_due = true
                }
                if f.is_air(state) and f.is_a(f.block(state_at(blocks, tx, ty - 1, tz)), String("FarmlandBlock")) and self.has_farm_seeds(lf, f) {
                    self.plant_at(lf, f, tx, ty, tz, mut sounds)
                }
                if crop and not ripe {
                    var k = 0usize
                    while k < keep.farmland.len() {
                        let (fx, fy, fz) = keep.farmland[k]
                        if fx == tx and fy == ty and fz == tz {
                            _ = keep.farmland.remove(k)
                            break
                        }
                        k += 1
                    }
                    keep.last_target = pick_farmland(keep.farmland, mut random)
                    if let n = keep.last_target {
                        let (x, y, z) = n
                        keep.next_start = now + 20
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: 0.5f32, close_enough: 1 }))
                        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
                    }
                }
            }
        }
        keep.ticks += 1
    }

    // `Villager.hasFarmSeeds`: whether its inventory holds a seed in `#villager_plantable_seeds`.
    fn has_farm_seeds(mut self, lf: LivingFacts, f: Facts) -> bool {
        self.ready_inventory(f)
        for s in self.inventory {
            let t = s else continue
            let item = held_name(some(t.copy()))
            for (name, _) in lf.plantable {
                if name == item {
                    return true
                }
            }
        }
        return false
    }

    // A farmer's seed planted at x, y, z, as `HarvestFarmland.tick` plants it (CAL-160): of its
    // inventory's slots in order, the first holding a seed in `#villager_plantable_seeds` that
    // places a block, its block's state set and updated there, which its level does; the crop's
    // planting sound played from the block's corner, as vanilla plays it; and one seed fewer.
    fn plant_at(mut self, lf: LivingFacts, f: Facts, x: i32, y: i32, z: i32, sounds: mut List<EntitySound>) {
        self.ready_inventory(f)
        for i in 0..self.inventory.len() {
            let t = self.inventory[i].copy() else continue
            let item = held_name(some(t))
            for (name, placed) in lf.plantable {
                if name != item {
                    continue
                }
                let state = placed else continue
                self.living.show(Shown.Planted((x, y, z, state)), sounds.len())
                sounds.push(EntitySound { sound: String("item.crop.plant"), x: f64(x), y: f64(y), z: f64(z), volume: 1.0f32, pitch: 1.0f32, source: BLOCKS_SOURCE })
                self.shrink_slot(i)
                return
            }
        }
    }

    // A villager's inventory slot `i` one fewer, `shrink(1)`, empty where that was its last.
    fn shrink_slot(mut self, i: usize) {
        let t = self.inventory[i].copy() else return
        let n = count_of(some(t.copy()))
        if n <= 1 {
            self.inventory[i] = none
            return
        }
        self.inventory[i] = some(stack_of_count(t, n - 1))
    }

    // `UseBonemeal.pickNextTarget` (CAL-160): of the crops around it, 1 each way from its block, x,
    // then y, then z, short of their last age, `validPos`, one drawn from the level's random as
    // each's found, kept where `nextInt` of how many so far is 0; `grown` a crop just grown, read
    // as it's grown.
    fn pick_crop<B: CollisionBlocks>(self, f: Facts, blocks: B, grown: (i32, i32, i32, u32)?, random: mut TapedRandom) -> (i32, i32, i32)? {
        let (bx, by, bz) = self.block_position()
        var found: (i32, i32, i32)? = none
        var count = 0
        for dx in -1..2 {
            for dy in -1..2 {
                for dz in -1..2 {
                    let (x, y, z) = (bx + dx, by + dy, bz + dz)
                    var state = state_at(blocks, x, y, z)
                    if let g = grown {
                        let (gx, gy, gz, s) = g
                        if gx == x and gy == y and gz == z {
                            state = s
                        }
                    }
                    let block = f.block(state)
                    if f.is_a(block, String("CropBlock")) and (f.get_int(state, String("age")) ?? 0) < f.crop_max_age(block) {
                        count += 1
                        if random.next_int_below(count) == 0 {
                            found = some((x, y, z))
                        }
                    }
                }
            }
        }
        return found
    }

    // `UseBonemeal.tick` (CAL-160): from its next go, once its crop's within 1 of it, the first
    // bone meal in its inventory put on it, `BoneMealItem.growCrop`, where it's a crop short of
    // its last age: 2 to 5 ages older, drawn from the level's random, a beetroot a third of that
    // and a torchflower crop 1, `getBonemealAgeIncrease`, set with flags 2, which its level does,
    // and one bone meal fewer; its particles shown, level event 1505 with 15; then its next crop
    // picked, the one grown read as it is now, looked at and walked to, its next go 40 ticks on.
    // Only crops are picked, so what's no crop there now takes none. Its ticks worked counted.
    fn bonemeal_tick<B: CollisionBlocks>(mut self, brain: mut Brain, keep: mut Keep, now: i64, random: mut TapedRandom, f: Facts, blocks: B, sounds: List<EntitySound>) {
        let t = keep.last_target else return
        let (x, y, z) = t
        if now < keep.next_start or not self.near_middle(BlockPos { x: x, y: y, z: z }, 1.0) {
            return
        }
        self.ready_inventory(f)
        var slot: usize? = none
        for i in 0..self.inventory.len() {
            if let s = self.inventory[i] {
                if held_name(some(s.copy())) == "minecraft:bone_meal" {
                    slot = some(i)
                    break
                }
            }
        }
        if let i = slot {
            let state = state_at(blocks, x, y, z)
            let block = f.block(state)
            let age = f.get_int(state, String("age")) ?? 0
            let last = f.crop_max_age(block)
            if f.is_a(block, String("CropBlock")) and age < last {
                var more = 1
                if not f.is_a(block, String("TorchflowerCropBlock")) {
                    more = random.next_int_below(4) + 2
                    if f.is_a(block, String("BeetrootBlock")) {
                        more = more / 3
                    }
                }
                let grown_age = min_i32(last, age + more)
                var grown = state
                if grown_age == last and f.is_a(block, String("TorchflowerCropBlock")) {
                    if let flower = f.block_named(String("minecraft:torchflower")) {
                        grown = f.default_state(flower)
                    }
                } else {
                    match f.with_int(f.default_state(block), String("age"), grown_age) {
                        ok(s) => grown = s,
                        err(_) => {},
                    }
                }
                self.living.show(Shown.Grew((x, y, z, grown)), sounds.len())
                self.shrink_slot(i)
                self.living.show(Shown.Level((1505, x, y, z, 15)), sounds.len())
                keep.last_target = self.pick_crop(f, blocks, some((x, y, z, grown)), mut random)
                target_crop(mut brain, keep.last_target)
                keep.next_start = now + 40
            }
        }
        keep.ticks += 1
    }

    // `Villager.customServerAiStep` (CAL-160): its brain's tick; the reputation the player it last
    // traded with gets for it; then its own random's 1 in 100, for a raid there, which there never
    // is yet; and its trading stopped where it has no offers, `stopTrading`.
    // Whether its brain's tick stopped for its level to swing a door, to go on from there.
    fn villager_step<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.tick_brain(lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
            return true
        }
        if let who = self.last_traded.take() {
            // The trade it heard of, `onReputationEvent(TRADE)`: 2 trading gossip of the player,
            // its offers priced again where they're trading with it, and its happiness shown,
            // entity event 14.
            self.gossips.add(who, TRADING, 2)
            if let t = self.trading {
                if t.uuid == who {
                    self.update_special_prices(who)
                    self.living.show(Shown.Repriced, sounds.len())
                }
            }
            self.living.show(Shown.Event(14i8), sounds.len())
        }
        _ = self.living.body.random.next_int_below(100)
        if self.trading != none and not self.has_offers() {
            self.stop_trading()
        }
        return false
    }

    // `bedIsOccupiedByVillager`: whether a villager near it, by its brain's sight, sleeps with its
    // box in the block at `pos` (CAL-160).
    fn villager_sleeps_in(self, pos: BlockPos) -> bool {
        for n in self.near {
            if n.species == VILLAGER and n.sleeping and n.bounds.intersects(f64(pos.x), f64(pos.y), f64(pos.z), f64(pos.x) + 1.0, f64(pos.y) + 1.0, f64(pos.z) + 1.0) {
                return true
            }
        }
        return false
    }

    /// Its brain's interaction target, by ID, `INTERACTION_TARGET`, none without a brain (CAL-160).
    pub fn interaction_target(self) -> i32? {
        return match self.brain {
            some(b) => b.entity(MEMORY_INTERACTION_TARGET),
            none => none,
        }
    }

    /// Whether it's asleep, `isSleeping` (CAL-160).
    pub fn sleeping(self) -> bool {
        return self.living.sleeping != none
    }

    /// Wakes a villager asleep, as `kickVillagerOutOfBed` has it `stopSleeping` (D574): it gets
    /// up now, what that does to its bed kept in what it shows. Whether it was a villager asleep.
    pub fn kicked_out<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B) -> bool {
        if self.species != VILLAGER or not self.sleeping() {
            return false
        }
        self.wake_now(f, m, blocks, List<EntitySound>())
        return true
    }

    // `LivingEntity.startSleeping` in the bed at x, y, z (CAL-160): where that's a bed with a
    // shape, put on it, `setPosToBed`; the bed occupied, which its level sets and updates; its
    // pose sleeping, its size a sleeper's, `refreshDimensions`; where it sleeps held and sent;
    // its motion none, sent, `needsSync`; and no ambient sound. Whether it lay down.
    fn start_sleeping<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, x: i32, y: i32, z: i32, sounds: List<EntitySound>) -> bool {
        let state = state_at(blocks, x, y, z)
        if not f.is_a(f.block(state), "AbstractBedBlock") {
            return false
        }
        let height = bed_sleep_height(f, m, blocks, x, y, z) else return false
        self.put_on_bed(x, y, z, height)
        self.living.show(Shown.Bed((x, y, z, true)), sounds.len())
        self.living.data.set(POSE_ID, Value.Number(SLEEPING))
        self.living.set_sleeping(some((x, y, z)))
        self.refresh_size()
        self.living.body.vx = 0.0
        self.living.body.vy = 0.0
        self.living.body.vz = 0.0
        self.living.body.needs_sync = true
        self.refresh_sounds()
        return true
    }

    // `setPosToBed`: on the bed at x, y, z, in its middle across, an eighth over its top, `height`
    // up.
    fn put_on_bed(mut self, x: i32, y: i32, z: i32, height: f64) {
        self.living.body.x = f64(x) + 0.5
        self.living.body.y = f64(y) + height + 0.125
        self.living.body.z = f64(z) + 0.5
    }

    // Where a stop of its sleep has it get up, `wake_due`, it gets up (CAL-160).
    fn wake_if_due<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B, now: i64, sounds: List<EntitySound>) {
        if not self.wake_due {
            return
        }
        self.wake_due = false
        self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
    }

    // It gets up now, out of its brain's tick, its brain's memory of it kept (CAL-160).
    fn wake_now<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, sounds: List<EntitySound>) {
        let now = self.game_time
        match self.brain.take() {
            some(b) => {
                var brain = b
                self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
                self.brain = some(brain)
            },
            none => {
                var brain = Brain.empty()
                self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
            },
        }
    }

    // `LivingEntity.stopSleeping` (CAL-160): where it sleeps in a bed still, in a chunk that's
    // there, the bed no longer occupied, which its level sets and updates, and it put where it
    // gets up to, `findStandUpPosition`, for its type's size, else on the block over the bed, a
    // tenth up, turned to the bed's floor's middle, `atan2` of the way there, its pitch level;
    // then standing, its size its own again, where it sleeps forgotten, and its ambient sound
    // again; a villager's time woken remembered, `Villager.stopSleeping`.
    fn stop_sleeping<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B, now: i64, sounds: List<EntitySound>) {
        if let at = self.living.sleeping {
            let (bx, by, bz) = at
            if let state = blocks.collision_state(bx, by, bz) {
                if f.is_a(f.block(state), "AbstractBedBlock") {
                    let facing = match facing_of(f, state) {
                        ok(d) => d,
                        err(_) => 2,
                    }
                    self.living.show(Shown.Bed((bx, by, bz, false)), sounds.len())
                    let border = self.border ?? widest_border()
                    let up = stand_up_position(f, m, blocks, border, bx, by, bz, facing, self.living.body.y_rot, self.width, self.height)
                    let (sx, sy, sz) = up ?? (f64(bx) + 0.5, f64(by + 1) + 0.1, f64(bz) + 0.5)
                    let yaw = bed_yaw(bx, by, bz, sx, sy, sz)
                    self.living.body.x = sx
                    self.living.body.y = sy
                    self.living.body.z = sz
                    self.living.body.y_rot = yaw
                    self.living.body.x_rot = 0.0f32
                }
            }
        }
        self.living.data.set(POSE_ID, Value.Number(STANDING))
        self.living.set_sleeping(none)
        self.refresh_size()
        self.refresh_sounds()
        if self.species == VILLAGER {
            brain.set(MEMORY_LAST_WOKEN, Memo.Long(now))
        }
    }

    // `ValidateNearbyPoi` of the place `memory` holds, of the types `kinds` holds as bits
    // (CAL-160): where it's in its dimension and within 16 of the place's middle, the memory
    // forgotten where there's no point of interest of them there any more, or where it's a bed
    // someone's in and it isn't asleep, which it's then given back where no villager near sleeps
    // in it, `bedIsOccupiedByVillager`.
    fn validate_poi<B: CollisionBlocks>(mut self, brain: mut Brain, memory: i32, kinds: u32, f: Facts, blocks: B) -> bool {
        let g = brain.place(memory) else return false
        if g.dimension != self.dimension {
            return false
        }
        if self.distance_sqr_to(f64(g.pos.x) + 0.5, f64(g.pos.y) + 0.5, f64(g.pos.z) + 0.5) >= 256.0 {
            return false
        }
        var pois = self.pois.take() ?? Pois.new(0, 0)
        if not pois.exists(g.pos, types_of(kinds)) {
            brain.erase(memory)
        } else if bed_in_use(f, blocks, g.pos) == some(true) and self.living.sleeping == none {
            brain.erase(memory)
            if not self.villager_sleeps_in(g.pos) {
                _ = pois.release(g.pos)
            }
        }
        self.pois = some(pois)
        return true
    }

    // `AcquirePoi` (CAL-160): where the memory it takes into is empty, and it's grown or needn't
    // be: its first look put off up to 19 ticks, drawn from the level's random; then every 20 to
    // 39, drawn, the points of its types with a ticket free within 48, nearest first, but those it
    // couldn't reach lately, each tried again at its time, put off longer, drawn; the first 5,
    // a bed among them only where no one's in it; a path to the nearest it can reach of them,
    // `findPathToPois`, whose point it takes a ticket of, remembers and shows where it says so,
    // trying all again after; else each of them it hadn't tried put off, drawn, nearest first:
    // vanilla puts them off in the order of a `HashSet` of each's type and place, which for points
    // of more than one type goes by the types' identity hashes, so differs from run to run.
    fn acquire_poi<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, a: Acquire, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: List<EntitySound>) -> bool {
        if not brain.check(a.memory, STATUS_ABSENT) {
            return false
        }
        if a.adult_only and self.baby() {
            return false
        }
        if keep.next_start == 0 {
            keep.next_start = now + i64(random.next_int_below(20))
            return false
        }
        if now < keep.next_start {
            return false
        }
        keep.next_start = now + 20 + i64(random.next_int_below(20))
        var stale = List<i64>()
        for (k, r) in keep.retries {
            if now - r.previous >= 400 {
                stale.push(k)
            }
        }
        for k in stale {
            _ = keep.retries.remove(k)
        }
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let wanted = types_of(a.kinds)
        var found = List<(f64, PoiRecord)>()
        for r in pois.in_range(wanted.copy(), center, 48, Occupancy.HasSpace) {
            let key = r.pos.pack()
            if keep.retries.contains(key) {
                var retry = keep.retries[key]
                if now < retry.next {
                    continue
                }
                mark_attempt(mut retry, now, mut random)
                keep.retries.insert(key, retry)
            }
            let dx = f64(r.pos.x - bx)
            let dy = f64(r.pos.y - by)
            let dz = f64(r.pos.z - bz)
            found.push((dx * dx + dy * dy + dz * dz, r))
        }
        // Nearest first, as `sorted` keeps those as near in their order.
        for i in 1..found.len() {
            var j = i
            while j > 0 {
                let (p, _) = found[j - 1]
                let (q, _) = found[j]
                if p <= q {
                    break
                }
                found.swap(j - 1, j)
                j -= 1
            }
        }
        var picked = List<BlockPos>()
        var targets = List<(i32, i32, i32)>()
        var reach_range = 1
        var n = 0
        for (_, r) in found {
            if n == 5 {
                break
            }
            n += 1
            if a.bed and bed_in_use(f, blocks, r.pos) != some(false) {
                continue
            }
            picked.push(r.pos)
            targets.push((r.pos.x, r.pos.y, r.pos.z))
            let reach = valid_range(i32.wrap(r.kind))
            if reach > reach_range {
                reach_range = reach
            }
        }
        var reached = false
        if not targets.is_empty() {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path_to_any(lf, f, nf, m, blocks, mut cache, w, targets, reach_range) {
                if p.reached {
                    reached = true
                    let (tx, ty, tz) = p.target
                    let target = BlockPos { x: tx, y: ty, z: tz }
                    if pois.type_at(target) != none {
                        _ = pois.take(wanted, some(target), target, 1)
                        brain.set(a.memory, Memo.Place(GlobalPos { dimension: self.dimension.copy(), pos: target }))
                        if a.event >= 0 {
                            self.living.show(Shown.Event(i8.wrap(a.event)), sounds.len())
                        }
                        keep.retries.clear()
                    }
                }
            }
        }
        if not reached {
            for pos in picked {
                let key = pos.pack()
                if not keep.retries.contains(key) {
                    var retry = Retry()
                    mark_attempt(mut retry, now, mut random)
                    keep.retries.insert(key, retry)
                }
            }
        }
        self.pois = some(pois)
        return true
    }

    // `SetHiddenState` (CAL-160), staying `stay` seconds hidden within `near` of its hiding place:
    // till it's been hidden so many ticks, or 300 ticks since it heard the bell, each tick it's
    // within `near` of the place, its block's, `closerThan`, counted; then the bell and the place
    // forgotten, its activity its schedule's, `updateActivityFromSchedule`, and the count begun
    // again.
    fn hide_state(self, brain: mut Brain, keep: mut Keep, h: (i32, i32), now: i64) -> bool {
        let (stay, near) = h
        let heard = brain.long(MEMORY_HEARD_BELL_TIME) ?? 0
        let g = brain.place(MEMORY_HIDING_PLACE) else return false
        if keep.ticks <= stay * 20 and heard + 300 > now {
            let (bx, by, bz) = self.block_position()
            let (dx, dy, dz) = (i64(g.pos.x - bx), i64(g.pos.y - by), i64(g.pos.z - bz))
            if dx * dx + dy * dy + dz * dz < i64(near * near) {
                keep.ticks += 1
            }
            return true
        }
        brain.erase(MEMORY_HEARD_BELL_TIME)
        brain.erase(MEMORY_HIDING_PLACE)
        let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
        brain.update_from_schedule(now, scheduled)
        keep.ticks = 0
        return true
    }

    // `LocateHidingPlace` (CAL-160), looking `far` for a bed, walking at `speed` to within `near`:
    // the first bed within `near` and 1 of its block, taken or not, where it's within `near` of
    // that bed's middle, `closerToCenterThan`; else, of all the beds within `far`, the first as
    // they're shuffled by its own random, `getRandom`; else its home. Where there's one, its path,
    // look, breed and interaction targets forgotten, the bed its hiding place, and where it isn't
    // within `near` of its middle, walked to.
    fn locate_hiding(mut self, brain: mut Brain, l: (i32, f32, i32)) -> bool {
        let (far, speed, near) = l
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let homes = types_of(1u32 << u32.wrap(HOME))
        let close = f64(near * near)
        var found: BlockPos? = none
        let nearest = pois.in_range(homes.copy(), center, near + 1, Occupancy.Any)
        if not nearest.is_empty() {
            let p = nearest[0].pos
            if self.distance_sqr_to(f64(p.x) + 0.5, f64(p.y) + 0.5, f64(p.z) + 0.5) < close {
                found = some(p)
            }
        }
        if found == none {
            var all = pois.in_range(homes, center, far, Occupancy.Any)
            shuffle(mut all, mut self.living.body.random)
            if not all.is_empty() {
                found = some(all[0].pos)
            }
        }
        self.pois = some(pois)
        if found == none {
            if let g = brain.place(MEMORY_HOME) {
                found = some(g.pos)
            }
        }
        let pos = found else return true
        brain.erase(MEMORY_PATH)
        brain.erase(MEMORY_LOOK_TARGET)
        brain.erase(MEMORY_BREED_TARGET)
        brain.erase(MEMORY_INTERACTION_TARGET)
        brain.set(MEMORY_HIDING_PLACE, Memo.Place(GlobalPos { dimension: self.dimension.copy(), pos: pos }))
        if self.distance_sqr_to(f64(pos.x) + 0.5, f64(pos.y) + 0.5, f64(pos.z) + 0.5) >= close {
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(pos.x, pos.y, pos.z)), speed: speed, close_enough: near }))
        }
        return true
    }

    /// A bell it heard rung at the game time `now`, `HEARD_BELL_TIME`, where its brain has that
    /// memory, as a villager's does (CAL-160).
    pub fn hear_bell(mut self, now: i64) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_HEARD_BELL_TIME, Memo.Long(now))
        self.brain = some(brain)
    }

    // `PlayTagWithOtherKids` (CAL-160): one time in 10, from the level's random, of the babies it
    // sees, `VISIBLE_VILLAGER_BABIES`: where none chases it, the one with the fewest chasing it of
    // those 1 to 5 chase, chased, else the first of them, its interaction target, looked at and
    // walked to at 0.6, near enough within 1; where one does, of up to 10 places on land up to 20
    // across and 8 up or down, `LandRandomPos.getPos`, the first in a village, its section within 1
    // of a center, run to at 0.6, near enough within 0. Vanilla counts the chasers in a `HashMap`
    // of the babies chased, ordered by their identity hashes, so where two are chased by as many
    // its pick differs run to run; these go in the order they're first seen chased.
    fn play_tag<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, random: mut TapedRandom, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if random.next_int_below(10) != 0 {
            return false
        }
        let me = self.living.body.id
        let friends = brain.entities(MEMORY_VISIBLE_VILLAGER_BABIES)
        var chased_me = false
        var chased = List<i32>()
        var counts = List<i32>()
        for id in friends {
            let n = self.near_of(id) else continue
            let t = n.interacting else continue
            if t == me {
                chased_me = true
                break
            }
        }
        if not chased_me {
            for id in friends {
                let n = self.near_of(id) else continue
                let t = n.interacting else continue
                var k: usize? = none
                for i in 0..chased.len() {
                    if chased[i] == t {
                        k = some(i)
                        break
                    }
                }
                match k {
                    some(i) => counts[i] += 1,
                    none => {
                        chased.push(t)
                        counts.push(1)
                    },
                }
            }
            var pick: i32? = none
            var least = 6
            for i in 0..chased.len() {
                if counts[i] > 0 and counts[i] < least {
                    least = counts[i]
                    pick = some(chased[i])
                }
            }
            if pick == none and not friends.is_empty() {
                pick = some(friends[0])
            }
            if let kid = pick {
                brain.set(MEMORY_INTERACTION_TARGET, Memo.Entity(kid))
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: kid, eyes: true })))
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: kid, eyes: false }), speed: 0.6f32, close_enough: 1 }))
            }
            return true
        }
        for _ in 0..10 {
            if let p = self.random_place(true, 20, 8, lf, f, blocks, mut cache, min_y) {
                let (x, y, z) = p
                var pois = self.pois.take() ?? Pois.new(0, 0)
                let village = pois.sections_to_village(floor_of(x) >> 4, floor_of(y) >> 4, floor_of(z) >> 4) <= 1
                self.pois = some(pois)
                if village {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, 0.6f32, 0)))
                    break
                }
            }
        }
        return true
    }

    // `SetClosestHomeAsWalkTarget` (CAL-160): 20 ticks at least since it last looked,
    // `lastUpdate`, kept in `last_check`, where the nearest bed within 48 of its block, of any
    // occupancy, is farther than 2 blocks: its next look put off up to 19 ticks more, drawn from
    // the level's random; of the beds within 48, in the order the level finds them, those it
    // hasn't tried lately, up to 4, each kept as tried 40 ticks past then, `batchCache`, kept in
    // `retries`; a path to the nearest it can reach of them, `findPathToPois`, walked to where it
    // reaches it and it's a point of interest still, near enough within 1; else, where fewer than 5
    // were new, those kept past their time forgotten.
    fn home_walk<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, speed: f32, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if now - keep.last_check < 20 {
            return false
        }
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let homes = types_of(1u32 << u32.wrap(HOME))
        let records = pois.in_range(homes, center, 48, Occupancy.Any)
        var nearest: f64? = none
        for r in records {
            let (dx, dy, dz) = (f64(r.pos.x - bx), f64(r.pos.y - by), f64(r.pos.z - bz))
            let d = dx * dx + dy * dy + dz * dz
            if nearest == none or d < (nearest ?? 0.0) {
                nearest = some(d)
            }
        }
        let closest = nearest ?? 0.0
        if nearest == none or closest <= 4.0 {
            self.pois = some(pois)
            return false
        }
        keep.last_check = now + i64(random.next_int_below(20))
        var tried = 0
        var targets = List<(i32, i32, i32)>()
        var reach_range = 1
        for r in records {
            let key = r.pos.pack()
            if keep.retries.contains(key) {
                continue
            }
            tried += 1
            if tried >= 5 {
                continue
            }
            keep.retries.insert(key, Retry { next: keep.last_check + 40 })
            targets.push((r.pos.x, r.pos.y, r.pos.z))
            let reach = valid_range(i32.wrap(r.kind))
            if reach > reach_range {
                reach_range = reach
            }
        }
        var reached = false
        if not targets.is_empty() {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path_to_any(lf, f, nf, m, blocks, mut cache, w, targets, reach_range) {
                if p.reached {
                    reached = true
                    let (tx, ty, tz) = p.target
                    if pois.type_at(BlockPos { x: tx, y: ty, z: tz }) != none {
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(tx, ty, tz)), speed: speed, close_enough: 1 }))
                    }
                }
            }
        }
        if not reached and tried < 5 {
            var gone = List<i64>()
            for (k, r) in keep.retries {
                if r.next < keep.last_check {
                    gone.push(k)
                }
            }
            for k in gone {
                _ = keep.retries.remove(k)
            }
        }
        self.pois = some(pois)
        return true
    }

    // `InsideBrownianWalk` (CAL-160): where its block doesn't see the sky, the 27 blocks around
    // and at it, x fastest, then y, then z, shuffled with its own random for it, as
    // `Collections.shuffle` does, `shuffle_random`; the first of them that doesn't see the sky,
    // whose chunk's there and that it can stand on, `loadedAndEntityCanStandOn`, while it has room
    // where it is, `noCollision`, walked to, near enough within 0.
    fn brownian_walk<B: CollisionBlocks + MobLight>(mut self, brain: mut Brain, speed: f32, f: Facts, m: MovementStates, blocks: B) -> bool {
        let (bx, by, bz) = self.block_position()
        if blocks.sees_sky(bx, by, bz) {
            return false
        }
        var around = List<(i32, i32, i32)>()
        for z in (bz - 1)..(bz + 2) {
            for y in (by - 1)..(by + 2) {
                for x in (bx - 1)..(bx + 2) {
                    around.push((x, y, z))
                }
            }
        }
        var shuffler = self.shuffle_random.take() ?? LegacyRandom.new(gate_seed(self.brain_seed, 1000))
        var i = around.len()
        while i > 1 {
            let j = usize.wrap(shuffler.next_int_below(i32.wrap(i)))
            around.swap(i - 1, j)
            i -= 1
        }
        self.shuffle_random = some(shuffler)
        var room: bool? = none
        for (x, y, z) in around {
            if blocks.sees_sky(x, y, z) {
                continue
            }
            let state = blocks.collision_state(x, y, z) else continue
            if not self.can_stand_on(f, state, y) {
                continue
            }
            if room == none {
                room = some(self.has_room(f, m, blocks))
            }
            if room == some(false) {
                continue
            }
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: speed, close_enough: 0 }))
            break
        }
        return true
    }

    // `entityCanStandOn` of the state at a block at `y`: the top of its collision shape for it
    // full, `isFaceFull`, as the block's facts say for no entity; but scaffolding's full only where
    // it's above it, `isAbove`, as a mob never descends.
    fn can_stand_on(self, f: Facts, state: u32, y: i32) -> bool {
        if f.block_named(String("minecraft:scaffolding")) == some(f.block(state)) {
            return self.living.body.y > f64(y) + 1.0 - f64(1.0e-5f32)
        }
        return f.flags(state) & COLLISION_TOP_FULL != 0
    }

    // `noCollision(entity)`: whether no block's collision shape for it meets its box, as no entity
    // a mob collides with is made yet.
    fn has_room<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B) -> bool {
        let b = self.living.body.bounding_box()
        let near = m.colliders(f, blocks, b, self.living.body.mover())
        for c in near.boxes {
            if b.intersects(c.min_x, c.min_y, c.min_z, c.max_x, c.max_y, c.max_z) {
                return false
            }
        }
        return true
    }

    // `GoToClosestVillage` (CAL-160): where it isn't in a village, its section within 1 of a
    // center, `isVillage`: of 5 places on land up to 15 across and 7 up or down, each the one of
    // its 10 tries nearest a village by sections, the first of those as near,
    // `LandRandomPos.getPos` weighted by `-sectionsToVillage`, the first nearer a village than its
    // own section, else the last as near, walked to, near enough within `close`.
    fn to_village<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, speed: f32, close: i32, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let (bx, by, bz) = self.block_position()
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let here = pois.sections_to_village(bx >> 4, by >> 4, bz >> 4)
        if here <= 1 {
            self.pois = some(pois)
            return false
        }
        var target: (i32, i32, i32)? = none
        for _ in 0..5 {
            let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y() }
            let tries = land_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, w, 15, 7)
            var best = f64.NEG_INFINITY
            var found: (i32, i32, i32)? = none
            for t in tries {
                if let p = t {
                    let (x, y, z) = p
                    let value = -f64(pois.sections_to_village(x >> 4, y >> 4, z >> 4))
                    if value > best {
                        best = value
                        found = some(p)
                    }
                }
            }
            if let p = found {
                let (x, y, z) = p
                let there = pois.sections_to_village(x >> 4, y >> 4, z >> 4)
                if there < here {
                    target = some(p)
                    break
                }
                if there == here {
                    target = some(p)
                }
            }
        }
        self.pois = some(pois)
        if let t = target {
            let (x, y, z) = t
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(f64(x) + 0.5, f64(y), f64(z) + 0.5, speed, close)))
        }
        return true
    }

    // `VillageBoundRandomStroll`'s place (CAL-160), up to `h` across and `v` up or down: in a
    // village, its section within 1 of a center, anywhere on land, `LandRandomPos.getPos`; else,
    // toward the middle of the section nearest a village within 2 of its own, the first of the
    // nearest, x, then y, then z, `DefaultRandomPos.getPosTowards`, where there's one nearer than
    // its own; else anywhere on land.
    fn village_stroll_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, h: i32, v: i32, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let (bx, by, bz) = self.block_position()
        let (sx, sy, sz) = (bx >> 4, by >> 4, bz >> 4)
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let here = pois.sections_to_village(sx, sy, sz)
        var toward: (i32, i32, i32)? = none
        if here > 1 {
            var best = here
            for z in (sz - 2)..(sz + 3) {
                for y in (sy - 2)..(sy + 3) {
                    for x in (sx - 2)..(sx + 3) {
                        let d = pois.sections_to_village(x, y, z)
                        if d < best {
                            best = d
                            toward = some((x, y, z))
                        }
                    }
                }
            }
        }
        self.pois = some(pois)
        let at = toward else return self.random_place(true, h, v, lf, f, blocks, mut cache, min_y)
        let (cx, _, cz) = at
        let dir = (f64(cx * 16 + 8) + 0.5 - self.living.body.x, f64(cz * 16 + 8) + 0.5 - self.living.body.z)
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y() }
        let tries = towards_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, w, h, v, dir)
        return self.best_place(lf, f, blocks, tries)
    }

    // `Villager.canBreed`: its food and its inventory's food points, 12 at least, awake and grown,
    // its age 0.
    fn villager_can_breed(self) -> bool {
        if self.age != 0 or self.living.sleeping != none {
            return false
        }
        return self.food_level + self.food_points() >= 12
    }

    /// A villager's inventory's food points, `countFoodPointsInInventory` (CAL-160): each stack of
    /// a villager food so many times its `villager_food` component's `nutrition`, bread's 4 and a
    /// carrot's, potato's or beetroot's 1.
    pub fn food_points(self) -> i32 {
        var points = 0
        for t in self.stacks() {
            let Tag.Compound(c) = t else continue
            if not c.contains("id") {
                continue
            }
            let Tag.Str(id) = c["id"] else continue
            points += villager_food(id.copy()) * int_or(c, "count", 1)
        }
        return points
    }

    // A villager's inventory's stacks in their order: what it saved, where that's still to read,
    // else those of its slots that aren't empty, as `storeAsItemList` writes them.
    fn stacks(self) -> List<Tag> {
        var out = List<Tag>()
        if not self.inventory_read {
            if self.kept.contains("Inventory") {
                if let Tag.List(items) = self.kept["Inventory"] {
                    for t in items {
                        out.push(t.copy())
                    }
                }
            }
            return out
        }
        for s in self.inventory {
            if let t = s {
                out.push(t.copy())
            }
        }
        return out
    }

    // A villager's inventory's 8 slots: as read, or, where what it saved is still to read, as
    // `fromItemList` reads it, each stack added in turn, `addItem`, to 8 empty slots.
    fn inventory_slots(self, f: Facts) -> List<Tag?> {
        if self.inventory_read {
            return self.inventory.copy()
        }
        var slots = List<Tag?>()
        for _ in 0..8 {
            slots.push(none)
        }
        for t in self.stacks() {
            _ = add_to(mut slots, t, f)
        }
        return slots
    }

    // A villager's inventory read from what it saved, where it's still to read, as `fromItemList`
    // reads it.
    fn ready_inventory(mut self, f: Facts) {
        if self.inventory_read {
            return
        }
        self.inventory = self.inventory_slots(f)
        _ = self.kept.remove("Inventory")
        self.inventory_read = true
    }

    /// Whether a villager wants `stack`, `Villager.wantsToPickUp` (CAL-160): an item in
    /// `#villager_picks_up`, one a villager eats, `villager_food`, or one its profession asks for,
    /// a farmer's wheat, seeds and bone meal, `requestedItems`, that its inventory has room for,
    /// `canAddItem`: an empty slot, or one of the same item and components short of its most.
    pub fn villager_wants<W: Wearing>(self, lf: LivingFacts, f: Facts, items: W, stack: Tag) -> bool {
        let item = held_name(some(stack.copy()))
        var wanted = lf.villager_picks_up.contains(item) or items.worn_component(stack.copy(), String("minecraft:villager_food")) != none
        if not wanted {
            let (_, profession, _) = self.living.data.villager(OWN + 1)
            wanted = profession == FARMER and farmer_requests().contains(item)
        }
        if not wanted {
            return false
        }
        for s in self.inventory_slots(f) {
            let t = s else return true
            if same_components(some(t.copy()), some(stack.copy())) and count_of(some(t.copy())) < stack_limit(f, t) {
                return true
            }
        }
        return false
    }

    /// `InventoryCarrier.pickUpItem` of `stack` into a villager's inventory (CAL-160), where it has
    /// room, `addItem`: how many of it went in.
    pub fn pick_up_into(mut self, stack: Tag, f: Facts) -> i32 {
        self.ready_inventory(f)
        let count = count_of(some(stack.copy()))
        var slots = self.inventory.copy()
        let left = add_to(mut slots, stack, f)
        self.inventory = slots
        return count - count_of(left)
    }

    /// Whether its item sensor scans as its brain next ticks, so what it wants of the items near it
    /// is asked (CAL-160).
    pub fn item_sensor_due(self) -> bool {
        let b = self.brain else return false
        return b.sensor_soon(SENSOR_NEAREST_ITEMS)
    }

    /// Whether it keeps an inventory, `InventoryCarrier`, as a villager does (CAL-160).
    pub fn carries_inventory(self) -> bool {
        return self.species == VILLAGER
    }

    // `Animal`'s: its love gone where its age is anything but 0.
    fn animal_step(mut self) {
        if self.animal and self.age != 0 {
            self.in_love = 0
        }
    }

    // `serverAiStep` up to and through its goals, where it may attack a player, which its level
    // deals before `think_after` goes on with the rest of it (CAL-159): what it's seen forgotten,
    // `Sensing.tick`, then its target goals and its goals.
    fn think<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        self.sensing.clear()
        // Its target goals, then its goals (CAL-159), in full where its tick count and ID together
        // are even, or in its first two ticks; else only those that tick every tick,
        // `tickRunningGoals(false)`.
        let ticks = self.living.body.tick_count
        let full = not ((ticks + self.living.body.id) % 2 != 0 and ticks > 1)
        self.run_goals(true, full, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        self.run_goals(false, full, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        self.thought = true
    }

    // The rest of `serverAiStep`, after its goals and the hit its level dealt there, as vanilla's
    // `doHurtTarget` comes in its goals (CAL-159): its navigation's tick, which sets its move
    // control toward its path's next node; its own step, `customServerAiStep`, an enderman's
    // daylight teleport and an armadillo's brain among it (CAL-160); then its controls, moving, a
    // cube mob's its own way, looking, its head kept within its reach, `getMaxHeadYRot`, and
    // jumping, `JumpControl.tick`. Whether a villager's brain's tick stopped for its level to swing
    // a door, to go on from there, past its navigation's tick, which it's had (CAL-160).
    fn think_after<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        let resuming = match self.held_brain {
            some(_) => true,
            none => false,
        }
        if not resuming {
            let wanted = self.navigation.tick(lf, f, nf, m, blocks, mut cache, w)
            if let q = wanted {
                let (x, y, z, speed) = q
                self.moves.set_wanted(x, y, z, speed)
            }
        }
        if self.species == ENDERMAN {
            self.daylight_step(lf, f, m, blocks, min_y, mut sounds)
        } else if self.species == ARMADILLO {
            self.armadillo_step(lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        } else if self.species == VILLAGER {
            if self.villager_step(lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                return true
            }
        }
        self.animal_step()
        // Its controls read it as it is now, after its own step, which may have moved it, an
        // enderman's teleport or a villager lying down in its bed (CAL-160).
        let moving = self.walker(lf)
        if self.species == SLIME {
            let size = self.slime_size()
            let (jumps, heard) = self.moves.cube_tick(mut self.living, moving, size)
            if jumps {
                self.jump = true
            }
            if heard {
                let sound = if size <= 1 { "entity.slime.jump_small" } else { "entity.slime.jump" }
                let pitch = self.cube_pitch()
                self.living.play(mut sounds, String(sound), self.sound_volume, pitch)
            }
        } else if self.moves.tick(lf, f, nf, m, blocks, mut cache, mut self.living, moving) {
            self.jump = true
        }
        let going = not self.navigation.is_done()
        let reach = self.max_head_y_rot()
        self.look.tick(mut self.living, going, reach)
        self.living.jumping = self.jump
        self.jump = false
        return false
    }

    /// `getNavigation().moveTo(x, y, z, speedModifier)`, as its goals ask: a path to the block at
    /// `x`, `y`, `z`, reached within 1, followed at `speed`; whether it has one to follow
    /// (CAL-157).
    pub fn move_to<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, x: f64, y: f64, z: f64, speed: f64) -> bool {
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        return self.navigation.move_to(lf, f, nf, m, blocks, mut cache, w, x, y, z, speed)
    }

    // `GoalSelector.tick` of its target goals where `t`, else its goals, where `full`, else
    // `tickRunningGoals(false)`: the goals running that can't go on, or whose controls are off,
    // stopped; the holds of those not running let go; each goal not running whose controls are on
    // and held by none or by one of a greater priority number started where it can be used, those
    // that held its controls stopped and the controls its; then those running ticked, or only
    // those that tick every tick where not `full`.
    fn run_goals<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, full: bool, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        let n = if t { self.targets.len() } else { self.goals.len() }
        if full {
            for i in 0..n {
                if self.goal_running(t, i) and (self.goal_disabled(t, i) or not self.goal(t, i, GOAL_CONTINUE, lf, f, m, blocks, mut cache, players, min_y, mut sounds)) {
                    self.stop_goal(t, i, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                }
            }
            if t {
                self.targets.unlock_stopped()
            } else {
                self.goals.unlock_stopped()
            }
            for i in 0..n {
                let free = if t { self.targets.replaceable(i) } else { self.goals.replaceable(i) }
                if not self.goal_running(t, i) and not self.goal_disabled(t, i) and free and self.goal(t, i, GOAL_CAN_USE, lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                    let flags = if t { self.targets.flags(i) } else { self.goals.flags(i) }
                    for k in 0..4 {
                        if flags & (1u32 << u32.wrap(k)) != 0 {
                            let h = if t { self.targets.holder(k) } else { self.goals.holder(k) }
                            if h >= 0 {
                                self.stop_goal(t, usize.wrap(h), lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                            }
                            if t {
                                self.targets.lock(k, i)
                            } else {
                                self.goals.lock(k, i)
                            }
                        }
                    }
                    if not self.goal_running(t, i) {
                        self.set_goal_running(t, i, true)
                        _ = self.goal(t, i, GOAL_START, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                    }
                }
            }
        }
        for i in 0..n {
            let every = if t { self.targets.every_tick(i) } else { self.goals.every_tick(i) }
            if self.goal_running(t, i) and (full or every) {
                _ = self.goal(t, i, GOAL_TICK, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
            }
        }
    }

    // Whether the goal at `i` of its target goals where `t`, else its goals, runs, and whose
    // controls are off; and it set running or not.
    fn goal_running(self, t: bool, i: usize) -> bool {
        return if t { self.targets.running(i) } else { self.goals.running(i) }
    }

    fn goal_disabled(self, t: bool, i: usize) -> bool {
        return if t { self.targets.disabled_for(i) } else { self.goals.disabled_for(i) }
    }

    fn set_goal_running(mut self, t: bool, i: usize, on: bool) {
        if t {
            self.targets.set_running(i, on)
        } else {
            self.goals.set_running(i, on)
        }
    }

    // `WrappedGoal.stop`: the goal at `i`, of its target goals where `t`, stopped where it's
    // running.
    fn stop_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, i: usize, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        if self.goal_running(t, i) {
            self.set_goal_running(t, i, false)
            _ = self.goal(t, i, GOAL_STOP, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        }
    }

    // The goal at `i` given back, of its target goals where `t`.
    fn put_goal(mut self, t: bool, i: usize, g: own Goal) {
        if t {
            self.targets.put(i, g)
        } else {
            self.goals.put(i, g)
        }
    }

    // The goal at `i`, of its target goals where `t`, asked `call`, its state lent out to its
    // kind's workings and given back: whether it can be used or go on, for those.
    fn goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, i: usize, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let taken = if t { self.targets.take(i) } else { self.goals.take(i) }
        let held = taken else return false
        var answer = false
        match held {
            Goal.Float(n) => {
                answer = self.float_goal(call)
                self.put_goal(t, i, Goal.Float(n))
            },
            Goal.LookAround(g) => {
                var s = g
                answer = self.look_around_goal(mut s, call)
                self.put_goal(t, i, Goal.LookAround(s))
            },
            Goal.LookAtPlayer(g) => {
                var s = g
                answer = self.look_at_goal(mut s, call, f, m, blocks, players)
                self.put_goal(t, i, Goal.LookAtPlayer(s))
            },
            Goal.Stroll(g) => {
                var s = g
                answer = self.stroll_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Stroll(s))
            },
            Goal.EatBlock(g) => {
                var s = g
                answer = self.eat_goal(mut s, call, lf, f, blocks, sounds.len())
                self.put_goal(t, i, Goal.EatBlock(s))
            },
            Goal.Stand(g) => {
                var s = g
                answer = self.stand_goal(mut s, call, mut sounds)
                self.put_goal(t, i, Goal.Stand(s))
            },
            Goal.Tempt(g) => {
                var s = g
                answer = self.tempt_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.Tempt(s))
            },
            Goal.FollowParent(g) => {
                var s = g
                answer = self.follow_parent_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.FollowParent(s))
            },
            Goal.Breed(g) => {
                var s = g
                answer = self.breed_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, sounds.len())
                self.put_goal(t, i, Goal.Breed(s))
            },
            Goal.Panic(g) => {
                var s = g
                answer = self.panic_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Panic(s))
            },
            Goal.Nearest(g) => {
                var s = g
                answer = self.nearest_goal(mut s, call, lf, f, m, blocks, players)
                self.put_goal(t, i, Goal.Nearest(s))
            },
            Goal.HurtBy(g) => {
                var s = g
                answer = self.hurt_by_goal(mut s, call, lf, f, m, blocks, players)
                self.put_goal(t, i, Goal.HurtBy(s))
            },
            Goal.Melee(g) => {
                var s = g
                answer = self.melee_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, sounds.len())
                self.put_goal(t, i, Goal.Melee(s))
            },
            Goal.RemoveBlock(g) => {
                var s = g
                answer = self.remove_block_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, sounds.len())
                self.put_goal(t, i, Goal.RemoveBlock(s))
            },
            Goal.SpearUse(g) => {
                var s = g
                answer = self.spear_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, sounds.len())
                self.put_goal(t, i, Goal.SpearUse(s))
            },
            Goal.Leap(up) => {
                answer = self.leap_goal(call, up, players)
                self.put_goal(t, i, Goal.Leap(up))
            },
            Goal.Freeze(kept) => {
                var froze = kept
                answer = self.freeze_goal(mut froze, call, f, m, blocks, players)
                self.put_goal(t, i, Goal.Freeze(froze))
            },
            Goal.EnderLook(g) => {
                var s = g
                answer = self.ender_look_goal(mut s, call, lf, f, m, blocks, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.EnderLook(s))
            },
            Goal.TakeBlock(n) => {
                answer = self.block_goal(call, true, lf, f, m, blocks, sounds.len())
                self.put_goal(t, i, Goal.TakeBlock(n))
            },
            Goal.LeaveBlock(n) => {
                answer = self.block_goal(call, false, lf, f, m, blocks, sounds.len())
                self.put_goal(t, i, Goal.LeaveBlock(n))
            },
            Goal.CubeFloat(n) => {
                if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                    // `CubeMobFloatGoal`: in water or lava, `isInLiquid`.
                    answer = self.living.body.in_water or self.living.body.in_lava()
                } else if call == GOAL_TICK {
                    if self.living.body.random.next_float() < 0.8f32 {
                        self.jump = true
                    }
                    self.moves.set_wanted_movement(1.2)
                }
                self.put_goal(t, i, Goal.CubeFloat(n))
            },
            Goal.CubeDirection((chosen, next)) => {
                var way = chosen
                var due = next
                if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                    // `CubeMobRandomDirectionGoal`: with no target, on the ground, in a liquid
                    // or levitating.
                    let up = self.living.body.on_ground or self.living.body.in_water or self.living.body.in_lava() or self.living.has_effect(LEVITATION)
                    answer = self.target == none and up
                } else if call == GOAL_TICK {
                    due -= 1
                    if due <= 0 {
                        due = reduced_tick_delay(40 + self.living.body.random.next_int_below(60))
                        way = f32.nearest(f64(self.living.body.random.next_int_below(360)))
                    }
                    self.moves.set_direction(way, false)
                }
                self.put_goal(t, i, Goal.CubeDirection((way, due)))
            },
            Goal.CubeJumping(n) => {
                if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                    // `CubeMobKeepOnJumpingGoal`: unless it's riding, which Calcite's mobs don't.
                    answer = true
                } else if call == GOAL_TICK {
                    self.moves.set_wanted_movement(1.0)
                }
                self.put_goal(t, i, Goal.CubeJumping(n))
            },
            Goal.CubeAttack(tired) => {
                var left = tired
                answer = self.cube_attack_goal(mut left, call, players)
                self.put_goal(t, i, Goal.CubeAttack(left))
            },
            Goal.Ranged(g) => {
                var r = g
                answer = self.ranged_goal(mut r, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Ranged(r))
            },
            Goal.HealRaider(cooldown) => {
                if call == GOAL_CAN_USE and cooldown <= 0 {
                    // `NearestHealableRaiderTargetGoal.canUse`: its cooldown out, a coin's toss,
                    // then a raid, which it hasn't.
                    _ = self.living.body.random.next_boolean()
                }
                self.put_goal(t, i, Goal.HealRaider(cooldown))
            },
            Goal.Swell(kept) => {
                var swelling = kept
                answer = self.swell_goal(mut swelling, call, f, m, blocks, players)
                self.put_goal(t, i, Goal.Swell(swelling))
            },
            Goal.Bow(g) => {
                var s = g
                answer = self.bow_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Bow(s))
            },
            Goal.RestrictSun(n) => {
                answer = self.restrict_sun_goal(call, blocks)
                self.put_goal(t, i, Goal.RestrictSun(n))
            },
            Goal.FleeSun(g) => {
                var s = g
                answer = self.flee_sun_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.FleeSun(s))
            },
            Goal.ResetAnger(stamp) => {
                var last = stamp
                answer = self.reset_anger_goal(mut last, call, players)
                self.put_goal(t, i, Goal.ResetAnger(last))
            },
            Goal.ThroughVillage(g) => {
                var s = g
                answer = self.through_village_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.ThroughVillage(s))
            },
            Goal.Later(k) => {
                if k == LATER_PATROL and call == GOAL_CAN_USE and self.patrolling and self.target == none and self.kept.contains("patrol_target") {
                    self.living.show(Shown.Missing(String("A patrol's walk, LongDistancePatrolGoal")), sounds.len())
                }
                self.put_goal(t, i, Goal.Later(k))
            },
        }
        return answer
    }

    // `getTarget` (CAL-159): its target where it's among `players` and still one, `asValidTarget`,
    // as `valid_target` has it. The mobs it may target come with them.
    fn target_in(self, players: List<Follower>) -> Follower? {
        let id = self.target else return none
        return valid_target(players, id)
    }

    // `setTarget` of `id` (CAL-159): it, where it's a valid target among `players`, else none.
    fn set_target(mut self, id: i32?, players: List<Follower>) {
        var next: i32? = none
        if let who = id {
            if valid_target(players, who) != none {
                next = some(who)
            }
        }
        self.target_to(next)
    }

    // `setTarget` of `id`, as it is (CAL-159): an enderman's own, `Enderman.setTarget`, its tick
    // count then kept, creepy, its attacking speed on, where it has a target; else none of it.
    fn target_to(mut self, id: i32?) {
        self.target = id
        if self.species != ENDERMAN {
            return
        }
        let speed = self.speed_attribute
        let attacking = Identifier { namespace: "minecraft", path: String("attacking") }
        if id == none {
            self.target_change_time = 0
            self.living.data.set(MONSTER_OWN + 1, Value.Bool(false))
            self.living.data.set(MONSTER_OWN + 2, Value.Bool(false))
            self.living.attributes.take_off(speed, attacking)
        } else {
            self.target_change_time = self.living.body.tick_count
            self.living.data.set(MONSTER_OWN + 1, Value.Bool(true))
            if not self.living.attributes.has_modifier(speed, attacking) {
                self.living.attributes.replace(speed, Modifier { id: attacking, amount: f64(0.15f32), operation: ADD_VALUE })
            }
        }
    }

    // `getLastHurtByMob` (CAL-159): who last hurt it, `lastHurtByMob`, where they're among
    // `players`, by their UUID, `EntityReference`. Only players hurt mobs so far.
    fn hurt_by_in(self, players: List<Follower>) -> Follower? {
        let uuid = self.living.hurt_by_mob else return none
        for p in players {
            if p.uuid == some(uuid) {
                return some(p.copy())
            }
        }
        return none
    }

    // `TargetGoal.canContinueToUse` of the target goal `g` (CAL-159): its target, or the one the
    // goal took up where it has none, where it may attack them, `canAttack`, within its follow
    // range, and, where it must see them, seen, or unseen for no more of its ticks than half its
    // memory's, `reducedTickDelay`; then its target again, `setTarget`. No teams, so none are
    // allied.
    fn targeting_continues<B: CollisionBlocks>(mut self, g: mut Targeting, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        var who = self.target_in(players)
        if who == none {
            if let id = g.target_mob {
                if let at = player_at(players, id) {
                    who = some(players[at].copy())
                }
            }
        }
        let p = who else return false
        if p.spectator or p.dead or not p.enemy {
            return false
        }
        let within = self.living.attributes.value(lf.follow_range)
        if self.distance_sqr_to(p.x, p.y, p.z) > within * within {
            return false
        }
        if g.must_see {
            let me = self.looker()
            if sees_player(m, f, blocks, mut self.sensing, me, p) {
                g.unseen_ticks = 0
            } else {
                g.unseen_ticks += 1
                if g.unseen_ticks > reduced_tick_delay(g.unseen_memory) {
                    return false
                }
            }
        }
        self.set_target(some(p.id), players)
        return true
    }

    // `NearestAttackableTargetGoal` (CAL-159): used where a draw of its interval comes to 0 and it
    // finds a target, `findTarget`, for players the nearest it may attack and sees within its
    // follow range, `nearest_enemy`; villagers, iron golems and turtles, which Calcite hasn't yet,
    // it finds none of. Its target set as it starts, `TargetGoal`'s counts reset; then
    // `TargetGoal`'s going on and stop.
    fn nearest_goal<B: CollisionBlocks + MobLight>(mut self, g: mut Nearest, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            if self.species == SPIDER and self.magic_light(blocks) >= 0.5f32 {
                // `SpiderTargetGoal.canUse`: none in the light at its eyes (CAL-159).
                return false
            }
            if g.interval > 0 and self.living.body.random.next_int_below(g.interval) != 0 {
                return false
            }
            g.found = none
            if g.seek == SEEK_PLAYER {
                let me = self.looker()
                let range = self.living.attributes.value(lf.follow_range)
                var near = List<Follower>()
                for p in players {
                    if g.max_dy < 0.0 or (p.y - self.living.body.y).abs() <= g.max_dy {
                        near.push(p.copy())
                    }
                }
                g.found = nearest_enemy(m, f, blocks, mut self.sensing, me, near, range)
            }
            return g.found != none
        }
        if call == GOAL_CONTINUE {
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            self.set_target(g.found, players)
            g.targeting.unseen_ticks = 0
        } else if call == GOAL_STOP {
            self.target_to(none)
            g.targeting.target_mob = none
        }
        return false
    }

    // A zombie's `MoveThroughVillageGoal` (D605), with its level's points of interest lent to it:
    // used, the oldest of those it's been to let go where it remembers more than 15, only at night
    // where it's to be, `isBrightOutside` not, and within 6 sections of a village,
    // `isCloseToVillage`. Its target's `village_poi`'s; a path there's found with doors as it may
    // break them, `canBreakDoors`, else to a place on the way, `DefaultRandomPos.getPosTowards`
    // up to 10 across and 7 up or down within a right angle of it, and either way its navigation
    // may open doors after, as vanilla's is left, `setCanOpenDoors(true)`. Where a node of that
    // path has a door a hand opens a block up, `isWoodenDoor`, its path's found again to that
    // node, and no further. It goes on while its navigation isn't done and it's farther from the
    // middle of the point than its width and 4; as it stops, done or within 4, the point's been
    // to. Its stop leaves its navigation going, as vanilla's does.
    fn through_village_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut ThroughVillage, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if g.visited.len() > 15 {
                _ = g.visited.remove(0)
            }
            if g.only_at_night and blocks.bright_outside() {
                return false
            }
            let target = self.village_poi(g.visited, lf, f, blocks, mut cache, min_y) else return false
            let (tx, ty, tz) = (target.x, target.y, target.z)
            g.poi = target
            let nf = nav_facts(lf, blocks, min_y)
            self.navigation.can_open_doors = self.can_break_doors
            g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, self.walker(lf), tx, ty, tz, 0)
            self.navigation.can_open_doors = true
            if g.path == none {
                let dir = (f64(tx) + 0.5 - self.living.body.x, f64(tz) + 0.5 - self.living.body.z)
                let step = self.place_towards(10, 7, dir, lf, f, blocks, mut cache, min_y) else return false
                let (px, py, pz) = step
                self.navigation.can_open_doors = self.can_break_doors
                g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, self.walker(lf), floor_of(px), floor_of(py), floor_of(pz), 0)
                self.navigation.can_open_doors = true
                if g.path == none {
                    return false
                }
            }
            if let path = g.path.copy() {
                let iron = f.block_named(String("minecraft:iron_door"))
                for node in path.nodes {
                    let block = f.block(state_at(blocks, node.x, node.y + 1, node.z))
                    if f.is_a(block, "DoorBlock") and some(block) != iron {
                        g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, self.walker(lf), node.x, node.y, node.z, 0)
                        break
                    }
                }
            }
            return g.path != none
        }
        if call == GOAL_CONTINUE {
            if self.navigation.is_done() {
                return false
            }
            // `getBbWidth() + distanceToPoi`, a float.
            let reach = f64(self.living.body.width + f32.nearest(g.distance_to_poi))
            return not self.near_middle(g.poi, reach)
        }
        if call == GOAL_START {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            _ = self.navigation.move_along(lf, f, nf, blocks, w, g.path.take(), g.speed)
        } else if call == GOAL_STOP {
            if self.navigation.is_done() or self.near_middle(g.poi, f64(g.distance_to_poi)) {
                g.visited.push(g.poi)
            }
        }
        return false
    }

    // `MoveThroughVillageGoal.canUse`'s point of interest (D605), where it's within 6 sections of a
    // village, `isCloseToVillage`: of 10 places on land up to 15 across and 7 up or down,
    // `LandRandomPos.getPos`, the one whose `unvisited_poi` is nearest its own block, `distSqr`,
    // the first of those as near, only those in a village, their section within 1 of a center,
    // `isVillage`; then that place's `unvisited_poi`.
    fn village_poi<B: CollisionBlocks + MobLight + NavLevel>(mut self, visited: List<BlockPos>, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> BlockPos? {
        var pois = self.pois.take() else return none
        let (bx, by, bz) = self.block_position()
        let here = BlockPos { x: bx, y: by, z: bz }
        var target: BlockPos? = none
        if pois.close_to_village(here, 6) {
            let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y() }
            let tries = land_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, w, 15, 7)
            var best = f64.NEG_INFINITY
            var found: BlockPos? = none
            for t in tries {
                let p = t else continue
                let (x, y, z) = p
                let at = BlockPos { x: x, y: y, z: z }
                // `Double.NEGATIVE_INFINITY` for a place not in a village or with none, which is
                // never taken.
                if not pois.close_to_village(at, 1) {
                    continue
                }
                let poi = unvisited_poi(pois, at, visited) else continue
                let dx = f64(poi.x - here.x)
                let dy = f64(poi.y - here.y)
                let dz = f64(poi.z - here.z)
                let value = -(dx * dx + dy * dy + dz * dz)
                if value > best {
                    best = value
                    found = some(at)
                }
            }
            if let at = found {
                target = unvisited_poi(pois, at, visited)
            }
        }
        self.pois = some(pois)
        return target
    }

    // Whether its goals look for villages' points of interest, which its level lends it for them,
    // a zombie's `MoveThroughVillageGoal` (D605).
    pub fn goes_through_villages(self) -> bool {
        return self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER
    }

    // `HurtByTargetGoal` (CAL-159): used where who last hurt it is new since it last took one up,
    // by their tick count then, and is one it may attack, seen or not, `HURT_BY_TARGETING`, but not
    // where they're a player and the game rule `universal_anger`'s on. As it starts, its target,
    // kept in the goal, who it remembers unseen for 300 ticks, and the mobs of its class near it
    // alerted, `alertOthers`, which its level does as its tick's done; then `TargetGoal`'s going on
    // and stop.
    fn hurt_by_goal<B: CollisionBlocks>(mut self, g: mut HurtBy, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            let who = self.hurt_by_in(players) else return false
            if self.living.hurt_by_mob_stamp == g.timestamp or self.universal_anger {
                return false
            }
            return who.id != self.living.body.id and not who.spectator and not who.dead and who.enemy
        }
        if call == GOAL_CONTINUE {
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            let who = self.hurt_by_in(players)
            let id = match who {
                some(p) => some(p.id),
                none => none,
            }
            self.set_target(id, players)
            g.targeting.target_mob = self.target
            g.timestamp = self.living.hurt_by_mob_stamp
            g.targeting.unseen_memory = 300
            if g.alert {
                self.alerted = id
            }
            g.targeting.unseen_ticks = 0
        } else if call == GOAL_STOP {
            self.target_to(none)
            g.targeting.target_mob = none
        }
        return false
    }

    // `MeleeAttackGoal`, a zombie's `ZombieAttackGoal` where `zombie` (CAL-159): asked whether it
    // can be used once in 20 ticks of game time at most, with a target that's alive, and a path to
    // their block, reached within 0, or within its reach without one. As it starts, along that path
    // at its speed, aggressive, its counts reset; going on with its target alive while its
    // navigation isn't done, or for one that follows a target unseen, while they aren't in creative
    // or spectating; as it stops, no more aggressive and its navigation stopped. Each tick, looking
    // at its target's eyes, 30 degrees a tick; where it sees them, or follows them unseen, and its
    // count's done, a path found again where they've gone a block from where it last found one, or
    // 1 in 20, drawn, its count 4 to 10, drawn, 5 more past 16 blocks and 10 past 32, and 15 more
    // without a path; then where it may attack, its cooldown done, within its reach and seen, its
    // cooldown 20 again, its main hand swung, `swingForAttack`, and the target hurt by it,
    // `doHurtTarget`, which its level does. A zombie's arms up from its fifth tick while its
    // cooldown's below half.
    fn melee_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Melee, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            if self.game_time - g.last_check < 20 {
                return false
            }
            g.last_check = self.game_time
            let p = self.target_in(players) else return false
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, w, floor_of(p.x), floor_of(p.y), floor_of(p.z), 0)
            if g.path != none {
                return true
            }
            return self.within_melee(p, heard)
        }
        if call == GOAL_CONTINUE {
            if self.species == SPIDER and self.magic_light(blocks) >= 0.5f32 and self.living.body.random.next_int_below(100) == 0 {
                // `SpiderAttackGoal.canContinueToUse`: in the light, its target let go 1 in 100.
                self.target_to(none)
                return false
            }
            let p = self.target_in(players) else return false
            if not g.follow_unseen {
                return not self.navigation.is_done()
            }
            return not (p.spectator or p.creative)
        }
        if call == GOAL_START {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            _ = self.navigation.move_along(lf, f, nf, blocks, w, g.path.take(), g.speed)
            self.set_flag(AGGRESSIVE_FLAG, true)
            g.recalc = 0
            g.until_attack = 0
            g.raise_arm = 0
        } else if call == GOAL_STOP {
            self.set_flag(AGGRESSIVE_FLAG, false)
            self.navigation.stop()
        } else if call == GOAL_TICK {
            if let p = self.target_in(players) {
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
                g.recalc = if g.recalc - 1 > 0 { g.recalc - 1 } else { 0 }
                let me = self.looker()
                let seen = g.follow_unseen or sees_player(m, f, blocks, mut self.sensing, me, p)
                if seen and g.recalc <= 0 {
                    let dx = p.x - g.pathed_x
                    let dy = p.y - g.pathed_y
                    let dz = p.z - g.pathed_z
                    let unpathed = g.pathed_x == 0.0 and g.pathed_y == 0.0 and g.pathed_z == 0.0
                    if unpathed or dx * dx + dy * dy + dz * dz >= 1.0 or self.living.body.random.next_float() < 0.05f32 {
                        g.pathed_x = p.x
                        g.pathed_y = p.y
                        g.pathed_z = p.z
                        g.recalc = 4 + self.living.body.random.next_int_below(7)
                        let d = self.distance_sqr_to(p.x, p.y, p.z)
                        if d > 1024.0 {
                            g.recalc += 10
                        } else if d > 256.0 {
                            g.recalc += 5
                        }
                        let nf = nav_facts(lf, blocks, min_y)
                        let w = self.walker(lf)
                        let found = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, w, floor_of(p.x), floor_of(p.y), floor_of(p.z), 0)
                        let moving = if found == none { false } else { self.navigation.move_along(lf, f, nf, blocks, w, found, g.speed) }
                        if not moving {
                            g.recalc += 15
                        }
                    }
                }
                g.until_attack = if g.until_attack - 1 > 0 { g.until_attack - 1 } else { 0 }
                if g.until_attack <= 0 and self.within_melee(p, heard) and sees_player(m, f, blocks, mut self.sensing, me, p) {
                    g.until_attack = 20
                    self.swing_for_attack(heard)
                    if self.species != CREEPER {
                        // A creeper's `doHurtTarget` does nothing.
                        let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                        self.living.show(Shown.Attack((p.id, ax, ay, az)), heard)
                    }
                }
            }
            if g.zombie {
                g.raise_arm += 1
                self.set_flag(AGGRESSIVE_FLAG, g.raise_arm >= 5 and g.until_attack < 10)
            }
        }
        return false
    }

    // `NeutralMob.updatePersistentAnger`, staying angry while it has a target (CAL-159): with one,
    // angry at them, by UUID, and for 20 to 39 seconds more from now, drawn; and where it was angry
    // at someone, that let go where its anger's run out and it has no player it may attack as its
    // target, or where they're a player in creative or spectating. A target that's a mob, which
    // only an endermite would be, comes with them.
    fn update_anger(mut self, players: List<Follower>) {
        let was = self.anger_target
        if let p = self.target_in(players) {
            if was == none or was != p.uuid {
                self.anger_target = p.uuid
            }
            self.start_anger_timer()
        }
        if was != none and not self.angry() {
            var valid = false
            if let p = self.target_in(players) {
                valid = not p.creative and not p.spectator and self.difficulty != 0
            }
            if not valid {
                self.stop_being_angry()
            }
        }
        for p in players {
            if was != none and p.uuid == was and (p.creative or p.spectator or self.difficulty == 0) {
                self.stop_being_angry()
            }
        }
    }

    // `startPersistentAngerTimer`, an enderman's (CAL-159): angry for 20 to 39 seconds more from
    // now, drawn, `setTimeToRemainAngry`.
    fn start_anger_timer(mut self) {
        self.anger_end_time = self.game_time + i64(400 + self.living.body.random.next_int_below(381))
    }

    // `ResetUniversalAngerTargetGoal` (CAL-159), an enderman's, which alerts no others: used, and
    // kept on, while the game rule `universal_anger`'s on and who last hurt it is a player, since
    // it last started, by its tick count then, `wasHurtByPlayer`; as it starts, that kept, and
    // its anger at anyone in particular forgotten for anger at all, then, players,
    // `forgetCurrentTargetAndRefreshUniversalAnger`. Only players hurt mobs so far.
    fn reset_anger_goal(mut self, last: mut i32, call: i32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            return self.universal_anger and self.hurt_by_in(players) != none and self.living.hurt_by_mob_stamp > last
        }
        if call == GOAL_START {
            last = self.living.hurt_by_mob_stamp
            self.stop_being_angry()
            self.start_anger_timer()
        }
        return false
    }

    /// `NeutralMob.playerDied` of the player of the UUID `uuid`, their death told it where the
    /// game rule `forgive_dead_players` says so (CAL-159): where it's angry at them, it stops being
    /// angry. Only neutral mobs are ever angry at anyone.
    pub fn player_died(mut self, uuid: (i64, i64)) {
        if self.anger_target == some(uuid) {
            self.stop_being_angry()
        }
    }

    // `isAngry`: its anger's end still to come.
    fn angry(self) -> bool {
        return self.anger_end_time > 0 and self.anger_end_time - self.game_time > 0
    }

    // `stopBeingAngry`: who last hurt it forgotten, as of its tick count now, no one it's angry at,
    // no target, and no end to its anger.
    fn stop_being_angry(mut self) {
        self.living.hurt_by_mob = none
        self.living.hurt_by_mob_stamp = self.living.body.tick_count
        self.anger_target = none
        self.target_to(none)
        self.anger_end_time = -1
    }

    // `Enderman.isBeingStaredBy` of the player `p` (CAL-159): not disguised, and looking at its
    // eyes, `isLookingAtMe` within 0.025 over the distance of straight at them, the line from
    // their eyes to its clear of colliding blocks.
    fn stared_by<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, p: Follower) -> bool {
        if p.disguised {
            return false
        }
        // `calculateViewVector` of the player's turn, made a unit long.
        let rx = f64(p.x_rot * 0.017453292f32)
        let ry = f64(-p.y_rot * 0.017453292f32)
        let cy = table_cos(ry)
        let sy = table_sin(ry)
        let cx = table_cos(rx)
        let sx = table_sin(rx)
        var lx = f64(sy * cx)
        var ly = f64(-sx)
        var lz = f64(cy * cx)
        let ll = (lx * lx + ly * ly + lz * lz).sqrt()
        if ll < f64(1.0e-5f32) {
            lx = 0.0
            ly = 0.0
            lz = 0.0
        } else {
            lx = lx / ll
            ly = ly / ll
            lz = lz / ll
        }
        let gaze = self.living.body.y + f64(self.living.body.eyes)
        let peyes = p.y + f64(p.eyes)
        var dx = self.living.body.x - p.x
        var dy = gaze - peyes
        var dz = self.living.body.z - p.z
        let dist = (dx * dx + dy * dy + dz * dz).sqrt()
        if dist < f64(1.0e-5f32) {
            dx = 0.0
            dy = 0.0
            dz = 0.0
        } else {
            dx = dx / dist
            dy = dy / dist
            dz = dz / dist
        }
        let dot = lx * dx + ly * dy + lz * dz
        if not (dot > 1.0 - 0.025 / dist) {
            return false
        }
        let mover = Mover { y: p.y, fall: 0.0 }
        return sees(m, f, blocks, mover, p.x, peyes, p.z, self.living.body.x, gaze, self.living.body.z)
    }

    // `NeutralMob.isAngryAt` of the player `p` (CAL-159): one it may attack, and, where the game
    // rule `universal_anger`'s on and it's angry at no one in particular, at all players,
    // `isAngryAtAllPlayers`, unless they're in creative; else the one it's angry at, by UUID.
    fn angry_at(self, p: Follower) -> bool {
        if not p.enemy or self.difficulty == 0 {
            return false
        }
        if not p.creative and self.universal_anger and self.angry() and self.anger_target == none {
            return true
        }
        return self.anger_target != none and self.anger_target == p.uuid
    }

    // `EndermanFreezeWhenLookedAt` (CAL-159), `froze` the player it froze for: used where its
    // target's a player within 16 blocks who stares at it; as it starts, its path stopped; each
    // tick, looking at their eyes.
    fn freeze_goal<B: CollisionBlocks>(mut self, froze: mut i32, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            froze = -1
            let p = self.target_in(players) else return false
            froze = p.id
            if self.distance_sqr_to(p.x, p.y, p.z) > 256.0 {
                return false
            }
            return self.stared_by(f, m, blocks, p)
        }
        if call == GOAL_START {
            self.navigation.stop()
        } else if call == GOAL_TICK {
            for p in players {
                if p.id == froze {
                    self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, HEAD_ROT_SPEED, MAX_HEAD_X_ROT)
                }
            }
        }
        return false
    }

    // `EndermanLookForPlayerGoal` (CAL-159): used where a player it may attack within its follow
    // range stares at it or is one it's angry at, the nearest, `pendingTarget`. As it starts, its
    // aggro count 3 ticks of its target goals, and stared at, `setBeingStaredAt`. Going on with
    // that player while they stare or it's angry at them, turned to them at once, 10 degrees, else
    // with the target it took up while it may attack them, seen or not, else as `TargetGoal` goes
    // on. Each tick, with no target, it lets its go; its count out, it takes the player up,
    // `setTarget`; after that, staring, they make it teleport away within 4 blocks, else past 16
    // it teleports toward them once 15 of these ticks are by. As it stops, no target.
    fn ender_look_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut EnderLook, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            g.pending = -1
            let range = self.living.attributes.value(lf.follow_range)
            var best = -1.0
            for p in players {
                if p.spectator or p.dead or not (self.stared_by(f, m, blocks, p) or self.angry_at(p)) {
                    continue
                }
                if not p.enemy or self.difficulty == 0 {
                    continue
                }
                let visibility = p.visibility(i32.wrap(self.living.kind))
                let within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
                let d = self.distance_sqr_to(p.x, p.y, p.z)
                if d > within * within {
                    continue
                }
                let me = self.looker()
                if not sees_player(m, f, blocks, mut self.sensing, me, p) {
                    continue
                }
                if best < 0.0 or d < best {
                    best = d
                    g.pending = p.id
                }
            }
            return g.pending >= 0
        }
        if call == GOAL_CONTINUE {
            if g.pending >= 0 {
                for p in players {
                    if p.id == g.pending and (self.stared_by(f, m, blocks, p) or self.angry_at(p)) {
                        self.look_at_now(p, 10.0f32, 10.0f32)
                        return true
                    }
                }
                return false
            }
            if g.target >= 0 {
                for p in players {
                    if p.id == g.target and not p.spectator and not p.dead and p.enemy and self.difficulty != 0 {
                        return true
                    }
                }
            }
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            g.aggro_time = reduced_tick_delay(5)
            g.teleport_time = 0
            self.living.data.set(MONSTER_OWN + 2, Value.Bool(true))
        } else if call == GOAL_STOP {
            g.pending = -1
            self.target_to(none)
            g.target = -1
            g.targeting.target_mob = none
        } else if call == GOAL_TICK {
            if self.target_in(players) == none {
                g.target = -1
            }
            if g.pending >= 0 {
                g.aggro_time -= 1
                if g.aggro_time <= 0 {
                    g.target = g.pending
                    g.pending = -1
                    self.set_target(some(g.target), players)
                    g.targeting.unseen_ticks = 0
                }
            } else if g.target >= 0 {
                for p in players {
                    if p.id == g.target {
                        let d = self.distance_sqr_to(p.x, p.y, p.z)
                        if self.stared_by(f, m, blocks, p) {
                            if d < 16.0 {
                                _ = self.teleport(lf, f, m, blocks, min_y, mut sounds)
                            }
                            g.teleport_time = 0
                        } else if d > 256.0 {
                            let due = g.teleport_time >= reduced_tick_delay(30)
                            g.teleport_time += 1
                            if due and self.teleport_towards(lf, f, m, blocks, min_y, p, mut sounds) {
                                g.teleport_time = 0
                            }
                        }
                    }
                }
            }
        }
        return false
    }

    // `EndermanTakeBlockGoal` where `take`, else `EndermanLeaveBlockGoal` (CAL-159): used, with
    // mob griefing on, 1 in 10 ticks of its goals, or 1 in 1000 to leave one, drawn, where it
    // carries nothing to take one and something to leave it, and going on while that holds and
    // the draw does again. Its tick draws a place near it, x, y then z: within 2 blocks across
    // and 3 up to take one, the block there taken where it's one it may hold,
    // `#enderman_holdable`, and the outlines from the middle of its own block at that height to
    // the middle of that one meet nothing before it, `clip_outline`, for its level to take,
    // `Shown.Took`; within 1 across and 2 up to leave it, for its level to place where it may,
    // `Shown.Left`.
    fn block_goal<B: CollisionBlocks>(mut self, call: i32, take: bool, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, heard: usize) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let carrying = self.carried() != none
            if carrying == take or not self.mob_griefing {
                return false
            }
            let chance = if take { reduced_tick_delay(20) } else { reduced_tick_delay(2000) }
            return self.living.body.random.next_int_below(chance) == 0
        }
        if call != GOAL_TICK {
            return false
        }
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        if take {
            let xt = floor_of(x - 2.0 + self.living.body.random.next_double() * 4.0)
            let yt = floor_of(y + self.living.body.random.next_double() * 3.0)
            let zt = floor_of(z - 2.0 + self.living.body.random.next_double() * 4.0)
            let state = state_at(blocks, xt, yt, zt)
            let (bx, _, bz) = self.block_position()
            let hit = clip_outline(f, m, blocks, (f64(bx) + 0.5, f64(yt) + 0.5, f64(bz) + 0.5), (f64(xt) + 0.5, f64(yt) + 0.5, f64(zt) + 0.5))
            if f.in_set(state, lf.enderman_holdable) and hit.bx == xt and hit.by == yt and hit.bz == zt {
                self.living.show(Shown.Took((xt, yt, zt)), heard)
            }
            return false
        }
        let xt = floor_of(x - 1.0 + self.living.body.random.next_double() * 2.0)
        let yt = floor_of(y + self.living.body.random.next_double() * 2.0)
        let zt = floor_of(z - 1.0 + self.living.body.random.next_double() * 2.0)
        self.living.show(Shown.Left((xt, yt, zt)), heard)
        return false
    }

    // `Enderman.customServerAiStep` (CAL-159): bright outside, 600 ticks or more since it took up
    // a target or let one go, in light over half at its eyes where its block sees the sky, a draw
    // under twice what's over 0.4 of thirty, and it lets its target go and teleports.
    fn daylight_step<B: CollisionBlocks + MobLight>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) {
        if not blocks.bright_outside() or self.living.body.tick_count < self.target_change_time + 600 {
            return
        }
        let br = self.magic_light(blocks)
        if br > 0.5f32 and blocks.sees_sky(floor_of(self.living.body.x), floor_of(self.living.body.y), floor_of(self.living.body.z)) and self.living.body.random.next_float() * 30.0f32 < (br - 0.4f32) * 2.0f32 {
            self.target_to(none)
            _ = self.teleport(lf, f, m, blocks, min_y, mut sounds)
        }
    }

    // `Enderman.teleport()` (CAL-159): to a place drawn within 32 across and up or down.
    fn teleport<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if not self.living.alive() {
            return false
        }
        let x = self.living.body.x + (self.living.body.random.next_double() - 0.5) * 64.0
        let y = self.living.body.y + f64(self.living.body.random.next_int_below(64) - 32)
        let z = self.living.body.z + (self.living.body.random.next_double() - 0.5) * 64.0
        return self.teleport_to(lf, f, m, blocks, min_y, x, y, z, mut sounds)
    }

    // `teleportTowards` the player `p` (CAL-159): 16 blocks along the way from it to their eyes,
    // and a place drawn within 4 across and 8 up or down of that.
    fn teleport_towards<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, p: Follower, sounds: mut List<EntitySound>) -> bool {
        var dx = self.living.body.x - p.x
        var dy = self.living.body.y + f64(self.living.body.height) * 0.5 - (p.y + f64(p.eyes))
        var dz = self.living.body.z - p.z
        let d = (dx * dx + dy * dy + dz * dz).sqrt()
        if d < f64(1.0e-5f32) {
            dx = 0.0
            dy = 0.0
            dz = 0.0
        } else {
            dx = dx / d
            dy = dy / d
            dz = dz / d
        }
        let x = self.living.body.x + (self.living.body.random.next_double() - 0.5) * 8.0 - dx * 16.0
        let y = self.living.body.y + f64(self.living.body.random.next_int_below(16) - 8) - dy * 16.0
        let z = self.living.body.z + (self.living.body.random.next_double() - 0.5) * 8.0 - dz * 16.0
        return self.teleport_to(lf, f, m, blocks, min_y, x, y, z, mut sounds)
    }

    // `Enderman.teleport(x, y, z)` (CAL-159): `randomTeleport` there, avoiding what endermen don't
    // teleport to; teleported, unless it's silent, the teleport's level event at its old block
    // with how far it went, 2018, and its teleport sound twice, both where it is now.
    fn teleport_to<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, x: f64, y: f64, z: f64, sounds: mut List<EntitySound>) -> bool {
        let ox = floor_of(self.living.body.x)
        let oy = floor_of(self.living.body.y)
        let oz = floor_of(self.living.body.z)
        if not self.random_teleport(lf, f, m, blocks, min_y, x, y, z, sounds.len()) {
            return false
        }
        if not self.living.data.flag(SILENT) {
            let px = (clamp_i(floor_of(self.living.body.x) - ox) + 127) & 255
            let py = (clamp_i(floor_of(self.living.body.y) - oy) + 127) & 255
            let pz = (clamp_i(floor_of(self.living.body.z) - oz) + 127) & 255
            let packed = (px << 16) | (py << 8) | pz
            self.living.show(Shown.Level((2018, ox, oy, oz, packed)), sounds.len())
            self.living.play(mut sounds, String("entity.enderman.teleport"), 1.0f32, 1.0f32)
            self.living.play(mut sounds, String("entity.enderman.teleport"), 1.0f32, 1.0f32)
        }
        return true
    }

    // `LivingEntity.randomTeleport` to x, y, z, its particles shown (CAL-159): where the chunk's
    // loaded, down from there to the first block it may teleport onto, `ENTITIES_CAN_TELEPORT_TO`,
    // where that's not one an enderman avoids, its box there meets no block, holds no liquid nor a
    // block it avoids, and the block below that place isn't water, `canRandomlyTeleportTo`: there,
    // `teleportTo`, which leaves where it was there too, entity event 46, and its path stopped. The
    // place is held within the world border first, a hair inside its east and south edges,
    // `clampVec3ToBound`.
    fn random_teleport<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, wx: f64, y: f64, wz: f64, heard: usize) -> bool {
        let (west, north, east, south) = self.border ?? widest_border()
        let x = if wx < west { west } else { wx.min(east - f64(1.0e-5f32)) }
        let z = if wz < north { north } else { wz.min(south - f64(1.0e-5f32)) }
        let bx = floor_of(x)
        let bz = floor_of(z)
        if blocks.collision_state(bx, min_y, bz) == none {
            return false
        }
        var ty = y
        var py = floor_of(y)
        while py > min_y {
            py -= 1
            let state = blocks.collision_state(bx, py, bz) ?? 0
            if f.in_set(state, lf.teleport_onto) {
                return self.teleport_check(lf, f, m, blocks, x, ty, z, state, heard)
            }
            ty -= 1.0
        }
        return false
    }

    fn teleport_check<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, x: f64, y: f64, z: f64, below: u32, heard: usize) -> bool {
        if f.in_set(below, lf.enderman_avoids) {
            return false
        }
        let half = f64(self.living.body.width / 2.0f32)
        let b = Aabb { min_x: x - half, min_y: y, min_z: z - half, max_x: x + half, max_y: y + f64(self.living.body.height), max_z: z + half }
        let mover = Mover { y: y, fall: 0.0 }
        if not m.colliders(f, blocks, b, mover).is_empty() or any_liquid(f, blocks, b) {
            return false
        }
        for bx in floor_of(b.min_x)..=floor_of(b.max_x) {
            for by in floor_of(b.min_y)..=floor_of(b.max_y) {
                for bz in floor_of(b.min_z)..=floor_of(b.max_z) {
                    if f.in_set(blocks.collision_state(bx, by, bz) ?? 0, lf.enderman_avoids) {
                        return false
                    }
                }
            }
        }
        if f.is_water(blocks.collision_state(floor_of(x), floor_of(y) - 1, floor_of(z)) ?? 0) {
            return false
        }
        let (yr, xr) = (self.living.body.y_rot, self.living.body.x_rot)
        self.living.snap_to(x, y, z, yr, xr)
        self.living.show(Shown.Event(46i8), heard)
        self.navigation.stop()
        return true
    }

    // A creeper's `SwellGoal` (CAL-159), `kept` the entity ID of the target it took up as it
    // started: used while it swells, or with a target that isn't dying within 3 blocks. As it
    // starts, its path stopped and its target kept; as it stops, let go. Each tick it swells,
    // `setSwellDir(1)`, at the target it kept while they're alive within 7 blocks and in its sight,
    // else it shrinks.
    fn swell_goal<B: CollisionBlocks>(mut self, kept: mut i32, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            if self.living.data.number(MONSTER_OWN) > 0 {
                return true
            }
            let p = self.target_in(players) else return false
            return not p.dead and self.distance_sqr_to(p.x, p.y, p.z) < 9.0
        }
        if call == GOAL_START {
            self.navigation.stop()
            kept = -1
            if let p = self.target_in(players) {
                kept = p.id
            }
        } else if call == GOAL_STOP {
            kept = -1
        } else if call == GOAL_TICK {
            var dir = -1
            for p in players {
                if p.id == kept and not p.dead {
                    let me = self.looker()
                    if not (self.distance_sqr_to(p.x, p.y, p.z) > 49.0) and sees_player(m, f, blocks, mut self.sensing, me, p) {
                        dir = 1
                    }
                }
            }
            self.living.data.set(MONSTER_OWN, Value.Number(dir))
        }
        return false
    }

    // `LeapAtTargetGoal`, `up` blocks a tick up (CAL-159): used with a target 2 to 4 blocks off
    // while it's on the ground, 1 in 3 ticks, drawn, and going on till it's on the ground again. As
    // it starts, it leaps: across toward them at 0.4 and a fifth of how it was moving, and up.
    fn leap_goal(mut self, call: i32, up: f32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            let p = self.target_in(players) else return false
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            if d < 4.0 or d > 16.0 or not self.living.body.on_ground {
                return false
            }
            return self.living.body.random.next_int_below(reduced_tick_delay(5)) == 0
        }
        if call == GOAL_CONTINUE {
            return not self.living.body.on_ground
        }
        if call == GOAL_START {
            let p = self.target_in(players) else return false
            var dx = p.x - self.living.body.x
            var dz = p.z - self.living.body.z
            if dx * dx + dz * dz > 1.0e-7 {
                let length = (dx * dx + dz * dz).sqrt()
                var nx = 0.0
                var nz = 0.0
                if not (length < f64(1.0e-5f32)) {
                    nx = dx / length
                    nz = dz / length
                }
                dx = nx * 0.4 + self.living.body.vx * 0.2
                dz = nz * 0.4 + self.living.body.vz * 0.2
            }
            self.living.body.vx = dx
            self.living.body.vy = f64(up)
            self.living.body.vz = dz
        }
        return false
    }

    // `RangedBowAttackGoal` (CAL-159): used with a target while it holds a bow, and going on while
    // it has one or its path isn't done, still holding it. As it starts, aggressive; as it stops,
    // not, its counts reset and its bow let go, `stopUsingItem`. Each tick, with its target: how
    // long it's seen them, or not, counted, from 0 again as that changes; within its reach and seen
    // for 20 ticks, its path stopped and its strafing counted on, else a path to them, `moveTo`,
    // and no strafing. After 20 ticks of strafing, a draw of 0.3 for each way it turns about;
    // strafing, backwards where they're within half its reach, forwards past three quarters of it,
    // turned to them at once, `Mob.lookAt`, 30 degrees a tick, else looking at their eyes. Drawing,
    // it lets go where it's lost them for 60 ticks, or, seeing them, shoots once it's drawn 20
    // ticks, `performRangedAttack` with the bow's power then, its interval till it draws again;
    // else it draws once its count's out, unless it's lost them for 60 ticks, from the hand that
    // holds the bow, `startUsingItem`.
    fn bow_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Bow, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            return self.target_in(players) != none and self.holding_bow()
        }
        if call == GOAL_CONTINUE {
            return (self.target_in(players) != none or not self.navigation.is_done()) and self.holding_bow()
        }
        if call == GOAL_START {
            self.set_flag(AGGRESSIVE_FLAG, true)
        } else if call == GOAL_STOP {
            self.set_flag(AGGRESSIVE_FLAG, false)
            g.see_time = 0
            g.attack_time = -1
            self.living.stop_using()
        } else if call == GOAL_TICK {
            let p = self.target_in(players) else return false
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            let me = self.looker()
            let sight = sees_player(m, f, blocks, mut self.sensing, me, p)
            if sight != (g.see_time > 0) {
                g.see_time = 0
            }
            if sight {
                g.see_time += 1
            } else {
                g.see_time -= 1
            }
            if not (d > f64(g.radius_sqr)) and g.see_time >= 20 {
                self.navigation.stop()
                g.strafing_time += 1
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, g.speed)
                g.strafing_time = -1
            }
            if g.strafing_time >= 20 {
                if f64(self.living.body.random.next_float()) < 0.3 {
                    g.clockwise = not g.clockwise
                }
                if f64(self.living.body.random.next_float()) < 0.3 {
                    g.backwards = not g.backwards
                }
                g.strafing_time = 0
            }
            if g.strafing_time > -1 {
                if d > f64(g.radius_sqr * 0.75f32) {
                    g.backwards = false
                } else if d < f64(g.radius_sqr * 0.25f32) {
                    g.backwards = true
                }
                let forwards = if g.backwards { -0.5f32 } else { 0.5f32 }
                let right = if g.clockwise { 0.5f32 } else { -0.5f32 }
                self.moves.strafe(forwards, right)
                self.look_at_now(p, 30.0f32, 30.0f32)
            } else {
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
            }
            if self.living.using_item() {
                if not sight and g.see_time < -60 {
                    self.living.stop_using()
                } else if sight {
                    let pull = self.living.ticks_using()
                    if pull >= 20 {
                        self.living.stop_using()
                        self.ranged_attack(p, bow_power(pull), mut sounds)
                        g.attack_time = g.interval
                    }
                }
            } else {
                g.attack_time -= 1
                if g.attack_time <= 0 and g.see_time >= -60 {
                    let hand: usize = if self.main_is_bow() { 0 } else { 1 }
                    self.living.start_using(hand, sounds.len())
                }
            }
        }
        return false
    }

    // `Mob.lookAt` of the player `p` (CAL-159): turned toward their eyes at once, `max_y` and
    // `max_x` degrees at most, its pitch first, kept within a right angle as `setXRot` keeps it.
    fn look_at_now(mut self, p: Follower, max_y: f32, max_x: f32) {
        let xd = p.x - self.living.body.x
        let zd = p.z - self.living.body.z
        let yd = (p.y + f64(p.eyes)) - (self.living.body.y + f64(self.living.body.eyes))
        let sd = (xd * xd + zd * zd).sqrt()
        let y_rot = f32.nearest((table_atan2(zd, xd) ?? 0.0) * RAD_TO_DEG) - 90.0f32
        let x_rot = f32.nearest(-((table_atan2(yd, sd) ?? 0.0) * RAD_TO_DEG))
        let pitched = mob_rotlerp(self.living.body.x_rot, x_rot, max_x) % 360.0f32
        self.living.body.x_rot = if pitched < -90.0f32 { -90.0f32 } else if pitched > 90.0f32 { 90.0f32 } else { pitched }
        self.living.body.y_rot = mob_rotlerp(self.living.body.y_rot, y_rot, max_y)
    }

    // `AbstractSkeleton.performRangedAttack` at the player `p`, the bow drawn to `power` (CAL-159):
    // its shot, `Shown.Fired`, whose arrow its level makes, `getMobArrow`, from its eyes a tenth
    // below, of what it'd shoot, `getProjectile`, an arrow it holds, the off hand's first, else an
    // arrow, one of it, from the bow in the hand that holds one, at a third of the way up the
    // player; then its shoot sound, its pitch drawn.
    fn ranged_attack(mut self, p: Follower, power: f32, sounds: mut List<EntitySound>) {
        let hand: usize = if self.main_is_bow() { 0 } else { 1 }
        let weapon = self.living.equipment[hand].copy() ?? stack_of(String("minecraft:bow"))
        var item = stack_of(String("minecraft:arrow"))
        if is_arrow_item(held_name(self.living.equipment[1])) {
            item = one_of(self.living.equipment[1].copy())
        } else if is_arrow_item(held_name(self.living.equipment[0])) {
            item = one_of(self.living.equipment[0].copy())
        }
        let shot = Fired {
            owner: self.living.body.uuid,
            target: p.id,
            x: self.living.body.x,
            y: self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32),
            z: self.living.body.z,
            tx: p.x,
            ty: p.y + f64(p.height) * 0.3333333333333333,
            tz: p.z,
            power: power,
            item: item,
            weapon: weapon,
        }
        self.living.show(Shown.Fired(shot), sounds.len())
        let pitch = 1.0f32 / (self.living.body.random.next_float() * 0.4f32 + 0.8f32)
        self.living.play(mut sounds, String("entity.skeleton.shoot"), 1.0f32, pitch)
    }

    // `RestrictSunGoal` (CAL-159): used while it's bright outside and nothing's on its head, as its
    // navigation's on the ground; running, its paths keep out of the sun, `setAvoidSun`.
    fn restrict_sun_goal<B: MobLight>(mut self, call: i32, blocks: B) -> bool {
        if call == GOAL_CAN_USE {
            return blocks.bright_outside() and self.living.equipment[5] == none
        }
        if call == GOAL_CONTINUE {
            return blocks.bright_outside() and self.living.equipment[5] == none
        }
        if call == GOAL_START {
            self.navigation.avoid_sun = true
        } else if call == GOAL_STOP {
            self.navigation.avoid_sun = false
        }
        return false
    }

    // `FleeSunGoal` (CAL-159): used without a target, while it's bright outside and it burns where
    // its block sees the sky, with nothing on its head, where it finds shade, `getHidePos`: ten
    // tries, each a block up to 10 across and 3 up or down, drawn, that doesn't see the sky and
    // that it'd walk to, `getWalkTargetValue` below 0. As it starts, on its way there at its
    // speed, going on while its path isn't done.
    fn flee_sun_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut FleeSun, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.target_in(players) != none or not blocks.bright_outside() or not self.living.on_fire() {
                return false
            }
            let x = floor_of(self.living.body.x)
            let y = floor_of(self.living.body.y)
            let z = floor_of(self.living.body.z)
            if not blocks.sees_sky(x, y, z) or self.living.equipment[5] != none {
                return false
            }
            for _ in 0..10 {
                let hx = x + self.living.body.random.next_int_below(20) - 10
                let hy = y + self.living.body.random.next_int_below(6) - 3
                let hz = z + self.living.body.random.next_int_below(20) - 10
                if not blocks.sees_sky(hx, hy, hz) and self.walk_target_value(lf, f, blocks, hx, hy, hz) < 0.0f32 {
                    g.x = f64(hx) + 0.5
                    g.y = f64(hy)
                    g.z = f64(hz) + 0.5
                    return true
                }
            }
            return false
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.x, g.y, g.z, g.speed)
        }
        return false
    }

    // `isWithinMeleeAttackRange` of the player `p` (CAL-159): its box, as far again across as it
    // reaches, `getAttackBoundingBox`, meeting theirs, `getHitbox`; it reaches `sqrt(2.04F) - 0.6F`
    // made doubles, `DEFAULT_ATTACK_REACH`. What it holds' own reach, `ATTACK_RANGE`, comes with
    // spears, said to be missing.
    fn within_melee(mut self, p: Follower, heard: usize) -> bool {
        if self.held_range {
            self.living.show(Shown.Missing(String("The attack ranges of what mobs hold, ATTACK_RANGE")), heard)
        }
        let pb = p.bounds else return false
        let r = f64(2.04f32).sqrt() - f64(0.6f32)
        let b = self.living.body.bounding_box()
        return b.min_x - r < pb.max_x and b.max_x + r > pb.min_x and b.min_y < pb.max_y and b.max_y > pb.min_y and b.min_z - r < pb.max_z and b.max_z + r > pb.min_z
    }

    // `swingForAttack` of its main hand (CAL-159), `LivingEntity.swing`: where its swing may start,
    // `SwingState.startIfAble`, none under way or past half of one, its main hand's
    // `attack_animation`, its ticks from 0, shown to those who see it,
    // `ClientboundSwingAnimationPacket`. Haste and mining fatigue come with effects.
    fn swing_for_attack(mut self, heard: usize) {
        if self.swing_duration >= 0 and self.swing_ticks <= self.swing_duration / 2 and self.swing_ticks > 0 {
            return
        }
        let (kind, duration) = (self.attack_kind, self.attack_ticks)
        self.swing_duration = duration
        self.swing_ticks = 0
        self.living.show(Shown.Swung((0, kind, duration)), heard)
    }

    // `RemoveBlockGoal`, a zombie's for turtle eggs (CAL-159): where mob griefing's on, used once
    // its count of tries is done, `nextStartTick`, where it finds its block nearest,
    // `findNearestBlock`, its count 20 again, halved; else 200 to 399, drawn and halved. As it
    // starts, `MoveToBlockGoal`'s: on its way to the block's top at its speed and its most ticks
    // there drawn. Going to it and breaking it come with turtles, said to be missing, so it goes on
    // no longer.
    fn remove_block_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut RemoveBlock, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            if not self.mob_griefing {
                return false
            }
            if g.next_start > 0 {
                g.next_start -= 1
                return false
            }
            if self.find_nearest_block(mut g, f, blocks) {
                g.next_start = reduced_tick_delay(20)
                self.living.show(Shown.Missing(String("A zombie's going for turtle eggs, RemoveBlockGoal")), heard)
                return true
            }
            g.next_start = reduced_tick_delay(200 + self.living.body.random.next_int_below(200))
            return false
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, g.speed)
            let bound = self.living.body.random.next_int_below(1200) + 1200
            _ = self.living.body.random.next_int_below(bound)
        }
        return false
    }

    // `MoveToBlockGoal.findNearestBlock` (CAL-159): the blocks about its block, a block down, by
    // rings out to its range, each layer from 0 up, then down, to its range up and down, in
    // vanilla's order, the first that's its block in a full chunk with air above it twice,
    // `RemoveBlockGoal.isValidTarget`, kept. It has no home, so any is within it.
    fn find_nearest_block<B: CollisionBlocks>(self, g: mut RemoveBlock, f: Facts, blocks: B) -> bool {
        let want = f.block_named(g.block.copy()) else return false
        let (mx, my, mz) = self.block_position()
        var y = 0
        while y <= g.vertical {
            for r in 0..g.range {
                var x = 0
                while x <= r {
                    var z = if x < r and x > -r { r } else { 0 }
                    while z <= r {
                        let (px, py, pz) = (mx + x, my + y - 1, mz + z)
                        if let state = blocks.collision_state(px, py, pz) {
                            if f.block(state) == want and f.is_air(state_at(blocks, px, py + 1, pz)) and f.is_air(state_at(blocks, px, py + 2, pz)) {
                                g.x = px
                                g.y = py
                                g.z = pz
                                return true
                            }
                        }
                        z = if z > 0 { -z } else { 1 - z }
                    }
                    x = if x > 0 { -x } else { 1 - x }
                }
            }
            y = if y > 0 { -y } else { 1 - y }
        }
        return false
    }

    // `SpearUseGoal`, a zombie's, charging and getting away at 1, from 10 blocks off, within 2 of
    // its target (CAL-159): used with a target while it holds a spear, `KINETIC_WEAPON`, and uses
    // nothing; going on while it isn't done and that holds. As it starts, aggressive, its state
    // new; as it stops, its path stopped, not aggressive, no state, and what it uses let go. Each
    // tick, turned to its target at once, `Mob.lookAt`, and looking at their eyes, 30 degrees a
    // tick. Not yet engaged, it's on its way to them while they're more than 10 off, else its
    // spear's down for its damage's ticks, `computeDamageUseDuration`, as goal ticks, and used,
    // `startUsingItem`. Its spear's time up, it's let go, and a place to get away to found, 9 to
    // 11 blocks from them less how far they are, `getPosAway`, its getting away begun. Getting
    // away longer than 50 goal ticks, it's done; else with a place to go, it goes, and once its
    // path's done, it's done where it was getting away, else it has no place; with none, it
    // charges, and within 2 of them or its path done, a place 6 to 7 from them less how far they
    // are is found. It rides nothing, so its speeds are as they are.
    fn spear_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut SpearUse, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            return self.target_in(players) != none and self.held_kinetic and not self.living.using_item()
        }
        if call == GOAL_CONTINUE {
            return g.on and not g.done and self.target_in(players) != none and self.held_kinetic
        }
        if call == GOAL_START {
            self.set_flag(AGGRESSIVE_FLAG, true)
            g.on = true
            g.engage_time = -1
            g.fleeing_time = -1
            g.away = none
            g.done = false
        } else if call == GOAL_STOP {
            self.navigation.stop()
            self.set_flag(AGGRESSIVE_FLAG, false)
            g.on = false
            g.away = none
            self.living.stop_using()
        } else if call == GOAL_TICK {
            if not g.on {
                return false
            }
            let p = self.target_in(players) else return false
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            self.look_at_now(p, 30.0f32, 30.0f32)
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
            if g.engage_time < 0 {
                if d > 100.0 {
                    _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, 1.0)
                    return false
                }
                let k = self.held_spear ?? Kinetic()
                let lasting = match k.damage {
                    some(c) => c.max_ticks,
                    none => 0,
                }
                g.engage_time = reduced_tick_delay(k.delay + lasting)
                self.living.start_using_kinetic(0, k, heard)
            }
            if g.engage_time > 0 {
                g.engage_time -= 1
                if g.engage_time == 0 {
                    self.living.stop_using()
                    let distance = d.sqrt()
                    g.away = self.pos_away(lf, f, blocks, mut cache, min_y, (9.0 - distance).max(0.0), (11.0 - distance).max(1.0), (p.x, p.y, p.z))
                    g.fleeing_time = 1
                }
            }
            if g.fleeing_time > 0 {
                g.fleeing_time += 1
                if f64(g.fleeing_time) > f64(reduced_tick_delay(100)) {
                    g.done = true
                    return false
                }
            }
            if let at = g.away {
                let (ax, ay, az) = at
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, ax, ay, az, 1.0)
                if self.navigation.is_done() {
                    if g.fleeing_time > 0 {
                        g.done = true
                        return false
                    }
                    g.away = none
                }
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, 1.0)
                if d < 4.0 or self.navigation.is_done() {
                    let distance = d.sqrt()
                    g.away = self.pos_away(lf, f, blocks, mut cache, min_y, 6.0 - distance, 7.0 - distance, (p.x, p.y, p.z))
                }
            }
        }
        return false
    }

    // `LandRandomPos.getPosAway` from `avoid`, `min_h` to `max_h` across and 7 up or down
    // (CAL-159): the way from it across, drawn where it's right on it; of the 10 places tried,
    // `away_tries`, the best, as `random_place` has it.
    fn pos_away<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32, min_h: f64, max_h: f64, avoid: (f64, f64, f64)) -> (f64, f64, f64)? {
        let (ax, ay, az) = avoid
        var dx = self.living.body.x - ax
        let dy = self.living.body.y - ay
        var dz = self.living.body.z - az
        if (dx * dx + dy * dy + dz * dz).sqrt() == 0.0 {
            dx = self.living.body.random.next_double() - 0.5
            dz = self.living.body.random.next_double() - 0.5
        }
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y() }
        let tries = away_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, w, min_h, max_h, 7, (dx, dz))
        return self.best_place(lf, f, blocks, tries)
    }

    /// What its main hand holds as its tick begins, as its attacks read it (CAL-159): its swing,
    /// `getAttackAnimation`, a whack of 6 where it has no `attack_animation`; whether it's a
    /// spear, its `KineticWeapon` kept; and whether it reaches as its own, its reach with it kept,
    /// `getAttackRangeWith`.
    pub fn read_held<W: Wearing>(mut self, items: W) {
        self.attack_kind = 1
        self.attack_ticks = 6
        self.held_kinetic = false
        self.held_range = false
        self.held_spear = none
        self.held_reach = none
        let held = self.living.equipment[0].copy() else return
        if let k = items.worn_component(held.copy(), String("minecraft:kinetic_weapon")) {
            self.held_kinetic = true
            self.held_spear = some(kinetic_of(k))
        }
        let range = items.worn_component(held.copy(), String("minecraft:attack_range"))
        self.held_range = range != none
        self.held_reach = some(reach_of(range))
        let found = items.worn_component(held, String("minecraft:attack_animation")) else return
        let Tag.Compound(a) = found else return
        var kind = 1
        if a.contains("type") {
            if let Tag.Str(name) = a["type"].copy() {
                kind = if name == "none" { 0 } else if name == "stab" { 2 } else { 1 }
            }
        }
        let duration = if a.contains("duration") { a["duration"].number_int() ?? 6 } else { 6 }
        self.attack_kind = kind
        self.attack_ticks = duration
    }

    /// `setLastHurtMob` (CAL-159): the player `id`, at its tick count now, after its attack hurt
    /// them.
    pub fn hurt_mob(mut self, id: i32) {
        self.last_hurt_mob = some(id)
        self.last_hurt_mob_stamp = self.living.body.tick_count
    }

    /// `setLastHurtMob` of what isn't living, as an end crystal isn't (D591): none, as of its
    /// tick.
    pub fn hurt_unliving(mut self) {
        self.last_hurt_mob = none
        self.last_hurt_mob_stamp = self.living.body.tick_count
    }

    /// Whether it's a zombie, of `Zombie`'s class, which a zombie's alert reaches; a zombie
    /// villager's reaches only its own (CAL-159).
    pub fn zombie_class(self) -> bool {
        return self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER
    }

    /// `alertOther` of the mob of its class near one hurt (CAL-159): where it has no target now,
    /// `getTarget`, the player `id`, as `setTarget` takes them.
    pub fn alerted_to(mut self, id: i32, players: List<Follower>) {
        if self.target_in(players) == none {
            self.set_target(some(id), players)
        }
    }

    // `PanicGoal` (D416): used where what last hurt it, within 40 ticks, `getLastDamageSource`, is
    // of a type in `#panic_causes`, with a place to run to, up to 5 across and 4 up or down,
    // `DefaultRandomPos.getPos`, or on fire to water near, `look_for_water` (D434); going on till
    // its navigation's done.
    fn panic_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Panic, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if not self.living.recently_hurt_by(self.game_time, PANIC_CAUSES) {
                return false
            }
            if self.living.on_fire() {
                if let (wx, wy, wz) = self.look_for_water(f, m, blocks) {
                    g.x = f64(wx)
                    g.y = f64(wy)
                    g.z = f64(wz)
                    return true
                }
            }
            let at = self.random_place(false, 5, 4, lf, f, blocks, mut cache, min_y) else return false
            let (x, y, z) = at
            g.x = x
            g.y = y
            g.z = z
            return true
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.x, g.y, g.z, g.speed)
        }
        return false
    }

    // `FloatGoal`: used while it's deeper in water than it jumps out of, `getFluidJumpThreshold`,
    // 0.4 or 0 for eyes below 0.4, or in lava; each tick 4 in 5, drawn from its random, it jumps.
    fn float_goal(mut self, call: i32) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let threshold = if f64(self.living.body.eyes) < 0.4 { 0.0 } else { 0.4 }
            return self.living.body.water > threshold or self.living.body.in_lava()
        }
        if call == GOAL_TICK and self.living.body.random.next_float() < 0.8f32 {
            self.jump = true
        }
        return false
    }

    // `RandomLookAroundGoal`: used 1 in 50, drawn; a way drawn round it and 20 to 39 ticks, also
    // drawn, looking that way at its eyes' height.
    fn look_around_goal(mut self, g: mut LookAround, call: i32) -> bool {
        if call == GOAL_CAN_USE {
            return self.living.body.random.next_float() < 0.02f32
        }
        if call == GOAL_CONTINUE {
            return g.look_time >= 0
        }
        if call == GOAL_START {
            let turn = 6.283185307179586 * self.living.body.random.next_double()
            g.rel_x = cos(turn)
            g.rel_z = sin(turn)
            g.look_time = 20 + self.living.body.random.next_int_below(20)
        } else if call == GOAL_TICK {
            g.look_time -= 1
            let eyes = self.living.body.y + f64(self.living.body.eyes)
            self.look.set_look_at(self.living.body.x + g.rel_x, eyes, self.living.body.z + g.rel_z, HEAD_ROT_SPEED, MAX_HEAD_X_ROT)
        }
        return false
    }

    // `LookAtPlayerGoal`: used as often as it's likely, drawn, toward the nearest player its
    // targeting finds, for 40 to 79 ticks, drawn, as goals that don't tick every tick count them;
    // going on while the player's alive and within its distance; looking at the player's eyes.
    fn look_at_goal<B: CollisionBlocks>(mut self, g: mut LookAtPlayer, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            if self.living.body.random.next_float() >= g.probability {
                return false
            }
            let who = self.looker()
            let eyes = who.eye_y
            g.look_at = nearest_player(m, f, blocks, mut self.sensing, who, players, f64(g.distance), eyes, true, 0u32)
            return g.look_at != none
        }
        if call == GOAL_CONTINUE {
            let id = g.look_at else return false
            let at = player_at(players, id) else return false
            let p = players[at].copy()
            if p.dead {
                return false
            }
            let dx = p.x - self.living.body.x
            let dy = p.y - self.living.body.y
            let dz = p.z - self.living.body.z
            if dx * dx + dy * dy + dz * dz > f64(g.distance * g.distance) {
                return false
            }
            return g.look_time > 0
        }
        if call == GOAL_START {
            g.look_time = reduced_tick_delay(40 + self.living.body.random.next_int_below(40))
        } else if call == GOAL_STOP {
            g.look_at = none
        } else if call == GOAL_TICK {
            let id = g.look_at else return false
            let at = player_at(players, id) else return false
            let p = players[at].copy()
            if not p.dead {
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, HEAD_ROT_SPEED, MAX_HEAD_X_ROT)
                g.look_time -= 1
            }
        }
        return false
    }

    // `WaterAvoidingRandomStrollGoal`: where it hasn't done nothing for 100 ticks, used 1 in
    // `interval` of its full ticks, drawn, with a place to go; going on till its navigation's done,
    // where it's gone, and its navigation stopped as it stops.
    fn stroll_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Stroll, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            // `hasControllingPassenger`: no one rides yet.
            if not g.force {
                if g.check_no_action and self.no_action_time >= 100 {
                    return false
                }
                if self.living.body.random.next_int_below(reduced_tick_delay(g.interval)) != 0 {
                    return false
                }
            }
            let at = self.stroll_position(g, lf, f, blocks, mut cache, min_y) else return false
            let (x, y, z) = at
            g.wanted_x = x
            g.wanted_y = y
            g.wanted_z = z
            g.force = false
            return true
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.wanted_x, g.wanted_y, g.wanted_z, g.speed)
        } else if call == GOAL_STOP {
            self.navigation.stop()
        }
        return false
    }

    // `getPosition`: in water, a place on land up to 15 across, else any up to 10; out of it, a
    // place on land up to 10 but where 1 in 1,000, drawn, any; any for a stroll that doesn't avoid
    // water. Each 7 up or down at most.
    fn stroll_position<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: Stroll, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        if g.water_avoiding {
            if self.living.body.in_water {
                if let p = self.random_place(true, 15, 7, lf, f, blocks, mut cache, min_y) {
                    return some(p)
                }
                return self.random_place(false, 10, 7, lf, f, blocks, mut cache, min_y)
            }
            if self.living.body.random.next_float() >= g.probability {
                return self.random_place(true, 10, 7, lf, f, blocks, mut cache, min_y)
            }
        }
        return self.random_place(false, 10, 7, lf, f, blocks, mut cache, min_y)
    }

    // `LandRandomPos.getPos` where `land`, else `DefaultRandomPos.getPos`, up to `h` across and `v`
    // up or down: of the 10 places tried, the one of the highest walk target value, the first of
    // those as high, at its bottom's middle, `generateRandomPos`.
    fn random_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, land: bool, h: i32, v: i32, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y() }
        let tries = if land { land_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, w, h, v) } else { default_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, self.navigation.maluses, w, h, v) }
        return self.best_place(lf, f, blocks, tries)
    }

    // Of the places `tries`, the one of the highest walk target value, the first of those as
    // high, at its bottom's middle, `generateRandomPos`; none where none was found.
    fn best_place<B: CollisionBlocks + MobLight>(self, lf: LivingFacts, f: Facts, blocks: B, tries: List<(i32, i32, i32)?>) -> (f64, f64, f64)? {
        var best = f64.NEG_INFINITY
        var found: (i32, i32, i32)? = none
        for t in tries {
            if let p = t {
                let (x, y, z) = p
                let value = f64(self.walk_target_value(lf, f, blocks, x, y, z))
                if value > best {
                    best = value
                    found = some((x, y, z))
                }
            }
        }
        let q = found else return none
        let (x, y, z) = q
        return some((f64(x) + 0.5, f64(y), f64(z) + 0.5))
    }

    // `getWalkTargetValue`: an animal's 10 over a grass block, else the light's pathfinding cost,
    // `getPathfindingCostFromLightLevels`, its magic light less a half; a monster's that cost
    // taken away; any other's 0.
    fn walk_target_value<B: CollisionBlocks + MobLight>(self, lf: LivingFacts, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> f32 {
        if self.animal {
            if f.block(state_at(blocks, x, y - 1, z)) == lf.grass_block {
                return 10.0f32
            }
            return blocks.magic_light(x, y, z) - 0.5f32
        }
        if self.monster and self.species != ENDERMAN {
            return -(blocks.magic_light(x, y, z) - 0.5f32)
        }
        return 0.0f32
    }

    // `EatBlockGoal`: used 1 in 500, or 25 for a baby, drawn, where it stands in what a sheep eats
    // or on a grass block; shown, entity event 10, its navigation stopped, for 20 ticks; at the
    // second to last, what it stands in eaten, or the grass block turned to dirt, `Grazed`, which
    // mob griefing lets the level do, and it's eaten either way, `ate`.
    fn eat_goal<B: CollisionBlocks>(mut self, g: mut EatBlock, call: i32, lf: LivingFacts, f: Facts, blocks: B, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            let bound = reduced_tick_delay(if self.baby() { 50 } else { 1000 })
            if self.living.body.random.next_int_below(bound) != 0 {
                return false
            }
            let (x, y, z) = self.block_position()
            if f.in_set(state_at(blocks, x, y, z), lf.sheep_food) {
                return true
            }
            return f.block(state_at(blocks, x, y - 1, z)) == lf.grass_block
        }
        if call == GOAL_CONTINUE {
            return g.tick > 0
        }
        if call == GOAL_START {
            g.tick = reduced_tick_delay(40)
            self.living.show(Shown.Event(10), heard)
            self.navigation.stop()
        } else if call == GOAL_STOP {
            g.tick = 0
        } else if call == GOAL_TICK {
            g.tick = if g.tick - 1 > 0 { g.tick - 1 } else { 0 }
            if g.tick == reduced_tick_delay(4) {
                let (x, y, z) = self.block_position()
                if f.in_set(state_at(blocks, x, y, z), lf.sheep_food) {
                    self.living.show(Shown.Grazed(Grazed { x: x, y: y, z: z, whole: true }), heard)
                    self.ate()
                } else if f.block(state_at(blocks, x, y - 1, z)) == lf.grass_block {
                    self.living.show(Shown.Grazed(Grazed { x: x, y: y - 1, z: z, whole: false }), heard)
                    self.ate()
                }
            }
        }
        return false
    }

    // Its block's place, `blockPosition`.
    fn block_position(self) -> (i32, i32, i32) {
        return (floor_of(self.living.body.x), floor_of(self.living.body.y), floor_of(self.living.body.z))
    }

    // `Sheep.ate`: its wool back, `setSheared(false)`, and a baby a minute older, `ageUp(60)`.
    fn ate(mut self) {
        let wool = i32(self.living.data.byte(OWN))
        self.living.data.set(OWN, Value.Byte(i8.wrap(wool & ~16)))
        if self.baby() {
            self.age_up(60)
        }
    }

    /// A player's use of it with the item `item`, as `minecraft:wheat`, in hand, `Mob.interact`, the
    /// player's UUID `player` (CAL-158). Where it's alive, a farm animal's food, `isFood`, makes a
    /// grown one not in love fall in love for 600 ticks, the player its love's cause, `setInLove`,
    /// shown as entity event 18 after the sounds `heard`, a use the server swings for,
    /// `SUCCESS_SERVER`; or makes a baby that may grow up a tenth of its time older, `ageUp` forced,
    /// `SUCCESS`; either uses one of the food. Anything else does nothing yet: name tags, spawn eggs,
    /// leads, shears, buckets, bowls, saddles, golden dandelions and horses come with CAL-179.
    pub fn interact(mut self, lf: LivingFacts, item: String, player: (i64, i64), heard: usize, main: bool) -> Interaction {
        if self.species == VILLAGER and self.living.alive() and item != "minecraft:villager_spawn_egg" and self.trading == none and self.living.sleeping == none {
            // `Villager.mobInteract` (CAL-160): one trading's used as a mob is; a baby made
            // unhappy, `SUCCESS`; a grown one with no offers, which its level made as they were
            // asked for, `offers_asked`, made unhappy where it's the main hand, `CONSUME`; else it
            // trades with the player, `startTrading`, which its level starts, `SUCCESS`; one
            // asleep isn't, as a mob is (CAL-160). A grown one used with the main hand counts the
            // player's `TALKED_TO_VILLAGER`, `talked` (CAL-164).
            var out = Interaction { result: INTERACT_SUCCESS, used: false }
            if self.baby() {
                self.set_unhappy(mut out.sounds)
                return out
            }
            out.talked = main
            if not self.has_offers() {
                if main {
                    self.set_unhappy(mut out.sounds)
                }
                out.result = INTERACT_CONSUME
                return out
            }
            out.trades = true
            return out
        }
        if self.species == ARMADILLO and self.living.alive() {
            // `Armadillo.mobInteract` (CAL-160): a brush brushes a grown one's scute off, rolled
            // up or not, `brushOffScute`, `SUCCESS`: a scute dropped where it is,
            // `brush/armadillo`, as its level drops it, then its brush heard, and the brush worn
            // by 16, `hurtAndBreak`, by the level once it's back among its entities; its game
            // event comes with game events. Else, scared, it's `FAIL`, which does what `PASS`
            // does.
            if item == "minecraft:brush" and not self.baby() {
                var out = Interaction { result: INTERACT_SUCCESS, used: false, wear: 16 }
                out.dropped = some(Laid { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, item: String("minecraft:armadillo_scute"), table: String("minecraft:brush/armadillo") })
                self.living.play(mut out.sounds, String("entity.armadillo.brush"), 1.0f32, 1.0f32)
                return out
            }
            if self.scared() {
                return Interaction { result: INTERACT_PASS, used: false }
            }
        }
        let food = self.food_set()
        if not self.living.alive() or food == 0u32 or lf.tempting.of(item) & food == 0u32 {
            return Interaction { result: INTERACT_PASS, used: false }
        }
        if self.age == 0 and self.in_love <= 0 {
            self.in_love = 600
            self.kept.insert(String("LoveCause"), uuid_tag(player))
            self.living.show(Shown.Event(18), heard)
            var out = Interaction { result: INTERACT_SERVER, used: true }
            self.eating_sound(mut out.sounds)
            return out
        }
        if self.can_age_up() {
            let ticks = -self.age
            let seconds = i32.saturate(f64(f32.nearest(f64(ticks / 20)) * 0.1f32))
            self.age_up_forced(seconds)
            var out = Interaction { result: INTERACT_SUCCESS, used: true }
            self.eating_sound(mut out.sounds)
            return out
        }
        return Interaction { result: INTERACT_PASS, used: false }
    }

    // `Villager.setUnhappy`: unhappy for 40 ticks, and its no heard, `makeSound` (CAL-160).
    fn set_unhappy(mut self, sounds: mut List<EntitySound>) {
        self.living.data.set(OWN, Value.Number(40))
        self.make_sound(mut sounds, "entity.villager.no")
    }

    // `Villager.refreshBrain`: its old brain's behaviors stopped, `stopAll`; then its brain made
    // again as it's made, its sensors put off again by its random, with the memories its old one
    // would save, `pack`, going by its schedule from now, `registerBrainGoals` (CAL-160).
    fn refresh_brain(mut self) {
        let old = self.brain.take() else return
        var stopped = old
        self.stop_all(mut stopped)
        var brain = self.villager_brain()
        brain.unpack(stopped.packed())
        let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
        brain.update_from_schedule(self.game_time, scheduled)
        self.brain = some(brain)
    }

    // `Villager.makeBrain`'s `BRAIN_PROVIDER` (CAL-160): its sensors, each put off by its own
    // random, and its profession's activities, a baby's or a grown one's, its gates seeded from
    // its own seed; and `registerBrainGoals`' schedule, a baby's or a grown one's.
    fn villager_brain(mut self) -> Brain {
        let baby = self.baby()
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        var b = Brain.made(villager_sensors(), villager_activities(self.brain_seed, profession, baby), mut self.living.body.random)
        b.schedule = if baby { SCHEDULE_BABY } else { SCHEDULE_VILLAGER }
        return b
    }

    /// A villager's brain as `registerBrainGoals` leaves it as it's made at the game time `now`
    /// (CAL-160): its schedule's activity on, `adult` a grown villager's schedule's activity then
    /// and `baby` a baby's.
    pub fn settle_brain(mut self, now: i64, adult: i32, baby: i32) {
        if self.species != VILLAGER {
            return
        }
        var b = self.brain.take() else return
        b.last_schedule = -9999
        let scheduled = b.scheduled(adult, baby)
        b.update_from_schedule(now, scheduled)
        self.brain = some(b)
    }

    // `Brain.stopAll`: each of its behaviors running stopped, `doStop`, in the order it goes over
    // them, durations' draws from the level's random where it's lent.
    fn stop_all(mut self, brain: mut Brain) {
        let lent = self.level_random.take()
        let had = lent != none
        var random = lent ?? TapedRandom.new(0i64)
        var sounds = List<EntitySound>()
        var runs = brain.take_runs()
        for i in 0..runs.len() {
            if runs[i].deed.running {
                self.do_stop(mut brain, mut runs[i].deed, mut random, mut sounds)
            }
        }
        brain.give_back_runs(runs)
        if had {
            self.level_random = some(random)
        }
    }

    // `doStop` of the running behavior `d`: a gate's running behaviors each, and what it forgets
    // as it stops forgotten; a behavior with a duration's `stop`.
    fn do_stop(mut self, brain: mut Brain, d: mut Deed, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        d.running = false
        if let Behavior.Gate(_) = d.kind {
            var g = d.gate.take() else return
            for i in 0..g.entries.len() {
                if g.entries[i].deed.running {
                    self.do_stop(mut brain, mut g.entries[i].deed, mut random, mut sounds)
                }
            }
            for e in g.erases {
                brain.erase(e)
            }
            d.gate = some(g)
            return
        }
        let kind = d.kind
        if timed(kind) {
            self.stop_behavior(mut brain, kind, mut d.keep, mut random, mut sounds)
        }
    }

    // `playEatingSound`, as it's fed: an armadillo's eating, `makeSound`; the others' none.
    fn eating_sound(mut self, sounds: mut List<EntitySound>) {
        if self.species == ARMADILLO {
            self.make_sound(mut sounds, "entity.armadillo.eat")
        }
    }

    // The set of tempting items its kind eats, `isFood`, by its bit; none for a kind that eats
    // nothing so far.
    fn food_set(self) -> u32 {
        let s = self.species
        if s == COW or s == MOOSHROOM {
            return TEMPT_COW
        }
        if s == PIG {
            return TEMPT_PIG
        }
        if s == SHEEP {
            return TEMPT_SHEEP
        }
        if s == CHICKEN {
            return TEMPT_CHICKEN
        }
        if s == ARMADILLO {
            return TEMPT_ARMADILLO
        }
        return 0u32
    }

    // `canAgeUp`: a baby not locked, but never a zombie horse.
    fn can_age_up(self) -> bool {
        return self.baby() and not self.living.data.flag(AGE_LOCKED) and self.species != ZOMBIE_HORSE
    }

    // `AgeableMob.ageUp(seconds, true)`: `seconds` older, up to grown, its forced age the more by
    // what it grew and its particles' 40 ticks begun where they aren't going on, then its forced
    // age where that's grown it.
    fn age_up_forced(mut self, seconds: i32) {
        let before = self.age
        var age = before + seconds * 20
        if age > 0 {
            age = 0
        }
        self.set_age(age)
        self.forced_age += age - before
        if self.forced_age_timer == 0 {
            self.forced_age_timer = 40
        }
        if self.age == 0 {
            let forced = self.forced_age
            self.set_age(forced)
        }
    }

    // `AgeableMob.ageUp(seconds, false)`: `seconds` older, up to grown, then its forced age where
    // that's grown it.
    fn age_up(mut self, seconds: i32) {
        var age = self.age + seconds * 20
        if age > 0 {
            age = 0
        }
        self.set_age(age)
        if self.age == 0 {
            let forced = self.forced_age
            self.set_age(forced)
        }
    }

    // A horse's `RandomStandGoal`: each full tick its count up; once past 0, used where a draw of
    // 1,000 is under the count, its count from minus its ambient interval again, then where it
    // isn't eating or standing 1 in 10, drawn; standing for 20 ticks, `standIfPossible`, its
    // ambient sound played, loud 1 and pitched 1; never going on.
    fn stand_goal(mut self, g: mut Stand, call: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            g.next += 1
            if g.next > 0 and self.living.body.random.next_int_below(1000) < g.next {
                g.next = -self.ambient_interval
                let immobile = self.horse_flag(16) or self.horse_flag(32)
                return not immobile and self.living.body.random.next_int_below(10) == 0
            }
            return false
        }
        if call == GOAL_START {
            self.set_horse_flag(16, false)
            self.set_horse_flag(32, true)
            self.stand_counter = 20
            let held = self.ambient.copy()
            if let sound = held {
                self.living.play(mut sounds, sound, 1.0f32, 1.0f32)
            }
        }
        return false
    }

    // What its targeting is to players: its ID, feet, eyes and collisions, and its type.
    fn looker(self) -> Looker {
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        return Looker { id: self.living.body.id, x: x, y: y, z: z, eye_y: y + f64(self.living.body.eyes), mover: Mover { y: y, fall: self.living.body.fall }, kind: i32.wrap(self.living.kind) }
    }

    // How far x, y, z is from its feet, squared, `distanceToSqr`.
    fn distance_sqr_to(self, x: f64, y: f64, z: f64) -> f64 {
        let dx = self.living.body.x - x
        let dy = self.living.body.y - y
        let dz = self.living.body.z - z
        return dx * dx + dy * dy + dz * dz
    }

    // The mob `id` among those near it this tick, where it's there.
    fn kin_of(self, id: i32) -> Kin? {
        for k in self.kin {
            if k.id == id {
                return some(k)
            }
        }
        return none
    }

    // `getNavigation().moveTo(entity, speedModifier)`, for the entity at `x`, `y`, `z`: as
    // `move_to`, but where no path's found the one it has kept.
    fn move_to_entity<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, x: f64, y: f64, z: f64, speed: f64) -> bool {
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        return self.navigation.move_to_entity(lf, f, nf, m, blocks, mut cache, w, x, y, z, speed)
    }

    // `TemptGoal`, never scared off: past its calm, which each try counts down, used toward the
    // nearest player holding what's in its set in either hand, within its tempt range from its
    // feet, seen or not, and going on while there's one, perhaps another; each full tick looking at
    // the player's eyes, its head turned up to 95 a tick, and going toward them, or stopped within
    // 2.5; calm for 50 tries once it stops.
    fn tempt_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut Tempt, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            if g.calm_down > 0 {
                g.calm_down -= 1
                return false
            }
            let who = self.looker()
            let feet = who.y
            let range = self.living.attributes.value(lf.tempt_range)
            g.player = nearest_player(m, f, blocks, mut self.sensing, who, players, range, feet, false, g.bit)
            return g.player != none
        }
        if call == GOAL_STOP {
            g.player = none
            self.navigation.stop()
            g.calm_down = reduced_tick_delay(100)
        } else if call == GOAL_TICK {
            let id = g.player else return false
            let at = player_at(players, id) else return false
            let (x, y, z, eyes) = (players[at].x, players[at].y, players[at].z, players[at].eyes)
            self.look.set_look_at(x, y + f64(eyes), z, self.max_head_y_rot() + 20.0f32, MAX_HEAD_X_ROT)
            if self.distance_sqr_to(x, y, z) < 6.25 {
                self.navigation.stop()
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, x, y, z, g.speed)
            }
        }
        return false
    }

    // `BreedGoal`: where it's in love, used toward its free partner; going on while the partner's
    // alive and in love, for under 60 of its ticks; each of them looking at the partner's eyes, its
    // head turned up to 10 a tick, going to it, `moveTo`, and from its 30th, within 3 of it,
    // breeding, `breed`; neither with a partner that panics, `isPanicking` (D416).
    fn breed_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut Breed, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            if self.in_love <= 0 {
                return false
            }
            g.partner = self.free_partner()
            return g.partner != none
        }
        if call == GOAL_CONTINUE {
            let id = g.partner else return false
            let k = self.kin_of(id) else return false
            return k.alive and k.in_love and g.love_time < 60 and not k.panicking
        }
        if call == GOAL_STOP {
            g.partner = none
            g.love_time = 0
        } else if call == GOAL_TICK {
            let id = g.partner else return false
            let k = self.kin_of(id) else return false
            self.look.set_look_at(k.x, k.y + f64(k.eyes), k.z, 10.0f32, MAX_HEAD_X_ROT)
            _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, k.x, k.y, k.z, g.speed)
            g.love_time += 1
            if g.love_time >= reduced_tick_delay(60) and self.distance_sqr_to(k.x, k.y, k.z) < 9.0 {
                self.breed(k, heard)
            }
        }
        return false
    }

    // `getFreePartner`: of the mobs of its kind near it, in `getEntitiesOfClass`'s order, whose box
    // meets its own 8 beyond on every side, those alive within 8 of it, `PARTNER_TARGETING`, in
    // love as it is, `canMate`, and not panicking; the nearest, the first of those as near.
    fn free_partner(self) -> i32? {
        let b = self.living.body.bounding_box()
        var best = f64.MAX
        var found: i32? = none
        for k in self.kin {
            if k.species != self.species or not k.alive or not k.in_love or k.panicking {
                continue
            }
            if not k.bounds.intersects(b.min_x - 8.0, b.min_y - 8.0, b.min_z - 8.0, b.max_x + 8.0, b.max_y + 8.0, b.max_z + 8.0) {
                continue
            }
            let d = self.distance_sqr_to(k.x, k.y, k.z)
            if d > 64.0 {
                continue
            }
            if d < best {
                best = d
                found = some(k.id)
            }
        }
        return found
    }

    // `spawnChildFromBreeding` with the partner `k`: its baby's variant drawn, `getBreedOffspring`,
    // a cow's, pig's or chicken's either parent's, `nextBoolean`, a mooshroom's the other type 1 in
    // 1,024 where they're the same, else either parent's, and a lamb's its parents' colours, which
    // its level mixes; then `finalizeSpawnChildFromBreeding`: it 6000 ticks from breeding again and
    // out of love, and where mob drops are on, an orb worth 1 to 7, drawn; what its level does of
    // it, `Bred`, shown after the sounds `heard`, which sends its entity event 18 after its
    // `BRED_ANIMALS` and before its orb, as vanilla broadcasts it (CAL-164).
    fn breed(mut self, k: Kin, heard: usize) {
        let s = self.species
        var variant = self.breed_variant()
        if s == COW or s == PIG or s == CHICKEN {
            if not self.living.body.random.next_boolean() {
                variant = k.variant
            }
        } else if s == MOOSHROOM {
            let mine = variant
            var mutated = false
            if mine == k.variant and self.living.body.random.next_int_below(1024) == 0 {
                variant = 1 - mine
                mutated = true
            }
            if not mutated and not self.living.body.random.next_boolean() {
                variant = k.variant
            }
        }
        self.set_age(6000)
        self.in_love = 0
        var orb = 0
        if self.mob_drops {
            orb = self.living.body.random.next_int_below(7) + 1
        }
        let (x, y, z, kind) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.kind)
        self.living.show(Shown.Bred(Bred { partner: k.id, species: s, kind: kind, variant: variant, partner_variant: k.variant, x: x, y: y, z: z, orb: orb }), heard)
    }

    // `FollowParentGoal`: a baby's, used where the nearest grown one of its kind whose box meets its
    // own 8 beyond across and 4 up and down, the last of those as near, is 3 or more away; going on
    // while it's a baby and the parent's alive and 3 to 16 away; finding its path to the parent
    // again every 5 of its ticks, the first as it starts.
    fn follow_parent_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut FollowParent, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.age >= 0 {
                return false
            }
            let b = self.living.body.bounding_box()
            var closest: i32? = none
            var best = f64.MAX
            for k in self.kin {
                if k.species != self.species or k.age < 0 {
                    continue
                }
                if not k.bounds.intersects(b.min_x - 8.0, b.min_y - 4.0, b.min_z - 8.0, b.max_x + 8.0, b.max_y + 4.0, b.max_z + 8.0) {
                    continue
                }
                let d = self.distance_sqr_to(k.x, k.y, k.z)
                if not (d > best) {
                    best = d
                    closest = some(k.id)
                }
            }
            if closest == none or best < 9.0 {
                return false
            }
            g.parent = closest
            return true
        }
        if call == GOAL_CONTINUE {
            if self.age >= 0 {
                return false
            }
            let id = g.parent else return false
            let k = self.kin_of(id) else return false
            if not k.alive {
                return false
            }
            let d = self.distance_sqr_to(k.x, k.y, k.z)
            return not (d < 9.0) and not (d > 256.0)
        }
        if call == GOAL_START {
            g.recalc = 0
        } else if call == GOAL_STOP {
            g.parent = none
        } else if call == GOAL_TICK {
            g.recalc -= 1
            if g.recalc <= 0 {
                g.recalc = reduced_tick_delay(10)
                let id = g.parent else return false
                let k = self.kin_of(id) else return false
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, k.x, k.y, k.z, g.speed)
            }
        }
        return false
    }

    /// Whether its navigation has a path it hasn't finished, which a block whose shape changes
    /// may make it find again (CAL-157).
    pub fn navigating(self) -> bool {
        return not self.navigation.is_done()
    }

    /// A block the level sent again with its shape changed, as `sendBlockUpdated` tells its
    /// navigation: its path found again where the block's near enough to it and the path's end,
    /// `shouldRecomputePath` (CAL-157).
    pub fn block_changed<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, x: i32, y: i32, z: i32) {
        let w = self.walker(lf)
        if self.navigation.should_recompute(w, x, y, z) {
            let nf = nav_facts(lf, blocks, min_y)
            self.navigation.recompute(lf, f, nf, m, blocks, mut cache, w)
        }
    }

    // What its navigation and move control read of it: its place, box and size, whether it's on
    // the ground, in water or lava and in water it floats in, how far it's fallen, its step
    // height, `maxUpStep`, its speed, and its follow range and movement speed.
    fn walker(self, lf: LivingFacts) -> Walker {
        return Walker {
            x: self.living.body.x,
            y: self.living.body.y,
            z: self.living.body.z,
            bounds: self.living.body.bounding_box(),
            width: self.living.body.width,
            height: self.living.body.height,
            eyes: self.living.body.eyes,
            on_ground: self.living.body.on_ground,
            in_liquid: self.living.body.in_water or self.living.body.in_lava(),
            floating: self.living.body.water > 0.0,
            fall: self.living.body.fall,
            step: f32.nearest(self.living.attributes.value(lf.step_height)),
            speed: self.living.speed,
            follow_range: self.living.attributes.value(lf.follow_range),
            movement_speed: self.living.attributes.value(lf.movement_speed),
            max_fall: self.max_fall_distance(lf),
        }
    }

    // `getMaxFallDistance` (CAL-159): 3 without a target; with one, 3 and what of its health it'd
    // give up, what's over a third of its most, less 4 for each step the difficulty's below hard,
    // none below 0; a creeper's, its health less 1, and 3.
    fn max_fall_distance(self, lf: LivingFacts) -> i32 {
        if self.target == none {
            return 3
        }
        let health = self.living.health()
        if self.species == CREEPER {
            return i32.saturate(f64(health - 1.0f32 + 3.0f32).floor())
        }
        var sacrifice = i32.saturate(f64(health - self.living.max_health(lf) * 0.33f32))
        sacrifice -= (3 - self.difficulty) * 4
        if sacrifice < 0 {
            sacrifice = 0
        }
        return i32.saturate(f64(f32.nearest(sacrifice) + 3.0f32).floor())
    }

    // A cube mob's `getSoundPitch`: about 0.8, or 1.4 for a small one, from its own random.
    fn cube_pitch(mut self) -> f32 {
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        let adjust = if self.slime_size() <= 1 { 1.4f32 } else { 0.8f32 }
        return ((a - b) * 0.2f32 + 1.0f32) * adjust
    }

    /// Its hurt and death sounds, `getHurtSound` and `getDeathSound` (D416): its sound variant's,
    /// a baby's where it's one, a mooshroom's a cow's; a sheep's, a horse's, a baby horse's, a
    /// donkey's and a zombie horse's their own; a monster's its kind's; and a slime's, small where
    /// it's tiny, `isTiny`, of size 1 or less.
    pub fn hurt_and_death(self) -> (String, String) {
        let s = self.species
        if s == ENDER_DRAGON {
            // `EnderDragon.getHurtSound`, its death sound `LivingEntity`'s (D608).
            return (String("entity.ender_dragon.hurt"), String("entity.generic.death"))
        }
        if s == SLIME {
            let tiny = self.slime_size() <= 1
            return (String(if tiny { "entity.slime.hurt_small" } else { "entity.slime.hurt" }), String(if tiny { "entity.slime.death_small" } else { "entity.slime.death" }))
        }
        if s == ARMADILLO {
            // `Armadillo.getHurtSound`: reduced while it's scared (CAL-160).
            return (String(if self.scared() { "entity.armadillo.hurt_reduced" } else { "entity.armadillo.hurt" }), String("entity.armadillo.death"))
        }
        let horse = if self.baby() { "entity.baby_horse" } else { "entity.horse" }
        let stem = if s == VILLAGER { "entity.villager" } else if s == SHEEP { "entity.sheep" } else if s == DONKEY { "entity.donkey" } else if s == ZOMBIE_HORSE { "entity.zombie_horse" } else if s == HORSE { horse } else if s == ZOMBIE { "entity.zombie" } else if s == ZOMBIE_VILLAGER { "entity.zombie_villager" } else if s == SKELETON { "entity.skeleton" } else if s == SPIDER { "entity.spider" } else if s == CREEPER { "entity.creeper" } else if s == ENDERMAN { "entity.enderman" } else if s == WITCH { "entity.witch" } else if s == ENDERMITE { "entity.endermite" } else { "" }
        if stem != "" {
            return ("{stem}.hurt", "{stem}.death")
        }
        var chosen: SoundSet? = none
        if let v = self.sounds {
            chosen = some(v.set_of(self.sound_variant, self.baby()))
        }
        if let set = chosen {
            return (set.hurt.copy(), set.death.copy())
        }
        return (String("entity.cow.hurt"), String("entity.cow.death"))
    }

    // `baseTick` as a mob has it (D424): `Living`'s, hurt as it goes, `hurt_self`: below the
    // level, by 4 of `out_of_world`, `onBelowWorld`; and drowning, by 2 of `drown`, where water
    // breathing, conduit power and the breath of the nautilus don't let it breathe, and the
    // nautilus's keeps its air from coming back but with one of the others, `MobEffectUtil`.
    // And in a wall, by 1 of `in_wall`, before its air (D425). Burning, by 1 of `on_fire` every 20
    // ticks of its fire out of lava, before all (D434). An enderman each hurts teleports then,
    // `hurt_teleport`, as `Enderman.hurtServer` does, before what it draws for its ambient sound
    // (CAL-159).
    fn base_tick<B: CollisionBlocks + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        // `SwingState.tick` (CAL-159): its swing's ticks counted, gone once past its length.
        if self.swing_duration >= 0 {
            let was = self.swing_ticks
            self.swing_ticks += 1
            if was > self.swing_duration {
                self.swing_duration = -1
            }
        }
        // `LivingEntity.baseTick`'s first: on its first tick, where it was saved asleep, put on its
        // bed, `setPosToBed`, or got up where that's no bed (CAL-160).
        if self.living.body.first_tick {
            if let at = self.living.sleeping {
                let (bx, by, bz) = at
                match bed_sleep_height(f, m, blocks, bx, by, bz) {
                    some(h) => self.put_on_bed(bx, by, bz, h),
                    none => self.wake_now(f, m, blocks, sounds),
                }
            }
        }
        // Its way through the nether portal it's in, what it saves then its level's to take on
        // (D578), or the end gateway, within its level (D594).
        if let p = self.living.entity_tick_portal(lf) {
            if p.gateway {
                if let done = self.living.gateway_goes(p, blocks) {
                    self.living.show(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.living.body.travel(p, saved)
                self.living.show(Shown.Travel(way), sounds.len())
            }
        }
        if self.living.entity_tick_on(f, t, blocks, fast_lava, mut sounds) {
            self.hurt_self(lf, blocks, items, "on_fire", 1.0f32, mut sounds)
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
        }
        if self.living.body.y < f64(min_y - 64) {
            self.hurt_self(lf, blocks, items, "out_of_world", 4.0f32, mut sounds)
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
        }
        self.living.entity_tick_end()
        if self.living.alive() {
            if self.living.in_wall(f, m, lf, blocks) {
                self.hurt_self(lf, blocks, items, "in_wall", 1.0f32, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
            let breathing = self.living.has_effect(WATER_BREATHING) or self.living.has_effect(CONDUIT_POWER)
            let nautilus = self.living.has_effect(BREATH_OF_THE_NAUTILUS)
            if self.living.breathe(f, t, blocks, lf, breathing or nautilus, not nautilus or breathing, sounds.len()) {
                self.hurt_self(lf, blocks, items, "drown", 2.0f32, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
        }
        let removing = not self.living.body.removed
        self.living.living_tick_end(sounds.len(), players)
        if self.species == ENDER_DRAGON and self.living.dead_or_dying() {
            self.dragon_death(sounds.len())
        }
        if removing and self.living.body.removed {
            // `triggerOnDeathMobEffects`, as `tickDeath` takes it out killed (CAL-163).
            for id in [OOZING, WEAVING, WIND_CHARGED] {
                if self.living.has_effect(id) {
                    self.living.show(Shown.Missing(String("What the oozing, weaving and wind charged effects do as a mob dies")), sounds.len())
                    break
                }
            }
            // `Slime.remove` (D430).
            if self.species == SLIME {
                self.split(sounds.len())
            }
        }
        self.tick_effects(lf, f, m, blocks, items, mut sounds)
        self.living.turns_end()
    }

    // `AbstractCubeMob.remove` of a slime taken out dying, `heard` the sounds of its tick so far
    // (D430): one bigger than 1 splits into 2 to 4, `getSplitCount`, drawn from its random, each
    // of half its size, set apart by half its width, at its place and half a block up, facing
    // where its random draws for each, `setUpSplitCube`; made by its level, `Shown.Split`, as
    // `convertTo` makes them, with what `convertCommon` takes from it.
    fn split(mut self, heard: usize) {
        let size = self.slime_size()
        if size <= 1 or not self.living.dead_or_dying() {
            return
        }
        let spacing = self.width / 2.0f32
        let count = 2 + self.living.body.random.next_int_below(3)
        var places = List<(f64, f64, f64, f32)>()
        for i in 0..count {
            let xd = (f32.nearest(i % 2) - 0.5f32) * spacing
            let zd = (f32.nearest(i / 2) - 0.5f32) * spacing
            let yaw = self.living.body.random.next_float() * 360.0f32
            places.push((self.living.body.x + f64(xd), self.living.body.y + 0.5, self.living.body.z + f64(zd), yaw))
        }
        let split = Split { species: self.species, kind: self.living.kind, size: size / 2, places: places, common: self.common() }
        self.living.show(Shown.Split(split), heard)
    }

    // What `ConversionType.convertCommon` takes from it to what it's made into (D430).
    fn common(self) -> Common {
        var extras = JavaHashMap<String, Tag>()
        for key in ["CustomName", "CustomNameVisible", "Silent", "Tags", "data"] {
            if self.living.body.extras.contains(key) {
                extras.insert(String(key), self.living.body.extras[key].copy())
            }
        }
        return Common { absorption: self.living.absorption, effects: self.living.effects.copy(), left_handed: self.left_handed(), no_ai: self.no_ai(), persistent: self.persistence_required, name_visible: self.living.data.flag(CUSTOM_NAME_VISIBLE), on_fire: self.living.body.fire > 0, invulnerable: self.living.body.invulnerable, invulnerable_time: self.living.invulnerable_time, no_gravity: self.living.body.no_gravity, portal_cooldown: self.living.body.portal_cooldown, silent: self.living.data.flag(SILENT), extras: extras }
    }

    /// `ConversionType.convertCommon` onto it of what `c` took from the mob it's made of (D430):
    /// its absorption; its effects, each added, `add_effect` (CAL-163); its hands, AI, staying,
    /// name's showing, burning flag, invulnerability and cooldown, gravity, portal cooldown,
    /// silence, tags, custom name and custom data. Its team, which comes with the scoreboard's
    /// teams, isn't kept. An effect's sound as it's added, which only the omens make, isn't heard.
    pub fn convert_from(mut self, lf: LivingFacts, c: Common) {
        self.living.absorption = c.absorption
        var unheard = List<EntitySound>()
        for e in c.effects {
            _ = self.add_effect(lf, e.copy(), mut unheard)
        }
        if not unheard.is_empty() {
            self.living.show(Shown.Missing(String("The sound of an omen's effect added to a mob converted")), 0)
        }
        self.set_flag(LEFT_HANDED_FLAG, c.left_handed)
        self.set_flag(NO_AI_FLAG, c.no_ai)
        if c.persistent {
            self.persistence_required = true
        }
        self.living.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(c.name_visible))
        self.living.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, c.on_fire)
        self.living.body.invulnerable = c.invulnerable
        self.living.invulnerable_time = c.invulnerable_time
        self.living.body.no_gravity = c.no_gravity
        self.living.data.set(NO_GRAVITY, Value.Bool(c.no_gravity))
        self.living.body.portal_cooldown = c.portal_cooldown
        self.living.data.set(SILENT, Value.Bool(c.silent))
        for (k, v) in c.extras {
            self.living.body.extras.insert(k.copy(), v.copy())
        }
    }

    // A hurt in its own tick, `hurtServer` of `amount` of the damage type `name` with nothing
    // causing it (D424): as `hurt` has it; where it took the whole of it, its damage event to
    // those who see it, before its sound; where it dies, `die_here`; then what its kind does
    // after, `after_hurt`. What its enchanted equipment does against it is its level's, `ward`
    // (D439). What's missing is said after its tick.
    fn hurt_self<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, name: str, amount: f32, sounds: mut List<EntitySound>) {
        _ = self.hurt_self_was(lf, blocks, items, name, amount, mut sounds)
    }

    // The hurt of a fall its move found, `causeFallDamage`'s `hurt` (CAL-159): `hurt_self`'s, its
    // sounds and what it shows put where vanilla deals it, after the fall's sounds, before what
    // the rest of its move heard and showed.
    fn fall_hurt<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let fall = self.living.fall_hurt.take() else return
        var later = List<EntitySound>()
        while sounds.len() > fall.heard {
            if let s = sounds.pop() {
                later.push(s)
            }
        }
        var shown_later = List<Shown>()
        var after_later = List<usize>()
        while self.living.shown.len() > fall.shown {
            if let w = self.living.shown.pop() {
                shown_later.push(w)
            }
            if let a = self.living.shown_after.pop() {
                after_later.push(a)
            }
        }
        let start = sounds.len()
        self.hurt_self(lf, blocks, items, if fall.stalagmite { "stalagmite" } else { "fall" }, fall.amount, mut sounds)
        let added = sounds.len() - start
        while let s = later.pop() {
            sounds.push(s)
        }
        while let w = shown_later.pop() {
            let a = after_later.pop() ?? fall.heard
            self.living.show(w, a + added)
        }
    }

    // `hurt_self`, and whether it was hurt, as `hurtServer` says (D434).
    fn hurt_self_was<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, name: str, amount: f32, sounds: mut List<EntitySound>) -> bool {
        let d = Damage.of(lf.damage, name)
        let before = sounds.len()
        let now = self.game_time
        let hard = self.hard
        var missing = List<String>()
        let ward = self.ward(blocks, items, lf.damage, d, none, mut missing)
        let h = self.hurt(lf, lf.damage, d, amount, now, ward, mut sounds, mut missing)
        if h.hurt and h.full {
            self.living.show(Shown.Damaged(d.kind), before + h.early)
        }
        // A totem's save, after what it played (D518).
        if h.totem {
            self.living.show(Shown.Event(35i8), sounds.len())
        }
        if h.dies {
            self.die_here(items, d, sounds.len())
        }
        // Reinforcements called in its own tick, where the level's random's draws would come
        // among its other ticks', come later.
        if self.after_hurt(h, hard, d) != none {
            missing.push(String("Zombie reinforcements called in a zombie's own tick"))
        }
        for m in missing {
            self.living.show(Shown.Missing(m.copy()), sounds.len())
        }
        return h.hurt
    }

    // What it's inside and what that does to it, as `applyEffectsFromBlocks` goes on after `stepOn`
    // (D434): where blocks act on it, the blocks it went into along its moves this tick,
    // `inside_blocks`, while it's alive, each block's at once, a campfire's and a cactus's hurts
    // its own, `hurt_self`, and its fluid's; then the effects they put on it in their order, fire's
    // and lava's hurts its own, lava's heard where it hurt, `generic.burn`, its pitch drawn, unless
    // it's silent; then the rain, and its fire's end, `after_inside`.
    fn inside_walk<B: CollisionBlocks + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let moves = self.living.final_moves()
        if self.living.body.removed or self.living.body.no_physics {
            return
        }
        let was = self.living.fire_before()
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.living.body.width, self.living.body.height) {
            if not self.living.alive() {
                break
            }
            if i.block {
                c.advance(i.step)
                match self.living.touch(f, i, mut c) {
                    Touched.Campfire(amount) => self.hurt_self(lf, blocks, items, "campfire", amount, mut sounds),
                    Touched.Cactus => self.hurt_self(lf, blocks, items, "cactus", 1.0f32, mut sounds),
                    Touched.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                    Touched.Portal((px, py, pz)) => {
                        // Gone into where it's not asleep, `canUsePortal` (D578).
                        if self.living.sleeping == none {
                            self.living.body.inside_portal(px, py, pz, PORTAL_DELAY, false)
                        }
                    },
                    Touched.EndPortal((px, py, pz)) => {
                        if self.living.sleeping == none {
                            self.living.body.inside_portal(px, py, pz, PORTAL_DELAY, true)
                        }
                    },
                    Touched.Gateway(g) => {
                        // Gone into where it may go through it, `canUsePortal`, and the
                        // gateway's open, its cooldown then begun by its level (D594).
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if self.living.alive() and self.living.sleeping == none and blocks.gateway_open(gx, gy, gz) {
                            self.living.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.living.show(Shown.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    Touched.Nothing => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if not self.living.alive() {
                break
            }
            match e {
                BlockEffect.Apply(kind) => self.living.apply_effect(kind, 0),
                BlockEffect.InFire(amount) => self.hurt_self(lf, blocks, items, "in_fire", amount, mut sounds),
                BlockEffect.LavaHurt => {
                    if not self.living.fire_immune and self.hurt_self_was(lf, blocks, items, "lava", 4.0f32, mut sounds) and not self.living.silent() {
                        let pitch = 2.0f32 + self.living.body.random.next_float() * 0.4f32
                        self.living.play(mut sounds, String("entity.generic.burn"), 0.4f32, pitch)
                    }
                },
                BlockEffect.Doused(_) => {
                    if self.living.on_fire() {
                        self.living.show(Shown.Missing(doused()), sounds.len())
                    }
                },
            }
        }
        let rained = self.living.body.in_rain(blocks)
        self.living.after_inside(was, rained, mut sounds)
    }

    // `PanicGoal.lookForWater`, as a burning mob panics (D434): where nothing it collides with is
    // in its block, the first block holding water by how far it is, up to 5 across and 1 up or
    // down, `findBlocksInBoxByManhattanDistance`, each step out x, then y, then z first south then
    // north.
    fn look_for_water<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B) -> (i32, i32, i32)? {
        let (ox, oy, oz) = self.living.body.block()
        let here = blocks.collision_state(ox, oy, oz) ?? 0
        if not m.state_boxes(f, here, ox, oy, oz, self.living.body.mover()).is_empty() {
            return none
        }
        let (reach_xz, reach_y) = (5, 1)
        for depth in 0..=(reach_xz + reach_y + reach_xz) {
            let most_x = reach_xz.min(depth)
            for x in -most_x..=most_x {
                let most_y = reach_y.min(depth - x.abs())
                for y in -most_y..=most_y {
                    let z = depth - x.abs() - y.abs()
                    if z > reach_xz {
                        continue
                    }
                    if water_at(f, blocks, ox + x, oy + y, oz + z) {
                        return some((ox + x, oy + y, oz + z))
                    }
                    if z != 0 and water_at(f, blocks, ox + x, oy + y, oz - z) {
                        return some((ox + x, oy + y, oz - z))
                    }
                }
            }
        }
        return none
    }

    /// `die` of the damage `d` from outside its tick, as an arrow kills it (CAL-159): as in its own
    /// tick, `die_here`, what's left to its level shown, `Shown.Died`, for the caller to take.
    pub fn die_outside<W: Wearing>(mut self, items: W, d: Damage) {
        self.die_here(items, d, 0)
    }

    /// Whether it's pickable, `isPickable`, which a projectile or a spear may hit: not an ender
    /// dragon, whose parts are hit in its place, `EnderDragon` (D610).
    pub fn pickable(self) -> bool {
        return self.species != ENDER_DRAGON
    }

    /// `handleKillingBlow`, as `die` has it (D416): it's died, `Living.killed`; but an ender
    /// dragon's, `EnderDragon`'s, where it doesn't sit, leaves its health 1 and has it dying,
    /// `DYING`, which its flight takes on, and where it sits does nothing, not even dead, `dead`
    /// (D608).
    pub fn killing_blow(mut self) {
        if self.species != ENDER_DRAGON {
            self.living.killed()
            return
        }
        let sitting = match self.dragon {
            some(dr) => dr.sitting(),
            none => true,
        }
        if not sitting {
            self.living.data.set(HEALTH, Value.Float(1.0f32))
            self.set_dragon_phase(DYING)
        }
    }

    // `die` in its own tick, of the damage `d`, `heard` the sounds of its tick so far (D424): it's
    // died, `killed`; where it isn't a baby and mob drops are on, its loot table's, which its
    // level rolls, and what it wears and holds that it drops, `dropCustomDeathLoot`, drawn now;
    // where a player hurt it lately too, its experience, its reward drawn now, `dropExperience`;
    // what's left to its level shown, `Shown.Died`; then it lies dying.
    fn die_here<W: Wearing>(mut self, items: W, d: Damage, heard: usize) {
        self.killing_blow()
        let killed_by_player = self.living.hurt_by_player_memory > 0
        let drops = not self.baby() and self.mob_drops
        var death = Death { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, damage: d.kind, uuid: some(self.living.body.uuid), this: some(self.loot_entity()), by_player: d.player }
        if killed_by_player {
            death.killed_by = self.living.hurt_by_player
        }
        if drops {
            death.loot = some(self.death_loot())
            death.equipment = self.equipment_drops(items, killed_by_player, List<f32>())
            death.carried = self.carried()
            if killed_by_player {
                death.reward = self.experience_reward()
            }
        }
        self.living.show(Shown.Died(death), heard)
        self.living.lie_dying()
    }

    /// `hurtServer` of `amount` of the damage `d` of `types` at the game time `now` (D416):
    /// `LivingEntity`'s, its idle time back to 0 where it got past its first checks; an animal's
    /// love ended as it's hurt, `Animal.actuallyHurt`; then its death sound, or its hurt sound
    /// after which its ambient sound waits, `resetAmbientSoundTime`, each as loud as its sounds
    /// and its voice's pitch drawn. Its death, `die`, is its level's, then `after_hurt`. What its
    /// enchanted equipment does against it is `ward`'s (D439). An enderman a projectile would hurt
    /// isn't, but dodges it, `dodge`, as its level has it (CAL-159). A totem saving it is
    /// `hurt_server`'s, neither its death sound nor its hurt sound heard then (D518); what's
    /// missing is said in `missing`.
    pub fn hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        if self.species == ENDER_DRAGON {
            // `EnderDragon.hurtServer`: through its body (D608).
            return self.dragon_hurt(lf, types, d, amount, now, ward, BODY, mut sounds, mut missing)
        }
        return self.hurt_as_living(lf, types, d, amount, now, ward, mut sounds, mut missing)
    }

    // `EnderDragon.hurt` of `amount` of the damage `d` of `types` through its part `part` (D608):
    // nothing while it's dying, `DYING`; its phase's say first, `onHurt`, a sitting phase's none
    // of an arrow's or a wind charge's, which it says is missing as it would set the arrow alight;
    // through any part but its head and neck, a quarter of it and up to 1 more; nothing under
    // 0.01. Caused by a player, or an explosion, `#always_hurts_ender_dragons`, it's hurt as any
    // mob is, `reallyHurt`, without knockback where it sits; sitting, what it lost counted, and
    // past a quarter of its most it takes off, the count gone. Hurt or not, past 0.01 it says it
    // was.
    fn dragon_hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, part: usize, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        let dr = self.dragon.copy() else return Hurt()
        if dr.phase == DYING {
            return Hurt()
        }
        var damage = amount
        let shot = d.kind == types.id("arrow") or d.kind == types.id("trident") or d.kind == types.id("wind_charge")
        if sits(dr.phase) and dr.phase != HOVERING and shot {
            missing.push(String("An arrow or wind charge a sitting ender dragon sets alight"))
            damage = 0.0f32
        }
        if part != HEAD and part != NECK {
            damage = damage / 4.0f32 + damage.min(1.0f32)
        }
        if damage < 0.01f32 {
            return Hurt()
        }
        if d.player == none and not types.is(d.kind, IS_EXPLOSION) {
            var said = Hurt()
            said.hurt = true
            return said
        }
        let before = self.living.health()
        self.living.knock_proof = sits(dr.phase)
        var h = self.hurt_as_living(lf, types, d, damage, now, ward, mut sounds, mut missing)
        h.hurt = true
        if sits(dr.phase) {
            var now_dr = self.dragon.take() else return h
            now_dr.sitting_damage = now_dr.sitting_damage + before - self.living.health()
            let quarter = 0.25f32 * self.living.max_health(lf)
            let up = now_dr.sitting_damage > quarter
            if up {
                now_dr.sitting_damage = 0.0f32
            }
            self.dragon = some(now_dr)
            if up {
                self.set_dragon_phase(TAKEOFF)
            }
        }
        return h
    }

    /// An ender dragon's phase set, `EnderDragonPhaseManager.setPhase` (D608): where it isn't its
    /// phase already, its phase, shown, `DATA_PHASE`; and whether it takes knockback, as it sits
    /// or not. A phase's `begin` and `end` change only what its flight keeps, which isn't Calcite's
    /// yet.
    pub fn set_dragon_phase(mut self, phase: i32) {
        var dr = self.dragon.take() else return
        if dr.phase != phase {
            dr.begin(phase)
            self.living.data.set(DRAGON_PHASE, Value.Number(phase))
        }
        self.living.knock_proof = dr.sitting()
        self.dragon = some(dr)
    }

    // `EnderDragon.aiStep` (D608), in place of a mob's, `heard` the sounds of its tick so far:
    // dying, three floats drawn for its explosions' place, which only clients show; else its
    // crystals, `checkCrystals`: the one it had, where it isn't gone, healing it a point each
    // 10th tick it's hurt, and 1 in 10, drawn, the nearest its level found for it taken; then its
    // turn wrapped, `wrapDegrees`. Without AI its wings stay at the top of their beat, which shows
    // nothing, and that's all. With AI (D611), its height and turn kept in its flight's history;
    // its phase's tick, a hover's held where it first was, the other phases not Calcite's yet,
    // said missing; its flight toward its phase's target, `Dragon.fly`, which no blocks touch, as
    // it has no physics, `isAffectedByBlocks`; its body turned as it's turned; its parts placed,
    // what its wings and head reach kept for its level where it wasn't hurt lately; and the walls
    // its head, neck and body are in, `checkWalls`. Its wings' flap, `processFlappingMovement`, is
    // a game event no one hears; its dragon fight, which a summoned dragon hasn't, isn't told.
    fn dragon_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, heard: usize) {
        var dr = self.dragon.take() else return
        if self.living.dead_or_dying() {
            for _ in 0..3 {
                _ = self.living.body.random.next_float()
            }
            self.dragon = some(dr)
            return
        }
        if dr.nearest_crystal != none {
            if dr.crystal_gone {
                dr.nearest_crystal = none
            } else if self.living.body.tick_count % 10 == 0 and self.living.health() < self.living.max_health(lf) {
                let more = self.living.health() + 1.0f32
                self.living.set_health(lf, more)
            }
        }
        if self.living.body.random.next_int_below(10) == 0 {
            dr.nearest_crystal = dr.found_crystal
        }
        self.living.body.y_rot = wrap_degrees(self.living.body.y_rot)
        if self.no_ai() {
            self.dragon = some(dr)
            return
        }
        dr.record(self.living.body.y, self.living.body.y_rot)
        if dr.phase != HOVERING {
            self.dragon = some(dr)
            self.living.show(Shown.Missing(String("An ender dragon's flight in a phase other than its hover")), heard)
            return
        }
        // `DragonHoverPhase.doServerTick`: held where it is as its hover first ticks.
        if dr.hover_target == none {
            dr.hover_target = some((self.living.body.x, self.living.body.y, self.living.body.z))
        }
        if let target = dr.hover_target {
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            let (vx, vy, vz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
            let went = dr.fly(Flight { x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, y_rot: self.living.body.y_rot }, target)
            self.living.body.x = went.x
            self.living.body.y = went.y
            self.living.body.z = went.z
            self.living.body.vx = went.vx
            self.living.body.vy = went.vy
            self.living.body.vz = went.vz
            self.living.body.y_rot = went.y_rot
            self.living.body.horizontal_collision = false
            self.living.body.vertical_collision = false
            self.living.body.vertical_below = false
        }
        self.living.y_body_rot = self.living.body.y_rot
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        dr.place_parts(x, y, z, self.living.body.y_rot, self.living.hurt_time <= 0)
        dr.in_wall = self.dragon_walls(lf, f, blocks, dr, heard)
        self.dragon = some(dr)
    }

    // `EnderDragon.checkWalls` on the boxes of its head, neck and body in turn, each looked at
    // (D611): a block in one that isn't air or `#dragon_transparent` it breaks where mob griefing's
    // on and it isn't `#dragon_immune`, which Calcite doesn't do yet, said missing; else it's a
    // wall it's in, which slows it. A block whose chunk isn't loaded, which vanilla's would load,
    // is said missing too.
    fn dragon_walls<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, dr: Dragon, heard: usize) -> bool {
        var hit = false
        var breaks = false
        var unloaded = false
        for k in [HEAD, NECK, BODY] {
            let b = dr.boxed(k)
            let (x0, y0, z0) = (i32.saturate(b.min_x.floor()), i32.saturate(b.min_y.floor()), i32.saturate(b.min_z.floor()))
            let (x1, y1, z1) = (i32.saturate(b.max_x.floor()), i32.saturate(b.max_y.floor()), i32.saturate(b.max_z.floor()))
            for x in x0..=x1 {
                for y in y0..=y1 {
                    for z in z0..=z1 {
                        let state = blocks.collision_state(x, y, z) else {
                            unloaded = true
                            continue
                        }
                        if f.is_air(state) or f.in_set(state, lf.dragon_transparent) {
                            continue
                        }
                        if self.mob_griefing and not f.in_set(state, lf.dragon_immune) {
                            breaks = true
                        } else {
                            hit = true
                        }
                    }
                }
            }
        }
        if breaks {
            self.living.show(Shown.Missing(String("An ender dragon's breaking of the blocks it flies into")), heard)
        }
        if unloaded {
            self.living.show(Shown.Missing(String("An ender dragon's flight into a chunk not loaded")), heard)
        }
        return hit
    }

    // `EnderDragon.tickDeath` (D608), `heard` the sounds of its tick so far: its death a tick on;
    // from its 180th to its 200th, three floats drawn for its big explosions' place, which only
    // clients show; past its 150th, each 5th where mob drops are on, 8 in 100 of its experience,
    // 500, given where it is, `ExperienceOrb.award`; at its first, unless it's silent, level event
    // 1028 at its block for every player, `globalLevelEvent`; then it and its parts lifted a tenth
    // of a block, as it has no physics; and at its 200th, where mob drops are on, a fifth of its
    // experience given, and it's gone, `remove(KILLED)`. Its dragon fight, which a summoned dragon
    // hasn't, isn't told yet.
    fn dragon_death(mut self, heard: usize) {
        var dr = self.dragon.take() else return
        dr.death_time += 1
        let t = dr.death_time
        if t >= 180 and t <= 200 {
            for _ in 0..3 {
                _ = self.living.body.random.next_float()
            }
        }
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        if t > 150 and t % 5 == 0 and self.mob_drops {
            let some_of = i32.saturate(f64(f32.nearest(DEATH_EXPERIENCE) * 0.08f32).floor())
            self.living.show(Shown.Awarded((x, y, z, some_of)), heard)
        }
        if t == 1 and not self.living.silent() {
            let (bx, by, bz) = (i32.saturate(x.floor()), i32.saturate(y.floor()), i32.saturate(z.floor()))
            self.living.show(Shown.Global((1028, bx, by, bz, 0)), heard)
        }
        let lift = f64(0.1f32)
        self.living.body.y = y + lift
        dr.move_parts(0.0, lift, 0.0)
        if t >= 200 {
            if self.mob_drops {
                let fifth = i32.saturate(f64(f32.nearest(DEATH_EXPERIENCE) * 0.2f32).floor())
                let (fx, fy, fz) = (self.living.body.x, self.living.body.y, self.living.body.z)
                self.living.show(Shown.Awarded((fx, fy, fz, fifth)), heard)
            }
            self.living.body.removed = true
        }
        self.dragon = some(dr)
    }

    // `hurtServer` as any mob has it, `LivingEntity`'s and its kind's, as `hurt` tells.
    fn hurt_as_living(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        let start = sounds.len()
        let invulnerable = self.living.invulnerable_to(types, d, self.living.fire_immune, ward.immune)
        if self.species == ENDERMAN and not invulnerable and types.is(d.kind, IS_PROJECTILE) {
            // `Enderman.hurtServer`: not a passenger, as none are yet, it dodges, not hurt, nor
            // `LivingEntity.hurtServer`'s at all, so its idle time goes on.
            self.dodge_due = true
            return Hurt()
        }
        if self.living.has_effect(INFESTED) {
            missing.push(String("The infested effect's silverfish as a mob's hurt, onMobHurt"))
        }
        let fire_resistant = self.living.has_effect(FIRE_RESISTANCE)
        let shrugged = invulnerable or self.living.dead_or_dying() or (types.is(d.kind, IS_FIRE) and fire_resistant)
        if not shrugged and self.living.sleeping != none {
            // `hurtServer` wakes it, and its death would, getting it up where the blocks around
            // it have room, which a hurt doesn't see yet (CAL-160).
            missing.push(String("A sleeping mob woken by a hurt, stopSleeping"))
        }
        if not shrugged {
            self.no_action_time = 0
        }
        let immune = self.living.fire_immune
        var dealt = amount
        if self.species == ARMADILLO {
            // `Armadillo.hurtServer`: scared, a point less and halved; and its `actuallyHurt`,
            // where it has its AI, isn't scared and can stay rolled up, stopping it as a living
            // entity's hurt rolls it up, before its knockback (CAL-160).
            if self.scared() {
                dealt = (amount - 1.0f32) / 2.0f32
            }
            let by_living = d.player != none or d.living_cause
            self.living.still_on_hurt = by_living and not self.no_ai() and not self.scared() and self.can_stay_rolled_up()
        }
        var h = self.living.hurt_server(lf, types, d, dealt, now, fire_resistant, immune, ward, mut sounds, mut missing)
        self.living.still_on_hurt = false
        if h.actually and self.species == ARMADILLO {
            // Its rolling up's sound, in `actuallyHurt`, before its damage event.
            self.armadillo_hurt(types, d, h.stilled, mut sounds)
            h.early = sounds.len() - start
        }
        if h.actually and self.animal {
            self.in_love = 0
        }
        if self.species == VILLAGER and h.hurt and not types.is(d.kind, NO_ANGER) and (d.player != none or d.living_cause) {
            // `resolveMobResponsibleForDamage`, its `setLastHurtByMob`: a villager hears 25 minor
            // negative gossip of what hurt it, `onReputationEvent`, its offers priced again where
            // that's the player it's trading with, and shows its anger at a player that's alive,
            // entity event 13, before its damage event (CAL-160).
            if let who = d.player {
                self.gossips.add(who, MINOR_NEGATIVE, 25)
                // Its offers priced again where it's trading with them, sent to them.
                if let t = self.trading {
                    if t.uuid == who {
                        self.update_special_prices(who)
                        h.repriced = true
                    }
                }
                h.angry = self.living.alive()
            } else {
                missing.push(String("A villager's gossip of a mob that hurt it"))
            }
        }
        let (hurt_sound, death_sound) = self.hurt_and_death()
        if h.dies {
            if h.full {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, death_sound, self.sound_volume, pitch)
                self.thorns_hit(types, d, mut sounds)
            }
        } else if h.hurt_sound {
            self.ambient_sound_time = -self.ambient_interval
            let pitch = self.voice_pitch()
            self.living.play(mut sounds, hurt_sound, self.sound_volume, pitch)
            self.thorns_hit(types, d, mut sounds)
        }
        if self.species == ENDERMAN and not invulnerable and not d.living_cause and d.player == none {
            // `Enderman.hurtServer`'s last: by no living entity, neither a mob nor a player, it
            // teleports 9 in 10, drawn, where it has its blocks, `hurt_teleport` (CAL-159).
            if self.living.body.random.next_int_below(10) != 0 {
                self.teleport_due = true
            }
        }
        return h
    }

    // `Armadillo.actuallyHurt`'s, after the hurt's dealt, where it has its AI and isn't dying
    // (CAL-160): hurt by a living entity, danger seen for 80 ticks and, where it can stay rolled
    // up, rolled up, already still where `stilled`; else by what's `#panic_environmental_causes`,
    // rolled out. Its roll's heard before its hurt.
    fn armadillo_hurt(mut self, types: DamageTypes, d: Damage, stilled: bool, sounds: mut List<EntitySound>) {
        if self.no_ai() or self.living.dead_or_dying() {
            return
        }
        if d.player != none or d.living_cause {
            if let held = self.brain.take() {
                var brain = held
                brain.set_for(MEMORY_DANGER_DETECTED_RECENTLY, Memo.Flag(true), 80)
                self.brain = some(brain)
            }
            if self.can_stay_rolled_up() {
                self.roll_up(not stilled, mut sounds)
            }
        } else if types.is(d.kind, PANIC_ENVIRONMENTAL_CAUSES) {
            self.roll_out(mut sounds)
        }
    }

    // `playSecondaryHurtSound`, after its hurt or death sound: hurt by `thorns`, thorns' hit where
    // it is, heard as hostile whatever it is, and where it's silent, as the level plays it
    // (CAL-159).
    fn thorns_hit(self, types: DamageTypes, d: Damage, sounds: mut List<EntitySound>) {
        if d.kind == types.id("thorns") {
            sounds.push(EntitySound { sound: String("enchant.thorns.hit"), x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 1.0f32, pitch: 1.0f32, source: HOSTILE_SOURCE })
        }
    }

    /// `repeatedlyTryToTeleport`, where a projectile's hurt left an enderman to dodge it (CAL-159):
    /// up to 64 of its teleports drawn, `teleport()`, till one works, `min_y` its level's floor.
    /// Whether it was to.
    pub fn dodge<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if not self.dodge_due {
            return false
        }
        self.dodge_due = false
        for _ in 0..64 {
            if self.teleport(lf, f, m, blocks, min_y, mut sounds) {
                break
            }
        }
        return true
    }

    // The teleport an enderman's hurt drew, `Enderman.teleport()`, done, and a dodge its level
    // didn't do (CAL-159).
    fn hurt_teleport<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, sounds: mut List<EntitySound>) {
        let floor = self.floor_y
        _ = self.dodge(lf, f, m, blocks, floor, mut sounds)
        if self.teleport_due {
            self.teleport_due = false
            _ = self.teleport(lf, f, m, blocks, floor, mut sounds)
        }
    }

    /// What what it wears and holds does against the damage `d` of `types`, enchanted, as its level
    /// `blocks` works it out, `Living.ward` (D439), itself to loot as it is, and `attacker`, a
    /// player, where that caused it and dealt it.
    pub fn ward<B: Warding, W: Wearing>(self, blocks: B, items: W, types: DamageTypes, d: Damage, attacker: LootEntity?, missing: mut List<String>) -> Ward {
        return self.living.ward(blocks, items, types, d, self.loot_entity(), attacker, mut missing)
    }

    /// What its kind does after `LivingEntity.hurtServer`, its death's draws done, where `h` hurt
    /// it by `source`, on hard or not (D416): a horse stands 1 in 3, drawn, `standIfPossible`; and
    /// on hard a zombie with a target, or hurt by what's living, its target then, draws for its
    /// reinforcements under their chance, `Zombie.hurtServer` (CAL-159). The target its
    /// reinforcements come for, for its level to call them, `world.natural`'s `reinforce`, where
    /// monsters may spawn; none where it calls none.
    pub fn after_hurt(mut self, h: Hurt, hard: bool, source: Damage) -> i32? {
        if h.hurt and self.equine() and self.living.body.random.next_int_below(3) == 0 {
            // `standIfPossible`, `setStanding(20)`.
            self.set_horse_flag(16, false)
            self.set_horse_flag(32, true)
            self.stand_counter = 20
        }
        let target = if let t = self.target { some(t) } else if source.player != none or source.living_cause { some(source.cause) } else { none }
        if h.hurt and hard and target != none and (self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER) {
            let chance = self.living.attributes.value(attribute("spawn_reinforcements"))
            if f64(self.living.body.random.next_float()) < chance {
                return target
            }
        }
        return none
    }

    /// `setTarget` of `target`, as a reinforcement takes it up before it's finalized (CAL-159).
    pub fn take_target(mut self, target: i32) {
        self.target_to(some(target))
    }

    /// A reinforcement it called, `callee`, as `Zombie.hurtServer` charges them once it's added
    /// (CAL-159): its own chance of calling more 0.05 less again, `reinforcement_caller_charge`,
    /// and the callee's a float's 0.05 less, `reinforcement_callee_charge`, both permanent.
    pub fn charge_reinforcement(mut self, callee: mut Mob) {
        let chance = attribute("spawn_reinforcements")
        let caller = Identifier { namespace: "minecraft", path: String("reinforcement_caller_charge") }
        let was = self.living.attributes.modifier_amount(chance, caller) ?? 0.0
        self.living.attributes.take_off(chance, caller)
        self.living.attributes.add_permanent(chance, Modifier { id: caller, amount: was - 0.05, operation: ADD_VALUE })
        let charged = Identifier { namespace: "minecraft", path: String("reinforcement_callee_charge") }
        callee.living.attributes.add_permanent(chance, Modifier { id: charged, amount: f64(-0.05f32), operation: ADD_VALUE })
    }

    /// The player who made it fall in love, `getLoveCause`, by their UUID, as it keeps them,
    /// `LoveCause` (CAL-164).
    pub fn love_cause(self) -> (i64, i64)? {
        return uuid_of(self.kept, "LoveCause")
    }

    /// What its death's loot reads of it, `THIS_ENTITY` (D416): its type, whether it's on fire and
    /// a baby, its main hand, a sheep's colour and shearing, a slime's size, and a villager's type
    /// (CAL-160); and where it is and what it wears and holds (CAL-164).
    pub fn loot_entity(self) -> LootEntity {
        var e = LootEntity { kind: String(type_name(self.species)), on_fire: self.living.body.fire > 0 or self.living.body.extras.contains("HasVisualFire"), baby: self.baby(), hand: self.living.equipment[0].copy(), at: some((self.living.body.x, self.living.body.y, self.living.body.z)), worn: self.living.equipment.copy() }
        if self.species == SHEEP {
            e.sheep_color = some(String(dye_name(self.color())))
            e.sheared = self.sheared()
        } else if self.species == SLIME {
            e.cube_size = self.slime_size()
        } else if self.species == VILLAGER {
            let (kind, _, _) = self.living.data.villager(OWN + 1)
            e.villager_type = some(builtin_name(23, kind))
        }
        return e
    }

    /// Whether a player's use of it with `item` in hand asks for its offers, `getOffers`, where
    /// they're still to make (CAL-160): a grown villager's, alive, not used with a villager spawn
    /// egg, which hasn't made them yet, as it makes them as they're first asked for.
    pub fn offers_asked(self, item: String) -> bool {
        return self.species == VILLAGER and self.living.alive() and item != "minecraft:villager_spawn_egg" and not self.baby() and not self.kept.contains("Offers")
    }

    /// The trade set its offers come from, `VillagerProfession.getTrades` of its level (CAL-160):
    /// its profession's for its level, 1 to 5, as `minecraft:farmer/level_1`; none for no
    /// profession or a nitwit, which have no trades.
    pub fn trade_set(self) -> String? {
        let (_, profession, level) = self.living.data.villager(OWN + 1)
        let name = builtin_name(24, profession)
        if name == "minecraft:none" or name == "minecraft:nitwit" or level < 1 or level > 5 {
            return none
        }
        return some("{name}/level_{level}")
    }

    /// What its offers' loot reads, `addOffersFromTradeSet` (CAL-160): `ORIGIN`, its place, and
    /// `THIS_ENTITY`, itself; and `ADDITIONAL_COST_COMPONENT_ALLOWED` (D522).
    pub fn trade_params(self) -> LootParams {
        var params = LootParams()
        params.origin = some((self.living.body.x, self.living.body.y, self.living.body.z))
        params.this_entity = true
        params.this = some(self.loot_entity())
        params.additional_cost = true
        return params
    }

    /// Its offers made, `updateTrades` into a list made new, each as `MerchantOffer.CODEC` writes
    /// it, which it saves under `Offers`, `Recipes`, an empty list left out (CAL-160).
    pub fn set_offers(mut self, offers: own List<Tag>) {
        var m = JavaHashMap<String, Tag>()
        if not offers.is_empty() {
            m.insert(String("Recipes"), Tag.List(offers))
        }
        self.kept.insert(String("Offers"), Tag.Compound(m))
    }

    // `updateSpecialPrices(player)` (CAL-160): each offer's special price 0 again,
    // `resetSpecialPrices`, then, where the player's reputation with it isn't 0, less by it times
    // the offer's multiplier, floored, `addToSpecialPriceDiff`. The hero of the village's
    // discount waits for players' effects (CAL-163).
    fn update_special_prices(mut self, player: (i64, i64)) {
        if not self.kept.contains("Offers") {
            return
        }
        let held = self.kept["Offers"].copy()
        let Tag.Compound(m) = held else return
        if not m.contains("Recipes") {
            return
        }
        let Tag.List(offers) = m["Recipes"] else return
        let reputation = self.gossips.reputation(player)
        var priced = List<Tag>()
        for t in offers {
            let Tag.Compound(o) = t else {
                priced.push(t.copy())
                continue
            }
            var offer = o.copy()
            var diff = 0
            if reputation != 0 {
                let multiplier = if offer.contains("priceMultiplier") { offer["priceMultiplier"].number_float() ?? 0.0f32 } else { 0.0f32 }
                diff -= i32.saturate(f64(f32.nearest(reputation) * multiplier).floor())
            }
            if diff == 0 {
                _ = offer.remove("specialPrice")
            } else {
                offer.insert(String("specialPrice"), Tag.Int(diff))
            }
            priced.push(Tag.Compound(offer))
        }
        var kept = m.copy()
        kept.insert(String("Recipes"), Tag.List(priced))
        self.kept.insert(String("Offers"), Tag.Compound(kept))
    }

    /// `startTrading` with the player of the entity ID `id` and the UUID `uuid` (CAL-160): its
    /// offers priced by their reputation with it, `updateSpecialPrices`, then they're the player
    /// it trades with, `setTradingPlayer`, its ambient sound a trade's. Their merchant menu's the
    /// level's to open, `openTradingScreen`.
    pub fn start_trading(mut self, id: i32, uuid: (i64, i64)) {
        self.update_special_prices(uuid)
        self.trading = some(Trader { id: id, uuid: uuid })
        self.refresh_sounds()
    }

    /// `stopTrading`, `setTradingPlayer(null)`, as their merchant menu's closed or it has no offers
    /// (CAL-160): no player it trades with, its ambient sound its own again. Its offers keep their
    /// prices till they're set again.
    pub fn stop_trading(mut self) {
        self.trading = none
        self.refresh_sounds()
    }

    /// Its offers, `getOffers`, each as `MerchantOffer.CODEC` writes it, as it saves them under
    /// `Offers` (CAL-160).
    pub fn offers(self) -> List<Tag> {
        if not self.kept.contains("Offers") {
            return List<Tag>()
        }
        let Tag.Compound(m) = self.kept["Offers"] else return List<Tag>()
        if not m.contains("Recipes") {
            return List<Tag>()
        }
        return match m["Recipes"] {
            Tag.List(each) => each.copy(),
            _ => List<Tag>(),
        }
    }

    /// The translation key of its type's name, `getTypeName`, where it isn't its type's own: a
    /// villager's its profession's, as `entity.minecraft.villager.farmer` (CAL-160).
    pub fn type_name_key(self) -> String? {
        if self.species != VILLAGER {
            return none
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let name = builtin_name(24, profession)
        let at = name.find(":") ?? 0
        return some("entity.{name[..at]}.villager.{name[at + 1..]}")
    }

    /// A villager's level, its data's, which its merchant menu shows (CAL-160).
    pub fn villager_level(self) -> i32 {
        let (_, _, level) = self.living.data.villager(OWN + 1)
        return level
    }

    /// `AbstractVillager.notifyTradeUpdated` (CAL-160): where 20 ticks have gone by since its
    /// ambient sound's timer was put back, it's put back, and it says yes where its trading
    /// player's payments buy something, else no.
    pub fn trade_updated(mut self, valid: bool, sounds: mut List<EntitySound>) {
        if self.ambient_sound_time > -self.ambient_interval + 20 {
            self.ambient_sound_time = -self.ambient_interval
            self.make_sound(mut sounds, if valid { "entity.villager.yes" } else { "entity.villager.no" })
        }
    }

    /// `AbstractVillager.notifyTrade` of its offer at `index` (CAL-160): the offer's uses up one,
    /// `increaseUses`, its ambient sound's timer put back, then `Villager.rewardTradeXp`: the
    /// orb's experience drawn, 3 to 6, from its own random, its experience up by the offer's, the
    /// player it trades with the one it last traded with, and where that's enough for its level,
    /// a level up, `increaseMerchantCareer`, and 5 more for the orb. The regeneration a level-up
    /// gives waits for mobs' effects (CAL-163), and the trade's advancement trigger for
    /// advancements.
    pub fn notify_trade(mut self, index: i32) -> TradeReward {
        var out = TradeReward()
        var offers = self.offers()
        if index < 0 or usize.wrap(index) >= offers.len() {
            return out
        }
        let at = usize.wrap(index)
        let Tag.Compound(o) = offers[at].copy() else return out
        var offer = o.copy()
        offer.insert(String("uses"), Tag.Int(int_or(offer, "uses", 0) + 1))
        let xp = int_or(offer, "xp", 1)
        let rewards = if offer.contains("rewardExp") { offer["rewardExp"].number_int() != some(0) } else { true }
        offers[at] = Tag.Compound(offer)
        self.set_offers(offers)
        self.ambient_sound_time = -self.ambient_interval
        var pop = 3 + self.living.body.random.next_int_below(4)
        self.villager_xp += xp
        self.last_traded = if let t = self.trading { some(t.uuid) } else { none }
        let (kind, profession, level) = self.living.data.villager(OWN + 1)
        if level >= 1 and level < 5 and self.villager_xp >= next_level_xp(level) {
            self.living.data.set(OWN + 1, Value.Villager(kind, profession, level + 1))
            out.leveled = true
            pop += 5
        }
        if rewards {
            out.orb = some(pop)
        }
        return out
    }

    /// `updateTrades` of a level it went up to, its offers `more` added to those it has (CAL-160).
    pub fn add_offers(mut self, more: own List<Tag>) {
        var offers = self.offers()
        for o in more {
            offers.push(o.copy())
        }
        self.set_offers(offers)
    }

    /// `updateSpecialPrices` for the player it trades with, where it trades with one, its offers
    /// priced by their reputation with it; whether it does (CAL-160).
    pub fn reprice(mut self) -> bool {
        let t = self.trading else return false
        self.update_special_prices(t.uuid)
        return true
    }

    /// Whether it has offers made, `getOffers` not empty.
    pub fn has_offers(self) -> bool {
        if not self.kept.contains("Offers") {
            return false
        }
        let Tag.Compound(m) = self.kept["Offers"] else return false
        if not m.contains("Recipes") {
            return false
        }
        return match m["Recipes"] {
            Tag.List(each) => not each.is_empty(),
            _ => false,
        }
    }

    /// The loot table of its death, `getLootTable`, its own where it was saved with one,
    /// `DeathLootTable`, else its type's, and the seed saved with it, `DeathLootTableSeed`, 0 for
    /// none (D416).
    pub fn death_loot(self) -> (String, i64) {
        let seed = if self.kept.contains("DeathLootTableSeed") { self.kept["DeathLootTableSeed"].number_long() ?? 0 } else { 0 }
        if self.kept.contains("DeathLootTable") {
            if let Tag.Str(t) = self.kept["DeathLootTable"] {
                return (t.copy(), seed)
            }
        }
        let name = type_name(self.species)
        return ("minecraft:entities/{name[10..]}", seed)
    }

    /// Its chance of dropping what's in the slot `slot` as it dies, `getDropChances`, as it was
    /// saved, `drop_chances`, else 0.085.
    pub fn drop_chance(self, slot: usize) -> f32 {
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(m) = self.kept["drop_chances"] {
                let name = slot_names()[slot].copy()
                if m.contains(name.copy()) {
                    return m[name].number_float() ?? 0.085f32
                }
            }
        }
        return 0.085f32
    }

    /// `Mob.dropCustomDeathLoot` (D416): what it wears and holds that it drops, in the slots'
    /// order, each slot's stack where it has one, it isn't cursed with vanishing,
    /// `prevent_equipment_drop`, a player killed it or it's kept, a chance above 1, and a float
    /// drawn from its random is under its chance; damaged, unless it's kept, by a draw of up to
    /// all but 3 of what it can take, and the slot left empty. Where a living thing killed it, the
    /// chance as its enchantments make it, `processEquipmentDropChance`, is the slot's in
    /// `chances` (D526); whether it's kept goes by its own all the same.
    pub fn equipment_drops<W: Wearing>(mut self, items: W, killed_by_player: bool, chances: List<f32>) -> List<Tag> {
        var out = List<Tag>()
        for slot in 0..self.living.equipment.len() {
            let base = self.drop_chance(slot)
            if base == 0.0f32 {
                continue
            }
            let preserve = base > 1.0f32
            let chance = if slot < chances.len() { chances[slot] } else { base }
            let held = self.living.equipment[slot].copy() else continue
            if vanishes(items, held.copy()) or not (killed_by_player or preserve) {
                continue
            }
            if not (self.living.body.random.next_float() < chance) {
                continue
            }
            var stack = held
            if not preserve {
                let most = int_component(items, stack.copy(), "minecraft:max_damage")
                let damageable = most != none and items.worn_component(stack.copy(), String("minecraft:unbreakable")) == none and items.worn_component(stack.copy(), String("minecraft:damage")) != none
                if damageable {
                    let m = most ?? 0
                    let inner = self.living.body.random.next_int_below((m - 3).max(1))
                    let taken = self.living.body.random.next_int_below(1 + inner)
                    stack = damaged_to(stack, (m - taken).max(0).min(m))
                }
            }
            out.push(stack)
            self.living.equipment[slot] = none
        }
        return out
    }

    /// Whether it picks up what lies near it at its `aiStep`'s end, `Mob.aiStep`'s looting
    /// (CAL-159): it may, `canPickUpLoot`, it's alive and not dead, and mob griefing's on.
    pub fn loots(self) -> bool {
        return self.can_pick_up_loot and self.living.alive() and not self.living.dead and self.mob_griefing
    }

    /// The box it picks up items in, its own a block bigger across, `getPickupReach`, as every
    /// kind Calcite makes has it (CAL-159).
    pub fn pickup_box(self) -> Aabb {
        let b = self.living.body.bounding_box()
        return Aabb { min_x: b.min_x - 1.0, min_y: b.min_y, min_z: b.min_z - 1.0, max_x: b.max_x + 1.0, max_y: b.max_y, max_z: b.max_z + 1.0 }
    }

    /// `wantsToPickUp` of `stack` (CAL-159): anything it may hold, `canHoldItem`, but a glow ink
    /// sac for a zombie, `Zombie`'s, and a spear for a skeleton, `AbstractSkeleton`'s. A zombie
    /// holds anything but an egg as a baby that rides, which none does yet (CAL-173).
    pub fn wants_to_pick_up(self, lf: LivingFacts, stack: Tag) -> bool {
        let item = held_name(some(stack.copy()))
        if (self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER) and item == "minecraft:glow_ink_sac" {
            return false
        }
        return not (self.species == SKELETON and lf.spears.contains(item))
    }

    /// `equipItemIfPossible` of `stack` (CAL-159): what it equips of it, or none. Its slot,
    /// `getEquipmentSlotForItem`, where it may be equipped there, `isEquippableInSlot`; where
    /// what's in it may be replaced, `canReplaceCurrentItem`, or, for armor where it mayn't, the
    /// main hand where that's empty, what's there drops where it's something and a float drawn less
    /// a tenth, at least 0, is under its chance, `spawnAtLocation`, and it's equipped, one of it in
    /// a slot that holds one, `limit`, sure to drop, `setGuaranteedDrop`, and the mob kept from
    /// going, `persistenceRequired`.
    pub fn equip_if_possible<W: Wearing>(mut self, lf: LivingFacts, items: W, stack: Tag, sounds: mut List<EntitySound>) -> Tag? {
        var slot = self.slot_for(items, stack.copy())
        if not self.equippable_in(items, stack.copy(), slot) {
            return none
        }
        var current = self.living.equipment[slot].copy()
        var replace = self.can_replace(lf, items, stack.copy(), current.copy(), slot)
        if slot >= 2 and slot <= 6 and not replace {
            slot = 0
            current = self.living.equipment[0].copy()
            replace = current == none
        }
        if not replace {
            return none
        }
        if let old = current {
            let drawn = self.living.body.random.next_float() - 0.1f32
            if (if drawn > 0.0f32 { drawn } else { 0.0f32 }) < self.drop_chance(slot) {
                let spilled = Spilled { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, stack: old }
                self.living.show(Shown.Spilled(spilled), sounds.len())
            }
        }
        let equipped = if slot >= 2 { one_of(some(stack.copy())) } else { stack.copy() }
        self.equip_in(items, slot, equipped.copy(), mut sounds)
        self.guarantee_drop(slot)
        self.persistence_required = true
        return some(equipped)
    }

    // The slot `stack` goes in, `getEquipmentSlotForItem`: its equippable's where it may use that
    // slot, else the main hand.
    fn slot_for<W: Wearing>(self, items: W, stack: Tag) -> usize {
        if let slot = equippable_slot(items, stack) {
            if self.can_use_slot(slot) {
                return slot
            }
        }
        return 0
    }

    // `isEquippableInSlot`: without an equippable, the main hand, where it may use it; with one,
    // its slot, where it may use it and its type's among those it allows, `canBeEquippedBy`, all
    // where it names none.
    fn equippable_in<W: Wearing>(self, items: W, stack: Tag, slot: usize) -> bool {
        let Tag.Compound(e) = items.worn_component(stack.copy(), String("minecraft:equippable")) ?? Tag.End else {
            return slot == 0 and self.can_use_slot(0)
        }
        if equippable_slot(items, stack) != some(slot) or not self.can_use_slot(slot) {
            return false
        }
        if not e.contains("allowed_entities") {
            return true
        }
        return items.worn_types(e["allowed_entities"].copy()).contains(i32.wrap(self.living.kind))
    }

    // `canUseSlot`: any but the saddle, which a pig uses alive and grown, `Pig`'s, a horse and a
    // zombie horse always, and a donkey alive, grown and tamed, `AbstractHorse`'s.
    fn can_use_slot(self, slot: usize) -> bool {
        if slot != 7 or self.species == HORSE or self.species == ZOMBIE_HORSE {
            return true
        }
        if self.species == PIG {
            return self.living.alive() and not self.baby()
        }
        if self.species == DONKEY {
            return self.living.alive() and not self.baby() and self.horse_flag(2)
        }
        return true
    }

    // `canReplaceCurrentItem`: anything replaces nothing; armor what defends less, `compareArmor`,
    // and in the main hand what deals less, `compareWeapons`; nothing else.
    fn can_replace<W: Wearing>(self, lf: LivingFacts, items: W, stack: Tag, current: Tag?, slot: usize) -> bool {
        let old = current else return true
        if slot >= 2 and slot <= 6 {
            if binds(items, old.copy()) {
                return false
            }
            let armor = attribute("armor")
            let toughness = attribute("armor_toughness")
            let defense = approximate_with(self.living.attributes, some(stack.copy()), armor, slot, items)
            let had = approximate_with(self.living.attributes, some(old.copy()), armor, slot, items)
            if defense != had {
                return defense > had
            }
            let tough = approximate_with(self.living.attributes, some(stack.copy()), toughness, slot, items)
            let was = approximate_with(self.living.attributes, some(old.copy()), toughness, slot, items)
            if tough != was {
                return tough > was
            }
            return replaces_equal(items, stack, old)
        }
        if slot != 0 {
            return false
        }
        // `getPreferredWeaponType`: a skeleton's, `#skeleton_preferred_weapons`.
        if self.species == SKELETON {
            let preferred = lf.skeleton_weapons.contains(held_name(some(stack.copy())))
            let had_preferred = lf.skeleton_weapons.contains(held_name(some(old.copy())))
            if had_preferred and not preferred {
                return false
            }
            if preferred and not had_preferred {
                return true
            }
        }
        let damage = attribute("attack_damage")
        let deals = approximate_with(self.living.attributes, some(stack.copy()), damage, slot, items)
        let dealt = approximate_with(self.living.attributes, some(old.copy()), damage, slot, items)
        if deals != dealt {
            return deals > dealt
        }
        return replaces_equal(items, stack, old)
    }

    // `setItemSlot` of `stack` in the slot `slot`, and its `onEquipItem` (CAL-159): where it's
    // another item, or has other components, its equippable's sound, `getEquipSound`, unless it's
    // silent, its seed drawn from its random, at full volume and pitch; the game event of it
    // comes with game events, and it's never its first tick, as it picks up in its `aiStep`. Then
    // a skeleton's weapon goal is looked at again, `reassessWeaponGoal`.
    fn equip_in<W: Wearing>(mut self, items: W, slot: usize, stack: Tag, sounds: mut List<EntitySound>) {
        let old = self.living.equipment[slot].copy()
        self.living.equipment[slot] = some(stack.copy())
        if not same_components(old, some(stack.copy())) {
            if let Tag.Compound(e) = items.worn_component(stack.copy(), String("minecraft:equippable")) ?? Tag.End {
                if not self.living.silent() and equippable_slot(items, stack) == some(slot) {
                    let sound = equip_sound(e)
                    let seed = self.living.body.random.next_long()
                    sounds.push(EntitySound { sound: sound, x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 1.0f32, pitch: 1.0f32, source: self.living.body.sound_source, seed: some(seed) })
                }
            }
        }
        let hard = self.hard
        self.reassess_weapon(hard)
    }

    // `setGuaranteedDrop`: its chance of dropping what's in the slot `slot` 2, so it's kept whole
    // as it drops, as `drop_chances` saves it.
    fn guarantee_drop(mut self, slot: usize) {
        var chances = JavaHashMap<String, Tag>()
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(had) = self.kept["drop_chances"] {
                chances = had.copy()
            }
        }
        chances.insert(slot_names()[slot].copy(), Tag.Float(2.0f32))
        self.kept.insert(String("drop_chances"), Tag.Compound(chances))
    }

    /// The experience it drops as it dies, `getBaseExperienceReward` (D416): an animal's 1 to 3,
    /// drawn; an endermite's 3 (D583); another monster's 5, a baby zombie's 12, `xpReward * 2.5`,
    /// and a slime's its size, each with 1 to 3 more, drawn, for each slot but the saddle with a
    /// stack it may drop, a chance of 1 or less. A killer's enchantments' `mob_experience` come
    /// with them.
    pub fn experience_reward(mut self) -> i32 {
        if self.animal {
            return 1 + self.living.body.random.next_int_below(3)
        }
        var reward = if self.species == SLIME { self.slime_size() } else if self.species == ENDERMITE { 3 } else if self.monster { 5 } else { 0 }
        if (self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER) and self.baby() {
            reward = i32.saturate(f64(reward) * 2.5)
        }
        if reward <= 0 {
            return reward
        }
        for slot in 0..self.living.equipment.len() {
            if slot == 7 or self.living.equipment[slot] == none {
                continue
            }
            if self.drop_chance(slot) <= 1.0f32 {
                reward += 1 + self.living.body.random.next_int_below(3)
            }
        }
        return reward
    }

    // `getVoicePitch`: about 1, or 1.5 for a baby, from its own random.
    fn voice_pitch(mut self) -> f32 {
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        return (a - b) * 0.2f32 + (if self.baby() { 1.5f32 } else { 1.0f32 })
    }

    /// The mob `tag` saves, of the type `kind`, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes it and `load` reads it in, its variants by name from `facts`;
    /// none where it isn't a kind Calcite makes or doesn't read, logged in `lines`.
    pub fn loaded(lf: LivingFacts, facts: MobFacts, kind: u32, id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Mob? {
        let Tag.Str(name) = tag["id"] else return none
        let species = species_named(name) else return none
        var mob = Mob.made(lf, facts, species, kind, id, seed, 0.0, 0.0, 0.0)
        if species == SLIME {
            // A slime's size, set before what every living entity reads, its attributes and
            // health, `readAdditionalSaveData`.
            mob.set_slime_size(int_or(tag, "Size", 0) + 1, false)
        }
        if not mob.living.load_from(lf, tag, mut lines) {
            return none
        }
        if species == VILLAGER and tag.contains("Brain") {
            // `LivingEntity.readAdditionalSaveData`'s last: its brain made again, its sensors put
            // off again by its random, with the memories it saved (CAL-160).
            var brain = mob.villager_brain()
            brain.unpack(tag["Brain"].copy())
            mob.brain = some(brain)
        }
        if species == ARMADILLO and tag.contains("Brain") {
            // `LivingEntity.readAdditionalSaveData`'s last: its brain made again, its sensors put
            // off again by its random, with the memories it saved (CAL-160).
            var brain = Brain.made(armadillo_sensors(), armadillo_activities(seed), mut mob.living.body.random)
            brain.unpack(tag["Brain"].copy())
            mob.brain = some(brain)
        }
        let turn = mob.living.body.y_rot
        mob.living.y_head_rot = turn
        mob.living.y_head_rot_o = turn
        mob.living.y_body_rot = turn
        mob.living.y_body_rot_o = turn
        mob.can_pick_up_loot = bool_or(tag, "CanPickUpLoot")
        mob.persistence_required = bool_or(tag, "PersistenceRequired")
        mob.set_flag(LEFT_HANDED_FLAG, bool_or(tag, "LeftHanded"))
        mob.set_flag(NO_AI_FLAG, bool_or(tag, "NoAI"))
        if mob.ageable {
            mob.set_age(int_or(tag, "Age", 0))
            mob.forced_age = int_or(tag, "ForcedAge", 0)
            mob.living.data.set(AGE_LOCKED, Value.Bool(bool_or(tag, "AgeLocked")))
            mob.in_love = int_or(tag, "InLove", 0)
        }
        if species == MOOSHROOM {
            var brown = false
            if let Tag.Str(variant) = string_at(tag, "Type") {
                brown = variant == "brown"
            }
            mob.living.data.set(MOOSHROOM_TYPE, Value.Number(if brown { 1 } else { 0 }))
        } else if mob.equine() {
            mob.set_horse_flag(16, bool_or(tag, "EatingHaystack"))
            mob.set_horse_flag(8, bool_or(tag, "Bred"))
            mob.temper = int_or(tag, "Temper", 0)
            mob.set_horse_flag(2, bool_or(tag, "Tame"))
            if species == HORSE {
                mob.living.data.set(OWN + 1, Value.Number(int_or(tag, "Variant", 0)))
            } else if species == DONKEY {
                mob.living.data.set(OWN + 1, Value.Bool(bool_or(tag, "ChestedHorse")))
            }
        } else if species == SHEEP {
            if mob.sheared() != bool_or(tag, "Sheared") {
                let wool = i32(mob.living.data.byte(OWN))
                mob.living.data.set(OWN, Value.Byte(i8.wrap(wool ^ 16)))
            }
            mob.set_color(int_or(tag, "Color", 0))
        } else if species == ZOMBIE or species == ZOMBIE_VILLAGER {
            mob.set_zombie_baby(bool_or(tag, "IsBaby"))
            mob.can_break_doors = bool_or(tag, "CanBreakDoors")
            mob.navigation.can_open_doors = mob.can_break_doors
            mob.load_conversion(tag, "InWaterTime", "DrownedConversionTime", MONSTER_OWN + 2)
            if species == ZOMBIE_VILLAGER {
                mob.load_villager(tag)
            }
        } else if species == SKELETON {
            mob.load_conversion(tag, "FreezingTime", "StrayConversionTime", MONSTER_OWN)
        } else if species == CREEPER {
            mob.living.data.set(MONSTER_OWN + 1, Value.Bool(bool_or(tag, "powered")))
            mob.max_swell = i32(i16.wrap(int_or(tag, "Fuse", 30)))
            mob.explosion_radius = i32(i8.wrap(int_or(tag, "ExplosionRadius", 3)))
            if bool_or(tag, "ignited") {
                mob.living.data.set(MONSTER_OWN + 2, Value.Bool(true))
            }
        } else if species == SLIME {
            mob.was_on_ground = bool_or(tag, "wasOnGround")
        } else if species == ENDERMITE {
            mob.life = int_or(tag, "Lifetime", 0)
        } else if species == ENDER_DRAGON {
            // `EnderDragon.readAdditionalSaveData` (D608): its phase where one's saved, as
            // `getById` finds it; its death's ticks and the damage it's taken sitting.
            if tag.contains("DragonPhase") {
                if let saved_phase = tag["DragonPhase"].int_value() {
                    mob.set_dragon_phase(phase_of(saved_phase))
                }
            }
            var dr = mob.dragon.take() ?? Dragon.made()
            dr.death_time = int_or(tag, "DragonDeathTime", 0)
            dr.sitting_damage = if tag.contains("sitting_damage_received") { tag["sitting_damage_received"].number_float() ?? 0.0f32 } else { 0.0f32 }
            mob.dragon = some(dr)
        } else if species == WITCH {
            mob.patrol_leader = bool_or(tag, "PatrolLeader")
            mob.patrolling = bool_or(tag, "Patrolling")
            mob.wave = int_or(tag, "Wave", 0)
            mob.can_join_raid = bool_or(tag, "CanJoinRaid")
        } else if species == ENDERMAN {
            // Its carried block, kept as it's saved but air, which it doesn't carry; and when its
            // anger ends, `readPersistentAngerSaveData`: as it's saved, any number; else -1, and
            // where its legacy time left, `AngerTime`, is saved, that kept for its level to read,
            // `anger_from`.
            if let Tag.Compound(state) = string_at(tag, "carriedBlockState") {
                if not (state.contains("Name") and state["Name"] == Tag.Str(String("minecraft:air"))) {
                    mob.kept.insert(String("carriedBlockState"), Tag.Compound(state.copy()))
                }
            }
            if let end = long_at(tag, "anger_end_time") {
                mob.anger_end_time = end
            } else {
                mob.anger_end_time = -1
                if tag.contains("AngerTime") {
                    mob.legacy_anger = tag["AngerTime"].int_value()
                }
            }
            mob.anger_target = uuid_of(tag, "angry_at")
        } else if species == VILLAGER {
            mob.load_villager_own(tag)
        } else if species == ARMADILLO {
            // Its state, idle where it's none it knows, and its time till it sheds where it's
            // saved (CAL-160).
            var state = ARMADILLO_IDLE
            if let Tag.Str(state_name) = string_at(tag, "state") {
                state = armadillo_state_named(state_name.copy())
            }
            mob.switch_to_state(state)
            if tag.contains("scute_time") {
                mob.scute_time = int_or(tag, "scute_time", mob.scute_time)
            }
        } else if species != SPIDER {
            if let Tag.Str(v) = string_at(tag, "variant") {
                if let at = index_of(mob.variant_names, v) {
                    mob.set_variant(at)
                }
            }
            var sound: i32? = none
            if let Tag.Str(v) = string_at(tag, "sound_variant") {
                if let s = mob.sounds {
                    sound = s.id_of(v.copy())
                }
            }
            if let at = sound {
                mob.set_sound_variant(at)
            }
            if species == CHICKEN {
                mob.jockey = bool_or(tag, "IsChickenJockey")
                if tag.contains("EggLayTime") {
                    mob.egg_time = int_or(tag, "EggLayTime", mob.egg_time)
                }
            }
        }
        for key in ["drop_chances", "leash", "home_radius", "home_pos", "DeathLootTable", "DeathLootTableSeed", "LoveCause", "stew_effects", "Owner", "Items", "angry_at", "patrol_target", "RaidId", "Offers", "Gossips", "ConversionPlayer", "Inventory"] {
            if tag.contains(key) {
                mob.kept.insert(String(key), tag[key].copy())
            }
        }
        if mob.living.sleeping != none {
            // Saved asleep: its size a sleeper's, as its pose's update refreshes it, and no
            // ambient sound (CAL-160).
            mob.refresh_size()
            mob.refresh_sounds()
        }
        return some(mob)
    }

    // `ZombieVillager.readAdditionalSaveData`'s: its villager data, final where it's saved or said
    // to be, its profession drawn again from its own random where it's said to be final but isn't
    // saved; being cured where its conversion time isn't -1, for that long; and its experience.
    fn load_villager(mut self, tag: JavaHashMap<String, Tag>) {
        var saved: (i32, i32, i32)? = none
        if let Tag.Compound(v) = string_at(tag, "VillagerData") {
            saved = some(villager_of(v.copy()))
        }
        let present = match saved {
            some(_) => true,
            none => false,
        }
        if bool_or(tag, "VillagerDataFinalized") or present {
            self.living.data.set(MONSTER_OWN + 5, Value.Bool(true))
            var data = (PLAINS_VILLAGERS, 0, 1)
            if let d = saved {
                data = d
            } else {
                data = (PLAINS_VILLAGERS, self.living.body.random.next_int_below(i32.wrap(builtin_entries(24).len())), 1)
            }
            let (kind, profession, level) = data
            self.living.data.set(MONSTER_OWN + 4, Value.Villager(kind, profession, level))
        }
        let time = int_or(tag, "ConversionTime", -1)
        if time != -1 {
            self.cure_time = time
            self.living.data.set(MONSTER_OWN + 3, Value.Bool(true))
        }
        self.villager_xp = int_or(tag, "Xp", 0)
    }

    // `Villager.readAdditionalSaveData`'s (CAL-160): its villager data, final where it's saved or
    // said to be, plains with no profession at level 1 where it's only said to be; its food,
    // gossip, experience, restocks and its gossip's last decay; its offers and inventory kept as
    // they're saved; then its brain made again, `refreshBrain`.
    fn load_villager_own(mut self, tag: JavaHashMap<String, Tag>) {
        var saved: (i32, i32, i32)? = none
        if let Tag.Compound(v) = string_at(tag, "VillagerData") {
            saved = some(villager_of(v.copy()))
        }
        if bool_or(tag, "VillagerDataFinalized") or saved != none {
            self.living.data.set(OWN + 2, Value.Bool(true))
            let (kind, profession, level) = saved ?? (PLAINS_VILLAGERS, 0, 1)
            self.living.data.set(OWN + 1, Value.Villager(kind, profession, level))
        }
        self.food_level = i32(i8.wrap(int_or(tag, "FoodLevel", 0)))
        self.gossips = Gossips()
        if tag.contains("Gossips") {
            self.gossips = Gossips.read(tag["Gossips"].copy())
        }
        self.villager_xp = int_or(tag, "Xp", 0)
        self.last_restock = long_at(tag, "LastRestock") ?? 0i64
        self.last_gossip_decay = long_at(tag, "LastGossipDecay") ?? 0i64
        self.restocks_today = int_or(tag, "RestocksToday", 0)
        self.refresh_brain()
    }

    // `ConversionTracker.readAdditionalSaveData`: how long it's been afflicted, `affliction`, 0
    // where it's not saved; converting where `conversion` is saved and isn't -1, for that long.
    fn load_conversion(mut self, tag: JavaHashMap<String, Tag>, affliction: str, conversion: str, at: usize) {
        self.affliction_time = int_or(tag, affliction, 0)
        let time = int_or(tag, conversion, -1)
        self.living.data.set(at, Value.Bool(time != -1))
        if time != -1 {
            self.conversion_time = time
        }
    }

    // `ConversionTracker.addAdditionalSaveData`: how long until it converts, -1 where it isn't
    // converting, under `conversion`, then how long it's been afflicted, -1 where it isn't now,
    // as `afflicted` says, under `affliction`.
    fn save_conversion(self, t: mut JavaHashMap<String, Tag>, affliction: str, conversion: str, at: usize, afflicted: bool) {
        t.insert(String(conversion), Tag.Int(if self.living.data.flag(at) { self.conversion_time } else { -1 }))
        t.insert(String(affliction), Tag.Int(if afflicted { self.affliction_time } else { -1 }))
    }

    /// What `saveAsPassenger` saves of it, its variants by name: what every living
    /// entity saves; then `Mob`'s, whether it may pick up loot and must stay, whether it's
    /// left-handed and without AI where it is, with what it keeps; an ageable mob's age, forced
    /// age and age lock; an animal's love; and its kind's own, a mooshroom's type, a sheep's wool,
    /// a cow's, pig's or chicken's variants, a chicken's ticks until it lays, a horse's or
    /// donkey's flags, temper and owner, with a horse's variant and a donkey's chest; a zombie's
    /// baby, doors and drowning, a skeleton's freezing, a creeper's power, fuse, radius and
    /// ignition, a slime's size, less 1, and whether it was on the ground; a zombie villager's
    /// villager data and cure, a witch's patrol and raid, and an enderman's block and anger.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.living.save_into(mut t, type_name(self.species))
        if let b = self.brain {
            t.insert(String("Brain"), b.packed())
        }
        t.insert(String("CanPickUpLoot"), flag_tag(self.can_pick_up_loot))
        t.insert(String("PersistenceRequired"), flag_tag(self.persistence_required))
        self.put_kept(mut t, "drop_chances")
        self.put_kept(mut t, "leash")
        self.put_kept(mut t, "home_radius")
        self.put_kept(mut t, "home_pos")
        t.insert(String("LeftHanded"), flag_tag(self.left_handed()))
        self.put_kept(mut t, "DeathLootTable")
        self.put_kept(mut t, "DeathLootTableSeed")
        if self.no_ai() {
            t.insert(String("NoAI"), flag_tag(true))
        }
        if self.ageable {
            t.insert(String("Age"), Tag.Int(self.age))
            t.insert(String("ForcedAge"), Tag.Int(self.forced_age))
            t.insert(String("AgeLocked"), flag_tag(self.living.data.flag(AGE_LOCKED)))
            if self.animal {
                t.insert(String("InLove"), Tag.Int(self.in_love))
                self.put_kept(mut t, "LoveCause")
            }
        }
        if self.species == MOOSHROOM {
            let brown = self.living.data.number(MOOSHROOM_TYPE) == 1
            t.insert(String("Type"), Tag.Str(String(if brown { "brown" } else { "red" })))
            self.put_kept(mut t, "stew_effects")
        } else if self.equine() {
            t.insert(String("EatingHaystack"), flag_tag(self.horse_flag(16)))
            t.insert(String("Bred"), flag_tag(self.horse_flag(8)))
            t.insert(String("Temper"), Tag.Int(self.temper))
            t.insert(String("Tame"), flag_tag(self.horse_flag(2)))
            self.put_kept(mut t, "Owner")
            if self.species == HORSE {
                t.insert(String("Variant"), Tag.Int(self.horse_variant()))
            } else if self.species == DONKEY {
                let chested = self.living.data.flag(OWN + 1)
                t.insert(String("ChestedHorse"), flag_tag(chested))
                if chested {
                    self.put_kept(mut t, "Items")
                }
            }
        } else if self.species == SHEEP {
            t.insert(String("Sheared"), flag_tag(self.sheared()))
            t.insert(String("Color"), Tag.Byte(i8.wrap(self.color())))
        } else if self.species == ZOMBIE or self.species == ZOMBIE_VILLAGER {
            t.insert(String("IsBaby"), flag_tag(self.baby()))
            t.insert(String("CanBreakDoors"), flag_tag(self.can_break_doors))
            self.save_conversion(mut t, "InWaterTime", "DrownedConversionTime", MONSTER_OWN + 2, self.living.body.water_eyes)
            if self.species == ZOMBIE_VILLAGER {
                // Its villager data by name, whether that's final, its offers and gossips, its
                // cure's time, -1 where it isn't being cured, and who's curing it, and its
                // experience.
                let (kind, profession, level) = self.living.data.villager(MONSTER_OWN + 4)
                var v = JavaHashMap<String, Tag>()
                v.insert(String("type"), Tag.Str(builtin_name(23, kind)))
                v.insert(String("profession"), Tag.Str(builtin_name(24, profession)))
                v.insert(String("level"), Tag.Int(level))
                t.insert(String("VillagerData"), Tag.Compound(v))
                t.insert(String("VillagerDataFinalized"), flag_tag(self.living.data.flag(MONSTER_OWN + 5)))
                self.put_kept(mut t, "Offers")
                self.put_kept(mut t, "Gossips")
                t.insert(String("ConversionTime"), Tag.Int(if self.living.data.flag(MONSTER_OWN + 3) { self.cure_time } else { -1 }))
                self.put_kept(mut t, "ConversionPlayer")
                t.insert(String("Xp"), Tag.Int(self.villager_xp))
            }
        } else if self.species == SKELETON {
            self.save_conversion(mut t, "FreezingTime", "StrayConversionTime", MONSTER_OWN, false)
        } else if self.species == CREEPER {
            t.insert(String("powered"), flag_tag(self.living.data.flag(MONSTER_OWN + 1)))
            t.insert(String("Fuse"), Tag.Short(i16.wrap(self.max_swell)))
            t.insert(String("ExplosionRadius"), Tag.Byte(i8.wrap(self.explosion_radius)))
            t.insert(String("ignited"), flag_tag(self.living.data.flag(MONSTER_OWN + 2)))
        } else if self.species == SLIME {
            t.insert(String("Size"), Tag.Int(self.slime_size() - 1))
            t.insert(String("wasOnGround"), flag_tag(self.was_on_ground))
        } else if self.species == ENDERMITE {
            t.insert(String("Lifetime"), Tag.Int(self.life))
        } else if let dr = self.dragon {
            // `EnderDragon.addAdditionalSaveData` (D608).
            t.insert(String("DragonPhase"), Tag.Int(dr.phase))
            t.insert(String("DragonDeathTime"), Tag.Int(dr.death_time))
            t.insert(String("sitting_damage_received"), Tag.Float(dr.sitting_damage))
        } else if self.species == WITCH {
            self.put_kept(mut t, "patrol_target")
            t.insert(String("PatrolLeader"), flag_tag(self.patrol_leader))
            t.insert(String("Patrolling"), flag_tag(self.patrolling))
            t.insert(String("Wave"), Tag.Int(self.wave))
            t.insert(String("CanJoinRaid"), flag_tag(self.can_join_raid))
            self.put_kept(mut t, "RaidId")
        } else if self.species == ENDERMAN {
            self.put_kept(mut t, "carriedBlockState")
            t.insert(String("anger_end_time"), Tag.Long(self.anger_end_time))
            if let a = self.anger_target {
                t.insert(String("angry_at"), uuid_tag(a))
            }
        } else if self.species == VILLAGER {
            // `AbstractVillager`'s offers and inventory, kept as they were saved; then
            // `Villager`'s: its data by name, whether that's final, its food, gossip, experience,
            // last restock, its gossip's last decay and its restocks today (CAL-160).
            self.put_kept(mut t, "Offers")
            t.insert(String("Inventory"), Tag.List(self.stacks()))
            let (kind, profession, level) = self.living.data.villager(OWN + 1)
            var v = JavaHashMap<String, Tag>()
            v.insert(String("type"), Tag.Str(builtin_name(23, kind)))
            v.insert(String("profession"), Tag.Str(builtin_name(24, profession)))
            v.insert(String("level"), Tag.Int(level))
            t.insert(String("VillagerData"), Tag.Compound(v))
            t.insert(String("VillagerDataFinalized"), flag_tag(self.living.data.flag(OWN + 2)))
            t.insert(String("FoodLevel"), Tag.Byte(i8.wrap(self.food_level)))
            t.insert(String("Gossips"), self.gossips.saved())
            t.insert(String("Xp"), Tag.Int(self.villager_xp))
            t.insert(String("LastRestock"), Tag.Long(self.last_restock))
            t.insert(String("LastGossipDecay"), Tag.Long(self.last_gossip_decay))
            t.insert(String("RestocksToday"), Tag.Int(self.restocks_today))
        } else if self.species == ARMADILLO {
            t.insert(String("state"), Tag.Str(String(armadillo_state_name(self.armadillo_state()))))
            t.insert(String("scute_time"), Tag.Int(self.scute_time))
        } else if self.species != SPIDER {
            if self.variant >= 0 and usize.wrap(self.variant) < self.variant_names.len() {
                t.insert(String("variant"), Tag.Str(self.variant_names[usize.wrap(self.variant)].copy()))
            }
            if let s = self.sounds {
                if self.sound_variant >= 0 and usize.wrap(self.sound_variant) < s.names.len() {
                    t.insert(String("sound_variant"), Tag.Str(s.names[usize.wrap(self.sound_variant)].copy()))
                }
            }
            if self.species == CHICKEN {
                t.insert(String("IsChickenJockey"), flag_tag(self.jockey))
                t.insert(String("EggLayTime"), Tag.Int(self.egg_time))
            }
        }
        return Tag.Compound(t)
    }

    fn put_kept(self, t: mut JavaHashMap<String, Tag>, key: str) {
        if self.kept.contains(key) {
            t.insert(String(key), self.kept[key].copy())
        }
    }
}

/// The kind of the type named `name`, if Calcite makes it.
