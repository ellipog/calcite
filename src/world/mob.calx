    if name == "minecraft:bee" {
        return some(BEE)
    }
    if name == "minecraft:villager" {
        return some(VILLAGER)
    }
    return none
}

/// The type's name of the kind `species`.
pub fn type_name(species: i32) -> str {
    if species == MOOSHROOM {
        return "minecraft:mooshroom"
    }
    if species == COW {
        return "minecraft:cow"
    }
    if species == PIG {
        return "minecraft:pig"
    }
    if species == CHICKEN {
        return "minecraft:chicken"
    }
    if species == HORSE {
        return "minecraft:horse"
    }
    if species == DONKEY {
        return "minecraft:donkey"
    }
    if species == CREEPER {
        return "minecraft:creeper"
    }
    if species == ZOMBIE {
        return "minecraft:zombie"
    }
    if species == HUSK {
        return "minecraft:husk"
    }
    if species == DROWNED {
        return "minecraft:drowned"
    }
    if species == SKELETON {
        return "minecraft:skeleton"
    }
    if species == STRAY {
        return "minecraft:stray"
    }
    if species == BOGGED {
        return "minecraft:bogged"
    }
    if species == PARCHED {
        return "minecraft:parched"
    }
    if species == WITHER_SKELETON {
        return "minecraft:wither_skeleton"
    }
    if species == CAVE_SPIDER {
        return "minecraft:cave_spider"
    }
    if species == PHANTOM {
        return "minecraft:phantom"
    }
    if species == GUARDIAN {
        return "minecraft:guardian"
    }
    if species == ELDER_GUARDIAN {
        return "minecraft:elder_guardian"
    }
    if species == VINDICATOR {
        return "minecraft:vindicator"
    }
    if species == PILLAGER {
        return "minecraft:pillager"
    }
    if species == RAVAGER {
        return "minecraft:ravager"
    }
    if species == VEX {
        return "minecraft:vex"
    }
    if species == EVOKER {
        return "minecraft:evoker"
    }
    if species == SPIDER {
        return "minecraft:spider"
    }
    if species == ZOMBIFIED_PIGLIN {
        return "minecraft:zombified_piglin"
    }
    if species == HOGLIN {
        return "minecraft:hoglin"
    }
    if species == ZOGLIN {
        return "minecraft:zoglin"
    }
    if species == PIGLIN_BRUTE {
        return "minecraft:piglin_brute"
    }
    if species == PIGLIN {
        return "minecraft:piglin"
    }
    if species == IRON_GOLEM {
        return "minecraft:iron_golem"
    }
    if species == SNOW_GOLEM {
        return "minecraft:snow_golem"
    }
    if species == WOLF {
        return "minecraft:wolf"
    }
    if species == CAT {
        return "minecraft:cat"
    }
    if species == OCELOT {
        return "minecraft:ocelot"
    }
    if species == RABBIT {
        return "minecraft:rabbit"
    }
    if species == POLAR_BEAR {
        return "minecraft:polar_bear"
    }
    if species == FOX {
        return "minecraft:fox"
    }
    if species == LLAMA {
        return "minecraft:llama"
    }
    if species == PANDA {
        return "minecraft:panda"
    }
    if species == PARROT {
        return "minecraft:parrot"
    }
    if species == TURTLE {
        return "minecraft:turtle"
    }
    if species == BAT {
        return "minecraft:bat"
    }
    if species == SHULKER {
        return "minecraft:shulker"
    }
    if species == GHAST {
        return "minecraft:ghast"
    }
    if species == BLAZE {
        return "minecraft:blaze"
    }
    if species == MAGMA_CUBE {
        return "minecraft:magma_cube"
    }
    if species == SLIME {
        return "minecraft:slime"
    }
    if species == ENDERMAN {
        return "minecraft:enderman"
    }
    if species == WITCH {
        return "minecraft:witch"
    }
    if species == ZOMBIE_VILLAGER {
        return "minecraft:zombie_villager"
    }
    if species == ZOMBIE_HORSE {
        return "minecraft:zombie_horse"
    }
    if species == SKELETON_HORSE {
        return "minecraft:skeleton_horse"
    }
    if species == ARMADILLO {
        return "minecraft:armadillo"
    }
    if species == VILLAGER {
        return "minecraft:villager"
    }
    if species == ENDERMITE {
        return "minecraft:endermite"
    }
    if species == SILVERFISH {
        return "minecraft:silverfish"
    }
    if species == COD {
        return "minecraft:cod"
    }
    if species == SALMON {
        return "minecraft:salmon"
    }
    if species == TROPICAL_FISH {
        return "minecraft:tropical_fish"
    }
    if species == PUFFERFISH {
        return "minecraft:pufferfish"
    }
    if species == DOLPHIN {
        return "minecraft:dolphin"
    }
    if species == WITHER_BOSS {
        return "minecraft:wither"
    }
    if species == SULFUR_CUBE {
        return "minecraft:sulfur_cube"
    }
    if species == SQUID {
        return "minecraft:squid"
    }
    if species == GLOW_SQUID {
        return "minecraft:glow_squid"
    }
    if species == BEE {
        return "minecraft:bee"
    }
    if species == ENDER_DRAGON {
        return "minecraft:ender_dragon"
    }
    return "minecraft:sheep"
}

// The kind's size grown, across, high and its eyes, then a baby's.
fn shape(species: i32) -> (f32, f32, f32, f32, f32, f32) {
    if species == PIG {
        return (0.9f32, 0.9f32, 0.9f32 * 0.85f32, 0.45f32, 0.45f32, 0.40625f32)
    }
    if species == CHICKEN {
        return (0.4f32, 0.7f32, 0.644f32, 0.3f32, 0.4f32, 0.28125f32)
    }
    if species == SHEEP {
        return (0.9f32, 1.3f32, 1.235f32, 0.45f32, 0.65f32, 0.65625f32)
    }
    // A foal is its kind's size scaled, a horse's and a zombie horse's by 0.7 and a donkey's by 0.5.
    if species == HORSE or species == ZOMBIE_HORSE or species == SKELETON_HORSE {
        return (1.3964844f32, 1.6f32, 1.52f32, 1.3964844f32 * 0.7f32, 1.6f32 * 0.7f32, 1.52f32 * 0.7f32)
    }
    if species == DONKEY {
        return (1.3964844f32, 1.5f32, 1.425f32, 1.3964844f32 * 0.5f32, 1.5f32 * 0.5f32, 1.425f32 * 0.5f32)
    }
    // The monsters: a creeper's eyes at 0.85 of its height, as its type gives none; a baby zombie
    // its own size, `BABY_DIMENSIONS`.
    if species == CREEPER {
        return (0.6f32, 1.7f32, 1.7f32 * 0.85f32, 0.6f32, 1.7f32, 1.7f32 * 0.85f32)
    }
    if species == ZOMBIE {
        return (0.6f32, 1.95f32, 1.74f32, 0.49f32, 0.98f32, 0.775f32)
    }
    if species == DROWNED {
        return (0.6f32, 1.95f32, 1.74f32, 0.49f32, 0.98f32, 0.775f32)
    }
    if species == HUSK {
        return (0.6f32, 1.95f32, 1.74f32, 0.49f32, 0.98f32, 0.825f32)
    }
    if species == SKELETON or species == STRAY or species == BOGGED or species == PARCHED {
        return (0.6f32, 1.99f32, 1.74f32, 0.6f32, 1.99f32, 1.74f32)
    }
    if species == WITHER_SKELETON {
        return (0.7f32, 2.4f32, 2.1f32, 0.7f32, 2.4f32, 2.1f32)
    }
    if species == SPIDER {
        return (1.4f32, 0.9f32, 0.65f32, 1.4f32, 0.9f32, 0.65f32)
    }
    if species == CAVE_SPIDER {
        return (0.7f32, 0.5f32, 0.45f32, 0.7f32, 0.5f32, 0.45f32)
    }
    if species == PHANTOM {
        // Of size 0, as it's made (CAL-200).
        return (0.9f32, 0.5f32, 0.175f32, 0.9f32, 0.5f32, 0.175f32)
    }
    if species == GUARDIAN {
        return (0.85f32, 0.85f32, 0.425f32, 0.85f32, 0.85f32, 0.425f32)
    }
    if species == ELDER_GUARDIAN {
        return (1.9975f32, 1.9975f32, 0.99875f32, 1.9975f32, 1.9975f32, 0.99875f32)
    }
    if species == VINDICATOR or species == PILLAGER or species == EVOKER {
        // 0.6 by 1.95, its eyes at 0.85 of its height (CAL-200).
        return (0.6f32, 1.95f32, 1.6575f32, 0.6f32, 1.95f32, 1.6575f32)
    }
    if species == ZOMBIFIED_PIGLIN {
        // Its eyes at 1.79, a baby's at 0.78, `BABY_DIMENSIONS` (CAL-200).
        return (0.6f32, 1.95f32, 1.79f32, 0.49f32, 0.98f32, 0.78f32)
    }
    if species == PIGLIN_BRUTE {
        // 0.6 by 1.95, its eyes at 1.79, never a baby (CAL-200).
        return (0.6f32, 1.95f32, 1.79f32, 0.6f32, 1.95f32, 1.79f32)
    }
    if species == SNOW_GOLEM {
        // 0.7 by 1.9, its eyes at 1.7, never a baby (CAL-201).
        return (0.7f32, 1.9f32, 1.7f32, 0.7f32, 1.9f32, 1.7f32)
    }
    if species == RABBIT {
        // 0.49 by 0.6, its eyes at 0.59; a baby's its own, 0.24 by 0.4, its eyes at 0.39,
        // `BABY_DIMENSIONS` (CAL-201).
        return (0.49f32, 0.6f32, 0.59f32, 0.24f32, 0.4f32, 0.39f32)
    }
    if species == POLAR_BEAR {
        // 1.4 by 1.4, its eyes `EntityType`'s, 0.85 up; a cub's its own, 0.7 by 0.7, its eyes at
        // 0.34375, `BABY_DIMENSIONS` (CAL-201).
        return (1.4f32, 1.4f32, 1.19f32, 0.7f32, 0.7f32, 0.34375f32)
    }
    if species == LLAMA {
        // 0.9 by 1.87, its eyes at 1.7765; a baby's scaled by half, `BABY_DIMENSIONS` (CAL-201).
        return (0.9f32, 1.87f32, 1.7765f32, 0.9f32 * 0.5f32, 1.87f32 * 0.5f32, 1.7765f32 * 0.5f32)
    }
    if species == PARROT {
        // 0.5 by 0.9, its eyes at 0.54; never a baby, `canBeABaby` (CAL-201).
        return (0.5f32, 0.9f32, 0.54f32, 0.5f32, 0.9f32, 0.54f32)
    }
    if species == BAT {
        // 0.5 by 0.9, its eyes at 0.45; never a baby (CAL-201).
        return (0.5f32, 0.9f32, 0.45f32, 0.5f32, 0.9f32, 0.45f32)
    }
    if species == TURTLE {
        // 1.2 by 0.4, its eyes `EntityType`'s, 0.85 up; a baby's scaled by 0.3, `BABY_DIMENSIONS`
        // (CAL-201).
        let eyes = 0.4f32 * 0.85f32
        return (1.2f32, 0.4f32, eyes, 1.2f32 * 0.3f32, 0.4f32 * 0.3f32, eyes * 0.3f32)
    }
    if species == PANDA {
        // 1.3 by 1.25, its eyes `EntityType`'s, 0.85 up; a baby's scaled by half, its eyes at
        // 0.28125, `BABY_DIMENSIONS` (CAL-201).
        return (1.3f32, 1.25f32, 1.25f32 * 0.85f32, 1.3f32 * 0.5f32, 1.25f32 * 0.5f32, 0.28125f32)
    }
    if species == FOX {
        // 0.6 by 0.7, its eyes at 0.4; a cub's its type's scaled by 0.6, its eyes at 0.34375,
        // `BABY_DIMENSIONS` (CAL-201).
        return (0.6f32, 0.7f32, 0.4f32, 0.6f32 * 0.6f32, 0.7f32 * 0.6f32, 0.34375f32)
    }
    if species == OCELOT {
        // 0.6 by 0.7, its eyes `EntityType`'s, 0.85 up; a baby's its own, 0.3 by 0.35, its eyes at
        // 0.34375, `BABY_DIMENSIONS` (CAL-201).
        return (0.6f32, 0.7f32, 0.595f32, 0.3f32, 0.35f32, 0.34375f32)
    }
    if species == CAT {
        // 0.6 by 0.7, its eyes at 0.35; a baby's its own, 0.3 by 0.35, its eyes at 0.34375,
        // `BABY_DIMENSIONS` (CAL-201).
        return (0.6f32, 0.7f32, 0.35f32, 0.3f32, 0.35f32, 0.34375f32)
    }
    if species == WOLF {
        // 0.6 by 0.85, its eyes at 0.68; a baby's its own, 0.3 by 0.425, its eyes at 0.34375,
        // `BABY_DIMENSIONS` (CAL-201).
        return (0.6f32, 0.85f32, 0.68f32, 0.3f32, 0.425f32, 0.34375f32)
    }
    if species == IRON_GOLEM {
        // 1.4 by 2.7, its eyes at 0.85 of its height, never a baby (CAL-201).
        return (1.4f32, 2.7f32, 2.7f32 * 0.85f32, 1.4f32, 2.7f32, 2.7f32 * 0.85f32)
    }
    if species == PIGLIN {
        // 0.6 by 1.95, its eyes at 1.79; a baby's 0.49 by 0.98, its eyes at 0.78, `BABY_DIMENSIONS`
        // (CAL-200).
        return (0.6f32, 1.95f32, 1.79f32, 0.49f32, 0.98f32, 0.78f32)
    }
    if species == HOGLIN or species == ZOGLIN {
        // 1.3964844 by 1.4, its eyes at 0.85 of its height; a baby's 0.75 by 0.85, its eyes at
        // 0.625, `BABY_DIMENSIONS` (CAL-200); a zoglin's the same.
        return (1.3964844f32, 1.4f32, 1.4f32 * 0.85f32, 0.75f32, 0.85f32, 0.625f32)
    }
    if species == SHULKER {
        // 1 by 1, its eyes at 0.5 (CAL-200).
        return (1.0f32, 1.0f32, 0.5f32, 1.0f32, 1.0f32, 0.5f32)
    }
    if species == GHAST {
        // 4 by 4, its eyes at 2.6 (CAL-200).
        return (4.0f32, 4.0f32, 2.6f32, 4.0f32, 4.0f32, 2.6f32)
    }
    if species == BLAZE {
        // 0.6 by 1.8, its eyes at 0.85 of its height (CAL-200).
        return (0.6f32, 1.8f32, 1.8f32 * 0.85f32, 0.6f32, 1.8f32, 1.8f32 * 0.85f32)
    }
    if species == VEX {
        // 0.4 by 0.8, its eyes at 0.51875 (CAL-200).
        return (0.4f32, 0.8f32, 0.51875f32, 0.4f32, 0.8f32, 0.51875f32)
    }
    if species == RAVAGER {
        // 1.95 by 2.2, its eyes at 0.85 of its height (CAL-200).
        return (1.95f32, 2.2f32, 2.2f32 * 0.85f32, 1.95f32, 2.2f32, 2.2f32 * 0.85f32)
    }
    if species == ENDERMAN {
        return (0.6f32, 2.9f32, 2.55f32, 0.6f32, 2.9f32, 2.55f32)
    }
    if species == WITCH {
        return (0.6f32, 1.95f32, 1.62f32, 0.6f32, 1.95f32, 1.62f32)
    }
    if species == ZOMBIE_VILLAGER {
        return (0.6f32, 1.95f32, 1.74f32, 0.49f32, 0.98f32, 0.67f32)
    }
    // A sulfur cube's of size 1, 0.49 across and high, its eyes 0.175 up (CAL-402).
    if species == SULFUR_CUBE {
        return (0.49f32, 0.49f32, 0.175f32, 0.49f32, 0.49f32, 0.175f32)
    }
    // A slime's of size 1, as it's made.
    if cube_kind(species) {
        return (0.52f32, 0.52f32, 0.325f32, 0.52f32, 0.52f32, 0.325f32)
    }
    // An armadillo's baby its size scaled by 0.6, its eyes at 0.21875 (CAL-160).
    if species == ARMADILLO {
        return (0.7f32, 0.65f32, 0.26f32, 0.7f32 * 0.6f32, 0.65f32 * 0.6f32, 0.21875f32)
    }
    // A villager's baby its own size, `BABY_DIMENSIONS` (CAL-160).
    if species == VILLAGER {
        return (0.6f32, 1.95f32, 1.62f32, 0.49f32, 0.98f32, 0.63f32)
    }
    // An endermite's and a silverfish's, its eyes at 0.13, never a baby (D583, CAL-172).
    if species == ENDERMITE or species == SILVERFISH {
        return (0.4f32, 0.3f32, 0.13f32, 0.4f32, 0.3f32, 0.13f32)
    }
    // A cod's, 0.5 by 0.3, its eyes 0.195 up, no baby of its own (CAL-178).
    if species == COD {
        return (0.5f32, 0.3f32, 0.195f32, 0.5f32, 0.3f32, 0.195f32)
    }
    // A salmon's, 0.7 by 0.4, its eyes 0.26 up, a medium one's, no baby of its own (CAL-201).
    if species == SALMON {
        return (0.7f32, 0.4f32, 0.26f32, 0.7f32, 0.4f32, 0.26f32)
    }
    // A tropical fish's, 0.5 by 0.4, its eyes 0.26 up (CAL-201).
    if species == TROPICAL_FISH {
        return (0.5f32, 0.4f32, 0.26f32, 0.5f32, 0.4f32, 0.26f32)
    }
    // A pufferfish's, 0.7 by 0.7, its eyes 0.455 up, scaled by a half as it's made small
    // (CAL-201).
    if species == PUFFERFISH {
        return (0.7f32 * 0.5f32, 0.7f32 * 0.5f32, 0.455f32 * 0.5f32, 0.7f32 * 0.5f32, 0.7f32 * 0.5f32, 0.455f32 * 0.5f32)
    }
    // A dolphin's, 0.9 by 0.6, its eyes 0.3 up; a baby's 0.65 of it, its eyes 0.09375 up,
    // `BABY_DIMENSIONS` (CAL-201).
    if species == DOLPHIN {
        return (0.9f32, 0.6f32, 0.3f32, 0.9f32 * 0.65f32, 0.6f32 * 0.65f32, 0.09375f32)
    }
    if species == WITHER_BOSS {
        // 0.9 by 3.5, its eyes at 0.85 of that (CAL-401).
        return (0.9f32, 3.5f32, 3.5f32 * 0.85f32, 0.9f32, 3.5f32, 3.5f32 * 0.85f32)
    }
    // A squid's and a glow squid's, 0.8 by 0.8, its eyes 0.4 up; a baby's its own, 0.5 by 0.5, its
    // eyes 0.37 up, `BABY_DIMENSIONS` (CAL-201).
    if squid_kind(species) {
        return (0.8f32, 0.8f32, 0.4f32, 0.5f32, 0.5f32, 0.37f32)
    }
    // A bee's, its baby's its size halved, `DEFAULT_BABY_SCALE` (CAL-177).
    if species == BEE {
        return (0.55f32, 0.5f32, 0.3f32, 0.55f32 * 0.5f32, 0.5f32 * 0.5f32, 0.3f32 * 0.5f32)
    }
    // An ender dragon's, 16 by 8, its eyes `EntityDimensions`' 0.85 of its height (D608).
    if species == ENDER_DRAGON {
        return (16.0f32, 8.0f32, 8.0f32 * 0.85f32, 16.0f32, 8.0f32, 8.0f32 * 0.85f32)
    }
    return (0.9f32, 1.4f32, 1.3f32, 0.45f32, 0.7f32, 0.69f32)
}

/// Where what rides a mob of `species` sits on it before its turn, `EntityAttachment.PASSENGER`
/// (D708), it `high` tall: its type's `passengerAttachments`, or its height where they set none,
/// `AT_HEIGHT`; a baby's its `BABY_DIMENSIONS`' own, or its type's scaled as they are, a foal's and
/// a donkey's its type's own taken up and scaled; a slime's its height but a 64th of its size,
/// `AbstractCubeMob`'s. Each Calcite has has one, which all its riders share, `getClamped`.
pub fn passenger_point(species: i32, baby: bool, high: f32, size: i32) -> (f64, f64, f64) {
    if species == POLAR_BEAR and baby {
        // A cub's 0.625 up, `BABY_DIMENSIONS`; a grown one's at its height (CAL-201).
        return (0.0, 0.625, 0.0)
    }
    if species == LLAMA {
        // `passengerAttachments(0, 1.37, -0.3)`, `getDefaultPassengerAttachmentPoint`; a baby's
        // its height less a quarter up, scaled by half, `BABY_DIMENSIONS` (CAL-201).
        return if baby { (0.0, f64(1.87f32 - 0.25f32) * f64(0.5f32), f64(-0.3f32) * f64(0.5f32)) } else { (0.0, 1.37, -0.3) }
    }
    if species == PARROT {
        // `passengerAttachments(0.4625F)` (CAL-201).
        return (0.0, f64(0.4625f32), 0.0)
    }
    if species == TURTLE {
        // `passengerAttachments(0, 0.55625, -0.25)`; a baby's at its height, a quarter back,
        // scaled by 0.3, `BABY_DIMENSIONS` (CAL-201).
        return if baby { (0.0, f64(0.4f32) * f64(0.3f32), f64(-0.25f32) * f64(0.3f32)) } else { (0.0, 0.55625, -0.25) }
    }
    if species == PANDA and baby {
        // A baby's 0.5625 up, `BABY_DIMENSIONS`; a grown one's at its height (CAL-201).
        return (0.0, 0.5625, 0.0)
    }
    if species == FOX {
        // `passengerAttachments(0, 0.6375, -0.25)`; a cub's 0.375 up, `BABY_DIMENSIONS` (CAL-201).
        return if baby { (0.0, 0.375, 0.0) } else { (0.0, 0.6375, -0.25) }
    }
    if species == OCELOT {
        // `passengerAttachments(0.6375F)`; a baby's 0.3125 up, `BABY_DIMENSIONS` (CAL-201).
        return if baby { (0.0, 0.3125, 0.0) } else { (0.0, 0.6375, 0.0) }
    }
    if species == CAT {
        // `passengerAttachments(0.5125F)`; a baby's 0.3125 up, `BABY_DIMENSIONS` (CAL-201).
        return if baby { (0.0, 0.3125, 0.0) } else { (0.0, 0.5125, 0.0) }
    }
    if species == WOLF {
        // `passengerAttachments(new Vec3(0.0, 0.81875, -0.0625))`; a baby's 0.4375 up,
        // `BABY_DIMENSIONS` (CAL-201).
        return if baby { (0.0, 0.4375, 0.0) } else { (0.0, 0.81875, -0.0625) }
    }
    if species == ZOMBIFIED_PIGLIN and not baby {
        // `passengerAttachments(2.0F)`; a baby's its height (CAL-200).
        return (0.0, 2.0, 0.0)
    }
    if species == PIGLIN_BRUTE {
        // `passengerAttachments(2.0125F)` (CAL-200).
        return (0.0, f64(2.0125f32), 0.0)
    }
    if species == PIGLIN and not baby {
        // `passengerAttachments(2.0125F)`; a baby's its height, `BABY_DIMENSIONS` setting none
        // (CAL-200).
        return (0.0, f64(2.0125f32), 0.0)
    }
    if species == HOGLIN or species == ZOGLIN {
        // `passengerAttachments(1.49375F)`; a baby's 0.875, `BABY_DIMENSIONS` (CAL-200); a
        // zoglin's the same.
        return (0.0, f64(if baby { 0.875f32 } else { 1.49375f32 }), 0.0)
    }
    if species == GHAST {
        // `passengerAttachments(4.0625F)` (CAL-200).
        return (0.0, f64(4.0625f32), 0.0)
    }
    if species == PHANTOM {
        // 0.3375 up, scaled as its size scales it, `getDefaultDimensions` (CAL-200).
        return (0.0, f64(0.3375f32) * f64(phantom_scale(size)), 0.0)
    }
    if species == GUARDIAN {
        // `passengerAttachments(0.975F)` (CAL-200).
        return (0.0, f64(0.975f32), 0.0)
    }
    if species == ELDER_GUARDIAN {
        return (0.0, f64(2.350625f32), 0.0)
    }
    if species == VINDICATOR or species == PILLAGER or species == EVOKER {
        return (0.0, 2.0, 0.0)
    }
    if species == RAVAGER {
        return (0.0, 2.2625, -0.0625)
    }
    if species == VEX {
        return (0.0, f64(0.7375f32), 0.0)
    }
    if species == PIG {
        return (0.0, f64(if baby { 0.5f32 } else { 0.86875f32 }), 0.0)
    }
    if species == CHICKEN {
        if baby {
            return (0.0, f64(0.375f32), 0.0)
        }
        return (0.0, 0.7, -0.1)
    }
    if species == SHEEP {
        return (0.0, f64(if baby { 0.5625f32 } else { 1.2375f32 }), 0.0)
    }
    if species == COW or species == MOOSHROOM {
        return (0.0, f64(if baby { 0.75f32 } else { 1.36875f32 }), 0.0)
    }
    if species == HORSE {
        if baby {
            return (0.0, f64(1.6f32 - 0.125f32) * f64(0.7f32), 0.0)
        }
        return (0.0, f64(1.44375f32), 0.0)
    }
    if species == ZOMBIE_HORSE or species == SKELETON_HORSE {
        if baby {
            return (0.0, f64(1.6f32 - 0.25f32) * f64(0.7f32), 0.0)
        }
        return (0.0, f64(1.31875f32), 0.0)
    }
    if species == DONKEY {
        if baby {
            return (0.0, f64(1.5f32 + 0.03125f32) * f64(0.5f32), f64(-0.3125f32) * f64(0.5f32))
        }
        return (0.0, f64(1.1125f32), 0.0)
    }
    if species == ARMADILLO and baby {
        return (0.0, f64(0.65f32) * f64(0.6f32), 0.0)
    }
    if cube_kind(species) {
        return (0.0, f64(high) - 0.015625 * f64(size) * f64(1.0f32), 0.0)
    }
    if baby {
        return (0.0, f64(high), 0.0)
    }
    if species == ZOMBIE or species == DROWNED {
        return (0.0, f64(2.0125f32), 0.0)
    }
    if species == HUSK {
        return (0.0, f64(2.075f32), 0.0)
    }
    if species == ZOMBIE_VILLAGER {
        return (0.0, f64(2.125f32), 0.0)
    }
    if species == SPIDER {
        return (0.0, f64(0.765f32), 0.0)
    }
    if species == ENDERMAN {
        return (0.0, f64(2.80625f32), 0.0)
    }
    if species == WITCH {
        return (0.0, f64(2.2625f32), 0.0)
    }
    if species == ENDERMITE or species == SILVERFISH {
        return (0.0, f64(0.2375f32), 0.0)
    }
    if species == ENDER_DRAGON {
        return (0.0, f64(3.0f32), 0.0)
    }
    return (0.0, f64(high), 0.0)
}

/// `startRiding(vehicle, false, false)` of `rider` as finalizing makes them, before either's in
/// its level (D708): standing, `setPose(STANDING)`, and last of what rides `vehicle`, which takes
/// it, as nothing rides a mob just made, `canAddPassenger`, nor waits to board, `canRide`. A horse
/// turns what boards it to where it looked, `AbstractHorse.addPassenger`'s
/// `absSnapRotationTo(getViewYRot(0), getViewXRot(0))`: its head's turn and its pitch as they were
/// a tick before, the pitch within 90 either way (CAL-200).
pub fn board(rider: mut Mob, vehicle: mut Mob) {
    rider.living.data.set(POSE_ID, Value.Number(STANDING))
    rider.living.body.vehicle = some(vehicle.living.body.id)
    vehicle.living.body.passengers.push(rider.living.body.id)
    rider.living.body.riding_with = vehicle.living.body.passengers.copy()
    if vehicle.equine() {
        let pitch = vehicle.living.x_rot_o
        rider.living.body.y_rot = vehicle.living.y_head_rot_o % 360.0f32
        rider.living.body.x_rot = (if pitch < -90.0f32 { -90.0f32 } else if pitch > 90.0f32 { 90.0f32 } else { pitch }) % 360.0f32
        rider.living.y_rot_o = rider.living.body.y_rot
        rider.living.x_rot_o = rider.living.body.x_rot
    }
}

/// Where a mob of `species` is held by what it rides, `EntityAttachment.VEHICLE` (D708), taken
/// from where that seats it: a zombie's, a zombie villager's and a skeleton's 0.7 up, their type's
/// `ridingOffset(-0.7F)`, a baby zombie's 0.1875 and a baby zombie villager's 0.125, their
/// `BABY_DIMENSIONS`'; else its feet, `AT_FEET`.
pub fn vehicle_point(species: i32, baby: bool, size: i32) -> (f64, f64, f64) {
    if species == GHAST {
        // `ridingOffset(0.5F)` (CAL-200).
        return (0.0, f64(-0.5f32), 0.0)
    }
    if species == ZOMBIE or species == HUSK or species == DROWNED or species == ZOMBIFIED_PIGLIN {
        return (0.0, f64(if baby { 0.1875f32 } else { 0.7f32 }), 0.0)
    }
    if species == ZOMBIE_VILLAGER {
        return (0.0, f64(if baby { 0.125f32 } else { 0.7f32 }), 0.0)
    }
    if species == SKELETON or species == STRAY or species == BOGGED or species == PARCHED {
        return (0.0, f64(0.7f32), 0.0)
    }
    if species == WITHER_SKELETON {
        return (0.0, f64(0.875f32), 0.0)
    }
    if species == PIGLIN_BRUTE {
        // `ridingOffset(-0.7F)` (CAL-200).
        return (0.0, f64(0.7f32), 0.0)
    }
    if species == PIGLIN {
        // `ridingOffset(-0.7F)`; a baby's 0.1875, `BABY_DIMENSIONS` (CAL-200).
        return (0.0, f64(if baby { 0.1875f32 } else { 0.7f32 }), 0.0)
    }
    if species == VINDICATOR or species == PILLAGER or species == EVOKER {
        return (0.0, f64(0.6f32), 0.0)
    }
    if species == VEX {
        // `ridingOffset(0.04F)` (CAL-200).
        return (0.0, f64(-0.04f32), 0.0)
    }
    if species == PHANTOM {
        // `ridingOffset(-0.125F)`, scaled as its size scales it (CAL-200).
        return (0.0, f64(0.125f32) * f64(phantom_scale(size)), 0.0)
    }
    return (0.0, 0.0, 0.0)
}

// The kind's values as its constructor defines them, its variants the defaults.
fn data_of(species: i32, facts: MobFacts) -> EntityData {
    if species == COW {
        return cow_data(facts.cow.default, facts.cow_sounds.default)
    }
    if species == PIG {
        return pig_data(facts.pig.default, facts.pig_sounds.default)
    }
    if species == CHICKEN {
        return chicken_data(facts.chicken.default, facts.chicken_sounds.default)
    }
    if species == SHEEP {
        return sheep_data()
    }
    if species == HORSE {
        return horse_data()
    }
    if species == DONKEY {
        return donkey_data()
    }
    if species == CREEPER {
        return creeper_data()
    }
    if species == ZOMBIE or species == HUSK or species == DROWNED {
        return zombie_data()
    }
    if species == SKELETON {
        return skeleton_data()
    }
    if species == STRAY or species == PARCHED or species == WITHER_SKELETON {
        return mob_data()
    }
    // A bogged's whether it's sheared, `Bogged.DATA_SHEARED`, where a skeleton keeps its
    // conversion's (CAL-200).
    if species == BOGGED {
        return skeleton_data()
    }
    if species == HOGLIN {
        return hoglin_data()
    }
    if species == ZOGLIN {
        return zoglin_data()
    }
    if species == PIGLIN_BRUTE {
        return piglin_brute_data()
    }
    if species == PIGLIN {
        return piglin_data()
    }
    if species == SNOW_GOLEM {
        // Its pumpkin a byte's flag, `DATA_PUMPKIN_ID`, 16, on (CAL-201).
        return snow_golem_data()
    }
    if species == WOLF {
        return wolf_data(facts.wolf.default, facts.wolf_sounds.default)
    }
    if species == OCELOT {
        return ocelot_data()
    }
    if species == RABBIT {
        return rabbit_data()
    }
    if species == POLAR_BEAR {
        return polar_bear_data()
    }
    if species == FOX {
        return fox_data()
    }
    if species == LLAMA {
        return llama_data()
    }
    if species == PANDA {
        return panda_data()
    }
    if species == PARROT {
        return parrot_data()
    }
    if species == TURTLE {
        return turtle_data()
    }
    if species == BAT {
        return bat_data()
    }
    if species == CAT {
        return cat_data(facts.cat.default, facts.cat_sounds.default)
    }
    if species == IRON_GOLEM {
        // Its flags a byte, as a spider's are, `DATA_FLAGS_ID`, whether a player made it its
        // first (CAL-201).
        return spider_data()
    }
    if species == SHULKER {
        return shulker_data()
    }
    if species == GHAST {
        return ghast_data()
    }
    if species == ZOMBIFIED_PIGLIN {
        return zombie_data()
    }
    if species == SPIDER or species == CAVE_SPIDER or species == VEX or species == BLAZE {
        // A vex's and a blaze's flags a byte as a spider's are, `DATA_FLAGS_ID` (CAL-200).
        return spider_data()
    }
    if species == PHANTOM {
        return phantom_data()
    }
    if species == GUARDIAN or species == ELDER_GUARDIAN {
        return guardian_data()
    }
    if species == VINDICATOR or species == RAVAGER {
        return raider_data()
    }
    if species == PILLAGER {
        return pillager_data()
    }
    if species == EVOKER {
        return spellcaster_data()
    }
    if species == SULFUR_CUBE {
        return sulfur_cube_data()
    }
    if cube_kind(species) {
        return slime_data()
    }
    if species == ENDERMAN {
        return enderman_data()
    }
    if species == WITCH {
        return witch_data()
    }
    if species == ZOMBIE_VILLAGER {
        return zombie_villager_data()
    }
    if species == ZOMBIE_HORSE or species == SKELETON_HORSE {
        return zombie_horse_data()
    }
    if species == ARMADILLO {
        return armadillo_data()
    }
    if species == VILLAGER {
        return villager_data()
    }
    if species == ENDERMITE {
        return endermite_data()
    }
    if species == SILVERFISH {
        return silverfish_data()
    }
    if species == COD {
        return fish_data()
    }
    if species == SALMON {
        return salmon_data()
    }
    if species == TROPICAL_FISH {
        return tropical_fish_data()
    }
    if species == PUFFERFISH {
        return pufferfish_data()
    }
    if species == DOLPHIN {
        return dolphin_data()
    }
    if species == WITHER_BOSS {
        return wither_data()
    }
    if species == SQUID {
        return squid_data()
    }
    if species == GLOW_SQUID {
        return glow_squid_data()
    }
    if species == BEE {
        return bee_data()
    }
    if species == ENDER_DRAGON {
        return dragon_data()
    }
    return mooshroom_data()
}

// The attribute `minecraft:{name}`'s ID.
fn attribute(name: str) -> u32 {
    return attribute_id("minecraft:{name}") ?? panic("no attribute {name}")
}

// A stack of one of the item `name`, `new ItemStack(item)`, as it's saved.
// The effects of the potion the stack `stack` holds, its `potion_contents`' scaled by its
// `potion_duration_scale`, 1 where it has none; none where it holds none (CAL-163).
fn potion_of(stack: Tag?) -> List<ActiveEffect> {
    let s = stack.copy() else return List<ActiveEffect>()
    let Tag.Compound(m) = s else return List<ActiveEffect>()
    if not m.contains("components") {
        return List<ActiveEffect>()
    }
    let Tag.Compound(c) = m["components"] else return List<ActiveEffect>()
    if not c.contains("minecraft:potion_contents") {
        return List<ActiveEffect>()
    }
    var scale = 1.0f32
    if c.contains("minecraft:potion_duration_scale") {
        if let Tag.Float(v) = c["minecraft:potion_duration_scale"] {
            scale = v
        }
    }
    return contents_effects(c["minecraft:potion_contents"].copy(), scale)
}

// One of the item `item` holding the potion `potion`, `PotionContents.createItemStack` (CAL-159).
fn potion_stack(item: str, potion: str) -> Tag {
    var contents = JavaHashMap<String, Tag>()
    contents.insert(String("potion"), Tag.Str(String(potion)))
    var components = JavaHashMap<String, Tag>()
    components.insert(String("minecraft:potion_contents"), Tag.Compound(contents))
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String(item)))
    m.insert(String("count"), Tag.Int(1))
    m.insert(String("components"), Tag.Compound(components))
    return Tag.Compound(m)
}

fn stack_of(name: own String) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(name))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

/// Whether `stack` is the ominous banner, `ItemStack.matches` with `Raid.getOminousBannerInstance`
/// (CAL-396).
pub fn is_ominous_banner(stack: Tag) -> bool {
    return stack == ominous_banner()
}

// The ominous banner, `Raid.getOminousBannerInstance` (CAL-200): a white banner with its eight
// layers, its patterns hidden from its tooltip, its name `block.minecraft.ominous_banner`, and
// uncommon.
fn ominous_banner() -> Tag {
    var layers = List<Tag>()
    for (pattern, color) in [("rhombus", "cyan"), ("stripe_bottom", "light_gray"), ("stripe_center", "gray"), ("border", "light_gray"), ("stripe_middle", "black"), ("half_horizontal", "light_gray"), ("circle", "light_gray"), ("border", "black")] {
        var layer = JavaHashMap<String, Tag>()
        layer.insert(String("pattern"), Tag.Str("minecraft:{pattern}"))
        layer.insert(String("color"), Tag.Str(String(color)))
        layers.push(Tag.Compound(layer))
    }
    var display = JavaHashMap<String, Tag>()
    display.insert(String("hidden_components"), Tag.List([Tag.Str(String("minecraft:banner_patterns"))]))
    var name = JavaHashMap<String, Tag>()
    name.insert(String("translate"), Tag.Str(String("block.minecraft.ominous_banner")))
    var components = JavaHashMap<String, Tag>()
    components.insert(String("minecraft:banner_patterns"), Tag.List(layers))
    components.insert(String("minecraft:tooltip_display"), Tag.Compound(display))
    components.insert(String("minecraft:item_name"), Tag.Compound(name))
    components.insert(String("minecraft:rarity"), Tag.Str(String("uncommon")))
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String("minecraft:white_banner")))
    m.insert(String("count"), Tag.Int(1))
    m.insert(String("components"), Tag.Compound(components))
    return Tag.Compound(m)
}

// `getEquipmentForSlot`: the armor of the tier `tier` for the slot `slot`, by `EquipmentSlot`'s
// order, leather, copper, gold, chainmail, iron then diamond; none for another.
fn armor_for(slot: usize, tier: i32) -> String? {
    if tier < 0 or tier > 5 or slot < 2 or slot > 5 {
        return none
    }
    let materials = ["leather", "copper", "golden", "chainmail", "iron", "diamond"]
    let pieces = ["", "", "boots", "leggings", "chestplate", "helmet"]
    let material = materials[usize.wrap(tier)]
    let piece = pieces[slot]
    return some("minecraft:{material}_{piece}")
}

// Where `name` is among `names`, if it is.
fn index_of(names: List<String>, name: String) -> i32? {
    for i in 0..names.len() {
        if names[i] == name {
            return some(i32.wrap(i))
        }
    }
    return none
}

// `SheepColorSpawnRules.getSheepColor` in the `climate`, 0 temperate, 1 warm and 2 cold: of 100,
// three colors 5 each and one 3, the rest the climate's own, which is pink 1 in 500.
fn sheep_color<R: RandomSource>(climate: i32, r: mut R) -> i32 {
    // White 0, pink 6, gray 7, light gray 8, brown 12, black 15.
    let (a, b, c, d, usual) = if climate == 1 { (7, 8, 0, 15, 12) } else if climate == 2 { (8, 7, 0, 12, 15) } else { (15, 7, 8, 12, 0) }
    let pick = r.next_int_below(100)
    if pick < 5 {
        return a
    }
    if pick < 10 {
        return b
    }
    if pick < 15 {
        return c
    }
    if pick < 18 {
        return d
    }
    return if r.next_int_below(500) < 499 { usual } else { 6 }
}

// The tag at `key`, or none.
fn string_at(tag: JavaHashMap<String, Tag>, key: str) -> Tag {
    if tag.contains(key) {
        return tag[key].copy()
    }
    return Tag.End
}

// The number at `key` as a long, `getLong`, whatever kind of number it's saved as, none where
// there's none.
fn long_at(tag: JavaHashMap<String, Tag>, key: str) -> i64? {
    if not tag.contains(key) {
        return none
    }
    return tag[key].long_value()
}

// A block's place saved at `key` in `tag` as `BlockPos.CODEC` reads it, three ints in an int array
// or a list; none where it's not (CAL-177).
fn block_pos_at(tag: JavaHashMap<String, Tag>, key: str) -> (i32, i32, i32)? {
    if not tag.contains(key) {
        return none
    }
    var ints = List<i32>()
    match tag[key] {
        Tag.IntArray(v) => {
            for n in v {
                ints.push(n)
            }
        },
        Tag.List(v) => {
            for item in v {
                if let Tag.Int(n) = item {
                    ints.push(n)
                }
            }
            if ints.len() != v.len() {
                return none
            }
        },
        _ => {},
    }
    if ints.len() != 3 {
        return none
    }
    return some((ints[0], ints[1], ints[2]))
}

// A block's place as `BlockPos.CODEC` saves it, an int array (CAL-177).
fn block_pos_tag(pos: (i32, i32, i32)) -> Tag {
    let (x, y, z) = pos
    return Tag.IntArray([x, y, z])
}

// The name of the entry `id` of the built-in registry at `registry` in `builtin_entries`' list,
// `minecraft:none` where there's no such entry.
fn builtin_name(registry: usize, id: i32) -> String {
    let entries = builtin_entries(registry)
    if id < 0 or usize.wrap(id) >= entries.len() {
        return String("minecraft:none")
    }
    return "minecraft:{entries[usize.wrap(id)]}"
}

// The ID of the entry `name` in the built-in registry at `registry`, if it holds it.
fn builtin_id(registry: usize, name: String) -> i32? {
    let entries = builtin_entries(registry)
    for i in 0..entries.len() {
        if "minecraft:{entries[i]}" == name {
            return some(i32.wrap(i))
        }
    }
    return none
}

// Whether the block at x, y, z is one a baby villager jumps on, `#villager_babies_can_jump_on_bed`.
fn jumpable<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    return f.tag(String("minecraft:villager_babies_can_jump_on_bed")).contains(f.block(state_at(blocks, x, y, z)))
}

// The state at x, y, z as a villager swinging doors reads it in one go (CAL-160): the last it
// swung there, `swung`, else the level's, which its level only changes as its brain's tick stops.
fn door_state<B: CollisionBlocks>(blocks: B, swung: List<(i32, i32, i32, u32)>, x: i32, y: i32, z: i32) -> u32 {
    var k = swung.len()
    while k > 0 {
        k -= 1
        let (sx, sy, sz, s) = swung[k]
        if sx == x and sy == y and sz == z {
            return s
        }
    }
    return state_at(blocks, x, y, z)
}

// `DoorInteractGoal.isOpen`: whether its door's open, where it's still a door, else it has
// none.
fn door_open<B: CollisionBlocks>(g: mut DoorGoal, f: Facts, blocks: B) -> bool {
    if not g.has_door {
        return false
    }
    let state = state_at(blocks, g.pos.x, g.pos.y, g.pos.z)
    if not f.is_a(f.block(state), "DoorBlock") {
        g.has_door = false
        return false
    }
    return f.get_bool(state, "open")
}

// `getCelebrateSound`, a raider's by its kind (CAL-167).
fn celebrate_sound(species: i32) -> str {
    return if species == PILLAGER {
        "entity.pillager.celebrate"
    } else if species == VINDICATOR {
        "entity.vindicator.celebrate"
    } else if species == EVOKER {
        "entity.evoker.celebrate"
    } else if species == WITCH {
        "entity.witch.celebrate"
    } else {
        "entity.ravager.celebrate"
    }
}

// `DoorBlock.isWoodenDoor`: whether `state` is a door opened by hand, any but iron (CAL-167).
fn wooden_door(f: Facts, iron: u32?, state: u32) -> bool {
    let block = f.block(state)
    return f.is_a(block, "DoorBlock") and some(block) != iron
}

// Whether `state` is a door mobs open, `#mob_interactable_doors` and a `DoorBlock` (CAL-160).
fn mob_door(f: Facts, state: u32) -> bool {
    let block = f.block(state)
    return f.is_a(block, "DoorBlock") and f.tag(String("minecraft:mob_interactable_doors")).contains(block)
}

// `rememberDoorToClose` (CAL-160): the door at `pos` in `dimension` added to those the brain
// keeps to close, `DOORS_TO_CLOSE`, where it isn't there yet, those made where there are none.
fn remember_door(brain: mut Brain, dimension: String, pos: (i32, i32, i32)) {
    let (x, y, z) = pos
    var doors = brain.places(MEMORY_DOORS_TO_CLOSE)
    for g in doors {
        if g.dimension == dimension and g.pos.x == x and g.pos.y == y and g.pos.z == z {
            return
        }
    }
    doors.push(GlobalPos { dimension: dimension.copy(), pos: BlockPos { x: x, y: y, z: z } })
    brain.set(MEMORY_DOORS_TO_CLOSE, Memo.Places(doors))
}

// `ShowTradesToPlayer.lookAtTarget`: what the brain interacts with looked at, at its eyes, and
// which that is.
fn look_at_interaction(brain: mut Brain) -> i32? {
    let id = brain.entity(MEMORY_INTERACTION_TARGET) else return none
    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
    return some(id)
}

// A villager's data as `VillagerData.CODEC` reads it: its type and profession by name, plains and
// none where they're missing or unknown, and its level, at least 1.
fn villager_of(v: JavaHashMap<String, Tag>) -> (i32, i32, i32) {
    var kind = PLAINS_VILLAGERS
    if let Tag.Str(name) = string_at(v, "type") {
        if let at = builtin_id(23, name.copy()) {
            kind = at
        }
    }
    var profession = 0
    if let Tag.Str(name) = string_at(v, "profession") {
        if let at = builtin_id(24, name.copy()) {
            profession = at
        }
    }
    let level = int_or(v, "level", 1)
    return (kind, profession, if level < 1 { 1 } else { level })
}

// A flag as a byte, as `putBoolean` saves it.
fn flag_tag(on: bool) -> Tag {
    return Tag.Byte(if on { 1i8 } else { 0i8 })
}

// What a mob's navigation reads of its level besides its blocks, for a tick.
fn nav_facts<B: NavLevel>(lf: LivingFacts, blocks: B, min_y: i32) -> NavFacts {
    return NavFacts { min_y: min_y, top_y: blocks.top_y(), time: blocks.level_time(), floatable: lf.paths.floatable }
}

// What a goal is asked by its selector.
/// What a player's use of a mob did, `InteractionResult`: nothing, `PASS`; or it was used, the
/// client swinging the player's arm, `SUCCESS`, the server swinging it, `SUCCESS_SERVER`, or no one,
/// `CONSUME` (CAL-158).
pub const INTERACT_PASS: i32 = 0
pub const INTERACT_SUCCESS: i32 = 1
pub const INTERACT_SERVER: i32 = 2
pub const INTERACT_CONSUME: i32 = 3

/// A use of a mob's result, by its `INTERACT_` kind, and whether it used one of what the hand
/// held, `usePlayerItem`; and the sounds it made, for its level to play (CAL-160).
pub struct Interaction {
    pub result: i32
    pub used: bool
    /// Whether one of what was used is taken even from a creative player, `shrink`, as wolf armor's
    /// repair takes its scute; whether its level puts one of it on as its body armor, kept whole as
    /// it drops, `setItemSlotAndDropWhenKilled`; and whether it mends its body armor by an eighth of
    /// its most durability, a wolf's (CAL-201).
    pub shrinks: bool = false
    pub body_armor: bool = false
    pub armor_repair: bool = false
    pub sounds: List<EntitySound> = List<EntitySound>()
    /// Whether a villager's to start trading with the player who used it, `startTrading`, which
    /// its level does, as it opens their merchant menu (CAL-160).
    pub trades: bool = false
    /// Whether the player talked to a villager, which counts their `TALKED_TO_VILLAGER`
    /// (CAL-164).
    pub talked: bool = false
    /// What its level drops where it was, `spawnAtLocation`, as an armadillo's brushed scute
    /// (CAL-160).
    pub dropped: Laid? = none
    /// What its level drops at the place given, `spawnAtLocation`, unless the player has
    /// infinite materials, `hasInfiniteMaterials`, as the food a panda held as it's given more
    /// (CAL-201).
    pub spilled: (f64, f64, f64, Tag)? = none
    /// What its level drops at the place given, `spawnAtLocation`, whoever the player is, as the
    /// block a sulfur cube held as it's sheared or given another (CAL-402).
    pub ejected: (f64, f64, f64, Tag)? = none
    /// What the player's shown above their hotbar, by its translation key, as a sulfur cube lit
    /// where TNT doesn't explode; and whether their use of what they held is counted,
    /// `ITEM_USED` (CAL-402).
    pub told: String? = none
    pub stat_used: bool = false
    /// Whether its level puts one of what was used in its body, kept whole as it drops and it
    /// kept, `setItemSlotAndDropWhenKilled`, as a sulfur cube swallows a block (CAL-402).
    pub swallowed: bool = false
    /// The wear on what the player used it with, `hurtAndBreak`, as a brush's (CAL-160).
    pub wear: i32 = 0
    /// Whether it's a sheep the player shears, `Sheep.shear`, which its level does, as it rolls
    /// the wool it drops (CAL-179).
    pub shorn: bool = false
    /// What the player's hand is filled with, `ItemUtils.createFilledResult`, and whether a
    /// creative player's stack is kept as it is, `limitCreativeStackSize`, as milk fills a bucket
    /// (CAL-179).
    pub filled: (Tag, bool)? = none
    /// A sound the player plays, `Player.playSound`, heard by those near but them, as their
    /// milking (CAL-179).
    pub player_sound: String? = none
    /// What Calcite hasn't yet of the use, said to be missing (CAL-179).
    pub missing: String? = none
    /// Particles its level sends half up it, before its sounds, spread half a block across and up
    /// at 0.2, `ALTERNATIVE_WITH_SPEED`: their type, how many and their options as the packet
    /// writes them, as a brown mooshroom's fed a flower (CAL-179).
    pub burst: (String, i32, List<u8>)? = none
    pub burst_at: (f64, f64, f64) = (0.0, 0.0, 0.0)
    /// Whether it was taken in a bucket, `Bucketable.bucketMobPickup`, so its level counts the
    /// player's `FILLED_BUCKET` and takes it away, `discard` (CAL-179).
    pub bucketed: bool = false
    /// Whether it was a use without the item, `withoutItem`, as a leash's is, whose
    /// `PLAYER_INTERACTED_WITH_ENTITY` is of nothing held (CAL-179).
    pub without_item: bool = false
    /// Whether the player's to ride it, `startRiding`, which its level does, turned first as it
    /// looks where that's some, `doPlayerRide` (CAL-179).
    pub rides: bool = false
    pub rides_turned: (f32, f32)? = none
    /// And how a horse turns them once they're on it, to where it looked last tick,
    /// `addPassenger`'s `absSnapRotationTo(getViewYRot(0), getViewXRot(0))` (CAL-179).
    pub rides_view: (f32, f32)? = none
    /// Whether its inventory opens for the player, which its level does,
    /// `openCustomInventoryScreen` (CAL-179).
    pub opens_mount: bool = false
    /// Whether the player's poisonous food hurts it to death, a parrot's, `playerAttack` by
    /// `Float.MAX_VALUE` where they're in creative mode or it isn't invulnerable, which its level
    /// deals (CAL-201).
    pub poisoned: bool = false
}

// The stew effects of a flower a brown mooshroom may be fed, `SuspiciousEffectHolder.tryGet`,
// as `SuspiciousStewEffects`' codec writes them, or none for what isn't one (CAL-179): a
// `FlowerBlock`'s, an eyeblossom's and a wither rose's, each one effect for its seconds' ticks,
// `makeEffectList`'s `floor(seconds * 20)`.
fn stew_effects_of(item: String) -> Tag? {
    let flowers: List<(str, str, i32)> = [
        ("minecraft:dandelion", "minecraft:saturation", 7),
        ("minecraft:golden_dandelion", "minecraft:saturation", 7),
        ("minecraft:torchflower", "minecraft:night_vision", 100),
        ("minecraft:poppy", "minecraft:night_vision", 100),
        ("minecraft:blue_orchid", "minecraft:saturation", 7),
        ("minecraft:allium", "minecraft:fire_resistance", 60),
        ("minecraft:azure_bluet", "minecraft:blindness", 220),
        ("minecraft:red_tulip", "minecraft:weakness", 140),
        ("minecraft:orange_tulip", "minecraft:weakness", 140),
        ("minecraft:white_tulip", "minecraft:weakness", 140),
        ("minecraft:pink_tulip", "minecraft:weakness", 140),
        ("minecraft:oxeye_daisy", "minecraft:regeneration", 140),
        ("minecraft:cornflower", "minecraft:jump_boost", 100),
        ("minecraft:wither_rose", "minecraft:wither", 140),
        ("minecraft:lily_of_the_valley", "minecraft:poison", 220),
        ("minecraft:open_eyeblossom", "minecraft:blindness", 220),
        ("minecraft:closed_eyeblossom", "minecraft:nausea", 140),
    ]
    for (flower, effect, ticks) in flowers {
        if item == flower {
            var entry = JavaHashMap<String, Tag>()
            entry.insert(String("id"), Tag.Str(String(effect)))
            entry.insert(String("duration"), Tag.Int(ticks))
            return some(Tag.List([Tag.Compound(entry)]))
        }
    }
    return none
}

/// What a spawn egg of a mob's own kind makes of it, `Mob.hatch` (CAL-179): a baby, as breeding
/// asks of its level; nothing, as it can't be a baby; or what Calcite hasn't yet, said to be
/// missing.
pub enum Hatch {
    Baby(Bred)
    Unborn
    Missing(String)
}

/// The player a villager trades with, by their entity ID and their UUID (CAL-160).
pub struct Trader {
    pub id: i32
    pub uuid: (i64, i64)
}

/// What a villager's trade gave, `rewardTradeXp` (CAL-160): the experience of the orb its level's
/// to make, where the offer rewards it; and whether it went up a level, `increaseMerchantCareer`,
/// so its level's to add the next level's offers, `updateTrades`.
pub struct TradeReward {
    pub orb: i32? = none
    pub leveled: bool = false
}

// `SimpleContainer.addItem` of `stack` into `slots` (CAL-160): put with the stacks of the same item
// and components, from the first slot, as far as each holds, the least of 99 and its most,
// `getMaxStackSize`, then the rest, all of it, in the first empty slot; what's left, none where it
// all went in.
fn add_to(slots: mut List<Tag?>, stack: Tag, f: Facts) -> Tag? {
    var left = count_of(some(stack.copy()))
    if left <= 0 {
        return none
    }
    for i in 0..slots.len() {
        let here = slots[i].copy() else continue
        if not same_components(some(here.copy()), some(stack.copy())) {
            continue
        }
        let have = count_of(some(here.copy()))
        let most = min_i32(99, stack_limit(f, here))
        let diff = min_i32(left, most - have)
        if diff > 0 {
            slots[i] = some(stack_of_count(here, have + diff))
            left -= diff
        }
        if left == 0 {
            return none
        }
    }
    for i in 0..slots.len() {
        if slots[i] == none {
            slots[i] = some(stack_of_count(stack, left))
            return none
        }
    }
    return some(stack_of_count(stack, left))
}

// `ItemStack.getMaxStackSize` of `stack`: its own `max_stack_size` where its components set it, 1
// where they take it away, else its item's.
fn stack_limit(f: Facts, stack: Tag) -> i32 {
    let Tag.Compound(m) = stack else return 64
    if m.contains("components") {
        if let Tag.Compound(c) = m["components"] {
            if c.contains("minecraft:max_stack_size") {
                if let Tag.Int(n) = c["minecraft:max_stack_size"] {
                    return n
                }
            }
            if c.contains("!minecraft:max_stack_size") {
                return 1
            }
        }
    }
    return f.max_stack_size(held_name(some(stack.copy())))
}

// `HarvestFarmland.validPos` of the block at x, y, z (CAL-160): a crop at its last age, or air on
// farmland.
fn workable<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let state = state_at(blocks, x, y, z)
    let block = f.block(state)
    if f.is_a(block, String("CropBlock")) and (f.get_int(state, String("age")) ?? 0) >= f.crop_max_age(block) {
        return true
    }
    return f.is_air(state) and f.is_a(f.block(state_at(blocks, x, y - 1, z)), String("FarmlandBlock"))
}

// `HarvestFarmland.getValidFarmland`: one of `farmland` drawn from the level's random, or none
// where there's none.
fn pick_farmland(farmland: List<(i32, i32, i32)>, random: mut TapedRandom) -> (i32, i32, i32)? {
    if farmland.is_empty() {
        return none
    }
    return some(farmland[usize.wrap(random.next_int_below(i32.wrap(farmland.len())))])
}

// `UseBonemeal.setCurrentCropAsTarget`: the crop, where there's one, looked at and walked to at
// half speed, near enough within 1.
fn target_crop(brain: mut Brain, crop: (i32, i32, i32)?) {
    let c = crop else return
    let (x, y, z) = c
    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: 0.5f32, close_enough: 1 }))
}

// `VillagerProfession.FARMER`'s `requestedItems`, which no other profession has any of.
fn farmer_requests() -> List<String> {
    return [String("minecraft:wheat"), String("minecraft:wheat_seeds"), String("minecraft:beetroot_seeds"), String("minecraft:bone_meal")]
}

// The items with a `villager_food` component, which villagers eat and count as food.
fn villager_foods() -> List<String> {
    return [String("minecraft:bread"), String("minecraft:carrot"), String("minecraft:potato"), String("minecraft:beetroot")]
}

// The `nutrition` of the item `id`'s `villager_food` component, bread's 4 and a carrot's,
// potato's or beetroot's 1, or 0 for an item without one.
fn villager_food(id: String) -> i32 {
    if id == "minecraft:bread" {
        return 4
    }
    if id == "minecraft:carrot" or id == "minecraft:potato" or id == "minecraft:beetroot" {
        return 1
    }
    return 0
}

/// The yaw of what gets up from the bed at bx, by, bz to sx, sy, sz, `stopSleeping`'s: turned to
/// the bed's floor's middle, `Vec3.atBottomCenterOf(bed).subtract(standUp).normalize()`, by
/// `Mth.atan2`, wrapped and made a float (CAL-160, D574).
pub fn bed_yaw(bx: i32, by: i32, bz: i32, sx: f64, sy: f64, sz: f64) -> f32 {
    let (dx, dy, dz) = (f64(bx) + 0.5 - sx, f64(by) - sy, f64(bz) + 0.5 - sz)
    let length = (dx * dx + dy * dy + dz * dz).sqrt()
    var (lx, lz) = (0.0, 0.0)
    if length >= f64(1.0e-5f32) {
        lx = dx / length
        lz = dz / length
    }
    let angle = table_atan2(lz, lx) ?? 0.0
    return f32.nearest(wrap_degrees_f64(angle * RAD_TO_DEG - 90.0))
}

/// `getSleepHeight` of the bed at x, y, z: a straw bed's head that of its foot, none where its
/// foot isn't there, `StrawBedBlock.getSleepHeight`, any other's `sleep_height` (D574).
pub fn bed_sleep_height<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, x: i32, y: i32, z: i32) -> f64? {
    let state = state_at(blocks, x, y, z)
    let block = f.block(state)
    if not f.is_a(block, "StrawBedBlock") or (f.get_name(state, "part") ?? String()) != "head" {
        return sleep_height(f, m, state, x, z)
    }
    // `getConnectedDirection` of a head: the way it faces, turned round.
    let facing = match facing_of(f, state) {
        ok(d) => d,
        err(_) => return none,
    }
    let (fx, fz) = (x - step_x(facing), z - step_z(facing))
    let foot = state_at(blocks, fx, y, fz)
    if f.block(foot) != block or (f.get_name(foot, "part") ?? String()) != "foot" {
        return none
    }
    return sleep_height(f, m, foot, fx, fz)
}

// `AbstractBedBlock.getSleepHeight` of the state at x, z: the top of its outline shape, none
// where it's no bed or has no shape (CAL-160).
fn sleep_height(f: Facts, m: MovementStates, state: u32, x: i32, z: i32) -> f64? {
    if not f.is_a(f.block(state), "AbstractBedBlock") {
        return none
    }
    var top: f64? = none
    for b in m.outline_boxes(f, state, x, z) {
        if top == none or b.max_y > (top ?? 0.0) {
            top = some(b.max_y)
        }
    }
    return top
}

// `stack` with `n` of it.
fn stack_of_count(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

fn min_i32(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

// `getOffers` of a villager whose offers are made where `made` (CAL-160): where they're still to
// make, the level makes them as it's done ticking, `Shown.Offers`, so what's done to them till
// then is counted in `fresh`, from 0, the times their demand's updated; fresh offers have no
// uses, so nothing else changes them.
fn ask_offers(made: bool, fresh: mut i32?) {
    if not made and fresh == none {
        fresh = some(0)
    }
}

// `VillagerData.getMaxXpPerLevel`: the experience a villager at `level`, 1 to 4, goes up a level
// with; 0 for one that can't.
fn next_level_xp(level: i32) -> i32 {
    let thresholds: List<i32> = [0, 10, 70, 150, 250]
    return if level >= 1 and level < 5 { thresholds[usize.wrap(level)] } else { 0 }
}

// `Mob.setAggressive`'s bit of its flags (CAL-159).
const AGGRESSIVE_FLAG: i32 = 4

// The offset a silverfish's look for its friends goes to after `v`, 0, 1, -1, 2, -2 and on,
// `(v <= 0 ? 1 : 0) - v` (CAL-172).
fn look_step(v: i32) -> i32 {
    return (if v <= 0 { 1 } else { 0 }) - v
}

const GOAL_CAN_USE: i32 = 0
const GOAL_CONTINUE: i32 = 1
const GOAL_START: i32 = 2
const GOAL_STOP: i32 = 3
const GOAL_TICK: i32 = 4

// `Mth.floor`.
fn floor_of(v: f64) -> i32 {
    return i32.saturate(v.floor())
}

// The place among `players` of the one `id`, where it's still in the level.
// `asValidTarget` of the player `id` among `players` (CAL-159): them where they aren't in creative
// or spectating and may be seen as an enemy, `canAttack`, alive and not invulnerable; none for
// anyone else, as mobs come later.
// `Wolf.wantsToAttack` of `who`, its owner `owner` (CAL-201): not a creeper or a ghast (nor an
// armor stand, which isn't among what it finds); a wolf only where it isn't tame or isn't
// theirs; a player only where they may harm them, `canHarmPlayer`, not of their team where it
// keeps friendly fire off; not a tamed horse nor any other tame animal.
fn wolf_wants(who: Follower, owner: Follower) -> bool {
    if who.mob {
        if who.species == CREEPER or who.species == GHAST {
            return false
        }
        if who.species == WOLF {
            return not who.tamed or who.owner != owner.uuid
        }
        return not who.tamed
    }
    if let team = owner.team {
        if who.team == some(team.copy()) and not owner.friendly_fire {
            return false
        }
    }
    return true
}

fn valid_target(players: List<Follower>, id: i32) -> Follower? {
    let at = player_at(players, id) else return none
    let p = players[at].copy()
    if p.creative or p.spectator or p.dead or not p.enemy {
        return none
    }
    return some(p)
}

fn player_at(players: List<Follower>, id: i32) -> usize? {
    for i in 0..players.len() {
        if players[i].id == id {
            return some(i)
        }
    }
    return none
}

// The name of the dye `id`, in `DyeColor`'s order (D416).
fn dye_name(id: i32) -> str {
    let names: List<str> = ["white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black"]
    if id < 0 or usize.wrap(id) >= names.len() {
        return "white"
    }
    return names[usize.wrap(id)]
}

/// The ID of the dye named `name`, as `red`, in `DyeColor`'s order, as a dye's `minecraft:dye`
/// names it (CAL-179); none for another.
pub fn dye_id(name: String) -> i32? {
    for id in 0..16 {
        if name == dye_name(id) {
            return some(id)
        }
    }
    return none
}

// Whether `stack` is enchanted with one that keeps it from dropping, `prevent_equipment_drop`,
// curse of vanishing (D416).
fn vanishes<W: Wearing>(items: W, stack: Tag) -> bool {
    for (_, definition) in items.worn_enchantments(stack) {
        if definition.contains("effects") {
            if let Tag.Compound(effects) = definition["effects"] {
                if effects.contains("minecraft:prevent_equipment_drop") {
                    return true
                }
            }
        }
    }
    return false
}

// Whether an enchantment of `stack` keeps it on, `PREVENT_ARMOR_CHANGE`, as binding's curse does
// (CAL-159).
fn binds<W: Wearing>(items: W, stack: Tag) -> bool {
    for (_, definition) in items.worn_enchantments(stack) {
        if definition.contains("effects") {
            if let Tag.Compound(effects) = definition["effects"] {
                if effects.contains("minecraft:prevent_armor_change") {
                    return true
                }
            }
        }
    }
    return false
}

// The slot of `stack`'s equippable, by `EquipmentSlot`'s order, none where it hasn't one or it
// names no slot (CAL-159).
fn equippable_slot<W: Wearing>(items: W, stack: Tag) -> usize? {
    let Tag.Compound(e) = items.worn_component(stack, String("minecraft:equippable")) ?? Tag.End else return none
    if not e.contains("slot") {
        return none
    }
    let Tag.Str(named) = e["slot"] else return none
    let names = slot_names()
    for i in 0..names.len() {
        if names[i] == named {
            return some(i)
        }
    }
    return none
}


// `canReplaceEqualItem` (CAL-159): `stack` replaces `old` with more enchantments, or as many and
// less damage, `getDamageValue`, or as much and a custom name where `old` hasn't one.
fn replaces_equal<W: Wearing>(items: W, stack: Tag, old: Tag) -> bool {
    let more = items.worn_enchantments(stack.copy()).len()
    let had = items.worn_enchantments(old.copy()).len()
    if more != had {
        return more > had
    }
    let damage = damage_value(items, stack.copy())
    let was = damage_value(items, old.copy())
    if damage != was {
        return damage < was
    }
    return items.worn_component(stack, String("minecraft:custom_name")) != none and items.worn_component(old, String("minecraft:custom_name")) == none
}

// `getDamageValue`: its damage, kept within 0 and its most, `max_damage`, which is 0 where it
// hasn't one (CAL-159).
fn damage_value<W: Wearing>(items: W, stack: Tag) -> i32 {
    let most = int_component(items, stack.copy(), "minecraft:max_damage") ?? 0
    let damage = int_component(items, stack, "minecraft:damage") ?? 0
    return if damage < 0 { 0 } else if damage > most { most } else { damage }
}

// The component `name` of `stack` as a number, none where it hasn't it.
fn int_component<W: Wearing>(items: W, stack: Tag, name: str) -> i32? {
    let t = items.worn_component(stack, String(name)) else return none
    return t.number_int()
}

// `setDamageValue`: `stack` with its damage `damage`, none in its patch where that's its item's
// own, 0.
fn damaged_to(stack: own Tag, damage: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    var components = JavaHashMap<String, Tag>()
    if out.contains("components") {
        if let Tag.Compound(c) = out["components"] {
            components = c.copy()
        }
    }
    if damage == 0 {
        _ = components.remove(String("minecraft:damage"))
    } else {
        components.insert(String("minecraft:damage"), Tag.Int(damage))
    }
    if components.is_empty() {
        _ = out.remove(String("components"))
    } else {
        out.insert(String("components"), Tag.Compound(components))
    }
    return Tag.Compound(out)
}

// Whether `stack` is of the item `name` (D416).
fn stack_named(stack: Tag?, name: str) -> bool {
    let s = stack else return false
    let Tag.Compound(m) = s else return false
    return m.contains("id") and m["id"] == Tag.Str(String(name))
}

// Whether the block at x, y, z holds water, its fluid's tag `#water` (D434).
fn water_at<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let l = liquid_of(f, blocks.collision_state(x, y, z) ?? 0)
    return l.fluid == WATER_FLUID or l.fluid == FLOWING_WATER
}

// `Math.signum` (CAL-201): 1 above 0, -1 below, else itself.
fn signum(v: f64) -> f64 {
    return if v > 0.0 { 1.0 } else if v < 0.0 { -1.0 } else { v }
}

// `RemoveBlockGoal.isValidTarget` (CAL-201): the block `want` at x, y, z in a full chunk, with air
// above it twice.
fn removable_at<B: CollisionBlocks>(f: Facts, blocks: B, want: u32, x: i32, y: i32, z: i32) -> bool {
    let state = blocks.collision_state(x, y, z) else return false
    return f.block(state) == want and f.is_air(state_at(blocks, x, y + 1, z)) and f.is_air(state_at(blocks, x, y + 2, z))
}

// `RemoveBlockGoal.getPosWithBlock` (CAL-201): the block `want` where a mob stands at x, y, z, else
// the first by it of below, west, east, north, south and two below.
fn block_by<B: CollisionBlocks>(f: Facts, blocks: B, want: u32, x: i32, y: i32, z: i32) -> (i32, i32, i32)? {
    for (px, py, pz) in [(x, y, z), (x, y - 1, z), (x - 1, y, z), (x + 1, y, z), (x, y, z - 1), (x, y, z + 1), (x, y - 2, z)] {
        if f.block(state_at(blocks, px, py, pz)) == want {
            return some((px, py, pz))
        }
    }
    return none
}

// `TurtleLayEggGoal.isValidTarget`, air above sand, `TurtleEggBlock.isSand`, where `lay`, else
// `TurtleGoToWaterGoal.isValidTarget`, a water block (CAL-201).
fn turtle_block_at<B: CollisionBlocks>(lay: bool, lf: LivingFacts, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    if lay {
        return f.is_air(state_at(blocks, x, y + 1, z)) and f.in_set(state_at(blocks, x, y, z), lf.sand)
    }
    return f.block(state_at(blocks, x, y, z)) == lf.water_block
}

// `LevelReader.hasChunksAt` of the blocks from `x0`, `z0` to `x1`, `z1` (CAL-201): whether each
// chunk they're in is full, `hasChunk`, as its heightmap's there, `column_height`.
fn chunks_loaded<B: NavLevel>(blocks: B, x0: i32, z0: i32, x1: i32, z1: i32) -> bool {
    for cx in (x0 >> 4)..=(x1 >> 4) {
        for cz in (z0 >> 4)..=(z1 >> 4) {
            if blocks.column_height(MOTION_BLOCKING, cx << 4, cz << 4) == none {
                return false
            }
        }
    }
    return true
}

// `Mob.rotlerp`: `a` turned toward `b` by `max` degrees at most, not kept within a turn (CAL-159).
fn mob_rotlerp(a: f32, b: f32, max: f32) -> f32 {
    var diff = wrap_degrees(b - a)
    if diff > max {
        diff = max
    }
    if diff < -max {
        diff = -max
    }
    return a + diff
}

// `BowItem.getPowerForTime`: a bow drawn `held` ticks, its power from 0 to 1 (CAL-159).
pub fn bow_power(held: i32) -> f32 {
    let t = f32.nearest(held) / 20.0f32
    let p = (t * t + t * 2.0f32) / 3.0f32
    return if p > 1.0f32 { 1.0f32 } else { p }
}

/// The item of the stack `stack`, empty for none.
// `ItemStackTemplate.CODEC`'s form of `stack`: its ID, its count where it isn't 1, and its
// components where it has some (CAL-402).
fn template_of(stack: own Tag) -> Tag {
    let Tag.Compound(c) = stack else return stack
    var out = c.copy()
    if c.contains("count") and c["count"].number_int() == some(1) {
        _ = out.remove("count")
    }
    return Tag.Compound(out)
}

pub fn held_name(stack: Tag?) -> String {
    let held = stack.copy() else return String()
    let Tag.Compound(m) = held else return String()
    if not m.contains("id") {
        return String()
    }
    let Tag.Str(id) = m["id"] else return String()
    return id.copy()
}

// Whether the item is in `#arrows`, what a bow shoots, `ARROW_ONLY`.
fn is_arrow_item(name: String) -> bool {
    return name == "minecraft:arrow" or name == "minecraft:tipped_arrow" or name == "minecraft:spectral_arrow"
}

// One of the stack `stack`, `copyWithCount(1)`.
fn one_of(stack: Tag?) -> Tag {
    let held = stack.copy() else return stack_of(String("minecraft:arrow"))
    let Tag.Compound(m) = held else return held.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(1))
    return Tag.Compound(out)
}

// The stack `stack` with its count, 1 where it's left out, as `ItemStackTemplate.create` makes one
// (CAL-200).
pub fn whole_stack(stack: Tag) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    if not out.contains("count") {
        out.insert(String("count"), Tag.Int(1))
    }
    return Tag.Compound(out)
}

// The stack `stack` without its count where that's 1, as `ItemStackTemplate.CODEC` writes one
// (CAL-200).
pub fn uncounted(stack: Tag) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    if out.contains("count") and out["count"] == Tag.Int(1) {
        _ = out.remove(String("count"))
    }
    return Tag.Compound(out)
}

// The stack `stack` with its own component `name` set to `value` (CAL-200).
fn with_component(stack: Tag, name: str, value: Tag) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    var components = JavaHashMap<String, Tag>()
    if out.contains("components") {
        if let Tag.Compound(c) = out["components"] {
            components = c.copy()
        }
    }
    components.insert(String(name), value.copy())
    out.insert(String("components"), Tag.Compound(components))
    return Tag.Compound(out)
}

// The stack `stack` without its own component `name`, as setting a crossbow's charge to its
// default, `ChargedProjectiles.EMPTY`, leaves it, and without components where none's left
// (CAL-200).
pub fn without_component(stack: Tag, name: str) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    if not out.contains("components") {
        return Tag.Compound(out)
    }
    var components = JavaHashMap<String, Tag>()
    if let Tag.Compound(c) = out["components"] {
        components = c.copy()
    }
    _ = components.remove(String(name))
    if components.is_empty() {
        _ = out.remove(String("components"))
    } else {
        out.insert(String("components"), Tag.Compound(components))
    }
    return Tag.Compound(out)
}

// The stack's own component `name`, none where it hasn't one.
pub fn own_component(stack: Tag?, name: str) -> Tag? {
    let held = stack.copy() else return none
    let Tag.Compound(m) = held else return none
    if not m.contains("components") {
        return none
    }
    let Tag.Compound(c) = m["components"] else return none
    if not c.contains(name) {
        return none
    }
    return some(c[name].copy())
}

// The level of the enchantment `name` on the stack, by its own enchantments, which a crossbow's
// type doesn't give it (CAL-200).
pub fn own_enchantment_level(stack: Tag?, name: str) -> i32 {
    let Tag.Compound(levels) = own_component(stack, "minecraft:enchantments") ?? Tag.Compound(JavaHashMap<String, Tag>()) else return 0
    if not levels.contains(name) {
        return 0
    }
    return levels[name].number_int() ?? 0
}

// What a crossbow's charged with, `CHARGED_PROJECTILES`, none where it's not (CAL-200).
pub fn charged_of(stack: Tag) -> List<Tag> {
    let Tag.List(items) = own_component(some(stack.copy()), "minecraft:charged_projectiles") ?? Tag.List([]) else return List<Tag>()
    return items.copy()
}

// `CrossbowItem.isCharged` (CAL-200).
pub fn crossbow_charged(stack: Tag) -> bool {
    return not charged_of(stack).is_empty()
}

// `CrossbowItem.getChargeDuration` (CAL-200): 1.25 seconds, a quarter less for each level of
// quick charge, `crossbow_charge_time`, none below 0, in ticks, floored.
pub fn charge_duration(stack: Tag?) -> i32 {
    let quick = own_enchantment_level(stack, "minecraft:quick_charge")
    let less = 1.25f32 + -0.25f32 * f32.nearest(quick)
    let seconds = if less < 0.0f32 { 0.0f32 } else { less }
    return i32.saturate(f64(seconds * 20.0f32).floor())
}

// `Mth.clamp` of a block difference to within 127 either way, as `clampedPackDifferenceInPosition`
// has it.
fn clamp_i(d: i32) -> i32 {
    return if d < -127 { -127 } else if d > 127 { 127 } else { d }
}

// How long an armadillo's state's animation runs, `animationDuration`: rolling 10 ticks, scared
// 50 and unrolling 30 (CAL-160).
fn animation_of(state: i32) -> i32 {
    if state == ARMADILLO_ROLLING {
        return 10
    }
    if state == ARMADILLO_SCARED {
        return 50
    }
    if state == ARMADILLO_UNROLLING {
        return 30
    }
    return 0
}

// An armadillo's state's name, `getSerializedName`, as it's saved.
fn armadillo_state_name(state: i32) -> str {
    if state == ARMADILLO_ROLLING {
        return "rolling"
    }
    if state == ARMADILLO_SCARED {
        return "scared"
    }
    if state == ARMADILLO_UNROLLING {
        return "unrolling"
    }
    return "idle"
}

// The armadillo's state of the name `name`, idle for one it doesn't know.
fn armadillo_state_named(name: String) -> i32 {
    for state in [ARMADILLO_ROLLING, ARMADILLO_SCARED, ARMADILLO_UNROLLING] {
        if name == String(armadillo_state_name(state)) {
            return state
        }
    }
    return ARMADILLO_IDLE
}

// `Vec3.directionFromRotation`: the way a pitch of `x_rot` and a turn of `y_rot` look, by the
// sine table, its parts floats.
fn direction_from_rotation(x_rot: f32, y_rot: f32) -> (f64, f64, f64) {
    let y_cos = table_cos(f64(-y_rot * 0.017453292f32 - 3.1415927f32))
    let y_sin = table_sin(f64(-y_rot * 0.017453292f32 - 3.1415927f32))
    let x_cos = -table_cos(f64(-x_rot * 0.017453292f32))
    let x_sin = table_sin(f64(-x_rot * 0.017453292f32))
    return (f64(y_sin * x_cos), f64(x_sin), f64(y_cos * x_cos))
}

// The player nearest the egg's place, 0, `egg_y`, 0, an ender dragon may see as an enemy, by
// their entity ID and place, `NEW_TARGET_TARGETING` and `NEAR_EGG_TARGETING`, which see through
// walls: seen by anyone, alive and seen as an enemy, the first of the nearest (D613).
fn nearest_to_egg(players: List<Follower>, egg_y: i32) -> (i32, f64, f64, f64)? {
    var best = -1.0
    var found: (i32, f64, f64, f64)? = none
    for p in players {
        if p.spectator or p.dead or not p.enemy {
            continue
        }
        let dx = p.x - 0.0
        let dy = p.y - f64(egg_y)
        let dz = p.z - 0.0
        let d = dx * dx + dy * dy + dz * dz
        if best == -1.0 or d < best {
            best = d
            found = some((p.id, p.x, p.y, p.z))
        }
    }
    return found
}

// `Vec3.normalize`: none where it's shorter than 1e-5 (D613).
fn normalized_of(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let length = (x * x + y * y + z * z).sqrt()
    if length < f64(1.0e-5f32) {
        return (0.0, 0.0, 0.0)
    }
    return (x / length, y / length, z / length)
}

// `Mth.clamp` for doubles, and `Math.max` for floats, NaN kept (D613).
fn clamp_double(v: f64, lo: f64, hi: f64) -> f64 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}

fn most_of_float(v: f32, floor: f32) -> f32 {
    return if v < floor { floor } else { v }
}

// `Drowned.okTarget` of `t` (CAL-175): any by night, by day only one in water, `isInWater`.
fn ok_target<B: MobLight>(blocks: B, t: Follower) -> bool {
    return not blocks.bright_outside() or t.in_water
}

/// How a phantom of `size` is scaled from its type's dimensions, `1 + 0.15 * size`, a float
/// (CAL-200).
pub fn phantom_scale(size: i32) -> f32 {
    return 1.0f32 + 0.15f32 * f32.nearest(f64(size))
}

/// `Mth.approach`: `current` moved `increment`, whichever way, toward `target`, no further.
fn approach(current: f32, target: f32, increment: f32) -> f32 {
    let step = increment.abs()
    if current < target {
        let moved = current + step
        return if moved < current { current } else if moved > target { target } else { moved }
    }
    let moved = current - step
    return if moved < target { target } else if moved > current { current } else { moved }
}

/// `Mth.approachDegrees`: `current` moved `increment` at most the short way round toward `target`.
fn approach_degrees(current: f32, target: f32, increment: f32) -> f32 {
    let difference = wrap_degrees(target - current)
    return approach(current, current + difference, increment)
}

// How far out a shulker's lid is for a peek, `Shulker.getPhysicalPeek` (CAL-200).
fn physical_peek(amount: f32) -> f32 {
    let pi = f32.nearest(3.141592653589793)
    return 0.5f32 - table_sin(f64((0.5f32 + amount) * pi)) * 0.5f32
}

// A shulker's box, as offsets from where it is, opened from `from` to `to` toward `d`,
// `Shulker.getProgressDeltaAabb` at a scale of 1: a block's box around it pushed out toward `d`
// by the most of them, `expandTowards`, then pulled in from there by 1 and the least,
// `contract`.
fn progress_box(d: i32, from: f32, to: f32) -> (f64, f64, f64, f64, f64, f64) {
    let most = f64(if from > to { from } else { to })
    let least = f64(if from < to { from } else { to })
    let (sx, sy, sz) = (f64(step_x(d)), f64(step_y(d)), f64(step_z(d)))
    var (x0, y0, z0, x1, y1, z1) = (-0.5, 0.0, -0.5, 0.5, 1.0, 0.5)
    let (ex, ey, ez) = (sx * most, sy * most, sz * most)
    if ex < 0.0 { x0 += ex } else if ex > 0.0 { x1 += ex }
    if ey < 0.0 { y0 += ey } else if ey > 0.0 { y1 += ey }
    if ez < 0.0 { z0 += ez } else if ez > 0.0 { z1 += ez }
    let (cx, cy, cz) = (-sx * (1.0 + least), -sy * (1.0 + least), -sz * (1.0 + least))
    if cx < 0.0 { x0 -= cx } else if cx > 0.0 { x1 -= cx }
    if cy < 0.0 { y0 -= cy } else if cy > 0.0 { y1 -= cy }
    if cz < 0.0 { z0 -= cz } else if cz > 0.0 { z1 -= cz }
    return (x0, y0, z0, x1, y1, z1)
}

/// Players highest first, those as high kept in their order, as a stable sort by `getY` reversed
/// has them (CAL-200).
fn sort_highest(players: own List<Follower>) -> List<Follower> {
    var out = List<Follower>()
    for p in players {
        var at = out.len()
        while at > 0 and out[at - 1].y < p.y {
            at -= 1
        }
        out.insert(at, p.copy())
    }
    return out
}

// `canAttack` of the living entity `n`, `LivingEntity`'s: whether it may be seen as an enemy,
// `canBeSeenAsEnemy`, alive, not spectating and not invulnerable (CAL-200). A player in peaceful,
// which a hoglin never sees, as it's gone there, isn't.
fn can_attack_near(n: Near) -> bool {
    return n.enemy and n.alive and not n.spectator
}

// `SetEntityLookTargetSometimes.Ticker.tickDownAndCheck` of the count `keep` holds (CAL-200): at 0, its
// count drawn from `min` to `max` from `random` less one, and not yet; else down one, and now where
// that's 0.
fn tick_down_and_check<R: RandomSource>(keep: mut Keep, min: i32, max: i32, random: mut R) -> bool {
    if keep.ticks == 0 {
        keep.ticks = random.next_int_between(min, max) - 1
        return false
    }
    keep.ticks -= 1
    return keep.ticks == 0
}

// `HoglinAi.setAvoidTarget` (CAL-200): its target and walk forgotten, avoiding `target` for 5 to 20
// seconds, `RETREAT_DURATION`, drawn from `random`.
fn hoglin_avoid<R: RandomSource>(brain: mut Brain, target: i32, random: mut R) {
    brain.erase(MEMORY_ATTACK_TARGET)
    brain.erase(MEMORY_WALK_TARGET)
    let ticks = random.next_int_between(100, 400)
    brain.set_for(MEMORY_AVOID_TARGET, Memo.Entity(target), i64(ticks))
}

// `PiglinAi.hoglinsOutnumberPiglins` by a piglin's brain `brain`: more grown hoglins seen than grown
// piglins and itself (CAL-200).
fn hoglins_outnumber(brain: Brain) -> bool {
    let piglins = (brain.int(MEMORY_VISIBLE_ADULT_PIGLIN_COUNT) ?? 0) + 1
    let hoglins = brain.int(MEMORY_VISIBLE_ADULT_HOGLIN_COUNT) ?? 0
    return hoglins > piglins
}

// `PiglinAi.setAvoidTargetAndDontHuntForAWhile` of the entity `id` by a piglin's brain `brain`
// (CAL-200): what it's angry at, its target and its walk forgotten, avoiding `id` for 100 to 400
// ticks, then not hunting for 600 to 2,400, `dontKillAnyMoreHoglinsForAWhile`, both drawn from the
// level's `random`.
fn avoid_for_a_while<R: RandomSource>(brain: mut Brain, id: i32, random: mut R) {
    brain.erase(MEMORY_ANGRY_AT)
    brain.erase(MEMORY_ATTACK_TARGET)
    brain.erase(MEMORY_WALK_TARGET)
    brain.set_for(MEMORY_AVOID_TARGET, Memo.Entity(id), i64(random.next_int_between(100, 400)))
    dont_hunt_for_a_while(mut brain, mut random)
}

// `PiglinAi.dontKillAnyMoreHoglinsForAWhile` by a piglin's brain `brain` (CAL-200): not hunting
// for 600 to 2,400 ticks, `TIME_BETWEEN_HUNTS`, drawn from the level's `random`.
fn dont_hunt_for_a_while<R: RandomSource>(brain: mut Brain, random: mut R) {
    brain.set_for(MEMORY_HUNTED_RECENTLY, Memo.Flag(true), i64(random.next_int_between(600, 2400)))
}

// `HoglinAi.setAttackTarget` of the brain `brain` (CAL-200): its trouble reaching its walk target
// and what it breeds with forgotten, and `target` its target for 200 ticks.
fn hoglin_target_to(brain: mut Brain, target: i32) {
    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
    brain.erase(MEMORY_BREED_TARGET)
    brain.set_for(MEMORY_ATTACK_TARGET, Memo.Entity(target), 200)
}

// Whether the block at `x`, `y`, `z` is one a tame cat lies on, where `lie`, else sits on, its
// `isValidTarget` (CAL-201): air above it, and in `#cats_can_lie_on`, or in `#cats_can_sit_on`
// with a chest open to none, a furnace lit, and a bed not at its head.
// `RaidGardenGoal.isValidTarget` (CAL-201): a block that supports crops, `#supports_crops`, under
// grown carrots, `CarrotBlock.isMaxAge`, where it wants to raid and isn't yet able, which makes it
// able.
fn garden_at<B: CollisionBlocks + MobLight>(g: mut RaidGarden, lf: LivingFacts, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    if not g.wants or g.can or not f.in_set(state_at(blocks, x, y, z), lf.supports_crops) {
        return false
    }
    let above = state_at(blocks, x, y + 1, z)
    if f.block(above) != lf.carrots or (f.get_int(above, String("age")) ?? 0) < 7 {
        return false
    }
    g.can = true
    return true
}

// `Rabbit.getRandomRabbitVariant` (CAL-201): drawn under 100 from the level's random `r`, where the
// biome gives white rabbits, `kind` 1, white under 80, else white splotched; gold ones, 2, gold;
// else brown under 50, salt under 90, else black.
fn rabbit_variant_in<R: RandomSource>(kind: i32, r: mut R) -> i32 {
    let v = r.next_int_below(100)
    if kind == 1 {
        return if v < 80 { 1 } else { 3 }
    }
    if kind == 2 {
        return 4
    }
    return if v < 50 { 0 } else if v < 90 { 5 } else { 2 }
}

// `Rabbit.Variant.byId` (CAL-201): the variant of the ID, brown where it's none of them.
fn rabbit_variant_named(id: i32) -> i32 {
    if (id >= 0 and id <= 5) or id == RABBIT_EVIL {
        return id
    }
    return 0
}

fn cat_block_at<B: CollisionBlocks + MobLight>(lie: bool, lf: LivingFacts, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    if not f.is_air(state_at(blocks, x, y + 1, z)) {
        return false
    }
    let state = blocks.collision_state(x, y, z) else return false
    if lie {
        return f.in_set(state, lf.cats_lie_on)
    }
    if not f.in_set(state, lf.cats_sit_on) {
        return false
    }
    let block = f.block(state)
    if block == lf.chest {
        return blocks.chest_openers(x, y, z) < 1
    }
    if block == lf.furnace {
        return f.get_bool(state, "lit")
    }
    if f.in_set(state, lf.beds) {
        return (f.get_name(state, "part") ?? String()) != "head"
    }
    return true
}

// `stack` with `n` of it, as `setCount` does (CAL-201).
fn recounted(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

// `FoxEatBerriesGoal.isValidTarget` of the block at x, y, z (CAL-201): a sweet berry bush aged 2
// or more, or cave vines with glow berries, `CaveVines.hasGlowBerries`.
fn fox_berries_at<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let state = state_at(blocks, x, y, z)
    let block = f.block(state)
    if f.is_a(block, String("SweetBerryBushBlock")) {
        return (f.get_int(state, String("age")) ?? 0) >= 2
    }
    return (f.is_a(block, String("CaveVinesBlock")) or f.is_a(block, String("CaveVinesPlantBlock"))) and f.get_bool(state, String("berries"))
}

// A panda's gene of the ID `id`, `Gene.byId`, any but the seven normal, `OutOfBoundsStrategy.ZERO`
// (CAL-201).
fn gene_of(id: i32) -> i32 {
    return if id < 0 or id > 6 { GENE_NORMAL } else { id }
}

// `Gene.getRandom` of the draw `n`, below 16 (CAL-201): lazy at 0, worried at 1, playful at 2,
// aggressive at 4, weak at 3 and 5 to 8, brown at 9 and 10, else normal.
fn panda_gene_from(n: i32) -> i32 {
    if n == 0 {
        return GENE_LAZY
    }
    if n == 1 {
        return GENE_WORRIED
    }
    if n == 2 {
        return GENE_PLAYFUL
    }
    if n == 4 {
        return GENE_AGGRESSIVE
    }
    if n < 9 {
        return GENE_WEAK
    }
    return if n < 11 { GENE_BROWN } else { GENE_NORMAL }
}

// A panda's gene's name, `getSerializedName`, and its ID by its name, none for any other, as
// `Gene.CODEC` reads it (CAL-201).
fn gene_name(gene: i32) -> str {
    let names = ["normal", "lazy", "worried", "playful", "brown", "weak", "aggressive"]
    return names[usize.wrap(gene_of(gene))]
}

fn gene_named(name: String) -> i32? {
    for i in 0..7 {
        if name == gene_name(i) {
            return some(i)
        }
    }
    return none
}

// Whether the item `name` is what a panda eats from the ground, `#panda_eats_from_ground`
// (CAL-201).
fn panda_eats(lf: LivingFacts, name: String) -> bool {
    return lf.tempting.of(name) & TEMPT_PANDA_GROUND != 0u32
}

// `Mth.sign` of `v`: 1, -1, or 0 (CAL-201).
fn sign_of(v: f32) -> i32 {
    return if v > 0.0f32 { 1 } else if v < 0.0f32 { -1 } else { 0 }
}


// The mobs a parrot mimics, `Parrot.MOB_SOUND_MAP`'s keys, by their types' names, in the order
// they're put, each one's sound's name after `entity.parrot.imitate.`; a cave spider's a spider's
// and a happy ghast's none, `SoundEvents.EMPTY` (CAL-201).
fn parrot_mimicked() -> List<(str, str)> {
    return [("blaze", "blaze"), ("bogged", "bogged"), ("breeze", "breeze"), ("camel_husk", "camel_husk"), ("cave_spider", "spider"), ("creaking", "creaking"), ("creeper", "creeper"), ("drowned", "drowned"), ("elder_guardian", "elder_guardian"), ("ender_dragon", "ender_dragon"), ("endermite", "endermite"), ("evoker", "evoker"), ("ghast", "ghast"), ("happy_ghast", ""), ("guardian", "guardian"), ("hoglin", "hoglin"), ("husk", "husk"), ("illusioner", "illusioner"), ("magma_cube", "magma_cube"), ("parched", "parched"), ("phantom", "phantom"), ("piglin", "piglin"), ("piglin_brute", "piglin_brute"), ("pillager", "pillager"), ("ravager", "ravager"), ("shulker", "shulker"), ("silverfish", "silverfish"), ("skeleton", "skeleton"), ("slime", "slime"), ("spider", "spider"), ("stray", "stray"), ("vex", "vex"), ("vindicator", "vindicator"), ("warden", "warden"), ("witch", "witch"), ("wither", "wither"), ("wither_skeleton", "wither_skeleton"), ("zoglin", "zoglin"), ("zombie", "zombie"), ("zombie_horse", "zombie_horse"), ("zombie_nautilus", "zombie_nautilus"), ("zombie_villager", "zombie_villager")]
}

// A mimicked sound's name, `entity.parrot.imitate.` and its heard, or `intentionally_empty`.
fn mimic_sound(heard: str) -> String {
    if heard == "" {
        return String("intentionally_empty")
    }
    return "entity.parrot.imitate.{heard}"
}

// The sounds a parrot may mimic as its ambient one, `getAmbient`, in `parrot_mimicked`'s order
// (CAL-201).
pub fn parrot_mimics() -> List<String> {
    var out = List<String>()
    for (_, heard) in parrot_mimicked() {
        out.push(mimic_sound(heard))
    }
    return out
}

// The sound a parrot mimics the mob of the kind `species` with, `getImitatedSound`, none for a
// kind it doesn't, `NOT_PARROT_PREDICATE` (CAL-201).
pub fn parrot_mimic_of(species: i32) -> String? {
    let name = type_name(species).trim_prefix("minecraft:")
    for (kind, heard) in parrot_mimicked() {
        if kind == name {
            return some(mimic_sound(heard))
        }
    }
    return none
}

// The component `key` of a fish bucket's `components`, nothing where it has none (CAL-214).
fn bucket_component(components: JavaHashMap<String, Tag>, key: str) -> Tag {
    if components.contains(key) {
        return components[key].copy()
    }
    return Tag.End
}

/// A location-changed effect of an enchantment on what a mob has in the equipment slot `slot`
/// that holds, `entry` (CAL-218).
pub struct MobLocated {
    pub slot: usize
    pub entry: LocatedEntry
}

// `Vec3.yRot(90.0F)` of the offset, as `LongDistancePatrolGoal` turns it, by 90 radians through
// `Mth`'s sine table (CAL-167).
fn patrol_turn(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let c = f64(table_cos(90.0))
    let s = f64(table_sin(90.0))
    return (x * c + z * s, y, z * c - x * s)
}

// `Mth.nextDouble(random, min, max)` (CAL-401): `min` where it's not below `max`, else a draw
// between them.
fn mth_next_double(random: mut LegacyRandom, min: f64, max: f64) -> f64 {
    if min >= max {
        return min
    }
    return random.next_double() * (max - min) + min
}
