pub const SKELETON_HORSE: i32 = 68

/// A wither's own (CAL-401): its two side heads' turns, `xRotHeads` and `yRotHeads`, and the
/// ticks at which each looks again for what to shoot, `nextHeadUpdate`, and how many times each
/// has looked with nothing to shoot, `idleHeadUpdates`; the ticks till it breaks the blocks about
/// it, `destroyBlocksTick`; and its boss bar's UUID, `bossEvent`, drawn from its own random as
/// it's made, and how far along the bar is, `setProgress`.
pub struct WitherLife {
    pub x_rot_heads: List<f32> = [0.0f32, 0.0f32]
    pub y_rot_heads: List<f32> = [0.0f32, 0.0f32]
    pub next_head_update: List<i32> = [0, 0]
    pub idle_head_updates: List<i32> = [0, 0]
    pub destroy_blocks_tick: i32 = 0
    pub bar: (i64, i64) = (0i64, 0i64)
    pub progress: f32 = 1.0f32
    /// Whether its tick stopped for its level to break the blocks about it, to go on after
    /// (CAL-401).
    pub resuming: bool = false
}

/// A sulfur cube's own (CAL-402): its ticks till it may pick up a block again, `pickupTimer`, and
/// its fuse, `fuse`, -1 while it isn't primed.
pub struct SulfurLife {
    pub pickup_timer: i32 = 0
    pub fuse: i32 = -1
    pub push_sound_cooldown: i32 = 0
    /// What the archetypes of the block it holds make of it, `collectEquipmentChanges`: whether it
    /// floats in liquids, `floatsInLiquids`; its explosion, `explosionData`; its hurts of what it
    /// touches, `contactDamages`; its knockback's powers, `knockbackModifier`; and its sounds,
    /// `soundSettings`, the hit, the push, and the push's threshold and cooldown in seconds.
    pub buoyant: bool = false
    pub explosion: ArchetypeExplosion? = none
    pub contacts: List<ContactDamage> = List<ContactDamage>()
    pub horizontal: f32 = 0.33f32
    pub vertical: f32 = 0.06f32
    pub hit_sound: String = "entity.sulfur_cube.regular.hit"
    pub push_sound: String = "entity.sulfur_cube.regular.push"
    pub push_threshold: f32 = 0.2f32
    pub push_cooldown: f32 = 0.5f32
    /// The items its level found for its search, by ID and where they are.
    pub items: List<(i32, f64, f64, f64)> = List<(i32, f64, f64, f64)>()
}

/// A dolphin's own (CAL-201): where the treasure it swims to is, `treasurePos`, and whether it's
/// stuck on its way, `stuck`; the player it swims with, by ID, `DolphinSwimWithPlayerGoal.player`;
/// the tick count before which it won't go for an item again, `MoveToItemGoal.cooldown`; whether
/// its jump broke the water's top, `DolphinJumpGoal.breached`, which is never let go; the items
/// in water near it it may go for, which its level finds for it, by ID with their places; and
/// whether its world has structures, which its treasure is looked for among.
pub struct DolphinLife {
    pub treasure: (i32, i32, i32)? = none
    pub stuck: bool = false
    pub player: i32? = none
    pub item_cooldown: i32 = 0
    pub breached: bool = false
    pub items: List<(i32, f64, f64, f64)> = List<(i32, f64, f64, f64)>()
    pub structures: bool = true
    // `FollowPlayerRiddenEntityGoal`'s (CAL-315): the players steering boats within 5 of it, by
    // their IDs, as its level found the boats; the player it follows, `following`; its ticks till
    // it paths again, `timeToRecalcPath`; and whether it goes the way they face rather than behind
    // them, `GO_IN_ENTITY_DIRECTION`.
    pub boat_riders: List<i32> = List<i32>()
    pub following: i32? = none
    pub follow_recalc: i32 = 0
    pub follow_ahead: bool = false
}

/// A squid's own (CAL-201): its body's pitch and roll, `xBodyRot` and `zBodyRot`, and its pitch
/// as its last tick began, `xBodyRotO`; how far its tentacles are through their stroke,
/// `tentacleMovement`, and how fast they go, `tentacleSpeed`; how fast it turns, `rotateSpeed`;
/// and the motion it swims by, `movementVector`.
pub struct SquidLife {
    pub x_rot: f32 = 0.0f32
    pub x_rot_o: f32 = 0.0f32
    pub z_rot: f32 = 0.0f32
    pub tentacles: f32 = 0.0f32
    pub tentacle_speed: f32 = 0.0f32
    pub rotate_speed: f32 = 0.0f32
    pub movement: (f64, f64, f64) = (0.0, 0.0, 0.0)
    // Whether its tick stopped for its pushes, its own part of `aiStep` still to come.
    pub push_due: bool = false
}

/// A salmon's size, `Salmon.DATA_TYPE`, its variant's ID, after a fish's own (CAL-201).
pub const SALMON_TYPE: usize = 17

/// A tropical fish's variant, `TropicalFish.DATA_ID_TYPE_VARIANT`, packed, its pattern's ID, then
/// its base color's and its pattern's color's above, after a fish's own (CAL-201).
pub const TROPICAL_VARIANT: usize = 17

/// A pufferfish's puff, `Pufferfish.PUFF_STATE`, 0 small, 1 mid and 2 full, after a fish's own
/// (CAL-201).
pub const PUFF_STATE: usize = 17

/// A glow squid's ticks left dark, `GlowSquid.DATA_DARK_TICKS_REMAINING`, after an ageable mob's
/// own (CAL-201).
pub const GLOW_DARK: usize = 18

/// Whether a dolphin was given a fish, `Dolphin.GOT_FISH`, and how moist it is,
/// `MOISTNESS_LEVEL`, after an ageable mob's own (CAL-201).
pub const GOT_FISH: usize = 18
pub const MOISTNESS: usize = 19

/// A turtle's own (CAL-201): the block it calls home, `homePos`, saved as `home_pos`; the place
/// it travels toward in water, `travelPos`; whether it's going home, `goingHome`; and its count
/// of ticks laying an egg, `layEggCounter`.
pub struct TurtleLife {
    pub home: (i32, i32, i32) = (0, 0, 0)
    pub travel: (i32, i32, i32)? = none
    pub going_home: bool = false
    pub lay_counter: i32 = 0
    /// Whether it's grown since its scute was last given, `Turtle.ageBoundaryReached`.
    pub grew: bool = false
}
const FOX_SITTING: i32 = 1
const FOX_CROUCHING: i32 = 4
const FOX_INTERESTED: i32 = 8
const FOX_POUNCING: i32 = 16
const FOX_SLEEPING: i32 = 32
const FOX_FACEPLANTED: i32 = 64
const FOX_DEFENDING: i32 = 128

/// Whether the kind `species` is an enemy, `Enemy`, which an iron golem takes up as its target but
/// where it's a creeper (CAL-201): a monster, a slime, a magma cube, a phantom, a ghast, a shulker,
/// a hoglin or the ender dragon.
pub fn enemy_kind(species: i32) -> bool {
    if species == SLIME or species == MAGMA_CUBE or species == PHANTOM or species == GHAST or species == SHULKER or species == HOGLIN or species == ENDER_DRAGON {
        return true
    }
    return species == CREEPER or species == ZOMBIE or species == HUSK or species == DROWNED or species == SKELETON or species == STRAY or species == BOGGED or species == PARCHED or species == WITHER_SKELETON or species == SPIDER or species == CAVE_SPIDER or species == ENDERMAN or species == WITCH or species == ZOMBIE_VILLAGER or species == ENDERMITE or species == SILVERFISH or species == VINDICATOR or species == PILLAGER or species == RAVAGER or species == VEX or species == EVOKER or species == BLAZE or species == ZOMBIFIED_PIGLIN or species == ZOGLIN or species == PIGLIN_BRUTE or species == PIGLIN or species == GUARDIAN or species == ELDER_GUARDIAN or species == WITHER_BOSS
}

/// Whether the kind `species` is undead, `#undead`, which a wither's friends are too,
/// `#wither_friends` (CAL-401).
pub fn undead_kind(s: i32) -> bool {
    return s == ZOMBIE or s == HUSK or s == DROWNED or s == SKELETON or s == STRAY or s == BOGGED or s == PARCHED or s == WITHER_SKELETON or s == ZOMBIE_VILLAGER or s == ZOMBIE_HORSE or s == SKELETON_HORSE or s == PHANTOM or s == ZOMBIFIED_PIGLIN or s == ZOGLIN or s == WITHER_BOSS
}

/// Whether the kind `species` is a monster, `Monster`, which a rabbit flees (CAL-201): an enemy but
/// a slime, a magma cube, a phantom, a ghast, a shulker, a hoglin or the ender dragon.
pub fn monster_kind(species: i32) -> bool {
    if species == SLIME or species == MAGMA_CUBE or species == PHANTOM or species == GHAST or species == SHULKER or species == HOGLIN or species == ENDER_DRAGON {
        return false
    }
    return enemy_kind(species)
}

/// Whether the kind `species` is a cube mob, `AbstractCubeMob`: a slime or a magma cube (CAL-200),
/// or a sulfur cube (CAL-402).
pub fn cube_kind(species: i32) -> bool {
    return species == SLIME or species == MAGMA_CUBE or species == SULFUR_CUBE
}

/// Whether the kind `species` is a fish, `AbstractFish`: a cod (CAL-178) or a salmon (CAL-201).
pub fn fish_kind(species: i32) -> bool {
    return species == COD or species == SALMON or species == TROPICAL_FISH or species == PUFFERFISH
}

/// Whether the kind `species` is one a pufferfish doesn't puff up at nor sting,
/// `#not_scary_for_pufferfish`, of those Calcite makes (CAL-201).
pub fn pufferfish_fearless(species: i32) -> bool {
    return species == TURTLE or species == GUARDIAN or species == ELDER_GUARDIAN or fish_kind(species) or squid_kind(species)
}

/// Whether the kind `species` is a squid, `Squid`: a squid or a glow squid (CAL-201).
pub fn squid_kind(species: i32) -> bool {
    return species == SQUID or species == GLOW_SQUID
}

/// Whether the kind `species` lives in water, a fish, `WaterAnimal`, or a squid or a dolphin,
/// `AgeableWaterCreature`: out of it it runs out of air and drowns, but a dolphin, whose air is
/// its own; it spawns in any light; and only what blocks building keeps it from spawning
/// (CAL-201).
pub fn water_kind(species: i32) -> bool {
    return fish_kind(species) or squid_kind(species) or species == DOLPHIN
}

// The way a turn `y_rot` faces, `Direction.fromYRot`, as its steps across, x then z: south, west,
// north or east, a dolphin's jump's, `getMotionDirection` (CAL-201).
fn dolphin_facing(y_rot: f32) -> (i32, i32) {
    let v = i32.saturate((f64(y_rot) / 90.0 + 0.5).floor()) & 3
    return match v {
        0 => (0, 1),
        1 => (-1, 0),
        2 => (0, -1),
        _ => (1, 0),
    }
}

/// Whether the kind `species` is a schooling fish, `AbstractSchoolingFish`: a cod (CAL-178), a
/// salmon or a tropical fish (CAL-201).
pub fn schooling_kind(species: i32) -> bool {
    return species == COD or species == SALMON or species == TROPICAL_FISH
}

// A tropical fish's patterns' names, `TropicalFish.Pattern`, in its order, the small ones then
// the large, each's ID its base's, 0 small, 1 large, and its place among them 8 bits up (CAL-201).
fn tropical_patterns() -> List<str> {
    return ["kob", "sunstreak", "snooper", "dasher", "brinely", "spotty", "flopper", "stripey", "glitter", "blockfish", "betty", "clayfish"]
}

// `TropicalFish.COMMON_VARIANTS`, each its pattern's place in `TROPICAL_PATTERNS`, its base color
// and its pattern's color (CAL-201).
fn tropical_common() -> List<(i32, i32, i32)> {
    return [(7, 1, 7), (6, 7, 7), (6, 7, 11), (11, 0, 7), (1, 11, 7), (0, 1, 0), (5, 6, 3), (9, 10, 4), (11, 0, 14), (5, 0, 4), (8, 0, 7), (11, 0, 1), (3, 9, 6), (4, 5, 3), (10, 14, 0), (2, 7, 14), (9, 14, 0), (6, 0, 4), (0, 14, 0), (1, 7, 0), (3, 9, 4), (6, 4, 4)]
}

/// `TropicalFish.packVariant` of the pattern at `pattern` in its order, and the colors `base` and
/// `over`, by their IDs (CAL-201).
pub fn pack_tropical(pattern: i32, base: i32, over: i32) -> i32 {
    let id = (pattern / 6) | ((pattern % 6) << 8)
    return (id & 65535) | ((base & 255) << 16) | ((over & 255) << 24)
}

/// A tropical fish's packed variant as `TropicalFish.Variant`'s reads it again, its pattern by its
/// ID, kob where none has it, `ByIdMap.sparse`, and its colors by theirs, white where none has
/// them, `DyeColor.byId`: its pattern's place, its base color and its pattern's color (CAL-201).
pub fn unpack_tropical(packed: i32) -> (i32, i32, i32) {
    let id = packed & 65535
    let base = id & 255
    let index = id >> 8
    let pattern = if (base == 0 or base == 1) and index >= 0 and index < 6 { base * 6 + index } else { 0 }
    let b = (packed >> 16) & 255
    let o = (packed >> 24) & 255
    return (pattern, if b < 16 { b } else { 0 }, if o < 16 { o } else { 0 })
}

/// The name of the pattern at `pattern` in its order (CAL-201).
pub fn tropical_pattern_name(pattern: i32) -> String {
    return String(tropical_patterns()[usize.wrap(pattern)])
}

/// A salmon's size's name, `Salmon.Variant`'s, by its ID: small, medium or large (CAL-201).
pub fn salmon_size_name(size: i32) -> str {
    return if size == 0 { "small" } else if size == 2 { "large" } else { "medium" }
}

// The wool colors an evoker looks for and turns sheep, `DyeColor.BLUE` and `RED` (CAL-200).
const BLUE_WOOL: i32 = 11
pub const RED_WOOL: i32 = 14

/// Whether the kind `species` is a raider, `Raider`: a witch, an illager or a ravager (CAL-200).
pub fn raider_kind(species: i32) -> bool {
    return species == WITCH or species == RAVAGER or illager_kind(species)
}

/// Whether the kind `species` is an illager, `AbstractIllager`: a vindicator, a pillager or an
/// evoker (CAL-200).
pub fn illager_kind(species: i32) -> bool {
    return species == VINDICATOR or species == PILLAGER or species == EVOKER
}

/// Whether the kind `species` is of `Zombie`'s class: a zombie, a husk, a drowned, a zombie villager
/// (CAL-175) or a zombified piglin (CAL-200).
pub fn zombie_kind(species: i32) -> bool {
    return species == ZOMBIE or species == HUSK or species == DROWNED or species == ZOMBIE_VILLAGER or species == ZOMBIFIED_PIGLIN
}

/// An armadillo's states, `ArmadilloState`, by their IDs (CAL-160).
pub const ARMADILLO_IDLE: i32 = 0
pub const ARMADILLO_ROLLING: i32 = 1
pub const ARMADILLO_SCARED: i32 = 2
pub const ARMADILLO_UNROLLING: i32 = 3

// What a brain's `findClosest` looks for, `world.mob`'s `find_closest`: a player, a grown one of
// its kind, or a partner; and `find_closest_of`'s, one of a kind, one of a mob category, or a
// hostile a villager fears (CAL-160).
const PICK_PLAYER: i32 = 0
const PICK_ADULT: i32 = 1
const PICK_PARTNER: i32 = 2
const PICK_SPECIES: i32 = 3
const PICK_CATEGORY: i32 = 4
const PICK_HOSTILE: i32 = 5
const PICK_BREEDABLE: i32 = 6
// Any living entity, as a hoglin's `SetEntityLookTargetSometimes` looks at (CAL-200).
const PICK_ANY: i32 = 7
// A zoglin's prey, `Zoglin.findNearestValidAttackTarget`'s: what it may attack but a zoglin or a
// creeper (CAL-200).
const PICK_ZOGLIN_PREY: i32 = 8
// A player holding what piglins love, `PiglinAi.isPlayerHoldingLovedItem` (CAL-200).
const PICK_LOVED: i32 = 9

// `PoiManager.find` for `MoveThroughVillageGoal` (D605): the first point of interest of a
// village's types, taken, `IS_OCCUPIED`, within 10 of `at`, in `getInRange`'s order, that isn't
// one of those `visited`, `hasNotVisited`.
fn unvisited_poi(pois: Pois, at: BlockPos, visited: List<BlockPos>) -> BlockPos? {
    for r in pois.in_range(village_types(), at, 10, Occupancy.IsOccupied) {
        var seen = false
        for v in visited {
            if v.x == r.pos.x and v.y == r.pos.y and v.z == r.pos.z {
                seen = true
            }
        }
        if not seen {
            return some(r.pos)
        }
    }
    return none
}


// `Bee.attractsBees` (CAL-177): in `#bee_attractive`, not waterlogged, and of a sunflower only its
// upper half.
fn attracts_bees(lf: LivingFacts, f: Facts, state: u32) -> bool {
    if not f.in_set(state, lf.bee_attractive) or f.is_water(state) {
        return false
    }
    if f.block(state) == lf.sunflower {
        return (f.get_name(state, "half") ?? String()) == "upper"
    }
    return true
}

// The best of the places `tries` a bee drew, `RandomPos.generateRandomPos` (CAL-177): the first of
// those it would most go to, `getWalkTargetValue`, 10 in the air and 0 elsewhere.
fn best_for_bee<B: CollisionBlocks>(f: Facts, blocks: B, tries: List<(i32, i32, i32)?>) -> (i32, i32, i32)? {
    var best: (i32, i32, i32)? = none
    var most = -1.0
    for t in tries {
        if let p = t {
            let (x, y, z) = p
            let value = if f.is_air(state_at(blocks, x, y, z)) { 10.0 } else { 0.0 }
            if value > most {
                most = value
                best = some(p)
            }
        }
    }
    return best
}

// `Vec3.distanceTo`.
fn spot_distance(a: (f64, f64, f64), b: (f64, f64, f64)) -> f64 {
    let (ax, ay, az) = a
    let (bx, by, bz) = b
    return ((bx - ax) * (bx - ax) + (by - ay) * (by - ay) + (bz - az) * (bz - az)).sqrt()
}

// `Vec3i.distSqr`.
fn block_dist_sqr(a: BlockPos, b: BlockPos) -> f64 {
    let (dx, dy, dz) = (f64(a.x - b.x), f64(a.y - b.y), f64(a.z - b.z))
    return dx * dx + dy * dy + dz * dz
}

// `EvokerAttackSpellGoal.createSpellEntity` (CAL-200): from the block x, `max_y`, z down, while
// it's no lower than a block under `min_y`'s, the first whose block below is sturdy on top,
// `isFaceSturdy`; fangs there, `out`, on what's there where it's not air, the top of its
// collision shape, turned `angle`, waiting `delay` ticks. None where there's no floor.
fn fangs_at<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, x: f64, z: f64, min_y: f64, max_y: f64, angle: f32, delay: i32, out: mut List<(f64, f64, f64, f32, i32)>) {
    let bx = i32.saturate(x.floor())
    let bz = i32.saturate(z.floor())
    var by = i32.saturate(max_y.floor())
    let lowest = i32.saturate(min_y.floor()) - 1
    loop {
        let below = state_at(blocks, bx, by - 1, bz)
        if f.sturdy(below, UP, FULL) {
            var top = 0.0
            let here = state_at(blocks, bx, by, bz)
            if not f.is_air(here) {
                top = m.shape_top(f, here, bx, bz) ?? 0.0
            }
            out.push((x, f64(by) + top, z, angle, delay))
            return
        }
        by -= 1
        if by < lowest {
            return
        }
    }
}

// A `SpellcasterUseSpellGoal`'s times for the spell `kind` (CAL-200): its ticks till it casts,
// `getCastWarmupTime`, its ticks casting, `getCastingTime`, its ticks till it may cast again,
// `getCastingInterval`, and its prepare sound, `getSpellPrepareSound`.
fn spell_times(kind: i32) -> (i32, i32, i32, str) {
    if kind == SPELL_SUMMON {
        return (20, 100, 340, "entity.evoker.prepare_summon")
    }
    if kind == SPELL_WOLOLO {
        return (40, 60, 140, "entity.evoker.prepare_wololo")
    }
    return (20, 40, 100, "entity.evoker.prepare_attack")
}

// `VillagerHostilesSensor`'s distances, `ACCEPTABLE_DISTANCE_FROM_HOSTILES`: how near a mob of the
// kind `species` must be for a villager to fear it, of those Calcite makes, a zombie's and a zombie
// villager's 8 (CAL-160), a vex's 8, a vindicator's 10, a ravager's and an evoker's 12 and a
// pillager's 15 (CAL-200); 0 for one it doesn't fear, a zombified piglin among them.
fn hostile_distance(species: i32) -> f64 {
    if (zombie_kind(species) and species != ZOMBIFIED_PIGLIN) or species == VEX {
        return 8.0
    }
    if species == VINDICATOR {
        return 10.0
    }
    if species == RAVAGER or species == EVOKER {
        return 12.0
    }
    if species == PILLAGER {
        return 15.0
    }
    return 0.0
}

// `AcquirePoi.JitteredLinearRetry.markAttempt` at the game time `now`: tried then, and put off
// longer each try, 40 to 79 ticks more, drawn from the level's random, 400 at most.
fn mark_attempt(r: mut Retry, now: i64, random: mut TapedRandom) {
    r.previous = now
    let suggested = r.delay + random.next_int_below(40) + 40
    r.delay = if suggested < 400 { suggested } else { 400 }
    r.next = now + i64(r.delay)
}

// Whether the block at `pos` is a bed a villager may sleep in, `#villagers_can_sleep_on_bed`,
// that someone's in, its `OCCUPIED`; none where it's no such bed. A bed for `validateBedPoi` is
// one no one's in, and `ValidateNearbyPoi`'s bed taken one someone is (CAL-160).
fn bed_in_use<B: CollisionBlocks>(f: Facts, blocks: B, pos: BlockPos) -> bool? {
    let state = state_at(blocks, pos.x, pos.y, pos.z)
    if not f.tag(String("minecraft:villagers_can_sleep_on_bed")).contains(f.block(state)) {
        return none
    }
    return some(f.get_bool(state, String("occupied")))
}

// An insertion sort of `found` by distance, the nearest first, stable as `List.sort` is.
fn sort_nearest(found: mut List<(f64, i32)>) {
    for i in 1..found.len() {
        var j = i
        while j > 0 {
            let (a, _) = found[j - 1]
            let (c, _) = found[j]
            if a <= c {
                break
            }
            found.swap(j - 1, j)
            j -= 1
        }
    }
}

/// Where a kind's own values start, after an ageable mob's: a mooshroom's type, a sheep's wool, a
/// cow's and chicken's variant then sound variant, a pig's after its boost time, and a horse's and
/// donkey's flags, `DATA_ID_FLAGS`, then a horse's variant and markings and a donkey's chest; and
/// a slime's size.
pub const OWN: usize = 18

/// Where a monster's own values start, after `Mob`'s flags: a creeper's swell's direction, then
/// whether it's powered and ignited; a zombie's baby, special type and drowned conversion, and a
/// zombie villager's then its cure, villager data and whether that's final; a skeleton's stray
/// conversion; a spider's flags; an enderman's carried block, creepiness and being stared at; and
/// a witch's celebrating, then drinking.
pub const MONSTER_OWN: usize = 16

/// An ender dragon's phase, `EnderDragon.DATA_PHASE`, its own first value after `Mob`'s flags,
/// as it's no monster (D608).
pub const DRAGON_PHASE: usize = 16

/// Whether a fish came from a bucket, `AbstractFish.FROM_BUCKET`, its own first value after
/// `Mob`'s flags (CAL-178).
pub const FROM_BUCKET: usize = 16

/// How far from the nearest player a mob of `category` may be before it goes at once,
/// `MobCategory.getDespawnDistance`; and within how far it never goes, `getNoDespawnDistance`.
pub fn despawn_distance(category: i32) -> i32 {
    return if category == WATER_AMBIENT { 64 } else { 128 }
}

pub const NO_DESPAWN_DISTANCE: i32 = 32

/// A bee's flags, `Bee`'s `DATA_FLAGS_ID`, at `OWN`: rolling, stung and with nectar (CAL-177).
pub const BEE_ROLLING: i32 = 2
pub const BEE_STUNG: i32 = 4
pub const BEE_NECTAR: i32 = 8

/// A wolf's own, `Wolf`'s, besides what it sends (CAL-201): whether it's wet, `isWet`, and shaking
