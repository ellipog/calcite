    /// (CAL-201).
    pub inflate: i32 = 0
    pub deflate: i32 = 0
    /// A squid's own, `SquidLife` (CAL-201).
    pub squid: SquidLife = SquidLife()
    /// A dolphin's own, `DolphinLife` (CAL-201).
    pub dolphin: DolphinLife = DolphinLife()
    /// A wither's own (CAL-401).
    pub wither: WitherLife = WitherLife()
    /// A tropical fish's: whether its pack may grow, `isSchool`, not where its variant's drawn of
    /// its own, `isMaxGroupSizeReached` (CAL-201).
    pub school: bool = true
    pub sneezed: bool = false
    /// Whether a crossbow's loading's start and middle sounds were played, as the crossbow item
    /// keeps them for every crossbow, `startSoundPlayed` and `midLoadSoundPlayed`, which its level
    /// lends it for its tick (CAL-200).
    pub crossbow_sounds: (bool, bool) = (false, false)
    /// A ravager's ticks left of its attack, of being stunned and of its roar, `attackTick`,
    /// `stunnedTick` and `roarTick`, which keep it still; saved (CAL-200).
    pub attack_tick: i32 = 0
    pub stunned_tick: i32 = 0
    pub roar_tick: i32 = 0
    /// A vex's: the block it moves about, `boundOrigin`, saved as `bound_pos`; its ticks left
    /// where its life's limited, `limitedLifeTicks`, saved as `life_ticks`; and the mob that
    /// summoned it, by UUID, `owner` (CAL-200).
    pub vex_bound: (i32, i32, i32)? = none
    pub vex_life: i32? = none
    pub vex_owner: (i64, i64)? = none
    /// An evoker's: its ticks left casting, `spellCastingTickCount`, saved as `SpellTicks`; and
    /// the sheep it means to turn red, by ID, `wololoTarget` (CAL-200).
    pub spell_ticks: i32 = 0
    pub wololo: i32? = none
    /// A blaze's height its target's eyes may be above its own before it rises, `allowedHeightOffset`,
    /// and its ticks till that's drawn again, `nextHeightOffsetChangeTick` (CAL-200).
    pub blaze_offset: f32 = 0.5f32
    pub blaze_next: i32 = 0
    /// A ghast's ticks till its move control next pushes it, `GhastMoveControl.floatDuration`, and
    /// how strong its fireballs blow, `explosionPower`, saved as `ExplosionPower` (CAL-200).
    pub float_duration: i32 = 0
    pub ghast_power: i32 = 1
    /// A zombified piglin's ticks till its first angry sound, `playFirstAngerSoundIn`, and till it
    /// next alerts others, `ticksUntilNextAlert`, each drawn as it takes up a target (CAL-200).
    pub first_anger_in: i32 = 0
    pub alert_in: i32 = 0
    /// A shulker's peek as it eases toward its raw peek, `currentPeekAmount`, and as it was the
    /// tick before, `currentPeekAmountO` (CAL-200).
    pub shulker_peek: f32 = 0.0f32
    pub shulker_peek_o: f32 = 0.0f32
    /// A vex's owner's target, by ID, as its level found it for this tick, `getOwner().getTarget()`
    /// (CAL-200).
    pub owner_target: i32? = none
    /// A hoglin's ticks zombifying, `timeInOverworld`, saved as `TimeInOverworld`, and whether
    /// piglins may not hunt it, `cannotBeHunted`, saved as `CannotBeHunted` (CAL-200).
    pub time_in_overworld: i32 = 0
    pub cannot_be_hunted: bool = false
    /// Whether a piglin may not hunt, `cannotHunt`, saved as `CannotHunt` (CAL-200).
    pub cannot_hunt: bool = false
    /// Its living self as a hoglin turned into a zoglin, `finishConversion`, mid its
    /// `customServerAiStep`: what the zoglin takes of it, `convertTo`, as the rest of its tick
    /// goes on (CAL-200).
    pub converted_living: Living? = none
    /// The pitch of a hoglin's attack sound, drawn as its `MeleeAttack` hits, `makeSound`, which
    /// its level plays dealing the hit (CAL-200).
    pub attack_pitch: f32 = 1.0f32
    /// Its leash, `Leashable.LeashData`, and the home it stays near, `homePosition` and
    /// `homeRadius`, which a leash gives it about its holder, `whenLeashedTo` (CAL-179); and its
    /// holder as its level found it for this tick, none where it isn't found.
    pub leash: Leash? = none
    pub home: ((i32, i32, i32), i32)? = none
    pub holding: Holding? = none
    /// What it was loaded with that Calcite doesn't run yet, by the keys it's saved under: its drop
    /// chances, death loot table and seed, its love's cause, a mooshroom's stew effects, and a
    /// horse's owner and a donkey's chest's items.
    pub kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
}

impl Mob {
    /// A mooshroom of the type `kind` at x, y, z with its own random seeded `seed`, as
    /// `MushroomCow`'s constructor makes it: red, grown.
    pub fn mooshroom(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> Mob {
        let facts = MobFacts.vanilla(0, List<i32>(), List<i32>())
        return Mob.made(lf, facts, MOOSHROOM, kind, id, seed, x, y, z)
    }

    /// A mob of the kind `species` and the type `kind` at x, y, z with its own random seeded
    /// `seed`, as its constructor makes it: grown, of its default variants, and a chicken's ticks
    /// until it lays drawn from its own random after its turn, 6,000 to 11,999.
    pub fn made(lf: LivingFacts, facts: MobFacts, species: i32, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> Mob {
        var mb = Mob.built(lf, facts, species, kind, id, seed, x, y, z)
        mb.seed = seed
        return mb
    }

    // `made`'s mob, by its kind.
    fn built(lf: LivingFacts, facts: MobFacts, species: i32, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> Mob {
        let (w, h, eyes, bw, bh, beyes) = shape(species)
        // A zombie villager's profession is drawn from its own random as its values are defined,
        // `initializeZombieVillagerData`, any of `VILLAGER_PROFESSION`'s.
        let professions = if species == ZOMBIE_VILLAGER { i32.wrap(builtin_entries(24).len()) } else { 0 }
        let (l, profession) = Living.made_drawing(lf, kind, id, seed, x, y, z, w, h, eyes, data_of(species, facts), professions)
        // `PathNavigation`'s constructor reads its follow range's base, as many nodes a search as
        // 16 times that.
        let follow = l.attributes.base(lf.follow_range)
        if cube_kind(species) {
            // A cube mob, `AbstractCubeMob`: an ageable mob that's never a baby, `canBeABaby`, and
            // no monster, its sounds the hostile source's, of size 1 as it's made. A magma cube's
            // type is fire immune (CAL-200).
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, peaceful_ok: false, sound_volume: 0.4f32, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.cube = true
            if species == MAGMA_CUBE {
                mb.living.fire_immune = true
                mb.living.magma_size = some(1)
            }
            if species == SULFUR_CUBE {
                // `SulfurCube`'s (CAL-402): its sounds the neutral source's, `getSoundSource`, and
                // a baby it may be, its age counted, as `AgeableMob`'s is.
                mb.living.body.sound_source = NEUTRAL_SOURCE
                mb.ageable = true
                mb.living.jump_share = 0.2
            }
            // `CubeMobMoveControl`'s way, made from its turn as it's made.
            mb.moves.cube_y_rot = 180.0f32 * mb.living.body.y_rot / 3.1415927f32
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == CREEPER or species == ZOMBIE or species == HUSK or species == DROWNED or species == SKELETON or species == STRAY or species == BOGGED or species == PARCHED or species == WITHER_SKELETON or species == SPIDER or species == CAVE_SPIDER or species == ENDERMAN or species == WITCH or species == ZOMBIE_VILLAGER or species == ENDERMITE or species == SILVERFISH or species == VINDICATOR or species == PILLAGER or species == RAVAGER or species == VEX or species == EVOKER or species == BLAZE or species == ZOMBIFIED_PIGLIN or species == ZOGLIN or species == PIGLIN_BRUTE or species == PIGLIN or species == WITHER_BOSS {
            // A monster, `Monster`, its sounds the hostile source's.
            let burns = species == ZOMBIE or species == DROWNED or species == SKELETON or species == STRAY or species == BOGGED or species == WITHER_SKELETON or species == ZOMBIE_VILLAGER
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, peaceful_ok: false, monster: true, burns: burns, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.body.quiet_splash = some(String("entity.hostile.splash"))
            mb.living.small_fall = String("entity.hostile.small_fall")
            mb.living.big_fall = String("entity.hostile.big_fall")
            // A drowned's swims its own, `Drowned.getSwimSound` (CAL-175).
            mb.living.swim = String(if species == DROWNED { "entity.drowned.swim" } else { "entity.hostile.swim" })
            mb.living.drowned = species == DROWNED
            if species == ZOMBIE_VILLAGER {
                mb.living.data.redefine(MONSTER_OWN + 4, Value.Villager(PLAINS_VILLAGERS, profession, 1))
            }
            mb.living.magic_resistant = species == WITCH
            mb.living.cold_proof = species == SKELETON or species == STRAY
            // A wither skeleton, a vex, a blaze, a zombified piglin and a zoglin fire doesn't burn,
            // their types' `fireImmune` (CAL-200).
            mb.living.fire_immune = species == WITHER_SKELETON or species == VEX or species == BLAZE or species == ZOMBIFIED_PIGLIN or species == ZOGLIN or species == WITHER_BOSS
            // The undead breathe under water, `#can_breathe_under_water` (CAL-175).
            mb.living.breathes_water = mb.undead()
            // An endermite's and a silverfish's steps and swims emit game events but no sound,
            // `MovementEmission.EVENTS` (D583, CAL-172).
            mb.living.emits_sounds = species != ENDERMITE and species != SILVERFISH
            if species == ZOGLIN {
                // `Zoglin` (CAL-200): its brain made in `LivingEntity`'s constructor right after its
                // turn's drawn, its sensors put off by its random, its gates seeded from its own seed.
                mb.brain = some(Brain.made(zoglin_sensors(), zoglin_activities(seed), mut mb.living.body.random))
            }
            if species == PIGLIN_BRUTE {
                // `AbstractPiglin`'s constructor (CAL-200): it may pick up loot; its brain, as a
                // zoglin's is made.
                mb.can_pick_up_loot = true
                mb.brain = some(Brain.made(brute_sensors(), brute_activities(seed), mut mb.living.body.random))
            }
            if species == WITHER_BOSS {
                // `WitherBoss` (CAL-401): its boss bar made as its fields are, its UUID drawn from
                // its own random, `createInsecureUUID`; its health its most, 300; and 50 experience,
                // `xpReward`.
                mb.wither.bar = insecure_uuid(mut mb.living.body.random)
                mb.living.body.bar = some(mb.wither.bar)
            }
            if species == PIGLIN {
                // `AbstractPiglin`'s constructor (CAL-200): it may pick up loot; its brain, as a
                // zoglin's is made, with its own memories registered.
                mb.can_pick_up_loot = true
                var brain = Brain.made(piglin_sensors(), piglin_activities(seed), mut mb.living.body.random)
                for m in piglin_memories() {
                    brain.register(m)
                }
                mb.brain = some(brain)
            }
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == GUARDIAN or species == ELDER_GUARDIAN {
            // `Guardian` (CAL-200), a monster, its sounds the hostile source's, its ambient sound
            // every 160 ticks or so: breathing under water, `#can_breathe_under_water`; its steps
            // and swims emitting game events but no sound, `MovementEmission.EVENTS`. An elder's
            // kept, `setPersistenceRequired`. After its goals, the constructor draws its tail's
            // start, `clientSideTailAnimation`, from its own random.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, peaceful_ok: false, monster: true, ambient_interval: 160, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.body.quiet_splash = some(String("entity.hostile.splash"))
            mb.living.small_fall = String("entity.hostile.small_fall")
            mb.living.big_fall = String("entity.hostile.big_fall")
            mb.living.swim = String("entity.hostile.swim")
            mb.living.breathes_water = true
            mb.living.emits_sounds = false
            mb.living.guardian_swim = true
            mb.persistence_required = species == ELDER_GUARDIAN
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            _ = mb.living.body.random.next_float()
            return mb
        }
        if species == PHANTOM {
            // `Phantom` (CAL-200), an enemy but no monster, kept from peaceful, `notInPeaceful`,
            // its sounds the hostile source's: burning in daylight, `#burn_in_daylight`; undead,
            // so breathing under water; hurt by no fall, `#fall_damage_immune`, which it never
            // counts, its empty `checkFallDamage`; flying its own way, `travelFlying`, never
            // climbing, `onClimbable`.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, peaceful_ok: false, burns: true, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.breathes_water = true
            mb.living.fall_immune = true
            mb.living.ignores_falls = true
            mb.living.flies_free = true
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == SHULKER {
            // `Shulker` (CAL-200), an `AbstractGolem` and an enemy, allowed in peaceful, never
            // despawning: its sounds the hostile source's, its ambient sound every 120 ticks or so,
            // fire immune, never moving, `getDeltaMovement` always none and `setDeltaMovement`
            // nothing, its moves emitting nothing, `MovementEmission.NONE`; its place the middle
            // of its block, its feet on the block's half, `setPos`, as `reapplyPosition` puts it.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, ambient_interval: 120, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.fire_immune = true
            mb.living.body.still = true
            mb.living.emits_sounds = false
            mb.living.body.x = f64(floor_of(x)) + 0.5
            mb.living.body.y = f64(floor_of(y + 0.5))
            mb.living.body.z = f64(floor_of(z)) + 0.5
            mb.shulker_shape()
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == GHAST {
            // `Ghast` (CAL-200), an enemy but no monster, kept from peaceful, `notInPeaceful`, its
            // sounds the hostile source's, 5 loud, `getSoundVolume`, alone as it spawns,
            // `getMaxSpawnClusterSize`: fire immune; its falls never counted, its empty
            // `checkFallDamage`; flying its own way at 0.02, `travelFlying`, never climbing,
            // `onClimbable`.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, peaceful_ok: false, sound_volume: 5.0f32, max_cluster: 1, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.fire_immune = true
            mb.living.ignores_falls = true
            mb.living.flies_free = true
            mb.living.fly_speed = 0.02f32
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == ENDER_DRAGON {
            // `EnderDragon`, an enemy but no monster, its sounds the hostile source's, 5 loud,
            // `getSoundVolume`: fire immune, with no physics, `noPhysics`, its phase hovering and
            // so taking no knockback, through no portal, with no effects and its own death's tick
            // (D608).
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MONSTER, sound_volume: 5.0f32, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes, dragon: some(Dragon.made()) }
            mb.living.body.sound_source = HOSTILE_SOURCE
            mb.living.fire_immune = true
            mb.living.body.no_physics = true
            mb.living.knock_proof = true
            mb.living.uses_portals = false
            mb.living.takes_effects = false
            mb.living.own_death = true
            mb.refresh_sounds()
            return mb
        }
        if fish_kind(species) {
            // A cod, `Cod` (CAL-178), or a salmon, `Salmon` (CAL-201), a schooling fish,
            // `AbstractSchoolingFish`, an `AbstractFish` and a `WaterAnimal`: of the water ambient
            // category, no animal, its ambient sound every 120 ticks or so, its schools of up to
            // 8, a salmon's 5, `getMaxSchoolSize`; through water its own way, unpushed, breathing
            // there, `#can_breathe_under_water`; its swims a fish's and its steps silent,
            // `playStepSound`. A salmon's made medium, its size its type's.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: WATER_AMBIENT, ambient_interval: 120, max_cluster: if species == SALMON { 5 } else { 8 }, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.fish = true
            mb.living.breathes_water = true
            mb.living.swim = String("entity.fish.swim")
            mb.living.steps_unheard = true
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == DOLPHIN {
            // `Dolphin` (CAL-201), an `AgeableWaterCreature`, ageable but no animal: of the water
            // creature category, its ambient sound every 120 ticks or so; unpushed by the
            // currents, `isPushedByFluid`; its air its own, 4800 at most and as it's made, back whole out of
            // water, `increaseAirSupply`, and no water creature's out of it, `handleAirSupply`;
            // its move control `SmoothSwimmingMoveControl(85, 10, 0.02, 0.1, true)` and its look
            // control `SmoothSwimmingLookControl(10)`, `dolphin_moves`; through water its own
            // way, `travelInWater`; it picks up loot, `setCanPickUpLoot`; its swims and its quiet
            // splashes its own.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: WATER_CREATURE, ambient_interval: 120, ageable: true, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.unpushed = true
            mb.living.max_air = 4800
            mb.living.set_air(4800)
            mb.living.air_whole = true
            mb.living.dolphin_swim = true
            mb.can_pick_up_loot = true
            mb.living.swim = String("entity.dolphin.swim")
            mb.living.body.quiet_splash = some(String("entity.dolphin.splash"))
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if squid_kind(species) {
            // `Squid` (CAL-201), an `AgeableWaterCreature`, ageable but no animal: of the water
            // creature category, a glow squid's the underground one, its ambient sound every 120
            // ticks or so, its sounds 0.4 as loud, `getSoundVolume`; breathing in water,
            // `#can_breathe_under_water`, unpushed by the currents, `isPushedByFluid`; its moves
            // heard as nothing, `MovementEmission.EVENTS`; moving by its motion alone, `travel`;
            // its tentacles' speed drawn as it's made.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: if species == GLOW_SQUID { UNDERGROUND_WATER_CREATURE } else { WATER_CREATURE }, ambient_interval: 120, sound_volume: 0.4f32, ageable: true, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.breathes_water = true
            mb.living.unpushed = true
            mb.living.emits_sounds = false
            mb.living.moves_as_is = true
            mb.navigation.maluses[usize(PATH_WATER)] = 0.0f32
            mb.squid.tentacle_speed = mb.squid_tentacle_speed()
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == BAT {
            // `Bat` (CAL-201), an `AmbientCreature`, no enemy, of the ambient category, its
            // ambient sound every 80 ticks or so: resting as it's made, `setResting`, which what
            // it's loaded with says again, `BatFlags`; its sounds a tenth as loud,
            // `getSoundVolume`; its moves heard as nothing, `MovementEmission.EVENTS`; its falls
            // ignored, `checkFallDamage`.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: AMBIENT, sound_volume: 0.1f32, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.data.set(MONSTER_OWN, Value.Byte(1i8))
            mb.living.emits_sounds = false
            mb.living.ignores_falls = true
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == IRON_GOLEM {
            // `IronGolem` (CAL-201), an `AbstractGolem`, no enemy, of the misc category, never
            // going far away, `removeWhenFarAway`, its ambient sound every 120 ticks or so, of
            // which it has none: its air never less, `decreaseAirSupply`; its steps its own, as loud
            // as 1, `playStepSound`; its dust drawn for as it moves, `canSpawnSprintParticle`.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MISC, ambient_interval: 120, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.keeps_air = true
            mb.living.own_step_volume = 1.0f32
            mb.living.golem_dust = true
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == SNOW_GOLEM {
            // `SnowGolem` (CAL-201), an `AbstractGolem`, no enemy, of the misc category, never
            // going far away, its ambient sound every 120 ticks or so; its air never less,
            // `decreaseAirSupply`; its steps the block's.
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MISC, ambient_interval: 120, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
            mb.living.keeps_air = true
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        if species == VILLAGER {
            // `AbstractVillager`, an ageable mob but no animal, of the misc category: its brain
            // made in `LivingEntity`'s constructor right after its turn's drawn, its sensors put
            // off by its random; and one that may pick up loot (CAL-160).
            var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: MISC, ageable: true, can_pick_up_loot: true, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes, brain_seed: seed }
            mb.brain = some(mb.villager_brain())
            mb.refresh_sounds()
            mb.navigate_as_kind(lf)
            return mb
        }
        let volume = if species == MOOSHROOM or species == COW or species == WOLF { 0.4f32 } else { 1.0f32 }
        var mb = Mob { living: l, navigation: Navigation.new(follow), species: species, category: CREATURE, ambient_interval: 120, sound_volume: volume, animal: true, ageable: true, width: w, height: h, eyes: eyes, baby_width: bw, baby_height: bh, baby_eyes: beyes }
        if species == ARMADILLO {
            // Its brain, made in `LivingEntity`'s constructor right after its turn's drawn, its
            // sensors put off by its random, `randomlyDelayStart`, its gates seeded from its own
