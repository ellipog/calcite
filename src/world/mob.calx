    pub did_spit: bool = false
    pub caravan_head: i32? = none
    pub caravan_tail: i32? = none
    pub llamas: List<CaravanLlama> = List<CaravanLlama>()
    /// A panda's own (CAL-201), and whether it sneezed this tick, which makes the grown pandas
    /// near it jump, as its level does once its tick's done.
    pub panda: PandaLife = PandaLife()
    pub parrot: ParrotLife = ParrotLife()
    pub turtle: TurtleLife = TurtleLife()
    /// A bat's place it flies toward, `targetPosition` (CAL-201).
    pub bat_target: (i32, i32, i32)? = none
