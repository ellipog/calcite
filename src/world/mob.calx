            mb.ambient_interval = 900
        } else if species == CAT {
            // A cat, `Cat` (CAL-201), a `TamableAnimal`: the black one, `DEFAULT_VARIANT`, and the
            // classic sound variant as it's made; what hurts it kept, its death told its owner
            // where it's tame.
            mb.variant = facts.cat.default
            mb.variant_names = facts.cat.names.copy()
            mb.sound_variant = facts.cat_sounds.default
            mb.sounds = some(facts.cat_sounds.copy())
            mb.living.combat = some(CombatTracker())
        } else if species == BEE {
            // A bee, `Bee` (CAL-177): its sounds 0.4 loud, its steps silent, through the air
            // alike every way, its falls ignored, rising 0.01 a tick jumping in a liquid; its
            // air drag so its body's.
            mb.sound_volume = 0.4f32
            mb.living.steps_unheard = true
            mb.living.omni_air = true
            mb.living.ignores_falls = true
            mb.living.liquid_rise = some(0.01)
            mb.living.refresh_body(lf)
        }
        mb.refresh_sounds()
        mb.navigate_as_kind(lf)
        return mb
    }

    // What its kind's constructor makes of its navigation: an animal's malus beside fire 16 and in
    // it -1, `Animal`'s; a chicken's in water 0 and an enderman's -1; and floating, which
    // `FloatGoal` and a cube mob's float goal turn on as `registerGoals` makes them, for all but
    // the zombies and skeletons. And its movement speed's attribute kept, for an enderman's target.
    fn navigate_as_kind(mut self, lf: LivingFacts) {
        if self.animal or self.species == VILLAGER or self.species == PIGLIN_BRUTE or self.species == PIGLIN {
            // An animal's, `Animal`'s constructor, a villager's, `AbstractVillager`'s, and a piglin's
            // or a piglin brute's, `AbstractPiglin`'s (CAL-200).
            self.navigation.maluses[usize(PATH_FIRE_IN_NEIGHBOR)] = 16.0f32
            self.navigation.maluses[usize(PATH_FIRE)] = -1.0f32
        }
        if self.species == PIGLIN_BRUTE or self.species == PIGLIN {
            // `AbstractPiglin.applyOpenDoorsAbility`: it opens doors, its navigation on the ground
            // (CAL-200).
            self.navigation.can_open_doors = true
        }
        if self.species == VILLAGER {
            // `Villager`'s constructor: it opens doors, floats, and finds paths at least 48 long
            // (CAL-160).
            self.navigation.can_open_doors = true
            self.navigation.set_required_length(48.0f32)
        }
        if self.species == CHICKEN {
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
        } else if self.species == DROWNED {
            // `Drowned`'s constructor: its own move control, `drowned_move`, water no cost, and
            // `createNavigation`'s `AmphibiousPathNavigation` (CAL-175).
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
            self.navigation.amphibious = true
        } else if self.species == WITHER_SKELETON or self.species == ZOMBIFIED_PIGLIN {
            // `WitherSkeleton`'s and `ZombifiedPiglin`'s constructors: lava 8 (CAL-200).
            self.navigation.maluses[usize(PATH_LAVA)] = 8.0f32
        } else if self.species == BLAZE {
            // `Blaze`'s constructor: water shut to it, lava 8, fire and beside it no cost (CAL-200).
            self.navigation.maluses[usize(PATH_WATER)] = -1.0f32
            self.navigation.maluses[usize(PATH_LAVA)] = 8.0f32
            self.navigation.maluses[usize(PATH_FIRE_IN_NEIGHBOR)] = 0.0f32
            self.navigation.maluses[usize(PATH_FIRE)] = 0.0f32
        } else if self.species == WOLF {
            // `Wolf`'s constructor: powder snow, in it and on top of it, shut to it (CAL-201).
            self.navigation.maluses[usize(PATH_POWDER_SNOW)] = -1.0f32
            self.navigation.maluses[usize(PATH_ON_TOP_OF_POWDER_SNOW)] = -1.0f32
        } else if self.species == LLAMA {
            // `Llama`'s constructor: paths at least 40 long, `setRequiredPathLength` (CAL-201).
            self.navigation.set_required_length(40.0f32)
        } else if self.species == FOX {
            // `Fox`'s constructor: what damages it, and beside it, no cost; paths at least 32 long,
            // `setRequiredPathLength` (CAL-201).
            self.navigation.maluses[usize(PATH_DAMAGING_IN_NEIGHBOR)] = 0.0f32
            self.navigation.maluses[usize(PATH_DAMAGING)] = 0.0f32
            self.navigation.set_required_length(32.0f32)
        } else if self.species == ENDERMAN {
            self.navigation.maluses[usize(PATH_WATER)] = -1.0f32
        } else if self.species == RAVAGER {
            // `Ravager`'s constructor: leaves no cost (CAL-200).
            self.navigation.maluses[usize(PATH_LEAVES)] = 0.0f32
        } else if self.species == BEE {
            // `Bee`'s constructor: fire, water, cocoa and fences shut to it, water's border 16;
            // its `FlyingPathNavigation`, paths at least 48 long (CAL-177).
            self.navigation.maluses[usize(PATH_FIRE)] = -1.0f32
            self.navigation.maluses[usize(PATH_WATER)] = -1.0f32
            self.navigation.maluses[usize(PATH_WATER_BORDER)] = 16.0f32
            self.navigation.maluses[usize(PATH_COCOA)] = -1.0f32
            self.navigation.maluses[usize(PATH_FENCE)] = -1.0f32
            self.navigation.set_required_length(48.0f32)
            self.navigation.flying = true
        } else if self.species == WITHER_BOSS {
            // `WitherBoss.createNavigation` (CAL-401): a `FlyingPathNavigation`, opening no doors
            // and floating.
            self.navigation.can_open_doors = false
            self.navigation.can_float = true
            self.navigation.flying = true
        } else if self.species == PARROT {
            // `Parrot`'s constructor: fire, the fire beside it and cocoa shut to it; its
            // `FlyingPathNavigation`, opening no doors and floating (CAL-201).
            self.navigation.maluses[usize(PATH_FIRE_IN_NEIGHBOR)] = -1.0f32
            self.navigation.maluses[usize(PATH_FIRE)] = -1.0f32
            self.navigation.maluses[usize(PATH_COCOA)] = -1.0f32
            self.navigation.can_open_doors = false
            self.navigation.can_float = true
            self.navigation.flying = true
        } else if self.species == TURTLE {
            // `Turtle`'s constructor: water no cost, doors shut to it, open or not; its
            // `TurtlePathNavigation`, an `AmphibiousPathNavigation` whose stable places, while it
            // travels, are water, `isStableDestination` (CAL-201).
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
            self.navigation.maluses[usize(PATH_DOOR_IRON_CLOSED)] = -1.0f32
            self.navigation.maluses[usize(PATH_DOOR_WOOD_CLOSED)] = -1.0f32
            self.navigation.maluses[usize(PATH_DOOR_OPEN)] = -1.0f32
            self.navigation.amphibious = true
        } else if fish_kind(self.species) {
            // `WaterAnimal`'s constructor: water no cost; and `AbstractFish.createNavigation`'s
            // `WaterBoundPathNavigation`, which never floats (CAL-178).
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
            self.navigation.swimming = true
        } else if self.guardian_kind() {
            // `Guardian`'s constructor: water no cost; and its `createNavigation`'s
            // `WaterBoundPathNavigation` (CAL-200).
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
            self.navigation.swimming = true
        } else if self.species == DOLPHIN {
            // `AgeableWaterCreature`'s constructor: water no cost; and `Dolphin.createNavigation`'s
            // `WaterBoundPathNavigation`, which breaches as a dolphin's, `allowBreaching`
            // (CAL-201).
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
            self.navigation.swimming = true
            self.navigation.breaching = true
        }
        // A hoglin, a zoglin, a piglin brute and a piglin have no float goal nor swim behavior (CAL-200), nor
        // a skeleton horse, which has no behaviour goals (CAL-349).
        self.navigation.can_float = not (self.zombie_class() or self.skeletal() or fish_kind(self.species) or self.species == DOLPHIN or self.guardian_kind() or self.species == BLAZE or self.species == GHAST or self.species == HOGLIN or self.species == ZOGLIN or self.species == PIGLIN_BRUTE or self.species == PIGLIN or self.species == SKELETON_HORSE)
        self.living.sinks = not self.navigation.can_float
        self.speed_attribute = lf.movement_speed
        if self.spider_kind() {
            // A spider's `WallClimberNavigation`, and its climbing by its flags (CAL-159).
            self.navigation.climber = true
            self.living.climber = true
        }
        self.register_goals()
        if self.species == BEE {
            // Then `Bee`'s fields: how long till it looks for a flower, 20 to 60 ticks.
            self.bee.flower_cooldown = self.living.body.random.next_int_between(20, 60)
        }
    }

    // `registerGoals`, as its kind's constructor makes them on a server, in their order, with their
    // priorities, controls and speeds, a skeleton's as `AbstractSkeleton`'s, its weapon goal, a
    // `MeleeAttackGoal` as it holds nothing yet, after them (CAL-159); a cow's and mooshroom's,
    // `AbstractCow`'s; a pig's, tempted by a carrot on a stick and by its food; a sheep's, eating
    // among them; a chicken's; a horse's or donkey's, `AbstractHorse`'s then `addBehaviourGoals`; a
    // zombie horse's, its own behaviour goals; a zombie's and zombie villager's, `Zombie`'s, then
    // `addBehaviourGoals`, its target goals among them (CAL-159). The other monsters' come with
    // CAL-159.
    fn register_goals(mut self) {
        let s = self.species
        if s == BEE {
            // `Bee.registerGoals` (CAL-177): its attack at 1.4, following its target unseen; going
            // into its hive; breeding; tempted by `#bee_food` at 1.25; checking its hive and its
            // flower, each drawing how long it waits between looks as it's made, 20 to 40 ticks,
            // the hive's first; pollinating, every tick; following its parent at 1.25; looking for
            // a hive and going to it; going to the flower it knows; growing crops; wandering; and
            // floating. Its target goals the one who hurt it, alerting bees that see them; players
            // it's angry at, seen; and its universal anger's reset, alerting others.
            self.goals.add(0, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.4, follow_unseen: true, zombie: false, bee: true }))
            self.goals.add(1, 0u32, false, Goal.Bee(BEE_ENTER_HIVE))
            self.add_breed(2)
            self.add_tempt(3, TEMPT_BEE, 1.25)
            self.bee.validate_hive = self.living.body.random.next_int_between(20, 40)
            self.goals.add(3, 0u32, false, Goal.Bee(BEE_VALIDATE_HIVE))
            self.bee.validate_flower = self.living.body.random.next_int_between(20, 40)
            self.goals.add(3, 0u32, false, Goal.Bee(BEE_VALIDATE_FLOWER))
            self.goals.add(4, FLAG_MOVE, true, Goal.Bee(BEE_POLLINATE))
            self.add_follow(5, 1.25)
            self.goals.add(5, 0u32, false, Goal.Bee(BEE_LOCATE_HIVE))
            self.goals.add(5, FLAG_MOVE, false, Goal.Bee(BEE_GO_TO_HIVE))
            self.goals.add(6, FLAG_MOVE, false, Goal.Bee(BEE_GO_TO_FLOWER))
            self.goals.add(7, 0u32, false, Goal.Bee(BEE_GROW_CROP))
            self.goals.add(8, FLAG_MOVE, false, Goal.Bee(BEE_WANDER))
            self.goals.add(9, FLAG_JUMP, true, Goal.Float(0))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true }, bee: true }))
            self.targets.add(2, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_PLAYER, interval: reduced_tick_delay(10), targeting: Targeting { must_see: true }, bee: true }))
            self.targets.add(3, 0, false, Goal.ResetAnger(0))
            return
        }
        if s == DOLPHIN {
            // `Dolphin.registerGoals` (CAL-201): breathing air and finding water, at 0; swimming to
            // treasure, at 1, and with a swimming player at 4, at 2, neither interrupted but by
            // what may; swimming at random at 1 every 10 ticks or so and looking about, at 4;
            // looking at players within 6 and jumping, every 10 ticks or so, at 5; its attack at
            // 1.2, following its target unseen, at 6; going for items, at 7, and playing with them,
            // at 8; its following of boats a player steers, `FollowPlayerRiddenEntityGoal`, at 8,
            // holding no controls (CAL-315), and of nautiluses, never used, as Calcite makes none;
            // and fleeing guardians within 8 at 1, at 9. Its target goal the one who hurt it, but a
            // guardian, alerting other dolphins.
            self.goals.add(0, FLAG_MOVE | FLAG_LOOK, false, Goal.Dolphin(DOLPHIN_BREATH))
            self.goals.last_uninterruptable()
            self.goals.add(0, 0u32, false, Goal.Dolphin(DOLPHIN_LIQUID))
            self.goals.add(1, FLAG_MOVE | FLAG_LOOK, false, Goal.Dolphin(DOLPHIN_TREASURE))
            self.goals.last_uninterruptable()
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, false, Goal.Dolphin(DOLPHIN_SWIM_PLAYER))
            self.goals.add(4, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: 1.0, interval: 10, water_avoiding: false, swim: true }))
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.goals.add(5, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 6.0f32 }))
            self.goals.add(5, FLAG_MOVE | FLAG_JUMP, false, Goal.Dolphin(DOLPHIN_JUMP))
            self.goals.last_uninterruptable()
            self.goals.add(6, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: f64(1.2f32), follow_unseen: true, zombie: false }))
            self.goals.add(7, FLAG_MOVE, false, Goal.Dolphin(DOLPHIN_TO_ITEM))
            self.goals.add(8, 0u32, false, Goal.Dolphin(DOLPHIN_PLAY))
            self.goals.add(8, 0u32, false, Goal.Dolphin(DOLPHIN_FOLLOW_BOAT))
            self.goals.add(9, FLAG_MOVE, false, Goal.Avoid(Avoid { max_dist: 8.0f32, walk: 1.0, sprint: 1.0, species: AVOID_GUARDIANS }))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true }, guardians_ignored: true }))
            return
        }
        if squid_kind(s) {
            // `Squid.registerGoals` (CAL-201): its swimming about, `SquidRandomMovementGoal`, and
            // its fleeing what hurt it, `SquidFleeGoal`, ticked every tick, neither holding any
            // controls.
            self.goals.add(0, 0u32, false, Goal.SquidMove(0))
            self.goals.add(1, 0u32, true, Goal.SquidFlee(0))
            return
        }
        if fish_kind(s) {
            // `AbstractFish.registerGoals` (CAL-178): panicking at 1.25; fleeing players within 8
            // but spectators, at 1.6 and 1.4 within 7; swimming at random every 40 ticks or so,
            // `FishSwimGoal`; then a schooling fish's following its leader, which holds no
            // controls, drawing its first wait as it's made, `nextStartTick`.
            self.goals.add(0, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.25 }))
            self.goals.add(2, FLAG_MOVE, false, Goal.Avoid(Avoid { max_dist: 8.0f32, walk: 1.6, sprint: 1.4 }))
            self.goals.add(4, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: 1.0, interval: 40, water_avoiding: false, swim: true }))
            if s == PUFFERFISH {
                // `Pufferfish.registerGoals`: then puffing up, `PufferfishPuffGoal` (CAL-201).
                self.goals.add(1, 0u32, false, Goal.Puff(0))
                return
            }
            let first = self.flock_start_tick()
            self.goals.add(5, 0u32, false, Goal.Flock(Flock { next_start: first }))
            return
        }
        if s == DROWNED {
            // `Zombie.registerGoals`' own, then `Drowned.addBehaviourGoals` (CAL-175): to water by
            // day, its trident's and its own attack, to a beach and up toward the sea's top by
            // night, and strolling; `HurtByTargetGoal(this, Drowned.class)`, alerting drowned,
            // then those that look for players it may take up, seen; villagers, unseen; and iron
            // golems, axolotls and baby turtles on land, seen.
            self.goals.add(4, FLAG_MOVE | FLAG_JUMP, true, Goal.RemoveBlock(RemoveBlock { block: String("minecraft:turtle_egg"), speed: 1.0, vertical: 3 }))
            self.goals.add(8, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(8, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.goals.add(1, FLAG_MOVE, false, Goal.ToWater(ToWater { speed: 1.0 }))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, true, Goal.Ranged(Ranged { speed: 1.0, interval_min: 40, interval_max: 40, radius: 10.0f32, drowned: true }))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: false, zombie: true, drowned: true }))
            self.goals.add(5, FLAG_MOVE | FLAG_JUMP, true, Goal.Beach(Beach { speed: 1.0 }))
            self.goals.add(6, 0, false, Goal.SwimUp(SwimUp { speed: 1.0 }))
            // `RandomStrollGoal`, not the water-avoiding one a zombie has.
            self.goals.add(7, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: 1.0, water_avoiding: false }))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true } }))
            self.targets.add(2, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_PLAYER, interval: reduced_tick_delay(10), targeting: Targeting { must_see: true }, drowned: true }))
            self.add_seek(3, SEEK_VILLAGER, 10, false)
            self.add_seek(3, SEEK_GOLEM, 10, true)
            self.add_seek(3, SEEK_AXOLOTL, 10, true)
            self.add_seek(5, SEEK_TURTLE, 10, true)
            return
        }
        if s == SNOW_GOLEM {
            // `SnowGolem.registerGoals` (CAL-201): its ranged attack, a snowball every 20 ticks
            // within 10, going for its target at 1.25; strolling, keeping out of water, at 1;
            // looking at players within 6 and about. Its target goal enemies it sees, one in ten
            // tries.
            self.goals.add(1, FLAG_MOVE | FLAG_LOOK, true, Goal.Ranged(Ranged { speed: 1.25, interval_min: 20, interval_max: 20, radius: 10.0f32 }))
            self.goals.add(2, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: 1.0, probability: 1.0000001e-5f32 }))
            self.goals.add(3, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 6.0f32 }))
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.add_seek(1, SEEK_ENEMY, 10, true)
            return
        }
        if s == IRON_GOLEM {
            // `IronGolem.registerGoals` (CAL-201): its attack, following a target unseen; toward its
            // target within 32 at 0.9; back to a village at 0.6, one in 10 tries; strolling about
            // its village at 0.6, one in 240; offering a flower; looking at players within 6 and
            // about. Its target goals the players villagers near it hate; the one who hurt it;
            // players it's angry at, seen, one in ten tries; enemies but creepers, seen or not, one
            // in five; and its universal anger's reset.
            self.goals.add(1, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: true, zombie: false }))
            self.goals.add(2, FLAG_MOVE, false, Goal.Towards(Towards { speed: 0.9, within: 32.0f32 }))
            self.goals.add(2, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: 0.6, interval: 10, check_no_action: false, water_avoiding: false, village: STROLL_BACK_TO_VILLAGE }))
            self.goals.add(4, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: 0.6, interval: 240, check_no_action: false, water_avoiding: false, village: STROLL_IN_VILLAGE }))
            self.goals.add(5, FLAG_MOVE | FLAG_LOOK, false, Goal.Flower(Flower()))
            self.goals.add(7, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 6.0f32 }))
            self.goals.add(8, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.targets.add(1, FLAG_TARGET, false, Goal.Defend(none))
            self.targets.add(2, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: false, targeting: Targeting { must_see: true } }))
            self.targets.add(3, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_PLAYER, interval: reduced_tick_delay(10), targeting: Targeting { must_see: true }, angry: true }))
            self.targets.add(3, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_ENEMY, interval: reduced_tick_delay(5), targeting: Targeting { must_see: false } }))
            self.targets.add(4, 0, false, Goal.ResetAnger(0))
            return
        }
        if s == ZOMBIFIED_PIGLIN {
            // `Zombie.registerGoals`' own, then `ZombifiedPiglin.addBehaviourGoals` (CAL-200): its
            // spear first, its attack, and strolling, no village walk; `HurtByTargetGoal`, alerting
            // zombified piglins; players it's angry at, `isAngryAt`, seen, one in ten tries; and its
            // universal anger's reset, alerting others.
            self.goals.add(4, FLAG_MOVE | FLAG_JUMP, true, Goal.RemoveBlock(RemoveBlock { block: String("minecraft:turtle_egg"), speed: 1.0, vertical: 3 }))
            self.goals.add(8, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(8, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.goals.add(1, FLAG_MOVE | FLAG_LOOK, false, Goal.SpearUse(SpearUse()))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: false, zombie: true }))
            self.add_stroll(7, 1.0)
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true } }))
            self.targets.add(2, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_PLAYER, interval: reduced_tick_delay(10), targeting: Targeting { must_see: true }, angry: true }))
            self.targets.add(3, 0, false, Goal.ResetAnger(0))
            return
        }
        if zombie_kind(s) {
            self.goals.add(4, FLAG_MOVE | FLAG_JUMP, true, Goal.RemoveBlock(RemoveBlock { block: String("minecraft:turtle_egg"), speed: 1.0, vertical: 3 }))
            self.goals.add(8, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 8.0f32 }))
            self.goals.add(8, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, false, Goal.SpearUse(SpearUse()))
            self.goals.add(3, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.0, follow_unseen: false, zombie: true }))
            self.goals.add(6, FLAG_MOVE, false, Goal.ThroughVillage(ThroughVillage { speed: 1.0, only_at_night: true, distance_to_poi: 4, poi: BlockPos { x: 0, y: 0, z: 0 } }))
            self.add_stroll(7, 1.0)
            // `HurtByTargetGoal(this).setAlertOthers(ZombifiedPiglin.class)`, then those that look
            // for players, seen; villagers, unseen; iron golems, seen; and baby turtles on land,
            // seen, one in ten tries.
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true } }))
            self.add_seek(2, SEEK_PLAYER, 10, true)
            self.add_seek(3, SEEK_VILLAGER, 10, false)
            self.add_seek(3, SEEK_GOLEM, 10, true)
            self.add_seek(5, SEEK_TURTLE, 10, true)
            return
        }
        if s == GUARDIAN or s == ELDER_GUARDIAN {
            // `Guardian.registerGoals` (CAL-200): its attack, every tick; toward its home and its
