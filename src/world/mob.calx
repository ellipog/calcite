/// A baby's age as it's made one, `getBabyStartAge`.
pub const BABY_START_AGE: i32 = -24000

/// What a pack's mobs share as each is finalized, `SpawnGroupData`: for an ageable pack,
/// `AgeableMobGroupData`, whether it may have babies, how many of it have been finalized, and the
/// chance each after the first is one; a horses' pack's variant, `HorseGroupData`, by its ID, -1
/// for another; a zombies' pack, `ZombieGroupData`, whether they're babies and may be jockeys; and
/// a spiders', `SpiderEffectsGroupData`, their effect, by `setRandomEffect`'s draw, speed for 0
/// or 1, then strength, regeneration and invisibility, -1 for none (CAL-156).
pub struct SpawnGroup {
    pub ageable: bool = false
    pub babies: bool = true
    pub size: i32 = 0
    pub baby_chance: f32 = 0.05f32
    pub variant: i32 = -1
    pub zombie: bool = false
    pub baby: bool = false
    pub jockey: bool = true
    pub spider: bool = false
    pub effect: i32 = -1
    /// A school's, `SchoolSpawnGroupData` (CAL-178): its first fish, its leader, by ID.
    pub leader: i32 = -1
}

/// What a mob's finalizing reads of where and when it's made (CAL-156): the difficulty there,
/// `getCurrentDifficultyAt`, whether it's Halloween, `SpecialDates.isHalloween`, the 31st of
/// October where the server is, and whether it spawns naturally, `EntitySpawnReason.NATURAL`, as
/// natural spawning's do and a command's, a chunk's generation's and reinforcements' don't
/// (CAL-165); or as what another's turned into, `EntitySpawnReason.CONVERSION` (CAL-244).
pub struct Occasion {
    pub local: LocalDifficulty
    pub halloween: bool = false
    pub natural: bool = true
    pub conversion: bool = false
    /// Whether a camel husk would have room where a husk's made, its spawn box at the husk's
    /// block's middle meeting no block, `noCollision`, as natural spawning asks of a husk alone
    /// (CAL-175).
    pub camel_room: bool = false
    /// Whether it's a structure's, `EntitySpawnReason.STRUCTURE` (CAL-87).
    pub structure: bool = false
    /// Whether it's a raid's wave's, `EntitySpawnReason.EVENT` (CAL-167).
    pub event: bool = false
    /// Whether it's a patrol's, `EntitySpawnReason.PATROL` (CAL-167).
    pub patrol: bool = false
}

impl Occasion {
    /// On normal in a new world, not on Halloween: a special multiplier of 0, so none of the odds
    /// that go by it come up.
    pub fn plain() -> Occasion {
        return Occasion { local: LocalDifficulty.new(Difficulty.Normal, 0, 0, 0.0f32) }
    }
}

/// What a mob steers of what it rides (D710): that one's navigation, its move control and what
/// they read of it.
pub struct Steering {
    pub navigation: Navigation
    pub moves: MoveControl
    pub walker: Walker
    /// Its `chargeSpeedModifier`, which a spear user riding it charges and gets away by: a
    /// zombie horse's 1.4, else 1.
    pub charge: f32 = 1.0f32
}

/// What a mob's finalizing makes besides it (CAL-156), a jockey's mount or rider.
pub interface Making {
    /// `EntityType.create` of a mob of the kind `species` at x, y, z, its ID and its own random
    /// taken as its constructor takes them, ready to finalize in the biome `biome`; none where
    /// Calcite doesn't make its type.
    fn make_kind(mut self, species: i32, x: f64, y: f64, z: f64, biome: i32) -> Mob?
    /// `addFreshEntity`: the mob in the level at once, before the one being finalized.
    fn add_made(mut self, mob: own Mob)
    /// A rider of the one being finalized, added after it, as `addFreshEntityWithPassengers` adds
    /// it.
    fn add_passenger(mut self, mob: own Mob)
    /// `addEffect` of `e` on `mob` as it's finalized, `Mob.add_effect` with the living facts the
    /// maker holds, its sound unheard, as only the omens make one (CAL-163); a maker without them
    /// puts it on as it is.
    fn add_effect(mut self, mob: mut Mob, e: ActiveEffect) {
        mob.living.effects.push(e.copy())
        mob.living.effects_dirty = true
    }
    /// The world's loot, whose enchantments a mob's spawn equipment is enchanted from (D522);
    /// none for a maker without it, which leaves the equipment as it is, only drawn for.
    fn world_loot(self) -> Shared<Loot>? {
        return none
    }
    /// The dimension of the level it makes in, where a mob that came from its data and wasn't made
    /// by it is (CAL-200); none known for a maker that sees no level.
    fn level_dimension(self) -> String {
        return String()
    }
    /// `startRiding` of `rider`, a baby zombie being finalized, onto the first chicken in the
    /// level whose box meets `near` that may be ridden, `getEntitiesOfClass(Chicken.class, near,
    /// ENTITY_NOT_BEING_RIDDEN)` (D709): alive, neither riding nor ridden; made a jockey's mount,
    /// `setChickenJockey`, as it takes `rider` once `rider`'s added. Whether there was one; none
    /// for a maker that sees no level.
    fn ride_chicken_near(mut self, rider: mut Mob, near: Aabb) -> bool {
        _ = rider.living.body.id
        _ = near.min_x
        return false
    }
}

// A brain's tick stopped for its level to swing the doors a behavior swung, or to break the block
// a behavior broke (CAL-160): its behaviors as it took them, the next to start, and the brain they
// were taken from where a behavior made it again, `refreshBrain`; and where it stopped among its
// running behaviors' ticks, those running and the next to tick.
struct HeldBrain {
    runs: List<Run>
    at: usize
    old: Brain?
    ticking: List<usize>? = none
    tick_at: usize = 0
}

/// A maker of nothing, for a mob finalized alone, as a test's.
pub struct Unmade {}

impl Making for Unmade {
    fn make_kind(mut self, species: i32, x: f64, y: f64, z: f64, biome: i32) -> Mob? {
        _ = species + biome
        _ = x + y + z
        return none
    }

    fn add_made(mut self, mob: own Mob) {
        _ = mob
    }

    fn add_passenger(mut self, mob: own Mob) {
        _ = mob
    }
}

/// What a mob reads of the light where it is (CAL-156).
pub interface MobLight {
    /// `getLightLevelDependentMagicValue` at the block, as `Entity`'s reads it at its eyes: the
    /// brightest light there over 15, curved, and lerped to 1 by the dimension's ambient light; 0
    /// where the block's chunk isn't loaded.
    fn magic_light(self, x: i32, y: i32, z: i32) -> f32
    /// Whether monsters burn in daylight at the block, `MONSTERS_BURN`.
    fn monsters_burn(self, x: i32, y: i32, z: i32) -> bool
    /// Whether the block sees the sky, `canSeeSky`: its sky light full, 15 (D437).
    fn sees_sky(self, x: i32, y: i32, z: i32) -> bool
    /// Whether it's bright outside, `isBrightOutside`, as a skeleton's sun goals ask (CAL-159);
    /// never where the level can't tell.
    fn bright_outside(self) -> bool {
        return false
    }

    /// Whether it rains, `isRaining`, which keeps bees from flowers, and whether bees stay in
    /// their hives, `BEES_STAY_IN_HIVE`, as at night (CAL-177); neither where the level can't
    /// tell.
    fn raining(self) -> bool {
        return false
    }

    fn bees_stay_in_hive(self) -> bool {
        return false
    }

    /// How many bees the beehive or bee nest at the block holds, `BeehiveBlockEntity.stored`,
    /// none where there's none there (CAL-177).
    fn hive_bees(self, x: i32, y: i32, z: i32) -> i32? {
        _ = x + y + z
        return none
    }

    /// How many have the chest at the block open, `ChestBlockEntity.getOpenCount`, which a tame
    /// cat won't sit on but at 0 (CAL-201); 0 where the level can't tell.
    fn chest_openers(self, x: i32, y: i32, z: i32) -> i32 {
        _ = x + y + z
        return 0
    }

    /// Whether piglins and hoglins zombify at the block, `PIGLINS_ZOMBIFY`, by its biome, as the
    /// level's tick has it (CAL-200); so where the level can't tell, as in the overworld.
    fn zombifies(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return true
    }

    /// Whether it's thundering, `isThundering`, as the level's tick has it, which a fox seeking
    /// shelter asks (CAL-201); not where the level can't tell.
    fn thundering(self) -> bool {
        return false
    }

    /// Whether a snow golem melts at the block, `SNOW_GOLEM_MELTS`, by its biome, as the level's
    /// tick has it (CAL-201); not where the level can't tell.
    fn snow_golem_melts(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }

    /// The chance a tame cat gives a gift at the block as its owner wakes,
    /// `CAT_WAKING_UP_GIFT_CHANCE`, by its biome, as the level's tick has it (CAL-201); 0 where the
    /// level can't tell.
    fn cat_gift_chance(self, x: i32, y: i32, z: i32) -> f32 {
        _ = x + y + z
        return 0.0f32
    }

    /// The rabbits the biome at the block gives, `level.getBiome`'s, as `MobFacts.rabbits` has
    /// them, which a rabbit's breeding draws by (CAL-201); 0 where the level can't tell.
    fn rabbits_at(self, x: i32, y: i32, z: i32) -> i32 {
        _ = x + y + z
        return 0
    }
}

