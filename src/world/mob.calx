/// A mob.
pub struct Mob {
    /// What every living entity has; its kind, and its type's category.
    pub living: Living
    /// The sounds it made away from its tick, a slime's splash as its size changed in water, for
    /// its level to play at once (CAL-165).
    pub splashed: List<EntitySound> = List<EntitySound>()
    pub species: i32
    pub category: i32
    /// The block it was last in as it came to tick, `lastPos`, none at first, and the
    /// location-changed effects of its enchantments that hold, `activeLocationDependentEnchantments`
    /// (CAL-218). Neither is saved, as vanilla's aren't.
    pub last_block: (i32, i32, i32)? = none
    pub located: List<MobLocated> = List<MobLocated>()
    /// What it wore and held as its enchantments last looked, `collectEquipmentChanges`'
    /// `lastEquipmentItems` (CAL-218), nothing at first, so what it starts with runs them.
    pub located_worn: List<Tag?> = List<Tag?>()
    /// Whether it must stay, and may pick up loot; how long it's done nothing; how long since its
    /// last ambient sound, `ambientSoundTime`, below 0 just after one, and its interval; and that
    /// sound, with how loud it's played, `getSoundVolume`.
    pub persistence_required: bool = false
    /// The lightning bolt that last struck it, by its ID, a mooshroom's `lastLightningBoltUUID`,
    /// not saved (CAL-326).
    pub last_bolt: i32 = -1
    /// An endermite's ticks alive where it needn't stay, `life`, saved as `Lifetime` (D583).
    pub life: i32 = 0
    /// Whether a skeleton horse is a trap, `isTrap`, its goal added once, and its ticks as one,
    /// `trapTime`, saved as `SkeletonTrap` and `SkeletonTrapTime` (CAL-349).
    pub skeleton_trap: bool = false
    pub trap_goal_added: bool = false
    pub trap_time: i32 = 0
    /// A silverfish's goal ticks till it looks for its friends, `lookForFriends`, which a hurt
    /// starts at 10, `notifyHurt`, not saved (CAL-172).
    look_for_friends: i32 = 0
    /// Where its look for its friends stopped, at the block it woke, by its offsets up, across x
    /// and across z, for its level to break it then and there, as vanilla's `destroyBlock` does,
    /// the paths near found again before it goes on; and the goal its goals' tick stopped at, to
    /// go on from (CAL-172).
    wake_at: (i32, i32, i32)? = none
    goals_from: usize? = none
    goals_stop: bool = false
    /// Where its goals' stops, 0, or starts, 1, stopped for its level, a door a goal swung, to go
    /// on from (CAL-167).
    goals_resume: (i32, usize)? = none
    /// A sulfur cube's own state (CAL-402).
    pub sulfur: SulfurLife = SulfurLife()
    /// An ender dragon's own state, `world.dragon`'s, none for any other (D608).
    pub dragon: Dragon? = none
    pub can_pick_up_loot: bool = false
    pub no_action_time: i32 = 0
    pub ambient_sound_time: i32 = 0
    pub ambient_interval: i32 = 80
    pub ambient: String? = none
    pub sound_volume: f32 = 1.0f32
    /// Whether its type is allowed in peaceful, `isAllowedInPeaceful`, and it's an animal, `Animal`.
    pub peaceful_ok: bool = true
    pub animal: bool = false
    /// Whether it ages, and an ageable mob's age and forced age; an animal's love, `inLove`; and
