            let chicken = s == CHICKEN
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: if chicken { 1.4 } else { 2.0 } }))
            self.add_breed(2)
            if chicken {
                self.add_tempt(3, TEMPT_CHICKEN, 1.0)
                self.add_follow(4, 1.1)
            } else {
                self.add_tempt(3, TEMPT_COW, 1.25)
                self.add_follow(4, 1.25)
            }
            self.add_stroll(5, 1.0)
            self.add_looks(6)
        } else if s == PIG {
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.25 }))
            self.add_breed(3)
            self.add_tempt(4, TEMPT_PIG_STICK, 1.2)
            self.add_tempt(4, TEMPT_PIG, 1.2)
            self.add_follow(5, 1.1)
            self.add_stroll(6, 1.0)
            self.add_looks(7)
        } else if s == SHEEP {
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.25 }))
            self.add_breed(2)
            self.add_tempt(3, TEMPT_SHEEP, 1.1)
            self.add_follow(4, 1.1)
            self.goals.add(5, FLAG_MOVE | FLAG_LOOK | FLAG_JUMP, false, Goal.EatBlock(EatBlock()))
            self.add_stroll(6, 1.0)
            self.add_looks(7)
        } else if s == LLAMA {
            // `Llama.registerGoals` (CAL-201): floating, 0; running about at 1.2 with a player on
            // it till tamed, 1; following a caravan at 2.1, 2; spitting at its target at 1.25, every
            // 40 ticks within 20, `RangedAttackGoal`, and panicking at 1.2, 3; breeding, which
            // horses' kind Calcite hasn't yet, 4; tempted at 1.25 by `#llama_tempt_items`, 5;
            // following its parent at 1, 6; strolling at 0.7, 7; looking at players within 6, 8,
            // and about, 9. Its target goals: what hurt it, which it lets go once it's spat,
            // `LlamaHurtByTargetGoal`, 1; and wild wolves within a quarter of its follow range,
            // unseen, one in 16 tries, `LlamaAttackWolfGoal`, 2.
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            self.goals.add(1, FLAG_MOVE, false, Goal.RunAround(RunAround { speed: 1.2 }))
            self.goals.add(2, FLAG_MOVE, false, Goal.Caravan(Caravan()))
            self.goals.add(3, FLAG_MOVE | FLAG_LOOK, true, Goal.Ranged(Ranged { speed: 1.25, interval_min: 40, interval_max: 40, radius: 20.0f32 }))
            self.goals.add(3, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.2 }))
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, false, Goal.Later(LATER_BREED))
            self.add_tempt(5, TEMPT_LLAMA, 1.25)
            self.add_follow(6, 1.0)
            self.add_stroll(7, 0.7)
            self.add_looks(8)
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: false, targeting: Targeting { must_see: true }, llama: true }))
            self.targets.add(2, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_WOLF, interval: reduced_tick_delay(16), targeting: Targeting { must_see: false, scale: 0.25 }, wild: true }))
        } else if self.equine() {
            self.goals.add(1, FLAG_MOVE, false, Goal.RunAround(RunAround { speed: 1.2 }))
            self.goals.add(2, FLAG_MOVE | FLAG_LOOK, false, Goal.Later(LATER_BREED))
            self.add_follow(4, 1.0)
            self.add_stroll(6, 0.7)
            self.add_looks(7)
            // `RandomStandGoal`, its count from minus its ambient interval as it's made.
            self.goals.add(9, 0, true, Goal.Stand(Stand { next: -self.ambient_interval }))
            // A skeleton horse's behaviour goals none, `addBehaviourGoals` (CAL-349).
            if s == SKELETON_HORSE {
                return
            }
            self.goals.add(0, FLAG_JUMP, true, Goal.Float(0))
            if s == ZOMBIE_HORSE {
                self.add_tempt(3, TEMPT_ZOMBIE_HORSE, 1.25)
            } else {
                self.goals.add(1, FLAG_MOVE, false, Goal.Panic(Panic { speed: 1.2 }))
                self.add_tempt(3, TEMPT_HORSE, 1.25)
            }
        }
    }

    /// `AbstractSkeleton.reassessWeaponGoal`, on hard where `hard` (CAL-159): its weapon goal taken
    /// out, stopped where it ran and kept aside; then, at 4 after its other goals, its
    /// `RangedBowAttackGoal` where it holds a bow, as `getWeaponHoldingHand` finds it, at 1, 15
    /// blocks, its least ticks between shots 20 on hard and 40 else, a bogged's and a parched's 50
    /// and 70, `getHardAttackInterval` and `getAttackInterval`, or else its `MeleeAttackGoal`, at
    /// 1.2, aggressive as it runs; each with the state it was kept with.
    pub fn reassess_weapon(mut self, hard: bool) {
        if not self.skeletal() {
            return
        }
        if let taken = self.goals.take_weapon_goal() {
            let (g, ran) = taken
            match g {
                Goal.Bow(b) => {
                    var s = b
                    if ran {
                        self.set_flag(AGGRESSIVE_FLAG, false)
                        s.see_time = 0
                        s.attack_time = -1
                        self.living.stop_using()
                    }
                    self.spare_bow = some(s)
                },
                Goal.Melee(held) => {
                    if ran {
                        self.set_flag(AGGRESSIVE_FLAG, false)
                        self.navigation.stop()
                    }
                    self.spare_melee = some(held)
                },
                _ => {},
            }
        }
        if self.holding_bow() {
            var b = self.spare_bow.take() ?? Bow { speed: 1.0, interval: 20, radius_sqr: 225.0f32 }
            let slow = self.species == BOGGED or self.species == PARCHED
            b.interval = if hard { if slow { 50 } else { 20 } } else if slow { 70 } else { 40 }
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Bow(b))
        } else {
            let ml = self.spare_melee.take() ?? Melee { speed: 1.2, follow_unseen: false, zombie: false }
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(ml))
        }
    }

    /// A cat's `reassessTameGoals`, as it's made and tamed and read (CAL-201): its
    /// `CatAvoidEntityGoal` of players, from 16 at 0.8, 1.33 within 7, taken out, `removeGoal`,
    /// stopped where it ran, `toAvoid` let go; then, while it's wild, put back at 4 after its
    /// other goals.
    pub fn reassess_tame_goals(mut self) {
        if self.species != CAT and self.species != OCELOT {
            return
        }
        _ = self.goals.take_player_avoid()
        if not (if self.species == OCELOT { self.ocelot_trusting() } else { self.is_tame() }) {
            self.goals.add(4, FLAG_MOVE, false, Goal.Avoid(Avoid { max_dist: 16.0f32, walk: 0.8, sprint: 1.33 }))
        }
    }

    // Whether it holds a bow in either hand, `isHolding(Items.BOW)`, and in its main hand,
    // `getWeaponHoldingHand` (CAL-159).
    fn holding_bow(self) -> bool {
        return self.main_is_bow() or held_name(self.living.equipment[1]) == "minecraft:bow"
    }

    fn main_is_bow(self) -> bool {
        return held_name(self.living.equipment[0]) == "minecraft:bow"
    }

    // `NearestAttackableTargetGoal` at `priority` in its target goals, looking for the `SEEK_` kind
    // `seek` one in `interval` of its tries, halved, `reducedTickDelay`, keeping only a target it
    // sees where `must_see` (CAL-159).
    fn add_seek(mut self, priority: i32, seek: i32, interval: i32, must_see: bool) {
        if seek == SEEK_GOLEM {
            self.seeks_golems = true
        }
        self.targets.add(priority, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: seek, interval: reduced_tick_delay(interval), targeting: Targeting { must_see: must_see } }))
    }

    // `TemptGoal` at `priority`, toward a player holding what's in the set `bit`, at `speed`, not
    // scared off.
    fn add_tempt(mut self, priority: i32, bit: u32, speed: f64) {
        self.goals.add(priority, FLAG_MOVE | FLAG_LOOK, false, Goal.Tempt(Tempt { bit: bit, speed: speed }))
    }

    // `BreedGoal` at `priority`, at 1, for a partner of its own kind.
    fn add_breed(mut self, priority: i32) {
        self.goals.add(priority, FLAG_MOVE | FLAG_LOOK, false, Goal.Breed(Breed { speed: 1.0 }))
    }

    // `FollowParentGoal` at `priority`, at `speed`, taking no controls.
    fn add_follow(mut self, priority: i32, speed: f64) {
        self.goals.add(priority, 0, false, Goal.FollowParent(FollowParent { speed: speed }))
    }

    /// Whether its brain's item sensor looks over the items near it, `NearestItemSensor`, which
    /// its level tells it are there, `items_near`: a villager's (CAL-160) and a piglin's (CAL-200).
    pub fn wants_items(self) -> bool {
        return self.species == VILLAGER or self.species == PIGLIN
    }

    /// Whether its goals may look among the mobs near it this tick, which its level finds for it,
    /// `kin`: a baby's of a kind that follows its parents, and one's in love or breeding (CAL-158);
    /// and a schooling fish's always, with its leader (CAL-178).
    pub fn wants_kin(self) -> bool {
        let s = self.species
        if schooling_kind(s) or s == POLAR_BEAR or (raider_kind(s) and self.patrolling) {
            return true
        }
        let follows = s == COW or s == MOOSHROOM or s == PIG or s == CHICKEN or s == SHEEP or s == BEE or self.equine() or s == FOX or s == PANDA
        return (follows and (self.age < 0 or self.in_love > 0 or self.goals.breeding())) or ((s == WOLF or s == CAT or s == OCELOT or s == RABBIT or s == TURTLE) and (self.in_love > 0 or self.goals.breeding())) or (s == CAT and self.is_tame())
    }

    /// Whether its goals may look among the level's other mobs this tick, `prey` (CAL-244): a
    /// zombie's or zombie villager's for villagers, an enderman's for endermites, or one with a
    /// target or a living entity that hurt it, which may be a mob.
    pub fn wants_prey(self) -> bool {
        // A guardian's for the guardians it looks at (CAL-200); a creeper's for the ocelots and cats
        // it flees, a spider's for armadillos, and a swooping phantom's for the cats it fears
        // (CAL-201).
        if (self.zombie_class() and self.species != ZOMBIFIED_PIGLIN) or self.species == ENDERMAN or self.guardian_kind() or illager_kind(self.species) or self.species == RAVAGER or self.species == VEX or self.species == IRON_GOLEM or self.species == SNOW_GOLEM or self.species == WITHER_BOSS or self.species == WOLF or self.species == OCELOT or self.species == CAT or self.species == RABBIT or self.species == CREEPER or self.species == SPIDER or self.species == CAVE_SPIDER or self.species == FOX or self.species == POLAR_BEAR or self.species == LLAMA or self.species == PANDA or self.species == PUFFERFISH or squid_kind(self.species) or self.species == DOLPHIN or (self.species == PHANTOM and self.phantom.swoop) or self.skeletal() or self.seeks_golems {
            return true
        }
        return self.target != none or self.living.hurt_by_mob != none
    }

    /// What a baby of its breeding takes of it, `Kin.variant`: a cow's, pig's or chicken's variant,
    /// a mooshroom's type or a sheep's wool's colour, by their IDs.
    pub fn breed_variant(self) -> i32 {
        let s = self.species
        if s == MOOSHROOM {
            return self.living.data.number(MOOSHROOM_TYPE)
        }
        if s == SHEEP {
            return self.color()
        }
        if s == RABBIT or s == FOX {
            return self.living.data.number(OWN)
        }
        return self.variant
    }

    /// A baby of breeding's variant set, `setVariant`, as `breed_variant` has it.
    pub fn set_breed_variant(mut self, v: i32) {
        let s = self.species
        if s == RABBIT {
            self.set_rabbit_variant(v)
            return
        }
        if s == MOOSHROOM {
            self.living.data.set(MOOSHROOM_TYPE, Value.Number(v))
        } else if s == SHEEP {
            self.set_color(v)
        } else if s == FOX {
            self.living.data.set(OWN, Value.Number(v))
        } else if s == COW or s == PIG or s == CHICKEN or s == WOLF or s == CAT {
            self.set_variant(v)
        }
    }

    /// Its partner's part of `finalizeSpawnChildFromBreeding`: 6000 ticks from breeding again,
    /// `setAge`, and out of love, `resetLove`.
    pub fn bred_again(mut self) {
        self.set_age(6000)
        self.in_love = 0
    }

    // `WaterAvoidingRandomStrollGoal` at `priority`, at `speed`.
    fn add_stroll(mut self, priority: i32, speed: f64) {
        self.goals.add(priority, FLAG_MOVE, false, Goal.Stroll(Stroll { speed: speed }))
    }

    // `LookAtPlayerGoal` within 6 at `priority`, then `RandomLookAroundGoal` after it.
    fn add_looks(mut self, priority: i32) {
        self.goals.add(priority, FLAG_LOOK, false, Goal.LookAtPlayer(LookAtPlayer { distance: 6.0f32 }))
        self.goals.add(priority + 1, FLAG_MOVE | FLAG_LOOK, true, Goal.LookAround(LookAround()))
    }

    /// Where natural spawning makes it, in the biome `biome`: the variants it may spawn as there,
    /// `VariantUtils.selectVariantToSpawn`'s, and a sheep's climate, which `finalize_spawn` draws
    /// by.
    pub fn spawning_in(mut self, facts: MobFacts, biome: i32) {
        self.spawn_biome = biome
        if self.species == COW {
            self.spawn_variants = facts.cow.spawnable(biome)
        } else if self.species == PIG {
            self.spawn_variants = facts.pig.spawnable(biome)
        } else if self.species == CHICKEN {
            self.spawn_variants = facts.chicken.spawnable(biome)
        } else if self.species == WOLF {
            self.spawn_variants = facts.wolf.spawnable(biome)
        } else if self.species == CAT {
            self.spawn_variants = facts.cat.spawnable(biome)
        }
        self.climate = facts.climate(biome)
        self.villager_type = facts.villager_type(biome)
        self.rabbit.biome = facts.rabbit_kind(biome)
        self.fox.snow = facts.snow_fox(biome)
    }

    /// Where it's made at `at`, as `spawning_in` its biome has it, a cat's variants those its
    /// `SpawnContext` takes, with the moon's brightness and the structures there (CAL-201).
    pub fn spawning_at(mut self, facts: MobFacts, at: SpawnAt) {
        self.spawning_in(facts, at.biome)
        if self.species == CAT {
            self.spawn_variants = facts.cat.spawnable_at(at)
        }
    }

    /// Its flags, `DATA_MOB_FLAGS_ID`, and whether it's without AI, `isNoAi`, and left-handed.
    pub fn flags(self) -> i32 {
        return i32(self.living.data.byte(MOB_FLAGS))
    }

    pub fn no_ai(self) -> bool {
        return self.flags() & NO_AI_FLAG != 0
    }

    pub fn left_handed(self) -> bool {
        return self.flags() & LEFT_HANDED_FLAG != 0
    }

    /// Whether it's aggressive, `isAggressive`.
    pub fn aggressive(self) -> bool {
        return self.flags() & AGGRESSIVE_FLAG != 0
    }

    fn set_flag(mut self, bit: i32, on: bool) {
        self.living.data.set_flag(MOB_FLAGS, bit, on)
    }

    /// A cow's, pig's or chicken's variant, set and synced.
    pub fn set_variant(mut self, id: i32) {
        self.variant = id
        let at = if self.species == PIG { OWN + 1 } else if self.species == WOLF { OWN + 5 } else if self.species == CAT { OWN + 2 } else { OWN }
        self.living.data.set(at, Value.Number(id))
    }

    /// Its variant by its name, where it's one of its kind's, as a chicken an egg hatches takes
    /// the egg's (CAL-214).
    pub fn set_variant_named(mut self, name: String) {
        if let at = index_of(self.variant_names, name) {
            self.set_variant(at)
        }
    }

    /// Its sound variant, set and synced, its sounds with it.
    pub fn set_sound_variant(mut self, id: i32) {
        self.sound_variant = id
        let at = if self.species == PIG { OWN + 2 } else if self.species == WOLF { OWN + 6 } else if self.species == CAT { OWN + 6 } else { OWN + 1 }
        self.living.data.set(at, Value.Number(id))
        self.refresh_sounds()
    }

    /// A horse's or donkey's flag `bit`, `getFlag`: 2 tame, 8 bred, 16 eating, 32 standing and 64
    /// its mouth open; and set, `setFlag`.
    pub fn horse_flag(self, bit: i32) -> bool {
        return i32(self.living.data.byte(OWN)) & bit != 0
    }

    pub fn set_horse_flag(mut self, bit: i32, on: bool) {
        let flags = i32(self.living.data.byte(OWN))
        let next = if on { flags | bit } else { flags & ~bit }
        self.living.data.set(OWN, Value.Byte(i8.wrap(next)))
    }

    /// A horse's variant and markings, `getTypeVariant`, its variant's ID in the low byte and its
    /// markings' above.
    pub fn horse_variant(self) -> i32 {
        return self.living.data.number(OWN + 1)
    }

    /// A sheep's wool's color, by its ID, `setColor`, kept shorn or not.
    pub fn set_color(mut self, color: i32) {
        let wool = i32(self.living.data.byte(OWN))
        self.living.data.set(OWN, Value.Byte(i8.wrap((wool & 240) | (color & 15))))
    }

    /// A sheep's wool's color's ID, and whether it's shorn.
    pub fn color(self) -> i32 {
        return i32(self.living.data.byte(OWN)) & 15
    }

    /// A bogged sheared of its mushrooms, `Bogged.setSheared(true)` (CAL-200).
    pub fn shear_bogged(mut self) {
        self.living.data.set(MONSTER_OWN, Value.Bool(true))
    }

    pub fn sheared(self) -> bool {
        return i32(self.living.data.byte(OWN)) & 16 != 0
    }

    /// Whether a bee's flag `flag` is set, `Bee.getFlag` (CAL-177).
    pub fn bee_flag(self, flag: i32) -> bool {
        return i32(self.living.data.byte(OWN)) & flag != 0
    }

    /// A bee's flag `flag` set or cleared, `Bee.setFlag`: with nectar, its ticks without it start
    /// again, `setHasNectar` (CAL-177).
    pub fn set_bee_flag(mut self, flag: i32, on: bool) {
        if flag == BEE_NECTAR and on {
            self.bee.without_nectar = 0
        }
        self.living.data.set_flag(OWN, flag, on)
    }

    /// A bee its hive at `hive` let out after `ticks` in it, as it's made after it's loaded
    /// (CAL-177): not falling, `setNoGravity`; its hive known, `setHivePos`; its age and love as
    /// much nearer their ends as it was in, unless its age is locked, `setBeeReleaseData`; the
    /// flower its hive passed it, where it did; and its nectar dropped off where it delivered
    /// honey, `dropOffNectar`.
    pub fn released(mut self, hive: (i32, i32, i32), ticks: i32, flower: (i32, i32, i32)?, delivered: bool) {
        self.living.body.no_gravity = true
        self.living.data.set(NO_GRAVITY, Value.Bool(true))
        self.bee.hive = some(hive)
        if not self.living.data.flag(AGE_LOCKED) {
            let a = self.age
            if a < 0 {
                self.set_age(if a + ticks < 0 { a + ticks } else { 0 })
            } else if a > 0 {
                self.set_age(if a - ticks > 0 { a - ticks } else { 0 })
            }
        }
        let love = self.in_love - ticks
        self.in_love = if love > 0 { love } else { 0 }
        if let known = flower {
            self.bee.flower = some(known)
        }
        if delivered {
            self.set_bee_flag(BEE_NECTAR, false)
            self.bee.crops_grown = 0
        }
    }

    /// Whether a bee's angry, `NeutralMob.isAngry`: its anger's end still to come (CAL-177).
    pub fn bee_angry(self) -> bool {
        let end = self.living.data.long(OWN + 1)
        return end > 0i64 and end - self.game_time > 0i64
    }

    // `Bee.aiStep`'s, after an animal's (CAL-177): its countdowns down a tick each; rolling where
    // it's angry, hasn't stung and its target's within 2 blocks, `distanceToSqr` under 4, a mob
    // target's said to be missing; and every 20 ticks its hive forgotten where it's gone,
    // `isHiveValid`: no hive or bee nest there, or too far, 48 blocks.
    fn bee_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>, heard: usize) {
        if self.bee.stay_out > 0 {
            self.bee.stay_out -= 1
        }
        if self.bee.hive_cooldown > 0 {
            self.bee.hive_cooldown -= 1
        }
        if self.bee.flower_cooldown > 0 {
            self.bee.flower_cooldown -= 1
        }
        var rolls = false
        if self.bee_angry() and not self.bee_flag(BEE_STUNG) {
            if let t = self.target {
                var found = false
                for p in players {
                    if p.id == t {
                        found = true
                        let (dx, dy, dz) = (p.x - self.living.body.x, p.y - self.living.body.y, p.z - self.living.body.z)
                        rolls = dx * dx + dy * dy + dz * dz < 4.0
                    }
                }
                if not found {
                    self.living.show(Shown.Missing(String("A bee's roll at a mob it targets")), heard)
                }
            }
        }
        self.set_bee_flag(BEE_ROLLING, rolls)
        if self.living.body.tick_count % 20 == 0 and not self.hive_valid(lf, f, blocks) {
            self.bee.hive = none
        }
    }

    // A bee's `isHiveValid`: its hive within 48 blocks, `isTooFarAway`, a beehive or bee nest,
    // whose block entity it is, there (CAL-177).
    fn hive_valid<B: CollisionBlocks>(self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let (hx, hy, hz) = self.bee.hive else return false
        let (bx, by, bz) = self.living.body.block()
        let (dx, dy, dz) = (f64(hx - bx), f64(hy - by), f64(hz - bz))
        if not (dx * dx + dy * dy + dz * dz < 2304.0) {
            return false
        }
        let state = blocks.collision_state(hx, hy, hz) else return false
        return f.in_set(state, lf.beehives)
    }

    // `AbstractSchoolingFish.tick`'s, after the rest (CAL-178): one with followers, 1 in 200 by
    // the level's random, alone among the fish of its kind whose boxes meet its own grown by 8,
    // has a school of itself only again, its followers following it still.
    fn school_check(mut self, heard: usize) {
        if self.school_size <= 1 {
            return
        }
        let lent = self.level_random.take()
        let had = lent != none
        if not had {
            self.living.show(Shown.Missing(String("A schooling fish's look at its school without its level's random")), heard)
        }
        var random = lent ?? TapedRandom.new(0i64)
        let drawn = random.next_int_below(200)
        if had {
            self.level_random = some(random)
        }
        if drawn != 1 {
            return
        }
        let b = self.living.body.bounding_box()
        var near = 0
        for k in self.kin {
            if k.species != self.species {
                continue
            }
            let at = if k.id == self.living.body.id { b } else { k.bounds }
            if at.intersects(b.min_x - 8.0, b.min_y - 8.0, b.min_z - 8.0, b.max_x + 8.0, b.max_y + 8.0, b.max_z + 8.0) {
                near += 1
            }
        }
        if near <= 1 {
            self.school_size = 1
        }
    }

    // `Bee.tick`'s, after the rest (CAL-177): one with nectar that's grown fewer than 10 crops
    // since, one tick in 20 by its random, drips it, once and then again one time in 2, each drip's
    // place drawn from the level's random, which only clients show. How much it rolls,
    // `rollAmount`, only they show too.
    fn bee_drips(mut self, heard: usize) {
        if not (self.bee_flag(BEE_NECTAR) and self.bee.crops_grown < 10 and self.living.body.random.next_float() < 0.05f32) {
            return
        }
        let lent = self.level_random.take()
        let had = lent != none
        if not had {
            self.living.show(Shown.Missing(String("A bee's drips without its level's random")), heard)
        }
        var random = lent ?? TapedRandom.new(0i64)
        var i = 0
        while i < self.living.body.random.next_int_below(2) + 1 {
            _ = random.next_double()
            _ = random.next_double()
            i += 1
        }
        if had {
            self.level_random = some(random)
        }
    }


    // A bee's `wantsToEnterHive` (CAL-177): past its countdown, not pollinating, not stung and with
    // no target, it wants in with nectar, after 3600 ticks out without it, or where bees stay in,
    // by night or in the rain, `BEES_STAY_IN_HIVE`; but not where its hive's by fire,
    // `isHiveNearFire`.
    fn bee_wants_hive<B: CollisionBlocks + MobLight>(self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        if self.bee.stay_out > 0 or self.bee.pollinating or self.bee_flag(BEE_STUNG) or self.target != none {
            return false
        }
        let wants = self.bee_flag(BEE_NECTAR) or self.bee.without_nectar > 3600 or blocks.bees_stay_in_hive()
        return wants and not self.hive_near_fire(lf, f, blocks)
    }

    // `isHiveNearFire`: its hive, where it's valid, with fire in a block of it, `isFireNearby`, a
    // `FireBlock`, which soul fire isn't.
    fn hive_near_fire<B: CollisionBlocks>(self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        if not self.hive_valid(lf, f, blocks) {
            return false
        }
        let (hx, hy, hz) = self.bee.hive else return false
        for dx in -1..2 {
            for dy in -1..2 {
                for dz in -1..2 {
                    if f.is_a(f.block(state_at(blocks, hx + dx, hy + dy, hz + dz)), "FireBlock") {
                        return true
                    }
                }
            }
        }
        return false
    }

    // `Bee.closerThan`: the block `p` nearer its block than `d`, `BlockPos.closerThan`.
    fn bee_near(self, p: (i32, i32, i32), d: f64) -> bool {
        let (x, y, z) = p
        let (bx, by, bz) = self.living.body.block()
        let (dx, dy, dz) = (f64(x - bx), f64(y - by), f64(z - bz))
        return dx * dx + dy * dy + dz * dz < d * d
    }

    // How many bees its hive holds, `getBeehiveBlockEntity`'s: none where it has none, it's 48
    // blocks or more off, or there's no hive there.
    fn hive_held<B: MobLight>(self, blocks: B) -> i32? {
        let h = self.bee.hive else return none
        if not self.bee_near(h, 48.0) {
            return none
        }
        let (x, y, z) = h
        return blocks.hive_bees(x, y, z)
    }

    // `dropHive`, its hive forgotten and not looked for for 200 ticks; and `dropFlower`, its
    // flower forgotten and not looked for for 20 to 60, drawn.
    fn drop_hive(mut self) {
        self.bee.hive = none
        self.bee.hive_cooldown = 200
    }

    fn drop_flower(mut self) {
        self.bee.flower = none
        self.bee.flower_cooldown = self.living.body.random.next_int_between(20, 60)
    }

    // `BeeGoToHiveGoal.dropAndBlacklistHive`: its hive given up on, the last 3 kept, then
    // forgotten.
    fn blacklist_hive(mut self) {
        if let h = self.bee.hive {
            self.bee.blacklist.push(h)
            while self.bee.blacklist.len() > 3 {
                _ = self.bee.blacklist.remove(0)
            }
        }
        self.drop_hive()
    }

    // `BeeGoToHiveGoal.canBeeUse`: a hive within 48 blocks it wants to go in, not reached, a
    // beehive or bee nest there, and no home, `hasHome`, which a leash gives it (CAL-179).
    fn goes_to_hive<B: CollisionBlocks + MobLight>(self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let h = self.bee.hive else return false
        if not self.bee_near(h, 48.0) or self.home != none or not self.bee_wants_hive(lf, f, blocks) or self.reached_hive(h) {
            return false
        }
        let (x, y, z) = h
        let state = blocks.collision_state(x, y, z) else return false
        return f.in_set(state, lf.beehives)
    }

    // `hasReachedTarget`: within 2 blocks of its hive, or with its path to it reached and done.
    fn reached_hive(self, h: (i32, i32, i32)) -> bool {
        if self.bee_near(h, 2.0) {
            return true
        }
        let p = self.navigation.path else return false
        return p.target == h and p.reached and self.navigation.is_done()
    }

    // `BeeGrowCropGoal.canBeeUse`: fewer than 10 crops grown since it had nectar, then 7 times in
    // 10, drawn, with nectar and its hive valid.
    fn grows_crops<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        if self.bee.crops_grown >= 10 {
            return false
        }
        if self.living.body.random.next_float() < 0.3f32 {
            return false
        }
        return self.bee_flag(BEE_NECTAR) and self.hive_valid(lf, f, blocks)
    }

    // A bee's own goals, `Goal.Bee` (CAL-177), by kind: `BaseBeeGoal`'s used and going on only
    // while the bee isn't angry, all but its wander, which isn't one.
    fn bee_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, kind: i32, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            let usable = self.bee_can_use(kind, lf, f, m, blocks, mut cache, min_y)
            return usable and (kind == BEE_WANDER or not self.angry())
        }
        if call == GOAL_CONTINUE {
            let going = self.bee_goes_on(kind, lf, f, blocks)
            return going and (kind == BEE_WANDER or not self.angry())
        }
        if call == GOAL_START {
            self.bee_start(kind, lf, f, m, blocks, mut cache, min_y, sounds.len())
        } else if call == GOAL_TICK {
            self.bee_tick(kind, lf, f, m, blocks, mut cache, min_y, mut sounds)
        } else if call == GOAL_STOP {
            self.bee_stop(kind)
        }
        return false
    }

    // Whether a bee's goal of the kind `kind` can be used, `canBeeUse`.
    fn bee_can_use<B: CollisionBlocks + MobLight + NavLevel>(mut self, kind: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if kind == BEE_ENTER_HIVE {
            // Wanting in, within 2 of its hive's middle, `closerToCenterThan`, and the hive there
            // not full, else forgotten.
            let h = self.bee.hive else return false
            if not self.bee_wants_hive(lf, f, blocks) {
                return false
            }
            let (hx, hy, hz) = h
            let dx = f64(hx) + 0.5 - self.living.body.x
            let dy = f64(hy) + 0.5 - self.living.body.y
            let dz = f64(hz) + 0.5 - self.living.body.z
            if not (dx * dx + dy * dy + dz * dz < 4.0) {
                return false
            }
            let held = self.hive_held(blocks) else return false
            if held != 3 {
                return true
            }
            self.bee.hive = none
            return false
        }
        if kind == BEE_VALIDATE_HIVE {
            return self.game_time > self.bee.hive_checked + i64(self.bee.validate_hive)
        }
        if kind == BEE_VALIDATE_FLOWER {
            return self.game_time > self.bee.flower_checked + i64(self.bee.validate_flower)
        }
        if kind == BEE_POLLINATE {
            // Past its cooldown, without nectar, not in the rain: a flower near it it can reach,
            // headed for at 1.2, else its cooldown 20 to 60, drawn.
            if self.bee.flower_cooldown > 0 or self.bee_flag(BEE_NECTAR) or blocks.raining() {
                return false
            }
            if let at = self.nearby_flower(lf, f, m, blocks, mut cache, min_y) {
                self.bee.flower = some(at)
                let (x, y, z) = at
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, f64(1.2f32))
                return true
            }
            self.bee.flower_cooldown = self.living.body.random.next_int_between(20, 60)
            return false
        }
        if kind == BEE_LOCATE_HIVE {
            return self.bee.hive_cooldown == 0 and self.bee.hive == none and self.bee_wants_hive(lf, f, blocks)
        }
        if kind == BEE_GO_TO_HIVE {
            return self.goes_to_hive(lf, f, blocks)
        }
        if kind == BEE_GO_TO_FLOWER {
            // A flower it knows, no home, which a leash gives it (CAL-179), 600 ticks without nectar,
            // not within 2 of it.
            let at = self.bee.flower else return false
            return self.home == none and self.bee.without_nectar > 600 and not self.bee_near(at, 2.0)
        }
        if kind == BEE_GROW_CROP {
            return self.grows_crops(lf, f, blocks)
        }
        if kind == BEE_WANDER {
            return self.navigation.is_done() and self.living.body.random.next_int_below(10) == 0
        }
        return false
    }

    // Whether a bee's goal of the kind `kind` goes on, `canBeeContinueToUse`: its pollinating
    // while it pollinates a flower it knows out of the rain, one time in 5, drawn, once it's done
    // it for 400 ticks; its way to its hive or flower, and its growing crops, while they could be
    // used; its wander while its navigation's going. The rest are done once started.
    fn bee_goes_on<B: CollisionBlocks + MobLight>(mut self, kind: i32, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        if kind == BEE_POLLINATE {
            if not self.bee.pollinating or self.bee.flower == none or blocks.raining() {
                return false
            }
            return if self.bee.pollinated > 400 { self.living.body.random.next_float() < 0.2f32 } else { true }
        }
        if kind == BEE_GO_TO_HIVE {
            return self.goes_to_hive(lf, f, blocks)
        }
        if kind == BEE_GO_TO_FLOWER {
            let at = self.bee.flower else return false
            return self.home == none and self.bee.without_nectar > 600 and not self.bee_near(at, 2.0)
        }
        if kind == BEE_GROW_CROP {
            return self.grows_crops(lf, f, blocks)
        }
        if kind == BEE_WANDER {
            return not self.navigation.is_done()
        }
        return false
    }

    // A bee's goal of the kind `kind` started.
    fn bee_start<B: CollisionBlocks + MobLight + NavLevel>(mut self, kind: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) {
        if kind == BEE_ENTER_HIVE {
            // `addOccupant`, its level's: its tag as it saves now, for the hive to keep, and it
            // gone. Its ride, riders and leash, which it would leave, are said to be missing.
            if let h = self.bee.hive {
                if self.hive_held(blocks) != none {
                    if self.living.body.vehicle != none or not self.living.body.passengers.is_empty() or self.kept.contains("leash") {
                        self.living.show(Shown.Missing(String("A bee leaving its ride, riders or leash for its hive")), heard)
                    } else {
                        let tag = self.saved()
                        self.living.show(Shown.Hived((h, tag)), heard)
                        self.living.body.removed = true
                    }
                }
            }
        } else if kind == BEE_VALIDATE_HIVE {
            // Its hive forgotten where its chunk's loaded and it isn't valid.
            if let h = self.bee.hive {
                let (x, y, z) = h
                if blocks.collision_state(x, y, z) != none and not self.hive_valid(lf, f, blocks) {
                    self.drop_hive()
                }
            }
            self.bee.hive_checked = self.game_time
        } else if kind == BEE_VALIDATE_FLOWER {
            // Its flower forgotten where its chunk's loaded and it draws bees no more.
            if let at = self.bee.flower {
                let (x, y, z) = at
                if let state = blocks.collision_state(x, y, z) {
                    if not attracts_bees(lf, f, state) {
                        self.drop_flower()
                    }
                }
            }
            self.bee.flower_checked = self.game_time
        } else if kind == BEE_POLLINATE {
            self.bee.pollinated = 0
            self.bee.pollinating_ticks = 0
            self.bee.buzzed = 0
            self.bee.pollinating = true
            self.bee.without_nectar = 0
        } else if kind == BEE_LOCATE_HIVE {
            self.locate_hive(blocks, heard)
        } else if kind == BEE_GO_TO_HIVE {
            self.bee.hive_travel = 0
            self.bee.hive_stuck = 0
        } else if kind == BEE_GO_TO_FLOWER {
            self.bee.flower_travel = 0
        } else if kind == BEE_WANDER {
            self.bee_wander(lf, f, m, blocks, mut cache, min_y)
        }
    }

    // A bee's goal of the kind `kind` stopped: its pollinating, with nectar where it went on 400
    // ticks, its navigation stopped and no flower looked for for 200 ticks; its ways to its hive
    // and flower, their counts reset and its navigation stopped, its searches' nodes back to once.
    fn bee_stop(mut self, kind: i32) {
        if kind == BEE_POLLINATE {
            if self.bee.pollinated > 400 {
                self.set_bee_flag(BEE_NECTAR, true)
            }
            self.bee.pollinating = false
            self.navigation.stop()
            self.bee.flower_cooldown = 200
        } else if kind == BEE_GO_TO_HIVE {
            self.bee.hive_travel = 0
            self.bee.hive_stuck = 0
            self.navigation.stop()
            self.navigation.reset_multiplier()
        } else if kind == BEE_GO_TO_FLOWER {
            self.bee.flower_travel = 0
            self.navigation.stop()
            self.navigation.reset_multiplier()
        }
    }

    // A bee's goal of the kind `kind` ticked.
    fn bee_tick<B: CollisionBlocks + MobLight + NavLevel>(mut self, kind: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) {
        if kind == BEE_POLLINATE {
            self.pollinate_tick(mut sounds)
        } else if kind == BEE_GO_TO_HIVE {
            self.to_hive_tick(lf, f, m, blocks, mut cache, min_y)
        } else if kind == BEE_GO_TO_FLOWER {
            // Its flower given up on after 2400 ticks, or once it's done and 48 blocks off, else
            // headed for a place on the way, `pathfindRandomlyTowards`.
            let at = self.bee.flower else return
            self.bee.flower_travel += 1
            if self.bee.flower_travel > reduced_tick_delay(2400) {
                self.drop_flower()
            } else if self.navigation.is_done() {
                if not self.bee_near(at, 48.0) {
                    self.drop_flower()
                } else {
                    self.towards_randomly(at, lf, f, m, blocks, mut cache, min_y)
                }
            }
        } else if kind == BEE_GROW_CROP {
            // One tick in 15, drawn, each of the 2 blocks under it in `#bee_growables` grown a
            // stage, level event 2011 there and `setBlockAndUpdate`, and its crops grown since it
            // had nectar one more: a crop's age from its default state, a torchflower crop's last
            // its flower, `getStateForAge`; a stem's up to 7 and a sweet berry bush's up to 3; cave
            // vines given berries, `performBonemeal`, set as bone meal sets them first.
            if self.living.body.random.next_int_below(reduced_tick_delay(30)) == 0 {
                let (bx, by, bz) = self.living.body.block()
                for i in 1..3 {
                    let y = by - i
                    let below = state_at(blocks, bx, y, bz)
                    if not f.in_set(below, lf.bee_growables) {
                        continue
                    }
                    let block = f.block(below)
                    let age = f.get_int(below, String("age")) ?? 0
                    var grow: u32? = none
                    var bonemealed = false
                    if f.is_a(block, String("CropBlock")) {
                        let last = f.crop_max_age(block)
                        if age < last {
                            if age + 1 == last and f.is_a(block, String("TorchflowerCropBlock")) {
                                if let flower = f.block_named(String("minecraft:torchflower")) {
                                    grow = some(f.default_state(flower))
                                }
                            } else {
                                match f.with_int(f.default_state(block), String("age"), age + 1) {
                                    ok(s) => grow = some(s),
                                    err(_) => {},
                                }
                            }
                        }
                    } else if f.is_a(block, String("StemBlock")) {
                        if age < 7 {
                            match f.with_int(below, String("age"), age + 1) {
                                ok(s) => grow = some(s),
                                err(_) => {},
                            }
                        }
                    } else if f.is_a(block, String("SweetBerryBushBlock")) {
                        if age < 3 {
                            match f.with_int(below, String("age"), age + 1) {
                                ok(s) => grow = some(s),
                                err(_) => {},
                            }
                        }
                    } else if f.is_a(block, String("CaveVinesBlock")) or f.is_a(block, String("CaveVinesPlantBlock")) {
                        if not f.get_bool(below, String("berries")) {
                            match f.with_bool(below, String("berries"), true) {
                                ok(s) => grow = some(s),
                                err(_) => {},
                            }
                            bonemealed = true
                        }
                    }
                    if let g = grow {
                        if bonemealed {
                            self.living.show(Shown.Grew((bx, y, bz, g)), sounds.len())
                        }
                        self.living.show(Shown.Level((2011, bx, y, bz, 15)), sounds.len())
                        self.living.show(Shown.Grown((bx, y, bz, g)), sounds.len())
                        self.bee.crops_grown += 1
                    }
                }
            }
        }
    }

    // `BeeGoToHiveGoal.tick`: its hive given up on after 2400 ticks; else, its navigation done,
    // 16 blocks or more off a place on the way headed for, `pathfindRandomlyTowards`, or its hive
    // forgotten 48 or more off; nearer, a path to it, given up on where it doesn't reach it, and
    // where it's the same as the last for 60 ticks, its hive forgotten.
    fn to_hive_tick<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        let h = self.bee.hive else return
        self.bee.hive_travel += 1
        if self.bee.hive_travel > reduced_tick_delay(2400) {
            self.blacklist_hive()
            return
        }
        if not self.navigation.is_done() {
            return
        }
        if not self.bee_near(h, 16.0) {
            if not self.bee_near(h, 48.0) {
                self.drop_hive()
            } else {
                self.towards_randomly(h, lf, f, m, blocks, mut cache, min_y)
            }
            return
        }
        // `pathfindDirectlyTowards`: within 1 of it where it's within 3 blocks, else 2, its
        // searches visiting 10 times the nodes.
        let reach = if self.bee_near(h, 3.0) { 1 } else { 2 }
        self.navigation.set_multiplier(10.0f32)
        let (x, y, z) = h
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        let found = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, x, y, z, reach)
        _ = self.navigation.move_along(lf, f, nf, blocks, w, found, 1.0)
        let reaches = if let p = self.navigation.path { p.reached } else { false }
        if not reaches {
            self.blacklist_hive()
            return
        }
        var same = false
        if let last = self.bee.last_path {
            if let p = self.navigation.path {
                same = same_nodes(p, last)
            }
        }
        if same {
            self.bee.hive_stuck += 1
            if self.bee.hive_stuck > 60 {
                self.drop_hive()
                self.bee.hive_stuck = 0
            }
        } else {
            self.bee.last_path = self.navigation.path.copy()
        }
    }

    // `pathfindRandomlyTowards`: a place on the way to `target`, `AirRandomPos.getPosTowards`
    // within a tenth of a turn of it, 6 across and 8 up or down, or half its distance each where
    // that's under 15, 4 up or down from it where it's more than 2 above or below; headed for at 1,
    // its searches visiting half the nodes.
    fn towards_randomly<B: CollisionBlocks + MobLight + NavLevel>(mut self, target: (i32, i32, i32), lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        let (tx, ty, tz) = target
        let (bx, by, bz) = self.living.body.block()
        let dy = ty - by
        let fly = if dy > 2 { 4 } else if dy < -2 { -4 } else { 0 }
        var h = 6
        var v = 8
        let dist = (tx - bx).abs() + (ty - by).abs() + (tz - bz).abs()
        if dist < 15 {
            h = dist / 2
            v = dist / 2
        }
        let dir = (f64(tx) + 0.5 - self.living.body.x, f64(tz) + 0.5 - self.living.body.z)
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home }
        let costs = self.navigation.maluses.copy()
        let tries = air_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, h, v, fly, dir, f64(0.31415927f32), true)
        let (x, y, z) = best_for_bee(f, blocks, tries) else return
        self.navigation.set_multiplier(0.5f32)
        _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(x) + 0.5, f64(y), f64(z) + 0.5, 1.0)
    }

    // `BeeWanderGoal.start`: toward its hive where it's valid and further than 32 blocks, 24
    // where it knows neither hive nor flower, else the way it looks, `getViewVector(0)`, its
    // pitch and its head's way as its tick began; a place hovering over the ground, 8 across and 7
    // up or down within a right angle of it, 1 to 3 up, `HoverRandomPos`, else one in the air or
    // water, 8 across and 4 up or down, 2 down, `AirAndWaterRandomPos`; a path there followed at
    // 1.
    fn bee_wander<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        let reduction = if self.bee.hive == none and self.bee.flower == none { 16 } else { 24 }
        var dir = (0.0, 0.0)
        var homeward = false
        if let h = self.bee.hive {
            homeward = self.hive_valid(lf, f, blocks) and not self.bee_near(h, f64(48 - reduction))
            if homeward {
                let (hx, hy, hz) = h
                let vx = f64(hx) + 0.5 - self.living.body.x
                let vy = f64(hy) + 0.5 - self.living.body.y
                let vz = f64(hz) + 0.5 - self.living.body.z
                let d = (vx * vx + vy * vy + vz * vz).sqrt()
                dir = if d < f64(1.0e-5f32) { (0.0, 0.0) } else { (vx / d, vz / d) }
            }
        }
        if not homeward {
            let (lx, _, lz) = view_vector(self.living.body.x_rot, self.living.y_head_rot_o)
            dir = (lx, lz)
        }
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home }
        let costs = self.navigation.maluses.copy()
        let right = f64(1.5707964f32)
        let hover = hover_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 8, 7, dir, right, 3, 1, self.species == PARROT)
        var best = best_for_bee(f, blocks, hover)
        if best == none {
            let air = air_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 8, 4, -2, dir, right, false)
            best = best_for_bee(f, blocks, air)
        }
        let (x, y, z) = best else return
        let nf = nav_facts(lf, blocks, min_y)
        let moving = self.walker(lf)
        let found = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, moving, x, y, z, 1)
        _ = self.navigation.move_along(lf, f, nf, blocks, moving, found, 1.0)
    }

    // `BeePollinateGoal.tick`, every tick: its flower given up on after 600 ticks at it, no flower
    // looked for for 200; else, more than a block from 0.6 above its flower's middle, headed
    // there at 0.35; at it, where it's within 0.1 of where it hovers, one tick in 25, drawn, a new
    // place to hover drawn, a third of a block either way across, its path stopped, else staying
    // put, looking at the flower either way; then its ticks at its flower counted, and one in 20,
    // drawn, 60 since it last did, it buzzes, `entity.bee.pollinate`.
    fn pollinate_tick(mut self, sounds: mut List<EntitySound>) {
        let at = self.bee.flower else return
        self.bee.pollinating_ticks += 1
        if self.bee.pollinating_ticks > 600 {
            self.drop_flower()
            self.bee.pollinating = false
            self.bee.flower_cooldown = 200
            return
        }
        let (fx, fy, fz) = at
        let flower = (f64(fx) + 0.5, f64(fy) + f64(0.6f32), f64(fz) + 0.5)
        let here = (self.living.body.x, self.living.body.y, self.living.body.z)
        if spot_distance(flower, here) > 1.0 {
            self.bee.hover = some(flower)
            let (x, y, z) = flower
            self.moves.set_wanted(x, y, z, f64(0.35f32))
            return
        }
        let hover = self.bee.hover ?? flower
        self.bee.hover = some(hover)
        let arrived = spot_distance(here, hover) <= 0.1
        var wanted = true
        if arrived {
            if self.living.body.random.next_int_below(25) == 0 {
                let ox = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.33333334f32
                let oz = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.33333334f32
                let (x, y, z) = flower
                self.bee.hover = some((x + f64(ox), y, z + f64(oz)))
                self.navigation.stop()
            } else {
                wanted = false
            }
            let (x, y, z) = flower
            self.look.set_look_at(x, y, z, HEAD_ROT_SPEED, self.max_head_x_rot())
        }
        if wanted {
            let (x, y, z) = self.bee.hover ?? flower
            self.moves.set_wanted(x, y, z, f64(0.35f32))
        }
        self.bee.pollinated += 1
        if self.living.body.random.next_float() < 0.05f32 and self.bee.pollinated > self.bee.buzzed + 60 {
            self.bee.buzzed = self.bee.pollinated
            self.living.play(mut sounds, String("entity.bee.pollinate"), 1.0f32, 1.0f32)
        }
    }

    // `BeePollinateGoal.findNearbyFlower`: the first block within 5 each way, by distance across
    // the blocks, `findBlocksInBoxByManhattanDistance`, that draws bees and that it can reach a
    // block of, `createPath(pos, 1)`, unless it found it couldn't in the last 600 ticks; those
    // it found it couldn't kept for the next look, and only those.
    fn nearby_flower<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (i32, i32, i32)? {
        var kept = Map<i64, i64>()
        var found: (i32, i32, i32)? = none
        let (bx, by, bz) = self.living.body.block()
        let offsets = manhattan_box(5, 5, 5, 15)
        let nf = nav_facts(lf, blocks, min_y)
        var i = 0usize
        while i < offsets.len() {
            let (x, y, z) = (bx + offsets[i], by + offsets[i + 1], bz + offsets[i + 2])
            i += 3
            if not attracts_bees(lf, f, state_at(blocks, x, y, z)) {
                continue
            }
            let key = ((i64(x) & 0x3FFFFFF) << 38) | ((i64(z) & 0x3FFFFFF) << 12) | (i64(y) & 0xFFF)
            let until = if self.bee.unreachable.contains(key) { self.bee.unreachable[key] } else { i64.MIN }
            if self.game_time < until {
                kept.insert(key, until)
                continue
            }
            let w = self.walker(lf)
            let p = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, x, y, z, 1)
            if let path = p {
                if path.reached {
                    found = some((x, y, z))
                    break
                }
            }
            kept.insert(key, self.game_time + 600)
        }
        self.bee.unreachable = kept
        return found
    }

    // `BeeLocateHiveGoal.start`: no hive looked for for 200 ticks; the beehives and bee nests
    // within 20 of its block, `#bee_home`, any, as its level's points of interest find them, that
    // aren't full, nearest first, those as near in the order found; the first it hasn't given up
    // on its hive, else, where it's given up on them all, the nearest, its list forgotten.
    fn locate_hive<B: MobLight>(mut self, blocks: B, heard: usize) {
        self.bee.hive_cooldown = 200
        let pois = self.pois.take() else {
            self.living.show(Shown.Missing(String("A bee's look for a hive without its level's points of interest")), heard)
            return
        }
        let (bx, by, bz) = self.living.body.block()
        let at = BlockPos { x: bx, y: by, z: bz }
        var near = List<((i32, i32, i32), f64)>()
        for r in pois.in_range(types_of((1u32 << u32.wrap(POI_BEEHIVE)) | (1u32 << u32.wrap(POI_BEE_NEST))), at, 20, Occupancy.Any) {
            let held = blocks.hive_bees(r.pos.x, r.pos.y, r.pos.z) ?? 3
            if held == 3 {
                continue
            }
            // Sorted as `Comparator.comparingDouble` sorts, keeping those as near in order.
            let d = block_dist_sqr(r.pos, at)
            var k = near.len()
            while k > 0 and near[k - 1].1 > d {
                k -= 1
            }
            near.insert(k, ((r.pos.x, r.pos.y, r.pos.z), d))
        }
        self.pois = some(pois)
        if near.is_empty() {
            return
        }
        for (h, _) in near {
            var given_up = false
            for b in self.bee.blacklist {
                if b == h {
                    given_up = true
                }
            }
            if not given_up {
                self.bee.hive = some(h)
                return
            }
        }
        self.bee.blacklist.clear()
        self.bee.hive = some(near[0].0)
    }

    // `Bee.customServerAiStep` (CAL-177): its ticks under water counted, drowning past 20; stung,
    // its ticks since, and every 5th, its death one time in 1200 less them, drawn; without nectar,
    // its ticks so; then its anger kept, `updatePersistentAnger`, not kept up for a target it has.
    fn bee_ai<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, players: List<Follower>, sounds: mut List<EntitySound>) {
        let stung = self.bee_flag(BEE_STUNG)
        if self.living.body.in_water {
            self.bee.under_water += 1
        } else {
            self.bee.under_water = 0
        }
        if self.bee.under_water > 20 {
            self.hurt_self(lf, blocks, items, "drown", 1.0f32, mut sounds)
        }
        if stung {
            self.bee.since_sting += 1
            if self.bee.since_sting % 5 == 0 and self.living.body.random.next_int_below((1200 - self.bee.since_sting).max(1).min(1200)) == 0 {
                let all = self.living.health()
                self.hurt_self(lf, blocks, items, "generic", all, mut sounds)
            }
        }
        if not self.bee_flag(BEE_NECTAR) {
            self.bee.without_nectar += 1
        }
        self.update_anger(players, false)
    }

    // Its ambient and step sounds, `getSoundSet`'s for its sound variant, a baby's where it's one;
    // a monster's its kind's, a creeper's none and the block's steps; a slime's none and the
    // block's steps.
    fn refresh_sounds(mut self) {
        if self.species == ENDER_DRAGON {
            // `EnderDragon.getAmbientSound`; it never steps, as it never travels (D608).
            self.ambient = some(String("entity.ender_dragon.ambient"))
            self.living.own_step = none
            return
        }
        if cube_kind(self.species) {
            self.ambient = none
            self.living.own_step = none
            return
        }
        if self.species == IRON_GOLEM {
            // No ambient sound, `AbstractGolem.getAmbientSound`; its steps its own, as loud as 1
            // (CAL-201).
            self.ambient = none
            self.living.own_step = some(String("entity.iron_golem.step"))
            return
        }
        if self.species == DOLPHIN {
            // `Dolphin.getAmbientSound` out of water; in it, its water one, as its ambient sound's
            // played (CAL-201).
            self.ambient = some(String("entity.dolphin.ambient"))
            self.living.own_step = none
            return
        }
        if squid_kind(self.species) {
            // `Squid.getAmbientSound` and `GlowSquid`'s; it never steps, `MovementEmission.EVENTS`
            // (CAL-201).
            self.ambient = some(String(if self.species == GLOW_SQUID { "entity.glow_squid.ambient" } else { "entity.squid.ambient" }))
            self.living.own_step = none
            return
        }
        if self.species == BAT {
            // `Bat.getAmbientSound`, which `base_tick_end` holds back while it rests three times
            // in 4; it never steps, `MovementEmission.EVENTS` (CAL-201).
            self.ambient = some(String("entity.bat.ambient"))
            self.living.own_step = none
            return
        }
        if self.species == SNOW_GOLEM {
            // `SnowGolem.getAmbientSound`; its steps the block's (CAL-201).
            self.ambient = some(String("entity.snow_golem.ambient"))
            self.living.own_step = none
            return
        }
        if self.species == WITHER_BOSS {
            // `WitherBoss.getAmbientSound`; its steps its blocks' (CAL-401).
            self.ambient = some(String("entity.wither.ambient"))
            self.living.own_step = none
            return
        }
        if self.species == PHANTOM or self.species == GHAST or self.species == SHULKER {
            // `Phantom.getAmbientSound`, `Ghast.getAmbientSound` and `Shulker.getAmbientSound`;
            // their steps their blocks' (CAL-200).
            self.ambient = some(String(if self.species == GHAST { "entity.ghast.ambient" } else if self.species == SHULKER { "entity.shulker.ambient" } else { "entity.phantom.ambient" }))
            self.living.own_step = none
            return
        }
        if fish_kind(self.species) {
            // `Cod.getAmbientSound` (CAL-178), `Salmon`'s and `TropicalFish`'s; a pufferfish has
            // none (CAL-201).
            self.ambient = if self.species == PUFFERFISH { none } else { some(String(if self.species == SALMON { "entity.salmon.ambient" } else if self.species == TROPICAL_FISH { "entity.tropical_fish.ambient" } else { "entity.cod.ambient" })) }
            self.living.own_step = none
            return
        }
        if self.guardian_kind() {
            // `Guardian.getAmbientSound` in water, and an elder's; out of water, its land's, as its
            // ambient sound's played (CAL-200).
            self.ambient = some(String(if self.species == ELDER_GUARDIAN { "entity.elder_guardian.ambient" } else { "entity.guardian.ambient" }))
            self.living.own_step = none
            return
        }
        if self.monster {
            let (ambient, step) = if self.species == ZOMBIE { ("entity.zombie.ambient", "entity.zombie.step") } else if self.species == ZOMBIFIED_PIGLIN { ("entity.zombified_piglin.ambient", "entity.zombie.step") } else if self.species == HUSK { ("entity.husk.ambient", "entity.husk.step") } else if self.species == DROWNED { ("entity.drowned.ambient", "entity.drowned.step") } else if self.species == ZOMBIE_VILLAGER { ("entity.zombie_villager.ambient", "entity.zombie_villager.step") } else if self.species == SKELETON { ("entity.skeleton.ambient", "entity.skeleton.step") } else if self.species == STRAY { ("entity.stray.ambient", "entity.stray.step") } else if self.species == BOGGED { ("entity.bogged.ambient", "entity.bogged.step") } else if self.species == PARCHED { ("entity.parched.ambient", "entity.parched.step") } else if self.species == WITHER_SKELETON { ("entity.wither_skeleton.ambient", "entity.wither_skeleton.step") } else if self.species == ENDERMITE { ("entity.endermite.ambient", "entity.endermite.step") } else if self.species == SILVERFISH { ("entity.silverfish.ambient", "entity.silverfish.step") } else { ("entity.spider.ambient", "entity.spider.step") }
            if self.species == CREEPER {
                self.ambient = none
                self.living.own_step = none
            } else if self.species == VEX {
                // `Vex.getAmbientSound`; it never steps, moving with no physics (CAL-200).
                self.ambient = some(String("entity.vex.ambient"))
                self.living.own_step = none
            } else if self.species == RAVAGER {
                // Its own steps, `Ravager.playStepSound`, at 0.15 (CAL-200).
                self.ambient = some(String("entity.ravager.ambient"))
                self.living.own_step = some(String("entity.ravager.step"))
            } else if self.species == PIGLIN_BRUTE {
                // `PiglinBrute.getAmbientSound`, played only while idle; its steps its own, at 0.15,
                // `playStepSound` (CAL-200).
                self.ambient = some(String("entity.piglin_brute.ambient"))
                self.living.own_step = some(String("entity.piglin_brute.step"))
            } else if self.species == PIGLIN {
                // `Piglin.getAmbientSound`, its activity's as it's played, `piglin_sound`, only while
                // idle; its steps its own, at 0.15, `playStepSound` (CAL-200).
                self.ambient = some(String("entity.piglin.ambient"))
                self.living.own_step = some(String("entity.piglin.step"))
            } else if self.species == ZOGLIN {
                // `Zoglin.getAmbientSound` is angry with a target, as it's played; its steps its
                // own, at 0.15, `playStepSound` (CAL-200).
                self.ambient = none
                self.living.own_step = some(String("entity.zoglin.step"))
            } else if self.species == BLAZE {
                // `Blaze.getAmbientSound`; it steps as the block (CAL-200).
                self.ambient = some(String("entity.blaze.ambient"))
                self.living.own_step = none
            } else if self.species == ENDERMAN or self.species == WITCH or illager_kind(self.species) {
                // Not creepy, an enderman's ambient sound isn't its scream; each steps as the block.
                self.ambient = some(String(if self.species == ENDERMAN { "entity.enderman.ambient" } else if self.species == WITCH { "entity.witch.ambient" } else if self.species == VINDICATOR { "entity.vindicator.ambient" } else if self.species == EVOKER { "entity.evoker.ambient" } else { "entity.pillager.ambient" }))
                self.living.own_step = none
            } else {
                self.ambient = some(String(ambient))
                self.living.own_step = some(String(step))
            }
            return
        }
        if self.species == LLAMA {
            // `Llama`'s sounds: its ambient sound its own, its steps its own, 0.15 loud,
            // `playStepSound`; no breath, and no landing sound, `causeFallDamage` (CAL-201).
            self.ambient = some(String("entity.llama.ambient"))
            self.living.own_step = some(String("entity.llama.step"))
            self.living.own_step_volume = 0.15f32
            self.living.breath = none
            self.living.horse_land = none
            return
        }
        if self.equine() {
            let baby = self.baby()
            self.ambient = some(String(if self.species == DONKEY { "entity.donkey.ambient" } else if self.species == ZOMBIE_HORSE { "entity.zombie_horse.ambient" } else if self.species == SKELETON_HORSE { "entity.skeleton_horse.ambient" } else if baby { "entity.baby_horse.ambient" } else { "entity.horse.ambient" }))
            self.living.own_step = some(String(if baby { "entity.baby_horse.step" } else { "entity.horse.step" }))
            self.living.breath = if self.species == HORSE { some(String(if baby { "entity.baby_horse.breathe" } else { "entity.horse.breathe" })) } else { none }
            // Its landing, `AbstractHorse.causeFallDamage`'s (CAL-179).
            self.living.horse_land = some(String(if baby { "entity.baby_horse.land" } else { "entity.horse.land" }))
            return
        }
        if self.species == VILLAGER {
            // `Villager.getAmbientSound`: none while it sleeps, else a trade's while it trades;
            // the block's steps (CAL-160).
            self.ambient = if self.living.sleeping != none { none } else { some(String(if self.trading != none { "entity.villager.trade" } else { "entity.villager.ambient" })) }
            self.living.own_step = none
            return
        }
        if self.species == ARMADILLO {
            // `Armadillo.getAmbientSound`: none while it's scared (CAL-160).
            self.ambient = if self.scared() { none } else { some(String("entity.armadillo.ambient")) }
            self.living.own_step = some(String("entity.armadillo.step"))
            return
        }
        if self.species == BEE {
            // `Bee.getAmbientSound`: none, its buzz the client's own (CAL-177).
            self.ambient = none
            self.living.own_step = none
            return
        }
        if self.species == HOGLIN {
            // `Hoglin.getAmbientSound` is its activity's, as it's played, `hoglin_sound`; its
            // steps its own, at 0.15, `playStepSound` (CAL-200).
            self.ambient = none
            self.living.own_step = some(String("entity.hoglin.step"))
            return
        }
        if self.species == SHEEP {
            self.ambient = some(String("entity.sheep.ambient"))
            self.living.own_step = some(String("entity.sheep.step"))
            return
        }
        if self.species == FOX {
            // `Fox.getAmbientSound`'s ambient sound, its sleep and screech chosen as it's heard; its
            // steps its block's (CAL-201).
            self.ambient = some(String("entity.fox.ambient"))
            self.living.own_step = none
            return
        }
        if self.species == PANDA {
            // `Panda.getAmbientSound`, by its variant, an aggressive one's, a worried one's or its
            // own; its steps its own, as loud as 0.15, `playStepSound` (CAL-201). Its genes set,
            // it's asked again.
            let v = self.panda_variant()
            self.ambient = some(String(if v == GENE_AGGRESSIVE { "entity.panda.aggressive_ambient" } else if v == GENE_WORRIED { "entity.panda.worried_ambient" } else { "entity.panda.ambient" }))
            self.living.own_step = some(String("entity.panda.step"))
            return
        }
        if self.species == POLAR_BEAR {
            // `PolarBear.getAmbientSound`, a cub's its own; its steps its own, as loud as 0.15,
            // `playStepSound` (CAL-201).
            self.ambient = some(String(if self.baby() { "entity.polar_bear.ambient_baby" } else { "entity.polar_bear.ambient" }))
            self.living.own_step = some(String("entity.polar_bear.step"))
            return
        }
        if self.species == RABBIT {
            // `Rabbit.getAmbientSound`; its steps its block's (CAL-201).
            self.ambient = some(String("entity.rabbit.ambient"))
            self.living.own_step = none
            return
        }
        if self.species == PARROT {
            // `Parrot.getAmbientSound`, drawn from the level's random as it's heard,
            // `parrot_ambient`; its steps its own, as loud as 0.15, `playStepSound` (CAL-201).
            self.ambient = none
            self.living.own_step = some(String("entity.parrot.step"))
            return
        }
        if self.species == TURTLE {
            // `Turtle.getAmbientSound`, on land only, as it's heard, `base_tick_end`; its steps
            // its own, a baby's its own, as loud as 0.15, `playStepSound` (CAL-201).
            self.ambient = none
            self.living.own_step = some(String(if self.baby() { "entity.turtle.shamble_baby" } else { "entity.turtle.shamble" }))
            return
        }
        if self.species == OCELOT {
            // `Ocelot.getAmbientSound`; its steps its block's (CAL-201).
            self.ambient = some(String("entity.ocelot.ambient"))
            self.living.own_step = none
            return
        }
        var chosen: SoundSet? = none
        if let s = self.sounds {
            chosen = some(s.set_of(self.sound_variant, self.baby()))
        }
        if let set = chosen {
            self.ambient = some(set.ambient.copy())
            // A cat steps as its block does, its sound set naming no steps (CAL-201).
            self.living.own_step = if set.step.is_empty() { none } else { some(set.step.copy()) }
            return
        }
        self.ambient = some(String("entity.cow.ambient"))
        self.living.own_step = some(String("entity.cow.step"))
    }

    /// Whether it may go where the nearest player is `d` blocks squared away, `removeWhenFarAway`:
    /// an animal never does; a zombie villager only where it isn't being cured and has no
    /// experience; a witch only where it isn't patrolling, or past 128 blocks; and a zombie horse
    /// always; a fish only where it came from no bucket and has no name (CAL-178); and a hoglin
    /// always (CAL-200).
    pub fn removed_far_away(self, d: f64) -> bool {
        if self.species == ZOMBIE_HORSE or self.species == HOGLIN {
            return true
        }
        if fish_kind(self.species) {
            return not self.from_bucket() and not self.living.body.extras.contains("CustomName")
        }
        if self.species == ZOMBIE_VILLAGER {
            return not self.living.data.flag(MONSTER_OWN + 3) and self.villager_xp == 0
        }
        if raider_kind(self.species) {
            return not self.patrolling or d > 16384.0
        }
        if self.species == CAT {
            // `Cat.removeWhenFarAway`: a wild one past its 2400th tick (CAL-201).
            return not self.is_tame() and self.living.body.tick_count > 2400
        }
        if self.species == OCELOT {
            // `Ocelot.removeWhenFarAway`: one that doesn't trust past its 2400th tick (CAL-201).
            return not self.ocelot_trusting() and self.living.body.tick_count > 2400
        }
        if self.species == VILLAGER or self.species == SHULKER or self.species == IRON_GOLEM or self.species == SNOW_GOLEM {
            return false
        }
        return not self.animal
    }

    /// Whether it's a horse, `AbstractHorse`: a horse, a donkey, a llama, a zombie horse or a
    /// skeleton horse.
    pub fn equine(self) -> bool {
        return self.species == HORSE or self.species == DONKEY or self.species == ZOMBIE_HORSE or self.species == LLAMA or self.species == SKELETON_HORSE
    }

    /// Its ambient sound as it's heard now, `getAmbientSound`: a skeleton horse's its water one
    /// with its eyes in water, `isEyeInFluid` (CAL-349).
    fn ambient_now(self) -> String? {
        if self.species == SKELETON_HORSE and self.living.body.water_eyes {
            return some(String("entity.skeleton_horse.ambient_water"))
        }
        return self.ambient.copy()
    }

    /// `SkeletonTrapGoal.createSkeleton`'s, after its finalizing (CAL-349): a trap's skeleton hurt
    /// by nothing for 60 ticks, `setInvulnerableTime`, and kept; an iron helmet on where its head
    /// wears nothing; then what's in its main hand and on its head enchanted afresh, their
    /// enchantments taken off first, by `mob_spawn_equipment` from its own random at the special
    /// multiplier `special`, `enchantItemFromProvider`, the world's loot `loot`'s.
    pub fn trap_rider(mut self, special: f32, loot: Shared<Loot>?) {
        self.living.invulnerable_time = 60
        self.persistence_required = true
        if self.living.equipment[5] == none {
            self.living.equipment[5] = some(stack_of(String("minecraft:iron_helmet")))
        }
        for slot in [0usize, 5usize] {
            let held = self.living.equipment[slot].copy() else continue
            let bare = without_component(held, "minecraft:enchantments")
            if let l = loot {
                self.living.equipment[slot] = some(spawn_enchanted(l.value, mut self.living.body.random, bare, special))
            } else {
                self.living.equipment[slot] = some(bare)
            }
        }
    }

    /// `SkeletonTrapGoal.createHorse`'s, after its finalizing (CAL-349): a trap's other horse hurt
    /// by nothing for 60 ticks, kept, tamed and grown.
    pub fn trap_mount(mut self) {
        self.living.invulnerable_time = 60
        self.persistence_required = true
        self.set_horse_flag(2, true)
        self.set_age(0)
    }

    /// `setTrap`: a skeleton horse made a trap or not, its `SkeletonTrapGoal` added at 1 as it
    /// first is, which takes no controls (CAL-349). Calcite leaves the goal once it's not a trap,
    /// as it's used only by one, where vanilla takes it out.
    pub fn set_trap(mut self, trap: bool) {
        self.skeleton_trap = trap
        if trap and not self.trap_goal_added {
            self.trap_goal_added = true
            self.goals.add(1, 0u32, false, Goal.SkeletonTrap(0))
        }
    }

    /// `requiresCustomPersistence`: what rides anything stays, `Mob`'s `isPassenger` (D708), and an
    /// enderman carrying a block, and a fish from a bucket (CAL-178).
    pub fn custom_persistence(self) -> bool {
        // A sulfur cube holding a block too (CAL-402).
        return self.living.body.vehicle != none or self.leashed() or self.carried() != none or self.from_bucket() or (self.species == SULFUR_CUBE and self.has_body_item())
    }

    /// Whether it may be leashed, `canBeLeashed` (CAL-179): not an enemy, `Enemy`, nor a fish,
    /// `WaterAnimal`; a zombie horse only tamed or where no mob rides it first, `isMobControlled`.
    pub fn can_be_leashed(self) -> bool {
        if self.species == ZOMBIE_HORSE {
            return self.horse_flag(2) or not self.carries_mob
        }
        let s = self.species
        // A sulfur cube holding a block, `SulfurCube.canBeLeashed` (CAL-402).
        if s == SULFUR_CUBE {
            return self.has_body_item()
        }
        return s == MOOSHROOM or s == COW or s == PIG or s == CHICKEN or s == SHEEP or s == HORSE or s == DONKEY or s == ARMADILLO or s == BEE or (s == WOLF and not self.angry()) or s == CAT or s == OCELOT or s == RABBIT or s == POLAR_BEAR or s == FOX or s == LLAMA or s == PARROT or squid_kind(s) or s == DOLPHIN
    }

    /// Whether it's leashed, `isLeashed`: its holder found, not only saved (CAL-179).
    pub fn leashed(self) -> bool {
        if let l = self.leash {
            return l.holder != none
        }
        return false
    }

    /// What holds its leash, `getLeashHolder`, where it's found (CAL-179).
    pub fn leash_holder(self) -> Held? {
        if let l = self.leash {
            return l.holder
        }
        return none
    }

    /// `setLeashedTo` the holder `h` (CAL-179): its leash's turn kept where it had one, its link
    /// sent to those who see it after the sounds `heard`; what it rides it would leave,
    /// `stopRiding`, which is said to be missing.
    pub fn leash_to(mut self, h: Held, heard: usize) {
        let id = h.id
        if self.tie(h) {
            self.living.show(Shown.Missing(String("A mob leashed leaving what it rides")), heard)
        }
        self.living.show(Shown.Leashed(id), heard)
    }

    /// Its leash tied to `h`, as `leash_to` ties it, but for what's sent (CAL-179): whether it
    /// rides something it would leave.
    pub fn tie(mut self, h: Held) -> bool {
        var momentum = 0.0
        if let l = self.leash {
            momentum = l.momentum
        }
        let id = h.id
        self.leash = some(Leash { holder: some(h), momentum: momentum })
        self.living.body.leashed_to = some(id)
        return self.living.body.vehicle != none
    }

    /// `dropLeash` where `drops`, its lead dropped where it is, `spawnAtLocation`, else
    /// `removeLeash` (CAL-179): where it's leashed, its leash gone, `onLeashRemoved` its home with
    /// it, and its link's end sent to those who see it, after the sounds `heard`.
    pub fn unleash(mut self, drops: bool, heard: usize) {
        let knot = self.knot_holder()
        if not self.untie() {
            return
        }
        if drops {
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            self.living.show(Shown.Spilled(Spilled { x: x, y: y, z: z, stack: lead_stack() }), heard)
        }
        self.living.show(Shown.Leashed(0), heard)
        if knot != 0 {
            self.living.show(Shown.KnotLeft(knot), heard)
        }
    }

    /// The knot its leash ties it to, 0 for none (CAL-179).
    pub fn knot_holder(self) -> i32 {
        let h = self.leash_holder() else return 0
        return if h.knot != none { h.id } else { 0 }
    }

    /// Its leash let go, as `unleash` lets it go, but for what's dropped and sent (CAL-179):
    /// whether it was leashed.
    pub fn untie(mut self) -> bool {
        if not self.leashed() {
            return false
        }
        self.leash = none
        self.living.body.leashed_to = none
        self.home = none
        return true
    }

    /// Whether a leash may tie it to what's at `other`'s box, `canHaveALeashAttachedTo` (CAL-179):
    /// it may be leashed and that's within its leash's snap, from the middle of one box to the
    /// other's.
    pub fn may_tie_to(self, other: Aabb, other_id: i32) -> bool {
        if other_id == self.living.body.id {
            return false
        }
        return box_distance(other, self.living.body.bounding_box()) <= SNAP_DISTANCE and self.can_be_leashed()
    }

    // `Leashable.tickLeash`, at the end of `Entity.baseTick` (CAL-179): a leash saved found, its
    // holder as its level found it by UUID among its entities, or its lead dropped where it isn't
    // after 100 ticks; then, leashed, let go where it or its holder can't interact with its level,
    // `dropLeash` where its level's `entity_drops`, else `removeLeash`; and where its holder's in
    // its level, its home about its holder within 5, `whenLeashedTo`; past its snap, 12, the
    // leash breaks, heard at its holder, its lead dropped, and its goals that move turned off,
    // `leashTooFarBehaviour`; past its slack, 6 less both widths, its holder's pull, which settles
    // its fall to 1, `onElasticLeashPull`; else, not panicking, its goals that move turned on and
    // its navigation toward its holder, short of it by 2, `closeRangeLeashBehaviour`. Its leash's
    // turn then turns it, and slows by what's under it, `angularFriction`.
    fn leash_tick<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) {
        let (unheld, momentum, knot) = self.leash_state() else return
        let seen = self.holding.take()
        if unheld {
            if let found = seen {
                self.leash_to(found.held, sounds.len())
            } else if not knot and self.living.body.tick_count > 100 {
                let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                self.living.show(Shown.Spilled(Spilled { x: x, y: y, z: z, stack: lead_stack() }), sounds.len())
                self.leash = none
                return
            }
        }
        if not self.leashed() {
            return
        }
        let h = seen else return
        let alive = self.living.alive() and not self.living.body.removed
        if not alive or not h.interacts {
            let drops = self.entity_drops
            self.unleash(drops, sounds.len())
            return
        }
        if not h.here {
            return
        }
        let b = self.living.body.bounding_box()
        let distance = box_distance(b, h.bounds)
        self.home = some(((i32.saturate(h.x.floor()), i32.saturate(h.y.floor()), i32.saturate(h.z.floor())), i32.saturate(ELASTIC_DISTANCE.floor()) - 1))
        let width = self.living.body.width
        if distance > SNAP_DISTANCE {
            sounds.push(EntitySound { sound: String("item.lead.break"), x: h.x, y: h.y, z: h.z, volume: 1.0f32, pitch: 1.0f32, source: NEUTRAL_SOURCE })
            self.unleash(true, sounds.len())
            self.goals.set_control(FLAG_MOVE, false)
        } else if distance > ELASTIC_DISTANCE - f64(h.width) - f64(width) and self.elastic_pull(h) {
            // `Entity.checkFallDistanceAccumulation`.
            if self.living.body.vy > -0.5 and self.living.body.fall > 1.0 {
                self.living.body.fall = 1.0
            }
        } else if not self.panicking() {
            self.goals.set_control(FLAG_MOVE, true)
            let (hx, hy, hz) = (h.x - self.living.body.x, h.y - self.living.body.y, h.z - self.living.body.z)
            // `distanceTo`, in floats, less the 2 it would stay off.
            let dx = f32.nearest(self.living.body.x - h.x)
            let dy = f32.nearest(self.living.body.y - h.y)
            let dz = f32.nearest(self.living.body.z - h.z)
            let apart = f32.nearest(f64(dx * dx + dy * dy + dz * dz).sqrt())
            let off = if apart - 2.0f32 > 0.0f32 { apart - 2.0f32 } else { 0.0f32 }
            let (nx, ny, nz) = normalized_of(hx, hy, hz)
            let k = f64(off)
            let (tx, ty, tz) = (self.living.body.x + nx * k, self.living.body.y + ny * k, self.living.body.z + nz * k)
            // A llama's at 2, `followLeashSpeed` (CAL-201).
            let pace = if self.species == LLAMA { 2.0 } else { 1.0 }
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, tx, ty, tz, pace)
        }
        // The leash it had turns it, though it may have broken.
        var turn = momentum
        if let now = self.leash {
            turn = now.momentum
        }
        self.living.body.y_rot = f32.nearest(f64(self.living.body.y_rot) - turn)
        let friction = if self.living.body.on_ground {
            let (px, py, pz) = self.living.body.on_pos(f, t, blocks, 0.500001f32)
            m.friction(f.block(blocks.collision_state(px, py, pz) ?? 0)) * 0.91f32
        } else if self.living.body.in_water or self.living.body.in_lava() {
            0.8f32
        } else {
            0.91f32
        }
        if let was = self.leash.take() {
            var now = was
            now.momentum = now.momentum * f64(friction)
            self.leash = some(now)
        }
    }

    // Where it has a leash, whether its holder's still to be found, its turn, and whether it was
    // saved tied to a knot, by its place (CAL-179).
    fn leash_state(self) -> (bool, f64, bool)? {
        let l = self.leash else return none
        let knot = match l.saved {
            some(Tag.Compound(_)) => false,
            some(_) => true,
            none => false,
        }
        return some((l.holder == none, l.momentum, knot))
    }

    // `checkElasticInteractions` with one point on each (CAL-179): its holder's pull, where it's
    // past its slack, `leash_pull`, turning it by ten times its torque, and moving it by the pull, 0.8
    // across and 0.2 up, and 0.11 of how much faster its holder moves than it, its known
    // movement, `getKnownMovement`. Whether it pulled.
    fn elastic_pull(mut self, h: Holding) -> bool {
        let (vx, vy, vz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
        let moving = if self.no_ai() { (0.0, 0.0, 0.0) } else { (vx, vy, vz) }
        let p = leash_pull(self.living.body.x, self.living.body.y, self.living.body.z, self.living.body.width, self.living.body.height, self.living.body.y_rot, moving, h, ELASTIC_DISTANCE) else return false
        if let was = self.leash.take() {
            var l = was
            l.momentum = l.momentum + 10.0 * p.torque
            self.leash = some(l)
        }
        let (hx, hy, hz) = h.moving
        self.living.body.vx = vx + (p.x * 0.8 + (hx - vx) * 0.11)
        self.living.body.vy = vy + (p.y * 0.2 + (hy - vy) * 0.11)
        self.living.body.vz = vz + (p.z * 0.8 + (hz - vz) * 0.11)
        return true
    }

    /// Whether it's a fish that came from a bucket, `fromBucket` (CAL-178).
    pub fn from_bucket(self) -> bool {
        // A sulfur cube's own, its third value (CAL-402).
        if self.species == SULFUR_CUBE {
            return self.living.data.flag(OWN + 2)
        }
        return fish_kind(self.species) and self.living.data.flag(FROM_BUCKET)
    }

    /// The block an enderman carries, `getCarriedBlock`, by its state, or none (CAL-159).
    pub fn carried(self) -> u32? {
        if self.species != ENDERMAN {
            return none
        }
        let n = self.living.data.number(MONSTER_OWN)
        return if n == 0 { none } else { some(u32.wrap(n)) }
    }

    /// An enderman's legacy anger, `AngerTime` saved where its end isn't, read as it's loaded at
    /// the game time `now`: its anger ends at `now` plus it, `setTimeToRemainAngry` (CAL-159).
    pub fn anger_from(mut self, now: i64) {
        if let t = self.legacy_anger {
            if self.species == BEE {
                // A bee's sent, `DATA_ANGER_END_TIME` (CAL-177).
                self.living.data.set(OWN + 1, Value.Long(now + i64(t)))
            } else if self.species == WOLF {
                // A wolf's sent, `DATA_ANGER_END_TIME` (CAL-201).
                self.living.data.set(OWN + 4, Value.Long(now + i64(t)))
            } else {
                self.anger_end_time = now + i64(t)
            }
            self.legacy_anger = none
        }
    }

    /// An enderman's carried block set to `state`, `setCarriedBlock`, shown to those who see it,
    /// and kept as it's saved, `tag`, its `carriedBlockState`, none for none (CAL-159).
    pub fn set_carried(mut self, state: u32?, tag: Tag?) {
        match state {
            some(s) => self.living.data.set(MONSTER_OWN, Value.Number(i32.wrap(s))),
            none => self.living.data.set(MONSTER_OWN, Value.Empty),
        }
        _ = self.kept.remove(String("carriedBlockState"))
        if let t = tag {
            self.kept.insert(String("carriedBlockState"), t.copy())
        }
    }

    /// `isPushable` (CAL-156), its chunk ticking its entities as `ticking` says: a horse, donkey or
    /// zombie horse unless something rides it, `AbstractHorse`'s (D710); another in a chunk that
    /// ticks, alive and not on what's climbable, `onClimbable`, a spider where it's climbing,
    /// `Spider`'s.
    pub fn pushable<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, ticking: bool) -> bool {
        if self.species == BAT {
            // Never a bat, `Bat.isPushable` (CAL-201).
            return false
        }
        if self.equine() {
            return self.living.body.passengers.is_empty()
        }
        if not ticking or not self.living.alive() {
            return false
        }
        if self.spider_kind() {
            return i32(self.living.data.byte(MONSTER_OWN)) & 1 == 0
        }
        return not self.living.on_climbable(lf, f, blocks)
    }

    /// `checkDespawn` in a chunk that ticks entities, in peaceful where `peaceful`, with the
    /// nearest player that isn't a spectator `nearest` blocks squared away, if there's one:
    /// whether it goes, `discard`. Its chance after 600 ticks doing nothing is drawn from its own
    /// random only where it needn't stay.
    pub fn check_despawn(mut self, peaceful: bool, nearest: f64?) -> bool {
        if self.species == WITHER_BOSS {
            // `WitherBoss.checkDespawn` (CAL-401): gone in peaceful, else never, its idle time
            // none.
            if peaceful {
                return true
            }
            self.no_action_time = 0
            return false
        }
        if self.species == ENDER_DRAGON {
            // `EnderDragon.checkDespawn`, which does nothing (D608).
            return false
        }
        if peaceful and not self.peaceful_ok {
            return true
        }
        let d = nearest else return false
        let stays = self.persistence_required or self.custom_persistence()
        let far = despawn_distance(self.category)
        if not stays and d > f64(far * far) and self.removed_far_away(d) {
            return true
        }
        let near = f64(NO_DESPAWN_DISTANCE * NO_DESPAWN_DISTANCE)
        if not stays and self.no_action_time > 600 and self.living.body.random.next_int_below(800) == 0 and d > near and self.removed_far_away(d) {
            return true
        }
        if d < near {
            self.no_action_time = 0
        }
        return false
    }

    /// Whether it's a baby, `isBaby`: an ageable one whose age is below 0, or a zombie or zombie
    /// villager whose values say so.
    pub fn baby(self) -> bool {
        if self.zombie_class() or self.species == ZOGLIN {
            return self.living.data.flag(BABY)
        }
        if self.species == PIGLIN {
            // `Piglin.isBaby`, `DATA_BABY_ID`, after `AbstractPiglin`'s value (CAL-200).
            return self.living.data.flag(MONSTER_OWN + 1)
        }
        return self.ageable and self.age < 0
    }

    /// `getScale` (CAL-359): its `scale` attribute's value as a float; an ender dragon's always 1,
    /// as its `sanitizeScale` has it. A shulker's shape doesn't take it yet.
    pub fn scale(self) -> f32 {
        if self.species == ENDER_DRAGON or self.species == SHULKER {
            return 1.0f32
        }
        return f32.nearest(self.living.attributes.value(attribute("scale")))
    }

    // `refreshDimensions`: its size a sleeper's, 0.2 by 0.2, its eyes 0.2 up, `SLEEPING_DIMENSIONS`
    // (CAL-160), or a baby's or grown, as it is, each by its scale, `EntityDimensions.scale`
    // (CAL-359).
    fn refresh_size(mut self) {
        if self.living.sleeping != none {
            self.living.body.width = 0.2f32
            self.living.body.height = 0.2f32
            self.living.body.eyes = 0.2f32
            return
        }
        let baby = self.baby()
        let s = self.scale()
        self.living.body.width = (if baby { self.baby_width } else { self.width }) * s
        self.living.body.height = (if baby { self.baby_height } else { self.height }) * s
        self.living.body.eyes = (if baby { self.baby_eyes } else { self.eyes }) * s
    }

    /// `refreshDimensions` as its scale changes, `onAttributeUpdated` of `SCALE` (CAL-359): its
    /// size made again, then, past its first tick, with physics, no more than 4 each way and
    /// grown, moved where its new box has room, `fudgePositionAfterSizeChange`.
    pub fn rescaled<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B) {
        let (old_w, old_h) = (self.living.body.width, self.living.body.height)
        self.refresh_size()
        let (w, h) = (self.living.body.width, self.living.body.height)
        if self.living.body.first_tick or self.living.body.no_physics or w > 4.0f32 or h > 4.0f32 or not (w > old_w or h > old_h) {
            return
        }
        let border = self.border ?? widest_border()
        _ = self.fudge_from(f, m, blocks, border, old_w, old_h)
    }

    /// `Zombie.setBaby`: a baby or not in its values, its speed's `minecraft:baby` modifier, half
    /// again on its base, on a baby only, and its size made again where that changed it, as
    /// `onSyncedDataUpdated` makes it again only for a value that changed (CAL-359).
    pub fn set_zombie_baby(mut self, on: bool) {
        let was = self.living.data.flag(BABY)
        self.living.data.set(BABY, Value.Bool(on))
        let speed = attribute("movement_speed")
        if on {
            self.living.attributes.replace(speed, Modifier { id: Identifier { namespace: "minecraft", path: "baby" }, amount: 0.5, operation: ADD_MULTIPLIED_BASE })
        } else {
            self.living.attributes.take_off(speed, Identifier { namespace: "minecraft", path: "baby" })
        }
        if was != on {
            self.refresh_size()
        }
    }

    /// `Zoglin.setBaby`: a baby or not in its values, and a baby's attack damage's base 0.5, a grown
    /// one's left as it is; its size made again where that changed it (CAL-200, CAL-359).
    pub fn set_zoglin_baby(mut self, on: bool) {
        let was = self.living.data.flag(BABY)
        self.living.data.set(BABY, Value.Bool(on))
        if on {
            self.living.attributes.set_base(attribute("attack_damage"), 0.5)
        }
        if was != on {
            self.refresh_size()
        }
    }

    /// `AgeableMob.setAge`: its age, and whether it's a baby where that crosses 0, its size made
    /// again, `refreshDimensions`, as `onSyncedDataUpdated` makes it, and its sounds.
    pub fn set_age(mut self, age: i32) {
        let old = self.age
        self.age = age
        if (old < 0 and age >= 0) or (old >= 0 and age < 0) {
            self.living.data.set(BABY, Value.Bool(age < 0))
            self.refresh_size()
            self.refresh_sounds()
            if self.species == VILLAGER {
                // `Villager.ageBoundaryReached`: its brain made again (CAL-160).
                self.refresh_brain()
            }
            if self.species == HOGLIN {
                // `Hoglin.ageBoundaryReached`: its attack damage's base 0.5 a baby, else 6; its
                // reward's `experience_reward`'s (CAL-200).
                self.living.attributes.set_base(attribute("attack_damage"), if age < 0 { 0.5 } else { 6.0 })
            }
            if self.species == TURTLE and age >= 0 {
                // `Turtle.ageBoundaryReached`: grown, its scute given, `turtle_grown` (CAL-201).
                self.turtle.grew = true
            }
        }
    }

    /// A phantom's size, `getPhantomSize`, at `MONSTER_OWN` (CAL-200).
    pub fn phantom_size(self) -> i32 {
        return self.living.data.number(MONSTER_OWN)
    }

    /// How many chunks off its tracker sees players, its type's `clientTrackingRange`: a monster's,
    /// a phantom's, a bee's and a hoglin's 8, a cod's 4, else 10 (CAL-200).
    pub fn tracking_range(self) -> i32 {
        if self.species == BAT or self.species == DOLPHIN {
            // A bat's 5, and a dolphin's, the default (CAL-201).
            return 5
        }
        if self.species == MAGMA_CUBE {
            // A magma cube's 8 (CAL-200).
            return 8
        }
        if self.species == ELDER_GUARDIAN or self.species == RAVAGER {
            // An elder guardian's and a ravager's 10 (CAL-200).
            return 10
        }
        if self.monster or self.species == PHANTOM or self.species == BEE or self.species == HOGLIN {
            return 8
        }
        if self.species == SQUID {
            // A squid's 8; a glow squid's 10 (CAL-201).
            return 8
        }
        return if fish_kind(self.species) { 4 } else { 10 }
    }

    /// The size what rides it or what it rides scales by, a slime's or a phantom's, else 0.
    pub fn ride_size(self) -> i32 {
        if cube_kind(self.species) {
            return self.slime_size()
        }
        if self.species == PHANTOM {
            return self.phantom_size()
        }
        return 0
    }

    /// `Phantom.setPhantomSize` (CAL-200): its size, from 0 to 64, in its values; where that
    /// changes it, `onSyncedDataUpdated`'s `updatePhantomSizeInfo`: its type's dimensions
    /// scaled by 1 and 0.15 of its size, `refreshDimensions`, and its attack 6 and
    /// its size. Set to what it was, as `finalizeSpawn` sets 0, nothing changes, so a phantom
    /// never sized keeps its type's attack, 2.
    pub fn set_phantom_size(mut self, size: i32) {
        let actual = if size < 0 { 0 } else if size > 64 { 64 } else { size }
        if actual == self.phantom_size() {
            return
        }
        self.living.data.set(MONSTER_OWN, Value.Number(actual))
        let scale = phantom_scale(actual)
        self.width = 0.9f32 * scale
        self.height = 0.5f32 * scale
        self.eyes = 0.175f32 * scale
        self.baby_width = self.width
        self.baby_height = self.height
        self.baby_eyes = self.eyes
        self.refresh_size()
        self.set_base("minecraft:attack_damage", f64(6 + actual))
    }

    /// A slime's size, `getSize`.
    pub fn slime_size(self) -> i32 {
        return self.living.data.number(OWN)
    }

    /// `AbstractCubeMob.setSize`, with `Slime`'s: its size, from 1 to 127, in its values, and where
    /// that changes it, turned as its head is, `onSyncedDataUpdated`; 0.52 across and high by its
    /// size and its eyes 0.325, `refreshDimensions`, where it stands; its most health its size
    /// squared, its speed 0.2 and a tenth of its size, its attack its size; its sounds 0.4 as loud
    /// by its size; and its health its most where `heal`. Where its size changes while it's in
    /// water, `isInWater`, as `data` may change it, it splashes 1 in 20 by its own random, its
    /// new width's, `doWaterSplashEffect`, kept in `splashed` (CAL-165).
    /// A salmon's size, `Salmon.getVariant`, its ID clamped, `ByIdMap.OutOfBoundsStrategy.CLAMP`:
    /// 0 small, 1 medium, 2 large (CAL-201).
    pub fn salmon_size(self) -> i32 {
        let n = self.living.data.number(SALMON_TYPE)
        return if n < 0 { 0 } else if n > 2 { 2 } else { n }
    }

    /// `Salmon.setVariant` (CAL-201): its size in its values, and so its dimensions, a medium
    /// one's scaled by a half, 1 or 1.5, `getSalmonScale`, `refreshDimensions`.
    pub fn set_salmon_size(mut self, size: i32) {
        self.living.data.set(SALMON_TYPE, Value.Number(size))
        let scale = if self.salmon_size() == 0 { 0.5f32 } else if self.salmon_size() == 2 { 1.5f32 } else { 1.0f32 }
        self.width = 0.7f32 * scale
        self.height = 0.4f32 * scale
        self.eyes = 0.26f32 * scale
        self.baby_width = self.width
        self.baby_height = self.height
        self.baby_eyes = self.eyes
        self.refresh_size()
    }

    // A squid's tentacles' speed, drawn, `1 / (nextFloat() + 1) * 0.2` (CAL-201).
    fn squid_tentacle_speed(mut self) -> f32 {
        return 1.0f32 / (self.living.body.random.next_float() + 1.0f32) * 0.2f32
    }

    // Whether a squid swims by a motion, `hasMovementVector` (CAL-201).
    fn squid_moving(self) -> bool {
        let (x, y, z) = self.squid.movement
        return x * x + y * y + z * z > f64(1.0e-5f32)
    }

    // `SquidRandomMovementGoal` (CAL-201): always used; ticked, past 100 ticks idle,
    // `getNoActionTime`, it swims by no motion; else, 1 in 25 drawn, or out of the water,
    // `wasTouchingWater`, or with no motion, a new one: 0.2 across a way drawn, and up from -0.1 to
    // 0.1, drawn.
    fn squid_move_goal(mut self, call: i32) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            return true
        }
        if call != GOAL_TICK {
            return false
        }
        if self.no_action_time > 100 {
            self.squid.movement = (0.0, 0.0, 0.0)
            return false
        }
        let roll = self.living.body.random.next_int_below(reduced_tick_delay(50))
        if roll == 0 or not self.living.body.in_water or not self.squid_moving() {
            let angle = self.living.body.random.next_float() * 6.2831855f32
            let across = table_cos(f64(angle)) * 0.2f32
            let up = -0.1f32 + self.living.body.random.next_float() * 0.2f32
            let along = table_sin(f64(angle)) * 0.2f32
            self.squid.movement = (f64(across), f64(up), f64(along))
        }
        return false
    }

    // Where the living entity that last hurt it is, `getLastHurtByMob`, a player or a mob, as it
    // sees it this tick, where it knows it (CAL-201).
    fn hurt_by_at(self, players: List<Follower>) -> (f64, f64, f64)? {
        let who = self.living.hurt_by_mob else return none
        for p in self.prey {
            if p.uuid == some(who) {
                return some((p.x, p.y, p.z))
            }
        }
        for p in players {
            if p.uuid == some(who) {
                return some((p.x, p.y, p.z))
            }
        }
        return none
    }

    // `SquidFleeGoal` (CAL-201): used in water while what last hurt it is less than 10 off; as it
    // starts, its count none; ticked, counted, it swims away from it, where the block that far on
    // the other side is water or air: the way from it, not made a unit long, as vanilla's
    // `normalize` is thrown away, at 3, less a fifth of what it's past 5 off, where that's more than
    // 0, level where the block's air, a twentieth of it a tick.
    fn squid_flee_goal<B: CollisionBlocks>(mut self, ticks: mut i32, call: i32, f: Facts, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let at = self.hurt_by_at(players) else return false
            let (ax, ay, az) = at
            return self.living.body.in_water and self.distance_sqr_to(ax, ay, az) < 100.0
        }
        if call == GOAL_START {
            ticks = 0
            return false
        }
        if call != GOAL_TICK {
            return false
        }
        ticks += 1
        let at = self.hurt_by_at(players) else return false
        let (ax, ay, az) = at
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        var fx = x - ax
        var fy = y - ay
        var fz = z - az
        let state = state_at(blocks, floor_of(x + fx), floor_of(y + fy), floor_of(z + fz))
        let air = f.is_air(state)
        if f.is_water(state) or air {
            let length = (fx * fx + fy * fy + fz * fz).sqrt()
            if length > 0.0 {
                var speed = 3.0
                if length > 5.0 {
                    speed -= (length - 5.0) / 5.0
                }
                if speed > 0.0 {
                    fx = fx * speed
                    fy = fy * speed
                    fz = fz * speed
                }
            }
            if air {
                fy = fy - fy
            }
            self.squid.movement = (fx / 20.0, fy / 20.0, fz / 20.0)
        }
        return false
    }

    // `Squid.aiStep`'s, after the rest (CAL-201): its pitch kept as it was; its tentacles on by
    // their speed, and past a whole turn round again, a new speed 1 in 10, drawn, with entity
    // event 19. In water: through the first half of their stroke, past three quarters of it, its
    // motion its own, `movementVector`, turning at full speed, else turning slower, 0.8 of it;
    // through the second half, its motion and its turning slowed, 0.9 and 0.99 of them; then its
    // body turned a tenth of the way toward the way it moves, its yaw that, `setYRot`, its roll on
    // by its turning, and its pitch a tenth of the way toward its motion's. Out of water, it falls
    // by its gravity, or rises by levitation, slowed by the air, `getAirDrag`, with no motion
    // across, its pitch a fiftieth of the way toward -90. A glow squid's dark ticks count down,
    // then its glow's place drawn, `getRandomX`, `getRandomY` and `getRandomZ`, which only
    // clients show.
    fn squid_step(mut self, heard: usize) {
        self.squid.x_rot_o = self.squid.x_rot
        self.squid.tentacles = self.squid.tentacles + self.squid.tentacle_speed
        if f64(self.squid.tentacles) > 6.283185307179586 {
            self.squid.tentacles = self.squid.tentacles - 6.2831855f32
            if self.living.body.random.next_int_below(10) == 0 {
                self.squid.tentacle_speed = self.squid_tentacle_speed()
            }
            self.living.show(Shown.Event(19i8), heard)
        }
        if self.living.body.in_water {
            if self.squid.tentacles < 3.1415927f32 {
                let stroke = self.squid.tentacles / 3.1415927f32
                if f64(stroke) > 0.75 {
                    let (mx, my, mz) = self.squid.movement
                    self.living.body.vx = mx
                    self.living.body.vy = my
                    self.living.body.vz = mz
                    self.squid.rotate_speed = 1.0f32
                } else {
                    self.squid.rotate_speed = self.squid.rotate_speed * 0.8f32
                }
            } else {
                self.living.body.vx = self.living.body.vx * 0.9
                self.living.body.vy = self.living.body.vy * 0.9
                self.living.body.vz = self.living.body.vz * 0.9
                self.squid.rotate_speed = self.squid.rotate_speed * 0.99f32
            }
            let (vx, vy, vz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
            let across = (vx * vx + vz * vz).sqrt()
            let rad = f32.nearest(RAD_TO_DEG)
            let yaw = -f32.nearest(table_atan2(vx, vz) ?? 0.0) * rad
            self.living.y_body_rot = self.living.y_body_rot + (yaw - self.living.y_body_rot) * 0.1f32
            self.living.body.y_rot = self.living.y_body_rot
            self.squid.z_rot = self.squid.z_rot + 3.1415927f32 * self.squid.rotate_speed * 1.5f32
            let pitch = -f32.nearest(table_atan2(across, vy) ?? 0.0) * rad
            self.squid.x_rot = self.squid.x_rot + (pitch - self.squid.x_rot) * 0.1f32
        } else {
            var yd = self.living.body.vy
            let lev = self.living.effect_amplifier(LEVITATION)
            if lev >= 0 {
                yd = 0.05 * f64(lev + 1)
            } else {
                yd -= self.living.body.gravity_now()
            }
            self.living.body.vx = 0.0
            self.living.body.vy = yd * f64(0.98f32)
            self.living.body.vz = 0.0
            self.squid.x_rot = self.squid.x_rot + (-90.0f32 - self.squid.x_rot) * 0.02f32
        }
        if self.species == GLOW_SQUID {
            let dark = self.living.data.number(GLOW_DARK)
            if dark > 0 {
                self.living.data.set(GLOW_DARK, Value.Number(dark - 1))
            }
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
        }
    }

    // A squid's way `v` turned by its pitch and then its body's yaw as its last tick began,
    // `rotateVector` (CAL-201).
    fn squid_turned(self, v: (f64, f64, f64)) -> (f64, f64, f64) {
        let (x, y, z) = v
        let pitch = self.squid.x_rot_o * 0.017453292f32
        let (pc, ps) = (f64(table_cos(f64(pitch))), f64(table_sin(f64(pitch))))
        let (x1, y1, z1) = (x, y * pc + z * ps, z * pc - y * ps)
        let yaw = -self.living.y_body_rot_o * 0.017453292f32
        let (yc, ys) = (f64(table_cos(f64(yaw))), f64(table_sin(f64(yaw))))
        return (x1 * yc + z1 * ys, y1, z1 * yc - x1 * ys)
    }

    // `Squid.spawnInk` (CAL-201): its squirt heard, its volume and its pitch drawn, `makeSound`;
    // then from a block below it, turned as it is, `rotateVector`, half a block up, 30 of its ink,
    // a glow squid's glowing, each sent alone along a way drawn, a block down and up to 0.3 across
    // each way, turned as it is, a tenth of a block on, 0.3 for one grown, and up to 2 more, drawn,
    // at 0.1.
    fn squid_ink(mut self, sounds: mut List<EntitySound>) {
        let pitch = self.voice_pitch()
        self.living.play(mut sounds, String(if self.species == GLOW_SQUID { "entity.glow_squid.squirt" } else { "entity.squid.squirt" }), self.sound_volume, pitch)
        let (bx, by, bz) = self.squid_turned((0.0, -1.0, 0.0))
        let (px, py, pz) = (bx + self.living.body.x, by + self.living.body.y, bz + self.living.body.z)
        let particle = if self.species == GLOW_SQUID { "minecraft:glow_squid_ink" } else { "minecraft:squid_ink" }
        let heard = sounds.len()
        for _ in 0..30 {
            let a = f64(self.living.body.random.next_float()) * 0.6 - 0.3
            let c = f64(self.living.body.random.next_float()) * 0.6 - 0.3
            let (dx, dy, dz) = self.squid_turned((a, -1.0, c))
            let on = (if self.baby() { 0.1f32 } else { 0.3f32 }) + self.living.body.random.next_float() * 2.0f32
            let s = f64(on)
            self.living.show(Shown.Spread(Spread { particle: String(particle), x: px, y: py + 0.5, z: pz, count: 0, dx: dx * s, dy: dy * s, dz: dz * s, speed: f64(0.1f32) }), heard)
        }
    }

    /// A pufferfish's puff, `getPuffState` (CAL-201).
    pub fn puff_state(self) -> i32 {
        return self.living.data.number(PUFF_STATE)
    }

    /// `Pufferfish.setPuffState` (CAL-201): its puff in its values, and so its dimensions, 0.7 by
    /// 0.7, its eyes 0.455, scaled by a half at 0, 0.7 at 1 and 1 at any other, `getScale`,
    /// `refreshDimensions`; grown where it's ticked before, it's moved where its new box has room,
    /// `fudgePositionAfterSizeChange`.
    pub fn set_puff_state<B: CollisionBlocks>(mut self, state: i32, f: Facts, m: MovementStates, blocks: B) {
        let (old_w, old_h) = (self.living.body.width, self.living.body.height)
        self.set_puff_size(state)
        let (w, h) = (self.living.body.width, self.living.body.height)
        if self.living.body.first_tick or self.living.body.no_physics or not (w > old_w or h > old_h) {
            return
        }
        _ = self.living.fudge_from(f, m, blocks, self.border ?? widest_border(), old_w, old_h)
    }

    /// `fudgePositionAfterSizeChange` from `old_w` by `old_h` (CAL-214): moved where its box, its
    /// size now, has room about its old middle, `findFreePosition` among `blocks` within `border`,
    /// as `set_puff_state` moves a pufferfish; else, grown both ways, where it has room as wide
    /// but as tall as it was. Whether it found room.
    pub fn fudge_from<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, border: (f64, f64, f64, f64), old_w: f32, old_h: f32) -> bool {
        return self.living.fudge_from(f, m, blocks, border, old_w, old_h)
    }

    // A pufferfish's puff in its values and its dimensions by it, as `set_puff_state` sets them,
    // without moving it, as it's made or loaded (CAL-201).
    fn set_puff_size(mut self, state: i32) {
        self.living.data.set(PUFF_STATE, Value.Number(state))
        let scale = if state == 0 { 0.5f32 } else if state == 1 { 0.7f32 } else { 1.0f32 }
        self.width = 0.7f32 * scale
        self.height = 0.7f32 * scale
        self.eyes = 0.455f32 * scale
        self.baby_width = self.width
        self.baby_height = self.height
        self.baby_eyes = self.eyes
        self.refresh_size()
    }

    // `Pufferfish.tick`'s, before the rest, alive and with its AI (CAL-201): puffing up, at its
    // first tick of it to mid, and past 40 to full, each heard, `entity.puffer_fish.blow_up`, its
    // volume and its pitch drawn, `makeSound`, counting on; else, puffed, past 60 down from full to
    // mid, and past 100 to small, each heard, `entity.puffer_fish.blow_out`, counting on.
    fn puff_tick<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, sounds: mut List<EntitySound>) {
        let state = self.puff_state()
        if self.inflate > 0 {
            if state == 0 {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, String("entity.puffer_fish.blow_up"), self.sound_volume, pitch)
                self.set_puff_state(1, f, m, blocks)
            } else if self.inflate > 40 and state == 1 {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, String("entity.puffer_fish.blow_up"), self.sound_volume, pitch)
                self.set_puff_state(2, f, m, blocks)
            }
            self.inflate += 1
        } else if state != 0 {
            if self.deflate > 60 and state == 2 {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, String("entity.puffer_fish.blow_out"), self.sound_volume, pitch)
                self.set_puff_state(1, f, m, blocks)
            } else if self.deflate > 100 and state == 1 {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, String("entity.puffer_fish.blow_out"), self.sound_volume, pitch)
                self.set_puff_state(0, f, m, blocks)
            }
            self.deflate += 1
        }
    }

    // Whether the living entity seen as `p` puffs a pufferfish up, `Pufferfish.TARGETING_CONDITIONS`
    // (CAL-201): not it, alive and no spectator, `canBeSeenByAnyone`, an armor stand's seen and no
    // marker, and `SCARY_MOB`: no creative player nor a kind of `#not_scary_for_pufferfish`.
    fn scares_puffer(self, p: Follower) -> bool {
        if p.id == self.living.body.id or p.dead or p.spectator or p.creative {
            return false
        }
        return not (p.mob and pufferfish_fearless(p.species))
    }

    // `PufferfishPuffGoal` (CAL-201): used while a living entity that scares it, `scares_puffer`,
    // has its box within 2 of its own, the players and those near it, `getEntitiesOfClass`; as it
    // starts, puffing up from its first tick, `inflateCounter`, its going down's count none; as it
    // stops, no longer puffing up.
    fn puff_goal(mut self, call: i32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let b = self.living.body.bounding_box()
            let near = Aabb { min_x: b.min_x - 2.0, min_y: b.min_y - 2.0, min_z: b.min_z - 2.0, max_x: b.max_x + 2.0, max_y: b.max_y + 2.0, max_z: b.max_z + 2.0 }
            for p in self.prey {
                if let pb = p.bounds {
                    if self.scares_puffer(p) and pb.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
                        return true
                    }
                }
            }
            for p in players {
                if let pb = p.bounds {
                    if self.scares_puffer(p) and pb.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
                        return true
                    }
                }
            }
            return false
        }
        if call == GOAL_START {
            self.inflate = 1
            self.deflate = 0
        } else if call == GOAL_STOP {
            self.inflate = 0
        }
        return false
    }

    // `SmoothSwimmingMoveControl.tick` of a dolphin, `(85, 10, 0.02, 0.1, true)` (CAL-201): in
    // water, up 0.005; then, moving to where it's wanted with its navigation not done: there
    // already, not forward; else turned toward there, 10 degrees a tick at most, its body and head
    // with it, and, in water, its speed a fiftieth of its own, pitched toward there 5 degrees a
    // tick at most, kept within 85, and forward and up along its pitch at its own speed; out of
    // water its speed a tenth of its own, less as it has more than 10 degrees left to turn, none
    // past 60. Else stopped.
    fn dolphin_moves(mut self, w: Walker) {
        if self.living.body.in_water {
            self.living.body.vy = self.living.body.vy + 0.005
        }
        if self.moves.operation != MOVE_TO or self.navigation.is_done() {
            self.turtle_speed(0.0f32)
            self.living.xxa = 0.0f32
            self.living.yya = 0.0f32
            self.living.zza = 0.0f32
            return
        }
        let xd = self.moves.wanted_x - self.living.body.x
        let yd = self.moves.wanted_y - self.living.body.y
        let zd = self.moves.wanted_z - self.living.body.z
        if xd * xd + yd * yd + zd * zd < f64(2.5000003e-7f32) {
            self.living.zza = 0.0f32
            return
        }
        let wanted_rot = f32.nearest((table_atan2(zd, xd) ?? 0.0) * RAD_TO_DEG) - 90.0f32
        self.living.body.y_rot = rotlerp(self.living.body.y_rot, wanted_rot, 10.0f32)
        self.living.y_body_rot = self.living.body.y_rot
        self.living.y_head_rot = self.living.body.y_rot
        let speed = f32.nearest(self.moves.speed_modifier * w.movement_speed)
        if self.living.body.in_water {
            self.turtle_speed(speed * 0.02f32)
            let across = (xd * xd + zd * zd).sqrt()
            if yd.abs() > f64(1.0e-5f32) or across.abs() > f64(1.0e-5f32) {
                let pitch = -f32.nearest((table_atan2(yd, across) ?? 0.0) * RAD_TO_DEG)
                let kept = clamp(wrap_degrees(pitch), -85.0f32, 85.0f32)
                self.living.body.x_rot = clamp_pitch(rotate_towards(self.living.body.x_rot, kept, 5.0f32) % 360.0f32)
            }
            let radians = self.living.body.x_rot * f32.nearest(3.141592653589793 / 180.0)
            let c = table_cos(f64(radians))
            let s = table_sin(f64(radians))
            self.living.zza = c * speed
            self.living.yya = -s * speed
        } else {
            let left = wrap_degrees(self.living.body.y_rot - wanted_rot).abs()
            let factor = 1.0f32 - clamp((left - 10.0f32) / 50.0f32, 0.0f32, 1.0f32)
            self.turtle_speed(speed * 0.1f32 * factor)
        }
    }

    // `Dolphin.tick`'s, after the rest (CAL-201): without its AI, its air full; else in water or
    // the rain wholly moist, 2400; out of them a tick drier, and dry, hurt by 1 of `dry_out`; on
    // the ground it hops, up 0.5 and up to 0.2 either way across, drawn, turned anywhere, drawn,
    // off the ground, synced. Its trail's particles only clients make.
    fn dolphin_tick_end<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        if self.no_ai() {
            let most = self.living.max_air
            self.living.set_air(most)
            return
        }
        if self.living.body.in_water or self.living.body.in_rain(blocks) {
            self.living.data.set(MOISTNESS, Value.Number(2400))
            return
        }
        let drier = self.living.data.number(MOISTNESS) - 1
        self.living.data.set(MOISTNESS, Value.Number(drier))
        if drier <= 0 {
            self.hurt_self(lf, blocks, items, "dry_out", 1.0f32, mut sounds)
        }
        if self.living.body.on_ground {
            let ax = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.2f32
            let az = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.2f32
            self.living.body.vx = self.living.body.vx + f64(ax)
            self.living.body.vy = self.living.body.vy + 0.5
            self.living.body.vz = self.living.body.vz + f64(az)
            self.living.body.y_rot = self.living.body.random.next_float() * 360.0f32
            self.living.body.on_ground = false
            self.living.body.needs_sync = true
        }
    }

    // A dolphin's own goals (CAL-201), by their kind, `kind`:
    // - `BreathAirGoal`: used while its air's under 140; as it starts, its navigation stopped;
    //   as it starts and each tick, toward the first place in its column and the four beside it,
    //   north, east, south and west, each from its block up 8, with no fluid or a bubble column a
    //   walker may path through, else 8 above it, a block over it, at 1; each tick too it swims a
    //   fiftieth along what it's told, `moveRelative(0.02)`, and moves.
    // - `TryFindLiquidGoal`: used on the ground out of water; as it starts, wanted at 1 at the
    //   first water within 2 across and from 2 below to its block, by x, then y, then z.
    // - `DolphinSwimToTreasureGoal`: used with a fish and 100 air or more; going on with treasure
    //   found, not within 4 of it across at its height, not stuck and with that air; as it starts,
    //   not stuck, its navigation stopped and its treasure looked for within 50, which a world
    //   without structures has none of, so it's stuck, and a world with them says it's missing;
    //   as it stops there, stuck or with none found, its fish forgotten.
    // - `DolphinSwimWithPlayerGoal`: used where the nearest player within 10 of it, seen or not,
    //   swims and isn't its target; going on while they swim within 16; as it starts, their
    //   dolphin's grace given, 100 ticks of it; each tick looking at their eyes, its head turned
    //   21 a tick at most and 1 up or down, going toward them at 4, stopped within 2.5, and while
    //   they swim, by a draw of 6 from the level's random, their grace given again; as it stops,
    //   them forgotten and its navigation stopped.
    // - `DolphinJumpGoal`: used by a draw of 5, `reducedTickDelay(10)`, where the blocks it faces,
    //   0, 1 and 4 to 7 on, are water that doesn't block its jump, `#blocks_dolphin_jump`, with air
    //   over them two high; going on off the ground unless it's slow up and down, under 0.03
    //   squared, in water and pitched under 10 degrees off level but not level. As it starts, up
    //   0.7 and 0.6 the way it faces, its navigation stopped; each tick, its first time in water
    //   since it was made, its jump heard, and then pitched along its motion, or, slow up and
    //   down, eased a fifth of the way level; as it stops, level.
    // - `MoveToItemGoal`: used past its cooldown, its tick count, with an item in water near it;
    //   as it starts, toward the first at 1.2 and heard playing, its cooldown none; each tick,
    //   toward the first; as it stops, what it holds dropped, and if it held something, its
    //   cooldown up to 99 ticks on, drawn.
    // - `PlayWithItemsGoal`: used while it holds something, which it drops each tick and as it
    //   stops.
    fn dolphin_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, kind: i32, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if kind == DOLPHIN_BREATH {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                return self.living.air() < 140
            }
            if call == GOAL_START {
                self.navigation.stop()
                self.dolphin_to_air(lf, f, m, blocks, mut cache, min_y)
            } else if call == GOAL_TICK {
                self.dolphin_to_air(lf, f, m, blocks, mut cache, min_y)
                self.living.move_relative(0.02f32)
                let t = BodyFacts.new(f)
                let (dx, dy, dz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
                // In a level whose lava flows slowly, as the overworld's does.
                self.living.move_self(lf, f, m, t, blocks, dx, dy, dz, false, mut sounds)
            }
            return false
        }
        if kind == DOLPHIN_LIQUID {
            let (bx, by, bz) = self.living.body.block()
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                return self.living.body.on_ground and not f.is_water(state_at(blocks, bx, by, bz))
            }
            if call == GOAL_START {
                let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                for zz in floor_of(z - 2.0)..floor_of(z + 2.0) + 1 {
                    for yy in floor_of(y - 2.0)..by + 1 {
                        for xx in floor_of(x - 2.0)..floor_of(x + 2.0) + 1 {
                            if f.is_water(state_at(blocks, xx, yy, zz)) {
                                self.moves.set_wanted(f64(xx), f64(yy), f64(zz), 1.0)
                                return false
                            }
                        }
                    }
                }
            }
            return false
        }
        if kind == DOLPHIN_TREASURE {
            if call == GOAL_CAN_USE {
                return self.living.data.flag(GOT_FISH) and self.living.air() >= 100
            }
            if call == GOAL_CONTINUE {
                let at = self.dolphin.treasure else return false
                return not self.dolphin_near_treasure(at) and not self.dolphin.stuck and self.living.air() >= 100
            }
            if call == GOAL_START {
                self.dolphin.stuck = false
                self.navigation.stop()
                if self.dolphin.structures {
                    self.living.show(Shown.Missing(String("A dolphin's search for treasure, findNearestMapStructure of #dolphin_located")), sounds.len())
                }
                self.dolphin.stuck = true
            } else if call == GOAL_STOP {
                var forgets = self.dolphin.stuck
                if let at = self.dolphin.treasure {
                    forgets = forgets or self.dolphin_near_treasure(at)
                } else {
                    forgets = true
                }
                if forgets {
                    self.living.data.set(GOT_FISH, Value.Bool(false))
                }
            }
            return false
        }
        if kind == DOLPHIN_SWIM_PLAYER {
            if call == GOAL_CAN_USE {
                let who = self.looker()
                let found = nearest_player(m, f, blocks, mut self.sensing, who, players, 10.0, self.living.body.y, false, 0u32)
                self.dolphin.player = found
                let id = found else return false
                let p = self.followed(players, id) else return false
                return p.swimming and self.target != some(id)
            }
            if call == GOAL_CONTINUE {
                let id = self.dolphin.player else return false
                let p = self.followed(players, id) else return false
                return p.swimming and self.distance_sqr_to(p.x, p.y, p.z) < 256.0
            }
            if call == GOAL_START {
                if let id = self.dolphin.player {
                    self.living.show(Shown.Grace(id), sounds.len())
                }
            } else if call == GOAL_STOP {
                self.dolphin.player = none
                self.navigation.stop()
            } else if call == GOAL_TICK {
                let id = self.dolphin.player else return false
                let p = self.followed(players, id) else return false
                let (y_most, x_most) = (self.max_head_y_rot() + 20.0f32, self.max_head_x_rot())
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, y_most, x_most)
                if self.distance_sqr_to(p.x, p.y, p.z) < 6.25 {
                    self.navigation.stop()
                } else {
                    _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, 4.0)
                }
                if p.swimming {
                    let lent = self.level_random.take()
                    let had = lent != none
                    if not had {
                        self.living.show(Shown.Missing(String("A dolphin's grace again without its level's random")), sounds.len())
                    }
                    var random = lent ?? TapedRandom.new(0i64)
                    let drawn = random.next_int_below(6)
                    if had {
                        self.level_random = some(random)
                    }
                    if drawn == 0 {
                        self.living.show(Shown.Grace(id), sounds.len())
                    }
                }
            }
            return false
        }
        if kind == DOLPHIN_JUMP {
            if call == GOAL_CAN_USE {
                if self.living.body.random.next_int_below(reduced_tick_delay(10)) != 0 {
                    return false
                }
                let (sx, sz) = dolphin_facing(self.living.body.y_rot)
                let (bx, by, bz) = self.living.body.block()
                for i in [0, 1, 4, 5, 6, 7] {
                    let (x, z) = (bx + sx * i, bz + sz * i)
                    let state = state_at(blocks, x, by, z)
                    if not f.is_water(state) or f.in_set(state, lf.dolphin_jump_blocks) {
                        return false
                    }
                    if not f.is_air(state_at(blocks, x, by + 1, z)) or not f.is_air(state_at(blocks, x, by + 2, z)) {
                        return false
                    }
                }
                return true
            }
            if call == GOAL_CONTINUE {
                let yd = self.living.body.vy
                let pitch = self.living.body.x_rot
                return (not (yd * yd < f64(0.03f32)) or pitch == 0.0f32 or not (pitch.abs() < 10.0f32) or not self.living.body.in_water) and not self.living.body.on_ground
            }
            if call == GOAL_START {
                let (sx, sz) = dolphin_facing(self.living.body.y_rot)
                self.living.body.vx = self.living.body.vx + f64(sx) * 0.6
                self.living.body.vy = self.living.body.vy + 0.7
                self.living.body.vz = self.living.body.vz + f64(sz) * 0.6
                self.navigation.stop()
            } else if call == GOAL_STOP {
                self.living.body.x_rot = 0.0f32
            } else if call == GOAL_TICK {
                let already = self.dolphin.breached
                if not already {
                    let (bx, by, bz) = self.living.body.block()
                    self.dolphin.breached = f.is_water(state_at(blocks, bx, by, bz))
                }
                if self.dolphin.breached and not already {
                    self.living.play(mut sounds, String("entity.dolphin.jump"), 1.0f32, 1.0f32)
                }
                let (vx, vy, vz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
                if vy * vy < f64(0.03f32) and self.living.body.x_rot != 0.0f32 {
                    let pitch = self.living.body.x_rot
                    self.living.body.x_rot = clamp_pitch((pitch + 0.2f32 * wrap_degrees(0.0f32 - pitch)) % 360.0f32)
                } else if (vx * vx + vy * vy + vz * vz).sqrt() > f64(1.0e-5f32) {
                    let across = (vx * vx + vz * vz).sqrt()
                    let rotation = atan2(-vy, across) * RAD_TO_DEG
                    self.living.body.x_rot = clamp_pitch(f32.nearest(rotation) % 360.0f32)
                }
            }
            return false
        }
        if kind == DOLPHIN_TO_ITEM {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                if self.dolphin.item_cooldown > self.living.body.tick_count {
                    return false
                }
                return not self.dolphin.items.is_empty()
            }
            if call == GOAL_START {
                if not self.dolphin.items.is_empty() {
                    let (_, x, y, z) = self.dolphin.items[0]
                    _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, x, y, z, f64(1.2f32))
                    self.living.play(mut sounds, String("entity.dolphin.play"), 1.0f32, 1.0f32)
                }
                self.dolphin.item_cooldown = 0
            } else if call == GOAL_STOP {
                if self.dolphin_drop(sounds.len()) {
                    self.dolphin.item_cooldown = self.living.body.tick_count + self.living.body.random.next_int_below(100)
                }
            } else if call == GOAL_TICK {
                if not self.dolphin.items.is_empty() {
                    let (_, x, y, z) = self.dolphin.items[0]
                    _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, x, y, z, f64(1.2f32))
                }
            }
            return false
        }
        if kind == DOLPHIN_PLAY {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                return self.living.equipment[0] != none
            }
            if call == GOAL_STOP or call == GOAL_TICK {
                _ = self.dolphin_drop(sounds.len())
            }
            return false
        }
        if kind == DOLPHIN_FOLLOW_BOAT {
            return self.dolphin_follow_boat(call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        }
        return false
    }

    // `FollowPlayerRiddenEntityGoal` of boats (CAL-315). It may go where the player it follows
    // has moved across since their tick before, or a player steering a boat within 5 of it has;
    // it goes on while the player it follows rides and moves. Starting, it follows the player
    // steering the first of those boats, going behind them. Each tick it's pushed on, at 0.01
    // going the way they face or 0.015 going behind them, and moves; and every 5 of its ticks it
    // paths, at 1, to the block behind theirs, the way they face turned round, and one down, going
    // the way they face once it's within 4 of them; or, going the way they face, to 10 blocks
    // that way from theirs and one down, going behind them again once it's 12 or more off.
    fn dolphin_follow_boat<B: CollisionBlocks + MobLight + NavLevel>(mut self, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            if let id = self.dolphin.following {
                if let p = self.followed(players, id) {
                    if p.moved_across {
                        return true
                    }
                }
            }
            for id in self.dolphin.boat_riders {
                if let p = self.followed(players, id) {
                    if p.moved_across {
                        return true
                    }
                }
            }
            return false
        }
        if call == GOAL_CONTINUE {
            let id = self.dolphin.following else return false
            let p = self.followed(players, id) else return false
            return p.riding and p.moved_across
        }
        if call == GOAL_START {
            if not self.dolphin.boat_riders.is_empty() {
                self.dolphin.following = some(self.dolphin.boat_riders[0])
            }
            self.dolphin.follow_recalc = 0
            self.dolphin.follow_ahead = false
            return false
        }
        if call == GOAL_STOP {
            self.dolphin.following = none
            return false
        }
        if call != GOAL_TICK {
            return false
        }
        let speed = if self.dolphin.follow_ahead { 0.01f32 } else { 0.015f32 }
        self.living.move_relative(speed)
        let t = BodyFacts.new(f)
        let (dx, dy, dz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
        self.living.move_self(lf, f, m, t, blocks, dx, dy, dz, false, mut sounds)
        self.dolphin.follow_recalc -= 1
        if self.dolphin.follow_recalc > 0 {
            return false
        }
        self.dolphin.follow_recalc = reduced_tick_delay(10)
        let id = self.dolphin.following else return false
        let p = self.followed(players, id) else return false
        let (px, py, pz) = (floor_of(p.x), floor_of(p.y), floor_of(p.z))
        let (sx, sz) = dolphin_facing(p.yaw)
        let ax = f32.nearest(self.living.body.x - p.x)
        let ay = f32.nearest(self.living.body.y - p.y)
        let az = f32.nearest(self.living.body.z - p.z)
        let distance = (ax * ax + ay * ay + az * az).sqrt()
        if not self.dolphin.follow_ahead {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(px - sx), f64(py - 1), f64(pz - sz), 1.0)
            if distance < 4.0f32 {
                self.dolphin.follow_recalc = 0
                self.dolphin.follow_ahead = true
            }
        } else {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(px + sx * 10), f64(py - 1), f64(pz + sz * 10), 1.0)
            if distance > 12.0f32 {
                self.dolphin.follow_recalc = 0
                self.dolphin.follow_ahead = false
            }
        }
        return false
    }

    // `BreathAirGoal.findAirPosition` (CAL-201): toward the first place, of its block's column and
    // the four beside it, north, east, south and west, each from its block up 8, that gives air,
    // `givesAir`, with no fluid or a bubble column and a walker may path through it, else 8 above
    // it; to the block over it, at 1.
    fn dolphin_to_air<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        let (bx, by, bz) = self.living.body.block()
        let column = f.block_named(String("minecraft:bubble_column"))
        var found: (i32, i32, i32)? = none
        for (sx, sz) in [(0, 0), (0, -1), (1, 0), (0, 1), (-1, 0)] {
            for up in 0..9 {
                let (x, y, z) = (bx + sx, by + up, bz + sz)
                let state = state_at(blocks, x, y, z)
                let bubbles = column != none and some(f.block(state)) == column
                if (f.fluid(state) == EMPTY_FLUID or bubbles) and lf.paths.pathfindable(state, COMPUTATION_LAND) {
                    found = some((x, y, z))
                    break
                }
            }
            if found != none {
                break
            }
        }
        let (x, y, z) = found ?? (bx, floor_of(self.living.body.y + 8.0), bz)
        _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(x), f64(y + 1), f64(z), 1.0)
    }

    // Whether a dolphin's within 4 of the middle of the block across from its treasure at its own
    // height, `closerToCenterThan` (CAL-201).
    fn dolphin_near_treasure(self, at: (i32, i32, i32)) -> bool {
        let (tx, _, tz) = at
        let dx = f64(tx) + 0.5 - self.living.body.x
        let dy = f64(floor_of(self.living.body.y)) + 0.5 - self.living.body.y
        let dz = f64(tz) + 0.5 - self.living.body.z
        return dx * dx + dy * dy + dz * dz < 16.0
    }

    // `Dolphin.ItemGoal.dropItem` (CAL-201): what it holds in its main hand, if anything, dropped
    // 0.3 below its eyes, picked up no sooner than 40 ticks on, its thrower it, thrown 0.3 along
    // its facing and up half as much again along its pitch, and off a little to a side drawn,
    // up to 0.02, drawn; its hand then empty. Whether it held something.
    fn dolphin_drop(mut self, heard: usize) -> bool {
        let held = self.living.equipment[0].take() else return false
        let radians = f32.nearest(3.141592653589793 / 180.0)
        let dir = self.living.body.random.next_float() * 6.2831855f32
        let off = 0.02f32 * self.living.body.random.next_float()
        let yaw = self.living.body.y_rot * radians
        let pitch = self.living.body.x_rot * radians
        let vx = 0.3f32 * -table_sin(f64(yaw)) * table_cos(f64(pitch)) + table_cos(f64(dir)) * off
        let vy = 0.3f32 * table_sin(f64(pitch)) * 1.5f32
        let vz = 0.3f32 * table_cos(f64(yaw)) * table_cos(f64(pitch)) + table_sin(f64(dir)) * off
        let (x, y, z) = (self.living.body.x, self.living.body.y + f64(self.living.body.eyes) - f64(0.3f32), self.living.body.z)
        let thrower = self.living.body.uuid
        self.living.show(Shown.Tossed(Tossed { x: x, y: y, z: z, vx: f64(vx), vy: f64(vy), vz: f64(vz), stack: held, thrower: thrower, delay: 40 }), heard)
        return true
    }

    // `Pufferfish.aiStep`'s, after the rest (CAL-201): alive and puffed, each mob whose box is
    // within 0.3 of its own and that scares it, `scares_puffer`, alive, in the order
    // `getEntitiesOfClass` finds them, touched, `touch`, which its level deals, `Shown.Sting`:
    // hurt by 1 more than its puff, `mobAttack`, then poisoned and its sting heard.
    fn puffer_stings(mut self, heard: usize) {
        let state = self.puff_state()
        if not self.living.alive() or state <= 0 {
            return
        }
        let b = self.living.body.bounding_box()
        let near = Aabb { min_x: b.min_x - 0.3, min_y: b.min_y - 0.3, min_z: b.min_z - 0.3, max_x: b.max_x + 0.3, max_y: b.max_y + 0.3, max_z: b.max_z + 0.3 }
        var stung = List<i32>()
        for p in self.prey {
            if not p.mob or not self.scares_puffer(p) {
                continue
            }
            let pb = p.bounds else continue
            if pb.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
                stung.push(p.id)
            }
        }
        for id in stung {
            self.living.show(Shown.Sting((id, state)), heard)
        }
    }

    pub fn set_slime_size(mut self, size: i32, heal: bool) {
        let actual = if size < 1 { 1 } else if size > 127 { 127 } else { size }
        let changed = actual != self.slime_size()
        if changed {
            self.living.data.set(OWN, Value.Number(actual))
            let head = self.living.y_head_rot
            self.living.body.y_rot = head
            self.living.y_body_rot = head
        }
        let scale = f32.nearest(actual)
        // A sulfur cube's type 0.49 across and high, its eyes 0.175 up (CAL-402).
        let sulfur = self.species == SULFUR_CUBE
        self.width = (if sulfur { 0.49f32 } else { 0.52f32 }) * scale
        self.height = (if sulfur { 0.49f32 } else { 0.52f32 }) * scale
        self.eyes = (if sulfur { 0.175f32 } else { 0.325f32 }) * scale
        self.baby_width = self.width
        self.baby_height = self.height
        self.baby_eyes = self.eyes
        self.refresh_size()
        if changed and self.living.body.in_water and self.living.body.random.next_int_below(20) == 0 {
            var heard = List<EntitySound>()
            self.living.body.splash(mut heard)
            for h in heard {
                self.splashed.push(h.copy())
            }
        }
        // A sulfur cube's most health 4 by its size, `setCubeMobHealth`, and no attack, as it has
        // no such attribute (CAL-402).
        self.set_base("minecraft:max_health", f64(if sulfur { 4 * actual } else { actual * actual }))
        self.set_base("minecraft:movement_speed", f64(0.2f32 + 0.1f32 * scale))
        if not sulfur {
            self.set_base("minecraft:attack_damage", f64(actual))
        }
        if self.species == MAGMA_CUBE {
            // `MagmaCube.setSize`'s: its armor 3 times the size it was given, as it was given it,
            // and its jumps by its size (CAL-200).
            self.set_base("minecraft:armor", f64(i32.wrap(i64(size) * 3)))
            self.living.magma_size = some(actual)
        }
        self.sound_volume = 0.4f32 * scale
        if heal {
            let most = attribute("max_health")
            self.living.data.set(HEALTH, Value.Float(f32.nearest(self.living.attributes.value(most))))
        }
        // `SulfurCube.setSize`: healed to size 1 and grown, it's a baby again, `setBaby` (CAL-402).
        if sulfur and heal and actual == 1 and not self.baby() {
            self.set_age(-24000)
        }
    }

    /// `finalizeSpawn` as natural spawning finalizes it at `o`, with `given` its pack's group so
    /// far, drawing from `r`, the level's random, what it makes besides it made by `maker`: a
    /// cow's, pig's or chicken's variant, one of those it may spawn as, and its sound variant, any;
    /// a sheep's color; then an ageable mob's group made where there's none, and each after the
    /// first a baby by its chance; then `Mob`'s, its follow range's random spawn bonus where it
    /// hasn't one and whether it's left-handed; a monster's after `Mob`'s, and a slime's. The
    /// group, for the next.
    pub fn finalize_spawn<R: RandomSource, K: Making>(mut self, given: own SpawnGroup?, o: Occasion, maker: mut K, r: mut R) -> SpawnGroup? {
        if self.species == PHANTOM {
            // `Phantom.finalizeSpawn` (CAL-200): the block it circles 5 above its own, its size 0,
            // which it is already, then `Mob`'s.
            let (bx, by, bz) = self.block_position()
            self.phantom.anchor = some((bx, by + 5, bz))
            self.set_phantom_size(0)
            self.finalize_mob(mut r)
            return given
        }
        if self.species == CAVE_SPIDER {
            // `CaveSpider.finalizeSpawn`: the group it was given, and nothing drawn, not even a
            // mob's (CAL-200).
            return given
        }
        if self.species == SHULKER {
            // `Shulker.finalizeSpawn` (CAL-200): facing south, its head too, as it was a tick
            // before, `setOldPosAndRot`; then `Mob`'s.
            self.living.body.y_rot = 0.0f32
            self.living.y_head_rot = 0.0f32
            self.living.y_rot_o = 0.0f32
            self.finalize_mob(mut r)
            return given
        }
        if self.species == IRON_GOLEM or self.species == SNOW_GOLEM {
            // An iron golem has no `finalizeSpawn` of its own: `Mob`'s alone (CAL-201); nor has
            // a snow golem.
            self.finalize_mob(mut r)
            return given
        }
        if self.monster {
            return self.finalize_monster(given, o, mut maker, mut r)
        }
        if self.species == SULFUR_CUBE {
            return self.finalize_sulfur_cube(given, mut r)
        }
        if cube_kind(self.species) {
            return self.finalize_slime(given, o, mut r)
        }
        if schooling_kind(self.species) {
            // `AbstractSchoolingFish.finalizeSpawn` (CAL-178): `Mob`'s, then the pack's group its
            // school, led by it where it's the first, else it follows the leader, whose school its
            // level grows by it as it's added. A salmon's size is drawn first, small, medium or
            // large, 30, 50 and 15 in 95, from its own random, `Salmon.finalizeSpawn` (CAL-201).
            if self.species == SALMON {
                let pick = self.living.body.random.next_int_below(95)
                self.set_salmon_size(if pick < 30 { 0 } else if pick < 80 { 1 } else { 2 })
            }
            self.finalize_mob(mut r)
            var group = SpawnGroup { leader: self.living.body.id }
            if let g = given {
                self.leader = some(g.leader)
                group = g
            }
            if self.species == TROPICAL_FISH {
                // `TropicalFish.finalizeSpawn` (CAL-201), after its school's: its pack's variant,
                // where its group has one, `TropicalFishGroupData`; else, 9 in 10, one of the common
                // ones, drawn from its level's random, which its pack's group takes on, it its
                // leader; else a pattern and two colors drawn, its school closed, `isSchool`.
                var packed = group.variant
                if packed < 0 {
                    if r.next_float() < 0.9f32 {
                        let (p, b, over) = tropical_common()[usize.wrap(r.next_int_below(22))]
                        packed = pack_tropical(p, b, over)
                        group = SpawnGroup { leader: self.living.body.id, variant: packed }
                    } else {
                        self.school = false
                        let p = r.next_int_below(12)
                        let b = r.next_int_below(16)
                        let over = r.next_int_below(16)
                        packed = pack_tropical(p, b, over)
                    }
                }
                self.living.data.set(TROPICAL_VARIANT, Value.Number(packed))
            }
            return some(group)
        }
        if self.species == COW or self.species == PIG or self.species == CHICKEN {
            let choices = self.spawn_variants.copy()
            if not choices.is_empty() {
                let pick = r.next_int_below(i32.wrap(choices.len()))
                self.set_variant(choices[usize.wrap(pick)])
            }
            var count = 0
            if let s = self.sounds {
                count = i32.wrap(s.variants.len())
            }
            if count > 0 {
                let sound = r.next_int_below(count)
                self.set_sound_variant(sound)
            }
        } else if self.species == SHEEP {
            let color = sheep_color(self.climate, mut r)
            self.set_color(color)
        }
        if self.species == HOGLIN and r.next_float() < 0.2f32 {
            // `Hoglin.finalizeSpawn` (CAL-200): a baby by a draw under 0.2, `setBaby`, then an
            // animal's.
            self.set_age(-24000)
        }
        var group = given
        if self.species == WOLF {
            // `Wolf.finalizeSpawn` (CAL-201): its pack's variant, else one of those it may spawn
            // as, drawn, its pack's group then a wolf pack's of it, `WolfPackData`, which makes no
            // babies; then its sound variant, any, drawn; then an animal's.
            var variant = -1
            if let g = group {
                variant = g.variant
            }
            if variant >= 0 {
                self.set_variant(variant)
            } else {
                let choices = self.spawn_variants.copy()
                if not choices.is_empty() {
                    let pick = choices[usize.wrap(r.next_int_below(i32.wrap(choices.len())))]
                    self.set_variant(pick)
                    group = some(SpawnGroup { ageable: true, babies: false, variant: pick })
                }
            }
            var count = 0
            if let s = self.sounds {
                count = i32.wrap(s.variants.len())
            }
            if count > 0 {
                self.set_sound_variant(r.next_int_below(count))
            }
        }
        if self.species == HORSE {
            // `Horse.finalizeSpawn`: the pack's variant, drawn for its first, then its markings,
            // each `Util.getRandom` of their values; the pack's group a horses', a baby 1 in 20.
            var variant = -1
            if let g = group {
                variant = g.variant
            }
            if variant < 0 {
                variant = r.next_int_below(7)
                group = some(SpawnGroup { ageable: true, variant: variant })
            }
            let markings = r.next_int_below(5)
            self.living.data.set(OWN + 1, Value.Number((variant & 255) | ((markings << 8) & 65280)))
        }
        if self.species == ZOMBIE_HORSE and o.natural {
            self.zombie_rider(o, mut maker, mut r)
        }
        if self.species == LLAMA {
            // `Llama.finalizeSpawn` (CAL-201): its strength from the level's random, 1 to 5 one in
            // 25, else 1 to 3, `setRandomStrength`; its variant its pack's, else one of the four,
            // its pack's then, `LlamaGroupData`, whose babies come 1 in 20.
            let most = if r.next_float() < 0.04f32 { 5 } else { 3 }
            self.set_llama_strength(1 + r.next_int_below(most))
            var variant = 0
            if let g = group {
                variant = g.variant
            } else {
                variant = r.next_int_below(4)
                group = some(SpawnGroup { ageable: true, variant: variant })
            }
            self.living.data.set(OWN + 3, Value.Number(variant))
        }
        if self.equine() {
            // `AbstractHorse.finalizeSpawn`: a group, a baby 1 in 5, where there's none yet; then
            // `randomizeAttributes`, a horse's and donkey's most health, and a horse's speed and
            // jump; a zombie horse's own, its jump and then its speed.
            if group == none {
                group = some(SpawnGroup { ageable: true, baby_chance: 0.2f32 })
            }
        }
        if self.species == RABBIT {
            // `Rabbit.finalizeSpawn` (CAL-201): the variant its biome gives, drawn, its pack's
            // where it has one, else its pack's group a rabbits' of it, every one after the first a
            // baby, `RabbitGroupData`; set as `setVariant` sets it.
            var variant = rabbit_variant_in(self.rabbit.biome, mut r)
            if let g = group {
                variant = g.variant
            } else {
                group = some(SpawnGroup { ageable: true, baby_chance: 1.0f32, variant: variant })
            }
            self.set_rabbit_variant(variant)
        }
        if self.species == PANDA {
            // `Panda.finalizeSpawn` (CAL-201): its main gene and then its hidden one drawn from
            // the level's random, `Gene.getRandom`, its attributes by them, `setAttributes`, and a
            // group whose babies come one in five where there's none yet.
            let main = panda_gene_from(r.next_int_below(16))
            let hidden = panda_gene_from(r.next_int_below(16))
            self.set_panda_genes(main, hidden)
            self.panda_attributes()
            if group == none {
                group = some(SpawnGroup { ageable: true, baby_chance: 0.2f32 })
            }
        }
        if self.species == TURTLE {
            // `Turtle.finalizeSpawn` (CAL-201): its home where it is, `setHomePos`.
            self.turtle.home = self.living.body.block()
        }
        if self.species == PARROT {
            // `Parrot.finalizeSpawn` (CAL-201): its variant drawn from the level's random,
            // `Util.getRandom`, and a group that makes no babies where there's none yet,
            // `AgeableMobGroupData(false)`.
            self.living.data.set(OWN + 2, Value.Number(r.next_int_below(5)))
            if group == none {
                group = some(SpawnGroup { ageable: true, babies: false })
            }
        }
        if (self.species == OCELOT or self.species == POLAR_BEAR) and group == none {
            // `Ocelot.finalizeSpawn` and `PolarBear.finalizeSpawn`: a group, every one after the
            // first a baby, where there's none yet (CAL-201).
            group = some(SpawnGroup { ageable: true, baby_chance: 1.0f32 })
        }
        if self.species == FOX {
            // `Fox.finalizeSpawn` (CAL-201): the variant the biome it's made in gives, snow where it
            // gives snow foxes, else red, or its pack's, a cub where two or more of its pack came
            // first, else its pack's group a fox's, which `AgeableMob`'s makes no babies of; its
            // target goals set; then something in its mouth, `populateDefaultEquipmentSlots`.
            var variant = if self.fox.snow { 1 } else { 0 }
            var cub = false
            if let g = group {
                variant = g.variant
                cub = g.size >= 2
            } else {
                group = some(SpawnGroup { ageable: true, babies: false, variant: variant })
            }
            self.living.data.set(OWN, Value.Number(variant))
            if cub {
                self.set_age(BABY_START_AGE)
            }
            self.fox_target_goals()
            self.fox_mouth(mut r)
        }
        if self.species == SKELETON_HORSE {
            // `SkeletonHorse.randomizeAttributes` (CAL-349): its jump alone, `generateJumpStrength`.
            let j1 = r.next_double()
            let j2 = r.next_double()
            let j3 = r.next_double()
            self.set_base("minecraft:jump_strength", f64(0.4f32) + j1 * 0.2 + j2 * 0.2 + j3 * 0.2)
        }
        if self.species == ZOMBIE_HORSE {
            let j1 = r.next_double()
            let j2 = r.next_double()
            let j3 = r.next_double()
            self.set_base("minecraft:jump_strength", 0.5 + j1 * 0.06666666666666667 + j2 * 0.06666666666666667 + j3 * 0.06666666666666667)
            let s1 = r.next_double()
            let s2 = r.next_double()
            let s3 = r.next_double()
            self.set_base("minecraft:movement_speed", (9.0 + s1 * 1.0 + s2 * 1.0 + s3 * 1.0) / f64(42.16f32))
        }
        if self.species == HORSE or self.species == DONKEY or self.species == LLAMA {
            let a = r.next_int_below(8)
            let b = r.next_int_below(9)
            self.set_base("minecraft:max_health", f64(15.0f32 + f32.nearest(a) + f32.nearest(b)))
            if self.species == HORSE {
                let s1 = r.next_double()
                let s2 = r.next_double()
                let s3 = r.next_double()
                self.set_base("minecraft:movement_speed", (f64(0.45f32) + s1 * 0.3 + s2 * 0.3 + s3 * 0.3) * 0.25)
                let j1 = r.next_double()
                let j2 = r.next_double()
                let j3 = r.next_double()
                self.set_base("minecraft:jump_strength", f64(0.4f32) + j1 * 0.2 + j2 * 0.2 + j3 * 0.2)
            }
        }
        if self.species == VILLAGER {
            // `Villager.finalizeSpawn`: its type the biome's where its data isn't final, then
            // `AgeableMob`'s and `Mob`'s (CAL-160).
            self.finalize_villager_type(OWN + 1)
        }
        if self.species == DOLPHIN {
            // `Dolphin.finalizeSpawn` (CAL-201): its air full, level, and a group whose babies
            // come one in ten where there's none yet.
            let most = self.living.max_air
            self.living.set_air(most)
            self.living.body.x_rot = 0.0f32
            if group == none {
                group = some(SpawnGroup { ageable: true, baby_chance: 0.1f32 })
            }
        }
        if self.ageable {
            var g = group ?? SpawnGroup { ageable: true }
            if g.babies and g.size > 0 and r.next_float() <= g.baby_chance {
                self.set_age(BABY_START_AGE)
            }
            g.size += 1
            group = some(g)
        }
        self.finalize_mob(mut r)
        if self.species == CAT {
            // `Cat.finalizeSpawn` (CAL-201), after an animal's: its variant, of those it may spawn as
            // there, drawn, `selectVariantToSpawn`, then its sound variant, any, drawn,
            // `pickRandomSoundVariant`.
            let choices = self.spawn_variants.copy()
            if not choices.is_empty() {
                self.set_variant(choices[usize.wrap(r.next_int_below(i32.wrap(choices.len())))])
            }
            var count = 0
            if let s = self.sounds {
                count = i32.wrap(s.variants.len())
            }
            if count > 0 {
                self.set_sound_variant(r.next_int_below(count))
            }
        }
        return group
    }

    // `Mob.finalizeSpawn`'s: its follow range's random spawn bonus where it hasn't one, and whether
    // it's left-handed, 1 in 20.
    fn finalize_mob<R: RandomSource>(mut self, r: mut R) {
        let follow = attribute("follow_range")
        let bonus = Identifier { namespace: "minecraft", path: "random_spawn_bonus" }
        _ = self.living.attributes.instance(follow)
        if not self.living.attributes.has_modifier(follow, bonus) {
            let amount = r.triangle(0.0, 0.11485000000000001)
            self.living.attributes.add_permanent(follow, Modifier { id: bonus, amount: amount, operation: ADD_MULTIPLIED_BASE })
        }
        self.set_flag(LEFT_HANDED_FLAG, r.next_float() < 0.05f32)
    }

    // `Slime.finalizeSpawn`: its pack's group an ageable one without babies where there's none, so
    // `AgeableMob`'s makes none, only counting it; `Mob`'s draws; then its size, `setSpawnSize`, 1,
    // 2 or 4, its power of 2 drawn from 0 to 2, then up one where under 2 by half the special
    // multiplier, its health its most.
    // `SulfurCube`'s `finalizeSpawn` (CAL-402): `AgeableMob`'s, its group, whose babies come 1 in 20,
    // made where there's none, and a baby by it after the first, `Mob`'s; then its size,
    // `setSpawnSize`, 1 a baby, else 2.
    fn finalize_sulfur_cube<R: RandomSource>(mut self, given: own SpawnGroup?, r: mut R) -> SpawnGroup? {
        var g = given ?? SpawnGroup { ageable: true, babies: true }
        if g.babies and g.size > 0 and r.next_float() <= 0.05f32 {
            self.set_age(-24000)
        }
        g.size += 1
        self.finalize_mob(mut r)
        let size = if self.baby() { 1 } else { 2 }
        self.set_slime_size(size, true)
        return some(g)
    }

    fn finalize_slime<R: RandomSource>(mut self, given: own SpawnGroup?, o: Occasion, r: mut R) -> SpawnGroup? {
        var g = given ?? SpawnGroup { ageable: true, babies: false }
        g.size += 1
        self.finalize_mob(mut r)
        var scale = r.next_int_below(3)
        if scale < 2 and r.next_float() < 0.5f32 * o.local.special() {
            scale += 1
        }
        self.set_slime_size(1 << scale, true)
        return some(g)
    }

    // A monster's `finalizeSpawn`, each after `Mob`'s. A zombie's: whether it picks up loot; its
    // pack's group made where there's none, a baby 1 in 20; a baby's jockey; whether it breaks
    // doors; its equipment and their enchanting's draws; a Halloween pumpkin; then its attributes,
    // from its own random. A skeleton's: its equipment, its bow, their enchanting's draws, whether
    // it picks up loot, and a Halloween pumpkin. A spider's: 1 in 100 its rider, then its pack's
    // group where there's none, with its effect drawn on hard. A creeper's is `Mob`'s alone.
    fn finalize_monster<R: RandomSource, K: Making>(mut self, given: own SpawnGroup?, o: Occasion, maker: mut K, r: mut R) -> SpawnGroup? {
        if self.species == ZOGLIN and r.next_float() < 0.2f32 {
            // `Zoglin.finalizeSpawn`, before `Mob`'s (CAL-200): a baby by a draw under 0.2, `setBaby`.
            self.set_zoglin_baby(true)
        }
        if self.species == PIGLIN_BRUTE {
            // `PiglinBrute.finalizeSpawn`, before `Mob`'s (CAL-200): its home where it's made,
            // `PiglinBruteAi.initMemories`, and a golden axe in its main hand,
            // `populateDefaultEquipmentSlots`.
            let (hx, hy, hz) = self.block_position()
            let dimension = if self.dimension.is_empty() { maker.level_dimension() } else { self.dimension.copy() }
            let home = GlobalPos { dimension: dimension, pos: BlockPos { x: hx, y: hy, z: hz } }
            if let held = self.brain.take() {
                var brain = held
                brain.set(MEMORY_HOME, Memo.Place(home))
                self.brain = some(brain)
            }
            self.living.equipment[0] = some(stack_of(String("minecraft:golden_axe")))
        }
        if self.species == PIGLIN {
            // `Piglin.finalizeSpawn`, before `Mob`'s (CAL-200): but for one a structure makes, a
            // baby by a draw under 0.2, else a weapon in its main hand, `createSpawnWeapon`; how
            // long till it may first hunt, 600 to 2,400 ticks, drawn, `PiglinAi.initMemories`;
            // grown, each piece of golden armor by a draw under 0.1, its head first,
            // `populateDefaultEquipmentSlots`; then its equipment's enchanting's draws.
            if not o.structure {
                if r.next_float() < 0.2f32 {
                    self.set_piglin_baby(true)
                } else {
                    let weapon = self.piglin_weapon()
                    self.living.equipment[0] = some(stack_of(String(weapon)))
                }
            }
            let first_hunt = r.next_int_between(600, 2400)
            if let held = self.brain.take() {
                var brain = held
                brain.set_for(MEMORY_HUNTED_RECENTLY, Memo.Flag(true), i64(first_hunt))
                self.brain = some(brain)
            }
            if not self.baby() {
                for (slot, name) in [(5usize, "minecraft:golden_helmet"), (4usize, "minecraft:golden_chestplate"), (3usize, "minecraft:golden_leggings"), (2usize, "minecraft:golden_boots")] {
                    if r.next_float() < 0.1f32 {
                        self.living.equipment[slot] = some(stack_of(String(name)))
                    }
                }
            }
            self.enchant_equipment(o.local.special(), maker.world_loot(), mut r)
        }
        if self.species == PILLAGER {
            // `Pillager.finalizeSpawn`, before `Raider`'s (CAL-200): a crossbow in its main hand,
            // then its equipment's enchanting's draws, 1 in 300 its crossbow's piercing among
            // them.
            self.living.equipment[0] = some(stack_of(String("minecraft:crossbow")))
            self.enchant_equipment(o.local.special(), maker.world_loot(), mut r)
        }
        if self.species == WITCH {
            // `Raider.finalizeSpawn`: a witch spawned naturally may join no raid, any other may;
            // then `PatrollingMonster.finalizeSpawn`'s draw for a patrol's leader, which a witch
            // can't be, `canBeLeader`, before `Mob`'s, but for one a structure spawns, which
            // draws none (CAL-87).
            self.can_join_raid = not o.natural
            if not o.structure and not o.event and not o.patrol {
                _ = r.next_float() < 0.06f32
            }
            if o.patrol {
                self.patrolling = true
            }
        } else if raider_kind(self.species) {
            // An illager's or a ravager's (CAL-200): it may join a raid; 6 in 100 a patrol's leader,
            // but for one a structure or a raid spawns, which draws none, or a ravager, which
            // draws but can't be one, `canBeLeader`; a leader wears the ominous banner, sure to
            // drop, `setDropChance`.
            self.can_join_raid = true
            if not o.structure and not o.event and not o.patrol and r.next_float() < 0.06f32 and self.species != RAVAGER {
                self.patrol_leader = true
            }
            if self.patrol_leader {
                self.living.equipment[5] = some(ominous_banner())
                self.guarantee_drop(5)
            }
            // A patrol's patrols.
            if o.patrol {
                self.patrolling = true
            }
        } else if self.species == ZOMBIE_VILLAGER {
            self.finalize_villager_type(MONSTER_OWN + 4)
        } else if self.species == VEX {
            // `Vex.finalizeSpawn`, before `Mob`'s (CAL-200): an iron sword in its main hand, never
            // dropped, then its equipment's enchanting's draws.
            self.hold_shown(stack_of(String("minecraft:iron_sword")))
            self.enchant_equipment(o.local.special(), maker.world_loot(), mut r)
        }
        self.finalize_mob(mut r)
        let special = o.local.special()
        var group = given
        if self.zombie_class() {
            // As what another's turned into, it keeps that's pick-up, and wears only what that
            // wore (CAL-244).
            if not o.conversion {
                self.can_pick_up_loot = r.next_float() < 0.55f32 * special
            }
            if group == none {
                group = some(SpawnGroup { zombie: true, baby: r.next_float() < 0.05f32 })
            }
            var zombies = false
            var baby = false
            var jockey = false
            if let g = group {
                zombies = g.zombie
                baby = g.baby
                jockey = g.jockey
            }
            if zombies {
                if baby {
                    self.set_zombie_baby(true)
                    if jockey {
                        self.chicken_jockey(o, mut maker, mut r)
                    }
                }
                self.can_break_doors = r.next_float() < special * 0.1f32
                self.navigation.can_open_doors = self.can_break_doors
                if not o.conversion {
                    self.populate_equipment(o, mut r)
                    self.enchant_equipment(special, maker.world_loot(), mut r)
                }
            }
            self.halloween(o, mut r)
            self.zombie_attributes(special, not o.conversion)
            if self.species == HUSK {
                // `Husk.finalizeSpawn`, after a zombie's: whether it picks up loot, drawn again
                // but as what another's turned into; then, spawned naturally where a camel husk
                // has room, by a draw under 0.1, an iron spear in its hand and a camel husk under
                // it with a parched on behind, which Calcite doesn't make yet (CAL-175).
                if not o.conversion {
                    self.can_pick_up_loot = r.next_float() < 0.55f32 * special
                }
                if o.natural and o.camel_room and r.next_float() < 0.1f32 {
                    self.living.equipment[0] = some(stack_of(String("minecraft:iron_spear")))
                    self.living.show(Shown.Missing(String("A husk's camel husk and parched, as it spawns naturally")), 0)
                }
            } else if self.species == DROWNED {
                // `Drowned.finalizeSpawn`, after a zombie's: with nothing in its off hand, 3 in 100
                // a nautilus shell there, sure to drop; then spawned naturally or by a structure
                // holding a trident, by a draw under a half, grown, a zombie nautilus under it
                // where its biome isn't `#more_frequent_drowned_spawns`, which Calcite doesn't
                // make yet (CAL-175).
                if self.living.equipment[1] == none and r.next_float() < 0.03f32 {
                    self.living.equipment[1] = some(stack_of(String("minecraft:nautilus_shell")))
                    self.guarantee_drop(1)
                }
                let trident = held_name(self.living.equipment[0].copy()) == "minecraft:trident"
                if (o.natural or o.structure) and trident and r.next_float() < 0.5f32 and not self.baby() {
                    self.living.show(Shown.Missing(String("A drowned's zombie nautilus, as it spawns holding a trident")), 0)
                }
            }
        } else if self.skeletal() {
            self.populate_equipment(o, mut r)
            // A wither skeleton's equipment isn't enchanted, its
            // `populateDefaultEquipmentEnchantments` doing nothing (CAL-200).
            if self.species != WITHER_SKELETON {
                self.enchant_equipment(special, maker.world_loot(), mut r)
            }
            self.reassess_weapon(o.local.hard())
            self.can_pick_up_loot = r.next_float() < 0.55f32 * special
            self.halloween(o, mut r)
            if self.species == WITHER_SKELETON {
                // `WitherSkeleton.finalizeSpawn`, after a skeleton's: its attack damage 4, and
                // its weapon goal looked at again.
                self.living.attributes.set_base(attribute("attack_damage"), 4.0)
                self.reassess_weapon(o.local.hard())
            }
        } else if self.species == VINDICATOR {
            // `Vindicator.finalizeSpawn`, after `Mob`'s (CAL-200): out of a raid, an iron axe in its
            // main hand, then its equipment's enchanting's draws; opening doors till its first
            // step, `setCanOpenDoors`.
            self.navigation.can_open_doors = true
            if self.raid == none {
                self.living.equipment[0] = some(stack_of(String("minecraft:iron_axe")))
            }
            self.enchant_equipment(special, maker.world_loot(), mut r)
        } else if self.species == SPIDER {
            if r.next_int_below(100) == 0 {
                self.skeleton_jockey(o, mut maker, mut r)
            }
            if group == none {
                var g = SpawnGroup { spider: true }
                if o.local.hard() and r.next_float() < 0.1f32 * special {
                    g.effect = r.next_int_below(5)
                }
                group = some(g)
            }
            // The pack's effect, for ever (CAL-163).
            if let g = group {
                if g.spider and g.effect >= 0 {
                    let kinds: List<i32> = [SPEED, SPEED, STRENGTH, REGENERATION, INVISIBILITY]
                    maker.add_effect(mut self, ActiveEffect.new(kinds[usize.wrap(g.effect)], -1, 0))
                }
            }
        }
        return group
    }

    // `finalizeVillagerType`: where its villager data, at `at` in its values, isn't final, the
    // flag after it, its type the biome's where it's made, then final.
    fn finalize_villager_type(mut self, at: usize) {
        if self.living.data.flag(at + 1) {
            return
        }
        let (_, profession, level) = self.living.data.villager(at)
        self.living.data.set(at, Value.Villager(self.villager_type, profession, level))
        self.living.data.set(at + 1, Value.Bool(true))
    }

    // A baby zombie's jockey: 1 in 20 the first chicken in its box grown 5 across and 3 up and
    // down that it may ride, `ride_chicken_near` (D709); else 1 in 20 a new chicken, made where it
    // stands and turned as it is, finalized at `o` with no group, a jockey's mount, ridden,
    // `startRiding` (D708), and in the level before it.
    fn chicken_jockey<R: RandomSource, K: Making>(mut self, o: Occasion, maker: mut K, r: mut R) {
        if r.next_float() < 0.05f32 {
            let near = self.living.body.bounding_box().inflate(5.0, 3.0, 5.0)
            _ = maker.ride_chicken_near(mut self, near)
            return
        }
        if not (r.next_float() < 0.05f32) {
            return
        }
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        var chicken = maker.make_kind(CHICKEN, x, y, z, self.spawn_biome) else return
        chicken.living.snap_to(x, y, z, self.living.body.y_rot, 0.0f32)
        _ = chicken.finalize_spawn(none, o, mut maker, mut r)
        chicken.jockey = true
        board(mut self, mut chicken)
        maker.add_made(chicken)
    }

    // `ZombieHorse.finalizeSpawn`'s, spawned naturally: a zombie made where it stands and turned as
    // it is, finalized at `o` with no group, then holding an iron spear, riding it (D708), added
    // after it.
    fn zombie_rider<R: RandomSource, K: Making>(mut self, o: Occasion, maker: mut K, r: mut R) {
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        var zombie = maker.make_kind(ZOMBIE, x, y, z, self.spawn_biome) else return
        zombie.living.snap_to(x, y, z, self.living.body.y_rot, 0.0f32)
        _ = zombie.finalize_spawn(none, o, mut maker, mut r)
        zombie.living.equipment[0] = some(stack_of(String("minecraft:iron_spear")))
        board(mut zombie, mut self)
        maker.add_passenger(zombie)
    }

    // A spider's jockey: a skeleton made where it stands and turned as it is, finalized at `o`
    // with no group, riding it (D708), added after it.
    fn skeleton_jockey<R: RandomSource, K: Making>(mut self, o: Occasion, maker: mut K, r: mut R) {
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        var skeleton = maker.make_kind(SKELETON, x, y, z, self.spawn_biome) else return
        skeleton.living.snap_to(x, y, z, self.living.body.y_rot, 0.0f32)
        _ = skeleton.finalize_spawn(none, o, mut maker, mut r)
        board(mut skeleton, mut self)
        maker.add_passenger(skeleton)
    }

    // `populateDefaultEquipmentSlots`: by 15 in 100 of the special multiplier, armor of a tier
    // drawn from 0 to 2 and up one each of three times 1087 in 10,000, leather, copper, gold,
    // chainmail, iron then diamond, its head's first then, each after a quarter's draw, a tenth's
    // on hard, that it stops at, its chest's, legs' and feet's, each where it wears nothing. Then
    // a zombie's weapon, 1 in 100, 1 in 20 on hard, an iron sword, spear or shovel 4 in 6; and a
    // skeleton's bow.
    fn populate_equipment<R: RandomSource>(mut self, o: Occasion, r: mut R) {
        if self.species == ZOMBIFIED_PIGLIN {
            // `ZombifiedPiglin.populateDefaultEquipmentSlots`: a golden spear one in 20, else a
            // golden sword, and no armor drawn for (CAL-200).
            let spear = r.next_int_below(20) == 0
            self.living.equipment[0] = some(stack_of(String(if spear { "minecraft:golden_spear" } else { "minecraft:golden_sword" })))
            return
        }
        if self.species == WITHER_SKELETON {
            // `WitherSkeleton.populateDefaultEquipmentSlots`: a stone sword, and no armor drawn
            // for (CAL-200).
            self.living.equipment[0] = some(stack_of(String("minecraft:stone_sword")))
            return
        }
        if self.species == DROWNED {
            // `Drowned.populateDefaultEquipmentSlots`, no armor: by a draw over 0.9, a trident 10
            // in 16, else a fishing rod (CAL-175).
            if r.next_float() > 0.9f32 {
                let pick = r.next_int_below(16)
                self.living.equipment[0] = some(stack_of(String(if pick < 10 { "minecraft:trident" } else { "minecraft:fishing_rod" })))
            }
            return
        }
        if r.next_float() < 0.15f32 * o.local.special() {
            var tier = r.next_int_below(3)
            for _ in 0..3 {
                if r.next_float() < 0.1087f32 {
                    tier += 1
                }
            }
            let partial = if o.local.hard() { 0.1f32 } else { 0.25f32 }
            var first = true
            for slot in [5usize, 4usize, 3usize, 2usize] {
                if not first and r.next_float() < partial {
                    break
                }
                first = false
                if self.living.equipment[slot] == none {
                    if let item = armor_for(slot, tier) {
                        self.living.equipment[slot] = some(stack_of(item.copy()))
                    }
                }
            }
        }
        if self.zombie_class() {
            if r.next_float() < (if o.local.hard() { 0.05f32 } else { 0.01f32 }) {
                let pick = r.next_int_below(6)
                let weapon = if pick == 0 { "minecraft:iron_sword" } else if pick == 1 { "minecraft:iron_spear" } else { "minecraft:iron_shovel" }
                self.living.equipment[0] = some(stack_of(String(weapon)))
            }
        } else if self.skeletal() {
            self.living.equipment[0] = some(stack_of(String("minecraft:bow")))
        }
    }

    // `populateDefaultEquipmentEnchantments` (D522): the main hand's draw, a quarter by the special
    // multiplier, then each armor slot's, feet first, half by it, each where it holds something;
    // where one comes up, what it holds enchanted by `mob_spawn_equipment`,
    // `enchantItemFromProvider`, the world's loot `loot`'s (CAL-217), or only drawn for without it.
    fn enchant_equipment<R: RandomSource>(mut self, special: f32, loot: Shared<Loot>?, r: mut R) {
        for (slot, chance) in [(0usize, 0.25f32), (2usize, 0.5f32), (3usize, 0.5f32), (4usize, 0.5f32), (5usize, 0.5f32)] {
            if let held = self.living.equipment[slot].copy() {
                if r.next_float() < chance * special {
                    if let l = loot {
                        self.living.equipment[slot] = some(spawn_enchanted(l.value, mut r, held, special))
                    }
                }
            }
            if slot == 0 and self.species == PILLAGER and r.next_int_below(300) == 0 {
                // `Pillager.enchantSpawnedWeapon`, after `Mob`'s: 1 in 300 its crossbow enchanted
                // by `pillager_spawn_crossbow`, vanilla's piercing I (CAL-200, CAL-217).
                if held_name(self.living.equipment[0].copy()) == "minecraft:crossbow" {
                    if let l = loot {
                        if let s = self.living.equipment[0].take() {
                            self.living.equipment[0] = some(provider_enchanted(l.value, mut r, s, "minecraft:pillager_spawn_crossbow", special))
                        }
                    }
                }
            }
        }
    }

    // On Halloween, where its head is bare, 1 in 4 a pumpkin on it, a jack o'lantern 1 in 10, never
    // dropped.
    fn halloween<R: RandomSource>(mut self, o: Occasion, r: mut R) {
        if self.living.equipment[5] != none or not o.halloween {
            return
        }
        if not (r.next_float() < 0.25f32) {
            return
        }
        let lantern = r.next_float() < 0.1f32
        self.living.equipment[5] = some(stack_of(String(if lantern { "minecraft:jack_o_lantern" } else { "minecraft:carved_pumpkin" })))
        var chances = JavaHashMap<String, Tag>()
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(had) = self.kept["drop_chances"] {
                chances = had.copy()
            }
        }
        chances.insert(String("head"), Tag.Float(0.0f32))
        self.kept.insert(String("drop_chances"), Tag.Compound(chances))
    }

    // `Zombie.handleAttributes`, from its own random: its reinforcements' chance's base, up to a
    // tenth; its knockback resistance's random spawn bonus, up to a twentieth; its follow range's,
    // where a draw of 1.5 by the special multiplier is over 1, on its total; and, by a twentieth of
    // the multiplier, a leader's bonuses, a half to three quarters more reinforcements' chance and
    // its most health one to four times again, its health that where it's not what another's
    // turned into, `heal` (CAL-244), breaking doors.
    pub fn zombie_attributes(mut self, special: f32, heal: bool) {
        let reinforcements = attribute("spawn_reinforcements")
        // A zombified piglin's none, undrawn, `ZombifiedPiglin.randomizeReinforcementsChance`
        // (CAL-200).
        let base = if self.species == ZOMBIFIED_PIGLIN { 0.0 } else { self.living.body.random.next_double() * f64(0.1f32) }
        self.living.attributes.set_base(reinforcements, base)
        let knockback = attribute("knockback_resistance")
        let resist = self.living.body.random.next_double() * f64(0.05f32)
        self.add_or_replace(knockback, Modifier { id: Identifier { namespace: "minecraft", path: "random_spawn_bonus" }, amount: resist, operation: ADD_VALUE })
        let follow = self.living.body.random.next_double() * 1.5 * f64(special)
        if follow > 1.0 {
            self.add_or_replace(attribute("follow_range"), Modifier { id: Identifier { namespace: "minecraft", path: "zombie_random_spawn_bonus" }, amount: follow, operation: ADD_MULTIPLIED_TOTAL })
        }
        if self.living.body.random.next_float() < special * 0.05f32 {
            let more = self.living.body.random.next_double() * 0.25 + 0.5
            self.add_or_replace(reinforcements, Modifier { id: Identifier { namespace: "minecraft", path: "leader_zombie_bonus" }, amount: more, operation: ADD_VALUE })
            let health = self.living.body.random.next_double() * 3.0 + 1.0
            let most = attribute("max_health")
            self.add_or_replace(most, Modifier { id: Identifier { namespace: "minecraft", path: "leader_zombie_bonus" }, amount: health, operation: ADD_MULTIPLIED_TOTAL })
            if heal {
                self.living.data.set(HEALTH, Value.Float(f32.nearest(self.living.attributes.value(most))))
            }
            self.can_break_doors = true
            self.navigation.can_open_doors = true
        }
    }

    // `addOrReplacePermanentModifier` on `a`.
    fn add_or_replace(mut self, a: u32, m: Modifier) {
        self.living.attributes.take_off(a, m.id.copy())
        self.living.attributes.add_permanent(a, m)
    }

    // `setBaseValue` of the attribute `name`.
    fn set_base(mut self, name: str, base: f64) {
        let a = attribute_id(String(name)) ?? panic("no attribute {name}")
        _ = self.living.attributes.instance(a)
        self.living.attributes.set_base(a, base)
    }

    /// Its tick, as `tickNonPassenger` and `Mob.tick` run it among `blocks`, in a level whose floor
    /// is `min_y`, where lava's fast if `fast_lava`: `baseTick`, with its ambient sound now and
    /// then; its equipment's changes, as `items` reads them, `detectEquipmentUpdates`; `aiStep`, a horse's tail first, the ticks it's done nothing counted where it thinks,
    /// then its move, and after it an ageable mob's age, an animal's love, a chicken's slow fall
    /// and eggs, and a horse's healing and grazing; and its health kept within its most and its
    /// turns kept near. A door its brain swings is left for what holds it to swing, as nothing
    /// here can; its tick goes on past it.
    pub fn tick<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.species == PANDA {
            // Whether its level's thundering, which `isScared` reads all tick (CAL-201).
            self.panda.thunder = blocks.thundering()
        }
        let entered = self.tick_thinking(lf, f, m, t, blocks, items, mut cache, players, min_y, fast_lava, mut sounds)
        while self.tick_rest(entered, lf, f, m, t, blocks, items, mut cache, players, min_y, fast_lava, mut sounds) {}
    }

    /// Whether what it showed of its tick so far has an attack on a player or a mob, which its
    /// level deals before its tick goes on (CAL-159, CAL-244).
    pub fn attacked(self) -> bool {
        for w in self.living.shown {
            if let Shown.Attack(_) = w {
                return true
            }
            if let Shown.Beamed(_) = w {
                return true
            }
        }
        return false
    }

    /// Its tick up to and through its AI's goals, `serverAiStep`'s, where it may attack a player,
    /// which its level deals before `tick_rest` goes on with the rest of its AI, as vanilla's
    /// `doHurtTarget` comes before its navigation, its own step and its controls, then `travel` and
    /// `pushEntities` (CAL-159). Whether it wasn't gone as its `aiStep` began, which `tick_rest`
    /// is told.
    pub fn tick_thinking<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        // A creeper's explosion, which only its level makes, is left among what it showed where it
        // ticks on its own.
        _ = self.tick_start(lf, f, m, blocks, min_y, mut sounds)
        self.tick_using(lf, f, m, t, blocks, items, mut cache, players, min_y, fast_lava, mut sounds)
        // A spear's hits, which only its level deals, aren't dealt where it ticks on its own.
        self.stab_due = none
        return self.tick_thinking_on(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds)
    }

    /// Its own tick's start, before `Entity.tick`, as its kind's `tick` has it: an endermite's body
    /// turned, an enderman's hurt teleporting it, a skeleton freezing toward a stray, and a
    /// creeper swelling. Whether a creeper's fuse ran out, `explodeCreeper`, or a skeleton froze or
    /// a zombie villager's cure is done, which its level makes before `tick_using` goes on, as
    /// vanilla's explosion and conversions come before `super.tick()`, the effects its new self
    /// takes not yet ticked (CAL-182, CAL-280).
    pub fn tick_start<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.species == VEX {
            // `Vex.tick`'s, before the rest: no physics for its tick, through blocks (CAL-200).
            self.living.body.no_physics = true
        }
        if self.species == PUFFERFISH and self.living.alive() and not self.no_ai() {
            self.puff_tick(f, m, blocks, mut sounds)
        }
        if self.species == PARROT {
            // `ShoulderRidingEntity.tick`'s, before the rest: a tick more since it last sat on a
            // shoulder (CAL-201).
            self.parrot.ride_cooldown += 1
        }
        if self.species == ENDERMITE or self.species == SILVERFISH {
            // `Endermite.tick`'s and `Silverfish.tick`'s, before the rest: its body turned as it is
            // (D583, CAL-172).
            self.living.y_body_rot = self.living.body.y_rot
        }
        self.floor_y = min_y
        // An enderman's hurt between its ticks, as its level dealt it, teleports it now (CAL-159).
        self.hurt_teleport(lf, f, m, blocks, mut sounds)
        if self.species == SKELETON {
            // `Skeleton.tick`'s, before the rest: freezing toward a stray in the powder snow it
            // was in as its last tick's moves were done, then one, with level event 1048 (CAL-175).
            let frozen = self.living.body.in_powder_snow
            if self.convert_step(frozen, MONSTER_OWN, 140, 300) {
                self.living.show(Shown.Converted((STRAY, 1048)), sounds.len())
                return true
            }
        } else if self.species == ZOMBIE_VILLAGER {
            // `ZombieVillager.tick`'s, before the rest: alive and being cured, its cure counted
            // down by `getConversionProgress`, and at none it's cured into a villager, level event
            // 1027, `finishConversion`, which its level makes (CAL-175).
            if self.living.alive() and self.living.data.flag(MONSTER_OWN + 3) {
                self.cure_time -= self.cure_progress(lf, f, blocks)
                if self.cure_time <= 0 {
                    self.living.show(Shown.Converted((VILLAGER, 1027)), sounds.len())
                    return true
                }
            }
        } else if self.species == CREEPER {
            return self.swell_step(mut sounds)
        } else if self.species == SULFUR_CUBE {
            if self.sulfur_fuse_step(sounds) {
                return true
            }
            // `primeWhenOnPoweredPosition` (CAL-402): where it may explode, a signal at its block
            // primes it.
            if self.sulfur_can_explode() {
                let b = self.living.body.copy()
                if blocks.powered_at(floor_of(b.x), floor_of(b.y), floor_of(b.z)) {
                    _ = self.sulfur_prime(false, mut sounds)
                }
            }
        }
        return self.wants_knot(sounds.len())
    }

    // Where its leash was saved tied to a knot its level hasn't, the knot asked of its level by its
    // fence's place before its tick goes on, `getOrCreateKnot`, which `restoreLeashFromSave` makes
    // in its tick, for it to be tied to then (CAL-179).
    fn wants_knot(mut self, heard: usize) -> bool {
        if self.holding != none {
            return false
        }
        let at = self.saved_knot() else return false
        self.living.show(Shown.Knotted(at), heard)
        return true
    }

    // The fence's place its leash was saved tied to, till it's found (CAL-179).
    fn saved_knot(self) -> (i32, i32, i32)? {
        let l = self.leash else return none
        if l.holder != none {
            return none
        }
        let saved = l.saved else return none
        let Tag.IntArray(v) = saved else return none
        if v.len() != 3 {
            return none
        }
        return some((v[0], v[1], v[2]))
    }

    /// Its tick after its start, `tick_start`, up to and through its use of what it holds,
    /// `updatingUsingItem`, where a spear's use may ask its level to deal its hits, `stab_due`,
    /// which its level deals before `tick_thinking_on` goes on, as vanilla's `damageEntities` comes
    /// before the rest of its tick (CAL-159).
    pub fn tick_using<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.swim_wish(players)
        self.air_before = self.living.air()
        self.base_tick(lf, f, m, t, blocks, items, mut cache, min_y, fast_lava, players, mut sounds)
        self.base_tick_end(lf, blocks, items, mut sounds)
        if let left = self.living.updating_using() {
            self.kinetic_tick(left)
            self.crossbow_use_tick(left, mut sounds)
        }
    }

    // `KineticWeapon.damageEntities` up to the entities its use meets, `left` the ticks its use
    // had left as it ticked (CAL-159): where it's using a spear, once its use is past the delay,
    // what it asks of its level, `stab_due`: the ticks past it, its eyes, its look and its head's,
    // its speed, `getMotion`, its known speed 20 times over, as it rides nothing, its motion, its
    // reach with the spear, and the base of its attack damage, `getAttributeBaseValue`.
    fn kinetic_tick(mut self, left: i32) {
        let k = self.living.use_kinetic else return
        let used = 72000 - left
        if used < k.delay {
            return
        }
        let (sx, sy, sz) = (self.living.body.known_dx, self.living.body.known_dy, self.living.body.known_dz)
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        let (x_rot, y_rot) = (self.living.body.x_rot, self.living.body.y_rot)
        self.stab_due = some(StabDue {
            ticks: used - k.delay,
            eye: (x, y + f64(self.living.body.eyes), z),
            look: view_vector(x_rot, y_rot),
            head_look: view_vector(x_rot, self.living.y_head_rot),
            speed: (sx * 20.0, sy * 20.0, sz * 20.0),
            movement: (self.living.body.vx, self.living.body.vy, self.living.body.vz),
            reach: self.held_reach ?? reach_of(none),
            kinetic: k,
            base_damage: self.living.attributes.base(attribute_id(String("attack_damage")) ?? 0),
        })
    }

    // The end of its `baseTick`, after `base_tick` and before its use of what it holds, as
    // `Mob.baseTick` and `WaterAnimal.baseTick` end it (CAL-200): its ambient sound, by a draw under
    // 1000 against how long it's been quiet, `ambientSoundTime`; and a water animal's air.
    fn base_tick_end<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        if self.living.alive() {
            let drawn = self.living.body.random.next_int_below(1000)
            let due = drawn < self.ambient_sound_time
            self.ambient_sound_time += 1
            if due {
                self.ambient_sound_time = -self.ambient_interval
                var held = self.ambient_now()
                var loud = false
                if self.species == ENDERMAN and self.living.data.flag(MONSTER_OWN + 1) {
                    // `Enderman.getAmbientSound`: creepy, it screams.
                    held = some(String("entity.enderman.scream"))
                } else if self.species == ZOMBIFIED_PIGLIN and self.angry() {
                    // `ZombifiedPiglin.getAmbientSound`, angry (CAL-200).
                    held = some(String("entity.zombified_piglin.angry"))
                } else if self.species == DROWNED and self.living.body.in_water {
                    // `Drowned.getAmbientSound` in water, `isInWater` (CAL-175).
                    held = some(String("entity.drowned.ambient_water"))
                } else if self.species == DOLPHIN and self.living.body.in_water {
                    // `Dolphin.getAmbientSound` in water (CAL-201).
                    held = some(String("entity.dolphin.ambient_water"))
                } else if self.guardian_kind() and not self.living.body.in_water {
                    // `Guardian.getAmbientSound` out of water, and an elder's (CAL-200).
                    held = some(String(if self.species == ELDER_GUARDIAN { "entity.elder_guardian.ambient_land" } else { "entity.guardian.ambient_land" }))
                } else if self.species == SHULKER and self.shulker_raw_peek() == 0 {
                    // `Shulker.playAmbientSound`: none while it's closed (CAL-200).
                    held = none
                } else if self.species == WOLF {
                    held = some(self.wolf_ambient())
                } else if self.species == CAT {
                    held = some(self.cat_ambient())
                } else if self.species == PARROT {
                    held = some(self.parrot_ambient(sounds.len()))
                } else if self.species == BAT and self.bat_resting() and self.living.body.random.next_int_below(4) != 0 {
                    // `Bat.getAmbientSound`: resting, none three times in 4, drawn (CAL-201).
                    held = none
                } else if self.species == TURTLE {
                    // `Turtle.getAmbientSound`: grown, on the ground and out of water, its land
                    // one, else none (CAL-201).
                    held = if not self.living.body.in_water and self.living.body.on_ground and not self.baby() { some(String("entity.turtle.ambient_land")) } else { none }
                } else if self.species == FOX {
                    // `Fox.playAmbientSound`: its screech twice as loud; else `Mob`'s, which asks
                    // for its sound again, drawn again by night (CAL-311).
                    let first = self.fox_ambient(blocks)
                    loud = first == "entity.fox.screech"
                    held = some(if loud { first } else { self.fox_ambient(blocks) })
                } else if self.species == HOGLIN {
                    // `Hoglin.getAmbientSound`: its activity's, `getSoundForCurrentActivity`
                    // (CAL-200).
                    held = self.hoglin_sound(blocks)
                } else if self.species == ZOGLIN {
                    // `Zoglin.getAmbientSound`: angry with a target, else its ambient one (CAL-200).
                    held = some(String(if self.brain_target() != none { "entity.zoglin.angry" } else { "entity.zoglin.ambient" }))
                } else if self.species == PIGLIN_BRUTE and not self.brain_active(ACTIVITY_IDLE) {
                    // `AbstractPiglin.playAmbientSound`: only while idle, `PiglinAi.isIdle` (CAL-200).
                    held = none
                } else if self.species == PIGLIN {
                    // `AbstractPiglin.playAmbientSound`: only while idle, `PiglinAi.isIdle`; its
                    // activity's, `Piglin.getAmbientSound` (CAL-200).
                    held = if self.brain_active(ACTIVITY_IDLE) { self.piglin_sound(blocks) } else { none }
                }
                if let sound = held {
                    // A fox's first screech twice as loud, `Fox.playAmbientSound` (CAL-201).
                    let volume = if loud { 2.0f32 } else { self.sound_volume }
                    let pitch = self.voice_pitch()
                    self.living.play(mut sounds, sound, volume, pitch)
                }
            }
        }
        // A water animal's air, `WaterAnimal.handleAirSupply`, the last of its `baseTick`: out of
        // water it runs out and it drowns, hurt by 2, no entity event with it (CAL-178).
        if water_kind(self.species) and self.species != DOLPHIN and self.living.water_animal_air(self.air_before) {
            self.hurt_self(lf, blocks, items, "drown", 2.0f32, mut sounds)
        }
    }

    /// The rest of its tick up to and through its AI's goals, after `tick_using` (CAL-159), as
    /// `tick_thinking` has it.
    pub fn tick_thinking_on<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        self.living.arrows_tick()
        if self.species == SULFUR_CUBE {
            let previous = self.living.last_worn(BODY_SLOT)
            if not same_stack(previous.copy(), self.living.equipment[BODY_SLOT].copy()) {
                self.sulfur_body_changed(previous, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
            }
        }
        self.living.detect_equipment(items, sounds.len())
        // `LivingEntity.tick`'s, before its `aiStep`: where it sleeps but can't act on its level
        // any more or its bed's gone, `checkBedExists`, it gets up (CAL-160).
        if let at = self.living.sleeping {
            let (bx, by, bz) = at
            if not self.living.alive() or self.living.body.removed or bed_sleep_height(f, m, blocks, bx, by, bz) == none {
                self.wake_now(f, m, blocks, sounds)
            }
        }
        if self.living.body.removed {
            return false
        }
        if self.species == ENDER_DRAGON {
            // Its own `aiStep`, none of a mob's, so it isn't said to have entered a mob's (D608).
            self.dragon_step(lf, f, m, blocks, players, min_y, sounds.len())
            return false
        }
        if self.species == PARROT {
            self.parrot_ai_start(mut sounds)
        }
        if self.species == BLAZE and not self.living.body.on_ground and self.living.body.vy < 0.0 {
            // `Blaze.aiStep`'s, before the rest (CAL-200): falling, it keeps 0.6 of its fall. Its
            // burning sound and smoke only clients make.
            self.living.body.vy = self.living.body.vy * 0.6
        }
        if fish_kind(self.species) and not self.living.body.in_water and self.living.body.on_ground and self.living.body.vertical_collision {
            // `AbstractFish.aiStep`'s, before the rest (CAL-178): out of water on the ground, it
            // flops, up 0.4 and up to 0.05 either way across, drawn, off the ground, synced, with
            // its flop's sound.
            let ax = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.05f32
            let az = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.05f32
            self.living.body.vx = self.living.body.vx + f64(ax)
            self.living.body.vy = self.living.body.vy + f64(0.4f32)
            self.living.body.vz = self.living.body.vz + f64(az)
            self.living.body.on_ground = false
            self.living.body.needs_sync = true
            let pitch = self.voice_pitch()
            self.living.play(mut sounds, String(if self.species == SALMON { "entity.salmon.flop" } else if self.species == TROPICAL_FISH { "entity.tropical_fish.flop" } else if self.species == PUFFERFISH { "entity.puffer_fish.flop" } else { "entity.cod.flop" }), self.sound_volume, pitch)
        }
        if self.guardian_kind() and self.living.alive() {
            // `Guardian.aiStep`'s, before the rest (CAL-200): in water its air full; else on the
            // ground it flops, up 0.5 and up to 0.4 either way across, drawn, turned anywhere,
            // drawn, off the ground, synced, its flop's sound its client's. With a target for its
            // beam, it turns its body as its head is.
            if self.living.body.in_water {
                self.living.set_air(300)
            } else if self.living.body.on_ground {
                let ax = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.4f32
                let az = (self.living.body.random.next_float() * 2.0f32 - 1.0f32) * 0.4f32
                self.living.body.vx = self.living.body.vx + f64(ax)
                self.living.body.vy = self.living.body.vy + 0.5
                self.living.body.vz = self.living.body.vz + f64(az)
                self.living.body.y_rot = self.living.body.random.next_float() * 360.0f32
                self.living.body.on_ground = false
                self.living.body.needs_sync = true
            }
            if self.living.data.number(MONSTER_OWN + 1) != 0 {
                self.living.body.y_rot = self.living.y_head_rot
            }
        }
        if self.species == WITHER_BOSS {
            self.wither_ai_start(lf, players)
        }
        let horse = self.equine()
        if horse {
            // `AbstractHorse.aiStep`: its tail swishes 1 in 200, which only clients show.
            _ = self.living.body.random.next_int_below(200)
        }
        if self.species == FOX {
            self.fox_ai_start(items, players, mut sounds)
        }
        // `LivingEntity.aiStep` as it begins: what a player steers, which only their client
        // moves, `canSimulateMovement`, slows by 0.98 (CAL-179).
        if self.player_controller(players) != none {
            self.living.body.vx = self.living.body.vx * 0.98
            self.living.body.vy = self.living.body.vy * 0.98
            self.living.body.vz = self.living.body.vz * 0.98
        }
        if self.species == ENDERMAN {
            // `Enderman.aiStep`'s, before the rest: its anger kept up, `updatePersistentAnger`.
            self.update_anger(players, true)
        }
        if self.species == WITCH {
            self.witch_step(lf, players, mut sounds)
            // `Raider.updateNoActionTime`, in any light.
            self.no_action_time += 2
        } else if raider_kind(self.species) {
            self.no_action_time += 2
        } else if self.monster and self.magic_light(blocks) > 0.5f32 {
            // `Monster.updateNoActionTime`, in light.
            self.no_action_time += 2
        }
        // `isImmobile`: dying, or a horse that's eating or standing, which thinks of nothing even
        // dying as no one rides it, or a ravager attacking, stunned or roaring, `Ravager.isImmobile`
        // (CAL-200).
        let immobile = if self.species == LLAMA { self.living.dead_or_dying() or self.horse_flag(16) } else if horse { self.horse_flag(16) or self.horse_flag(32) } else { self.living.dead_or_dying() or self.ravager_busy() }
        let thinks = self.living.ai_start_as(immobile) and not self.no_ai()
        if thinks {
            self.no_action_time += 1
            if self.monster {
                self.read_held(items)
            }
            self.think(lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        }
        return true
    }

    /// Whether a wither's at half its health or less, `isPowered` (CAL-401).
    pub fn wither_powered(self, lf: LivingFacts) -> bool {
        return self.living.health() <= self.living.max_health(lf) / 2.0f32
    }

    /// `makeInvulnerable` (CAL-401), as a wither's built: 220 ticks invulnerable, its bar none of
    /// the way, its health a third of its most.
    pub fn make_invulnerable(mut self, lf: LivingFacts) {
        self.living.data.set(MONSTER_OWN + 3, Value.Number(220))
        self.wither.progress = 0.0f32
        self.living.body.bar_progress = 0.0f32
        let most = self.living.max_health(lf)
        self.living.set_health(lf, most / 3.0f32)
    }

    // `WitherBoss.aiStep` before `super.aiStep` (CAL-401): its motion's fall kept 0.6 of; with a
    // target for its middle head, `getAlternativeTarget(0)`, that it finds, rising, 0.3 less 0.6 of
    // its rise, from no fall, where it's below it, or below 5 over it while not powered; and more
    // than 3 across from it, a push of 0.3 toward it less 0.6 of its motion across. Its motion
    // set, and moving across faster than the root of 0.05, turned the way it goes.
    fn wither_ai_start(mut self, lf: LivingFacts, players: List<Follower>) {
        let vx0 = self.living.body.vx
        let vz0 = self.living.body.vz
        var vx = vx0
        var vy = self.living.body.vy * 0.6
        var vz = vz0
        let at = self.living.data.number(MONSTER_OWN)
        if at > 0 {
            if let e = self.followed(players, at) {
                let y = self.living.body.y
                if y < e.y or (not self.wither_powered(lf) and y < e.y + 5.0) {
                    vy = if vy > 0.0 { vy } else { 0.0 }
                    vy = vy + (0.3 - vy * f64(0.6f32))
                }
                let dx = e.x - self.living.body.x
                let dz = e.z - self.living.body.z
                if dx * dx + dz * dz > 9.0 {
                    let len = (dx * dx + dz * dz).sqrt()
                    let (sx, sz) = if len < 1.0e-5 { (0.0, 0.0) } else { (dx / len, dz / len) }
                    vx = vx + (sx * 0.3 - vx * 0.6)
                    vz = vz + (sz * 0.3 - vz * 0.6)
                }
            }
        }
        self.living.body.vx = vx
        self.living.body.vy = vy
        self.living.body.vz = vz
        if vx * vx + vz * vz > 0.05 {
            self.living.body.y_rot = f32.nearest(table_atan2(vz, vx) ?? 0.0) * f32.nearest(RAD_TO_DEG) - 90.0f32
        }
    }

    // A wither's head `i`, 0 its middle, `getHeadX`, `getHeadY` and `getHeadZ` (CAL-401): the
    // middle at its feet across and 3 up; a side one 1.3 out each way from its body's turn, 2.2 up;
    // each by its scale.
    fn wither_head(self, i: i32) -> (f64, f64, f64) {
        let scale = self.scale()
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        let hy = y + f64((if i <= 0 { 3.0f32 } else { 2.2f32 }) * scale)
        if i <= 0 {
            return (x, hy, z)
        }
        let a = (self.living.y_body_rot + f32.nearest(f64(180 * (i - 1)))) * 0.017453292f32
        return (x + f64(table_cos(f64(a))) * 1.3 * f64(scale), hy, z + f64(table_sin(f64(a))) * 1.3 * f64(scale))
    }

    // `WitherBoss.aiStep` after `super.aiStep` (CAL-401): its side heads turned toward their
    // targets' eyes, 40 a tick up or down and 10 across, else across toward its body's turn, which
    // only clients see but which its client keeps; then each head's smoke drawn, three from its own
    // random, and, powered, its effect's one in 4, drawn from its level's random, and three more;
    // and while it's invulnerable, three of its effect's about it, each drawn, all of which only
    // clients show.
    fn wither_ai_end(mut self, lf: LivingFacts, players: List<Follower>, heard: usize) {
        for i in 0..2 {
            let id = self.living.data.number(MONSTER_OWN + usize.wrap(i) + 1)
            var e: Follower? = none
            if id > 0 {
                e = self.followed(players, id)
            }
            if let t = e {
                let (hx, hy, hz) = self.wither_head(i + 1)
                let xd = t.x - hx
                let yd = t.y + f64(t.eyes) - hy
                let zd = t.z - hz
                let sd = (xd * xd + zd * zd).sqrt()
                let y_rot_d = f32.nearest((table_atan2(zd, xd) ?? 0.0) * 180.0 / f64(3.1415927f32)) - 90.0f32
                let x_rot_d = f32.nearest(-((table_atan2(yd, sd) ?? 0.0) * 180.0 / f64(3.1415927f32)))
                self.wither.x_rot_heads[usize.wrap(i)] = mob_rotlerp(self.wither.x_rot_heads[usize.wrap(i)], x_rot_d, 40.0f32)
                self.wither.y_rot_heads[usize.wrap(i)] = mob_rotlerp(self.wither.y_rot_heads[usize.wrap(i)], y_rot_d, 10.0f32)
            } else {
                self.wither.y_rot_heads[usize.wrap(i)] = mob_rotlerp(self.wither.y_rot_heads[usize.wrap(i)], self.living.y_body_rot, 10.0f32)
            }
        }
        let powered = self.wither_powered(lf)
        for _ in 0..3 {
            for _ in 0..3 {
                _ = self.living.body.random.next_gaussian()
            }
            if powered {
                let lent = self.level_random.take()
                let had = lent != none
                if not had {
                    self.living.show(Shown.Missing(String("A powered wither's particles without its level's random")), heard)
                }
                var random = lent ?? TapedRandom.new(0i64)
                let shown = random.next_int_below(4) == 0
                if had {
                    self.level_random = some(random)
                }
                if shown {
                    for _ in 0..3 {
                        _ = self.living.body.random.next_gaussian()
                    }
                }
            }
        }
        if self.wither_invulnerable() > 0 {
            for _ in 0..3 {
                _ = self.living.body.random.next_gaussian()
                _ = self.living.body.random.next_float()
                _ = self.living.body.random.next_gaussian()
            }
        }
    }

    // `WitherBoss.customServerAiStep` (CAL-401). Invulnerable: a tick less of it, its bar that much
    // further along; at its last, an explosion of 7 at its eyes by it, `explode`, which its level
    // makes, and its global level event 1023 where it isn't silent; healed 10 every 10th tick.
    // Else a mob's step, which is none, then each side head's look, `nextHeadUpdate`, every 10 to 19
    // ticks, drawn: on normal or hard, after 15 looks with nothing shot, a skull at a place drawn
    // within 10 across and 5 up or down of it, a blue one; with a target it may still attack,
    // within 30 and in sight, a skull at it and its next look 40 to 59 ticks on, drawn; else its
    // target let go; with none, one drawn of the living things it may attack within 20 across and
    // 8 up or down. Its middle head's target its own; the blocks about it broken, with mob
    // griefing on, as the ticks after it was hurt run out, which its level does; healed 1 every
    // 20th tick; and its bar as far along as its health is of its most. Whether it stopped for its
    // level to break the blocks then and there, before it moves, to go on with `wither_step_end`.
    fn wither_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, heard: usize) -> bool {
        let inv = self.wither_invulnerable()
        if inv > 0 {
            let next = inv - 1
            self.wither_progress(1.0f32 - f32.nearest(f64(next)) / 220.0f32, heard)
            if next <= 0 {
                let c = Creep { x: self.living.body.x, y: self.living.body.y + f64(self.living.body.eyes), z: self.living.body.z, radius: 7.0f32, uuid: self.living.body.uuid, silent: self.living.data.flag(SILENT), effects: List<Tag>() }
                self.living.show(Shown.Blasted(c), heard)
                if not self.living.silent() {
                    let (bx, by, bz) = self.block_position()
                    self.living.show(Shown.Global((1023, bx, by, bz, 0)), heard)
                }
            }
            self.living.data.set(MONSTER_OWN + 3, Value.Number(next))
            if self.living.body.tick_count % 10 == 0 {
                self.living.heal(lf, 10.0f32)
            }
            return false
        }
        let ticks = self.living.body.tick_count
        for i in 1..3 {
            let k = usize.wrap(i - 1)
            if ticks < self.wither.next_head_update[k] {
                continue
            }
            self.wither.next_head_update[k] = ticks + 10 + self.living.body.random.next_int_below(10)
            if self.difficulty >= 2 {
                let idle = self.wither.idle_head_updates[k]
                self.wither.idle_head_updates[k] = idle + 1
                if idle > 15 {
                    let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    let xt = mth_next_double(mut self.living.body.random, x - 10.0, x + 10.0)
                    let yt = mth_next_double(mut self.living.body.random, y - 5.0, y + 5.0)
                    let zt = mth_next_double(mut self.living.body.random, z - 10.0, z + 10.0)
                    self.wither_shoot(i + 1, xt, yt, zt, true, heard)
                    self.wither.idle_head_updates[k] = 0
                }
            }
            let target = self.living.data.number(MONSTER_OWN + usize.wrap(i))
            if target > 0 {
                var shot = false
                if let p = self.followed(players, target) {
                    let me = self.looker()
                    let attackable = not p.creative and not p.spectator and not p.dead and p.enemy
                    if attackable and not (self.distance_sqr_to(p.x, p.y, p.z) > 900.0) and sees(m, f, blocks, me.mover, me.x, me.eye_y, me.z, p.x, p.y + f64(p.eyes), p.z) {
                        self.wither_shoot_at(i + 1, p, heard)
                        self.wither.next_head_update[k] = ticks + 40 + self.living.body.random.next_int_below(20)
                        self.wither.idle_head_updates[k] = 0
                        shot = true
                    }
                }
                if not shot {
                    self.living.data.set(MONSTER_OWN + usize.wrap(i), Value.Number(0))
                }
            } else {
                let found = self.wither_near(m, f, blocks, players)
                if not found.is_empty() {
                    let pick = found[usize.wrap(self.living.body.random.next_int_below(i32.wrap(found.len())))]
                    self.living.data.set(MONSTER_OWN + usize.wrap(i), Value.Number(pick))
                }
            }
        }
        self.living.data.set(MONSTER_OWN, Value.Number(self.target ?? 0))
        if self.wither.destroy_blocks_tick > 0 {
            self.wither.destroy_blocks_tick -= 1
            if self.wither.destroy_blocks_tick == 0 and self.mob_griefing {
                let width = floor_of(f64(self.living.body.width / 2.0f32 + 1.0f32))
                let height = floor_of(f64(self.living.body.height))
                let (bx, by, bz) = self.block_position()
                self.living.show(Shown.WitherBroke((bx, by, bz, width, height)), heard)
                return true
            }
        }
        self.wither_step_end(lf, heard)
        return false
    }

    // The end of a wither's `customServerAiStep` (CAL-401): healed 1 every 20th tick, and its bar
    // as far along as its health is of its most.
    fn wither_step_end(mut self, lf: LivingFacts, heard: usize) {
        if self.living.body.tick_count % 20 == 0 {
            self.living.heal(lf, 1.0f32)
        }
        let most = self.living.max_health(lf)
        let health = self.living.health()
        self.wither_progress(health / most, heard)
    }

    // `ServerBossEvent.setProgress` of a wither's bar (CAL-401): where it changed, those who see it
    // sent it, which its level does.
    fn wither_progress(mut self, p: f32, heard: usize) {
        if p == self.wither.progress {
            return
        }
        self.wither.progress = p
        self.living.body.bar_progress = p
        self.living.show(Shown.BarProgress(p), heard)
    }

    // `getNearbyEntities` of the living things a wither's side heads may take up (CAL-401), in its
    // box grown 20 across and 8 up or down, `TARGETING_CONDITIONS`: those it may see as enemies,
    // not undead, within 20 as their visibility scales it, in its sight, `Sensing`. Its level's mobs
    // first, then its players.
    fn wither_near<B: CollisionBlocks>(mut self, m: MovementStates, f: Facts, blocks: B, players: List<Follower>) -> List<i32> {
        let b = self.living.body.bounding_box()
        let me = self.looker()
        var out = List<i32>()
        var all = List<Follower>()
        for p in self.prey {
            if not undead_kind(p.species) {
                all.push(p.copy())
            }
        }
        for p in players {
            all.push(p.copy())
        }
        for p in all {
            if p.id == me.id or p.spectator or p.dead or not p.enemy {
                continue
            }
            if p.x < b.min_x - 20.0 or p.x > b.max_x + 20.0 or p.y < b.min_y - 8.0 or p.y > b.max_y + 8.0 or p.z < b.min_z - 20.0 or p.z > b.max_z + 20.0 {
                continue
            }
            let visibility = p.visibility(me.kind)
            let within = if 20.0 * visibility > 2.0 { 20.0 * visibility } else { 2.0 }
            let dx = me.x - p.x
            let dy = me.y - p.y
            let dz = me.z - p.z
            if dx * dx + dy * dy + dz * dz > within * within {
                continue
            }
            if not sees_player(m, f, blocks, mut self.sensing, me, p) {
                continue
            }
            out.push(p.id)
        }
        return out
    }

    // `performRangedAttack(head, target)` (CAL-401): a skull from the head `head` at a place half
    // its eyes up `p`, a blue one where it's the middle head's, one in 1,000, drawn.
    fn wither_shoot_at(mut self, head: i32, p: Follower, heard: usize) {
        let dangerous = head == 0 and self.living.body.random.next_float() < 0.001f32
        self.wither_shoot(head, p.x, p.y + f64(p.eyes) * 0.5, p.z, dangerous, heard)
    }

    // `performRangedAttack(head, x, y, z, dangerous)` (CAL-401): its level event 1024 where it isn't
    // silent; a wither skull from the head toward x, y, z, `new WitherSkull`, owned by it, turned as
    // it is, which its level makes.
    fn wither_shoot(mut self, head: i32, tx: f64, ty: f64, tz: f64, dangerous: bool, heard: usize) {
        if not self.living.silent() {
            let (bx, by, bz) = self.block_position()
            self.living.show(Shown.Level((1024, bx, by, bz, 0)), heard)
        }
        let (hx, hy, hz) = self.wither_head(head)
        let shot = FireballFired { owner: self.living.body.uuid, x: hx, y: hy, z: hz, xd: tx - hx, yd: ty - hy, zd: tz - hz, yaw: self.living.body.y_rot, pitch: self.living.body.x_rot, kind: WITHER_SKULL, dangerous: dangerous }
        self.living.show(Shown.FireballFired(shot), heard)
    }

    /// A wither's invulnerable ticks, `getInvulnerableTicks`, its `DATA_ID_INV` (CAL-401); 0 for
    /// any other.
    pub fn wither_invulnerable(self) -> i32 {
        if self.species != WITHER_BOSS {
            return 0
        }
        return self.living.data.number(MONSTER_OWN + 3)
    }

    /// Whether it's a ravager kept still by its attack, its stun or its roar, as
    /// `Ravager.isImmobile` adds (CAL-200).
    pub fn ravager_busy(self) -> bool {
        return self.species == RAVAGER and (self.attack_tick > 0 or self.stunned_tick > 0 or self.roar_tick > 0)
    }

    // `Ravager.aiStep`, after `super.aiStep` (CAL-200), alive: its movement speed's base 0 while
    // it's kept still, else a tenth of the way to 0.35 with a target or to 0.3 without,
    // `Mth.lerp`; where it ran into something across and mob griefing's on, the leaves in its box
    // 0.2 larger, `LeavesBlock`'s, in `BlockPos.betweenClosed`'s order, x then y then z, broken
    // with their drops, by it, which its level does, `Shown.Ravaged`, and where there were none,
    // a jump from the ground, on it. Then its roar's, its attack's and its stun's ticks counted
    // down: its roar at the 10th left, `roar`; stunned, its stun's particle 1 in 6, drawn, its
    // place drawn, which only clients show, `stunEffect`; and as its stun ends, its roar heard,
    // and 20 ticks of roaring, its roar's blow on what's near it its level's, `Shown.Roared`
    // (CAL-214); its sight's none while stunned or roaring,
    // `hasLineOfSight`, but then it's kept still and thinks of nothing.
    fn ravager_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, sounds: mut List<EntitySound>) {
        if not self.living.alive() {
            return
        }
        let speed = lf.movement_speed
        if self.ravager_busy() {
            self.living.attributes.set_base(speed, 0.0)
        } else {
            let most = if self.target != none { 0.35 } else { 0.3 }
            let base = self.living.attributes.base(speed)
            self.living.attributes.set_base(speed, base + 0.1 * (most - base))
        }
        if self.living.body.horizontal_collision and self.mob_griefing {
            let b = self.living.body.bounding_box().inflate(0.2, 0.2, 0.2)
            var leaves = List<(i32, i32, i32)>()
            for z in floor_of(b.min_z)..=floor_of(b.max_z) {
                for y in floor_of(b.min_y)..=floor_of(b.max_y) {
                    for x in floor_of(b.min_x)..=floor_of(b.max_x) {
                        if let state = blocks.collision_state(x, y, z) {
                            if f.is_a(f.block(state), String("LeavesBlock")) {
                                leaves.push((x, y, z))
                            }
                        }
                    }
                }
            }
            if not leaves.is_empty() {
                self.living.show(Shown.Ravaged(leaves), sounds.len())
            } else if self.living.body.on_ground {
                self.living.jump_from_ground(lf, f, m, t, blocks)
            }
        }
        if self.roar_tick > 0 {
            self.roar_tick -= 1
            if self.roar_tick == 10 {
                self.living.show(Shown.Roared, sounds.len())
            }
        }
        if self.attack_tick > 0 {
            self.attack_tick -= 1
        }
        if self.stunned_tick > 0 {
            self.stunned_tick -= 1
            if self.living.body.random.next_int_below(6) == 0 {
                _ = self.living.body.random.next_double()
                _ = self.living.body.random.next_double()
            }
            if self.stunned_tick == 0 {
                self.living.play(mut sounds, String("entity.ravager.roar"), 1.0f32, 1.0f32)
                self.roar_tick = 20
            }
        }
    }

    /// The player who steers it, `getControllingPassenger() instanceof Player` (CAL-179): the
    /// first riding it, among `players`, of a saddled horse, `AbstractHorse`'s, or of a saddled
    /// pig where they hold a carrot on a stick, `Pig`'s; none for what else Calcite has.
    pub fn player_controller(self, players: List<Follower>) -> Follower? {
        let rider = self.player_rider else return none
        for p in players {
            if p.uuid == some(rider) {
                return if self.player_steers(p.id, p.steers_pigs) { some(p.copy()) } else { none }
            }
        }
        return none
    }

    /// Whether the player `id` steers it, holding a carrot on a stick or not, `steers_pigs`, as
    /// `player_controller` has it (CAL-179).
    pub fn player_steers(self, id: i32, steers_pigs: bool) -> bool {
        if self.player_rider == none or self.living.equipment[7] == none or self.living.body.passengers.is_empty() {
            return false
        }
        if not self.equine() and self.species != PIG {
            return false
        }
        return self.living.body.passengers[0] == id and (self.species != PIG or steers_pigs)
    }

    /// `travelRidden` for the player `p` who steers it, alive (CAL-179): `tickRidden`, turned as
    /// they look, its pitch half theirs, `getRiddenRotation`, `Pig.tickRidden`, its body and head
    /// with it and there last tick too; then still, as only their client moves it,
    /// `canSimulateMovement`. A horse's jump is its client's, `isLocalInstanceAuthoritative`.
    fn tick_ridden(mut self, p: Follower) {
        let y_rot = p.yaw
        let x_rot = p.x_rot * 0.5f32
        self.living.body.y_rot = y_rot
        self.living.body.x_rot = x_rot
        self.living.y_rot_o = y_rot
        self.living.y_body_rot = y_rot
        self.living.y_head_rot = y_rot
        self.living.body.vx = 0.0
        self.living.body.vy = 0.0
        self.living.body.vz = 0.0
        // A pig's boost counted, over once it's gone past its whole time, `tickBoost`.
        if self.species == PIG and self.boosting {
            let was = self.boost_time
            self.boost_time += 1
            if was > self.living.data.number(OWN) {
                self.boosting = false
            }
        }
    }

    /// `Pig.boost`, `ItemBasedSteering.boost` (CAL-179): none while it's boosting; else it boosts
    /// from now for 140 to 980 ticks, drawn from its random, its whole time set in its data.
    /// Whether it began.
    /// A donkey's chest's columns, `getInventoryColumns`: 5 with a chest on, else none (CAL-179).
    pub fn mount_columns(self) -> i32 {
        // A llama's its strength (CAL-201).
        if self.species == LLAMA and self.living.data.flag(OWN + 1) {
            return self.llama_strength()
        }
        return if self.species == DONKEY and self.living.data.flag(OWN + 1) { 5 } else { 0 }
    }

    /// `createInventory` (CAL-179): its chest's slots made again for its columns, keeping what
    /// fits of what was in them.
    fn create_inventory(mut self) {
        let size = usize.wrap(self.mount_columns() * 3)
        var made = List<Tag?>()
        for i in 0..size {
            made.push(if i < self.chest_items.len() { self.chest_items[i].copy() } else { none })
        }
        self.chest_items = made
    }

    /// `AbstractChestedHorse.dropEquipment` (CAL-179): what's in its chest's slots, but what's
    /// cursed with vanishing, `prevent_equipment_drop`, then the chest, taken off, `setChest`.
    pub fn inventory_drops<W: Wearing>(mut self, items: W) -> List<Tag> {
        var out = List<Tag>()
        for held in self.chest_items {
            if let stack = held {
                if not vanishes(items, stack.copy()) {
                    out.push(stack.copy())
                }
            }
        }
        if self.chested() and self.living.data.flag(OWN + 1) {
            var chest = JavaHashMap<String, Tag>()
            chest.insert(String("id"), Tag.Str(String("minecraft:chest")))
            chest.insert(String("count"), Tag.Int(1))
            out.push(Tag.Compound(chest))
            self.living.data.set(OWN + 1, Value.Bool(false))
        }
        return out
    }

    /// `handleStartJump` of a horse its rider jumps, `START_RIDING_JUMP` (CAL-179), where it can,
    /// `canJump`, saddled, and the jump has strength, its data above 0: it stands, not eating,
    /// for 20 ticks, `standIfPossible`, and its jump sound plays, quiet, a donkey's its own,
    /// `playJumpSound`. Its jump is its rider's client's, and so its sliding as it stands,
    /// `allowStandSliding`. Whether it jumped.
    pub fn ride_jump(mut self, data: i32, sounds: mut List<EntitySound>) -> bool {
        if not self.equine() or self.living.equipment[7] == none or data <= 0 {
            return false
        }
        self.set_horse_flag(16, false)
        self.set_horse_flag(32, true)
        self.stand_counter = 20
        // A skeleton horse's in water its own, `SkeletonHorse.playJumpSound` (CAL-349).
        let sound = if self.species == DONKEY { "entity.donkey.jump" } else if self.species == SKELETON_HORSE and self.living.body.in_water { "entity.skeleton_horse.jump_water" } else { "entity.horse.jump" }
        self.living.play(mut sounds, String(sound), 0.4f32, 1.0f32)
        return true
    }

    pub fn boost(mut self) -> bool {
        if self.species != PIG or self.boosting {
            return false
        }
        self.boosting = true
        self.boost_time = 0
        let total = self.living.body.random.next_int_below(841) + 140
        self.living.data.set(OWN, Value.Number(total))
        return true
    }

    /// The rest of its tick, after `tick_thinking`, which says whether it `entered` its `aiStep`'s
    /// own part, not gone as it began (CAL-159): the rest of its AI after its goals, where they
    /// ran, `think_after`; its travel and pushes, and its tick's end. Whether it stopped there for
    /// its level to swing a door its brain swung, to be called again to go on (CAL-160). Where its
    /// goals' tick stopped for its level, a silverfish's waking of a friend, it goes on with them
    /// first, stopping again at another friend, or for an attack among them, which its level deals
    /// before the rest (CAL-172).
    pub fn tick_rest<B: CollisionBlocks + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, entered: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        if self.thought {
            if self.goals_stopped() {
                if self.goals_on(lf, f, m, blocks, mut cache, players, min_y, mut sounds) or self.attacked() {
                    return true
                }
            }
            if self.think_after(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
                return true
            }
            self.thought = false
        }
        if entered and not self.squid.push_due {
            let steered = self.player_controller(players)
            let moves = not self.no_ai() and steered == none
            self.swim_wish(players)
            if self.guardian_kind() {
                // `Guardian.travelInWater` sinks it where it isn't moving and has no target
                // (CAL-200).
                self.living.idle_in_water = not self.living.data.flag(MONSTER_OWN) and self.target == none
            }
            if self.species == TURTLE {
                // `Turtle.travelInWater` sinks it with no target, unless it's going home within 20
                // of it (CAL-201).
                self.living.idle_in_water = self.target == none and (not self.turtle.going_home or not self.turtle_home_within(20.0))
            }
            if self.species == DOLPHIN {
                // `Dolphin.travelInWater` sinks it with no target (CAL-201).
                self.living.idle_in_water = self.target == none
            }
            if self.species == RABBIT {
                self.rabbit_jump_power()
            }
            self.living.ai_rest(lf, f, m, t, blocks, fast_lava, moves, mut sounds)
            if let p = steered {
                if self.living.alive() {
                    self.tick_ridden(p)
                }
            }
            self.fall_hurt(lf, blocks, items, mut sounds)
            // What the block it's on does to it, `stepOn`, magma's burn its own hurt (D431).
            match self.living.step_on_block(f, t, blocks) {
                Stepped.Magma => self.hurt_self(lf, blocks, items, "hot_floor", 1.0f32, mut sounds),
                Stepped.Ore(at) => self.living.show(Shown.Lit(at), sounds.len()),
                Stepped.Egg(at) => self.living.show(Shown.EggStep(at), sounds.len()),
                Stepped.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                Stepped.Nothing => {},
            }
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
            self.inside_walk(lf, f, blocks, items, mut sounds)
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
            if self.living.ai_end(lf, f, t, blocks) {
                self.hurt_self(lf, blocks, items, "freeze", 1.0f32, mut sounds)
            }
            if self.species == ENDERMAN and (self.living.body.in_water or self.living.body.in_rain(blocks)) {
                // `aiStep`'s last, after its pushes: water hurts it, `isSensitiveToWater`, in it
                // or the rain, `drown` (CAL-159).
                self.hurt_self(lf, blocks, items, "drown", 1.0f32, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
            if self.species == BLAZE and (self.living.body.in_water or self.living.body.in_rain(blocks)) {
                // A blaze's too, `Blaze.isSensitiveToWater` (CAL-200).
                self.hurt_self(lf, blocks, items, "drown", 1.0f32, mut sounds)
            }
            if self.species == SNOW_GOLEM {
                self.snow_golem_step(lf, blocks, items, mut sounds)
            }
            if self.species == PUFFERFISH {
                self.puffer_stings(sounds.len())
            }
            if self.species == RAVAGER {
                self.ravager_step(lf, f, m, t, blocks, mut sounds)
            }
            if self.species == WITHER_BOSS {
                self.wither_ai_end(lf, players, sounds.len())
            }
            if self.burns {
                self.burn_undead(blocks, items, sounds.len())
            }
            if self.ageable and self.forced_age_timer > 0 {
                // `AgeableMob.aiStep`: each 4th tick of the 40, a happy villager's particle the
                // server sends, `getRandomX(1)`, `getRandomY` half a block up and
                // `getRandomZ(1)`, drawn (D415).
                if self.forced_age_timer % 4 == 0 {
                    let width = f64(self.living.body.width)
                    let x = self.living.body.x + width * (2.0 * self.living.body.random.next_double() - 1.0)
                    let y = self.living.body.y + f64(self.living.body.height) * self.living.body.random.next_double() + 0.5
                    let z = self.living.body.z + width * (2.0 * self.living.body.random.next_double() - 1.0)
                    self.living.show(Shown.Particle(Sent { particle: String("happy_villager"), x: x, y: y, z: z }), sounds.len())
                }
                self.forced_age_timer -= 1
            }
            if self.ageable and self.living.alive() {
                if self.can_age_up() {
                    let older = self.age + 1
                    self.set_age(older)
                    self.turtle_grown(sounds.len())
                } else if self.age > 0 {
                    let younger = self.age - 1
                    self.set_age(younger)
                }
            }
            if self.ageable and self.age_lock_particles > 0 {
                // `makeAgeLockedParticle` (CAL-179): each 2nd tick of the 40, a particle of the
                // lock over it, `pause_mob_growth` locked, 0.2 higher, or `reset_mob_growth`,
                // `getRandomX(1)`, `getRandomY(0.2)` and its height up, and `getRandomZ(1)`, drawn.
                if self.age_lock_particles % 2 == 0 {
                    let locked = self.living.data.flag(AGE_LOCKED)
                    let width = f64(self.living.body.width)
                    let height = f64(self.living.body.height)
                    let x = self.living.body.x + width * (2.0 * self.living.body.random.next_double() - 1.0)
                    let up = if locked { f64(0.2f32) } else { 0.0 }
                    let y = self.living.body.y + height * ((2.0 * self.living.body.random.next_double() - 1.0) * 0.2) + height + up
                    let z = self.living.body.z + width * (2.0 * self.living.body.random.next_double() - 1.0)
                    self.living.show(Shown.Particle(Sent { particle: String(if locked { "pause_mob_growth" } else { "reset_mob_growth" }), x: x, y: y, z: z }), sounds.len())
                }
                self.age_lock_particles -= 1
            }
            if squid_kind(self.species) {
                // `Squid.aiStep`'s own part reads its motion after its pushes, which end
                // `LivingEntity.aiStep`, and its level deals: it stops here for them and goes on
                // with it after (CAL-201).
                self.squid.push_due = true
                return true
            }
        }
        if entered {
            if self.squid.push_due {
                self.squid.push_due = false
                self.squid_step(sounds.len())
            }
            let horse = self.equine()
            self.animal_step()
            if self.in_love > 0 {
                self.in_love -= 1
                if self.in_love % 10 == 0 {
                    // A heart, `addParticle`, which only clients show: its motion, then its
                    // place, `getRandomX(1)`, `getRandomY` and `getRandomZ(1)`, drawn (CAL-158).
                    for _ in 0..3 {
                        _ = self.living.body.random.next_gaussian()
                    }
                    for _ in 0..3 {
                        _ = self.living.body.random.next_double()
                    }
                }
            }
            if self.species == BEE {
                self.bee_step(lf, f, blocks, players, sounds.len())
            }
            if self.species == WOLF {
                self.wolf_step(players, sounds.len())
            }
            if self.fox_flag(FOX_DEFENDING) and self.living.body.random.next_float() < 0.05f32 {
                // `Fox.aiStep`'s, after an animal's (CAL-201): defending, its aggression heard 1 in
                // 20.
                self.living.play(mut sounds, String("entity.fox.aggro"), 1.0f32, 1.0f32)
            }
            if self.species == CHICKEN {
                self.chicken_step(mut sounds)
            }
            if self.species == PARROT {
                self.parrot_flapping()
            }
            if self.species == TURTLE {
                self.turtle_digging(lf, f, blocks, sounds.len())
            }
            if self.species == RABBIT {
                // `Rabbit.aiStep`'s, after the rest (CAL-201): a tick more of its jump, and at its
                // end its jump over, no longer jumping, `setJumping(false)`.
                if self.rabbit.jump_ticks != self.rabbit.jump_duration {
                    self.rabbit.jump_ticks += 1
                } else if self.rabbit.jump_duration != 0 {
                    self.rabbit.jump_ticks = 0
                    self.rabbit.jump_duration = 0
                    self.living.jumping = false
                }
            }
            if horse {
                self.horse_step(lf, f, blocks)
            }
            if self.species == SKELETON_HORSE and not self.persistence_required and self.skeleton_trap {
                // `SkeletonHorse.aiStep`'s, after the rest (CAL-349): a trap that needn't stay
                // gone once it's been one 18000 ticks, `trapTime`, `discard`.
                let was = self.trap_time
                self.trap_time += 1
                if was >= 18000 {
                    self.living.body.removed = true
                }
            }
            if self.species == ENDERMITE {
                // `Endermite.aiStep`'s, after the rest: a tick more of its life where it needn't
                // stay, and at 2400 it's gone, `discard` (D583).
                if not self.persistence_required {
                    self.life += 1
                }
                if self.life >= 2400 {
                    self.living.body.removed = true
                }
            }
        }
        // `tickHeadTurn`, its head kept within its reach, `getMaxHeadYRot`; an armadillo's body not
        // turned while it's scared, its own `BodyRotationControl` (CAL-160).
        if self.species == PHANTOM {
            // `PhantomBodyRotationControl.clientTick` (CAL-200): its head turned as its body was, its
            // body as it is.
            self.living.y_head_rot = self.living.y_body_rot
            self.living.y_body_rot = self.living.body.y_rot
        } else if self.species == SHULKER {
            // `ShulkerBodyRotationControl.clientTick`, which does nothing (CAL-200).
        } else if not self.scared() {
            let reach = self.max_head_y_rot()
            self.body_turn.tick(mut self.living, reach, self.carries_mob)
        }
        // `LivingEntity.tick`'s: asleep, its pitch level (CAL-160).
        if self.living.sleeping != none or self.fox_flag(FOX_SLEEPING) {
            self.living.body.x_rot = 0.0f32
        }
        self.living.keep_health(lf)
        // `refreshDirtyAttributes`' `SCALE` (CAL-359).
        let updated = self.living.attributes.take_updated()
        if not updated.is_empty() and updated.contains(attribute("scale")) {
            self.rescaled(f, m, blocks)
        }
        self.living.tick_end()
        if self.living.body.tick_count % 5 == 0 {
            // `Mob.tick`'s `updateControlFlags` (D710): its goals that move, jump and look off
            // while a mob steers it. Calcite has no boats, in which jumping would be off too.
            let free = not self.controlled
            self.goals.set_control(FLAG_MOVE, free)
            self.goals.set_control(FLAG_JUMP, free)
            self.goals.set_control(FLAG_LOOK, free)
        }
        if self.species == SHULKER {
            self.shulker_tick_end(f, m, blocks, players, min_y, mut sounds)
        } else if self.species == ZOMBIE or self.species == HUSK {
            // `Zombie.tick`'s, after the rest: turning in water to its eyes, `convertsInWater`, a
            // husk into a zombie with level event 1041, a zombie into a drowned with 1040
            // (CAL-175).
            let wet = self.living.body.water_eyes
            if self.convert_step(wet, MONSTER_OWN + 2, 600, 300) {
                let (into, event) = if self.species == HUSK { (ZOMBIE, 1041) } else { (DROWNED, 1040) }
                self.living.show(Shown.Converted((into, event)), sounds.len())
            }
        } else if self.spider_kind() {
            // `Spider.tick`'s: climbing where it bumped into something across.
            let flags = i32(self.living.data.byte(MONSTER_OWN))
            let climbing = self.living.body.horizontal_collision
            self.living.data.set(MONSTER_OWN, Value.Byte(i8.wrap(if climbing { flags | 1 } else { flags & -2 })))
        } else if cube_kind(self.species) {
            self.cube_landing(mut sounds)
        } else if self.tamable() {
            // `LivingEntity.tick`'s, every 20 ticks: what hurt it lately looked at again,
            // `recheckStatus` (CAL-201).
            if self.living.body.tick_count % 20 == 0 {
                if let tracker = self.living.combat.take() {
                    var c = tracker
                    _ = c.recheck(self.living.body.tick_count, self.living.alive())
                    self.living.combat = some(c)
                }
            }
            if self.species == WOLF {
                self.wolf_tick(blocks, mut sounds)
            } else if self.species == CAT {
                self.cat_tick(mut sounds)
            }
        } else if self.species == FOX {
            self.fox_tick_end(blocks, sounds)
        } else if self.species == PANDA {
            self.panda_tick_end(lf, blocks, players, mut sounds)
        } else if self.species == DOLPHIN {
            self.dolphin_tick_end(lf, blocks, items, mut sounds)
        } else if self.species == POLAR_BEAR {
            // `PolarBear.tick`'s, after the rest (CAL-201): a tick less till it may warn again, then
            // its anger kept up, `updatePersistentAnger`, staying angry while it has a target.
            if self.polar_warning > 0 {
                self.polar_warning -= 1
            }
            self.update_anger(players, true)
        } else if self.species == ARMADILLO {
            // `Armadillo.tick`'s, after the rest: scared, its head kept to its body,
            // `clampHeadRotationToBody`; and its ticks in its state counted (CAL-160).
            if self.scared() {
                self.clamp_head()
            }
            self.in_state_ticks += 1
        } else if self.species == BAT {
            self.bat_tick_end()
        } else if self.species == VEX {
            // `Vex.tick`'s, after the rest: its physics back, and no gravity from then on,
            // `setNoGravity`; where its life's limited, once it's run out, a starving hurt of 1,
            // and 20 ticks more (CAL-200).
            self.living.body.no_physics = false
            self.living.body.no_gravity = true
            self.living.data.set(NO_GRAVITY, Value.Bool(true))
            if let left = self.vex_life {
                if left - 1 <= 0 {
                    self.vex_life = some(20)
                    self.hurt_self(lf, blocks, items, "starve", 1.0f32, mut sounds)
                } else {
                    self.vex_life = some(left - 1)
                }
            }
        } else if self.species == BEE {
            self.bee_drips(sounds.len())
        } else if schooling_kind(self.species) {
            self.school_check(sounds.len())
        } else if self.species == VILLAGER {
            // `Villager.tick`'s, after the rest: its unhappiness counted down, and its gossip
            // decayed a day after it last did, `maybeDecayGossip` (CAL-160).
            let unhappy = self.living.data.number(OWN)
            if unhappy > 0 {
                self.living.data.set(OWN, Value.Number(unhappy - 1))
            }
            let now = self.game_time
            if self.last_gossip_decay == 0 {
                self.last_gossip_decay = now
            } else if now >= self.last_gossip_decay + 24000 {
                self.gossips.decay()
                self.last_gossip_decay = now
            }
        }
        if self.equine() and self.mouth_counter > 0 {
            // `AbstractHorse.tick`'s, after the rest: its mouth, opened as it ate, shut 30 ticks
            // after, `setFlag(64, false)` (CAL-179).
            self.mouth_counter += 1
            if self.mouth_counter > 30 {
                self.mouth_counter = 0
                self.set_horse_flag(64, false)
            }
        }
        if self.equine() and self.stand_counter > 0 {
            // Then its standing counted down, and let go at 0,
            // `clearStanding`.
            self.stand_counter -= 1
            if self.stand_counter <= 0 {
                self.set_horse_flag(32, false)
                self.stand_counter = 0
            }
        }
        if self.equine() {
            // Then its rise, `standAnim`, toward 1 while it stands and back to 0 after, last
            // tick's kept, `standAnimO` (D710).
            let a = self.stand_anim
            self.stand_anim_o = a
            if self.horse_flag(32) {
                let up = a + ((1.0f32 - a) * 0.4f32 + 0.05f32)
                self.stand_anim = if up > 1.0f32 { 1.0f32 } else { up }
            } else {
                let down = a + ((0.8f32 * a * a * a - a) * 0.6f32 - 0.05f32)
                self.stand_anim = if down < 0.0f32 { 0.0f32 } else { down }
            }
        }
        return false
    }

    // `AbstractCubeMob.tick`'s, after the rest: landing, its particles' draws from its own random,
    // two for each of 16 a block of twice its width, which only clients show, then its squish,
    // `entity.slime.squish`, a size 1 slime's its own, as loud as its sounds, its pitch drawn from
    // its own random. How it squishes, `targetSquish`, only clients show.
    fn cube_landing(mut self, sounds: mut List<EntitySound>) {
        let on = self.living.body.on_ground
        if on and not self.was_on_ground {
            let across = self.living.body.width * 2.0f32
            var i = 0
            while f32.nearest(i) < across * 16.0f32 {
                _ = self.living.body.random.next_float()
                _ = self.living.body.random.next_float()
                i += 1
            }
            let stem = if self.species == MAGMA_CUBE { "entity.magma_cube" } else { "entity.slime" }
            var sound = if self.slime_size() <= 1 { "{stem}.squish_small" } else { "{stem}.squish" }
            if self.species == SULFUR_CUBE {
                // `SulfurCube.getSquishSound` (CAL-402): a tiny one's small squish, else its
                // bounce with a block in it, else its squish.
                sound = String(if self.slime_size() <= 1 { "entity.small_sulfur_cube.squish" } else if self.has_body_item() { "entity.sulfur_cube.bounce" } else { "entity.sulfur_cube.squish" })
            }
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, sound, self.sound_volume, ((a - b) * 0.2f32 + 1.0f32) / 0.8f32)
        }
        self.was_on_ground = on
    }

    // `Witch.aiStep`'s, alive (CAL-159). Drinking, its ticks out, it stops, `setUsingItem`, what's
    // in its main hand gone, a potion's effects added, `forEachEffect` (CAL-163), and its drinking
    // slowness taken off; the drink's game event comes with game events. Else the potions it might
    // drink, each drawn for from its own random in turn: water breathing with its eyes in water,
    // fire resistance on fire or hurt by fire in the last 40 ticks, healing hurt, and swiftness at
    // a target past 11 blocks, each where it hasn't the effect; one to drink in its main hand,
    // `PotionContents.createItemStack`, for 32 ticks, `getUseDuration`, drinking, its drink sound,
    // its pitch drawn, unless it's silent, and slowed by a quarter, `SPEED_MODIFIER_DRINKING`. Then
    // 1 in about 1,333 its particles, entity event 15, shown after the `heard` sounds of its tick.
    fn witch_step(mut self, lf: LivingFacts, players: List<Follower>, sounds: mut List<EntitySound>) {
        if not self.living.alive() {
            return
        }
        let drinking = Identifier { namespace: "minecraft", path: String("drinking") }
        if self.living.data.flag(MONSTER_OWN + 1) {
            let left = self.using_time
            self.using_time -= 1
            if left <= 0 {
                self.living.data.set(MONSTER_OWN + 1, Value.Bool(false))
                let held = self.living.equipment[0].copy()
                self.living.equipment[0] = none
                if stack_named(held, "minecraft:potion") {
                    for e in potion_of(held) {
                        _ = self.add_effect(lf, e.copy(), mut sounds)
                    }
                }
                self.living.attributes.take_off(lf.movement_speed, drinking)
            }
        } else {
            var potion: str? = none
            let wet = self.living.body.water_eyes and not self.living.has_effect(WATER_BREATHING)
            let burning = (self.living.on_fire() or self.living.recently_hurt_by(self.game_time, IS_FIRE)) and not self.living.has_effect(FIRE_RESISTANCE)
            let hurt = self.living.data.float(HEALTH) < f32.nearest(self.living.attributes.value(attribute("max_health")))
            var far = false
            if let p = self.target_in(players) {
                far = not self.living.has_effect(SPEED) and self.distance_sqr_to(p.x, p.y, p.z) > 121.0
            }
            if self.living.body.random.next_float() < 0.15f32 and wet {
                potion = some("minecraft:water_breathing")
            } else if self.living.body.random.next_float() < 0.15f32 and burning {
                potion = some("minecraft:fire_resistance")
            } else if self.living.body.random.next_float() < 0.05f32 and hurt {
                potion = some("minecraft:healing")
            } else if self.living.body.random.next_float() < 0.5f32 and far {
                potion = some("minecraft:swiftness")
            }
            if let drink = potion {
                self.living.equipment[0] = some(potion_stack("minecraft:potion", drink))
                self.using_time = 32
                self.living.data.set(MONSTER_OWN + 1, Value.Bool(true))
                if not self.living.data.flag(SILENT) {
                    let pitch = 0.8f32 + self.living.body.random.next_float() * 0.4f32
                    self.living.play(mut sounds, String("entity.witch.drink"), 1.0f32, pitch)
                }
                self.living.attributes.take_off(lf.movement_speed, drinking.copy())
                self.living.attributes.replace(lf.movement_speed, Modifier { id: drinking, amount: -0.25, operation: ADD_VALUE })
            }
        }
        if self.living.body.random.next_float() < 0.00075f32 {
            self.living.show(Shown.Event(15i8), sounds.len())
        }
    }

    // `SulfurCubeSearchForItemsGoal` (CAL-402), `item` the item it goes to: used and going on grown,
    // its pickup timer out, toward the nearest of the items its level found within 8 of its box,
    // with no pickup delay, alive and what it swallows, `getNearestEntity`, the first of those as
    // near; each tick it runs turned to it at once, 10 degrees, `Mob.lookAt`, its middle, and its
    // way that, hopping after it.
    fn cube_search_goal(mut self, item: mut i32, call: i32) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            item = -1
            if self.baby() or self.sulfur.pickup_timer > 0 {
                return false
            }
            var best = -1.0
            for (id, x, y, z) in self.sulfur.items {
                let d = self.distance_sqr_to(x, y, z)
                if best < 0.0 or d < best {
                    best = d
                    item = id
                }
            }
            return item >= 0
        }
        if call == GOAL_TICK {
            var at: (f64, f64, f64)? = none
            for (id, x, y, z) in self.sulfur.items {
                if id == item {
                    at = some((x, y, z))
                }
            }
            if let (x, y, z) = at {
                self.look_at_point(x, y + f64(0.125f32), z, 10.0f32, 10.0f32)
            }
            let y_rot = self.living.body.y_rot
            self.moves.set_direction(y_rot, true)
        }
        return false
    }

    // `CubeMobAttackGoal` (CAL-159), `left` its ticks till it grows tired: used while it has a
    // target it may attack, for 150 ticks of its goals, `growTiredTimer`; each tick turned to them
    // at once, 10 degrees, `Mob.lookAt`, and its way theirs, after them where it may hurt them,
    // `canDealDamage`.
    fn cube_attack_goal(mut self, left: mut i32, call: i32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            return self.target_in(players) != none
        }
        if call == GOAL_CONTINUE {
            if self.target_in(players) == none {
                return false
            }
            left -= 1
            return left > 0
        }
        if call == GOAL_START {
            left = reduced_tick_delay(300)
        } else if call == GOAL_TICK {
            if let p = self.target_in(players) {
                self.look_at_now(p, 10.0f32, 10.0f32)
            }
            let y_rot = self.living.body.y_rot
            self.moves.set_direction(y_rot, self.cube_hurts())
        }
        return false
    }

    /// Whether a sulfur cube holds a block in it, `hasBodyItem` (CAL-402).
    /// Whether it's a sulfur cube (CAL-402).
    pub fn is_sulfur_cube(self) -> bool {
        return self.species == SULFUR_CUBE
    }

    pub fn has_body_item(self) -> bool {
        return self.living.equipment[BODY_SLOT] != none
    }

    // `SulfurCube.collectEquipmentChanges`, the block it holds changed from `previous` (CAL-402):
    // holding one, its goals stopped where they run and all taken out, `removeAllGoals`, and its
    // speed none, `setSpeed(0)`; holding none, its goals made again, `registerGoals`. The
    // modifiers of the archetypes of what it held taken off; then what the archetypes of what it
    // holds make of it, its floating where any floats, the explosion and knockback and sounds of
    // the last that has them, the hurts of all, their modifiers on, `addOrUpdateTransientModifier`.
    // It steps up nothing, moves through the air alike every way, doesn't freeze, and its steps
    // aren't heard while it holds one.
    fn sulfur_body_changed<B: CollisionBlocks + MobLight + NavLevel>(mut self, previous: Tag?, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        let now = self.living.equipment[BODY_SLOT].copy()
        if now != none {
            for i in 0..self.goals.len() {
                self.stop_goal(false, i, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
            }
            self.goals.clear()
            // `Mob.setSpeed`, its forward too.
            self.living.speed = 0.0f32
            self.living.zza = 0.0f32
        } else {
            self.register_goals()
        }
        for a in matching(lf.archetypes, held_name(previous)) {
            for md in lf.archetypes[a].modifiers {
                self.living.attributes.take_off(md.attribute, md.modifier.id.copy())
            }
        }
        self.sulfur.buoyant = false
        self.sulfur.explosion = none
        self.sulfur.contacts.clear()
        self.sulfur.horizontal = 0.33f32
        self.sulfur.vertical = 0.06f32
        self.sulfur.hit_sound = String("entity.sulfur_cube.regular.hit")
        self.sulfur.push_sound = String("entity.sulfur_cube.regular.push")
        self.sulfur.push_threshold = 0.2f32
        self.sulfur.push_cooldown = 0.5f32
        let holding = now != none
        for a in matching(lf.archetypes, held_name(now)) {
            let kind = lf.archetypes[a].copy()
            if kind.buoyant {
                self.sulfur.buoyant = true
            }
            if let e = kind.explosion {
                self.sulfur.explosion = some(e)
            }
            if let c = kind.contact {
                self.sulfur.contacts.push(c.copy())
            }
            self.sulfur.horizontal = kind.horizontal
            self.sulfur.vertical = kind.vertical
            self.sulfur.hit_sound = kind.hit_sound
            self.sulfur.push_sound = kind.push_sound
            self.sulfur.push_threshold = kind.push_threshold
            self.sulfur.push_cooldown = kind.push_cooldown
            for md in kind.modifiers {
                self.living.attributes.update(md.attribute, md.modifier)
            }
        }
        self.living.hard_bodied = holding
        self.living.omni_air = holding
        self.living.steps_unheard = holding
        self.living.floats_up = holding and self.sulfur.buoyant
        self.living.breathes_water = holding
        self.living.cube_knock = if holding { some(CubeKnock { horizontal: self.sulfur.horizontal, vertical: self.sulfur.vertical, hit_sound: self.sulfur.hit_sound.copy() }) } else { none }
        // Its body's as its attributes now are, as vanilla reads them as it moves.
        self.living.refresh_body(lf)
    }

    /// `SulfurCube.playerPush` by the player at px, py, pz, `height` tall, who moved by `known`
    /// last, `getKnownSpeed` (CAL-402): holding a block, with them within 1.3 across and their
    /// height meeting its, it's pushed away from them, less as its knockback resistance says, and
    /// up 0.3 of that on the ground, by twice 0.3 of their speed, half at most; its tracker to send
    /// it, its push sound heard where that's past its threshold and its cooldown's out, the
    /// cooldown begun again; then the hurts of what it touches, `applyContactDamage`, by their
    /// damage types' names and their amounts, drawn where they're uniform, which its level deals.
    pub fn sulfur_pushed(mut self, lf: LivingFacts, px: f64, py: f64, pz: f64, height: f64, known: (f64, f64, f64), sounds: mut List<EntitySound>) -> List<(String, f32)> {
        var out = List<(String, f32)>()
        if not self.has_body_item() {
            return out
        }
        let dx = self.living.body.x - px
        let dz = self.living.body.z - pz
        let across = (dx * dx + dz * dz).sqrt()
        let bottom = self.living.body.y
        let top = bottom + f64(self.living.body.height)
        if not (across < f64(1.3f32) and py <= top and py + height > bottom) {
            return out
        }
        let k = (1.0 - self.living.attributes.value(lf.knockback_resistance)).max(0.0)
        var nx = 0.0
        var nz = 0.0
        if across >= f64(1.0e-5f32) {
            nx = dx / across
            nz = dz / across
        }
        let (kx, ky, kz) = known
        let speed = ((kx * kx + ky * ky + kz * kz).sqrt() * 2.0 * f64(0.3f32)).max(0.0).min(0.5)
        let up = if self.living.body.on_ground { k * f64(0.3f32) } else { 0.0 }
        let vx = nx * k * speed
        let vy = up * speed
        let vz = nz * k * speed
        self.living.body.needs_sync = true
        let threshold = self.sulfur.push_threshold * self.sulfur.push_threshold
        if vx * vx + vy * vy + vz * vz > f64(threshold) and self.sulfur.push_sound_cooldown <= 0 {
            self.sulfur.push_sound_cooldown = i32.saturate(f64(self.sulfur.push_cooldown * 20.0f32))
            self.living.play(mut sounds, self.sulfur.push_sound.copy(), 1.0f32, 1.0f32)
        }
        self.living.body.vx = self.living.body.vx + vx
        self.living.body.vy = self.living.body.vy + vy
        self.living.body.vz = self.living.body.vz + vz
        for c in self.sulfur.contacts.copy() {
            let amount = if c.uniform { self.living.body.random.next_float() * (c.most - c.least) + c.least } else { c.least }
            let name = if c.damage_type.starts_with("minecraft:") { c.damage_type[10..] } else { c.damage_type.copy() }
            out.push((name, amount))
        }
        return out
    }

    /// `SulfurCube.canHoldItem` of `stack` (CAL-402): it holds no block, it's grown, and the stack
    /// is one it swallows, `#sulfur_cube_swallowable`.
    pub fn sulfur_holds(self, lf: LivingFacts, stack: Tag) -> bool {
        return not self.has_body_item() and not self.baby() and lf.tempting.of(held_name(some(stack.copy()))) & TEMPT_SULFUR_SWALLOWABLE != 0u32
    }

    /// `SulfurCube.pickUpItem` of `stack` (CAL-402): where it may hold it and its pickup timer's
    /// out, one of it in its body, its absorb sound at 1, its pitch 1, and that kept whole as it
    /// drops, `setGuaranteedDrop`; whether it took it.
    pub fn sulfur_pick_up(mut self, lf: LivingFacts, stack: Tag, sounds: mut List<EntitySound>) -> bool {
        if not self.sulfur_holds(lf, stack.copy()) or self.sulfur.pickup_timer > 0 {
            return false
        }
        self.living.equipment[BODY_SLOT] = some(recounted(stack, 1))
        self.living.play(mut sounds, String("entity.sulfur_cube.absorb"), 1.0f32, 1.0f32)
        self.guarantee_drop(BODY_SLOT)
        return true
    }

    /// `AbstractCubeMob.canDealDamage` (CAL-159): a slime bigger than the least, thinking; a magma
    /// cube of any size, thinking, `MagmaCube.canDealDamage` (CAL-200).
    pub fn cube_hurts(self) -> bool {
        if self.species == MAGMA_CUBE {
            return not self.no_ai()
        }
        return self.species == SLIME and self.slime_size() > 1 and not self.no_ai()
    }

    /// What a cube mob hurts what it touches by, `getAttackDamage`: its attack, a magma cube's 2
    /// more (CAL-200).
    pub fn cube_damage(self) -> f32 {
        let attack = f32.nearest(self.living.attributes.value(attribute("attack_damage")))
        return if self.species == MAGMA_CUBE { attack + 2.0f32 } else { attack }
    }

    /// Whether a slime may hurt the player `p` it touches, as `dealDamage` asks (CAL-159): alive,
    /// with them within its reach, `isWithinMeleeAttackRange`, and in its sight from its eyes to
    /// theirs, `LivingEntity.hasLineOfSight`; teams come with teams.
    pub fn cube_reaches<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, p: Follower) -> bool {
        if not self.living.alive() or not self.within_melee(p) {
            return false
        }
        let me = self.looker()
        return sees(m, f, blocks, me.mover, me.x, me.eye_y, me.z, p.x, p.y + f64(p.eyes), p.z)
    }

    /// A slime's attack sound as it hurts a player it touched (CAL-159), its pitch drawn.
    pub fn cube_attacked(mut self, sounds: mut List<EntitySound>) {
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        self.living.play(mut sounds, String("entity.slime.attack"), 1.0f32, (a - b) * 0.2f32 + 1.0f32)
    }

    // A `RangedAttackGoal` (CAL-159): used while it has a target that's alive, going on while it
    // does, or while the target it took up is alive and its path isn't done. Each tick, its sight
    // of them counted, `seeTime`; within its radius and seen for 5 ticks, its path stopped, else
    // it goes for them; looking at their eyes, 30 degrees; its attack's ticks counted down, and
    // out, seen, its attack, `performRangedAttack`, then as many ticks again as how far they are
    // of its radius says, between its least and most; else with none drawn up, that many.
    fn ranged_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Ranged, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            // A drowned's only with a trident in its main hand, `DrownedTridentAttackGoal.canUse`,
            // which it goes on with while that holds or its target's alive and its path isn't done
            // (CAL-200).
            let armed = not g.drowned or held_name(self.living.equipment[0].copy()) == "minecraft:trident"
            if armed {
                if let p = self.target_in(players) {
                    g.target = p.id
                    return true
                }
            }
            if call == GOAL_CAN_USE {
                return false
            }
            if g.drowned {
                let p = self.followed(players, g.target) else return false
                return not p.dead and not self.navigation.is_done()
            }
            // A snow golem's target a mob too (CAL-201).
            let p = self.followed(players, g.target) else return false
            return not p.dead and not self.navigation.is_done()
        }
        if call == GOAL_START and g.drowned {
            // `DrownedTridentAttackGoal.start`: aggressive, using what's in its main hand.
            self.set_flag(AGGRESSIVE_FLAG, true)
            self.living.start_using(0, sounds.len())
        }
        if call == GOAL_STOP {
            g.target = -1
            g.see_time = 0
            g.attack_time = -1
            if g.drowned {
                // `DrownedTridentAttackGoal.stop`: no longer using it, nor aggressive.
                self.living.stop_using()
                self.set_flag(AGGRESSIVE_FLAG, false)
            }
        } else if call == GOAL_TICK {
            let p = self.followed(players, g.target) else return false
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            let me = self.looker()
            let sight = sees_player(m, f, blocks, mut self.sensing, me, p)
            if sight {
                g.see_time += 1
            } else {
                g.see_time = 0
            }
            if not (d > f64(g.radius * g.radius)) and g.see_time >= 5 {
                self.navigation.stop()
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, g.speed)
            }
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
            g.attack_time -= 1
            if g.attack_time == 0 {
                if not sight {
                    return false
                }
                let dist = f32.nearest(d.sqrt()) / g.radius
                if g.drowned {
                    self.drowned_throw(p, mut sounds)
                } else if self.species == SNOW_GOLEM {
                    self.snow_throw(p, mut sounds)
                } else if self.species == WITHER_BOSS {
                    self.wither_shoot_at(0, p, sounds.len())
                } else if self.species == LLAMA {
                    self.llama_spit(p, mut sounds)
                } else {
                    self.witch_throw(p, mut sounds)
                }
                g.attack_time = floor_of(f64(dist * f32.nearest(f64(g.interval_max - g.interval_min)) + f32.nearest(f64(g.interval_min))))
            } else if g.attack_time < 0 {
                let a = d.sqrt() / f64(g.radius)
                g.attack_time = floor_of(f64(g.interval_min) + a * f64(g.interval_max - g.interval_min))
            }
        }
        return false
    }

    // `Witch.performRangedAttack` at the player `p` (CAL-159), not drinking: where they'll be,
    // their movement ahead, and how far across; a splash potion of harming, or of slowness 8 blocks
    // off or more, else of poison where they've 8 health or more, else of weakness within 3 blocks
    // 1 in 4, drawn, each where they haven't its effect, `hasEffect` (D514); the potion thrown,
    // `Shown.Hurled`, which its level makes, from a tenth below its eyes toward them, 1.1 below
    // their eyes and a fifth of the way across above that, at 0.75 blocks a tick, 0.45 within 2
    // blocks, 8 off on every difficulty, `Witch.rangedAttackUncertainty` (D528); and its throw
    // sound, its pitch drawn, unless it's silent.
    fn witch_throw(mut self, p: Follower, sounds: mut List<EntitySound>) {
        if self.living.data.flag(MONSTER_OWN + 1) {
            return
        }
        let xd = p.x + p.vx - self.living.body.x
        let zd = p.z + p.vz - self.living.body.z
        let dist = (xd * xd + zd * zd).sqrt()
        var potion = "harming"
        if dist >= 8.0 and not p.has_effect(SLOWNESS) {
            potion = "slowness"
        } else if p.health >= 8.0f32 and not p.has_effect(POISON) {
            potion = "poison"
        } else if dist <= 3.0 and not p.has_effect(WEAKNESS) and self.living.body.random.next_float() < 0.25f32 {
            potion = "weakness"
        }
        let yd = p.y + f64(p.eyes) - f64(1.1f32) - self.living.body.y
        let thrown = Hurled {
            owner: self.living.body.uuid,
            x: self.living.body.x,
            y: self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32),
            z: self.living.body.z,
            xd: xd,
            yd: yd + dist * 0.2,
            zd: zd,
            power: if dist <= 2.0 { 0.45f32 } else { 0.75f32 },
            uncertainty: 8.0f32,
            potion: "minecraft:{potion}",
        }
        self.living.show(Shown.Hurled(thrown), sounds.len())
        if not self.living.data.flag(SILENT) {
            let pitch = 0.8f32 + self.living.body.random.next_float() * 0.4f32
            self.living.play(mut sounds, String("entity.witch.throw"), 1.0f32, pitch)
        }
    }

    // `SnowGolem.performRangedAttack` at `p` (CAL-201): a snowball thrown, `Shown.Hurled`, which
    // its level makes, from a tenth below its eyes toward 1.1 below their eyes and a fifth of the
    // way across above that, at 1.6 blocks a tick, 12 off, `rangedAttackUncertainty`; then its
    // shoot sound, its pitch drawn.
    fn snow_throw(mut self, p: Follower, sounds: mut List<EntitySound>) {
        let xd = p.x - self.living.body.x
        let yd = p.y + f64(p.eyes) - f64(1.1f32)
        let zd = p.z - self.living.body.z
        let yo = (xd * xd + zd * zd).sqrt() * f64(0.2f32)
        let y = self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32)
        let thrown = Hurled { owner: self.living.body.uuid, x: self.living.body.x, y: y, z: self.living.body.z, xd: xd, yd: yd + yo - y, zd: zd, power: 1.6f32, uncertainty: 12.0f32, potion: String(), snowball: true }
        self.living.show(Shown.Hurled(thrown), sounds.len())
        let pitch = 0.4f32 / (self.living.body.random.next_float() * 0.4f32 + 0.8f32)
        self.living.play(mut sounds, String("entity.snow_golem.shoot"), 1.0f32, pitch)
    }

    // `SnowGolem.aiStep` after `LivingEntity`'s (CAL-201): water hurts it, `isSensitiveToWater`,
    // in it or the rain, `drown`; where it melts, `SNOW_GOLEM_MELTS` where it is, fire hurts it by
    // 1, `onFire`; then the blocks a quarter of a block off it each way across where it stands,
    // for its level to cover with snow where mob griefing lets it, `Shown.SnowTrail`.
    fn snow_golem_step<B: CollisionBlocks + MobLight + Rain + Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        if self.living.body.in_water or self.living.body.in_rain(blocks) {
            self.hurt_self(lf, blocks, items, "drown", 1.0f32, mut sounds)
        }
        let (bx, by, bz) = self.block_position()
        if blocks.snow_golem_melts(bx, by, bz) {
            self.hurt_self(lf, blocks, items, "on_fire", 1.0f32, mut sounds)
        }
        var spots = List<(i32, i32, i32)>()
        for i in 0..4 {
            let sx = f32.nearest(f64(i % 2 * 2 - 1)) * 0.25f32
            let sz = f32.nearest(f64(i / 2 % 2 * 2 - 1)) * 0.25f32
            let x = i32.saturate((self.living.body.x + f64(sx)).floor())
            let z = i32.saturate((self.living.body.z + f64(sz)).floor())
            spots.push((x, i32.saturate(self.living.body.y.floor()), z))
        }
        self.living.show(Shown.SnowTrail(spots), sounds.len())
    }

    /// Whether a snow golem has its pumpkin, `hasPumpkin` (CAL-201).
    pub fn has_pumpkin(self) -> bool {
        return i32(self.living.data.byte(MONSTER_OWN)) & 16 != 0
    }

    /// A snow golem's pumpkin put on or taken off, `setPumpkin` (CAL-201).
    pub fn set_pumpkin(mut self, on: bool) {
        let was = i32(self.living.data.byte(MONSTER_OWN))
        let now = if on { was | 16 } else { was & -17 }
        self.living.data.set(MONSTER_OWN, Value.Byte(i8.wrap(now)))
    }

    /// `addEffect` of `e`, as `Living.add_effect` has it, its type's `canBeAffected` with it, its
    /// sound in `sounds`; whether it changed (CAL-163).
    pub fn add_effect(mut self, lf: LivingFacts, e: ActiveEffect, sounds: mut List<EntitySound>) -> bool {
        if self.species == WITHER_BOSS {
            // `WitherBoss.addEffect`, which takes none (CAL-401).
            return false
        }
        return self.living.add_effect(lf, e, mut sounds)
    }

    // `tickEffects` (CAL-163): each of its effects in their order, `tickServer`: its act,
    // `Living.effect_act`, a hurt it gives dealt as its own, `hurt_self`, an enderman's teleport
    // after, as `Enderman.hurtServer` has it; then its count down, `Living.effect_end`. Undead
    // mobs are harmed by healing and healed by harming, `#inverted_healing_and_harm`.
    fn tick_effects<B: CollisionBlocks + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let inverted = self.living.inverted(lf)
        var i: usize = 0
        while i < self.living.effects.len() {
            let (kept, hurt, amount) = self.living.effect_act(lf, i, inverted)
            if hurt == MAGIC_HURT or hurt == WITHER_HURT {
                self.hurt_self(lf, blocks, items, if hurt == MAGIC_HURT { "magic" } else { "wither" }, amount, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
            if self.living.effect_end(lf, i, kept) {
                i += 1
            }
        }
    }

    // The light where its eyes are, `getLightLevelDependentMagicValue`.
    fn magic_light<B: MobLight>(self, blocks: B) -> f32 {
        if self.species == VEX {
            // `Vex.getLightLevelDependentMagicValue` (CAL-200).
            return 1.0f32
        }
        let x = i32.saturate(self.living.body.x.floor())
        let y = i32.saturate((self.living.body.y + f64(self.living.body.eyes)).floor())
        let z = i32.saturate(self.living.body.z.floor())
        return blocks.magic_light(x, y, z)
    }

    // `Mob.burnUndead` (D437), `heard` the sounds before: alive where monsters burn, the light at
    // its eyes over half and a draw from its own random under what's more, out of water and rain,
    // and its eyes' block seeing the sky, `isSunBurnTick`, what's on its head takes the sun, worn
    // by 0 or 1, drawn, where it can be, which its level does with its random,
    // `hurtAndBreak`; with nothing on its head, it's lit for 8 seconds, `igniteForSeconds`.
    // Powder snow, which would keep it from burning, comes with powder snow.
    fn burn_undead<B: MobLight + Rain, W: Wearing>(mut self, blocks: B, items: W, heard: usize) {
        if not self.living.alive() {
            return
        }
        let x = i32.saturate(self.living.body.x.floor())
        let y = i32.saturate(self.living.body.y.floor())
        let z = i32.saturate(self.living.body.z.floor())
        if not blocks.monsters_burn(x, y, z) {
            return
        }
        let light = self.magic_light(blocks)
        if not (light > 0.5f32) {
            return
        }
        if not (self.living.body.random.next_float() * 30.0f32 < (light - 0.4f32) * 2.0f32) {
            return
        }
        if self.living.body.in_water or self.living.body.in_rain(blocks) {
            return
        }
        let ey = i32.saturate((self.living.body.y + f64(self.living.body.eyes)).floor())
        if not blocks.sees_sky(x, ey, z) {
            return
        }
        let head: usize = 5
        if let worn = self.living.equipment[head].copy() {
            let damageable = items.worn_component(worn.copy(), String("minecraft:max_damage")) != none and items.worn_component(worn.copy(), String("minecraft:unbreakable")) == none and items.worn_component(worn.copy(), String("minecraft:damage")) != none
            if damageable {
                let amount = self.living.body.random.next_int_below(2)
                if amount > 0 {
                    self.living.show(Shown.Wore((head, amount)), heard)
                }
            }
            return
        }
        self.living.ignite_for_ticks(160)
    }

    // `ConversionTracker.tick`, alive and thinking: `afflicted`, it counts how long, and at
    // `total_affliction` starts converting, its value at `at` on, for `total_conversion` ticks,
    // counted down; not, it's neither. Whether it's done, its count under 0, so it becomes another,
    // `doConversion` (CAL-175).
    fn convert_step(mut self, afflicted: bool, at: usize, total_affliction: i32, total_conversion: i32) -> bool {
        if not self.living.alive() or self.no_ai() {
            return false
        }
        if not afflicted {
            self.affliction_time = -1
            self.living.data.set(at, Value.Bool(false))
            return false
        }
        if self.living.data.flag(at) {
            self.conversion_time -= 1
            return self.conversion_time < 0
        }
        self.affliction_time += 1
        if self.affliction_time >= total_affliction {
            self.conversion_time = total_conversion
            self.living.data.set(at, Value.Bool(true))
        }
        return false
    }

    // `ZombieVillager.getConversionProgress` (CAL-175): 1, and by a draw under 0.01 one more for
    // each block that speeds its cure, `#speeds_up_zombie_villager_curing`, by a draw under 0.3,
    // of the first 14 found in the 8 by 8 by 8 about where it is, from 4 below its place, its
    // place's parts cut toward 0, `(int)`, each block in x, then y, then z.
    fn cure_progress<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) -> i32 {
        var amount = 1
        if self.living.body.random.next_float() < 0.01f32 {
            var found = 0
            let x = i32.saturate(self.living.body.x)
            let y = i32.saturate(self.living.body.y)
            let z = i32.saturate(self.living.body.z)
            var xx = x - 4
            while xx < x + 4 and found < 14 {
                var yy = y - 4
                while yy < y + 4 and found < 14 {
                    var zz = z - 4
                    while zz < z + 4 and found < 14 {
                        if f.in_set(state_at(blocks, xx, yy, zz), lf.curing) {
                            if self.living.body.random.next_float() < 0.3f32 {
                                amount += 1
                            }
                            found += 1
                        }
                        zz += 1
                    }
                    yy += 1
                }
                xx += 1
            }
        }
        return amount
    }

    // `ZombieVillager.startConverting` (CAL-175): who's curing it, where it's a player, kept as
    // `ConversionPlayer`, where it's `told` of them, as on a golden apple; its cure's time; being
    // cured; its weakness taken away and strength for as long, at the world's difficulty's ID
    // less 1 but no more than 0; and entity event 16, where it's `told`, as a mob loaded isn't in
    // a level to tell anyone.
    fn start_curing(mut self, lf: LivingFacts, starter: (i64, i64)?, time: i32, told: bool, sounds: mut List<EntitySound>) {
        if told {
            _ = self.kept.remove(String("ConversionPlayer"))
            if let p = starter {
                self.kept.insert(String("ConversionPlayer"), uuid_tag(p))
            }
        }
        self.cure_time = time
        self.living.data.set(MONSTER_OWN + 3, Value.Bool(true))
        _ = self.living.remove_effect(lf, WEAKNESS)
        let amplifier = if self.difficulty - 1 < 0 { self.difficulty - 1 } else { 0 }
        _ = self.add_effect(lf, ActiveEffect.new(STRENGTH, time, amplifier), mut sounds)
        if told {
            self.living.show(Shown.Event(16), sounds.len())
        }
    }

    // `Creeper.tick`'s, alive, before the rest: ignited, or as its `SwellGoal` has it, it swells,
    // its primed sound as it starts; at its fuse it explodes, `explodeCreeper` (CAL-182): its
    // explosion, its lingering cloud and what its effects do as it goes, which its level makes,
    // then it's gone, `discard`, its tick going on after, as vanilla's does. Its `dead`, which
    // vanilla sets first, only keeps it from dying, which nothing now can, and Calcite's counts it
    // dying, so it's left. Whether it exploded.
    fn swell_step(mut self, sounds: mut List<EntitySound>) -> bool {
        if not self.living.alive() {
            return false
        }
        if self.living.data.flag(MONSTER_OWN + 2) {
            self.living.data.set(MONSTER_OWN, Value.Number(1))
        }
        let dir = self.living.data.number(MONSTER_OWN)
        if dir > 0 and self.swell == 0 {
            self.living.play(mut sounds, String("entity.creeper.primed"), 1.0f32, 0.5f32)
        }
        self.swell += dir
        if self.swell < 0 {
            self.swell = 0
        }
        if self.swell < self.max_swell {
            return false
        }
        self.swell = self.max_swell
        let powered = self.living.data.flag(MONSTER_OWN + 1)
        let radius = f32.nearest(self.explosion_radius) * (if powered { 2.0f32 } else { 1.0f32 })
        var effects = List<Tag>()
        let names = if self.living.effects.is_empty() { List<String>() } else { effect_names() }
        for e in self.living.effects {
            effects.push(e.saved(names))
        }
        let creep = Creep { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, radius: radius, uuid: self.living.body.uuid, silent: self.living.data.flag(SILENT), effects: effects }
        self.living.show(Shown.Exploded(creep), sounds.len())
        self.living.body.removed = true
        return true
    }

    // `AbstractHorse.aiStep`'s, alive: healed a point 1 in 900; and, not eating and ridden by
    // none, it starts eating 1 in 300 on a grass block, `setEating`, and stops 50 ticks after.
    // A bred foal following its mother, `followMommy`, waits for AI.
    fn horse_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) {
        if not self.living.alive() {
            return
        }
        if self.living.body.random.next_int_below(900) == 0 and self.living.death_time == 0 {
            self.living.heal(lf, 1.0f32)
        }
        // Not while something rides it, `isVehicle`, before the draw (D710).
        // A llama eats no grass, `canEatGrass` (CAL-201).
        if self.species != LLAMA and not self.horse_flag(16) and self.living.body.passengers.is_empty() and self.living.body.random.next_int_below(300) == 0 {
            let x = i32.saturate(self.living.body.x.floor())
            let y = i32.saturate(self.living.body.y.floor())
            let z = i32.saturate(self.living.body.z.floor())
            if let below = blocks.collision_state(x, y - 1, z) {
                if f.block_named(String("minecraft:grass_block")) == some(f.block(below)) {
                    self.set_horse_flag(16, true)
                }
            }
        }
        if self.species != LLAMA and self.horse_flag(16) {
            self.eating_counter += 1
            if self.eating_counter > 50 {
                self.eating_counter = 0
                self.set_horse_flag(16, false)
            }
        }
    }

    // `Chicken.aiStep`'s: falling slowly, 0.6 of its fall kept in the air; and, grown, alive and
    // no jockey's mount, its ticks until it lays counted down, at 0 its egg laid, then its sound
    // drawn from its own random where it laid one, and its ticks drawn again.
    fn chicken_step(mut self, sounds: mut List<EntitySound>) {
        if not self.living.body.on_ground and self.living.body.vy < 0.0 {
            self.living.body.vy *= 0.6
        }
        if not self.living.alive() or self.baby() or self.jockey {
            return
        }
        self.egg_time -= 1
        if self.egg_time > 0 {
            return
        }
        if let item = self.egg() {
            let laid = Laid { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, item: item, table: String("minecraft:gameplay/chicken_lay") }
            self.living.show(Shown.Laid(laid), sounds.len())
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, String("entity.chicken.egg"), 1.0f32, (a - b) * 0.2f32 + 1.0f32)
        }
        self.egg_time = self.living.body.random.next_int_below(6000) + 6000
    }

    /// The egg a chicken lays, `gameplay/chicken_lay`'s by its variant: an egg for the temperate, a
    /// brown one for the warm and a blue one for the cold; none for another, which lays nothing.
    pub fn egg(self) -> String? {
        if self.variant < 0 or usize.wrap(self.variant) >= self.variant_names.len() {
            return none
        }
        let name = self.variant_names[usize.wrap(self.variant)].copy()
        if name == "minecraft:temperate" {
            return some(String("minecraft:egg"))
        }
        if name == "minecraft:warm" {
            return some(String("minecraft:brown_egg"))
        }
        if name == "minecraft:cold" {
            return some(String("minecraft:blue_egg"))
        }
        return none
    }

    /// Whether it's an armadillo that's scared, `isScared`: in any state but idle (CAL-160).
    pub fn scared(self) -> bool {
        return self.species == ARMADILLO and self.living.data.number(OWN) != ARMADILLO_IDLE
    }

    /// An armadillo's state, `getState`, by its ID.
    pub fn armadillo_state(self) -> i32 {
        return self.living.data.number(OWN)
    }

    // `switchToState`: its state set, and where that changed it its ticks in it counted from 0
    // again, `onSyncedDataUpdated`, and its ambient sound as it is now.
    fn switch_to_state(mut self, state: i32) {
        if self.living.data.number(OWN) == state {
            return
        }
        self.living.data.set(OWN, Value.Number(state))
        self.in_state_ticks = 0
        self.refresh_sounds()
    }

    // `makeSound`: the sound as loud as its sounds, its voice's pitch drawn.
    fn make_sound(mut self, sounds: mut List<EntitySound>, sound: str) {
        let pitch = self.voice_pitch()
        self.living.play(mut sounds, String(sound), self.sound_volume, pitch)
    }

    // `Mob.stopInPlace`: its navigation stopped, still, `setSpeed(0)` its forward too, and its
    // motion none, where `body` and its body's not stopped already, as its hurt stops it.
    // Leashes come with CAL-179.
    fn stop_in_place(mut self, body: bool) {
        self.navigation.stop()
        if body {
            self.living.xxa = 0.0f32
            self.living.yya = 0.0f32
            self.living.speed = 0.0f32
            self.living.zza = 0.0f32
            self.living.body.vx = 0.0
            self.living.body.vy = 0.0
            self.living.body.vz = 0.0
        }
    }

    // `Armadillo.rollUp`: where it isn't scared, stopped in place, its body too where `body`,
    // out of love, `resetLove`, its roll heard, `makeSound`, and rolling. Its game event comes
    // with game events.
    fn roll_up(mut self, body: bool, sounds: mut List<EntitySound>) {
        if self.scared() {
            return
        }
        self.stop_in_place(body)
        self.in_love = 0
        self.make_sound(mut sounds, "entity.armadillo.roll")
        self.switch_to_state(ARMADILLO_ROLLING)
    }

    // `Armadillo.rollOut`: where it's scared, its unrolling's end heard and idle.
    fn roll_out(mut self, sounds: mut List<EntitySound>) {
        if not self.scared() {
            return
        }
        self.make_sound(mut sounds, "entity.armadillo.unroll_finish")
        self.switch_to_state(ARMADILLO_IDLE)
    }

    // `canStayRolledUp`: not panicking nor in a liquid. Leashes and riding come later.
    fn can_stay_rolled_up(self) -> bool {
        return not self.panicking() and not self.in_liquid()
    }

    // `isInLiquid`: in water or lava.
    fn in_liquid(self) -> bool {
        return self.living.body.in_water or self.living.body.in_lava()
    }

    /// Whether it panics, `PathfinderMob.isPanicking`: a brain mob where its brain holds
    /// `IS_PANICKING`, any other where a `PanicGoal` of its runs.
    pub fn panicking(self) -> bool {
        if let b = self.brain {
            return b.has(MEMORY_IS_PANICKING)
        }
        return self.goals.panicking()
    }

    /// Whether it's an `AbstractSkeleton`, a skeleton, a stray, a bogged, a parched or a wither
    /// skeleton, which act alike but for what their arrows do, how often they shoot, what they
    /// hold, that a skeleton freezes into a stray (CAL-175) and a bogged can be sheared (CAL-200).
    pub fn skeletal(self) -> bool {
        return self.species == SKELETON or self.species == STRAY or self.species == BOGGED or self.species == PARCHED or self.species == WITHER_SKELETON
    }

    /// Whether it's a spider or a cave spider, `Spider`, which act alike but that a cave spider's
    /// smaller, draws nothing as it spawns and poisons what it hits (CAL-200).
    pub fn spider_kind(self) -> bool {
        return self.species == SPIDER or self.species == CAVE_SPIDER
    }

    /// The effect its arrows give what they hit, by its kind and for how many ticks, `getArrow`'s
    /// `addEffect`: a stray's slowness for 30 seconds (CAL-175), a bogged's poison for 5 and a
    /// parched's weakness for 30 (CAL-200).
    pub fn arrow_effect(self) -> (i32, i32)? {
        if self.species == STRAY {
            return some((SLOWNESS, 600))
        }
        if self.species == BOGGED {
            return some((POISON, 100))
        }
        if self.species == PARCHED {
            return some((WEAKNESS, 600))
        }
        return none
    }

    /// Whether it's a guardian or an elder guardian, `Guardian` (CAL-200).
    pub fn guardian_kind(self) -> bool {
        return self.species == GUARDIAN or self.species == ELDER_GUARDIAN
    }

    /// Whether it's undead, `#undead`: a zombie, husk, drowned, skeleton, stray, bogged, parched,
    /// wither skeleton, zombie villager, zombie horse or phantom.
    pub fn undead(self) -> bool {
        let s = self.species
        return undead_kind(s)
    }

    /// How far up or down it looks at most where nothing says, `getMaxHeadXRot`: a guardian's 180
    /// (CAL-200), any other's 40.
    pub fn max_head_x_rot(self) -> f32 {
        // A cube mob's none, `AbstractCubeMob.getMaxHeadXRot` (CAL-402).
        if cube_kind(self.species) {
            return 0.0f32
        }
        // A dolphin's 1, `Dolphin.getMaxHeadXRot` (CAL-201).
        if self.species == DOLPHIN {
            return 1.0f32
        }
        // A wolf's 20 while it sits, `Wolf.getMaxHeadXRot` (CAL-201).
        if self.species == WOLF and i32(self.living.data.byte(OWN)) & 1 != 0 {
            return 20.0f32
        }
        return if self.guardian_kind() or self.species == SHULKER { 180.0f32 } else { MAX_HEAD_X_ROT }
    }

    /// How far it turns its head from its body, `getMaxHeadYRot`: an armadillo's 32, none while
    /// it's scared; any other's 75.
    pub fn max_head_y_rot(self) -> f32 {
        if self.species == DOLPHIN {
            // `Dolphin.getMaxHeadYRot` (CAL-201).
            return 1.0f32
        }
        if self.species == RAVAGER {
            // `Ravager.getMaxHeadYRot` (CAL-200).
            return 45.0f32
        }
        if self.species == SHULKER {
            // `Shulker.getMaxHeadYRot` (CAL-200).
            return 180.0f32
        }
        if self.species == ARMADILLO {
            return if self.scared() { 0.0f32 } else { 32.0f32 }
        }
        return MAX_HEAD_Y_ROT
    }

    /// `Mob.clampHeadRotationToBody`, as a boat it rides has it (CAL-315).
    pub fn clamp_head_to_body(mut self) {
        self.clamp_head()
    }

    // `Mob.clampHeadRotationToBody`: its head kept within its reach of its body.
    fn clamp_head(mut self) {
        let limit = self.max_head_y_rot()
        let head = self.living.y_head_rot
        let delta = wrap_degrees(self.living.y_body_rot - head)
        let target = clamp(wrap_degrees(self.living.y_body_rot - head), -limit, limit)
        self.living.y_head_rot = head + delta - target
    }

    // `pickNextScuteDropTime`: 6,000 to 11,999 ticks, drawn.
    fn pick_scute_time(mut self) -> i32 {
        return self.living.body.random.next_int_below(6000) + 6000
    }

    // `ArmadilloBallUp.pickNextPeekTimer`: its scared animation's 50 ticks and 100 to 400 more,
    // drawn.
    fn pick_peek(mut self) -> i32 {
        return animation_of(ARMADILLO_SCARED) + self.living.body.random.next_int_between(100, 400)
    }

    /// The living entity `id` near it, as its level found it for its brain this tick, if it did.
    pub fn near_of(self, id: i32) -> Near? {
        for n in self.near {
            if n.id == id {
                return some(n)
            }
        }
        for n in self.near_items {
            if n.id == id {
                return some(n)
            }
        }
        return none
    }

    /// The IDs of the entities its brain's memories hold, which its level finds for it as it
    /// ticks wherever they are, `near`: the living entities its sensor found, its partner, what
    /// hurt it, the adult and player it follows, and its look and walk targets'; and the player
    /// it trades with (CAL-160).
    pub fn watched(self) -> List<i32> {
        var out = List<i32>()
        let b = self.brain else return out
        if let t = self.trading {
            out.push(t.id)
        }
        for id in b.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            out.push(id)
        }
        let held: List<i32> = [MEMORY_BREED_TARGET, MEMORY_HURT_BY_ENTITY, MEMORY_NEAREST_VISIBLE_ADULT, MEMORY_TEMPTING_PLAYER, MEMORY_NEAREST_VISIBLE_WANTED_ITEM]
        for m in held {
            if let id = b.entity(m) {
                out.push(id)
            }
        }
        if let t = b.tracker(MEMORY_LOOK_TARGET) {
            if let Tracker.Entity(e) = t {
                out.push(e.id)
            }
        }
        if let w = b.walk(MEMORY_WALK_TARGET) {
            if let Tracker.Entity(e) = w.target {
                out.push(e.id)
            }
        }
        return out
    }

    // Where the tracker `t` is now, `currentPosition`: a place's own, or an entity's feet or eyes;
    // none for an entity its level didn't find.
    fn tracked_place(self, t: Tracker) -> (f64, f64, f64)? {
        match t {
            Tracker.Block(s) => return some((s.px, s.py, s.pz)),
            Tracker.Entity(e) => {
                let n = self.near_of(e.id) else return none
                return some((n.x, if e.eyes { n.y + f64(n.eyes) } else { n.y }, n.z))
            },
        }
    }

    // The block the tracker `t` is at now, `currentBlockPosition`: a place's own, or the block of
    // an entity's feet or, `targetEyeHeight`, its eyes.
    fn tracked_block(self, t: Tracker) -> (i32, i32, i32)? {
        match t {
            Tracker.Block(s) => return some((s.x, s.y, s.z)),
            Tracker.Entity(e) => {
                let n = self.near_of(e.id) else return none
                let y = if e.target_eyes { n.y + f64(n.eyes) } else { n.y }
                return some((floor_of(n.x), floor_of(y), floor_of(n.z)))
            },
        }
    }

    // `Sensor.isEntityTargetable`, its brain's sight test of the living entity `e`,
    // `TargetingConditions.forNonCombat` at the range sensors last set theirs to, `sensor_range`:
    // not itself, seen by anyone, `canBeSeenByAnyone`, alive and not spectating; within the range
    // times how visible it is to it, 2 at least, from its feet to theirs; and in its sight, as its
    // sensing remembers it for the tick (CAL-160).
    fn targetable<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, e: Near) -> bool {
        if e.id == self.living.body.id or not e.alive or e.spectator {
            return false
        }
        let within = (self.sensor_range * e.visibility).max(2.0)
        if self.distance_sqr_to(e.x, e.y, e.z) > within * within {
            return false
        }
        if let k = self.sensing.known(e.id) {
            return k
        }
        let who = self.looker()
        let seen = sees(m, f, blocks, who.mover, who.x, who.eye_y, who.z, e.x, e.y + f64(e.eyes), e.z)
        self.sensing.note(e.id, seen)
        return seen
    }

    // Whether its brain may see the `i`th of its visible living entities `seen`,
    // `lineOfSightTest`, as it found the first time it was asked, else found and kept now.
    fn visible_at<B: CollisionBlocks>(mut self, seen: mut Visible, i: usize, f: Facts, m: MovementStates, blocks: B) -> bool {
        if seen.seen[i] >= 0i8 {
            return seen.seen[i] == 1i8
        }
        var fine = false
        if let e = self.near_of(seen.ids[i]) {
            fine = self.targetable(f, m, blocks, e)
        }
        seen.seen[i] = if fine { 1i8 } else { 0i8 }
        return fine
    }

    // `NearestVisibleLivingEntities.contains`: whether `id` is among its brain's visible living
    // entities, and it may see it.
    fn sees_near<B: CollisionBlocks>(mut self, brain: mut Brain, id: i32, f: Facts, m: MovementStates, blocks: B) -> bool {
        var seen = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) else return false
        var out = false
        for i in 0..seen.ids.len() {
            if seen.ids[i] == id {
                out = self.visible_at(mut seen, i, f, m, blocks)
                break
            }
        }
        brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
        return out
    }

    // `PositionTracker.isVisibleBy`: a place always, and an entity that isn't living, an item; a
    // living one where it's alive and among its brain's visible living entities, which it may see.
    fn tracker_visible<B: CollisionBlocks>(mut self, brain: mut Brain, t: Tracker, f: Facts, m: MovementStates, blocks: B) -> bool {
        match t {
            Tracker.Block(_) => return true,
            Tracker.Entity(e) => {
                let n = self.near_of(e.id) else return false
                if n.species == ITEM {
                    return true
                }
                if not n.alive {
                    return false
                }
                return self.sees_near(mut brain, e.id, f, m, blocks)
            },
        }
    }

    // `NearestVisibleLivingEntities.findClosest`: the nearest of its brain's visible living
    // entities of the kind `pick` asks for, which it may see, its sight tested only of those the
    // kind fits, in their order: `PICK_PLAYER` a player within `within` squared of it; `PICK_ADULT`
    // a grown one of its own kind; and `PICK_PARTNER` one of its kind in love, as it is, not
    // panicking, `canMate`.
    fn find_closest<B: CollisionBlocks>(mut self, brain: mut Brain, pick: i32, within: f64, f: Facts, m: MovementStates, blocks: B) -> i32? {
        var seen = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) else return none
        var out: i32? = none
        for i in 0..seen.ids.len() {
            let e = self.near_of(seen.ids[i]) else continue
            var fits = false
            if pick == PICK_PLAYER {
                fits = e.species == PLAYER and self.distance_sqr_to(e.x, e.y, e.z) <= within
            } else if pick == PICK_ADULT {
                fits = e.species == self.species and not e.baby
            } else {
                fits = e.species == self.species and self.in_love > 0 and e.in_love and not e.panicking
            }
            if fits and self.visible_at(mut seen, i, f, m, blocks) {
                out = some(e.id)
                break
            }
        }
        brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
        return out
    }

    // `Brain.tick` (CAL-160): its memories that may run out a tick nearer it,
    // `forgetOutdatedMemories`; each sensor that's due scanning, `tickSensors`; each behavior not
    // running of an activity that's on tried, `startEachNonRunningBehavior`; then each running as
    // the starts left them ticked, or stopped where it can't go on, `tickEachRunningBehavior`; all
    // in the brain's order at the level's game time, durations drawn from the level's random,
    // which its level lent it. A behavior that swung a door stops it there, for its level to set
    // the door as vanilla's sets it then and there, and finding the paths it's on again, before
    // it goes on with the next behavior, and one whose tick broke a block stops it for its level
    // to break it, before the next running behavior ticks: whether it stopped (CAL-160).
    fn tick_brain<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        var brain = self.brain.take() else return false
        let lent = self.level_random.take()
        let had = lent != none
        if not had {
            self.living.show(Shown.Missing(String("A brain's tick without its level's random")), sounds.len())
        }
        var random = lent ?? TapedRandom.new(0i64)
        let now = self.game_time
        // A stop of its sleep since its last tick, where the blocks around it weren't there.
        self.wake_if_due(mut brain, f, m, blocks, now, sounds)
        var runs = List<Run>()
        // The brain its behaviors were taken from, once a behavior's made it again, `refreshBrain`:
        // as vanilla's `Brain.tick` goes on over its own behaviors by its own activities, which
        // read and change the mob's new brain, `getBrain`.
        var old: Brain? = none
        var from: usize = 0
        var ticking: List<usize>? = none
        var tick_from: usize = 0
        if let held = self.held_brain.take() {
            runs = held.runs
            old = held.old
            from = held.at
            ticking = held.ticking
            tick_from = held.tick_at
        } else {
            brain.forget_outdated()
            for i in 0..brain.sensors.len() {
                if brain.sensor_due(i) {
                    let kind = brain.sensors[i].kind
                    if kind == SENSOR_NEAREST_BED {
                        self.sense_bed(mut brain, i, now, mut random, lf, f, m, blocks, mut cache, min_y)
                    } else {
                        self.sense(mut brain, kind, lf, f, m, blocks, players, sounds)
                    }
                }
            }
            runs = brain.take_runs()
        }
        for i in from..runs.len() {
            let on = if let o = old { o.is_active(runs[i].activity) } else { brain.is_active(runs[i].activity) }
            if not runs[i].deed.running and on {
                _ = self.try_start(mut brain, mut runs[i].deed, now, mut random, lf, f, m, blocks, items, mut cache, min_y, mut sounds)
                if self.refresh_due {
                    self.refresh_due = false
                    // `refreshBrain`: its behaviors running stopped, `stopAll`, and a brain made
                    // for its profession now with its memories, its schedule's activity on.
                    for j in 0..runs.len() {
                        if runs[j].deed.running {
                            self.do_stop(mut brain, mut runs[j].deed, mut random, mut sounds)
                        }
                    }
                    self.wake_if_due(mut brain, f, m, blocks, now, sounds)
                    var made = self.villager_brain()
                    made.unpack(brain.packed())
                    let scheduled = made.scheduled(self.villager_activity, self.baby_activity)
                    made.update_from_schedule(now, scheduled)
                    old = some(brain)
                    brain = made
                }
                if self.stop_due {
                    self.stop_due = false
                    self.held_brain = some(HeldBrain { runs: runs, at: i + 1, old: old })
                    self.brain = some(brain)
                    if had {
                        self.level_random = some(random)
                    }
                    return true
                }
            }
        }
        var running = List<usize>()
        if let held = ticking {
            running = held
        } else {
            for i in 0..runs.len() {
                if runs[i].deed.running {
                    running.push(i)
                }
            }
        }
        for k in tick_from..running.len() {
            let i = running[k]
            self.tick_or_stop(mut brain, mut runs[i].deed, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds)
            self.wake_if_due(mut brain, f, m, blocks, now, sounds)
            if self.stop_due {
                // A behavior's tick broke a block, which its level breaks then and there, its
                // drops drawn, before the next running behavior ticks (CAL-160).
                self.stop_due = false
                let all = runs.len()
                self.held_brain = some(HeldBrain { runs: runs, at: all, old: old, ticking: some(running), tick_at: k + 1 })
                self.brain = some(brain)
                if had {
                    self.level_random = some(random)
                }
                return true
            }
        }
        if old == none {
            brain.give_back_runs(runs)
        }
        self.brain = some(brain)
        if had {
            self.level_random = some(random)
        }
        return false
    }

    // The sensor of the kind `kind` scanning, `doTick`, after the range of the sensors' targeting
    // is set to its follow range, `updateTargetingConditionRanges`.
    fn sense<B: CollisionBlocks>(mut self, brain: mut Brain, kind: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, _sounds: List<EntitySound>) {
        let follow = self.living.attributes.value(lf.follow_range)
        self.sensor_range = follow
        if kind == SENSOR_NEAREST_LIVING {
            // `NearestLivingEntitySensor`: the living entities alive whose boxes meet its own grown
            // by its follow range, nearest first, and as its visible ones, none tested yet.
            let b = self.living.body.bounding_box()
            let (x0, y0, z0) = (b.min_x - follow, b.min_y - follow, b.min_z - follow)
            let (x1, y1, z1) = (b.max_x + follow, b.max_y + follow, b.max_z + follow)
            var found = List<(f64, i32)>()
            for n in self.near {
                if n.alive and n.id != self.living.body.id and n.bounds.intersects(x0, y0, z0, x1, y1, z1) {
                    found.push((self.distance_sqr_to(n.x, n.y, n.z), n.id))
                }
            }
            // An insertion sort by distance, stable as `List.sort` is.
            for i in 1..found.len() {
                var j = i
                while j > 0 {
                    let (a, _) = found[j - 1]
                    let (c, _) = found[j]
                    if a <= c {
                        break
                    }
                    found.swap(j - 1, j)
                    j -= 1
                }
            }
            var ids = List<i32>()
            var tested = List<i8>()
            for (_, id) in found {
                ids.push(id)
                tested.push(-1i8)
            }
            brain.set(MEMORY_NEAREST_LIVING_ENTITIES, Memo.Entities(ids.copy()))
            brain.set(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, Memo.Visible(Visible { ids: ids, seen: tested }))
        } else if kind == SENSOR_HURT_BY {
            // `HurtBySensor`: what last hurt it within 40 ticks, and the living entity behind it;
            // that one forgotten once it isn't alive or here.
            match self.living.recent_damage(self.game_time) {
                some(d) => {
                    let by = if d.player != none or d.living_cause { some(d.cause) } else { none }
                    brain.set(MEMORY_HURT_BY, Memo.Hurt(HurtMemo { kind: d.kind, tags: self.living.last_damage_tags, by: by }))
                    if let id = by {
                        brain.set(MEMORY_HURT_BY_ENTITY, Memo.Entity(id))
                    }
                },
                none => brain.erase(MEMORY_HURT_BY),
            }
            if let id = brain.entity(MEMORY_HURT_BY_ENTITY) {
                let alive = if let n = self.near_of(id) { n.alive } else { false }
                if not alive {
                    brain.erase(MEMORY_HURT_BY_ENTITY)
                }
            }
        } else if kind == SENSOR_FOOD_TEMPTATIONS {
            // `TemptingSensor.forAnimal`: of the level's players, not spectating, those its
            // `TEMPT_TARGETING` finds within its tempt range, sight not needed, holding its food in
            // either hand; the nearest, the first of those as near.
            let range = self.living.attributes.value(lf.tempt_range)
            let food = self.food_set()
            var best = -1.0
            var found: i32? = none
            for p in players {
                if p.spectator or p.dead or p.tempts & food == 0u32 {
                    continue
                }
                let within = (range * p.visibility(i32.wrap(self.living.kind))).max(2.0)
                let d = self.distance_sqr_to(p.x, p.y, p.z)
                if d > within * within {
                    continue
                }
                if found == none or d < best {
                    best = d
                    found = some(p.id)
                }
            }
            match found {
                some(id) => brain.set(MEMORY_TEMPTING_PLAYER, Memo.Entity(id)),
                none => brain.erase(MEMORY_TEMPTING_PLAYER),
            }
        } else if kind == SENSOR_NEAREST_ADULT {
            // `AdultSensor`: the nearest of its visible living entities of its kind that's grown.
            if brain.has(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) {
                match self.find_closest(mut brain, PICK_ADULT, 0.0, f, m, blocks) {
                    some(id) => brain.set(MEMORY_NEAREST_VISIBLE_ADULT, Memo.Entity(id)),
                    none => brain.erase(MEMORY_NEAREST_VISIBLE_ADULT),
                }
            }
        } else if kind == SENSOR_ARMADILLO_SCARE {
            // `MobSensor` of `Armadillo.isScaredBy`: where it can stay rolled up, danger seen for
            // 80 ticks where any of the living its sensor found scares it; else that forgotten.
            if not self.can_stay_rolled_up() {
                brain.erase(MEMORY_DANGER_DETECTED_RECENTLY)
            } else {
                var scared = false
                for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
                    if let n = self.near_of(id) {
                        if self.scared_by(n) {
                            scared = true
                            break
                        }
                    }
                }
                if scared {
                    brain.set_for(MEMORY_DANGER_DETECTED_RECENTLY, Memo.Flag(true), 80)
                }
            }
        } else if kind == SENSOR_NEAREST_PLAYERS {
            // `PlayerSensor`: the players not spectating nearer than its follow range, nearest
            // first, the nearest of them it may see, and of those it may see, those it may attack,
            // `isEntityAttackable`, and the nearest of them (CAL-200).
            var found = List<(f64, i32)>()
            for n in self.near {
                if n.species == PLAYER and not n.spectator {
                    let d = self.distance_sqr_to(n.x, n.y, n.z)
                    if d < follow * follow {
                        found.push((d, n.id))
                    }
                }
            }
            sort_nearest(mut found)
            var ids = List<i32>()
            for (_, id) in found {
                ids.push(id)
            }
            var visible: i32? = none
            var attackable = List<i32>()
            for id in ids {
                let n = self.near_of(id) else continue
                if self.targetable(f, m, blocks, n) {
                    if visible == none {
                        visible = some(id)
                    }
                    // `TargetingConditions.forCombat`: as it may see them, and may attack them,
                    // `canAttack`; teams come with scoreboards.
                    if can_attack_near(n) {
                        attackable.push(id)
                    }
                }
            }
            brain.set(MEMORY_NEAREST_PLAYERS, Memo.Entities(ids))
            match visible {
                some(id) => brain.set(MEMORY_NEAREST_VISIBLE_PLAYER, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_VISIBLE_PLAYER),
            }
            let first: i32? = if attackable.is_empty() { none } else { some(attackable[0]) }
            brain.set(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYERS, Memo.Entities(attackable))
            match first {
                some(id) => brain.set(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYER, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYER),
            }
        } else if kind == SENSOR_NEAREST_ITEMS {
            // `NearestItemSensor`: of the items its level found around it, nearest first, those
            // as near in the order found, the first it wants, nearer than 32, that it may see,
            // `hasLineOfSight`, its eyes to the item's; or none.
            var order = List<(f64, usize)>()
            for i in 0..self.near_items.len() {
                let n = self.near_items[i]
                if n.gone or not n.wanted {
                    continue
                }
                order.push((self.distance_sqr_to(n.x, n.y, n.z), i))
            }
            for i in 1..order.len() {
                var j = i
                while j > 0 {
                    let (p, _) = order[j - 1]
                    let (q, _) = order[j]
                    if p <= q {
                        break
                    }
                    order.swap(j - 1, j)
                    j -= 1
                }
            }
            var found: i32? = none
            let who = self.looker()
            for (d, i) in order {
                if not (d < 1024.0) {
                    continue
                }
                let n = self.near_items[i]
                if sees(m, f, blocks, who.mover, who.x, who.eye_y, who.z, n.x, n.y + f64(n.eyes), n.z) {
                    found = some(n.id)
                    break
                }
            }
            match found {
                some(id) => brain.set(MEMORY_NEAREST_VISIBLE_WANTED_ITEM, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_VISIBLE_WANTED_ITEM),
            }
        } else if kind == SENSOR_VILLAGER_HOSTILES {
            // `VillagerHostilesSensor`: the nearest of its visible living entities that's a
            // hostile within that kind's distance of it, or none.
            match self.find_closest_of(mut brain, PICK_HOSTILE, 0, -1.0, f, m, blocks) {
                some(id) => brain.set(MEMORY_NEAREST_HOSTILE, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_HOSTILE),
            }
        } else if kind == SENSOR_VILLAGER_BABIES {
            // `VillagerBabiesSensor`: its visible living entities that are baby villagers, which
            // it may see, in their order.
            var babies = List<i32>()
            if let held = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) {
                var seen = held
                for i in 0..seen.ids.len() {
                    let e = self.near_of(seen.ids[i]) else continue
                    if e.species == VILLAGER and e.baby and self.visible_at(mut seen, i, f, m, blocks) {
                        babies.push(e.id)
                    }
                }
                brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
            }
            brain.set(MEMORY_VISIBLE_VILLAGER_BABIES, Memo.Entities(babies))
        } else if kind == SENSOR_HOGLIN {
            // `HoglinSpecificSensor` (CAL-200): the first repellent, `#hoglin_repellents`, of the
            // blocks within 8 across and 4 up or down by Manhattan distance, in the order
            // `withinBoxByManhattanDistance` goes; then of its visible living entities it may see,
            // the grown piglins and hoglins, in their order: the first piglin, and how many, and the
            // hoglins, and how many.
            match self.nearest_repellent(f, blocks, lf.hoglin_repellents, false) {
                some(p) => brain.set(MEMORY_NEAREST_REPELLENT, Memo.Block(p)),
                none => brain.erase(MEMORY_NEAREST_REPELLENT),
            }
            var hoglins = List<i32>()
            var piglin: i32? = none
            var piglins = 0
            if let held = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) {
                var seen = held
                for j in 0..seen.ids.len() {
                    let e = self.near_of(seen.ids[j]) else continue
                    if (e.species == HOGLIN or e.species == PIGLIN) and not e.baby and self.visible_at(mut seen, j, f, m, blocks) {
                        if e.species == PIGLIN {
                            piglins += 1
                            if piglin == none {
                                piglin = some(e.id)
                            }
                        } else {
                            hoglins.push(e.id)
                        }
                    }
                }
                brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
            }
            let count = i32.wrap(hoglins.len())
            match piglin {
                some(id) => brain.set(MEMORY_NEAREST_VISIBLE_ADULT_PIGLIN, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_VISIBLE_ADULT_PIGLIN),
            }
            brain.set(MEMORY_NEAREST_VISIBLE_ADULT_HOGLINS, Memo.Entities(hoglins))
            brain.set(MEMORY_VISIBLE_ADULT_PIGLIN_COUNT, Memo.Int(piglins))
            brain.set(MEMORY_VISIBLE_ADULT_HOGLIN_COUNT, Memo.Int(count))
        } else if kind == SENSOR_PIGLIN_BRUTE {
            // `PiglinBruteSpecificSensor` (CAL-200): the nearest of its visible living entities it
            // may see that's a wither skeleton, its nemesis, as Calcite makes no withers; and of
            // the living near it, the grown piglins, `PiglinAi.findNearbyAdultPiglins`, in their
            // order: piglin brutes, all grown, and grown piglins.
            match self.find_closest_of(mut brain, PICK_SPECIES, WITHER_SKELETON, -1.0, f, m, blocks) {
                some(id) => brain.set(MEMORY_NEAREST_VISIBLE_NEMESIS, Memo.Entity(id)),
                none => brain.erase(MEMORY_NEAREST_VISIBLE_NEMESIS),
            }
            var piglins = List<i32>()
            for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
                if let e = self.near_of(id) {
                    if (e.species == PIGLIN_BRUTE or e.species == PIGLIN) and not e.baby {
                        piglins.push(id)
                    }
                }
            }
            brain.set(MEMORY_NEARBY_ADULT_PIGLINS, Memo.Entities(piglins))
        } else if kind == SENSOR_PIGLIN {
            // `PiglinSpecificSensor` (CAL-200): the first repellent, `#piglin_repellents`, a soul
            // campfire only lit, of the blocks within 8 across and 4 up or down by Manhattan
            // distance; then of its visible living entities it may see, in their order: the first
            // baby hoglin, the grown hoglins counted and the first that may be hunted; the grown
            // piglins and brutes; of the players, the first not wearing gold that it may attack,
            // `canAttack`, and the first not spectating holding what piglins love; the first wither
            // skeleton, its nemesis, as Calcite makes no withers; and the first zombified piglin or
            // zoglin. Then the grown piglins near it, `findNearbyAdultPiglins`.
            match self.nearest_repellent(f, blocks, lf.piglin_repellents, true) {
                some(p) => brain.set(MEMORY_NEAREST_REPELLENT, Memo.Block(p)),
                none => brain.erase(MEMORY_NEAREST_REPELLENT),
            }
            var nemesis: i32? = none
            var huntable: i32? = none
            var baby_hoglin: i32? = none
            var zombified: i32? = none
            var not_gold: i32? = none
            var holding: i32? = none
            var hoglins = 0
            var adults = List<i32>()
            if let held = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) {
                var seen = held
                for j in 0..seen.ids.len() {
                    let e = self.near_of(seen.ids[j]) else continue
                    if not self.visible_at(mut seen, j, f, m, blocks) {
                        continue
                    }
                    if e.species == HOGLIN {
                        if e.baby and baby_hoglin == none {
                            baby_hoglin = some(e.id)
                        } else if not e.baby {
                            hoglins += 1
                            if huntable == none and e.huntable {
                                huntable = some(e.id)
                            }
                        }
                    } else if e.species == PIGLIN_BRUTE {
                        adults.push(e.id)
                    } else if e.species == PIGLIN {
                        if not e.baby {
                            adults.push(e.id)
                        }
                    } else if e.species == PLAYER {
                        if not_gold == none and not e.gold_safe and can_attack_near(e) {
                            not_gold = some(e.id)
                        }
                        if holding == none and not e.spectator and e.loved {
                            holding = some(e.id)
                        }
                    } else if nemesis == none and e.species == WITHER_SKELETON {
                        nemesis = some(e.id)
                    } else if zombified == none and (e.species == ZOMBIFIED_PIGLIN or e.species == ZOGLIN) {
                        zombified = some(e.id)
                    }
                }
                brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
            }
            var near = List<i32>()
            for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
                if let e = self.near_of(id) {
                    if (e.species == PIGLIN_BRUTE or e.species == PIGLIN) and not e.baby {
                        near.push(id)
                    }
                }
            }
            for (memory, held) in [(MEMORY_NEAREST_VISIBLE_NEMESIS, nemesis), (MEMORY_NEAREST_VISIBLE_HUNTABLE_HOGLIN, huntable), (MEMORY_NEAREST_VISIBLE_BABY_HOGLIN, baby_hoglin), (MEMORY_NEAREST_VISIBLE_ZOMBIFIED, zombified), (MEMORY_NEAREST_TARGETABLE_PLAYER_NOT_WEARING_GOLD, not_gold), (MEMORY_NEAREST_PLAYER_HOLDING_WANTED_ITEM, holding)] {
                match held {
                    some(id) => brain.set(memory, Memo.Entity(id)),
                    none => brain.erase(memory),
                }
            }
            let count = i32.wrap(adults.len())
            brain.set(MEMORY_NEARBY_ADULT_PIGLINS, Memo.Entities(near))
            brain.set(MEMORY_NEAREST_VISIBLE_ADULT_PIGLINS, Memo.Entities(adults))
            brain.set(MEMORY_VISIBLE_ADULT_PIGLIN_COUNT, Memo.Int(count))
            brain.set(MEMORY_VISIBLE_ADULT_HOGLIN_COUNT, Memo.Int(hoglins))
        } else if kind == SENSOR_SECONDARY_POIS {
            // `SecondaryPoiSensor`: the blocks within 4 across and 2 up or down its profession
            // works at too, `secondaryPoi`, a farmer's farmland, x, then y, then z.
            let (_, profession, _) = self.living.data.villager(OWN + 1)
            var sites = List<GlobalPos>()
            if profession == FARMER {
                let farmland = f.block_named(String("minecraft:farmland")) ?? u32.MAX
                let (cx, cy, cz) = self.block_position()
                for x in -4..5 {
                    for y in -2..3 {
                        for z in -4..5 {
                            if f.block(state_at(blocks, cx + x, cy + y, cz + z)) == farmland {
                                sites.push(GlobalPos { dimension: self.dimension.copy(), pos: BlockPos { x: cx + x, y: cy + y, z: cz + z } })
                            }
                        }
                    }
                }
            }
            if sites.is_empty() {
                brain.erase(MEMORY_SECONDARY_JOB_SITE)
            } else {
                brain.set(MEMORY_SECONDARY_JOB_SITE, Memo.Places(sites))
            }
        } else if kind == SENSOR_GOLEM_DETECTED {
            // `GolemSensor`: an iron golem among the living its sensor found, a golem seen lately,
            // for 599 ticks, `golemDetected` (CAL-201).
            self.sense_golem(mut brain)
        }
    }

    // `GolemSensor.checkForNearbyGolem` (CAL-201): an iron golem among the living its sensor
    // found, `NEAREST_LIVING_ENTITIES`, a golem seen lately, for 599 ticks, `golemDetected`.
    fn sense_golem(self, brain: mut Brain) {
        if not brain.has(MEMORY_NEAREST_LIVING_ENTITIES) {
            return
        }
        for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            if let e = self.near_of(id) {
                if e.species == IRON_GOLEM {
                    brain.set_for(MEMORY_GOLEM_DETECTED_RECENTLY, Memo.Flag(true), 599)
                    return
                }
            }
        }
    }

    // `NearestBedSensor` of the sensor `i` (CAL-160): a baby's, its tries started again and the
    // game time it says it is drawn from the level's random, up to 19 ticks on; then the beds
    // within 48 of it, of those not tried lately, the first 4, each not tried again till 40 ticks
    // after that time; the nearest it can reach of them, `findPathToPois`, its nearest bed; else,
    // where it tried fewer than 5, those whose time's before then tried again.
    fn sense_bed<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, i: usize, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        if not self.baby() {
            return
        }
        var s = brain.sensors[i].copy()
        s.tried = 0
        s.last_update = now + i64(random.next_int_below(20))
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        var targets = List<(i32, i32, i32)>()
        for r in pois.in_range(types_of(1u32 << u32.wrap(HOME)), center, 48, Occupancy.Any) {
            let key = r.pos.pack()
            if s.tried_beds.contains(key) {
                continue
            }
            s.tried += 1
            if s.tried >= 5 {
                continue
            }
            s.tried_beds.insert(key, s.last_update + 40)
            targets.push((r.pos.x, r.pos.y, r.pos.z))
        }
        var found = false
        if not targets.is_empty() {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path_to_any(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, targets, 1) {
                if p.reached {
                    found = true
                    let (tx, ty, tz) = p.target
                    let target = BlockPos { x: tx, y: ty, z: tz }
                    if pois.type_at(target) != none {
                        brain.set(MEMORY_NEAREST_BED, Memo.Block(target))
                    }
                }
            }
        }
        if not found and s.tried < 5 {
            var stale = List<i64>()
            for (k, t) in s.tried_beds {
                if t < s.last_update {
                    stale.push(k)
                }
            }
            for k in stale {
                _ = s.tried_beds.remove(k)
            }
        }
        self.pois = some(pois)
        brain.sensors[i] = s
    }

    // `NearestVisibleLivingEntities.findClosest` of a kind (CAL-160): the nearest of its brain's
    // visible living entities that `pick` fits, within `within` squared of it where that isn't
    // below 0, which it may see, its sight tested only of those that fit, in their order:
    // `PICK_SPECIES` one of the kind `which`, `PICK_CATEGORY` one of the mob category `which`, and
    // `PICK_HOSTILE` a hostile a villager fears within that kind's distance of it.
    fn find_closest_of<B: CollisionBlocks>(mut self, brain: mut Brain, pick: i32, which: i32, within: f64, f: Facts, m: MovementStates, blocks: B) -> i32? {
        var seen = brain.lend_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES) else return none
        var out: i32? = none
        for i in 0..seen.ids.len() {
            let e = self.near_of(seen.ids[i]) else continue
            let d = self.distance_sqr_to(e.x, e.y, e.z)
            var fits = false
            if pick == PICK_SPECIES {
                fits = e.species == which
            } else if pick == PICK_BREEDABLE {
                fits = e.species == which and e.can_breed
            } else if pick == PICK_CATEGORY {
                fits = e.category == which
            } else if pick == PICK_ANY {
                fits = true
            } else if pick == PICK_LOVED {
                fits = e.species == PLAYER and e.loved
            } else if pick == PICK_ZOGLIN_PREY {
                // `Sensor.isEntityAttackable`: its invisibility not tested where it's its target.
                var a = e
                if brain.entity(MEMORY_ATTACK_TARGET) == some(e.id) {
                    a.visibility = 1.0
                }
                fits = e.species != ZOGLIN and e.species != CREEPER and can_attack_near(a) and self.targetable(f, m, blocks, a)
            } else {
                let h = hostile_distance(e.species)
                fits = h > 0.0 and d <= h * h
            }
            if fits and within >= 0.0 {
                fits = d <= within
            }
            if fits and self.visible_at(mut seen, i, f, m, blocks) {
                out = some(e.id)
                break
            }
        }
        brain.give_back_visible(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, seen)
        return out
    }

    // `Armadillo.isScaredBy`: what's within 7 across and 2 up or down of its box, and undead, or
    // what last hurt it, or a player not spectating who sprints or rides.
    fn scared_by(self, n: Near) -> bool {
        let b = self.living.body.bounding_box()
        if not n.bounds.intersects(b.min_x - 7.0, b.min_y - 2.0, b.min_z - 7.0, b.max_x + 7.0, b.max_y + 2.0, b.max_z + 7.0) {
            return false
        }
        if n.undead {
            return true
        }
        if let by = self.living.hurt_by_mob {
            if by == n.uuid {
                return true
            }
        }
        if n.species == PLAYER {
            return not n.spectator and (n.sprinting or n.passenger)
        }
        return false
    }

    // `tryStart` of the behavior `d` at the game time `now`, as its kind starts: a gate where it
    // has its memories, shuffled, the first of its behaviors not running that starts, or a
    // `TriggerGate`'s first that has its memories and does what it does; any other where it has its
    // memories and its kind's conditions hold, its duration drawn and its start.
    fn try_start<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, brain: mut Brain, d: mut Deed, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if let Behavior.Gate(_) = d.kind {
            var g = d.gate.take() else return false
            if not brain.meets(g.needs) {
                d.gate = some(g)
                return false
            }
            // A sequence after `triggerIf(Entity::isPassenger)` goes no further where it rides
            // nothing, its gate not shuffled (CAL-200).
            if g.passenger and self.living.body.vehicle == none {
                d.gate = some(g)
                return false
            }
            // A sequence after `triggerIf(raidExistsAndNotVictory)` goes no further where there's
            // no won raid there (CAL-167).
            if g.raid_won {
                let won = if let r = raid_at(self.raids_near, self.block_position()) { r.over and not r.loss } else { false }
                if not won {
                    d.gate = some(g)
                    return false
                }
            }
            d.running = true
            if not g.ordered {
                g.shuffle()
            }
            if g.trigger {
                for i in 0..g.entries.len() {
                    let kind = g.entries[i].deed.kind
                    if brain.meets(entry_of(g.entries[i].deed)) and self.may_start(mut brain, kind, mut g.entries[i].deed.keep, now, mut random, lf, f, m, blocks, items, mut cache, min_y, mut sounds) {
                        break
                    }
                }
                d.gate = some(g)
                return true
            }
            for i in 0..g.entries.len() {
                if not g.entries[i].deed.running and self.try_start(mut brain, mut g.entries[i].deed, now, mut random, lf, f, m, blocks, items, mut cache, min_y, mut sounds) {
                    break
                }
            }
            d.gate = some(g)
            return true
        }
        if not brain.meets(entry_of(d)) {
            return false
        }
        let kind = d.kind
        if not self.may_start(mut brain, kind, mut d.keep, now, mut random, lf, f, m, blocks, items, mut cache, min_y, mut sounds) {
            return false
        }
        d.running = true
        if timed(kind) {
            start_deed(mut d, now, mut random)
            self.start_behavior(mut brain, kind, mut d.keep, now, mut random, lf, f, m, blocks, min_y, mut sounds)
        }
        return true
    }

    // Whether the behavior of the kind `kind` may start, `checkExtraStartConditions`, or a
    // one-shot's trigger, which does what it does then and there.
    fn may_start<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        match kind {
            Behavior.Swim(_) => return self.floats(),
            Behavior.Panic(_) => {
                // `AnimalPanic`'s: hurt by what panics it, an armadillo
                // `#panic_environmental_causes`, or panicking.
                if let h = brain.hurt(MEMORY_HURT_BY) {
                    if h.tags & PANIC_ENVIRONMENTAL_CAUSES != 0u32 {
                        return true
                    }
                }
                return brain.has(MEMORY_IS_PANICKING)
            },
            Behavior.MoveToTarget(armadillo) => {
                if armadillo and self.scared() {
                    return false
                }
                if keep.cooldown > 0 {
                    keep.cooldown -= 1
                    return false
                }
                let walk = brain.walk(MEMORY_WALK_TARGET) else return false
                let reached = self.reached(walk)
                if not reached and self.compute_path(mut brain, walk, mut keep, now, lf, f, m, blocks, mut cache, min_y) {
                    keep.last_target = self.tracked_block(walk.target)
                    return true
                }
                brain.erase(MEMORY_WALK_TARGET)
                if reached {
                    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                }
                return false
            },
            Behavior.RollOut(_) => {
                if self.scared() {
                    self.roll_out(mut sounds)
                    return true
                }
                return false
            },
            Behavior.LookSometimes(look) => {
                // An armadillo's at players, a hoglin's at anything living (CAL-200).
                let near = if look.player { self.find_closest(mut brain, PICK_PLAYER, f64(look.max_dist_sqr), f, m, blocks) } else { self.find_closest_of(mut brain, PICK_ANY, 0, f64(look.max_dist_sqr), f, m, blocks) }
                let found = near else return false
                // `Ticker.tickDownAndCheck`: at 0, its count drawn from the level's random less
                // one, not yet; else down one, and now where that's 0.
                if keep.ticks == 0 {
                    keep.ticks = random.next_int_between(look.min_interval, look.max_interval) - 1
                    return false
                }
                keep.ticks -= 1
                if keep.ticks != 0 {
                    return false
                }
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: found, eyes: true })))
                return true
            },
            // `AnimalMakeLove.checkExtraStartConditions`: in love, with a partner it sees,
            // `findValidBreedPartner`.
            Behavior.MakeLove(_) => return self.in_love > 0 and self.find_closest(mut brain, PICK_PARTNER, 0.0, f, m, blocks) != none,
            Behavior.FollowAdult(follow) => {
                let (least, most, speed) = follow
                if not self.baby() {
                    return false
                }
                let adult = brain.entity(MEMORY_NEAREST_VISIBLE_ADULT) else return false
                let n = self.near_of(adult) else return false
                let d = self.distance_sqr_to(n.x, n.y, n.z)
                let far = f64(most + 1)
                let near = f64(least)
                if d < far * far and not (d < near * near) {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: adult, eyes: false }), speed: speed, close_enough: least - 1 }))
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: adult, eyes: true })))
                    return true
                }
                return false
            },
            Behavior.Stroll(speed) => {
                match self.random_place(true, 10, 7, lf, f, blocks, mut cache, min_y) {
                    some(p) => {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                    },
                    none => brain.erase(MEMORY_WALK_TARGET),
                }
                return true
            },
            Behavior.WalkToLook(walk) => {
                let (speed, close) = walk
                let t = brain.tracker(MEMORY_LOOK_TARGET) else return false
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: t, speed: speed, close_enough: close }))
                return true
            },
            Behavior.BallUp(_) => return self.living.body.on_ground and not self.in_liquid(),
            Behavior.Doors(_) => {
                // `InteractWithDoor` (CAL-160): where the path its `PATH` memory holds is started
                // and not done, the same next node as it last checked counted 20 again, else
                // nothing while that counts down; then the door at the node it last passed opened
                // where it's shut, and kept to close, and the one at its next node opened and kept
                // where it's shut; then those it keeps closed behind it, `close_doors`. What it
                // swings its level does as its brain's tick stops for it, before the rest.
                let id = brain.path(MEMORY_PATH) else return false
                let about = self.navigation.about_path(id) else return false
                let (passed, ahead) = about
                var same = false
                if let last = keep.last_node {
                    same = last == ahead
                }
                if same {
                    keep.cooldown = 20
                } else {
                    keep.cooldown -= 1
                    if keep.cooldown > 0 {
                        return false
                    }
                }
                keep.last_node = some(ahead)
                var swung = List<(i32, i32, i32, u32)>()
                let (ax, ay, az) = passed
                let from_state = door_state(blocks, swung, ax, ay, az)
                if mob_door(f, from_state) {
                    if not f.get_bool(from_state, "open") {
                        self.swing_door(f, blocks, mut swung, passed, from_state, true, mut random, mut sounds)
                    }
                    remember_door(mut brain, self.dimension, passed)
                }
                let (bx, by, bz) = ahead
                let to_state = door_state(blocks, swung, bx, by, bz)
                if mob_door(f, to_state) and not f.get_bool(to_state, "open") {
                    self.swing_door(f, blocks, mut swung, ahead, to_state, true, mut random, mut sounds)
                    remember_door(mut brain, self.dimension, ahead)
                }
                if brain.has(MEMORY_DOORS_TO_CLOSE) {
                    self.close_doors(mut brain, some(passed), some(ahead), f, blocks, mut swung, mut random, mut sounds)
                }
                return true
            },
            // `ReactToBell`: having heard a bell, and with no raid where it is, `getRaidAt`, its
            // hiding on where it may hide, else its default activity (CAL-167).
            Behavior.ReactToBell(_) => {
                if raid_at(self.raids_near, self.block_position()) == none {
                    brain.set_if_possible(ACTIVITY_HIDE)
                }
                return true
            },
            Behavior.HideState(h) => return self.hide_state(mut brain, mut keep, h, now),
            Behavior.LocateHiding(l) => return self.locate_hiding(mut brain, l),
            Behavior.RaidHide(l) => {
                let active = if let r = raid_at(self.raids_near, self.block_position()) { not r.over } else { false }
                return active and self.locate_hiding(mut brain, l)
            },
            // `SetRaidStatus`: one tick in 20, drawn from the level's random, where there's a raid
            // there, `getRaidAt`, its raid activity its default and on where it may, once a wave's
            // come and it isn't between waves, else its pre-raid activity (CAL-167).
            // `ResetRaidStatus`: one tick in 20, drawn from the level's random, where there's no
            // raid there, `getRaidAt`, or it's lost, idle its default activity and its schedule's
            // activity on (CAL-167).
            // `RingBell`: where a draw from the level's random is over 0.95, its meeting point,
            // by its place alone, a bell rung where it's within 3 of its own block and still a
            // bell, `Shown.Rang`, by its level (CAL-167).
            // `MoveToSkySeeingSpot`: where it can't see the sky, of ten places drawn from its
            // random, up to 10 across and 3 up or down of its block, the first under the sky and
            // not under the top of its column, its bottom middle walked to at the speed, near
            // enough within 0 (CAL-167).
            Behavior.SkySpot(speed) => {
                let (bx, by, bz) = self.block_position()
                if blocks.sees_sky(bx, by, bz) {
                    return false
                }
                for _ in 0..10 {
                    let x = bx + self.living.body.random.next_int_below(20) - 10
                    let y = by + self.living.body.random.next_int_below(6) - 3
                    let z = bz + self.living.body.random.next_int_below(20) - 10
                    if self.open_to_sky(blocks, x, y, z) {
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(f64(x) + 0.5, f64(y), f64(z) + 0.5, speed, 0)))
                        break
                    }
                }
                return true
            },
            // `CelebrateVillagersSurvivedRaid.checkExtraStartConditions`: a won raid there,
            // `getRaidAt`, kept, and it open to the sky (CAL-167).
            Behavior.RaidCelebrate(_) => {
                let (bx, by, bz) = self.block_position()
                let r = raid_at(self.raids_near, (bx, by, bz)) else return false
                keep.raid = some(r.id)
                return r.over and not r.loss and self.open_to_sky(blocks, bx, by, bz)
            },
            Behavior.RingBell(_) => {
                if random.next_float() <= 0.95f32 {
                    return false
                }
                let g = brain.place(MEMORY_MEETING_POINT) else return true
                let (bx, by, bz) = self.block_position()
                let (dx, dy, dz) = (f64(g.pos.x - bx), f64(g.pos.y - by), f64(g.pos.z - bz))
                if dx * dx + dy * dy + dz * dz < 9.0 and f.is_a(f.block(state_at(blocks, g.pos.x, g.pos.y, g.pos.z)), "BellBlock") {
                    self.living.show(Shown.Rang((g.pos.x, g.pos.y, g.pos.z)), sounds.len())
                }
                return true
            },
            Behavior.RaidReset(_) => {
                if random.next_int_below(20) != 0 {
                    return false
                }
                let gone = if let r = raid_at(self.raids_near, self.block_position()) { r.loss } else { true }
                if gone {
                    brain.default_activity = ACTIVITY_IDLE
                    let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
                    brain.update_from_schedule(now, scheduled)
                }
                return true
            },
            Behavior.RaidStatus(_) => {
                if random.next_int_below(20) != 0 {
                    return false
                }
                if let r = raid_at(self.raids_near, self.block_position()) {
                    let a = if r.groups_spawned > 0 and not r.between { ACTIVITY_RAID } else { ACTIVITY_PRE_RAID }
                    brain.default_activity = a
                    brain.set_if_possible(a)
                }
                return true
            },
            Behavior.ValidatePoi(v) => {
                let (memory, kinds) = v
                return self.validate_poi(mut brain, memory, kinds, f, blocks)
            },
            Behavior.CompetitorScan(_) => {
                self.scan_competitors(mut brain)
                return true
            },
            Behavior.FollowTrader(_) => return self.follows_trader(),
            Behavior.GoToItem(g) => {
                // `GoToWantedItem`: the item it wants, where it's waited out its pickup cooldown,
                // nearer than so many blocks, its block within the world border, and it may pick
                // things up, `canPickUpLoot`, looked at and walked to.
                let (speed, _, within) = g
                let id = brain.entity(MEMORY_NEAREST_VISIBLE_WANTED_ITEM) else return false
                if brain.has(MEMORY_ITEM_PICKUP_COOLDOWN_TICKS) {
                    return false
                }
                let n = self.near_of(id) else return false
                if not (self.distance_sqr_to(n.x, n.y, n.z) < f64(within * within)) {
                    return false
                }
                let (west, north, east, south) = self.border ?? widest_border()
                let bx = f64(floor_of(n.x))
                let bz = f64(floor_of(n.z))
                if not (bx >= west and bx < east and bz >= north and bz < south) or not self.can_pick_up_loot {
                    return false
                }
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: speed, close_enough: 0 }))
                return true
            },
            Behavior.AcquirePoi(a) => return self.acquire_poi(mut brain, a, mut keep, now, mut random, lf, f, m, blocks, mut cache, min_y, sounds),
            Behavior.GoToJobSite(_) => {
                // `GoToPotentialJobSite.checkExtraStartConditions`: its activity other than its
                // core one idle, work or play, or none.
                return match brain.active_non_core() {
                    some(a) => a == ACTIVITY_IDLE or a == ACTIVITY_WORK or a == ACTIVITY_PLAY,
                    none => true,
                }
            },
            Behavior.YieldJobSite(speed) => return self.yield_job_site(mut brain, speed, sounds),
            Behavior.AssignProfession(_) => return self.assign_profession(mut brain, sounds),
            Behavior.ResetProfession(_) => {
                // `ResetProfession`: one with a profession, but a nitwit, no experience and at
                // level 1 at most, with no job site, losing it, its brain made again.
                let (vtype, profession, level) = self.living.data.villager(OWN + 1)
                if profession == NO_PROFESSION or profession == NITWIT or self.villager_xp != 0 or level > 1 {
                    return false
                }
                self.set_profession(vtype, NO_PROFESSION, level)
                return true
            },
            Behavior.InteractWith(i) => {
                // `InteractWith.of`: where it may, `selfFilter`, any of the kind among its visible
                // living entities it may see that may be, `targetFilter`; the nearest such within
                // its range, if any, its target, looked at and walked to till it's as near as it
                // stops. Breeding's filters are both `canBreed`.
                if i.breed and not self.villager_can_breed() {
                    return false
                }
                let pick = if i.breed { PICK_BREEDABLE } else { PICK_SPECIES }
                if self.find_closest_of(mut brain, pick, i.species, -1.0, f, m, blocks) == none {
                    return false
                }
                let range = f64(i.range * i.range)
                if let id = self.find_closest_of(mut brain, pick, i.species, range, f, m, blocks) {
                    brain.set(i.memory, Memo.Entity(id))
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: i.speed, close_enough: i.stop }))
                }
                return true
            },
            Behavior.VillageStroll(s) => {
                let (speed, h, v) = s
                match self.village_stroll_place(h, v, lf, f, blocks, mut cache, min_y) {
                    some(p) => {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                    },
                    none => brain.erase(MEMORY_WALK_TARGET),
                }
                return true
            },
            // `JumpOnBed.checkExtraStartConditions`: a baby near a bed, as one with its nearest bed
            // always is.
            Behavior.JumpOnBed(_) => return self.baby(),
            Behavior.HeroGift(_) => {
                // `GiveGiftToHero.checkExtraStartConditions` (CAL-395): the nearest player it sees
                // a hero of the village, then its wait for its next gift out, a tick less each
                // time it's asked.
                if self.nearest_hero(brain) == none {
                    return false
                }
                if keep.gift_in > 0 {
                    keep.gift_in -= 1
                    return false
                }
                return true
            },
            Behavior.LookAndInteract(range) => {
                // `SetLookAndInteract`: the nearest player it may see within `range`, its target,
                // looked at.
                let within = f64(range * range)
                let id = self.find_closest_of(mut brain, PICK_SPECIES, PLAYER, within, f, m, blocks) else return false
                brain.set(MEMORY_INTERACTION_TARGET, Memo.Entity(id))
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                return true
            },
            Behavior.ShowTrades(_) => return self.shows_trades(brain),
            Behavior.TradeWithVillager(_) => return self.trades_with(mut brain, f, m, blocks),
            Behavior.VillagerLove(_) => return self.breeding_possible(mut brain, f, m, blocks),
            Behavior.LookAt(l) => {
                // `SetEntityLookTarget`: the nearest it may see within its distance of the kind or
                // mob category it looks at, looked at.
                let within = f64(l.max_dist * l.max_dist)
                let by_category = l.species == -100
                // Anything living, a piglin brute's `SetEntityLookTarget.create(8.0F)` (CAL-200).
                // A player holding what piglins love, a piglin's `isPlayerHoldingLovedItem` (CAL-200).
                let pick = if l.species == LOOK_ANY { PICK_ANY } else if l.species == LOOK_LOVED { PICK_LOVED } else if by_category { PICK_CATEGORY } else { PICK_SPECIES }
                let which = if by_category { l.category } else { l.species }
                let id = self.find_closest_of(mut brain, pick, which, within, f, m, blocks) else return false
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                return true
            },
            Behavior.Schedule(_) => {
                // `UpdateActivityFromSchedule`.
                let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
                brain.update_from_schedule(now, scheduled)
                return true
            },
            Behavior.CalmDown(_) => {
                // `VillagerCalmDown`: where it's no longer hurt, sees no hostile, and what hurt it
                // is farther than 6 or gone, those forgotten and its schedule gone by.
                var scared = brain.has(MEMORY_HURT_BY) or brain.has(MEMORY_NEAREST_HOSTILE)
                if not scared {
                    if let id = brain.entity(MEMORY_HURT_BY_ENTITY) {
                        if let n = self.near_of(id) {
                            scared = self.distance_sqr_to(n.x, n.y, n.z) <= 36.0
                        }
                    }
                }
                if not scared {
                    brain.erase(MEMORY_HURT_BY)
                    brain.erase(MEMORY_HURT_BY_ENTITY)
                    let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
                    brain.update_from_schedule(now, scheduled)
                }
                return true
            },
            Behavior.AwayFrom(a) => {
                // `SetWalkTargetAwayFrom.entity`, not interrupting a walk: where it has none and
                // what the memory holds is nearer than `dist`, of 10 tries, the first place found
                // up to 16 away from it, `LandRandomPos.getPosAway`, walked to.
                let (memory, speed, dist) = a
                if brain.walk(MEMORY_WALK_TARGET) != none {
                    return false
                }
                let id = brain.entity(memory) else return false
                let n = self.near_of(id) else return false
                if not (self.distance_sqr_to(n.x, n.y, n.z) < f64(dist * dist)) {
                    return false
                }
                for _ in 0..10 {
                    if let p = self.pos_away(lf, f, blocks, mut cache, min_y, 0.0, 16.0, (n.x, n.y, n.z)) {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                        break
                    }
                }
                return true
            },
            Behavior.Pacify(p) => {
                // `BecomePassiveIfMemoryPresent` (CAL-200): pacified for its ticks, its target
                // forgotten.
                let (_, ticks) = p
                brain.set_for(MEMORY_PACIFIED, Memo.Flag(true), i64(ticks))
                brain.erase(MEMORY_ATTACK_TARGET)
                return true
            },
            Behavior.AwayFromBlock(a) => {
                let (memory, speed, dist, interrupt) = a
                let p = brain.block(memory) else return false
                return self.walk_away(mut brain, (f64(p.x) + 0.5, f64(p.y), f64(p.z) + 0.5), speed, dist, interrupt, lf, f, blocks, mut cache, min_y)
            },
            Behavior.AdultAwayFrom(a) => {
                // `triggerIf(Hoglin::isAdult, ...)`: grown, then the walk away (CAL-200).
                if self.baby() {
                    return false
                }
                let (memory, speed, dist) = a
                let id = brain.entity(memory) else return false
                let n = self.near_of(id) else return false
                return self.walk_away(mut brain, (n.x, n.y, n.z), speed, dist, false, lf, f, blocks, mut cache, min_y)
            },
            Behavior.StartAttacking(finder) => {
                if finder == FIND_PIGLIN {
                    // `StartAttacking` with a piglin's finder (CAL-200), grown only,
                    // `piglin_finds`; its target, its trouble reaching one forgotten.
                    if self.baby() {
                        return false
                    }
                    let id = self.piglin_finds(brain, f, m, blocks) else return false
                    brain.set(MEMORY_ATTACK_TARGET, Memo.Entity(id))
                    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                    return true
                }
                if finder == FIND_BRUTE {
                    // `StartAttacking` with a piglin brute's finder (CAL-200), `brute_finds`; its
                    // target, its trouble reaching one forgotten.
                    let id = self.brute_finds(brain) else return false
                    brain.set(MEMORY_ATTACK_TARGET, Memo.Entity(id))
                    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                    return true
                }
                if finder == FIND_ZOGLIN {
                    // `StartAttacking` with a zoglin's finder, `findNearestValidAttackTarget`
                    // (CAL-200): the nearest of the living entities it sees, but a zoglin or a
                    // creeper, that it may attack, `isEntityAttackable`; its target, its trouble
                    // reaching one forgotten.
                    let id = self.find_closest_of(mut brain, PICK_ZOGLIN_PREY, 0, -1.0, f, m, blocks) else return false
                    brain.set(MEMORY_ATTACK_TARGET, Memo.Entity(id))
                    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                    return true
                }
                // `StartAttacking` with a hoglin's finder, `findNearestValidAttackTarget` (CAL-200):
                // neither pacified nor breeding, the nearest visible player it may attack, which
                // it may, `canAttack`, its target, its trouble reaching one forgotten.
                if brain.has(MEMORY_PACIFIED) or brain.has(MEMORY_BREED_TARGET) {
                    return false
                }
                let id = brain.entity(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYER) else return false
                let n = self.near_of(id) else return false
                if not can_attack_near(n) {
                    return false
                }
                brain.set(MEMORY_ATTACK_TARGET, Memo.Entity(id))
                brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                return true
            },
            Behavior.ToAttackTarget(speed) => {
                // `SetWalkTargetFromAttackTargetIfTargetOutOfReach` (CAL-200): its target within
                // its reach and among those it sees, its walk forgotten; else looked at and walked
                // to.
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return false
                var reached = false
                if let n = self.near_of(id) {
                    reached = self.sees_near(mut brain, id, f, m, blocks) and self.attack_range_reaches(n, 1)
                }
                if reached {
                    brain.erase(MEMORY_WALK_TARGET)
                } else {
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: speed, close_enough: 0 }))
                }
                return true
            },
            Behavior.Melee(a) => {
                // `MeleeAttack` (CAL-200), for those of its kind its `triggerIf` lets: its target
                // within its reach and among those it sees looked at, its main hand swung and the
                // target hit, `doHurtTarget`, which its level deals then and there, its brain's
                // tick stopped for it; then cooling down for its ticks. A hoglin's attack sound's
                // pitch is drawn as it hits, `makeSound`.
                let (cooldown, who) = a
                if (who == WHO_ADULT and self.baby()) or (who == WHO_BABY and not self.baby()) {
                    return false
                }
                // Not where it holds what it may use from afar, a piglin a crossbow or a spear,
                // `isHoldingUsableNonMeleeWeapon`.
                if self.species == PIGLIN and (self.holding_crossbow() or self.holds_spear(lf)) {
                    return false
                }
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return false
                let n = self.near_of(id) else return false
                if not self.melee_reaches(n.bounds) or not self.sees_near(mut brain, id, f, m, blocks) {
                    return false
                }
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                self.swing_for_attack(sounds.len())
                if self.species == HOGLIN or self.species == ZOGLIN {
                    self.attack_pitch = self.voice_pitch()
                }
                let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                self.living.show(Shown.Attack((id, ax, ay, az)), sounds.len())
                self.stop_due = true
                brain.set_for(MEMORY_ATTACK_COOLING_DOWN, Memo.Flag(true), i64(cooldown))
                return true
            },
            Behavior.StopAttacking(condition) => {
                // `StopAttackingIfTargetInvalid` (CAL-200): its target forgotten where it may no
                // longer attack it, has tried to reach it for over 200 ticks, or it's dead or
                // gone from its level; a piglin brute's where it's no longer what it would find,
                // `isNearestValidAttackTarget`.
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return false
                var valid = false
                if let n = self.near_of(id) {
                    var tired = false
                    if let since = brain.long(MEMORY_CANT_REACH_WALK_TARGET_SINCE) {
                        tired = now - since > 200
                    }
                    valid = can_attack_near(n) and not tired and n.alive
                    if valid and condition == STOP_UNLESS_BRUTE_FINDS {
                        valid = self.brute_finds(brain) == some(id)
                    }
                    if valid and condition == STOP_UNLESS_PIGLIN_FINDS {
                        valid = self.piglin_finds(brain, f, m, blocks) == some(id)
                    }
                }
                if not valid {
                    brain.erase(MEMORY_ATTACK_TARGET)
                }
                return true
            },
            Behavior.StopAnger(_) => {
                // `StopBeingAngryIfTargetDead` (CAL-200): what it's angry at forgotten where it's
                // near and dead or dying, a player only where the game rule
                // `forgive_dead_players` forgives them.
                if let u = brain.uuid(MEMORY_ANGRY_AT) {
                    if let n = self.near_with_uuid(u) {
                        if not n.alive and (n.species != PLAYER or self.forgive_dead_players) {
                            brain.erase(MEMORY_ANGRY_AT)
                        }
                    }
                }
                return true
            },
            Behavior.EraseIf(e) => {
                // `EraseMemoryIf` (CAL-200): a hoglin's breeding, `isBreeding`, or calm, grown
                // where piglins don't outnumber its hoglins, `wantsToStopFleeing`.
                let (which, memory) = e
                let holds = if which == ERASE_IF_BREEDING { brain.has(MEMORY_BREED_TARGET) } else if which == ERASE_IF_NEAR_ZOMBIFIED { self.near_zombified(brain) } else if which == ERASE_IF_PIGLIN_CALM { self.piglin_calm(brain) } else { not self.baby() and not self.piglins_outnumber(brain) }
                if not holds {
                    return false
                }
                brain.erase(memory)
                return true
            },
            Behavior.CopyMemory(c) => {
                // `CopyMemoryWithExpiry` (CAL-200): where its predicate holds, a piglin's being a
                // baby, a baby whose ticker says now, or near a zombified, the entity the source
                // holds kept in the target for ticks drawn from the level's random.
                let holds = if c.when == COPY_IF_BABY { self.baby() } else if c.when == COPY_IF_BABY_SOMETIMES { self.baby() and tick_down_and_check(mut keep, 200, 800, mut random) } else { self.near_zombified(brain) }
                if not holds {
                    return false
                }
                let id = brain.entity(c.source) else return false
                let ticks = random.next_int_between(c.min, c.max)
                brain.set_for(c.target, Memo.Entity(id), i64(ticks))
                return true
            },
            Behavior.Mount(speed) => {
                // `Mount` (CAL-200): not where it rides something; what it's to ride boarded where
                // it's within 1, `startRiding`, which its level does then and there, its brain
                // stopped till it has; else looked at and walked to at the speed, to within 1.
                if self.living.body.vehicle != none {
                    return false
                }
                let id = brain.entity(MEMORY_RIDE_TARGET) else return false
                let n = self.near_of(id) else return false
                if self.distance_sqr_to(n.x, n.y, n.z) < 1.0 {
                    self.living.show(Shown.Mount(id), sounds.len())
                    self.stop_due = true
                } else {
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: speed, close_enough: 1 }))
                }
                return true
            },
            Behavior.Dismount(most) => {
                // `DismountOrSkipMounting` (CAL-200): what it rides, else what it's to ride, kept
                // where it's alive and nearer than `most`, and it doesn't want to stop riding it,
                // `wantsToStopRiding`: a grown one, dead, either of them hurt recently, `HURT_BY`,
                // or a piglin riding nothing; else it gets off, `stopRiding`, which its level does
                // then and there, its brain stopped till it has, and it's forgotten.
                let current = self.living.body.vehicle
                let to_ride = brain.entity(MEMORY_RIDE_TARGET)
                let vehicle = if let c = current { c } else if let t = to_ride { t } else { return false }
                if let n = self.near_of(vehicle) {
                    let valid = n.alive and self.distance_sqr_to(n.x, n.y, n.z) < f64(most * most)
                    let stop = not n.baby or not n.alive or brain.has(MEMORY_HURT_BY) or n.hurt_by or (n.species == PIGLIN and not n.passenger)
                    if valid and not stop {
                        return false
                    }
                }
                if current != none {
                    self.living.show(Shown.Dismount(vehicle), sounds.len())
                    self.stop_due = true
                }
                brain.erase(MEMORY_RIDE_TARGET)
                return true
            },
            Behavior.Always(_) => return true,
            Behavior.StopHolding(_) => {
                // `StopHoldingItemIfNoLongerAdmiring` (CAL-200): what it holds in its off hand, but a
                // shield, given up, bartering, `stopHoldingOffHandItem`: a barter's items rolled by
                // its level and thrown, its off hand swung first, toward the nearest player it sees
                // or a place near, a baby's main hand's thrown there and what it gave up held there.
                let held = self.living.equipment[1].copy() else return false
                if held_name(some(held)) == "minecraft:shield" {
                    return false
                }
                let (thrown, barter, then) = self.give_up_off_hand(true, lf, f, items, mut sounds)
                if barter or not thrown.is_empty() {
                    let (tx, ty, tz) = self.throw_toward(brain, lf, f, blocks, mut cache, min_y)
                    self.swing_off_hand(sounds.len())
                    if barter {
                        let offer = Barter { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, lift: f64(self.living.body.eyes) - f64(0.3f32), to: (tx, ty + 1.0, tz), thrower: self.living.body.uuid }
                        self.living.show(Shown.Barter(offer), sounds.len())
                    }
                    for s in thrown {
                        self.throw_item(s.copy(), (tx, ty + 1.0, tz), sounds)
                    }
                }
                if let main = then {
                    // `Piglin.holdInMainHand`: held there, sure to drop, and kept.
                    self.equip_in(items, 0, main, mut sounds)
                    self.guarantee_drop(0)
                    self.persistence_required = true
                }
                return true
            },
            Behavior.StartAdmiring(_) => {
                // `StartAdmiringItemIfSeen` (CAL-200): the nearest wanted item it sees one piglins
                // love, admired for its ticks.
                let id = brain.entity(MEMORY_NEAREST_VISIBLE_WANTED_ITEM) else return false
                let n = self.near_of(id) else return false
                if not n.loved {
                    return false
                }
                brain.set_for(MEMORY_ADMIRING_ITEM, Memo.Flag(true), 119)
                return true
            },
            Behavior.GoToLoved(g) => {
                // A piglin's `GoToWantedItem` where it holds nothing it loves in its off hand,
                // `isNotHoldingLovedItemInOffHand` (CAL-200), as `GoToItem` has it.
                if not self.not_holding_loved(lf) {
                    return false
                }
                return self.may_start(mut brain, Behavior.GoToItem(g), mut keep, now, mut random, lf, f, m, blocks, items, mut cache, min_y, mut sounds)
            },
            Behavior.StopAdmiringFar(within) => {
                // `StopAdmiringIfItemTooFarAway` (CAL-200): holding nothing in its off hand, no
                // wanted item it sees nearer than so many blocks, its admiring forgotten.
                if self.living.equipment[1] != none {
                    return false
                }
                if let id = brain.entity(MEMORY_NEAREST_VISIBLE_WANTED_ITEM) {
                    if let n = self.near_of(id) {
                        if self.distance_sqr_to(n.x, n.y, n.z) < f64(within * within) {
                            return false
                        }
                    }
                }
                brain.erase(MEMORY_ADMIRING_ITEM)
                return true
            },
            Behavior.StopAdmiringTired(t) => {
                // `StopAdmiringIfTiredOfTryingToReachItem` (CAL-200): holding nothing in its off
                // hand, its ticks trying to reach the item counted from 0; past the most, its
                // admiring and the count forgotten and walking to admire disabled for a while.
                if self.living.equipment[1] != none {
                    return false
                }
                let (most, disable) = t
                match brain.int(MEMORY_TIME_TRYING_TO_REACH_ADMIRE_ITEM) {
                    none => brain.set(MEMORY_TIME_TRYING_TO_REACH_ADMIRE_ITEM, Memo.Int(0)),
                    some(ticks) => {
                        if ticks > most {
                            brain.erase(MEMORY_ADMIRING_ITEM)
                            brain.erase(MEMORY_TIME_TRYING_TO_REACH_ADMIRE_ITEM)
                            brain.set_for(MEMORY_DISABLE_WALK_TO_ADMIRE_ITEM, Memo.Flag(true), i64(disable))
                        } else {
                            brain.set(MEMORY_TIME_TRYING_TO_REACH_ADMIRE_ITEM, Memo.Int(ticks + 1))
                        }
                    },
                }
                return true
            },
            Behavior.BackUp(b) => {
                // A piglin's `triggerIf(hasCrossbow, BackUpIfTooClose.create(...))` (CAL-200): holding a
                // crossbow, its target within so many blocks and among those it sees, looked at,
                // backed away from strafing, its body turned as its head is, `rotateIfNecessary`.
                if not self.holding_crossbow() {
                    return false
                }
                let (close, speed) = b
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return false
                let n = self.near_of(id) else return false
                let most = f64(close)
                if not (self.distance_sqr_to(n.x, n.y, n.z) < most * most and self.sees_near(mut brain, id, f, m, blocks)) {
                    return false
                }
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                self.moves.strafe(-speed, 0.0f32)
                self.living.body.y_rot = self.living.y_head_rot
                return true
            },
            Behavior.CrossbowAttack(_) => return self.crossbow_may_attack(mut brain, f, m, blocks),
            Behavior.StartHunting(_) => {
                // A piglin's `triggerIf(Piglin::canHunt, StartHuntingHoglin.create())` (CAL-200): one
                // that may hunt, grown, none of the grown piglins it sees having hunted recently,
                // angry at the huntable hoglin it sees, `setAngerTarget`, and not hunting for a while,
                // both drawn from the level's random; then its level tells the grown piglins near it
                // of the hoglin and has those it sees not hunt for a while, its brain's tick stopped
                // for it.
                if not self.can_hunt() or self.baby() {
                    return false
                }
                let nearest = brain.entities(MEMORY_NEAREST_VISIBLE_ADULT_PIGLINS)
                for id in nearest {
                    if let n = self.near_of(id) {
                        if n.hunted_recently {
                            return false
                        }
                    }
                }
                let id = brain.entity(MEMORY_NEAREST_VISIBLE_HUNTABLE_HOGLIN) else return false
                let target = self.near_of(id) else return false
                self.anger_in(mut brain, target, mut random)
                dont_hunt_for_a_while(mut brain, mut random)
                let told = brain.entities(MEMORY_NEARBY_ADULT_PIGLINS)
                self.living.show(Shown.Hunt(Hunt { target: id, told: told, nearest: nearest }), sounds.len())
                self.stop_due = true
                return true
            },
            // `SpearApproach`, `SpearAttack` and `SpearRetreat` (CAL-200): its target there and a
            // spear in its main hand, `KINETIC_WEAPON`, using nothing; to charge, its spear's status
            // charging; to get away, retreating, with a place to get away to found 9 to 11 blocks
            // from its target less how far it is, `getPosAway`, kept, `SPEAR_FLEEING_POSITION`.
            Behavior.SpearApproach(_) => return self.spear_target(brain) != none and not self.living.using_item(),
            Behavior.SpearAttack(_) => return (brain.int(MEMORY_SPEAR_STATUS) ?? SPEAR_APPROACH) == SPEAR_CHARGING and self.spear_target(brain) != none and not self.living.using_item(),
            Behavior.SpearRetreat(_) => {
                let n = self.spear_target(brain) else return false
                if self.living.using_item() or (brain.int(MEMORY_SPEAR_STATUS) ?? SPEAR_APPROACH) != SPEAR_RETREAT {
                    return false
                }
                let distance = self.distance_sqr_to(n.x, n.y, n.z).sqrt()
                let mount = if self.living.body.vehicle != none { 2.0 } else { 0.0 }
                let away = self.pos_away(lf, f, blocks, mut cache, min_y, (9.0 + mount - distance).max(0.0), (11.0 + mount - distance).max(1.0), (n.x, n.y, n.z)) else return false
                brain.set(MEMORY_SPEAR_FLEEING_POSITION, Memo.Point(away))
                return true
            },
            Behavior.Celebrate(ticks) => {
                // `StartCelebratingIfTargetDead` (CAL-200): its target dead or dying, a hoglin by a
                // draw under 0.1 from a random seeded with the game time, `wantsToDance`, danced
                // for; its block celebrated at; and, but for a player where dead players aren't
                // forgiven, its target and what it's angry at forgotten.
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return false
                let n = self.near_of(id) else return false
                if n.alive {
                    return false
                }
                if n.species == HOGLIN {
                    var dance = LegacyRandom.new(now)
                    if dance.next_float() < 0.1f32 {
                        brain.set_for(MEMORY_DANCING, Memo.Flag(true), i64(ticks))
                    }
                }
                let at = BlockPos { x: i32.saturate(n.x.floor()), y: i32.saturate(n.y.floor()), z: i32.saturate(n.z.floor()) }
                brain.set_for(MEMORY_CELEBRATE_LOCATION, Memo.Block(at), i64(ticks))
                if n.species != PLAYER or self.forgive_dead_players {
                    brain.erase(MEMORY_ATTACK_TARGET)
                    brain.erase(MEMORY_ANGRY_AT)
                }
                return true
            },
            Behavior.GoToLocation(g) => {
                // `GoToTargetLocation` (CAL-200), for those its `triggerIf` lets, a piglin dancing
                // or not: unless the place is within its distance, a block beside it, its offsets
                // across drawn from the level's random, walked to and looked at,
                // `setWalkAndLookTargetMemories`.
                let dancing = self.living.data.flag(MONSTER_OWN + 3)
                if (g.when == GO_UNLESS_DANCING and dancing) or (g.when == GO_IF_DANCING and not dancing) {
                    return false
                }
                let p = brain.block(g.memory) else return false
                let (bx, by, bz) = self.block_position()
                let (dx, dy, dz) = (i64(p.x - bx), i64(p.y - by), i64(p.z - bz))
                let close = i64(g.close_enough)
                if dx * dx + dy * dy + dz * dz >= close * close {
                    let ox = random.next_int_below(3) - 1
                    let oz = random.next_int_below(3) - 1
                    let spot = Spot.of_block(p.x + ox, p.y, p.z + oz)
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(spot)))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(spot), speed: g.speed, close_enough: g.close_enough }))
                }
                return true
            },
            Behavior.StrollNear(s) => {
                // `RandomStroll.stroll(speed, maxHorizontalDistance, maxVerticalDistance)` (CAL-200).
                let (speed, across, up) = s
                match self.random_place(true, across, up, lf, f, blocks, mut cache, min_y) {
                    some(p) => {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                    },
                    none => brain.erase(MEMORY_WALK_TARGET),
                }
                return true
            },
            Behavior.AwayFromNear(a) => {
                // `SetWalkTargetAwayFrom.entity`, interrupting a walk (CAL-200).
                let (memory, speed, dist) = a
                let id = brain.entity(memory) else return false
                let n = self.near_of(id) else return false
                return self.walk_away(mut brain, (n.x, n.y, n.z), speed, dist, true, lf, f, blocks, mut cache, min_y)
            },
            Behavior.HoglinKilled(_) => {
                // `RememberIfHoglinWasKilled` (CAL-200): its target a hoglin dead or dying, not
                // hunting for 600 to 2,400 ticks, drawn from the level's random.
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return true
                if let n = self.near_of(id) {
                    if n.species == HOGLIN and not n.alive {
                        brain.set_for(MEMORY_HUNTED_RECENTLY, Memo.Flag(true), i64(random.next_int_between(600, 2400)))
                    }
                }
                return true
            },
            Behavior.WalkToLookCalm(walk) => {
                // `triggerIf(doesntSeeAnyPlayerHoldingLovedItem, SetWalkTargetFromLookTarget)`
                // (CAL-200).
                if brain.has(MEMORY_NEAREST_PLAYER_HOLDING_WANTED_ITEM) {
                    return false
                }
                let (speed, close) = walk
                let t = brain.tracker(MEMORY_LOOK_TARGET) else return false
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: t, speed: speed, close_enough: close }))
                return true
            },
            Behavior.WorkAtPoi(_) => {
                // `WorkAtPoi.checkExtraStartConditions`: 300 ticks of the game since it last
                // looked, then one in two, drawn from the level's random, its look then; and its
                // job site's middle within 1.73 of it, in its dimension.
                if now - keep.last_check < 300 {
                    return false
                }
                if random.next_int_below(2) != 0 {
                    return false
                }
                keep.last_check = now
                let g = brain.place(MEMORY_JOB_SITE) else return false
                return g.dimension == self.dimension and self.near_middle(g.pos, 1.73)
            },
            Behavior.StrollAroundPoi(s) => {
                // `StrollAroundPoi`: within so many blocks of the place's middle, in its
                // dimension, a place on land up to 8 across and 6 up or down walked to,
                // `LandRandomPos.getPos`, else its walk target forgotten, where 180 ticks have gone
                // by since it last did.
                let (memory, speed, within) = s
                let g = brain.place(memory) else return false
                if g.dimension != self.dimension or not self.near_middle(g.pos, f64(within)) {
                    return false
                }
                if now <= keep.next_start {
                    return true
                }
                match self.random_place(true, 8, 6, lf, f, blocks, mut cache, min_y) {
                    some(p) => {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 1)))
                    },
                    none => brain.erase(MEMORY_WALK_TARGET),
                }
                keep.next_start = now + 180
                return true
            },
            Behavior.HomeWalk(speed) => return self.home_walk(mut brain, speed, mut keep, now, mut random, lf, f, m, blocks, mut cache, min_y),
            Behavior.BrownianWalk(speed) => return self.brownian_walk(mut brain, speed, f, m, blocks),
            Behavior.ToVillage(v) => {
                let (speed, close) = v
                return self.to_village(mut brain, speed, close, lf, f, blocks, mut cache, min_y)
            },
            Behavior.PlayTag(_) => return self.play_tag(mut brain, mut random, lf, f, blocks, mut cache, min_y),
            Behavior.SocializeAtBell(_) => {
                // `SocializeAtBell`: one time in 100, from the level's random, where its meeting
                // point's in its dimension within 4 of its middle and it sees a villager, the
                // nearest it sees within 32 squared its target, looked at and walked to at 0.3,
                // near enough within 1; done once it's drawn, whether or not one's that near.
                if random.next_int_below(100) != 0 {
                    return false
                }
                let g = brain.place(MEMORY_MEETING_POINT) else return false
                if g.dimension != self.dimension or not self.near_middle(g.pos, 4.0) {
                    return false
                }
                if self.find_closest_of(mut brain, PICK_SPECIES, VILLAGER, -1.0, f, m, blocks) == none {
                    return false
                }
                if let id = self.find_closest_of(mut brain, PICK_SPECIES, VILLAGER, 32.0, f, m, blocks) {
                    brain.set(MEMORY_INTERACTION_TARGET, Memo.Entity(id))
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: false }), speed: 0.3f32, close_enough: 1 }))
                }
                return true
            },
            Behavior.StrollToPoi(s) => {
                // `StrollToPoi`: within so many blocks of the place's middle, in its dimension,
                // the place walked to, where 80 ticks have gone by since it last was.
                let (memory, speed, close, within) = s
                let g = brain.place(memory) else return false
                if g.dimension != self.dimension or not self.near_middle(g.pos, f64(within)) {
                    return false
                }
                if now <= keep.next_start {
                    return true
                }
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(g.pos.x, g.pos.y, g.pos.z)), speed: speed, close_enough: close }))
                keep.next_start = now + 80
                return true
            },
            Behavior.StrollToPoiList(s) => {
                // `StrollToPoiList`: one of its job site's other places drawn from the level's
                // random; where it's in its dimension and its job site's middle within so many
                // blocks of it, that walked to, where 100 ticks have gone by since it last was.
                let (speed, close, within) = s
                let places = brain.places(MEMORY_SECONDARY_JOB_SITE)
                let stay = brain.place(MEMORY_JOB_SITE) else return false
                if places.is_empty() {
                    return false
                }
                let target = places[usize.wrap(random.next_int_below(i32.wrap(places.len())))].copy()
                if target.dimension != self.dimension or not self.near_middle(stay.pos, f64(within)) {
                    return false
                }
                if now > keep.next_start {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(target.pos.x, target.pos.y, target.pos.z)), speed: speed, close_enough: close }))
                    keep.next_start = now + 100
                }
                return true
            },
            Behavior.WalkToPoi(w) => return self.walk_to_poi(mut brain, w, now, lf, f, blocks, mut cache, min_y),
            Behavior.Harvest(_) => {
                // `HarvestFarmland.checkExtraStartConditions`: where mob griefing's on, a farmer's
                // blocks around it, 1 each way from where it is, x, then y, then z, that are ripe
                // crops or air on farmland, `validPos`, the one it'll work drawn of them from the
                // level's random, `getValidFarmland`.
                if not self.mob_griefing {
                    return false
                }
                let (_, profession, _) = self.living.data.villager(OWN + 1)
                if profession != FARMER {
                    return false
                }
                keep.farmland.clear()
                let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                for dx in -1..2 {
                    for dy in -1..2 {
                        for dz in -1..2 {
                            let (px, py, pz) = (floor_of(x + f64(dx)), floor_of(y + f64(dy)), floor_of(z + f64(dz)))
                            if workable(f, blocks, px, py, pz) {
                                keep.farmland.push((px, py, pz))
                            }
                        }
                    }
                }
                keep.last_target = pick_farmland(keep.farmland, mut random)
                return keep.last_target != none
            },
            Behavior.Bonemeal(_) => {
                // `UseBonemeal.checkExtraStartConditions`: on each 10th of its ticks, 160 or more
                // after it last stopped, with bone meal in its inventory, a crop around it short of
                // its last age, `pickNextTarget`.
                let ticks = i64(self.living.body.tick_count)
                if ticks % 10 != 0 or not (keep.last_check == 0 or keep.last_check + 160 <= ticks) {
                    return false
                }
                if self.inventory_count("minecraft:bone_meal") <= 0 {
                    return false
                }
                keep.last_target = self.pick_crop(f, blocks, none, mut random)
                return keep.last_target != none
            },
            Behavior.Sleep(_) => {
                // `SleepInBed.checkExtraStartConditions`: its home in its dimension, not woken in
                // the 100 ticks before, its home's middle within 2, and a bed villagers sleep on
                // there that no one's in; not while it rides something (D710).
                if self.living.body.vehicle != none {
                    return false
                }
                let g = brain.place(MEMORY_HOME) else return false
                if g.dimension != self.dimension {
                    return false
                }
                if let woken = brain.long(MEMORY_LAST_WOKEN) {
                    let since = now - woken
                    if since > 0 and since < 100 {
                        return false
                    }
                }
                return self.near_middle(g.pos, 2.0) and bed_in_use(f, blocks, g.pos) == some(false)
            },
            Behavior.WakeUp(_) => {
                // `WakeUp`: out of its rest asleep, it gets up.
                if brain.is_active(ACTIVITY_REST) or self.living.sleeping == none {
                    return false
                }
                self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
                return true
            },
            _ => return true,
        }
    }

    // Whether the block `pos`'s middle is nearer it than `dist`, `closerToCenterThan`.
    fn near_middle(self, pos: BlockPos, dist: f64) -> bool {
        return self.distance_sqr_to(f64(pos.x) + 0.5, f64(pos.y) + 0.5, f64(pos.z) + 0.5) < dist * dist
    }

    // `SetWalkTargetFromBlockMemory` (CAL-160): where the place `w.memory` holds is in its
    // dimension and it hasn't gone unable to reach its walk target too long, a place toward it
    // walked to where it's too far, `DefaultRandomPos.getPosTowards` within a right angle either
    // way, 15 across and 7 up or down, tried till one's near enough, or else the place itself where
    // it's farther than near enough, by blocks along each axis; a place it gives up on, there or
    // after 1000 tries, given back, `releasePoi`, and forgotten, it then unable to reach since now.
    fn walk_to_poi<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, w: WalkToPoi, now: i64, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let g = brain.place(w.memory) else return false
        var reachable = g.dimension == self.dimension
        if reachable {
            if let since = brain.long(MEMORY_CANT_REACH_WALK_TARGET_SINCE) {
                reachable = now - since <= i64(w.too_long)
            }
        }
        if not reachable {
            self.give_up_poi(mut brain, w.memory, now)
            return true
        }
        let (bx, by, bz) = self.block_position()
        let far = (g.pos.x - bx).abs() + (g.pos.y - by).abs() + (g.pos.z - bz).abs()
        if far > w.too_far {
            var toward: (f64, f64, f64)? = none
            var tries = 0
            loop {
                if let t = toward {
                    let (tx, ty, tz) = t
                    let s = Spot.of_place(tx, ty, tz)
                    if (s.x - bx).abs() + (s.y - by).abs() + (s.z - bz).abs() <= w.too_far {
                        break
                    }
                }
                let dir = (f64(g.pos.x) + 0.5 - self.living.body.x, f64(g.pos.z) + 0.5 - self.living.body.z)
                toward = self.place_towards(15, 7, dir, lf, f, blocks, mut cache, min_y)
                tries += 1
                if tries == 1000 {
                    self.give_up_poi(mut brain, w.memory, now)
                    return true
                }
            }
            let (x, y, z) = toward ?? (0.0, 0.0, 0.0)
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, w.speed, w.close)))
        } else if far > w.close {
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(g.pos.x, g.pos.y, g.pos.z)), speed: w.speed, close_enough: w.close }))
        }
        return true
    }

    /// `Villager.releaseAllPois` (CAL-326): the places its home, its job site, a job site it may
    /// take and its meeting point are, given back, `releasePoi`, with the level's points of
    /// interest lent it.
    pub fn release_all_pois(mut self) {
        let brain = self.brain.copy() else return
        for memory in [MEMORY_HOME, MEMORY_JOB_SITE, MEMORY_POTENTIAL_JOB_SITE, MEMORY_MEETING_POINT] {
            self.release_poi(brain, memory)
        }
    }

    /// `ZombifiedPiglin.populateDefaultEquipmentSlots` drawn from `r`, as a pig struck by
    /// lightning has it drawn from its own random (CAL-326).
    pub fn default_equipment<R: RandomSource>(mut self, r: mut R) {
        self.populate_equipment(Occasion.plain(), mut r)
    }

    /// `MushroomCow.thunderHit` by the bolt `bolt` (CAL-326): where it isn't the bolt that last
    /// struck it, red made brown or brown red, the bolt kept, and `entity.mooshroom.convert` heard
    /// at 2 unless it's silent; no fire and no hurt.
    pub fn mooshroom_struck(mut self, bolt: i32, sounds: mut List<EntitySound>) {
        if self.last_bolt == bolt {
            return
        }
        let brown = self.living.data.number(MOOSHROOM_TYPE) == 1
        self.living.data.set(MOOSHROOM_TYPE, Value.Number(if brown { 0 } else { 1 }))
        self.last_bolt = bolt
        self.living.play(mut sounds, String("entity.mooshroom.convert"), 2.0f32, 1.0f32)
    }

    // A place `SetWalkTargetFromBlockMemory` gives up on: given back, `releasePoi`, forgotten,
    // and it unable to reach its walk target since `now`.
    fn give_up_poi(mut self, brain: mut Brain, memory: i32, now: i64) {
        self.release_poi(brain, memory)
        brain.erase(memory)
        brain.set(MEMORY_CANT_REACH_WALK_TARGET_SINCE, Memo.Long(now))
    }

    // `Villager.releasePoi` of the place `memory` holds (CAL-160): where there's a point of
    // interest there of a type the memory's for, a home's, its job site's for its profession,
    // `heldJobSite`, a job site it may take's, `acquirableJobSite`, or a meeting point's, its
    // ticket given back. One in another dimension is said to be missing.
    fn release_poi(mut self, brain: Brain, memory: i32) {
        let g = brain.place(memory) else return
        if g.dimension != self.dimension {
            self.living.show(Shown.Missing(String("A villager's giving back a point of interest's ticket in another dimension, releasePoi")), 0)
            return
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let kinds = if memory == MEMORY_HOME { 1u32 << u32.wrap(HOME) } else if memory == MEMORY_JOB_SITE { held_sites(profession) } else if memory == MEMORY_POTENTIAL_JOB_SITE { acquirable_sites(profession) } else if memory == MEMORY_MEETING_POINT { 1u32 << u32.wrap(MEETING) } else { 0u32 }
        var pois = self.pois.take() ?? Pois.new(0, 0)
        if pois.exists(g.pos, types_of(kinds)) {
            _ = pois.release(g.pos)
        }
        self.pois = some(pois)
    }

    // `DefaultRandomPos.getPosTowards`, up to `h` across and `v` up or down, within a right angle
    // either side of the way `dir` across: of the 10 places tried, as `best_place` picks.
    fn place_towards<B: CollisionBlocks + MobLight + NavLevel>(mut self, h: i32, v: i32, dir: (f64, f64), lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
        let costs = self.own_maluses()
        let tries = towards_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, h, v, dir)
        return self.best_place(lf, f, blocks, tries)
    }

    // How many of the item `id` a villager's inventory holds, `countItem`.
    fn inventory_count(self, id: str) -> i32 {
        let wanted = String(id)
        var n = 0
        for t in self.stacks() {
            let Tag.Compound(c) = t else continue
            if not c.contains("id") {
                continue
            }
            let Tag.Str(item) = c["id"] else continue
            if item == wanted {
                n += int_or(c, "count", 1)
            }
        }
        return n
    }

    // `playWorkSound`: its profession's work sound, `entity.villager.work_*`, as `makeSound`
    // makes it, its pitch drawn; none for no profession or a nitwit, which have none.
    fn play_work_sound(mut self, sounds: mut List<EntitySound>) {
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let name = builtin_name(24, profession)
        if name == "minecraft:none" or name == "minecraft:nitwit" {
            return
        }
        let at = name.find(":") ?? 0
        let pitch = self.voice_pitch()
        self.living.play(mut sounds, "entity.villager.work_{name[at + 1..]}", self.sound_volume, pitch)
    }

    // `WorkAtComposter.useWorkstation`, where its job site's a composter (CAL-160): bread made of
    // its wheat, `makeBread`, then its seeds composted, `compostItems`.
    fn use_composter<B: CollisionBlocks>(mut self, pos: BlockPos, lf: LivingFacts, f: Facts, blocks: B, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let state = state_at(blocks, pos.x, pos.y, pos.z)
        if f.poi(state) != job_site_of(FARMER) {
            return
        }
        self.ready_inventory(f)
        self.make_bread(f, sounds)
        self.compost_items(pos, lf, f, state, mut random, mut sounds)
    }

    // `WorkAtComposter.makeBread`: where it has no more than 36 bread, as many as 3 made of its
    // wheat, 3 each, the wheat taken from its last slot back, `removeItemType`, and the bread
    // added, `addItem`, what there's no room for dropped half a block up from it,
    // `spawnAtLocation`, which its level makes.
    fn make_bread(mut self, f: Facts, sounds: List<EntitySound>) {
        if self.inventory_count("minecraft:bread") > 36 {
            return
        }
        let make = min_i32(3, self.inventory_count("minecraft:wheat") / 3)
        if make == 0 {
            return
        }
        self.remove_item_type("minecraft:wheat", make * 3)
        var slots = self.inventory.copy()
        let left = add_to(mut slots, stack_of_count(stack_of(String("minecraft:bread")), make), f)
        self.inventory = slots
        let over = left else return
        let spilled = Spilled { x: self.living.body.x, y: self.living.body.y + 0.5, z: self.living.body.z, stack: over }
        self.living.show(Shown.Spilled(spilled), sounds.len())
    }

    // `SimpleContainer.removeItemType` of `n` of the item `id` from its inventory, from its last
    // slot back, whatever their components.
    fn remove_item_type(mut self, id: str, n: i32) {
        let wanted = String(id)
        var removed = 0
        var i = self.inventory.len()
        while i > 0 and removed < n {
            i -= 1
            let t = self.inventory[i].copy() else continue
            if held_name(some(t.copy())) != wanted {
                continue
            }
            let have = count_of(some(t.copy()))
            let took = min_i32(have, n - removed)
            if took >= have {
                self.inventory[i] = none
            } else {
                self.inventory[i] = some(stack_of_count(t, have - took))
            }
            removed += took
        }
    }

    // `WorkAtComposter.compostItems` at its composter at `pos`, of the state `state` (CAL-160): a
    // full one's bone meal taken first, `extractProduce`; then, from its last slot back, its wheat
    // and beetroot seeds but 10 of each, 20 in all at most, put in one by one, `insertItem`, their
    // layers drawn as `addLayer` draws them, till it's at 7; the composter set to where that
    // leaves it, which its level does, ticked 20 on where a layer filled it to 7; and its fill
    // shown, level event 1500, 1 where it changed after its bone meal was taken.
    fn compost_items(mut self, pos: BlockPos, lf: LivingFacts, f: Facts, state: u32, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let was = f.get_int(state, "level") ?? 0
        var start = was
        if was == 8 {
            self.extract_produce(pos, mut random, mut sounds)
            start = 0
        }
        var fill = start
        let seeds: List<String> = [String("minecraft:wheat_seeds"), String("minecraft:beetroot_seeds")]
        var seen: List<i32> = [0, 0]
        var left = 20
        var i = self.inventory.len()
        var full = false
        while i > 0 and left > 0 and not full {
            i -= 1
            let t = self.inventory[i].copy() else continue
            let item = held_name(some(t.copy()))
            var k = seeds.len()
            for j in 0..seeds.len() {
                if item == seeds[j] {
                    k = j
                }
            }
            if k == seeds.len() {
                continue
            }
            let size = count_of(some(t))
            seen[k] += size
            let using = min_i32(min_i32(seen[k] - 10, left), size)
            if using <= 0 {
                continue
            }
            left -= using
            for _ in 0..using {
                if fill < 7 and k < lf.composts.len() {
                    if let compost = lf.composts[k].copy() {
                        match compost_layers(compost, fill, mut random) {
                            ok(layers) => fill = min_i32(fill + layers, 7),
                            err(thrown) => {
                                self.living.show(Shown.Missing(thrown.message.copy()), sounds.len())
                                return
                            },
                        }
                        self.shrink_slot(i)
                    }
                }
                if fill == 7 {
                    full = true
                    break
                }
            }
        }
        if fill != was {
            match f.with_int(state, "level", fill) {
                ok(now) => self.living.show(Shown.Composted((pos.x, pos.y, pos.z, now, fill == 7 and fill != start)), sounds.len()),
                err(thrown) => self.living.show(Shown.Missing(thrown.message.copy()), sounds.len()),
            }
        }
        self.living.show(Shown.Level((1500, pos.x, pos.y, pos.z, if fill != start { 1 } else { 0 })), sounds.len())
    }

    // `ComposterBlock.extractProduce` of its full composter at `pos` (CAL-160): bone meal thrown
    // up from it, 1.01 above its floor's corner and half a block in, up to 0.35 either way
    // across, drawn from the level's random, `offsetRandomXZ`, which its level makes with its
    // default pickup delay; and the composter's sound for everyone, from its middle. The
    // composter's emptied as it's set once its seeds are in.
    fn extract_produce(mut self, pos: BlockPos, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let dx = f64((random.next_float() - 0.5f32) * 0.7f32)
        let dz = f64((random.next_float() - 0.5f32) * 0.7f32)
        let at = Spilled { x: f64(pos.x) + 0.5 + dx, y: f64(pos.y) + 1.01, z: f64(pos.z) + 0.5 + dz, stack: stack_of(String("minecraft:bone_meal")) }
        self.living.show(Shown.Spilled(at), sounds.len())
        sounds.push(EntitySound { sound: String("block.composter.empty"), x: f64(pos.x) + 0.5, y: f64(pos.y) + 0.5, z: f64(pos.z) + 0.5, volume: 1.0f32, pitch: 1.0f32, source: BLOCKS_SOURCE })
    }

    // `Villager.shouldRestock` at the game time `now` (CAL-160): a new day where half of one's
    // gone by since it last restocked, or where the overworld's day's count is past the one it
    // last looked at, which it looks at again; on a new day, its last restock now and its
    // restocks today none again, `resetNumberOfRestocks`, their demand caught up first,
    // `catchUpDemand`: for each restock it missed today of 2, its offers' uses none again and
    // their demand updated, `updateDemand`, then priced again for the player trading with it;
    // then, where it may restock, none yet today, or fewer than 2 and 2400 ticks since the last,
    // whether any of its offers has been used, `needsToRestock`. Its offers asked for where
    // they're still to make are counted in `fresh`, as `ask_offers` has them.
    fn should_restock(mut self, now: i64, fresh: mut i32?, sounds: List<EntitySound>) -> bool {
        var new_day = now > self.last_restock + 12000
        let current = self.day
        new_day = new_day or (self.last_restock_check_day > 0 and current > self.last_restock_check_day)
        self.last_restock_check_day = current
        if new_day {
            self.last_restock = now
            let missed = 2 - self.restocks_today
            if missed > 0 {
                ask_offers(self.kept.contains("Offers"), mut fresh)
                self.reset_uses()
                for _ in 0..missed {
                    self.update_demand()
                    if let k = fresh {
                        fresh = some(k + 1)
                    }
                }
            }
            if self.reprice() {
                self.living.show(Shown.Repriced, sounds.len())
            }
            self.restocks_today = 0
        }
        if not (self.restocks_today == 0 or (self.restocks_today < 2 and now > self.last_restock + 2400)) {
            return false
        }
        ask_offers(self.kept.contains("Offers"), mut fresh)
        for o in self.offers() {
            let Tag.Compound(c) = o else continue
            if int_or(c, "uses", 0) > 0 {
                return true
            }
        }
        return false
    }

    // `Villager.restock` at the game time `now` (CAL-160): its offers' demand updated, then their
    // uses none again, then priced again for the player trading with it, sent them; and its last
    // restock now, one more today.
    fn restock(mut self, now: i64, sounds: List<EntitySound>) {
        self.update_demand()
        self.reset_uses()
        if self.reprice() {
            self.living.show(Shown.Repriced, sounds.len())
        }
        self.last_restock = now
        self.restocks_today += 1
    }

    // Each of its offers' uses none again, `resetUses`, left out as `MerchantOffer.CODEC` leaves
    // out what's its default.
    fn reset_uses(mut self) {
        if not self.kept.contains("Offers") {
            return
        }
        var offers = self.offers()
        for i in 0..offers.len() {
            let Tag.Compound(o) = offers[i].copy() else continue
            var offer = o.copy()
            _ = offer.remove("uses")
            offers[i] = Tag.Compound(offer)
        }
        self.set_offers(offers)
    }

    /// Each of its offers' demand updated, `MerchantOffer.updateDemand`: up by its uses, less the
    /// uses it had left, 0 left out as `MerchantOffer.CODEC` leaves it out (CAL-160).
    pub fn update_demand(mut self) {
        if not self.kept.contains("Offers") {
            return
        }
        var offers = self.offers()
        for i in 0..offers.len() {
            let Tag.Compound(o) = offers[i].copy() else continue
            var offer = o.copy()
            let uses = int_or(offer, "uses", 0)
            let demand = int_or(offer, "demand", 0) + uses - (int_or(offer, "maxUses", 4) - uses)
            if demand == 0 {
                _ = offer.remove("demand")
            } else {
                offer.insert(String("demand"), Tag.Int(demand))
            }
            offers[i] = Tag.Compound(offer)
        }
        self.set_offers(offers)
    }

    // What the behavior of the kind `kind` does as it starts at the game time `now`, `start`.
    fn start_behavior<B: CollisionBlocks + NavLevel>(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) {
        match kind {
            Behavior.SpearApproach(_) => {
                // `SpearApproach.start` (CAL-200): aggressive, approaching.
                self.set_flag(AGGRESSIVE_FLAG, true)
                brain.set(MEMORY_SPEAR_STATUS, Memo.Int(SPEAR_APPROACH))
            },
            Behavior.SpearAttack(_) => {
                // `SpearAttack.start` (CAL-200): aggressive, engaged for its spear's damage's ticks,
                // `computeDamageUseDuration`, no place to charge from, and its spear used.
                self.set_flag(AGGRESSIVE_FLAG, true)
                let k = self.held_spear ?? Kinetic()
                let lasting = match k.damage {
                    some(c) => c.max_ticks,
                    none => 0,
                }
                brain.set(MEMORY_SPEAR_ENGAGE_TIME, Memo.Int(k.delay + lasting))
                brain.erase(MEMORY_SPEAR_CHARGE_POSITION)
                self.living.start_using_kinetic(0, k, sounds.len())
            },
            Behavior.SpearRetreat(_) => {
                // `SpearRetreat.start` (CAL-200): aggressive, fleeing from 0.
                self.set_flag(AGGRESSIVE_FLAG, true)
                brain.set(MEMORY_SPEAR_FLEEING_TIME, Memo.Int(0))
            },
            Behavior.Harvest(_) => {
                // `HarvestFarmland.start`: past its next start, the block it'll work looked at
                // and walked to at half speed, near enough within 1.
                if now > keep.next_start {
                    if let t = keep.last_target {
                        let (x, y, z) = t
                        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: 0.5f32, close_enough: 1 }))
                    }
                }
            },
            Behavior.Bonemeal(_) => {
                // `UseBonemeal.start`: its crop looked at and walked to, `setCurrentCropAsTarget`;
                // a bone meal in its main hand, `setItemSlot`; its work from now, none worked yet.
                target_crop(mut brain, keep.last_target)
                self.living.equipment[0] = some(stack_of(String("minecraft:bone_meal")))
                keep.next_start = now
                keep.ticks = 0
            },
            Behavior.WorkAtPoi(composter) => {
                // `WorkAtPoi.start`: when it worked remembered, its job site looked at, its
                // profession's work sound, its workstation used, a farmer's composter as
                // `WorkAtComposter` uses it, and its offers restocked where it should.
                brain.set(MEMORY_LAST_WORKED_AT_POI, Memo.Long(now))
                let site = brain.place(MEMORY_JOB_SITE)
                if let g = site {
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(g.pos.x, g.pos.y, g.pos.z))))
                }
                self.play_work_sound(mut sounds)
                if composter {
                    if let g = site {
                        self.use_composter(g.pos, lf, f, blocks, mut random, mut sounds)
                    }
                }
                var fresh: i32? = none
                if self.should_restock(now, mut fresh, sounds) {
                    self.restock(now, sounds)
                }
                if let k = fresh {
                    let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    self.living.show(Shown.Offers((x, y, z, k)), sounds.len())
                }
            },
            Behavior.Panic(_) => {
                // `ArmadilloPanic.start`: rolled out first, then `AnimalPanic`'s.
                if self.species == ARMADILLO {
                    self.roll_out(mut sounds)
                }
                brain.set(MEMORY_IS_PANICKING, Memo.Flag(true))
                brain.erase(MEMORY_WALK_TARGET)
                self.navigation.stop()
            },
            Behavior.MoveToTarget(_) => self.follow_path(mut brain, mut keep, lf, f, blocks, min_y),
            Behavior.LookAround(look) => {
                let r = self.living.body.random.next_float()
                let pitch = clamp(r * look.pitch_range + look.min_pitch, -90.0f32, 90.0f32)
                let t = self.living.body.random.next_float()
                let rotation = wrap_degrees(self.living.body.y_rot + 2.0f32 * t * look.max_yaw - look.max_yaw)
                let (lx, ly, lz) = direction_from_rotation(pitch, rotation)
                let (x, y, z) = (self.living.body.x, self.living.body.y + f64(self.living.body.eyes), self.living.body.z)
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_place(x + lx, y + ly, z + lz))))
                let gaze = self.living.body.random.next_int_between(look.min_interval, look.max_interval)
                brain.set(MEMORY_GAZE_COOLDOWN_TICKS, Memo.Int(gaze))
            },
            Behavior.BallUp(_) => self.roll_up(true, mut sounds),
            Behavior.VillagerPanic(_) => {
                // `VillagerPanicTrigger.start`: hurt or seeing a hostile, where it isn't panicking
                // its path, walk and look targets, partner and what it interacts with forgotten,
                // and panic on.
                if brain.has(MEMORY_HURT_BY) or brain.has(MEMORY_NEAREST_HOSTILE) {
                    if not brain.is_active(ACTIVITY_PANIC) {
                        for memory in [MEMORY_PATH, MEMORY_WALK_TARGET, MEMORY_LOOK_TARGET, MEMORY_BREED_TARGET, MEMORY_INTERACTION_TARGET] {
                            brain.erase(memory)
                        }
                    }
                    brain.set_if_possible(ACTIVITY_PANIC)
                }
            },
            Behavior.ShowTrades(_) => {
                // `ShowTradesToPlayer.start`: the player looked at, for 40 ticks to begin with,
                // its first item shown first.
                _ = look_at_interaction(mut brain)
                keep.cycle = 0
                keep.display_index = 0
                keep.look_time = 40
            },
            Behavior.FollowTrader(speed) => self.follow_trader(mut brain, speed),
            Behavior.Sleep(_) => {
                // `SleepInBed.start`, from its next start: the doors it opened or passed closed,
                // `closeDoorsThatIHaveOpenedOrPassedThrough`; asleep in its home's bed, its time
                // asleep remembered where it lay down; its walk and its trouble reaching it
                // forgotten.
                if now > keep.next_start {
                    if brain.has(MEMORY_DOORS_TO_CLOSE) {
                        var swung = List<(i32, i32, i32, u32)>()
                        self.close_doors(mut brain, none, none, f, blocks, mut swung, mut random, mut sounds)
                    }
                    if let g = brain.place(MEMORY_HOME) {
                        if self.start_sleeping(f, m, blocks, g.pos.x, g.pos.y, g.pos.z, sounds) {
                            brain.set(MEMORY_LAST_SLEPT, Memo.Long(now))
                        }
                    }
                    brain.erase(MEMORY_WALK_TARGET)
                    brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                }
            },
            Behavior.MakeLove(l) => {
                // `AnimalMakeLove.start`: its partner its breed target, and it the partner's, the
                // partner's done by its level once its tick is; their gazes locked and walking to
                // each other; the baby to come 60 to 109 ticks on, from its own random.
                if let id = self.find_closest(mut brain, PICK_PARTNER, 0.0, f, m, blocks) {
                    brain.set(MEMORY_BREED_TARGET, Memo.Entity(id))
                    self.told.push(Told.BreedWith((id, self.living.body.id)))
                    self.lock_gaze_at(mut brain, id, l.speed, l.close_enough)
                    keep.child_at = now + i64(60 + self.living.body.random.next_int_below(50))
                }
            },
            Behavior.VillagerLove(_) => {
                // `VillagerMakeLove.start`: it and the villager it breeds with lock their gazes and
                // walk to each other, `lockGazeAndWalkToEachOther`, entity event 18 shown of the
                // other, then of it; the baby to come 275 to 324 ticks on, from its own random.
                if let id = brain.entity(MEMORY_BREED_TARGET) {
                    self.lock_gaze(mut brain, id)
                    self.living.show(Shown.EventOf((id, 18i8)), sounds.len())
                    self.living.show(Shown.Event(18i8), sounds.len())
                    keep.child_at = now + i64(275 + self.living.body.random.next_int_below(50))
                }
            },
            Behavior.TradeWithVillager(_) => {
                // `TradeWithVillager.start`: it and the villager it's interacting with lock their
                // gazes and walk to each other, `lockGazeAndWalkToEachOther`; and what it's
                // willing to throw the other, what the other's profession asks for and its own
                // doesn't, `figureOutWhatIAmWillingToTrade`, a farmer's wheat, seeds and bone meal
                // where the other's a farmer and it isn't.
                if let id = brain.entity(MEMORY_INTERACTION_TARGET) {
                    self.lock_gaze(mut brain, id)
                    keep.trades = List<String>()
                    let (_, mine, _) = self.living.data.villager(OWN + 1)
                    if let n = self.near_of(id) {
                        if n.profession == FARMER and mine != FARMER {
                            keep.trades = farmer_requests()
                        }
                    }
                }
            },
            Behavior.HeroGift(_) => {
                // `GiveGiftToHero.start` (CAL-395): none given this run, its start the time, the
                // hero its interaction target, and looked at.
                keep.gift_given = false
                keep.gift_start = now
                if let hero = self.nearest_hero(brain) {
                    brain.set(MEMORY_INTERACTION_TARGET, Memo.Entity(hero.id))
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: hero.id, eyes: true })))
                }
            },
            Behavior.JumpOnBed(speed) => {
                // `JumpOnBed.start`: its nearest bed its target, 100 ticks to reach it, 3 to 6
                // jumps, drawn from the level's random, none to wait, and walked to.
                if let bed = brain.block(MEMORY_NEAREST_BED) {
                    keep.bed = some((bed.x, bed.y, bed.z))
                    keep.to_reach = 100
                    keep.jumps = 3 + random.next_int_below(4)
                    keep.jump_wait = 0
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(bed.x, bed.y, bed.z)), speed: speed, close_enough: 0 }))
                }
            },
            _ => {},
        }
    }

    // `JumpOnBed.onOrOverBed`: in a block a baby jumps on, or just over one.
    fn on_or_over_bed<B: CollisionBlocks>(self, f: Facts, blocks: B) -> bool {
        let (x, y, z) = self.block_position()
        return jumpable(f, blocks, x, y, z) or jumpable(f, blocks, x, y - 1, z)
    }

    // `setVillagerData` of its type, profession and level, its offers forgotten where its
    // profession changes, and its brain made again in its tick, `refreshBrain`.
    fn set_profession(mut self, kind: i32, profession: i32, level: i32) {
        let (_, was, _) = self.living.data.villager(OWN + 1)
        if was != profession {
            _ = self.kept.remove(String("Offers"))
        }
        self.living.data.set(OWN + 1, Value.Villager(kind, profession, level))
        self.refresh_due = true
    }

    // `AssignProfessionFromJobSite`: within 2 of the middle of the job site it found, that its
    // job site, shown, entity event 14; and where it has no profession, the profession whose job
    // site the point there is, `heldJobSite`, its brain made again, `refreshBrain`.
    fn assign_profession(mut self, brain: mut Brain, sounds: List<EntitySound>) -> bool {
        let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) else return false
        if self.distance_sqr_to(f64(g.pos.x) + 0.5, f64(g.pos.y) + 0.5, f64(g.pos.z) + 0.5) >= 4.0 {
            return false
        }
        brain.erase(MEMORY_POTENTIAL_JOB_SITE)
        brain.set(MEMORY_JOB_SITE, Memo.Place(g.copy()))
        self.living.show(Shown.Event(14i8), sounds.len())
        let (kind, profession, level) = self.living.data.villager(OWN + 1)
        if profession != NO_PROFESSION {
            return true
        }
        if g.dimension != self.dimension {
            self.living.show(Shown.Missing(String("A villager's taking a profession at a job site in another dimension, AssignProfessionFromJobSite")), sounds.len())
            return true
        }
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let at = pois.type_at(g.pos)
        self.pois = some(pois)
        if let k = at {
            let p = profession_at(k)
            if p >= 0 {
                self.set_profession(kind, p, level)
            }
        }
        return true
    }

    // `PoiCompetitorScan` (CAL-160): where its job site's a point of interest in its level,
    // `getType`, the villagers near it alive holding that job site, in its dimension, with a
    // profession that works there, in the order its sensor found them, each against the one
    // keeping it so far, starting with itself: the one with more experience keeps it, the other,
    // a tie's keeper, forgetting it, `selectWinner`, another's forgotten by the level once its
    // tick's done.
    fn scan_competitors(mut self, brain: mut Brain) {
        let g = brain.place(MEMORY_JOB_SITE) else return
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let at = pois.type_at(g.pos)
        self.pois = some(pois)
        let k = at else return
        let me = self.living.body.id
        let here = g.dimension == self.dimension
        let pos = g.pos.pack()
        var keeper = me
        var keeper_xp = self.villager_xp
        for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            let n = self.near_of(id) else continue
            if id == me or n.species != VILLAGER or not n.alive {
                continue
            }
            let same = if let p = n.job_site { here and n.job_site_here and p == pos } else { false }
            if not same or held_sites(n.profession) & (1u32 << u32.wrap(k)) == 0u32 {
                continue
            }
            var loser = id
            if keeper_xp <= n.villager_xp {
                loser = keeper
                keeper = id
                keeper_xp = n.villager_xp
            }
            if loser == me {
                brain.erase(MEMORY_JOB_SITE)
            } else {
                self.told.push(Told.Erase((loser, MEMORY_JOB_SITE)))
            }
        }
    }

    // `YieldJobSite` at the speed (CAL-160): a grown one with no profession, where the job site it
    // found is a point of interest in its level, giving it up to the first villager near it,
    // alive, that's found none, whose profession works there and that holds that place, by its
    // place alone, or, holding none, can reach it, its walk and look targets and the site
    // forgotten, and where that one holds none, the site the one it found, walked to by the level
    // once its tick's done. Whether another can reach it is a Missing notice, as that's another's
    // path; it's taken as not.
    fn yield_job_site(mut self, brain: mut Brain, speed: f32, sounds: List<EntitySound>) -> bool {
        if self.baby() {
            return false
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        if profession != NO_PROFESSION {
            return false
        }
        let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) else return false
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let at = pois.type_at(g.pos)
        self.pois = some(pois)
        let k = at else return true
        let me = self.living.body.id
        let pos = g.pos.pack()
        for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            let n = self.near_of(id) else continue
            if id == me or n.species != VILLAGER or not n.alive or n.seeks_job_site {
                continue
            }
            if held_sites(n.profession) & (1u32 << u32.wrap(k)) == 0u32 {
                continue
            }
            var wants = false
            if let p = n.job_site {
                wants = p == pos
            } else {
                self.living.show(Shown.Missing(String("A villager's finding whether another can reach the job site it yields, YieldJobSite")), sounds.len())
            }
            if not wants {
                continue
            }
            brain.erase(MEMORY_WALK_TARGET)
            brain.erase(MEMORY_LOOK_TARGET)
            brain.erase(MEMORY_POTENTIAL_JOB_SITE)
            if n.job_site == none {
                self.told.push(Told.JobSite((id, g.pos.x, g.pos.y, g.pos.z, speed)))
            }
            return true
        }
        return true
    }

    // `DoorBlock.setOpen` by it (CAL-160): the door at `pos`, of the state `state`, opened or shut,
    // `open`, set with flags 10, its other half following as its shape updates, which its level
    // does as its brain's tick stops for it, `Shown.Door`; till then both halves kept in `swung`
    // as it reads them. Its sound's pitch drawn from the level's random after, as it's played from
    // the blocks at the door's middle. Its game event comes with game events.
    fn swing_door<B: CollisionBlocks>(mut self, f: Facts, blocks: B, swung: mut List<(i32, i32, i32, u32)>, pos: (i32, i32, i32), state: u32, open: bool, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let (x, y, z) = pos
        let now = match f.with_bool(state, "open", open) {
            ok(s) => s,
            err(_) => return,
        }
        swung.push((x, y, z, now))
        let half = f.get_name(state, "half") ?? String("lower")
        let other_y = if half == "lower" { y + 1 } else { y - 1 }
        let other = door_state(blocks, swung, x, other_y, z)
        let other_half = f.get_name(other, "half") ?? String("lower")
        if f.block(other) == f.block(state) and other_half != half {
            match f.with_name(now, "half", other_half) {
                ok(s) => swung.push((x, other_y, z, s)),
                err(_) => {},
            }
        }
        self.living.show(Shown.Door((x, y, z, open)), sounds.len())
        self.stop_due = true
        let pitch = random.next_float() * 0.1f32 + 0.9f32
        if let sound = f.toggle_sound(f.block(state), open) {
            sounds.push(EntitySound { sound: sound, x: f64(x) + 0.5, y: f64(y) + 0.5, z: f64(z) + 0.5, volume: 1.0f32, pitch: pitch, source: BLOCKS_SOURCE })
        }
    }

    // `closeDoorsThatIHaveOpenedOrPassedThrough` (CAL-160): each door it keeps to close but those
    // at the node it last passed and its next, `from` and `to`, let go of where it's in another
    // dimension or 3 or more from its middle, isn't a door mobs open any more, isn't open, or a
    // villager within 2 of its middle comes through it, `isMobComingThroughDoor`; else shut,
    // `swing_door`, and let go of. In the order they were kept: vanilla's `HashSet` of them goes in
    // an order its dimension's identity hash sets, which differs from run to run.
    fn close_doors<B: CollisionBlocks>(mut self, brain: mut Brain, from: (i32, i32, i32)?, to: (i32, i32, i32)?, f: Facts, blocks: B, swung: mut List<(i32, i32, i32, u32)>, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let doors = brain.places(MEMORY_DOORS_TO_CLOSE)
        var kept = List<GlobalPos>()
        for g in doors {
            let p = (g.pos.x, g.pos.y, g.pos.z)
            if from == some(p) or to == some(p) {
                kept.push(g.copy())
                continue
            }
            if g.dimension != self.dimension or self.distance_sqr_to(f64(g.pos.x) + 0.5, f64(g.pos.y) + 0.5, f64(g.pos.z) + 0.5) >= 9.0 {
                continue
            }
            let state = door_state(blocks, swung, g.pos.x, g.pos.y, g.pos.z)
            if not mob_door(f, state) or not f.get_bool(state, "open") or self.others_coming(brain, p) {
                continue
            }
            self.swing_door(f, blocks, mut swung, p, state, false, mut random, mut sounds)
        }
        brain.set(MEMORY_DOORS_TO_CLOSE, Memo.Places(kept))
    }

    // `areOtherMobsComingThroughDoor` (CAL-160): of the living entities it last found near it, a
    // mob of its own kind within 2 of the door's middle whose `PATH` memory's path is started and
    // not done, and has last passed the door or heads for it.
    fn others_coming(self, brain: Brain, door: (i32, i32, i32)) -> bool {
        let (x, y, z) = door
        for id in brain.entities(MEMORY_NEAREST_LIVING_ENTITIES) {
            let n = self.near_of(id) else continue
            if n.species != self.species {
                continue
            }
            let dx = f64(x) + 0.5 - n.x
            let dy = f64(y) + 0.5 - n.y
            let dz = f64(z) + 0.5 - n.z
            if dx * dx + dy * dy + dz * dz >= 4.0 {
                continue
            }
            let t = n.through else continue
            let (a, b) = t
            if a == door or b == door {
                return true
            }
        }
        return false
    }

    /// Its `PATH` memory's path's last node passed and next, where it's started and not done, as
    /// a mob near it sees them (CAL-160).
    pub fn path_about(self) -> ((i32, i32, i32), (i32, i32, i32))? {
        let b = self.brain else return none
        let id = b.path(MEMORY_PATH) else return none
        return self.navigation.about_path(id)
    }

    /// A villager's profession, experience and job site as a mob near it sees them (CAL-160): its
    /// job site's place, `BlockPos.asLong`, and whether it's in `dimension`; and whether it's
    /// found one to take. Nothing for another mob.
    pub fn job_seen(self, dimension: String) -> (i32, i32, i64?, bool, bool) {
        if self.species != VILLAGER {
            return (0, 0, none, false, false)
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        var site: i64? = none
        var here = false
        var seeks = false
        if let b = self.brain {
            if let g = b.place(MEMORY_JOB_SITE) {
                site = some(g.pos.pack())
                here = g.dimension == dimension
            }
            seeks = b.has(MEMORY_POTENTIAL_JOB_SITE)
        }
        return (profession, self.villager_xp, site, here, seeks)
    }

    /// What another's behavior did to it, `Told.Erase`: the memory forgotten (CAL-160).
    pub fn forget(mut self, memory: i32) {
        var brain = self.brain.take() else return
        brain.erase(memory)
        self.brain = some(brain)
    }

    /// What another's behavior did to it, `Told.JobSite`: it looks at and walks to the place at
    /// the speed till it's within 1, `setWalkAndLookTargetMemories`, and remembers it as the job
    /// site it found, in `dimension` (CAL-160).
    pub fn take_job_site(mut self, x: i32, y: i32, z: i32, speed: f32, dimension: own String) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: speed, close_enough: 1 }))
        brain.set(MEMORY_POTENTIAL_JOB_SITE, Memo.Place(GlobalPos { dimension: dimension, pos: BlockPos { x: x, y: y, z: z } }))
        self.brain = some(brain)
    }

    // `TradeWithVillager.checkExtraStartConditions`, `BehaviorUtils.targetIsValid`: what it
    // interacts with a villager, alive, that it may see.
    fn trades_with<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B) -> bool {
        let id = brain.entity(MEMORY_INTERACTION_TARGET) else return false
        let n = self.near_of(id) else return false
        return n.species == VILLAGER and n.alive and self.sees_near(mut brain, id, f, m, blocks)
    }

    // `VillagerMakeLove.isBreedingPossible` (CAL-160): what it would breed with a villager, alive
    // and among its brain's visible living entities, which it may see, `targetIsValid`; and both
    // may breed, `canBreed`.
    fn breeding_possible<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B) -> bool {
        let id = brain.entity(MEMORY_BREED_TARGET) else return false
        let n = self.near_of(id) else return false
        if n.species != VILLAGER or not n.alive or not self.sees_near(mut brain, id, f, m, blocks) {
            return false
        }
        return self.villager_can_breed() and n.can_breed
    }

    // `VillagerMakeLove.tick` (CAL-160): within about 2 of the villager it breeds with, 5 squared,
    // their gazes locked again; at the baby's time, both eat and digest, `eatAndDigestFood`, the
    // other's done by its level once its tick is, and the baby tried for, `tryToGiveBirth`; else
    // one time in 35, from its own random, entity event 12 shown of the other, then of it.
    fn make_love_tick<B: CollisionBlocks + NavLevel>(mut self, brain: mut Brain, keep: Keep, now: i64, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: List<EntitySound>) {
        let id = brain.entity(MEMORY_BREED_TARGET) else return
        let n = self.near_of(id) else return
        if self.distance_sqr_to(n.x, n.y, n.z) > 5.0 {
            return
        }
        self.lock_gaze(mut brain, id)
        if now >= keep.child_at {
            self.eat_and_digest(f)
            self.told.push(Told.Digest(id))
            self.give_birth(n, lf, f, m, blocks, mut cache, min_y, sounds)
        } else if self.living.body.random.next_int_below(35) == 0 {
            self.living.show(Shown.EventOf((id, 12i8)), sounds.len())
            self.living.show(Shown.Event(12i8), sounds.len())
        }
    }

    // `VillagerMakeLove.tryToGiveBirth` with the villager `n` (CAL-160): a bed taken for the baby,
    // `takeVacantBed`, of the beds within 48 of its block with a ticket free, in their order, the
    // first a path found to it, `createPath` within its type's valid range, reaches, `canReach`;
    // with none, entity event 13 shown of the other, then of it. Else the baby's type drawn from
    // its own random, `getBreedOffspring`: under a half the biome's at its block, under three
    // quarters its own, else the other's; it 6000 ticks from breeding again, `setAge`, as the
    // other is, and the baby made, with the bed its home, `Bred`, which its level does.
    fn give_birth<B: CollisionBlocks + NavLevel>(mut self, n: Near, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: List<EntitySound>) {
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let homes = types_of(1u32 << u32.wrap(HOME))
        var bed: BlockPos? = none
        for r in pois.in_range(homes.copy(), center, 48, Occupancy.HasSpace) {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, r.pos.x, r.pos.y, r.pos.z, valid_range(i32.wrap(r.kind))) {
                if p.reached {
                    bed = some(r.pos)
                    break
                }
            }
        }
        let taken = bed else {
            self.pois = some(pois)
            self.living.show(Shown.EventOf((n.id, 13i8)), sounds.len())
            self.living.show(Shown.Event(13i8), sounds.len())
            return
        }
        _ = pois.take(homes, some(taken), center, 48)
        self.pois = some(pois)
        let roll = self.living.body.random.next_double()
        var kind = -1
        if roll >= 0.75 {
            kind = n.villager_type
        } else if roll >= 0.5 {
            kind = self.villager_kind()
        }
        self.set_age(6000)
        let (x, y, z, made_as) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.kind)
        self.living.show(Shown.Bred(Bred { partner: n.id, species: VILLAGER, kind: made_as, variant: kind, partner_variant: n.villager_type, x: x, y: y, z: z, orb: 0, block: some((bx, by, bz)), bed: some((taken.x, taken.y, taken.z)) }), sounds.len())
    }

    /// `Villager.eatAndDigestFood` (CAL-160): where it's hungry, its food under 12, its villager
    /// food eaten from its first slot on, one by one till it's full, `eatUntilFull`; then 12 of its
    /// food digested, `digestFood`.
    pub fn eat_and_digest(mut self, f: Facts) {
        self.ready_inventory(f)
        if self.food_level < 12 {
            let size = self.inventory.len()
            for i in 0..size {
                let t = self.inventory[i].copy() else continue
                let value = villager_food(held_name(some(t.copy())))
                if value == 0 {
                    continue
                }
                let have = count_of(some(t.copy()))
                var eaten = 0
                while eaten < have and self.food_level < 12 {
                    self.food_level += value
                    eaten += 1
                }
                self.inventory[i] = if eaten >= have { none } else { some(stack_of_count(t, have - eaten)) }
                if self.food_level >= 12 {
                    break
                }
            }
        }
        self.food_level -= 12
    }

    /// Whether it may breed, `canBreed` (CAL-160): a villager's, `Villager.canBreed`; never any
    /// other mob, `AgeableMob`'s.
    pub fn can_breed(self) -> bool {
        return self.species == VILLAGER and self.villager_can_breed()
    }

    /// A villager's type, by its ID in `VILLAGER_TYPE`, plains for any other mob (CAL-160).
    pub fn villager_kind(self) -> i32 {
        if self.species != VILLAGER {
            return PLAINS_VILLAGERS
        }
        let (kind, _, _) = self.living.data.villager(OWN + 1)
        return kind
    }

    /// A villager baby's data as `getBreedOffspring` sets it (CAL-160): of the type `kind`, with no
    /// profession, and final.
    pub fn born_villager(mut self, kind: i32) {
        let (_, _, level) = self.living.data.villager(OWN + 1)
        self.living.data.set(OWN + 1, Value.Villager(kind, NO_PROFESSION, level))
        self.living.data.set(OWN + 2, Value.Bool(true))
    }

    /// `VillagerMakeLove.giveBedToChild`: the bed at the place its home, in the dimension
    /// (CAL-160).
    pub fn given_home(mut self, x: i32, y: i32, z: i32, dimension: String) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_HOME, Memo.Place(GlobalPos { dimension: dimension.copy(), pos: BlockPos { x: x, y: y, z: z } }))
        self.brain = some(brain)
    }

    // `AnimalMakeLove.canStillUse` (CAL-160): what it breeds with of its partner's kind, alive,
    // in love as it is, `canMate`, among its brain's visible living entities, which it may see,
    // the baby's time not past, and neither panicking.
    fn still_mating<B: CollisionBlocks>(mut self, brain: mut Brain, l: MakeLove, child_at: i64, now: i64, f: Facts, m: MovementStates, blocks: B) -> bool {
        let id = brain.entity(MEMORY_BREED_TARGET) else return false
        let n = self.near_of(id) else return false
        if n.species != l.species or not n.alive or not (self.in_love > 0 and n.in_love) {
            return false
        }
        if not self.sees_near(mut brain, id, f, m, blocks) {
            return false
        }
        return now <= child_at and not self.panicking() and not n.panicking
    }

    // `AnimalMakeLove.tick` (CAL-160): their gazes locked again; within 3 of its partner at the
    // baby's time, the baby made, `spawnChildFromBreeding`, as a farm animal's breeding makes it,
    // and both forget what they breed with, the partner's done by its level once its tick is.
    fn mate_tick(mut self, brain: mut Brain, l: MakeLove, child_at: i64, now: i64, sounds: List<EntitySound>) {
        let id = brain.entity(MEMORY_BREED_TARGET) else return
        let n = self.near_of(id) else return
        self.lock_gaze_at(mut brain, id, l.speed, l.close_enough)
        if self.distance_sqr_to(n.x, n.y, n.z) < 9.0 and now >= child_at {
            let k = Kin { id: n.id, species: n.species, x: n.x, y: n.y, z: n.z, eyes: n.eyes, bounds: n.bounds, age: 0, in_love: n.in_love, alive: n.alive, panicking: n.panicking, variant: 0 }
            self.breed(k, sounds.len())
            brain.erase(MEMORY_BREED_TARGET)
            self.told.push(Told.Erase((id, MEMORY_BREED_TARGET)))
        }
    }

    /// What another's `AnimalMakeLove` told it, `Told.BreedWith`: the mob `with` what it breeds
    /// with, where its brain has the memory (CAL-160).
    pub fn breed_with(mut self, with: i32) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_BREED_TARGET, Memo.Entity(with))
        self.brain = some(brain)
    }

    // `BehaviorUtils.lockGazeAndWalkToEachOther` of it and the entity `id`, at `speed` till
    // they're `close` apart: each looks at the other's eyes and walks to them, the other's done
    // by the level once its tick is.
    fn lock_gaze_at(mut self, brain: mut Brain, id: i32, speed: f32, close: i32) {
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: true }), speed: speed, close_enough: close }))
        self.told.push(Told.WalkTo((id, self.living.body.id, speed, close)))
    }

    // `BehaviorUtils.lockGazeAndWalkToEachOther` of it and the entity `id`, at half speed till
    // they're 2 apart: each looks at the other's eyes and walks to them, the other's done by the
    // level once its tick is.
    fn lock_gaze(mut self, brain: mut Brain, id: i32) {
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: id, eyes: true }), speed: 0.5f32, close_enough: 2 }))
        self.told.push(Told.WalkTo((id, self.living.body.id, 0.5f32, 2)))
    }

    // `TradeWithVillager.tick`: within about 2 of the villager it's interacting with, 5 squared,
    // their gazes locked again, the two gossiping, `gossip`, which the level does once its tick is
    // done; then half a stack thrown to the other, `throwHalfStack`: of its food, where it has
    // more than it needs, `hasExcessFood`, and is a farmer or the other wants more,
    // `wantsMoreFood`; of a farmer's wheat, past half a stack; and of what it's willing to throw,
    // `keep.trades`.
    fn trade_with_villager_tick(mut self, brain: mut Brain, keep: Keep, now: i64, f: Facts, sounds: List<EntitySound>) {
        let id = brain.entity(MEMORY_INTERACTION_TARGET) else return
        let n = self.near_of(id) else return
        if self.distance_sqr_to(n.x, n.y, n.z) > 5.0 {
            return
        }
        self.lock_gaze(mut brain, id)
        self.told.push(Told.Gossip((self.living.body.id, id, now)))
        self.golem_from = some(self.golem_place())
        self.ready_inventory(f)
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let farmer = profession == FARMER
        let to = (n.x, n.y, n.z)
        if self.food_points() >= 24 and (farmer or n.food < 12) {
            self.throw_half_stack(f, villager_foods(), to, sounds)
        }
        if farmer and self.inventory_count("minecraft:wheat") > 32 {
            self.throw_half_stack(f, [String("minecraft:wheat")], to, sounds)
        }
        if not keep.trades.is_empty() {
            self.throw_half_stack(f, keep.trades.copy(), to, sounds)
        }
    }

    // `TradeWithVillager.throwHalfStack` to `to`: the first of its stacks of the items `kinds`
    // with more than half the most it stacks to, half of it, or with more than 24, all but 24,
    // split off, `split`, and thrown, `throwItem`.
    fn throw_half_stack(mut self, f: Facts, kinds: List<String>, to: (f64, f64, f64), sounds: List<EntitySound>) {
        for i in 0..self.inventory.len() {
            let t = self.inventory[i].copy() else continue
            if not kinds.contains(held_name(some(t.copy()))) {
                continue
            }
            let have = count_of(some(t.copy()))
            var count = 0
            if have > stack_limit(f, t.copy()) / 2 {
                count = have / 2
            } else if have > 24 {
                count = have - 24
            } else {
                continue
            }
            self.inventory[i] = some(stack_of_count(t.copy(), have - count))
            self.throw_item(stack_of_count(t, count), to, sounds)
            return
        }
    }

    // `BehaviorUtils.throwItem` of `stack` to `to`, where the one it's thrown to stands: an item
    // 0.3 below its eyes, which its level makes as `new ItemEntity` makes one, moving 0.3 a tick
    // toward there, `normalize`, not at all where it's there already, its thrower it, with its
    // default pickup delay.
    fn throw_item(mut self, stack: own Tag, to: (f64, f64, f64), sounds: List<EntitySound>) {
        let (tx, ty, tz) = to
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        let (dx, dy, dz) = (tx - x, ty - y, tz - z)
        let length = (dx * dx + dy * dy + dz * dz).sqrt()
        let speed = f64(0.3f32)
        var thrown = Tossed { x: x, y: y + f64(self.living.body.eyes) - f64(0.3f32), z: z, vx: 0.0, vy: 0.0, vz: 0.0, stack: stack, thrower: self.living.body.uuid }
        if length >= f64(1.0e-5f32) {
            thrown.vx = dx / length * speed
            thrown.vy = dy / length * speed
            thrown.vz = dz / length * speed
        }
        self.living.show(Shown.Tossed(thrown), sounds.len())
    }

    /// `Villager.gossip` of it with the villager `other` at the game time `now` (CAL-160): where
    /// neither gossiped in the 1200 ticks before, what the other's heard passed on, 10 picked from
    /// its random, `transferFrom`; both gossiped now; an iron golem summoned where five villagers
    /// near want one, `spawnGolemIfNeeded`, asked of its level where it wants one; and where it
    /// heard anything, its offers priced again for the player trading with it, sent them.
    pub fn gossip_with(mut self, other: mut Mob, now: i64, heard: usize) {
        let mine = now < self.last_gossip or now >= self.last_gossip + 1200
        let theirs = now < other.last_gossip or now >= other.last_gossip + 1200
        if not mine or not theirs {
            return
        }
        var known = self.gossips.copy()
        let fresh = known.transfer_from(other.gossips, mut self.living.body.random, 10)
        self.gossips = known
        self.last_gossip = now
        other.last_gossip = now
        if self.wants_golem_at(now) {
            let from = self.golem_from ?? self.golem_place()
            self.living.show(Shown.CallGolem((5, from)), heard)
        }
        self.golem_from = none
        if fresh > 0 and self.reprice() {
            self.living.show(Shown.Repriced, heard)
        }
    }

    /// Whether it's a villager that wants an iron golem, `wantsToSpawnGolem` (CAL-201): one that
    /// slept within the last day of the game and hasn't seen a golem lately.
    pub fn wants_golem(self) -> bool {
        return self.wants_golem_at(self.game_time)
    }

    /// `wantsToSpawnGolem` at the game time `now` (CAL-201).
    pub fn wants_golem_at(self, now: i64) -> bool {
        if self.species != VILLAGER {
            return false
        }
        let b = self.brain else return false
        let slept = b.long(MEMORY_LAST_SLEPT) else return false
        return now - slept < 24000 and not b.has(MEMORY_GOLEM_DETECTED_RECENTLY)
    }

    /// Where it is for an iron golem it asks for (CAL-201): its box and its block, `blockPosition`.
    pub fn golem_place(self) -> (Aabb, (i32, i32, i32)) {
        let at = (i32.saturate(self.living.body.x.floor()), i32.saturate(self.living.body.y.floor()), i32.saturate(self.living.body.z.floor()))
        return (self.living.body.bounding_box(), at)
    }

    /// `GolemSensor.golemDetected`, where a villager near summoned one (CAL-201): a golem seen
    /// lately, for 599 ticks, where its brain has the memory.
    pub fn golem_seen(mut self) {
        var brain = self.brain.take() else return
        brain.set_for(MEMORY_GOLEM_DETECTED_RECENTLY, Memo.Flag(true), 599)
        self.brain = some(brain)
    }

    /// What another's behavior did to it, `Told.WalkTo`: it looks at and walks to `to`'s eyes at
    /// the speed till it's as near as `stop`, where its brain has those memories (CAL-160).
    pub fn walk_to(mut self, to: i32, speed: f32, stop: i32) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: to, eyes: true })))
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: to, eyes: true }), speed: speed, close_enough: stop }))
        self.brain = some(brain)
    }

    // `ShowTradesToPlayer.checkExtraStartConditions`: what it interacts with a player alive, it
    // grown, and the player within about 4 of it, 17 squared.
    // `GiveGiftToHero.getNearestTargetableHero` (CAL-395): the nearest player it sees, where
    // they're a hero of the village.
    fn nearest_hero(self, brain: Brain) -> Near? {
        let id = brain.entity(MEMORY_NEAREST_VISIBLE_PLAYER) else return none
        let n = self.near_of(id) else return none
        if n.species == PLAYER and n.hero {
            return some(n)
        }
        return none
    }

    // `GiveGiftToHero.getLootTableToThrow` (CAL-395): a baby's gift, else its profession's, an
    // unemployed one's for none, a nitwit and any other.
    fn gift_table(self) -> String {
        if self.baby() {
            return String("minecraft:gameplay/hero_of_the_village/baby_gift")
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let name = builtin_name(24, profession)
        let giving: List<str> = ["armorer", "butcher", "cartographer", "cleric", "farmer", "fisherman", "fletcher", "leatherworker", "librarian", "mason", "shepherd", "toolsmith", "weaponsmith"]
        for g in giving {
            if name == "minecraft:{g}" {
                return "minecraft:gameplay/hero_of_the_village/{g}_gift"
            }
        }
        return String("minecraft:gameplay/hero_of_the_village/unemployed_gift")
    }

    fn shows_trades(self, brain: Brain) -> bool {
        let id = brain.entity(MEMORY_INTERACTION_TARGET) else return false
        let n = self.near_of(id) else return false
        return n.species == PLAYER and n.alive and not self.baby() and self.distance_sqr_to(n.x, n.y, n.z) <= 17.0
    }

    // `LookAndFollowTradingPlayerSink.checkExtraStartConditions`, and `canStillUse` (CAL-160):
    // alive and trading with a player its level found, not in water, not hurt lately,
    // `wasHurtRecently`, and within 4 of them.
    fn follows_trader(self) -> bool {
        let t = self.trading else return false
        let n = self.near_of(t.id) else return false
        return self.living.alive() and not self.living.body.in_water and self.living.hurt_time <= 0 and self.distance_sqr_to(n.x, n.y, n.z) <= 16.0
    }

    // `LookAndFollowTradingPlayerSink.followPlayer`: the player it trades with walked to at
    // `speed` till it's within 2, and their eyes looked at.
    fn follow_trader(self, brain: mut Brain, speed: f32) {
        let t = self.trading else return
        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: t.id, eyes: false }), speed: speed, close_enough: 2 }))
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: t.id, eyes: true })))
    }

    // `ShowTradesToPlayer.tick`: the player looked at; where what's in their main hand isn't what
    // was, `isSameItem`, what it shows forgotten, and where it isn't nothing, what the offers it
    // pays for give shown, `findItemsToDisplay`, its offers made as they're first asked for,
    // `getOffers`: none for no trades, else by its level once its tick's done, `Shown.Offers`,
    // which looks for what to show again then, `offers_made`. With something to show, it's held
    // in turn, `displayCyclingItems`; else its main hand's emptied and 40 ticks left at most. And
    // a tick less.
    fn show_trades_tick(mut self, brain: mut Brain, keep: mut Keep, sounds: List<EntitySound>) {
        let id = look_at_interaction(mut brain) else return
        let n = self.near_of(id) else return
        let changed = if let had = keep.player_item { had != n.main_hand } else { true }
        if changed {
            keep.player_item = some(n.main_hand)
            keep.display = List<Tag>()
            if n.main_hand != 0 {
                let (_, profession, _) = self.living.data.villager(OWN + 1)
                let name = builtin_name(24, profession)
                if self.kept.contains("Offers") {
                    self.find_display(mut keep, n.main_hand)
                } else if name != "minecraft:none" and name != "minecraft:nitwit" {
                    keep.awaiting_offers = true
                    let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    self.living.show(Shown.Offers((x, y, z, 0)), sounds.len())
                } else {
                    self.kept.insert(String("Offers"), Tag.Compound(JavaHashMap<String, Tag>()))
                }
            }
        }
        self.show_rest(mut keep)
    }

    // The rest of `ShowTradesToPlayer.tick`, after what to show's been looked for: with something
    // to show, it's held in turn; else its main hand's emptied and 40 ticks left at most; and a
    // tick less.
    fn show_rest(mut self, keep: mut Keep) {
        if keep.display.is_empty() {
            self.clear_held_item()
            keep.look_time = keep.look_time.min(40)
        } else if keep.display.len() >= 2 {
            // `displayCyclingItems`: each 40 ticks, the next held, back to the first after the
            // last.
            keep.cycle += 1
            if keep.cycle >= 40 {
                keep.display_index += 1
                keep.cycle = 0
                if usize.wrap(keep.display_index) > keep.display.len() - 1 {
                    keep.display_index = 0
                }
                self.hold_shown(keep.display[usize.wrap(keep.display_index)].copy())
            }
        }
        keep.look_time -= 1
    }

    // `updateDisplayItems` for the player's item of the name's hash `hand`: of its offers in their
    // order, what each that isn't out of stock gives, `assemble`, where the item's what it costs,
    // either of its costs, `isSameItem`; with any, 900 ticks to look, and the first held,
    // `displayFirstItem`.
    fn find_display(mut self, keep: mut Keep, hand: i32) {
        for o in self.offers() {
            let Tag.Compound(c) = o else continue
            if int_or(c, "uses", 0) >= int_or(c, "maxUses", 4) {
                continue
            }
            var pays = false
            for cost in ["buy", "buyB"] {
                if c.contains(cost) and string_hash(held_name(some(c[cost].copy()))) == hand {
                    pays = true
                }
            }
            if pays and c.contains("sell") {
                keep.display.push(c["sell"].copy())
            }
        }
        if not keep.display.is_empty() {
            keep.look_time = 900
            self.hold_shown(keep.display[0].copy())
        }
    }

    // `ShowTradesToPlayer.displayAsHeldItem`: the stack in its main hand, never dropped.
    fn hold_shown(mut self, stack: own Tag) {
        self.living.equipment[0] = some(stack)
        var chances = JavaHashMap<String, Tag>()
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(had) = self.kept["drop_chances"] {
                chances = had.copy()
            }
        }
        chances.insert(String("mainhand"), Tag.Float(0.0f32))
        self.kept.insert(String("drop_chances"), Tag.Compound(chances))
    }

    /// Its offers made by its level once its tick's done (CAL-160), where `ShowTradesToPlayer`
    /// asked for them as it looked for what to show: what the player's item pays for looked for
    /// again, and the rest of that tick done again from there, as vanilla's tick does it with
    /// the offers made then and there.
    pub fn offers_made(mut self) {
        var brain = self.brain.take() else return
        var runs = brain.take_runs()
        for i in 0..runs.len() {
            if let Behavior.ShowTrades(_) = runs[i].deed.kind {
                if runs[i].deed.keep.awaiting_offers {
                    var keep = runs[i].deed.keep.copy()
                    keep.awaiting_offers = false
                    let hand = keep.player_item ?? 0
                    self.find_display(mut keep, hand)
                    if not keep.display.is_empty() {
                        self.show_rest(mut keep)
                    }
                    runs[i].deed.keep = keep
                }
            }
        }
        brain.give_back_runs(runs)
        self.brain = some(brain)
    }

    // `ShowTradesToPlayer.clearHeldItem`: its main hand emptied, and its chance of dropping what's
    // there the default, 0.085, as `drop_chances` leaves it out.
    fn clear_held_item(mut self) {
        self.living.equipment[0] = none
        if not self.kept.contains("drop_chances") {
            return
        }
        var chances = JavaHashMap<String, Tag>()
        if let Tag.Compound(had) = self.kept["drop_chances"] {
            chances = had.copy()
        }
        _ = chances.remove(String("mainhand"))
        if chances.is_empty() {
            _ = self.kept.remove(String("drop_chances"))
        } else {
            self.kept.insert(String("drop_chances"), Tag.Compound(chances))
        }
    }

    // `MoveToTargetSink.start`: its path the brain's, by its number, and followed at its speed,
    // which leaves the navigation's where it's the same.
    fn follow_path<B: CollisionBlocks + NavLevel>(mut self, brain: mut Brain, keep: mut Keep, lf: LivingFacts, f: Facts, blocks: B, min_y: i32) {
        let found = keep.found.take()
        let id = if let p = found { some(p.id) } else { none }
        brain.set_or_erase(MEMORY_PATH, if let n = id { some(Memo.Path(n)) } else { none })
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        _ = self.navigation.move_along(lf, f, nf, blocks, w, found, f64(keep.speed))
    }

    // `MoveToTargetSink.tryComputePath`: a path made to the block its walk target `walk` is at,
    // and its speed kept; where it's reached it, whether it can reach it forgotten and no more;
    // else whether it can kept, `CANT_REACH_WALK_TARGET_SINCE` from `now` where it can't, then
    // whether it has a path, else one made toward a place drawn on the way to it,
    // `DefaultRandomPos.getPosTowards`.
    fn compute_path<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, walk: Walk, keep: mut Keep, now: i64, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let (tx, ty, tz) = self.tracked_block(walk.target) ?? self.block_position()
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        let found = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, tx, ty, tz, 0)
        keep.speed = walk.speed
        let can_reach = if let p = found { p.reached } else { false }
        let has = found != none
        keep.path = if let p = found { some(p.id) } else { none }
        keep.found = found
        if self.reached(walk) {
            brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
            return false
        }
        if can_reach {
            brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
        } else if not brain.has(MEMORY_CANT_REACH_WALK_TARGET_SINCE) {
            brain.set(MEMORY_CANT_REACH_WALK_TARGET_SINCE, Memo.Long(now))
        }
        if has {
            return true
        }
        let wander = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
        let dir = (f64(tx) + 0.5 - self.living.body.x, f64(tz) + 0.5 - self.living.body.z)
        let costs = self.own_maluses()
        let tries = towards_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, wander, 10, 7, dir)
        let partial = self.best_place(lf, f, blocks, tries) else return false
        let (px, py, pz) = partial
        let towards = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, floor_of(px), floor_of(py), floor_of(pz), 0)
        keep.path = if let p = towards { some(p.id) } else { none }
        keep.found = towards
        return keep.path != none
    }

    // `MoveToTargetSink.reachedTarget`: its walk target's block within its near enough of its own
    // block, `distManhattan`.
    fn reached(self, walk: Walk) -> bool {
        let (tx, ty, tz) = self.tracked_block(walk.target) else return false
        let (x, y, z) = self.block_position()
        return (tx - x).abs() + (ty - y).abs() + (tz - z).abs() <= walk.close_enough
    }

    // `tickOrStop` of the running behavior `d`: a gate's running behaviors each, then stopped
    // where none runs; a one-shot stopped; `DoNothing` stopped once its time's out; any other
    // ticked while it isn't timed out and can go on, `canStillUse`, else stopped, `doStop`.
    fn tick_or_stop<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, d: mut Deed, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) {
        if let Behavior.Gate(_) = d.kind {
            var g = d.gate.take() else return
            for i in 0..g.entries.len() {
                if g.entries[i].deed.running {
                    self.tick_or_stop(mut brain, mut g.entries[i].deed, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds)
                }
            }
            if not g.any_running() {
                // `doStop`: what it forgets as it stops, `exitErasedMemories`, forgotten.
                d.running = false
                for e in g.erases {
                    brain.erase(e)
                }
            }
            d.gate = some(g)
            return
        }
        let kind = d.kind
        if not timed(kind) {
            d.running = false
            return
        }
        if let Behavior.Idle(_) = kind {
            if now > d.end {
                d.running = false
            }
            return
        }
        // `JumpOnBed` never times out, `timedOut`.
        let out = if let Behavior.JumpOnBed(_) = kind { false } else { timed_out(d, now) }
        if not out and self.still_on(mut brain, kind, d.keep, now, f, m, blocks) {
            self.tick_behavior(mut brain, kind, mut d.keep, now, mut random, lf, f, m, blocks, mut cache, min_y, mut sounds)
        } else {
            d.running = false
            self.stop_behavior(mut brain, kind, mut d.keep, mut random, mut sounds)
        }
    }

    // Whether the behavior of the kind `kind` can go on, `canStillUse`.
    fn still_on<B: CollisionBlocks>(mut self, brain: mut Brain, kind: Behavior, keep: Keep, now: i64, f: Facts, m: MovementStates, blocks: B) -> bool {
        match kind {
            Behavior.Swim(_) => return self.floats(),
            Behavior.Panic(_) => return true,
            Behavior.LookAtTarget(_) => {
                let t = brain.tracker(MEMORY_LOOK_TARGET) else return false
                return self.tracker_visible(mut brain, t, f, m, blocks)
            },
            Behavior.MoveToTarget(_) => {
                if keep.path == none or keep.last_target == none {
                    return false
                }
                let walk = brain.walk(MEMORY_WALK_TARGET) else return false
                var spectator = false
                if let Tracker.Entity(e) = walk.target {
                    if let n = self.near_of(e.id) {
                        spectator = n.spectator
                    }
                }
                return not self.navigation.is_done() and not self.reached(walk) and not spectator
            },
            Behavior.CountDown(memory) => return (brain.int(memory) ?? 0) > 0,
            Behavior.Tempted(_) => return brain.has(MEMORY_TEMPTING_PLAYER) and not brain.has(MEMORY_BREED_TARGET) and not brain.has(MEMORY_IS_PANICKING),
            Behavior.BallUp(_) => return self.scared(),
            Behavior.VillagerPanic(_) => return brain.has(MEMORY_HURT_BY) or brain.has(MEMORY_NEAREST_HOSTILE),
            Behavior.ShowTrades(_) => return self.shows_trades(brain) and keep.look_time > 0 and brain.has(MEMORY_INTERACTION_TARGET),
            Behavior.FollowTrader(_) => return self.follows_trader(),
            Behavior.TradeWithVillager(_) => return self.trades_with(mut brain, f, m, blocks),
            Behavior.MakeLove(l) => return self.still_mating(mut brain, l, keep.child_at, now, f, m, blocks),
            // `VillagerMakeLove.canStillUse`: the baby's time not past, and breeding possible.
            Behavior.VillagerLove(_) => return now <= keep.child_at and self.breeding_possible(mut brain, f, m, blocks),
            Behavior.GoToJobSite(_) => return brain.has(MEMORY_POTENTIAL_JOB_SITE),
            // `CelebrateVillagersSurvivedRaid.canStillUse`: while its raid's not stopped, still
            // among its level's (CAL-167).
            Behavior.RaidCelebrate(_) => {
                let r = keep.raid else return false
                return self.raids_near.any(|v| v.id == r)
            },
            Behavior.WorkAtPoi(_) => {
                // `WorkAtPoi.canStillUse`: its job site's middle still within 1.73 of it, in its
                // dimension.
                let g = brain.place(MEMORY_JOB_SITE) else return false
                return g.dimension == self.dimension and self.near_middle(g.pos, 1.73)
            },
            Behavior.Harvest(_) => return keep.ticks < 200,
            Behavior.Bonemeal(_) => return keep.ticks < 80 and keep.last_target != none,
            Behavior.Sleep(_) => {
                // `SleepInBed.canStillUse`: in its rest, above its home's bed by 0.4 and within
                // 1.14 of its middle.
                let g = brain.place(MEMORY_HOME) else return false
                return brain.is_active(ACTIVITY_REST) and self.living.body.y > f64(g.pos.y) + 0.4 and self.near_middle(g.pos, 1.14)
            },
            // `GiveGiftToHero.canStillUse` (CAL-395): the hero still seen, and no gift given yet.
            Behavior.HeroGift(_) => return self.nearest_hero(brain) != none and not keep.gift_given,
            Behavior.JumpOnBed(_) => {
                // `JumpOnBed.canStillUse`: a baby whose bed's still one to jump on, not tired of
                // walking to it, off it with no ticks left, nor of jumping, on or over it with no
                // jumps left.
                let (bx, by, bz) = keep.bed else return false
                if not self.baby() or not jumpable(f, blocks, bx, by, bz) {
                    return false
                }
                let over = self.on_or_over_bed(f, blocks)
                return (over or keep.to_reach > 0) and not (over and keep.jumps <= 0)
            },
            Behavior.CrossbowAttack(_) => return brain.has(MEMORY_ATTACK_TARGET) and self.crossbow_may_attack(mut brain, f, m, blocks),
            Behavior.SpearApproach(s) => {
                // `SpearApproach.canStillUse` (CAL-200): able, and its target farther than so far.
                let (_, far) = s
                let n = self.spear_target(brain) else return false
                return self.distance_sqr_to(n.x, n.y, n.z) > f64(far * far)
            },
            Behavior.SpearAttack(_) => return (brain.int(MEMORY_SPEAR_ENGAGE_TIME) ?? 0) > 0 and self.spear_target(brain) != none,
            Behavior.SpearRetreat(_) => return (brain.int(MEMORY_SPEAR_FLEEING_TIME) ?? 100) < 100 and brain.has(MEMORY_SPEAR_FLEEING_POSITION) and not self.navigation.is_done() and self.spear_target(brain) != none,
            _ => return false,
        }
    }

    // What the running behavior of the kind `kind` does each tick, `tick`.
    fn tick_behavior<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) {
        match kind {
            Behavior.CrossbowAttack(_) => self.crossbow_tick(mut brain, mut keep, mut random, mut sounds),
            Behavior.RaidCelebrate(_) => {
                // `CelebrateVillagersSurvivedRaid.tick` (CAL-167): one in 100, drawn from its
                // random, its celebrating sound; one in 200, open to the sky, a firework of a dye
                // and a flight of 0 to 2 drawn from it, from its eyes.
                if self.living.body.random.next_int_below(100) == 0 {
                    self.make_sound(mut sounds, "entity.villager.celebrate")
                }
                let (bx, by, bz) = self.block_position()
                if self.living.body.random.next_int_below(200) == 0 and self.open_to_sky(blocks, bx, by, bz) {
                    let color = firework_color_of(self.living.body.random.next_int_below(16))
                    let flight = self.living.body.random.next_int_below(3)
                    let at = (self.living.body.x, self.living.body.y + f64(self.living.body.eyes), self.living.body.z)
                    let owner = self.living.body.uuid
                    self.living.show(Shown.Firework((at, (color, flight), owner)), sounds.len())
                }
            },
            Behavior.SpearApproach(s) => {
                // `SpearApproach.tick` (CAL-200): its target looked at and walked to.
                let (speed, _) = s
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return
                let n = self.near_of(id) else return
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, n.x, n.y, n.z, speed)
            },
            Behavior.SpearAttack(s) => self.spear_attack_tick(mut brain, s, lf, f, m, blocks, mut cache, min_y),
            Behavior.SpearRetreat(speed) => {
                // `SpearRetreat.tick` (CAL-200): its target looked at, its ticks fleeing counted, and
                // its place to get away to walked to.
                let id = brain.entity(MEMORY_ATTACK_TARGET) else return
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
                let fleeing = brain.int(MEMORY_SPEAR_FLEEING_TIME) ?? 0
                brain.set(MEMORY_SPEAR_FLEEING_TIME, Memo.Int(fleeing + 1))
                if let p = brain.point(MEMORY_SPEAR_FLEEING_POSITION) {
                    let (x, y, z) = p
                    _ = self.move_to(lf, f, m, blocks, mut cache, min_y, x, y, z, speed)
                }
            },
            Behavior.Harvest(_) => self.harvest_tick(mut brain, mut keep, now, mut random, lf, f, blocks, mut sounds),
            Behavior.Bonemeal(_) => self.bonemeal_tick(mut brain, mut keep, now, mut random, f, blocks, sounds),
            Behavior.Swim(chance) => {
                if self.living.body.random.next_float() < chance {
                    self.jump = true
                }
            },
            Behavior.Panic(speed) => {
                if self.navigation.is_done() {
                    if let p = self.panic_place(lf, f, m, blocks, mut cache, min_y) {
                        let (x, y, z) = p
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                    }
                }
            },
            Behavior.LookAtTarget(_) => {
                if let t = brain.tracker(MEMORY_LOOK_TARGET) {
                    if let p = self.tracked_place(t) {
                        let (x, y, z) = p
                        self.look.set_look_at(x, y, z, HEAD_ROT_SPEED, self.max_head_x_rot())
                    }
                }
            },
            Behavior.MoveToTarget(_) => {
                // Its path as its navigation has it now, where that's another, and where its walk
                // target's moved more than 2 blocks from where it last made one to, a new one
                // followed.
                let now_path = self.navigation.path_id()
                let has = now_path != none
                if now_path != keep.path {
                    keep.path = now_path
                    brain.set_or_erase(MEMORY_PATH, if let n = now_path { some(Memo.Path(n)) } else { none })
                }
                if has and keep.last_target != none {
                    let walk = brain.walk(MEMORY_WALK_TARGET) else return
                    let (lx, ly, lz) = keep.last_target ?? (0, 0, 0)
                    if let at = self.tracked_block(walk.target) {
                        let (tx, ty, tz) = at
                        let (dx, dy, dz) = (f64(tx - lx), f64(ty - ly), f64(tz - lz))
                        if dx * dx + dy * dy + dz * dz > 4.0 and self.compute_path(mut brain, walk, mut keep, now, lf, f, m, blocks, mut cache, min_y) {
                            keep.last_target = some(at)
                            self.follow_path(mut brain, mut keep, lf, f, blocks, min_y)
                        }
                    }
                }
            },
            Behavior.CountDown(memory) => {
                let left = brain.int(memory) ?? 0
                brain.set(memory, Memo.Int(left - 1))
            },
            Behavior.Tempted(speed) => {
                let player = brain.entity(MEMORY_TEMPTING_PLAYER) else return
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: player, eyes: true })))
                let close = if self.baby() { 1.0 } else { 2.0 }
                let n = self.near_of(player) else return
                if self.distance_sqr_to(n.x, n.y, n.z) < close * close {
                    brain.erase(MEMORY_WALK_TARGET)
                } else {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: player, eyes: false }), speed: speed, close_enough: 2 }))
                }
            },
            Behavior.BallUp(_) => self.ball_up_tick(brain, mut keep, mut sounds),
            Behavior.VillagerPanic(_) => {
                // Every 100 ticks of the game, an iron golem summoned where three villagers near
                // want one, `spawnGolemIfNeeded`, asked of its level; one wants one only where it
                // slept in the last day and hasn't seen a golem lately.
                if now % 100 == 0 {
                    if let slept = brain.long(MEMORY_LAST_SLEPT) {
                        if now - slept < 24000 and not brain.has(MEMORY_GOLEM_DETECTED_RECENTLY) {
                            let from = self.golem_place()
                            self.living.show(Shown.CallGolem((3, from)), sounds.len())
                        }
                    }
                }
            },
            Behavior.ShowTrades(_) => self.show_trades_tick(mut brain, mut keep, sounds),
            Behavior.FollowTrader(speed) => self.follow_trader(mut brain, speed),
            Behavior.TradeWithVillager(_) => self.trade_with_villager_tick(mut brain, keep, now, f, sounds),
            Behavior.VillagerLove(_) => self.make_love_tick(mut brain, keep, now, lf, f, m, blocks, mut cache, min_y, sounds),
            Behavior.MakeLove(l) => self.mate_tick(mut brain, l, keep.child_at, now, sounds),
            Behavior.GoToJobSite(speed) => {
                // `GoToPotentialJobSite.tick`: the job site it found looked at and walked to till
                // it's within 1, `setWalkAndLookTargetMemories`.
                if let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) {
                    let (x, y, z) = (g.pos.x, g.pos.y, g.pos.z)
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: speed, close_enough: 1 }))
                }
            },
            Behavior.HeroGift(_) => {
                // `GiveGiftToHero.tick` (CAL-395): the hero looked at; within 5 of their block,
                // its gift thrown to them once 20 ticks have passed since it started, for its
                // head to turn, `throwGift`; else walked to at 0.5 till within 5,
                // `setWalkAndLookTargetMemories`.
                if let hero = self.nearest_hero(brain) {
                    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: hero.id, eyes: true })))
                    let (vx, vy, vz) = self.block_position()
                    let (hx, hy, hz) = (floor_of(hero.x), floor_of(hero.y), floor_of(hero.z))
                    let (dx, dy, dz) = (f64(vx - hx), f64(vy - hy), f64(vz - hz))
                    if dx * dx + dy * dy + dz * dz < 25.0 {
                        if now - keep.gift_start > 20 {
                            let gift = Barter { gift: some(self.gift_table()), x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, lift: f64(self.living.body.eyes) - f64(0.3f32), to: (hero.x, hero.y, hero.z), thrower: self.living.body.uuid }
                            self.living.show(Shown.Barter(gift), sounds.len())
                            keep.gift_given = true
                        }
                    } else {
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: hero.id, eyes: false }), speed: 0.5f32, close_enough: 5 }))
                    }
                }
            },
            Behavior.JumpOnBed(_) => {
                // `JumpOnBed.tick`: off its bed, a tick less to reach it; on or over it, a tick
                // less to wait, else, on its surface, a jump, a jump less and 5 ticks till the
                // next.
                if not self.on_or_over_bed(f, blocks) {
                    keep.to_reach -= 1
                } else if keep.jump_wait > 0 {
                    keep.jump_wait -= 1
                } else {
                    let (x, y, z) = self.block_position()
                    if jumpable(f, blocks, x, y, z) {
                        self.jump = true
                        keep.jumps -= 1
                        keep.jump_wait = 5
                    }
                }
            },
            _ => {},
        }
    }

    // `ArmadilloBallUp.tick`: its peek a tick nearer; rolled long enough, scared, landing heard on
    // the ground; else, as the danger seen runs out, more than 75 ticks left counting as about,
    // its peek drawn again as that changes; scared, peeking on the ground while danger's about,
    // entity event 64, and starting to unroll once fewer than 30 are left, `UNROLLING`'s length;
    // unrolling, scared again where more are.
    fn ball_up_tick(mut self, brain: Brain, keep: mut Keep, sounds: mut List<EntitySound>) {
        if keep.peek > 0 {
            keep.peek -= 1
        }
        if self.armadillo_state() == ARMADILLO_ROLLING and self.in_state_ticks > i64(animation_of(ARMADILLO_ROLLING)) {
            self.switch_to_state(ARMADILLO_SCARED)
            if self.living.body.on_ground {
                self.living.play(mut sounds, String("entity.armadillo.land"), 1.0f32, 1.0f32)
            }
            return
        }
        let state = self.armadillo_state()
        let left = brain.ttl(MEMORY_DANGER_DETECTED_RECENTLY)
        let about = left > 75
        if about != keep.danger_was {
            keep.peek = self.pick_peek()
        }
        keep.danger_was = about
        let unrolling = i64(animation_of(ARMADILLO_UNROLLING))
        if state == ARMADILLO_SCARED {
            if keep.peek == 0 and self.living.body.on_ground and about {
                self.living.show(Shown.Event(64), sounds.len())
                keep.peek = self.pick_peek()
            }
            if left < unrolling {
                self.living.play(mut sounds, String("entity.armadillo.unroll_start"), 1.0f32, 1.0f32)
                self.switch_to_state(ARMADILLO_UNROLLING)
            }
        } else if state == ARMADILLO_UNROLLING and left > unrolling {
            self.switch_to_state(ARMADILLO_SCARED)
        }
    }

    // What the behavior of the kind `kind` does as it stops, `stop`.
    fn stop_behavior(mut self, brain: mut Brain, kind: Behavior, keep: mut Keep, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        match kind {
            Behavior.HeroGift(_) => {
                // `GiveGiftToHero.stop` (CAL-395): its next gift 600 to 6600 ticks on, drawn from
                // the level's random, `calculateTimeUntilNextGift`; its interaction, walk and look
                // targets forgotten.
                keep.gift_in = 600 + random.next_int_below(6001)
                brain.erase(MEMORY_INTERACTION_TARGET)
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_LOOK_TARGET)
            },
            Behavior.RaidCelebrate(_) => {
                // `CelebrateVillagersSurvivedRaid.stop` (CAL-167): its raid forgotten, and its
                // schedule's activity on.
                keep.raid = none
                let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
                brain.update_from_schedule(self.game_time, scheduled)
            },
            Behavior.SpearApproach(_) => {
                // `SpearApproach.stop` (CAL-200): its path stopped, and its spear charging.
                self.navigation.stop()
                brain.set(MEMORY_SPEAR_STATUS, Memo.Int(SPEAR_CHARGING))
            },
            Behavior.SpearAttack(_) => {
                // `SpearAttack.stop` (CAL-200): its path and its use stopped, its places and time
                // forgotten, and retreating.
                self.navigation.stop()
                self.living.stop_using()
                brain.erase(MEMORY_SPEAR_CHARGE_POSITION)
                brain.erase(MEMORY_SPEAR_ENGAGE_TIME)
                brain.set(MEMORY_SPEAR_STATUS, Memo.Int(SPEAR_RETREAT))
            },
            Behavior.SpearRetreat(_) => {
                // `SpearRetreat.stop` (CAL-200): its path stopped, not aggressive, its use stopped,
                // and its fleeing and status forgotten.
                self.navigation.stop()
                self.set_flag(AGGRESSIVE_FLAG, false)
                self.living.stop_using()
                brain.erase(MEMORY_SPEAR_FLEEING_TIME)
                brain.erase(MEMORY_SPEAR_FLEEING_POSITION)
                brain.erase(MEMORY_SPEAR_STATUS)
            },
            Behavior.CrossbowAttack(_) => {
                // `CrossbowAttack.stop` (CAL-200): its use stopped, and, holding a crossbow, no
                // longer charging; what its use left, nothing, emptied of its charge.
                if self.living.using_item() {
                    self.living.stop_using()
                }
                if self.holding_crossbow() {
                    self.living.data.set(MONSTER_OWN + 2, Value.Bool(false))
                }
            },
            Behavior.Sleep(_) => {
                // `SleepInBed.stop`: asleep, it gets up, which it does as its brain's tick goes
                // on, where the blocks around it are; its next start 40 ticks on.
                if self.living.sleeping != none {
                    self.wake_due = true
                    keep.next_start = self.game_time + 40
                }
            },
            Behavior.Harvest(_) => {
                // `HarvestFarmland.stop`: its look and walk forgotten, its ticks worked none
                // again, and its next start 40 ticks on.
                brain.erase(MEMORY_LOOK_TARGET)
                brain.erase(MEMORY_WALK_TARGET)
                keep.ticks = 0
                keep.next_start = self.game_time + 40
            },
            Behavior.Bonemeal(_) => {
                // `UseBonemeal.stop`: its main hand empty again, and its tick count kept.
                self.living.equipment[0] = none
                keep.last_check = i64(self.living.body.tick_count)
            },
            Behavior.Panic(_) => brain.erase(MEMORY_IS_PANICKING),
            Behavior.LookAtTarget(_) => brain.erase(MEMORY_LOOK_TARGET),
            Behavior.MoveToTarget(_) => {
                // Stuck short of its walk target, it waits up to 39 ticks, drawn from the level's
                // random, before it tries again.
                if let walk = brain.walk(MEMORY_WALK_TARGET) {
                    if not self.reached(walk) and self.navigation.stuck {
                        keep.cooldown = random.next_int_below(40)
                    }
                }
                self.navigation.stop()
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_PATH)
                keep.path = none
                keep.found = none
            },
            Behavior.CountDown(memory) => brain.erase(memory),
            Behavior.Tempted(_) => {
                brain.set(MEMORY_TEMPTATION_COOLDOWN_TICKS, Memo.Int(100))
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_LOOK_TARGET)
            },
            Behavior.BallUp(_) => {
                if not self.can_stay_rolled_up() {
                    self.roll_out(mut sounds)
                }
            },
            Behavior.ShowTrades(_) => {
                brain.erase(MEMORY_INTERACTION_TARGET)
                self.clear_held_item()
                keep.player_item = none
            },
            Behavior.TradeWithVillager(_) => brain.erase(MEMORY_INTERACTION_TARGET),
            Behavior.VillagerLove(_) => brain.erase(MEMORY_BREED_TARGET),
            Behavior.MakeLove(_) => {
                // `AnimalMakeLove.stop`: its breed, walk and look targets forgotten, and no baby
                // to come.
                brain.erase(MEMORY_BREED_TARGET)
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_LOOK_TARGET)
                keep.child_at = 0
            },
            Behavior.FollowTrader(_) => {
                brain.erase(MEMORY_WALK_TARGET)
                brain.erase(MEMORY_LOOK_TARGET)
            },
            Behavior.GoToJobSite(_) => {
                // `GoToPotentialJobSite.stop`: where the job site it found is a point of interest
                // still, its ticket given back, and the site forgotten.
                if let g = brain.place(MEMORY_POTENTIAL_JOB_SITE) {
                    if g.dimension != self.dimension {
                        self.living.show(Shown.Missing(String("A villager's giving back a job site's ticket in another dimension, GoToPotentialJobSite")), sounds.len())
                    } else {
                        var pois = self.pois.take() ?? Pois.new(0, 0)
                        if pois.exists(g.pos, types_of(u32.MAX)) {
                            _ = pois.release(g.pos)
                        }
                        self.pois = some(pois)
                    }
                }
                brain.erase(MEMORY_POTENTIAL_JOB_SITE)
            },
            Behavior.JumpOnBed(_) => {
                keep.bed = none
                keep.to_reach = 0
                keep.jumps = 0
                keep.jump_wait = 0
            },
            _ => {},
        }
    }

    // `Swim`'s and `FloatGoal`'s: deeper in water than it jumps out of, `getFluidJumpThreshold`,
    // 0.4 or 0 for eyes below 0.4, or in lava.
    fn floats(self) -> bool {
        let threshold = if f64(self.living.body.eyes) < 0.4 { 0.0 } else { 0.4 }
        return self.living.body.water > threshold or self.living.body.in_lava()
    }

    // `AnimalPanic.getPanicPos`: on fire, the nearest water, `lookForWater`; else a place on land
    // up to 5 across and 4 up or down, `LandRandomPos.getPos`.
    fn panic_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        if self.living.on_fire() {
            if let w = self.look_for_water(f, m, blocks, 5) {
                let (wx, wy, wz) = w
                return some((f64(wx) + 0.5, f64(wy), f64(wz) + 0.5))
            }
        }
        return self.random_place(true, 5, 4, lf, f, blocks, mut cache, min_y)
    }

    // `Armadillo.customServerAiStep`, before `Animal`'s (CAL-160): its brain's tick; its activity,
    // `updateActivity`, panic where danger's been seen and it isn't panicking, else idle; then,
    // alive, its scute time a tick less, and at 0 where it drops loot, a scute shed,
    // `gameplay/armadillo_shed`, as its level drops it, its sound's pitch drawn, and its time drawn
    // again. The game event of its shedding comes with game events.
    fn armadillo_step<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        // Its brain swings no doors, so its tick never stops.
        _ = self.tick_brain(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds)
        if let held = self.brain.take() {
            var brain = held
            let order: List<i32> = [ACTIVITY_PANIC, ACTIVITY_IDLE]
            brain.set_first_valid(order)
            self.brain = some(brain)
        }
        if not self.living.alive() {
            return
        }
        self.scute_time -= 1
        if self.scute_time <= 0 and self.mob_drops and not self.baby() {
            let laid = Laid { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, item: String("minecraft:armadillo_scute"), table: String("minecraft:gameplay/armadillo_shed") }
            self.living.show(Shown.Laid(laid), sounds.len())
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, String("entity.armadillo.scute_drop"), 1.0f32, (a - b) * 0.2f32 + 1.0f32)
            self.scute_time = self.pick_scute_time()
        }
    }

    // `Hoglin.customServerAiStep`, all of it, not `Animal`'s (CAL-200): its brain's tick, which
    // stops for its level to deal an attack, `doHurtTarget`, then and there; then its activity,
    // `HoglinAi.updateActivity`, fight where it has a target, else avoid where it has something to
    // avoid, else idle, its activity's sound made where that changed, `makeSound`, and aggressive
    // while it has a target; then, zombifying, its ticks at it counted, and past 300 its
    // conversion's sound and its conversion, `finishConversion`, into a zoglin, which its level
    // makes once its tick's done, of it as it is now, `converted_living`; else those back to 0.
    // Whether its brain's tick stopped.
    fn hoglin_step<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.tick_brain(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
            return true
        }
        if let held = self.brain.take() {
            var brain = held
            let before = brain.active_non_core()
            let order: List<i32> = [ACTIVITY_FIGHT, ACTIVITY_AVOID, ACTIVITY_IDLE]
            brain.set_first_valid(order)
            let after = brain.active_non_core()
            let fighting = brain.has(MEMORY_ATTACK_TARGET)
            self.brain = some(brain)
            if before != after {
                if let sound = self.hoglin_sound(blocks) {
                    let pitch = self.voice_pitch()
                    self.living.play(mut sounds, sound, self.sound_volume, pitch)
                }
            }
            self.set_flag(AGGRESSIVE_FLAG, fighting)
        }
        if self.hoglin_converting(blocks) {
            self.time_in_overworld += 1
            if self.time_in_overworld > 300 {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, String("entity.hoglin.converted_to_zombified"), self.sound_volume, pitch)
                self.converted_living = some(self.living.copy())
                self.living.show(Shown.Converted((ZOGLIN, 0)), sounds.len())
                // `discard`: gone for the rest of its tick, though it still moves and pushes.
                self.living.body.removed = true
            }
        } else {
            self.time_in_overworld = 0
        }
        return false
    }

    // `Zoglin.customServerAiStep` (CAL-200): its brain's tick, which stops for its level to deal an
    // attack, `doHurtTarget`, then and there; then its activity, `updateActivity`, fight where it
    // has a target, else idle, its angry sound made where it's come to fight, `playAngrySound`, and
    // aggressive while it has a target. Whether its brain's tick stopped.
    fn zoglin_step<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.tick_brain(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
            return true
        }
        if let held = self.brain.take() {
            var brain = held
            let before = brain.active_non_core()
            let order: List<i32> = [ACTIVITY_FIGHT, ACTIVITY_IDLE]
            brain.set_first_valid(order)
            let after = brain.active_non_core()
            let fighting = brain.has(MEMORY_ATTACK_TARGET)
            self.brain = some(brain)
            if after == some(ACTIVITY_FIGHT) and before != some(ACTIVITY_FIGHT) {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, String("entity.zoglin.angry"), self.sound_volume, pitch)
            }
            self.set_flag(AGGRESSIVE_FLAG, fighting)
        }
        return false
    }

    // `PiglinBrute.customServerAiStep` (CAL-200): its brain's tick, which stops for its level to
    // deal an attack then and there; then its activity, `PiglinBruteAi.updateActivity`, fight
    // where it has a target, else idle, its activity's sound made where that changed, and
    // aggressive while it has a target; its activity's sound again by a draw under 0.0125 from the
    // level's random, `maybePlayActivitySound`; then `AbstractPiglin`'s, `piglin_converting_step`.
    // Whether its brain's tick stopped.
    fn brute_step<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.tick_brain(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
            return true
        }
        if let held = self.brain.take() {
            var brain = held
            let before = brain.active_non_core()
            let order: List<i32> = [ACTIVITY_FIGHT, ACTIVITY_IDLE]
            brain.set_first_valid(order)
            let after = brain.active_non_core()
            let fighting = brain.has(MEMORY_ATTACK_TARGET)
            self.brain = some(brain)
            if before != after {
                self.brute_activity_sound(mut sounds)
            }
            self.set_flag(AGGRESSIVE_FLAG, fighting)
        }
        var due = false
        if let lent = self.level_random.take() {
            var random = lent
            due = f64(random.next_float()) < 0.0125
            self.level_random = some(random)
        }
        if due {
            self.brute_activity_sound(mut sounds)
        }
        self.piglin_converting_step(blocks, mut sounds)
        return false
    }

    // `PiglinBruteAi.playActivitySound`: its angry sound, `makeSound`, while it fights (CAL-200).
    fn brute_activity_sound(mut self, sounds: mut List<EntitySound>) {
        if self.brain_active(ACTIVITY_FIGHT) {
            let pitch = self.voice_pitch()
            self.living.play(mut sounds, String("entity.piglin_brute.angry"), self.sound_volume, pitch)
        }
    }

    // `AbstractPiglin.customServerAiStep`'s own (CAL-200): its ticks zombifying counted, else back
    // to 0, `isConverting`; past 300, its conversion's sound, `playConvertedSound`, but on peaceful,
    // and its conversion into a zombified piglin, `finishConversion`, which its level makes once
    // its tick's done, of it as it is now, `converted_living`, it gone for the rest of its tick.
    fn piglin_converting_step<B: MobLight>(mut self, blocks: B, sounds: mut List<EntitySound>) {
        if self.hoglin_converting(blocks) {
            self.time_in_overworld += 1
        } else {
            self.time_in_overworld = 0
        }
        if self.time_in_overworld > 300 {
            if self.difficulty != 0 {
                let pitch = self.voice_pitch()
                let sound = if self.species == PIGLIN { "entity.piglin.converted_to_zombified" } else { "entity.piglin_brute.converted_to_zombified" }
                self.living.play(mut sounds, String(sound), self.sound_volume, pitch)
            }
            if self.species == PIGLIN {
                // `Piglin.finishConversion`, before `AbstractPiglin`'s: what it admires in its off
                // hand dropped, `cancelAdmiring`, then all its inventory, `spawnAtLocation`.
                if self.brain_has(MEMORY_ADMIRING_ITEM) {
                    if let held = self.living.equipment[1].take() {
                        self.spill_here(held, sounds.len())
                    }
                }
                for s in self.stacks() {
                    self.spill_here(s.copy(), sounds.len())
                }
                self.inventory = List<Tag?>()
                self.inventory_read = true
                _ = self.kept.remove("Inventory")
            }
            self.converted_living = some(self.living.copy())
            self.living.show(Shown.Converted((ZOMBIFIED_PIGLIN, 0)), sounds.len())
            self.living.body.removed = true
        }
    }

    // `spawnAtLocation` of `stack` where it stands, which its level drops, `heard` its sounds so far
    // (CAL-200).
    fn spill_here(mut self, stack: own Tag, heard: usize) {
        let spilled = Spilled { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, stack: stack }
        self.living.show(Shown.Spilled(spilled), heard)
    }

    /// Whether its brain holds the memory `m`, a brain mob's.
    pub fn brain_has(self, m: i32) -> bool {
        let brain = self.brain else return false
        return brain.has(m)
    }

    // `Piglin.customServerAiStep` (CAL-200): its brain's tick, which stops for its level to deal an
    // attack then and there; then `PiglinAi.updateActivity`: the first of admiring, fighting,
    // avoiding, celebrating, riding and idling it may do, its activity's sound made where that
    // changed, `makeSound`; aggressive while it has a target; its dance forgotten without a place
    // to celebrate, and dancing while it remembers one, `setDancing`; then `AbstractPiglin`'s,
    // `piglin_converting_step`. Whether its brain's tick stopped.
    fn piglin_step<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.tick_brain(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
            return true
        }
        if let held = self.brain.take() {
            var brain = held
            let before = brain.active_non_core()
            let order: List<i32> = [ACTIVITY_ADMIRE_ITEM, ACTIVITY_FIGHT, ACTIVITY_AVOID, ACTIVITY_CELEBRATE, ACTIVITY_RIDE, ACTIVITY_IDLE]
            brain.set_first_valid(order)
            let after = brain.active_non_core()
            let fighting = brain.has(MEMORY_ATTACK_TARGET)
            let riding = brain.has(MEMORY_RIDE_TARGET)
            if not brain.has(MEMORY_CELEBRATE_LOCATION) {
                brain.erase(MEMORY_DANCING)
            }
            let dancing = brain.has(MEMORY_DANCING)
            self.brain = some(brain)
            if before != after {
                if let sound = self.piglin_sound(blocks) {
                    let pitch = self.voice_pitch()
                    self.living.play(mut sounds, sound, self.sound_volume, pitch)
                }
            }
            self.set_flag(AGGRESSIVE_FLAG, fighting)
            // A baby riding a baby piglin or hoglin with nothing to ride gets off, `stopRiding`,
            // `isBabyRidingBaby`, which its level does once its tick's done.
            if not riding and self.baby() {
                if let v = self.living.body.vehicle {
                    if let n = self.near_of(v) {
                        if (n.species == PIGLIN or n.species == HOGLIN) and n.baby {
                            self.living.show(Shown.Dismount(v), sounds.len())
                        }
                    }
                }
            }
            self.living.data.set(MONSTER_OWN + 3, Value.Bool(dancing))
        }
        self.piglin_converting_step(blocks, mut sounds)
        return false
    }

    // `PiglinAi.getSoundForCurrentActivity` (CAL-200): its activity's, where it has one other than
    // its core: an angry one fighting; a retreat's zombifying, or avoiding what's within 12; its
    // admiring and celebrating ones; a jealous one where it sees a player holding what it loves; a
    // retreat's where a repellent's near, else its ambient one.
    fn piglin_sound<B: MobLight>(self, blocks: B) -> String? {
        let brain = self.brain else return none
        let activity = brain.active_non_core() else return none
        if activity == ACTIVITY_FIGHT {
            return some(String("entity.piglin.angry"))
        }
        if self.hoglin_converting(blocks) {
            return some(String("entity.piglin.retreat"))
        }
        if activity == ACTIVITY_AVOID {
            if let id = brain.entity(MEMORY_AVOID_TARGET) {
                if let n = self.near_of(id) {
                    if self.distance_sqr_to(n.x, n.y, n.z) < 144.0 {
                        return some(String("entity.piglin.retreat"))
                    }
                }
            }
        }
        if activity == ACTIVITY_ADMIRE_ITEM {
            return some(String("entity.piglin.admiring_item"))
        }
        if activity == ACTIVITY_CELEBRATE {
            return some(String("entity.piglin.celebrate"))
        }
        if brain.has(MEMORY_NEAREST_PLAYER_HOLDING_WANTED_ITEM) {
            return some(String("entity.piglin.jealous"))
        }
        return some(String(if brain.has(MEMORY_NEAREST_REPELLENT) { "entity.piglin.retreat" } else { "entity.piglin.ambient" }))
    }

    /// `Piglin.setBaby`: a baby or not in its values, its speed's `minecraft:baby` modifier, a fifth
    /// again on its base, on a baby only, and its size made again where that changed it (CAL-200,
    /// CAL-359).
    pub fn set_piglin_baby(mut self, on: bool) {
        let was = self.living.data.flag(MONSTER_OWN + 1)
        self.living.data.set(MONSTER_OWN + 1, Value.Bool(on))
        let speed = attribute("movement_speed")
        if on {
            self.living.attributes.replace(speed, Modifier { id: Identifier { namespace: "minecraft", path: "baby" }, amount: f64(0.2f32), operation: ADD_MULTIPLIED_BASE })
        } else {
            self.living.attributes.take_off(speed, Identifier { namespace: "minecraft", path: "baby" })
        }
        if was != on {
            self.refresh_size()
        }
    }

    // `Piglin.createSpawnWeapon`, from its own random (CAL-200): a crossbow by a draw under a half,
    // else 1 in 10 a golden spear, else a golden sword.
    fn piglin_weapon(mut self) -> str {
        if f64(self.living.body.random.next_float()) < 0.5 {
            return "minecraft:crossbow"
        }
        return if self.living.body.random.next_int_below(10) == 0 { "minecraft:golden_spear" } else { "minecraft:golden_sword" }
    }

    // `Piglin.canHunt`: unless it can't, `CannotHunt` (CAL-200).
    fn can_hunt(self) -> bool {
        return self.species == PIGLIN and not self.cannot_hunt
    }

    /// `Piglin.hurtServer`'s end, hurt by the living entity `attacker` (CAL-200),
    /// `PiglinAi.wasHurtBy`: unless a piglin hurt it, what it holds in its off hand given up; its
    /// celebration, dance and admiring forgotten, and admiring disabled for 400 ticks where a
    /// player hurt it; what it avoids forgotten where that's of another kind than `attacker`. A
    /// baby then avoids `attacker` for 100 ticks and, where it may attack them seen or not, tells
    /// the grown piglins it knows of; a grown one hurt by a hoglin where hoglins outnumber its
    /// piglins avoids it and tells the grown piglins it sees to, `broadcastRetreat`, its retreat's
    /// ticks and the time till it hunts drawn from the level's `random`; else, not avoiding,
    /// `maybeRetaliate`, as a brute's is. The grown piglins its level's to tell of `attacker`, by
    /// ID, whether all are to be angry at their own nearest players, and those to retreat.
    pub fn piglin_hurt_by<R: RandomSource>(mut self, attacker: Near, targeted: (f64, f64, f64)?, random: mut R) -> (List<i32>, bool, List<i32>) {
        let nothing = (List<i32>(), false, List<i32>())
        if attacker.species == PIGLIN {
            return nothing
        }
        if let held = self.living.equipment[1].take() {
            // `stopHoldingOffHandItem` not bartering: a grown one's gold ingot is lost; what else
            // it gives up Calcite doesn't do yet, as its level doesn't lend it the items it'd equip.
            if self.baby() or held_name(some(held)) != "minecraft:gold_ingot" {
                self.living.show(Shown.Missing(String("A piglin giving up what it holds in its off hand as it's hurt")), 0)
            }
        }
        var brain = self.brain.take() else return nothing
        brain.erase(MEMORY_CELEBRATE_LOCATION)
        brain.erase(MEMORY_DANCING)
        brain.erase(MEMORY_ADMIRING_ITEM)
        if attacker.species == PLAYER {
            brain.set_for(MEMORY_ADMIRING_DISABLED, Memo.Flag(true), 400)
        }
        if let id = brain.entity(MEMORY_AVOID_TARGET) {
            let kind = match self.near_of(id) { some(n) => n.species, none => i32.MIN }
            if kind != attacker.species {
                brain.erase(MEMORY_AVOID_TARGET)
            }
        }
        if self.baby() {
            brain.set_for(MEMORY_AVOID_TARGET, Memo.Entity(attacker.id), 100)
            let attackable = self.attackable_unseen(brain, attacker)
            let told = brain.entities(MEMORY_NEARBY_ADULT_PIGLINS)
            self.brain = some(brain)
            return if attackable { (told, false, List<i32>()) } else { nothing }
        }
        if attacker.species == HOGLIN and hoglins_outnumber(brain) {
            avoid_for_a_while(mut brain, attacker.id, mut random)
            let seen = brain.entities(MEMORY_NEAREST_VISIBLE_ADULT_PIGLINS)
            self.brain = some(brain)
            return (List<i32>(), false, seen)
        }
        let avoiding = brain.is_active(ACTIVITY_AVOID)
        self.brain = some(brain)
        if avoiding {
            return nothing
        }
        let (told, universal) = self.retaliate(attacker, targeted, mut random)
        return (told, universal, List<i32>())
    }

    /// `PiglinAi.retreatFromNearestTarget` of `avoided`, told by a piglin that sees it (CAL-200): the
    /// nearest of `avoided`, what it avoids and its target, avoided for a while, its ticks drawn
    /// from the level's `random`.
    pub fn piglin_retreat<R: RandomSource>(mut self, avoided: Near, random: mut R) {
        var brain = self.brain.take() else return
        var nearest = avoided
        for m in [MEMORY_AVOID_TARGET, MEMORY_ATTACK_TARGET] {
            if let id = brain.entity(m) {
                if let n = self.near_of(id) {
                    if self.distance_sqr_to(n.x, n.y, n.z) < self.distance_sqr_to(nearest.x, nearest.y, nearest.z) {
                        nearest = n
                    }
                }
            }
        }
        avoid_for_a_while(mut brain, nearest.id, mut random)
        self.brain = some(brain)
    }

    // `Piglin.wantsToPickUp`'s own, `PiglinAi.wantsToPickup` of `stack` (CAL-200): not what babies
    // ignore as a baby, nor a repellent, nor anything while admiring's disabled and it has a target;
    // gold ingots unless it holds what it loves in its off hand; gold nuggets where it has room;
    // food where it hasn't eaten lately and has room; what it doesn't love where it would replace
    // what it wears or holds there, `canReplaceCurrentItem`; what it loves unless it holds such in
    // its off hand, where it has room.
    fn piglin_wants<W: Wearing>(self, lf: LivingFacts, f: Facts, items: W, stack: Tag) -> bool {
        let item = held_name(some(stack.copy()))
        if self.baby() and lf.piglin_baby_ignored.contains(item) {
            return false
        }
        if lf.piglin_repellent_items.contains(item) {
            return false
        }
        let brain = self.brain else return false
        if brain.has(MEMORY_ADMIRING_DISABLED) and brain.has(MEMORY_ATTACK_TARGET) {
            return false
        }
        if item == "minecraft:gold_ingot" {
            return self.not_holding_loved(lf)
        }
        let room = self.has_room_for(f, stack.copy())
        if item == "minecraft:gold_nugget" {
            return room
        }
        if lf.piglin_food.contains(item) {
            return not brain.has(MEMORY_ATE_RECENTLY) and room
        }
        if not lf.piglin_loved.contains(item) {
            let slot = self.slot_for(items, stack.copy())
            return self.can_replace(lf, items, stack, self.living.equipment[slot].copy(), slot)
        }
        return self.not_holding_loved(lf) and room
    }

    // `SimpleContainer.canAddItem` of `stack` to its inventory: an empty slot, or one with the same
    // item and components not full (CAL-200).
    fn has_room_for(self, f: Facts, stack: Tag) -> bool {
        for s in self.inventory_slots(f) {
            let t = s else return true
            if same_components(some(t.copy()), some(stack.copy())) and count_of(some(t.copy())) < stack_limit(f, t) {
                return true
            }
        }
        return false
    }

    // `PiglinAi.isNotHoldingLovedItemInOffHand` (CAL-200).
    fn not_holding_loved(self, lf: LivingFacts) -> bool {
        let held = self.living.equipment[1].copy() else return true
        return not lf.piglin_loved.contains(held_name(some(held)))
    }

    /// `Piglin.pickUpItem` of the item `item`, holding `stack`, `PiglinAi.pickUpItem` (CAL-200): its
    /// walk stopped; all of a stack of gold nuggets taken, else one, `take`, shown those who see it;
    /// what it loves held in its off hand, what it held there dropped, and admired, its time trying
    /// to reach it forgotten; food eaten where it hasn't lately, `ATE_RECENTLY` for 200 ticks; else
    /// equipped where it may be, else put in its inventory. How many it took.
    pub fn piglin_pick_up<W: Wearing>(mut self, item: i32, lf: LivingFacts, f: Facts, items: W, stack: Tag, sounds: mut List<EntitySound>) -> i32 {
        if let held = self.brain.take() {
            var brain = held
            brain.erase(MEMORY_WALK_TARGET)
            self.brain = some(brain)
        }
        self.navigation.stop()
        let name = held_name(some(stack.copy()))
        let count = if name == "minecraft:gold_nugget" { count_of(some(stack.copy())) } else { 1 }
        self.living.show(Shown.Picked((item, count)), sounds.len())
        let taken = stack_of_count(stack, count)
        if lf.piglin_loved.contains(name) {
            if let held = self.brain.take() {
                var brain = held
                brain.erase(MEMORY_TIME_TRYING_TO_REACH_ADMIRE_ITEM)
                self.brain = some(brain)
            }
            self.hold_in_off_hand(items, taken, mut sounds)
            self.admire()
        } else if lf.piglin_food.contains(name) and not self.brain_has(MEMORY_ATE_RECENTLY) {
            if let held = self.brain.take() {
                var brain = held
                brain.set_for(MEMORY_ATE_RECENTLY, Memo.Flag(true), 200)
                self.brain = some(brain)
            }
        } else if self.equip_if_possible(lf, items, taken.copy(), mut sounds) == none {
            self.put_in_inventory(f, taken, sounds.len())
        }
        return count
    }

    // `PiglinAi.holdInOffhand` of `stack` (CAL-200): what it held there dropped, `spawnAtLocation`,
    // then `Piglin.holdInOffHand`: held there, sure to drop, and kept, but for a gold ingot.
    fn hold_in_off_hand<W: Wearing>(mut self, items: W, stack: Tag, sounds: mut List<EntitySound>) {
        if let old = self.living.equipment[1].copy() {
            self.spill_here(old, sounds.len())
        }
        let ingot = held_name(some(stack.copy())) == "minecraft:gold_ingot"
        self.equip_in(items, 1, stack, mut sounds)
        self.guarantee_drop(1)
        if not ingot {
            self.persistence_required = true
        }
    }

    // `PiglinAi.admireGoldItem`: admiring for 119 ticks (CAL-200).
    fn admire(mut self) {
        if let held = self.brain.take() {
            var brain = held
            brain.set_for(MEMORY_ADMIRING_ITEM, Memo.Flag(true), 119)
            self.brain = some(brain)
        }
    }

    // `PiglinAi.putInInventory` of `stack` (CAL-200): added to its inventory, what doesn't fit
    // thrown toward a place near, which Calcite doesn't do yet, so it's marked missing.
    fn put_in_inventory(mut self, f: Facts, stack: Tag, heard: usize) {
        self.ready_inventory(f)
        var slots = self.inventory.copy()
        let left = add_to(mut slots, stack, f)
        self.inventory = slots
        if left != none {
            self.living.show(Shown.Missing(String("A piglin throwing what doesn't fit in its inventory")), heard)
        }
    }

    // `PiglinAi.stopHoldingOffHandItem`, `bartering` or not (CAL-200): its off hand emptied; grown,
    // a gold ingot bartered where `bartering`, else lost, and what else equipped where it may be,
    // else put in its inventory; a baby equips it where it may, else gives up what it holds in its
    // main hand, to its inventory where it loves that, else thrown, and holds it there. What's to
    // be thrown, whether it's the barter's, and what a baby holds in its main hand after.
    fn give_up_off_hand<W: Wearing>(mut self, bartering: bool, lf: LivingFacts, f: Facts, items: W, sounds: mut List<EntitySound>) -> (List<Tag>, bool, Tag?) {
        let stack = self.living.equipment[1].take() else return (List<Tag>(), false, none)
        let name = held_name(some(stack.copy()))
        if not self.baby() {
            let currency = name == "minecraft:gold_ingot"
            if currency {
                return (List<Tag>(), bartering, none)
            }
            if self.equip_if_possible(lf, items, stack.copy(), mut sounds) == none {
                self.put_in_inventory(f, stack, sounds.len())
            }
            return (List<Tag>(), false, none)
        }
        if self.equip_if_possible(lf, items, stack.copy(), mut sounds) != none {
            return (List<Tag>(), false, none)
        }
        var thrown = List<Tag>()
        if let main = self.living.equipment[0].copy() {
            if lf.piglin_loved.contains(held_name(some(main.copy()))) {
                self.put_in_inventory(f, main, sounds.len())
            } else {
                thrown.push(main)
            }
        }
        return (thrown, false, some(stack))
    }

    // `PiglinAi.throwItems`' place to throw toward (CAL-200): the nearest player it sees, where
    // there's one, else a place on land up to 4 across and 2 up or down, `LandRandomPos.getPos`,
    // else where it stands, `getRandomNearbyPos`.
    fn throw_toward<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: Brain, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64) {
        if let id = brain.entity(MEMORY_NEAREST_VISIBLE_PLAYER) {
            if let n = self.near_of(id) {
                return (n.x, n.y, n.z)
            }
        }
        return self.random_place(true, 4, 2, lf, f, blocks, mut cache, min_y) ?? (self.living.body.x, self.living.body.y, self.living.body.z)
    }

    // `swing(OFF_HAND, SwingAnimation.DEFAULT)`, `LivingEntity.swing`: where its swing may start, a
    // whack of 6 ticks, shown to those who see it (CAL-200).
    fn swing_off_hand(mut self, heard: usize) {
        if self.swing_duration >= 0 and self.swing_ticks <= self.swing_duration / 2 and self.swing_ticks > 0 {
            return
        }
        self.swing_duration = 6
        self.swing_ticks = 0
        self.living.show(Shown.Swung((1, 1, 6)), heard)
    }

    /// `Piglin.mobInteract`'s own, `PiglinAi.mobInteract` of a player holding `item` (CAL-200):
    /// where it may admire it, `canAdmire`, admiring not disabled nor under way, grown, a gold
    /// ingot: one taken from them, held in its off hand, admired, and its walk stopped.
    pub fn piglin_interact(mut self, item: String, heard: usize) -> bool {
        if item != "minecraft:gold_ingot" or self.baby() or self.brain_has(MEMORY_ADMIRING_DISABLED) or self.brain_has(MEMORY_ADMIRING_ITEM) {
            return false
        }
        // What it held there dropped; a gold ingot has no sound to equip, nor keeps it.
        if let old = self.living.equipment[1].copy() {
            self.spill_here(old, heard)
        }
        self.living.equipment[1] = some(stack_of(String("minecraft:gold_ingot")))
        self.guarantee_drop(1)
        self.admire()
        if let held = self.brain.take() {
            var brain = held
            brain.erase(MEMORY_WALK_TARGET)
            self.brain = some(brain)
        }
        self.navigation.stop()
        return true
    }

    /// `PiglinAi.setAngerTarget` of `target` (CAL-200), `anger_in`, its draws from the level's
    /// `random`.
    pub fn piglin_anger_at<R: RandomSource>(mut self, target: Near, random: mut R) {
        var brain = self.brain.take() else return
        self.anger_in(mut brain, target, mut random)
        self.brain = some(brain)
    }

    // `PiglinAi.setAngerTarget` of `target` by its brain `brain` (CAL-200): where it may attack them
    // seen or not, its trouble reaching its walk target forgotten and angry at them for 600 ticks,
    // `ANGRY_AT`; where they're a hoglin and it may hunt, not hunting for a while,
    // `dontKillAnyMoreHoglinsForAWhile`, drawn from the level's `random`; and at every player too
    // where they're a player and the game rule `universal_anger`'s on, `UNIVERSAL_ANGER`.
    fn anger_in<R: RandomSource>(self, brain: mut Brain, target: Near, random: mut R) {
        if self.attackable_unseen(brain, target) {
            brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
            brain.set_for(MEMORY_ANGRY_AT, Memo.Uuid(target.uuid), 600)
            if target.species == HOGLIN and self.can_hunt() {
                dont_hunt_for_a_while(mut brain, mut random)
            }
            if target.species == PLAYER and self.universal_anger {
                brain.set_for(MEMORY_UNIVERSAL_ANGER, Memo.Flag(true), 600)
            }
        }
    }

    /// `PiglinAi.dontKillAnyMoreHoglinsForAWhile` (CAL-200), its brain's, drawn from the level's
    /// `random`, as a hunting piglin has those it sees do.
    pub fn dont_hunt<R: RandomSource>(mut self, random: mut R) {
        var brain = self.brain.take() else {
            _ = random.next_int_between(600, 2400)
            return
        }
        dont_hunt_for_a_while(mut brain, mut random)
        self.brain = some(brain)
    }

    /// `PiglinBrute.hurtServer`'s end, hurt by the living entity `attacker` (CAL-200),
    /// `PiglinBruteAi.wasHurtBy`: unless a piglin hurt it, `PiglinAi.maybeRetaliate`: where it
    /// may attack them seen or not, unless they're more than 4 blocks farther than its target, at
    /// `targeted` as its level found it, angry at them, `setAngerTarget`, or, where they're a
    /// player and the game rule `universal_anger`'s on, at the nearest visible player it may
    /// attack, else at them. The grown piglins near it its level's to tell, by ID, and whether all
    /// are to be angry at their own nearest players, `broadcastUniversalAnger`, else at
    /// `attacker` where they're nearer than what they're angry at, `broadcastAngerTarget`.
    pub fn brute_hurt_by<R: RandomSource>(mut self, attacker: Near, targeted: (f64, f64, f64)?, random: mut R) -> (List<i32>, bool) {
        if attacker.species == PIGLIN_BRUTE or attacker.species == PIGLIN {
            return (List<i32>(), false)
        }
        return self.retaliate(attacker, targeted, mut random)
    }

    // `PiglinAi.maybeRetaliate` against `attacker`, `targeted` as its level found it, as
    // `brute_hurt_by` has it (CAL-200).
    fn retaliate<R: RandomSource>(mut self, attacker: Near, targeted: (f64, f64, f64)?, random: mut R) -> (List<i32>, bool) {
        let brain = self.brain.take() else return (List<i32>(), false)
        let attackable = self.attackable_unseen(brain, attacker)
        let has_target = brain.entity(MEMORY_ATTACK_TARGET) != none
        let told = brain.entities(MEMORY_NEARBY_ADULT_PIGLINS)
        let nearest = brain.entity(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYER)
        self.brain = some(brain)
        if not attackable {
            return (List<i32>(), false)
        }
        if let p = targeted {
            if has_target {
                let (px, py, pz) = p
                if self.distance_sqr_to(attacker.x, attacker.y, attacker.z) > self.distance_sqr_to(px, py, pz) + 16.0 {
                    return (List<i32>(), false)
                }
            }
        }
        if attacker.species == PLAYER and self.universal_anger {
            var chosen = attacker
            if let id = nearest {
                if let n = self.near_of(id) {
                    chosen = n
                }
            }
            self.piglin_anger_at(chosen, mut random)
            return (told, true)
        }
        self.piglin_anger_at(attacker, mut random)
        return (told, false)
    }

    /// What a piglin told by another of a target reads of its brain (CAL-200), for its level to find:
    /// whom it's angry at, `ANGRY_AT`, by UUID, and the nearest visible player it may attack,
    /// `NEAREST_VISIBLE_ATTACKABLE_PLAYER`, by ID.
    pub fn piglin_told_reads(self) -> ((i64, i64)?, i32?) {
        let brain = self.brain else return (none, none)
        return (brain.uuid(MEMORY_ANGRY_AT), brain.entity(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYER))
    }

    /// What a piglin told by another of `target` does (CAL-200), `current` what it's angry at and
    /// `player` the nearest visible player it may attack, as its level found them,
    /// `piglin_told_reads`, as it's told between ticks: where all are to be angry at their own
    /// nearest players, `universal`, angry at `player`, where there's one,
    /// `broadcastUniversalAnger`; else angry at `target` where `current` isn't found or is no
    /// nearer, and isn't `target`, `setAngerTargetIfCloserThanCurrent`.
    pub fn piglin_told<R: RandomSource>(mut self, target: Near, universal: bool, current: Near?, player: Near?, random: mut R) {
        if universal {
            let n = player else return
            self.piglin_anger_at(n, mut random)
            return
        }
        // `broadcastAngerTarget` tells none of a hoglin that can't hunt or of one that can't be
        // hunted.
        if target.species == HOGLIN and (not self.can_hunt() or not target.huntable) {
            return
        }
        if let c = current {
            // `BehaviorUtils.getTargetNearestMe`: the one it's angry at where it's nearer.
            if self.distance_sqr_to(c.x, c.y, c.z) < self.distance_sqr_to(target.x, target.y, target.z) {
                return
            }
            if c.id == target.id {
                return
            }
        }
        self.piglin_anger_at(target, mut random)
    }

    // `SetWalkTargetAwayFrom`'s trigger (CAL-200): where it has no walk target, or may interrupt
    // it, and `avoid` is nearer than `dist`: unless it walks at the speed already away from it, its
    // way and the way to `avoid` apart, of 10 tries the first place found up to 16 away from it,
    // `LandRandomPos.getPosAway`, walked to.
    fn walk_away<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, avoid: (f64, f64, f64), speed: f32, dist: i32, interrupt: bool, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let target = brain.walk(MEMORY_WALK_TARGET)
        if target != none and not interrupt {
            return false
        }
        let (ax, ay, az) = avoid
        if not (self.distance_sqr_to(ax, ay, az) < f64(dist * dist)) {
            return false
        }
        if let t = target {
            if t.speed == speed {
                if let cur = self.tracked_place(t.target) {
                    let (cx, cy, cz) = cur
                    let (bx, by, bz) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    if (cx - bx) * (ax - bx) + (cy - by) * (ay - by) + (cz - bz) * (az - bz) < 0.0 {
                        return false
                    }
                }
            }
        }
        for _ in 0..10 {
            if let p = self.pos_away(lf, f, blocks, mut cache, min_y, 0.0, 16.0, avoid) {
                let (x, y, z) = p
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, speed, 0)))
                break
            }
        }
        return true
    }

    /// `Hoglin.hurtServer`'s end, hurt by the living entity `attacker` (CAL-200),
    /// `HoglinAi.wasHurtBy`: no longer pacified nor breeding; then a baby retreats from the nearest
    /// of `attacker`, what it avoids and its target, `retreatFromNearestTarget`, their places
    /// `avoided` and `targeted` as its level found them; a grown one, unless it's avoiding a piglin
    /// that hurt it, or a hoglin hurt it, or `attacker`'s more than 4 blocks farther than its
    /// target, where it may attack them, `isEntityAttackable`, takes them up as its target,
    /// `maybeRetaliate`. The hoglins its level's to tell of `attacker`, `broadcastAttackTarget`,
    /// by ID. Its retreat's ticks are drawn from the level's `random`. A zoglin's, `Zoglin.hurtServer`'s
    /// end, takes `attacker` up as its target, `setAttackTarget`, where it may attack them,
    /// `canAttack`, unless they're more than 4 blocks farther than its target, and tells none.
    pub fn hoglin_hurt_by<B: CollisionBlocks, R: RandomSource>(mut self, f: Facts, m: MovementStates, blocks: B, attacker: Near, avoided: (f64, f64, f64)?, targeted: (f64, f64, f64)?, random: mut R) -> List<i32> {
        var brain = self.brain.take() else return List<i32>()
        if self.species == ZOGLIN {
            var much_farther = false
            if let p = targeted {
                if brain.entity(MEMORY_ATTACK_TARGET) != none {
                    let (px, py, pz) = p
                    much_farther = self.distance_sqr_to(attacker.x, attacker.y, attacker.z) > self.distance_sqr_to(px, py, pz) + 16.0
                }
            }
            if can_attack_near(attacker) and not much_farther {
                brain.erase(MEMORY_CANT_REACH_WALK_TARGET_SINCE)
                brain.set_for(MEMORY_ATTACK_TARGET, Memo.Entity(attacker.id), 200)
            }
            self.brain = some(brain)
            return List<i32>()
        }
        brain.erase(MEMORY_PACIFIED)
        brain.erase(MEMORY_BREED_TARGET)
        var told = List<i32>()
        if self.baby() {
            self.hoglin_retreat_in(mut brain, attacker.id, (attacker.x, attacker.y, attacker.z), avoided, targeted, mut random)
            self.brain = some(brain)
            return told
        }
        // `maybeRetaliate`: not where it's avoiding what hurt it and that's a piglin.
        if attacker.species != HOGLIN and not (brain.is_active(ACTIVITY_AVOID) and attacker.species == PIGLIN) {
            var much_farther = false
            if let p = targeted {
                if brain.entity(MEMORY_ATTACK_TARGET) != none {
                    let (px, py, pz) = p
                    much_farther = self.distance_sqr_to(attacker.x, attacker.y, attacker.z) > self.distance_sqr_to(px, py, pz) + 16.0
                }
            }
            if not much_farther {
                // `Sensor.isEntityAttackable`: its invisibility not tested where it's its target.
                var a = attacker
                if brain.entity(MEMORY_ATTACK_TARGET) == some(attacker.id) {
                    a.visibility = 1.0
                }
                if can_attack_near(a) and self.targetable(f, m, blocks, a) {
                    hoglin_target_to(mut brain, attacker.id)
                    told = brain.entities(MEMORY_NEAREST_VISIBLE_ADULT_HOGLINS)
                }
            }
        }
        self.brain = some(brain)
        return told
    }

    /// `HoglinAi.onHitTarget`'s own part, the grown hoglin hitting the piglin `target` (CAL-200):
    /// where piglins outnumber its hoglins, `piglinsOutnumberHoglins`, it avoids it,
    /// `setAvoidTarget`, its ticks drawn from `random`, and it's true, its level to have the hoglins
    /// it sees retreat, `broadcastRetreat`; else false, its level to tell them of the target,
    /// `broadcastAttackTarget`.
    pub fn hoglin_hit_piglin<R: RandomSource>(mut self, target: i32, random: mut R) -> bool {
        var brain = self.brain.take() else return false
        let outnumbered = self.piglins_outnumber(brain)
        if outnumbered {
            hoglin_avoid(mut brain, target, mut random)
        }
        self.brain = some(brain)
        return outnumbered
    }

    /// `HoglinAi.retreatFromNearestTarget` of a hoglin told by another to retreat from `from`, at
    /// `at` (CAL-200), as `hoglin_retreat_in` has it.
    pub fn hoglin_retreat<R: RandomSource>(mut self, from: i32, at: (f64, f64, f64), avoided: (f64, f64, f64)?, targeted: (f64, f64, f64)?, random: mut R) {
        var brain = self.brain.take() else return
        self.hoglin_retreat_in(mut brain, from, at, avoided, targeted, mut random)
        self.brain = some(brain)
    }

    // `HoglinAi.retreatFromNearestTarget` (CAL-200): the nearest of `from`, at `at`, what it
    // avoids and its target, `getNearestTarget`, what it avoids first, their places `avoided` and
    // `targeted` as its level found them, avoided, `setAvoidTarget`.
    fn hoglin_retreat_in<R: RandomSource>(self, brain: mut Brain, from: i32, at: (f64, f64, f64), avoided: (f64, f64, f64)?, targeted: (f64, f64, f64)?, random: mut R) {
        var nearest = from
        var near_place = at
        for (held, place) in [(brain.entity(MEMORY_AVOID_TARGET), avoided), (brain.entity(MEMORY_ATTACK_TARGET), targeted)] {
            let id = held else continue
            let p = place else continue
            let (px, py, pz) = p
            let (nx, ny, nz) = near_place
            if self.distance_sqr_to(px, py, pz) < self.distance_sqr_to(nx, ny, nz) {
                nearest = id
                near_place = p
            }
        }
        hoglin_avoid(mut brain, nearest, mut random)
    }

    /// What its brain avoids, `AVOID_TARGET`, by ID (CAL-200).
    pub fn brain_avoided(self) -> i32? {
        let brain = self.brain else return none
        return brain.entity(MEMORY_AVOID_TARGET)
    }

    /// The grown hoglins its brain sees, `NEAREST_VISIBLE_ADULT_HOGLINS`, by ID (CAL-200).
    pub fn adult_hoglins_seen(self) -> List<i32> {
        let brain = self.brain else return List<i32>()
        return brain.entities(MEMORY_NEAREST_VISIBLE_ADULT_HOGLINS)
    }

    /// Its brain's attack target, by ID, `getTargetFromBrain` (CAL-200).
    pub fn brain_target(self) -> i32? {
        let brain = self.brain else return none
        return brain.entity(MEMORY_ATTACK_TARGET)
    }

    /// Whether its brain's activity `a` is on beside its core, `isActive` (CAL-200).
    pub fn brain_active(self, a: i32) -> bool {
        let brain = self.brain else return false
        return brain.active_non_core() == some(a)
    }

    /// The living entity near it of the UUID `u`, as `level.getEntity` finds it, if it's near.
    pub fn near_with_uuid(self, u: (i64, i64)) -> Near? {
        for n in self.near {
            if n.uuid == u {
                return some(n)
            }
        }
        return none
    }

    // `Sensor.isEntityAttackableIgnoringLineOfSight` of `n` by its brain `brain` (CAL-200): not
    // itself, alive and not spectating, one it may attack, `canAttack`, and within the range
    // sensors last set theirs to times how visible it is, 2 at least, its invisibility not tested
    // where it's its target; seen or not.
    fn attackable_unseen(self, brain: Brain, n: Near) -> bool {
        if n.id == self.living.body.id or not n.alive or n.spectator {
            return false
        }
        var a = n
        if brain.entity(MEMORY_ATTACK_TARGET) == some(n.id) {
            a.visibility = 1.0
        }
        if not can_attack_near(a) {
            return false
        }
        let within = (self.sensor_range * a.visibility).max(2.0)
        return self.distance_sqr_to(a.x, a.y, a.z) <= within * within
    }

    // `PiglinBruteAi.findNearestValidAttackTarget` by its brain `brain` (CAL-200): what it's angry
    // at, `ANGRY_AT`, where it's near and it may attack it seen or not; else the nearest visible
    // player it may attack, `NEAREST_VISIBLE_ATTACKABLE_PLAYER`; else its nemesis,
    // `NEAREST_VISIBLE_NEMESIS`.
    fn brute_finds(self, brain: Brain) -> i32? {
        if let u = brain.uuid(MEMORY_ANGRY_AT) {
            if let n = self.near_with_uuid(u) {
                if self.attackable_unseen(brain, n) {
                    return some(n.id)
                }
            }
        }
        if let id = brain.entity(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYER) {
            return some(id)
        }
        return brain.entity(MEMORY_NEAREST_VISIBLE_NEMESIS)
    }

    // `PiglinAi.findNearestValidAttackTarget` by its brain `brain` (CAL-200): none near a zombified;
    // what it's angry at, `ANGRY_AT`, where it's near and it may attack it seen or not; under
    // universal anger the nearest visible player it may attack; its nemesis; else the nearest
    // player not wearing gold where it may attack them, `isEntityAttackable`, its invisibility not
    // tested where they're its target.
    fn piglin_finds<B: CollisionBlocks>(mut self, brain: Brain, f: Facts, m: MovementStates, blocks: B) -> i32? {
        if self.near_zombified(brain) {
            return none
        }
        if let u = brain.uuid(MEMORY_ANGRY_AT) {
            if let n = self.near_with_uuid(u) {
                if self.attackable_unseen(brain, n) {
                    return some(n.id)
                }
            }
        }
        if brain.has(MEMORY_UNIVERSAL_ANGER) {
            if let id = brain.entity(MEMORY_NEAREST_VISIBLE_TARGETABLE_PLAYER) {
                return some(id)
            }
        }
        if let id = brain.entity(MEMORY_NEAREST_VISIBLE_NEMESIS) {
            return some(id)
        }
        let id = brain.entity(MEMORY_NEAREST_TARGETABLE_PLAYER_NOT_WEARING_GOLD) else return none
        let n = self.near_of(id) else return none
        var a = n
        if brain.entity(MEMORY_ATTACK_TARGET) == some(id) {
            a.visibility = 1.0
        }
        return if can_attack_near(a) and self.targetable(f, m, blocks, a) { some(id) } else { none }
    }

    // `PiglinAi.isNearZombified`: the nearest zombified it sees within 6 (CAL-200).
    fn near_zombified(self, brain: Brain) -> bool {
        let id = brain.entity(MEMORY_NEAREST_VISIBLE_ZOMBIFIED) else return false
        let n = self.near_of(id) else return false
        return self.distance_sqr_to(n.x, n.y, n.z) < 36.0
    }

    // `PiglinAi.wantsToStopFleeing` (CAL-200): nothing to avoid; a hoglin where piglins are no
    // fewer than hoglins; a zombified no longer the nearest it sees.
    fn piglin_calm(self, brain: Brain) -> bool {
        let id = brain.entity(MEMORY_AVOID_TARGET) else return true
        let n = self.near_of(id) else return false
        if n.species == HOGLIN {
            return not hoglins_outnumber(brain)
        }
        if n.species == ZOMBIFIED_PIGLIN or n.species == ZOGLIN {
            return brain.entity(MEMORY_NEAREST_VISIBLE_ZOMBIFIED) != some(id)
        }
        return false
    }

    // Whether it holds a spear in either hand, `#spears`, which a piglin uses from afar, its
    // `KINETIC_WEAPON` (CAL-200).
    fn holds_spear(self, lf: LivingFacts) -> bool {
        return lf.spears.contains(held_name(self.living.equipment[0].copy())) or lf.spears.contains(held_name(self.living.equipment[1].copy()))
    }

    /// `HoglinAi.setAttackTargetIfCloserThanCurrent`'s end, the nearer `target` chosen by its level
    /// (CAL-200): where it isn't pacified, `setAttackTarget`.
    pub fn hoglin_alerted(mut self, target: i32) {
        var brain = self.brain.take() else return
        if not brain.has(MEMORY_PACIFIED) {
            hoglin_target_to(mut brain, target)
        }
        self.brain = some(brain)
    }

    // `HoglinAi.piglinsOutnumberHoglins`: grown, more piglins seen than its hoglins and itself
    // (CAL-200).
    fn piglins_outnumber(self, brain: Brain) -> bool {
        if self.baby() {
            return false
        }
        let piglins = brain.int(MEMORY_VISIBLE_ADULT_PIGLIN_COUNT) ?? 0
        let hoglins = (brain.int(MEMORY_VISIBLE_ADULT_HOGLIN_COUNT) ?? 0) + 1
        return piglins > hoglins
    }

    // Whether it's immune to zombification, `DATA_IMMUNE_TO_ZOMBIFICATION`: a hoglin's after an
    // ageable mob's values, a piglin's after a mob's (CAL-200).
    fn zombification_immune(self) -> bool {
        return self.living.data.flag(if self.species == HOGLIN { OWN } else { MONSTER_OWN })
    }

    // `Hoglin.isConverting`: not immune to zombification, `DATA_IMMUNE_TO_ZOMBIFICATION`, with AI,
    // where piglins zombify, `PIGLINS_ZOMBIFY` at its block (CAL-200).
    fn hoglin_converting<B: MobLight>(self, blocks: B) -> bool {
        if self.zombification_immune() or self.no_ai() {
            return false
        }
        let (x, y, z) = self.block_position()
        return blocks.zombifies(x, y, z)
    }

    // The first block of `set` within 8 across and 4 up or down of it by Manhattan distance, in the
    // order `withinBoxByManhattanDistance` goes, `findBlocksInBoxByManhattanDistance`; where
    // `soul_lit`, a soul campfire only lit, `PiglinSpecificSensor.isValidRepellent` (CAL-200).
    fn nearest_repellent<B: CollisionBlocks>(self, f: Facts, blocks: B, set: BlockSet, soul_lit: bool) -> BlockPos? {
        let (bx, by, bz) = self.block_position()
        let offsets = manhattan_box(8, 4, 8, 20)
        let soul = if soul_lit { f.block_named(String("minecraft:soul_campfire")) } else { none }
        var i = 0usize
        while i < offsets.len() {
            let (x, y, z) = (bx + offsets[i], by + offsets[i + 1], bz + offsets[i + 2])
            let state = state_at(blocks, x, y, z)
            if f.in_set(state, set) {
                var unlit = false
                if let b = soul {
                    unlit = f.block(state) == b and not f.get_bool(state, String("lit"))
                }
                if not unlit {
                    return some(BlockPos { x: x, y: y, z: z })
                }
            }
            i += 3
        }
        return none
    }

    // `HoglinAi.getSoundForCurrentActivity` (CAL-200): its activity's, where it has one other than
    // its core: a retreat's avoiding or zombifying, an angry one fighting, else a retreat's where a
    // repellent's near and its ambient sound where none is.
    fn hoglin_sound<B: MobLight>(self, blocks: B) -> String? {
        let brain = self.brain else return none
        let activity = brain.active_non_core() else return none
        if activity == ACTIVITY_AVOID or self.hoglin_converting(blocks) {
            return some(String("entity.hoglin.retreat"))
        }
        if activity == ACTIVITY_FIGHT {
            return some(String("entity.hoglin.angry"))
        }
        return some(String(if brain.has(MEMORY_NEAREST_REPELLENT) { "entity.hoglin.retreat" } else { "entity.hoglin.ambient" }))
    }

    // `HarvestFarmland.tick` (CAL-160): where it has a block to work, once that's within 1 of it,
    // past its next start: a ripe crop there broken with its drops, `destroyBlock`, which stops
    // its brain's tick for its level to break it then; air on farmland there planted, `plant_at`,
    // where it has seeds, `hasFarmSeeds`; and a crop there still growing given up for another
    // drawn of those left, walked to and looked at, 20 ticks on. What's there is read as it was
    // as the tick began, so a crop it breaks isn't planted till its next. Its ticks worked
    // counted where it has no block to work or it's near enough.
    fn harvest_tick<B: CollisionBlocks>(mut self, brain: mut Brain, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, blocks: B, sounds: mut List<EntitySound>) {
        if let t = keep.last_target {
            let (tx, ty, tz) = t
            if not self.near_middle(BlockPos { x: tx, y: ty, z: tz }, 1.0) {
                return
            }
            if now > keep.next_start {
                let state = state_at(blocks, tx, ty, tz)
                let block = f.block(state)
                let crop = f.is_a(block, String("CropBlock"))
                let ripe = crop and (f.get_int(state, String("age")) ?? 0) >= f.crop_max_age(block)
                if ripe {
                    self.living.show(Shown.Harvested((tx, ty, tz)), sounds.len())
                    self.stop_due = true
                }
                if f.is_air(state) and f.is_a(f.block(state_at(blocks, tx, ty - 1, tz)), String("FarmlandBlock")) and self.has_farm_seeds(lf, f) {
                    self.plant_at(lf, f, tx, ty, tz, mut sounds)
                }
                if crop and not ripe {
                    var k = 0usize
                    while k < keep.farmland.len() {
                        let (fx, fy, fz) = keep.farmland[k]
                        if fx == tx and fy == ty and fz == tz {
                            _ = keep.farmland.remove(k)
                            break
                        }
                        k += 1
                    }
                    keep.last_target = pick_farmland(keep.farmland, mut random)
                    if let n = keep.last_target {
                        let (x, y, z) = n
                        keep.next_start = now + 20
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: 0.5f32, close_enough: 1 }))
                        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
                    }
                }
            }
        }
        keep.ticks += 1
    }

    // `Villager.hasFarmSeeds`: whether its inventory holds a seed in `#villager_plantable_seeds`.
    fn has_farm_seeds(mut self, lf: LivingFacts, f: Facts) -> bool {
        self.ready_inventory(f)
        for s in self.inventory {
            let t = s else continue
            let item = held_name(some(t.copy()))
            for (name, _) in lf.plantable {
                if name == item {
                    return true
                }
            }
        }
        return false
    }

    // A farmer's seed planted at x, y, z, as `HarvestFarmland.tick` plants it (CAL-160): of its
    // inventory's slots in order, the first holding a seed in `#villager_plantable_seeds` that
    // places a block, its block's state set and updated there, which its level does; the crop's
    // planting sound played from the block's corner, as vanilla plays it; and one seed fewer.
    fn plant_at(mut self, lf: LivingFacts, f: Facts, x: i32, y: i32, z: i32, sounds: mut List<EntitySound>) {
        self.ready_inventory(f)
        for i in 0..self.inventory.len() {
            let t = self.inventory[i].copy() else continue
            let item = held_name(some(t))
            for (name, placed) in lf.plantable {
                if name != item {
                    continue
                }
                let state = placed else continue
                self.living.show(Shown.Planted((x, y, z, state)), sounds.len())
                sounds.push(EntitySound { sound: String("item.crop.plant"), x: f64(x), y: f64(y), z: f64(z), volume: 1.0f32, pitch: 1.0f32, source: BLOCKS_SOURCE })
                self.shrink_slot(i)
                return
            }
        }
    }

    // A villager's inventory slot `i` one fewer, `shrink(1)`, empty where that was its last.
    fn shrink_slot(mut self, i: usize) {
        let t = self.inventory[i].copy() else return
        let n = count_of(some(t.copy()))
        if n <= 1 {
            self.inventory[i] = none
            return
        }
        self.inventory[i] = some(stack_of_count(t, n - 1))
    }

    // `UseBonemeal.pickNextTarget` (CAL-160): of the crops around it, 1 each way from its block, x,
    // then y, then z, short of their last age, `validPos`, one drawn from the level's random as
    // each's found, kept where `nextInt` of how many so far is 0; `grown` a crop just grown, read
    // as it's grown.
    fn pick_crop<B: CollisionBlocks>(self, f: Facts, blocks: B, grown: (i32, i32, i32, u32)?, random: mut TapedRandom) -> (i32, i32, i32)? {
        let (bx, by, bz) = self.block_position()
        var found: (i32, i32, i32)? = none
        var count = 0
        for dx in -1..2 {
            for dy in -1..2 {
                for dz in -1..2 {
                    let (x, y, z) = (bx + dx, by + dy, bz + dz)
                    var state = state_at(blocks, x, y, z)
                    if let g = grown {
                        let (gx, gy, gz, s) = g
                        if gx == x and gy == y and gz == z {
                            state = s
                        }
                    }
                    let block = f.block(state)
                    if f.is_a(block, String("CropBlock")) and (f.get_int(state, String("age")) ?? 0) < f.crop_max_age(block) {
                        count += 1
                        if random.next_int_below(count) == 0 {
                            found = some((x, y, z))
                        }
                    }
                }
            }
        }
        return found
    }

    // `UseBonemeal.tick` (CAL-160): from its next go, once its crop's within 1 of it, the first
    // bone meal in its inventory put on it, `BoneMealItem.growCrop`, where it's a crop short of
    // its last age: 2 to 5 ages older, drawn from the level's random, a beetroot a third of that
    // and a torchflower crop 1, `getBonemealAgeIncrease`, set with flags 2, which its level does,
    // and one bone meal fewer; its particles shown, level event 1505 with 15; then its next crop
    // picked, the one grown read as it is now, looked at and walked to, its next go 40 ticks on.
    // Only crops are picked, so what's no crop there now takes none. Its ticks worked counted.
    fn bonemeal_tick<B: CollisionBlocks>(mut self, brain: mut Brain, keep: mut Keep, now: i64, random: mut TapedRandom, f: Facts, blocks: B, sounds: List<EntitySound>) {
        let t = keep.last_target else return
        let (x, y, z) = t
        if now < keep.next_start or not self.near_middle(BlockPos { x: x, y: y, z: z }, 1.0) {
            return
        }
        self.ready_inventory(f)
        var slot: usize? = none
        for i in 0..self.inventory.len() {
            if let s = self.inventory[i] {
                if held_name(some(s.copy())) == "minecraft:bone_meal" {
                    slot = some(i)
                    break
                }
            }
        }
        if let i = slot {
            let state = state_at(blocks, x, y, z)
            let block = f.block(state)
            let age = f.get_int(state, String("age")) ?? 0
            let last = f.crop_max_age(block)
            if f.is_a(block, String("CropBlock")) and age < last {
                var more = 1
                if not f.is_a(block, String("TorchflowerCropBlock")) {
                    more = random.next_int_below(4) + 2
                    if f.is_a(block, String("BeetrootBlock")) {
                        more = more / 3
                    }
                }
                let grown_age = min_i32(last, age + more)
                var grown = state
                if grown_age == last and f.is_a(block, String("TorchflowerCropBlock")) {
                    if let flower = f.block_named(String("minecraft:torchflower")) {
                        grown = f.default_state(flower)
                    }
                } else {
                    match f.with_int(f.default_state(block), String("age"), grown_age) {
                        ok(s) => grown = s,
                        err(_) => {},
                    }
                }
                self.living.show(Shown.Grew((x, y, z, grown)), sounds.len())
                self.shrink_slot(i)
                self.living.show(Shown.Level((1505, x, y, z, 15)), sounds.len())
                keep.last_target = self.pick_crop(f, blocks, some((x, y, z, grown)), mut random)
                target_crop(mut brain, keep.last_target)
                keep.next_start = now + 40
            }
        }
        keep.ticks += 1
    }

    // `Villager.customServerAiStep` (CAL-160): its brain's tick; the reputation the player it last
    // traded with gets for it; then its own random's 1 in 100, for a raid there, which there never
    // is yet; and its trading stopped where it has no offers, `stopTrading`.
    // Whether its brain's tick stopped for its level to swing a door, to go on from there.
    fn villager_step<B: CollisionBlocks + MobLight + NavLevel, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.tick_brain(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
            return true
        }
        if let who = self.last_traded.take() {
            // The trade it heard of, `onReputationEvent(TRADE)`: 2 trading gossip of the player,
            // its offers priced again where they're trading with it, and its happiness shown,
            // entity event 14.
            self.gossips.add(who, TRADING, 2)
            if let t = self.trading {
                if t.uuid == who {
                    self.update_special_prices(who)
                    self.living.show(Shown.Repriced, sounds.len())
                }
            }
            self.living.show(Shown.Event(14i8), sounds.len())
        }
        // One in 100, where there's a raid there, `getRaidAt`, active and not over, its sweat,
        // entity event 42 (CAL-167).
        if self.living.body.random.next_int_below(100) == 0 {
            if let r = raid_at(self.raids_near, self.block_position()) {
                if not r.over {
                    self.living.show(Shown.Event(42i8), sounds.len())
                }
            }
        }
        if self.trading != none and not self.has_offers() {
            self.stop_trading()
        }
        return false
    }

    // `bedIsOccupiedByVillager`: whether a villager near it, by its brain's sight, sleeps with its
    // box in the block at `pos` (CAL-160).
    fn villager_sleeps_in(self, pos: BlockPos) -> bool {
        for n in self.near {
            if n.species == VILLAGER and n.sleeping and n.bounds.intersects(f64(pos.x), f64(pos.y), f64(pos.z), f64(pos.x) + 1.0, f64(pos.y) + 1.0, f64(pos.z) + 1.0) {
                return true
            }
        }
        return false
    }

    /// Its brain's interaction target, by ID, `INTERACTION_TARGET`, none without a brain (CAL-160).
    pub fn interaction_target(self) -> i32? {
        return match self.brain {
            some(b) => b.entity(MEMORY_INTERACTION_TARGET),
            none => none,
        }
    }

    /// Whether it's asleep, `isSleeping` (CAL-160).
    pub fn sleeping(self) -> bool {
        return self.living.sleeping != none or self.fox_flag(FOX_SLEEPING)
    }

    /// Wakes a villager asleep, as `kickVillagerOutOfBed` has it `stopSleeping` (D574): it gets
    /// up now, what that does to its bed kept in what it shows. Whether it was a villager asleep.
    pub fn kicked_out<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B) -> bool {
        if self.species != VILLAGER or not self.sleeping() {
            return false
        }
        self.wake_now(f, m, blocks, List<EntitySound>())
        return true
    }

    // `LivingEntity.startSleeping` in the bed at x, y, z (CAL-160): where that's a bed with a
    // shape, put on it, `setPosToBed`; the bed occupied, which its level sets and updates; its
    // pose sleeping, its size a sleeper's, `refreshDimensions`; where it sleeps held and sent;
    // its motion none, sent, `needsSync`; and no ambient sound. Whether it lay down.
    fn start_sleeping<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, x: i32, y: i32, z: i32, sounds: List<EntitySound>) -> bool {
        let state = state_at(blocks, x, y, z)
        if not f.is_a(f.block(state), "AbstractBedBlock") {
            return false
        }
        let height = bed_sleep_height(f, m, blocks, x, y, z) else return false
        self.put_on_bed(x, y, z, height)
        self.living.show(Shown.Bed((x, y, z, true)), sounds.len())
        self.living.data.set(POSE_ID, Value.Number(SLEEPING))
        self.living.set_sleeping(some((x, y, z)))
        self.refresh_size()
        self.living.body.vx = 0.0
        self.living.body.vy = 0.0
        self.living.body.vz = 0.0
        self.living.body.needs_sync = true
        self.refresh_sounds()
        return true
    }

    // `setPosToBed`: on the bed at x, y, z, in its middle across, an eighth over its top, `height`
    // up.
    fn put_on_bed(mut self, x: i32, y: i32, z: i32, height: f64) {
        self.living.body.x = f64(x) + 0.5
        self.living.body.y = f64(y) + height + 0.125
        self.living.body.z = f64(z) + 0.5
    }

    // Where a stop of its sleep has it get up, `wake_due`, it gets up (CAL-160).
    fn wake_if_due<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B, now: i64, sounds: List<EntitySound>) {
        if not self.wake_due {
            return
        }
        self.wake_due = false
        self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
    }

    // It gets up now, out of its brain's tick, its brain's memory of it kept (CAL-160).
    fn wake_now<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, sounds: List<EntitySound>) {
        let now = self.game_time
        match self.brain.take() {
            some(b) => {
                var brain = b
                self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
                self.brain = some(brain)
            },
            none => {
                var brain = Brain.empty()
                self.stop_sleeping(mut brain, f, m, blocks, now, sounds)
            },
        }
    }

    // `LivingEntity.stopSleeping` (CAL-160): where it sleeps in a bed still, in a chunk that's
    // there, the bed no longer occupied, which its level sets and updates, and it put where it
    // gets up to, `findStandUpPosition`, for its type's size, else on the block over the bed, a
    // tenth up, turned to the bed's floor's middle, `atan2` of the way there, its pitch level;
    // then standing, its size its own again, where it sleeps forgotten, and its ambient sound
    // again; a villager's time woken remembered, `Villager.stopSleeping`.
    fn stop_sleeping<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B, now: i64, sounds: List<EntitySound>) {
        if let at = self.living.sleeping {
            let (bx, by, bz) = at
            if let state = blocks.collision_state(bx, by, bz) {
                if f.is_a(f.block(state), "AbstractBedBlock") {
                    let facing = match facing_of(f, state) {
                        ok(d) => d,
                        err(_) => 2,
                    }
                    self.living.show(Shown.Bed((bx, by, bz, false)), sounds.len())
                    let border = self.border ?? widest_border()
                    let up = stand_up_position(f, m, blocks, border, bx, by, bz, facing, self.living.body.y_rot, self.width, self.height)
                    let (sx, sy, sz) = up ?? (f64(bx) + 0.5, f64(by + 1) + 0.1, f64(bz) + 0.5)
                    let yaw = bed_yaw(bx, by, bz, sx, sy, sz)
                    self.living.body.x = sx
                    self.living.body.y = sy
                    self.living.body.z = sz
                    self.living.body.y_rot = yaw
                    self.living.body.x_rot = 0.0f32
                }
            }
        }
        self.living.data.set(POSE_ID, Value.Number(STANDING))
        self.living.set_sleeping(none)
        self.refresh_size()
        self.refresh_sounds()
        if self.species == VILLAGER {
            brain.set(MEMORY_LAST_WOKEN, Memo.Long(now))
        }
    }

    // `ValidateNearbyPoi` of the place `memory` holds, of the types `kinds` holds as bits
    // (CAL-160): where it's in its dimension and within 16 of the place's middle, the memory
    // forgotten where there's no point of interest of them there any more, or where it's a bed
    // someone's in and it isn't asleep, which it's then given back where no villager near sleeps
    // in it, `bedIsOccupiedByVillager`.
    fn validate_poi<B: CollisionBlocks>(mut self, brain: mut Brain, memory: i32, kinds: u32, f: Facts, blocks: B) -> bool {
        let g = brain.place(memory) else return false
        if g.dimension != self.dimension {
            return false
        }
        if self.distance_sqr_to(f64(g.pos.x) + 0.5, f64(g.pos.y) + 0.5, f64(g.pos.z) + 0.5) >= 256.0 {
            return false
        }
        var pois = self.pois.take() ?? Pois.new(0, 0)
        if not pois.exists(g.pos, types_of(kinds)) {
            brain.erase(memory)
        } else if bed_in_use(f, blocks, g.pos) == some(true) and self.living.sleeping == none {
            brain.erase(memory)
            if not self.villager_sleeps_in(g.pos) {
                _ = pois.release(g.pos)
            }
        }
        self.pois = some(pois)
        return true
    }

    // `AcquirePoi` (CAL-160): where the memory it takes into is empty, and it's grown or needn't
    // be: its first look put off up to 19 ticks, drawn from the level's random; then every 20 to
    // 39, drawn, the points of its types with a ticket free within 48, nearest first, but those it
    // couldn't reach lately, each tried again at its time, put off longer, drawn; the first 5,
    // a bed among them only where no one's in it; a path to the nearest it can reach of them,
    // `findPathToPois`, whose point it takes a ticket of, remembers and shows where it says so,
    // trying all again after; else each of them it hadn't tried put off, drawn, nearest first:
    // vanilla puts them off in the order of a `HashSet` of each's type and place, which for points
    // of more than one type goes by the types' identity hashes, so differs from run to run.
    fn acquire_poi<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, a: Acquire, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: List<EntitySound>) -> bool {
        if not brain.check(a.memory, STATUS_ABSENT) {
            return false
        }
        if a.adult_only and self.baby() {
            return false
        }
        if keep.next_start == 0 {
            keep.next_start = now + i64(random.next_int_below(20))
            return false
        }
        if now < keep.next_start {
            return false
        }
        keep.next_start = now + 20 + i64(random.next_int_below(20))
        var stale = List<i64>()
        for (k, r) in keep.retries {
            if now - r.previous >= 400 {
                stale.push(k)
            }
        }
        for k in stale {
            _ = keep.retries.remove(k)
        }
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let wanted = types_of(a.kinds)
        var found = List<(f64, PoiRecord)>()
        for r in pois.in_range(wanted.copy(), center, 48, Occupancy.HasSpace) {
            let key = r.pos.pack()
            if keep.retries.contains(key) {
                var retry = keep.retries[key]
                if now < retry.next {
                    continue
                }
                mark_attempt(mut retry, now, mut random)
                keep.retries.insert(key, retry)
            }
            let dx = f64(r.pos.x - bx)
            let dy = f64(r.pos.y - by)
            let dz = f64(r.pos.z - bz)
            found.push((dx * dx + dy * dy + dz * dz, r))
        }
        // Nearest first, as `sorted` keeps those as near in their order.
        for i in 1..found.len() {
            var j = i
            while j > 0 {
                let (p, _) = found[j - 1]
                let (q, _) = found[j]
                if p <= q {
                    break
                }
                found.swap(j - 1, j)
                j -= 1
            }
        }
        var picked = List<BlockPos>()
        var targets = List<(i32, i32, i32)>()
        var reach_range = 1
        var n = 0
        for (_, r) in found {
            if n == 5 {
                break
            }
            n += 1
            if a.bed and bed_in_use(f, blocks, r.pos) != some(false) {
                continue
            }
            picked.push(r.pos)
            targets.push((r.pos.x, r.pos.y, r.pos.z))
            let reach = valid_range(i32.wrap(r.kind))
            if reach > reach_range {
                reach_range = reach
            }
        }
        var reached = false
        if not targets.is_empty() {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path_to_any(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, targets, reach_range) {
                if p.reached {
                    reached = true
                    let (tx, ty, tz) = p.target
                    let target = BlockPos { x: tx, y: ty, z: tz }
                    if pois.type_at(target) != none {
                        _ = pois.take(wanted, some(target), target, 1)
                        brain.set(a.memory, Memo.Place(GlobalPos { dimension: self.dimension.copy(), pos: target }))
                        if a.event >= 0 {
                            self.living.show(Shown.Event(i8.wrap(a.event)), sounds.len())
                        }
                        keep.retries.clear()
                    }
                }
            }
        }
        if not reached {
            for pos in picked {
                let key = pos.pack()
                if not keep.retries.contains(key) {
                    var retry = Retry()
                    mark_attempt(mut retry, now, mut random)
                    keep.retries.insert(key, retry)
                }
            }
        }
        self.pois = some(pois)
        return true
    }

    // `SetHiddenState` (CAL-160), staying `stay` seconds hidden within `near` of its hiding place:
    // till it's been hidden so many ticks, or 300 ticks since it heard the bell, each tick it's
    // within `near` of the place, its block's, `closerThan`, counted; then the bell and the place
    // forgotten, its activity its schedule's, `updateActivityFromSchedule`, and the count begun
    // again.
    fn hide_state(self, brain: mut Brain, keep: mut Keep, h: (i32, i32), now: i64) -> bool {
        let (stay, near) = h
        let heard = brain.long(MEMORY_HEARD_BELL_TIME) ?? 0
        let g = brain.place(MEMORY_HIDING_PLACE) else return false
        if keep.ticks <= stay * 20 and heard + 300 > now {
            let (bx, by, bz) = self.block_position()
            let (dx, dy, dz) = (i64(g.pos.x - bx), i64(g.pos.y - by), i64(g.pos.z - bz))
            if dx * dx + dy * dy + dz * dz < i64(near * near) {
                keep.ticks += 1
            }
            return true
        }
        brain.erase(MEMORY_HEARD_BELL_TIME)
        brain.erase(MEMORY_HIDING_PLACE)
        let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
        brain.update_from_schedule(now, scheduled)
        keep.ticks = 0
        return true
    }

    // `LocateHidingPlace` (CAL-160), looking `far` for a bed, walking at `speed` to within `near`:
    // the first bed within `near` and 1 of its block, taken or not, where it's within `near` of
    // that bed's middle, `closerToCenterThan`; else, of all the beds within `far`, the first as
    // they're shuffled by its own random, `getRandom`; else its home. Where there's one, its path,
    // look, breed and interaction targets forgotten, the bed its hiding place, and where it isn't
    // within `near` of its middle, walked to.
    fn locate_hiding(mut self, brain: mut Brain, l: (i32, f32, i32)) -> bool {
        let (far, speed, near) = l
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let homes = types_of(1u32 << u32.wrap(HOME))
        let close = f64(near * near)
        var found: BlockPos? = none
        let nearest = pois.in_range(homes.copy(), center, near + 1, Occupancy.Any)
        if not nearest.is_empty() {
            let p = nearest[0].pos
            if self.distance_sqr_to(f64(p.x) + 0.5, f64(p.y) + 0.5, f64(p.z) + 0.5) < close {
                found = some(p)
            }
        }
        if found == none {
            var all = pois.in_range(homes, center, far, Occupancy.Any)
            shuffle(mut all, mut self.living.body.random)
            if not all.is_empty() {
                found = some(all[0].pos)
            }
        }
        self.pois = some(pois)
        if found == none {
            if let g = brain.place(MEMORY_HOME) {
                found = some(g.pos)
            }
        }
        let pos = found else return true
        brain.erase(MEMORY_PATH)
        brain.erase(MEMORY_LOOK_TARGET)
        brain.erase(MEMORY_BREED_TARGET)
        brain.erase(MEMORY_INTERACTION_TARGET)
        brain.set(MEMORY_HIDING_PLACE, Memo.Place(GlobalPos { dimension: self.dimension.copy(), pos: pos }))
        if self.distance_sqr_to(f64(pos.x) + 0.5, f64(pos.y) + 0.5, f64(pos.z) + 0.5) >= close {
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(pos.x, pos.y, pos.z)), speed: speed, close_enough: near }))
        }
        return true
    }

    /// A bell it heard rung at the game time `now`, `HEARD_BELL_TIME`, where its brain has that
    /// memory, as a villager's does (CAL-160).
    pub fn hear_bell(mut self, now: i64) {
        var brain = self.brain.take() else return
        brain.set(MEMORY_HEARD_BELL_TIME, Memo.Long(now))
        self.brain = some(brain)
    }

    // `PlayTagWithOtherKids` (CAL-160): one time in 10, from the level's random, of the babies it
    // sees, `VISIBLE_VILLAGER_BABIES`: where none chases it, the one with the fewest chasing it of
    // those 1 to 5 chase, chased, else the first of them, its interaction target, looked at and
    // walked to at 0.6, near enough within 1; where one does, of up to 10 places on land up to 20
    // across and 8 up or down, `LandRandomPos.getPos`, the first in a village, its section within 1
    // of a center, run to at 0.6, near enough within 0. Vanilla counts the chasers in a `HashMap`
    // of the babies chased, ordered by their identity hashes, so where two are chased by as many
    // its pick differs run to run; these go in the order they're first seen chased.
    fn play_tag<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, random: mut TapedRandom, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if random.next_int_below(10) != 0 {
            return false
        }
        let me = self.living.body.id
        let friends = brain.entities(MEMORY_VISIBLE_VILLAGER_BABIES)
        var chased_me = false
        var chased = List<i32>()
        var counts = List<i32>()
        for id in friends {
            let n = self.near_of(id) else continue
            let t = n.interacting else continue
            if t == me {
                chased_me = true
                break
            }
        }
        if not chased_me {
            for id in friends {
                let n = self.near_of(id) else continue
                let t = n.interacting else continue
                var k: usize? = none
                for i in 0..chased.len() {
                    if chased[i] == t {
                        k = some(i)
                        break
                    }
                }
                match k {
                    some(i) => counts[i] += 1,
                    none => {
                        chased.push(t)
                        counts.push(1)
                    },
                }
            }
            var pick: i32? = none
            var least = 6
            for i in 0..chased.len() {
                if counts[i] > 0 and counts[i] < least {
                    least = counts[i]
                    pick = some(chased[i])
                }
            }
            if pick == none and not friends.is_empty() {
                pick = some(friends[0])
            }
            if let kid = pick {
                brain.set(MEMORY_INTERACTION_TARGET, Memo.Entity(kid))
                brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: kid, eyes: true })))
                brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Entity(Follow { id: kid, eyes: false }), speed: 0.6f32, close_enough: 1 }))
            }
            return true
        }
        for _ in 0..10 {
            if let p = self.random_place(true, 20, 8, lf, f, blocks, mut cache, min_y) {
                let (x, y, z) = p
                var pois = self.pois.take() ?? Pois.new(0, 0)
                let village = pois.sections_to_village(floor_of(x) >> 4, floor_of(y) >> 4, floor_of(z) >> 4) <= 1
                self.pois = some(pois)
                if village {
                    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(x, y, z, 0.6f32, 0)))
                    break
                }
            }
        }
        return true
    }

    // `SetClosestHomeAsWalkTarget` (CAL-160): 20 ticks at least since it last looked,
    // `lastUpdate`, kept in `last_check`, where the nearest bed within 48 of its block, of any
    // occupancy, is farther than 2 blocks: its next look put off up to 19 ticks more, drawn from
    // the level's random; of the beds within 48, in the order the level finds them, those it
    // hasn't tried lately, up to 4, each kept as tried 40 ticks past then, `batchCache`, kept in
    // `retries`; a path to the nearest it can reach of them, `findPathToPois`, walked to where it
    // reaches it and it's a point of interest still, near enough within 1; else, where fewer than 5
    // were new, those kept past their time forgotten.
    fn home_walk<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, speed: f32, keep: mut Keep, now: i64, random: mut TapedRandom, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if now - keep.last_check < 20 {
            return false
        }
        let pois = self.pois.take() ?? Pois.new(0, 0)
        let (bx, by, bz) = self.block_position()
        let center = BlockPos { x: bx, y: by, z: bz }
        let homes = types_of(1u32 << u32.wrap(HOME))
        let records = pois.in_range(homes, center, 48, Occupancy.Any)
        var nearest: f64? = none
        for r in records {
            let (dx, dy, dz) = (f64(r.pos.x - bx), f64(r.pos.y - by), f64(r.pos.z - bz))
            let d = dx * dx + dy * dy + dz * dz
            if nearest == none or d < (nearest ?? 0.0) {
                nearest = some(d)
            }
        }
        let closest = nearest ?? 0.0
        if nearest == none or closest <= 4.0 {
            self.pois = some(pois)
            return false
        }
        keep.last_check = now + i64(random.next_int_below(20))
        var tried = 0
        var targets = List<(i32, i32, i32)>()
        var reach_range = 1
        for r in records {
            let key = r.pos.pack()
            if keep.retries.contains(key) {
                continue
            }
            tried += 1
            if tried >= 5 {
                continue
            }
            keep.retries.insert(key, Retry { next: keep.last_check + 40 })
            targets.push((r.pos.x, r.pos.y, r.pos.z))
            let reach = valid_range(i32.wrap(r.kind))
            if reach > reach_range {
                reach_range = reach
            }
        }
        var reached = false
        if not targets.is_empty() {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            if let p = self.navigation.create_path_to_any(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, targets, reach_range) {
                if p.reached {
                    reached = true
                    let (tx, ty, tz) = p.target
                    if pois.type_at(BlockPos { x: tx, y: ty, z: tz }) != none {
                        brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(tx, ty, tz)), speed: speed, close_enough: 1 }))
                    }
                }
            }
        }
        if not reached and tried < 5 {
            var gone = List<i64>()
            for (k, r) in keep.retries {
                if r.next < keep.last_check {
                    gone.push(k)
                }
            }
            for k in gone {
                _ = keep.retries.remove(k)
            }
        }
        self.pois = some(pois)
        return true
    }

    // `InsideBrownianWalk` (CAL-160): where its block doesn't see the sky, the 27 blocks around
    // and at it, x fastest, then y, then z, shuffled with its own random for it, as
    // `Collections.shuffle` does, `shuffle_random`; the first of them that doesn't see the sky,
    // whose chunk's there and that it can stand on, `loadedAndEntityCanStandOn`, while it has room
    // where it is, `noCollision`, walked to, near enough within 0.
    fn brownian_walk<B: CollisionBlocks + MobLight>(mut self, brain: mut Brain, speed: f32, f: Facts, m: MovementStates, blocks: B) -> bool {
        let (bx, by, bz) = self.block_position()
        if blocks.sees_sky(bx, by, bz) {
            return false
        }
        var around = List<(i32, i32, i32)>()
        for z in (bz - 1)..(bz + 2) {
            for y in (by - 1)..(by + 2) {
                for x in (bx - 1)..(bx + 2) {
                    around.push((x, y, z))
                }
            }
        }
        var shuffler = self.shuffle_random.take() ?? LegacyRandom.new(gate_seed(self.brain_seed, 1000))
        var i = around.len()
        while i > 1 {
            let j = usize.wrap(shuffler.next_int_below(i32.wrap(i)))
            around.swap(i - 1, j)
            i -= 1
        }
        self.shuffle_random = some(shuffler)
        var room: bool? = none
        for (x, y, z) in around {
            if blocks.sees_sky(x, y, z) {
                continue
            }
            let state = blocks.collision_state(x, y, z) else continue
            if not self.can_stand_on(f, state, y) {
                continue
            }
            if room == none {
                room = some(self.has_room(f, m, blocks))
            }
            if room == some(false) {
                continue
            }
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: speed, close_enough: 0 }))
            break
        }
        return true
    }

    // `entityCanStandOn` of the state at a block at `y`: the top of its collision shape for it
    // full, `isFaceFull`, as the block's facts say for no entity; but scaffolding's full only where
    // it's above it, `isAbove`, as a mob never descends.
    fn can_stand_on(self, f: Facts, state: u32, y: i32) -> bool {
        if f.block_named(String("minecraft:scaffolding")) == some(f.block(state)) {
            return self.living.body.y > f64(y) + 1.0 - f64(1.0e-5f32)
        }
        return f.flags(state) & COLLISION_TOP_FULL != 0
    }

    // `noCollision(entity)`: whether no block's collision shape for it meets its box, as no entity
    // a mob collides with is made yet.
    fn has_room<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B) -> bool {
        let b = self.living.body.bounding_box()
        let near = m.colliders(f, blocks, b, self.living.body.mover())
        for c in near.boxes {
            if b.intersects(c.min_x, c.min_y, c.min_z, c.max_x, c.max_y, c.max_z) {
                return false
            }
        }
        return true
    }

    // `GoToClosestVillage` (CAL-160): where it isn't in a village, its section within 1 of a
    // center, `isVillage`: of 5 places on land up to 15 across and 7 up or down, each the one of
    // its 10 tries nearest a village by sections, the first of those as near,
    // `LandRandomPos.getPos` weighted by `-sectionsToVillage`, the first nearer a village than its
    // own section, else the last as near, walked to, near enough within `close`.
    fn to_village<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, speed: f32, close: i32, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let (bx, by, bz) = self.block_position()
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let here = pois.sections_to_village(bx >> 4, by >> 4, bz >> 4)
        if here <= 1 {
            self.pois = some(pois)
            return false
        }
        var target: (i32, i32, i32)? = none
        for _ in 0..5 {
            let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
            let costs = self.own_maluses()
            let tries = land_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 15, 7)
            var best = f64.NEG_INFINITY
            var found: (i32, i32, i32)? = none
            for t in tries {
                if let p = t {
                    let (x, y, z) = p
                    let value = -f64(pois.sections_to_village(x >> 4, y >> 4, z >> 4))
                    if value > best {
                        best = value
                        found = some(p)
                    }
                }
            }
            if let p = found {
                let (x, y, z) = p
                let there = pois.sections_to_village(x >> 4, y >> 4, z >> 4)
                if there < here {
                    target = some(p)
                    break
                }
                if there == here {
                    target = some(p)
                }
            }
        }
        self.pois = some(pois)
        if let t = target {
            let (x, y, z) = t
            brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk.to_place(f64(x) + 0.5, f64(y), f64(z) + 0.5, speed, close)))
        }
        return true
    }

    // `VillageBoundRandomStroll`'s place (CAL-160), up to `h` across and `v` up or down: in a
    // village, its section within 1 of a center, anywhere on land, `LandRandomPos.getPos`; else,
    // toward the middle of the section nearest a village within 2 of its own, the first of the
    // nearest, x, then y, then z, `DefaultRandomPos.getPosTowards`, where there's one nearer than
    // its own; else anywhere on land.
    fn village_stroll_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, h: i32, v: i32, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let (bx, by, bz) = self.block_position()
        let (sx, sy, sz) = (bx >> 4, by >> 4, bz >> 4)
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let here = pois.sections_to_village(sx, sy, sz)
        var toward: (i32, i32, i32)? = none
        if here > 1 {
            var best = here
            for z in (sz - 2)..(sz + 3) {
                for y in (sy - 2)..(sy + 3) {
                    for x in (sx - 2)..(sx + 3) {
                        let d = pois.sections_to_village(x, y, z)
                        if d < best {
                            best = d
                            toward = some((x, y, z))
                        }
                    }
                }
            }
        }
        self.pois = some(pois)
        let at = toward else return self.random_place(true, h, v, lf, f, blocks, mut cache, min_y)
        let (cx, _, cz) = at
        let dir = (f64(cx * 16 + 8) + 0.5 - self.living.body.x, f64(cz * 16 + 8) + 0.5 - self.living.body.z)
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
        let costs = self.own_maluses()
        let tries = towards_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, h, v, dir)
        return self.best_place(lf, f, blocks, tries)
    }

    // `Villager.canBreed`: its food and its inventory's food points, 12 at least, awake and grown,
    // its age 0.
    fn villager_can_breed(self) -> bool {
        if self.age != 0 or self.living.sleeping != none {
            return false
        }
        return self.food_level + self.food_points() >= 12
    }

    /// A villager's inventory's food points, `countFoodPointsInInventory` (CAL-160): each stack of
    /// a villager food so many times its `villager_food` component's `nutrition`, bread's 4 and a
    /// carrot's, potato's or beetroot's 1.
    pub fn food_points(self) -> i32 {
        var points = 0
        for t in self.stacks() {
            let Tag.Compound(c) = t else continue
            if not c.contains("id") {
                continue
            }
            let Tag.Str(id) = c["id"] else continue
            points += villager_food(id.copy()) * int_or(c, "count", 1)
        }
        return points
    }

    // A villager's inventory's stacks in their order: what it saved, where that's still to read,
    // else those of its slots that aren't empty, as `storeAsItemList` writes them.
    fn stacks(self) -> List<Tag> {
        var out = List<Tag>()
        if not self.inventory_read {
            if self.kept.contains("Inventory") {
                if let Tag.List(items) = self.kept["Inventory"] {
                    for t in items {
                        out.push(t.copy())
                    }
                }
            }
            return out
        }
        for s in self.inventory {
            if let t = s {
                out.push(t.copy())
            }
        }
        return out
    }

    // A villager's inventory's 8 slots: as read, or, where what it saved is still to read, as
    // `fromItemList` reads it, each stack added in turn, `addItem`, to 8 empty slots.
    fn inventory_slots(self, f: Facts) -> List<Tag?> {
        if self.inventory_read {
            return self.inventory.copy()
        }
        var slots = List<Tag?>()
        for _ in 0..8 {
            slots.push(none)
        }
        for t in self.stacks() {
            _ = add_to(mut slots, t, f)
        }
        return slots
    }

    // A villager's inventory read from what it saved, where it's still to read, as `fromItemList`
    // reads it.
    fn ready_inventory(mut self, f: Facts) {
        if self.inventory_read {
            return
        }
        self.inventory = self.inventory_slots(f)
        _ = self.kept.remove("Inventory")
        self.inventory_read = true
    }

    /// Whether a villager wants `stack`, `Villager.wantsToPickUp` (CAL-160): an item in
    /// `#villager_picks_up`, one a villager eats, `villager_food`, or one its profession asks for,
    /// a farmer's wheat, seeds and bone meal, `requestedItems`, that its inventory has room for,
    /// `canAddItem`: an empty slot, or one of the same item and components short of its most.
    pub fn villager_wants<W: Wearing>(self, lf: LivingFacts, f: Facts, items: W, stack: Tag) -> bool {
        let item = held_name(some(stack.copy()))
        var wanted = lf.villager_picks_up.contains(item) or items.worn_component(stack.copy(), String("minecraft:villager_food")) != none
        if not wanted {
            let (_, profession, _) = self.living.data.villager(OWN + 1)
            wanted = profession == FARMER and farmer_requests().contains(item)
        }
        if not wanted {
            return false
        }
        for s in self.inventory_slots(f) {
            let t = s else return true
            if same_components(some(t.copy()), some(stack.copy())) and count_of(some(t.copy())) < stack_limit(f, t) {
                return true
            }
        }
        return false
    }

    /// `InventoryCarrier.pickUpItem` of `stack` into a villager's inventory (CAL-160), where it has
    /// room, `addItem`: how many of it went in.
    pub fn pick_up_into(mut self, stack: Tag, f: Facts) -> i32 {
        self.ready_inventory(f)
        let count = count_of(some(stack.copy()))
        var slots = self.inventory.copy()
        let left = add_to(mut slots, stack, f)
        self.inventory = slots
        return count - count_of(left)
    }

    /// Whether its item sensor scans as its brain next ticks, so what it wants of the items near it
    /// is asked (CAL-160).
    pub fn item_sensor_due(self) -> bool {
        let b = self.brain else return false
        return b.sensor_soon(SENSOR_NEAREST_ITEMS)
    }

    /// Whether it keeps an inventory, `InventoryCarrier`, as a villager does (CAL-160).
    pub fn carries_inventory(self) -> bool {
        return self.species == VILLAGER
    }

    // `Animal`'s: its love gone where its age is anything but 0.
    fn animal_step(mut self) {
        if self.animal and self.age != 0 {
            self.in_love = 0
        }
    }

    // `serverAiStep` up to and through its goals, where it may attack a player, which its level
    // deals before `think_after` goes on with the rest of it (CAL-159): what it's seen forgotten,
    // `Sensing.tick`, then its target goals and its goals.
    fn think<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        // Its goals steer what it rides, where it does, with that one's navigation and move
        // control, `getNavigation` and `getMoveControl` (D710).
        self.steer(true)
        self.sensing.clear()
        if self.species == RABBIT {
            // What a rabbit's move control and breeding read as its AI steps, where it is then
            // (CAL-201): whether it's in water, and the rabbits its biome gives.
            self.moves.wet = self.living.body.in_water
            let (bx, by, bz) = self.block_position()
            self.rabbit.here = blocks.rabbits_at(bx, by, bz)
        }
        // Its target goals, then its goals (CAL-159), in full where its tick count and ID together
        // are even, or in its first two ticks; else only those that tick every tick,
        // `tickRunningGoals(false)`.
        let ticks = self.living.body.tick_count
        let full = not ((ticks + self.living.body.id) % 2 != 0 and ticks > 1)
        self.run_goals(true, full, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        self.run_goals(false, full, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        self.thought = true
    }

    // The rest of `serverAiStep`, after its goals and the hit its level dealt there, as vanilla's
    // `doHurtTarget` comes in its goals (CAL-159): its navigation's tick, which sets its move
    // control toward its path's next node; its own step, `customServerAiStep`, an enderman's
    // daylight teleport and an armadillo's brain among it (CAL-160); then its controls, moving, a
    // cube mob's its own way, looking, its head kept within its reach, `getMaxHeadYRot`, and
    // jumping, `JumpControl.tick`. Whether a villager's brain's tick stopped for its level to swing
    // a door, to go on from there, past its navigation's tick, which it's had (CAL-160).
    fn think_after<B: CollisionBlocks + MobLight + NavLevel + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, items: W, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        // Its own navigation and controls tick, `this.navigation` and `this.moveControl`, not what
        // it steers (D710).
        self.steer(false)
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        let resuming = self.wither.resuming or match self.held_brain {
            some(_) => true,
            none => false,
        }
        // A bee's navigation doesn't tick while it pollinates (CAL-177).
        let paused = self.species == BEE and self.bee.pollinating
        if not resuming and not paused {
            let wanted = self.navigation.tick(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w)
            if let q = wanted {
                let (x, y, z, speed) = q
                self.moves.set_wanted(x, y, z, speed)
            }
        }
        if self.species == ENDERMAN {
            self.daylight_step(lf, f, m, blocks, min_y, mut sounds)
        } else if self.species == BEE {
            self.bee_ai(lf, blocks, items, players, mut sounds)
        } else if self.species == ELDER_GUARDIAN {
            // `ElderGuardian.customServerAiStep` (CAL-200): every 1,200 ticks by its ticks and ID,
            // its mining fatigue on the players around it, which its level gives; and its home
            // where it is, 16 across, where it has none, `setHomeTo`.
            if (self.living.body.tick_count + self.living.body.id) % 1200 == 0 {
                let at = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.silent())
                self.living.show(Shown.Fatigue(at), sounds.len())
            }
            if self.home == none {
                self.home = some((self.block_position(), 16))
            }
        } else if self.species == BLAZE {
            self.blaze_step(players)
        } else if self.species == WITHER_BOSS {
            if self.wither.resuming {
                self.wither.resuming = false
                self.wither_step_end(lf, sounds.len())
            } else if self.wither_step(lf, f, m, blocks, players, sounds.len()) {
                self.wither.resuming = true
                return true
            }
        } else if self.species == SULFUR_CUBE {
            // `SulfurCube.customServerAiStep` (CAL-402): its pickup timer and its push sound's
            // cooldown counted down.
            if self.sulfur.pickup_timer > 0 {
                self.sulfur.pickup_timer -= 1
            }
            if self.sulfur.push_sound_cooldown > 0 {
                self.sulfur.push_sound_cooldown -= 1
            }
        } else if self.species == ZOMBIFIED_PIGLIN {
            self.zombified_piglin_step(f, m, blocks, players, mut sounds)
        } else if self.species == VINDICATOR {
            // `Vindicator.customServerAiStep` (CAL-200): opening doors only where its block's in a
            // raid, which none is in Calcite yet, `isRaided`.
            self.navigation.can_open_doors = false
        } else if self.species == EVOKER {
            // `SpellcasterIllager.customServerAiStep` (CAL-200): a tick less of its casting.
            if self.spell_ticks > 0 {
                self.spell_ticks -= 1
            }
        } else if self.species == ARMADILLO {
            self.armadillo_step(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds)
        } else if self.species == HOGLIN {
            if self.hoglin_step(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
                return true
            }
        } else if self.species == ZOGLIN {
            if self.zoglin_step(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
                return true
            }
        } else if self.species == PIGLIN_BRUTE {
            if self.brute_step(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
                return true
            }
        } else if self.species == PIGLIN {
            if self.piglin_step(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
                return true
            }
        } else if self.species == VILLAGER {
            if self.villager_step(lf, f, m, blocks, items, mut cache, players, min_y, mut sounds) {
                return true
            }
        } else if self.species == CAT or self.species == OCELOT {
            self.cat_step()
        } else if self.species == BAT {
            self.bat_step(f, m, blocks, players, min_y, sounds)
        } else if self.species == RABBIT {
            self.rabbit_step(players, mut sounds)
        }
        // A bee's own step is all of its `customServerAiStep`, not an animal's (CAL-177), and a
        // hoglin's all of its (CAL-200), and a cat's (CAL-201).
        if self.species != BEE and self.species != HOGLIN and self.species != CAT and self.species != OCELOT and self.species != RABBIT {
            self.animal_step()
        }
        // Its controls read it as it is now, after its own step, which may have moved it, an
        // enderman's teleport or a villager lying down in its bed (CAL-160).
        let moving = self.walker(lf)
        if self.species == BEE or self.species == PARROT or self.species == WITHER_BOSS {
            // `FlyingMoveControl(this, 20, true)`: it hovers in place (CAL-177); a parrot's
            // `FlyingMoveControl(this, 10, false)`, falling again as it stops (CAL-201), and a
            // wither's (CAL-401).
            let bee = self.species == BEE
            let flying = self.living.attributes.value(lf.flying_speed)
            if let floats = self.moves.fly_tick(mut self.living, moving, flying, if bee { 20.0f32 } else { 10.0f32 }, bee) {
                self.living.body.no_gravity = floats
                self.living.data.set(NO_GRAVITY, Value.Bool(floats))
            }
        } else if cube_kind(self.species) {
            let size = self.slime_size()
            let magma = self.species == MAGMA_CUBE
            // A sulfur cube's does nothing while it holds a block, `SulfurCubeMobMoveControl`
            // (CAL-402).
            let still = self.species == SULFUR_CUBE and self.has_body_item()
            let (jumps, heard) = if still { (false, false) } else { self.moves.cube_tick(mut self.living, moving, size, magma) }
            if jumps {
                self.jump = true
            }
            if heard {
                // A magma cube's the same whatever its size (CAL-200).
                // A sulfur cube's own (CAL-402).
                let sulfur = self.species == SULFUR_CUBE
                let sound = if magma { "entity.magma_cube.jump" } else if sulfur and size <= 1 { "entity.small_sulfur_cube.jump" } else if sulfur { "entity.sulfur_cube.jump" } else if size <= 1 { "entity.slime.jump_small" } else { "entity.slime.jump" }
                let pitch = self.cube_pitch()
                self.living.play(mut sounds, String(sound), self.sound_volume, pitch)
            }
        } else if self.species == DROWNED {
            if self.drowned_moves(lf, f, nf, m, blocks, mut cache, players, moving) {
                self.jump = true
            }
        } else if self.species == TURTLE {
            // `TurtleMoveControl` (CAL-201).
            self.turtle_moves(moving)
        } else if self.species == PHANTOM {
            // `PhantomMoveControl` (CAL-200).
            self.phantom_moves()
        } else if self.species == GHAST {
            // `GhastMoveControl(this, false, () -> false)` (CAL-200).
            self.ghast_moves(lf, f, m, blocks)
        } else if self.species == VEX {
            // `VexMoveControl` (CAL-200).
            self.vex_moves(players)
        } else if self.guardian_kind() {
            // `GuardianMoveControl` (CAL-200).
            self.guardian_moves(moving)
        } else if self.species == DOLPHIN {
            // `SmoothSwimmingMoveControl` (CAL-201).
            self.dolphin_moves(moving)
        } else if self.species == RABBIT {
            if self.rabbit_moves(lf, f, nf, m, blocks, mut cache, moving) {
                self.jump = true
            }
        } else if fish_kind(self.species) {
            // `AbstractFish.FishMoveControl` (CAL-178).
            self.moves.fish_tick(mut self.living, moving, self.navigation.is_done())
        } else if self.species == FOX and not self.fox_can_move() {
            // `FoxMoveControl` (CAL-201): nothing while it can't move.
        } else if self.species == PANDA and not self.panda_can_act() {
            // `PandaMoveControl` (CAL-201): nothing while it isn't free to act.
        } else if self.moves.tick(lf, f, nf, m, blocks, mut cache, mut self.living, moving) {
            self.jump = true
        }
        // Its look reads the navigation of what it steers, where it does, `getNavigation` (D710).
        var going = not self.navigation.is_done()
        if let s = self.steering {
            going = not s.navigation.is_done()
        }
        let reach = self.max_head_y_rot()
        if self.species == PHANTOM {
            // `PhantomLookControl.tick`, which does nothing (CAL-200).
        } else if self.species == SHULKER {
            // `ShulkerLookControl` (CAL-200).
            let y = self.shulker_y_rot_d()
            self.look.shulker_tick(mut self.living, y)
        } else if self.species == FOX {
            // `FoxLookControl` (CAL-201): not while it sleeps, its pitch kept while it pounces,
            // crouches, is interested or faceplanted, `resetXRotOnTick`.
            if not self.fox_flag(FOX_SLEEPING) {
                let reset = not self.fox_flag(FOX_POUNCING) and not self.fox_flag(FOX_CROUCHING) and not self.fox_flag(FOX_INTERESTED) and not self.fox_flag(FOX_FACEPLANTED)
                self.look.tick(mut self.living, going, reach, reset)
            }
        } else if self.species == DOLPHIN {
            // `SmoothSwimmingLookControl(10)`, its own navigation's done or not (CAL-201).
            let done = self.navigation.is_done()
            self.look.smooth_swim_tick(mut self.living, done, 10.0f32)
        } else if self.species == SULFUR_CUBE and self.has_body_item() {
            // `SulfurCubeLookControl` (CAL-402): holding a block, it turns to the nearest quarter
            // turn, its head with it.
            let close = wrap_degrees_90(self.living.body.y_rot)
            self.living.body.y_rot = self.living.body.y_rot - close
            self.living.y_head_rot = self.living.body.y_rot
        } else if self.species != BEE {
            self.look.tick(mut self.living, going, reach, true)
        } else if not self.angry() {
            // `BeeLookControl`: not while it's angry, and its pitch kept while it pollinates,
            // `resetXRotOnTick` (CAL-177).
            self.look.tick(mut self.living, going, reach, not self.bee.pollinating)
        }
        if self.species == RABBIT {
            // `RabbitJumpControl.tick` (CAL-201): told to jump, it starts its jump; it's never
            // told not to jump here.
            if self.jump {
                self.rabbit_start_jumping(mut sounds)
            }
        } else {
            self.living.jumping = self.jump
        }
        self.jump = false
        return false
    }

    // `GuardianMoveControl.tick` (CAL-200): moving to where it's wanted with its navigation not
    // done, turned toward there, 90 degrees a tick at most, its body with it; its speed eased an
    // eighth of the way to its own, `setSpeed`; pushed across by a wave of its ticks and ID along
    // its facing, a twentieth, and up and down by another of them, a quarter of that along the sum
    // of its facing's sine and cosine, and a tenth of its speed toward there; looking an eighth of
    // the way from where it looked, or from where it'd look where it isn't looking at anything,
    // toward 2 ahead of it that way and the way up or down over the distance up from its eyes, 10
    // and 40 degrees a tick; and moving, `setMoving`. Else stopped and not moving.
    fn guardian_moves(mut self, w: Walker) {
        if self.moves.operation != MOVE_TO or self.navigation.is_done() {
            self.living.speed = 0.0f32
            self.living.zza = 0.0f32
            self.living.data.set(MONSTER_OWN, Value.Bool(false))
            return
        }
        let dx = self.moves.wanted_x - w.x
        let dy = self.moves.wanted_y - w.y
        let dz = self.moves.wanted_z - w.z
        let length = (dx * dx + dy * dy + dz * dz).sqrt()
        let xd = dx / length
        let yd = dy / length
        let zd = dz / length
        let angle = table_atan2(dz, dx) ?? 0.0
        let wanted_rot = f32.nearest(angle * RAD_TO_DEG) - 90.0f32
        self.living.body.y_rot = rotlerp(self.living.body.y_rot, wanted_rot, 90.0f32)
        self.living.y_body_rot = self.living.body.y_rot
        let target_speed = f32.nearest(self.moves.speed_modifier * w.movement_speed)
        let speed = self.living.speed + 0.125f32 * (target_speed - self.living.speed)
        self.living.speed = speed
        self.living.zza = speed
        let wave = f64(self.living.body.tick_count + self.living.body.id)
        let push = sin(wave * 0.5) * 0.05
        let turn = f64(self.living.body.y_rot * 0.017453292f32)
        let c = cos(turn)
        let s = sin(turn)
        let y_push = sin(wave * 0.75) * 0.05
        self.living.body.vx = self.living.body.vx + push * c
        self.living.body.vy = self.living.body.vy + (y_push * (s + c) * 0.25 + f64(speed) * yd * 0.1)
        self.living.body.vz = self.living.body.vz + push * s
        let eye_y = self.living.body.y + f64(self.living.body.eyes)
        let (nx, ny, nz) = (self.living.body.x + xd * 2.0, eye_y + yd / length, self.living.body.z + zd * 2.0)
        var (ox, oy, oz) = self.look.wanted()
        if not self.look.looking() {
            ox = nx
            oy = ny
            oz = nz
        }
        self.look.set_look_at(ox + 0.125 * (nx - ox), oy + 0.125 * (ny - oy), oz + 0.125 * (nz - oz), 10.0f32, 40.0f32)
        self.living.data.set(MONSTER_OWN, Value.Bool(true))
    }

    // `DrownedMoveControl.tick` (CAL-175): wanting to swim in water, up 0.002 where its target's
    // above it or it's looking for land; then, moving to where it's wanted with its navigation
    // not done, turned toward there, 90 degrees a tick at most, its body with it, its speed eased
    // an eighth of the way to its own, and pushed that way, an across of 0.005 and up and down 0.1
    // of it; else stopped. Otherwise down 0.008 off the ground, then `MoveControl.tick`'s.
    // Whether it jumps.
    fn drowned_moves<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, nf: NavFacts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, w: Walker) -> bool {
        let target = self.target_in(players)
        if self.wants_to_swim(players) and self.living.body.in_water {
            let above = if let t = target { t.y > self.living.body.y } else { false }
            if above or self.searching_for_land {
                self.living.body.vy = self.living.body.vy + 0.002
            }
            if self.moves.operation != MOVE_TO or self.navigation.is_done() {
                self.living.speed = 0.0f32
                self.living.zza = 0.0f32
                return false
            }
            let xd = self.moves.wanted_x - w.x
            var yd = self.moves.wanted_y - w.y
            let zd = self.moves.wanted_z - w.z
            let dd = (xd * xd + yd * yd + zd * zd).sqrt()
            yd = yd / dd
            let angle = table_atan2(zd, xd) ?? 0.0
            let wanted_rot = f32.nearest(angle * RAD_TO_DEG) - 90.0f32
            self.living.body.y_rot = rotlerp(self.living.body.y_rot, wanted_rot, 90.0f32)
            self.living.y_body_rot = self.living.body.y_rot
            let target_speed = f32.nearest(self.moves.speed_modifier * w.movement_speed)
            let speed = self.living.speed + 0.125f32 * (target_speed - self.living.speed)
            self.living.speed = speed
            self.living.zza = speed
            let s = f64(speed)
            self.living.body.vx = self.living.body.vx + s * xd * 0.005
            self.living.body.vy = self.living.body.vy + s * yd * 0.1
            self.living.body.vz = self.living.body.vz + s * zd * 0.005
            return false
        }
        if not self.living.body.on_ground {
            self.living.body.vy = self.living.body.vy - 0.008
        }
        return self.moves.tick(lf, f, nf, m, blocks, mut cache, mut self.living, w)
    }

    // What a drowned's body reads of it as it ticks and travels (CAL-175): whether it wants to
    // swim, `wantsToSwim`, and its AI's on, `isEffectiveAi`.
    fn swim_wish(mut self, players: List<Follower>) {
        if self.species != DROWNED {
            return
        }
        self.living.wants_swim = self.wants_to_swim(players)
        self.living.ai_on = not self.no_ai()
    }

    // `DrownedGoToWaterGoal` (CAL-175): used by day out of water where one of 10 places drawn
    // about it, up to 10 across and from 2 up to 5 down, x, y and z, is water, `Blocks.WATER`,
    // the first, at its bottom's middle; going on while its navigation isn't done; as it starts,
    // on its way there.
    fn to_water_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut ToWater, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if not blocks.bright_outside() or self.living.body.in_water {
                return false
            }
            let water = f.block_named(String("minecraft:water"))
            let (bx, by, bz) = self.block_position()
            for _ in 0..10 {
                let dx = self.living.body.random.next_int_below(20) - 10
                let dy = 2 - self.living.body.random.next_int_below(8)
                let dz = self.living.body.random.next_int_below(20) - 10
                let (x, y, z) = (bx + dx, by + dy, bz + dz)
                if water != none and some(f.block(state_at(blocks, x, y, z))) == water {
                    g.x = f64(x) + 0.5
                    g.y = f64(y)
                    g.z = f64(z) + 0.5
                    return true
                }
            }
            return false
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.x, g.y, g.z, g.speed)
        }
        return false
    }

    // `DrownedGoToBeachGoal`, a `MoveToBlockGoal` (CAL-175): used by night in water no lower than 3
    // under the sea's level where its count of tries is done, `nextStartTick`, 200 to 399, drawn
    // and halved, as it looks, and it finds a block a drowned can stand on with air twice above
    // it, `findNearestBlock`; going on while it's tried at most 1200 ticks and stayed no longer
    // than its most, and the block's still one; as it starts, not looking for land, on its way to
    // the block's top, its tries 0 and its most ticks there drawn. Each tick, farther than 1 from
    // the middle of the block above it, a try more, on its way there again each 40th; else there,
    // a try less.
    fn beach_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Beach, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            var found = false
            if g.next_start > 0 {
                g.next_start -= 1
            } else {
                g.next_start = reduced_tick_delay(200 + self.living.body.random.next_int_below(200))
                found = self.find_beach(mut g, f, blocks)
            }
            return found and not blocks.bright_outside() and self.living.body.in_water and self.living.body.y >= f64(blocks.sea_level() - 3)
        }
        if call == GOAL_CONTINUE {
            return g.try_ticks >= -g.max_stay and g.try_ticks <= 1200 and self.beach_at(f, blocks, g.x, g.y, g.z)
        }
        if call == GOAL_START {
            self.searching_for_land = false
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, g.speed)
            g.try_ticks = 0
            let bound = self.living.body.random.next_int_below(1200) + 1200
            g.max_stay = self.living.body.random.next_int_below(bound) + 1200
        } else if call == GOAL_TICK {
            let (tx, ty, tz) = (g.x, g.y + 1, g.z)
            let dx = f64(tx) + 0.5 - self.living.body.x
            let dy = f64(ty) + 0.5 - self.living.body.y
            let dz = f64(tz) + 0.5 - self.living.body.z
            if not (dx * dx + dy * dy + dz * dz < 1.0) {
                g.reached = false
                g.try_ticks += 1
                if g.try_ticks % 40 == 0 {
                    _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(tx) + 0.5, f64(ty), f64(tz) + 0.5, g.speed)
                }
            } else {
                g.reached = true
                g.try_ticks -= 1
            }
        }
        return false
    }

    // `DrownedGoToBeachGoal.isValidTarget`: air twice above the block, and the block one a drowned
    // can stand on, `entityCanStandOn`.
    fn beach_at<B: CollisionBlocks>(self, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
        if not f.is_air(state_at(blocks, x, y + 1, z)) or not f.is_air(state_at(blocks, x, y + 2, z)) {
            return false
        }
        return self.can_stand_on(f, state_at(blocks, x, y, z), y)
    }

    // `MoveToBlockGoal.findNearestBlock` for a beach, as `find_nearest_block` goes over the blocks
    // about it, a block down, by rings out to its range, each layer from 0 up, then down; the
    // first that's one kept. It has no home, so any is within it.
    fn find_beach<B: CollisionBlocks>(self, g: mut Beach, f: Facts, blocks: B) -> bool {
        let (mx, my, mz) = self.block_position()
        var y = 0
        while y <= g.vertical {
            for r in 0..g.range {
                var x = 0
                while x <= r {
                    var z = if x < r and x > -r { r } else { 0 }
                    while z <= r {
                        let (px, py, pz) = (mx + x, my + y - 1, mz + z)
                        if self.beach_at(f, blocks, px, py, pz) {
                            g.x = px
                            g.y = py
                            g.z = pz
                            return true
                        }
                        z = if z > 0 { -z } else { 1 - z }
                    }
                    x = if x > 0 { -x } else { 1 - x }
                }
            }
            y = if y > 0 { -y } else { 1 - y }
        }
        return false
    }

    // `DrownedSwimUpGoal` (CAL-175): used by night in water more than 2 under the sea's level;
    // going on while that holds and it isn't stuck. As it starts, looking for land and not stuck;
    // as it stops, not looking. Each tick, more than 1 under the sea's level with its navigation
    // done or within 2 of where its path goes, `closeToNextPos`, on its way to a place toward the
    // sea's level above it, `DefaultRandomPos.getPosTowards` up to 4 across and 8 up or down
    // within a right angle, or stuck where there's none.
    fn swim_up_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut SwimUp, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        let sea = blocks.sea_level()
        let usable = not blocks.bright_outside() and self.living.body.in_water and self.living.body.y < f64(sea - 2)
        if call == GOAL_CAN_USE {
            return usable
        }
        if call == GOAL_CONTINUE {
            return usable and not g.stuck
        }
        if call == GOAL_START {
            self.searching_for_land = true
            g.stuck = false
        } else if call == GOAL_STOP {
            self.searching_for_land = false
        } else if call == GOAL_TICK {
            if self.living.body.y < f64(sea - 1) and (self.navigation.is_done() or self.close_to_next_pos()) {
                // Toward the sea's level just above it: straight up, no way across.
                let dir = (self.living.body.x - self.living.body.x, self.living.body.z - self.living.body.z)
                let place = self.place_towards(4, 8, dir, lf, f, blocks, mut cache, min_y) else {
                    g.stuck = true
                    return false
                }
                let (x, y, z) = place
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, x, y, z, g.speed)
            }
        }
        return false
    }

    // `Drowned.closeToNextPos`: its path's target, `Path.getTarget`, within 2 of it.
    fn close_to_next_pos(self) -> bool {
        let p = self.navigation.path else return false
        let (x, y, z) = p.target
        return self.distance_sqr_to(f64(x), f64(y), f64(z)) < 4.0
    }

    // `Drowned.wantsToSwim` (CAL-175): looking for land, or with a target in water.
    fn wants_to_swim(self, players: List<Follower>) -> bool {
        if self.searching_for_land {
            return true
        }
        let t = self.target_in(players) else return false
        return t.in_water
    }

    /// `getNavigation().moveTo(x, y, z, speedModifier)`, as its goals ask: a path to the block at
    /// `x`, `y`, `z`, reached within 1, followed at `speed`; whether it has one to follow
    /// (CAL-157).
    pub fn move_to<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, x: f64, y: f64, z: f64, speed: f64) -> bool {
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        return self.navigation.move_to(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, x, y, z, speed)
    }

    // `GoalSelector.tick` of its target goals where `t`, else its goals, where `full`, else
    // `tickRunningGoals(false)`: the goals running that can't go on, or whose controls are off,
    // stopped; the holds of those not running let go; each goal not running whose controls are on
    // and held by none or by one of a greater priority number started where it can be used, those
    // that held its controls stopped and the controls its; then those running ticked, or only
    // those that tick every tick where not `full`.
    fn run_goals<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, full: bool, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        if not t {
            self.goals_stop = false
        }
        if full {
            if self.stop_pass(t, 0, lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                return
            }
            if t {
                self.targets.unlock_stopped()
            } else {
                self.goals.unlock_stopped()
            }
            if self.start_pass(t, 0, lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                return
            }
        }
        self.tick_running(t, full, 0, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
    }

    // The goals running of its target goals where `t`, else its goals, from the one at `from`,
    // stopped where they're off or won't go on. Whether one stopped for its level, a door shut,
    // to go on after it, `goals_resume` (CAL-167).
    fn stop_pass<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, from: usize, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let n = if t { self.targets.len() } else { self.goals.len() }
        for i in from..n {
            if self.goal_running(t, i) and (self.goal_disabled(t, i) or not self.goal(t, i, GOAL_CONTINUE, lf, f, m, blocks, mut cache, players, min_y, mut sounds)) {
                self.stop_goal(t, i, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                if not t and self.goals_stop {
                    self.goals_stop = false
                    self.goals_resume = some((0, i + 1))
                    return true
                }
            }
        }
        return false
    }

    // The goals not running of its target goals where `t`, else its goals, from the one at
    // `from`, started where they may, those holding their controls stopped. Whether one stopped
    // for its level, a door opened, to go on after it, `goals_resume` (CAL-167).
    fn start_pass<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, from: usize, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let n = if t { self.targets.len() } else { self.goals.len() }
        for i in from..n {
            let free = if t { self.targets.replaceable(i) } else { self.goals.replaceable(i) }
            if not self.goal_running(t, i) and not self.goal_disabled(t, i) and free and self.goal(t, i, GOAL_CAN_USE, lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                let flags = if t { self.targets.flags(i) } else { self.goals.flags(i) }
                for k in 0..4 {
                    if flags & (1u32 << u32.wrap(k)) != 0 {
                        let h = if t { self.targets.holder(k) } else { self.goals.holder(k) }
                        if h >= 0 {
                            self.stop_goal(t, usize.wrap(h), lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                        }
                        if t {
                            self.targets.lock(k, i)
                        } else {
                            self.goals.lock(k, i)
                        }
                    }
                }
                if not self.goal_running(t, i) {
                    self.set_goal_running(t, i, true)
                    _ = self.goal(t, i, GOAL_START, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                }
            }
            if not t and self.goals_stop {
                self.goals_stop = false
                self.goals_resume = some((1, i + 1))
                return true
            }
        }
        return false
    }

    // `tickRunningGoals` of its target goals where `t`, else its goals, from the one at `from`:
    // those running ticked, or only those that tick every tick where not `full`. Where one stops
    // for its level, a silverfish's waking of a friend, `goals_stop`, the tick stops at it, to go
    // on from it, `goals_from` (CAL-172).
    fn tick_running<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, full: bool, from: usize, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        let n = if t { self.targets.len() } else { self.goals.len() }
        for i in from..n {
            let every = if t { self.targets.every_tick(i) } else { self.goals.every_tick(i) }
            if self.goal_running(t, i) and (full or every) {
                _ = self.goal(t, i, GOAL_TICK, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                if self.goals_stop {
                    self.goals_stop = false
                    self.goals_from = some(i)
                    return
                }
            }
        }
    }

    /// Whether its goals' tick stopped for its level to do what one did then and there, a
    /// silverfish's waking of a friend, to go on once it's done, `tick_rest` (CAL-172).
    pub fn goals_stopped(self) -> bool {
        return self.goals_from != none or self.goals_resume != none
    }

    // Its goals' tick gone on from where it stopped, `goals_from`, as `think` had it: whether it
    // stopped again.
    fn goals_on<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if let (phase, at) = self.goals_resume.take() {
            if phase == 0 {
                if self.stop_pass(false, at, lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                    return true
                }
                self.goals.unlock_stopped()
                if self.start_pass(false, 0, lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                    return true
                }
            } else if self.start_pass(false, at, lf, f, m, blocks, mut cache, players, min_y, mut sounds) {
                return true
            }
            self.tick_running(false, true, 0, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
            return self.goals_stopped()
        }
        let from = self.goals_from.take() else return false
        let ticks = self.living.body.tick_count
        let full = not ((ticks + self.living.body.id) % 2 != 0 and ticks > 1)
        self.tick_running(false, full, from, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        return self.goals_from != none
    }

    // Whether the goal at `i` of its target goals where `t`, else its goals, runs, and whose
    // controls are off; and it set running or not.
    fn goal_running(self, t: bool, i: usize) -> bool {
        return if t { self.targets.running(i) } else { self.goals.running(i) }
    }

    fn goal_disabled(self, t: bool, i: usize) -> bool {
        return if t { self.targets.disabled_for(i) } else { self.goals.disabled_for(i) }
    }

    fn set_goal_running(mut self, t: bool, i: usize, on: bool) {
        if t {
            self.targets.set_running(i, on)
        } else {
            self.goals.set_running(i, on)
        }
    }

    // `WrappedGoal.stop`: the goal at `i`, of its target goals where `t`, stopped where it's
    // running.
    fn stop_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, i: usize, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        if self.goal_running(t, i) {
            self.set_goal_running(t, i, false)
            _ = self.goal(t, i, GOAL_STOP, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
        }
    }

    // The goal at `i` given back, of its target goals where `t`.
    fn put_goal(mut self, t: bool, i: usize, g: own Goal) {
        if t {
            self.targets.put(i, g)
        } else {
            self.goals.put(i, g)
        }
    }

    // The goal at `i`, of its target goals where `t`, asked `call`, its state lent out to its
    // kind's workings and given back: whether it can be used or go on, for those.
    fn goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, t: bool, i: usize, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let taken = if t { self.targets.take(i) } else { self.goals.take(i) }
        let held = taken else return false
        var answer = false
        match held {
            Goal.Float(n) => {
                answer = self.float_goal(call)
                self.put_goal(t, i, Goal.Float(n))
            },
            Goal.SkeletonTrap(n) => {
                answer = self.skeleton_trap_goal(call, players, sounds)
                self.put_goal(t, i, Goal.SkeletonTrap(n))
            },
            Goal.LookAround(g) => {
                var s = g
                answer = self.look_around_goal(mut s, call)
                self.put_goal(t, i, Goal.LookAround(s))
            },
            Goal.LookAtPlayer(g) => {
                var s = g
                // A panda's, `PandaLookAtPlayerGoal` (CAL-201): whom it was set to look at taken
                // up; used as often as it's likely, drawn, finding the nearest player only where
                // it has none to look at, and only while it's free to act.
                if s.panda and self.panda.look_set_given {
                    s.look_at = self.panda.look_set
                    self.panda.look_set_given = false
                }
                if s.panda and call == GOAL_CAN_USE {
                    answer = false
                    if self.living.body.random.next_float() < s.probability {
                        if s.look_at == none {
                            let who = self.looker()
                            var seen = List<Follower>()
                            for p in players {
                                if self.player_rider == none or p.uuid != self.player_rider {
                                    seen.push(p.copy())
                                }
                            }
                            s.look_at = nearest_player(m, f, blocks, mut self.sensing, who, seen, f64(s.distance), who.eye_y, true, 0u32)
                        }
                        answer = self.panda_can_act() and s.look_at != none
                    }
                } else {
                    answer = self.look_at_goal(mut s, call, f, m, blocks, players)
                }
                if self.species == FOX and (call == GOAL_CAN_USE or call == GOAL_CONTINUE) {
                    // `FoxLookAtPlayerGoal` (CAL-201): not while faceplanted or interested.
                    answer = answer and not self.fox_flag(FOX_FACEPLANTED) and not self.fox_flag(FOX_INTERESTED)
                }
                self.put_goal(t, i, Goal.LookAtPlayer(s))
            },
            Goal.GuardianAttack(n) => {
                var s = n
                answer = self.guardian_attack_goal(mut s, call, f, m, blocks, players, sounds.len())
                self.put_goal(t, i, Goal.GuardianAttack(s))
            },
            Goal.GhastFloat(n) => {
                answer = self.ghast_float_goal(call, sounds.len())
                self.put_goal(t, i, Goal.GhastFloat(n))
            },
            Goal.GhastLook(n) => {
                // `GhastLookGoal`: always used, every tick facing where it goes or its target.
                answer = true
                if call == GOAL_TICK {
                    self.ghast_face(players)
                }
                self.put_goal(t, i, Goal.GhastLook(n))
            },
            Goal.GhastShoot(n) => {
                var charge = n
                answer = self.ghast_shoot_goal(mut charge, call, f, m, blocks, players, sounds.len())
                self.put_goal(t, i, Goal.GhastShoot(charge))
            },
            Goal.WitherWait(n) => {
                // `WitherDoNothingGoal.canUse`, which it goes on with as long (CAL-401).
                answer = (call == GOAL_CAN_USE or call == GOAL_CONTINUE) and self.wither_invulnerable() > 0
                self.put_goal(t, i, Goal.WitherWait(n))
            },
            Goal.ShulkerAttack(n) => {
                var time = n
                answer = self.shulker_attack_goal(mut time, call, players, mut sounds)
                self.put_goal(t, i, Goal.ShulkerAttack(time))
            },
            Goal.ShulkerPeek(n) => {
                var time = n
                answer = self.shulker_peek_goal(mut time, call, f, m, blocks, mut sounds)
                self.put_goal(t, i, Goal.ShulkerPeek(time))
            },
            Goal.Towards(g) => {
                var s = g
                answer = self.towards_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.Towards(s))
            },
            Goal.Flower(g) => {
                var s = g
                answer = self.flower_goal(mut s, call, blocks, sounds.len())
                self.put_goal(t, i, Goal.Flower(s))
            },
            Goal.Defend(g) => {
                var s = g
                answer = self.defend_goal(mut s, call, lf, f, m, blocks, players)
                self.put_goal(t, i, Goal.Defend(s))
            },
            Goal.Restrict(g) => {
                var s = g
                answer = self.restrict_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Restrict(s))
            },
            Goal.Stroll(g) => {
                var s = g
                answer = self.stroll_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, sounds.len())
                self.put_goal(t, i, Goal.Stroll(s))
            },
            Goal.EatBlock(g) => {
                var s = g
                answer = self.eat_goal(mut s, call, lf, f, blocks, sounds.len())
                self.put_goal(t, i, Goal.EatBlock(s))
            },
            Goal.Stand(g) => {
                var s = g
                answer = self.stand_goal(mut s, call, mut sounds)
                self.put_goal(t, i, Goal.Stand(s))
            },
            Goal.RunAround(g) => {
                var s = g
                answer = self.run_around_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, mut sounds)
                self.put_goal(t, i, Goal.RunAround(s))
            },
            Goal.Tempt(g) => {
                var s = g
                answer = self.tempt_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.Tempt(s))
            },
            Goal.FollowParent(g) => {
                var s = g
                // A fox's, `FoxFollowParentGoal` (CAL-201): not while it defends, its states cleared
                // as it starts.
                if self.fox_flag(FOX_DEFENDING) and (call == GOAL_CAN_USE or call == GOAL_CONTINUE) {
                    answer = false
                } else {
                    if call == GOAL_START and self.species == FOX {
                        self.fox_clear_states()
                    }
                    answer = self.follow_parent_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                }
                self.put_goal(t, i, Goal.FollowParent(s))
            },
            Goal.Breed(g) => {
                var s = g
                if s.panda and call == GOAL_CAN_USE {
                    answer = self.panda_breeds(mut s, lf, f, m, blocks, mut cache, players, min_y, sounds.len())
                } else {
                    answer = self.breed_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, sounds.len())
                }
                self.put_goal(t, i, Goal.Breed(s))
            },
            Goal.Panic(g) => {
                var s = g
                answer = self.panic_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.Panic(s))
            },
            Goal.Avoid(g) => {
                var s = g
                answer = self.avoid_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.Avoid(s))
            },
            Goal.Sit => {
                answer = self.sit_goal(call, players)
                self.put_goal(t, i, Goal.Sit)
            },
            Goal.FollowOwner(g) => {
                var s = g
                answer = self.follow_owner_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.FollowOwner(s))
            },
            Goal.Beg(g) => {
                var s = g
                answer = self.beg_goal(mut s, call, f, m, blocks, players)
                self.put_goal(t, i, Goal.Beg(s))
            },
            Goal.OcelotAttack(g) => {
                var s = g
                answer = self.ocelot_attack_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, sounds.len())
                self.put_goal(t, i, Goal.OcelotAttack(s))
            },
            Goal.Flock(g) => {
                var s = g
                answer = self.flock_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Flock(s))
            },
            Goal.Nearest(g) => {
                var s = g
                // A bee's, `BeeBecomeAngryTargetGoal` (CAL-177): only while it's angry and hasn't
                // stung, and going on only with a target, its target let go else.
                let bee_can = s.bee and self.angry() and not self.bee_flag(BEE_STUNG)
                if s.bee and call == GOAL_CAN_USE and not bee_can {
                    answer = false
                } else if s.bee and call == GOAL_CONTINUE and not (bee_can and self.target != none) {
                    s.targeting.target_mob = none
                    answer = false
                } else if s.defend {
                    answer = self.fox_defend_goal(mut s, call, lf, f, m, blocks, players)
                    if call == GOAL_START {
                        self.living.play(mut sounds, String("entity.fox.aggro"), 1.0f32, 1.0f32)
                    }
                } else {
                    answer = self.nearest_goal(mut s, call, lf, f, m, blocks, players)
                }
                self.put_goal(t, i, Goal.Nearest(s))
            },
            Goal.HurtBy(g) => {
                var s = g
                // A bee's, `BeeHurtByOtherGoal`, going on only while it's angry (CAL-177).
                if s.bee and call == GOAL_CONTINUE and not self.angry() {
                    answer = false
                } else {
                    answer = self.hurt_by_goal(mut s, call, lf, f, m, blocks, players)
                }
                self.put_goal(t, i, Goal.HurtBy(s))
            },
            Goal.OwnerHurt(g) => {
                var s = g
                answer = self.owner_hurt_goal(mut s, call, lf, f, m, blocks, players)
                self.put_goal(t, i, Goal.OwnerHurt(s))
            },
            Goal.Melee(g) => {
                var s = g
                answer = self.melee_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                if s.bee and (call == GOAL_CAN_USE or call == GOAL_CONTINUE) {
                    // A bee's, `BeeAttackGoal`, only while it's angry and hasn't stung (CAL-177).
                    answer = answer and self.angry() and not self.bee_flag(BEE_STUNG)
                }
                self.put_goal(t, i, Goal.Melee(s))
            },
            Goal.CatRelax(g) => {
                var s = g
                answer = self.cat_relax_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, sounds.len())
                self.put_goal(t, i, Goal.CatRelax(s))
            },
            Goal.Caravan(g) => {
                var c = g
                answer = self.caravan_goal(mut c, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Caravan(c))
            },
            Goal.Panda(k) => {
                answer = self.panda_goal(k, call, lf, f, m, blocks, mut cache, min_y, sounds.len())
                self.put_goal(t, i, Goal.Panda(k))
            },
            Goal.FollowMob(g) => {
                var s = g
                answer = self.follow_mob_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.FollowMob(s))
            },
            Goal.Shoulder(sat) => {
                var s = sat
                answer = self.shoulder_goal(mut s, call, players, sounds.len())
                self.put_goal(t, i, Goal.Shoulder(s))
            },
            Goal.Turtle(g) => {
                var s = g
                answer = self.turtle_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, mut sounds)
                self.put_goal(t, i, Goal.Turtle(s))
            },
            Goal.Fox(k) => {
                answer = self.fox_goal(k, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Fox(k))
            },
            Goal.RaidGarden(g) => {
                var s = g
                answer = self.raid_garden_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, sounds.len())
                self.put_goal(t, i, Goal.RaidGarden(s))
            },
            Goal.CatBlock(g) => {
                var s = g
                answer = self.cat_block_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.CatBlock(s))
            },
            Goal.RemoveBlock(g) => {
                var s = g
                answer = self.remove_block_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, mut sounds)
                self.put_goal(t, i, Goal.RemoveBlock(s))
            },
            Goal.SpearUse(g) => {
                var s = g
                answer = self.spear_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, sounds.len())
                self.put_goal(t, i, Goal.SpearUse(s))
            },
            Goal.Leap(up) => {
                answer = self.leap_goal(call, up, players)
                self.put_goal(t, i, Goal.Leap(up))
            },
            Goal.Freeze(kept) => {
                var froze = kept
                answer = self.freeze_goal(mut froze, call, f, m, blocks, players)
                self.put_goal(t, i, Goal.Freeze(froze))
            },
            Goal.EnderLook(g) => {
                var s = g
                answer = self.ender_look_goal(mut s, call, lf, f, m, blocks, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.EnderLook(s))
            },
            Goal.TakeBlock(n) => {
                answer = self.block_goal(call, true, lf, f, m, blocks, sounds.len())
                self.put_goal(t, i, Goal.TakeBlock(n))
            },
            Goal.LeaveBlock(n) => {
                answer = self.block_goal(call, false, lf, f, m, blocks, sounds.len())
                self.put_goal(t, i, Goal.LeaveBlock(n))
            },
            Goal.CubeFloat(n) => {
                if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                    // `CubeMobFloatGoal`: in water or lava, `isInLiquid`.
                    answer = self.living.body.in_water or self.living.body.in_lava()
                } else if call == GOAL_TICK {
                    if self.living.body.random.next_float() < 0.8f32 {
                        self.jump = true
                    }
                    self.moves.set_wanted_movement(1.2)
                }
                self.put_goal(t, i, Goal.CubeFloat(n))
            },
            Goal.CubeDirection((chosen, next)) => {
                var way = chosen
                var due = next
                if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                    // `CubeMobRandomDirectionGoal`: with no target, on the ground, in a liquid
                    // or levitating.
                    let up = self.living.body.on_ground or self.living.body.in_water or self.living.body.in_lava() or self.living.has_effect(LEVITATION)
                    answer = self.target == none and up
                } else if call == GOAL_TICK {
                    due -= 1
                    if due <= 0 {
                        due = reduced_tick_delay(40 + self.living.body.random.next_int_below(60))
                        way = f32.nearest(f64(self.living.body.random.next_int_below(360)))
                    }
                    self.moves.set_direction(way, false)
                }
                self.put_goal(t, i, Goal.CubeDirection((way, due)))
            },
            Goal.CubeSearch(item) => {
                var at = item
                answer = self.cube_search_goal(mut at, call)
                self.put_goal(t, i, Goal.CubeSearch(at))
            },
            Goal.Banner(g) => {
                var b = g
                answer = self.banner_goal(mut b, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Banner(b))
            },
            Goal.CubeJumping(n) => {
                if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                    // `CubeMobKeepOnJumpingGoal`: unless it rides something (D710).
                    answer = self.living.body.vehicle == none
                } else if call == GOAL_TICK {
                    self.moves.set_wanted_movement(1.0)
                }
                self.put_goal(t, i, Goal.CubeJumping(n))
            },
            Goal.SquidMove(n) => {
                answer = self.squid_move_goal(call)
                self.put_goal(t, i, Goal.SquidMove(n))
            },
            Goal.Dolphin(kind) => {
                answer = self.dolphin_goal(kind, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Dolphin(kind))
            },
            Goal.SquidFlee(ticks) => {
                var n = ticks
                answer = self.squid_flee_goal(mut n, call, f, blocks, players)
                self.put_goal(t, i, Goal.SquidFlee(n))
            },
            Goal.Puff(n) => {
                answer = self.puff_goal(call, players)
                self.put_goal(t, i, Goal.Puff(n))
            },
            Goal.CubeAttack(tired) => {
                var left = tired
                answer = self.cube_attack_goal(mut left, call, players)
                self.put_goal(t, i, Goal.CubeAttack(left))
            },
            Goal.Ranged(g) => {
                var r = g
                answer = self.ranged_goal(mut r, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Ranged(r))
            },
            Goal.HealRaider(cooldown) => {
                if call == GOAL_CAN_USE and cooldown <= 0 {
                    // `NearestHealableRaiderTargetGoal.canUse`: its cooldown out, a coin's toss,
                    // then a raid, which it hasn't.
                    _ = self.living.body.random.next_boolean()
                }
                self.put_goal(t, i, Goal.HealRaider(cooldown))
            },
            Goal.Swell(kept) => {
                var swelling = kept
                answer = self.swell_goal(mut swelling, call, f, m, blocks, players)
                self.put_goal(t, i, Goal.Swell(swelling))
            },
            Goal.Bow(g) => {
                var s = g
                answer = self.bow_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Bow(s))
            },
            Goal.Crossbow(g) => {
                var s = g
                answer = self.crossbow_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Crossbow(s))
            },
            Goal.RestrictSun(n) => {
                answer = self.restrict_sun_goal(call, blocks)
                self.put_goal(t, i, Goal.RestrictSun(n))
            },
            Goal.FleeSun(g) => {
                var s = g
                answer = self.flee_sun_goal(mut s, call, lf, f, m, blocks, mut cache, players, min_y)
                self.put_goal(t, i, Goal.FleeSun(s))
            },
            Goal.ResetAnger(stamp) => {
                var last = stamp
                answer = self.reset_anger_goal(mut last, call, players)
                if call == GOAL_START and self.species == ZOMBIFIED_PIGLIN {
                    // `ResetUniversalAngerTargetGoal(this, true)`'s alerting (CAL-200).
                    self.living.show(Shown.Missing(String("A zombified piglin's universal anger told to those near it, ResetUniversalAngerTargetGoal.alertOthers")), sounds.len())
                }
                self.put_goal(t, i, Goal.ResetAnger(last))
            },
            Goal.ThroughVillage(g) => {
                var s = g
                answer = self.through_village_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.ThroughVillage(s))
            },
            Goal.RaidVillage(g) => {
                var s = g
                answer = self.raid_village_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.RaidVillage(s))
            },
            Goal.Door(g) => {
                var s = g
                answer = self.door_goal(mut s, call, f, blocks, sounds.len())
                self.put_goal(t, i, Goal.Door(s))
            },
            Goal.Celebrate => answer = self.celebrate_goal(call, mut sounds),
            Goal.ToRaid(g) => {
                var s = g
                answer = self.to_raid_goal(mut s, call, lf, f, m, blocks, mut cache, min_y, sounds.len())
                self.put_goal(t, i, Goal.ToRaid(s))
            },
            Goal.HoldGround => {
                answer = self.hold_ground_goal(call, players, mut sounds)
                self.put_goal(t, i, Goal.HoldGround)
            },
            Goal.Patrol(g) => {
                var until = g
                answer = self.patrol_goal(mut until, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Patrol(until))
            },
            Goal.WakeFriends => {
                answer = self.wake_friends_goal(call, lf, f, blocks, sounds.len())
                self.put_goal(t, i, Goal.WakeFriends)
            },
            Goal.ToWater(g) => {
                var s = g
                answer = self.to_water_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.ToWater(s))
            },
            Goal.Beach(g) => {
                var s = g
                answer = self.beach_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.Beach(s))
            },
            Goal.SwimUp(g) => {
                var s = g
                answer = self.swim_up_goal(mut s, call, lf, f, m, blocks, mut cache, min_y)
                self.put_goal(t, i, Goal.SwimUp(s))
            },
            Goal.Bee(kind) => {
                answer = self.bee_goal(kind, call, lf, f, m, blocks, mut cache, min_y, mut sounds)
                self.put_goal(t, i, Goal.Bee(kind))
            },
            Goal.Phantom(kind) => {
                answer = self.phantom_goal(kind, call, f, m, blocks, players, min_y, mut sounds)
                self.put_goal(t, i, Goal.Phantom(kind))
            },
            Goal.Vex(kind) => {
                answer = self.vex_goal(kind, call, lf, f, m, blocks, players, mut sounds)
                self.put_goal(t, i, Goal.Vex(kind))
            },
            Goal.Spell(g) => {
                var s = g
                answer = self.spell_goal(mut s, call, f, m, blocks, players, mut sounds)
                self.put_goal(t, i, Goal.Spell(s))
            },
            Goal.BlazeAttack(g) => {
                var b = g
                answer = self.blaze_goal(mut b, call, lf, f, m, blocks, players, sounds)
                self.put_goal(t, i, Goal.BlazeAttack(b))
            },
            Goal.Later(k) => {
                if k == LATER_JOHNNY and call == GOAL_CAN_USE and self.kept.contains("Johnny") {
                    self.living.show(Shown.Missing(String("Johnny's attacking anything, VindicatorJohnnyAttackGoal")), sounds.len())
                }
                self.put_goal(t, i, Goal.Later(k))
            },
        }
        return answer
    }

    // `Blaze.BlazeAttackGoal` (CAL-200): used with a target alive that it may attack, going on as
    // long; started at its volley's start; stopped no longer charged, `setCharged(false)`, and its
    // target unseen for none. Each tick, a tick less till its next; whether it sees its target,
    // `Sensing.hasLineOfSight`, counting the ticks it hasn't. Within 2 blocks, seen, it hits it
    // every 20 ticks, `doHurtTarget`, which its level deals, and moves to it. Else within its follow
    // range, seen: when it's time, its volley's next step, the first charging it for 60 ticks, the
    // next three 6 ticks apart, then 100 ticks of rest, uncharged; on each of those three, its shot,
    // `blaze_shoots`; and it looks at its target's eyes, 10 degrees a tick. Else, seen in the last
    // 5 ticks, it moves to it.
    fn blaze_goal<B: CollisionBlocks>(mut self, g: mut BlazeAttack, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, sounds: List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let p = self.target_in(players) else return false
            return not p.dead
        }
        if call == GOAL_START {
            g.step = 0
        } else if call == GOAL_STOP {
            self.set_blaze_charged(false)
            g.last_seen = 0
        } else if call == GOAL_TICK {
            g.time -= 1
            let id = self.target else return false
            let p = self.followed(players, id) else return false
            let me = self.looker()
            let sight = sees_player(m, f, blocks, mut self.sensing, me, p)
            if sight {
                g.last_seen = 0
            } else {
                g.last_seen += 1
            }
            let dist = self.distance_sqr_to(p.x, p.y, p.z)
            let follow = self.living.attributes.value(lf.follow_range)
            if dist < 4.0 {
                if not sight {
                    return false
                }
                if g.time <= 0 {
                    g.time = 20
                    let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    self.living.show(Shown.Attack((p.id, ax, ay, az)), sounds.len())
                }
                self.moves.set_wanted(p.x, p.y, p.z, 1.0)
            } else if dist < follow * follow and sight {
                let xd = p.x - self.living.body.x
                let yd = (p.y + f64(p.height) * 0.5) - (self.living.body.y + f64(self.living.body.height) * 0.5)
                let zd = p.z - self.living.body.z
                if g.time <= 0 {
                    g.step += 1
                    if g.step == 1 {
                        g.time = 60
                        self.set_blaze_charged(true)
                    } else if g.step <= 4 {
                        g.time = 6
                    } else {
                        g.time = 100
                        g.step = 0
                        self.set_blaze_charged(false)
                    }
                    if g.step > 1 {
                        self.blaze_shoots(dist, xd, yd, zd, sounds)
                    }
                }
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 10.0f32, 10.0f32)
            } else if g.last_seen < 5 {
                self.moves.set_wanted(p.x, p.y, p.z, 1.0)
            }
        }
        return false
    }

    // A blaze's shot in its volley at what's `dist` squared away along xd, yd, zd (CAL-200): its
    // shot's sound, level event 1018 at its block, unless it's silent; then one small fireball,
    // `new SmallFireball(level, blaze, direction.normalize())`, which its level makes, its way
    // spread across, x then z drawn from its random about them, `triangle`, by 2.297 times half the
    // root of the distance's root, put half a block above its middle.
    fn blaze_shoots(mut self, dist: f64, xd: f64, yd: f64, zd: f64, sounds: List<EntitySound>) {
        let spread = dist.sqrt().sqrt() * 0.5
        if not self.living.silent() {
            let (bx, by, bz) = self.block_position()
            self.living.show(Shown.Level((1018, bx, by, bz, 0)), sounds.len())
        }
        let dx = self.living.body.random.triangle(xd, 2.297 * spread)
        let dz = self.living.body.random.triangle(zd, 2.297 * spread)
        let shot = FireballFired {
            owner: self.living.body.uuid,
            x: self.living.body.x,
            y: self.living.body.y + f64(self.living.body.height) * 0.5 + 0.5,
            z: self.living.body.z,
            xd: dx,
            yd: yd,
            zd: dz,
            yaw: self.living.body.y_rot,
            pitch: self.living.body.x_rot,
            kind: SMALL_FIREBALL,
        }
        self.living.show(Shown.FireballFired(shot), sounds.len())
    }

    // A blaze's flags, `Blaze.DATA_FLAGS_ID`: charged, its first bit, `setCharged` (CAL-200).
    fn set_blaze_charged(mut self, charged: bool) {
        let flags = i32(self.living.data.byte(MONSTER_OWN))
        let next = if charged { flags | 1 } else { flags & -2 }
        self.living.data.set(MONSTER_OWN, Value.Byte(i8.wrap(next)))
    }

    // `Blaze.customServerAiStep` (CAL-200): every 100 ticks how far above it its target may be
    // before it rises, drawn about 0.5 by 6.891, `triangle`; then, with a target it may attack
    // whose eyes are higher than its own by more than that, up toward 0.3 a tick by 0.3 of the
    // way, synced.
    fn blaze_step(mut self, players: List<Follower>) {
        self.blaze_next -= 1
        if self.blaze_next <= 0 {
            self.blaze_next = 100
            self.blaze_offset = f32.nearest(self.living.body.random.triangle(0.5, 6.891))
        }
        let p = self.target_in(players) else return
        if p.y + f64(p.eyes) > self.living.body.y + f64(self.living.body.eyes) + f64(self.blaze_offset) {
            let vy = self.living.body.vy
            self.living.body.vx = self.living.body.vx + 0.0
            self.living.body.vy = vy + (f64(0.3f32) - vy) * f64(0.3f32)
            self.living.body.vz = self.living.body.vz + 0.0
            self.living.body.needs_sync = true
        }
    }

    // `Ghast.RandomFloatAroundGoal` (CAL-200): used where it isn't going anywhere, or where it's
    // going is under a block or more than 60 away; never going on. As it starts, somewhere up to
    // 16 off each way, x, y then z, each drawn as a float, `chooseRandomPosition`, tried up to 64
    // times while it has a home that isn't within it; there, at its own speed.
    fn ghast_float_goal(mut self, call: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            if not self.moves.has_wanted() {
                return true
            }
            let xd = self.moves.wanted_x - self.living.body.x
            let yd = self.moves.wanted_y - self.living.body.y
            let zd = self.moves.wanted_z - self.living.body.z
            let dd = xd * xd + yd * yd + zd * zd
            return dd < 1.0 or dd > 3600.0
        }
        if call == GOAL_CONTINUE {
            return false
        }
        if call == GOAL_START {
            let (cx, cy, cz) = (self.living.body.x, self.living.body.y, self.living.body.z)
            for _ in 0..64 {
                let (x, y, z) = self.float_spot(cx, cy, cz)
                if self.within_home(x, y, z) {
                    self.moves.set_wanted(x, y, z, 1.0)
                    return false
                }
            }
            // Every try out of its home: one more, lowered under the ground where the ground's
            // below it, `Heightmap.Types.MOTION_BLOCKING`, which Calcite doesn't do yet.
            let (x, y, z) = self.float_spot(cx, cy, cz)
            self.living.show(Shown.Missing(String("A ghast's flight lowered under the ground's height, RandomFloatAroundGoal.getSuitableFlyToPosition")), heard)
            self.moves.set_wanted(x, y, z, 1.0)
        }
        return false
    }

    // `RandomFloatAroundGoal.chooseRandomPosition` about x, y, z: up to 16 off each way.
    fn float_spot(mut self, x: f64, y: f64, z: f64) -> (f64, f64, f64) {
        let a = self.living.body.random.next_float()
        let nx = x + f64((a * 2.0f32 - 1.0f32) * 16.0f32)
        let b = self.living.body.random.next_float()
        let ny = y + f64((b * 2.0f32 - 1.0f32) * 16.0f32)
        let c = self.living.body.random.next_float()
        let nz = z + f64((c * 2.0f32 - 1.0f32) * 16.0f32)
        return (nx, ny, nz)
    }

    // `Ghast.faceMovementDirection` (CAL-200): with no target, turned the way it's moving; else,
    // its target within 64 blocks, turned to it, across only; its body with it.
    fn ghast_face(mut self, players: List<Follower>) {
        let deg = 180.0f32 / f32.nearest(3.141592653589793)
        if let p = self.target_in(players) {
            if self.distance_sqr_to(p.x, p.y, p.z) < 4096.0 {
                let xdd = p.x - self.living.body.x
                let zdd = p.z - self.living.body.z
                self.living.body.y_rot = -f32.nearest(table_atan2(xdd, zdd) ?? 0.0) * deg
                self.living.y_body_rot = self.living.body.y_rot
            }
            return
        }
        let (vx, vz) = (self.living.body.vx, self.living.body.vz)
        self.living.body.y_rot = -f32.nearest(table_atan2(vx, vz) ?? 0.0) * deg
        self.living.y_body_rot = self.living.body.y_rot
    }

    // `Ghast.GhastShootFireballGoal` (CAL-200): used while it has a target; its charge 0 as it
    // starts, and uncharging as it stops. Each tick, its target within 64 blocks and in its sight,
    // `hasLineOfSight`: its charge a tick more; at 10 its warning, level event 1015, and at 20 its
    // shot, level event 1016, unless it's silent, a large fireball of its power 4 blocks the way
    // it looks, `getViewVector`, half a block above its middle, toward its target's middle from
    // there, which its level makes, and 40 ticks' rest. Else its charge a tick less down to 0.
    // Charging while its charge is over 10.
    fn ghast_shoot_goal<B: CollisionBlocks>(mut self, charge: mut i32, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, heard: usize) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            return self.target_in(players) != none
        }
        if call == GOAL_START {
            charge = 0
        } else if call == GOAL_STOP {
            self.living.data.set(MONSTER_OWN, Value.Bool(false))
        } else if call == GOAL_TICK {
            let p = self.target_in(players) else return false
            let me = self.looker()
            let near = self.distance_sqr_to(p.x, p.y, p.z) < 4096.0
            if near and sees(m, f, blocks, me.mover, me.x, me.eye_y, me.z, p.x, p.y + f64(p.eyes), p.z) {
                charge += 1
                let (bx, by, bz) = self.block_position()
                if charge == 10 and not self.living.silent() {
                    self.living.show(Shown.Level((1015, bx, by, bz, 0)), heard)
                }
                if charge == 20 {
                    let (vx, _, vz) = view_vector(self.living.body.x_rot, self.living.y_head_rot)
                    let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    let mid = y + f64(self.living.body.height) * 0.5
                    let xdd = p.x - (x + vx * 4.0)
                    let ydd = (p.y + f64(p.height) * 0.5) - (0.5 + mid)
                    let zdd = p.z - (z + vz * 4.0)
                    if not self.living.silent() {
                        self.living.show(Shown.Level((1016, bx, by, bz, 0)), heard)
                    }
                    let shot = FireballFired {
                        owner: self.living.body.uuid,
                        x: x + vx * 4.0,
                        y: mid + 0.5,
                        z: z + vz * 4.0,
                        xd: xdd,
                        yd: ydd,
                        zd: zdd,
                        yaw: self.living.body.y_rot,
                        pitch: self.living.body.x_rot,
                        kind: LARGE_FIREBALL,
                        power: self.ghast_power,
                    }
                    self.living.show(Shown.FireballFired(shot), heard)
                    charge = -40
                }
            } else if charge > 0 {
                charge -= 1
            }
            self.living.data.set(MONSTER_OWN, Value.Bool(charge > 10))
        }
        return false
    }

    // `Ghast.GhastMoveControl.tick`, not careful and never stopped (CAL-200): going somewhere,
    // every few ticks, its next 2 to 6 drawn, `floatDuration`, a push toward there of its flying
    // speed's 5/3 where the way's clear, `canReach`, else waiting.
    fn ghast_moves<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B) {
        if self.moves.operation != MOVE_TO {
            return
        }
        let was = self.float_duration
        self.float_duration -= 1
        if was > 0 {
            return
        }
        self.float_duration = self.float_duration + self.living.body.random.next_int_below(5) + 2
        let tx = self.moves.wanted_x - self.living.body.x
        let ty = self.moves.wanted_y - self.living.body.y
        let tz = self.moves.wanted_z - self.living.body.z
        if not self.ghast_reaches(f, m, blocks, tx, ty, tz) {
            self.moves.set_wait()
            return
        }
        let dist = (tx * tx + ty * ty + tz * tz).sqrt()
        if dist < f64(1.0e-5f32) {
            return
        }
        let s = self.living.attributes.value(lf.flying_speed) * 5.0 / 3.0
        self.living.body.vx = self.living.body.vx + tx / dist * s
        self.living.body.vy = self.living.body.vy + ty / dist * s
        self.living.body.vz = self.living.body.vz + tz / dist * s
    }

    // `GhastMoveControl.canReach` of a move by tx, ty, tz, not careful: each block its box meets
    // on the way, `forEachBlockIntersectedBetween`, but those its box is in already, air, or whose
    // collision shape, `CollisionContext.empty()`, its box moving that way doesn't run into,
    // `collidedWithShapeMovingFrom`.
    fn ghast_reaches<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, tx: f64, ty: f64, tz: f64) -> bool {
        let aabb = self.living.body.bounding_box()
        let dest = Aabb { min_x: aabb.min_x + tx, min_y: aabb.min_y + ty, min_z: aabb.min_z + tz, max_x: aabb.max_x + tx, max_y: aabb.max_y + ty, max_z: aabb.max_z + tz }
        let start = (self.living.body.x, self.living.body.y, self.living.body.z)
        let end = (self.living.body.x + tx, self.living.body.y + ty, self.living.body.z + tz)
        let walked = intersected(start, end, dest)
        let empty = Mover { y: -1.7976931348623157e308, fall: 0.0 }
        for b in walked.met {
            let (x, y, z) = (b.x, b.y, b.z)
            if aabb.intersects(f64(x), f64(y), f64(z), f64(x + 1), f64(y + 1), f64(z + 1)) {
                continue
            }
            let state = blocks.collision_state(x, y, z) ?? 0
            if f.is_air(state) {
                continue
            }
            let boxes = m.boxes_at(f, blocks, state, x, y, z, empty)
            if swept_into(aabb, tx, ty, tz, boxes, x, y, z) {
                return false
            }
        }
        return true
    }

    // `ZombifiedPiglin.customServerAiStep` (CAL-200): angry, grown, 0.05 more speed,
    // `attacking`, and a tick less till its first angry sound, heard at twice its volume and 1.8
    // times its voice's pitch as that runs out; not angry, that speed taken off. Then its anger
    // kept up while it has a target, `updatePersistentAnger`; and with a target, a tick less till
    // it alerts others, and once that's run out, where it sees them, `Sensing.hasLineOfSight`,
    // the zombified piglins near it with none told of them, `alertOthers`, which its level does
    // as `HurtByTargetGoal` alerts, its next alert 4 to 6 seconds off, drawn.
    fn zombified_piglin_step<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, sounds: mut List<EntitySound>) {
        let speed = self.speed_attribute
        let attacking = Identifier { namespace: "minecraft", path: String("attacking") }
        if self.angry() {
            if not self.baby() and not self.living.attributes.has_modifier(speed, attacking) {
                self.living.attributes.replace(speed, Modifier { id: attacking, amount: 0.05, operation: ADD_VALUE })
            }
            if self.first_anger_in > 0 {
                self.first_anger_in -= 1
                if self.first_anger_in == 0 {
                    let pitch = self.voice_pitch() * 1.8f32
                    self.living.play(mut sounds, String("entity.zombified_piglin.angry"), self.sound_volume * 2.0f32, pitch)
                }
            }
        } else if self.living.attributes.has_modifier(speed, attacking) {
            self.living.attributes.take_off(speed, attacking)
        }
        self.update_anger(players, true)
        let p = self.target_in(players) else return
        if self.alert_in > 0 {
            self.alert_in -= 1
            return
        }
        let me = self.looker()
        if sees_player(m, f, blocks, mut self.sensing, me, p) {
            self.alerted = some(p.id)
        }
        self.alert_in = 80 + self.living.body.random.next_int_below(41)
    }

    // A shulker's face it's attached to, `getAttachFace`, by its 3D data value (CAL-200).
    fn shulker_face(self) -> i32 {
        return self.living.data.number(MONSTER_OWN)
    }

    // How far it peeks, `getRawPeekAmount`, in hundredths.
    fn shulker_raw_peek(self) -> i32 {
        return i32(self.living.data.byte(MONSTER_OWN + 1))
    }

    /// A shulker's box and size as its face and peek make them (CAL-200): its box,
    /// `getProgressAabb` of its physical peek toward the way from its face, `makeBoundingBox`; and
    /// attached below and peeking, its height and eyes scaled by 1 and its peek,
    /// `getDefaultDimensions`.
    pub fn shulker_shape(mut self) {
        let face = self.shulker_face()
        self.living.body.own_box = some(progress_box(face ^ 1, -1.0f32, physical_peek(self.shulker_peek)))
        let scale = if face == DOWN and self.shulker_peek > 0.0f32 { 1.0f32 + self.shulker_peek } else { 1.0f32 }
        self.living.body.height = self.height * scale
        self.living.body.eyes = self.eyes * scale
    }

    // `setRawPeekAmount(amount)` (CAL-200): its armor's `covered` 20 taken off, and put back where
    // it closes, heard closing, else heard opening; its peek, synced.
    fn set_shulker_peek(mut self, amount: i32, sounds: mut List<EntitySound>) {
        let armor = attribute("armor")
        let covered = Identifier { namespace: "minecraft", path: String("covered") }
        self.living.attributes.take_off(armor, covered.copy())
        if amount == 0 {
            self.living.attributes.add_permanent(armor, Modifier { id: covered, amount: 20.0, operation: ADD_VALUE })
            self.living.play(mut sounds, String("entity.shulker.close"), 1.0f32, 1.0f32)
        } else {
            self.living.play(mut sounds, String("entity.shulker.open"), 1.0f32, 1.0f32)
        }
        self.living.data.set(MONSTER_OWN + 1, Value.Byte(i8.wrap(amount)))
    }

    // Whether no block's collision shape meets `b`, as `noCollision` finds it for a shulker; the
    // entities that may be collided with, other shulkers, aren't looked at yet.
    fn shulker_room<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, b: Aabb) -> bool {
        let found = m.colliders(f, blocks, b, Mover { y: self.living.body.y, fall: 0.0 })
        for c in found.boxes {
            if c.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                return false
            }
        }
        return true
    }

    // `canStayAt(x, y, z, face)` (CAL-200): its block air, or a moving piston where it is; the
    // block that way loaded with that face's opposite whole, `loadedAndEntityCanStandOnFace`; and
    // room for it fully open from there, `noCollision`.
    fn shulker_can_stay<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, x: i32, y: i32, z: i32, face: i32) -> bool {
        let here = blocks.collision_state(x, y, z) ?? 0
        if not f.is_air(here) {
            let (bx, by, bz) = self.block_position()
            if not (x == bx and y == by and z == bz and f.block_named(String("minecraft:moving_piston")) == some(f.block(here))) {
                return false
            }
        }
        let (sx, sy, sz) = (step_x(face), step_y(face), step_z(face))
        let on = blocks.collision_state(x + sx, y + sy, z + sz) else return false
        if not f.collision_face_full(on, face ^ 1) {
            return false
        }
        let (x0, y0, z0, x1, y1, z1) = progress_box(face ^ 1, -1.0f32, 1.0f32)
        let (cx, cz) = (f64(x) + 0.5, f64(z) + 0.5)
        let e = 1.0e-6
        let b = Aabb { min_x: cx + x0 + e, min_y: f64(y) + y0 + e, min_z: cz + z0 + e, max_x: cx + x1 - e, max_y: f64(y) + y1 - e, max_z: cz + z1 - e }
        return self.shulker_room(f, m, blocks, b)
    }

    // `findAttachableSurface(x, y, z)`: the first face, down, up, north, south, west then east, it
    // could stay on there.
    fn shulker_surface<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, x: i32, y: i32, z: i32) -> i32? {
        for d in 0..6 {
            if self.shulker_can_stay(f, m, blocks, x, y, z, d) {
                return some(d)
            }
        }
        return none
    }

    // `teleportSomewhere` (CAL-200): thinking and alive, up to 5 tries of a block up to 8 off each
    // way, x, y then z, drawn, `randomBetweenInclusive`; above the world's bottom, air, with room
    // for a block, and a face it could stay on whose block isn't
    // `#shulker_does_not_teleport_to`: there, attached so, heard teleporting, its peek none,
    // level event 2016 at where it was with the way it went packed, and no target. The world
    // border's taken to hold it.
    fn shulker_teleport<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if self.no_ai() or not self.living.alive() {
            return false
        }
        let (ox, oy, oz) = self.block_position()
        for _ in 0..5 {
            let tx = ox + self.living.body.random.next_int_below(17) - 8
            let ty = oy + self.living.body.random.next_int_below(17) - 8
            let tz = oz + self.living.body.random.next_int_below(17) - 8
            if ty <= min_y {
                continue
            }
            let st = blocks.collision_state(tx, ty, tz) else continue
            if not f.is_air(st) {
                continue
            }
            let e = 1.0e-6
            let room = Aabb { min_x: f64(tx) + e, min_y: f64(ty) + e, min_z: f64(tz) + e, max_x: f64(tx + 1) - e, max_y: f64(ty + 1) - e, max_z: f64(tz + 1) - e }
            if not self.shulker_room(f, m, blocks, room) {
                continue
            }
            let d = self.shulker_surface(f, m, blocks, tx, ty, tz) else continue
            let (sx, sy, sz) = (step_x(d), step_y(d), step_z(d))
            let on = blocks.collision_state(tx + sx, ty + sy, tz + sz) ?? 0
            if f.in_set(on, f.tag(String("minecraft:shulker_does_not_teleport_to"))) {
                continue
            }
            if self.living.body.vehicle != none {
                self.living.show(Shown.Missing(String("A shulker teleporting off what it rides, unRide")), sounds.len())
            }
            self.living.data.set(MONSTER_OWN, Value.Number(d))
            self.living.play(mut sounds, String("entity.shulker.teleport"), 1.0f32, 1.0f32)
            self.living.body.x = f64(tx) + 0.5
            self.living.body.y = f64(ty)
            self.living.body.z = f64(tz) + 0.5
            self.living.body.needs_sync = true
            let packed = ((tx - ox + 8) & 255) << 16 | ((ty - oy + 8) & 255) << 8 | ((tz - oz + 8) & 255)
            self.living.show(Shown.Level((2016, ox, oy, oz, packed)), sounds.len())
            self.living.data.set(MONSTER_OWN + 1, Value.Byte(0i8))
            self.shulker_shape()
            self.target_to(none)
            return true
        }
        return false
    }

    // `Shulker.tick`'s, after the rest (CAL-200): riding nothing, where it can't stay on its face
    // where it is, the first face it can, else somewhere else, `findNewAttachment`; then its peek
    // eased a twentieth a tick toward its raw peek, `updatePeekAmount`, and where it changed, its
    // box and size made again, `onPeekAmountChange`. A player in the way it opens into would be
    // pushed, which is said missing.
    fn shulker_tick_end<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) {
        if self.living.body.vehicle == none {
            let (bx, by, bz) = self.block_position()
            if not self.shulker_can_stay(f, m, blocks, bx, by, bz, self.shulker_face()) {
                if let d = self.shulker_surface(f, m, blocks, bx, by, bz) {
                    self.living.data.set(MONSTER_OWN, Value.Number(d))
                    self.shulker_shape()
                } else {
                    _ = self.shulker_teleport(f, m, blocks, min_y, mut sounds)
                }
            }
        }
        self.shulker_peek_o = self.shulker_peek
        let wanted = f32.nearest(f64(self.shulker_raw_peek())) * 0.01f32
        if self.shulker_peek == wanted {
            return
        }
        if self.shulker_peek > wanted {
            self.shulker_peek = clamp(self.shulker_peek - 0.05f32, wanted, 1.0f32)
        } else {
            self.shulker_peek = clamp(self.shulker_peek + 0.05f32, 0.0f32, wanted)
        }
        self.shulker_shape()
        let now = physical_peek(self.shulker_peek)
        let before = physical_peek(self.shulker_peek_o)
        if now - before > 0.0f32 {
            let (x0, y0, z0, x1, y1, z1) = progress_box(self.shulker_face() ^ 1, before, now)
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            for p in players {
                if not p.spectator and p.x + 0.3 > x + x0 and p.x - 0.3 < x + x1 and p.y + f64(p.height) > y + y0 and p.y < y + y1 and p.z + 0.3 > z + z0 and p.z - 0.3 < z + z1 {
                    self.living.show(Shown.Missing(String("A player pushed by a shulker opening, onPeekAmountChange")), sounds.len())
                }
            }
        }
    }

    // `ShulkerAttackGoal` (CAL-200): used while its target's alive, out of peaceful; open all the
    // way as it starts, its first shot in 20 ticks, and closed as it stops. Each tick out of
    // peaceful, a tick less; looking at its target's eyes, 180 degrees a tick; within 20 blocks,
    // once that's run out, its next in 20 to 110 ticks, drawn, its bullet, which Calcite doesn't
    // make yet, said missing, heard shot at 2; further off, its target let go.
    fn shulker_attack_goal(mut self, time: mut i32, call: i32, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let p = self.target_in(players) else return false
            return not p.dead and self.difficulty != 0
        }
        if call == GOAL_START {
            time = 20
            self.set_shulker_peek(100, mut sounds)
        } else if call == GOAL_STOP {
            self.set_shulker_peek(0, mut sounds)
        } else if call == GOAL_TICK and self.difficulty != 0 {
            time -= 1
            let p = self.target_in(players) else return false
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 180.0f32, 180.0f32)
            if self.distance_sqr_to(p.x, p.y, p.z) < 400.0 {
                if time <= 0 {
                    time = 20 + self.living.body.random.next_int_below(10) * 20 / 2
                    // Its bullet from the middle of its box, at its target, not first along its
                    // face's axis, `new ShulkerBullet`, which its level makes (D774).
                    let bb = self.living.body.bounding_box()
                    let face = self.shulker_face()
                    let axis = if face < 2 { 1 } else if face < 4 { 2 } else { 0 }
                    if let uuid = p.uuid {
                        let shot = FireballFired {
                            owner: self.living.body.uuid,
                            x: (bb.min_x + bb.max_x) / 2.0,
                            y: (bb.min_y + bb.max_y) / 2.0,
                            z: (bb.min_z + bb.max_z) / 2.0,
                            xd: 0.0,
                            yd: 0.0,
                            zd: 0.0,
                            yaw: 0.0f32,
                            pitch: 0.0f32,
                            kind: SHULKER_BULLET,
                            target: some(uuid),
                            homing: some(Homing { id: p.id, x: p.x, y: p.y, z: p.z, height: p.height, alive: not p.dead }),
                            avoid: axis,
                        }
                        self.living.show(Shown.FireballFired(shot), sounds.len())
                    }
                    let a = self.living.body.random.next_float()
                    let b = self.living.body.random.next_float()
                    self.living.play(mut sounds, String("entity.shulker.shoot"), 2.0f32, (a - b) * 0.2f32 + 1.0f32)
                }
            } else {
                self.target_to(none)
            }
        }
        return false
    }

    // `ShulkerPeekGoal` (CAL-200): used with no target, one in 20 of its full ticks, drawn, where
    // it can stay on its face; going on with none while it has time left. As it starts, 20 to 60
    // ticks of it, halved, drawn, and a third open; as it stops with no target, closed. Each tick,
    // a tick less.
    fn shulker_peek_goal<B: CollisionBlocks>(mut self, time: mut i32, call: i32, f: Facts, m: MovementStates, blocks: B, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            if self.target != none or self.living.body.random.next_int_below(reduced_tick_delay(40)) != 0 {
                return false
            }
            let (bx, by, bz) = self.block_position()
            return self.shulker_can_stay(f, m, blocks, bx, by, bz, self.shulker_face())
        }
        if call == GOAL_CONTINUE {
            return self.target == none and time > 0
        }
        if call == GOAL_START {
            time = reduced_tick_delay(20 * (1 + self.living.body.random.next_int_below(3)))
            self.set_shulker_peek(30, mut sounds)
        } else if call == GOAL_STOP {
            if self.target == none {
                self.set_shulker_peek(0, mut sounds)
            }
        } else if call == GOAL_TICK {
            time -= 1
        }
        return false
    }

    // `ShulkerLookControl.getYRotD` (CAL-200): where it's wanted to look, from its eyes, along the
    // way its face's opposite turns south, `forward`, and across that and up from its face,
    // `right`, in floats; where either's more than a hair, the turn of that, degrees.
    fn shulker_y_rot_d(self) -> f32? {
        let up = self.shulker_face() ^ 1
        let pi = f32.nearest(3.141592653589793)
        let half = f32.nearest(3.141592653589793 / 2.0)
        let q = if up == DOWN { Quatf.rotation_x(pi) } else if up == UP { Quatf.identity() } else if up == NORTH { Quatf.rotation_xyz(half, 0.0f32, pi) } else if up == SOUTH { Quatf.rotation_x(half) } else if up == WEST { Quatf.rotation_xyz(half, 0.0f32, half) } else { Quatf.rotation_xyz(half, 0.0f32, f32.nearest(-3.141592653589793 / 2.0)) }
        let forward = q.transform(Vec3f { x: 0.0f32, y: 0.0f32, z: 1.0f32 })
        let (ux, uy, uz) = (step_x(up), step_y(up), step_z(up))
        let right = Vec3f { x: f32.nearest(f64(ux)), y: f32.nearest(f64(uy)), z: f32.nearest(f64(uz)) }.cross(forward)
        let (wx, wy, wz) = self.look.wanted()
        let eye = self.living.body.y + f64(self.living.body.eyes)
        let out = Vec3f { x: f32.nearest(wx - self.living.body.x), y: f32.nearest(wy - eye), z: f32.nearest(wz - self.living.body.z) }
        let dr = right.dot(out)
        let df = forward.dot(out)
        if not (dr.abs() > 1.0e-5f32) and not (df.abs() > 1.0e-5f32) {
            return none
        }
        let angle = table_atan2(f64(-dr), f64(df)) ?? 0.0
        return some(f32.nearest(angle * RAD_TO_DEG))
    }

    // `getTarget` (CAL-159): its target where it's among `players`, or its prey (CAL-244), and
    // still one, `asValidTarget`, as `valid_target` has it.
    fn target_in(self, players: List<Follower>) -> Follower? {
        let id = self.target else return none
        let who = self.followed(players, id) else return none
        return valid_target([who], id)
    }

    // `setTarget` of `id` (CAL-159): it, where it's a valid target among `players` or its prey
    // (CAL-244), else none.
    fn set_target(mut self, id: i32?, players: List<Follower>) {
        var next: i32? = none
        if let who = id {
            if let p = self.followed(players, who) {
                if valid_target([p], who) != none {
                    next = some(who)
                }
            }
        }
        self.target_to(next)
    }

    // `setTarget` of `id`, as it is (CAL-159): an enderman's own, `Enderman.setTarget`, its tick
    // count then kept, creepy, its attacking speed on, where it has a target; else none of it.
    fn target_to(mut self, id: i32?) {
        if id == none and self.fox_flag(FOX_DEFENDING) {
            // `Fox.setTarget` of none: no longer defending (CAL-201).
            self.set_fox_flag(FOX_DEFENDING, false)
        }
        if self.species == ZOMBIFIED_PIGLIN and self.target == none and id != none {
            // `ZombifiedPiglin.setTarget`, taking one up from none (CAL-200): its first angry
            // sound 0 to 1 seconds off, and its next alert 4 to 6, drawn.
            self.first_anger_in = self.living.body.random.next_int_below(21)
            self.alert_in = 80 + self.living.body.random.next_int_below(41)
        }
        self.target = id
        if self.species != ENDERMAN {
            return
        }
        let speed = self.speed_attribute
        let attacking = Identifier { namespace: "minecraft", path: String("attacking") }
        if id == none {
            self.target_change_time = 0
            self.living.data.set(MONSTER_OWN + 1, Value.Bool(false))
            self.living.data.set(MONSTER_OWN + 2, Value.Bool(false))
            self.living.attributes.take_off(speed, attacking)
        } else {
            self.target_change_time = self.living.body.tick_count
            self.living.data.set(MONSTER_OWN + 1, Value.Bool(true))
            if not self.living.attributes.has_modifier(speed, attacking) {
                self.living.attributes.replace(speed, Modifier { id: attacking, amount: f64(0.15f32), operation: ADD_VALUE })
            }
        }
    }

    // `getLastHurtByMob` (CAL-159): who last hurt it, `lastHurtByMob`, where they're among
    // `players`, or its prey, the mobs near it (CAL-244), by their UUID, `EntityReference`.
    fn hurt_by_in(self, players: List<Follower>) -> Follower? {
        let uuid = self.living.hurt_by_mob else return none
        for p in players {
            if p.uuid == some(uuid) {
                return some(p.copy())
            }
        }
        for p in self.prey {
            if p.uuid == some(uuid) {
                return some(p.copy())
            }
        }
        return none
    }

    // `TargetGoal.canContinueToUse` of the target goal `g` (CAL-159): its target, or the one the
    // goal took up where it has none, where it may attack them, `canAttack`, within its follow
    // range, and, where it must see them, seen, or unseen for no more of its ticks than half its
    // memory's, `reducedTickDelay`; then its target again, `setTarget`. No teams, so none are
    // allied.
    fn targeting_continues<B: CollisionBlocks>(mut self, g: mut Targeting, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        var who = self.target_in(players)
        if who == none {
            if let id = g.target_mob {
                who = self.followed(players, id)
            }
        }
        let p = who else return false
        if p.spectator or p.dead or not p.enemy or self.golem_refuses(p) {
            return false
        }
        let within = self.living.attributes.value(lf.follow_range) * g.scale
        if self.distance_sqr_to(p.x, p.y, p.z) > within * within {
            return false
        }
        if g.must_see {
            let me = self.looker()
            if sees_player(m, f, blocks, mut self.sensing, me, p) {
                g.unseen_ticks = 0
            } else {
                g.unseen_ticks += 1
                if g.unseen_ticks > reduced_tick_delay(g.unseen_memory) {
                    return false
                }
            }
        }
        self.set_target(some(p.id), players)
        return true
    }

    // A vex's goals (CAL-200), `call` the goal's call:
    // - `VexChargeAttackGoal`: with a target alive, not moving to where it's wanted, 1 in 4,
    //   drawn, `reducedTickDelay(7)`, and its target more than 2 off. As it starts, its target's
    //   eyes wanted at its speed, charging, heard. It goes on moving to where it's wanted,
    //   charging, its target alive. Each tick, its box meeting its target's, its blow,
    //   `doHurtTarget`, which its level deals, and no longer charging; else, within 3, its
    //   target's eyes wanted again. As it stops, no longer charging.
    // - `VexRandomMoveGoal`: not moving to where it's wanted, 1 in 4, drawn; for a tick, of 3 tries
    //   a block within 7 across and 5 up or down of where it's bound, or of its own block where it
    //   isn't, drawn x, y then z, the first that's air, its middle wanted at a quarter of its speed
    //   and, without a target, looked at, 180 and 20 degrees a tick.
    // - `VexCopyOwnerTargetGoal`, a `TargetGoal` that needn't see: its owner's target where it has
    //   one, not itself, alive, no spectator, within its home, with `forNonCombat()`, which it may
    //   not attack, taken up as it starts, `setTarget`; going on as a target goal does; none as it
    //   stops.
    fn vex_goal<B: CollisionBlocks>(mut self, kind: i32, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        if kind == VEX_CHARGE {
            if call == GOAL_CAN_USE {
                let p = self.target_in(players) else return false
                if p.dead or self.moves.has_wanted() or self.living.body.random.next_int_below(reduced_tick_delay(7)) != 0 {
                    return false
                }
                return self.distance_sqr_to(p.x, p.y, p.z) > 4.0
            }
            if call == GOAL_CONTINUE {
                let p = self.target_in(players) else return false
                return self.moves.has_wanted() and self.vex_charging() and not p.dead
            }
            if call == GOAL_START {
                if let p = self.target_in(players) {
                    self.moves.set_wanted(p.x, p.y + f64(p.eyes), p.z, 1.0)
                }
                self.set_vex_charging(true)
                self.living.play(mut sounds, String("entity.vex.charge"), 1.0f32, 1.0f32)
            } else if call == GOAL_STOP {
                self.set_vex_charging(false)
            } else if call == GOAL_TICK {
                if let p = self.target_in(players) {
                    let half = 0.3
                    let theirs = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
                    let mine = self.living.body.bounding_box()
                    if mine.intersects(theirs.min_x, theirs.min_y, theirs.min_z, theirs.max_x, theirs.max_y, theirs.max_z) {
                        let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                        self.living.show(Shown.Attack((p.id, ax, ay, az)), sounds.len())
                        self.set_vex_charging(false)
                    } else if self.distance_sqr_to(p.x, p.y, p.z) < 9.0 {
                        self.moves.set_wanted(p.x, p.y + f64(p.eyes), p.z, 1.0)
                    }
                }
            }
            return false
        }
        if kind == VEX_RANDOM_MOVE {
            if call == GOAL_CAN_USE {
                return not self.moves.has_wanted() and self.living.body.random.next_int_below(reduced_tick_delay(7)) == 0
            }
            if call == GOAL_TICK {
                let (ox, oy, oz) = self.vex_bound ?? self.block_position()
                for _ in 0..3 {
                    let x = ox + self.living.body.random.next_int_below(15) - 7
                    let y = oy + self.living.body.random.next_int_below(11) - 5
                    let z = oz + self.living.body.random.next_int_below(15) - 7
                    if f.is_air(state_at(blocks, x, y, z)) {
                        let (wx, wy, wz) = (f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)
                        self.moves.set_wanted(wx, wy, wz, 0.25)
                        if self.target == none {
                            self.look.set_look_at(wx, wy, wz, 180.0f32, 20.0f32)
                        }
                        break
                    }
                }
            }
            return false
        }
        if kind == VEX_COPY_OWNER {
            if call == GOAL_CAN_USE {
                let t = self.owner_target else return false
                let p = self.followed(players, t) else return false
                return p.id != self.living.body.id and not p.spectator and not p.dead and self.within_home(p.x, p.y, p.z)
            }
            if call == GOAL_CONTINUE {
                var g = Targeting { must_see: false }
                return self.targeting_continues(mut g, lf, f, m, blocks, players)
            }
            if call == GOAL_START {
                if let t = self.owner_target {
                    self.set_target(some(t), players)
                }
            } else if call == GOAL_STOP {
                self.target_to(none)
            }
        }
        return false
    }

    // A spellcaster's spell goal `g` (CAL-200). `SpellcasterCastingSpellGoal`, an evoker's
    // `EvokerCastingSpellGoal`: used while it's casting, stopping its navigation as it starts, its
    // spell none as it stops, `setIsCastingSpell(NONE)`, and looking at its target as it ticks, or
    // the sheep it means to turn red. A `SpellcasterUseSpellGoal`: used with a target alive, not
    // casting, from the tick it may cast again; going on while that target's alive and it's still
    // to cast; started with its ticks till it casts, halved, `adjustedTickDelay`, its ticks casting
    // and the tick it may cast again from set, the spell's prepare sound played, and the spell set,
    // `setIsCastingSpell`; and ticked down to its cast, `performSpellCasting`, and the cast's sound,
    // `getCastingSoundEvent`. Summoning vexes is used only where a draw of 8 is more than the vexes
    // within 16; wololo's, `EvokerWololoSpellGoal`, its own, `wololo_can_use`.
    fn spell_goal<B: CollisionBlocks>(mut self, g: mut Spell, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        if g.kind == SPELL_CASTING {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                return self.spell_ticks > 0
            }
            if call == GOAL_START {
                self.navigation.stop()
            } else if call == GOAL_STOP {
                self.set_spell(0)
            } else if call == GOAL_TICK {
                var looked: Follower? = self.target_in(players)
                if looked == none {
                    if let w = self.wololo {
                        looked = self.followed(players, w)
                    }
                }
                if let p = looked {
                    let (y_most, x_most) = (self.max_head_y_rot(), self.max_head_x_rot())
                    self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, y_most, x_most)
                }
            }
            return false
        }
        if call == GOAL_CAN_USE {
            if g.kind == SPELL_WOLOLO {
                return self.wololo_can_use(g, f, m, blocks)
            }
            let p = self.target_in(players) else return false
            if p.dead or self.spell_ticks > 0 or self.living.body.tick_count < g.next {
                return false
            }
            if g.kind == SPELL_SUMMON {
                let vexes = self.vexes_near()
                return self.living.body.random.next_int_below(8) + 1 > vexes
            }
            return true
        }
        if call == GOAL_CONTINUE {
            if g.kind == SPELL_WOLOLO {
                return self.wololo != none and g.warmup > 0
            }
            let p = self.target_in(players) else return false
            return not p.dead and g.warmup > 0
        }
        if call == GOAL_START {
            let (warmup, casting, interval, prepare) = spell_times(g.kind)
            g.warmup = reduced_tick_delay(warmup)
            self.spell_ticks = casting
            g.next = self.living.body.tick_count + interval
            self.living.play(mut sounds, String(prepare), 1.0f32, 1.0f32)
            self.set_spell(g.kind)
        } else if call == GOAL_STOP {
            if g.kind == SPELL_WOLOLO {
                self.wololo = none
            }
        } else if call == GOAL_TICK {
            g.warmup -= 1
            if g.warmup == 0 {
                if g.kind == SPELL_FANGS {
                    if let p = self.target_in(players) {
                        let cast = self.fangs_toward(p, f, m, blocks)
                        let me = self.living.body.uuid
                        self.living.show(Shown.Fangs((me, cast)), sounds.len())
                    }
                } else if g.kind == SPELL_SUMMON {
                    let summoned = self.vexes_summoned()
                    let me = self.living.body.uuid
                    self.living.show(Shown.Summoned((me, summoned)), sounds.len())
                } else if let w = self.wololo {
                    self.living.show(Shown.Wololo(w), sounds.len())
                }
                self.living.play(mut sounds, String("entity.evoker.cast_spell"), 1.0f32, 1.0f32)
            }
        }
        return false
    }

    // A spellcaster casting the spell `kind`, by its ID, none for 0, `setIsCastingSpell`
    // (CAL-200): its spell's data, after `Raider`'s.
    fn set_spell(mut self, kind: i32) {
        self.living.data.set(MONSTER_OWN + 1, Value.Byte(i8.wrap(kind)))
    }

    // `EvokerWololoSpellGoal.canUse` (CAL-200): with no target, not casting, from the tick it may
    // cast again, mob griefing on, and a blue sheep in its box grown 16 across and 4 up and down,
    // `getNearbyEntities` with `forNonCombat().range(16)`, seen: the sheep it means to turn red,
    // drawn among them, `wololoTarget`.
    fn wololo_can_use<B: CollisionBlocks>(mut self, g: Spell, f: Facts, m: MovementStates, blocks: B) -> bool {
        if self.target != none or self.spell_ticks > 0 or self.living.body.tick_count < g.next or not self.mob_griefing {
            return false
        }
        let b = self.living.body.bounding_box()
        let near = Aabb { min_x: b.min_x - 16.0, min_y: b.min_y - 4.0, min_z: b.min_z - 16.0, max_x: b.max_x + 16.0, max_y: b.max_y + 4.0, max_z: b.max_z + 16.0 }
        let me = self.looker()
        var blue = List<i32>()
        for p in self.prey {
            if p.species != SHEEP or p.dead or p.color != BLUE_WOOL or p.id == me.id {
                continue
            }
            let half = f64(p.width) / 2.0
            let pb = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
            if not pb.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
                continue
            }
            let range = 16.0 * p.visibility(me.kind)
            let within = if range > 2.0 { range } else { 2.0 }
            if self.distance_sqr_to(p.x, p.y, p.z) > within * within {
                continue
            }
            if not sees_player(m, f, blocks, mut self.sensing, me, p) {
                continue
            }
            blue.push(p.id)
        }
        if blue.is_empty() {
            return false
        }
        self.wololo = some(blue[usize.wrap(self.living.body.random.next_int_below(i32.wrap(blue.len())))])
        return true
    }

    // The vexes an evoker counts as it'd summon more (CAL-200), `getNearbyEntities` with
    // `forNonCombat().range(16).ignoreLineOfSight().ignoreInvisibilityTesting()`: those alive in
    // its box grown 16 within 16 of it.
    fn vexes_near(self) -> i32 {
        let b = self.living.body.bounding_box()
        var n = 0
        for p in self.prey {
            if p.species != VEX or p.dead {
                continue
            }
            let half = f64(p.width) / 2.0
            let pb = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
            if not pb.intersects(b.min_x - 16.0, b.min_y - 16.0, b.min_z - 16.0, b.max_x + 16.0, b.max_y + 16.0, b.max_z + 16.0) {
                continue
            }
            if self.distance_sqr_to(p.x, p.y, p.z) <= 256.0 {
                n += 1
            }
        }
        return n
    }

    // `EvokerSummonSpellGoal.performSpellCasting`'s draws (CAL-200): three vexes, each at its block
    // and 1 up, each way across within 2, drawn, then its life, 30 to 119 seconds in ticks, drawn
    // from its random; which its level makes, `evoker_summons`.
    fn vexes_summoned(mut self) -> List<(i32, i32, i32, i32)> {
        let (bx, by, bz) = self.block_position()
        var out = List<(i32, i32, i32, i32)>()
        for _ in 0..3 {
            let ox = -2 + self.living.body.random.next_int_below(5)
            let oz = -2 + self.living.body.random.next_int_below(5)
            let life = 20 * (30 + self.living.body.random.next_int_below(90))
            out.push((bx + ox, by + 1, bz + oz, life))
        }
        return out
    }

    // `EvokerAttackSpellGoal.performSpellCasting` toward `p` (CAL-200): the fangs it casts, from
    // between its feet's and its target's lower, to a block over their higher, turned toward its
    // target, `Mth.atan2`, in floats; within 3, five about it 1.5 off, a fifth of a turn apart,
    // then eight 2.5 off, an eighth apart, beginning two fifths on, 3 ticks later; else sixteen in
    // a line toward its target, 1.25 apart, each a tick later than the last, each where
    // `fangs_at` finds a floor.
    fn fangs_toward<B: CollisionBlocks>(self, p: Follower, f: Facts, m: MovementStates, blocks: B) -> List<(f64, f64, f64, f32, i32)> {
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        let min_y = if p.y < y { p.y } else { y }
        let max_y = (if p.y > y { p.y } else { y }) + 1.0
        let toward = f32.nearest(table_atan2(p.z - z, p.x - x) ?? 0.0)
        let pi = 3.1415927f32
        var out = List<(f64, f64, f64, f32, i32)>()
        if self.distance_sqr_to(p.x, p.y, p.z) < 9.0 {
            for i in 0..5 {
                let angle = toward + f32.nearest(i) * pi * 0.4f32
                fangs_at(f, m, blocks, x + f64(table_cos(f64(angle))) * 1.5, z + f64(table_sin(f64(angle))) * 1.5, min_y, max_y, angle, 0, mut out)
            }
            for i in 0..8 {
                let angle = toward + f32.nearest(i) * pi * 2.0f32 / 8.0f32 + 1.2566371f32
                fangs_at(f, m, blocks, x + f64(table_cos(f64(angle))) * 2.5, z + f64(table_sin(f64(angle))) * 2.5, min_y, max_y, angle, 3, mut out)
            }
        } else {
            for i in 0..16 {
                let reach = 1.25 * f64(i + 1)
                fangs_at(f, m, blocks, x + f64(table_cos(f64(toward))) * reach, z + f64(table_sin(f64(toward))) * reach, min_y, max_y, toward, i, mut out)
            }
        }
        return out
    }

    // Whether a vex is charging, its flags' first bit, `isCharging` (CAL-200).
    fn vex_charging(self) -> bool {
        return i32(self.living.data.byte(MONSTER_OWN)) & 1 != 0
    }

    // A vex charging or not, `setIsCharging` (CAL-200).
    fn set_vex_charging(mut self, on: bool) {
        let flags = i32(self.living.data.byte(MONSTER_OWN))
        self.living.data.set(MONSTER_OWN, Value.Byte(i8.wrap(if on { flags | 1 } else { flags & -2 })))
    }

    // `VexMoveControl.tick` (CAL-200): moving to where it's wanted, within its box's size there,
    // the mean of its sides, waiting, its motion halved; else its motion that way by its speed a
    // twentieth over the distance, and turned the way it moves, or toward its target where it has
    // one, in floats, its body with it.
    fn vex_moves(mut self, players: List<Follower>) {
        if self.moves.operation != MOVE_TO {
            return
        }
        let dx = self.moves.wanted_x - self.living.body.x
        let dy = self.moves.wanted_y - self.living.body.y
        let dz = self.moves.wanted_z - self.living.body.z
        let length = (dx * dx + dy * dy + dz * dz).sqrt()
        let b = self.living.body.bounding_box()
        let size = (b.max_x - b.min_x + (b.max_y - b.min_y) + (b.max_z - b.min_z)) / 3.0
        if length < size {
            self.moves.operation = MOVE_WAIT
            self.living.body.vx = self.living.body.vx * 0.5
            self.living.body.vy = self.living.body.vy * 0.5
            self.living.body.vz = self.living.body.vz * 0.5
            return
        }
        let k = self.moves.speed_modifier * 0.05 / length
        self.living.body.vx = self.living.body.vx + dx * k
        self.living.body.vy = self.living.body.vy + dy * k
        self.living.body.vz = self.living.body.vz + dz * k
        var (ax, az) = (self.living.body.vx, self.living.body.vz)
        if let id = self.target {
            if let p = self.followed(players, id) {
                ax = p.x - self.living.body.x
                az = p.z - self.living.body.z
            }
        }
        let angle = f32.nearest(table_atan2(ax, az) ?? 0.0)
        self.living.body.y_rot = -angle * (180.0f32 / 3.1415927f32)
        self.living.y_body_rot = self.living.body.y_rot
    }

    // A phantom's goal of the kind `kind` asked `call` (CAL-200), its state its own, `phantom`.
    //
    // - `PhantomAttackStrategyGoal`: used and going on while it has a target it may attack,
    //   `canAttack` with `TargetingConditions.DEFAULT`, `phantom_may_attack`. As it starts, 5
    //   ticks till it swoops, `adjustedTickDelay(10)`, circling, and the block it circles moved
    //   above its target, `setAnchorAboveTarget`; as it stops, that block moved to 10 to 29 above
    //   the top of its column, `MOTION_BLOCKING`. Each tick circling, a tick less, and at 0 it
    //   swoops, the block moved above its target, 80 to 110 ticks till it swoops again, halved,
    //   and its swoop heard, 10 loud.
    // - `PhantomSweepAttackGoal`: used while it swoops at a target, going on while that's alive,
    //   no spectator nor in creative, and it swoops, and while it isn't scared of cats: once a
    //   second, `catSearchTick`, it looks for live cats whose boxes meet its own grown by 16, among
    //   the mobs it gathers while it swoops, each of which hisses, `Cat.hiss`, as its level has it
    //   do, `Told.Hiss`, and it's scared of cats while there were any, `isScaredOfCat` (CAL-201). Each tick it flies at its target's middle, and
    //   where its box a fifth larger meets theirs it bites them, `doHurtTarget`, which its level
    //   deals, and circles, its bite heard, level event 1039, unless it's silent; else where it
    //   flew into a wall or was hurt, `wasHurtRecently`, it circles. As it stops, its target's
    //   gone and it circles.
    // - `PhantomCircleAroundAnchorGoal`: used with no target or circling. As it starts, 5 to 15
    //   out, -4 to 5 up and a way round drawn, and its next place chosen, `selectNext`. Each tick,
    //   1 in 175 its height drawn again; 1 in 125 a block farther out, back to 5 the other way
    //   round past 15; 1 in 225 its angle drawn and its next place chosen; within 2 of where it
    //   flies, its next place chosen; flying down with a block under it, 1 up at least, and up
    //   with one over it, 1 down at least, each its next place chosen.
    // - `PhantomAttackPlayerTargetGoal`: every 30 ticks, the first after 10, the players whose
    //   feet are within its box grown 16 across and 64 up and down it may attack within 64,
    //   `forCombat().range(64)`, highest first, the first of them it may attack its target. It
    //   goes on while it may attack its target.
    fn phantom_goal<B: CollisionBlocks + NavLevel>(mut self, kind: i32, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if kind == PHANTOM_STRATEGY {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                let p = self.target_in(players) else return false
                return self.phantom_may_attack(f, m, blocks, p)
            }
            if call == GOAL_START {
                self.phantom.next_sweep = reduced_tick_delay(10)
                self.phantom.swoop = false
                self.anchor_above_target(blocks, players)
            } else if call == GOAL_STOP {
                if let a = self.phantom.anchor {
                    let (ax, _, az) = a
                    let top = blocks.column_height(MOTION_BLOCKING, ax, az) ?? min_y
                    self.phantom.anchor = some((ax, top + 10 + self.living.body.random.next_int_below(20), az))
                }
            } else if call == GOAL_TICK and not self.phantom.swoop {
                self.phantom.next_sweep -= 1
                if self.phantom.next_sweep <= 0 {
                    self.phantom.swoop = true
                    self.anchor_above_target(blocks, players)
                    self.phantom.next_sweep = reduced_tick_delay((8 + self.living.body.random.next_int_below(4)) * 20)
                    let pitch = 0.95f32 + self.living.body.random.next_float() * 0.1f32
                    self.living.play(mut sounds, String("entity.phantom.swoop"), 10.0f32, pitch)
                }
            }
            return false
        }
        if kind == PHANTOM_SWEEP {
            if call == GOAL_CAN_USE {
                return self.target_in(players) != none and self.phantom.swoop
            }
            if call == GOAL_CONTINUE {
                let p = self.target_in(players) else return false
                if p.dead or p.spectator or p.creative or not self.phantom.swoop {
                    return false
                }
                if self.living.body.tick_count > self.phantom.cat_search {
                    self.phantom.cat_search = self.living.body.tick_count + 20
                    let b = self.living.body.bounding_box()
                    var cats = 0
                    for c in self.prey {
                        let cb = c.bounds else continue
                        if c.species == CAT and not c.dead and cb.intersects(b.min_x - 16.0, b.min_y - 16.0, b.min_z - 16.0, b.max_x + 16.0, b.max_y + 16.0, b.max_z + 16.0) {
                            self.told.push(Told.Hiss(c.id))
                            cats += 1
                        }
                    }
                    self.phantom.scared_of_cat = cats > 0
                }
                return not self.phantom.scared_of_cat
            }
            if call == GOAL_STOP {
                self.target_to(none)
                self.phantom.swoop = false
            } else if call == GOAL_TICK {
                if let p = self.target_in(players) {
                    self.phantom.move_x = p.x
                    self.phantom.move_y = p.y + f64(p.height) * 0.5
                    self.phantom.move_z = p.z
                    let half = 0.3
                    let theirs = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
                    let grown = f64(0.2f32)
                    let mine = self.living.body.bounding_box().inflate(grown, grown, grown)
                    if mine.intersects(theirs.min_x, theirs.min_y, theirs.min_z, theirs.max_x, theirs.max_y, theirs.max_z) {
                        let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                        self.living.show(Shown.Attack((p.id, ax, ay, az)), sounds.len())
                        self.phantom.swoop = false
                        if not self.living.silent() {
                            let (bx, by, bz) = self.block_position()
                            self.living.show(Shown.Level((1039, bx, by, bz, 0)), sounds.len())
                        }
                    } else if self.living.body.horizontal_collision or self.living.hurt_time > 0 {
                        self.phantom.swoop = false
                    }
                }
            }
            return false
        }
        if kind == PHANTOM_CIRCLE {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                return self.target == none or not self.phantom.swoop
            }
            if call == GOAL_START {
                self.phantom.distance = 5.0f32 + self.living.body.random.next_float() * 10.0f32
                self.phantom.height = -4.0f32 + self.living.body.random.next_float() * 9.0f32
                self.phantom.clockwise = if self.living.body.random.next_boolean() { 1.0f32 } else { -1.0f32 }
                self.circle_next()
            } else if call == GOAL_TICK {
                if self.living.body.random.next_int_below(reduced_tick_delay(350)) == 0 {
                    self.phantom.height = -4.0f32 + self.living.body.random.next_float() * 9.0f32
                }
                if self.living.body.random.next_int_below(reduced_tick_delay(250)) == 0 {
                    self.phantom.distance += 1.0f32
                    if self.phantom.distance > 15.0f32 {
                        self.phantom.distance = 5.0f32
                        self.phantom.clockwise = -self.phantom.clockwise
                    }
                }
                if self.living.body.random.next_int_below(reduced_tick_delay(450)) == 0 {
                    self.phantom.angle = self.living.body.random.next_float() * 2.0f32 * 3.1415927f32
                    self.circle_next()
                }
                let dx = self.phantom.move_x - self.living.body.x
                let dy = self.phantom.move_y - self.living.body.y
                let dz = self.phantom.move_z - self.living.body.z
                if dx * dx + dy * dy + dz * dz < 4.0 {
                    self.circle_next()
                }
                let (bx, by, bz) = self.block_position()
                if self.phantom.move_y < self.living.body.y and not f.is_air(state_at(blocks, bx, by - 1, bz)) {
                    self.phantom.height = if self.phantom.height > 1.0f32 { self.phantom.height } else { 1.0f32 }
                    self.circle_next()
                }
                if self.phantom.move_y > self.living.body.y and not f.is_air(state_at(blocks, bx, by + 1, bz)) {
                    self.phantom.height = if self.phantom.height < -1.0f32 { self.phantom.height } else { -1.0f32 }
                    self.circle_next()
                }
            }
            return false
        }
        if kind == PHANTOM_TARGET {
            if call == GOAL_CAN_USE {
                if self.phantom.next_scan > 0 {
                    self.phantom.next_scan -= 1
                    return false
                }
                self.phantom.next_scan = reduced_tick_delay(60)
                let me = self.looker()
                let near = self.living.body.bounding_box().inflate(16.0, 64.0, 16.0)
                var found = List<Follower>()
                for p in players {
                    let inside = p.x >= near.min_x and p.x < near.max_x and p.y >= near.min_y and p.y < near.max_y and p.z >= near.min_z and p.z < near.max_z
                    if not inside or p.id == me.id or p.spectator or p.dead or not p.enemy {
                        continue
                    }
                    let visibility = p.visibility(me.kind)
                    let seen_within = if 64.0 * visibility > 2.0 { 64.0 * visibility } else { 2.0 }
                    let fx = me.x - p.x
                    let fy = me.y - p.y
                    let fz = me.z - p.z
                    if fx * fx + fy * fy + fz * fz > seen_within * seen_within {
                        continue
                    }
                    if not sees_player(m, f, blocks, mut self.sensing, me, p) {
                        continue
                    }
                    found.push(p.copy())
                }
                // `sort(comparing(Entity::getY).reversed())`, which keeps those as high in their
                // order.
                let highest = sort_highest(found)
                for p in highest {
                    if self.phantom_may_attack(f, m, blocks, p) {
                        self.set_target(some(p.id), players)
                        return true
                    }
                }
                return false
            }
            if call == GOAL_CONTINUE {
                let p = self.target_in(players) else return false
                return self.phantom_may_attack(f, m, blocks, p)
            }
            return false
        }
        return false
    }

    // Whether a phantom may attack the player `p` (CAL-200), `canAttack` with
    // `TargetingConditions.DEFAULT`, `forCombat()` of no range: not itself, seen by anyone, alive,
    // not spectating, one it may see as an enemy, and in its sight as its sensing remembers it for
    // the tick. No teams, so none are allied.
    fn phantom_may_attack<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, p: Follower) -> bool {
        let me = self.looker()
        if p.id == me.id or p.spectator or p.dead or not p.enemy {
            return false
        }
        return sees_player(m, f, blocks, mut self.sensing, me, p)
    }

    // `PhantomAttackStrategyGoal.setAnchorAboveTarget` (CAL-200): where it has a block it circles,
    // that block 20 to 39 above its target's, the sea's height and 1 at least.
    fn anchor_above_target<B: NavLevel>(mut self, blocks: B, players: List<Follower>) {
        if self.phantom.anchor == none {
            return
        }
        let p = self.target_in(players) else return
        let (tx, ty, tz) = (floor_of(p.x), floor_of(p.y), floor_of(p.z))
        var y = ty + 20 + self.living.body.random.next_int_below(20)
        let sea = blocks.sea_level()
        if y < sea {
            y = sea + 1
        }
        self.phantom.anchor = some((tx, y, tz))
    }

    // `PhantomCircleAroundAnchorGoal.selectNext` (CAL-200): the block it circles its own where it
    // has none; its angle 15 degrees on its way round; and where it flies to, at that angle its
    // distance out from the block's least corner, its height less 4 up, floats.
    fn circle_next(mut self) {
        if self.phantom.anchor == none {
            self.phantom.anchor = some(self.block_position())
        }
        let (ax, ay, az) = self.phantom.anchor ?? (0, 0, 0)
        self.phantom.angle = self.phantom.angle + self.phantom.clockwise * 15.0f32 * 0.017453292f32
        let angle = f64(self.phantom.angle)
        self.phantom.move_x = f64(ax) + f64(self.phantom.distance * table_cos(angle))
        self.phantom.move_y = f64(ay) + f64(-4.0f32 + self.phantom.height)
        self.phantom.move_z = f64(az) + f64(self.phantom.distance * table_sin(angle))
    }

    // `PhantomMoveControl.tick` (CAL-200): where it flew into a wall, turned about and slowed to
    // 0.1. Then, with where it flies to more than a hair away across, its way there across eased
    // by how steep it is, 0.7 of up or down to across; its turn 4 degrees at most a tick toward
    // that, its body with it; its speed eased toward 1.8 where that turn was under 3 degrees, by
    // 0.005 of 1.8 over itself, else toward 0.2 by 0.025; pitched toward there; and its motion a
    // fifth of the way to its speed along its turn and pitch, by how much of the way is each way.
    fn phantom_moves(mut self) {
        if self.living.body.horizontal_collision {
            self.living.body.y_rot = self.living.body.y_rot + 180.0f32
            self.phantom.speed = 0.1f32
        }
        var tdx = self.phantom.move_x - self.living.body.x
        let tdy = self.phantom.move_y - self.living.body.y
        var tdz = self.phantom.move_z - self.living.body.z
        var sd = (tdx * tdx + tdz * tdz).sqrt()
        if not (sd.abs() > f64(1.0e-5f32)) {
            return
        }
        let scale = 1.0 - (tdy * f64(0.7f32)).abs() / sd
        tdx *= scale
        tdz *= scale
        sd = (tdx * tdx + tdz * tdz).sqrt()
        let sd2 = (tdx * tdx + tdz * tdz + tdy * tdy).sqrt()
        let prev = self.living.body.y_rot
        let angle = f32.nearest(table_atan2(tdz, tdx) ?? 0.0)
        let a = wrap_degrees(self.living.body.y_rot + 90.0f32)
        let b = wrap_degrees(angle * f32.nearest(RAD_TO_DEG))
        self.living.body.y_rot = approach_degrees(a, b, 4.0f32) - 90.0f32
        self.living.y_body_rot = self.living.body.y_rot
        let speed = self.phantom.speed
        if wrap_degrees(self.living.body.y_rot - prev).abs() < 3.0f32 {
            self.phantom.speed = approach(speed, 1.8f32, 0.005f32 * (1.8f32 / speed))
        } else {
            self.phantom.speed = approach(speed, 0.2f32, 0.025f32)
        }
        let x_rot = f32.nearest(-((table_atan2(-tdy, sd) ?? 0.0) * RAD_TO_DEG))
        self.living.body.x_rot = clamp_pitch(x_rot % 360.0f32)
        let move_angle = self.living.body.y_rot + 90.0f32
        let s = self.phantom.speed
        let txd = f64(s * table_cos(f64(move_angle * 0.017453292f32))) * (tdx / sd2).abs()
        let tzd = f64(s * table_sin(f64(move_angle * 0.017453292f32))) * (tdz / sd2).abs()
        let tyd = f64(s * table_sin(f64(x_rot * 0.017453292f32))) * (tdy / sd2).abs()
        let (mx, my, mz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
        self.living.body.vx = mx + (txd - mx) * 0.2
        self.living.body.vy = my + (tyd - my) * 0.2
        self.living.body.vz = mz + (tzd - mz) * 0.2
    }

    // `NearestAttackableTargetGoal` (CAL-159): used where a draw of its interval comes to 0 and it
    // finds a target, `findTarget`, for players the nearest it may attack and sees within its
    // follow range, `nearest_enemy`; for villagers and endermites the same of its `prey`, those of
    // that species among the level's mobs whose boxes meet its own grown by its follow range,
    // `getEntitiesOfClass`, seen as it looks whether its goal must keep seeing them or not
    // (CAL-244); iron golems and turtles, which Calcite hasn't yet, it finds none of. Its target
    // set as it starts, `TargetGoal`'s counts reset; then `TargetGoal`'s going on and stop.
    fn nearest_goal<B: CollisionBlocks + MobLight>(mut self, g: mut Nearest, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            if self.spider_kind() and self.magic_light(blocks) >= 0.5f32 {
                // `SpiderTargetGoal.canUse`: none in the light at its eyes (CAL-159).
                return false
            }
            if g.peaceful_off and self.difficulty == 0 {
                return false
            }
            // Never a polar bear cub's, `PolarBearAttackPlayersGoal.canUse`, before its draw
            // (CAL-201).
            if g.polar and self.baby() {
                return false
            }
            // Not tame, `NonTameRandomTargetGoal.canUse`, before its draw (CAL-201).
            if g.non_tame and self.is_tame() {
                return false
            }
            if g.interval > 0 and self.living.body.random.next_int_below(g.interval) != 0 {
                return false
            }
            g.found = none
            if g.seek == SEEK_PLAYER {
                let me = self.looker()
                let range = self.living.attributes.value(lf.follow_range) * g.targeting.scale
                var near = List<Follower>()
                for p in players {
                    // A drowned's only those it may take up, its selector `okTarget` (CAL-175).
                    // Not one an iron golem may not attack, `IronGolem.canAttack` (CAL-201).
                    if self.golem_refuses(p) {
                        continue
                    }
                    if g.drowned and not ok_target(blocks, p) {
                        continue
                    }
                    // A bee's only those it's angry at, `isAngryAt` (CAL-177), and a zombified
                    // piglin's (CAL-200).
                    if (g.bee or g.angry) and not self.angry_at(p) {
                        continue
                    }
                    // A guardian's only those more than 3 from it, `GuardianAttackSelector`
                    // (CAL-200).
                    if g.guardian and self.distance_sqr_to(p.x, p.y, p.z) <= 9.0 {
                        continue
                    }
                    if g.max_dy < 0.0 or (p.y - self.living.body.y).abs() <= g.max_dy {
                        near.push(p.copy())
                    }
                }
                g.found = nearest_enemy(m, f, blocks, mut self.sensing, me, near, range)
            } else if g.seek == SEEK_LIVING {
                // A wither's (CAL-401), `NearestAttackableTargetGoal` of `LivingEntity` with its
                // selector: the players and mobs it may attack but the undead, `#wither_friends`,
                // within its follow range, seen or not, `ignoreLineOfSight`, the nearest.
                let me = self.looker()
                let range = self.living.attributes.value(lf.follow_range)
                var near = List<Follower>()
                for p in players {
                    near.push(p.copy())
                }
                for p in self.prey {
                    if not undead_kind(p.species) {
                        near.push(p.copy())
                    }
                }
                g.found = nearest_unseen(me, near, range)
            } else if g.seek == SEEK_VILLAGER or g.seek == SEEK_ENDERMITE or g.seek == SEEK_GOLEM or g.seek == SEEK_ENEMY {
                let kind = if g.seek == SEEK_VILLAGER { VILLAGER } else if g.seek == SEEK_GOLEM { IRON_GOLEM } else { ENDERMITE }
                let me = self.looker()
                let range = self.living.attributes.value(lf.follow_range)
                var near = List<Follower>()
                for p in self.prey {
                    // An iron golem's enemies but creepers, which it may not attack either
                    // (CAL-201).
                    if g.seek == SEEK_ENEMY {
                        if enemy_kind(p.species) and (p.species != CREEPER or self.species != IRON_GOLEM) and (g.max_dy < 0.0 or (p.y - self.living.body.y).abs() <= g.max_dy) {
                            near.push(p.copy())
                        }
                        continue
                    }
                    // An illager's no baby villagers, `AbstractIllager.canAttack`, nor a ravager's,
                    // its goal's own condition (CAL-200).
                    if p.baby and (illager_kind(self.species) or self.species == RAVAGER) {
                        continue
                    }
                    if p.species == kind and (g.max_dy < 0.0 or (p.y - self.living.body.y).abs() <= g.max_dy) {
                        near.push(p.copy())
                    }
                }
                g.found = nearest_enemy(m, f, blocks, mut self.sensing, me, near, range)
            } else if g.seek == SEEK_PREY or g.seek == SEEK_SKELETON or g.seek == SEEK_CHICKEN or g.seek == SEEK_PIGLIN or g.seek == SEEK_RABBIT or g.seek == SEEK_WOLF or g.seek == SEEK_FOX or g.seek == SEEK_FOX_PREY or g.seek == SEEK_FISH or g.seek == SEEK_TURTLE {
                // A wild wolf's prey, of which Calcite has sheep, and skeletons, `AbstractSkeleton`'s,
                // an ocelot's chickens and a wither skeleton's piglins, `AbstractPiglin`'s, among its
                // level's mobs (CAL-201); a llama's wolves within a quarter of its follow range,
                // `LlamaAttackWolfGoal.getFollowDistance`; and baby turtles on land,
                // `Turtle.BABY_ON_LAND_SELECTOR` (CAL-201).
                let me = self.looker()
                let range = self.living.attributes.value(lf.follow_range) * g.targeting.scale
                var near = List<Follower>()
                for p in self.prey {
                    let s = p.species
                    let fits = if g.seek == SEEK_PREY { s == SHEEP or s == RABBIT } else if g.seek == SEEK_CHICKEN { s == CHICKEN } else if g.seek == SEEK_PIGLIN { s == PIGLIN or s == PIGLIN_BRUTE } else if g.seek == SEEK_RABBIT { s == RABBIT } else if g.seek == SEEK_WOLF { s == WOLF and not (g.wild and p.tamed) } else if g.seek == SEEK_FOX { s == FOX and not self.baby() } else if g.seek == SEEK_FOX_PREY { s == CHICKEN or s == RABBIT } else if g.seek == SEEK_FISH { schooling_kind(s) } else if g.seek == SEEK_TURTLE { s == TURTLE and p.baby and not p.in_water } else { s == SKELETON or s == STRAY or s == BOGGED or s == PARCHED or s == WITHER_SKELETON }
                    if fits {
                        near.push(p.copy())
                    }
                }
                g.found = nearest_enemy(m, f, blocks, mut self.sensing, me, near, range)
            }
            if g.polar and g.found != none {
                // Only with a cub among the polar bears its box meets, grown 8 across and 4 up
                // and down, `getEntitiesOfClass` (CAL-201).
                let b = self.living.body.bounding_box()
                for k in self.kin {
                    if k.species == POLAR_BEAR and k.age < 0 and k.bounds.intersects(b.min_x - 8.0, b.min_y - 4.0, b.min_z - 8.0, b.max_x + 8.0, b.max_y + 4.0, b.max_z + 8.0) {
                        return true
                    }
                }
                return false
            }
            return g.found != none
        }
        if call == GOAL_CONTINUE and g.non_tame {
            // `NonTameRandomTargetGoal.canContinueToUse`: its own target still one its conditions
            // take, alive, one it may attack, within its follow range as visible to it, and seen
            // (CAL-201).
            let id = g.found else return false
            let p = self.followed(players, id) else return false
            if p.spectator or p.dead or not p.enemy {
                return false
            }
            let range = self.living.attributes.value(lf.follow_range)
            let visibility = p.visibility(self.looker().kind)
            let within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
            if self.distance_sqr_to(p.x, p.y, p.z) > within * within {
                return false
            }
            let me = self.looker()
            return sees_player(m, f, blocks, mut self.sensing, me, p)
        }
        if call == GOAL_CONTINUE {
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            self.set_target(g.found, players)
            g.targeting.unseen_ticks = 0
        } else if call == GOAL_STOP {
            self.target_to(none)
            g.targeting.target_mob = none
        }
        return false
    }

    // A zombie's `MoveThroughVillageGoal` (D605), with its level's points of interest lent to it:
    // used, the oldest of those it's been to let go where it remembers more than 15, only at night
    // where it's to be, `isBrightOutside` not, and within 6 sections of a village,
    // `isCloseToVillage`. Its target's `village_poi`'s; a path there's found with doors as it may
    // break them, `canBreakDoors`, else to a place on the way, `DefaultRandomPos.getPosTowards`
    // up to 10 across and 7 up or down within a right angle of it, and either way its navigation
    // may open doors after, as vanilla's is left, `setCanOpenDoors(true)`. Where a node of that
    // path has a door a hand opens a block up, `isWoodenDoor`, its path's found again to that
    // node, and no further. It goes on while its navigation isn't done and it's farther from the
    // middle of the point than its width and 4; as it stops, done or within 4, the point's been
    // to. Its stop leaves its navigation going, as vanilla's does.
    fn through_village_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut ThroughVillage, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            // Not while a mob steers it, `hasControllingPassenger` (D710).
            if self.controlled {
                return false
            }
            if g.visited.len() > 15 {
                _ = g.visited.remove(0)
            }
            if g.only_at_night and blocks.bright_outside() {
                return false
            }
            let target = self.village_poi(g.visited, lf, f, blocks, mut cache, min_y) else return false
            let (tx, ty, tz) = (target.x, target.y, target.z)
            g.poi = target
            let nf = nav_facts(lf, blocks, min_y)
            self.navigation.can_open_doors = self.can_break_doors
            let w = self.walker(lf)
            g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, tx, ty, tz, 0)
            self.navigation.can_open_doors = true
            if g.path == none {
                let dir = (f64(tx) + 0.5 - self.living.body.x, f64(tz) + 0.5 - self.living.body.z)
                let step = self.place_towards(10, 7, dir, lf, f, blocks, mut cache, min_y) else return false
                let (px, py, pz) = step
                self.navigation.can_open_doors = self.can_break_doors
                g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, floor_of(px), floor_of(py), floor_of(pz), 0)
                self.navigation.can_open_doors = true
                if g.path == none {
                    return false
                }
            }
            if let path = g.path.copy() {
                let iron = f.block_named(String("minecraft:iron_door"))
                for node in path.nodes {
                    let block = f.block(state_at(blocks, node.x, node.y + 1, node.z))
                    if f.is_a(block, "DoorBlock") and some(block) != iron {
                        g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, node.x, node.y, node.z, 0)
                        break
                    }
                }
            }
            return g.path != none
        }
        if call == GOAL_CONTINUE {
            if self.navigation.is_done() {
                return false
            }
            // `getBbWidth() + distanceToPoi`, a float.
            let reach = f64(self.living.body.width + f32.nearest(g.distance_to_poi))
            return not self.near_middle(g.poi, reach)
        }
        if call == GOAL_START {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            _ = self.navigation.move_along(lf, f, nf, blocks, w, g.path.take(), g.speed)
        } else if call == GOAL_STOP {
            if self.navigation.is_done() or self.near_middle(g.poi, f64(g.distance_to_poi)) {
                g.visited.push(g.poi)
            }
        }
        return false
    }

    // Whether it wears the ominous banner on its head, as a raid's leader does.
    /// `ObtainRaidLeaderBannerGoal.cannotPickUpBanner` (CAL-396): out of an active raid, its raid
    /// over, one that can't lead, a witch or a ravager, `canBeLeader`, one wearing the ominous
    /// banner already, or one whose wave has a leader.
    pub fn cannot_pick_up_banner(self) -> bool {
        let r = self.raid_view.copy() else return true
        if not r.active or r.over or self.species == WITCH or self.species == RAVAGER or self.wears_ominous_banner() {
            return true
        }
        return r.leaders.any(|l| l.0 == self.wave)
    }

    /// Whether it's in an active raid whose wave has no leader, as `Raider.pickUpItem` asks
    /// (CAL-396).
    pub fn leaderless(self) -> bool {
        let r = self.raid_view.copy() else return false
        return r.active and not r.leaders.any(|l| l.0 == self.wave)
    }

    /// `Raider.pickUpItem` of the ominous banner `stack` where its wave has no leader (CAL-396):
    /// what it wears on its head dropped where it's something and a float drawn less a tenth, at
    /// least 0, is under its chance, `spawnAtLocation`; the banner worn, `setItemSlot`; then, after
    /// it's taken, its wave's leader, `setLeader`, a new banner on its head, sure to drop, its raid
    /// told, and a patrol's leader.
    pub fn raider_takes_banner<W: Wearing>(mut self, items: W, stack: Tag, sounds: mut List<EntitySound>) {
        if let old = self.living.equipment[5].copy() {
            let drawn = self.living.body.random.next_float() - 0.1f32
            if (if drawn > 0.0f32 { drawn } else { 0.0f32 }) < self.drop_chance(5) {
                self.spill_here(old, sounds.len())
            }
        }
        self.equip_in(items, 5, stack, mut sounds)
        self.equip_in(items, 5, ominous_banner(), mut sounds)
        self.guarantee_drop(5)
        if let r = self.raid {
            self.living.show(Shown.RaidLeader((r, self.wave)), sounds.len())
        }
        self.patrol_leader = true
    }

    /// `Raider.pickUpItem` of `stack` (CAL-396), how much it takes, none for nothing: the ominous
    /// banner, where its wave in an active raid has no leader, worn as its leader, whole; else, a
    /// pillager's only of banners, `Pillager.pickUpItem`, equipped where it may be,
    /// `Mob.pickUpItem`.
    pub fn raider_pick_up<W: Wearing>(mut self, stack: Tag, lf: LivingFacts, items: W, sounds: mut List<EntitySound>) -> i32? {
        if self.leaderless() and is_ominous_banner(stack.copy()) {
            self.raider_takes_banner(items, stack.copy(), mut sounds)
            return some(count_of(some(stack.copy())))
        }
        if self.species == PILLAGER and not held_name(some(stack.copy())).ends_with("_banner") {
            return none
        }
        let equipped = self.equip_if_possible(lf, items, stack, mut sounds) else return none
        return some(count_of(some(equipped)))
    }

    // `Raider.ObtainRaidLeaderBannerGoal` (CAL-396), `g` its path and the banners it couldn't reach.
    // Used where it may pick a banner up, at the first of the ominous banners its level found within
    // its follow range across and 8 up and down of its box with no pickup delay, `ALLOWED_ITEMS`,
    // that it hasn't found it couldn't reach in the last 600 ticks and a path to whose block, within
    // 1, reaches, `createPath(entity, 1)`; where none does, those it couldn't reach kept from now,
    // with those still waited out. Going on while that banner's here, the path isn't followed to
    // its end and it may still pick one up. Started along it at 1.15; each tick, the banner within
    // 1.414 of it, picked up, `pickUpItem`, which its level does once its tick's done.
    fn banner_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Banner, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.cannot_pick_up_banner() {
                return false
            }
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            var kept = List<(i32, i64)>()
            for (id, x, y, z) in self.banners.copy() {
                var waited: i64? = none
                for (u, until) in g.unreachable {
                    if u == id {
                        waited = some(until)
                    }
                }
                if let until = waited {
                    if self.game_time < until {
                        kept.push((id, until))
                        continue
                    }
                }
                let found = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, floor_of(x), floor_of(y), floor_of(z), 1)
                if let p = found {
                    if p.reached {
                        g.path = some(p)
                        self.banner_item = id
                        self.banner_at = some((x, y, z))
                        return true
                    }
                }
                kept.push((id, self.game_time + 600i64))
            }
            g.unreachable = kept
            return false
        }
        if call == GOAL_CONTINUE {
            let p = g.path.copy() else return false
            if self.banner_item < 0 or self.banner_at == none {
                return false
            }
            var done = false
            if let n = self.navigation.path {
                if n.id == p.id {
                    done = self.navigation.is_done()
                }
            }
            return not done and not self.cannot_pick_up_banner()
        }
        if call == GOAL_START {
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            _ = self.navigation.move_along(lf, f, nf, blocks, w, g.path.copy(), 1.15)
        } else if call == GOAL_STOP {
            g.path = none
            self.banner_item = -1
        } else if call == GOAL_TICK {
            if let (x, y, z) = self.banner_at {
                if self.distance_sqr_to(x, y, z) < 1.414 * 1.414 {
                    self.banner_take = self.banner_item
                }
            }
        }
        return false
    }

    fn wears_ominous_banner(self) -> bool {
        let worn = self.living.equipment[5].copy() else return false
        return worn == ominous_banner()
    }

    // `LongDistancePatrolGoal` (CAL-167): used patrolling with no target, no one steering it, a
    // patrol target and its cooldown, `until`, past. Each tick where it isn't walking: with no
    // raider near to join it, its box grown by 16, no longer patrolling; a leader within 10 of
    // its target's middle finding another, `findPatrolTarget`; else a walk 10 toward the target
    // turned off it, its offset turned by 90 radians and shortened to 0.4, the top there,
    // `MOTION_BLOCKING_NO_LEAVES`, at 0.595 for a leader and 0.7 for the rest; where there's no
    // path there, a walk 8 about, `moveRandomly`, and 200 ticks' cooldown, else a leader's
    // companions told to go there too, `setPatrolTarget`.
    fn patrol_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, until: mut i64, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            return self.patrolling and self.target == none and not self.controlled and self.patrol_target != none and not (self.game_time < until)
        }
        if call != GOAL_TICK or not self.navigation.is_done() {
            return false
        }
        let me = self.living.body.id
        let b = self.living.body.bounding_box()
        var companions = List<i32>()
        for k in self.kin {
            if k.id != me and k.joins_patrol and k.bounds.intersects(b.min_x - 16.0, b.min_y - 16.0, b.min_z - 16.0, b.max_x + 16.0, b.max_y + 16.0, b.max_z + 16.0) {
                companions.push(k.id)
            }
        }
        let (tx, ty, tz) = self.patrol_target ?? (0, 0, 0)
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        if companions.len() == 0 {
            self.patrolling = false
            return false
        }
        let leader = self.patrol_leader
        let (cx, cy, cz) = (f64(tx) + 0.5 - x, f64(ty) + 0.5 - y, f64(tz) + 0.5 - z)
        if leader and cx * cx + cy * cy + cz * cz < 100.0 {
            self.find_patrol_target()
            return false
        }
        let (bx, by, bz) = (f64(tx) + 0.5, f64(ty), f64(tz) + 0.5)
        let (ox, oy, oz) = patrol_turn(x - bx, y - by, z - bz)
        let (lx, ly, lz) = (ox * 0.4 + bx, oy * 0.4 + by, oz * 0.4 + bz)
        let (dx, dy, dz) = (lx - x, ly - y, lz - z)
        let length = (dx * dx + dy * dy + dz * dz).sqrt()
        let (nx, nz) = if length < f64(1.0E-5f32) { (0.0, 0.0) } else { (dx / length, dz / length) }
        let px = i32.saturate((nx * 10.0 + x).floor())
        let pz = i32.saturate((nz * 10.0 + z).floor())
        let py = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, px, pz) ?? min_y
        if not self.move_to(lf, f, m, blocks, mut cache, min_y, f64(px), f64(py), f64(pz), if leader { 0.595 } else { 0.7 }) {
            let (hx, _, hz) = self.block_position()
            let rx = hx - 8 + self.living.body.random.next_int_below(16)
            let rz = hz - 8 + self.living.body.random.next_int_below(16)
            let ry = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, rx, rz) ?? min_y
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(rx), f64(ry), f64(rz), 0.7)
            until = self.game_time + 200i64
        } else if leader {
            for c in companions {
                self.told.push(Told.PatrolTarget((c, px, py, pz)))
            }
        }
        return false
    }

    // `Raider.HoldGroundAttackGoal` (CAL-167), a pillager's and a vindicator's, of radius 10: used
    // and kept on out of a raid, patrolling, with a target, not aggressive and not last hurt by a
    // player, ticked every tick. Started, its walk stopped and the raiders within 8 told to take
    // its target, `shouts`; each tick, where its target's more than 10 off, looking at it, and one
    // in 50, drawn from its own random, its ambient sound; else aggressive. Stopped with a target,
    // the raiders near told to take it and be aggressive, and it aggressive.
    fn hold_ground_goal(mut self, call: i32, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            if self.raid != none or not self.patrolling or self.target == none or self.aggressive() {
                return false
            }
            let who = self.living.hurt_by_mob else return true
            for p in players {
                if p.uuid == some(who) {
                    return false
                }
            }
            return true
        }
        let id = self.target else return false
        if call == GOAL_START {
            self.navigation.stop()
            self.shouts.push((id, false))
        } else if call == GOAL_STOP {
            self.shouts.push((id, true))
            self.set_flag(AGGRESSIVE_FLAG, true)
        } else if call == GOAL_TICK {
            let p = self.followed(players, id) else return false
            if self.distance_sqr_to(p.x, p.y, p.z) > 100.0 {
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
                if self.living.body.random.next_int_below(50) == 0 {
                    self.play_ambient(mut sounds)
                }
            } else {
                self.set_flag(AGGRESSIVE_FLAG, true)
            }
        }
        return false
    }

    /// A raider told by another holding its ground to take its target, `id`, and where
    /// `aggressive`, to be aggressive (CAL-167).
    pub fn shouted_at(mut self, id: i32, aggressive: bool, players: List<Follower>) {
        self.set_target(some(id), players)
        if aggressive {
            self.set_flag(AGGRESSIVE_FLAG, true)
        }
    }

    /// `findPatrolTarget`: a target up to 500 off each way across from its block, drawn from its
    /// random, and it patrolling (CAL-167).
    pub fn find_patrol_target(mut self) {
        let (x, y, z) = self.block_position()
        let dx = -500 + self.living.body.random.next_int_below(1000)
        let dz = -500 + self.living.body.random.next_int_below(1000)
        self.patrol_target = some((x + dx, y, z + dz))
        self.patrolling = true
    }

    // `PathfindToRaidGoal` (CAL-167): used with no target, no one steering it, its raid active and
    // not over, and out of the village, `isVillage`; kept on while that holds but the target. Each
    // tick in an active raid, every 20 the raiders near asked to join it, `recruitNearby`; and
    // where it isn't walking, a walk at 1 toward the bottom middle of its raid's center, up to 15
    // across and 4 up or down, within a right angle, `DefaultRandomPos.getPosTowards`.
    fn to_raid_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut ToRaid, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) -> bool {
        let r = self.raid_view.copy() else return false
        if call == GOAL_CAN_USE {
            return self.target == none and not self.controlled and r.active and not r.over and not self.in_village()
        }
        if call == GOAL_CONTINUE {
            return r.active and not r.over and not self.in_village()
        }
        if call == GOAL_TICK and r.active {
            if self.living.body.tick_count > g.recruit_at {
                g.recruit_at = self.living.body.tick_count + 20
                let near = self.living.body.bounding_box().inflate(16.0, 16.0, 16.0)
                self.living.show(Shown.RaidRecruit(near), heard)
            }
            if self.navigation.is_done() {
                let (cx, _, cz) = r.center
                let dir = (f64(cx) + 0.5 - self.living.body.x, f64(cz) + 0.5 - self.living.body.z)
                if let p = self.place_towards(15, 4, dir, lf, f, blocks, mut cache, min_y) {
                    let (px, py, pz) = p
                    _ = self.move_to(lf, f, m, blocks, mut cache, min_y, px, py, pz, 1.0)
                }
            }
        }
        return false
    }

    // `DoorInteractGoal.canUse` (CAL-167), on the ground's navigation, which every mob with this
    // goal has: bumping into something, with a path it hasn't followed to its end, the first of
    // its nodes up to two past the next whose block above is within 1.5 across of it, by that
    // block's corner at its own height, and a wooden door, `isWoodenDoor`; else the block above its
    // own, where that's one.
    fn door_can_use<B: CollisionBlocks>(self, g: mut DoorGoal, f: Facts, blocks: B) -> bool {
        if not self.living.body.horizontal_collision or self.navigation.is_done() {
            return false
        }
        let path = self.navigation.path.copy() else return false
        let iron = f.block_named(String("minecraft:iron_door"))
        let ahead = self.navigation.next + 2
        let last = if ahead < path.nodes.len() { ahead } else { path.nodes.len() }
        for i in 0..last {
            let (nx, ny, nz) = (path.nodes[i].x, path.nodes[i].y, path.nodes[i].z)
            g.pos = BlockPos { x: nx, y: ny + 1, z: nz }
            let dx = f64(nx) - self.living.body.x
            let dz = f64(nz) - self.living.body.z
            if not (dx * dx + dz * dz > 2.25) {
                g.has_door = wooden_door(f, iron, state_at(blocks, nx, ny + 1, nz))
                if g.has_door {
                    return true
                }
            }
        }
        let (bx, by, bz) = self.block_position()
        g.pos = BlockPos { x: bx, y: by + 1, z: bz }
        g.has_door = wooden_door(f, iron, state_at(blocks, bx, by + 1, bz))
        return g.has_door
    }

    // `DoorInteractGoal.setOpen`: where it has a door and it's still one, opened or shut by its
    // level, `Shown.Opened`, its goals' tick stopping for it.
    fn set_door_open<B: CollisionBlocks>(mut self, g: DoorGoal, f: Facts, blocks: B, open: bool, heard: usize) {
        if not g.has_door or not f.is_a(f.block(state_at(blocks, g.pos.x, g.pos.y, g.pos.z)), "DoorBlock") {
            return
        }
        self.living.show(Shown.Opened((g.pos.x, g.pos.y, g.pos.z, open)), heard)
        self.goals_stop = true
    }

    // A vindicator's `VindicatorBreakDoorGoal` where `g.breaks`, else a raider's
    // `RaiderOpenDoorGoal` (CAL-167). The first, in an active raid: used one in 5 tries, drawn
    // from its random, at a door, `door_can_use`, with mob griefing on, on normal or hard, where
    // it's shut; kept on, still in an active raid on normal or hard, while it's been breaking it
    // no more than 240 ticks, it's shut and its middle's within 2. Started, which way the door is
    // kept, its time 0 and it not idle; each tick one in 20, drawn, the door's knocked, level event
    // 1019, it swinging where it isn't; its time on, its stage, a tenth of 240 each, shown as it
    // changes; at 240 the door broken, `Shown.Broke`. Stopped, its stage none, -1. The second, at
    // a door in an active raid, opens it as it starts and isn't kept on, shutting it as it stops,
    // as vanilla's does where it's not to close it after.
    fn door_goal<B: CollisionBlocks>(mut self, g: mut DoorGoal, call: i32, f: Facts, blocks: B, heard: usize) -> bool {
        let raiding = if let r = self.raid_view { r.active } else { false }
        let hard_enough = self.difficulty == 2 or self.difficulty == 3
        if call == GOAL_TICK {
            let nx = f32.nearest(f64(g.pos.x) + 0.5 - self.living.body.x)
            let nz = f32.nearest(f64(g.pos.z) + 0.5 - self.living.body.z)
            if g.dir_x * nx + g.dir_z * nz < 0.0f32 {
                g.passed = true
            }
        }
        if not g.breaks {
            if call == GOAL_CAN_USE {
                return self.door_can_use(mut g, f, blocks) and raiding
            }
            if call == GOAL_START {
                self.set_door_open(g, f, blocks, true, heard)
            } else if call == GOAL_STOP {
                self.set_door_open(g, f, blocks, false, heard)
            }
            return false
        }
        if call == GOAL_CAN_USE {
            if not raiding or self.living.body.random.next_int_below(reduced_tick_delay(10)) != 0 {
                return false
            }
            if not self.door_can_use(mut g, f, blocks) or not self.mob_griefing {
                return false
            }
            return hard_enough and not door_open(mut g, f, blocks)
        }
        if call == GOAL_CONTINUE {
            return raiding and g.break_time <= 240 and not door_open(mut g, f, blocks) and self.near_middle(g.pos, 2.0) and hard_enough
        }
        if call == GOAL_START {
            g.passed = false
            g.dir_x = f32.nearest(f64(g.pos.x) + 0.5 - self.living.body.x)
            g.dir_z = f32.nearest(f64(g.pos.z) + 0.5 - self.living.body.z)
            g.break_time = 0
            self.no_action_time = 0
        } else if call == GOAL_STOP {
            self.living.show(Shown.Cracked((g.pos.x, g.pos.y, g.pos.z, -1)), heard)
        } else if call == GOAL_TICK {
            if self.living.body.random.next_int_below(20) == 0 {
                self.living.show(Shown.Level((1019, g.pos.x, g.pos.y, g.pos.z, 0)), heard)
                if self.swing_duration < 0 {
                    self.swing_for_attack(heard)
                }
            }
            g.break_time += 1
            let stage = i32.saturate((f64(f32.nearest(g.break_time) / 240.0f32 * 10.0f32)).floor())
            if stage != g.last_stage {
                self.living.show(Shown.Cracked((g.pos.x, g.pos.y, g.pos.z, stage)), heard)
                g.last_stage = stage
            }
            if g.break_time == 240 and hard_enough {
                self.living.show(Shown.Broke((g.pos.x, g.pos.y, g.pos.z)), heard)
                self.goals_stop = true
            }
        }
        return false
    }

    // `MoveToSkySeeingSpot.hasNoBlocksAbove` (CAL-167): whether the block x, y, z sees the sky
    // and the top of its column, `MOTION_BLOCKING`, is no higher than its feet.
    fn open_to_sky<B: CollisionBlocks + MobLight + NavLevel>(self, blocks: B, x: i32, y: i32, z: i32) -> bool {
        if not blocks.sees_sky(x, y, z) {
            return false
        }
        let top = blocks.column_height(MOTION_BLOCKING, x, z) else return false
        return f64(top) <= self.living.body.y
    }

    // `RaiderCelebration` (CAL-167): used, and kept on, while it's alive with no target in a lost
    // raid; celebrating while it runs, `setCelebrating`. Each tick but where it's silent, one in
    // 50, drawn from its random, its celebrating sound; then where it rides nothing, one in 25, a
    // jump.
    fn celebrate_goal(mut self, call: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let lost = if let r = self.raid_view { r.loss } else { false }
            return self.living.alive() and self.target == none and lost
        }
        if call == GOAL_START or call == GOAL_STOP {
            self.living.data.set(MONSTER_OWN, Value.Bool(call == GOAL_START))
        } else if call == GOAL_TICK {
            if not self.living.silent() and self.living.body.random.next_int_below(reduced_tick_delay(100)) == 0 {
                let sound = celebrate_sound(self.species)
                self.make_sound(mut sounds, sound)
            }
            if self.living.body.vehicle == none and self.living.body.random.next_int_below(reduced_tick_delay(50)) == 0 {
                self.living.jumping = true
            }
        }
        return false
    }

    // `RaiderMoveThroughVillageGoal` (CAL-167): used in an active raid not over, where there's a
    // home within 48 it hasn't reached lately, the first of those in range shuffled by its random,
    // `getRandom`, and it has no target; kept on while it's walking, has no target, isn't within
    // its width and 1 of the home's middle and isn't stuck. Started, it's not idle and walks to the
    // home at 1.05; each tick it isn't walking, on toward the home's bottom middle, up to 16
    // across and 7 up or down within a tenth of a turn either side, else 8 across within a right
    // angle, else stuck. Stopped within 1 of it, the home's among those reached, the last three.
    fn raid_village_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut RaidVillage, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if g.visited.len() > 2 {
                _ = g.visited.remove(0)
            }
            let r = self.raid_view.copy() else return false
            if not r.active or r.over {
                return false
            }
            let pois = self.pois.take() else return false
            let (bx, by, bz) = self.block_position()
            var homes = pois.in_range(types_of(1u32 << u32.wrap(HOME)), BlockPos { x: bx, y: by, z: bz }, 48, Occupancy.Any)
            self.pois = some(pois)
            shuffle(mut homes, mut self.living.body.random)
            var found: BlockPos? = none
            for h in homes {
                if not g.visited.contains(h.pos) {
                    found = some(h.pos)
                    break
                }
            }
            let poi = found else return false
            g.poi = poi
            return self.target == none
        }
        if call == GOAL_CONTINUE {
            if self.navigation.is_done() {
                return false
            }
            return self.target == none and not self.near_middle(g.poi, f64(self.living.body.width) + 1.0) and not g.stuck
        }
        if call == GOAL_START {
            self.no_action_time = 0
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.poi.x), f64(g.poi.y), f64(g.poi.z), 1.05)
            g.stuck = false
        } else if call == GOAL_STOP {
            if self.near_middle(g.poi, 1.0) {
                g.visited.push(g.poi)
            }
        } else if call == GOAL_TICK and self.navigation.is_done() {
            let (tx, tz) = (f64(g.poi.x) + 0.5, f64(g.poi.z) + 0.5)
            var next = self.turtle_towards(16, 7, tx, tz, f64(0.31415927f32), lf, f, blocks, mut cache, min_y)
            if next == none {
                next = self.turtle_towards(8, 7, tx, tz, f64(1.5707964f32), lf, f, blocks, mut cache, min_y)
            }
            let p = next else {
                g.stuck = true
                return false
            }
            let (px, py, pz) = p
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, px, py, pz, 1.05)
        }
        return false
    }

    // `MoveThroughVillageGoal.canUse`'s point of interest (D605), where it's within 6 sections of a
    // village, `isCloseToVillage`: of 10 places on land up to 15 across and 7 up or down,
    // `LandRandomPos.getPos`, the one whose `unvisited_poi` is nearest its own block, `distSqr`,
    // the first of those as near, only those in a village, their section within 1 of a center,
    // `isVillage`; then that place's `unvisited_poi`.
    fn village_poi<B: CollisionBlocks + MobLight + NavLevel>(mut self, visited: List<BlockPos>, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> BlockPos? {
        var pois = self.pois.take() else return none
        let (bx, by, bz) = self.block_position()
        let here = BlockPos { x: bx, y: by, z: bz }
        var target: BlockPos? = none
        if pois.close_to_village(here, 6) {
            let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
            let costs = self.own_maluses()
            let tries = land_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 15, 7)
            var best = f64.NEG_INFINITY
            var found: BlockPos? = none
            for t in tries {
                let p = t else continue
                let (x, y, z) = p
                let at = BlockPos { x: x, y: y, z: z }
                // `Double.NEGATIVE_INFINITY` for a place not in a village or with none, which is
                // never taken.
                if not pois.close_to_village(at, 1) {
                    continue
                }
                let poi = unvisited_poi(pois, at, visited) else continue
                let dx = f64(poi.x - here.x)
                let dy = f64(poi.y - here.y)
                let dz = f64(poi.z - here.z)
                let value = -(dx * dx + dy * dy + dz * dz)
                if value > best {
                    best = value
                    found = some(at)
                }
            }
            if let at = found {
                target = unvisited_poi(pois, at, visited)
            }
        }
        self.pois = some(pois)
        return target
    }

    // Whether its goals look for points of interest, which its level lends it for them, a zombie's
    // `MoveThroughVillageGoal` for villages' (D605), a bee's `BeeLocateHiveGoal` for hives (CAL-177)
    // and an iron golem's strolls about its village (CAL-201).
    pub fn goes_through_villages(self) -> bool {
        return self.zombie_class() or self.species == BEE or self.species == IRON_GOLEM or self.species == FOX or self.raid != none
    }

    // `Mob.isWithinHome` of the block at `x`, `y`, `z` (CAL-179): anywhere without a home, else its
    // square distance from the home's place, `distSqr`, under the home's radius squared.
    fn within_home(self, x: f64, y: f64, z: f64) -> bool {
        let ((hx, hy, hz), radius) = self.home else return true
        let dx = f64(hx - floor_of(x))
        let dy = f64(hy - floor_of(y))
        let dz = f64(hz - floor_of(z))
        return dx * dx + dy * dy + dz * dz < f64(radius * radius)
    }

    // `HurtByTargetGoal` (CAL-159): used where who last hurt it is new since it last took one up,
    // by their tick count then, and is one it may attack, seen or not, `HURT_BY_TARGETING`, their
    // block within its home, but not where they're a player and the game rule `universal_anger`'s
    // on. As it starts, its target,
    // kept in the goal, who it remembers unseen for 300 ticks, and the mobs of its class near it
    // alerted, `alertOthers`, which its level does as its tick's done; then `TargetGoal`'s going on
    // and stop.
    fn hurt_by_goal<B: CollisionBlocks>(mut self, g: mut HurtBy, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            let who = self.hurt_by_in(players) else return false
            if self.living.hurt_by_mob_stamp == g.timestamp or self.universal_anger {
                return false
            }
            // Not by a raider, where it ignores them, `toIgnoreDamage` (CAL-200).
            if (g.raiders_ignored and raider_kind(who.species)) or (g.kin_ignored and who.mob and who.species == self.species) or (g.guardians_ignored and who.mob and (who.species == GUARDIAN or who.species == ELDER_GUARDIAN)) {
                return false
            }
            // Not its owner, a tame wolf's, `TamableAnimal.canAttack` (CAL-201).
            if self.is_tame() and who.uuid != none and who.uuid == self.living.data.uuid(OWN + 1) {
                return false
            }
            // `TargetGoal.canAttack`, its target's block within its home, `isWithinHome` (CAL-179).
            return who.id != self.living.body.id and not who.spectator and not who.dead and who.enemy and not self.golem_refuses(who) and self.within_home(who.x, who.y, who.z)
        }
        if call == GOAL_CONTINUE and g.panda and (self.panda.got_bamboo or self.panda.did_bite) {
            // `PandaHurtByTargetGoal.canContinueToUse`: not once it got bamboo or bit, its target
            // let go (CAL-201).
            self.target_to(none)
            return false
        }
        if call == GOAL_CONTINUE and g.llama and self.did_spit {
            // `LlamaHurtByTargetGoal.canContinueToUse`: not once it's spat, its spit forgotten
            // (CAL-201).
            self.did_spit = false
            return false
        }
        if call == GOAL_CONTINUE {
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            let who = self.hurt_by_in(players)
            let id = match who {
                some(p) => some(p.id),
                none => none,
            }
            self.set_target(id, players)
            g.targeting.target_mob = self.target
            g.timestamp = self.living.hurt_by_mob_stamp
            g.targeting.unseen_memory = 300
            // A polar bear cub alerts the grown polar bears, `PolarBearHurtByTargetGoal.start`
            // (CAL-201).
            let cub = g.polar and self.baby()
            if g.alert or cub {
                // A bee alerts the others only where it sees who hurt it, `hasLineOfSight`,
                // `Bee.BeeHurtByOtherGoal.alertOther` (CAL-177).
                var alerts = true
                if g.bee {
                    if let w = self.hurt_by_in(players) {
                        let me = self.looker()
                        alerts = sees(m, f, blocks, me.mover, me.x, me.eye_y, me.z, w.x, w.y + f64(w.eyes), w.z)
                    }
                }
                if alerts {
                    self.alerted = id
                }
            }
            g.targeting.unseen_ticks = 0
            if cub {
                // Then it stops, `stop`: no target.
                self.target_to(none)
                g.targeting.target_mob = none
            }
        } else if call == GOAL_STOP {
            self.target_to(none)
            g.targeting.target_mob = none
        }
        return false
    }

    // `MeleeAttackGoal`, a zombie's `ZombieAttackGoal` where `zombie` (CAL-159): asked whether it
    // can be used once in 20 ticks of game time at most, with a target that's alive, and a path to
    // their block, reached within 0, or within its reach without one. As it starts, along that path
    // at its speed, aggressive, its counts reset; going on with its target alive while its
    // navigation isn't done, or for one that follows a target unseen, while their block's within its
    // home and they aren't in creative or spectating; as it stops, no more aggressive and its navigation stopped. Each tick, looking
    // at its target's eyes, 30 degrees a tick; where it sees them, or follows them unseen, and its
    // count's done, a path found again where they've gone a block from where it last found one, or
    // 1 in 20, drawn, its count 4 to 10, drawn, 5 more past 16 blocks and 10 past 32, and 15 more
    // without a path; then where it may attack, its cooldown done, within its reach and seen, its
    // cooldown 20 again, its main hand swung, `swingForAttack`, and the target hurt by it,
    // `doHurtTarget`, which its level does. A zombie's arms up from its fifth tick while its
    // cooldown's below half.
    fn melee_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Melee, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let heard = sounds.len()
        if call == GOAL_CAN_USE and self.species == FOX and (self.fox_flag(FOX_SITTING) or self.fox_flag(FOX_SLEEPING) or self.fox_flag(FOX_CROUCHING) or self.fox_flag(FOX_FACEPLANTED)) {
            // `FoxMeleeAttackGoal.canUse` (CAL-201): not sitting, asleep, crouching nor faceplanted.
            return false
        }
        if call == GOAL_CAN_USE and self.species == PANDA and not self.panda_can_act() {
            // `PandaAttackGoal.canUse` (CAL-201): only while it's free to act.
            return false
        }
        if call == GOAL_CAN_USE {
            if self.game_time - g.last_check < 20 {
                return false
            }
            g.last_check = self.game_time
            let p = self.target_in(players) else return false
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, floor_of(p.x), floor_of(p.y), floor_of(p.z), 0)
            // A drowned's, `DrownedAttackGoal`, only at a target it may take up (CAL-175).
            let fits = not g.drowned or ok_target(blocks, p)
            if g.path != none {
                return fits
            }
            return self.within_melee(p) and fits
        }
        if call == GOAL_CONTINUE {
            if self.spider_kind() and self.magic_light(blocks) >= 0.5f32 and self.living.body.random.next_int_below(100) == 0 {
                // `SpiderAttackGoal.canContinueToUse`: in the light, its target let go 1 in 100.
                self.target_to(none)
                return false
            }
            let p = self.target_in(players) else return false
            let fits = not g.drowned or ok_target(blocks, p)
            if not g.follow_unseen {
                return not self.navigation.is_done() and fits
            }
            // Its target's block within its home, `isWithinHome` (CAL-179).
            return self.within_home(p.x, p.y, p.z) and not (p.spectator or p.creative) and fits
        }
        if call == GOAL_START {
            if self.species == FOX {
                // `FoxMeleeAttackGoal.start` (CAL-201): no longer interested.
                self.set_fox_flag(FOX_INTERESTED, false)
            }
            let nf = nav_facts(lf, blocks, min_y)
            let w = self.walker(lf)
            _ = self.navigation.move_along(lf, f, nf, blocks, w, g.path.take(), g.speed)
            self.set_flag(AGGRESSIVE_FLAG, true)
            g.recalc = 0
            g.until_attack = 0
            g.raise_arm = 0
        } else if call == GOAL_STOP {
            if g.polar {
                // `PolarBearMeleeAttackGoal.stop`: no longer standing (CAL-201).
                self.set_standing(false)
            }
            self.set_flag(AGGRESSIVE_FLAG, false)
            self.navigation.stop()
        } else if call == GOAL_TICK {
            if let p = self.target_in(players) {
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
                g.recalc = if g.recalc - 1 > 0 { g.recalc - 1 } else { 0 }
                let me = self.looker()
                let seen = g.follow_unseen or sees_player(m, f, blocks, mut self.sensing, me, p)
                if seen and g.recalc <= 0 {
                    let dx = p.x - g.pathed_x
                    let dy = p.y - g.pathed_y
                    let dz = p.z - g.pathed_z
                    let unpathed = g.pathed_x == 0.0 and g.pathed_y == 0.0 and g.pathed_z == 0.0
                    if unpathed or dx * dx + dy * dy + dz * dz >= 1.0 or self.living.body.random.next_float() < 0.05f32 {
                        g.pathed_x = p.x
                        g.pathed_y = p.y
                        g.pathed_z = p.z
                        g.recalc = 4 + self.living.body.random.next_int_below(7)
                        let d = self.distance_sqr_to(p.x, p.y, p.z)
                        if d > 1024.0 {
                            g.recalc += 10
                        } else if d > 256.0 {
                            g.recalc += 5
                        }
                        let nf = nav_facts(lf, blocks, min_y)
                        let w = self.walker(lf)
                        let found = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, floor_of(p.x), floor_of(p.y), floor_of(p.z), 0)
                        let moving = if found == none { false } else { self.navigation.move_along(lf, f, nf, blocks, w, found, g.speed) }
                        if not moving {
                            g.recalc += 15
                        }
                    }
                }
                g.until_attack = if g.until_attack - 1 > 0 { g.until_attack - 1 } else { 0 }
                if g.polar {
                    // `PolarBearMeleeAttackGoal.checkAndPerformAttack` (CAL-201): where it may
                    // attack, its cooldown 20 again and the target hurt by it, no swing, and no
                    // longer standing; else within its target's width and 3 of it, standing down
                    // and its cooldown 20 again where it's done, and standing up with 10 ticks or
                    // fewer left, its warning heard where it may warn, `playWarningSound`, 40 ticks
                    // till it may again; else further, its cooldown 20 again, not standing.
                    if g.until_attack <= 0 and self.within_melee(p) and sees_player(m, f, blocks, mut self.sensing, me, p) {
                        g.until_attack = 20
                        let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                        self.living.show(Shown.Attack((p.id, ax, ay, az)), heard)
                        self.set_standing(false)
                    } else {
                        let w = match p.bounds {
                            some(b) => f32.nearest(b.max_x - b.min_x),
                            none => 0.6f32,
                        }
                        let near = (w + 3.0f32) * (w + 3.0f32)
                        if self.distance_sqr_to(p.x, p.y, p.z) < f64(near) {
                            if g.until_attack <= 0 {
                                self.set_standing(false)
                                g.until_attack = 20
                            }
                            if g.until_attack <= 10 {
                                self.set_standing(true)
                                if self.polar_warning <= 0 {
                                    self.make_sound(mut sounds, "entity.polar_bear.warning")
                                    self.polar_warning = 40
                                }
                            }
                        } else {
                            g.until_attack = 20
                            self.set_standing(false)
                        }
                    }
                } else if g.until_attack <= 0 and self.within_melee(p) and sees_player(m, f, blocks, mut self.sensing, me, p) {
                    g.until_attack = 20
                    // A fox's no swing, `FoxMeleeAttackGoal.checkAndPerformAttack` (CAL-201).
                    if self.species != FOX {
                        self.swing_for_attack(heard)
                    }
                    if self.species != CREEPER {
                        // A creeper's `doHurtTarget` does nothing.
                        if self.species == RAVAGER {
                            // `Ravager.doHurtTarget`: still for 10 ticks; its level shows the
                            // attack and sounds it (CAL-200).
                            self.attack_tick = 10
                        }
                        if self.species == PANDA and self.panda_variant() != GENE_AGGRESSIVE {
                            // `Panda.doHurtTarget`: one that isn't aggressive has bitten
                            // (CAL-201).
                            self.panda.did_bite = true
                        }
                        let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                        self.living.show(Shown.Attack((p.id, ax, ay, az)), heard)
                    }
                    if self.species == FOX {
                        // Its bite heard after (CAL-201).
                        self.living.play(mut sounds, String("entity.fox.bite"), 1.0f32, 1.0f32)
                    }
                }
            }
            if g.zombie {
                g.raise_arm += 1
                self.set_flag(AGGRESSIVE_FLAG, g.raise_arm >= 5 and g.until_attack < 10)
            }
        }
        return false
    }

    // `NeutralMob.updatePersistentAnger`, staying angry while it has a target (CAL-159): with one,
    // angry at them, by UUID, and for 20 to 39 seconds more from now, drawn; and where it was angry
    // at someone, that let go where its anger's run out and it has no player it may attack as its
    // target, or where they're a player in creative or spectating. Where its target's a mob it's
    // angry at, dead or dying, it stops being angry first, and that's all (CAL-244). Where it
    // doesn't `stay` angry while it has a target, a bee's, its anger's kept up only as its target's
    // new, and let go once it's run out, target or not (CAL-177).
    fn update_anger(mut self, players: List<Follower>, stay: bool) {
        let was = self.anger_target
        if let id = self.target {
            // `getTargetUnchecked`: a mob it's angry at that's dead or dying, which it's let go of
            // (CAL-244).
            if let p = self.followed(players, id) {
                if p.mob and p.dead and was != none and was == p.uuid {
                    self.stop_being_angry()
                    return
                }
            }
        }
        if let p = self.target_in(players) {
            let new = was == none or was != p.uuid
            if new {
                self.anger_target = p.uuid
            }
            if new or stay {
                self.start_anger_timer()
            }
        }
        if was != none and not self.angry() {
            var valid = false
            if let p = self.target_in(players) {
                valid = stay and not p.creative and not p.spectator and self.difficulty != 0
            }
            if not valid {
                self.stop_being_angry()
            }
        }
        for p in players {
            if was != none and p.uuid == was and (p.creative or p.spectator or self.difficulty == 0) {
                self.stop_being_angry()
            }
        }
    }

    /// An iron golem's attack's damage, `IronGolem.doHurtTarget` (CAL-201): its attack damage, a
    /// float, half of it and a whole number below it more, drawn, where its whole part's more
    /// than 0.
    pub fn golem_damage(mut self) -> f32 {
        let strength = f32.nearest(self.living.attributes.value(attribute_id(String("attack_damage")) ?? 0))
        let whole = i32.saturate(f64(strength))
        if whole <= 0 {
            return strength
        }
        return strength / 2.0f32 + f32.nearest(self.living.body.random.next_int_below(whole))
    }

    /// An iron golem's anger kept up, the last of its `aiStep`, after its pushes,
    /// `updatePersistentAnger` (CAL-201).
    pub fn golem_anger(mut self, players: List<Follower>) {
        self.update_anger(players, true)
    }

    /// An iron golem's `doPush` of the enemy `other`, no creeper (CAL-201): it taken up as its
    /// target 1 in 20, drawn, `setTarget`.
    pub fn golem_pushed(mut self, other: i32, players: List<Follower>) {
        if self.living.body.random.next_int_below(20) == 0 {
            self.set_target(some(other), players)
        }
    }

    // `startPersistentAngerTimer`, an enderman's (CAL-159): angry for 20 to 39 seconds more from
    // now, drawn, `setTimeToRemainAngry`.
    fn start_anger_timer(mut self) {
        let end = self.game_time + i64(400 + self.living.body.random.next_int_below(381))
        self.set_anger_end(end)
    }

    // `ResetUniversalAngerTargetGoal` (CAL-159), an enderman's, which alerts no others: used, and
    // kept on, while the game rule `universal_anger`'s on and who last hurt it is a player, since
    // it last started, by its tick count then, `wasHurtByPlayer`; as it starts, that kept, and
    // its anger at anyone in particular forgotten for anger at all, then, players,
    // `forgetCurrentTargetAndRefreshUniversalAnger`. Only players hurt mobs so far.
    fn reset_anger_goal(mut self, last: mut i32, call: i32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            return self.universal_anger and self.hurt_by_in(players) != none and self.living.hurt_by_mob_stamp > last
        }
        if call == GOAL_START {
            last = self.living.hurt_by_mob_stamp
            self.stop_being_angry()
            self.start_anger_timer()
        }
        return false
    }

    /// `NeutralMob.playerDied` of the player of the UUID `uuid`, their death told it where the
    /// game rule `forgive_dead_players` says so (CAL-159): where it's angry at them, it stops being
    /// angry. Only neutral mobs are ever angry at anyone.
    pub fn player_died(mut self, uuid: (i64, i64)) {
        if self.anger_target == some(uuid) {
            self.stop_being_angry()
        }
    }

    // `isAngry`: its anger's end still to come.
    fn angry(self) -> bool {
        let end = self.anger_end()
        return end > 0 and end - self.game_time > 0
    }

    // `getPersistentAngerEndTime` and `setPersistentAngerEndTime`: an enderman's kept, a bee's
    // sent, `DATA_ANGER_END_TIME` (CAL-177).
    fn anger_end(self) -> i64 {
        return if self.species == BEE { self.living.data.long(OWN + 1) } else if self.species == WOLF { self.living.data.long(OWN + 4) } else { self.anger_end_time }
    }

    fn set_anger_end(mut self, end: i64) {
        if self.species == BEE {
            self.living.data.set(OWN + 1, Value.Long(end))
        } else if self.species == WOLF {
            self.living.data.set(OWN + 4, Value.Long(end))
        } else {
            self.anger_end_time = end
        }
    }

    // `stopBeingAngry`: who last hurt it forgotten, as of its tick count now, no one it's angry at,
    // no target, and no end to its anger.
    fn stop_being_angry(mut self) {
        self.living.hurt_by_mob = none
        self.living.hurt_by_mob_stamp = self.living.body.tick_count
        self.anger_target = none
        self.target_to(none)
        self.set_anger_end(-1)
    }

    /// A bee let out of a hive a player broke near them, or near the hive they broke,
    /// `emptyAllLivingFromHive` and `angerNearbyBees` (CAL-177): targeting them, `setTarget`,
    /// where it's given one, and staying out of hives `stay_out` ticks where that's more than 0.
    pub fn broken_out(mut self, target: i32?, stay_out: i32) {
        if let t = target {
            self.target_to(some(t))
        }
        if stay_out > 0 {
            self.bee.stay_out = stay_out
        }
    }

    /// A bee's sting done, `Bee.doHurtTarget` (CAL-177): it's stung, `setHasStung`, and its anger's
    /// gone, `stopBeingAngry`.
    pub fn stung(mut self) {
        self.set_bee_flag(BEE_STUNG, true)
        self.stop_being_angry()
    }

    // `Enderman.isBeingStaredBy` of the player `p` (CAL-159): not disguised, and looking at its
    // eyes, `isLookingAtMe` within 0.025 over the distance of straight at them, the line from
    // their eyes to its clear of colliding blocks.
    fn stared_by<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, p: Follower) -> bool {
        if p.disguised {
            return false
        }
        // `calculateViewVector` of the player's turn, made a unit long.
        let rx = f64(p.x_rot * 0.017453292f32)
        let ry = f64(-p.y_rot * 0.017453292f32)
        let cy = table_cos(ry)
        let sy = table_sin(ry)
        let cx = table_cos(rx)
        let sx = table_sin(rx)
        var lx = f64(sy * cx)
        var ly = f64(-sx)
        var lz = f64(cy * cx)
        let ll = (lx * lx + ly * ly + lz * lz).sqrt()
        if ll < f64(1.0e-5f32) {
            lx = 0.0
            ly = 0.0
            lz = 0.0
        } else {
            lx = lx / ll
            ly = ly / ll
            lz = lz / ll
        }
        let gaze = self.living.body.y + f64(self.living.body.eyes)
        let peyes = p.y + f64(p.eyes)
        var dx = self.living.body.x - p.x
        var dy = gaze - peyes
        var dz = self.living.body.z - p.z
        let dist = (dx * dx + dy * dy + dz * dz).sqrt()
        if dist < f64(1.0e-5f32) {
            dx = 0.0
            dy = 0.0
            dz = 0.0
        } else {
            dx = dx / dist
            dy = dy / dist
            dz = dz / dist
        }
        let dot = lx * dx + ly * dy + lz * dz
        if not (dot > 1.0 - 0.025 / dist) {
            return false
        }
        let mover = Mover { y: p.y, fall: 0.0 }
        return sees(m, f, blocks, mover, p.x, peyes, p.z, self.living.body.x, gaze, self.living.body.z)
    }

    // `NeutralMob.isAngryAt` of the player `p` (CAL-159): one it may attack, and, where the game
    // rule `universal_anger`'s on and it's angry at no one in particular, at all players,
    // `isAngryAtAllPlayers`, unless they're in creative; else the one it's angry at, by UUID.
    fn angry_at(self, p: Follower) -> bool {
        if not p.enemy or self.difficulty == 0 {
            return false
        }
        if not p.creative and self.universal_anger and self.angry() and self.anger_target == none {
            return true
        }
        return self.anger_target != none and self.anger_target == p.uuid
    }

    // `EndermanFreezeWhenLookedAt` (CAL-159), `froze` the player it froze for: used where its
    // target's a player within 16 blocks who stares at it; as it starts, its path stopped; each
    // tick, looking at their eyes.
    fn freeze_goal<B: CollisionBlocks>(mut self, froze: mut i32, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            froze = -1
            let p = self.target_in(players) else return false
            froze = p.id
            if self.distance_sqr_to(p.x, p.y, p.z) > 256.0 {
                return false
            }
            return self.stared_by(f, m, blocks, p)
        }
        if call == GOAL_START {
            self.navigation.stop()
        } else if call == GOAL_TICK {
            for p in players {
                if p.id == froze {
                    self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, HEAD_ROT_SPEED, self.max_head_x_rot())
                }
            }
        }
        return false
    }

    // `EndermanLookForPlayerGoal` (CAL-159): used where a player it may attack within its follow
    // range stares at it or is one it's angry at, the nearest, `pendingTarget`. As it starts, its
    // aggro count 3 ticks of its target goals, and stared at, `setBeingStaredAt`. Going on with
    // that player while they stare or it's angry at them, turned to them at once, 10 degrees, else
    // with the target it took up while it may attack them, seen or not, else as `TargetGoal` goes
    // on. Each tick, with no target, it lets its go; its count out, it takes the player up,
    // `setTarget`; after that, staring, they make it teleport away within 4 blocks, else past 16
    // it teleports toward them once 15 of these ticks are by. As it stops, no target.
    fn ender_look_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut EnderLook, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            g.pending = -1
            let range = self.living.attributes.value(lf.follow_range)
            var best = -1.0
            for p in players {
                if p.spectator or p.dead or not (self.stared_by(f, m, blocks, p) or self.angry_at(p)) {
                    continue
                }
                if not p.enemy or self.difficulty == 0 {
                    continue
                }
                let visibility = p.visibility(i32.wrap(self.living.kind))
                let within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
                let d = self.distance_sqr_to(p.x, p.y, p.z)
                if d > within * within {
                    continue
                }
                let me = self.looker()
                if not sees_player(m, f, blocks, mut self.sensing, me, p) {
                    continue
                }
                if best < 0.0 or d < best {
                    best = d
                    g.pending = p.id
                }
            }
            return g.pending >= 0
        }
        if call == GOAL_CONTINUE {
            if g.pending >= 0 {
                for p in players {
                    if p.id == g.pending and (self.stared_by(f, m, blocks, p) or self.angry_at(p)) {
                        self.look_at_now(p, 10.0f32, 10.0f32)
                        return true
                    }
                }
                return false
            }
            if g.target >= 0 {
                for p in players {
                    if p.id == g.target and not p.spectator and not p.dead and p.enemy and self.difficulty != 0 {
                        return true
                    }
                }
            }
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            g.aggro_time = reduced_tick_delay(5)
            g.teleport_time = 0
            self.living.data.set(MONSTER_OWN + 2, Value.Bool(true))
        } else if call == GOAL_STOP {
            g.pending = -1
            self.target_to(none)
            g.target = -1
            g.targeting.target_mob = none
        } else if call == GOAL_TICK {
            if self.target_in(players) == none {
                g.target = -1
            }
            if g.pending >= 0 {
                g.aggro_time -= 1
                if g.aggro_time <= 0 {
                    g.target = g.pending
                    g.pending = -1
                    self.set_target(some(g.target), players)
                    g.targeting.unseen_ticks = 0
                }
            } else if g.target >= 0 {
                for p in players {
                    if p.id == g.target {
                        let d = self.distance_sqr_to(p.x, p.y, p.z)
                        if self.stared_by(f, m, blocks, p) {
                            if d < 16.0 {
                                _ = self.teleport(lf, f, m, blocks, min_y, mut sounds)
                            }
                            g.teleport_time = 0
                        } else if d > 256.0 {
                            let due = g.teleport_time >= reduced_tick_delay(30)
                            g.teleport_time += 1
                            if due and self.teleport_towards(lf, f, m, blocks, min_y, p, mut sounds) {
                                g.teleport_time = 0
                            }
                        }
                    }
                }
            }
        }
        return false
    }

    // `EndermanTakeBlockGoal` where `take`, else `EndermanLeaveBlockGoal` (CAL-159): used, with
    // mob griefing on, 1 in 10 ticks of its goals, or 1 in 1000 to leave one, drawn, where it
    // carries nothing to take one and something to leave it, and going on while that holds and
    // the draw does again. Its tick draws a place near it, x, y then z: within 2 blocks across
    // and 3 up to take one, the block there taken where it's one it may hold,
    // `#enderman_holdable`, and the outlines from the middle of its own block at that height to
    // the middle of that one meet nothing before it, `clip_outline`, for its level to take,
    // `Shown.Took`; within 1 across and 2 up to leave it, for its level to place where it may,
    // `Shown.Left`.
    fn block_goal<B: CollisionBlocks>(mut self, call: i32, take: bool, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, heard: usize) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let carrying = self.carried() != none
            if carrying == take or not self.mob_griefing {
                return false
            }
            let chance = if take { reduced_tick_delay(20) } else { reduced_tick_delay(2000) }
            return self.living.body.random.next_int_below(chance) == 0
        }
        if call != GOAL_TICK {
            return false
        }
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        if take {
            let xt = floor_of(x - 2.0 + self.living.body.random.next_double() * 4.0)
            let yt = floor_of(y + self.living.body.random.next_double() * 3.0)
            let zt = floor_of(z - 2.0 + self.living.body.random.next_double() * 4.0)
            let state = state_at(blocks, xt, yt, zt)
            let (bx, _, bz) = self.block_position()
            let hit = clip_outline(f, m, blocks, (f64(bx) + 0.5, f64(yt) + 0.5, f64(bz) + 0.5), (f64(xt) + 0.5, f64(yt) + 0.5, f64(zt) + 0.5))
            if f.in_set(state, lf.enderman_holdable) and hit.bx == xt and hit.by == yt and hit.bz == zt {
                self.living.show(Shown.Took((xt, yt, zt)), heard)
            }
            return false
        }
        let xt = floor_of(x - 1.0 + self.living.body.random.next_double() * 2.0)
        let yt = floor_of(y + self.living.body.random.next_double() * 2.0)
        let zt = floor_of(z - 1.0 + self.living.body.random.next_double() * 2.0)
        self.living.show(Shown.Left((xt, yt, zt)), heard)
        return false
    }

    // `Enderman.customServerAiStep` (CAL-159): bright outside, 600 ticks or more since it took up
    // a target or let one go, in light over half at its eyes where its block sees the sky, a draw
    // under twice what's over 0.4 of thirty, and it lets its target go and teleports.
    fn daylight_step<B: CollisionBlocks + MobLight>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) {
        if not blocks.bright_outside() or self.living.body.tick_count < self.target_change_time + 600 {
            return
        }
        let br = self.magic_light(blocks)
        if br > 0.5f32 and blocks.sees_sky(floor_of(self.living.body.x), floor_of(self.living.body.y), floor_of(self.living.body.z)) and self.living.body.random.next_float() * 30.0f32 < (br - 0.4f32) * 2.0f32 {
            self.target_to(none)
            _ = self.teleport(lf, f, m, blocks, min_y, mut sounds)
        }
    }

    // `Enderman.teleport()` (CAL-159): to a place drawn within 32 across and up or down.
    fn teleport<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if not self.living.alive() {
            return false
        }
        let x = self.living.body.x + (self.living.body.random.next_double() - 0.5) * 64.0
        let y = self.living.body.y + f64(self.living.body.random.next_int_below(64) - 32)
        let z = self.living.body.z + (self.living.body.random.next_double() - 0.5) * 64.0
        return self.teleport_to(lf, f, m, blocks, min_y, x, y, z, mut sounds)
    }

    // `teleportTowards` the player `p` (CAL-159): 16 blocks along the way from it to their eyes,
    // and a place drawn within 4 across and 8 up or down of that.
    fn teleport_towards<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, p: Follower, sounds: mut List<EntitySound>) -> bool {
        var dx = self.living.body.x - p.x
        var dy = self.living.body.y + f64(self.living.body.height) * 0.5 - (p.y + f64(p.eyes))
        var dz = self.living.body.z - p.z
        let d = (dx * dx + dy * dy + dz * dz).sqrt()
        if d < f64(1.0e-5f32) {
            dx = 0.0
            dy = 0.0
            dz = 0.0
        } else {
            dx = dx / d
            dy = dy / d
            dz = dz / d
        }
        let x = self.living.body.x + (self.living.body.random.next_double() - 0.5) * 8.0 - dx * 16.0
        let y = self.living.body.y + f64(self.living.body.random.next_int_below(16) - 8) - dy * 16.0
        let z = self.living.body.z + (self.living.body.random.next_double() - 0.5) * 8.0 - dz * 16.0
        return self.teleport_to(lf, f, m, blocks, min_y, x, y, z, mut sounds)
    }

    // `Enderman.teleport(x, y, z)` (CAL-159): `randomTeleport` there, avoiding what endermen don't
    // teleport to; teleported, unless it's silent, the teleport's level event at its old block
    // with how far it went, 2018, and its teleport sound twice, both where it is now.
    fn teleport_to<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, x: f64, y: f64, z: f64, sounds: mut List<EntitySound>) -> bool {
        let ox = floor_of(self.living.body.x)
        let oy = floor_of(self.living.body.y)
        let oz = floor_of(self.living.body.z)
        if not self.random_teleport(lf, f, m, blocks, min_y, x, y, z, true, sounds.len()) {
            return false
        }
        if not self.living.data.flag(SILENT) {
            let px = (clamp_i(floor_of(self.living.body.x) - ox) + 127) & 255
            let py = (clamp_i(floor_of(self.living.body.y) - oy) + 127) & 255
            let pz = (clamp_i(floor_of(self.living.body.z) - oz) + 127) & 255
            let packed = (px << 16) | (py << 8) | pz
            self.living.show(Shown.Level((2018, ox, oy, oz, packed)), sounds.len())
            self.living.play(mut sounds, String("entity.enderman.teleport"), 1.0f32, 1.0f32)
            self.living.play(mut sounds, String("entity.enderman.teleport"), 1.0f32, 1.0f32)
        }
        return true
    }

    // `LivingEntity.randomTeleport` to x, y, z (CAL-159), where `random_teleport_spot` finds a
    // place within its border: onto no block it avoids, an enderman's
    // `#enderman_does_not_teleport_to` where `ender`, else a cat's `#cat_does_not_teleport_to`
    // (CAL-201), and for an enderman, not over water, `canRandomlyTeleportTo`. There,
    // `teleportTo`, an enderman's particles shown, entity event 46, and its path stopped.
    fn random_teleport<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, wx: f64, y: f64, wz: f64, ender: bool, heard: usize) -> bool {
        let border = self.border ?? widest_border()
        let (width, height) = (self.living.body.width, self.living.body.height)
        let spot = if ender {
            random_teleport_spot(f, m, blocks, lf.teleport_onto, lf.enderman_avoids, min_y, border, wx, y, wz, width, height, true)
        } else {
            random_teleport_spot(f, m, blocks, lf.teleport_onto, lf.cat_avoids, min_y, border, wx, y, wz, width, height, false)
        }
        let (tx, ty, tz) = spot else return false
        let (yr, xr) = (self.living.body.y_rot, self.living.body.x_rot)
        self.living.snap_to(tx, ty, tz, yr, xr)
        if ender {
            self.living.show(Shown.Event(46i8), heard)
        }
        self.navigation.stop()
        return true
    }

    // A creeper's `SwellGoal` (CAL-159), `kept` the entity ID of the target it took up as it
    // started: used while it swells, or with a target that isn't dying within 3 blocks. As it
    // starts, its path stopped and its target kept; as it stops, let go. Each tick it swells,
    // `setSwellDir(1)`, at the target it kept while they're alive within 7 blocks and in its sight,
    // else it shrinks.
    fn swell_goal<B: CollisionBlocks>(mut self, kept: mut i32, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            if self.living.data.number(MONSTER_OWN) > 0 {
                return true
            }
            let p = self.target_in(players) else return false
            return not p.dead and self.distance_sqr_to(p.x, p.y, p.z) < 9.0
        }
        if call == GOAL_START {
            self.navigation.stop()
            kept = -1
            if let p = self.target_in(players) {
                kept = p.id
            }
        } else if call == GOAL_STOP {
            kept = -1
        } else if call == GOAL_TICK {
            var dir = -1
            for p in players {
                if p.id == kept and not p.dead {
                    let me = self.looker()
                    if not (self.distance_sqr_to(p.x, p.y, p.z) > 49.0) and sees_player(m, f, blocks, mut self.sensing, me, p) {
                        dir = 1
                    }
                }
            }
            self.living.data.set(MONSTER_OWN, Value.Number(dir))
        }
        return false
    }

    // `LeapAtTargetGoal`, `up` blocks a tick up (CAL-159): used with a target 2 to 4 blocks off
    // while it's on the ground, 1 in 3 ticks, drawn, and going on till it's on the ground again. As
    // it starts, it leaps: across toward them at 0.4 and a fifth of how it was moving, and up.
    fn leap_goal(mut self, call: i32, up: f32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            // Not while a mob steers it, `hasControllingPassenger` (D710).
            if self.controlled {
                return false
            }
            let p = self.target_in(players) else return false
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            if d < 4.0 or d > 16.0 or not self.living.body.on_ground {
                return false
            }
            return self.living.body.random.next_int_below(reduced_tick_delay(5)) == 0
        }
        if call == GOAL_CONTINUE {
            return not self.living.body.on_ground
        }
        if call == GOAL_START {
            let p = self.target_in(players) else return false
            var dx = p.x - self.living.body.x
            var dz = p.z - self.living.body.z
            if dx * dx + dz * dz > 1.0e-7 {
                let length = (dx * dx + dz * dz).sqrt()
                var nx = 0.0
                var nz = 0.0
                if not (length < f64(1.0e-5f32)) {
                    nx = dx / length
                    nz = dz / length
                }
                dx = nx * 0.4 + self.living.body.vx * 0.2
                dz = nz * 0.4 + self.living.body.vz * 0.2
            }
            self.living.body.vx = dx
            self.living.body.vy = f64(up)
            self.living.body.vz = dz
        }
        return false
    }

    // `RangedBowAttackGoal` (CAL-159): used with a target while it holds a bow, and going on while
    // it has one or its path isn't done, still holding it. As it starts, aggressive; as it stops,
    // not, its counts reset and its bow let go, `stopUsingItem`. Each tick, with its target: how
    // long it's seen them, or not, counted, from 0 again as that changes; within its reach and seen
    // for 20 ticks, its path stopped and its strafing counted on, else a path to them, `moveTo`,
    // and no strafing. After 20 ticks of strafing, a draw of 0.3 for each way it turns about;
    // strafing, backwards where they're within half its reach, forwards past three quarters of it,
    // turned to them at once, `Mob.lookAt`, 30 degrees a tick, else looking at their eyes. Drawing,
    // it lets go where it's lost them for 60 ticks, or, seeing them, shoots once it's drawn 20
    // ticks, `performRangedAttack` with the bow's power then, its interval till it draws again;
    // else it draws once its count's out, unless it's lost them for 60 ticks, from the hand that
    // holds the bow, `startUsingItem`.
    fn bow_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Bow, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            return self.target_in(players) != none and self.holding_bow()
        }
        if call == GOAL_CONTINUE {
            return (self.target_in(players) != none or not self.navigation.is_done()) and self.holding_bow()
        }
        if call == GOAL_START {
            self.set_flag(AGGRESSIVE_FLAG, true)
        } else if call == GOAL_STOP {
            self.set_flag(AGGRESSIVE_FLAG, false)
            g.see_time = 0
            g.attack_time = -1
            self.living.stop_using()
        } else if call == GOAL_TICK {
            let p = self.target_in(players) else return false
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            let me = self.looker()
            let sight = sees_player(m, f, blocks, mut self.sensing, me, p)
            if sight != (g.see_time > 0) {
                g.see_time = 0
            }
            if sight {
                g.see_time += 1
            } else {
                g.see_time -= 1
            }
            if not (d > f64(g.radius_sqr)) and g.see_time >= 20 {
                self.navigation.stop()
                g.strafing_time += 1
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, g.speed)
                g.strafing_time = -1
            }
            if g.strafing_time >= 20 {
                if f64(self.living.body.random.next_float()) < 0.3 {
                    g.clockwise = not g.clockwise
                }
                if f64(self.living.body.random.next_float()) < 0.3 {
                    g.backwards = not g.backwards
                }
                g.strafing_time = 0
            }
            if g.strafing_time > -1 {
                if d > f64(g.radius_sqr * 0.75f32) {
                    g.backwards = false
                } else if d < f64(g.radius_sqr * 0.25f32) {
                    g.backwards = true
                }
                let forwards = if g.backwards { -0.5f32 } else { 0.5f32 }
                let right = if g.clockwise { 0.5f32 } else { -0.5f32 }
                self.moves.strafe(forwards, right)
                // What it steers turned toward them too, `vehicle.lookAt`, as its level does once
                // its tick's done (D710).
                if self.steered {
                    self.turns_vehicle = some(p.copy())
                }
                self.look_at_now(p, 30.0f32, 30.0f32)
            } else {
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
            }
            if self.living.using_item() {
                if not sight and g.see_time < -60 {
                    self.living.stop_using()
                } else if sight {
                    let pull = self.living.ticks_using()
                    if pull >= 20 {
                        self.living.stop_using()
                        self.ranged_attack(p, bow_power(pull), mut sounds)
                        g.attack_time = g.interval
                    }
                }
            } else {
                g.attack_time -= 1
                if g.attack_time <= 0 and g.see_time >= -60 {
                    let hand: usize = if self.main_is_bow() { 0 } else { 1 }
                    self.living.start_using(hand, sounds.len())
                }
            }
        }
        return false
    }

    // `RangedCrossbowAttackGoal` (CAL-200): used with a target alive while it holds a crossbow,
    // and going on so. As it stops, not aggressive, no target, its sight's count reset and its
    // crossbow let go, `stopUsingItem`, still charged where it was, as vanilla's empties only the
    // stack its use left, none. Each tick, with its target: how long it's seen them, or not,
    // counted, from 0 again as that changes; where they're beyond its reach or not seen for 5
    // ticks, and it's not waiting to shoot, a path to them every 1 to 2 seconds, drawn, at its
    // speed, half while its crossbow's charging or charged; else its path stopped. Looking at them,
    // 30 degrees a tick. Its crossbow: uncharged, where it needn't move, it starts using it,
    // charging; charging, once it's used it its charge's length, `getChargeDuration`, let go,
    // `releaseUsingItem`, charged, waiting 20 to 39 ticks, drawn; charged, ready once that's done;
    // ready, seeing them, its shot, `performCrossbowAttack`, and uncharged again.
    fn crossbow_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Crossbow, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let p = self.target_in(players) else return false
            return not p.dead and self.holding_crossbow()
        }
        if call == GOAL_STOP {
            self.set_flag(AGGRESSIVE_FLAG, false)
            self.target_to(none)
            g.see_time = 0
            if self.living.using_item() {
                self.living.stop_using()
                self.living.data.set(MONSTER_OWN + 1, Value.Bool(false))
            }
            return false
        }
        if call != GOAL_TICK {
            return false
        }
        let p = self.target_in(players) else return false
        let me = self.looker()
        let sight = sees_player(m, f, blocks, mut self.sensing, me, p)
        if sight != (g.see_time > 0) {
            g.see_time = 0
        }
        if sight {
            g.see_time += 1
        } else {
            g.see_time -= 1
        }
        let d = self.distance_sqr_to(p.x, p.y, p.z)
        let needs_to_move = (d > f64(g.radius_sqr) or g.see_time < 5) and g.attack_delay == 0
        if needs_to_move {
            g.update_path_delay -= 1
            if g.update_path_delay <= 0 {
                let speed = if g.state == CROSSBOW_UNCHARGED { g.speed } else { g.speed * 0.5 }
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, speed)
                g.update_path_delay = 20 + self.living.body.random.next_int_below(21)
            }
        } else {
            g.update_path_delay = 0
            self.navigation.stop()
        }
        self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
        if g.state == CROSSBOW_UNCHARGED {
            if not needs_to_move {
                let hand = self.crossbow_hand()
                self.living.start_using(hand, sounds.len())
                g.state = CROSSBOW_CHARGING
                self.living.data.set(MONSTER_OWN + 1, Value.Bool(true))
            }
        } else if g.state == CROSSBOW_CHARGING {
            if not self.living.using_item() {
                g.state = CROSSBOW_UNCHARGED
            }
            let pull = self.living.ticks_using()
            if pull >= charge_duration(self.living.use_item.copy()) {
                self.release_crossbow(mut sounds)
                g.state = CROSSBOW_CHARGED
                g.attack_delay = 20 + self.living.body.random.next_int_below(20)
                self.living.data.set(MONSTER_OWN + 1, Value.Bool(false))
            }
        } else if g.state == CROSSBOW_CHARGED {
            g.attack_delay -= 1
            if g.attack_delay == 0 {
                g.state = CROSSBOW_READY
            }
        } else if g.state == CROSSBOW_READY and sight {
            self.crossbow_attack(p, sounds.len())
            g.state = CROSSBOW_UNCHARGED
        }
        return false
    }

    // The target a spear may be used on, `ableToAttack` (CAL-200): its target, there, where its
    // main hand holds a spear, `KINETIC_WEAPON`.
    fn spear_target(self, brain: Brain) -> Near? {
        if not self.held_kinetic {
            return none
        }
        let id = brain.entity(MEMORY_ATTACK_TARGET) else return none
        return self.near_of(id)
    }

    // `SpearAttack.tick` (CAL-200): its target looked at, its time engaged counted down; with a
    // place to charge from, walked to at the second speed, forgotten once its path's done; else its
    // target charged at the first, and within so far or its path done, a place 6 to 7 from them
    // less how far they are found, each 2 further where it rides, `getPosAway`, and kept, or none.
    fn spear_attack_tick<B: CollisionBlocks + MobLight + NavLevel>(mut self, brain: mut Brain, s: (f64, f64, f32), lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        let (charging, repositioning, radius) = s
        let id = brain.entity(MEMORY_ATTACK_TARGET) else return
        let n = self.near_of(id) else return
        let d = self.distance_sqr_to(n.x, n.y, n.z)
        let mount = if self.living.body.vehicle != none { 2.0 } else { 0.0 }
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
        let engaged = brain.int(MEMORY_SPEAR_ENGAGE_TIME) ?? 0
        brain.set(MEMORY_SPEAR_ENGAGE_TIME, Memo.Int(engaged - 1))
        if let p = brain.point(MEMORY_SPEAR_CHARGE_POSITION) {
            let (x, y, z) = p
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, x, y, z, repositioning)
            if self.navigation.is_done() {
                brain.erase(MEMORY_SPEAR_CHARGE_POSITION)
            }
        } else {
            _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, n.x, n.y, n.z, charging)
            if d < f64(radius * radius) or self.navigation.is_done() {
                let distance = d.sqrt()
                match self.pos_away(lf, f, blocks, mut cache, min_y, 6.0 + mount - distance, 7.0 + mount - distance, (n.x, n.y, n.z)) {
                    some(p) => brain.set(MEMORY_SPEAR_CHARGE_POSITION, Memo.Point(p)),
                    none => brain.erase(MEMORY_SPEAR_CHARGE_POSITION),
                }
            }
        }
    }

    // `CrossbowAttack.checkExtraStartConditions` (CAL-200): holding a crossbow, its target among
    // those it sees, `BehaviorUtils.canSee`, and within its range, `isWithinAttackRange`.
    fn crossbow_may_attack<B: CollisionBlocks>(mut self, brain: mut Brain, f: Facts, m: MovementStates, blocks: B) -> bool {
        if not self.holding_crossbow() {
            return false
        }
        let id = brain.entity(MEMORY_ATTACK_TARGET) else return false
        let n = self.near_of(id) else return false
        return self.sees_near(mut brain, id, f, m, blocks) and self.attack_range_reaches(n, 0)
    }

    // `BehaviorUtils.isWithinAttackRange` of `n` (CAL-200): where its main hand holds a crossbow
    // it may use, a piglin's, `canUseNonMeleeWeapon`, within the crossbow's range, 8, less
    // `margin`, `closerThan`; else within its reach, `isWithinMeleeAttackRange`.
    fn attack_range_reaches(self, n: Near, margin: i32) -> bool {
        if self.species == PIGLIN and held_name(self.living.equipment[0]) == "minecraft:crossbow" {
            let most = f64(8 - margin)
            return self.distance_sqr_to(n.x, n.y, n.z) < most * most
        }
        return self.melee_reaches(n.bounds)
    }

    // `CrossbowAttack.tick` (CAL-200): its target looked at, its eyes; its crossbow uncharged,
    // used, charging; charging, uncharged where its use stopped, and once it's used it its
    // charge's length, `getChargeDuration`, let go, `releaseUsingItem`, charged, waiting 20 to 39
    // ticks, drawn from its own random, no longer charging; charged, ready once that's done;
    // ready, its shot, `performRangedAttack`, a piglin's `performCrossbowAttack` at 1.6, and
    // uncharged again.
    fn crossbow_tick(mut self, brain: mut Brain, keep: mut Keep, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        let id = brain.entity(MEMORY_ATTACK_TARGET) else return
        brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
        if keep.crossbow_state == CROSSBOW_UNCHARGED {
            let hand = self.crossbow_hand()
            self.living.start_using(hand, sounds.len())
            keep.crossbow_state = CROSSBOW_CHARGING
            self.living.data.set(MONSTER_OWN + 2, Value.Bool(true))
        } else if keep.crossbow_state == CROSSBOW_CHARGING {
            if not self.living.using_item() {
                keep.crossbow_state = CROSSBOW_UNCHARGED
            }
            let pull = self.living.ticks_using()
            if pull >= charge_duration(self.living.use_item.copy()) {
                // Its loading's end, as it lets go, draws from the level's random, which its brain
                // holds as it ticks.
                self.level_random = some(random.copy())
                self.release_crossbow(mut sounds)
                if let back = self.level_random.take() {
                    random = back
                }
                keep.crossbow_state = CROSSBOW_CHARGED
                keep.attack_delay = 20 + self.living.body.random.next_int_below(20)
                self.living.data.set(MONSTER_OWN + 2, Value.Bool(false))
            }
        } else if keep.crossbow_state == CROSSBOW_CHARGED {
            keep.attack_delay -= 1
            if keep.attack_delay == 0 {
                keep.crossbow_state = CROSSBOW_READY
            }
        } else if keep.crossbow_state == CROSSBOW_READY {
            if let n = self.near_of(id) {
                self.crossbow_attack_at(n.id, n.x, n.y, n.z, f64(f32.nearest(n.bounds.max_y - n.bounds.min_y)), sounds.len())
            }
            keep.crossbow_state = CROSSBOW_UNCHARGED
        }
    }

    // `isHolding(Items.CROSSBOW)` (CAL-200).
    fn holding_crossbow(self) -> bool {
        return held_name(self.living.equipment[0]) == "minecraft:crossbow" or held_name(self.living.equipment[1]) == "minecraft:crossbow"
    }

    // `ProjectileUtil.getWeaponHoldingHand` of a crossbow (CAL-200): its main hand where that holds
    // one, else its off hand.
    fn crossbow_hand(self) -> usize {
        return if held_name(self.living.equipment[0]) == "minecraft:crossbow" { 0 } else { 1 }
    }

    // `releaseUsingItem` of its crossbow (CAL-200): where it still holds what it uses, its use
    // ticked once more, as a crossbow's used on its release, `useOnRelease`, then stopped.
    fn release_crossbow(mut self, sounds: mut List<EntitySound>) {
        if self.living.using_item() {
            let held = self.living.equipment[self.crossbow_hand()].copy()
            if held != none and held_name(held) == held_name(self.living.use_item.copy()) {
                if let left = self.living.updating_using() {
                    self.crossbow_use_tick(left, mut sounds)
                }
            }
        }
        self.living.stop_using()
    }

    // `CrossbowItem.onUseTick` with `left` of its use's ticks left (CAL-200): how far it's charged,
    // its use's ticks over its charge's length; under a fifth, its sounds not yet played, as the
    // crossbow item keeps them, which its level lends it, `crossbow_sounds`; from a fifth, once,
    // its loading's start, at half volume from the players' source, and from half its middle,
    // each its charging sounds', a quick charge's own, `crossbow_charging_sounds`; charged and
    // not loaded, its projectiles loaded, `tryLoadProjectiles`, and its loading's end from its own
    // sounds' source, its pitch drawn from its level's random.
    fn crossbow_use_tick(mut self, left: i32, sounds: mut List<EntitySound>) {
        let stack = self.living.use_item.copy() else return
        if held_name(some(stack.copy())) != "minecraft:crossbow" {
            return
        }
        let used = 72000 - left
        let pct = f32.nearest(used) / f32.nearest(charge_duration(some(stack.copy())))
        if pct < 0.2f32 {
            self.crossbow_sounds = (false, false)
        }
        let quick = own_enchantment_level(some(stack.copy()), "minecraft:quick_charge")
        let (start, mid) = self.crossbow_sounds
        if pct >= 0.2f32 and not start {
            self.crossbow_sounds = (true, mid)
            let q = if quick > 3 { 3 } else { quick }
            let sound = if quick > 0 { "item.crossbow.quick_charge_{q}" } else { String("item.crossbow.loading_start") }
            sounds.push(EntitySound { sound: sound, x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 0.5f32, pitch: 1.0f32, source: PLAYERS_SOURCE })
        }
        let (now_start, now_mid) = self.crossbow_sounds
        if pct >= 0.5f32 and not now_mid {
            self.crossbow_sounds = (now_start, true)
            if quick == 0 {
                sounds.push(EntitySound { sound: String("item.crossbow.loading_middle"), x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 0.5f32, pitch: 1.0f32, source: PLAYERS_SOURCE })
            }
        }
        if pct >= 1.0f32 and not crossbow_charged(stack.copy()) {
            self.load_crossbow()
            // Its pitch drawn from its level's random, which its level lends it.
            var pitch = 1.0f32
            if let lent = self.level_random.take() {
                var r = lent
                pitch = 1.0f32 / (r.next_float() * 0.5f32 + 1.0f32) + 0.2f32
                self.level_random = some(r)
            }
            sounds.push(EntitySound { sound: String("item.crossbow.loading_end"), x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 1.0f32, pitch: pitch, source: self.living.body.sound_source })
        }
    }

    // `tryLoadProjectiles` for a mob (CAL-200): what it'd shoot, `Monster.getProjectile`, an arrow
    // it holds, its off hand's first, else an arrow; one of it, then, for each more of multishot's
    // `projectile_count`, a copy that's only seen, `INTANGIBLE_PROJECTILE`; its crossbow, in the
    // hand it uses and its use, charged with them, `CHARGED_PROJECTILES`.
    fn load_crossbow(mut self) {
        var item = stack_of(String("minecraft:arrow"))
        if is_arrow_item(held_name(self.living.equipment[1])) {
            item = one_of(self.living.equipment[1].copy())
        } else if is_arrow_item(held_name(self.living.equipment[0])) {
            item = one_of(self.living.equipment[0].copy())
        }
        let hand = self.used_hand_slot()
        let weapon = self.living.equipment[hand].copy() else return
        // Multishot's `projectile_count`, 2 more at its first level and 2 more each level on,
        // `processProjectileCount` from 1.
        let multishot = own_enchantment_level(some(weapon.copy()), "minecraft:multishot")
        let count = if multishot > 0 { 1 + 2 * multishot } else { 1 }
        // Each as `ItemStackTemplate` writes it, its count of 1 left out.
        var loaded = List<Tag>()
        loaded.push(uncounted(item.copy()))
        for _ in 1..count {
            loaded.push(uncounted(with_component(item.copy(), "minecraft:intangible_projectile", Tag.Compound(JavaHashMap<String, Tag>()))))
        }
        let charged = with_component(weapon, "minecraft:charged_projectiles", Tag.List(loaded))
        self.living.equipment[hand] = some(charged.copy())
        self.living.use_item = some(charged)
    }

    // The hand it uses, `getUsedItemHand`, as an equipment slot.
    fn used_hand_slot(self) -> usize {
        return self.living.used_hand()
    }

    // `CrossbowAttackMob.performCrossbowAttack` at `p` (CAL-200): from the hand that holds a
    // crossbow, its charge taken off, `ChargedProjectiles.EMPTY`, and where it held any, its shot
    // at 1.6 blocks a tick, which its level makes, `performShooting`; then its idleness reset,
    // `onCrossbowAttackPerformed`.
    fn crossbow_attack(mut self, p: Follower, heard: usize) {
        self.crossbow_attack_at(p.id, p.x, p.y, p.z, f64(p.height), heard)
    }

    // `performCrossbowAttack` at the target `target`, where it stands and how tall it is (CAL-200).
    fn crossbow_attack_at(mut self, target: i32, x: f64, y: f64, z: f64, height: f64, heard: usize) {
        let hand = self.crossbow_hand()
        if let weapon = self.living.equipment[hand].copy() {
            if held_name(some(weapon.copy())) == "minecraft:crossbow" {
                let projectiles = charged_of(weapon.copy())
                let emptied = without_component(weapon, "minecraft:charged_projectiles")
                self.living.equipment[hand] = some(emptied.copy())
                if not projectiles.is_empty() {
                    let shot = CrossbowShot {
                        owner: self.living.body.uuid,
                        x: self.living.body.x,
                        y: self.living.body.y,
                        z: self.living.body.z,
                        eye_y: self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32),
                        source: self.living.body.sound_source,
                        target: target,
                        tx: x,
                        ty: y + height * 0.3333333333333333,
                        tz: z,
                        power: 1.6f32,
                        projectiles: projectiles,
                        weapon: emptied,
                        hand: hand,
                    }
                    self.living.show(Shown.CrossbowShot(shot), heard)
                }
            }
        }
        self.no_action_time = 0
    }

    // `Mob.lookAt` of the player `p` (CAL-159): turned toward their eyes at once, `max_y` and
    // `max_x` degrees at most, its pitch first, kept within a right angle as `setXRot` keeps it.
    pub fn look_at_now(mut self, p: Follower, max_y: f32, max_x: f32) {
        self.look_at_point(p.x, p.y + f64(p.eyes), p.z, max_y, max_x)
    }

    // `Mob.lookAt` of what's at x, y, z, `y` its eyes or, not living, its box's middle (CAL-402).
    fn look_at_point(mut self, px: f64, py: f64, pz: f64, max_y: f32, max_x: f32) {
        let xd = px - self.living.body.x
        let zd = pz - self.living.body.z
        let yd = py - (self.living.body.y + f64(self.living.body.eyes))
        let sd = (xd * xd + zd * zd).sqrt()
        let y_rot = f32.nearest((table_atan2(zd, xd) ?? 0.0) * RAD_TO_DEG) - 90.0f32
        let x_rot = f32.nearest(-((table_atan2(yd, sd) ?? 0.0) * RAD_TO_DEG))
        let pitched = mob_rotlerp(self.living.body.x_rot, x_rot, max_x) % 360.0f32
        self.living.body.x_rot = if pitched < -90.0f32 { -90.0f32 } else if pitched > 90.0f32 { 90.0f32 } else { pitched }
        self.living.body.y_rot = mob_rotlerp(self.living.body.y_rot, y_rot, max_y)
    }

    // `AbstractSkeleton.performRangedAttack` at the player `p`, the bow drawn to `power` (CAL-159):
    // its shot, `Shown.Fired`, whose arrow its level makes, `getMobArrow`, from its eyes a tenth
    // below, of what it'd shoot, `getProjectile`, an arrow it holds, the off hand's first, else an
    // arrow, one of it, from the bow in the hand that holds one, at a third of the way up the
    // player; then its shoot sound, its pitch drawn.
    fn ranged_attack(mut self, p: Follower, power: f32, sounds: mut List<EntitySound>) {
        let hand: usize = if self.main_is_bow() { 0 } else { 1 }
        let weapon = self.living.equipment[hand].copy() ?? stack_of(String("minecraft:bow"))
        var item = stack_of(String("minecraft:arrow"))
        if is_arrow_item(held_name(self.living.equipment[1])) {
            item = one_of(self.living.equipment[1].copy())
        } else if is_arrow_item(held_name(self.living.equipment[0])) {
            item = one_of(self.living.equipment[0].copy())
        }
        let shot = Fired {
            owner: self.living.body.uuid,
            target: p.id,
            x: self.living.body.x,
            y: self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32),
            z: self.living.body.z,
            tx: p.x,
            ty: p.y + f64(p.height) * 0.3333333333333333,
            tz: p.z,
            power: power,
            item: item,
            weapon: weapon,
            effect: self.arrow_effect(),
            burning: self.species == WITHER_SKELETON,
        }
        self.living.show(Shown.Fired(shot), sounds.len())
        let pitch = 1.0f32 / (self.living.body.random.next_float() * 0.4f32 + 0.8f32)
        self.living.play(mut sounds, String("entity.skeleton.shoot"), 1.0f32, pitch)
    }

    // `Drowned.performRangedAttack` at `p` (CAL-200): the trident in its main hand, else a new
    // one, thrown, `ThrownTrident`, which its level makes, `Shown.Fired`, from a tenth below its
    // eyes toward a third of the way up them; then its throw heard, its pitch drawn.
    fn drowned_throw(mut self, p: Follower, sounds: mut List<EntitySound>) {
        let held = self.living.equipment[0].copy()
        let item = if held_name(held.copy()) == "minecraft:trident" { held ?? stack_of(String("minecraft:trident")) } else { stack_of(String("minecraft:trident")) }
        let shot = Fired {
            owner: self.living.body.uuid,
            target: p.id,
            x: self.living.body.x,
            y: self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32),
            z: self.living.body.z,
            tx: p.x,
            ty: p.y + f64(p.height) * 0.3333333333333333,
            tz: p.z,
            power: 1.6f32,
            item: item.copy(),
            weapon: item,
            trident: true,
        }
        self.living.show(Shown.Fired(shot), sounds.len())
        let pitch = 1.0f32 / (self.living.body.random.next_float() * 0.4f32 + 0.8f32)
        self.living.play(mut sounds, String("entity.drowned.shoot"), 1.0f32, pitch)
    }

    // `RestrictSunGoal` (CAL-159): used while it's bright outside and nothing's on its head, as its
    // navigation's on the ground; running, its paths keep out of the sun, `setAvoidSun`.
    fn restrict_sun_goal<B: MobLight>(mut self, call: i32, blocks: B) -> bool {
        if call == GOAL_CAN_USE {
            return blocks.bright_outside() and self.living.equipment[5] == none
        }
        if call == GOAL_CONTINUE {
            return blocks.bright_outside() and self.living.equipment[5] == none
        }
        if call == GOAL_START {
            self.navigation.avoid_sun = true
        } else if call == GOAL_STOP {
            self.navigation.avoid_sun = false
        }
        return false
    }

    // `FleeSunGoal` (CAL-159): used without a target, while it's bright outside and it burns where
    // its block sees the sky, with nothing on its head, where it finds shade, `getHidePos`: ten
    // tries, each a block up to 10 across and 3 up or down, drawn, that doesn't see the sky and
    // that it'd walk to, `getWalkTargetValue` below 0. As it starts, on its way there at its
    // speed, going on while its path isn't done.
    fn flee_sun_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut FleeSun, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.target_in(players) != none or not blocks.bright_outside() or not self.living.on_fire() {
                return false
            }
            let x = floor_of(self.living.body.x)
            let y = floor_of(self.living.body.y)
            let z = floor_of(self.living.body.z)
            if not blocks.sees_sky(x, y, z) or self.living.equipment[5] != none {
                return false
            }
            for _ in 0..10 {
                let hx = x + self.living.body.random.next_int_below(20) - 10
                let hy = y + self.living.body.random.next_int_below(6) - 3
                let hz = z + self.living.body.random.next_int_below(20) - 10
                if not blocks.sees_sky(hx, hy, hz) and self.walk_target_value(lf, f, blocks, hx, hy, hz) < 0.0f32 {
                    g.x = f64(hx) + 0.5
                    g.y = f64(hy)
                    g.z = f64(hz) + 0.5
                    return true
                }
            }
            return false
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.x, g.y, g.z, g.speed)
        }
        return false
    }

    // `isWithinMeleeAttackRange` of the player `p` (CAL-159), `melee_reaches`.
    fn within_melee(self, p: Follower) -> bool {
        let pb = p.bounds else return false
        return self.melee_reaches(pb)
    }

    // `isWithinMeleeAttackRange` of the box `pb` (CAL-200): its box, as far again across as it
    // reaches at most, `getAttackBoundingBox`, meeting theirs, `getHitbox`, and, where it reaches
    // from further than nothing, not as far as its least; what it holds' own reach, `ATTACK_RANGE`,
    // its mob factor's, `effectiveMaxRange` and `effectiveMinRange`, else `sqrt(2.04F) - 0.6F` made
    // doubles, `DEFAULT_ATTACK_REACH`, from nothing.
    fn melee_reaches(self, pb: Aabb) -> bool {
        var most = f64(2.04f32).sqrt() - f64(0.6f32)
        var least = 0.0
        if self.held_range {
            if let r = self.held_reach {
                most = r.most
                least = r.least
            }
        }
        return self.attack_box_meets(most, pb) and (least <= 0.0 or not self.attack_box_meets(least, pb))
    }

    // Whether its attack box `r` further across each way, `getAttackBoundingBox`, meets the box
    // `pb` (CAL-200).
    fn attack_box_meets(self, r: f64, pb: Aabb) -> bool {
        var b = self.living.body.bounding_box()
        // Riding, across as far as what it rides too (D710).
        if let mb = self.mount_box {
            b = Aabb { min_x: b.min_x.min(mb.min_x), min_y: b.min_y, min_z: b.min_z.min(mb.min_z), max_x: b.max_x.max(mb.max_x), max_y: b.max_y, max_z: b.max_z.max(mb.max_z) }
        }
        // A ravager's 0.05 less across each way, `Ravager.getAttackBoundingBox` (CAL-200).
        let less = if self.species == RAVAGER { 0.05 } else { 0.0 }
        return b.min_x - r + less < pb.max_x and b.max_x + r - less > pb.min_x and b.min_y < pb.max_y and b.max_y > pb.min_y and b.min_z - r + less < pb.max_z and b.max_z + r - less > pb.min_z
    }

    // `swingForAttack` of its main hand (CAL-159), `LivingEntity.swing`: where its swing may start,
    // `SwingState.startIfAble`, none under way or past half of one, its main hand's
    // `attack_animation`, its ticks from 0, shown to those who see it,
    // `ClientboundSwingAnimationPacket`. Haste and mining fatigue come with effects.
    /// `SwingState.startIfAble` of a swing of `duration` ticks, as `swing` asks (CAL-165): none
    /// where one's under way and not yet past half its length, else its ticks from 0, its length
    /// `getModifiedSwingDuration`'s. Whether it started.
    pub fn start_swing(mut self, duration: i32) -> bool {
        if self.swing_duration >= 0 and self.swing_ticks <= self.swing_duration / 2 and self.swing_ticks > 0 {
            return false
        }
        self.swing_duration = self.living.swing_length(duration)
        self.swing_ticks = 0
        return true
    }

    fn swing_for_attack(mut self, heard: usize) {
        if self.swing_duration >= 0 and self.swing_ticks <= self.swing_duration / 2 and self.swing_ticks > 0 {
            return
        }
        let (kind, duration) = (self.attack_kind, self.attack_ticks)
        self.swing_duration = duration
        self.swing_ticks = 0
        self.living.show(Shown.Swung((0, kind, duration)), heard)
    }

    // `RemoveBlockGoal`, a zombie's for turtle eggs, `ZombieAttackTurtleEggGoal` (CAL-159,
    // CAL-201): where mob griefing's on, used once its count of tries is done, `nextStartTick`,
    // where it finds its block nearest, `findNearestBlock`, its count 20 again, halved; else 200 to
    // 399, drawn and halved. Going on while it's tried no more than 1200 ticks to get there, nor
    // stayed longer than its most, and the block's still one for it. As it starts,
    // `MoveToBlockGoal`'s: on its way to the block's top at its speed, its tries 0 and its most
    // ticks there drawn, and none at the block; as it stops, its fall 1. Each tick,
    // `MoveToBlockGoal.tick`: not within 1.14 of the block's top's middle, `acceptedDistance`, a try
    // more, its way there again each 40th; else there, a try less. There, with its block where it
    // stands or by it, `getPosWithBlock`: after its first tick there, thrown up at 0.3 and 3 egg
    // item particles sent 0.7 up the block, spread by its own draws; each other tick down at
    // -0.3, and each sixth `entity.zombie.destroy_egg` from the block it found, 0.5 loud, its own
    // draw pitching it; past 60, the block removed, `removeBlock`, 20 poofs at its bottom's middle
    // spread by its own draws and `entity.turtle.egg_break` 0.7 loud, the level's draw pitching it.
    fn remove_block_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut RemoveBlock, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            if not self.mob_griefing {
                return false
            }
            if g.next_start > 0 {
                g.next_start -= 1
                return false
            }
            if self.find_nearest_block(mut g, f, blocks) {
                g.next_start = reduced_tick_delay(20)
                return true
            }
            g.next_start = reduced_tick_delay(200 + self.living.body.random.next_int_below(200))
            return false
        }
        let want = f.block_named(g.block.copy()) else return false
        if call == GOAL_CONTINUE {
            return g.try_ticks >= -g.max_stay and g.try_ticks <= 1200 and removable_at(f, blocks, want, g.x, g.y, g.z)
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, g.speed)
            g.try_ticks = 0
            let bound = self.living.body.random.next_int_below(1200) + 1200
            g.max_stay = self.living.body.random.next_int_below(bound) + 1200
            g.since = 0
            return false
        }
        if call == GOAL_STOP {
            self.living.body.fall = 1.0
            return false
        }
        if call != GOAL_TICK {
            return false
        }
        let (tx, ty, tz) = (g.x, g.y + 1, g.z)
        if not (self.distance_sqr_to(f64(tx) + 0.5, f64(ty) + 0.5, f64(tz) + 0.5) < 1.14 * 1.14) {
            g.reached = false
            g.try_ticks += 1
            if g.try_ticks % 40 == 0 {
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(tx) + 0.5, f64(ty), f64(tz) + 0.5, g.speed)
            }
        } else {
            g.reached = true
            g.try_ticks -= 1
        }
        if not g.reached {
            return false
        }
        let (mx, my, mz) = self.block_position()
        let eat = block_by(f, blocks, want, mx, my, mz) else return false
        let (ex, ey, ez) = eat
        if g.since > 0 {
            self.living.body.vy = 0.3
            let dx = (f64(self.living.body.random.next_float()) - 0.5) * 0.08
            let dy = (f64(self.living.body.random.next_float()) - 0.5) * 0.08
            let dz = (f64(self.living.body.random.next_float()) - 0.5) * 0.08
            self.living.show(Shown.Spread(Spread { particle: String("minecraft:item"), item: String("minecraft:egg"), x: f64(ex) + 0.5, y: f64(ey) + 0.7, z: f64(ez) + 0.5, count: 3, dx: dx, dy: dy, dz: dz, speed: f64(0.15f32) }), sounds.len())
        }
        if g.since % 2 == 0 {
            self.living.body.vy = -0.3
            if g.since % 6 == 0 {
                let pitch = 0.9f32 + self.living.body.random.next_float() * 0.2f32
                sounds.push(EntitySound { sound: String("entity.zombie.destroy_egg"), x: f64(g.x) + 0.5, y: f64(g.y) + 0.5, z: f64(g.z) + 0.5, volume: 0.5f32, pitch: pitch, source: HOSTILE_SOURCE })
            }
        }
        if g.since > 60 {
            if let air = f.block_named(String("minecraft:air")) {
                self.living.show(Shown.Planted((ex, ey, ez, f.default_state(air))), sounds.len())
            }
            for _ in 0..20 {
                let dx = self.living.body.random.next_gaussian() * 0.02
                let dy = self.living.body.random.next_gaussian() * 0.02
                let dz = self.living.body.random.next_gaussian() * 0.02
                self.living.show(Shown.Spread(Spread { particle: String("minecraft:poof"), x: f64(ex) + 0.5, y: f64(ey), z: f64(ez) + 0.5, count: 1, dx: dx, dy: dy, dz: dz, speed: f64(0.15f32) }), sounds.len())
            }
            var pitch = 0.9f32
            if let lent = self.level_random.take() {
                var random = lent
                pitch = 0.9f32 + random.next_float() * 0.2f32
                self.level_random = some(random)
            } else {
                self.living.show(Shown.Missing(String("A turtle egg's break sound's pitch without its level's random")), sounds.len())
            }
            sounds.push(EntitySound { sound: String("entity.turtle.egg_break"), x: f64(ex) + 0.5, y: f64(ey) + 0.5, z: f64(ez) + 0.5, volume: 0.7f32, pitch: pitch, source: BLOCKS_SOURCE })
        }
        g.since += 1
        return false
    }

    // `MoveToBlockGoal.findNearestBlock` (CAL-159): the blocks about its block, a block down, by
    // rings out to its range, each layer from 0 up, then down, to its range up and down, in
    // vanilla's order, the first that's its block in a full chunk with air above it twice,
    // `RemoveBlockGoal.isValidTarget`, kept. It has no home, so any is within it.
    fn find_nearest_block<B: CollisionBlocks>(self, g: mut RemoveBlock, f: Facts, blocks: B) -> bool {
        let want = f.block_named(g.block.copy()) else return false
        let (mx, my, mz) = self.block_position()
        var y = 0
        while y <= g.vertical {
            for r in 0..g.range {
                var x = 0
                while x <= r {
                    var z = if x < r and x > -r { r } else { 0 }
                    while z <= r {
                        let (px, py, pz) = (mx + x, my + y - 1, mz + z)
                        if let state = blocks.collision_state(px, py, pz) {
                            if f.block(state) == want and f.is_air(state_at(blocks, px, py + 1, pz)) and f.is_air(state_at(blocks, px, py + 2, pz)) {
                                g.x = px
                                g.y = py
                                g.z = pz
                                return true
                            }
                        }
                        z = if z > 0 { -z } else { 1 - z }
                    }
                    x = if x > 0 { -x } else { 1 - x }
                }
            }
            y = if y > 0 { -y } else { 1 - y }
        }
        return false
    }

    // `SpearUseGoal`, a zombie's, charging and getting away at 1, from 10 blocks off, within 2 of
    // its target (CAL-159): used with a target while it holds a spear, `KINETIC_WEAPON`, and uses
    // nothing; going on while it isn't done and that holds. As it starts, aggressive, its state
    // new; as it stops, its path stopped, not aggressive, no state, and what it uses let go. Each
    // tick, turned to its target at once, `Mob.lookAt`, and looking at their eyes, 30 degrees a
    // tick. Not yet engaged, it's on its way to them while they're more than 10 off, else its
    // spear's down for its damage's ticks, `computeDamageUseDuration`, as goal ticks, and used,
    // `startUsingItem`. Its spear's time up, it's let go, and a place to get away to found, 9 to
    // 11 blocks from them less how far they are, `getPosAway`, its getting away begun. Getting
    // away longer than 50 goal ticks, it's done; else with a place to go, it goes, and once its
    // path's done, it's done where it was getting away, else it has no place; with none, it
    // charges, and within 2 of them or its path done, a place 6 to 7 from them less how far they
    // are is found, each 2 further where it rides, `mountDistance`. Its speeds are times its mount's,
    // `chargeSpeedModifier`, 1 where it rides nothing.
    fn spear_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut SpearUse, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            return self.target_in(players) != none and self.held_kinetic and not self.living.using_item()
        }
        if call == GOAL_CONTINUE {
            return g.on and not g.done and self.target_in(players) != none and self.held_kinetic
        }
        if call == GOAL_START {
            self.set_flag(AGGRESSIVE_FLAG, true)
            g.on = true
            g.engage_time = -1
            g.fleeing_time = -1
            g.away = none
            g.done = false
        } else if call == GOAL_STOP {
            self.navigation.stop()
            self.set_flag(AGGRESSIVE_FLAG, false)
            g.on = false
            g.away = none
            self.living.stop_using()
        } else if call == GOAL_TICK {
            if not g.on {
                return false
            }
            let p = self.target_in(players) else return false
            var charge = 1.0
            if let s = self.steering {
                charge = f64(s.charge)
            }
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            self.look_at_now(p, 30.0f32, 30.0f32)
            let mount = if self.living.body.vehicle != none { 2.0 } else { 0.0 }
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
            if g.engage_time < 0 {
                if d > 100.0 {
                    _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, charge * 1.0)
                    return false
                }
                let k = self.held_spear ?? Kinetic()
                let lasting = match k.damage {
                    some(c) => c.max_ticks,
                    none => 0,
                }
                g.engage_time = reduced_tick_delay(k.delay + lasting)
                self.living.start_using_kinetic(0, k, heard)
            }
            if g.engage_time > 0 {
                g.engage_time -= 1
                if g.engage_time == 0 {
                    self.living.stop_using()
                    let distance = d.sqrt()
                    g.away = self.pos_away(lf, f, blocks, mut cache, min_y, (9.0 + mount - distance).max(0.0), (11.0 + mount - distance).max(1.0), (p.x, p.y, p.z))
                    g.fleeing_time = 1
                }
            }
            if g.fleeing_time > 0 {
                g.fleeing_time += 1
                if f64(g.fleeing_time) > f64(reduced_tick_delay(100)) {
                    g.done = true
                    return false
                }
            }
            if let at = g.away {
                let (ax, ay, az) = at
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, ax, ay, az, charge * 1.0)
                if self.navigation.is_done() {
                    if g.fleeing_time > 0 {
                        g.done = true
                        return false
                    }
                    g.away = none
                }
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, charge * 1.0)
                if d < 4.0 or self.navigation.is_done() {
                    let distance = d.sqrt()
                    g.away = self.pos_away(lf, f, blocks, mut cache, min_y, 6.0 + mount - distance, 7.0 + mount - distance, (p.x, p.y, p.z))
                }
            }
        }
        return false
    }

    // `LandRandomPos.getPosAway` from `avoid`, `min_h` to `max_h` across and 7 up or down
    // (CAL-159): the way from it across, drawn where it's right on it; of the 10 places tried,
    // `away_tries`, the best, as `random_place` has it.
    fn pos_away<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32, min_h: f64, max_h: f64, avoid: (f64, f64, f64)) -> (f64, f64, f64)? {
        let (ax, ay, az) = avoid
        var dx = self.living.body.x - ax
        let dy = self.living.body.y - ay
        var dz = self.living.body.z - az
        if (dx * dx + dy * dy + dz * dz).sqrt() == 0.0 {
            dx = self.living.body.random.next_double() - 0.5
            dz = self.living.body.random.next_double() - 0.5
        }
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
        let costs = self.own_maluses()
        let tries = away_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, min_h, max_h, 7, (dx, dz))
        return self.best_place(lf, f, blocks, tries)
    }

    /// What its main hand holds as its tick begins, as its attacks read it (CAL-159): its swing,
    /// `getAttackAnimation`, a whack of 6 where it has no `attack_animation`; whether it's a
    /// spear, its `KineticWeapon` kept; and whether it reaches as its own, its reach with it kept,
    /// `getAttackRangeWith`.
    pub fn read_held<W: Wearing>(mut self, items: W) {
        self.attack_kind = 1
        self.attack_ticks = 6
        self.held_kinetic = false
        self.held_range = false
        self.held_spear = none
        self.held_reach = none
        let held = self.living.equipment[0].copy() else return
        if let k = items.worn_component(held.copy(), String("minecraft:kinetic_weapon")) {
            self.held_kinetic = true
            self.held_spear = some(kinetic_of(k))
        }
        let range = items.worn_component(held.copy(), String("minecraft:attack_range"))
        self.held_range = range != none
        self.held_reach = some(reach_of(range))
        let found = items.worn_component(held, String("minecraft:attack_animation")) else return
        let Tag.Compound(a) = found else return
        var kind = 1
        if a.contains("type") {
            if let Tag.Str(name) = a["type"].copy() {
                kind = if name == "none" { 0 } else if name == "stab" { 2 } else { 1 }
            }
        }
        let duration = if a.contains("duration") { a["duration"].number_int() ?? 6 } else { 6 }
        self.attack_kind = kind
        self.attack_ticks = duration
    }

    /// `setLastHurtMob` (CAL-159): the player `id`, at its tick count now, after its attack hurt
    /// them.
    pub fn hurt_mob(mut self, id: i32) {
        self.last_hurt_mob = some(id)
        self.last_hurt_mob_stamp = self.living.body.tick_count
    }

    /// `setLastHurtMob` of what isn't living, as an end crystal isn't (D591): none, as of its
    /// tick.
    pub fn hurt_unliving(mut self) {
        self.last_hurt_mob = none
        self.last_hurt_mob_stamp = self.living.body.tick_count
    }

    /// Whether it's a zombie, of `Zombie`'s class, which a zombie's alert reaches; a zombie
    /// villager's reaches only its own (CAL-159).
    pub fn zombie_class(self) -> bool {
        return zombie_kind(self.species)
    }

    /// `alertOther` of the mob of its class near one hurt (CAL-159): where it has no target now,
    /// `getTarget`, the player `id`, as `setTarget` takes them.
    pub fn alerted_to(mut self, id: i32, players: List<Follower>) {
        if self.target_in(players) == none {
            self.set_target(some(id), players)
        }
    }

    /// Whether it's a fox with the flag `flag` of its flags, `DATA_FLAGS_ID`, `getFlag` (CAL-201).
    pub fn fox_flag(self, flag: i32) -> bool {
        return self.species == FOX and i32(self.living.data.byte(OWN + 1)) & flag != 0
    }

    // A fox's flag `flag` set or cleared, `setFlag` (CAL-201); a cleared defending flag goes as its
    // target does, `Fox.setTarget`.
    fn set_fox_flag(mut self, flag: i32, on: bool) {
        let flags = i32(self.living.data.byte(OWN + 1))
        self.living.data.set(OWN + 1, Value.Byte(i8.wrap(if on { flags | flag } else { flags & ~flag })))
    }

    // `Fox.clearStates` (CAL-201): not interested, crouching, sitting, sleeping, defending nor
    // faceplanted.
    pub fn fox_clear_states(mut self) {
        for flag in [FOX_INTERESTED, FOX_CROUCHING, FOX_SITTING, FOX_SLEEPING, FOX_DEFENDING, FOX_FACEPLANTED] {
            self.set_fox_flag(flag, false)
        }
    }

    /// Whether a fox may move, `canMove`: not sleeping, sitting nor faceplanted (CAL-201).
    pub fn fox_can_move(self) -> bool {
        return not self.fox_flag(FOX_SLEEPING) and not self.fox_flag(FOX_SITTING) and not self.fox_flag(FOX_FACEPLANTED)
    }

    // Whether a fox trusts the one of the UUID `uuid`, `trusts`, among the two it may,
    // `DATA_TRUSTED_ID_0` and `_1` (CAL-201).
    fn fox_trusts(self, uuid: (i64, i64)?) -> bool {
        let u = uuid else return false
        return self.living.data.uuid(OWN + 2) == some(u) or self.living.data.uuid(OWN + 3) == some(u)
    }

    /// A fox's trust in the one of the UUID `uuid`, `addTrustedEntity` (CAL-201): its second where
    /// it trusts one already, else its first.
    pub fn fox_trust(mut self, uuid: (i64, i64)) {
        let (most, least) = uuid
        let slot = if self.living.data.uuid(OWN + 2) != none { OWN + 3 } else { OWN + 2 }
        self.living.data.set(slot, Value.Uuid(most, least))
    }

    // Whether the player or mob `p` would alert a fox, `FoxAlertableEntitiesSelector` and the rest
    // of `FoxBehaviorGoal.alertable`'s conditions (CAL-201), `b` the fox's box and `kind` its type:
    // one it may see as an enemy, no fox; a chicken, a rabbit or a monster; a tamable animal only
    // wild; no player in creative or spectating, nor any it trusts, nor one asleep or sneaking; a
    // player not in peaceful, `canAttack`; within 12 of it as visible to it, sight or not; and its
    // box meeting the fox's grown 12 across and 6 up and down.
    fn fox_alerted_by(self, p: Follower, kind: i32, b: Aabb) -> bool {
        if p.id == self.living.body.id or p.dead or not p.enemy {
            return false
        }
        if p.mob {
            if p.species == FOX {
                return false
            }
            if not (p.species == CHICKEN or p.species == RABBIT or monster_kind(p.species)) {
                if p.species == WOLF or p.species == CAT {
                    if p.tamed {
                        return false
                    }
                } else if self.fox_trusts(p.uuid) or p.sleeping {
                    return false
                }
            }
        } else {
            if p.spectator or p.creative or self.fox_trusts(p.uuid) or p.sleeping or p.discrete or self.difficulty == 0 {
                return false
            }
        }
        let visibility = p.visibility(kind)
        let within = if 12.0 * visibility > 2.0 { 12.0 * visibility } else { 2.0 }
        let (dx, dy, dz) = (self.living.body.x - p.x, self.living.body.y - p.y, self.living.body.z - p.z)
        if dx * dx + dy * dy + dz * dz > within * within {
            return false
        }
        let half = f64(p.width) / 2.0
        let theirs = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
        return theirs.intersects(b.min_x - 12.0, b.min_y - 6.0, b.min_z - 12.0, b.max_x + 12.0, b.max_y + 6.0, b.max_z + 12.0)
    }

    // `FoxBehaviorGoal.alertable` (CAL-201): any player or mob near that would alert it,
    // `fox_alerted_by`.
    fn fox_alertable(self, players: List<Follower>) -> bool {
        let b = self.living.body.bounding_box()
        let kind = self.looker().kind
        for p in players {
            if self.fox_alerted_by(p, kind, b) {
                return true
            }
        }
        for p in self.prey {
            if self.fox_alerted_by(p, kind, b) {
                return true
            }
        }
        return false
    }

    // `FoxBehaviorGoal.hasShelter` (CAL-201): the block at the top of its box doesn't see the sky
    // and it'd walk to it, `getWalkTargetValue` 0 or more.
    fn fox_sheltered<B: CollisionBlocks + MobLight>(self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let x = floor_of(self.living.body.x)
        let y = floor_of(self.living.body.bounding_box().max_y)
        let z = floor_of(self.living.body.z)
        return not blocks.sees_sky(x, y, z) and self.walk_target_value(lf, f, blocks, x, y, z) >= 0.0f32
    }

    // `Fox.isPathClear` of a fox to `p` (CAL-201): six steps of the way across, each block 1 to 3
    // above one replaceable, `canBeReplaced`.
    fn fox_path_clear<B: CollisionBlocks>(self, f: Facts, blocks: B, p: Follower) -> bool {
        let zdiff = p.z - self.living.body.z
        let xdiff = p.x - self.living.body.x
        let slope = zdiff / xdiff
        for i in 0..6 {
            let part = f64(f32.nearest(i) / 6.0f32)
            let z = if slope == 0.0 { 0.0 } else { zdiff * part }
            let x = if slope == 0.0 { xdiff * part } else { z / slope }
            for j in 1..4 {
                let state = state_at(blocks, floor_of(self.living.body.x + x), floor_of(self.living.body.y + f64(j)), floor_of(self.living.body.z + z))
                if not f.replaceable(state) {
                    return false
                }
            }
        }
        return true
    }

    // `FleeSunGoal.setWantedPos` of a fox's `SeekShelterGoal` (CAL-201): of ten tries, each a block
    // up to 10 across and 3 up or down, drawn, the first that doesn't see the sky and that it'd
    // walk to, `getWalkTargetValue` below 0, its bottom's middle kept.
    fn fox_hide<B: CollisionBlocks + MobLight>(mut self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let (x, y, z) = self.block_position()
        for _ in 0..10 {
            let hx = x + self.living.body.random.next_int_below(20) - 10
            let hy = y + self.living.body.random.next_int_below(6) - 3
            let hz = z + self.living.body.random.next_int_below(20) - 10
            if not blocks.sees_sky(hx, hy, hz) and self.walk_target_value(lf, f, blocks, hx, hy, hz) < 0.0f32 {
                self.fox.shelter = (f64(hx) + 0.5, f64(hy), f64(hz) + 0.5)
                return true
            }
        }
        return false
    }

    // `ServerLevel.isVillage` of the block at x, y, z, as a fox asks it (CAL-201): its section
    // within 1 of a village's center.
    fn fox_in_village(mut self, x: i32, y: i32, z: i32) -> bool {
        var pois = self.pois.take() else return false
        let near = pois.close_to_village(BlockPos { x: x, y: y, z: z }, 1)
        self.pois = some(pois)
        return near
    }

    // `PerchAndSearchGoal.resetLook` (CAL-201): a way drawn round it, and 80 to 99 ticks, drawn,
    // halved, `adjustedTickDelay`.
    fn fox_reset_look(mut self) {
        let turn = 6.283185307179586 * self.living.body.random.next_double()
        self.fox.perch_x = cos(turn)
        self.fox.perch_z = sin(turn)
        self.fox.perch_look = reduced_tick_delay(80 + self.living.body.random.next_int_below(20))
    }


    // A fox's own goals, by their `FOX_` kind (CAL-201), `call` the goal's call:
    // - `FaceplantGoal`: used while faceplanted, going on for 20 ticks, `adjustedTickDelay(40)`;
    //   as it stops, no longer faceplanted.
    // - `StalkPreyGoal`, used and going on, not asleep, with a target alive that's a chicken or a
    //   rabbit more than 6 off, not crouching, interested nor jumping: as it starts, not sitting nor
    //   faceplanted; each tick looking at it and within 6 interested, crouching and stopped, else on
    //   its way at 1.5; as it stops, with a clear path to its target, interested, crouching, stopped
    //   and looking at it, else neither.
    // - `FoxPounceGoal`, which none may interrupt: used fully crouched with a target alive and a
    //   clear path to it, else its path found to it and neither crouching nor interested. As it
    //   starts, jumping, pouncing, not interested, looking at its target, 60 and 30 degrees a tick,
    //   pushed toward it 0.8 across and up 0.9, stopped. It goes on with its target alive while
    //   it's still moving up or down, isn't level within 15 or is off the ground, not faceplanted.
    //   Each tick it looks at its target; not faceplanted, it levels out a fifth of the way where
    //   it's barely moving up or down, else pitches along its motion, up six and a half as much
    //   while jumping up; within 2 of its target it hits it, `doHurtTarget`, which its level deals,
    //   else pitched down on the ground in snow, falling, it's faceplanted, pitched 60, no target.
    //   As it stops, not crouching, its crouch none, neither interested nor pouncing.
    // - `SeekShelterGoal`, a `FleeSunGoal` at 1.25, used not asleep without a target: in thunder
    //   where its block sees the sky, where it finds shade, `fox_hide`; else each 50th try, then
    //   each 100th, by day where its block sees the sky outside a village, where it finds shade. As
    //   it starts, its states cleared, on its way there; going on till its path's done.
    // - `SleepGoal`: used not moving, where it may sleep or already sleeps, going on while it may:
    //   its count down to sleep done, by day, sheltered, not alertable and not in powder snow. As
    //   it starts, not sitting, crouching, interested nor jumping, asleep, stopped, wanted where it
    //   is at 0; as it stops, its count 0 to 69 again, drawn, and its states cleared.
    // - `FoxStrollThroughVillageGoal`, a `StrollThroughVillageGoal` every 100 tries, used and going
    //   on while it may move, not sitting, defending nor with a target: by night, one in 100, drawn,
    //   within 6 sections of a village, toward the best of 10 places on land up to 15 across and 7
    //   up or down by how near a village they are; its states cleared as it starts; each tick, its
    //   path done more than 10 off, toward 10 along the way to four tenths of its distance from
    //   there, on the ground, at 1, else somewhere within 8 across, drawn.
    // - `FoxEatBerriesGoal`, a `MoveToBlockGoal` within 12 and 1 up or down at 1.2, used not asleep:
    //   ripe sweet berries or glow berries, as a rabbit's garden is found; within 2 of the top of
    //   them for 40 ticks, it picks them, where mob griefing's on, `onReachedTarget`, else sniffs
    //   one in 20, drawn; its path found again each 100th try.
    // - `FoxSearchForItemsGoal`, used and going on holding nothing, without a target or one who
    //   hurt it, able to move, one in 5, drawn, with items near it that may be picked up: toward the
    //   first at 1.2 as it starts and each tick.
    // - `PerchAndSearchGoal`, used where nothing hurt it, 1 in 50, drawn, not asleep, without a
    //   target, stopped, not alertable, pouncing nor crouching: as it starts, a way to look, 2 to 4
    //   looks, drawn, sitting, stopped; each tick looking that way, a new way each look; as it
    //   stops, not sitting.
    fn fox_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, kind: i32, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if kind == FOX_FACEPLANT {
            if call == GOAL_CAN_USE {
                return self.fox_flag(FOX_FACEPLANTED)
            }
            if call == GOAL_CONTINUE {
                return self.fox_flag(FOX_FACEPLANTED) and self.fox.faceplant > 0
            }
            if call == GOAL_START {
                self.fox.faceplant = reduced_tick_delay(40)
            } else if call == GOAL_STOP {
                self.set_fox_flag(FOX_FACEPLANTED, false)
            } else if call == GOAL_TICK {
                self.fox.faceplant -= 1
            }
            return false
        }
        if kind == FOX_STALK {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                if self.fox_flag(FOX_SLEEPING) {
                    return false
                }
                let p = self.target_in(players) else return false
                return not p.dead and p.mob and (p.species == CHICKEN or p.species == RABBIT) and self.distance_sqr_to(p.x, p.y, p.z) > 36.0 and not self.fox_flag(FOX_CROUCHING) and not self.fox_flag(FOX_INTERESTED) and not self.living.jumping
            }
            if call == GOAL_START {
                self.set_fox_flag(FOX_SITTING, false)
                self.set_fox_flag(FOX_FACEPLANTED, false)
            } else if call == GOAL_STOP {
                var clear = false
                if let p = self.target_in(players) {
                    if self.fox_path_clear(f, blocks, p) {
                        clear = true
                        self.set_fox_flag(FOX_INTERESTED, true)
                        self.set_fox_flag(FOX_CROUCHING, true)
                        self.navigation.stop()
                        self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, self.max_head_y_rot(), self.max_head_x_rot())
                    }
                }
                if not clear {
                    self.set_fox_flag(FOX_INTERESTED, false)
                    self.set_fox_flag(FOX_CROUCHING, false)
                }
            } else if call == GOAL_TICK {
                if let p = self.target_in(players) {
                    self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, self.max_head_y_rot(), self.max_head_x_rot())
                    if self.distance_sqr_to(p.x, p.y, p.z) <= 36.0 {
                        self.set_fox_flag(FOX_INTERESTED, true)
                        self.set_fox_flag(FOX_CROUCHING, true)
                        self.navigation.stop()
                    } else {
                        _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, 1.5)
                    }
                }
            }
            return false
        }
        if kind == FOX_POUNCE {
            if call == GOAL_CAN_USE {
                if self.fox.crouch != 5.0f32 {
                    return false
                }
                let p = self.target_in(players) else return false
                if p.dead {
                    return false
                }
                let clear = self.fox_path_clear(f, blocks, p)
                if not clear {
                    let nf = nav_facts(lf, blocks, min_y)
                    let w = self.walker(lf)
                    _ = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, floor_of(p.x), floor_of(p.y), floor_of(p.z), 0)
                    self.set_fox_flag(FOX_CROUCHING, false)
                    self.set_fox_flag(FOX_INTERESTED, false)
                }
                return clear
            }
            if call == GOAL_CONTINUE {
                let p = self.target_in(players) else return false
                if p.dead {
                    return false
                }
                let yd = self.living.body.vy
                return (not (yd * yd < f64(0.05f32)) or not (self.living.body.x_rot.abs() < 15.0f32) or not self.living.body.on_ground) and not self.fox_flag(FOX_FACEPLANTED)
            }
            if call == GOAL_START {
                self.living.jumping = true
                self.set_fox_flag(FOX_POUNCING, true)
                self.set_fox_flag(FOX_INTERESTED, false)
                if let p = self.target_in(players) {
                    self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 60.0f32, 30.0f32)
                    let (dx, dy, dz) = (p.x - self.living.body.x, p.y - self.living.body.y, p.z - self.living.body.z)
                    let length = (dx * dx + dy * dy + dz * dz).sqrt()
                    let (ux, uz) = if length < 1.0E-5 { (0.0, 0.0) } else { (dx / length, dz / length) }
                    self.living.body.vx = self.living.body.vx + ux * 0.8
                    self.living.body.vy = self.living.body.vy + 0.9
                    self.living.body.vz = self.living.body.vz + uz * 0.8
                }
                self.navigation.stop()
            } else if call == GOAL_STOP {
                self.set_fox_flag(FOX_CROUCHING, false)
                self.fox.crouch = 0.0f32
                self.set_fox_flag(FOX_INTERESTED, false)
                self.set_fox_flag(FOX_POUNCING, false)
            } else if call == GOAL_TICK {
                let target = self.target_in(players)
                if let p = target {
                    self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 60.0f32, 30.0f32)
                }
                if not self.fox_flag(FOX_FACEPLANTED) {
                    let vy = self.living.body.vy
                    if vy * vy < f64(0.03f32) and self.living.body.x_rot != 0.0f32 {
                        let from = self.living.body.x_rot
                        self.living.body.x_rot = from + 0.2f32 * wrap_degrees(0.0f32 - from)
                    } else {
                        let (vx, vz) = (self.living.body.vx, self.living.body.vz)
                        let direction = (vx * vx + vz * vz).sqrt()
                        let bias = if self.living.jumping and vy > 0.0 { 6.5 } else { 1.0 }
                        let biased = vy * bias
                        let length = (direction * direction + biased * biased).sqrt()
                        if length > f64(1.0E-5f32) {
                            let sign = if -biased > 0.0 { 1.0 } else if -biased < 0.0 { -1.0 } else { 0.0 }
                            self.living.body.x_rot = f32.nearest(sign * acos(direction / length) * RAD_TO_DEG)
                        }
                    }
                }
                var hit = false
                if let p = target {
                    let xd = f32.nearest(self.living.body.x - p.x)
                    let yd = f32.nearest(self.living.body.y - p.y)
                    let zd = f32.nearest(self.living.body.z - p.z)
                    if f32.nearest(f64(xd * xd + yd * yd + zd * zd).sqrt()) <= 2.0f32 {
                        hit = true
                        let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                        self.living.show(Shown.Attack((p.id, ax, ay, az)), sounds.len())
                    }
                }
                if not hit and self.living.body.x_rot > 0.0f32 and self.living.body.on_ground and f32.nearest(self.living.body.vy) != 0.0f32 {
                    let (bx, by, bz) = self.block_position()
                    if some(f.block(state_at(blocks, bx, by, bz))) == f.block_named(String("minecraft:snow")) {
                        self.living.body.x_rot = 60.0f32
                        self.target_to(none)
                        self.set_fox_flag(FOX_FACEPLANTED, true)
                    }
                }
            }
            return false
        }
        if kind == FOX_SHELTER {
            if call == GOAL_CAN_USE {
                if self.fox_flag(FOX_SLEEPING) or self.target_in(players) != none {
                    return false
                }
                let (bx, by, bz) = self.block_position()
                if blocks.thundering() and blocks.sees_sky(bx, by, bz) {
                    return self.fox_hide(lf, f, blocks)
                }
                if self.fox.shelter_interval > 0 {
                    self.fox.shelter_interval -= 1
                    return false
                }
                self.fox.shelter_interval = 100
                return blocks.bright_outside() and blocks.sees_sky(bx, by, bz) and not self.fox_in_village(bx, by, bz) and self.fox_hide(lf, f, blocks)
            }
            if call == GOAL_CONTINUE {
                return not self.navigation.is_done()
            }
            if call == GOAL_START {
                self.fox_clear_states()
                let (x, y, z) = self.fox.shelter
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, x, y, z, 1.25)
            }
            return false
        }
        if kind == FOX_SLEEP {
            if call == GOAL_CAN_USE {
                if self.living.xxa != 0.0f32 or self.living.yya != 0.0f32 or self.living.zza != 0.0f32 {
                    return false
                }
                return self.fox_may_sleep(lf, f, blocks, players) or self.fox_flag(FOX_SLEEPING)
            }
            if call == GOAL_CONTINUE {
                return self.fox_may_sleep(lf, f, blocks, players)
            }
            if call == GOAL_START {
                self.set_fox_flag(FOX_SITTING, false)
                self.set_fox_flag(FOX_CROUCHING, false)
                self.set_fox_flag(FOX_INTERESTED, false)
                self.living.jumping = false
                self.set_fox_flag(FOX_SLEEPING, true)
                self.navigation.stop()
                self.moves.set_wanted(self.living.body.x, self.living.body.y, self.living.body.z, 0.0)
            } else if call == GOAL_STOP {
                self.fox.sleep_countdown = self.living.body.random.next_int_below(reduced_tick_delay(140))
                self.fox_clear_states()
            }
            return false
        }
        if kind == FOX_VILLAGE {
            let free = not self.fox_flag(FOX_SLEEPING) and not self.fox_flag(FOX_SITTING) and not self.fox_flag(FOX_DEFENDING) and self.target_in(players) == none
            if call == GOAL_CAN_USE {
                if self.controlled or blocks.bright_outside() or self.living.body.random.next_int_below(reduced_tick_delay(200)) != 0 {
                    return false
                }
                let (bx, by, bz) = self.block_position()
                var pois = self.pois.take() ?? Pois.new(0, 0)
                if not pois.close_to_village(BlockPos { x: bx, y: by, z: bz }, 6) {
                    self.pois = some(pois)
                    return false
                }
                let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
                let costs = self.own_maluses()
                let tries = land_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 15, 7)
                var best = f64.NEG_INFINITY
                var found: (i32, i32, i32)? = none
                for t in tries {
                    if let p = t {
                        let (x, y, z) = p
                        let value = -f64(pois.sections_to_village(x >> 4, y >> 4, z >> 4))
                        if value > best {
                            best = value
                            found = some(p)
                        }
                    }
                }
                self.pois = some(pois)
                self.fox.village = found
                return found != none and free
            }
            if call == GOAL_CONTINUE {
                let wanted = self.fox.village else return false
                return not self.navigation.is_done() and self.navigation.target_block() == some(wanted) and free
            }
            if call == GOAL_START {
                self.fox_clear_states()
            } else if call == GOAL_TICK {
                let wanted = self.fox.village else return false
                let (wx, wy, wz) = wanted
                let (cx, cy, cz) = (f64(wx) + 0.5 - self.living.body.x, f64(wy) + 0.5 - self.living.body.y, f64(wz) + 0.5 - self.living.body.z)
                if self.navigation.is_done() and not (cx * cx + cy * cy + cz * cz < 100.0) {
                    let (tx, ty, tz) = (f64(wx) + 0.5, f64(wy), f64(wz) + 0.5)
                    let (sx, sy, sz) = (self.living.body.x, self.living.body.y, self.living.body.z)
                    let (lx, ly, lz) = ((sx - tx) * 0.4 + tx, (sy - ty) * 0.4 + ty, (sz - tz) * 0.4 + tz)
                    let (ex, ey, ez) = (lx - sx, ly - sy, lz - sz)
                    let length = (ex * ex + ey * ey + ez * ez).sqrt()
                    let (nx, ny, nz) = if length < 1.0E-5 { (0.0, 0.0, 0.0) } else { (ex / length, ey / length, ez / length) }
                    let (px, pz) = (floor_of(nx * 10.0 + sx), floor_of(nz * 10.0 + sz))
                    _ = ny
                    let py = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, px, pz) ?? min_y
                    if not self.move_to(lf, f, m, blocks, mut cache, min_y, f64(px), f64(py), f64(pz), 1.0) {
                        let (bx, _, bz) = self.block_position()
                        let rx = bx - 8 + self.living.body.random.next_int_below(16)
                        let rz = bz - 8 + self.living.body.random.next_int_below(16)
                        let ry = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, rx, rz) ?? min_y
                        _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(rx), f64(ry), f64(rz), 1.0)
                    }
                }
            }
            return false
        }
        if kind == FOX_BERRIES {
            if call == GOAL_CAN_USE {
                if self.fox_flag(FOX_SLEEPING) {
                    return false
                }
                if self.fox.berries.next_start > 0 {
                    self.fox.berries.next_start -= 1
                    return false
                }
                self.fox.berries.next_start = reduced_tick_delay(200 + self.living.body.random.next_int_below(200))
                let (mx, my, mz) = self.block_position()
                var y = 0
                while y <= 1 {
                    for r in 0..12 {
                        var x = 0
                        while x <= r {
                            var z = if x < r and x > -r { r } else { 0 }
                            while z <= r {
                                let (px, py, pz) = (mx + x, my + y - 1, mz + z)
                                if self.within_home(f64(px), f64(py), f64(pz)) and fox_berries_at(f, blocks, px, py, pz) {
                                    self.fox.berries.x = px
                                    self.fox.berries.y = py
                                    self.fox.berries.z = pz
                                    return true
                                }
                                z = if z > 0 { -z } else { 1 - z }
                            }
                            x = if x > 0 { -x } else { 1 - x }
                        }
                    }
                    y = if y > 0 { -y } else { 1 - y }
                }
                return false
            }
            let (gx, gy, gz) = (self.fox.berries.x, self.fox.berries.y, self.fox.berries.z)
            if call == GOAL_CONTINUE {
                let g = self.fox.berries
                return g.try_ticks >= -g.max_stay and g.try_ticks <= 1200 and fox_berries_at(f, blocks, gx, gy, gz)
            }
            if call == GOAL_START {
                self.fox.waited = 0
                self.set_fox_flag(FOX_SITTING, false)
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(gx) + 0.5, f64(gy + 1), f64(gz) + 0.5, 1.2)
                self.fox.berries.try_ticks = 0
                let bound = self.living.body.random.next_int_below(1200) + 1200
                self.fox.berries.max_stay = self.living.body.random.next_int_below(bound) + 1200
            } else if call == GOAL_TICK {
                if self.fox.berries.reached {
                    if self.fox.waited >= 40 {
                        self.fox_pick_berries(f, blocks, gx, gy, gz, mut sounds)
                    } else {
                        self.fox.waited += 1
                    }
                } else if self.living.body.random.next_float() < 0.05f32 {
                    self.living.play(mut sounds, String("entity.fox.sniff"), 1.0f32, 1.0f32)
                }
                let dx = f64(gx) + 0.5 - self.living.body.x
                let dy = f64(gy + 1) + 0.5 - self.living.body.y
                let dz = f64(gz) + 0.5 - self.living.body.z
                if not (dx * dx + dy * dy + dz * dz < 4.0) {
                    self.fox.berries.reached = false
                    self.fox.berries.try_ticks += 1
                    if self.fox.berries.try_ticks % 100 == 0 {
                        _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(gx) + 0.5, f64(gy + 1), f64(gz) + 0.5, 1.2)
                    }
                } else {
                    self.fox.berries.reached = true
                    self.fox.berries.try_ticks -= 1
                }
            }
            return false
        }
        if kind == FOX_ITEMS {
            if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
                if self.living.equipment[0] != none or self.target_in(players) != none or self.living.hurt_by_mob != none or not self.fox_can_move() {
                    return false
                }
                if self.living.body.random.next_int_below(reduced_tick_delay(10)) != 0 {
                    return false
                }
                return not self.fox.items.is_empty()
            }
            if (call == GOAL_START or call == GOAL_TICK) and self.living.equipment[0] == none and not self.fox.items.is_empty() {
                let (_, x, y, z) = self.fox.items[0]
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, x, y, z, 1.2)
            }
            return false
        }
        // `PerchAndSearchGoal`.
        if call == GOAL_CAN_USE {
            return self.living.hurt_by_mob == none and self.living.body.random.next_float() < 0.02f32 and not self.fox_flag(FOX_SLEEPING) and self.target_in(players) == none and self.navigation.is_done() and not self.fox_alertable(players) and not self.fox_flag(FOX_POUNCING) and not self.fox_flag(FOX_CROUCHING)
        }
        if call == GOAL_CONTINUE {
            return self.fox.perch_left > 0
        }
        if call == GOAL_START {
            self.fox_reset_look()
            self.fox.perch_left = 2 + self.living.body.random.next_int_below(3)
            self.set_fox_flag(FOX_SITTING, true)
            self.navigation.stop()
        } else if call == GOAL_STOP {
            self.set_fox_flag(FOX_SITTING, false)
        } else if call == GOAL_TICK {
            self.fox.perch_look -= 1
            if self.fox.perch_look <= 0 {
                self.fox.perch_left -= 1
                self.fox_reset_look()
            }
            let eye = self.living.body.y + f64(self.living.body.eyes)
            self.look.set_look_at(self.living.body.x + self.fox.perch_x, eye, self.living.body.z + self.fox.perch_z, self.max_head_y_rot(), self.max_head_x_rot())
        }
        return false
    }

    // `SleepGoal.canSleep` (CAL-201): its count down to sleep counted while it isn't done, else by
    // day, sheltered, not alertable and not in powder snow.
    fn fox_may_sleep<B: CollisionBlocks + MobLight>(mut self, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) -> bool {
        if self.fox.sleep_countdown > 0 {
            self.fox.sleep_countdown -= 1
            return false
        }
        return blocks.bright_outside() and self.fox_sheltered(lf, f, blocks) and not self.fox_alertable(players) and not self.living.body.in_powder_snow
    }

    // `FoxEatBerriesGoal.onReachedTarget` of the block at x, y, z (CAL-201), where mob griefing's
    // on: of a sweet berry bush, `pickSweetBerries`, 1 or 2 berries, drawn from its level's random,
    // and 1 more where it's fully grown, one held in its mouth where it held nothing, the rest
    // popped out, heard, the bush aged 1, which its level does, `Shown.Picked`; of cave vines,
    // `CaveVines.use`, which its level does as a player's pick.
    fn fox_pick_berries<B: CollisionBlocks>(mut self, f: Facts, blocks: B, x: i32, y: i32, z: i32, sounds: mut List<EntitySound>) {
        if not self.mob_griefing {
            return
        }
        let state = state_at(blocks, x, y, z)
        if f.is_a(f.block(state), String("SweetBerryBushBlock")) {
            let age = f.get_int(state, String("age")) ?? 0
            var count = 1
            if let lent = self.level_random.take() {
                var random = lent
                count += random.next_int_below(2)
                self.level_random = some(random)
            }
            if age == 3 {
                count += 1
            }
            if self.living.equipment[0] == none {
                self.living.equipment[0] = some(stack_of(String("minecraft:sweet_berries")))
                count -= 1
            }
            self.living.show(Shown.FoxBerries((x, y, z, count)), sounds.len())
            self.living.play(mut sounds, String("block.sweet_berry_bush.pick_berries"), 1.0f32, 1.0f32)
        } else if f.get_bool(state, String("berries")) {
            self.living.show(Shown.FoxBerries((x, y, z, -1)), sounds.len())
        }
    }

    // `ItemStack.finishUsingItem` of the food in a fox's mouth, `held` (CAL-311), as
    // `Consumable.onConsume` uses it up for a mob: `emitParticlesAndSounds` of 16 from its random,
    // a coin for an eaten one's volume, a half on heads, a triangle about 1 a fifth wide for its
    // pitch, one from 0.9 to 1 for a drunk one's at half volume, four floats for each of its
    // particles, which the server shows no one, and its sound where it isn't silent; then its
    // food's, `FoodProperties.onConsume`, heard even so, among the neutral sounds, its pitch a
    // triangle about 1 two fifths wide. What else it does as it's used up, a stew's effects and its
    // game event are said to be missing. Then one of it gone, `consume`, and where none's left,
    // what it leaves, `use_remainder`, said to be missing too.
    fn fox_eats<W: Wearing>(mut self, items: W, held: Tag, sounds: mut List<EntitySound>) {
        let tag = items.worn_component(held.copy(), String("minecraft:consumable")) ?? Tag.End
        let c = read_consumable(tag) else return
        let soft = self.living.body.random.next_boolean()
        let first = self.living.body.random.next_float()
        let second = self.living.body.random.next_float()
        let eat_pitch = 1.0f32 + 0.2f32 * (first - second)
        let drink_pitch = self.living.body.random.next_float() * (1.0f32 - 0.9f32) + 0.9f32
        if c.particles {
            for _ in 0..64 {
                _ = self.living.body.random.next_float()
            }
        }
        let volume = if c.drinks() or soft { 0.5f32 } else { 1.0f32 }
        let pitch = if c.drinks() { drink_pitch } else { eat_pitch }
        let name = if c.sound.starts_with("minecraft:") { c.sound[10..c.sound.len()] } else { c.sound.copy() }
        self.living.play(mut sounds, name.copy(), volume, pitch)
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        sounds.push(EntitySound { sound: name, x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 1.0f32, pitch: 1.0f32 + 0.4f32 * (a - b), source: NEUTRAL_SOURCE })
        if not c.effects.is_empty() or items.worn_component(held.copy(), String("minecraft:suspicious_stew_effects")) != none {
            self.living.show(Shown.Missing(String("What a fox's food does as it eats it")), sounds.len())
        }
        self.living.show(Shown.Missing(String("The game events of eating and drinking")), sounds.len())
        let have = count_of(some(held.copy()))
        if have > 1 {
            self.living.equipment[0] = some(stack_of_count(held, have - 1))
            return
        }
        if items.worn_component(held, String("minecraft:use_remainder")) != none {
            self.living.show(Shown.Missing(String("What a fox's food leaves in its mouth, use_remainder")), sounds.len())
        }
        self.living.equipment[0] = none
    }

    // `Fox.aiStep`'s, before an animal's (CAL-201): alive and thinking, a tick more since it ate;
    // food in its mouth, `isConsumableFood`, without a target, on the ground and awake, past 600
    // ticks it's eaten, `fox_eats`, and its count 0, else past 560 one in 10, drawn, its eating heard and shown, entity event 45; without a target alive,
    // neither crouching nor interested. Asleep or dying, not jumping nor told to walk.
    fn fox_ai_start<W: Wearing>(mut self, items: W, players: List<Follower>, sounds: mut List<EntitySound>) {
        if self.living.alive() and not self.no_ai() {
            self.fox.since_eaten += 1
            let held = self.living.equipment[0].copy()
            if let h = held {
                let food = items.worn_component(h.copy(), String("minecraft:food")) != none and items.worn_component(h.copy(), String("minecraft:consumable")) != none
                if food and self.target == none and self.living.body.on_ground and not self.fox_flag(FOX_SLEEPING) {
                    if self.fox.since_eaten > 600 {
                        self.fox_eats(items, h.copy(), mut sounds)
                        self.fox.since_eaten = 0
                    } else if self.fox.since_eaten > 560 and self.living.body.random.next_float() < 0.1f32 {
                        self.living.play(mut sounds, String("entity.fox.eat"), 1.0f32, 1.0f32)
                        self.living.show(Shown.Event(45i8), sounds.len())
                    }
                }
            }
            let alive = match self.target_in(players) {
                some(p) => not p.dead,
                none => false,
            }
            if not alive {
                self.set_fox_flag(FOX_CROUCHING, false)
                self.set_fox_flag(FOX_INTERESTED, false)
            }
        }
        if self.fox_flag(FOX_SLEEPING) or self.living.dead_or_dying() {
            self.living.jumping = false
            self.living.xxa = 0.0f32
            self.living.zza = 0.0f32
        }
    }

    // `Fox.tick`'s, after the rest (CAL-201): thinking, in water, with a target or in thunder, it
    // wakes; in water or asleep, it stops sitting; faceplanted, one in 5 of its level's random, its
    // block's broken look shown, level event 2001, which its level shows. Its crouch grows a fifth
    // a tick to 5 while it crouches, else none.
    fn fox_tick_end<B: CollisionBlocks + MobLight>(mut self, blocks: B, sounds: List<EntitySound>) {
        if not self.no_ai() {
            let wet = self.living.body.in_water
            if wet or self.target != none or blocks.thundering() {
                self.set_fox_flag(FOX_SLEEPING, false)
            }
            if wet or self.fox_flag(FOX_SLEEPING) {
                self.set_fox_flag(FOX_SITTING, false)
            }
            if self.fox_flag(FOX_FACEPLANTED) {
                if let lent = self.level_random.take() {
                    var random = lent
                    let shown = random.next_float() < 0.2f32
                    self.level_random = some(random)
                    if shown {
                        let (bx, by, bz) = self.block_position()
                        let state = state_at(blocks, bx, by, bz)
                        self.living.show(Shown.Level((2001, bx, by, bz, i32.wrap(state))), sounds.len())
                    }
                }
            }
        }
        if self.fox_flag(FOX_CROUCHING) {
            self.fox.crouch += 0.2f32
            if self.fox.crouch > 5.0f32 {
                self.fox.crouch = 5.0f32
            }
        } else {
            self.fox.crouch = 0.0f32
        }
    }

    // `Fox.getAmbientSound` (CAL-201): asleep, its sleep; else by night 1 in 10, drawn, with no
    // player near, its screech; else its ambient sound.
    fn fox_ambient<B: MobLight>(mut self, blocks: B) -> String {
        if self.fox_flag(FOX_SLEEPING) {
            return String("entity.fox.sleep")
        }
        if not blocks.bright_outside() and self.living.body.random.next_float() < 0.1f32 and not self.fox.players_near {
            return String("entity.fox.screech")
        }
        return String("entity.fox.ambient")
    }

    /// A fox's target goals by its variant, `setTargetGoals`, once (CAL-201): a red one's chickens
    /// and rabbits, then baby turtles on land, at 4, then schooling fish at 6; a snow fox's fish
    /// at 4, then the others at 6; each unseen, one in ten tries, fish one in twenty.
    pub fn fox_target_goals(mut self) {
        if self.species != FOX or self.fox.targets_set {
            return
        }
        self.fox.targets_set = true
        let (land, fish) = if self.living.data.number(OWN) == 0 { (4, 6) } else { (6, 4) }
        if land == 4 {
            self.targets.add(4, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_FOX_PREY, interval: reduced_tick_delay(10), targeting: Targeting { must_see: false } }))
            self.targets.add(4, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_TURTLE, interval: reduced_tick_delay(10), targeting: Targeting { must_see: false } }))
            self.targets.add(fish, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_FISH, interval: reduced_tick_delay(20), targeting: Targeting { must_see: false } }))
        } else {
            self.targets.add(fish, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_FISH, interval: reduced_tick_delay(20), targeting: Targeting { must_see: false } }))
            self.targets.add(land, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_FOX_PREY, interval: reduced_tick_delay(10), targeting: Targeting { must_see: false } }))
            self.targets.add(land, FLAG_TARGET, false, Goal.Nearest(Nearest { seek: SEEK_TURTLE, interval: reduced_tick_delay(10), targeting: Targeting { must_see: false } }))
        }
    }

    // `Fox.canHoldItem` of `stack` (CAL-201): its mouth empty, or since it last ate, food for
    // something not food.
    pub fn fox_can_hold<W: Wearing>(self, items: W, stack: Tag) -> bool {
        let held = self.living.equipment[0].copy() else return true
        let food = items.worn_component(stack.copy(), String("minecraft:food")) != none and items.worn_component(stack, String("minecraft:consumable")) != none
        let held_food = items.worn_component(held.copy(), String("minecraft:food")) != none and items.worn_component(held, String("minecraft:consumable")) != none
        return self.fox.since_eaten > 0 and food and not held_food
    }

    /// A fox's pickup of the item `item`, of `stack`, `Fox.pickUpItem` (CAL-201), where it may
    /// hold it: all but one dropped where it was, `dropItemStack`; what it held spat out, `spitOutItem`,
    /// heard; one taken into its mouth, sure to drop, its pickup shown with what's left, none; and
    /// its count since it ate 0.
    pub fn fox_pick_up(mut self, item: i32, stack: Tag, sounds: mut List<EntitySound>) {
        let count = count_of(some(stack.copy()))
        if count > 1 {
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            self.living.show(Shown.Survived(Spilled { x: x, y: y, z: z, stack: recounted(stack.copy(), count - 1) }), sounds.len())
        }
        if let held = self.living.equipment[0].copy() {
            let look = view_vector(self.living.body.x_rot, self.living.body.y_rot)
            let (lx, _, lz) = look
            let (x, y, z) = (self.living.body.x + lx, self.living.body.y + 1.0, self.living.body.z + lz)
            let thrower = self.living.body.uuid
            self.living.play(mut sounds, String("entity.fox.spit"), 1.0f32, 1.0f32)
            self.living.show(Shown.Spat(Tossed { x: x, y: y, z: z, vx: 0.0, vy: 0.0, vz: 0.0, stack: held, thrower: thrower }), sounds.len())
        }
        self.living.equipment[0] = some(recounted(stack, 1))
        self.guarantee_drop(0)
        self.living.show(Shown.Picked((item, 0)), sounds.len())
        self.fox.since_eaten = 0
    }

    // A fox's `DefendTrustedTargetGoal`, a `NearestAttackableTargetGoal` of living entities,
    // unseen, one in ten tries (CAL-201): used, after its draw, where the first of those it trusts
    // that's here, a player, was hurt anew, by their tick count then, by one it may attack: not
    // itself, one it may see as an enemy that's hurt something and that it doesn't trust, no player
    // in peaceful, within its follow range as visible to it, seen, its block within its home. As it
    // starts, that one its target, their tick count kept, its aggression heard, defending and awake;
    // then a target goal's going on and stop, which stops its defending.
    fn fox_defend_goal<B: CollisionBlocks + MobLight>(mut self, g: mut Nearest, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            if g.interval > 0 and self.living.body.random.next_int_below(g.interval) != 0 {
                return false
            }
            for slot in [OWN + 2, OWN + 3] {
                let u = self.living.data.uuid(slot) else continue
                var trusted: Follower? = none
                for p in players {
                    if p.uuid == some(u) and trusted == none {
                        trusted = some(p.copy())
                    }
                }
                let o = trusted else continue
                g.found = o.hurt_by
                if o.hurt_by_stamp == g.timestamp {
                    return false
                }
                let id = g.found else return false
                let who = self.followed(players, id) else return false
                if who.id == self.living.body.id or who.dead or not who.enemy or who.hurt_mob == none or self.fox_trusts(who.uuid) {
                    return false
                }
                if not who.mob and (who.spectator or self.difficulty == 0) {
                    return false
                }
                let range = self.living.attributes.value(lf.follow_range)
                let visibility = who.visibility(self.looker().kind)
                let within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
                if self.distance_sqr_to(who.x, who.y, who.z) > within * within {
                    return false
                }
                let me = self.looker()
                if not sees_player(m, f, blocks, mut self.sensing, me, who) {
                    return false
                }
                return self.within_home(who.x, who.y, who.z)
            }
            return false
        }
        if call == GOAL_CONTINUE {
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            self.set_target(g.found, players)
            for slot in [OWN + 2, OWN + 3] {
                let u = self.living.data.uuid(slot) else continue
                var stamp: i32? = none
                for p in players {
                    if p.uuid == some(u) and stamp == none {
                        stamp = some(p.hurt_by_stamp)
                    }
                }
                if let s = stamp {
                    g.timestamp = s
                    break
                }
            }
            self.set_fox_flag(FOX_DEFENDING, true)
            self.set_fox_flag(FOX_SLEEPING, false)
            self.set_target(g.found, players)
            g.targeting.unseen_ticks = 0
        } else if call == GOAL_STOP {
            self.target_to(none)
            g.targeting.target_mob = none
        }
        return false
    }

    // `Fox.populateDefaultEquipmentSlots` from its level's random `r` (CAL-201): 1 in 5 something in
    // its mouth, by a float drawn: an emerald under a twentieth, an egg under a fifth, a rabbit's
    // foot or hide, a coin, under two fifths, wheat under three, leather under four, else a
    // feather.
    fn fox_mouth<R: RandomSource>(mut self, r: mut R) {
        if not (r.next_float() < 0.2f32) {
            return
        }
        let odds = r.next_float()
        var name = "minecraft:feather"
        if odds < 0.05f32 {
            name = "minecraft:emerald"
        } else if odds < 0.2f32 {
            name = "minecraft:egg"
        } else if odds < 0.4f32 {
            name = if r.next_boolean() { "minecraft:rabbit_foot" } else { "minecraft:rabbit_hide" }
        } else if odds < 0.6f32 {
            name = "minecraft:wheat"
        } else if odds < 0.8f32 {
            name = "minecraft:leather"
        }
        self.living.equipment[0] = some(stack_of(String(name)))
    }

    /// Whether it carries a chest it may wear, `AbstractChestedHorse`: a donkey or a llama
    /// (CAL-201).
    pub fn chested(self) -> bool {
        return self.species == DONKEY or self.species == LLAMA
    }

    /// A llama's strength, `Llama.getStrength`, `DATA_STRENGTH_ID` (CAL-201), which sizes its
    /// chest and how sure a wolf is to flee it.
    pub fn llama_strength(self) -> i32 {
        return self.living.data.number(OWN + 2)
    }

    // `Llama.setStrength`: from 1 to 5 (CAL-201).
    fn set_llama_strength(mut self, strength: i32) {
        let s = if strength > 5 { 5 } else { strength }
        self.living.data.set(OWN + 2, Value.Number(if s < 1 { 1 } else { s }))
    }

    /// Its temper's most, `getMaxTemper`: a llama's 30, a horse's 100 (CAL-201).
    pub fn max_temper(self) -> i32 {
        return if self.species == LLAMA { 30 } else { 100 }
    }

    // `Llama.handleEating` of `item` (CAL-201), as `horse_fed` has a horse's: wheat heals it by 2,
    // grows a baby by 10 and tempers it by 3; a hay bale heals it by 10, grows it by 90 and
    // tempers it by 6, and puts a tamed grown one not in love in love, the player its cause,
    // `setInLove`, entity event 18 after the sounds `heard`; hurt, it's healed; a baby not locked,
    // the particles its level wouldn't show drawn from its random, grows, `ageUp`; and where it ate
    // or isn't tamed, its temper rises toward 30. Where any of that was, its eating heard, its
    // pitch drawn, where it isn't silent, and one of the food used, `SUCCESS_SERVER`; it opens no
    // mouth, `eating`, as a horse does. Else `PASS`.
    fn llama_fed(mut self, lf: LivingFacts, item: String, player: (i64, i64), heard: usize) -> Interaction {
        let tamed = self.horse_flag(2)
        var used = false
        var heal = 0.0f32
        var age_up = 0
        var temper = 0
        if item == "minecraft:wheat" {
            age_up = 10
            temper = 3
            heal = 2.0f32
        } else if item == "minecraft:hay_block" {
            age_up = 90
            temper = 6
            heal = 10.0f32
            if tamed and self.age == 0 and self.in_love <= 0 {
                used = true
                self.in_love = 600
                self.kept.insert(String("LoveCause"), uuid_tag(player))
                self.living.show(Shown.Event(18), heard)
            }
        }
        if self.living.health() < self.living.max_health(lf) and heal > 0.0f32 {
            self.living.heal(lf, heal)
            used = true
        }
        if self.baby() and age_up > 0 and not self.living.data.flag(AGE_LOCKED) {
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
            self.age_up(age_up)
            used = true
        }
        if temper > 0 and (used or not tamed) and self.temper < 30 {
            let t = self.temper + temper
            self.temper = if t > 30 { 30 } else if t < 0 { 0 } else { t }
            used = true
        }
        if not used {
            return Interaction { result: INTERACT_PASS, used: false }
        }
        var out = Interaction { result: INTERACT_SERVER, used: true }
        if not self.living.silent() {
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut out.sounds, String("entity.llama.eat"), 1.0f32, 1.0f32 + (a - b) * 0.2f32)
        }
        return out
    }

    // `Llama.spit` at `p`, `performRangedAttack` (CAL-201): its spit made beside its head, half its
    // width and a block off along the way its body faces and a tenth below its eyes, shot toward
    // them a third of the way up them, and a fifth of the way across above that, at 1.5 blocks a
    // tick, 10 off, `rangedAttackUncertainty`, which its level makes, `Shown.Hurled`; then its spit
    // heard, its pitch drawn, where it isn't silent; and it spat, `didSpit`.
    fn llama_spit(mut self, p: Follower, sounds: mut List<EntitySound>) {
        let rad = f64(self.living.y_body_rot * 0.017453292f32)
        let reach = f64((self.living.body.width + 1.0f32)) * 0.5
        let x = self.living.body.x - reach * f64(table_sin(rad))
        let y = self.living.body.y + f64(self.living.body.eyes) - f64(0.1f32)
        let z = self.living.body.z + reach * f64(table_cos(rad))
        let xd = p.x - self.living.body.x
        let yd = p.y + f64(p.height) * 0.3333333333333333 - y
        let zd = p.z - self.living.body.z
        let yo = (xd * xd + zd * zd).sqrt() * f64(0.2f32)
        let thrown = Hurled { owner: self.living.body.uuid, x: x, y: y, z: z, xd: xd, yd: yd + yo, zd: zd, power: 1.5f32, uncertainty: 10.0f32, potion: String(), spit: true }
        self.living.show(Shown.Hurled(thrown), sounds.len())
        if not self.living.silent() {
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, String("entity.llama.spit"), 1.0f32, 1.0f32 + (a - b) * 0.2f32)
        }
        self.did_spit = true
    }

    // Whether the llama `id`, as its level lent it the llamas, is in a caravan whose first llama
    // within 8 more is leashed, `LlamaFollowCaravanGoal.firstIsLeashed`, starting at `counter`
    // (CAL-201).
    fn first_leashed(self, id: i32, counter: i32) -> bool {
        var at = id
        var n = counter
        while n <= 8 {
            var head: i32? = none
            if at == self.living.body.id {
                head = self.caravan_head
            } else {
                for l in self.llamas {
                    if l.id == at {
                        head = l.head
                    }
                }
            }
            let h = head else return false
            var leashed = false
            var found = false
            for l in self.llamas {
                if l.id == h {
                    leashed = l.leashed
                    found = true
                }
            }
            if not found {
                return false
            }
            if leashed {
                return true
            }
            at = h
            n += 1
        }
        return false
    }

    // The llama `id` as its level lent it, `CaravanLlama`.
    fn llama_of(self, id: i32) -> CaravanLlama? {
        for l in self.llamas {
            if l.id == id {
                return some(l)
            }
        }
        return none
    }

    // `LlamaFollowCaravanGoal` at its speed (CAL-201): used where it's neither leashed nor in a
    // caravan, of the llamas whose boxes meet its own grown 9 across and 4 up or down, the nearest
    // in a caravan without a tail, the last of those as near, else the nearest leashed one without
    // a tail, at least 2 off, leashed or the end of a caravan whose first is: it joins its caravan,
    // that one's tail, `Told.Caravan`. It goes on while it's in one whose head's alive and whose
    // first's leashed, past 26 off quickening by a fifth up to 3 times, counting down 40 ticks,
    // at its end, past 3, given up. Each tick, unless a knot holds it, toward its head, short of
    // it by 2. As it stops, it leaves its caravan and its speed's 2.1 again.
    fn caravan_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Caravan, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.leashed() or self.caravan_head != none {
                return false
            }
            let b = self.living.body.bounding_box()
            let wide = Aabb { min_x: b.min_x - 9.0, min_y: b.min_y - 4.0, min_z: b.min_z - 9.0, max_x: b.max_x + 9.0, max_y: b.max_y + 4.0, max_z: b.max_z + 9.0 }
            var near = List<CaravanLlama>()
            for l in self.llamas {
                if l.id != self.living.body.id and l.bounds.intersects(wide.min_x, wide.min_y, wide.min_z, wide.max_x, wide.max_y, wide.max_z) {
                    near.push(l)
                }
            }
            var closest: CaravanLlama? = none
            var closest_d = 1.7976931348623157e308
            for l in near {
                if l.head != none and l.tail == none {
                    let d = self.distance_sqr_to(l.x, l.y, l.z)
                    if not (d > closest_d) {
                        closest_d = d
                        closest = some(l)
                    }
                }
            }
            if closest == none {
                for l in near {
                    if l.leashed and l.tail == none {
                        let d = self.distance_sqr_to(l.x, l.y, l.z)
                        if not (d > closest_d) {
                            closest_d = d
                            closest = some(l)
                        }
                    }
                }
            }
            let c = closest else return false
            if closest_d < 4.0 {
                return false
            }
            if not c.leashed and not self.first_leashed(c.id, 1) {
                return false
            }
            self.caravan_head = some(c.id)
            self.told.push(Told.Caravan((c.id, self.living.body.id)))
            return true
        }
        if call == GOAL_CONTINUE {
            let h = self.caravan_head else return false
            let head = self.llama_of(h) else return false
            if not head.alive or not self.first_leashed(self.living.body.id, 0) {
                return false
            }
            let d = self.distance_sqr_to(head.x, head.y, head.z)
            if d > 676.0 {
                if g.speed <= 3.0 {
                    g.speed = g.speed * 1.2
                    g.dist_check = reduced_tick_delay(40)
                    return true
                }
                if g.dist_check == 0 {
                    return false
                }
            }
            if g.dist_check > 0 {
                g.dist_check -= 1
            }
            return true
        }
        if call == GOAL_STOP {
            if let h = self.caravan_head {
                self.told.push(Told.Caravan((h, -1)))
            }
            self.caravan_head = none
            g.speed = 2.1
        } else if call == GOAL_TICK {
            let h = self.caravan_head else return false
            var knot = false
            if let held = self.leash_holder() {
                knot = held.knot != none
            }
            if knot {
                return false
            }
            let head = self.llama_of(h) else return false
            let (hx, hy, hz) = (head.x - self.living.body.x, head.y - self.living.body.y, head.z - self.living.body.z)
            let dx = f32.nearest(self.living.body.x - head.x)
            let dy = f32.nearest(self.living.body.y - head.y)
            let dz = f32.nearest(self.living.body.z - head.z)
            let apart = f64(f32.nearest(f64(dx * dx + dy * dy + dz * dz).sqrt()))
            let off = if apart - 2.0 > 0.0 { apart - 2.0 } else { 0.0 }
            let (nx, ny, nz) = normalized_of(hx, hy, hz)
            let (tx, ty, tz) = (self.living.body.x + nx * off, self.living.body.y + ny * off, self.living.body.z + nz * off)
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, tx, ty, tz, g.speed)
        }
        return false
    }

    // A panda's flag `flag` of its flags, `DATA_ID_FLAGS`, `getFlag`, and set, `setFlag` (CAL-201).
    fn panda_flag(self, flag: i32) -> bool {
        return self.species == PANDA and i32(self.living.data.byte(OWN + 5)) & flag != 0
    }

    fn set_panda_flag(mut self, flag: i32, on: bool) {
        let flags = i32(self.living.data.byte(OWN + 5))
        self.living.data.set(OWN + 5, Value.Byte(i8.wrap(if on { flags | flag } else { flags & ~flag })))
    }

    // A panda's main and hidden genes, by their IDs, `getMainGene` and `getHiddenGene`, any but
    // the seven read as normal, `OutOfBoundsStrategy.ZERO` (CAL-201).
    fn panda_main(self) -> i32 {
        return gene_of(i32(self.living.data.byte(OWN + 3)))
    }

    fn panda_hidden(self) -> i32 {
        return gene_of(i32(self.living.data.byte(OWN + 4)))
    }

    // Its genes set, `setMainGene` and `setHiddenGene`, its ambient sound by them (CAL-201).
    fn set_panda_genes(mut self, main: i32, hidden: i32) {
        self.living.data.set(OWN + 3, Value.Byte(i8.wrap(main)))
        self.living.data.set(OWN + 4, Value.Byte(i8.wrap(hidden)))
        self.refresh_sounds()
    }

    /// A panda's variant, `getVariant`, `Gene.getVariantFromGenes` (CAL-201): a recessive main
    /// gene, brown or weak, shows only where its hidden gene's the same, else it's normal.
    pub fn panda_variant(self) -> i32 {
        let main = self.panda_main()
        if main == GENE_BROWN or main == GENE_WEAK {
            return if main == self.panda_hidden() { main } else { GENE_NORMAL }
        }
        return main
    }

    // `Panda.setAttributes` (CAL-201): a weak one's most health 10, a lazy one's speed 0.07.
    fn panda_attributes(mut self) {
        let v = self.panda_variant()
        if v == GENE_WEAK {
            self.set_base("minecraft:max_health", 10.0)
        }
        if v == GENE_LAZY {
            self.set_base("minecraft:movement_speed", f64(0.07f32))
        }
    }

    // Whether a panda's eating, `isEating`, its eating count above 0, and its count set, `eat`,
    // 1 or 0 (CAL-201).
    fn panda_eating(self) -> bool {
        return self.species == PANDA and self.living.data.number(OWN + 2) > 0
    }

    fn panda_eat(mut self, on: bool) {
        self.living.data.set(OWN + 2, Value.Number(if on { 1 } else { 0 }))
    }

    // `isScared`: a worried one in thunder, which its tick reads of its level (CAL-201).
    fn panda_scared(self) -> bool {
        return self.panda_variant() == GENE_WORRIED and self.panda.thunder
    }

    /// `Panda.canPerformAction` (CAL-201): not on its back, scared, eating, rolling nor sitting.
    pub fn panda_can_act(self) -> bool {
        return not self.panda_flag(PANDA_ON_BACK) and not self.panda_scared() and not self.panda_eating() and not self.panda_flag(PANDA_ROLLING) and not self.panda_flag(PANDA_SITTING)
    }

    // `Panda.sit`, and `sneeze`, whose count's 0 once it stops (CAL-201).
    fn panda_sit(mut self, on: bool) {
        self.set_panda_flag(PANDA_SITTING, on)
    }

    fn panda_sneeze(mut self, on: bool) {
        self.set_panda_flag(PANDA_SNEEZING, on)
        if not on {
            self.living.data.set(OWN + 1, Value.Number(0))
        }
    }

    // `tryToSit` (CAL-201): out of water, told to walk nowhere, its navigation stopped, sitting.
    fn panda_try_sit(mut self) {
        if not self.living.body.in_water {
            self.living.zza = 0.0f32
            self.navigation.stop()
            self.panda_sit(true)
        }
    }

    // `Panda.tick`'s, after the rest (CAL-201): a worried one sits in thunder out of water and
    // stops eating, else stops sitting while it isn't eating; without a target, it neither got
    // bamboo nor bit; unhappy, it turns to its target at once, 90 degrees, `lookAt`, and is heard
    // as its count reaches 29 and 14, `PANDA_CANT_BREED`, and counts it down; sneezing, it counts
    // the sneeze, heard first, `PANDA_PRE_SNEEZE`, and past 20 stops and sneezes, `afterSneeze`;
    // rolling, it rolls, `handleRoll`, else its roll's count is 0; sitting, its pitch level; then
    // it eats, `handleEating`.
    fn panda_tick_end<B: CollisionBlocks + MobLight>(mut self, lf: LivingFacts, blocks: B, players: List<Follower>, sounds: mut List<EntitySound>) {
        self.panda.thunder = blocks.thundering()
        if self.panda_variant() == GENE_WORRIED {
            if self.panda.thunder and not self.living.body.in_water {
                self.panda_sit(true)
                self.panda_eat(false)
            } else if not self.panda_eating() {
                self.panda_sit(false)
            }
        }
        let target = self.target_in(players)
        if self.target == none {
            self.panda.got_bamboo = false
            self.panda.did_bite = false
        }
        let unhappy = self.living.data.number(OWN)
        if unhappy > 0 {
            if let p = target {
                self.look_at_now(p, 90.0f32, 90.0f32)
            }
            if unhappy == 29 or unhappy == 14 {
                self.living.play(mut sounds, String("entity.panda.cant_breed"), 1.0f32, 1.0f32)
            }
            self.living.data.set(OWN, Value.Number(unhappy - 1))
        }
        if self.panda_flag(PANDA_SNEEZING) {
            let count = self.living.data.number(OWN + 1) + 1
            self.living.data.set(OWN + 1, Value.Number(count))
            if count > 20 {
                self.panda_sneeze(false)
                self.panda_after_sneeze(mut sounds)
            } else if count == 1 {
                self.living.play(mut sounds, String("entity.panda.pre_sneeze"), 1.0f32, 1.0f32)
            }
        }
        // Its roll comes after its push, `handleRoll` after `aiStep`, which reads its motion,
        // `panda_rolls`.
        if self.panda_flag(PANDA_ROLLING) {
            self.panda.roll_due = true
        } else {
            self.panda.roll_counter = 0
        }
        if self.panda_flag(PANDA_SITTING) {
            self.living.body.x_rot = 0.0f32
        }
        self.panda_handle_eating(lf, mut sounds)
    }

    // `Panda.handleRoll` (CAL-201): its count on, past 32 no more rolling; else on its first, its
    // way 0.2 along its facing, a baby's 0.1, on its motion across, and up at 0.27; on its 7th,
    // 15th and 23rd, still across, hopping 0.27 where it's on the ground; else that way across at
    // its motion up.
    // Its roll where it was due this tick, after its push (CAL-201).
    pub fn panda_rolls(mut self) {
        if self.panda.roll_due {
            self.panda.roll_due = false
            self.panda_roll()
        }
    }

    fn panda_roll(mut self) {
        self.panda.roll_counter += 1
        let n = self.panda.roll_counter
        if n > 32 {
            self.set_panda_flag(PANDA_ROLLING, false)
            return
        }
        let (vx, vy, vz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
        if n == 1 {
            let angle = self.living.body.y_rot * 0.017453292f32
            let by = if self.baby() { 0.1f32 } else { 0.2f32 }
            self.panda.roll_dx = vx + f64(-table_sin(f64(angle)) * by)
            self.panda.roll_dz = vz + f64(table_cos(f64(angle)) * by)
            self.living.body.vx = self.panda.roll_dx
            self.living.body.vy = 0.27
            self.living.body.vz = self.panda.roll_dz
        } else if n != 7 and n != 15 and n != 23 {
            self.living.body.vx = self.panda.roll_dx
            self.living.body.vz = self.panda.roll_dz
        } else {
            self.living.body.vx = 0.0
            self.living.body.vy = if self.living.body.on_ground { 0.27 } else { vy }
            self.living.body.vz = 0.0
        }
    }

    // `Panda.afterSneeze` (CAL-201): its sneeze's particle, which only clients show; heard,
    // `PANDA_SNEEZE`; each grown panda on the ground, out of water and free to act within its box
    // grown 10 made to jump, which its level does, `sneezed`; and where mobs drop loot, its gift,
    // `gameplay/panda_sneeze`, dropped where it is.
    fn panda_after_sneeze(mut self, sounds: mut List<EntitySound>) {
        self.living.play(mut sounds, String("entity.panda.sneeze"), 1.0f32, 1.0f32)
        self.sneezed = true
        if self.mob_drops {
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            self.living.show(Shown.Laid(Laid { x: x, y: y, z: z, item: String(), table: String("minecraft:gameplay/panda_sneeze") }), sounds.len())
        }
    }

    // `Panda.handleEating` (CAL-201): not eating, sitting, not scared and holding something, one in
    // 80, drawn, it starts; else holding nothing or not sitting, it stops. Eating, its sound and
    // crumbs every 5, `addEatingParticles`; past 80 one in 20, drawn, it stops, past 100 the food
    // from the ground it held eaten, gone from its hand, and it stands; else its count on.
    fn panda_handle_eating(mut self, lf: LivingFacts, sounds: mut List<EntitySound>) {
        let held = self.living.equipment[0] != none
        let sitting = self.panda_flag(PANDA_SITTING)
        if not self.panda_eating() and sitting and not self.panda_scared() and held and self.living.body.random.next_int_below(80) == 1 {
            self.panda_eat(true)
        } else if not held or not sitting {
            self.panda_eat(false)
        }
        if not self.panda_eating() {
            return
        }
        self.panda_crumbs(mut sounds)
        let count = self.living.data.number(OWN + 2)
        if count > 80 and self.living.body.random.next_int_below(20) == 1 {
            if count > 100 and panda_eats(lf, held_name(self.living.equipment[0])) {
                self.living.equipment[0] = none
                self.panda_sit(false)
            }
            self.panda_eat(false)
            return
        }
        self.living.data.set(OWN + 2, Value.Number(count + 1))
    }

    // `addEatingParticles` (CAL-201): every 5 of its count, heard, half or whole loud and at a
    // pitch, drawn, `PANDA_EAT`; and holding something, six crumbs of it, each its motion and place
    // drawn, which only clients show.
    fn panda_crumbs(mut self, sounds: mut List<EntitySound>) {
        if self.living.data.number(OWN + 2) % 5 != 0 {
            return
        }
        let loud = 0.5f32 + 0.5f32 * f32.nearest(self.living.body.random.next_int_below(2))
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        self.living.play(mut sounds, String("entity.panda.eat"), loud, (a - b) * 0.2f32 + 1.0f32)
        if self.living.equipment[0] == none {
            return
        }
        for _ in 0..36 {
            _ = self.living.body.random.next_float()
        }
    }

    // A panda's own goals (CAL-201), `kind`: `PandaSitGoal`, `PandaLieOnBackGoal`,
    // `PandaSneezeGoal` and `PandaRollGoal`.
    fn panda_goal<B: CollisionBlocks + NavLevel>(mut self, kind: i32, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) -> bool {
        let ticks = self.living.body.tick_count
        if kind == PANDA_SIT_GOAL {
            // Not cooling down, grown, out of water, free to act and happy, holding something or
            // with food from the ground within its box grown 6; going on out of water while lazy
            // or one in 600 doesn't come, and one in 2000 doesn't, each drawn; sitting as it ticks
            // while it holds something; as it starts going to the first such food within 8 at 1.2
            // where it holds nothing, else sitting; as it stops what it holds dropped, its cool down
            // 10 to 59 seconds, a lazy one's, else 10 to 159, drawn, and standing.
            if call == GOAL_CAN_USE {
                if self.panda.sit_cooldown > ticks or self.baby() or self.living.body.in_water or not self.panda_can_act() or self.living.data.number(OWN) > 0 {
                    return false
                }
                return self.living.equipment[0] != none or self.panda_food_near(6.0) != none
            }
            if call == GOAL_CONTINUE {
                if self.living.body.in_water {
                    return false
                }
                if not (self.panda_variant() == GENE_LAZY) and self.living.body.random.next_int_below(reduced_tick_delay(600)) == 1 {
                    return false
                }
                return self.living.body.random.next_int_below(reduced_tick_delay(2000)) != 1
            }
            if call == GOAL_TICK {
                if not self.panda_flag(PANDA_SITTING) and self.living.equipment[0] != none {
                    self.panda_try_sit()
                }
            } else if call == GOAL_START {
                if self.living.equipment[0] == none {
                    if let food = self.panda_food_near(8.0) {
                        let (x, y, z) = food
                        _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, x, y, z, f64(1.2f32))
                    }
                } else {
                    self.panda_try_sit()
                }
                self.panda.sit_cooldown = 0
            } else if call == GOAL_STOP {
                if let held = self.living.equipment[0].copy() {
                    self.spill_here(held, heard)
                    self.living.equipment[0] = none
                    let wait = if self.panda_variant() == GENE_LAZY { self.living.body.random.next_int_below(50) + 10 } else { self.living.body.random.next_int_below(150) + 10 }
                    self.panda.sit_cooldown = ticks + wait * 20
                }
                self.panda_sit(false)
            }
            return false
        }
        if kind == PANDA_BACK_GOAL {
            // Cooled down, lazy and free to act, one in 400, drawn; going on as the sit goal does;
            // on its back as it starts, off as it stops, its cool down 200 ticks.
            if call == GOAL_CAN_USE {
                return self.panda.back_cooldown < ticks and self.panda_variant() == GENE_LAZY and self.panda_can_act() and self.living.body.random.next_int_below(reduced_tick_delay(400)) == 1
            }
            if call == GOAL_CONTINUE {
                if self.living.body.in_water {
                    return false
                }
                if not (self.panda_variant() == GENE_LAZY) and self.living.body.random.next_int_below(reduced_tick_delay(600)) == 1 {
                    return false
                }
                return self.living.body.random.next_int_below(reduced_tick_delay(2000)) != 1
            }
            if call == GOAL_START {
                self.set_panda_flag(PANDA_ON_BACK, true)
                self.panda.back_cooldown = 0
            } else if call == GOAL_STOP {
                self.set_panda_flag(PANDA_ON_BACK, false)
                self.panda.back_cooldown = ticks + 200
            }
            return false
        }
        if kind == PANDA_SNEEZE_GOAL {
            // A baby free to act, a weak one one in 500, else one in 6000, each drawn; it sneezes as
            // it starts, and goes on no more.
            if call == GOAL_CAN_USE {
                if not (self.baby() and self.panda_can_act()) {
                    return false
                }
                if self.panda_variant() == GENE_WEAK and self.living.body.random.next_int_below(reduced_tick_delay(500)) == 1 {
                    return true
                }
                return self.living.body.random.next_int_below(reduced_tick_delay(6000)) == 1
            }
            if call == GOAL_START {
                self.panda_sneeze(true)
            }
            return false
        }
        // `PandaRollGoal`: a baby or a playful one on the ground, free to act, where the block
        // ahead of it, by its facing, below its feet is air, else a playful one one in 60, else
        // one in 500, each drawn; it rolls as it starts, and goes on no more.
        if call == GOAL_CAN_USE {
            if not ((self.baby() or self.panda_variant() == GENE_PLAYFUL) and self.living.body.on_ground) {
                return false
            }
            if not self.panda_can_act() {
                return false
            }
            let angle = self.living.body.y_rot * 0.017453292f32
            let xd = -table_sin(f64(angle))
            let zd = table_cos(f64(angle))
            let xs = if f64(xd).abs() > 0.5 { sign_of(xd) } else { 0 }
            let zs = if f64(zd).abs() > 0.5 { sign_of(zd) } else { 0 }
            let (bx, by, bz) = self.block_position()
            if f.is_air(state_at(blocks, bx + xs, by - 1, bz + zs)) {
                return true
            }
            if self.panda_variant() == GENE_PLAYFUL and self.living.body.random.next_int_below(reduced_tick_delay(60)) == 1 {
                return true
            }
            return self.living.body.random.next_int_below(reduced_tick_delay(500)) == 1
        }
        if call == GOAL_START {
            self.set_panda_flag(PANDA_ROLLING, true)
        }
        return false
    }

    // `Panda.mobInteract` (CAL-201), alive, with `item` in hand, by `player`: scared, nothing,
    // `PASS`; on its back, it rolls off, `SUCCESS`. Its food, `#panda_food`: with a target it
    // got bamboo; a baby that may grow grown by a tenth of what's left, `ageUp`, the food used,
    // `SUCCESS_SERVER`; another baby nothing; grown and not in love, in love by the player, the
    // food used; else, sitting or in water, nothing, else it sits and eats, what it held dropped
    // where it is unless the player has infinite materials, holding one of the food, the food
    // used. Anything else on a baby, a golden dandelion, does what an animal's use does; else
    // `PASS`.
    fn panda_interact(mut self, lf: LivingFacts, item: String, player: (i64, i64), heard: usize) -> Interaction? {
        if self.panda_scared() {
            return some(Interaction { result: INTERACT_PASS, used: false })
        }
        if self.panda_flag(PANDA_ON_BACK) {
            self.set_panda_flag(PANDA_ON_BACK, false)
            return some(Interaction { result: INTERACT_SUCCESS, used: false })
        }
        if lf.tempting.of(item.copy()) & TEMPT_PANDA == 0u32 {
            if self.baby() and item == "minecraft:golden_dandelion" {
                return none
            }
            return some(Interaction { result: INTERACT_PASS, used: false })
        }
        if self.target != none {
            self.panda.got_bamboo = true
        }
        if self.can_age_up() {
            let ticks = -self.age
            let seconds = i32.saturate(f64(f32.nearest(f64(ticks / 20)) * 0.1f32))
            self.age_up_forced(seconds)
            return some(Interaction { result: INTERACT_SERVER, used: true })
        }
        if self.baby() {
            return some(Interaction { result: INTERACT_PASS, used: false })
        }
        if self.age == 0 and self.in_love <= 0 {
            self.in_love = 600
            self.kept.insert(String("LoveCause"), uuid_tag(player))
            self.living.show(Shown.Event(18), heard)
            return some(Interaction { result: INTERACT_SERVER, used: true })
        }
        if self.panda_flag(PANDA_SITTING) or self.living.body.in_water {
            return some(Interaction { result: INTERACT_PASS, used: false })
        }
        self.panda_try_sit()
        self.panda_eat(true)
        var out = Interaction { result: INTERACT_SERVER, used: true }
        if let held = self.living.equipment[0].copy() {
            out.spilled = some((self.living.body.x, self.living.body.y, self.living.body.z, held))
        }
        self.living.equipment[0] = some(stack_of(item.copy()))
        return some(out)
    }

    // `PandaBreedGoal.canUse` (CAL-201): a breed goal's, while it's happy; then where it finds
    // bamboo near; else, its unhappiness cooled down, unhappy for 32 ticks, cooling down 600, and
    // its look at players goal set to look at the nearest player within 8 it sees, or none.
    fn panda_breeds<B: CollisionBlocks + NavLevel>(mut self, g: mut Breed, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, heard: usize) -> bool {
        if not self.breed_goal(mut g, GOAL_CAN_USE, lf, f, m, blocks, mut cache, min_y, heard) or self.living.data.number(OWN) != 0 {
            return false
        }
        if self.panda_bamboo_near(f, blocks) {
            return true
        }
        let ticks = self.living.body.tick_count
        if self.panda.unhappy_cooldown <= ticks {
            self.living.data.set(OWN, Value.Number(32))
            self.panda.unhappy_cooldown = ticks + 600
            let who = self.looker()
            self.panda.look_set = nearest_player(m, f, blocks, mut self.sensing, who, players, 8.0, self.living.body.y, true, 0u32)
            self.panda.look_set_given = true
        }
        return false
    }

    // `PandaBreedGoal.canFindBamboo` (CAL-201): bamboo in the rings about its block out to 7, at
    // its feet and up to 2 above.
    fn panda_bamboo_near<B: CollisionBlocks>(self, f: Facts, blocks: B) -> bool {
        let (px, py, pz) = self.block_position()
        for y in 0..3 {
            for r in 0..8 {
                var x = 0
                while x <= r {
                    var z = if x < r and x > -r { r } else { 0 }
                    while z <= r {
                        if f.is_a(f.block(state_at(blocks, px + x, py + y, pz + z)), String("BambooStalkBlock")) {
                            return true
                        }
                        z = if z > 0 { -z } else { 1 - z }
                    }
                    x = if x > 0 { -x } else { 1 - x }
                }
            }
        }
        return false
    }

    /// A panda partner's pick of one of its genes for a baby, either drawn,
    /// `getOneOfGenesRandomly`, as it's told once its partner's tick is done (CAL-201).
    pub fn panda_pick(mut self) {
        if self.species != PANDA {
            return
        }
        self.panda.picked = some(if self.living.body.random.next_boolean() { self.panda_main() } else { self.panda_hidden() })
    }

    /// Whom a panda partner picked of its genes for a baby, taken (CAL-201).
    pub fn panda_picked(mut self) -> i32 {
        return self.panda.picked.take() ?? GENE_NORMAL
    }

    /// A panda's baby's genes, `setGeneFromParents` (CAL-201): its parent's pick `mine` and its
    /// partner's `theirs`, which is main and which hidden drawn; then one in 32 each its main and
    /// its hidden one drawn afresh, `Gene.getRandom`; its attributes by them, `setAttributes`.
    pub fn panda_born(mut self, mine: i32, theirs: i32) {
        var main = theirs
        var hidden = mine
        if self.living.body.random.next_boolean() {
            main = mine
            hidden = theirs
        }
        if self.living.body.random.next_int_below(32) == 0 {
            main = panda_gene_from(self.living.body.random.next_int_below(16))
        }
        if self.living.body.random.next_int_below(32) == 0 {
            hidden = panda_gene_from(self.living.body.random.next_int_below(16))
        }
        self.set_panda_genes(main, hidden)
        self.panda_attributes()
    }

    /// Whether a panda takes up the item of `stack`, `Panda.pickUpItem` (CAL-201): holding
    /// nothing, food from the ground; held whole, sure to drop.
    /// `Dolphin.pickUpItem` of `stack` (CAL-201): into an empty main hand, whole, kept to drop
    /// whole, `setGuaranteedDrop`. Whether it took it.
    pub fn dolphin_pick_up(mut self, stack: Tag) -> bool {
        if self.living.equipment[0] != none {
            return false
        }
        self.living.equipment[0] = some(stack.copy())
        self.guarantee_drop(0)
        return true
    }

    pub fn panda_pick_up(mut self, lf: LivingFacts, stack: Tag) -> bool {
        if self.living.equipment[0] != none or not panda_eats(lf, held_name(some(stack.copy()))) {
            return false
        }
        self.living.equipment[0] = some(stack.copy())
        self.guarantee_drop(0)
        return true
    }

    /// Whether a panda's grown, on the ground, out of water and free to act, as a sneeze near it
    /// makes it jump, `afterSneeze` (CAL-201).
    pub fn panda_jumps(self) -> bool {
        return self.species == PANDA and not self.baby() and self.living.body.on_ground and not self.living.body.in_water and self.panda_can_act()
    }

    /// Whether it's an aggressive panda, `Panda.isAggressive`, by its variant (CAL-201).
    pub fn panda_aggressive(self) -> bool {
        return self.species == PANDA and self.panda_variant() == GENE_AGGRESSIVE
    }

    // The first food from the ground, `canPickUpAndEat`, whose box meets its own grown by `by`,
    // as `getEntitiesOfClass` finds them, which its level found for it: its place (CAL-201).
    fn panda_food_near(self, by: f64) -> (f64, f64, f64)? {
        let b = self.living.body.bounding_box().inflate(by, by, by)
        for food in self.panda.foods {
            let (_, x, y, z, box) = food
            if box.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                return some((x, y, z))
            }
        }
        return none
    }

    // `Parrot.getAmbient` as it's heard (CAL-201), of the level's random: off peaceful, one in
    // 1,000, drawn, one of the mobs it may mimic's sound, drawn, `MOB_SOUND_MAP`'s keys, else its
    // own. Vanilla's keys are a `HashMap`'s of the mobs' types, in an order that changes from run
    // to run, which `PARROT_MIMICS` stands for, in the order they're put.
    fn parrot_ambient(mut self, heard: usize) -> String {
        let lent = self.level_random.take()
        let had = lent != none
        if not had {
            self.living.show(Shown.Missing(String("A parrot's ambient sound without its level's random")), heard)
        }
        var random = lent ?? TapedRandom.new(0i64)
        var sound = String("entity.parrot.ambient")
        if self.difficulty != 0 and random.next_int_below(1000) == 0 {
            let keys = parrot_mimics()
            sound = keys[usize.wrap(random.next_int_below(i32.wrap(keys.len())))].copy()
        }
        if had {
            self.level_random = some(random)
        }
        return sound
    }

    // `Parrot.aiStep`'s start (CAL-201): where it was by a jukebox playing, which only clients
    // dance to, none of it kept; one in 400 by the level's random, it mimics the mobs near it,
    // `parrot_mimic`.
    fn parrot_ai_start(mut self, sounds: mut List<EntitySound>) {
        let lent = self.level_random.take()
        let had = lent != none
        if not had {
            self.living.show(Shown.Missing(String("A parrot's mimicry without its level's random")), sounds.len())
        }
        var random = lent ?? TapedRandom.new(0i64)
        if random.next_int_below(400) == 0 {
            _ = self.parrot_mimic(mut random, mut sounds)
        }
        if had {
            self.level_random = some(random)
        }
    }

    // `Parrot.imitateNearbyMobs` (CAL-201), drawing from the level's `random`: alive and not
    // silent, one in two, of the mobs whose boxes meet its own grown by 20 it may mimic,
    // `MOB_SOUND_MAP`'s, one drawn, whose sound, where it isn't silent, is heard from it 0.7 loud at
    // a pitch drawn. Whether it chose one.
    fn parrot_mimic(self, random: mut TapedRandom, sounds: mut List<EntitySound>) -> bool {
        if not self.living.alive() or self.living.silent() {
            return false
        }
        if random.next_int_below(2) != 0 {
            return false
        }
        let b = self.living.body.bounding_box()
        var mimicked = List<(String, bool)>()
        for near in self.parrot.mobs {
            let (_, species, _, _, _, _, bounds, _, silent) = near
            if not bounds.intersects(b.min_x - 20.0, b.min_y - 20.0, b.min_z - 20.0, b.max_x + 20.0, b.max_y + 20.0, b.max_z + 20.0) {
                continue
            }
            if let sound = parrot_mimic_of(species) {
                mimicked.push((sound, silent))
            }
        }
        if mimicked.is_empty() {
            return false
        }
        let (sound, silent) = mimicked[usize.wrap(random.next_int_below(i32.wrap(mimicked.len())))].copy()
        if not silent {
            let a = random.next_float()
            let c = random.next_float()
            self.living.play(mut sounds, sound, 0.7f32, (a - c) * 0.2f32 + 1.0f32)
        }
        return true
    }

    // `Parrot.calculateFlapping` (CAL-201), after the rest of its `aiStep`: its wings' speed up
    // 1.2 off the ground and riding nothing, else down 0.3, between 0 and 1; off the ground its
    // beat 1 where it was less, then nine tenths of it; and falling off the ground, slowed to six
    // tenths of its fall.
    fn parrot_flapping(mut self) {
        let up = not self.living.body.on_ground and self.living.body.vehicle == none
        let speed = self.living.flap_speed + (if up { 4.0f32 } else { -1.0f32 }) * 0.3f32
        self.living.flap_speed = if speed < 0.0f32 { 0.0f32 } else if speed > 1.0f32 { 1.0f32 } else { speed }
        if not self.living.body.on_ground and self.parrot.flapping < 1.0f32 {
            self.parrot.flapping = 1.0f32
        }
        self.parrot.flapping = self.parrot.flapping * 0.9f32
        if not self.living.body.on_ground and self.living.body.vy < 0.0 {
            self.living.body.vy = self.living.body.vy * 0.6
        }
    }

    // `Parrot.mobInteract` (CAL-201), alive, with `item` in hand, by the player of the UUID
    // `player`. Wild, `#parrot_food` used, its eating heard at a pitch drawn, and one in ten,
    // drawn, it's tamed, `parrot_tamed`, else entity event 6, smoke, after the sounds `heard`,
    // `SUCCESS`. Not `#parrot_poisonous_food`: tame, theirs and on the ground, `isFlying`, it's
    // ordered to sit or stand, `SUCCESS`; else none, an animal's use. Poisonous, used, poisoned
    // for 900 ticks and hurt to death by them, `poisoned`, `SUCCESS`.
    fn parrot_interact(mut self, lf: LivingFacts, item: String, player: (i64, i64), heard: usize) -> Interaction? {
        let sets = lf.tempting.of(item.copy())
        if not self.is_tame() and sets & TEMPT_PARROT != 0u32 {
            var out = Interaction { result: INTERACT_SUCCESS, used: true }
            if not self.living.silent() {
                let a = self.living.body.random.next_float()
                let b = self.living.body.random.next_float()
                self.living.play(mut out.sounds, String("entity.parrot.eat"), 1.0f32, 1.0f32 + (a - b) * 0.2f32)
            }
            // Its event after its eating's heard, as the interaction's sounds come after those
            // `heard` before it.
            let after = heard + out.sounds.len()
            if self.living.body.random.next_int_below(10) == 0 {
                self.parrot_tamed(player, after)
            } else {
                self.living.show(Shown.Event(6i8), after)
            }
            return some(out)
        }
        if sets & TEMPT_PARROT_POISON == 0u32 {
            if self.living.body.on_ground and self.is_tame() and self.living.data.uuid(OWN + 1) == some(player) {
                self.wolf.sitting = not self.wolf.sitting
                return some(Interaction { result: INTERACT_SUCCESS, used: false })
            }
            return none
        }
        var unheard = List<EntitySound>()
        _ = self.add_effect(lf, ActiveEffect.new(POISON, 900, 0), mut unheard)
        return some(Interaction { result: INTERACT_SUCCESS, used: true, sounds: unheard, poisoned: true })
    }

    // A parrot's taming by the player of the UUID `owner` (CAL-201), its food's one in ten: tame,
    // `setTame(true, true)`; theirs, `setOwner`, shown, which triggers their `TAME_ANIMAL`; and
    // entity event 7 after the sounds `heard`. It isn't ordered to sit.
    fn parrot_tamed(mut self, owner: (i64, i64), heard: usize) {
        self.living.data.set_flag(OWN, 4, true)
        let (most, least) = owner
        self.living.data.set(OWN + 1, Value.Uuid(most, least))
        self.living.show(Shown.Tamed(owner), heard)
        self.living.show(Shown.Event(7i8), heard)
    }

    /// Its owner the player of the UUID `owner`, a tame animal's `setOwner` (CAL-201).
    pub fn owned_by(mut self, owner: (i64, i64)) {
        if self.tamable() {
            let (most, least) = owner
            self.living.data.set(OWN + 1, Value.Uuid(most, least))
        }
    }

    /// Its variant, a parrot's, `Parrot.Variant` by its ID (CAL-201).
    pub fn parrot_variant(self) -> i32 {
        return if self.species == PARROT { self.living.data.number(OWN + 2) } else { -1 }
    }

    // `LandOnOwnersShoulderGoal` (CAL-201), whether it sat on its owner's shoulder `sat`: used
    // where its owner's a player in its level who isn't spectating, flying or in water, it isn't
    // ordered to sit and it's been more than 100 ticks since it last sat on one,
    // `canSitOnShoulder`, and going on so. As it starts, it hasn't sat. Each tick, where it hasn't,
    // isn't sitting nor leashed and its box meets its owner's, it sits on their shoulder,
    // `setEntityOnShoulder`, where they're riding nothing, on the ground, out of water, with a
    // shoulder free: saved, `shouldered`, and gone, `discard`, its level putting it on them.
    fn shoulder_goal(mut self, sat: mut bool, call: i32, players: List<Follower>, heard: usize) -> bool {
        let owner = self.owner_in(players)
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            let o = owner else return false
            if o.spectator or o.flying or o.in_water {
                return false
            }
            return not self.wolf.sitting and self.parrot.ride_cooldown > 100
        }
        if call == GOAL_START {
            sat = false
        } else if call == GOAL_TICK {
            let o = owner else return false
            if sat or self.in_sitting_pose() or self.leash != none {
                return false
            }
            let theirs = o.bounds else return false
            let b = self.living.body.bounding_box()
            if not b.intersects(theirs.min_x, theirs.min_y, theirs.min_z, theirs.max_x, theirs.max_y, theirs.max_z) {
                return false
            }
            if o.riding or not o.on_ground or o.in_water or not o.shoulder_free {
                return false
            }
            let uuid = o.uuid else return false
            var saved = self.saved()
            if let Tag.Compound(c) = saved {
                var t = c
                t.insert(String("id"), Tag.Str(String("minecraft:parrot")))
                saved = Tag.Compound(t)
            }
            let variant = self.parrot_variant()
            self.living.show(Shown.Shouldered((uuid, saved, variant)), heard)
            self.living.body.removed = true
            sat = true
        }
        return false
    }

    // `FollowMobGoal` (CAL-201): used where, of the other mobs whose boxes meet its own grown by
    // its area, not of its kind, `getClass`, one isn't invisible, the first such, which it
    // follows; going on while it does, its navigation's going and it's more than its stop off
    // them. As it starts, water's no cost to its paths, as it stops what it was, its path stopped.
    // Each tick, not leashed, looking at their eyes, 10 degrees a tick; once its count's out,
    // every 5 ticks, further than its stop, its path to them found again, else stopped, and within
    // its stop's distance, not squared, away from them as far across. Whether their look is on
    // its feet, the other way it backs off, is left out, as no mob looks there.
    fn follow_mob_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut FollowMob, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if let id = g.following {
            for near in self.parrot.mobs {
                let (nid, _, x, y, z, eyes, _, _, _) = near
                if nid == id {
                    g.x = x
                    g.y = y
                    g.z = z
                    g.eyes = eyes
                }
            }
        }
        if call == GOAL_CAN_USE {
            let b = self.living.body.bounding_box()
            let a = f64(g.area)
            for near in self.parrot.mobs {
                let (nid, species, x, y, z, eyes, bounds, invisible, _) = near
                if species == self.species or not bounds.intersects(b.min_x - a, b.min_y - a, b.min_z - a, b.max_x + a, b.max_y + a, b.max_z + a) {
                    continue
                }
                if not invisible {
                    g.following = some(nid)
                    g.x = x
                    g.y = y
                    g.z = z
                    g.eyes = eyes
                    return true
                }
            }
            return false
        }
        if call == GOAL_CONTINUE {
            return g.following != none and not self.navigation.is_done() and self.distance_sqr_to(g.x, g.y, g.z) > f64(g.stop * g.stop)
        }
        if call == GOAL_START {
            g.recalc = 0
            g.water = self.navigation.maluses[usize(PATH_WATER)]
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
        } else if call == GOAL_STOP {
            g.following = none
            self.navigation.stop()
            self.navigation.maluses[usize(PATH_WATER)] = g.water
        } else if call == GOAL_TICK {
            if g.following == none or self.leash != none {
                return false
            }
            self.look.set_look_at(g.x, g.y + f64(g.eyes), g.z, 10.0f32, self.max_head_x_rot())
            g.recalc -= 1
            if g.recalc <= 0 {
                g.recalc = reduced_tick_delay(10)
                let dx = self.living.body.x - g.x
                let dy = self.living.body.y - g.y
                let dz = self.living.body.z - g.z
                let dist = dx * dx + dy * dy + dz * dz
                if not (dist <= f64(g.stop * g.stop)) {
                    _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, g.x, g.y, g.z, g.speed)
                } else {
                    self.navigation.stop()
                    if dist <= f64(g.stop) {
                        let ax = g.x - self.living.body.x
                        let az = g.z - self.living.body.z
                        let (x, y, z) = (self.living.body.x - ax, self.living.body.y, self.living.body.z - az)
                        _ = self.move_to(lf, f, m, blocks, mut cache, min_y, x, y, z, g.speed)
                    }
                }
            }
        }
        return false
    }

    // `ParrotWanderGoal.getPosition` (CAL-201): in water, a place on land up to 15 across and 15
    // up or down; then, unless 1 in 1,000, drawn, a tree near it in its stead, `getTreePos`; else,
    // none found, the way it looks, `getViewVector(0)`, its pitch and its head's way as its tick
    // began, a place hovering over the ground, 8 across and 7 up or down within a right angle of
    // it, 1 to 3 up, `HoverRandomPos`, else one in the air or water, 8 across and 4 up or down, 2
    // down, `AirAndWaterRandomPos`.
    fn parrot_wander_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: Stroll, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        var at: (f64, f64, f64)? = none
        if self.living.body.in_water {
            at = self.random_place(true, 15, 15, lf, f, blocks, mut cache, min_y)
        }
        if self.living.body.random.next_float() >= g.probability {
            at = self.parrot_tree(lf, f, blocks)
        }
        if at != none {
            return at
        }
        let (lx, _, lz) = view_vector(self.living.body.x_rot, self.living.y_head_rot_o)
        let dir = (lx, lz)
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home }
        let costs = self.own_maluses()
        let right = f64(1.5707964f32)
        let hover = hover_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 8, 7, dir, right, 3, 1, self.species == PARROT)
        if let p = self.best_place(lf, f, blocks, hover) {
            return some(p)
        }
        let air = air_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 8, 4, -2, dir, right, false)
        return self.best_place(lf, f, blocks, air)
    }

    // `WaterAvoidingRandomFlyingGoal.getPosition` (CAL-401): a place up to 8 across and 7 up or
    // down it hovers over, within a right angle either side of the way it looks, 3 to 1 above the
    // ground, `HoverRandomPos.getPos`; else one in the air up to 8 across and 4 up or down, 2
    // below, `AirAndWaterRandomPos.getPos`.
    fn flying_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let (lx, _, lz) = view_vector(self.living.body.x_rot, self.living.y_head_rot_o)
        let dir = (lx, lz)
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home }
        let costs = self.own_maluses()
        let right = f64(1.5707964f32)
        let hover = hover_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 8, 7, dir, right, 3, 1, false)
        if let p = self.best_place(lf, f, blocks, hover) {
            return some(p)
        }
        let air = air_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 8, 4, -2, dir, right, false)
        return self.best_place(lf, f, blocks, air)
    }

    // `ParrotWanderGoal.getTreePos` (CAL-201): of the blocks from 3 across and 6 up or down of it,
    // in `BlockPos.betweenClosed`'s order, x then y then z, the first but its own that's air over
    // leaves or a log, `#logs`, with air above it, at its bottom's middle.
    fn parrot_tree<B: CollisionBlocks>(self, lf: LivingFacts, f: Facts, blocks: B) -> (f64, f64, f64)? {
        let here = self.block_position()
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        for bz in floor_of(z - 3.0)..floor_of(z + 3.0) + 1 {
            for by in floor_of(y - 6.0)..floor_of(y + 6.0) + 1 {
                for bx in floor_of(x - 3.0)..floor_of(x + 3.0) + 1 {
                    if (bx, by, bz) == here {
                        continue
                    }
                    let below = state_at(blocks, bx, by - 1, bz)
                    let perch = f.is_a(f.block(below), "LeavesBlock") or f.in_set(below, lf.logs)
                    if perch and f.is_air(state_at(blocks, bx, by, bz)) and f.is_air(state_at(blocks, bx, by + 1, bz)) {
                        return some((f64(bx) + 0.5, f64(by), f64(bz) + 0.5))
                    }
                }
            }
        }
        return none
    }

    /// Whether it's a turtle on its travels, `travelPos` set, whose stable places are water
    /// blocks, `TurtlePathNavigation.isStableDestination` (CAL-201).
    // `Turtle.ageBoundaryReached` of a turtle just grown (CAL-201): where mobs drop loot,
    // `DO_MOB_LOOT`, `gameplay/turtle_grow` rolled, `dropFromGiftLootTable`, each stack dropped
    // where it is, `spawnAtLocation`.
    fn turtle_grown(mut self, heard: usize) {
        if not self.turtle.grew {
            return
        }
        self.turtle.grew = false
        if self.mob_drops and not self.baby() {
            let laid = Laid { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, item: String(), table: String("minecraft:gameplay/turtle_grow") }
            self.living.show(Shown.Laid(laid), heard)
        }
    }

    /// Whether it's a bat at rest, `Bat.isResting`, its flags' first (CAL-201).
    pub fn bat_resting(self) -> bool {
        return self.species == BAT and i32(self.living.data.byte(MONSTER_OWN)) & 1 != 0
    }

    // `Bat.setResting` (CAL-201).
    fn set_bat_resting(mut self, resting: bool) {
        let flags = i32(self.living.data.byte(MONSTER_OWN))
        self.living.data.set(MONSTER_OWN, Value.Byte(i8.wrap(if resting { flags | 1 } else { flags & -2 })))
    }

    // `Bat.customServerAiStep` (CAL-201). At rest: under a redstone conductor, its head turned
    // 1 in 200, drawn, to a draw of 360, and woken where a player's within 4 of it and seen,
    // `forNonCombat`, its takeoff shown unless it's silent, level event 1025 at its block; under
    // anything else, woken and shown so at once. Flying: its place to go forgotten where that's no
    // longer air or is at the level's bottom; then a new one where it has none, 1 in 30, drawn,
    // or it's within 2 of its middle, 6 either way across, drawn, and from 2 down to 3 up; its
    // motion a tenth of the way to half a block a tick toward it across, 0.7 up or down, and
    // turned to the way it goes at once; and 1 in 100, drawn, under a redstone conductor, at rest.
    // What it goes forward by, `zza`, its move control sets to nothing after.
    fn bat_step<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, min_y: i32, sounds: List<EntitySound>) {
        let (x, y, z) = self.block_position()
        if self.bat_resting() {
            let silent = self.living.silent()
            if f.redstone_conductor(state_at(blocks, x, y + 1, z)) {
                if self.living.body.random.next_int_below(200) == 0 {
                    self.living.y_head_rot = f32.nearest(self.living.body.random.next_int_below(360))
                }
                let who = self.looker()
                if nearest_player(m, f, blocks, mut self.sensing, who, players, 4.0, self.living.body.y, true, 0u32) != none {
                    self.set_bat_resting(false)
                    if not silent {
                        self.living.show(Shown.Level((1025, x, y, z, 0)), sounds.len())
                    }
                }
            } else {
                self.set_bat_resting(false)
                if not silent {
                    self.living.show(Shown.Level((1025, x, y, z, 0)), sounds.len())
                }
            }
            return
        }
        if let (tx, ty, tz) = self.bat_target {
            if not f.is_air(state_at(blocks, tx, ty, tz)) or ty <= min_y {
                self.bat_target = none
            }
        }
        var renew = true
        if let (tx, ty, tz) = self.bat_target {
            let cx = f64(tx) + 0.5 - self.living.body.x
            let cy = f64(ty) + 0.5 - self.living.body.y
            let cz = f64(tz) + 0.5 - self.living.body.z
            renew = self.living.body.random.next_int_below(30) == 0 or cx * cx + cy * cy + cz * cz < 4.0
        }
        if renew {
            let x1 = self.living.body.random.next_int_below(7)
            let x2 = self.living.body.random.next_int_below(7)
            let up = self.living.body.random.next_int_below(6)
            let z1 = self.living.body.random.next_int_below(7)
            let z2 = self.living.body.random.next_int_below(7)
            let nx = i32.saturate((self.living.body.x + f64(x1) - f64(x2)).floor())
            let ny = i32.saturate((self.living.body.y + f64(up) - 2.0).floor())
            let nz = i32.saturate((self.living.body.z + f64(z1) - f64(z2)).floor())
            self.bat_target = some((nx, ny, nz))
        }
        let (tx, ty, tz) = self.bat_target ?? (x, y, z)
        let dx = f64(tx) + 0.5 - self.living.body.x
        let dy = f64(ty) + 0.1 - self.living.body.y
        let dz = f64(tz) + 0.5 - self.living.body.z
        let (vx, vy, vz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
        let nvx = vx + (signum(dx) * 0.5 - vx) * f64(0.1f32)
        let nvy = vy + (signum(dy) * f64(0.7f32) - vy) * f64(0.1f32)
        let nvz = vz + (signum(dz) * 0.5 - vz) * f64(0.1f32)
        self.living.body.vx = nvx
        self.living.body.vy = nvy
        self.living.body.vz = nvz
        let angle = table_atan2(nvz, nvx) ?? 0.0
        let wanted = f32.nearest(angle * RAD_TO_DEG) - 90.0f32
        let turn = self.living.body.y_rot
        self.living.body.y_rot = turn + wrap_degrees(wanted - turn)
        if self.living.body.random.next_int_below(100) == 0 and f.redstone_conductor(state_at(blocks, x, y + 1, z)) {
            self.set_bat_resting(true)
        }
    }

    // `Bat.tick`'s, after the rest (CAL-201): at rest, still, hanging with its top at its block's
    // top, `setPosRaw`; else its fall slowed to 0.6 of itself.
    fn bat_tick_end(mut self) {
        if self.bat_resting() {
            self.living.body.vx = 0.0
            self.living.body.vy = 0.0
            self.living.body.vz = 0.0
            self.living.body.y = self.living.body.y.floor() + 1.0 - f64(self.living.body.height)
        } else {
            self.living.body.vy = self.living.body.vy * 0.6
        }
    }

    pub fn turtle_travels(self) -> bool {
        return self.species == TURTLE and self.turtle.travel != none
    }

    // Whether its home's middle is nearer it than `dist`, `homePos.closerToCenterThan` (CAL-201).
    fn turtle_home_within(self, dist: f64) -> bool {
        let (hx, hy, hz) = self.turtle.home
        return self.distance_sqr_to(f64(hx) + 0.5, f64(hy) + 0.5, f64(hz) + 0.5) < dist * dist
    }

    // Whether it has an egg, `hasEgg`, and whether it's laying one, `isLayingEgg` (CAL-201).
    fn turtle_has_egg(self) -> bool {
        return self.living.data.flag(OWN)
    }

    fn turtle_laying(self) -> bool {
        return self.living.data.flag(OWN + 1)
    }

    // `setLayingEgg` (CAL-201): its count of ticks at it 1, else 0, and shown.
    fn set_turtle_laying(mut self, on: bool) {
        self.turtle.lay_counter = if on { 1 } else { 0 }
        self.living.data.set(OWN + 1, Value.Bool(on))
    }

    // `Turtle.aiStep`'s, after the rest (CAL-201): alive and laying an egg, each 5th of its ticks
    // at it, where it's on sand, `TurtleEggBlock.onSand`, its digging shown, the block under it
    // breaking, 2001, after the sounds `heard`. Its game event comes with game events.
    fn turtle_digging<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, heard: usize) {
        if not self.living.alive() or not self.turtle_laying() {
            return
        }
        let n = self.turtle.lay_counter
        if n < 1 or n % 5 != 0 {
            return
        }
        let (x, y, z) = self.block_position()
        let below = state_at(blocks, x, y - 1, z)
        if f.in_set(below, lf.sand) {
            self.living.show(Shown.Level((2001, x, y, z, i32.wrap(below))), heard)
        }
    }

    // `Mob.setSpeed`: its speed, and forward as fast, `setZza` (CAL-201).
    fn turtle_speed(mut self, speed: f32) {
        self.living.speed = speed
        self.living.zza = speed
    }

    // `TurtleMoveControl.tick` (CAL-201): first `updateSpeed`: in water, up 0.005, more than 16
    // from home its speed halved, 0.08 at least, then a baby's a third, 0.06 at least; else on the
    // ground halved, 0.06 at least. Then, moving to where it's wanted with its navigation not
    // done: there already, stopped; else turned toward there, 90 degrees a tick at most, its body
    // with it, its speed eased an eighth of the way to its own and up or down a tenth of it along
    // the way there. Else stopped.
    fn turtle_moves(mut self, w: Walker) {
        if self.living.body.in_water {
            self.living.body.vy = self.living.body.vy + 0.005
            if not self.turtle_home_within(16.0) {
                let halved = (self.living.speed / 2.0f32).max(0.08f32)
                self.turtle_speed(halved)
            }
            if self.baby() {
                let third = (self.living.speed / 3.0f32).max(0.06f32)
                self.turtle_speed(third)
            }
        } else if self.living.body.on_ground {
            let halved = (self.living.speed / 2.0f32).max(0.06f32)
            self.turtle_speed(halved)
        }
        if self.moves.operation != MOVE_TO or self.navigation.is_done() {
            self.turtle_speed(0.0f32)
            return
        }
        let xd = self.moves.wanted_x - self.living.body.x
        let yd = self.moves.wanted_y - self.living.body.y
        let zd = self.moves.wanted_z - self.living.body.z
        let dd = (xd * xd + yd * yd + zd * zd).sqrt()
        if dd < f64(1.0e-5f32) {
            self.turtle_speed(0.0f32)
            return
        }
        let along = yd / dd
        let angle = table_atan2(zd, xd) ?? 0.0
        let wanted_rot = f32.nearest(angle * RAD_TO_DEG) - 90.0f32
        self.living.body.y_rot = rotlerp(self.living.body.y_rot, wanted_rot, 90.0f32)
        self.living.y_body_rot = self.living.body.y_rot
        let target_speed = f32.nearest(self.moves.speed_modifier * w.movement_speed)
        let eased = self.living.speed + 0.125f32 * (target_speed - self.living.speed)
        self.turtle_speed(eased)
        self.living.body.vy = self.living.body.vy + f64(self.living.speed) * along * 0.1
    }

    // `TurtleBreedGoal.breed` (CAL-201): no baby, but an egg, `setHasEgg`; 6000 ticks from
    // breeding again and out of love, and, where mob drops are on, an orb worth 1 to 7 drawn from
    // its random; what its level does of it, `Bred`, its partner the same, shown after the sounds
    // `heard`. Its love's cause gets `ANIMALS_BRED` and `BRED_ANIMALS` of no child.
    fn turtle_bred(mut self, k: Kin, heard: usize) {
        self.living.data.set(OWN, Value.Bool(true))
        self.set_age(6000)
        self.in_love = 0
        var orb = 0
        if self.mob_drops {
            orb = self.living.body.random.next_int_below(7) + 1
        }
        let (x, y, z, kind) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.kind)
        self.living.show(Shown.Bred(Bred { partner: k.id, species: TURTLE, kind: kind, variant: -1, partner_variant: -1, x: x, y: y, z: z, orb: orb }), heard)
    }

    // A turtle's goals (CAL-201), by their kind, `g.kind`:
    // - `TurtleLayEggGoal`, a `MoveToBlockGoal` within 16 at 1, every tick: used with an egg
    //   within 9 of home, to sand with air above it; going on so. Each tick, once there out of
    //   water, laying, `setLayingEgg`, and past 200 ticks of it, heard, `entity.turtle.lay_egg`
    //   pitched by the level's random, 1 to 4 eggs, drawn, set on the sand, its egg gone, not
    //   laying, and in love for 600 ticks, `setInLoveTime`; then a tick more while it lays.
    // - `TurtleGoToWaterGoal`, a `MoveToBlockGoal` within 24 at 1, every tick, its search a layer
    //   two down only, `verticalSearchStart` -1: a baby's out of water, else one's out of water not
    //   going home and with no egg, to a water block; going on out of water for 1200 tries while
    //   it's water, its path found again each 160th. Its baby speed of 2 is read as the goal's
    //   made, before it's ever a baby, so it's 1.
    // - `TurtleGoHomeGoal`, taking no controls: a grown one's with an egg, or one in 700 halved,
    //   drawn, more than 64 from home; going on more than 7 from home, not stuck, for 300 ticks
    //   within 16 of it. As it starts, going home; as it stops, not. Each tick, its navigation
    //   done, on its way toward home, `DefaultRandomPos.getPosTowards` 16 across and 3 up or down
    //   within a tenth of a half turn, else 8 and 7 within a right angle, else, far from home
    //   short of water, 16 and 5 within a right angle; stuck where there's none.
    // - `TurtleTravelGoal`, taking no controls: one's in water not going home and with no egg,
    //   its travel drawn as it starts, up to 512 across and 4 up or down, kept under the sea's
    //   level; each tick, its navigation done, on its way toward there as it goes home, 16 and 3,
    //   else 8 and 7, where the chunks 34 about the place are loaded; stuck where there's none.
    //   Going on while its navigation goes, not stuck, going home, in love or with an egg; as it
    //   stops, no travel.
    fn turtle_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut TurtleGoal, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if g.kind == TURTLE_LAY_EGG or g.kind == TURTLE_TO_WATER {
            return self.turtle_block_goal(mut g, call, lf, f, m, blocks, mut cache, min_y, mut sounds)
        }
        if g.kind == TURTLE_GO_HOME {
            if call == GOAL_CAN_USE {
                if self.baby() {
                    return false
                }
                if self.turtle_has_egg() {
                    return true
                }
                if self.living.body.random.next_int_below(reduced_tick_delay(700)) != 0 {
                    return false
                }
                return not self.turtle_home_within(64.0)
            }
            if call == GOAL_CONTINUE {
                return not self.turtle_home_within(7.0) and not g.stuck and g.near_home <= reduced_tick_delay(600)
            }
            if call == GOAL_START {
                self.turtle.going_home = true
                g.stuck = false
                g.near_home = 0
            } else if call == GOAL_STOP {
                self.turtle.going_home = false
            } else if call == GOAL_TICK {
                let near = self.turtle_home_within(16.0)
                if near {
                    g.near_home += 1
                }
                if self.navigation.is_done() {
                    let (hx, hy, hz) = self.turtle.home
                    let (tx, ty, tz) = (f64(hx) + 0.5, f64(hy), f64(hz) + 0.5)
                    var next = self.turtle_towards(16, 3, tx, tz, f64(0.31415927f32), lf, f, blocks, mut cache, min_y)
                    if next == none {
                        next = self.turtle_towards(8, 7, tx, tz, f64(1.5707964f32), lf, f, blocks, mut cache, min_y)
                    }
                    if let (nx, ny, nz) = next {
                        if not near and f.block(state_at(blocks, floor_of(nx), floor_of(ny), floor_of(nz))) != lf.water_block {
                            next = self.turtle_towards(16, 5, tx, tz, f64(1.5707964f32), lf, f, blocks, mut cache, min_y)
                        }
                    }
                    _ = ty
                    let (px, py, pz) = next else {
                        g.stuck = true
                        return false
                    }
                    _ = self.move_to(lf, f, m, blocks, mut cache, min_y, px, py, pz, g.speed)
                }
            }
            return false
        }
        if call == GOAL_CAN_USE {
            return not self.turtle.going_home and not self.turtle_has_egg() and self.living.body.in_water
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done() and not g.stuck and not self.turtle.going_home and self.in_love <= 0 and not self.turtle_has_egg()
        }
        if call == GOAL_START {
            let xt = self.living.body.random.next_int_below(1025) - 512
            var yt = self.living.body.random.next_int_below(9) - 4
            let zt = self.living.body.random.next_int_below(1025) - 512
            if f64(yt) + self.living.body.y > f64(blocks.sea_level() - 1) {
                yt = 0
            }
            self.turtle.travel = some((floor_of(f64(xt) + self.living.body.x), floor_of(f64(yt) + self.living.body.y), floor_of(f64(zt) + self.living.body.z)))
            g.stuck = false
        } else if call == GOAL_STOP {
            self.turtle.travel = none
        } else if call == GOAL_TICK {
            let (vx, _, vz) = self.turtle.travel else {
                g.stuck = true
                return false
            }
            if self.navigation.is_done() {
                let (tx, tz) = (f64(vx) + 0.5, f64(vz) + 0.5)
                var next = self.turtle_towards(16, 3, tx, tz, f64(0.31415927f32), lf, f, blocks, mut cache, min_y)
                if next == none {
                    next = self.turtle_towards(8, 7, tx, tz, f64(1.5707964f32), lf, f, blocks, mut cache, min_y)
                }
                if let (nx, _, nz) = next {
                    let (xc, zc) = (floor_of(nx), floor_of(nz))
                    if not chunks_loaded(blocks, xc - 34, zc - 34, xc + 34, zc + 34) {
                        next = none
                    }
                }
                let (px, py, pz) = next else {
                    g.stuck = true
                    return false
                }
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, px, py, pz, g.speed)
            }
        }
        return false
    }

    // `DefaultRandomPos.getPosTowards` of a turtle, toward `tx`, `tz` across, up to `h` across
    // and `v` up or down within `angle` either side, of the 10 places tried, as `best_place` picks
    // (CAL-201).
    fn turtle_towards<B: CollisionBlocks + MobLight + NavLevel>(mut self, h: i32, v: i32, tx: f64, tz: f64, angle: f64, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
        let costs = self.own_maluses()
        let dir = (tx - self.living.body.x, tz - self.living.body.z)
        let tries = towards_tries_within(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, h, v, dir, angle)
        return self.best_place(lf, f, blocks, tries)
    }

    // A turtle's `MoveToBlockGoal`s, `TurtleLayEggGoal` and `TurtleGoToWaterGoal` (CAL-201), as
    // `turtle_goal` has them.
    fn turtle_block_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut TurtleGoal, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let lay = g.kind == TURTLE_LAY_EGG
        if call == GOAL_CAN_USE {
            let usable = if lay {
                self.turtle_has_egg() and self.turtle_home_within(9.0)
            } else if self.baby() and not self.living.body.in_water {
                true
            } else {
                not self.turtle.going_home and not self.living.body.in_water and not self.turtle_has_egg()
            }
            if not usable {
                return false
            }
            if g.next_start > 0 {
                g.next_start -= 1
                return false
            }
            g.next_start = reduced_tick_delay(200 + self.living.body.random.next_int_below(200))
            return self.turtle_find_block(mut g, lf, f, blocks)
        }
        if call == GOAL_CONTINUE {
            if lay {
                return g.try_ticks >= -g.max_stay and g.try_ticks <= 1200 and turtle_block_at(lay, lf, f, blocks, g.x, g.y, g.z) and self.turtle_has_egg() and self.turtle_home_within(9.0)
            }
            return not self.living.body.in_water and g.try_ticks <= 1200 and turtle_block_at(lay, lf, f, blocks, g.x, g.y, g.z)
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, g.speed)
            g.try_ticks = 0
            let bound = self.living.body.random.next_int_below(1200) + 1200
            g.max_stay = self.living.body.random.next_int_below(bound) + 1200
        } else if call == GOAL_TICK {
            let (tx, ty, tz) = (g.x, g.y + 1, g.z)
            if not (self.distance_sqr_to(f64(tx) + 0.5, f64(ty) + 0.5, f64(tz) + 0.5) < 1.0) {
                g.reached = false
                g.try_ticks += 1
                let every = if lay { 40 } else { 160 }
                if g.try_ticks % every == 0 {
                    _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(tx) + 0.5, f64(ty), f64(tz) + 0.5, g.speed)
                }
            } else {
                g.reached = true
                g.try_ticks -= 1
            }
            if lay and not self.living.body.in_water and g.reached {
                if self.turtle.lay_counter < 1 {
                    self.set_turtle_laying(true)
                } else if self.turtle.lay_counter > 200 {
                    let (bx, by, bz) = self.block_position()
                    var pitch = 0.9f32
                    if let lent = self.level_random.take() {
                        var random = lent
                        pitch = 0.9f32 + random.next_float() * 0.2f32
                        self.level_random = some(random)
                    }
                    sounds.push(EntitySound { sound: String("entity.turtle.lay_egg"), x: f64(bx) + 0.5, y: f64(by) + 0.5, z: f64(bz) + 0.5, volume: 0.3f32, pitch: pitch, source: BLOCKS_SOURCE })
                    let eggs = self.living.body.random.next_int_below(4) + 1
                    if let egg = f.block_named(String("minecraft:turtle_egg")) {
                        match f.with_int(f.default_state(egg), String("eggs"), eggs) {
                            ok(state) => self.living.show(Shown.Planted((g.x, g.y + 1, g.z, state)), sounds.len()),
                            err(_) => {},
                        }
                    }
                    self.living.data.set(OWN, Value.Bool(false))
                    self.set_turtle_laying(false)
                    self.in_love = 600
                }
                if self.turtle_laying() {
                    self.turtle.lay_counter += 1
                }
            }
        }
        return false
    }

    // `MoveToBlockGoal.findNearestBlock` for a turtle's (CAL-201): the blocks about its block, a
    // block down, by rings out to its range, each layer from its first, 0 to lay, -1 for water, up
    // to 1, then down, as `find_beach` goes; the first within its home and one it wants kept.
    fn turtle_find_block<B: CollisionBlocks>(self, g: mut TurtleGoal, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let lay = g.kind == TURTLE_LAY_EGG
        let (mx, my, mz) = self.block_position()
        var y = if lay { 0 } else { -1 }
        while y <= 1 {
            for r in 0..g.range {
                var x = 0
                while x <= r {
                    var z = if x < r and x > -r { r } else { 0 }
                    while z <= r {
                        let (px, py, pz) = (mx + x, my + y - 1, mz + z)
                        if self.within_home(f64(px), f64(py), f64(pz)) and turtle_block_at(lay, lf, f, blocks, px, py, pz) {
                            g.x = px
                            g.y = py
                            g.z = pz
                            return true
                        }
                        z = if z > 0 { -z } else { 1 - z }
                    }
                    x = if x > 0 { -x } else { 1 - x }
                }
            }
            y = if y > 0 { -y } else { 1 - y }
        }
        return false
    }

    // `PolarBear.setStanding`, `DATA_STANDING_ID` (CAL-201).
    fn set_standing(mut self, standing: bool) {
        self.living.data.set(OWN, Value.Bool(standing))
    }

    // `Wolf.getAmbientSound` (CAL-201), of its sound variant's sounds, a baby's where it's one:
    // angry, its growl; else 1 in 3, drawn, its whine where it's tame and its health under 20, else
    // its pant; else its ambient sound.
    fn wolf_ambient(mut self) -> String {
        let set = self.variant_sounds()
        if self.angry() {
            return set.growl
        }
        if self.living.body.random.next_int_below(3) == 0 {
            return if self.is_tame() and self.living.health() < 20.0f32 { set.whine } else { set.pant }
        }
        return set.ambient
    }

    // Its sound variant's sounds, a baby's where it's one, `getSoundSet` (CAL-201).
    fn variant_sounds(self) -> SoundSet {
        if let s = self.sounds {
            return s.set_of(self.sound_variant, self.baby())
        }
        return SoundSet { ambient: String(), step: String(), hurt: String(), death: String() }
    }

    /// Whether its kind's a `TamableAnimal`: a wolf, a cat or a parrot (CAL-201).
    pub fn tamable(self) -> bool {
        return self.species == WOLF or self.species == CAT or self.species == PARROT
    }

    /// Whether it sits, a tame animal's `isInSittingPose`, its flags' 1 (CAL-201).
    pub fn in_sitting_pose(self) -> bool {
        return self.tamable() and i32(self.living.data.byte(OWN)) & 1 != 0
    }

    /// Its collar's colour, a wolf's or a cat's, by its ID, -1 for another kind (CAL-201).
    pub fn collar_color(self) -> i32 {
        return if self.species == WOLF { self.living.data.number(OWN + 3) } else if self.species == CAT { self.living.data.number(OWN + 5) } else { -1 }
    }

    // Its collar's colour set, by its ID, a wolf's or a cat's (CAL-201).
    fn set_collar(mut self, color: i32) {
        self.living.data.set(if self.species == CAT { OWN + 5 } else { OWN + 3 }, Value.Number(color))
    }

    /// Its owner's UUID, a tame animal's, `getOwnerReference` (CAL-201).
    pub fn tame_owner(self) -> (i64, i64)? {
        return if self.is_tame() { self.living.data.uuid(OWN + 1) } else { none }
    }

    /// Who owns it, `OwnableEntity.getOwnerReference` (CAL-165): a tame animal's owner, whether
    /// it's tame or not; a horse's, `Owner`; and a vex's, its evoker.
    pub fn owner_reference(self) -> (i64, i64)? {
        if self.tamable() {
            return self.living.data.uuid(OWN + 1)
        }
        if self.equine() {
            return uuid_of(self.kept, "Owner")
        }
        if self.species == VEX {
            return self.vex_owner
        }
        return none
    }

    /// Its target as `getTarget` reads it, by ID, and whether that's checked, `asValidTarget`
    /// (CAL-165): a piglin's, a brute's, a hoglin's or a zoglin's brain's attack target, as theirs
    /// is `getTargetFromBrain`, not checked; else its own, `target`.
    pub fn target_read(self) -> (i32, bool)? {
        if self.species == PIGLIN or self.species == PIGLIN_BRUTE or self.species == HOGLIN or self.species == ZOGLIN {
            let id = self.brain_target() else return none
            return some((id, false))
        }
        let id = self.target else return none
        return some((id, true))
    }

    /// Whether it's tame, `TamableAnimal.isTame`, its flags' 4 (CAL-201).
    pub fn is_tame(self) -> bool {
        return self.tamable() and i32(self.living.data.byte(OWN)) & 4 != 0
    }

    // `Wolf.aiStep`'s, after an animal's (CAL-201): wet, not shaking, not finding a path and on
    // the ground, it starts to shake, shown, entity event 8; then its anger kept up,
    // `updatePersistentAnger`, staying angry while it has a target.
    fn wolf_step(mut self, players: List<Follower>, heard: usize) {
        if self.wolf.wet and not self.wolf.shaking and self.navigation.is_done() and self.living.body.on_ground {
            self.wolf.shaking = true
            self.wolf.shake = 0.0f32
            self.wolf.shake_o = 0.0f32
            self.living.show(Shown.Event(8i8), heard)
        }
        self.update_anger(players, true)
    }

    // `Wolf.tick`'s, after the rest (CAL-201), alive: in water or the rain, `isInWaterOrRain`,
    // it's wet, and where it was shaking it stops, shown, entity event 56; else shaking, its shake
    // heard as it begins, at 0.4 and a pitch drawn, 0.05 further each tick and done once it was 2
    // through; past 0.4, its splashes, which only clients show, each drawn for across, two draws.
    // Its game event comes with game events.
    fn wolf_tick<B: Rain>(mut self, blocks: B, sounds: mut List<EntitySound>) {
        if not self.living.alive() {
            return
        }
        if self.living.body.in_water or self.living.body.in_rain(blocks) {
            self.wolf.wet = true
            if self.wolf.shaking {
                self.living.show(Shown.Event(56i8), sounds.len())
                self.wolf.shaking = false
                self.wolf.shake = 0.0f32
                self.wolf.shake_o = 0.0f32
            }
            return
        }
        if not self.wolf.shaking {
            return
        }
        if self.wolf.shake == 0.0f32 {
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, String("entity.wolf.shake"), self.sound_volume, (a - b) * 0.2f32 + 1.0f32)
        }
        self.wolf.shake_o = self.wolf.shake
        self.wolf.shake += 0.05f32
        if self.wolf.shake_o >= 2.0f32 {
            self.wolf.wet = false
            self.wolf.shaking = false
            self.wolf.shake_o = 0.0f32
            self.wolf.shake = 0.0f32
        }
        if self.wolf.shake > 0.4f32 {
            let count = i32.saturate(f64(table_sin(f64((self.wolf.shake - 0.4f32) * 3.1415927f32)) * 7.0f32))
            for _ in 0..count {
                _ = self.living.body.random.next_float()
                _ = self.living.body.random.next_float()
            }
        }
    }

    // Its owner, `getOwner`, a tame animal's, among `players` by the UUID it holds, where they're
    // in its level (CAL-201).
    pub fn owner_in(self, players: List<Follower>) -> Follower? {
        if not self.tamable() {
            return none
        }
        let o = self.living.data.uuid(OWN + 1) else return none
        for p in players {
            if not p.mob and p.uuid == some(o) {
                return some(p.copy())
            }
        }
        return none
    }

    // A tame wolf's `OwnerHurtByTargetGoal`, where `g.by`, else its `OwnerHurtTargetGoal`
    // (CAL-201), target goals that needn't see: used where it's tame and not ordered to sit, its
    // owner's in its level and, for the first, something hurt them in the last 100 game ticks not
    // of `#no_wolf_retaliation`; then who last hurt them, or what they last hurt, at a tick of
    // theirs other than the one it last took one up at, where it may attack them, `canAttack` of
    // `TargetingConditions.DEFAULT`, seen, and wants to, `wolf_wants`. As it starts, they're its
    // target, their tick kept, and its unseen ticks none; going on as a target goal does.
    fn owner_hurt_goal<B: CollisionBlocks>(mut self, g: mut OwnerHurt, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            if not self.is_tame() or self.wolf.sitting {
                return false
            }
            let o = self.owner_in(players) else return false
            if g.by and not o.retaliated {
                return false
            }
            g.chosen = if g.by { o.hurt_by } else { o.hurt_mob }
            let stamp = if g.by { o.hurt_by_stamp } else { o.hurt_mob_stamp }
            let id = g.chosen else return false
            if stamp == g.timestamp {
                return false
            }
            let who = self.followed(players, id) else return false
            if who.id == self.living.body.id or who.spectator or who.dead or not who.enemy or who.uuid == o.uuid or not self.within_home(who.x, who.y, who.z) {
                return false
            }
            let me = self.looker()
            if not sees_player(m, f, blocks, mut self.sensing, me, who) {
                return false
            }
            return wolf_wants(who, o)
        }
        if call == GOAL_CONTINUE {
            return self.targeting_continues(mut g.targeting, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            self.set_target(g.chosen, players)
            if let o = self.owner_in(players) {
                g.timestamp = if g.by { o.hurt_by_stamp } else { o.hurt_mob_stamp }
            }
            g.targeting.target_mob = self.target
            g.targeting.unseen_ticks = 0
        } else if call == GOAL_STOP {
            self.target_to(none)
            g.targeting.target_mob = none
        }
        return false
    }

    // `unableToMoveToOwner` (CAL-201): ordered to sit, riding, leashed or about to be, or its owner
    // `o`, where it has one there, spectating.
    fn unable_to_move_to_owner(self, o: Follower?) -> bool {
        if self.wolf.sitting or self.living.body.vehicle != none or self.leash != none {
            return true
        }
        if let p = o {
            return p.spectator
        }
        return false
    }

    // A tame wolf's `SitWhenOrderedToGoal` (CAL-201): used where it's ordered to sit or tame, out of
    // water and on the ground, and, its owner there, ordered to sit, but not where they're within
    // 12 and a mob hurt them lately, `getLastHurtByMob`; with no owner there, always. Going on while
    // it's ordered to sit; as it starts, its path stopped and it sits, shown, `setInSittingPose`,
    // and as it stops it stands.
    fn sit_goal(mut self, call: i32, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            let ordered = self.wolf.sitting
            if not ordered and not self.is_tame() {
                return false
            }
            if self.living.body.in_water or not self.living.body.on_ground {
                return false
            }
            let o = self.owner_in(players) else return true
            if self.distance_sqr_to(o.x, o.y, o.z) < 144.0 and o.attacked {
                return false
            }
            return ordered
        }
        if call == GOAL_CONTINUE {
            return self.wolf.sitting
        }
        if call == GOAL_START {
            self.navigation.stop()
            self.living.data.set_flag(OWN, 1, true)
        } else if call == GOAL_STOP {
            self.living.data.set_flag(OWN, 1, false)
        }
        return false
    }

    // A tame animal's `FollowOwnerGoal` at 1, from `g.start` blocks to `g.stop`, a wolf's 10 and 2,
    // a cat's 10 and 5 (CAL-201): used where its owner's there, it isn't unable to go to them and
    // they're `g.start` or more off; going on while its navigation's going, it isn't unable and
    // they're more than `g.stop` off. As it starts, water's no
    // cost to its paths, as it stops what it was, its path stopped. Each tick, where they're within
    // 12, looking at their eyes, 10 degrees a tick; once its count's out, every 5 ticks, 12 or more
    // off it teleports to them, else finds its path to them again.
    fn follow_owner_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut FollowOwner, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        let owner = self.owner_in(players)
        if call == GOAL_CAN_USE {
            let o = owner else return false
            if self.unable_to_move_to_owner(owner) {
                return false
            }
            return not (self.distance_sqr_to(o.x, o.y, o.z) < f64(g.start * g.start))
        }
        if call == GOAL_CONTINUE {
            if self.navigation.is_done() {
                return false
            }
            let o = owner else return false
            if self.unable_to_move_to_owner(owner) {
                return false
            }
            return not (self.distance_sqr_to(o.x, o.y, o.z) <= f64(g.stop * g.stop))
        }
        if call == GOAL_START {
            g.recalc = 0
            g.water = self.navigation.maluses[usize(PATH_WATER)]
            self.navigation.maluses[usize(PATH_WATER)] = 0.0f32
        } else if call == GOAL_STOP {
            self.navigation.stop()
            self.navigation.maluses[usize(PATH_WATER)] = g.water
        } else if call == GOAL_TICK {
            let o = owner else return false
            let far = self.distance_sqr_to(o.x, o.y, o.z) >= 144.0
            if not far {
                self.look.set_look_at(o.x, o.y + f64(o.eyes), o.z, 10.0f32, self.max_head_x_rot())
            }
            g.recalc -= 1
            if g.recalc <= 0 {
                g.recalc = reduced_tick_delay(10)
                if far {
                    self.teleport_to_owner(o, lf, f, m, blocks, mut cache, min_y)
                } else {
                    _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, o.x, o.y, o.z, 1.0)
                }
            }
        }
        return false
    }

    // `tryToTeleportToOwner` to its owner `o`, `teleportToAroundBlockPos` (CAL-201): of 10 tries, a
    // block up to 3 off their own across each way, drawn, at least 2 off one way, then up to 1 up
    // or down, drawn; the first walkable, `getPathTypeStatic`, not over leaves and with room for
    // its box moved there, `noCollision`, it's put in the middle of, its path stopped.
    fn teleport_to_owner<B: CollisionBlocks>(mut self, o: Follower, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) {
        let (tx, ty, tz) = (floor_of(o.x), floor_of(o.y), floor_of(o.z))
        for _ in 0..10 {
            let xd = self.living.body.random.next_int_between(-3, 3)
            let zd = self.living.body.random.next_int_between(-3, 3)
            if xd.abs() < 2 and zd.abs() < 2 {
                continue
            }
            let yd = self.living.body.random.next_int_between(-1, 1)
            let (x, y, z) = (tx + xd, ty + yd, tz + zd)
            if lf.paths.at(blocks, mut cache, min_y, x, y, z) != PATH_WALKABLE {
                continue
            }
            if f.is_a(f.block(state_at(blocks, x, y - 1, z)), "LeavesBlock") {
                continue
            }
            let (bx, by, bz) = self.block_position()
            let b = self.living.body.bounding_box()
            let (dx, dy, dz) = (f64(x - bx), f64(y - by), f64(z - bz))
            let moved = Aabb { min_x: b.min_x + dx, min_y: b.min_y + dy, min_z: b.min_z + dz, max_x: b.max_x + dx, max_y: b.max_y + dy, max_z: b.max_z + dz }
            if not m.colliders(f, blocks, moved, Mover { y: b.min_y + dy, fall: 0.0 }).is_empty() {
                continue
            }
            let (yr, xr) = (self.living.body.y_rot, self.living.body.x_rot)
            self.living.snap_to(f64(x) + 0.5, f64(y), f64(z) + 0.5, yr, xr)
            self.navigation.stop()
            return
        }
    }

    /// A wolf baby of tame parents, `Wolf.getBreedOffspring` (CAL-201): its owner theirs, of the
    /// UUID `owner`, tame, `setTame(true, true)`, its most health 40 and its health with it, and
    /// its collar `collar`.
    pub fn wolf_born_tame(mut self, owner: (i64, i64), collar: i32) {
        let (most, least) = owner
        self.living.data.set(OWN + 1, Value.Uuid(most, least))
        let flags = i32(self.living.data.byte(OWN))
        self.living.data.set(OWN, Value.Byte(i8.wrap(flags | 4)))
        self.set_base("minecraft:max_health", 40.0)
        self.living.data.set(HEALTH, Value.Float(40.0f32))
        self.living.data.set(OWN + 3, Value.Number(collar))
    }

    // A wolf's taming by the player of the UUID `owner` (CAL-201), a bone's one in three: tame,
    // `setTame(true, true)`, its most health 40 and its health with it; theirs, `setOwner`, shown;
    // its path stopped, no target, ordered to sit, and entity event 7 after the sounds `heard`; and
    // their `TAME_ANIMAL` triggered, which its level does.
    fn wolf_tamed(mut self, owner: (i64, i64), heard: usize) {
        let flags = i32(self.living.data.byte(OWN))
        self.living.data.set(OWN, Value.Byte(i8.wrap(flags | 4)))
        self.set_base("minecraft:max_health", 40.0)
        self.living.data.set(HEALTH, Value.Float(40.0f32))
        let (most, least) = owner
        self.living.data.set(OWN + 1, Value.Uuid(most, least))
        self.living.show(Shown.Tamed(owner), heard)
        self.navigation.stop()
        self.target_to(none)
        self.wolf.sitting = true
        self.living.show(Shown.Event(7i8), heard)
    }

    // `Wolf.mobInteract` (CAL-201), alive, with `item` in hand, `food` the nutrition of what's held
    // where it's food, by the player of the UUID `player`. Tame: its food, where it's hurt, fed,
    // healing it twice the nutrition, 2 for none, `feed`, `SUCCESS`; a dye other than its collar's
    // by its owner, its collar that color, `SUCCESS`; else, by its owner, wolf armor put on a
    // grown one without any, `setItemSlotAndDropWhenKilled`, which its level does, `body_armor`,
    // `SUCCESS`; or, sitting, its armor damaged, an armadillo scute, its repair's, used up even in
    // creative mode, `shrink`, heard, an eighth of its most durability mended, which its level
    // does, `armor_repair`, `SUCCESS`. Wild and not angry, a bone used, one in three, drawn, taming it, `wolf_tamed`, else entity event 6, smoke,
    // `SUCCESS_SERVER`. None for the rest, an animal's use, after which its owner's use that does
    // nothing orders it to sit or stand, `wolf_sit_toggle`.
    fn wolf_interact(mut self, lf: LivingFacts, item: String, food: i32?, player: (i64, i64), heard: usize) -> Interaction? {
        if self.is_tame() {
            let owned = self.living.data.uuid(OWN + 1) == some(player)
            let fed = lf.tempting.of(item.copy()) & TEMPT_WOLF_FOOD != 0u32
            if fed and self.living.health() < f32.nearest(self.living.attributes.value(attribute("max_health"))) {
                let amount = if let n = food { 2.0f32 * f32.nearest(n) } else { 2.0f32 }
                self.living.heal(lf, amount)
                return some(Interaction { result: INTERACT_SUCCESS, used: true })
            }
            if item.ends_with("_dye") and owned {
                let color = dye_id(item.trim_prefix("minecraft:").trim_suffix("_dye")) ?? -1
                if color >= 0 and color != self.living.data.number(OWN + 3) {
                    self.living.data.set(OWN + 3, Value.Number(color))
                    return some(Interaction { result: INTERACT_SUCCESS, used: true })
                }
                if color >= 0 {
                    return none
                }
            }
            let armored = self.living.equipment[BODY_SLOT] != none
            if item == "minecraft:wolf_armor" and owned and not self.baby() and not armored {
                return some(Interaction { result: INTERACT_SUCCESS, used: true, body_armor: true })
            }
            if self.in_sitting_pose() and armored and owned and self.body_armor_damage() > 0 and item == "minecraft:armadillo_scute" {
                var out = Interaction { result: INTERACT_SUCCESS, used: false, shrinks: true, armor_repair: true }
                self.living.play(mut out.sounds, String("item.wolf_armor.repair"), 1.0f32, 1.0f32)
                return some(out)
            }
            return none
        }
        if item == "minecraft:bone" and not self.angry() {
            if self.living.body.random.next_int_below(3) == 0 {
                self.wolf_tamed(player, heard)
            } else {
                self.living.show(Shown.Event(6i8), heard)
            }
            return some(Interaction { result: INTERACT_SERVER, used: true })
        }
        return none
    }

    // The damage of what it wears in its body slot, its `minecraft:damage`, 0 for none (CAL-201).
    fn body_armor_damage(self) -> i32 {
        let stack = self.living.equipment[BODY_SLOT].copy() else return 0
        let Tag.Compound(c) = stack else return 0
        if not c.contains("components") {
            return 0
        }
        let Tag.Compound(parts) = c["components"] else return 0
        if not parts.contains("minecraft:damage") {
            return 0
        }
        return parts["minecraft:damage"].number_int() ?? 0
    }

    // Whether `item` is a dye of its collar's own colour used by its owner, the player of the UUID
    // `player`, where it's a tame wolf, `Wolf.mobInteract`'s `WOLF_COLLAR_DYES` way (CAL-201).
    fn wolf_dyed_same(self, item: String, player: (i64, i64)) -> bool {
        if not self.is_tame() or self.living.data.uuid(OWN + 1) != some(player) or not item.ends_with("_dye") {
            return false
        }
        let color = dye_id(item.trim_prefix("minecraft:").trim_suffix("_dye")) ?? -1
        return color >= 0 and color == self.collar_color()
    }

    // A tame wolf's owner's use that did nothing else, `Wolf.mobInteract`'s last (CAL-201): ordered
    // to sit where it wasn't, and to stand where it was, not jumping, its path stopped and no target,
    // `SUCCESS` without the item.
    fn wolf_sit_toggle(mut self) -> Interaction {
        self.wolf.sitting = not self.wolf.sitting
        self.living.jumping = false
        self.navigation.stop()
        self.target_to(none)
        return Interaction { result: INTERACT_SUCCESS, used: false, without_item: true }
    }

    /// `Cat.hiss` (CAL-201): its sound variant's hiss, as loud as its sounds, its voice's pitch
    /// drawn, `makeSound`, as a phantom near it that's swooping fears it.
    pub fn hiss(mut self, sounds: mut List<EntitySound>) {
        let set = self.variant_sounds()
        let pitch = self.voice_pitch()
        self.living.play(mut sounds, set.hiss.copy(), self.sound_volume, pitch)
    }

    // `Cat.getAmbientSound` (CAL-201), of its sound variant's sounds, a baby's where it's one:
    // tame, in love its purr, else 1 in 4, drawn, its purreow, else its ambient sound; wild, its
    // stray ambient sound.
    fn cat_ambient(mut self) -> String {
        let set = self.variant_sounds()
        if self.is_tame() {
            if self.in_love > 0 {
                return set.purr
            }
            return if self.living.body.random.next_int_below(4) == 0 { set.purreow } else { set.ambient }
        }
        return set.stray
    }

    // `Cat.tick`'s, after the rest (CAL-201): wild while its tempt goal runs, every 100th tick, its
    // begging heard, 1 loud at 1; then `handleLieDown`'s, lying or relaxed, every 5th tick, its
    // purr, 0.6 loud and four tenths of one draw less another more, at 1. How far it's lain down,
    // and whether on a sleeping player, are the client's.
    fn cat_tick(mut self, sounds: mut List<EntitySound>) {
        let set = self.variant_sounds()
        let ticks = self.living.body.tick_count
        if self.goals.tempting() and not self.is_tame() and ticks % 100 == 0 {
            self.living.play(mut sounds, set.beg.copy(), 1.0f32, 1.0f32)
        }
        if (self.living.data.flag(OWN + 3) or self.living.data.flag(OWN + 4)) and ticks % 5 == 0 {
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut sounds, set.purr.copy(), 0.6f32 + 0.4f32 * (a - b), 1.0f32)
        }
    }

    // `Cat.customServerAiStep`, not an animal's (CAL-201): moving at 0.6, crouching; at 1.33,
    // standing and sprinting; else, or not moving, standing and not sprinting. Sprinting's speed
    // comes with it, `LivingEntity.setSprinting`, and crouching it steps carefully,
    // `isSteppingCarefully`.
    fn cat_step(mut self) {
        var crouching = false
        var sprinting = false
        if self.moves.has_wanted() {
            let speed = self.moves.speed_modifier
            if speed == 0.6 {
                crouching = true
            } else if speed == 1.33 {
                sprinting = true
            }
        }
        self.living.data.set(POSE_ID, Value.Number(if crouching { CROUCHING } else { STANDING }))
        self.living.crouching = crouching
        self.living.data.set_flag(SHARED_FLAGS, SPRINTING_FLAG, sprinting)
        self.living.sprinting = sprinting
        sprint(mut self.living.attributes, sprinting)
    }

    // `Cat.mobInteract` (CAL-201), alive, with `item` in hand, `food` the nutrition of what's held
    // where it's food, by the player of the UUID `player`. Tame and theirs: a dye other than its
    // collar's, its collar that colour, used, and it kept, `SUCCESS`; else its food while it's hurt,
    // fed, healing it the nutrition, 1 for none, used, its eating heard, `feed`, `SUCCESS`. Wild,
    // its food used, one in three, drawn, taming it, `cat_tamed`, else entity event 6, smoke, after
    // the sounds `heard`; it kept and its eating heard, `SUCCESS`. None for the rest, an animal's
    // use, after which its owner's use that does nothing orders it to sit or stand, and any other
    // use that does something keeps it.
    fn cat_interact(mut self, lf: LivingFacts, item: String, food: i32?, player: (i64, i64), heard: usize) -> Interaction? {
        let fed = lf.tempting.of(item.copy()) & TEMPT_CAT_FOOD != 0u32
        if self.is_tame() {
            if self.living.data.uuid(OWN + 1) != some(player) {
                return none
            }
            if item.ends_with("_dye") {
                let color = dye_id(item.trim_prefix("minecraft:").trim_suffix("_dye")) ?? -1
                if color >= 0 and color != self.collar_color() {
                    self.set_collar(color)
                    self.persistence_required = true
                    return some(Interaction { result: INTERACT_SUCCESS, used: true })
                }
            } else if fed and self.living.health() < f32.nearest(self.living.attributes.value(attribute("max_health"))) {
                let amount = if let n = food { f32.nearest(n) } else { 1.0f32 }
                self.living.heal(lf, amount)
                var out = Interaction { result: INTERACT_SUCCESS, used: true }
                self.eating_sound(mut out.sounds)
                return some(out)
            }
            return none
        }
        if not fed {
            return none
        }
        var out = Interaction { result: INTERACT_SUCCESS, used: true }
        if self.living.body.random.next_int_below(3) == 0 {
            self.cat_tamed(player, heard)
        } else {
            self.living.show(Shown.Event(6i8), heard)
        }
        self.persistence_required = true
        self.eating_sound(mut out.sounds)
        return some(out)
    }

    /// Whether it's the killer bunny, `Rabbit.Variant.EVIL` (CAL-201).
    pub fn rabbit_evil(self) -> bool {
        return self.species == RABBIT and self.living.data.number(OWN) == RABBIT_EVIL
    }

    /// `Rabbit.setVariant` (CAL-201): the killer bunny's armor 8; its attack, `MeleeAttackGoal` at
    /// 1.4 that follows its target unseen, at 4; its target goals, the one who hurt it, alerting
    /// others, at 1, and players and wolves seen at 2; its attack 5 more, `evil`; its name the
    /// killer bunny's where it has none; and its sounds hostile, `getSoundSource`. Another's attack
    /// without that, its sounds neutral. Its variant then, `DATA_TYPE_ID`.
    pub fn set_rabbit_variant(mut self, v: i32) {
        let attack = attribute("attack_damage")
        let evil = Identifier { namespace: "minecraft", path: "evil" }
        if v == RABBIT_EVIL {
            self.set_base("minecraft:armor", 8.0)
            self.goals.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.4, follow_unseen: true, zombie: false }))
            self.targets.add(1, FLAG_TARGET, false, Goal.HurtBy(HurtBy { alert: true, targeting: Targeting { must_see: true } }))
            self.add_seek(2, SEEK_PLAYER, 10, true)
            self.add_seek(2, SEEK_WOLF, 10, true)
            self.living.attributes.update(attack, Modifier { id: evil, amount: 5.0, operation: ADD_VALUE })
            if not self.living.body.extras.contains("CustomName") {
                var name = JavaHashMap<String, Tag>()
                name.insert(String("translate"), Tag.Str(String("entity.minecraft.killer_bunny")))
                self.living.body.extras.insert(String("CustomName"), Tag.Compound(name.copy()))
                self.living.data.set(CUSTOM_NAME, Value.Name(Tag.Compound(name)))
            }
            self.living.body.sound_source = HOSTILE_SOURCE
        } else {
            self.living.attributes.take_off(attack, evil)
            self.living.body.sound_source = NEUTRAL_SOURCE
        }
        self.living.data.set(OWN, Value.Number(v))
    }

    // `Rabbit.setSpeedModifier` (CAL-201): its navigation's speed that, and wanted where it's
    // wanted at it.
    fn rabbit_speed(mut self, speed: f64) {
        self.navigation.set_speed_modifier(speed)
        let (x, y, z) = (self.moves.wanted_x, self.moves.wanted_y, self.moves.wanted_z)
        self.moves.set_wanted(x, y, z, speed)
    }

    // `Rabbit.startJumping` (CAL-201): jumping, `setJumping(true)`, its jump heard, as loud as its
    // sounds, at four fifths of about 1, drawn; its jump 15 ticks long, begun.
    fn rabbit_start_jumping(mut self, sounds: mut List<EntitySound>) {
        self.living.jumping = true
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        let pitch = ((a - b) * 0.2f32 + 1.0f32) * 0.8f32
        self.living.play(mut sounds, String("entity.rabbit.jump"), self.sound_volume, pitch)
        self.rabbit.jump_duration = 15
        self.rabbit.jump_ticks = 0
    }

    // `Rabbit.facePoint` (CAL-201): turned toward the place across.
    fn rabbit_face(mut self, x: f64, z: f64) {
        let angle = table_atan2(z - self.living.body.z, x - self.living.body.x) ?? 0.0
        self.living.body.y_rot = f32.nearest(angle * RAD_TO_DEG) - 90.0f32
    }

    // `Rabbit.customServerAiStep` (CAL-201): a tick less till it may jump; its ticks till it wants
    // carrots 0 to 2 less, drawn, not below 0; then on the ground, landed, no longer jumping and
    // its delay till it may jump again, 10 ticks, 3 at its fleeing speed, `checkLandingDelay`; the
    // killer bunny, able to jump, its target within 4, turned to it and wanted there, starts its
    // jump; then not told to jump, wanted somewhere and able to, it turns toward its path's next
    // place, else there, and starts its jump; told to and its jump control unable, able.
    fn rabbit_step(mut self, players: List<Follower>, sounds: mut List<EntitySound>) {
        if self.rabbit.jump_delay > 0 {
            self.rabbit.jump_delay -= 1
        }
        if self.rabbit.more_carrots > 0 {
            self.rabbit.more_carrots -= self.living.body.random.next_int_below(3)
            if self.rabbit.more_carrots < 0 {
                self.rabbit.more_carrots = 0
            }
        }
        if self.living.body.on_ground {
            if not self.rabbit.was_on_ground {
                self.living.jumping = false
                self.rabbit.jump_delay = if self.moves.speed_modifier < 2.2 { 10 } else { 3 }
                self.rabbit.can_jump = false
            }
            if self.rabbit_evil() and self.rabbit.jump_delay == 0 {
                if let t = self.target_in(players) {
                    if self.distance_sqr_to(t.x, t.y, t.z) < 16.0 {
                        self.rabbit_face(t.x, t.z)
                        let speed = self.moves.speed_modifier
                        self.moves.set_wanted(t.x, t.y, t.z, speed)
                        self.rabbit_start_jumping(mut sounds)
                        self.rabbit.was_on_ground = true
                    }
                }
            }
            if not self.jump {
                if self.moves.has_wanted() and self.rabbit.jump_delay == 0 {
                    var px = self.moves.wanted_x
                    var pz = self.moves.wanted_z
                    if let n = self.navigation.next_place(self.living.body.width) {
                        let (nx, _, nz) = n
                        px = nx
                        pz = nz
                    }
                    self.rabbit_face(px, pz)
                    self.rabbit_start_jumping(mut sounds)
                }
            } else if not self.rabbit.can_jump {
                self.rabbit.can_jump = true
            }
        }
        self.rabbit.was_on_ground = self.living.body.on_ground
    }

    // `RabbitMoveControl.tick` (CAL-201): on the ground, not jumping nor told to, its speed 0,
    // else wanted somewhere or jumping, its next jump's, `setSpeedModifier`; then a move
    // control's. Whether it jumps.
    fn rabbit_moves<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, nf: NavFacts, m: MovementStates, blocks: B, cache: mut PathTypeCache, w: Walker) -> bool {
        if self.living.body.on_ground and not self.living.jumping and not self.jump {
            self.rabbit_speed(0.0)
        } else if self.moves.has_wanted() or self.moves.operation == MOVE_JUMPING {
            let next = self.moves.next_jump_speed
            self.rabbit_speed(next)
        }
        return self.moves.tick(lf, f, nf, m, blocks, mut cache, mut self.living, w)
    }

    // `Rabbit.getJumpPower`'s multiplier, as it jumps in its `aiStep` (CAL-201): 0.3, 0.2 where
    // its move control's speed is 0.6 or less, 0.5 where its path's next place is more than half a
    // block up, or it ran into something across or is jumping toward a place wanted more than half
    // a block up, over 0.42; and what its jump pushes it on by, `Rabbit.jumpFromGround`.
    fn rabbit_jump_power(mut self) {
        var base = 0.3f32
        if self.moves.speed_modifier <= 0.6 {
            base = 0.2f32
        }
        if let n = self.navigation.next_place(self.living.body.width) {
            let (_, ny, _) = n
            if ny > self.living.body.y + 0.5 {
                base = 0.5f32
            }
        }
        if self.living.body.horizontal_collision or (self.living.jumping and self.moves.wanted_y > self.living.body.y + 0.5) {
            base = 0.5f32
        }
        self.living.jump_multiplier = base / 0.42f32
        self.living.hop = some((self.moves.speed_modifier, self.baby()))
    }

    // A rabbit's `RaidGardenGoal`, a `MoveToBlockGoal` within 16 at 0.7, every tick (CAL-201):
    // with its count of tries done, never where mob griefing's off, and not able to raid, wanting
    // to where it wants carrots, its ticks for them out; then, its count of tries done, its count
    // again 200 to 399, drawn and halved, where it finds a block that supports crops under grown
    // carrots nearest, wanting to raid and not yet able, which makes it able, `isValidTarget`.
    // Going on while able and the block's still one for it, which it isn't once it's able, so it
    // ticks once each time. As it starts, on its way to the block's top; its tries 0; its most
    // ticks there drawn. Each tick, within 1 of its top's centre, it's there, a try less, else a
    // try more, its way found again each 40th; looking at the top, 10 degrees a tick; there,
    // able, the carrots still carrots, raided, which its level does, `Shown.Raided`, its ticks
    // till it wants carrots 40; and not able, its count of tries 10.
    fn raid_garden_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut RaidGarden, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            if g.next_start <= 0 {
                if not self.mob_griefing {
                    return false
                }
                g.can = false
                g.wants = self.rabbit.more_carrots <= 0
            }
            if g.next_start > 0 {
                g.next_start -= 1
                return false
            }
            g.next_start = reduced_tick_delay(200 + self.living.body.random.next_int_below(200))
            let (mx, my, mz) = self.block_position()
            var y = 0
            while y <= 1 {
                for r in 0..16 {
                    var x = 0
                    while x <= r {
                        var z = if x < r and x > -r { r } else { 0 }
                        while z <= r {
                            let (px, py, pz) = (mx + x, my + y - 1, mz + z)
                            if self.within_home(f64(px), f64(py), f64(pz)) and garden_at(mut g, lf, f, blocks, px, py, pz) {
                                g.x = px
                                g.y = py
                                g.z = pz
                                return true
                            }
                            z = if z > 0 { -z } else { 1 - z }
                        }
                        x = if x > 0 { -x } else { 1 - x }
                    }
                }
                y = if y > 0 { -y } else { 1 - y }
            }
            return false
        }
        if call == GOAL_CONTINUE {
            if not g.can or g.try_ticks < -g.max_stay or g.try_ticks > 1200 {
                return false
            }
            let (gx, gy, gz) = (g.x, g.y, g.z)
            return garden_at(mut g, lf, f, blocks, gx, gy, gz)
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, 0.7)
            g.try_ticks = 0
            let bound = self.living.body.random.next_int_below(1200) + 1200
            g.max_stay = self.living.body.random.next_int_below(bound) + 1200
        } else if call == GOAL_TICK {
            let dx = f64(g.x) + 0.5 - self.living.body.x
            let dy = f64(g.y + 1) + 0.5 - self.living.body.y
            let dz = f64(g.z) + 0.5 - self.living.body.z
            if dx * dx + dy * dy + dz * dz < 1.0 {
                g.reached = true
                g.try_ticks -= 1
            } else {
                g.reached = false
                g.try_ticks += 1
                if g.try_ticks % 40 == 0 {
                    _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, 0.7)
                }
            }
            self.look.set_look_at(f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, 10.0f32, self.max_head_x_rot())
            if g.reached {
                let above = state_at(blocks, g.x, g.y + 1, g.z)
                if g.can and f.block(above) == lf.carrots {
                    self.living.show(Shown.Raided((g.x, g.y + 1, g.z)), heard)
                    self.rabbit.more_carrots = 40
                }
                g.can = false
                g.next_start = 10
            }
        }
        return false
    }

    /// Whether it's an ocelot that trusts players, `isTrusting`, `DATA_TRUSTING` (CAL-201).
    pub fn ocelot_trusting(self) -> bool {
        return self.species == OCELOT and self.living.data.flag(OWN)
    }

    // `Ocelot.mobInteract` (CAL-201), its own part: with its tempt goal running, not trusting, its
    // food in hand and the player, at `user`, within 3, one of the food used, `usePlayerItem`, no
    // eating sound; one in three it trusts them, `setTrusting(true)`, its goals reassessed, so it
    // no longer flees players, else not; either way its particles drawn, `spawnTrustingParticles`,
    // as the level shows none, then entity event 41 where it trusts, else 40. Otherwise an
    // animal's use, none here.
    fn ocelot_interact(mut self, lf: LivingFacts, item: String, user: (f64, f64, f64), heard: usize) -> Interaction? {
        let (ux, uy, uz) = user
        if not self.goals.tempting() or self.ocelot_trusting() or lf.tempting.of(item.copy()) & TEMPT_OCELOT_FOOD == 0u32 or self.distance_sqr_to(ux, uy, uz) >= 9.0 {
            return none
        }
        let trusts = self.living.body.random.next_int_below(3) == 0
        if trusts {
            self.living.data.set(OWN, Value.Bool(true))
            self.reassess_tame_goals()
        }
        for _ in 0..7 {
            _ = self.living.body.random.next_gaussian()
            _ = self.living.body.random.next_gaussian()
            _ = self.living.body.random.next_gaussian()
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
        }
        self.living.show(Shown.Event(if trusts { 41i8 } else { 40i8 }), heard)
        return some(Interaction { result: INTERACT_SUCCESS, used: true })
    }

    // A cat's taming by the player of the UUID `owner` (CAL-201), its food's one in three: tame,
    // `setTame(true, true)`, its goals reassessed, so it no longer flees players; theirs,
    // `setOwner`, shown, which triggers their `TAME_ANIMAL`; ordered to sit; and entity event 7
    // after the sounds `heard`.
    fn cat_tamed(mut self, owner: (i64, i64), heard: usize) {
        self.living.data.set_flag(OWN, 4, true)
        self.reassess_tame_goals()
        let (most, least) = owner
        self.living.data.set(OWN + 1, Value.Uuid(most, least))
        self.living.show(Shown.Tamed(owner), heard)
        self.wolf.sitting = true
        self.living.show(Shown.Event(7i8), heard)
    }

    /// A cat baby of tame parents, `Cat.getBreedOffspring` (CAL-201): its owner theirs, of the UUID
    /// `owner`, tame, `setTame(true, true)`, its goals reassessed, and its collar `collar`.
    pub fn cat_born_tame(mut self, owner: (i64, i64), collar: i32) {
        let (most, least) = owner
        self.living.data.set(OWN + 1, Value.Uuid(most, least))
        self.living.data.set_flag(OWN, 4, true)
        self.reassess_tame_goals()
        self.set_collar(collar)
    }

    // A tame cat's `CatRelaxOnOwnerGoal` (CAL-201): used where it's tame, not ordered to sit and
    // its owner's a player there, kept, who sleeps within 10 of it on a block it may lie on, a bed,
    // the block it goes to the one behind their bed's way, `goalPos`, else theirs, where no other
    // cat lies or relaxes within 2 of it, `spaceIsOccupied`; going on while that holds. As it
    // starts, not sitting and on its way there at 1.1. Each tick, not sitting and on its way there
    // again; within 2.5 squared of them, its ticks by them counted, and past 8 lying, else turned
    // to them at once, 45 degrees, and relaxing, `RELAX_STATE_ONE`; further, not lying. As it
    // stops, not lying; where its owner's slept 100 ticks or more and the level's random draws
    // under `CAT_WAKING_UP_GIFT_CHANCE` where it is, its morning gift; then not relaxing and its
    // path stopped.
    fn cat_relax_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut CatRelax, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            if not self.is_tame() or self.wolf.sitting {
                return false
            }
            let o = self.owner_in(players) else return false
            g.owner = some(o.id)
            if not o.sleeping or self.distance_sqr_to(o.x, o.y, o.z) > 100.0 {
                return false
            }
            let (ox, oy, oz) = (floor_of(o.x), floor_of(o.y), floor_of(o.z))
            let state = blocks.collision_state(ox, oy, oz) else return false
            if not f.in_set(state, lf.cats_lie_on) {
                return false
            }
            let facing = f.get_name(state, "facing") ?? String()
            g.goal = some(if facing == "north" { (ox, oy, oz + 1) } else if facing == "south" { (ox, oy, oz - 1) } else if facing == "east" { (ox - 1, oy, oz) } else if facing == "west" { (ox + 1, oy, oz) } else { (ox, oy, oz) })
            return not self.relax_space_taken(g)
        }
        if call == GOAL_CONTINUE {
            if not self.is_tame() or self.wolf.sitting or g.goal == none {
                return false
            }
            let id = g.owner else return false
            let at = player_at(players, id) else return false
            return players[at].sleeping and not self.relax_space_taken(g)
        }
        if call == GOAL_START {
            if let (gx, gy, gz) = g.goal {
                self.living.data.set_flag(OWN, 1, false)
                _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(gx), f64(gy), f64(gz), 1.1)
            }
        } else if call == GOAL_STOP {
            self.living.data.set(OWN + 3, Value.Bool(false))
            if let id = g.owner {
                if let at = player_at(players, id) {
                    if players[at].sleep_timer >= 100 {
                        let (bx, by, bz) = self.block_position()
                        let chance = blocks.cat_gift_chance(bx, by, bz)
                        let lent = self.level_random.take()
                        let had = lent != none
                        if not had {
                            self.living.show(Shown.Missing(String("A cat's morning gift's chance without its level's random")), heard)
                        }
                        var random = lent ?? TapedRandom.new(0i64)
                        let drawn = random.next_float()
                        if had {
                            self.level_random = some(random)
                        }
                        if drawn < chance {
                            self.cat_gift(lf, f, m, blocks, min_y, players, heard)
                        }
                    }
                }
            }
            g.on_bed = 0
            self.living.data.set(OWN + 4, Value.Bool(false))
            self.navigation.stop()
        } else if call == GOAL_TICK {
            let id = g.owner else return false
            let at = player_at(players, id) else return false
            let (gx, gy, gz) = g.goal else return false
            let o = players[at].copy()
            self.living.data.set_flag(OWN, 1, false)
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(gx), f64(gy), f64(gz), 1.1)
            if self.distance_sqr_to(o.x, o.y, o.z) < 2.5 {
                g.on_bed += 1
                if g.on_bed > reduced_tick_delay(16) {
                    self.living.data.set(OWN + 3, Value.Bool(true))
                    self.living.data.set(OWN + 4, Value.Bool(false))
                } else {
                    self.look_at_now(o, 45.0f32, 45.0f32)
                    self.living.data.set(OWN + 4, Value.Bool(true))
                }
            } else {
                self.living.data.set(OWN + 3, Value.Bool(false))
            }
        }
        return false
    }

    // `CatRelaxOnOwnerGoal.spaceIsOccupied` (CAL-201): another cat whose box meets the block it
    // goes to grown by 2, `getEntitiesOfClass`, lying or relaxing.
    fn relax_space_taken(self, g: CatRelax) -> bool {
        let (gx, gy, gz) = g.goal else return false
        for k in self.kin {
            if k.species == CAT and k.id != self.living.body.id and k.relaxing and k.bounds.intersects(f64(gx) - 2.0, f64(gy) - 2.0, f64(gz) - 2.0, f64(gx) + 3.0, f64(gy) + 3.0, f64(gz) + 3.0) {
                return true
            }
        }
        return false
    }

    /// Whether it's a cat lying or relaxing, `isLying` or `isRelaxStateOne`, which keeps another
    /// from relaxing by it (CAL-201).
    pub fn cat_relaxing(self) -> bool {
        return self.species == CAT and (self.living.data.flag(OWN + 3) or self.living.data.flag(OWN + 4))
    }

    // `CatRelaxOnOwnerGoal.giveMorningGift` (CAL-201): from its leash's holder's block where it's
    // leashed, else its own, a teleport to 5 about across and 2 up and down, drawn,
    // `randomTeleport`, without particles, onto no block `#cat_does_not_teleport_to`; then
    // `gameplay/cat_morning_gift` rolled, `dropFromGiftLootTable`, its stacks dropped at its block
    // then, a block behind its body's way, with no pickup delay.
    fn cat_gift<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, players: List<Follower>, heard: usize) {
        var from = self.block_position()
        if let h = self.leash_holder() {
            if let knot = h.knot {
                from = knot
            } else if let at = player_at(players, h.id) {
                from = (floor_of(players[at].x), floor_of(players[at].y), floor_of(players[at].z))
            } else {
                self.living.show(Shown.Missing(String("A leashed cat's morning gift from its holder's place")), heard)
            }
        }
        let (bx, by, bz) = from
        let dx = self.living.body.random.next_int_below(11) - 5
        let dy = self.living.body.random.next_int_below(5) - 2
        let dz = self.living.body.random.next_int_below(11) - 5
        _ = self.random_teleport(lf, f, m, blocks, min_y, f64(bx + dx), f64(by + dy), f64(bz + dz), false, heard)
        let (cx, cy, cz) = self.block_position()
        let turn = f64(self.living.y_body_rot * 0.017453292f32)
        let laid = Laid { x: f64(cx) - f64(table_sin(turn)), y: f64(cy), z: f64(cz) + f64(table_cos(turn)), item: String(), table: String("minecraft:gameplay/cat_morning_gift"), loose: true }
        self.living.show(Shown.Laid(laid), heard)
    }

    // A tame cat's `CatLieOnBlockGoal`, where `g.lie`, else its `CatSitOnBlockGoal`, each a
    // `MoveToBlockGoal` within 8, every tick (CAL-201): used where it's tame, not ordered to sit
    // and, to lie, not lying, once its count of tries is done, `nextStartTick`, its count again 40
    // to lie, else 200 to 399, drawn and halved, where it finds its block nearest; going on while
    // its block's still one for it and it's tried no more than 1200 ticks to get there, nor stayed
    // longer than its most. As it starts, on its way to the block's top at its speed, its tries 0,
    // its most ticks there drawn, 1200 to 3599, and not sitting. Each tick, within 1 of its top's
    // centre, it's there, a try less, else it's not, a try more, its way found again each 40th;
    // then, to lie, lying there alone, not sitting; to sit, sitting there alone. As it stops, not
    // lying, or not sitting.
    fn cat_block_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut CatBlock, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if not self.is_tame() or self.wolf.sitting or (g.lie and self.living.data.flag(OWN + 3)) {
                return false
            }
            if g.next_start > 0 {
                g.next_start -= 1
                return false
            }
            g.next_start = if g.lie { 40 } else { reduced_tick_delay(200 + self.living.body.random.next_int_below(200)) }
            return self.find_cat_block(mut g, lf, f, blocks)
        }
        if call == GOAL_CONTINUE {
            return g.try_ticks >= -g.max_stay and g.try_ticks <= 1200 and cat_block_at(g.lie, lf, f, blocks, g.x, g.y, g.z)
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, g.speed)
            g.try_ticks = 0
            let bound = self.living.body.random.next_int_below(1200) + 1200
            g.max_stay = self.living.body.random.next_int_below(bound) + 1200
            self.living.data.set_flag(OWN, 1, false)
        } else if call == GOAL_STOP {
            if g.lie {
                self.living.data.set(OWN + 3, Value.Bool(false))
            } else {
                self.living.data.set_flag(OWN, 1, false)
            }
        } else if call == GOAL_TICK {
            let dx = f64(g.x) + 0.5 - self.living.body.x
            let dy = f64(g.y + 1) + 0.5 - self.living.body.y
            let dz = f64(g.z) + 0.5 - self.living.body.z
            if dx * dx + dy * dy + dz * dz < 1.0 {
                g.reached = true
                g.try_ticks -= 1
            } else {
                g.reached = false
                g.try_ticks += 1
                if g.try_ticks % 40 == 0 {
                    _ = self.move_to(lf, f, m, blocks, mut cache, min_y, f64(g.x) + 0.5, f64(g.y + 1), f64(g.z) + 0.5, g.speed)
                }
            }
            if g.lie {
                self.living.data.set_flag(OWN, 1, false)
                self.living.data.set(OWN + 3, Value.Bool(g.reached))
            } else {
                self.living.data.set_flag(OWN, 1, g.reached)
            }
        }
        return false
    }

    // `MoveToBlockGoal.findNearestBlock` for a cat's block goal (CAL-201): the blocks about its
    // block, a block down, by rings out to 8, each layer from its start, then on up and down in
    // turn, `y > 0 ? -y : 1 - y`, to its range up, in vanilla's order, the first within its home
    // that's one for it, kept.
    fn find_cat_block<B: CollisionBlocks + MobLight>(self, g: mut CatBlock, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let (mx, my, mz) = self.block_position()
        var y = g.vertical_start
        while y <= g.vertical {
            for r in 0..8 {
                var x = 0
                while x <= r {
                    var z = if x < r and x > -r { r } else { 0 }
                    while z <= r {
                        let (px, py, pz) = (mx + x, my + y - 1, mz + z)
                        if self.within_home(f64(px), f64(py), f64(pz)) and cat_block_at(g.lie, lf, f, blocks, px, py, pz) {
                            g.x = px
                            g.y = py
                            g.z = pz
                            return true
                        }
                        z = if z > 0 { -z } else { 1 - z }
                    }
                    x = if x > 0 { -x } else { 1 - x }
                }
            }
            y = if y > 0 { -y } else { 1 - y }
        }
        return false
    }

    // A cat's `OcelotAttackGoal` (CAL-201), every tick: used where it has a target, kept; going on
    // while that's alive and within 15, and its path's going or it has a target still, kept. As it
    // stops, none kept and its path stopped. Each tick, looking at its target's eyes, 30 degrees a
    // tick, going to it at 0.8, at 1.33 out of its reach within 4, else within 15 at 0.6; its
    // count down to 0, and within its reach, twice its width, once the count's out, hitting it,
    // which its level deals after the sounds `heard`, unswung, its count 20 again.
    fn ocelot_attack_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut OcelotAttack, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            let id = self.target else return false
            g.target = some(id)
            return true
        }
        if call == GOAL_CONTINUE {
            let id = g.target else return false
            let p = self.followed(players, id) else return false
            if p.dead {
                return false
            }
            if self.distance_sqr_to(p.x, p.y, p.z) > 225.0 {
                return false
            }
            if not self.navigation.is_done() {
                return true
            }
            let now = self.target else return false
            g.target = some(now)
            return true
        }
        if call == GOAL_STOP {
            g.target = none
            self.navigation.stop()
        } else if call == GOAL_TICK {
            let id = g.target else return false
            let p = self.followed(players, id) else return false
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
            let reach = f64(self.living.body.width * 2.0f32 * (self.living.body.width * 2.0f32))
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            var speed = 0.8
            if d > reach and d < 16.0 {
                speed = 1.33
            } else if d < 225.0 {
                speed = 0.6
            }
            _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, p.x, p.y, p.z, speed)
            g.attack_time = if g.attack_time - 1 > 0 { g.attack_time - 1 } else { 0 }
            if not (d > reach) and g.attack_time <= 0 {
                g.attack_time = 20
                let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                self.living.show(Shown.Attack((p.id, ax, ay, az)), heard)
            }
        }
        return false
    }

    // A wolf's `BegGoal` (CAL-201): used where the nearest player within 8 of its feet, seen,
    // `forNonCombat`, holds a bone or what it eats in either hand; going on while they're alive,
    // within 8, holding it, and its time's not out. As it starts, interested, shown, for 40 to 79
    // ticks, drawn; each tick looking at their eyes, 10 degrees a tick; as it stops, no longer
    // interested.
    fn beg_goal<B: CollisionBlocks>(mut self, g: mut Beg, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            let who = self.looker()
            g.player = nearest_player(m, f, blocks, mut self.sensing, who, players, 8.0, self.living.body.y, true, 0u32)
            let id = g.player else return false
            let at = player_at(players, id) else return false
            return players[at].tempts & (TEMPT_BONE | TEMPT_WOLF_FOOD) != 0u32
        }
        if call == GOAL_CONTINUE {
            let id = g.player else return false
            let at = player_at(players, id) else return false
            let p = players[at].copy()
            if p.dead or self.distance_sqr_to(p.x, p.y, p.z) > 64.0 {
                return false
            }
            return g.look_time > 0 and p.tempts & (TEMPT_BONE | TEMPT_WOLF_FOOD) != 0u32
        }
        if call == GOAL_START {
            self.living.data.set(OWN + 2, Value.Bool(true))
            g.look_time = reduced_tick_delay(40 + self.living.body.random.next_int_below(40))
        } else if call == GOAL_STOP {
            self.living.data.set(OWN + 2, Value.Bool(false))
            g.player = none
        } else if call == GOAL_TICK {
            let id = g.player else return false
            let at = player_at(players, id) else return false
            let p = players[at].copy()
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 10.0f32, self.max_head_x_rot())
            g.look_time -= 1
        }
        return false
    }

    // `PanicGoal` (D416): used where what last hurt it, within 40 ticks, `getLastDamageSource`, is
    // of a type in `#panic_causes`, with a place to run to, up to 5 across and 4 up or down,
    // `DefaultRandomPos.getPos`, or on fire to water near, `look_for_water` (D434); going on till
    // its navigation's done.
    fn panic_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Panic, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            // A fox's not while it defends, `FoxPanicGoal.shouldPanic` (CAL-201).
            if self.fox_flag(FOX_DEFENDING) {
                return false
            }
            // A polar bear's, a cub's `#panic_causes`, a grown one's its surroundings' (CAL-201).
            let causes = if g.polar and not self.baby() { PANIC_ENVIRONMENTAL_CAUSES } else if g.polar { 8u32 } else { g.causes }
            if not self.living.recently_hurt_by(self.game_time, causes) {
                return false
            }
            if g.turtle {
                // `TurtlePanicGoal.canUse` (CAL-201): to water within 7, burning or not.
                if let (wx, wy, wz) = self.look_for_water(f, m, blocks, 7) {
                    g.x = f64(wx)
                    g.y = f64(wy)
                    g.z = f64(wz)
                    return true
                }
            } else if self.living.on_fire() {
                if let (wx, wy, wz) = self.look_for_water(f, m, blocks, 5) {
                    g.x = f64(wx)
                    g.y = f64(wy)
                    g.z = f64(wz)
                    return true
                }
            }
            let at = self.random_place(false, 5, 4, lf, f, blocks, mut cache, min_y) else return false
            let (x, y, z) = at
            g.x = x
            g.y = y
            g.z = z
            return true
        }
        if call == GOAL_CONTINUE and g.panda and self.panda_flag(PANDA_SITTING) {
            // `PandaPanicGoal.canContinueToUse` (CAL-201): sitting, its navigation stopped, no more.
            self.navigation.stop()
            return false
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.x, g.y, g.z, g.speed)
        } else if call == GOAL_TICK and self.species == RABBIT {
            // `RabbitPanicGoal.tick` (CAL-201): its speed its panic's, `setSpeedModifier`.
            self.rabbit_speed(g.speed)
        } else if call == GOAL_TICK and self.tamable() {
            // `TamableAnimalPanicGoal.tick` (CAL-201): a tame one able to go to its owner, 12 or
            // more off them, teleports to them.
            let owner = self.owner_in(players)
            if let o = owner {
                if not self.unable_to_move_to_owner(owner) and self.distance_sqr_to(o.x, o.y, o.z) >= 144.0 {
                    self.teleport_to_owner(o, lf, f, m, blocks, mut cache, min_y)
                }
            }
        }
        return false
    }

    // `AvoidEntityGoal` of players, a fish's (CAL-178): used where the nearest player it may flee,
    // `nearest_avoided`, has a place away from them, up to 16 across and 7 up or down,
    // `DefaultRandomPos.getPosAway`, no nearer them than it is, and a path there, followed at its
    // walking speed while it has one; each tick at its sprinting speed within 7 of them.
    fn avoid_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Avoid, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            // A fox's none while it defends (CAL-201).
            if self.fox_flag(FOX_DEFENDING) {
                g.to_avoid = none
                return false
            }
            // A panda's only a worried one's free to act, `PandaAvoidGoal` (CAL-201).
            if g.panda and not (self.panda_variant() == GENE_WORRIED and self.panda_can_act()) {
                return false
            }
            // A rabbit's never the killer bunny's, `RabbitAvoidEntityGoal` (CAL-201).
            if g.rabbit and self.rabbit_evil() {
                return false
            }
            let b = self.living.body.bounding_box()
            let r = f64(g.max_dist)
            let near = Aabb { min_x: b.min_x - r, min_y: b.min_y - 3.0, min_z: b.min_z - r, max_x: b.max_x + r, max_y: b.max_y + 3.0, max_z: b.max_z + r }
            let me = self.looker()
            if g.species >= 0 or g.species == AVOID_MONSTERS or g.species == AVOID_GUARDIANS {
                // A skeleton's of wolves, a creeper's of ocelots and cats, and a spider's of
                // armadillos that aren't scared, among its level's mobs, in any difficulty
                // (CAL-201).
                var kind = List<Follower>()
                for p in self.prey {
                    let fits = if g.species == AVOID_MONSTERS { p.mob and monster_kind(p.species) } else if g.species == AVOID_GUARDIANS { p.mob and (p.species == GUARDIAN or p.species == ELDER_GUARDIAN) } else { p.species == g.species and not (g.unscared and p.scared) and not (self.species == FOX and p.tamed) }
                    if fits {
                        kind.push(p.copy())
                    }
                }
                g.to_avoid = nearest_avoided(m, f, blocks, mut self.sensing, me, kind, r, near, false)
            } else {
                // A fox's of players not sneaking that it doesn't trust (CAL-201).
                var fled = players.copy()
                if self.species == FOX {
                    fled = List<Follower>()
                    for p in players {
                        if not p.discrete and not self.fox_trusts(p.uuid) {
                            fled.push(p.copy())
                        }
                    }
                }
                g.to_avoid = nearest_avoided(m, f, blocks, mut self.sensing, me, fled, r, near, self.difficulty == 0)
            }
            let id = g.to_avoid else return false
            let p = self.followed(players, id) else return false
            let costs = self.own_maluses()
            let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
            let away = (self.living.body.x - p.x, self.living.body.z - p.z)
            let tries = away_any_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 16, 7, away)
            let at = self.best_place(lf, f, blocks, tries) else return false
            let (x, y, z) = at
            let (dx, dy, dz) = (p.x - x, p.y - y, p.z - z)
            let (ex, ey, ez) = (p.x - self.living.body.x, p.y - self.living.body.y, p.z - self.living.body.z)
            if dx * dx + dy * dy + dz * dz < ex * ex + ey * ey + ez * ez {
                return false
            }
            let nf = nav_facts(lf, blocks, min_y)
            let walker = self.walker(lf)
            g.path = self.navigation.create_path(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, walker, floor_of(x), floor_of(y), floor_of(z), 0)
            if g.llama and g.path != none {
                // `WolfAvoidEntityGoal.canUse`: a wild wolf's of a llama whose strength beats a
                // draw below 5, `avoidLlama` (CAL-201).
                return not self.is_tame() and p.strength >= self.living.body.random.next_int_below(5)
            }
            return g.path != none
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if g.llama and (call == GOAL_START or call == GOAL_TICK) {
            // `WolfAvoidEntityGoal.start` and `tick`: its target let go first (CAL-201).
            self.set_target(none, players)
        }
        if call == GOAL_START {
            let nf = nav_facts(lf, blocks, min_y)
            let walker = self.walker(lf)
            _ = self.navigation.move_along(lf, f, nf, blocks, walker, g.path.take(), g.walk)
        } else if call == GOAL_STOP {
            g.to_avoid = none
        } else if call == GOAL_TICK {
            let id = g.to_avoid else return false
            let p = self.followed(players, id) else return false
            let d = self.distance_sqr_to(p.x, p.y, p.z)
            self.navigation.set_speed_modifier(if d < 49.0 { g.sprint } else { g.walk })
        }
        return false
    }

    // `FollowFlockLeaderGoal` (CAL-178): never with followers of its own; else used while it
    // follows; else once its wait's out, drawn again, the fish of its kind whose boxes meet its own
    // grown by 8, it among them, that may be followed or follow none, the first that may be
    // followed its leader, or itself, which takes on those that follow none, as many as its school
    // has room for, it counted where it's among them, `addFollowers`; used where it follows then.
    // Going on while it follows within 11 of its leader, finding its path to it every 5 ticks at
    // 1, `pathToLeader`; and no longer following as it stops, `stopFollowing`.
    fn flock_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut Flock, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.school_size > 1 {
                return false
            }
            if self.follows_leader() {
                return true
            }
            if g.next_start > 0 {
                g.next_start -= 1
                return false
            }
            g.next_start = self.flock_start_tick()
            let me = self.living.body.id
            let b = self.living.body.bounding_box()
            // Each in its school as `getEntitiesOfClass` finds them, by ID, school size and
            // whether it follows, itself as it is now.
            var school = List<(i32, i32, bool)>()
            for k in self.kin {
                if k.species != self.species or not k.bounds.intersects(b.min_x - 8.0, b.min_y - 8.0, b.min_z - 8.0, b.max_x + 8.0, b.max_y + 8.0, b.max_z + 8.0) {
                    continue
                }
                let (size, follows) = if k.id == me { (self.school_size, self.follows_leader()) } else { (k.school_size, k.follower) }
                let followed = size > 1 and size < self.max_cluster
                if followed or not follows {
                    school.push((k.id, size, follows))
                }
            }
            var leader = me
            var leader_size = self.school_size
            for s in school {
                let (id, size, _) = s
                if size > 1 and size < self.max_cluster {
                    leader = id
                    leader_size = size
                    break
                }
            }
            let room = self.max_cluster - leader_size
            var taken = 0
            for s in school {
                let (id, _, follows) = s
                if follows {
                    continue
                }
                if taken >= room {
                    break
                }
                taken += 1
                if id == leader {
                    continue
                }
                // `startFollowing`: it follows the leader, whose school grows by it.
                if leader == me {
                    self.school_size += 1
                } else {
                    self.told.push(Told.School((leader, 1)))
                }
                if id == me {
                    self.leader = some(leader)
                    self.leader_seen = self.kin_of(leader)
                } else {
                    self.told.push(Told.Lead((id, leader)))
                }
            }
            return self.follows_leader()
        }
        if call == GOAL_CONTINUE {
            let l = self.leader_seen else return false
            return l.alive and self.distance_sqr_to(l.x, l.y, l.z) <= 121.0
        }
        if call == GOAL_START {
            g.recalc = 0
        } else if call == GOAL_STOP {
            if let l = self.leader {
                self.told.push(Told.School((l, -1)))
            }
            self.leader = none
            self.leader_seen = none
        } else if call == GOAL_TICK {
            g.recalc -= 1
            if g.recalc <= 0 {
                g.recalc = reduced_tick_delay(10)
                if self.follows_leader() {
                    if let l = self.leader_seen {
                        _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, l.x, l.y, l.z, 1.0)
                    }
                }
            }
        }
        return false
    }

    // `FollowFlockLeaderGoal.nextStartTick`: 200 ticks and up to 19 more, drawn, halved,
    // `reducedTickDelay`.
    fn flock_start_tick(mut self) -> i32 {
        return reduced_tick_delay(200 + self.living.body.random.next_int_below(200) % 20)
    }

    /// Whether it's a schooling fish following a leader that's alive, `isFollower` (CAL-178).
    pub fn follows_leader(self) -> bool {
        let l = self.leader_seen else return false
        return self.leader != none and l.alive
    }

    // `RunAroundLikeCrazyGoal` (D710): used where something rides it, it isn't tamed and no mob
    // steers it, `isMobControlled`, as a mob riding a zombie horse does, with a place to run to,
    // up to 5 across and 4 up or down, `DefaultRandomPos.getPos`; going on till its navigation's
    // done, it's tamed or nothing rides it. Each tick it's used, 1 in 25 drawn, it throws what
    // rides it off, `ejectPassengers`, as it was then, and it's angry, `makeMad`, with entity
    // event 6; a player riding it may tame it first, or it grows more tempered (CAL-179).
    fn run_around_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut RunAround, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        let tamed = self.horse_flag(2)
        let ridden = not self.living.body.passengers.is_empty()
        if call == GOAL_CAN_USE {
            let steered = self.species == ZOMBIE_HORSE and self.carries_mob
            if steered or tamed or not ridden {
                return false
            }
            let at = self.random_place(false, 5, 4, lf, f, blocks, mut cache, min_y) else return false
            let (x, y, z) = at
            g.x = x
            g.y = y
            g.z = z
            return true
        }
        if call == GOAL_CONTINUE {
            return not tamed and not self.navigation.is_done() and ridden
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.x, g.y, g.z, g.speed)
        } else if call == GOAL_TICK and self.player_thrown {
            // Going on from where it threw the player off, once its level's put them where they
            // get off (CAL-179).
            self.player_thrown = false
        } else if call == GOAL_TICK and not tamed and self.living.body.random.next_int_below(reduced_tick_delay(50)) == 0 {
            if not ridden {
                return false
            }
            // A player riding it tames it where its temper beats a number drawn below 100, its
            // most, `tameWithName`: theirs, `setOwner`, tamed, their `TAME_ANIMAL`, then entity
            // event 7; else it's 5 more tempered, to 100, and throws them (CAL-179).
            if let owner = self.player_rider {
                let most_temper = self.max_temper()
                if self.living.body.random.next_int_below(most_temper) < self.temper {
                    self.kept.insert(String("Owner"), uuid_tag(owner))
                    self.set_horse_flag(2, true)
                    self.living.show(Shown.Tamed(owner), sounds.len())
                    self.living.show(Shown.Event(7i8), sounds.len())
                    return false
                }
                let t = self.temper + 5
                let most = self.max_temper()
                self.temper = if t > most { most } else { t }
            }
            self.thrown_from = some(self.living.body.copy())
            let threw_player = self.player_rider != none
            if threw_player {
                self.living.show(Shown.ThrewPlayer, sounds.len())
            }
            self.living.body.passengers.clear()
            self.make_mad(mut sounds)
            self.living.show(Shown.Event(6i8), sounds.len())
            // Its goals' tick stops for its level to put the player it threw where they get off,
            // `dismountTo`, then and there, before what's left of its tick sees them (CAL-179).
            if threw_player {
                self.player_thrown = true
                self.goals_stop = true
            }
        }
        return false
    }

    // `AbstractHorse.makeMad` (D710): where it isn't standing, it stands, `standIfPossible`, and
    // makes its angry sound, a baby horse's its own.
    fn make_mad(mut self, sounds: mut List<EntitySound>) {
        if self.species == LLAMA {
            // A llama never stands, `canPerformRearing`, but its anger's heard (CAL-201).
            self.make_sound(mut sounds, "entity.llama.angry")
            return
        }
        if self.horse_flag(32) {
            return
        }
        self.set_horse_flag(16, false)
        self.set_horse_flag(32, true)
        self.stand_counter = 20
        // A skeleton horse has no angry sound, `getAngrySound` (CAL-349).
        if self.species == SKELETON_HORSE {
            return
        }
        let sound = if self.species == DONKEY { "entity.donkey.angry" } else if self.species == ZOMBIE_HORSE { "entity.zombie_horse.angry" } else if self.baby() { "entity.baby_horse.angry" } else { "entity.horse.angry" }
        self.make_sound(mut sounds, sound)
    }

    // `SkeletonTrapGoal` (CAL-349): used while it's a trap and a player alive and not
    // spectating is nearer than 10, `hasNearbyAlivePlayer`; its tick no trap any more,
    // `setTrap(false)`, tamed and grown, `setAge(0)`, and the rest, its bolt and its horsemen, for
    // its level to make, `Shown.SkeletonTrap`.
    fn skeleton_trap_goal(mut self, call: i32, players: List<Follower>, sounds: List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            if not self.skeleton_trap {
                return false
            }
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            for p in players {
                if p.mob or p.dead or p.spectator {
                    continue
                }
                let (dx, dy, dz) = (p.x - x, p.y - y, p.z - z)
                if dx * dx + dy * dy + dz * dz < 100.0 {
                    return true
                }
            }
            return false
        }
        if call == GOAL_TICK and self.skeleton_trap {
            self.set_trap(false)
            self.set_horse_flag(2, true)
            self.set_age(0)
            // Its other horses' pushes, each way `triangle(0, 1.1485)`, drawn from its own random
            // as its tick makes them, three of them (CAL-349).
            var pushes = List<(f64, f64)>()
            for _ in 0..3 {
                let px = self.living.body.random.triangle(0.0, 1.1485)
                let pz = self.living.body.random.triangle(0.0, 1.1485)
                pushes.push((px, pz))
            }
            self.living.show(Shown.SkeletonTrap(pushes), sounds.len())
        }
        return false
    }

    // `FloatGoal`: used while it's deeper in water than it jumps out of, `getFluidJumpThreshold`,
    // 0.4 or 0 for eyes below 0.4, or in lava; each tick 4 in 5, drawn from its random, it jumps.
    fn float_goal(mut self, call: i32) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            // A fox's in fluid a quarter deep, `FoxFloatGoal.canUse` (CAL-201).
            let threshold = if self.species == FOX { 0.25 } else if f64(self.living.body.eyes) < 0.4 { 0.0 } else { 0.4 }
            return self.living.body.water > threshold or self.living.body.in_lava()
        }
        if call == GOAL_START and self.species == FOX {
            // `FoxFloatGoal.start`: its states cleared (CAL-201).
            self.fox_clear_states()
        }
        if call == GOAL_TICK and self.living.body.random.next_float() < 0.8f32 {
            self.jump = true
        }
        return false
    }

    // `RandomLookAroundGoal`: used 1 in 50, drawn; a way drawn round it and 20 to 39 ticks, also
    // drawn, looking that way at its eyes' height.
    fn look_around_goal(mut self, g: mut LookAround, call: i32) -> bool {
        if call == GOAL_CAN_USE {
            return self.living.body.random.next_float() < 0.02f32
        }
        if call == GOAL_CONTINUE {
            return g.look_time >= 0
        }
        if call == GOAL_START {
            let turn = 6.283185307179586 * self.living.body.random.next_double()
            g.rel_x = cos(turn)
            g.rel_z = sin(turn)
            g.look_time = 20 + self.living.body.random.next_int_below(20)
        } else if call == GOAL_TICK {
            g.look_time -= 1
            let eyes = self.living.body.y + f64(self.living.body.eyes)
            self.look.set_look_at(self.living.body.x + g.rel_x, eyes, self.living.body.z + g.rel_z, HEAD_ROT_SPEED, self.max_head_x_rot())
        }
        return false
    }

    // `LookAtPlayerGoal`: used as often as it's likely, drawn, toward the nearest player its
    // targeting finds, but one riding it, `EntitySelector.notRiding` (CAL-179), for 40 to 79
    // ticks, drawn, as goals that don't tick every tick count them; going on while the player's
    // alive and within its distance; looking at the player's eyes.
    fn look_at_goal<B: CollisionBlocks>(mut self, g: mut LookAtPlayer, call: i32, f: Facts, m: MovementStates, blocks: B, all_players: List<Follower>) -> bool {
        // One that looks at guardians or at any mob looks among the mobs its level found near it
        // (CAL-200).
        let players = if g.of != LOOK_PLAYERS { self.prey.copy() } else { all_players.copy() }
        if call == GOAL_CAN_USE {
            if self.living.body.random.next_float() >= g.probability {
                return false
            }
            let who = self.looker()
            let eyes = who.eye_y
            var seen = List<Follower>()
            if g.of != LOOK_PLAYERS {
                // `getEntitiesOfClass(Guardian.class, ...)` or `Mob.class`'s: guardians and
                // elders, or any mobs, whose boxes meet its own grown by the distance across and 3
                // up and down.
                let r = f64(g.distance)
                let area = self.living.body.bounding_box().inflate(r, 3.0, r)
                for p in players {
                    let b = p.bounds else continue
                    if (g.of == LOOK_MOBS or p.species == GUARDIAN or p.species == ELDER_GUARDIAN) and b.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                        seen.push(p.copy())
                    }
                }
            } else {
                for p in players {
                    if self.player_rider == none or p.uuid != self.player_rider {
                        seen.push(p.copy())
                    }
                }
            }
            g.look_at = nearest_player(m, f, blocks, mut self.sensing, who, seen, f64(g.distance), eyes, true, 0u32)
            return g.look_at != none
        }
        if call == GOAL_CONTINUE {
            let id = g.look_at else return false
            let at = player_at(players, id) else return false
            let p = players[at].copy()
            if p.dead {
                return false
            }
            let dx = p.x - self.living.body.x
            let dy = p.y - self.living.body.y
            let dz = p.z - self.living.body.z
            if dx * dx + dy * dy + dz * dz > f64(g.distance * g.distance) {
                return false
            }
            return g.look_time > 0
        }
        if call == GOAL_START {
            g.look_time = reduced_tick_delay(40 + self.living.body.random.next_int_below(40))
        } else if call == GOAL_STOP {
            g.look_at = none
        } else if call == GOAL_TICK {
            let id = g.look_at else return false
            let at = player_at(players, id) else return false
            let p = players[at].copy()
            if not p.dead {
                // Level with its own eyes where it looks only across, `onlyHorizontal`, a shulker's
                // (CAL-200).
                let y = if g.horizontal { self.living.body.y + f64(self.living.body.eyes) } else { p.y + f64(p.eyes) }
                self.look.set_look_at(p.x, y, p.z, HEAD_ROT_SPEED, self.max_head_x_rot())
                g.look_time -= 1
            }
        }
        return false
    }

    // `WaterAvoidingRandomStrollGoal`: where it hasn't done nothing for 100 ticks, used 1 in
    // `interval` of its full ticks, drawn, with a place to go; going on till its navigation's done,
    // where it's gone, and its navigation stopped as it stops. A silverfish's,
    // `SilverfishMergeWithStoneGoal` (CAL-172), first not with a target or on its way; then, where
    // mob griefing's on, 1 in 5, drawn, a way drawn, and the block that way from the one half a
    // block above its feet a host, it's to go into it, which it does as it starts, `Merged`, its
    // spawn's look shown, entity event 20, `spawnAnim`, and gone, `discard`, and it goes on no
    // more; else it strolls.
    fn stroll_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Stroll, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) -> bool {
        if g.merge and call == GOAL_CAN_USE {
            if self.target != none or not self.navigation.is_done() {
                return false
            }
            if self.mob_griefing and self.living.body.random.next_int_below(reduced_tick_delay(10)) == 0 {
                g.merge_way = self.living.body.random.next_int_below(6)
                let (x, y, z) = self.merge_place(g.merge_way)
                if lf.infested.is_host(f, state_at(blocks, x, y, z)) {
                    g.merging = true
                    return true
                }
            }
            g.merging = false
        }
        if g.merge and g.merging {
            if call == GOAL_CONTINUE {
                return false
            }
            if call == GOAL_START {
                let (x, y, z) = self.merge_place(g.merge_way)
                if lf.infested.is_host(f, state_at(blocks, x, y, z)) {
                    self.living.show(Shown.Merged((x, y, z)), heard)
                    self.living.show(Shown.Event(20i8), heard)
                    self.living.body.removed = true
                }
                return false
            }
        }
        if call == GOAL_CAN_USE {
            // A fish's, `FishSwimGoal`, not while it follows a leader, `canRandomSwim` (CAL-178).
            if g.swim and self.follows_leader() {
                return false
            }
            // Not while a mob steers it, `hasControllingPassenger` (D710).
            if self.controlled {
                return false
            }
            // A turtle's, `TurtleRandomStrollGoal`, not in water, going home or with an egg
            // (CAL-201).
            if g.turtle and (self.living.body.in_water or self.turtle.going_home or self.turtle_has_egg()) {
                return false
            }
            // `MoveBackToVillageGoal`'s not in a village, `isVillage` (CAL-201).
            if g.village == STROLL_BACK_TO_VILLAGE and self.in_village() {
                return false
            }
            if not g.force {
                if g.check_no_action and self.no_action_time >= 100 {
                    return false
                }
                if self.living.body.random.next_int_below(reduced_tick_delay(g.interval)) != 0 {
                    return false
                }
            }
            let at = self.stroll_position(g, lf, f, blocks, mut cache, min_y) else return false
            let (x, y, z) = at
            g.wanted_x = x
            g.wanted_y = y
            g.wanted_z = z
            g.force = false
            return true
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.wanted_x, g.wanted_y, g.wanted_z, g.speed)
        } else if call == GOAL_STOP {
            self.navigation.stop()
        }
        return false
    }

    // `GuardianAttackGoal` (CAL-200), whose ticks into its attack are `g`: used with a target
    // that's alive, going on while it is and, but for an elder's, more than 3 from it. As it
    // starts, its attack 10 ticks off, its path stopped, looking at their eyes, 90 degrees a tick,
    // synced. Each tick, its path stopped and looking at them; where it can't see them, from its
    // eyes to theirs, `hasLineOfSight`, they're let go; else at its attack's start its beam's on
    // them, `setActiveAttackTarget`, and shown, entity event 21, where it isn't silent; and once
    // its attack's lasted 80 ticks, an elder's 60, its beam's end on them, `Shown.Beamed`, 1, 3
    // on hard and 2 more for an elder, then its attack, and they're let go. As it stops, its beam's
    // off, its target let go and its stroll told to go next time, `trigger`.
    fn guardian_attack_goal<B: CollisionBlocks>(mut self, g: mut i32, call: i32, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, heard: usize) -> bool {
        let elder = self.species == ELDER_GUARDIAN
        if call == GOAL_CAN_USE {
            let p = self.target_in(players) else return false
            return not p.dead
        }
        if call == GOAL_CONTINUE {
            let p = self.target_in(players) else return false
            if p.dead {
                return false
            }
            return elder or self.distance_sqr_to(p.x, p.y, p.z) > 9.0
        }
        if call == GOAL_START {
            g = -10
            self.navigation.stop()
            if let p = self.target_in(players) {
                self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 90.0f32, 90.0f32)
            }
            self.living.body.needs_sync = true
        } else if call == GOAL_STOP {
            self.living.data.set(MONSTER_OWN + 1, Value.Number(0))
            self.target_to(none)
            self.goals.trigger_strolls()
        } else if call == GOAL_TICK {
            let p = self.target_in(players) else return false
            self.navigation.stop()
            self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 90.0f32, 90.0f32)
            let mover = self.living.body.mover()
            let eye_y = self.living.body.y + f64(self.living.body.eyes)
            if not sees(m, f, blocks, mover, self.living.body.x, eye_y, self.living.body.z, p.x, p.y + f64(p.eyes), p.z) {
                self.target_to(none)
                return false
            }
            g += 1
            if g == 0 {
                self.living.data.set(MONSTER_OWN + 1, Value.Number(p.id))
                if not self.living.silent() {
                    self.living.show(Shown.Event(21i8), heard)
                }
            } else if g >= (if elder { 60 } else { 80 }) {
                var damage = 1.0f32
                if self.difficulty == 3 {
                    damage += 2.0f32
                }
                if elder {
                    damage += 2.0f32
                }
                let (ax, ay, az) = (self.living.body.x, self.living.body.y, self.living.body.z)
                self.living.show(Shown.Beamed((p.id, damage, ax, ay, az)), heard)
                self.target_to(none)
            }
        }
        return false
    }

    // `MoveTowardsRestrictionGoal` (CAL-200): used where it's out of its home, to a place
    // `DefaultRandomPos.getPosTowards` finds toward its home's bottom middle, up to 16 across and
    // 7 up or down, within a right angle either side; going on while its path isn't done; going
    // there as it starts.
    fn restrict_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Restrict, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.within_home(self.living.body.x, self.living.body.y, self.living.body.z) {
                return false
            }
            let ((hx, hy, hz), _) = self.home else return false
            let dir = (f64(hx) + 0.5 - self.living.body.x, f64(hz) + 0.5 - self.living.body.z)
            _ = hy
            let at = self.place_towards(16, 7, dir, lf, f, blocks, mut cache, min_y) else return false
            let (x, y, z) = at
            g.wanted_x = x
            g.wanted_y = y
            g.wanted_z = z
            return true
        }
        if call == GOAL_CONTINUE {
            return not self.navigation.is_done()
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.wanted_x, g.wanted_y, g.wanted_z, g.speed)
        }
        return false
    }

    // `MoveTowardsTargetGoal` (CAL-201): used with a target within `within`, to a place
    // `DefaultRandomPos.getPosTowards` finds toward it, up to 16 across and 7 up or down within a
    // right angle either side, that target kept; going on while its path isn't done and that
    // target's alive and within `within`; going there as it starts; that target let go as it
    // stops.
    fn towards_goal<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: mut Towards, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        let within = f64(g.within * g.within)
        if call == GOAL_CAN_USE {
            g.target = self.target
            let id = self.target else return false
            let p = self.followed(players, id) else return false
            if self.distance_sqr_to(p.x, p.y, p.z) > within {
                return false
            }
            let dir = (p.x - self.living.body.x, p.z - self.living.body.z)
            let at = self.place_towards(16, 7, dir, lf, f, blocks, mut cache, min_y) else return false
            let (x, y, z) = at
            g.wanted_x = x
            g.wanted_y = y
            g.wanted_z = z
            return true
        }
        if call == GOAL_CONTINUE {
            if self.navigation.is_done() {
                return false
            }
            let id = g.target else return false
            let p = self.followed(players, id) else return false
            return not p.dead and self.distance_sqr_to(p.x, p.y, p.z) < within
        }
        if call == GOAL_START {
            _ = self.move_to(lf, f, m, blocks, mut cache, min_y, g.wanted_x, g.wanted_y, g.wanted_z, g.speed)
        } else if call == GOAL_STOP {
            g.target = none
        }
        return false
    }

    // `OfferFlowerGoal` (CAL-201): used where it's bright outside, 1 in 8,000, drawn, and a
    // villager, `#candidate_for_iron_golem_gift`, is within 6 of its feet and its box grown by 6
    // across and 2 up or down, the nearest of those, the first as near, `getNearestEntity`; going
    // on for 200 of its full ticks, `adjustedTickDelay(400)`, looking at the villager's eyes, 30
    // degrees a tick. As it starts it offers a flower, entity event 11, and as it stops takes it
    // back, 34; copper golems, which take the flower, Calcite hasn't yet.
    fn flower_goal<B: CollisionBlocks + MobLight>(mut self, g: mut Flower, call: i32, blocks: B, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            if not blocks.bright_outside() or self.living.body.random.next_int_below(8000) != 0 {
                return false
            }
            let b = self.living.body.bounding_box()
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            var best = f64.INFINITY
            g.entity = none
            for p in self.prey {
                if p.species != VILLAGER or p.dead {
                    continue
                }
                let pb = p.bounds ?? b
                if not pb.intersects(b.min_x - 6.0, b.min_y - 2.0, b.min_z - 6.0, b.max_x + 6.0, b.max_y + 2.0, b.max_z + 6.0) {
                    continue
                }
                let d = (p.x - x) * (p.x - x) + (p.y - y) * (p.y - y) + (p.z - z) * (p.z - z)
                if d > 36.0 {
                    continue
                }
                if d < best {
                    best = d
                    g.entity = some(p.id)
                }
            }
            return g.entity != none
        }
        if call == GOAL_CONTINUE {
            return g.tick > 0
        }
        if call == GOAL_START {
            g.tick = reduced_tick_delay(400)
            self.living.show(Shown.Event(11i8), heard)
        } else if call == GOAL_STOP {
            self.living.show(Shown.Event(34i8), heard)
            g.entity = none
        } else if call == GOAL_TICK {
            if let id = g.entity {
                if let at = player_at(self.prey, id) {
                    let p = self.prey[at].copy()
                    self.look.set_look_at(p.x, p.y + f64(p.eyes), p.z, 30.0f32, 30.0f32)
                }
            }
            g.tick -= 1
        }
        return false
    }

    // `DefendVillageTargetGoal` (CAL-201), `found` the player it found: used where, of the
    // villagers and players whose boxes meet its own grown by 10 across and 8 up or down, each it
    // may attack, `TargetingConditions.forCombat().range(64)`, seen, a player some villager's
    // reputation of is -100 or less, the last such, isn't a spectator nor in creative. Its target
    // set as it starts; then `TargetGoal`'s going on and stop.
    fn defend_goal<B: CollisionBlocks + MobLight>(mut self, found: mut i32?, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> bool {
        if call == GOAL_CAN_USE {
            found = none
            var hated = false
            for v in self.prey {
                if v.species == VILLAGER and not v.grudges.is_empty() {
                    hated = true
                }
            }
            if not hated {
                return false
            }
            let b = self.living.body.bounding_box()
            let (x0, y0, z0, x1, y1, z1) = (b.min_x - 10.0, b.min_y - 8.0, b.min_z - 10.0, b.max_x + 10.0, b.max_y + 8.0, b.max_z + 10.0)
            let me = self.looker()
            var near = List<Follower>()
            for p in players {
                let pb = p.bounds ?? b
                if not pb.intersects(x0, y0, z0, x1, y1, z1) or self.golem_refuses(p) {
                    continue
                }
                if nearest_enemy(m, f, blocks, mut self.sensing, me, [p.copy()], 64.0) != none {
                    near.push(p.copy())
                }
            }
            var spectator = false
            for v in self.prey {
                if v.species != VILLAGER or v.dead {
                    continue
                }
                let vb = v.bounds ?? b
                if not vb.intersects(x0, y0, z0, x1, y1, z1) {
                    continue
                }
                if nearest_enemy(m, f, blocks, mut self.sensing, me, [v.copy()], 64.0) == none {
                    continue
                }
                for p in near {
                    if let u = p.uuid {
                        if v.grudges.contains(u) {
                            found = some(p.id)
                            spectator = p.spectator or p.creative
                        }
                    }
                }
            }
            return found != none and not spectator
        }
        if call == GOAL_CONTINUE {
            var t = Targeting { must_see: true, target_mob: self.target }
            return self.targeting_continues(mut t, lf, f, m, blocks, players)
        }
        if call == GOAL_START {
            self.set_target(found, players)
        } else if call == GOAL_STOP {
            self.target_to(none)
        }
        return false
    }

    /// Whether it's an iron golem that may not attack `p`, `IronGolem.canAttack` (CAL-201): a
    /// creeper, or a player where a player made it.
    pub fn golem_refuses(self, p: Follower) -> bool {
        if self.species == DOLPHIN {
            // A baby dolphin attacks nothing, `Dolphin.canAttack` (CAL-201).
            return self.baby()
        }
        if self.species != IRON_GOLEM {
            return false
        }
        return if p.mob { p.species == CREEPER } else { self.player_created() }
    }

    /// Whether a player made it, an iron golem's `isPlayerCreated` (CAL-201).
    pub fn player_created(self) -> bool {
        return self.species == IRON_GOLEM and i32(self.living.data.byte(MONSTER_OWN)) & 1 != 0
    }

    /// An iron golem made by a player or not, `setPlayerCreated` (CAL-201).
    pub fn set_player_created(mut self, made: bool) {
        self.living.data.set(MONSTER_OWN, Value.Byte(if made { 1i8 } else { 0i8 }))
    }

    // An iron golem's strolls' places (CAL-201): `MoveBackToVillageGoal`'s, where of the sections
    // within 2 of its own those nearer a village, the nearest, the first as near,
    // `findSectionClosestToVillage`, toward that section's middle's bottom, as
    // `DefaultRandomPos.getPosTowards` finds, up to 10 across and 7 up or down within a right
    // angle either side; none where none's nearer. `GolemRandomStrollInVillageGoal`'s, by the
    // level's random: 3 in 10 anywhere, `LandRandomPos.getPos` up to 10 across and 7 up or down;
    // else 7 in 10 toward a villager within 32 who wants a golem, any of them, then a point of
    // interest in a village, or the other way about; anywhere where neither's found, each toward
    // as `LandRandomPos.getPosTowards` finds, up to 10 across and 7 up or down.
    fn village_stroll_position<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: Stroll, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let (bx, by, bz) = self.block_position()
        let (sx, sy, sz) = (bx >> 4, by >> 4, bz >> 4)
        if g.village == STROLL_BACK_TO_VILLAGE {
            var pois = self.pois.take() ?? Pois.new(0, 0)
            let here = pois.sections_to_village(sx, sy, sz)
            var best = here
            var to: (i32, i32, i32)? = none
            for dx in -2..3 {
                for dy in -2..3 {
                    for dz in -2..3 {
                        let d = pois.sections_to_village(sx + dx, sy + dy, sz + dz)
                        if d < best {
                            best = d
                            to = some((sx + dx, sy + dy, sz + dz))
                        }
                    }
                }
            }
            self.pois = some(pois)
            let s = to else return none
            let (tx, _, tz) = s
            let dir = (f64((tx << 4) + 8) + 0.5 - self.living.body.x, f64((tz << 4) + 8) + 0.5 - self.living.body.z)
            return self.place_towards(10, 7, dir, lf, f, blocks, mut cache, min_y)
        }
        var random = self.level_random.take() ?? TapedRandom.new(0)
        let anywhere = random.next_float() < 0.3f32
        var target: (f64, f64, f64)? = none
        if not anywhere {
            let villagers_first = random.next_float() < 0.7f32
            var towards = if villagers_first { self.golem_villager(mut random) } else { self.golem_poi(sx, sy, sz, mut random) }
            if towards == none {
                towards = if villagers_first { self.golem_poi(sx, sy, sz, mut random) } else { self.golem_villager(mut random) }
            }
            self.level_random = some(random)
            if let to = towards {
                let (tx, ty, tz) = to
                _ = ty
                let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
                let costs = self.own_maluses()
                let tries = away_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, 0.0, 10.0, 7, (tx - self.living.body.x, tz - self.living.body.z))
                target = self.best_place(lf, f, blocks, tries)
                if target != none {
                    return target
                }
            }
        } else {
            self.level_random = some(random)
        }
        return self.random_place(true, 10, 7, lf, f, blocks, mut cache, min_y)
    }

    // `getPositionTowardsVillagerWhoWantsGolem` (CAL-201): of the villagers whose boxes meet its
    // own grown by 32 who want a golem, any, by `random`, the level's; none where there are none.
    fn golem_villager(self, random: mut TapedRandom) -> (f64, f64, f64)? {
        let b = self.living.body.bounding_box()
        var wanting = List<Follower>()
        for p in self.prey {
            if p.species != VILLAGER or not p.wants_golem {
                continue
            }
            let pb = p.bounds ?? b
            if pb.intersects(b.min_x - 32.0, b.min_y - 32.0, b.min_z - 32.0, b.max_x + 32.0, b.max_y + 32.0, b.max_z + 32.0) {
                wanting.push(p.copy())
            }
        }
        if wanting.is_empty() {
            return none
        }
        let v = wanting[usize.wrap(random.next_int_below(i32.wrap(wanting.len())))].copy()
        return some((v.x, v.y, v.z))
    }

    // `getPositionTowardsPoi` (CAL-201): of the sections within 2 of its own that are villages'
    // centers, `sectionsToVillage` 0, any, by `random`, the level's; then of the occupied points of
    // interest within 8 of its middle, any, at its bottom's middle; none where there are none.
    fn golem_poi(mut self, sx: i32, sy: i32, sz: i32, random: mut TapedRandom) -> (f64, f64, f64)? {
        var pois = self.pois.take() ?? Pois.new(0, 0)
        var centers = List<(i32, i32, i32)>()
        for dx in -2..3 {
            for dy in -2..3 {
                for dz in -2..3 {
                    if pois.sections_to_village(sx + dx, sy + dy, sz + dz) == 0 {
                        centers.push((sx + dx, sy + dy, sz + dz))
                    }
                }
            }
        }
        if centers.is_empty() {
            self.pois = some(pois)
            return none
        }
        let (cx, cy, cz) = centers[usize.wrap(random.next_int_below(i32.wrap(centers.len())))]
        let occupied = pois.in_range(types_of(0xFFFFFFFFu32), BlockPos { x: (cx << 4) + 8, y: (cy << 4) + 8, z: (cz << 4) + 8 }, 8, Occupancy.IsOccupied)
        self.pois = some(pois)
        if occupied.is_empty() {
            return none
        }
        let p = occupied[usize.wrap(random.next_int_below(i32.wrap(occupied.len())))].pos
        return some((f64(p.x) + 0.5, f64(p.y), f64(p.z) + 0.5))
    }

    // `getPosition`: in water, a place on land up to 15 across, else any up to 10; out of it, a
    // place on land up to 10 but where 1 in 1,000, drawn, any; any for a stroll that doesn't avoid
    // water. Each 7 up or down at most.
    fn stroll_position<B: CollisionBlocks + MobLight + NavLevel>(mut self, g: Stroll, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        if g.parrot {
            return self.parrot_wander_place(g, lf, f, blocks, mut cache, min_y)
        }
        if g.flying {
            return self.flying_place(lf, f, blocks, mut cache, min_y)
        }
        if g.village != 0 {
            return self.village_stroll_position(g, lf, f, blocks, mut cache, min_y)
        }
        if g.swim {
            return self.swimmable_place(lf, f, blocks, mut cache, min_y)
        }
        if g.water_avoiding {
            if self.living.body.in_water {
                if let p = self.random_place(true, 15, 7, lf, f, blocks, mut cache, min_y) {
                    return some(p)
                }
                return self.random_place(false, 10, 7, lf, f, blocks, mut cache, min_y)
            }
            if self.living.body.random.next_float() >= g.probability {
                return self.random_place(true, 10, 7, lf, f, blocks, mut cache, min_y)
            }
        }
        return self.random_place(false, 10, 7, lf, f, blocks, mut cache, min_y)
    }

    // `BehaviorUtils.getRandomSwimmablePos(mob, 10, 7)` (CAL-178): a place `DefaultRandomPos.getPos`
    // finds up to 10 across and 7 up or down, found again up to 10 times more while it's one water
    // can't path through, `isPathfindable` for `WATER`, and that last as it is.
    fn swimmable_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        var at = self.random_place(false, 10, 7, lf, f, blocks, mut cache, min_y)
        var count = 0
        loop {
            let p = at else return none
            let (x, y, z) = p
            if lf.paths.pathfindable(state_at(blocks, floor_of(x), floor_of(y), floor_of(z)), COMPUTATION_WATER) or count >= 10 {
                return at
            }
            count += 1
            at = self.random_place(false, 10, 7, lf, f, blocks, mut cache, min_y)
        }
    }

    // `LandRandomPos.getPos` where `land`, else `DefaultRandomPos.getPos`, up to `h` across and `v`
    // up or down: of the 10 places tried, the one of the highest walk target value, the first of
    // those as high, at its bottom's middle, `generateRandomPos`.
    fn random_place<B: CollisionBlocks + MobLight + NavLevel>(mut self, land: bool, h: i32, v: i32, lf: LivingFacts, f: Facts, blocks: B, cache: mut PathTypeCache, min_y: i32) -> (f64, f64, f64)? {
        let w = Wander { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, min_y: min_y, top_y: blocks.top_y(), home: self.home, amphibious: self.navigation.amphibious, swimming: self.navigation.swimming, in_water_only: self.turtle_travels() }
        let costs = self.own_maluses()
        let tries = if land { land_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, h, v) } else { default_tries(mut self.living.body.random, f, lf.paths, blocks, mut cache, costs, w, h, v) }
        return self.best_place(lf, f, blocks, tries)
    }

    // Of the places `tries`, the one of the highest walk target value, the first of those as
    // high, at its bottom's middle, `generateRandomPos`; none where none was found.
    fn best_place<B: CollisionBlocks + MobLight>(self, lf: LivingFacts, f: Facts, blocks: B, tries: List<(i32, i32, i32)?>) -> (f64, f64, f64)? {
        var best = f64.NEG_INFINITY
        var found: (i32, i32, i32)? = none
        for t in tries {
            if let p = t {
                let (x, y, z) = p
                let value = f64(self.walk_target_value(lf, f, blocks, x, y, z))
                if value > best {
                    best = value
                    found = some((x, y, z))
                }
            }
        }
        let q = found else return none
        let (x, y, z) = q
        return some((f64(x) + 0.5, f64(y), f64(z) + 0.5))
    }

    // `getWalkTargetValue`: an animal's 10 over a grass block, else the light's pathfinding cost,
    // `getPathfindingCostFromLightLevels`, its magic light less a half; a monster's that cost
    // taken away, but a silverfish's 10 over a host of infested blocks (CAL-172); any other's 0.
    fn walk_target_value<B: CollisionBlocks + MobLight>(self, lf: LivingFacts, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> f32 {
        if self.species == SILVERFISH and lf.infested.is_host(f, state_at(blocks, x, y - 1, z)) {
            return 10.0f32
        }
        if self.species == PILLAGER {
            // `Pillager.getWalkTargetValue`: none anywhere (CAL-200).
            return 0.0f32
        }
        if self.species == HOGLIN {
            // `Hoglin.getWalkTargetValue` (CAL-200): -1 nearer than 8 to the repellent it knows of,
            // `isPosNearNearestRepellent`; else 10 over crimson nylium and none elsewhere.
            if let brain = self.brain {
                if let p = brain.block(MEMORY_NEAREST_REPELLENT) {
                    let (dx, dy, dz) = (f64(p.x - x), f64(p.y - y), f64(p.z - z))
                    if dx * dx + dy * dy + dz * dz < 64.0 {
                        return -1.0f32
                    }
                }
            }
            return if f.block(state_at(blocks, x, y - 1, z)) == (f.block_named(String("minecraft:crimson_nylium")) ?? u32.MAX) { 10.0f32 } else { 0.0f32 }
        }
        if self.species == TURTLE {
            // `Turtle.getWalkTargetValue` (CAL-201): 10 in water while it isn't going home, or
            // over sand; else the light's pathfinding cost.
            if not self.turtle.going_home and water_at(f, blocks, x, y, z) {
                return 10.0f32
            }
            if f.in_set(state_at(blocks, x, y - 1, z), lf.sand) {
                return 10.0f32
            }
            return blocks.magic_light(x, y, z) - 0.5f32
        }
        if self.guardian_kind() and water_at(f, blocks, x, y, z) {
            // `Guardian.getWalkTargetValue`: 10 and the light's pathfinding cost in water, else a
            // monster's (CAL-200).
            return 10.0f32 + (blocks.magic_light(x, y, z) - 0.5f32)
        }
        if self.animal {
            if f.block(state_at(blocks, x, y - 1, z)) == lf.grass_block {
                return 10.0f32
            }
            return blocks.magic_light(x, y, z) - 0.5f32
        }
        if self.monster and self.species != ENDERMAN {
            return -(blocks.magic_light(x, y, z) - 0.5f32)
        }
        return 0.0f32
    }

    // `EatBlockGoal`: used 1 in 500, or 25 for a baby, drawn, where it stands in what a sheep eats
    // or on a grass block; shown, entity event 10, its navigation stopped, for 20 ticks; at the
    // second to last, what it stands in eaten, or the grass block turned to dirt, `Grazed`, which
    // mob griefing lets the level do, and it's eaten either way, `ate`.
    fn eat_goal<B: CollisionBlocks>(mut self, g: mut EatBlock, call: i32, lf: LivingFacts, f: Facts, blocks: B, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            let bound = reduced_tick_delay(if self.baby() { 50 } else { 1000 })
            if self.living.body.random.next_int_below(bound) != 0 {
                return false
            }
            let (x, y, z) = self.block_position()
            if f.in_set(state_at(blocks, x, y, z), lf.sheep_food) {
                return true
            }
            return f.block(state_at(blocks, x, y - 1, z)) == lf.grass_block
        }
        if call == GOAL_CONTINUE {
            return g.tick > 0
        }
        if call == GOAL_START {
            g.tick = reduced_tick_delay(40)
            self.living.show(Shown.Event(10), heard)
            self.navigation.stop()
        } else if call == GOAL_STOP {
            g.tick = 0
        } else if call == GOAL_TICK {
            g.tick = if g.tick - 1 > 0 { g.tick - 1 } else { 0 }
            if g.tick == reduced_tick_delay(4) {
                let (x, y, z) = self.block_position()
                if f.in_set(state_at(blocks, x, y, z), lf.sheep_food) {
                    self.living.show(Shown.Grazed(Grazed { x: x, y: y, z: z, whole: true }), heard)
                    self.ate()
                } else if f.block(state_at(blocks, x, y - 1, z)) == lf.grass_block {
                    self.living.show(Shown.Grazed(Grazed { x: x, y: y - 1, z: z, whole: false }), heard)
                    self.ate()
                }
            }
        }
        return false
    }

    // Whether it's in a village, `isVillage`: its section within 1 of a village's center, by the
    // points of interest lent it (CAL-201).
    fn in_village(mut self) -> bool {
        let (bx, by, bz) = self.block_position()
        var pois = self.pois.take() ?? Pois.new(0, 0)
        let here = pois.sections_to_village(bx >> 4, by >> 4, bz >> 4)
        self.pois = some(pois)
        return here <= 1
    }

    // Its block's place, `blockPosition`.
    fn block_position(self) -> (i32, i32, i32) {
        return (floor_of(self.living.body.x), floor_of(self.living.body.y), floor_of(self.living.body.z))
    }

    // The block a silverfish would go into the way `way`, by its 3D data value, from the one half
    // a block above its feet, `BlockPos.containing(...).relative` (CAL-172).
    fn merge_place(self, way: i32) -> (i32, i32, i32) {
        let x = floor_of(self.living.body.x)
        let y = floor_of(self.living.body.y + 0.5)
        let z = floor_of(self.living.body.z)
        if way == 0 {
            return (x, y - 1, z)
        }
        if way == 1 {
            return (x, y + 1, z)
        }
        if way == 2 {
            return (x, y, z - 1)
        }
        if way == 3 {
            return (x, y, z + 1)
        }
        if way == 4 {
            return (x - 1, y, z)
        }
        return (x + 1, y, z)
    }

    // `SilverfishWakeUpFriendsGoal` (CAL-172): used while its count's on, which its hurt starts,
    // `notify_hurt`; each tick, the count down one, and at none, the blocks about where it is
    // looked through, 5 up and down and 10 across, nearest first each way, up before down: each
    // infested block found woken, `Woke`, which its level breaks or makes its host again then and
    // there, its goals' tick stopping for it, `goals_stop`, and going on from it, `wake_at`,
    // where a coin's toss, drawn, ends the look.
    fn wake_friends_goal<B: CollisionBlocks>(mut self, call: i32, lf: LivingFacts, f: Facts, blocks: B, heard: usize) -> bool {
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            return self.look_for_friends > 0
        }
        if call != GOAL_TICK {
            return false
        }
        var dy = 0
        var dx = 0
        var dz = 0
        if let at = self.wake_at.take() {
            if self.living.body.random.next_boolean() {
                return false
            }
            let (ay, ax, az) = at
            dy = ay
            dx = ax
            dz = look_step(az)
        } else {
            self.look_for_friends -= 1
            if self.look_for_friends > 0 {
                return false
            }
        }
        let (bx, by, bz) = self.block_position()
        while dy <= 5 and dy >= -5 {
            while dx <= 10 and dx >= -10 {
                while dz <= 10 and dz >= -10 {
                    let (x, y, z) = (bx + dx, by + dy, bz + dz)
                    if lf.infested.host_of(f, state_at(blocks, x, y, z)) != none {
                        self.living.show(Shown.Woke((x, y, z)), heard)
                        self.wake_at = some((dy, dx, dz))
                        self.goals_stop = true
                        return false
                    }
                    dz = look_step(dz)
                }
                dz = 0
                dx = look_step(dx)
            }
            dx = 0
            dy = look_step(dy)
        }
        return false
    }

    /// `SilverfishWakeUpFriendsGoal.notifyHurt`: its count to looking for its friends started
    /// where it's at none, at 20 ticks halved, as the goal ticks every other one,
    /// `adjustedTickDelay` (CAL-172).
    fn notify_hurt(mut self) {
        if self.look_for_friends == 0 {
            self.look_for_friends = reduced_tick_delay(20)
        }
    }

    /// A sheep's wool gone, `setSheared(true)` (CAL-179).
    pub fn shear_wool(mut self) {
        let wool = i32(self.living.data.byte(OWN))
        self.living.data.set(OWN, Value.Byte(i8.wrap(wool | 16)))
    }

    /// What the item `components`, a spawn egg's, give the mob it spawns, as
    /// `applyComponentsFromItemStack` gives them (CAL-214): its custom name, `Entity`'s
    /// `applyImplicitComponents`. Its custom data, and what a type's own takes, a component of
    /// the type's own, as `wolf/variant`, are told of.
    pub fn take_item_components(mut self, components: JavaHashMap<String, Tag>, missing: mut List<String>) {
        if components.contains("minecraft:custom_name") {
            let name = components["minecraft:custom_name"].copy()
            self.living.body.extras.insert(String("CustomName"), name.copy())
            self.living.data.set(CUSTOM_NAME, Value.Name(name))
        }
        if components.contains("minecraft:custom_data") {
            missing.push(String("A spawned mob's custom data from its item, Entity.customData"))
        }
        for (key, _) in components {
            if key.contains("/") {
                missing.push("A spawned mob's {key} from its item, applyImplicitComponents")
            }
        }
    }

    /// What the fish bucket `components` gives the fish it lets out, as `MobBucketItem.spawn` gives
    /// it after `finalizeSpawn` (CAL-214): its components, `applyComponentsFromItemStack`, its
    /// custom name, a salmon's size and a tropical fish's pattern and colors, each set in turn,
    /// `applyImplicitComponents`; then its `bucket_entity_data`, `loadFromBucketTag`, each of its
    /// having no AI, silence, no gravity, glowing and invulnerability that's there set, staying
    /// where it's so, and its health, clamped; and it's from a bucket, `setFromBucket`. What it'd
    /// take that Calcite doesn't yet, its custom data, is told of.
    pub fn let_out_of_bucket(mut self, lf: LivingFacts, components: JavaHashMap<String, Tag>, missing: mut List<String>) {
        if components.contains("minecraft:custom_name") {
            let name = components["minecraft:custom_name"].copy()
            self.living.body.extras.insert(String("CustomName"), name.copy())
            self.living.data.set(CUSTOM_NAME, Value.Name(name))
        }
        if components.contains("minecraft:custom_data") {
            missing.push(String("A bucketed fish's custom data, Entity.customData"))
        }
        if self.species == SALMON {
            if let Tag.Str(size) = bucket_component(components, "minecraft:salmon/size") {
                self.set_salmon_size(if size == "small" { 0 } else if size == "large" { 2 } else { 1 })
            }
        }
        if self.species == TROPICAL_FISH {
            let (was_pattern, was_base, was_over) = unpack_tropical(self.living.data.number(TROPICAL_VARIANT))
            var pattern = was_pattern
            var base = was_base
            var over = was_over
            if let Tag.Str(named) = bucket_component(components, "minecraft:tropical_fish/pattern") {
                let patterns = tropical_patterns()
                for i in 0..patterns.len() {
                    if named == String(patterns[i]) or named == "minecraft:{patterns[i]}" {
                        pattern = i32.wrap(i)
                    }
                }
            }
            if let Tag.Str(named) = bucket_component(components, "minecraft:tropical_fish/base_color") {
                base = dye_id(named) ?? base
            }
            if let Tag.Str(named) = bucket_component(components, "minecraft:tropical_fish/pattern_color") {
                over = dye_id(named) ?? over
            }
            self.living.data.set(TROPICAL_VARIANT, Value.Number(pack_tropical(pattern, base, over)))
        }
        var data = JavaHashMap<String, Tag>()
        if let Tag.Compound(given) = bucket_component(components, "minecraft:bucket_entity_data") {
            data = given.copy()
        }
        if data.contains("NoAI") {
            self.set_flag(NO_AI_FLAG, bool_or(data, "NoAI"))
        }
        if data.contains("Silent") {
            let silent = bool_or(data, "Silent")
            self.living.data.set(SILENT, Value.Bool(silent))
            if silent {
                self.living.body.extras.insert(String("Silent"), Tag.Byte(1i8))
            } else {
                _ = self.living.body.extras.remove("Silent")
            }
        }
        if data.contains("NoGravity") {
            self.living.body.no_gravity = bool_or(data, "NoGravity")
            self.living.data.set(NO_GRAVITY, Value.Bool(self.living.body.no_gravity))
        }
        if data.contains("Glowing") {
            let glowing = bool_or(data, "Glowing")
            if glowing {
                self.living.body.extras.insert(String("Glowing"), Tag.Byte(1i8))
            } else {
                _ = self.living.body.extras.remove("Glowing")
            }
            self.living.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, glowing or self.living.has_effect(GLOWING))
        }
        if data.contains("Invulnerable") {
            self.living.body.invulnerable = bool_or(data, "Invulnerable")
        }
        if bool_or(data, "PersistenceRequired") {
            self.persistence_required = true
        }
        if data.contains("Health") {
            self.living.set_health(lf, data["Health"].number_float() ?? 0.0f32)
        }
        if self.species == SULFUR_CUBE {
            // `SulfurCube`'s (CAL-402): the block it held, `SULFUR_CUBE_CONTENT`, swallowed as
            // it's made, `applyImplicitComponents`; its age and whether it's locked,
            // `loadFromBucketTag`; and from a bucket, its own value.
            if let Tag.Compound(held) = bucket_component(components, "minecraft:sulfur_cube_content") {
                var one = held.copy()
                one.insert(String("count"), Tag.Int(1))
                self.swallow(Tag.Compound(one))
            }
            self.set_age(if data.contains("age") { data["age"].number_int() ?? 0 } else { 0 })
            self.living.data.set(AGE_LOCKED, Value.Bool(bool_or(data, "age_locked")))
            self.living.data.set(OWN + 2, Value.Bool(true))
            return
        }
        self.living.data.set(FROM_BUCKET, Value.Bool(true))
    }

    /// `Mob.playAmbientSound` as it's let out of a bucket (CAL-214): its ambient sound, where it
    /// has one, at its volume and its voice's pitch, drawn from its own random, `makeSound`.
    pub fn play_ambient(mut self, sounds: mut List<EntitySound>) {
        let held = self.ambient.copy() else return
        let pitch = self.voice_pitch()
        self.living.play(mut sounds, held, self.sound_volume, pitch)
    }

    /// The bucket a fish is taken in, `getBucketItemStack` and `saveDefaultDataToBucketTag`
    /// (CAL-179): a bucket of cod with its custom name, and its entity data, `bucket_entity_data`,
    /// its health and whichever of its having no AI, its silence, no gravity, glowing,
    /// invulnerability and staying it has.
    pub fn bucket_stack(self) -> Tag {
        var data = JavaHashMap<String, Tag>()
        if self.no_ai() {
            data.insert(String("NoAI"), Tag.Byte(1i8))
        }
        if self.living.silent() {
            data.insert(String("Silent"), Tag.Byte(1i8))
        }
        if self.living.body.no_gravity {
            data.insert(String("NoGravity"), Tag.Byte(1i8))
        }
        if bool_or(self.living.body.extras, "Glowing") {
            data.insert(String("Glowing"), Tag.Byte(1i8))
        }
        if self.living.body.invulnerable {
            data.insert(String("Invulnerable"), Tag.Byte(1i8))
        }
        if self.persistence_required {
            data.insert(String("PersistenceRequired"), Tag.Byte(1i8))
        }
        data.insert(String("Health"), Tag.Float(self.living.health()))
        var parts = JavaHashMap<String, Tag>()
        if self.living.body.extras.contains("CustomName") {
            parts.insert(String("minecraft:custom_name"), self.living.body.extras["CustomName"].copy())
        }
        if self.species == SULFUR_CUBE {
            data.insert(String("age"), Tag.Int(self.age))
            data.insert(String("age_locked"), Tag.Byte(if self.living.data.flag(AGE_LOCKED) { 1i8 } else { 0i8 }))
        }
        parts.insert(String("minecraft:bucket_entity_data"), Tag.Compound(data))
        var stack = JavaHashMap<String, Tag>()
        if self.species == SALMON {
            // `Salmon.saveToBucketTag`'s: its size, `SALMON_SIZE` (CAL-201).
            parts.insert(String("minecraft:salmon/size"), Tag.Str(String(salmon_size_name(self.salmon_size()))))
        }
        if self.species == SULFUR_CUBE {
            // `SulfurCube.saveToBucketTag`'s (CAL-402): the block it holds, `SULFUR_CUBE_CONTENT`,
            // as a template, its count left out where it's 1; and its age and whether it's locked.
            if let held = self.living.equipment[BODY_SLOT].copy() {
                parts.insert(String("minecraft:sulfur_cube_content"), template_of(held))
            }
        }
        if self.species == TROPICAL_FISH {
            // `TropicalFish.saveToBucketTag`'s: its pattern and colors (CAL-201).
            let (p, b, o) = unpack_tropical(self.living.data.number(TROPICAL_VARIANT))
            parts.insert(String("minecraft:tropical_fish/pattern"), Tag.Str(tropical_pattern_name(p)))
            parts.insert(String("minecraft:tropical_fish/base_color"), Tag.Str(String(dye_name(b))))
            parts.insert(String("minecraft:tropical_fish/pattern_color"), Tag.Str(String(dye_name(o))))
        }
        stack.insert(String("id"), Tag.Str(String(if self.species == SALMON { "minecraft:salmon_bucket" } else if self.species == TROPICAL_FISH { "minecraft:tropical_fish_bucket" } else if self.species == PUFFERFISH { "minecraft:pufferfish_bucket" } else if self.species == SULFUR_CUBE { "minecraft:sulfur_cube_bucket" } else { "minecraft:cod_bucket" })))
        stack.insert(String("count"), Tag.Int(1))
        stack.insert(String("components"), Tag.Compound(parts))
        return Tag.Compound(stack)
    }

    /// The motion a sheep's sheared wool is given, drawn from its random, `Sheep.shear`'s
    /// `setDeltaMovement`: across by a tenth of the difference of two floats each way, up by a
    /// twentieth of one, in that order (CAL-179).
    pub fn wool_push(mut self) -> (f64, f64, f64) {
        let x0 = self.living.body.random.next_float()
        let x1 = self.living.body.random.next_float()
        let y0 = self.living.body.random.next_float()
        let z0 = self.living.body.random.next_float()
        let z1 = self.living.body.random.next_float()
        return (f64((x0 - x1) * 0.1f32), f64(y0 * 0.05f32), f64((z0 - z1) * 0.1f32))
    }

    // `Sheep.ate`: its wool back, `setSheared(false)`, and a baby a minute older, `ageUp(60)`.
    fn ate(mut self) {
        let wool = i32(self.living.data.byte(OWN))
        self.living.data.set(OWN, Value.Byte(i8.wrap(wool & ~16)))
        if self.baby() {
            self.age_up(60)
        }
    }

    /// A player's use of it with the item `item`, as `minecraft:wheat`, in hand, `Mob.interact`, the
    /// player's UUID `player` (CAL-158). Where it's alive, a farm animal's food, `isFood`, makes a
    /// grown one not in love fall in love for 600 ticks, the player its love's cause, `setInLove`,
    /// shown as entity event 18 after the sounds `heard`, a use the server swings for,
    /// `SUCCESS_SERVER`; or makes a baby that may grow up a tenth of its time older, `ageUp` forced,
    /// A name tag with a name, `name`, its `custom_name`, used on it (CAL-179), `NameTagItem`, which
    /// `Mob.interact` asks first, `checkAndHandleImportantInteractions`: alive, its custom name
    /// that, saved and sent, and it kept, `setPersistenceRequired`, the tag used up, `SUCCESS`;
    /// dying, the tag's still `SUCCESS`, as the player's own use of it after the mob's has it, but
    /// names nothing and isn't used.
    pub fn named_by(mut self, name: Tag) -> Interaction {
        if not self.living.alive() {
            return Interaction { result: INTERACT_SUCCESS, used: false }
        }
        self.living.body.extras.insert(String("CustomName"), name.copy())
        self.living.data.set(CUSTOM_NAME, Value.Name(name.copy()))
        self.persistence_required = true
        return Interaction { result: INTERACT_SUCCESS, used: true }
    }

    /// A player's use of it with the item `item`, as `minecraft:wheat`, in hand, `Mob.interact`, the
    /// player's UUID `player` (CAL-158). Where it's alive, a farm animal's food, `isFood`, makes a
    /// grown one not in love fall in love for 600 ticks, the player its love's cause, `setInLove`,
    /// shown as entity event 18 after the sounds `heard`, a use the server swings for,
    /// `SUCCESS_SERVER`; or makes a baby that may grow up a tenth of its time older, `ageUp` forced,
    /// `SUCCESS`; either uses one of the food. Shears shear a sheep, `shorn`. Leads, buckets,
    /// bowls, saddles, golden dandelions and horses come with CAL-179.
    pub fn interact(mut self, lf: LivingFacts, item: String, nutrition: i32?, player: (i64, i64), user: (f64, f64, f64), heard: usize, main: bool, sneaking: bool) -> Interaction {
        // A tame wolf's owner's dye of its collar's own colour, which does what an animal's use
        // does and never orders it to sit or stand (CAL-201).
        let dyed_same = self.wolf_dyed_same(item.copy(), player)
        if self.species == WOLF and self.living.alive() {
            if let out = self.wolf_interact(lf, item.copy(), nutrition, player, heard) {
                return out
            }
        }
        if self.species == CAT and self.living.alive() {
            if let out = self.cat_interact(lf, item.copy(), nutrition, player, heard) {
                return out
            }
        }
        if self.species == OCELOT and self.living.alive() {
            if let out = self.ocelot_interact(lf, item.copy(), user, heard) {
                return out
            }
        }
        if self.species == PANDA and self.living.alive() {
            if let out = self.panda_interact(lf, item.copy(), player, heard) {
                return out
            }
        }
        if self.species == PARROT and self.living.alive() {
            if let out = self.parrot_interact(lf, item.copy(), player, heard) {
                return out
            }
        }
        if self.species == DOLPHIN and self.living.alive() and lf.tempting.of(item.copy()) & TEMPT_FISHES != 0u32 {
            // `Dolphin.mobInteract` (CAL-201): a fish, `#fishes`, eaten, heard, and used; a baby
            // grows a tenth of what it's still to grow, `ageUp(..., true)`, else it got a fish,
            // `setGotFish`, `SUCCESS`.
            var out = Interaction { result: INTERACT_SUCCESS, used: true }
            self.living.play(mut out.sounds, String("entity.dolphin.eat"), 1.0f32, 1.0f32)
            if self.can_age_up() {
                let ticks = -self.age
                let seconds = i32.saturate(f64(f32.nearest(f64(ticks / 20)) * 0.1f32))
                self.age_up_forced(seconds)
            } else {
                self.living.data.set(GOT_FISH, Value.Bool(true))
            }
            return out
        }
        if self.equine() and self.living.alive() {
            if let out = self.horse_interact(lf, item.copy(), player, heard, sneaking) {
                return out
            }
        }
        if self.species == PIG and self.living.alive() {
            // `Pig.mobInteract` (CAL-179): a saddled one, `isSaddled`, without a rider, used with
            // what isn't its food by a player not sneaking, carries them, `startRiding`, `SUCCESS`.
            let food = self.food_set()
            let fed = food != 0u32 and lf.tempting.of(item.copy()) & food != 0u32
            if not fed and self.living.equipment[7] != none and self.living.body.passengers.is_empty() and not sneaking {
                return Interaction { result: INTERACT_SUCCESS, used: false, rides: true }
            }
        }
        if self.species == IRON_GOLEM {
            // `IronGolem.mobInteract` (CAL-201): an iron ingot heals it 25; where that healed it
            // at all, its repair heard at a pitch drawn, 1 and a fifth of one draw less another,
            // and the ingot used, `SUCCESS`; else, or anything else, `PASS`.
            if item != "minecraft:iron_ingot" {
                return Interaction { result: INTERACT_PASS, used: false }
            }
            let before = self.living.health()
            self.living.heal(lf, 25.0f32)
            if self.living.health() == before {
                return Interaction { result: INTERACT_PASS, used: false }
            }
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            var out = Interaction { result: INTERACT_SUCCESS, used: true }
            self.living.play(mut out.sounds, String("entity.iron_golem.repair"), 1.0f32, 1.0f32 + (a - b) * 0.2f32)
            return out
        }
        if self.species == SNOW_GOLEM and self.living.alive() and item == "minecraft:shears" and self.has_pumpkin() {
            // `SnowGolem.mobInteract` (CAL-201): shears shear one with its pumpkin,
            // `readyForShearing`, `SUCCESS`, its level dropping the pumpkin, `shorn`, and the
            // shears worn by 1; else it does as a mob does.
            return Interaction { result: INTERACT_SUCCESS, used: false, wear: 1, shorn: true }
        }
        if self.species == BOGGED and self.living.alive() and item == "minecraft:shears" and not self.living.data.flag(MONSTER_OWN) {
            // `Bogged.mobInteract` (CAL-200): shears shear one not yet sheared,
            // `readyForShearing`, `SUCCESS`, its level dropping its mushrooms, `shorn`, and the
            // shears worn by 1; one sheared does as a mob does.
            return Interaction { result: INTERACT_SUCCESS, used: false, wear: 1, shorn: true }
        }
        if self.species == SHEEP and self.living.alive() and item == "minecraft:shears" {
            // `Sheep.mobInteract` (CAL-179): shears shear a grown one with its wool,
            // `readyForShearing`, `SUCCESS_SERVER`, its level dropping its wool, `shorn`, and the
            // shears worn by 1; else nothing, `CONSUME`.
            if self.sheared() or self.baby() {
                return Interaction { result: INTERACT_CONSUME, used: false }
            }
            return Interaction { result: INTERACT_SERVER, used: false, wear: 1, shorn: true }
        }
        if self.species == SULFUR_CUBE and self.living.alive() {
            if let out = self.sulfur_interact(lf, item.copy()) {
                return out
            }
        }
        if fish_kind(self.species) and self.living.alive() and item == "minecraft:water_bucket" {
            // `AbstractFish.mobInteract`'s `Bucketable.bucketMobPickup` (CAL-179): a water bucket
            // takes it, `item.bucket.fill_fish` heard from it, filled as `createFilledResult`
            // fills it, a creative player's too, with a bucket of cod of what it keeps,
            // `saveDefaultDataToBucketTag`, and it's gone, `bucketed`, `SUCCESS`.
            var out = Interaction { result: INTERACT_SUCCESS, used: false, bucketed: true }
            self.living.play(mut out.sounds, String("item.bucket.fill_fish"), 1.0f32, 1.0f32)
            out.filled = some((self.bucket_stack(), false))
            return out
        }
        if self.species == MOOSHROOM and self.living.alive() and not self.baby() {
            // `MushroomCow.mobInteract` (CAL-179): a bowl filled with its stew, suspicious stew
            // of the effects it was fed, which it forgets, or mushroom stew, the bowl filled in
            // hand as `createFilledResult` fills it, a creative player's too, and its milking
            // heard, `SUCCESS`. Shears shear it into a cow, `shorn`, which its level does, and are
            // worn by 1, `SUCCESS`. A brown one fed a flower is said to be missing.
            if item == "minecraft:bowl" {
                var out = Interaction { result: INTERACT_SUCCESS, used: false }
                var stew = JavaHashMap<String, Tag>()
                stew.insert(String("count"), Tag.Int(1))
                if let effects = self.kept.remove("stew_effects") {
                    stew.insert(String("id"), Tag.Str(String("minecraft:suspicious_stew")))
                    var parts = JavaHashMap<String, Tag>()
                    parts.insert(String("minecraft:suspicious_stew_effects"), effects)
                    stew.insert(String("components"), Tag.Compound(parts))
                    self.living.play(mut out.sounds, String("entity.mooshroom.suspicious_milk"), 1.0f32, 1.0f32)
                } else {
                    stew.insert(String("id"), Tag.Str(String("minecraft:mushroom_stew")))
                    self.living.play(mut out.sounds, String("entity.mooshroom.milk"), 1.0f32, 1.0f32)
                }
                out.filled = some((Tag.Compound(stew), false))
                return out
            }
            if item == "minecraft:shears" {
                return Interaction { result: INTERACT_SUCCESS, used: false, wear: 1, shorn: true }
            }
            if self.breed_variant() == 1 {
                if let effects = stew_effects_of(item) {
                    // A brown one fed a flower, `getEffectsFromItemStack`: where it has some, two
                    // smoke particles; else the flower used, four of `effect`, white and full,
                    // `SpellParticleOption.create(EFFECT, -1, 1)`, its effects kept, and its
                    // eating heard, loud, `SUCCESS`.
                    let at = (self.living.body.x, self.living.body.y + f64(self.living.body.height) * 0.5, self.living.body.z)
                    if self.kept.contains("stew_effects") {
                        return Interaction { result: INTERACT_SUCCESS, used: false, burst: some((String("minecraft:smoke"), 2, List<u8>())), burst_at: at }
                    }
                    var out = Interaction { result: INTERACT_SUCCESS, used: true, burst: some((String("minecraft:effect"), 4, [255u8, 255u8, 255u8, 255u8, 63u8, 128u8, 0u8, 0u8])), burst_at: at }
                    self.kept.insert(String("stew_effects"), effects)
                    self.living.play(mut out.sounds, String("entity.mooshroom.eat"), 2.0f32, 1.0f32)
                    return out
                }
            }
        }
        if (self.species == COW or self.species == MOOSHROOM) and self.living.alive() and item == "minecraft:bucket" and not self.baby() {
            // `AbstractCow.mobInteract` (CAL-179): a bucket filled with milk, the player's
            // milking heard by all but them, `Player.playSound`, `SUCCESS`.
            var milk = JavaHashMap<String, Tag>()
            milk.insert(String("id"), Tag.Str(String("minecraft:milk_bucket")))
            milk.insert(String("count"), Tag.Int(1))
            return Interaction { result: INTERACT_SUCCESS, used: false, filled: some((Tag.Compound(milk), true)), player_sound: some(String("entity.cow.milk")) }
        }
        if self.species == ZOMBIE_VILLAGER and self.living.alive() and item == "minecraft:golden_apple" {
            // `ZombieVillager.mobInteract` (CAL-175): a golden apple on one weakened uses one and
            // starts its cure, the player its starter, for 3600 to 6000 ticks, drawn,
            // `SUCCESS_SERVER`; on one that isn't, nothing, `CONSUME`.
            if not self.living.has_effect(WEAKNESS) {
                return Interaction { result: INTERACT_CONSUME, used: false }
            }
            var out = Interaction { result: INTERACT_SERVER, used: true }
            let time = self.living.body.random.next_int_below(2401) + 3600
            self.start_curing(lf, some(player), time, true, mut out.sounds)
            return out
        }
        if self.species == VILLAGER and self.living.alive() and item != "minecraft:villager_spawn_egg" and self.trading == none and self.living.sleeping == none {
            // `Villager.mobInteract` (CAL-160): one trading's used as a mob is; a baby made
            // unhappy, `SUCCESS`; a grown one with no offers, which its level made as they were
            // asked for, `offers_asked`, made unhappy where it's the main hand, `CONSUME`; else it
            // trades with the player, `startTrading`, which its level starts, `SUCCESS`; one
            // asleep isn't, as a mob is (CAL-160). A grown one used with the main hand counts the
            // player's `TALKED_TO_VILLAGER`, `talked` (CAL-164).
            var out = Interaction { result: INTERACT_SUCCESS, used: false }
            if self.baby() {
                self.set_unhappy(mut out.sounds)
                return out
            }
            out.talked = main
            if not self.has_offers() {
                if main {
                    self.set_unhappy(mut out.sounds)
                }
                out.result = INTERACT_CONSUME
                return out
            }
            out.trades = true
            return out
        }
        if self.species == ARMADILLO and self.living.alive() {
            // `Armadillo.mobInteract` (CAL-160): a brush brushes a grown one's scute off, rolled
            // up or not, `brushOffScute`, `SUCCESS`: a scute dropped where it is,
            // `brush/armadillo`, as its level drops it, then its brush heard, and the brush worn
            // by 16, `hurtAndBreak`, by the level once it's back among its entities; its game
            // event comes with game events. Else, scared, it's `FAIL`, which does what `PASS`
            // does.
            if item == "minecraft:brush" and not self.baby() {
                var out = Interaction { result: INTERACT_SUCCESS, used: false, wear: 16 }
                out.dropped = some(Laid { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, item: String("minecraft:armadillo_scute"), table: String("minecraft:brush/armadillo") })
                self.living.play(mut out.sounds, String("entity.armadillo.brush"), 1.0f32, 1.0f32)
                return out
            }
            if self.scared() {
                return Interaction { result: INTERACT_PASS, used: false }
            }
        }
        if self.species == PIGLIN and self.living.alive() {
            // `Piglin.mobInteract` (CAL-200): a gold ingot it may admire taken and admired,
            // `SUCCESS`, else `PASS`.
            if self.piglin_interact(item.copy(), heard) {
                return Interaction { result: INTERACT_SUCCESS, used: true }
            }
            return Interaction { result: INTERACT_PASS, used: false }
        }
        let food = self.food_set()
        if not self.living.alive() {
            return Interaction { result: INTERACT_PASS, used: false }
        }
        // A hoglin's kept once what's done takes the use, `Hoglin.mobInteract` (CAL-200).
        let hoglin = self.species == HOGLIN
        if food != 0u32 and lf.tempting.of(item) & food != 0u32 {
            // `canFallInLove`: not in love, a hoglin not pacified (CAL-200), and a turtle with no
            // egg (CAL-201).
            if self.age == 0 and self.in_love <= 0 and not (hoglin and self.pacified()) and not (self.species == TURTLE and self.turtle_has_egg()) {
                self.in_love = 600
                self.kept.insert(String("LoveCause"), uuid_tag(player))
                self.living.show(Shown.Event(18), heard)
                var out = Interaction { result: INTERACT_SERVER, used: true }
                self.eating_sound(mut out.sounds)
                self.persistence_required = self.persistence_required or hoglin
                return out
            }
            if self.can_age_up() {
                let ticks = -self.age
                let seconds = i32.saturate(f64(f32.nearest(f64(ticks / 20)) * 0.1f32))
                self.age_up_forced(seconds)
                self.turtle_grown(heard)
                var out = Interaction { result: INTERACT_SUCCESS, used: true }
                self.eating_sound(mut out.sounds)
                self.persistence_required = self.persistence_required or hoglin
                return out
            }
        }
        let locked = self.age_lock(item)
        // A tame wolf's owner's use that did nothing else orders it to sit or stand (CAL-201).
        if self.species == WOLF and self.is_tame() and self.living.data.uuid(OWN + 1) == some(player) and (locked.result == INTERACT_PASS) and not dyed_same {
            return self.wolf_sit_toggle()
        }
        // A tame cat's owner's use that did nothing else orders it to sit or stand, `SUCCESS`; any
        // other's that did something keeps it (CAL-201).
        if self.species == CAT {
            let consumed = locked.result == INTERACT_SUCCESS or locked.result == INTERACT_SERVER or locked.result == INTERACT_CONSUME
            if self.is_tame() and self.living.data.uuid(OWN + 1) == some(player) {
                if locked.result == INTERACT_PASS {
                    self.wolf.sitting = not self.wolf.sitting
                    return Interaction { result: INTERACT_SUCCESS, used: false, without_item: true }
                }
            } else if consumed {
                self.persistence_required = true
            }
        }
        if hoglin and (locked.result == INTERACT_SUCCESS or locked.result == INTERACT_SERVER or locked.result == INTERACT_CONSUME) {
            self.persistence_required = true
        }
        return locked
    }

    // `SulfurCube.mobInteract` (CAL-402), none where it does as a mob does. A baby fed what it
    // eats, `#sulfur_cube_food`, where it may grow, grows a tenth of what it's still to grow,
    // `ageUp(..., true)`, its eating heard, `SUCCESS`, the food used. A grown one primed does
    // nothing, `PASS`; lit, flint and steel or a fire charge where it may explode, is said to be
    // missing. Shears, where it holds a block, shear it, `shear`, `SUCCESS`, and are worn by 1; a
    // block it swallows, `#sulfur_cube_swallowable`, not the one it holds, is swallowed, the one
    // it held dropped, its absorb heard, `SUCCESS_SERVER`, the block used; a bucket takes it,
    // `Bucketable.bucketMobPickup`, `SUCCESS`.
    fn sulfur_interact(mut self, lf: LivingFacts, item: String) -> Interaction? {
        if self.baby() {
            if lf.tempting.of(item.copy()) & TEMPT_SULFUR_FOOD == 0u32 or not self.can_age_up() {
                return none
            }
            let ticks = -self.age
            let seconds = i32.saturate(f64(f32.nearest(f64(ticks / 20)) * 0.1f32))
            self.age_up_forced(seconds)
            var out = Interaction { result: INTERACT_SUCCESS, used: true }
            self.make_sound(mut out.sounds, "entity.small_sulfur_cube.eat")
            return some(out)
        }
        if self.sulfur.fuse >= 0 {
            return some(Interaction { result: INTERACT_PASS, used: false })
        }
        if self.sulfur_can_explode() and (item == "minecraft:flint_and_steel" or item == "minecraft:fire_charge") {
            // Where TNT doesn't explode, `block.minecraft.tnt.disabled` shown the player, `PASS`;
            // else it's primed, flint and steel worn by 1 and a fire charge used, the player's
            // use of it counted, `SUCCESS_SERVER`.
            if not self.tnt_explodes {
                return some(Interaction { result: INTERACT_PASS, used: false, told: some(String("block.minecraft.tnt.disabled")) })
            }
            var out = Interaction { result: INTERACT_SERVER, used: item == "minecraft:fire_charge", stat_used: true }
            if item == "minecraft:flint_and_steel" {
                out.wear = 1
            }
            _ = self.sulfur_prime(false, mut out.sounds)
            return some(out)
        }
        if item == "minecraft:shears" and self.has_body_item() {
            var out = Interaction { result: INTERACT_SUCCESS, used: false, wear: 1 }
            self.sulfur_shear(mut out)
            return some(out)
        }
        if lf.tempting.of(item.copy()) & TEMPT_SULFUR_SWALLOWABLE != 0u32 {
            var out = Interaction { result: INTERACT_SERVER, used: true, swallowed: true }
            if let held = self.living.equipment[BODY_SLOT].copy() {
                if held_name(some(held.copy())) == item {
                    return some(Interaction { result: INTERACT_PASS, used: false })
                }
                let (bx, by, bz, bh) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.body.height)
                out.ejected = some((bx, by + f64(bh), bz, held))
            }
            self.living.play(mut out.sounds, String("entity.sulfur_cube.absorb"), 1.0f32, 1.0f32)
            return some(out)
        }
        if item == "minecraft:bucket" {
            var out = Interaction { result: INTERACT_SUCCESS, used: false, bucketed: true }
            self.living.play(mut out.sounds, String("item.bucket.fill_sulfur_cube"), 1.0f32, 1.0f32)
            out.filled = some((self.bucket_stack(), false))
            return some(out)
        }
        return none
    }

    // `SulfurCube.tickFuse`, the first of its tick (CAL-402): its fuse counted down; where it
    // holds an explosive block and its fuse is out, it explodes, at a sixteenth of its height up,
    // `getY(0.0625)`, which its level makes, with what its effects do as it goes, and it's gone,
    // `discard`, its tick going on after, as a creeper's does. Whether it exploded. Its leash
    // isn't let go first, `dropLeash`, as leashes on it come with its leashing.
    fn sulfur_fuse_step(mut self, sounds: List<EntitySound>) -> bool {
        if self.sulfur.fuse > 0 {
            self.sulfur.fuse -= 1
        }
        let e = self.sulfur.explosion else return false
        if self.sulfur.fuse != 0 {
            return false
        }
        let b = self.living.body.copy()
        let c = Creep { x: b.x, y: b.y + f64(b.height) * 0.0625, z: b.z, radius: f32.nearest(f64(e.power)), uuid: b.uuid, silent: self.living.data.flag(SILENT), effects: List<Tag>(), fire: e.fire, sulfur: true, portal: b.portal_cooldown > 0 }
        self.living.show(Shown.Exploded(c), sounds.len())
        self.living.body.removed = true
        return true
    }

    // `SulfurCube.canExplode` (CAL-402): it holds an explosive block, it's alive and not primed.
    pub fn sulfur_can_explode(self) -> bool {
        return self.sulfur.explosion != none and self.living.alive() and self.sulfur.fuse < 0
    }

    // `SulfurCube.primeTime` (CAL-402): where it holds an explosive block, it's alive, TNT
    // explodes and it isn't primed, its fuse the block's, or where `imminent`, a short one drawn,
    // `getRandomShortFuse`; it can't be hurt, `setPermanentlyInvulnerable`; its fuse shown,
    // `MAX_FUSE`; and its priming heard as loud as its sounds, its voice's pitch drawn. Whether it
    // was primed.
    pub fn sulfur_prime(mut self, imminent: bool, sounds: mut List<EntitySound>) -> bool {
        let e = self.sulfur.explosion else return false
        if not self.living.alive() or not self.tnt_explodes or self.sulfur.fuse >= 0 {
            return false
        }
        let fuse = if imminent { short_fuse(e.fuse, mut self.living.body.random) } else { e.fuse }
        self.living.body.invulnerable = true
        self.sulfur.fuse = fuse
        self.living.data.set(OWN + 1, Value.Number(fuse))
        self.make_sound(mut sounds, "entity.tnt.primed")
        return true
    }

    // `SulfurCube.shear` (CAL-402): the block it holds taken out and dropped at its passenger
    // place, its top, `getAttachments().getAverage(PASSENGER)`, its eject heard, and its pickup
    // timer 100.
    fn sulfur_shear(mut self, out: mut Interaction) {
        let held = self.living.equipment[BODY_SLOT].take() else return
        let (bx, by, bz, bh) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.body.height)
        out.ejected = some((bx, by + f64(bh), bz, held))
        self.living.play(mut out.sounds, String("entity.sulfur_cube.eject"), 1.0f32, 1.0f32)
        self.sulfur.pickup_timer = 100
    }

    /// `SulfurCube.equipItem` of `stack` by a dispenser (CAL-402): grown, not holding the same,
    /// the block it held to drop at its top, `spawnAtLocation`, which its level drops, then one
    /// of `stack` swallowed and its absorb heard; none where it held nothing.
    pub fn dispenser_swallow(mut self, stack: Tag, sounds: mut List<EntitySound>) -> (f64, f64, f64, Tag)? {
        var out: (f64, f64, f64, Tag)? = none
        if let held = self.living.equipment[BODY_SLOT].copy() {
            out = some((self.living.body.x, self.living.body.y + f64(self.living.body.height), self.living.body.z, held))
        }
        self.swallow(stack)
        self.living.play(mut sounds, String("entity.sulfur_cube.absorb"), 1.0f32, 1.0f32)
        return out
    }

    /// `setItemSlotAndDropWhenKilled` of one of `stack` in its body, a sulfur cube's swallowing
    /// (CAL-402): put in, kept whole as it drops.
    pub fn swallow(mut self, stack: Tag) {
        self.living.equipment[BODY_SLOT] = some(recounted(stack, 1))
        self.guarantee_drop(BODY_SLOT)
    }

    // Whether its brain's pacified, `PACIFIED`, as a repellent makes a hoglin (CAL-200).
    fn pacified(self) -> bool {
        let brain = self.brain else return false
        return brain.has(MEMORY_PACIFIED)
    }

    /// What any player's use of it does first, `Entity.interact`'s overrides (CAL-179): a zombie
    /// horse's kept, `ZombieHorse.interact`'s `setPersistenceRequired`.
    pub fn interacted(mut self) {
        if self.species == ZOMBIE_HORSE {
            self.persistence_required = true
        }
    }

    // A horse's, donkey's or zombie horse's use, `Horse.mobInteract`, `AbstractChestedHorse`'s
    // and `ZombieHorse`'s (CAL-179), alive, with `item` in hand, by a player sneaking where
    // `sneaking`. Where nothing rides it and it isn't a tamed grown one a sneaking player would
    // open, nor, but for a zombie horse, a baby used with a golden dandelion: its food, `isFood`,
    // fed it, `fedFood`; else, untamed, what isn't empty makes it mad, `makeMad`, `SUCCESS`; a
    // tamed donkey without a chest given one is said to be missing. Then
    // `AbstractHorse.mobInteract`: ridden or a baby, an animal's use, none here; a tamed one a
    // sneaking player would open, its inventory, and what's held used on it or put on it, and a
    // player getting on it, `doPlayerRide`, are said to be missing, `SUCCESS`. None where the
    // rest of an animal's use is to go on.
    fn horse_interact(mut self, lf: LivingFacts, item: String, player: (i64, i64), heard: usize, sneaking: bool) -> Interaction? {
        let tamed = self.horse_flag(2)
        let ridden = not self.living.body.passengers.is_empty()
        let opens = not self.baby() and tamed and sneaking
        // `SkeletonHorse.mobInteract` (CAL-349): untamed, `PASS`; tamed, `AbstractHorse`'s.
        if self.species == SKELETON_HORSE {
            if not tamed {
                return some(Interaction { result: INTERACT_PASS, used: false })
            }
            return self.horse_ridden_interact(item, ridden, opens)
        }
        let dandelion = self.species != ZOMBIE_HORSE and self.baby() and item == "minecraft:golden_dandelion"
        if not ridden and not opens and not dandelion and not item.is_empty() {
            let food = if self.species == ZOMBIE_HORSE { TEMPT_ZOMBIE_HORSE } else if self.species == LLAMA { TEMPT_LLAMA_FOOD } else { TEMPT_HORSE_FOOD }
            if lf.tempting.of(item.copy()) & food != 0u32 {
                if self.species == LLAMA {
                    return some(self.llama_fed(lf, item, player, heard))
                }
                return some(self.horse_fed(lf, item, player, heard))
            }
            if not tamed {
                var out = Interaction { result: INTERACT_SUCCESS, used: false }
                self.make_mad(mut out.sounds)
                return some(out)
            }
            if self.chested() and item == "minecraft:chest" and not self.living.data.flag(OWN + 1) {
                // `equipChest`: its chest on, `setChest`, heard at a pitch drawn from its random,
                // `playChestEquipsSound`, the player's chest used, and its slots made,
                // `createInventory`.
                self.living.data.set(OWN + 1, Value.Bool(true))
                var out = Interaction { result: INTERACT_SUCCESS, used: true }
                let a = self.living.body.random.next_float()
                let b = self.living.body.random.next_float()
                self.living.play(mut out.sounds, String(if self.species == LLAMA { "entity.llama.chest" } else { "entity.donkey.chest" }), 1.0f32, (a - b) * 0.2f32 + 1.0f32)
                self.create_inventory()
                return some(out)
            }
        }
        return self.horse_ridden_interact(item, ridden, opens)
    }

    // `AbstractHorse.mobInteract`, after its kind's own (CAL-179): ridden or a baby, an animal's
    // use, none here; a tamed one a sneaking player would open, its inventory, and what's held
    // used on it or put on it, said to be missing, and a player getting on it, `doPlayerRide`,
    // `SUCCESS`.
    fn horse_ridden_interact(mut self, item: String, ridden: bool, opens: bool) -> Interaction? {
        let tamed = self.horse_flag(2)
        if ridden or self.baby() {
            return none
        }
        if opens {
            // `openCustomInventoryScreen`, for its level to open.
            return some(Interaction { result: INTERACT_SUCCESS, used: false, opens_mount: true })
        }
        if not item.is_empty() and tamed {
            return some(Interaction { result: INTERACT_SUCCESS, used: false, missing: some(String("A player's item used on a tamed horse")) })
        }
        // `doPlayerRide`: not eating nor standing, `setEating(false)`, `clearStanding`, and the
        // player turned as it looks and riding it.
        self.set_horse_flag(16, false)
        self.set_horse_flag(32, false)
        self.stand_counter = 0
        return some(Interaction { result: INTERACT_SUCCESS, used: false, rides: true, rides_turned: some((self.living.body.y_rot, self.living.body.x_rot)), rides_view: some((self.living.y_head_rot_o, self.living.x_rot_o)) })
    }

    // `AbstractHorse.fedFood` and `handleEating` of `item` (CAL-179): what each food gives it,
    // health, growth and temper; a golden carrot or apple on a tamed grown one not in love makes
    // it fall in love, the player its cause, `setInLove`, entity event 18 after the sounds
    // `heard`; hurt, it's healed; a baby not locked, the particles its level wouldn't show drawn
    // from its random, `getRandomX`, `getRandomY`, `getRandomZ`, grows, `ageUp`; and, where it ate
    // or isn't tamed, its temper rises toward 100. Where any of that was, it eats, `eating`, its
    // mouth open, `openMouth`, and its eating sound heard, its pitch drawn, where it isn't silent;
    // one of the food used, `SUCCESS_SERVER`; else `PASS`.
    fn horse_fed(mut self, lf: LivingFacts, item: String, player: (i64, i64), heard: usize) -> Interaction {
        let tamed = self.horse_flag(2)
        var used = false
        var heal = 0.0f32
        var age_up = 0
        var temper = 0
        if item == "minecraft:wheat" {
            heal = 2.0f32
            age_up = 20
            temper = 3
        } else if item == "minecraft:sugar" {
            heal = 1.0f32
            age_up = 30
            temper = 3
        } else if item == "minecraft:hay_block" {
            heal = 20.0f32
            age_up = 180
        } else if item == "minecraft:apple" or item == "minecraft:carrot" {
            heal = 3.0f32
            age_up = 60
            temper = 3
        } else if item == "minecraft:red_mushroom" {
            heal = 3.0f32
            temper = 3
        } else if item == "minecraft:golden_carrot" or item == "minecraft:golden_apple" or item == "minecraft:enchanted_golden_apple" {
            let carrot = item == "minecraft:golden_carrot"
            heal = if carrot { 4.0f32 } else { 10.0f32 }
            age_up = if carrot { 60 } else { 240 }
            temper = if carrot { 5 } else { 10 }
            if tamed and self.age == 0 and self.in_love <= 0 {
                used = true
                self.in_love = 600
                self.kept.insert(String("LoveCause"), uuid_tag(player))
                self.living.show(Shown.Event(18), heard)
            }
        }
        if self.living.health() < self.living.max_health(lf) and heal > 0.0f32 {
            self.living.heal(lf, heal)
            used = true
        }
        if self.baby() and age_up > 0 and not self.living.data.flag(AGE_LOCKED) {
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
            _ = self.living.body.random.next_double()
            self.age_up(age_up)
            used = true
        }
        if temper > 0 and (used or not tamed) and self.temper < 100 {
            let t = self.temper + temper
            self.temper = if t > 100 { 100 } else if t < 0 { 0 } else { t }
            used = true
        }
        if not used {
            return Interaction { result: INTERACT_PASS, used: false }
        }
        var out = Interaction { result: INTERACT_SERVER, used: true }
        self.mouth_counter = 1
        self.set_horse_flag(64, true)
        if not self.living.silent() {
            let sound = if self.species == DONKEY { "entity.donkey.eat" } else if self.species == ZOMBIE_HORSE { "entity.zombie_horse.eat" } else if self.baby() { "entity.baby_horse.eat" } else { "entity.horse.eat" }
            let a = self.living.body.random.next_float()
            let b = self.living.body.random.next_float()
            self.living.play(mut out.sounds, String(sound), 1.0f32, 1.0f32 + (a - b) * 0.2f32)
        }
        return out
    }

    // `AgeableMob.mobInteract` (CAL-179), what an animal's use passes on to: a golden dandelion
    // on an ageable baby whose lock's particles are done, `canUseGoldenDandelion`, but a zombie
    // horse's or villager's, `#cannot_be_age_locked`, locks its age or lets it go,
    // `setAgeLockedData`, its age a newborn's again and 40 ticks of the lock's particles to show;
    // the dandelion used, and a baby locked kept, `setPersistenceRequired`; then the lock's sound
    // at its block's middle, from players, `SUCCESS`. Else `PASS`.
    fn age_lock(mut self, item: String) -> Interaction {
        if not self.ageable or item != "minecraft:golden_dandelion" or not self.baby() or self.age_lock_particles != 0 or self.species == ZOMBIE_HORSE or self.species == SKELETON_HORSE or self.species == VILLAGER {
            return Interaction { result: INTERACT_PASS, used: false }
        }
        let locked = not self.living.data.flag(AGE_LOCKED)
        self.living.data.set(AGE_LOCKED, Value.Bool(locked))
        self.set_age(-24000)
        self.age_lock_particles = 40
        if locked {
            self.persistence_required = true
        }
        var out = Interaction { result: INTERACT_SUCCESS, used: true }
        let (bx, by, bz) = (self.living.body.x.floor() + 0.5, self.living.body.y.floor() + 0.5, self.living.body.z.floor() + 0.5)
        out.sounds.push(EntitySound { sound: String(if locked { "item.golden_dandelion.use" } else { "item.golden_dandelion.unuse" }), x: bx, y: by, z: bz, volume: 1.0f32, pitch: 1.0f32, source: 7 })
        return out
    }

    // `Villager.setUnhappy`: unhappy for 40 ticks, and its no heard, `makeSound` (CAL-160).
    fn set_unhappy(mut self, sounds: mut List<EntitySound>) {
        self.living.data.set(OWN, Value.Number(40))
        self.make_sound(mut sounds, "entity.villager.no")
    }

    // `Villager.refreshBrain`: its old brain's behaviors stopped, `stopAll`; then its brain made
    // again as it's made, its sensors put off again by its random, with the memories its old one
    // would save, `pack`, going by its schedule from now, `registerBrainGoals` (CAL-160).
    fn refresh_brain(mut self) {
        let old = self.brain.take() else return
        var stopped = old
        self.stop_all(mut stopped)
        var brain = self.villager_brain()
        brain.unpack(stopped.packed())
        let scheduled = brain.scheduled(self.villager_activity, self.baby_activity)
        brain.update_from_schedule(self.game_time, scheduled)
        self.brain = some(brain)
    }

    // `Villager.makeBrain`'s `BRAIN_PROVIDER` (CAL-160): its sensors, each put off by its own
    // random, and its profession's activities, a baby's or a grown one's, its gates seeded from
    // its own seed; and `registerBrainGoals`' schedule, a baby's or a grown one's.
    fn villager_brain(mut self) -> Brain {
        let baby = self.baby()
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        var b = Brain.made(villager_sensors(), villager_activities(self.brain_seed, profession, baby), mut self.living.body.random)
        b.schedule = if baby { SCHEDULE_BABY } else { SCHEDULE_VILLAGER }
        return b
    }

    /// A villager's brain as `registerBrainGoals` leaves it as it's made at the game time `now`
    /// (CAL-160): its schedule's activity on, `adult` a grown villager's schedule's activity then
    /// and `baby` a baby's.
    pub fn settle_brain(mut self, now: i64, adult: i32, baby: i32) {
        if self.species != VILLAGER {
            return
        }
        var b = self.brain.take() else return
        b.last_schedule = -9999
        let scheduled = b.scheduled(adult, baby)
        b.update_from_schedule(now, scheduled)
        self.brain = some(b)
    }

    // `Brain.stopAll`: each of its behaviors running stopped, `doStop`, in the order it goes over
    // them, durations' draws from the level's random where it's lent.
    fn stop_all(mut self, brain: mut Brain) {
        let lent = self.level_random.take()
        let had = lent != none
        var random = lent ?? TapedRandom.new(0i64)
        var sounds = List<EntitySound>()
        var runs = brain.take_runs()
        for i in 0..runs.len() {
            if runs[i].deed.running {
                self.do_stop(mut brain, mut runs[i].deed, mut random, mut sounds)
            }
        }
        brain.give_back_runs(runs)
        if had {
            self.level_random = some(random)
        }
    }

    // `doStop` of the running behavior `d`: a gate's running behaviors each, and what it forgets
    // as it stops forgotten; a behavior with a duration's `stop`.
    fn do_stop(mut self, brain: mut Brain, d: mut Deed, random: mut TapedRandom, sounds: mut List<EntitySound>) {
        d.running = false
        if let Behavior.Gate(_) = d.kind {
            var g = d.gate.take() else return
            for i in 0..g.entries.len() {
                if g.entries[i].deed.running {
                    self.do_stop(mut brain, mut g.entries[i].deed, mut random, mut sounds)
                }
            }
            for e in g.erases {
                brain.erase(e)
            }
            d.gate = some(g)
            return
        }
        let kind = d.kind
        if timed(kind) {
            self.stop_behavior(mut brain, kind, mut d.keep, mut random, mut sounds)
        }
    }

    // `playEatingSound`, as it's fed: an armadillo's eating, `makeSound`; the others' none.
    fn eating_sound(mut self, sounds: mut List<EntitySound>) {
        if self.species == ARMADILLO {
            self.make_sound(mut sounds, "entity.armadillo.eat")
        } else if self.species == CAT {
            // `Cat.playEatingSound`: its sound variant's, 1 loud at 1 (CAL-201).
            let set = self.variant_sounds()
            self.living.play(mut sounds, set.eat.copy(), 1.0f32, 1.0f32)
        } else if self.species == FOX {
            // `Fox.playEatingSound` (CAL-201).
            self.living.play(mut sounds, String("entity.fox.eat"), 1.0f32, 1.0f32)
        }
    }

    // The set of tempting items its kind eats, `isFood`, by its bit; none for a kind that eats
    // nothing so far.
    fn food_set(self) -> u32 {
        let s = self.species
        if s == COW or s == MOOSHROOM {
            return TEMPT_COW
        }
        if s == PIG {
            return TEMPT_PIG
        }
        if s == SHEEP {
            return TEMPT_SHEEP
        }
        if s == CHICKEN {
            return TEMPT_CHICKEN
        }
        if s == BEE {
            return TEMPT_BEE
        }
        if s == ARMADILLO {
            return TEMPT_ARMADILLO
        }
        if s == HOGLIN {
            return TEMPT_HOGLIN
        }
        if s == WOLF {
            return TEMPT_WOLF_FOOD
        }
        if s == CAT {
            return TEMPT_CAT_FOOD
        }
        if s == OCELOT {
            return TEMPT_OCELOT_FOOD
        }
        if s == RABBIT {
            return TEMPT_RABBIT_FOOD
        }
        if s == FOX {
            return TEMPT_FOX_FOOD
        }
        if s == PANDA {
            return TEMPT_PANDA
        }
        if s == TURTLE {
            return TEMPT_TURTLE
        }
        return 0u32
    }

    // `canAgeUp`: a baby not locked, but never a zombie horse nor a skeleton horse.
    fn can_age_up(self) -> bool {
        return self.baby() and not self.living.data.flag(AGE_LOCKED) and self.species != ZOMBIE_HORSE and self.species != SKELETON_HORSE
    }

    // `AgeableMob.ageUp(seconds, true)`: `seconds` older, up to grown, its forced age the more by
    // what it grew and its particles' 40 ticks begun where they aren't going on, then its forced
    // age where that's grown it.
    fn age_up_forced(mut self, seconds: i32) {
        let before = self.age
        var age = before + seconds * 20
        if age > 0 {
            age = 0
        }
        self.set_age(age)
        self.forced_age += age - before
        if self.forced_age_timer == 0 {
            self.forced_age_timer = 40
        }
        if self.age == 0 {
            let forced = self.forced_age
            self.set_age(forced)
        }
    }

    // `AgeableMob.ageUp(seconds, false)`: `seconds` older, up to grown, then its forced age where
    // that's grown it.
    fn age_up(mut self, seconds: i32) {
        var age = self.age + seconds * 20
        if age > 0 {
            age = 0
        }
        self.set_age(age)
        if self.age == 0 {
            let forced = self.forced_age
            self.set_age(forced)
        }
    }

    // A horse's `RandomStandGoal`: each full tick its count up; once past 0, used where a draw of
    // 1,000 is under the count, its count from minus its ambient interval again, then where it
    // isn't eating or standing 1 in 10, drawn; standing for 20 ticks, `standIfPossible`, its
    // ambient sound played, loud 1 and pitched 1; never going on.
    fn stand_goal(mut self, g: mut Stand, call: i32, sounds: mut List<EntitySound>) -> bool {
        if call == GOAL_CAN_USE {
            g.next += 1
            if g.next > 0 and self.living.body.random.next_int_below(1000) < g.next {
                g.next = -self.ambient_interval
                let immobile = self.horse_flag(16) or self.horse_flag(32)
                return not immobile and self.living.body.random.next_int_below(10) == 0
            }
            return false
        }
        if call == GOAL_START {
            self.set_horse_flag(16, false)
            self.set_horse_flag(32, true)
            self.stand_counter = 20
            let held = self.ambient_now()
            if let sound = held {
                self.living.play(mut sounds, sound, 1.0f32, 1.0f32)
            }
        }
        return false
    }

    /// What it is to a mob that may take it up as its target, or that it hurt, as a player is to
    /// one (CAL-244): its ID, feet, eyes, height and box, `getHitbox`; dead where it isn't alive,
    /// and to be seen as an enemy, `canBeSeenAsEnemy`, where it's alive and not invulnerable; its
    /// UUID; its head's turn and its pitch; its motion across, health, effects, invisibility and
    /// armor's cover, `getArmorCoverPercentage`, for `getVisibilityPercent`; and its species.
    pub fn follower(self) -> Follower {
        var effects = List<i32>()
        for e in self.living.effects {
            effects.push(e.id)
        }
        var worn = 0
        for slot in 2usize..6usize {
            if slot < self.living.equipment.len() and self.living.equipment[slot] != none {
                worn += 1
            }
        }
        let alive = self.living.alive() and not self.living.body.removed
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        let (vx, vz) = (self.living.body.vx, self.living.body.vz)
        let invisible = i32(self.living.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0
        return Follower {
            id: self.living.body.id, x: x, y: y, z: z, eyes: self.living.body.eyes,
            height: self.living.body.height, spectator: false, dead: not alive,
            uuid: some(self.living.body.uuid), enemy: alive and not self.living.body.invulnerable,
            bounds: some(self.living.body.bounding_box()), y_rot: self.living.y_head_rot,
            x_rot: self.living.body.x_rot, vx: vx, vz: vz, health: self.living.health(),
            effects: effects, invisible: invisible, armor_cover: f32.nearest(worn) / 4.0f32,
            mob: true, species: self.species, baby: self.baby(), in_water: self.living.body.in_water,
            color: if self.species == SHEEP { self.color() } else { -1 },
            scared: self.scared(),
            // Whether it sleeps, `isSleeping`, a villager in its bed or a fox (CAL-201); and the
            // living entity it last hurt, `getLastHurtMob`, which a fox defending one it trusts
            // asks of what hurt them.
            sleeping: self.sleeping(),
            hurt_mob: self.last_hurt_mob,
            // A llama's strength, which a wolf fleeing it draws against (CAL-201).
            strength: if self.species == LLAMA { self.llama_strength() } else { 0 },
            width: self.living.body.width, yaw: self.living.body.y_rot,
            grudges: if self.species == VILLAGER { self.gossips.reputed_at_most(-100) } else { List<(i64, i64)>() },
            wants_golem: self.wants_golem(),
            tamed: self.is_tame() or (self.equine() and self.horse_flag(2)),
            owner: if self.is_tame() { self.living.data.uuid(OWN + 1) } else { none },
        }
    }

    // The player or mob `id` among `players` and its prey (CAL-244).
    fn followed(self, players: List<Follower>, id: i32) -> Follower? {
        if let at = player_at(players, id) {
            return some(players[at].copy())
        }
        if let at = player_at(self.prey, id) {
            return some(self.prey[at].copy())
        }
        return none
    }

    // What its targeting is to players: its ID, feet, eyes and collisions, and its type.
    fn looker(self) -> Looker {
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        return Looker { id: self.living.body.id, x: x, y: y, z: z, eye_y: y + f64(self.living.body.eyes), mover: Mover { y: y, fall: self.living.body.fall }, kind: i32.wrap(self.living.kind) }
    }

    // How far x, y, z is from its feet, squared, `distanceToSqr`.
    fn distance_sqr_to(self, x: f64, y: f64, z: f64) -> f64 {
        let dx = self.living.body.x - x
        let dy = self.living.body.y - y
        let dz = self.living.body.z - z
        return dx * dx + dy * dy + dz * dz
    }

    // The mob `id` among those near it this tick, where it's there.
    fn kin_of(self, id: i32) -> Kin? {
        for k in self.kin {
            if k.id == id {
                return some(k)
            }
        }
        return none
    }

    // `getNavigation().moveTo(entity, speedModifier)`, for the entity at `x`, `y`, `z`: as
    // `move_to`, but where no path's found the one it has kept.
    fn move_to_entity<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, x: f64, y: f64, z: f64, speed: f64) -> bool {
        let nf = nav_facts(lf, blocks, min_y)
        let w = self.walker(lf)
        return self.navigation.move_to_entity(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w, x, y, z, speed)
    }

    // `TemptGoal`: past its calm, which each try counts down, used toward the nearest player
    // holding what's in its set in either hand, within its tempt range from its feet, seen or not,
    // and going on while there's one, perhaps another; each full tick looking at the player's eyes,
    // its head turned up to 95 a tick, and going toward them, or stopped within 2.5; calm for 50
    // tries once it stops. One the player may scare off, `canScare`, a cat's (CAL-201), stops going
    // on within 6 of them where they've moved since it kept where they were, or turned more than 5
    // degrees either way since it kept which way they looked; further off it keeps where they are,
    // and it keeps which way they look each time. A cat's, `CatTemptGoal`, is used only while it's
    // wild, isn't scared off by the player it's taken to, and after each tick, with none taken to,
    // takes to its player one in 300 draws, else, or with one, lets them go one in 250.
    fn tempt_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut Tempt, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, players: List<Follower>, min_y: i32) -> bool {
        if call == GOAL_CONTINUE and g.can_scare and not (g.selected != none and g.selected == g.player) and not (self.species == OCELOT and self.ocelot_trusting()) {
            let id = g.player else return false
            let at = player_at(players, id) else return false
            let p = players[at].copy()
            if self.distance_sqr_to(p.x, p.y, p.z) < 36.0 {
                let (dx, dy, dz) = (p.x - g.px, p.y - g.py, p.z - g.pz)
                if dx * dx + dy * dy + dz * dz > 0.010000000000000002 {
                    return false
                }
                if (f64(p.x_rot) - g.rot_x).abs() > 5.0 or (f64(p.y_rot) - g.rot_y).abs() > 5.0 {
                    return false
                }
            } else {
                g.px = p.x
                g.py = p.y
                g.pz = p.z
            }
            g.rot_x = f64(p.x_rot)
            g.rot_y = f64(p.y_rot)
        }
        if call == GOAL_CAN_USE or call == GOAL_CONTINUE {
            if g.calm_down > 0 {
                g.calm_down -= 1
                return false
            }
            let who = self.looker()
            let feet = who.y
            let range = self.living.attributes.value(lf.tempt_range)
            let bit = if g.cube and self.baby() { TEMPT_SULFUR_FOOD } else { g.bit }
            g.player = nearest_player(m, f, blocks, mut self.sensing, who, players, range, feet, false, bit)
            return g.player != none and not (g.cat and self.is_tame())
        }
        if call == GOAL_START {
            if let id = g.player {
                if let at = player_at(players, id) {
                    g.px = players[at].x
                    g.py = players[at].y
                    g.pz = players[at].z
                }
            }
            g.running = true
        } else if call == GOAL_STOP {
            g.player = none
            if g.cube {
                // `SulfurCubeTemptGoal.stopNavigation`: no hops (CAL-402).
                self.moves.set_wanted_movement(0.0)
            } else {
                self.navigation.stop()
            }
            g.calm_down = reduced_tick_delay(100)
            g.running = false
        } else if call == GOAL_TICK {
            let id = g.player else return false
            let at = player_at(players, id) else return false
            let (x, y, z, eyes) = (players[at].x, players[at].y, players[at].z, players[at].eyes)
            self.look.set_look_at(x, y + f64(eyes), z, self.max_head_y_rot() + 20.0f32, self.max_head_x_rot())
            if self.distance_sqr_to(x, y, z) < g.stop * g.stop {
                if g.cube {
                    self.moves.set_wanted_movement(0.0)
                } else {
                    self.navigation.stop()
                }
            } else if g.cube {
                // `SulfurCubeTemptGoal.navigateTowards`: turned to them at once, 10 degrees,
                // `Mob.lookAt`, and its way theirs, hopping after them (CAL-402).
                let p = players[at].copy()
                self.look_at_now(p, 10.0f32, 10.0f32)
                let y_rot = self.living.body.y_rot
                self.moves.set_direction(y_rot, true)
            } else {
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, x, y, z, g.speed)
            }
            if g.cat {
                if g.selected == none and self.living.body.random.next_int_below(reduced_tick_delay(600)) == 0 {
                    g.selected = g.player
                } else if self.living.body.random.next_int_below(reduced_tick_delay(500)) == 0 {
                    g.selected = none
                }
            }
        }
        return false
    }

    // `BreedGoal`: where it's in love, used toward its free partner; going on while the partner's
    // alive and in love, for under 60 of its ticks; each of them looking at the partner's eyes, its
    // head turned up to 10 a tick, going to it, `moveTo`, and from its 30th, within 3 of it,
    // breeding, `breed`; neither with a partner that panics, `isPanicking` (D416).
    fn breed_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut Breed, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, heard: usize) -> bool {
        if call == GOAL_CAN_USE {
            // A turtle's not while it has an egg, `TurtleBreedGoal.canUse` (CAL-201).
            if self.in_love <= 0 or (self.species == TURTLE and self.turtle_has_egg()) {
                return false
            }
            g.partner = self.free_partner()
            return g.partner != none
        }
        if call == GOAL_CONTINUE {
            let id = g.partner else return false
            let k = self.kin_of(id) else return false
            return k.alive and k.in_love and g.love_time < 60 and not k.panicking
        }
        if call == GOAL_START and self.species == FOX {
            // `FoxBreedGoal.start` (CAL-201): its states and its partner's cleared, `Told.Calm`.
            self.fox_clear_states()
            if let p = g.partner {
                self.told.push(Told.Calm(p))
            }
        }
        if call == GOAL_STOP {
            g.partner = none
            g.love_time = 0
        } else if call == GOAL_TICK {
            let id = g.partner else return false
            let k = self.kin_of(id) else return false
            self.look.set_look_at(k.x, k.y + f64(k.eyes), k.z, 10.0f32, self.max_head_x_rot())
            _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, k.x, k.y, k.z, g.speed)
            g.love_time += 1
            if g.love_time >= reduced_tick_delay(60) and self.distance_sqr_to(k.x, k.y, k.z) < 9.0 {
                self.breed(k, heard)
            }
        }
        return false
    }

    // `getFreePartner`: of the mobs of its kind near it, in `getEntitiesOfClass`'s order, whose box
    // meets its own 8 beyond on every side, those alive within 8 of it, `PARTNER_TARGETING`, in
    // love as it is, `canMate`, and not panicking; the nearest, the first of those as near.
    fn free_partner(self) -> i32? {
        let b = self.living.body.bounding_box()
        var best = f64.MAX
        var found: i32? = none
        for k in self.kin {
            if k.species != self.species or not k.alive or not k.in_love or k.panicking {
                continue
            }
            // A wolf's, tame, of a tame one that doesn't sit, `Wolf.canMate` (CAL-201).
            if self.species == WOLF and (not self.is_tame() or not k.tame or k.sitting) {
                continue
            }
            // A cat's, tame, of a tame one, `Cat.canMate` (CAL-201).
            if self.species == CAT and (not self.is_tame() or not k.tame) {
                continue
            }
            if not k.bounds.intersects(b.min_x - 8.0, b.min_y - 8.0, b.min_z - 8.0, b.max_x + 8.0, b.max_y + 8.0, b.max_z + 8.0) {
                continue
            }
            let d = self.distance_sqr_to(k.x, k.y, k.z)
            if d > 64.0 {
                continue
            }
            if d < best {
                best = d
                found = some(k.id)
            }
        }
        return found
    }

    // `spawnChildFromBreeding` with the partner `k`: its baby's variant drawn, `getBreedOffspring`,
    // a cow's, pig's or chicken's either parent's, `nextBoolean`, a mooshroom's the other type 1 in
    // 1,024 where they're the same, else either parent's, and a lamb's its parents' colours, which
    // its level mixes; then `finalizeSpawnChildFromBreeding`: it 6000 ticks from breeding again and
    // out of love, and where mob drops are on, an orb worth 1 to 7, drawn; what its level does of
    // it, `Bred`, shown after the sounds `heard`, which sends its entity event 18 after its
    // `BRED_ANIMALS` and before its orb, as vanilla broadcasts it (CAL-164).
    fn breed(mut self, k: Kin, heard: usize) {
        if self.species == TURTLE {
            self.turtle_bred(k, heard)
            return
        }
        let s = self.species
        var variant = self.breed_variant()
        if s == COW or s == PIG or s == CHICKEN or s == WOLF or s == CAT or s == FOX {
            if not self.living.body.random.next_boolean() {
                variant = k.variant
            }
        } else if s == RABBIT {
            // `Rabbit.getBreedOffspring` (CAL-201): the variant the biome it's in gives, drawn
            // from the level's random, then 19 in 20 a parent's, the partner's or its own, drawn.
            let mine = variant
            if let lent = self.level_random.take() {
                var random = lent
                variant = rabbit_variant_in(self.rabbit.here, mut random)
                self.level_random = some(random)
            }
            if self.living.body.random.next_int_below(20) != 0 {
                variant = if self.living.body.random.next_boolean() { k.variant } else { mine }
            }
        } else if s == MOOSHROOM {
            let mine = variant
            var mutated = false
            if mine == k.variant and self.living.body.random.next_int_below(1024) == 0 {
                variant = 1 - mine
                mutated = true
            }
            if not mutated and not self.living.body.random.next_boolean() {
                variant = k.variant
            }
        }
        // A wolf's baby, `Wolf.getBreedOffspring` (CAL-201): a tame one's its owner's, then its
        // sound variant drawn, `pickRandomSoundVariant`.
        var owner: (i64, i64)? = none
        var sound = -1
        if s == WOLF {
            owner = self.tame_owner()
            var count = 0
            if let sv = self.sounds {
                count = i32.wrap(sv.variants.len())
            }
            if count > 0 {
                sound = self.living.body.random.next_int_below(count)
            }
        }
        // A cat's, `Cat.getBreedOffspring`: a tame one's its owner's, no sound variant drawn.
        if s == CAT {
            owner = self.tame_owner()
        }
        // A fox's baby trusts the player who put it in love, then its partner's, `FoxBreedGoal.breed`
        // (CAL-201).
        var trusted = List<(i64, i64)>()
        if s == FOX {
            let mine = self.love_cause()
            if let c = mine {
                trusted.push(c)
            }
            if let c = k.love_cause {
                if mine != some(c) {
                    trusted.push(c)
                }
            }
        }
        // A panda's baby takes one of its genes, either drawn, and one of its partner's, which the
        // partner draws once this tick's done, `getOneOfGenesRandomly` (CAL-201).
        var panda_gene = -1
        if s == PANDA {
            panda_gene = if self.living.body.random.next_boolean() { self.panda_main() } else { self.panda_hidden() }
            self.told.push(Told.PandaGene(k.id))
        }
        self.set_age(6000)
        self.in_love = 0
        var orb = 0
        if self.mob_drops {
            orb = self.living.body.random.next_int_below(7) + 1
        }
        let (x, y, z, kind) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.kind)
        let collar = self.collar_color()
        self.living.show(Shown.Bred(Bred { partner: k.id, species: s, kind: kind, variant: variant, partner_variant: k.variant, x: x, y: y, z: z, orb: orb, owner: owner, collar: collar, partner_collar: k.collar, sound: sound, trusted: trusted, panda_gene: panda_gene }), heard)
    }

    /// A spawn egg of its own kind used on it, alive (CAL-179), `spawnOffspringFromSpawnEgg`: an
    /// ageable one's baby as `getBreedOffspring` makes it with itself as the partner, a cow's,
    /// pig's, chicken's or fox's variant its own, drawn all the same, `nextBoolean`, a mooshroom's the
    /// other type 1 in 1,024, else its own, drawn, a lamb's its colour mixed with itself by its
    /// level, an armadillo's, bee's and zombie horse's made plain; a zombie's, husk's, drowned's or
    /// zombie villager's a baby of its type, `setBaby`; `Baby`, what its level makes, at its
    /// place. Another kind's can't be a baby, `Unborn`, though its level makes one first and lets
    /// it go. A villager's and a horse's or donkey's come with their breeding, `Missing`.
    pub fn hatch(mut self) -> Hatch {
        let s = self.species
        var variant = self.breed_variant()
        // A fox's kit, `Fox.getBreedOffspring`, its own variant or its partner's, itself, drawn
        // (CAL-311).
        if s == COW or s == PIG or s == CHICKEN or s == FOX {
            _ = self.living.body.random.next_boolean()
        } else if s == MOOSHROOM {
            if self.living.body.random.next_int_below(1024) == 0 {
                variant = 1 - variant
            } else {
                _ = self.living.body.random.next_boolean()
            }
        } else if s == VILLAGER {
            return Hatch.Missing(String("A villager's baby from a spawn egg"))
        } else if s == HORSE or s == DONKEY {
            return Hatch.Missing(String("A horse's or donkey's baby from a spawn egg"))
        } else if not (s == SHEEP or s == ARMADILLO or s == BEE or s == ZOMBIE_HORSE or s == SKELETON_HORSE or s == FOX or zombie_kind(s)) {
            return Hatch.Unborn
        }
        let (x, y, z, kind) = (self.living.body.x, self.living.body.y, self.living.body.z, self.living.kind)
        return Hatch.Baby(Bred { partner: self.living.body.id, species: s, kind: kind, variant: variant, partner_variant: variant, x: x, y: y, z: z, orb: 0 })
    }

    // `FollowParentGoal`: a baby's, used where the nearest grown one of its kind whose box meets its
    // own 8 beyond across and 4 up and down, the last of those as near, is 3 or more away; going on
    // while it's a baby and the parent's alive and 3 to 16 away; finding its path to the parent
    // again every 5 of its ticks, the first as it starts.
    fn follow_parent_goal<B: CollisionBlocks + NavLevel>(mut self, g: mut FollowParent, call: i32, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32) -> bool {
        if call == GOAL_CAN_USE {
            if self.age >= 0 {
                return false
            }
            let b = self.living.body.bounding_box()
            var closest: i32? = none
            var best = f64.MAX
            for k in self.kin {
                if k.species != self.species or k.age < 0 {
                    continue
                }
                if not k.bounds.intersects(b.min_x - 8.0, b.min_y - 4.0, b.min_z - 8.0, b.max_x + 8.0, b.max_y + 4.0, b.max_z + 8.0) {
                    continue
                }
                let d = self.distance_sqr_to(k.x, k.y, k.z)
                if not (d > best) {
                    best = d
                    closest = some(k.id)
                }
            }
            if closest == none or best < 9.0 {
                return false
            }
            g.parent = closest
            return true
        }
        if call == GOAL_CONTINUE {
            if self.age >= 0 {
                return false
            }
            let id = g.parent else return false
            let k = self.kin_of(id) else return false
            if not k.alive {
                return false
            }
            let d = self.distance_sqr_to(k.x, k.y, k.z)
            return not (d < 9.0) and not (d > 256.0)
        }
        if call == GOAL_START {
            g.recalc = 0
        } else if call == GOAL_STOP {
            g.parent = none
        } else if call == GOAL_TICK {
            g.recalc -= 1
            if g.recalc <= 0 {
                g.recalc = reduced_tick_delay(10)
                let id = g.parent else return false
                let k = self.kin_of(id) else return false
                _ = self.move_to_entity(lf, f, m, blocks, mut cache, min_y, k.x, k.y, k.z, g.speed)
            }
        }
        return false
    }

    /// Whether its navigation has a path it hasn't finished, which a block whose shape changes
    /// may make it find again (CAL-157).
    pub fn navigating(self) -> bool {
        return not self.navigation.is_done()
    }

    /// A block the level sent again with its shape changed, as `sendBlockUpdated` tells its
    /// navigation: its path found again where the block's near enough to it and the path's end,
    /// `shouldRecomputePath` (CAL-157).
    pub fn block_changed<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, cache: mut PathTypeCache, min_y: i32, x: i32, y: i32, z: i32) {
        let w = self.walker(lf)
        if self.navigation.should_recompute(w, x, y, z) {
            let nf = nav_facts(lf, blocks, min_y)
            self.navigation.recompute(lf, f, nf, m, blocks, mut cache, mut self.living.body.random, w)
        }
    }

    // What its navigation and move control read of it: its place, box and size, whether it's on
    // the ground, in water or lava and in water it floats in, how far it's fallen, its step
    // height, `maxUpStep`, its speed, its follow range and movement speed, and whether it rides
    // something (D709).
    fn walker(self, lf: LivingFacts) -> Walker {
        // What it steers', where its goals have that one's navigation (D710).
        if self.steered {
            if let s = self.steering {
                return s.walker
            }
        }
        return Walker {
            x: self.living.body.x,
            y: self.living.body.y,
            z: self.living.body.z,
            bounds: self.living.body.bounding_box(),
            width: self.living.body.width,
            height: self.living.body.height,
            eyes: self.living.body.eyes,
            on_ground: self.living.body.on_ground,
            in_liquid: self.living.body.in_water or self.living.body.in_lava(),
            floating: self.living.body.water > 0.0,
            fall: self.living.body.fall,
            step: if self.living.hard_bodied { 0.0f32 } else { f32.nearest(self.living.attributes.value(lf.step_height)) },
            speed: self.living.speed,
            follow_range: self.living.attributes.value(lf.follow_range),
            movement_speed: self.living.attributes.value(lf.movement_speed),
            max_fall: self.max_fall_distance(lf),
            passenger: self.living.body.vehicle != none,
            in_water: self.living.body.in_water,
        }
    }

    // Its own path costs, `getPathfindingMalus`, which its goals' random places read even while
    // it steers what it rides, as none of Calcite's mobs has its riders inherit its own,
    // `shouldPassengersInheritMalus` (D710).
    fn own_maluses(self) -> List<f32> {
        if self.steered {
            if let s = self.steering {
                return s.navigation.maluses.copy()
            }
        }
        return self.navigation.maluses.copy()
    }

    /// What it lends a mob that steers it (D710), `steering`: its navigation, its move control
    /// and what they read of it.
    pub fn steering_of(self, lf: LivingFacts) -> Steering {
        let charge = if self.species == ZOMBIE_HORSE { 1.4f32 } else { 1.0f32 }
        return Steering { navigation: self.navigation.copy(), moves: self.moves, walker: self.walker(lf), charge: charge }
    }

    /// Its navigation and move control as the mob that steered it left them (D710).
    pub fn steered_by(mut self, s: Steering) {
        self.navigation = s.navigation.copy()
        self.moves = s.moves
    }

    /// What it steered this tick, given back, its own navigation and move control its own again
    /// (D710); none where it steers nothing.
    pub fn take_steering(mut self) -> Steering? {
        self.steer(false)
        return self.steering.take()
    }

    // What it steers swapped in for its own navigation and move control where `on`, as its goals
    // use them, and its own back where not (D710).
    fn steer(mut self, on: bool) {
        if self.steered == on {
            return
        }
        let held = self.steering.take() else return
        var s = held
        let navigation = self.navigation.copy()
        let moves = self.moves
        self.navigation = s.navigation.copy()
        self.moves = s.moves
        s.navigation = navigation
        s.moves = moves
        self.steering = some(s)
        self.steered = on
    }

    // `getMaxFallDistance` (CAL-159): 3 without a target; with one, 3 and what of its health it'd
    // give up, what's over a third of its most, less 4 for each step the difficulty's below hard,
    // none below 0; a creeper's, its health less 1, and 3.
    fn max_fall_distance(self, lf: LivingFacts) -> i32 {
        if self.target == none {
            return 3
        }
        let health = self.living.health()
        if self.species == CREEPER {
            return i32.saturate(f64(health - 1.0f32 + 3.0f32).floor())
        }
        var sacrifice = i32.saturate(f64(health - self.living.max_health(lf) * 0.33f32))
        sacrifice -= (3 - self.difficulty) * 4
        if sacrifice < 0 {
            sacrifice = 0
        }
        return i32.saturate(f64(f32.nearest(sacrifice) + 3.0f32).floor())
    }

    // A cube mob's `getSoundPitch`: about 0.8, or 1.4 for a small one, from its own random.
    fn cube_pitch(mut self) -> f32 {
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        let adjust = if self.slime_size() <= 1 { 1.4f32 } else { 0.8f32 }
        return ((a - b) * 0.2f32 + 1.0f32) * adjust
    }

    /// Its hurt and death sounds, `getHurtSound` and `getDeathSound` (D416): its sound variant's,
    /// a baby's where it's one, a mooshroom's a cow's; a sheep's, a horse's, a baby horse's, a
    /// donkey's and a zombie horse's their own; a monster's its kind's; and a slime's, small where
    /// it's tiny, `isTiny`, of size 1 or less.
    pub fn hurt_and_death(self) -> (String, String) {
        let s = self.species
        if s == WITHER_BOSS {
            // `WitherBoss.getHurtSound` and `getDeathSound` (CAL-401).
            return (String("entity.wither.hurt"), String("entity.wither.death"))
        }
        if s == ENDER_DRAGON {
            // `EnderDragon.getHurtSound`, its death sound `LivingEntity`'s (D608).
            return (String("entity.ender_dragon.hurt"), String("entity.generic.death"))
        }
        if s == SULFUR_CUBE {
            // `SulfurCube.getHurtSound` and `getDeathSound` (CAL-402).
            let tiny = self.slime_size() <= 1
            return (String(if tiny { "entity.small_sulfur_cube.hurt" } else { "entity.sulfur_cube.hurt" }), String(if tiny { "entity.small_sulfur_cube.death" } else { "entity.sulfur_cube.death" }))
        }
        if cube_kind(s) {
            let tiny = self.slime_size() <= 1
            let stem = if s == MAGMA_CUBE { "entity.magma_cube" } else { "entity.slime" }
            return (if tiny { "{stem}.hurt_small" } else { "{stem}.hurt" }, if tiny { "{stem}.death_small" } else { "{stem}.death" })
        }
        if s == IRON_GOLEM {
            // `IronGolem.getHurtSound` and `getDeathSound` (CAL-201).
            return (String("entity.iron_golem.hurt"), String("entity.iron_golem.death"))
        }
        if s == SNOW_GOLEM {
            // `SnowGolem.getHurtSound` and `getDeathSound` (CAL-201).
            return (String("entity.snow_golem.hurt"), String("entity.snow_golem.death"))
        }
        if s == SHULKER {
            // `Shulker.getHurtSound`: closed while it's closed (CAL-200).
            return (String(if self.shulker_raw_peek() == 0 { "entity.shulker.hurt_closed" } else { "entity.shulker.hurt" }), String("entity.shulker.death"))
        }
        if s == ARMADILLO {
            // `Armadillo.getHurtSound`: reduced while it's scared (CAL-160).
            return (String(if self.scared() { "entity.armadillo.hurt_reduced" } else { "entity.armadillo.hurt" }), String("entity.armadillo.death"))
        }
        if s == DROWNED {
            // `Drowned.getHurtSound` and `getDeathSound`: their water's in water (CAL-175).
            let water = if self.living.body.in_water { "_water" } else { "" }
            return ("entity.drowned.hurt{water}", "entity.drowned.death{water}")
        }
        if self.guardian_kind() {
            // `Guardian.getHurtSound` and `getDeathSound`, and an elder's: their land's out of
            // water (CAL-200).
            let stem = if s == ELDER_GUARDIAN { "entity.elder_guardian" } else { "entity.guardian" }
            let land = if self.living.body.in_water { "" } else { "_land" }
            return ("{stem}.hurt{land}", "{stem}.death{land}")
        }
        if s == TURTLE {
            // `Turtle.getHurtSound` and `getDeathSound`: a baby's its own (CAL-201).
            let young = if self.baby() { "_baby" } else { "" }
            return ("entity.turtle.hurt{young}", "entity.turtle.death{young}")
        }
        let horse = if self.baby() { "entity.baby_horse" } else { "entity.horse" }
        let stem = if s == VILLAGER { "entity.villager" } else if s == HOGLIN { "entity.hoglin" } else if s == ZOGLIN { "entity.zoglin" } else if s == PIGLIN_BRUTE { "entity.piglin_brute" } else if s == PIGLIN { "entity.piglin" } else if s == BEE { "entity.bee" } else if s == SHEEP { "entity.sheep" } else if s == DONKEY { "entity.donkey" } else if s == ZOMBIE_HORSE { "entity.zombie_horse" } else if s == HORSE { horse } else if s == ZOMBIE { "entity.zombie" } else if s == HUSK { "entity.husk" } else if s == ZOMBIE_VILLAGER { "entity.zombie_villager" } else if s == SKELETON { "entity.skeleton" } else if s == STRAY { "entity.stray" } else if s == BOGGED { "entity.bogged" } else if s == PARCHED { "entity.parched" } else if s == WITHER_SKELETON { "entity.wither_skeleton" } else if s == SPIDER or s == CAVE_SPIDER { "entity.spider" } else if s == PHANTOM { "entity.phantom" } else if s == CREEPER { "entity.creeper" } else if s == ENDERMAN { "entity.enderman" } else if s == WITCH { "entity.witch" } else if s == VINDICATOR { "entity.vindicator" } else if s == PILLAGER { "entity.pillager" } else if s == RAVAGER { "entity.ravager" } else if s == VEX { "entity.vex" } else if s == EVOKER { "entity.evoker" } else if s == BLAZE { "entity.blaze" } else if s == GHAST { "entity.ghast" } else if s == ZOMBIFIED_PIGLIN { "entity.zombified_piglin" } else if s == ENDERMITE { "entity.endermite" } else if s == SILVERFISH { "entity.silverfish" } else if s == COD { "entity.cod" } else if s == SALMON { "entity.salmon" } else if s == TROPICAL_FISH { "entity.tropical_fish" } else if s == PUFFERFISH { "entity.puffer_fish" } else if s == SQUID { "entity.squid" } else if s == GLOW_SQUID { "entity.glow_squid" } else if s == DOLPHIN { "entity.dolphin" } else if s == OCELOT { "entity.ocelot" } else if s == RABBIT { "entity.rabbit" } else if s == POLAR_BEAR { "entity.polar_bear" } else if s == FOX { "entity.fox" } else if s == LLAMA { "entity.llama" } else if s == PANDA { "entity.panda" } else if s == PARROT { "entity.parrot" } else if s == BAT { "entity.bat" } else { "" }
        if stem != "" {
            return ("{stem}.hurt", "{stem}.death")
        }
        var chosen: SoundSet? = none
        if let v = self.sounds {
            chosen = some(v.set_of(self.sound_variant, self.baby()))
        }
        if let set = chosen {
            return (set.hurt.copy(), set.death.copy())
        }
        return (String("entity.cow.hurt"), String("entity.cow.death"))
    }

    // `baseTick` as a mob has it (D424): `Living`'s, hurt as it goes, `hurt_self`: below the
    // level, by 4 of `out_of_world`, `onBelowWorld`; and drowning, by 2 of `drown`, where water
    // breathing, conduit power and the breath of the nautilus don't let it breathe, and the
    // nautilus's keeps its air from coming back but with one of the others, `MobEffectUtil`.
    // And in a wall, by 1 of `in_wall`, before its air (D425). Burning, by 1 of `on_fire` every 20
    // ticks of its fire out of lava, before all (D434). An enderman each hurts teleports then,
    // `hurt_teleport`, as `Enderman.hurtServer` does, before what it draws for its ambient sound
    // (CAL-159).
    fn base_tick<B: CollisionBlocks + NavLevel + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, cache: mut PathTypeCache, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        // `SwingState.tick` (CAL-159): its swing's ticks counted, gone once past its length.
        if self.swing_duration >= 0 {
            let was = self.swing_ticks
            self.swing_ticks += 1
            if was > self.swing_duration {
                self.swing_duration = -1
            }
        }
        // `LivingEntity.baseTick`'s first: on its first tick, where it was saved asleep, put on its
        // bed, `setPosToBed`, or got up where that's no bed (CAL-160).
        if self.living.body.first_tick {
            if let at = self.living.sleeping {
                let (bx, by, bz) = at
                match bed_sleep_height(f, m, blocks, bx, by, bz) {
                    some(h) => self.put_on_bed(bx, by, bz, h),
                    none => self.wake_now(f, m, blocks, sounds),
                }
            }
        }
        // Its way through the nether portal it's in, what it saves then its level's to take on
        // (D578), or the end gateway, within its level (D594); not a fox asleep, `Fox.isSleeping`
        // (CAL-311).
        self.living.dozing = self.species == FOX and self.fox_flag(FOX_SLEEPING)
        if let p = self.living.entity_tick_portal(lf) {
            if p.gateway {
                if let done = self.living.gateway_goes(p, blocks) {
                    self.living.show(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.living.body.travel(p, saved)
                self.living.show(Shown.Travel(way), sounds.len())
            }
        }
        // `Entity.baseTick`'s `spawnSprintParticle` where it may, `canSpawnSprintParticle`, as a
        // fleeing cat sprints (CAL-201): sprinting, out of water and lava, not crouching, and alive;
        // where the block its feet are on, `getOnPosLegacy`, is drawn, two doubles from its random
        // for where across, the particle the client's to show.
        let sprinting = i32(self.living.data.byte(SHARED_FLAGS)) & SPRINTING_FLAG != 0
        if sprinting and not self.living.body.in_water and not self.living.body.in_lava() and self.living.data.number(POSE_ID) != CROUCHING and self.living.alive() {
            let (px, py, pz) = self.living.body.on_pos(f, t, blocks, 0.2f32)
            if drawn_block(f, blocks.collision_state(px, py, pz) ?? 0) {
                _ = self.living.body.random.next_double()
                _ = self.living.body.random.next_double()
            }
        }
        // Rabbits and foxes, which are `#powder_snow_walkable_mobs` too, aren't in Calcite (D698).
        self.living.snow_walker = self.species == ENDERMITE or self.species == SILVERFISH
        if self.living.entity_tick_on(f, t, blocks, fast_lava, mut sounds) {
            self.hurt_self(lf, blocks, items, "on_fire", 1.0f32, mut sounds)
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
        }
        if self.living.body.y < f64(min_y - 64) {
            self.hurt_self(lf, blocks, items, "out_of_world", 4.0f32, mut sounds)
            self.hurt_teleport(lf, f, m, blocks, mut sounds)
        }
        self.living.entity_tick_end()
        // Its leash, at the end of `Entity.baseTick` (CAL-179).
        self.leash_tick(lf, f, m, t, blocks, mut cache, min_y, mut sounds)
        if self.living.alive() {
            // Not a fox asleep, `LivingEntity.isInWall` (CAL-201).
            if not self.fox_flag(FOX_SLEEPING) and self.living.in_wall(f, m, lf, blocks) {
                self.hurt_self(lf, blocks, items, "in_wall", 1.0f32, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
            let breathing = self.living.has_effect(WATER_BREATHING) or self.living.has_effect(CONDUIT_POWER)
            let nautilus = self.living.has_effect(BREATH_OF_THE_NAUTILUS)
            if self.living.breathe(f, t, blocks, lf, breathing or nautilus, not nautilus or breathing, sounds.len()) {
                self.hurt_self(lf, blocks, items, "drown", 2.0f32, mut sounds)
                self.hurt_teleport(lf, f, m, blocks, mut sounds)
            }
        }
        let removing = not self.living.body.removed
        self.living.living_tick_end(sounds.len(), players)
        if self.species == ENDER_DRAGON and self.living.dead_or_dying() {
            self.dragon_death(lf, sounds.len())
        }
        if removing and self.living.body.removed {
            // `Slime.remove` (D430), before `LivingEntity.remove`'s.
            if cube_kind(self.species) {
                self.split(sounds.len())
            }
            // `triggerOnDeathMobEffects`, as `tickDeath` takes it out killed (CAL-182).
            let effects = self.living.removal_effects(f, blocks, self.mob_griefing)
            if not effects.is_empty() {
                let gone = Removed { at: (self.living.body.x, self.living.body.y, self.living.body.z), uuid: self.living.body.uuid, silent: self.living.data.flag(SILENT), effects: effects }
                self.living.show(Shown.Removed(gone), sounds.len())
            }
        }
        self.tick_effects(lf, f, m, blocks, items, mut sounds)
        self.living.turns_end()
    }

    // `AbstractCubeMob.remove` of a slime taken out dying, `heard` the sounds of its tick so far
    // (D430): one bigger than 1 splits into 2 to 4, `getSplitCount`, drawn from its random, each
    // of half its size, set apart by half its width, at its place and half a block up, facing
    // where its random draws for each, `setUpSplitCube`; made by its level, `Shown.Split`, as
    // `convertTo` makes them, with what `convertCommon` takes from it.
    fn split(mut self, heard: usize) {
        let size = self.slime_size()
        if size <= 1 or not self.living.dead_or_dying() {
            return
        }
        let spacing = self.width / 2.0f32
        let count = 2 + self.living.body.random.next_int_below(3)
        var places = List<(f64, f64, f64, f32)>()
        for i in 0..count {
            let xd = (f32.nearest(i % 2) - 0.5f32) * spacing
            let zd = (f32.nearest(i / 2) - 0.5f32) * spacing
            let yaw = self.living.body.random.next_float() * 360.0f32
            places.push((self.living.body.x + f64(xd), self.living.body.y + 0.5, self.living.body.z + f64(zd), yaw))
        }
        let split = Split { species: self.species, kind: self.living.kind, size: size / 2, places: places, common: self.common() }
        self.living.show(Shown.Split(split), heard)
    }

    // What `ConversionType.convertCommon` takes from it to what it's made into (D430).
    fn common(self) -> Common {
        var extras = JavaHashMap<String, Tag>()
        for key in ["CustomName", "CustomNameVisible", "Silent", "Tags", "data"] {
            if self.living.body.extras.contains(key) {
                extras.insert(String(key), self.living.body.extras[key].copy())
            }
        }
        return Common { absorption: self.living.absorption, effects: self.living.effects.copy(), left_handed: self.left_handed(), no_ai: self.no_ai(), persistent: self.persistence_required, name_visible: self.living.data.flag(CUSTOM_NAME_VISIBLE), on_fire: self.living.body.fire > 0, invulnerable: self.living.body.invulnerable, invulnerable_time: self.living.invulnerable_time, no_gravity: self.living.body.no_gravity, portal_cooldown: self.living.body.portal_cooldown, silent: self.living.data.flag(SILENT), extras: extras }
    }

    /// `ConversionType.convertCommon` onto it of what `c` took from the mob it's made of (D430):
    /// its absorption; its effects, each added, `add_effect` (CAL-163); its hands, AI, staying,
    /// name's showing, burning flag, invulnerability and cooldown, gravity, portal cooldown,
    /// silence, tags, custom name and custom data. Its team, which comes with the scoreboard's
    /// teams, isn't kept. An effect's sound as it's added, which only the omens make, isn't heard.
    pub fn convert_from(mut self, lf: LivingFacts, c: Common) {
        self.living.absorption = c.absorption
        var unheard = List<EntitySound>()
        for e in c.effects {
            _ = self.add_effect(lf, e.copy(), mut unheard)
        }
        if not unheard.is_empty() {
            self.living.show(Shown.Missing(String("The sound of an omen's effect added to a mob converted")), 0)
        }
        self.set_flag(LEFT_HANDED_FLAG, c.left_handed)
        self.set_flag(NO_AI_FLAG, c.no_ai)
        if c.persistent {
            self.persistence_required = true
        }
        self.living.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(c.name_visible))
        self.living.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, c.on_fire)
        self.living.body.invulnerable = c.invulnerable
        self.living.invulnerable_time = c.invulnerable_time
        self.living.body.no_gravity = c.no_gravity
        self.living.data.set(NO_GRAVITY, Value.Bool(c.no_gravity))
        self.living.body.portal_cooldown = c.portal_cooldown
        self.living.data.set(SILENT, Value.Bool(c.silent))
        for (k, v) in c.extras {
            self.living.body.extras.insert(k.copy(), v.copy())
        }
    }

    /// What a zombie villager takes of the villager `v` it's turned from (CAL-244): what any mob
    /// converted takes, `converted_from`, and whether its villager data's final.
    pub fn turned_from(mut self, lf: LivingFacts, v: Mob) {
        self.converted_from(lf, v, true)
        self.living.data.set(MONSTER_OWN + 5, Value.Bool(v.living.data.flag(OWN + 2)))
    }

    /// What a villager takes of the zombie villager `zv` it's cured from (CAL-175), `convertTo`
    /// with `ConversionParams.single(zv, false, false)`, `ConversionType.SINGLE`: its place and
    /// turns, its motion, its fall, how long since a player hurt it, its hurt's time, its body's
    /// turn and whether it's on the ground, then `convertCommon`'s, `convert_from`, a baby one's
    /// baby, but neither what it wore nor its pick-up; then, `finishConversion`'s, its villager
    /// data, whether that's final, its gossip, its offers and its experience. What it wore that it'd
    /// always drop and what binding's curse keeps on are `preserved_equipment`'s (CAL-280).
    pub fn cured_from(mut self, lf: LivingFacts, zv: Mob) {
        let (x, y, z) = (zv.living.body.x, zv.living.body.y, zv.living.body.z)
        self.living.snap_to(x, y, z, zv.living.body.y_rot, zv.living.body.x_rot)
        self.living.body.vx = zv.living.body.vx
        self.living.body.vy = zv.living.body.vy
        self.living.body.vz = zv.living.body.vz
        self.living.body.fall = zv.living.body.fall
        self.living.hurt_by_player_memory = zv.living.hurt_by_player_memory
        self.living.hurt_time = zv.living.hurt_time
        self.living.y_body_rot = zv.living.y_body_rot
        self.living.body.on_ground = zv.living.body.on_ground
        self.convert_from(lf, zv.common())
        if zv.baby() {
            self.set_age(-24000)
        }
        let (kind, profession, level) = zv.living.data.villager(MONSTER_OWN + 4)
        self.living.data.set(OWN + 2, Value.Bool(zv.living.data.flag(MONSTER_OWN + 5)))
        self.living.data.set(OWN + 1, Value.Villager(kind, profession, level))
        if zv.kept.contains("Gossips") {
            self.gossips = Gossips.read(zv.kept["Gossips"].copy())
        }
        if zv.kept.contains("Offers") {
            self.kept.insert(String("Offers"), zv.kept["Offers"].copy())
        }
        self.villager_xp = zv.villager_xp
    }

    /// `dropPreservedEquipment` of a zombie villager being cured, as `finishConversion` asks it
    /// (CAL-280): in the slots' order, what an enchantment with `prevent_armor_change` keeps on,
    /// binding's curse, held back with the villager's inventory slot it goes in,
    /// `getSlot(300 + getIndex())`; else what it'd always drop, `isPreserved`, taken off to be
    /// dropped where it was. The stacks to drop, and those held back.
    pub fn preserved_equipment<W: Wearing>(mut self, items: W) -> (List<Tag>, List<(usize, Tag)>) {
        let indices: List<usize> = [0, 1, 0, 1, 2, 3, 0, 0]
        var dropped = List<Tag>()
        var held_back = List<(usize, Tag)>()
        for slot in 0..self.living.equipment.len() {
            let held = self.living.equipment[slot].copy() else continue
            if binds(items, held.copy()) {
                if slot < indices.len() {
                    held_back.push((indices[slot], held))
                }
            } else if self.drop_chance(slot) > 1.0f32 {
                self.living.equipment[slot] = none
                dropped.push(held)
            }
        }
        return (dropped, held_back)
    }

    /// What binding's curse kept on the zombie villager it's cured from, `held_back`, each put in
    /// its inventory's slot (CAL-280).
    pub fn take_bound(mut self, f: Facts, held_back: List<(usize, Tag)>) {
        self.ready_inventory(f)
        for (i, stack) in held_back {
            if i < self.inventory.len() {
                self.inventory[i] = some(stack.copy())
            }
        }
    }

    /// The rest of a villager's cure, `finishConversion`'s, once it's finalized (CAL-175): its
    /// brain made again, `refreshBrain`; where the player who cured it, `curer`, is in its level,
    /// their gossip, `ZOMBIE_VILLAGER_CURED`, major positive 20 and minor positive 25; then nausea
    /// for 200 ticks.
    pub fn cured(mut self, lf: LivingFacts, curer: (i64, i64)?, sounds: mut List<EntitySound>) {
        self.refresh_brain()
        if let p = curer {
            self.gossips.add(p, MAJOR_POSITIVE, 20)
            self.gossips.add(p, MINOR_POSITIVE, 25)
        }
        _ = self.add_effect(lf, ActiveEffect.new(NAUSEA, 200, 0), mut sounds)
    }

    /// What a mob takes of the mob `v` it's turned into, `convertTo` with
    /// `ConversionParams.single(v, keep, keep)`, `ConversionType.SINGLE` (CAL-244, CAL-175): its
    /// place and turns, `copyPosition`; its motion; where it `keep`s them, what it wears and holds,
    /// each slot with something in it at its chance to drop; its fall; how long since a player
    /// hurt it; its hurt's time; its body's turn; whether it's on the ground; then
    /// `convertCommon`'s, `convert_from`, with a baby's being one where it can be, a zombie's, an
    /// ageable mob's age and forced age an ageable one's (CAL-179), and, where it keeps it, its
    /// pick-up. What rides it and what it rides its level hands over, `hand_over_riders`. Its
    /// sleeping place, which only a villager's death lets go of, its elytra's flight, which it
    /// hasn't, and a leash, which Calcite hasn't, aren't looked at.
    pub fn converted_from(mut self, lf: LivingFacts, v: Mob, keep: bool) {
        let (x, y, z) = (v.living.body.x, v.living.body.y, v.living.body.z)
        self.living.snap_to(x, y, z, v.living.body.y_rot, v.living.body.x_rot)
        self.living.body.vx = v.living.body.vx
        self.living.body.vy = v.living.body.vy
        self.living.body.vz = v.living.body.vz
        if keep {
            self.kept_equipment(v)
        }
        self.living.body.fall = v.living.body.fall
        self.living.hurt_by_player_memory = v.living.hurt_by_player_memory
        self.living.hurt_time = v.living.hurt_time
        self.living.y_body_rot = v.living.y_body_rot
        self.living.body.on_ground = v.living.body.on_ground
        self.convert_from(lf, v.common())
        if v.baby() and self.zombie_class() {
            self.set_zombie_baby(true)
        } else if v.baby() and self.species == ZOGLIN {
            self.set_zoglin_baby(true)
        }
        if v.ageable and self.ageable {
            if v.baby() {
                self.set_age(-24000)
            }
            self.set_age(v.age)
            self.forced_age = v.forced_age
            self.forced_age_timer = v.forced_age_timer
        }
        if keep {
            self.can_pick_up_loot = v.can_pick_up_loot
        }
    }

    // What it wears and holds of the mob `v` it's turned into, `keepEquipment`: each slot with
    // something in it, at its chance to drop.
    fn kept_equipment(mut self, v: Mob) {
        var chances = JavaHashMap<String, Tag>()
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(m) = self.kept["drop_chances"] {
                chances = m.copy()
            }
        }
        let names = slot_names()
        for slot in 0..v.living.equipment.len() {
            if v.living.equipment[slot] == none or slot >= self.living.equipment.len() {
                continue
            }
            self.living.equipment[slot] = v.living.equipment[slot].copy()
            let chance = v.drop_chance(slot)
            if chance == 0.085f32 {
                _ = chances.remove(names[slot].copy())
            } else {
                chances.insert(names[slot].copy(), Tag.Float(chance))
            }
        }
        _ = self.kept.remove(String("drop_chances"))
        if not chances.is_empty() {
            self.kept.insert(String("drop_chances"), Tag.Compound(chances))
        }
    }

    /// What a zombie villager takes of the villager `v`'s trade once it's finalized,
    /// `convertVillagerToZombieVillager` (CAL-244): its villager data, its gossip, its offers, as
    /// its level made them where they weren't, `getOffers`, and its experience.
    pub fn villager_kept(mut self, v: Mob) {
        let (kind, profession, level) = v.living.data.villager(OWN + 1)
        self.living.data.set(MONSTER_OWN + 4, Value.Villager(kind, profession, level))
        self.kept.insert(String("Gossips"), v.gossips.saved())
        if v.kept.contains("Offers") {
            self.kept.insert(String("Offers"), v.kept["Offers"].copy())
        }
        self.villager_xp = v.villager_xp
    }

    // A hurt in its own tick, `hurtServer` of `amount` of the damage type `name` with nothing
    // causing it (D424): as `hurt` has it; where it took the whole of it, its damage event to
    // those who see it, before its sound; where it dies, `die_here`; then what its kind does
    // after, `after_hurt`. What its enchanted equipment does against it is its level's, `ward`
    // (D439). What's missing is said after its tick.
    fn hurt_self<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, name: str, amount: f32, sounds: mut List<EntitySound>) {
        _ = self.hurt_self_was(lf, blocks, items, name, amount, mut sounds)
    }

    /// Its hurt by cramming, `pushEntities`' 6 of `cramming`, as `hurt_self` has it (CAL-189).
    pub fn cram<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        self.hurt_self(lf, blocks, items, "cramming", 6.0f32, mut sounds)
    }

    // The hurt of a fall its move found, `causeFallDamage`'s `hurt` (CAL-159): `hurt_self`'s, its
    // sounds and what it shows put where vanilla deals it, after the fall's sounds, before what
    // the rest of its move heard and showed.
    fn fall_hurt<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let fall = self.living.fall_hurt.take() else return
        var later = List<EntitySound>()
        while sounds.len() > fall.heard {
            if let s = sounds.pop() {
                later.push(s)
            }
        }
        var shown_later = List<Shown>()
        var after_later = List<usize>()
        while self.living.shown.len() > fall.shown {
            if let w = self.living.shown.pop() {
                shown_later.push(w)
            }
            if let a = self.living.shown_after.pop() {
                after_later.push(a)
            }
        }
        let start = sounds.len()
        self.living.hurt_fall = some(fall.fell)
        self.hurt_self(lf, blocks, items, if fall.stalagmite { "stalagmite" } else { "fall" }, fall.amount, mut sounds)
        self.living.hurt_fall = none
        let added = sounds.len() - start
        while let s = later.pop() {
            sounds.push(s)
        }
        while let w = shown_later.pop() {
            let a = after_later.pop() ?? fall.heard
            self.living.show(w, a + added)
        }
    }

    // `hurt_self`, and whether it was hurt, as `hurtServer` says (D434).
    fn hurt_self_was<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, name: str, amount: f32, sounds: mut List<EntitySound>) -> bool {
        let d = Damage.of(lf.damage, name)
        let before = sounds.len()
        let now = self.game_time
        let hard = self.hard
        var missing = List<String>()
        let ward = self.ward(blocks, items, lf.damage, d, none, mut missing)
        if self.raid != none {
            // `Raider.hurtServer`: its raid's bar first (CAL-397).
            let health = self.living.health()
            self.living.show(Shown.RaidHurt(health), before)
        }
        let h = self.hurt(lf, lf.damage, d, amount, now, ward, mut sounds, mut missing)
        if h.hurt and h.full {
            self.living.show(Shown.Damaged(d.kind), before + h.early)
        }
        // A totem's save, after what it played (D518).
        if h.totem {
            self.living.show(Shown.Event(35i8), sounds.len())
        }
        if h.dies {
            self.die_here(items, d, sounds.len())
        }
        // Reinforcements called in its own tick, where the level's random's draws would come
        // among its other ticks', come later.
        if self.after_hurt(h, hard, d) != none {
            missing.push(String("Zombie reinforcements called in a zombie's own tick"))
        }
        for m in missing {
            self.living.show(Shown.Missing(m.copy()), sounds.len())
        }
        return h.hurt
    }

    // What it's inside and what that does to it, as `applyEffectsFromBlocks` goes on after `stepOn`
    // (D434): where blocks act on it, the blocks it went into along its moves this tick,
    // `inside_blocks`, while it's alive, each block's at once, a campfire's and a cactus's hurts
    // its own, `hurt_self`, and its fluid's; then the effects they put on it in their order, fire's
    // and lava's hurts its own, lava's heard where it hurt, `generic.burn`, its pitch drawn, unless
    // it's silent; then the rain, and its fire's end, `after_inside`.
    fn inside_walk<B: CollisionBlocks + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let moves = self.living.final_moves()
        if self.living.body.removed or self.living.body.no_physics {
            return
        }
        let was = self.living.fire_before()
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.living.body.width, self.living.body.height, self.living.body.fall) {
            if not self.living.alive() {
                break
            }
            if i.block {
                c.advance(i.step)
                match self.living.touch(f, i, mut c) {
                    Touched.Campfire(amount) => self.hurt_self(lf, blocks, items, "campfire", amount, mut sounds),
                    Touched.Cactus => self.hurt_self(lf, blocks, items, "cactus", 1.0f32, mut sounds),
                    Touched.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                    Touched.Plate(at) => self.living.show(Shown.Plate((at, (0, 0))), sounds.len()),
                    Touched.Tripwire(at) => {
                        // Not a bat's, which ignores block triggers (CAL-201).
                        if self.species != BAT {
                            self.living.show(Shown.Tripwire(at), sounds.len())
                        }
                    },
                    Touched.Dripleaf(at) => self.living.show(Shown.Dripleaf(at), sounds.len()),
                    Touched.Rail(at) => self.living.show(Shown.Rail((at, false)), sounds.len()),
                    Touched.Hopper(_) => {},
                    Touched.Portal((px, py, pz)) => {
                        // Gone into where it's not asleep, `canUsePortal` (D578), nor a wither,
                        // which goes through none (CAL-401).
                        if self.living.sleeping == none and self.species != WITHER_BOSS {
                            self.living.body.inside_portal(px, py, pz, PORTAL_DELAY, false)
                        }
                    },
                    Touched.EndPortal((px, py, pz)) => {
                        if self.living.sleeping == none and self.species != WITHER_BOSS {
                            self.living.body.inside_portal(px, py, pz, PORTAL_DELAY, true)
                        }
                    },
                    Touched.Gateway(g) => {
                        // Gone into where it may go through it, `canUsePortal`, and the
                        // gateway's open, its cooldown then begun by its level (D594).
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if self.living.alive() and self.living.sleeping == none and self.species != WITHER_BOSS and blocks.gateway_open(gx, gy, gz) {
                            self.living.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.living.show(Shown.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    // `Spider.makeStuckInBlock`: a spider isn't held by a cobweb (D696).
                    Touched.Web => if not self.spider_kind() { self.living.web() },
                    Touched.Honey((hx, hy, hz)) => self.living.honey(hx, hy, hz, sounds.len()),
                    Touched.Bubble((drag, at)) => self.living.bubble(f, blocks, drag, at, sounds.len()),
                    Touched.PowderSnow((_, sy, _)) => {
                        if self.living.in_snow(lf, f, blocks) {
                            let at = (self.living.body.x, f64(sy + 1), self.living.body.z)
                            self.living.show(Shown.Snow((at, none)), sounds.len())
                        }
                    },
                    // Neither a fox nor a bee, `SweetBerryBushBlock.entityInside` (CAL-201).
                    Touched.Berry(age) => {
                        if self.species != FOX and self.species != BEE {
                            self.living.berry_bush()
                            if age != 0 and self.living.body.moved_across() {
                                self.hurt_self(lf, blocks, items, "sweet_berry_bush", 1.0f32, mut sounds)
                            }
                        }
                    },
                    // `WitherRoseBlock.entityInside`: withered for 2 seconds but on peaceful, and
                    // where it isn't invulnerable to it (D697).
                    Touched.WitherRose => {
                        if self.difficulty != 0 and not self.living.body.removed and not self.living.body.invulnerable {
                            _ = self.living.add_effect(lf, ActiveEffect.new(WITHER, 40, 0), mut sounds)
                        }
                    },
                    Touched.Nothing => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if not self.living.alive() {
                break
            }
            match e {
                BlockEffect.Apply(kind) => self.living.apply_effect(kind, 0),
                BlockEffect.InFire(amount) => self.hurt_self(lf, blocks, items, "in_fire", amount, mut sounds),
                BlockEffect.LavaHurt => {
                    if not self.living.fire_immune and self.hurt_self_was(lf, blocks, items, "lava", 4.0f32, mut sounds) and not self.living.silent() {
                        let pitch = 2.0f32 + self.living.body.random.next_float() * 0.4f32
                        self.living.play(mut sounds, String("entity.generic.burn"), 0.4f32, pitch)
                    }
                },
                BlockEffect.Doused(at) => {
                    if self.living.on_fire() {
                        self.living.show(Shown.Doused(at), sounds.len())
                    }
                },
                BlockEffect.Melted(at) => {
                    if self.living.on_fire() {
                        self.living.show(Shown.Melted(at), sounds.len())
                    }
                },
            }
        }
        let rained = self.living.body.in_rain(blocks)
        self.living.after_inside(was, rained, mut sounds)
    }

    // `PanicGoal.lookForWater`, as a burning mob panics (D434), or a turtle (CAL-201): where
    // nothing it collides with is in its block, the first block holding water by how far it is,
    // up to `reach` across, 5 or a turtle's 7, and 1 up or down,
    // `findBlocksInBoxByManhattanDistance`, each step out x, then y, then z first south then
    // north.
    fn look_for_water<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, reach: i32) -> (i32, i32, i32)? {
        let (ox, oy, oz) = self.living.body.block()
        let here = blocks.collision_state(ox, oy, oz) ?? 0
        if not m.boxes_at(f, blocks, here, ox, oy, oz, self.living.body.mover()).is_empty() {
            return none
        }
        let (reach_xz, reach_y) = (reach, 1)
        for depth in 0..=(reach_xz + reach_y + reach_xz) {
            let most_x = reach_xz.min(depth)
            for x in -most_x..=most_x {
                let most_y = reach_y.min(depth - x.abs())
                for y in -most_y..=most_y {
                    let z = depth - x.abs() - y.abs()
                    if z > reach_xz {
                        continue
                    }
                    if water_at(f, blocks, ox + x, oy + y, oz + z) {
                        return some((ox + x, oy + y, oz + z))
                    }
                    if z != 0 and water_at(f, blocks, ox + x, oy + y, oz - z) {
                        return some((ox + x, oy + y, oz - z))
                    }
                }
            }
        }
        return none
    }

    /// `die` of the damage `d` from outside its tick, as an arrow kills it (CAL-159): as in its own
    /// tick, `die_here`, what's left to its level shown, `Shown.Died`, for the caller to take.
    pub fn die_outside<W: Wearing>(mut self, items: W, d: Damage) {
        self.die_here(items, d, 0)
    }

    /// Whether it's pickable, `isPickable`, which a projectile or a spear may hit: not an ender
    /// dragon, whose parts are hit in its place, `EnderDragon` (D610).
    pub fn pickable(self) -> bool {
        return self.species != ENDER_DRAGON
    }

    /// `handleKillingBlow`, as `die` has it (D416): it's died, `Living.killed`; but an ender
    /// dragon's, `EnderDragon`'s, where it doesn't sit, leaves its health 1 and has it dying,
    /// `DYING`, which its flight takes on, and where it sits does nothing, not even dead, `dead`
    /// (D608).
    pub fn killing_blow(mut self) {
        if self.species != ENDER_DRAGON {
            self.living.killed()
            return
        }
        let sitting = match self.dragon {
            some(dr) => dr.sitting(),
            none => true,
        }
        if not sitting {
            self.living.data.set(HEALTH, Value.Float(1.0f32))
            self.set_dragon_phase(DYING)
        }
    }

    /// Whether it drops its loot as it dies, `shouldDropLoot`: mob drops on, and it no baby unless
    /// it's a monster, `Monster`, whose babies drop theirs too (CAL-179).
    pub fn drops_loot(self) -> bool {
        return self.mob_drops and (self.monster or not self.baby())
    }

    // `die` in its own tick, of the damage `d`, `heard` the sounds of its tick so far (D424): it's
    // died, `killed`; where it drops loot, `drops_loot`, its loot table's, which its level rolls,
    // and what it wears and holds that it drops, `dropCustomDeathLoot`, drawn now; where a player
    // hurt it lately, it drops experience, `shouldDropExperience`, not a baby, but any monster or a
    // hoglin, and mob drops are on, its experience, its reward drawn now, `dropExperience`; what's
    // left to its level shown, `Shown.Died`; then it lies dying. Where what killed it turns
    // it into its own kind, `killedEntity`, it drops nothing, `Death.converted_by` (CAL-244).
    fn die_here<W: Wearing>(mut self, items: W, d: Damage, heard: usize) {
        self.killing_blow()
        let killed_by_player = self.living.hurt_by_player_memory > 0
        let drops = self.drops_loot() and not d.converts
        var death = Death { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, damage: d.kind, uuid: some(self.living.body.uuid), this: some(self.loot_entity()), by_player: d.player }
        if killed_by_player {
            death.killed_by = self.living.hurt_by_player
        }
        if d.converts {
            death.converted_by = some(d.cause)
        }
        // A fox's mouth's first, loot or not, `Fox.dropAllDeathLoot` (CAL-201).
        if self.species == FOX {
            if let held = self.living.equipment[0].take() {
                death.first.push(held)
            }
        }
        if drops {
            death.loot = some(self.death_loot())
            death.equipment = self.equipment_drops(items, killed_by_player, List<f32>())
            death.carried = self.carried()
            death.star = self.species == WITHER_BOSS
        }
        if not d.converts {
            // `dropEquipment`, whether it drops loot or not (CAL-179).
            death.inventory = self.inventory_drops(items)
        }
        if killed_by_player and (not self.baby() or self.monster or self.species == HOGLIN) and self.mob_drops and not d.converts {
            death.reward = self.experience_reward()
        }
        // A tame wolf's death told its owner, `TamableAnimal.die`, by what hurt it lately, its
        // credit who last hurt it (CAL-201).
        if self.is_tame() {
            death.owner = self.living.data.uuid(OWN + 1)
            death.combat = self.living.combat.copy()
            death.hurt_by = self.living.hurt_by_mob
        }
        self.living.show(Shown.Died(death), heard)
        self.living.lie_dying()
    }

    /// `hurtServer` of `amount` of the damage `d` of `types` at the game time `now` (D416):
    /// `LivingEntity`'s, its idle time back to 0 where it got past its first checks; an animal's
    /// love ended as it's hurt, `Animal.actuallyHurt`; then its death sound, or its hurt sound
    /// after which its ambient sound waits, `resetAmbientSoundTime`, each as loud as its sounds
    /// and its voice's pitch drawn. Its death, `die`, is its level's, then `after_hurt`. What its
    /// enchanted equipment does against it is `ward`'s (D439). An enderman a projectile would hurt
    /// isn't, but dodges it, `dodge`, as its level has it (CAL-159). A totem saving it is
    /// `hurt_server`'s, neither its death sound nor its hurt sound heard then (D518); what's
    /// missing is said in `missing`.
    pub fn hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        if self.species == PANDA {
            // `Panda.hurtServer`: it stands first (CAL-201).
            self.panda_sit(false)
        }
        if self.species == BAT and self.bat_resting() and not self.living.invulnerable_to(types, d, self.living.fire_immune, ward.immune) {
            // `Bat.hurtServer`: awake, where it may be hurt by it (CAL-201).
            self.set_bat_resting(false)
        }
        if self.species == PARROT and not self.living.invulnerable_to(types, d, self.living.fire_immune, ward.immune) {
            // `Parrot.hurtServer`: not ordered to sit any more, where it may be hurt by it
            // (CAL-201).
            self.wolf.sitting = false
        }
        if self.guardian_kind() {
            // `Guardian.hurtServer`, after its spikes, `spikes`, which its level deals: its stroll
            // told to go next time, `trigger` (CAL-200).
            self.goals.trigger_strolls()
        }
        if squid_kind(self.species) {
            // `Squid.hurtServer` (CAL-201): hurt, with what hurt it known, `getLastHurtByMob`, its
            // ink, `spawnInk`, and a glow squid's dark for 100 ticks, `GlowSquid.hurtServer`.
            let h = self.hurt_as_living(lf, types, d, amount, now, ward, mut sounds, mut missing)
            if h.hurt and self.living.hurt_by_mob != none {
                self.squid_ink(mut sounds)
                if self.species == GLOW_SQUID {
                    self.living.data.set(GLOW_DARK, Value.Number(100))
                }
            }
            return h
        }
        if self.species == WITHER_BOSS {
            return self.wither_hurt(lf, types, d, amount, now, ward, mut sounds, mut missing)
        }
        if self.species == SULFUR_CUBE and self.has_body_item() {
            // `SulfurCube.hurtServer` (CAL-402): holding a block it may explode with, fire, `#is_fire`,
            // primes it, an explosion, `#is_explosion`, with a short fuse; and what it's immune to
            // with one, `#sulfur_cube_with_block_immune_to`, doesn't hurt it, said to be missing its
            // knockback, `dealDefaultKnockback`, where it has one.
            if self.sulfur_can_explode() {
                if types.is(d.kind, IS_FIRE) {
                    _ = self.sulfur_prime(false, mut sounds)
                } else if types.is(d.kind, IS_EXPLOSION) {
                    _ = self.sulfur_prime(true, mut sounds)
                }
            }
            if types.is(d.kind, SULFUR_CUBE_WITH_BLOCK_IMMUNE_TO) {
                // `dealDefaultKnockback(source, damage, true)`: along a projectile's way, else
                // toward where it came from, by 0.4.
                if not types.is(d.kind, NO_KNOCKBACK) {
                    var xd = 0.0
                    var zd = 0.0
                    if let way = d.knock {
                        let (kx, kz) = way
                        xd = -kx
                        zd = -kz
                    } else if let at = d.at {
                        let (x, _, z) = at
                        xd = x - self.living.body.x
                        zd = z - self.living.body.z
                    }
                    self.living.knockback_from(lf, f64(0.4f32), xd, zd, d, amount, false, mut sounds)
                }
                return Hurt { hurt: true }
            }
        }
        if self.species == ENDER_DRAGON {
            // `EnderDragon.hurtServer`: through its body (D608).
            return self.dragon_hurt(lf, types, d, amount, now, ward, BODY, mut sounds, mut missing)
        }
        return self.hurt_as_living(lf, types, d, amount, now, ward, mut sounds, mut missing)
    }

    // `WitherBoss.hurtServer` (CAL-401): nothing it's invulnerable to, of `#wither_immune_to`, or
    // caused by a wither; nothing while it's invulnerable but what `#bypasses_invulnerability`;
    // powered, nothing of an arrow or a wind charge; nothing caused by its friends, the undead.
    // Else 20 ticks till it breaks the blocks about it where none were counting, its side heads'
    // idle looks 3 more each, and hurt as any mob is.
    fn wither_hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        if self.living.invulnerable_to(types, d, self.living.fire_immune, ward.immune) {
            return Hurt()
        }
        if types.is(d.kind, WITHER_IMMUNE_TO) or d.cause_species == WITHER_BOSS {
            return Hurt()
        }
        if self.wither_invulnerable() > 0 and not types.is(d.kind, BYPASSES_INVULNERABILITY) {
            return Hurt()
        }
        if self.wither_powered(lf) and d.arrow {
            return Hurt()
        }
        if d.cause_species >= 0 and undead_kind(d.cause_species) {
            return Hurt()
        }
        if self.wither.destroy_blocks_tick <= 0 {
            self.wither.destroy_blocks_tick = 20
        }
        for i in 0usize..2 {
            self.wither.idle_head_updates[i] = self.wither.idle_head_updates[i] + 3
        }
        return self.hurt_as_living(lf, types, d, amount, now, ward, mut sounds, mut missing)
    }

    /// Whether a guardian's spikes hurt what hurts it by `d` of `types`, as `Guardian.hurtServer`
    /// does before it's hurt (CAL-200): where it isn't moving, `isMoving`, for damage not of
    /// `#avoids_guardian_thorns`, magic, thorns and explosions, nor thorns itself, dealt by a
    /// living entity itself, a player or a mob, its level hurting that by its thorns, 2.
    pub fn spikes(self, types: DamageTypes, d: Damage) -> bool {
        if not self.guardian_kind() or self.living.data.flag(MONSTER_OWN) {
            return false
        }
        if d.kind == types.id("magic") or d.kind == types.id("thorns") or types.is(d.kind, IS_EXPLOSION) {
            return false
        }
        return d.direct >= 0 and d.direct == d.cause and (d.living_cause or d.player != none)
    }

    /// `EnderDragonPart.hurtServer` of an ender dragon's part `part`, as `PARTS` orders them, by
    /// `amount` of the damage `d` of `types` at the game time `now` (D667): nothing of fire, as
    /// its part is of its type, which fire doesn't hurt, `isInvulnerableToBase`; else the dragon
    /// hurt through it, `EnderDragon.hurt(level, part, ...)`. Another mob's hurt as `hurt` hurts
    /// it.
    pub fn hurt_part(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, part: usize, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        if self.species != ENDER_DRAGON {
            return self.hurt(lf, types, d, amount, now, ward, mut sounds, mut missing)
        }
        if types.is(d.kind, IS_FIRE) {
            return Hurt()
        }
        return self.dragon_hurt(lf, types, d, amount, now, ward, part, mut sounds, mut missing)
    }

    // `EnderDragon.hurt` of `amount` of the damage `d` of `types` through its part `part` (D608):
    // nothing while it's dying, `DYING`; its phase's say first, `onHurt`, a sitting phase's none
    // of an arrow's or a wind charge's, which it sets alight for a second, `kindled` (CAL-167);
    // through any part but its head and neck, a quarter of it and up to 1 more; nothing under
    // 0.01. Caused by a player, or an explosion, `#always_hurts_ender_dragons`, it's hurt as any
    // mob is, `reallyHurt`, without knockback where it sits; sitting, what it lost counted, and
    // past a quarter of its most it takes off, the count gone. Hurt or not, past 0.01 it says it
    // was.
    fn dragon_hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, part: usize, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        let dr = self.dragon.copy() else return Hurt()
        if dr.phase == DYING {
            return Hurt()
        }
        var damage = amount
        let shot = d.kind == types.id("arrow") or d.kind == types.id("trident") or d.kind == types.id("wind_charge")
        if sits(dr.phase) and dr.phase != HOVERING and shot {
            var spurned = Hurt()
            spurned.kindled = true
            return spurned
        }
        if part != HEAD and part != NECK {
            damage = damage / 4.0f32 + damage.min(1.0f32)
        }
        if damage < 0.01f32 {
            return Hurt()
        }
        if d.player == none and not types.is(d.kind, IS_EXPLOSION) {
            var said = Hurt()
            said.hurt = true
            return said
        }
        let before = self.living.health()
        self.living.knock_proof = sits(dr.phase)
        var h = self.hurt_as_living(lf, types, d, damage, now, ward, mut sounds, mut missing)
        h.hurt = true
        if sits(dr.phase) {
            var now_dr = self.dragon.take() else return h
            now_dr.sitting_damage = now_dr.sitting_damage + before - self.living.health()
            let quarter = 0.25f32 * self.living.max_health(lf)
            let up = now_dr.sitting_damage > quarter
            if up {
                now_dr.sitting_damage = 0.0f32
            }
            self.dragon = some(now_dr)
            if up {
                self.set_dragon_phase(TAKEOFF)
                // Its breath's cloud, where it was breathing, goes as its breath ends, which
                // Calcite has its next tick do, not the hurt (D617).
                if let later = self.dragon {
                    if later.quench != none {
                        missing.push(String("An ender dragon's breath's cloud gone as a hurt has it take off"))
                    }
                }
            }
        }
        return h
    }

    /// An ender dragon given its dragon fight, `setDragonFight`, by the fight that makes it
    /// (D626).
    pub fn set_dragon_fight(mut self) {
        var dr = self.dragon.take() else return
        dr.fight = true
        self.dragon = some(dr)
    }

    /// Whether the end crystal of the ID `crystal` is the one an ender dragon's healed by,
    /// `nearestCrystal` (CAL-167).
    pub fn dragon_crystal_nearest(self, crystal: i32) -> bool {
        return match self.dragon {
            some(dr) => dr.nearest_crystal == some(crystal),
            none => false,
        }
    }

    /// An ender dragon's phase told an end crystal's broken, `onCrystalDestroyed` (CAL-167):
    /// holding its pattern, the player to blame, or the nearest it could see as an enemy,
    /// strafed where it can attack them, `canAttack`, as `DragonHoldingPatternPhase.strafePlayer`
    /// does; its other phases do nothing.
    pub fn dragon_crystal_gone<B: NavLevel>(mut self, blocks: B, min_y: i32, player: Follower?) {
        var dr = self.dragon.take() else return
        if dr.phase == HOLDING_PATTERN {
            if let p = player {
                if p.enemy {
                    self.dragon_phase_to(mut dr, STRAFE_PLAYER)
                    self.strafe_set_target(mut dr, blocks, min_y, p.id, p.x, p.y, p.z)
                }
            }
        }
        self.dragon = some(dr)
    }

    /// An ender dragon's phase set, `EnderDragonPhaseManager.setPhase` (D608): where it isn't its
    /// phase already, its phase, shown, `DATA_PHASE`; and whether it takes knockback, as it sits
    /// or not. A phase's `begin` and `end` change only what its flight keeps; a breath's end leaves
    /// its cloud to go, which its next tick says (D617).
    pub fn set_dragon_phase(mut self, phase: i32) {
        var dr = self.dragon.take() else return
        self.dragon_phase_to(mut dr, phase)
        self.dragon = some(dr)
    }

    // `EnderDragonPhaseManager.setPhase` on its dragon's state `dr`, held apart from it as it
    // ticks (D613): a new phase begun and shown, `DATA_PHASE`, and whether it sits now.
    fn dragon_phase_to(mut self, dr: mut Dragon, phase: i32) {
        if dr.phase != phase {
            if dr.phase == SITTING_FLAMING {
                // `DragonSittingFlamingPhase.end`: its breath's cloud to go (D617).
                if let flame = dr.flame {
                    dr.quench = some(flame)
                }
                dr.flame = none
            }
            dr.begin(phase)
            self.living.data.set(DRAGON_PHASE, Value.Number(phase))
        }
        self.living.knock_proof = dr.sitting()
    }

    // `EnderDragon.aiStep` (D608), in place of a mob's, `heard` the sounds of its tick so far:
    // dying, three floats drawn for its explosions' place, which only clients show; else its
    // crystals, `checkCrystals`: the one it had, where it isn't gone, healing it a point each
    // 10th tick it's hurt, and 1 in 10, drawn, the nearest its level found for it taken; then its
    // turn wrapped, `wrapDegrees`. Without AI its wings stay at the top of their beat, which shows
    // nothing, and that's all. With AI (D611), its height and turn kept in its flight's history;
    // its phase's tick, again where it changed its phase, `dragon_phase_tick` (D613), each phase
    // Calcite's since its death's (D620); its flight toward its phase's target, `Dragon.fly`,
    // which no blocks touch, as it has no physics, `isAffectedByBlocks`; its body turned as it's
    // turned; its parts placed, what its wings and head reach kept for its level where it wasn't
    // hurt lately; the walls its head, neck and body are in, `checkWalls`; and, where it's its
    // fight's dragon, its word to its fight, `updateDragon`, its level's to say once its walls are
    // broken (D626). Its wings' flap, `processFlappingMovement`, is a game event no one hears.
    fn dragon_step<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, min_y: i32, heard: usize) {
        var dr = self.dragon.take() else return
        // None of its strikes or breaks where it doesn't fly this tick (D615), nor its word to its
        // fight (D626).
        dr.strikes = List<Aabb>()
        dr.walls_due = false
        dr.seen_due = false
        // Its level's fight its own where it's that fight's dragon, before it looks at whether
        // it's dying (D626).
        if dr.ours {
            dr.fight = true
        }
        if self.living.dead_or_dying() {
            for _ in 0..3 {
                _ = self.living.body.random.next_float()
            }
            self.dragon = some(dr)
            return
        }
        if dr.nearest_crystal != none {
            if dr.crystal_gone {
                dr.nearest_crystal = none
            } else if self.living.body.tick_count % 10 == 0 and self.living.health() < self.living.max_health(lf) {
                let more = self.living.health() + 1.0f32
                self.living.set_health(lf, more)
            }
        }
        if self.living.body.random.next_int_below(10) == 0 {
            dr.nearest_crystal = dr.found_crystal
        }
        self.living.body.y_rot = wrap_degrees(self.living.body.y_rot)
        if self.no_ai() {
            self.dragon = some(dr)
            return
        }
        dr.record(self.living.body.y, self.living.body.y_rot)
        let ticked = dr.phase
        var known = self.dragon_phase_tick(mut dr, lf, m, f, blocks, players, min_y, heard)
        self.dragon_quench(mut dr, heard)
        if known and dr.phase != ticked {
            known = self.dragon_phase_tick(mut dr, lf, m, f, blocks, players, min_y, heard)
            self.dragon_quench(mut dr, heard)
        }
        if not known {
            let phase = dr.phase
            self.dragon = some(dr)
            self.living.show(Shown.Missing("An ender dragon's phase {phase}, its tick and its flight"), heard)
            return
        }
        if let target = dr.target {
            let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
            let (vx, vy, vz) = (self.living.body.vx, self.living.body.vy, self.living.body.vz)
            let went = dr.fly(Flight { x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, y_rot: self.living.body.y_rot }, target)
            self.living.body.x = went.x
            self.living.body.y = went.y
            self.living.body.z = went.z
            self.living.body.vx = went.vx
            self.living.body.vy = went.vy
            self.living.body.vz = went.vz
            self.living.body.y_rot = went.y_rot
            self.living.body.horizontal_collision = false
            self.living.body.vertical_collision = false
            self.living.body.vertical_below = false
        }
        self.living.y_body_rot = self.living.body.y_rot
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        dr.place_parts(x, y, z, self.living.body.y_rot, self.living.hurt_time <= 0)
        let (hit, breaks) = self.dragon_walls(lf, f, blocks, dr, heard)
        dr.in_wall = hit
        dr.walls_due = breaks
        dr.seen_due = dr.fight and dr.ours
        self.dragon = some(dr)
    }

    // Its phase's own tick, `doServerTick`, on its state `dr` (D613): whether it's a phase Calcite
    // has. A hover's held where it is as it first ticks, `DragonHoverPhase`'s. A holding pattern,
    // a landing's approach and a charge each fly on where they have no target, are within 10 of it
    // or more than 150 off, or it hit anything; a landing goes to the egg's place, its middle at
    // the top of its column, and scans once it's within 1 of it, its breaths since it landed none;
    // a takeoff finds its way off at its first tick, or where it has no path, and holds its pattern
    // once it's 10 from the egg's middle; its scan, `DragonSittingScanningPhase`, turns toward the
    // nearest player it may attack within 20 and 10 above or below, those its sight was had of
    // kept, and roars at them past its 25th tick, else at its 100th takes off, charging the nearest
    // within 150 where there's one; a roar breathes at its 41st, and a charge holds its pattern
    // once its count since it got there is past 10, which counts twice a tick while it's there,
    // as vanilla's check of it falls through to the check of where it is (D616); a breath leaves
    // its cloud at its 10th tick, `heard` the sounds of its tick so far, and scans again at its
    // 200th, or takes off where it's breathed 4 times (D617); a strafe flies at the player it
    // strafes and shoots a fireball at them once it's charged it, `dragon_strafe` (D619); and its
    // death's flies home to the top of the podium, dying there, `lf` its facts (D620).
    fn dragon_phase_tick<B: CollisionBlocks + NavLevel>(mut self, dr: mut Dragon, lf: LivingFacts, m: MovementStates, f: Facts, blocks: B, players: List<Follower>, min_y: i32, heard: usize) -> bool {
        let phase = dr.phase
        if phase == HOVERING {
            if dr.target == none {
                dr.target = some((self.living.body.x, self.living.body.y, self.living.body.z))
            }
            return true
        }
        if phase == HOLDING_PATTERN or phase == LANDING_APPROACH {
            if self.dragon_off_target(dr) {
                if phase == HOLDING_PATTERN {
                    self.holding_new_target(mut dr, blocks, players, min_y)
                } else {
                    self.approach_new_target(mut dr, blocks, players, min_y)
                }
            }
            return true
        }
        if phase == LANDING {
            if dr.target == none {
                let egg_y = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, 0, 0) ?? min_y
                dr.target = some((0.5, f64(egg_y), 0.5))
            }
            if let t = dr.target {
                let (tx, ty, tz) = t
                let dx = self.living.body.x - tx
                let dy = self.living.body.y - ty
                let dz = self.living.body.z - tz
                if dx * dx + dy * dy + dz * dz < 1.0 {
                    dr.flame_count = 0
                    self.dragon_phase_to(mut dr, SITTING_SCANNING)
                }
            }
            return true
        }
        if phase == TAKEOFF {
            if not dr.first_tick and dr.path != none {
                let egg_y = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, 0, 0) ?? min_y
                let cx = 0.5 - self.living.body.x
                let cy = f64(egg_y) + 0.5 - self.living.body.y
                let cz = 0.5 - self.living.body.z
                if not (cx * cx + cy * cy + cz * cz < 100.0) {
                    self.dragon_phase_to(mut dr, HOLDING_PATTERN)
                }
            } else {
                dr.first_tick = false
                self.takeoff_new_target(mut dr, blocks, min_y)
            }
            return true
        }
        if phase == SITTING_SCANNING {
            self.dragon_scan(mut dr, m, f, blocks, players)
            return true
        }
        if phase == SITTING_ATTACKING {
            let was = dr.attack_ticks
            dr.attack_ticks += 1
            if was >= 40 {
                self.dragon_phase_to(mut dr, SITTING_FLAMING)
            }
            return true
        }
        if phase == SITTING_FLAMING {
            // `DragonSittingFlamingPhase.doServerTick` (D617): at its 200th tick it takes off where
            // it's breathed 4 times since it landed, else scans again; at its 10th it breathes.
            dr.flame_ticks += 1
            if dr.flame_ticks >= 200 {
                let next = if dr.flame_count >= 4 { TAKEOFF } else { SITTING_SCANNING }
                self.dragon_phase_to(mut dr, next)
            } else if dr.flame_ticks == 10 {
                self.dragon_breath(dr, f, blocks, heard)
            }
            return true
        }
        if phase == STRAFE_PLAYER {
            self.dragon_strafe(mut dr, m, f, blocks, players, min_y, heard)
            return true
        }
        if phase == DYING {
            // `DragonDeathPhase.doServerTick` (D620): its target, at its first tick, the bottom
            // middle of the block atop the podium's column, `MOTION_BLOCKING`, its fight's middle
            // 0, 0; its health 0 where it's within 10 of it or more than 150 off, or it hit
            // anything, which with no physics it never does, so `tickDeath` takes it from its next
            // tick; else 1.
            if dr.target == none {
                let egg_y = blocks.column_height(MOTION_BLOCKING, 0, 0) ?? min_y
                dr.target = some((0.5, f64(egg_y), 0.5))
            }
            let left = if self.dragon_off_target(dr) { 0.0f32 } else { 1.0f32 }
            self.living.set_health(lf, left)
            return true
        }
        if phase == CHARGING_PLAYER {
            if dr.target == none {
                self.dragon_phase_to(mut dr, HOLDING_PATTERN)
                return true
            }
            // `timeSinceCharge > 0 && timeSinceCharge++ >= 10`: counted where it's begun, and
            // where that's 10 not yet, on to where it is, counted again (D616).
            var done = false
            if dr.charge_time > 0 {
                let was = dr.charge_time
                dr.charge_time += 1
                done = was >= 10
            }
            if done {
                self.dragon_phase_to(mut dr, HOLDING_PATTERN)
            } else if self.dragon_off_target(dr) {
                dr.charge_time += 1
            }
            return true
        }
        return false
    }

    // Whether it's to fly on from its target `dr.target`: none, within 10 of it or more than 150
    // off, `distanceToSqr`, or it hit anything (D613).
    fn dragon_off_target(self, dr: Dragon) -> bool {
        var off = 0.0
        if let t = dr.target {
            let (tx, ty, tz) = t
            let dx = self.living.body.x - tx
            let dy = self.living.body.y - ty
            let dz = self.living.body.z - tz
            off = dx * dx + dy * dy + dz * dz
        }
        return off < 100.0 or off > 22500.0 or self.living.body.horizontal_collision or self.living.body.vertical_collision
    }

    // `DragonHoldingPatternPhase.findNewTarget` (D613), its fight's middle 0, 0, 0: where it's
    // flown its path, 1 in the 3 more than the crystals its fight counts alive, drawn, it lands,
    // `LANDING_APPROACH`; else, by the egg's place, the top of the podium at the middle, where a
    // player may be seen as an enemy, the nearest to it, `NEW_TARGET_TARGETING`, which sees
    // through walls, it strafes them 1 in the 2 more than a 512th of their squared distance from
    // the egg's middle, or else 1 in the 2 more than those crystals, each drawn. Then where it has
    // no path or has flown it, a new one, `findPath`, from the node nearest it to the next, the
    // way it's flying round, which turns about 1 in 8, drawn, and goes 6 on, on the outer circle
    // where it has a fight, as vanilla's check of its crystals, `>= 0`, always passes, else on the
    // middle (D626); and its target its path's next node, up to 20 above it, drawn,
    // `navigateToNextPathNode`.
    fn holding_new_target<B: NavLevel>(mut self, dr: mut Dragon, blocks: B, players: List<Follower>, min_y: i32) {
        if dr.path != none and dr.path_done() {
            let crystals = dr.alive_crystals()
            let egg_y = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, 0, 0) ?? min_y
            if self.living.body.random.next_int_below(crystals + 3) == 0 {
                self.dragon_phase_to(mut dr, LANDING_APPROACH)
                return
            }
            if let near = nearest_to_egg(players, egg_y) {
                let (id, px, py, pz) = near
                let cx = 0.5 - px
                let cy = f64(egg_y) + 0.5 - py
                let cz = 0.5 - pz
                let from_middle = (cx * cx + cy * cy + cz * cz) / 512.0
                let bound = i32.saturate((from_middle + 2.0).floor())
                if self.living.body.random.next_int_below(bound) == 0 or self.living.body.random.next_int_below(crystals + 2) == 0 {
                    self.dragon_phase_to(mut dr, STRAFE_PLAYER)
                    self.strafe_set_target(mut dr, blocks, min_y, id, px, py, pz)
                    return
                }
            }
        }
        if dr.path == none or dr.path_done() {
            let current = self.dragon_closest_node(mut dr, blocks, min_y)
            var target = i32.wrap(current)
            if self.living.body.random.next_int_below(8) == 0 {
                dr.clockwise = not dr.clockwise
                target += 6
            }
            if dr.clockwise {
                target += 1
            } else {
                target -= 1
            }
            target = Dragon.on_ring(target, dr.fight and dr.crystals >= 0)
            dr.path = dr.find_path(current, usize.wrap(target), dr.first_node(), none)
            dr.path_next = 0
            dr.advance()
        }
        self.dragon_next_target(mut dr)
    }

    // `DragonLandingApproachPhase.findNewTarget` (D613): where it has no path or has flown it,
    // one from the node nearest it to the egg, by the node nearest 40 from the middle across from
    // the player nearest the egg, `NEAR_EGG_TARGETING`, 105 up, else the node nearest 40 east at
    // the egg's height; then its next node, and where that was the egg, it lands.
    fn approach_new_target<B: NavLevel>(mut self, dr: mut Dragon, blocks: B, players: List<Follower>, min_y: i32) {
        if dr.path == none or dr.path_done() {
            let current = self.dragon_closest_node(mut dr, blocks, min_y)
            let egg_y = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, 0, 0) ?? min_y
            var target: usize = 0
            if let near = nearest_to_egg(players, egg_y) {
                let (_, px, _, pz) = near
                let length = (px * px + 0.0 * 0.0 + pz * pz).sqrt()
                let (ax, az) = if length < f64(1.0e-5f32) { (0.0, 0.0) } else { (px / length, pz / length) }
                target = dr.closest_node(-ax * 40.0, 105.0, -az * 40.0, dr.first_node())
            } else {
                target = dr.closest_node(40.0, f64(egg_y), 0.0, dr.first_node())
            }
            dr.path = dr.find_path(current, target, dr.first_node(), some((0, egg_y, 0)))
            dr.path_next = 0
            dr.advance()
        }
        self.dragon_next_target(mut dr)
        if dr.path != none and dr.path_done() {
            self.dragon_phase_to(mut dr, LANDING)
        }
    }

    // `DragonTakeoffPhase.findNewTarget` (D613): a path from the node nearest it to the one nearest
    // 40 behind where its head looks, 105 up, kept on the outer circle where its fight counts
    // crystals alive, else on the middle (D626); then, past the node it starts at, its next,
    // `navigateToNextPathNode`.
    fn takeoff_new_target<B: NavLevel>(mut self, dr: mut Dragon, blocks: B, min_y: i32) {
        let current = self.dragon_closest_node(mut dr, blocks, min_y)
        let (lx, _, lz) = self.dragon_head_look(dr, blocks, min_y)
        var target = i32.wrap(dr.closest_node(-lx * 40.0, 105.0, -lz * 40.0, dr.first_node()))
        target = Dragon.on_ring(target, dr.fight and dr.crystals > 0)
        dr.path = dr.find_path(current, usize.wrap(target), dr.first_node(), none)
        dr.path_next = 0
        if dr.path != none {
            dr.advance()
            self.dragon_next_target(mut dr)
        }
    }

    // `DragonStrafePlayerPhase.setTarget` of the player `id` at px, py, pz, on its state `dr`
    // (D619): its path from the node nearest it to the node nearest them, `findClosestNode`,
    // ending above their block, 0.4 in floats more than an 80th of how far across that is from
    // it, less 1, up to 10; then, past the node it starts at, its next, `navigateToNextPathNode`.
    fn strafe_set_target<B: NavLevel>(mut self, dr: mut Dragon, blocks: B, min_y: i32, id: i32, px: f64, py: f64, pz: f64) {
        dr.strafe_target = some(id)
        let current = self.dragon_closest_node(mut dr, blocks, min_y)
        let target = dr.closest_node(px, py, pz, dr.first_node())
        let (bx, bz) = (i32.saturate(px.floor()), i32.saturate(pz.floor()))
        let xd = f64(bx) - self.living.body.x
        let zd = f64(bz) - self.living.body.z
        let sd = (xd * xd + zd * zd).sqrt()
        let ho = (f64(0.4f32) + sd / 80.0 - 1.0).min(10.0)
        let by = i32.saturate((py + ho).floor())
        dr.path = dr.find_path(current, target, dr.first_node(), some((bx, by, bz)))
        dr.path_next = 0
        if dr.path != none {
            dr.advance()
            self.dragon_next_target(mut dr)
        }
    }

    // `DragonStrafePlayerPhase.doServerTick` (D619), on its state `dr`, `heard` the sounds of its
    // tick so far: with no one to strafe, its holding pattern; else, where it's flown its path,
    // its target above them, 0.4 in floats more than an 80th of how far across they are, less 1,
    // up to 10; a new target where it's within 10 of its own or more than 150 off,
    // `strafe_new_target`; then, where they're within 64 and in its sight, `hasLineOfSight`, its
    // charge toward its fireball one more, and where that's 5 and it faces within 10 degrees of
    // them across, a half added in floats, its shot, `strafe_shoot`; out of sight or out of
    // reach, its charge one less where it's any. A player it strafes who's gone from its level,
    // whom vanilla's strafes still, is said missing.
    fn dragon_strafe<B: CollisionBlocks + NavLevel>(mut self, dr: mut Dragon, m: MovementStates, f: Facts, blocks: B, players: List<Follower>, min_y: i32, heard: usize) {
        let id = dr.strafe_target else {
            self.dragon_phase_to(mut dr, HOLDING_PATTERN)
            return
        }
        var found: Follower? = none
        for p in players {
            if p.id == id {
                found = some(p.copy())
            }
        }
        let p = found else {
            self.living.show(Shown.Missing(String("An ender dragon's strafe of a player gone from its level")), heard)
            return
        }
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        if dr.path != none and dr.path_done() {
            let (dx, dz) = (p.x - x, p.z - z)
            let dist = (dx * dx + dz * dz).sqrt()
            let offset = (f64(0.4f32) + dist / 80.0 - 1.0).min(10.0)
            dr.target = some((p.x, p.y + offset, p.z))
        }
        var to_target = 0.0
        if let t = dr.target {
            let (tx, ty, tz) = t
            to_target = (tx - x) * (tx - x) + (ty - y) * (ty - y) + (tz - z) * (tz - z)
        }
        if to_target < 100.0 or to_target > 22500.0 {
            self.strafe_new_target(mut dr, blocks, min_y)
        }
        let (ex, ey, ez) = (p.x - x, p.y - y, p.z - z)
        let who = self.looker()
        if not (ex * ex + ey * ey + ez * ez < 4096.0) or not sees(m, f, blocks, who.mover, who.x, who.eye_y, who.z, p.x, p.y + f64(p.eyes), p.z) {
            if dr.fireball_charge > 0 {
                dr.fireball_charge -= 1
            }
            return
        }
        dr.fireball_charge += 1
        let (ax, _, az) = normalized_of(p.x - x, 0.0, p.z - z)
        let turn = self.living.body.y_rot * 0.017453292f32
        let (fx, _, fz) = normalized_of(f64(table_sin(f64(turn))), 0.0, f64(-table_cos(f64(turn))))
        let dot = f32.nearest(fx * ax + 0.0 * 0.0 + fz * az)
        let angle = f32.nearest(acos(f64(dot)) * 180.0 / f64(f32.nearest(3.141592653589793))) + 0.5f32
        if dr.fireball_charge >= 5 and angle >= 0.0f32 and angle < 10.0f32 {
            self.strafe_shoot(mut dr, p, heard)
        }
    }

    // A strafe's shot at the player `p` (D619): from a block behind its head along where it
    // looks, `getViewVector`, its head's turn, `yHeadRot`, a living entity's view's, not its
    // body's, at its head's middle and half a block up, toward their middle,
    // `getY(0.5)`; level event 1017 at its block where it isn't silent; then the fireball its level
    // makes, `Shown.FireballShot`; its charge none, and its holding pattern, whose begin forgets
    // the path it flew to the end.
    fn strafe_shoot(mut self, dr: mut Dragon, p: Follower, heard: usize) {
        let (vx, _, vz) = view_vector(self.living.body.x_rot, self.living.y_head_rot)
        let (hx, hy, hz) = dr.parts[HEAD]
        let sx = hx - vx * 1.0
        let sy = hy + f64(1.0f32) * 0.5 + 0.5
        let sz = hz - vz * 1.0
        let way = (p.x - sx, p.y + f64(p.height) * 0.5 - sy, p.z - sz)
        if not self.living.data.flag(SILENT) {
            let (bx, by, bz) = self.living.body.block()
            self.living.show(Shown.Level((1017, bx, by, bz, 0)), heard)
        }
        let owner = self.living.body.uuid
        self.living.show(Shown.FireballShot(((sx, sy, sz), way, owner)), heard)
        dr.fireball_charge = 0
        self.dragon_phase_to(mut dr, HOLDING_PATTERN)
    }

    // `DragonStrafePlayerPhase.findNewTarget` (D619): where it has no path or has flown it, a new
    // one, from the node nearest it to the next the way its strafe flies round, which turns about
    // 1 in 8, drawn, and goes 6 on, `holdingPatternClockwise`, the strafe's own, on the outer
    // circle where its fight counts crystals alive, else on the middle (D626); then its next node,
    // up to 20 above it, drawn, `navigateToNextPathNode`.
    fn strafe_new_target<B: NavLevel>(mut self, dr: mut Dragon, blocks: B, min_y: i32) {
        if dr.path == none or dr.path_done() {
            let current = self.dragon_closest_node(mut dr, blocks, min_y)
            var target = i32.wrap(current)
            if self.living.body.random.next_int_below(8) == 0 {
                dr.strafe_clockwise = not dr.strafe_clockwise
                target += 6
            }
            if dr.strafe_clockwise {
                target += 1
            } else {
                target -= 1
            }
            target = Dragon.on_ring(target, dr.fight and dr.crystals > 0)
            dr.path = dr.find_path(current, usize.wrap(target), dr.first_node(), none)
            dr.path_next = 0
            if dr.path != none {
                dr.advance()
            }
        }
        self.dragon_next_target(mut dr)
    }

    // `navigateToNextPathNode` (D613): where its path isn't flown, its target its next node, up to
    // 20 above it, drawn, in floats.
    fn dragon_next_target(mut self, dr: mut Dragon) {
        if let node = dr.next_node() {
            let (nx, ny, nz) = node
            let up = f32.nearest(f64(ny)) + self.living.body.random.next_float() * 20.0f32
            dr.target = some((f64(nx), f64(up), f64(nz)))
        }
    }

    // `getHeadLookVector(1)` (D613): where it lands or takes off, its look at the egg's height,
    // tipped up 7.5 over its distance from the egg's middle over 4, 1 at least; where it sits, 45
    // up; else its own, its head's turn its look's, `getViewYRot`.
    fn dragon_head_look<B: NavLevel>(self, dr: Dragon, blocks: B, min_y: i32) -> (f64, f64, f64) {
        var x_rot = self.living.body.x_rot
        if dr.phase == LANDING or dr.phase == TAKEOFF {
            let egg_y = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, 0, 0) ?? min_y
            let cx = 0.5 - self.living.body.x
            let cy = f64(egg_y) + 0.5 - self.living.body.y
            let cz = 0.5 - self.living.body.z
            let dist = most_of_float(f32.nearest((cx * cx + cy * cy + cz * cz).sqrt()) / 4.0f32, 1.0f32)
            let y_offset = 6.0f32 / dist
            x_rot = -y_offset * 1.5f32 * 5.0f32
        } else if dr.sitting() {
            x_rot = -45.0f32
        }
        return view_vector(x_rot, self.living.y_head_rot)
    }

    // `DragonSittingScanningPhase.doServerTick` (D613), as `dragon_phase_tick` has it.
    fn dragon_scan<B: CollisionBlocks>(mut self, dr: mut Dragon, m: MovementStates, f: Facts, blocks: B, players: List<Follower>) {
        dr.scan_time += 1
        if let near = self.dragon_sees_player(m, f, blocks, players, 20.0, true) {
            let (px, _, pz) = near
            if dr.scan_time > 25 {
                self.dragon_phase_to(mut dr, SITTING_ATTACKING)
                return
            }
            let (x, z) = (self.living.body.x, self.living.body.z)
            let (ax, _, az) = normalized_of(px - x, 0.0, pz - z)
            let turn = self.living.body.y_rot * 0.017453292f32
            let (fx, _, fz) = normalized_of(f64(table_sin(f64(turn))), 0.0, f64(-table_cos(f64(turn))))
            let dot = f32.nearest(fx * ax + 0.0 * 0.0 + fz * az)
            let angle = f32.nearest(acos(f64(dot)) * 180.0 / f64(f32.nearest(3.141592653589793))) + 0.5f32
            if angle < 0.0f32 or angle > 10.0f32 {
                let (hx, _, hz) = dr.parts[HEAD]
                let xd = px - hx
                let zd = pz - hz
                let toward = table_atan2(xd, zd) ?? f64.NAN
                let delta = clamp_double(wrap_degrees_f64(180.0 - toward * 180.0 / f64(f32.nearest(3.141592653589793)) - f64(self.living.body.y_rot)), -100.0, 100.0)
                dr.y_rot_a = dr.y_rot_a * 0.8f32
                var dist = f32.nearest((xd * xd + zd * zd).sqrt()) + 1.0f32
                let rot_speed = dist
                if dist > 40.0f32 {
                    dist = 40.0f32
                }
                dr.y_rot_a = dr.y_rot_a + f32.nearest(delta) * (0.7f32 / dist / rot_speed)
                let turned = self.living.body.y_rot + dr.y_rot_a
                if turned - turned == 0.0f32 {
                    self.living.body.y_rot = turned
                }
            }
        } else if dr.scan_time >= 100 {
            let charged = self.dragon_sees_player(m, f, blocks, players, 150.0, false)
            self.dragon_phase_to(mut dr, TAKEOFF)
            if let at = charged {
                self.dragon_phase_to(mut dr, CHARGING_PLAYER)
                dr.target = some(at)
            }
        }
    }

    // The nearest player it may attack, `getNearestPlayer` with `TargetingConditions.forCombat()`
    // and the range `range`, from where it is (D613): seen by anyone and alive, within 10 above
    // or below where `level` is asked, `scanTargeting`'s; seen as an enemy, within the range times
    // how visible they are to it, 2 at least, and in its sight, which it keeps for good, as it
    // never thinks as a mob does, `Sensing`; the first of the nearest. No teams, so none allied.
    fn dragon_sees_player<B: CollisionBlocks>(mut self, m: MovementStates, f: Facts, blocks: B, players: List<Follower>, range: f64, level: bool) -> (f64, f64, f64)? {
        let who = self.looker()
        var best = -1.0
        var found: (f64, f64, f64)? = none
        for p in players {
            if p.spectator or p.dead {
                continue
            }
            if level and (p.y - who.y).abs() > 10.0 {
                continue
            }
            if not p.enemy {
                continue
            }
            let visibility = p.visibility(who.kind)
            let within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
            let fx = who.x - p.x
            let fy = who.y - p.y
            let fz = who.z - p.z
            if fx * fx + fy * fy + fz * fz > within * within {
                continue
            }
            if not sees_player(m, f, blocks, mut self.sensing, who, p) {
                continue
            }
            let dx = p.x - who.x
            let dy = p.y - who.y
            let dz = p.z - who.z
            let d = dx * dx + dy * dy + dz * dz
            if best == -1.0 or d < best {
                best = d
                found = some((p.x, p.y, p.z))
            }
        }
        return found
    }

    // `EnderDragon.findClosestNode()` on its state `dr` (D613): its nodes made the first time,
    // each 73 up at least, else the given height above the top of its column, `getHeightmapPos`
    // with `MOTION_BLOCKING_NO_LEAVES`, the level's bottom where its chunk isn't loaded; then the
    // nearest of the inner two circles, as it has no fight.
    fn dragon_closest_node<B: NavLevel>(self, dr: mut Dragon, blocks: B, min_y: i32) -> usize {
        if dr.nodes.is_empty() {
            for i in 0..NODES {
                let (nx, nz, above) = node_across(i)
                let ground = blocks.column_height(MOTION_BLOCKING_NO_LEAVES, nx, nz) ?? min_y
                let ny = if ground + above > 73 { ground + above } else { 73 }
                dr.nodes.push((nx, ny, nz))
            }
        }
        return dr.closest_node(self.living.body.x, self.living.body.y, self.living.body.z, dr.first_node())
    }

    // `EnderDragon.checkWalls` on the boxes of its head, neck and body in turn, each looked at
    // (D611): a block in one that isn't air or `#dragon_transparent` it breaks where mob griefing's
    // on and it isn't `#dragon_immune`; else it's a wall it's in, which slows it. Where it would
    // break one, its level checks them in turn as it has them then, breaking each, as a break may
    // change what's later in its boxes, `Shown.Walls` (D614), once its strikes are dealt (D615);
    // else whether it's in a wall is known here. A block whose chunk isn't loaded, which
    // vanilla's would load, is said missing. Whether it's in a wall, and whether it would break.
    fn dragon_walls<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, dr: Dragon, heard: usize) -> (bool, bool) {
        var hit = false
        var breaks = false
        var unloaded = false
        for k in [HEAD, NECK, BODY] {
            let b = dr.boxed(k)
            let (x0, y0, z0) = (i32.saturate(b.min_x.floor()), i32.saturate(b.min_y.floor()), i32.saturate(b.min_z.floor()))
            let (x1, y1, z1) = (i32.saturate(b.max_x.floor()), i32.saturate(b.max_y.floor()), i32.saturate(b.max_z.floor()))
            for x in x0..=x1 {
                for y in y0..=y1 {
                    for z in z0..=z1 {
                        let state = blocks.collision_state(x, y, z) else {
                            unloaded = true
                            continue
                        }
                        if f.is_air(state) or f.in_set(state, lf.dragon_transparent) {
                            continue
                        }
                        if self.mob_griefing and not f.in_set(state, lf.dragon_immune) {
                            breaks = true
                        } else {
                            hit = true
                        }
                    }
                }
            }
        }
        if unloaded {
            self.living.show(Shown.Missing(String("An ender dragon's flight into a chunk not loaded")), heard)
        }
        return (hit, breaks)
    }

    // An ender dragon's breath at its flame's 10th tick, `DragonSittingFlamingPhase.doServerTick`
    // (D617), on its state `dr`, `heard` the sounds of its tick so far: the cloud it leaves, 2.5
    // past its head the way its head is from it across, `normalize`, at its head's middle's
    // height, or, where that's air, `isEmptyBlock`, as far down as there's air, but where that
    // falls below 0, not the level's bottom, at its head's middle's height after all; then a
    // block above the block it's in. Its level makes it, `Shown.Breathed`. A block whose chunk
    // isn't loaded, which vanilla's would load, ends the search, said missing.
    fn dragon_breath<B: CollisionBlocks>(mut self, dr: Dragon, f: Facts, blocks: B, heard: usize) {
        let (hx, hy, hz) = dr.parts[HEAD]
        let (lx, _, lz) = normalized_of(hx - self.living.body.x, 0.0, hz - self.living.body.z)
        let x = hx + lx * 5.0 / 2.0
        let z = hz + lz * 5.0 / 2.0
        let initial = hy + 0.5
        var y = initial
        let (bx, bz) = (i32.saturate(x.floor()), i32.saturate(z.floor()))
        loop {
            let state = blocks.collision_state(bx, i32.saturate(y.floor()), bz) else {
                self.living.show(Shown.Missing(String("An ender dragon's breath over a chunk not loaded")), heard)
                break
            }
            if not f.is_air(state) {
                break
            }
            y -= 1.0
            if y < 0.0 {
                y = initial
                break
            }
        }
        let at = (x, y.floor() + 1.0, z)
        let owner = self.living.body.uuid
        self.living.show(Shown.Breathed((at, owner)), heard)
    }

    // `DragonSittingFlamingPhase.end`'s discard of the cloud of its breath that ended, on its
    // state `dr`, `heard` the sounds of its tick so far, which its level does, `Shown.Quenched`
    // (D617).
    fn dragon_quench(mut self, dr: mut Dragon, heard: usize) {
        let gone = dr.quench else return
        dr.quench = none
        self.living.show(Shown.Quenched(gone), heard)
    }

    /// The cloud of an ender dragon's breath, by entity ID, as its level made it (D617).
    pub fn set_dragon_flame(mut self, cloud: i32) {
        var dr = self.dragon.take() else return
        dr.flame = some(cloud)
        self.dragon = some(dr)
    }

    /// Whether an ender dragon is in a wall, `inWall`, as its level found it breaking what it
    /// flies into (D614).
    pub fn set_dragon_in_wall(mut self, hit: bool) {
        var dr = self.dragon.take() else return
        dr.in_wall = hit
        self.dragon = some(dr)
    }

    // `EnderDragon.tickDeath` (D608), `heard` the sounds of its tick so far: its fight told it was
    // seen, where it's its fight's dragon, `updateDragon` (D626); its death a tick on; from its
    // 180th to its 200th, three floats drawn for its big explosions' place, which only clients
    // show; past its 150th, each 5th where mob drops are on, 8 in 100 of its experience, 500, or
    // 12,000 where it has a fight in which no dragon was killed before, given where it is,
    // `ExperienceOrb.award`; at its first, unless it's silent, level event 1028 at its block for
    // every player, `globalLevelEvent`; then it and its parts lifted a tenth of a block, as it has
    // no physics; and at its 200th, where mob drops are on, a fifth of its experience given, its
    // fight told it was killed, where it's the fight's dragon, `setDragonKilled` (D627), and it's
    // gone, `remove(KILLED)`.
    fn dragon_death(mut self, lf: LivingFacts, heard: usize) {
        var dr = self.dragon.take() else return
        if dr.fight and dr.ours {
            let progress = self.living.health() / self.living.max_health(lf)
            self.living.show(Shown.DragonSeen(progress), heard)
        }
        dr.death_time += 1
        let t = dr.death_time
        if t >= 180 and t <= 200 {
            for _ in 0..3 {
                _ = self.living.body.random.next_float()
            }
        }
        let experience = if dr.fight and not dr.killed_before { FIRST_DEATH_EXPERIENCE } else { DEATH_EXPERIENCE }
        let (x, y, z) = (self.living.body.x, self.living.body.y, self.living.body.z)
        if t > 150 and t % 5 == 0 and self.mob_drops {
            let some_of = i32.saturate(f64(f32.nearest(experience) * 0.08f32).floor())
            self.living.show(Shown.Awarded((x, y, z, some_of)), heard)
        }
        if t == 1 and not self.living.silent() {
            let (bx, by, bz) = (i32.saturate(x.floor()), i32.saturate(y.floor()), i32.saturate(z.floor()))
            self.living.show(Shown.Global((1028, bx, by, bz, 0)), heard)
        }
        let lift = f64(0.1f32)
        self.living.body.y = y + lift
        dr.move_parts(0.0, lift, 0.0)
        if t >= 200 {
            if self.mob_drops {
                let fifth = i32.saturate(f64(f32.nearest(experience) * 0.2f32).floor())
                let (fx, fy, fz) = (self.living.body.x, self.living.body.y, self.living.body.z)
                self.living.show(Shown.Awarded((fx, fy, fz, fifth)), heard)
            }
            if dr.fight and dr.ours {
                self.living.show(Shown.DragonKilled, heard)
            }
            self.living.body.removed = true
        }
        self.dragon = some(dr)
    }

    // `hurtServer` as any mob has it, `LivingEntity`'s and its kind's, as `hurt` tells.
    fn hurt_as_living(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, ward: Ward, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        let start = sounds.len()
        // An iron golem's cracks as it was, `getCrackiness` (CAL-201).
        let cracks = self.golem_cracks(lf)
        let invulnerable = self.living.invulnerable_to(types, d, self.living.fire_immune, ward.immune)
        if self.species == ENDERMAN and not invulnerable and types.is(d.kind, IS_PROJECTILE) {
            // `Enderman.hurtServer`: not a passenger, as none are yet, it dodges, not hurt, nor
            // `LivingEntity.hurtServer`'s at all, so its idle time goes on.
            self.dodge_due = true
            return Hurt()
        }
        if self.species == SHULKER and self.shulker_raw_peek() == 0 and (d.kind == types.id("arrow") or d.kind == types.id("trident")) {
            // `Shulker.hurtServer`: closed, an arrow or a trident, `AbstractArrow`, bounces off,
            // not `LivingEntity.hurtServer`'s at all (CAL-200).
            return Hurt()
        }
        if self.species == BEE and not invulnerable {
            // `Bee.hurtServer`: its pollinating stopped, `stopPollinating` (CAL-177).
            self.bee.pollinating = false
        }
        if self.species == SILVERFISH and not invulnerable and (d.cause != -1 or types.is(d.kind, ALWAYS_TRIGGERS_SILVERFISH)) {
            // `Silverfish.hurtServer` (CAL-172): hurt by something, or by what always wakes them,
            // `#always_triggers_silverfish`, it's to wake its friends, before the rest.
            self.notify_hurt()
        }
        let fire_resistant = self.living.has_effect(FIRE_RESISTANCE)
        let shrugged = invulnerable or self.living.dead_or_dying() or (types.is(d.kind, IS_FIRE) and fire_resistant)
        if not shrugged and self.living.sleeping != none {
            // `hurtServer` wakes it, and its death would, getting it up where the blocks around
            // it have room, which a hurt doesn't see yet (CAL-160).
            missing.push(String("A sleeping mob woken by a hurt, stopSleeping"))
        }
        if not shrugged {
            self.no_action_time = 0
        }
        // `Wolf.hurtServer`: no longer ordered to sit (CAL-201).
        if self.species == WOLF {
            self.wolf.sitting = false
        }
        let immune = self.living.fire_immune
        var dealt = amount
        if self.species == ARMADILLO {
            // `Armadillo.hurtServer`: scared, a point less and halved; and its `actuallyHurt`,
            // where it has its AI, isn't scared and can stay rolled up, stopping it as a living
            // entity's hurt rolls it up, before its knockback (CAL-160).
            if self.scared() {
                dealt = (amount - 1.0f32) / 2.0f32
            }
            let by_living = d.player != none or d.living_cause
            self.living.still_on_hurt = by_living and not self.no_ai() and not self.scared() and self.can_stay_rolled_up()
        }
        var h = self.living.hurt_server(lf, types, d, dealt, now, fire_resistant, immune, ward, mut sounds, mut missing)
        self.living.still_on_hurt = false
        if h.actually and self.species == ARMADILLO {
            // Its rolling up's sound, in `actuallyHurt`, before its damage event.
            self.armadillo_hurt(types, d, h.stilled, mut sounds)
            h.early = sounds.len() - start
        }
        if h.actually and self.animal {
            self.in_love = 0
        }
        if self.species == VILLAGER and h.hurt and self.living.angered_by(lf, types, d) {
            // `resolveMobResponsibleForDamage`, its `setLastHurtByMob`: a villager hears 25 minor
            // negative gossip of what hurt it, a player or a mob (D676), `onReputationEvent`; its
            // offers priced again where that's the player it's trading with, and it shows its
            // anger at a player where it's alive, entity event 13, before its damage event
            // (CAL-160).
            if let who = d.player ?? d.mob {
                self.gossips.add(who, MINOR_NEGATIVE, 25)
            }
            if let who = d.player {
                // Its offers priced again where it's trading with them, sent to them.
                if let t = self.trading {
                    if t.uuid == who {
                        self.update_special_prices(who)
                        h.repriced = true
                    }
                }
                h.angry = self.living.alive()
            }
        }
        let (hurt_sound, death_sound) = self.hurt_and_death()
        if h.dies {
            if h.full {
                let pitch = self.voice_pitch()
                self.living.play(mut sounds, death_sound, self.sound_volume, pitch)
                self.thorns_hit(types, d, mut sounds)
            }
        } else if h.hurt_sound {
            self.ambient_sound_time = -self.ambient_interval
            let pitch = self.voice_pitch()
            // A wolf whose armor took it heard as its armor, `Wolf.getHurtSound` (CAL-201).
            let heard_as = if self.living.wolf_armor_absorbs(types, d) { String("item.wolf_armor.damage") } else { hurt_sound }
            self.living.play(mut sounds, heard_as, self.sound_volume, pitch)
            self.thorns_hit(types, d, mut sounds)
        }
        if h.hurt and self.living.has_effect(INFESTED) {
            // Its effects' `onMobHurt`, as `hurtServer` ends: infested's silverfish (CAL-274).
            let b = self.living.body.copy()
            let fish = infested_silverfish(mut self.living.body.random, b.x, b.y, b.z, b.height, b.x_rot, b.y_rot)
            if not fish.is_empty() {
                self.living.show(Shown.Infested(fish), sounds.len())
            }
        }
        if self.species == ENDERMAN and not invulnerable and not d.living_cause and d.player == none {
            // `Enderman.hurtServer`'s last: by no living entity, neither a mob nor a player, it
            // teleports 9 in 10, drawn, where it has its blocks, `hurt_teleport` (CAL-159).
            if self.living.body.random.next_int_below(10) != 0 {
                self.teleport_due = true
            }
        }
        if self.species == IRON_GOLEM and h.hurt and self.golem_cracks(lf) != cracks {
            // `IronGolem.hurtServer`'s last: hurt, its cracks changed, heard (CAL-201).
            self.living.play(mut sounds, String("entity.iron_golem.damage"), 1.0f32, 1.0f32)
        }
        if self.species == SHULKER and h.hurt {
            // `Shulker.hurtServer`'s last (CAL-200): below half its health, 1 in 4, drawn, it
            // teleports, `teleportSomewhere`, which its `hurt_teleport` does with its level.
            // Hurt by a shulker's bullet otherwise, it would split, which waits on the bullet.
            if f64(self.living.health()) < f64(self.living.max_health(lf)) * 0.5 and self.living.body.random.next_int_below(4) == 0 {
                self.teleport_due = true
            }
        }
        return h
    }

    // An iron golem's cracks, `Crackiness.GOLEM.byFraction` of its health over its most: 0 above
    // three quarters, then 1, 2, and 3 below a quarter; none for any other mob (CAL-201).
    fn golem_cracks(self, lf: LivingFacts) -> i32 {
        if self.species != IRON_GOLEM {
            return 0
        }
        let fraction = self.living.health() / self.living.max_health(lf)
        return if fraction < 0.25f32 { 3 } else if fraction < 0.5f32 { 2 } else if fraction < 0.75f32 { 1 } else { 0 }
    }

    // `Armadillo.actuallyHurt`'s, after the hurt's dealt, where it has its AI and isn't dying
    // (CAL-160): hurt by a living entity, danger seen for 80 ticks and, where it can stay rolled
    // up, rolled up, already still where `stilled`; else by what's `#panic_environmental_causes`,
    // rolled out. Its roll's heard before its hurt.
    fn armadillo_hurt(mut self, types: DamageTypes, d: Damage, stilled: bool, sounds: mut List<EntitySound>) {
        if self.no_ai() or self.living.dead_or_dying() {
            return
        }
        if d.player != none or d.living_cause {
            if let held = self.brain.take() {
                var brain = held
                brain.set_for(MEMORY_DANGER_DETECTED_RECENTLY, Memo.Flag(true), 80)
                self.brain = some(brain)
            }
            if self.can_stay_rolled_up() {
                self.roll_up(not stilled, mut sounds)
            }
        } else if types.is(d.kind, PANIC_ENVIRONMENTAL_CAUSES) {
            self.roll_out(mut sounds)
        }
    }

    // `playSecondaryHurtSound`, after its hurt or death sound: hurt by `thorns`, thorns' hit where
    // it is, heard as hostile whatever it is, and where it's silent, as the level plays it
    // (CAL-159).
    fn thorns_hit(self, types: DamageTypes, d: Damage, sounds: mut List<EntitySound>) {
        if d.kind == types.id("thorns") {
            sounds.push(EntitySound { sound: String("enchant.thorns.hit"), x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 1.0f32, pitch: 1.0f32, source: HOSTILE_SOURCE })
        }
    }

    /// `repeatedlyTryToTeleport`, where a projectile's hurt left an enderman to dodge it (CAL-159):
    /// up to 64 of its teleports drawn, `teleport()`, till one works, `min_y` its level's floor.
    /// Whether it was to.
    pub fn dodge<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32, sounds: mut List<EntitySound>) -> bool {
        if not self.dodge_due {
            return false
        }
        self.dodge_due = false
        for _ in 0..64 {
            if self.teleport(lf, f, m, blocks, min_y, mut sounds) {
                break
            }
        }
        return true
    }

    // The teleport an enderman's hurt drew, `Enderman.teleport()`, done, and a dodge its level
    // didn't do (CAL-159).
    fn hurt_teleport<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, sounds: mut List<EntitySound>) {
        let floor = self.floor_y
        _ = self.dodge(lf, f, m, blocks, floor, mut sounds)
        if self.teleport_due {
            self.teleport_due = false
            if self.species == SHULKER {
                _ = self.shulker_teleport(f, m, blocks, floor, mut sounds)
            } else {
                _ = self.teleport(lf, f, m, blocks, floor, mut sounds)
            }
        }
    }

    /// What what it wears and holds does against the damage `d` of `types`, enchanted, as its level
    /// `blocks` works it out, `Living.ward` (D439), itself to loot as it is, and `attacker`, a
    /// player, where that caused it and dealt it.
    pub fn ward<B: Warding, W: Wearing>(self, blocks: B, items: W, types: DamageTypes, d: Damage, attacker: LootEntity?, missing: mut List<String>) -> Ward {
        return self.living.ward(blocks, items, types, d, self.loot_entity(), attacker, mut missing)
    }

    /// What its kind does after `LivingEntity.hurtServer`, its death's draws done, where `h` hurt
    /// it by `source`, on hard or not (D416): a horse stands 1 in 3, drawn, `standIfPossible`; and
    /// on hard a zombie with a target, or hurt by what's living, its target then, draws for its
    /// reinforcements under their chance, `Zombie.hurtServer` (CAL-159). The target its
    /// reinforcements come for, for its level to call them, `world.natural`'s `reinforce`, where
    /// monsters may spawn; none where it calls none.
    pub fn after_hurt(mut self, h: Hurt, hard: bool, source: Damage) -> i32? {
        if h.hurt and self.equine() and self.living.body.random.next_int_below(3) == 0 and self.species != LLAMA {
            // `standIfPossible`, `setStanding(20)`.
            self.set_horse_flag(16, false)
            self.set_horse_flag(32, true)
            self.stand_counter = 20
        }
        let target = if let t = self.target { some(t) } else if source.player != none or source.living_cause { some(source.cause) } else { none }
        if h.hurt and hard and target != none and self.zombie_class() {
            let chance = self.living.attributes.value(attribute("spawn_reinforcements"))
            if f64(self.living.body.random.next_float()) < chance {
                return target
            }
        }
        return none
    }

    /// `setTarget` of `target`, as a reinforcement takes it up before it's finalized (CAL-159).
    pub fn take_target(mut self, target: i32) {
        self.target_to(some(target))
    }

    /// A reinforcement it called, `callee`, as `Zombie.hurtServer` charges them once it's added
    /// (CAL-159): its own chance of calling more 0.05 less again, `reinforcement_caller_charge`,
    /// and the callee's a float's 0.05 less, `reinforcement_callee_charge`, both permanent.
    pub fn charge_reinforcement(mut self, callee: mut Mob) {
        let chance = attribute("spawn_reinforcements")
        let caller = Identifier { namespace: "minecraft", path: String("reinforcement_caller_charge") }
        let was = self.living.attributes.modifier_amount(chance, caller) ?? 0.0
        self.living.attributes.take_off(chance, caller)
        self.living.attributes.add_permanent(chance, Modifier { id: caller, amount: was - 0.05, operation: ADD_VALUE })
        let charged = Identifier { namespace: "minecraft", path: String("reinforcement_callee_charge") }
        callee.living.attributes.add_permanent(chance, Modifier { id: charged, amount: f64(-0.05f32), operation: ADD_VALUE })
    }

    /// The player who made it fall in love, `getLoveCause`, by their UUID, as it keeps them,
    /// `LoveCause` (CAL-164).
    pub fn love_cause(self) -> (i64, i64)? {
        return uuid_of(self.kept, "LoveCause")
    }

    /// What its death's loot reads of it, `THIS_ENTITY` (D416): its type, whether it's on fire and
    /// a baby, its main hand, a sheep's colour and shearing, a slime's size, and a villager's type
    /// (CAL-160); and where it is and what it wears and holds (CAL-164).
    /// What an enchantment's location context's entity predicates read of it (CAL-218), as
    /// `loot_entity` has it, with whether it's on the ground and rides something, its known
    /// movement and its fall.
    pub fn located_entity(self) -> LootEntity {
        var e = self.loot_entity()
        e.on_ground = self.living.body.on_ground
        e.has_vehicle = self.living.body.vehicle != none
        e.moved_x = self.living.body.vx
        e.moved_y = self.living.body.vy
        e.moved_z = self.living.body.vz
        e.fall_distance = self.living.body.fall
        return e
    }

    /// Where the location-changed effect `index` of the enchantment `enchantment` in the slot
    /// `slot` is among those that hold, `located` (CAL-218), none where it isn't.
    pub fn located_at(self, slot: usize, enchantment: String, index: usize) -> usize? {
        for i in 0..self.located.len() {
            if self.located[i].slot == slot and self.located[i].entry.enchantment == enchantment and self.located[i].entry.index == index {
                return some(i)
            }
        }
        return none
    }

    /// An attribute's modifier of a location-changed effect put on it as the effect begins to
    /// hold, `addTransientModifier` (CAL-218): its ID, its amount and its operation, by name.
    pub fn put_located(mut self, id: String, name: String, amount: f64, operation: String) {
        let a = attribute_id(name.copy()) else return
        let modifier = match Identifier.parse(id.copy()) {
            ok(i) => i,
            err(_) => return,
        }
        let names = operation_names()
        var op = 0
        for i in 0..names.len() {
            if names[i] == operation {
                op = i32.wrap(i)
            }
        }
        self.living.attributes.replace(a, Modifier { id: modifier, amount: amount, operation: op })
    }

    /// What the location-changed effect `gone` undoes as it stops holding for it, `onDeactivated`
    /// (CAL-218): its attributes' modifiers taken off.
    pub fn located_off(mut self, gone: LocatedEntry) {
        for what in gone.what {
            if let Located.Attribute(id, name, _, _) = what {
                let a = attribute_id(name.copy()) else continue
                match Identifier.parse(id.copy()) {
                    ok(i) => self.living.attributes.take_off(a, i),
                    err(_) => {},
                }
            }
        }
    }

    pub fn loot_entity(self) -> LootEntity {
        var e = LootEntity { kind: String(type_name(self.species)), on_fire: self.living.body.fire > 0 or self.living.body.extras.contains("HasVisualFire"), baby: self.baby(), hand: self.living.equipment[0].copy(), at: some((self.living.body.x, self.living.body.y, self.living.body.z)), worn: self.living.equipment.copy(), name_known: true }
        if self.living.body.extras.contains("CustomName") {
            e.custom_name = some(self.living.body.extras["CustomName"].copy())
        }
        if self.species == SHEEP {
            e.sheep_color = some(String(dye_name(self.color())))
            e.sheared = self.sheared()
        } else if cube_kind(self.species) {
            e.cube_size = self.slime_size()
        } else if self.species == VILLAGER {
            let (kind, _, _) = self.living.data.villager(OWN + 1)
            e.villager_type = some(builtin_name(23, kind))
        } else if (self.species == COW or self.species == PIG or self.species == CHICKEN or self.species == WOLF or self.species == CAT) and self.variant >= 0 and usize.wrap(self.variant) < self.variant_names.len() {
            // Its variant, `minecraft:chicken/variant` and the like (CAL-176), a wolf's and a cat's too (CAL-201).
            let component = if self.species == COW { "minecraft:cow/variant" } else if self.species == PIG { "minecraft:pig/variant" } else if self.species == WOLF { "minecraft:wolf/variant" } else if self.species == CAT { "minecraft:cat/variant" } else { "minecraft:chicken/variant" }
            e.variant = some((String(component), self.variant_names[usize.wrap(self.variant)].copy()))
        } else if self.species == MOOSHROOM {
            // A mooshroom's type, `minecraft:mooshroom/variant`, red or brown (CAL-179).
            let kind = if self.living.data.number(MOOSHROOM_TYPE) == 1 { "brown" } else { "red" }
            e.variant = some((String("minecraft:mooshroom/variant"), String(kind)))
        }
        return e
    }

    /// Whether a player's use of it with `item` in hand asks for its offers, `getOffers`, where
    /// they're still to make (CAL-160): a grown villager's, alive, not used with a villager spawn
    /// egg, which hasn't made them yet, as it makes them as they're first asked for.
    pub fn offers_asked(self, item: String) -> bool {
        return self.species == VILLAGER and self.living.alive() and item != "minecraft:villager_spawn_egg" and not self.baby() and not self.kept.contains("Offers")
    }

    /// The trade set its offers come from, `VillagerProfession.getTrades` of its level (CAL-160):
    /// its profession's for its level, 1 to 5, as `minecraft:farmer/level_1`; none for no
    /// profession or a nitwit, which have no trades.
    pub fn trade_set(self) -> String? {
        let (_, profession, level) = self.living.data.villager(OWN + 1)
        let name = builtin_name(24, profession)
        if name == "minecraft:none" or name == "minecraft:nitwit" or level < 1 or level > 5 {
            return none
        }
        return some("{name}/level_{level}")
    }

    /// What its offers' loot reads, `addOffersFromTradeSet` (CAL-160): `ORIGIN`, its place, and
    /// `THIS_ENTITY`, itself; and `ADDITIONAL_COST_COMPONENT_ALLOWED` (D522).
    pub fn trade_params(self) -> LootParams {
        var params = LootParams()
        params.origin = some((self.living.body.x, self.living.body.y, self.living.body.z))
        params.this_entity = true
        params.this = some(self.loot_entity())
        params.additional_cost = true
        return params
    }

    /// Its offers made, `updateTrades` into a list made new, each as `MerchantOffer.CODEC` writes
    /// it, which it saves under `Offers`, `Recipes`, an empty list left out (CAL-160).
    pub fn set_offers(mut self, offers: own List<Tag>) {
        var m = JavaHashMap<String, Tag>()
        if not offers.is_empty() {
            m.insert(String("Recipes"), Tag.List(offers))
        }
        self.kept.insert(String("Offers"), Tag.Compound(m))
    }

    // `updateSpecialPrices(player)` (CAL-160): each offer's special price 0 again,
    // `resetSpecialPrices`, then, where the player's reputation with it isn't 0, less by it times
    // the offer's multiplier, floored, `addToSpecialPriceDiff`. The hero of the village's
    // discount waits for players' effects (CAL-163).
    fn update_special_prices(mut self, player: (i64, i64)) {
        if not self.kept.contains("Offers") {
            return
        }
        let held = self.kept["Offers"].copy()
        let Tag.Compound(m) = held else return
        if not m.contains("Recipes") {
            return
        }
        let Tag.List(offers) = m["Recipes"] else return
        let reputation = self.gossips.reputation(player)
        var priced = List<Tag>()
        for t in offers {
            let Tag.Compound(o) = t else {
                priced.push(t.copy())
                continue
            }
            var offer = o.copy()
            var diff = 0
            if reputation != 0 {
                let multiplier = if offer.contains("priceMultiplier") { offer["priceMultiplier"].number_float() ?? 0.0f32 } else { 0.0f32 }
                diff -= i32.saturate(f64(f32.nearest(reputation) * multiplier).floor())
            }
            if diff == 0 {
                _ = offer.remove("specialPrice")
            } else {
                offer.insert(String("specialPrice"), Tag.Int(diff))
            }
            priced.push(Tag.Compound(offer))
        }
        var kept = m.copy()
        kept.insert(String("Recipes"), Tag.List(priced))
        self.kept.insert(String("Offers"), Tag.Compound(kept))
    }

    /// `startTrading` with the player of the entity ID `id` and the UUID `uuid` (CAL-160): its
    /// offers priced by their reputation with it, `updateSpecialPrices`, then they're the player
    /// it trades with, `setTradingPlayer`, its ambient sound a trade's. Their merchant menu's the
    /// level's to open, `openTradingScreen`.
    pub fn start_trading(mut self, id: i32, uuid: (i64, i64)) {
        self.update_special_prices(uuid)
        self.trading = some(Trader { id: id, uuid: uuid })
        self.refresh_sounds()
    }

    /// `stopTrading`, `setTradingPlayer(null)`, as their merchant menu's closed or it has no offers
    /// (CAL-160): no player it trades with, its ambient sound its own again. Its offers keep their
    /// prices till they're set again.
    pub fn stop_trading(mut self) {
        self.trading = none
        self.refresh_sounds()
    }

    /// Its offers, `getOffers`, each as `MerchantOffer.CODEC` writes it, as it saves them under
    /// `Offers` (CAL-160).
    pub fn offers(self) -> List<Tag> {
        if not self.kept.contains("Offers") {
            return List<Tag>()
        }
        let Tag.Compound(m) = self.kept["Offers"] else return List<Tag>()
        if not m.contains("Recipes") {
            return List<Tag>()
        }
        return match m["Recipes"] {
            Tag.List(each) => each.copy(),
            _ => List<Tag>(),
        }
    }

    /// The translation key of its type's name, `getTypeName`, where it isn't its type's own: a
    /// villager's its profession's, as `entity.minecraft.villager.farmer` (CAL-160).
    pub fn type_name_key(self) -> String? {
        if self.species != VILLAGER {
            return none
        }
        let (_, profession, _) = self.living.data.villager(OWN + 1)
        let name = builtin_name(24, profession)
        let at = name.find(":") ?? 0
        return some("entity.{name[..at]}.villager.{name[at + 1..]}")
    }

    /// A villager's level, its data's, which its merchant menu shows (CAL-160).
    pub fn villager_level(self) -> i32 {
        let (_, _, level) = self.living.data.villager(OWN + 1)
        return level
    }

    /// `AbstractVillager.notifyTradeUpdated` (CAL-160): where 20 ticks have gone by since its
    /// ambient sound's timer was put back, it's put back, and it says yes where its trading
    /// player's payments buy something, else no.
    pub fn trade_updated(mut self, valid: bool, sounds: mut List<EntitySound>) {
        if self.ambient_sound_time > -self.ambient_interval + 20 {
            self.ambient_sound_time = -self.ambient_interval
            self.make_sound(mut sounds, if valid { "entity.villager.yes" } else { "entity.villager.no" })
        }
    }

    /// `AbstractVillager.notifyTrade` of its offer at `index` (CAL-160): the offer's uses up one,
    /// `increaseUses`, its ambient sound's timer put back, then `Villager.rewardTradeXp`: the
    /// orb's experience drawn, 3 to 6, from its own random, its experience up by the offer's, the
    /// player it trades with the one it last traded with, and where that's enough for its level,
    /// a level up, `increaseMerchantCareer`, and 5 more for the orb. The regeneration a level-up
    /// gives waits for mobs' effects (CAL-163), and the trade's advancement trigger for
    /// advancements.
    pub fn notify_trade(mut self, index: i32) -> TradeReward {
        var out = TradeReward()
        var offers = self.offers()
        if index < 0 or usize.wrap(index) >= offers.len() {
            return out
        }
        let at = usize.wrap(index)
        let Tag.Compound(o) = offers[at].copy() else return out
        var offer = o.copy()
        offer.insert(String("uses"), Tag.Int(int_or(offer, "uses", 0) + 1))
        let xp = int_or(offer, "xp", 1)
        let rewards = if offer.contains("rewardExp") { offer["rewardExp"].number_int() != some(0) } else { true }
        offers[at] = Tag.Compound(offer)
        self.set_offers(offers)
        self.ambient_sound_time = -self.ambient_interval
        var pop = 3 + self.living.body.random.next_int_below(4)
        self.villager_xp += xp
        self.last_traded = if let t = self.trading { some(t.uuid) } else { none }
        let (kind, profession, level) = self.living.data.villager(OWN + 1)
        if level >= 1 and level < 5 and self.villager_xp >= next_level_xp(level) {
            self.living.data.set(OWN + 1, Value.Villager(kind, profession, level + 1))
            out.leveled = true
            pop += 5
        }
        if rewards {
            out.orb = some(pop)
        }
        return out
    }

    /// `updateTrades` of a level it went up to, its offers `more` added to those it has (CAL-160).
    pub fn add_offers(mut self, more: own List<Tag>) {
        var offers = self.offers()
        for o in more {
            offers.push(o.copy())
        }
        self.set_offers(offers)
    }

    /// `updateSpecialPrices` for the player it trades with, where it trades with one, its offers
    /// priced by their reputation with it; whether it does (CAL-160).
    pub fn reprice(mut self) -> bool {
        let t = self.trading else return false
        self.update_special_prices(t.uuid)
        return true
    }

    /// Whether it has offers made, `getOffers` not empty.
    pub fn has_offers(self) -> bool {
        if not self.kept.contains("Offers") {
            return false
        }
        let Tag.Compound(m) = self.kept["Offers"] else return false
        if not m.contains("Recipes") {
            return false
        }
        return match m["Recipes"] {
            Tag.List(each) => not each.is_empty(),
            _ => false,
        }
    }

    /// The loot table of its death, `getLootTable`, its own where it was saved with one,
    /// `DeathLootTable`, else its type's, and the seed saved with it, `DeathLootTableSeed`, 0 for
    /// none (D416).
    pub fn death_loot(self) -> (String, i64) {
        let seed = if self.kept.contains("DeathLootTableSeed") { self.kept["DeathLootTableSeed"].number_long() ?? 0 } else { 0 }
        if self.kept.contains("DeathLootTable") {
            if let Tag.Str(t) = self.kept["DeathLootTable"] {
                return (t.copy(), seed)
            }
        }
        let name = type_name(self.species)
        return ("minecraft:entities/{name[10..]}", seed)
    }

    /// Its chance of dropping what's in the slot `slot` as it dies, `getDropChances`, as it was
    /// saved, `drop_chances`, else 0.085.
    pub fn drop_chance(self, slot: usize) -> f32 {
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(m) = self.kept["drop_chances"] {
                let name = slot_names()[slot].copy()
                if m.contains(name.copy()) {
                    return m[name].number_float() ?? 0.085f32
                }
            }
        }
        return 0.085f32
    }

    /// `Mob.dropCustomDeathLoot` (D416): what it wears and holds that it drops, in the slots'
    /// order, each slot's stack where it has one, it isn't cursed with vanishing,
    /// `prevent_equipment_drop`, a player killed it or it's kept, a chance above 1, and a float
    /// drawn from its random is under its chance; damaged, unless it's kept, by a draw of up to
    /// all but 3 of what it can take, and the slot left empty. Where a living thing killed it, the
    /// chance as its enchantments make it, `processEquipmentDropChance`, is the slot's in
    /// `chances` (D526); whether it's kept goes by its own all the same.
    pub fn equipment_drops<W: Wearing>(mut self, items: W, killed_by_player: bool, chances: List<f32>) -> List<Tag> {
        var out = List<Tag>()
        for slot in 0..self.living.equipment.len() {
            let base = self.drop_chance(slot)
            if base == 0.0f32 {
                continue
            }
            let preserve = base > 1.0f32
            let chance = if slot < chances.len() { chances[slot] } else { base }
            let held = self.living.equipment[slot].copy() else continue
            if vanishes(items, held.copy()) or not (killed_by_player or preserve) {
                continue
            }
            if not (self.living.body.random.next_float() < chance) {
                continue
            }
            var stack = held
            if not preserve {
                let most = int_component(items, stack.copy(), "minecraft:max_damage")
                let damageable = most != none and items.worn_component(stack.copy(), String("minecraft:unbreakable")) == none and items.worn_component(stack.copy(), String("minecraft:damage")) != none
                if damageable {
                    let m = most ?? 0
                    let inner = self.living.body.random.next_int_below((m - 3).max(1))
                    let taken = self.living.body.random.next_int_below(1 + inner)
                    stack = damaged_to(stack, (m - taken).max(0).min(m))
                }
            }
            out.push(stack)
            self.living.equipment[slot] = none
        }
        return out
    }

    /// Whether it picks up what lies near it at its `aiStep`'s end, `Mob.aiStep`'s looting
    /// (CAL-159): it may, `canPickUpLoot`, it's alive and not dead, and mob griefing's on.
    pub fn loots(self) -> bool {
        return self.picks_up_loot() and self.living.alive() and not self.living.dead and self.mob_griefing
    }

    /// `canPickUpLoot`: whether it may pick things up, a sulfur cube's while it holds no block
    /// (CAL-402).
    pub fn picks_up_loot(self) -> bool {
        if self.species == SULFUR_CUBE {
            return not self.has_body_item()
        }
        return self.can_pick_up_loot
    }

    /// The box it picks up items in, its own a block bigger across, `getPickupReach`, as every
    /// kind Calcite makes has it (CAL-159).
    pub fn pickup_box(self) -> Aabb {
        let b = self.living.body.bounding_box()
        return Aabb { min_x: b.min_x - 1.0, min_y: b.min_y, min_z: b.min_z - 1.0, max_x: b.max_x + 1.0, max_y: b.max_y, max_z: b.max_z + 1.0 }
    }

    /// `wantsToPickUp` of `stack` (CAL-159): anything it may hold, `canHoldItem`, but a glow ink
    /// sac for a zombie, `Zombie`'s, and a spear for a skeleton, `AbstractSkeleton`'s. A zombie
    /// holds anything but an egg, of `#eggs`, as a baby that rides something, `canHoldItem`
    /// (D710).
    pub fn wants_to_pick_up<W: Wearing>(self, lf: LivingFacts, f: Facts, items: W, stack: Tag) -> bool {
        if self.species == PIGLIN {
            // `Piglin.wantsToPickUp`: its own, where it may pick up loot, mob griefing on
            // (CAL-200).
            return self.can_pick_up_loot and self.mob_griefing and self.piglin_wants(lf, f, items, stack)
        }
        let item = held_name(some(stack.copy()))
        let zombie = self.zombie_class()
        // A zombified piglin wants what it may hold, glow ink sacs too,
        // `ZombifiedPiglin.wantsToPickUp` (CAL-200).
        if zombie and self.species != ZOMBIFIED_PIGLIN and item == "minecraft:glow_ink_sac" {
            return false
        }
        let egg = item == "minecraft:egg" or item == "minecraft:blue_egg" or item == "minecraft:brown_egg"
        if zombie and egg and self.baby() and self.living.body.vehicle != none {
            return false
        }
        // Nor a spear for a drowned, `Drowned.wantsToPickUp` (CAL-175); nor a bow or a crossbow for a
        // wither skeleton, `#wither_skeleton_disliked_weapons`, `WitherSkeleton.canHoldItem` (CAL-200).
        if self.species == WITHER_SKELETON and lf.wither_disliked.contains(item) {
            return false
        }
        // A piglin brute wants only golden axes, `PiglinBrute.wantsToPickUp` (CAL-200).
        if self.species == PIGLIN_BRUTE and item != "minecraft:golden_axe" {
            return false
        }
        return not ((self.skeletal() or self.species == DROWNED) and lf.spears.contains(item))
    }

    /// `equipItemIfPossible` of `stack` (CAL-159): what it equips of it, or none. Its slot,
    /// `getEquipmentSlotForItem`, where it may be equipped there, `isEquippableInSlot`; where
    /// what's in it may be replaced, `canReplaceCurrentItem`, or, for armor where it mayn't, the
    /// main hand where that's empty, what's there drops where it's something and a float drawn less
    /// a tenth, at least 0, is under its chance, `spawnAtLocation`, and it's equipped, one of it in
    /// a slot that holds one, `limit`, sure to drop, `setGuaranteedDrop`, and the mob kept from
    /// going, `persistenceRequired`.
    pub fn equip_if_possible<W: Wearing>(mut self, lf: LivingFacts, items: W, stack: Tag, sounds: mut List<EntitySound>) -> Tag? {
        var slot = self.slot_for(items, stack.copy())
        if not self.equippable_in(items, stack.copy(), slot) {
            return none
        }
        var current = self.living.equipment[slot].copy()
        var replace = self.can_replace(lf, items, stack.copy(), current.copy(), slot)
        if slot >= 2 and slot <= 6 and not replace {
            slot = 0
            current = self.living.equipment[0].copy()
            replace = current == none
        }
        if not replace {
            return none
        }
        if let old = current {
            let drawn = self.living.body.random.next_float() - 0.1f32
            if (if drawn > 0.0f32 { drawn } else { 0.0f32 }) < self.drop_chance(slot) {
                let spilled = Spilled { x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, stack: old }
                self.living.show(Shown.Spilled(spilled), sounds.len())
            }
        }
        let equipped = if slot >= 2 { one_of(some(stack.copy())) } else { stack.copy() }
        self.equip_in(items, slot, equipped.copy(), mut sounds)
        self.guarantee_drop(slot)
        self.persistence_required = true
        return some(equipped)
    }

    // The slot `stack` goes in, `getEquipmentSlotForItem`: its equippable's where it may use that
    // slot, else the main hand.
    fn slot_for<W: Wearing>(self, items: W, stack: Tag) -> usize {
        if let slot = equippable_slot(items, stack) {
            if self.can_use_slot(slot) {
                return slot
            }
        }
        return 0
    }

    // `isEquippableInSlot`: without an equippable, the main hand, where it may use it; with one,
    // its slot, where it may use it and its type's among those it allows, `canBeEquippedBy`, all
    // where it names none.
    fn equippable_in<W: Wearing>(self, items: W, stack: Tag, slot: usize) -> bool {
        let Tag.Compound(e) = items.worn_component(stack.copy(), String("minecraft:equippable")) ?? Tag.End else {
            return slot == 0 and self.can_use_slot(0)
        }
        if equippable_slot(items, stack) != some(slot) or not self.can_use_slot(slot) {
            return false
        }
        if not e.contains("allowed_entities") {
            return true
        }
        return items.worn_types(e["allowed_entities"].copy()).contains(i32.wrap(self.living.kind))
    }

    // `canUseSlot`: any but the saddle, which a pig uses alive and grown, `Pig`'s, a horse and a
    // zombie horse always, and a donkey alive, grown and tamed, `AbstractHorse`'s.
    fn can_use_slot(self, slot: usize) -> bool {
        if slot != 7 or self.species == HORSE or self.species == ZOMBIE_HORSE or self.species == SKELETON_HORSE {
            return true
        }
        if self.species == PIG {
            return self.living.alive() and not self.baby()
        }
        if self.species == DONKEY {
            return self.living.alive() and not self.baby() and self.horse_flag(2)
        }
        return true
    }

    // `canReplaceCurrentItem`: anything replaces nothing; armor what defends less, `compareArmor`,
    // and in the main hand what deals less, `compareWeapons`; nothing else.
    fn can_replace<W: Wearing>(self, lf: LivingFacts, items: W, stack: Tag, current: Tag?, slot: usize) -> bool {
        let old = current else return true
        if self.species == DROWNED and held_name(some(old.copy())) == "minecraft:nautilus_shell" {
            // `Drowned.canReplaceCurrentItem`: never its nautilus shell (CAL-175).
            return false
        }
        if slot >= 2 and slot <= 6 {
            if binds(items, old.copy()) {
                return false
            }
            let armor = attribute("armor")
            let toughness = attribute("armor_toughness")
            let defense = approximate_with(self.living.attributes, some(stack.copy()), armor, slot, items)
            let had = approximate_with(self.living.attributes, some(old.copy()), armor, slot, items)
            if defense != had {
                return defense > had
            }
            let tough = approximate_with(self.living.attributes, some(stack.copy()), toughness, slot, items)
            let was = approximate_with(self.living.attributes, some(old.copy()), toughness, slot, items)
            if tough != was {
                return tough > was
            }
            return replaces_equal(items, stack, old)
        }
        if slot != 0 {
            return false
        }
        // `getPreferredWeaponType`: a skeleton's, `#skeleton_preferred_weapons`; a drowned's,
        // `#drowned_preferred_weapons` (CAL-175); a wither skeleton's none (CAL-200).
        if (self.skeletal() and self.species != WITHER_SKELETON) or self.species == DROWNED {
            let weapons = if self.species == DROWNED { lf.drowned_weapons.copy() } else { lf.skeleton_weapons.copy() }
            let preferred = weapons.contains(held_name(some(stack.copy())))
            let had_preferred = weapons.contains(held_name(some(old.copy())))
            if had_preferred and not preferred {
                return false
            }
            if preferred and not had_preferred {
                return true
            }
        }
        let damage = attribute("attack_damage")
        let deals = approximate_with(self.living.attributes, some(stack.copy()), damage, slot, items)
        let dealt = approximate_with(self.living.attributes, some(old.copy()), damage, slot, items)
        if deals != dealt {
            return deals > dealt
        }
        return replaces_equal(items, stack, old)
    }

    // `setItemSlot` of `stack` in the slot `slot`, and its `onEquipItem` (CAL-159): where it's
    // another item, or has other components, its equippable's sound, `getEquipSound`, unless it's
    // silent, its seed drawn from its random, at full volume and pitch; the game event of it
    // comes with game events, and it's never its first tick, as it picks up in its `aiStep`. Then
    // a skeleton's weapon goal is looked at again, `reassessWeaponGoal`.
    fn equip_in<W: Wearing>(mut self, items: W, slot: usize, stack: Tag, sounds: mut List<EntitySound>) {
        let old = self.living.equipment[slot].copy()
        self.living.equipment[slot] = some(stack.copy())
        self.equip_heard(items, slot, old, some(stack.copy()), mut sounds)
        let hard = self.hard
        self.reassess_weapon(hard)
    }

    /// `onEquipItem`'s sound of `stack` put in the slot `slot` where `old` was (CAL-159): where
    /// it's another item, or has other components, its equippable's for that slot, `getEquipSound`,
    /// a saddle's a pig's own, `Pig.getEquipSound`, or a horse's, `AbstractHorse`'s (CAL-179),
    /// unless it's silent, its seed drawn from its random, at full volume and pitch.
    pub fn equip_heard<W: Wearing>(mut self, items: W, slot: usize, old: Tag?, stack: Tag?, sounds: mut List<EntitySound>) {
        if same_components(old, stack.copy()) {
            return
        }
        let put = stack else return
        let Tag.Compound(e) = items.worn_component(put.copy(), String("minecraft:equippable")) ?? Tag.End else return
        if self.living.silent() or equippable_slot(items, put) != some(slot) {
            return
        }
        var sound = equip_sound(e)
        if slot == 7 and self.species == PIG {
            sound = String("entity.pig.saddle")
        } else if slot == 7 and self.equine() {
            sound = String("entity.horse.saddle")
        }
        let seed = self.living.body.random.next_long()
        sounds.push(EntitySound { sound: sound, x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 1.0f32, pitch: 1.0f32, source: self.living.body.sound_source, seed: some(seed) })
    }

    /// `canUseSlot` of the slot `slot`, by `EquipmentSlot`'s order (CAL-179).
    pub fn may_use_slot(self, slot: usize) -> bool {
        return self.can_use_slot(slot)
    }

    /// `canDispenserEquipIntoSlot` of the slot `slot` (CAL-378): whether it may pick up loot,
    /// `canPickUpLoot`; a dolphin's, fox's or panda's only into its main hand; a horse's body and
    /// saddle too where it's tamed, `isTamed`, and a pig's saddle.
    pub fn dispenser_may_equip(self, slot: usize) -> bool {
        // A sulfur cube's only into its body, `SulfurCube.canDispenserEquipIntoSlot` (CAL-402).
        if self.species == SULFUR_CUBE {
            return slot == BODY_SLOT
        }
        if self.species == DOLPHIN or self.species == FOX or self.species == PANDA {
            return slot == 0 and self.can_pick_up_loot
        }
        if self.equine() and (slot == 6 or slot == 7) and self.horse_flag(2) {
            return true
        }
        if self.species == PIG and slot == 7 {
            return true
        }
        return self.can_pick_up_loot
    }

    /// `Raid.joinRaid`'s part before it's placed, for a raider made for the raid `raid`'s wave
    /// `wave` (CAL-167): where it `leads`, the wave's leader, `setPatrolLeader` and `setLeader`,
    /// the ominous banner on its head, sure to drop; then its raid, its wave, and that it may
    /// join one.
    pub fn join_raid(mut self, raid: i32, wave: i32, leads: bool) {
        if leads {
            self.patrol_leader = true
            self.living.equipment[5] = some(ominous_banner())
            self.guarantee_drop(5)
        }
        self.raid = some(raid)
        self.wave = wave
        self.can_join_raid = true
        self.ticks_outside_raid = 0
    }

    /// `applyRaidBuffs` of a raider of the wave `wave` of a raid whose enchant odds are `odds`
    /// (CAL-167), drawn from its own random, `special` its place's difficulty: a pillager's
    /// crossbow made anew where it's enchanted after the third wave, quick charge I, or after the
    /// fifth, II; a vindicator's iron axe, sharpness I where it's enchanted, II after the fifth
    /// wave; nothing for the others.
    pub fn apply_raid_buffs(mut self, wave: i32, odds: f32, special: f32, loot: Shared<Loot>?) {
        if self.species == PILLAGER {
            if self.living.body.random.next_float() <= odds {
                let provider = if wave > 5 { "minecraft:raid/pillager_post_wave_5" } else if wave > 3 { "minecraft:raid/pillager_post_wave_3" } else { "" }
                if provider != "" {
                    var crossbow = stack_of(String("minecraft:crossbow"))
                    if let l = loot {
                        crossbow = provider_enchanted(l.value, mut self.living.body.random, crossbow, provider, special)
                    }
                    self.living.equipment[0] = some(crossbow)
                }
            }
        } else if self.species == VINDICATOR {
            var axe = stack_of(String("minecraft:iron_axe"))
            if self.living.body.random.next_float() <= odds {
                let provider = if wave > 5 { "minecraft:raid/vindicator_post_wave_5" } else { "minecraft:raid/vindicator" }
                if let l = loot {
                    axe = provider_enchanted(l.value, mut self.living.body.random, axe, provider, special)
                }
            }
            self.living.equipment[0] = some(axe)
        }
    }

    /// Whether a dispenser's chest goes on it (CAL-378): a donkey or llama alive, tamed, `isTamed`,
    /// without one, `hasChest`.
    pub fn chest_ready(self) -> bool {
        return self.chested() and self.living.alive() and not self.living.data.flag(OWN + 1) and self.horse_flag(2)
    }

    /// A dispenser's chest put on it, its slot 499's `set` (CAL-378): its chest on, `setChest`,
    /// and its slots made, `createInventory`, unheard.
    pub fn take_chest(mut self) {
        self.living.data.set(OWN + 1, Value.Bool(true))
        self.create_inventory()
    }

    /// `Shearable.readyForShearing` (CAL-378): a sheep grown with its wool, a mooshroom grown, a
    /// bogged not yet sheared, and a snow golem with its pumpkin, alive; nothing else.
    pub fn ready_for_shearing(self) -> bool {
        if not self.living.alive() {
            return false
        }
        if self.species == SHEEP {
            return not self.sheared() and not self.baby()
        }
        if self.species == MOOSHROOM {
            return not self.baby()
        }
        if self.species == BOGGED {
            return not self.living.data.flag(MONSTER_OWN)
        }
        if self.species == SNOW_GOLEM {
            return self.has_pumpkin()
        }
        // A sulfur cube holding a block, `SulfurCube.readyForShearing` (CAL-402).
        if self.species == SULFUR_CUBE {
            return self.has_body_item()
        }
        return false
    }

    /// `dispenseEquipment`'s putting `stack` in the slot `slot` (CAL-378): worn, `setItemSlot`,
    /// heard as it's put on, `equip_heard`, its drop kept, `setGuaranteedDrop`, and it kept,
    /// `setPersistenceRequired`.
    pub fn wear_from_dispenser<W: Wearing>(mut self, items: W, slot: usize, stack: Tag, sounds: mut List<EntitySound>) {
        let old = self.living.equipment[slot].copy()
        self.living.equipment[slot] = some(stack.copy())
        self.equip_heard(items, slot, old, some(stack.copy()), mut sounds)
        self.guarantee_drop(slot)
        self.persistence_required = true
    }

    /// What a horse's menu put in the slot `slot`, `createEquipmentSlotContainer`'s `setTheItem`
    /// (CAL-179): worn, and where it's anything, its drop kept, `setGuaranteedDrop`, and it kept,
    /// `setPersistenceRequired`. Its sound comes as the menu says, `equip_heard`.
    pub fn wear_from_menu(mut self, slot: usize, stack: Tag?) {
        let had = self.living.equipment[slot].copy()
        self.living.equipment[slot] = stack.copy()
        if stack != none and had != stack {
            self.guarantee_drop(slot)
            self.persistence_required = true
        }
    }

    /// `Mob.attemptToShearEquipment` (CAL-179), which shears ask before anything else of a mob
    /// that carries no one, `canShearEquipment`: what it wears in the first slot, in
    /// `EquipmentSlot`'s order, whose equippable may be sheared, `can_be_sheared`, and isn't bound
    /// to it, `prevent_armor_change`, unless the player's in creative mode; the slot emptied,
    /// `shearItem`, and the slot, the stack and its shearing sound, `shearing_sound`, given for
    /// its level to drop and play. None where it wears nothing so.
    pub fn shear_equipment<W: Wearing>(mut self, items: W, creative: bool) -> (usize, Tag, String)? {
        for slot in 0..self.living.equipment.len() {
            let stack = self.living.equipment[slot].copy() else continue
            let Tag.Compound(e) = items.worn_component(stack.copy(), String("minecraft:equippable")) ?? Tag.End else continue
            let sheared = if e.contains("can_be_sheared") { e["can_be_sheared"].number_bool() ?? false } else { false }
            if not sheared or (binds(items, stack.copy()) and not creative) {
                continue
            }
            var sound = String("minecraft:item.shears.snip")
            if e.contains("shearing_sound") {
                match e["shearing_sound"] {
                    Tag.Str(s) => sound = s.copy(),
                    Tag.Compound(m) => {
                        if m.contains("sound_id") {
                            if let Tag.Str(s) = m["sound_id"] {
                                sound = s.copy()
                            }
                        }
                    },
                    _ => {},
                }
            }
            let named = if sound.starts_with("minecraft:") { sound[10..].copy() } else { sound }
            self.living.equipment[slot] = none
            return some((slot, stack, named))
        }
        return none
    }

    /// One of `stack` put on as its body armor, `setItemSlotAndDropWhenKilled`, its sound heard as
    /// `equip_in` plays it, and kept whole as it drops, a wolf's armor (CAL-201).
    pub fn wear_body<W: Wearing>(mut self, items: W, stack: Tag, sounds: mut List<EntitySound>) {
        let one = one_of(some(stack.copy()))
        self.equip_in(items, BODY_SLOT, one, mut sounds)
        self.guarantee_drop(BODY_SLOT)
    }

    /// `Equippable.equipOnTarget` of `stack`, which the player's use falls back on where its
    /// equippable's put on as it's used, `equip_on_interact`, as a saddle (CAL-179): where it may
    /// go in its slot, `isEquippableInSlot`, the slot's empty and it's alive, one of it put on,
    /// `setItemSlot`, its sound heard as `equip_in` plays it, and kept whole as it drops,
    /// `setGuaranteedDrop`; whether it was.
    pub fn equip_on_use<W: Wearing>(mut self, items: W, stack: Tag, sounds: mut List<EntitySound>) -> bool {
        let Tag.Compound(e) = items.worn_component(stack.copy(), String("minecraft:equippable")) ?? Tag.End else return false
        let on_use = if e.contains("equip_on_interact") { e["equip_on_interact"].number_bool() ?? false } else { false }
        let slot = equippable_slot(items, stack.copy()) else return false
        if not on_use or not self.equippable_in(items, stack.copy(), slot) or self.living.equipment[slot] != none or not self.living.alive() {
            return false
        }
        let one = one_of(some(stack.copy()))
        self.equip_in(items, slot, one, mut sounds)
        self.guarantee_drop(slot)
        return true
    }

    /// A sheep dyed, `DyeItem.interactLivingEntity` (CAL-179): one alive with its wool whose
    /// colour isn't `color`, a dye's `minecraft:dye`, of that colour now, `setColor`; whether it
    /// was.
    pub fn dyed(mut self, color: i32) -> bool {
        if self.species != SHEEP or not self.living.alive() or self.sheared() or self.color() == color {
            return false
        }
        self.set_color(color)
        return true
    }

    // `setGuaranteedDrop`: its chance of dropping what's in the slot `slot` 2, so it's kept whole
    // as it drops, as `drop_chances` saves it.
    fn guarantee_drop(mut self, slot: usize) {
        var chances = JavaHashMap<String, Tag>()
        if self.kept.contains("drop_chances") {
            if let Tag.Compound(had) = self.kept["drop_chances"] {
                chances = had.copy()
            }
        }
        chances.insert(slot_names()[slot].copy(), Tag.Float(2.0f32))
        self.kept.insert(String("drop_chances"), Tag.Compound(chances))
    }

    /// The experience it drops as it dies, `getBaseExperienceReward` (D416): an animal's and a
    /// water animal's 1 to 3, drawn (CAL-178); an endermite's 3 (D583); a ravager's and a piglin brute's 20 and a vex's 3
    /// (CAL-200); another monster's 5, a
    /// baby zombie's 12, `xpReward * 2.5`, and a slime's its size, each with 1 to 3 more, drawn,
    /// for each slot but the saddle with a stack it may drop, a chance of 1 or less. A killer's
    /// enchantments' `mob_experience` come with them.
    pub fn experience_reward(mut self) -> i32 {
        if self.species == HOGLIN {
            // `Hoglin.getBaseExperienceReward`: its `xpReward`, 5, or 3 a baby, `ageBoundaryReached`,
            // with nothing more for what it holds, as it holds nothing (CAL-200).
            return if self.baby() { 3 } else { 5 }
        }
        if self.species == PIGLIN {
            // `Piglin.getBaseExperienceReward`: its `xpReward`, 5, with nothing more for what it holds
            // (CAL-200).
            return 5
        }
        if self.animal or water_kind(self.species) {
            return 1 + self.living.body.random.next_int_below(3)
        }
        if self.species == SULFUR_CUBE {
            // `SulfurCube.getBaseExperienceReward` (CAL-402): none a baby, else 1 or 2, drawn.
            return if self.baby() { 0 } else { 1 + self.living.body.random.next_int_below(2) }
        }
        var reward = if cube_kind(self.species) { self.slime_size() } else if self.species == ENDERMITE { 3 } else if self.guardian_kind() { 10 } else if self.species == RAVAGER or self.species == PIGLIN_BRUTE { 20 } else if self.species == VEX { 3 } else if self.species == EVOKER or self.species == BLAZE { 10 } else if self.species == WITHER_BOSS { 50 } else if self.monster or self.species == PHANTOM or self.species == GHAST or self.species == SHULKER { 5 } else { 0 }
        if self.zombie_class() and self.baby() {
            reward = i32.saturate(f64(reward) * 2.5)
        }
        if reward <= 0 {
            return reward
        }
        for slot in 0..self.living.equipment.len() {
            if slot == 7 or self.living.equipment[slot] == none {
                continue
            }
            if self.drop_chance(slot) <= 1.0f32 {
                reward += 1 + self.living.body.random.next_int_below(3)
            }
        }
        return reward
    }

    // `getVoicePitch`: about 1, or 1.5 for a baby, from its own random; a bat's 0.95 times that,
    // `Bat.getVoicePitch` (CAL-201).
    fn voice_pitch(mut self) -> f32 {
        let a = self.living.body.random.next_float()
        let b = self.living.body.random.next_float()
        let pitch = (a - b) * 0.2f32 + (if self.baby() { 1.5f32 } else { 1.0f32 })
        return if self.species == BAT { pitch * 0.95f32 } else { pitch }
    }

    /// The mob `tag` saves, of the type `kind`, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes it and `load` reads it in, its variants by name from `facts`;
    /// none where it isn't a kind Calcite makes or doesn't read, logged in `lines`.
    pub fn loaded(lf: LivingFacts, facts: MobFacts, kind: u32, id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Mob? {
        let Tag.Str(name) = tag["id"] else return none
        let species = species_named(name) else return none
        var mob = Mob.made(lf, facts, species, kind, id, seed, 0.0, 0.0, 0.0)
        if not mob.load_onto(lf, tag, mut lines) {
            return none
        }
        return some(mob)
    }

    /// `Entity.load` onto it as it is, as `data` changes an entity's data (D823), and as
    /// `loaded` reads a fresh one: what every living entity reads, then its own; its brain made
    /// again with its own seed where it saved one. What it saved and Calcite only keeps is taken
    /// again, none where the tag hasn't it. False where it doesn't load, logged in `lines`.
    pub fn load_onto(mut self, lf: LivingFacts, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        let species = self.species
        let seed = self.seed
        // What it keeps as it was saved, taken again from the tag (D823).
        for key in ["drop_chances", "DeathLootTable", "DeathLootTableSeed", "LoveCause", "stew_effects", "Owner", "Items", "angry_at", "RaidId", "Offers", "Gossips", "ConversionPlayer", "Inventory"] {
            _ = self.kept.remove(key)
        }
        if cube_kind(species) {
            // A slime's size, set before what every living entity reads, its attributes and
            // health, `readAdditionalSaveData`.
            self.set_slime_size(int_or(tag, "Size", 0) + 1, false)
        }
        if not self.living.load_from(lf, tag, mut lines) {
            return false
        }
        if species == VILLAGER and tag.contains("Brain") {
            // `LivingEntity.readAdditionalSaveData`'s last: its brain made again, its sensors put
            // off again by its random, with the memories it saved (CAL-160).
            var brain = self.villager_brain()
            brain.unpack(tag["Brain"].copy())
            self.brain = some(brain)
        }
        if species == ARMADILLO and tag.contains("Brain") {
            // `LivingEntity.readAdditionalSaveData`'s last: its brain made again, its sensors put
            // off again by its random, with the memories it saved (CAL-160).
            var brain = Brain.made(armadillo_sensors(), armadillo_activities(seed), mut self.living.body.random)
            brain.unpack(tag["Brain"].copy())
            self.brain = some(brain)
        }
        if (species == HOGLIN or species == ZOGLIN or species == PIGLIN_BRUTE or species == PIGLIN) and tag.contains("Brain") {
            // `LivingEntity.readAdditionalSaveData`'s last: its brain made again, its sensors put
            // off again by its random, with the memories it saved (CAL-200).
            var brain = if species == HOGLIN {
                Brain.made(hoglin_sensors(), hoglin_activities(seed), mut self.living.body.random)
            } else if species == ZOGLIN {
                Brain.made(zoglin_sensors(), zoglin_activities(seed), mut self.living.body.random)
            } else if species == PIGLIN {
                var made = Brain.made(piglin_sensors(), piglin_activities(seed), mut self.living.body.random)
                for m in piglin_memories() {
                    made.register(m)
                }
                made
            } else {
                Brain.made(brute_sensors(), brute_activities(seed), mut self.living.body.random)
            }
            brain.unpack(tag["Brain"].copy())
            self.brain = some(brain)
        }
        let turn = self.living.body.y_rot
        self.living.y_head_rot = turn
        self.living.y_head_rot_o = turn
        self.living.y_body_rot = turn
        self.living.y_body_rot_o = turn
        self.can_pick_up_loot = bool_or(tag, "CanPickUpLoot")
        self.persistence_required = bool_or(tag, "PersistenceRequired")
        self.set_flag(LEFT_HANDED_FLAG, bool_or(tag, "LeftHanded"))
        self.set_flag(NO_AI_FLAG, bool_or(tag, "NoAI"))
        if self.ageable {
            // A parrot's never a baby, `canBeABaby`, and reads no age (CAL-201).
            if species != PARROT {
                self.set_age(int_or(tag, "Age", 0))
                self.forced_age = int_or(tag, "ForcedAge", 0)
                self.living.data.set(AGE_LOCKED, Value.Bool(bool_or(tag, "AgeLocked")))
            }
            self.in_love = int_or(tag, "InLove", 0)
        }
        if species == MOOSHROOM {
            var brown = false
            if let Tag.Str(variant) = string_at(tag, "Type") {
                brown = variant == "brown"
            }
            self.living.data.set(MOOSHROOM_TYPE, Value.Number(if brown { 1 } else { 0 }))
        } else if self.equine() {
            self.set_horse_flag(16, bool_or(tag, "EatingHaystack"))
            self.set_horse_flag(8, bool_or(tag, "Bred"))
            self.temper = int_or(tag, "Temper", 0)
            self.set_horse_flag(2, bool_or(tag, "Tame"))
            if species == SKELETON_HORSE {
                // `SkeletonHorse.readAdditionalSaveData` (CAL-349).
                self.set_trap(bool_or(tag, "SkeletonTrap"))
                self.trap_time = int_or(tag, "SkeletonTrapTime", 0)
            }
            if species == HORSE {
                self.living.data.set(OWN + 1, Value.Number(int_or(tag, "Variant", 0)))
            } else if species == DONKEY or species == LLAMA {
                // A llama's strength first, which sizes its chest, `Llama.readAdditionalSaveData`
                // (CAL-201).
                if species == LLAMA {
                    self.set_llama_strength(int_or(tag, "Strength", 0))
                    // Its variant, by its number, from 0 to 3, `LEGACY_CODEC`, creamy where it has none.
                    let v = int_or(tag, "Variant", 0)
                    self.living.data.set(OWN + 3, Value.Number(if v < 0 { 0 } else if v > 3 { 3 } else { v }))
                }
                // Its chest, and its slots made and filled, `Items` by slot (CAL-179).
                self.living.data.set(OWN + 1, Value.Bool(bool_or(tag, "ChestedHorse")))
                self.create_inventory()
                if tag.contains("Items") {
                    if let Tag.List(list) = tag["Items"].copy() {
                        for t in list {
                            let Tag.Compound(m) = t else continue
                            let slot = if m.contains("Slot") { i32(u8.wrap(m["Slot"].byte_value() ?? 0i8)) } else { 0 }
                            if slot < 0 or usize.wrap(slot) >= self.chest_items.len() {
                                continue
                            }
                            var stack = m.copy()
                            _ = stack.remove("Slot")
                            self.chest_items[usize.wrap(slot)] = some(Tag.Compound(stack))
                        }
                    }
                }
            }
        } else if species == SHEEP {
            if self.sheared() != bool_or(tag, "Sheared") {
                let wool = i32(self.living.data.byte(OWN))
                self.living.data.set(OWN, Value.Byte(i8.wrap(wool ^ 16)))
            }
            self.set_color(int_or(tag, "Color", 0))
        } else if zombie_kind(species) {
            self.set_zombie_baby(bool_or(tag, "IsBaby"))
            self.can_break_doors = bool_or(tag, "CanBreakDoors")
            self.navigation.can_open_doors = self.can_break_doors
            self.load_conversion(tag, "InWaterTime", "DrownedConversionTime", MONSTER_OWN + 2)
            if species == ZOMBIE_VILLAGER {
                self.load_villager(lf, tag)
            }
            if species == ZOMBIFIED_PIGLIN {
                // `readPersistentAngerSaveData`, as an enderman's (CAL-200).
                if let end = long_at(tag, "anger_end_time") {
                    self.anger_end_time = end
                } else {
                    self.anger_end_time = -1
                    if tag.contains("AngerTime") {
                        self.legacy_anger = tag["AngerTime"].int_value()
                    }
                }
                self.anger_target = uuid_of(tag, "angry_at")
                self.target_to(none)
            }
        } else if species == SKELETON {
            self.load_conversion(tag, "FreezingTime", "StrayConversionTime", MONSTER_OWN)
        } else if species == BOGGED {
            // Whether it's sheared, `Bogged.readAdditionalSaveData` (CAL-200).
            self.living.data.set(MONSTER_OWN, Value.Bool(bool_or(tag, "sheared")))
        } else if species == CREEPER {
            self.living.data.set(MONSTER_OWN + 1, Value.Bool(bool_or(tag, "powered")))
            self.max_swell = i32(i16.wrap(int_or(tag, "Fuse", 30)))
            self.explosion_radius = i32(i8.wrap(int_or(tag, "ExplosionRadius", 3)))
            if bool_or(tag, "ignited") {
                self.living.data.set(MONSTER_OWN + 2, Value.Bool(true))
            }
        } else if cube_kind(species) {
            self.was_on_ground = bool_or(tag, "wasOnGround")
            if species == SULFUR_CUBE {
                // `SulfurCube.readAdditionalSaveData` (CAL-402): its pickup timer, whether it came
                // from a bucket, and its fuse, -1 for none, its most fuse in its values too.
                self.sulfur.pickup_timer = int_or(tag, "pickup_timer", 0)
                self.living.data.set(OWN + 2, Value.Bool(bool_or(tag, "from_bucket")))
                self.sulfur.fuse = int_or(tag, "fuse", -1)
                self.living.data.set(OWN + 1, Value.Number(self.sulfur.fuse))
            }
        } else if species == WITHER_BOSS {
            // `WitherBoss.readAdditionalSaveData` (CAL-401): its invulnerable ticks, `getIntOr`.
            self.living.data.set(MONSTER_OWN + 3, Value.Number(int_or(tag, "Invul", 0)))
        } else if species == GHAST {
            // `Ghast.readAdditionalSaveData` (CAL-200).
            self.ghast_power = i32(i8.wrap(int_or(tag, "ExplosionPower", 1)))
        } else if species == ZOGLIN {
            // `Zoglin.readAdditionalSaveData` (CAL-200).
            self.set_zoglin_baby(bool_or(tag, "IsBaby"))
        } else if species == HOGLIN {
            // `Hoglin.readAdditionalSaveData` (CAL-200).
            self.living.data.set(OWN, Value.Bool(bool_or(tag, "IsImmuneToZombification")))
            self.time_in_overworld = int_or(tag, "TimeInOverworld", 0)
            self.cannot_be_hunted = bool_or(tag, "CannotBeHunted")
        } else if species == PIGLIN_BRUTE {
            // `AbstractPiglin.readAdditionalSaveData` (CAL-200): it may pick up loot unless it
            // saved otherwise.
            self.can_pick_up_loot = if tag.contains("CanPickUpLoot") { bool_or(tag, "CanPickUpLoot") } else { true }
            self.living.data.set(MONSTER_OWN, Value.Bool(bool_or(tag, "IsImmuneToZombification")))
            self.time_in_overworld = int_or(tag, "TimeInOverworld", 0)
        } else if species == PIGLIN {
            // `AbstractPiglin.readAdditionalSaveData`, then `Piglin`'s: whether it's a baby, whether
            // it may hunt, and its inventory, kept, as a villager's is (CAL-200).
            self.can_pick_up_loot = if tag.contains("CanPickUpLoot") { bool_or(tag, "CanPickUpLoot") } else { true }
            self.living.data.set(MONSTER_OWN, Value.Bool(bool_or(tag, "IsImmuneToZombification")))
            self.time_in_overworld = int_or(tag, "TimeInOverworld", 0)
            self.set_piglin_baby(bool_or(tag, "IsBaby"))
            self.cannot_hunt = bool_or(tag, "CannotHunt")
            if tag.contains("Inventory") {
                self.kept.insert(String("Inventory"), tag["Inventory"].copy())
            }
        } else if species == SHULKER {
            // `Shulker.readAdditionalSaveData` (CAL-200): its face by its 3D data value, its peek
            // and colour, its place snapped to its block, `setPos`, and its box made again.
            let face = i32(i8.wrap(int_or(tag, "AttachFace", 0))) % 6
            self.living.data.set(MONSTER_OWN, Value.Number(if face < 0 { -face } else { face }))
            self.living.data.set(MONSTER_OWN + 1, Value.Byte(i8.wrap(int_or(tag, "Peek", 0))))
            self.living.data.set(MONSTER_OWN + 2, Value.Byte(i8.wrap(int_or(tag, "Color", 16))))
            if self.living.body.vehicle == none {
                self.living.body.x = f64(floor_of(self.living.body.x)) + 0.5
                self.living.body.y = f64(floor_of(self.living.body.y + 0.5))
                self.living.body.z = f64(floor_of(self.living.body.z)) + 0.5
            }
            self.shulker_shape()
        } else if species == ENDERMITE {
            self.life = int_or(tag, "Lifetime", 0)
        } else if species == ENDER_DRAGON {
            // `EnderDragon.readAdditionalSaveData` (D608): its phase where one's saved, as
            // `getById` finds it; its death's ticks and the damage it's taken sitting.
            if tag.contains("DragonPhase") {
                if let saved_phase = tag["DragonPhase"].int_value() {
                    self.set_dragon_phase(phase_of(saved_phase))
                }
            }
            var dr = self.dragon.take() ?? Dragon.made()
            dr.death_time = int_or(tag, "DragonDeathTime", 0)
            dr.sitting_damage = if tag.contains("sitting_damage_received") { tag["sitting_damage_received"].number_float() ?? 0.0f32 } else { 0.0f32 }
            self.dragon = some(dr)
        } else if raider_kind(species) {
            self.patrol_target = block_pos_at(tag, "patrol_target")
            self.patrol_leader = bool_or(tag, "PatrolLeader")
            self.patrolling = bool_or(tag, "Patrolling")
            self.wave = int_or(tag, "Wave", 0)
            self.can_join_raid = bool_or(tag, "CanJoinRaid")
            if species == EVOKER {
                // `SpellcasterIllager.readAdditionalSaveData` (CAL-200).
                self.spell_ticks = int_or(tag, "SpellTicks", 0)
            }
            if bool_or(tag, "Johnny") {
                self.kept.insert(String("Johnny"), Tag.Byte(1i8))
            }
            if species == RAVAGER {
                // `Ravager.readAdditionalSaveData` (CAL-200).
                self.attack_tick = int_or(tag, "AttackTick", 0)
                self.stunned_tick = int_or(tag, "StunTick", 0)
                self.roar_tick = int_or(tag, "RoarTick", 0)
            }
            if species == PILLAGER {
                // `Pillager.readAdditionalSaveData`: its inventory, kept, and it picks up loot
                // (CAL-200).
                if tag.contains("Inventory") {
                    self.kept.insert(String("Inventory"), tag["Inventory"].copy())
                }
                self.can_pick_up_loot = true
            }
        } else if species == SNOW_GOLEM {
            // `SnowGolem.readAdditionalSaveData` (CAL-201): whether it has its pumpkin, so where
            // it's left out.
            let pumpkin = if tag.contains("Pumpkin") { bool_or(tag, "Pumpkin") } else { true }
            self.set_pumpkin(pumpkin)
        } else if species == IRON_GOLEM {
            // `IronGolem.readAdditionalSaveData` (CAL-201): whether a player made it, then its
            // anger, as an enderman's is read.
            self.set_player_created(bool_or(tag, "PlayerCreated"))
            if let end = long_at(tag, "anger_end_time") {
                self.anger_end_time = end
            } else {
                self.anger_end_time = -1
                if tag.contains("AngerTime") {
                    self.legacy_anger = tag["AngerTime"].int_value()
                }
            }
            self.anger_target = uuid_of(tag, "angry_at")
            self.target_to(none)
        } else if species == ENDERMAN {
            // Its carried block, kept as it's saved but air, which it doesn't carry; and when its
            // anger ends, `readPersistentAngerSaveData`: as it's saved, any number; else -1, and
            // where its legacy time left, `AngerTime`, is saved, that kept for its level to read,
            // `anger_from`.
            if let Tag.Compound(state) = string_at(tag, "carriedBlockState") {
                if not (state.contains("Name") and state["Name"] == Tag.Str(String("minecraft:air"))) {
                    self.kept.insert(String("carriedBlockState"), Tag.Compound(state.copy()))
                }
            }
            if let end = long_at(tag, "anger_end_time") {
                self.anger_end_time = end
            } else {
                self.anger_end_time = -1
                if tag.contains("AngerTime") {
                    self.legacy_anger = tag["AngerTime"].int_value()
                }
            }
            self.anger_target = uuid_of(tag, "angry_at")
            // `setTarget` of who it's angry at, as the level finds them, which here it can't, so
            // none, as for no one; its speed's instance made by that, so it's sent as it's
            // paired, `getAttribute` (CAL-244).
            self.target_to(none)
        } else if species == VILLAGER {
            self.load_villager_own(tag)
        } else if species == ARMADILLO {
            // Its state, idle where it's none it knows, and its time till it sheds where it's
            // saved (CAL-160).
            var state = ARMADILLO_IDLE
            if let Tag.Str(state_name) = string_at(tag, "state") {
                state = armadillo_state_named(state_name.copy())
            }
            self.switch_to_state(state)
            if tag.contains("scute_time") {
                self.scute_time = int_or(tag, "scute_time", self.scute_time)
            }
        } else if species == VEX {
            // `Vex.readAdditionalSaveData` (CAL-200): where it's bound, its life where that's
            // limited, and its owner.
            self.vex_bound = block_pos_at(tag, "bound_pos")
            self.vex_life = if tag.contains("life_ticks") { tag["life_ticks"].int_value() } else { none }
            self.vex_owner = uuid_of(tag, "owner")
        } else if species == PHANTOM {
            // `Phantom.readAdditionalSaveData` (CAL-200): the block it circles where it's a place,
            // then its size, its attack set where that changes it.
            self.phantom.anchor = block_pos_at(tag, "anchor_pos")
            self.set_phantom_size(int_or(tag, "size", 0))
        } else if fish_kind(species) {
            // `AbstractFish.readAdditionalSaveData` (CAL-178): whether it came from a bucket; a
            // salmon's size by its name, medium where it's none, `Salmon.readAdditionalSaveData`
            // (CAL-201).
            self.living.data.set(FROM_BUCKET, Value.Bool(bool_or(tag, "FromBucket")))
            if species == SALMON {
                var size = 1
                if let Tag.Str(named) = string_at(tag, "type") {
                    size = if named == "small" { 0 } else if named == "large" { 2 } else { 1 }
                }
                self.set_salmon_size(size)
            }
            if species == TROPICAL_FISH {
                // `TropicalFish.readAdditionalSaveData`: its variant, packed, read as its parts
                // and packed again, its default's where it's none (CAL-201).
                let (p, b, o) = unpack_tropical(int_or(tag, "Variant", 0))
                self.living.data.set(TROPICAL_VARIANT, Value.Number(pack_tropical(p, b, o)))
            }
            if species == PUFFERFISH {
                // `Pufferfish.readAdditionalSaveData`: its puff, 2 at most (CAL-201).
                let puff = int_or(tag, "PuffState", 0)
                self.set_puff_size(if puff > 2 { 2 } else { puff })
            }
        } else if species == GLOW_SQUID {
            // `GlowSquid.readAdditionalSaveData` (CAL-201).
            self.living.data.set(GLOW_DARK, Value.Number(int_or(tag, "DarkTicksRemaining", 0)))
        } else if species == DOLPHIN {
            // `Dolphin.readAdditionalSaveData` (CAL-201): whether it got a fish, and how moist it
            // is, 2400 where it's none.
            self.living.data.set(GOT_FISH, Value.Bool(bool_or(tag, "GotFish")))
            self.living.data.set(MOISTNESS, Value.Number(int_or(tag, "Moistness", 2400)))
        } else if species == BEE {
            // `Bee.readAdditionalSaveData` (CAL-177): its nectar and sting, its counts, its hive and
            // flower where they're places; then its anger as an enderman's is read, but sent, a
            // legacy time left kept for its level to read, `anger_from`.
            self.set_bee_flag(BEE_NECTAR, bool_or(tag, "HasNectar"))
            self.set_bee_flag(BEE_STUNG, bool_or(tag, "HasStung"))
            self.bee.without_nectar = int_or(tag, "TicksSincePollination", 0)
            self.bee.stay_out = int_or(tag, "CannotEnterHiveTicks", 0)
            self.bee.crops_grown = int_or(tag, "CropsGrownSincePollination", 0)
            self.bee.hive = block_pos_at(tag, "hive_pos")
            self.bee.flower = block_pos_at(tag, "flower_pos")
            if let end = long_at(tag, "anger_end_time") {
                self.living.data.set(OWN + 1, Value.Long(end))
            } else {
                self.living.data.set(OWN + 1, Value.Long(-1i64))
                if tag.contains("AngerTime") {
                    self.legacy_anger = tag["AngerTime"].int_value()
                }
            }
            self.anger_target = uuid_of(tag, "angry_at")
        } else if species != SPIDER and species != CAVE_SPIDER {
            if species == WOLF {
                // `Wolf.readAdditionalSaveData` (CAL-201): `TamableAnimal`'s whether it's ordered
                // to sit, and so sits; its collar's color, red where it's none; and its anger as a
                // bee's is read, sent. With an owner, theirs and tame, `setTame(true, false)`;
                // without, wild, `setTame(false, true)`: its most health 8,
                // `applyTamingSideEffects`, its instance made so, sent as it's paired and with its
                // first changes.
                if let (most, least) = uuid_of(tag, "Owner") {
                    self.living.data.set(OWN + 1, Value.Uuid(most, least))
                    self.living.data.set_flag(OWN, 4, true)
                } else {
                    self.set_base("minecraft:max_health", 8.0)
                }
                self.wolf.sitting = bool_or(tag, "Sitting")
                self.living.data.set_flag(OWN, 1, self.wolf.sitting)
                self.living.data.set(OWN + 3, Value.Number(if tag.contains("CollarColor") { int_or(tag, "CollarColor", 14) } else { 14 }))
                if let end = long_at(tag, "anger_end_time") {
                    self.living.data.set(OWN + 4, Value.Long(end))
                } else {
                    self.living.data.set(OWN + 4, Value.Long(-1i64))
                    if tag.contains("AngerTime") {
                        self.legacy_anger = tag["AngerTime"].int_value()
                    }
                }
                self.anger_target = uuid_of(tag, "angry_at")
            }
            if species == RABBIT {
                // `Rabbit.readAdditionalSaveData` (CAL-201): its variant, `RabbitType`, brown where
                // it's none, set as `setVariant` sets it, and its ticks till it wants carrots.
                self.set_rabbit_variant(rabbit_variant_named(int_or(tag, "RabbitType", 0)))
                self.rabbit.more_carrots = int_or(tag, "MoreCarrotTicks", 0)
            }
            if species == FOX {
                // `Fox.readAdditionalSaveData` (CAL-201): none trusted, then those it trusts,
                // `Trusted`, added in turn; whether it sleeps; its variant, `Type`, red where it's
                // none or unknown; whether it sits and crouches; then its target goals.
                self.living.data.set(OWN + 2, Value.Empty)
                self.living.data.set(OWN + 3, Value.Empty)
                if tag.contains("Trusted") {
                    if let Tag.List(trusted) = tag["Trusted"].copy() {
                        for e in trusted {
                            var one = JavaHashMap<String, Tag>()
                            one.insert(String("u"), e.copy())
                            if let u = uuid_of(one, "u") {
                                self.fox_trust(u)
                            }
                        }
                    }
                }
                self.set_fox_flag(FOX_SLEEPING, bool_or(tag, "Sleeping"))
                var snow = false
                if let Tag.Str(v) = string_at(tag, "Type") {
                    snow = v == "snow"
                }
                self.living.data.set(OWN, Value.Number(if snow { 1 } else { 0 }))
                self.set_fox_flag(FOX_SITTING, bool_or(tag, "Sitting"))
                self.set_fox_flag(FOX_CROUCHING, bool_or(tag, "Crouching"))
                self.fox_target_goals()
            }
            if species == PANDA {
                // `Panda.readAdditionalSaveData` (CAL-201): its genes by their names, normal where
                // they're missing or aren't genes, `Gene.CODEC`.
                var main = GENE_NORMAL
                var hidden = GENE_NORMAL
                if let Tag.Str(given) = string_at(tag, "MainGene") {
                    main = gene_named(given) ?? GENE_NORMAL
                }
                if let Tag.Str(given) = string_at(tag, "HiddenGene") {
                    hidden = gene_named(given) ?? GENE_NORMAL
                }
                self.set_panda_genes(main, hidden)
            }
            if species == POLAR_BEAR {
                // `PolarBear.readAdditionalSaveData` (CAL-201): its anger, as an enderman's.
                if let end = long_at(tag, "anger_end_time") {
                    self.anger_end_time = end
                } else {
                    self.anger_end_time = -1
                    if tag.contains("AngerTime") {
                        self.legacy_anger = tag["AngerTime"].int_value()
                    }
                }
                self.anger_target = uuid_of(tag, "angry_at")
            }
            if species == OCELOT {
                // `Ocelot.readAdditionalSaveData` (CAL-201): whether it trusts, `setTrusting`, its
                // goals reassessed.
                self.living.data.set(OWN, Value.Bool(bool_or(tag, "Trusting")))
                self.reassess_tame_goals()
            }
            if species == BAT {
                // `Bat.readAdditionalSaveData` (CAL-201): its flags, `BatFlags`, else none, so
                // awake.
                self.living.data.set(MONSTER_OWN, Value.Byte(i8.wrap(int_or(tag, "BatFlags", 0))))
            }
            if species == TURTLE {
                // `Turtle.readAdditionalSaveData` (CAL-201): its home, where it is where it has
                // none, and whether it has an egg.
                self.turtle.home = block_pos_at(tag, "home_pos") ?? self.living.body.block()
                self.living.data.set(OWN, Value.Bool(bool_or(tag, "has_egg")))
            }
            if species == PARROT {
                // `Parrot.readAdditionalSaveData` (CAL-201): `TamableAnimal`'s owner, tame where it
                // has one, and whether it's ordered to sit, and so sits; its variant by its ID, the
                // nearest where it's out of range, `ByIdMap.CLAMP`, red and blue where it's none.
                if let (most, least) = uuid_of(tag, "Owner") {
                    self.living.data.set(OWN + 1, Value.Uuid(most, least))
                    self.living.data.set_flag(OWN, 4, true)
                }
                self.wolf.sitting = bool_or(tag, "Sitting")
                self.living.data.set_flag(OWN, 1, self.wolf.sitting)
                let v = if tag.contains("Variant") { int_or(tag, "Variant", 0) } else { 0 }
                self.living.data.set(OWN + 2, Value.Number(if v < 0 { 0 } else if v > 4 { 4 } else { v }))
            }
            if species == CAT {
                // `Cat.readAdditionalSaveData` (CAL-201): `TamableAnimal`'s owner, tame where it has
                // one, its goals reassessed, and whether it's ordered to sit, and so sits; its
                // collar's color, red where it's none. Its variants come after.
                if let (most, least) = uuid_of(tag, "Owner") {
                    self.living.data.set(OWN + 1, Value.Uuid(most, least))
                    self.living.data.set_flag(OWN, 4, true)
                }
                self.reassess_tame_goals()
                self.wolf.sitting = bool_or(tag, "Sitting")
                self.living.data.set_flag(OWN, 1, self.wolf.sitting)
                self.living.data.set(OWN + 5, Value.Number(if tag.contains("CollarColor") { int_or(tag, "CollarColor", 14) } else { 14 }))
            }
            if let Tag.Str(v) = string_at(tag, "variant") {
                if let at = index_of(self.variant_names, v) {
                    self.set_variant(at)
                }
            }
            var sound: i32? = none
            if let Tag.Str(v) = string_at(tag, "sound_variant") {
                if let s = self.sounds {
                    sound = s.id_of(v.copy())
                }
            }
            if let at = sound {
                self.set_sound_variant(at)
            }
            if species == CHICKEN {
                self.jockey = bool_or(tag, "IsChickenJockey")
                if tag.contains("EggLayTime") {
                    self.egg_time = int_or(tag, "EggLayTime", self.egg_time)
                }
            }
        }
        // `readLeashData` (CAL-179): its holder's UUID or a knot's place, found as it ticks; and
        // its home, where it has one, at the origin where its place isn't saved.
        if tag.contains("leash") {
            self.leash = some(Leash { saved: some(tag["leash"].copy()) })
        }
        let radius = int_or(tag, "home_radius", -1)
        if radius >= 0 {
            self.home = some((block_pos_at(tag, "home_pos") ?? (0, 0, 0), radius))
        }
        for key in ["drop_chances", "DeathLootTable", "DeathLootTableSeed", "LoveCause", "stew_effects", "Owner", "Items", "angry_at", "RaidId", "Offers", "Gossips", "ConversionPlayer", "Inventory"] {
            if tag.contains(key) {
                self.kept.insert(String(key), tag[key].copy())
            }
        }
        if self.living.sleeping != none {
            // Saved asleep: its size a sleeper's, as its pose's update refreshes it, and no
            // ambient sound (CAL-160).
            self.refresh_size()
            self.refresh_sounds()
        }
        return true
    }

    // `ZombieVillager.readAdditionalSaveData`'s: its villager data, final where it's saved or said
    // to be, its profession drawn again from its own random where it's said to be final but isn't
    // saved; being cured where its conversion time isn't -1, for that long, `start_curing`, its
    // weakness taken and strength given after the effects it saved, by its saved curer, whom it
    // keeps as it's saved; and its experience.
    fn load_villager(mut self, lf: LivingFacts, tag: JavaHashMap<String, Tag>) {
        var saved: (i32, i32, i32)? = none
        if let Tag.Compound(v) = string_at(tag, "VillagerData") {
            saved = some(villager_of(v.copy()))
        }
        let present = match saved {
            some(_) => true,
            none => false,
        }
        if bool_or(tag, "VillagerDataFinalized") or present {
            self.living.data.set(MONSTER_OWN + 5, Value.Bool(true))
            var data = (PLAINS_VILLAGERS, 0, 1)
            if let d = saved {
                data = d
            } else {
                data = (PLAINS_VILLAGERS, self.living.body.random.next_int_below(i32.wrap(builtin_entries(24).len())), 1)
            }
            let (kind, profession, level) = data
            self.living.data.set(MONSTER_OWN + 4, Value.Villager(kind, profession, level))
        }
        let time = int_or(tag, "ConversionTime", -1)
        if time != -1 {
            var unheard = List<EntitySound>()
            self.start_curing(lf, none, time, false, mut unheard)
        }
        self.villager_xp = int_or(tag, "Xp", 0)
    }

    // `Villager.readAdditionalSaveData`'s (CAL-160): its villager data, final where it's saved or
    // said to be, plains with no profession at level 1 where it's only said to be; its food,
    // gossip, experience, restocks and its gossip's last decay; its offers and inventory kept as
    // they're saved; then its brain made again, `refreshBrain`.
    fn load_villager_own(mut self, tag: JavaHashMap<String, Tag>) {
        var saved: (i32, i32, i32)? = none
        if let Tag.Compound(v) = string_at(tag, "VillagerData") {
            saved = some(villager_of(v.copy()))
        }
        if bool_or(tag, "VillagerDataFinalized") or saved != none {
            self.living.data.set(OWN + 2, Value.Bool(true))
            let (kind, profession, level) = saved ?? (PLAINS_VILLAGERS, 0, 1)
            self.living.data.set(OWN + 1, Value.Villager(kind, profession, level))
        }
        self.food_level = i32(i8.wrap(int_or(tag, "FoodLevel", 0)))
        self.gossips = Gossips()
        if tag.contains("Gossips") {
            self.gossips = Gossips.read(tag["Gossips"].copy())
        }
        self.villager_xp = int_or(tag, "Xp", 0)
        self.last_restock = long_at(tag, "LastRestock") ?? 0i64
        self.last_gossip_decay = long_at(tag, "LastGossipDecay") ?? 0i64
        self.restocks_today = int_or(tag, "RestocksToday", 0)
        self.refresh_brain()
    }

    // `ConversionTracker.readAdditionalSaveData`: how long it's been afflicted, `affliction`, 0
    // where it's not saved; converting where `conversion` is saved and isn't -1, for that long.
    fn load_conversion(mut self, tag: JavaHashMap<String, Tag>, affliction: str, conversion: str, at: usize) {
        self.affliction_time = int_or(tag, affliction, 0)
        let time = int_or(tag, conversion, -1)
        self.living.data.set(at, Value.Bool(time != -1))
        if time != -1 {
            self.conversion_time = time
        }
    }

    // `ConversionTracker.addAdditionalSaveData`: how long until it converts, -1 where it isn't
    // converting, under `conversion`, then how long it's been afflicted, -1 where it isn't now,
    // as `afflicted` says, under `affliction`.
    fn save_conversion(self, t: mut JavaHashMap<String, Tag>, affliction: str, conversion: str, at: usize, afflicted: bool) {
        t.insert(String(conversion), Tag.Int(if self.living.data.flag(at) { self.conversion_time } else { -1 }))
        t.insert(String(affliction), Tag.Int(if afflicted { self.affliction_time } else { -1 }))
    }

    /// What `saveAsPassenger` saves of it, its variants by name: what every living
    /// entity saves; then `Mob`'s, whether it may pick up loot and must stay, whether it's
    /// left-handed and without AI where it is, with what it keeps; an ageable mob's age, forced
    /// age and age lock; an animal's love; and its kind's own, a mooshroom's type, a sheep's wool,
    /// a cow's, pig's or chicken's variants, a chicken's ticks until it lays, a horse's or
    /// donkey's flags, temper and owner, with a horse's variant and a donkey's chest; a zombie's
    /// baby, doors and drowning, a skeleton's freezing, a creeper's power, fuse, radius and
    /// ignition, a slime's size, less 1, and whether it was on the ground; a zombie villager's
    /// villager data and cure, a witch's patrol and raid, and an enderman's block and anger.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.living.save_into(mut t, type_name(self.species))
        if let b = self.brain {
            t.insert(String("Brain"), b.packed())
        }
        t.insert(String("CanPickUpLoot"), flag_tag(self.picks_up_loot()))
        t.insert(String("PersistenceRequired"), flag_tag(self.persistence_required))
        self.put_kept(mut t, "drop_chances")
        // `writeLeashData`: its holder's UUID, a knot's place, or what it was saved with till
        // that's found; and its home (CAL-179).
        if let l = self.leash {
            if let h = l.holder {
                if let (kx, ky, kz) = h.knot {
                    t.insert(String("leash"), Tag.IntArray([kx, ky, kz]))
                } else {
                    var u = JavaHashMap<String, Tag>()
                    u.insert(String("UUID"), uuid_tag(h.uuid))
                    t.insert(String("leash"), Tag.Compound(u))
                }
            } else if let s = l.saved {
                t.insert(String("leash"), s.copy())
            }
        }
        if let (at, radius) = self.home {
            t.insert(String("home_radius"), Tag.Int(radius))
            t.insert(String("home_pos"), block_pos_tag(at))
        }
        t.insert(String("LeftHanded"), flag_tag(self.left_handed()))
        self.put_kept(mut t, "DeathLootTable")
        self.put_kept(mut t, "DeathLootTableSeed")
        if self.no_ai() {
            t.insert(String("NoAI"), flag_tag(true))
        }
        if self.ageable {
            // A parrot's never a baby, `canBeABaby`, and saves no age (CAL-201).
            if self.species != PARROT {
                t.insert(String("Age"), Tag.Int(self.age))
                t.insert(String("ForcedAge"), Tag.Int(self.forced_age))
                t.insert(String("AgeLocked"), flag_tag(self.living.data.flag(AGE_LOCKED)))
            }
            if self.animal {
                t.insert(String("InLove"), Tag.Int(self.in_love))
                self.put_kept(mut t, "LoveCause")
            }
        }
        if self.species == MOOSHROOM {
            let brown = self.living.data.number(MOOSHROOM_TYPE) == 1
            t.insert(String("Type"), Tag.Str(String(if brown { "brown" } else { "red" })))
            self.put_kept(mut t, "stew_effects")
        } else if self.equine() {
            t.insert(String("EatingHaystack"), flag_tag(self.horse_flag(16)))
            t.insert(String("Bred"), flag_tag(self.horse_flag(8)))
            t.insert(String("Temper"), Tag.Int(self.temper))
            t.insert(String("Tame"), flag_tag(self.horse_flag(2)))
            self.put_kept(mut t, "Owner")
            if self.species == SKELETON_HORSE {
                // `SkeletonHorse.addAdditionalSaveData` (CAL-349).
                t.insert(String("SkeletonTrap"), flag_tag(self.skeleton_trap))
                t.insert(String("SkeletonTrapTime"), Tag.Int(self.trap_time))
            }
            if self.species == HORSE {
                t.insert(String("Variant"), Tag.Int(self.horse_variant()))
            } else if self.chested() {
                let chested = self.living.data.flag(OWN + 1)
                t.insert(String("ChestedHorse"), flag_tag(chested))
                if chested {
                    var saved = List<Tag>()
                    for (i, held) in self.chest_items.enumerate() {
                        if let Tag.Compound(m) = held.copy() ?? Tag.End {
                            var entry = m.copy()
                            entry.insert(String("Slot"), Tag.Byte(i8.wrap(i32.wrap(i))))
                            saved.push(Tag.Compound(entry))
                        }
                    }
                    t.insert(String("Items"), Tag.List(saved))
                }
                if self.species == LLAMA {
                    // `Llama.addAdditionalSaveData`: its variant, by its number, and strength
                    // (CAL-201).
                    t.insert(String("Variant"), Tag.Int(self.living.data.number(OWN + 3)))
                    t.insert(String("Strength"), Tag.Int(self.llama_strength()))
                }
            }
        } else if self.species == SHEEP {
            t.insert(String("Sheared"), flag_tag(self.sheared()))
            t.insert(String("Color"), Tag.Byte(i8.wrap(self.color())))
        } else if self.zombie_class() {
            t.insert(String("IsBaby"), flag_tag(self.baby()))
            t.insert(String("CanBreakDoors"), flag_tag(self.can_break_doors))
            self.save_conversion(mut t, "InWaterTime", "DrownedConversionTime", MONSTER_OWN + 2, self.living.body.water_eyes)
            if self.species == ZOMBIFIED_PIGLIN {
                // `addPersistentAngerSaveData` (CAL-200).
                t.insert(String("anger_end_time"), Tag.Long(self.anger_end_time))
                if let a = self.anger_target {
                    t.insert(String("angry_at"), uuid_tag(a))
                }
            }
            if self.species == ZOMBIE_VILLAGER {
                // Its villager data by name, whether that's final, its offers and gossips, its
                // cure's time, -1 where it isn't being cured, and who's curing it, and its
                // experience.
                let (kind, profession, level) = self.living.data.villager(MONSTER_OWN + 4)
                var v = JavaHashMap<String, Tag>()
                v.insert(String("type"), Tag.Str(builtin_name(23, kind)))
                v.insert(String("profession"), Tag.Str(builtin_name(24, profession)))
                v.insert(String("level"), Tag.Int(level))
                t.insert(String("VillagerData"), Tag.Compound(v))
                t.insert(String("VillagerDataFinalized"), flag_tag(self.living.data.flag(MONSTER_OWN + 5)))
                self.put_kept(mut t, "Offers")
                self.put_kept(mut t, "Gossips")
                t.insert(String("ConversionTime"), Tag.Int(if self.living.data.flag(MONSTER_OWN + 3) { self.cure_time } else { -1 }))
                self.put_kept(mut t, "ConversionPlayer")
                t.insert(String("Xp"), Tag.Int(self.villager_xp))
            }
        } else if self.species == SKELETON {
            self.save_conversion(mut t, "FreezingTime", "StrayConversionTime", MONSTER_OWN, false)
        } else if self.species == BOGGED {
            t.insert(String("sheared"), flag_tag(self.living.data.flag(MONSTER_OWN)))
        } else if self.species == CREEPER {
            t.insert(String("powered"), flag_tag(self.living.data.flag(MONSTER_OWN + 1)))
            t.insert(String("Fuse"), Tag.Short(i16.wrap(self.max_swell)))
            t.insert(String("ExplosionRadius"), Tag.Byte(i8.wrap(self.explosion_radius)))
            t.insert(String("ignited"), flag_tag(self.living.data.flag(MONSTER_OWN + 2)))
        } else if cube_kind(self.species) {
            t.insert(String("Size"), Tag.Int(self.slime_size() - 1))
            t.insert(String("wasOnGround"), flag_tag(self.was_on_ground))
            if self.species == SULFUR_CUBE {
                // `SulfurCube.addAdditionalSaveData` (CAL-402).
                t.insert(String("pickup_timer"), Tag.Int(self.sulfur.pickup_timer))
                t.insert(String("from_bucket"), flag_tag(self.living.data.flag(OWN + 2)))
                t.insert(String("fuse"), Tag.Int(self.sulfur.fuse))
            }
        } else if self.species == WITHER_BOSS {
            // `WitherBoss.addAdditionalSaveData` (CAL-401).
            t.insert(String("Invul"), Tag.Int(self.wither_invulnerable()))
        } else if self.species == GHAST {
            t.insert(String("ExplosionPower"), Tag.Byte(i8.wrap(self.ghast_power)))
        } else if self.species == ZOGLIN {
            // `Zoglin.addAdditionalSaveData` (CAL-200).
            t.insert(String("IsBaby"), flag_tag(self.baby()))
        } else if self.species == HOGLIN {
            // `Hoglin.addAdditionalSaveData` (CAL-200).
            t.insert(String("IsImmuneToZombification"), flag_tag(self.living.data.flag(OWN)))
            t.insert(String("TimeInOverworld"), Tag.Int(self.time_in_overworld))
            t.insert(String("CannotBeHunted"), flag_tag(self.cannot_be_hunted))
        } else if self.species == PIGLIN_BRUTE {
            // `AbstractPiglin.addAdditionalSaveData` (CAL-200).
            t.insert(String("IsImmuneToZombification"), flag_tag(self.living.data.flag(MONSTER_OWN)))
            t.insert(String("TimeInOverworld"), Tag.Int(self.time_in_overworld))
        } else if self.species == PIGLIN {
            // `AbstractPiglin.addAdditionalSaveData`, then `Piglin`'s, its inventory as a villager's
            // is written, `writeInventoryToTag` (CAL-200).
            t.insert(String("IsImmuneToZombification"), flag_tag(self.living.data.flag(MONSTER_OWN)))
            t.insert(String("TimeInOverworld"), Tag.Int(self.time_in_overworld))
            t.insert(String("IsBaby"), flag_tag(self.baby()))
            t.insert(String("CannotHunt"), flag_tag(self.cannot_hunt))
            t.insert(String("Inventory"), Tag.List(self.stacks()))
        } else if self.species == SHULKER {
            t.insert(String("AttachFace"), Tag.Byte(i8.wrap(self.shulker_face())))
            t.insert(String("Peek"), Tag.Byte(self.living.data.byte(MONSTER_OWN + 1)))
            t.insert(String("Color"), Tag.Byte(self.living.data.byte(MONSTER_OWN + 2)))
        } else if self.species == ENDERMITE {
            t.insert(String("Lifetime"), Tag.Int(self.life))
        } else if let dr = self.dragon {
            // `EnderDragon.addAdditionalSaveData` (D608).
            t.insert(String("DragonPhase"), Tag.Int(dr.phase))
            t.insert(String("DragonDeathTime"), Tag.Int(dr.death_time))
            t.insert(String("sitting_damage_received"), Tag.Float(dr.sitting_damage))
        } else if raider_kind(self.species) {
            if let p = self.patrol_target {
                t.insert(String("patrol_target"), block_pos_tag(p))
            }
            t.insert(String("PatrolLeader"), flag_tag(self.patrol_leader))
            t.insert(String("Patrolling"), flag_tag(self.patrolling))
            t.insert(String("Wave"), Tag.Int(self.wave))
            t.insert(String("CanJoinRaid"), flag_tag(self.can_join_raid))
            if self.species == EVOKER {
                // `SpellcasterIllager.addAdditionalSaveData` (CAL-200).
                t.insert(String("SpellTicks"), Tag.Int(self.spell_ticks))
            }
            // Its raid's ID, where it's in one (CAL-167), else as it was read.
            if let id = self.raid {
                t.insert(String("RaidId"), Tag.Int(id))
            } else {
                self.put_kept(mut t, "RaidId")
            }
            // A vindicator named Johnny, `isJohnny`, saved only where it is (CAL-200).
            self.put_kept(mut t, "Johnny")
            if self.species == PILLAGER {
                // A pillager's inventory, `writeInventoryToTag`, as it was read, else empty.
                t.insert(String("Inventory"), if self.kept.contains("Inventory") { self.kept["Inventory"].copy() } else { Tag.List([]) })
            }
            if self.species == RAVAGER {
                // `Ravager.addAdditionalSaveData` (CAL-200).
                t.insert(String("AttackTick"), Tag.Int(self.attack_tick))
                t.insert(String("StunTick"), Tag.Int(self.stunned_tick))
                t.insert(String("RoarTick"), Tag.Int(self.roar_tick))
            }
        } else if self.species == SNOW_GOLEM {
            // `SnowGolem.addAdditionalSaveData` (CAL-201): whether it has its pumpkin.
            t.insert(String("Pumpkin"), flag_tag(self.has_pumpkin()))
        } else if self.species == IRON_GOLEM {
            // `IronGolem.addAdditionalSaveData` (CAL-201): whether a player made it, then its
            // anger, `addPersistentAngerSaveData`.
            t.insert(String("PlayerCreated"), flag_tag(self.player_created()))
            t.insert(String("anger_end_time"), Tag.Long(self.anger_end_time))
            if let a = self.anger_target {
                t.insert(String("angry_at"), uuid_tag(a))
            }
        } else if self.species == ENDERMAN {
            self.put_kept(mut t, "carriedBlockState")
            t.insert(String("anger_end_time"), Tag.Long(self.anger_end_time))
            if let a = self.anger_target {
                t.insert(String("angry_at"), uuid_tag(a))
            }
        } else if self.species == VILLAGER {
            // `AbstractVillager`'s offers and inventory, kept as they were saved; then
            // `Villager`'s: its data by name, whether that's final, its food, gossip, experience,
            // last restock, its gossip's last decay and its restocks today (CAL-160).
            self.put_kept(mut t, "Offers")
            t.insert(String("Inventory"), Tag.List(self.stacks()))
            let (kind, profession, level) = self.living.data.villager(OWN + 1)
            var v = JavaHashMap<String, Tag>()
            v.insert(String("type"), Tag.Str(builtin_name(23, kind)))
            v.insert(String("profession"), Tag.Str(builtin_name(24, profession)))
            v.insert(String("level"), Tag.Int(level))
            t.insert(String("VillagerData"), Tag.Compound(v))
            t.insert(String("VillagerDataFinalized"), flag_tag(self.living.data.flag(OWN + 2)))
            t.insert(String("FoodLevel"), Tag.Byte(i8.wrap(self.food_level)))
            t.insert(String("Gossips"), self.gossips.saved())
            t.insert(String("Xp"), Tag.Int(self.villager_xp))
            t.insert(String("LastRestock"), Tag.Long(self.last_restock))
            t.insert(String("LastGossipDecay"), Tag.Long(self.last_gossip_decay))
            t.insert(String("RestocksToday"), Tag.Int(self.restocks_today))
        } else if self.species == ARMADILLO {
            t.insert(String("state"), Tag.Str(String(armadillo_state_name(self.armadillo_state()))))
            t.insert(String("scute_time"), Tag.Int(self.scute_time))
        } else if self.species == VEX {
            // `Vex.addAdditionalSaveData` (CAL-200).
            if let b = self.vex_bound {
                t.insert(String("bound_pos"), block_pos_tag(b))
            }
            if let left = self.vex_life {
                t.insert(String("life_ticks"), Tag.Int(left))
            }
            if let o = self.vex_owner {
                t.insert(String("owner"), uuid_tag(o))
            }
        } else if self.species == PHANTOM {
            // `Phantom.addAdditionalSaveData` (CAL-200).
            if let a = self.phantom.anchor {
                t.insert(String("anchor_pos"), block_pos_tag(a))
            }
            t.insert(String("size"), Tag.Int(self.phantom_size()))
        } else if fish_kind(self.species) {
            // `AbstractFish.addAdditionalSaveData` (CAL-178), then a salmon's size by its name,
            // `Salmon.addAdditionalSaveData` (CAL-201).
            t.insert(String("FromBucket"), flag_tag(self.from_bucket()))
            if self.species == SALMON {
                t.insert(String("type"), Tag.Str(String(salmon_size_name(self.salmon_size()))))
            }
            if self.species == TROPICAL_FISH {
                // `TropicalFish.addAdditionalSaveData` (CAL-201).
                t.insert(String("Variant"), Tag.Int(self.living.data.number(TROPICAL_VARIANT)))
            }
            if self.species == PUFFERFISH {
                // `Pufferfish.addAdditionalSaveData` (CAL-201).
                t.insert(String("PuffState"), Tag.Int(self.puff_state()))
            }
        } else if self.species == GLOW_SQUID {
            // `GlowSquid.addAdditionalSaveData` (CAL-201).
            t.insert(String("DarkTicksRemaining"), Tag.Int(self.living.data.number(GLOW_DARK)))
        } else if self.species == DOLPHIN {
            // `Dolphin.addAdditionalSaveData` (CAL-201).
            t.insert(String("GotFish"), Tag.Byte(if self.living.data.flag(GOT_FISH) { 1i8 } else { 0i8 }))
            t.insert(String("Moistness"), Tag.Int(self.living.data.number(MOISTNESS)))
        } else if self.species == BEE {
            // `Bee.addAdditionalSaveData` (CAL-177): its hive and flower where it knows them, its
            // nectar, sting and counts, then its anger, `addPersistentAngerSaveData`.
            if let h = self.bee.hive {
                t.insert(String("hive_pos"), block_pos_tag(h))
            }
            if let fl = self.bee.flower {
                t.insert(String("flower_pos"), block_pos_tag(fl))
            }
            t.insert(String("HasNectar"), flag_tag(self.bee_flag(BEE_NECTAR)))
            t.insert(String("HasStung"), flag_tag(self.bee_flag(BEE_STUNG)))
            t.insert(String("TicksSincePollination"), Tag.Int(self.bee.without_nectar))
            t.insert(String("CannotEnterHiveTicks"), Tag.Int(self.bee.stay_out))
            t.insert(String("CropsGrownSincePollination"), Tag.Int(self.bee.crops_grown))
            t.insert(String("anger_end_time"), Tag.Long(self.living.data.long(OWN + 1)))
            if let a = self.anger_target {
                t.insert(String("angry_at"), uuid_tag(a))
            }
        } else if not self.spider_kind() {
            if self.species == WOLF {
                // `Wolf.addAdditionalSaveData` (CAL-201): `TamableAnimal`'s owner, where it has one,
                // and whether it's ordered to sit; its collar's color; and its anger,
                // `addPersistentAngerSaveData`.
                if let o = self.living.data.uuid(OWN + 1) {
                    t.insert(String("Owner"), uuid_tag(o))
                }
                t.insert(String("Sitting"), flag_tag(self.wolf.sitting))
                t.insert(String("CollarColor"), Tag.Byte(i8.wrap(self.living.data.number(OWN + 3))))
                t.insert(String("anger_end_time"), Tag.Long(self.living.data.long(OWN + 4)))
                if let a = self.anger_target {
                    t.insert(String("angry_at"), uuid_tag(a))
                }
            }
            if self.species == RABBIT {
                // `Rabbit.addAdditionalSaveData` (CAL-201): its variant and its ticks till it wants
                // carrots.
                t.insert(String("RabbitType"), Tag.Int(self.living.data.number(OWN)))
                t.insert(String("MoreCarrotTicks"), Tag.Int(self.rabbit.more_carrots))
            }
            if self.species == FOX {
                // `Fox.addAdditionalSaveData` (CAL-201): those it trusts, whether it sleeps, its
                // variant, whether it sits and crouches.
                var trusted = List<Tag>()
                for slot in [OWN + 2, OWN + 3] {
                    if let u = self.living.data.uuid(slot) {
                        trusted.push(uuid_tag(u))
                    }
                }
                t.insert(String("Trusted"), Tag.List(trusted))
                t.insert(String("Sleeping"), flag_tag(self.fox_flag(FOX_SLEEPING)))
                t.insert(String("Type"), Tag.Str(String(if self.living.data.number(OWN) == 1 { "snow" } else { "red" })))
                t.insert(String("Sitting"), flag_tag(self.fox_flag(FOX_SITTING)))
                t.insert(String("Crouching"), flag_tag(self.fox_flag(FOX_CROUCHING)))
            }
            if self.species == PANDA {
                // `Panda.addAdditionalSaveData` (CAL-201): its genes by their names.
                t.insert(String("MainGene"), Tag.Str(String(gene_name(self.panda_main()))))
                t.insert(String("HiddenGene"), Tag.Str(String(gene_name(self.panda_hidden()))))
            }
            if self.species == POLAR_BEAR {
                // `PolarBear.addAdditionalSaveData` (CAL-201): its anger,
                // `addPersistentAngerSaveData`.
                t.insert(String("anger_end_time"), Tag.Long(self.anger_end_time))
                if let a = self.anger_target {
                    t.insert(String("angry_at"), uuid_tag(a))
                }
            }
            if self.species == OCELOT {
                // `Ocelot.addAdditionalSaveData` (CAL-201): whether it trusts.
                t.insert(String("Trusting"), flag_tag(self.ocelot_trusting()))
            }
            if self.species == BAT {
                // `Bat.addAdditionalSaveData` (CAL-201): its flags, `BatFlags`.
                t.insert(String("BatFlags"), Tag.Byte(self.living.data.byte(MONSTER_OWN)))
            }
            if self.species == TURTLE {
                // `Turtle.addAdditionalSaveData` (CAL-201): its home, after a mob's own, and whether
                // it has an egg.
                t.insert(String("home_pos"), block_pos_tag(self.turtle.home))
                t.insert(String("has_egg"), flag_tag(self.living.data.flag(OWN)))
            }
            if self.species == PARROT {
                // `Parrot.addAdditionalSaveData` (CAL-201): `TamableAnimal`'s owner, where it has
                // one, and whether it's ordered to sit; its variant by its ID.
                if let o = self.living.data.uuid(OWN + 1) {
                    t.insert(String("Owner"), uuid_tag(o))
                }
                t.insert(String("Sitting"), flag_tag(self.wolf.sitting))
                t.insert(String("Variant"), Tag.Int(self.living.data.number(OWN + 2)))
            }
            if self.species == CAT {
                // `Cat.addAdditionalSaveData` (CAL-201): `TamableAnimal`'s owner, where it has one,
                // and whether it's ordered to sit; its collar's color. Its variants come after.
                if let o = self.living.data.uuid(OWN + 1) {
                    t.insert(String("Owner"), uuid_tag(o))
                }
                t.insert(String("Sitting"), flag_tag(self.wolf.sitting))
                t.insert(String("CollarColor"), Tag.Byte(i8.wrap(self.living.data.number(OWN + 5))))
            }
            if self.variant >= 0 and usize.wrap(self.variant) < self.variant_names.len() {
                t.insert(String("variant"), Tag.Str(self.variant_names[usize.wrap(self.variant)].copy()))
            }
            if let s = self.sounds {
                if self.sound_variant >= 0 and usize.wrap(self.sound_variant) < s.names.len() {
                    t.insert(String("sound_variant"), Tag.Str(s.names[usize.wrap(self.sound_variant)].copy()))
                }
            }
            if self.species == CHICKEN {
                t.insert(String("IsChickenJockey"), flag_tag(self.jockey))
                t.insert(String("EggLayTime"), Tag.Int(self.egg_time))
            }
        }
        return Tag.Compound(t)
    }

    fn put_kept(self, t: mut JavaHashMap<String, Tag>, key: str) {
        if self.kept.contains(key) {
            t.insert(String(key), self.kept[key].copy())
        }
    }
}

