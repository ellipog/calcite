            mb.living.breathes_water = true
            mb.living.water_slow_down = 0.96f32
            mb.living.skeleton_swims = true
        }
        if mb.equine() {
            mb.ambient_interval = 400
            mb.sound_volume = 0.8f32
            mb.max_cluster = 6
            // A llama's steps its own, `Llama.playStepSound` (CAL-201).
            mb.living.step_by_block = species != LLAMA
            // A donkey or llama, `AbstractChestedHorse`, doesn't gallop (D710).
            mb.living.gallops = species != DONKEY and species != LLAMA
