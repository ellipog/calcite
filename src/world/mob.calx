// The kind's size grown, across, high and its eyes, then a baby's.
fn shape(species: i32) -> (f32, f32, f32, f32, f32, f32) {
    if species == PIG {
        return (0.9f32, 0.9f32, 0.9f32 * 0.85f32, 0.45f32, 0.45f32, 0.40625f32)
    }
    if species == CHICKEN {
        return (0.4f32, 0.7f32, 0.644f32, 0.3f32, 0.4f32, 0.28125f32)
    }
    if species == SHEEP {
        return (0.9f32, 1.3f32, 1.235f32, 0.45f32, 0.65f32, 0.65625f32)
    }
    // A foal is its kind's size scaled, a horse's and a zombie horse's by 0.7 and a donkey's by 0.5.
    if species == HORSE or species == ZOMBIE_HORSE {
        return (1.3964844f32, 1.6f32, 1.52f32, 1.3964844f32 * 0.7f32, 1.6f32 * 0.7f32, 1.52f32 * 0.7f32)
    }
    if species == DONKEY {
        return (1.3964844f32, 1.5f32, 1.425f32, 1.3964844f32 * 0.5f32, 1.5f32 * 0.5f32, 1.425f32 * 0.5f32)
    }
    // The monsters: a creeper's eyes at 0.85 of its height, as its type gives none; a baby zombie
    // its own size, `BABY_DIMENSIONS`.
    if species == CREEPER {
        return (0.6f32, 1.7f32, 1.7f32 * 0.85f32, 0.6f32, 1.7f32, 1.7f32 * 0.85f32)
    }
    if species == ZOMBIE {
        return (0.6f32, 1.95f32, 1.74f32, 0.49f32, 0.98f32, 0.775f32)
    }
    if species == SKELETON {
        return (0.6f32, 1.99f32, 1.74f32, 0.6f32, 1.99f32, 1.74f32)
    }
    if species == SPIDER {
        return (1.4f32, 0.9f32, 0.65f32, 1.4f32, 0.9f32, 0.65f32)
    }
    if species == ENDERMAN {
        return (0.6f32, 2.9f32, 2.55f32, 0.6f32, 2.9f32, 2.55f32)
    }
    if species == WITCH {
        return (0.6f32, 1.95f32, 1.62f32, 0.6f32, 1.95f32, 1.62f32)
    }
    if species == ZOMBIE_VILLAGER {
        return (0.6f32, 1.95f32, 1.74f32, 0.49f32, 0.98f32, 0.67f32)
    }
    // A slime's of size 1, as it's made.
    if species == SLIME {
        return (0.52f32, 0.52f32, 0.325f32, 0.52f32, 0.52f32, 0.325f32)
    }
    // An armadillo's baby its size scaled by 0.6, its eyes at 0.21875 (CAL-160).
    if species == ARMADILLO {
        return (0.7f32, 0.65f32, 0.26f32, 0.7f32 * 0.6f32, 0.65f32 * 0.6f32, 0.21875f32)
    }
    // A villager's baby its own size, `BABY_DIMENSIONS` (CAL-160).
    if species == VILLAGER {
        return (0.6f32, 1.95f32, 1.62f32, 0.49f32, 0.98f32, 0.63f32)
    }
    // An endermite's, its eyes at 0.13, never a baby (D583).
    if species == ENDERMITE {
        return (0.4f32, 0.3f32, 0.13f32, 0.4f32, 0.3f32, 0.13f32)
    }
    // An ender dragon's, 16 by 8, its eyes `EntityDimensions`' 0.85 of its height (D608).
    if species == ENDER_DRAGON {
        return (16.0f32, 8.0f32, 8.0f32 * 0.85f32, 16.0f32, 8.0f32, 8.0f32 * 0.85f32)
    }
    return (0.9f32, 1.4f32, 1.3f32, 0.45f32, 0.7f32, 0.69f32)
}

// The kind's values as its constructor defines them, its variants the defaults.
fn data_of(species: i32, facts: MobFacts) -> EntityData {
    if species == COW {
        return cow_data(facts.cow.default, facts.cow_sounds.default)
    }
    if species == PIG {
        return pig_data(facts.pig.default, facts.pig_sounds.default)
    }
    if species == CHICKEN {
        return chicken_data(facts.chicken.default, facts.chicken_sounds.default)
    }
    if species == SHEEP {
        return sheep_data()
    }
    if species == HORSE {
        return horse_data()
    }
    if species == DONKEY {
        return donkey_data()
    }
    if species == CREEPER {
        return creeper_data()
    }
    if species == ZOMBIE {
        return zombie_data()
    }
    if species == SKELETON {
        return skeleton_data()
    }
    if species == SPIDER {
        return spider_data()
    }
    if species == SLIME {
        return slime_data()
    }
    if species == ENDERMAN {
        return enderman_data()
    }
    if species == WITCH {
        return witch_data()
    }
    if species == ZOMBIE_VILLAGER {
        return zombie_villager_data()
    }
    if species == ZOMBIE_HORSE {
        return zombie_horse_data()
    }
    if species == ARMADILLO {
        return armadillo_data()
    }
    if species == VILLAGER {
        return villager_data()
    }
    if species == ENDERMITE {
        return endermite_data()
    }
    if species == ENDER_DRAGON {
        return dragon_data()
    }
    return mooshroom_data()
}

// The attribute `minecraft:{name}`'s ID.
fn attribute(name: str) -> u32 {
    return attribute_id("minecraft:{name}") ?? panic("no attribute {name}")
}

// A stack of one of the item `name`, `new ItemStack(item)`, as it's saved.
// The effects of the potion the stack `stack` holds, its `potion_contents`' scaled by its
// `potion_duration_scale`, 1 where it has none; none where it holds none (CAL-163).
fn potion_of(stack: Tag?) -> List<ActiveEffect> {
    let s = stack.copy() else return List<ActiveEffect>()
    let Tag.Compound(m) = s else return List<ActiveEffect>()
    if not m.contains("components") {
        return List<ActiveEffect>()
    }
    let Tag.Compound(c) = m["components"] else return List<ActiveEffect>()
    if not c.contains("minecraft:potion_contents") {
        return List<ActiveEffect>()
    }
    var scale = 1.0f32
    if c.contains("minecraft:potion_duration_scale") {
        if let Tag.Float(v) = c["minecraft:potion_duration_scale"] {
            scale = v
        }
    }
    return contents_effects(c["minecraft:potion_contents"].copy(), scale)
}

// One of the item `item` holding the potion `potion`, `PotionContents.createItemStack` (CAL-159).
fn potion_stack(item: str, potion: str) -> Tag {
    var contents = JavaHashMap<String, Tag>()
    contents.insert(String("potion"), Tag.Str(String(potion)))
    var components = JavaHashMap<String, Tag>()
    components.insert(String("minecraft:potion_contents"), Tag.Compound(contents))
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String(item)))
    m.insert(String("count"), Tag.Int(1))
    m.insert(String("components"), Tag.Compound(components))
    return Tag.Compound(m)
}

fn stack_of(name: own String) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(name))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

// `getEquipmentForSlot`: the armor of the tier `tier` for the slot `slot`, by `EquipmentSlot`'s
// order, leather, copper, gold, chainmail, iron then diamond; none for another.
fn armor_for(slot: usize, tier: i32) -> String? {
    if tier < 0 or tier > 5 or slot < 2 or slot > 5 {
        return none
    }
    let materials = ["leather", "copper", "golden", "chainmail", "iron", "diamond"]
    let pieces = ["", "", "boots", "leggings", "chestplate", "helmet"]
    let material = materials[usize.wrap(tier)]
    let piece = pieces[slot]
    return some("minecraft:{material}_{piece}")
}

// Where `name` is among `names`, if it is.
fn index_of(names: List<String>, name: String) -> i32? {
    for i in 0..names.len() {
        if names[i] == name {
            return some(i32.wrap(i))
        }
    }
    return none
}

// `SheepColorSpawnRules.getSheepColor` in the `climate`, 0 temperate, 1 warm and 2 cold: of 100,
// three colors 5 each and one 3, the rest the climate's own, which is pink 1 in 500.
fn sheep_color<R: RandomSource>(climate: i32, r: mut R) -> i32 {
    // White 0, pink 6, gray 7, light gray 8, brown 12, black 15.
    let (a, b, c, d, usual) = if climate == 1 { (7, 8, 0, 15, 12) } else if climate == 2 { (8, 7, 0, 12, 15) } else { (15, 7, 8, 12, 0) }
    let pick = r.next_int_below(100)
    if pick < 5 {
        return a
    }
    if pick < 10 {
        return b
    }
    if pick < 15 {
        return c
    }
    if pick < 18 {
        return d
    }
    return if r.next_int_below(500) < 499 { usual } else { 6 }
}

// The tag at `key`, or none.
fn string_at(tag: JavaHashMap<String, Tag>, key: str) -> Tag {
    if tag.contains(key) {
        return tag[key].copy()
    }
    return Tag.End
}

// The number at `key` as a long, `getLong`, whatever kind of number it's saved as, none where
// there's none.
fn long_at(tag: JavaHashMap<String, Tag>, key: str) -> i64? {
    if not tag.contains(key) {
        return none
    }
    return tag[key].long_value()
}

// The name of the entry `id` of the built-in registry at `registry` in `builtin_entries`' list,
// `minecraft:none` where there's no such entry.
fn builtin_name(registry: usize, id: i32) -> String {
    let entries = builtin_entries(registry)
    if id < 0 or usize.wrap(id) >= entries.len() {
        return String("minecraft:none")
    }
    return "minecraft:{entries[usize.wrap(id)]}"
}

// The ID of the entry `name` in the built-in registry at `registry`, if it holds it.
fn builtin_id(registry: usize, name: String) -> i32? {
    let entries = builtin_entries(registry)
    for i in 0..entries.len() {
        if "minecraft:{entries[i]}" == name {
            return some(i32.wrap(i))
        }
    }
    return none
}

// Whether the block at x, y, z is one a baby villager jumps on, `#villager_babies_can_jump_on_bed`.
fn jumpable<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    return f.tag(String("minecraft:villager_babies_can_jump_on_bed")).contains(f.block(state_at(blocks, x, y, z)))
}

// The state at x, y, z as a villager swinging doors reads it in one go (CAL-160): the last it
// swung there, `swung`, else the level's, which its level only changes as its brain's tick stops.
fn door_state<B: CollisionBlocks>(blocks: B, swung: List<(i32, i32, i32, u32)>, x: i32, y: i32, z: i32) -> u32 {
    var k = swung.len()
    while k > 0 {
        k -= 1
        let (sx, sy, sz, s) = swung[k]
        if sx == x and sy == y and sz == z {
            return s
        }
    }
    return state_at(blocks, x, y, z)
}

// Whether `state` is a door mobs open, `#mob_interactable_doors` and a `DoorBlock` (CAL-160).
fn mob_door(f: Facts, state: u32) -> bool {
    let block = f.block(state)
    return f.is_a(block, "DoorBlock") and f.tag(String("minecraft:mob_interactable_doors")).contains(block)
}

// `rememberDoorToClose` (CAL-160): the door at `pos` in `dimension` added to those the brain
// keeps to close, `DOORS_TO_CLOSE`, where it isn't there yet, those made where there are none.
fn remember_door(brain: mut Brain, dimension: String, pos: (i32, i32, i32)) {
    let (x, y, z) = pos
    var doors = brain.places(MEMORY_DOORS_TO_CLOSE)
    for g in doors {
        if g.dimension == dimension and g.pos.x == x and g.pos.y == y and g.pos.z == z {
            return
        }
    }
    doors.push(GlobalPos { dimension: dimension.copy(), pos: BlockPos { x: x, y: y, z: z } })
    brain.set(MEMORY_DOORS_TO_CLOSE, Memo.Places(doors))
}

// `ShowTradesToPlayer.lookAtTarget`: what the brain interacts with looked at, at its eyes, and
// which that is.
fn look_at_interaction(brain: mut Brain) -> i32? {
    let id = brain.entity(MEMORY_INTERACTION_TARGET) else return none
    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Entity(Follow { id: id, eyes: true })))
    return some(id)
}

// A villager's data as `VillagerData.CODEC` reads it: its type and profession by name, plains and
// none where they're missing or unknown, and its level, at least 1.
fn villager_of(v: JavaHashMap<String, Tag>) -> (i32, i32, i32) {
    var kind = PLAINS_VILLAGERS
    if let Tag.Str(name) = string_at(v, "type") {
        if let at = builtin_id(23, name.copy()) {
            kind = at
        }
    }
    var profession = 0
    if let Tag.Str(name) = string_at(v, "profession") {
        if let at = builtin_id(24, name.copy()) {
            profession = at
        }
    }
    let level = int_or(v, "level", 1)
    return (kind, profession, if level < 1 { 1 } else { level })
}

// A flag as a byte, as `putBoolean` saves it.
fn flag_tag(on: bool) -> Tag {
    return Tag.Byte(if on { 1i8 } else { 0i8 })
}

// What a mob's navigation reads of its level besides its blocks, for a tick.
fn nav_facts<B: NavLevel>(lf: LivingFacts, blocks: B, min_y: i32) -> NavFacts {
    return NavFacts { min_y: min_y, top_y: blocks.top_y(), time: blocks.level_time(), floatable: lf.paths.floatable }
}

// What a goal is asked by its selector.
/// What a player's use of a mob did, `InteractionResult`: nothing, `PASS`; or it was used, the
/// client swinging the player's arm, `SUCCESS`, the server swinging it, `SUCCESS_SERVER`, or no one,
/// `CONSUME` (CAL-158).
pub const INTERACT_PASS: i32 = 0
pub const INTERACT_SUCCESS: i32 = 1
pub const INTERACT_SERVER: i32 = 2
pub const INTERACT_CONSUME: i32 = 3

/// A use of a mob's result, by its `INTERACT_` kind, and whether it used one of what the hand
/// held, `usePlayerItem`; and the sounds it made, for its level to play (CAL-160).
pub struct Interaction {
    pub result: i32
    pub used: bool
    pub sounds: List<EntitySound> = List<EntitySound>()
    /// Whether a villager's to start trading with the player who used it, `startTrading`, which
    /// its level does, as it opens their merchant menu (CAL-160).
    pub trades: bool = false
    /// Whether the player talked to a villager, which counts their `TALKED_TO_VILLAGER`
    /// (CAL-164).
    pub talked: bool = false
    /// What its level drops where it was, `spawnAtLocation`, as an armadillo's brushed scute
    /// (CAL-160).
    pub dropped: Laid? = none
    /// The wear on what the player used it with, `hurtAndBreak`, as a brush's (CAL-160).
    pub wear: i32 = 0
}

/// The player a villager trades with, by their entity ID and their UUID (CAL-160).
pub struct Trader {
    pub id: i32
    pub uuid: (i64, i64)
}

/// What a villager's trade gave, `rewardTradeXp` (CAL-160): the experience of the orb its level's
/// to make, where the offer rewards it; and whether it went up a level, `increaseMerchantCareer`,
/// so its level's to add the next level's offers, `updateTrades`.
pub struct TradeReward {
    pub orb: i32? = none
    pub leveled: bool = false
}

// `SimpleContainer.addItem` of `stack` into `slots` (CAL-160): put with the stacks of the same item
// and components, from the first slot, as far as each holds, the least of 99 and its most,
// `getMaxStackSize`, then the rest, all of it, in the first empty slot; what's left, none where it
// all went in.
fn add_to(slots: mut List<Tag?>, stack: Tag, f: Facts) -> Tag? {
    var left = count_of(some(stack.copy()))
    if left <= 0 {
        return none
    }
    for i in 0..slots.len() {
        let here = slots[i].copy() else continue
        if not same_components(some(here.copy()), some(stack.copy())) {
            continue
        }
        let have = count_of(some(here.copy()))
        let most = min_i32(99, stack_limit(f, here))
        let diff = min_i32(left, most - have)
        if diff > 0 {
            slots[i] = some(stack_of_count(here, have + diff))
            left -= diff
        }
        if left == 0 {
            return none
        }
    }
    for i in 0..slots.len() {
        if slots[i] == none {
            slots[i] = some(stack_of_count(stack, left))
            return none
        }
    }
    return some(stack_of_count(stack, left))
}

// `ItemStack.getMaxStackSize` of `stack`: its own `max_stack_size` where its components set it, 1
// where they take it away, else its item's.
fn stack_limit(f: Facts, stack: Tag) -> i32 {
    let Tag.Compound(m) = stack else return 64
    if m.contains("components") {
        if let Tag.Compound(c) = m["components"] {
            if c.contains("minecraft:max_stack_size") {
                if let Tag.Int(n) = c["minecraft:max_stack_size"] {
                    return n
                }
            }
            if c.contains("!minecraft:max_stack_size") {
                return 1
            }
        }
    }
    return f.max_stack_size(held_name(some(stack.copy())))
}

// `HarvestFarmland.validPos` of the block at x, y, z (CAL-160): a crop at its last age, or air on
// farmland.
fn workable<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let state = state_at(blocks, x, y, z)
    let block = f.block(state)
    if f.is_a(block, String("CropBlock")) and (f.get_int(state, String("age")) ?? 0) >= f.crop_max_age(block) {
        return true
    }
    return f.is_air(state) and f.is_a(f.block(state_at(blocks, x, y - 1, z)), String("FarmlandBlock"))
}

// `HarvestFarmland.getValidFarmland`: one of `farmland` drawn from the level's random, or none
// where there's none.
fn pick_farmland(farmland: List<(i32, i32, i32)>, random: mut TapedRandom) -> (i32, i32, i32)? {
    if farmland.is_empty() {
        return none
    }
    return some(farmland[usize.wrap(random.next_int_below(i32.wrap(farmland.len())))])
}

// `UseBonemeal.setCurrentCropAsTarget`: the crop, where there's one, looked at and walked to at
// half speed, near enough within 1.
fn target_crop(brain: mut Brain, crop: (i32, i32, i32)?) {
    let c = crop else return
    let (x, y, z) = c
    brain.set(MEMORY_LOOK_TARGET, Memo.Look(Tracker.Block(Spot.of_block(x, y, z))))
    brain.set(MEMORY_WALK_TARGET, Memo.Walk(Walk { target: Tracker.Block(Spot.of_block(x, y, z)), speed: 0.5f32, close_enough: 1 }))
}

// `VillagerProfession.FARMER`'s `requestedItems`, which no other profession has any of.
fn farmer_requests() -> List<String> {
    return [String("minecraft:wheat"), String("minecraft:wheat_seeds"), String("minecraft:beetroot_seeds"), String("minecraft:bone_meal")]
}

// The items with a `villager_food` component, which villagers eat and count as food.
fn villager_foods() -> List<String> {
    return [String("minecraft:bread"), String("minecraft:carrot"), String("minecraft:potato"), String("minecraft:beetroot")]
}

// The `nutrition` of the item `id`'s `villager_food` component, bread's 4 and a carrot's,
// potato's or beetroot's 1, or 0 for an item without one.
fn villager_food(id: String) -> i32 {
    if id == "minecraft:bread" {
        return 4
    }
    if id == "minecraft:carrot" or id == "minecraft:potato" or id == "minecraft:beetroot" {
        return 1
    }
    return 0
}

/// The yaw of what gets up from the bed at bx, by, bz to sx, sy, sz, `stopSleeping`'s: turned to
/// the bed's floor's middle, `Vec3.atBottomCenterOf(bed).subtract(standUp).normalize()`, by
/// `Mth.atan2`, wrapped and made a float (CAL-160, D574).
pub fn bed_yaw(bx: i32, by: i32, bz: i32, sx: f64, sy: f64, sz: f64) -> f32 {
    let (dx, dy, dz) = (f64(bx) + 0.5 - sx, f64(by) - sy, f64(bz) + 0.5 - sz)
    let length = (dx * dx + dy * dy + dz * dz).sqrt()
    var (lx, lz) = (0.0, 0.0)
    if length >= f64(1.0e-5f32) {
        lx = dx / length
        lz = dz / length
    }
    let angle = table_atan2(lz, lx) ?? 0.0
    return f32.nearest(wrap_degrees_f64(angle * RAD_TO_DEG - 90.0))
}

/// `getSleepHeight` of the bed at x, y, z: a straw bed's head that of its foot, none where its
/// foot isn't there, `StrawBedBlock.getSleepHeight`, any other's `sleep_height` (D574).
pub fn bed_sleep_height<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, x: i32, y: i32, z: i32) -> f64? {
    let state = state_at(blocks, x, y, z)
    let block = f.block(state)
    if not f.is_a(block, "StrawBedBlock") or (f.get_name(state, "part") ?? String()) != "head" {
        return sleep_height(f, m, state, x, z)
    }
    // `getConnectedDirection` of a head: the way it faces, turned round.
    let facing = match facing_of(f, state) {
        ok(d) => d,
        err(_) => return none,
    }
    let (fx, fz) = (x - step_x(facing), z - step_z(facing))
    let foot = state_at(blocks, fx, y, fz)
    if f.block(foot) != block or (f.get_name(foot, "part") ?? String()) != "foot" {
        return none
    }
    return sleep_height(f, m, foot, fx, fz)
}

// `AbstractBedBlock.getSleepHeight` of the state at x, z: the top of its outline shape, none
// where it's no bed or has no shape (CAL-160).
fn sleep_height(f: Facts, m: MovementStates, state: u32, x: i32, z: i32) -> f64? {
    if not f.is_a(f.block(state), "AbstractBedBlock") {
        return none
    }
    var top: f64? = none
    for b in m.outline_boxes(f, state, x, z) {
        if top == none or b.max_y > (top ?? 0.0) {
            top = some(b.max_y)
        }
    }
    return top
}

// `stack` with `n` of it.
fn stack_of_count(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

fn min_i32(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

// `getOffers` of a villager whose offers are made where `made` (CAL-160): where they're still to
// make, the level makes them as it's done ticking, `Shown.Offers`, so what's done to them till
// then is counted in `fresh`, from 0, the times their demand's updated; fresh offers have no
// uses, so nothing else changes them.
fn ask_offers(made: bool, fresh: mut i32?) {
    if not made and fresh == none {
        fresh = some(0)
    }
}

// `VillagerData.getMaxXpPerLevel`: the experience a villager at `level`, 1 to 4, goes up a level
// with; 0 for one that can't.
fn next_level_xp(level: i32) -> i32 {
    let thresholds: List<i32> = [0, 10, 70, 150, 250]
    return if level >= 1 and level < 5 { thresholds[usize.wrap(level)] } else { 0 }
}

// `Mob.setAggressive`'s bit of its flags (CAL-159).
const AGGRESSIVE_FLAG: i32 = 4

const GOAL_CAN_USE: i32 = 0
const GOAL_CONTINUE: i32 = 1
const GOAL_START: i32 = 2
const GOAL_STOP: i32 = 3
const GOAL_TICK: i32 = 4

// `Mth.floor`.
fn floor_of(v: f64) -> i32 {
    return i32.saturate(v.floor())
}

// The place among `players` of the one `id`, where it's still in the level.
// `asValidTarget` of the player `id` among `players` (CAL-159): them where they aren't in creative
// or spectating and may be seen as an enemy, `canAttack`, alive and not invulnerable; none for
// anyone else, as mobs come later.
fn valid_target(players: List<Follower>, id: i32) -> Follower? {
    let at = player_at(players, id) else return none
    let p = players[at].copy()
    if p.creative or p.spectator or p.dead or not p.enemy {
        return none
    }
    return some(p)
}

fn player_at(players: List<Follower>, id: i32) -> usize? {
    for i in 0..players.len() {
        if players[i].id == id {
            return some(i)
        }
    }
    return none
}

// The name of the dye `id`, in `DyeColor`'s order (D416).
fn dye_name(id: i32) -> str {
    let names: List<str> = ["white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black"]
    if id < 0 or usize.wrap(id) >= names.len() {
        return "white"
    }
    return names[usize.wrap(id)]
}

// Whether `stack` is enchanted with one that keeps it from dropping, `prevent_equipment_drop`,
// curse of vanishing (D416).
fn vanishes<W: Wearing>(items: W, stack: Tag) -> bool {
    for (_, definition) in items.worn_enchantments(stack) {
        if definition.contains("effects") {
            if let Tag.Compound(effects) = definition["effects"] {
                if effects.contains("minecraft:prevent_equipment_drop") {
                    return true
                }
            }
        }
    }
    return false
}

// Whether an enchantment of `stack` keeps it on, `PREVENT_ARMOR_CHANGE`, as binding's curse does
// (CAL-159).
fn binds<W: Wearing>(items: W, stack: Tag) -> bool {
    for (_, definition) in items.worn_enchantments(stack) {
        if definition.contains("effects") {
            if let Tag.Compound(effects) = definition["effects"] {
                if effects.contains("minecraft:prevent_armor_change") {
                    return true
                }
            }
        }
    }
    return false
}

// The slot of `stack`'s equippable, by `EquipmentSlot`'s order, none where it hasn't one or it
// names no slot (CAL-159).
fn equippable_slot<W: Wearing>(items: W, stack: Tag) -> usize? {
    let Tag.Compound(e) = items.worn_component(stack, String("minecraft:equippable")) ?? Tag.End else return none
    if not e.contains("slot") {
        return none
    }
    let Tag.Str(named) = e["slot"] else return none
    let names = slot_names()
    for i in 0..names.len() {
        if names[i] == named {
            return some(i)
        }
    }
    return none
}

// The sound an equippable `e` plays as it's put on, `equipSound`, by its name without
// `minecraft:`, as Calcite plays sounds, `item.armor.equip_generic` where it names none (CAL-159).
fn equip_sound(e: JavaHashMap<String, Tag>) -> String {
    var named = String("minecraft:item.armor.equip_generic")
    if e.contains("equip_sound") {
        match e["equip_sound"] {
            Tag.Str(s) => named = s.copy(),
            Tag.Compound(m) => {
                if m.contains("sound_id") {
                    if let Tag.Str(s) = m["sound_id"] {
                        named = s.copy()
                    }
                }
            },
            _ => {},
        }
    }
    if named.starts_with("minecraft:") {
        return named[10..].copy()
    }
    return named
}

// `canReplaceEqualItem` (CAL-159): `stack` replaces `old` with more enchantments, or as many and
// less damage, `getDamageValue`, or as much and a custom name where `old` hasn't one.
fn replaces_equal<W: Wearing>(items: W, stack: Tag, old: Tag) -> bool {
    let more = items.worn_enchantments(stack.copy()).len()
    let had = items.worn_enchantments(old.copy()).len()
    if more != had {
        return more > had
    }
    let damage = damage_value(items, stack.copy())
    let was = damage_value(items, old.copy())
    if damage != was {
        return damage < was
    }
    return items.worn_component(stack, String("minecraft:custom_name")) != none and items.worn_component(old, String("minecraft:custom_name")) == none
}

// `getDamageValue`: its damage, kept within 0 and its most, `max_damage`, which is 0 where it
// hasn't one (CAL-159).
fn damage_value<W: Wearing>(items: W, stack: Tag) -> i32 {
    let most = int_component(items, stack.copy(), "minecraft:max_damage") ?? 0
    let damage = int_component(items, stack, "minecraft:damage") ?? 0
    return if damage < 0 { 0 } else if damage > most { most } else { damage }
}

// The component `name` of `stack` as a number, none where it hasn't it.
fn int_component<W: Wearing>(items: W, stack: Tag, name: str) -> i32? {
    let t = items.worn_component(stack, String(name)) else return none
    return t.number_int()
}

// `setDamageValue`: `stack` with its damage `damage`, none in its patch where that's its item's
// own, 0.
fn damaged_to(stack: own Tag, damage: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    var components = JavaHashMap<String, Tag>()
    if out.contains("components") {
        if let Tag.Compound(c) = out["components"] {
            components = c.copy()
        }
    }
    if damage == 0 {
        _ = components.remove(String("minecraft:damage"))
    } else {
        components.insert(String("minecraft:damage"), Tag.Int(damage))
    }
    if components.is_empty() {
        _ = out.remove(String("components"))
    } else {
        out.insert(String("components"), Tag.Compound(components))
    }
    return Tag.Compound(out)
}

// Whether `stack` is of the item `name` (D416).
fn stack_named(stack: Tag?, name: str) -> bool {
    let s = stack else return false
    let Tag.Compound(m) = s else return false
    return m.contains("id") and m["id"] == Tag.Str(String(name))
}

// Whether the block at x, y, z holds water, its fluid's tag `#water` (D434).
fn water_at<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let l = liquid_of(f, blocks.collision_state(x, y, z) ?? 0)
    return l.fluid == WATER_FLUID or l.fluid == FLOWING_WATER
}

// `Mob.rotlerp`: `a` turned toward `b` by `max` degrees at most, not kept within a turn (CAL-159).
fn mob_rotlerp(a: f32, b: f32, max: f32) -> f32 {
    var diff = wrap_degrees(b - a)
    if diff > max {
        diff = max
    }
    if diff < -max {
        diff = -max
    }
    return a + diff
}

// `BowItem.getPowerForTime`: a bow drawn `held` ticks, its power from 0 to 1 (CAL-159).
fn bow_power(held: i32) -> f32 {
    let t = f32.nearest(held) / 20.0f32
    let p = (t * t + t * 2.0f32) / 3.0f32
    return if p > 1.0f32 { 1.0f32 } else { p }
}

/// The item of the stack `stack`, empty for none.
pub fn held_name(stack: Tag?) -> String {
    let held = stack.copy() else return String()
    let Tag.Compound(m) = held else return String()
    if not m.contains("id") {
        return String()
    }
    let Tag.Str(id) = m["id"] else return String()
    return id.copy()
}

// Whether the item is in `#arrows`, what a bow shoots, `ARROW_ONLY`.
fn is_arrow_item(name: String) -> bool {
    return name == "minecraft:arrow" or name == "minecraft:tipped_arrow" or name == "minecraft:spectral_arrow"
}

// One of the stack `stack`, `copyWithCount(1)`.
fn one_of(stack: Tag?) -> Tag {
    let held = stack.copy() else return stack_of(String("minecraft:arrow"))
    let Tag.Compound(m) = held else return held.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(1))
    return Tag.Compound(out)
}

// `Mth.clamp` of a block difference to within 127 either way, as `clampedPackDifferenceInPosition`
// has it.
fn clamp_i(d: i32) -> i32 {
    return if d < -127 { -127 } else if d > 127 { 127 } else { d }
}

// How long an armadillo's state's animation runs, `animationDuration`: rolling 10 ticks, scared
// 50 and unrolling 30 (CAL-160).
fn animation_of(state: i32) -> i32 {
    if state == ARMADILLO_ROLLING {
        return 10
    }
    if state == ARMADILLO_SCARED {
        return 50
    }
    if state == ARMADILLO_UNROLLING {
        return 30
    }
    return 0
}

// An armadillo's state's name, `getSerializedName`, as it's saved.
fn armadillo_state_name(state: i32) -> str {
    if state == ARMADILLO_ROLLING {
        return "rolling"
    }
    if state == ARMADILLO_SCARED {
        return "scared"
    }
    if state == ARMADILLO_UNROLLING {
        return "unrolling"
    }
    return "idle"
}

// The armadillo's state of the name `name`, idle for one it doesn't know.
fn armadillo_state_named(name: String) -> i32 {
    for state in [ARMADILLO_ROLLING, ARMADILLO_SCARED, ARMADILLO_UNROLLING] {
        if name == String(armadillo_state_name(state)) {
            return state
        }
    }
    return ARMADILLO_IDLE
}

// `Vec3.directionFromRotation`: the way a pitch of `x_rot` and a turn of `y_rot` look, by the
// sine table, its parts floats.
fn direction_from_rotation(x_rot: f32, y_rot: f32) -> (f64, f64, f64) {
    let y_cos = table_cos(f64(-y_rot * 0.017453292f32 - 3.1415927f32))
    let y_sin = table_sin(f64(-y_rot * 0.017453292f32 - 3.1415927f32))
    let x_cos = -table_cos(f64(-x_rot * 0.017453292f32))
    let x_sin = table_sin(f64(-x_rot * 0.017453292f32))
    return (f64(y_sin * x_cos), f64(x_sin), f64(y_cos * x_cos))
}
