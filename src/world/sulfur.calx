/// A sulfur cube's archetypes, `SulfurCubeArchetype` (CAL-402): what the block it swallows makes
/// of it, by the archetypes whose items that block is among.

module world.sulfur

import world.attributes.{Modifier}

/// An archetype's modifier, `AttributeEntry`: the attribute, by its ID, and the modifier put on it.
pub struct ArchetypeModifier {
    pub attribute: u32
    pub modifier: Modifier
}

/// An archetype's explosion, `ExplosionData`: its power, whether it makes fire, and its fuse in
/// ticks.
pub struct ArchetypeExplosion {
    pub power: i32
    pub fire: bool
    pub fuse: i32
}

/// An archetype's hurt of what it touches, `ContactDamage`: the damage type, by name, its amount, a
/// constant or drawn evenly between `least` and `most`, and whether it's caused by the cube.
pub struct ContactDamage {
    pub damage_type: String
    pub least: f32
    pub most: f32
    pub uniform: bool = false
    pub to_source: bool = false
}

/// A sulfur cube archetype: the items it's of, as `minecraft:dirt`; its attribute modifiers;
/// whether it floats in liquids, `buoyant`; its explosion and its hurt of what it touches, if any;
/// its knockback's powers, `KnockbackModifiers`; and its sounds, `SoundSettings`: hit, push, and
/// the push's threshold and cooldown in seconds.
pub struct Archetype {
    pub name: String
    pub items: List<String> = List<String>()
    pub modifiers: List<ArchetypeModifier> = List<ArchetypeModifier>()
    pub buoyant: bool = false
    pub explosion: ArchetypeExplosion? = none
    pub contact: ContactDamage? = none
    pub horizontal: f32 = 0.33f32
    pub vertical: f32 = 0.06f32
    pub hit_sound: String = "entity.sulfur_cube.regular.hit"
    pub push_sound: String = "entity.sulfur_cube.regular.push"
    pub push_threshold: f32 = 0.2f32
    pub push_cooldown: f32 = 0.5f32
}

/// The archetypes whose items include `item`, as `matchingArchetypes`, in the registry's order.
pub fn matching(archetypes: List<Archetype>, item: String) -> List<usize> {
    var out = List<usize>()
    if item.is_empty() {
        return out
    }
    for i in 0..archetypes.len() {
        if archetypes[i].items.contains(item) {
            out.push(i)
        }
    }
    return out
}
