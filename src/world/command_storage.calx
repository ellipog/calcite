/// Command storage, vanilla's `CommandStorage` (CAL-165): compounds that `data` and functions
/// keep by an ID, each namespace's in saved data of its own,
/// `data/<namespace>/command_storage.dat`, as `{contents: {<path>: {...}}}`.
///
/// A namespace's file is read the first time anything in it is asked for, and only then; one
/// that has no file starts empty the first time something's put in it. A compound left empty is
/// taken away. A namespace that's changed is saved with the world, the compounds copied as
/// `CompoundTag.CODEC` copies them, each map made again. Only namespaces read or made so far are
/// known, so only their IDs are suggested, as in vanilla.
module world.command_storage

import nbt.tag.{Tag, copied_map}
import resources.identifier.{Identifier, valid_path}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The storage.
pub struct CommandStorage {
    // Each namespace read or made, as `namespaces` keeps them.
    namespaces: JavaHashMap<String, Container> = JavaHashMap<String, Container>()
    // The namespaces whose file has been looked for, found or not, as `SavedDataStorage`
    // keeps them in its cache, so none is read twice.
    looked: JavaHashSet<String> = JavaHashSet<String>()
}

// A namespace's compounds, `CommandStorage.Container`, by their paths, and whether they've
// changed since they were saved.
struct Container {
    storage: JavaHashMap<String, Tag>
    dirty: bool = false
}

/// The saved data's name for `namespace`'s storage, `<namespace>:command_storage`.
pub fn storage_id(namespace: String) -> Identifier {
    return Identifier { namespace: namespace.copy(), path: String("command_storage") }
}

impl CommandStorage {
    /// Whether `namespace`'s file has been looked for, so it's not to be read again.
    pub fn looked_for(self, namespace: String) -> bool {
        return self.looked.contains(namespace)
    }

    /// Takes what was read of `namespace`'s file, its root, or `none` if there's none, as
    /// `SavedDataStorage.get` reads it: its `contents` read as the container's codec reads them,
    /// each compound copied, and each entry it can't read left out, with vanilla's error logged.
    pub fn read(mut self, namespace: String, root: JavaHashMap<String, Tag>?, lines: mut List<Entry>) {
        self.looked.insert(namespace.copy())
        let found = root else return
        var errors = List<String>()
        var read = List<(String, Tag)>()
        var contents_found = false
        if found.contains("data") {
            match found["data"] {
                Tag.Compound(data) => {
                    if data.contains("contents") {
                        match data["contents"] {
                            Tag.Compound(contents) => {
                                contents_found = true
                                for (path, value) in contents {
                                    if not valid_path(path) {
                                        errors.push("Invalid string to use as a resource path element: {path}")
                                        continue
                                    }
                                    match value {
                                        Tag.Compound(m) => read.push((path.copy(), Tag.Compound(copied_map(m)))),
                                        _ => errors.push("Not a compound tag: {value.to_snbt()}"),
                                    }
                                }
                            },
                            _ => errors.push("Not a map: {data["contents"].to_snbt()}"),
                        }
                    } else {
                        errors.push("No key contents in MapLike[{Tag.Compound(data.copy()).to_snbt()}]")
                    }
                },
                _ => errors.push("Not a map: {found["data"].to_snbt()}"),
            }
        } else {
            errors.push("Not a map: END")
        }
        if not errors.is_empty() {
            var message = String()
            for e in errors {
                if not message.is_empty() {
                    message.push_str("; ")
                }
                message.push_str(e)
            }
            lines.push(parse_failed(storage_id(namespace), message))
            if not contents_found {
                return
            }
        }
        // `new HashMap<>(storage)`: room for them all first, then each in the order read.
        var storage = JavaHashMap<String, Tag>()
        storage.reserve(read.len())
        for (path, tag) in read {
            storage.insert(path.copy(), tag.copy())
        }
        self.namespaces.insert(namespace.copy(), Container { storage: storage })
    }

    /// `get`: the compound stored as `id`, or an empty one.
    pub fn get(self, id: Identifier) -> Tag {
        if self.holds(id) {
            return self.namespaces[id.namespace].storage[id.path].copy()
        }
        return Tag.Compound(JavaHashMap<String, Tag>())
    }

    /// Whether `id` is stored, so a change to what `get` gave is a change to the stored compound,
    /// as vanilla's `get` gives the stored one itself.
    pub fn holds(self, id: Identifier) -> bool {
        return self.namespaces.contains(id.namespace) and self.namespaces[id.namespace].storage.contains(id.path)
    }

    /// Puts back the stored compound `id` as it's been changed in place, as vanilla's changes
    /// to the compound `get` gave stay even where the command fails. Not marked as changed.
    pub fn changed_in_place(mut self, id: Identifier, contents: own Tag) {
        if self.holds(id) {
            var c = self.namespaces[id.namespace].copy()
            c.storage.insert(id.path.copy(), contents)
            self.namespaces.insert(id.namespace.copy(), c)
        }
    }

    /// `set`: `contents` stored as `id`, or, where it's empty, `id` taken away, with the
    /// namespace made if it wasn't, and marked to be saved.
    pub fn set(mut self, id: Identifier, contents: own Tag) {
        var c = if self.namespaces.contains(id.namespace) {
            self.namespaces[id.namespace].copy()
        } else {
            Container { storage: JavaHashMap<String, Tag>() }
        }
        let empty = match contents {
            Tag.Compound(m) => m.is_empty(),
            _ => false,
        }
        if empty {
            _ = c.storage.remove(id.path)
        } else {
            c.storage.insert(id.path.copy(), contents)
        }
        c.dirty = true
        self.namespaces.insert(id.namespace.copy(), c)
    }

    /// `keys`: the IDs stored, namespace by namespace, in their maps' order.
    pub fn keys(self) -> List<Identifier> {
        var out = List<Identifier>()
        for (namespace, c) in self.namespaces {
            for (path, _) in c.storage {
                out.push(Identifier { namespace: namespace.copy(), path: path.copy() })
            }
        }
        return out
    }

    /// The namespaces changed since they were saved, each as its saved data's name and `data`,
    /// `{contents: {...}}`, each compound copied as `CompoundTag.CODEC` writes it, and marks them
    /// saved.
    pub fn take_saves(mut self) -> List<(Identifier, Tag)> {
        var out = List<(Identifier, Tag)>()
        var names = List<String>()
        for (namespace, c) in self.namespaces {
            if c.dirty {
                names.push(namespace.copy())
            }
        }
        for namespace in names {
            var c = self.namespaces[namespace].copy()
            c.dirty = false
            var contents = JavaHashMap<String, Tag>()
            for (path, tag) in c.storage {
                contents.insert(path.copy(), tag.java_copy())
            }
            var data = JavaHashMap<String, Tag>()
            data.insert(String("contents"), Tag.Compound(contents))
            out.push((storage_id(namespace), Tag.Compound(data)))
            self.namespaces.insert(namespace.copy(), c)
        }
        return out
    }
}
