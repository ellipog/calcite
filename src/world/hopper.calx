/// A hopper moving items between block containers, `HopperBlockEntity.pushItemsTick` (CAL-277):
/// its cooldown counted down, and once it's run out, where it's enabled, one item pushed into the
/// container it faces, `ejectItems`, and one pulled from the container above, `suckInItems`, each
/// container's slots by the side it's reached from where it has sides, `WorldlyContainer`. Each
/// `setChanged` comes where vanilla's does, the container's chunk to save and the comparators by
/// it told with what it holds then. A hopper given an item while empty waits 8 ticks, or 7 where
/// the hopper giving it ticked no later this game tick, `tickedGameTime`, which isn't saved and
/// which `Hoppers` keeps.
///
/// The containers a hopper reaches are a chest's, a large chest's two halves even where it's
/// blocked, a barrel's, a dispenser's, a dropper's, a hopper's, a shulker box's, which takes no
/// shulker box, a furnace's, a blast furnace's or a smoker's, whose top takes what it cooks, its
/// sides its fuel, and whose bottom gives its result and a bucket from its fuel, and a brewing
/// stand's, whose top takes its reagent, its sides its bottles and fuel, and whose bottom gives its
/// bottles and an empty bottle from its reagent slot, and a composter's, `WorldlyContainerHolder`,
/// below 7 one slot its top takes something compostable through, composted as it's set, at 8 one
/// of bone meal its bottom gives, which empties it, and at 7 none; a decorated pot's one slot;
/// a chiseled bookshelf's six, a book each; a shelf's three; a crafter's nine, each but those
/// turned off taking more only where no later one's empty or holds less of it; and a jukebox's
/// record, its song played as it's set and stopped as it's taken. Loot still to come is made
/// as vanilla's first reads each part's slots. With no container above, a hopper's taking in
/// the item entities there waits for the level to reach its entities.
module world.hopper

import nbt.tag.{Tag}
import random.source.{RandomSource}
import world.block_entity_ticks.{play_song, stop_song}
import world.block_level.{BlockLevel, update_output_signal}
import world.block_use.{COMPOSTER_FILL, compost_layers, item_stack, set_book}
import world.brewing.{is_reagent}
import world.container_loot.{items_of}
import world.containers.{chest_parts, items_at}
import world.drops.{DropLevel}
import world.furnace.{input_set}
import world.level_writer.{UPDATE_LIMIT}
import world.loot.{Loot}
import world.menu.{count_of, same_components, with_count}
import world.pos.{BlockPos}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

// How a container takes and gives items: as any, `PLAIN`, or by its own rules.
const PLAIN: i32 = 0
const SHULKER: i32 = 1
const FURNACE: i32 = 2
const BREWING: i32 = 3
const HOPPER: i32 = 4
// A composter's, by its level: below 7, `InputContainer`; 8, `OutputContainer`; 7, `EmptyContainer`.
const COMPOSTER_IN: i32 = 5
const COMPOSTER_OUT: i32 = 6
const COMPOSTER_FULL: i32 = 7
// A decorated pot's, `ContainerSingleItem`: one slot, saved as `item`, which neither takes nor
// gives with a `setChanged`.
const POT: i32 = 8
// A chiseled bookshelf's: six slots of one book each, `updateState` as each is set or emptied.
const BOOKSHELF: i32 = 9
// A shelf's: three slots, whose `setChanged` sends its block entity again.
const SHELF: i32 = 10
// A crafter's: nine slots, those it has turned off taking nothing, and each filling evenly,
// `smallerStackExist`.
const CRAFTER: i32 = 11
// A jukebox's, `ContainerSingleItem`: one record, saved as `RecordItem`, its song played as it's
// set and stopped as it's taken.
const JUKEBOX: i32 = 12

// The sides an item moves through, by `Direction`'s IDs, and none, a hopper's pull into itself.
const NO_SIDE: i32 = -1
const DOWN: i32 = 0
const UP: i32 = 1

// A block entity whose slots are part of a container: where it is, how many, and whether its
// loot's still to come, `pending`, made as vanilla's first reads its slots.
struct Part {
    x: i32
    y: i32
    z: i32
    slots: usize
    pending: bool = false
}

// A container a hopper moves an item into or out of: its kind, its block entities, a large
// chest's two, its block's state, what its slots hold as they're changed, and, for a composter,
// which has no block entity, where it is and whether it's composted or emptied, `changed`.
struct Store {
    kind: i32
    parts: List<Part> = List<Part>()
    state: u32 = 0
    slots: List<Tag?> = List<Tag?>()
    x: i32 = 0
    y: i32 = 0
    z: i32 = 0
    changed: bool = false
    off: List<bool> = List<bool>()
}

/// What hoppers keep unsaved (CAL-277): the game time each last ticked, `tickedGameTime`, by its
/// place packed as `BlockPos.asLong`, none for 0, one that hasn't.
pub struct Hoppers {
    pub ticked: Map<i64, i64> = Map<i64, i64>()
}

/// `HopperBlockEntity.pushItemsTick` of the hopper `state` at x, y, z: its cooldown, saved as
/// `TransferCooldown`, counted down and the game time it ticked kept in `hoppers`; where the
/// cooldown's run out, `tryMoveItems`: where it's `enabled`, an item pushed where it holds any and
/// one pulled where it isn't full, and where either moved, it waits 8 ticks and its `setChanged`.
pub fn hopper_tick<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, hoppers: mut Hoppers) ! Thrown {
    let tags = tags_at(level, x, y, z)
    let had = int_at(tags, "TransferCooldown") ?? -1
    let cooldown = had - 1
    hoppers.ticked.insert(BlockPos { x: x, y: y, z: z }.pack(), level.time_now())
    if cooldown > 0 {
        level.keep_block_entity_value(x, y, z, "TransferCooldown", Tag.Int(cooldown))
        return
    }
    if had != 0 {
        level.keep_block_entity_value(x, y, z, "TransferCooldown", Tag.Int(0))
    }
    if not f.get_bool(state, "enabled") {
        return
    }
    // `isEmpty`'s `unpackLootTable(null)`: its loot to come made first.
    if tags.contains("LootTable") {
        try level.unpack_container_loot(f, x, y, z)
    }
    var me =Store { kind: HOPPER, parts: [Part { x: x, y: y, z: z, slots: 5 }], state: state, slots: items_at(level, x, y, z, 5) }
    var changed = false
    if not is_empty(me) {
        changed = try eject(f, mut level, mut me, hoppers)
    }
    let full = match level.world_loot() {
        some(shared) => hopper_full(me, shared.value),
        none => false,
    }
    if not full {
        if try suck(f, mut level, mut me, hoppers) {
            changed = true
        }
    }
    if changed {
        level.keep_block_entity_value(x, y, z, "TransferCooldown", Tag.Int(8))
        try touch(f, mut level, x, y, z)
    }
}

// `ejectItems`: into the container the hopper faces, where it has one and isn't full from the
// side it's reached from, `isFullContainer`, one of the first of the hopper's stacks that goes in.
fn eject<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, me: mut Store, hoppers: Hoppers) -> bool ! Thrown {
    let (x, y, z) = (me.parts[0].x, me.parts[0].y, me.parts[0].z)
    let facing = f.get_name(me.state, "facing") ?? String("down")
    let (dx, dy, dz) = if facing == "north" { (0, 0, -1) } else if facing == "south" { (0, 0, 1) } else if facing == "west" { (-1, 0, 0) } else if facing == "east" { (1, 0, 0) } else { (0, -1, 0) }
    var target = try store_at(f, level, x + dx, y + dy, z + dz) else return false
    let shared = level.world_loot() else return false
    // The side it's reached from, the way the hopper faces turned round.
    let side = if facing == "north" { 3 } else if facing == "south" { 2 } else if facing == "west" { 5 } else if facing == "east" { 4 } else { UP }
    if try full_opening(f, mut level, mut target, side, shared.value) {
        return false
    }
    for slot in 0usize..5 {
        let stack = me.slots[slot].copy() else continue
        let had = count_of(some(stack.copy()))
        // `removeItem(slot, 1)`, which a hopper's own doesn't `setChanged`.
        me.slots[slot] = with_count(stack, had - 1)
        try save(f, mut level, me)
        if try add_item(f, mut level, true, me.parts[0], mut target, stack, side, shared.value, hoppers) {
            try touch_store(f, mut level, mut target)
            return true
        }
        // Put back, `setCount`, and where it was the last, `setItem`, neither `setChanged`.
        me.slots[slot] = some(stack.copy())
        try save(f, mut level, me)
    }
    return false
}

// `suckInItems`: from the container above, each of its slots it gives from below in turn, one of
// the first stack it may give that goes in, `tryTakeInItemFromSlot`. With none above, the item
// entities there, which wait.
fn suck<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, me: mut Store, hoppers: Hoppers) -> bool ! Thrown {
    let (x, y, z) = (me.parts[0].x, me.parts[0].y, me.parts[0].z)
    var source = try store_at(f, level, x, y + 1, z) else return false
    let shared = level.world_loot() else return false
    for slot in slots_for(source, DOWN) {
        // `getItem(slot)`, its part's loot made first.
        try open_slot(f, mut level, mut source, slot)
        let stack = source.slots[slot].copy() else continue
        if not can_take(source, slot, stack, me, shared.value) {
            continue
        }
        let had = count_of(some(stack.copy()))
        // `removeItem(slot, 1)`, which `setChanged`s but for a hopper's and a decorated pot's; a
        // chiseled bookshelf's `updateState` instead.
        source.slots[slot] = with_count(stack, had - 1)
        try save(f, mut level, source)
        if source.kind == BOOKSHELF {
            let p = source.parts[0]
            try set_book(f, mut level, source.state, p.x, p.y, p.z, i32.wrap(slot), none)
        } else if source.kind == JUKEBOX {
            try jukebox_set(f, mut level, source, none)
        } else if source.kind != HOPPER and source.kind != POT {
            try touch_slot(f, mut level, mut source, slot)
        }
        // Where it came from, for a hopper's cooldown; a composter's own place.
        let from = if source.parts.is_empty() { Part { x: source.x, y: source.y, z: source.z, slots: 1 } } else { source.parts[part_of(source, slot)] }
        if try add_item(f, mut level, source.kind == HOPPER, from, mut me, stack, NO_SIDE, shared.value, hoppers) {
            try touch_store(f, mut level, mut source)
            return true
        }
        // Put back, `setCount`, and where it was the last, `setItem`.
        source.slots[slot] = some(stack.copy())
        try save(f, mut level, source)
        if had == 1 {
            try set_item_changed(f, mut level, mut source, slot, none, some(stack.copy()))
        }
    }
    return false
}

// `addItem(from, into, stack, side)` of one of `stack`, `add_stack`'s. Whether it went in.
fn add_item<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, from_hopper: bool, from: Part, into: mut Store, stack: Tag, side: i32, loot: Loot, hoppers: Hoppers) -> bool ! Thrown {
    let one = with_count(stack, 1) ?? stack.copy()
    return try add_stack(f, mut level, from_hopper, from, mut into, one, side, loot, hoppers) == none
}

// `addItem(from, into, stack, side)`: `stack` put into the slots of `into` it takes from `side`
// where it has sides and there's a side, else all of them in order, until none's left,
// `tryMoveInItem`: where it may go in a slot, all of it into it where it's empty, `setItem`, or as
// much as there's room for onto its stack where it's the same item with the same components. Each
// time some goes in a hopper that was empty and isn't waiting longer than 8 ticks, that hopper
// waits 8, or 7 where `from` is a hopper, `from_hopper`, that ticked no later; then `into`'s
// `setChanged`. What's left of `stack`, none where it all went in.
fn add_stack<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, from_hopper: bool, from: Part, into: mut Store, stack: Tag, side: i32, loot: Loot, hoppers: Hoppers) -> Tag? ! Thrown {
    var left: Tag? = some(stack.copy())
    let slots = if side == NO_SIDE or not worldly(into) { all_slots(into) } else { slots_for(into, side) }
    for slot in slots {
        let given = left.copy() else break
        // `getItem(slot)`, then `isEmpty`, each making loot to come as they read.
        try open_slot(f, mut level, mut into, slot)
        if not can_place(into, slot, given, loot) or (side != NO_SIDE and not can_place_through(into, slot, given, loot)) {
            continue
        }
        let was_empty = try empty_opening(f, mut level, mut into)
        let here = into.slots[slot].copy()
        var moved = false
        if let there = here.copy() {
            if count_of(here) <= loot.items.max_stack_size(there) and same_components(here, left) {
                let room = loot.items.max_stack_size(given) - count_of(here)
                let n = min(count_of(left), room)
                if n > 0 {
                    into.slots[slot] = with_count(there, count_of(here) + n)
                    left = with_count(given, count_of(left) - n)
                    try save(f, mut level, into)
                    moved = true
                }
            }
        } else {
            into.slots[slot] = some(given.copy())
            left = none
            try save(f, mut level, into)
            try set_item_changed(f, mut level, mut into, slot, none, some(given.copy()))
            moved = true
        }
        if moved {
            if was_empty and into.kind == HOPPER {
                let p = into.parts[0]
                if (int_at(tags_at(level, p.x, p.y, p.z), "TransferCooldown") ?? 0) <= 8 {
                    var skip = 0
                    if from_hopper {
                        let mine = hoppers.ticked.get(BlockPos { x: p.x, y: p.y, z: p.z }.pack()) ?? 0
                        let theirs = hoppers.ticked.get(BlockPos { x: from.x, y: from.y, z: from.z }.pack()) ?? 0
                        if mine >= theirs {
                            skip = 1
                        }
                    }
                    level.keep_block_entity_value(p.x, p.y, p.z, "TransferCooldown", Tag.Int(8 - skip))
                }
            }
            try touch_store(f, mut level, mut into)
        }
    }
    return left
}

// The container at x, y, z a hopper reaches, `getContainerAt`'s block's: a large chest's halves,
// even where it's blocked, `ChestBlock.getContainer(.., true)`; those it doesn't reach yet said;
// none for any other block, or where it isn't loaded.
fn store_at<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> Store? ! Thrown {
    return try store_of(f, level, x, y, z, true)
}

// `store_at`, a chest with its other half where `halves`, else its own slots only.
fn store_of<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32, halves: bool) -> Store? ! Thrown {
    if not level.is_loaded(x, y, z) {
        return none
    }
    let state = try level.state(f, x, y, z)
    let block = f.block(state)
    if f.class_name(block) == "ComposterBlock" {
        // `ComposterBlock.getContainer`, made again each time it's reached.
        let fill = f.get_int(state, "level") ?? 0
        if fill == 8 {
            return some(Store { kind: COMPOSTER_OUT, state: state, slots: [some(item_stack(String("minecraft:bone_meal")))], x: x, y: y, z: z })
        }
        if fill < 7 {
            return some(Store { kind: COMPOSTER_IN, state: state, slots: [none], x: x, y: y, z: z })
        }
        return some(Store { kind: COMPOSTER_FULL, state: state, x: x, y: y, z: z })
    }
    let kind = f.block_entity_kind(block) else return none
    var store = Store { kind: PLAIN, state: state }
    if kind == "minecraft:chest" or kind == "minecraft:trapped_chest" {
        let alone: List<(i32, i32, i32)> = [(x, y, z)]
        let parts = if halves { try chest_parts(f, level, state, x, y, z, true) ?? alone } else { alone }
        for (px, py, pz) in parts {
            store.parts.push(Part { x: px, y: py, z: pz, slots: 27 })
        }
    } else if kind == "minecraft:barrel" {
        store.parts.push(Part { x: x, y: y, z: z, slots: 27 })
    } else if kind == "minecraft:dispenser" or kind == "minecraft:dropper" {
        store.parts.push(Part { x: x, y: y, z: z, slots: 9 })
    } else if kind == "minecraft:hopper" {
        store.kind = HOPPER
        store.parts.push(Part { x: x, y: y, z: z, slots: 5 })
    } else if kind == "minecraft:shulker_box" {
        store.kind = SHULKER
        store.parts.push(Part { x: x, y: y, z: z, slots: 27 })
    } else if kind == "minecraft:furnace" or kind == "minecraft:blast_furnace" or kind == "minecraft:smoker" {
        store.kind = FURNACE
        store.parts.push(Part { x: x, y: y, z: z, slots: 3 })
    } else if kind == "minecraft:brewing_stand" {
        store.kind = BREWING
        store.parts.push(Part { x: x, y: y, z: z, slots: 5 })
    } else if kind == "minecraft:shelf" {
        store.kind = SHELF
        store.parts.push(Part { x: x, y: y, z: z, slots: 3 })
    } else if kind == "minecraft:chiseled_bookshelf" {
        store.kind = BOOKSHELF
        store.parts.push(Part { x: x, y: y, z: z, slots: 6 })
    } else if kind == "minecraft:decorated_pot" {
        store.kind = POT
        store.parts.push(Part { x: x, y: y, z: z, slots: 1 })
    } else if kind == "minecraft:crafter" {
        store.kind = CRAFTER
        store.parts.push(Part { x: x, y: y, z: z, slots: 9 })
        store.off = disabled_slots(tags_at(level, x, y, z))
    } else if kind == "minecraft:jukebox" {
        store.kind = JUKEBOX
        store.parts.push(Part { x: x, y: y, z: z, slots: 1 })
    } else {
        return none
    }
    for i in 0..store.parts.len() {
        let p = store.parts[i]
        if tags_at(level, p.x, p.y, p.z).contains("LootTable") {
            store.parts[i].pending = true
        }
        if store.kind == POT {
            store.slots.push(pot_item(level, p.x, p.y, p.z))
            continue
        }
        if store.kind == JUKEBOX {
            let tags = tags_at(level, p.x, p.y, p.z)
            store.slots.push(if tags.contains("RecordItem") { some(tags["RecordItem"].copy()) } else { none })
            continue
        }
        for s in items_at(level, p.x, p.y, p.z, p.slots) {
            store.slots.push(s.copy())
        }
    }
    return some(store)
}

// A decorated pot's one stack, `item`, none where it's empty.
fn pot_item<L: BlockAccess>(level: L, x: i32, y: i32, z: i32) -> Tag? {
    let tags = tags_at(level, x, y, z)
    return if tags.contains("item") { some(tags["item"].copy()) } else { none }
}

// `unpackLootTable(null)` of the part of `s` that holds its slot `slot`, as vanilla's `getItem`
// makes it, where its loot's still to come.
fn open_slot<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store, slot: usize) ! Thrown {
    if s.parts.is_empty() {
        return
    }
    let i = part_of(s, slot)
    try open_part(f, mut level, mut s, i)
}

// The loot still to come of the part `i` of `s` made for no one, `unpack_container_loot`, and
// what it holds read again.
fn open_part<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store, i: usize) ! Thrown {
    if not s.parts[i].pending {
        return
    }
    s.parts[i].pending = false
    let p = s.parts[i]
    try level.unpack_container_loot(f, p.x, p.y, p.z)
    var at: usize = 0
    for k in 0..i {
        at += s.parts[k].slots
    }
    if s.kind == POT {
        s.slots[at] = pot_item(level, p.x, p.y, p.z)
        return
    }
    let fresh = items_at(level, p.x, p.y, p.z, p.slots)
    for k in 0..p.slots {
        s.slots[at + k] = fresh[k].copy()
    }
}

// `isEmpty` as vanilla's reads it: each part's loot to come made first, and a large chest's
// second half read only where the first holds nothing, `CompoundContainer.isEmpty`.
fn empty_opening<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store) -> bool ! Thrown {
    if s.parts.is_empty() {
        return is_empty(s)
    }
    var at: usize = 0
    for i in 0..s.parts.len() {
        try open_part(f, mut level, mut s, i)
        for k in 0..s.parts[i].slots {
            if s.slots[at + k] != none {
                return false
            }
        }
        at += s.parts[i].slots
    }
    return true
}

// `isFullContainer` as vanilla's reads it: each slot of `s` reached from `side` read in turn, its
// part's loot to come made first, until one isn't full.
fn full_opening<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store, side: i32, loot: Loot) -> bool ! Thrown {
    for slot in slots_for(s, side) {
        try open_slot(f, mut level, mut s, slot)
        let stack = s.slots[slot].copy() else return false
        if count_of(some(stack.copy())) < loot.items.max_stack_size(stack) {
            return false
        }
    }
    return true
}

// A crafter's slots it has turned off, `disabled_slots`, by slot.
fn disabled_slots(tags: JavaHashMap<String, Tag>) -> List<bool> {
    var off = List<bool>()
    for _ in 0..9 {
        off.push(false)
    }
    if tags.contains("disabled_slots") {
        if let Tag.IntArray(slots) = tags["disabled_slots"] {
            for s in slots {
                if s >= 0 and s < 9 {
                    off[usize.wrap(s)] = true
                }
            }
        }
    }
    return off
}

// The slots of `s` an item moves through `side` by, `getSlots`: a furnace's or a brewing stand's
// by side, any other's all of them.
fn slots_for(s: Store, side: i32) -> List<usize> {
    if s.kind == FURNACE {
        if side == DOWN {
            return [2, 1]
        }
        return if side == UP { [0] } else { [1] }
    }
    if s.kind == BREWING {
        if side == UP {
            return [3]
        }
        return if side == DOWN { [0, 1, 2, 3] } else { [0, 1, 2, 4] }
    }
    if s.kind == COMPOSTER_IN {
        return if side == UP { [0] } else { List<usize>() }
    }
    if s.kind == COMPOSTER_OUT {
        return if side == DOWN { [0] } else { List<usize>() }
    }
    return all_slots(s)
}

// Whether `s` has sides, `WorldlyContainer`.
fn worldly(s: Store) -> bool {
    return s.kind == SHULKER or s.kind == FURNACE or s.kind == BREWING or s.kind == COMPOSTER_IN or s.kind == COMPOSTER_OUT or s.kind == COMPOSTER_FULL
}

// `getMaxStackSize()` of `s`: a composter's, a chiseled bookshelf's and a jukebox's 1, any other's
// 99.
fn most_of(s: Store) -> i32 {
    return if s.kind == COMPOSTER_IN or s.kind == COMPOSTER_OUT or s.kind == BOOKSHELF or s.kind == JUKEBOX { 1 } else { 99 }
}

fn all_slots(s: Store) -> List<usize> {
    var out = List<usize>()
    for i in 0..s.slots.len() {
        out.push(i)
    }
    return out
}

// `isFullContainer`: whether each of the slots of `s` reached from `side` holds as many as its
// item stacks to; an empty one doesn't.
fn is_full(s: Store, side: i32, loot: Loot) -> bool {
    for slot in slots_for(s, side) {
        let stack = s.slots[slot].copy() else return false
        if count_of(some(stack.copy())) < loot.items.max_stack_size(stack) {
            return false
        }
    }
    return true
}

// `inventoryFull`: whether each of a hopper's slots holds as many as its item stacks to.
fn hopper_full(s: Store, loot: Loot) -> bool {
    return is_full(s, NO_SIDE, loot)
}

// `Container.isEmpty`.
fn is_empty(s: Store) -> bool {
    for stack in s.slots {
        if stack != none {
            return false
        }
    }
    return true
}

// `canPlaceItem`: a furnace's result nothing, its fuel slot fuel or a bucket where it holds no
// bucket; a brewing stand's fuel slot its fuel, its reagent slot a reagent, each bottle's place a
// potion where it's empty; anything anywhere else.
fn can_place(s: Store, slot: usize, stack: Tag, loot: Loot) -> bool {
    let item = item_of(some(stack.copy()))
    if s.kind == JUKEBOX {
        return s.slots[slot] == none and loot.items.component(stack, String("minecraft:jukebox_playable")) != none
    }
    if s.kind == CRAFTER {
        if s.off[slot] {
            return false
        }
        let here = s.slots[slot].copy() else return true
        let n = count_of(some(here.copy()))
        if n >= loot.items.max_stack_size(here) {
            return false
        }
        // `smallerStackExist`: a later slot that's on and empty, or holds less of the same.
        for i in (slot + 1)..9 {
            if s.off[i] {
                continue
            }
            let there = s.slots[i].copy() else return false
            if count_of(some(there.copy())) < n and same_components(some(there.copy()), some(here.copy())) {
                return false
            }
        }
        return true
    }
    if s.kind == BOOKSHELF {
        let id = loot.items.builtin_id("item", item) else return false
        return s.slots[slot] == none and loot.items.holder_set_has("item", Tag.Str(String("#minecraft:bookshelf_books")), id)
    }
    if s.kind == FURNACE {
        if slot == 2 {
            return false
        }
        if slot == 0 {
            return true
        }
        return loot.items.component(stack, String("minecraft:cooking_fuel")) != none or (item == "minecraft:bucket" and item_of(s.slots[1].copy()) != "minecraft:bucket")
    }
    if s.kind == BREWING {
        if slot == 4 {
            return loot.items.component(stack, String("minecraft:brewing_fuel")) != none
        }
        if slot == 3 {
            return is_reagent(loot, some(stack.copy()))
        }
        return potion_input(loot, stack) and s.slots[slot] == none
    }
    return true
}

// `canPlaceItemThroughFace`: a shulker box's anything but a shulker box, a furnace's and a
// brewing stand's as they place it.
fn can_place_through(s: Store, slot: usize, stack: Tag, loot: Loot) -> bool {
    if s.kind == SHULKER {
        let item = item_of(some(stack.copy()))
        return item != "minecraft:shulker_box" and not item.ends_with("_shulker_box")
    }
    if s.kind == FURNACE or s.kind == BREWING {
        return can_place(s, slot, stack, loot)
    }
    if s.kind == COMPOSTER_IN {
        return not s.changed and loot.items.component(stack, String("minecraft:compostable")) != none
    }
    if s.kind == COMPOSTER_OUT or s.kind == COMPOSTER_FULL {
        return false
    }
    return true
}

// `canTakeItemThroughFace` from below: a furnace's fuel slot only what's
// `#furnace_fuel_bottom_takeable`, a brewing stand's reagent slot only a glass bottle.
fn can_take(s: Store, slot: usize, stack: Tag, into: Store, loot: Loot) -> bool {
    if s.kind == JUKEBOX {
        // `canTakeItem`: where `into` has an empty slot.
        for there in into.slots {
            if there == none {
                return true
            }
        }
        return false
    }
    if s.kind == BOOKSHELF {
        // `canTakeItem`: where `into` has an empty slot, or one of the same with room for it.
        for there in into.slots {
            let held = there.copy() else return true
            if same_components(some(held.copy()), some(stack.copy())) and count_of(some(held.copy())) + count_of(some(stack.copy())) <= min(most_of(into), loot.items.max_stack_size(held)) {
                return true
            }
        }
        return false
    }
    if s.kind == FURNACE and slot == 1 {
        let id = loot.items.builtin_id("item", item_of(some(stack.copy()))) else return false
        return loot.items.holder_set_has("item", Tag.Str(String("#minecraft:furnace_fuel_bottom_takeable")), id)
    }
    if s.kind == BREWING and slot == 3 {
        return item_of(some(stack.copy())) == "minecraft:glass_bottle"
    }
    if s.kind == COMPOSTER_OUT {
        return not s.changed and item_of(some(stack.copy())) == "minecraft:bone_meal"
    }
    return s.kind != COMPOSTER_IN
}

// `PotionIngredient.isPotionInput`: of the items a brewing recipe takes as its input, or
// `#brewing_potion_inputs`.
fn potion_input(loot: Loot, stack: Tag) -> bool {
    let item = item_of(some(stack.copy()))
    for r in loot.brewing {
        if r.input.items.contains(item) {
            return true
        }
    }
    let id = loot.items.builtin_id("item", item) else return false
    return loot.items.holder_set_has("item", Tag.Str(String("#minecraft:brewing_potion_inputs")), id)
}

// Which of the parts of `s` holds its slot `slot`.
fn part_of(s: Store, slot: usize) -> usize {
    var at: usize = 0
    for i in 0..s.parts.len() {
        if slot < at + s.parts[i].slots {
            return i
        }
        at += s.parts[i].slots
    }
    return 0
}

// `setItem`'s `setChanged` of the slot `slot` of `s`, from `old` to `stack`: a hopper's and a decorated pot's none; a
// furnace's only for its input, where it isn't the same item with the same components, its
// cooking starting again; a composter's its own; any other's always.
fn set_item_changed<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store, slot: usize, old: Tag?, stack: Tag?) ! Thrown {
    if s.kind == HOPPER or s.kind == POT {
        return
    }
    if s.kind == JUKEBOX {
        try jukebox_set(f, mut level, s, stack)
        return
    }
    if s.kind == BOOKSHELF {
        let p = s.parts[0]
        try set_book(f, mut level, s.state, p.x, p.y, p.z, i32.wrap(slot), stack)
        return
    }
    if s.kind == FURNACE {
        if slot != 0 or (stack != none and same_components(old, stack)) {
            return
        }
        let p = s.parts[0]
        input_set(f, mut level, s.state, p.x, p.y, p.z, old, stack)
    }
    try touch_slot(f, mut level, mut s, slot)
}

// A jukebox's `setTheItem` of `record`, kept as `RecordItem` already: the jukebox set with or
// without a record with flags 2, `notifyItemChangedInJukebox`; then, given a record whose song the
// world has, that song played from its start, else the song it plays, if any, stopped.
fn jukebox_set<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: Store, record: Tag?) ! Thrown {
    let p = s.parts[0]
    let state = try level.state(f, p.x, p.y, p.z)
    let now = try f.with_bool(state, "has_record", record != none)
    _ = level.set_block_limited(p.x, p.y, p.z, now, 2, UPDATE_LIMIT)
    if let given = record {
        if let song = level.jukebox_song(given.copy()) {
            try play_song(f, mut level, f.block(now), song, p.x, p.y, p.z)
            return
        }
    }
    if tags_at(level, p.x, p.y, p.z).contains("ticks_since_song_started") {
        try stop_song(f, mut level, now, p.x, p.y, p.z)
    }
}

// What `s` holds kept as each of its block entities saves it, `Items`, each stack with its
// `Slot`; a shulker box's none where it holds nothing, a decorated pot's as `item`, none where
// it's empty; none of a part whose loot's still to come.
fn save<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, s: Store) ! Thrown {
    if s.kind == BOOKSHELF {
        return
    }
    var at: usize = 0
    for p in s.parts {
        // One whose loot's still to come keeps its `LootTable`, not `Items`, `trySaveLootTable`.
        if p.pending {
            at += p.slots
            continue
        }
        var slots = List<Tag?>()
        var any = false
        for i in 0..p.slots {
            slots.push(s.slots[at + i].copy())
            if s.slots[at + i] != none {
                any = true
            }
        }
        at += p.slots
        if s.kind == POT {
            match slots[0].copy() {
                some(stack) => level.keep_block_entity_value(p.x, p.y, p.z, "item", stack),
                none => level.remove_block_entity_value(p.x, p.y, p.z, "item"),
            }
            continue
        }
        if s.kind == JUKEBOX {
            match slots[0].copy() {
                some(stack) => level.set_block_entity_value(p.x, p.y, p.z, "RecordItem", stack),
                none => level.remove_block_entity_value(p.x, p.y, p.z, "RecordItem"),
            }
            continue
        }
        if s.kind == SHULKER and not any {
            level.remove_block_entity_value(p.x, p.y, p.z, "Items")
        } else {
            level.keep_block_entity_value(p.x, p.y, p.z, "Items", items_of(slots))
        }
    }
    _ = f
}

// `Container.setChanged` of `s`: each of its block entities', a large chest's halves in turn,
// `CompoundContainer.setChanged`; a composter's its own, `composter_changed`; a shelf's sends
// its block entity again, `sendBlockUpdated`.
fn touch_store<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store) ! Thrown {
    if s.parts.is_empty() {
        try composter_changed(f, mut level, mut s)
        return
    }
    for p in s.parts {
        try touch(f, mut level, p.x, p.y, p.z)
        if s.kind == SHELF {
            level.send_block_updated(p.x, p.y, p.z)
        }
    }
}

// The `setChanged` of the block entity of `s` that holds its slot `slot`; a composter's its own.
fn touch_slot<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store, slot: usize) ! Thrown {
    if s.parts.is_empty() {
        try composter_changed(f, mut level, mut s)
        return
    }
    let p = s.parts[part_of(s, slot)]
    try touch(f, mut level, p.x, p.y, p.z)
    if s.kind == SHELF {
        level.send_block_updated(p.x, p.y, p.z)
    }
}

// A composter's `setChanged`: below 7, where it holds something compostable, that composted,
// `addLayer`, its layers from the level's random, the composter set with flags 3 and ticked 20 on
// where that fills it to 7, its event saying whether it rose, and its slot emptied; at 8 emptied,
// level 0 set with flags 3. Either way it takes and gives no more, `changed`.
fn composter_changed<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, s: mut Store) ! Thrown {
    if s.kind == COMPOSTER_OUT {
        _ = level.set_block_limited(s.x, s.y, s.z, try f.with_int(s.state, "level", 0), 3, UPDATE_LIMIT)
        s.changed = true
        return
    }
    if s.kind != COMPOSTER_IN {
        return
    }
    let contents = s.slots[0].copy() else return
    let shared = level.world_loot() else return
    let compost = shared.value.items.component(contents, String("minecraft:compostable")) else return
    s.changed = true
    let fill = f.get_int(s.state, "level") ?? 0
    let layers = try compost_layers(compost, fill, mut level)
    var now = s.state
    if layers > 0 {
        let filled = min(fill + layers, 7)
        now = try f.with_int(s.state, "level", filled)
        _ = level.set_block_limited(s.x, s.y, s.z, now, 3, UPDATE_LIMIT)
        if filled == 7 {
            level.schedule_block(f.block(s.state), s.x, s.y, s.z, 20, 0)
        }
    }
    level.level_event(COMPOSTER_FILL, s.x, s.y, s.z, if now != s.state { 1 } else { 0 })
    s.slots[0] = none
}

// `BlockEntity.setChanged(level, pos, state)` of the block entity at x, y, z: its chunk to save,
// and where its block isn't air, the comparators by it told, `updateNeighbourForOutputSignal`.
fn touch<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    level.touch_block_entity(x, y, z)
    let state = try level.state(f, x, y, z)
    if not f.is_air(state) {
        try update_output_signal(f, mut level, f.block(state), x, y, z)
    }
}

fn tags_at<L: BlockAccess>(level: L, x: i32, y: i32, z: i32) -> JavaHashMap<String, Tag> {
    return match level.block_entity_tag(x, y, z) {
        some(Tag.Compound(m)) => m.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

fn int_at(tags: JavaHashMap<String, Tag>, key: str) -> i32? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Int(n) => some(n),
        _ => none,
    }
}

fn item_of(stack: Tag?) -> String {
    let s = stack else return String("minecraft:air")
    let Tag.Compound(m) = s else return String("minecraft:air")
    if not m.contains("id") {
        return String("minecraft:air")
    }
    return match m["id"] {
        Tag.Str(i) => i.copy(),
        _ => String("minecraft:air"),
    }
}

/// `CrafterBlock.dispenseItem`'s part with a container in front (CAL-277): `stack`, made by the
/// crafter at cx, cy, cz, put in the container at x, y, z through its side `side`, where there's
/// one, `HopperBlockEntity.addItem`; into a crafter, or a stack of more than the container takes
/// to a slot, one by one until one doesn't go in, any other whole, again while it goes in. Whether there's a
/// container there, and what's left of `stack`, none where it all went in.
pub fn crafter_puts<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, side: i32, cx: i32, cy: i32, cz: i32, stack: Tag) -> (bool, Tag?) ! Thrown {
    var into = try store_at(f, level, x, y, z) else return (false, some(stack.copy()))
    let shared = level.world_loot() else return (true, some(stack.copy()))
    let from = Part { x: cx, y: cy, z: cz, slots: 9 }
    let none_ticked = Hoppers()
    var left: Tag? = some(stack.copy())
    let most = min(most_of(into), shared.value.items.max_stack_size(stack))
    if into.kind == CRAFTER or count_of(some(stack.copy())) > most {
        loop {
            let rest = left.copy() else break
            let one = with_count(rest, 1) ?? rest.copy()
            if try add_stack(f, mut level, false, from, mut into, one, side, shared.value, none_ticked) != none {
                break
            }
            left = with_count(rest, count_of(left.copy()) - 1)
        }
    } else {
        loop {
            let rest = left.copy() else break
            let had = count_of(left.copy())
            left = try add_stack(f, mut level, false, from, mut into, rest, side, shared.value, none_ticked)
            if count_of(left.copy()) == had {
                break
            }
        }
    }
    return (true, left)
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

/// What the block entity at x, y, z holds where it's a container, as `item` and `execute if
/// items` reach one, `BlockItemAccessor.getContainer` (CAL-165): its own slots, a large chest's
/// half's, with its loot still to come made first, as `getItem` makes it; none where it isn't
/// loaded or there's no block entity that's a container there, as a composter has none.
pub fn container_slots<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32) -> List<Tag?>? ! Thrown {
    var s = try own_store(f, level, x, y, z) else return none
    for i in 0..s.parts.len() {
        try open_part(f, mut level, mut s, i)
    }
    return some(s.slots.copy())
}

/// `setItem(slot, stack)` of the container at x, y, z, as `item` sets one (CAL-165): its loot
/// still to come made first, the stack set and cut to as many as it takes, `limitSize`, then
/// saved and its `setChanged`, as its kind has it. Whether there's a container with the slot.
pub fn set_container_slot<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, slot: usize, stack: Tag?, loot: Loot) -> bool ! Thrown {
    var s = try own_store(f, level, x, y, z) else return false
    if slot >= s.slots.len() {
        return false
    }
    try open_slot(f, mut level, mut s, slot)
    var put = stack.copy()
    if let st = stack.copy() {
        let most = min(most_of(s), loot.items.max_stack_size(st))
        if count_of(stack.copy()) > most {
            put = with_count(st, most)
        }
    }
    let old = s.slots[slot].copy()
    s.slots[slot] = put.copy()
    try save(f, mut level, s)
    try set_item_changed(f, mut level, mut s, slot, old, put)
    return true
}

/// `LootCommand.distributeToContainer` of `stack` into the container at x, y, z (CAL-165): each
/// slot in turn, what's there found, `getItem`, while some of the stack is left; where the slot
/// may take it, `canPlaceItem`, an empty one takes what's left, as `setItem` takes it, and it
/// ends, and one that holds the same item with the same components, no more than it stacks to,
/// takes what it has room for, which counts where that's none. The container's changed,
/// `setChanged`, where any slot took it. Whether one did.
pub fn distribute_to_container<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, stack: Tag, loot: Loot) -> bool ! Thrown {
    var s = try own_store(f, level, x, y, z) else return false
    let most = loot.items.max_stack_size(stack.copy())
    var left = count_of(some(stack.copy()))
    var changed = false
    var slot = 0usize
    while slot < s.slots.len() and left > 0 {
        try open_slot(f, mut level, mut s, slot)
        let here = s.slots[slot].copy()
        let rest = with_count(stack.copy(), left) ?? stack.copy()
        if can_place(s, slot, rest.copy(), loot) {
            match here {
                none => {
                    var put = rest.copy()
                    let fits = min(most_of(s), most)
                    if left > fits {
                        put = with_count(rest, fits) ?? put
                    }
                    s.slots[slot] = some(put.copy())
                    try save(f, mut level, s)
                    try set_item_changed(f, mut level, mut s, slot, none, some(put))
                    changed = true
                    break
                },
                some(there) => {
                    let n = count_of(some(there.copy()))
                    if n <= loot.items.max_stack_size(there.copy()) and same_components(some(there.copy()), some(rest)) {
                        let moved = min(left, most - n)
                        left -= moved
                        s.slots[slot] = with_count(there.copy(), n + moved) ?? some(there)
                        try save(f, mut level, s)
                        changed = true
                    }
                },
            }
        }
        slot += 1
    }
    if changed and not s.parts.is_empty() {
        let p = s.parts[0]
        try touch(f, mut level, p.x, p.y, p.z)
    }
    return changed
}

/// `LootCommand.blockReplace`'s slot `slot` of the container at x, y, z given `stack` (CAL-165):
/// where it may take it, `canPlaceItem`, set as `setItem` sets it, 1; else 0. Past its end, -1,
/// where vanilla's `setItem` or `canPlaceItem` throws, which is but where a furnace refuses it.
pub fn replace_container_slot<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, slot: usize, stack: Tag?, loot: Loot) -> i32 ! Thrown {
    let s = try own_store(f, level, x, y, z) else return 0
    let given = stack.copy() ?? item_stack(String("minecraft:air"))
    if slot >= s.slots.len() {
        return if s.kind == FURNACE and not can_place(s, slot, given, loot) { 0 } else { -1 }
    }
    if not can_place(s, slot, given, loot) {
        return 0
    }
    return if try set_container_slot(f, mut level, x, y, z, slot, stack, loot) { 1 } else { 0 }
}

// The block entity at x, y, z that's a container, as it is alone, a chest without its other half.
fn own_store<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> Store? ! Thrown {
    let s = try store_of(f, level, x, y, z, false) else return none
    if s.kind == COMPOSTER_IN or s.kind == COMPOSTER_OUT or s.kind == COMPOSTER_FULL {
        return none
    }
    return some(s)
}
