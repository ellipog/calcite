/// What making a farm animal reads of the registries (CAL-156): its type's variants, as
/// `cow_variant`, `pig_variant` and `chicken_variant` have them, each with the selectors it spawns
/// by, its `spawn_conditions`; its sound variants, `cow_sound_variant` and its kin, each with its
/// sounds grown and a baby's; and the biomes `#spawns_warm_variant_farm_animals` and
/// `#spawns_cold_variant_farm_animals` hold, which pick a sheep's colors.
///
/// A variant to spawn is picked as `VariantUtils.selectVariantToSpawn` picks it: of the selectors
/// of every variant, in its registry's order, sorted highest priority first, those whose
/// conditions hold where it spawns at the highest priority any does, one drawn from the level's
/// random, `Util.getRandomSafe`, a draw even of one. A sound variant is any of its registry,
/// drawn the same way, `getRandom`.
module world.variants

/// A selector a variant spawns by, `PriorityProvider.Selector`: its priority, and the biomes its
/// condition holds in, by their IDs, none where it has no condition and holds anywhere. One of a
/// kind Calcite doesn't read, a structure's or the moon's, holds nowhere.
pub struct Selector {
    pub priority: i32
    pub biomes: List<bool>? = none
}

/// A registry of variants: each entry's name, by its ID, its selectors, and the default's ID,
/// `getDefaultOrAny`.
pub struct Variants {
    pub names: List<String>
    pub selectors: List<List<Selector>>
    pub default: i32
}

impl Variants {
    /// `PriorityProvider.select` in the biome `biome`: the variants whose selectors hold there at
    /// the highest priority any does, by their IDs, once for each selector, in the order the sort,
    /// which keeps entries of the same priority in their order, leaves them.
    pub fn spawnable(self, biome: i32) -> List<i32> {
        var unpacked = List<(i32, i32, bool)>()
        for id in 0..self.selectors.len() {
            for s in self.selectors[id] {
                let holds = match s.biomes {
                    some(set) => biome >= 0 and usize.wrap(biome) < set.len() and set[usize.wrap(biome)],
                    none => true,
                }
                unpacked.push((i32.wrap(id), s.priority, holds))
            }
        }
        var order = List<(i32, usize)>()
        for i in 0..unpacked.len() {
            let (_, priority, _) = unpacked[i]
            order.push((-priority, i))
        }
        order.sort()
        var out = List<i32>()
        var highest = i32.MIN
        for (_, i) in order {
            let (id, priority, holds) = unpacked[i]
            if priority < highest {
                continue
            }
            if holds {
                highest = priority
                out.push(id)
            }
        }
        return out
    }

    /// The ID of the variant named `name`, if there's one.
    pub fn id_of(self, name: String) -> i32? {
        for i in 0..self.names.len() {
            if self.names[i] == name {
                return some(i32.wrap(i))
            }
        }
        return none
    }

    /// The name of the variant `id`, the default's where there's none.
    pub fn name_of(self, id: i32) -> String {
        if id >= 0 and usize.wrap(id) < self.names.len() {
            return self.names[usize.wrap(id)].copy()
        }
        return self.names[usize.wrap(self.default)].copy()
    }
}

/// The sounds a sound variant plays, grown or as a baby: its ambient sound and its steps'.
pub struct SoundSet {
    pub ambient: String
    pub step: String
    /// Its hurt and death sounds (D416).
    pub hurt: String
    pub death: String
}

/// A sound variant: its sounds grown, and as a baby, which for a cow's are the same.
pub struct SoundVariant {
    pub adult: SoundSet
    pub baby: SoundSet
}

/// A registry of sound variants: each entry's name and sounds, by its ID, and the default's ID,
/// the classic one.
pub struct Sounds {
    pub names: List<String>
    pub variants: List<SoundVariant>
    pub default: i32
}

impl Sounds {
    /// The ID of the sound variant named `name`, if there's one.
    pub fn id_of(self, name: String) -> i32? {
        for i in 0..self.names.len() {
            if self.names[i] == name {
                return some(i32.wrap(i))
            }
        }
        return none
    }

    /// The sounds of the variant `id`, as a baby if `baby`.
    pub fn set_of(self, id: i32, baby: bool) -> SoundSet {
        let at = if id >= 0 and usize.wrap(id) < self.variants.len() { usize.wrap(id) } else { usize.wrap(self.default) }
        return if baby { self.variants[at].baby.copy() } else { self.variants[at].adult.copy() }
    }
}

/// What the farm animals Calcite makes read: the cow's, pig's and chicken's variants and sound
/// variants, and each biome's place in the warm and cold farm animal tags, by its ID.
pub struct MobFacts {
    pub cow: Variants
    pub pig: Variants
    pub chicken: Variants
    pub cow_sounds: Sounds
    pub pig_sounds: Sounds
    pub chicken_sounds: Sounds
    pub warm: List<bool>
    pub cold: List<bool>
    /// The villager type each biome gives a villager made in it, by its ID, `VillagerType.byBiome`
    /// (CAL-156).
    pub villager_types: List<i32>
}

impl MobFacts {
    /// Vanilla's, for `biomes` biomes, those of IDs `warm` and `cold` in the tags: each farm
    /// animal's cold, temperate and warm variants, the temperate one at priority 0 anywhere and the
    /// others at 1 in their tag's biomes; and its sound variants with vanilla's sounds.
    pub fn vanilla(biomes: usize, warm: List<i32>, cold: List<i32>) -> MobFacts {
        var warm_set = List<bool>()
        var cold_set = List<bool>()
        for i in 0..biomes {
            warm_set.push(warm.contains(i32.wrap(i)))
            cold_set.push(cold.contains(i32.wrap(i)))
        }
        let farm = Variants {
            names: [String("minecraft:cold"), String("minecraft:temperate"), String("minecraft:warm")],
            selectors: [[Selector { priority: 1, biomes: some(cold_set.copy()) }], [Selector { priority: 0 }], [Selector { priority: 1, biomes: some(warm_set.copy()) }]],
            default: 1,
        }
        let cow = Sounds {
            names: [String("minecraft:classic"), String("minecraft:moody")],
            variants: [same_sounds("entity.cow.ambient", "entity.cow.step"), same_sounds("entity.cow_moody.ambient", "entity.cow_moody.step")],
            default: 0,
        }
        let pig = Sounds {
            names: [String("minecraft:big"), String("minecraft:classic"), String("minecraft:mini")],
            variants: [
                sounds("entity.pig_big.ambient", "entity.pig.step", "entity.baby_pig.ambient", "entity.baby_pig.step"),
                sounds("entity.pig.ambient", "entity.pig.step", "entity.baby_pig.ambient", "entity.baby_pig.step"),
                sounds("entity.pig_mini.ambient", "entity.pig.step", "entity.baby_pig.ambient", "entity.baby_pig.step"),
            ],
            default: 1,
        }
        let chicken = Sounds {
            names: [String("minecraft:classic"), String("minecraft:picky")],
            variants: [
                sounds("entity.chicken.ambient", "entity.chicken.step", "entity.baby_chicken.ambient", "entity.baby_chicken.step"),
                sounds("entity.chicken_picky.ambient", "entity.chicken.step", "entity.baby_chicken.ambient", "entity.baby_chicken.step"),
            ],
            default: 0,
        }
        var plains = List<i32>()
        for _ in 0..biomes {
            plains.push(PLAINS_VILLAGERS)
        }
        return MobFacts { cow: farm.copy(), pig: farm.copy(), chicken: farm, cow_sounds: cow, pig_sounds: pig, chicken_sounds: chicken, warm: warm_set, cold: cold_set, villager_types: plains }
    }

    /// The climate the biome `biome` gives a sheep's colors: 1 warm, 2 cold, 0 temperate, in that
    /// order, as `getSheepColorConfiguration` looks.
    pub fn climate(self, biome: i32) -> i32 {
        if biome < 0 {
            return 0
        }
        let b = usize.wrap(biome)
        if b < self.warm.len() and self.warm[b] {
            return 1
        }
        if b < self.cold.len() and self.cold[b] {
            return 2
        }
        return 0
    }
}

impl MobFacts {
    /// The villager type the biome `biome` gives, plains for one it doesn't know.
    pub fn villager_type(self, biome: i32) -> i32 {
        if biome < 0 or usize.wrap(biome) >= self.villager_types.len() {
            return PLAINS_VILLAGERS
        }
        return self.villager_types[usize.wrap(biome)]
    }
}

/// The plains villager type's ID in `VILLAGER_TYPE`, the default.
pub const PLAINS_VILLAGERS: i32 = 2

/// The villager type of the biome named `biome`, `VillagerType.byBiome`, by its ID in
/// `VILLAGER_TYPE`'s order: 0 desert, 1 jungle, 2 plains, 3 savanna, 4 snow, 5 swamp and 6 taiga;
/// plains for any biome but those its map holds.
pub fn villager_type_of(biome: String) -> i32 {
    for (name, kind) in [("badlands", 0), ("desert", 0), ("eroded_badlands", 0), ("wooded_badlands", 0), ("bamboo_jungle", 1), ("jungle", 1), ("sparse_jungle", 1), ("savanna_plateau", 3), ("savanna", 3), ("windswept_savanna", 3), ("deep_frozen_ocean", 4), ("frozen_ocean", 4), ("frozen_river", 4), ("ice_spikes", 4), ("snowy_beach", 4), ("snowy_taiga", 4), ("snowy_plains", 4), ("grove", 4), ("snowy_slopes", 4), ("frozen_peaks", 4), ("jagged_peaks", 4), ("swamp", 5), ("mangrove_swamp", 5), ("old_growth_spruce_taiga", 6), ("old_growth_pine_taiga", 6), ("windswept_gravelly_hills", 6), ("windswept_hills", 6), ("taiga", 6), ("windswept_forest", 6)] {
        if biome == "minecraft:{name}" {
            return kind
        }
    }
    return PLAINS_VILLAGERS
}

fn same_sounds(ambient: str, step: str) -> SoundVariant {
    return sounds(ambient, step, ambient, step)
}

fn sounds(ambient: str, step: str, baby_ambient: str, baby_step: str) -> SoundVariant {
    return SoundVariant { adult: voiced(ambient, step), baby: voiced(baby_ambient, baby_step) }
}

// A sound set whose hurt and death sounds are named as its ambient sound is, as all of vanilla's
// built-in ones are, `entity.pig_big.ambient`'s `entity.pig_big.hurt` and `entity.pig_big.death`
// (D416).
fn voiced(ambient: str, step: str) -> SoundSet {
    let a = String(ambient)
    let stem = if a.ends_with(".ambient") { a[..a.len() - 8] } else { a.copy() }
    return SoundSet { ambient: a, step: String(step), hurt: "{stem}.hurt", death: "{stem}.death" }
}
