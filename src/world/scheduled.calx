/// The functions `schedule` has waiting, vanilla's `TimerQueue` (D569): events, each a function
/// or a function tag to run at a game time, kept in the order of their times and then of when
/// they were scheduled, and each by its name and time, as vanilla's `HashBasedTable` keeps them,
/// so one name has one event at a time. The Overworld's tick runs those due as it moves the game
/// time on. Saved in `data/minecraft/scheduled_events.dat`, as `{events: [{trigger_time, id,
/// callback: {type, id}}]}`, oldest first.
///
/// As in vanilla, an event run is taken off its name's times at the game time it runs, not at its
/// own, so one loaded with a time already past stays among them: `schedule clear` still counts it,
/// and its name's suggested.
module world.scheduled

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data's name, `minecraft:scheduled_events`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: String("minecraft"), path: String("scheduled_events") }
}

/// What an event runs: a function, `FunctionCallback`, or a tag's functions,
/// `FunctionTagCallback`.
pub enum Scheduled {
    Function(Identifier)
    Tag(Identifier)
}

// An event, `TimerQueue.Event`: when it's due, the order it was scheduled in, its name and what
// it runs.
struct Event {
    time: i64
    order: u64
    name: String
    run: Scheduled
}

/// The events.
pub struct ScheduledEvents {
    // In the order they're due: by time, then by when they were scheduled.
    queue: List<Event> = List<Event>()
    // Each name's times, `events`, its rows in a `HashMap`'s order.
    names: JavaHashMap<String, List<i64>> = JavaHashMap<String, List<i64>>()
    // How many have been scheduled, `sequentialId`.
    scheduled: u64 = 0
    /// Whether they've changed since they were read or saved, `setDirty`.
    pub dirty: bool = false
}

impl ScheduledEvents {
    /// None, as a world without the file, or with one that can't be read, starts:
    /// `computeIfAbsent` makes them, marked to be saved (D575).
    pub fn fresh() -> ScheduledEvents {
        return ScheduledEvents { dirty: true }
    }

    /// The events of a saved file's root, each scheduled again in the order saved, as the
    /// codec's `TimerQueue` constructor schedules them; what can't be read is logged, and none is
    /// kept, `fresh` ones made in its place.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> ScheduledEvents {
        var out = ScheduledEvents()
        let problem = match read_events(root) {
            ok(events) => {
                for (time, name, run) in events {
                    out.schedule(name, time, run)
                }
                out.dirty = false
                return out
            },
            err(p) => p,
        }
        lines.push(parse_failed(saved_id(), problem))
        return ScheduledEvents.fresh()
    }

    /// `schedule`: `run` as `name` at `time`, unless `name` has an event at that time already.
    pub fn schedule(mut self, name: String, time: i64, run: Scheduled) {
        if self.names.contains(name) {
            for t in self.names[name] {
                if t == time {
                    return
                }
            }
        }
        self.scheduled += 1
        let e = Event { time: time, order: self.scheduled, name: name.copy(), run: run.copy() }
        var at = self.queue.len()
        while at > 0 and later(self.queue[at - 1], e) {
            at -= 1
        }
        self.queue.insert(at, e)
        _ = self.names.compute_if_absent(name.copy(), List<i64>())
        var times = self.names[name].copy()
        times.push(time)
        self.names.insert(name.copy(), times)
        self.dirty = true
    }

    /// `remove`: every event of `name` taken off, giving how many its name had, which counts one
    /// that ran at a time past its own.
    pub fn remove(mut self, name: String) -> i32 {
        self.dirty = true
        if not self.names.contains(name) {
            return 0
        }
        let times = self.names[name].copy()
        _ = self.names.remove(name)
        var kept = List<Event>()
        for e in self.queue {
            if not (e.name == name and times.contains(e.time)) {
                kept.push(e.copy())
            }
        }
        self.queue = kept
        return i32.wrap(times.len())
    }

    /// The next event due by `now`, taken off, as `tick` takes each: off its name's times at `now`,
    /// not at its own. None where none is due.
    pub fn next_due(mut self, now: i64) -> Scheduled? {
        if self.queue.is_empty() or self.queue[0].time > now {
            return none
        }
        let e = self.queue.remove(0)
        if self.names.contains(e.name) {
            var times = self.names[e.name].copy()
            var i: usize = 0
            while i < times.len() {
                if times[i] == now {
                    _ = times.remove(i)
                    break
                }
                i += 1
            }
            if times.is_empty() {
                _ = self.names.remove(e.name)
            } else {
                self.names.insert(e.name.copy(), times)
            }
        }
        self.dirty = true
        return some(e.run)
    }

    /// The names with events, `getEventsIds`, which `schedule clear` suggests.
    pub fn ids(self) -> List<String> {
        var out = List<String>()
        for (name, _) in self.names {
            out.push(name.copy())
        }
        return out
    }

    /// The events as saved, `{events: [...]}`, in the order they're due, and marks them saved.
    pub fn pack(mut self) -> Tag {
        self.dirty = false
        var events = List<Tag>()
        for e in self.queue {
            var callback = JavaHashMap<String, Tag>()
            let (kind, id) = match e.run {
                Scheduled.Function(f) => ("minecraft:function", f.to_string()),
                Scheduled.Tag(t) => ("minecraft:function_tag", t.to_string()),
            }
            callback.insert(String("id"), Tag.Str(id))
            callback.insert(String("type"), Tag.Str(String(kind)))
            var event = JavaHashMap<String, Tag>()
            event.insert(String("trigger_time"), Tag.Long(e.time))
            event.insert(String("id"), Tag.Str(e.name.copy()))
            event.insert(String("callback"), Tag.Compound(callback))
            events.push(Tag.Compound(event))
        }
        var data = JavaHashMap<String, Tag>()
        data.insert(String("events"), Tag.List(events))
        return Tag.Compound(data)
    }
}

// Whether `a` is due after `b`, `createComparator`'s order.
fn later(a: Event, b: Event) -> bool {
    return a.time > b.time or (a.time == b.time and a.order > b.order)
}

// The saved events, each its time, name and what it runs, or why they can't be read.
fn read_events(root: JavaHashMap<String, Tag>) -> List<(i64, String, Scheduled)> ! String {
    if not root.contains("data") {
        fail String("Not a map: null")
    }
    let Tag.Compound(data) = root["data"] else fail "Not a map: {root["data"].to_snbt()}"
    if not data.contains("events") {
        fail "No key events in MapLike[{Tag.Compound(data.copy()).to_snbt()}]"
    }
    let Tag.List(events) = data["events"] else fail "Not a list: {data["events"].to_snbt()}"
    var out = List<(i64, String, Scheduled)>()
    for e in events {
        let Tag.Compound(m) = e else fail "Not a map: {e.to_snbt()}"
        if not m.contains("trigger_time") {
            fail "No key trigger_time in MapLike[{e.to_snbt()}]"
        }
        let time = m["trigger_time"].number_long() else fail "Not a number: {m["trigger_time"].to_snbt()}"
        if not m.contains("id") {
            fail "No key id in MapLike[{e.to_snbt()}]"
        }
        let Tag.Str(name) = m["id"] else fail "Not a string: {m["id"].to_snbt()}"
        if not m.contains("callback") {
            fail "No key callback in MapLike[{e.to_snbt()}]"
        }
        let Tag.Compound(callback) = m["callback"] else fail "Not a map: {m["callback"].to_snbt()}"
        if not callback.contains("type") {
            fail "No key type in MapLike[{m["callback"].to_snbt()}]"
        }
        let Tag.Str(kind_text) = callback["type"] else fail "Not a string: {callback["type"].to_snbt()}"
        let kind = match Identifier.parse(kind_text.copy()) {
            ok(k) => k.to_string(),
            err(why) => fail why,
        }
        if not callback.contains("id") {
            fail "No key id in MapLike[{m["callback"].to_snbt()}]"
        }
        let Tag.Str(id_text) = callback["id"] else fail "Not a string: {callback["id"].to_snbt()}"
        let id = match Identifier.parse(id_text.copy()) {
            ok(i) => i,
            err(why) => fail why,
        }
        let run = if kind == "minecraft:function" {
            Scheduled.Function(id)
        } else if kind == "minecraft:function_tag" {
            Scheduled.Tag(id)
        } else {
            fail "Unknown key: {kind}"
        }
        out.push((time, name.copy(), run))
    }
    return out
}
