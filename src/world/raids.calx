/// A level's raids, vanilla's `Raids`, in its dimension's `data/minecraft/raids.dat` (CAL-170).
/// Each level has them from its start, as `ServerLevel`'s constructor asks `computeIfAbsent` for
/// them, so a new world saves them at its first save. Calcite runs no raid yet: those a world
/// saved are kept as they were, and only the tick vanilla counts goes on, as `Raids.tick` counts
/// it each tick the level runs, marking them to be saved every 200.
module world.raids

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data type they're saved as, `Raids.TYPE`.
pub fn raids_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "raids" }
}

/// A level's raids: those saved, as their list, the next raid's ID and the ticks counted,
/// its `tick`.
pub struct Raids {
    raids: Tag? = none
    pub next_id: i32 = 1
    pub ticks: i32 = 0
    /// Whether they've changed since they were saved, as `setDirty` marks them.
    pub dirty: bool = false
}

impl Raids {
    /// None, as `computeIfAbsent` makes them where there's no file, or one that can't be read:
    /// `Raids()` marks them to be saved.
    pub fn fresh() -> Raids {
        return Raids { dirty: true }
    }

    /// The raids of a saved file's root, as the codec reads them: the list kept as it is, and
    /// `next_id` and `tick`, which it needs. Where it can't read them, what it says is logged and
    /// they start `fresh`.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Raids {
        if not root.contains("data") {
            lines.push(parse_failed(raids_id(), String("Not a map: null")))
            return Raids.fresh()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(raids_id(), "Not a map: {root["data"].to_snbt()}"))
                return Raids.fresh()
            },
        }
        var out = Raids()
        for key in ["next_id", "tick"] {
            if not data.contains(key) {
                lines.push(parse_failed(raids_id(), "No key {key} in MapLike[{Tag.Compound(data.copy()).to_snbt()}]"))
                return Raids.fresh()
            }
            let n = data[key].number_int() else {
                lines.push(parse_failed(raids_id(), "Not a number: {data[key].to_snbt()}"))
                return Raids.fresh()
            }
            if key == "next_id" {
                out.next_id = n
            } else {
                out.ticks = n
            }
        }
        if data.contains("raids") {
            match data["raids"] {
                Tag.List(l) => {
                    if not l.is_empty() {
                        out.raids = some(Tag.List(l.copy()))
                    }
                },
                _ => {},
            }
        }
        return out
    }

    /// `Raids.tick` of what Calcite has: the count goes on, an `int`'s, and every 200 they're
    /// marked to be saved.
    pub fn tick(mut self) {
        self.ticks = self.ticks.wrapping_add(1)
        if self.ticks % 200 == 0 {
            self.dirty = true
        }
    }

    /// Their `data`, as the codec writes it: the list only where there are raids, as
    /// `optionalFieldOf` leaves out its default, then `next_id` and `tick`.
    pub fn pack(self) -> Tag {
        var fields = JavaHashMap<String, Tag>()
        if let r = self.raids {
            fields.insert(String("raids"), r.copy())
        }
        fields.insert(String("next_id"), Tag.Int(self.next_id))
        fields.insert(String("tick"), Tag.Int(self.ticks))
        return Tag.Compound(fields)
    }
}
