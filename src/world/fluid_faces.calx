        "-$$.%%.%%-$$-$$.%%.%%M//M//N00N00-$$-$$.%%.%%-$$-$$.%%.%%#ZZ7733??88[[9944AA::^^66==>>@@]]55;;<<",
        "BB__==77@@??``;;99BBAAXX336688>>YY4455::<<WW&&##FhhFhh!ii!iifKKfKKgLLgLLfKKfKKgLLgLLdIIdIIeJJeJJ",
        "G++G++H,,H,,G++G++H,,H,,dIIdIIeJJeJJG++G++H,,H,,G++G++H,,H,,jQQjQQkRRkRRO11O11P22P22O11O11P22P22",
        "M//M//N00N00-$$-$$.%%.%%-$$-$$.%%.%%M//M//N00N00-$$-$$.%%.%%-$$-$$.%%.%%jQQjQQkRRkRRO11O11P22P22",
        "O11O11P22P22M//M//N00N00-$$-$$.%%.%%-$$-$$.%%.%%M//M//N00N00-$$-$$.%%.%%-$$-$$.%%.%%##########uu",
        "#########!#zLzLzLzLzLzLzLzLzLzLzLzLzLzLzLzL#####################################################",
        "#######################################FF#llllllllllllllllllllllllllllllllllllllllllllllllllllll",
        "lllllllllllllllllllllllllll!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
        "!!!!!!!!!!!!!!!!uu!",
    ]
    let alphabet = "!#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz|~"
    var digit: List<u32> = []
    for _ in 0..128 {
        digit.push(0)
    }
    for i in 0..alphabet.len() {
        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)
    }
    var states: List<u16> = []
    states.reserve(35723)
    for line in lines {
        var i: usize = 0
        while i < line.len() {
            let d = digit[usize(line.byte_at(i))]
            if d >= 87 {
                states.push(u16.wrap(87 + (d - 87) * 90 + digit[usize(line.byte_at(i + 1))]))
                i += 2
            } else {
                states.push(u16.wrap(d))
                i += 1
            }
        }
    }
    return (palette, states)
}

