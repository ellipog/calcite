/// Mob effects as vanilla keeps them (CAL-163). What each effect is, as `MobEffects` registers it,
/// by its ID in the `mob_effect` registry, the order it's registered in: its name, its category,
/// its colour, the particle it shows with, the attribute modifier it puts on, the sound it makes
/// as it's added, and how it acts as it ticks. And an effect on a living entity,
/// `MobEffectInstance`: its duration and amplifier, whether it's ambient and shows its particles
/// and its icon, and the effects of its kind it hides, `hiddenEffect`, which come back as it runs
/// out; merged with another of its kind as `update` merges them, counted down as `tickServer`
/// counts it, and read and saved as `MobEffectInstance.CODEC` has it.
module world.effects

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import world.attributes.{attribute_id}
import world.body.{bool_or, int_or}

/// The effects Calcite acts on, by their IDs.
pub const SPEED: i32 = 0
pub const SLOWNESS: i32 = 1
pub const HASTE: i32 = 2
pub const MINING_FATIGUE: i32 = 3
pub const JUMP_BOOST: i32 = 7
pub const HUNGER: i32 = 16
pub const SLOW_FALLING: i32 = 27
pub const DOLPHINS_GRACE: i32 = 29
pub const BAD_OMEN: i32 = 30
pub const STRENGTH: i32 = 4
pub const RESISTANCE: i32 = 10
pub const FIRE_RESISTANCE: i32 = 11
pub const LEVITATION: i32 = 24
pub const WIND_CHARGED: i32 = 35
pub const WEAVING: i32 = 36
pub const INSTANT_HEALTH: i32 = 5
pub const INSTANT_DAMAGE: i32 = 6
pub const REGENERATION: i32 = 9
pub const WATER_BREATHING: i32 = 12
pub const INVISIBILITY: i32 = 13
pub const WEAKNESS: i32 = 17
pub const POISON: i32 = 18
pub const WITHER: i32 = 19
pub const ABSORPTION: i32 = 21
pub const GLOWING: i32 = 23
pub const CONDUIT_POWER: i32 = 28
pub const INFESTED: i32 = 38
pub const OOZING: i32 = 37
pub const BREATH_OF_THE_NAUTILUS: i32 = 39

/// The hurt an effect's act gives back for its entity's kind to deal: none, 1 of `magic` or of
/// `wither`.
pub const NO_HURT: i32 = 0
pub const MAGIC_HURT: i32 = 1
pub const WITHER_HURT: i32 = 2

/// An effect's category, `MobEffectCategory`.
pub const BENEFICIAL: i32 = 0
pub const HARMFUL: i32 = 1
pub const NEUTRAL: i32 = 2

/// How an effect acts as it ticks, `applyEffectTick`, and on which ticks,
/// `shouldApplyEffectTickThisTick`: never, `MobEffect`'s; regeneration's heal of 1 under its
/// most, every 50 ticks halved for each level; poison's hurt of 1 of `magic` while it has more than
/// 1, every 25; wither's of 1 of `wither`, every 40; instant health's heal and instant damage's
/// hurt, on each tick it lasts, `InstantaneousMobEffect`'s; absorption's, every tick, ending it
/// once its absorption's gone; hunger's and bad omen's, every tick, and saturation's, on each tick
/// it lasts, which do nothing to a mob; and the raid omen's, as it ends, which does nothing to one.
pub const NEVER: i32 = 0
pub const HEALS: i32 = 1
pub const POISONS: i32 = 2
pub const WITHERS: i32 = 3
pub const HEALS_NOW: i32 = 4
pub const HARMS_NOW: i32 = 5
pub const ABSORBS: i32 = 6
pub const PLAYERS: i32 = 7
pub const PLAYERS_NOW: i32 = 8
pub const PLAYERS_AT_END: i32 = 9

/// A potion's colour where it shows none of its effects, `PotionContents.BASE_POTION_COLOR`.
pub const BASE_POTION_COLOR: i32 = -13083194

/// What an effect is, `MobEffect`: its name without `minecraft:`, its category and colour; the
/// particle it shows with by its ID in the `particle_type` registry, and whether that's
/// `entity_effect` in its colour, as most are, or a particle of its own, the trial and raid
/// omens'; its attribute modifier, if it has one, as the attribute's ID, the modifier's ID's
/// path, its amount for the first level and its operation; the sound it makes as it's added, the
/// omens'; and how it ticks, of those above.
pub struct EffectFacts {
    pub name: String
    pub category: i32
    pub color: i32
    pub particle: i32
    pub colored: bool
    pub modifier: (u32, String, f64, i32)?
    pub sound: String? = none
    pub ticks: i32 = NEVER
}

impl EffectFacts {
    /// `shouldApplyEffectTickThisTick` with `tick_count`, its duration left, or the entity's tick
    /// count where it lasts for ever, and its amplifier.
    pub fn should_tick(self, tick_count: i32, amplifier: i32) -> bool {
        if self.ticks == HEALS {
            return every(tick_count, 50, amplifier)
        }
        if self.ticks == POISONS {
            return every(tick_count, 25, amplifier)
        }
        if self.ticks == WITHERS {
            return every(tick_count, 40, amplifier)
        }
        if self.ticks == HEALS_NOW or self.ticks == HARMS_NOW or self.ticks == PLAYERS_NOW {
            return tick_count >= 1
        }
        if self.ticks == ABSORBS or self.ticks == PLAYERS {
            return true
        }
        if self.ticks == PLAYERS_AT_END {
            return tick_count == 1
        }
        return false
    }

    /// `isInstantaneous`: instant health's, instant damage's and saturation's,
    /// `InstantaneousMobEffect` (D519).
    pub fn instantaneous(self) -> bool {
        return self.ticks == HEALS_NOW or self.ticks == HARMS_NOW or self.ticks == PLAYERS_NOW
    }

    /// `createParticleOptions`: its particle's ID and, for `entity_effect`, its colour with an
    /// alpha of 38 where it's ambient, `AMBIENT_ALPHA`, else 255.
    pub fn particle_of(self, ambient: bool) -> (i32, i32?) {
        if not self.colored {
            return (self.particle, none)
        }
        let alpha = if ambient { 38 } else { 255 }
        return (self.particle, some((alpha << 24) | (self.color & 16777215)))
    }
}

// Whether a tick `tick_count` is one of every `base` halved `amplifier` times, each tick where
// that's none: `base >> amplifier`, its shift by Java's, the amplifier's low five bits.
fn every(tick_count: i32, base: i32, amplifier: i32) -> bool {
    let interval = base >> (amplifier & 31)
    if interval > 0 {
        return tick_count % interval == 0
    }
    return true
}

/// The effects, in their IDs' order, as `MobEffects` registers them, with the particle types'
/// IDs from the `particle_type` registry.
pub fn effect_facts() -> List<EffectFacts> {
    let particles = builtin_entries(9)
    let effect = place_of(particles, String("entity_effect"))
    let trial = place_of(particles, String("trial_omen"))
    let raid = place_of(particles, String("raid_omen"))
    let speed = attribute("movement_speed")
    let attack_speed = attribute("attack_speed")
    let damage = attribute("attack_damage")
    return [
        plain("speed", BENEFICIAL, 3402751, effect, some((speed, String("effect.speed"), f64(0.2f32), 2))),
        plain("slowness", HARMFUL, 9154528, effect, some((speed, String("effect.slowness"), f64(-0.15f32), 2))),
        plain("haste", BENEFICIAL, 14270531, effect, some((attack_speed, String("effect.haste"), f64(0.1f32), 2))),
        plain("mining_fatigue", HARMFUL, 4866583, effect, some((attack_speed, String("effect.mining_fatigue"), f64(-0.1f32), 2))),
        plain("strength", BENEFICIAL, 16762624, effect, some((damage, String("effect.strength"), 3.0, 0))),
        ticking("instant_health", BENEFICIAL, 16262179, effect, HEALS_NOW),
        ticking("instant_damage", HARMFUL, 11101546, effect, HARMS_NOW),
        plain("jump_boost", BENEFICIAL, 16646020, effect, some((attribute("safe_fall_distance"), String("effect.jump_boost"), 1.0, 0))),
        plain("nausea", HARMFUL, 5578058, effect, none),
        ticking("regeneration", BENEFICIAL, 13458603, effect, HEALS),
        plain("resistance", BENEFICIAL, 9520880, effect, none),
        plain("fire_resistance", BENEFICIAL, 16750848, effect, none),
        plain("water_breathing", BENEFICIAL, 10017472, effect, none),
        plain("invisibility", BENEFICIAL, 16185078, effect, some((attribute("waypoint_transmit_range"), String("effect.waypoint_transmit_range_hide"), -1.0, 2))),
        plain("blindness", HARMFUL, 2039587, effect, none),
        plain("night_vision", BENEFICIAL, 12779366, effect, none),
        ticking("hunger", HARMFUL, 5797459, effect, PLAYERS),
        plain("weakness", HARMFUL, 4738376, effect, some((damage, String("effect.weakness"), -4.0, 0))),
        ticking("poison", HARMFUL, 8889187, effect, POISONS),
        ticking("wither", HARMFUL, 7561558, effect, WITHERS),
        plain("health_boost", BENEFICIAL, 16284963, effect, some((attribute("max_health"), String("effect.health_boost"), 4.0, 0))),
        EffectFacts { name: String("absorption"), category: BENEFICIAL, color: 2445989, particle: effect, colored: true, modifier: some((attribute("max_absorption"), String("effect.absorption"), 4.0, 0)), ticks: ABSORBS },
        ticking("saturation", BENEFICIAL, 16262179, effect, PLAYERS_NOW),
        plain("glowing", NEUTRAL, 9740385, effect, none),
        plain("levitation", HARMFUL, 13565951, effect, none),
        plain("luck", BENEFICIAL, 5882118, effect, some((attribute("luck"), String("effect.luck"), 1.0, 0))),
        plain("unluck", HARMFUL, 12624973, effect, some((attribute("luck"), String("effect.unluck"), -1.0, 0))),
        plain("slow_falling", BENEFICIAL, 15978425, effect, none),
        plain("conduit_power", BENEFICIAL, 1950417, effect, none),
        plain("dolphins_grace", BENEFICIAL, 8954814, effect, none),
        EffectFacts { name: String("bad_omen"), category: NEUTRAL, color: 745784, particle: effect, colored: true, modifier: none, sound: some(String("event.mob_effect.bad_omen")), ticks: PLAYERS },
        plain("hero_of_the_village", BENEFICIAL, 4521796, effect, none),
        plain("darkness", HARMFUL, 2696993, effect, none),
        EffectFacts { name: String("trial_omen"), category: NEUTRAL, color: 1484454, particle: trial, colored: false, modifier: none, sound: some(String("event.mob_effect.trial_omen")) },
        EffectFacts { name: String("raid_omen"), category: NEUTRAL, color: 14565464, particle: raid, colored: false, modifier: none, sound: some(String("event.mob_effect.raid_omen")), ticks: PLAYERS_AT_END },
        plain("wind_charged", HARMFUL, 12438015, effect, none),
        plain("weaving", HARMFUL, 7891290, effect, none),
        plain("oozing", HARMFUL, 10092451, effect, none),
        plain("infested", HARMFUL, 9214860, effect, none),
        plain("breath_of_the_nautilus", BENEFICIAL, 65518, effect, none),
    ]
}

// An effect shown with `entity_effect` in its colour, which doesn't tick.
fn plain(name: str, category: i32, color: i32, particle: i32, modifier: own (u32, String, f64, i32)?) -> EffectFacts {
    return EffectFacts { name: String(name), category: category, color: color, particle: particle, colored: true, modifier: modifier }
}

// An effect shown with `entity_effect` in its colour, which ticks as `ticks` says.
fn ticking(name: str, category: i32, color: i32, particle: i32, ticks: i32) -> EffectFacts {
    return EffectFacts { name: String(name), category: category, color: color, particle: particle, colored: true, modifier: none, ticks: ticks }
}

// The attribute `minecraft:{name}`'s ID.
fn attribute(name: str) -> u32 {
    return attribute_id("minecraft:{name}") ?? panic("no attribute {name}")
}

// The place of `name` in `names`, or -1.
fn place_of(names: List<String>, name: String) -> i32 {
    for i in 0..names.len() {
        if names[i] == name {
            return i32.wrap(i)
        }
    }
    return -1
}

/// The ID of the effect `name`, `minecraft:` and its path or its path alone, none where there's
/// no such effect.
pub fn effect_id(name: String) -> i32? {
    let path = if name.starts_with("minecraft:") { name[10..].copy() } else { name.copy() }
    let names = builtin_entries(3)
    let at = place_of(names, path)
    return if at < 0 { none } else { some(at) }
}

/// What an effect is beside its kind, `MobEffectInstance.Details`: its ticks left, -1 for ever;
/// its amplifier, from 0 to 255; whether it's ambient, as a beacon's is; and whether it shows its
/// particles and its icon.
pub struct Details {
    pub duration: i32
    pub amplifier: i32
    pub ambient: bool = false
    pub visible: bool = true
    pub show_icon: bool = true
}

impl Details {
    /// `isInfiniteDuration`.
    pub fn infinite(self) -> bool {
        return self.duration == -1
    }

    // `isShorterDurationThan`.
    fn shorter_than(self, other: Details) -> bool {
        return not self.infinite() and (self.duration < other.duration or other.infinite())
    }

    // `mapDuration` of a tick less, none for ever.
    fn tick_down(mut self) {
        if not self.infinite() {
            self.duration -= 1
        }
    }

    // `hasRemainingDuration`.
    fn remaining(self) -> bool {
        return self.infinite() or self.duration > 0
    }
}

/// An effect on a living entity, `MobEffectInstance`: its kind, by ID; what it is now; and the
/// effects of its kind it hides, `hiddenEffect`, the first to come back first, each hiding the
/// next.
pub struct ActiveEffect {
    pub id: i32
    pub now: Details
    pub hidden: List<Details> = List<Details>()
}

impl ActiveEffect {
    /// An effect of the kind `id` for `duration` ticks at `amplifier`, kept from 0 to 255, not
    /// ambient, its particles and icon shown.
    pub fn new(id: i32, duration: i32, amplifier: i32) -> ActiveEffect {
        let amp = if amplifier < 0 { 0 } else if amplifier > 255 { 255 } else { amplifier }
        return ActiveEffect { id: id, now: Details { duration: duration, amplifier: amp } }
    }

    /// Its ticks left, -1 for ever, `getDuration`.
    pub fn duration(self) -> i32 {
        return self.now.duration
    }

    /// Its amplifier, `getAmplifier`.
    pub fn amplifier(self) -> i32 {
        return self.now.amplifier
    }

    /// `update`: `take` of the same kind merged into it, its stronger level over a longer, the
    /// weaker one hidden while it's longer, its longer duration at the same level, and its
    /// ambience, particles and icon; whether that changed it.
    pub fn update(mut self, take: Details) -> bool {
        var chain = List<Details>()
        chain.push(self.now)
        for h in self.hidden {
            chain.push(h)
        }
        let changed = update_in(mut chain, 0, take)
        self.now = chain.remove(0)
        self.hidden = chain
        return changed
    }

    /// `tickServer`'s count down, once its tick's acted: a tick less of it and of each it hides,
    /// `tickDownDuration`; then, where it's run out, the first it hid in its place,
    /// `downgradeToHiddenEffect`, which is whether it changed.
    pub fn tick_down(mut self) -> bool {
        self.now.tick_down()
        for i in 0..self.hidden.len() {
            self.hidden[i].tick_down()
        }
        if self.now.duration == 0 and not self.hidden.is_empty() {
            self.now = self.hidden.remove(0)
            return true
        }
        return false
    }

    /// `hasRemainingDuration`: it lasts for ever, or has ticks left.
    pub fn remaining(self) -> bool {
        return self.now.remaining()
    }

    /// `withScaledDuration` (CAL-163): a copy of what it is now, hiding nothing, `scale` times as
    /// long, `Mth.floor` of it in floats, at least a tick; as long where it lasts for ever.
    pub fn scaled(self, scale: f32) -> ActiveEffect {
        var d = self.now
        if not d.infinite() {
            let longer = i32.saturate((f32.nearest(d.duration) * scale).floor())
            d.duration = longer.max(1)
        }
        return ActiveEffect { id: self.id, now: d }
    }

    /// It as `MobEffectInstance.CODEC` saves it, `names` the effects' names: its `id`, then its
    /// details, each but `show_icon` left out where it's its default, `hidden_effect` the one it
    /// hides, with those that one hides.
    pub fn saved(self, names: List<String>) -> Tag {
        let name = if self.id >= 0 and usize.wrap(self.id) < names.len() { names[usize.wrap(self.id)].copy() } else { String() }
        return details_tag(some("minecraft:{name}"), self.now, self.hidden, 0)
    }

    /// An effect as `MobEffectInstance.CODEC` reads one from `tag`, none where its `id` isn't an
    /// effect: its amplifier an unsigned byte, 0 where it's left out, its duration 0, not
    /// ambient, its particles shown and its icon where its particles are, unless it says, and the
    /// effects it hides, each of its kind.
    pub fn read(tag: Tag) -> ActiveEffect? {
        let Tag.Compound(m) = tag else return none
        if not m.contains("id") {
            return none
        }
        let Tag.Str(name) = m["id"] else return none
        let id = effect_id(name) else return none
        var chain = List<Details>()
        var at = tag.copy()
        loop {
            let Tag.Compound(fields) = at.copy() else break
            chain.push(details_of(fields))
            if not fields.contains("hidden_effect") {
                break
            }
            at = fields["hidden_effect"].copy()
        }
        if chain.is_empty() {
            return none
        }
        let now = chain.remove(0)
        return some(ActiveEffect { id: id, now: now, hidden: chain })
    }
}

// `update` of `chain[k]`, the rest of `chain` what it hides, with `take`.
fn update_in(chain: mut List<Details>, k: usize, take: Details) -> bool {
    var changed = false
    if take.amplifier > chain[k].amplifier {
        if take.shorter_than(chain[k]) {
            // It's hidden as it was, hiding what it hid.
            chain.insert(k + 1, chain[k])
        }
        chain[k].amplifier = take.amplifier
        chain[k].duration = take.duration
        changed = true
    } else if chain[k].shorter_than(take) {
        if take.amplifier == chain[k].amplifier {
            chain[k].duration = take.duration
            changed = true
        } else if k + 1 >= chain.len() {
            chain.push(take)
        } else {
            _ = update_in(mut chain, k + 1, take)
        }
    }
    if (not take.ambient and chain[k].ambient) or changed {
        chain[k].ambient = take.ambient
        changed = true
    }
    if take.visible != chain[k].visible {
        chain[k].visible = take.visible
        changed = true
    }
    if take.show_icon != chain[k].show_icon {
        chain[k].show_icon = take.show_icon
        changed = true
    }
    return changed
}

// The details of an effect's tag, as `Details.MAP_CODEC` reads them.
fn details_of(m: JavaHashMap<String, Tag>) -> Details {
    var amplifier = 0
    if m.contains("amplifier") {
        if let b = m["amplifier"].byte_value() {
            amplifier = i32(b) & 255
        }
    }
    let visible = if m.contains("show_particles") { bool_or(m, "show_particles") } else { true }
    let icon = if m.contains("show_icon") { bool_or(m, "show_icon") } else { visible }
    return Details { duration: int_or(m, "duration", 0), amplifier: amplifier, ambient: bool_or(m, "ambient"), visible: visible, show_icon: icon }
}

// The details `now` as `Details.MAP_CODEC` writes them, after the effect's `id` where it's
// given, with `hidden_effect` the next of `hidden` from `k`.
fn details_tag(id: String?, now: Details, hidden: List<Details>, k: usize) -> Tag {
    var t = JavaHashMap<String, Tag>()
    if let name = id {
        t.insert(String("id"), Tag.Str(name.copy()))
    }
    if now.amplifier != 0 {
        t.insert(String("amplifier"), Tag.Byte(i8.wrap(now.amplifier)))
    }
    if now.duration != 0 {
        t.insert(String("duration"), Tag.Int(now.duration))
    }
    if now.ambient {
        t.insert(String("ambient"), Tag.Byte(1i8))
    }
    if not now.visible {
        t.insert(String("show_particles"), Tag.Byte(0i8))
    }
    t.insert(String("show_icon"), Tag.Byte(if now.show_icon { 1i8 } else { 0i8 }))
    if k < hidden.len() {
        t.insert(String("hidden_effect"), details_tag(none, hidden[k], hidden, k + 1))
    }
    return Tag.Compound(t)
}

/// The effects of the potion `name`, `minecraft:` and its path or its path alone, as `Potions`
/// registers them, each for its time at its level, not ambient, its particles and icon shown;
/// none for a potion without effects, as water, or for what isn't a potion (CAL-163).
pub fn potion_effects(name: String) -> List<ActiveEffect> {
    let path = if name.starts_with("minecraft:") { name[10..].copy() } else { name.copy() }
    let table: List<(String, List<(i32, i32, i32)>)> = [
        (String("water"), []),
        (String("mundane"), []),
        (String("thick"), []),
        (String("awkward"), []),
        (String("night_vision"), [(15, 3600, 0)]),
        (String("long_night_vision"), [(15, 9600, 0)]),
        (String("invisibility"), [(13, 3600, 0)]),
        (String("long_invisibility"), [(13, 9600, 0)]),
        (String("leaping"), [(7, 3600, 0)]),
        (String("long_leaping"), [(7, 9600, 0)]),
        (String("strong_leaping"), [(7, 1800, 1)]),
        (String("fire_resistance"), [(11, 3600, 0)]),
        (String("long_fire_resistance"), [(11, 9600, 0)]),
        (String("swiftness"), [(0, 3600, 0)]),
        (String("long_swiftness"), [(0, 9600, 0)]),
        (String("strong_swiftness"), [(0, 1800, 1)]),
        (String("slowness"), [(1, 1800, 0)]),
        (String("long_slowness"), [(1, 4800, 0)]),
        (String("strong_slowness"), [(1, 400, 3)]),
        (String("turtle_master"), [(1, 400, 3), (10, 400, 2)]),
        (String("long_turtle_master"), [(1, 800, 3), (10, 800, 2)]),
        (String("strong_turtle_master"), [(1, 400, 5), (10, 400, 3)]),
        (String("water_breathing"), [(12, 3600, 0)]),
        (String("long_water_breathing"), [(12, 9600, 0)]),
        (String("healing"), [(5, 1, 0)]),
        (String("strong_healing"), [(5, 1, 1)]),
        (String("harming"), [(6, 1, 0)]),
        (String("strong_harming"), [(6, 1, 1)]),
        (String("poison"), [(18, 900, 0)]),
        (String("long_poison"), [(18, 1800, 0)]),
        (String("strong_poison"), [(18, 432, 1)]),
        (String("regeneration"), [(9, 900, 0)]),
        (String("long_regeneration"), [(9, 1800, 0)]),
        (String("strong_regeneration"), [(9, 450, 1)]),
        (String("strength"), [(4, 3600, 0)]),
        (String("long_strength"), [(4, 9600, 0)]),
        (String("strong_strength"), [(4, 1800, 1)]),
        (String("weakness"), [(17, 1800, 0)]),
        (String("long_weakness"), [(17, 4800, 0)]),
        (String("luck"), [(25, 6000, 0)]),
        (String("slow_falling"), [(27, 1800, 0)]),
        (String("long_slow_falling"), [(27, 4800, 0)]),
        (String("wind_charged"), [(35, 3600, 0)]),
        (String("weaving"), [(36, 3600, 0)]),
        (String("oozing"), [(37, 3600, 0)]),
        (String("infested"), [(38, 3600, 0)]),
    ]
    var out = List<ActiveEffect>()
    for row in table {
        let (potion, effects) = row
        if potion == path {
            for e in effects {
                let (id, duration, amplifier) = e
                out.push(ActiveEffect.new(id, duration, amplifier))
            }
        }
    }
    return out
}

/// The effects of a stack's `potion_contents`, `PotionContents.forEachEffect`, `contents` the
/// component as it's saved, its potion's ID alone or a compound: its potion's, then its own,
/// `custom_effects`, an effect that doesn't read left out, each `scaled` by `scale`, the stack's
/// `potion_duration_scale` (CAL-163).
pub fn contents_effects(contents: Tag, scale: f32) -> List<ActiveEffect> {
    var out = List<ActiveEffect>()
    var potion: String? = none
    var custom = List<Tag>()
    match contents {
        Tag.Str(name) => potion = some(name.copy()),
        Tag.Compound(m) => {
            if m.contains("potion") {
                if let Tag.Str(name) = m["potion"] {
                    potion = some(name.copy())
                }
            }
            if m.contains("custom_effects") {
                if let Tag.List(items) = m["custom_effects"] {
                    custom = items.copy()
                }
            }
        },
        _ => {},
    }
    if let name = potion {
        for e in potion_effects(name.copy()) {
            out.push(e.scaled(scale))
        }
    }
    for item in custom {
        if let e = ActiveEffect.read(item.copy()) {
            out.push(e.scaled(scale))
        }
    }
    return out
}

/// `LivingEntity.getJumpBoostPower` of jump boost at `amplifier`, -1 where there's none (D515): a
/// tenth more up a level, none without it.
pub fn jump_boost_power(amplifier: i32) -> f32 {
    return if amplifier < 0 { 0.0f32 } else { 0.1f32 * (f32.nearest(amplifier) + 1.0f32) }
}

/// Whether the potion contents `contents`, as their codec reads them, are `PotionContents.EMPTY`
/// (D513): no potion, colour, effects or name of their own.
pub fn contents_empty(contents: Tag) -> bool {
    match contents {
        Tag.Str(_) => return false,
        Tag.Compound(m) => {
            if m.contains("potion") or m.contains("custom_color") or m.contains("custom_name") {
                return false
            }
            if m.contains("custom_effects") {
                if let Tag.List(items) = m["custom_effects"] {
                    return items.is_empty()
                }
            }
        },
        _ => {},
    }
    return true
}

/// The colour of the potion contents `contents`, `PotionContents.getColor` (D513): their own, else
/// their effects', `getAllEffects`, mixed, `getColorOptional`, each one shown weighing its
/// amplifier and 1, opaque; else the base potion's, where none is shown.
pub fn contents_color(contents: Tag) -> i32 {
    if let Tag.Compound(m) = contents {
        if m.contains("custom_color") {
            if let Tag.Int(c) = m["custom_color"] {
                return c
            }
        }
    }
    let facts = effect_facts()
    var red = 0
    var green = 0
    var blue = 0
    var weight = 0
    for e in contents_effects(contents.copy(), 1.0f32) {
        if e.now.visible {
            let c = facts[usize.wrap(e.id)].color
            let w = e.amplifier() + 1
            red += w * ((c >> 16) & 255)
            green += w * ((c >> 8) & 255)
            blue += w * (c & 255)
            weight += w
        }
    }
    if weight == 0 {
        return BASE_POTION_COLOR
    }
    return -16777216 | ((red / weight) << 16) | ((green / weight) << 8) | (blue / weight)
}

/// The effects' names, without `minecraft:`, in their IDs' order.
pub fn effect_names() -> List<String> {
    return builtin_entries(3)
}
