/// A mob's leash, vanilla's `Leashable` (CAL-179): what holds it, as it was saved till it's found
/// and as found since; and the pull its holder gives it, `checkElasticInteractions`, a spring from
/// a point on its holder to one on it that pulls past its slack, pulling it across more than up,
/// and turning it by where on it the pull comes.
module world.leash

import math.mth.{table_cos, table_sin}
import nbt.tag.{Tag}
import world.collision.{Aabb}
import world.currents.{normalize}

/// How far a mob's leash snaps, `leashSnapDistance`, and pulls from, `leashElasticDistance`.
pub const SNAP_DISTANCE: f64 = 12.0
pub const ELASTIC_DISTANCE: f64 = 6.0

/// What a mob's leash ties it to, `LeashData`: its holder where it's found, an entity by its ID and
/// UUID, and, for a player, which of the server's player objects they are, `Follower.object`, as a
/// player who left or respawned isn't the one who held it; else what it was saved with,
/// `delayedLeashInfo`, its holder's UUID or a knot's place. And how fast its pulls turn it,
/// `angularMomentum`.
pub struct Leash {
    pub holder: Held? = none
    pub saved: Tag? = none
    pub momentum: f64 = 0.0
}

/// The entity that holds a leash.
pub struct Held {
    pub id: i32
    pub uuid: (i64, i64)
    pub player: bool = false
    pub object: u64 = 0
    /// For a knot, its fence's place, which a leash to it is saved as.
    pub knot: (i32, i32, i32)? = none
}

/// What a leashed mob's level found of its holder for its tick: who it is, as `Held` has it;
/// whether it's in the mob's level and may interact with it, `canInteractWithLevel`, alive, not
/// removed and not a spectator; where it is, its box and size, which way it faces, `getYRot`, and
/// how it moves, what its client last said for a player, `getKnownMovement`, nothing for a mob
/// without AI, `getHolderMovement`.
pub struct Holding {
    pub held: Held
    pub here: bool = true
    pub interacts: bool = true
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
    pub bounds: Aabb = Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 0.0, max_y: 0.0, max_z: 0.0 }
    pub width: f32 = 0.6f32
    pub height: f32 = 1.8f32
    pub y_rot: f32 = 0.0f32
    pub moving: (f64, f64, f64) = (0.0, 0.0, 0.0)
}

/// One lead, as a leash let go drops it, `spawnAtLocation(level, Items.LEAD)`.
pub fn lead_stack() -> Tag {
    var lead = JavaHashMap<String, Tag>()
    lead.insert(String("id"), Tag.Str(String("minecraft:lead")))
    lead.insert(String("count"), Tag.Int(1))
    return Tag.Compound(lead)
}

/// `AABB.getCenter`: halfway along each side, `Mth.lerp(0.5, min, max)`.
pub fn center(b: Aabb) -> (f64, f64, f64) {
    return (b.min_x + 0.5 * (b.max_x - b.min_x), b.min_y + 0.5 * (b.max_y - b.min_y), b.min_z + 0.5 * (b.max_z - b.min_z))
}

/// `leashDistanceTo`: from the middle of one box to the middle of the other.
pub fn box_distance(a: Aabb, b: Aabb) -> f64 {
    let (ax, ay, az) = center(a)
    let (bx, by, bz) = center(b)
    let dx = ax - bx
    let dy = ay - by
    let dz = az - bz
    return (dx * dx + dy * dy + dz * dz).sqrt()
}

/// A pull on a leashed mob, `Wrench`: the force, and how much it turns it.
pub struct Pull {
    pub x: f64
    pub y: f64
    pub z: f64
    pub torque: f64
}

// `Vec3.yRot` by `radians`, through `Mth`'s sine table.
fn y_rot(x: f64, y: f64, z: f64, radians: f32) -> (f64, f64, f64) {
    let c = f64(table_cos(f64(radians)))
    let s = f64(table_sin(f64(radians)))
    return (x * c + z * s, y, z * c - x * s)
}

/// `computeElasticInteraction` with a mob's one point, `ENTITY_ATTACHMENT_POINT`, half up and half
/// its width ahead of it, and its holder's, `LEASHER_ATTACHMENT_POINT`, half up: the mob at
/// `x, y, z` of width `w` and height `h` facing `y_rot`, moving `moving`, its holder `held`;
/// `computeDampenedSpringInteraction`, none where the points are within `slack`, else toward the
/// holder by how far past it they are, three tenths of that where the mob moves that way, and
/// turning it by `torqueFromForce`.
pub fn leash_pull(x: f64, y: f64, z: f64, w: f32, h: f32, y_rot_deg: f32, moving: (f64, f64, f64), held: Holding, slack: f64) -> Pull? {
    // `getYRot() * (float) (Math.PI / 180.0)`, floats.
    let radians = y_rot_deg * 0.017453292f32
    let (ax, ay, az) = y_rot(0.0, 0.5 * f64(h), 0.5 * f64(w), -radians)
    let (ox, oy, oz) = (x + ax, y + ay, z + az)
    let holder_radians = held.y_rot * 0.017453292f32
    let (hx, hy, hz) = y_rot(0.0, 0.5 * f64(held.height), 0.0, -holder_radians)
    let (px, py, pz) = (held.x + hx, held.y + hy, held.z + hz)
    let ex = px - ox
    let ey = py - oy
    let ez = pz - oz
    let distance = (ex * ex + ey * ey + ez * ez).sqrt()
    if distance < slack {
        return none
    }
    let (nx, ny, nz) = normalize(ex, ey, ez)
    let past = distance - slack
    var dx = nx * past
    var dy = ny * past
    var dz = nz * past
    let torque = az * dx - ax * dz
    let (mx, my, mz) = moving
    if mx * dx + my * dy + mz * dz >= 0.0 {
        // `scale(0.3F)`, the float widened.
        let third = f64(0.3f32)
        dx = dx * third
        dy = dy * third
        dz = dz * third
    }
    return some(Pull { x: dx, y: dy, z: dz, torque: torque })
}

/// What a player's use did to a leash, for its level to send in order (CAL-179): the leashed
/// mob's ID and its new holder's, 0 where it's let go, and where its lead was dropped first, if
/// it was; and the knot it was tied to, 0 for none, which goes where nothing's left tied to it,
/// `notifyLeasheeRemoved`, as the leash is let go, after its link, `dropLeash`, or as it's tied
/// to another, before it, `setLeashedTo`.
pub struct LeashStep {
    pub source: i32
    pub dest: i32
    pub drop: (f64, f64, f64)? = none
    pub knot: i32 = 0
}

/// The 32 block cube about the middle of `b`, `AABB.ofSize`, which `leashableInArea` looks in.
pub fn leash_area(b: Aabb) -> Aabb {
    let (x, y, z) = center(b)
    return Aabb { min_x: x - 16.0, min_y: y - 16.0, min_z: z - 16.0, max_x: x + 16.0, max_y: y + 16.0, max_z: z + 16.0 }
}
