        "==__88??::AAVV&&##yccycc!dd!ddeEEeEEfFFfFFeEEeEEfFFfFFgGGgGGhHHhHHI++I++J,,J,,I++I++J,,J,,gGGgGG",
        "hHHhHHI++I++J,,J,,I++I++J,,J,,iKKiKKjLLjLLM--M--N..N..M--M--N..N..O//O//P00P001$$1$$2%%2%%1$$1$$",
        "2%%2%%O//O//P00P001$$1$$2%%2%%1$$1$$2%%2%%iKKiKKjLLjLLM--M--N..N..M--M--N..N..O//O//P00P001$$1$$",
        "2%%2%%1$$1$$2%%2%%O//O//P00P001$$1$$2%%2%%1$$1$$2%%2%%##########z9z9#########!#zSzSzSzSzSzSzSzS",
        "zSzSzSzSzSzSzSzS################################################################################",
        "############``#kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",
        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!z9z9!",
    ]
    let alphabet = "!#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz|~"
    var digit: List<u32> = []
    for _ in 0..128 {
        digit.push(0)
    }
    for i in 0..alphabet.len() {
        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)
    }
    var shapes: List<u16> = []
    shapes.reserve(35723)
    for line in lines {
        var i: usize = 0
        while i < line.len() {
            let d = digit[usize(line.byte_at(i))]
            if d >= 87 {
                shapes.push(values[usize(87 + (d - 87) * 90 + digit[usize(line.byte_at(i + 1))])])
                i += 2
            } else {
                shapes.push(values[usize(d)])
                i += 1
            }
        }
    }
    return shapes
}

