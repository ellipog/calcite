/// What a block does as it's set, as the blocks around it change and as its scheduled tick runs,
/// in the server's level: vanilla's `onPlace`, `affectNeighborsAfterRemoval`, `neighborChanged`
/// and `tick`, each as the class that declares it runs it (D325, D335), on the level
/// `world.block_level` has. Fire is placed, ticks, burns what's by it and spreads as `FireBlock`
/// has it (D339). Redstone's observers, repeaters, torches, lamps and wire run as theirs do, with
/// the signals `worldgen.signals` reads (CAL-116), and pistons as `world.pistons` has them
/// (CAL-125). The order the blocks around are told in
/// is the level's, as `CollectingNeighborUpdater` keeps it. A class Calcite doesn't have yet
/// throws `Unimplemented`, which the level reports once and goes on past, leaving the block as it
/// is.
module world.block_updates

import nbt.tag.{Tag}
import java.character.{is_whitespace}
import random.source.{RandomSource}
import std.java.math.{pow}
import world.analog_output.{analog_output}
import world.block_level.{BlockLevel, LAVA_FIZZ, SOUND_RECORDS, TORCH_BURNOUT, destroy_block, remove_block}
import world.level_writer.{UPDATE_LIMIT}
import world.pistons.{check_if_extend, fitting_base}
import world.rails.{rail_neighbour_changed, rail_placed, rail_removed}
import world.shelves.{powering_down, shelf_neighbour_changed, shelf_placed}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, EAST, FULL, Facts, NORTH, SIGNAL_COMPARATOR, SIGNAL_REPEATER, SOUTH, UP, WATER_FLUID, WEST, clockwise, horizontal, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.portal_shape.{PortalShape, find_any_shape}
import worldgen.shapes.{can_occupy, coral_die_tick, fire_with_age, leaf_distance, touches_water}
import worldgen.signals.{best_neighbour_signal, comparator_output, control_input, has_neighbour_signal, has_signal, repeater_locked, signal}
import worldgen.survive.{Env, can_survive, facing_of}

/// `levelEvent`'s types for a dispenser or dropper with nothing to dispense, and a crafter with
/// nothing to craft (CAL-124).
pub const DISPENSER_FAIL: i32 = 1001
pub const CRAFTER_FAIL: i32 = 1050

/// `TickPriority`'s values: a diode's ticks come before others due the same tick (CAL-116).
pub const EXTREMELY_HIGH: i32 = -3
pub const VERY_HIGH: i32 = -2
pub const HIGH: i32 = -1
pub const NORMAL: i32 = 0

/// `NeighborUpdater.UPDATE_ORDER`, the order the six blocks around one are told it changed: its
/// `i`th.
pub fn update_order(i: i32) -> i32 {
    return match i {
        0 => WEST,
        1 => EAST,
        2 => DOWN,
        3 => UP,
        4 => NORTH,
        _ => SOUTH,
    }
}

/// `BlockBehaviour.UPDATE_SHAPE_ORDER`, the order the six blocks around one are told its shape:
/// its `i`th.
pub fn shape_order(i: i32) -> i32 {
    return match i {
        0 => WEST,
        1 => EAST,
        2 => NORTH,
        3 => SOUTH,
        4 => DOWN,
        _ => UP,
    }
}

// `LiquidBlock.POSSIBLE_FLOW_DIRECTIONS`: its `i`th.
fn flow_direction(i: i32) -> i32 {
    return match i {
        0 => DOWN,
        1 => SOUTH,
        2 => NORTH,
        3 => EAST,
        _ => WEST,
    }
}

/// `BlockState.onPlace`: what the block `state` does as it's set at `x`, `y`, `z` where `old`
/// was, `moved` if a piston moved it.
pub fn on_place<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, old: u32, moved: bool) ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let kind = f.place_class(block)
    if kind == "BlockBehaviour" {
        return
    }
    if kind == "LiquidBlock" {
        try liquid_changed(e, mut level, state, x, y, z)
        return
    }
    if kind == "FallingBlock" {
        // `getDelayAfterPlace`: 2, or the dragon egg's 5.
        level.schedule_block(block, x, y, z, if block == f.ids.dragon_egg { 5 } else { 2 }, 0)
        return
    }
    if kind == "BrushableBlock" {
        level.schedule_block(block, x, y, z, 2, 0)
        return
    }
    if kind == "ScaffoldingBlock" {
        level.schedule_block(block, x, y, z, 1, 0)
        return
    }
    if kind == "CoralPlantBlock" or kind == "CoralFanBlock" or kind == "CoralWallFanBlock" {
        // `tryScheduleDieTick`, drawing from the level's random.
        try coral_die_tick(f, mut level, state, x, y, z)
        return
    }
    if kind == "FireBlock" {
        // `FireBlock.onPlace`: `BaseFireBlock`'s, then its tick, drawn, whatever that did.
        try fire_placed(e, mut level, state, x, y, z, old)
        let delay = fire_delay(mut level)
        level.schedule_block(block, x, y, z, delay, 0)
        return
    }
    if kind == "BaseFireBlock" {
        try fire_placed(e, mut level, state, x, y, z, old)
        return
    }
    if kind == "ObserverBlock" {
        // One set powered, as a command or a structure sets it, with no tick of its own waiting,
        // is unpowered at once, with flags 18, and tells what's behind it.
        if f.block(old) != block and f.get_bool(state, "powered") and not level.has_block_tick(block, x, y, z) {
            let off = try f.with_bool(state, "powered", false)
            _ = level.set_block_limited(x, y, z, off, 18, UPDATE_LIMIT)
            try update_in_front(f, mut level, off, x, y, z)
        }
        return
    }
    if kind == "DiodeBlock" {
        try update_in_front(f, mut level, state, x, y, z)
        return
    }
    if kind == "RedstoneTorchBlock" {
        torch_neighbours(mut level, block, x, y, z)
        return
    }
    if kind == "CopperBulbBlock" {
        // Where it wasn't a copper bulb of its kind, lit or not as it's powered (CAL-124).
        if f.block(old) != block {
            try copper_bulb_check(f, mut level, state, x, y, z)
        }
        return
    }
    if kind == "HopperBlock" {
        if f.block(old) != block {
            try hopper_check(f, mut level, state, x, y, z)
        }
        return
    }
    if kind == "BaseRailBlock" {
        try rail_placed(f, mut level, state, x, y, z, old, moved)
        return
    }
    if kind == "ShelfBlock" {
        try shelf_placed(f, mut level, state, x, y, z, old)
        return
    }
    if kind == "TntBlock" {
        // Primed where it's placed powered, which comes with entities (CAL-124).
        if f.block(old) != block and try has_neighbour_signal(f, level, x, y, z, true) {
            fail Thrown { exception: "Unimplemented", message: "Primed TNT" }
        }
        return
    }
    if kind == "PistonBaseBlock" {
        // Where it wasn't a piston of its kind and has no block entity, whether it moves
        // (CAL-125).
        if f.block(old) == block {
            return
        }
        match level.block_entity_tag(x, y, z) {
            some(_) => {},
            none => try check_if_extend(f, mut level, state, x, y, z),
        }
        return
    }
    if kind == "RedstoneWireBlock" {
        // Not where it was wire already: its power, then the blocks around those above and below
        // it, and those its neighbouring wires reach.
        if f.block(old) == block {
            return
        }
        try wire_power(f, mut level, state, x, y, z)
        level.update_neighbours(x, y + 1, z, block)
        level.update_neighbours(x, y - 1, z, block)
        try wire_neighbours_of_wires(f, mut level, block, x, y, z)
        return
    }
    fail Thrown { exception: "Unimplemented", message: "onPlace of {kind}" }
}

/// `BlockState.affectNeighborsAfterRemoval`: what the block `old`, replaced at `x`, `y`, `z`,
/// does to the blocks around, `moved` if a piston moved it.
pub fn after_removal<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, old: u32, x: i32, y: i32, z: i32, moved: bool) ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(old)
    let kind = f.removal_class(block)
    if kind == "BlockBehaviour" {
        return
    }
    if kind == "ObserverBlock" {
        // A powered one whose tick to turn off waits tells what was behind it it's off.
        if f.get_bool(old, "powered") and level.has_block_tick(block, x, y, z) {
            try update_in_front(f, mut level, try f.with_bool(old, "powered", false), x, y, z)
        }
        return
    }
    if kind == "DiodeBlock" {
        if not moved {
            try update_in_front(f, mut level, old, x, y, z)
        }
        return
    }
    if kind == "RedstoneTorchBlock" {
        if not moved {
            torch_neighbours(mut level, block, x, y, z)
        }
        return
    }
    if kind == "BaseRailBlock" {
        rail_removed(f, mut level, old, x, y, z, moved)
        return
    }
    if kind == "ShelfBlock" {
        // `Containers.updateNeighboursAfterDestroy`: a comparator reading it told; then its
        // neighbours let go (CAL-124).
        try update_output_signal(f, mut level, block, x, y, z)
        try powering_down(f, mut level, old, x, y, z)
        return
    }
    if kind == "RedstoneWireBlock" {
        if moved {
            return
        }
        for d in 0..6 {
            level.update_neighbours(x + step_x(d), y + step_y(d), z + step_z(d), block)
        }
        try wire_power(f, mut level, old, x, y, z)
        try wire_neighbours_of_wires(f, mut level, block, x, y, z)
        return
    }
    if output_signal_on_removal(kind) {
        try update_output_signal(f, mut level, block, x, y, z)
        return
    }
    if kind == "PistonHeadBlock" {
        // The piston it was out of broken, with what it drops (CAL-125).
        let d = opposite(try facing_of(f, old))
        let (bx, by, bz) = (x + step_x(d), y + step_y(d), z + step_z(d))
        if try fitting_base(f, old, try level.state(f, bx, by, bz)) {
            _ = try destroy_block(e, mut level, bx, by, bz, true, UPDATE_LIMIT)
        }
        return
    }
    fail Thrown { exception: "Unimplemented", message: "affectNeighborsAfterRemoval of {kind}" }
}

// The classes whose `affectNeighborsAfterRemoval` is `Containers.updateNeighboursAfterDestroy`,
// or as a copper golem statue's, `updateNeighbourForOutputSignal` of its block, alone.
fn output_signal_on_removal(kind: String) -> bool {
    for name in ["AbstractFurnaceBlock", "BarrelBlock", "BrewingStandBlock", "ChestBlock", "ChiseledBookShelfBlock", "CopperGolemStatueBlock", "CrafterBlock", "CreakingHeartBlock", "DecoratedPotBlock", "DispenserBlock", "HopperBlock", "JukeboxBlock", "ShulkerBoxBlock"] {
        if kind == String(name) {
            return true
        }
    }
    return false
}

// The sound the door, trapdoor or fence gate `block` at x, y, z plays opening, if `open`, or
// shutting, at full volume and a pitch of 0.9 to 1, as each class's `playSound` has it.
fn toggle_sound<L: BlockLevel + RandomSource>(f: Facts, level: mut L, block: u32, x: i32, y: i32, z: i32, open: bool) {
    let sound = f.toggle_sound(block, open) else return
    let pitch = level.next_float() * 0.1f32 + 0.9f32
    level.play_sound(x, y, z, sound, 1.0f32, pitch)
}

// `CopperBulbBlock.checkAndFlip`: the bulb `state` at x, y, z, newly powered, lit if it wasn't and
// out if it was, with its sound; set powered or not with flags 3 as its power changed.
fn copper_bulb_check<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let powered = try has_neighbour_signal(f, level, x, y, z, true)
    if powered == f.get_bool(state, "powered") {
        return
    }
    var next = state
    if not f.get_bool(state, "powered") {
        let lit = not f.get_bool(state, "lit")
        next = try f.with_bool(next, "lit", lit)
        level.play_sound(x, y, z, if lit { "block.copper_bulb.turn_on" } else { "block.copper_bulb.turn_off" }, 1.0f32, 1.0f32)
    }
    _ = level.set_block_limited(x, y, z, try f.with_bool(next, "powered", powered), 3, UPDATE_LIMIT)
}

// `HopperBlock.checkPoweredState`: the hopper `state` at x, y, z enabled where it isn't powered,
// with flags 2 as that changes.
fn hopper_check<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let enabled = not try has_neighbour_signal(f, level, x, y, z, true)
    if enabled != f.get_bool(state, "enabled") {
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "enabled", enabled), 2, UPDATE_LIMIT)
    }
}

/// `NoteBlock.triggerEvent`: the note block `state` at x, y, z plays its instrument, a block's
/// under it at its note's pitch and a head's on it at 1, at volume 3 among the records' sounds, its
/// seed drawn from the level's random, and the event's sent. A player head's own sound comes with
/// sounds sent by name; with none, nothing plays and the event isn't sent (CAL-124).
pub fn note_block_event<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let played = f.get_name(state, "instrument") ?? String("harp")
    var pitch = 1.0f32
    if base_instrument(played) {
        // `getPitchFromNote`.
        let note = f.get_int(state, "note") ?? 0
        pitch = f32.nearest(pow(2.0, f64(note - 12) / 12.0))
    }
    if played == "custom_head" {
        let sound = be_string(level, x, y + 1, z, "note_block_sound") else return false
        fail Thrown { exception: "Unimplemented", message: "A player head's note block sound {sound}" }
    }
    let seed = level.next_long()
    level.play_seeded_sound(x, y, z, instrument_sound(played), SOUND_RECORDS, 3.0f32, pitch, seed)
    return true
}

// Whether the note block instrument `played` is a block's under it, `BASE_BLOCK`, tuned to its
// note, rather than a head's on it.
fn base_instrument(played: String) -> bool {
    let heads: List<str> = ["zombie", "skeleton", "creeper", "dragon", "wither_skeleton", "piglin", "custom_head"]
    for h in heads {
        if played == String(h) {
            return false
        }
    }
    return true
}

// The sound event the note block instrument `played` plays: a head's imitates its mob, the
// dragon's the ender dragon.
fn instrument_sound(played: String) -> String {
    if base_instrument(played) {
        return "block.note_block.{played}"
    }
    if played == "dragon" {
        return String("block.note_block.imitate.ender_dragon")
    }
    return "block.note_block.imitate.{played}"
}

// `CommandBlockEntity.markConditionMet`: the command block `state` at x, y, z meets its condition
// unless it's conditional and what's behind it isn't a command block whose last run succeeded,
// kept in its block entity.
fn mark_condition_met<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    var met = true
    if f.get_bool(state, "conditional") {
        let back = opposite(try facing_of(f, state))
        let bx = x + step_x(back)
        let by = y + step_y(back)
        let bz = z + step_z(back)
        met = f.class_name(f.block(try level.state(f, bx, by, bz))) == "CommandBlock" and be_int(level, bx, by, bz, "SuccessCount") > 0
    }
    level.set_block_entity_value(x, y, z, "conditionMet", byte_flag(met))
    return met
}

// `CommandBlock.execute`: with no command, the command block at x, y, z succeeds at nothing, and
// the chain in front is run, `executeChain`, where there's one.
fn run_command_block<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if not (be_string(level, x, y, z, "Command") ?? String()).is_empty() {
        fail Thrown { exception: "Unimplemented", message: "A command block's command" }
    }
    level.set_block_entity_value(x, y, z, "SuccessCount", Tag.Int(0))
    let d = try facing_of(f, state)
    let ahead = try level.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
    if f.codec.blocks.name(f.block(ahead)) == "minecraft:chain_command_block" {
        fail Thrown { exception: "Unimplemented", message: "A chain of command blocks" }
    }
}

// The value `key` the block entity at x, y, z saved, where it has one.
fn be_tag<L: BlockAccess>(level: L, x: i32, y: i32, z: i32, key: str) -> Tag? {
    let saved = level.block_entity_tag(x, y, z) else return none
    let tags = match saved {
        Tag.Compound(t) => t.copy(),
        _ => return none,
    }
    if not tags.contains(key) {
        return none
    }
    return some(tags[key].copy())
}

// The flag, int or string `key` the block entity at x, y, z saved: false, 0 or `none` where it
// saved none.
fn be_flag<L: BlockAccess>(level: L, x: i32, y: i32, z: i32, key: str) -> bool {
    let tag = be_tag(level, x, y, z, key) else return false
    return match tag {
        Tag.Byte(b) => b != 0,
        _ => false,
    }
}

fn be_int<L: BlockAccess>(level: L, x: i32, y: i32, z: i32, key: str) -> i32 {
    let tag = be_tag(level, x, y, z, key) else return 0
    return match tag {
        Tag.Int(n) => n,
        _ => 0,
    }
}

fn be_string<L: BlockAccess>(level: L, x: i32, y: i32, z: i32, key: str) -> String? {
    let tag = be_tag(level, x, y, z, key) else return none
    return match tag {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

// A flag as a block entity saves it, `putBoolean`.
fn byte_flag(b: bool) -> Tag {
    return Tag.Byte(if b { 1 } else { 0 })
}

// `String.isBlank`: nothing but whitespace.
fn blank(s: String) -> bool {
    for c in s.chars() {
        if not is_whitespace(c) {
            return false
        }
    }
    return true
}

// Whether the container's block entity at x, y, z holds nothing, as a dispenser's
// `getRandomSlot` finds no slot, drawing nothing, and as a crafter's input is empty. One with loot
// still to come unpacks it first, which comes with loot tables.
fn holds_nothing<L: BlockAccess>(level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    // `getBlockEntity` makes an empty one where there's none.
    let saved = level.block_entity_tag(x, y, z) else return true
    let tags = match saved {
        Tag.Compound(t) => t.copy(),
        _ => return true,
    }
    if tags.contains("LootTable") {
        fail Thrown { exception: "Unimplemented", message: "A container's loot to come" }
    }
    if not tags.contains("Items") {
        return true
    }
    return match tags["Items"] {
        Tag.List(items) => items.is_empty(),
        _ => true,
    }
}

/// `Level.updateNeighbourForOutputSignal`: a comparator beside `x`, `y`, `z`, or behind a redstone
/// conductor beside it, each way in `Direction.Plane.HORIZONTAL`'s order, told the block `source`
/// there changed, where the block beside is loaded; the comparator is the only `ComparatorBlock`.
pub fn update_output_signal<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, source: u32, x: i32, y: i32, z: i32) ! Thrown {
    for i in 0..4 {
        let d = horizontal(i)
        var nx = x + step_x(d)
        var nz = z + step_z(d)
        if not level.is_loaded(nx, y, nz) {
            continue
        }
        let beside = try level.state(f, nx, y, nz)
        if f.signal_kind(f.block(beside)) == SIGNAL_COMPARATOR {
            level.neighbour_changed(nx, y, nz, source)
            continue
        }
        if not f.redstone_conductor(beside) {
            continue
        }
        nx += step_x(d)
        nz += step_z(d)
        let behind = try level.state(f, nx, y, nz)
        if f.signal_kind(f.block(behind)) == SIGNAL_COMPARATOR {
            level.neighbour_changed(nx, y, nz, source)
        }
    }
}

/// `BlockState.handleNeighborChanged`, its block's `neighborChanged`: what the block `state` at
/// `x`, `y`, `z` does as the block `source` beside it changes, `moved` if a piston moved it.
pub fn on_neighbour_changed<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, source: u32, moved: bool) ! Thrown {
    let Env { facts: f, .. } = e
    let kind = f.neighbour_class(f.block(state))
    if kind == "BlockBehaviour" {
        return
    }
    if kind == "LiquidBlock" {
        try liquid_changed(e, mut level, state, x, y, z)
        return
    }
    if kind == "DiodeBlock" {
        // Still there: its tick checked where it can stay, else it's broken, with what it drops,
        // and the blocks around each of the six beside it told.
        let here = try level.state(f, x, y, z)
        if f.block(here) != f.block(state) {
            return
        }
        if try can_survive(e, level, state, x, y, z) {
            try diode_check(f, mut level, state, x, y, z)
            return
        }
        level.unimplemented(String("What a broken block drops"))
        _ = try remove_block(f, mut level, x, y, z)
        for d in 0..6 {
            level.update_neighbours(x + step_x(d), y + step_y(d), z + step_z(d), f.block(state))
        }
        return
    }
    if kind == "RedstoneLampBlock" {
        // Lit at once, with flags 2, as a signal comes; put out 4 ticks on as it goes.
        let lit = f.get_bool(state, "lit")
        if lit != try has_neighbour_signal(f, level, x, y, z, true) {
            if lit {
                level.schedule_block(f.block(state), x, y, z, 4, 0)
            } else {
                _ = level.set_block_limited(x, y, z, try f.with_bool(state, "lit", true), 2, UPDATE_LIMIT)
            }
        }
        return
    }
    if kind == "AbstractSkullBlock" {
        // Powered with flags 2 as a signal comes and unpowered as it goes, as a dragon's or a
        // piglin's head moves while it's powered.
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        if powered != f.get_bool(state, "powered") {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", powered), 2, UPDATE_LIMIT)
        }
        return
    }
    if kind == "RedstoneTorchBlock" {
        // Lit with what it's on powered, or out with it not: its tick 2 on, unless one runs this
        // tick.
        if f.get_bool(state, "lit") == try torch_powered(f, level, state, x, y, z) and not level.will_tick_this_tick(f.block(state), x, y, z) {
            level.schedule_block(f.block(state), x, y, z, 2, 0)
        }
        return
    }
    if kind == "PistonBaseBlock" {
        try check_if_extend(f, mut level, state, x, y, z)
        return
    }
    if kind == "DoorBlock" {
        // Powered with either half, unless the door's other half is what changed: open and
        // powered at once, with flags 2, its sound first where it opens or closes (CAL-124).
        let other = if (f.get_name(state, "half") ?? String("lower")) == "lower" { 1 } else { -1 }
        let powered = try has_neighbour_signal(f, level, x, y, z, true) or try has_neighbour_signal(f, level, x, y + other, z, true)
        if source != f.block(state) and powered != f.get_bool(state, "powered") {
            if powered != f.get_bool(state, "open") {
                toggle_sound(f, mut level, f.block(state), x, y, z, powered)
            }
            _ = level.set_block_limited(x, y, z, try f.with_bool(try f.with_bool(state, "powered", powered), "open", powered), 2, UPDATE_LIMIT)
        }
        return
    }
    if kind == "TrapDoorBlock" {
        // Open as it's powered and shut as it isn't, with its sound, then set with flags 2, its
        // water told where it's waterlogged (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        if powered != f.get_bool(state, "powered") {
            var next = state
            if f.get_bool(state, "open") != powered {
                next = try f.with_bool(next, "open", powered)
                toggle_sound(f, mut level, f.block(state), x, y, z, powered)
            }
            _ = level.set_block_limited(x, y, z, try f.with_bool(next, "powered", powered), 2, UPDATE_LIMIT)
            if f.get_bool(next, "waterlogged") {
                level.schedule_fluid(WATER_FLUID, x, y, z)
            }
        }
        return
    }
    if kind == "FenceGateBlock" {
        // Set open and powered with flags 2 as it's powered, then its sound where it opened or
        // shut (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        if powered != f.get_bool(state, "powered") {
            _ = level.set_block_limited(x, y, z, try f.with_bool(try f.with_bool(state, "powered", powered), "open", powered), 2, UPDATE_LIMIT)
            if f.get_bool(state, "open") != powered {
                toggle_sound(f, mut level, f.block(state), x, y, z, powered)
            }
        }
        return
    }
    if kind == "CopperBulbBlock" {
        try copper_bulb_check(f, mut level, state, x, y, z)
        return
    }
    if kind == "HopperBlock" {
        try hopper_check(f, mut level, state, x, y, z)
        return
    }
    if kind == "DispenserBlock" {
        // Triggered as it's powered, or the block above is, its tick 4 on; untriggered as it
        // isn't, with flags 2 (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true) or try has_neighbour_signal(f, level, x, y + 1, z, true)
        let triggered = f.get_bool(state, "triggered")
        if powered and not triggered {
            level.schedule_block(f.block(state), x, y, z, 4, 0)
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "triggered", true), 2, UPDATE_LIMIT)
        } else if not powered and triggered {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "triggered", false), 2, UPDATE_LIMIT)
        }
        return
    }
    if kind == "CrafterBlock" {
        // As a dispenser, from its own place alone, its block entity told it's triggered; done
        // crafting as it's untriggered (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        let triggered = f.get_bool(state, "triggered")
        if powered and not triggered {
            level.schedule_block(f.block(state), x, y, z, 4, 0)
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "triggered", true), 2, UPDATE_LIMIT)
            level.set_block_entity_value(x, y, z, "triggered", Tag.Int(1))
        } else if not powered and triggered {
            _ = level.set_block_limited(x, y, z, try f.with_bool(try f.with_bool(state, "triggered", false), "crafting", false), 2, UPDATE_LIMIT)
            level.set_block_entity_value(x, y, z, "triggered", Tag.Int(0))
        }
        return
    }
    if kind == "BaseRailBlock" {
        try rail_neighbour_changed(f, mut level, state, x, y, z, source, moved)
        return
    }
    if kind == "ShelfBlock" {
        try shelf_neighbour_changed(f, mut level, state, x, y, z)
        return
    }
    if kind == "NoteBlock" {
        // Played as it's newly powered, as a block event, where its instrument's a head's or
        // nothing's on it; set powered or not with flags 3 (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        if powered != f.get_bool(state, "powered") {
            if powered {
                let played = f.get_name(state, "instrument") ?? String("harp")
                if not base_instrument(played) or f.is_air(try level.state(f, x, y + 1, z)) {
                    level.block_event(x, y, z, f.block(state), 0, 0)
                }
            }
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", powered), 3, UPDATE_LIMIT)
        }
        return
    }
    if kind == "BellBlock" {
        // Rung as it's newly powered, toward where it faces: its block event, then its sound; set
        // powered or not with flags 3 (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        if powered != f.get_bool(state, "powered") {
            if powered {
                level.block_event(x, y, z, f.block(state), 1, try facing_of(f, state))
                level.play_sound(x, y, z, "block.bell.use", 2.0f32, 1.0f32)
            }
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", powered), 3, UPDATE_LIMIT)
        }
        return
    }
    if kind == "TntBlock" {
        // Primed as it's powered, which comes with entities (CAL-124).
        if try has_neighbour_signal(f, level, x, y, z, true) {
            fail Thrown { exception: "Unimplemented", message: "Primed TNT" }
        }
        return
    }
    if kind == "CommandBlock" {
        // `setPoweredAndUpdate`: its block entity told it's powered or not as that changes;
        // newly powered, unless it's always active or a chain's, its condition checked and its
        // tick one on (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        if be_flag(level, x, y, z, "powered") == powered {
            return
        }
        level.set_block_entity_value(x, y, z, "powered", byte_flag(powered))
        if powered and not be_flag(level, x, y, z, "auto") and f.codec.blocks.name(f.block(state)) != "minecraft:chain_command_block" {
            _ = try mark_condition_met(f, mut level, state, x, y, z)
            level.schedule_block(f.block(state), x, y, z, 1, 0)
        }
        return
    }
    if kind == "StructureBlock" {
        // Its block entity told it's powered or not as that changes; newly powered, a structure
        // saved or placed by its mode, where it names one, which comes with structure templates. A
        // corner's lets go of a template it kept, and data's does nothing (CAL-124).
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        let was = be_flag(level, x, y, z, "powered")
        if powered and not was {
            level.set_block_entity_value(x, y, z, "powered", byte_flag(true))
            let mode = be_string(level, x, y, z, "mode") ?? String("DATA")
            if (mode == "SAVE" or mode == "LOAD") and not (be_string(level, x, y, z, "name") ?? String()).is_empty() {
                fail Thrown { exception: "Unimplemented", message: "A structure block's {mode}" }
            }
        } else if not powered and was {
            level.set_block_entity_value(x, y, z, "powered", byte_flag(false))
        }
        return
    }
    if kind == "TestBlock" {
        // Unless it starts a test, its block entity told it's powered or not as that changes;
        // newly powered, a log's message logged, which comes with the server's log, and it's
        // triggered, which it doesn't save (CAL-124).
        let mode = be_string(level, x, y, z, "mode") ?? (f.get_name(state, "mode") ?? String("fail"))
        if mode == "start" {
            return
        }
        let powered = try has_neighbour_signal(f, level, x, y, z, true)
        let was = be_flag(level, x, y, z, "powered")
        if powered and not was {
            level.set_block_entity_value(x, y, z, "powered", byte_flag(true))
            if mode == "log" and not blank(be_string(level, x, y, z, "message") ?? String()) {
                fail Thrown { exception: "Unimplemented", message: "A test block's log line" }
            }
        } else if not powered and was {
            level.set_block_entity_value(x, y, z, "powered", byte_flag(false))
        }
        return
    }
    if kind == "BigDripleafBlock" {
        // Level again as it's powered, with flags 2, and its sound where it was tilted (CAL-124).
        if try has_neighbour_signal(f, level, x, y, z, true) {
            let tilt = f.get_name(state, "tilt") ?? String("none")
            _ = level.set_block_limited(x, y, z, try f.with_name(state, "tilt", String("none")), 2, UPDATE_LIMIT)
            if tilt != "none" {
                // `Mth.randomBetween(random, 0.8, 1.2)`.
                let pitch = level.next_float() * (1.2f32 - 0.8f32) + 0.8f32
                level.play_sound(x, y, z, "block.big_dripleaf.tilt_up", 1.0f32, pitch)
            }
        }
        return
    }
    if kind == "PistonHeadBlock" {
        // Where it can stay, the piston it's out of told what changed (CAL-125).
        if try can_survive(e, level, state, x, y, z) {
            let d = opposite(try facing_of(f, state))
            level.neighbour_changed(x + step_x(d), y + step_y(d), z + step_z(d), source)
        }
        return
    }
    if kind == "RedstoneWireBlock" {
        if try can_survive(e, level, state, x, y, z) {
            try wire_power(f, mut level, state, x, y, z)
        } else {
            level.unimplemented(String("What a broken block drops"))
            _ = try remove_block(f, mut level, x, y, z)
        }
        return
    }
    fail Thrown { exception: "Unimplemented", message: "neighborChanged of {kind}" }
}

/// `ServerLevel.tickBlock`: the scheduled tick of `block` at `x`, `y`, `z`, if the block there is
/// still `block`, as the class that declares its `tick` runs it (D335): leaves take one more than
/// the least distance beside them; a liquid's source over a block that makes a bubble column, and
/// a bubble column, make the column up through the water above; a plant that can't stay where it
/// is, cactus, sugar cane, kelp and vines, bamboo, chorus, a dripleaf's stem or hanging moss, is
/// broken; coral with no water by it dies; farmland that can't stay, and a path, turn to dirt;
/// and fire burns, `FireBlock.tick` (D339).
pub fn tick_block<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, block: u32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    let state = try level.state(f, x, y, z)
    if f.block(state) != block {
        return
    }
    let kind = f.tick_class(block)
    if kind == "BlockBehaviour" {
        return
    }
    if kind == "LeavesBlock" {
        // `updateDistance`, in `Direction`'s order, stopping at 1, set with `setBlockAndUpdate`.
        var distance = 7
        var d = 0
        while d < 6 and distance > 1 {
            let beside = try level.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
            distance = distance.min(leaf_distance(e, beside) + 1)
            d += 1
        }
        _ = level.set_block_limited(x, y, z, try f.with_int(state, String("distance"), distance), 3, UPDATE_LIMIT)
        return
    }
    if kind == "LiquidBlock" {
        try liquid_tick(f, mut level, state, x, y, z)
        return
    }
    if kind == "BubbleColumnBlock" {
        let below = try level.state(f, x, y - 1, z)
        try update_column(f, mut level, x, y, z, state, below)
        return
    }
    let breaks = kind == "CactusBlock" or kind == "SugarCaneBlock" or kind == "GrowingPlantBlock" or kind == "BambooStalkBlock" or kind == "ChorusPlantBlock" or kind == "BigDripleafStemBlock" or kind == "HangingMossBlock"
    if breaks {
        // Hanging moss's `canStayAtPosition` is its `canSurvive`.
        if not try can_survive(e, level, state, x, y, z) {
            _ = try destroy_block(e, mut level, x, y, z, true, UPDATE_LIMIT)
        }
        return
    }
    if kind == "CoralBlock" {
        if not try touches_water(f, level, x, y, z) {
            _ = level.set_block_limited(x, y, z, f.default_state(try dead_coral(f, block)), 2, UPDATE_LIMIT)
        }
        return
    }
    if kind == "CoralPlantBlock" or kind == "CoralFanBlock" or kind == "CoralWallFanBlock" {
        // `BaseCoralPlantTypeBlock.scanForWater`: holding water, or water by it.
        if f.get_bool(state, "waterlogged") or try touches_water(f, level, x, y, z) {
            return
        }
        var dead = try f.with_bool(f.default_state(try dead_coral(f, block)), String("waterlogged"), false)
        if kind == "CoralWallFanBlock" {
            dead = try f.with_name(dead, String("facing"), f.get_name(state, "facing") ?? String("north"))
        }
        _ = level.set_block_limited(x, y, z, dead, 2, UPDATE_LIMIT)
        return
    }
    if kind == "FarmlandBlock" or kind == "PathBlock" {
        // `turnToBaseBlock`, to dirt, with `setBlockAndUpdate`. Entities aren't in the level yet,
        // so none is pushed up, and there are no game events.
        if kind == "PathBlock" or not try can_survive(e, level, state, x, y, z) {
            _ = level.set_block_limited(x, y, z, f.default_state(f.ids.dirt), 3, UPDATE_LIMIT)
        }
        return
    }
    if kind == "FireBlock" {
        try fire_tick(e, mut level, state, x, y, z)
        return
    }
    if kind == "ObserverBlock" {
        // Powered, with its tick to turn off 2 on, or off; then what's behind it told, with
        // flags 2 either way.
        if f.get_bool(state, "powered") {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", false), 2, UPDATE_LIMIT)
        } else {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", true), 2, UPDATE_LIMIT)
            level.schedule_block(block, x, y, z, 2, 0)
        }
        try update_in_front(f, mut level, state, x, y, z)
        return
    }
    if kind == "DiodeBlock" {
        // Unless it's locked: off where it's powered and its input's gone; on where it isn't,
        // with its tick to go off again its delay on, at a very high priority, where its input's
        // gone already. With flags 2, its `onPlace` tells what's in front.
        if try diode_locked(f, level, state, x, y, z) {
            return
        }
        let powered = f.get_bool(state, "powered")
        let on = try diode_input(f, level, state, x, y, z) > 0
        if powered and not on {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", false), 2, UPDATE_LIMIT)
        } else if not powered {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", true), 2, UPDATE_LIMIT)
            if not on {
                level.schedule_block(block, x, y, z, diode_delay(f, state), VERY_HIGH)
            }
        }
        return
    }
    if kind == "ComparatorBlock" {
        try comparator_refresh(f, mut level, state, x, y, z)
        return
    }
    if kind == "RedstoneLampBlock" {
        if f.get_bool(state, "lit") and not try has_neighbour_signal(f, level, x, y, z, true) {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "lit", false), 2, UPDATE_LIMIT)
        }
        return
    }
    if kind == "RedstoneTorchBlock" {
        try torch_tick(f, mut level, state, x, y, z)
        return
    }
    if kind == "DispenserBlock" {
        // `dispenseFrom`: an empty dispenser or dropper fails, with its event; what one with
        // something in it dispenses comes with items (CAL-124).
        if try holds_nothing(level, x, y, z) {
            level.level_event(DISPENSER_FAIL, x, y, z, 0)
            return
        }
        fail Thrown { exception: "Unimplemented", message: "What a dispenser dispenses" }
    }
    if kind == "CommandBlock" {
        // As its mode has it, a condition met when it was last checked runs it; a repeating one
        // checks again, and ticks again while it's powered or always active; then a comparator
        // reading it is told. Without a command it succeeds at nothing; a command run, or a chain
        // in front, comes with commands (CAL-124).
        if level.block_entity_tag(x, y, z) == none {
            return
        }
        let name = f.codec.blocks.name(block)
        let was_met = be_flag(level, x, y, z, "conditionMet")
        if name == "minecraft:repeating_command_block" {
            _ = try mark_condition_met(f, mut level, state, x, y, z)
            if was_met {
                try run_command_block(f, mut level, state, x, y, z)
            } else if f.get_bool(state, "conditional") {
                level.set_block_entity_value(x, y, z, "SuccessCount", Tag.Int(0))
            }
            if be_flag(level, x, y, z, "powered") or be_flag(level, x, y, z, "auto") {
                level.schedule_block(block, x, y, z, 1, 0)
            }
        } else if name == "minecraft:command_block" {
            if was_met {
                try run_command_block(f, mut level, state, x, y, z)
            } else if f.get_bool(state, "conditional") {
                level.set_block_entity_value(x, y, z, "SuccessCount", Tag.Int(0))
            }
        }
        try update_output_signal(f, mut level, block, x, y, z)
        return
    }
    if kind == "CrafterBlock" {
        // An empty crafter crafts nothing and fails, with its event; what one with something in it
        // crafts comes with recipes (CAL-124).
        if try holds_nothing(level, x, y, z) {
            level.level_event(CRAFTER_FAIL, x, y, z, 0)
            return
        }
        fail Thrown { exception: "Unimplemented", message: "What a crafter crafts" }
    }
    fail Thrown { exception: "Unimplemented", message: "tick of {kind}" }
}

// `ObserverBlock.updateNeighborsInFront` and `DiodeBlock`'s: the block behind it, the way it
// faces away from, told it changed, then the blocks around that but the one back toward it.
fn update_in_front<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let facing = try facing_of(f, state)
    let back = opposite(facing)
    let (fx, fy, fz) = (x + step_x(back), y + step_y(back), z + step_z(back))
    let block = f.block(state)
    level.neighbour_changed(fx, fy, fz, block)
    level.update_neighbours_except(fx, fy, fz, block, facing)
}

// `RedstoneTorchBlock.notifyNeighbors`: the blocks around each of the six beside it told, in
// `Direction`'s order.
fn torch_neighbours<L: BlockLevel>(level: mut L, block: u32, x: i32, y: i32, z: i32) {
    for d in 0..6 {
        level.update_neighbours(x + step_x(d), y + step_y(d), z + step_z(d), block)
    }
}

// `RedstoneTorchBlock.hasNeighborSignal`: whether what the torch is on gives it a signal, the
// block below, or behind a wall torch, `RedstoneWallTorchBlock`'s.
fn torch_powered<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if f.is_a(f.block(state), "RedstoneWallTorchBlock") {
        let back = opposite(try facing_of(f, state))
        return try has_signal(f, r, x + step_x(back), y + step_y(back), z + step_z(back), back, true)
    }
    return try has_signal(f, r, x, y - 1, z, DOWN, true)
}

// `RedstoneTorchBlock.tick`: the level's toggles more than 60 ticks old let go. A lit torch whose
// block is powered goes out, `setBlockAndUpdate`, and where that's its eighth toggle in 60 ticks
// it burns out, with the event its players see, and tries again 160 ticks on; one that's out,
// with nothing powering it, lights again unless it's toggled 8 times in that time.
fn torch_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let powered = try torch_powered(f, level, state, x, y, z)
    level.forget_toggles()
    if f.get_bool(state, "lit") {
        if powered {
            _ = level.set_block_limited(x, y, z, try f.with_bool(state, "lit", false), 3, UPDATE_LIMIT)
            if level.torch_toggled(x, y, z, true) {
                level.level_event(TORCH_BURNOUT, x, y, z, 0)
                let now = try level.state(f, x, y, z)
                level.schedule_block(f.block(now), x, y, z, 160, 0)
            }
        }
    } else if not powered and not level.torch_toggled(x, y, z, false) {
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "lit", true), 3, UPDATE_LIMIT)
    }
}

// `DiodeBlock.isLocked`: a repeater's, a diode at either side powering it; no other diode's.
fn diode_locked<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if f.signal_kind(f.block(state)) != SIGNAL_REPEATER {
        return false
    }
    return try repeater_locked(f, r, state, x, y, z)
}

// `DiodeBlock.getInputSignal`: the signal of the block behind it, the way it faces, toward it,
// or that wire's power where that's more.
fn diode_input<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let facing = try facing_of(f, state)
    let (bx, by, bz) = (x + step_x(facing), y + step_y(facing), z + step_z(facing))
    let s = try signal(f, r, bx, by, bz, facing, true)
    if s >= 15 {
        return s
    }
    let behind = try r.state(f, bx, by, bz)
    return s.max(if f.block(behind) == f.ids.redstone_wire { f.get_int(behind, "power") ?? 0 } else { 0 })
}

// `RepeaterBlock.getDelay`: twice its `delay`.
fn diode_delay(f: Facts, state: u32) -> i32 {
    return (f.get_int(state, "delay") ?? 1) * 2
}

// `DiodeBlock.checkTickOnNeighbor`, a repeater's: unless it's locked, where it's powered or
// not and its input says otherwise, its tick its delay on, unless one runs this tick: at an
// extremely high priority where it feeds a diode that doesn't face back into it,
// `shouldPrioritize`, a very high one where it's powered, else a high one. A comparator's comes
// with what it holds.
fn diode_check<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let block = f.block(state)
    if f.signal_kind(block) == SIGNAL_COMPARATOR {
        try comparator_check(f, mut level, state, x, y, z)
        return
    }
    if f.signal_kind(block) != SIGNAL_REPEATER {
        fail Thrown { exception: "Unimplemented", message: "neighborChanged of {f.class_name(block)}" }
    }
    if try diode_locked(f, level, state, x, y, z) {
        return
    }
    let powered = f.get_bool(state, "powered")
    let on = try diode_input(f, level, state, x, y, z) > 0
    if powered == on or level.will_tick_this_tick(block, x, y, z) {
        return
    }
    var priority = HIGH
    if try diode_prioritized(f, level, state, x, y, z) {
        priority = EXTREMELY_HIGH
    } else if powered {
        priority = VERY_HIGH
    }
    level.schedule_block(block, x, y, z, diode_delay(f, state), priority)
}

// `DiodeBlock.shouldPrioritize`: whether the block in front of the diode is a diode that doesn't
// face back into it.
fn diode_prioritized<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let front = opposite(try facing_of(f, state))
    let ahead = try r.state(f, x + step_x(front), y + step_y(front), z + step_z(front))
    let kind = f.signal_kind(f.block(ahead))
    return (kind == SIGNAL_REPEATER or kind == SIGNAL_COMPARATOR) and try facing_of(f, ahead) != front
}

// `ComparatorBlock.checkTickOnNeighbor`: unless its tick runs this tick, where what it would put
// out isn't what it holds, or it's powered or not and should be otherwise, its tick 2 on, at a
// high priority where it feeds a diode that doesn't face back into it, else a normal one.
fn comparator_check<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let block = f.block(state)
    if level.will_tick_this_tick(block, x, y, z) {
        return
    }
    let out = try comparator_signal(f, level, state, x, y, z)
    if out == comparator_output(level, x, y, z) and f.get_bool(state, "powered") == try comparator_on(f, level, state, x, y, z) {
        return
    }
    let priority = if try diode_prioritized(f, level, state, x, y, z) { HIGH } else { NORMAL }
    level.schedule_block(block, x, y, z, 2, priority)
}

// `ComparatorBlock.refreshOutputState`, its tick: what it puts out worked out and held. Where that
// changed, or it compares, it's powered or unpowered as it should be, with flags 2, and what's in
// front told.
fn comparator_refresh<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let out = try comparator_signal(f, level, state, x, y, z)
    let old = comparator_output(level, x, y, z)
    level.set_comparator_output(x, y, z, out)
    if old == out and (f.get_name(state, "mode") ?? String()) != "compare" {
        return
    }
    let on = try comparator_on(f, level, state, x, y, z)
    let powered = f.get_bool(state, "powered")
    if powered and not on {
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", false), 2, UPDATE_LIMIT)
    } else if not powered and on {
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", true), 2, UPDATE_LIMIT)
    }
    try update_in_front(f, mut level, state, x, y, z)
}

// `ComparatorBlock.calculateOutputSignal`: none without an input or with more at a side; else the
// input, less what's at the sides where it subtracts.
fn comparator_signal<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let input = try comparator_input(f, r, state, x, y, z)
    if input == 0 {
        return 0
    }
    let side = try comparator_sides(f, r, state, x, y, z)
    if side > input {
        return 0
    }
    return if (f.get_name(state, "mode") ?? String()) == "subtract" { input - side } else { input }
}

// `ComparatorBlock.shouldTurnOn`: an input more than what's at the sides, or as much where it
// compares.
fn comparator_on<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let input = try comparator_input(f, r, state, x, y, z)
    if input == 0 {
        return false
    }
    let side = try comparator_sides(f, r, state, x, y, z)
    if input > side {
        return true
    }
    return input == side and (f.get_name(state, "mode") ?? String()) == "compare"
}

// `ComparatorBlock.getInputSignal`: what the block behind it gives, as a diode's input, or what a
// comparator reads of it where it has that, `getAnalogOutputSignal`. Under 15, through a redstone
// conductor behind it, what it reads of the block past that instead, where it has that. An item
// frame on the conductor's far side is an entity, which Calcite's level doesn't have yet.
fn comparator_input<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let s = try diode_input(f, r, state, x, y, z)
    let facing = try facing_of(f, state)
    let (bx, bz) = (x + step_x(facing), z + step_z(facing))
    let behind = try r.state(f, bx, y, bz)
    if f.has_analog_output(f.block(behind)) {
        return try analog_output(f, r, behind, bx, y, bz, opposite(facing))
    }
    if s < 15 and f.redstone_conductor(behind) {
        let (px, pz) = (bx + step_x(facing), bz + step_z(facing))
        let past = try r.state(f, px, y, pz)
        if f.has_analog_output(f.block(past)) {
            return try analog_output(f, r, past, px, y, pz, opposite(facing))
        }
    }
    return s
}

// `DiodeBlock.getAlternateSignal`: the most its two sides give it, clockwise first, as
// `getControlInputSignal` reads them, from any source.
fn comparator_sides<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let cw = clockwise(try facing_of(f, state))
    let ccw = opposite(cw)
    let a = try control_input(f, r, x + step_x(cw), y, z + step_z(cw), cw, false, true)
    let b = try control_input(f, r, x + step_x(ccw), y, z + step_z(ccw), ccw, false, true)
    return a.max(b)
}

// `DefaultRedstoneWireEvaluator.updatePowerStrength`: where the power the wire at x, y, z should
// have, `calculateTargetStrength`, isn't `state`'s, it's set, with flags 2, if the wire's still
// `state`, and the blocks around it and the six beside it told, in the order a `HashSet` of them
// gives.
fn wire_power<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let target = try wire_target(f, level, x, y, z)
    if (f.get_int(state, "power") ?? 0) == target {
        return
    }
    if try level.state(f, x, y, z) == state {
        _ = level.set_block_limited(x, y, z, try f.with_int(state, "power", target), 2, UPDATE_LIMIT)
    }
    let wire = f.ids.redstone_wire
    for (px, py, pz) in hash_set_order(x, y, z) {
        level.update_neighbours(px, py, pz, wire)
    }
}

// `calculateTargetStrength`: the most the blocks around give it, read with wire not signalling,
// `getBlockSignal`, or, under 15, the most of that and the wire beside it, one less,
// `getIncomingWireSignal`.
fn wire_target<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let s = try best_neighbour_signal(f, r, x, y, z, false)
    if s == 15 {
        return 15
    }
    return s.max(try incoming_wire(f, r, x, y, z))
}

// `RedstoneWireEvaluator.getIncomingWireSignal`: the most power of the wire beside it, in
// `Direction.Plane.HORIZONTAL`'s order, and above that where it conducts and what's above this
// doesn't, or below it where it doesn't, one less.
fn incoming_wire<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    var most = 0
    for i in 0..4 {
        let d = horizontal(i)
        let (nx, nz) = (x + step_x(d), z + step_z(d))
        let next = try r.state(f, nx, y, nz)
        most = most.max(wire_power_of(f, next))
        if f.redstone_conductor(next) {
            if not f.redstone_conductor(try r.state(f, x, y + 1, z)) {
                most = most.max(wire_power_of(f, try r.state(f, nx, y + 1, nz)))
            }
        } else {
            most = most.max(wire_power_of(f, try r.state(f, nx, y - 1, nz)))
        }
    }
    return (most - 1).max(0)
}

// `getWireSignal`: the state's power if it's wire, else 0.
fn wire_power_of(f: Facts, state: u32) -> i32 {
    if f.block(state) != f.ids.redstone_wire {
        return 0
    }
    return f.get_int(state, "power") ?? 0
}

// The block at x, y, z and the six beside it, added in `Direction`'s order to a `HashSet` of 16
// buckets, as it iterates them: by the bucket each one's `Vec3i.hashCode`, spread as
// `HashMap.hash` spreads it, falls in, then in the order they came within one.
fn hash_set_order(x: i32, y: i32, z: i32) -> List<(i32, i32, i32)> {
    var all = List<(i32, i32, i32)>()
    all.push((x, y, z))
    for d in 0..6 {
        all.push((x + step_x(d), y + step_y(d), z + step_z(d)))
    }
    var out = List<(i32, i32, i32)>()
    for bucket in 0u32..16 {
        for (px, py, pz) in all {
            if bucket_of(px, py, pz) == bucket {
                out.push((px, py, pz))
            }
        }
    }
    return out
}

// The bucket of 16 a `HashSet` puts the position at x, y, z in.
fn bucket_of(x: i32, y: i32, z: i32) -> u32 {
    let h = u32.wrap((i64(y) + i64(z) * 31) * 31 + i64(x))
    return (h ^ (h >> 16)) & 15
}

// `updateNeighborsOfNeighboringWires`: each wire beside it, then each above or below the blocks
// beside it, above where that conducts, `checkCornerChangeAt`.
fn wire_neighbours_of_wires<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, wire: u32, x: i32, y: i32, z: i32) ! Thrown {
    for i in 0..4 {
        let d = horizontal(i)
        try corner_change(f, mut level, wire, x + step_x(d), y, z + step_z(d))
    }
    for i in 0..4 {
        let d = horizontal(i)
        let (nx, nz) = (x + step_x(d), z + step_z(d))
        if f.redstone_conductor(try level.state(f, nx, y, nz)) {
            try corner_change(f, mut level, wire, nx, y + 1, nz)
        } else {
            try corner_change(f, mut level, wire, nx, y - 1, nz)
        }
    }
}

// `checkCornerChangeAt`: where there's wire at x, y, z, the blocks around it and around each of
// the six beside it told.
fn corner_change<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, wire: u32, x: i32, y: i32, z: i32) ! Thrown {
    if f.block(try level.state(f, x, y, z)) != wire {
        return
    }
    level.update_neighbours(x, y, z, wire)
    for d in 0..6 {
        level.update_neighbours(x + step_x(d), y + step_y(d), z + step_z(d), wire)
    }
}

/// `BaseFireBlock.getState`: the fire set at `x`, `y`, `z` as it's placed there, soul fire on
/// what soul fire burns on, else fire with the sides it burns on, as
/// `FireBlock.getStateForPlacement` has them (D339).
pub fn fire_state<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> u32 ! Thrown {
    return try fire_with_age(f, r, x, y, z, 0)
}

// `FireBlock.getFireTickDelay`: 30 and a draw of 10.
fn fire_delay<L: RandomSource>(level: mut L) -> i32 {
    return 30 + level.next_int_below(10)
}

// `BaseFireBlock.onPlace`: nothing where the block was this fire already. In the Overworld and the
// Nether, inside an empty frame of obsidian, `PortalShape.findEmptyPortalShape`, along `x` and
// then `z`, it lights a portal, `createPortalBlocks`. Else it goes where it can't stay,
// `removeBlock`.
fn fire_placed<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, old: u32) ! Thrown {
    let Env { facts: f, .. } = e
    if f.block(old) == f.block(state) {
        return
    }
    if level.portals_light() {
        var shape = try find_any_shape(e, level, x, y, z, true)
        if not shape.is_valid() or shape.portal_blocks != 0 {
            shape = try find_any_shape(e, level, x, y, z, false)
        }
        if shape.is_valid() and shape.portal_blocks == 0 {
            try light_portal(f, mut level, shape)
            return
        }
    }
    if not try can_survive(e, level, state, x, y, z) {
        _ = try remove_block(f, mut level, x, y, z)
    }
}

// `PortalShape.createPortalBlocks`: the frame's inside made portal along its axis, each block set
// with flags 18, in `BlockPos.betweenClosed`'s order, `x` fastest, then `y`, then `z`, each from
// its least.
fn light_portal<L: BlockLevel>(f: Facts, level: mut L, s: PortalShape) ! Thrown {
    let axis = if s.along_x { "x" } else { "z" }
    let portal = try f.with_name(f.default_state(f.ids.nether_portal), String("axis"), String(axis))
    let far_x = s.x + step_x(s.right) * (s.width - 1)
    let far_z = s.z + step_z(s.right) * (s.width - 1)
    for pz in s.z.min(far_z)..s.z.max(far_z) + 1 {
        for py in s.y..s.y + s.height {
            for px in s.x.min(far_x)..s.x.max(far_x) + 1 {
                _ = level.set_block_limited(px, py, pz, portal, 18, UPDATE_LIMIT)
            }
        }
    }
}

// `FireBlock.tick` (D339): its next tick, drawn. Then, where fire spreads: it goes where it can't
// stay, and goes on all the same. Unless what's below burns forever, the dimension's
// `infiniburn`, it may go out in the rain, more likely as it ages. It ages, a draw of 3 halved,
// set with flags 260. Unless what's below burns forever, it goes with nothing by it to burn,
// unless it's young on a sturdy top, and at 15 one time in four over what won't burn. Then each
// block beside it may burn, `checkBurnOut`, those beside it 300 to 1, those above and below 250,
// 50 fewer in a biome with `INCREASED_FIRE_BURNOUT`; and the air around it, a block either way and
// one down to four up, each 100 to 1 more above the first, may catch, by the most of what's
// beside that air may, the difficulty, and its age, half as likely where burnout is increased,
// and not in the rain.
fn fire_tick<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    let delay = fire_delay(mut level)
    level.schedule_block(f.block(state), x, y, z, delay, 0)
    if not level.fire_spreads(x, y, z) {
        return
    }
    if not try can_survive(e, level, state, x, y, z) {
        _ = try remove_block(f, mut level, x, y, z)
    }
    let forever = f.in_set(try level.state(f, x, y - 1, z), f.tag(level.infiniburn()))
    let age = f.get_int(state, String("age")) ?? 0
    if not forever and level.raining() and try near_rain(level, x, y, z) and level.next_float() < 0.2f32 + f32.nearest(age) * 0.03f32 {
        _ = try remove_block(f, mut level, x, y, z)
        return
    }
    let aged = (age + level.next_int_below(3) / 2).min(15)
    if aged != age {
        _ = level.set_block_limited(x, y, z, try f.with_int(state, String("age"), aged), 260, UPDATE_LIMIT)
    }
    if not forever {
        if not try fire_location(f, level, x, y, z) {
            if not f.sturdy(try level.state(f, x, y - 1, z), UP, FULL) or age > 3 {
                _ = try remove_block(f, mut level, x, y, z)
            }
            return
        }
        if age == 15 and level.next_int_below(4) == 0 and not f.can_burn(try level.state(f, x, y - 1, z)) {
            _ = try remove_block(f, mut level, x, y, z)
            return
        }
    }
    let burnout = level.fire_burnout(x, y, z)
    let fewer = if burnout { 50 } else { 0 }
    try burn_out(f, mut level, x + 1, y, z, 300 - fewer, age)
    try burn_out(f, mut level, x - 1, y, z, 300 - fewer, age)
    try burn_out(f, mut level, x, y - 1, z, 250 - fewer, age)
    try burn_out(f, mut level, x, y + 1, z, 250 - fewer, age)
    try burn_out(f, mut level, x, y, z - 1, 300 - fewer, age)
    try burn_out(f, mut level, x, y, z + 1, 300 - fewer, age)
    let difficulty = level.difficulty()
    for dx in -1..2 {
        for dz in -1..2 {
            for dy in -1..5 {
                if dx == 0 and dy == 0 and dz == 0 {
                    continue
                }
                let rate = if dy > 1 { 100 + (dy - 1) * 100 } else { 100 }
                let (tx, ty, tz) = (x + dx, y + dy, z + dz)
                let ignite = try ignite_odds_at(f, level, tx, ty, tz)
                if ignite <= 0 {
                    continue
                }
                var odds = (ignite + 40 + difficulty * 7) / (age + 30)
                if burnout {
                    odds /= 2
                }
                if odds > 0 and level.next_int_below(rate) <= odds and not (level.raining() and try near_rain(level, tx, ty, tz)) {
                    let spread = (age + level.next_int_below(5) / 4).min(15)
                    let fire = try fire_with_age(f, level, tx, ty, tz, spread)
                    _ = level.set_block_limited(tx, ty, tz, fire, 3, UPDATE_LIMIT)
                }
            }
        }
    }
}

// `FireBlock.checkBurnOut`: the block at `x`, `y`, `z` burns where a draw of `chance` is under its
// burn odds. Five times in its age and ten, where it isn't raining on it, it's fire, a fourth of a
// draw of 5 older than the fire `age` by it; else it's gone, `removeBlock`. TNT that burns is
// primed, which comes with entities.
fn burn_out<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, chance: i32, age: i32) ! Thrown {
    let odds = f.burn_odds(try level.state(f, x, y, z))
    if level.next_int_below(chance) >= odds {
        return
    }
    let old = try level.state(f, x, y, z)
    if level.next_int_below(age + 10) < 5 and not try level.raining_at(x, y, z) {
        let older = (age + level.next_int_below(5) / 4).min(15)
        let fire = try fire_with_age(f, level, x, y, z, older)
        _ = level.set_block_limited(x, y, z, fire, 3, UPDATE_LIMIT)
    } else {
        _ = try remove_block(f, mut level, x, y, z)
    }
    if f.is_a(f.block(old), "TntBlock") {
        level.unimplemented(String("TNT that fire primes"))
    }
}

// `FireBlock.isNearRain`: rain on the block, or on the block west, east, north or south of it.
fn near_rain<L: BlockLevel>(level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    return try level.raining_at(x, y, z) or try level.raining_at(x - 1, y, z) or try level.raining_at(x + 1, y, z) or try level.raining_at(x, y, z - 1) or try level.raining_at(x, y, z + 1)
}

// `FireBlock.isValidFireLocation`: something fire burns on one of the six sides of `x`, `y`, `z`.
fn fire_location<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> bool ! Thrown {
    for d in 0..6 {
        if f.can_burn(try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))) {
            return true
        }
    }
    return false
}

// `FireBlock.getIgniteOdds(level, pos)`: 0 where the block isn't air, `isEmptyBlock`; else the
// most of the ignite odds of the six beside it.
fn ignite_odds_at<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    if not f.is_air(try r.state(f, x, y, z)) {
        return 0
    }
    var most = 0
    for d in 0..6 {
        most = most.max(f.ignite_odds(try r.state(f, x + step_x(d), y + step_y(d), z + step_z(d))))
    }
    return most
}

// The dead coral a coral block, plant or fan becomes, its `deadBlock`: `dead_` and its name.
fn dead_coral(f: Facts, block: u32) -> u32 ! Thrown {
    let name = f.codec.blocks.name(block)
    let path = name[10..]
    return try f.named_block("dead_{path}")
}

/// `LiquidBlock.tick`, which a liquid's block runs as its scheduled tick and as its chunk starts
/// ticking: a full source of a fluid a bubble column can be in, its block `state` as it was, makes
/// the column the block below it makes, `BubbleColumnBlock.updateColumn` (D335).
pub fn liquid_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    // `shouldBubbleColumnOccupy`.
    if not f.fluid_in(state, "minecraft:bubble_column_can_occupy") or not f.is_source(state) or f.fluid_amount(state) != 8 {
        return
    }
    let below = try level.state(f, x, y - 1, z)
    let here = try level.state(f, x, y, z)
    try update_column(f, mut level, x, y, z, here, below)
}

// `BubbleColumnBlock.updateColumn`: where the block at `x`, `y`, `z`, `here`, can hold a bubble
// column, it's set, with flags 2, to what `below` makes of it, `getColumnState`: below's own
// column; a column pushing up over what pushes up, or dragging down over what drags down; water,
// where a column has nothing below to keep it; else as it is. Then each block above that can hold
// a column is set the same, up to the first that can't, or that's already that.
fn update_column<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32, here: u32, below: u32) ! Thrown {
    let column = try f.named_block("bubble_column")
    if not can_occupy(f, column, here) {
        return
    }
    var made = here
    if f.is(below, column) {
        made = below
    } else if f.in_set(below, f.tag("minecraft:enables_bubble_column_push_up")) {
        made = try f.with_bool(f.default_state(column), String("drag"), false)
    } else if f.in_set(below, f.tag("minecraft:enables_bubble_column_drag_down")) {
        made = try f.with_bool(f.default_state(column), String("drag"), true)
    } else if f.is(here, column) {
        made = f.ids.water_state
    }
    _ = level.set_block_limited(x, y, z, made, 2, UPDATE_LIMIT)
    var above = y + 1
    while can_occupy(f, column, try level.state(f, x, above, z)) {
        if not level.set_block_limited(x, above, z, made, 2, UPDATE_LIMIT) {
            return
        }
        above += 1
    }
}

// `LiquidBlock.onPlace` and `neighborChanged`, which do the same: unless lava turns to stone, its
// fluid's tick; and over a block that makes a bubble column, a source's block's tick a second on.
fn liquid_changed<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    if try should_spread(e, mut level, state, x, y, z) {
        level.schedule_fluid(f.fluid(state), x, y, z)
    }
    // `shouldBubbleColumnOccupy`, then `tryScheduleBubbleBlockColumn`.
    if f.fluid_in(state, "minecraft:bubble_column_can_occupy") and f.is_source(state) and f.fluid_amount(state) == 8 {
        let below = try level.state(f, x, y - 1, z)
        if f.in_set(below, f.tag("minecraft:enables_bubble_column_drag_down")) or f.in_set(below, f.tag("minecraft:enables_bubble_column_push_up")) {
            level.schedule_block(f.block(state), x, y, z, 20, 0)
        }
    }
}

// `LiquidBlock.shouldSpreadLiquid`: lava beside water turns to obsidian if it's a source and to
// cobblestone if it isn't, and lava over soul soil beside blue ice to basalt, each with a fizz,
// and doesn't spread; anything else spreads. Each way it could flow is looked at from the block
// it would flow from.
fn should_spread<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if not f.fluid_in(state, "minecraft:lava") {
        return true
    }
    let soul_soil = f.is(try level.state(f, x, y - 1, z), f.ids.soul_soil)
    var i = 0
    while i < 5 {
        let d = opposite(flow_direction(i))
        let there = try level.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        if f.fluid_in(there, "minecraft:water") {
            let into = if f.is_source(try level.state(f, x, y, z)) { f.ids.obsidian } else { f.ids.cobblestone }
            _ = level.set_block_limited(x, y, z, f.default_state(into), 3, 512)
            level.level_event(LAVA_FIZZ, x, y, z, 0)
            return false
        }
        if soul_soil and f.is(there, f.ids.blue_ice) {
            _ = level.set_block_limited(x, y, z, f.default_state(f.ids.basalt), 3, 512)
            level.level_event(LAVA_FIZZ, x, y, z, 0)
            return false
        }
        i += 1
    }
    return true
}
