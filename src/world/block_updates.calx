/// What a block does as it's set and as the blocks around it change, in the server's level:
/// vanilla's `onPlace`, `affectNeighborsAfterRemoval` and `neighborChanged`, each as the class
/// that declares it runs it (D325), and `Block.updateOrDestroy` and `Level.destroyBlock`, which a
/// shape update ends in (D326). The order the blocks around are told in is the level's, as
/// `CollectingNeighborUpdater` keeps it. A class Calcite doesn't have yet throws
/// `Unimplemented`, which the level reports once and goes on past, leaving the block as it is.
module world.block_updates

import random.source.{RandomSource}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, EAST, EMPTY_FLUID, Facts, NORTH, SOUTH, UP, WEST, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.shapes.{coral_die_tick}
import worldgen.survive.{Env}

/// `levelEvent`'s types: a block broken, as `spawnDestroyParticles` sends it, with the state's
/// ID; a straw bed broken; and lava fizzing as water meets it.
pub const BLOCK_BROKEN: i32 = 2001
pub const STRAW_BED_BROKEN: i32 = 2014
pub const LAVA_FIZZ: i32 = 1501

/// `NeighborUpdater.UPDATE_ORDER`, the order the six blocks around one are told it changed: its
/// `i`th.
pub fn update_order(i: i32) -> i32 {
    return match i {
        0 => WEST,
        1 => EAST,
        2 => DOWN,
        3 => UP,
        4 => NORTH,
        _ => SOUTH,
    }
}

/// `BlockBehaviour.UPDATE_SHAPE_ORDER`, the order the six blocks around one are told its shape:
/// its `i`th.
pub fn shape_order(i: i32) -> i32 {
    return match i {
        0 => WEST,
        1 => EAST,
        2 => NORTH,
        3 => SOUTH,
        4 => DOWN,
        _ => UP,
    }
}

// `LiquidBlock.POSSIBLE_FLOW_DIRECTIONS`: its `i`th.
fn flow_direction(i: i32) -> i32 {
    return match i {
        0 => DOWN,
        1 => SOUTH,
        2 => NORTH,
        3 => EAST,
        _ => WEST,
    }
}

/// A level whose blocks change as vanilla's do: set, telling the blocks around, with the events
/// its players see.
pub interface BlockLevel {
    /// `setBlock(pos, state, flags, limit)`: whether the block at `x`, `y`, `z` was set to
    /// `state`, telling the blocks around as `flags` say, the shapes `limit` deep at most.
    fn set_block_limited(mut self, x: i32, y: i32, z: i32, state: u32, flags: i32, limit: i32) -> bool
    /// `levelEvent(kind, pos, data)`: an event the players within 64 blocks of `x`, `y`, `z` are
    /// sent.
    fn level_event(mut self, kind: i32, x: i32, y: i32, z: i32, data: i32)
    /// Says once that `what` isn't in Calcite yet, and goes on without it.
    fn unimplemented(mut self, what: String)
}

/// `BlockState.onPlace`: what the block `state` does as it's set at `x`, `y`, `z` where `old`
/// was, `moved` if a piston moved it.
pub fn on_place<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, _old: u32, _moved: bool) ! Thrown {
    let Env { facts: f, .. } = e
    let block = f.block(state)
    let kind = f.place_class(block)
    if kind == "BlockBehaviour" {
        return
    }
    if kind == "LiquidBlock" {
        try liquid_changed(e, mut level, state, x, y, z)
        return
    }
    if kind == "FallingBlock" {
        // `getDelayAfterPlace`: 2, or the dragon egg's 5.
        level.schedule_block(block, x, y, z, if block == f.ids.dragon_egg { 5 } else { 2 }, 0)
        return
    }
    if kind == "BrushableBlock" {
        level.schedule_block(block, x, y, z, 2, 0)
        return
    }
    if kind == "ScaffoldingBlock" {
        level.schedule_block(block, x, y, z, 1, 0)
        return
    }
    if kind == "CoralPlantBlock" or kind == "CoralFanBlock" or kind == "CoralWallFanBlock" {
        // `tryScheduleDieTick`, drawing from the level's random.
        try coral_die_tick(f, mut level, state, x, y, z)
        return
    }
    fail Thrown { exception: "Unimplemented", message: "onPlace of {kind}" }
}

/// `BlockState.affectNeighborsAfterRemoval`: what the block `old`, replaced at `x`, `y`, `z`,
/// does to the blocks around, `moved` if a piston moved it.
pub fn after_removal<L: BlockAccess + BlockLevel + RandomSource>(e: Env, _level: L, old: u32, _x: i32, _y: i32, _z: i32, _moved: bool) ! Thrown {
    let Env { facts: f, .. } = e
    let kind = f.removal_class(f.block(old))
    if kind == "BlockBehaviour" {
        return
    }
    fail Thrown { exception: "Unimplemented", message: "affectNeighborsAfterRemoval of {kind}" }
}

/// `BlockState.handleNeighborChanged`, its block's `neighborChanged`: what the block `state` at
/// `x`, `y`, `z` does as the block `source` beside it changes, `moved` if a piston moved it.
pub fn on_neighbour_changed<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, _source: u32, _moved: bool) ! Thrown {
    let Env { facts: f, .. } = e
    let kind = f.neighbour_class(f.block(state))
    if kind == "BlockBehaviour" {
        return
    }
    if kind == "LiquidBlock" {
        try liquid_changed(e, mut level, state, x, y, z)
        return
    }
    fail Thrown { exception: "Unimplemented", message: "neighborChanged of {kind}" }
}

// `LiquidBlock.onPlace` and `neighborChanged`, which do the same: unless lava turns to stone, its
// fluid's tick; and over a block that makes a bubble column, a source's block's tick a second on.
fn liquid_changed<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    if try should_spread(e, mut level, state, x, y, z) {
        level.schedule_fluid(f.fluid(state), x, y, z)
    }
    // `shouldBubbleColumnOccupy`, then `tryScheduleBubbleBlockColumn`.
    if f.fluid_in(state, "minecraft:bubble_column_can_occupy") and f.is_source(state) and f.fluid_amount(state) == 8 {
        let below = try level.state(f, x, y - 1, z)
        if f.in_set(below, f.tag("minecraft:enables_bubble_column_drag_down")) or f.in_set(below, f.tag("minecraft:enables_bubble_column_push_up")) {
            level.schedule_block(f.block(state), x, y, z, 20, 0)
        }
    }
}

// `LiquidBlock.shouldSpreadLiquid`: lava beside water turns to obsidian if it's a source and to
// cobblestone if it isn't, and lava over soul soil beside blue ice to basalt, each with a fizz,
// and doesn't spread; anything else spreads. Each way it could flow is looked at from the block
// it would flow from.
fn should_spread<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if not f.fluid_in(state, "minecraft:lava") {
        return true
    }
    let soul_soil = f.is(try level.state(f, x, y - 1, z), f.ids.soul_soil)
    var i = 0
    while i < 5 {
        let d = opposite(flow_direction(i))
        let there = try level.state(f, x + step_x(d), y + step_y(d), z + step_z(d))
        if f.fluid_in(there, "minecraft:water") {
            let into = if f.is_source(try level.state(f, x, y, z)) { f.ids.obsidian } else { f.ids.cobblestone }
            _ = level.set_block_limited(x, y, z, f.default_state(into), 3, 512)
            level.level_event(LAVA_FIZZ, x, y, z, 0)
            return false
        }
        if soul_soil and f.is(there, f.ids.blue_ice) {
            _ = level.set_block_limited(x, y, z, f.default_state(f.ids.basalt), 3, 512)
            level.level_event(LAVA_FIZZ, x, y, z, 0)
            return false
        }
        i += 1
    }
    return true
}

/// `Block.updateOrDestroy`: the block at `x`, `y`, `z`, `old`, made `new` as its shape changed,
/// or broken if `new` is air, with `flags` and `limit`.
pub fn update_or_destroy<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, old: u32, new: u32, x: i32, y: i32, z: i32, flags: i32, limit: i32) ! Thrown {
    if new == old {
        return
    }
    let Env { facts: f, .. } = e
    if f.is_air(new) {
        _ = try destroy_block(e, mut level, x, y, z, flags & 32 == 0, limit)
        return
    }
    _ = level.set_block_limited(x, y, z, new, flags & -33, limit)
}

/// `Level.destroyBlock`: the block at `x`, `y`, `z` broken, with what its players see, unless
/// it's fire, and left as the fluid it held, with what it drops if `drop`, which comes with
/// items. Whether it was broken.
pub fn destroy_block<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, drop: bool, limit: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let state = try level.state(f, x, y, z)
    if f.is_air(state) {
        return false
    }
    // `spawnDestroyParticles`, which a straw bed and fire have their own of.
    let block = f.block(state)
    if f.is_a(block, "StrawBedBlock") {
        level.level_event(STRAW_BED_BROKEN, x, y, z, i32.wrap(state))
    } else if not f.is_a(block, "BaseFireBlock") {
        level.level_event(BLOCK_BROKEN, x, y, z, i32.wrap(state))
    }
    if drop {
        level.unimplemented(String("What a broken block drops"))
    }
    return level.set_block_limited(x, y, z, legacy_block(f, state), 3, limit)
}

// `FluidState.createLegacyBlock` of the fluid the block `state` holds: air for none, a liquid's
// own state for a liquid, and a source's block for a block that holds water.
fn legacy_block(f: Facts, state: u32) -> u32 {
    if f.fluid(state) == EMPTY_FLUID {
        return f.ids.air_state
    }
    let block = f.block(state)
    if block == f.ids.water or block == f.ids.lava {
        return state
    }
    return if f.is_lava(state) { f.ids.lava_state } else { f.ids.water_state }
}
