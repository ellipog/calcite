/// A player's statistics, as vanilla's `ServerStatsCounter` keeps them (CAL-164): each stat's
/// count by the stat's name, `Stat.buildName`, such as `minecraft.custom:minecraft.play_time`, in
/// an `Object2IntOpenHashMap`, whose hash is the name's, as `Stat.hashCode` is, so they come out in
/// vanilla's order; and the names of those set since they were last sent, `dirty`. Read from the
/// player's file in `players/stats` and saved to it as `STATS_CODEC` reads and writes it, and sent
/// as `sendStats` sends them.
module world.stats

import json.gson.{JsonWriter, int_value}
import json.tree.{Json, Member}
import registry.components.{ItemCodecs}
import resources.identifier.{Identifier}
import server.log.{Entry}

/// The most a count holds, an `int`'s.
const MOST: i64 = 2147483647

/// The stat types, `BuiltInRegistries.STAT_TYPE` in its order, each with the built-in registry its
/// values are of, `getRegistry`.
pub fn stat_types() -> List<(String, String)> {
    return [
        (String("minecraft:mined"), String("block")),
        (String("minecraft:crafted"), String("item")),
        (String("minecraft:used"), String("item")),
        (String("minecraft:broken"), String("item")),
        (String("minecraft:picked_up"), String("item")),
        (String("minecraft:dropped"), String("item")),
        (String("minecraft:killed"), String("entity_type")),
        (String("minecraft:killed_by"), String("entity_type")),
        (String("minecraft:custom"), String("custom_stat")),
    ]
}

/// The registry the values of the stat type `kind`, a whole ID, are of, or `none` where it isn't
/// one.
pub fn registry_of(kind: String) -> String? {
    for (k, registry) in stat_types() {
        if k == kind {
            return some(registry.copy())
        }
    }
    return none
}

/// `Stat.buildName` of the stat of the type `kind` and the value `value`, both whole IDs: each with
/// its `:` as `.`, `locationToKey`, joined by a `:`.
pub fn stat_name(kind: String, value: String) -> String {
    return "{dotted(kind)}:{dotted(value)}"
}

// `locationToKey` of a whole ID: its first `:` as a `.`, as an ID has only the one.
fn dotted(id: String) -> String {
    if let c = id.find(":") {
        return "{id[..c]}.{id[c + 1..]}"
    }
    return id.copy()
}

/// A stat and its count: its type's whole ID, such as `minecraft:custom`, its value's, such as
/// `minecraft:play_time`, and the count.
pub struct Counted {
    pub kind: String
    pub value: String
    pub count: i32
}

/// A player's statistics.
pub struct PlayerStats {
    /// The file they were read from and are saved to, as `locateStatsFile` found it, `file`;
    /// empty for none, as in a replay, which saves none.
    pub file: String = String()
    // `stats`, each stat by its name.
    stats: OpenHashMap<String, Counted> = OpenHashMap<String, Counted>()
    // `dirty`, the names of those set since they were last sent, in a `HashSet`.
    dirty: JavaHashSet<String> = JavaHashSet<String>()
    /// Whether what's awarded is kept for the scoreboard, whose objectives may count it, as
    /// `awardStat` and `resetStat` give it to `forAllObjectives` (CAL-164).
    pub scoring: bool = false
    // What's been awarded or reset since it was last taken, as the scoreboard's to have it: each
    // stat's name, with how many more, or none where it was reset.
    scored: List<(String, i32?)> = List<(String, i32?)>()
}

impl PlayerStats {
    /// `getValue` of the stat of the type `kind` and the value `value`: its count, or 0.
    pub fn value(self, kind: String, value: String) -> i32 {
        let name = stat_name(kind, value)
        if self.stats.contains(name) {
            return self.stats[name].count
        }
        return 0
    }

    /// `ServerStatsCounter.setValue`: the stat's count set to `count`, and it marked to be sent.
    pub fn set(mut self, kind: String, value: String, count: i32) {
        let name = stat_name(kind.copy(), value.copy())
        if self.stats.contains(name) {
            self.stats[name].count = count
        } else {
            self.stats.insert(name.copy(), Counted { kind: kind.copy(), value: value.copy(), count: count })
        }
        self.dirty.insert(name)
    }

    /// `increment`: the stat's count `by` more, no more than an int holds, as a long it's cut to.
    pub fn award(mut self, kind: String, value: String, by: i32) {
        if self.scoring {
            self.scored.push((stat_name(kind.copy(), value.copy()), some(by)))
        }
        let sum = i64(self.value(kind.copy(), value.copy())) + i64(by)
        self.set(kind, value, i32.wrap(if sum > MOST { MOST } else { sum }))
    }

    /// `awardStat` of the custom stat `minecraft:{name}`, `Stats.CUSTOM`, `by` more.
    pub fn award_custom(mut self, name: str, by: i32) {
        self.award(String("minecraft:custom"), "minecraft:{name}", by)
    }

    /// `resetStat` of the custom stat `minecraft:{name}`: its count set to 0.
    pub fn reset_custom(mut self, name: str) {
        if self.scoring {
            self.scored.push((stat_name(String("minecraft:custom"), "minecraft:{name}"), none))
        }
        self.set(String("minecraft:custom"), "minecraft:{name}", 0)
    }

    /// Whether anything's been awarded or reset for the scoreboard since it was last taken.
    pub fn has_scored(self) -> bool {
        return not self.scored.is_empty()
    }

    /// What's been awarded or reset for the scoreboard, in turn, and none kept any more: each
    /// stat's name, with how many more, or none where it was reset.
    pub fn take_scored(mut self) -> List<(String, i32?)> {
        let out = self.scored.copy()
        self.scored.clear()
        return out
    }

    /// `markAllDirty`: every stat marked to be sent, in the order they're kept, as a player joins.
    pub fn mark_all_dirty(mut self) {
        for (name, _) in self.stats {
            self.dirty.insert(name.copy())
        }
    }

    /// What `sendStats` sends, and none marked any more: each stat marked, by its type, its value
    /// and its count, in the order of an `Object2IntOpenHashMap` they're put in from a copy of the
    /// marked, `Sets.newHashSet`, in that copy's order.
    pub fn take_dirty(mut self) -> List<Counted> {
        var copied = JavaHashSet<String>()
        copied.reserve(if self.dirty.len() > 12 { self.dirty.len() } else { 12 })
        for name in self.dirty {
            copied.insert(name.copy())
        }
        self.dirty.clear()
        var sent = OpenHashMap<String, Counted>()
        for name in copied {
            if self.stats.contains(name) {
                sent.insert(name.copy(), self.stats[name].copy())
            }
        }
        var out = List<Counted>()
        for (_, c) in sent {
            out.push(c.copy())
        }
        return out
    }

    /// The stats as `STATS_CODEC` writes them, `toJson`'s `stats`: an object for each type that
    /// has any, by its ID, holding its stats by their values' IDs. The types go in `stat_types`'
    /// order, since vanilla groups them in a `HashMap` keyed by identity, in no set order; each
    /// type's stats go in the order of a `HashMap` of them, `Collectors.toMap`, which they're put
    /// in from the front of the table they're kept in.
    pub fn to_json(self) -> List<Member> {
        // Vanilla groups them through a stream, whose spliterator goes over fastutil's table from
        // the front, where its iterator goes from the back; a name is never the null key.
        var kept = List<Counted>()
        for (_, c) in self.stats {
            kept.push(c.copy())
        }
        var out = List<Member>()
        for (kind, _) in stat_types() {
            var of_type = JavaHashMap<String, Counted>()
            var i = kept.len()
            while i > 0 {
                i -= 1
                let c = kept[i].copy()
                if c.kind == kind {
                    of_type.insert(stat_name(c.kind.copy(), c.value.copy()), c.copy())
                }
            }
            if of_type.is_empty() {
                continue
            }
            var members = List<Member>()
            for (_, c) in of_type {
                members.push(Member { key: c.value.copy(), value: Json.Number("{c.count}") })
            }
            out.push(Member { key: kind.copy(), value: Json.Object(members) })
        }
        return out
    }

    /// A player's statistics as `ServerStatsCounter.parse` reads them from their file at `path`,
    /// `json` what it held, `none` where there was none or it couldn't be read, its registries'
    /// entries known by `codecs`. Its `stats`, where it's an object that has them, are read as
    /// `STATS_CODEC` reads them, `read_types`: what reads is kept, and what doesn't is told, with
    /// vanilla's error, `Failed to parse statistics for`. What's read goes into a `HashMap`, each
    /// type's in turn, `putAll`, then into the kept stats, `putAll` again, none marked.
    pub fn loaded(codecs: ItemCodecs, json: Json?, path: String, lines: mut List<Entry>) -> PlayerStats {
        var out = PlayerStats { file: path.copy() }
        let root = json else return out
        // `get("stats").orElseEmptyMap()`: none from anything but an object, or one without.
        let Json.Object(top) = root else return out
        var stats: Json? = none
        for m in top {
            if m.key == "stats" {
                stats = some(m.value.copy())
            }
        }
        let given = stats else return out
        let (read, error) = read_types(codecs, given)
        if let e = error {
            lines.push(Entry.error("Failed to parse statistics for {path}: {e}"))
        }
        var all = JavaHashMap<String, Counted>()
        for values in read {
            all.reserve(values.len())
            for c in values {
                all.insert(stat_name(c.kind.copy(), c.value.copy()), c.copy())
            }
        }
        out.stats.reserve(all.len())
        for (name, c) in all {
            out.stats.insert(name.copy(), c.copy())
        }
        return out
    }
}

// The members of a JSON object as Gson keeps them: each key once, where it first was, with the
// last value it was given, as `JsonObject.add` puts them in its `LinkedTreeMap`.
fn kept_members(members: List<Member>) -> List<Member> {
    var out = List<Member>()
    for m in members {
        var found = false
        for i in 0..out.len() {
            if out[i].key == m.key {
                out[i].value = m.value.copy()
                found = true
            }
        }
        if not found {
            out.push(m.copy())
        }
    }
    return out
}

// `value` as Gson's `toString` writes it, compact, as DFU's errors show what they missed.
fn compact(value: Json) -> String {
    var w = JsonWriter.new()
    w.tree(value)
    return w.into_string()
}

// DFU's `appendMessages` of an entry's error and what came before, which a map's `reduce` puts
// after it, `apply2stable`.
fn joined(error: String, before: String?) -> String {
    return match before {
        some(b) => "{error}; {b}",
        none => error.copy(),
    }
}

// The whole ID `key` reads as in the registry `registry`, `byNameCodec`: an `Identifier`, then one
// of the registry's. Its error where it isn't.
fn registry_key(codecs: ItemCodecs, registry: String, key: String) -> String ! String {
    let id = match Identifier.parse(key.copy()) {
        ok(i) => i.to_string(),
        err(e) => fail "Not a valid resource location: {key} {e}",
    }
    if not known_in(codecs, registry.copy(), id.copy()) {
        fail "Unknown registry key in ResourceKey[minecraft:root / minecraft:{registry}]: {id}"
    }
    return id
}

// Whether the registry `registry`, `stat_type` or one of `stat_types`', has the whole ID `id`.
fn known_in(codecs: ItemCodecs, registry: String, id: String) -> bool {
    return id_in(codecs, registry, id) != none
}

// The network ID of the whole ID `id` in the built-in registry `registry`, `stat_type` or one of
// `stat_types`', or `none` where it isn't there.
fn id_in(codecs: ItemCodecs, registry: String, id: String) -> i32? {
    if registry == "block" {
        return codecs.builtin_id("block", id)
    }
    if registry == "item" {
        return codecs.builtin_id("item", id)
    }
    if registry == "entity_type" {
        return codecs.builtin_id("entity_type", id)
    }
    if registry == "custom_stat" {
        return codecs.builtin_id("custom_stat", id)
    }
    if registry == "stat_type" {
        return codecs.builtin_id("stat_type", id)
    }
    return none
}

/// The IDs `Stat.STREAM_CODEC` sends a stat of the type `kind` and the value `value` by: its
/// type's in `stat_type`, then its value's in the type's registry. `none` where either isn't
/// there.
pub fn stat_ids(codecs: ItemCodecs, kind: String, value: String) -> (i32, i32)? {
    let t = id_in(codecs, String("stat_type"), kind.copy()) else return none
    let registry = registry_of(kind) else return none
    let v = id_in(codecs, registry, value) else return none
    return some((t, v))
}

/// `STATS_CODEC`'s read of `stats`, a `Codec.dispatchedMap` of each stat type to a
/// `Codec.unboundedMap` of its values' IDs to their counts, `Codec.INT`: each type read, in the
/// order its file has them, with what of it reads, and the error of what doesn't, where anything
/// doesn't, as DFU writes it. A type whose ID doesn't read is an error twice over, as its value's
/// result is its key's. Each map's errors go last first, each entry's value's before its key's,
/// joined by `; `, then ` missed input: ` and what it missed, as Gson writes it. A key a map has
/// twice is an error too, `Duplicate entry for key`, named by its ID, where vanilla names it by
/// its `toString`, which holds an identity hash.
pub fn read_types(codecs: ItemCodecs, stats: Json) -> (List<List<Counted>>, String?) {
    var out = List<List<Counted>>()
    let Json.Object(entries) = stats else return (out, some("Not a JSON object: {compact(stats)}"))
    var seen = List<String>()
    var error: String? = none
    var failed = List<Member>()
    for m in kept_members(entries) {
        let kind = match registry_key(codecs, String("stat_type"), m.key.copy()) {
            ok(k) => k,
            err(e) => {
                failed.push(m.copy())
                error = some(joined("{e}; {e}", error))
                continue
            },
        }
        let registry = registry_of(kind.copy()) ?? String()
        let (values, value_error) = read_values(codecs, kind.copy(), registry, m.value.copy())
        if let read = values {
            if seen.contains(kind) {
                failed.push(m.copy())
                error = some(joined("Duplicate entry for key: '{kind}'", error))
                continue
            }
            seen.push(kind.copy())
            out.push(read)
        }
        if let e = value_error {
            failed.push(m.copy())
            error = some(joined(e, error))
        }
    }
    if let e = error {
        return (out, some("{e} missed input: {compact(Json.Object(failed))}"))
    }
    return (out, none)
}

// The `unboundedMap` read of a stat type's values, `kind` of the registry `registry`: those that
// read, which are always kept, `setPartial`, `none` where it isn't an object at all, and the error
// of those that don't, as `read_types` writes it. A count is `Number.intValue` of a number;
// anything else isn't one, `getNumberValue`. A number Java throws for is read as 0.
fn read_values(codecs: ItemCodecs, kind: String, registry: String, value: Json) -> (List<Counted>?, String?) {
    let Json.Object(entries) = value else return (none, some("Not a JSON object: {compact(value)}"))
    var out = List<Counted>()
    var names = List<String>()
    var error: String? = none
    var failed = List<Member>()
    for m in kept_members(entries) {
        var key_error: String? = none
        var id = String()
        match registry_key(codecs, registry.copy(), m.key.copy()) {
            ok(k) => id = k,
            err(e) => key_error = some(e),
        }
        var count = 0
        var count_error: String? = none
        match m.value {
            Json.Number(t) => count = int_value(t.copy()) ?? 0,
            other => count_error = some("Not a number: {compact(other.copy())}"),
        }
        // `apply2stable` of the key and the count: the count's error before the key's.
        var entry_error: String? = none
        if let ke = key_error {
            entry_error = some(match count_error {
                some(ce) => "{ce}; {ke}",
                none => ke.copy(),
            })
        } else if let ce = count_error {
            entry_error = some(ce.copy())
        }
        if let e = entry_error {
            failed.push(m.copy())
            error = some(joined(e, error))
            continue
        }
        let name = stat_name(kind.copy(), id.copy())
        if names.contains(name) {
            failed.push(m.copy())
            error = some(joined("Duplicate entry for key: '{name}'", error))
            continue
        }
        names.push(name)
        out.push(Counted { kind: kind.copy(), value: id, count: count })
    }
    if let e = error {
        return (some(out), some("{e} missed input: {compact(Json.Object(failed))}"))
    }
    return (some(out), none)
}
