    /// Whether the entity `id` is here and alive, `isAlive`: not gone, and, where it's living, with
    /// health left (CAL-326).
    pub fn alive(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let e = self.all[self.at[id]] else return false
        if body_of(e).removed {
            return false
        }
        return match e {
            Entity.Stand(a) => a.living.alive(),
            Entity.Mob(m) => m.living.alive(),
            _ => true,
        }
    }

    /// The block the entity `id` is at, `blockPosition`, where it's here, a living entity, a mob
    /// or an armor stand, and alive; none else (CAL-326).
    pub fn living_block(self, id: i32) -> (i32, i32, i32)? {
        if not self.alive(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let (x, y, z) = match e {
            Entity.Stand(a) => (a.living.body.x, a.living.body.y, a.living.body.z),
            Entity.Mob(m) => (m.living.body.x, m.living.body.y, m.living.body.z),
            _ => return none,
        }
        return some((i32.saturate(x.floor()), i32.saturate(y.floor()), i32.saturate(z.floor())))
    }

    /// `Entity.thunderHit`'s fire on the entity `id`, `thunder_fire` (CAL-326).
    pub fn thunder_fire_on(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        var b = body_of(e)
        thunder_fire(mut b)
        self.all[i] = some(with_body(e, b))
    }

    /// The creeper `id` powered by the lightning that struck it, `Creeper.thunderHit`'s
    /// `DATA_IS_POWERED` (CAL-326).
    pub fn charge_creeper(mut self, id: i32) {
        var m = self.lend_mob(id) else return
        m.living.data.set(MONSTER_OWN + 1, Value.Bool(true))
        self.give_back_mob(m)
    }

    /// Adds the lightning bolt `p`, as `add` adds an item (CAL-326).
    pub fn add_bolt(mut self, p: own LightningBolt) {
        let id = p.body.id
        let key = section_key(p.body.x, p.body.y, p.body.z)
        self.put_new(id, key, Entity.Bolt(p))
    }

    /// Whether the entity `id` is here and a lightning bolt (CAL-326).
    pub fn is_bolt(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Bolt(_) => true,
            _ => false,
        }
    }

    /// Takes the lightning bolt `id` out to be worked on, as `lend` takes an item (CAL-326).
    pub fn lend_bolt(mut self, id: i32) -> LightningBolt? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Bolt(p) => return some(p),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts the lightning bolt `p` back where it was lent from (CAL-326).
    pub fn give_back_bolt(mut self, p: own LightningBolt) {
        let id = p.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        self.all[i] = some(Entity.Bolt(p))
    }

    /// The lightning bolt `id` put at x, y, z turned `y_rot`, `snapTo`, in the section it's in then
    /// (CAL-326).
    pub fn snap_bolt(mut self, id: i32, x: f64, y: f64, z: f64, y_rot: f32) {
        var p = self.lend_bolt(id) else return
        p.body.x = x
        p.body.y = y
        p.body.z = z
        p.body.xo = x
        p.body.yo = y
        p.body.zo = z
        p.body.y_rot = y_rot
        self.give_back_bolt(p)
        self.move_section(id, section_key(x, y, z))
    }

