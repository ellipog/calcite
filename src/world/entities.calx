    fn put_new(mut self, id: i32, key: i64, e: own Entity) {
        self.at.insert(id, self.all.len())
        self.all.push(some(e))
        self.into_section(id, key)
    }

    /// Takes the entity `id` away, `discard`, if it's here. Where it's a living entity the
    /// scoreboard has under its UUID, `scored`, it's kept in `unscored` with its ID, for the
    /// scoreboard to forget it, `entityRemoved` (CAL-164), but where a nether portal took it,
    /// `CHANGED_DIMENSION`, which doesn't destroy it, `shouldDestroy` (D578).
    pub fn remove(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        if not self.scored.is_empty() {
            var uuid: (i64, i64)? = none
            match self.all[i] {
                some(Entity.Mob(m)) => {
                    if not m.living.body.moved_away {
                        uuid = some(m.living.body.uuid)
                    }
                },
                some(Entity.Stand(s)) => {
                    if not s.living.body.moved_away {
                        uuid = some(s.living.body.uuid)
                    }
                },
                _ => {},
            }
            if let u = uuid {
                if self.scored.contains(u) {
                    self.unscored.push((id, u))
                }
            }
        }
        self.all[i] = none
        _ = self.at.remove(id)
        self.empty += 1
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
        self.gone.push(id)
        self.gone_after.push(self.heard)
    }

    /// Takes what the living entities showed since last asked, leaving who showed each and when
    /// for the caller to have read first.
    pub fn take_shown(mut self) -> List<Shown> {
        var out = List<Shown>()
        for e in self.shown {
            out.push(e.copy())
        }
        self.shown.clear()
        self.shown_by.clear()
        self.shown_after.clear()
        return out
    }

    /// Takes the IDs of those gone since last asked.
    pub fn take_gone(mut self) -> List<i32> {
        var out = List<i32>()
        for id in self.gone {
            out.push(id)
        }
        self.gone.clear()
        self.gone_after.clear()
        return out
    }

    /// Takes the item `id` out to be worked on, leaving its place, for `give_back` to put it back
    /// in; `none` if it isn't here, is out already, or isn't an item.
    pub fn lend(mut self, id: i32) -> ItemEntity? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Item(e) => return some(e),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts back an item `lend` took out, moving it to the section it's in now.
    pub fn give_back(mut self, e: own ItemEntity) {
        let id = e.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let removed = e.body.removed
        self.all[i] = some(Entity.Item(e))
        if not removed {
            self.move_section(id, key)
        }
    }

