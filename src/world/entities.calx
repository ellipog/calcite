    /// Adds the mob `m`, as `add` adds an item.
    pub fn add_mob(mut self, m: own Mob) {
        var mob = m
        // A villager's brain goes by its schedule from the game time it's made at,
        // `registerBrainGoals` (CAL-160).
        mob.settle_brain(self.game_time, self.villager_activity, self.baby_activity)
        let id = mob.living.body.id
        let key = section_key(mob.living.body.x, mob.living.body.y, mob.living.body.z)
        self.put_new(id, key, Entity.Mob(mob))
    }

