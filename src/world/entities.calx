    /// Whether the entity `id` is here and fangs (CAL-200).
    pub fn is_fangs(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Fangs(_) => true,
            _ => false,
        }
    }

    /// Takes the fangs `id` out to be worked on, as `lend` takes an item (CAL-200).
    pub fn lend_fangs(mut self, id: i32) -> EvokerFangs? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Fangs(p) => return some(p),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts the fangs `p` back where they were lent from (CAL-200).
    pub fn give_back_fangs(mut self, p: own EvokerFangs) {
        let id = p.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        self.all[i] = some(Entity.Fangs(p))
    }

    /// The living entity of the UUID `uuid` here, a mob or an armor stand, not gone, by its ID,
    /// as `EntityReference.getLivingEntity` finds an owner (CAL-200).
    pub fn living_by_uuid(self, uuid: (i64, i64)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(m) => {
                    if m.living.body.uuid == uuid and not m.living.body.removed {
                        return some(m.living.body.id)
                    }
                },
                Entity.Stand(s) => {
                    if s.living.body.uuid == uuid and not s.living.body.removed {
                        return some(s.living.body.id)
                    }
                },
                _ => {},
            }
        }
        return none
    }

    /// Adds the leash knot `k`, as `add` adds an item (CAL-179).
