/// Which chunks tick their entities.
pub interface EntityTicking {
    /// Whether the chunk's entities tick, `isPositionEntityTicking`: they're in the tick list,
    /// `listed`, and the chunk's in range for them to tick, `inEntityTickingRange` (D452).
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool
    /// Whether the chunk's entities are in the level's tick list, `canPositionTick`: its holder's
    /// chunk ticks its entities, as the entity manager's sections are `Visibility.TICKING` once
    /// its full status comes to `ENTITY_TICKING`, and stop being as soon as it drops (D452).
    fn listed(self, chunk_x: i32, chunk_z: i32) -> bool
}

/// How many of a stack's item make a whole stack, `ItemStack.getMaxStackSize`; and a block state
/// as it's saved, `BlockState.CODEC`, which an arrow keeps of what it landed on (CAL-159), air
/// where there's no codec for it.
pub interface StackSizes {
    fn stack_most(self, stack: Tag) -> i32

    fn state_saved(self, state: u32) -> Tag {
        _ = state
        return Tag.Str(String("minecraft:air"))
    }
}

impl StackSizes for ItemCodecs {
    fn stack_most(self, stack: Tag) -> i32 {
        return self.max_stack_size(stack)
    }

    fn state_saved(self, state: u32) -> Tag {
        return self.state_tag(state) ?? Tag.Str(String("minecraft:air"))
    }
}

/// An entity of the list: an item entity, an experience orb, an armor stand, a mob, an arrow, a
/// thrown potion (D527), an area effect cloud (D529), an end crystal (D589), an eye of ender
/// (D598), a dragon fireball (D618) or primed TNT (CAL-182).
pub enum Entity {
    Item(ItemEntity)
    Orb(ExperienceOrb)
    Stand(ArmorStand)
    Mob(Mob)
    Arrow(Arrow)
    Thrown(ThrownItem)
    Cloud(EffectCloud)
    Crystal(EndCrystal)
    Eye(EyeOfEnder)
    Fireball(DragonFireball)
    Tnt(PrimedTnt)
}

/// A player as an ender pearl of theirs asks after them, wherever they are,
/// `findOwnerIncludingDeadPlayer` (D579): their UUID, and whether they're alive, `isAlive`; and
/// their serial, the player a pearl putting its ticket again is among the pearls of (D580).
pub struct PearlOwner {
    pub uuid: (i64, i64)
    pub alive: bool
    pub serial: i64
}

/// What an ender pearl that landed took of its owner, not a player, in their level, `pearl_take`
/// (D585): the yaw and pitch it's put at, its own, whether it's on the ground, and whether those
/// that see it are told at once, `sendTeleportTransitionToPlayers`, as they are of what has no
/// update interval or moves on both sides, `SERVER_AND_CLIENT`: all but armor stands and mobs.
pub struct PearlTaken {
    pub y_rot: f32
    pub x_rot: f32
    pub on_ground: bool
    pub told: bool
}

/// The ticks an ender pearl's ticket lasts, `TicketType.ENDER_PEARL`'s timeout (D579).
pub const PEARL_TICKET_TICKS: i64 = 40

/// An entity a nether portal's to take as its next tick handles it, as its level's tick begins
/// (D578): its ID, where it is, how big, how far it's fallen, and its portal.
pub struct PortalDue {
    pub id: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub width: f32
    pub height: f32
    pub fall: f64
    pub portal: PortalProcess
}

/// What an explosion asks of an entity it reaches, `hurtEntities` (CAL-182): its ID, its box,
/// where it is, how high its eyes are, how it meets blocks, `CollisionContext.of`, its kind, by
/// `find`'s bits, 1 an item to 512 a dragon fireball, whether it's invisible, and its explosion
/// knockback resistance, none for what isn't living.
pub struct Reached {
    pub id: i32
    pub bounds: Aabb
    pub x: f64
    pub y: f64
    pub z: f64
    pub eyes: f64
    pub mover: Mover
    pub kind: i32
    pub invisible: bool
    pub resistance: f64
}

/// A level's entities.
pub struct Entities {
    /// The UUIDs of the living entities the scoreboard has scores or a team for, and those of
    /// them taken away since, with their IDs (CAL-164).
    pub scored: List<(i64, i64)> = List<(i64, i64)>()
    pub unscored: List<(i32, (i64, i64))> = List<(i32, (i64, i64))>()
    // In the order they came, `none` where one's gone; each one's place, by ID; how many places
    // are empty.
    all: List<Entity?> = List<Entity?>()
    at: Map<i32, usize> = Map<i32, usize>()
    empty: usize = 0
    // The entities in each section, by `SectionPos.asLong`, in the order they came into it, and
    // the section each is in.
    sections: Map<i64, List<i32>> = Map<i64, List<i32>>()
    section_of: Map<i32, i64> = Map<i32, i64>()
    // Each chunk's sections that have something in them, by `ChunkPos.pack`.
    chunk_sections: Map<i64, List<i64>> = Map<i64, List<i64>>()
    /// The IDs of those gone since they were last taken, in the order they went, and how many of
    /// the sounds of the tick going on had been played as each went.
    pub gone: List<i32> = List<i32>()
    pub gone_after: List<usize> = List<usize>()
    /// What the living entities showed since it was last taken, `Living.shown`, in the order they
    /// showed it, the ID of each that showed it, and how many of the sounds of the tick going on
    /// had been played as it did.
    pub shown: List<Shown> = List<Shown>()
    pub shown_by: List<i32> = List<i32>()
    pub shown_after: List<usize> = List<usize>()
    /// What pushes did to players since it was last taken, by their entity IDs, in the order
    /// they came, `Entity.push`, for the server to add to their motion, as it keeps them
    /// (CAL-174).
    pub player_pushes: List<(i32, f64, f64)> = List<(i32, f64, f64)>()
    /// Whether the level's in peaceful, which mobs of types not allowed in it go in; and the game
    /// rule `max_entity_cramming`, how many pushing a mob at once it may take (CAL-156).
    pub peaceful: bool = false
    pub cramming: i32 = 24
    /// The game rule `mob_drops`, which lets a mob's breeding make an orb (CAL-158), and
    /// `mob_griefing`, which lets a zombie look for turtle eggs, and `universal_anger`, which has
    /// a neutral mob a player hurt angry at all players (CAL-159).
    pub mob_drops: bool = true
    pub mob_griefing: bool = true
    pub universal_anger: bool = false
    /// Its level's world border, west, north, east and south, as it is this tick, which holds the
    /// places mobs teleport to (CAL-159).
    pub border: (f64, f64, f64, f64)? = none
    /// Whether the level's nether portals may take what's in them where they lead,
    /// `isAllowedToEnterPortal`, which `allow_entering_nether_using_portals` says of the Nether,
    /// as its level sets it each tick, each entity told as it ticks (D578); and its end portals,
    /// into the End, or out of it to where the world's spawn is (D587).
    pub portal_open: bool = true
    pub end_portal_open: bool = true
    /// Whether the level has a dragon fight, `getDragonFight`, in which an end crystal sets the
    /// air it's in alight, as its level sets it each tick (D589); and of that fight, as its level
    /// sets them each tick, its dragon's UUID, `dragonUUID`, the end crystals it counts alive,
    /// `aliveCrystals`, and whether a dragon was killed in it before,
    /// `hasPreviouslyKilledDragon`, which its dragons read (D626).
    pub fight: bool = false
    pub fight_dragon: (i64, i64)? = none
    pub fight_crystals: i32 = 0
    pub fight_killed_before: bool = false
    /// The players ender pearls may be owned by, wherever they are, and whether a pearl whose
    /// owner's dead goes, the game rule `ender_pearls_vanish_on_death`, as its level sets them
    /// each tick; and the chunks pearls put their tickets about since they were last taken,
    /// `ENDER_PEARL`, for its level to put (D579).
    pub pearl_owners: List<PearlOwner> = List<PearlOwner>()
    pub pearls_vanish: bool = true
    pub pearl_tickets: List<(i32, i32)> = List<(i32, i32)>()
    /// The chunks whose points of interest an entity's tick wanted and didn't find read, a
    /// lodestone compass's target's (D607), for its level to ask for.
    pub poi_asks: List<ChunkPos> = List<ChunkPos>()
    /// The boxes of the ender dragons' parts, each with its dragon's ID, as each dragon last
    /// ticked, which projectiles look among wherever the dragon is, as `getEntities` finds parts
    /// (D610).
    dragon_parts: List<(i32, Aabb)> = List<(i32, Aabb)>()
    // The mob whose tick stopped after its AI for its attack on a player, its place in `all`,
    // whether it entered its `aiStep`'s own part and whether it bred, which the next `tick_next`
    // goes on with once its level's dealt the hit (CAL-159).
    paused: (usize, bool, bool)? = none
    // The mob whose tick stopped at its use of a spear for the hits it met, its place in `all` and
    // whether it bred, which the next `tick_next` goes on with once its level's dealt them
    // (CAL-159).
    paused_use: (usize, bool)? = none
    // The arrow whose tick stopped at the entities its way met, its place in `all`, which the next
    // `tick_next` goes on with once its level's dealt the hits (CAL-159).
    paused_arrow: usize? = none
    /// The game rule `pvp`, without which a player's arrow doesn't hit players, `canHarmPlayer`
    /// (CAL-159).
    pub pvp: bool = true
    /// The level's random, as its level lends it for an entity's tick, which a brain mob's
    /// behaviors draw their durations from, lent on to it for the rest of its tick,
    /// `Mob.level_random` (CAL-160).
    pub level_random: TapedRandom? = none
    /// Whether each mob's state is written to `trace` as its tick is done, for `--entity-trace`,
    /// a line each, `trace_mob` (CAL-159).
    pub tracing: bool = false
    pub trace: String = String()
    /// The level's game time this tick, which a mob's panic reads its last hurt by (D416); and
    /// whether it's on hard, which a zombie hurt in its own tick draws for reinforcements on
    /// (D424).
    pub game_time: i64 = 0
    pub hard: bool = false
    /// The ID of the world's difficulty, which a mob with a target reads how far its paths may
    /// drop by (CAL-159).
    pub difficulty: i32 = 2
    /// The activities the level's villager schedules have this tick, a grown villager's and a
    /// baby's, by `world.brain`'s numbering, and the name of its dimension, which a villager's
    /// memories of places hold, as its level says before it ticks; and the level's points of
    /// interest, as its level lends them for an entity's tick, lent on to a villager for its
    /// own, `Mob.pois`; and the overworld's day's count, which a villager's restocks go by
    /// (CAL-160).
    pub villager_activity: i32 = 1
    pub baby_activity: i32 = 1
    pub dimension: String = String()
    pub pois: Pois? = none
    pub day: i64 = 0
    // Each bell's last search for those near it, `BellBlockEntity.updateEntities`, by its place,
    // `BlockPos.asLong`: the game time it searched at and the mobs it found (CAL-160).
    bells: Map<i64, (i64, List<i32>)> = Map<i64, (i64, List<i32>)>()
    // The mob that bred in the tick going on, whose push, `pushEntities`, waits till the level's
    // made its baby, as vanilla makes it in the goal's tick, before the push (D415).
    push_after: i32? = none
    // The tick going on: the next place to tick, the places there were as it began, and the
    // sounds played so far in the entity's tick.
    cursor: usize = 0
    end: usize = 0
    heard: usize = 0
    // The level's path types, `PathTypeCache`, and how many of the blocks it sent again it's read
    // (CAL-157).
    path_types: PathTypeCache = PathTypeCache()
    sent_seen: u64 = 0
}

impl Entities {
    /// None.
    pub fn new() -> Entities {
        return Entities()
    }

    /// How many there are.
    pub fn len(self) -> usize {
        return self.at.len()
    }

    /// Whether the entity `id` is here.
    pub fn contains(self, id: i32) -> bool {
        return self.at.contains(id)
    }

    /// Whether the entity `id` is here and an orb.
    pub fn is_orb(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Orb(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an armor stand.
    pub fn is_stand(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Stand(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a mob.
    pub fn is_mob(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an arrow (CAL-159).
    pub fn is_arrow(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Arrow(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a thrown potion (D527).
    pub fn is_thrown(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Thrown(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an area effect cloud (D529).
    pub fn is_cloud(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Cloud(_) => true,
            _ => false,
        }
    }

    /// The box of the ender dragon's part whose entity ID is `id`, and where the part is across,
    /// `getEntityOrPart`'s part, the dragon's ID being one of the eight before; none where it's no
    /// dragon's part (D608).
    pub fn dragon_part(self, id: i32) -> (Aabb, f64, f64)? {
        for k in 1..9 {
            let owner = id - k
            if not self.at.contains(owner) {
                continue
            }
            let slot = self.all[self.at[owner]] else continue
            let Entity.Mob(m) = slot else continue
            let dr = m.dragon else continue
            let at = part_index(owner, id) else continue
            let (x0, y0, z0, x1, y1, z1) = dr.part_box(at)
            let (px, _, pz) = dr.parts[at]
            return some((Aabb { min_x: x0, min_y: y0, min_z: z0, max_x: x1, max_y: y1, max_z: z1 }, px, pz))
        }
        return none
    }

    /// Whether the entity `id` is here and an end crystal (D589).
    pub fn is_crystal(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Crystal(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an eye of ender (D598).
    pub fn is_eye(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Eye(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a dragon fireball (D618).
    pub fn is_fireball(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Fireball(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and primed TNT (CAL-182).
    pub fn is_tnt(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Tnt(_) => true,
            _ => false,
        }
    }

    /// The category and place across of each mob that needn't stay, `isPersistenceRequired` and
    /// `requiresCustomPersistence`, in the order they came, as `createState` counts them.
    pub fn counted(self) -> List<(i32, f64, f64)> {
        var out = List<(i32, f64, f64)>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Mob(m) = e {
                    if not m.persistence_required and not m.custom_persistence() and not m.living.body.removed {
                        out.push((m.category, m.living.body.x, m.living.body.z))
                    }
                }
            }
        }
        return out
    }

    /// The boxes of those that block building, `blocksBuilding`: each mob and armor stand but a
    /// marker, each end crystal, and primed TNT (CAL-182).
    pub fn blocking(self) -> List<Aabb> {
        var out = List<Aabb>()
        for slot in self.all {
            if let e = slot {
                match e {
                    Entity.Stand(a) => {
                        if not a.marker() and not a.living.body.removed {
                            out.push(a.living.body.bounding_box())
                        }
                    },
                    Entity.Mob(m) => {
                        if not m.living.body.removed {
                            out.push(m.living.body.bounding_box())
                        }
                    },
                    Entity.Crystal(c) => {
                        if not c.body.removed {
                            out.push(c.body.bounding_box())
                        }
                    },
                    Entity.Tnt(p) => {
                        if not p.body.removed {
                            out.push(p.body.bounding_box())
                        }
                    },
                    _ => {},
                }
            }
        }
        return out
    }

    /// Their IDs, in the order they came.
    pub fn ids(self) -> List<i32> {
        var out = List<i32>()
        for slot in self.all {
            if let e = slot {
                out.push(id_of(e))
            }
        }
        return out
    }

    /// The item `id`, which must be here and an item. Its stack and place are the caller's to
    /// read.
    pub fn item(self, id: i32) -> ItemEntity {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Item(e) = slot else panic("{id} isn't an item")
        return e.copy()
    }

    /// The orb `id`, which must be here and an orb.
    pub fn orb(self, id: i32) -> ExperienceOrb {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Orb(o) = slot else panic("{id} isn't an orb")
        return o.copy()
    }

    /// The armor stand `id`, which must be here and an armor stand.
    pub fn stand(self, id: i32) -> ArmorStand {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Stand(a) = slot else panic("{id} isn't an armor stand")
        return a.copy()
    }

    /// The end crystal `id`, which must be here and an end crystal (D590).
    pub fn crystal(self, id: i32) -> EndCrystal {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Crystal(c) = slot else panic("{id} isn't an end crystal")
        return c.copy()
    }

    /// What a merchant's menu asks of the mob `id`, `stillValid` (CAL-160): the entity ID of the
    /// player it trades with, whether it's alive, and its box; none where it isn't a mob here.
    pub fn merchant(self, id: i32) -> (i32?, bool, Aabb)? {
        if not self.is_mob(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Mob(m) = slot else return none
        let trading: i32? = if let t = m.trading { some(t.id) } else { none }
        return some((trading, m.living.alive(), m.living.body.bounding_box()))
    }

    /// A merchant's offers, its level and its experience, which its menu's sent, for the mob `id`
    /// (CAL-160); none where it isn't a mob here.
    pub fn merchant_offers(self, id: i32) -> (List<Tag>, i32, i32)? {
        if not self.is_mob(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Mob(m) = slot else return none
        return some((m.offers(), m.villager_level(), m.villager_xp))
    }

    /// The mob `id`, which must be here and a mob.
    pub fn mob(self, id: i32) -> Mob {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Mob(m) = slot else panic("{id} isn't a mob")
        return m.copy()
    }

    /// The ender dragons among them that are alive, `getDragons`, in the order they came (D625).
    pub fn alive_dragons(self) -> List<Mob> {
        var out = List<Mob>()
        for slot in self.all {
            let e = slot else continue
            if let Entity.Mob(m) = e {
                if m.dragon != none and m.living.alive() {
                    out.push(m.copy())
                }
            }
        }
        return out
    }

    /// The arrow `id`, which must be here and an arrow (CAL-159).
    pub fn arrow(self, id: i32) -> Arrow {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Arrow(a) = slot else panic("{id} isn't an arrow")
        return a.copy()
    }

    /// What the entity `id`, which must be here, is saved as, `saveAsPassenger`.
    pub fn saved(self, id: i32) -> Tag {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        return match slot {
            Entity.Item(e) => e.saved(),
            Entity.Orb(o) => o.saved(),
            Entity.Stand(a) => a.saved(),
            Entity.Mob(m) => m.saved(),
            Entity.Arrow(a) => a.saved(),
            Entity.Thrown(p) => p.saved(),
            Entity.Cloud(c) => c.saved(),
            Entity.Crystal(c) => c.saved(),
            Entity.Eye(e) => e.saved(),
            Entity.Fireball(b) => b.saved(),
            Entity.Tnt(p) => p.saved(),
        }
    }

    /// Adds the item `e`, last in the tick list and in its section, `addFreshEntity`.
    pub fn add(mut self, e: own ItemEntity) {
        let id = e.body.id
        let key = section_key(e.body.x, e.body.y, e.body.z)
        self.put_new(id, key, Entity.Item(e))
    }

