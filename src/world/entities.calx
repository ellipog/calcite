/// The item entities in a level, as vanilla's `PersistentEntitySectionManager` and
/// `EntityTickList` keep them (CAL-148): in the order they came, the order they tick in, and by
/// the section each is in, in the order each came into it, so `find` gives them in the order
/// `EntitySectionStorage.getEntities` does, section by section. An item that goes is out of both
/// at once, so nothing after finds it, and its ID is kept for its trackers to tell.
///
/// Each tick, `tick` runs each item there was as it began whose chunk is in range to tick its
/// entities, as `ServerLevel.tick` runs the tick list: its tick to where it merges, then its
/// merging with the items near it, `mergeWithNeighbours`, then the rest. An item that comes during
/// a tick first ticks the next. The players of the level are in the same list, so the server
/// ticks the items one at a time, `tick_next`, those that came before each player first. Vanilla's list holds only the entities of chunks that tick them,
/// adding a chunk's in its sections' order as it comes to tick them, where Calcite's keeps every
/// item in the order it came and passes over those that don't tick.
///
/// A chunk's items are saved in its sections' order, `in_chunk`, as `storeChunkSections` saves
/// them (CAL-148). The entities read that Calcite doesn't have yet have places in the sections
/// too, by IDs below 0 the caller gives them, `place_kept`, so they're saved among the items in
/// the order they came into each, though nothing finds or ticks them.
module world.entities

import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import world.collision.{Aabb, CollisionBlocks}
import world.item_entity.{ItemEntity, ItemFacts, ItemSound}
import world.menu.{same_components}
import world.movement.{MovementStates}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}

/// Which chunks tick their entities, `inEntityTickingRange`.
pub interface EntityTicking {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool
}

/// How many of a stack's item make a whole stack, `ItemStack.getMaxStackSize`.
pub interface StackSizes {
    fn stack_most(self, stack: Tag) -> i32
}

impl StackSizes for ItemCodecs {
    fn stack_most(self, stack: Tag) -> i32 {
        return self.max_stack_size(stack)
    }
}

/// A level's item entities.
pub struct Entities {
    // In the order they came, `none` where one's gone; each one's place, by ID; how many places
    // are empty.
    items: List<ItemEntity?> = List<ItemEntity?>()
    at: Map<i32, usize> = Map<i32, usize>()
    empty: usize = 0
    // The items in each section, by `SectionPos.asLong`, in the order they came into it, and the
    // section each is in.
    sections: Map<i64, List<i32>> = Map<i64, List<i32>>()
    section_of: Map<i32, i64> = Map<i32, i64>()
    // Each chunk's sections that have something in them, by `ChunkPos.pack`.
    chunk_sections: Map<i64, List<i64>> = Map<i64, List<i64>>()
    /// The IDs of the items gone since they were last taken, in the order they went, and how
    /// many of the sounds of the tick going on had been played as each went.
    pub gone: List<i32> = List<i32>()
    pub gone_after: List<usize> = List<usize>()
    // The tick going on: the next place to tick, the places there were as it began, and the
    // sounds played so far in the item's tick.
    cursor: usize = 0
    end: usize = 0
    heard: usize = 0
}

impl Entities {
    /// None.
    pub fn new() -> Entities {
        return Entities()
    }

    /// How many items there are.
    pub fn len(self) -> usize {
        return self.at.len()
    }

    /// Whether the item `id` is here.
    pub fn contains(self, id: i32) -> bool {
        return self.at.contains(id)
    }

    /// The items' IDs, in the order they came.
    pub fn ids(self) -> List<i32> {
        var out = List<i32>()
        for slot in self.items {
            if let e = slot {
                out.push(e.id)
            }
        }
        return out
    }

    /// The item `id`, which must be here. Its stack and place are the caller's to read.
    pub fn item(self, id: i32) -> ItemEntity {
        let i = self.at[id]
        let e = self.items[i] else panic("no item {id}")
        return e.copy()
    }

    /// Adds `e`, last in the tick list and in its section, `addFreshEntity`.
    pub fn add(mut self, e: own ItemEntity) {
        let id = e.id
        let key = section_key(e.x, e.y, e.z)
        self.at.insert(id, self.items.len())
        self.items.push(some(e))
        self.into_section(id, key)
    }

    /// Takes the item `id` away, `discard`, if it's here.
    pub fn remove(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        self.items[i] = none
        _ = self.at.remove(id)
        self.empty += 1
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
        self.gone.push(id)
        self.gone_after.push(self.heard)
    }

    /// Takes the IDs of the items gone since last asked.
    pub fn take_gone(mut self) -> List<i32> {
        var out = List<i32>()
        for id in self.gone {
            out.push(id)
        }
        self.gone.clear()
        self.gone_after.clear()
        return out
    }

    /// Takes the item `id` out to be worked on, leaving its place, for `give_back` to put it back
    /// in; `none` if it isn't here or is out already.
    pub fn lend(mut self, id: i32) -> ItemEntity? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        return self.items[i].take()
    }

    /// Puts back an item `lend` took out, moving it to the section it's in now.
    pub fn give_back(mut self, e: own ItemEntity) {
        let id = e.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(e.x, e.y, e.z)
        let removed = e.removed
        self.items[i] = some(e)
        if not removed {
            self.move_section(id, key)
        }
    }

    /// The chunks with items or kept entities in them, `getAllChunksWithExistingSections`.
    pub fn chunks(self) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for (k, _) in self.chunk_sections {
            out.push(ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) })
        }
        return out
    }

    /// The items in the chunk at `pos`, and the kept entities, in the order
    /// `getExistingSectionsInChunk` gives them: its sections by `SectionPos.asLong`, and in each
    /// in the order they came into it.
    pub fn in_chunk(self, pos: ChunkPos) -> List<i32> {
        let k = pos.pack()
        if not self.chunk_sections.contains(k) {
            return List<i32>()
        }
        var keys = self.chunk_sections[k].copy()
        keys.sort()
        var out = List<i32>()
        for key in keys {
            for id in self.sections[key] {
                out.push(id)
            }
        }
        return out
    }

    /// Gives the entity `id`, one Calcite keeps as it was read, below 0, a place last in the
    /// section of x, y, z, as `addEntity` does.
    pub fn place_kept(mut self, id: i32, x: f64, y: f64, z: f64) {
        self.into_section(id, section_key(x, y, z))
    }

    /// Takes the kept entity `id` out of its section, as it's let go of.
    pub fn remove_kept(mut self, id: i32) {
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
    }

    /// Where the item `id` is, if it's here.
    pub fn place(self, id: i32) -> (f64, f64, f64)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.items[self.at[id]] else return none
        return some((e.x, e.y, e.z))
    }

    /// The items whose boxes meet `b`, but `except`, in the order `getEntities` finds them: the
    /// sections a little beyond it, by x, then by z and y as `SectionPos.asLong` orders them, and
    /// in each the items in the order they came into it.
    pub fn find(self, b: Aabb, except: i32) -> List<i32> {
        var out = List<i32>()
        let x0 = section(b.min_x - 2.0)
        let y0 = section(b.min_y - 4.0)
        let z0 = section(b.min_z - 2.0)
        let x1 = section(b.max_x + 2.0)
        let y1 = section(b.max_y + 0.0)
        let z1 = section(b.max_z + 2.0)
        for sx in x0..=x1 {
            var keys = List<i64>()
            for sz in z0..=z1 {
                for sy in y0..=y1 {
                    let key = pack(sx, sy, sz)
                    if self.sections.contains(key) and not self.sections[key].is_empty() {
                        keys.push(key)
                    }
                }
            }
            keys.sort()
            for key in keys {
                for id in self.sections[key] {
                    if id == except or not self.at.contains(id) {
                        continue
                    }
                    let e = self.items[self.at[id]] else continue
                    let other = e.bounding_box()
                    if other.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        out.push(id)
                    }
                }
            }
        }
        return out
    }

    /// A tick of every item there is that ticks, as `ServerLevel.tick` runs its tick list, among
    /// `blocks`, in a level whose floor is `min_y`, where lava's fast if `fast_lava`; the sounds
    /// they play go to `sounds`.
    pub fn tick<B: CollisionBlocks + EntityTicking, S: StackSizes>(mut self, f: Facts, m: MovementStates, t: ItemFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<ItemSound>) {
        self.begin_tick()
        while self.tick_next(u64.MAX, f, m, t, codecs, blocks, min_y, fast_lava, mut sounds) {}
        self.end_tick()
    }

    /// Starts a tick of the items there are now.
    pub fn begin_tick(mut self) {
        self.cursor = 0
        self.end = self.items.len()
    }

    /// Ticks the tick's next item if it came into the level before `before`, as `tick` does,
    /// and says whether there was one; the sounds it plays go to `sounds`, which starts empty.
    pub fn tick_next<B: CollisionBlocks + EntityTicking, S: StackSizes>(mut self, before: u64, f: Facts, m: MovementStates, t: ItemFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<ItemSound>) -> bool {
        while self.cursor < self.end {
            match self.items[self.cursor] {
                some(_) => break,
                none => self.cursor += 1,
            }
        }
        if self.cursor >= self.end {
            return false
        }
        let i = self.cursor
        var e = self.items[i].take() else return false
        if e.entered >= before {
            self.items[i] = some(e)
            return false
        }
        self.cursor += 1
        self.heard = 0
        let cx = i32.saturate(e.x.floor()) >> 4
        let cz = i32.saturate(e.z.floor()) >> 4
        if not blocks.ticks_entities(cx, cz) {
            self.items[i] = some(e)
            return true
        }
        e.tick_moving(f, m, t, blocks, min_y, fast_lava, mut sounds)
        let id = e.id
        let key = section_key(e.x, e.y, e.z)
        let due = e.merge_due and e.mergable(codecs.stack_most(e.stack))
        let removed = e.removed
        self.items[i] = some(e)
        if not removed {
            self.move_section(id, key)
        }
        self.heard = sounds.len()
        if due {
            self.merge_near(i, codecs)
        }
        var after = self.items[i].take() else return true
        after.tick_after(f, t, blocks, fast_lava, mut sounds)
        let done = after.removed
        self.items[i] = some(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
        return true
    }

    /// Ends a tick: the empty places go once there are as many as items.
    pub fn end_tick(mut self) {
        self.cursor = 0
        self.end = 0
        self.heard = 0
        if self.empty > 16 and self.empty > self.at.len() {
            self.compact()
        }
    }

    // `mergeWithNeighbours` for the item at `i`: each mergable item whose box meets its own, 0.5
    // bigger across, in the order they're found, until it's gone.
    fn merge_near<S: StackSizes>(mut self, i: usize, codecs: S) {
        let (id, near) = self.near_box(i) else return
        var found = List<i32>()
        for other in self.find(near, id) {
            if self.mergable(other, codecs) {
                found.push(other)
            }
        }
        for other in found {
            if not self.mergable(other, codecs) {
                continue
            }
            self.try_merge(id, other, codecs)
            if not self.at.contains(id) {
                break
            }
        }
    }

    // The ID of the item at `i` and its box, 0.5 bigger across, `inflate(0.5, 0, 0.5)`.
    fn near_box(self, i: usize) -> (i32, Aabb)? {
        let e = self.items[i] else return none
        let b = e.bounding_box()
        return some((e.id, Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.0, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.0, max_z: b.max_z + 0.5 }))
    }

    fn mergable<S: StackSizes>(self, id: i32, codecs: S) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let e = self.items[self.at[id]] else return false
        return e.mergable(codecs.stack_most(e.stack))
    }

    // `tryToMerge`: for the same target, and stacks that fit together, the one with fewer goes
    // into the other, or this one into the other where they've as many.
    fn try_merge<S: StackSizes>(mut self, id: i32, other: i32, codecs: S) {
        let order = self.merge_order(id, other, codecs)
        if order == 1 {
            self.merge_into(id, other, codecs)
        } else if order == 2 {
            self.merge_into(other, id, codecs)
        }
    }

    // Which way `tryToMerge` merges: 0 not at all, 1 `other` into `id`, 2 `id` into `other`.
    fn merge_order<S: StackSizes>(self, id: i32, other: i32, codecs: S) -> i32 {
        let a = self.items[self.at[id]] else return 0
        let b = self.items[self.at[other]] else return 0
        if a.target != b.target {
            return 0
        }
        if b.count() + a.count() > codecs.stack_most(b.stack) {
            return 0
        }
        if not same_components(some(a.stack.copy()), some(b.stack.copy())) {
            return 0
        }
        return if b.count() < a.count() { 1 } else { 2 }
    }

    // `merge`: as much of `from`'s stack as fits, to 64, goes to `to`'s, which keeps the longer
    // pickup delay and the younger age; `from` goes if it's none left.
    fn merge_into<S: StackSizes>(mut self, to: i32, from: i32, codecs: S) {
        let ti = self.at[to]
        let fi = self.at[from]
        var source = self.items[fi].take() else return
        var target = self.items[ti].take() else {
            self.items[fi] = some(source)
            return
        }
        let most = min(codecs.stack_most(target.stack), 64)
        let moving = min(most - target.count(), source.count())
        target.stack = counted(target.stack, target.count() + moving)
        target.stack_changed = true
        // `shrink`: the stack changes where it is, which isn't sent.
        source.stack = counted(source.stack, source.count() - moving)
        if source.pickup_delay > target.pickup_delay {
            target.pickup_delay = source.pickup_delay
        }
        if source.age < target.age {
            target.age = source.age
        }
        let empty = source.is_empty()
        if empty {
            source.removed = true
        }
        self.items[ti] = some(target)
        self.items[fi] = some(source)
        if empty {
            self.remove(from)
        }
    }

    // Moves the item `id` to the section `key` if it isn't in it, last there, as `onMove` does.
    fn move_section(mut self, id: i32, key: i64) {
        if self.section_of.contains(id) {
            let old = self.section_of[id]
            if old == key {
                return
            }
            self.out_of_section(id, old)
        }
        self.into_section(id, key)
    }

    fn into_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            self.sections.insert(key, List<i32>())
            let k = section_chunk(key).pack()
            if not self.chunk_sections.contains(k) {
                self.chunk_sections.insert(k, List<i64>())
            }
            self.chunk_sections[k].push(key)
        }
        self.sections[key].push(id)
        self.section_of.insert(id, key)
    }

    fn out_of_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            return
        }
        var kept = List<i32>()
        for other in self.sections[key] {
            if other != id {
                kept.push(other)
            }
        }
        if kept.is_empty() {
            _ = self.sections.remove(key)
            let k = section_chunk(key).pack()
            if self.chunk_sections.contains(k) {
                var left = List<i64>()
                for other in self.chunk_sections[k] {
                    if other != key {
                        left.push(other)
                    }
                }
                if left.is_empty() {
                    _ = self.chunk_sections.remove(k)
                } else {
                    self.chunk_sections.insert(k, left)
                }
            }
        } else {
            self.sections.insert(key, kept)
        }
    }

    // Drops the empty places, keeping the order.
    fn compact(mut self) {
        var kept = List<ItemEntity?>()
        self.at.clear()
        for i in 0..self.items.len() {
            if let e = self.items[i].take() {
                self.at.insert(e.id, kept.len())
                kept.push(some(e))
            }
        }
        self.items = kept
        self.empty = 0
    }
}

// `stack` with `n` of it, 0 or less leaving a stack that's nothing, as `setCount` does.
fn counted(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

// `SectionPos.posToSectionCoord`.
fn section(v: f64) -> i32 {
    return i32.saturate(v.floor()) >> 4
}

// The section of the block at x, y, z, `SectionPos.asLong`.
fn section_key(x: f64, y: f64, z: f64) -> i64 {
    return pack(section(x), section(y), section(z))
}

// The chunk of the section `SectionPos.asLong` packed in `key`.
fn section_chunk(key: i64) -> ChunkPos {
    return ChunkPos { x: i32.wrap(key >> 42), z: i32.wrap((key << 22) >> 42) }
}

/// `SectionPos.asLong`.
pub fn pack(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 4194303) << 42) | (i64(y) & 1048575) | ((i64(z) & 4194303) << 20)
}
