    /// Adds the boat `b`, as `add` adds an item (CAL-315).
    /// What the entity `id` saves as `saveWithoutId` writes it, without its type, which is never put
    /// in, so its compound grows as vanilla's does (CAL-315); none where it isn't here.
    pub fn saved_without_id(mut self, id: i32) -> Tag? {
        var b = self.body_at(id) else return none
        b.without_id = true
        self.put_body(id, b)
        let saved = self.saved(id)
        if let after = self.body_at(id) {
            var back = after
            back.without_id = false
            self.put_body(id, back)
        }
        return some(saved)
    }

    /// Adds the minecart `c`, as `add_boat` adds a boat (CAL-315), moving as the level's carts
    /// do from the start, as its tracker runs before its first tick.
    pub fn add_cart(mut self, c: own Minecart) {
        var cart = c
        cart.experimental = self.carts_experimental
        let id = cart.body.id
        let key = section_key(cart.body.x, cart.body.y, cart.body.z)
        self.put_new(id, key, Entity.Cart(cart))
    }

