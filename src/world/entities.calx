    // Whether what it rode is a strider, which puts it off away from lava (CAL-392).
    pub strider: bool = false
    // Whether what it rode is a happy ghast, which puts it off on its top (CAL-384).
    pub happy_ghast: bool = false
}

/// A chicken a baby zombie being finalized may ride (D709), as `getEntitiesOfClass` finds it:
/// its ID and box, and the section it's in, by x, y and z and packed, `SectionPos.asLong`, and its
/// place there.
pub struct FreeChicken {
    pub id: i32
    pub bounds: Aabb
    pub sx: i32
    pub sy: i32
    pub sz: i32
    pub key: i64
    pub at: usize
}

impl FreeChicken {
    /// Whether `getEntitiesOfClass` with the box `b` finds it, `found`'s sections and its box
    /// meeting `b`.
    pub fn found_by(self, b: Aabb) -> bool {
        let x0 = section(b.min_x - 2.0)
        let y0 = section(b.min_y - 4.0)
        let z0 = section(b.min_z - 2.0)
        let x1 = section(b.max_x + 2.0)
        let y1 = section(b.max_y + 0.0)
        let z1 = section(b.max_z + 2.0)
        if self.sx < x0 or self.sx > x1 or self.sy < y0 or self.sy > y1 or self.sz < z0 or self.sz > z1 {
            return false
        }
        return self.bounds.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z)
    }

    /// Whether `getEntitiesOfClass` finds it before `other`: by section x, then packed, then place.
    pub fn before(self, other: FreeChicken) -> bool {
        if self.sx != other.sx {
            return self.sx < other.sx
        }
        if self.key != other.key {
            return self.key < other.key
        }
        return self.at < other.at
    }
}

/// A player as an ender pearl of theirs asks after them, wherever they are,
/// `findOwnerIncludingDeadPlayer` (D579): their UUID, and whether they're alive, `isAlive`; and
/// their serial, the player a pearl putting its ticket again is among the pearls of (D580).
pub struct PearlOwner {
    pub uuid: (i64, i64)
    pub alive: bool
    pub serial: i64
}

/// What an ender pearl that landed took of its owner, not a player, in their level, `pearl_take`
/// (D585): the yaw and pitch it's put at, its own, whether it's on the ground, and whether those
/// that see it are told at once, `sendTeleportTransitionToPlayers`, as they are of what has no
/// update interval or moves on both sides, `SERVER_AND_CLIENT`: all but armor stands and mobs.
pub struct PearlTaken {
    pub y_rot: f32
    pub x_rot: f32
    pub on_ground: bool
    pub told: bool
}

/// What a command's teleport of an entity that isn't a player did (CAL-165): where it is, how it
/// moves, how it's turned and whether it's on the ground as `teleportSetPosition` left it, which
/// those that see it are told at once where `told`, `sendTeleportTransitionToPlayers`; whether
/// it's an item, to merge with those about it, `ItemEntity.teleport`'s `mergeWithNeighbours`; and
/// whether it's an ender pearl, to put a portal ticket about, `ThrownEnderpearl.teleport`'s
/// `placePortalTicket`.
pub struct CommandTaken {
    pub x: f64
    pub y: f64
    pub z: f64
    pub vx: f64
    pub vy: f64
    pub vz: f64
    pub y_rot: f32
    pub x_rot: f32
    pub on_ground: bool
    pub told: bool
    pub item: bool
    pub pearl: bool
}

/// The ticks an ender pearl's ticket lasts, `TicketType.ENDER_PEARL`'s timeout (D579).
pub const PEARL_TICKET_TICKS: i64 = 40

/// An entity a nether portal's to take as its next tick handles it, as its level's tick begins
/// (D578): its ID, where it is, how big, how far it's fallen, and its portal.
pub struct PortalDue {
    pub id: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub width: f32
    pub height: f32
    pub fall: f64
    pub portal: PortalProcess
}

/// What an explosion asks of an entity it reaches, `hurtEntities` (CAL-182): its ID, its box,
/// where it is, how high its eyes are, how it meets blocks, `CollisionContext.of`, its kind, by
/// `find`'s bits, 1 an item to 512 a dragon fireball, whether it's invisible, and its explosion
/// knockback resistance, none for what isn't living.
pub struct Reached {
    pub id: i32
    pub bounds: Aabb
    pub x: f64
    pub y: f64
    pub z: f64
    pub eyes: f64
    pub mover: Mover
    pub kind: i32
    pub invisible: bool
    pub resistance: f64
}

/// A level's entities.
/// A stack a player threw that a mob took up, `onItemPickup` (CAL-229): the player's UUID, the
/// item's stack as it was, and what loot reads of the mob as it took it.
pub struct ThrownPicked {
    pub thrower: (i64, i64)
    pub stack: Tag
    pub by: LootEntity
}

pub struct Entities {
    // Whether the level had a boat as its tick began, so its mobs look for boats to collide with
    // only then (CAL-315).
    any_boats: bool = false
    /// The UUIDs of the living entities the scoreboard has scores or a team for, and those of
    /// them taken away since, with their IDs (CAL-164).
    pub scored: List<(i64, i64)> = List<(i64, i64)>()
    pub unscored: List<(i32, (i64, i64))> = List<(i32, (i64, i64))>()
    // In the order they came, `none` where one's gone; each one's place, by ID; how many places
    // are empty.
    all: List<Entity?> = List<Entity?>()
    at: Map<i32, usize> = Map<i32, usize>()
    empty: usize = 0
    // The entities in each section, by `SectionPos.asLong`, in the order they came into it, and
    // the section each is in.
    sections: Map<i64, List<i32>> = Map<i64, List<i32>>()
    section_of: Map<i32, i64> = Map<i32, i64>()
    // Each chunk's sections that have something in them, by `ChunkPos.pack`.
    chunk_sections: Map<i64, List<i64>> = Map<i64, List<i64>>()
    // The players in the sections, by their IDs, each where the server last placed them, as
    // vanilla keeps them among the rest, which `found` gives in their places (CAL-190).
    players_in: OpenHashSet<i32> = OpenHashSet<i32>()
    // When each entity and player here came, by ID, counted up as they came, as vanilla's
    // `EntityLookup` keeps them in the order they were added, which selectors go through
    // (CAL-165).
    arrival: Map<i32, i64> = Map<i32, i64>()
    arrivals: i64 = 0
    /// The IDs of those gone since they were last taken, in the order they went, and how many of
    /// the sounds of the tick going on had been played as each went.
    pub gone: List<i32> = List<i32>()
    pub gone_after: List<usize> = List<usize>()
    // The items that went emptied, their stacks shrunk to nothing, by their IDs, with the game
    // time each went, kept 40 ticks: what a brain that remembers one finds it holds then, which a
    // piglin doesn't love (CAL-200).
    emptied: List<(i32, i64)> = List<(i32, i64)>()
    /// What the living entities showed since it was last taken, `Living.shown`, in the order they
    /// showed it, the ID of each that showed it, and how many of the sounds of the tick going on
    /// had been played as it did.
    pub shown: List<Shown> = List<Shown>()
    pub shown_by: List<i32> = List<i32>()
    pub shown_after: List<usize> = List<usize>()
    /// What players threw that mobs took up since it was last taken, `onItemPickup`, for the
    /// server to tell the players of, each with its stack as it was and the mob as it was then
    /// (CAL-229).
    pub thrown_picked: List<ThrownPicked> = List<ThrownPicked>()
    /// What pushes did to players since it was last taken, by their entity IDs, in the order
    /// they came, `Entity.push`, for the server to add to their motion, as it keeps them
    /// (CAL-174).
    pub player_pushes: List<(i32, f64, f64)> = List<(i32, f64, f64)>()
    /// The players in other levels: an orb that was following one as they went still follows them
    /// where they are there, as vanilla keeps the object. Set by the server before each tick
    /// (CAL-172).
    pub away: List<Follower> = List<Follower>()
    /// Whether the game's frozen this tick, `!runsNormally`, so only players and what carries one
    /// tick. Set by the server before each tick (CAL-360).
    pub frozen: bool = false
    /// Whether the level's in peaceful, which mobs of types not allowed in it go in; and the game
    /// rule `max_entity_cramming`, how many pushing a mob at once it may take (CAL-156).
    pub peaceful: bool = false
    pub cramming: i32 = 24
    /// How many of the mobs a player's push last found don't ride anything (CAL-189).
    pub pushed_not_riding: usize = 0
    /// The turns of a player's push last run, in the order vanilla takes them: each mob that
    /// pushed the player back, by how much, and each other player to push, `pushed_by_player`
    /// (CAL-190).
    pub push_turns: List<(i32, bool, f64, f64)> = List<(i32, bool, f64, f64)>()
    /// The game rule `mob_drops`, which lets a mob's breeding make an orb (CAL-158), and
    /// `mob_griefing`, which lets a zombie look for turtle eggs, and `universal_anger`, which has
    /// a neutral mob a player hurt angry at all players (CAL-159).
    pub mob_drops: bool = true
    /// The game rule `entity_drops`, which drops a leash's lead as it breaks (CAL-179).
    pub entity_drops: bool = true
    /// The game rule `tnt_explodes`, as the server last gave it, which a TNT minecart asks (CAL-315).
    pub tnt_explodes: bool = true
    /// Whether the world's features have `minecart_improvements`, so its minecarts move as
    /// `NewMinecartBehavior` has them, and its game rule `max_minecart_speed` (CAL-315).
    pub carts_experimental: bool = false
    pub max_cart_speed: i32 = 8
    pub mob_griefing: bool = true
    /// Whether its world makes structures, which a dolphin looks for treasure among (CAL-201).
    pub structures: bool = true
    pub universal_anger: bool = false
    /// The game rule `forgive_dead_players`, which has a piglin no longer angry at a dead player
    /// (CAL-200).
    pub forgive_dead_players: bool = true
    /// Its level's world border, west, north, east and south, as it is this tick, which holds the
    /// places mobs teleport to (CAL-159).
    pub border: (f64, f64, f64, f64)? = none
    /// Its level's top, `getMaxY`, above which by more than 30 a wind charge bursts (CAL-182).
    pub max_y: i32 = 319
    /// Whether the level's nether portals may take what's in them where they lead,
    /// `isAllowedToEnterPortal`, which `allow_entering_nether_using_portals` says of the Nether,
    /// as its level sets it each tick, each entity told as it ticks (D578); and its end portals,
    /// into the End, or out of it to where the world's spawn is (D587).
    pub portal_open: bool = true
    pub end_portal_open: bool = true
    /// Whether the level has a dragon fight, `getDragonFight`, in which an end crystal sets the
    /// air it's in alight, as its level sets it each tick (D589); and of that fight, as its level
    /// sets them each tick, its dragon's UUID, `dragonUUID`, the end crystals it counts alive,
    /// `aliveCrystals`, and whether a dragon was killed in it before,
    /// `hasPreviouslyKilledDragon`, which its dragons read (D626).
    pub fight: bool = false
    pub fight_dragon: (i64, i64)? = none
    pub fight_crystals: i32 = 0
    pub fight_killed_before: bool = false
    /// The players ender pearls may be owned by, wherever they are, and whether a pearl whose
    /// owner's dead goes, the game rule `ender_pearls_vanish_on_death`, as its level sets them
    /// each tick; and the chunks pearls put their tickets about since they were last taken,
    /// `ENDER_PEARL`, for its level to put (D579).
    pub pearl_owners: List<PearlOwner> = List<PearlOwner>()
    pub pearls_vanish: bool = true
    pub pearl_tickets: List<(i32, i32)> = List<(i32, i32)>()
    /// The chunks whose points of interest an entity's tick wanted and didn't find read, a
    /// lodestone compass's target's (D607), for its level to ask for.
    pub poi_asks: List<ChunkPos> = List<ChunkPos>()
    /// The boxes of the ender dragons' parts, each with its dragon's ID, as each dragon last
    /// ticked, which projectiles look among wherever the dragon is, as `getEntities` finds parts
    /// (D610).
    dragon_parts: List<(i32, Aabb)> = List<(i32, Aabb)>()
    // The mob whose tick stopped after its AI for its attack on a player, its place in `all`,
    // whether it entered its `aiStep`'s own part and whether it bred, which the next `tick_next`
    // goes on with once its level's dealt the hit (CAL-159).
    paused: (usize, bool, bool)? = none
    // The mob whose tick stopped at its use of a spear for the hits it met, its place in `all` and
    // whether it bred, which the next `tick_next` goes on with once its level's dealt them
    // (CAL-159).
    paused_use: (usize, bool)? = none
    // The mob whose tick stopped at its start for its creeper's explosion, its place in `all` and
    // whether it bred, which the next `tick_next` goes on with once its level's made it (CAL-182).
    paused_start: (usize, bool)? = none
    // The arrow whose tick stopped at the entities its way met, its place in `all`, which the next
    // `tick_next` goes on with once its level's dealt the hits (CAL-159).
    paused_arrow: usize? = none
    /// The game rule `pvp`, without which a player's arrow doesn't hit players, `canHarmPlayer`
    /// (CAL-159).
    pub pvp: bool = true
    /// The level's random, as its level lends it for an entity's tick, which a brain mob's
    /// behaviors draw their durations from, lent on to it for the rest of its tick,
    /// `Mob.level_random` (CAL-160).
    pub level_random: TapedRandom? = none
    /// Whether a crossbow's loading's start and middle sounds were played, which the crossbow
    /// item keeps for every crossbow, `startSoundPlayed` and `midLoadSoundPlayed`, lent to each
    /// mob that may use one for its tick, `Mob.crossbow_sounds` (CAL-200). Vanilla's item keeps
    /// them for the whole server; Calcite for each level.
    pub crossbow_sounds: (bool, bool) = (false, false)
    /// Those who last hurt its mobs and armor stands that are in another level, by UUID, and
    /// whether they're alive, as its level found them as its tick began, which `EntityReference`
    /// finds in any dimension, `getEntityInAnyDimension` (CAL-200).
    pub elsewhere: List<((i64, i64), bool)> = List<((i64, i64), bool)>()
    /// Whether each mob's state is written to `trace` as its tick is done, for `--entity-trace`,
    /// a line each, `trace_mob` (CAL-159).
    pub tracing: bool = false
    pub trace: String = String()
    /// And whether each line goes on with the mob's controls, for `--entity-controls` (CAL-180).
    pub trace_controls: bool = false
    /// With the controls, each mob's path as it was last traced, by ID: its number and its next
    /// node's index, `path_traced` (CAL-403).
    pub traced_paths: Map<i32, String> = Map<i32, String>()
    /// The level's game time this tick, which a mob's panic reads its last hurt by (D416); and
    /// whether it's on hard, which a zombie hurt in its own tick draws for reinforcements on
    /// (D424).
    pub game_time: i64 = 0
    pub hard: bool = false
    /// The ID of the world's difficulty, which a mob with a target reads how far its paths may
    /// drop by (CAL-159).
    pub difficulty: i32 = 2
    /// The activities the level's villager schedules have this tick, a grown villager's and a
    /// baby's, by `world.brain`'s numbering, and the name of its dimension, which a villager's
    /// memories of places hold, as its level says before it ticks; and the level's points of
    /// interest, as its level lends them for an entity's tick, lent on to a villager for its
    /// own, `Mob.pois`; and the overworld's day's count, which a villager's restocks go by
    /// (CAL-160).
    pub villager_activity: i32 = 1
    pub baby_activity: i32 = 1
    pub dimension: String = String()
    pub pois: Pois? = none
    /// What the level's raiders see of its raids as they tick, given by its server (CAL-167).
    pub raids: List<RaidView> = List<RaidView>()
    pub day: i64 = 0
    // Each bell's last search for those near it, `BellBlockEntity.updateEntities`, by its place,
    // `BlockPos.asLong`: the game time it searched at and the mobs it found (CAL-160).
    bells: Map<i64, (i64, List<i32>)> = Map<i64, (i64, List<i32>)>()
    // Each rung bell's block entity's state, `BellBlockEntity`, by its place (CAL-394): its ticks
    // shaking, whether it shakes, whether it resonates and its ticks resonating.
    rings: Map<i64, (i32, bool, bool, i32)> = Map<i64, (i32, bool, bool, i32)>()
    // The mob that bred in the tick going on, whose push, `pushEntities`, waits till the level's
    // made its baby, as vanilla makes it in the goal's tick, before the push (D415).
    push_after: i32? = none
    // The tick list, `entityTickList`: the entities' IDs in the order they tick, `none` where one
    // went or moved to its end; each one's place in it, by ID; how many places are empty. One
    // goes in at its end as it comes, and again as its chunk comes to tick its entities, as
    // `startTicking` puts it there (CAL-184).
    tick_list: List<i32?> = List<i32?>()
    tick_place: Map<i32, usize> = Map<i32, usize>()
    tick_empty: usize = 0
    // The tick going on: the next place in the tick list to tick, the places there were as it
    // began, and the sounds played so far in the entity's tick.
    cursor: usize = 0
    end: usize = 0
    heard: usize = 0
    // The entity whose tick goes on, by its ID, and what it rides where it ticks as a passenger,
    // `rideTick`; and the passengers to tick after it, each with what it rode as its vehicle's tick
    // began, first first, as `tickNonPassenger` and `tickPassenger` go through them, depth first
    // (D708).
    ticking: (i32, i32?)? = none
    riders: List<(i32, i32)> = List<(i32, i32)>()
    // What got off something, to be put where it gets off where its level's blocks are at hand,
    // as the next entity's tick begins (D708).
    unseated: List<Unseat> = List<Unseat>()
    // The players riding something here (CAL-179), whose bodies the network keeps: each by its
    // entity ID, with what it rides and its UUID; the one whose ride's to tick now, `rideTick`,
    // with what it rides, where one is; and those who got off since, for the network to put where
    // they get off, `dismountVehicle`.
    riding_players: List<(i32, i32, (i64, i64))> = List<(i32, i32, (i64, i64))>()
    /// Where each player riding something means to go as the tick began, by their ID,
    /// `getLastClientMoveIntent`, which a minecart they ride is pushed by (CAL-315).
    pub move_intents: List<(i32, (f64, f64, f64))> = List<(i32, (f64, f64, f64))>()
    pub player_ride: (i32, i32)? = none
    players_off: List<Unseat> = List<Unseat>()
    // The sounds happy ghasts made as things got on or off them, their goggles, for the level to
    // play, `take_said` (CAL-384).
    said: List<EntitySound> = List<EntitySound>()
    // The level's path types, `PathTypeCache`, and how many of the blocks it sent again it's read
    // (CAL-157).
    path_types: PathTypeCache = PathTypeCache()
    sent_seen: u64 = 0
}

impl Entities {
    /// None.
    pub fn new() -> Entities {
        return Entities()
    }

    /// How many there are.
    pub fn len(self) -> usize {
        return self.at.len()
    }

    /// Whether the entity `id` is here.
    pub fn contains(self, id: i32) -> bool {
        return self.at.contains(id)
    }

    /// Whether the entity `id` is here and an orb.
    pub fn is_orb(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Orb(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an armor stand.
    pub fn is_stand(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Stand(_) => true,
            _ => false,
        }
    }

    /// The mobs whose leashes the entity `holder` holds, a player where `player` is, that one
    /// object of theirs, whose boxes meet `area`, `leashableInArea`, in the order they came
    /// (CAL-179).
    pub fn leashed_to(self, holder: i32, player: bool, object: u64, area: Aabb) -> List<i32> {
        var out = List<i32>()
        for slot in self.all {
            let e = slot else continue
            // A mob's, or a boat's (CAL-315).
            let (leash, b, id) = match e {
                Entity.Mob(m) => (m.leash.copy(), m.living.body.bounding_box(), m.living.body.id),
                Entity.Boat(o) => (o.tether.copy(), o.body.bounding_box(), o.body.id),
                _ => continue,
            }
            if let l = leash {
                if let h = l.holder {
                    if h.id == holder and h.player == player and h.object == object {
                        if b.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                            out.push(id)
                        }
                    }
                }
            }
        }
        return out
    }

    /// Whether the mob or boat `id` may be tied to what's at `other`'s box, the entity `other_id`,
    /// `canHaveALeashAttachedTo` (CAL-315).
    pub fn tether_may_tie(self, id: i32, other: Aabb, other_id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(m) => m.may_tie_to(other, other_id),
            Entity.Boat(b) => b.may_tie_to(other, other_id),
            _ => false,
        }
    }

    /// The mob or boat `id`'s leash tied to `h`, but for what's sent, `setLeashedTo` (CAL-315):
    /// whether it rides something it would leave.
    pub fn tether_tie(mut self, id: i32, h: Held) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return false
        var rides = false
        self.all[i] = some(match taken {
            Entity.Mob(m) => {
                var it = m
                rides = it.tie(h)
                Entity.Mob(it)
            },
            Entity.Boat(b) => {
                var it = b
                rides = it.tie(h)
                Entity.Boat(it)
            },
            other => other,
        })
        return rides
    }

    /// The mob or boat `id`'s leash let go, but for what's dropped and sent (CAL-315): where it
    /// was, where it was leashed.
    pub fn tether_untie(mut self, id: i32) -> (f64, f64, f64)? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        var at: (f64, f64, f64)? = none
        self.all[i] = some(match taken {
            Entity.Mob(m) => {
                var it = m
                if it.untie() {
                    at = some((it.living.body.x, it.living.body.y, it.living.body.z))
                }
                Entity.Mob(it)
            },
            Entity.Boat(b) => {
                var it = b
                if it.untie() {
                    at = some((it.body.x, it.body.y, it.body.z))
                }
                Entity.Boat(it)
            },
            other => other,
        })
        return at
    }

    /// What holds the boat `id`'s leash, where it's here and leashed (CAL-315).
    pub fn boat_leash_holder(self, id: i32) -> Held? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        if let Entity.Boat(b) = slot {
            return b.leash_holder()
        }
        return none
    }

    /// The boat `id`'s UUID and the sound `sound` heard from it unless it's silent, `playSound`
    /// (CAL-315).
    pub fn boat_heard(self, id: i32, sound: str) -> ((i64, i64), EntitySound?)? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        if let Entity.Boat(b) = slot {
            let heard: EntitySound? = if b.silent() { none } else { some(EntitySound { sound: String(sound), x: b.body.x, y: b.body.y, z: b.body.z, volume: 1.0f32, pitch: 1.0f32, source: b.body.sound_source }) }
            return some((b.body.uuid, heard))
        }
        return none
    }

    /// `hitTargetOrDeflectSelf`'s deflection of the projectile `body` by what it hit, `target`, a
    /// breeze, `#deflects_projectiles`, `Breeze.deflection` (CAL-421), where it isn't a wind
    /// charge, `wind`: where the breeze isn't the last that turned it back, `lastDeflectedBy`,
    /// its deflect heard from it, silent or not, `PROJECTILE_DEFLECTION`, and it turned back,
    /// `REVERSE` at full power, the breeze then its last. Whether it hit a breeze, so hit nothing,
    /// and whether it was turned back, which halves a fireball's acceleration, `onDeflection`.
    pub fn deflects(self, target: i32, wind: bool, body: mut Body, sounds: mut List<EntitySound>) -> (bool, bool) {
        if wind or not self.at.contains(target) {
            return (false, false)
        }
        let slot = self.all[self.at[target]] else return (false, false)
        let Entity.Mob(m) = slot else return (false, false)
        if m.species != BREEZE {
            return (false, false)
        }
        if body.deflected_by == target {
            return (true, false)
        }
        let (x, y, z, source) = (m.living.body.x, m.living.body.y, m.living.body.z, m.living.body.sound_source)
        sounds.push(EntitySound { sound: String("entity.breeze.deflect"), x: x, y: y, z: z, volume: 1.0f32, pitch: 1.0f32, source: source, from_entity: some(target) })
        body.reverse(1.0)
        body.deflected_by = target
        return (true, true)
    }

    /// Whether the entity `id` is here and a mob.
    pub fn is_mob(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a projectile, an arrow or a thrown one, and the UUID of
    /// its owner, if any, which its `mayInteract` goes by (CAL-172).
    pub fn projectile_owner(self, id: i32) -> (bool, (i64, i64)?) {
        if not self.at.contains(id) {
            return (false, none)
        }
        let slot = self.all[self.at[id]] else return (false, none)
        return match slot {
            Entity.Arrow(a) => (true, a.owner),
            Entity.Thrown(p) => (true, p.owner),
            _ => (false, none),
        }
    }

    /// Whether the entity `id` is here and a mob of `Zombie`'s class, which turtle eggs it lands on
    /// don't break under (CAL-172).
    pub fn is_zombie_class(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(m) => m.zombie_class(),
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a turtle or a bat, which never break turtle eggs,
    /// `TurtleEggBlock.canDestroyEgg` (CAL-201).
    pub fn spares_eggs(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(m) => m.species == TURTLE or m.species == BAT,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an arrow (CAL-159).
    pub fn is_arrow(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Arrow(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a thrown potion (D527).
    pub fn is_thrown(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Thrown(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an area effect cloud (D529).
    pub fn is_cloud(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Cloud(_) => true,
            _ => false,
        }
    }

    /// The box of the ender dragon's part whose entity ID is `id`, and where the part is across,
    /// `getEntityOrPart`'s part, the dragon's ID being one of the eight before; none where it's no
    /// dragon's part (D608).
    pub fn dragon_part(self, id: i32) -> (Aabb, f64, f64)? {
        for k in 1..9 {
            let owner = id - k
            if not self.at.contains(owner) {
                continue
            }
            let slot = self.all[self.at[owner]] else continue
            let Entity.Mob(m) = slot else continue
            let dr = m.dragon else continue
            let at = part_index(owner, id) else continue
            let (x0, y0, z0, x1, y1, z1) = dr.part_box(at)
            let (px, _, pz) = dr.parts[at]
            return some((Aabb { min_x: x0, min_y: y0, min_z: z0, max_x: x1, max_y: y1, max_z: z1 }, px, pz))
        }
        return none
    }

    /// Whether the entity `id` is here and an end crystal (D589).
    pub fn is_crystal(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Crystal(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an eye of ender (D598).
    pub fn is_eye(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Eye(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a dragon fireball (D618).
    pub fn is_fireball(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Fireball(_) => true,
            _ => false,
        }
    }

    /// The type of the entity `id`, a whole ID, where it's here and a fireball, primed TNT or an
    /// end crystal, which a criterion's predicates read of what an explosion came from (D666).
    pub fn blast_kind(self, id: i32) -> String? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        return match slot {
            Entity.Fireball(b) => some(String(b.type_name())),
            Entity.Tnt(_) => some(String("minecraft:tnt")),
            Entity.Crystal(_) => some(String("minecraft:end_crystal")),
            _ => none,
        }
    }

    /// Whether the entity `id` is here and primed TNT (CAL-182).
    pub fn is_falling(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Falling(_) => true,
            _ => false,
        }
    }

    /// The entity `id` as what makes a game event, `GameEvent.Context.of(entity)` (CAL-275): its ID
    /// and UUID, and a projectile's owner; nothing where it isn't here.
    pub fn event_source(self, id: i32) -> EventSource {
        if not self.at.contains(id) {
            return EventSource {}
        }
        let e = self.all[self.at[id]] else return EventSource {}
        let (_, owner) = self.projectile_owner(id)
        return EventSource { id: id, uuid: some(uuid_of_entity(e)), owner: owner }
    }

    /// What steers the vehicle `id` as what makes a game event, `getControllingPassenger` as a
    /// boat finds it (CAL-424): its first passenger where that's alive, a mob by its ID and UUID,
    /// a player by their UUID, which its level knows them by; nothing where none rides it.
    pub fn rider_source(self, id: i32) -> EventSource {
        let riders = self.passengers_of(id)
        if riders.is_empty() {
            return EventSource {}
        }
        let first = riders[0]
        if let k = self.riding_player(first) {
            let (_, _, uuid) = self.riding_players[k]
            return EventSource { uuid: some(uuid) }
        }
        if not self.at.contains(first) {
            return EventSource {}
        }
        let e = self.all[self.at[first]] else return EventSource {}
        let Entity.Mob(_) = e else return EventSource {}
        return self.event_source(first)
    }

    /// The listeners of the allays here, `Mob.listener`, in the order they came (CAL-275).
    pub fn listeners(self) -> List<EntityListener> {
        var out = List<EntityListener>()
        for i in 0..self.all.len() {
            let slot = self.all[i] else continue
            let Entity.Mob(m) = slot else continue
            if let l = m.listener() {
                out.push(l)
            }
        }
        return out
    }

    /// The owner of the projectile `id` as what makes a game event, by its UUID, which its level
    /// knows players by; nothing where it has none (CAL-275).
    pub fn owner_source(self, id: i32) -> EventSource {
        let (_, owner) = self.projectile_owner(id)
        let u = owner else return EventSource {}
        return EventSource { uuid: some(u) }
    }

    /// The box of the entity `id`, where it's here (CAL-315).
    pub fn bounds_of(self, id: i32) -> Aabb? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(box_of(e))
    }

    /// What hoppers reach of the entities here as the level's block entities tick (CAL-277): each
    /// item entity alive with something in its stack, and each chest minecart and chest boat alive,
    /// with where it comes among them, `order_of`.
    pub fn hopper_world(self) -> HopperWorld {
        var w = HopperWorld()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Item(i) => {
                    if not i.body.removed and not i.is_empty() {
                        w.items.push(ReachedItem { id: i.body.id, bounds: i.body.bounding_box(), stack: some(i.stack.copy()), order: self.order_of(i.body.id) })
                    }
                },
                Entity.Cart(c) => {
                    if not c.body.removed and c.has_chest() {
                        let (cx, cy, cz) = (c.body.x, c.body.y, c.body.z)
                        let above = if c.is_hopper() { some(Aabb { min_x: cx - 0.5, min_y: cy + 1.0, min_z: cz - 0.5, max_x: cx + 0.5, max_y: cy + 2.0, max_z: cz + 0.5 }) } else { none }
                        w.boxes.push(ReachedBox { id: c.body.id, bounds: c.body.bounding_box(), slots: c.items.copy(), loot: c.loot_table != none, order: self.order_of(c.body.id), above: above, loot_table: c.loot_table.copy(), loot_seed: c.loot_seed, at: (cx, cy, cz) })
                    }
                },
                Entity.Boat(b) => {
                    if not b.body.removed and b.has_chest() {
                        w.boxes.push(ReachedBox { id: b.body.id, bounds: b.body.bounding_box(), slots: b.items.copy(), loot: b.loot_table != none, order: self.order_of(b.body.id), loot_table: b.loot_table.copy(), loot_seed: b.loot_seed, at: (b.body.x, b.body.y, b.body.z) })
                    }
                },
                _ => {},
            }
        }
        return w
    }

    /// The mobs and armor stands here a dispenser may put equipment on (CAL-378), alive, with the
    /// slots of each it may fill, `canEquipWithDispenser`: `canUseSlot`, empty and
    /// `canDispenserEquipIntoSlot`.
    pub fn wearers(self) -> List<Wearer> {
        var out = List<Wearer>()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(m) => {
                    if m.living.body.removed or not m.living.alive() {
                        continue
                    }
                    var open = List<bool>()
                    for k in 0..m.living.equipment.len() {
                        open.push(m.may_use_slot(k) and m.living.equipment[k] == none and m.dispenser_may_equip(k))
                    }
                    out.push(Wearer { id: m.living.body.id, bounds: m.living.body.bounding_box(), kind: String(type_name(m.species)), open: open, order: self.order_of(m.living.body.id) })
                },
                Entity.Stand(a) => {
                    if a.living.body.removed or not a.living.alive() {
                        continue
                    }
                    var open = List<bool>()
                    for k in 0..a.living.equipment.len() {
                        open.push(a.may_use_slot(k) and a.living.equipment[k] == none)
                    }
                    out.push(Wearer { id: a.living.body.id, bounds: a.living.body.bounding_box(), kind: String("minecraft:armor_stand"), open: open, order: self.order_of(a.living.body.id) })
                },
                _ => {},
            }
        }
        return out
    }

    /// The entities here a dispenser's shears or brush may act on (CAL-378): mobs ready to be
    /// sheared, the mobs, boats and knots with leash links, leashed or holding a leash, and
    /// armadillos.
    pub fn shearables(self) -> List<Shearable> {
        var holders = Set<i32>()
        for slot in self.all {
            let e = slot else continue
            let held = match e {
                Entity.Mob(m) => m.leash_holder(),
                Entity.Boat(b) => b.leash_holder(),
                _ => none,
            }
            if let h = held {
                holders.insert(h.id)
            }
        }
        var out = List<Shearable>()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(m) => {
                    if m.living.body.removed {
                        continue
                    }
                    let leashes = m.leash_holder() != none or holders.contains(m.living.body.id)
                    let ready = m.ready_for_shearing()
                    let armadillo = m.species == ARMADILLO
                    let chestable = m.chest_ready()
                    // A sulfur cube, which may swallow a block or be lit (CAL-402).
                    let cube = m.species == SULFUR_CUBE and m.living.alive()
                    if leashes or ready or armadillo or chestable or cube {
                        let holds = held_name(m.living.equipment[BODY_SLOT].copy())
                        out.push(Shearable { id: m.living.body.id, bounds: m.living.body.bounding_box(), species: m.species, leashes: leashes, ready: ready, brushable: armadillo and not m.baby(), chestable: chestable, swallower: cube and not m.baby(), holds: holds, lights: cube and m.sulfur_can_explode(), order: self.order_of(m.living.body.id) })
                    }
                },
                Entity.Boat(b) => {
                    if not b.body.removed and (b.leash_holder() != none or holders.contains(b.body.id)) {
                        out.push(Shearable { id: b.body.id, bounds: b.body.bounding_box(), species: -1, leashes: true, ready: false, order: self.order_of(b.body.id) })
                    }
                },
                Entity.Knot(k) => {
                    if not k.body.removed and holders.contains(k.body.id) {
                        out.push(Shearable { id: k.body.id, bounds: k.body.bounding_box(), species: -1, leashes: true, ready: false, order: self.order_of(k.body.id) })
                    }
                },
                _ => {},
            }
        }
        return out
    }

    /// A dispenser's chest put on the donkey or llama `id`, `take_chest` (CAL-378).
    pub fn chest_onto(mut self, id: i32) {
        if let lent = self.lend_mob(id) {
            var m = lent
            m.take_chest()
            self.give_back_mob(m)
        }
    }

    /// The ID of what holds the mob's or boat's leash `id`, where it's here and leashed (CAL-378).
    pub fn leash_holder_of(self, id: i32) -> i32? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let held = match e {
            Entity.Mob(m) => m.leash_holder(),
            Entity.Boat(b) => b.leash_holder(),
            _ => none,
        }
        let h = held else return none
        return some(h.id)
    }

    /// The entity `id`'s sound source, `getSoundSource`, and its block place's middle, where it's
    /// here (CAL-378).
    pub fn sound_place(self, id: i32) -> (i32, f64, f64, f64)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let b = body_of(e)
        return some((b.sound_source, b.x.floor() + 0.5, b.y.floor() + 0.5, b.z.floor() + 0.5))
    }

    /// Where the entity `id` comes among those here, as `wearers` gives it (CAL-378).
    pub fn order_in_sections(self, id: i32) -> (i32, i64, usize) {
        return self.order_of(id)
    }

    /// `dispenseEquipment`'s putting `stack` on the mob or armor stand `id` in the slot `slot`
    /// (CAL-378), as each puts it on.
    pub fn equip_from_dispenser<W: Wearing>(mut self, id: i32, slot: usize, stack: Tag, items: W, sounds: mut List<EntitySound>) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(match e {
            Entity.Mob(m) => {
                var t = m
                t.wear_from_dispenser(items, slot, stack, mut sounds)
                Entity.Mob(t)
            },
            Entity.Stand(a) => {
                var t = a
                t.put_on(items, slot, some(stack.copy()), mut sounds)
                Entity.Stand(t)
            },
            other => other,
        })
    }

    // Where the entity `id` comes as `found` walks the sections: its section's X, its section, and
    // its place in it.
    fn order_of(self, id: i32) -> (i32, i64, usize) {
        let key = self.section_of.get(id) ?? 0i64
        var at = 0usize
        if self.sections.contains(key) {
            for (n, o) in self.sections[key].enumerate() {
                if o == id {
                    at = n
                }
            }
        }
        return (i32.wrap(key >> 42), key, at)
    }

    /// What hoppers did to the entities here, `w`, put back (CAL-277): each item entity's stack
    /// that changed set again, `setItem`, sent again though it's the same; and each container's
    /// slots. The item entities all taken in, for the level to take out, `discard`.
    pub fn hopper_world_back(mut self, w: HopperWorld) -> List<i32> {
        var gone = List<i32>()
        for i in w.items {
            if not i.changed {
                continue
            }
            var it = self.lend(i.id) else continue
            match i.stack.copy() {
                some(stack) => {
                    it.stack = stack
                    it.stack_changed = true
                },
                none => gone.push(i.id),
            }
            self.give_back(it)
        }
        for c in w.boxes {
            if not c.changed {
                continue
            }
            if let lent = self.lend_cart(c.id) {
                var cart = lent
                cart.items = c.slots.copy()
                if c.unpacked {
                    cart.loot_table = none
                    cart.loot_seed = 0
                }
                self.give_back_cart(cart)
            } else if let lent = self.lend_boat(c.id) {
                var boat = lent
                boat.items = c.slots.copy()
                if c.unpacked {
                    boat.loot_table = none
                    boat.loot_seed = 0
                }
                self.give_back_boat(boat)
            }
        }
        return gone
    }

    /// The 27 slots of the chest boat or chest minecart `id`, none where it isn't one here
    /// (CAL-315).
    pub fn boat_items(self, id: i32) -> List<Tag?> {
        if not self.at.contains(id) {
            return List<Tag?>()
        }
        if let Entity.Boat(b) = self.all[self.at[id]] {
            return b.items.copy()
        }
        if let Entity.Cart(c) = self.all[self.at[id]] {
            return c.items.copy()
        }
        return List<Tag?>()
    }

    /// The minecart `id`'s body and type, where it's here, which its name's made of (CAL-315).
    pub fn cart_body(self, id: i32) -> (Body, String)? {
        if not self.at.contains(id) {
            return none
        }
        if let Entity.Cart(c) = self.all[self.at[id]] {
            return some((c.body.copy(), String(c.type_name())))
        }
        return none
    }

    /// Whether the entity `id` is here and a furnace minecart (CAL-315).
    /// Whether the minecart `id` is a command block minecart (CAL-388).
    pub fn cart_command(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        if let Entity.Cart(c) = self.all[self.at[id]] {
            return c.is_command()
        }
        return false
    }

    pub fn cart_furnace(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        if let Entity.Cart(c) = self.all[self.at[id]] {
            return c.is_furnace()
        }
        return false
    }

    /// `MinecartFurnace.addFuel` of the furnace minecart `id` from a player at `px`, `pz`
    /// (CAL-315): whether it took the fuel.
    pub fn fuel_cart(mut self, id: i32, px: f64, pz: f64) -> bool {
        var c = self.lend_cart(id) else return false
        let took = c.add_fuel(px, pz)
        self.give_back_cart(c)
        return took
    }

    /// Whether the entity `id` is here and a chest minecart (CAL-315).
    pub fn cart_has_chest(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        if let Entity.Cart(c) = self.all[self.at[id]] {
            return c.has_chest()
        }
        return false
    }

    /// The yaw of the boat `id`, where it's a boat here (CAL-315).
    pub fn boat_yaw(self, id: i32) -> f32? {
        if not self.at.contains(id) {
            return none
        }
        if let Entity.Boat(b) = self.all[self.at[id]] {
            return some(b.body.y_rot)
        }
        return none
    }

    /// Whether the entity `id` is here and a boat or a raft with a chest (CAL-315).
    pub fn boat_has_chest(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        if let Entity.Boat(b) = self.all[self.at[id]] {
            return b.has_chest()
        }
        return false
    }

    /// Whether the entity `id` is here and a boat or a raft (CAL-315).
    /// Whether the entity `id` is a minecart here (CAL-315).
    pub fn is_cart(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Cart(_) => true,
            _ => false,
        }
    }

    /// The minecart `id` taken out to be worked on, where it's a minecart here (CAL-315).
    pub fn lend_cart(mut self, id: i32) -> Minecart? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Cart(c) => {
                var lent = c
                lent.tnt_explodes = self.tnt_explodes
                return some(lent)
            },
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts back a minecart `lend_cart` took out; gone from here where it's been removed.
    pub fn give_back_cart(mut self, c: own Minecart) {
        let id = c.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        self.all[i] = some(Entity.Cart(c))
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    pub fn is_boat(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Boat(_) => true,
            _ => false,
        }
    }

    /// The block the falling block `id` is, where it's one (CAL-243).
    pub fn falling_state(self, id: i32) -> u32? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        return match slot {
            Entity.Falling(p) => some(p.state),
            _ => none,
        }
    }

    pub fn is_tnt(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Tnt(_) => true,
            _ => false,
        }
    }

    /// The category and place across of each mob that needn't stay, `isPersistenceRequired` and
    /// `requiresCustomPersistence`, in the order they came, as `createState` counts them.
    pub fn counted(self) -> List<(i32, f64, f64)> {
        var out = List<(i32, f64, f64)>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Mob(m) = e {
                    if not m.persistence_required and not m.custom_persistence() and not m.living.body.removed {
                        out.push((m.category, m.living.body.x, m.living.body.z))
                    }
                }
            }
        }
        return out
    }

    /// The boxes of those that block building, `blocksBuilding`: each mob and armor stand but a
    /// marker, each end crystal, and primed TNT (CAL-182).
    pub fn blocking(self) -> List<Aabb> {
        var out = List<Aabb>()
        for slot in self.all {
            if let e = slot {
                match e {
                    Entity.Stand(a) => {
                        if not a.marker() and not a.living.body.removed {
                            out.push(a.living.body.bounding_box())
                        }
                    },
                    Entity.Mob(m) => {
                        if not m.living.body.removed {
                            out.push(m.living.body.bounding_box())
                        }
                    },
                    Entity.Crystal(c) => {
                        if not c.body.removed {
                            out.push(c.body.bounding_box())
                        }
                    },
                    Entity.Tnt(p) => {
                        if not p.body.removed {
                            out.push(p.body.bounding_box())
                        }
                    },
                    _ => {},
                }
            }
        }
        return out
    }

    // The entity or player `id` come, after all that came before it (CAL-165).
    fn arrive(mut self, id: i32) {
        self.arrivals += 1
        self.arrival.insert(id, self.arrivals)
    }

    /// Every entity and player here, by ID, in the order they came, as vanilla's `EntityLookup`
    /// goes through them, `get(EntityTypeTest, consumer)`: none kept as it was read, gone or
    /// lent out (CAL-165).
    pub fn in_arrival_order(self) -> List<i32> {
        var order = List<(i64, i32)>()
        for (id, when) in self.arrival {
            if id < 0 {
                continue
            }
            if not self.players_in.contains(id) {
                if not self.at.contains(id) {
                    continue
                }
                let e = self.all[self.at[id]] else continue
                if body_of(e).removed {
                    continue
                }
            }
            order.push((when, id))
        }
        order.sort()
        var out = List<i32>()
        for (_, id) in order {
            out.push(id)
        }
        return out
    }

    /// Every entity whose box meets `b` and every player in the sections looked at, whose boxes
    /// the caller tests, in the order the entities' sections give them, as vanilla's
    /// `EntitySectionStorage.getEntities` does for a selector with a box (CAL-165).
    pub fn in_box_order(self, b: Aabb) -> List<i32> {
        var out = List<i32>()
        for id in self.found(b, -1, 16383 | PLAYERS | BOLTS | FALLING | BOATS | CARTS | HANGING) {
            if id < 0 {
                continue
            }
            if not self.players_in.contains(id) {
                let e = self.all[self.at[id]] else continue
                if body_of(e).removed {
                    continue
                }
            }
            out.push(id)
        }
        return out
    }

    /// What a selector reads of the entity `id`, which isn't a player, as `EntitySelector`'s
    /// tests read it (CAL-165); none where it isn't here or is gone.
    /// Whether the entity `id` may be picked, `isPickable` (CAL-358): a mob as its own says, an
    /// armor stand alive and no marker, and an end crystal; of the rest Calcite keeps, an item,
    /// an orb, a projectile or a cloud, none.
    pub fn pickable(self, id: i32) -> bool {
        if id < 0 or not self.at.contains(id) {
            return false
        }
        let e = self.all[self.at[id]] else return false
        if body_of(e).removed {
            return false
        }
        return match e {
            Entity.Mob(m) => m.pickable(),
            Entity.Stand(a) => not a.marker(),
            Entity.Crystal(_) => true,
            _ => false,
        }
    }

    pub fn picking(self, id: i32) -> Picking? {
        if id < 0 or not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let b = body_of(e)
        if b.removed {
            return none
        }
        let (kind, alive) = match e {
            Entity.Mob(m) => (String(type_name(m.species)), m.living.alive()),
            Entity.Stand(a) => (String("minecraft:armor_stand"), a.living.alive()),
            _ => {
                var named = String()
                if let Tag.Compound(t) = self.saved_alone(id) {
                    if t.contains("id") {
                        if let Tag.Str(s) = t["id"] {
                            named = s.copy()
                        }
                    }
                }
                (named, true)
            },
        }
        var tags = List<String>()
        if b.extras.contains("Tags") {
            if let Tag.List(items) = b.extras["Tags"] {
                for t in items {
                    if let Tag.Str(s) = t {
                        tags.push(s.copy())
                    }
                }
            }
        }
        let name: Tag? = if b.extras.contains("CustomName") { some(b.extras["CustomName"].copy()) } else { none }
        return some(Picking { id: id, kind: kind, uuid: b.uuid, x: b.x, y: b.y, z: b.z, x_rot: b.x_rot, y_rot: b.y_rot, bounds: box_of(e), eyes: b.eyes, alive: alive, tags: tags, name: name })
    }

    /// The entity here of the UUID `uuid`, which isn't a player, by its ID, where it isn't gone,
    /// as `getEntity` finds it (CAL-165).
    pub fn id_of_uuid(self, uuid: (i64, i64)) -> i32? {
        for id in self.in_arrival_order() {
            if self.players_in.contains(id) {
                continue
            }
            let e = self.all[self.at[id]] else continue
            if body_of(e).uuid == uuid {
                return some(id)
            }
        }
        return none
    }

    /// Their IDs, in the order they came.
    pub fn ids(self) -> List<i32> {
        var out = List<i32>()
        for slot in self.all {
            if let e = slot {
                out.push(id_of(e))
            }
        }
        return out
    }

    /// The item `id`, which must be here and an item. Its stack and place are the caller's to
    /// read.
    pub fn item(self, id: i32) -> ItemEntity {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Item(e) = slot else panic("{id} isn't an item")
        return e.copy()
    }

    /// The orb `id`, which must be here and an orb.
    pub fn orb(self, id: i32) -> ExperienceOrb {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Orb(o) = slot else panic("{id} isn't an orb")
        return o.copy()
    }

    /// The armor stand `id`, which must be here and an armor stand.
    pub fn stand(self, id: i32) -> ArmorStand {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Stand(a) = slot else panic("{id} isn't an armor stand")
        return a.copy()
    }

    /// The end crystal `id`, which must be here and an end crystal (D590).
    /// The kind of the fireball `id`, `world.fireball`'s, -1 where it isn't one (CAL-200).
    pub fn fireball_kind(self, id: i32) -> i32 {
        if not self.at.contains(id) {
            return -1
        }
        let slot = self.all[self.at[id]] else return -1
        return match slot {
            Entity.Fireball(b) => b.kind,
            _ => -1,
        }
    }

    pub fn crystal(self, id: i32) -> EndCrystal {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Crystal(c) = slot else panic("{id} isn't an end crystal")
        return c.copy()
    }

    /// What a merchant's menu asks of the mob `id`, `stillValid` (CAL-160): the entity ID of the
    /// player it trades with, whether it's alive, and its box; none where it isn't a mob here.
    pub fn merchant(self, id: i32) -> (i32?, bool, Aabb)? {
        if not self.is_mob(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Mob(m) = slot else return none
        let trading: i32? = if let t = m.trading { some(t.id) } else { none }
        return some((trading, m.living.alive(), m.living.body.bounding_box()))
    }

    /// A merchant's offers, its level and its experience, which its menu's sent, for the mob `id`
    /// (CAL-160); none where it isn't a mob here.
    pub fn merchant_offers(self, id: i32) -> (List<Tag>, i32, i32)? {
        if not self.is_mob(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Mob(m) = slot else return none
        return some((m.offers(), m.villager_level(), m.villager_xp))
    }

    /// Whether the mob `id` is a raider that may join a raid and is in none, alive and idle no
    /// more than 2400 ticks, `Raids.canJoinRaid` (CAL-167).
    pub fn may_join_raid(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Mob(m) = slot else return false
        return raider_kind(m.species) and m.can_join_raid and m.raid == none and m.living.alive() and m.no_action_time <= 2400
    }

    /// The mob `id`, which must be here and a mob.
    pub fn mob(self, id: i32) -> Mob {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Mob(m) = slot else panic("{id} isn't a mob")
        return m.copy()
    }

    /// The chickens here a baby zombie being finalized may ride, `ENTITY_NOT_BEING_RIDDEN`
    /// (D709): alive, neither riding nor ridden, in the order they came.
    /// For the villager `id` asking for an iron golem at the game time `now` (CAL-201), its box
    /// `b` as its brain ticked: the villagers whose boxes meet that grown by 10, it among them, as
    /// `getEntitiesOfClass` finds them, and how many of them want one, `wantsToSpawnGolem`. None
    /// where it's gone.
    pub fn golem_callers(self, id: i32, now: i64, b: Aabb) -> (List<i32>, i32)? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Mob(me) = slot else return none
        let grown = Aabb { min_x: b.min_x - 10.0, min_y: b.min_y - 10.0, min_z: b.min_z - 10.0, max_x: b.max_x + 10.0, max_y: b.max_y + 10.0, max_z: b.max_z + 10.0 }
        var villagers = List<i32>()
        var wanting = if me.wants_golem_at(now) { 1 } else { 0 }
        villagers.push(id)
        for o in self.found(grown, id, 8) {
            let other = self.all[self.at[o]] else continue
            let Entity.Mob(m) = other else continue
            if m.species != VILLAGER {
                continue
            }
            villagers.push(o)
            if m.wants_golem_at(now) {
                wanting += 1
            }
        }
        return some((villagers, wanting))
    }

    /// `GolemSensor.golemDetected` of each of the villagers `ids` here, where one summoned an
    /// iron golem (CAL-201).
    pub fn golem_seen_by(mut self, ids: List<i32>) {
        for id in ids {
            var m = self.lend_mob(id) else continue
            m.golem_seen()
            self.give_back_mob(m)
        }
    }

    pub fn free_chickens(self) -> List<FreeChicken> {
        var out = List<FreeChicken>()
        for slot in self.all {
            let e = slot else continue
            if let Entity.Mob(m) = e {
                if let c = self.free_chicken(m.living.body.id) {
                    out.push(c)
                }
            }
        }
        return out
    }

    /// The chicken `id` as `free_chickens` has it, where it's here, a chicken and free (D709).
    pub fn free_chicken(self, id: i32) -> FreeChicken? {
        if not self.at.contains(id) or not self.section_of.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Mob(m) = slot else return none
        let b = m.living.body.copy()
        if m.species != CHICKEN or not m.living.alive() or b.vehicle != none or not b.passengers.is_empty() {
            return none
        }
        let key = self.section_of[id]
        var at: usize = 0
        for (i, other) in self.sections[key].enumerate() {
            if other == id {
                at = i
            }
        }
        let sx = i32.wrap(key >> 42)
        let sz = i32.wrap((key << 22) >> 42)
        let sy = i32.wrap((key << 44) >> 44)
        return some(FreeChicken { id: id, bounds: b.bounding_box(), sx: sx, sy: sy, sz: sz, key: key, at: at })
    }

    /// The chicken `vehicle` a baby zombie `rider` rode as it was finalized (D709), taking it
    /// before it's added: a jockey's mount, `setChickenJockey`, with `rider` last of what rides
    /// it, `addPassenger`.
    pub fn seat_made(mut self, rider: i32, vehicle: i32) {
        if not self.at.contains(vehicle) {
            return
        }
        let i = self.at[vehicle]
        let held = self.all[i].take() else return
        self.all[i] = some(match held {
            Entity.Mob(m) => {
                var t = m
                t.jockey = true
                t.living.body.passengers.push(rider)
                Entity.Mob(t)
            },
            other => other,
        })
    }

    /// The ender dragons among them that are alive, `getDragons`, in the order they came (D625).
    pub fn alive_dragons(self) -> List<Mob> {
        var out = List<Mob>()
        for slot in self.all {
            let e = slot else continue
            if let Entity.Mob(m) = e {
                if m.dragon != none and m.living.alive() {
                    out.push(m.copy())
                }
            }
        }
        return out
    }

    /// The arrow `id`, which must be here and an arrow (CAL-159).
    pub fn arrow(self, id: i32) -> Arrow {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Arrow(a) = slot else panic("{id} isn't an arrow")
        return a.copy()
    }

    /// What the entity `id`, which must be here, is saved as, `saveAsPassenger`, with what rides
    /// it, here, each so in turn, `Passengers` (D708).
    pub fn saved(self, id: i32) -> Tag {
        let own_tag = self.saved_alone(id)
        let riders = self.passengers_of(id)
        if riders.is_empty() {
            return own_tag
        }
        // Each where it rides across and at its own height, `saveWithoutId`'s `Pos`.
        let (vx, _, vz) = self.place(id) ?? (0.0, 0.0, 0.0)
        var list = List<Tag>()
        for p in riders {
            if self.at.contains(p) and self.all[self.at[p]] != none {
                let rider = self.saved(p)
                let (_, py, _) = self.place(p) ?? (0.0, 0.0, 0.0)
                if let Tag.Compound(rm) = rider {
                    var t = rm.copy()
                    t.insert(String("Pos"), Tag.List([Tag.Double(vx), Tag.Double(py), Tag.Double(vz)]))
                    list.push(Tag.Compound(t))
                } else {
                    list.push(rider)
                }
            }
        }
        // None where only players ride it, who aren't saved with it (CAL-179).
        if list.is_empty() {
            return own_tag
        }
        let Tag.Compound(m) = own_tag else return own_tag
        var t = m.copy()
        t.insert(String("Passengers"), Tag.List(list))
        return Tag.Compound(t)
    }

    /// Whether the entity `id` is saved by itself, `Entity.save`: what rides something is saved
    /// with it, not by itself (D708).
    pub fn saved_by_itself(self, id: i32) -> bool {
        return self.vehicle_of(id) == none
    }

    /// The entity `id`'s passengers, theirs first, then each, depth first, as
    /// `getPassengersAndSelf` goes, without `id` (D708).
    pub fn riders_under(self, id: i32) -> List<i32> {
        var out = List<i32>()
        for p in self.passengers_of(id) {
            for q in self.riders_under(p) {
                out.push(q)
            }
            out.push(p)
        }
        return out
    }

    /// Whether exactly one player rides the entity `id` or what rides it,
    /// `hasExactlyOnePlayerPassenger` (CAL-328): such a vehicle is saved with the player, not
    /// with its chunk.
    pub fn one_player_rides(self, id: i32) -> bool {
        var count = 0
        for r in self.riders_under(id) {
            if self.players_in.contains(r) {
                count += 1
            }
        }
        return count == 1
    }

    /// The UUID of the entity `id`, where it's here and not lent (CAL-328).
    pub fn uuid_at(self, id: i32) -> (i64, i64)? {
        let b = self.body_at(id) else return none
        return some(b.uuid)
    }

    // What the entity `id` is saved as by itself.
    fn saved_alone(self, id: i32) -> Tag {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        return match slot {
            Entity.Item(e) => e.saved(),
            Entity.Orb(o) => o.saved(),
            Entity.Stand(a) => a.saved(),
            Entity.Mob(m) => m.saved(),
            Entity.Arrow(a) => a.saved(),
            Entity.Thrown(p) => p.saved(),
            Entity.Cloud(c) => c.saved(),
            Entity.Crystal(c) => c.saved(),
            Entity.Eye(e) => e.saved(),
            Entity.Fireball(b) => b.saved(),
            Entity.Tnt(p) => p.saved(),
            Entity.Falling(p) => p.saved(),
            Entity.Boat(p) => p.saved(),
            Entity.Cart(p) => p.saved(),
            Entity.Knot(p) => p.saved(),
            Entity.Hanging(p) => p.saved(),
            Entity.Fangs(p) => p.saved(),
            Entity.Bolt(p) => p.saved(),
        }
    }

    /// Adds the item `e`, last in the tick list and in its section, `addFreshEntity`.
    pub fn add(mut self, e: own ItemEntity) {
        let id = e.body.id
        let key = section_key(e.body.x, e.body.y, e.body.z)
        self.put_new(id, key, Entity.Item(e))
    }

    /// Adds the orb `o`, as `add` adds an item.
