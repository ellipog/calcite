/// The entities in a level that Calcite runs, item entities, experience orbs, armor stands and
/// mobs (CAL-148, CAL-154, CAL-155, CAL-156), as vanilla's `PersistentEntitySectionManager` and `EntityTickList` keep them: in the
/// order they came, the order they tick in, and by the section each is in, in the order each came
/// into it, so `find` and its kin give them in the order `EntitySectionStorage.getEntities` does,
/// section by section. One that goes is out of both at once, so nothing after finds it, and its ID
/// is kept for its trackers to tell.
///
/// Each tick, `tick` runs each there was as it began whose chunk is in range to tick its
/// entities, as `ServerLevel.tick` runs the tick list: an item's tick to where it merges, then its
/// merging with the items near it, `mergeWithNeighbours`, then the rest; an orb's to where it looks
/// for orbs to take in, `scanForMerges`, then that, then the rest; an armor stand's and a mob's,
/// what it shows besides its sounds kept with its ID for the server to send among them, a mob's
/// after its look at whether it goes, `checkDespawn`, which may take it, and before its pushes,
/// `pushEntities`, of the mobs and players it meets (CAL-156). One that comes during a tick first
/// ticks the next. The players of the level are in the same list, so the server ticks these
/// one at a time, `tick_next`, those that came before each player first. Vanilla's list holds only
/// the entities of chunks that tick them, adding a chunk's in its sections' order as it comes to
/// tick them, where Calcite's keeps every one in the order it came and passes over those that
/// don't tick.
///
/// A chunk's entities are saved in its sections' order, `in_chunk`, as `storeChunkSections` saves
/// them (CAL-148). The entities read that Calcite doesn't have yet have places in the sections
/// too, by IDs below 0 the caller gives them, `place_kept`, so they're saved among the rest in the
/// order they came into each, though nothing finds or ticks them.
module world.entities

import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import world.attributes.{Wearing}
import world.body.{BodyFacts, EntitySound, push_between}
import world.collision.{Aabb, CollisionBlocks}
import world.damage.{DamageTypes}
import world.experience_orb.{ExperienceOrb, Follower, can_merge}
import world.goals.{Kin}
import world.inside.{Acted, Rain}
import world.item_entity.{ItemEntity}
import world.living.{ArmorStand, LivingFacts, Shown}
import world.menu.{same_components}
import world.living.{Warding}
import world.mob.{Mob, MobLight}
import world.movement.{MovementStates}
import world.navigation.{NavLevel}
import world.paths.{PathTypeCache}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}

/// Which chunks tick their entities, `inEntityTickingRange`.
pub interface EntityTicking {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool
}

/// How many of a stack's item make a whole stack, `ItemStack.getMaxStackSize`.
pub interface StackSizes {
    fn stack_most(self, stack: Tag) -> i32
}

impl StackSizes for ItemCodecs {
    fn stack_most(self, stack: Tag) -> i32 {
        return self.max_stack_size(stack)
    }
}

/// An entity of the list: an item entity, an experience orb, an armor stand or a mob.
pub enum Entity {
    Item(ItemEntity)
    Orb(ExperienceOrb)
    Stand(ArmorStand)
    Mob(Mob)
}

/// A level's entities.
pub struct Entities {
    // In the order they came, `none` where one's gone; each one's place, by ID; how many places
    // are empty.
    all: List<Entity?> = List<Entity?>()
    at: Map<i32, usize> = Map<i32, usize>()
    empty: usize = 0
    // The entities in each section, by `SectionPos.asLong`, in the order they came into it, and
    // the section each is in.
    sections: Map<i64, List<i32>> = Map<i64, List<i32>>()
    section_of: Map<i32, i64> = Map<i32, i64>()
    // Each chunk's sections that have something in them, by `ChunkPos.pack`.
    chunk_sections: Map<i64, List<i64>> = Map<i64, List<i64>>()
    /// The IDs of those gone since they were last taken, in the order they went, and how many of
    /// the sounds of the tick going on had been played as each went.
    pub gone: List<i32> = List<i32>()
    pub gone_after: List<usize> = List<usize>()
    /// What the living entities showed since it was last taken, `Living.shown`, in the order they
    /// showed it, the ID of each that showed it, and how many of the sounds of the tick going on
    /// had been played as it did.
    pub shown: List<Shown> = List<Shown>()
    pub shown_by: List<i32> = List<i32>()
    pub shown_after: List<usize> = List<usize>()
    /// Whether the level's in peaceful, which mobs of types not allowed in it go in; and the game
    /// rule `max_entity_cramming`, how many pushing a mob at once it may take (CAL-156).
    pub peaceful: bool = false
    pub cramming: i32 = 24
    /// The game rule `mob_drops`, which lets a mob's breeding make an orb (CAL-158).
    pub mob_drops: bool = true
    /// The level's game time this tick, which a mob's panic reads its last hurt by (D416); and
    /// whether it's on hard, which a zombie hurt in its own tick draws for reinforcements on
    /// (D424).
    pub game_time: i64 = 0
    pub hard: bool = false
    // The mob that bred in the tick going on, whose push, `pushEntities`, waits till the level's
    // made its baby, as vanilla makes it in the goal's tick, before the push (D415).
    push_after: i32? = none
    // The tick going on: the next place to tick, the places there were as it began, and the
    // sounds played so far in the entity's tick.
    cursor: usize = 0
    end: usize = 0
    heard: usize = 0
    // The level's path types, `PathTypeCache`, and how many of the blocks it sent again it's read
    // (CAL-157).
    path_types: PathTypeCache = PathTypeCache()
    sent_seen: u64 = 0
}

impl Entities {
    /// None.
    pub fn new() -> Entities {
        return Entities()
    }

    /// How many there are.
    pub fn len(self) -> usize {
        return self.at.len()
    }

    /// Whether the entity `id` is here.
    pub fn contains(self, id: i32) -> bool {
        return self.at.contains(id)
    }

    /// Whether the entity `id` is here and an orb.
    pub fn is_orb(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Orb(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and an armor stand.
    pub fn is_stand(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Stand(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is here and a mob.
    pub fn is_mob(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(_) => true,
            _ => false,
        }
    }

    /// The category and place across of each mob that needn't stay, `isPersistenceRequired` and
    /// `requiresCustomPersistence`, in the order they came, as `createState` counts them.
    pub fn counted(self) -> List<(i32, f64, f64)> {
        var out = List<(i32, f64, f64)>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Mob(m) = e {
                    if not m.persistence_required and not m.custom_persistence() and not m.living.body.removed {
                        out.push((m.category, m.living.body.x, m.living.body.z))
                    }
                }
            }
        }
        return out
    }

    /// The boxes of those that block building, `blocksBuilding`: each mob and armor stand but a
    /// marker.
    pub fn blocking(self) -> List<Aabb> {
        var out = List<Aabb>()
        for slot in self.all {
            if let e = slot {
                match e {
                    Entity.Stand(a) => {
                        if not a.marker() and not a.living.body.removed {
                            out.push(a.living.body.bounding_box())
                        }
                    },
                    Entity.Mob(m) => {
                        if not m.living.body.removed {
                            out.push(m.living.body.bounding_box())
                        }
                    },
                    _ => {},
                }
            }
        }
        return out
    }

    /// Their IDs, in the order they came.
    pub fn ids(self) -> List<i32> {
        var out = List<i32>()
        for slot in self.all {
            if let e = slot {
                out.push(id_of(e))
            }
        }
        return out
    }

    /// The item `id`, which must be here and an item. Its stack and place are the caller's to
    /// read.
    pub fn item(self, id: i32) -> ItemEntity {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Item(e) = slot else panic("{id} isn't an item")
        return e.copy()
    }

    /// The orb `id`, which must be here and an orb.
    pub fn orb(self, id: i32) -> ExperienceOrb {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Orb(o) = slot else panic("{id} isn't an orb")
        return o.copy()
    }

    /// The armor stand `id`, which must be here and an armor stand.
    pub fn stand(self, id: i32) -> ArmorStand {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Stand(a) = slot else panic("{id} isn't an armor stand")
        return a.copy()
    }

    /// The mob `id`, which must be here and a mob.
    pub fn mob(self, id: i32) -> Mob {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        let Entity.Mob(m) = slot else panic("{id} isn't a mob")
        return m.copy()
    }

    /// What the entity `id`, which must be here, is saved as, `saveAsPassenger`.
    pub fn saved(self, id: i32) -> Tag {
        let slot = self.all[self.at[id]] else panic("no entity {id}")
        return match slot {
            Entity.Item(e) => e.saved(),
            Entity.Orb(o) => o.saved(),
            Entity.Stand(a) => a.saved(),
            Entity.Mob(m) => m.saved(),
        }
    }

    /// Adds the item `e`, last in the tick list and in its section, `addFreshEntity`.
    pub fn add(mut self, e: own ItemEntity) {
        let id = e.body.id
        let key = section_key(e.body.x, e.body.y, e.body.z)
        self.put_new(id, key, Entity.Item(e))
    }

    /// Adds the orb `o`, as `add` adds an item.
    pub fn add_orb(mut self, o: own ExperienceOrb) {
        let id = o.body.id
        let key = section_key(o.body.x, o.body.y, o.body.z)
        self.put_new(id, key, Entity.Orb(o))
    }

    /// Adds the armor stand `a`, as `add` adds an item.
    pub fn add_stand(mut self, a: own ArmorStand) {
        let id = a.living.body.id
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        self.put_new(id, key, Entity.Stand(a))
    }

    /// Adds the mob `m`, as `add` adds an item.
    pub fn add_mob(mut self, m: own Mob) {
        let id = m.living.body.id
        let key = section_key(m.living.body.x, m.living.body.y, m.living.body.z)
        self.put_new(id, key, Entity.Mob(m))
    }

    fn put_new(mut self, id: i32, key: i64, e: own Entity) {
        self.at.insert(id, self.all.len())
        self.all.push(some(e))
        self.into_section(id, key)
    }

    /// Takes the entity `id` away, `discard`, if it's here.
    pub fn remove(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        self.all[i] = none
        _ = self.at.remove(id)
        self.empty += 1
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
        self.gone.push(id)
        self.gone_after.push(self.heard)
    }

    /// Takes what the living entities showed since last asked, leaving who showed each and when
    /// for the caller to have read first.
    pub fn take_shown(mut self) -> List<Shown> {
        var out = List<Shown>()
        for e in self.shown {
            out.push(e.copy())
        }
        self.shown.clear()
        self.shown_by.clear()
        self.shown_after.clear()
        return out
    }

    /// Takes the IDs of those gone since last asked.
    pub fn take_gone(mut self) -> List<i32> {
        var out = List<i32>()
        for id in self.gone {
            out.push(id)
        }
        self.gone.clear()
        self.gone_after.clear()
        return out
    }

    /// Takes the item `id` out to be worked on, leaving its place, for `give_back` to put it back
    /// in; `none` if it isn't here, is out already, or isn't an item.
    pub fn lend(mut self, id: i32) -> ItemEntity? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Item(e) => return some(e),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts back an item `lend` took out, moving it to the section it's in now.
    pub fn give_back(mut self, e: own ItemEntity) {
        let id = e.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let removed = e.body.removed
        self.all[i] = some(Entity.Item(e))
        if not removed {
            self.move_section(id, key)
        }
    }

    /// Takes the orb `id` out to be worked on, as `lend` takes an item.
    pub fn lend_orb(mut self, id: i32) -> ExperienceOrb? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Orb(o) => return some(o),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts back an orb `lend_orb` took out, as `give_back` puts back an item.
    pub fn give_back_orb(mut self, o: own ExperienceOrb) {
        let id = o.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(o.body.x, o.body.y, o.body.z)
        let removed = o.body.removed
        self.all[i] = some(Entity.Orb(o))
        if not removed {
            self.move_section(id, key)
        }
    }

    /// Takes the armor stand `id` out to be worked on, as `lend` takes an item.
    pub fn lend_stand(mut self, id: i32) -> ArmorStand? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Stand(a) => return some(a),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts back an armor stand `lend_stand` took out, as `give_back` puts back an item.
    pub fn give_back_stand(mut self, a: own ArmorStand) {
        let id = a.living.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        self.all[i] = some(Entity.Stand(a))
        if not removed {
            self.move_section(id, key)
        }
    }

    /// Takes the mob `id` out to be worked on, as `lend` takes an item.
    pub fn lend_mob(mut self, id: i32) -> Mob? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Mob(m) => return some(m),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts back a mob `lend_mob` took out, as `give_back` puts back an item.
    pub fn give_back_mob(mut self, m: own Mob) {
        let id = m.living.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(m.living.body.x, m.living.body.y, m.living.body.z)
        let removed = m.living.body.removed
        self.all[i] = some(Entity.Mob(m))
        if not removed {
            self.move_section(id, key)
        }
    }

    /// The chunks with entities or kept ones in them, `getAllChunksWithExistingSections`.
    pub fn chunks(self) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for (k, _) in self.chunk_sections {
            out.push(ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) })
        }
        return out
    }

    /// The entities in the chunk at `pos`, and the kept ones, in the order
    /// `getExistingSectionsInChunk` gives them: its sections by `SectionPos.asLong`, and in each
    /// in the order they came into it.
    pub fn in_chunk(self, pos: ChunkPos) -> List<i32> {
        let k = pos.pack()
        if not self.chunk_sections.contains(k) {
            return List<i32>()
        }
        var keys = self.chunk_sections[k].copy()
        keys.sort()
        var out = List<i32>()
        for key in keys {
            for id in self.sections[key] {
                out.push(id)
            }
        }
        return out
    }

    /// Gives the entity `id`, one Calcite keeps as it was read, below 0, a place last in the
    /// section of x, y, z, as `addEntity` does.
    pub fn place_kept(mut self, id: i32, x: f64, y: f64, z: f64) {
        self.into_section(id, section_key(x, y, z))
    }

    /// Takes the kept entity `id` out of its section, as it's let go of.
    pub fn remove_kept(mut self, id: i32) {
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
    }

    /// Where the entity `id` is, if it's here.
    pub fn place(self, id: i32) -> (f64, f64, f64)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(place_of(e))
    }

    /// The items whose boxes meet `b`, but `except`, in the order `getEntitiesOfClass` finds them:
    /// the sections a little beyond it, by x, then by z and y as `SectionPos.asLong` orders them,
    /// and in each in the order they came into it.
    pub fn find(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 1)
    }

    /// The orbs whose boxes meet `b`, but `except`, as `find` finds items.
    pub fn find_orbs(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 2)
    }

    /// Every item and orb whose box meets `b`, but `except`, as `getEntities` finds them, which a
    /// player touches; an armor stand does nothing touched, `playerTouch`.
    pub fn find_any(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 3)
    }

    /// The armor stands and mobs whose boxes meet `b`, but `except`, as `getEntitiesOfClass` finds
    /// living entities but players, which a sweep hits (D417).
    pub fn find_living(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 12)
    }

    // Those of the kinds `kinds` whose boxes meet `b`, 1 items, 2 orbs, 4 armor stands and 8 mobs.
    fn found(self, b: Aabb, except: i32, kinds: i32) -> List<i32> {
        var out = List<i32>()
        let x0 = section(b.min_x - 2.0)
        let y0 = section(b.min_y - 4.0)
        let z0 = section(b.min_z - 2.0)
        let x1 = section(b.max_x + 2.0)
        let y1 = section(b.max_y + 0.0)
        let z1 = section(b.max_z + 2.0)
        for sx in x0..=x1 {
            var keys = List<i64>()
            for sz in z0..=z1 {
                for sy in y0..=y1 {
                    let key = pack(sx, sy, sz)
                    if self.sections.contains(key) and not self.sections[key].is_empty() {
                        keys.push(key)
                    }
                }
            }
            keys.sort()
            for key in keys {
                for id in self.sections[key] {
                    if id == except or not self.at.contains(id) {
                        continue
                    }
                    let e = self.all[self.at[id]] else continue
                    let kind = match e {
                        Entity.Item(_) => 1,
                        Entity.Orb(_) => 2,
                        Entity.Stand(_) => 4,
                        Entity.Mob(_) => 8,
                    }
                    if kind & kinds == 0 {
                        continue
                    }
                    let other = box_of(e)
                    if other.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        out.push(id)
                    }
                }
            }
        }
        return out
    }

    /// `ExperienceOrb.tryMergeToExisting`: the first orb in the box a block across around x, y,
    /// z that `can_merge` with `pick`, the level random's `nextInt(40)`, and `value` counts one
    /// more and starts its age again; whether there was one.
    pub fn merge_award(mut self, x: f64, y: f64, z: f64, value: i32, pick: i32) -> bool {
        let b = Aabb { min_x: x - 0.5, min_y: y - 0.5, min_z: z - 0.5, max_x: x + 0.5, max_y: y + 0.5, max_z: z + 0.5 }
        for id in self.find_orbs(b, -1) {
            let o = self.orb_view(id) else continue
            if not can_merge(o, pick, value) {
                continue
            }
            var taken = self.lend_orb(id) else continue
            taken.count += 1
            taken.age = 0
            self.give_back_orb(taken)
            return true
        }
        return false
    }

    // The orb `id`, where it's here and an orb, to read.
    fn orb_view(self, id: i32) -> ExperienceOrb? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Orb(o) = slot else return none
        return some(o.copy())
    }

    /// A tick of every entity there is that ticks, as `ServerLevel.tick` runs its tick list, among
    /// `blocks`, in a level whose floor is `min_y`, where lava's fast if `fast_lava`, with no
    /// players for orbs to follow; the sounds they play go to `sounds`.
    pub fn tick<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding, S: StackSizes + Wearing>(mut self, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.begin_tick()
        let nobody = List<Follower>()
        while self.tick_next(u64.MAX, f, m, t, lf, codecs, blocks, min_y, fast_lava, nobody, mut sounds) {}
        self.end_tick()
    }

    /// Starts a tick of the entities there are now.
    pub fn begin_tick(mut self) {
        self.cursor = 0
        self.end = self.all.len()
    }

    /// Ticks the tick's next entity if it came into the level before `before`, as `tick` does,
    /// orbs following `players`, the level's in its order, and says whether there was one; the
    /// sounds it plays go to `sounds`, which starts empty.
    pub fn tick_next<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding, S: StackSizes + Wearing>(mut self, before: u64, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        self.take_sent(lf, f, m, blocks, min_y)
        while self.cursor < self.end {
            match self.all[self.cursor] {
                some(_) => break,
                none => self.cursor += 1,
            }
        }
        if self.cursor >= self.end {
            return false
        }
        let i = self.cursor
        let taken = self.all[i].take() else return false
        let (x, _, z) = place_of(taken)
        if entered_of(taken) >= before {
            self.all[i] = some(taken)
            return false
        }
        self.cursor += 1
        self.heard = 0
        let ticks = blocks.ticks_entities(i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
        match taken {
            Entity.Item(e) => {
                if ticks {
                    self.tick_item(i, e, f, m, t, lf.damage, codecs, blocks, min_y, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Item(e))
                }
            },
            Entity.Orb(o) => {
                if ticks {
                    self.tick_orb(i, o, f, m, t, lf.damage, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Orb(o))
                }
            },
            Entity.Stand(a) => {
                if ticks {
                    self.tick_stand(i, a, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Stand(a))
                }
            },
            Entity.Mob(mob) => {
                if ticks {
                    self.tick_mob(i, mob, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Mob(mob))
                }
            },
        }
        return true
    }

    // The blocks the level sent again since they were last read, as `sendBlockUpdated` takes each:
    // its path type forgotten, and where its shape changed, the paths of the mobs it's near enough
    // found again, `shouldRecomputePath`, in the order the mobs came, which vanilla's
    // `navigatingMobs` holds in no order of its own, finding the same paths in any.
    fn take_sent<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32) {
        let total = blocks.sent_total()
        var i = blocks.sent_first()
        if self.sent_seen > i {
            i = self.sent_seen
        }
        self.sent_seen = total
        if i >= total {
            return
        }
        var going = List<i32>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Mob(mob) = e {
                    if mob.navigating() {
                        going.push(mob.living.body.id)
                    }
                }
            }
        }
        while i < total {
            let b = blocks.sent_at(i)
            i += 1
            self.path_types.invalidate(b.x, b.y, b.z)
            if going.is_empty() or m.same_shape(f, b.old, b.now, b.x, b.z) {
                continue
            }
            for id in going {
                var mob = self.lend_mob(id) else continue
                mob.block_changed(lf, f, m, blocks, mut self.path_types, min_y, b.x, b.y, b.z)
                self.give_back_mob(mob)
            }
        }
    }

    // A mob's tick, at `i`: its look at whether it goes, `checkDespawn`, from the nearest of
    // `players` that isn't a spectator, then where it stays its tick, as an armor stand's.
    fn tick_mob<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding, W: Wearing>(mut self, i: usize, mob: own Mob, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        var nearest: f64? = none
        for p in players {
            if p.spectator {
                continue
            }
            let dx = p.x - a.living.body.x
            let dy = p.y - a.living.body.y
            let dz = p.z - a.living.body.z
            let d = dx * dx + dy * dy + dz * dz
            match nearest {
                some(b) => {
                    if d < b {
                        nearest = some(d)
                    }
                },
                none => nearest = some(d),
            }
        }
        if a.check_despawn(self.peaceful, nearest) {
            a.living.body.removed = true
            self.all[i] = some(Entity.Mob(a))
            self.remove(id)
            return
        }
        if a.wants_kin() {
            a.kin = self.kin_near(a.living.body.bounding_box(), id)
        }
        a.mob_drops = self.mob_drops
        a.game_time = self.game_time
        a.hard = self.hard
        a.tick(lf, f, m, t, blocks, items, mut self.path_types, players, min_y, fast_lava, mut sounds)
        a.kin.clear()
        var bred = false
        for k in 0..a.living.shown.len() {
            if let Shown.Bred(_) = a.living.shown[k] {
                bred = true
            }
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        self.all[i] = some(Entity.Mob(a))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else if bred {
            self.move_section(id, key)
            self.push_after = some(id)
        } else {
            self.move_section(id, key)
            self.push_entities(id, lf, f, blocks, players)
        }
    }

    // The mobs whose boxes meet the box 16 beyond `b` on every side, but `except`, as `found` finds
    // them, as the goals of a mob there read them, `getEntitiesOfClass`'s for its kind within less,
    // and its parent's to 16 away (CAL-158).
    fn kin_near(self, b: Aabb, except: i32) -> List<Kin> {
        let wide = Aabb { min_x: b.min_x - 16.0, min_y: b.min_y - 16.0, min_z: b.min_z - 16.0, max_x: b.max_x + 16.0, max_y: b.max_y + 16.0, max_z: b.max_z + 16.0 }
        var out = List<Kin>()
        for id in self.found(wide, except, 8) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Mob(o) = slot else continue
            out.push(Kin {
                id: id,
                species: o.species,
                x: o.living.body.x,
                y: o.living.body.y,
                z: o.living.body.z,
                eyes: o.living.body.eyes,
                bounds: o.living.body.bounding_box(),
                age: o.age,
                in_love: o.in_love > 0,
                alive: o.living.alive(),
                panicking: o.goals.panicking(),
                variant: o.breed_variant(),
            })
        }
        return out
    }

    /// The push of the mob that bred in the entity's tick just done, once the level's made its baby
    /// and orb, which it then meets (D415).
    pub fn push_bred<B: CollisionBlocks + EntityTicking>(mut self, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        if let id = self.push_after {
            self.push_after = none
            self.push_entities(id, lf, f, blocks, players)
        }
    }

    // `pushEntities` for the mob `id` (CAL-156), which ends its `aiStep` in vanilla and comes here
    // after its tick, as nothing after it there reads its motion: the mobs whose boxes meet its
    // own that may be pushed, `getPushableEntities`, as `found` finds them, then the players of
    // `players` that may be; where they're as many as the game rule `max_entity_cramming` or more,
    // a draw of 4 from its own random, and on a 0, with as many not riding, its hurt by cramming,
    // which waits for damage (P6.5); then each pushes and is pushed, `doPush`. The players' own
    // pushes aren't kept, as Calcite's server doesn't move them, and they're found after the mobs
    // where vanilla finds each in its section among them.
    fn push_entities<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        let me = self.lend_mob(id) else return
        let b = me.living.body.bounding_box()
        self.give_back_mob(me)
        var mobs = List<i32>()
        for other in self.found(b, id, 8) {
            if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
            }
        }
        var people = List<(f64, f64)>()
        for p in players {
            if let pb = p.pushable {
                if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                    people.push((p.x, p.z))
                }
            }
        }
        let n = mobs.len() + people.len()
        if n == 0 {
            return
        }
        if self.cramming > 0 and n > usize.wrap(self.cramming - 1) {
            var drawing = self.lend_mob(id) else return
            _ = drawing.living.body.random.next_int_below(4)
            self.give_back_mob(drawing)
        }
        for other in mobs {
            self.push_pair(id, other, lf, f, blocks)
        }
        for (px, pz) in people {
            var mover = self.lend_mob(id) else return
            if not mover.living.body.no_physics {
                let pushed = push_between(px, pz, mover.living.body.x, mover.living.body.z)
                if let q = pushed {
                    let (xa, za) = q
                    let ticking = ticking_at(blocks, mover.living.body.x, mover.living.body.z)
                    if mover.pushable(lf, f, blocks, ticking) {
                        mover.living.body.push(xa, 0.0, za)
                    }
                }
            }
            self.give_back_mob(mover)
        }
    }

    // `Entity.push(entity)` of the mob `other` by the mob `pusher`: where neither has no physics
    // and they're far enough apart across, each that may be pushed pushed away from the other.
    fn push_pair<B: CollisionBlocks + EntityTicking>(mut self, pusher: i32, other: i32, lf: LivingFacts, f: Facts, blocks: B) {
        var a = self.lend_mob(pusher) else return
        var o = self.lend_mob(other) else {
            self.give_back_mob(a)
            return
        }
        if not a.living.body.no_physics and not o.living.body.no_physics {
            let pushed = push_between(o.living.body.x, o.living.body.z, a.living.body.x, a.living.body.z)
            if let q = pushed {
                let (xa, za) = q
                let other_ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                if o.pushable(lf, f, blocks, other_ticks) {
                    o.living.body.push(-xa, 0.0, -za)
                }
                let pusher_ticks = ticking_at(blocks, a.living.body.x, a.living.body.z)
                if a.pushable(lf, f, blocks, pusher_ticks) {
                    a.living.body.push(xa, 0.0, za)
                }
            }
        }
        self.give_back_mob(o)
        self.give_back_mob(a)
    }

    // Whether the mob `id` may be pushed, `isPushable`, as `getPushableEntities` asks.
    fn mob_pushable<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        var m = self.lend_mob(id) else return false
        let ticks = ticking_at(blocks, m.living.body.x, m.living.body.z)
        let p = m.pushable(lf, f, blocks, ticks)
        self.give_back_mob(m)
        return p
    }

    /// A player's `pushEntities` (CAL-156), at `x`, `z`, whose box is `b`: the mobs whose boxes
    /// meet it that may be pushed, as `push_entities` finds them, each pushed away from the player,
    /// where the player has physics, not a spectator, as `pushes` says; how many mobs there were,
    /// which with the other players that may be pushed are what the cramming counts. Their own
    /// pushes aren't kept, as Calcite's server doesn't move players.
    pub fn pushed_by_player<B: CollisionBlocks + EntityTicking>(mut self, x: f64, z: f64, b: Aabb, pushes: bool, lf: LivingFacts, f: Facts, blocks: B) -> usize {
        var mobs = List<i32>()
        for other in self.found(b, -1, 8) {
            if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
            }
        }
        if not pushes {
            return mobs.len()
        }
        for other in mobs {
            var o = self.lend_mob(other) else continue
            if not o.living.body.no_physics {
                let pushed = push_between(o.living.body.x, o.living.body.z, x, z)
                if let q = pushed {
                    let (xa, za) = q
                    let ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                    if o.pushable(lf, f, blocks, ticks) {
                        o.living.body.push(-xa, 0.0, -za)
                    }
                }
            }
            self.give_back_mob(o)
        }
        return mobs.len()
    }

    // What blocks did to the item or orb `id` that its level's to do (D435), kept as what a living
    // entity shows is: redstone ore lit, and what's missing.
    fn keep_acted(mut self, id: i32, acted: List<Acted>, after: List<usize>) {
        for k in 0..acted.len() {
            let shown = match acted[k] {
                Acted.Lit(at) => Shown.Lit(at),
                Acted.Missing(what) => Shown.Missing(what.copy()),
            }
            self.shown.push(shown)
            self.shown_by.push(id)
            self.shown_after.push(after[k])
        }
    }

    // An armor stand's tick, at `i`: what it showed kept with its ID, and it gone where its tick
    // took it away, below the level or broken (D441).
    fn tick_stand<B: CollisionBlocks + Rain + Warding, W: Wearing>(mut self, i: usize, stand: own ArmorStand, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = stand
        a.tick(lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
        let id = a.living.body.id
        for k in 0..a.living.shown.len() {
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        self.all[i] = some(Entity.Stand(a))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // An item's tick, at `i`: to where it merges, its merging, then the rest; what blocks did
    // that its level's to do kept with its ID (D435).
    fn tick_item<B: CollisionBlocks + EntityTicking + Rain, S: StackSizes + Wearing>(mut self, i: usize, item: own ItemEntity, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        var e = item
        e.tick_moving(f, m, t, types, codecs, blocks, min_y, fast_lava, mut sounds)
        let id = e.body.id
        self.keep_acted(id, e.acted, e.acted_after)
        e.acted.clear()
        e.acted_after.clear()
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let due = e.merge_due and e.mergable(codecs.stack_most(e.stack))
        let removed = e.body.removed
        self.all[i] = some(Entity.Item(e))
        if not removed {
            self.move_section(id, key)
        }
        self.heard = sounds.len()
        if due {
            self.merge_near(i, codecs)
        }
        var after = self.lend(id) else return
        after.tick_after(f, t, blocks, fast_lava, mut sounds)
        let done = after.body.removed
        self.give_back(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    // An orb's tick, at `i`: to where it looks for orbs to take in, its look, then the rest; what
    // blocks did that its level's to do kept with its ID, and its sounds heard (D435).
    fn tick_orb<B: CollisionBlocks + EntityTicking + Rain>(mut self, i: usize, orb: own ExperienceOrb, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var o = orb
        o.tick_start(f, m, t, types, blocks, min_y, fast_lava)
        let id = o.body.id
        let due = o.merge_due
        self.all[i] = some(Entity.Orb(o))
        if due {
            self.scan_merges(id)
        }
        var after = self.lend_orb(id) else return
        after.tick_rest(f, m, t, types, blocks, players, mut sounds)
        let done = after.body.removed
        self.keep_acted(id, after.acted, after.acted_after)
        after.acted.clear()
        after.acted_after.clear()
        self.give_back_orb(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    // `scanForMerges` for the orb `id`: each orb it may take in whose box meets its own, half a
    // block bigger each way, found first, then taken in in the order they were found.
    fn scan_merges(mut self, id: i32) {
        let me = self.orb_view(id) else return
        let b = me.body.bounding_box()
        let near = Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.5, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.5, max_z: b.max_z + 0.5 }
        var found = List<i32>()
        for other in self.find_orbs(near, id) {
            let o = self.orb_view(other) else continue
            if me.takes_in(o) {
                found.push(other)
            }
        }
        for other in found {
            var into = self.lend_orb(id) else return
            var from = self.lend_orb(other) else {
                self.give_back_orb(into)
                continue
            }
            into.take_in(mut from)
            self.give_back_orb(into)
            self.give_back_orb(from)
            self.remove(other)
        }
    }

    /// Ends a tick: the empty places go once there are as many as entities.
    pub fn end_tick(mut self) {
        self.cursor = 0
        self.end = 0
        self.heard = 0
        if self.empty > 16 and self.empty > self.at.len() {
            self.compact()
        }
    }

    // `mergeWithNeighbours` for the item at `i`: each mergable item whose box meets its own, 0.5
    // bigger across, in the order they're found, until it's gone.
    fn merge_near<S: StackSizes>(mut self, i: usize, codecs: S) {
        let (id, near) = self.near_box(i) else return
        var found = List<i32>()
        for other in self.find(near, id) {
            if self.mergable(other, codecs) {
                found.push(other)
            }
        }
        for other in found {
            if not self.mergable(other, codecs) {
                continue
            }
            self.try_merge(id, other, codecs)
            if not self.at.contains(id) {
                break
            }
        }
    }

    // The ID of the item at `i` and its box, 0.5 bigger across, `inflate(0.5, 0, 0.5)`.
    fn near_box(self, i: usize) -> (i32, Aabb)? {
        let slot = self.all[i] else return none
        let Entity.Item(e) = slot else return none
        let b = e.body.bounding_box()
        return some((e.body.id, Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.0, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.0, max_z: b.max_z + 0.5 }))
    }

    fn mergable<S: StackSizes>(self, id: i32, codecs: S) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Item(e) = slot else return false
        return e.mergable(codecs.stack_most(e.stack))
    }

    // `tryToMerge`: for the same target, and stacks that fit together, the one with fewer goes
    // into the other, or this one into the other where they've as many.
    fn try_merge<S: StackSizes>(mut self, id: i32, other: i32, codecs: S) {
        let order = self.merge_order(id, other, codecs)
        if order == 1 {
            self.merge_into(id, other, codecs)
        } else if order == 2 {
            self.merge_into(other, id, codecs)
        }
    }

    // Which way `tryToMerge` merges: 0 not at all, 1 `other` into `id`, 2 `id` into `other`.
    fn merge_order<S: StackSizes>(self, id: i32, other: i32, codecs: S) -> i32 {
        let sa = self.all[self.at[id]] else return 0
        let sb = self.all[self.at[other]] else return 0
        let Entity.Item(a) = sa else return 0
        let Entity.Item(b) = sb else return 0
        if a.target != b.target {
            return 0
        }
        if b.count() + a.count() > codecs.stack_most(b.stack) {
            return 0
        }
        if not same_components(some(a.stack.copy()), some(b.stack.copy())) {
            return 0
        }
        return if b.count() < a.count() { 1 } else { 2 }
    }

    // `merge`: as much of `from`'s stack as fits, to 64, goes to `to`'s, which keeps the longer
    // pickup delay and the younger age; `from` goes if it's none left.
    fn merge_into<S: StackSizes>(mut self, to: i32, from: i32, codecs: S) {
        var source = self.lend(from) else return
        var target = self.lend(to) else {
            self.give_back(source)
            return
        }
        let most = min(codecs.stack_most(target.stack), 64)
        let moving = min(most - target.count(), source.count())
        target.stack = counted(target.stack, target.count() + moving)
        target.stack_changed = true
        // `shrink`: the stack changes where it is, which isn't sent.
        source.stack = counted(source.stack, source.count() - moving)
        if source.pickup_delay > target.pickup_delay {
            target.pickup_delay = source.pickup_delay
        }
        if source.age < target.age {
            target.age = source.age
        }
        let empty = source.is_empty()
        if empty {
            source.body.removed = true
        }
        self.give_back(target)
        self.give_back(source)
        if empty {
            self.remove(from)
        }
    }

    // Moves the entity `id` to the section `key` if it isn't in it, last there, as `onMove` does.
    fn move_section(mut self, id: i32, key: i64) {
        if self.section_of.contains(id) {
            let old = self.section_of[id]
            if old == key {
                return
            }
            self.out_of_section(id, old)
        }
        self.into_section(id, key)
    }

    fn into_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            self.sections.insert(key, List<i32>())
            let k = section_chunk(key).pack()
            if not self.chunk_sections.contains(k) {
                self.chunk_sections.insert(k, List<i64>())
            }
            self.chunk_sections[k].push(key)
        }
        self.sections[key].push(id)
        self.section_of.insert(id, key)
    }

    fn out_of_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            return
        }
        var kept = List<i32>()
        for other in self.sections[key] {
            if other != id {
                kept.push(other)
            }
        }
        if kept.is_empty() {
            _ = self.sections.remove(key)
            let k = section_chunk(key).pack()
            if self.chunk_sections.contains(k) {
                var left = List<i64>()
                for other in self.chunk_sections[k] {
                    if other != key {
                        left.push(other)
                    }
                }
                if left.is_empty() {
                    _ = self.chunk_sections.remove(k)
                } else {
                    self.chunk_sections.insert(k, left)
                }
            }
        } else {
            self.sections.insert(key, kept)
        }
    }

    // Drops the empty places, keeping the order.
    fn compact(mut self) {
        var kept = List<Entity?>()
        self.at.clear()
        for i in 0..self.all.len() {
            if let e = self.all[i].take() {
                self.at.insert(id_of(e), kept.len())
                kept.push(some(e))
            }
        }
        self.all = kept
        self.empty = 0
    }
}

// Whether the chunk at x, z ticks its entities, `isPositionEntityTicking`.
fn ticking_at<B: EntityTicking>(blocks: B, x: f64, z: f64) -> bool {
    return blocks.ticks_entities(i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
}

// The entity's ID.
fn id_of(e: Entity) -> i32 {
    return match e {
        Entity.Item(i) => i.body.id,
        Entity.Orb(o) => o.body.id,
        Entity.Stand(a) => a.living.body.id,
        Entity.Mob(m) => m.living.body.id,
    }
}

// Where the entity is.
fn place_of(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Item(i) => (i.body.x, i.body.y, i.body.z),
        Entity.Orb(o) => (o.body.x, o.body.y, o.body.z),
        Entity.Stand(a) => (a.living.body.x, a.living.body.y, a.living.body.z),
        Entity.Mob(m) => (m.living.body.x, m.living.body.y, m.living.body.z),
    }
}

// The entity's box.
fn box_of(e: Entity) -> Aabb {
    return match e {
        Entity.Item(i) => i.body.bounding_box(),
        Entity.Orb(o) => o.body.bounding_box(),
        Entity.Stand(a) => a.living.body.bounding_box(),
        Entity.Mob(m) => m.living.body.bounding_box(),
    }
}

// When the entity came into its level.
fn entered_of(e: Entity) -> u64 {
    return match e {
        Entity.Item(i) => i.body.entered,
        Entity.Orb(o) => o.body.entered,
        Entity.Stand(a) => a.living.body.entered,
        Entity.Mob(m) => m.living.body.entered,
    }
}

// `stack` with `n` of it, 0 or less leaving a stack that's nothing, as `setCount` does.
fn counted(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

// `SectionPos.posToSectionCoord`.
fn section(v: f64) -> i32 {
    return i32.saturate(v.floor()) >> 4
}

// The section of the block at x, y, z, `SectionPos.asLong`.
fn section_key(x: f64, y: f64, z: f64) -> i64 {
    return pack(section(x), section(y), section(z))
}

// The chunk of the section `SectionPos.asLong` packed in `key`.
fn section_chunk(key: i64) -> ChunkPos {
    return ChunkPos { x: i32.wrap(key >> 42), z: i32.wrap((key << 22) >> 42) }
}

/// `SectionPos.asLong`.
pub fn pack(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 4194303) << 42) | (i64(y) & 1048575) | ((i64(z) & 4194303) << 20)
}
