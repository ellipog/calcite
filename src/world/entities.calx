// `stack` with `n` of it, 0 or less leaving a stack that's nothing, as `setCount` does.
fn counted(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

// `absSnapTo` of `l` to x, y, z turned `y_rot` and `x_rot`, there last tick too, what rides it
// left where it is (CAL-179).
fn snap_body(l: mut Living, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32) {
    let cx = if x < -3.0e7 { -3.0e7 } else if x > 3.0e7 { 3.0e7 } else { x }
    let cz = if z < -3.0e7 { -3.0e7 } else if z > 3.0e7 { 3.0e7 } else { z }
    l.body.x = cx
    l.body.y = y
    l.body.z = cz
    l.body.xo = cx
    l.body.yo = y
    l.body.zo = cz
    l.body.y_rot = y_rot
    l.body.x_rot = x_rot
    l.y_rot_o = y_rot
    l.x_rot_o = x_rot
}

// `steered_move` for the boat `boat` (CAL-315), as for a mob but for what a boat is: moved
// `MoverType.PLAYER` by its own `Entity.move`, nothing climbed, stepped or trampled; put
// where its client says, `absSnapTo`, on the ground as it says and with its own fall after,
// `checkFallDamage`. What came of it and the boat, to go back.
fn steered_boat<B: CollisionBlocks>(f: Facts, m: MovementStates, t: BodyFacts, blocks: B, boat: own Boat, to: (f64, f64, f64), y_rot: f32, x_rot: f32, ground: bool, first_good: (f64, f64, f64), last_good: (f64, f64, f64), allow_flight: bool) -> (Steered, Boat) {
    var it = boat
    let (tx, ty, tz) = to
    let (ox, oy, oz) = (it.body.x, it.body.y, it.body.z)
    let (fx, fy, fz) = first_good
    let (fdx, fdy, fdz) = (tx - fx, ty - fy, tz - fz)
    let (bvx, bvy, bvz) = (it.body.vx, it.body.vy, it.body.vz)
    let expected = bvx * bvx + bvy * bvy + bvz * bvz
    if fdx * fdx + fdy * fdy + fdz * fdz - expected > 100.0 {
        let (yr, xr) = (it.body.y_rot, it.body.x_rot)
        return (Steered.TooQuick((ox, oy, oz), yr, xr), it)
    }
    let old_box = it.body.bounding_box()
    let (lx, ly, lz) = last_good
    let rests = it.body.vertical_below
    it.moved_by(f, m, t, blocks, tx - lx, ty - ly, tz - lz)
    let (wx, wz) = (tx - it.body.x, tz - it.body.z)
    let wrong = wx * wx + wz * wz > 0.0625
    let mover = it.body.mover()
    let room = m.colliders(f, blocks, old_box, mover).is_empty()
    let (yr, xr) = (y_rot % 360.0f32, clamp_f32(x_rot, -90.0f32, 90.0f32) % 360.0f32)
    if (wrong and room) or meets_new(f, m, blocks, it.body, old_box, tx, ty, tz) {
        snap_plain(mut it.body, ox, oy, oz, yr, xr)
        it.body.forget_move()
        return (Steered.Refused((ox, oy, oz), yr, xr, wrong), it)
    }
    snap_plain(mut it.body, tx, ty, tz, yr, xr)
    let (cx, cy, cz) = (it.body.x, it.body.y, it.body.z)
    it.client_landed(f, m, blocks, cx - ox, cy - oy, cz - oz, ground)
    let floating = ty - ly >= -0.03125 and not rests and not allow_flight and not it.body.no_gravity and no_blocks_around(f, blocks, it.body.bounding_box())
    return (Steered.Taken((ox, oy, oz), (cx, cy, cz), wrong, floating), it)
}

// `absSnapTo` of the body `b`, not living, to x, y, z turned `y_rot` and `x_rot`, there last tick
// too, what rides it left where it is (CAL-315).
fn snap_plain(b: mut Body, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32) {
    let cx = if x < -3.0e7 { -3.0e7 } else if x > 3.0e7 { 3.0e7 } else { x }
    let cz = if z < -3.0e7 { -3.0e7 } else if z > 3.0e7 { 3.0e7 } else { z }
    b.x = cx
    b.y = y
    b.z = cz
    b.xo = cx
    b.yo = y
    b.zo = cz
    b.y_rot = y_rot
    b.x_rot = x_rot
}

// `isEntityCollidingWithAnythingNew` for the body `b` its client moved toward x, y, z (CAL-179),
// as `network`'s for a player: whether a block's shape that its box there, a hair smaller,
// meets, as its collisions saw them from `old`'s foot, `getPreMoveCollisions`, doesn't meet
// `old`, a hair smaller too.
fn meets_new<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, b: Body, old: Aabb, x: f64, y: f64, z: f64) -> bool {
    let now = b.bounding_box()
    let (ax, ay, az) = (x - b.x, y - b.y, z - b.z)
    let there = Aabb { min_x: now.min_x + ax, min_y: now.min_y + ay, min_z: now.min_z + az, max_x: now.max_x + ax, max_y: now.max_y + ay, max_z: now.max_z + az }
    let was = old.deflate(f64(1.0e-5f32))
    var mover = b.mover()
    mover.y = old.min_y
    mover.placement = true
    let c = m.colliders(f, blocks, there.deflate(f64(1.0e-5f32)), mover)
    var start = 0usize
    for end in c.ends {
        var met = false
        for k in start..end {
            if meets(c.boxes[k], was) {
                met = true
            }
        }
        if not met {
            return true
        }
        start = end
    }
    return false
}

// `noBlocksAround` (CAL-179): nothing but air in the blocks its box `b` meets, grown a sixteenth
// each way and 0.55 down.
fn no_blocks_around<B: CollisionBlocks>(f: Facts, blocks: B, b: Aabb) -> bool {
    let g = b.inflate(0.0625, 0.0625, 0.0625)
    let (x0, y0, z0) = (i32.saturate(g.min_x.floor()), i32.saturate((g.min_y - 0.55).floor()), i32.saturate(g.min_z.floor()))
    let (x1, y1, z1) = (i32.saturate(g.max_x.floor()), i32.saturate(g.max_y.floor()), i32.saturate(g.max_z.floor()))
    for by in y0..=y1 {
        for bz in z0..=z1 {
            for bx in x0..=x1 {
                if not f.is_air(blocks.collision_state(bx, by, bz) ?? 0) {
                    return false
                }
            }
        }
    }
    return true
}

// `Mth.clamp` of a float.
fn clamp_f32(v: f32, lo: f32, hi: f32) -> f32 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}

// `SectionPos.posToSectionCoord`.
fn section(v: f64) -> i32 {
    return i32.saturate(v.floor()) >> 4
}

/// The kind `Entities.found` gives the players by, in their places among the rest (CAL-190).
pub const PLAYERS: i32 = 4096

/// The kind `Entities.found` gives lightning bolts by (CAL-326).
pub const BOLTS: i32 = 32768

/// The kind `Entities.found` gives falling blocks by (CAL-243).
pub const FALLING: i32 = 65536

/// The kind `Entities.found` gives hanging entities by (CAL-354).
pub const HANGING: i32 = 524288

/// The kind `Entities.found` gives boats and rafts by (CAL-315).
pub const BOATS: i32 = 131072

// The kind `Entities.found` gives a mob lent out of the level by, as it ticks (CAL-201).
const LENT: i32 = 16384

// The section of the block at x, y, z, `SectionPos.asLong`.
fn section_key(x: f64, y: f64, z: f64) -> i64 {
    return pack(section(x), section(y), section(z))
}

// The chunk of the section `SectionPos.asLong` packed in `key`.
fn section_chunk(key: i64) -> ChunkPos {
    return ChunkPos { x: i32.wrap(key >> 42), z: i32.wrap((key << 22) >> 42) }
}

/// `SectionPos.asLong`.
pub fn pack(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 4194303) << 42) | (i64(y) & 1048575) | ((i64(z) & 4194303) << 20)
}

// The square of the distance from `a` to `b`, `distanceToSqr`.
fn distance_sqr(a: (f64, f64, f64), b: (f64, f64, f64)) -> f64 {
    let (ax, ay, az) = a
    let (bx, by, bz) = b
    let (dx, dy, dz) = (bx - ax, by - ay, bz - az)
    return dx * dx + dy * dy + dz * dz
}

// `AABB.expandTowards`: the box `b` stretched toward the side each of `xa`, `ya` and `za` goes.
fn expand_towards(b: Aabb, xa: f64, ya: f64, za: f64) -> Aabb {
    var out = b
    if xa < 0.0 {
        out.min_x += xa
    } else if xa > 0.0 {
        out.max_x += xa
    }
    if ya < 0.0 {
        out.min_y += ya
    } else if ya > 0.0 {
        out.max_y += ya
    }
    if za < 0.0 {
        out.min_z += za
    } else if za > 0.0 {
        out.max_z += za
    }
    return out
}

// Whether `getManyEntityHitResult`, taking in the box the way starts in, has the way from `from`
// to `to` meet the box `b` within `margin` (CAL-159): `from` within it, the way through it, or,
// with a margin, through it that much larger, and from there toward its middle, `getCenter`, up
// to the first block `mover` collides with or the world border `border`, through it.
fn meets_way<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, mover: Mover, border: (f64, f64, f64, f64), b: Aabb, from: (f64, f64, f64), to: (f64, f64, f64), margin: f64) -> bool {
    let (fx, fy, fz) = from
    if fx >= b.min_x and fx < b.max_x and fy >= b.min_y and fy < b.max_y and fz >= b.min_z and fz < b.max_z {
        return true
    }
    if box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, from, to) != none {
        return true
    }
    if margin <= 0.0 {
        return false
    }
    let outside = box_clip(b.min_x - margin, b.min_y - margin, b.min_z - margin, b.max_x + margin, b.max_y + margin, b.max_z + margin, from, to) else return false
    var towards = (b.min_x + 0.5 * (b.max_x - b.min_x), b.min_y + 0.5 * (b.max_y - b.min_y), b.min_z + 0.5 * (b.max_z - b.min_z))
    let way = clip_including_border(f, m, blocks, mover, outside, towards, border)
    if not way.missed {
        towards = (way.x, way.y, way.z)
    }
    return box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, outside, towards) != none
}

// The player `p` holding a leash as `h` (CAL-179): where they are, their box, size and facing,
// and what their client last said they moved, `getKnownMovement`.
fn player_holding(h: Held, p: Follower) -> Holding {
    let half = f64(p.width / 2.0f32)
    let b = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
    return Holding { held: h, interacts: not p.dead and not p.spectator, x: p.x, y: p.y, z: p.z, bounds: b, width: p.width, height: p.height, y_rot: p.yaw, moving: (p.known_dx, p.known_dy, p.known_dz) }
}

// The mob `o` holding a leash as `h` (CAL-179): as `player_holding`, alive and not removed, its
// motion its known movement, nothing without AI, `getHolderMovement`.
fn mob_holding(h: Held, o: Mob) -> Holding {
    let moving = if o.no_ai() { (0.0, 0.0, 0.0) } else { (o.living.body.vx, o.living.body.vy, o.living.body.vz) }
    let interacts = o.living.alive() and not o.living.body.removed
    return Holding { held: h, interacts: interacts, x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, bounds: o.living.body.bounding_box(), width: o.living.body.width, height: o.living.body.height, y_rot: o.living.body.y_rot, moving: moving }
}

// The boat `o` holding a leash as `h` (CAL-315): as `mob_holding`, there while it isn't removed,
// its known movement its steering player's last move where one of `players` steers it, else its
// motion.
fn boat_holding(h: Held, o: Boat, players: List<Follower>) -> Holding {
    let moving = boat_known(o, players) ?? (o.body.vx, o.body.vy, o.body.vz)
    return Holding { held: h, interacts: not o.body.removed, x: o.body.x, y: o.body.y, z: o.body.z, bounds: o.body.bounding_box(), width: o.body.width, height: o.body.height, y_rot: o.body.y_rot, moving: moving }
}

// A boat `o`'s known movement where a player among `players` steers it, its first rider,
// `getControllingPassenger`: what their client last said they moved (CAL-315).
fn boat_known(o: Boat, players: List<Follower>) -> (f64, f64, f64)? {
    if o.body.passengers.is_empty() {
        return none
    }
    let first = o.body.passengers[0]
    for p in players {
        if p.id == first and not p.mob {
            return some((p.known_dx, p.known_dy, p.known_dz))
        }
    }
    return none
}

// The knot `k` holding a leash as `h` (CAL-179): where it is, its box and size, facing nowhere and
// never moving, there while it isn't gone.
fn knot_holding(h: Held, k: LeashKnot) -> Holding {
    return Holding { held: h, interacts: not k.body.removed, x: k.body.x, y: k.body.y, z: k.body.z, bounds: k.body.bounding_box(), width: k.body.width, height: k.body.height, y_rot: 0.0f32 }
}

// Whether mobs of `species` aren't taken onto boats, `cannot_be_pushed_onto_boats` (CAL-315): of
// the tag's others, players aren't mobs here, and tadpoles, the creaking, nautiluses and sulfur
// cubes aren't made.
fn kept_off_boats(species: i32) -> bool {
    return species == ELDER_GUARDIAN or species == COD or species == PUFFERFISH or species == SALMON or species == TROPICAL_FISH or species == DOLPHIN or species == SQUID or species == GLOW_SQUID
}

// `AbstractBoat.positionRider`'s turn of its rider `e`, the entity `id`, by a boat turning by
// `delta` a tick, at `yaw`, `full` where its seats are all taken (CAL-315): turned with it, its head
// too, then `clampRotation`: its body at the boat's yaw, or an animal's across it on a full boat,
// 90 degrees for an even ID and 270 for an odd, `calculatePassengerBodyYRot`; a mob turned to its
// body, its head kept within its reach of it, `clampHeadRotationToBody`; anything else alive kept
// within 105 degrees of it. A breeze, which turns as it likes in a boat, isn't made.
fn boat_turned(e: own Entity, id: i32, delta: f32, yaw: f32, full: bool) -> Entity {
    return match e {
        Entity.Mob(m) => {
            var t = m
            t.living.body.y_rot = t.living.body.y_rot + delta
            t.living.y_head_rot = t.living.y_head_rot + delta
            let body = if t.animal and full { yaw + (if id % 2 == 0 { 90.0f32 } else { 270.0f32 }) } else { yaw }
            t.living.y_body_rot = body
            t.living.body.y_rot = body
            t.clamp_head_to_body()
            Entity.Mob(t)
        },
        Entity.Stand(a) => {
            var t = a
            t.living.body.y_rot = t.living.body.y_rot + delta
            t.living.y_head_rot = t.living.y_head_rot + delta
            t.living.y_body_rot = yaw
            let off = wrap_degrees(t.living.body.y_rot - yaw)
            let kept = if off < -105.0f32 { -105.0f32 } else if off > 105.0f32 { 105.0f32 } else { off }
            t.living.body.y_rot = t.living.body.y_rot + kept - off
            Entity.Stand(t)
        },
        other => other,
    }
}

/// The kind `Entities.found` gives minecarts by (CAL-315).
pub const CARTS: i32 = 262144
