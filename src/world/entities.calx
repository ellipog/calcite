    /// The chunks with entities or kept ones in them, `getAllChunksWithExistingSections`.
    pub fn chunks(self) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for (k, _) in self.chunk_sections {
            out.push(ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) })
        }
        return out
    }

    /// The entities in the chunk at `pos`, and the kept ones, in the order
    /// `getExistingSectionsInChunk` gives them: its sections by `SectionPos.asLong`, and in each
    /// in the order they came into it.
    pub fn in_chunk(self, pos: ChunkPos) -> List<i32> {
        let k = pos.pack()
        if not self.chunk_sections.contains(k) {
            return List<i32>()
        }
        var keys = self.chunk_sections[k].copy()
        keys.sort()
        var out = List<i32>()
        for key in keys {
            for id in self.sections[key] {
                if not self.players_in.contains(id) {
                    out.push(id)
                }
            }
        }
        return out
    }

    /// Gives the entity `id`, one Calcite keeps as it was read, below 0, a place last in the
    /// section of x, y, z, as `addEntity` does.
    pub fn place_kept(mut self, id: i32, x: f64, y: f64, z: f64) {
        self.into_section(id, section_key(x, y, z))
    }

    /// Puts the player `id` in the section of x, y, z, last there where they weren't in it, as
    /// their `onMove` does, or as they're added to the level (CAL-190).
    pub fn place_player(mut self, id: i32, x: f64, y: f64, z: f64) {
        if not self.players_in.contains(id) {
            self.arrive(id)
        }
        self.players_in.insert(id)
        self.move_section(id, section_key(x, y, z))
    }

    /// Moves the player `id`, where they're among the entities, to the section of x, y, z, last
    /// there where they weren't in it, as their `onMove` does (CAL-190).
    pub fn move_player(mut self, id: i32, x: f64, y: f64, z: f64) {
        if self.players_in.contains(id) {
            self.move_section(id, section_key(x, y, z))
        }
    }

    /// Takes the player `id` out of their section, as they're removed from the level (CAL-190).
    pub fn remove_player(mut self, id: i32) {
        if not self.players_in.contains(id) {
            return
        }
        self.players_in.remove(id)
        _ = self.arrival.remove(id)
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
    }

    /// Takes the kept entity `id` out of its section, as it's let go of.
    pub fn remove_kept(mut self, id: i32) {
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
    }

    /// The ID of the entity here of the UUID `uuid` that isn't gone, `getEntity(uuid)`, as an
    /// arrow finds its owner (CAL-159).
    pub fn id_with_uuid(self, uuid: (i64, i64)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            let (u, removed) = match e {
                Entity.Item(i) => (i.body.uuid, i.body.removed),
                Entity.Orb(o) => (o.body.uuid, o.body.removed),
                Entity.Stand(a) => (a.living.body.uuid, a.living.body.removed),
                Entity.Mob(m) => (m.living.body.uuid, m.living.body.removed),
                Entity.Arrow(a) => (a.body.uuid, a.body.removed),
                Entity.Thrown(p) => (p.body.uuid, p.body.removed),
                Entity.Cloud(c) => (c.body.uuid, c.body.removed),
                Entity.Crystal(c) => (c.body.uuid, c.body.removed),
                Entity.Eye(eye) => (eye.body.uuid, eye.body.removed),
                Entity.Fireball(b) => (b.body.uuid, b.body.removed),
                Entity.Tnt(p) => (p.body.uuid, p.body.removed),
                Entity.Falling(p) => (p.body.uuid, p.body.removed),
                Entity.Boat(p) => (p.body.uuid, p.body.removed),
                Entity.Cart(p) => (p.body.uuid, p.body.removed),
                Entity.Knot(p) => (p.body.uuid, p.body.removed),
                Entity.Hanging(p) => (p.body.uuid, p.body.removed),
                Entity.Fangs(p) => (p.body.uuid, p.body.removed),
                Entity.Bolt(p) => (p.body.uuid, p.body.removed),
            }
            if u == uuid and not removed {
                return some(id_of(e))
            }
        }
        return none
    }

    /// Where the entity `id` is, if it's here.
    pub fn place(self, id: i32) -> (f64, f64, f64)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(place_of(e))
    }

    /// What rides the entity `id`, in order, `getPassengers` (D708); none where it isn't here.
    pub fn passengers_of(self, id: i32) -> List<i32> {
        let b = self.body_at(id) else return List<i32>()
        return b.passengers.copy()
    }

    /// What the relation `relation` of `execute on` finds of the entity `id` here (CAL-165), as
    /// `createRelationOperations` finds it: `owner`, an `OwnableEntity`'s, `getOwner`; `leasher`, a
    /// leashed mob's holder; `target`, a mob's, `getTarget`; `attacker`, a living entity's,
    /// `getLastHurtByMob`; `vehicle` and `passengers`; `controller`, `getControllingPassenger`, a
    /// player first riding a saddled horse or pig, or a mob first riding one with AI that may
    /// steer; and `origin`, a `TraceableEntity`'s owner, a projectile's, an item's thrower, TNT's,
    /// fangs', a cloud's and a vex's.
    pub fn related(self, id: i32, relation: String) -> Related {
        if not self.at.contains(id) {
            return Related.Nothing
        }
        let e = self.all[self.at[id]] else return Related.Nothing
        if relation == "vehicle" {
            return match self.vehicle_of(id) {
                some(v) => Related.Ids([v]),
                none => Related.Nothing,
            }
        }
        if relation == "passengers" {
            return Related.Ids(self.passengers_of(id))
        }
        var owner: (i64, i64)? = none
        var living = false
        match e {
            Entity.Mob(m) => {
                if relation == "owner" or (relation == "origin" and m.species == VEX) {
                    owner = m.owner_reference()
                    living = true
                } else if relation == "leasher" {
                    return match m.leash_holder() {
                        some(h) => Related.Ids([h.id]),
                        none => Related.Nothing,
                    }
                } else if relation == "target" {
                    return match m.target_read() {
                        some((t, checked)) => Related.Target(t, checked),
                        none => Related.Nothing,
                    }
                } else if relation == "attacker" {
                    owner = m.living.hurt_by_mob
                    living = true
                } else if relation == "controller" {
                    if m.living.body.passengers.is_empty() {
                        return Related.Nothing
                    }
                    let first = m.living.body.passengers[0]
                    if m.player_steers(first, true, true) {
                        return if m.species == PIG { Related.Pig(first) } else if m.species == STRIDER { Related.Strider(first) } else { Related.Ids([first]) }
                    }
                    if not m.no_ai() and self.may_steer(first) {
                        return Related.Ids([first])
                    }
                    return Related.Nothing
                }
            },
            Entity.Stand(a) => {
                if relation == "attacker" {
                    owner = a.living.hurt_by_mob
                    living = true
                }
            },
            Entity.Item(i) => {
                if relation == "origin" {
                    owner = i.thrower
                }
            },
            Entity.Arrow(a) => {
                if relation == "origin" {
                    owner = a.owner
                }
            },
            Entity.Thrown(t) => {
                if relation == "origin" {
                    owner = t.owner
                }
            },
            Entity.Fireball(b) => {
                if relation == "origin" {
                    owner = b.owner
                }
            },
            Entity.Cloud(c) => {
                if relation == "origin" {
                    owner = c.owner
                }
            },
            Entity.Fangs(f) => {
                if relation == "origin" {
                    owner = f.owner
                }
            },
            Entity.Tnt(t) => {
                if relation == "origin" {
                    owner = t.owner
                }
            },
            _ => {},
        }
        return match owner {
            some(u) => Related.Uuid(u, living),
            none => Related.Nothing,
        }
    }

    /// The attributes of the entity `id` here, a mob's or an armor stand's (CAL-231).
    pub fn attributes_at(self, id: i32) -> Attributes? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return match e {
            Entity.Mob(m) => some(m.living.attributes.copy()),
            Entity.Stand(a) => some(a.living.attributes.copy()),
            _ => none,
        }
    }

    /// Whether the entity `id` here is a living one, a mob or an armor stand (CAL-165).
    pub fn living_at(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let e = self.all[self.at[id]] else return false
        return match e {
            Entity.Mob(_) => true,
            Entity.Stand(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` here may be a target, `canBeSeenAsEnemy`: not invulnerable, and
    /// alive (CAL-165).
    pub fn seen_as_enemy(self, id: i32) -> bool {
        let p = self.picking(id) else return false
        let b = self.body_at(id) else return false
        return p.alive and not b.invulnerable
    }

    /// What the entity `id` rides, `getVehicle` (D708), none where it isn't here or rides nothing.
    pub fn vehicle_of(self, id: i32) -> i32? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let (_, vehicle, _) = riding_of(e)
        return vehicle
    }

    /// How far the entity `id` moved over its last tick, `lastKnownSpeed` as `computeSpeed` has it
    /// (CAL-214), where it's here and not lent.
    pub fn known_speed_of(self, id: i32) -> (f64, f64, f64)? {
        let b = self.body_at(id) else return none
        return some((b.known_dx, b.known_dy, b.known_dz))
    }

    /// What the entity `id` rides at the bottom, `getRootVehicle` (D708): itself where it rides
    /// nothing.
    pub fn root_vehicle(self, id: i32) -> i32 {
        var at = id
        var depth = 0
        while depth < 4096 {
            let under = self.vehicle_of(at) else break
            at = under
            depth += 1
        }
        return at
    }

    // What the entity or player `id` rides at last, `getRootVehicle`, a player's by what they
    // ride, `player_vehicle` (CAL-315).
    fn root_of(self, id: i32) -> i32 {
        if self.players_in.contains(id) {
            let v = self.player_vehicle(id) else return id
            return self.root_vehicle(v)
        }
        return self.root_vehicle(id)
    }

    // A copy of the body of the entity `id`, where it's here and not lent.
    /// The UUID of the entity `id`, where it's here.
    pub fn uuid_of(self, id: i32) -> (i64, i64)? {
        let b = self.body_at(id) else return none
        return some(b.uuid)
    }

    fn body_at(self, id: i32) -> Body? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(body_of(e))
    }

    // The entity `id`'s body made `b`, where it's here and not lent.
    fn put_body(mut self, id: i32, b: own Body) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(with_body(e, b))
    }

    // What rides the entity `id` given to each of them as what rides with it, `riding_with`.
    fn share_riders(mut self, id: i32) {
        let riders = self.passengers_of(id)
        for p in riders {
            var b = self.body_at(p) else continue
            b.riding_with = riders.copy()
            self.put_body(p, b)
        }
    }

    /// `ConversionType.SPLIT_ON_DEATH`'s riding of the mob `old` split into others as it dies
    /// (CAL-175): what rode it first gets off, `stopRiding`, as the first of them is made, onto
    /// its top, as it's not gone till after, `super.remove`.
    pub fn first_rider_off(mut self, old: i32) {
        let ob = self.body_at(old) else return
        if not ob.passengers.is_empty() {
            self.leave_with(ob.passengers[0], false, true)
        }
    }

    /// `ConversionType.SINGLE`'s riding of the mob `old` turned into the mob `new` (CAL-175): what
    /// rode `old` first gets off, may board again at once, `boardingCooldown`, and rides `new`; and
    /// `new` rides what `old` rode, which `old` gets off.
    pub fn hand_over_riders(mut self, old: i32, new: i32) {
        let ob = self.body_at(old) else return
        if not ob.passengers.is_empty() {
            let root = ob.passengers[0]
            self.stop_riding(root)
            if let got = self.body_at(root) {
                var rb = got
                rb.boarding_cooldown = 0
                self.put_body(root, rb)
            }
            _ = self.start_riding(root, new, false)
        }
        if let v = self.vehicle_of(old) {
            self.stop_riding(old)
            _ = self.start_riding(new, v, false)
        }
    }

    /// `startRiding` of the entity `rider` onto the entity `vehicle` (D708), both here, `force`
    /// where it boards however soon after it got off something and whatever already rides
    /// `vehicle`, as loading and `summon` board, `canRide` and `canAddPassenger`: not where it
    /// rides it already, would ride itself, or what `vehicle` rides, all the way down, is it;
    /// else off what it rode, standing, `setPose(STANDING)`, and last of what rides `vehicle`,
    /// `addPassenger`. Says whether it boarded. Its game event, `ENTITY_MOUNT`, is the caller's.
    pub fn start_riding(mut self, rider: i32, vehicle: i32, force: bool) -> bool {
        if rider == vehicle {
            return false
        }
        let r = self.body_at(rider) else return false
        let v = self.body_at(vehicle) else return false
        if r.vehicle == some(vehicle) {
            return false
        }
        var below = v.vehicle
        var depth = 0
        while depth < 4096 {
            let under = below else break
            if under == rider {
                return false
            }
            below = self.vehicle_of(under)
            depth += 1
        }
        // A happy ghast carries four, `HappyGhast.canAddPassenger` (CAL-384).
        let full = if self.is_mob(vehicle) and self.mob(vehicle).species == HAPPY_GHAST { v.passengers.len() >= 4 } else { not v.passengers.is_empty() }
        if not force and (r.boarding_cooldown > 0 or full) {
            return false
        }
        // A wither rides nothing, `WitherBoss.canRide` (CAL-401).
        if not force and self.is_mob(rider) and self.mob(rider).species == WITHER_BOSS {
            return false
        }
        if r.vehicle != none {
            self.stop_riding(rider)
        }
        let i = self.at[rider]
        if let held = self.all[i].take() {
            self.all[i] = some(match held {
                Entity.Mob(m) => {
                    var t = m
                    t.living.data.set(POSE_ID, Value.Number(STANDING))
                    Entity.Mob(t)
                },
                Entity.Stand(a) => {
                    var t = a
                    t.living.data.set(POSE_ID, Value.Number(STANDING))
                    Entity.Stand(t)
                },
                other => other,
            })
        }
        var rb = self.body_at(rider) else return false
        rb.vehicle = some(vehicle)
        self.put_body(rider, rb)
        var vb = self.body_at(vehicle) else return false
        let was_empty = vb.passengers.is_empty()
        vb.passengers.push(rider)
        self.put_body(vehicle, vb)
        self.share_riders(vehicle)
        self.ghast_rides(vehicle, true, was_empty)
        return true
    }

    /// `stopRiding` of the entity `rider` (D708), `removeVehicle`: off what it rides, which it may
    /// board again in 60 ticks, `boardingCooldown`; and what's alive put where it gets off,
    /// `dismountVehicle`, as the next entity's tick begins, where its level's blocks are at hand,
    /// or as the server asks, `seat_off`. Its game event, `ENTITY_DISMOUNT`, isn't made.
    pub fn stop_riding(mut self, rider: i32) {
        self.leave(rider, false)
    }

    // `stopRiding` of `rider`, `gone` where what it rides is gone, `isRemoved`.
    fn leave(mut self, rider: i32, gone: bool) {
        self.leave_with(rider, gone, false)
    }

    // `leave`, what it rides taken as there still where `present`, though it's marked gone, as a
    // splitting slime is before `super.remove`.
    fn leave_with(mut self, rider: i32, gone: bool, present: bool) {
        // A player riding, whose body the network keeps, off for it to put where they get off
        // (CAL-179).
        if let k = self.riding_player(rider) {
            let (_, vehicle, _) = self.riding_players[k]
            _ = self.riding_players.remove(k)
            let off = self.off_from(vehicle, rider, gone, present)
            self.refresh_player_rider(vehicle)
            self.players_off.push(off)
            return
        }
        var rb = self.body_at(rider) else return
        let vehicle = rb.vehicle else return
        rb.vehicle = none
        rb.riding_with = List<i32>()
        rb.boarding_cooldown = 60
        let removed = rb.removed
        self.put_body(rider, rb)
        let off = self.off_from(vehicle, rider, gone, present)
        // `LivingEntity.stopRiding`: what's alive and not gone itself gets off where its vehicle
        // puts it.
        let (_, _, _, _, alive) = self.riding_at(self.at[rider]) else return
        if alive and not removed {
            self.unseated.push(off)
        }
    }

    // `rider` off what rides `vehicle`, `removePassenger`, and what it got off, where that's
    // here, as it's to be put where it gets off, `gone` where what it rides is gone, and so it
    // is where it's marked gone but not `present`.
    fn off_from(mut self, vehicle: i32, rider: i32, gone: bool, present: bool) -> Unseat {
        var off = Unseat { rider: rider, x: 0.0, y: 0.0, z: 0.0, top: 0.0, yaw: 0.0f32, gone: gone, animal: false, vehicle: vehicle }
        if let got = self.body_at(vehicle) {
            var vb = got
            var kept = List<i32>()
            for p in vb.passengers {
                if p != rider {
                    kept.push(p)
                }
            }
            vb.passengers = kept
            off.x = vb.x
            off.y = vb.y
            off.z = vb.z
            off.top = vb.bounding_box().max_y
            off.bottom = vb.bounding_box().min_y
            off.width = vb.width
            off.yaw = vb.y_rot
            off.gone = gone or (vb.removed and not present)
            off.left_riding = vb.passengers.copy()
            self.put_body(vehicle, vb)
            self.share_riders(vehicle)
            self.ghast_rides(vehicle, false, false)
            if let Entity.Mob(m) = self.all[self.at[vehicle]] {
                off.animal = m.animal
                off.horse = m.equine()
                off.strider = m.species == STRIDER
                off.happy_ghast = m.species == HAPPY_GHAST
            }
            off.boat = self.is_boat(vehicle)
            if let Entity.Cart(c) = self.all[self.at[vehicle]] {
                off.cart = true
                off.flipped = c.flipped
            }
        } else {
            off.gone = true
        }
        if self.at.contains(rider) {
            if let Entity.Mob(rm) = self.all[self.at[rider]] {
                off.left = rm.left_handed()
            }
            if let rb = self.body_at(rider) {
                off.rider_yaw = rb.y_rot
            }
        }
        return off
    }

    // Where the player `id` rides something here, their place among those riding (CAL-179).
    fn riding_player(self, id: i32) -> usize? {
        for k in 0..self.riding_players.len() {
            let (p, _, _) = self.riding_players[k]
            if p == id {
                return some(k)
            }
        }
        return none
    }

    // The mob `vehicle` told of the player riding it, by their UUID, or that none does (CAL-179).
    fn set_player_rider(mut self, vehicle: i32, uuid: (i64, i64)?) {
        if not self.at.contains(vehicle) {
            return
        }
        let i = self.at[vehicle]
        let held = self.all[i].take() else return
        self.all[i] = some(match held {
            Entity.Mob(m) => {
                var t = m
                t.player_rider = uuid
                Entity.Mob(t)
            },
            other => other,
        })
    }

    /// `Player.startRiding` of the player `player`, of the UUID `uuid`, onto the entity `vehicle`
    /// (CAL-179), `canAddPassenger`: where it's here, not gone, nothing rides it and they ride
    /// nothing here, last of what rides it, but first where the first isn't a player,
    /// `addPassenger`. Says whether they boarded. Where they sit, their teleport, the packets and
    /// their trigger are the network's.
    pub fn seat_player(mut self, player: i32, uuid: (i64, i64), vehicle: i32) -> bool {
        if self.riding_player(player) != none {
            return false
        }
        if not self.has_room(vehicle) {
            return false
        }
        var vb = self.body_at(vehicle) else return false
        if vb.removed {
            return false
        }
        let was_empty = vb.passengers.is_empty()
        // First of them where the first isn't a player, `addPassenger` on the server (CAL-207).
        if not was_empty and self.riding_player(vb.passengers[0]) == none {
            vb.passengers.insert(0, player)
        } else {
            vb.passengers.push(player)
        }
        self.put_body(vehicle, vb)
        self.share_riders(vehicle)
        self.riding_players.push((player, vehicle, uuid))
        self.refresh_player_rider(vehicle)
        self.ghast_rides(vehicle, true, was_empty)
        return true
    }

    /// Whether the entity `vehicle` has room for another rider, `canAddPassenger`: a boat as its
    /// own says (CAL-315), anything else where nothing rides it, and a strider not while its eyes
    /// are in lava (CAL-392), a camel while 2 or fewer ride it (CAL-207). None where it isn't here.
    pub fn has_room(self, vehicle: i32) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let e = self.all[self.at[vehicle]] else return false
        if let Entity.Boat(b) = e {
            return b.has_room()
        }
        if let Entity.Mob(m) = e {
            if m.species == STRIDER and m.living.body.lava_eyes {
                return false
            }
            if m.species == HAPPY_GHAST {
                return m.living.body.passengers.len() < 4
            }
            if camel_kind(m.species) {
                // `Camel.canAddPassenger`: while 2 or fewer ride it (CAL-207).
                return m.living.body.passengers.len() <= 2
            }
        }
        return body_of(e).passengers.is_empty()
    }

    /// Whether the entity `id` is a boat out of control under water, 60 ticks or more, which keeps
    /// players from boarding it (CAL-315).
    pub fn boat_out_of_control(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        if let Entity.Boat(b) = self.all[self.at[id]] {
            return b.out_of_control_ticks() >= 60.0f32
        }
        return false
    }

    /// `handlePaddleBoat`: the paddles of the boat `vehicle` as the player `player` steering it,
    /// its first rider, works them (CAL-315).
    pub fn paddle_boat(mut self, vehicle: i32, player: i32, left: bool, right: bool) {
        if not self.at.contains(vehicle) {
            return
        }
        let i = self.at[vehicle]
        let held = self.all[i].take() else return
        self.all[i] = some(match held {
            Entity.Boat(b) => {
                var t = b
                if not t.body.passengers.is_empty() and t.body.passengers[0] == player {
                    t.set_paddles(left, right)
                }
                Entity.Boat(t)
            },
            other => other,
        })
    }

    /// What the player `player` rides here, where they ride something (CAL-179).
    pub fn player_vehicle(self, player: i32) -> i32? {
        let k = self.riding_player(player) else return none
        let (_, vehicle, _) = self.riding_players[k]
        return some(vehicle)
    }

    /// Whether the entity `vehicle` is here, isn't gone and carries the player `player`,
    /// `hasPassenger` (CAL-179).
    /// Where the mob `vehicle` is, its motion and its gravity, where the player `player` steers
    /// it, `getControllingPassenger() == player`, holding a carrot on a stick or not,
    /// `steers_pigs` (CAL-179).
    pub fn steered(self, vehicle: i32, player: i32, steers_pigs: bool, steers_striders: bool) -> ((f64, f64, f64), f64)? {
        if not self.at.contains(vehicle) {
            return none
        }
        if let Entity.Mob(mob) = self.all[self.at[vehicle]] {
            if mob.player_steers(player, steers_pigs, steers_striders) and not mob.living.body.removed {
                let b = mob.living.body.copy()
                return some(((b.x, b.y, b.z), b.gravity_now()))
            }
        }
        // A boat's steered by its first rider where that's a player (CAL-315).
        if let Entity.Boat(boat) = self.all[self.at[vehicle]] {
            let b = boat.body.copy()
            if not b.removed and not b.passengers.is_empty() and b.passengers[0] == player {
                return some(((b.x, b.y, b.z), b.gravity_now()))
            }
        }
        return none
    }

    /// Where the entity `id` is and how it's turned, `storePositionAndRotation`, and its name as
    /// vanilla's log writes it, `getPlainTextName`, its type's English name from its key, as
    /// "Zombie Horse" (CAL-179).
    pub fn placed(self, id: i32) -> ((f64, f64, f64), f32, f32, String)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let b = body_of(e)
        var name = String()
        if let Entity.Mob(mob) = e {
            let key = type_name(mob.species)
            let path = key.split(":")
            var first = true
            for word in path[path.len() - 1].split("_") {
                if not first {
                    name.push_str(" ")
                }
                first = false
                let runes = word.split("")
                for k in 0..runes.len() {
                    name.push_str(if k == 0 { runes[k].to_upper_root() } else { runes[k].copy() })
                }
            }
        }
        return some(((b.x, b.y, b.z), b.y_rot, b.x_rot, name))
    }

    /// The boost a carrot on a stick gives the mob `vehicle`, `ItemSteerable.boost`, `Mob.boost`'s
    /// (CAL-179), a pig's, or a warped fungus on a stick a strider's, where `strider` (CAL-392).
    /// Whether it began.
    pub fn boost(mut self, vehicle: i32, strider: bool) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let i = self.at[vehicle]
        let taken = self.all[i].take() else return false
        var began = false
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                began = it.boost(strider)
                Entity.Mob(it)
            },
            other => other,
        })
        return began
    }

    /// The horse `vehicle` jumped by its rider with the strength `data`, `ride_jump` (CAL-179),
    /// its sounds in `sounds`. Whether it jumped.
    pub fn ride_jump(mut self, vehicle: i32, data: i32, sounds: mut List<EntitySound>) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let i = self.at[vehicle]
        let taken = self.all[i].take() else return false
        var jumped = false
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                jumped = it.ride_jump(data, mut sounds)
                Entity.Mob(it)
            },
            other => other,
        })
        return jumped
    }

    /// Whether the horse `id` opens its inventory for the player `player`,
    /// `openCustomInventoryScreen` (CAL-179): tamed, and with nothing riding it but them.
    pub fn mount_opens(self, id: i32, player: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let Entity.Mob(mob) = self.all[self.at[id]] else return false
        // A tame nautilus's, `AbstractNautilus.openCustomInventoryScreen` (CAL-316).
        let tame_nautilus = nautilus_kind(mob.species) and mob.is_tame()
        if not tame_nautilus and (not mob.equine() or not mob.horse_flag(2)) {
            return false
        }
        return mob.living.body.passengers.is_empty() or mob.living.body.passengers.contains(player)
    }

    /// What a horse's menu shows of the mob `id` (CAL-179): its saddle and body armor, whether it
    /// may use those slots, `canUseSlot`, its type's name, whether it's alive, and its box, which
    /// the menu's opener must stay in reach of; none where it isn't a horse here.
    pub fn mount_view(self, id: i32) -> (Tag?, Tag?, bool, bool, String, bool, Aabb)? {
        if not self.at.contains(id) {
            return none
        }
        let Entity.Mob(mob) = self.all[self.at[id]] else return none
        if not mob.equine() and not nautilus_kind(mob.species) {
            return none
        }
        let alive = mob.living.alive() and not mob.living.body.removed
        return some((mob.living.equipment[7].copy(), mob.living.equipment[6].copy(), mob.may_use_slot(7), mob.may_use_slot(6), String(type_name(mob.species)), alive, mob.living.body.bounding_box()))
    }

    /// A horse's menu's slots given back to the mob `id`, its saddle and body armor, each
    /// `setItemSlot`, and where it's anything, kept for its drops and itself kept,
    /// `setGuaranteedDrop`, `setPersistenceRequired` (CAL-179).
    pub fn mount_worn(mut self, id: i32, held: List<Tag?>) {
        if not self.at.contains(id) or held.len() < 2 {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                it.wear_from_menu(7, held[0].copy())
                it.wear_from_menu(6, held[1].copy())
                // Then its chest's, where the menu has as many as it has, `hasInventoryChanged`.
                if held.len() == it.chest_items.len() + 2 {
                    for k in 0..it.chest_items.len() {
                        it.chest_items[k] = held[k + 2].copy()
                    }
                }
                Entity.Mob(it)
            },
            other => other,
        })
    }

    /// A donkey's chest's columns and what's in its slots, for its menu (CAL-179).
    pub fn mount_chest(self, id: i32) -> (i32, List<Tag?>)? {
        if not self.at.contains(id) {
            return none
        }
        let Entity.Mob(mob) = self.all[self.at[id]] else return none
        return some((mob.mount_columns(), mob.chest_items.copy()))
    }

    /// The equip sound of the mob `id` as a horse's menu set what it wears in the slot `slot` from
    /// `old` to `stack`, `onEquipItem`, with `items`' codecs (CAL-179).
    pub fn mount_equip_sound<W: Wearing>(mut self, id: i32, items: W, slot: usize, old: Tag?, stack: Tag?, sounds: mut List<EntitySound>) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                it.equip_heard(items, slot, old.copy(), stack.copy(), mut sounds)
                Entity.Mob(it)
            },
            other => other,
        })
    }

    pub fn carries_player(self, vehicle: i32, player: i32) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let e = self.all[self.at[vehicle]] else return false
        let b = body_of(e)
        return not b.removed and b.passengers.contains(player)
    }

    /// `stopRiding` of the player `player` (CAL-179), `removeVehicle`: off what they ride, for
    /// the network to put where they get off, `take_players_off`.
    pub fn unseat_player(mut self, player: i32) {
        self.leave(player, false)
    }

    /// The sounds made as things got on or off what they ride since, for the level to play
    /// (CAL-384).
    pub fn take_said(mut self) -> List<EntitySound> {
        let out = self.said.copy()
        self.said.clear()
        return out
    }

    // The happy ghast `vehicle` boarded, `HappyGhast.addPassenger`, where nothing rode it before
    // where `was_empty`; else got off, `removePassenger` (CAL-384).
    fn ghast_rides(mut self, vehicle: i32, boarded: bool, was_empty: bool) {
        if not self.at.contains(vehicle) {
            return
        }
        let i = self.at[vehicle]
        let held = self.all[i].take() else return
        var heard = List<EntitySound>()
        self.all[i] = some(match held {
            Entity.Mob(m) => {
                var t = m
                if t.species == HAPPY_GHAST {
                    if boarded {
                        t.happy_ghast_boarded(was_empty, mut heard)
                    } else {
                        let empty = t.living.body.passengers.is_empty()
                        t.happy_ghast_alighted(empty, mut heard)
                    }
                }
                Entity.Mob(t)
            },
            other => other,
        })
        self.said.extend(heard)
    }

    // The mob `vehicle` told of the first player riding it, by their UUID, or that none does, as
    // only its first rider steers it (CAL-384).
    fn refresh_player_rider(mut self, vehicle: i32) {
        var first: (i64, i64)? = none
        if let vb = self.body_at(vehicle) {
            for p in vb.passengers {
                for (q, v, uuid) in self.riding_players {
                    if q == p and v == vehicle and first == none {
                        first = some(uuid)
                    }
                }
            }
        }
        self.set_player_rider(vehicle, first)
    }

    /// The player the mob `vehicle` threw off as it ran around, `ejectPassengers` (CAL-179), off
    /// it where it was as it did, `thrown_from`, for the network to put where they get off.
    pub fn throw_player(mut self, vehicle: i32) {
        var player: i32? = none
        for (p, v, _) in self.riding_players {
            if v == vehicle {
                player = some(p)
            }
        }
        let rider = player else return
        let i = self.at[vehicle]
        var from: Body? = none
        if let held = self.all[i].take() {
            self.all[i] = some(match held {
                Entity.Mob(mb) => {
                    from = mb.thrown_from.copy()
                    Entity.Mob(mb)
                },
                other => other,
            })
        }
        let before = self.players_off.len()
        self.leave(rider, false)
        let b = from else return
        let box = b.bounding_box()
        var k = before
        while k < self.players_off.len() {
            self.players_off[k].x = b.x
            self.players_off[k].y = b.y
            self.players_off[k].z = b.z
            self.players_off[k].top = box.max_y
            self.players_off[k].bottom = box.min_y
            self.players_off[k].width = b.width
            self.players_off[k].yaw = b.y_rot
            k += 1
        }
    }

    /// The statistic a player riding the entity `vehicle` counts how far they go by,
    /// `checkRidingStatistics` (CAL-179): a boat's `boat_one_cm` (CAL-315), a pig's `pig_one_cm`, a
    /// horse's or its kin's `horse_one_cm`, a strider's `strider_one_cm`, a happy ghast's
    /// `happy_ghast_one_cm` and a nautilus's or zombie nautilus's `nautilus_one_cm` (CAL-316); none
    /// for what else Calcite has.
    pub fn riding_stat(self, vehicle: i32) -> str? {
        if not self.at.contains(vehicle) {
            return none
        }
        let e = self.all[self.at[vehicle]] else return none
        if let Entity.Boat(_) = e {
            // `BOAT_ONE_CM` (CAL-315).
            return some("boat_one_cm")
        }
        if let Entity.Cart(_) = e {
            // `MINECART_ONE_CM` (CAL-315).
            return some("minecart_one_cm")
        }
        let Entity.Mob(m) = e else return none
        if m.species == PIG {
            return some("pig_one_cm")
        }
        if m.equine() {
            return some("horse_one_cm")
        }
        if m.species == STRIDER {
            return some("strider_one_cm")
        }
        if m.species == HAPPY_GHAST {
            return some("happy_ghast_one_cm")
        }
        if nautilus_kind(m.species) {
            return some("nautilus_one_cm")
        }
        return none
    }

    /// The effects on the mob `vehicle`, which a player boarding it is sent and getting off it is
    /// told are gone, `sendActiveEffects` (CAL-179).
    pub fn effects_on(self, vehicle: i32) -> List<ActiveEffect> {
        if not self.at.contains(vehicle) {
            return List<ActiveEffect>()
        }
        let e = self.all[self.at[vehicle]] else return List<ActiveEffect>()
        let Entity.Mob(m) = e else return List<ActiveEffect>()
        return m.living.effects.copy()
    }

    /// The players who got off something since, as `unseat_player` and what threw or dropped
    /// them left them (CAL-179).
    pub fn take_players_off(mut self) -> List<Unseat> {
        let out = self.players_off.copy()
        self.players_off.clear()
        return out
    }

    /// Where the entity `vehicle` seats the player `player` riding it, as they look `y_rot`,
    /// `positionRider`: where it seats what rides it, as `position_rider` has it, less where a
    /// player's held, `DEFAULT_VEHICLE_ATTACHMENT`, 0.6 up; and the turn a horse gives them,
    /// `yBodyRot` (CAL-179). None where it doesn't carry them.
    pub fn player_seat(self, vehicle: i32, player: i32, y_rot: f32) -> ((f64, f64, f64), f32?)? {
        if not self.at.contains(vehicle) {
            return none
        }
        let (vb, seat, turn, rise) = self.seat_info(vehicle, player) else return none
        if not vb.passengers.contains(player) {
            return none
        }
        let (ax, ay, az) = turned(seat, vb.y_rot)
        let (ex, ey, ez) = turned(rise, vb.y_rot)
        let (hx, hy, hz) = turned((0.0, 0.6, 0.0), y_rot)
        return some(((vb.x + (ax + ex) - hx, vb.y + (ay + ey) - hy, vb.z + (az + ez) - hz), turn))
    }

    // The entity at `i`'s ID, what it rides, whether anything rides it, whether it's gone, and
    // whether it's alive, where it's there and not lent (D708).
    fn riding_at(self, i: usize) -> (i32, i32?, bool, bool, bool)? {
        let e = self.all[i] else return none
        let (id, rides, carries) = riding_of(e)
        return some((id, rides, carries, body_of(e).removed, alive_kind(e)))
    }

    // What rides `id` off it, `ejectPassengers`, last first, `gone` where it's gone.
    fn eject(mut self, id: i32, gone: bool) {
        let riders = self.passengers_of(id)
        var k = riders.len()
        while k > 0 {
            k -= 1
            self.leave(riders[k], gone)
        }
    }

    /// `dismountVehicle` of what got off something since (D708): where it's gone, as it is; else
    /// where what it rode isn't gone and isn't in a portal, `#portals`, where that puts it,
    /// `getDismountLocationForPassenger`: an animal's beside it, `Animal`'s, else on its box's
    /// top, `Entity`'s; else where it is, but no lower than what it rode, put out of the blocks
    /// there, `findFreePosition`, unless it's over 4 wide or tall. It's put there as it looks,
    /// `dismountTo`, `teleportTo`, `snapTo`, and so what rides it, `teleportPassengers`.
    pub fn seat_off<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B) {
        let offs = self.unseated.copy()
        self.unseated.clear()
        for off in offs {
            let b = self.body_at(off.rider) else continue
            if b.removed or b.vehicle != none {
                continue
            }
            let (at, _) = self.off_spot(f, m, blocks, off, (b.x, b.y, b.z), b.width, [b.height], b.mover())
            self.snap_to(off.rider, at)
        }
    }

    /// Where what got off as `off` has it, at `at`, `width` wide and as tall in each pose it may
    /// get off in as `heights` has it, first as it is, and `mover` for the blocks whose shapes
    /// depend on it, gets off, as `seat_off` puts it (D708), with the pose it's put in where it's
    /// put in one, `setPose` (CAL-179).
    pub fn off_spot<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, off: Unseat, at: (f64, f64, f64), width: f32, heights: List<f32>, mover: Mover) -> ((f64, f64, f64), usize?) {
        let border = self.border ?? (-2.9999984e7, -2.9999984e7, 2.9999984e7, 2.9999984e7)
        let vx = i32.saturate(off.x.floor())
        let vy = i32.saturate(off.y.floor())
        let vz = i32.saturate(off.z.floor())
        let portal = f.in_set(state_at(blocks, vx, vy, vz), f.tag("minecraft:portals"))
        if not off.gone and not portal {
            if off.boat {
                if let (spot, pose) = boat_dismount(f, m, blocks, border, off.x, off.z, off.top, off.width, off.rider_yaw, width, heights, mover) {
                    return (spot, some(pose))
                }
                return ((off.x, off.top, off.z), none)
            }
            if off.cart {
                let forward = cart_motion_direction(off.yaw, off.flipped)
                if let (spot, pose) = cart_dismount(f, m, blocks, border, off.x, off.y, off.z, forward, width, heights, mover) {
                    return (spot, some(pose))
                }
                return ((off.x, off.top, off.z), none)
            }
            if off.horse {
                if let (spot, pose) = horse_dismount(f, m, blocks, border, off.x, off.z, off.bottom, off.top, off.yaw, off.width, off.left, width, heights, mover) {
                    return (spot, some(pose))
                }
                return ((off.x, off.y, off.z), none)
            }
            if off.strider {
                if let (spot, pose) = strider_dismount(f, m, blocks, border, off.x, off.z, off.bottom, off.top, off.width, off.rider_yaw, width, heights, mover) {
                    return (spot, some(pose))
                }
                return ((off.x, off.top, off.z), none)
            }
            if off.happy_ghast {
                // `HappyGhast.getDismountLocationForPassenger`: on its box's top where it is across
                // (CAL-384).
                return ((off.x, off.top, off.z), none)
            }
            if off.animal {
                if let (spot, pose) = animal_dismount(f, m, blocks, border, off.x, off.y, off.z, off.yaw, width, heights, mover) {
                    return (spot, some(pose))
                }
            }
            return ((off.x, off.top, off.z), none)
        }
        let (x, y, z) = at
        let bottom = (x, if y > off.y { y } else { off.y }, z)
        return (free_position(f, m, blocks, border, bottom, width, heights[0], mover), none)
    }

    /// `handleMoveVehicle` for the mob `id` a player steers, their client having moved it `to`,
    /// turned `y_rot` and `x_rot`, on the ground or not, `ground`, from where it was as the
    /// player's tick began, `first_good`, and as their last move left it, `last_good` (CAL-179).
    /// Moved too quickly, it's sent back. Else it moves there as the player's moves do,
    /// `MoverType.PLAYER`, its client having the say, so no fall checked nor bounce, its steps
    /// heard, stepping up a block at least, `maxUpStep`; where it got a sixteenth of a block
    /// squared from there across, it moved wrongly, and is put back, turned as the client says,
    /// where its box had room, `noCollision`, or where there it meets what it didn't, as a
    /// player's move is, `isEntityCollidingWithAnythingNew`, its move forgotten,
    /// `removeLatestMovementRecording`. Else it's put there, `absSnapTo`, on the ground as the
    /// client says with its fall checked, `doCheckFallDamage`; floating where it didn't go down
    /// more than a thirty-second, didn't stand on anything before, flight's not allowed, it falls,
    /// and nothing's around it but air. What it showed is kept for the level.
    pub fn steered_move<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, id: i32, to: (f64, f64, f64), y_rot: f32, x_rot: f32, ground: bool, first_good: (f64, f64, f64), last_good: (f64, f64, f64), allow_flight: bool, fast_lava: bool, rider: (f64, f64, f64), sounds: mut List<EntitySound>) -> Steered {
        if not self.at.contains(id) {
            return Steered.Nothing
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return Steered.Nothing
        var it = match taken {
            Entity.Mob(mob) => mob,
            Entity.Boat(boat) => {
                // What it collides with along the move, but the players, whom the network keeps
                // (CAL-315).
                var bt = boat
                let (tx, ty, tz) = to
                let (lx, ly, lz) = last_good
                let reach = (tx - lx).abs() + (ty - ly).abs() + (tz - lz).abs() + 0.5
                bt.body.others = self.boat_others(lf, f, blocks, bt.body, bt.body.bounding_box().inflate(reach, reach, reach), List<Follower>())
                let (got, moved) = steered_boat(f, m, t, blocks, bt, to, y_rot, x_rot, ground, first_good, last_good, allow_flight)
                var back = moved
                back.body.others.clear()
                let (bx, by, bz) = (back.body.x, back.body.y, back.body.z)
                self.all[i] = some(Entity.Boat(back))
                self.move_section(id, section_key(bx, by, bz))
                return got
            },
            other => {
                self.all[i] = some(other)
                return Steered.Nothing
            },
        }
        let (tx, ty, tz) = to
        let (ox, oy, oz) = (it.living.body.x, it.living.body.y, it.living.body.z)
        let (fx, fy, fz) = first_good
        let (fdx, fdy, fdz) = (tx - fx, ty - fy, tz - fz)
        let (bvx, bvy, bvz) = (it.living.body.vx, it.living.body.vy, it.living.body.vz)
        let expected = bvx * bvx + bvy * bvy + bvz * bvz
        if fdx * fdx + fdy * fdy + fdz * fdz - expected > 100.0 {
            let (yr, xr) = (it.living.body.y_rot, it.living.body.x_rot)
            self.all[i] = some(Entity.Mob(it))
            return Steered.TooQuick((ox, oy, oz), yr, xr)
        }
        let old_box = it.living.body.bounding_box()
        let (lx, ly, lz) = last_good
        let rests = it.living.body.vertical_below
        if it.living.on_climbable(lf, f, blocks) {
            it.living.body.reset_fall()
        }
        let step = it.living.body.step
        it.living.body.step = if step < 1.0f32 { 1.0f32 } else { step }
        it.living.body.owned = false
        // Its swim heard by the motion of the player steering it, `rider`, as their own tick left
        // it, `waterSwimSound` (CAL-420).
        it.living.rider_motion = some(rider)
        it.living.move_self(lf, f, m, t, blocks, tx - lx, ty - ly, tz - lz, fast_lava, mut sounds)
        it.living.rider_motion = none
        it.living.body.owned = true
        it.living.body.step = step
        let (wx, wz) = (tx - it.living.body.x, tz - it.living.body.z)
        let wrong = wx * wx + wz * wz > 0.0625
        let mover = it.living.body.mover()
        let room = m.colliders(f, blocks, old_box, mover).is_empty()
        let (yr, xr) = (y_rot % 360.0f32, clamp_f32(x_rot, -90.0f32, 90.0f32) % 360.0f32)
        if (wrong and room) or meets_new(f, m, blocks, it.living.body, old_box, tx, ty, tz) {
            snap_body(mut it.living, ox, oy, oz, yr, xr)
            it.living.body.forget_move()
            self.all[i] = some(Entity.Mob(it))
            self.move_section(id, section_key(ox, oy, oz))
            return Steered.Refused((ox, oy, oz), yr, xr, wrong)
        }
        snap_body(mut it.living, tx, ty, tz, yr, xr)
        let (cx, cy, cz) = (it.living.body.x, it.living.body.y, it.living.body.z)
        it.living.client_landed(lf, f, m, t, blocks, cx - ox, cy - oy, cz - oz, ground, fast_lava, mut sounds)
        let griefing = self.mob_griefing
        self.tramples(mut it.living, griefing, false)
        // A grown happy ghast is a flying vehicle, which never floats, `isFlyingVehicle` (CAL-384).
        let flies = it.species == HAPPY_GHAST and not it.baby()
        let floating = ty - ly >= -0.03125 and not rests and not allow_flight and not flies and not it.living.body.no_gravity and no_blocks_around(f, blocks, it.living.body.bounding_box())
        _ = self.keep_shown(id, mut it)
        self.all[i] = some(Entity.Mob(it))
        self.move_section(id, section_key(cx, cy, cz))
        return Steered.Taken((ox, oy, oz), (cx, cy, cz), wrong, floating)
    }

    // `snapTo` of the entity `id` to `at` as it looks, there last tick too, and what rides it
    // with it, `teleportPassengers` (D708).
    fn snap_to(mut self, id: i32, at: (f64, f64, f64)) {
        var b = self.body_at(id) else return
        let (x, y, z) = at
        b.x = x
        b.y = y
        b.z = z
        b.xo = x
        b.yo = y
        b.zo = z
        self.put_body(id, b)
        self.move_section(id, section_key(x, y, z))
        var carrying: List<i32> = [id]
        var k: usize = 0
        while k < carrying.len() {
            let v = carrying[k]
            for p in self.passengers_of(v) {
                self.position_rider(v, p, true)
                carrying.push(p)
            }
            k += 1
        }
    }

    // `positionRider` of the entity `rider` on `vehicle` (D708): where `vehicle` seats it,
    // `getPassengerRidingPosition`, its seat turned by its yaw, less where `rider` is held, turned
    // by its own, `setPos`, or `snapTo` where `snap`; a living rider of a chicken or a horse
    // turned as it is, `yBodyRot`; a boat's turning it as `AbstractBoat.positionRider` has it,
    // `boat_turned` (CAL-315). Nothing where `rider` doesn't ride it.
    fn position_rider(mut self, vehicle: i32, rider: i32, snap: bool) {
        if not self.at.contains(vehicle) or not self.at.contains(rider) {
            return
        }
        var boat_turn: (f32, f32, bool)? = none
        if let Entity.Boat(bt) = self.all[self.at[vehicle]] {
            let seats: usize = if bt.has_chest() { 1 } else { 2 }
            boat_turn = some((bt.delta_rotation, bt.body.y_rot, bt.body.passengers.len() == seats))
        }
        let (vb, seat, turn, rise) = self.seat_info(vehicle, rider) else return
        if not vb.passengers.contains(rider) {
            return
        }
        let ri = self.at[rider]
        let re = self.all[ri].take() else return
        let rb = body_of(re)
        let (ax, ay, az) = turned(seat, vb.y_rot)
        let (ex, ey, ez) = turned(rise, vb.y_rot)
        let (sx, sy, sz) = (ax + ex, ay + ey, az + ez)
        let (hx, hy, hz) = turned(held_at(re), rb.y_rot)
        let (x, y, z) = (vb.x + sx - hx, vb.y + sy - hy, vb.z + sz - hz)
        var moved = rb
        moved.x = x
        moved.y = y
        moved.z = z
        if snap {
            moved.xo = x
            moved.yo = y
            moved.zo = z
        }
        var back = with_body(re, moved)
        if let r = turn {
            back = match back {
                Entity.Mob(rm) => {
                    var t = rm
                    t.living.y_body_rot = r
                    Entity.Mob(t)
                },
                Entity.Stand(ra) => {
                    var t = ra
                    t.living.y_body_rot = r
                    Entity.Stand(t)
                },
                other => other,
            }
        }
        if let (delta, yaw, full) = boat_turn {
            back = boat_turned(back, rider, delta, yaw, full)
        }
        self.all[ri] = some(back)
        self.move_section(rider, section_key(x, y, z))
    }

    // The body of the entity `vehicle`, a copy, where it seats `rider` before its turn, the
    // turn it gives a living rider, a chicken's and a horse's own, `yBodyRot` (D708), and how far
    // a horse's rise as it stands moves the seat up and back before its turn, by its rise last
    // tick, `standAnimO`, and its age's scale (D710); a boat's seat as its riders sit (CAL-315).
    fn seat_info(self, vehicle: i32, rider: i32) -> (Body, (f64, f64, f64), f32?, (f64, f64, f64))? {
        let ve = self.all[self.at[vehicle]] else return none
        if let Entity.Boat(boat) = ve {
            var index: usize = 0
            for k in 0..boat.body.passengers.len() {
                if boat.body.passengers[k] == rider {
                    index = k
                }
            }
            var animal = false
            if self.at.contains(rider) {
                if let Entity.Mob(rm) = self.all[self.at[rider]] {
                    animal = rm.animal
                }
            }
            return some((boat.body.copy(), boat.seat(index, animal), none, (0.0, 0.0, 0.0)))
        }
        if let Entity.Cart(cart) = ve {
            // A minecart's seat, a villager's lower (CAL-315); wandering traders aren't made.
            var lowered = false
            if self.at.contains(rider) {
                if let Entity.Mob(rm) = self.all[self.at[rider]] {
                    lowered = rm.species == VILLAGER
                }
            }
            return some((cart.body.copy(), cart_seat(lowered), none, (0.0, 0.0, 0.0)))
        }
        var turn: f32? = none
        var rise = (0.0, 0.0, 0.0)
        if let Entity.Mob(vm) = ve {
            if vm.species == HAPPY_GHAST {
                // Its seats, one for each of up to four riders, `passengerAttachments` (CAL-384).
                var index: usize = 0
                for k in 0..vm.living.body.passengers.len() {
                    if vm.living.body.passengers[k] == rider {
                        index = k
                    }
                }
                return some((vm.living.body.copy(), happy_ghast_seat(vm.baby(), index), none, (0.0, 0.0, 0.0)))
            }
            if vm.species == CHICKEN or vm.equine() {
                turn = some(vm.living.y_body_rot)
            }
            if camel_kind(vm.species) {
                // Its seats, one for each of its riders, by where its body is as it sits down or
                // stands up, `Camel.getPassengerAttachmentPoint`, no standing's rise (CAL-207).
                var index: usize = 0
                for k in 0..vm.living.body.passengers.len() {
                    if vm.living.body.passengers[k] == rider {
                        index = k
                    }
                }
                var animal = false
                if self.at.contains(rider) {
                    if let Entity.Mob(rm) = self.all[self.at[rider]] {
                        animal = rm.animal
                    }
                }
                return some((vm.living.body.copy(), vm.camel_seat(index, vm.living.body.passengers.len(), animal, self.game_time), turn, (0.0, 0.0, 0.0)))
            }
            if vm.equine() {
                let scale = f64(if vm.baby() { 0.5f32 } else { 1.0f32 })
                let o = f64(vm.stand_anim_o)
                rise = (0.0, 0.15 * o * scale, -0.7 * o * scale)
            }
        }
        return some((body_of(ve), seat_of(ve), turn, rise))
    }

    // Whether the entity `vehicle` is here, isn't gone and has `rider` among what rides it,
    // `hasPassenger` (D708).
    fn carries(self, vehicle: i32, rider: i32) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let e = self.all[self.at[vehicle]] else return true
        let b = body_of(e)
        return not b.removed and b.passengers.contains(rider)
    }

    /// `Entity.teleport` of the entity `id`, not a player, to x, y, z by an ender pearl of its own
    /// that landed in its level, `teleportSameDimension` (D585), where it may go,
    /// `isAllowedToTeleportOwner`: a living entity alive and not asleep, anything else not gone.
    /// It's put there, `teleportSetPosition`, at its own yaw and pitch, nothing relative, a living
    /// entity's head turned to its yaw, `setYHeadRot`; where it was last known forgotten,
    /// `reapplyPosition`; there last tick too, `setOldPosAndRot`; still, `Vec3.ZERO`; what it
    /// moved this tick forgotten, `clearMovementThisTick`; then nothing fallen,
    /// `resetFallDistance`, and a living entity's impulse forgotten, `resetCurrentImpulseContext`;
    /// and in the section it's in now, `onMove`. None where it isn't here or may not go.
    pub fn pearl_take(mut self, id: i32, x: f64, y: f64, z: f64) -> PearlTaken? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let e = self.all[i].take() else return none
        var taken: PearlTaken? = none
        let back = match e {
            Entity.Item(it) => {
                var t = it
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Item(t)
            },
            Entity.Orb(o) => {
                var t = o
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Orb(t)
            },
            Entity.Stand(a) => {
                var t = a
                if t.living.alive() {
                    taken = some(pearl_set_living(mut t.living, x, y, z))
                }
                Entity.Stand(t)
            },
            Entity.Mob(m) => {
                var t = m
                if t.living.alive() and t.living.sleeping == none {
                    taken = some(pearl_set_living(mut t.living, x, y, z))
                }
                Entity.Mob(t)
            },
            Entity.Arrow(a) => {
                var t = a
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Arrow(t)
            },
            Entity.Thrown(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Thrown(t)
            },
            Entity.Cloud(c) => {
                var t = c
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Cloud(t)
            },
            Entity.Crystal(c) => {
                var t = c
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Crystal(t)
            },
            Entity.Eye(eye) => {
                var t = eye
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, false))
                }
                Entity.Eye(t)
            },
            Entity.Fireball(b) => {
                var t = b
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Fireball(t)
            },
            Entity.Tnt(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Tnt(t)
            },
            Entity.Falling(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Falling(t)
            },
            Entity.Boat(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Boat(t)
            },
            Entity.Cart(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Cart(t)
            },
            Entity.Knot(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Knot(t)
            },
            Entity.Hanging(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Hanging(t)
            },
            Entity.Fangs(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, false))
                }
                Entity.Fangs(t)
            },
            Entity.Bolt(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, false))
                }
                Entity.Bolt(t)
            },
        }
        self.all[i] = some(back)
        if taken != none {
            self.move_section(id, section_key(x, y, z))
        }
        return taken
    }

    /// `addTag` or `removeTag` of the entity `id`, not a player (CAL-165), by `tag_change`. Whether
    /// it changed.
    pub fn change_tag(mut self, id: i32, name: String, add: bool) -> bool {
        var b = self.body_at(id) else return false
        if b.removed {
            return false
        }
        let saved: Tag? = if b.extras.contains("Tags") { some(b.extras["Tags"].copy()) } else { none }
        let (did, changed) = tag_change(saved, name, add)
        if not did {
            return false
        }
        match changed {
            some(t) => b.extras.insert(String("Tags"), t),
            none => _ = b.extras.remove("Tags"),
        }
        self.put_body(id, b)
        return true
    }

    /// Whether the entity `id`, not a player, has the slot `slot` as `item` reaches it, and what's
    /// in it, `getSlot(slot).get()` (CAL-165): a chest or hopper minecart's or a chest boat's own
    /// slots from 0, `getChestVehicleSlot` (CAL-386); a mob's or an armor stand's equipment,
    /// `worn_index`. Its other slots, an item's, an arrow's, an inventory's or a horse's,
    /// Calcite doesn't reach yet, which the caller says.
    pub fn entity_slot(self, id: i32, slot: i32) -> (bool, Tag?) {
        if not self.at.contains(id) {
            return (false, none)
        }
        let (vehicle, held) = self.vehicle_slot(id, slot)
        if vehicle {
            return (true, held)
        }
        let k = worn_index(slot) else return (false, none)
        let e = self.all[self.at[id]] else return (false, none)
        return match e {
            Entity.Mob(m) => (true, m.living.equipment[k].copy()),
            Entity.Stand(a) => (true, a.living.equipment[k].copy()),
            _ => (false, none),
        }
    }

    // What's in the slot `slot` of the entity `id`, where it's a chest or hopper minecart's or a
    // chest boat's, from 0 below its size, `getChestVehicleSlot` (CAL-386), and whether it's one
    // of theirs.
    fn vehicle_slot(self, id: i32, slot: i32) -> (bool, Tag?) {
        let e = self.all[self.at[id]] else return (false, none)
        let items = match e {
            Entity.Cart(c) => c.items.copy(),
            Entity.Boat(b) => b.items.copy(),
            _ => return (false, none),
        }
        if slot < 0 or usize.wrap(slot) >= items.len() {
            return (false, none)
        }
        return (true, items[usize.wrap(slot)].copy())
    }

    /// `getSlot(slot).set(stack)` of the entity `id`'s equipment (CAL-165),
    /// `createEquipmentSlotAccess`: the feet's, legs', chest's, body's and saddle's take only what's
    /// empty or equips there, `getEquipmentSlotForItem`, its equippable's slot where it may use it,
    /// `canUseSlot`, else the main hand's; then it's worn, `setItemSlot`, heard as `onEquipItem`
    /// has it, with `items`' codecs. Whether it took it.
    pub fn put_entity_slot<W: Wearing>(mut self, id: i32, slot: i32, stack: Tag?, items: W, sounds: mut List<EntitySound>) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let (vehicle, _) = self.vehicle_slot(id, slot)
        if vehicle {
            // A chest vehicle's own slot, `setChestVehicleItem` (CAL-386).
            let at = self.at[id]
            let e = self.all[at].take() else return false
            let s = usize.wrap(slot)
            self.all[at] = some(match e {
                Entity.Cart(c) => {
                    var t = c
                    t.items[s] = stack.copy()
                    Entity.Cart(t)
                },
                Entity.Boat(b) => {
                    var t = b
                    t.items[s] = stack.copy()
                    Entity.Boat(t)
                },
                other => other,
            })
            return true
        }
        let k = worn_index(slot) else return false
        let i = self.at[id]
        let e = self.all[i].take() else return false
        let checked = k == 2 or k == 3 or k == 4 or k == 6 or k == 7
        var took = false
        self.all[i] = some(match e {
            Entity.Mob(m) => {
                var t = m
                let fits = match stack.copy() {
                    some(st) => mob_slot_for(t, items, st) == k,
                    none => true,
                }
                if fits or not checked {
                    let old = t.living.equipment[k].copy()
                    t.living.equipment[k] = stack.copy()
                    t.equip_heard(items, k, old, stack.copy(), mut sounds)
                    took = true
                }
                Entity.Mob(t)
            },
            Entity.Stand(a) => {
                var t = a
                let fits = stack == none or t.slot_of(items, stack.copy()) == k
                if fits or not checked {
                    t.put_on(items, k, stack.copy(), mut sounds)
                    took = true
                }
                Entity.Stand(t)
            },
            other => other,
        })
        return took
    }

    /// What loot reads of the entity `id`, not a player, as a `THIS_ENTITY` (CAL-165): a mob's or
    /// an armor stand's own, another's type alone; and where it is, either way.
    pub fn loot_entity_of(self, id: i32) -> LootEntity {
        let picked = self.picking(id)
        var out = LootEntity { kind: String() }
        if self.at.contains(id) {
            if let e = self.all[self.at[id]] {
                out = match e {
                    Entity.Mob(m) => m.loot_entity(),
                    Entity.Stand(a) => a.loot_entity(),
                    _ => LootEntity { kind: String() },
                }
            }
        }
        if let k = picked {
            if out.kind.is_empty() {
                out.kind = k.kind.copy()
            }
            out.at = some((k.x, k.y, k.z))
        }
        return out
    }

    /// Whether a player rides the entity `id`, or what rides it, all the way up (CAL-165).
    pub fn player_rides(self, id: i32) -> bool {
        var at = List<i32>()
        at.push(id)
        var k: usize = 0
        while k < at.len() and k < 4096 {
            let v = at[k]
            for (_, vehicle, _) in self.riding_players {
                if vehicle == v {
                    return true
                }
            }
            for p in self.passengers_of(v) {
                at.push(p)
            }
            k += 1
        }
        return false
    }

    /// `Entity.teleport` of the entity `id`, not a player, by `teleport` within its level,
    /// `teleportSameDimension` (CAL-165), `x`, `y`, `z` and its turn each the change from where it
    /// is along what `relatives` makes relative, as `performTeleport` gives them: none where it
    /// isn't here or is gone; else off what it rides, `stopRiding`, no more to be put where it
    /// gets off, as it's put where it goes at once after; then taken, `command_moved`. Then, as
    /// `performTeleport` goes on, turned toward `look` from its feet or eyes, `lookAt`; not
    /// gliding, its motion up and down none and on the ground; and a mob's way forgotten,
    /// `getNavigation().stop()`, which only a `PathfinderMob`'s is, the others having none to stop.
    /// A player riding it, whom Calcite can't take with it yet, `player_rides`, is the caller's to
    /// look for first.
    /// The entity `id` off what it rides, as a command takes it to another dimension (CAL-167).
    pub fn leave_for_travel(mut self, id: i32) {
        let b = self.body_at(id) else return
        if b.vehicle == none {
            return
        }
        self.stop_riding(id)
        var kept = List<Unseat>()
        for off in self.unseated {
            if off.rider != id {
                kept.push(off.copy())
            }
        }
        self.unseated = kept
    }

    /// The entity `id` marked as gone to another dimension, `CHANGED_DIMENSION`, which doesn't
    /// destroy it, as it's taken away (CAL-167).
    pub fn set_moved_away(mut self, id: i32) {
        var b = self.body_at(id) else return
        b.removed = true
        b.moved_away = true
        self.put_body(id, b)
    }

    pub fn command_take(mut self, id: i32, x: f64, y: f64, z: f64, relatives: i32, y_rot: f32, x_rot: f32, look: (f64, f64, f64, bool)?) -> CommandTaken? {
        let b = self.body_at(id) else return none
        if b.removed {
            return none
        }
        if b.vehicle != none {
            self.stop_riding(id)
            var kept = List<Unseat>()
            for off in self.unseated {
                if off.rider != id {
                    kept.push(off.copy())
                }
            }
            self.unseated = kept
        }
        let taken = self.command_moved(id, x, y, z, relatives, y_rot, x_rot) else return none
        let i = self.at[id]
        let e = self.all[i].take() else return none
        self.all[i] = some(match e {
            Entity.Mob(m) => {
                var t = m
                if let at = look {
                    look_toward(mut t.living, at)
                }
                if i32(t.living.data.byte(SHARED_FLAGS)) & FALL_FLYING_FLAG == 0 {
                    t.living.body.vy = t.living.body.vy * 0.0
                    t.living.body.on_ground = true
                }
                t.navigation.stop()
                Entity.Mob(t)
            },
            Entity.Stand(a) => {
                var t = a
                if let at = look {
                    look_toward(mut t.living, at)
                }
                if i32(t.living.data.byte(SHARED_FLAGS)) & FALL_FLYING_FLAG == 0 {
                    t.living.body.vy = t.living.body.vy * 0.0
                    t.living.body.on_ground = true
                }
                Entity.Stand(t)
            },
            other => {
                var body = body_of(other)
                if let at = look {
                    let (px, py, pz, eyes) = at
                    let (pitch, yaw) = look_angles(body, px, py, pz, eyes)
                    body.x_rot = (pitch % 360.0f32).max(-90.0f32).min(90.0f32)
                    body.y_rot = yaw
                }
                body.vy = body.vy * 0.0
                body.on_ground = true
                with_body(other, body)
            },
        })
        return some(taken)
    }

    /// The main hand's stack of the entity `id`, a mob or an armor stand, changed to `stack` as
    /// it is, `ItemStack.enchant`, not set: no equip sound, its tick sending it as any change of
    /// its equipment (CAL-165).
    pub fn change_held(mut self, id: i32, stack: own Tag) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(match e {
            Entity.Mob(m) => {
                var t = m
                t.living.equipment[0] = some(stack)
                Entity.Mob(t)
            },
            Entity.Stand(a) => {
                var t = a
                t.living.equipment[0] = some(stack)
                Entity.Stand(t)
            },
            other => other,
        })
    }

    /// The entity `id` turned as `rotate` turns it (CAL-165): by `turn`, its yaw and whether
    /// that's added to its own, its pitch and whether that is, `forceSetRotation`, the sum within
    /// 90 of level, its head turned with it, its turns before them the same; or toward `look`,
    /// from its feet or its eyes, `Entity.lookAt`. Whether there's one to turn.
    pub fn command_turn(mut self, id: i32, turn: (f32, bool, f32, bool)?, look: (f64, f64, f64, bool)?) -> bool {
        let b = self.body_at(id) else return false
        if b.removed {
            return false
        }
        let i = self.at[id]
        let e = self.all[i].take() else return false
        self.all[i] = some(match e {
            Entity.Mob(m) => {
                var t = m
                turn_living(mut t.living, turn, look)
                Entity.Mob(t)
            },
            Entity.Stand(a) => {
                var t = a
                turn_living(mut t.living, turn, look)
                Entity.Stand(t)
            },
            other => {
                var body = body_of(other)
                if let (y_rot, y_relative, x_rot, x_relative) = turn {
                    let (y, x) = forced_turn(body.y_rot, body.x_rot, y_rot, y_relative, x_rot, x_relative)
                    body.y_rot = y
                    body.x_rot = x
                }
                if let at = look {
                    let (px, py, pz, eyes) = at
                    let (pitch, yaw) = look_angles(body, px, py, pz, eyes)
                    body.x_rot = (pitch % 360.0f32).max(-90.0f32).min(90.0f32)
                    body.y_rot = yaw
                }
                with_body(other, body)
            },
        })
        return true
    }

    // `Entity.teleport` of the entity `id`, by a command, within its level, `teleportSameDimension`
    // (CAL-165), to `x`, `y`, `z` turned `y_rot` and `x_rot`, along what `relatives` makes
    // relative: what rides it taken with it first, each as far from it as it was along what's
    // absolute and turned as far from its turn, `calculatePassengerTransition`, as a passenger,
    // so not told; then set there, `teleport_set`, a living entity's head turned to its yaw,
    // `setYHeadRot`, and its yaw and pitch last tick its own, `setOldRot`; a villager trading
    // with no one, `AbstractVillager.teleport`'s `stopTrading`; primed TNT through a portal,
    // `PrimedTnt.teleport`'s `setUsedPortal`; and in the section it's in now, `onMove`. Those that
    // see it are told at once of what the client moves too, `SERVER_AND_CLIENT`, an item, an orb,
    // a projectile or primed TNT, of what has no update interval, a cloud, an end crystal or a
    // leash knot, and of an ender dragon dying. None where it isn't here or is gone.
    fn command_moved(mut self, id: i32, x: f64, y: f64, z: f64, relatives: i32, y_rot: f32, x_rot: f32) -> CommandTaken? {
        let v = self.body_at(id) else return none
        if v.removed {
            return none
        }
        for p in v.passengers {
            let r = self.body_at(p) else continue
            let p_y_rot = y_rot + (if relatives & 8 != 0 { 0.0f32 } else { r.y_rot - v.y_rot })
            let p_x_rot = x_rot + (if relatives & 16 != 0 { 0.0f32 } else { r.x_rot - v.x_rot })
            let px = x + (if relatives & 1 != 0 { 0.0 } else { r.x - v.x })
            let py = y + (if relatives & 2 != 0 { 0.0 } else { r.y - v.y })
            let pz = z + (if relatives & 4 != 0 { 0.0 } else { r.z - v.z })
            _ = self.command_moved(p, px, py, pz, relatives, p_y_rot, p_x_rot)
        }
        let i = self.at[id]
        let e = self.all[i].take() else return none
        var body = body_of(e)
        body.teleport_set(x, y, z, relatives, y_rot, x_rot)
        var taken = CommandTaken { x: body.x, y: body.y, z: body.z, vx: body.vx, vy: body.vy, vz: body.vz, y_rot: body.y_rot, x_rot: body.x_rot, on_ground: body.on_ground, told: false, item: false, pearl: false }
        let (bx, by, bz) = (body.x, body.y, body.z)
        self.all[i] = some(match with_body(e, body) {
            Entity.Mob(m) => {
                var t = m
                t.living.y_head_rot = t.living.body.y_rot
                t.living.y_rot_o = t.living.body.y_rot
                t.living.x_rot_o = t.living.body.x_rot
                t.trading = none
                taken.told = t.species == ENDER_DRAGON and t.living.dead_or_dying()
                Entity.Mob(t)
            },
            Entity.Stand(a) => {
                var t = a
                t.living.y_head_rot = t.living.body.y_rot
                t.living.y_rot_o = t.living.body.y_rot
                t.living.x_rot_o = t.living.body.x_rot
                Entity.Stand(t)
            },
            Entity.Item(it) => {
                taken.told = true
                taken.item = true
                Entity.Item(it)
            },
            Entity.Thrown(p) => {
                taken.told = true
                taken.pearl = p.pearl
                Entity.Thrown(p)
            },
            Entity.Tnt(p) => {
                var t = p
                t.used_portal = true
                taken.told = true
                Entity.Tnt(t)
            },
            Entity.Eye(eye) => Entity.Eye(eye),
            Entity.Fangs(f) => Entity.Fangs(f),
            Entity.Bolt(f) => Entity.Bolt(f),
            // A boat or minecart has an update interval and moves where it's simulated alone,
            // `AUTHORITATIVE_SIDE`, so its trackers aren't told, `sendTeleportTransitionToPlayers`;
            // its next sync tells them (CAL-315).
            Entity.Boat(b) => Entity.Boat(b),
            Entity.Cart(c) => Entity.Cart(c),
            other => {
                taken.told = true
                other
            },
        })
        self.move_section(id, section_key(bx, by, bz))
        return some(taken)
    }

    /// The items whose boxes meet `b`, but `except`, in the order `getEntitiesOfClass` finds them:
    /// the sections a little beyond it, by x, then by z and y as `SectionPos.asLong` orders them,
    /// and in each in the order they came into it.
    pub fn find(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 1)
    }

    /// The orbs whose boxes meet `b`, but `except`, as `find` finds items.
    pub fn find_orbs(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 2)
    }

    /// Every item, orb, mob and arrow whose box meets `b`, but `except`, as `getEntities` finds
    /// them, which a player touches; an armor stand does nothing touched, `playerTouch`, and of
    /// mobs only a slime does (CAL-159).
    pub fn find_any(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 27)
    }

    /// Every item, orb, armor stand, mob, arrow, thrown potion, cloud, end crystal, eye of ender,
    /// dragon fireball, primed TNT, boat and minecart whose box meets `b`, but `except`, as
    /// `getEntities(except, box)` finds them, which keep an enderman from leaving its block there
    /// (CAL-159, D527, D529, D589, D598, D618, CAL-182, CAL-388).
    pub fn find_every(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 2047 | FALLING | BOATS | CARTS)
    }

    /// How many mobs of the species `species` have boxes meeting `b`, `getEntitiesOfClass` of
    /// their class, as `CatSpawner` counts cats (CAL-201).
    pub fn species_in(self, b: Aabb, species: i32) -> usize {
        var n: usize = 0
        for id in self.found(b, -1, 8) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Mob(o) = slot else continue
            if o.species == species {
                n += 1
            }
        }
        return n
    }

    /// How many end crystals' boxes meet `b`, `getEntitiesOfClass(EndCrystal.class, box)`, those
    /// gone left out, as they're out of their sections, which a dragon fight counts (D626).
    pub fn crystals_in(self, b: Aabb) -> i32 {
        return i32.wrap(self.crystals_found(b).len())
    }

    /// The first area effect cloud whose box meets `b` that isn't gone and whose owner is an ender
    /// dragon here, by its ID, as a glass bottle looks for one to fill from, `getEntitiesOfClass`
    /// of `AreaEffectCloud` with `isAlive` and `getOwner() instanceof EnderDragon` (CAL-214).
    pub fn dragon_cloud_in(self, b: Aabb) -> i32? {
        for id in self.found(b, -1, 64) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Cloud(c) = slot else continue
            if c.body.removed {
                continue
            }
            let owner = c.owner else continue
            let mob = self.living_by_uuid(owner) else continue
            let owned = self.all[self.at[mob]] else continue
            let Entity.Mob(m) = owned else continue
            if m.species == ENDER_DRAGON {
                return some(id)
            }
        }
        return none
    }

    /// The end crystals whose boxes meet `b`, `getEntitiesOfClass(EndCrystal.class, box)`, as
    /// `crystals_in` finds them, each with its UUID (CAL-167).
    pub fn crystals_found(self, b: Aabb) -> List<(i32, (i64, i64))> {
        var out = List<(i32, (i64, i64))>()
        for id in self.found(b, -1, 128) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Crystal(c) = slot else continue
            if not c.body.removed {
                out.push((id, c.body.uuid))
            }
        }
        return out
    }

    /// The ID of the end crystal here of the UUID `uuid` that isn't gone, `getEntity(uuid)` of an
    /// `EndCrystal` (CAL-167).
    pub fn crystal_with_uuid(self, uuid: (i64, i64)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            let Entity.Crystal(c) = e else continue
            if c.body.uuid == uuid and not c.body.removed {
                return some(c.body.id)
            }
        }
        return none
    }

    /// What an explosion asks of the entity `id`, `resistance` the attribute of a living one's
    /// explosion knockback resistance, none where it isn't here (CAL-182).
    pub fn reached(self, id: i32, resistance: u32) -> Reached? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(match e {
            Entity.Item(i) => reached_body(i.body, 1, false, 0.0),
            Entity.Orb(o) => reached_body(o.body, 2, false, 0.0),
            Entity.Stand(a) => reached_body(a.living.body, 4, a.invisible, a.living.attributes.value(resistance)),
            Entity.Mob(m) => reached_body(m.living.body, 8, false, m.living.attributes.value(resistance)),
            Entity.Arrow(a) => reached_body(a.body, 16, false, 0.0),
            Entity.Thrown(p) => reached_body(p.body, 32, false, 0.0),
            Entity.Cloud(c) => reached_body(c.body, 64, false, 0.0),
            Entity.Crystal(c) => reached_body(c.body, 128, false, 0.0),
            Entity.Eye(eye) => reached_body(eye.body, 256, false, 0.0),
            Entity.Fireball(b) => reached_body(b.body, 512, false, 0.0),
            // Pushed from its feet, not its eyes, `entityOrigin`.
            Entity.Tnt(p) => reached_feet(p.body, 1024),
            Entity.Falling(p) => reached_body(p.body, FALLING, false, 0.0),
            Entity.Boat(p) => reached_body(p.body, BOATS, false, 0.0),
            Entity.Cart(p) => reached_body(p.body, CARTS, false, 0.0),
            Entity.Knot(k) => reached_body(k.body, 2048, false, 0.0),
            Entity.Hanging(k) => reached_body(k.body, HANGING, false, 0.0),
            Entity.Fangs(k) => reached_body(k.body, 8192, false, 0.0),
            Entity.Bolt(k) => reached_body(k.body, 32768, false, 0.0),
        })
    }

    /// `pushFromExplosion` of the entity `id`, `Entity.push`: its motion more by x, y, z where
    /// each is finite, and its tracker to send it (CAL-182).
    pub fn push_entity(mut self, id: i32, x: f64, y: f64, z: f64) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(pushed_by(e, x, y, z))
    }

    /// `Projectile.hurtServer` of the entity `id`, where it's an arrow or a thrown item, as an
    /// explosion hurts it (CAL-182): its motion to be sent, `markHurt`, unless it's gone or
    /// invulnerable, as one in the ground, which isn't pushed, has it sent too.
    pub fn projectile_hurt(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(match e {
            Entity.Arrow(a) => {
                var it = a
                mark_hurt(mut it.body)
                Entity.Arrow(it)
            },
            Entity.Thrown(p) => {
                var it = p
                mark_hurt(mut it.body)
                Entity.Thrown(it)
            },
            other => other,
        })
    }

    /// What an explosion asks of the ender dragons' parts whose boxes meet `b`, as `getEntities`
    /// finds them after the rest, but those of the dragon `except` (D667): each part's ID, its
    /// box, its place, `setPos`'s, and its eyes, `EntityDimensions.scalable`'s, 0.85 of its
    /// height, as nothing that resists a push and doesn't fall, of the kind 1024. Vanilla's are
    /// in its map's order, by their IDs' hashes, which Calcite's, by dragon and part, needn't
    /// be: a dragon hurt through each in turn takes no more than the most of them.
    pub fn parts_reached(self, b: Aabb, except: i32) -> List<Reached> {
        var out = List<Reached>()
        var seen = List<i32>()
        for (owner, _) in self.dragon_parts {
            if owner == except or seen.contains(owner) or not self.at.contains(owner) {
                continue
            }
            seen.push(owner)
            let slot = self.all[self.at[owner]] else continue
            let Entity.Mob(m) = slot else continue
            let dr = m.dragon else continue
            for i in 0..PARTS {
                let bounds = dr.boxed(i)
                if not bounds.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                    continue
                }
                let (x, y, z) = dr.parts[i]
                let (_, h) = part_size(i)
                let id = owner + 1 + i32.wrap(i)
                out.push(Reached { id: id, bounds: bounds, x: x, y: y, z: z, eyes: f64(h * 0.85f32), mover: Mover { y: y, fall: 0.0 }, kind: 1024, invisible: false, resistance: 0.0 })
            }
        }
        return out
    }

    /// The ender dragon whose part the ID `id` is, and which part, as `PARTS` orders them, where
    /// it's here (D667).
    pub fn part_of(self, id: i32) -> (i32, usize)? {
        for k in 1..9 {
            let owner = id - k
            if not self.at.contains(owner) or not self.is_mob(owner) {
                continue
            }
            let slot = self.all[self.at[owner]] else continue
            let Entity.Mob(m) = slot else continue
            if m.dragon == none {
                continue
            }
            let at = part_index(owner, id) else continue
            return some((owner, at))
        }
        return none
    }

    /// The armor stands and mobs whose boxes meet `b`, but `except`, as `getEntitiesOfClass` finds
    /// living entities but players, which a sweep hits (D417).
    pub fn find_living(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 12)
    }

    /// Whether anything here has a box meeting `b`, an ender dragon's parts among them, as
    /// `getEntities(null, b)` finds any but spectators, which only players are (CAL-167).
    pub fn any_in(self, b: Aabb) -> bool {
        return not self.found(b, -1, 2047 | FALLING | BOATS | CARTS).is_empty() or not self.parts_targets(b).is_empty()
    }

    /// `getEntityCount` of the pressure plate at `at` as the entity `id` went into it, its box then
    /// `boxed`, none where it ignores block triggers, and living where `alive` (D701): how many here
    /// have boxes meeting the plate's `TOUCH_AABB`, `id` by `boxed` as its tick may have it lent, but
    /// those ignoring block triggers, marker armor stands, every one, an ender dragon's parts
    /// among them, `Entity.class`, and the living ones, `LivingEntity.class`. Players are their
    /// level's to count.
    /// Whether a minecart but `id`, or `boxed`, the box of `id` where that's a minecart, is in the
    /// detector rail at `at`'s search box, `getSearchBB`, as `checkPressed` looks (CAL-315).
    pub fn carts_in(self, at: (i32, i32, i32), id: i32, boxed: Aabb?) -> bool {
        let b = detector_box(at)
        if let o = boxed {
            if o.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                return true
            }
        }
        for other in self.found(b, id, CARTS) {
            if let Entity.Cart(_) = self.all[self.at[other]] {
                return true
            }
        }
        return false
    }

    /// Whether a minecart's box meets `b`, as `MinecartItem.useOn` looks before it places one where
    /// carts move as `NewMinecartBehavior` has it (CAL-315).
    pub fn cart_in_box(self, b: Aabb) -> bool {
        for other in self.found(b, -1, CARTS) {
            if let Entity.Cart(_) = self.all[self.at[other]] {
                return true
            }
        }
        return false
    }

    /// `DetectorRailBlock.getAnalogOutputSignal`'s read of the minecarts in the search box of the
    /// detector rail at `at` (CAL-386): the first command block minecart's successes, else the
    /// first chest or hopper minecart's fill, else 0.
    pub fn cart_output(self, f: Facts, at: (i32, i32, i32)) -> i32 {
        let b = detector_box(at)
        var fill: i32? = none
        for other in self.found(b, -1, CARTS) {
            if let Entity.Cart(c) = self.all[self.at[other]] {
                if let (command, n) = c.detector_output(f) {
                    if command {
                        return n
                    }
                    if fill == none {
                        fill = some(n)
                    }
                }
            }
        }
        return fill ?? 0
    }

    /// The boxes of the minecarts here that a comparator reads on a detector rail, each with
    /// whether it's a command block minecart and what it reads, `detector_output`, as
    /// `TickPlace.cart_outputs` (CAL-386).
    pub fn cart_outputs(self, f: Facts) -> List<(Aabb, bool, i32)> {
        var out = List<(Aabb, bool, i32)>()
        for slot in self.all {
            let e = slot else continue
            if let Entity.Cart(c) = e {
                if not c.body.removed {
                    if let (command, n) = c.detector_output(f) {
                        out.push((c.body.bounding_box(), command, n))
                    }
                }
            }
        }
        return out
    }

    /// The piglins here, not piglin brutes, whose boxes meet `b`, in the level's order, as
    /// `getEntitiesOfClass(Piglin.class, b)` finds them (CAL-386).
    pub fn piglins_in(self, b: Aabb) -> List<i32> {
        var out = List<i32>()
        for id in self.found(b, -1, 8) {
            if let Entity.Mob(m) = self.all[self.at[id]] {
                if m.species == PIGLIN and not m.living.body.removed and m.living.body.bounding_box().intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                    out.push(id)
                }
            }
        }
        return out
    }

    /// The boxes of the cats here in their sitting pose, as `TickPlace.sitting_cats` (CAL-429).
    pub fn sitting_cats(self) -> List<Aabb> {
        var out = List<Aabb>()
        for slot in self.all {
            let e = slot else continue
            if let Entity.Mob(m) = e {
                if m.species == CAT and not m.living.body.removed and m.in_sitting_pose() {
                    out.push(m.living.body.bounding_box())
                }
            }
        }
        return out
    }

    /// The boxes of the minecarts here, for a detector rail's tick or placing to look for, as
    /// `TickPlace.carts` (CAL-315).
    pub fn cart_boxes(self) -> List<Aabb> {
        var out = List<Aabb>()
        for slot in self.all {
            let e = slot else continue
            if let Entity.Cart(c) = e {
                if not c.body.removed {
                    out.push(c.body.bounding_box())
                }
            }
        }
        return out
    }

    pub fn plate_counts(self, at: (i32, i32, i32), id: i32, boxed: Aabb?, alive: bool) -> (i32, i32) {
        let (x, y, z) = at
        let b = Aabb { min_x: f64(x) + 0.0625, min_y: f64(y), min_z: f64(z) + 0.0625, max_x: f64(x) + 0.9375, max_y: f64(y) + 0.25, max_z: f64(z) + 0.9375 }
        var all = 0
        var living = 0
        if let o = boxed {
            if o.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                all += 1
                if alive {
                    living += 1
                }
            }
        }
        for other in self.found(b, id, 2047 | FALLING | BOATS | CARTS) {
            let e = self.all[self.at[other]] else continue
            match e {
                Entity.Stand(a) => {
                    if not a.marker() {
                        all += 1
                        living += 1
                    }
                },
                Entity.Mob(m) => {
                    // Not a bat, which ignores block triggers (CAL-201).
                    if m.species != BAT {
                        all += 1
                        living += 1
                    }
                },
                _ => all += 1,
            }
        }
        all += i32.wrap(self.parts_reached(b, id).len())
        return (all, living)
    }

    /// The boxes of the entities here but those ignoring block triggers, marker armor stands, each
    /// with whether it's living, an ender dragon's parts among them, for a pressure plate's tick to
    /// count, `TickPlace.touchers` (D701).
    pub fn touchers(self) -> List<(Aabb, bool)> {
        var out = List<(Aabb, bool)>()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Stand(a) => {
                    if not a.marker() and not a.living.body.removed {
                        out.push((a.living.body.bounding_box(), true))
                    }
                },
                Entity.Mob(m) => {
                    // Not a bat's, which ignores block triggers (CAL-201).
                    if not m.living.body.removed and m.species != BAT {
                        out.push((m.living.body.bounding_box(), true))
                        if let dr = m.dragon {
                            for i in 0..PARTS {
                                out.push((dr.boxed(i), false))
                            }
                        }
                    }
                },
                _ => out.push((box_of(e), false)),
            }
        }
        return out
    }

    // Those of the kinds `kinds` whose boxes meet `b`, 1 items, 2 orbs, 4 armor stands, 8 mobs, 16
    // arrows, 32 thrown potions, 64 clouds, 128 end crystals, 256 eyes of ender, 512 dragon
    // fireballs, 1024 primed TNT and 2048 leash knots; and with `PLAYERS`, the players in the
    // sections looked at, in their places among the rest, whose boxes the caller tests, as it
    // has them (CAL-190); and with `LENT`, a mob lent out of the level as it ticks, in its place
    // among the rest, whose box the caller tests (CAL-201).
    fn found(self, b: Aabb, except: i32, kinds: i32) -> List<i32> {
        var out = List<i32>()
        let x0 = section(b.min_x - 2.0)
        let y0 = section(b.min_y - 4.0)
        let z0 = section(b.min_z - 2.0)
        let x1 = section(b.max_x + 2.0)
        let y1 = section(b.max_y + 0.0)
        let z1 = section(b.max_z + 2.0)
        for sx in x0..=x1 {
            var keys = List<i64>()
            for sz in z0..=z1 {
                for sy in y0..=y1 {
                    let key = pack(sx, sy, sz)
                    if self.sections.contains(key) and not self.sections[key].is_empty() {
                        keys.push(key)
                    }
                }
            }
            keys.sort()
            for key in keys {
                for id in self.sections[key] {
                    if id == except {
                        continue
                    }
                    if self.players_in.contains(id) {
                        if kinds & PLAYERS != 0 {
                            out.push(id)
                        }
                        continue
                    }
                    if not self.at.contains(id) {
                        continue
                    }
                    let e = self.all[self.at[id]] else {
                        if kinds & LENT != 0 {
                            out.push(id)
                        }
                        continue
                    }
                    let kind = match e {
                        Entity.Item(_) => 1,
                        Entity.Orb(_) => 2,
                        Entity.Stand(_) => 4,
                        Entity.Mob(_) => 8,
                        Entity.Arrow(_) => 16,
                        Entity.Thrown(_) => 32,
                        Entity.Cloud(_) => 64,
                        Entity.Crystal(_) => 128,
                        Entity.Eye(_) => 256,
                        Entity.Fireball(_) => 512,
                        Entity.Tnt(_) => 1024,
                        Entity.Falling(_) => FALLING,
                        Entity.Boat(_) => BOATS,
                        Entity.Cart(_) => CARTS,
                        Entity.Knot(_) => 2048,
                        Entity.Hanging(_) => HANGING,
                        Entity.Fangs(_) => 8192,
                        Entity.Bolt(_) => 32768,
                    }
                    if kind & kinds == 0 {
                        continue
                    }
                    let other = box_of(e)
                    if other.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        out.push(id)
                    }
                }
            }
        }
        return out
    }

    /// `ExperienceOrb.tryMergeToExisting`: the first orb in the box a block across around x, y,
    /// z that `can_merge` with `pick`, the level random's `nextInt(40)`, and `value` counts one
    /// more and starts its age again; whether there was one.
    pub fn merge_award(mut self, x: f64, y: f64, z: f64, value: i32, pick: i32) -> bool {
        let b = Aabb { min_x: x - 0.5, min_y: y - 0.5, min_z: z - 0.5, max_x: x + 0.5, max_y: y + 0.5, max_z: z + 0.5 }
        for id in self.find_orbs(b, -1) {
            let o = self.orb_view(id) else continue
            if not can_merge(o, pick, value) {
                continue
            }
            var taken = self.lend_orb(id) else continue
            taken.count += 1
            taken.age = 0
            self.give_back_orb(taken)
            return true
        }
        return false
    }

    // The orb `id`, where it's here and an orb, to read.
    fn orb_view(self, id: i32) -> ExperienceOrb? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Orb(o) = slot else return none
        return some(o.copy())
    }

    /// A tick of every entity there is that ticks, as `ServerLevel.tick` runs its tick list, among
    /// `blocks`, in a level whose floor is `min_y`, where lava's fast if `fast_lava`, with no
    /// players for orbs to follow; the sounds they play go to `sounds`.
    pub fn tick<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.begin_tick()
        let nobody = List<Follower>()
        while self.tick_next(u64.MAX, f, m, t, lf, codecs, blocks, min_y, fast_lava, nobody, mut sounds) {}
        self.end_tick()
    }

    /// Whether a player rides the entity `id`, or rides what rides it, `countPlayerPassengers`
    /// (CAL-360).
    pub fn carries_a_player(self, id: i32) -> bool {
        for (_, vehicle, _) in self.riding_players {
            var at: i32? = some(vehicle)
            var steps = 0
            while let v = at {
                if v == id {
                    return true
                }
                steps += 1
                if steps > 64 {
                    break
                }
                at = self.vehicle_of(v)
            }
        }
        return false
    }

    /// Starts a tick of the entities there are now.
    pub fn begin_tick(mut self) {
        self.cursor = 0
        self.end = self.tick_list.len()
        self.any_boats = false
        // Shulkers are collided with too, `Shulker.canBeCollidedWith` (CAL-377).
        for one in self.all {
            let e = one else continue
            if hard_box(e) {
                self.any_boats = true
                break
            }
        }
    }

    // The boxes of the boats and shulkers about the mob `a` it collides with as it moves,
    // `getEntityCollisions` by `canCollideWith` (CAL-315, CAL-377): a boat or a living shulker may
    // be collided with by anything, `canBeCollidedWith`, but not by what rides with it,
    // `isPassengerOfSameVehicle`. About it is 2 blocks and its speed each way, past what a tick
    // moves it.
    // The boxes of the boats about the body `b`, as far as it may move this tick and 2 more, which it
    // collides with, `getEntityCollisions` (CAL-315).
    fn boat_boxes_near(self, b: Body) -> List<Aabb> {
        var out = List<Aabb>()
        if not self.any_boats {
            return out
        }
        let reach = b.vx.abs() + b.vy.abs() + b.vz.abs() + 2.0
        let area = b.bounding_box().inflate(reach, reach, reach)
        for id in self.found(area, b.id, BOATS | 8) {
            let e = self.all[self.at[id]] else continue
            if hard_box(e) {
                out.push(box_of(e))
            }
        }
        return out
    }

    fn mob_boat_boxes(self, a: Mob) -> List<Aabb> {
        var out = List<Aabb>()
        if not self.any_boats {
            return out
        }
        let me = a.living.body.id
        let reach = a.living.body.vx.abs() + a.living.body.vy.abs() + a.living.body.vz.abs() + 2.0
        let area = a.living.body.bounding_box().inflate(reach, reach, reach)
        let root = self.root_vehicle(me)
        for id in self.found(area, me, BOATS | 8) {
            if self.root_vehicle(id) == root {
                continue
            }
            let e = self.all[self.at[id]] else continue
            if hard_box(e) {
                out.push(box_of(e))
            }
        }
        return out
    }

    /// Ticks the tick's next entity if it came into the level before `before`, as `tick` does,
    /// orbs following `players`, the level's in its order, and says whether there was one; the
    /// sounds it plays go to `sounds`, which starts empty.
    pub fn tick_next<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, before: u64, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        self.take_sent(lf, f, m, blocks, min_y)
        if not self.unseated.is_empty() {
            self.seat_off(f, m, blocks)
        }
        if let stopped = self.paused.take() {
            let (at, entered, bred) = stopped
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_rest(at, mob, entered, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                Entity.Item(e) => self.all[at] = some(Entity.Item(e)),
                Entity.Orb(o) => self.all[at] = some(Entity.Orb(o)),
                Entity.Stand(a) => self.all[at] = some(Entity.Stand(a)),
                Entity.Arrow(a) => self.all[at] = some(Entity.Arrow(a)),
                Entity.Thrown(p) => self.all[at] = some(Entity.Thrown(p)),
                Entity.Cloud(c) => self.all[at] = some(Entity.Cloud(c)),
                Entity.Crystal(c) => self.all[at] = some(Entity.Crystal(c)),
                Entity.Eye(e) => self.all[at] = some(Entity.Eye(e)),
                Entity.Fireball(b) => self.all[at] = some(Entity.Fireball(b)),
                Entity.Tnt(p) => self.all[at] = some(Entity.Tnt(p)),
                Entity.Falling(p) => self.all[at] = some(Entity.Falling(p)),
                Entity.Boat(p) => self.all[at] = some(Entity.Boat(p)),
                Entity.Cart(p) => self.all[at] = some(Entity.Cart(p)),
                Entity.Knot(p) => self.all[at] = some(Entity.Knot(p)),
                Entity.Hanging(p) => self.all[at] = some(Entity.Hanging(p)),
                Entity.Fangs(p) => self.all[at] = some(Entity.Fangs(p)),
                Entity.Bolt(p) => self.all[at] = some(Entity.Bolt(p)),
            }
            return true
        }
        if let stopped_start = self.paused_start.take() {
            let (at, bred) = stopped_start
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_used(at, mob, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                other => self.all[at] = some(other),
            }
            return true
        }
        if let stopped_use = self.paused_use.take() {
            let (at, bred) = stopped_use
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_on(at, mob, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                other => self.all[at] = some(other),
            }
            return true
        }
        if let stopped_at = self.paused_arrow.take() {
            self.heard = 0
            let held = self.all[stopped_at].take() else return true
            match held {
                Entity.Arrow(a) => self.arrow_on(stopped_at, a, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds),
                other => self.all[stopped_at] = some(other),
            }
            return true
        }
        // The tick that went on done, what rides it ticks next, `tickPassenger` (D708).
        if let done = self.ticking.take() {
            let (done_id, rode) = done
            self.ride_done(done_id, rode)
            // What it threw off is off where it put them before anything else ticks (D710).
            if not self.unseated.is_empty() {
                self.seat_off(f, m, blocks)
            }
        }
        if let next = self.riders.pop() {
            let (vehicle, rider) = next
            self.ride_tick(vehicle, rider, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return true
        }
        while self.cursor < self.end {
            match self.tick_list[self.cursor] {
                some(_) => break,
                none => self.cursor += 1,
            }
        }
        if self.cursor >= self.end {
            return false
        }
        let next_id = self.tick_list[self.cursor] else return false
        let i = self.at[next_id]
        let held = self.all[i].take() else return false
        let taken = opened(held, self.portal_open, self.end_portal_open)
        let (x, _, z) = place_of(taken)
        if entered_of(taken) >= before {
            self.all[i] = some(taken)
            return false
        }
        self.cursor += 1
        self.heard = 0
        // What's in the tick list looks at whether it goes, `checkDespawn`, and of that, what's in
        // range ticks, as `ServerLevel.tick` runs its tick list (D452).
        let (cx, cz) = (i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
        let listed = blocks.listed(cx, cz)
        let ticks = listed and blocks.ticks_entities(cx, cz)
        // What rides something that has it ticks after that, `tickPassenger`, here only looking at
        // whether it goes, which it never does from afar while it rides; what rides something gone
        // gets off it and ticks as it is (D708).
        let (own_id, rides, _) = riding_of(taken)
        // A frozen game's entities wait, but what carries a player, `isEntityFrozen` (CAL-360).
        if self.frozen and not self.carries_a_player(own_id) {
            self.all[i] = some(taken)
            return true
        }
        if let vehicle = rides {
            if ticks and self.carries(vehicle, own_id) {
                match taken {
                    Entity.Mob(mob) => {
                        var a = mob
                        let nearest = nearest_to(a, players)
                        if a.check_despawn(self.peaceful, nearest) {
                            a.living.body.removed = true
                            self.all[i] = some(Entity.Mob(a))
                            self.remove(own_id)
                        } else {
                            self.all[i] = some(Entity.Mob(a))
                        }
                    },
                    other => self.all[i] = some(other),
                }
                return true
            }
            if ticks {
                self.all[i] = some(taken)
                self.stop_riding(own_id)
                let again = self.all[i].take() else return true
                return self.tick_at(i, again, true, true, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
            }
        }
        return self.tick_at(i, taken, listed, ticks, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
    }

    // A passenger's tick, `tickPassenger` (D708): what's gone or rides something else now gets off;
    // else, still, `rideTick`, it ticks as it does, then its vehicle positions it, as its tick's
    // done, `ride_done`.
    fn ride_tick<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, vehicle: i32, rider: i32, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        if not self.at.contains(rider) {
            // A player riding it, whose ride the network ticks now (CAL-179).
            if self.riding_player(rider) != none and self.carries_player(vehicle, rider) {
                self.player_ride = some((vehicle, rider))
                return
            }
            self.drop_rider(vehicle, rider)
            return
        }
        let i = self.at[rider]
        let (_, rides, _, removed, _) = self.riding_at(i) else return
        if removed or rides != some(vehicle) {
            self.stop_riding(rider)
            return
        }
        // What's alive gets off what goes under water as its eyes are in water, but for a bubble
        // column there, `dismountsUnderwater`, put where it gets off, and ticks as it is (D710).
        if self.off_underwater(vehicle, i, f, t, blocks) {
            self.stop_riding(rider)
            self.seat_off(f, m, blocks)
            let off = self.all[i].take() else return
            _ = self.tick_at(i, stilled(off), true, true, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        let lent = self.steering_for(vehicle, rider, lf)
        let mount = match self.body_at(vehicle) {
            some(vb) => some(vb.bounding_box()),
            none => none,
        }
        let held = self.all[i].take() else return
        self.heard = 0
        self.ticking = some((rider, some(vehicle)))
        // A mob that steers what it rides has that one's navigation and move control for its
        // tick (D710).
        let given = match stilled(held) {
            Entity.Mob(mb) => {
                var r = mb
                r.steering = lent
                r.mount_box = mount
                Entity.Mob(r)
            },
            other => other,
        }
        let ready = opened(given, self.portal_open, self.end_portal_open)
        _ = self.tick_at(i, ready, true, true, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
    }

    // Whether the living entity at `i` gets off the mob `vehicle` it rides as its tick begins
    // (D710), `LivingEntity.baseTick`: `vehicle` of `#dismounts_underwater`, of which Calcite makes
    // the pig, chicken, horse, donkey, mule, spider, zombie horse and camel (CAL-207), and the rider alive with its eyes
    // in water where it sits, `isEyeInFluid`, and no bubble column at them.
    fn off_underwater<B: CollisionBlocks>(self, vehicle: i32, i: usize, f: Facts, t: BodyFacts, blocks: B) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let ve = self.all[self.at[vehicle]] else return false
        let Entity.Mob(v) = ve else return false
        let kind = v.species
        if not (kind == PIG or kind == CHICKEN or kind == HORSE or kind == DONKEY or kind == MULE or kind == SPIDER or kind == ZOMBIE_HORSE or llama_kind(kind) or kind == CAMEL) {
            return false
        }
        let re = self.all[i] else return false
        let alive = match re {
            Entity.Mob(rm) => rm.living.alive(),
            Entity.Stand(ra) => ra.living.alive(),
            _ => false,
        }
        if not alive {
            return false
        }
        let b = body_of(re)
        let eye = b.y + f64(b.eyes)
        let r = fluids_seen(f, t.flow, blocks, b.bounding_box(), true, some((floor(b.x), eye, floor(b.z))))
        if not r.water_eyes {
            return false
        }
        let at = blocks.collision_state(floor(b.x), floor(eye), floor(b.z)) ?? 0
        return f.block(at) != t.bubble_column
    }

    // The mob `vehicle` turned toward the player the mob `rider` that steers it turned it to this
    // tick, `Mob.lookAt` at most 30 degrees each way (D710).
    fn turn_steered(mut self, rider: i32, vehicle: i32) {
        if not self.at.contains(rider) or not self.at.contains(vehicle) {
            return
        }
        let ri = self.at[rider]
        let held = self.all[ri].take() else return
        var to: Follower? = none
        self.all[ri] = some(match held {
            Entity.Mob(mb) => {
                var a = mb
                to = a.turns_vehicle.take()
                Entity.Mob(a)
            },
            other => other,
        })
        let p = to else return
        let vi = self.at[vehicle]
        let mount = self.all[vi].take() else return
        self.all[vi] = some(match mount {
            Entity.Mob(vm) => {
                var v = vm
                v.look_at_now(p, 30.0f32, 30.0f32)
                Entity.Mob(v)
            },
            other => other,
        })
    }

    // What rides the mob `id` off it, last first, `ejectPassengers`, where it threw them off this
    // tick, a horse running around, each put off where it was as it did (D710).
    fn throw_riders(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let held = self.all[i].take() else return
        var from: Body? = none
        self.all[i] = some(match held {
            Entity.Mob(mb) => {
                var a = mb
                from = a.thrown_from.take()
                Entity.Mob(a)
            },
            other => other,
        })
        let b = from else return
        let box = b.bounding_box()
        var k = b.passengers.len()
        while k > 0 {
            k -= 1
            let before = self.unseated.len()
            let players_before = self.players_off.len()
            self.leave(b.passengers[k], false)
            var u = before
            while u < self.unseated.len() {
                self.unseated[u].x = b.x
                self.unseated[u].y = b.y
                self.unseated[u].z = b.z
                self.unseated[u].top = box.max_y
                self.unseated[u].bottom = box.min_y
                self.unseated[u].width = b.width
                self.unseated[u].yaw = b.y_rot
                u += 1
            }
            // And a player it threw (CAL-179).
            var p = players_before
            while p < self.players_off.len() {
                self.players_off[p].x = b.x
                self.players_off[p].y = b.y
                self.players_off[p].z = b.z
                self.players_off[p].top = box.max_y
                self.players_off[p].bottom = box.min_y
                self.players_off[p].width = b.width
                self.players_off[p].yaw = b.y_rot
                p += 1
            }
        }
    }

    // What the mob `rider` steers of the mob `vehicle` it rides, where it does (D710): `vehicle`
    // with AI and `rider` first of what rides it and a mob that may steer, `getControllingPassenger`.
    fn steering_for(self, vehicle: i32, rider: i32, lf: LivingFacts) -> Steering? {
        if not self.at.contains(vehicle) or not self.may_steer(rider) {
            return none
        }
        let slot = self.all[self.at[vehicle]] else return none
        let Entity.Mob(v) = slot else return none
        if v.no_ai() or v.living.body.passengers.is_empty() or v.living.body.passengers[0] != rider {
            return none
        }
        return some(v.steering_of(lf))
    }

    // Whether the entity `id` is a mob that may steer what it rides (D710), `canControlVehicle`:
    // not of `#non_controlling_rider`, of which Calcite makes only the slime.
    fn may_steer(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Mob(m) = slot else return false
        return not cube_kind(m.species)
    }

    // The mob `vehicle`'s navigation and move control as the mob that steered it left them
    // (D710), where it's here.
    fn steered_back(mut self, vehicle: i32, s: Steering) {
        if not self.at.contains(vehicle) {
            return
        }
        let i = self.at[vehicle]
        let held = self.all[i].take() else return
        self.all[i] = some(match held {
            Entity.Mob(m) => {
                var t = m
                t.steered_by(s)
                Entity.Mob(t)
            },
            other => other,
        })
    }

    // The body's turn of the entity `id`, where it's a mob, and whether it finds its way as a
    // `PathfinderMob` does, all Calcite's mobs but slimes and the ender dragon (D710).
    fn body_turn_of(self, id: i32?) -> (f32, bool) {
        let v = id else return (0.0f32, false)
        if not self.at.contains(v) {
            return (0.0f32, false)
        }
        let slot = self.all[self.at[v]] else return (0.0f32, false)
        let Entity.Mob(m) = slot else return (0.0f32, false)
        return (m.living.y_body_rot, not cube_kind(m.species) and m.species != ENDER_DRAGON)
    }

    // `rider` dropped from what rides `vehicle`, where it's gone from the level (D708).
    fn drop_rider(mut self, vehicle: i32, rider: i32) {
        var vb = self.body_at(vehicle) else return
        var kept = List<i32>()
        for p in vb.passengers {
            if p != rider {
                kept.push(p)
            }
        }
        vb.passengers = kept
        self.put_body(vehicle, vb)
        self.share_riders(vehicle)
    }

    // The entity `id`'s tick done (D708): where it rode `rode`, its vehicle positions it,
    // `positionRider`, and what's alive forgets its fall, `LivingEntity.rideTick`; then what rides
    // it ticks next, in order, `tickPassenger`.
    fn ride_done(mut self, id: i32, rode: i32?) {
        self.throw_riders(id)
        if rode != none {
            // What it steered turned toward its target first, as its tick did (D710).
            if let v = rode {
                self.turn_steered(id, v)
            }
            if let v = self.vehicle_of(id) {
                self.position_rider(v, id, false)
            }
            // What it steered, which takes back its navigation and move control, and whose body's
            // turn a skeleton kind or a drowned takes where that one finds its way, their
            // `rideTick`'s `PathfinderMob` (D710); a piglin, as others, keeps its own (CAL-200).
            var steered: Steering? = none
            let (turn, pathfinder) = self.body_turn_of(rode)
            if self.at.contains(id) {
                let i = self.at[id]
                if let held = self.all[i].take() {
                    self.all[i] = some(match held {
                        Entity.Mob(mb) => {
                            var a = mb
                            a.living.body.fall = 0.0
                            a.mount_box = none
                            steered = a.take_steering()
                            let steers = match steered {
                                some(_) => true,
                                none => false,
                            }
                            if steers and pathfinder and (a.skeletal() or a.species == DROWNED) {
                                a.living.y_body_rot = turn
                            }
                            Entity.Mob(a)
                        },
                        Entity.Stand(st) => {
                            var a = st
                            a.living.body.fall = 0.0
                            Entity.Stand(a)
                        },
                        other => other,
                    })
                }
            }
            if let s = steered {
                if let v = rode {
                    self.steered_back(v, s)
                }
            }
        }
        let riders = self.passengers_of(id)
        var k = riders.len()
        while k > 0 {
            k -= 1
            self.riders.push((id, riders[k]))
        }
    }

    // The tick of the entity `taken` at `i`, as the tick list has it: what's in a chunk that ticks
    // entities ticks, and a mob in one listed looks at whether it goes, `checkDespawn` (D452);
    // the entity marked as ticking, for what rides it to tick after it (D708).
    fn tick_at<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, i: usize, taken: own Entity, listed: bool, ticks: bool, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        if ticks and self.ticking == none {
            let (own_id, _, _) = riding_of(taken)
            self.ticking = some((own_id, none))
        }
        match taken {
            Entity.Item(e) => {
                if ticks {
                    self.tick_item(i, e, f, m, t, lf.damage, codecs, blocks, min_y, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Item(e))
                }
            },
            Entity.Orb(o) => {
                if ticks {
                    self.tick_orb(i, o, f, m, t, lf.damage, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Orb(o))
                }
            },
            Entity.Stand(a) => {
                if ticks {
                    self.tick_stand(i, a, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Stand(a))
                }
            },
            Entity.Mob(mob) => {
                if listed {
                    self.tick_mob(i, mob, ticks, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Mob(mob))
                }
            },
            Entity.Arrow(a) => {
                if ticks {
                    self.tick_arrow(i, a, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Arrow(a))
                }
            },
            Entity.Thrown(p) => {
                if ticks {
                    self.tick_thrown(i, p, f, m, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Thrown(p))
                }
            },
            Entity.Cloud(c) => {
                if ticks {
                    self.tick_cloud(i, c, lf, f, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Cloud(c))
                }
            },
            Entity.Crystal(c) => {
                if ticks {
                    self.tick_crystal(i, c, lf, f, t, blocks, mut sounds)
                } else {
                    self.all[i] = some(Entity.Crystal(c))
                }
            },
            Entity.Eye(e) => {
                if ticks {
                    self.tick_eye(i, e, f, t, blocks, min_y, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Eye(e))
                }
            },
            Entity.Fireball(b) => {
                if ticks {
                    self.tick_fireball(i, b, f, m, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Fireball(b))
                }
            },
            Entity.Tnt(p) => {
                if ticks {
                    self.tick_tnt(i, p, f, m, t, blocks, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Tnt(p))
                }
            },
            Entity.Falling(p) => {
                if ticks {
                    self.tick_falling(i, p, f, m, t, blocks, min_y, mut sounds)
                } else {
                    self.all[i] = some(Entity.Falling(p))
                }
            },
            Entity.Boat(b) => {
                if ticks {
                    self.tick_boat(i, b, f, m, t, lf, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Boat(b))
                }
            },
            Entity.Cart(b) => {
                if ticks {
                    self.tick_cart(i, b, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Cart(b))
                }
            },
            Entity.Knot(p) => {
                if ticks {
                    self.tick_knot(i, p, f, t, blocks, min_y, mut sounds)
                } else {
                    self.all[i] = some(Entity.Knot(p))
                }
            },
            Entity.Hanging(p) => {
                if ticks {
                    self.tick_hanging(i, p, min_y, sounds)
                } else {
                    self.all[i] = some(Entity.Hanging(p))
                }
            },
            Entity.Fangs(p) => {
                if ticks {
                    self.tick_fangs(i, p, min_y, sounds.len())
                } else {
                    self.all[i] = some(Entity.Fangs(p))
                }
            },
            Entity.Bolt(p) => {
                if ticks {
                    self.tick_bolt(i, p, min_y, sounds.len())
                } else {
                    self.all[i] = some(Entity.Bolt(p))
                }
            },
        }
        return true
    }

    // A lightning bolt's tick, at `i` (CAL-326), `LightningBolt.tick`, `heard` the sounds so far:
    // what it does to the level, `Shown.Bolt`, which its level does after the sounds so far; gone
    // once it has no flashes left.
    fn tick_bolt(mut self, i: usize, bolt: own LightningBolt, min_y: i32, heard: usize) {
        var p = bolt
        let out = p.tick(min_y)
        let id = p.body.id
        if out.strike or out.flash or out.hits or out.gone {
            self.shown.push(Shown.Bolt(BoltDue { id: id, x: p.body.x, y: p.body.y, z: p.body.z, strike: out.strike, flash: out.flash, hits: out.hits, gone: out.gone, struck: p.struck.copy(), fires: p.fires }))
            self.shown_by.push(id)
            self.shown_after.push(heard)
        }
        let removed = p.body.removed
        self.all[i] = some(Entity.Bolt(p))
        self.heard = heard
        if removed {
            self.remove(id)
        }
    }

    // Fangs' tick, at `i` (CAL-200), `EvokerFangs.tick`, `heard` the sounds so far: their bite
    // shown, entity event 4, and their bite, `Shown.Fanged`, which their level does, after the
    // sounds so far; gone once their life's out.
    fn tick_fangs(mut self, i: usize, fangs: own EvokerFangs, min_y: i32, heard: usize) {
        var p = fangs
        let out = p.tick(min_y)
        let id = p.body.id
        if out.bite {
            let b = p.body.bounding_box()
            let reach = Aabb { min_x: b.min_x - 0.2, min_y: b.min_y, min_z: b.min_z - 0.2, max_x: b.max_x + 0.2, max_y: b.max_y, max_z: b.max_z + 0.2 }
            self.shown.push(Shown.Fanged(Fanged { id: id, uuid: p.body.uuid, owner: p.owner, x: p.body.x, y: p.body.y, z: p.body.z, reach: reach }))
            self.shown_by.push(id)
            self.shown_after.push(heard)
        }
        if out.spike {
            self.shown.push(Shown.Event(4i8))
            self.shown_by.push(id)
            self.shown_after.push(heard)
        }
        let removed = p.body.removed
        self.all[i] = some(Entity.Fangs(p))
        self.heard = heard
        if removed {
            self.remove(id)
        }
    }

    // A leash knot's tick, at `i` (CAL-179): `BlockAttachedEntity.tick`, and where it's time to
    // look and its fence, one of `fences`, isn't at its place, `survives`, it's gone, `discard`,
    // its removal sent before its sound's heard, `dropItem`.
    fn tick_knot<B: CollisionBlocks>(mut self, i: usize, knot: own LeashKnot, f: Facts, t: BodyFacts, blocks: B, min_y: i32, sounds: mut List<EntitySound>) {
        var k = knot
        var heard: EntitySound? = none
        if k.tick(min_y) {
            let (x, y, z) = k.at
            let state = blocks.collision_state(x, y, z) ?? 0
            if not f.in_set(state, t.fences) {
                heard = k.untie()
            }
        }
        let id = k.body.id
        let removed = k.body.removed
        self.all[i] = some(Entity.Knot(k))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        }
        if let s = heard {
            sounds.push(s)
        }
    }

    // A hanging entity's tick, at `i` (CAL-354): `BlockAttachedEntity.tick`, gone below the
    // world, and where it's time to look at whether it survives, `Shown.Check`, for its level to
    // look at and break it then, as `tick` does.
    fn tick_hanging(mut self, i: usize, hanging: own Hanging, min_y: i32, sounds: List<EntitySound>) {
        var h = hanging
        let due = h.tick(min_y)
        let id = h.body.id
        let removed = h.body.removed
        let bb = h.body.bounding_box()
        self.all[i] = some(Entity.Hanging(h))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
            return
        }
        if due {
            self.keep_acted(id, bb, [Acted.Check], [sounds.len()])
        }
    }

    // Primed TNT's tick, at `i` (CAL-182): `PrimedTnt.tick`, what blocks did to it kept as what a
    // living entity shows is, and the fall it took onto farmland drawn for, as it's never big
    // enough to trample it; then, where its fuse ran out, its explosion, `Shown.Blew`, for its
    // level to make before its removal's sent, after its tick's sounds.
    fn tick_tnt<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, tnt: own PrimedTnt, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        var p = tnt
        let out = p.tick(f, m, t, blocks, fast_lava, mut sounds)
        if let landed = p.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        if out {
            let (x, y, z) = p.blast_at()
            self.shown.push(Shown.Blew(Blast { at: (p.body.x, p.body.y, p.body.z), x: x, y: y, z: z, power: p.power, portal: p.used_portal, owner: p.owner, silent: p.silent() }))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(p.body.x, p.body.y, p.body.z)
        let removed = p.body.removed
        self.all[i] = some(Entity.Tnt(p))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // A boat's tick, at `i` (CAL-315): its own, `world.boat`'s, steered where its first rider's a
    // player, `getControllingPassenger`, its drop where it breaks as the game rule `entity_drops`
    // has it; then what its blocks did, kept, and a bubble column's lift or sink shown, its entity
    // event; and 60 ticks under water, its riders let go, `ejectPassengers`. Last, what's about it
    // taken in or pushed, `boat_pushes`.
    fn tick_boat<B: CollisionBlocks + EntityTicking + Rain + Gateways>(mut self, i: usize, boat: own Boat, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var b = boat
        let steered = not b.body.passengers.is_empty() and self.riding_player(b.body.passengers[0]) != none
        let reach = b.body.vx.abs() + b.body.vy.abs() + b.body.vz.abs() + 0.5
        b.body.others = self.boat_others(lf, f, blocks, b.body, b.body.bounding_box().inflate(reach, reach, reach), players)
        // What holds its leash, and how it's known to move, for its leash's tick (CAL-315).
        b.known = boat_known(b, players)
        b.holding = if b.tether != none { self.holding_of(b.tether.copy(), players) } else { none }
        let eject = b.tick(f, m, t, lf.damage, blocks, min_y, fast_lava, self.entity_drops, steered, mut sounds)
        b.body.others.clear()
        let id = b.body.id
        let bb = b.body.bounding_box()
        let near = Aabb { min_x: bb.min_x - f64(0.2f32), min_y: bb.min_y + f64(0.01f32), min_z: bb.min_z - f64(0.2f32), max_x: bb.max_x + f64(0.2f32), max_y: bb.max_y - f64(0.01f32), max_z: bb.max_z + f64(0.2f32) }
        self.keep_acted(id, bb, b.acted, b.acted_after)
        b.acted.clear()
        b.acted_after.clear()
        if let ev = b.bubbled.take() {
            self.shown.push(Shown.Event(ev))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(b.body.x, b.body.y, b.body.z)
        let removed = b.body.removed
        let riders = not b.body.passengers.is_empty()
        self.all[i] = some(Entity.Boat(b))
        self.heard = sounds.len()
        if eject and riders {
            self.eject(id, false)
        }
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
            self.boat_pushes(id, near, steered, lf, f, blocks, players)
        }
    }

    // A minecart's tick, at `i` (CAL-315): its own, `world.minecart`'s, to where it takes in or
    // pushes what's about it, what its blocks and its breaking did kept; then its riders let go
    // where a powered activator rail said, `activateMinecart`; then, unless it's gone, the pushes,
    // `cart_pushes`; then the rest of its own, `tick_end`, gone or not.
    fn tick_cart<B: CollisionBlocks + EntityTicking + Rain + Gateways, S: StackSizes>(mut self, i: usize, cart: own Minecart, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var c = cart
        c.tnt_explodes = self.tnt_explodes
        c.experimental = self.carts_experimental
        c.max_cart_speed = self.max_cart_speed
        // What it collides with as it moves, as a boat does, `canVehicleCollide`.
        let reach = c.body.vx.abs() + c.body.vy.abs() + c.body.vz.abs() + 0.5
        c.body.others = self.boat_others(lf, f, blocks, c.body, c.body.bounding_box().inflate(reach, reach, reach), players)
        // Its first rider's move, where that's a player, `getFirstPassenger`.
        var intent: (f64, f64, f64)? = none
        if not c.body.passengers.is_empty() {
            let first = c.body.passengers[0]
            for (p, v) in self.move_intents {
                if p == first {
                    intent = some(v)
                }
            }
        }
        let ticked = c.tick(f, m, t, lf.damage, blocks, min_y, intent, self.entity_drops, mut sounds)
        c.body.others.clear()
        let id = c.body.id
        let bb = c.body.bounding_box()
        self.keep_acted_as(id, bb, true, c.acted, c.acted_after)
        self.keep_blasts(id, mut c, sounds.len())
        c.acted.clear()
        c.acted_after.clear()
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        let riders = not c.body.passengers.is_empty()
        let blew = self.keeps_blast(id)
        // Broken in its move, it goes on with the rest of its tick all the same, its fluids and
        // lava, which hurts what's removed as it would, heard again (CAL-386).
        if removed {
            c.tick_end(f, t, lf.damage, blocks, fast_lava, self.entity_drops, mut sounds)
        }
        self.all[i] = some(Entity.Cart(c))
        self.heard = sounds.len()
        if removed {
            if not blew {
                self.remove(id)
            }
            return
        }
        self.move_section(id, key)
        if ticked.eject and riders {
            self.eject(id, false)
        }
        if ticked.push and self.carts_experimental {
            self.cart_pushes_new(id, lf, f, blocks, players)
        } else if ticked.push {
            self.cart_pushes(id, lf, f, blocks, players)
        }
        var back = self.lend_cart(id) else return
        back.tick_end(f, t, lf.damage, blocks, fast_lava, self.entity_drops, mut sounds)
        let bb2 = back.body.bounding_box()
        self.keep_acted(id, bb2, back.acted, back.acted_after)
        back.acted.clear()
        back.acted_after.clear()
        self.keep_blasts(id, mut back, sounds.len())
        let gone = back.body.removed
        self.give_back_cart(back)
        self.heard = sounds.len()
        if gone and not self.keeps_blast(id) {
            self.remove(id)
            return
        }
        self.hopper_cart_takes(id, f, blocks, codecs)
    }

    // `MinecartHopper.tryConsumeItems` of the minecart `id` after its tick (CAL-388): where it's a
    // hopper minecart, alive and enabled, `suckInItems`. With a container block where it pulls
    // from, the block 1.5 above it, `getBlockContainer`, or an entity container in the block's box
    // about that place, `getEntityContainer`, its level's to have it pull from that; with a loot
    // table of its own, that's said to be missing. Else the item entities in
    // its suck box, 11 to 32 sixteenths above it, `getItemsAtAndAbove`, then those its box meets,
    // a quarter wider across, each taken in till one's all taken in, `addItem`.
    fn hopper_cart_takes<B: CollisionBlocks, S: StackSizes>(mut self, id: i32, f: Facts, blocks: B, codecs: S) {
        let c = self.lend_cart(id) else return
        let takes = c.is_hopper() and c.enabled and not c.body.removed
        let (x, y, z) = (c.body.x, c.body.y, c.body.z)
        let bb = c.body.bounding_box()
        let looted = c.loot_table != none
        self.give_back_cart(c)
        if not takes {
            return
        }
        let (ax, ay, az) = (i32.saturate(x.floor()), i32.saturate((y + 1.5).floor()), i32.saturate(z.floor()))
        var container = container_block(f, blocks.collision_state(ax, ay, az) ?? 0)
        if not container {
            let about = Aabb { min_x: x - 0.5, min_y: y + 1.0, min_z: z - 0.5, max_x: x + 0.5, max_y: y + 2.0, max_z: z + 0.5 }
            for o in self.found(about, -1, CARTS | BOATS) {
                if self.holds_items(o) {
                    container = true
                }
            }
        }
        if container {
            let heard = self.heard
            self.keep_acted(id, bb, [Acted.CartPull((ax, ay, az))], [heard])
            return
        }
        let suck = Aabb { min_x: x - 0.5, min_y: y + 0.6875, min_z: z - 0.5, max_x: x + 0.5, max_y: y + 2.0, max_z: z + 0.5 }
        // Its own loot made as an item entity's first put in, which waits on its level's loot
        // tables here (CAL-388).
        if looted {
            var near = false
            for item in self.find(suck, -1) {
                near = near or self.item_alive(item)
            }
            for item in self.find(bb.inflate(0.25, 0.0, 0.25), -1) {
                near = near or self.item_alive(item)
            }
            if near {
                let heard = self.heard
                self.keep_acted(id, bb, [Acted.Missing(String("A hopper minecart's loot table filled as it takes in an item entity"))], [heard])
            }
            return
        }
        for item in self.find(suck, -1) {
            if self.cart_takes_item(id, item, codecs) {
                return
            }
        }
        for item in self.find(bb.inflate(0.25, 0.0, 0.25), -1) {
            if self.cart_takes_item(id, item, codecs) {
                return
            }
        }
    }

    /// How many mobs of the kind `species` have boxes meeting `b`, `getEntities` of their class
    /// (CAL-408).
    pub fn mobs_of_kind_in(self, b: Aabb, species: i32) -> usize {
        var n: usize = 0
        for o in self.found(b, -1, 8) {
            if self.is_mob(o) and self.mob(o).species == species and not self.mob(o).living.body.removed {
                n += 1
            }
        }
        return n
    }

    // Whether the entity `id` is a chest boat, chest minecart or hopper minecart, a `Container`.
    fn holds_items(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        return match self.all[self.at[id]] {
            some(Entity.Cart(c)) => c.has_chest() and not c.body.removed,
            some(Entity.Boat(b)) => b.has_chest() and not b.body.removed,
            _ => false,
        }
    }

    // `HopperBlockEntity.addItem(container, item)` of the item entity `item` into the hopper
    // minecart `id` (CAL-388): as much of its stack as goes, slot by slot, `tryMoveInItem`, a
    // stack put whole into an empty slot, as much as it has room for onto one of the same item and
    // components. Where all went, it's emptied and gone, `discard`, and that's whether it was;
    // else what's left is its stack, set again, `setItem`.
    // Whether `item` is an item entity alive with something in its stack (CAL-388).
    fn item_alive(mut self, item: i32) -> bool {
        if not self.at.contains(item) {
            return false
        }
        let e = self.lend(item) else return false
        let alive = not e.body.removed and not e.is_empty()
        self.give_back(e)
        return alive
    }

    fn cart_takes_item<S: StackSizes>(mut self, id: i32, item: i32, codecs: S) -> bool {
        if not self.at.contains(item) {
            return false
        }
        let e = self.lend(item) else return false
        let alive = not e.body.removed and not e.is_empty()
        let stack = e.stack.copy()
        self.give_back(e)
        if not alive {
            return false
        }
        var c = self.lend_cart(id) else return false
        var count = count_of(some(stack.copy()))
        for k in 0..c.items.len() {
            if count <= 0 {
                break
            }
            match c.items[k].copy() {
                none => {
                    c.items[k] = with_count(stack, count.min(codecs.stack_most(stack)))
                    count = 0
                },
                some(here) => {
                    let have = count_of(some(here.copy()))
                    let most = codecs.stack_most(here)
                    if have < most and stack_item(some(here.copy())) == stack_item(some(stack.copy())) and same_components(some(here.copy()), some(stack.copy())) {
                        let moved = count.min(codecs.stack_most(stack) - have)
                        if moved > 0 {
                            c.items[k] = with_count(here, have + moved)
                            count -= moved
                        }
                    }
                },
            }
        }
        self.give_back_cart(c)
        if count <= 0 {
            self.remove(item)
            return true
        }
        // Set again though it may be the same, as `setItem` always sends it.
        var it = self.lend(item) else return false
        it.stack = with_count(stack, count) ?? stack.copy()
        it.stack_changed = true
        self.give_back(it)
        return false
    }

    // Whether a blast of `id`'s is kept for its level to set off, which takes it out once it's gone
    // off (CAL-315).
    fn keeps_blast(self, id: i32) -> bool {
        for k in 0..self.shown.len() {
            if self.shown_by[k] == id {
                if let Shown.Blew(_) = self.shown[k] {
                    return true
                }
            }
        }
        return false
    }

    // A TNT minecart `c`'s blasts, `id`'s, kept for its level to set off, after `heard` of its
    // tick's sounds (CAL-315).
    fn keep_blasts(mut self, id: i32, c: mut Minecart, heard: usize) {
        for b in c.blasts {
            self.shown.push(Shown.Blew(b))
            self.shown_by.push(id)
            self.shown_after.push(heard)
        }
        c.blasts.clear()
    }

    // `OldMinecartBehavior.pushAndPickupEntities` for the minecart `id` (CAL-315): about its box,
    // 0.2 wider each way. One that may be ridden going 0.1 a tick or more across takes in what's
    // there that may be pushed, `pushableBy`, but a player, an iron golem or another minecart,
    // where nothing rides it and it rides nothing, `startRiding`; and anything else there pushes
    // itself off it, `push`. Else any other minecart there that may be pushed pushes itself off it.
    fn cart_pushes<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        let me = self.body_at(id) else return
        let bb = me.bounding_box()
        let hit = Aabb { min_x: bb.min_x - f64(0.2f32), min_y: bb.min_y, min_z: bb.min_z - f64(0.2f32), max_x: bb.max_x + f64(0.2f32), max_y: bb.max_y, max_z: bb.max_z + f64(0.2f32) }
        let rideable = match self.all[self.at[id]] {
            some(Entity.Cart(c)) => c.rideable(),
            _ => false,
        }
        if rideable and me.vx * me.vx + me.vz * me.vz >= 0.01 {
            for other in self.found(hit, id, 8 | BOATS | CARTS | PLAYERS) {
                if self.players_in.contains(other) {
                    for p in players {
                        if p.id != other {
                            continue
                        }
                        let pb = p.pushable else continue
                        if pb.intersects(hit.min_x, hit.min_y, hit.min_z, hit.max_x, hit.max_y, hit.max_z) {
                            self.pushed_off_cart(other, id, p.x, p.z, lf, f, blocks)
                        }
                    }
                    continue
                }
                let pushable = if self.is_boat(other) or self.is_cart(other) { true } else { self.mob_pushable(other, lf, f, blocks) }
                if not pushable {
                    continue
                }
                let golem = self.is_mob(other) and self.mob(other).species == IRON_GOLEM
                let empty = match self.body_at(id) {
                    some(b) => b.passengers.is_empty(),
                    none => false,
                }
                if not golem and not self.is_cart(other) and empty and self.vehicle_of(other) == none {
                    _ = self.start_riding(other, id, false)
                } else {
                    let ob = self.body_at(other) else continue
                    self.pushed_off_cart(other, id, ob.x, ob.z, lf, f, blocks)
                }
            }
            return
        }
        for other in self.found(hit, id, CARTS) {
            if me.passengers.contains(other) {
                continue
            }
            let ob = self.body_at(other) else continue
            self.pushed_off_cart(other, id, ob.x, ob.z, lf, f, blocks)
        }
    }

    // `NewMinecartBehavior.pushAndPickupEntities` of the minecart `id` (CAL-315), after its tick
    // rather than after each of its moves: a rideable minecart with no rider takes in the first
    // that will ride it of what may be pushed within 0.2 across of its box but players, iron
    // golems, minecarts and what rides already, `pickupEntities`. Then where it hit something as
    // it moved, what's within a hair of its box is pushed off it, `pushEntities`: for a rideable
    // one what may be pushed that's a player, an iron golem, a minecart or a rider, or anything
    // where it has a rider; for another, the minecarts that don't ride it.
    fn cart_pushes_new<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        let me = self.body_at(id) else return
        let bb = me.bounding_box()
        let rideable = match self.all[self.at[id]] {
            some(Entity.Cart(c)) => c.rideable(),
            _ => false,
        }
        if rideable and me.passengers.is_empty() {
            let hit = Aabb { min_x: bb.min_x - 0.2, min_y: bb.min_y, min_z: bb.min_z - 0.2, max_x: bb.max_x + 0.2, max_y: bb.max_y, max_z: bb.max_z + 0.2 }
            for other in self.found(hit, id, 8 | BOATS) {
                let pushable = if self.is_boat(other) { true } else { self.mob_pushable(other, lf, f, blocks) }
                if not pushable {
                    continue
                }
                let golem = self.is_mob(other) and self.mob(other).species == IRON_GOLEM
                let empty = match self.body_at(id) {
                    some(b) => b.passengers.is_empty(),
                    none => false,
                }
                if not golem and empty and self.vehicle_of(other) == none {
                    if self.start_riding(other, id, false) {
                        break
                    }
                }
            }
        }
        // Each move of its own that collided pushes from where it was then, its motion and
        // facing then; a step along its track sets its own motion after, so what the push did
        // to it is gone (CAL-315).
        let moves = match self.all[self.at[id]] {
            some(Entity.Cart(c)) => c.collided.copy(),
            _ => List<CartMove>(),
        }
        for mv in moves {
            var c = self.lend_cart(id) else return
            let kept = (c.body.x, c.body.y, c.body.z, c.body.vx, c.body.vy, c.body.vz, c.body.y_rot)
            c.body.x = mv.x
            c.body.y = mv.y
            c.body.z = mv.z
            c.body.vx = mv.vx
            c.body.vy = mv.vy
            c.body.vz = mv.vz
            c.body.y_rot = mv.y_rot
            self.give_back_cart(c)
            self.cart_pushes_from(id, rideable, lf, f, blocks, players)
            var back = self.lend_cart(id) else return
            let (kx, ky, kz, kvx, kvy, kvz, kr) = kept
            let (pvx, pvy, pvz) = (back.body.vx - mv.vx, back.body.vy - mv.vy, back.body.vz - mv.vz)
            back.body.x = kx
            back.body.y = ky
            back.body.z = kz
            back.body.vx = kvx
            back.body.vy = kvy
            back.body.vz = kvz
            back.body.y_rot = kr
            if not mv.on_track {
                back.body.vx = back.body.vx + pvx
                back.body.vy = back.body.vy + pvy
                back.body.vz = back.body.vz + pvz
            }
            self.give_back_cart(back)
        }
    }

    // What the minecart `id` pushes where it is, its box a hair wider, as
    // `NewMinecartBehavior.pushEntities` has it (CAL-315).
    fn cart_pushes_from<B: CollisionBlocks + EntityTicking>(mut self, id: i32, rideable: bool, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        let after = self.body_at(id) else return
        let near = after.bounding_box().inflate(1.0e-7, 1.0e-7, 1.0e-7)
        if rideable {
            let ridden = not after.passengers.is_empty()
            for other in self.found(near, id, 8 | BOATS | CARTS | PLAYERS) {
                if self.players_in.contains(other) {
                    for p in players {
                        if p.id != other {
                            continue
                        }
                        let pb = p.pushable else continue
                        if pb.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
                            self.pushed_off_cart(other, id, p.x, p.z, lf, f, blocks)
                        }
                    }
                    continue
                }
                let pushable = if self.is_boat(other) or self.is_cart(other) { true } else { self.mob_pushable(other, lf, f, blocks) }
                if not pushable {
                    continue
                }
                let golem = self.is_mob(other) and self.mob(other).species == IRON_GOLEM
                if golem or self.is_cart(other) or ridden or self.vehicle_of(other) != none {
                    let ob = self.body_at(other) else continue
                    self.pushed_off_cart(other, id, ob.x, ob.z, lf, f, blocks)
                }
            }
            return
        }
        for other in self.found(near, id, CARTS) {
            if after.passengers.contains(other) {
                continue
            }
            let ob = self.body_at(other) else continue
            self.pushed_off_cart(other, id, ob.x, ob.z, lf, f, blocks)
        }
    }

    // `other.push(cart)`, `other` at `ox`, `oz`, pushing itself off the minecart `cart` (CAL-315):
    // another minecart as `AbstractMinecart.push` has it, `cart_pushes_cart`; a boat as
    // `AbstractBoat.push` has it, where the minecart's bottom is no higher than its; then
    // `Entity.push`, where they don't ride together and neither has no physics, each with nothing
    // riding it that may be pushed pushed away from the other, a player's push kept for the
    // server, `player_pushes`.
    fn pushed_off_cart<B: CollisionBlocks + EntityTicking>(mut self, other: i32, cart: i32, ox: f64, oz: f64, lf: LivingFacts, f: Facts, blocks: B) {
        let cb = self.body_at(cart) else return
        if self.is_cart(other) {
            self.cart_pushes_cart(other, cart)
            return
        }
        if self.is_boat(other) {
            let ob = self.body_at(other) else return
            if not (cb.bounding_box().min_y <= ob.bounding_box().min_y) {
                return
            }
        }
        if self.root_of(other) == self.root_vehicle(cart) or cb.no_physics {
            return
        }
        let player = self.players_in.contains(other)
        if not player {
            let ob = self.body_at(other) else return
            if ob.no_physics {
                return
            }
        }
        // `Entity.push` with `this` the one pushed off it: `xa` from it to the minecart.
        let q = push_between(ox, oz, cb.x, cb.z) else return
        let (xa, za) = q
        if player {
            self.player_pushes.push((other, -xa, -za))
        } else if self.is_boat(other) {
            var o = self.lend_boat(other) else return
            if o.body.passengers.is_empty() {
                o.body.push(-xa, 0.0, -za)
            }
            self.give_back_boat(o)
        } else {
            var o = self.lend_mob(other) else return
            if o.sleeping() {
                self.give_back_mob(o)
                return
            }
            let ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
            if o.living.body.passengers.is_empty() and o.pushable(lf, f, blocks, ticks) {
                o.living.body.push(-xa, 0.0, -za)
            }
            self.give_back_mob(o)
        }
        if cb.passengers.is_empty() {
            var c = self.lend_cart(cart) else return
            c.body.push(xa, 0.0, za)
            self.give_back_cart(c)
        }
    }

    // `AbstractMinecart.push` of what isn't a minecart, `other` at `ox`, `oz`, by the minecart
    // `cart` (CAL-315): where neither has no physics and `other` doesn't ride it, their gap across,
    // where its square's a hundredth of a hundredth or more, over its length, no more than a whole
    // of its inverse, a twentieth of that; the minecart pushed away from it, and it a quarter as
    // far the other way, whatever it is, a player's push kept for the server, `player_pushes`.
    // Nothing riding either keeps it from it.
    fn cart_pushed(mut self, cart: i32, other: i32, ox: f64, oz: f64, player: bool) {
        let a = self.body_at(cart) else return
        if a.no_physics or a.passengers.contains(other) {
            return
        }
        if not player {
            let ob = self.body_at(other) else return
            if ob.no_physics {
                return
            }
        }
        var xa = ox - a.x
        var za = oz - a.z
        var dd = xa * xa + za * za
        if not (dd >= f64(1.0e-4f32)) {
            return
        }
        dd = dd.sqrt()
        xa = xa / dd
        za = za / dd
        var pow = 1.0 / dd
        if pow > 1.0 {
            pow = 1.0
        }
        xa = xa * pow * f64(0.1f32) * 0.5
        za = za * pow * f64(0.1f32) * 0.5
        var c = self.lend_cart(cart) else return
        c.body.push(-xa, 0.0, -za)
        self.give_back_cart(c)
        if player {
            self.player_pushes.push((other, xa / 4.0, za / 4.0))
            return
        }
        var o = self.lend_mob(other) else return
        o.living.body.push(xa / 4.0, 0.0, za / 4.0)
        self.give_back_mob(o)
    }

    // `AbstractMinecart.push` of the minecart `cart` by the minecart `me` (CAL-315), as the old
    // behaviour has it: where `cart` doesn't ride `me` and neither has no physics, their gap
    // across, where it's a hundredth or more, over its length, no more than a whole of its
    // inverse, a twentieth of that, then `pushOtherMinecart`: where they're within about 37
    // degrees of `me`'s facing, each slowed to a fifth and pushed by half their summed motion,
    // `me` away from `cart` and `cart` away from it.
    fn cart_pushes_cart(mut self, me: i32, cart: i32) {
        let a = self.body_at(me) else return
        let b = self.body_at(cart) else return
        if a.no_physics or b.no_physics or a.passengers.contains(cart) {
            return
        }
        var xa = b.x - a.x
        var za = b.z - a.z
        var dd = xa * xa + za * za
        if not (dd >= f64(1.0e-4f32)) {
            return
        }
        dd = dd.sqrt()
        xa = xa / dd
        za = za / dd
        var pow = 1.0 / dd
        if pow > 1.0 {
            pow = 1.0
        }
        xa = xa * pow * f64(0.1f32) * 0.5
        za = za * pow * f64(0.1f32) * 0.5
        // Where minecarts move as `NewMinecartBehavior` has them, the way `me` goes, and any
        // facing (CAL-315).
        let (xo, zo) = if self.carts_experimental { (a.vx, a.vz) } else { (b.x - a.x, b.z - a.z) }
        let len = (xo * xo + zo * zo).sqrt()
        let (dx, dz) = if len < f64(1.0e-5f32) { (0.0, 0.0) } else { (xo / len, zo / len) }
        let yaw = a.y_rot * 0.017453292f32
        let (fx, fz) = (f64(table_cos(f64(yaw))), f64(table_sin(f64(yaw))))
        let flen = (fx * fx + fz * fz).sqrt()
        let (nx, nz) = if flen < f64(1.0e-5f32) { (0.0, 0.0) } else { (fx / flen, fz / flen) }
        let dot = (dx * nx + dz * nz).abs()
        if dot < f64(0.8f32) and not self.carts_experimental {
            return
        }
        let furnace_me = self.cart_furnace(me)
        let furnace_other = self.cart_furnace(cart)
        if furnace_other and not furnace_me {
            // Pushed by a furnace minecart: it slowed to a fifth and pushed by the furnace's motion,
            // the furnace slowed a little.
            var ca = self.lend_cart(me) else return
            ca.body.vx = ca.body.vx * 0.2
            ca.body.vz = ca.body.vz * 0.2
            ca.body.push(b.vx - xa, 0.0, b.vz - za)
            self.give_back_cart(ca)
            var cb = self.lend_cart(cart) else return
            cb.body.vx = cb.body.vx * 0.95
            cb.body.vz = cb.body.vz * 0.95
            self.give_back_cart(cb)
            return
        }
        if furnace_me and not furnace_other {
            var cb = self.lend_cart(cart) else return
            cb.body.vx = cb.body.vx * 0.2
            cb.body.vz = cb.body.vz * 0.2
            cb.body.push(a.vx + xa, 0.0, a.vz + za)
            self.give_back_cart(cb)
            var ca = self.lend_cart(me) else return
            ca.body.vx = ca.body.vx * 0.95
            ca.body.vz = ca.body.vz * 0.95
            self.give_back_cart(ca)
            return
        }
        let xdd = (b.vx + a.vx) / 2.0
        let zdd = (b.vz + a.vz) / 2.0
        var ca = self.lend_cart(me) else return
        ca.body.vx = ca.body.vx * 0.2
        ca.body.vz = ca.body.vz * 0.2
        ca.body.push(xdd - xa, 0.0, zdd - za)
        self.give_back_cart(ca)
        var cb = self.lend_cart(cart) else return
        cb.body.vx = cb.body.vx * 0.2
        cb.body.vz = cb.body.vz * 0.2
        cb.body.push(xdd + xa, 0.0, zdd + za)
        self.give_back_cart(cb)
    }

    // `AbstractBoat.tick`'s end for the boat `id` (CAL-315): what's about it, its box `near`, 0.2
    // wider and 0.01 lower each way, that it may push, `EntitySelector.pushableBy`: mobs that may be
    // pushed, other boats and players, in the order `getEntities` finds them, but what it rides,
    // `hasPassenger`. A mob, where no player steers it (`steered`), it has a seat left, the mob
    // rides nothing, is narrower, `hasEnoughSpaceFor`, and isn't `cannot_be_pushed_onto_boats`, is
    // taken in where it may ride, `startRiding`: off its boarding cooldown, and the boat's eyes out
    // of water, `canAddPassenger`. What else is about it is pushed, `boat_push`.
    fn boat_pushes<B: CollisionBlocks + EntityTicking>(mut self, id: i32, near: Aabb, steered: bool, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        for other in self.found(near, id, 8 | BOATS | PLAYERS) {
            if self.vehicle_of(id) == some(other) {
                continue
            }
            if self.players_in.contains(other) {
                for p in players {
                    if p.id != other {
                        continue
                    }
                    let pb = p.pushable else continue
                    if pb.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
                        self.boat_push(id, other, pb.min_y, p.x, p.z, lf, f, blocks)
                    }
                }
                continue
            }
            if self.is_boat(other) {
                let ob = self.body_at(other) else continue
                let top = self.body_at(id) else return
                if ob.bounding_box().min_y < top.bounding_box().max_y {
                    self.boat_push(id, other, ob.bounding_box().min_y, ob.x, ob.z, lf, f, blocks)
                }
                continue
            }
            if not self.mob_pushable(other, lf, f, blocks) {
                continue
            }
            let m = self.lend_mob(other) else continue
            let (my, mx, mz) = (m.living.body.bounding_box().min_y, m.living.body.x, m.living.body.z)
            let fits = m.living.body.vehicle == none and m.living.body.width < 1.375f32 and not kept_off_boats(m.species)
            let cooled = m.living.body.boarding_cooldown <= 0
            self.give_back_mob(m)
            let bt = self.lend_boat(id) else return
            let seats: usize = if bt.has_chest() { 1 } else { 2 }
            let seat_left = bt.body.passengers.len() < seats
            let room = bt.has_room()
            self.give_back_boat(bt)
            if not steered and seat_left and fits {
                if cooled and room {
                    _ = self.start_riding(other, id, true)
                }
                continue
            }
            self.boat_push(id, other, my, mx, mz, lf, f, blocks)
        }
    }

    // `AbstractBoat.push` of `other` by the boat `id` (CAL-315), its bottom `min_y` and it at `ox`,
    // `oz`: a boat's height its caller's, anything else's no higher than the boat's bottom; then
    // `Entity.push`, where they don't ride together and neither has no physics, each with nothing
    // riding it that may be pushed pushed away from the other, a player's push kept for the server,
    // `player_pushes`.
    fn boat_push<B: CollisionBlocks + EntityTicking>(mut self, id: i32, other: i32, min_y: f64, ox: f64, oz: f64, lf: LivingFacts, f: Facts, blocks: B) {
        let me = self.body_at(id) else return
        let boat = self.is_boat(other)
        if not boat and not (min_y <= me.bounding_box().min_y) {
            return
        }
        if self.root_vehicle(id) == self.root_of(other) or me.no_physics {
            return
        }
        let player = self.players_in.contains(other)
        if not player {
            let ob = self.body_at(other) else return
            if ob.no_physics {
                return
            }
        }
        let q = push_between(me.x, me.z, ox, oz) else return
        let (xa, za) = q
        if me.passengers.is_empty() {
            var b = self.lend_boat(id) else return
            b.body.push(-xa, 0.0, -za)
            self.give_back_boat(b)
        }
        if player {
            self.player_pushes.push((other, xa, za))
        } else if boat {
            var o = self.lend_boat(other) else return
            if o.body.passengers.is_empty() {
                o.body.push(xa, 0.0, za)
            }
            self.give_back_boat(o)
        } else {
            var o = self.lend_mob(other) else return
            let ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
            if o.living.body.passengers.is_empty() and o.pushable(lf, f, blocks, ticks) {
                o.living.body.push(xa, 0.0, za)
            }
            self.give_back_mob(o)
        }
    }

    /// The boxes of the boats and living shulkers meeting `area`, but the one the player `player`
    /// rides, which a player's move collides with, as they may be collided with,
    /// `canBeCollidedWith` (CAL-315, CAL-377).
    pub fn boat_boxes(self, area: Aabb, player: i32) -> List<Aabb> {
        let riding = self.player_vehicle(player)
        var out = List<Aabb>()
        for id in self.found(area, -1, BOATS | 8) {
            if riding == some(id) {
                continue
            }
            let e = self.all[self.at[id]] else continue
            if not hard_box(e) {
                continue
            }
            let b = box_of(e)
            if b.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                out.push(b)
            }
        }
        return out
    }

    // The boxes about `area` the boat of the body `b` collides with as it moves, `getEntityCollisions`
    // by `canVehicleCollide` (CAL-315): other boats, which may be collided with, and what's
    // pushable, `isPushable`: mobs as their own say, and players, not spectators, alive and off
    // what's climbable; but none that rides with it, `isPassengerOfSameVehicle`.
    fn boat_others<B: CollisionBlocks>(self, lf: LivingFacts, f: Facts, blocks: B, b: Body, area: Aabb, players: List<Follower>) -> List<Aabb> {
        let id = b.id
        let root = self.root_vehicle(id)
        var out = List<Aabb>()
        for other in self.found(area, id, 8 | BOATS | CARTS) {
            if self.root_vehicle(other) == root {
                continue
            }
            let e = self.all[self.at[other]] else continue
            let ob = box_of(e)
            if not ob.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                continue
            }
            let collides = match e {
                Entity.Boat(_) => true,
                Entity.Cart(_) => true,
                Entity.Mob(mob) => {
                    var copy = mob.copy()
                    copy.pushable(lf, f, blocks, true)
                },
                _ => false,
            }
            if collides {
                out.push(ob)
            }
        }
        for p in players {
            let pb = p.collides else continue
            if self.player_vehicle(p.id) == some(id) {
                continue
            }
            if pb.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                out.push(pb)
            }
        }
        return out
    }

    // A falling block's tick, at `i` (CAL-243): its own, `world.falling_block`'s, in a world from
    // `min_y` to `max_y`, then what its blocks did, kept, and its landing shown, for its level to
    // land or drop it, `Shown.Fell`.
    fn tick_falling<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, falling: own FallingBlock, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, sounds: mut List<EntitySound>) {
        var p = falling
        let block = f.block(p.state)
        let air = f.is_air(p.state)
        let concrete = f.is_a(block, String("ConcretePowderBlock"))
        p.tick(f, m, t, blocks, air, concrete, min_y, self.max_y, mut sounds)
        if let landed = p.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        if let hurt = p.hurt.take() {
            self.shown.push(Shown.FallingHurt(hurt))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        if let fell = p.fell.take() {
            self.shown.push(Shown.Fell(fell))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(p.body.x, p.body.y, p.body.z)
        let removed = p.body.removed
        self.all[i] = some(Entity.Falling(p))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // A dragon fireball's or a wind charge's tick, at `i` (D618, CAL-182): kept where it was,
    // `tick_begin`, a wind charge above the world's top by more than 30 bursting there, nothing
    // else done; to where it looks for what it may hit, `tick_start`; the nearest of what it may
    // hit, `fireball_targets`, its owner found among the level's entities and `players`; its move
    // there, `go`; the end of its tick, `tick_end`; then, where it hit something, `fireball_hit`.
    fn tick_fireball<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, fireball: own Fireball, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var b = fireball
        b.tick_begin()
        if b.kind == SHULKER_BULLET and self.peaceful {
            // `ShulkerBullet.checkDespawn`: gone in peaceful (CAL-200).
            b.body.removed = true
        } else if b.kind == SHULKER_BULLET {
            // `ShulkerBullet.tick` (CAL-200): `Projectile.tick`'s first, `tick_end`, its target
            // found, its way, what it meets, its move, its hit, then its turn and its steps.
            let owner = self.owner_of(b.owner, players)
            b.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
            let target = self.homing_of(b.target, players)
            if target == none {
                b.target = none
            }
            let border = self.border ?? widest_border()
            b.bullet_start(target, f, m, blocks, border)
            let targets = self.bullet_targets(b, owner, players)
            let hit = b.nearest(targets)
            b.bullet_go(f, blocks, mut sounds)
            // A breeze it hit turns it back, and it hits nothing, `hitTargetOrDeflectSelf` (CAL-421).
            var deflected = false
            if let h = hit {
                if not b.body.removed {
                    let (met, _) = self.deflects(h.target, false, mut b.body, mut sounds)
                    deflected = met
                }
            }
            if not b.body.removed and not deflected {
                if let struck = b.bullet_hit(hit) {
                    let id = b.body.id
                    let state = blocks.collision_state(b.way.bx, b.way.by, b.way.bz) ?? 0
                    if hit == none and not b.way.border {
                        if let missing = struck_missing(f, state, "a shulker's bullet") {
                            b.acted.push(Acted.Missing(missing))
                            b.acted_after.push(sounds.len())
                        }
                    }
                    // `Projectile.onHit`'s `PROJECTILE_LAND`, then `destroy`'s `ENTITY_DAMAGE` where
                    // it is, both made by it (CAL-275).
                    let by = EventSource { id: id, uuid: some(b.body.uuid), owner: b.owner }
                    b.acted.push(land_event(by, hit, (b.way.bx, b.way.by, b.way.bz), state))
                    b.acted_after.push(sounds.len())
                    b.acted.push(Acted.GameEventBy((String("minecraft:entity_damage"), (b.body.x, b.body.y, b.body.z), none, by)))
                    b.acted_after.push(sounds.len())
                    self.keep_acted(id, b.body.bounding_box(), b.acted, b.acted_after)
                    b.acted.clear()
                    b.acted_after.clear()
                    self.shown.push(Shown.Fireballed(struck))
                    self.shown_by.push(id)
                    self.shown_after.push(sounds.len())
                    b.body.removed = true
                }
            }
            b.bullet_end(target, f, blocks)
        } else if let high = b.burst_above(self.max_y) {
            self.shown.push(Shown.Fireballed(high))
            self.shown_by.push(b.body.id)
            self.shown_after.push(sounds.len())
            b.body.removed = true
        } else {
            let owner = self.owner_of(b.owner, players)
            let border = self.border ?? widest_border()
            b.tick_start(f, m, blocks, border)
            let targets = self.fireball_targets(b, owner, players)
            let hit = b.nearest(targets)
            b.go(f, blocks, hit, mut sounds)
            b.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
            // A breeze it hit turns it back, and it hits nothing, `hitTargetOrDeflectSelf` (CAL-421).
            var deflected = false
            if let h = hit {
                if not b.body.removed {
                    let (met, reversed) = self.deflects(h.target, wind_kind(b.kind), mut b.body, mut sounds)
                    deflected = met
                    if reversed {
                        b.acceleration = b.acceleration * 0.5
                    }
                }
            }
            if not deflected {
                self.fireball_hit(mut b, f, blocks, hit, owner, sounds.len())
            }
        }
        let id = b.body.id
        self.keep_acted(id, b.body.bounding_box(), b.acted, b.acted_after)
        b.acted.clear()
        b.acted_after.clear()
        let key = section_key(b.body.x, b.body.y, b.body.z)
        let removed = b.body.removed
        self.all[i] = some(Entity.Fireball(b))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // What the dragon fireball `b` hit, `hit` the entity its way met and `owner` its owner as its
    // level found them, `heard` its tick's sounds, where it's still here, `isAlive` (D618): where a
    // block's hit that would do something of it, that said missing, `struck_missing`; then what
    // it struck, `Shown.Fireballed`, its level's to deal, `onHit`, and it's gone, `discard`.
    fn fireball_hit<B: CollisionBlocks>(mut self, b: mut Fireball, f: Facts, blocks: B, hit: ThrownHit?, owner: OwnerView?, heard: usize) {
        if b.body.removed {
            return
        }
        let state = blocks.collision_state(b.way.bx, b.way.by, b.way.bz) ?? 0
        let struck = b.hit(f, hit, state, owner) else return
        // `Projectile.onHit`'s `PROJECTILE_LAND`, made by it (CAL-275): where it hit an entity, at
        // the hit; else at the middle of the block it hit, of its state.
        b.acted.push(land_event(EventSource { id: b.body.id, uuid: some(b.body.uuid), owner: b.owner }, hit, (b.way.bx, b.way.by, b.way.bz), state))
        b.acted_after.push(heard)
        if hit == none and not b.way.border {
            if let missing = struck_missing(f, state, if b.kind == WIND_CHARGE { "a wind charge" } else if b.kind == BREEZE_WIND_CHARGE { "a breeze's wind charge" } else if b.kind == SMALL_FIREBALL { "a small fireball" } else if b.kind == LARGE_FIREBALL { "a large fireball" } else { "a dragon fireball" }) {
                b.acted.push(Acted.Missing(missing))
                b.acted_after.push(heard)
            }
        }
        let id = b.body.id
        self.keep_acted(id, b.body.bounding_box(), b.acted, b.acted_after)
        b.acted.clear()
        b.acted_after.clear()
        self.shown.push(Shown.Fireballed(struck))
        self.shown_by.push(id)
        self.shown_after.push(heard)
        b.body.removed = true
    }

    // What the dragon fireball `b` may hit along its way, `getEntityHitResult`'s candidates (D618):
    // what a thrown potion may, `projectile_targets`, the ender dragons' parts among them, but end
    // crystals for a wind charge, `AbstractWindCharge.canHitEntity`, nor other wind charges; the
    // wind charges and large fireballs among them, which it redirects (CAL-182, CAL-416); and the
    // boats and minecarts, which it hits (CAL-417).
    fn fireball_targets(self, b: Fireball, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        let reach = b.reach()
        var out = self.projectile_targets(reach, b.body.id, b.left_owner, owner, players, true, true)
        if wind_kind(b.kind) {
            var kept = List<Target>()
            for target in out {
                let charge = self.is_fireball(target.id) and wind_kind(self.fireball_kind(target.id))
                if not self.is_crystal(target.id) and not charge {
                    kept.push(target)
                }
            }
            out = kept
        }
        return out
    }

    // What a shulker's bullet may hit along its way (CAL-200): what any projectile may,
    // `projectile_targets`, but what goes through blocks, `noPhysics`, as a vex,
    // `ShulkerBullet.canHitEntity`.
    fn bullet_targets(self, b: Fireball, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        var kept = List<Target>()
        for target in self.projectile_targets(b.reach(), b.body.id, b.left_owner, owner, players, true, true) {
            if self.at.contains(target.id) {
                if let e = self.all[self.at[target.id]] {
                    match e {
                        Entity.Mob(o) => {
                            if o.living.body.no_physics {
                                continue
                            }
                        },
                        _ => {},
                    }
                }
            }
            kept.push(target)
        }
        return kept
    }

    // The entity of the UUID `uuid` a shulker's bullet homes on, as its level finds it,
    // `EntityReference.getEntity` (CAL-200): among `players`, alive where they're neither dead
    // nor spectating; else among its mobs and armor stands, alive where they are. None where
    // there's none such.
    fn homing_of(self, uuid: (i64, i64)?, players: List<Follower>) -> Homing? {
        let u = uuid else return none
        for p in players {
            if p.uuid == some(u) {
                return some(Homing { id: p.id, x: p.x, y: p.y, z: p.z, height: p.height, alive: not p.dead and not p.spectator })
            }
        }
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        return some(Homing { id: o.living.body.id, x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, height: o.living.body.height, alive: o.living.alive() })
                    }
                },
                Entity.Stand(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        return some(Homing { id: o.living.body.id, x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, height: o.living.body.height, alive: o.living.alive() })
                    }
                },
                _ => {},
            }
        }
        return none
    }

    // The parts of the ender dragons there are whose boxes meet `reach`, as a projectile may hit
    // them (D618), each its dragon's ID and 1 past its place among them, as `Level.getEntities`
    // finds them after the rest, each pickable and alive, `canBeHitByProjectile` (CAL-167).
    fn parts_targets(self, reach: Aabb) -> List<Target> {
        var out = List<Target>()
        var last = -1
        var k = 0
        for (dragon, part) in self.dragon_parts {
            if dragon != last {
                last = dragon
                k = 0
            }
            k += 1
            if self.at.contains(dragon) and part.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) {
                let (cx, cz) = ((part.min_x + part.max_x) / 2.0, (part.min_z + part.max_z) / 2.0)
                out.push(Target { id: dragon + k, bounds: part, x: cx, y: part.min_y, z: cz, player: false })
            }
        }
        return out
    }

    // An eye of ender's tick, at `i` (D598): `EyeOfEnder.tick`; it's gone where its tick took it
    // away, its removal sent after its sounds, then, where its life ran out, its level event where
    // it is, `Shown.Level`, a sound after them, as vanilla sends the removal as it's discarded,
    // before the event; or, where it survives, its stack dropped where it is, `Shown.Survived`,
    // likewise (D599).
    fn tick_eye<B: CollisionBlocks>(mut self, i: usize, eye: own EyeOfEnder, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        var e = eye
        let ran_out = e.tick(f, t, blocks, min_y, fast_lava, mut sounds)
        let id = e.body.id
        let (bx, by, bz) = e.body.block()
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let removed = e.body.removed
        let shown = if e.survives { Shown.Survived(Spilled { x: e.body.x, y: e.body.y, z: e.body.z, stack: e.item.copy() }) } else { Shown.Level((EYE_GONE, bx, by, bz, 0)) }
        self.all[i] = some(Entity.Eye(e))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
        if ran_out {
            self.shown.push(shown)
            self.shown_by.push(id)
            self.shown_after.push(sounds.len() + 1)
        }
    }

    // An end crystal's tick, at `i` (D589): `EndCrystal.tick`, what blocks did to it kept as what a
    // living entity shows is, then, in a level with a dragon fight, the air of its block set alight
    // by its level, `Shown.Kindled`, after its tick's sounds; and it's gone where its tick took it
    // away, its removal sent after that.
    fn tick_crystal<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, crystal: own EndCrystal, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, sounds: mut List<EntitySound>) {
        var c = crystal
        let alight = c.tick(f, t, lf.damage, blocks, self.fight, mut sounds)
        let id = c.body.id
        self.keep_acted(id, c.body.bounding_box(), c.acted, c.acted_after)
        c.acted.clear()
        c.acted_after.clear()
        if let at = alight {
            self.shown.push(Shown.Kindled(at))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        self.all[i] = some(Entity.Crystal(c))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // An area effect cloud's tick, at `i` (D529): up to its pass, `tick_start`; then, where it's
    // to look for any to dose, the living things in its box, `cloud_near`, its pass over them,
    // `dose`, and what it gives those it doses, `Shown.Dosed`, after its tick's sounds so far, for
    // its level to give; and it's gone where it went, `discard`, its removal sent after that.
    fn tick_cloud<B: CollisionBlocks>(mut self, i: usize, cloud: own EffectCloud, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var c = cloud
        if let radius = c.tick_start(f, t, blocks, min_y, fast_lava, mut sounds) {
            let effects = c.effects()
            let near = self.cloud_near(c, effects, lf, players)
            let targets = c.dose(radius, near)
            if not targets.is_empty() {
                self.shown.push(Shown.Dosed(Dose { by: c.doser(), targets: targets, effects: effects }))
                self.shown_by.push(c.body.id)
                self.shown_after.push(sounds.len())
            }
        }
        let id = c.body.id
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        self.all[i] = some(Entity.Cloud(c))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // The living things in the cloud `c`'s box, as `getEntitiesOfClass(LivingEntity)` finds them
    // for its pass (D529): the mobs whose boxes meet it, as `found` finds them, then the players of
    // `players` whose boxes do, but spectators, `NO_SPECTATORS`; each one the cloud may dose where
    // potions take it, not dying, `isAffectedByPotions`, and one of `effects` can affect it,
    // `canBeAffected`, as each can a player. Armor stands, which potions don't take, it never may.
    fn cloud_near(self, c: EffectCloud, effects: List<ActiveEffect>, lf: LivingFacts, players: List<Follower>) -> List<Breather> {
        let b = c.body.bounding_box()
        var out = List<Breather>()
        for id in self.found(b, c.body.id, 8) {
            let slot = self.all[self.at[id]] else continue
            if let Entity.Mob(m) = slot {
                var any = false
                for e in effects {
                    if m.living.can_be_affected(lf, e.id) {
                        any = true
                    }
                }
                out.push(Breather { id: id, x: m.living.body.x, z: m.living.body.z, player: false, takes: any and not m.living.dead_or_dying() })
            }
        }
        for pl in players {
            if pl.spectator {
                continue
            }
            let pb = pl.bounds else continue
            if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                out.push(Breather { id: pl.id, x: pl.x, z: pl.z, player: true, takes: not pl.dead })
            }
        }
        return out
    }

    // A thrown potion's tick, at `i` (D527): to where it looks for what it may hit, `tick_start`;
    // the nearest of what it may hit, `thrown_targets`, its owner found among the level's entities
    // and `players`; its move there, `go`; the end of its tick, `tick_end`; then, where it hit
    // something, `hit`, the block its way met as it is by then, what it hit, `Shown.Splashed`,
    // after its tick's sounds so far, for its level to splash, `onHit`, and it's gone, `discard`.
    // What the block does of it that Calcite doesn't do yet is said first, `struck_missing`.
    fn tick_thrown<B: CollisionBlocks + Rain + Gateways + MobLight>(mut self, i: usize, thrown: own ThrownItem, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var p = thrown
        // `ThrownEnderpearl.tick`'s first (D579): the chunk it's in, and its owner, a player
        // wherever they are; one whose owner's dead goes where `ender_pearls_vanish_on_death`
        // has it, its tick passed over.
        let (cx, cz) = (i32.saturate(p.body.x.floor()) >> 4, i32.saturate(p.body.z.floor()) >> 4)
        var pearl_owner: PearlOwner? = none
        if p.pearl {
            pearl_owner = self.pearl_owner_of(p.owner)
            if let o = pearl_owner {
                if not o.alive and self.pearls_vanish {
                    p.body.removed = true
                }
            }
        }
        if p.spit and not p.body.removed {
            // A llama's spit's own tick, `LlamaSpit.tick` (CAL-201): `Projectile.tick`'s and
            // `baseTick` first, then what it hits along its motion, then its move.
            let owner = self.owner_of(p.owner, players)
            let border = self.border ?? widest_border()
            p.spit_start(f, m, t, blocks, min_y, fast_lava, owner, border, mut sounds)
            let targets = self.thrown_targets(p, owner, players)
            let hit = p.nearest(targets)
            // A breeze it hit turns it back, and it hits nothing, `hitTargetOrDeflectSelf` (CAL-421).
            var deflected = false
            if let h = hit {
                if not p.body.removed {
                    let (met, _) = self.deflects(h.target, false, mut p.body, mut sounds)
                    deflected = met
                }
            }
            if not deflected {
                self.spit_hit(mut p, f, blocks, hit, sounds.len())
            }
            p.spit_end(f, blocks)
        } else if p.rocket and not p.body.removed {
            // A firework rocket's own tick, `FireworkRocketEntity.tick` (CAL-214):
            // `Projectile.tick`'s and `baseTick` first, its motion sped up, and what it hits along
            // that; then its move, then its hit, then its turn, its launch and its life, bursting
            // past its lifetime. Where it burst as it hit, vanilla bursts it again past its
            // lifetime, seen by no one then, which Calcite doesn't, as what its explosions hurt is
            // said missing.
            // One stuck to a player, found among `players`, boosts them where they glide, their
            // motion its level's to set, `Shown.Boosted`, and doesn't move itself.
            let owner = self.owner_of(p.owner, players)
            let border = self.border ?? widest_border()
            var stuck: Stuck? = none
            if let a = p.attached {
                for pl in players {
                    if pl.id == a {
                        stuck = some(Stuck { x: pl.x, y: pl.y, z: pl.z, vx: pl.vx, vy: pl.vy, vz: pl.vz, gliding: pl.gliding, x_rot: pl.x_rot, yaw: pl.yaw, left: pl.rocket_left })
                    }
                }
            }
            if let boost = p.rocket_start(f, m, t, blocks, min_y, fast_lava, owner, border, stuck, mut sounds) {
                if let a = p.attached {
                    self.shown.push(Shown.Boosted((a, boost.0, boost.1, boost.2)))
                    self.shown_by.push(p.body.id)
                    self.shown_after.push(sounds.len())
                }
            }
            let targets = self.thrown_targets(p, owner, players)
            let hit = p.nearest(targets)
            if p.attached == none {
                p.rocket_move(f, m, t, blocks, mut sounds)
            }
            // A breeze it hit turns it back, and it hits nothing, `hitTargetOrDeflectSelf` (CAL-421).
            var deflected = false
            if let h = hit {
                if not p.body.removed {
                    let (met, _) = self.deflects(h.target, false, mut p.body, mut sounds)
                    deflected = met
                }
            }
            if deflected {
                p.body.needs_sync = true
            } else {
                self.rocket_hit(mut p, f, m, blocks, players, hit, sounds.len())
            }
            if p.rocket_end(mut sounds) and not p.body.removed {
                self.burst(mut p, f, m, blocks, players, sounds.len())
            }
        } else if p.bobber and not p.body.removed {
            // A fishing hook's own tick, `FishingHook.tick` (CAL-214): its owner, a player among
            // `players`, keeps it where they can still fish with it, `shouldStopFishing`: alive,
            // not a spectator, a fishing rod in either hand and within 32 of it. Flying, it looks
            // for what it hits after its start, `checkCollision`, and hooks an entity or an item it
            // hits, `setHookedEntity`, else a block slows it, `hook_hit_block`; hooked, it follows
            // what it hooked as its level finds it, `hooked_view`. Its particles are its level's
            // to send, after the sounds that came before them.
            let owner = self.owner_of(p.owner, players)
            var keeps = false
            if let o = owner {
                for pl in players {
                    if pl.id == o.id {
                        let (dx, dy, dz) = (p.body.x - pl.x, p.body.y - pl.y, p.body.z - pl.z)
                        keeps = not pl.dead and not pl.spectator and pl.fishing_rod and dx * dx + dy * dy + dz * dz <= 1024.0
                    }
                }
            }
            let border = self.border ?? widest_border()
            let sky = blocks.sees_sky(i32.saturate(p.body.x.floor()), i32.saturate(p.body.y.floor()) + 1, i32.saturate(p.body.z.floor()))
            var hooked: Hooked? = none
            if let h = p.hooked {
                hooked = self.hooked_view(h, players)
            }
            let look = p.hook_start(f, m, t, blocks, min_y, fast_lava, owner, keeps, sky, self.game_time, border, hooked, mut sounds)
            if look == 1 {
                let targets = self.hook_targets(p, owner, players)
                match p.nearest(targets) {
                    some(h) => {
                        // A breeze it hit turns it back, and it hooks nothing, `hitTargetOrDeflectSelf`
                        // (CAL-421).
                        let (met, _) = self.deflects(h.target, false, mut p.body, mut sounds)
                        if not met {
                            // A wind charge or large fireball it hit sent on first,
                            // `onRedirectProjectile`, by its owner, then hooked (CAL-416).
                            if self.is_fireball(h.target) {
                                p.acted.push(Acted.Redirected((h.target, p.owner)))
                                p.acted_after.push(sounds.len())
                            }
                            p.set_hooked(some(h.target))
                            // `Projectile.onHit`'s `PROJECTILE_LAND` at the hit, made by it (CAL-275).
                            p.acted.push(land_event(EventSource { id: p.body.id, uuid: some(p.body.uuid), owner: p.owner }, some(h), (p.way.bx, p.way.by, p.way.bz), 0))
                            p.acted_after.push(sounds.len())
                        }
                    },
                    none => {
                        let state = blocks.collision_state(p.way.bx, p.way.by, p.way.bz) ?? 0
                        let landed = not p.way.missed and not p.way.border
                        if let said = p.hook_hit_block(f, state) {
                            p.acted.push(Acted.Missing(said))
                            p.acted_after.push(sounds.len())
                        }
                        // `Projectile.onHit`'s `PROJECTILE_LAND` on the block, made by it, where it
                        // didn't bounce off the world border (CAL-275).
                        if landed {
                            p.acted.push(land_event(EventSource { id: p.body.id, uuid: some(p.body.uuid), owner: p.owner }, none, (p.way.bx, p.way.by, p.way.bz), state))
                            p.acted_after.push(sounds.len())
                        }
                    },
                }
            }
            if look >= 0 {
                // The boats about it, which it collides with as it moves, `move(MoverType.SELF)`'s
                // `getEntityCollisions`, `canBeCollidedWith` (CAL-418).
                p.body.others = self.boat_boxes_near(p.body)
                p.hook_end(f, m, t, blocks, mut sounds)
                p.body.others.clear()
            }
            for s in p.sprays {
                self.shown.push(Shown.Spread(Spread { particle: s.particle.copy(), x: s.x, y: s.y, z: s.z, count: s.count, dx: s.dx, dy: s.dy, dz: s.dz, speed: s.speed }))
                self.shown_by.push(p.body.id)
                self.shown_after.push(s.after)
            }
            p.sprays.clear()
        } else if not p.body.removed {
            let owner = self.owner_of(p.owner, players)
            let border = self.border ?? widest_border()
            p.tick_start(f, m, blocks, border, sounds.len())
            let targets = self.thrown_targets(p, owner, players)
            let hit = p.nearest(targets)
            p.go(f, blocks, hit, mut sounds)
            p.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
            // A breeze it hit turns it back, and it hits nothing, `hitTargetOrDeflectSelf` (CAL-421).
            var deflected = false
            if let h = hit {
                if not p.body.removed {
                    let (met, _) = self.deflects(h.target, false, mut p.body, mut sounds)
                    deflected = met
                }
            }
            if not deflected {
                self.thrown_hit(mut p, f, blocks, hit, sounds.len())
            }
        }
        // Then, still here, its ticket put again about the chunk it's in, `ENDER_PEARL`, where its
        // owner's a player, once its timer's out or it's come into another chunk, `ticketTimer`
        // then its ticket's ticks less one (D579), and it's among their pearls,
        // `registerAndUpdateEnderPearlTicket` (D580).
        if p.pearl and not p.body.removed {
            p.ticket_timer -= 1
            let (nx, nz) = (i32.saturate(p.body.x.floor()) >> 4, i32.saturate(p.body.z.floor()) >> 4)
            if let o = pearl_owner {
                if p.ticket_timer <= 0 or nx != cx or nz != cz {
                    p.registered = o.serial
                    self.pearl_tickets.push((nx, nz))
                    p.ticket_timer = PEARL_TICKET_TICKS - 1
                }
            }
        }
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        let key = section_key(p.body.x, p.body.y, p.body.z)
        let removed = p.body.removed
        self.all[i] = some(Entity.Thrown(p))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // The player owning an ender pearl of the UUID `owner`, as `findOwnerIncludingDeadPlayer`
    // finds them among those wherever they are (D579); none for no owner, or one that isn't a
    // player.
    fn pearl_owner_of(self, owner: (i64, i64)?) -> PearlOwner? {
        let u = owner else return none
        for o in self.pearl_owners {
            if o.uuid == u {
                return some(o)
            }
        }
        return none
    }

    // What a llama's spit `p` hit, `hitTargetOrDeflectSelf` (CAL-201): an entity its way met, hurt
    // by its level, `Shown.SpitHit`, the spit going on; else the world border or a block that
    // isn't air, what that block does of it said missing where it'd do anything, and it's gone,
    // `onHitBlock`.
    fn spit_hit<B: CollisionBlocks>(mut self, p: mut ThrownItem, f: Facts, blocks: B, hit: ThrownHit?, heard: usize) {
        let state = blocks.collision_state(p.way.bx, p.way.by, p.way.bz) ?? 0
        let landed = p.snowball_hit(f, hit, state) else return
        let id = p.body.id
        // `Projectile.onHit`'s `PROJECTILE_LAND`, made by it (CAL-275): where it hit an entity, at
        // the hit; else at the middle of the block it hit, of its state.
        p.acted.push(land_event(EventSource { id: id, uuid: some(p.body.uuid), owner: p.owner }, hit, (p.way.bx, p.way.by, p.way.bz), state))
        p.acted_after.push(heard)
        if landed.entity != none {
            self.shown.push(Shown.SpitHit(landed))
            self.shown_by.push(id)
            self.shown_after.push(heard)
            return
        }
        if not p.way.border {
            if let missing = struck_missing(f, state, "a llama's spit") {
                p.acted.push(Acted.Missing(missing))
                p.acted_after.push(heard)
            }
        }
        p.body.removed = true
    }

    // What a firework rocket `p` hit, `hitTargetOrDeflectSelf` (CAL-214), where it's still here:
    // first, where its way met anything, it's to be sent again, `needsSync`; then an entity its way
    // met, and it bursts, `onHitEntity`; else the world border or a block that isn't air: what
    // that block does of it as it's inside it said missing where it'd do anything, `entityInside`;
    // it bursts where it has explosions; and what the block does as it's hit said missing,
    // `onProjectileHit`, as `onHitBlock` has it.
    fn rocket_hit<B: CollisionBlocks>(mut self, p: mut ThrownItem, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, hit: ThrownHit?, heard: usize) {
        if p.body.removed {
            return
        }
        if hit != none or not p.way.missed {
            p.body.needs_sync = true
        }
        let state = blocks.collision_state(p.way.bx, p.way.by, p.way.bz) ?? 0
        let landed = p.snowball_hit(f, hit, state) else return
        // `Projectile.onHit`'s `PROJECTILE_LAND`, made by it (CAL-275), before its burst, where
        // vanilla's comes after it.
        p.acted.push(land_event(EventSource { id: p.body.id, uuid: some(p.body.uuid), owner: p.owner }, hit, (p.way.bx, p.way.by, p.way.bz), state))
        p.acted_after.push(heard)
        if landed.entity != none {
            self.burst(mut p, f, m, blocks, players, heard)
            return
        }
        if let missing = rocket_inside_missing(f, state) {
            p.acted.push(Acted.Missing(missing))
            p.acted_after.push(heard)
        }
        if let missing = struck_missing(f, state, "a firework rocket") {
            p.acted.push(Acted.Missing(missing))
            p.acted_after.push(heard)
        }
        if p.explosions > 0 {
            self.burst(mut p, f, m, blocks, players, heard)
        }
    }

    // `FireworkRocketEntity.explode` of the rocket `p` (CAL-214): what blocks did that its level's
    // to do first; then its burst, `Shown.Burst`, with what its explosions hurt, `rocket_hurts`,
    // for its level to send and deal, after `heard` of its tick's sounds; and it's gone, `discard`.
    fn burst<B: CollisionBlocks>(mut self, p: mut ThrownItem, f: Facts, m: MovementStates, blocks: B, players: List<Follower>, heard: usize) {
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        var name: Tag? = none
        if p.body.extras.contains("CustomName") {
            name = some(p.body.extras["CustomName"].copy())
        }
        let hurts = self.rocket_hurts(p, f, m, blocks, players)
        self.shown.push(Shown.Burst(RocketBurst { id: id, uuid: p.body.uuid, name: name, owner: p.owner, at: (p.body.x, p.body.y, p.body.z), hurts: hurts }))
        self.shown_by.push(id)
        self.shown_after.push(heard)
        p.body.removed = true
    }

    // What the explosions of the rocket `p` hurt, `dealExplosionDamage` (CAL-214): nothing where it
    // has none; else, by 5 and 2 for each, the player it's stuck to, found among `players`, by all
    // of that; then each other living thing whose box meets the rocket's grown 5,
    // `getEntitiesOfClass(LivingEntity)`, the armor stands, mobs and players in their places
    // among each other, the players of `players` but spectators, `NO_SPECTATORS`; within 5 of it,
    // `distanceToSqr`, that it sees from where it is, to their feet or halfway up them, `clip` with
    // `ClipContext.Block.COLLIDER`: by that times the root of how far within 5 they are, in
    // fifths, `distanceTo` in floats. Each one's ID, where it is across and by how much.
    fn rocket_hurts<B: CollisionBlocks>(self, p: ThrownItem, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> List<(i32, f64, f64, f32)> {
        var out = List<(i32, f64, f64, f32)>()
        if p.explosions <= 0 {
            return out
        }
        let amount = 5.0f32 + f32.nearest(p.explosions * 2)
        var stuck_to = -1
        if let a = p.attached {
            for pl in players {
                if pl.id == a {
                    stuck_to = a
                    out.push((a, pl.x, pl.z, amount))
                }
            }
        }
        let b = p.body.bounding_box().inflate(5.0, 5.0, 5.0)
        var near = List<(i32, f64, f64, f64, f32)>()
        for id in self.found(b, p.body.id, 12 | PLAYERS) {
            if id == stuck_to {
                continue
            }
            if self.players_in.contains(id) {
                for pl in players {
                    if pl.id != id or pl.spectator {
                        continue
                    }
                    let pb = pl.bounds else continue
                    if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        near.push((pl.id, pl.x, pl.y, pl.z, pl.height))
                    }
                }
                continue
            }
            let slot = self.all[self.at[id]] else continue
            match slot {
                Entity.Mob(mob) => near.push((id, mob.living.body.x, mob.living.body.y, mob.living.body.z, mob.living.body.height)),
                Entity.Stand(a) => near.push((id, a.living.body.x, a.living.body.y, a.living.body.z, a.living.body.height)),
                _ => {},
            }
        }
        let from = (p.body.x, p.body.y, p.body.z)
        for (id, x, y, z, height) in near {
            let (dx, dy, dz) = (p.body.x - x, p.body.y - y, p.body.z - z)
            if dx * dx + dy * dy + dz * dz > 25.0 {
                continue
            }
            var sees = false
            for step in 0..2 {
                let to = (x, y + f64(height) * (0.5 * f64(step)), z)
                if clip_collider(f, m, blocks, p.body.mover(), from, to).missed {
                    sees = true
                    break
                }
            }
            if not sees {
                continue
            }
            let (fx, fy, fz) = (f32.nearest(dx), f32.nearest(dy), f32.nearest(dz))
            let dist = (fx * fx + fy * fy + fz * fz).sqrt()
            let damage = amount * f32.nearest(((5.0 - f64(dist)) / 5.0).sqrt())
            out.push((id, x, z, damage))
        }
        return out
    }

    // What the thrown item `p` hit, `hit` the entity its way met, `heard` its tick's sounds, where
    // it's still here (D527): where a block's hit that would do something of it, that said
    // missing, `struck_missing`; then its hit, a potion's splash, `Shown.Splashed`, or an ender
    // pearl's, `Shown.Pearled` (D579), its level's to deal, and it's gone.
    fn thrown_hit<B: CollisionBlocks>(mut self, p: mut ThrownItem, f: Facts, blocks: B, hit: ThrownHit?, heard: usize) {
        if p.body.removed {
            return
        }
        let state = blocks.collision_state(p.way.bx, p.way.by, p.way.bz) ?? 0
        var shown: Shown? = none
        var block = false
        if p.pearl {
            if let landed = p.pearl_hit(f, hit, state) {
                block = landed.entity == none
                shown = some(Shown.Pearled(landed))
            }
        } else if p.snowball {
            // A snowball's (CAL-201).
            if let landed = p.snowball_hit(f, hit, state) {
                block = landed.entity == none
                shown = some(Shown.Snowballed(landed))
            }
        } else if p.egg {
            // An egg's (CAL-214): what it hit as a snowball's, then the chickens it hatches drawn
            // from its own random, `ThrownEgg.onHit`, with its turn and its stack, which its level
            // hatches.
            if let landed = p.snowball_hit(f, hit, state) {
                block = landed.entity == none
                let count = p.hatched()
                shown = some(Shown.Egged((landed, count, p.body.y_rot, p.item.copy())))
            }
        } else if p.xp_bottle {
            // A bottle o' enchanting's (CAL-214): what it hit as a snowball's, then the experience
            // it lets out drawn from its own random, which its level awards away from the face of
            // the block it hit, or back along its way, `ThrownExperienceBottle.onHit`.
            if let landed = p.snowball_hit(f, hit, state) {
                block = landed.entity == none
                let amount = p.bottled()
                let rough = if block { face_normal(p.way.face) } else { (p.body.vx * -1.0, p.body.vy * -1.0, p.body.vz * -1.0) }
                shown = some(Shown.Bottled((landed, amount, rough, p.body.extras.contains("Silent"))))
            }
        } else if let splash = p.hit(f, hit, state) {
            block = splash.block != none
            shown = some(Shown.Splashed(splash))
        }
        let what = shown else return
        // `Projectile.onHit`'s `PROJECTILE_LAND`, made by it (CAL-275): where it hit an entity, at
        // the hit; else at the middle of the block it hit, of its state.
        p.acted.push(land_event(EventSource { id: p.body.id, uuid: some(p.body.uuid), owner: p.owner }, hit, (p.way.bx, p.way.by, p.way.bz), state))
        p.acted_after.push(heard)
        if block and not p.way.border {
            if let missing = struck_missing(f, state, if p.snowball { "a snowball" } else if p.egg { "an egg" } else if p.xp_bottle { "a bottle o' enchanting" } else { "a thrown potion" }) {
                p.acted.push(Acted.Missing(missing))
                p.acted_after.push(heard)
            }
        }
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        self.shown.push(what)
        self.shown_by.push(id)
        self.shown_after.push(heard)
        p.body.removed = true
    }

    // What the thrown potion `p` may hit along its way, `getEntityHitResult`'s candidates (D527),
    // `projectile_targets`, boats and minecarts among them (CAL-417).
    fn thrown_targets(self, p: ThrownItem, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        return self.projectile_targets(p.reach(), p.body.id, p.left_owner, owner, players, true, true)
    }

    // What the fishing hook's hooked in, the entity `id`, is to it (CAL-214): a player of
    // `players`, or an entity of the level; none where it's neither.
    fn hooked_view(self, id: i32, players: List<Follower>) -> Hooked? {
        for pl in players {
            if pl.id == id {
                return some(Hooked { x: pl.x, y: pl.y, z: pl.z, height: pl.height, can: not pl.dead and not pl.spectator })
            }
        }
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let alive = match e {
            Entity.Stand(s) => s.living.alive(),
            Entity.Mob(o) => o.living.alive(),
            _ => true,
        }
        let b = body_of(e.copy())
        return some(Hooked { x: b.x, y: b.y, z: b.z, height: b.height, can: alive and not b.removed })
    }

    /// `FishingHook.pullEntity` of the entity `id` by x, y, z, `setDeltaMovement`, where it's
    /// moved by its level, `canSimulateMovement`, which a player isn't (CAL-214), nor a boat a
    /// player steers, its first rider (CAL-418).
    pub fn pull_entity(mut self, id: i32, x: f64, y: f64, z: f64) {
        if not self.at.contains(id) {
            return
        }
        let riders = self.passengers_of(id)
        let steered = not riders.is_empty() and self.players_in.contains(riders[0])
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(match e {
            Entity.Item(it) => {
                var a = it
                a.body.vx = a.body.vx + x
                a.body.vy = a.body.vy + y
                a.body.vz = a.body.vz + z
                Entity.Item(a)
            },
            Entity.Stand(s) => {
                var a = s
                a.living.body.vx = a.living.body.vx + x
                a.living.body.vy = a.living.body.vy + y
                a.living.body.vz = a.living.body.vz + z
                Entity.Stand(a)
            },
            Entity.Mob(o) => {
                var a = o
                a.living.body.vx = a.living.body.vx + x
                a.living.body.vy = a.living.body.vy + y
                a.living.body.vz = a.living.body.vz + z
                Entity.Mob(a)
            },
            Entity.Fireball(b) => {
                var a = b
                a.body.vx = a.body.vx + x
                a.body.vy = a.body.vy + y
                a.body.vz = a.body.vz + z
                Entity.Fireball(a)
            },
            Entity.Crystal(c) => {
                var a = c
                a.body.vx = a.body.vx + x
                a.body.vy = a.body.vy + y
                a.body.vz = a.body.vz + z
                Entity.Crystal(a)
            },
            Entity.Boat(b) => {
                var a = b
                if not steered {
                    a.body.vx = a.body.vx + x
                    a.body.vy = a.body.vy + y
                    a.body.vz = a.body.vz + z
                }
                Entity.Boat(a)
            },
            Entity.Cart(c) => {
                var a = c
                a.body.vx = a.body.vx + x
                a.body.vy = a.body.vy + y
                a.body.vz = a.body.vz + z
                Entity.Cart(a)
            },
            other => other,
        })
    }

    /// The pierce level of the arrow `id`, `getPierceLevel`, as a shield asks of what it'd block
    /// (CAL-214); none where it isn't an arrow.
    pub fn arrow_pierce(self, id: i32) -> i8? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        return match slot {
            Entity.Arrow(a) => some(a.pierce()),
            _ => none,
        }
    }

    /// What the mob or armor stand `id` uses or holds in its main hand, `getActiveItem`, as a
    /// shield asks of what hits it (CAL-214); none where it's neither or holds nothing.
    pub fn active_item(self, id: i32) -> Tag? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        return match slot {
            Entity.Mob(m) => if m.living.using_item() { m.living.use_item.copy() } else { m.living.equipment[0].copy() },
            Entity.Stand(s) => s.living.equipment[0].copy(),
            _ => none,
        }
    }

    /// Whether the entity `id` is living, a mob or an armor stand, as a riptide's spin asks
    /// (CAL-214).
    pub fn is_living(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(_) => true,
            Entity.Stand(_) => true,
            _ => false,
        }
    }

    /// Whether the entity `id` is an item, as a hook's wear asks (CAL-214).
    pub fn is_item(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Item(_) => true,
            _ => false,
        }
    }

    // What a fishing hook `p` may hit, `FishingHook.canHitEntity` (CAL-214): what a thrown
    // potion may, then the items alive whose boxes meet its reach. The wind charges and large
    // fireballs among them, which it redirects and hooks (CAL-416), and the boats and minecarts,
    // `VehicleEntity.isPickable` (CAL-418).
    fn hook_targets(self, p: ThrownItem, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        let reach = p.reach()
        var out = self.projectile_targets(reach, p.body.id, p.left_owner, owner, players, true, true)
        for found in self.found(reach, p.body.id, 1) {
            let slot = self.all[self.at[found]] else continue
            if let Entity.Item(e) = slot {
                if not e.body.removed {
                    out.push(Target { id: found, bounds: e.body.bounding_box(), x: e.body.x, y: e.body.y, z: e.body.z, player: false })
                }
            }
        }
        return out
    }

    // What the projectile `id` may hit in its reach `reach`, `getEntityHitResult`'s candidates
    // (D527): the armor stands, mobs and end crystals (D591), and where `redirectable` the wind
    // charges and large fireballs (CAL-257), whose boxes meet it, as `found` finds
    // them, then the players of `players` whose boxes do, each alive and pickable,
    // `canBeHitByProjectile`, that it may hit, where it's not left its owner `owner`, `left_owner`,
    // nothing that rides at bottom what they do, `isPassengerOfSameVehicle`: not them, what they
    // ride nor what rides with them (CAL-418); then the ender dragons' parts, `parts_targets`
    // (CAL-167). Where `vehicles`, the boats and minecarts too, `VehicleEntity`'s, for a thrown
    // item, whose hit hurts them (CAL-417).
    fn projectile_targets(self, reach: Aabb, id: i32, left_owner: bool, owner: OwnerView?, players: List<Follower>, redirectable: bool, vehicles: bool) -> List<Target> {
        var out = List<Target>()
        var own_root: i32? = none
        if let o = owner {
            if not left_owner {
                own_root = some(self.root_of(o.id))
            }
        }
        let kinds = (if redirectable { 652 } else { 140 }) | (if vehicles { BOATS | CARTS } else { 0 })
        for found in self.found(reach, id, kinds) {
            if own_root != none and some(self.root_of(found)) == own_root {
                continue
            }
            let slot = self.all[self.at[found]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() {
                        out.push(Target { id: found, bounds: s.living.body.bounding_box(), x: s.living.body.x, y: s.living.body.y, z: s.living.body.z, player: false })
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() {
                        out.push(Target { id: found, bounds: o.living.body.bounding_box(), x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, player: false })
                    }
                },
                Entity.Crystal(c) => {
                    if not c.body.removed {
                        out.push(Target { id: found, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                Entity.Fireball(b) => {
                    // A wind charge or a large fireball, `#redirectable_projectile`, which `isPickable`
                    // makes `canBeHitByProjectile`, for what asks for them (CAL-257).
                    if redirectable and not b.body.removed and (wind_kind(b.kind) or b.kind == LARGE_FIREBALL) {
                        out.push(Target { id: found, bounds: b.body.bounding_box(), x: b.body.x, y: b.body.y, z: b.body.z, player: false })
                    }
                },
                Entity.Boat(b) => {
                    if vehicles and not b.body.removed {
                        out.push(Target { id: found, bounds: b.body.bounding_box(), x: b.body.x, y: b.body.y, z: b.body.z, player: false })
                    }
                },
                Entity.Cart(c) => {
                    if vehicles and not c.body.removed {
                        out.push(Target { id: found, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                _ => {},
            }
        }
        for pl in players {
            if pl.spectator or pl.dead or (own_root != none and some(self.root_of(pl.id)) == own_root) {
                continue
            }
            let b = pl.bounds else continue
            if b.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) {
                out.push(Target { id: pl.id, bounds: b, x: pl.x, y: pl.y, z: pl.z, player: true })
            }
        }
        out.extend(self.parts_targets(reach))
        return out
    }

    // An arrow's tick, at `i` (CAL-159): to its steps, `tick_start`, its owner found among the
    // level's entities and `players` where it's to fly or it's a loyal trident, which comes back
    // to them from the ground (CAL-214), then its steps, `arrow_steps`.
    fn tick_arrow<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        var owner: OwnerView? = none
        if not a.in_ground() or (a.trident and a.loyalty() > 0) {
            owner = self.owner_of(a.owner, players)
        }
        let border = self.border ?? widest_border()
        if a.tick_start(f, m, t, blocks, min_y, fast_lava, owner, border, mut sounds) {
            self.arrow_steps(i, a, owner, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow at `i` after its level dealt the hits it stopped at (CAL-159): landed on the block
    // it struck, where that's what it stopped at, `hit_block`, its state kept as `codecs` save it;
    // its motion to be sent; on through more of its steps where it's still here and pierces, else
    // the end of its tick, `tick_end`, as `stepMoveAndHit`'s loop goes on.
    fn arrow_on<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        if let state = a.block_due.take() {
            if not a.body.removed {
                a.hit_block(state, codecs.state_saved(state), mut sounds)
                a.landed(state, sounds.len())
            }
        }
        a.body.needs_sync = true
        if not a.body.removed and a.pierce() > 0i8 {
            let owner = self.owner_of(a.owner, players)
            self.arrow_steps(i, a, owner, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        a.tick_end(f, t, blocks, min_y, fast_lava, mut sounds)
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow's steps along its way, `stepMoveAndHit` (CAL-159): from where it is, the entities
    // it may hit up to the block its way meets, `Arrow.hits`; it goes to the nearest, or to the
    // block, and what blocks it went through act on it; with an entity to hit, it stops for its
    // level to deal the hits, `Shown.Shot` with them, after its tick's sounds so far, to go on in
    // the next `tick_next`, `arrow_on`; else, where its way met a block that's still there, it
    // lands, `hit_block`, its state kept as `codecs` save it, and what the block would do of it
    // said to be missing; then the end of its tick.
    fn arrow_steps<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, owner: OwnerView?, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        if not a.body.removed {
            let from = (a.body.x, a.body.y, a.body.z)
            let end = (a.way.x, a.way.y, a.way.z)
            let targets = self.targets_of(a, owner, players)
            let hits = a.hits(f, m, blocks, targets, from, end, self.border ?? widest_border())
            if hits.is_empty() {
                a.body.x = a.way.x
                a.body.y = a.way.y
                a.body.z = a.way.z
            } else {
                a.body.x = hits[0].x
                a.body.y = hits[0].y
                a.body.z = hits[0].z
            }
            a.step_acts(f, blocks, from, mut sounds)
            a.step_portal(blocks, sounds.len())
            if hits.is_empty() {
                if not a.body.removed and not a.way.missed and a.way.border {
                    // `hitTargetOrDeflectSelf`: the world border, which it bounces off, not
                    // hitting it, `shouldBounceOnWorldBorder` (CAL-159).
                    a.turn_back()
                    a.body.needs_sync = true
                } else if not a.body.removed and not a.way.missed {
                    let state = blocks.collision_state(a.way.bx, a.way.by, a.way.bz) ?? 0
                    if not f.is_air(state) {
                        if a.struck_by_level(f, state) {
                            // What the block does of it, its level's to deal first,
                            // `Shown.Struck`, after its tick's sounds so far; it lands as it goes
                            // on, `arrow_on` (CAL-159).
                            let id = a.body.id
                            self.keep_acted(id, a.body.bounding_box(), a.acted, a.acted_after)
                            a.acted.clear()
                            a.acted_after.clear()
                            a.block_due = some(state)
                            let struck = a.struck_block(state)
                            let key = section_key(a.body.x, a.body.y, a.body.z)
                            self.all[i] = some(Entity.Arrow(a))
                            self.move_section(id, key)
                            self.shown.push(Shown.Struck(struck))
                            self.shown_by.push(id)
                            self.shown_after.push(sounds.len())
                            self.heard = sounds.len()
                            self.paused_arrow = some(i)
                            return
                        }
                        a.hit_block(state, codecs.state_saved(state), mut sounds)
                        a.landed(state, sounds.len())
                    }
                    a.body.needs_sync = true
                }
            } else if not a.body.removed and not a.body.no_physics {
                let id = a.body.id
                self.keep_acted(id, a.body.bounding_box(), a.acted, a.acted_after)
                a.acted.clear()
                a.acted_after.clear()
                let key = section_key(a.body.x, a.body.y, a.body.z)
                self.all[i] = some(Entity.Arrow(a))
                self.move_section(id, key)
                self.shown.push(Shown.Shot(hits))
                self.shown_by.push(id)
                self.shown_after.push(sounds.len())
                self.heard = sounds.len()
                self.paused_arrow = some(i)
                return
            }
        }
        a.tick_end(f, t, blocks, min_y, fast_lava, mut sounds)
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow `a` back at `i` with its tick done, `heard` its sounds: what blocks did that its
    // level's to do kept with its ID, and it moved into its section, or gone (CAL-159).
    fn arrow_done(mut self, i: usize, arrow: own Arrow, heard: usize) {
        var a = arrow
        let id = a.body.id
        self.keep_acted(id, a.body.bounding_box(), a.acted, a.acted_after)
        a.acted.clear()
        a.acted_after.clear()
        let key = section_key(a.body.x, a.body.y, a.body.z)
        let removed = a.body.removed
        self.all[i] = some(Entity.Arrow(a))
        self.heard = heard
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // Whether the living entity that last hurt `a`, `getLastHurtByMob`, is alive, where it's among
    // the level's mobs and armor stands and not gone (D676); none where it isn't, as a player,
    // whom `players` find.
    fn hurter_alive(self, a: Living) -> bool? {
        let who = a.hurt_by_mob else return none
        if let here = self.living_alive(who) {
            return some(here)
        }
        // Found in another level, `getEntityInAnyDimension`, as its level told it (CAL-200).
        for (u, alive) in self.elsewhere {
            if u == who {
                return some(alive)
            }
        }
        return none
    }

    /// The UUIDs of those who last hurt its mobs and armor stands, `getLastHurtByMob`, that aren't
    /// in this level, which its level looks for in the others (CAL-200).
    pub fn hurters_missing(self) -> List<(i64, i64)> {
        var out = List<(i64, i64)>()
        for slot in self.all {
            let e = slot else continue
            let who = match e {
                Entity.Mob(o) => o.living.hurt_by_mob,
                Entity.Stand(o) => o.living.hurt_by_mob,
                _ => none,
            }
            let u = who else continue
            if self.living_alive(u) == none and not out.contains(u) {
                out.push(u)
            }
        }
        return out
    }

    /// Whether the mob or armor stand of the UUID `who` in this level is alive, none where it
    /// isn't here or is removed.
    pub fn living_alive(self, who: (i64, i64)) -> bool? {
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(o) => {
                    if o.living.body.uuid == who and not o.living.body.removed {
                        return some(o.living.alive())
                    }
                },
                Entity.Stand(o) => {
                    if o.living.body.uuid == who and not o.living.body.removed {
                        return some(o.living.alive())
                    }
                },
                _ => {},
            }
        }
        return none
    }

    // The arrow's owner of the UUID `uuid`, `getOwner`, among `players` and the level's mobs and
    // armor stands (CAL-159): its ID, its box where it may be picked, `CAN_BE_PICKED`, and whether
    // it's a player; where its eyes are, how wide it is and whether a loyal trident may come back
    // to it (CAL-214); none where it isn't found.
    fn owner_of(self, uuid: (i64, i64)?, players: List<Follower>) -> OwnerView? {
        let u = uuid else return none
        for p in players {
            if p.uuid == some(u) {
                var bounds: Aabb? = none
                if not p.spectator {
                    bounds = p.bounds
                }
                return some(OwnerView { id: p.id, bounds: bounds, player: true, team: p.team.copy(), friendly_fire: p.friendly_fire, eye: (p.x, p.y + f64(p.eyes), p.z), returnable: not p.dead and not p.spectator })
            }
        }
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        // An ender dragon's own box can't be picked, `isPickable` (D618).
                        var bounds: Aabb? = none
                        if o.pickable() {
                            bounds = some(o.living.body.bounding_box())
                        }
                        let (bx, by, bz) = (o.living.body.x, o.living.body.y, o.living.body.z)
                        return some(OwnerView { id: o.living.body.id, bounds: bounds, player: false, eye: (bx, by + f64(o.living.body.eyes), bz), width: o.living.body.width, returnable: o.living.alive() })
                    }
                },
                Entity.Stand(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        var bounds: Aabb? = none
                        if not o.marker() {
                            bounds = some(o.living.body.bounding_box())
                        }
                        let (bx, by, bz) = (o.living.body.x, o.living.body.y, o.living.body.z)
                        return some(OwnerView { id: o.living.body.id, bounds: bounds, player: false, eye: (bx, by + f64(o.living.body.eyes), bz), width: o.living.body.width, returnable: o.living.alive() })
                    }
                },
                _ => {},
            }
        }
        return none
    }

    // What the arrow `a` may hit along its way, `findHitEntities`' candidates (CAL-159): the
    // armor stands, mobs and end crystals (D591) whose boxes meet its reach, `Arrow.reach`, as
    // `found` finds them, then the players of `players` whose boxes do (CAL-190), each alive and
    // pickable, `canBeHitByProjectile`, that it may hit, `may_hit`: not a player in its owner's
    // team where that doesn't allow friendly fire, `canHarmPlayer` (CAL-164); then the ender
    // dragons' parts, `parts_targets` (CAL-167). The wind charges and large fireballs among them,
    // `#redirectable_projectile`, which `isPickable` makes `canBeHitByProjectile` (CAL-416), and
    // the boats and minecarts, `VehicleEntity`'s, not gone (CAL-417). Where it hasn't left its
    // owner, nothing that rides at bottom what they do, `isPassengerOfSameVehicle`: not them, what
    // they ride nor what rides with them (CAL-418).
    fn targets_of(self, a: Arrow, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        let reach = a.reach()
        var out = List<Target>()
        var own_root: i32? = none
        if let o = owner {
            if not a.left_owner {
                own_root = some(self.root_of(o.id))
            }
        }
        for id in self.found(reach, a.body.id, 652 | BOATS | CARTS) {
            if own_root != none and some(self.root_of(id)) == own_root {
                continue
            }
            let slot = self.all[self.at[id]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: s.living.body.bounding_box(), x: s.living.body.x, y: s.living.body.y, z: s.living.body.z, player: false })
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: o.living.body.bounding_box(), x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, player: false })
                    }
                },
                Entity.Crystal(c) => {
                    if not c.body.removed and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                Entity.Fireball(b) => {
                    if not b.body.removed and (wind_kind(b.kind) or b.kind == LARGE_FIREBALL) and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: b.body.bounding_box(), x: b.body.x, y: b.body.y, z: b.body.z, player: false })
                    }
                },
                Entity.Boat(b) => {
                    if not b.body.removed and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: b.body.bounding_box(), x: b.body.x, y: b.body.y, z: b.body.z, player: false })
                    }
                },
                Entity.Cart(c) => {
                    if not c.body.removed and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                _ => {},
            }
        }
        for p in players {
            if p.spectator or p.dead or (own_root != none and some(self.root_of(p.id)) == own_root) {
                continue
            }
            let b = p.bounds else continue
            let spared = match owner {
                some(o) => o.player and o.team != none and o.team == p.team and not o.friendly_fire,
                none => false,
            }
            if b.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) and a.may_hit(p.id, true, owner, self.pvp and not spared) {
                out.push(Target { id: p.id, bounds: b, x: p.x, y: p.y, z: p.z, player: true })
            }
        }
        // Then the ender dragons' parts, as `getEntities` finds them after the rest, each that it
        // hasn't pierced already (CAL-167).
        for t in self.parts_targets(reach) {
            if a.may_hit(t.id, false, owner, self.pvp) {
                out.push(t)
            }
        }
        return out
    }

    // The blocks the level sent again since they were last read, as `sendBlockUpdated` takes each:
    // its path type forgotten, and where its shape changed, the paths of the mobs it's near enough
    // found again, `shouldRecomputePath`, in the order the mobs came, which vanilla's
    // `navigatingMobs` holds in no order of its own, finding the same paths in any.
    /// The blocks its level changed so far told the mobs' navigations then and there, as
    /// `sendBlockUpdated` tells them as each block is set, not as the next entity's tick begins: a
    /// wither's breaking of the blocks about it, block by block (CAL-401).
    pub fn renavigate<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32) {
        self.take_sent(lf, f, m, blocks, min_y)
    }

    fn take_sent<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32) {
        let total = blocks.sent_total()
        var i = blocks.sent_first()
        if self.sent_seen > i {
            i = self.sent_seen
        }
        self.sent_seen = total
        if i >= total {
            return
        }
        var going = List<i32>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Mob(mob) = e {
                    if mob.navigating() {
                        going.push(mob.living.body.id)
                    }
                }
            }
        }
        while i < total {
            let b = blocks.sent_at(i)
            i += 1
            self.path_types.invalidate(b.x, b.y, b.z)
            if going.is_empty() or m.same_shape(f, b.old, b.now, b.x, b.z) {
                continue
            }
            for id in going {
                var mob = self.lend_mob(id) else continue
                mob.block_changed(lf, f, m, blocks, mut self.path_types, min_y, b.x, b.y, b.z)
                self.give_back_mob(mob)
            }
        }
    }

    // What holds the leash `l` as its mob's tick finds it (CAL-179): a player among `players` that
    // is the one who held it, else one in another level, away, else gone; or a mob or knot here,
    // else gone. A leash saved, its holder's UUID, finds the player or mob here with it,
    // `getEntity`, none where there's none; a knot's place, the knot there, none where there's
    // none yet.
    fn holding_of(self, leash: Leash?, players: List<Follower>) -> Holding? {
        let l = leash else return none
        if let h = l.holder {
            if h.player {
                for p in players {
                    if p.id == h.id and p.object == h.object {
                        return some(player_holding(h, p))
                    }
                }
                for p in self.away {
                    if p.id == h.id and p.object == h.object {
                        return some(Holding { held: h, here: false, interacts: not p.dead and not p.spectator })
                    }
                }
                return some(Holding { held: h, here: false, interacts: false })
            }
            if self.at.contains(h.id) {
                if let slot = self.all[self.at[h.id]] {
                    if let Entity.Mob(o) = slot {
                        return some(mob_holding(h, o))
                    }
                    if let Entity.Boat(o) = slot {
                        return some(boat_holding(h, o, players))
                    }
                }
                if let k = self.knot_hold(h.id) {
                    return some(k)
                }
            }
            return some(Holding { held: h, here: false, interacts: false })
        }
        let saved = l.saved else return none
        if let Tag.IntArray(v) = saved {
            // A knot's place, the knot there, `getKnot`.
            if v.len() != 3 {
                return none
            }
            let k = self.knot_at((v[0], v[1], v[2])) else return none
            return self.knot_hold(k)
        }
        let Tag.Compound(c) = saved else return none
        let u = uuid_of(c, "UUID") else return none
        for p in players {
            if p.uuid == some(u) {
                return some(player_holding(Held { id: p.id, uuid: u, player: true, object: p.object }, p))
            }
        }
        for slot in self.all {
            let e = slot else continue
            if let Entity.Mob(o) = e {
                if o.living.body.uuid == u and not o.living.body.removed {
                    return some(mob_holding(Held { id: o.living.body.id, uuid: u }, o))
                }
            }
            if let Entity.Boat(o) = e {
                if o.body.uuid == u and not o.body.removed {
                    return some(boat_holding(Held { id: o.body.id, uuid: u }, o, players))
                }
            }
        }
        return none
    }

    // A mob's tick, at `i`: its look at whether it goes, `checkDespawn`, from the nearest of
    // `players` that isn't a spectator, then where it stays and `ticks`, in range, its tick, as an
    // armor stand's (D452). One that goes still ticks then, as `tickNonPassenger` doesn't look
    // whether `checkDespawn` took it: removed, its `aiStep` skipped, and traced, before it's taken
    // away (CAL-303).
    fn tick_mob<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, ticks: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        let nearest = nearest_to(a, players)
        if a.check_despawn(self.peaceful, nearest) {
            a.living.body.removed = true
            if not ticks {
                self.all[i] = some(Entity.Mob(a))
                self.remove(id)
                return
            }
        }
        a.living.body.others = self.mob_boat_boxes(a)
        if not ticks {
            a.living.body.others.clear()
            self.all[i] = some(Entity.Mob(a))
            return
        }
        a.carries_mob = false
        a.controlled = false
        a.vehicle_kind = none
        a.on_warm_strider = false
        if let v = a.living.body.vehicle {
            if self.is_mob(v) {
                let ridden = self.mob(v)
                a.on_warm_strider = ridden.species == STRIDER and not ridden.suffocating()
                a.vehicle_kind = some(String(type_name(ridden.species)))
            }
        }
        if a.living.body.passengers.len() > 0 {
            let first = a.living.body.passengers[0]
            a.carries_mob = self.is_mob(first)
            a.controlled = not a.no_ai() and self.may_steer(first)
        }
        if a.wants_kin() {
            a.kin = self.kin_near(a)
            a.leader_seen = self.leader_of(a)
        }
        // A vex's owner's target, which it may take up, `VexCopyOwnerTargetGoal` (CAL-200).
        a.owner_target = none
        if let o = a.vex_owner {
            if let oid = self.id_with_uuid(o) {
                if self.is_mob(oid) {
                    a.owner_target = self.mob(oid).target
                }
            }
        }
        if a.wants_prey() {
            a.prey = self.prey_near(a, lf)
            // A tame wolf's owner's attacker and what they last hurt, which it may take up
            // however far off in its level, `OwnerHurtByTargetGoal` and `OwnerHurtTargetGoal`
            // (CAL-201).
            if let o = a.owner_in(players) {
                for foe in [o.hurt_by, o.hurt_mob] {
                    let wanted = foe else continue
                    if wanted == id or not self.at.contains(wanted) or a.prey.any(|p| p.id == wanted) {
                        continue
                    }
                    let slot = self.all[self.at[wanted]] else continue
                    let Entity.Mob(m2) = slot else continue
                    a.prey.push(m2.follower())
                }
            }
        } else if not a.prey.is_empty() {
            a.prey = List<Follower>()
        }
        // The game rule first, as a piglin's item sensor reads it (CAL-200).
        a.mob_griefing = self.mob_griefing
        a.tnt_explodes = self.tnt_explodes
        if a.brain != none {
            a.near = self.brain_near(a, lf, players)
            if a.wants_items() {
                a.near_items = self.items_for(a, lf, f, items)
            }
            a.villager_activity = self.villager_activity
            a.baby_activity = self.baby_activity
            a.day = self.day
            if a.dimension != self.dimension {
                a.dimension = self.dimension.copy()
            }
        }
        a.mob_drops = self.mob_drops
        a.entity_drops = self.entity_drops
        if a.leash != none {
            a.holding = self.holding_of(a.leash.copy(), players)
        }
        a.universal_anger = self.universal_anger
        a.forgive_dead_players = self.forgive_dead_players
        a.border = self.border
        a.game_time = self.game_time
        a.hard = self.hard
        a.difficulty = self.difficulty
        if a.species == ENDER_DRAGON {
            self.fight_for(mut a)
        }
        a.living.hurt_by_found = self.hurter_alive(a.living)
        if a.tick_start(lf, f, m, blocks, min_y, mut sounds) {
            // A creeper's explosion, which its level makes before its tick goes on, as vanilla's
            // `explodeCreeper` comes before `super.tick()`: what it showed so far kept, the
            // explosion among it, and it stopped till the next `tick_next` (CAL-182).
            let bred = self.keep_shown(id, mut a)
            self.all[i] = some(Entity.Mob(a))
            self.heard = sounds.len()
            self.paused_start = some((i, bred))
            return
        }
        self.tick_mob_used(i, a, false, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
    }

    // The mob `mob` at `i` after its tick's start, `tick_start`, `bred_before` whether it bred
    // (CAL-182): its tick to its use, `tick_using`, its spear's hits dealt by its level where it
    // has any, then the rest, `tick_mob_on`.
    fn tick_mob_used<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        // A crossbow's use draws from the level's random, and its sounds' flags are the crossbow
        // item's, for every crossbow, lent it (CAL-200).
        let crossbows = a.species == PILLAGER or a.species == PIGLIN
        if crossbows {
            a.level_random = self.level_random.take()
            a.crossbow_sounds = self.crossbow_sounds
        }
        // A parrot's ambient sound draws from the level's random too, `getAmbient` (CAL-201).
        let parrot = a.species == PARROT
        if parrot {
            a.level_random = self.level_random.take()
        }
        a.tick_using(lf, f, m, t, blocks, items, mut self.path_types, players, min_y, fast_lava, mut sounds)
        if crossbows {
            self.level_random = a.level_random.take()
            self.crossbow_sounds = a.crossbow_sounds
        }
        if parrot {
            self.level_random = a.level_random.take()
        }
        if let due = a.stab_due.take() {
            let stabs = self.stabs_of(mut a, due, f, m, blocks, players)
            if not stabs.is_empty() {
                // Its spear's hits, which its level deals before its tick goes on, as vanilla's
                // `damageEntities` is dealt as its use ticks, before its AI: what it showed so far
                // kept, then the hits, and it stopped till the next `tick_next` (CAL-159).
                let bred = self.keep_shown(id, mut a) or bred_before
                self.all[i] = some(Entity.Mob(a))
                self.shown.push(Shown.Stabbed(stabs))
                self.shown_by.push(id)
                self.shown_after.push(sounds.len())
                self.heard = sounds.len()
                self.paused_use = some((i, bred))
                return
            }
        }
        self.tick_mob_on(i, a, bred_before, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
    }

    // The mob `mob` at `i` after its use's tick, `tick_using`, `bred_before` whether it bred
    // (CAL-159): the rest of its tick through its AI, `tick_thinking_on`, then, unless it attacked
    // a player, the rest of its tick.
    fn tick_mob_on<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        // A zombie's goals look for villages' points of interest, its level's lent it for them
        // (D605).
        let villages = a.goes_through_villages()
        if villages {
            a.pois = self.pois.take()
        }
        // A villager's look at the level's raids, and a raider's at its own (CAL-167).
        a.raids_near = if a.species == VILLAGER { self.raids.copy() } else { List<RaidView>() }
        a.raid_view = none
        if let r = a.raid {
            for v in self.raids {
                if v.id == r {
                    a.raid_view = some(v.copy())
                }
            }
        }
        // A raider's banner goal asks of the ominous banners near it (CAL-396).
        if a.raid_view != none or a.banner_item >= 0 {
            self.banner_near(mut a, lf)
        }
        if a.species == ENDER_DRAGON {
            self.crystals_for(mut a)
        }
        // An iron golem's stroll about its village draws from the level's random, as a tame cat's
        // morning gift's chance does (CAL-201).
        // A fox's goals ask of the items within 8 of its box with no pickup delay left that are
        // here, `FoxSearchForItemsGoal`'s `ALLOWED_ITEMS`, and its screech of the players within 16
        // that aren't spectators, `getAmbientSound`, its level finding them for it (CAL-201).
        if a.species == FOX {
            self.fox_near(mut a, players)
        }
        // A sulfur cube's search for items asks of the items within 8 of its box with no pickup
        // delay that it swallows, its `ALLOWED_ITEMS` (CAL-402).
        if a.species == SULFUR_CUBE {
            self.sulfur_near(mut a, lf)
        }
        // A llama's caravan goal asks of the level's llamas, which it lends it (CAL-201).
        if llama_kind(a.species) {
            a.llamas = self.llamas_of()
        }
        // A panda's sitting asks of the food from the ground near it (CAL-201).
        if a.species == PANDA {
            self.panda_near(mut a, lf)
        }
        // A parrot's mimicry and its following ask of the mobs near it, and its mimicry draws from
        // the level's random (CAL-201).
        if a.species == PARROT {
            self.parrot_near(mut a)
        }
        // A dolphin's item goals ask of the items in water near it, its treasure whether its
        // world has structures, and its grace for a swimming player draws from the level's random
        // (CAL-201).
        if a.species == DOLPHIN {
            self.dolphin_near(mut a, players)
        }
        let golem = a.species == IRON_GOLEM or a.species == CAT or a.species == RABBIT or a.species == FOX or a.species == PARROT or a.species == TURTLE or a.species == DOLPHIN or a.zombie_class()
        if golem {
            a.level_random = self.level_random.take()
        }
        let crossbows = a.species == PILLAGER
        if crossbows {
            a.level_random = self.level_random.take()
            a.crossbow_sounds = self.crossbow_sounds
        }
        let entered = a.tick_thinking_on(lf, f, m, blocks, items, mut self.path_types, players, min_y, mut sounds)
        if crossbows {
            self.level_random = a.level_random.take()
            self.crossbow_sounds = a.crossbow_sounds
        }
        if golem {
            self.level_random = a.level_random.take()
        }
        if a.species == ENDER_DRAGON {
            // Its parts as its `aiStep` placed them, and what its wings and head reach (D611).
            self.keep_parts(a)
            self.dragon_strikes(mut a, players, sounds.len())
            // Its word to its fight, once its walls are broken, `updateDragon` (D626).
            var seen = false
            if let dr = a.dragon {
                seen = dr.seen_due
            }
            if seen {
                let progress = a.living.health() / a.living.max_health(lf)
                a.living.show(Shown.DragonSeen(progress), sounds.len())
            }
        }
        if villages {
            self.pois = a.pois.take()
        }
        // Its equipment, as its `aiStep` ticks it (D607).
        if entered {
            self.equipment_tick(mut a.living)
        }
        if not a.attacked() and not a.goals_stopped() {
            self.tick_mob_rest(i, a, entered, bred_before, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
            return
        }
        // Its attack on a player, which its level deals before its tick goes on, as vanilla's
        // `doHurtTarget` is dealt in `serverAiStep`, so its travel and its pushes come after the
        // hit, and don't push a player it killed: what it showed so far kept, and whom its hurt
        // alerts told, and it stopped till the next `tick_next` (CAL-159). So too a silverfish's
        // waking of a friend, which its level breaks then and there, the paths near it, its own
        // among them, found again as `take_sent` takes the block before it goes on (CAL-172).
        let alert = a.alerted
        a.alerted = none
        let shouts = a.shouts.copy()
        a.shouts.clear()
        let shout_box = a.living.body.bounding_box()
        let bred = self.keep_shown(id, mut a) or bred_before
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let within = a.living.attributes.value(lf.follow_range)
        let species = a.species
        self.all[i] = some(Entity.Mob(a))
        self.heard = sounds.len()
        if let target = alert {
            self.alert_others(id, species, ax, ay, az, within, target, players)
        }
        for (target, aggressive) in shouts {
            self.raider_shout(id, ax, ay, az, shout_box, target, aggressive, players)
        }
        self.paused = some((i, entered, bred))
    }

    // The boxes of the ender dragon `a`'s parts kept, its own before put away, and those of
    // dragons gone with them (D610).
    fn keep_parts(mut self, a: Mob) {
        let dr = a.dragon else return
        let own_id = a.living.body.id
        var kept = List<(i32, Aabb)>()
        for (owner, b) in self.dragon_parts {
            if owner != own_id and self.at.contains(owner) {
                kept.push((owner, b))
            }
        }
        for k in 0..PARTS {
            let (x0, y0, z0, x1, y1, z1) = dr.part_box(k)
            kept.push((own_id, Aabb { min_x: x0, min_y: y0, min_z: z0, max_x: x1, max_y: y1, max_z: z1 }))
        }
        self.dragon_parts = kept
    }

    // What the ender dragon `a`'s wings' knockback and its head's and neck's hurt reach of its
    // level in its tick, `heard` its sounds so far (D611): the living entities in their boxes, and
    // the players not in creative or spectating, `NO_CREATIVE_OR_SPECTATOR`, its own parts not
    // living. Its strikes, box by box, its wings' with the middle of its body across, are its
    // level's to deal, `Shown.Beaten` (D615): in each box the mobs and armor stands, as the level
    // finds them (D677), then the players, in the level's order; vanilla has the players among
    // the rest, by the sections they're in, as an explosion's are. Then the breaking of what it
    // flew into, where it would break any, `checkWalls`, which comes after them (D614).
    fn dragon_strikes(self, a: mut Mob, players: List<Follower>, heard: usize) {
        var strikes = List<Aabb>()
        var sitting = false
        var middle = (0.0, 0.0)
        var walls: List<Aabb>? = none
        if let dr = a.dragon {
            strikes = dr.strikes.copy()
            sitting = dr.sitting()
            let body = dr.boxed(BODY)
            middle = ((body.min_x + body.max_x) / 2.0, (body.min_z + body.max_z) / 2.0)
            if dr.walls_due {
                walls = some([dr.boxed(HEAD), dr.boxed(NECK), dr.boxed(BODY)])
            }
        }
        let own_id = a.living.body.id
        var beats = List<Beat>()
        for k in 0..strikes.len() {
            let b = strikes[k]
            let from: (f64, f64)? = if k < 2 { some(middle) } else { none }
            for id in self.find_living(b, own_id) {
                beats.push(Beat { player: id, from: from, sitting: sitting, living: true })
            }
            for p in players {
                if p.spectator or p.creative {
                    continue
                }
                if let pb = p.bounds {
                    if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        beats.push(Beat { player: p.id, from: from, sitting: sitting })
                    }
                }
            }
        }
        if not beats.is_empty() {
            a.living.show(Shown.Beaten(beats), heard)
        }
        if let boxes = walls {
            a.living.show(Shown.Walls(boxes), heard)
            var dr = a.dragon.take() else return
            dr.walls_due = false
            a.dragon = some(dr)
        }
    }

    // What the ender dragon `a` reads of its level's dragon fight as it ticks (D626), told before
    // its tick begins, as its death's tick, `tickDeath`, comes before its `aiStep`, which takes the
    // fight as its own where it's the fight's dragon: whether it is now, `dragonUUID`, the
    // crystals the fight counts alive and whether a dragon was killed in it before.
    fn fight_for(self, a: mut Mob) {
        var dr = a.dragon.take() else return
        dr.ours = self.fight and self.fight_dragon == some(a.living.body.uuid)
        dr.crystals = self.fight_crystals
        dr.killed_before = self.fight_killed_before
        a.dragon = some(dr)
    }

    // What an ender dragon's `checkCrystals` reads of its level, for the dragon `a` (D608): whether
    // the end crystal it had is gone, `isRemoved`, and the nearest end crystal whose box is within
    // 32 of its own, `getEntitiesOfClass`, by `distanceToSqr` from where it is, the first found of
    // any as near.
    fn crystals_for(self, a: mut Mob) {
        var dr = a.dragon.take() else return
        dr.crystal_gone = false
        if let had = dr.nearest_crystal {
            dr.crystal_gone = true
            if self.at.contains(had) {
                if let slot = self.all[self.at[had]] {
                    if let Entity.Crystal(c) = slot {
                        dr.crystal_gone = c.body.removed
                    }
                }
            }
        }
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let area = a.living.body.bounding_box().inflate(32.0, 32.0, 32.0)
        var best = f64.MAX
        var found: i32? = none
        for id in self.found(area, a.living.body.id, 128) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Crystal(c) = slot else continue
            let (dx, dy, dz) = (c.body.x - ax, c.body.y - ay, c.body.z - az)
            let d = dx * dx + dy * dy + dz * dz
            if d < best {
                best = d
                found = some(id)
            }
        }
        dr.found_crystal = found
        a.dragon = some(dr)
    }

    // What the mob `a`'s spear meets as its use ticks, `due` what that asks, among the level's mobs
    // and armor stands and `players`, `KineticWeapon.damageEntities` (CAL-159). Its way, along its
    // head's look from its eyes, from its least reach to its most and its motion along that more,
    // `getHitEntitiesAlong`, meets nothing where a block it collides with comes nearer than its
    // least reach, else ends at such a block. What its way meets, in the order the level finds
    // them, mobs and stands, then players, is what's alive, pickable and not invulnerable, and
    // doesn't ride with it on the same, `isPassengerOfSameVehicle` (CAL-200), whose box is within its margin of the way, there clear of colliding blocks to the box's middle,
    // `getManyEntityHitResult`. Each not hit too lately, `wasRecentlyStabbed`, is kept as hit now,
    // and is hit where what it does holds: its speed along its look, less theirs, at least none,
    // against the spear's conditions at a mob's fifth, `test`; the damage its attack damage's
    // base and the whole of that times the spear's multiplier.
    fn stabs_of<B: CollisionBlocks>(self, a: mut Mob, due: StabDue, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> List<Stab> {
        let me = Stabber { id: a.living.body.id, vehicle: a.living.body.vehicle, mover: a.living.body.mover(), factor: f64(0.2f32) }
        return self.stabs_along(me, mut a.living.recent_stabs, due, f, m, blocks, players)
    }

    /// `stabs_of` of a spear used by `me`, a mob or a player, who keeps what it hit as `kept`
    /// (CAL-214): a player's conditions are tested at their whole, `actionFactor`, and they're not
    /// among the `players` given.
    pub fn stabs_along<B: CollisionBlocks>(self, me: Stabber, kept: mut List<(i32, i64)>?, due: StabDue, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> List<Stab> {
        var out = List<Stab>()
        let (ex, ey, ez) = due.eye
        let (hx, hy, hz) = due.head_look
        let least = due.reach.least
        let from = (ex + hx * least, ey + hy * least, ez + hz * least)
        let (mx, my, mz) = due.movement
        let along = mx * hx + my * hy + mz * hz
        let far = due.reach.most + along.max(0.0)
        var to = (ex + hx * far, ey + hy * far, ez + hz * far)
        let border = self.border ?? widest_border()
        let mover = me.mover
        let way = clip_including_border(f, m, blocks, mover, due.eye, to, border)
        if not way.missed {
            to = (way.x, way.y, way.z)
            if distance_sqr(due.eye, to) < distance_sqr(due.eye, from) {
                return out
            }
        }
        let (fx, fy, fz) = from
        let (tx, ty, tz) = to
        let half = due.reach.margin / 2.0
        var area = Aabb { min_x: fx - half, min_y: fy - half, min_z: fz - half, max_x: fx + half, max_y: fy + half, max_z: fz + half }
        area = expand_towards(area, tx - fx, ty - fy, tz - fz).inflate(1.0, 1.0, 1.0)
        var found = List<(i32, Aabb, bool, (f64, f64, f64))>()
        for id in self.found(area, me.id, 12) {
            let slot = self.all[self.at[id]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() and not s.living.body.invulnerable and s.living.invulnerable_time <= 0 {
                        found.push((id, s.living.body.bounding_box(), false, (s.living.body.known_dx, s.living.body.known_dy, s.living.body.known_dz)))
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() and not o.living.body.invulnerable and o.living.invulnerable_time <= 0 {
                        found.push((id, o.living.body.bounding_box(), false, (o.living.body.known_dx, o.living.body.known_dy, o.living.body.known_dz)))
                    }
                },
                _ => {},
            }
        }
        for p in players {
            if p.spectator or p.dead or p.id == me.id {
                continue
            }
            let b = p.bounds else continue
            if b.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                found.push((p.id, b, true, (p.known_dx, p.known_dy, p.known_dz)))
            }
        }
        let k = due.kinetic
        let (lx, ly, lz) = due.look
        let (sx, sy, sz) = due.speed
        let speed = lx * sx + ly * sy + lz * sz
        let now = self.game_time
        let root = match me.vehicle {
            some(v) => self.root_vehicle(v),
            none => me.id,
        }
        for (id, b, player, known) in found {
            if self.root_vehicle(id) == root {
                continue
            }
            if not meets_way(f, m, blocks, mover, border, b, from, to, due.reach.margin) {
                continue
            }
            if stabbed_lately_in(mut kept, id, now, k.contact_cooldown) {
                continue
            }
            let (kx, ky, kz) = known
            let theirs = lx * (kx * 20.0) + ly * (ky * 20.0) + lz * (kz * 20.0)
            let relative = (speed - theirs).max(0.0)
            let dismounts = match k.dismount { some(c) => c.test(due.ticks, speed, relative, me.factor), none => false }
            let knocks = match k.knockback { some(c) => c.test(due.ticks, speed, relative, me.factor), none => false }
            let hurts = match k.damage { some(c) => c.test(due.ticks, speed, relative, me.factor), none => false }
            if dismounts or knocks or hurts {
                let damage = f32.nearest(due.base_damage) + f32.nearest(floor(relative * f64(k.multiplier)))
                out.push(Stab { target: id, player: player, damage: damage, hurts: hurts, knocks: knocks, dismounts: dismounts })
            }
        }
        return out
    }

    // What the mob `a`, of the ID `id`, showed of its tick kept, `shown`, with its ID and the
    // sounds it came after, and forgotten by it; whether it bred among it (CAL-159).
    fn keep_shown(mut self, id: i32, a: mut Mob) -> bool {
        var bred = false
        for k in 0..a.living.shown.len() {
            if let Shown.Bred(_) = a.living.shown[k] {
                bred = true
            }
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        return bred
    }

    // The rest of the tick of the mob `mob` at `i`, after its goals, `tick_rest`, which `entered`
    // says whether it began, and whether it `bred` before (CAL-159): what it showed kept, whom its
    // hurt alerts told, it moved into its section, and where it's still here, it pushes what its
    // box meets, but where it bred, after the tick list's run past it.
    fn tick_mob_rest<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, entered: bool, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        let brained = a.brain != none
        if brained and a.brain_held() {
            // A brain going on after its level acted for it, as a bite, sees what that did: what
            // died of it isn't alive, `isAlive`, as vanilla's reads it then (CAL-207).
            for k in 0..a.near.len() {
                if a.near[k].alive and self.is_mob(a.near[k].id) and not self.mob_alive(a.near[k].id) {
                    a.near[k].alive = false
                }
            }
        }
        // A bee's drips draw from the level's random too (CAL-177), and a schooling fish's look at its
        // school (CAL-178).
        // A wither's powered heads' particles too (CAL-401).
        let lent = brained or a.species == BEE or schooling_kind(a.species) or a.species == RABBIT or a.species == FOX or a.species == WITHER_BOSS
        if lent {
            a.level_random = self.level_random.take()
        }
        if brained {
            a.pois = self.pois.take()
        }
        // A piglin lets its crossbow go as its brain ticks, its sounds' flags the crossbow item's
        // (CAL-200).
        let crossbows = a.species == PIGLIN
        if crossbows {
            a.crossbow_sounds = self.crossbow_sounds
        }
        var stopped = a.tick_rest(entered, lf, f, m, t, blocks, items, mut self.path_types, players, min_y, fast_lava, mut sounds)
        // A squid stops for its pushes, which come before its own part of `aiStep` (CAL-201).
        var pushed = false
        if stopped and a.squid.push_due {
            self.give_back_mob(a)
            self.push_entities(id, lf, f, blocks, items, players, mut sounds)
            let back = self.lend_mob(id) else return
            a = back
            stopped = a.tick_rest(entered, lf, f, m, t, blocks, items, mut self.path_types, players, min_y, fast_lava, mut sounds)
            pushed = true
        }
        if lent {
            self.level_random = a.level_random.take()
        }
        if crossbows {
            self.crossbow_sounds = a.crossbow_sounds
        }
        if brained {
            self.pois = a.pois.take()
        }
        // A bat ignores block triggers, so its own box isn't counted on a plate (CAL-201).
        self.tramples(mut a.living, a.mob_griefing, a.species == BAT)
        if stopped {
            // Its brain swung a door, which its level swings before its tick goes on, as vanilla
            // sets the block then and there, the paths of the mobs it's near enough found again
            // as `take_sent` takes it: what it showed so far kept, and what it did to others
            // done, and it stopped till the next `tick_next`, knowing what's near it still
            // (CAL-160).
            let told = a.told.copy()
            a.told.clear()
            let bred = self.keep_shown(id, mut a) or bred_before
            self.all[i] = some(Entity.Mob(a))
            self.heard = sounds.len()
            self.tell_others(told, f, mut sounds)
            self.paused = some((i, entered, bred))
            return
        }
        // The end of its kind's `tick`, an allay's vibrations (CAL-275).
        a.tick_end(sounds.len())
        // A warden keeps what's near it for its push after its tick, `doPush` (CAL-207).
        if brained and a.species != WARDEN {
            a.near.clear()
        }
        a.kin.clear()
        let alert = a.alerted
        a.alerted = none
        let told = a.told.copy()
        a.told.clear()
        // A panda that sneezed makes the grown pandas near it jump (CAL-201).
        let sneeze_box = a.living.body.bounding_box().inflate(10.0, 10.0, 10.0)
        let sneezed = a.sneezed
        a.sneezed = false
        // Whether it splits as it's taken out, a slime's `SPLIT_ON_DEATH` (CAL-175).
        var splits = false
        for w in a.living.shown {
            if let Shown.Split(s) = w {
                splits = not s.places.is_empty()
            }
        }
        a.living.body.others.clear()
        let bred = self.keep_shown(id, mut a) or bred_before
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        // A hoglin turned into a zoglin in its tick is taken away as its level makes the zoglin,
        // having pushed what's around it, as `LivingEntity.aiStep` goes on (CAL-200).
        let converting = match a.converted_living {
            some(_) => true,
            none => false,
        }
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let within = a.living.attributes.value(lf.follow_range)
        let species = a.species
        let shouts = a.shouts.copy()
        a.shouts.clear()
        let shout_box = a.living.body.bounding_box()
        self.all[i] = some(Entity.Mob(a))
        self.heard = sounds.len()
        if let target = alert {
            self.alert_others(id, species, ax, ay, az, within, target, players)
        }
        for (target, aggressive) in shouts {
            self.raider_shout(id, ax, ay, az, shout_box, target, aggressive, players)
        }
        if sneezed {
            self.panda_sneezed(id, sneeze_box, lf, f, m, t, blocks)
        }
        self.tell_others(told, f, mut sounds)
        if removed {
            // Gone in its own tick, a silverfish into a block, it's traced as vanilla's agent
            // traces it, its tick done, before it's taken away (CAL-172).
            if self.tracing {
                self.trace_mob(i)
            }
            if splits {
                self.first_rider_off(id)
            }
            if converting {
                self.push_entities(id, lf, f, blocks, items, players, mut sounds)
            } else {
                self.remove(id)
            }
        } else if bred {
            self.move_section(id, key)
            self.push_after = some(id)
        } else {
            self.move_section(id, key)
            if not pushed {
                self.push_entities(id, lf, f, blocks, items, players, mut sounds)
            }
            self.panda_rolls(id)
        }
        if species == IRON_GOLEM and not removed {
            self.golem_anger(id, players)
        }
        if entered and not removed {
            self.loot(id, lf, f, items, mut sounds)
        }
        if self.tracing and not removed {
            self.trace_mob(i)
        }
    }

    // What a mob's behaviors did to others in its tick, `Told`, done in their order (CAL-160): a
    // walk to it set in the brain of the mob it's for, and a villager's gossip with another, where
    // both are here; a cat a phantom fears hissing, heard then, as vanilla's hisses in the
    // phantom's tick (CAL-201).
    fn tell_others(mut self, told: List<Told>, f: Facts, sounds: mut List<EntitySound>) {
        for r in told {
            match r {
                Told.WalkTo(w) => {
                    let (of, to, speed, stop) = w
                    var other = self.lend_mob(of) else continue
                    other.walk_to(to, speed, stop)
                    self.give_back_mob(other)
                },
                Told.Erase(e) => {
                    let (of, memory) = e
                    var other = self.lend_mob(of) else continue
                    other.forget(memory)
                    self.give_back_mob(other)
                },
                Told.JobSite(j) => {
                    let (of, x, y, z, speed) = j
                    var other = self.lend_mob(of) else continue
                    other.take_job_site(x, y, z, speed, self.dimension.copy())
                    self.give_back_mob(other)
                },
                Told.BreedWith(b) => {
                    let (of, with) = b
                    var other = self.lend_mob(of) else continue
                    other.breed_with(with)
                    self.give_back_mob(other)
                },
                Told.Digest(of) => {
                    var other = self.lend_mob(of) else continue
                    other.eat_and_digest(f)
                    self.give_back_mob(other)
                },
                Told.Lead(l) => {
                    let (of, leader) = l
                    var other = self.lend_mob(of) else continue
                    other.leader = some(leader)
                    self.give_back_mob(other)
                },
                Told.Caravan(c) => {
                    let (of, tail) = c
                    var other = self.lend_mob(of) else continue
                    other.caravan_tail = if tail < 0 { none } else { some(tail) }
                    self.give_back_mob(other)
                },
                Told.PatrolTarget(p) => {
                    let (of, x, y, z) = p
                    var other = self.lend_mob(of) else continue
                    other.patrol_target = some((x, y, z))
                    other.patrolling = true
                    self.give_back_mob(other)
                },
                Told.PandaGene(of) => {
                    var other = self.lend_mob(of) else continue
                    other.panda_pick()
                    self.give_back_mob(other)
                },
                Told.Calm(of) => {
                    var other = self.lend_mob(of) else continue
                    other.fox_clear_states()
                    self.give_back_mob(other)
                },
                Told.Hiss(of) => {
                    var other = self.lend_mob(of) else continue
                    other.hiss(mut sounds)
                    self.give_back_mob(other)
                    self.heard = sounds.len()
                },
                Told.School(s) => {
                    let (of, by) = s
                    var other = self.lend_mob(of) else continue
                    other.school_size += by
                    self.give_back_mob(other)
                },
                Told.Gossip(g) => {
                    let (of, with, now) = g
                    var other = self.lend_mob(with) else continue
                    let me = self.lend_mob(of) else {
                        self.give_back_mob(other)
                        continue
                    }
                    var mine = me
                    mine.gossip_with(mut other, now, sounds.len())
                    _ = self.keep_shown(of, mut mine)
                    self.heard = sounds.len()
                    self.give_back_mob(mine)
                    self.give_back_mob(other)
                },
            }
        }
    }

    // The level's llamas as a llama's caravan goal sees them, `CaravanLlama`, in its order
    // (CAL-201).
    fn llamas_of(self) -> List<CaravanLlama> {
        var out = List<CaravanLlama>()
        for slot in self.all {
            let e = slot else continue
            let Entity.Mob(o) = e else continue
            if not llama_kind(o.species) {
                continue
            }
            out.push(CaravanLlama { id: o.living.body.id, x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, bounds: o.living.body.bounding_box(), leashed: o.leashed(), head: o.caravan_head, tail: o.caravan_tail, alive: o.living.alive() })
        }
        return out
    }

    // A panda's food near (CAL-201): the items in its box grown 8 that are here, food from the
    // ground with no pickup delay left, `canPickUpAndEat`, as `getEntitiesOfClass` finds them, by
    // ID, place and box.
    fn panda_near(self, a: mut Mob, lf: LivingFacts) {
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - 8.0, min_y: b.min_y - 8.0, min_z: b.min_z - 8.0, max_x: b.max_x + 8.0, max_y: b.max_y + 8.0, max_z: b.max_z + 8.0 }
        a.panda.foods = List<(i32, f64, f64, f64, Aabb)>()
        for o in self.found(wide, -1, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            if e.body.removed or e.pickup_delay > 0 or e.is_empty() {
                continue
            }
            if lf.tempting.of(held_name(some(e.stack.copy()))) & TEMPT_PANDA_GROUND == 0u64 {
                continue
            }
            a.panda.foods.push((o, e.body.x, e.body.y, e.body.z, e.body.bounding_box()))
        }
    }

    /// The mobs whose boxes meet `b` grown by 20 that a parrot mimics, as `getEntitiesOfClass`
    /// finds them, each one's sound and whether it's silent, as a player's shoulder parrot looks
    /// for them, `Parrot.imitateNearbyMobs` (CAL-201).
    pub fn mimicked_near(self, b: Aabb) -> List<(String, bool)> {
        let wide = Aabb { min_x: b.min_x - 20.0, min_y: b.min_y - 20.0, min_z: b.min_z - 20.0, max_x: b.max_x + 20.0, max_y: b.max_y + 20.0, max_z: b.max_z + 20.0 }
        var out = List<(String, bool)>()
        for o in self.found(wide, -1, 8) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Mob(m2) = slot else continue
            if let sound = parrot_mimic_of(m2.species) {
                out.push((sound, m2.living.silent()))
            }
        }
        return out
    }

    // A parrot's mobs near (CAL-201): the other mobs whose boxes meet its own grown by 20, as
    // `getEntitiesOfClass` finds them, each one's ID and kind, where it is, its eyes' height, its
    // box, and whether it's invisible and silent.
    fn parrot_near(self, a: mut Mob) {
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - 20.0, min_y: b.min_y - 20.0, min_z: b.min_z - 20.0, max_x: b.max_x + 20.0, max_y: b.max_y + 20.0, max_z: b.max_z + 20.0 }
        a.parrot.mobs = List<(i32, i32, f64, f64, f64, f32, Aabb, bool, bool)>()
        a.parrot.looks = List<(f64, f64, f64)>()
        for o in self.found(wide, a.living.body.id, 8) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Mob(m2) = slot else continue
            let invisible = i32(m2.living.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0
            a.parrot.mobs.push((o, m2.species, m2.living.body.x, m2.living.body.y, m2.living.body.z, m2.living.body.eyes, m2.living.body.bounding_box(), invisible, m2.living.silent()))
            a.parrot.looks.push(m2.look.wanted())
        }
    }

    // The grown pandas on the ground, out of water and free to act whose boxes meet the box of the
    // panda `id` grown 10, as `getEntitiesOfClass` finds them, made to jump, `jumpFromGround`, as
    // its sneeze makes them, `afterSneeze` (CAL-201).
    fn panda_sneezed<B: CollisionBlocks>(mut self, id: i32, near: Aabb, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        for other in self.found(near, -1, 8) {
            if other == id {
                continue
            }
            var o = self.lend_mob(other) else continue
            if o.panda_jumps() {
                o.living.jump_from_ground(lf, f, m, t, blocks)
            }
            self.give_back_mob(o)
        }
    }

    // A fox's items and players near (CAL-201): the items in its box grown 8 that are here with no
    // pickup delay left, as `getEntitiesOfClass` finds them, by ID and place; and whether any
    // player that isn't a spectator has a box meeting its own grown 16.
    // The items near the dolphin `a` (CAL-201): those within 8 of its box with no pickup delay
    // left that are here and in water, `Dolphin.ALLOWED_ITEMS`, as `getEntitiesOfClass` finds
    // them; and whether its world has structures.
    fn dolphin_near(self, a: mut Mob, players: List<Follower>) {
        let b = a.living.body.bounding_box()
        // The players steering boats within 5, the first rider of each that's a player,
        // `getControllingPassenger`, for its following of them (CAL-315).
        let near = Aabb { min_x: b.min_x - 5.0, min_y: b.min_y - 5.0, min_z: b.min_z - 5.0, max_x: b.max_x + 5.0, max_y: b.max_y + 5.0, max_z: b.max_z + 5.0 }
        a.dolphin.boats.riders = List<i32>()
        for o in self.found(near, -1, BOATS) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Boat(boat) = slot else continue
            if boat.body.passengers.is_empty() {
                continue
            }
            let first = boat.body.passengers[0]
            for p in players {
                if p.id == first and not p.mob {
                    a.dolphin.boats.riders.push(first)
                }
            }
        }
        // And those steering nautiluses within 5, saddled, the first rider a player,
        // `AbstractNautilus.getControllingPassenger` (CAL-316).
        a.dolphin.nautiluses.riders = List<i32>()
        for o in self.found(near, -1, 8) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Mob(n) = slot else continue
            if not nautilus_kind(n.species) or n.living.equipment[7] == none or n.living.body.passengers.is_empty() {
                continue
            }
            let first = n.living.body.passengers[0]
            for p in players {
                if p.id == first and not p.mob {
                    a.dolphin.nautiluses.riders.push(first)
                }
            }
        }
        let wide = Aabb { min_x: b.min_x - 8.0, min_y: b.min_y - 8.0, min_z: b.min_z - 8.0, max_x: b.max_x + 8.0, max_y: b.max_y + 8.0, max_z: b.max_z + 8.0 }
        a.dolphin.items = List<(i32, f64, f64, f64)>()
        for o in self.found(wide, -1, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            if e.body.removed or e.pickup_delay > 0 or e.is_empty() or not e.body.in_water {
                continue
            }
            a.dolphin.items.push((o, e.body.x, e.body.y, e.body.z))
        }
        a.dolphin.structures = self.structures
    }

    // The ominous banners near the raider `a` (CAL-396), as its `ObtainRaidLeaderBannerGoal` asks:
    // where the banner it goes for is still here, its place; and, where it may pick one up, those
    // within its follow range across and 8 up and down of its box, here, with no pickup delay left,
    // `ALLOWED_ITEMS`, as `getEntitiesOfClass` finds them, by ID and place.
    fn banner_near(self, a: mut Mob, lf: LivingFacts) {
        a.banners = List<(i32, f64, f64, f64)>()
        a.banner_at = none
        let want = a.banner_item
        if want >= 0 and self.at.contains(want) {
            if let slot = self.all[self.at[want]] {
                if let Entity.Item(e) = slot {
                    if not e.body.removed {
                        a.banner_at = some((e.body.x, e.body.y, e.body.z))
                    }
                }
            }
        }
        if a.cannot_pick_up_banner() {
            return
        }
        let follow = a.living.attributes.value(lf.follow_range)
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - follow, min_y: b.min_y - 8.0, min_z: b.min_z - follow, max_x: b.max_x + follow, max_y: b.max_y + 8.0, max_z: b.max_z + follow }
        for o in self.found(wide, -1, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            if e.body.removed or e.pickup_delay > 0 or not is_ominous_banner(e.stack.copy()) {
                continue
            }
            a.banners.push((o, e.body.x, e.body.y, e.body.z))
        }
    }

    // The banner the raider `mob`'s `ObtainRaidLeaderBannerGoal` reached this tick, `item`, picked
    // up, `pickUpItem`, whether it may pick up loot or not (CAL-396): as `raider_pick_up` has it,
    // `onItemPickup` first, taken, `take`, and gone where none's left.
    fn take_banner<W: Wearing>(mut self, mob: mut Mob, item: i32, lf: LivingFacts, items: W, sounds: mut List<EntitySound>) {
        var e = self.lend(item) else return
        if e.body.removed or e.is_empty() {
            self.give_back(e)
            return
        }
        let taken = mob.raider_pick_up(e.stack.copy(), lf, items, mut sounds) else {
            self.give_back(e)
            return
        }
        if let thrower = e.thrower {
            self.thrown_picked.push(ThrownPicked { thrower: thrower, stack: e.stack.copy(), by: mob.loot_entity() })
        }
        mob.living.show(Shown.Picked((item, taken)), sounds.len())
        e.stack = counted(e.stack, e.count() - taken)
        let empty = e.is_empty()
        if empty {
            e.body.removed = true
        }
        self.give_back(e)
        if empty {
            self.heard = sounds.len()
            self.remove(item)
        }
    }

    fn sulfur_near(self, a: mut Mob, lf: LivingFacts) {
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - 8.0, min_y: b.min_y - 8.0, min_z: b.min_z - 8.0, max_x: b.max_x + 8.0, max_y: b.max_y + 8.0, max_z: b.max_z + 8.0 }
        a.sulfur.items = List<(i32, f64, f64, f64)>()
        for o in self.found(wide, -1, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            if e.body.removed or e.pickup_delay > 0 or e.is_empty() {
                continue
            }
            if lf.tempting.of(held_name(some(e.stack.copy()))) & TEMPT_SULFUR_SWALLOWABLE == 0u64 {
                continue
            }
            a.sulfur.items.push((o, e.body.x, e.body.y, e.body.z))
        }
    }

    fn fox_near(self, a: mut Mob, players: List<Follower>) {
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - 8.0, min_y: b.min_y - 8.0, min_z: b.min_z - 8.0, max_x: b.max_x + 8.0, max_y: b.max_y + 8.0, max_z: b.max_z + 8.0 }
        a.fox.items = List<(i32, f64, f64, f64)>()
        for o in self.found(wide, -1, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            if e.body.removed or e.pickup_delay > 0 or e.is_empty() {
                continue
            }
            a.fox.items.push((o, e.body.x, e.body.y, e.body.z))
        }
        let near = Aabb { min_x: b.min_x - 16.0, min_y: b.min_y - 16.0, min_z: b.min_z - 16.0, max_x: b.max_x + 16.0, max_y: b.max_y + 16.0, max_z: b.max_z + 16.0 }
        a.fox.players_near = false
        for p in players {
            if p.mob or p.spectator {
                continue
            }
            if let pb = p.bounds {
                if pb.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
                    a.fox.players_near = true
                }
            }
        }
    }

    // The items near the villager `a` for its brain (CAL-160): those its item sensor looks over,
    // in its box grown 32 across and 16 up and down, as `getEntitiesOfClass` finds them, each with
    // whether it wants it where its sensor's due this tick; then those its memories hold elsewhere,
    // and those gone from the level since, where they were last.
    fn items_for<W: Wearing>(self, a: Mob, lf: LivingFacts, f: Facts, items: W) -> List<Near> {
        let id = a.living.body.id
        let due = a.item_sensor_due()
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - 32.0, min_y: b.min_y - 16.0, min_z: b.min_z - 32.0, max_x: b.max_x + 32.0, max_y: b.max_y + 16.0, max_z: b.max_z + 32.0 }
        var out = List<Near>()
        for o in self.found(wide, id, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            var n = item_near(o, e)
            // A villager's own wants, `Villager.wantsToPickUp`, another's `wantsToPickUp`; and whether
            // piglins love it, which a piglin admires (CAL-200).
            n.wanted = due and (if a.carries_inventory() { a.villager_wants(lf, f, items, e.stack.copy()) } else { a.wants_to_pick_up(lf, f, items, e.stack.copy()) })
            n.loved = lf.piglin_loved.contains(held_name(some(e.stack.copy())))
            out.push(n)
        }
        for w in a.watched() {
            var known = false
            for n in out {
                if n.id == w {
                    known = true
                }
            }
            if known {
                continue
            }
            if self.at.contains(w) {
                if let slot = self.all[self.at[w]] {
                    if let Entity.Item(e) = slot {
                        var n = item_near(w, e)
                        n.loved = lf.piglin_loved.contains(held_name(some(e.stack.copy())))
                        out.push(n)
                    }
                }
                continue
            }
            for n in a.near_items {
                if n.id == w {
                    // Where it went emptied, it holds nothing a piglin loves (CAL-200).
                    var last = n
                    last.gone = true
                    last.wanted = false
                    last.loved = last.loved and not self.was_emptied(w)
                    out.push(last)
                }
            }
        }
        return out
    }

    // `Mob.aiStep`'s looting by the mob `id`, after its pushes (CAL-159): where it `loots`, each
    // item in its `pickup_box`, as `getEntitiesOfClass` finds them, that's still here, isn't empty,
    // has no pickup delay left and it wants, `pickUpItem`: it equips what it may of a copy, and
    // where it equips something, it's taken, `take`, which those who see the item are told, and
    // the item's stack shrinks by as much where it is, which isn't sent, the item gone where none's
    // left. Taking up what a player threw tells them of it, `onItemPickup`, `thrown_picked`
    // (CAL-229).
    fn loot<W: Wearing>(mut self, id: i32, lf: LivingFacts, f: Facts, items: W, sounds: mut List<EntitySound>) {
        var mob = self.lend_mob(id) else return
        if mob.banner_take >= 0 {
            let item = mob.banner_take
            mob.banner_take = -1
            self.take_banner(mut mob, item, lf, items, mut sounds)
        }
        if not mob.loots() {
            _ = self.keep_shown(id, mut mob)
            self.heard = sounds.len()
            self.give_back_mob(mob)
            return
        }
        for item in self.find(mob.pickup_box(), -1) {
            var e = self.lend(item) else continue
            let carries = mob.carries_inventory()
            let fox = mob.species == FOX
            // A panda wants anything, `Mob.canHoldItem`, and takes only food from the ground
            // into an empty hand, whole, `Panda.pickUpItem` (CAL-201); a dolphin anything into an
            // empty hand, whole, `Dolphin.pickUpItem`.
            let panda = mob.species == PANDA
            let dolphin = mob.species == DOLPHIN
            // A sulfur cube a block it swallows, holding none, `SulfurCube.canHoldItem`, one of it
            // taken, `SulfurCube.pickUpItem` (CAL-402).
            let sulfur = mob.species == SULFUR_CUBE
            let wants = if sulfur { mob.sulfur_holds(lf, e.stack.copy()) } else if fox { mob.fox_can_hold(items, e.stack.copy()) } else if panda or dolphin { true } else if carries { mob.villager_wants(lf, f, items, e.stack.copy()) } else { mob.wants_to_pick_up(lf, f, items, e.stack.copy()) }
            if e.body.removed or e.is_empty() or e.pickup_delay > 0 or not wants {
                self.give_back(e)
                continue
            }
            // A villager's into its inventory, `InventoryCarrier.pickUpItem` (CAL-160); another's
            // equipped.
            var taken = 0
            let piglin = mob.species == PIGLIN
            if sulfur {
                if not mob.sulfur_pick_up(lf, e.stack.copy(), mut sounds) {
                    self.give_back(e)
                    continue
                }
                taken = 1
            } else if fox {
                // A fox's own, `Fox.pickUpItem`, which shows its taking itself, of none, and takes
                // it whole (CAL-201).
                mob.fox_pick_up(item, e.stack.copy(), mut sounds)
                taken = e.count()
            } else if panda {
                if not mob.panda_pick_up(lf, e.stack.copy()) {
                    self.give_back(e)
                    continue
                }
                taken = e.count()
            } else if dolphin {
                if not mob.dolphin_pick_up(e.stack.copy()) {
                    self.give_back(e)
                    continue
                }
                taken = e.count()
            } else if raider_kind(mob.species) {
                let took = mob.raider_pick_up(e.stack.copy(), lf, items, mut sounds) else {
                    self.give_back(e)
                    continue
                }
                taken = took
            } else if piglin {
                // A piglin's own, `Piglin.pickUpItem`, which shows its taking itself (CAL-200).
                taken = mob.piglin_pick_up(item, lf, f, items, e.stack.copy(), mut sounds)
            } else if carries {
                taken = mob.pick_up_into(e.stack.copy(), f)
            } else {
                let equipped = mob.equip_if_possible(lf, items, e.stack.copy(), mut sounds) else {
                    self.give_back(e)
                    continue
                }
                taken = count_of(some(equipped))
            }
            // `onItemPickup`, which a villager reaches only where its inventory has room, after
            // which it takes some (CAL-229).
            if let thrower = e.thrower {
                if not carries or taken > 0 {
                    self.thrown_picked.push(ThrownPicked { thrower: thrower, stack: e.stack.copy(), by: mob.loot_entity() })
                }
            }
            if not piglin and not fox {
                mob.living.show(Shown.Picked((item, taken)), sounds.len())
            }
            // A villager's leaves the item's stack as it was, and a piglin's of gold nuggets
            // discards the item whole, `PiglinAi.pickUpItem` (CAL-200).
            let whole = carries or (piglin and held_name(some(e.stack.copy())) == "minecraft:gold_nugget")
            e.stack = counted(e.stack, e.count() - taken)
            let empty = e.is_empty()
            if empty {
                e.body.removed = true
            }
            self.give_back(e)
            if empty {
                self.heard = sounds.len()
                self.remove(item)
                if whole {
                    self.not_emptied(item)
                }
            }
        }
        _ = self.keep_shown(id, mut mob)
        self.heard = sounds.len()
        self.give_back_mob(mob)
    }

    // The line `--entity-trace` writes for the mob or armor stand at `i` as its tick is done
    // (CAL-159), as the rig agent's trace writes vanilla's as `tickNonPassenger` returns: the game
    // time, its ID, its place and motion, its turns, its body's and its head's, what it's told to
    // walk and its speed, and whether it's on the ground.
    fn trace_mob(mut self, i: usize) {
        // A passenger's ride isn't traced, as vanilla's trace runs from `tickNonPassenger` (D708).
        if let ticked = self.ticking {
            let (_, rode) = ticked
            if rode != none {
                return
            }
        }
        let taken = self.all[i].take() else return
        let line = traced(self.game_time, taken, self.trace_controls)
        let path = if self.trace_controls { path_traced(taken) } else { none }
        self.all[i] = some(taken)
        self.trace.push_str(line)
        if let p = path {
            let (id, key, text) = p
            var same = false
            if let was = self.traced_paths.find(id) {
                same = was == key
            }
            if not same {
                self.traced_paths.insert(id, key)
                let time = self.game_time
                self.trace.push_str("P {time} {id} {text}\n")
            }
        }
    }

    // `HurtByTargetGoal.alertOthers` of the mob `id` at x, y, z, of `species`, its follow range
    // `within`, hurt by the player or mob `target` (CAL-159, CAL-244): the mobs of its class whose
    // boxes meet the block's box from its place, `unitCubeFromLowerCorner`, `within` beyond it
    // across and 10 up and down, in `getEntitiesOfClass`' order, but itself, each alerted where it
    // has no target, `alerted_to`, a mob among what it may take up. A zombie's class is the
    // zombies', husks' and zombie villagers', `Zombie`'s, but for the zombified piglins it
    // ignores; a husk's or a zombie villager's its own (CAL-175). A polar bear's only the grown
    // ones, `PolarBearHurtByTargetGoal.alertOther` (CAL-201). No teams, so none are allied.
    fn alert_others(mut self, id: i32, species: i32, x: f64, y: f64, z: f64, within: f64, target: i32, players: List<Follower>) {
        let near = Aabb { min_x: x - within, min_y: y - 10.0, min_z: z - within, max_x: x + 1.0 + within, max_y: y + 1.0 + 10.0, max_z: z + 1.0 + within }
        // A mob that hurt it, as it is to the others, wherever they are (CAL-244).
        var hurter: Follower? = none
        if self.at.contains(target) {
            if let slot = self.all[self.at[target]] {
                if let Entity.Mob(h) = slot {
                    hurter = some(h.follower())
                }
            }
        }
        for other in self.found(near, id, 8) {
            var o = self.lend_mob(other) else continue
            // A panda alerts only the aggressive ones, `PandaHurtByTargetGoal.alertOther` (CAL-201).
            let alike = if species == ZOMBIE { o.zombie_class() and o.species != ZOMBIFIED_PIGLIN } else if species == POLAR_BEAR { o.species == species and not o.baby() } else if species == PANDA { o.species == species and o.panda_aggressive() } else { o.species == species }
            if alike {
                if let h = hurter {
                    var known = false
                    for p in o.prey {
                        known = known or p.id == target
                    }
                    if not known {
                        o.prey.push(h.copy())
                    }
                }
                o.alerted_to(target, players)
            }
            self.give_back_mob(o)
        }
    }

    // `HoldGroundAttackGoal`'s shout of the raider `id` at x, y, z, its box `b` (CAL-167): the
    // raiders whose boxes meet it grown by 8, alive and within 8 of it, `getNearbyEntities` with
    // `shoutTargeting`, each told to take `target`, a mob among what it may take up, and where
    // `aggressive`, to be aggressive.
    fn raider_shout(mut self, id: i32, x: f64, y: f64, z: f64, b: Aabb, target: i32, aggressive: bool, players: List<Follower>) {
        let near = b.inflate(8.0, 8.0, 8.0)
        var hurter: Follower? = none
        if self.at.contains(target) {
            if let slot = self.all[self.at[target]] {
                if let Entity.Mob(h) = slot {
                    hurter = some(h.follower())
                }
            }
        }
        for other in self.found(near, id, 8) {
            var o = self.lend_mob(other) else continue
            let (dx, dy, dz) = (o.living.body.x - x, o.living.body.y - y, o.living.body.z - z)
            if raider_kind(o.species) and o.living.alive() and dx * dx + dy * dy + dz * dz < 64.0 {
                if let h = hurter {
                    var known = false
                    for p in o.prey {
                        known = known or p.id == target
                    }
                    if not known {
                        o.prey.push(h.copy())
                    }
                }
                o.shouted_at(target, aggressive, players)
            }
            self.give_back_mob(o)
        }
    }

    /// `ServerPlayer.tellNeutralMobsThatIDied` of the player of the UUID `uuid`, who died in the
    /// block at x, y, z, where the game rule `forgive_dead_players` has it (CAL-159): the mobs
    /// whose boxes meet the block's box 32 beyond it across and 10 up and down,
    /// `getEntitiesOfClass`, none spectators, each told, `player_died`, as the neutral ones are.
    pub fn tell_player_died(mut self, x: i32, y: i32, z: i32, uuid: (i64, i64)) {
        let near = Aabb { min_x: f64(x) - 32.0, min_y: f64(y) - 10.0, min_z: f64(z) - 32.0, max_x: f64(x) + 33.0, max_y: f64(y) + 11.0, max_z: f64(z) + 33.0 }
        for other in self.found(near, -1, 8) {
            var o = self.lend_mob(other) else continue
            o.player_died(uuid)
            self.give_back_mob(o)
        }
    }

    // The mobs whose boxes meet the box 16 beyond the mob `a`'s on every side, but it, as `found`
    // finds them, as the goals of a mob there read them, `getEntitiesOfClass`'s for its kind
    // within less, and its parent's to 16 away (CAL-158); a cod's with itself among them
    // (CAL-178).
    fn kin_near(self, a: Mob) -> List<Kin> {
        let b = a.living.body.bounding_box()
        let me = a.living.body.id
        let wide = Aabb { min_x: b.min_x - 16.0, min_y: b.min_y - 16.0, min_z: b.min_z - 16.0, max_x: b.max_x + 16.0, max_y: b.max_y + 16.0, max_z: b.max_z + 16.0 }
        // A schooling fish's hold itself, where `getEntitiesOfClass` finds it, lent out of the
        // level as it is (CAL-178), so that the first of a full school may be it (CAL-201).
        let with_me = schooling_kind(a.species)
        var out = List<Kin>()
        for id in self.found(wide, if with_me { -1 } else { me }, if with_me { 8 | LENT } else { 8 }) {
            if id == me {
                if with_me {
                    out.push(self.kin_of_mob(id, a, me, a.living.alive()))
                }
                continue
            }
            let slot = self.all[self.at[id]] else continue
            let Entity.Mob(o) = slot else continue
            out.push(self.kin_of_mob(id, o, me, a.living.alive()))
        }
        return out
    }

    // What the mob `o`, of ID `id`, is to another's goals, `Kin`; `me` the ID of the mob ticking,
    // taken out of the level, and whether it's alive, as a school's leader may be (CAL-178).
    fn kin_of_mob(self, id: i32, o: Mob, me: i32, me_alive: bool) -> Kin {
        var follower = false
        if let l = o.leader {
            follower = if l == me { me_alive } else { self.mob_alive(l) }
        }
        return Kin {
            id: id,
            species: o.species,
            x: o.living.body.x,
            y: o.living.body.y,
            z: o.living.body.z,
            eyes: o.living.body.eyes,
            bounds: o.living.body.bounding_box(),
            age: o.age,
            in_love: o.in_love > 0,
            alive: o.living.alive(),
            panicking: o.goals.panicking(),
            variant: o.breed_variant(),
            school_size: o.school_size,
            follower: follower,
            tame: o.is_tame(),
            sitting: o.in_sitting_pose(),
            collar: o.collar_color(),
            relaxing: o.cat_relaxing(),
            love_cause: o.love_cause(),
            joins_patrol: raider_kind(o.species) and not self.in_active_raid(o),
            horse_parent: o.equine() and o.horse_parent(),
            bases: if o.equine() { o.horse_bases() } else { (0.0, 0.0, 0.0) },
            horse_variant: if llama_kind(o.species) { o.llama_variant() } else if o.species == HORSE { o.horse_variant() } else { 0 },
            strength: if llama_kind(o.species) { o.llama_strength() } else { 0 },
        }
    }

    // `hasActiveRaid` of the raider `o`: whether its raid's active (CAL-167).
    fn in_active_raid(self, o: Mob) -> bool {
        let r = o.raid else return false
        for v in self.raids {
            if v.id == r {
                return v.active
            }
        }
        return false
    }

    // Whether the mob `id` is in the level and alive, `isAlive`: none gone is (CAL-178).
    fn mob_alive(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Mob(o) = slot else return false
        return o.living.alive() and not o.living.body.removed
    }

    // The leader of the schooling fish `a`, as its goals see it this tick, wherever it is in the
    // level; none where it's gone (CAL-178).
    fn leader_of(self, a: Mob) -> Kin? {
        let l = a.leader else return none
        if not self.at.contains(l) {
            return none
        }
        let slot = self.all[self.at[l]] else return none
        let Entity.Mob(o) = slot else return none
        return some(self.kin_of_mob(l, o, a.living.body.id, a.living.alive()))
    }

    // The other mobs the mob `a` may take up as its target this tick, or has as one, or that hurt
    // it, as they are to it (CAL-244): those whose boxes meet its own grown by its follow range
    // each way, as `found` finds them, the level's order, which `getEntitiesOfClass` has; then its
    // target and the mob that hurt it wherever they are in the level, as vanilla holds them, which
    // a target goal may keep or take up out of that reach.
    fn prey_near(self, a: Mob, lf: LivingFacts) -> List<Follower> {
        // An evoker's as far as 16 off, for the vexes it counts and the sheep it may turn red
        // (CAL-200); a wolf's as far as 24, for the llamas it flees, `WolfAvoidEntityGoal`
        // (CAL-201).
        let follow = a.living.attributes.value(lf.follow_range)
        let r = if a.species == EVOKER and follow < 16.0 { 16.0 } else if a.species == WOLF and follow < 24.0 { 24.0 } else { follow }
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - r, min_y: b.min_y - r, min_z: b.min_z - r, max_x: b.max_x + r, max_y: b.max_y + r, max_z: b.max_z + r }
        let me = a.living.body.id
        var ids = self.found(wide, me, 8)
        if let t = a.target {
            if t != me and self.at.contains(t) and not ids.contains(t) {
                ids.push(t)
            }
        }
        if let t = a.owner_target {
            if t != me and self.at.contains(t) and not ids.contains(t) {
                ids.push(t)
            }
        }
        if let w = a.wololo {
            if w != me and self.at.contains(w) and not ids.contains(w) {
                ids.push(w)
            }
        }
        if let who = a.living.hurt_by_mob {
            for slot in self.all {
                let e = slot else continue
                let Entity.Mob(o) = e else continue
                let id = o.living.body.id
                if o.living.body.uuid == who and id != me and not ids.contains(id) {
                    ids.push(id)
                    break
                }
            }
        }
        // A pufferfish's armor stands too, which puff it up, `PufferfishPuffGoal` (CAL-201), and a
        // fox's, which alert it, `FoxAlertableEntitiesSelector` (CAL-311): one seen, not invisible,
        // and no marker, `canBeSeenByAnyone`, else as one dead; one a mob may see as an enemy where
        // it's seen and not invulnerable too, `canBeSeenAsEnemy`.
        if a.species == PUFFERFISH or a.species == FOX {
            for id in self.found(wide, me, 4) {
                if not ids.contains(id) {
                    ids.push(id)
                }
            }
        }
        var out = List<Follower>()
        for id in ids {
            let slot = self.all[self.at[id]] else continue
            if let Entity.Stand(s) = slot {
                let seen = not s.marker() and i32(s.living.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG == 0
                out.push(Follower { id: id, x: s.living.body.x, y: s.living.body.y, z: s.living.body.z, eyes: s.living.body.eyes, spectator: false, dead: not seen, bounds: some(s.living.body.bounding_box()), mob: true, enemy: seen and not s.living.body.invulnerable, height: s.living.body.height })
                continue
            }
            let Entity.Mob(o) = slot else continue
            out.push(o.follower())
        }
        return out
    }

    // What the brain mob `a` reads of the living entities near it this tick, `Near` (CAL-160): the
    // mobs and armor stands whose boxes meet its own grown by its follow range, as `found` finds
    // them, then those its memories hold, `watched`, wherever they are in the level, then the
    // level's players, in their order, which vanilla finds among the rest in their sections
    // (CAL-190).
    fn brain_near(self, a: Mob, lf: LivingFacts, players: List<Follower>) -> List<Near> {
        let id = a.living.body.id
        let follow = a.living.attributes.value(lf.follow_range)
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - follow, min_y: b.min_y - follow, min_z: b.min_z - follow, max_x: b.max_x + follow, max_y: b.max_y + follow, max_z: b.max_z + follow }
        var ids = self.found(wide, id, 12)
        for w in a.watched() {
            if w != id and self.at.contains(w) and not ids.contains(w) {
                ids.push(w)
            }
        }
        for u in a.watched_uuids() {
            if let w = self.id_of_uuid(u) {
                if w != id and not ids.contains(w) {
                    ids.push(w)
                }
            }
        }
        var out = List<Near>()
        for o in ids {
            let slot = self.all[self.at[o]] else continue
            match slot {
                Entity.Mob(e) => {
                    let (profession, xp, site, here, seeks) = e.job_seen(self.dimension)
                    out.push(Near {
                    id: o,
                    uuid: e.living.body.uuid,
                    species: e.species,
                    x: e.living.body.x,
                    y: e.living.body.y,
                    z: e.living.body.z,
                    eyes: e.living.body.eyes,
                    bounds: e.living.body.bounding_box(),
                    alive: e.living.alive() and not e.living.body.removed,
                    // `canBeSeenAsEnemy`: not where it's invulnerable, nor an axolotl playing dead
                    // (CAL-207).
                    enemy: not e.living.body.invulnerable and not e.playing_dead(),
                    baby: e.baby(),
                    undead: e.undead(),
                    panicking: e.panicking(),
                    in_love: e.in_love > 0,
                    variant: e.breed_variant(),
                    horse_parent: e.equine() and e.horse_parent(), sniffer_mates: e.species == SNIFFER and e.sniffer_mates(), frog_food: (e.species == SLIME or e.species == MAGMA_CUBE) and e.slime_size() == 1, last_player: e.living.last_player(),
                    category: e.category,
                    profession: profession,
                    villager_xp: xp,
                    job_site: site,
                    job_site_here: here,
                    seeks_job_site: seeks,
                    through: e.path_about(),
                    food: e.food_points(),
                    sleeping: e.sleeping(),
                    interacting: e.interaction_target(),
                    can_breed: e.can_breed(),
                    villager_type: e.villager_kind(),
                    passenger: e.living.body.vehicle != none,
                    huntable: e.species == HOGLIN and not e.cannot_be_hunted,
                    hunted_recently: e.brain_has(MEMORY_HUNTED_RECENTLY),
                    hurt_by: e.brain_has(MEMORY_HURT_BY),
                    in_water: e.living.body.in_water,
                    head_y_rot: e.living.y_head_rot,
                })
                },
                Entity.Stand(s) => out.push(Near {
                    id: o,
                    uuid: s.living.body.uuid,
                    species: OTHER,
                    x: s.living.body.x,
                    y: s.living.body.y,
                    z: s.living.body.z,
                    eyes: s.living.body.eyes,
                    bounds: s.living.body.bounding_box(),
                    alive: s.living.alive() and not s.living.body.removed,
                }),
                _ => {},
            }
        }
        let kind = i32.wrap(a.living.kind)
        for p in players {
            let point = Aabb { min_x: p.x, min_y: p.y, min_z: p.z, max_x: p.x, max_y: p.y, max_z: p.z }
            out.push(Near {
                id: p.id,
                uuid: p.uuid ?? (0i64, 0i64),
                species: PLAYER,
                x: p.x,
                y: p.y,
                z: p.z,
                eyes: p.eyes,
                bounds: p.bounds ?? point,
                alive: not p.dead,
                visibility: p.visibility(kind),
                spectator: p.spectator,
                sprinting: p.sprinting,
                adventure: p.adventure,
                tempts: p.tempts,
                main_hand: p.main_hand,
                enemy: p.enemy,
                gold_safe: p.gold_safe,
                loved: p.loved,
                hero: p.effects.contains(HERO_OF_THE_VILLAGE),
                in_water: p.in_water,
                creative: p.creative,
                head_y_rot: p.y_rot,
            })
        }
        return out
    }

    /// The bell at the place rung at the game time `now`, its block event's, `updateEntities`
    /// (CAL-160): where it last looked more than 60 ticks before, or never, the living entities
    /// whose boxes meet its block grown 48 each way looked for again, of which only mobs have
    /// brains; then each of those alive and still here within 32 of its middle hears it,
    /// `HEARD_BELL_TIME`. Its block entity's search is kept as long as the level is.
    pub fn hear_bell(mut self, x: i32, y: i32, z: i32, now: i64) {
        let key = BlockPos { x: x, y: y, z: z }.pack()
        var last: (i64, List<i32>)? = none
        if self.bells.contains(key) {
            last = some(self.bells[key].copy())
        }
        var near = List<i32>()
        var fresh = true
        if let (at, ids) = last {
            if now <= at + 60 {
                near = ids.copy()
                fresh = false
            }
        }
        if fresh {
            let (fx, fy, fz) = (f64(x), f64(y), f64(z))
            let b = Aabb { min_x: fx - 48.0, min_y: fy - 48.0, min_z: fz - 48.0, max_x: fx + 49.0, max_y: fy + 49.0, max_z: fz + 49.0 }
            near = self.found(b, -1, 8)
            self.bells.insert(key, (now, near.copy()))
        }
        // `triggerEvent`: its resonance's ticks none, its shaking from the start.
        let resonating = if self.rings.contains(key) { self.rings[key].2 } else { false }
        self.rings.insert(key, (0, true, resonating, 0))
        let (cx, cy, cz) = (f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)
        for id in near {
            var m = self.lend_mob(id) else continue
            let (dx, dy, dz) = (m.living.body.x - cx, m.living.body.y - cy, m.living.body.z - cz)
            if m.living.alive() and not m.living.body.removed and dx * dx + dy * dy + dz * dz < 1024.0 {
                m.hear_bell(now)
            }
            self.give_back_mob(m)
        }
    }

    /// `BellBlockEntity.serverTick` of the bell at x, y, z (CAL-394): where it shakes, its ticks
    /// on, and at 50 it stops; from its fifth, where it hasn't resonated since it was rung and a
    /// raider's within 32 of its middle among those its last search found, alive, it resonates,
    /// its sound due, true; resonating, its ticks on to 40, and then every raider within 48 among
    /// them given glowing for 60 ticks, `makeRaidersGlow`, their IDs in `glow`.
    pub fn tick_bell(mut self, x: i32, y: i32, z: i32, glow: mut List<i32>) -> bool {
        let key = BlockPos { x: x, y: y, z: z }.pack()
        if not self.rings.contains(key) {
            return false
        }
        var (ticks, shaking, resonating, resonation) = self.rings[key]
        if shaking {
            ticks += 1
        }
        if ticks >= 50 {
            shaking = false
            ticks = 0
        }
        let near = if self.bells.contains(key) { self.bells[key].1.copy() } else { List<i32>() }
        var sound = false
        if ticks >= 5 and resonation == 0 and self.raiders_within(near, x, y, z, 1024.0).len() > 0 {
            resonating = true
            sound = true
        }
        if resonating {
            if resonation < 40 {
                resonation += 1
            } else {
                for id in self.raiders_within(near, x, y, z, 2304.0) {
                    glow.push(id)
                }
                resonating = false
            }
        }
        if shaking or resonating {
            self.rings.insert(key, (ticks, shaking, resonating, resonation))
        } else {
            _ = self.rings.remove(key)
        }
        return sound
    }

    // Of the mobs `near`, the raiders alive whose squared distance to the middle of the block x,
    // y, z is under `most`, `isRaiderWithinRange`.
    fn raiders_within(mut self, near: List<i32>, x: i32, y: i32, z: i32, most: f64) -> List<i32> {
        var out = List<i32>()
        let (cx, cy, cz) = (f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)
        for id in near {
            let m = self.lend_mob(id) else continue
            let (dx, dy, dz) = (m.living.body.x - cx, m.living.body.y - cy, m.living.body.z - cz)
            let raider = m.living.alive() and not m.living.body.removed and raider_kind(m.species) and dx * dx + dy * dy + dz * dz < most
            self.give_back_mob(m)
            if raider {
                out.push(id)
            }
        }
        return out
    }

    /// The push of the mob that bred in the entity's tick just done, once the level's made its baby
    /// and orb, which it then meets (D415); what a cramming's hurt shows of it kept to be shown,
    /// with its sounds in `sounds` (CAL-189).
    pub fn push_bred<B: CollisionBlocks + EntityTicking + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, blocks: B, items: W, players: List<Follower>, sounds: mut List<EntitySound>) {
        if let id = self.push_after {
            self.push_after = none
            self.push_entities(id, lf, f, blocks, items, players, mut sounds)
            self.panda_rolls(id)
        }
    }

    // A panda's roll, due after its push, `Panda.tick` (CAL-201).
    fn panda_rolls(mut self, id: i32) {
        var me = self.lend_mob(id) else return
        if me.species == PANDA {
            me.panda_rolls()
        }
        self.give_back_mob(me)
    }

    // `pushEntities` for the mob `id` (CAL-156), which ends its `aiStep` in vanilla and comes here
    // after its tick, as nothing after it there reads its motion but a panda's roll, which comes
    // after it here too, `panda_rolls` (CAL-201): the mobs and the players of
    // `players` whose boxes meet its own that may be pushed, and the boats (CAL-315), `getPushableEntities`, in the order
    // `found` finds them, each in its place in its section, a player among the mobs (CAL-190);
    // where they're as many as the game rule `max_entity_cramming` or more, a draw of 4 from its
    // own random, and on a 0, with as many not riding, `isPassenger`, its hurt by 6 of
    // `cramming`, what it showed kept (CAL-189); then each in turn pushes and is pushed,
    // `doPush`, a player's push kept for the server, `player_pushes` (CAL-174).
    fn push_entities<B: CollisionBlocks + EntityTicking + Warding, W: Wearing>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B, items: W, players: List<Follower>, sounds: mut List<EntitySound>) {
        let me = self.lend_mob(id) else return
        let b = me.living.body.bounding_box()
        // A bat's pushes none, `Bat.pushEntities` (CAL-201).
        let bat = me.species == BAT
        self.give_back_mob(me)
        if bat {
            return
        }
        // Each found, in turn: a mob, or a player, where they are and whether they ride.
        var mobs = List<i32>()
        var order = List<(i32, bool, f64, f64)>()
        var people = 0usize
        var people_riding = 0usize
        var boats = 0usize
        for other in self.found(b, id, 8 | PLAYERS | BOATS | CARTS) {
            if self.players_in.contains(other) {
                for p in players {
                    if p.id != other {
                        continue
                    }
                    if let pb = p.pushable {
                        if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                            order.push((other, true, p.x, p.z))
                            people += 1
                            if p.riding {
                                people_riding += 1
                            }
                        }
                    }
                }
            } else if self.is_boat(other) or self.is_cart(other) {
                boats += 1
                order.push((other, false, 0.0, 0.0))
            } else if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
                order.push((other, false, 0.0, 0.0))
            }
        }
        let n = order.len()
        if n == 0 {
            return
        }
        if self.cramming > 0 and n > usize.wrap(self.cramming - 1) {
            var drawing = self.lend_mob(id) else return
            let crams = drawing.living.body.random.next_int_below(4) == 0
            self.give_back_mob(drawing)
            if crams and self.not_riding(mobs, people, people_riding) + boats > usize.wrap(self.cramming - 1) {
                var hurt = self.lend_mob(id) else return
                hurt.cram(lf, blocks, items, mut sounds)
                _ = self.keep_shown(id, mut hurt)
                self.give_back_mob(hurt)
                self.heard = sounds.len()
            }
        }
        // A vex has no physics through its tick, its push among it, `Vex.tick`, so it pushes and
        // is pushed by none of them then, `Entity.push` (CAL-200).
        let ghost = self.ghost(id, true)
        for (other, player, px, pz) in order {
            if self.mob(id).species == WARDEN {
                self.warden_push(id, other, mut sounds)
            }
            if not player and self.is_cart(other) {
                // `doPush` of a minecart, its `AbstractMinecart.push` of the mob (CAL-315).
                let mb = self.body_at(id) else continue
                self.cart_pushed(other, id, mb.x, mb.z, false)
                continue
            }
            if not player and self.is_boat(other) {
                // `doPush` of a boat, its `AbstractBoat.push` of the mob (CAL-315).
                let mb = self.body_at(id) else continue
                self.boat_push(other, id, mb.bounding_box().min_y, mb.x, mb.z, lf, f, blocks)
                continue
            }
            if not player {
                self.golem_push(id, other, players)
                self.push_pair(id, other, lf, f, blocks)
                continue
            }
            // A parrot doesn't push players, `Parrot.doPush` (CAL-201).
            if self.mob(id).species == PARROT {
                continue
            }
            // `player.push(mob)`: the player, who may be pushed, pushed away from it, then it
            // from them.
            var mover = self.lend_mob(id) else return
            if not mover.living.body.no_physics {
                let pushed = push_between(px, pz, mover.living.body.x, mover.living.body.z)
                if let q = pushed {
                    let (xa, za) = q
                    self.player_pushes.push((other, -xa, -za))
                    let ticking = ticking_at(blocks, mover.living.body.x, mover.living.body.z)
                    if mover.living.body.passengers.is_empty() and mover.pushable(lf, f, blocks, ticking) {
                        mover.living.body.push(xa, 0.0, za)
                    }
                }
            }
            self.give_back_mob(mover)
        }
        if ghost {
            _ = self.ghost(id, false)
        }
    }

    // A warden's `doPush` of `other` (CAL-207), before it pushes it: `warden_pushed`.
    fn warden_push(mut self, id: i32, other: i32, sounds: mut List<EntitySound>) {
        var at: (f64, f64, f64)? = none
        if let b = self.body_at(other) {
            at = some((b.x, b.y, b.z))
        }
        var w = self.lend_mob(id) else return
        w.warden_pushed(other, at, mut sounds)
        self.give_back_mob(w)
    }

    /// Whether the entity `id` ignores an explosion, `ignoreExplosion`: a warden digging or
    /// emerging (CAL-207).
    pub fn ignores_explosion(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Mob(m) = slot else return false
        return m.ignores_explosion()
    }

    /// Whether the entity of the UUID `u` here is living and what a warden may not target,
    /// `canTargetEntity` (CAL-207): an armor stand, a warden, or a mob invulnerable or dead.
    pub fn warden_ignores(self, u: (i64, i64)) -> bool {
        let id = self.id_of_uuid(u) else return false
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Mob(m) => m.species == WARDEN or m.living.body.invulnerable or not m.living.alive(),
            Entity.Stand(_) => true,
            _ => false,
        }
    }

    /// Whether a warden's in the box `b`, `WardenSpawnTracker.hasNearbyWarden` (CAL-207).
    pub fn warden_in(self, b: Aabb) -> bool {
        for slot in self.all {
            let e = slot else continue
            let Entity.Mob(m) = e else continue
            if m.species == WARDEN and not m.living.body.removed and m.living.body.bounding_box().intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                return true
            }
        }
        return false
    }

    /// The copper golems with a chest open, each where it is and the chest, `openedChestPos`
    /// (CAL-317).
    pub fn golem_chests(self) -> List<((f64, f64, f64), (i32, i32, i32))> {
        var out = List<((f64, f64, f64), (i32, i32, i32))>()
        for slot in self.all {
            let e = slot else continue
            let Entity.Mob(m) = e else continue
            if m.species != COPPER_GOLEM or m.living.body.removed {
                continue
            }
            if let c = m.opened_chest {
                out.push(((m.living.body.x, m.living.body.y, m.living.body.z), c))
            }
        }
        return out
    }

    /// The creakings bound to a heart, by ID, each with its heart's place and its UUID (CAL-412).
    pub fn creaking_homes(self) -> List<(i32, (i32, i32, i32), (i64, i64))> {
        var out = List<(i32, (i32, i32, i32), (i64, i64))>()
        for slot in self.all {
            let e = slot else continue
            let Entity.Mob(m) = e else continue
            if m.species != CREAKING or m.living.body.removed {
                continue
            }
            if let home = m.creaking_home() {
                out.push((m.living.body.id, home, m.living.body.uuid))
            }
        }
        return out
    }

    /// Whether the mob `id`'s heart protects it, `isProtector`, as its level found before its tick
    /// (CAL-412).
    pub fn set_heart_protects(mut self, id: i32, protects: bool) {
        var m = self.lend_mob(id) else return
        m.heart_protects = protects
        self.give_back_mob(m)
    }

    /// Whether the entity `id` is a creaking not removed, as a heart finds its creaking by UUID,
    /// `getEntity(uuid) instanceof Creaking` (CAL-412).
    pub fn is_creaking(self, id: i32) -> bool {
        for slot in self.all {
            let e = slot else continue
            let Entity.Mob(m) = e else continue
            if m.living.body.id == id {
                return m.species == CREAKING and not m.living.body.removed
            }
        }
        return false
    }

    // An iron golem's `doPush` of the mob `other` (CAL-201): an enemy but a creeper taken up as its
    // target 1 in 20, drawn, `setTarget`.
    fn golem_push(mut self, id: i32, other: i32, players: List<Follower>) {
        let o = self.lend_mob(other) else return
        let species = o.species
        self.give_back_mob(o)
        if not enemy_kind(species) or species == CREEPER {
            return
        }
        var g = self.lend_mob(id) else return
        if g.species == IRON_GOLEM {
            g.golem_pushed(other, players)
        }
        self.give_back_mob(g)
    }

    // An iron golem's anger kept up, the last of its `aiStep`, after its pushes,
    // `updatePersistentAnger` (CAL-201).
    fn golem_anger(mut self, id: i32, players: List<Follower>) {
        var g = self.lend_mob(id) else return
        g.golem_anger(players)
        self.give_back_mob(g)
    }

    // Whether the mob `id` is a vex, which has no physics through its tick (CAL-200), that set to
    // `on` where it is.
    fn ghost(mut self, id: i32, on: bool) -> bool {
        var m = self.lend_mob(id) else return false
        let vex = m.species == VEX
        if vex {
            m.living.body.no_physics = on
        }
        self.give_back_mob(m)
        return vex
    }

    // `Entity.push(entity)` of the mob `other` by the mob `pusher`: where `other` isn't asleep,
    // `LivingEntity.push` (CAL-160), neither has no physics and they're far enough apart across,
    // each that may be pushed pushed away from the other.
    fn push_pair<B: CollisionBlocks + EntityTicking>(mut self, pusher: i32, other: i32, lf: LivingFacts, f: Facts, blocks: B) {
        // What rides with it, down to what they all ride, isn't pushed by it,
        // `isPassengerOfSameVehicle` (D708).
        if self.root_vehicle(pusher) == self.root_vehicle(other) {
            return
        }
        var a = self.lend_mob(pusher) else return
        var o = self.lend_mob(other) else {
            self.give_back_mob(a)
            return
        }
        if not o.sleeping() and not a.living.body.no_physics and not o.living.body.no_physics {
            let pushed = push_between(o.living.body.x, o.living.body.z, a.living.body.x, a.living.body.z)
            if let q = pushed {
                let (xa, za) = q
                // What something rides isn't moved by a push, `!isVehicle()` (D710).
                let other_ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                if o.living.body.passengers.is_empty() and o.pushable(lf, f, blocks, other_ticks) {
                    o.living.body.push(-xa, 0.0, -za)
                }
                let pusher_ticks = ticking_at(blocks, a.living.body.x, a.living.body.z)
                if a.living.body.passengers.is_empty() and a.pushable(lf, f, blocks, pusher_ticks) {
                    a.living.body.push(xa, 0.0, za)
                }
            }
        }
        self.give_back_mob(o)
        self.give_back_mob(a)
    }

    // How many of the mobs `mobs` and the players, less the `riders` of them riding, aren't riding
    // anything, `isPassenger`, as cramming counts them (CAL-189). `people` is how many players.
    fn not_riding(mut self, mobs: List<i32>, people: usize, riders: usize) -> usize {
        var n = people - riders
        for id in mobs {
            if let m = self.lend_mob(id) {
                if m.living.body.vehicle == none {
                    n += 1
                }
                self.give_back_mob(m)
            }
        }
        return n
    }

    // Whether the mob `id` may be pushed, `isPushable`, as `getPushableEntities` asks.
    fn mob_pushable<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        var m = self.lend_mob(id) else return false
        let ticks = ticking_at(blocks, m.living.body.x, m.living.body.z)
        let p = m.pushable(lf, f, blocks, ticks)
        self.give_back_mob(m)
        return p
    }

    /// A player's `pushEntities` (CAL-156), the player `me` at `x`, `z`, whose box is `b`: the
    /// mobs whose boxes meet it that may be pushed, as `push_entities` finds them, and the other
    /// players of `others`, those the server found may be, each in its place in its section
    /// (CAL-190); each mob pushed away from the player, `mob.push(player)`, where the player has
    /// physics, not a spectator, as `pushes` says, and the player pushed away from it where they
    /// may be, `pushed`, kept in `player_pushes` (CAL-174); each turn, a mob's with the player's
    /// push or a player to push, in `push_turns`, for the server to push the player by in that
    /// order. How many mobs there were, which with the other players are what the cramming
    /// counts, and how many of them don't ride anything, `pushed_not_riding`, which a cramming's
    /// hurt counts (CAL-189). The boats about them are found and counted as mobs are, none riding
    /// anything, and each pushes the player and is pushed as `AbstractBoat.push` has it (CAL-315).
    pub fn pushed_by_player<B: CollisionBlocks + EntityTicking>(mut self, me: i32, x: f64, z: f64, b: Aabb, pushes: bool, pushed: bool, lf: LivingFacts, f: Facts, blocks: B, others: List<i32>) -> usize {
        self.push_turns.clear()
        var mobs = List<i32>()
        var boats = 0usize
        var order = List<(i32, bool)>()
        for other in self.found(b, me, 8 | PLAYERS | BOATS | CARTS) {
            if self.players_in.contains(other) {
                if others.contains(other) {
                    order.push((other, true))
                }
            } else if self.is_boat(other) or self.is_cart(other) {
                boats += 1
                order.push((other, false))
            } else if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
                order.push((other, false))
            }
        }
        self.pushed_not_riding = self.not_riding(mobs.copy(), 0, 0) + boats
        if not pushes {
            return mobs.len() + boats
        }
        for (other, player) in order {
            if player {
                self.push_turns.push((other, true, 0.0, 0.0))
                continue
            }
            if self.is_cart(other) {
                // `minecart.push(player)` (CAL-315): the player's push kept where they may be
                // pushed, in its turn.
                let before = self.player_pushes.len()
                self.cart_pushed(other, me, x, z, true)
                if self.player_pushes.len() > before {
                    let (_, xa, za) = self.player_pushes[self.player_pushes.len() - 1]
                    if pushed {
                        self.push_turns.push((other, false, xa, za))
                    } else {
                        _ = self.player_pushes.pop()
                    }
                }
                continue
            }
            if self.is_boat(other) {
                // `boat.push(player)`: where the player's no higher than its bottom and they don't
                // ride together, each pushed away from the other (CAL-315).
                let ob = self.body_at(other) else continue
                if not (b.min_y <= ob.bounding_box().min_y) or ob.no_physics or self.root_vehicle(other) == self.root_of(me) {
                    continue
                }
                let away = push_between(ob.x, ob.z, x, z) else continue
                let (xa, za) = away
                if ob.passengers.is_empty() {
                    var bt = self.lend_boat(other) else continue
                    bt.body.push(-xa, 0.0, -za)
                    self.give_back_boat(bt)
                }
                if pushed {
                    self.player_pushes.push((me, xa, za))
                    self.push_turns.push((other, false, xa, za))
                }
                continue
            }
            var o = self.lend_mob(other) else continue
            // `mob.push(player)`, which a sleeper doesn't (CAL-160).
            if not o.sleeping() and not o.living.body.no_physics {
                let away = push_between(o.living.body.x, o.living.body.z, x, z)
                if let q = away {
                    let (xa, za) = q
                    let ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                    if o.living.body.passengers.is_empty() and o.pushable(lf, f, blocks, ticks) {
                        o.living.body.push(-xa, 0.0, -za)
                    }
                    if pushed {
                        self.player_pushes.push((me, xa, za))
                        self.push_turns.push((other, false, xa, za))
                    }
                }
            }
            self.give_back_mob(o)
        }
        return mobs.len()
    }

    /// Where the arrows are that aren't gone, which a wooden button's tick looks for in its shape
    /// (CAL-159).
    pub fn arrow_places(self) -> List<(f64, f64, f64)> {
        var out = List<(f64, f64, f64)>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Arrow(a) = e {
                    if not a.body.removed {
                        out.push((a.body.x, a.body.y, a.body.z))
                    }
                }
            }
        }
        return out
    }

    /// Those of its entities whose nether portals take them as their next ticks handle them, as
    /// the level's tick begins: in one last tick and able to go through it, `canUsePortal`, a
    /// nether portal's wait being none for what isn't a player (D578). The server's thread loads
    /// what their ways read as their ticks go; Calcite's tick holds for it as it begins.
    /// The ID of the entity whose tick `tick_next` begins next, of those that came into the level
    /// before `before`, none where it goes on with one it stopped or there's none (D595).
    pub fn next_up(self, before: u64) -> i32? {
        if self.paused != none or self.paused_start != none or self.paused_use != none or self.paused_arrow != none {
            return none
        }
        var place = self.cursor
        while place < self.end {
            if let id = self.tick_list[place] {
                if let e = self.all[self.at[id]] {
                    if entered_of(e) >= before {
                        return none
                    }
                    return some(id)
                }
            }
            place += 1
        }
        return none
    }

    pub fn portals_due(self) -> List<PortalDue> {
        var out = List<PortalDue>()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Item(i) => due_of(mut out, i.body, not i.body.removed),
                Entity.Orb(o) => due_of(mut out, o.body, not o.body.removed),
                Entity.Stand(a) => due_of(mut out, a.living.body, a.living.alive() and a.living.sleeping == none),
                Entity.Mob(m) => due_of(mut out, m.living.body, m.living.alive() and m.living.sleeping == none),
                Entity.Arrow(a) => due_of(mut out, a.body, not a.body.removed),
                Entity.Thrown(p) => due_of(mut out, p.body, true),
                Entity.Cloud(_) => {},
                Entity.Crystal(c) => due_of(mut out, c.body, not c.body.removed),
                Entity.Eye(_) => {},
                Entity.Fireball(b) => due_of(mut out, b.body, not b.body.removed),
                Entity.Tnt(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Falling(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Boat(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Cart(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Knot(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Hanging(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Fangs(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Bolt(p) => due_of(mut out, p.body, not p.body.removed),
            }
        }
        return out
    }

    /// The ender pearls among the pearls of the player of the serial `serial`, not gone, in its
    /// order, `getEnderPearls` (D580): what's saved of each, `saveAsPassenger`, and its ID.
    pub fn pearls_of(self, serial: i64) -> List<(i32, Tag)> {
        var out = List<(i32, Tag)>()
        if serial == 0 {
            return out
        }
        for slot in self.all {
            let e = slot else continue
            if let Entity.Thrown(p) = e {
                if p.pearl and not p.body.removed and p.registered == serial {
                    out.push((p.body.id, p.saved()))
                }
            }
        }
        return out
    }

    /// Those of its thrown items and arrows whose nether portals would take them in their own
    /// steps this tick, which go the tick they come into one, as `portals_due` lists those
    /// already in one (D579): each run ahead on a copy as the level's tick begins, its move
    /// among `blocks` as they are then, what entities it'd hit passed over, where its way takes
    /// it into a portal while its cooldown's out. So the server's tick holds for what their
    /// ways read too, which vanilla's thread loads as their ticks take them.
    pub fn portals_coming<B: CollisionBlocks + Rain + Gateways>(self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool) -> List<PortalDue> {
        var out = List<PortalDue>()
        let border = self.border ?? widest_border()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Thrown(p) => {
                    if not p.body.removed {
                        var ahead = p.copy()
                        var heard = List<EntitySound>()
                        ahead.tick_start(f, m, blocks, border, 0)
                        ahead.go(f, blocks, none, mut heard)
                        due_of(mut out, ahead.body, true)
                    }
                },
                Entity.Arrow(a) => {
                    if not a.body.removed and not a.in_ground() {
                        var ahead = a.copy()
                        var heard = List<EntitySound>()
                        if ahead.tick_start(f, m, t, blocks, min_y, fast_lava, none, border, mut heard) {
                            let from = (ahead.body.x, ahead.body.y, ahead.body.z)
                            ahead.body.x = ahead.way.x
                            ahead.body.y = ahead.way.y
                            ahead.body.z = ahead.way.z
                            ahead.step_acts(f, blocks, from, mut heard)
                            due_of(mut out, ahead.body, true)
                        }
                    }
                },
                _ => {},
            }
        }
        return out
    }

    /// The pushes players took since they were last taken, `player_pushes`, which are then
    /// forgotten (CAL-174).
    /// What players threw that mobs took up, since this was last asked (CAL-229).
    pub fn take_thrown_picked(mut self) -> List<ThrownPicked> {
        let out = self.thrown_picked.copy()
        self.thrown_picked.clear()
        return out
    }

    pub fn take_player_pushes(mut self) -> List<(i32, f64, f64)> {
        let out = self.player_pushes.copy()
        self.player_pushes.clear()
        return out
    }

    // What blocks did to the item or orb `id` that its level's to do (D435), kept as what a living
    // entity shows is: redstone ore lit, and what's missing; a snowflake powder snow may show,
    // drawn from the level's random then and there, `snowflake` (D698); a pressure plate gone into,
    // with what's on it then, the entity's own box `boxed` among them, `plate_counts` (D701).
    fn keep_acted(mut self, id: i32, boxed: Aabb, acted: List<Acted>, after: List<usize>) {
        self.keep_acted_as(id, boxed, false, acted, after)
    }

    // As `keep_acted`, of a minecart where `cart`: a detector rail gone into is pressed by its own
    // box `boxed` too, as by the other minecarts on it then, `carts_in` (CAL-315).
    fn keep_acted_as(mut self, id: i32, boxed: Aabb, cart: bool, acted: List<Acted>, after: List<usize>) {
        for k in 0..acted.len() {
            let shown = match acted[k] {
                Acted.Plate(at) => Shown.Plate((at, self.plate_counts(at, id, some(boxed), false), self.event_source(id))),
                Acted.Tripwire(at) => Shown.Tripwire(at),
                Acted.Dripleaf(at) => Shown.Dripleaf(at),
                Acted.Rail(at) => Shown.Rail((at, self.carts_in(at, id, if cart { some(boxed) } else { none }))),
                Acted.Snow(at) => Shown.Snow((at, self.snowflake())),
                Acted.Honey(at) => Shown.Honey((at, self.honey_draws())),
                Acted.Bubbles(at) => Shown.Bubbles((at, self.bubble_draws())),
                Acted.Melted(at) => Shown.Melted(at),
                Acted.Lit(at) => Shown.Lit(at),
                Acted.SensorStep(stepped) => Shown.SensorStep(stepped),
                Acted.Pressed(at) => Shown.Pressed((at, self.event_source(id))),
                Acted.Missing(what) => Shown.Missing(what.copy()),
                Acted.Event(n) => Shown.Event(n),
                Acted.GameEvent((event, at, state, by_owner)) => Shown.GameEvent((event.copy(), at, state, if by_owner { self.owner_source(id) } else { self.event_source(id) })),
                Acted.GameEventBy((event, at, state, by)) => Shown.GameEvent((event.copy(), at, state, by)),
                Acted.GameEventByRider((event, at)) => Shown.GameEvent((event.copy(), at, none, self.rider_source(id))),
                Acted.Travel(way) => Shown.Travel(way.copy()),
                Acted.Gateway(g) => Shown.Gateway(g),
                Acted.Moved(m) => Shown.Moved(m),
                Acted.Doused(at) => Shown.Doused(at),
                Acted.Emptied(s) => Shown.Emptied(s.copy()),
                Acted.Dropped(s) => Shown.Dropped(s.copy()),
                Acted.ChestSpilled(s) => Shown.ChestSpilled(s.copy()),
                Acted.Leashed(holder) => Shown.Leashed(holder),
                Acted.Hopper(at) => Shown.Hopper(at),
                Acted.CartPull(at) => Shown.CartPull(at),
                Acted.CartCommand => Shown.CartCommand,
                Acted.CartSpawner => Shown.CartSpawner,
                Acted.KnotLeft(knot) => Shown.KnotLeft(knot),
                Acted.Check => Shown.Check,
                Acted.Redirected(r) => Shown.Redirected(r),
            }
            self.shown.push(shown)
            self.shown_by.push(id)
            self.shown_after.push(after[k])
        }
    }

    // `EntityEquipment.tick`, in `LivingEntity.aiStep`, for the mob's or armor stand's `living`
    // (D607): each stack of its equipment, by `EquipmentSlot`'s order, a lodestone compass's
    // tracker ticked, `CompassItem.inventoryTick`, the stack changed in place where its target's
    // gone, which `detectEquipmentUpdates` finds in its next tick; a target whose chunk's points
    // of interest aren't read yet asked for, `poi_asks`. A map's, `MapItem.inventoryTick`, draws
    // only for a player, so a mob's does nothing (CAL-167). Calcite ticks it as the rest of
    // `aiStep` ends, which nothing between reads.
    fn equipment_tick(mut self, living: mut Living) {
        var ticks = false
        for s in living.equipment {
            let item = stack_item(s.copy())
            if item == "minecraft:compass" {
                ticks = true
            }
        }
        if not ticks {
            return
        }
        let pois = self.pois.take() else return
        for slot in 0..living.equipment.len() {
            let stack = living.equipment[slot].copy()
            match lodestone_tick(stack.copy(), self.dimension.copy(), pois) {
                TrackerTick.Lost(s) => living.equipment[slot] = some(s),
                TrackerTick.Unknown(c) => self.poi_asks.push(c),
                TrackerTick.Kept => {},
            }
        }
        self.pois = some(pois)
    }

    // An armor stand's tick, at `i`: what it showed kept with its ID, and it gone where its tick
    // took it away, below the level or broken (D441); its equipment ticked where it's still
    // there (D607).
    fn tick_stand<B: CollisionBlocks + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, stand: own ArmorStand, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = stand
        a.living.hurt_by_found = self.hurter_alive(a.living)
        a.tick(lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
        let griefing = self.mob_griefing
        let marker = a.marker()
        self.tramples(mut a.living, griefing, marker)
        if not a.living.body.removed {
            self.equipment_tick(mut a.living)
        }
        let id = a.living.body.id
        for k in 0..a.living.shown.len() {
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        self.all[i] = some(Entity.Stand(a))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
            if self.tracing {
                self.trace_mob(i)
            }
        }
    }

    // An item's tick, at `i`: to where it merges, its merging, then the rest; what blocks did
    // that its level's to do kept with its ID (D435).
    fn tick_item<B: CollisionBlocks + EntityTicking + Rain + Gateways, S: StackSizes + Wearing>(mut self, i: usize, item: own ItemEntity, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        var e = item
        // The boats about it, which it collides with as it moves and is stuck in, `canBeCollidedWith`
        // (CAL-315).
        e.body.others = self.boat_boxes_near(e.body)
        e.tick_moving(f, m, t, types, codecs, blocks, min_y, fast_lava, mut sounds)
        e.body.others.clear()
        if let landed = e.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = e.body.id
        self.keep_acted(id, e.body.bounding_box(), e.acted, e.acted_after)
        e.acted.clear()
        e.acted_after.clear()
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let due = e.merge_due and e.mergable(codecs.stack_most(e.stack))
        let removed = e.body.removed
        self.all[i] = some(Entity.Item(e))
        if not removed {
            self.move_section(id, key)
        }
        self.heard = sounds.len()
        if due {
            self.merge_near(i, codecs)
        }
        var after = self.lend(id) else return
        after.tick_after(f, t, blocks, fast_lava, mut sounds)
        let done = after.body.removed
        self.give_back(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    /// `Block.pushEntitiesUp` of what's in the way of `slab`, the part a block grows by, as
    /// farmland turns to dirt (CAL-160): each entity whose box meets it, in the order they're
    /// found, moved up by what a move down from a block above it leaves, `Shapes.collide`,
    /// `teleportRelative`, its place where it was last tick too, as `snapTo` sets it.
    pub fn push_up(mut self, slab: Aabb) {
        for id in self.find_every(slab, -1) {
            self.lift(id, slab.max_y)
        }
    }

    /// A shulker box's lid opening into the box `b`, `moveCollidedEntities` (D695): each entity
    /// whose box meets it, as `getEntities(null, b)` finds them, moved by dx, dy, dz,
    /// `Entity.move(MoverType.SHULKER_BOX, ...)`, but those a piston ignores,
    /// `PushReaction.IGNORE_ENTITY`, clouds and marker armor stands: an armor stand's and a mob's
    /// moves as their own are, their steps among `sounds`, what landing on farmland and turtle eggs
    /// does kept with what they show, as `tramples` keeps it; an arrow's falling again where it's
    /// in the ground with nothing around, `shoved`; the rest's moves, farmland drawing as they land
    /// on it, and what isn't alive landing or bouncing heard, `HIT_GROUND` and `BOUNCE` (CAL-426).
    /// Each is moved into the section it's in then.
    pub fn lid_push<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, b: Aabb, dx: f64, dy: f64, dz: f64, fast_lava: bool, sounds: mut List<EntitySound>) {
        for id in self.found(b, -1, PUSHED) {
            self.shove(lf, f, m, t, blocks, id, dx, dy, dz, fast_lava, mut sounds)
        }
    }

    /// A moving piston's push, `p` (CAL-445), its shape's boxes `boxes` from its block's corner,
    /// the top of the block it moves `top`, in the tick `now`: `moveCollidedEntities`, each entity
    /// in the way, as `getEntities(null, push_area)` finds them, but those a piston ignores, as
    /// `lid_push` finds them, bounced its way by a slime block where its own side has the say,
    /// then pushed as far as `push_by` says, `moveEntityByPiston`, `piston_shove`; one in a
    /// piston's own base going back in put out of it again, `fixEntityWithinPistonBase`,
    /// `base_push`. Then `moveStuckEntities`: what a honey block going across carries along,
    /// `carried`, those in its `stuck_area` found first, moved as far as it goes.
    pub fn piston_push<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, p: PistonPush, boxes: List<Aabb>, top: f64, now: i64, fast_lava: bool, sounds: mut List<EntitySound>) {
        if let area = push_area(boxes, p) {
            for id in self.found(area, -1, PUSHED) {
                let had = self.body_at(id) else continue
                if self.ignores_pistons(id) {
                    continue
                }
                var body = had
                if p.bounce and body.owned {
                    let (sx, sy, sz) = (step_x(p.movement), step_y(p.movement), step_z(p.movement))
                    if p.movement == EAST or p.movement == WEST {
                        body.vx = f64(sx)
                    } else if p.movement == UP or p.movement == DOWN {
                        body.vy = f64(sy)
                    } else {
                        body.vz = f64(sz)
                    }
                    self.put_body(id, body.copy())
                }
                let delta = push_by(boxes, p, body.bounding_box()) else continue
                self.piston_shove(lf, f, m, t, blocks, id, p.movement, delta, p.movement, now, fast_lava, mut sounds)
                if p.fix_base {
                    let after = self.body_at(id) else continue
                    if let back = base_push(p, after.bounding_box()) {
                        self.piston_shove(lf, f, m, t, blocks, id, p.movement, back, opposite(p.movement), now, fast_lava, mut sounds)
                    }
                }
            }
        }
        if p.sticky {
            let area = stuck_area(p, top)
            var stuck = List<i32>()
            for id in self.found(area, -1, PUSHED) {
                let body = self.body_at(id) else continue
                if not self.ignores_pistons(id) and honey_carries(p, area, body.on_ground, body.support, body.x, body.z) {
                    stuck.push(id)
                }
            }
            for id in stuck {
                self.piston_shove(lf, f, m, t, blocks, id, p.movement, p.delta, p.movement, now, fast_lava, mut sounds)
            }
        }
    }

    // `moveEntityByPiston`: the entity `id` moved `delta` the way `along` goes, a piston's push,
    // `MoverType.PISTON`, cut by `piston_limit`, its moving blocks going `noclip`'s way not met as it
    // goes, `NOCLIP` (CAL-445). What it moves through acts on it with what it moves next tick, where
    // vanilla's `applyEffectsFromBlocks` acts at once.
    fn piston_shove<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, id: i32, noclip: i32, delta: f64, along: i32, now: i64, fast_lava: bool, sounds: mut List<EntitySound>) {
        let had = self.body_at(id) else return
        var body = had
        let (dx, dy, dz) = push_step(along, delta)
        var go: (f64, f64, f64)? = some((dx, dy, dz))
        if not body.no_physics {
            go = body.piston_limit(dx, dy, dz, now)
        }
        let (gx, gy, gz) = go else {
            self.put_body(id, body)
            return
        }
        body.noclip = noclip
        self.put_body(id, body)
        self.shove(lf, f, m, t, blocks, id, gx, gy, gz, fast_lava, mut sounds)
        let moved = self.body_at(id) else return
        var after = moved
        after.noclip = -1
        self.put_body(id, after)
    }

    // Whether a piston ignores the entity `id`, `PushReaction.IGNORE_ENTITY`: a marker armor
    // stand, of those `PUSHED` finds (CAL-445).
    fn ignores_pistons(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let e = self.all[self.at[id]] else return false
        return match e {
            Entity.Stand(a) => a.marker(),
            _ => false,
        }
    }

    // One entity's push by dx, dy, dz, as `lid_push` and `piston_shove` move each, moved into the
    // section it's in then.
    fn shove<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, id: i32, dx: f64, dy: f64, dz: f64, fast_lava: bool, sounds: mut List<EntitySound>) {
        let griefing = self.mob_griefing
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        var fell: f64? = none
        let pushed = match taken {
            Entity.Stand(a) => {
                var it = a
                if not it.marker() {
                    it.living.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
                    self.tramples(mut it.living, griefing, false)
                    for k in 0..it.living.shown.len() {
                        self.shown.push(it.living.shown[k].copy())
                        self.shown_by.push(id)
                        self.shown_after.push(it.living.shown_after[k])
                    }
                    it.living.shown.clear()
                    it.living.shown_after.clear()
                }
                Entity.Stand(it)
            },
            Entity.Mob(mob) => {
                var it = mob
                it.living.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
                let bat = it.species == BAT
                self.tramples(mut it.living, griefing, bat)
                _ = self.keep_shown(id, mut it)
                Entity.Mob(it)
            },
            Entity.Arrow(a) => {
                var it = a
                it.shoved(f, m, t, blocks, dx, dy, dz)
                Entity.Arrow(it)
            },
            Entity.Item(e) => {
                var it = e
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, false, mut sounds)
                Entity.Item(it)
            },
            Entity.Orb(o) => {
                var it = o
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Orb(it)
            },
            Entity.Thrown(p) => {
                var it = p
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Thrown(it)
            },
            Entity.Crystal(c) => {
                var it = c
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Crystal(it)
            },
            Entity.Eye(e) => {
                var it = e
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Eye(it)
            },
            Entity.Fireball(fb) => {
                var it = fb
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Fireball(it)
            },
            Entity.Tnt(p) => {
                var it = p
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, false, mut sounds)
                Entity.Tnt(it)
            },
            Entity.Knot(p) => {
                var it = p
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Knot(it)
            },
            Entity.Hanging(p) => {
                var it = p
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Hanging(it)
            },
            Entity.Fangs(p) => {
                var it = p
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Fangs(it)
            },
            Entity.Bolt(p) => {
                var it = p
                it.body.move_by(f, m, t, blocks, dx, dy, dz)
                fell = landed_on_farmland(mut it.body)
                self.pushed_acts(id, mut it.body, f, t, blocks, true, mut sounds)
                Entity.Bolt(it)
            },
            other => other,
        }
        if let landed = fell {
            _ = self.farmland_draw(landed)
        }
        let (x, y, z) = place_of(pushed)
        self.all[i] = some(pushed)
        self.move_section(id, section_key(x, y, z))
    }

    // What a push does that's heard of what isn't alive, `body` after its `move_by` (CAL-426): its
    // `HIT_GROUND` where it landed from a fall and its `BOUNCE`, `moved_acts`, as `Entity.move` posts
    // them, `checkFallDamage` and `restituteMovementAfterCollisions`, kept as what it shows.
    fn pushed_acts<B: CollisionBlocks>(mut self, id: i32, body: mut Body, f: Facts, t: BodyFacts, blocks: B, plays: bool, sounds: mut List<EntitySound>) {
        var acted = List<Acted>()
        var after = List<usize>()
        for (a, heard) in body.moved_acts(f, t, blocks, plays, mut sounds) {
            acted.push(a.copy())
            after.push(heard)
        }
        self.keep_acted(id, body.bounding_box(), acted, after)
    }

    // The entity `id` moved up by `1 + offset`, `offset` a move down of 1 from a block above
    // stopped at `top`, as `pushEntitiesUp` moves it; moved into the section it's in now.
    fn lift(mut self, id: i32, top: f64) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        let lifted = match taken {
            Entity.Item(e) => {
                var it = e
                lift_body(mut it.body, top)
                Entity.Item(it)
            },
            Entity.Orb(o) => {
                var it = o
                lift_body(mut it.body, top)
                Entity.Orb(it)
            },
            Entity.Stand(a) => {
                var it = a
                lift_body(mut it.living.body, top)
                Entity.Stand(it)
            },
            Entity.Mob(m) => {
                var it = m
                lift_body(mut it.living.body, top)
                Entity.Mob(it)
            },
            Entity.Arrow(a) => {
                var it = a
                lift_body(mut it.body, top)
                Entity.Arrow(it)
            },
            Entity.Thrown(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Thrown(it)
            },
            Entity.Cloud(c) => {
                var it = c
                lift_body(mut it.body, top)
                Entity.Cloud(it)
            },
            Entity.Crystal(c) => {
                var it = c
                lift_body(mut it.body, top)
                Entity.Crystal(it)
            },
            Entity.Eye(e) => {
                var it = e
                lift_body(mut it.body, top)
                Entity.Eye(it)
            },
            Entity.Fireball(b) => {
                var it = b
                lift_body(mut it.body, top)
                Entity.Fireball(it)
            },
            Entity.Tnt(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Tnt(it)
            },
            Entity.Falling(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Falling(it)
            },
            Entity.Boat(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Boat(it)
            },
            Entity.Cart(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Cart(it)
            },
            Entity.Knot(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Knot(it)
            },
            Entity.Hanging(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Hanging(it)
            },
            Entity.Fangs(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Fangs(it)
            },
            Entity.Bolt(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Bolt(it)
            },
        }
        let (x, y, z) = place_of(lifted)
        self.all[i] = some(lifted)
        self.move_section(id, section_key(x, y, z))
    }

    // `FarmlandBlock.fallOn`'s draw from the level's random for what landed on farmland, `fell`
    // up, in its tick, as its move's done (CAL-160): whether the draw's under its fall less a
    // half, so a living entity big enough would trample it.
    // `PowderSnowBlock.entityInside`'s snowflake, from the level's random for what moved in powder
    // snow (D698): whether it comes, `nextBoolean`, and where it does, its motion across each way,
    // `Mth.randomBetween(random, -1, 1) * 0.083333336F`, x first.
    fn snowflake(mut self) -> (f32, f32)? {
        let lent = self.level_random.take() else return none
        var r = lent
        var out: (f32, f32)? = none
        if r.next_boolean() {
            let sx = (r.next_float() * 2.0f32 - 1.0f32) * 0.083333336f32
            let sz = (r.next_float() * 2.0f32 - 1.0f32) * 0.083333336f32
            out = some((sx, sz))
        }
        self.level_random = some(r)
        return out
    }

    // `HoneyBlock.maybeDoSlideEffects`' draws from the level's random for what slid down a honey
    // block (D699): whether its slide's sound comes, 1 in 5, then whether its entity event does.
    fn honey_draws(mut self) -> (bool, bool)? {
        let lent = self.level_random.take() else return none
        var r = lent
        let heard = r.next_int_below(5) == 0
        let event = r.next_int_below(5) == 0
        self.level_random = some(r)
        return some((heard, event))
    }

    // `Entity.sendBubbleColumnParticles`' draws from the level's random for the top of a bubble
    // column (D700): twice a splash's place across and then a bubble's, each x then z.
    fn bubble_draws(mut self) -> List<(f64, f64)> {
        var out = List<(f64, f64)>()
        let lent = self.level_random.take() else return out
        var r = lent
        for _ in 0..4 {
            let x = r.next_double()
            let z = r.next_double()
            out.push((x, z))
        }
        self.level_random = some(r)
        return out
    }

    fn farmland_draw(mut self, fell: f64) -> bool {
        let lent = self.level_random.take() else return false
        var r = lent
        let trampled = f64(r.next_float()) < fell - 0.5
        self.level_random = some(r)
        return trampled
    }

    // `FarmlandBlock.fallOn` for the farmland `living` landed on in its tick, `Shown.Trampled`, each
    // in its place among what it showed, so its level turns it to dirt before what the fall's hurt
    // shows (CAL-160, CAL-172): a draw from the level's random under the fall, less a half,
    // `farmland_draw`, kept as whether it tramples it, where it's big enough; and where it does
    // and mob griefing lets it, `canTrample`, it's pushed up onto the dirt's top then and there,
    // as vanilla's move pushes it, before its trace; what else is in the way is pushed as its
    // level turns the farmland to dirt. A snowflake powder snow may show, `Shown.Snow`, is drawn
    // the same, in its place, `snowflake` (D698), and a pressure plate gone into, with what's on it
    // then, `plate_counts`, `living` among them but where it's a marker armor stand, `marker`
    // (D701).
    fn tramples(mut self, living: mut Living, griefing: bool, marker: bool) {
        for k in 0..living.shown.len() {
            if let Shown.Plate((at, _, by)) = living.shown[k] {
                let boxed: Aabb? = if marker { none } else { some(living.body.bounding_box()) }
                living.shown[k] = Shown.Plate((at, self.plate_counts(at, living.body.id, boxed, true), by))
            }
            // A detector rail gone into, with whether minecarts are on it then (CAL-315).
            if let Shown.Rail((at, _)) = living.shown[k] {
                living.shown[k] = Shown.Rail((at, self.carts_in(at, living.body.id, none)))
            }
            // A snowflake powder snow may show, drawn in its place among the rest (D698).
            if let Shown.Snow((at, _)) = living.shown[k] {
                living.shown[k] = Shown.Snow((at, self.snowflake()))
            }
            // A honey block's slide sound and entity event, drawn the same (D699).
            if let Shown.Honey((at, _)) = living.shown[k] {
                living.shown[k] = Shown.Honey((at, self.honey_draws()))
            }
            // A bubble column's splashes and bubbles, drawn the same (D700).
            if let Shown.Bubbles((at, _)) = living.shown[k] {
                living.shown[k] = Shown.Bubbles((at, self.bubble_draws()))
            }
            if let Shown.Trampled((fell, x, y, z, big)) = living.shown[k] {
                let trampled = self.farmland_draw(fell) and big
                living.shown[k] = Shown.Trampled((fell, x, y, z, trampled))
                let top = f64(y) + 1.0
                if trampled and griefing and living.body.y < top {
                    lift_body(mut living.body, top)
                }
            }
        }
    }

    // An orb's tick, at `i`: to where it looks for orbs to take in, its look, then the rest; what
    // blocks did that its level's to do kept with its ID, and its sounds heard (D435).
    fn tick_orb<B: CollisionBlocks + EntityTicking + Rain + Gateways>(mut self, i: usize, orb: own ExperienceOrb, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var o = orb
        o.tick_start(f, m, t, types, blocks, min_y, fast_lava)
        let id = o.body.id
        let due = o.merge_due
        self.all[i] = some(Entity.Orb(o))
        if due {
            self.scan_merges(id)
        }
        var after = self.lend_orb(id) else return
        after.tick_rest(f, m, t, types, blocks, players, self.away, mut sounds)
        if let landed = after.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let done = after.body.removed
        self.keep_acted(id, after.body.bounding_box(), after.acted, after.acted_after)
        after.acted.clear()
        after.acted_after.clear()
        self.give_back_orb(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    // `scanForMerges` for the orb `id`: each orb it may take in whose box meets its own, half a
    // block bigger each way, found first, then taken in in the order they were found.
    fn scan_merges(mut self, id: i32) {
        let me = self.orb_view(id) else return
        let b = me.body.bounding_box()
        let near = Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.5, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.5, max_z: b.max_z + 0.5 }
        var found = List<i32>()
        for other in self.find_orbs(near, id) {
            let o = self.orb_view(other) else continue
            if me.takes_in(o) {
                found.push(other)
            }
        }
        for other in found {
            var into = self.lend_orb(id) else return
            var from = self.lend_orb(other) else {
                self.give_back_orb(into)
                continue
            }
            into.take_in(mut from)
            self.give_back_orb(into)
            self.give_back_orb(from)
            self.remove(other)
        }
    }

    /// Ends a tick: the empty places go once there are as many as entities.
    pub fn end_tick(mut self) {
        self.cursor = 0
        self.end = 0
        self.heard = 0
        if self.empty > 16 and self.empty > self.at.len() {
            self.compact()
        }
        if self.tick_empty > 16 and self.tick_empty > self.tick_place.len() {
            self.compact_tick_list()
        }
    }

    // Drops the tick list's empty places, keeping the order.
    fn compact_tick_list(mut self) {
        var kept = List<i32?>()
        self.tick_place.clear()
        for slot in self.tick_list {
            if let id = slot {
                self.tick_place.insert(id, kept.len())
                kept.push(some(id))
            }
        }
        self.tick_list = kept
        self.tick_empty = 0
    }

    /// `mergeWithNeighbours` of the item `id` where it's mergable, `isMergable`, as `teleport`
    /// merges an item a nether portal took (D578).
    pub fn merge_item<S: StackSizes>(mut self, id: i32, codecs: S) {
        if not self.mergable(id, codecs) {
            return
        }
        let i = self.at[id]
        self.merge_near(i, codecs)
    }

    // `mergeWithNeighbours` for the item at `i`: each mergable item whose box meets its own, 0.5
    // bigger across, in the order they're found, until it's gone.
    fn merge_near<S: StackSizes>(mut self, i: usize, codecs: S) {
        let (id, near) = self.near_box(i) else return
        var found = List<i32>()
        for other in self.find(near, id) {
            if self.mergable(other, codecs) {
                found.push(other)
            }
        }
        for other in found {
            if not self.mergable(other, codecs) {
                continue
            }
            self.try_merge(id, other, codecs)
            if not self.at.contains(id) {
                break
            }
        }
    }

    // The ID of the item at `i` and its box, 0.5 bigger across, `inflate(0.5, 0, 0.5)`.
    fn near_box(self, i: usize) -> (i32, Aabb)? {
        let slot = self.all[i] else return none
        let Entity.Item(e) = slot else return none
        let b = e.body.bounding_box()
        return some((e.body.id, Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.0, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.0, max_z: b.max_z + 0.5 }))
    }

    fn mergable<S: StackSizes>(self, id: i32, codecs: S) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Item(e) = slot else return false
        return e.mergable(codecs.stack_most(e.stack))
    }

    // `tryToMerge`: for the same target, and stacks that fit together, the one with fewer goes
    // into the other, or this one into the other where they've as many.
    fn try_merge<S: StackSizes>(mut self, id: i32, other: i32, codecs: S) {
        let order = self.merge_order(id, other, codecs)
        if order == 1 {
            self.merge_into(id, other, codecs)
        } else if order == 2 {
            self.merge_into(other, id, codecs)
        }
    }

    // Which way `tryToMerge` merges: 0 not at all, 1 `other` into `id`, 2 `id` into `other`.
    fn merge_order<S: StackSizes>(self, id: i32, other: i32, codecs: S) -> i32 {
        let sa = self.all[self.at[id]] else return 0
        let sb = self.all[self.at[other]] else return 0
        let Entity.Item(a) = sa else return 0
        let Entity.Item(b) = sb else return 0
        if a.target != b.target {
            return 0
        }
        if b.count() + a.count() > codecs.stack_most(b.stack) {
            return 0
        }
        if not same_components(some(a.stack.copy()), some(b.stack.copy())) {
            return 0
        }
        return if b.count() < a.count() { 1 } else { 2 }
    }

    // `merge`: as much of `from`'s stack as fits, to 64, goes to `to`'s, which keeps the longer
    // pickup delay and the younger age; `from` goes if it's none left.
    fn merge_into<S: StackSizes>(mut self, to: i32, from: i32, codecs: S) {
        var source = self.lend(from) else return
        var target = self.lend(to) else {
            self.give_back(source)
            return
        }
        let most = min(codecs.stack_most(target.stack), 64)
        let moving = min(most - target.count(), source.count())
        target.stack = counted(target.stack, target.count() + moving)
        target.stack_changed = true
        // `shrink`: the stack changes where it is, which isn't sent.
        source.stack = counted(source.stack, source.count() - moving)
        if source.pickup_delay > target.pickup_delay {
            target.pickup_delay = source.pickup_delay
        }
        if source.age < target.age {
            target.age = source.age
        }
        let empty = source.is_empty()
        if empty {
            source.body.removed = true
        }
        self.give_back(target)
        self.give_back(source)
        if empty {
            self.remove(from)
        }
    }

    // Moves the entity `id` to the section `key` if it isn't in it, last there, as `onMove` does.
    fn move_section(mut self, id: i32, key: i64) {
        if self.section_of.contains(id) {
            let old = self.section_of[id]
            if old == key {
                return
            }
            self.out_of_section(id, old)
        }
        self.into_section(id, key)
    }

    fn into_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            self.sections.insert(key, List<i32>())
            let k = section_chunk(key).pack()
            if not self.chunk_sections.contains(k) {
                self.chunk_sections.insert(k, List<i64>())
            }
            self.chunk_sections[k].push(key)
        }
        self.sections[key].push(id)
        self.section_of.insert(id, key)
    }

    fn out_of_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            return
        }
        var kept = List<i32>()
        for other in self.sections[key] {
            if other != id {
                kept.push(other)
            }
        }
        if kept.is_empty() {
            _ = self.sections.remove(key)
            let k = section_chunk(key).pack()
            if self.chunk_sections.contains(k) {
                var left = List<i64>()
                for other in self.chunk_sections[k] {
                    if other != key {
                        left.push(other)
                    }
                }
                if left.is_empty() {
                    _ = self.chunk_sections.remove(k)
                } else {
                    self.chunk_sections.insert(k, left)
                }
            }
        } else {
            self.sections.insert(key, kept)
        }
    }

    // Drops the empty places, keeping the order.
    fn compact(mut self) {
        var kept = List<Entity?>()
        self.at.clear()
        for i in 0..self.all.len() {
            if let e = self.all[i].take() {
                self.at.insert(id_of(e), kept.len())
                kept.push(some(e))
            }
        }
        self.all = kept
        self.empty = 0
    }
}

// Whether the chunk at x, z ticks its entities, `isPositionEntityTicking`.
fn ticking_at<B: EntityTicking>(blocks: B, x: f64, z: f64) -> bool {
    return blocks.ticks_entities(i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
}

// The entity's ID.
// The body `b` an ender pearl took to x, y, z, as `Entities.pearl_take` puts it (D585): there and
// there last tick, where it was last known forgotten, still, nothing moved this tick and nothing
// fallen, at its own yaw and pitch. What the pearl took, those that see it told at once where
// `told`.
fn pearl_set(b: mut Body, x: f64, y: f64, z: f64, told: bool) -> PearlTaken {
    b.x = x
    b.y = y
    b.z = z
    b.last_known = none
    b.xo = x
    b.yo = y
    b.zo = z
    b.vx = 0.0
    b.vy = 0.0
    b.vz = 0.0
    b.moves.clear()
    b.fall = 0.0
    return PearlTaken { y_rot: b.y_rot, x_rot: b.x_rot, on_ground: b.on_ground, told: told }
}

/// `addTag` or `removeTag` (CAL-165) of what has the tags saved as `saved`, `Tags`, none where it
/// has none: its tags, `entityTags`, a `HashSet` made as loading makes it, `tags.addAll`; adding,
/// not where it has 1024 or has the tag already, else the tag added, `add`; taking away, where
/// it has it, `remove`. Then as they're saved, as the set goes over them, `List.copyOf`, or
/// none where there are none, after whether it changed.
pub fn tag_change(saved: Tag?, name: String, add: bool) -> (bool, Tag?) {
    var set = JavaHashSet<String>()
    if let Tag.List(items) = saved {
        for t in items {
            if let Tag.Str(s) = t {
                set.insert(s.copy())
            }
        }
    }
    if add {
        if set.len() >= 1024 or set.contains(name) {
            return (false, none)
        }
        set.insert(name.copy())
    } else {
        if not set.contains(name) {
            return (false, none)
        }
        set.remove(name)
    }
    var out = List<Tag>()
    for s in set {
        out.push(Tag.Str(s.copy()))
    }
    if out.is_empty() {
        return (true, none)
    }
    return (true, some(Tag.List(out)))
}

/// The equipment's place, as `slot_names` orders it, of the slot `item` numbers `slot`,
/// `LivingEntity.getEquipmentSlot` (CAL-165): the main hand 98, the offhand 99, the feet, legs,
/// chest and head 100 to 103, the body 105 and the saddle 106; none for another.
pub fn worn_index(slot: i32) -> usize? {
    if slot == 98 or slot == 99 {
        return some(usize.wrap(slot - 98))
    }
    if slot >= 100 and slot <= 103 {
        return some(usize.wrap(slot - 98))
    }
    if slot == 105 or slot == 106 {
        return some(usize.wrap(slot - 99))
    }
    return none
}

// `getEquipmentSlotForItem` of the mob `m` for `stack` (CAL-165): its equippable's slot where it
// may use it, `canUseSlot`, else the main hand's.
fn mob_slot_for<W: Wearing>(m: Mob, items: W, stack: Tag) -> usize {
    let Tag.Compound(e) = items.worn_component(stack, String("minecraft:equippable")) ?? Tag.End else return 0
    let Tag.Str(named) = (if e.contains("slot") { e["slot"].copy() } else { Tag.End }) else return 0
    let names = slot_names()
    for i in 0..names.len() {
        if names[i] == named {
            return if m.may_use_slot(i) { i } else { 0 }
        }
    }
    return 0
}

// `Entity.lookAt` of the living entity `l` toward `at`, from its feet or, where `at` says, its eyes
// (CAL-165): turned with `Mth.atan2`, its pitch kept within a right angle, `setXRot`, its head
// turned to its yaw, `setYHeadRot`, and that turn its last tick's too.
fn look_toward(l: mut Living, at: (f64, f64, f64, bool)) {
    let (px, py, pz, eyes) = at
    let (pitch, yaw) = look_angles(l.body, px, py, pz, eyes)
    l.body.x_rot = (pitch % 360.0f32).max(-90.0f32).min(90.0f32)
    l.body.y_rot = yaw
    l.y_head_rot = yaw
    l.x_rot_o = l.body.x_rot
    l.y_rot_o = l.body.y_rot
}

// `l` turned as `rotate` turns it (CAL-165): by `turn`, `forceSetRotation`, its head with it,
// `setYHeadRot`, its last tick's turns the same, `setOldRot`; or toward `look`, `look_toward`.
fn turn_living(l: mut Living, turn: (f32, bool, f32, bool)?, look: (f64, f64, f64, bool)?) {
    if let (y_rot, y_relative, x_rot, x_relative) = turn {
        let (y, x) = forced_turn(l.body.y_rot, l.body.x_rot, y_rot, y_relative, x_rot, x_relative)
        l.body.y_rot = y
        l.y_head_rot = y
        l.body.x_rot = x
        l.x_rot_o = x
        l.y_rot_o = y
    }
    if let at = look {
        look_toward(mut l, at)
    }
}

/// The yaw and pitch `forceSetRotation` turns one turned `y_rot` and `x_rot` to, each added to
/// its own where it's relative, `PositionMoveRotation.calculateAbsolute`, the pitch within 90 of
/// level, then again as `setXRot` keeps it (CAL-165).
pub fn forced_turn(own_y_rot: f32, own_x_rot: f32, y_rot: f32, y_relative: bool, x_rot: f32, x_relative: bool) -> (f32, f32) {
    let y = (if y_relative { own_y_rot } else { 0.0f32 }) + y_rot
    let summed = (if x_relative { own_x_rot } else { 0.0f32 }) + x_rot
    let clamped = if summed < -90.0f32 { -90.0f32 } else { summed.min(90.0f32) }
    let x = (clamped % 360.0f32).max(-90.0f32).min(90.0f32)
    return (y, x)
}

// The pitch and yaw `Entity.lookAt` turns `b` to, to look at `px`, `py`, `pz` from its feet or its
// eyes, `eyes`, `EntityAnchorArgument.Anchor.apply` (CAL-165), each wrapped, `Mth.wrapDegrees`, its
// radians made degrees by `RAD_TO_DEG` as vanilla folds it, not by 180 over pi in doubles.
fn look_angles(b: Body, px: f64, py: f64, pz: f64, eyes: bool) -> (f32, f32) {
    let xd = px - b.x
    let yd = py - (b.y + (if eyes { f64(b.eyes) } else { 0.0 }))
    let zd = pz - b.z
    let sd = (xd * xd + zd * zd).sqrt()
    let pitch = wrap_degrees(f32.nearest(-((table_atan2(yd, sd) ?? 0.0) * RAD_TO_DEG)))
    let yaw = wrap_degrees(f32.nearest((table_atan2(zd, xd) ?? 0.0) * RAD_TO_DEG) - 90.0f32)
    return (pitch, yaw)
}

// The living entity `l` an ender pearl took to x, y, z, as `pearl_set` puts its body (D585), its
// head turned to its yaw, `setYHeadRot`, its yaw and pitch last tick its own, `setOldRot`, and its
// impulse forgotten, `resetCurrentImpulseContext`; those that see it aren't told at once.
fn pearl_set_living(l: mut Living, x: f64, y: f64, z: f64) -> PearlTaken {
    let taken = pearl_set(mut l.body, x, y, z, false)
    l.y_head_rot = l.body.y_rot
    l.y_rot_o = l.body.y_rot
    l.x_rot_o = l.body.x_rot
    l.impulse_grace = 0
    l.impulse_at = none
    return taken
}

fn id_of(e: Entity) -> i32 {
    return match e {
        Entity.Item(i) => i.body.id,
        Entity.Orb(o) => o.body.id,
        Entity.Stand(a) => a.living.body.id,
        Entity.Mob(m) => m.living.body.id,
        Entity.Arrow(a) => a.body.id,
        Entity.Thrown(p) => p.body.id,
        Entity.Cloud(c) => c.body.id,
        Entity.Crystal(c) => c.body.id,
        Entity.Eye(eye) => eye.body.id,
        Entity.Fireball(b) => b.body.id,
        Entity.Tnt(p) => p.body.id,
        Entity.Falling(p) => p.body.id,
        Entity.Boat(p) => p.body.id,
        Entity.Cart(p) => p.body.id,
        Entity.Knot(p) => p.body.id,
        Entity.Hanging(p) => p.body.id,
        Entity.Fangs(p) => p.body.id,
        Entity.Bolt(p) => p.body.id,
    }
}

// Where the entity is.
// How far `body` fell onto farmland in the move it just made, where it did, given up, as
// `FarmlandBlock.fallOn` draws for it then (D695).
// A projectile's `PROJECTILE_LAND`, made by `by` (CAL-275): at `hit` where it hit an entity, else
// at the middle of the block `at` of the state `state`.
fn land_event(by: EventSource, hit: ThrownHit?, at: (i32, i32, i32), state: u32) -> Acted {
    if let h = hit {
        return Acted.GameEventBy((String("minecraft:projectile_land"), (h.x, h.y, h.z), none, by))
    }
    let (bx, ay, bz) = at
    return Acted.GameEventBy((String("minecraft:projectile_land"), (f64(bx) + 0.5, f64(ay) + 0.5, f64(bz) + 0.5), some(state), by))
}

fn landed_on_farmland(body: mut Body) -> f64? {
    let landed = body.farmland_fall.take() else return none
    let (fell, _, _, _) = landed
    return some(fell)
}

// A body moved up as `pushEntitiesUp` moves it to stand at `top`: a move down of 1 from a block
// above, `Shapes.collide`, which stops at `top`, `teleportRelative` by 1 and that, its place where
// it was last tick too, `snapTo`. Where its box a block up still meets the part grown, whose top
// is `top`, `collide` passes that part by, so it moves down the whole 1 and stays (CAL-242).
fn lift_body(body: mut Body, top: f64) {
    var offset = top - (body.y + 1.0)
    if offset < -1.0 or body.y + 1.0 + 1.0e-7 < top {
        offset = -1.0
    }
    body.y = body.y + (1.0 + offset)
    body.xo = body.x
    body.yo = body.y
    body.zo = body.z
}

fn place_of(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Item(i) => (i.body.x, i.body.y, i.body.z),
        Entity.Orb(o) => (o.body.x, o.body.y, o.body.z),
        Entity.Stand(a) => (a.living.body.x, a.living.body.y, a.living.body.z),
        Entity.Mob(m) => (m.living.body.x, m.living.body.y, m.living.body.z),
        Entity.Arrow(a) => (a.body.x, a.body.y, a.body.z),
        Entity.Thrown(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Cloud(c) => (c.body.x, c.body.y, c.body.z),
        Entity.Crystal(c) => (c.body.x, c.body.y, c.body.z),
        Entity.Eye(eye) => (eye.body.x, eye.body.y, eye.body.z),
        Entity.Fireball(b) => (b.body.x, b.body.y, b.body.z),
        Entity.Tnt(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Falling(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Boat(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Cart(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Knot(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Hanging(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Fangs(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Bolt(p) => (p.body.x, p.body.y, p.body.z),
    }
}

// The nearest player to the mob `a` that isn't a spectator, by the square of how far, as
// `checkDespawn` looks, `getNearestPlayer(this, -1.0)`.
fn nearest_to(a: Mob, players: List<Follower>) -> f64? {
    var nearest: f64? = none
    for p in players {
        if p.spectator {
            continue
        }
        let dx = p.x - a.living.body.x
        let dy = p.y - a.living.body.y
        let dz = p.z - a.living.body.z
        let d = dx * dx + dy * dy + dz * dz
        match nearest {
            some(b) => {
                if d < b {
                    nearest = some(d)
                }
            },
            none => nearest = some(d),
        }
    }
    return nearest
}

// The entity's body, a copy (D708).
fn body_of(e: Entity) -> Body {
    return match e {
        Entity.Item(i) => i.body.copy(),
        Entity.Orb(o) => o.body.copy(),
        Entity.Stand(a) => a.living.body.copy(),
        Entity.Mob(m) => m.living.body.copy(),
        Entity.Arrow(a) => a.body.copy(),
        Entity.Thrown(p) => p.body.copy(),
        Entity.Cloud(c) => c.body.copy(),
        Entity.Crystal(c) => c.body.copy(),
        Entity.Eye(eye) => eye.body.copy(),
        Entity.Fireball(b) => b.body.copy(),
        Entity.Tnt(p) => p.body.copy(),
        Entity.Falling(p) => p.body.copy(),
        Entity.Boat(p) => p.body.copy(),
        Entity.Cart(p) => p.body.copy(),
        Entity.Knot(p) => p.body.copy(),
        Entity.Hanging(p) => p.body.copy(),
        Entity.Fangs(p) => p.body.copy(),
        Entity.Bolt(p) => p.body.copy(),
    }
}

// The entity with its body `b` (D708).
// What a shulker box's lid or a piston pushes, `lid_push` and `piston_push`: all but clouds,
// leash knots, what hangs, evoker fangs and lightning (CAL-445).
const PUSHED: i32 = 1983 | FALLING | BOATS

fn with_body(e: own Entity, b: own Body) -> Entity {
    return match e {
        Entity.Item(i) => {
            var t = i
            t.body = b
            Entity.Item(t)
        },
        Entity.Orb(o) => {
            var t = o
            t.body = b
            Entity.Orb(t)
        },
        Entity.Stand(a) => {
            var t = a
            t.living.body = b
            Entity.Stand(t)
        },
        Entity.Mob(m) => {
            var t = m
            t.living.body = b
            Entity.Mob(t)
        },
        Entity.Arrow(a) => {
            var t = a
            t.body = b
            Entity.Arrow(t)
        },
        Entity.Thrown(p) => {
            var t = p
            t.body = b
            Entity.Thrown(t)
        },
        Entity.Cloud(c) => {
            var t = c
            t.body = b
            Entity.Cloud(t)
        },
        Entity.Crystal(c) => {
            var t = c
            t.body = b
            Entity.Crystal(t)
        },
        Entity.Eye(eye) => {
            var t = eye
            t.body = b
            Entity.Eye(t)
        },
        Entity.Fireball(f) => {
            var t = f
            t.body = b
            Entity.Fireball(t)
        },
        Entity.Tnt(p) => {
            var t = p
            t.body = b
            Entity.Tnt(t)
        },
        Entity.Falling(p) => {
            var t = p
            t.body = b
            Entity.Falling(t)
        },
        Entity.Boat(p) => {
            var t = p
            t.body = b
            Entity.Boat(t)
        },
        Entity.Cart(p) => {
            var t = p
            t.body = b
            Entity.Cart(t)
        },
        Entity.Knot(p) => {
            var t = p
            t.body = b
            Entity.Knot(t)
        },
        Entity.Hanging(p) => {
            var t = p
            t.body = b
            Entity.Hanging(t)
        },
        Entity.Fangs(p) => {
            var t = p
            t.body = b
            Entity.Fangs(t)
        },
        Entity.Bolt(p) => {
            var t = p
            t.body = b
            Entity.Bolt(t)
        },
    }
}

// The entity's ID, what it rides, and whether anything rides it, without copying its body (D708).
fn riding_of(e: Entity) -> (i32, i32?, bool) {
    return match e {
        Entity.Item(i) => (i.body.id, i.body.vehicle, not i.body.passengers.is_empty()),
        Entity.Orb(o) => (o.body.id, o.body.vehicle, not o.body.passengers.is_empty()),
        Entity.Stand(a) => (a.living.body.id, a.living.body.vehicle, not a.living.body.passengers.is_empty()),
        Entity.Mob(m) => (m.living.body.id, m.living.body.vehicle, not m.living.body.passengers.is_empty()),
        Entity.Arrow(a) => (a.body.id, a.body.vehicle, not a.body.passengers.is_empty()),
        Entity.Thrown(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Cloud(c) => (c.body.id, c.body.vehicle, not c.body.passengers.is_empty()),
        Entity.Crystal(c) => (c.body.id, c.body.vehicle, not c.body.passengers.is_empty()),
        Entity.Eye(eye) => (eye.body.id, eye.body.vehicle, not eye.body.passengers.is_empty()),
        Entity.Fireball(b) => (b.body.id, b.body.vehicle, not b.body.passengers.is_empty()),
        Entity.Tnt(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Falling(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Boat(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Cart(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Knot(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Hanging(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Fangs(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Bolt(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
    }
}

// Whether the entity's alive, `LivingEntity`: an armor stand or a mob.
fn alive_kind(e: Entity) -> bool {
    return match e {
        Entity.Stand(_) => true,
        Entity.Mob(_) => true,
        _ => false,
    }
}

// The entity, still, `setDeltaMovement(Vec3.ZERO)`, as its ride's tick begins (D708).
fn stilled(e: own Entity) -> Entity {
    var b = body_of(e)
    b.vx = 0.0
    b.vy = 0.0
    b.vz = 0.0
    return with_body(e, b)
}

// `Vec3.yRot(-y_rot * (float) (Math.PI / 180.0))`, as `EntityAttachments.transformPoint` turns a
// point by its entity's yaw, by the table's sine and cosine (D708).
fn turned(p: (f64, f64, f64), y_rot: f32) -> (f64, f64, f64) {
    let (x, y, z) = p
    let radians = -y_rot * 0.017453292f32
    let cos = f64(table_cos(f64(radians)))
    let sin = f64(table_sin(f64(radians)))
    return (x * cos + z * sin, y, z * cos - x * sin)
}

// Where what rides the entity `e` sits on it before its turn, `getPassengerAttachmentPoint`
// (D708): a mob's its kind's, anything else's its height, `AT_HEIGHT`.
fn seat_of(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Mob(m) => m.seat(),
        other => (0.0, f64(body_of(other).height), 0.0),
    }
}

// Where the entity `e` is held by what it rides before its turn, `getVehicleAttachmentPoint`
// (D708): a mob's its kind's, anything else's its feet.
fn held_at(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Mob(m) => m.held(),
        _ => (0.0, 0.0, 0.0),
    }
}

// The line `--entity-trace` writes for the entity, a mob's or an armor stand's, at the game time
// `time` (CAL-159); with `controls`, it goes on with a mob's, `controls_traced` (CAL-180).
fn traced(time: i64, e: Entity, controls: bool) -> String {
    return match e {
        Entity.Stand(a) => "{time} {a.living.body.id} {a.living.body.x} {a.living.body.y} {a.living.body.z} {a.living.body.vx} {a.living.body.vy} {a.living.body.vz} {a.living.body.y_rot} {a.living.body.x_rot} {a.living.y_head_rot} {a.living.y_body_rot} {a.living.zza} {a.living.xxa} {a.living.speed} {a.living.body.on_ground}{if controls { NO_CONTROLS } else { "" }}\n",
        Entity.Mob(a) => "{time} {a.living.body.id} {a.living.body.x} {a.living.body.y} {a.living.body.z} {a.living.body.vx} {a.living.body.vy} {a.living.body.vz} {a.living.body.y_rot} {a.living.body.x_rot} {a.living.y_head_rot} {a.living.y_body_rot} {a.living.zza} {a.living.xxa} {a.living.speed} {a.living.body.on_ground}{if controls { controls_traced(a) } else { String() }}\n",
        _ => String(),
    }
}

// A mob's path as `paths.txt` beside its trace has it, as the rig agent writes vanilla's
// (CAL-403): its ID, what tells it from the last, its number and its next node's index, and the
// line's rest, the index of the node it's going to, its target and its nodes, or `none`. A line
// of the trace marked `P` holds it, which the trace's writer puts in `paths.txt`.
fn path_traced(e: Entity) -> (i32, String, String)? {
    match e {
        Entity.Mob(a) => {
            let id = a.living.body.id
            let p = a.navigation.path else return some((id, String("none"), String("none")))
            let (tx, ty, tz) = p.target
            var text = "{a.navigation.next} {tx},{ty},{tz}"
            for n in p.nodes {
                text.push_str(" {n.x},{n.y},{n.z}")
            }
            return some((id, "{p.id}:{a.navigation.next}", text))
        },
        _ => return none,
    }
}

/// What a trace line of a living entity that isn't a mob, or of a player, goes on with where it
/// has a mob's controls, 0 and false for each (CAL-180), and 0 for its random.
pub const NO_CONTROLS: str = " 0.0 0.0 0.0 0.0 false 0.0 0.0 0.0 false 0"

// A mob's controls as its trace line goes on with them, as the rig agent's `controls` writes
// vanilla's (CAL-180): its move control's wanted place and speed and whether it has one,
// `hasWanted`, then its look control's wanted place and whether it's looking there,
// `isLookingAtTarget`; last its own random's seed as it is now, so where its draws part shows
// (CAL-303).
fn controls_traced(a: Mob) -> String {
    let m = a.moves
    let (lx, ly, lz) = a.look.wanted()
    return " {m.wanted_x} {m.wanted_y} {m.wanted_z} {m.speed_modifier} {m.has_wanted()} {lx} {ly} {lz} {a.look.looking()} {a.living.body.random.raw_seed()}"
}

// The entity's box.
// The item `e`, of the ID `id`, as a brain sees it (CAL-160).
fn item_near(id: i32, e: ItemEntity) -> Near {
    return Near { id: id, uuid: e.body.uuid, species: ITEM, x: e.body.x, y: e.body.y, z: e.body.z, eyes: e.body.eyes, bounds: e.body.bounding_box() }
}

// The UUID of `e`.
fn uuid_of_entity(e: Entity) -> (i64, i64) {
    return match e {
        Entity.Item(i) => i.body.uuid,
        Entity.Orb(o) => o.body.uuid,
        Entity.Stand(a) => a.living.body.uuid,
        Entity.Mob(m) => m.living.body.uuid,
        Entity.Arrow(a) => a.body.uuid,
        Entity.Thrown(p) => p.body.uuid,
        Entity.Cloud(c) => c.body.uuid,
        Entity.Crystal(c) => c.body.uuid,
        Entity.Eye(eye) => eye.body.uuid,
        Entity.Fireball(b) => b.body.uuid,
        Entity.Tnt(p) => p.body.uuid,
        Entity.Falling(p) => p.body.uuid,
        Entity.Boat(p) => p.body.uuid,
        Entity.Cart(p) => p.body.uuid,
        Entity.Knot(p) => p.body.uuid,
        Entity.Hanging(p) => p.body.uuid,
        Entity.Fangs(p) => p.body.uuid,
        Entity.Bolt(p) => p.body.uuid,
    }
}

// Whether `e` is collided with as a block is, `canBeCollidedWith`: a boat, or a living shulker
// (CAL-377).
fn hard_box(e: Entity) -> bool {
    return match e {
        Entity.Boat(_) => true,
        Entity.Mob(m) => m.species == SHULKER and m.living.alive(),
        _ => false,
    }
}

fn box_of(e: Entity) -> Aabb {
    return match e {
        Entity.Item(i) => i.body.bounding_box(),
        Entity.Orb(o) => o.body.bounding_box(),
        Entity.Stand(a) => a.living.body.bounding_box(),
        Entity.Mob(m) => m.living.body.bounding_box(),
        Entity.Arrow(a) => a.body.bounding_box(),
        Entity.Thrown(p) => p.body.bounding_box(),
        Entity.Cloud(c) => c.body.bounding_box(),
        Entity.Crystal(c) => c.body.bounding_box(),
        Entity.Eye(eye) => eye.body.bounding_box(),
        Entity.Fireball(b) => b.body.bounding_box(),
        Entity.Tnt(p) => p.body.bounding_box(),
        Entity.Falling(p) => p.body.bounding_box(),
        Entity.Boat(p) => p.body.bounding_box(),
        Entity.Cart(p) => p.body.bounding_box(),
        Entity.Knot(p) => p.body.bounding_box(),
        Entity.Hanging(p) => p.body.bounding_box(),
        Entity.Fangs(p) => p.body.bounding_box(),
        Entity.Bolt(p) => p.body.bounding_box(),
    }
}

// The body's nether portal, where it's in it and may go through it, `allowed`, put in `out`
// (D578).
fn due_of(out: mut List<PortalDue>, b: Body, allowed: bool) {
    if not allowed {
        return
    }
    let p = b.portal_process else return
    if p.inside {
        out.push(PortalDue { id: b.id, x: b.x, y: b.y, z: b.z, width: b.width, height: b.height, fall: b.fall, portal: p })
    }
}

// The entity told whether its level's nether portals may take it, `open` (D578), and its end
// portals, `end` (D587).
fn opened(e: own Entity, open: bool, end: bool) -> Entity {
    return match e {
        Entity.Item(i) => {
            var it = i
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Item(it)
        },
        Entity.Orb(o) => {
            var it = o
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Orb(it)
        },
        Entity.Stand(a) => {
            var it = a
            it.living.body.portal_open = open
            it.living.body.end_open = end
            Entity.Stand(it)
        },
        Entity.Mob(m) => {
            var it = m
            it.living.body.portal_open = open
            it.living.body.end_open = end
            Entity.Mob(it)
        },
        Entity.Arrow(a) => {
            var it = a
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Arrow(it)
        },
        Entity.Thrown(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Thrown(it)
        },
        Entity.Cloud(c) => Entity.Cloud(c),
        Entity.Crystal(c) => {
            var it = c
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Crystal(it)
        },
        // Never inside what it's in, so through no portal (D598).
        Entity.Eye(eye) => Entity.Eye(eye),
        Entity.Fireball(b) => {
            var it = b
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Fireball(it)
        },
        Entity.Tnt(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Tnt(it)
        },
        Entity.Falling(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Falling(it)
        },
        Entity.Boat(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Boat(it)
        },
        Entity.Cart(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Cart(it)
        },
        Entity.Knot(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Knot(it)
        },
        Entity.Hanging(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Hanging(it)
        },
        Entity.Fangs(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Fangs(it)
        },
        Entity.Bolt(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Bolt(it)
        },
    }
}

// What an explosion asks of the entity of `body`, of the kind `kind` (CAL-182).
fn reached_body(body: Body, kind: i32, invisible: bool, resistance: f64) -> Reached {
    return Reached { id: body.id, bounds: body.bounding_box(), x: body.x, y: body.y, z: body.z, eyes: f64(body.eyes), mover: body.mover(), kind: kind, invisible: invisible, resistance: resistance }
}

// The same of what an explosion pushes from where it stands, as primed TNT (CAL-182).
fn reached_feet(body: Body, kind: i32) -> Reached {
    return Reached { id: body.id, bounds: body.bounding_box(), x: body.x, y: body.y, z: body.z, eyes: 0.0, mover: body.mover(), kind: kind, invisible: false, resistance: 0.0 }
}

// The entity pushed by x, y, z, `Entity.push` (CAL-182), but an arrow in the ground,
// `AbstractArrow.push`, as one lodged in the TNT it lit is.
fn pushed_by(e: own Entity, x: f64, y: f64, z: f64) -> Entity {
    return match e {
        Entity.Item(i) => {
            var it = i
            it.body.push(x, y, z)
            Entity.Item(it)
        },
        Entity.Orb(o) => {
            var it = o
            it.body.push(x, y, z)
            Entity.Orb(it)
        },
        Entity.Stand(a) => {
            var it = a
            it.living.body.push(x, y, z)
            Entity.Stand(it)
        },
        Entity.Mob(m) => {
            var it = m
            it.living.body.push(x, y, z)
            Entity.Mob(it)
        },
        Entity.Arrow(a) => {
            var it = a
            if not it.in_ground() {
                it.body.push(x, y, z)
            }
            Entity.Arrow(it)
        },
        Entity.Thrown(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Thrown(it)
        },
        Entity.Cloud(c) => {
            var it = c
            it.body.push(x, y, z)
            Entity.Cloud(it)
        },
        Entity.Crystal(c) => {
            var it = c
            it.body.push(x, y, z)
            Entity.Crystal(it)
        },
        Entity.Eye(eye) => {
            var it = eye
            it.body.push(x, y, z)
            Entity.Eye(it)
        },
        Entity.Fireball(b) => {
            // A wind charge isn't pushed, `AbstractWindCharge.push` (CAL-207).
            var it = b
            if not wind_kind(it.kind) {
                it.body.push(x, y, z)
            }
            Entity.Fireball(it)
        },
        Entity.Tnt(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Tnt(it)
        },
        Entity.Falling(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Falling(it)
        },
        Entity.Boat(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Boat(it)
        },
        Entity.Cart(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Cart(it)
        },
        Entity.Knot(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Knot(it)
        },
        Entity.Hanging(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Hanging(it)
        },
        Entity.Fangs(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Fangs(it)
        },
        Entity.Bolt(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Bolt(it)
        },
    }
}

// When the entity came into its level.
fn entered_of(e: Entity) -> u64 {
    return match e {
        Entity.Item(i) => i.body.entered,
        Entity.Orb(o) => o.body.entered,
        Entity.Stand(a) => a.living.body.entered,
        Entity.Mob(m) => m.living.body.entered,
        Entity.Arrow(a) => a.body.entered,
        Entity.Thrown(p) => p.body.entered,
        Entity.Cloud(c) => c.body.entered,
        Entity.Crystal(c) => c.body.entered,
        Entity.Eye(eye) => eye.body.entered,
        Entity.Fireball(b) => b.body.entered,
        Entity.Tnt(p) => p.body.entered,
        Entity.Falling(p) => p.body.entered,
        Entity.Boat(p) => p.body.entered,
        Entity.Cart(p) => p.body.entered,
        Entity.Knot(p) => p.body.entered,
        Entity.Hanging(p) => p.body.entered,
        Entity.Fangs(p) => p.body.entered,
        Entity.Bolt(p) => p.body.entered,
    }
}

