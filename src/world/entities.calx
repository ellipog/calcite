    /// The chunks with entities or kept ones in them, `getAllChunksWithExistingSections`.
    pub fn chunks(self) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for (k, _) in self.chunk_sections {
            out.push(ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) })
        }
        return out
    }

    /// The entities in the chunk at `pos`, and the kept ones, in the order
    /// `getExistingSectionsInChunk` gives them: its sections by `SectionPos.asLong`, and in each
    /// in the order they came into it.
    pub fn in_chunk(self, pos: ChunkPos) -> List<i32> {
        let k = pos.pack()
        if not self.chunk_sections.contains(k) {
            return List<i32>()
        }
        var keys = self.chunk_sections[k].copy()
        keys.sort()
        var out = List<i32>()
        for key in keys {
            for id in self.sections[key] {
                if not self.players_in.contains(id) {
                    out.push(id)
                }
            }
        }
        return out
    }

    /// Gives the entity `id`, one Calcite keeps as it was read, below 0, a place last in the
    /// section of x, y, z, as `addEntity` does.
    pub fn place_kept(mut self, id: i32, x: f64, y: f64, z: f64) {
        self.into_section(id, section_key(x, y, z))
    }

    /// Puts the player `id` in the section of x, y, z, last there where they weren't in it, as
    /// their `onMove` does, or as they're added to the level (CAL-190).
    pub fn place_player(mut self, id: i32, x: f64, y: f64, z: f64) {
        self.players_in.insert(id)
        self.move_section(id, section_key(x, y, z))
    }

    /// Moves the player `id`, where they're among the entities, to the section of x, y, z, last
    /// there where they weren't in it, as their `onMove` does (CAL-190).
    pub fn move_player(mut self, id: i32, x: f64, y: f64, z: f64) {
        if self.players_in.contains(id) {
            self.move_section(id, section_key(x, y, z))
        }
    }

    /// Takes the player `id` out of their section, as they're removed from the level (CAL-190).
    pub fn remove_player(mut self, id: i32) {
        if not self.players_in.contains(id) {
            return
        }
        self.players_in.remove(id)
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
    }

    /// Takes the kept entity `id` out of its section, as it's let go of.
    pub fn remove_kept(mut self, id: i32) {
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
    }

    /// The ID of the entity here of the UUID `uuid` that isn't gone, `getEntity(uuid)`, as an
    /// arrow finds its owner (CAL-159).
    pub fn id_with_uuid(self, uuid: (i64, i64)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            let (u, removed) = match e {
                Entity.Item(i) => (i.body.uuid, i.body.removed),
                Entity.Orb(o) => (o.body.uuid, o.body.removed),
                Entity.Stand(a) => (a.living.body.uuid, a.living.body.removed),
                Entity.Mob(m) => (m.living.body.uuid, m.living.body.removed),
                Entity.Arrow(a) => (a.body.uuid, a.body.removed),
                Entity.Thrown(p) => (p.body.uuid, p.body.removed),
                Entity.Cloud(c) => (c.body.uuid, c.body.removed),
                Entity.Crystal(c) => (c.body.uuid, c.body.removed),
                Entity.Eye(eye) => (eye.body.uuid, eye.body.removed),
                Entity.Fireball(b) => (b.body.uuid, b.body.removed),
                Entity.Tnt(p) => (p.body.uuid, p.body.removed),
                Entity.Knot(p) => (p.body.uuid, p.body.removed),
                Entity.Fangs(p) => (p.body.uuid, p.body.removed),
            }
            if u == uuid and not removed {
                return some(id_of(e))
            }
        }
        return none
    }

    /// Where the entity `id` is, if it's here.
    pub fn place(self, id: i32) -> (f64, f64, f64)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(place_of(e))
    }

    /// What rides the entity `id`, in order, `getPassengers` (D708); none where it isn't here.
    pub fn passengers_of(self, id: i32) -> List<i32> {
        let b = self.body_at(id) else return List<i32>()
        return b.passengers.copy()
    }

    /// What the entity `id` rides, `getVehicle` (D708), none where it isn't here or rides nothing.
    pub fn vehicle_of(self, id: i32) -> i32? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let (_, vehicle, _) = riding_of(e)
        return vehicle
    }

    /// What the entity `id` rides at the bottom, `getRootVehicle` (D708): itself where it rides
    /// nothing.
    pub fn root_vehicle(self, id: i32) -> i32 {
        var at = id
        var depth = 0
        while depth < 4096 {
            let under = self.vehicle_of(at) else break
            at = under
            depth += 1
        }
        return at
    }

    // A copy of the body of the entity `id`, where it's here and not lent.
    fn body_at(self, id: i32) -> Body? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(body_of(e))
    }

    // The entity `id`'s body made `b`, where it's here and not lent.
    fn put_body(mut self, id: i32, b: own Body) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(with_body(e, b))
    }

    // What rides the entity `id` given to each of them as what rides with it, `riding_with`.
    fn share_riders(mut self, id: i32) {
        let riders = self.passengers_of(id)
        for p in riders {
            var b = self.body_at(p) else continue
            b.riding_with = riders.copy()
            self.put_body(p, b)
        }
    }

    /// `ConversionType.SPLIT_ON_DEATH`'s riding of the mob `old` split into others as it dies
    /// (CAL-175): what rode it first gets off, `stopRiding`, as the first of them is made, onto
    /// its top, as it's not gone till after, `super.remove`.
    pub fn first_rider_off(mut self, old: i32) {
        let ob = self.body_at(old) else return
        if not ob.passengers.is_empty() {
            self.leave_with(ob.passengers[0], false, true)
        }
    }

    /// `ConversionType.SINGLE`'s riding of the mob `old` turned into the mob `new` (CAL-175): what
    /// rode `old` first gets off, may board again at once, `boardingCooldown`, and rides `new`; and
    /// `new` rides what `old` rode, which `old` gets off.
    pub fn hand_over_riders(mut self, old: i32, new: i32) {
        let ob = self.body_at(old) else return
        if not ob.passengers.is_empty() {
            let root = ob.passengers[0]
            self.stop_riding(root)
            if let got = self.body_at(root) {
                var rb = got
                rb.boarding_cooldown = 0
                self.put_body(root, rb)
            }
            _ = self.start_riding(root, new, false)
        }
        if let v = self.vehicle_of(old) {
            self.stop_riding(old)
            _ = self.start_riding(new, v, false)
        }
    }

    /// `startRiding` of the entity `rider` onto the entity `vehicle` (D708), both here, `force`
    /// where it boards however soon after it got off something and whatever already rides
    /// `vehicle`, as loading and `summon` board, `canRide` and `canAddPassenger`: not where it
    /// rides it already, would ride itself, or what `vehicle` rides, all the way down, is it;
    /// else off what it rode, standing, `setPose(STANDING)`, and last of what rides `vehicle`,
    /// `addPassenger`. Says whether it boarded. Its game event, `ENTITY_MOUNT`, is the caller's.
    pub fn start_riding(mut self, rider: i32, vehicle: i32, force: bool) -> bool {
        if rider == vehicle {
            return false
        }
        let r = self.body_at(rider) else return false
        let v = self.body_at(vehicle) else return false
        if r.vehicle == some(vehicle) {
            return false
        }
        var below = v.vehicle
        var depth = 0
        while depth < 4096 {
            let under = below else break
            if under == rider {
                return false
            }
            below = self.vehicle_of(under)
            depth += 1
        }
        if not force and (r.boarding_cooldown > 0 or not v.passengers.is_empty()) {
            return false
        }
        if r.vehicle != none {
            self.stop_riding(rider)
        }
        let i = self.at[rider]
        if let held = self.all[i].take() {
            self.all[i] = some(match held {
                Entity.Mob(m) => {
                    var t = m
                    t.living.data.set(POSE_ID, Value.Number(STANDING))
                    Entity.Mob(t)
                },
                Entity.Stand(a) => {
                    var t = a
                    t.living.data.set(POSE_ID, Value.Number(STANDING))
                    Entity.Stand(t)
                },
                other => other,
            })
        }
        var rb = self.body_at(rider) else return false
        rb.vehicle = some(vehicle)
        self.put_body(rider, rb)
        var vb = self.body_at(vehicle) else return false
        vb.passengers.push(rider)
        self.put_body(vehicle, vb)
        self.share_riders(vehicle)
        return true
    }

    /// `stopRiding` of the entity `rider` (D708), `removeVehicle`: off what it rides, which it may
    /// board again in 60 ticks, `boardingCooldown`; and what's alive put where it gets off,
    /// `dismountVehicle`, as the next entity's tick begins, where its level's blocks are at hand,
    /// or as the server asks, `seat_off`. Its game event, `ENTITY_DISMOUNT`, isn't made.
    pub fn stop_riding(mut self, rider: i32) {
        self.leave(rider, false)
    }

    // `stopRiding` of `rider`, `gone` where what it rides is gone, `isRemoved`.
    fn leave(mut self, rider: i32, gone: bool) {
        self.leave_with(rider, gone, false)
    }

    // `leave`, what it rides taken as there still where `present`, though it's marked gone, as a
    // splitting slime is before `super.remove`.
    fn leave_with(mut self, rider: i32, gone: bool, present: bool) {
        // A player riding, whose body the network keeps, off for it to put where they get off
        // (CAL-179).
        if let k = self.riding_player(rider) {
            let (_, vehicle, _) = self.riding_players[k]
            _ = self.riding_players.remove(k)
            self.set_player_rider(vehicle, none)
            let off = self.off_from(vehicle, rider, gone, present)
            self.players_off.push(off)
            return
        }
        var rb = self.body_at(rider) else return
        let vehicle = rb.vehicle else return
        rb.vehicle = none
        rb.riding_with = List<i32>()
        rb.boarding_cooldown = 60
        let removed = rb.removed
        self.put_body(rider, rb)
        let off = self.off_from(vehicle, rider, gone, present)
        // `LivingEntity.stopRiding`: what's alive and not gone itself gets off where its vehicle
        // puts it.
        let (_, _, _, _, alive) = self.riding_at(self.at[rider]) else return
        if alive and not removed {
            self.unseated.push(off)
        }
    }

    // `rider` off what rides `vehicle`, `removePassenger`, and what it got off, where that's
    // here, as it's to be put where it gets off, `gone` where what it rides is gone, and so it
    // is where it's marked gone but not `present`.
    fn off_from(mut self, vehicle: i32, rider: i32, gone: bool, present: bool) -> Unseat {
        var off = Unseat { rider: rider, x: 0.0, y: 0.0, z: 0.0, top: 0.0, yaw: 0.0f32, gone: gone, animal: false, vehicle: vehicle }
        if let got = self.body_at(vehicle) {
            var vb = got
            var kept = List<i32>()
            for p in vb.passengers {
                if p != rider {
                    kept.push(p)
                }
            }
            vb.passengers = kept
            off.x = vb.x
            off.y = vb.y
            off.z = vb.z
            off.top = vb.bounding_box().max_y
            off.bottom = vb.bounding_box().min_y
            off.width = vb.width
            off.yaw = vb.y_rot
            off.gone = gone or (vb.removed and not present)
            off.left_riding = vb.passengers.copy()
            self.put_body(vehicle, vb)
            self.share_riders(vehicle)
            if let Entity.Mob(m) = self.all[self.at[vehicle]] {
                off.animal = m.animal
                off.horse = m.equine()
            }
        } else {
            off.gone = true
        }
        if self.at.contains(rider) {
            if let Entity.Mob(rm) = self.all[self.at[rider]] {
                off.left = rm.left_handed()
            }
        }
        return off
    }

    // Where the player `id` rides something here, their place among those riding (CAL-179).
    fn riding_player(self, id: i32) -> usize? {
        for k in 0..self.riding_players.len() {
            let (p, _, _) = self.riding_players[k]
            if p == id {
                return some(k)
            }
        }
        return none
    }

    // The mob `vehicle` told of the player riding it, by their UUID, or that none does (CAL-179).
    fn set_player_rider(mut self, vehicle: i32, uuid: (i64, i64)?) {
        if not self.at.contains(vehicle) {
            return
        }
        let i = self.at[vehicle]
        let held = self.all[i].take() else return
        self.all[i] = some(match held {
            Entity.Mob(m) => {
                var t = m
                t.player_rider = uuid
                Entity.Mob(t)
            },
            other => other,
        })
    }

    /// `Player.startRiding` of the player `player`, of the UUID `uuid`, onto the entity `vehicle`
    /// (CAL-179), `canAddPassenger`: where it's here, not gone, nothing rides it and they ride
    /// nothing here, last of what rides it, `addPassenger`. Says whether they boarded. Where they
    /// sit, their teleport, the packets and their trigger are the network's.
    pub fn seat_player(mut self, player: i32, uuid: (i64, i64), vehicle: i32) -> bool {
        if self.riding_player(player) != none {
            return false
        }
        var vb = self.body_at(vehicle) else return false
        if vb.removed or not vb.passengers.is_empty() {
            return false
        }
        vb.passengers.push(player)
        self.put_body(vehicle, vb)
        self.share_riders(vehicle)
        self.riding_players.push((player, vehicle, uuid))
        self.set_player_rider(vehicle, some(uuid))
        return true
    }

    /// What the player `player` rides here, where they ride something (CAL-179).
    pub fn player_vehicle(self, player: i32) -> i32? {
        let k = self.riding_player(player) else return none
        let (_, vehicle, _) = self.riding_players[k]
        return some(vehicle)
    }

    /// Whether the entity `vehicle` is here, isn't gone and carries the player `player`,
    /// `hasPassenger` (CAL-179).
    /// Where the mob `vehicle` is, its motion and its gravity, where the player `player` steers
    /// it, `getControllingPassenger() == player`, holding a carrot on a stick or not,
    /// `steers_pigs` (CAL-179).
    pub fn steered(self, vehicle: i32, player: i32, steers_pigs: bool) -> ((f64, f64, f64), f64)? {
        if not self.at.contains(vehicle) {
            return none
        }
        if let Entity.Mob(mob) = self.all[self.at[vehicle]] {
            if mob.player_steers(player, steers_pigs) and not mob.living.body.removed {
                let b = mob.living.body.copy()
                return some(((b.x, b.y, b.z), b.gravity_now()))
            }
        }
        return none
    }

    /// Where the entity `id` is and how it's turned, `storePositionAndRotation`, and its name as
    /// vanilla's log writes it, `getPlainTextName`, its type's English name from its key, as
    /// "Zombie Horse" (CAL-179).
    pub fn placed(self, id: i32) -> ((f64, f64, f64), f32, f32, String)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        let b = body_of(e)
        var name = String()
        if let Entity.Mob(mob) = e {
            let key = type_name(mob.species)
            let path = key.split(":")
            var first = true
            for word in path[path.len() - 1].split("_") {
                if not first {
                    name.push_str(" ")
                }
                first = false
                let runes = word.split("")
                for k in 0..runes.len() {
                    name.push_str(if k == 0 { runes[k].to_upper_root() } else { runes[k].copy() })
                }
            }
        }
        return some(((b.x, b.y, b.z), b.y_rot, b.x_rot, name))
    }

    /// The boost a carrot on a stick gives the mob `vehicle`, `ItemSteerable.boost`, `Mob.boost`'s
    /// (CAL-179). Whether it began.
    pub fn boost(mut self, vehicle: i32) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let i = self.at[vehicle]
        let taken = self.all[i].take() else return false
        var began = false
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                began = it.boost()
                Entity.Mob(it)
            },
            other => other,
        })
        return began
    }

    /// The horse `vehicle` jumped by its rider with the strength `data`, `ride_jump` (CAL-179),
    /// its sounds in `sounds`. Whether it jumped.
    pub fn ride_jump(mut self, vehicle: i32, data: i32, sounds: mut List<EntitySound>) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let i = self.at[vehicle]
        let taken = self.all[i].take() else return false
        var jumped = false
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                jumped = it.ride_jump(data, mut sounds)
                Entity.Mob(it)
            },
            other => other,
        })
        return jumped
    }

    /// Whether the horse `id` opens its inventory for the player `player`,
    /// `openCustomInventoryScreen` (CAL-179): tamed, and with nothing riding it but them.
    pub fn mount_opens(self, id: i32, player: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let Entity.Mob(mob) = self.all[self.at[id]] else return false
        if not mob.equine() or not mob.horse_flag(2) {
            return false
        }
        return mob.living.body.passengers.is_empty() or mob.living.body.passengers.contains(player)
    }

    /// What a horse's menu shows of the mob `id` (CAL-179): its saddle and body armor, whether it
    /// may use those slots, `canUseSlot`, its type's name, whether it's alive, and its box, which
    /// the menu's opener must stay in reach of; none where it isn't a horse here.
    pub fn mount_view(self, id: i32) -> (Tag?, Tag?, bool, bool, String, bool, Aabb)? {
        if not self.at.contains(id) {
            return none
        }
        let Entity.Mob(mob) = self.all[self.at[id]] else return none
        if not mob.equine() {
            return none
        }
        let alive = mob.living.alive() and not mob.living.body.removed
        return some((mob.living.equipment[7].copy(), mob.living.equipment[6].copy(), mob.may_use_slot(7), mob.may_use_slot(6), String(type_name(mob.species)), alive, mob.living.body.bounding_box()))
    }

    /// A horse's menu's slots given back to the mob `id`, its saddle and body armor, each
    /// `setItemSlot`, and where it's anything, kept for its drops and itself kept,
    /// `setGuaranteedDrop`, `setPersistenceRequired` (CAL-179).
    pub fn mount_worn(mut self, id: i32, held: List<Tag?>) {
        if not self.at.contains(id) or held.len() < 2 {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                it.wear_from_menu(7, held[0].copy())
                it.wear_from_menu(6, held[1].copy())
                // Then its chest's, where the menu has as many as it has, `hasInventoryChanged`.
                if held.len() == it.chest_items.len() + 2 {
                    for k in 0..it.chest_items.len() {
                        it.chest_items[k] = held[k + 2].copy()
                    }
                }
                Entity.Mob(it)
            },
            other => other,
        })
    }

    /// A donkey's chest's columns and what's in its slots, for its menu (CAL-179).
    pub fn mount_chest(self, id: i32) -> (i32, List<Tag?>)? {
        if not self.at.contains(id) {
            return none
        }
        let Entity.Mob(mob) = self.all[self.at[id]] else return none
        return some((mob.mount_columns(), mob.chest_items.copy()))
    }

    /// The equip sound of the mob `id` as a horse's menu set what it wears in the slot `slot` from
    /// `old` to `stack`, `onEquipItem`, with `items`' codecs (CAL-179).
    pub fn mount_equip_sound<W: Wearing>(mut self, id: i32, items: W, slot: usize, old: Tag?, stack: Tag?, sounds: mut List<EntitySound>) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        self.all[i] = some(match taken {
            Entity.Mob(mob) => {
                var it = mob
                it.equip_heard(items, slot, old.copy(), stack.copy(), mut sounds)
                Entity.Mob(it)
            },
            other => other,
        })
    }

    pub fn carries_player(self, vehicle: i32, player: i32) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let e = self.all[self.at[vehicle]] else return false
        let b = body_of(e)
        return not b.removed and b.passengers.contains(player)
    }

    /// `stopRiding` of the player `player` (CAL-179), `removeVehicle`: off what they ride, for
    /// the network to put where they get off, `take_players_off`.
    pub fn unseat_player(mut self, player: i32) {
        self.leave(player, false)
    }

    /// The player the mob `vehicle` threw off as it ran around, `ejectPassengers` (CAL-179), off
    /// it where it was as it did, `thrown_from`, for the network to put where they get off.
    pub fn throw_player(mut self, vehicle: i32) {
        var player: i32? = none
        for (p, v, _) in self.riding_players {
            if v == vehicle {
                player = some(p)
            }
        }
        let rider = player else return
        let i = self.at[vehicle]
        var from: Body? = none
        if let held = self.all[i].take() {
            self.all[i] = some(match held {
                Entity.Mob(mb) => {
                    from = mb.thrown_from.copy()
                    Entity.Mob(mb)
                },
                other => other,
            })
        }
        let before = self.players_off.len()
        self.leave(rider, false)
        let b = from else return
        let box = b.bounding_box()
        var k = before
        while k < self.players_off.len() {
            self.players_off[k].x = b.x
            self.players_off[k].y = b.y
            self.players_off[k].z = b.z
            self.players_off[k].top = box.max_y
            self.players_off[k].bottom = box.min_y
            self.players_off[k].width = b.width
            self.players_off[k].yaw = b.y_rot
            k += 1
        }
    }

    /// The statistic a player riding the entity `vehicle` counts how far they go by,
    /// `checkRidingStatistics` (CAL-179): a pig's `pig_one_cm`, a horse's or its kin's
    /// `horse_one_cm`; none for what else Calcite has.
    pub fn riding_stat(self, vehicle: i32) -> str? {
        if not self.at.contains(vehicle) {
            return none
        }
        let e = self.all[self.at[vehicle]] else return none
        let Entity.Mob(m) = e else return none
        if m.species == PIG {
            return some("pig_one_cm")
        }
        if m.equine() {
            return some("horse_one_cm")
        }
        return none
    }

    /// The effects on the mob `vehicle`, which a player boarding it is sent and getting off it is
    /// told are gone, `sendActiveEffects` (CAL-179).
    pub fn effects_on(self, vehicle: i32) -> List<ActiveEffect> {
        if not self.at.contains(vehicle) {
            return List<ActiveEffect>()
        }
        let e = self.all[self.at[vehicle]] else return List<ActiveEffect>()
        let Entity.Mob(m) = e else return List<ActiveEffect>()
        return m.living.effects.copy()
    }

    /// The players who got off something since, as `unseat_player` and what threw or dropped
    /// them left them (CAL-179).
    pub fn take_players_off(mut self) -> List<Unseat> {
        let out = self.players_off.copy()
        self.players_off.clear()
        return out
    }

    /// Where the entity `vehicle` seats the player `player` riding it, as they look `y_rot`,
    /// `positionRider`: where it seats what rides it, as `position_rider` has it, less where a
    /// player's held, `DEFAULT_VEHICLE_ATTACHMENT`, 0.6 up; and the turn a horse gives them,
    /// `yBodyRot` (CAL-179). None where it doesn't carry them.
    pub fn player_seat(self, vehicle: i32, player: i32, y_rot: f32) -> ((f64, f64, f64), f32?)? {
        if not self.at.contains(vehicle) {
            return none
        }
        let (vb, seat, turn, rise) = self.seat_info(vehicle) else return none
        if not vb.passengers.contains(player) {
            return none
        }
        let (ax, ay, az) = turned(seat, vb.y_rot)
        let (ex, ey, ez) = turned(rise, vb.y_rot)
        let (hx, hy, hz) = turned((0.0, 0.6, 0.0), y_rot)
        return some(((vb.x + (ax + ex) - hx, vb.y + (ay + ey) - hy, vb.z + (az + ez) - hz), turn))
    }

    // The entity at `i`'s ID, what it rides, whether anything rides it, whether it's gone, and
    // whether it's alive, where it's there and not lent (D708).
    fn riding_at(self, i: usize) -> (i32, i32?, bool, bool, bool)? {
        let e = self.all[i] else return none
        let (id, rides, carries) = riding_of(e)
        return some((id, rides, carries, body_of(e).removed, alive_kind(e)))
    }

    // What rides `id` off it, `ejectPassengers`, last first, `gone` where it's gone.
    fn eject(mut self, id: i32, gone: bool) {
        let riders = self.passengers_of(id)
        var k = riders.len()
        while k > 0 {
            k -= 1
            self.leave(riders[k], gone)
        }
    }

    /// `dismountVehicle` of what got off something since (D708): where it's gone, as it is; else
    /// where what it rode isn't gone and isn't in a portal, `#portals`, where that puts it,
    /// `getDismountLocationForPassenger`: an animal's beside it, `Animal`'s, else on its box's
    /// top, `Entity`'s; else where it is, but no lower than what it rode, put out of the blocks
    /// there, `findFreePosition`, unless it's over 4 wide or tall. It's put there as it looks,
    /// `dismountTo`, `teleportTo`, `snapTo`, and so what rides it, `teleportPassengers`.
    pub fn seat_off<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B) {
        let offs = self.unseated.copy()
        self.unseated.clear()
        for off in offs {
            let b = self.body_at(off.rider) else continue
            if b.removed or b.vehicle != none {
                continue
            }
            let (at, _) = self.off_spot(f, m, blocks, off, (b.x, b.y, b.z), b.width, [b.height], b.mover())
            self.snap_to(off.rider, at)
        }
    }

    /// Where what got off as `off` has it, at `at`, `width` wide and as tall in each pose it may
    /// get off in as `heights` has it, first as it is, and `mover` for the blocks whose shapes
    /// depend on it, gets off, as `seat_off` puts it (D708), with the pose it's put in where it's
    /// put in one, `setPose` (CAL-179).
    pub fn off_spot<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, off: Unseat, at: (f64, f64, f64), width: f32, heights: List<f32>, mover: Mover) -> ((f64, f64, f64), usize?) {
        let border = self.border ?? (-2.9999984e7, -2.9999984e7, 2.9999984e7, 2.9999984e7)
        let vx = i32.saturate(off.x.floor())
        let vy = i32.saturate(off.y.floor())
        let vz = i32.saturate(off.z.floor())
        let portal = f.in_set(state_at(blocks, vx, vy, vz), f.tag("minecraft:portals"))
        if not off.gone and not portal {
            if off.horse {
                if let (spot, pose) = horse_dismount(f, m, blocks, border, off.x, off.z, off.bottom, off.top, off.yaw, off.width, off.left, width, heights, mover) {
                    return (spot, some(pose))
                }
                return ((off.x, off.y, off.z), none)
            }
            if off.animal {
                if let (spot, pose) = animal_dismount(f, m, blocks, border, off.x, off.y, off.z, off.yaw, width, heights, mover) {
                    return (spot, some(pose))
                }
            }
            return ((off.x, off.top, off.z), none)
        }
        let (x, y, z) = at
        let bottom = (x, if y > off.y { y } else { off.y }, z)
        return (free_position(f, m, blocks, border, bottom, width, heights[0], mover), none)
    }

    /// `handleMoveVehicle` for the mob `id` a player steers, their client having moved it `to`,
    /// turned `y_rot` and `x_rot`, on the ground or not, `ground`, from where it was as the
    /// player's tick began, `first_good`, and as their last move left it, `last_good` (CAL-179).
    /// Moved too quickly, it's sent back. Else it moves there as the player's moves do,
    /// `MoverType.PLAYER`, its client having the say, so no fall checked nor bounce, its steps
    /// heard, stepping up a block at least, `maxUpStep`; where it got a sixteenth of a block
    /// squared from there across, it moved wrongly, and is put back, turned as the client says,
    /// where its box had room, `noCollision`, or where there it meets what it didn't, as a
    /// player's move is, `isEntityCollidingWithAnythingNew`, its move forgotten,
    /// `removeLatestMovementRecording`. Else it's put there, `absSnapTo`, on the ground as the
    /// client says with its fall checked, `doCheckFallDamage`; floating where it didn't go down
    /// more than a thirty-second, didn't stand on anything before, flight's not allowed, it falls,
    /// and nothing's around it but air. What it showed is kept for the level.
    pub fn steered_move<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, id: i32, to: (f64, f64, f64), y_rot: f32, x_rot: f32, ground: bool, first_good: (f64, f64, f64), last_good: (f64, f64, f64), allow_flight: bool, fast_lava: bool, sounds: mut List<EntitySound>) -> Steered {
        if not self.at.contains(id) {
            return Steered.Nothing
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return Steered.Nothing
        var it = match taken {
            Entity.Mob(mob) => mob,
            other => {
                self.all[i] = some(other)
                return Steered.Nothing
            },
        }
        let (tx, ty, tz) = to
        let (ox, oy, oz) = (it.living.body.x, it.living.body.y, it.living.body.z)
        let (fx, fy, fz) = first_good
        let (fdx, fdy, fdz) = (tx - fx, ty - fy, tz - fz)
        let (bvx, bvy, bvz) = (it.living.body.vx, it.living.body.vy, it.living.body.vz)
        let expected = bvx * bvx + bvy * bvy + bvz * bvz
        if fdx * fdx + fdy * fdy + fdz * fdz - expected > 100.0 {
            let (yr, xr) = (it.living.body.y_rot, it.living.body.x_rot)
            self.all[i] = some(Entity.Mob(it))
            return Steered.TooQuick((ox, oy, oz), yr, xr)
        }
        let old_box = it.living.body.bounding_box()
        let (lx, ly, lz) = last_good
        let rests = it.living.body.vertical_below
        if it.living.on_climbable(lf, f, blocks) {
            it.living.body.reset_fall()
        }
        let step = it.living.body.step
        it.living.body.step = if step < 1.0f32 { 1.0f32 } else { step }
        it.living.body.owned = false
        it.living.move_self(lf, f, m, t, blocks, tx - lx, ty - ly, tz - lz, fast_lava, mut sounds)
        it.living.body.owned = true
        it.living.body.step = step
        let (wx, wz) = (tx - it.living.body.x, tz - it.living.body.z)
        let wrong = wx * wx + wz * wz > 0.0625
        let mover = it.living.body.mover()
        let room = m.colliders(f, blocks, old_box, mover).is_empty()
        let (yr, xr) = (y_rot % 360.0f32, clamp_f32(x_rot, -90.0f32, 90.0f32) % 360.0f32)
        if (wrong and room) or meets_new(f, m, blocks, it.living.body, old_box, tx, ty, tz) {
            snap_body(mut it.living, ox, oy, oz, yr, xr)
            it.living.body.forget_move()
            self.all[i] = some(Entity.Mob(it))
            self.move_section(id, section_key(ox, oy, oz))
            return Steered.Refused((ox, oy, oz), yr, xr, wrong)
        }
        snap_body(mut it.living, tx, ty, tz, yr, xr)
        let (cx, cy, cz) = (it.living.body.x, it.living.body.y, it.living.body.z)
        it.living.client_landed(lf, f, m, t, blocks, cx - ox, cy - oy, cz - oz, ground, fast_lava, mut sounds)
        let griefing = self.mob_griefing
        self.tramples(mut it.living, griefing, false)
        let floating = ty - ly >= -0.03125 and not rests and not allow_flight and not it.living.body.no_gravity and no_blocks_around(f, blocks, it.living.body.bounding_box())
        _ = self.keep_shown(id, mut it)
        self.all[i] = some(Entity.Mob(it))
        self.move_section(id, section_key(cx, cy, cz))
        return Steered.Taken((ox, oy, oz), (cx, cy, cz), wrong, floating)
    }

    // `snapTo` of the entity `id` to `at` as it looks, there last tick too, and what rides it
    // with it, `teleportPassengers` (D708).
    fn snap_to(mut self, id: i32, at: (f64, f64, f64)) {
        var b = self.body_at(id) else return
        let (x, y, z) = at
        b.x = x
        b.y = y
        b.z = z
        b.xo = x
        b.yo = y
        b.zo = z
        self.put_body(id, b)
        self.move_section(id, section_key(x, y, z))
        var carrying: List<i32> = [id]
        var k: usize = 0
        while k < carrying.len() {
            let v = carrying[k]
            for p in self.passengers_of(v) {
                self.position_rider(v, p, true)
                carrying.push(p)
            }
            k += 1
        }
    }

    // `positionRider` of the entity `rider` on `vehicle` (D708): where `vehicle` seats it,
    // `getPassengerRidingPosition`, its seat turned by its yaw, less where `rider` is held, turned
    // by its own, `setPos`, or `snapTo` where `snap`; a living rider of a chicken or a horse
    // turned as it is, `yBodyRot`. Nothing where `rider` doesn't ride it.
    fn position_rider(mut self, vehicle: i32, rider: i32, snap: bool) {
        if not self.at.contains(vehicle) or not self.at.contains(rider) {
            return
        }
        let (vb, seat, turn, rise) = self.seat_info(vehicle) else return
        if not vb.passengers.contains(rider) {
            return
        }
        let ri = self.at[rider]
        let re = self.all[ri].take() else return
        let rb = body_of(re)
        let (ax, ay, az) = turned(seat, vb.y_rot)
        let (ex, ey, ez) = turned(rise, vb.y_rot)
        let (sx, sy, sz) = (ax + ex, ay + ey, az + ez)
        let (hx, hy, hz) = turned(held_at(re), rb.y_rot)
        let (x, y, z) = (vb.x + sx - hx, vb.y + sy - hy, vb.z + sz - hz)
        var moved = rb
        moved.x = x
        moved.y = y
        moved.z = z
        if snap {
            moved.xo = x
            moved.yo = y
            moved.zo = z
        }
        var back = with_body(re, moved)
        if let r = turn {
            back = match back {
                Entity.Mob(rm) => {
                    var t = rm
                    t.living.y_body_rot = r
                    Entity.Mob(t)
                },
                Entity.Stand(ra) => {
                    var t = ra
                    t.living.y_body_rot = r
                    Entity.Stand(t)
                },
                other => other,
            }
        }
        self.all[ri] = some(back)
        self.move_section(rider, section_key(x, y, z))
    }

    // The body of the entity `vehicle`, a copy, where it seats what rides it before its turn, the
    // turn it gives a living rider, a chicken's and a horse's own, `yBodyRot` (D708), and how far
    // a horse's rise as it stands moves the seat up and back before its turn, by its rise last
    // tick, `standAnimO`, and its age's scale (D710).
    fn seat_info(self, vehicle: i32) -> (Body, (f64, f64, f64), f32?, (f64, f64, f64))? {
        let ve = self.all[self.at[vehicle]] else return none
        var turn: f32? = none
        var rise = (0.0, 0.0, 0.0)
        if let Entity.Mob(vm) = ve {
            if vm.species == CHICKEN or vm.equine() {
                turn = some(vm.living.y_body_rot)
            }
            if vm.equine() {
                let scale = f64(if vm.baby() { 0.5f32 } else { 1.0f32 })
                let o = f64(vm.stand_anim_o)
                rise = (0.0, 0.15 * o * scale, -0.7 * o * scale)
            }
        }
        return some((body_of(ve), seat_of(ve), turn, rise))
    }

    // Whether the entity `vehicle` is here, isn't gone and has `rider` among what rides it,
    // `hasPassenger` (D708).
    fn carries(self, vehicle: i32, rider: i32) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let e = self.all[self.at[vehicle]] else return true
        let b = body_of(e)
        return not b.removed and b.passengers.contains(rider)
    }

    /// `Entity.teleport` of the entity `id`, not a player, to x, y, z by an ender pearl of its own
    /// that landed in its level, `teleportSameDimension` (D585), where it may go,
    /// `isAllowedToTeleportOwner`: a living entity alive and not asleep, anything else not gone.
    /// It's put there, `teleportSetPosition`, at its own yaw and pitch, nothing relative, a living
    /// entity's head turned to its yaw, `setYHeadRot`; where it was last known forgotten,
    /// `reapplyPosition`; there last tick too, `setOldPosAndRot`; still, `Vec3.ZERO`; what it
    /// moved this tick forgotten, `clearMovementThisTick`; then nothing fallen,
    /// `resetFallDistance`, and a living entity's impulse forgotten, `resetCurrentImpulseContext`;
    /// and in the section it's in now, `onMove`. None where it isn't here or may not go.
    pub fn pearl_take(mut self, id: i32, x: f64, y: f64, z: f64) -> PearlTaken? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let e = self.all[i].take() else return none
        var taken: PearlTaken? = none
        let back = match e {
            Entity.Item(it) => {
                var t = it
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Item(t)
            },
            Entity.Orb(o) => {
                var t = o
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Orb(t)
            },
            Entity.Stand(a) => {
                var t = a
                if t.living.alive() {
                    taken = some(pearl_set_living(mut t.living, x, y, z))
                }
                Entity.Stand(t)
            },
            Entity.Mob(m) => {
                var t = m
                if t.living.alive() and t.living.sleeping == none {
                    taken = some(pearl_set_living(mut t.living, x, y, z))
                }
                Entity.Mob(t)
            },
            Entity.Arrow(a) => {
                var t = a
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Arrow(t)
            },
            Entity.Thrown(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Thrown(t)
            },
            Entity.Cloud(c) => {
                var t = c
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Cloud(t)
            },
            Entity.Crystal(c) => {
                var t = c
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Crystal(t)
            },
            Entity.Eye(eye) => {
                var t = eye
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Eye(t)
            },
            Entity.Fireball(b) => {
                var t = b
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Fireball(t)
            },
            Entity.Tnt(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Tnt(t)
            },
            Entity.Knot(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Knot(t)
            },
            Entity.Fangs(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Fangs(t)
            },
        }
        self.all[i] = some(back)
        if taken != none {
            self.move_section(id, section_key(x, y, z))
        }
        return taken
    }

    /// The items whose boxes meet `b`, but `except`, in the order `getEntitiesOfClass` finds them:
    /// the sections a little beyond it, by x, then by z and y as `SectionPos.asLong` orders them,
    /// and in each in the order they came into it.
    pub fn find(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 1)
    }

    /// The orbs whose boxes meet `b`, but `except`, as `find` finds items.
    pub fn find_orbs(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 2)
    }

    /// Every item, orb, mob and arrow whose box meets `b`, but `except`, as `getEntities` finds
    /// them, which a player touches; an armor stand does nothing touched, `playerTouch`, and of
    /// mobs only a slime does (CAL-159).
    pub fn find_any(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 27)
    }

    /// Every item, orb, armor stand, mob, arrow, thrown potion, cloud, end crystal, eye of ender,
    /// dragon fireball and primed TNT whose box meets `b`, but `except`, as `getEntities(except,
    /// box)` finds them, which keep an enderman from leaving its block there (CAL-159, D527, D529,
    /// D589, D598, D618, CAL-182).
    pub fn find_every(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 2047)
    }

    /// How many end crystals' boxes meet `b`, `getEntitiesOfClass(EndCrystal.class, box)`, those
    /// gone left out, as they're out of their sections, which a dragon fight counts (D626).
    pub fn crystals_in(self, b: Aabb) -> i32 {
        return i32.wrap(self.crystals_found(b).len())
    }

    /// The end crystals whose boxes meet `b`, `getEntitiesOfClass(EndCrystal.class, box)`, as
    /// `crystals_in` finds them, each with its UUID (CAL-167).
    pub fn crystals_found(self, b: Aabb) -> List<(i32, (i64, i64))> {
        var out = List<(i32, (i64, i64))>()
        for id in self.found(b, -1, 128) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Crystal(c) = slot else continue
            if not c.body.removed {
                out.push((id, c.body.uuid))
            }
        }
        return out
    }

    /// The ID of the end crystal here of the UUID `uuid` that isn't gone, `getEntity(uuid)` of an
    /// `EndCrystal` (CAL-167).
    pub fn crystal_with_uuid(self, uuid: (i64, i64)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            let Entity.Crystal(c) = e else continue
            if c.body.uuid == uuid and not c.body.removed {
                return some(c.body.id)
            }
        }
        return none
    }

    /// What an explosion asks of the entity `id`, `resistance` the attribute of a living one's
    /// explosion knockback resistance, none where it isn't here (CAL-182).
    pub fn reached(self, id: i32, resistance: u32) -> Reached? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(match e {
            Entity.Item(i) => reached_body(i.body, 1, false, 0.0),
            Entity.Orb(o) => reached_body(o.body, 2, false, 0.0),
            Entity.Stand(a) => reached_body(a.living.body, 4, a.invisible, a.living.attributes.value(resistance)),
            Entity.Mob(m) => reached_body(m.living.body, 8, false, m.living.attributes.value(resistance)),
            Entity.Arrow(a) => reached_body(a.body, 16, false, 0.0),
            Entity.Thrown(p) => reached_body(p.body, 32, false, 0.0),
            Entity.Cloud(c) => reached_body(c.body, 64, false, 0.0),
            Entity.Crystal(c) => reached_body(c.body, 128, false, 0.0),
            Entity.Eye(eye) => reached_body(eye.body, 256, false, 0.0),
            Entity.Fireball(b) => reached_body(b.body, 512, false, 0.0),
            // Pushed from its feet, not its eyes, `entityOrigin`.
            Entity.Tnt(p) => reached_feet(p.body, 1024),
            Entity.Knot(k) => reached_body(k.body, 2048, false, 0.0),
            Entity.Fangs(k) => reached_body(k.body, 8192, false, 0.0),
        })
    }

    /// `pushFromExplosion` of the entity `id`, `Entity.push`: its motion more by x, y, z where
    /// each is finite, and its tracker to send it (CAL-182).
    pub fn push_entity(mut self, id: i32, x: f64, y: f64, z: f64) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(pushed_by(e, x, y, z))
    }

    /// `Projectile.hurtServer` of the entity `id`, where it's an arrow or a thrown item, as an
    /// explosion hurts it (CAL-182): its motion to be sent, `markHurt`, unless it's gone or
    /// invulnerable, as one in the ground, which isn't pushed, has it sent too.
    pub fn projectile_hurt(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(match e {
            Entity.Arrow(a) => {
                var it = a
                mark_hurt(mut it.body)
                Entity.Arrow(it)
            },
            Entity.Thrown(p) => {
                var it = p
                mark_hurt(mut it.body)
                Entity.Thrown(it)
            },
            other => other,
        })
    }

    /// What an explosion asks of the ender dragons' parts whose boxes meet `b`, as `getEntities`
    /// finds them after the rest, but those of the dragon `except` (D667): each part's ID, its
    /// box, its place, `setPos`'s, and its eyes, `EntityDimensions.scalable`'s, 0.85 of its
    /// height, as nothing that resists a push and doesn't fall, of the kind 1024. Vanilla's are
    /// in its map's order, by their IDs' hashes, which Calcite's, by dragon and part, needn't
    /// be: a dragon hurt through each in turn takes no more than the most of them.
    pub fn parts_reached(self, b: Aabb, except: i32) -> List<Reached> {
        var out = List<Reached>()
        var seen = List<i32>()
        for (owner, _) in self.dragon_parts {
            if owner == except or seen.contains(owner) or not self.at.contains(owner) {
                continue
            }
            seen.push(owner)
            let slot = self.all[self.at[owner]] else continue
            let Entity.Mob(m) = slot else continue
            let dr = m.dragon else continue
            for i in 0..PARTS {
                let bounds = dr.boxed(i)
                if not bounds.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                    continue
                }
                let (x, y, z) = dr.parts[i]
                let (_, h) = part_size(i)
                let id = owner + 1 + i32.wrap(i)
                out.push(Reached { id: id, bounds: bounds, x: x, y: y, z: z, eyes: f64(h * 0.85f32), mover: Mover { y: y, fall: 0.0 }, kind: 1024, invisible: false, resistance: 0.0 })
            }
        }
        return out
    }

    /// The ender dragon whose part the ID `id` is, and which part, as `PARTS` orders them, where
    /// it's here (D667).
    pub fn part_of(self, id: i32) -> (i32, usize)? {
        for k in 1..9 {
            let owner = id - k
            if not self.at.contains(owner) or not self.is_mob(owner) {
                continue
            }
            let slot = self.all[self.at[owner]] else continue
            let Entity.Mob(m) = slot else continue
            if m.dragon == none {
                continue
            }
            let at = part_index(owner, id) else continue
            return some((owner, at))
        }
        return none
    }

    /// The armor stands and mobs whose boxes meet `b`, but `except`, as `getEntitiesOfClass` finds
    /// living entities but players, which a sweep hits (D417).
    pub fn find_living(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 12)
    }

    /// Whether anything here has a box meeting `b`, an ender dragon's parts among them, as
    /// `getEntities(null, b)` finds any but spectators, which only players are (CAL-167).
    pub fn any_in(self, b: Aabb) -> bool {
        return not self.found(b, -1, 2047).is_empty() or not self.parts_targets(b).is_empty()
    }

    /// `getEntityCount` of the pressure plate at `at` as the entity `id` went into it, its box then
    /// `boxed`, none where it ignores block triggers, and living where `alive` (D701): how many here
    /// have boxes meeting the plate's `TOUCH_AABB`, `id` by `boxed` as its tick may have it lent, but
    /// those ignoring block triggers, marker armor stands, every one, an ender dragon's parts
    /// among them, `Entity.class`, and the living ones, `LivingEntity.class`. Players are their
    /// level's to count.
    pub fn plate_counts(self, at: (i32, i32, i32), id: i32, boxed: Aabb?, alive: bool) -> (i32, i32) {
        let (x, y, z) = at
        let b = Aabb { min_x: f64(x) + 0.0625, min_y: f64(y), min_z: f64(z) + 0.0625, max_x: f64(x) + 0.9375, max_y: f64(y) + 0.25, max_z: f64(z) + 0.9375 }
        var all = 0
        var living = 0
        if let o = boxed {
            if o.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                all += 1
                if alive {
                    living += 1
                }
            }
        }
        for other in self.found(b, id, 2047) {
            let e = self.all[self.at[other]] else continue
            match e {
                Entity.Stand(a) => {
                    if not a.marker() {
                        all += 1
                        living += 1
                    }
                },
                Entity.Mob(_) => {
                    all += 1
                    living += 1
                },
                _ => all += 1,
            }
        }
        all += i32.wrap(self.parts_reached(b, id).len())
        return (all, living)
    }

    /// The boxes of the entities here but those ignoring block triggers, marker armor stands, each
    /// with whether it's living, an ender dragon's parts among them, for a pressure plate's tick to
    /// count, `TickPlace.touchers` (D701).
    pub fn touchers(self) -> List<(Aabb, bool)> {
        var out = List<(Aabb, bool)>()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Stand(a) => {
                    if not a.marker() and not a.living.body.removed {
                        out.push((a.living.body.bounding_box(), true))
                    }
                },
                Entity.Mob(m) => {
                    if not m.living.body.removed {
                        out.push((m.living.body.bounding_box(), true))
                        if let dr = m.dragon {
                            for i in 0..PARTS {
                                out.push((dr.boxed(i), false))
                            }
                        }
                    }
                },
                _ => out.push((box_of(e), false)),
            }
        }
        return out
    }

    // Those of the kinds `kinds` whose boxes meet `b`, 1 items, 2 orbs, 4 armor stands, 8 mobs, 16
    // arrows, 32 thrown potions, 64 clouds, 128 end crystals, 256 eyes of ender, 512 dragon
    // fireballs, 1024 primed TNT and 2048 leash knots; and with `PLAYERS`, the players in the
    // sections looked at, in their places among the rest, whose boxes the caller tests, as it
    // has them (CAL-190).
    fn found(self, b: Aabb, except: i32, kinds: i32) -> List<i32> {
        var out = List<i32>()
        let x0 = section(b.min_x - 2.0)
        let y0 = section(b.min_y - 4.0)
        let z0 = section(b.min_z - 2.0)
        let x1 = section(b.max_x + 2.0)
        let y1 = section(b.max_y + 0.0)
        let z1 = section(b.max_z + 2.0)
        for sx in x0..=x1 {
            var keys = List<i64>()
            for sz in z0..=z1 {
                for sy in y0..=y1 {
                    let key = pack(sx, sy, sz)
                    if self.sections.contains(key) and not self.sections[key].is_empty() {
                        keys.push(key)
                    }
                }
            }
            keys.sort()
            for key in keys {
                for id in self.sections[key] {
                    if id == except {
                        continue
                    }
                    if self.players_in.contains(id) {
                        if kinds & PLAYERS != 0 {
                            out.push(id)
                        }
                        continue
                    }
                    if not self.at.contains(id) {
                        continue
                    }
                    let e = self.all[self.at[id]] else continue
                    let kind = match e {
                        Entity.Item(_) => 1,
                        Entity.Orb(_) => 2,
                        Entity.Stand(_) => 4,
                        Entity.Mob(_) => 8,
                        Entity.Arrow(_) => 16,
                        Entity.Thrown(_) => 32,
                        Entity.Cloud(_) => 64,
                        Entity.Crystal(_) => 128,
                        Entity.Eye(_) => 256,
                        Entity.Fireball(_) => 512,
                        Entity.Tnt(_) => 1024,
                        Entity.Knot(_) => 2048,
                        Entity.Fangs(_) => 8192,
                    }
                    if kind & kinds == 0 {
                        continue
                    }
                    let other = box_of(e)
                    if other.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        out.push(id)
                    }
                }
            }
        }
        return out
    }

    /// `ExperienceOrb.tryMergeToExisting`: the first orb in the box a block across around x, y,
    /// z that `can_merge` with `pick`, the level random's `nextInt(40)`, and `value` counts one
    /// more and starts its age again; whether there was one.
    pub fn merge_award(mut self, x: f64, y: f64, z: f64, value: i32, pick: i32) -> bool {
        let b = Aabb { min_x: x - 0.5, min_y: y - 0.5, min_z: z - 0.5, max_x: x + 0.5, max_y: y + 0.5, max_z: z + 0.5 }
        for id in self.find_orbs(b, -1) {
            let o = self.orb_view(id) else continue
            if not can_merge(o, pick, value) {
                continue
            }
            var taken = self.lend_orb(id) else continue
            taken.count += 1
            taken.age = 0
            self.give_back_orb(taken)
            return true
        }
        return false
    }

    // The orb `id`, where it's here and an orb, to read.
    fn orb_view(self, id: i32) -> ExperienceOrb? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Orb(o) = slot else return none
        return some(o.copy())
    }

    /// A tick of every entity there is that ticks, as `ServerLevel.tick` runs its tick list, among
    /// `blocks`, in a level whose floor is `min_y`, where lava's fast if `fast_lava`, with no
    /// players for orbs to follow; the sounds they play go to `sounds`.
    pub fn tick<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.begin_tick()
        let nobody = List<Follower>()
        while self.tick_next(u64.MAX, f, m, t, lf, codecs, blocks, min_y, fast_lava, nobody, mut sounds) {}
        self.end_tick()
    }

    /// Starts a tick of the entities there are now.
    pub fn begin_tick(mut self) {
        self.cursor = 0
        self.end = self.tick_list.len()
    }

    /// Ticks the tick's next entity if it came into the level before `before`, as `tick` does,
    /// orbs following `players`, the level's in its order, and says whether there was one; the
    /// sounds it plays go to `sounds`, which starts empty.
    pub fn tick_next<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, before: u64, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        self.take_sent(lf, f, m, blocks, min_y)
        if not self.unseated.is_empty() {
            self.seat_off(f, m, blocks)
        }
        if let stopped = self.paused.take() {
            let (at, entered, bred) = stopped
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_rest(at, mob, entered, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                Entity.Item(e) => self.all[at] = some(Entity.Item(e)),
                Entity.Orb(o) => self.all[at] = some(Entity.Orb(o)),
                Entity.Stand(a) => self.all[at] = some(Entity.Stand(a)),
                Entity.Arrow(a) => self.all[at] = some(Entity.Arrow(a)),
                Entity.Thrown(p) => self.all[at] = some(Entity.Thrown(p)),
                Entity.Cloud(c) => self.all[at] = some(Entity.Cloud(c)),
                Entity.Crystal(c) => self.all[at] = some(Entity.Crystal(c)),
                Entity.Eye(e) => self.all[at] = some(Entity.Eye(e)),
                Entity.Fireball(b) => self.all[at] = some(Entity.Fireball(b)),
                Entity.Tnt(p) => self.all[at] = some(Entity.Tnt(p)),
                Entity.Knot(p) => self.all[at] = some(Entity.Knot(p)),
                Entity.Fangs(p) => self.all[at] = some(Entity.Fangs(p)),
            }
            return true
        }
        if let stopped_start = self.paused_start.take() {
            let (at, bred) = stopped_start
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_used(at, mob, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                other => self.all[at] = some(other),
            }
            return true
        }
        if let stopped_use = self.paused_use.take() {
            let (at, bred) = stopped_use
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_on(at, mob, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                other => self.all[at] = some(other),
            }
            return true
        }
        if let stopped_at = self.paused_arrow.take() {
            self.heard = 0
            let held = self.all[stopped_at].take() else return true
            match held {
                Entity.Arrow(a) => self.arrow_on(stopped_at, a, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds),
                other => self.all[stopped_at] = some(other),
            }
            return true
        }
        // The tick that went on done, what rides it ticks next, `tickPassenger` (D708).
        if let done = self.ticking.take() {
            let (done_id, rode) = done
            self.ride_done(done_id, rode)
            // What it threw off is off where it put them before anything else ticks (D710).
            if not self.unseated.is_empty() {
                self.seat_off(f, m, blocks)
            }
        }
        if let next = self.riders.pop() {
            let (vehicle, rider) = next
            self.ride_tick(vehicle, rider, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return true
        }
        while self.cursor < self.end {
            match self.tick_list[self.cursor] {
                some(_) => break,
                none => self.cursor += 1,
            }
        }
        if self.cursor >= self.end {
            return false
        }
        let next_id = self.tick_list[self.cursor] else return false
        let i = self.at[next_id]
        let held = self.all[i].take() else return false
        let taken = opened(held, self.portal_open, self.end_portal_open)
        let (x, _, z) = place_of(taken)
        if entered_of(taken) >= before {
            self.all[i] = some(taken)
            return false
        }
        self.cursor += 1
        self.heard = 0
        // What's in the tick list looks at whether it goes, `checkDespawn`, and of that, what's in
        // range ticks, as `ServerLevel.tick` runs its tick list (D452).
        let (cx, cz) = (i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
        let listed = blocks.listed(cx, cz)
        let ticks = listed and blocks.ticks_entities(cx, cz)
        // What rides something that has it ticks after that, `tickPassenger`, here only looking at
        // whether it goes, which it never does from afar while it rides; what rides something gone
        // gets off it and ticks as it is (D708).
        let (own_id, rides, _) = riding_of(taken)
        if let vehicle = rides {
            if ticks and self.carries(vehicle, own_id) {
                match taken {
                    Entity.Mob(mob) => {
                        var a = mob
                        let nearest = nearest_to(a, players)
                        if a.check_despawn(self.peaceful, nearest) {
                            a.living.body.removed = true
                            self.all[i] = some(Entity.Mob(a))
                            self.remove(own_id)
                        } else {
                            self.all[i] = some(Entity.Mob(a))
                        }
                    },
                    other => self.all[i] = some(other),
                }
                return true
            }
            if ticks {
                self.all[i] = some(taken)
                self.stop_riding(own_id)
                let again = self.all[i].take() else return true
                return self.tick_at(i, again, true, true, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
            }
        }
        return self.tick_at(i, taken, listed, ticks, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
    }

    // A passenger's tick, `tickPassenger` (D708): what's gone or rides something else now gets off;
    // else, still, `rideTick`, it ticks as it does, then its vehicle positions it, as its tick's
    // done, `ride_done`.
    fn ride_tick<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, vehicle: i32, rider: i32, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        if not self.at.contains(rider) {
            // A player riding it, whose ride the network ticks now (CAL-179).
            if self.riding_player(rider) != none and self.carries_player(vehicle, rider) {
                self.player_ride = some((vehicle, rider))
                return
            }
            self.drop_rider(vehicle, rider)
            return
        }
        let i = self.at[rider]
        let (_, rides, _, removed, _) = self.riding_at(i) else return
        if removed or rides != some(vehicle) {
            self.stop_riding(rider)
            return
        }
        // What's alive gets off what goes under water as its eyes are in water, but for a bubble
        // column there, `dismountsUnderwater`, put where it gets off, and ticks as it is (D710).
        if self.off_underwater(vehicle, i, f, t, blocks) {
            self.stop_riding(rider)
            self.seat_off(f, m, blocks)
            let off = self.all[i].take() else return
            _ = self.tick_at(i, stilled(off), true, true, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        let lent = self.steering_for(vehicle, rider, lf)
        let mount = match self.body_at(vehicle) {
            some(vb) => some(vb.bounding_box()),
            none => none,
        }
        let held = self.all[i].take() else return
        self.heard = 0
        self.ticking = some((rider, some(vehicle)))
        // A mob that steers what it rides has that one's navigation and move control for its
        // tick (D710).
        let given = match stilled(held) {
            Entity.Mob(mb) => {
                var r = mb
                r.steering = lent
                r.mount_box = mount
                Entity.Mob(r)
            },
            other => other,
        }
        let ready = opened(given, self.portal_open, self.end_portal_open)
        _ = self.tick_at(i, ready, true, true, f, m, t, lf, codecs, blocks, min_y, fast_lava, players, mut sounds)
    }

    // Whether the living entity at `i` gets off the mob `vehicle` it rides as its tick begins
    // (D710), `LivingEntity.baseTick`: `vehicle` of `#dismounts_underwater`, of which Calcite makes
    // the pig, chicken, horse, donkey, spider and zombie horse, and the rider alive with its eyes
    // in water where it sits, `isEyeInFluid`, and no bubble column at them.
    fn off_underwater<B: CollisionBlocks>(self, vehicle: i32, i: usize, f: Facts, t: BodyFacts, blocks: B) -> bool {
        if not self.at.contains(vehicle) {
            return false
        }
        let ve = self.all[self.at[vehicle]] else return false
        let Entity.Mob(v) = ve else return false
        let kind = v.species
        if not (kind == PIG or kind == CHICKEN or kind == HORSE or kind == DONKEY or kind == SPIDER or kind == ZOMBIE_HORSE) {
            return false
        }
        let re = self.all[i] else return false
        let alive = match re {
            Entity.Mob(rm) => rm.living.alive(),
            Entity.Stand(ra) => ra.living.alive(),
            _ => false,
        }
        if not alive {
            return false
        }
        let b = body_of(re)
        let eye = b.y + f64(b.eyes)
        let r = fluids_seen(f, t.flow, blocks, b.bounding_box(), true, some((floor(b.x), eye, floor(b.z))))
        if not r.water_eyes {
            return false
        }
        let at = blocks.collision_state(floor(b.x), floor(eye), floor(b.z)) ?? 0
        return f.block(at) != t.bubble_column
    }

    // The mob `vehicle` turned toward the player the mob `rider` that steers it turned it to this
    // tick, `Mob.lookAt` at most 30 degrees each way (D710).
    fn turn_steered(mut self, rider: i32, vehicle: i32) {
        if not self.at.contains(rider) or not self.at.contains(vehicle) {
            return
        }
        let ri = self.at[rider]
        let held = self.all[ri].take() else return
        var to: Follower? = none
        self.all[ri] = some(match held {
            Entity.Mob(mb) => {
                var a = mb
                to = a.turns_vehicle.take()
                Entity.Mob(a)
            },
            other => other,
        })
        let p = to else return
        let vi = self.at[vehicle]
        let mount = self.all[vi].take() else return
        self.all[vi] = some(match mount {
            Entity.Mob(vm) => {
                var v = vm
                v.look_at_now(p, 30.0f32, 30.0f32)
                Entity.Mob(v)
            },
            other => other,
        })
    }

    // What rides the mob `id` off it, last first, `ejectPassengers`, where it threw them off this
    // tick, a horse running around, each put off where it was as it did (D710).
    fn throw_riders(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let held = self.all[i].take() else return
        var from: Body? = none
        self.all[i] = some(match held {
            Entity.Mob(mb) => {
                var a = mb
                from = a.thrown_from.take()
                Entity.Mob(a)
            },
            other => other,
        })
        let b = from else return
        let box = b.bounding_box()
        var k = b.passengers.len()
        while k > 0 {
            k -= 1
            let before = self.unseated.len()
            let players_before = self.players_off.len()
            self.leave(b.passengers[k], false)
            var u = before
            while u < self.unseated.len() {
                self.unseated[u].x = b.x
                self.unseated[u].y = b.y
                self.unseated[u].z = b.z
                self.unseated[u].top = box.max_y
                self.unseated[u].bottom = box.min_y
                self.unseated[u].width = b.width
                self.unseated[u].yaw = b.y_rot
                u += 1
            }
            // And a player it threw (CAL-179).
            var p = players_before
            while p < self.players_off.len() {
                self.players_off[p].x = b.x
                self.players_off[p].y = b.y
                self.players_off[p].z = b.z
                self.players_off[p].top = box.max_y
                self.players_off[p].bottom = box.min_y
                self.players_off[p].width = b.width
                self.players_off[p].yaw = b.y_rot
                p += 1
            }
        }
    }

    // What the mob `rider` steers of the mob `vehicle` it rides, where it does (D710): `vehicle`
    // with AI and `rider` first of what rides it and a mob that may steer, `getControllingPassenger`.
    fn steering_for(self, vehicle: i32, rider: i32, lf: LivingFacts) -> Steering? {
        if not self.at.contains(vehicle) or not self.may_steer(rider) {
            return none
        }
        let slot = self.all[self.at[vehicle]] else return none
        let Entity.Mob(v) = slot else return none
        if v.no_ai() or v.living.body.passengers.is_empty() or v.living.body.passengers[0] != rider {
            return none
        }
        return some(v.steering_of(lf))
    }

    // Whether the entity `id` is a mob that may steer what it rides (D710), `canControlVehicle`:
    // not of `#non_controlling_rider`, of which Calcite makes only the slime.
    fn may_steer(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Mob(m) = slot else return false
        return not cube_kind(m.species)
    }

    // The mob `vehicle`'s navigation and move control as the mob that steered it left them
    // (D710), where it's here.
    fn steered_back(mut self, vehicle: i32, s: Steering) {
        if not self.at.contains(vehicle) {
            return
        }
        let i = self.at[vehicle]
        let held = self.all[i].take() else return
        self.all[i] = some(match held {
            Entity.Mob(m) => {
                var t = m
                t.steered_by(s)
                Entity.Mob(t)
            },
            other => other,
        })
    }

    // The body's turn of the entity `id`, where it's a mob, and whether it finds its way as a
    // `PathfinderMob` does, all Calcite's mobs but slimes and the ender dragon (D710).
    fn body_turn_of(self, id: i32?) -> (f32, bool) {
        let v = id else return (0.0f32, false)
        if not self.at.contains(v) {
            return (0.0f32, false)
        }
        let slot = self.all[self.at[v]] else return (0.0f32, false)
        let Entity.Mob(m) = slot else return (0.0f32, false)
        return (m.living.y_body_rot, not cube_kind(m.species) and m.species != ENDER_DRAGON)
    }

    // `rider` dropped from what rides `vehicle`, where it's gone from the level (D708).
    fn drop_rider(mut self, vehicle: i32, rider: i32) {
        var vb = self.body_at(vehicle) else return
        var kept = List<i32>()
        for p in vb.passengers {
            if p != rider {
                kept.push(p)
            }
        }
        vb.passengers = kept
        self.put_body(vehicle, vb)
        self.share_riders(vehicle)
    }

    // The entity `id`'s tick done (D708): where it rode `rode`, its vehicle positions it,
    // `positionRider`, and what's alive forgets its fall, `LivingEntity.rideTick`; then what rides
    // it ticks next, in order, `tickPassenger`.
    fn ride_done(mut self, id: i32, rode: i32?) {
        self.throw_riders(id)
        if rode != none {
            // What it steered turned toward its target first, as its tick did (D710).
            if let v = rode {
                self.turn_steered(id, v)
            }
            if let v = self.vehicle_of(id) {
                self.position_rider(v, id, false)
            }
            // What it steered, which takes back its navigation and move control, and whose body's
            // turn it takes where that one finds its way, `Mob.rideTick`'s `PathfinderMob` (D710).
            var steered: Steering? = none
            let (turn, pathfinder) = self.body_turn_of(rode)
            if self.at.contains(id) {
                let i = self.at[id]
                if let held = self.all[i].take() {
                    self.all[i] = some(match held {
                        Entity.Mob(mb) => {
                            var a = mb
                            a.living.body.fall = 0.0
                            a.mount_box = none
                            steered = a.take_steering()
                            let steers = match steered {
                                some(_) => true,
                                none => false,
                            }
                            if steers and pathfinder {
                                a.living.y_body_rot = turn
                            }
                            Entity.Mob(a)
                        },
                        Entity.Stand(st) => {
                            var a = st
                            a.living.body.fall = 0.0
                            Entity.Stand(a)
                        },
                        other => other,
                    })
                }
            }
            if let s = steered {
                if let v = rode {
                    self.steered_back(v, s)
                }
            }
        }
        let riders = self.passengers_of(id)
        var k = riders.len()
        while k > 0 {
            k -= 1
            self.riders.push((id, riders[k]))
        }
    }

    // The tick of the entity `taken` at `i`, as the tick list has it: what's in a chunk that ticks
    // entities ticks, and a mob in one listed looks at whether it goes, `checkDespawn` (D452);
    // the entity marked as ticking, for what rides it to tick after it (D708).
    fn tick_at<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, i: usize, taken: own Entity, listed: bool, ticks: bool, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        if ticks and self.ticking == none {
            let (own_id, _, _) = riding_of(taken)
            self.ticking = some((own_id, none))
        }
        match taken {
            Entity.Item(e) => {
                if ticks {
                    self.tick_item(i, e, f, m, t, lf.damage, codecs, blocks, min_y, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Item(e))
                }
            },
            Entity.Orb(o) => {
                if ticks {
                    self.tick_orb(i, o, f, m, t, lf.damage, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Orb(o))
                }
            },
            Entity.Stand(a) => {
                if ticks {
                    self.tick_stand(i, a, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Stand(a))
                }
            },
            Entity.Mob(mob) => {
                if listed {
                    self.tick_mob(i, mob, ticks, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Mob(mob))
                }
            },
            Entity.Arrow(a) => {
                if ticks {
                    self.tick_arrow(i, a, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Arrow(a))
                }
            },
            Entity.Thrown(p) => {
                if ticks {
                    self.tick_thrown(i, p, f, m, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Thrown(p))
                }
            },
            Entity.Cloud(c) => {
                if ticks {
                    self.tick_cloud(i, c, lf, f, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Cloud(c))
                }
            },
            Entity.Crystal(c) => {
                if ticks {
                    self.tick_crystal(i, c, lf, f, t, blocks, mut sounds)
                } else {
                    self.all[i] = some(Entity.Crystal(c))
                }
            },
            Entity.Eye(e) => {
                if ticks {
                    self.tick_eye(i, e, f, t, blocks, min_y, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Eye(e))
                }
            },
            Entity.Fireball(b) => {
                if ticks {
                    self.tick_fireball(i, b, f, m, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Fireball(b))
                }
            },
            Entity.Tnt(p) => {
                if ticks {
                    self.tick_tnt(i, p, f, m, t, blocks, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Tnt(p))
                }
            },
            Entity.Knot(p) => {
                if ticks {
                    self.tick_knot(i, p, f, t, blocks, min_y, mut sounds)
                } else {
                    self.all[i] = some(Entity.Knot(p))
                }
            },
            Entity.Fangs(p) => {
                if ticks {
                    self.tick_fangs(i, p, min_y, sounds.len())
                } else {
                    self.all[i] = some(Entity.Fangs(p))
                }
            },
        }
        return true
    }

    // Fangs' tick, at `i` (CAL-200), `EvokerFangs.tick`, `heard` the sounds so far: their bite
    // shown, entity event 4, and their bite, `Shown.Fanged`, which their level does, after the
    // sounds so far; gone once their life's out.
    fn tick_fangs(mut self, i: usize, fangs: own EvokerFangs, min_y: i32, heard: usize) {
        var p = fangs
        let out = p.tick(min_y)
        let id = p.body.id
        if out.bite {
            let b = p.body.bounding_box()
            let reach = Aabb { min_x: b.min_x - 0.2, min_y: b.min_y, min_z: b.min_z - 0.2, max_x: b.max_x + 0.2, max_y: b.max_y, max_z: b.max_z + 0.2 }
            self.shown.push(Shown.Fanged(Fanged { id: id, uuid: p.body.uuid, owner: p.owner, x: p.body.x, y: p.body.y, z: p.body.z, reach: reach }))
            self.shown_by.push(id)
            self.shown_after.push(heard)
        }
        if out.spike {
            self.shown.push(Shown.Event(4i8))
            self.shown_by.push(id)
            self.shown_after.push(heard)
        }
        let removed = p.body.removed
        self.all[i] = some(Entity.Fangs(p))
        self.heard = heard
        if removed {
            self.remove(id)
        }
    }

    // A leash knot's tick, at `i` (CAL-179): `BlockAttachedEntity.tick`, and where it's time to
    // look and its fence, one of `fences`, isn't at its place, `survives`, it's gone, `discard`,
    // its removal sent before its sound's heard, `dropItem`.
    fn tick_knot<B: CollisionBlocks>(mut self, i: usize, knot: own LeashKnot, f: Facts, t: BodyFacts, blocks: B, min_y: i32, sounds: mut List<EntitySound>) {
        var k = knot
        var heard: EntitySound? = none
        if k.tick(min_y) {
            let (x, y, z) = k.at
            let state = blocks.collision_state(x, y, z) ?? 0
            if not f.in_set(state, t.fences) {
                heard = k.untie()
            }
        }
        let id = k.body.id
        let removed = k.body.removed
        self.all[i] = some(Entity.Knot(k))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        }
        if let s = heard {
            sounds.push(s)
        }
    }

    // Primed TNT's tick, at `i` (CAL-182): `PrimedTnt.tick`, what blocks did to it kept as what a
    // living entity shows is, and the fall it took onto farmland drawn for, as it's never big
    // enough to trample it; then, where its fuse ran out, its explosion, `Shown.Blew`, for its
    // level to make before its removal's sent, after its tick's sounds.
    fn tick_tnt<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, tnt: own PrimedTnt, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        var p = tnt
        let out = p.tick(f, m, t, blocks, fast_lava, mut sounds)
        if let landed = p.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        if out {
            let (x, y, z) = p.blast_at()
            self.shown.push(Shown.Blew(Blast { at: (p.body.x, p.body.y, p.body.z), x: x, y: y, z: z, power: p.power, portal: p.used_portal, owner: p.owner, silent: p.silent() }))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(p.body.x, p.body.y, p.body.z)
        let removed = p.body.removed
        self.all[i] = some(Entity.Tnt(p))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // A dragon fireball's or a wind charge's tick, at `i` (D618, CAL-182): kept where it was,
    // `tick_begin`, a wind charge above the world's top by more than 30 bursting there, nothing
    // else done; to where it looks for what it may hit, `tick_start`; the nearest of what it may
    // hit, `fireball_targets`, its owner found among the level's entities and `players`; its move
    // there, `go`; the end of its tick, `tick_end`; then, where it hit something, `fireball_hit`.
    fn tick_fireball<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, fireball: own Fireball, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var b = fireball
        b.tick_begin()
        if b.kind == SHULKER_BULLET and self.peaceful {
            // `ShulkerBullet.checkDespawn`: gone in peaceful (CAL-200).
            b.body.removed = true
        } else if b.kind == SHULKER_BULLET {
            // `ShulkerBullet.tick` (CAL-200): `Projectile.tick`'s first, `tick_end`, its target
            // found, its way, what it meets, its move, its hit, then its turn and its steps.
            let owner = self.owner_of(b.owner, players)
            b.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
            let target = self.homing_of(b.target, players)
            if target == none {
                b.target = none
            }
            let border = self.border ?? widest_border()
            b.bullet_start(target, f, m, blocks, border)
            let targets = self.bullet_targets(b, owner, players)
            let hit = b.nearest(targets)
            b.bullet_go(f, blocks, mut sounds)
            if not b.body.removed {
                if let struck = b.bullet_hit(hit) {
                    let id = b.body.id
                    if hit == none and not b.way.border {
                        let state = blocks.collision_state(b.way.bx, b.way.by, b.way.bz) ?? 0
                        if let missing = struck_missing(f, state, "a shulker's bullet") {
                            b.acted.push(Acted.Missing(missing))
                            b.acted_after.push(sounds.len())
                        }
                    }
                    self.keep_acted(id, b.body.bounding_box(), b.acted, b.acted_after)
                    b.acted.clear()
                    b.acted_after.clear()
                    self.shown.push(Shown.Fireballed(struck))
                    self.shown_by.push(id)
                    self.shown_after.push(sounds.len())
                    b.body.removed = true
                }
            }
            b.bullet_end(target, f, blocks)
        } else if let high = b.burst_above(self.max_y) {
            self.shown.push(Shown.Fireballed(high))
            self.shown_by.push(b.body.id)
            self.shown_after.push(sounds.len())
            b.body.removed = true
        } else {
            let owner = self.owner_of(b.owner, players)
            let border = self.border ?? widest_border()
            b.tick_start(f, m, blocks, border)
            let targets = self.fireball_targets(b, owner, players)
            let hit = b.nearest(targets)
            b.go(f, blocks, hit, mut sounds)
            b.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
            self.fireball_hit(mut b, f, blocks, hit, owner, sounds.len())
        }
        let id = b.body.id
        self.keep_acted(id, b.body.bounding_box(), b.acted, b.acted_after)
        b.acted.clear()
        b.acted_after.clear()
        let key = section_key(b.body.x, b.body.y, b.body.z)
        let removed = b.body.removed
        self.all[i] = some(Entity.Fireball(b))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // What the dragon fireball `b` hit, `hit` the entity its way met and `owner` its owner as its
    // level found them, `heard` its tick's sounds, where it's still here, `isAlive` (D618): where a
    // block's hit that would do something of it, that said missing, `struck_missing`; then what
    // it struck, `Shown.Fireballed`, its level's to deal, `onHit`, and it's gone, `discard`.
    fn fireball_hit<B: CollisionBlocks>(mut self, b: mut Fireball, f: Facts, blocks: B, hit: ThrownHit?, owner: OwnerView?, heard: usize) {
        if b.body.removed {
            return
        }
        let state = blocks.collision_state(b.way.bx, b.way.by, b.way.bz) ?? 0
        let struck = b.hit(f, hit, state, owner) else return
        if hit == none and not b.way.border {
            if let missing = struck_missing(f, state, if b.kind == WIND_CHARGE { "a wind charge" } else if b.kind == SMALL_FIREBALL { "a small fireball" } else if b.kind == LARGE_FIREBALL { "a large fireball" } else { "a dragon fireball" }) {
                b.acted.push(Acted.Missing(missing))
                b.acted_after.push(heard)
            }
        }
        let id = b.body.id
        self.keep_acted(id, b.body.bounding_box(), b.acted, b.acted_after)
        b.acted.clear()
        b.acted_after.clear()
        self.shown.push(Shown.Fireballed(struck))
        self.shown_by.push(id)
        self.shown_after.push(heard)
        b.body.removed = true
    }

    // What the dragon fireball `b` may hit along its way, `getEntityHitResult`'s candidates (D618):
    // what a thrown potion may, `projectile_targets`, the ender dragons' parts among them, but end
    // crystals for a wind charge, `AbstractWindCharge.canHitEntity`, which other wind charges,
    // never among them, aren't either (CAL-182).
    fn fireball_targets(self, b: Fireball, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        let reach = b.reach()
        var out = self.projectile_targets(reach, b.body.id, b.left_owner, owner, players)
        if b.kind == WIND_CHARGE {
            var kept = List<Target>()
            for target in out {
                if not self.is_crystal(target.id) {
                    kept.push(target)
                }
            }
            out = kept
        }
        return out
    }

    // What a shulker's bullet may hit along its way (CAL-200): what any projectile may,
    // `projectile_targets`, but what goes through blocks, `noPhysics`, as a vex,
    // `ShulkerBullet.canHitEntity`.
    fn bullet_targets(self, b: Fireball, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        var kept = List<Target>()
        for target in self.projectile_targets(b.reach(), b.body.id, b.left_owner, owner, players) {
            if self.at.contains(target.id) {
                if let e = self.all[self.at[target.id]] {
                    match e {
                        Entity.Mob(o) => {
                            if o.living.body.no_physics {
                                continue
                            }
                        },
                        _ => {},
                    }
                }
            }
            kept.push(target)
        }
        return kept
    }

    // The entity of the UUID `uuid` a shulker's bullet homes on, as its level finds it,
    // `EntityReference.getEntity` (CAL-200): among `players`, alive where they're neither dead
    // nor spectating; else among its mobs and armor stands, alive where they are. None where
    // there's none such.
    fn homing_of(self, uuid: (i64, i64)?, players: List<Follower>) -> Homing? {
        let u = uuid else return none
        for p in players {
            if p.uuid == some(u) {
                return some(Homing { id: p.id, x: p.x, y: p.y, z: p.z, height: p.height, alive: not p.dead and not p.spectator })
            }
        }
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        return some(Homing { id: o.living.body.id, x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, height: o.living.body.height, alive: o.living.alive() })
                    }
                },
                Entity.Stand(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        return some(Homing { id: o.living.body.id, x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, height: o.living.body.height, alive: o.living.alive() })
                    }
                },
                _ => {},
            }
        }
        return none
    }

    // The parts of the ender dragons there are whose boxes meet `reach`, as a projectile may hit
    // them (D618), each its dragon's ID and 1 past its place among them, as `Level.getEntities`
    // finds them after the rest, each pickable and alive, `canBeHitByProjectile` (CAL-167).
    fn parts_targets(self, reach: Aabb) -> List<Target> {
        var out = List<Target>()
        var last = -1
        var k = 0
        for (dragon, part) in self.dragon_parts {
            if dragon != last {
                last = dragon
                k = 0
            }
            k += 1
            if self.at.contains(dragon) and part.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) {
                let (cx, cz) = ((part.min_x + part.max_x) / 2.0, (part.min_z + part.max_z) / 2.0)
                out.push(Target { id: dragon + k, bounds: part, x: cx, y: part.min_y, z: cz, player: false })
            }
        }
        return out
    }

    // An eye of ender's tick, at `i` (D598): `EyeOfEnder.tick`; it's gone where its tick took it
    // away, its removal sent after its sounds, then, where its life ran out, its level event where
    // it is, `Shown.Level`, a sound after them, as vanilla sends the removal as it's discarded,
    // before the event; or, where it survives, its stack dropped where it is, `Shown.Survived`,
    // likewise (D599).
    fn tick_eye<B: CollisionBlocks>(mut self, i: usize, eye: own EyeOfEnder, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        var e = eye
        let ran_out = e.tick(f, t, blocks, min_y, fast_lava, mut sounds)
        let id = e.body.id
        let (bx, by, bz) = e.body.block()
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let removed = e.body.removed
        let shown = if e.survives { Shown.Survived(Spilled { x: e.body.x, y: e.body.y, z: e.body.z, stack: e.item.copy() }) } else { Shown.Level((EYE_GONE, bx, by, bz, 0)) }
        self.all[i] = some(Entity.Eye(e))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
        if ran_out {
            self.shown.push(shown)
            self.shown_by.push(id)
            self.shown_after.push(sounds.len() + 1)
        }
    }

    // An end crystal's tick, at `i` (D589): `EndCrystal.tick`, what blocks did to it kept as what a
    // living entity shows is, then, in a level with a dragon fight, the air of its block set alight
    // by its level, `Shown.Kindled`, after its tick's sounds; and it's gone where its tick took it
    // away, its removal sent after that.
    fn tick_crystal<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, crystal: own EndCrystal, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, sounds: mut List<EntitySound>) {
        var c = crystal
        let alight = c.tick(f, t, lf.damage, blocks, self.fight, mut sounds)
        let id = c.body.id
        self.keep_acted(id, c.body.bounding_box(), c.acted, c.acted_after)
        c.acted.clear()
        c.acted_after.clear()
        if let at = alight {
            self.shown.push(Shown.Kindled(at))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        self.all[i] = some(Entity.Crystal(c))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // An area effect cloud's tick, at `i` (D529): up to its pass, `tick_start`; then, where it's
    // to look for any to dose, the living things in its box, `cloud_near`, its pass over them,
    // `dose`, and what it gives those it doses, `Shown.Dosed`, after its tick's sounds so far, for
    // its level to give; and it's gone where it went, `discard`, its removal sent after that.
    fn tick_cloud<B: CollisionBlocks>(mut self, i: usize, cloud: own EffectCloud, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var c = cloud
        if let radius = c.tick_start(f, t, blocks, min_y, fast_lava, mut sounds) {
            let effects = c.effects()
            let near = self.cloud_near(c, effects, lf, players)
            let targets = c.dose(radius, near)
            if not targets.is_empty() {
                self.shown.push(Shown.Dosed(Dose { by: c.doser(), targets: targets, effects: effects }))
                self.shown_by.push(c.body.id)
                self.shown_after.push(sounds.len())
            }
        }
        let id = c.body.id
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        self.all[i] = some(Entity.Cloud(c))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // The living things in the cloud `c`'s box, as `getEntitiesOfClass(LivingEntity)` finds them
    // for its pass (D529): the mobs whose boxes meet it, as `found` finds them, then the players of
    // `players` whose boxes do, but spectators, `NO_SPECTATORS`; each one the cloud may dose where
    // potions take it, not dying, `isAffectedByPotions`, and one of `effects` can affect it,
    // `canBeAffected`, as each can a player. Armor stands, which potions don't take, it never may.
    fn cloud_near(self, c: EffectCloud, effects: List<ActiveEffect>, lf: LivingFacts, players: List<Follower>) -> List<Breather> {
        let b = c.body.bounding_box()
        var out = List<Breather>()
        for id in self.found(b, c.body.id, 8) {
            let slot = self.all[self.at[id]] else continue
            if let Entity.Mob(m) = slot {
                var any = false
                for e in effects {
                    if m.living.can_be_affected(lf, e.id) {
                        any = true
                    }
                }
                out.push(Breather { id: id, x: m.living.body.x, z: m.living.body.z, player: false, takes: any and not m.living.dead_or_dying() })
            }
        }
        for pl in players {
            if pl.spectator {
                continue
            }
            let pb = pl.bounds else continue
            if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                out.push(Breather { id: pl.id, x: pl.x, z: pl.z, player: true, takes: not pl.dead })
            }
        }
        return out
    }

    // A thrown potion's tick, at `i` (D527): to where it looks for what it may hit, `tick_start`;
    // the nearest of what it may hit, `thrown_targets`, its owner found among the level's entities
    // and `players`; its move there, `go`; the end of its tick, `tick_end`; then, where it hit
    // something, `hit`, the block its way met as it is by then, what it hit, `Shown.Splashed`,
    // after its tick's sounds so far, for its level to splash, `onHit`, and it's gone, `discard`.
    // What the block does of it that Calcite doesn't do yet is said first, `struck_missing`.
    fn tick_thrown<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, thrown: own ThrownItem, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var p = thrown
        // `ThrownEnderpearl.tick`'s first (D579): the chunk it's in, and its owner, a player
        // wherever they are; one whose owner's dead goes where `ender_pearls_vanish_on_death`
        // has it, its tick passed over.
        let (cx, cz) = (i32.saturate(p.body.x.floor()) >> 4, i32.saturate(p.body.z.floor()) >> 4)
        var pearl_owner: PearlOwner? = none
        if p.pearl {
            pearl_owner = self.pearl_owner_of(p.owner)
            if let o = pearl_owner {
                if not o.alive and self.pearls_vanish {
                    p.body.removed = true
                }
            }
        }
        if not p.body.removed {
            let owner = self.owner_of(p.owner, players)
            let border = self.border ?? widest_border()
            p.tick_start(f, m, blocks, border, sounds.len())
            let targets = self.thrown_targets(p, owner, players)
            let hit = p.nearest(targets)
            p.go(f, blocks, hit, mut sounds)
            p.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
            self.thrown_hit(mut p, f, blocks, hit, sounds.len())
        }
        // Then, still here, its ticket put again about the chunk it's in, `ENDER_PEARL`, where its
        // owner's a player, once its timer's out or it's come into another chunk, `ticketTimer`
        // then its ticket's ticks less one (D579), and it's among their pearls,
        // `registerAndUpdateEnderPearlTicket` (D580).
        if p.pearl and not p.body.removed {
            p.ticket_timer -= 1
            let (nx, nz) = (i32.saturate(p.body.x.floor()) >> 4, i32.saturate(p.body.z.floor()) >> 4)
            if let o = pearl_owner {
                if p.ticket_timer <= 0 or nx != cx or nz != cz {
                    p.registered = o.serial
                    self.pearl_tickets.push((nx, nz))
                    p.ticket_timer = PEARL_TICKET_TICKS - 1
                }
            }
        }
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        let key = section_key(p.body.x, p.body.y, p.body.z)
        let removed = p.body.removed
        self.all[i] = some(Entity.Thrown(p))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // The player owning an ender pearl of the UUID `owner`, as `findOwnerIncludingDeadPlayer`
    // finds them among those wherever they are (D579); none for no owner, or one that isn't a
    // player.
    fn pearl_owner_of(self, owner: (i64, i64)?) -> PearlOwner? {
        let u = owner else return none
        for o in self.pearl_owners {
            if o.uuid == u {
                return some(o)
            }
        }
        return none
    }

    // What the thrown item `p` hit, `hit` the entity its way met, `heard` its tick's sounds, where
    // it's still here (D527): where a block's hit that would do something of it, that said
    // missing, `struck_missing`; then its hit, a potion's splash, `Shown.Splashed`, or an ender
    // pearl's, `Shown.Pearled` (D579), its level's to deal, and it's gone.
    fn thrown_hit<B: CollisionBlocks>(mut self, p: mut ThrownItem, f: Facts, blocks: B, hit: ThrownHit?, heard: usize) {
        if p.body.removed {
            return
        }
        let state = blocks.collision_state(p.way.bx, p.way.by, p.way.bz) ?? 0
        var shown: Shown? = none
        var block = false
        if p.pearl {
            if let landed = p.pearl_hit(f, hit, state) {
                block = landed.entity == none
                shown = some(Shown.Pearled(landed))
            }
        } else if let splash = p.hit(f, hit, state) {
            block = splash.block != none
            shown = some(Shown.Splashed(splash))
        }
        let what = shown else return
        if block and not p.way.border {
            if let missing = struck_missing(f, state, "a thrown potion") {
                p.acted.push(Acted.Missing(missing))
                p.acted_after.push(heard)
            }
        }
        let id = p.body.id
        self.keep_acted(id, p.body.bounding_box(), p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        self.shown.push(what)
        self.shown_by.push(id)
        self.shown_after.push(heard)
        p.body.removed = true
    }

    // What the thrown potion `p` may hit along its way, `getEntityHitResult`'s candidates (D527),
    // `projectile_targets`.
    fn thrown_targets(self, p: ThrownItem, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        return self.projectile_targets(p.reach(), p.body.id, p.left_owner, owner, players)
    }

    // What the projectile `id` may hit in its reach `reach`, `getEntityHitResult`'s candidates
    // (D527): the armor stands, mobs and end crystals (D591) whose boxes meet it, as `found` finds
    // them, then the players of `players` whose boxes do, each alive and pickable,
    // `canBeHitByProjectile`, that it may hit, not its owner `owner` where it's not left them,
    // `left_owner`, `isPassengerOfSameVehicle`; then the ender dragons' parts, `parts_targets`
    // (CAL-167).
    fn projectile_targets(self, reach: Aabb, id: i32, left_owner: bool, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        var out = List<Target>()
        var own_id = -1
        if let o = owner {
            if not left_owner {
                own_id = o.id
            }
        }
        for found in self.found(reach, id, 140) {
            if found == own_id {
                continue
            }
            let slot = self.all[self.at[found]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() {
                        out.push(Target { id: found, bounds: s.living.body.bounding_box(), x: s.living.body.x, y: s.living.body.y, z: s.living.body.z, player: false })
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() {
                        out.push(Target { id: found, bounds: o.living.body.bounding_box(), x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, player: false })
                    }
                },
                Entity.Crystal(c) => {
                    if not c.body.removed {
                        out.push(Target { id: found, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                _ => {},
            }
        }
        for pl in players {
            if pl.spectator or pl.dead or pl.id == own_id {
                continue
            }
            let b = pl.bounds else continue
            if b.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) {
                out.push(Target { id: pl.id, bounds: b, x: pl.x, y: pl.y, z: pl.z, player: true })
            }
        }
        out.extend(self.parts_targets(reach))
        return out
    }

    // An arrow's tick, at `i` (CAL-159): to its steps, `tick_start`, its owner found among the
    // level's entities and `players` where it's to fly, then its steps, `arrow_steps`.
    fn tick_arrow<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        var owner: OwnerView? = none
        if not a.in_ground() {
            owner = self.owner_of(a.owner, players)
        }
        let border = self.border ?? widest_border()
        if a.tick_start(f, m, t, blocks, min_y, fast_lava, owner, border, mut sounds) {
            self.arrow_steps(i, a, owner, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow at `i` after its level dealt the hits it stopped at (CAL-159): landed on the block
    // it struck, where that's what it stopped at, `hit_block`, its state kept as `codecs` save it;
    // its motion to be sent; on through more of its steps where it's still here and pierces, else
    // the end of its tick, `tick_end`, as `stepMoveAndHit`'s loop goes on.
    fn arrow_on<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        if let state = a.block_due.take() {
            if not a.body.removed {
                a.hit_block(state, codecs.state_saved(state), mut sounds)
            }
        }
        a.body.needs_sync = true
        if not a.body.removed and a.pierce() > 0i8 {
            let owner = self.owner_of(a.owner, players)
            self.arrow_steps(i, a, owner, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        a.tick_end(f, t, blocks, min_y, fast_lava, mut sounds)
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow's steps along its way, `stepMoveAndHit` (CAL-159): from where it is, the entities
    // it may hit up to the block its way meets, `Arrow.hits`; it goes to the nearest, or to the
    // block, and what blocks it went through act on it; with an entity to hit, it stops for its
    // level to deal the hits, `Shown.Shot` with them, after its tick's sounds so far, to go on in
    // the next `tick_next`, `arrow_on`; else, where its way met a block that's still there, it
    // lands, `hit_block`, its state kept as `codecs` save it, and what the block would do of it
    // said to be missing; then the end of its tick.
    fn arrow_steps<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, owner: OwnerView?, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        if not a.body.removed {
            let from = (a.body.x, a.body.y, a.body.z)
            let end = (a.way.x, a.way.y, a.way.z)
            let targets = self.targets_of(a, owner, players)
            let hits = a.hits(f, m, blocks, targets, from, end, self.border ?? widest_border())
            if hits.is_empty() {
                a.body.x = a.way.x
                a.body.y = a.way.y
                a.body.z = a.way.z
            } else {
                a.body.x = hits[0].x
                a.body.y = hits[0].y
                a.body.z = hits[0].z
            }
            a.step_acts(f, blocks, from, mut sounds)
            a.step_portal(blocks, sounds.len())
            if hits.is_empty() {
                if not a.body.removed and not a.way.missed and a.way.border {
                    // `hitTargetOrDeflectSelf`: the world border, which it bounces off, not
                    // hitting it, `shouldBounceOnWorldBorder` (CAL-159).
                    a.turn_back()
                    a.body.needs_sync = true
                } else if not a.body.removed and not a.way.missed {
                    let state = blocks.collision_state(a.way.bx, a.way.by, a.way.bz) ?? 0
                    if not f.is_air(state) {
                        if a.struck_by_level(f, state) {
                            // What the block does of it, its level's to deal first,
                            // `Shown.Struck`, after its tick's sounds so far; it lands as it goes
                            // on, `arrow_on` (CAL-159).
                            let id = a.body.id
                            self.keep_acted(id, a.body.bounding_box(), a.acted, a.acted_after)
                            a.acted.clear()
                            a.acted_after.clear()
                            a.block_due = some(state)
                            let struck = a.struck_block(state)
                            let key = section_key(a.body.x, a.body.y, a.body.z)
                            self.all[i] = some(Entity.Arrow(a))
                            self.move_section(id, key)
                            self.shown.push(Shown.Struck(struck))
                            self.shown_by.push(id)
                            self.shown_after.push(sounds.len())
                            self.heard = sounds.len()
                            self.paused_arrow = some(i)
                            return
                        }
                        a.hit_block(state, codecs.state_saved(state), mut sounds)
                    }
                    a.body.needs_sync = true
                }
            } else if not a.body.removed and not a.body.no_physics {
                let id = a.body.id
                self.keep_acted(id, a.body.bounding_box(), a.acted, a.acted_after)
                a.acted.clear()
                a.acted_after.clear()
                let key = section_key(a.body.x, a.body.y, a.body.z)
                self.all[i] = some(Entity.Arrow(a))
                self.move_section(id, key)
                self.shown.push(Shown.Shot(hits))
                self.shown_by.push(id)
                self.shown_after.push(sounds.len())
                self.heard = sounds.len()
                self.paused_arrow = some(i)
                return
            }
        }
        a.tick_end(f, t, blocks, min_y, fast_lava, mut sounds)
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow `a` back at `i` with its tick done, `heard` its sounds: what blocks did that its
    // level's to do kept with its ID, and it moved into its section, or gone (CAL-159).
    fn arrow_done(mut self, i: usize, arrow: own Arrow, heard: usize) {
        var a = arrow
        let id = a.body.id
        self.keep_acted(id, a.body.bounding_box(), a.acted, a.acted_after)
        a.acted.clear()
        a.acted_after.clear()
        let key = section_key(a.body.x, a.body.y, a.body.z)
        let removed = a.body.removed
        self.all[i] = some(Entity.Arrow(a))
        self.heard = heard
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // Whether the living entity that last hurt `a`, `getLastHurtByMob`, is alive, where it's among
    // the level's mobs and armor stands and not gone (D676); none where it isn't, as a player,
    // whom `players` find.
    fn hurter_alive(self, a: Living) -> bool? {
        let who = a.hurt_by_mob else return none
        if let here = self.living_alive(who) {
            return some(here)
        }
        // Found in another level, `getEntityInAnyDimension`, as its level told it (CAL-200).
        for (u, alive) in self.elsewhere {
            if u == who {
                return some(alive)
            }
        }
        return none
    }

    /// The UUIDs of those who last hurt its mobs and armor stands, `getLastHurtByMob`, that aren't
    /// in this level, which its level looks for in the others (CAL-200).
    pub fn hurters_missing(self) -> List<(i64, i64)> {
        var out = List<(i64, i64)>()
        for slot in self.all {
            let e = slot else continue
            let who = match e {
                Entity.Mob(o) => o.living.hurt_by_mob,
                Entity.Stand(o) => o.living.hurt_by_mob,
                _ => none,
            }
            let u = who else continue
            if self.living_alive(u) == none and not out.contains(u) {
                out.push(u)
            }
        }
        return out
    }

    /// Whether the mob or armor stand of the UUID `who` in this level is alive, none where it
    /// isn't here or is removed.
    pub fn living_alive(self, who: (i64, i64)) -> bool? {
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(o) => {
                    if o.living.body.uuid == who and not o.living.body.removed {
                        return some(o.living.alive())
                    }
                },
                Entity.Stand(o) => {
                    if o.living.body.uuid == who and not o.living.body.removed {
                        return some(o.living.alive())
                    }
                },
                _ => {},
            }
        }
        return none
    }

    // The arrow's owner of the UUID `uuid`, `getOwner`, among `players` and the level's mobs and
    // armor stands (CAL-159): its ID, its box where it may be picked, `CAN_BE_PICKED`, and whether
    // it's a player; none where it isn't found.
    fn owner_of(self, uuid: (i64, i64)?, players: List<Follower>) -> OwnerView? {
        let u = uuid else return none
        for p in players {
            if p.uuid == some(u) {
                var bounds: Aabb? = none
                if not p.spectator {
                    bounds = p.bounds
                }
                return some(OwnerView { id: p.id, bounds: bounds, player: true, team: p.team.copy(), friendly_fire: p.friendly_fire })
            }
        }
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        // An ender dragon's own box can't be picked, `isPickable` (D618).
                        var bounds: Aabb? = none
                        if o.pickable() {
                            bounds = some(o.living.body.bounding_box())
                        }
                        return some(OwnerView { id: o.living.body.id, bounds: bounds, player: false })
                    }
                },
                Entity.Stand(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        var bounds: Aabb? = none
                        if not o.marker() {
                            bounds = some(o.living.body.bounding_box())
                        }
                        return some(OwnerView { id: o.living.body.id, bounds: bounds, player: false })
                    }
                },
                _ => {},
            }
        }
        return none
    }

    // What the arrow `a` may hit along its way, `findHitEntities`' candidates (CAL-159): the
    // armor stands, mobs and end crystals (D591) whose boxes meet its reach, `Arrow.reach`, as
    // `found` finds them, then the players of `players` whose boxes do (CAL-190), each alive and
    // pickable, `canBeHitByProjectile`, that it may hit, `may_hit`: not a player in its owner's
    // team where that doesn't allow friendly fire, `canHarmPlayer` (CAL-164); then the ender
    // dragons' parts, `parts_targets` (CAL-167).
    fn targets_of(self, a: Arrow, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        let reach = a.reach()
        var out = List<Target>()
        for id in self.found(reach, a.body.id, 140) {
            let slot = self.all[self.at[id]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: s.living.body.bounding_box(), x: s.living.body.x, y: s.living.body.y, z: s.living.body.z, player: false })
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: o.living.body.bounding_box(), x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, player: false })
                    }
                },
                Entity.Crystal(c) => {
                    if not c.body.removed and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                _ => {},
            }
        }
        for p in players {
            if p.spectator or p.dead {
                continue
            }
            let b = p.bounds else continue
            let spared = match owner {
                some(o) => o.player and o.team != none and o.team == p.team and not o.friendly_fire,
                none => false,
            }
            if b.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) and a.may_hit(p.id, true, owner, self.pvp and not spared) {
                out.push(Target { id: p.id, bounds: b, x: p.x, y: p.y, z: p.z, player: true })
            }
        }
        // Then the ender dragons' parts, as `getEntities` finds them after the rest, each that it
        // hasn't pierced already (CAL-167).
        for t in self.parts_targets(reach) {
            if a.may_hit(t.id, false, owner, self.pvp) {
                out.push(t)
            }
        }
        return out
    }

    // The blocks the level sent again since they were last read, as `sendBlockUpdated` takes each:
    // its path type forgotten, and where its shape changed, the paths of the mobs it's near enough
    // found again, `shouldRecomputePath`, in the order the mobs came, which vanilla's
    // `navigatingMobs` holds in no order of its own, finding the same paths in any.
    fn take_sent<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32) {
        let total = blocks.sent_total()
        var i = blocks.sent_first()
        if self.sent_seen > i {
            i = self.sent_seen
        }
        self.sent_seen = total
        if i >= total {
            return
        }
        var going = List<i32>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Mob(mob) = e {
                    if mob.navigating() {
                        going.push(mob.living.body.id)
                    }
                }
            }
        }
        while i < total {
            let b = blocks.sent_at(i)
            i += 1
            self.path_types.invalidate(b.x, b.y, b.z)
            if going.is_empty() or m.same_shape(f, b.old, b.now, b.x, b.z) {
                continue
            }
            for id in going {
                var mob = self.lend_mob(id) else continue
                mob.block_changed(lf, f, m, blocks, mut self.path_types, min_y, b.x, b.y, b.z)
                self.give_back_mob(mob)
            }
        }
    }

    // What holds the leash `l` as its mob's tick finds it (CAL-179): a player among `players` that
    // is the one who held it, else one in another level, away, else gone; or a mob or knot here,
    // else gone. A leash saved, its holder's UUID, finds the player or mob here with it,
    // `getEntity`, none where there's none; a knot's place, the knot there, none where there's
    // none yet.
    fn holding_of(self, leash: Leash?, players: List<Follower>) -> Holding? {
        let l = leash else return none
        if let h = l.holder {
            if h.player {
                for p in players {
                    if p.id == h.id and p.object == h.object {
                        return some(player_holding(h, p))
                    }
                }
                for p in self.away {
                    if p.id == h.id and p.object == h.object {
                        return some(Holding { held: h, here: false, interacts: not p.dead and not p.spectator })
                    }
                }
                return some(Holding { held: h, here: false, interacts: false })
            }
            if self.at.contains(h.id) {
                if let slot = self.all[self.at[h.id]] {
                    if let Entity.Mob(o) = slot {
                        return some(mob_holding(h, o))
                    }
                }
                if let k = self.knot_hold(h.id) {
                    return some(k)
                }
            }
            return some(Holding { held: h, here: false, interacts: false })
        }
        let saved = l.saved else return none
        if let Tag.IntArray(v) = saved {
            // A knot's place, the knot there, `getKnot`.
            if v.len() != 3 {
                return none
            }
            let k = self.knot_at((v[0], v[1], v[2])) else return none
            return self.knot_hold(k)
        }
        let Tag.Compound(c) = saved else return none
        let u = uuid_of(c, "UUID") else return none
        for p in players {
            if p.uuid == some(u) {
                return some(player_holding(Held { id: p.id, uuid: u, player: true, object: p.object }, p))
            }
        }
        for slot in self.all {
            let e = slot else continue
            if let Entity.Mob(o) = e {
                if o.living.body.uuid == u and not o.living.body.removed {
                    return some(mob_holding(Held { id: o.living.body.id, uuid: u }, o))
                }
            }
        }
        return none
    }

    // A mob's tick, at `i`: its look at whether it goes, `checkDespawn`, from the nearest of
    // `players` that isn't a spectator, then where it stays and `ticks`, in range, its tick, as an
    // armor stand's (D452).
    fn tick_mob<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, ticks: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        let nearest = nearest_to(a, players)
        if a.check_despawn(self.peaceful, nearest) {
            a.living.body.removed = true
            self.all[i] = some(Entity.Mob(a))
            self.remove(id)
            return
        }
        if not ticks {
            self.all[i] = some(Entity.Mob(a))
            return
        }
        a.carries_mob = false
        a.controlled = false
        if a.living.body.passengers.len() > 0 {
            let first = a.living.body.passengers[0]
            a.carries_mob = self.is_mob(first)
            a.controlled = not a.no_ai() and self.may_steer(first)
        }
        if a.wants_kin() {
            a.kin = self.kin_near(a)
            a.leader_seen = self.leader_of(a)
        }
        // A vex's owner's target, which it may take up, `VexCopyOwnerTargetGoal` (CAL-200).
        a.owner_target = none
        if let o = a.vex_owner {
            if let oid = self.id_with_uuid(o) {
                if self.is_mob(oid) {
                    a.owner_target = self.mob(oid).target
                }
            }
        }
        if a.wants_prey() {
            a.prey = self.prey_near(a, lf)
        } else if not a.prey.is_empty() {
            a.prey = List<Follower>()
        }
        if a.brain != none {
            a.near = self.brain_near(a, lf, players)
            if a.wants_items() {
                a.near_items = self.items_for(a, lf, f, items)
            }
            a.villager_activity = self.villager_activity
            a.baby_activity = self.baby_activity
            a.day = self.day
            if a.dimension != self.dimension {
                a.dimension = self.dimension.copy()
            }
        }
        a.mob_drops = self.mob_drops
        a.entity_drops = self.entity_drops
        if a.leash != none {
            a.holding = self.holding_of(a.leash.copy(), players)
        }
        a.mob_griefing = self.mob_griefing
        a.universal_anger = self.universal_anger
        a.border = self.border
        a.game_time = self.game_time
        a.hard = self.hard
        a.difficulty = self.difficulty
        if a.species == ENDER_DRAGON {
            self.fight_for(mut a)
        }
        a.living.hurt_by_found = self.hurter_alive(a.living)
        if a.tick_start(lf, f, m, blocks, min_y, mut sounds) {
            // A creeper's explosion, which its level makes before its tick goes on, as vanilla's
            // `explodeCreeper` comes before `super.tick()`: what it showed so far kept, the
            // explosion among it, and it stopped till the next `tick_next` (CAL-182).
            let bred = self.keep_shown(id, mut a)
            self.all[i] = some(Entity.Mob(a))
            self.heard = sounds.len()
            self.paused_start = some((i, bred))
            return
        }
        self.tick_mob_used(i, a, false, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
    }

    // The mob `mob` at `i` after its tick's start, `tick_start`, `bred_before` whether it bred
    // (CAL-182): its tick to its use, `tick_using`, its spear's hits dealt by its level where it
    // has any, then the rest, `tick_mob_on`.
    fn tick_mob_used<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        // A crossbow's use draws from the level's random, and its sounds' flags are the crossbow
        // item's, for every crossbow, lent it (CAL-200).
        let crossbows = a.species == PILLAGER
        if crossbows {
            a.level_random = self.level_random.take()
            a.crossbow_sounds = self.crossbow_sounds
        }
        a.tick_using(lf, f, m, t, blocks, items, mut self.path_types, players, min_y, fast_lava, mut sounds)
        if crossbows {
            self.level_random = a.level_random.take()
            self.crossbow_sounds = a.crossbow_sounds
        }
        if let due = a.stab_due.take() {
            let stabs = self.stabs_of(mut a, due, f, m, blocks, players)
            if not stabs.is_empty() {
                // Its spear's hits, which its level deals before its tick goes on, as vanilla's
                // `damageEntities` is dealt as its use ticks, before its AI: what it showed so far
                // kept, then the hits, and it stopped till the next `tick_next` (CAL-159).
                let bred = self.keep_shown(id, mut a) or bred_before
                self.all[i] = some(Entity.Mob(a))
                self.shown.push(Shown.Stabbed(stabs))
                self.shown_by.push(id)
                self.shown_after.push(sounds.len())
                self.heard = sounds.len()
                self.paused_use = some((i, bred))
                return
            }
        }
        self.tick_mob_on(i, a, bred_before, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
    }

    // The mob `mob` at `i` after its use's tick, `tick_using`, `bred_before` whether it bred
    // (CAL-159): the rest of its tick through its AI, `tick_thinking_on`, then, unless it attacked
    // a player, the rest of its tick.
    fn tick_mob_on<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        // A zombie's goals look for villages' points of interest, its level's lent it for them
        // (D605).
        let villages = a.goes_through_villages()
        if villages {
            a.pois = self.pois.take()
        }
        if a.species == ENDER_DRAGON {
            self.crystals_for(mut a)
        }
        let crossbows = a.species == PILLAGER
        if crossbows {
            a.level_random = self.level_random.take()
            a.crossbow_sounds = self.crossbow_sounds
        }
        let entered = a.tick_thinking_on(lf, f, m, blocks, items, mut self.path_types, players, min_y, mut sounds)
        if crossbows {
            self.level_random = a.level_random.take()
            self.crossbow_sounds = a.crossbow_sounds
        }
        if a.species == ENDER_DRAGON {
            // Its parts as its `aiStep` placed them, and what its wings and head reach (D611).
            self.keep_parts(a)
            self.dragon_strikes(mut a, players, sounds.len())
            // Its word to its fight, once its walls are broken, `updateDragon` (D626).
            var seen = false
            if let dr = a.dragon {
                seen = dr.seen_due
            }
            if seen {
                let progress = a.living.health() / a.living.max_health(lf)
                a.living.show(Shown.DragonSeen(progress), sounds.len())
            }
        }
        if villages {
            self.pois = a.pois.take()
        }
        // Its equipment, as its `aiStep` ticks it (D607).
        if entered {
            self.equipment_tick(mut a.living, sounds.len())
        }
        if not a.attacked() and not a.goals_stopped() {
            self.tick_mob_rest(i, a, entered, bred_before, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
            return
        }
        // Its attack on a player, which its level deals before its tick goes on, as vanilla's
        // `doHurtTarget` is dealt in `serverAiStep`, so its travel and its pushes come after the
        // hit, and don't push a player it killed: what it showed so far kept, and whom its hurt
        // alerts told, and it stopped till the next `tick_next` (CAL-159). So too a silverfish's
        // waking of a friend, which its level breaks then and there, the paths near it, its own
        // among them, found again as `take_sent` takes the block before it goes on (CAL-172).
        let alert = a.alerted
        a.alerted = none
        let bred = self.keep_shown(id, mut a) or bred_before
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let within = a.living.attributes.value(lf.follow_range)
        let species = a.species
        self.all[i] = some(Entity.Mob(a))
        self.heard = sounds.len()
        if let target = alert {
            self.alert_others(id, species, ax, ay, az, within, target, players)
        }
        self.paused = some((i, entered, bred))
    }

    // The boxes of the ender dragon `a`'s parts kept, its own before put away, and those of
    // dragons gone with them (D610).
    fn keep_parts(mut self, a: Mob) {
        let dr = a.dragon else return
        let own_id = a.living.body.id
        var kept = List<(i32, Aabb)>()
        for (owner, b) in self.dragon_parts {
            if owner != own_id and self.at.contains(owner) {
                kept.push((owner, b))
            }
        }
        for k in 0..PARTS {
            let (x0, y0, z0, x1, y1, z1) = dr.part_box(k)
            kept.push((own_id, Aabb { min_x: x0, min_y: y0, min_z: z0, max_x: x1, max_y: y1, max_z: z1 }))
        }
        self.dragon_parts = kept
    }

    // What the ender dragon `a`'s wings' knockback and its head's and neck's hurt reach of its
    // level in its tick, `heard` its sounds so far (D611): the living entities in their boxes, and
    // the players not in creative or spectating, `NO_CREATIVE_OR_SPECTATOR`, its own parts not
    // living. Its strikes, box by box, its wings' with the middle of its body across, are its
    // level's to deal, `Shown.Beaten` (D615): in each box the mobs and armor stands, as the level
    // finds them (D677), then the players, in the level's order; vanilla has the players among
    // the rest, by the sections they're in, as an explosion's are. Then the breaking of what it
    // flew into, where it would break any, `checkWalls`, which comes after them (D614).
    fn dragon_strikes(self, a: mut Mob, players: List<Follower>, heard: usize) {
        var strikes = List<Aabb>()
        var sitting = false
        var middle = (0.0, 0.0)
        var walls: List<Aabb>? = none
        if let dr = a.dragon {
            strikes = dr.strikes.copy()
            sitting = dr.sitting()
            let body = dr.boxed(BODY)
            middle = ((body.min_x + body.max_x) / 2.0, (body.min_z + body.max_z) / 2.0)
            if dr.walls_due {
                walls = some([dr.boxed(HEAD), dr.boxed(NECK), dr.boxed(BODY)])
            }
        }
        let own_id = a.living.body.id
        var beats = List<Beat>()
        for k in 0..strikes.len() {
            let b = strikes[k]
            let from: (f64, f64)? = if k < 2 { some(middle) } else { none }
            for id in self.find_living(b, own_id) {
                beats.push(Beat { player: id, from: from, sitting: sitting, living: true })
            }
            for p in players {
                if p.spectator or p.creative {
                    continue
                }
                if let pb = p.bounds {
                    if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        beats.push(Beat { player: p.id, from: from, sitting: sitting })
                    }
                }
            }
        }
        if not beats.is_empty() {
            a.living.show(Shown.Beaten(beats), heard)
        }
        if let boxes = walls {
            a.living.show(Shown.Walls(boxes), heard)
            var dr = a.dragon.take() else return
            dr.walls_due = false
            a.dragon = some(dr)
        }
    }

    // What the ender dragon `a` reads of its level's dragon fight as it ticks (D626), told before
    // its tick begins, as its death's tick, `tickDeath`, comes before its `aiStep`, which takes the
    // fight as its own where it's the fight's dragon: whether it is now, `dragonUUID`, the
    // crystals the fight counts alive and whether a dragon was killed in it before.
    fn fight_for(self, a: mut Mob) {
        var dr = a.dragon.take() else return
        dr.ours = self.fight and self.fight_dragon == some(a.living.body.uuid)
        dr.crystals = self.fight_crystals
        dr.killed_before = self.fight_killed_before
        a.dragon = some(dr)
    }

    // What an ender dragon's `checkCrystals` reads of its level, for the dragon `a` (D608): whether
    // the end crystal it had is gone, `isRemoved`, and the nearest end crystal whose box is within
    // 32 of its own, `getEntitiesOfClass`, by `distanceToSqr` from where it is, the first found of
    // any as near.
    fn crystals_for(self, a: mut Mob) {
        var dr = a.dragon.take() else return
        dr.crystal_gone = false
        if let had = dr.nearest_crystal {
            dr.crystal_gone = true
            if self.at.contains(had) {
                if let slot = self.all[self.at[had]] {
                    if let Entity.Crystal(c) = slot {
                        dr.crystal_gone = c.body.removed
                    }
                }
            }
        }
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let area = a.living.body.bounding_box().inflate(32.0, 32.0, 32.0)
        var best = f64.MAX
        var found: i32? = none
        for id in self.found(area, a.living.body.id, 128) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Crystal(c) = slot else continue
            let (dx, dy, dz) = (c.body.x - ax, c.body.y - ay, c.body.z - az)
            let d = dx * dx + dy * dy + dz * dz
            if d < best {
                best = d
                found = some(id)
            }
        }
        dr.found_crystal = found
        a.dragon = some(dr)
    }

    // What the mob `a`'s spear meets as its use ticks, `due` what that asks, among the level's mobs
    // and armor stands and `players`, `KineticWeapon.damageEntities` (CAL-159). Its way, along its
    // head's look from its eyes, from its least reach to its most and its motion along that more,
    // `getHitEntitiesAlong`, meets nothing where a block it collides with comes nearer than its
    // least reach, else ends at such a block. What its way meets, in the order the level finds
    // them, mobs and stands, then players, is what's alive, pickable and not invulnerable, and
    // doesn't ride with it on the same, `isPassengerOfSameVehicle` (CAL-200), whose box is within its margin of the way, there clear of colliding blocks to the box's middle,
    // `getManyEntityHitResult`. Each not hit too lately, `wasRecentlyStabbed`, is kept as hit now,
    // and is hit where what it does holds: its speed along its look, less theirs, at least none,
    // against the spear's conditions at a mob's fifth, `test`; the damage its attack damage's
    // base and the whole of that times the spear's multiplier.
    fn stabs_of<B: CollisionBlocks>(self, a: mut Mob, due: StabDue, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> List<Stab> {
        var out = List<Stab>()
        let (ex, ey, ez) = due.eye
        let (hx, hy, hz) = due.head_look
        let least = due.reach.least
        let from = (ex + hx * least, ey + hy * least, ez + hz * least)
        let (mx, my, mz) = due.movement
        let along = mx * hx + my * hy + mz * hz
        let far = due.reach.most + along.max(0.0)
        var to = (ex + hx * far, ey + hy * far, ez + hz * far)
        let border = self.border ?? widest_border()
        let mover = a.living.body.mover()
        let way = clip_including_border(f, m, blocks, mover, due.eye, to, border)
        if not way.missed {
            to = (way.x, way.y, way.z)
            if distance_sqr(due.eye, to) < distance_sqr(due.eye, from) {
                return out
            }
        }
        let (fx, fy, fz) = from
        let (tx, ty, tz) = to
        let half = due.reach.margin / 2.0
        var area = Aabb { min_x: fx - half, min_y: fy - half, min_z: fz - half, max_x: fx + half, max_y: fy + half, max_z: fz + half }
        area = expand_towards(area, tx - fx, ty - fy, tz - fz).inflate(1.0, 1.0, 1.0)
        var found = List<(i32, Aabb, bool, (f64, f64, f64))>()
        for id in self.found(area, a.living.body.id, 12) {
            let slot = self.all[self.at[id]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() and not s.living.body.invulnerable and s.living.invulnerable_time <= 0 {
                        found.push((id, s.living.body.bounding_box(), false, (s.living.body.known_dx, s.living.body.known_dy, s.living.body.known_dz)))
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() and not o.living.body.invulnerable and o.living.invulnerable_time <= 0 {
                        found.push((id, o.living.body.bounding_box(), false, (o.living.body.known_dx, o.living.body.known_dy, o.living.body.known_dz)))
                    }
                },
                _ => {},
            }
        }
        for p in players {
            if p.spectator or p.dead {
                continue
            }
            let b = p.bounds else continue
            if b.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                found.push((p.id, b, true, (p.known_dx, p.known_dy, p.known_dz)))
            }
        }
        let k = due.kinetic
        let (lx, ly, lz) = due.look
        let (sx, sy, sz) = due.speed
        let speed = lx * sx + ly * sy + lz * sz
        let now = self.game_time
        let root = match a.living.body.vehicle {
            some(v) => self.root_vehicle(v),
            none => a.living.body.id,
        }
        for (id, b, player, known) in found {
            if self.root_vehicle(id) == root {
                continue
            }
            if not meets_way(f, m, blocks, mover, border, b, from, to, due.reach.margin) {
                continue
            }
            if a.living.stabbed_lately(id, now, k.contact_cooldown) {
                continue
            }
            let (kx, ky, kz) = known
            let theirs = lx * (kx * 20.0) + ly * (ky * 20.0) + lz * (kz * 20.0)
            let relative = (speed - theirs).max(0.0)
            let dismounts = match k.dismount { some(c) => c.test(due.ticks, speed, relative, f64(0.2f32)), none => false }
            let knocks = match k.knockback { some(c) => c.test(due.ticks, speed, relative, f64(0.2f32)), none => false }
            let hurts = match k.damage { some(c) => c.test(due.ticks, speed, relative, f64(0.2f32)), none => false }
            if dismounts or knocks or hurts {
                let damage = f32.nearest(due.base_damage) + f32.nearest(floor(relative * f64(k.multiplier)))
                out.push(Stab { target: id, player: player, damage: damage, hurts: hurts, knocks: knocks, dismounts: dismounts })
            }
        }
        return out
    }

    // What the mob `a`, of the ID `id`, showed of its tick kept, `shown`, with its ID and the
    // sounds it came after, and forgotten by it; whether it bred among it (CAL-159).
    fn keep_shown(mut self, id: i32, a: mut Mob) -> bool {
        var bred = false
        for k in 0..a.living.shown.len() {
            if let Shown.Bred(_) = a.living.shown[k] {
                bred = true
            }
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        return bred
    }

    // The rest of the tick of the mob `mob` at `i`, after its goals, `tick_rest`, which `entered`
    // says whether it began, and whether it `bred` before (CAL-159): what it showed kept, whom its
    // hurt alerts told, it moved into its section, and where it's still here, it pushes what its
    // box meets, but where it bred, after the tick list's run past it.
    fn tick_mob_rest<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, entered: bool, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        let brained = a.brain != none
        // A bee's drips draw from the level's random too (CAL-177), and a schooling fish's look at its
        // school (CAL-178).
        let lent = brained or a.species == BEE or a.species == COD
        if lent {
            a.level_random = self.level_random.take()
        }
        if brained {
            a.pois = self.pois.take()
        }
        let stopped = a.tick_rest(entered, lf, f, m, t, blocks, items, mut self.path_types, players, min_y, fast_lava, mut sounds)
        if lent {
            self.level_random = a.level_random.take()
        }
        if brained {
            self.pois = a.pois.take()
        }
        self.tramples(mut a.living, a.mob_griefing, false)
        if stopped {
            // Its brain swung a door, which its level swings before its tick goes on, as vanilla
            // sets the block then and there, the paths of the mobs it's near enough found again
            // as `take_sent` takes it: what it showed so far kept, and what it did to others
            // done, and it stopped till the next `tick_next`, knowing what's near it still
            // (CAL-160).
            let told = a.told.copy()
            a.told.clear()
            let bred = self.keep_shown(id, mut a) or bred_before
            self.all[i] = some(Entity.Mob(a))
            self.heard = sounds.len()
            self.tell_others(told, f, sounds)
            self.paused = some((i, entered, bred))
            return
        }
        if brained {
            a.near.clear()
        }
        a.kin.clear()
        let alert = a.alerted
        a.alerted = none
        let told = a.told.copy()
        a.told.clear()
        // Whether it splits as it's taken out, a slime's `SPLIT_ON_DEATH` (CAL-175).
        var splits = false
        for w in a.living.shown {
            if let Shown.Split(s) = w {
                splits = not s.places.is_empty()
            }
        }
        let bred = self.keep_shown(id, mut a) or bred_before
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let within = a.living.attributes.value(lf.follow_range)
        let species = a.species
        self.all[i] = some(Entity.Mob(a))
        self.heard = sounds.len()
        if let target = alert {
            self.alert_others(id, species, ax, ay, az, within, target, players)
        }
        self.tell_others(told, f, sounds)
        if removed {
            // Gone in its own tick, a silverfish into a block, it's traced as vanilla's agent
            // traces it, its tick done, before it's taken away (CAL-172).
            if self.tracing {
                self.trace_mob(i)
            }
            if splits {
                self.first_rider_off(id)
            }
            self.remove(id)
        } else if bred {
            self.move_section(id, key)
            self.push_after = some(id)
        } else {
            self.move_section(id, key)
            self.push_entities(id, lf, f, blocks, items, players, mut sounds)
        }
        if entered and not removed {
            self.loot(id, lf, f, items, mut sounds)
        }
        if self.tracing and not removed {
            self.trace_mob(i)
        }
    }

    // What a mob's behaviors did to others in its tick, `Told`, done in their order (CAL-160): a
    // walk to it set in the brain of the mob it's for, and a villager's gossip with another, where
    // both are here.
    fn tell_others(mut self, told: List<Told>, f: Facts, sounds: List<EntitySound>) {
        for r in told {
            match r {
                Told.WalkTo(w) => {
                    let (of, to, speed, stop) = w
                    var other = self.lend_mob(of) else continue
                    other.walk_to(to, speed, stop)
                    self.give_back_mob(other)
                },
                Told.Erase(e) => {
                    let (of, memory) = e
                    var other = self.lend_mob(of) else continue
                    other.forget(memory)
                    self.give_back_mob(other)
                },
                Told.JobSite(j) => {
                    let (of, x, y, z, speed) = j
                    var other = self.lend_mob(of) else continue
                    other.take_job_site(x, y, z, speed, self.dimension.copy())
                    self.give_back_mob(other)
                },
                Told.BreedWith(b) => {
                    let (of, with) = b
                    var other = self.lend_mob(of) else continue
                    other.breed_with(with)
                    self.give_back_mob(other)
                },
                Told.Digest(of) => {
                    var other = self.lend_mob(of) else continue
                    other.eat_and_digest(f)
                    self.give_back_mob(other)
                },
                Told.Lead(l) => {
                    let (of, leader) = l
                    var other = self.lend_mob(of) else continue
                    other.leader = some(leader)
                    self.give_back_mob(other)
                },
                Told.School(s) => {
                    let (of, by) = s
                    var other = self.lend_mob(of) else continue
                    other.school_size += by
                    self.give_back_mob(other)
                },
                Told.Gossip(g) => {
                    let (of, with, now) = g
                    var other = self.lend_mob(with) else continue
                    let me = self.lend_mob(of) else {
                        self.give_back_mob(other)
                        continue
                    }
                    var mine = me
                    mine.gossip_with(mut other, now, sounds.len())
                    _ = self.keep_shown(of, mut mine)
                    self.heard = sounds.len()
                    self.give_back_mob(mine)
                    self.give_back_mob(other)
                },
            }
        }
    }

    // The items near the villager `a` for its brain (CAL-160): those its item sensor looks over,
    // in its box grown 32 across and 16 up and down, as `getEntitiesOfClass` finds them, each with
    // whether it wants it where its sensor's due this tick; then those its memories hold elsewhere,
    // and those gone from the level since, where they were last.
    fn items_for<W: Wearing>(self, a: Mob, lf: LivingFacts, f: Facts, items: W) -> List<Near> {
        let id = a.living.body.id
        let due = a.item_sensor_due()
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - 32.0, min_y: b.min_y - 16.0, min_z: b.min_z - 32.0, max_x: b.max_x + 32.0, max_y: b.max_y + 16.0, max_z: b.max_z + 32.0 }
        var out = List<Near>()
        for o in self.found(wide, id, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            var n = item_near(o, e)
            n.wanted = due and a.villager_wants(lf, f, items, e.stack.copy())
            out.push(n)
        }
        for w in a.watched() {
            var known = false
            for n in out {
                if n.id == w {
                    known = true
                }
            }
            if known {
                continue
            }
            if self.at.contains(w) {
                if let slot = self.all[self.at[w]] {
                    if let Entity.Item(e) = slot {
                        out.push(item_near(w, e))
                    }
                }
                continue
            }
            for n in a.near_items {
                if n.id == w {
                    var last = n
                    last.gone = true
                    last.wanted = false
                    out.push(last)
                }
            }
        }
        return out
    }

    // `Mob.aiStep`'s looting by the mob `id`, after its pushes (CAL-159): where it `loots`, each
    // item in its `pickup_box`, as `getEntitiesOfClass` finds them, that's still here, isn't empty,
    // has no pickup delay left and it wants, `pickUpItem`: it equips what it may of a copy, and
    // where it equips something, it's taken, `take`, which those who see the item are told, and
    // the item's stack shrinks by as much where it is, which isn't sent, the item gone where none's
    // left. Taking up what a player threw would tell them of it, `onItemPickup`, an advancement,
    // which comes with advancements.
    fn loot<W: Wearing>(mut self, id: i32, lf: LivingFacts, f: Facts, items: W, sounds: mut List<EntitySound>) {
        var mob = self.lend_mob(id) else return
        if not mob.loots() {
            self.give_back_mob(mob)
            return
        }
        for item in self.find(mob.pickup_box(), -1) {
            var e = self.lend(item) else continue
            let carries = mob.carries_inventory()
            let wants = if carries { mob.villager_wants(lf, f, items, e.stack.copy()) } else { mob.wants_to_pick_up(lf, e.stack.copy()) }
            if e.body.removed or e.is_empty() or e.pickup_delay > 0 or not wants {
                self.give_back(e)
                continue
            }
            // A villager's into its inventory, `InventoryCarrier.pickUpItem` (CAL-160); another's
            // equipped.
            var taken = 0
            if carries {
                taken = mob.pick_up_into(e.stack.copy(), f)
            } else {
                let equipped = mob.equip_if_possible(lf, items, e.stack.copy(), mut sounds) else {
                    self.give_back(e)
                    continue
                }
                taken = count_of(some(equipped))
            }
            mob.living.show(Shown.Picked((item, taken)), sounds.len())
            e.stack = counted(e.stack, e.count() - taken)
            let empty = e.is_empty()
            if empty {
                e.body.removed = true
            }
            self.give_back(e)
            if empty {
                self.heard = sounds.len()
                self.remove(item)
            }
        }
        _ = self.keep_shown(id, mut mob)
        self.heard = sounds.len()
        self.give_back_mob(mob)
    }

    // The line `--entity-trace` writes for the mob or armor stand at `i` as its tick is done
    // (CAL-159), as the rig agent's trace writes vanilla's as `tickNonPassenger` returns: the game
    // time, its ID, its place and motion, its turns, its body's and its head's, what it's told to
    // walk and its speed, and whether it's on the ground.
    fn trace_mob(mut self, i: usize) {
        // A passenger's ride isn't traced, as vanilla's trace runs from `tickNonPassenger` (D708).
        if let ticked = self.ticking {
            let (_, rode) = ticked
            if rode != none {
                return
            }
        }
        let taken = self.all[i].take() else return
        let line = traced(self.game_time, taken, self.trace_controls)
        self.all[i] = some(taken)
        self.trace.push_str(line)
    }

    // `HurtByTargetGoal.alertOthers` of the mob `id` at x, y, z, of `species`, its follow range
    // `within`, hurt by the player or mob `target` (CAL-159, CAL-244): the mobs of its class whose
    // boxes meet the block's box from its place, `unitCubeFromLowerCorner`, `within` beyond it
    // across and 10 up and down, in `getEntitiesOfClass`' order, but itself, each alerted where it
    // has no target, `alerted_to`, a mob among what it may take up. A zombie's class is the
    // zombies', husks' and zombie villagers', `Zombie`'s, but for the zombified piglins it
    // ignores; a husk's or a zombie villager's its own (CAL-175). No teams, so none are allied.
    fn alert_others(mut self, id: i32, species: i32, x: f64, y: f64, z: f64, within: f64, target: i32, players: List<Follower>) {
        let near = Aabb { min_x: x - within, min_y: y - 10.0, min_z: z - within, max_x: x + 1.0 + within, max_y: y + 1.0 + 10.0, max_z: z + 1.0 + within }
        // A mob that hurt it, as it is to the others, wherever they are (CAL-244).
        var hurter: Follower? = none
        if self.at.contains(target) {
            if let slot = self.all[self.at[target]] {
                if let Entity.Mob(h) = slot {
                    hurter = some(h.follower())
                }
            }
        }
        for other in self.found(near, id, 8) {
            var o = self.lend_mob(other) else continue
            let alike = if species == ZOMBIE { o.zombie_class() and o.species != ZOMBIFIED_PIGLIN } else { o.species == species }
            if alike {
                if let h = hurter {
                    var known = false
                    for p in o.prey {
                        known = known or p.id == target
                    }
                    if not known {
                        o.prey.push(h.copy())
                    }
                }
                o.alerted_to(target, players)
            }
            self.give_back_mob(o)
        }
    }

    /// `ServerPlayer.tellNeutralMobsThatIDied` of the player of the UUID `uuid`, who died in the
    /// block at x, y, z, where the game rule `forgive_dead_players` has it (CAL-159): the mobs
    /// whose boxes meet the block's box 32 beyond it across and 10 up and down,
    /// `getEntitiesOfClass`, none spectators, each told, `player_died`, as the neutral ones are.
    pub fn tell_player_died(mut self, x: i32, y: i32, z: i32, uuid: (i64, i64)) {
        let near = Aabb { min_x: f64(x) - 32.0, min_y: f64(y) - 10.0, min_z: f64(z) - 32.0, max_x: f64(x) + 33.0, max_y: f64(y) + 11.0, max_z: f64(z) + 33.0 }
        for other in self.found(near, -1, 8) {
            var o = self.lend_mob(other) else continue
            o.player_died(uuid)
            self.give_back_mob(o)
        }
    }

    // The mobs whose boxes meet the box 16 beyond the mob `a`'s on every side, but it, as `found`
    // finds them, as the goals of a mob there read them, `getEntitiesOfClass`'s for its kind
    // within less, and its parent's to 16 away (CAL-158); a cod's with itself among them
    // (CAL-178).
    fn kin_near(self, a: Mob) -> List<Kin> {
        let b = a.living.body.bounding_box()
        let me = a.living.body.id
        let wide = Aabb { min_x: b.min_x - 16.0, min_y: b.min_y - 16.0, min_z: b.min_z - 16.0, max_x: b.max_x + 16.0, max_y: b.max_y + 16.0, max_z: b.max_z + 16.0 }
        // A cod's hold itself, where `getEntitiesOfClass` finds it (CAL-178).
        let with_me = a.species == COD
        var out = List<Kin>()
        for id in self.found(wide, if with_me { -1 } else { me }, 8) {
            if id == me {
                if with_me {
                    out.push(self.kin_of_mob(id, a, me, a.living.alive()))
                }
                continue
            }
            let slot = self.all[self.at[id]] else continue
            let Entity.Mob(o) = slot else continue
            out.push(self.kin_of_mob(id, o, me, a.living.alive()))
        }
        return out
    }

    // What the mob `o`, of ID `id`, is to another's goals, `Kin`; `me` the ID of the mob ticking,
    // taken out of the level, and whether it's alive, as a school's leader may be (CAL-178).
    fn kin_of_mob(self, id: i32, o: Mob, me: i32, me_alive: bool) -> Kin {
        var follower = false
        if let l = o.leader {
            follower = if l == me { me_alive } else { self.mob_alive(l) }
        }
        return Kin {
            id: id,
            species: o.species,
            x: o.living.body.x,
            y: o.living.body.y,
            z: o.living.body.z,
            eyes: o.living.body.eyes,
            bounds: o.living.body.bounding_box(),
            age: o.age,
            in_love: o.in_love > 0,
            alive: o.living.alive(),
            panicking: o.goals.panicking(),
            variant: o.breed_variant(),
            school_size: o.school_size,
            follower: follower,
        }
    }

    // Whether the mob `id` is in the level and alive, `isAlive`: none gone is (CAL-178).
    fn mob_alive(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Mob(o) = slot else return false
        return o.living.alive() and not o.living.body.removed
    }

    // The leader of the schooling fish `a`, as its goals see it this tick, wherever it is in the
    // level; none where it's gone (CAL-178).
    fn leader_of(self, a: Mob) -> Kin? {
        let l = a.leader else return none
        if not self.at.contains(l) {
            return none
        }
        let slot = self.all[self.at[l]] else return none
        let Entity.Mob(o) = slot else return none
        return some(self.kin_of_mob(l, o, a.living.body.id, a.living.alive()))
    }

    // The other mobs the mob `a` may take up as its target this tick, or has as one, or that hurt
    // it, as they are to it (CAL-244): those whose boxes meet its own grown by its follow range
    // each way, as `found` finds them, the level's order, which `getEntitiesOfClass` has; then its
    // target and the mob that hurt it wherever they are in the level, as vanilla holds them, which
    // a target goal may keep or take up out of that reach.
    fn prey_near(self, a: Mob, lf: LivingFacts) -> List<Follower> {
        // An evoker's as far as 16 off, for the vexes it counts and the sheep it may turn red
        // (CAL-200).
        let follow = a.living.attributes.value(lf.follow_range)
        let r = if a.species == EVOKER and follow < 16.0 { 16.0 } else { follow }
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - r, min_y: b.min_y - r, min_z: b.min_z - r, max_x: b.max_x + r, max_y: b.max_y + r, max_z: b.max_z + r }
        let me = a.living.body.id
        var ids = self.found(wide, me, 8)
        if let t = a.target {
            if t != me and self.at.contains(t) and not ids.contains(t) {
                ids.push(t)
            }
        }
        if let t = a.owner_target {
            if t != me and self.at.contains(t) and not ids.contains(t) {
                ids.push(t)
            }
        }
        if let w = a.wololo {
            if w != me and self.at.contains(w) and not ids.contains(w) {
                ids.push(w)
            }
        }
        if let who = a.living.hurt_by_mob {
            for slot in self.all {
                let e = slot else continue
                let Entity.Mob(o) = e else continue
                let id = o.living.body.id
                if o.living.body.uuid == who and id != me and not ids.contains(id) {
                    ids.push(id)
                    break
                }
            }
        }
        var out = List<Follower>()
        for id in ids {
            let slot = self.all[self.at[id]] else continue
            let Entity.Mob(o) = slot else continue
            out.push(o.follower())
        }
        return out
    }

    // What the brain mob `a` reads of the living entities near it this tick, `Near` (CAL-160): the
    // mobs and armor stands whose boxes meet its own grown by its follow range, as `found` finds
    // them, then those its memories hold, `watched`, wherever they are in the level, then the
    // level's players, in their order, which vanilla finds among the rest in their sections
    // (CAL-190).
    fn brain_near(self, a: Mob, lf: LivingFacts, players: List<Follower>) -> List<Near> {
        let id = a.living.body.id
        let follow = a.living.attributes.value(lf.follow_range)
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - follow, min_y: b.min_y - follow, min_z: b.min_z - follow, max_x: b.max_x + follow, max_y: b.max_y + follow, max_z: b.max_z + follow }
        var ids = self.found(wide, id, 12)
        for w in a.watched() {
            if w != id and self.at.contains(w) and not ids.contains(w) {
                ids.push(w)
            }
        }
        var out = List<Near>()
        for o in ids {
            let slot = self.all[self.at[o]] else continue
            match slot {
                Entity.Mob(e) => {
                    let (profession, xp, site, here, seeks) = e.job_seen(self.dimension)
                    out.push(Near {
                    id: o,
                    uuid: e.living.body.uuid,
                    species: e.species,
                    x: e.living.body.x,
                    y: e.living.body.y,
                    z: e.living.body.z,
                    eyes: e.living.body.eyes,
                    bounds: e.living.body.bounding_box(),
                    alive: e.living.alive() and not e.living.body.removed,
                    baby: e.baby(),
                    undead: e.undead(),
                    panicking: e.panicking(),
                    in_love: e.in_love > 0,
                    category: e.category,
                    profession: profession,
                    villager_xp: xp,
                    job_site: site,
                    job_site_here: here,
                    seeks_job_site: seeks,
                    through: e.path_about(),
                    food: e.food_points(),
                    sleeping: e.sleeping(),
                    interacting: e.interaction_target(),
                    can_breed: e.can_breed(),
                    villager_type: e.villager_kind(),
                })
                },
                Entity.Stand(s) => out.push(Near {
                    id: o,
                    uuid: s.living.body.uuid,
                    species: OTHER,
                    x: s.living.body.x,
                    y: s.living.body.y,
                    z: s.living.body.z,
                    eyes: s.living.body.eyes,
                    bounds: s.living.body.bounding_box(),
                    alive: s.living.alive() and not s.living.body.removed,
                }),
                _ => {},
            }
        }
        let kind = i32.wrap(a.living.kind)
        for p in players {
            let point = Aabb { min_x: p.x, min_y: p.y, min_z: p.z, max_x: p.x, max_y: p.y, max_z: p.z }
            out.push(Near {
                id: p.id,
                uuid: p.uuid ?? (0i64, 0i64),
                species: PLAYER,
                x: p.x,
                y: p.y,
                z: p.z,
                eyes: p.eyes,
                bounds: p.bounds ?? point,
                alive: not p.dead,
                visibility: p.visibility(kind),
                spectator: p.spectator,
                sprinting: p.sprinting,
                tempts: p.tempts,
                main_hand: p.main_hand,
                enemy: p.enemy,
            })
        }
        return out
    }

    /// The bell at the place rung at the game time `now`, its block event's, `updateEntities`
    /// (CAL-160): where it last looked more than 60 ticks before, or never, the living entities
    /// whose boxes meet its block grown 48 each way looked for again, of which only mobs have
    /// brains; then each of those alive and still here within 32 of its middle hears it,
    /// `HEARD_BELL_TIME`. Its block entity's search is kept as long as the level is.
    pub fn hear_bell(mut self, x: i32, y: i32, z: i32, now: i64) {
        let key = BlockPos { x: x, y: y, z: z }.pack()
        var last: (i64, List<i32>)? = none
        if self.bells.contains(key) {
            last = some(self.bells[key].copy())
        }
        var near = List<i32>()
        var fresh = true
        if let (at, ids) = last {
            if now <= at + 60 {
                near = ids.copy()
                fresh = false
            }
        }
        if fresh {
            let (fx, fy, fz) = (f64(x), f64(y), f64(z))
            let b = Aabb { min_x: fx - 48.0, min_y: fy - 48.0, min_z: fz - 48.0, max_x: fx + 49.0, max_y: fy + 49.0, max_z: fz + 49.0 }
            near = self.found(b, -1, 8)
            self.bells.insert(key, (now, near.copy()))
        }
        let (cx, cy, cz) = (f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)
        for id in near {
            var m = self.lend_mob(id) else continue
            let (dx, dy, dz) = (m.living.body.x - cx, m.living.body.y - cy, m.living.body.z - cz)
            if m.living.alive() and not m.living.body.removed and dx * dx + dy * dy + dz * dz < 1024.0 {
                m.hear_bell(now)
            }
            self.give_back_mob(m)
        }
    }

    /// The push of the mob that bred in the entity's tick just done, once the level's made its baby
    /// and orb, which it then meets (D415); what a cramming's hurt shows of it kept to be shown,
    /// with its sounds in `sounds` (CAL-189).
    pub fn push_bred<B: CollisionBlocks + EntityTicking + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, blocks: B, items: W, players: List<Follower>, sounds: mut List<EntitySound>) {
        if let id = self.push_after {
            self.push_after = none
            self.push_entities(id, lf, f, blocks, items, players, mut sounds)
        }
    }

    // `pushEntities` for the mob `id` (CAL-156), which ends its `aiStep` in vanilla and comes here
    // after its tick, as nothing after it there reads its motion: the mobs and the players of
    // `players` whose boxes meet its own that may be pushed, `getPushableEntities`, in the order
    // `found` finds them, each in its place in its section, a player among the mobs (CAL-190);
    // where they're as many as the game rule `max_entity_cramming` or more, a draw of 4 from its
    // own random, and on a 0, with as many not riding, `isPassenger`, its hurt by 6 of
    // `cramming`, what it showed kept (CAL-189); then each in turn pushes and is pushed,
    // `doPush`, a player's push kept for the server, `player_pushes` (CAL-174).
    fn push_entities<B: CollisionBlocks + EntityTicking + Warding, W: Wearing>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B, items: W, players: List<Follower>, sounds: mut List<EntitySound>) {
        let me = self.lend_mob(id) else return
        let b = me.living.body.bounding_box()
        self.give_back_mob(me)
        // Each found, in turn: a mob, or a player, where they are and whether they ride.
        var mobs = List<i32>()
        var order = List<(i32, bool, f64, f64)>()
        var people = 0usize
        var people_riding = 0usize
        for other in self.found(b, id, 8 | PLAYERS) {
            if self.players_in.contains(other) {
                for p in players {
                    if p.id != other {
                        continue
                    }
                    if let pb = p.pushable {
                        if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                            order.push((other, true, p.x, p.z))
                            people += 1
                            if p.riding {
                                people_riding += 1
                            }
                        }
                    }
                }
            } else if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
                order.push((other, false, 0.0, 0.0))
            }
        }
        let n = order.len()
        if n == 0 {
            return
        }
        if self.cramming > 0 and n > usize.wrap(self.cramming - 1) {
            var drawing = self.lend_mob(id) else return
            let crams = drawing.living.body.random.next_int_below(4) == 0
            self.give_back_mob(drawing)
            if crams and self.not_riding(mobs, people, people_riding) > usize.wrap(self.cramming - 1) {
                var hurt = self.lend_mob(id) else return
                hurt.cram(lf, blocks, items, mut sounds)
                _ = self.keep_shown(id, mut hurt)
                self.give_back_mob(hurt)
                self.heard = sounds.len()
            }
        }
        // A vex has no physics through its tick, its push among it, `Vex.tick`, so it pushes and
        // is pushed by none of them then, `Entity.push` (CAL-200).
        let ghost = self.ghost(id, true)
        for (other, player, px, pz) in order {
            if not player {
                self.push_pair(id, other, lf, f, blocks)
                continue
            }
            // `player.push(mob)`: the player, who may be pushed, pushed away from it, then it
            // from them.
            var mover = self.lend_mob(id) else return
            if not mover.living.body.no_physics {
                let pushed = push_between(px, pz, mover.living.body.x, mover.living.body.z)
                if let q = pushed {
                    let (xa, za) = q
                    self.player_pushes.push((other, -xa, -za))
                    let ticking = ticking_at(blocks, mover.living.body.x, mover.living.body.z)
                    if mover.living.body.passengers.is_empty() and mover.pushable(lf, f, blocks, ticking) {
                        mover.living.body.push(xa, 0.0, za)
                    }
                }
            }
            self.give_back_mob(mover)
        }
        if ghost {
            _ = self.ghost(id, false)
        }
    }

    // Whether the mob `id` is a vex, which has no physics through its tick (CAL-200), that set to
    // `on` where it is.
    fn ghost(mut self, id: i32, on: bool) -> bool {
        var m = self.lend_mob(id) else return false
        let vex = m.species == VEX
        if vex {
            m.living.body.no_physics = on
        }
        self.give_back_mob(m)
        return vex
    }

    // `Entity.push(entity)` of the mob `other` by the mob `pusher`: where `other` isn't asleep,
    // `LivingEntity.push` (CAL-160), neither has no physics and they're far enough apart across,
    // each that may be pushed pushed away from the other.
    fn push_pair<B: CollisionBlocks + EntityTicking>(mut self, pusher: i32, other: i32, lf: LivingFacts, f: Facts, blocks: B) {
        // What rides with it, down to what they all ride, isn't pushed by it,
        // `isPassengerOfSameVehicle` (D708).
        if self.root_vehicle(pusher) == self.root_vehicle(other) {
            return
        }
        var a = self.lend_mob(pusher) else return
        var o = self.lend_mob(other) else {
            self.give_back_mob(a)
            return
        }
        if not o.sleeping() and not a.living.body.no_physics and not o.living.body.no_physics {
            let pushed = push_between(o.living.body.x, o.living.body.z, a.living.body.x, a.living.body.z)
            if let q = pushed {
                let (xa, za) = q
                // What something rides isn't moved by a push, `!isVehicle()` (D710).
                let other_ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                if o.living.body.passengers.is_empty() and o.pushable(lf, f, blocks, other_ticks) {
                    o.living.body.push(-xa, 0.0, -za)
                }
                let pusher_ticks = ticking_at(blocks, a.living.body.x, a.living.body.z)
                if a.living.body.passengers.is_empty() and a.pushable(lf, f, blocks, pusher_ticks) {
                    a.living.body.push(xa, 0.0, za)
                }
            }
        }
        self.give_back_mob(o)
        self.give_back_mob(a)
    }

    // How many of the mobs `mobs` and the players, less the `riders` of them riding, aren't riding
    // anything, `isPassenger`, as cramming counts them (CAL-189). `people` is how many players.
    fn not_riding(mut self, mobs: List<i32>, people: usize, riders: usize) -> usize {
        var n = people - riders
        for id in mobs {
            if let m = self.lend_mob(id) {
                if m.living.body.vehicle == none {
                    n += 1
                }
                self.give_back_mob(m)
            }
        }
        return n
    }

    // Whether the mob `id` may be pushed, `isPushable`, as `getPushableEntities` asks.
    fn mob_pushable<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        var m = self.lend_mob(id) else return false
        let ticks = ticking_at(blocks, m.living.body.x, m.living.body.z)
        let p = m.pushable(lf, f, blocks, ticks)
        self.give_back_mob(m)
        return p
    }

    /// A player's `pushEntities` (CAL-156), the player `me` at `x`, `z`, whose box is `b`: the
    /// mobs whose boxes meet it that may be pushed, as `push_entities` finds them, and the other
    /// players of `others`, those the server found may be, each in its place in its section
    /// (CAL-190); each mob pushed away from the player, `mob.push(player)`, where the player has
    /// physics, not a spectator, as `pushes` says, and the player pushed away from it where they
    /// may be, `pushed`, kept in `player_pushes` (CAL-174); each turn, a mob's with the player's
    /// push or a player to push, in `push_turns`, for the server to push the player by in that
    /// order. How many mobs there were, which with the other players are what the cramming
    /// counts, and how many of them don't ride anything, `pushed_not_riding`, which a cramming's
    /// hurt counts (CAL-189).
    pub fn pushed_by_player<B: CollisionBlocks + EntityTicking>(mut self, me: i32, x: f64, z: f64, b: Aabb, pushes: bool, pushed: bool, lf: LivingFacts, f: Facts, blocks: B, others: List<i32>) -> usize {
        self.push_turns.clear()
        var mobs = List<i32>()
        var order = List<(i32, bool)>()
        for other in self.found(b, me, 8 | PLAYERS) {
            if self.players_in.contains(other) {
                if others.contains(other) {
                    order.push((other, true))
                }
            } else if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
                order.push((other, false))
            }
        }
        self.pushed_not_riding = self.not_riding(mobs.copy(), 0, 0)
        if not pushes {
            return mobs.len()
        }
        for (other, player) in order {
            if player {
                self.push_turns.push((other, true, 0.0, 0.0))
                continue
            }
            var o = self.lend_mob(other) else continue
            // `mob.push(player)`, which a sleeper doesn't (CAL-160).
            if not o.sleeping() and not o.living.body.no_physics {
                let away = push_between(o.living.body.x, o.living.body.z, x, z)
                if let q = away {
                    let (xa, za) = q
                    let ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                    if o.living.body.passengers.is_empty() and o.pushable(lf, f, blocks, ticks) {
                        o.living.body.push(-xa, 0.0, -za)
                    }
                    if pushed {
                        self.player_pushes.push((me, xa, za))
                        self.push_turns.push((other, false, xa, za))
                    }
                }
            }
            self.give_back_mob(o)
        }
        return mobs.len()
    }

    /// Where the arrows are that aren't gone, which a wooden button's tick looks for in its shape
    /// (CAL-159).
    pub fn arrow_places(self) -> List<(f64, f64, f64)> {
        var out = List<(f64, f64, f64)>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Arrow(a) = e {
                    if not a.body.removed {
                        out.push((a.body.x, a.body.y, a.body.z))
                    }
                }
            }
        }
        return out
    }

    /// Those of its entities whose nether portals take them as their next ticks handle them, as
    /// the level's tick begins: in one last tick and able to go through it, `canUsePortal`, a
    /// nether portal's wait being none for what isn't a player (D578). The server's thread loads
    /// what their ways read as their ticks go; Calcite's tick holds for it as it begins.
    /// The ID of the entity whose tick `tick_next` begins next, of those that came into the level
    /// before `before`, none where it goes on with one it stopped or there's none (D595).
    pub fn next_up(self, before: u64) -> i32? {
        if self.paused != none or self.paused_start != none or self.paused_use != none or self.paused_arrow != none {
            return none
        }
        var place = self.cursor
        while place < self.end {
            if let id = self.tick_list[place] {
                if let e = self.all[self.at[id]] {
                    if entered_of(e) >= before {
                        return none
                    }
                    return some(id)
                }
            }
            place += 1
        }
        return none
    }

    pub fn portals_due(self) -> List<PortalDue> {
        var out = List<PortalDue>()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Item(i) => due_of(mut out, i.body, not i.body.removed),
                Entity.Orb(o) => due_of(mut out, o.body, not o.body.removed),
                Entity.Stand(a) => due_of(mut out, a.living.body, a.living.alive() and a.living.sleeping == none),
                Entity.Mob(m) => due_of(mut out, m.living.body, m.living.alive() and m.living.sleeping == none),
                Entity.Arrow(a) => due_of(mut out, a.body, not a.body.removed),
                Entity.Thrown(p) => due_of(mut out, p.body, true),
                Entity.Cloud(_) => {},
                Entity.Crystal(c) => due_of(mut out, c.body, not c.body.removed),
                Entity.Eye(_) => {},
                Entity.Fireball(b) => due_of(mut out, b.body, not b.body.removed),
                Entity.Tnt(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Knot(p) => due_of(mut out, p.body, not p.body.removed),
                Entity.Fangs(p) => due_of(mut out, p.body, not p.body.removed),
            }
        }
        return out
    }

    /// The ender pearls among the pearls of the player of the serial `serial`, not gone, in its
    /// order, `getEnderPearls` (D580): what's saved of each, `saveAsPassenger`, and its ID.
    pub fn pearls_of(self, serial: i64) -> List<(i32, Tag)> {
        var out = List<(i32, Tag)>()
        if serial == 0 {
            return out
        }
        for slot in self.all {
            let e = slot else continue
            if let Entity.Thrown(p) = e {
                if p.pearl and not p.body.removed and p.registered == serial {
                    out.push((p.body.id, p.saved()))
                }
            }
        }
        return out
    }

    /// Those of its thrown items and arrows whose nether portals would take them in their own
    /// steps this tick, which go the tick they come into one, as `portals_due` lists those
    /// already in one (D579): each run ahead on a copy as the level's tick begins, its move
    /// among `blocks` as they are then, what entities it'd hit passed over, where its way takes
    /// it into a portal while its cooldown's out. So the server's tick holds for what their
    /// ways read too, which vanilla's thread loads as their ticks take them.
    pub fn portals_coming<B: CollisionBlocks + Rain + Gateways>(self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool) -> List<PortalDue> {
        var out = List<PortalDue>()
        let border = self.border ?? widest_border()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Thrown(p) => {
                    if not p.body.removed {
                        var ahead = p.copy()
                        var heard = List<EntitySound>()
                        ahead.tick_start(f, m, blocks, border, 0)
                        ahead.go(f, blocks, none, mut heard)
                        due_of(mut out, ahead.body, true)
                    }
                },
                Entity.Arrow(a) => {
                    if not a.body.removed and not a.in_ground() {
                        var ahead = a.copy()
                        var heard = List<EntitySound>()
                        if ahead.tick_start(f, m, t, blocks, min_y, fast_lava, none, border, mut heard) {
                            let from = (ahead.body.x, ahead.body.y, ahead.body.z)
                            ahead.body.x = ahead.way.x
                            ahead.body.y = ahead.way.y
                            ahead.body.z = ahead.way.z
                            ahead.step_acts(f, blocks, from, mut heard)
                            due_of(mut out, ahead.body, true)
                        }
                    }
                },
                _ => {},
            }
        }
        return out
    }

    /// The pushes players took since they were last taken, `player_pushes`, which are then
    /// forgotten (CAL-174).
    pub fn take_player_pushes(mut self) -> List<(i32, f64, f64)> {
        let out = self.player_pushes.copy()
        self.player_pushes.clear()
        return out
    }

    // What blocks did to the item or orb `id` that its level's to do (D435), kept as what a living
    // entity shows is: redstone ore lit, and what's missing; a snowflake powder snow may show,
    // drawn from the level's random then and there, `snowflake` (D698); a pressure plate gone into,
    // with what's on it then, the entity's own box `boxed` among them, `plate_counts` (D701).
    fn keep_acted(mut self, id: i32, boxed: Aabb, acted: List<Acted>, after: List<usize>) {
        for k in 0..acted.len() {
            let shown = match acted[k] {
                Acted.Plate(at) => Shown.Plate((at, self.plate_counts(at, id, some(boxed), false))),
                Acted.Tripwire(at) => Shown.Tripwire(at),
                Acted.Dripleaf(at) => Shown.Dripleaf(at),
                Acted.Rail(at) => Shown.Rail(at),
                Acted.Snow(at) => Shown.Snow((at, self.snowflake())),
                Acted.Honey(at) => Shown.Honey((at, self.honey_draws())),
                Acted.Bubbles(at) => Shown.Bubbles((at, self.bubble_draws())),
                Acted.Melted(at) => Shown.Melted(at),
                Acted.Lit(at) => Shown.Lit(at),
                Acted.Pressed(at) => Shown.Pressed(at),
                Acted.Missing(what) => Shown.Missing(what.copy()),
                Acted.Event(n) => Shown.Event(n),
                Acted.Travel(way) => Shown.Travel(way.copy()),
                Acted.Gateway(g) => Shown.Gateway(g),
                Acted.Moved(m) => Shown.Moved(m),
                Acted.Doused(at) => Shown.Doused(at),
                Acted.Emptied(s) => Shown.Emptied(s.copy()),
            }
            self.shown.push(shown)
            self.shown_by.push(id)
            self.shown_after.push(after[k])
        }
    }

    // `EntityEquipment.tick`, in `LivingEntity.aiStep`, for the mob's or armor stand's `living`
    // (D607): each stack of its equipment, by `EquipmentSlot`'s order, a lodestone compass's
    // tracker ticked, `CompassItem.inventoryTick`, the stack changed in place where its target's
    // gone, which `detectEquipmentUpdates` finds in its next tick; a target whose chunk's points
    // of interest aren't read yet asked for, `poi_asks`; and a map in a hand, which draws what's
    // about it, `MapItem.inventoryTick`, told of, as Calcite has no maps yet. Calcite ticks it as
    // the rest of `aiStep` ends, which nothing between reads.
    fn equipment_tick(mut self, living: mut Living, heard: usize) {
        var ticks = false
        for s in living.equipment {
            let item = stack_item(s.copy())
            if item == "minecraft:compass" or item == "minecraft:filled_map" {
                ticks = true
            }
        }
        if not ticks {
            return
        }
        let pois = self.pois.take() else return
        for slot in 0..living.equipment.len() {
            let stack = living.equipment[slot].copy()
            match lodestone_tick(stack.copy(), self.dimension.copy(), pois) {
                TrackerTick.Lost(s) => living.equipment[slot] = some(s),
                TrackerTick.Unknown(c) => self.poi_asks.push(c),
                TrackerTick.Kept => {},
            }
            if slot <= 1 and draws_map(stack) {
                living.show(Shown.Missing(String("Maps drawing what's about those who carry them")), heard)
            }
        }
        self.pois = some(pois)
    }

    // An armor stand's tick, at `i`: what it showed kept with its ID, and it gone where its tick
    // took it away, below the level or broken (D441); its equipment ticked where it's still
    // there (D607).
    fn tick_stand<B: CollisionBlocks + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, stand: own ArmorStand, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = stand
        a.living.hurt_by_found = self.hurter_alive(a.living)
        a.tick(lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
        let griefing = self.mob_griefing
        let marker = a.marker()
        self.tramples(mut a.living, griefing, marker)
        if not a.living.body.removed {
            self.equipment_tick(mut a.living, sounds.len())
        }
        let id = a.living.body.id
        for k in 0..a.living.shown.len() {
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        self.all[i] = some(Entity.Stand(a))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
            if self.tracing {
                self.trace_mob(i)
            }
        }
    }

    // An item's tick, at `i`: to where it merges, its merging, then the rest; what blocks did
    // that its level's to do kept with its ID (D435).
    fn tick_item<B: CollisionBlocks + EntityTicking + Rain + Gateways, S: StackSizes + Wearing>(mut self, i: usize, item: own ItemEntity, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        var e = item
        e.tick_moving(f, m, t, types, codecs, blocks, min_y, fast_lava, mut sounds)
        if let landed = e.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = e.body.id
        self.keep_acted(id, e.body.bounding_box(), e.acted, e.acted_after)
        e.acted.clear()
        e.acted_after.clear()
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let due = e.merge_due and e.mergable(codecs.stack_most(e.stack))
        let removed = e.body.removed
        self.all[i] = some(Entity.Item(e))
        if not removed {
            self.move_section(id, key)
        }
        self.heard = sounds.len()
        if due {
            self.merge_near(i, codecs)
        }
        var after = self.lend(id) else return
        after.tick_after(f, t, blocks, fast_lava, mut sounds)
        let done = after.body.removed
        self.give_back(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    /// `Block.pushEntitiesUp` of what's in the way of `slab`, the part a block grows by, as
    /// farmland turns to dirt (CAL-160): each entity whose box meets it, in the order they're
    /// found, moved up by what a move down from a block above it leaves, `Shapes.collide`,
    /// `teleportRelative`, its place where it was last tick too, as `snapTo` sets it.
    pub fn push_up(mut self, slab: Aabb) {
        for id in self.find_every(slab, -1) {
            self.lift(id, slab.max_y)
        }
    }

    /// A shulker box's lid opening into the box `b`, `moveCollidedEntities` (D695): each entity
    /// whose box meets it, as `getEntities(null, b)` finds them, moved by dx, dy, dz,
    /// `Entity.move(MoverType.SHULKER_BOX, ...)`, but those a piston ignores,
    /// `PushReaction.IGNORE_ENTITY`, clouds and marker armor stands: an armor stand's and a mob's
    /// moves as their own are, their steps among `sounds`, what landing on farmland and turtle eggs
    /// does kept with what they show, as `tramples` keeps it; an arrow's falling again where it's
    /// in the ground with nothing around, `shoved`; the rest's moves, farmland drawing as they land
    /// on it. Each is moved into the section it's in then.
    pub fn lid_push<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, b: Aabb, dx: f64, dy: f64, dz: f64, fast_lava: bool, sounds: mut List<EntitySound>) {
        let griefing = self.mob_griefing
        for id in self.found(b, -1, 1983) {
            if not self.at.contains(id) {
                continue
            }
            let i = self.at[id]
            let taken = self.all[i].take() else continue
            var fell: f64? = none
            let pushed = match taken {
                Entity.Stand(a) => {
                    var it = a
                    if not it.marker() {
                        it.living.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
                        self.tramples(mut it.living, griefing, false)
                        for k in 0..it.living.shown.len() {
                            self.shown.push(it.living.shown[k].copy())
                            self.shown_by.push(id)
                            self.shown_after.push(it.living.shown_after[k])
                        }
                        it.living.shown.clear()
                        it.living.shown_after.clear()
                    }
                    Entity.Stand(it)
                },
                Entity.Mob(mob) => {
                    var it = mob
                    it.living.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
                    self.tramples(mut it.living, griefing, false)
                    _ = self.keep_shown(id, mut it)
                    Entity.Mob(it)
                },
                Entity.Arrow(a) => {
                    var it = a
                    it.shoved(f, m, t, blocks, dx, dy, dz)
                    Entity.Arrow(it)
                },
                Entity.Item(e) => {
                    var it = e
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Item(it)
                },
                Entity.Orb(o) => {
                    var it = o
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Orb(it)
                },
                Entity.Thrown(p) => {
                    var it = p
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Thrown(it)
                },
                Entity.Crystal(c) => {
                    var it = c
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Crystal(it)
                },
                Entity.Eye(e) => {
                    var it = e
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Eye(it)
                },
                Entity.Fireball(fb) => {
                    var it = fb
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Fireball(it)
                },
                Entity.Tnt(p) => {
                    var it = p
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Tnt(it)
                },
                Entity.Knot(p) => {
                    var it = p
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Knot(it)
                },
                Entity.Fangs(p) => {
                    var it = p
                    it.body.move_by(f, m, t, blocks, dx, dy, dz)
                    fell = landed_on_farmland(mut it.body)
                    Entity.Fangs(it)
                },
                other => other,
            }
            if let landed = fell {
                _ = self.farmland_draw(landed)
            }
            let (x, y, z) = place_of(pushed)
            self.all[i] = some(pushed)
            self.move_section(id, section_key(x, y, z))
        }
    }

    // The entity `id` moved up by `1 + offset`, `offset` a move down of 1 from a block above
    // stopped at `top`, as `pushEntitiesUp` moves it; moved into the section it's in now.
    fn lift(mut self, id: i32, top: f64) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        let lifted = match taken {
            Entity.Item(e) => {
                var it = e
                lift_body(mut it.body, top)
                Entity.Item(it)
            },
            Entity.Orb(o) => {
                var it = o
                lift_body(mut it.body, top)
                Entity.Orb(it)
            },
            Entity.Stand(a) => {
                var it = a
                lift_body(mut it.living.body, top)
                Entity.Stand(it)
            },
            Entity.Mob(m) => {
                var it = m
                lift_body(mut it.living.body, top)
                Entity.Mob(it)
            },
            Entity.Arrow(a) => {
                var it = a
                lift_body(mut it.body, top)
                Entity.Arrow(it)
            },
            Entity.Thrown(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Thrown(it)
            },
            Entity.Cloud(c) => {
                var it = c
                lift_body(mut it.body, top)
                Entity.Cloud(it)
            },
            Entity.Crystal(c) => {
                var it = c
                lift_body(mut it.body, top)
                Entity.Crystal(it)
            },
            Entity.Eye(e) => {
                var it = e
                lift_body(mut it.body, top)
                Entity.Eye(it)
            },
            Entity.Fireball(b) => {
                var it = b
                lift_body(mut it.body, top)
                Entity.Fireball(it)
            },
            Entity.Tnt(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Tnt(it)
            },
            Entity.Knot(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Knot(it)
            },
            Entity.Fangs(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Fangs(it)
            },
        }
        let (x, y, z) = place_of(lifted)
        self.all[i] = some(lifted)
        self.move_section(id, section_key(x, y, z))
    }

    // `FarmlandBlock.fallOn`'s draw from the level's random for what landed on farmland, `fell`
    // up, in its tick, as its move's done (CAL-160): whether the draw's under its fall less a
    // half, so a living entity big enough would trample it.
    // `PowderSnowBlock.entityInside`'s snowflake, from the level's random for what moved in powder
    // snow (D698): whether it comes, `nextBoolean`, and where it does, its motion across each way,
    // `Mth.randomBetween(random, -1, 1) * 0.083333336F`, x first.
    fn snowflake(mut self) -> (f32, f32)? {
        let lent = self.level_random.take() else return none
        var r = lent
        var out: (f32, f32)? = none
        if r.next_boolean() {
            let sx = (r.next_float() * 2.0f32 - 1.0f32) * 0.083333336f32
            let sz = (r.next_float() * 2.0f32 - 1.0f32) * 0.083333336f32
            out = some((sx, sz))
        }
        self.level_random = some(r)
        return out
    }

    // `HoneyBlock.maybeDoSlideEffects`' draws from the level's random for what slid down a honey
    // block (D699): whether its slide's sound comes, 1 in 5, then whether its entity event does.
    fn honey_draws(mut self) -> (bool, bool)? {
        let lent = self.level_random.take() else return none
        var r = lent
        let heard = r.next_int_below(5) == 0
        let event = r.next_int_below(5) == 0
        self.level_random = some(r)
        return some((heard, event))
    }

    // `Entity.sendBubbleColumnParticles`' draws from the level's random for the top of a bubble
    // column (D700): twice a splash's place across and then a bubble's, each x then z.
    fn bubble_draws(mut self) -> List<(f64, f64)> {
        var out = List<(f64, f64)>()
        let lent = self.level_random.take() else return out
        var r = lent
        for _ in 0..4 {
            let x = r.next_double()
            let z = r.next_double()
            out.push((x, z))
        }
        self.level_random = some(r)
        return out
    }

    fn farmland_draw(mut self, fell: f64) -> bool {
        let lent = self.level_random.take() else return false
        var r = lent
        let trampled = f64(r.next_float()) < fell - 0.5
        self.level_random = some(r)
        return trampled
    }

    // `FarmlandBlock.fallOn` for the farmland `living` landed on in its tick, `Shown.Trampled`, each
    // in its place among what it showed, so its level turns it to dirt before what the fall's hurt
    // shows (CAL-160, CAL-172): a draw from the level's random under the fall, less a half,
    // `farmland_draw`, kept as whether it tramples it, where it's big enough; and where it does
    // and mob griefing lets it, `canTrample`, it's pushed up onto the dirt's top then and there,
    // as vanilla's move pushes it, before its trace; what else is in the way is pushed as its
    // level turns the farmland to dirt. A snowflake powder snow may show, `Shown.Snow`, is drawn
    // the same, in its place, `snowflake` (D698), and a pressure plate gone into, with what's on it
    // then, `plate_counts`, `living` among them but where it's a marker armor stand, `marker`
    // (D701).
    fn tramples(mut self, living: mut Living, griefing: bool, marker: bool) {
        for k in 0..living.shown.len() {
            if let Shown.Plate((at, _)) = living.shown[k] {
                let boxed: Aabb? = if marker { none } else { some(living.body.bounding_box()) }
                living.shown[k] = Shown.Plate((at, self.plate_counts(at, living.body.id, boxed, true)))
            }
            // A snowflake powder snow may show, drawn in its place among the rest (D698).
            if let Shown.Snow((at, _)) = living.shown[k] {
                living.shown[k] = Shown.Snow((at, self.snowflake()))
            }
            // A honey block's slide sound and entity event, drawn the same (D699).
            if let Shown.Honey((at, _)) = living.shown[k] {
                living.shown[k] = Shown.Honey((at, self.honey_draws()))
            }
            // A bubble column's splashes and bubbles, drawn the same (D700).
            if let Shown.Bubbles((at, _)) = living.shown[k] {
                living.shown[k] = Shown.Bubbles((at, self.bubble_draws()))
            }
            if let Shown.Trampled((fell, x, y, z, big)) = living.shown[k] {
                let trampled = self.farmland_draw(fell) and big
                living.shown[k] = Shown.Trampled((fell, x, y, z, trampled))
                let top = f64(y) + 1.0
                if trampled and griefing and living.body.y < top {
                    lift_body(mut living.body, top)
                }
            }
        }
    }

    // An orb's tick, at `i`: to where it looks for orbs to take in, its look, then the rest; what
    // blocks did that its level's to do kept with its ID, and its sounds heard (D435).
    fn tick_orb<B: CollisionBlocks + EntityTicking + Rain + Gateways>(mut self, i: usize, orb: own ExperienceOrb, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var o = orb
        o.tick_start(f, m, t, types, blocks, min_y, fast_lava)
        let id = o.body.id
        let due = o.merge_due
        self.all[i] = some(Entity.Orb(o))
        if due {
            self.scan_merges(id)
        }
        var after = self.lend_orb(id) else return
        after.tick_rest(f, m, t, types, blocks, players, self.away, mut sounds)
        if let landed = after.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let done = after.body.removed
        self.keep_acted(id, after.body.bounding_box(), after.acted, after.acted_after)
        after.acted.clear()
        after.acted_after.clear()
        self.give_back_orb(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    // `scanForMerges` for the orb `id`: each orb it may take in whose box meets its own, half a
    // block bigger each way, found first, then taken in in the order they were found.
    fn scan_merges(mut self, id: i32) {
        let me = self.orb_view(id) else return
        let b = me.body.bounding_box()
        let near = Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.5, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.5, max_z: b.max_z + 0.5 }
        var found = List<i32>()
        for other in self.find_orbs(near, id) {
            let o = self.orb_view(other) else continue
            if me.takes_in(o) {
                found.push(other)
            }
        }
        for other in found {
            var into = self.lend_orb(id) else return
            var from = self.lend_orb(other) else {
                self.give_back_orb(into)
                continue
            }
            into.take_in(mut from)
            self.give_back_orb(into)
            self.give_back_orb(from)
            self.remove(other)
        }
    }

    /// Ends a tick: the empty places go once there are as many as entities.
    pub fn end_tick(mut self) {
        self.cursor = 0
        self.end = 0
        self.heard = 0
        if self.empty > 16 and self.empty > self.at.len() {
            self.compact()
        }
        if self.tick_empty > 16 and self.tick_empty > self.tick_place.len() {
            self.compact_tick_list()
        }
    }

    // Drops the tick list's empty places, keeping the order.
    fn compact_tick_list(mut self) {
        var kept = List<i32?>()
        self.tick_place.clear()
        for slot in self.tick_list {
            if let id = slot {
                self.tick_place.insert(id, kept.len())
                kept.push(some(id))
            }
        }
        self.tick_list = kept
        self.tick_empty = 0
    }

    /// `mergeWithNeighbours` of the item `id` where it's mergable, `isMergable`, as `teleport`
    /// merges an item a nether portal took (D578).
    pub fn merge_item<S: StackSizes>(mut self, id: i32, codecs: S) {
        if not self.mergable(id, codecs) {
            return
        }
        let i = self.at[id]
        self.merge_near(i, codecs)
    }

    // `mergeWithNeighbours` for the item at `i`: each mergable item whose box meets its own, 0.5
    // bigger across, in the order they're found, until it's gone.
    fn merge_near<S: StackSizes>(mut self, i: usize, codecs: S) {
        let (id, near) = self.near_box(i) else return
        var found = List<i32>()
        for other in self.find(near, id) {
            if self.mergable(other, codecs) {
                found.push(other)
            }
        }
        for other in found {
            if not self.mergable(other, codecs) {
                continue
            }
            self.try_merge(id, other, codecs)
            if not self.at.contains(id) {
                break
            }
        }
    }

    // The ID of the item at `i` and its box, 0.5 bigger across, `inflate(0.5, 0, 0.5)`.
    fn near_box(self, i: usize) -> (i32, Aabb)? {
        let slot = self.all[i] else return none
        let Entity.Item(e) = slot else return none
        let b = e.body.bounding_box()
        return some((e.body.id, Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.0, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.0, max_z: b.max_z + 0.5 }))
    }

    fn mergable<S: StackSizes>(self, id: i32, codecs: S) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Item(e) = slot else return false
        return e.mergable(codecs.stack_most(e.stack))
    }

    // `tryToMerge`: for the same target, and stacks that fit together, the one with fewer goes
    // into the other, or this one into the other where they've as many.
    fn try_merge<S: StackSizes>(mut self, id: i32, other: i32, codecs: S) {
        let order = self.merge_order(id, other, codecs)
        if order == 1 {
            self.merge_into(id, other, codecs)
        } else if order == 2 {
            self.merge_into(other, id, codecs)
        }
    }

    // Which way `tryToMerge` merges: 0 not at all, 1 `other` into `id`, 2 `id` into `other`.
    fn merge_order<S: StackSizes>(self, id: i32, other: i32, codecs: S) -> i32 {
        let sa = self.all[self.at[id]] else return 0
        let sb = self.all[self.at[other]] else return 0
        let Entity.Item(a) = sa else return 0
        let Entity.Item(b) = sb else return 0
        if a.target != b.target {
            return 0
        }
        if b.count() + a.count() > codecs.stack_most(b.stack) {
            return 0
        }
        if not same_components(some(a.stack.copy()), some(b.stack.copy())) {
            return 0
        }
        return if b.count() < a.count() { 1 } else { 2 }
    }

    // `merge`: as much of `from`'s stack as fits, to 64, goes to `to`'s, which keeps the longer
    // pickup delay and the younger age; `from` goes if it's none left.
    fn merge_into<S: StackSizes>(mut self, to: i32, from: i32, codecs: S) {
        var source = self.lend(from) else return
        var target = self.lend(to) else {
            self.give_back(source)
            return
        }
        let most = min(codecs.stack_most(target.stack), 64)
        let moving = min(most - target.count(), source.count())
        target.stack = counted(target.stack, target.count() + moving)
        target.stack_changed = true
        // `shrink`: the stack changes where it is, which isn't sent.
        source.stack = counted(source.stack, source.count() - moving)
        if source.pickup_delay > target.pickup_delay {
            target.pickup_delay = source.pickup_delay
        }
        if source.age < target.age {
            target.age = source.age
        }
        let empty = source.is_empty()
        if empty {
            source.body.removed = true
        }
        self.give_back(target)
        self.give_back(source)
        if empty {
            self.remove(from)
        }
    }

    // Moves the entity `id` to the section `key` if it isn't in it, last there, as `onMove` does.
    fn move_section(mut self, id: i32, key: i64) {
        if self.section_of.contains(id) {
            let old = self.section_of[id]
            if old == key {
                return
            }
            self.out_of_section(id, old)
        }
        self.into_section(id, key)
    }

    fn into_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            self.sections.insert(key, List<i32>())
            let k = section_chunk(key).pack()
            if not self.chunk_sections.contains(k) {
                self.chunk_sections.insert(k, List<i64>())
            }
            self.chunk_sections[k].push(key)
        }
        self.sections[key].push(id)
        self.section_of.insert(id, key)
    }

    fn out_of_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            return
        }
        var kept = List<i32>()
        for other in self.sections[key] {
            if other != id {
                kept.push(other)
            }
        }
        if kept.is_empty() {
            _ = self.sections.remove(key)
            let k = section_chunk(key).pack()
            if self.chunk_sections.contains(k) {
                var left = List<i64>()
                for other in self.chunk_sections[k] {
                    if other != key {
                        left.push(other)
                    }
                }
                if left.is_empty() {
                    _ = self.chunk_sections.remove(k)
                } else {
                    self.chunk_sections.insert(k, left)
                }
            }
        } else {
            self.sections.insert(key, kept)
        }
    }

    // Drops the empty places, keeping the order.
    fn compact(mut self) {
        var kept = List<Entity?>()
        self.at.clear()
        for i in 0..self.all.len() {
            if let e = self.all[i].take() {
                self.at.insert(id_of(e), kept.len())
                kept.push(some(e))
            }
        }
        self.all = kept
        self.empty = 0
    }
}

// Whether the chunk at x, z ticks its entities, `isPositionEntityTicking`.
fn ticking_at<B: EntityTicking>(blocks: B, x: f64, z: f64) -> bool {
    return blocks.ticks_entities(i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
}

// The entity's ID.
// The body `b` an ender pearl took to x, y, z, as `Entities.pearl_take` puts it (D585): there and
// there last tick, where it was last known forgotten, still, nothing moved this tick and nothing
// fallen, at its own yaw and pitch. What the pearl took, those that see it told at once where
// `told`.
fn pearl_set(b: mut Body, x: f64, y: f64, z: f64, told: bool) -> PearlTaken {
    b.x = x
    b.y = y
    b.z = z
    b.last_known = none
    b.xo = x
    b.yo = y
    b.zo = z
    b.vx = 0.0
    b.vy = 0.0
    b.vz = 0.0
    b.moves.clear()
    b.fall = 0.0
    return PearlTaken { y_rot: b.y_rot, x_rot: b.x_rot, on_ground: b.on_ground, told: told }
}

// The living entity `l` an ender pearl took to x, y, z, as `pearl_set` puts its body (D585), its
// head turned to its yaw, `setYHeadRot`, its yaw and pitch last tick its own, `setOldRot`, and its
// impulse forgotten, `resetCurrentImpulseContext`; those that see it aren't told at once.
fn pearl_set_living(l: mut Living, x: f64, y: f64, z: f64) -> PearlTaken {
    let taken = pearl_set(mut l.body, x, y, z, false)
    l.y_head_rot = l.body.y_rot
    l.y_rot_o = l.body.y_rot
    l.x_rot_o = l.body.x_rot
    l.impulse_grace = 0
    l.impulse_at = none
    return taken
}

fn id_of(e: Entity) -> i32 {
    return match e {
        Entity.Item(i) => i.body.id,
        Entity.Orb(o) => o.body.id,
        Entity.Stand(a) => a.living.body.id,
        Entity.Mob(m) => m.living.body.id,
        Entity.Arrow(a) => a.body.id,
        Entity.Thrown(p) => p.body.id,
        Entity.Cloud(c) => c.body.id,
        Entity.Crystal(c) => c.body.id,
        Entity.Eye(eye) => eye.body.id,
        Entity.Fireball(b) => b.body.id,
        Entity.Tnt(p) => p.body.id,
        Entity.Knot(p) => p.body.id,
        Entity.Fangs(p) => p.body.id,
    }
}

// Where the entity is.
// A body moved up as `pushEntitiesUp` moves it to stand at `top`: a move down of 1 from a block
// above, `Shapes.collide`, which stops at `top`, `teleportRelative` by 1 and that, its place where
// it was last tick too, `snapTo`.
// How far `body` fell onto farmland in the move it just made, where it did, given up, as
// `FarmlandBlock.fallOn` draws for it then (D695).
fn landed_on_farmland(body: mut Body) -> f64? {
    let landed = body.farmland_fall.take() else return none
    let (fell, _, _, _) = landed
    return some(fell)
}

fn lift_body(body: mut Body, top: f64) {
    var offset = top - (body.y + 1.0)
    if offset < -1.0 {
        offset = -1.0
    }
    body.y = body.y + (1.0 + offset)
    body.xo = body.x
    body.yo = body.y
    body.zo = body.z
}

fn place_of(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Item(i) => (i.body.x, i.body.y, i.body.z),
        Entity.Orb(o) => (o.body.x, o.body.y, o.body.z),
        Entity.Stand(a) => (a.living.body.x, a.living.body.y, a.living.body.z),
        Entity.Mob(m) => (m.living.body.x, m.living.body.y, m.living.body.z),
        Entity.Arrow(a) => (a.body.x, a.body.y, a.body.z),
        Entity.Thrown(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Cloud(c) => (c.body.x, c.body.y, c.body.z),
        Entity.Crystal(c) => (c.body.x, c.body.y, c.body.z),
        Entity.Eye(eye) => (eye.body.x, eye.body.y, eye.body.z),
        Entity.Fireball(b) => (b.body.x, b.body.y, b.body.z),
        Entity.Tnt(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Knot(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Fangs(p) => (p.body.x, p.body.y, p.body.z),
    }
}

// The nearest player to the mob `a` that isn't a spectator, by the square of how far, as
// `checkDespawn` looks, `getNearestPlayer(this, -1.0)`.
fn nearest_to(a: Mob, players: List<Follower>) -> f64? {
    var nearest: f64? = none
    for p in players {
        if p.spectator {
            continue
        }
        let dx = p.x - a.living.body.x
        let dy = p.y - a.living.body.y
        let dz = p.z - a.living.body.z
        let d = dx * dx + dy * dy + dz * dz
        match nearest {
            some(b) => {
                if d < b {
                    nearest = some(d)
                }
            },
            none => nearest = some(d),
        }
    }
    return nearest
}

// The entity's body, a copy (D708).
fn body_of(e: Entity) -> Body {
    return match e {
        Entity.Item(i) => i.body.copy(),
        Entity.Orb(o) => o.body.copy(),
        Entity.Stand(a) => a.living.body.copy(),
        Entity.Mob(m) => m.living.body.copy(),
        Entity.Arrow(a) => a.body.copy(),
        Entity.Thrown(p) => p.body.copy(),
        Entity.Cloud(c) => c.body.copy(),
        Entity.Crystal(c) => c.body.copy(),
        Entity.Eye(eye) => eye.body.copy(),
        Entity.Fireball(b) => b.body.copy(),
        Entity.Tnt(p) => p.body.copy(),
        Entity.Knot(p) => p.body.copy(),
        Entity.Fangs(p) => p.body.copy(),
    }
}

// The entity with its body `b` (D708).
fn with_body(e: own Entity, b: own Body) -> Entity {
    return match e {
        Entity.Item(i) => {
            var t = i
            t.body = b
            Entity.Item(t)
        },
        Entity.Orb(o) => {
            var t = o
            t.body = b
            Entity.Orb(t)
        },
        Entity.Stand(a) => {
            var t = a
            t.living.body = b
            Entity.Stand(t)
        },
        Entity.Mob(m) => {
            var t = m
            t.living.body = b
            Entity.Mob(t)
        },
        Entity.Arrow(a) => {
            var t = a
            t.body = b
            Entity.Arrow(t)
        },
        Entity.Thrown(p) => {
            var t = p
            t.body = b
            Entity.Thrown(t)
        },
        Entity.Cloud(c) => {
            var t = c
            t.body = b
            Entity.Cloud(t)
        },
        Entity.Crystal(c) => {
            var t = c
            t.body = b
            Entity.Crystal(t)
        },
        Entity.Eye(eye) => {
            var t = eye
            t.body = b
            Entity.Eye(t)
        },
        Entity.Fireball(f) => {
            var t = f
            t.body = b
            Entity.Fireball(t)
        },
        Entity.Tnt(p) => {
            var t = p
            t.body = b
            Entity.Tnt(t)
        },
        Entity.Knot(p) => {
            var t = p
            t.body = b
            Entity.Knot(t)
        },
        Entity.Fangs(p) => {
            var t = p
            t.body = b
            Entity.Fangs(t)
        },
    }
}

// The entity's ID, what it rides, and whether anything rides it, without copying its body (D708).
fn riding_of(e: Entity) -> (i32, i32?, bool) {
    return match e {
        Entity.Item(i) => (i.body.id, i.body.vehicle, not i.body.passengers.is_empty()),
        Entity.Orb(o) => (o.body.id, o.body.vehicle, not o.body.passengers.is_empty()),
        Entity.Stand(a) => (a.living.body.id, a.living.body.vehicle, not a.living.body.passengers.is_empty()),
        Entity.Mob(m) => (m.living.body.id, m.living.body.vehicle, not m.living.body.passengers.is_empty()),
        Entity.Arrow(a) => (a.body.id, a.body.vehicle, not a.body.passengers.is_empty()),
        Entity.Thrown(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Cloud(c) => (c.body.id, c.body.vehicle, not c.body.passengers.is_empty()),
        Entity.Crystal(c) => (c.body.id, c.body.vehicle, not c.body.passengers.is_empty()),
        Entity.Eye(eye) => (eye.body.id, eye.body.vehicle, not eye.body.passengers.is_empty()),
        Entity.Fireball(b) => (b.body.id, b.body.vehicle, not b.body.passengers.is_empty()),
        Entity.Tnt(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Knot(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
        Entity.Fangs(p) => (p.body.id, p.body.vehicle, not p.body.passengers.is_empty()),
    }
}

// Whether the entity's alive, `LivingEntity`: an armor stand or a mob.
fn alive_kind(e: Entity) -> bool {
    return match e {
        Entity.Stand(_) => true,
        Entity.Mob(_) => true,
        _ => false,
    }
}

// The entity, still, `setDeltaMovement(Vec3.ZERO)`, as its ride's tick begins (D708).
fn stilled(e: own Entity) -> Entity {
    var b = body_of(e)
    b.vx = 0.0
    b.vy = 0.0
    b.vz = 0.0
    return with_body(e, b)
}

// `Vec3.yRot(-y_rot * (float) (Math.PI / 180.0))`, as `EntityAttachments.transformPoint` turns a
// point by its entity's yaw, by the table's sine and cosine (D708).
fn turned(p: (f64, f64, f64), y_rot: f32) -> (f64, f64, f64) {
    let (x, y, z) = p
    let radians = -y_rot * 0.017453292f32
    let cos = f64(table_cos(f64(radians)))
    let sin = f64(table_sin(f64(radians)))
    return (x * cos + z * sin, y, z * cos - x * sin)
}

// Where what rides the entity `e` sits on it before its turn, `getPassengerAttachmentPoint`
// (D708): a mob's its kind's, anything else's its height, `AT_HEIGHT`.
fn seat_of(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Mob(m) => passenger_point(m.species, m.baby(), m.living.body.height, m.ride_size()),
        other => (0.0, f64(body_of(other).height), 0.0),
    }
}

// Where the entity `e` is held by what it rides before its turn, `getVehicleAttachmentPoint`
// (D708): a mob's its kind's, anything else's its feet.
fn held_at(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Mob(m) => vehicle_point(m.species, m.baby(), m.ride_size()),
        _ => (0.0, 0.0, 0.0),
    }
}

// The line `--entity-trace` writes for the entity, a mob's or an armor stand's, at the game time
// `time` (CAL-159); with `controls`, it goes on with a mob's, `controls_traced` (CAL-180).
fn traced(time: i64, e: Entity, controls: bool) -> String {
    return match e {
        Entity.Stand(a) => "{time} {a.living.body.id} {a.living.body.x} {a.living.body.y} {a.living.body.z} {a.living.body.vx} {a.living.body.vy} {a.living.body.vz} {a.living.body.y_rot} {a.living.body.x_rot} {a.living.y_head_rot} {a.living.y_body_rot} {a.living.zza} {a.living.xxa} {a.living.speed} {a.living.body.on_ground}{if controls { NO_CONTROLS } else { "" }}\n",
        Entity.Mob(a) => "{time} {a.living.body.id} {a.living.body.x} {a.living.body.y} {a.living.body.z} {a.living.body.vx} {a.living.body.vy} {a.living.body.vz} {a.living.body.y_rot} {a.living.body.x_rot} {a.living.y_head_rot} {a.living.y_body_rot} {a.living.zza} {a.living.xxa} {a.living.speed} {a.living.body.on_ground}{if controls { controls_traced(a) } else { String() }}\n",
        _ => String(),
    }
}

/// What a trace line of a living entity that isn't a mob, or of a player, goes on with where it
/// has a mob's controls, 0 and false for each (CAL-180).
pub const NO_CONTROLS: str = " 0.0 0.0 0.0 0.0 false 0.0 0.0 0.0 false"

// A mob's controls as its trace line goes on with them, as the rig agent's `controls` writes
// vanilla's (CAL-180): its move control's wanted place and speed and whether it has one,
// `hasWanted`, then its look control's wanted place and whether it's looking there,
// `isLookingAtTarget`.
fn controls_traced(a: Mob) -> String {
    let m = a.moves
    let (lx, ly, lz) = a.look.wanted()
    return " {m.wanted_x} {m.wanted_y} {m.wanted_z} {m.speed_modifier} {m.has_wanted()} {lx} {ly} {lz} {a.look.looking()}"
}

// The entity's box.
// The item `e`, of the ID `id`, as a brain sees it (CAL-160).
fn item_near(id: i32, e: ItemEntity) -> Near {
    return Near { id: id, uuid: e.body.uuid, species: ITEM, x: e.body.x, y: e.body.y, z: e.body.z, eyes: e.body.eyes, bounds: e.body.bounding_box() }
}

fn box_of(e: Entity) -> Aabb {
    return match e {
        Entity.Item(i) => i.body.bounding_box(),
        Entity.Orb(o) => o.body.bounding_box(),
        Entity.Stand(a) => a.living.body.bounding_box(),
        Entity.Mob(m) => m.living.body.bounding_box(),
        Entity.Arrow(a) => a.body.bounding_box(),
        Entity.Thrown(p) => p.body.bounding_box(),
        Entity.Cloud(c) => c.body.bounding_box(),
        Entity.Crystal(c) => c.body.bounding_box(),
        Entity.Eye(eye) => eye.body.bounding_box(),
        Entity.Fireball(b) => b.body.bounding_box(),
        Entity.Tnt(p) => p.body.bounding_box(),
        Entity.Knot(p) => p.body.bounding_box(),
        Entity.Fangs(p) => p.body.bounding_box(),
    }
}

// The body's nether portal, where it's in it and may go through it, `allowed`, put in `out`
// (D578).
fn due_of(out: mut List<PortalDue>, b: Body, allowed: bool) {
    if not allowed {
        return
    }
    let p = b.portal_process else return
    if p.inside {
        out.push(PortalDue { id: b.id, x: b.x, y: b.y, z: b.z, width: b.width, height: b.height, fall: b.fall, portal: p })
    }
}

// The entity told whether its level's nether portals may take it, `open` (D578), and its end
// portals, `end` (D587).
fn opened(e: own Entity, open: bool, end: bool) -> Entity {
    return match e {
        Entity.Item(i) => {
            var it = i
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Item(it)
        },
        Entity.Orb(o) => {
            var it = o
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Orb(it)
        },
        Entity.Stand(a) => {
            var it = a
            it.living.body.portal_open = open
            it.living.body.end_open = end
            Entity.Stand(it)
        },
        Entity.Mob(m) => {
            var it = m
            it.living.body.portal_open = open
            it.living.body.end_open = end
            Entity.Mob(it)
        },
        Entity.Arrow(a) => {
            var it = a
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Arrow(it)
        },
        Entity.Thrown(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Thrown(it)
        },
        Entity.Cloud(c) => Entity.Cloud(c),
        Entity.Crystal(c) => {
            var it = c
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Crystal(it)
        },
        // Never inside what it's in, so through no portal (D598).
        Entity.Eye(eye) => Entity.Eye(eye),
        Entity.Fireball(b) => {
            var it = b
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Fireball(it)
        },
        Entity.Tnt(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Tnt(it)
        },
        Entity.Knot(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Knot(it)
        },
        Entity.Fangs(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Fangs(it)
        },
    }
}

// What an explosion asks of the entity of `body`, of the kind `kind` (CAL-182).
fn reached_body(body: Body, kind: i32, invisible: bool, resistance: f64) -> Reached {
    return Reached { id: body.id, bounds: body.bounding_box(), x: body.x, y: body.y, z: body.z, eyes: f64(body.eyes), mover: body.mover(), kind: kind, invisible: invisible, resistance: resistance }
}

// The same of what an explosion pushes from where it stands, as primed TNT (CAL-182).
fn reached_feet(body: Body, kind: i32) -> Reached {
    return Reached { id: body.id, bounds: body.bounding_box(), x: body.x, y: body.y, z: body.z, eyes: 0.0, mover: body.mover(), kind: kind, invisible: false, resistance: 0.0 }
}

// The entity pushed by x, y, z, `Entity.push` (CAL-182), but an arrow in the ground,
// `AbstractArrow.push`, as one lodged in the TNT it lit is.
fn pushed_by(e: own Entity, x: f64, y: f64, z: f64) -> Entity {
    return match e {
        Entity.Item(i) => {
            var it = i
            it.body.push(x, y, z)
            Entity.Item(it)
        },
        Entity.Orb(o) => {
            var it = o
            it.body.push(x, y, z)
            Entity.Orb(it)
        },
        Entity.Stand(a) => {
            var it = a
            it.living.body.push(x, y, z)
            Entity.Stand(it)
        },
        Entity.Mob(m) => {
            var it = m
            it.living.body.push(x, y, z)
            Entity.Mob(it)
        },
        Entity.Arrow(a) => {
            var it = a
            if not it.in_ground() {
                it.body.push(x, y, z)
            }
            Entity.Arrow(it)
        },
        Entity.Thrown(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Thrown(it)
        },
        Entity.Cloud(c) => {
            var it = c
            it.body.push(x, y, z)
            Entity.Cloud(it)
        },
        Entity.Crystal(c) => {
            var it = c
            it.body.push(x, y, z)
            Entity.Crystal(it)
        },
        Entity.Eye(eye) => {
            var it = eye
            it.body.push(x, y, z)
            Entity.Eye(it)
        },
        Entity.Fireball(b) => {
            var it = b
            it.body.push(x, y, z)
            Entity.Fireball(it)
        },
        Entity.Tnt(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Tnt(it)
        },
        Entity.Knot(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Knot(it)
        },
        Entity.Fangs(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Fangs(it)
        },
    }
}

// When the entity came into its level.
fn entered_of(e: Entity) -> u64 {
    return match e {
        Entity.Item(i) => i.body.entered,
        Entity.Orb(o) => o.body.entered,
        Entity.Stand(a) => a.living.body.entered,
        Entity.Mob(m) => m.living.body.entered,
        Entity.Arrow(a) => a.body.entered,
        Entity.Thrown(p) => p.body.entered,
        Entity.Cloud(c) => c.body.entered,
        Entity.Crystal(c) => c.body.entered,
        Entity.Eye(eye) => eye.body.entered,
        Entity.Fireball(b) => b.body.entered,
        Entity.Tnt(p) => p.body.entered,
        Entity.Knot(p) => p.body.entered,
        Entity.Fangs(p) => p.body.entered,
    }
}

// `e` with `entered` as when it came into its level, as it's put at the tick list's end again.
fn with_entered(e: own Entity, entered: u64) -> Entity {
    match e {
        Entity.Item(i) => {
            var x = i
            x.body.entered = entered
            return Entity.Item(x)
        },
        Entity.Orb(o) => {
            var x = o
            x.body.entered = entered
            return Entity.Orb(x)
        },
        Entity.Stand(a) => {
            var x = a
            x.living.body.entered = entered
            return Entity.Stand(x)
        },
        Entity.Mob(m) => {
            var x = m
            x.living.body.entered = entered
            return Entity.Mob(x)
        },
        Entity.Arrow(a) => {
            var x = a
            x.body.entered = entered
            return Entity.Arrow(x)
        },
        Entity.Thrown(p) => {
            var x = p
            x.body.entered = entered
            return Entity.Thrown(x)
        },
        Entity.Cloud(c) => {
            var x = c
            x.body.entered = entered
            return Entity.Cloud(x)
        },
        Entity.Crystal(c) => {
            var x = c
            x.body.entered = entered
            return Entity.Crystal(x)
        },
        Entity.Eye(eye) => {
            var x = eye
            x.body.entered = entered
            return Entity.Eye(x)
        },
        Entity.Fireball(b) => {
            var x = b
            x.body.entered = entered
            return Entity.Fireball(x)
        },
        Entity.Tnt(p) => {
            var x = p
            x.body.entered = entered
            return Entity.Tnt(x)
        },
        Entity.Knot(p) => {
            var x = p
            x.body.entered = entered
            return Entity.Knot(x)
        },
        Entity.Fangs(p) => {
            var x = p
            x.body.entered = entered
            return Entity.Fangs(x)
        },
    }
}

// `stack` with `n` of it, 0 or less leaving a stack that's nothing, as `setCount` does.
fn counted(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

// `absSnapTo` of `l` to x, y, z turned `y_rot` and `x_rot`, there last tick too, what rides it
// left where it is (CAL-179).
fn snap_body(l: mut Living, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32) {
    let cx = if x < -3.0e7 { -3.0e7 } else if x > 3.0e7 { 3.0e7 } else { x }
    let cz = if z < -3.0e7 { -3.0e7 } else if z > 3.0e7 { 3.0e7 } else { z }
    l.body.x = cx
    l.body.y = y
    l.body.z = cz
    l.body.xo = cx
    l.body.yo = y
    l.body.zo = cz
    l.body.y_rot = y_rot
    l.body.x_rot = x_rot
    l.y_rot_o = y_rot
    l.x_rot_o = x_rot
}

// `isEntityCollidingWithAnythingNew` for the body `b` its client moved toward x, y, z (CAL-179),
// as `network`'s for a player: whether a block's shape that its box there, a hair smaller,
// meets, as its collisions saw them from `old`'s foot, `getPreMoveCollisions`, doesn't meet
// `old`, a hair smaller too.
fn meets_new<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, b: Body, old: Aabb, x: f64, y: f64, z: f64) -> bool {
    let now = b.bounding_box()
    let (ax, ay, az) = (x - b.x, y - b.y, z - b.z)
    let there = Aabb { min_x: now.min_x + ax, min_y: now.min_y + ay, min_z: now.min_z + az, max_x: now.max_x + ax, max_y: now.max_y + ay, max_z: now.max_z + az }
    let was = old.deflate(f64(1.0e-5f32))
    var mover = b.mover()
    mover.y = old.min_y
    mover.placement = true
    let c = m.colliders(f, blocks, there.deflate(f64(1.0e-5f32)), mover)
    var start = 0usize
    for end in c.ends {
        var met = false
        for k in start..end {
            if meets(c.boxes[k], was) {
                met = true
            }
        }
        if not met {
            return true
        }
        start = end
    }
    return false
}

// `noBlocksAround` (CAL-179): nothing but air in the blocks its box `b` meets, grown a sixteenth
// each way and 0.55 down.
fn no_blocks_around<B: CollisionBlocks>(f: Facts, blocks: B, b: Aabb) -> bool {
    let g = b.inflate(0.0625, 0.0625, 0.0625)
    let (x0, y0, z0) = (i32.saturate(g.min_x.floor()), i32.saturate((g.min_y - 0.55).floor()), i32.saturate(g.min_z.floor()))
    let (x1, y1, z1) = (i32.saturate(g.max_x.floor()), i32.saturate(g.max_y.floor()), i32.saturate(g.max_z.floor()))
    for by in y0..=y1 {
        for bz in z0..=z1 {
            for bx in x0..=x1 {
                if not f.is_air(blocks.collision_state(bx, by, bz) ?? 0) {
                    return false
                }
            }
        }
    }
    return true
}

// `Mth.clamp` of a float.
fn clamp_f32(v: f32, lo: f32, hi: f32) -> f32 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}

// `SectionPos.posToSectionCoord`.
fn section(v: f64) -> i32 {
    return i32.saturate(v.floor()) >> 4
}

/// The kind `Entities.found` gives the players by, in their places among the rest (CAL-190).
pub const PLAYERS: i32 = 4096

// The section of the block at x, y, z, `SectionPos.asLong`.
fn section_key(x: f64, y: f64, z: f64) -> i64 {
    return pack(section(x), section(y), section(z))
}

// The chunk of the section `SectionPos.asLong` packed in `key`.
fn section_chunk(key: i64) -> ChunkPos {
    return ChunkPos { x: i32.wrap(key >> 42), z: i32.wrap((key << 22) >> 42) }
}

/// `SectionPos.asLong`.
pub fn pack(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 4194303) << 42) | (i64(y) & 1048575) | ((i64(z) & 4194303) << 20)
}

// The square of the distance from `a` to `b`, `distanceToSqr`.
fn distance_sqr(a: (f64, f64, f64), b: (f64, f64, f64)) -> f64 {
    let (ax, ay, az) = a
    let (bx, by, bz) = b
    let (dx, dy, dz) = (bx - ax, by - ay, bz - az)
    return dx * dx + dy * dy + dz * dz
}

// `AABB.expandTowards`: the box `b` stretched toward the side each of `xa`, `ya` and `za` goes.
fn expand_towards(b: Aabb, xa: f64, ya: f64, za: f64) -> Aabb {
    var out = b
    if xa < 0.0 {
        out.min_x += xa
    } else if xa > 0.0 {
        out.max_x += xa
    }
    if ya < 0.0 {
        out.min_y += ya
    } else if ya > 0.0 {
        out.max_y += ya
    }
    if za < 0.0 {
        out.min_z += za
    } else if za > 0.0 {
        out.max_z += za
    }
    return out
}

// Whether `getManyEntityHitResult`, taking in the box the way starts in, has the way from `from`
// to `to` meet the box `b` within `margin` (CAL-159): `from` within it, the way through it, or,
// with a margin, through it that much larger, and from there toward its middle, `getCenter`, up
// to the first block `mover` collides with or the world border `border`, through it.
fn meets_way<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, mover: Mover, border: (f64, f64, f64, f64), b: Aabb, from: (f64, f64, f64), to: (f64, f64, f64), margin: f64) -> bool {
    let (fx, fy, fz) = from
    if fx >= b.min_x and fx < b.max_x and fy >= b.min_y and fy < b.max_y and fz >= b.min_z and fz < b.max_z {
        return true
    }
    if box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, from, to) != none {
        return true
    }
    if margin <= 0.0 {
        return false
    }
    let outside = box_clip(b.min_x - margin, b.min_y - margin, b.min_z - margin, b.max_x + margin, b.max_y + margin, b.max_z + margin, from, to) else return false
    var towards = (b.min_x + 0.5 * (b.max_x - b.min_x), b.min_y + 0.5 * (b.max_y - b.min_y), b.min_z + 0.5 * (b.max_z - b.min_z))
    let way = clip_including_border(f, m, blocks, mover, outside, towards, border)
    if not way.missed {
        towards = (way.x, way.y, way.z)
    }
    return box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, outside, towards) != none
}

// The player `p` holding a leash as `h` (CAL-179): where they are, their box, size and facing,
// and what their client last said they moved, `getKnownMovement`.
fn player_holding(h: Held, p: Follower) -> Holding {
    let half = f64(p.width / 2.0f32)
    let b = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
    return Holding { held: h, interacts: not p.dead and not p.spectator, x: p.x, y: p.y, z: p.z, bounds: b, width: p.width, height: p.height, y_rot: p.yaw, moving: (p.known_dx, p.known_dy, p.known_dz) }
}

// The mob `o` holding a leash as `h` (CAL-179): as `player_holding`, alive and not removed, its
// motion its known movement, nothing without AI, `getHolderMovement`.
fn mob_holding(h: Held, o: Mob) -> Holding {
    let moving = if o.no_ai() { (0.0, 0.0, 0.0) } else { (o.living.body.vx, o.living.body.vy, o.living.body.vz) }
    let interacts = o.living.alive() and not o.living.body.removed
    return Holding { held: h, interacts: interacts, x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, bounds: o.living.body.bounding_box(), width: o.living.body.width, height: o.living.body.height, y_rot: o.living.body.y_rot, moving: moving }
}

// The knot `k` holding a leash as `h` (CAL-179): where it is, its box and size, facing nowhere and
// never moving, there while it isn't gone.
fn knot_holding(h: Held, k: LeashKnot) -> Holding {
    return Holding { held: h, interacts: not k.body.removed, x: k.body.x, y: k.body.y, z: k.body.z, bounds: k.body.bounding_box(), width: k.body.width, height: k.body.height, y_rot: 0.0f32 }
}
