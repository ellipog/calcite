    /// Whether the entity `id` is here and a leash knot (CAL-179).
    pub fn is_knot(self, id: i32) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        return match slot {
            Entity.Knot(_) => true,
            _ => false,
        }
    }

    /// Takes the leash knot `id` out to be worked on, as `lend` takes an item (CAL-179).
    pub fn lend_knot(mut self, id: i32) -> LeashKnot? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Knot(k) => return some(k),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts the leash knot `k` back where it was lent from (CAL-179).
    pub fn give_back_knot(mut self, k: own LeashKnot) {
        let id = k.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        self.all[i] = some(Entity.Knot(k))
    }

    /// The leash knot on the fence at `at` that's here and not gone, `LeashFenceKnotEntity.getKnot`,
    /// the first in the order they came (CAL-179).
    pub fn knot_at(self, at: (i32, i32, i32)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            if let Entity.Knot(k) = e {
                if k.at == at and not k.body.removed {
                    return some(k.body.id)
                }
            }
        }
        return none
    }

    /// The mob `mob` told the knot `knot` holds its leash, for its tick to tie it to (CAL-179), as
    /// `restoreLeashFromSave` ties it to the one it gets or makes.
    pub fn hold_knot(mut self, mob: i32, knot: i32) {
        if not self.at.contains(mob) {
            return
        }
        let h = self.knot_hold(knot) else return
        let i = self.at[mob]
        let taken = self.all[i].take() else return
        self.all[i] = some(match taken {
            Entity.Mob(m) => {
                var it = m
                it.holding = some(h)
                Entity.Mob(it)
            },
            other => other,
        })
    }

    // The knot `knot` as what holds a leash, where it's here (CAL-179).
    fn knot_hold(self, knot: i32) -> Holding? {
        if not self.at.contains(knot) {
            return none
        }
        let slot = self.all[self.at[knot]] else return none
        let Entity.Knot(k) = slot else return none
        return some(knot_holding(Held { id: k.body.id, uuid: k.body.uuid, knot: some(k.at) }, k))
    }

    /// The leash knot `id`'s box and its fence's place, where it's here (CAL-179).
    pub fn knot_place(self, id: i32) -> (Aabb, (i32, i32, i32))? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Knot(k) = slot else return none
        return some((k.body.bounding_box(), k.at))
    }
    fn put_new(mut self, id: i32, key: i64, e: own Entity) {
        self.at.insert(id, self.all.len())
        self.all.push(some(e))
        self.into_section(id, key)
        self.out_of_tick_list(id)
        self.tick_place.insert(id, self.tick_list.len())
        self.tick_list.push(some(id))
    }

    // Takes the entity `id` out of the tick list, if it's in it.
    fn out_of_tick_list(mut self, id: i32) {
        if let place = self.tick_place.remove(id) {
            self.tick_list[place] = none
            self.tick_empty += 1
        }
    }

    /// The entity `id` starts ticking again, as its chunk comes to tick its entities: it goes to
    /// the end of the tick list, `startTicking`, with `entered` as when it came, which places it
    /// after the players there are (CAL-184).
    pub fn tick_again(mut self, id: i32, entered: u64) {
        if not self.at.contains(id) {
            return
        }
        self.out_of_tick_list(id)
        self.tick_place.insert(id, self.tick_list.len())
        self.tick_list.push(some(id))
        let i = self.at[id]
        if let e = self.all[i].take() {
            self.all[i] = some(with_entered(e, entered))
        }
    }

    /// Takes the entity `id` away, `discard`, if it's here. Where it's a living entity the
    /// scoreboard has under its UUID, `scored`, it's kept in `unscored` with its ID, for the
    /// scoreboard to forget it, `entityRemoved` (CAL-164), but where a nether portal took it,
    /// `CHANGED_DIMENSION`, which doesn't destroy it, `shouldDestroy` (D578). It gets off what it
    /// rides, and what rides it off it, gone, as `setRemoved` has them (D708).
    pub fn remove(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        if let (_, rides, carries, _, _) = self.riding_at(i) {
            if rides != none {
                self.leave(id, false)
            }
            if carries {
                self.eject(id, true)
            }
        }
        if not self.scored.is_empty() {
            var uuid: (i64, i64)? = none
            match self.all[i] {
                some(Entity.Mob(m)) => {
                    if not m.living.body.moved_away {
                        uuid = some(m.living.body.uuid)
                    }
                },
                some(Entity.Stand(s)) => {
                    if not s.living.body.moved_away {
                        uuid = some(s.living.body.uuid)
                    }
                },
                _ => {},
            }
            if let u = uuid {
                if self.scored.contains(u) {
                    self.unscored.push((id, u))
                }
            }
        }
        self.all[i] = none
        _ = self.at.remove(id)
        self.empty += 1
        self.out_of_tick_list(id)
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
        self.gone.push(id)
        self.gone_after.push(self.heard)
    }

    /// Takes what the living entities showed since last asked, leaving who showed each and when
    /// for the caller to have read first.
    pub fn take_shown(mut self) -> List<Shown> {
        var out = List<Shown>()
        for e in self.shown {
            out.push(e.copy())
        }
        self.shown.clear()
        self.shown_by.clear()
        self.shown_after.clear()
        return out
    }

    /// Takes the IDs of those gone since last asked.
    pub fn take_gone(mut self) -> List<i32> {
        var out = List<i32>()
        for id in self.gone {
            out.push(id)
        }
        self.gone.clear()
        self.gone_after.clear()
        return out
    }

    /// Takes the item `id` out to be worked on, leaving its place, for `give_back` to put it back
    /// in; `none` if it isn't here, is out already, or isn't an item.
    pub fn lend(mut self, id: i32) -> ItemEntity? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return none
        match taken {
            Entity.Item(e) => return some(e),
            other => {
                self.all[i] = some(other)
                return none
            },
        }
    }

    /// Puts back an item `lend` took out, moving it to the section it's in now.
    pub fn give_back(mut self, e: own ItemEntity) {
        let id = e.body.id
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let removed = e.body.removed
        self.all[i] = some(Entity.Item(e))
        if not removed {
            self.move_section(id, key)
        }
    }

