    /// The chunks with entities or kept ones in them, `getAllChunksWithExistingSections`.
    pub fn chunks(self) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for (k, _) in self.chunk_sections {
            out.push(ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) })
        }
        return out
    }

    /// The entities in the chunk at `pos`, and the kept ones, in the order
    /// `getExistingSectionsInChunk` gives them: its sections by `SectionPos.asLong`, and in each
    /// in the order they came into it.
    pub fn in_chunk(self, pos: ChunkPos) -> List<i32> {
        let k = pos.pack()
        if not self.chunk_sections.contains(k) {
            return List<i32>()
        }
        var keys = self.chunk_sections[k].copy()
        keys.sort()
        var out = List<i32>()
        for key in keys {
            for id in self.sections[key] {
                out.push(id)
            }
        }
        return out
    }

    /// Gives the entity `id`, one Calcite keeps as it was read, below 0, a place last in the
    /// section of x, y, z, as `addEntity` does.
    pub fn place_kept(mut self, id: i32, x: f64, y: f64, z: f64) {
        self.into_section(id, section_key(x, y, z))
    }

    /// Takes the kept entity `id` out of its section, as it's let go of.
    pub fn remove_kept(mut self, id: i32) {
        if self.section_of.contains(id) {
            let key = self.section_of[id]
            self.out_of_section(id, key)
            _ = self.section_of.remove(id)
        }
    }

    /// The ID of the entity here of the UUID `uuid` that isn't gone, `getEntity(uuid)`, as an
    /// arrow finds its owner (CAL-159).
    pub fn id_with_uuid(self, uuid: (i64, i64)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            let (u, removed) = match e {
                Entity.Item(i) => (i.body.uuid, i.body.removed),
                Entity.Orb(o) => (o.body.uuid, o.body.removed),
                Entity.Stand(a) => (a.living.body.uuid, a.living.body.removed),
                Entity.Mob(m) => (m.living.body.uuid, m.living.body.removed),
                Entity.Arrow(a) => (a.body.uuid, a.body.removed),
                Entity.Thrown(p) => (p.body.uuid, p.body.removed),
                Entity.Cloud(c) => (c.body.uuid, c.body.removed),
                Entity.Crystal(c) => (c.body.uuid, c.body.removed),
                Entity.Eye(eye) => (eye.body.uuid, eye.body.removed),
                Entity.Fireball(b) => (b.body.uuid, b.body.removed),
                Entity.Tnt(p) => (p.body.uuid, p.body.removed),
            }
            if u == uuid and not removed {
                return some(id_of(e))
            }
        }
        return none
    }

    /// Where the entity `id` is, if it's here.
    pub fn place(self, id: i32) -> (f64, f64, f64)? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(place_of(e))
    }

    /// `Entity.teleport` of the entity `id`, not a player, to x, y, z by an ender pearl of its own
    /// that landed in its level, `teleportSameDimension` (D585), where it may go,
    /// `isAllowedToTeleportOwner`: a living entity alive and not asleep, anything else not gone.
    /// It's put there, `teleportSetPosition`, at its own yaw and pitch, nothing relative, a living
    /// entity's head turned to its yaw, `setYHeadRot`; where it was last known forgotten,
    /// `reapplyPosition`; there last tick too, `setOldPosAndRot`; still, `Vec3.ZERO`; what it
    /// moved this tick forgotten, `clearMovementThisTick`; then nothing fallen,
    /// `resetFallDistance`, and a living entity's impulse forgotten, `resetCurrentImpulseContext`;
    /// and in the section it's in now, `onMove`. None where it isn't here or may not go.
    pub fn pearl_take(mut self, id: i32, x: f64, y: f64, z: f64) -> PearlTaken? {
        if not self.at.contains(id) {
            return none
        }
        let i = self.at[id]
        let e = self.all[i].take() else return none
        var taken: PearlTaken? = none
        let back = match e {
            Entity.Item(it) => {
                var t = it
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Item(t)
            },
            Entity.Orb(o) => {
                var t = o
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Orb(t)
            },
            Entity.Stand(a) => {
                var t = a
                if t.living.alive() {
                    taken = some(pearl_set_living(mut t.living, x, y, z))
                }
                Entity.Stand(t)
            },
            Entity.Mob(m) => {
                var t = m
                if t.living.alive() and t.living.sleeping == none {
                    taken = some(pearl_set_living(mut t.living, x, y, z))
                }
                Entity.Mob(t)
            },
            Entity.Arrow(a) => {
                var t = a
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Arrow(t)
            },
            Entity.Thrown(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Thrown(t)
            },
            Entity.Cloud(c) => {
                var t = c
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Cloud(t)
            },
            Entity.Crystal(c) => {
                var t = c
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Crystal(t)
            },
            Entity.Eye(eye) => {
                var t = eye
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Eye(t)
            },
            Entity.Fireball(b) => {
                var t = b
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Fireball(t)
            },
            Entity.Tnt(p) => {
                var t = p
                if not t.body.removed {
                    taken = some(pearl_set(mut t.body, x, y, z, true))
                }
                Entity.Tnt(t)
            },
        }
        self.all[i] = some(back)
        if taken != none {
            self.move_section(id, section_key(x, y, z))
        }
        return taken
    }

    /// The items whose boxes meet `b`, but `except`, in the order `getEntitiesOfClass` finds them:
    /// the sections a little beyond it, by x, then by z and y as `SectionPos.asLong` orders them,
    /// and in each in the order they came into it.
    pub fn find(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 1)
    }

    /// The orbs whose boxes meet `b`, but `except`, as `find` finds items.
    pub fn find_orbs(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 2)
    }

    /// Every item, orb, mob and arrow whose box meets `b`, but `except`, as `getEntities` finds
    /// them, which a player touches; an armor stand does nothing touched, `playerTouch`, and of
    /// mobs only a slime does (CAL-159).
    pub fn find_any(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 27)
    }

    /// Every item, orb, armor stand, mob, arrow, thrown potion, cloud, end crystal, eye of ender,
    /// dragon fireball and primed TNT whose box meets `b`, but `except`, as `getEntities(except,
    /// box)` finds them, which keep an enderman from leaving its block there (CAL-159, D527, D529,
    /// D589, D598, D618, CAL-182).
    pub fn find_every(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 2047)
    }

    /// How many end crystals' boxes meet `b`, `getEntitiesOfClass(EndCrystal.class, box)`, those
    /// gone left out, as they're out of their sections, which a dragon fight counts (D626).
    pub fn crystals_in(self, b: Aabb) -> i32 {
        var n = 0
        for id in self.found(b, -1, 128) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Crystal(c) = slot else continue
            if not c.body.removed {
                n += 1
            }
        }
        return n
    }

    /// What an explosion asks of the entity `id`, `resistance` the attribute of a living one's
    /// explosion knockback resistance, none where it isn't here (CAL-182).
    pub fn reached(self, id: i32, resistance: u32) -> Reached? {
        if not self.at.contains(id) {
            return none
        }
        let e = self.all[self.at[id]] else return none
        return some(match e {
            Entity.Item(i) => reached_body(i.body, 1, false, 0.0),
            Entity.Orb(o) => reached_body(o.body, 2, false, 0.0),
            Entity.Stand(a) => reached_body(a.living.body, 4, a.invisible, a.living.attributes.value(resistance)),
            Entity.Mob(m) => reached_body(m.living.body, 8, false, m.living.attributes.value(resistance)),
            Entity.Arrow(a) => reached_body(a.body, 16, false, 0.0),
            Entity.Thrown(p) => reached_body(p.body, 32, false, 0.0),
            Entity.Cloud(c) => reached_body(c.body, 64, false, 0.0),
            Entity.Crystal(c) => reached_body(c.body, 128, false, 0.0),
            Entity.Eye(eye) => reached_body(eye.body, 256, false, 0.0),
            Entity.Fireball(b) => reached_body(b.body, 512, false, 0.0),
            // Pushed from its feet, not its eyes, `entityOrigin`.
            Entity.Tnt(p) => reached_feet(p.body, 1024),
        })
    }

    /// `pushFromExplosion` of the entity `id`, `Entity.push`: its motion more by x, y, z where
    /// each is finite, and its tracker to send it (CAL-182).
    pub fn push_entity(mut self, id: i32, x: f64, y: f64, z: f64) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(pushed_by(e, x, y, z))
    }

    /// `Projectile.hurtServer` of the entity `id`, where it's an arrow or a thrown item, as an
    /// explosion hurts it (CAL-182): its motion to be sent, `markHurt`, unless it's gone or
    /// invulnerable, as one in the ground, which isn't pushed, has it sent too.
    pub fn projectile_hurt(mut self, id: i32) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let e = self.all[i].take() else return
        self.all[i] = some(match e {
            Entity.Arrow(a) => {
                var it = a
                mark_hurt(mut it.body)
                Entity.Arrow(it)
            },
            Entity.Thrown(p) => {
                var it = p
                mark_hurt(mut it.body)
                Entity.Thrown(it)
            },
            other => other,
        })
    }

    /// Whether the box of a part of an ender dragon meets `b`, as `getEntities` finds them after
    /// the rest (CAL-182).
    pub fn dragon_parts_meeting(self, b: Aabb) -> bool {
        for (_, part) in self.dragon_parts {
            if part.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                return true
            }
        }
        return false
    }

    /// The armor stands and mobs whose boxes meet `b`, but `except`, as `getEntitiesOfClass` finds
    /// living entities but players, which a sweep hits (D417).
    pub fn find_living(self, b: Aabb, except: i32) -> List<i32> {
        return self.found(b, except, 12)
    }

    // Those of the kinds `kinds` whose boxes meet `b`, 1 items, 2 orbs, 4 armor stands, 8 mobs, 16
    // arrows, 32 thrown potions, 64 clouds, 128 end crystals, 256 eyes of ender and 512 dragon
    // fireballs.
    fn found(self, b: Aabb, except: i32, kinds: i32) -> List<i32> {
        var out = List<i32>()
        let x0 = section(b.min_x - 2.0)
        let y0 = section(b.min_y - 4.0)
        let z0 = section(b.min_z - 2.0)
        let x1 = section(b.max_x + 2.0)
        let y1 = section(b.max_y + 0.0)
        let z1 = section(b.max_z + 2.0)
        for sx in x0..=x1 {
            var keys = List<i64>()
            for sz in z0..=z1 {
                for sy in y0..=y1 {
                    let key = pack(sx, sy, sz)
                    if self.sections.contains(key) and not self.sections[key].is_empty() {
                        keys.push(key)
                    }
                }
            }
            keys.sort()
            for key in keys {
                for id in self.sections[key] {
                    if id == except or not self.at.contains(id) {
                        continue
                    }
                    let e = self.all[self.at[id]] else continue
                    let kind = match e {
                        Entity.Item(_) => 1,
                        Entity.Orb(_) => 2,
                        Entity.Stand(_) => 4,
                        Entity.Mob(_) => 8,
                        Entity.Arrow(_) => 16,
                        Entity.Thrown(_) => 32,
                        Entity.Cloud(_) => 64,
                        Entity.Crystal(_) => 128,
                        Entity.Eye(_) => 256,
                        Entity.Fireball(_) => 512,
                        Entity.Tnt(_) => 1024,
                    }
                    if kind & kinds == 0 {
                        continue
                    }
                    let other = box_of(e)
                    if other.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        out.push(id)
                    }
                }
            }
        }
        return out
    }

    /// `ExperienceOrb.tryMergeToExisting`: the first orb in the box a block across around x, y,
    /// z that `can_merge` with `pick`, the level random's `nextInt(40)`, and `value` counts one
    /// more and starts its age again; whether there was one.
    pub fn merge_award(mut self, x: f64, y: f64, z: f64, value: i32, pick: i32) -> bool {
        let b = Aabb { min_x: x - 0.5, min_y: y - 0.5, min_z: z - 0.5, max_x: x + 0.5, max_y: y + 0.5, max_z: z + 0.5 }
        for id in self.find_orbs(b, -1) {
            let o = self.orb_view(id) else continue
            if not can_merge(o, pick, value) {
                continue
            }
            var taken = self.lend_orb(id) else continue
            taken.count += 1
            taken.age = 0
            self.give_back_orb(taken)
            return true
        }
        return false
    }

    // The orb `id`, where it's here and an orb, to read.
    fn orb_view(self, id: i32) -> ExperienceOrb? {
        if not self.at.contains(id) {
            return none
        }
        let slot = self.all[self.at[id]] else return none
        let Entity.Orb(o) = slot else return none
        return some(o.copy())
    }

    /// A tick of every entity there is that ticks, as `ServerLevel.tick` runs its tick list, among
    /// `blocks`, in a level whose floor is `min_y`, where lava's fast if `fast_lava`, with no
    /// players for orbs to follow; the sounds they play go to `sounds`.
    pub fn tick<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.begin_tick()
        let nobody = List<Follower>()
        while self.tick_next(u64.MAX, f, m, t, lf, codecs, blocks, min_y, fast_lava, nobody, mut sounds) {}
        self.end_tick()
    }

    /// Starts a tick of the entities there are now.
    pub fn begin_tick(mut self) {
        self.cursor = 0
        self.end = self.all.len()
    }

    /// Ticks the tick's next entity if it came into the level before `before`, as `tick` does,
    /// orbs following `players`, the level's in its order, and says whether there was one; the
    /// sounds it plays go to `sounds`, which starts empty.
    pub fn tick_next<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, S: StackSizes + Wearing>(mut self, before: u64, f: Facts, m: MovementStates, t: BodyFacts, lf: LivingFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) -> bool {
        self.take_sent(lf, f, m, blocks, min_y)
        if let stopped = self.paused.take() {
            let (at, entered, bred) = stopped
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_rest(at, mob, entered, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                Entity.Item(e) => self.all[at] = some(Entity.Item(e)),
                Entity.Orb(o) => self.all[at] = some(Entity.Orb(o)),
                Entity.Stand(a) => self.all[at] = some(Entity.Stand(a)),
                Entity.Arrow(a) => self.all[at] = some(Entity.Arrow(a)),
                Entity.Thrown(p) => self.all[at] = some(Entity.Thrown(p)),
                Entity.Cloud(c) => self.all[at] = some(Entity.Cloud(c)),
                Entity.Crystal(c) => self.all[at] = some(Entity.Crystal(c)),
                Entity.Eye(e) => self.all[at] = some(Entity.Eye(e)),
                Entity.Fireball(b) => self.all[at] = some(Entity.Fireball(b)),
                Entity.Tnt(p) => self.all[at] = some(Entity.Tnt(p)),
            }
            return true
        }
        if let stopped_use = self.paused_use.take() {
            let (at, bred) = stopped_use
            self.heard = 0
            let held = self.all[at].take() else return true
            match held {
                Entity.Mob(mob) => self.tick_mob_on(at, mob, bred, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds),
                other => self.all[at] = some(other),
            }
            return true
        }
        if let stopped_at = self.paused_arrow.take() {
            self.heard = 0
            let held = self.all[stopped_at].take() else return true
            match held {
                Entity.Arrow(a) => self.arrow_on(stopped_at, a, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds),
                other => self.all[stopped_at] = some(other),
            }
            return true
        }
        while self.cursor < self.end {
            match self.all[self.cursor] {
                some(_) => break,
                none => self.cursor += 1,
            }
        }
        if self.cursor >= self.end {
            return false
        }
        let i = self.cursor
        let held = self.all[i].take() else return false
        let taken = opened(held, self.portal_open, self.end_portal_open)
        let (x, _, z) = place_of(taken)
        if entered_of(taken) >= before {
            self.all[i] = some(taken)
            return false
        }
        self.cursor += 1
        self.heard = 0
        // What's in the tick list looks at whether it goes, `checkDespawn`, and of that, what's in
        // range ticks, as `ServerLevel.tick` runs its tick list (D452).
        let (cx, cz) = (i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
        let listed = blocks.listed(cx, cz)
        let ticks = listed and blocks.ticks_entities(cx, cz)
        match taken {
            Entity.Item(e) => {
                if ticks {
                    self.tick_item(i, e, f, m, t, lf.damage, codecs, blocks, min_y, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Item(e))
                }
            },
            Entity.Orb(o) => {
                if ticks {
                    self.tick_orb(i, o, f, m, t, lf.damage, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Orb(o))
                }
            },
            Entity.Stand(a) => {
                if ticks {
                    self.tick_stand(i, a, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Stand(a))
                }
            },
            Entity.Mob(mob) => {
                if listed {
                    self.tick_mob(i, mob, ticks, lf, f, m, t, blocks, codecs, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Mob(mob))
                }
            },
            Entity.Arrow(a) => {
                if ticks {
                    self.tick_arrow(i, a, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Arrow(a))
                }
            },
            Entity.Thrown(p) => {
                if ticks {
                    self.tick_thrown(i, p, f, m, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Thrown(p))
                }
            },
            Entity.Cloud(c) => {
                if ticks {
                    self.tick_cloud(i, c, lf, f, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Cloud(c))
                }
            },
            Entity.Crystal(c) => {
                if ticks {
                    self.tick_crystal(i, c, lf, f, t, blocks, mut sounds)
                } else {
                    self.all[i] = some(Entity.Crystal(c))
                }
            },
            Entity.Eye(e) => {
                if ticks {
                    self.tick_eye(i, e, f, t, blocks, min_y, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Eye(e))
                }
            },
            Entity.Fireball(b) => {
                if ticks {
                    self.tick_fireball(i, b, f, m, t, blocks, min_y, fast_lava, players, mut sounds)
                } else {
                    self.all[i] = some(Entity.Fireball(b))
                }
            },
            Entity.Tnt(p) => {
                if ticks {
                    self.tick_tnt(i, p, f, m, t, blocks, fast_lava, mut sounds)
                } else {
                    self.all[i] = some(Entity.Tnt(p))
                }
            },
        }
        return true
    }

    // Primed TNT's tick, at `i` (CAL-182): `PrimedTnt.tick`, what blocks did to it kept as what a
    // living entity shows is, and the fall it took onto farmland drawn for, as it's never big
    // enough to trample it; then, where its fuse ran out, its explosion, `Shown.Blew`, for its
    // level to make before its removal's sent, after its tick's sounds.
    fn tick_tnt<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, tnt: own PrimedTnt, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        var p = tnt
        let out = p.tick(f, m, t, blocks, fast_lava, mut sounds)
        if let landed = p.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = p.body.id
        self.keep_acted(id, p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        if out {
            let (x, y, z) = p.blast_at()
            self.shown.push(Shown.Blew(Blast { at: (p.body.x, p.body.y, p.body.z), x: x, y: y, z: z, power: p.power, portal: p.used_portal, owner: p.owner, silent: p.silent() }))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(p.body.x, p.body.y, p.body.z)
        let removed = p.body.removed
        self.all[i] = some(Entity.Tnt(p))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // A dragon fireball's tick, at `i` (D618): to where it looks for what it may hit,
    // `tick_start`; the nearest of what it may hit, `fireball_targets`, its owner found among the
    // level's entities and `players`; its move there, `go`; the end of its tick, `tick_end`; then,
    // where it hit something, `fireball_hit`.
    fn tick_fireball<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, fireball: own DragonFireball, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var b = fireball
        let owner = self.owner_of(b.owner, players)
        let border = self.border ?? widest_border()
        b.tick_start(f, m, blocks, border)
        let targets = self.fireball_targets(b, owner, players)
        let hit = b.nearest(targets)
        b.go(f, blocks, hit, mut sounds)
        b.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
        self.fireball_hit(mut b, f, blocks, hit, owner, sounds.len())
        let id = b.body.id
        self.keep_acted(id, b.acted, b.acted_after)
        b.acted.clear()
        b.acted_after.clear()
        let key = section_key(b.body.x, b.body.y, b.body.z)
        let removed = b.body.removed
        self.all[i] = some(Entity.Fireball(b))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // What the dragon fireball `b` hit, `hit` the entity its way met and `owner` its owner as its
    // level found them, `heard` its tick's sounds, where it's still here, `isAlive` (D618): where a
    // block's hit that would do something of it, that said missing, `struck_missing`; then what
    // it struck, `Shown.Fireballed`, its level's to deal, `onHit`, and it's gone, `discard`.
    fn fireball_hit<B: CollisionBlocks>(mut self, b: mut DragonFireball, f: Facts, blocks: B, hit: ThrownHit?, owner: OwnerView?, heard: usize) {
        if b.body.removed {
            return
        }
        let state = blocks.collision_state(b.way.bx, b.way.by, b.way.bz) ?? 0
        let struck = b.hit(f, hit, state, owner) else return
        if hit == none and not b.way.border {
            if let missing = struck_missing(f, state, "a dragon fireball") {
                b.acted.push(Acted.Missing(missing))
                b.acted_after.push(heard)
            }
        }
        let id = b.body.id
        self.keep_acted(id, b.acted, b.acted_after)
        b.acted.clear()
        b.acted_after.clear()
        self.shown.push(Shown.Fireballed(struck))
        self.shown_by.push(id)
        self.shown_after.push(heard)
        b.body.removed = true
    }

    // What the dragon fireball `b` may hit along its way, `getEntityHitResult`'s candidates (D618):
    // what a thrown potion may, `projectile_targets`, then the parts of the ender dragons there
    // are whose boxes meet its reach, each its dragon's ID and 1 past its place among them, as
    // `Level.getEntities` finds them after the rest, each pickable and with physics.
    fn fireball_targets(self, b: DragonFireball, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        let reach = b.reach()
        var out = self.projectile_targets(reach, b.body.id, b.left_owner, owner, players)
        var last = -1
        var k = 0
        for (dragon, part) in self.dragon_parts {
            if dragon != last {
                last = dragon
                k = 0
            }
            k += 1
            if self.at.contains(dragon) and part.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) {
                let (cx, cz) = ((part.min_x + part.max_x) / 2.0, (part.min_z + part.max_z) / 2.0)
                out.push(Target { id: dragon + k, bounds: part, x: cx, y: part.min_y, z: cz, player: false })
            }
        }
        return out
    }

    // An eye of ender's tick, at `i` (D598): `EyeOfEnder.tick`; it's gone where its tick took it
    // away, its removal sent after its sounds, then, where its life ran out, its level event where
    // it is, `Shown.Level`, a sound after them, as vanilla sends the removal as it's discarded,
    // before the event; or, where it survives, its stack dropped where it is, `Shown.Survived`,
    // likewise (D599).
    fn tick_eye<B: CollisionBlocks>(mut self, i: usize, eye: own EyeOfEnder, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        var e = eye
        let ran_out = e.tick(f, t, blocks, min_y, fast_lava, mut sounds)
        let id = e.body.id
        let (bx, by, bz) = e.body.block()
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let removed = e.body.removed
        let shown = if e.survives { Shown.Survived(Spilled { x: e.body.x, y: e.body.y, z: e.body.z, stack: e.item.copy() }) } else { Shown.Level((EYE_GONE, bx, by, bz, 0)) }
        self.all[i] = some(Entity.Eye(e))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
        if ran_out {
            self.shown.push(shown)
            self.shown_by.push(id)
            self.shown_after.push(sounds.len() + 1)
        }
    }

    // An end crystal's tick, at `i` (D589): `EndCrystal.tick`, what blocks did to it kept as what a
    // living entity shows is, then, in a level with a dragon fight, the air of its block set alight
    // by its level, `Shown.Kindled`, after its tick's sounds; and it's gone where its tick took it
    // away, its removal sent after that.
    fn tick_crystal<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, crystal: own EndCrystal, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, sounds: mut List<EntitySound>) {
        var c = crystal
        let alight = c.tick(f, t, lf.damage, blocks, self.fight, mut sounds)
        let id = c.body.id
        self.keep_acted(id, c.acted, c.acted_after)
        c.acted.clear()
        c.acted_after.clear()
        if let at = alight {
            self.shown.push(Shown.Kindled(at))
            self.shown_by.push(id)
            self.shown_after.push(sounds.len())
        }
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        self.all[i] = some(Entity.Crystal(c))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // An area effect cloud's tick, at `i` (D529): up to its pass, `tick_start`; then, where it's
    // to look for any to dose, the living things in its box, `cloud_near`, its pass over them,
    // `dose`, and what it gives those it doses, `Shown.Dosed`, after its tick's sounds so far, for
    // its level to give; and it's gone where it went, `discard`, its removal sent after that.
    fn tick_cloud<B: CollisionBlocks>(mut self, i: usize, cloud: own EffectCloud, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var c = cloud
        if let radius = c.tick_start(f, t, blocks, min_y, fast_lava, mut sounds) {
            let effects = c.effects()
            let near = self.cloud_near(c, effects, lf, players)
            let targets = c.dose(radius, near)
            if not targets.is_empty() {
                self.shown.push(Shown.Dosed(Dose { by: c.doser(), targets: targets, effects: effects }))
                self.shown_by.push(c.body.id)
                self.shown_after.push(sounds.len())
            }
        }
        let id = c.body.id
        let key = section_key(c.body.x, c.body.y, c.body.z)
        let removed = c.body.removed
        self.all[i] = some(Entity.Cloud(c))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // The living things in the cloud `c`'s box, as `getEntitiesOfClass(LivingEntity)` finds them
    // for its pass (D529): the mobs whose boxes meet it, as `found` finds them, then the players of
    // `players` whose boxes do, but spectators, `NO_SPECTATORS`; each one the cloud may dose where
    // potions take it, not dying, `isAffectedByPotions`, and one of `effects` can affect it,
    // `canBeAffected`, as each can a player. Armor stands, which potions don't take, it never may.
    fn cloud_near(self, c: EffectCloud, effects: List<ActiveEffect>, lf: LivingFacts, players: List<Follower>) -> List<Breather> {
        let b = c.body.bounding_box()
        var out = List<Breather>()
        for id in self.found(b, c.body.id, 8) {
            let slot = self.all[self.at[id]] else continue
            if let Entity.Mob(m) = slot {
                var any = false
                for e in effects {
                    if m.living.can_be_affected(lf, e.id) {
                        any = true
                    }
                }
                out.push(Breather { id: id, x: m.living.body.x, z: m.living.body.z, player: false, takes: any and not m.living.dead_or_dying() })
            }
        }
        for pl in players {
            if pl.spectator {
                continue
            }
            let pb = pl.bounds else continue
            if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                out.push(Breather { id: pl.id, x: pl.x, z: pl.z, player: true, takes: not pl.dead })
            }
        }
        return out
    }

    // A thrown potion's tick, at `i` (D527): to where it looks for what it may hit, `tick_start`;
    // the nearest of what it may hit, `thrown_targets`, its owner found among the level's entities
    // and `players`; its move there, `go`; the end of its tick, `tick_end`; then, where it hit
    // something, `hit`, the block its way met as it is by then, what it hit, `Shown.Splashed`,
    // after its tick's sounds so far, for its level to splash, `onHit`, and it's gone, `discard`.
    // What the block does of it that Calcite doesn't do yet is said first, `struck_missing`.
    fn tick_thrown<B: CollisionBlocks + Rain + Gateways>(mut self, i: usize, thrown: own ThrownItem, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var p = thrown
        // `ThrownEnderpearl.tick`'s first (D579): the chunk it's in, and its owner, a player
        // wherever they are; one whose owner's dead goes where `ender_pearls_vanish_on_death`
        // has it, its tick passed over.
        let (cx, cz) = (i32.saturate(p.body.x.floor()) >> 4, i32.saturate(p.body.z.floor()) >> 4)
        var pearl_owner: PearlOwner? = none
        if p.pearl {
            pearl_owner = self.pearl_owner_of(p.owner)
            if let o = pearl_owner {
                if not o.alive and self.pearls_vanish {
                    p.body.removed = true
                }
            }
        }
        if not p.body.removed {
            let owner = self.owner_of(p.owner, players)
            let border = self.border ?? widest_border()
            p.tick_start(f, m, blocks, border, sounds.len())
            let targets = self.thrown_targets(p, owner, players)
            self.parts_met(p.reach(), p.body.id, sounds.len())
            let hit = p.nearest(targets)
            p.go(f, blocks, hit, mut sounds)
            p.tick_end(f, t, blocks, min_y, fast_lava, owner, mut sounds)
            self.thrown_hit(mut p, f, blocks, hit, sounds.len())
        }
        // Then, still here, its ticket put again about the chunk it's in, `ENDER_PEARL`, where its
        // owner's a player, once its timer's out or it's come into another chunk, `ticketTimer`
        // then its ticket's ticks less one (D579), and it's among their pearls,
        // `registerAndUpdateEnderPearlTicket` (D580).
        if p.pearl and not p.body.removed {
            p.ticket_timer -= 1
            let (nx, nz) = (i32.saturate(p.body.x.floor()) >> 4, i32.saturate(p.body.z.floor()) >> 4)
            if let o = pearl_owner {
                if p.ticket_timer <= 0 or nx != cx or nz != cz {
                    p.registered = o.serial
                    self.pearl_tickets.push((nx, nz))
                    p.ticket_timer = PEARL_TICKET_TICKS - 1
                }
            }
        }
        let id = p.body.id
        self.keep_acted(id, p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        let key = section_key(p.body.x, p.body.y, p.body.z)
        let removed = p.body.removed
        self.all[i] = some(Entity.Thrown(p))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // The player owning an ender pearl of the UUID `owner`, as `findOwnerIncludingDeadPlayer`
    // finds them among those wherever they are (D579); none for no owner, or one that isn't a
    // player.
    fn pearl_owner_of(self, owner: (i64, i64)?) -> PearlOwner? {
        let u = owner else return none
        for o in self.pearl_owners {
            if o.uuid == u {
                return some(o)
            }
        }
        return none
    }

    // What the thrown item `p` hit, `hit` the entity its way met, `heard` its tick's sounds, where
    // it's still here (D527): where a block's hit that would do something of it, that said
    // missing, `struck_missing`; then its hit, a potion's splash, `Shown.Splashed`, or an ender
    // pearl's, `Shown.Pearled` (D579), its level's to deal, and it's gone.
    fn thrown_hit<B: CollisionBlocks>(mut self, p: mut ThrownItem, f: Facts, blocks: B, hit: ThrownHit?, heard: usize) {
        if p.body.removed {
            return
        }
        let state = blocks.collision_state(p.way.bx, p.way.by, p.way.bz) ?? 0
        var shown: Shown? = none
        var block = false
        if p.pearl {
            if let landed = p.pearl_hit(f, hit, state) {
                block = landed.entity == none
                shown = some(Shown.Pearled(landed))
            }
        } else if let splash = p.hit(f, hit, state) {
            block = splash.block != none
            shown = some(Shown.Splashed(splash))
        }
        let what = shown else return
        if block and not p.way.border {
            if let missing = struck_missing(f, state, "a thrown potion") {
                p.acted.push(Acted.Missing(missing))
                p.acted_after.push(heard)
            }
        }
        let id = p.body.id
        self.keep_acted(id, p.acted, p.acted_after)
        p.acted.clear()
        p.acted_after.clear()
        self.shown.push(what)
        self.shown_by.push(id)
        self.shown_after.push(heard)
        p.body.removed = true
    }

    // What the thrown potion `p` may hit along its way, `getEntityHitResult`'s candidates (D527),
    // `projectile_targets`.
    fn thrown_targets(self, p: ThrownItem, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        return self.projectile_targets(p.reach(), p.body.id, p.left_owner, owner, players)
    }

    // What the projectile `id` may hit in its reach `reach`, `getEntityHitResult`'s candidates
    // (D527): the armor stands, mobs and end crystals (D591) whose boxes meet it, as `found` finds
    // them, then the players of `players` whose boxes do, each alive and pickable,
    // `canBeHitByProjectile`, that it may hit, not its owner `owner` where it's not left them,
    // `left_owner`, `isPassengerOfSameVehicle`.
    fn projectile_targets(self, reach: Aabb, id: i32, left_owner: bool, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        var out = List<Target>()
        var own_id = -1
        if let o = owner {
            if not left_owner {
                own_id = o.id
            }
        }
        for found in self.found(reach, id, 140) {
            if found == own_id {
                continue
            }
            let slot = self.all[self.at[found]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() {
                        out.push(Target { id: found, bounds: s.living.body.bounding_box(), x: s.living.body.x, y: s.living.body.y, z: s.living.body.z, player: false })
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() {
                        out.push(Target { id: found, bounds: o.living.body.bounding_box(), x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, player: false })
                    }
                },
                Entity.Crystal(c) => {
                    if not c.body.removed {
                        out.push(Target { id: found, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                _ => {},
            }
        }
        for pl in players {
            if pl.spectator or pl.dead or pl.id == own_id {
                continue
            }
            let b = pl.bounds else continue
            if b.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) {
                out.push(Target { id: pl.id, bounds: b, x: pl.x, y: pl.y, z: pl.z, player: true })
            }
        }
        return out
    }

    // An arrow's tick, at `i` (CAL-159): to its steps, `tick_start`, its owner found among the
    // level's entities and `players` where it's to fly, then its steps, `arrow_steps`.
    fn tick_arrow<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        var owner: OwnerView? = none
        if not a.in_ground() {
            owner = self.owner_of(a.owner, players)
        }
        let border = self.border ?? widest_border()
        if a.tick_start(f, m, t, blocks, min_y, fast_lava, owner, border, mut sounds) {
            self.arrow_steps(i, a, owner, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow at `i` after its level dealt the hits it stopped at (CAL-159): landed on the block
    // it struck, where that's what it stopped at, `hit_block`, its state kept as `codecs` save it;
    // its motion to be sent; on through more of its steps where it's still here and pierces, else
    // the end of its tick, `tick_end`, as `stepMoveAndHit`'s loop goes on.
    fn arrow_on<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        if let state = a.block_due.take() {
            if not a.body.removed {
                a.hit_block(state, codecs.state_saved(state), mut sounds)
            }
        }
        a.body.needs_sync = true
        if not a.body.removed and a.pierce() > 0i8 {
            let owner = self.owner_of(a.owner, players)
            self.arrow_steps(i, a, owner, f, m, t, codecs, blocks, min_y, fast_lava, players, mut sounds)
            return
        }
        a.tick_end(f, t, blocks, min_y, fast_lava, mut sounds)
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow's steps along its way, `stepMoveAndHit` (CAL-159): from where it is, the entities
    // it may hit up to the block its way meets, `Arrow.hits`; it goes to the nearest, or to the
    // block, and what blocks it went through act on it; with an entity to hit, it stops for its
    // level to deal the hits, `Shown.Shot` with them, after its tick's sounds so far, to go on in
    // the next `tick_next`, `arrow_on`; else, where its way met a block that's still there, it
    // lands, `hit_block`, its state kept as `codecs` save it, and what the block would do of it
    // said to be missing; then the end of its tick.
    fn arrow_steps<B: CollisionBlocks + Rain + Gateways, S: StackSizes>(mut self, i: usize, arrow: own Arrow, owner: OwnerView?, f: Facts, m: MovementStates, t: BodyFacts, codecs: S, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = arrow
        if not a.body.removed {
            let from = (a.body.x, a.body.y, a.body.z)
            let end = (a.way.x, a.way.y, a.way.z)
            let targets = self.targets_of(a, owner, players)
            self.parts_met(a.reach(), a.body.id, sounds.len())
            let hits = a.hits(f, m, blocks, targets, from, end, self.border ?? widest_border())
            if hits.is_empty() {
                a.body.x = a.way.x
                a.body.y = a.way.y
                a.body.z = a.way.z
            } else {
                a.body.x = hits[0].x
                a.body.y = hits[0].y
                a.body.z = hits[0].z
            }
            a.step_acts(f, blocks, from, mut sounds)
            a.step_portal(blocks, sounds.len())
            if hits.is_empty() {
                if not a.body.removed and not a.way.missed and a.way.border {
                    // `hitTargetOrDeflectSelf`: the world border, which it bounces off, not
                    // hitting it, `shouldBounceOnWorldBorder` (CAL-159).
                    a.turn_back()
                    a.body.needs_sync = true
                } else if not a.body.removed and not a.way.missed {
                    let state = blocks.collision_state(a.way.bx, a.way.by, a.way.bz) ?? 0
                    if not f.is_air(state) {
                        if a.struck_by_level(f, state) {
                            // What the block does of it, its level's to deal first,
                            // `Shown.Struck`, after its tick's sounds so far; it lands as it goes
                            // on, `arrow_on` (CAL-159).
                            let id = a.body.id
                            self.keep_acted(id, a.acted, a.acted_after)
                            a.acted.clear()
                            a.acted_after.clear()
                            a.block_due = some(state)
                            let struck = a.struck_block(state)
                            let key = section_key(a.body.x, a.body.y, a.body.z)
                            self.all[i] = some(Entity.Arrow(a))
                            self.move_section(id, key)
                            self.shown.push(Shown.Struck(struck))
                            self.shown_by.push(id)
                            self.shown_after.push(sounds.len())
                            self.heard = sounds.len()
                            self.paused_arrow = some(i)
                            return
                        }
                        a.hit_block(state, codecs.state_saved(state), mut sounds)
                    }
                    a.body.needs_sync = true
                }
            } else if not a.body.removed and not a.body.no_physics {
                let id = a.body.id
                self.keep_acted(id, a.acted, a.acted_after)
                a.acted.clear()
                a.acted_after.clear()
                let key = section_key(a.body.x, a.body.y, a.body.z)
                self.all[i] = some(Entity.Arrow(a))
                self.move_section(id, key)
                self.shown.push(Shown.Shot(hits))
                self.shown_by.push(id)
                self.shown_after.push(sounds.len())
                self.heard = sounds.len()
                self.paused_arrow = some(i)
                return
            }
        }
        a.tick_end(f, t, blocks, min_y, fast_lava, mut sounds)
        self.arrow_done(i, a, sounds.len())
    }

    // The arrow `a` back at `i` with its tick done, `heard` its sounds: what blocks did that its
    // level's to do kept with its ID, and it moved into its section, or gone (CAL-159).
    fn arrow_done(mut self, i: usize, arrow: own Arrow, heard: usize) {
        var a = arrow
        let id = a.body.id
        self.keep_acted(id, a.acted, a.acted_after)
        a.acted.clear()
        a.acted_after.clear()
        let key = section_key(a.body.x, a.body.y, a.body.z)
        let removed = a.body.removed
        self.all[i] = some(Entity.Arrow(a))
        self.heard = heard
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
        }
    }

    // The arrow's owner of the UUID `uuid`, `getOwner`, among `players` and the level's mobs and
    // armor stands (CAL-159): its ID, its box where it may be picked, `CAN_BE_PICKED`, and whether
    // it's a player; none where it isn't found.
    fn owner_of(self, uuid: (i64, i64)?, players: List<Follower>) -> OwnerView? {
        let u = uuid else return none
        for p in players {
            if p.uuid == some(u) {
                var bounds: Aabb? = none
                if not p.spectator {
                    bounds = p.bounds
                }
                return some(OwnerView { id: p.id, bounds: bounds, player: true, team: p.team.copy(), friendly_fire: p.friendly_fire })
            }
        }
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        // An ender dragon's own box can't be picked, `isPickable` (D618).
                        var bounds: Aabb? = none
                        if o.pickable() {
                            bounds = some(o.living.body.bounding_box())
                        }
                        return some(OwnerView { id: o.living.body.id, bounds: bounds, player: false })
                    }
                },
                Entity.Stand(o) => {
                    if o.living.body.uuid == u and not o.living.body.removed {
                        var bounds: Aabb? = none
                        if not o.marker() {
                            bounds = some(o.living.body.bounding_box())
                        }
                        return some(OwnerView { id: o.living.body.id, bounds: bounds, player: false })
                    }
                },
                _ => {},
            }
        }
        return none
    }

    // What the arrow `a` may hit along its way, `findHitEntities`' candidates (CAL-159): the
    // armor stands, mobs and end crystals (D591) whose boxes meet its reach, `Arrow.reach`, as
    // `found` finds them, then the players of `players` whose boxes do (CAL-190), each alive and
    // pickable, `canBeHitByProjectile`, that it may hit, `may_hit`: not a player in its owner's
    // team where that doesn't allow friendly fire, `canHarmPlayer` (CAL-164).
    fn targets_of(self, a: Arrow, owner: OwnerView?, players: List<Follower>) -> List<Target> {
        let reach = a.reach()
        var out = List<Target>()
        for id in self.found(reach, a.body.id, 140) {
            let slot = self.all[self.at[id]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: s.living.body.bounding_box(), x: s.living.body.x, y: s.living.body.y, z: s.living.body.z, player: false })
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: o.living.body.bounding_box(), x: o.living.body.x, y: o.living.body.y, z: o.living.body.z, player: false })
                    }
                },
                Entity.Crystal(c) => {
                    if not c.body.removed and a.may_hit(id, false, owner, self.pvp) {
                        out.push(Target { id: id, bounds: c.body.bounding_box(), x: c.body.x, y: c.body.y, z: c.body.z, player: false })
                    }
                },
                _ => {},
            }
        }
        for p in players {
            if p.spectator or p.dead {
                continue
            }
            let b = p.bounds else continue
            let spared = match owner {
                some(o) => o.player and o.team != none and o.team == p.team and not o.friendly_fire,
                none => false,
            }
            if b.intersects(reach.min_x, reach.min_y, reach.min_z, reach.max_x, reach.max_y, reach.max_z) and a.may_hit(p.id, true, owner, self.pvp and not spared) {
                out.push(Target { id: p.id, bounds: b, x: p.x, y: p.y, z: p.z, player: true })
            }
        }
        return out
    }

    // The blocks the level sent again since they were last read, as `sendBlockUpdated` takes each:
    // its path type forgotten, and where its shape changed, the paths of the mobs it's near enough
    // found again, `shouldRecomputePath`, in the order the mobs came, which vanilla's
    // `navigatingMobs` holds in no order of its own, finding the same paths in any.
    fn take_sent<B: CollisionBlocks + NavLevel>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, min_y: i32) {
        let total = blocks.sent_total()
        var i = blocks.sent_first()
        if self.sent_seen > i {
            i = self.sent_seen
        }
        self.sent_seen = total
        if i >= total {
            return
        }
        var going = List<i32>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Mob(mob) = e {
                    if mob.navigating() {
                        going.push(mob.living.body.id)
                    }
                }
            }
        }
        while i < total {
            let b = blocks.sent_at(i)
            i += 1
            self.path_types.invalidate(b.x, b.y, b.z)
            if going.is_empty() or m.same_shape(f, b.old, b.now, b.x, b.z) {
                continue
            }
            for id in going {
                var mob = self.lend_mob(id) else continue
                mob.block_changed(lf, f, m, blocks, mut self.path_types, min_y, b.x, b.y, b.z)
                self.give_back_mob(mob)
            }
        }
    }

    // A mob's tick, at `i`: its look at whether it goes, `checkDespawn`, from the nearest of
    // `players` that isn't a spectator, then where it stays and `ticks`, in range, its tick, as an
    // armor stand's (D452).
    fn tick_mob<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, ticks: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        var nearest: f64? = none
        for p in players {
            if p.spectator {
                continue
            }
            let dx = p.x - a.living.body.x
            let dy = p.y - a.living.body.y
            let dz = p.z - a.living.body.z
            let d = dx * dx + dy * dy + dz * dz
            match nearest {
                some(b) => {
                    if d < b {
                        nearest = some(d)
                    }
                },
                none => nearest = some(d),
            }
        }
        if a.check_despawn(self.peaceful, nearest) {
            a.living.body.removed = true
            self.all[i] = some(Entity.Mob(a))
            self.remove(id)
            return
        }
        if not ticks {
            self.all[i] = some(Entity.Mob(a))
            return
        }
        if a.wants_kin() {
            a.kin = self.kin_near(a.living.body.bounding_box(), id)
        }
        if a.brain != none {
            a.near = self.brain_near(a, lf, players)
            if a.wants_items() {
                a.near_items = self.items_for(a, lf, f, items)
            }
            a.villager_activity = self.villager_activity
            a.baby_activity = self.baby_activity
            a.day = self.day
            if a.dimension != self.dimension {
                a.dimension = self.dimension.copy()
            }
        }
        a.mob_drops = self.mob_drops
        a.mob_griefing = self.mob_griefing
        a.universal_anger = self.universal_anger
        a.border = self.border
        a.game_time = self.game_time
        a.hard = self.hard
        a.difficulty = self.difficulty
        if a.species == ENDER_DRAGON {
            self.fight_for(mut a)
        }
        a.tick_using(lf, f, m, t, blocks, items, players, min_y, fast_lava, mut sounds)
        if let due = a.stab_due.take() {
            let stabs = self.stabs_of(mut a, due, f, m, blocks, players)
            if not stabs.is_empty() {
                // Its spear's hits, which its level deals before its tick goes on, as vanilla's
                // `damageEntities` is dealt as its use ticks, before its AI: what it showed so far
                // kept, then the hits, and it stopped till the next `tick_next` (CAL-159).
                let bred = self.keep_shown(id, mut a)
                self.all[i] = some(Entity.Mob(a))
                self.shown.push(Shown.Stabbed(stabs))
                self.shown_by.push(id)
                self.shown_after.push(sounds.len())
                self.heard = sounds.len()
                self.paused_use = some((i, bred))
                return
            }
        }
        self.tick_mob_on(i, a, false, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
    }

    // The mob `mob` at `i` after its use's tick, `tick_using`, `bred_before` whether it bred
    // (CAL-159): the rest of its tick through its AI, `tick_thinking_on`, then, unless it attacked
    // a player, the rest of its tick.
    fn tick_mob_on<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        // A zombie's goals look for villages' points of interest, its level's lent it for them
        // (D605).
        let villages = a.goes_through_villages()
        if villages {
            a.pois = self.pois.take()
        }
        if a.species == ENDER_DRAGON {
            self.crystals_for(mut a)
        }
        let entered = a.tick_thinking_on(lf, f, m, blocks, items, mut self.path_types, players, min_y, mut sounds)
        if a.species == ENDER_DRAGON {
            // Its parts as its `aiStep` placed them, and what its wings and head reach (D611).
            self.keep_parts(a)
            self.dragon_strikes(mut a, players, sounds.len())
            // Its word to its fight, once its walls are broken, `updateDragon` (D626).
            var seen = false
            if let dr = a.dragon {
                seen = dr.seen_due
            }
            if seen {
                let progress = a.living.health() / a.living.max_health(lf)
                a.living.show(Shown.DragonSeen(progress), sounds.len())
            }
        }
        if villages {
            self.pois = a.pois.take()
        }
        // Its equipment, as its `aiStep` ticks it (D607).
        if entered {
            self.equipment_tick(mut a.living, sounds.len())
        }
        if not a.attacked() {
            self.tick_mob_rest(i, a, entered, bred_before, lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
            return
        }
        // Its attack on a player, which its level deals before its tick goes on, as vanilla's
        // `doHurtTarget` is dealt in `serverAiStep`, so its travel and its pushes come after the
        // hit, and don't push a player it killed: what it showed so far kept, and whom its hurt
        // alerts told, and it stopped till the next `tick_next` (CAL-159).
        let alert = a.alerted
        a.alerted = none
        let bred = self.keep_shown(id, mut a) or bred_before
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let within = a.living.attributes.value(lf.follow_range)
        let zombie = a.species == ZOMBIE
        self.all[i] = some(Entity.Mob(a))
        self.heard = sounds.len()
        if let target = alert {
            self.alert_others(id, zombie, ax, ay, az, within, target, players)
        }
        self.paused = some((i, entered, bred))
    }

    // The boxes of the ender dragon `a`'s parts kept, its own before put away, and those of
    // dragons gone with them (D610).
    fn keep_parts(mut self, a: Mob) {
        let dr = a.dragon else return
        let own_id = a.living.body.id
        var kept = List<(i32, Aabb)>()
        for (owner, b) in self.dragon_parts {
            if owner != own_id and self.at.contains(owner) {
                kept.push((owner, b))
            }
        }
        for k in 0..PARTS {
            let (x0, y0, z0, x1, y1, z1) = dr.part_box(k)
            kept.push((own_id, Aabb { min_x: x0, min_y: y0, min_z: z0, max_x: x1, max_y: y1, max_z: z1 }))
        }
        self.dragon_parts = kept
    }

    // What the ender dragon `a`'s wings' knockback and its head's and neck's hurt reach of its
    // level in its tick, `heard` its sounds so far (D611): the living entities in their boxes, and
    // the players not in creative or spectating, `NO_CREATIVE_OR_SPECTATOR`, its own parts not
    // living. Its strikes on the players, box by box, its wings' with the middle of its body
    // across, are its level's to deal, `Shown.Beaten` (D615), the players in a box in the level's
    // order, as `getEntities` has them; where a mob or an armor stand is in one, what it does to
    // them is said missing. Then the breaking of what it flew into, where it would break any,
    // `checkWalls`, which comes after them (D614).
    fn dragon_strikes(self, a: mut Mob, players: List<Follower>, heard: usize) {
        var strikes = List<Aabb>()
        var sitting = false
        var middle = (0.0, 0.0)
        var walls: List<Aabb>? = none
        if let dr = a.dragon {
            strikes = dr.strikes.copy()
            sitting = dr.sitting()
            let body = dr.boxed(BODY)
            middle = ((body.min_x + body.max_x) / 2.0, (body.min_z + body.max_z) / 2.0)
            if dr.walls_due {
                walls = some([dr.boxed(HEAD), dr.boxed(NECK), dr.boxed(BODY)])
            }
        }
        let own_id = a.living.body.id
        var met = false
        var beats = List<Beat>()
        for k in 0..strikes.len() {
            let b = strikes[k]
            if not self.find_living(b, own_id).is_empty() {
                met = true
            }
            for p in players {
                if p.spectator or p.creative {
                    continue
                }
                if let pb = p.bounds {
                    if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                        let from: (f64, f64)? = if k < 2 { some(middle) } else { none }
                        beats.push(Beat { player: p.id, from: from, sitting: sitting })
                    }
                }
            }
        }
        if met {
            a.living.show(Shown.Missing(String("An ender dragon's wings' knockback and its head's hurt on mobs and armor stands")), heard)
        }
        if not beats.is_empty() {
            a.living.show(Shown.Beaten(beats), heard)
        }
        if let boxes = walls {
            a.living.show(Shown.Walls(boxes), heard)
            var dr = a.dragon.take() else return
            dr.walls_due = false
            a.dragon = some(dr)
        }
    }

    // What a projectile of the ID `id` whose reach is `b` would hit of the ender dragons' parts
    // (D610): where `b` meets a part's box, as `getEntities` finds parts, the hit's said missing,
    // as Calcite's projectiles don't hit parts yet, `heard` the sounds of its tick so far.
    fn parts_met(mut self, b: Aabb, id: i32, heard: usize) {
        var met = false
        for (owner, part) in self.dragon_parts {
            if self.at.contains(owner) and part.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                met = true
            }
        }
        if met {
            self.shown.push(Shown.Missing(String("A projectile's hit on an ender dragon's part")))
            self.shown_by.push(id)
            self.shown_after.push(heard)
        }
    }

    // What the ender dragon `a` reads of its level's dragon fight as it ticks (D626), told before
    // its tick begins, as its death's tick, `tickDeath`, comes before its `aiStep`, which takes the
    // fight as its own where it's the fight's dragon: whether it is now, `dragonUUID`, the
    // crystals the fight counts alive and whether a dragon was killed in it before.
    fn fight_for(self, a: mut Mob) {
        var dr = a.dragon.take() else return
        dr.ours = self.fight and self.fight_dragon == some(a.living.body.uuid)
        dr.crystals = self.fight_crystals
        dr.killed_before = self.fight_killed_before
        a.dragon = some(dr)
    }

    // What an ender dragon's `checkCrystals` reads of its level, for the dragon `a` (D608): whether
    // the end crystal it had is gone, `isRemoved`, and the nearest end crystal whose box is within
    // 32 of its own, `getEntitiesOfClass`, by `distanceToSqr` from where it is, the first found of
    // any as near.
    fn crystals_for(self, a: mut Mob) {
        var dr = a.dragon.take() else return
        dr.crystal_gone = false
        if let had = dr.nearest_crystal {
            dr.crystal_gone = true
            if self.at.contains(had) {
                if let slot = self.all[self.at[had]] {
                    if let Entity.Crystal(c) = slot {
                        dr.crystal_gone = c.body.removed
                    }
                }
            }
        }
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let area = a.living.body.bounding_box().inflate(32.0, 32.0, 32.0)
        var best = f64.MAX
        var found: i32? = none
        for id in self.found(area, a.living.body.id, 128) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Crystal(c) = slot else continue
            let (dx, dy, dz) = (c.body.x - ax, c.body.y - ay, c.body.z - az)
            let d = dx * dx + dy * dy + dz * dz
            if d < best {
                best = d
                found = some(id)
            }
        }
        dr.found_crystal = found
        a.dragon = some(dr)
    }

    // What the mob `a`'s spear meets as its use ticks, `due` what that asks, among the level's mobs
    // and armor stands and `players`, `KineticWeapon.damageEntities` (CAL-159). Its way, along its
    // head's look from its eyes, from its least reach to its most and its motion along that more,
    // `getHitEntitiesAlong`, meets nothing where a block it collides with comes nearer than its
    // least reach, else ends at such a block. What its way meets, in the order the level finds
    // them, mobs and stands, then players, is what's alive, pickable and not invulnerable whose
    // box is within its margin of the way, there clear of colliding blocks to the box's middle,
    // `getManyEntityHitResult`. Each not hit too lately, `wasRecentlyStabbed`, is kept as hit now,
    // and is hit where what it does holds: its speed along its look, less theirs, at least none,
    // against the spear's conditions at a mob's fifth, `test`; the damage its attack damage's
    // base and the whole of that times the spear's multiplier.
    fn stabs_of<B: CollisionBlocks>(self, a: mut Mob, due: StabDue, f: Facts, m: MovementStates, blocks: B, players: List<Follower>) -> List<Stab> {
        var out = List<Stab>()
        let (ex, ey, ez) = due.eye
        let (hx, hy, hz) = due.head_look
        let least = due.reach.least
        let from = (ex + hx * least, ey + hy * least, ez + hz * least)
        let (mx, my, mz) = due.movement
        let along = mx * hx + my * hy + mz * hz
        let far = due.reach.most + along.max(0.0)
        var to = (ex + hx * far, ey + hy * far, ez + hz * far)
        let border = self.border ?? widest_border()
        let mover = a.living.body.mover()
        let way = clip_including_border(f, m, blocks, mover, due.eye, to, border)
        if not way.missed {
            to = (way.x, way.y, way.z)
            if distance_sqr(due.eye, to) < distance_sqr(due.eye, from) {
                return out
            }
        }
        let (fx, fy, fz) = from
        let (tx, ty, tz) = to
        let half = due.reach.margin / 2.0
        var area = Aabb { min_x: fx - half, min_y: fy - half, min_z: fz - half, max_x: fx + half, max_y: fy + half, max_z: fz + half }
        area = expand_towards(area, tx - fx, ty - fy, tz - fz).inflate(1.0, 1.0, 1.0)
        var found = List<(i32, Aabb, bool, (f64, f64, f64))>()
        for id in self.found(area, a.living.body.id, 12) {
            let slot = self.all[self.at[id]] else continue
            match slot {
                Entity.Stand(s) => {
                    if not s.living.body.removed and s.living.alive() and not s.marker() and not s.living.body.invulnerable and s.living.invulnerable_time <= 0 {
                        found.push((id, s.living.body.bounding_box(), false, (s.living.body.known_dx, s.living.body.known_dy, s.living.body.known_dz)))
                    }
                },
                Entity.Mob(o) => {
                    if not o.living.body.removed and o.living.alive() and o.pickable() and not o.living.body.invulnerable and o.living.invulnerable_time <= 0 {
                        found.push((id, o.living.body.bounding_box(), false, (o.living.body.known_dx, o.living.body.known_dy, o.living.body.known_dz)))
                    }
                },
                _ => {},
            }
        }
        for p in players {
            if p.spectator or p.dead {
                continue
            }
            let b = p.bounds else continue
            if b.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                found.push((p.id, b, true, (p.known_dx, p.known_dy, p.known_dz)))
            }
        }
        let k = due.kinetic
        let (lx, ly, lz) = due.look
        let (sx, sy, sz) = due.speed
        let speed = lx * sx + ly * sy + lz * sz
        let now = self.game_time
        for (id, b, player, known) in found {
            if not meets_way(f, m, blocks, mover, border, b, from, to, due.reach.margin) {
                continue
            }
            if a.living.stabbed_lately(id, now, k.contact_cooldown) {
                continue
            }
            let (kx, ky, kz) = known
            let theirs = lx * (kx * 20.0) + ly * (ky * 20.0) + lz * (kz * 20.0)
            let relative = (speed - theirs).max(0.0)
            let dismounts = match k.dismount { some(c) => c.test(due.ticks, speed, relative, f64(0.2f32)), none => false }
            let knocks = match k.knockback { some(c) => c.test(due.ticks, speed, relative, f64(0.2f32)), none => false }
            let hurts = match k.damage { some(c) => c.test(due.ticks, speed, relative, f64(0.2f32)), none => false }
            if dismounts or knocks or hurts {
                let damage = f32.nearest(due.base_damage) + f32.nearest(floor(relative * f64(k.multiplier)))
                out.push(Stab { target: id, player: player, damage: damage, hurts: hurts, knocks: knocks, dismounts: dismounts })
            }
        }
        return out
    }

    // What the mob `a`, of the ID `id`, showed of its tick kept, `shown`, with its ID and the
    // sounds it came after, and forgotten by it; whether it bred among it (CAL-159).
    fn keep_shown(mut self, id: i32, a: mut Mob) -> bool {
        var bred = false
        for k in 0..a.living.shown.len() {
            if let Shown.Bred(_) = a.living.shown[k] {
                bred = true
            }
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        return bred
    }

    // The rest of the tick of the mob `mob` at `i`, after its goals, `tick_rest`, which `entered`
    // says whether it began, and whether it `bred` before (CAL-159): what it showed kept, whom its
    // hurt alerts told, it moved into its section, and where it's still here, it pushes what its
    // box meets, but where it bred, after the tick list's run past it.
    fn tick_mob_rest<B: CollisionBlocks + EntityTicking + MobLight + NavLevel + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, mob: own Mob, entered: bool, bred_before: bool, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = mob
        let id = a.living.body.id
        let brained = a.brain != none
        if brained {
            a.level_random = self.level_random.take()
            a.pois = self.pois.take()
        }
        let stopped = a.tick_rest(entered, lf, f, m, t, blocks, items, mut self.path_types, players, min_y, fast_lava, mut sounds)
        if brained {
            self.level_random = a.level_random.take()
            self.pois = a.pois.take()
        }
        if stopped {
            // Its brain swung a door, which its level swings before its tick goes on, as vanilla
            // sets the block then and there, the paths of the mobs it's near enough found again
            // as `take_sent` takes it: what it showed so far kept, and what it did to others
            // done, and it stopped till the next `tick_next`, knowing what's near it still
            // (CAL-160).
            let told = a.told.copy()
            a.told.clear()
            let bred = self.keep_shown(id, mut a) or bred_before
            self.all[i] = some(Entity.Mob(a))
            self.heard = sounds.len()
            self.tell_others(told, f, sounds)
            self.paused = some((i, entered, bred))
            return
        }
        if let landed = a.living.body.farmland_fall.take() {
            // Where it's big enough, it tramples the farmland, which its level turns to dirt where
            // mob griefing lets it (CAL-160).
            let (fell, fx, fy, fz) = landed
            let (w, h) = (a.living.body.width, a.living.body.height)
            if self.farmland_draw(fell) and w * w * h > 0.512f32 {
                // Standing in the way of the dirt's top, it's pushed up onto it then and there, as
                // vanilla's move pushes it; what else is in the way is pushed as its level turns
                // the farmland to dirt.
                let top = f64(fy) + 1.0
                if a.mob_griefing and a.living.body.y < top {
                    lift_body(mut a.living.body, top)
                }
                a.living.show(Shown.Trampled((fx, fy, fz)), sounds.len())
            }
        }
        if brained {
            a.near.clear()
        }
        a.kin.clear()
        let alert = a.alerted
        a.alerted = none
        let told = a.told.copy()
        a.told.clear()
        let bred = self.keep_shown(id, mut a) or bred_before
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        let (ax, ay, az) = (a.living.body.x, a.living.body.y, a.living.body.z)
        let within = a.living.attributes.value(lf.follow_range)
        let zombie = a.species == ZOMBIE
        self.all[i] = some(Entity.Mob(a))
        self.heard = sounds.len()
        if let target = alert {
            self.alert_others(id, zombie, ax, ay, az, within, target, players)
        }
        self.tell_others(told, f, sounds)
        if removed {
            self.remove(id)
        } else if bred {
            self.move_section(id, key)
            self.push_after = some(id)
        } else {
            self.move_section(id, key)
            self.push_entities(id, lf, f, blocks, players)
        }
        if entered and not removed {
            self.loot(id, lf, f, items, mut sounds)
        }
        if self.tracing and not removed {
            self.trace_mob(i)
        }
    }

    // What a mob's behaviors did to others in its tick, `Told`, done in their order (CAL-160): a
    // walk to it set in the brain of the mob it's for, and a villager's gossip with another, where
    // both are here.
    fn tell_others(mut self, told: List<Told>, f: Facts, sounds: List<EntitySound>) {
        for r in told {
            match r {
                Told.WalkTo(w) => {
                    let (of, to, speed, stop) = w
                    var other = self.lend_mob(of) else continue
                    other.walk_to(to, speed, stop)
                    self.give_back_mob(other)
                },
                Told.Erase(e) => {
                    let (of, memory) = e
                    var other = self.lend_mob(of) else continue
                    other.forget(memory)
                    self.give_back_mob(other)
                },
                Told.JobSite(j) => {
                    let (of, x, y, z, speed) = j
                    var other = self.lend_mob(of) else continue
                    other.take_job_site(x, y, z, speed, self.dimension.copy())
                    self.give_back_mob(other)
                },
                Told.BreedWith(b) => {
                    let (of, with) = b
                    var other = self.lend_mob(of) else continue
                    other.breed_with(with)
                    self.give_back_mob(other)
                },
                Told.Digest(of) => {
                    var other = self.lend_mob(of) else continue
                    other.eat_and_digest(f)
                    self.give_back_mob(other)
                },
                Told.Gossip(g) => {
                    let (of, with, now) = g
                    var other = self.lend_mob(with) else continue
                    let me = self.lend_mob(of) else {
                        self.give_back_mob(other)
                        continue
                    }
                    var mine = me
                    mine.gossip_with(mut other, now, sounds.len())
                    _ = self.keep_shown(of, mut mine)
                    self.heard = sounds.len()
                    self.give_back_mob(mine)
                    self.give_back_mob(other)
                },
            }
        }
    }

    // The items near the villager `a` for its brain (CAL-160): those its item sensor looks over,
    // in its box grown 32 across and 16 up and down, as `getEntitiesOfClass` finds them, each with
    // whether it wants it where its sensor's due this tick; then those its memories hold elsewhere,
    // and those gone from the level since, where they were last.
    fn items_for<W: Wearing>(self, a: Mob, lf: LivingFacts, f: Facts, items: W) -> List<Near> {
        let id = a.living.body.id
        let due = a.item_sensor_due()
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - 32.0, min_y: b.min_y - 16.0, min_z: b.min_z - 32.0, max_x: b.max_x + 32.0, max_y: b.max_y + 16.0, max_z: b.max_z + 32.0 }
        var out = List<Near>()
        for o in self.found(wide, id, 1) {
            let slot = self.all[self.at[o]] else continue
            let Entity.Item(e) = slot else continue
            var n = item_near(o, e)
            n.wanted = due and a.villager_wants(lf, f, items, e.stack.copy())
            out.push(n)
        }
        for w in a.watched() {
            var known = false
            for n in out {
                if n.id == w {
                    known = true
                }
            }
            if known {
                continue
            }
            if self.at.contains(w) {
                if let slot = self.all[self.at[w]] {
                    if let Entity.Item(e) = slot {
                        out.push(item_near(w, e))
                    }
                }
                continue
            }
            for n in a.near_items {
                if n.id == w {
                    var last = n
                    last.gone = true
                    last.wanted = false
                    out.push(last)
                }
            }
        }
        return out
    }

    // `Mob.aiStep`'s looting by the mob `id`, after its pushes (CAL-159): where it `loots`, each
    // item in its `pickup_box`, as `getEntitiesOfClass` finds them, that's still here, isn't empty,
    // has no pickup delay left and it wants, `pickUpItem`: it equips what it may of a copy, and
    // where it equips something, it's taken, `take`, which those who see the item are told, and
    // the item's stack shrinks by as much where it is, which isn't sent, the item gone where none's
    // left. Taking up what a player threw would tell them of it, `onItemPickup`, an advancement,
    // which comes with advancements.
    fn loot<W: Wearing>(mut self, id: i32, lf: LivingFacts, f: Facts, items: W, sounds: mut List<EntitySound>) {
        var mob = self.lend_mob(id) else return
        if not mob.loots() {
            self.give_back_mob(mob)
            return
        }
        for item in self.find(mob.pickup_box(), -1) {
            var e = self.lend(item) else continue
            let carries = mob.carries_inventory()
            let wants = if carries { mob.villager_wants(lf, f, items, e.stack.copy()) } else { mob.wants_to_pick_up(lf, e.stack.copy()) }
            if e.body.removed or e.is_empty() or e.pickup_delay > 0 or not wants {
                self.give_back(e)
                continue
            }
            // A villager's into its inventory, `InventoryCarrier.pickUpItem` (CAL-160); another's
            // equipped.
            var taken = 0
            if carries {
                taken = mob.pick_up_into(e.stack.copy(), f)
            } else {
                let equipped = mob.equip_if_possible(lf, items, e.stack.copy(), mut sounds) else {
                    self.give_back(e)
                    continue
                }
                taken = count_of(some(equipped))
            }
            mob.living.show(Shown.Picked((item, taken)), sounds.len())
            e.stack = counted(e.stack, e.count() - taken)
            let empty = e.is_empty()
            if empty {
                e.body.removed = true
            }
            self.give_back(e)
            if empty {
                self.heard = sounds.len()
                self.remove(item)
            }
        }
        _ = self.keep_shown(id, mut mob)
        self.heard = sounds.len()
        self.give_back_mob(mob)
    }

    // The line `--entity-trace` writes for the mob or armor stand at `i` as its tick is done
    // (CAL-159), as the rig agent's trace writes vanilla's as `tickNonPassenger` returns: the game
    // time, its ID, its place and motion, its turns, its body's and its head's, what it's told to
    // walk and its speed, and whether it's on the ground.
    fn trace_mob(mut self, i: usize) {
        let taken = self.all[i].take() else return
        let line = traced(self.game_time, taken)
        self.all[i] = some(taken)
        self.trace.push_str(line)
    }

    // `HurtByTargetGoal.alertOthers` of the mob `id` at x, y, z, a zombie or not, its follow range
    // `within`, hurt by the player `target` (CAL-159): the mobs of its class whose boxes meet the
    // block's box from its place, `unitCubeFromLowerCorner`, `within` beyond it across and 10 up
    // and down, in `getEntitiesOfClass`' order, but itself, each alerted where it has no target,
    // `alerted_to`. A zombie's class is the zombies' and zombie villagers', `Zombie`'s, but for the
    // zombified piglins it ignores; a zombie villager's its own. No teams, so none are allied.
    fn alert_others(mut self, id: i32, zombie: bool, x: f64, y: f64, z: f64, within: f64, target: i32, players: List<Follower>) {
        let near = Aabb { min_x: x - within, min_y: y - 10.0, min_z: z - within, max_x: x + 1.0 + within, max_y: y + 1.0 + 10.0, max_z: z + 1.0 + within }
        for other in self.found(near, id, 8) {
            var o = self.lend_mob(other) else continue
            let alike = if zombie { o.zombie_class() } else { o.species == ZOMBIE_VILLAGER }
            if alike {
                o.alerted_to(target, players)
            }
            self.give_back_mob(o)
        }
    }

    /// `ServerPlayer.tellNeutralMobsThatIDied` of the player of the UUID `uuid`, who died in the
    /// block at x, y, z, where the game rule `forgive_dead_players` has it (CAL-159): the mobs
    /// whose boxes meet the block's box 32 beyond it across and 10 up and down,
    /// `getEntitiesOfClass`, none spectators, each told, `player_died`, as the neutral ones are.
    pub fn tell_player_died(mut self, x: i32, y: i32, z: i32, uuid: (i64, i64)) {
        let near = Aabb { min_x: f64(x) - 32.0, min_y: f64(y) - 10.0, min_z: f64(z) - 32.0, max_x: f64(x) + 33.0, max_y: f64(y) + 11.0, max_z: f64(z) + 33.0 }
        for other in self.found(near, -1, 8) {
            var o = self.lend_mob(other) else continue
            o.player_died(uuid)
            self.give_back_mob(o)
        }
    }

    // The mobs whose boxes meet the box 16 beyond `b` on every side, but `except`, as `found` finds
    // them, as the goals of a mob there read them, `getEntitiesOfClass`'s for its kind within less,
    // and its parent's to 16 away (CAL-158).
    fn kin_near(self, b: Aabb, except: i32) -> List<Kin> {
        let wide = Aabb { min_x: b.min_x - 16.0, min_y: b.min_y - 16.0, min_z: b.min_z - 16.0, max_x: b.max_x + 16.0, max_y: b.max_y + 16.0, max_z: b.max_z + 16.0 }
        var out = List<Kin>()
        for id in self.found(wide, except, 8) {
            let slot = self.all[self.at[id]] else continue
            let Entity.Mob(o) = slot else continue
            out.push(Kin {
                id: id,
                species: o.species,
                x: o.living.body.x,
                y: o.living.body.y,
                z: o.living.body.z,
                eyes: o.living.body.eyes,
                bounds: o.living.body.bounding_box(),
                age: o.age,
                in_love: o.in_love > 0,
                alive: o.living.alive(),
                panicking: o.goals.panicking(),
                variant: o.breed_variant(),
            })
        }
        return out
    }

    // What the brain mob `a` reads of the living entities near it this tick, `Near` (CAL-160): the
    // mobs and armor stands whose boxes meet its own grown by its follow range, as `found` finds
    // them, then those its memories hold, `watched`, wherever they are in the level, then the
    // level's players, in their order, which vanilla finds among the rest in their sections
    // (CAL-190).
    fn brain_near(self, a: Mob, lf: LivingFacts, players: List<Follower>) -> List<Near> {
        let id = a.living.body.id
        let follow = a.living.attributes.value(lf.follow_range)
        let b = a.living.body.bounding_box()
        let wide = Aabb { min_x: b.min_x - follow, min_y: b.min_y - follow, min_z: b.min_z - follow, max_x: b.max_x + follow, max_y: b.max_y + follow, max_z: b.max_z + follow }
        var ids = self.found(wide, id, 12)
        for w in a.watched() {
            if w != id and self.at.contains(w) and not ids.contains(w) {
                ids.push(w)
            }
        }
        var out = List<Near>()
        for o in ids {
            let slot = self.all[self.at[o]] else continue
            match slot {
                Entity.Mob(e) => {
                    let (profession, xp, site, here, seeks) = e.job_seen(self.dimension)
                    out.push(Near {
                    id: o,
                    uuid: e.living.body.uuid,
                    species: e.species,
                    x: e.living.body.x,
                    y: e.living.body.y,
                    z: e.living.body.z,
                    eyes: e.living.body.eyes,
                    bounds: e.living.body.bounding_box(),
                    alive: e.living.alive() and not e.living.body.removed,
                    baby: e.baby(),
                    undead: e.undead(),
                    panicking: e.panicking(),
                    in_love: e.in_love > 0,
                    category: e.category,
                    profession: profession,
                    villager_xp: xp,
                    job_site: site,
                    job_site_here: here,
                    seeks_job_site: seeks,
                    through: e.path_about(),
                    food: e.food_points(),
                    sleeping: e.sleeping(),
                    interacting: e.interaction_target(),
                    can_breed: e.can_breed(),
                    villager_type: e.villager_kind(),
                })
                },
                Entity.Stand(s) => out.push(Near {
                    id: o,
                    uuid: s.living.body.uuid,
                    species: OTHER,
                    x: s.living.body.x,
                    y: s.living.body.y,
                    z: s.living.body.z,
                    eyes: s.living.body.eyes,
                    bounds: s.living.body.bounding_box(),
                    alive: s.living.alive() and not s.living.body.removed,
                }),
                _ => {},
            }
        }
        let kind = i32.wrap(a.living.kind)
        for p in players {
            let point = Aabb { min_x: p.x, min_y: p.y, min_z: p.z, max_x: p.x, max_y: p.y, max_z: p.z }
            out.push(Near {
                id: p.id,
                uuid: p.uuid ?? (0i64, 0i64),
                species: PLAYER,
                x: p.x,
                y: p.y,
                z: p.z,
                eyes: p.eyes,
                bounds: p.bounds ?? point,
                alive: not p.dead,
                visibility: p.visibility(kind),
                spectator: p.spectator,
                sprinting: p.sprinting,
                tempts: p.tempts,
                main_hand: p.main_hand,
            })
        }
        return out
    }

    /// The bell at the place rung at the game time `now`, its block event's, `updateEntities`
    /// (CAL-160): where it last looked more than 60 ticks before, or never, the living entities
    /// whose boxes meet its block grown 48 each way looked for again, of which only mobs have
    /// brains; then each of those alive and still here within 32 of its middle hears it,
    /// `HEARD_BELL_TIME`. Its block entity's search is kept as long as the level is.
    pub fn hear_bell(mut self, x: i32, y: i32, z: i32, now: i64) {
        let key = BlockPos { x: x, y: y, z: z }.pack()
        var last: (i64, List<i32>)? = none
        if self.bells.contains(key) {
            last = some(self.bells[key].copy())
        }
        var near = List<i32>()
        var fresh = true
        if let (at, ids) = last {
            if now <= at + 60 {
                near = ids.copy()
                fresh = false
            }
        }
        if fresh {
            let (fx, fy, fz) = (f64(x), f64(y), f64(z))
            let b = Aabb { min_x: fx - 48.0, min_y: fy - 48.0, min_z: fz - 48.0, max_x: fx + 49.0, max_y: fy + 49.0, max_z: fz + 49.0 }
            near = self.found(b, -1, 8)
            self.bells.insert(key, (now, near.copy()))
        }
        let (cx, cy, cz) = (f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)
        for id in near {
            var m = self.lend_mob(id) else continue
            let (dx, dy, dz) = (m.living.body.x - cx, m.living.body.y - cy, m.living.body.z - cz)
            if m.living.alive() and not m.living.body.removed and dx * dx + dy * dy + dz * dz < 1024.0 {
                m.hear_bell(now)
            }
            self.give_back_mob(m)
        }
    }

    /// The push of the mob that bred in the entity's tick just done, once the level's made its baby
    /// and orb, which it then meets (D415).
    pub fn push_bred<B: CollisionBlocks + EntityTicking>(mut self, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        if let id = self.push_after {
            self.push_after = none
            self.push_entities(id, lf, f, blocks, players)
        }
    }

    // `pushEntities` for the mob `id` (CAL-156), which ends its `aiStep` in vanilla and comes here
    // after its tick, as nothing after it there reads its motion: the mobs whose boxes meet its
    // own that may be pushed, `getPushableEntities`, as `found` finds them, then the players of
    // `players` that may be; where they're as many as the game rule `max_entity_cramming` or more,
    // a draw of 4 from its own random, and on a 0, with as many not riding, its hurt by cramming,
    // which waits (CAL-189); then each pushes and is pushed, `doPush`, a player's push kept for the
    // server, `player_pushes` (CAL-174). The players are found after the mobs, where vanilla finds
    // each in its section among them (CAL-190).
    fn push_entities<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B, players: List<Follower>) {
        let me = self.lend_mob(id) else return
        let b = me.living.body.bounding_box()
        self.give_back_mob(me)
        var mobs = List<i32>()
        for other in self.found(b, id, 8) {
            if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
            }
        }
        var people = List<(i32, f64, f64)>()
        for p in players {
            if let pb = p.pushable {
                if pb.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                    people.push((p.id, p.x, p.z))
                }
            }
        }
        let n = mobs.len() + people.len()
        if n == 0 {
            return
        }
        if self.cramming > 0 and n > usize.wrap(self.cramming - 1) {
            var drawing = self.lend_mob(id) else return
            _ = drawing.living.body.random.next_int_below(4)
            self.give_back_mob(drawing)
        }
        for other in mobs {
            self.push_pair(id, other, lf, f, blocks)
        }
        // `player.push(mob)`: the player, who may be pushed, pushed away from it, then it from
        // them.
        for (pid, px, pz) in people {
            var mover = self.lend_mob(id) else return
            if not mover.living.body.no_physics {
                let pushed = push_between(px, pz, mover.living.body.x, mover.living.body.z)
                if let q = pushed {
                    let (xa, za) = q
                    self.player_pushes.push((pid, -xa, -za))
                    let ticking = ticking_at(blocks, mover.living.body.x, mover.living.body.z)
                    if mover.pushable(lf, f, blocks, ticking) {
                        mover.living.body.push(xa, 0.0, za)
                    }
                }
            }
            self.give_back_mob(mover)
        }
    }

    // `Entity.push(entity)` of the mob `other` by the mob `pusher`: where `other` isn't asleep,
    // `LivingEntity.push` (CAL-160), neither has no physics and they're far enough apart across,
    // each that may be pushed pushed away from the other.
    fn push_pair<B: CollisionBlocks + EntityTicking>(mut self, pusher: i32, other: i32, lf: LivingFacts, f: Facts, blocks: B) {
        var a = self.lend_mob(pusher) else return
        var o = self.lend_mob(other) else {
            self.give_back_mob(a)
            return
        }
        if not o.sleeping() and not a.living.body.no_physics and not o.living.body.no_physics {
            let pushed = push_between(o.living.body.x, o.living.body.z, a.living.body.x, a.living.body.z)
            if let q = pushed {
                let (xa, za) = q
                let other_ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                if o.pushable(lf, f, blocks, other_ticks) {
                    o.living.body.push(-xa, 0.0, -za)
                }
                let pusher_ticks = ticking_at(blocks, a.living.body.x, a.living.body.z)
                if a.pushable(lf, f, blocks, pusher_ticks) {
                    a.living.body.push(xa, 0.0, za)
                }
            }
        }
        self.give_back_mob(o)
        self.give_back_mob(a)
    }

    // Whether the mob `id` may be pushed, `isPushable`, as `getPushableEntities` asks.
    fn mob_pushable<B: CollisionBlocks + EntityTicking>(mut self, id: i32, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        var m = self.lend_mob(id) else return false
        let ticks = ticking_at(blocks, m.living.body.x, m.living.body.z)
        let p = m.pushable(lf, f, blocks, ticks)
        self.give_back_mob(m)
        return p
    }

    /// A player's `pushEntities` (CAL-156), the player `me` at `x`, `z`, whose box is `b`: the
    /// mobs whose boxes meet it that may be pushed, as `push_entities` finds them, each pushed away
    /// from the player, `mob.push(player)`, where the player has physics, not a spectator, as
    /// `pushes` says, and the player pushed away from it where they may be, `pushed`, kept in
    /// `player_pushes` (CAL-174); how many mobs there were, which with the other players that may
    /// be pushed are what the cramming counts.
    pub fn pushed_by_player<B: CollisionBlocks + EntityTicking>(mut self, me: i32, x: f64, z: f64, b: Aabb, pushes: bool, pushed: bool, lf: LivingFacts, f: Facts, blocks: B) -> usize {
        var mobs = List<i32>()
        for other in self.found(b, -1, 8) {
            if self.mob_pushable(other, lf, f, blocks) {
                mobs.push(other)
            }
        }
        if not pushes {
            return mobs.len()
        }
        for other in mobs {
            var o = self.lend_mob(other) else continue
            // `mob.push(player)`, which a sleeper doesn't (CAL-160).
            if not o.sleeping() and not o.living.body.no_physics {
                let away = push_between(o.living.body.x, o.living.body.z, x, z)
                if let q = away {
                    let (xa, za) = q
                    let ticks = ticking_at(blocks, o.living.body.x, o.living.body.z)
                    if o.pushable(lf, f, blocks, ticks) {
                        o.living.body.push(-xa, 0.0, -za)
                    }
                    if pushed {
                        self.player_pushes.push((me, xa, za))
                    }
                }
            }
            self.give_back_mob(o)
        }
        return mobs.len()
    }

    /// Where the arrows are that aren't gone, which a wooden button's tick looks for in its shape
    /// (CAL-159).
    pub fn arrow_places(self) -> List<(f64, f64, f64)> {
        var out = List<(f64, f64, f64)>()
        for slot in self.all {
            if let e = slot {
                if let Entity.Arrow(a) = e {
                    if not a.body.removed {
                        out.push((a.body.x, a.body.y, a.body.z))
                    }
                }
            }
        }
        return out
    }

    /// Those of its entities whose nether portals take them as their next ticks handle them, as
    /// the level's tick begins: in one last tick and able to go through it, `canUsePortal`, a
    /// nether portal's wait being none for what isn't a player (D578). The server's thread loads
    /// what their ways read as their ticks go; Calcite's tick holds for it as it begins.
    /// The ID of the entity whose tick `tick_next` begins next, of those that came into the level
    /// before `before`, none where it goes on with one it stopped or there's none (D595).
    pub fn next_up(self, before: u64) -> i32? {
        if self.paused != none or self.paused_use != none or self.paused_arrow != none {
            return none
        }
        var at = self.cursor
        while at < self.end {
            if let e = self.all[at] {
                if entered_of(e) >= before {
                    return none
                }
                return some(id_of(e))
            }
            at += 1
        }
        return none
    }

    pub fn portals_due(self) -> List<PortalDue> {
        var out = List<PortalDue>()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Item(i) => due_of(mut out, i.body, not i.body.removed),
                Entity.Orb(o) => due_of(mut out, o.body, not o.body.removed),
                Entity.Stand(a) => due_of(mut out, a.living.body, a.living.alive() and a.living.sleeping == none),
                Entity.Mob(m) => due_of(mut out, m.living.body, m.living.alive() and m.living.sleeping == none),
                Entity.Arrow(a) => due_of(mut out, a.body, not a.body.removed),
                Entity.Thrown(p) => due_of(mut out, p.body, true),
                Entity.Cloud(_) => {},
                Entity.Crystal(c) => due_of(mut out, c.body, not c.body.removed),
                Entity.Eye(_) => {},
                Entity.Fireball(b) => due_of(mut out, b.body, not b.body.removed),
                Entity.Tnt(p) => due_of(mut out, p.body, not p.body.removed),
            }
        }
        return out
    }

    /// The ender pearls among the pearls of the player of the serial `serial`, not gone, in its
    /// order, `getEnderPearls` (D580): what's saved of each, `saveAsPassenger`, and its ID.
    pub fn pearls_of(self, serial: i64) -> List<(i32, Tag)> {
        var out = List<(i32, Tag)>()
        if serial == 0 {
            return out
        }
        for slot in self.all {
            let e = slot else continue
            if let Entity.Thrown(p) = e {
                if p.pearl and not p.body.removed and p.registered == serial {
                    out.push((p.body.id, p.saved()))
                }
            }
        }
        return out
    }

    /// Those of its thrown items and arrows whose nether portals would take them in their own
    /// steps this tick, which go the tick they come into one, as `portals_due` lists those
    /// already in one (D579): each run ahead on a copy as the level's tick begins, its move
    /// among `blocks` as they are then, what entities it'd hit passed over, where its way takes
    /// it into a portal while its cooldown's out. So the server's tick holds for what their
    /// ways read too, which vanilla's thread loads as their ticks take them.
    pub fn portals_coming<B: CollisionBlocks + Rain + Gateways>(self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool) -> List<PortalDue> {
        var out = List<PortalDue>()
        let border = self.border ?? widest_border()
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Thrown(p) => {
                    if not p.body.removed {
                        var ahead = p.copy()
                        var heard = List<EntitySound>()
                        ahead.tick_start(f, m, blocks, border, 0)
                        ahead.go(f, blocks, none, mut heard)
                        due_of(mut out, ahead.body, true)
                    }
                },
                Entity.Arrow(a) => {
                    if not a.body.removed and not a.in_ground() {
                        var ahead = a.copy()
                        var heard = List<EntitySound>()
                        if ahead.tick_start(f, m, t, blocks, min_y, fast_lava, none, border, mut heard) {
                            let from = (ahead.body.x, ahead.body.y, ahead.body.z)
                            ahead.body.x = ahead.way.x
                            ahead.body.y = ahead.way.y
                            ahead.body.z = ahead.way.z
                            ahead.step_acts(f, blocks, from, mut heard)
                            due_of(mut out, ahead.body, true)
                        }
                    }
                },
                _ => {},
            }
        }
        return out
    }

    /// The pushes players took since they were last taken, `player_pushes`, which are then
    /// forgotten (CAL-174).
    pub fn take_player_pushes(mut self) -> List<(i32, f64, f64)> {
        let out = self.player_pushes.copy()
        self.player_pushes.clear()
        return out
    }

    // What blocks did to the item or orb `id` that its level's to do (D435), kept as what a living
    // entity shows is: redstone ore lit, and what's missing.
    fn keep_acted(mut self, id: i32, acted: List<Acted>, after: List<usize>) {
        for k in 0..acted.len() {
            let shown = match acted[k] {
                Acted.Lit(at) => Shown.Lit(at),
                Acted.Pressed(at) => Shown.Pressed(at),
                Acted.Missing(what) => Shown.Missing(what.copy()),
                Acted.Event(n) => Shown.Event(n),
                Acted.Travel(way) => Shown.Travel(way.copy()),
                Acted.Gateway(g) => Shown.Gateway(g),
                Acted.Moved(m) => Shown.Moved(m),
            }
            self.shown.push(shown)
            self.shown_by.push(id)
            self.shown_after.push(after[k])
        }
    }

    // `EntityEquipment.tick`, in `LivingEntity.aiStep`, for the mob's or armor stand's `living`
    // (D607): each stack of its equipment, by `EquipmentSlot`'s order, a lodestone compass's
    // tracker ticked, `CompassItem.inventoryTick`, the stack changed in place where its target's
    // gone, which `detectEquipmentUpdates` finds in its next tick; a target whose chunk's points
    // of interest aren't read yet asked for, `poi_asks`; and a map in a hand, which draws what's
    // about it, `MapItem.inventoryTick`, told of, as Calcite has no maps yet. Calcite ticks it as
    // the rest of `aiStep` ends, which nothing between reads.
    fn equipment_tick(mut self, living: mut Living, heard: usize) {
        var ticks = false
        for s in living.equipment {
            let item = stack_item(s.copy())
            if item == "minecraft:compass" or item == "minecraft:filled_map" {
                ticks = true
            }
        }
        if not ticks {
            return
        }
        let pois = self.pois.take() else return
        for slot in 0..living.equipment.len() {
            let stack = living.equipment[slot].copy()
            match lodestone_tick(stack.copy(), self.dimension.copy(), pois) {
                TrackerTick.Lost(s) => living.equipment[slot] = some(s),
                TrackerTick.Unknown(c) => self.poi_asks.push(c),
                TrackerTick.Kept => {},
            }
            if slot <= 1 and draws_map(stack) {
                living.show(Shown.Missing(String("Maps drawing what's about those who carry them")), heard)
            }
        }
        self.pois = some(pois)
    }

    // An armor stand's tick, at `i`: what it showed kept with its ID, and it gone where its tick
    // took it away, below the level or broken (D441); its equipment ticked where it's still
    // there (D607).
    fn tick_stand<B: CollisionBlocks + Rain + Warding + Gateways, W: Wearing>(mut self, i: usize, stand: own ArmorStand, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var a = stand
        a.tick(lf, f, m, t, blocks, items, min_y, fast_lava, players, mut sounds)
        if not a.living.body.removed {
            self.equipment_tick(mut a.living, sounds.len())
        }
        // Never big enough to trample farmland it lands on, though that draws (CAL-160).
        if let landed = a.living.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = a.living.body.id
        for k in 0..a.living.shown.len() {
            self.shown.push(a.living.shown[k].copy())
            self.shown_by.push(id)
            self.shown_after.push(a.living.shown_after[k])
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        let key = section_key(a.living.body.x, a.living.body.y, a.living.body.z)
        let removed = a.living.body.removed
        self.all[i] = some(Entity.Stand(a))
        self.heard = sounds.len()
        if removed {
            self.remove(id)
        } else {
            self.move_section(id, key)
            if self.tracing {
                self.trace_mob(i)
            }
        }
    }

    // An item's tick, at `i`: to where it merges, its merging, then the rest; what blocks did
    // that its level's to do kept with its ID (D435).
    fn tick_item<B: CollisionBlocks + EntityTicking + Rain + Gateways, S: StackSizes + Wearing>(mut self, i: usize, item: own ItemEntity, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, codecs: S, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        var e = item
        e.tick_moving(f, m, t, types, codecs, blocks, min_y, fast_lava, mut sounds)
        if let landed = e.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let id = e.body.id
        self.keep_acted(id, e.acted, e.acted_after)
        e.acted.clear()
        e.acted_after.clear()
        let key = section_key(e.body.x, e.body.y, e.body.z)
        let due = e.merge_due and e.mergable(codecs.stack_most(e.stack))
        let removed = e.body.removed
        self.all[i] = some(Entity.Item(e))
        if not removed {
            self.move_section(id, key)
        }
        self.heard = sounds.len()
        if due {
            self.merge_near(i, codecs)
        }
        var after = self.lend(id) else return
        after.tick_after(f, t, blocks, fast_lava, mut sounds)
        let done = after.body.removed
        self.give_back(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    /// `Block.pushEntitiesUp` of what's in the way of `slab`, the part a block grows by, as
    /// farmland turns to dirt (CAL-160): each entity whose box meets it, in the order they're
    /// found, moved up by what a move down from a block above it leaves, `Shapes.collide`,
    /// `teleportRelative`, its place where it was last tick too, as `snapTo` sets it.
    pub fn push_up(mut self, slab: Aabb) {
        for id in self.find_every(slab, -1) {
            self.lift(id, slab.max_y)
        }
    }

    // The entity `id` moved up by `1 + offset`, `offset` a move down of 1 from a block above
    // stopped at `top`, as `pushEntitiesUp` moves it; moved into the section it's in now.
    fn lift(mut self, id: i32, top: f64) {
        if not self.at.contains(id) {
            return
        }
        let i = self.at[id]
        let taken = self.all[i].take() else return
        let lifted = match taken {
            Entity.Item(e) => {
                var it = e
                lift_body(mut it.body, top)
                Entity.Item(it)
            },
            Entity.Orb(o) => {
                var it = o
                lift_body(mut it.body, top)
                Entity.Orb(it)
            },
            Entity.Stand(a) => {
                var it = a
                lift_body(mut it.living.body, top)
                Entity.Stand(it)
            },
            Entity.Mob(m) => {
                var it = m
                lift_body(mut it.living.body, top)
                Entity.Mob(it)
            },
            Entity.Arrow(a) => {
                var it = a
                lift_body(mut it.body, top)
                Entity.Arrow(it)
            },
            Entity.Thrown(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Thrown(it)
            },
            Entity.Cloud(c) => {
                var it = c
                lift_body(mut it.body, top)
                Entity.Cloud(it)
            },
            Entity.Crystal(c) => {
                var it = c
                lift_body(mut it.body, top)
                Entity.Crystal(it)
            },
            Entity.Eye(e) => {
                var it = e
                lift_body(mut it.body, top)
                Entity.Eye(it)
            },
            Entity.Fireball(b) => {
                var it = b
                lift_body(mut it.body, top)
                Entity.Fireball(it)
            },
            Entity.Tnt(p) => {
                var it = p
                lift_body(mut it.body, top)
                Entity.Tnt(it)
            },
        }
        let (x, y, z) = place_of(lifted)
        self.all[i] = some(lifted)
        self.move_section(id, section_key(x, y, z))
    }

    // `FarmlandBlock.fallOn`'s draw from the level's random for what landed on farmland, `fell`
    // up, in its tick, as its move's done (CAL-160): whether the draw's under its fall less a
    // half, so a living entity big enough would trample it.
    fn farmland_draw(mut self, fell: f64) -> bool {
        let lent = self.level_random.take() else return false
        var r = lent
        let trampled = f64(r.next_float()) < fell - 0.5
        self.level_random = some(r)
        return trampled
    }

    // An orb's tick, at `i`: to where it looks for orbs to take in, its look, then the rest; what
    // blocks did that its level's to do kept with its ID, and its sounds heard (D435).
    fn tick_orb<B: CollisionBlocks + EntityTicking + Rain + Gateways>(mut self, i: usize, orb: own ExperienceOrb, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, blocks: B, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        var o = orb
        o.tick_start(f, m, t, types, blocks, min_y, fast_lava)
        let id = o.body.id
        let due = o.merge_due
        self.all[i] = some(Entity.Orb(o))
        if due {
            self.scan_merges(id)
        }
        var after = self.lend_orb(id) else return
        after.tick_rest(f, m, t, types, blocks, players, mut sounds)
        if let landed = after.body.farmland_fall.take() {
            let (fell, _, _, _) = landed
            _ = self.farmland_draw(fell)
        }
        let done = after.body.removed
        self.keep_acted(id, after.acted, after.acted_after)
        after.acted.clear()
        after.acted_after.clear()
        self.give_back_orb(after)
        self.heard = sounds.len()
        if done {
            self.remove(id)
        }
    }

    // `scanForMerges` for the orb `id`: each orb it may take in whose box meets its own, half a
    // block bigger each way, found first, then taken in in the order they were found.
    fn scan_merges(mut self, id: i32) {
        let me = self.orb_view(id) else return
        let b = me.body.bounding_box()
        let near = Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.5, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.5, max_z: b.max_z + 0.5 }
        var found = List<i32>()
        for other in self.find_orbs(near, id) {
            let o = self.orb_view(other) else continue
            if me.takes_in(o) {
                found.push(other)
            }
        }
        for other in found {
            var into = self.lend_orb(id) else return
            var from = self.lend_orb(other) else {
                self.give_back_orb(into)
                continue
            }
            into.take_in(mut from)
            self.give_back_orb(into)
            self.give_back_orb(from)
            self.remove(other)
        }
    }

    /// Ends a tick: the empty places go once there are as many as entities.
    pub fn end_tick(mut self) {
        self.cursor = 0
        self.end = 0
        self.heard = 0
        if self.empty > 16 and self.empty > self.at.len() {
            self.compact()
        }
    }

    /// `mergeWithNeighbours` of the item `id` where it's mergable, `isMergable`, as `teleport`
    /// merges an item a nether portal took (D578).
    pub fn merge_item<S: StackSizes>(mut self, id: i32, codecs: S) {
        if not self.mergable(id, codecs) {
            return
        }
        let i = self.at[id]
        self.merge_near(i, codecs)
    }

    // `mergeWithNeighbours` for the item at `i`: each mergable item whose box meets its own, 0.5
    // bigger across, in the order they're found, until it's gone.
    fn merge_near<S: StackSizes>(mut self, i: usize, codecs: S) {
        let (id, near) = self.near_box(i) else return
        var found = List<i32>()
        for other in self.find(near, id) {
            if self.mergable(other, codecs) {
                found.push(other)
            }
        }
        for other in found {
            if not self.mergable(other, codecs) {
                continue
            }
            self.try_merge(id, other, codecs)
            if not self.at.contains(id) {
                break
            }
        }
    }

    // The ID of the item at `i` and its box, 0.5 bigger across, `inflate(0.5, 0, 0.5)`.
    fn near_box(self, i: usize) -> (i32, Aabb)? {
        let slot = self.all[i] else return none
        let Entity.Item(e) = slot else return none
        let b = e.body.bounding_box()
        return some((e.body.id, Aabb { min_x: b.min_x - 0.5, min_y: b.min_y - 0.0, min_z: b.min_z - 0.5, max_x: b.max_x + 0.5, max_y: b.max_y + 0.0, max_z: b.max_z + 0.5 }))
    }

    fn mergable<S: StackSizes>(self, id: i32, codecs: S) -> bool {
        if not self.at.contains(id) {
            return false
        }
        let slot = self.all[self.at[id]] else return false
        let Entity.Item(e) = slot else return false
        return e.mergable(codecs.stack_most(e.stack))
    }

    // `tryToMerge`: for the same target, and stacks that fit together, the one with fewer goes
    // into the other, or this one into the other where they've as many.
    fn try_merge<S: StackSizes>(mut self, id: i32, other: i32, codecs: S) {
        let order = self.merge_order(id, other, codecs)
        if order == 1 {
            self.merge_into(id, other, codecs)
        } else if order == 2 {
            self.merge_into(other, id, codecs)
        }
    }

    // Which way `tryToMerge` merges: 0 not at all, 1 `other` into `id`, 2 `id` into `other`.
    fn merge_order<S: StackSizes>(self, id: i32, other: i32, codecs: S) -> i32 {
        let sa = self.all[self.at[id]] else return 0
        let sb = self.all[self.at[other]] else return 0
        let Entity.Item(a) = sa else return 0
        let Entity.Item(b) = sb else return 0
        if a.target != b.target {
            return 0
        }
        if b.count() + a.count() > codecs.stack_most(b.stack) {
            return 0
        }
        if not same_components(some(a.stack.copy()), some(b.stack.copy())) {
            return 0
        }
        return if b.count() < a.count() { 1 } else { 2 }
    }

    // `merge`: as much of `from`'s stack as fits, to 64, goes to `to`'s, which keeps the longer
    // pickup delay and the younger age; `from` goes if it's none left.
    fn merge_into<S: StackSizes>(mut self, to: i32, from: i32, codecs: S) {
        var source = self.lend(from) else return
        var target = self.lend(to) else {
            self.give_back(source)
            return
        }
        let most = min(codecs.stack_most(target.stack), 64)
        let moving = min(most - target.count(), source.count())
        target.stack = counted(target.stack, target.count() + moving)
        target.stack_changed = true
        // `shrink`: the stack changes where it is, which isn't sent.
        source.stack = counted(source.stack, source.count() - moving)
        if source.pickup_delay > target.pickup_delay {
            target.pickup_delay = source.pickup_delay
        }
        if source.age < target.age {
            target.age = source.age
        }
        let empty = source.is_empty()
        if empty {
            source.body.removed = true
        }
        self.give_back(target)
        self.give_back(source)
        if empty {
            self.remove(from)
        }
    }

    // Moves the entity `id` to the section `key` if it isn't in it, last there, as `onMove` does.
    fn move_section(mut self, id: i32, key: i64) {
        if self.section_of.contains(id) {
            let old = self.section_of[id]
            if old == key {
                return
            }
            self.out_of_section(id, old)
        }
        self.into_section(id, key)
    }

    fn into_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            self.sections.insert(key, List<i32>())
            let k = section_chunk(key).pack()
            if not self.chunk_sections.contains(k) {
                self.chunk_sections.insert(k, List<i64>())
            }
            self.chunk_sections[k].push(key)
        }
        self.sections[key].push(id)
        self.section_of.insert(id, key)
    }

    fn out_of_section(mut self, id: i32, key: i64) {
        if not self.sections.contains(key) {
            return
        }
        var kept = List<i32>()
        for other in self.sections[key] {
            if other != id {
                kept.push(other)
            }
        }
        if kept.is_empty() {
            _ = self.sections.remove(key)
            let k = section_chunk(key).pack()
            if self.chunk_sections.contains(k) {
                var left = List<i64>()
                for other in self.chunk_sections[k] {
                    if other != key {
                        left.push(other)
                    }
                }
                if left.is_empty() {
                    _ = self.chunk_sections.remove(k)
                } else {
                    self.chunk_sections.insert(k, left)
                }
            }
        } else {
            self.sections.insert(key, kept)
        }
    }

    // Drops the empty places, keeping the order.
    fn compact(mut self) {
        var kept = List<Entity?>()
        self.at.clear()
        for i in 0..self.all.len() {
            if let e = self.all[i].take() {
                self.at.insert(id_of(e), kept.len())
                kept.push(some(e))
            }
        }
        self.all = kept
        self.empty = 0
    }
}

// Whether the chunk at x, z ticks its entities, `isPositionEntityTicking`.
fn ticking_at<B: EntityTicking>(blocks: B, x: f64, z: f64) -> bool {
    return blocks.ticks_entities(i32.saturate(x.floor()) >> 4, i32.saturate(z.floor()) >> 4)
}

// The entity's ID.
// The body `b` an ender pearl took to x, y, z, as `Entities.pearl_take` puts it (D585): there and
// there last tick, where it was last known forgotten, still, nothing moved this tick and nothing
// fallen, at its own yaw and pitch. What the pearl took, those that see it told at once where
// `told`.
fn pearl_set(b: mut Body, x: f64, y: f64, z: f64, told: bool) -> PearlTaken {
    b.x = x
    b.y = y
    b.z = z
    b.last_known = none
    b.xo = x
    b.yo = y
    b.zo = z
    b.vx = 0.0
    b.vy = 0.0
    b.vz = 0.0
    b.moves.clear()
    b.fall = 0.0
    return PearlTaken { y_rot: b.y_rot, x_rot: b.x_rot, on_ground: b.on_ground, told: told }
}

// The living entity `l` an ender pearl took to x, y, z, as `pearl_set` puts its body (D585), its
// head turned to its yaw, `setYHeadRot`, its yaw and pitch last tick its own, `setOldRot`, and its
// impulse forgotten, `resetCurrentImpulseContext`; those that see it aren't told at once.
fn pearl_set_living(l: mut Living, x: f64, y: f64, z: f64) -> PearlTaken {
    let taken = pearl_set(mut l.body, x, y, z, false)
    l.y_head_rot = l.body.y_rot
    l.y_rot_o = l.body.y_rot
    l.x_rot_o = l.body.x_rot
    l.impulse_grace = 0
    l.impulse_at = none
    return taken
}

fn id_of(e: Entity) -> i32 {
    return match e {
        Entity.Item(i) => i.body.id,
        Entity.Orb(o) => o.body.id,
        Entity.Stand(a) => a.living.body.id,
        Entity.Mob(m) => m.living.body.id,
        Entity.Arrow(a) => a.body.id,
        Entity.Thrown(p) => p.body.id,
        Entity.Cloud(c) => c.body.id,
        Entity.Crystal(c) => c.body.id,
        Entity.Eye(eye) => eye.body.id,
        Entity.Fireball(b) => b.body.id,
        Entity.Tnt(p) => p.body.id,
    }
}

// Where the entity is.
// A body moved up as `pushEntitiesUp` moves it to stand at `top`: a move down of 1 from a block
// above, `Shapes.collide`, which stops at `top`, `teleportRelative` by 1 and that, its place where
// it was last tick too, `snapTo`.
fn lift_body(body: mut Body, top: f64) {
    var offset = top - (body.y + 1.0)
    if offset < -1.0 {
        offset = -1.0
    }
    body.y = body.y + (1.0 + offset)
    body.xo = body.x
    body.yo = body.y
    body.zo = body.z
}

fn place_of(e: Entity) -> (f64, f64, f64) {
    return match e {
        Entity.Item(i) => (i.body.x, i.body.y, i.body.z),
        Entity.Orb(o) => (o.body.x, o.body.y, o.body.z),
        Entity.Stand(a) => (a.living.body.x, a.living.body.y, a.living.body.z),
        Entity.Mob(m) => (m.living.body.x, m.living.body.y, m.living.body.z),
        Entity.Arrow(a) => (a.body.x, a.body.y, a.body.z),
        Entity.Thrown(p) => (p.body.x, p.body.y, p.body.z),
        Entity.Cloud(c) => (c.body.x, c.body.y, c.body.z),
        Entity.Crystal(c) => (c.body.x, c.body.y, c.body.z),
        Entity.Eye(eye) => (eye.body.x, eye.body.y, eye.body.z),
        Entity.Fireball(b) => (b.body.x, b.body.y, b.body.z),
        Entity.Tnt(p) => (p.body.x, p.body.y, p.body.z),
    }
}

// The line `--entity-trace` writes for the entity, a mob's or an armor stand's, at the game time
// `time` (CAL-159).
fn traced(time: i64, e: Entity) -> String {
    return match e {
        Entity.Stand(a) => "{time} {a.living.body.id} {a.living.body.x} {a.living.body.y} {a.living.body.z} {a.living.body.vx} {a.living.body.vy} {a.living.body.vz} {a.living.body.y_rot} {a.living.body.x_rot} {a.living.y_head_rot} {a.living.y_body_rot} {a.living.zza} {a.living.xxa} {a.living.speed} {a.living.body.on_ground}\n",
        Entity.Mob(a) => "{time} {a.living.body.id} {a.living.body.x} {a.living.body.y} {a.living.body.z} {a.living.body.vx} {a.living.body.vy} {a.living.body.vz} {a.living.body.y_rot} {a.living.body.x_rot} {a.living.y_head_rot} {a.living.y_body_rot} {a.living.zza} {a.living.xxa} {a.living.speed} {a.living.body.on_ground}\n",
        _ => String(),
    }
}

// The entity's box.
// The item `e`, of the ID `id`, as a brain sees it (CAL-160).
fn item_near(id: i32, e: ItemEntity) -> Near {
    return Near { id: id, uuid: e.body.uuid, species: ITEM, x: e.body.x, y: e.body.y, z: e.body.z, eyes: e.body.eyes, bounds: e.body.bounding_box() }
}

fn box_of(e: Entity) -> Aabb {
    return match e {
        Entity.Item(i) => i.body.bounding_box(),
        Entity.Orb(o) => o.body.bounding_box(),
        Entity.Stand(a) => a.living.body.bounding_box(),
        Entity.Mob(m) => m.living.body.bounding_box(),
        Entity.Arrow(a) => a.body.bounding_box(),
        Entity.Thrown(p) => p.body.bounding_box(),
        Entity.Cloud(c) => c.body.bounding_box(),
        Entity.Crystal(c) => c.body.bounding_box(),
        Entity.Eye(eye) => eye.body.bounding_box(),
        Entity.Fireball(b) => b.body.bounding_box(),
        Entity.Tnt(p) => p.body.bounding_box(),
    }
}

// The body's nether portal, where it's in it and may go through it, `allowed`, put in `out`
// (D578).
fn due_of(out: mut List<PortalDue>, b: Body, allowed: bool) {
    if not allowed {
        return
    }
    let p = b.portal_process else return
    if p.inside {
        out.push(PortalDue { id: b.id, x: b.x, y: b.y, z: b.z, width: b.width, height: b.height, fall: b.fall, portal: p })
    }
}

// The entity told whether its level's nether portals may take it, `open` (D578), and its end
// portals, `end` (D587).
fn opened(e: own Entity, open: bool, end: bool) -> Entity {
    return match e {
        Entity.Item(i) => {
            var it = i
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Item(it)
        },
        Entity.Orb(o) => {
            var it = o
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Orb(it)
        },
        Entity.Stand(a) => {
            var it = a
            it.living.body.portal_open = open
            it.living.body.end_open = end
            Entity.Stand(it)
        },
        Entity.Mob(m) => {
            var it = m
            it.living.body.portal_open = open
            it.living.body.end_open = end
            Entity.Mob(it)
        },
        Entity.Arrow(a) => {
            var it = a
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Arrow(it)
        },
        Entity.Thrown(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Thrown(it)
        },
        Entity.Cloud(c) => Entity.Cloud(c),
        Entity.Crystal(c) => {
            var it = c
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Crystal(it)
        },
        // Never inside what it's in, so through no portal (D598).
        Entity.Eye(eye) => Entity.Eye(eye),
        Entity.Fireball(b) => {
            var it = b
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Fireball(it)
        },
        Entity.Tnt(p) => {
            var it = p
            it.body.portal_open = open
            it.body.end_open = end
            Entity.Tnt(it)
        },
    }
}

// What an explosion asks of the entity of `body`, of the kind `kind` (CAL-182).
fn reached_body(body: Body, kind: i32, invisible: bool, resistance: f64) -> Reached {
    return Reached { id: body.id, bounds: body.bounding_box(), x: body.x, y: body.y, z: body.z, eyes: f64(body.eyes), mover: body.mover(), kind: kind, invisible: invisible, resistance: resistance }
}

// The same of what an explosion pushes from where it stands, as primed TNT (CAL-182).
fn reached_feet(body: Body, kind: i32) -> Reached {
    return Reached { id: body.id, bounds: body.bounding_box(), x: body.x, y: body.y, z: body.z, eyes: 0.0, mover: body.mover(), kind: kind, invisible: false, resistance: 0.0 }
}

// The entity pushed by x, y, z, `Entity.push` (CAL-182), but an arrow in the ground,
// `AbstractArrow.push`, as one lodged in the TNT it lit is.
fn pushed_by(e: own Entity, x: f64, y: f64, z: f64) -> Entity {
    return match e {
        Entity.Item(i) => {
            var it = i
            it.body.push(x, y, z)
            Entity.Item(it)
        },
        Entity.Orb(o) => {
            var it = o
            it.body.push(x, y, z)
            Entity.Orb(it)
        },
        Entity.Stand(a) => {
            var it = a
            it.living.body.push(x, y, z)
            Entity.Stand(it)
        },
        Entity.Mob(m) => {
            var it = m
            it.living.body.push(x, y, z)
            Entity.Mob(it)
        },
        Entity.Arrow(a) => {
            var it = a
            if not it.in_ground() {
                it.body.push(x, y, z)
            }
            Entity.Arrow(it)
        },
        Entity.Thrown(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Thrown(it)
        },
        Entity.Cloud(c) => {
            var it = c
            it.body.push(x, y, z)
            Entity.Cloud(it)
        },
        Entity.Crystal(c) => {
            var it = c
            it.body.push(x, y, z)
            Entity.Crystal(it)
        },
        Entity.Eye(eye) => {
            var it = eye
            it.body.push(x, y, z)
            Entity.Eye(it)
        },
        Entity.Fireball(b) => {
            var it = b
            it.body.push(x, y, z)
            Entity.Fireball(it)
        },
        Entity.Tnt(p) => {
            var it = p
            it.body.push(x, y, z)
            Entity.Tnt(it)
        },
    }
}

// When the entity came into its level.
fn entered_of(e: Entity) -> u64 {
    return match e {
        Entity.Item(i) => i.body.entered,
        Entity.Orb(o) => o.body.entered,
        Entity.Stand(a) => a.living.body.entered,
        Entity.Mob(m) => m.living.body.entered,
        Entity.Arrow(a) => a.body.entered,
        Entity.Thrown(p) => p.body.entered,
        Entity.Cloud(c) => c.body.entered,
        Entity.Crystal(c) => c.body.entered,
        Entity.Eye(eye) => eye.body.entered,
        Entity.Fireball(b) => b.body.entered,
        Entity.Tnt(p) => p.body.entered,
    }
}

// `stack` with `n` of it, 0 or less leaving a stack that's nothing, as `setCount` does.
fn counted(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

// `SectionPos.posToSectionCoord`.
fn section(v: f64) -> i32 {
    return i32.saturate(v.floor()) >> 4
}

// The section of the block at x, y, z, `SectionPos.asLong`.
fn section_key(x: f64, y: f64, z: f64) -> i64 {
    return pack(section(x), section(y), section(z))
}

// The chunk of the section `SectionPos.asLong` packed in `key`.
fn section_chunk(key: i64) -> ChunkPos {
    return ChunkPos { x: i32.wrap(key >> 42), z: i32.wrap((key << 22) >> 42) }
}

/// `SectionPos.asLong`.
pub fn pack(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 4194303) << 42) | (i64(y) & 1048575) | ((i64(z) & 4194303) << 20)
}

// The square of the distance from `a` to `b`, `distanceToSqr`.
fn distance_sqr(a: (f64, f64, f64), b: (f64, f64, f64)) -> f64 {
    let (ax, ay, az) = a
    let (bx, by, bz) = b
    let (dx, dy, dz) = (bx - ax, by - ay, bz - az)
    return dx * dx + dy * dy + dz * dz
}

// `AABB.expandTowards`: the box `b` stretched toward the side each of `xa`, `ya` and `za` goes.
fn expand_towards(b: Aabb, xa: f64, ya: f64, za: f64) -> Aabb {
    var out = b
    if xa < 0.0 {
        out.min_x += xa
    } else if xa > 0.0 {
        out.max_x += xa
    }
    if ya < 0.0 {
        out.min_y += ya
    } else if ya > 0.0 {
        out.max_y += ya
    }
    if za < 0.0 {
        out.min_z += za
    } else if za > 0.0 {
        out.max_z += za
    }
    return out
}

// Whether `getManyEntityHitResult`, taking in the box the way starts in, has the way from `from`
// to `to` meet the box `b` within `margin` (CAL-159): `from` within it, the way through it, or,
// with a margin, through it that much larger, and from there toward its middle, `getCenter`, up
// to the first block `mover` collides with or the world border `border`, through it.
fn meets_way<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, mover: Mover, border: (f64, f64, f64, f64), b: Aabb, from: (f64, f64, f64), to: (f64, f64, f64), margin: f64) -> bool {
    let (fx, fy, fz) = from
    if fx >= b.min_x and fx < b.max_x and fy >= b.min_y and fy < b.max_y and fz >= b.min_z and fz < b.max_z {
        return true
    }
    if box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, from, to) != none {
        return true
    }
    if margin <= 0.0 {
        return false
    }
    let outside = box_clip(b.min_x - margin, b.min_y - margin, b.min_z - margin, b.max_x + margin, b.max_y + margin, b.max_z + margin, from, to) else return false
    var towards = (b.min_x + 0.5 * (b.max_x - b.min_x), b.min_y + 0.5 * (b.max_y - b.min_y), b.min_z + 0.5 * (b.max_z - b.min_z))
    let way = clip_including_border(f, m, blocks, mover, outside, towards, border)
    if not way.missed {
        towards = (way.x, way.y, way.z)
    }
    return box_clip(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z, outside, towards) != none
}
