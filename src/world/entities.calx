    /// The living entity of the UUID `uuid` here, a mob or an armor stand, not gone, by its ID,
    /// as `EntityReference.getLivingEntity` finds an owner (CAL-200).
    pub fn living_by_uuid(self, uuid: (i64, i64)) -> i32? {
        for slot in self.all {
            let e = slot else continue
            match e {
                Entity.Mob(m) => {
                    if m.living.body.uuid == uuid and not m.living.body.removed {
                        return some(m.living.body.id)
                    }
                },
                Entity.Stand(s) => {
                    if s.living.body.uuid == uuid and not s.living.body.removed {
                        return some(s.living.body.id)
                    }
                },
                _ => {},
            }
        }
        return none
    }

