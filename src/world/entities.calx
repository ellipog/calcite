    pub x: f64
    pub y: f64
    pub z: f64
    pub top: f64
    pub yaw: f32
    pub gone: bool
    pub animal: bool
    pub horse: bool = false
    pub bottom: f64 = 0.0
    pub width: f32 = 0.0f32
    pub left: bool = false
    // What it rode, by its ID, and what rides that still (CAL-179).
    pub vehicle: i32 = -1
    pub left_riding: List<i32> = List<i32>()
    // Whether what it rode is a boat, and where the rider looks, which a boat puts it off toward
