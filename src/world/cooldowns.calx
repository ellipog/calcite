/// A player's item cooldowns, vanilla's `ItemCooldowns` as `ServerItemCooldowns` runs it for a
/// player (D579): by cooldown group, an item's `use_cooldown`'s `cooldown_group` or else its ID,
/// `getCooldownGroup`, the tick each began and ends at, of the cooldowns' own count of ticks,
/// `tickCount`. They're held as vanilla's `HashMap` keyed by `Identifier` holds them, so those
/// that end on the same tick end in its order: by bucket, `31 * namespace.hashCode() +
/// path.hashCode()` spread, `HashMap.hash`, over its table, 16 at first and doubled once it's
/// more than three quarters full, never shrunk; and in a bucket, in the order they were put in,
/// a group put in again keeping its place. The caller tells the client of each that starts and
/// ends, `ClientboundCooldownPacket`.
module world.cooldowns

import java.text.{string_hash}

/// A group's cooldown, `CooldownInstance`: its group's ID, and the ticks it began and ends at.
pub struct Cooldown {
    pub group: String
    pub start: i32
    pub end: i32
}

/// A player's item cooldowns, `ItemCooldowns`.
pub struct ItemCooldowns {
    /// Its count of ticks, `tickCount`.
    pub ticks: i32 = 0
    /// Its groups' cooldowns, in the order they were put in.
    pub entries: List<Cooldown> = List<Cooldown>()
    // Its map's table, as large as it's grown.
    capacity: i32 = 16
}

impl ItemCooldowns {
    /// How much of the group's cooldown is left, `getCooldownPercent` with no part of a tick:
    /// what's left over how long it is, as floats, within 0 and 1; none where it has none.
    pub fn left(self, group: String) -> f32 {
        for c in self.entries {
            if c.group == group {
                let duration = f32.nearest(c.end - c.start)
                let remaining = f32.nearest(c.end) - (f32.nearest(self.ticks) + 0.0f32)
                let part = remaining / duration
                // `Mth.clamp`, as a part that isn't a number stays one.
                return if part < 0.0f32 { 0.0f32 } else if part > 1.0f32 { 1.0f32 } else { part }
            }
        }
        return 0.0f32
    }

    /// Whether the group's on cooldown, `isOnCooldown`: some of it left.
    pub fn on_cooldown(self, group: String) -> bool {
        return self.left(group) > 0.0f32
    }

    /// `addCooldown` of the group for `time` ticks, from now: where it had one, in its place,
    /// else last, its map grown where it's more than three quarters full.
    pub fn add(mut self, group: String, time: i32) {
        let c = Cooldown { group: group.copy(), start: self.ticks, end: self.ticks + time }
        for i in 0..self.entries.len() {
            if self.entries[i].group == group {
                self.entries[i] = c
                return
            }
        }
        self.entries.push(c)
        if self.entries.len() > usize.wrap(self.capacity) * 3 / 4 {
            self.capacity = self.capacity * 2
        }
    }

    /// `removeCooldown` of the group: gone, if it was there; the client's told it ended either way.
    pub fn remove(mut self, group: String) {
        var kept = List<Cooldown>()
        for c in self.entries {
            if c.group != group {
                kept.push(c.copy())
            }
        }
        self.entries = kept
    }

    /// `tick`: a tick more, then each group whose cooldown's ended by now taken off, in its map's
    /// order. The groups taken off, for the client to be told they ended.
    pub fn tick(mut self) -> List<String> {
        self.ticks += 1
        var ended = List<String>()
        if self.entries.is_empty() {
            return ended
        }
        let mask = self.capacity - 1
        // Each bucket's in the order its groups were put in, a stable order by bucket.
        var order = List<(i32, usize)>()
        for i in 0..self.entries.len() {
            let b = bucket(self.entries[i].group) & mask
            var k = order.len()
            while k > 0 and order[k - 1].0 > b {
                k -= 1
            }
            order.insert(k, (b, i))
        }
        var gone = List<bool>()
        for _ in 0..self.entries.len() {
            gone.push(false)
        }
        for (_, i) in order {
            if self.entries[i].end <= self.ticks {
                gone[i] = true
                ended.push(self.entries[i].group.copy())
            }
        }
        var kept = List<Cooldown>()
        for i in 0..self.entries.len() {
            if not gone[i] {
                kept.push(self.entries[i].copy())
            }
        }
        self.entries = kept
        return ended
    }
}

/// The ticks a `use_cooldown` of `seconds` lasts, `UseCooldown.ticks`: as many as there are in
/// it, a float, its part of a tick dropped, `(int)`, its seconds being more than none.
pub fn cooldown_ticks(seconds: f32) -> i32 {
    return i32.saturate(f64(seconds * 20.0f32).floor())
}

// The group's hash as `HashMap.hash` spreads it: `Identifier.hashCode`, its namespace's and path's,
// a group with no namespace in `minecraft`, its top half over its bottom.
fn bucket(group: String) -> i32 {
    var namespace = String("minecraft")
    var path = group.copy()
    if let c = group.find(":") {
        namespace = group[..c]
        path = group[c + 1..]
    }
    let h = string_hash(namespace).wrapping_mul(31).wrapping_add(string_hash(path))
    return h ^ i32.wrap(u32.wrap(h) >> 16)
}
