/// A minecart, as vanilla's `AbstractMinecart` makes and runs it with `OldMinecartBehavior`, the
/// behaviour where the `minecart_improvements` feature is off (CAL-315): 0.98 by 0.7, falling 0.04
/// a tick, 0.005 in water; its values `Entity`'s, `VehicleEntity`'s and its own, `minecart_data`;
/// the item it drops, `minecraft:minecart`. A chest minecart, `MinecartChest`, holds 27 slots, or
/// a loot table they're yet to be filled from, as a chest boat does, `AbstractMinecartContainer`;
/// it shows a chest 8 up, slows as it's emptier, and isn't ridden. A furnace minecart,
/// `MinecartFurnace`, isn't ridden either: given coal or charcoal it burns 3600 ticks more, up to
/// 32000, and pushes itself away from who gave it, at half the speed, three quarters in water.
/// A TNT minecart, `MinecartTNT`, primed burns 80 ticks, or 0 to 38 where it's broken, and blows up
/// as it runs out, as it hits something going fast enough, or as it lands from 3 or more.
///
/// Each tick, as `ServerLevel.tickNonPassenger` and `AbstractMinecart.tick` run it, without
/// `Entity.baseTick`: its hurt time and damage a tick less; gone 64 below the world; its speed,
/// `computeSpeed`; its portal; then its behaviour's tick: its fall, then along the rail it's on or
/// just above, `moveAlongTrack`, or off the track, `comeOffTrack`; what the blocks where it is do
/// to it; its turn to the way it went, flipped where it turned round; and then its level takes in
/// or pushes what's about it, `pushAndPickupEntities`. Last the fluids it's in, and lava setting it
/// alight and hurting it.
///
/// It's hurt as `VehicleEntity.hurtServer` has it, as a boat is, but its damage grows by ten
/// times what it already has as it's rocked, `AbstractMinecart.animateHurt`.
module world.minecart

import nbt.tag.{Tag}
import server.log.{Entry}
import math.mth.{table_atan2}
import world.analog_output.{slots_signal}
import world.boat.{chest_read, slotted}
import world.body.{BLOCKS_SOURCE, Body, BodyFacts, EntitySound, PORTAL_DELAY, bool_or, int_or}
import world.collision.{CollisionBlocks}
import world.damage.{BYPASSES_INVULNERABILITY, DamageTypes, IS_EXPLOSION, IS_FIRE}
import world.living.{Blast}
import world.entity_data.{BOOLEAN, AIR_SUPPLY, CART_FUEL, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, SHARED_FLAGS, SILENT, TICKS_FROZEN, VEHICLE_DAMAGE, VEHICLE_HURT, VEHICLE_HURT_DIR, Value, minecart_data}
import world.inside.{Acted, BlockEffect, CLEAR_FREEZE, Collector, EXTINGUISH, FIRE_IGNITE, FREEZE, Gateways, LAVA_IGNITE, Movement, Rain, Touched, bubble_open_above, fluid_effects, inside_blocks, touch_block}
import world.movement.{MovementStates}
import world.rails.{is_rail, rail_shape}
import worldgen.facts.{Facts}

// `RailShape`'s values, by their ordinals, as `world.rails` has them.
const NORTH_SOUTH: i32 = 0
const EAST_WEST: i32 = 1
const ASCENDING_EAST: i32 = 2
const ASCENDING_WEST: i32 = 3
const ASCENDING_NORTH: i32 = 4
const ASCENDING_SOUTH: i32 = 5

/// The minecarts' types that Calcite makes, by name.
pub fn minecart_kinds() -> List<str> {
    return ["minecraft:minecart", "minecraft:chest_minecart", "minecraft:furnace_minecart", "minecraft:tnt_minecart", "minecraft:hopper_minecart"]
}

/// Whether `name` is a minecart's type Calcite makes.
pub fn is_minecart_kind(name: String) -> bool {
    for k in minecart_kinds() {
        if name == k {
            return true
        }
    }
    return false
}

/// `AbstractMinecart.EXITS`: the two ways out of a rail of the shape `s`, each x, y, z.
pub fn exits(s: i32) -> ((i32, i32, i32), (i32, i32, i32)) {
    if s == NORTH_SOUTH {
        return ((0, 0, -1), (0, 0, 1))
    }
    if s == EAST_WEST {
        return ((-1, 0, 0), (1, 0, 0))
    }
    if s == ASCENDING_EAST {
        return ((-1, -1, 0), (1, 0, 0))
    }
    if s == ASCENDING_WEST {
        return ((-1, 0, 0), (1, -1, 0))
    }
    if s == ASCENDING_NORTH {
        return ((0, 0, -1), (0, -1, 1))
    }
    if s == ASCENDING_SOUTH {
        return ((0, -1, -1), (0, 0, 1))
    }
    if s == 6 {
        return ((0, 0, 1), (1, 0, 0))
    }
    if s == 7 {
        return ((0, 0, 1), (-1, 0, 0))
    }
    if s == 8 {
        return ((0, 0, -1), (-1, 0, 0))
    }
    return ((0, 0, -1), (1, 0, 0))
}

/// What a minecart's tick leaves its level to do with it.
pub struct CartTicked {
    /// Whether it's to take in or push what's about it, `pushAndPickupEntities`, as it's done
    /// moving.
    pub push: bool = false
    /// Whether an activator rail it's on is powered, and so it lets its riders go,
    /// `Minecart.activateMinecart`.
    pub eject: bool = false
}

/// A minecart.
pub struct Minecart {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s and its own.
    pub body: Body
    pub data: EntityData
    /// Its type, as `minecraft:minecart`.
    pub kind: String
    /// Whether it's turned round from the way it last went, `flipped`.
    pub flipped: bool = false
    /// Whether it was on a rail as its tick last found, `onRails`.
    pub on_rails: bool = false
    /// The block it shows, as it was saved, `DisplayState`, and how far up, `DisplayOffset`.
    display: Tag? = none
    display_offset: i32? = none
    /// Its leash as it was read, saved back as it was.
    pub leash: Tag? = none
    /// A chest minecart's 27 slots, or a hopper minecart's 5, `itemStacks`, each a stack as it's
    /// saved or none, and the loot table it's yet to be filled from and its seed, `lootTable` and
    /// `lootTableSeed`.
    pub items: List<Tag?> = List<Tag?>()
    pub loot_table: String? = none
    pub loot_seed: i64 = 0
    /// A furnace minecart's fuel, in ticks, `fuel`, and its push, `push`.
    pub fuel: i32 = 0
    /// Whether a hopper minecart takes in items, `enabled`: not while it's on a powered activator
    /// rail (CAL-388).
    pub enabled: bool = true
    pub push_x: f64 = 0.0
    pub push_y: f64 = 0.0
    pub push_z: f64 = 0.0
    /// A TNT minecart's fuse, -1 where it isn't primed, `fuse`; what its explosion's power starts
    /// from and grows by with its speed, `explosionPowerBase` and `explosionSpeedFactor`; whether
    /// what primed it was something, `ignitionSource`, and who, by UUID, where someone was; the game
    /// rule `tnt_explodes`, as its level last gave it; whether it's just been primed, for what
    /// hurt it to show; and the blasts its tick set off, for its level.
    pub fuse: i32 = -1
    pub power_base: f32 = 4.0f32
    pub speed_factor: f32 = 1.0f32
    pub ignited: bool = false
    pub ignited_by: (i64, i64)? = none
    pub tnt_explodes: bool = true
    pub primed_now: bool = false
    pub blasts: List<Blast> = List<Blast>()
    /// What its tick had its level do, each after so many of the tick's sounds.
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
}

impl Minecart {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z, of the type `kind`.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, kind: own String) -> Minecart {
        let body = Body.made(id, seed, x, y, z, 0.98f32, 0.7f32, 0.595f32, 0.04)
        let offset = default_offset(kind)
        var c = Minecart { body: body, data: minecart_data(offset), kind: kind }
        if c.has_chest() {
            for _ in 0..c.slot_count() {
                c.items.push(none)
            }
        }
        if c.is_furnace() {
            c.data.define(BOOLEAN, Value.Bool(false))
        }
        return c
    }

    /// Whether it's a TNT minecart, `MinecartTNT`.
    pub fn is_tnt(self) -> bool {
        return self.kind == "minecraft:tnt_minecart"
    }

    /// `MinecartTNT.primeFuse`, by something where `sourced`, `by` the one of that UUID where
    /// someone: where the game rule `tnt_explodes` is on, its fuse 80, what primed it kept where
    /// nothing had, `primed_now` for its event 70 and `entity.tnt.primed` to be shown.
    pub fn prime(mut self, sourced: bool, by: (i64, i64)?) {
        if not self.tnt_explodes {
            return
        }
        self.fuse = 80
        if sourced and not self.ignited {
            self.ignited = true
            self.ignited_by = by
        }
        self.primed_now = true
    }

    // What `prime` left to show, in its tick: its event 70, `broadcastEntityEvent`, then its sound
    // where it isn't silent, `TNT_PRIMED` among the blocks.
    fn show_primed(mut self, sounds: mut List<EntitySound>) {
        if not self.primed_now {
            return
        }
        self.primed_now = false
        self.act(Acted.Event(70i8), sounds.len())
        if not self.silent() {
            sounds.push(EntitySound { sound: String("entity.tnt.primed"), x: self.body.x, y: self.body.y, z: self.body.z, volume: 1.0f32, pitch: 1.0f32, source: BLOCKS_SOURCE })
        }
    }

    // `MinecartTNT.explode` with its speed squared `speed_sqr`: where the game rule `tnt_explodes`
    // is on, a blast of its power and 1.5 of its speed's factor more for each of its speed to 5, a
    // draw of its random, then it's gone, `discard`, after; else gone where it's primed.
    fn explode(mut self, speed_sqr: f64) {
        if self.tnt_explodes {
            let speed = speed_sqr.sqrt().min(5.0)
            let power = f32.nearest(f64(self.power_base) + f64(self.speed_factor) * self.body.random.next_double() * 1.5 * speed)
            let (x, y, z) = (self.body.x, self.body.y, self.body.z)
            self.blasts.push(Blast { at: (x, y, z), x: x, y: y, z: z, power: power, portal: false, owner: self.ignited_by, silent: self.silent(), cart: true, rails: self.fuse > -1 })
            self.body.removed = true
        } else if self.fuse > -1 {
            self.body.removed = true
        }
    }

    // `MinecartTNT.causeFallDamage` of a fall it landed from this tick, `fell_on`, as the block it
    // landed on passes it on, `fallOn`: from 3 or more it blows up with a tenth of it squared.
    fn tnt_fell(mut self, f: Facts, m: MovementStates) {
        let (fell, on) = self.body.fell_on.take() else return
        if not self.is_tnt() {
            return
        }
        let block = f.block(on)
        if f.is_a(block, String("PowderSnowBlock")) {
            return
        }
        var distance = fell * f64(1.0f32 - m.fall_reduction(block))
        if f.is_a(block, String("HayBlock")) or f.is_a(block, String("HoneyBlock")) or f.is_a(block, String("SlimeBlock")) {
            distance = fell
        } else if f.is_a(block, String("PointedDripstoneBlock")) {
            let up = f.get_name(on, String("vertical_direction")) == some(String("up"))
            let tip = f.get_name(on, String("thickness")) == some(String("tip"))
            if up and tip {
                distance = fell + 2.5
            }
        }
        if distance >= 3.0 {
            let p = distance / 10.0
            self.explode(p * p)
        }
    }

    /// Whether it's a furnace minecart, `isFurnace`.
    pub fn is_furnace(self) -> bool {
        return self.kind == "minecraft:furnace_minecart"
    }

    /// `MinecartFurnace.addFuel` from a player at `px`, `pz` holding fuel, `#furnace_minecart_fuel`:
    /// where 3600 more ticks fit under 32000, burned that much more and pushed away from them,
    /// across. Whether it took it.
    pub fn add_fuel(mut self, px: f64, pz: f64) -> bool {
        if self.fuel + 3600 > 32000 {
            return false
        }
        self.fuel += 3600
        if self.fuel > 0 {
            self.push_x = self.body.x - px
            self.push_y = 0.0
            self.push_z = self.body.z - pz
        }
        return true
    }

    /// Whether it holds items, a chest or hopper minecart, `AbstractMinecartContainer`.
    pub fn has_chest(self) -> bool {
        return self.kind == "minecraft:chest_minecart" or self.is_hopper()
    }

    /// Whether it's a hopper minecart, `MinecartHopper` (CAL-388).
    pub fn is_hopper(self) -> bool {
        return self.kind == "minecraft:hopper_minecart"
    }

    /// How many slots it holds, `getContainerSize`: a hopper minecart's 5, else 27.
    pub fn slot_count(self) -> usize {
        return if self.is_hopper() { 5usize } else { 27usize }
    }

    /// The minecart its item places at x, y, z, `MinecartItem.useOn` and `createMinecart`:
    /// `setInitialPos`, where it was before its first tick there too.
    pub fn placed(id: i32, seed: i64, x: f64, y: f64, z: f64, kind: own String) -> Minecart {
        var c = Minecart.made(id, seed, x, y, z, kind)
        c.body.xo = x
        c.body.yo = y
        c.body.zo = z
        return c
    }

    /// Its type's name, `EntityType.getKey`.
    pub fn type_name(self) -> str {
        for k in minecart_kinds() {
            if self.kind == k {
                return k
            }
        }
        return "minecraft:minecart"
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// `Minecart.isRideable`.
    pub fn rideable(self) -> bool {
        return self.kind == "minecraft:minecart"
    }

    /// `canAddPassenger`: none rides it yet.
    pub fn has_room(self) -> bool {
        return self.body.passengers.is_empty()
    }


    // `getGravity`: 0.005 in water, else 0.04, none where it has no gravity.
    fn gravity(self) -> f64 {
        if self.body.no_gravity {
            return 0.0
        }
        return if self.body.in_water { 0.005 } else { 0.04 }
    }

    // `getMaxSpeed`: 0.2 in water, else 0.4; a furnace minecart's three quarters of that in
    // water, else half.
    fn max_speed(self) -> f64 {
        let base = if self.body.in_water { 0.2 } else { 0.4 }
        if self.is_furnace() {
            return if self.body.in_water { base * 0.75 } else { base * 0.5 }
        }
        return base
    }

    // `applyNaturalSlowdown`: its speed across by `getSlowdownFactor`, then 0.95 as much in water,
    // none up; a chest minecart's, `AbstractMinecartContainer`'s, by 0.98, and where it has no loot
    // table a thousandth more for each step of the 15 its slots are short of full, then by 0.95 in
    // water, in floats.
    fn natural_slowdown(mut self, f: Facts) {
        if self.has_chest() {
            var keep = 0.98f32
            if self.loot_table == none {
                let emptiness = 15 - slots_signal(f, self.items)
                keep = keep + f32.nearest(emptiness) * 0.001f32
            }
            if self.body.in_water {
                keep = keep * 0.95f32
            }
            self.body.vx = self.body.vx * f64(keep)
            self.body.vy = 0.0
            self.body.vz = self.body.vz * f64(keep)
            return
        }
        if self.is_furnace() {
            // `MinecartFurnace.applyNaturalSlowdown`: pushed, its push turned along the way it
            // goes, `calculateNewPushAlong`, it slowed to 0.8 across and the push added, a tenth of
            // that in water; else slowed to 0.98 across; then as any minecart.
            let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
            let (px, py, pz) = (self.push_x, self.push_y, self.push_z)
            if px * px + py * py + pz * pz > 1.0e-7 {
                let moving = vx * vx + vz * vz
                if px * px + pz * pz > 1.0e-4 and moving > 0.001 {
                    let k = (px * vx + py * vy + pz * vz) / (vx * vx + vy * vy + vz * vz)
                    let (jx, jy, jz) = (vx * k, vy * k, vz * k)
                    let jl = (jx * jx + jy * jy + jz * jz).sqrt()
                    let length = (px * px + py * py + pz * pz).sqrt()
                    if jl < f64(1.0e-5f32) {
                        self.push_x = 0.0
                        self.push_y = 0.0
                        self.push_z = 0.0
                    } else {
                        self.push_x = jx / jl * length
                        self.push_y = jy / jl * length
                        self.push_z = jz / jl * length
                    }
                }
                var nx = vx * 0.8 + self.push_x
                var ny = vy * 0.0 + self.push_y
                var nz = vz * 0.8 + self.push_z
                if self.body.in_water {
                    nx = nx * 0.1
                    ny = ny * 0.1
                    nz = nz * 0.1
                }
                self.body.vx = nx
                self.body.vy = ny
                self.body.vz = nz
            } else {
                self.body.vx = vx * 0.98
                self.body.vy = vy * 0.0
                self.body.vz = vz * 0.98
            }
        }
        let slow = self.slowdown()
        self.body.vx = self.body.vx * slow
        self.body.vy = 0.0
        self.body.vz = self.body.vz * slow
        if self.body.in_water {
            let w = f64(0.95f32)
            self.body.vx = self.body.vx * w
            self.body.vz = self.body.vz * w
        }
    }

    // `getSlowdownFactor`: 0.997 with a rider, else 0.96.
    fn slowdown(self) -> f64 {
        return if self.body.passengers.is_empty() { 0.96 } else { 0.997 }
    }

    /// Its tick among `blocks`, as `tickNonPassenger` and `AbstractMinecart.tick` run it, in a
    /// level whose floor is `min_y`, where lava's fast if `fast_lava`, its hurts of `types`; its
    /// first rider's move as their client last said, `intent`, where a player rides it; its item
    /// dropped where it breaks if `drops`.
    pub fn tick<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, blocks: B, min_y: i32, intent: (f64, f64, f64)?, drops: bool, sounds: mut List<EntitySound>) -> CartTicked {
        var out = CartTicked()
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        let y_rot_o = self.body.y_rot
        self.body.tick_count += 1
        self.body.fell_on = none
        let hurt_time = self.data.number(VEHICLE_HURT)
        if hurt_time > 0 {
            self.data.set(VEHICLE_HURT, Value.Number(hurt_time - 1))
        }
        let damage = self.data.float(VEHICLE_DAMAGE)
        if damage > 0.0f32 {
            self.data.set(VEHICLE_DAMAGE, Value.Float(damage - 1.0f32))
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
            return out
        }
        self.body.compute_speed()
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        let alive = not self.body.removed
        if let p = self.body.portal_goes(alive, PORTAL_DELAY) {
            if p.gateway {
                if let done = self.body.gateway_goes(p, blocks, false, true) {
                    self.act(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.body.travel(p, saved)
                self.act(Acted.Travel(way), sounds.len())
            }
        }
        // `OldMinecartBehavior.tick`.
        self.body.vy = self.body.vy - self.gravity()
        let (rx, ry, rz) = self.rail_pos(f, blocks)
        let state = blocks.collision_state(rx, ry, rz) ?? 0
        self.on_rails = is_rail(f, state)
        if self.on_rails {
            self.move_along_track(f, m, t, blocks, rx, ry, rz, state, intent)
            if f.block_named(String("minecraft:activator_rail")) == some(f.block(state)) {
                // `activateMinecart`: the plain minecart's riders let go and it rocked, a TNT
                // minecart primed, where the rail's powered; the others do nothing.
                let powered = f.get_bool(state, "powered")
                if powered and self.kind == "minecraft:minecart" {
                    out.eject = true
                    self.activated()
                } else if powered and self.is_tnt() and self.fuse < 0 {
                    self.prime(false, none)
                    self.show_primed(mut sounds)
                } else if self.is_hopper() {
                    // `MinecartHopper.activateMinecart`: taking in items but where it's powered.
                    self.enabled = not powered
                }
            }
        } else {
            self.come_off_track(f, m, t, blocks)
        }
        self.tnt_fell(f, m)
        // What the blocks where it is do to it, `applyEffectsFromBlocks(position, position)`, its
        // moves this tick then forgotten.
        let here = (self.body.x, self.body.y, self.body.z)
        var moves = List<Movement>()
        moves.push(Movement { from: here, to: here })
        self.blocks_act(f, t, types, blocks, moves, drops, mut sounds)
        self.body.x_rot = 0.0f32
        let dx = self.body.xo - self.body.x
        let dz = self.body.zo - self.body.z
        if dx * dx + dz * dz > 0.001 {
            self.body.y_rot = f32.nearest((table_atan2(dz, dx) ?? 0.0) * 180.0 / 3.141592653589793)
            if self.flipped {
                self.body.y_rot = self.body.y_rot + 180.0f32
            }
        }
        let turn = wrap_degrees(f64(self.body.y_rot - y_rot_o))
        if turn < -170.0 or turn >= 170.0 {
            self.body.y_rot = self.body.y_rot + 180.0f32
            self.flipped = not self.flipped
        }
        self.body.x_rot = self.body.x_rot % 360.0f32
        self.body.y_rot = self.body.y_rot % 360.0f32
        out.push = true
        return out
    }

    /// The rest of its tick after its level took in or pushed what's about it, `tick_end`: the
    /// fluids it's in, `updateFluidInteraction`, then in lava set alight, `lavaIgnite`, hurt by 4,
    /// heard burning, `lavaHurt`, and its fall halved; and its first tick over.
    pub fn tick_end<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, types: DamageTypes, blocks: B, fast_lava: bool, drops: bool, sounds: mut List<EntitySound>) {
        _ = self.body.update_fluids(f, t, blocks, fast_lava, true, mut sounds)
        if self.body.in_lava() {
            self.body.ignite_for(300)
            if self.hurt(types, types.id("lava"), 4.0f32, false, drops, none, sounds.len()) and not self.silent() {
                let pitch = 2.0f32 + self.body.random.next_float() * 0.4f32
                sounds.push(EntitySound { sound: String("entity.generic.burn"), x: self.body.x, y: self.body.y, z: self.body.z, volume: 0.4f32, pitch: pitch, source: self.body.sound_source })
            }
            self.body.fall = self.body.fall * 0.5
            self.spilled_unmade(sounds.len())
        }
        self.body.first_tick = false
        if self.is_furnace() {
            // `MinecartFurnace.tick` after its own: its fuel burned, its push gone with it, and
            // whether it has fuel set; where it has, a draw for the smoke its clients make.
            if self.fuel > 0 {
                self.fuel -= 1
            }
            if self.fuel <= 0 {
                self.push_x = 0.0
                self.push_y = 0.0
                self.push_z = 0.0
            }
            self.data.set(CART_FUEL, Value.Bool(self.fuel > 0))
            if self.fuel > 0 {
                _ = self.body.random.next_int_below(4)
            }
        }
        if self.is_tnt() {
            // `MinecartTNT.tick` after its own: its fuse burned down, or, run out, it blows up with
            // its speed across; and it blows up hitting something across at a tenth or more.
            self.show_primed(mut sounds)
            if self.fuse > 0 {
                self.fuse -= 1
            } else if self.fuse == 0 {
                let across = self.body.vx * self.body.vx + self.body.vz * self.body.vz
                self.explode(across)
            }
            if self.body.horizontal_collision and not self.body.removed {
                let speed = self.body.vx * self.body.vx + self.body.vz * self.body.vz
                if speed >= f64(0.01f32) {
                    self.explode(speed)
                }
            }
        }
    }

    // `applyEffectsFromBlocks` along `moves`, where blocks act on it, as they don't on what's
    // gone: what the block it's on does, `stepOn`; then what it's inside, cactus hurting it, 1, a
    // detector rail looking for minecarts, `Rail`, and the fluids' effects gathered and applied in
    // their order, fire setting it alight and hurting it, lava too, as for any entity; then the
    // rain.
    fn blocks_act<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, t: BodyFacts, types: DamageTypes, blocks: B, moves: List<Movement>, drops: bool, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        if let a = self.body.step_on_block(f, t, blocks, false) {
            self.act(a, sounds.len())
        }
        let froze = self.body.extras.contains("TicksFrozen")
        let was = (self.body.burning(false), froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height, self.body.fall) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                match touch_block(f, i, mut c, false, false, self.body.on_ground, self.body.y) {
                    Touched.Cactus => {
                        _ = self.hurt(types, types.id("cactus"), 1.0f32, false, drops, none, sounds.len())
                    },
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Plate(at) => self.act(Acted.Plate(at), sounds.len()),
                    Touched.Tripwire(at) => self.act(Acted.Tripwire(at), sounds.len()),
                    Touched.Dripleaf(at) => self.act(Acted.Dripleaf(at), sounds.len()),
                    Touched.Rail(at) => self.act(Acted.Rail(at), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, false),
                    Touched.EndPortal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, true),
                    Touched.Gateway(g) => {
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if not self.body.removed and blocks.gateway_open(gx, gy, gz) {
                            self.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.act(Acted.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    Touched.Web => self.body.web(),
                    Touched.Honey((hx, hy, hz)) => {
                        if self.body.honey_slide(hx, hy, hz) {
                            let at: ((f64, f64, f64), i32)? = if self.silent() { none } else { some(((self.body.x, self.body.y, self.body.z), self.body.sound_source)) }
                            self.act(Acted.Honey(at), sounds.len())
                        }
                    },
                    Touched.PowderSnow((_, sy, _)) => {
                        if self.body.powder_snow() {
                            let at = (self.body.x, f64(sy + 1), self.body.z)
                            self.act(Acted.Snow(at), sounds.len())
                        }
                    },
                    Touched.Bubble((drag, (bx, by, bz))) => {
                        let above = bubble_open_above(f, blocks, bx, by, bz)
                        self.body.bubble_column(drag, above)
                        if above {
                            self.act(Acted.Bubbles((bx, by, bz)), sounds.len())
                        }
                    },
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => {
                    if kind == CLEAR_FREEZE {
                        _ = self.body.extras.remove("TicksFrozen")
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == FIRE_IGNITE {
                        if self.body.fire_ignite(false, 0) {
                            _ = self.body.extras.remove("TicksFrozen")
                            self.data.set(TICKS_FROZEN, Value.Number(0))
                        }
                    } else if kind == LAVA_IGNITE {
                        self.body.ignite_for(300)
                        _ = self.body.extras.remove("TicksFrozen")
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == EXTINGUISH {
                        self.body.put_out()
                    } else if kind == FREEZE {
                        _ = self.body.freeze()
                        self.data.set(TICKS_FROZEN, Value.Number(self.body.frozen()))
                    }
                },
                BlockEffect.InFire(amount) => {
                    _ = self.hurt(types, types.id("in_fire"), amount, false, drops, none, sounds.len())
                },
                BlockEffect.LavaHurt => {
                    if self.hurt(types, types.id("lava"), 4.0f32, false, drops, none, sounds.len()) and not self.silent() {
                        let pitch = 2.0f32 + self.body.random.next_float() * 0.4f32
                        sounds.push(EntitySound { sound: String("entity.generic.burn"), x: self.body.x, y: self.body.y, z: self.body.z, volume: 0.4f32, pitch: pitch, source: self.body.sound_source })
                    }
                },
                BlockEffect.Doused(at) => {
                    if self.body.burning(false) {
                        self.act(Acted.Doused(at), sounds.len())
                    }
                },
                BlockEffect.Melted(at) => {
                    if self.body.burning(false) {
                        self.act(Acted.Melted(at), sounds.len())
                    }
                },
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.body.extras.contains("TicksFrozen")
        self.body.after_inside(false, was, freezing, rained, mut sounds)
        self.show_primed(mut sounds)
        self.spilled_unmade(sounds.len())
    }

    // A chest minecart broken in its own tick spills what it holds, `Containers.dropContents`,
    // which isn't made yet there.
    fn spilled_unmade(mut self, heard: usize) {
        if self.body.removed and self.has_chest() {
            self.act(Acted.Missing(String("A chest minecart's contents spilled as it breaks in its tick")), heard)
        }
    }

    // `setPos`: put at x, y, z, its box with it.
    fn place(mut self, x: f64, y: f64, z: f64) {
        self.body.x = x
        self.body.y = y
        self.body.z = z
    }

    // `getCurrentBlockPosOrRailBelow`: the block it's in, or the one under it where that's a rail.
    fn rail_pos<B: CollisionBlocks>(self, f: Facts, blocks: B) -> (i32, i32, i32) {
        let x = i32.saturate(self.body.x.floor())
        let y = i32.saturate(self.body.y.floor())
        let z = i32.saturate(self.body.z.floor())
        let below = blocks.collision_state(x, y - 1, z) ?? 0
        if f.in_set(below, f.tag("minecraft:rails")) {
            return (x, y - 1, z)
        }
        return (x, y, z)
    }

    // `Minecart.activateMinecart` with the rail powered: its riders let go, its level's to do,
    // and where it isn't shown hurt, rocked the other way, shown hurt, its damage 50 and its motion
    // sent.
    fn activated(mut self) {
        if self.data.number(VEHICLE_HURT) == 0 {
            let dir = self.data.number(VEHICLE_HURT_DIR)
            self.data.set(VEHICLE_HURT_DIR, Value.Number(-dir))
            self.data.set(VEHICLE_HURT, Value.Number(10))
            self.data.set(VEHICLE_DAMAGE, Value.Float(50.0f32))
            self.body.sync_velocity = true
        }
    }

    // `comeOffTrack`: its motion across held to its top speed, halved on the ground, then its move,
    // `move`, and out of the ground, slowed by the air, `getAirDrag`.
    fn come_off_track<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        let most = self.max_speed()
        self.body.vx = clamp(self.body.vx, -most, most)
        self.body.vz = clamp(self.body.vz, -most, most)
        if self.body.on_ground {
            self.body.vx = self.body.vx * 0.5
            self.body.vy = self.body.vy * 0.5
            self.body.vz = self.body.vz * 0.5
        }
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        self.body.move_by(f, m, t, blocks, vx, vy, vz)
        if not self.body.on_ground {
            let drag = f64(0.95f32)
            self.body.vx = self.body.vx * drag
            self.body.vy = self.body.vy * drag
            self.body.vz = self.body.vz * drag
        }
    }

    // `OldMinecartBehavior.moveAlongTrack` on the rail `state` at rx, ry, rz.
    fn move_along_track<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, rx: i32, ry: i32, rz: i32, state: u32, intent: (f64, f64, f64)?) {
        self.body.reset_fall()
        var x = self.body.x
        var y = self.body.y
        var z = self.body.z
        let old = Minecart.track_pos(f, blocks, x, y, z)
        y = f64(ry)
        var power = false
        var halt = false
        if f.block_named(String("minecraft:powered_rail")) == some(f.block(state)) {
            power = f.get_bool(state, "powered")
            halt = not power
        }
        var slide = 0.0078125
        if self.body.in_water {
            slide = slide * 0.2
        }
        let shape = rail_shape(f, state)
        if shape == ASCENDING_EAST {
            self.body.vx = self.body.vx - slide
            y += 1.0
        } else if shape == ASCENDING_WEST {
            self.body.vx = self.body.vx + slide
            y += 1.0
        } else if shape == ASCENDING_NORTH {
            self.body.vz = self.body.vz + slide
            y += 1.0
        } else if shape == ASCENDING_SOUTH {
            self.body.vz = self.body.vz - slide
            y += 1.0
        }
        let (e0, e1) = exits(shape)
        let (e0x, e0y, e0z) = e0
        let (e1x, e1y, e1z) = e1
        var xd = f64(e1x - e0x)
        var zd = f64(e1z - e0z)
        let length = (xd * xd + zd * zd).sqrt()
        let flip = self.body.vx * xd + self.body.vz * zd
        if flip < 0.0 {
            xd = -xd
            zd = -zd
        }
        let across = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
        let pow = if across < 2.0 { across } else { 2.0 }
        self.body.vx = pow * xd / length
        self.body.vz = pow * zd / length
        if let (ix, iy, iz) = intent {
            let sq = ix * ix + iy * iy + iz * iz
            if sq > 0.0 {
                let own_dist = self.body.vx * self.body.vx + self.body.vz * self.body.vz
                if own_dist < 0.01 {
                    self.body.vx = self.body.vx + ix * 0.001
                    self.body.vz = self.body.vz + iz * 0.001
                    halt = false
                }
            }
        }
        if halt {
            let speed = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
            if speed < 0.03 {
                self.body.vx = 0.0
                self.body.vy = 0.0
                self.body.vz = 0.0
            } else {
                self.body.vx = self.body.vx * 0.5
                self.body.vy = 0.0
                self.body.vz = self.body.vz * 0.5
            }
        }
        let x0 = f64(rx) + 0.5 + f64(e0x) * 0.5
        let z0 = f64(rz) + 0.5 + f64(e0z) * 0.5
        let x1 = f64(rx) + 0.5 + f64(e1x) * 0.5
        let z1 = f64(rz) + 0.5 + f64(e1z) * 0.5
        let dxr = x1 - x0
        let dzr = z1 - z0
        var progress = 0.0
        if dxr == 0.0 {
            progress = z - f64(rz)
        } else if dzr == 0.0 {
            progress = x - f64(rx)
        } else {
            progress = ((x - x0) * dxr + (z - z0) * dzr) * 2.0
        }
        x = x0 + dxr * progress
        z = z0 + dzr * progress
        self.place(x, y, z)
        let scale = if self.body.passengers.is_empty() { 1.0 } else { 0.75 }
        let most = self.max_speed()
        let mx = clamp(scale * self.body.vx, -most, most)
        let mz = clamp(scale * self.body.vz, -most, most)
        self.body.move_by(f, m, t, blocks, mx, 0.0, mz)
        let fx = i32.saturate(self.body.x.floor()) - rx
        let fz = i32.saturate(self.body.z.floor()) - rz
        if e0y != 0 and fx == e0x and fz == e0z {
            let (cx, cy, cz) = (self.body.x, self.body.y + f64(e0y), self.body.z)
            self.place(cx, cy, cz)
        } else if e1y != 0 and fx == e1x and fz == e1z {
            let (cx, cy, cz) = (self.body.x, self.body.y + f64(e1y), self.body.z)
            self.place(cx, cy, cz)
        }
        self.natural_slowdown(f)
        let now = Minecart.track_pos(f, blocks, self.body.x, self.body.y, self.body.z)
        if let (_, ny, _) = now {
            if let (_, oy, _) = old {
                let speed = (oy - ny) * 0.05
                let other = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
                if other > 0.0 {
                    self.body.vx = self.body.vx * ((other + speed) / other)
                    self.body.vz = self.body.vz * ((other + speed) / other)
                }
                let (cx, cz) = (self.body.x, self.body.z)
                self.place(cx, ny, cz)
            }
        }
        let xn = i32.saturate(self.body.x.floor())
        let zn = i32.saturate(self.body.z.floor())
        if xn != rx or zn != rz {
            let other = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
            self.body.vx = other * f64(xn - rx)
            self.body.vz = other * f64(zn - rz)
        }
        if power {
            let speed = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
            if speed > 0.01 {
                self.body.vx = self.body.vx + self.body.vx / speed * 0.06
                self.body.vz = self.body.vz + self.body.vz / speed * 0.06
            } else if shape == EAST_WEST {
                if conductor(f, blocks, rx - 1, ry, rz) {
                    self.body.vx = 0.02
                } else if conductor(f, blocks, rx + 1, ry, rz) {
                    self.body.vx = -0.02
                }
            } else if shape == NORTH_SOUTH {
                if conductor(f, blocks, rx, ry, rz - 1) {
                    self.body.vz = 0.02
                } else if conductor(f, blocks, rx, ry, rz + 1) {
                    self.body.vz = -0.02
                }
            }
        }
    }

    // `OldMinecartBehavior.getPos`: where along the rail at or under x, y, z it is, none where
    // there's no rail.
    fn track_pos<B: CollisionBlocks>(f: Facts, blocks: B, x: f64, y: f64, z: f64) -> (f64, f64, f64)? {
        let xt = i32.saturate(x.floor())
        var yt = i32.saturate(y.floor())
        let zt = i32.saturate(z.floor())
        let below = blocks.collision_state(xt, yt - 1, zt) ?? 0
        if f.in_set(below, f.tag("minecraft:rails")) {
            yt -= 1
        }
        let state = blocks.collision_state(xt, yt, zt) ?? 0
        if not is_rail(f, state) {
            return none
        }
        let (e0, e1) = exits(rail_shape(f, state))
        let (e0x, e0y, e0z) = e0
        let (e1x, e1y, e1z) = e1
        let x0 = f64(xt) + 0.5 + f64(e0x) * 0.5
        let y0 = f64(yt) + 0.0625 + f64(e0y) * 0.5
        let z0 = f64(zt) + 0.5 + f64(e0z) * 0.5
        let x1 = f64(xt) + 0.5 + f64(e1x) * 0.5
        let y1 = f64(yt) + 0.0625 + f64(e1y) * 0.5
        let z1 = f64(zt) + 0.5 + f64(e1z) * 0.5
        let xd = x1 - x0
        let yd = (y1 - y0) * 2.0
        let zd = z1 - z0
        var progress = 0.0
        if xd == 0.0 {
            progress = z - f64(zt)
        } else if zd == 0.0 {
            progress = x - f64(xt)
        } else {
            progress = ((x - x0) * xd + (z - z0) * zd) * 2.0
        }
        var py = y0 + yd * progress
        if yd < 0.0 {
            py += 1.0
        } else if yd > 0.0 {
            py += 0.5
        }
        return some((x0 + xd * progress, py, z0 + zd * progress))
    }

    /// `VehicleEntity.hurtServer` by `amount` of the damage `kind`, by a player in creative mode
    /// where `creative`, as a boat's is, but rocked as `AbstractMinecart.animateHurt` has it, its
    /// damage ten times what it was more, before the hurt's own; broken past 40, its item dropped
    /// where `drops`. Whether it took it.
    pub fn hurt(mut self, types: DamageTypes, kind: i32, amount: f32, creative: bool, drops: bool, by: (i64, i64)?, heard: usize) -> bool {
        if self.body.removed {
            return true
        }
        if self.body.invulnerable and not types.is(kind, BYPASSES_INVULNERABILITY) and not creative {
            return false
        }
        let dir = self.data.number(VEHICLE_HURT_DIR)
        self.data.set(VEHICLE_HURT_DIR, Value.Number(-dir))
        self.data.set(VEHICLE_HURT, Value.Number(10))
        self.body.sync_velocity = true
        let damage = self.data.float(VEHICLE_DAMAGE) + amount * 10.0f32
        self.data.set(VEHICLE_DAMAGE, Value.Float(damage))
        // A TNT minecart's broken by fire and explosions whatever its damage,
        // `shouldSourceDestroy`, and primed, not broken, where that or its speed would set it off,
        // `MinecartTNT.destroy`, burning 0 to 38 ticks.
        let ignites = self.is_tnt() and (types.is(kind, IS_FIRE) or types.is(kind, IS_EXPLOSION))
        if self.is_tnt() and (ignites or (not creative and damage > 40.0f32)) {
            let speed = self.body.vx * self.body.vx + self.body.vz * self.body.vz
            if ignites or speed >= f64(0.01f32) {
                if self.fuse < 0 {
                    self.prime(true, by)
                    self.fuse = self.body.random.next_int_below(20) + self.body.random.next_int_below(20)
                }
                return true
            }
        }
        if creative and not ignites {
            self.body.removed = true
        } else if damage > 40.0f32 or ignites {
            self.body.removed = true
            if drops {
                var stack = JavaHashMap<String, Tag>()
                stack.insert(String("id"), Tag.Str(String(self.type_name())))
                stack.insert(String("count"), Tag.Int(1))
                if self.body.extras.contains("CustomName") {
                    var components = JavaHashMap<String, Tag>()
                    components.insert(String("minecraft:custom_name"), self.body.extras["CustomName"].copy())
                    stack.insert(String("components"), Tag.Compound(components))
                }
                let at = (self.body.x, self.body.y, self.body.z)
                self.act(Acted.Dropped((at, Tag.Compound(stack))), heard)
            }
        }
        return true
    }

    /// The stacks it dropped as it broke, taken out of what it did, which is then cleared.
    pub fn take_drops(mut self) -> List<((f64, f64, f64), Tag)> {
        var out = List<((f64, f64, f64), Tag)>()
        for a in self.acted {
            if let Acted.Dropped((at, stack)) = a {
                out.push((at, stack.copy()))
            }
        }
        self.acted.clear()
        self.acted_after.clear()
        return out
    }

    // What its tick had its level do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves; its leash; then
    /// `AbstractMinecart.addAdditionalSaveData`: the block it shows where it has one, its offset
    /// where it isn't 6, `FlippedRotation` and `HasTicked`, which is whether it's yet to tick.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, self.type_name())
        if let leash = self.leash {
            t.insert(String("leash"), leash.copy())
        }
        if let d = self.display {
            t.insert(String("DisplayState"), d.copy())
        }
        if let o = self.display_offset {
            if o != default_offset(self.kind) {
                t.insert(String("DisplayOffset"), Tag.Int(o))
            }
        }
        t.insert(String("FlippedRotation"), Tag.Byte(if self.flipped { 1i8 } else { 0i8 }))
        t.insert(String("HasTicked"), Tag.Byte(if self.body.first_tick { 1i8 } else { 0i8 }))
        if self.is_tnt() {
            t.insert(String("fuse"), Tag.Int(self.fuse))
            if self.power_base != 4.0f32 {
                t.insert(String("explosion_power"), Tag.Float(self.power_base))
            }
            if self.speed_factor != 1.0f32 {
                t.insert(String("explosion_speed_factor"), Tag.Float(self.speed_factor))
            }
        }
        if self.is_furnace() {
            t.insert(String("PushX"), Tag.Double(self.push_x))
            t.insert(String("PushZ"), Tag.Double(self.push_z))
            t.insert(String("Fuel"), Tag.Short(i16.wrap(self.fuel)))
        }
        if self.has_chest() {
            // `addChestVehicleSaveData`: its loot table and seed where it has one, else its items,
            // each with its `Slot`.
            if let table = self.loot_table {
                t.insert(String("LootTable"), Tag.Str(table.copy()))
                if self.loot_seed != 0 {
                    t.insert(String("LootTableSeed"), Tag.Long(self.loot_seed))
                }
            } else {
                t.insert(String("Items"), slotted(self.items))
            }
        }
        if self.is_hopper() {
            t.insert(String("Enabled"), Tag.Byte(if self.enabled { 1i8 } else { 0i8 }))
        }
        return Tag.Compound(t)
    }

    /// The minecart `tag` saves, of the type `kind`, with the ID `id` and a random seeded `seed`.
    /// `none` where it doesn't load, logged in `lines`.
    pub fn loaded(id: i32, seed: i64, kind: own String, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Minecart? {
        var c = Minecart.made(id, seed, 0.0, 0.0, 0.0, kind)
        if not c.load_onto(tag, mut lines) {
            return none
        }
        return some(c)
    }

    /// `Entity.load` onto it as it is: what every entity reads, its values from it, its leash,
    /// then `readAdditionalSaveData`.
    pub fn load_onto(mut self, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.data.set(AIR_SUPPLY, Value.Number(self.body.air))
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.leash = if tag.contains("leash") { some(tag["leash"].copy()) } else { none }
        self.display = if tag.contains("DisplayState") { some(tag["DisplayState"].copy()) } else { none }
        self.display_offset = if tag.contains("DisplayOffset") { some(int_or(tag, "DisplayOffset", default_offset(self.kind))) } else { none }
        self.flipped = bool_or(tag, "FlippedRotation")
        self.body.first_tick = bool_or(tag, "HasTicked")
        if self.is_tnt() {
            self.fuse = -1
            if let Tag.Int(v) = tag.find("fuse") {
                self.fuse = v
            }
            self.power_base = 4.0f32
            if let Tag.Float(v) = tag.find("explosion_power") {
                self.power_base = v.max(0.0f32).min(128.0f32)
            }
            self.speed_factor = 1.0f32
            if let Tag.Float(v) = tag.find("explosion_speed_factor") {
                self.speed_factor = v.max(0.0f32).min(128.0f32)
            }
        }
        if self.is_furnace() {
            self.push_x = 0.0
            if let Tag.Double(v) = tag.find("PushX") {
                self.push_x = v
            }
            self.push_y = 0.0
            self.push_z = 0.0
            if let Tag.Double(v) = tag.find("PushZ") {
                self.push_z = v
            }
            self.fuel = 0
            if let Tag.Short(v) = tag.find("Fuel") {
                self.fuel = i32(v)
            }
        }
        if self.has_chest() {
            let (items, table, seed) = chest_read(tag, self.slot_count())
            self.items = items
            self.loot_table = table
            self.loot_seed = seed
        }
        if self.is_hopper() {
            self.enabled = true
            if let Tag.Byte(v) = tag.find("Enabled") {
                self.enabled = v != 0i8
            }
        }
        return true
    }
}

// `getDefaultDisplayOffset` of the minecart type `kind`: 8 for a chest minecart, else 6.
fn default_offset(kind: String) -> i32 {
    return if kind == "minecraft:chest_minecart" { 8 } else if kind == "minecraft:hopper_minecart" { 1 } else { 6 }
}

// Whether the block at x, y, z conducts redstone, `isRedstoneConductor`.
fn conductor<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let state = blocks.collision_state(x, y, z) ?? 0
    return f.redstone_conductor(state)
}

// `Mth.clamp` of `v` to `lo`..`hi`.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// `Mth.wrapDegrees` of `d`, to -180 up to 180.
fn wrap_degrees(d: f64) -> f64 {
    var w = d % 360.0
    if w >= 180.0 {
        w -= 360.0
    }
    if w < -180.0 {
        w += 360.0
    }
    return w
}

/// Where a minecart seats a rider, `getPassengerAttachmentPoint`: 0.1875 up, its type's
/// attachment, or at its bottom for a villager or a wandering trader, `lowered`.
pub fn cart_seat(lowered: bool) -> (f64, f64, f64) {
    if lowered {
        return (0.0, 0.0, 0.0)
    }
    return (0.0, f64(0.1875f32), 0.0)
}
