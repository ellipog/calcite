/// Maps, vanilla's `MapItemSavedData`, `MapIndex` and `MapItem` (CAL-167): each map's saved data
/// by its ID, `data/minecraft/maps/<id>.dat`, read the first time the map's asked for, and the last
/// ID given, `data/minecraft/maps/last_id.dat`, read the first time a new one's needed.
///
/// A map is 128 by 128 pixels about its center, each block across or more by its scale, its
/// pixels drawn as players carrying it in a hand walk about, `MapItem.update`, from the colors
/// of the blocks the level shows from above. The players who carry it are kept, `carriedBy`, each
/// one life of a player, as a boss bar keeps those it's shown to, with what of the map they've
/// still to be sent, and the decorations it shows: where each player who carries it is, those
/// its stack's `map_decorations` name, the banners it's been used on, `MapBanner`, each gone as
/// the map's drawn where it isn't there any more, and the item frames it was saved in, `MapFrame`.
module world.maps

import chat.component.{Component}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}
import world.block_facts.{state_map_colors}
import world.block_level.{BlockLevel, legacy_block}
import math.mth.{SinTable}
import world.crafting.{dye_name}
import world.placing.{component_of, stack_item}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, UP, FULL}
import worldgen.interval.{Thrown}

/// The decoration types, `MapDecorationTypes`, by their IDs in `map_decoration_type`: a player
/// on the map, a framed map's frame, and a player off it, near or far.
pub const PLAYER: i32 = 0
pub const FRAME: i32 = 1
pub const PLAYER_OFF_MAP: i32 = 6
pub const PLAYER_OFF_LIMITS: i32 = 7

// Map colors by `MapColor.id`: none, and water, whose shading is its depth's.
const COLOR_NONE: u32 = 0
const COLOR_WATER: u32 = 12

// `MapColor.Brightness`, by its `id`.
const LOW: u32 = 0
const NORMAL: u32 = 1
const HIGH: u32 = 2

/// Whether a decoration of the type `kind` counts toward a map's tracked limit,
/// `MapDecorationType.trackCount`: the players', on the map and off it, frames', markers' and
/// banners', not targets' nor structures'.
pub fn tracks(kind: i32) -> bool {
    return kind <= 3 or kind == 6 or kind == 7 or (kind >= 10 and kind <= 25)
}

/// The saved data name of the map `id`, `maps/<id>`.
pub fn map_id(id: i32) -> Identifier {
    return Identifier { namespace: String("minecraft"), path: "maps/{id}" }
}

/// The saved data name of the last map ID given, `maps/last_id`.
pub fn index_id() -> Identifier {
    return Identifier { namespace: String("minecraft"), path: String("maps/last_id") }
}

/// The map ID of the stack `stack`, its `map_id` component, if it has one.
pub fn map_of(stack: Tag?) -> i32? {
    let id = component_of(stack, "minecraft:map_id") else return none
    return id.number_int()
}

/// A decoration as it's shown, `MapDecoration`: its type, where it is on the map, from -128 to
/// 127 by half pixels about the middle, its rotation, 0 to 15, and its name, a banner's custom
/// name as its block entity saves it, where it has one.
pub struct Decoration {
    pub kind: i32
    pub x: i8
    pub y: i8
    pub rot: i8
    pub name: Tag? = none
}

// A banner a map shows, `MapBanner`: where it is, its base color by `DyeColor`'s ID, and its
// custom name, as its block entity saves it.
struct Banner {
    x: i32
    y: i32
    z: i32
    color: i32
    name: Tag?
}

// An item frame a map was saved in, `MapFrame`: where it is, its rotation, and its entity's ID.
struct Frame {
    x: i32
    y: i32
    z: i32
    rotation: i32
    entity: i32
}

/// A player as a map sees them, one life of theirs, `entity` and `serial`, as `ServerPlayer` is:
/// their plain name, which their decoration's kept by, their level, where they are and which way
/// they face, the IDs of the filled maps in their inventory's 41 slots, `Inventory.contains`, and
/// whether they wear what hides them from maps, `hasMapInvisibilityItemEquipped`.
pub struct Carrier {
    pub entity: i32
    pub serial: i64
    pub name: String
    pub dimension: String
    pub x: f64
    pub z: f64
    pub y_rot: f32
    pub maps: List<i32>
    pub hidden: bool
}

/// What a player's sent of a map, `ClientboundMapItemDataPacket`: its scale, whether it's locked,
/// its decorations where they've changed, and the pixels that changed, `patch`, where they have,
/// from `x`, `y`, `width` across and `height` down, row by row.
pub struct MapSent {
    pub scale: i8
    pub locked: bool
    pub decorations: List<Decoration>?
    pub patch: MapPatch?
}

/// A patch of a map's pixels, `MapPatch`.
pub struct MapPatch {
    pub x: i32
    pub y: i32
    pub width: i32
    pub height: i32
    pub colors: List<u8>
}

// A player carrying the map, `HoldingPlayer`: who, what of the map they've still to be sent,
// the pixels from `min_x`, `min_y` to `max_x`, `max_y` and its decorations, how many times its
// packet's been asked for with decorations to send, `tick`, and how far through its columns its
// drawing has stepped, `step`; and whether they wore what hides them from maps when they were
// last seen.
struct Holding {
    entity: i32
    serial: i64
    name: String
    dirty_data: bool = true
    min_x: i32 = 0
    min_y: i32 = 0
    max_x: i32 = 127
    max_y: i32 = 127
    dirty_decorations: bool = true
    tick: i32 = 0
    step: i32 = 0
    hidden: bool = false
}

/// A map's saved data, `MapItemSavedData`.
pub struct MapData {
    pub dimension: String
    pub center_x: i32
    pub center_z: i32
    pub scale: i32
    pub colors: List<u8>
    pub tracking: bool = true
    pub unlimited: bool = false
    pub locked: bool = false
    /// Whether it's changed since it was saved, `setDirty`.
    pub dirty: bool = false
    // Its banners and frames, by their keys, `banner-x,y,z` and `frame-x,y,z`, in `HashMap`'s
    // order, which they're saved in.
    banners: JavaHashMap<String, Banner> = JavaHashMap<String, Banner>()
    frames: JavaHashMap<String, Frame> = JavaHashMap<String, Frame>()
    // The decorations it shows, by their keys, in the order first put, a `LinkedHashMap`'s.
    decorations: List<(String, Decoration)> = List<(String, Decoration)>()
    carried: List<Holding> = List<Holding>()
    tracked: i32 = 0
}

impl MapData {
    /// `createFresh`: a new map about where `x`, `z` falls on the grid of maps of its scale,
    /// each `128 << scale` blocks across, their middles 64 off its lines, with nothing drawn.
    pub fn fresh(x: f64, z: f64, scale: i32, tracking: bool, unlimited: bool, dimension: String) -> MapData {
        let size = 128 * (1 << scale)
        let area_x = ((x + 64.0) / f64(size)).floor()
        let area_z = ((z + 64.0) / f64(size)).floor()
        let cx = i32.saturate(area_x) * size + size / 2 - 64
        let cz = i32.saturate(area_z) * size + size / 2 - 64
        return MapData { dimension: dimension.copy(), center_x: cx, center_z: cz, scale: scale, colors: blank(), tracking: tracking, unlimited: unlimited }
    }

    /// `locked`, a locked copy, with its banners, decorations, how many it tracks and its colors,
    /// and no one carrying it, as a cartography table's glass pane makes it.
    pub fn locked_copy(self) -> MapData {
        var d = MapData { dimension: self.dimension.copy(), center_x: self.center_x, center_z: self.center_z, scale: self.scale, colors: self.colors.copy(), tracking: self.tracking, unlimited: self.unlimited, locked: true }
        d.banners = self.banners.copy()
        d.decorations = self.decorations.copy()
        d.tracked = self.tracked
        return d
    }

    /// `scaled`: a new map about its middle a scale up, to 4 at most, with nothing drawn, as paper
    /// makes it.
    pub fn scaled(self) -> MapData {
        return MapData.fresh(f64(self.center_x), f64(self.center_z), (self.scale + 1).max(0).min(4), self.tracking, self.unlimited, self.dimension.copy())
    }

    /// What `read` makes of a saved map's `data`, as `MapItemSavedData.CODEC` reads it, or the
    /// codec's errors where it can't: its scale clamped to 0 to 4, and its colors kept only where
    /// there are all 16,384 of them.
    pub fn read(data: Tag) -> MapData ! String {
        let Tag.Compound(m) = data else {
            fail "Not a map: {data.to_snbt()}"
        }
        var errors = List<String>()
        let shown = Tag.Compound(m.copy()).to_snbt()
        var dimension = String()
        if m.contains("dimension") {
            match m["dimension"] {
                Tag.Str(s) => match Identifier.parse(s.copy()) {
                    ok(i) => dimension = i.to_string(),
                    err(e) => errors.push(e),
                },
                _ => errors.push("Not a string: {m["dimension"].to_snbt()}"),
            }
        } else {
            errors.push("No key dimension in MapLike[{shown}]")
        }
        let cx = int_field(m, "xCenter", mut errors, shown)
        let cz = int_field(m, "zCenter", mut errors, shown)
        var colors = blank()
        if m.contains("colors") {
            match m["colors"] {
                Tag.ByteArray(a) => {
                    if a.len() == 16384 {
                        colors = List<u8>()
                        for b in a {
                            colors.push(u8.wrap(b))
                        }
                    }
                },
                _ => errors.push("Not a byte list: {m["colors"].to_snbt()}"),
            }
        } else {
            errors.push("No key colors in MapLike[{shown}]")
        }
        var banners = List<Banner>()
        for t in list_field(m, "banners", mut errors) {
            match read_banner(t) {
                ok(b) => banners.push(b),
                err(e) => errors.push(e),
            }
        }
        var frames = List<Frame>()
        for t in list_field(m, "frames", mut errors) {
            match read_frame(t) {
                ok(fr) => frames.push(fr),
                err(e) => errors.push(e),
            }
        }
        if not errors.is_empty() {
            var message = String()
            for e in errors {
                if not message.is_empty() {
                    message.push_str("; ")
                }
                message.push_str(e)
            }
            fail message
        }
        let scale = (if m.contains("scale") { m["scale"].number_int() ?? 0 } else { 0 }).max(0).min(4)
        var d = MapData { dimension: dimension, center_x: cx, center_z: cz, scale: scale, colors: colors }
        d.tracking = flag(m, "trackingPosition", true)
        d.unlimited = flag(m, "unlimitedTracking", false)
        d.locked = flag(m, "locked", false)
        // Its banners' and frames' decorations, as its constructor adds them, with no level.
        for b in banners {
            let key = banner_key(b.x, b.y, b.z)
            d.banners.insert(key.copy(), b.copy())
            d.add_decoration(BANNERS + b.color, false, 0, key, f64(b.x), f64(b.z), 180.0, b.name.copy())
        }
        for fr in frames {
            d.frames.insert(frame_key(fr.x, fr.y, fr.z), fr)
            d.add_decoration(FRAME, false, 0, "frame-{fr.entity}", f64(fr.x), f64(fr.z), f64(fr.rotation), none)
        }
        return d
    }

    /// Its `data` as the codec writes it: each field but those at their defaults, which
    /// `optionalFieldOf` leaves out.
    pub fn pack(self) -> Tag {
        var m = JavaHashMap<String, Tag>()
        m.insert(String("dimension"), Tag.Str(self.dimension.copy()))
        m.insert(String("xCenter"), Tag.Int(self.center_x))
        m.insert(String("zCenter"), Tag.Int(self.center_z))
        if self.scale != 0 {
            m.insert(String("scale"), Tag.Byte(i8.wrap(self.scale)))
        }
        var bytes = List<i8>()
        for c in self.colors {
            bytes.push(i8.wrap(c))
        }
        m.insert(String("colors"), Tag.ByteArray(bytes))
        if not self.tracking {
            m.insert(String("trackingPosition"), Tag.Byte(0))
        }
        if self.unlimited {
            m.insert(String("unlimitedTracking"), Tag.Byte(1))
        }
        if self.locked {
            m.insert(String("locked"), Tag.Byte(1))
        }
        if not self.banners.is_empty() {
            var out = List<Tag>()
            for (_, b) in self.banners {
                var t = JavaHashMap<String, Tag>()
                t.insert(String("pos"), Tag.IntArray([b.x, b.y, b.z]))
                if b.color != 0 {
                    t.insert(String("color"), Tag.Str(dye_name(b.color)))
                }
                if let n = b.name {
                    t.insert(String("name"), n.copy())
                }
                out.push(Tag.Compound(t))
            }
            m.insert(String("banners"), Tag.List(out))
        }
        if not self.frames.is_empty() {
            var out = List<Tag>()
            for (_, fr) in self.frames {
                var t = JavaHashMap<String, Tag>()
                t.insert(String("pos"), Tag.IntArray([fr.x, fr.y, fr.z]))
                t.insert(String("rotation"), Tag.Int(fr.rotation))
                t.insert(String("entity_id"), Tag.Int(fr.entity))
                out.push(Tag.Compound(t))
            }
            m.insert(String("frames"), Tag.List(out))
        }
        return Tag.Compound(m)
    }

    /// `tickCarriedBy` of the map `stack` by the player `ticking`, in no frame, with `players`
    /// those in play and `time` the game time: the player kept among those who carry it; each of
    /// those, in turn, shown where they are where they're still in play, carry it and are in its
    /// level, and it tracks them, else let go, which skips the next as vanilla's loop does, and
    /// hidden from it where they wear what hides them and aren't `ticking`; then the
    /// decorations the stack's `map_decorations` names that it hasn't, added. Where it's in an
    /// item frame, `frame`, its entity's ID, block and rotation (CAL-354), those carrying it are
    /// kept but not shown, and where it tracks, the frame's marker is: one of another frame on the
    /// same block gone, its own decoration, `frame-id`, and the frame kept, changed where it's
    /// different.
    pub fn tick_carried_by(mut self, ticking: Carrier, stack: Tag, map: i32, players: List<Carrier>, time: i64, frame: (i32, (i32, i32, i32), i32)?) {
        _ = self.holding(ticking)
        if not ticking.maps.contains(map) {
            self.remove_decoration(ticking.name)
        }
        var i: usize = 0
        while i < self.carried.len() {
            let h = self.carried[i].copy()
            let found = carrier_of(players, h.entity, h.serial)
            var hidden = h.hidden
            var gone = true
            if let c = found {
                hidden = c.hidden
                self.carried[i].hidden = c.hidden
                if frame != none or c.maps.contains(map) {
                    gone = false
                    if frame == none and c.dimension == self.dimension and self.tracking {
                        self.add_decoration(PLAYER, true, time, h.name, c.x, c.z, f64(c.y_rot), none)
                    }
                }
            }
            if gone {
                _ = self.carried.remove(i)
                self.remove_decoration(h.name)
            }
            if not (h.entity == ticking.entity and h.serial == ticking.serial) and hidden {
                self.remove_decoration(h.name)
            }
            i += 1
        }
        if let (entity, at, rotation) = frame {
            if self.tracking {
                let (fx, fy, fz) = at
                let key = frame_key(fx, fy, fz)
                if self.frames.contains(key.copy()) {
                    let existing = self.frames[key.copy()]
                    if existing.entity != entity {
                        self.remove_decoration("frame-{existing.entity}")
                    }
                }
                self.add_decoration(FRAME, true, time, "frame-{entity}", f64(fx), f64(fz), f64(rotation), none)
                let made = Frame { x: fx, y: fy, z: fz, rotation: rotation, entity: entity }
                var changed = true
                if self.frames.contains(key.copy()) {
                    let old = self.frames[key.copy()]
                    changed = not (old.x == fx and old.y == fy and old.z == fz and old.rotation == rotation and old.entity == entity)
                }
                self.frames.insert(key, made)
                if changed {
                    self.dirty = true
                }
            }
        }
        // The decorations the stack names, `MapDecorations`, those it hasn't added in their order.
        let Tag.Compound(named) = component_of(some(stack.copy()), "minecraft:map_decorations") ?? Tag.End else return
        var all = true
        for (key, _) in named {
            if not self.has_decoration(key) {
                all = false
            }
        }
        if all {
            return
        }
        for (key, entry) in named {
            if self.has_decoration(key) {
                continue
            }
            let Tag.Compound(e) = entry else continue
            let kind = decoration_kind(e) else continue
            let x = if e.contains("x") { e["x"].number_double() ?? 0.0 } else { 0.0 }
            let z = if e.contains("z") { e["z"].number_double() ?? 0.0 } else { 0.0 }
            let rot = if e.contains("rotation") { f64(f32.nearest(e["rotation"].number_double() ?? 0.0)) } else { 0.0 }
            self.add_decoration(kind, true, time, key, x, z, rot, none)
        }
    }

    /// `MapItem.update` of the map, carried in a hand by the player `p` in its level `level`,
    /// whose dimension has a ceiling where `ceiling` is: a column of every 16 across about them,
    /// `step`'s, and the next where one changes, drawn from the blocks the level shows from
    /// above, `state_map_colors`' colors shaded by how the land slopes from the row above, or
    /// water by its depth; a ceiling's levels drawn as dirt and stone, noise. Those outside its
    /// radius aren't, nor those on its edge every other. Any its columns read that aren't loaded,
    /// which vanilla loads, said missing, those pixels left.
    pub fn update<L: BlockAccess + BlockLevel>(mut self, f: Facts, level: L, colors: List<u32>, p: Carrier, ceiling: bool) ! Thrown {
        if p.dimension != self.dimension {
            return
        }
        let scale = 1 << self.scale
        let cx = self.center_x
        let cz = self.center_z
        let px = i32.saturate((p.x - f64(cx)).floor()) / scale + 64
        let py = i32.saturate((p.z - f64(cz)).floor()) / scale + 64
        var radius = 128 / scale
        if ceiling {
            radius /= 2
        }
        let h = self.holding(p)
        self.carried[h].step += 1
        let step = self.carried[h].step
        let min_y = level.min_y()
        let dirt = colors[usize(f.default_state(f.ids.dirt))]
        let stone = colors[usize(f.default_state(f.ids.stone))]
        let bedrock = f.default_state(f.ids.bedrock)
        var consecutive = false
        var missing = false
        for img_x in (px - radius + 1)..(px + radius) {
            if (img_x & 15) != (step & 15) and not consecutive {
                continue
            }
            consecutive = false
            var previous = 0.0
            for img_y in (py - radius - 1)..(py + radius) {
                if img_x < 0 or img_y < -1 or img_x >= 128 or img_y >= 128 {
                    continue
                }
                let dx = img_x - px
                let dy = img_y - py
                let distance = dx * dx + dy * dy
                let dither = distance > (radius - 2) * (radius - 2)
                let ax = (cx / scale + img_x - 64) * scale
                let az = (cz / scale + img_y - 64) * scale
                if not level.is_loaded(ax, min_y, az) {
                    missing = true
                    continue
                }
                var counts = List<(u32, i32)>()
                var water_depth = 0
                var height = 0.0
                if ceiling {
                    var noise = ax.wrapping_add(az.wrapping_mul(231871))
                    noise = noise.wrapping_mul(noise).wrapping_mul(31287121).wrapping_add(noise.wrapping_mul(11))
                    if ((noise >> 20) & 1) == 0 {
                        add_count(mut counts, dirt, 10)
                    } else {
                        add_count(mut counts, stone, 100)
                    }
                    height = 100.0
                } else {
                    for ddx in 0..scale {
                        for ddz in 0..scale {
                            let bx = ax + ddx
                            let bz = az + ddz
                            var y = level.world_surface(bx, bz)
                            var state = bedrock
                            if y > min_y {
                                y -= 1
                                state = try level.state(f, bx, y, bz)
                                while colors[usize(state)] == COLOR_NONE and y > min_y {
                                    y -= 1
                                    state = try level.state(f, bx, y, bz)
                                }
                                if y > min_y and f.fluid(state) != 0 {
                                    var solid = y - 1
                                    var below = state
                                    loop {
                                        below = try level.state(f, bx, solid, bz)
                                        solid -= 1
                                        water_depth += 1
                                        if not (solid > min_y and f.fluid(below) != 0) {
                                            break
                                        }
                                    }
                                    if not f.sturdy(state, UP, FULL) {
                                        state = legacy_block(f, state)
                                    }
                                }
                            }
                            if not self.banners.is_empty() {
                                try self.check_banners(f, level, bx, bz)
                            }
                            height += f64(y) / f64(scale * scale)
                            add_count(mut counts, colors[usize(state)], 1)
                        }
                    }
                }
                water_depth /= scale * scale
                let color = most_counted(counts)
                let odd = (img_x + img_y) & 1
                var brightness = NORMAL
                if color == COLOR_WATER {
                    let diff = f64(water_depth) * 0.1 + f64(odd) * 0.2
                    if diff < 0.5 {
                        brightness = HIGH
                    } else if diff > 0.9 {
                        brightness = LOW
                    }
                } else {
                    let diff = (height - previous) * 4.0 / f64(scale + 4) + (f64(odd) - 0.5) * 0.4
                    if diff > 0.6 {
                        brightness = HIGH
                    } else if diff < -0.6 {
                        brightness = LOW
                    }
                }
                previous = height
                if img_y >= 0 and distance < radius * radius and (not dither or odd != 0) {
                    if self.update_color(img_x, img_y, u8.wrap(color << 2 | brightness)) {
                        consecutive = true
                    }
                }
            }
        }
        if missing {
            fail Thrown { exception: "Unimplemented", message: "A map drawing where the level isn't loaded" }
        }
    }

    /// `getUpdatePacket` for the player `entity`'s life `serial`: none where they don't carry it;
    /// else what's changed for them since they were last sent it, its pixels and, every fifth
    /// time it's asked while they've changed, its decorations; none where nothing has.
    pub fn update_for(mut self, entity: i32, serial: i64) -> MapSent? {
        for i in 0..self.carried.len() {
            if self.carried[i].entity != entity or self.carried[i].serial != serial {
                continue
            }
            var patch: MapPatch? = none
            if self.carried[i].dirty_data {
                self.carried[i].dirty_data = false
                let h = self.carried[i].copy()
                let width = h.max_x + 1 - h.min_x
                let height = h.max_y + 1 - h.min_y
                var bytes = List<u8>()
                for y in 0..height {
                    for x in 0..width {
                        bytes.push(self.colors[usize.wrap(h.min_x + x + (h.min_y + y) * 128)])
                    }
                }
                patch = some(MapPatch { x: h.min_x, y: h.min_y, width: width, height: height, colors: bytes })
            }
            var decorations: List<Decoration>? = none
            if self.carried[i].dirty_decorations {
                let t = self.carried[i].tick
                self.carried[i].tick = t + 1
                if t % 5 == 0 {
                    self.carried[i].dirty_decorations = false
                    var shown = List<Decoration>()
                    for (_, d) in self.decorations {
                        shown.push(d.copy())
                    }
                    decorations = some(shown)
                }
            }
            if decorations == none and patch == none {
                return none
            }
            return some(MapSent { scale: i8.wrap(self.scale), locked: self.locked, decorations: decorations, patch: patch })
        }
        return none
    }

    /// `toggleBanner` of the block at x, y, z in the map's level `level`, whose game time is
    /// `time`: where its middle's within 63 pixels of the map's and it's a banner,
    /// `MapBanner.fromWorld`, its marker taken off where the map has the same, else put on, unless
    /// 256 of the decorations it tracks are on it already, `isTrackedCountOverLimit`. Whether it
    /// was either, and the map changed then.
    pub fn toggle_banner<L: BlockAccess + BlockLevel>(mut self, f: Facts, level: L, time: i64, x: i32, y: i32, z: i32) -> bool ! Thrown {
        let xp = f64(x) + 0.5
        let zp = f64(z) + 0.5
        let scale = f64(1 << self.scale)
        let xd = (xp - f64(self.center_x)) / scale
        let yd = (zp - f64(self.center_z)) / scale
        if not (xd >= -63.0 and yd >= -63.0 and xd <= 63.0 and yd <= 63.0) {
            return false
        }
        let b = try banner_at(f, level, x, y, z) else return false
        let key = banner_key(x, y, z)
        var same = false
        if let had = self.banners.find(key.copy()) {
            same = same_banner(had, b)
        }
        if same {
            _ = self.banners.remove(key.copy())
            self.remove_decoration(key)
            self.dirty = true
            return true
        }
        if self.tracked < 256 {
            self.banners.insert(key.copy(), b.copy())
            self.add_decoration(BANNERS + b.color, true, time, key, xp, zp, 180.0, b.name.copy())
            self.dirty = true
            return true
        }
        return false
    }

    /// `checkBanners` of the column x, z, as its pixel's drawn: each banner the map has there
    /// that isn't there as it was any more, in `HashMap`'s order, taken off, and the map changed.
    pub fn check_banners<L: BlockAccess + BlockLevel>(mut self, f: Facts, level: L, x: i32, z: i32) ! Thrown {
        var gone = List<String>()
        for (key, b) in self.banners {
            if b.x != x or b.z != z {
                continue
            }
            let now = try banner_at(f, level, b.x, b.y, b.z)
            let same = match now {
                some(n) => same_banner(b, n),
                none => false,
            }
            if not same {
                gone.push(key.copy())
            }
        }
        for key in gone {
            _ = self.banners.remove(key.copy())
            self.remove_decoration(key)
            self.dirty = true
        }
    }

    // `getHoldingPlayer`: where `p` is among those carrying it, made where they weren't.
    fn holding(mut self, p: Carrier) -> usize {
        for i in 0..self.carried.len() {
            if self.carried[i].entity == p.entity and self.carried[i].serial == p.serial {
                return i
            }
        }
        self.carried.push(Holding { entity: p.entity, serial: p.serial, name: p.name.copy(), hidden: p.hidden })
        return self.carried.len() - 1
    }

    fn has_decoration(self, key: String) -> bool {
        for (k, _) in self.decorations {
            if k == key {
                return true
            }
        }
        return false
    }

    /// `removedFromFrame` of the frame `entity` on the block `at` (CAL-354): its decoration and its
    /// frame gone, and it's changed.
    pub fn removed_from_frame(mut self, at: (i32, i32, i32), entity: i32) {
        self.remove_decoration("frame-{entity}")
        let (x, y, z) = at
        _ = self.frames.remove(frame_key(x, y, z))
        self.dirty = true
    }

    /// `isTrackedCountOverLimit(limit)`: whether more of its decorations track than `limit`
    /// (CAL-354).
    pub fn tracked_over(self, limit: i32) -> bool {
        return self.tracked > limit
    }

    // `removeDecoration`: the decoration `key`, if it has one, gone; those carrying it to be sent
    // its decorations either way.
    fn remove_decoration(mut self, key: String) {
        for i in 0..self.decorations.len() {
            if self.decorations[i].0 == key {
                let (_, d) = self.decorations.remove(i)
                if tracks(d.kind) {
                    self.tracked -= 1
                }
                break
            }
        }
        self.decorations_dirty()
    }

    // `addDecoration` of the type `kind` at x, z facing `y_rot`, named `name`, kept as `key`, in a
    // level, `in_level`, whose game time is `time`: where it is, by
    // `calculateDecorationLocationAndType`, a player off the map shown at its edge within 320 of
    // it, and anything else off it gone unless it tracks without limit; changed only where it's
    // different, those carrying it to be sent its decorations then.
    fn add_decoration(mut self, kind: i32, in_level: bool, time: i64, key: String, x: f64, z: f64, y_rot: f64, name: Tag?) {
        let scaling = f32.nearest(f64(1 << self.scale))
        let dx = f32.nearest(x - f64(self.center_x)) / scaling
        let dz = f32.nearest(z - f64(self.center_z)) / scaling
        var shown = kind
        if kind == PLAYER {
            if not inside_map(dx, dz) {
                if dx.abs() < 320.0f32 and dz.abs() < 320.0f32 {
                    shown = PLAYER_OFF_MAP
                } else if self.unlimited {
                    shown = PLAYER_OFF_LIMITS
                } else {
                    self.remove_decoration(key)
                    return
                }
            }
        } else if not inside_map(dx, dz) and not self.unlimited {
            self.remove_decoration(key)
            return
        }
        let rot = self.rotation(in_level, time, y_rot)
        let d = Decoration { kind: shown, x: clamp_coordinate(dx), y: clamp_coordinate(dz), rot: rot & 15, name: name.copy() }
        for i in 0..self.decorations.len() {
            if self.decorations[i].0 == key {
                let before = self.decorations[i].1.copy()
                if same_decoration(before, d) {
                    return
                }
                self.decorations[i] = (key.copy(), d)
                if tracks(before.kind) {
                    self.tracked -= 1
                }
                if tracks(shown) {
                    self.tracked += 1
                }
                self.decorations_dirty()
                return
            }
        }
        self.decorations.push((key.copy(), d))
        if tracks(shown) {
            self.tracked += 1
        }
        self.decorations_dirty()
    }

    // `calculateRotation`: in the Nether, with a level, a spin from its game time every 10
    // ticks; else `y_rot`'s sixteenth, rounded away from 0 by half of one.
    fn rotation(self, in_level: bool, time: i64, y_rot: f64) -> i8 {
        if self.dimension == "minecraft:the_nether" and in_level {
            let s = i32.wrap(time / 10)
            return i8.wrap((s.wrapping_mul(s).wrapping_mul(34187121).wrapping_add(s.wrapping_mul(121)) >> 15) & 15)
        }
        let adjusted = if y_rot < 0.0 { y_rot - 8.0 } else { y_rot + 8.0 }
        return i8.wrap(java_cast(adjusted * 16.0 / 360.0))
    }

    // `setDecorationsDirty`.
    fn decorations_dirty(mut self) {
        for i in 0..self.carried.len() {
            self.carried[i].dirty_decorations = true
        }
    }

    /// `renderBiomePreviewMap`'s drawing (CAL-167), of `watery`, whether each of its 128 by 128
    /// places, row by row, is in a biome of `#water_on_map_outlines`: each place but the edge's
    /// that's watery orange, striped where all eight about it are, every other row by
    /// `Mth.sin`, else bright by how many of them are; or, where any about it is, brown, normal
    /// where more than 3 are, else lowest.
    pub fn draw_preview(mut self, watery: List<bool>) {
        let table = SinTable.new()
        for mx in 1..127 {
            for mz in 1..127 {
                var near = 0
                for dx in -1..2 {
                    for dz in -1..2 {
                        if (dx != 0 or dz != 0) and watery[usize.wrap((mz + dz) * 128 + mx + dx)] {
                            near += 1
                        }
                    }
                }
                // `MapColor.Brightness`: LOW 0, NORMAL 1, HIGH 2, LOWEST 3; `COLOR_ORANGE` 15 and
                // `COLOR_BROWN` 26.
                var brightness = 3
                var color = 0
                if watery[usize.wrap(mz * 128 + mx)] {
                    color = 15
                    if near > 7 and mz % 2 == 0 {
                        let wave = i32.saturate(table.sin(f64(f32.nearest(f64(mz)))) * 7.0f32)
                        let band = (mx + wave) / 8 % 5
                        if band == 0 or band == 4 {
                            brightness = 0
                        } else if band == 1 or band == 3 {
                            brightness = 1
                        } else if band == 2 {
                            brightness = 2
                        }
                    } else if near > 7 {
                        color = 0
                    } else if near > 5 {
                        brightness = 1
                    } else if near > 1 {
                        brightness = 0
                    }
                } else if near > 0 {
                    color = 26
                    brightness = if near > 3 { 1 } else { 3 }
                }
                if color != 0 {
                    _ = self.update_color(mx, mz, u8.wrap(color * 4 + brightness))
                }
            }
        }
    }

    // `updateColor`: the pixel at x, y set to `color` where it isn't already, the map changed and
    // the pixel to be sent to those carrying it, `markColorsDirty`. Whether it changed.
    fn update_color(mut self, x: i32, y: i32, color: u8) -> bool {
        let at = usize.wrap(x + y * 128)
        if self.colors[at] == color {
            return false
        }
        self.colors[at] = color
        self.dirty = true
        for i in 0..self.carried.len() {
            if self.carried[i].dirty_data {
                self.carried[i].min_x = self.carried[i].min_x.min(x)
                self.carried[i].min_y = self.carried[i].min_y.min(y)
                self.carried[i].max_x = self.carried[i].max_x.max(x)
                self.carried[i].max_y = self.carried[i].max_y.max(y)
            } else {
                self.carried[i].dirty_data = true
                self.carried[i].min_x = x
                self.carried[i].min_y = y
                self.carried[i].max_x = x
                self.carried[i].max_y = y
            }
        }
        return true
    }
}

/// The world's maps lent to a level that makes exploration maps as its loot's rolled (CAL-167):
/// the maps, with their index read; the level's dimension; and the biomes of
/// `#water_on_map_outlines`, by their IDs.
pub struct MapLoan {
    pub maps: Maps
    pub dimension: String
    pub watery: List<i32>
}

/// The maps, by ID, each read the first time it's asked for, and the last ID given, `MapIndex`,
/// read the first time one's needed, with the map colors of the block states.
pub struct Maps {
    maps: Map<i32, MapData> = Map<i32, MapData>()
    looked: Set<i32> = Set<i32>()
    /// The last ID given, -1 for none, and whether it's been read, and changed since it was saved.
    pub last: i32 = -1
    pub index_looked: bool = false
    pub index_dirty: bool = false
    colors: List<u32> = List<u32>()
}

impl Maps {
    /// Each map there's data for, by its ID, with its scale and whether it's locked, as a menu's
    /// told them (CAL-338).
    pub fn facts(self) -> List<(i32, i32, bool)> {
        var out = List<(i32, i32, bool)>()
        for (id, d) in self.maps {
            out.push((id, d.scale, d.locked))
        }
        return out
    }

    /// Whether the map `id`'s file has been looked for, found or not.
    pub fn looked_for(self, id: i32) -> bool {
        return self.looked.contains(id)
    }

    /// Takes what was read of the map `id`'s file, its root, or `none` where there's none, as
    /// `SavedDataStorage.get` reads it, the codec's error logged where its `data` can't be read.
    pub fn read(mut self, id: i32, root: JavaHashMap<String, Tag>?, lines: mut List<Entry>) {
        self.looked.insert(id)
        let found = root else return
        if not found.contains("data") {
            lines.push(parse_failed(map_id(id), String("Not a map: END")))
            return
        }
        match MapData.read(found["data"].copy()) {
            ok(d) => self.maps.insert(id, d),
            err(e) => lines.push(parse_failed(map_id(id), e)),
        }
    }

    /// Takes what was read of `maps/last_id`, its root or none, as `computeIfAbsent` reads it.
    pub fn read_index(mut self, root: JavaHashMap<String, Tag>?, lines: mut List<Entry>) {
        self.index_looked = true
        let found = root else return
        if not found.contains("data") {
            return
        }
        let Tag.Compound(m) = found["data"] else {
            lines.push(parse_failed(index_id(), "Not a map: {found["data"].to_snbt()}"))
            return
        }
        if m.contains("map") {
            match m["map"].number_int() {
                some(n) => self.last = n,
                none => lines.push(parse_failed(index_id(), "Not a number: {m["map"].to_snbt()}")),
            }
        }
    }

    /// `getFreeMapId`: the next ID, and the index changed.
    pub fn next_id(mut self) -> i32 {
        self.last += 1
        self.index_dirty = true
        return self.last
    }

    /// `setMapData`: `data` kept as the map `id`, to be saved.
    pub fn set(mut self, id: i32, data: own MapData) {
        var d = data
        d.dirty = true
        self.looked.insert(id)
        self.maps.insert(id, d)
    }

    /// The map `id`, where there's one, lent: it's to be given back with `give_back`.
    pub fn lend(mut self, id: i32) -> MapData? {
        return self.maps.remove(id)
    }

    pub fn give_back(mut self, id: i32, data: own MapData) {
        self.maps.insert(id, data)
    }

    /// The block states' map colors, `state_map_colors`, read the first time they're needed.
    pub fn map_colors(mut self) -> List<u32> {
        if self.colors.is_empty() {
            self.colors = state_map_colors()
        }
        return self.colors.copy()
    }

    /// The maps changed since they were saved, each as its saved data's name and `data`, and the
    /// index where it has, marked saved.
    pub fn take_saves(mut self) -> List<(Identifier, Tag)> {
        var out = List<(Identifier, Tag)>()
        if self.index_dirty {
            self.index_dirty = false
            var m = JavaHashMap<String, Tag>()
            if self.last != -1 {
                m.insert(String("map"), Tag.Int(self.last))
            }
            out.push((index_id(), Tag.Compound(m)))
        }
        var ids = List<i32>()
        for (id, d) in self.maps {
            if d.dirty {
                ids.push(id)
            }
        }
        for id in ids {
            var d = self.maps.remove(id) ?? MapData.fresh(0.0, 0.0, 0, true, false, String())
            d.dirty = false
            out.push((map_id(id), d.pack()))
            self.maps.insert(id, d)
        }
        return out
    }
}

/// A filled map's stack of the map `id`, `MapItem.create`'s.
pub fn filled_map(id: i32) -> Tag {
    var components = JavaHashMap<String, Tag>()
    components.insert(String("minecraft:map_id"), Tag.Int(id))
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String("minecraft:filled_map")))
    m.insert(String("count"), Tag.Int(1))
    m.insert(String("components"), Tag.Compound(components))
    return Tag.Compound(m)
}

/// Whether the stack is a filled map, `instanceof MapItem`: a filled map or one of the explorer
/// maps, each a `MapItem` of its own (CAL-167).
pub fn is_filled_map(stack: Tag?) -> bool {
    if stack == none {
        return false
    }
    let item = stack_item(stack)
    if item == "minecraft:filled_map" {
        return true
    }
    let explorers: List<str> = ["ocean_monument", "woodland_mansion", "buried_trial_chambers", "jungle_pyramid", "swamp_hut", "desert_village", "plains_village", "savanna_village", "snowy_village", "taiga_village", "buried_treasure", "buried_ancient_city", "buried_mineshaft", "desert_pyramid", "abandoned_camp", "warm_ocean_ruins"]
    for e in explorers {
        if item == "minecraft:{e}_map" {
            return true
        }
    }
    return false
}

// 16,384 pixels of nothing.
fn blank() -> List<u8> {
    var out = List<u8>()
    out.reserve(16384)
    for _ in 0..16384 {
        out.push(0u8)
    }
    return out
}

fn int_field(m: JavaHashMap<String, Tag>, key: str, errors: mut List<String>, shown: String) -> i32 {
    if not m.contains(key) {
        errors.push("No key {key} in MapLike[{shown}]")
        return 0
    }
    match m[key].number_int() {
        some(n) => return n,
        none => {
            errors.push("Not a number: {m[key].to_snbt()}")
            return 0
        },
    }
}

fn flag(m: JavaHashMap<String, Tag>, key: str, default: bool) -> bool {
    if not m.contains(key) {
        return default
    }
    return (m[key].number_int() ?? 0) != 0
}

// The list at `key`, an empty one where there's none, as `optionalFieldOf(key, List.of())`
// reads it; one that isn't a list an error.
fn list_field(m: JavaHashMap<String, Tag>, key: str, errors: mut List<String>) -> List<Tag> {
    if not m.contains(key) {
        return List<Tag>()
    }
    return match m[key] {
        Tag.List(l) => l.copy(),
        _ => {
            errors.push("Not a list: {m[key].to_snbt()}")
            List<Tag>()
        },
    }
}

/// The first decoration type of a banner, `banner_white`, the rest after it by `DyeColor`.
pub const BANNERS: i32 = 10

fn banner_key(x: i32, y: i32, z: i32) -> String {
    return "banner-{x},{y},{z}"
}

fn frame_key(x: i32, y: i32, z: i32) -> String {
    return "frame-{x},{y},{z}"
}

// `BlockPos.CODEC`'s three ints, from an int array or a list of numbers.
fn read_pos(t: Tag) -> (i32, i32, i32) ! String {
    var xs = List<i32>()
    match t {
        Tag.IntArray(a) => xs = a.copy(),
        Tag.List(l) => {
            for e in l {
                let n = e.number_int() else {
                    fail "Not a number: {e.to_snbt()}"
                }
                xs.push(n)
            }
        },
        _ => fail "Not a list: {t.to_snbt()}",
    }
    if xs.len() != 3 {
        fail "Input is not a list of 3 ints"
    }
    return (xs[0], xs[1], xs[2])
}

// A saved banner, `MapBanner.CODEC`: its place, its color, white where it's none or not a dye's
// name, and its name, both read leniently.
fn read_banner(t: Tag) -> Banner ! String {
    let Tag.Compound(m) = t else {
        fail "Not a map: {t.to_snbt()}"
    }
    if not m.contains("pos") {
        fail "No key pos in MapLike[{t.to_snbt()}]"
    }
    let (x, y, z) = try read_pos(m["pos"].copy())
    var color = 0
    if m.contains("color") {
        if let Tag.Str(s) = m["color"] {
            color = dye_index(s) ?? 0
        }
    }
    var name: Tag? = none
    if m.contains("name") {
        name = lenient_name(m["name"].copy())
    }
    return Banner { x: x, y: y, z: z, color: color, name: name }
}

// A saved frame, `MapFrame.CODEC`: its place, its rotation and its entity's ID.
fn read_frame(t: Tag) -> Frame ! String {
    let Tag.Compound(m) = t else {
        fail "Not a map: {t.to_snbt()}"
    }
    let shown = t.to_snbt()
    var errors = List<String>()
    var pos = (0, 0, 0)
    if m.contains("pos") {
        match read_pos(m["pos"].copy()) {
            ok(p) => pos = p,
            err(e) => errors.push(e),
        }
    } else {
        errors.push("No key pos in MapLike[{shown}]")
    }
    let rotation = int_field(m, "rotation", mut errors, shown.copy())
    let entity = int_field(m, "entity_id", mut errors, shown)
    if not errors.is_empty() {
        fail errors[0].copy()
    }
    let (x, y, z) = pos
    return Frame { x: x, y: y, z: z, rotation: rotation, entity: entity }
}

// The dye named `name`'s index in `DyeColor`'s order.
fn dye_index(name: String) -> i32? {
    for i in 0..16 {
        if dye_name(i) == name {
            return some(i)
        }
    }
    return none
}

// `MapBanner.fromWorld`: the banner at x, y, z, where there's one, its base color its block's
// and its name its block entity's `CustomName`.
fn banner_at<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> Banner? ! Thrown {
    let state = try level.state(f, x, y, z)
    let block = f.block(state)
    for i in 0..16 {
        let dye = dye_name(i)
        if some(block) == f.block_named("minecraft:{dye}_banner") or some(block) == f.block_named("minecraft:{dye}_wall_banner") {
            var name: Tag? = none
            if let Tag.Compound(be) = level.block_entity_tag(x, y, z) ?? Tag.End {
                if be.contains("CustomName") {
                    name = lenient_name(be["CustomName"].copy())
                }
            }
            return some(Banner { x: x, y: y, z: z, color: i, name: name })
        }
    }
    return none
}

// `MapBanner.equals`: the same place, color and name.
fn same_banner(a: Banner, b: Banner) -> bool {
    return a.x == b.x and a.y == b.y and a.z == b.z and a.color == b.color and same_name(a.name, b.name)
}

// `MapDecoration.equals`.
fn same_decoration(a: Decoration, b: Decoration) -> bool {
    return a.kind == b.kind and a.x == b.x and a.y == b.y and a.rot == b.rot and same_name(a.name, b.name)
}

fn same_name(a: Tag?, b: Tag?) -> bool {
    return match a {
        some(x) => match b {
            some(y) => x.to_snbt() == y.to_snbt(),
            none => false,
        },
        none => b == none,
    }
}

// The player `entity`'s life `serial` among those in play, if they are.
fn carrier_of(players: List<Carrier>, entity: i32, serial: i64) -> Carrier? {
    for p in players {
        if p.entity == entity and p.serial == serial {
            return some(p.copy())
        }
    }
    return none
}

// The type of a `map_decorations` entry, by its ID in `map_decoration_type`.
fn decoration_kind(e: JavaHashMap<String, Tag>) -> i32? {
    if not e.contains("type") {
        return none
    }
    let Tag.Str(name) = e["type"] else return none
    let bare = if name.starts_with("minecraft:") { name[10..].copy() } else { name.copy() }
    let entries = builtin_entries(builtin_index("map_decoration_type") ?? 0)
    for i in 0..entries.len() {
        if entries[i] == bare {
            return some(i32.wrap(i))
        }
    }
    return none
}

fn builtin_index(name: str) -> usize? {
    let names = builtin_names()
    for i in 0..names.len() {
        if names[i] == name {
            return some(i)
        }
    }
    return none
}

// Java's `(int)` of a double: toward 0, NaN as 0, kept in an int's range.
fn java_cast(v: f64) -> i32 {
    if v != v {
        return 0
    }
    return i32.saturate(if v >= 0.0 { v.floor() } else { v.ceil() })
}

// `isInsideMap`.
fn inside_map(x: f32, y: f32) -> bool {
    return x >= -63.0f32 and y >= -63.0f32 and x <= 63.0f32 and y <= 63.0f32
}

// `clampMapCoordinate`.
fn clamp_coordinate(d: f32) -> i8 {
    if d <= -63.0f32 {
        return -128
    }
    if d >= 63.0f32 {
        return 127
    }
    return i8.wrap(java_cast(f64(d * 2.0f32) + 0.5))
}

// One more `n` of the color `c`, a `LinkedHashMultiset`'s `add`, each color where first added.
fn add_count(counts: mut List<(u32, i32)>, c: u32, n: i32) {
    for i in 0..counts.len() {
        if counts[i].0 == c {
            counts[i] = (c, counts[i].1 + n)
            return
        }
    }
    counts.push((c, n))
}

// The color counted most, the first added of those tied, `copyHighestCountFirst`'s first.
fn most_counted(counts: List<(u32, i32)>) -> u32 {
    var best = COLOR_NONE
    var most = 0
    for (c, n) in counts {
        if n > most {
            best = c
            most = n
        }
    }
    return best
}

/// A decoration's name as it's sent, the component its tag holds.
pub fn decoration_name(name: Tag?) -> Component? {
    let t = name else return none
    return match Component.from_nbt(t) {
        ok(c) => some(c),
        err(_) => none,
    }
}

// A name read leniently, as `lenientOptionalFieldOf` and `parseCustomNameSafe` read it: none
// where it isn't a component.
fn lenient_name(t: own Tag) -> Tag? {
    return match Component.from_nbt(t.copy()) {
        ok(_) => some(t),
        err(_) => none,
    }
}
