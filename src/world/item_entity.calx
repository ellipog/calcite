/// An item entity, a stack lying or flying in a level, as vanilla's `ItemEntity` runs it (CAL-148):
/// made with its random's UUID, spin and motion, then each tick as `ServerLevel.tickNonPassenger`
/// and `ItemEntity.tick` run it. Water and lava hold it up and slow it, else it falls 0.04 a tick;
/// fluids push it with their currents (`world.currents`); stuck in a block, it's pushed out the
/// nearest way; it moves as `Entity.move` moves it, `world.body`, against the blocks' shapes
/// (`world.movement`), stands on the block below it, slows by the air and that block's friction,
/// and bounces as that block makes it; a moving item looks to merge every 2 ticks and a still one
/// every 40; and it's gone after 6000 ticks, or 64 blocks below the level.
///
/// What blocks do to an item in or on them, `applyEffectsFromBlocks` (D435), is as for any entity,
/// `world.inside`'s, along the moves it made in its tick, or, at rest, along those they last acted
/// on it along: fire and lava light it and hurt it, cactus hurts it, water and rain put it out,
/// and with its health, 5, gone, it's destroyed, `hurtServer`, but where its stack resists the
/// damage, `damage_resistant`, as netherite resists fire. The block it's on acts on it,
/// `stepOn`: slime slows it and redstone ore's lit. What cobwebs, powder snow, honey, bubble
/// columns, pressure plates, hoppers and portals do to it is said to be missing, as is the fall
/// a long move clips short.
///
/// It's saved as `saveAsPassenger` saves it, `saved`, and loaded as `EntityType.create` makes one
/// and `load` reads it in, `loaded` (CAL-148). What it's saved with that Calcite doesn't run yet,
/// its fire, its name, its tags and the like, it keeps as it was loaded, and saves again.
module world.item_entity

import nbt.tag.{Tag}
import server.log.{Entry}
import world.attributes.{Wearing}
import world.body.{Body, BodyFacts, EntitySound, short_or, uuid_of, uuid_tag}
import world.collision.{CollisionBlocks}
import world.damage.{BYPASSES_INVULNERABILITY, DamageTypes, IS_FIRE, resists}
import world.inside.{Acted, BlockEffect, CLEAR_FREEZE, Collector, EXTINGUISH, FIRE_IGNITE, LAVA_IGNITE, Movement, Rain, Touched, doused, fluid_effects, inside_blocks, portal_missing, touch_block}
import world.movement.{MovementStates}
import worldgen.facts.{Facts}

/// How many ticks an item lasts, `LIFETIME`.
pub const LIFETIME: i32 = 6000
/// The pickup delay that never counts down, and the age that never counts up.
pub const INFINITE_PICKUP_DELAY: i32 = 32767
pub const INFINITE_LIFETIME: i32 = -32768

/// An item entity.
pub struct ItemEntity {
    /// What every entity has, `world.body`'s: 0.25 by 0.25, its eyes 0.2125 up, falling 0.04.
    pub body: Body
    /// The stack, as `ItemStack.CODEC` writes it.
    pub stack: Tag
    /// `bobOffs`, which only the client's renderer reads.
    pub bob: f32 = 0.0f32
    pub age: i32 = 0
    pub pickup_delay: i32 = 0
    pub health: i32 = 5
    /// Who threw it, and whom alone it's for, by UUID.
    pub thrower: (i64, i64)? = none
    pub target: (i64, i64)? = none
    /// Whether its stack was set since its tracker last sent its data, `DATA_ITEM` dirty.
    pub stack_changed: bool = false
    /// Whether it's due to look for others to merge with this tick.
    pub merge_due: bool = false
    /// Its shared flags, `DATA_SHARED_FLAGS_ID`, on fire, 1, and glowing, 64, and whether they
    /// changed since its tracker last sent its data (D435).
    pub flags: i8 = 0i8
    pub flags_changed: bool = false
    /// What blocks did that its level's to do, each with how many of its tick's sounds came
    /// before (D435).
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
    // Its motion as its tick began, after its first look at the fluids it's in.
    old_vx: f64 = 0.0
    old_vy: f64 = 0.0
    old_vz: f64 = 0.0
}

impl ItemEntity {
    /// An item of `stack` at x, y, z, with its own random seeded `seed`, as `new ItemEntity(level,
    /// x, y, z, stack)` makes one: its UUID, `bobOffs` and spin drawn, then its motion, up 0.2 and
    /// up to 0.1 across either way.
    pub fn new(id: i32, seed: i64, x: f64, y: f64, z: f64, stack: own Tag) -> ItemEntity {
        var e = ItemEntity.made(id, seed, x, y, z, stack)
        e.body.vx = e.body.random.next_double() * 0.2 - 0.1
        e.body.vy = 0.2
        e.body.vz = e.body.random.next_double() * 0.2 - 0.1
        return e
    }

    /// An item of `stack` at x, y, z moving vx, vy, vz, as `new ItemEntity(level, x, y, z, stack,
    /// dx, dy, dz)` makes one.
    pub fn moving(id: i32, seed: i64, x: f64, y: f64, z: f64, stack: own Tag, vx: f64, vy: f64, vz: f64) -> ItemEntity {
        var e = ItemEntity.made(id, seed, x, y, z, stack)
        e.body.vx = vx
        e.body.vy = vy
        e.body.vz = vz
        return e
    }

    // `Entity`'s fields, its random first, then its UUID; then `ItemEntity`'s `bobOffs`, then
    // its spin.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, stack: own Tag) -> ItemEntity {
        var body = Body.made(id, seed, x, y, z, 0.25f32, 0.25f32, 0.2125f32, 0.04)
        // Its sounds' source, `getSoundSource`, `AMBIENT` (D435).
        body.sound_source = 8
        let bob = body.random.next_float() * 3.1415927f32 * 2.0f32
        body.y_rot = body.random.next_float() * 360.0f32
        return ItemEntity { body: body, stack: stack, stack_changed: true, bob: bob }
    }

    /// What `saveAsPassenger` saves of it, put in the order vanilla puts it, which its compound's
    /// order follows (CAL-148): its type and what every entity saves, `world.body`'s; then
    /// `ItemEntity`'s health, age and pickup delay, as shorts, its thrower and owner, if it has
    /// them, and its stack, unless it's nothing.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:item")
        t.insert(String("Health"), Tag.Short(i16.wrap(self.health)))
        t.insert(String("Age"), Tag.Short(i16.wrap(self.age)))
        t.insert(String("PickupDelay"), Tag.Short(i16.wrap(self.pickup_delay)))
        if let thrower = self.thrower {
            t.insert(String("Thrower"), uuid_tag(thrower))
        }
        if let owner = self.target {
            t.insert(String("Owner"), uuid_tag(owner))
        }
        if not self.is_empty() {
            t.insert(String("Item"), self.stack.copy())
        }
        return Tag.Compound(t)
    }

    /// The item `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes an `ItemEntity` and `Entity.load` and `readAdditionalSaveData` read it in (CAL-148):
    /// what every entity reads, `world.body`'s; its health, age and pickup delay, with vanilla's
    /// defaults; its thrower and owner where they read as UUIDs; and `stack`, its `Item` as
    /// `ItemStack.CODEC` read it. `none` if its stack's nothing, which `readAdditionalSaveData`
    /// discards, or it's somewhere that isn't a number, which vanilla's load throws on, logged in
    /// `lines` as `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, stack: own Tag?, lines: mut List<Entry>) -> ItemEntity? {
        var e = ItemEntity.made(id, seed, 0.0, 0.0, 0.0, Tag.Compound(JavaHashMap<String, Tag>()))
        if not e.body.load_from(tag, mut lines) {
            return none
        }
        e.health = i32(short_or(tag, "Health", 5i16))
        e.age = i32(short_or(tag, "Age", 0i16))
        e.pickup_delay = i32(short_or(tag, "PickupDelay", 0i16))
        e.target = uuid_of(tag, "Owner")
        e.thrower = uuid_of(tag, "Thrower")
        e.stack = stack ?? Tag.Compound(JavaHashMap<String, Tag>())
        // Glowing, `setGlowingTag`, sets its flag, which its tracker's first run sends (D435).
        if e.body.extras.contains("Glowing") {
            e.flags = 64i8
            e.flags_changed = true
        }
        if e.is_empty() {
            return none
        }
        return some(e)
    }

    /// Whether its stack is nothing, `ItemStack.isEmpty`.
    pub fn is_empty(self) -> bool {
        if self.count() <= 0 {
            return true
        }
        let Tag.Compound(m) = self.stack else return true
        if not m.contains("id") {
            return true
        }
        return match m["id"] {
            Tag.Str(name) => name == "minecraft:air",
            _ => true,
        }
    }

    /// The first part of its tick, up to where it looks for others to merge with, as
    /// `tickNonPassenger` and `ItemEntity.tick` run it among `blocks`, in a level whose floor is
    /// `min_y`, where lava's fast if `fast_lava`: `merge_due` says whether it's to look. Its hurts
    /// are of `types`, its stack's components read by `items` (D435).
    pub fn tick_moving<B: CollisionBlocks + Rain, W: Wearing>(mut self, f: Facts, m: MovementStates, t: BodyFacts, types: DamageTypes, items: W, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.merge_due = false
        // `commonTick`.
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        if self.is_empty() {
            self.body.removed = true
            return
        }
        // `baseTick`: its portal cooldown, `handlePortal`; its fluids; its fire, a tick of it gone,
        // burning it, 1 of `on_fire`, every 20 out of lava (D435); then halving the fall in lava,
        // then below the level, then its flag, `setSharedFlagOnFire`.
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        _ = self.body.update_fluids(f, t, blocks, fast_lava, true, mut sounds)
        if self.body.fire > 0 {
            let immune = self.fire_immune(types, items)
            if self.body.fire_tick(immune) {
                _ = self.hurt(types, items, types.id("on_fire"), 1.0f32, sounds.len())
            }
        }
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let shown = self.body.fire_shown()
        self.set_on_fire(shown)
        self.body.first_tick = false
        if self.pickup_delay > 0 and self.pickup_delay != INFINITE_PICKUP_DELAY {
            self.pickup_delay -= 1
        }
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.old_vx = self.body.vx
        self.old_vy = self.body.vy
        self.old_vz = self.body.vz
        if self.body.in_water and self.body.water > f64(0.1f32) {
            self.fluid_movement(f64(0.99f32))
        } else if self.body.in_lava() and self.body.lava > f64(0.1f32) {
            self.fluid_movement(f64(0.95f32))
        } else if not self.body.no_gravity {
            self.body.vy = self.body.vy + -0.04
        }
        // Stuck in a block, pushed out the nearest way.
        let b = self.body.bounding_box()
        self.body.no_physics = not m.colliders(f, blocks, b.deflate(1.0e-7), self.body.mover()).is_empty()
        if self.body.no_physics {
            let (x, z) = (self.body.x, self.body.z)
            self.body.closest_space(f, blocks, x, (b.min_y + b.max_y) / 2.0, z)
        }
        if self.body.on_ground and not (self.body.vx * self.body.vx + self.body.vz * self.body.vz > f64(1.0e-5f32)) and (self.body.tick_count + self.body.id) % 4 != 0 {
            // At rest, what blocks do to it along the moves they last acted on it along,
            // `applyEffectsFromBlocksForLastMovements` (D435).
            let last = self.body.last_moves.copy()
            self.blocks_act(f, t, types, items, blocks, last, mut sounds)
        } else {
            let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
            self.body.move_by(f, m, t, blocks, vx, vy, vz)
            // What blocks do to it along its moves, `applyEffectsFromBlocks` (D435).
            let moves = self.body.final_moves()
            self.blocks_act(f, t, types, items, blocks, moves, mut sounds)
            let air = 0.98f32
            var ground = air
            if self.body.on_ground {
                let (bx, by, bz) = self.body.on_pos(f, t, blocks, 0.999999f32)
                ground = ground * m.friction(f.block(blocks.collision_state(bx, by, bz) ?? 0))
            }
            self.body.vx = self.body.vx * f64(ground)
            self.body.vy = self.body.vy * f64(air)
            self.body.vz = self.body.vz * f64(ground)
            if self.body.on_ground and self.body.vy < 0.0 {
                self.body.vx = self.body.vx * 1.0
                self.body.vy = self.body.vy * -0.5
                self.body.vz = self.body.vz * 1.0
            }
        }
        let went = self.body.xo.floor() != self.body.x.floor() or self.body.yo.floor() != self.body.y.floor() or self.body.zo.floor() != self.body.z.floor()
        let rate = if went { 2 } else { 40 }
        self.merge_due = self.body.tick_count % rate == 0
    }

    /// The rest of its tick, after it's looked to merge: its age, its fluids again, whether its
    /// motion changed enough to send, and its going at 6000 ticks.
    pub fn tick_after<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.age != INFINITE_LIFETIME {
            self.age += 1
        }
        let any = self.body.update_fluids(f, t, blocks, fast_lava, true, mut sounds)
        self.body.needs_sync = self.body.needs_sync or any
        let dx = self.body.vx - self.old_vx
        let dy = self.body.vy - self.old_vy
        let dz = self.body.vz - self.old_vz
        if dx * dx + dy * dy + dz * dz > 0.01 {
            self.body.needs_sync = true
        }
        if self.age >= LIFETIME {
            self.body.removed = true
        }
    }

    /// Whether it can merge with another, `isMergable`: alive, with a pickup delay and age that
    /// count, younger than 6000 ticks, and less than `max` of it, its stack's most.
    pub fn mergable(self, max: i32) -> bool {
        return not self.body.removed and self.pickup_delay != INFINITE_PICKUP_DELAY and self.age != INFINITE_LIFETIME and self.age < LIFETIME and self.count() < max
    }

    /// How many of its item it has, 1 where its stack writes no count, as `count_of` reads it.
    pub fn count(self) -> i32 {
        let Tag.Compound(m) = self.stack else return 0
        if not m.contains("count") {
            return 1
        }
        return match m["count"] {
            Tag.Int(n) => n,
            _ => 1,
        }
    }

    /// Whether fire doesn't burn it, `fireImmune`: its stack resists `in_fire`, `damage_resistant`,
    /// as netherite does (D435).
    pub fn fire_immune<W: Wearing>(self, types: DamageTypes, items: W) -> bool {
        return resists(items.worn_component(self.stack.copy(), String("minecraft:damage_resistant")), types, types.id("in_fire"))
    }

    /// `ItemEntity.hurtServer` of `amount` of the damage type `kind` of `types`, with nothing
    /// causing it, its stack's components read by `items` (D435), whether it's hurt: not where
    /// it's gone, invulnerable to what doesn't bypass it, `Invulnerable`, or fire resistant
    /// against fire, `isInvulnerableToBase`, nor where its stack resists the type,
    /// `damage_resistant`, `canBeHurtBy`; else its motion's to be sent, `markHurt`, and its health
    /// less the whole of it, cut to a whole number, and with none left it's gone, what its stack
    /// holds, a shulker box's or a bundle's, said to be missing, `onDestroyed`, `heard` the sounds
    /// before. Its damage's vibration comes with sculk.
    pub fn hurt<W: Wearing>(mut self, types: DamageTypes, items: W, kind: i32, amount: f32, heard: usize) -> bool {
        if self.body.removed {
            return false
        }
        if self.body.invulnerable and not types.is(kind, BYPASSES_INVULNERABILITY) {
            return false
        }
        if types.is(kind, IS_FIRE) and self.fire_immune(types, items) {
            return false
        }
        if resists(items.worn_component(self.stack.copy(), String("minecraft:damage_resistant")), types, kind) {
            return false
        }
        self.body.sync_velocity = true
        self.health = i32.saturate(f32.nearest(self.health) - amount)
        if self.health <= 0 {
            if self.holds_any(items) {
                self.act(Acted.Missing(String("What shulker boxes and bundles hold dropped as they're destroyed")), heard)
            }
            self.body.removed = true
        }
        return true
    }

    // Whether its stack holds items its being destroyed would drop, a container's, as a shulker
    // box's, or a bundle's.
    fn holds_any<W: Wearing>(self, items: W) -> bool {
        for name in ["minecraft:container", "minecraft:bundle_contents"] {
            match items.worn_component(self.stack.copy(), String(name)) {
                some(Tag.List(l)) => {
                    if not l.is_empty() {
                        return true
                    }
                },
                _ => {},
            }
        }
        return false
    }

    // `applyEffectsFromBlocks` along `moves` (D435), where blocks act on it, as they don't on
    // what's gone or stuck in a block: what the block it's on does, `stepOn`; then what it's
    // inside, `touch_block`'s for an item, cactus's hurt at once, 1 of `cactus`, and fluids',
    // gathered and applied in their order, fire's hurt, 1 or 2 of `in_fire`, and lava's,
    // `lava_hurt`; then the rain, its going out heard and its wait, as for any entity.
    fn blocks_act<B: CollisionBlocks + Rain, W: Wearing>(mut self, f: Facts, t: BodyFacts, types: DamageTypes, items: W, blocks: B, moves: List<Movement>, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        let thrown = self.thrower != none
        if let a = self.body.step_on_block(f, t, blocks, thrown) {
            self.act(a, sounds.len())
        }
        let lit = self.body.fire > 0
        var immune = lit and self.fire_immune(types, items)
        let froze = self.body.extras.contains("TicksFrozen")
        let was = (self.body.burning(immune), froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                match touch_block(f, i, mut c, false, true, self.body.on_ground, self.body.y) {
                    Touched.Cactus => {
                        _ = self.hurt(types, items, types.id("cactus"), 1.0f32, sounds.len())
                    },
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Portal(_) => self.act(Acted.Missing(portal_missing()), sounds.len()),
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        let effects = c.finish()
        if not lit and not effects.is_empty() {
            immune = self.fire_immune(types, items)
        }
        for e in effects {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => self.apply_effect(kind, immune),
                BlockEffect.InFire(amount) => {
                    _ = self.hurt(types, items, types.id("in_fire"), amount, sounds.len())
                },
                BlockEffect.LavaHurt => self.lava_hurt(types, items, immune, mut sounds),
                BlockEffect.Doused(_) => {
                    if self.body.burning(immune) {
                        self.act(Acted.Missing(doused()), sounds.len())
                    }
                },
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.body.extras.contains("TicksFrozen")
        self.body.after_inside(immune, was, freezing, rained, mut sounds)
    }

    // One of the effects blocks put on it (D435), as on any entity, where fire burns it or not,
    // `immune`: its thawing, `clearFreeze`, which lets go the frozen ticks it was loaded with;
    // fire's lighting, `fireIgnite`, and lava's, 15 seconds of fire, `lavaIgnite`, each thawing it
    // too; its putting out, `clearFire`.
    fn apply_effect(mut self, kind: i32, immune: bool) {
        if kind == CLEAR_FREEZE {
            _ = self.body.extras.remove("TicksFrozen")
        } else if kind == FIRE_IGNITE {
            if self.body.fire_ignite(immune, 0) {
                _ = self.body.extras.remove("TicksFrozen")
            }
        } else if kind == LAVA_IGNITE {
            if not immune {
                self.body.ignite_for(300)
                _ = self.body.extras.remove("TicksFrozen")
            }
        } else if kind == EXTINGUISH {
            self.body.put_out()
        }
    }

    // `lavaHurt` (D435): where fire burns it, 4 of `lava`, and where that hurt it, the burn heard,
    // unless it's silent, its pitch drawn, as it's destroyed or every 10 ticks,
    // `shouldPlayLavaHurtSound`.
    fn lava_hurt<W: Wearing>(mut self, types: DamageTypes, items: W, immune: bool, sounds: mut List<EntitySound>) {
        if immune {
            return
        }
        let hurt = self.hurt(types, items, types.id("lava"), 4.0f32, sounds.len())
        if hurt and (self.health <= 0 or self.body.tick_count % 10 == 0) and not self.body.extras.contains("Silent") {
            let pitch = 2.0f32 + self.body.random.next_float() * 0.4f32
            sounds.push(EntitySound { sound: String("entity.generic.burn"), x: self.body.x, y: self.body.y, z: self.body.z, volume: 0.4f32, pitch: pitch, source: self.body.sound_source })
        }
    }

    // `setSharedFlagOnFire`'s flag, which changes its data where it's other than it was.
    fn set_on_fire(mut self, on: bool) {
        let flags = if on { self.flags | 1i8 } else { self.flags & -2i8 }
        if flags != self.flags {
            self.flags = flags
            self.flags_changed = true
        }
    }

    // What a block did that its level's to do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }

    // `setFluidMovement`: slowed across by `by`, and held up a little while it isn't rising fast.
    fn fluid_movement(mut self, by: f64) {
        let up = if self.body.vy < f64(0.06f32) { f64(5.0e-4f32) } else { f64(0.0f32) }
        self.body.vx = self.body.vx * by
        self.body.vy = self.body.vy + up
        self.body.vz = self.body.vz * by
    }
}
