/// What an item is as it's used up ([CAL-163], D519), vanilla's `Consumable` and `FoodProperties`
/// components as their codecs read them: how long using it takes, how it's shown, its sound,
/// whether its particles are made and what it does as it's used up, `world.consume_effects`; and
/// the food it gives. Using one over time, and what it does as it's used up, is
/// `server.network`'s.
///
/// [CAL-163]: https://acta.aaenz.no/aaen-studios/calcite#CAL-163
module world.consumable

import nbt.tag.{Tag}
import world.consume_effects.{ConsumeEffect, read_consume_effects, sound_of}
import world.effects.{ActiveEffect}

/// `Consumable`: its `consume_seconds`; its `animation`, by its name, `eat` or `drink` for food
/// and drink; its `sound`; whether its particles are made, `has_consume_particles`; and its
/// `on_consume_effects`. `read_consumable` makes one with the codec's defaults, eaten with
/// `entity.generic.eat`.
pub struct Consumable {
    pub seconds: f32 = 1.6f32
    pub animation: String
    pub sound: String
    pub particles: bool = true
    pub effects: List<ConsumeEffect> = List<ConsumeEffect>()
}

impl Consumable {
    /// `consumeTicks`: its seconds as ticks, cut to a whole number, `(int)`.
    pub fn ticks(self) -> i32 {
        return i32.saturate(self.seconds * 20.0f32)
    }

    /// Whether it's drunk, its animation `ItemUseAnimation.DRINK`, which its sound's volume and
    /// pitch and its game event follow; else it's eaten.
    pub fn drinks(self) -> bool {
        return self.animation == "drink"
    }

    /// `shouldEmitParticlesAndSounds` with `remaining` ticks of its use left: once it's been used
    /// for more than the first 0.21875 of its ticks, cut to a whole number, on every fourth tick.
    pub fn emits(self, remaining: i32) -> bool {
        let ticks = self.ticks()
        let used = ticks - remaining
        let wait = i32.saturate(f32.nearest(ticks) * 0.21875f32)
        return used > wait and remaining % 4 == 0
    }
}

/// The `consumable` component `tag` as `Consumable.CODEC` reads it, each field its default where
/// it's missing: none where it isn't a compound or a field doesn't read, as the seconds below 0,
/// `NON_NEGATIVE_FLOAT`, or an animation that isn't one.
pub fn read_consumable(tag: Tag) -> Consumable? {
    let Tag.Compound(m) = tag else return none
    var c = Consumable { animation: String("eat"), sound: String("minecraft:entity.generic.eat") }
    if m.contains("consume_seconds") {
        let s = m["consume_seconds"].number_float() else return none
        if not (s >= 0.0f32) {
            return none
        }
        c.seconds = s
    }
    if m.contains("animation") {
        let Tag.Str(named) = m["animation"] else return none
        // `ItemUseAnimation`'s, by their names.
        let animations: List<str> = ["none", "eat", "drink", "block", "bow", "trident", "crossbow", "spyglass", "toot_horn", "brush", "bundle", "spear"]
        var known = false
        for a in animations {
            if named == String(a) {
                known = true
            }
        }
        if not known {
            return none
        }
        c.animation = named.copy()
    }
    if m.contains("sound") {
        let s = sound_of(m["sound"].copy()) else return none
        c.sound = s
    }
    if m.contains("has_consume_particles") {
        let p = m["has_consume_particles"].number_bool() else return none
        c.particles = p
    }
    if m.contains("on_consume_effects") {
        let effects = read_consume_effects(m["on_consume_effects"].copy()) else return none
        c.effects = effects
    }
    return some(c)
}

/// `FoodProperties`: the food it gives, `nutrition`; the saturation, `saturation`; and whether
/// it may be eaten when full, `can_always_eat`.
pub struct Food {
    pub nutrition: i32 = 0
    pub saturation: f32 = 0.0f32
    pub always: bool = false
}

/// The `food` component `tag` as `FoodProperties.DIRECT_CODEC` reads it: none where it isn't a
/// compound, its nutrition or saturation is missing or doesn't read, or its nutrition is below 0,
/// `NON_NEGATIVE_INT`.
pub fn read_food(tag: Tag) -> Food? {
    let Tag.Compound(m) = tag else return none
    if not m.contains("nutrition") or not m.contains("saturation") {
        return none
    }
    let nutrition = m["nutrition"].number_int() else return none
    if nutrition < 0 {
        return none
    }
    let saturation = m["saturation"].number_float() else return none
    var always = false
    if m.contains("can_always_eat") {
        let a = m["can_always_eat"].number_bool() else return none
        always = a
    }
    return some(Food { nutrition: nutrition, saturation: saturation, always: always })
}

/// The effects a suspicious stew gives, its `suspicious_stew_effects` `tag` as
/// `SuspiciousStewEffects.CODEC` reads it, `Entry.createEffectInstance`: each its effect for its
/// `duration`, 160 ticks where it's left out, at its first level; none where it isn't a list,
/// and an entry that doesn't read left out.
pub fn stew_effects(tag: Tag) -> List<ActiveEffect> {
    var out = List<ActiveEffect>()
    let Tag.List(entries) = tag else return out
    for entry in entries {
        let Tag.Compound(m) = entry else continue
        if not m.contains("id") {
            continue
        }
        let duration = if m.contains("duration") { m["duration"].number_int() ?? 160 } else { 160 }
        var made = JavaHashMap<String, Tag>()
        made.insert(String("id"), m["id"].copy())
        made.insert(String("duration"), Tag.Int(duration))
        if let e = ActiveEffect.read(Tag.Compound(made)) {
            out.push(e)
        }
    }
    return out
}

/// The bad omen an ominous bottle gives, its `ominous_bottle_amplifier` `tag` its level,
/// `OminousBottleAmplifier.onConsume`: for 120000 ticks, not ambient, its particles hidden and
/// its icon shown; none where the level isn't from 0 to 4, `intRange(0, 4)`.
pub fn bad_omen(tag: Tag) -> ActiveEffect? {
    let amplifier = tag.number_int() else return none
    if amplifier < 0 or amplifier > 4 {
        return none
    }
    var made = JavaHashMap<String, Tag>()
    made.insert(String("id"), Tag.Str(String("minecraft:bad_omen")))
    made.insert(String("duration"), Tag.Int(120000))
    made.insert(String("amplifier"), Tag.Byte(i8.wrap(amplifier)))
    made.insert(String("show_particles"), Tag.Byte(0i8))
    made.insert(String("show_icon"), Tag.Byte(1i8))
    return ActiveEffect.read(Tag.Compound(made))
}
