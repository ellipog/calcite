/// The block entities' tickers on a server's level (CAL-130): which block entities tick, by the
/// ticker their block's `getTicker` gives on the server, and what each tick does. A daylight
/// detector's tick is vanilla's, a crafter's counting down, and an end gateway's (D592). The
/// others do nothing where, as
/// Calcite has them, vanilla's do nothing either: signs no one's editing, bells with no raiders by
/// them, and hoppers, furnaces, brewing stands, campfires, conduits, hives, spawners and sculk
/// with nothing to do. A beacon's tick is `world.beacon`'s (D520). A jukebox plays its song as
/// vanilla's does (CAL-143), and a shulker box's lid opens and closes as vanilla's does
/// (CAL-144). Where they've something to do, and for the tickers that always do something, what's
/// missing is said.
module world.block_entity_ticks

import math.mth.{table_cos}
import nbt.tag.{Tag}
import random.source.{RandomSource}
import registry.songs.{JukeboxSong}
import world.beacon.{beacon_tick}
import world.block_level.{BlockLevel, update_output_signal}
import world.containers.{shulker_tick}
import world.level_writer.{UPDATE_LIMIT}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

/// The tickers, as `getTicker` gives them on a server: none; a moving piston's, which the level
/// runs by `world.pistons`; and the others, each its block entity class's.
pub const NO_TICKER: i32 = -1
pub const PISTON_TICKER: i32 = 0
const DAYLIGHT_TICKER: i32 = 1
const IDLE_TICKER: i32 = 2
const HOPPER_TICKER: i32 = 3
const FURNACE_TICKER: i32 = 4
const BREWING_TICKER: i32 = 5
const COOKING_TICKER: i32 = 6
const COOLING_TICKER: i32 = 7
const BEACON_TICKER: i32 = 8
const CONDUIT_TICKER: i32 = 9
const BEEHIVE_TICKER: i32 = 10
const SPAWNER_TICKER: i32 = 11
const CRAFTER_TICKER: i32 = 12
const VIBRATION_TICKER: i32 = 13
const CATALYST_TICKER: i32 = 14
const JUKEBOX_TICKER: i32 = 15
const TRIAL_SPAWNER_TICKER: i32 = 16
const VAULT_TICKER: i32 = 17
const CREAKING_HEART_TICKER: i32 = 18
const END_GATEWAY_TICKER: i32 = 19
const POTENT_SULFUR_TICKER: i32 = 20
const SHULKER_TICKER: i32 = 21

/// `state.getTicker(level, type)` on a server's level, for a block entity of the type `kind`, as
/// `minecraft:hopper`, on `state`, in a dimension with sky light if `sky_light`: its ticker, or
/// `NO_TICKER`. Skulls, chests, ender chests and enchanting tables tick on the client alone; a
/// campfire's ticker is as it's lit or not; and jukeboxes tick with a record, creaking hearts that
/// aren't uprooted, potent sulfur that isn't dry and daylight detectors under a sky.
pub fn ticker_of(f: Facts, sky_light: bool, kind: String, state: u32) -> i32 {
    if kind == "minecraft:piston" {
        return PISTON_TICKER
    }
    if kind == "minecraft:daylight_detector" {
        return if sky_light { DAYLIGHT_TICKER } else { NO_TICKER }
    }
    if kind == "minecraft:sign" or kind == "minecraft:hanging_sign" or kind == "minecraft:bell" {
        return IDLE_TICKER
    }
    if kind == "minecraft:shulker_box" {
        return SHULKER_TICKER
    }
    if kind == "minecraft:hopper" {
        return HOPPER_TICKER
    }
    if kind == "minecraft:furnace" or kind == "minecraft:blast_furnace" or kind == "minecraft:smoker" {
        return FURNACE_TICKER
    }
    if kind == "minecraft:brewing_stand" {
        return BREWING_TICKER
    }
    if kind == "minecraft:campfire" {
        return if f.get_bool(state, "lit") { COOKING_TICKER } else { COOLING_TICKER }
    }
    if kind == "minecraft:beacon" {
        return BEACON_TICKER
    }
    if kind == "minecraft:conduit" {
        return CONDUIT_TICKER
    }
    if kind == "minecraft:beehive" {
        return BEEHIVE_TICKER
    }
    if kind == "minecraft:mob_spawner" {
        return SPAWNER_TICKER
    }
    if kind == "minecraft:crafter" {
        return CRAFTER_TICKER
    }
    if kind == "minecraft:sculk_sensor" or kind == "minecraft:calibrated_sculk_sensor" or kind == "minecraft:sculk_shrieker" {
        return VIBRATION_TICKER
    }
    if kind == "minecraft:sculk_catalyst" {
        return CATALYST_TICKER
    }
    if kind == "minecraft:jukebox" {
        return if f.get_bool(state, "has_record") { JUKEBOX_TICKER } else { NO_TICKER }
    }
    if kind == "minecraft:trial_spawner" {
        return TRIAL_SPAWNER_TICKER
    }
    if kind == "minecraft:vault" {
        return VAULT_TICKER
    }
    if kind == "minecraft:creaking_heart" {
        return if (f.get_name(state, "creaking_heart_state") ?? String()) == "uprooted" { NO_TICKER } else { CREAKING_HEART_TICKER }
    }
    if kind == "minecraft:end_gateway" {
        return END_GATEWAY_TICKER
    }
    if kind == "minecraft:potent_sulfur" {
        return if (f.get_name(state, "potent_sulfur_state") ?? String()) == "dry" { NO_TICKER } else { POTENT_SULFUR_TICKER }
    }
    return NO_TICKER
}

/// The tick of the block entity at `x`, `y`, `z`, on the block `state`, by its ticker `ticker`,
/// `first` if it's the first since the block entity was made, as `BoundTickingBlockEntity.tick`
/// runs it once the level's checked it may; not a moving piston's.
pub fn tick_block_entity<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, ticker: i32, first: bool, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if ticker == IDLE_TICKER {
        return
    }
    if ticker == DAYLIGHT_TICKER {
        // `DaylightDetectorBlock.tickEntity`: once a second, by the game time.
        if level.time_now() % 20 == 0 {
            try update_signal_strength(f, mut level, state, x, y, z)
        }
        return
    }
    if ticker == HOPPER_TICKER {
        try hopper_tick(f, mut level, state, x, y, z)
        return
    }
    if ticker == SHULKER_TICKER {
        try shulker_tick(f, mut level, state, x, y, z)
        return
    }
    if ticker == CRAFTER_TICKER {
        try crafter_tick(f, mut level, state, x, y, z)
        return
    }
    if ticker == BREWING_TICKER {
        try brewing_tick(f, mut level, first, state, x, y, z)
        return
    }
    let tags = tags_at(level, x, y, z)
    if ticker == FURNACE_TICKER {
        // `AbstractFurnaceBlockEntity.serverTick`: lit, or with fuel and something to cook, or
        // part way through cooking, its cooking goes on, which needs recipes.
        if (int_at(tags, "lit_time_remaining") ?? 0) > 0 or (int_at(tags, "cooking_time_spent") ?? 0) > 0 or (holds(tags, 0) and holds(tags, 1)) {
            fail Thrown { exception: "Unimplemented", message: "A furnace's cooking" }
        }
        return
    }
    if ticker == COOKING_TICKER {
        // `CampfireBlockEntity.cookTick`: what's on it cooks, which needs recipes.
        if holds_any(tags) {
            fail Thrown { exception: "Unimplemented", message: "A campfire's cooking" }
        }
        return
    }
    if ticker == COOLING_TICKER {
        // `cooldownTick`: what was cooking on it cools, its progress going back.
        if any_positive(tags, "CookingTimes") {
            fail Thrown { exception: "Unimplemented", message: "A campfire's cooking cooling" }
        }
        return
    }
    if ticker == BEACON_TICKER {
        // `BeaconBlockEntity.tick` (D520).
        try beacon_tick(f, mut level, x, y, z)
        return
    }
    if ticker == CONDUIT_TICKER {
        // `ConduitBlockEntity.serverTick`: every 40 ticks its shape, `updateShape`, which only
        // water all about it can make whole.
        if level.time_now() % 40 == 0 and try in_water(f, level, x, y, z) {
            fail Thrown { exception: "Unimplemented", message: "A conduit's frame and effects" }
        }
        return
    }
    if ticker == BEEHIVE_TICKER {
        // `BeehiveBlockEntity.serverTick`: the bees in it, which leave in time and, one tick in
        // 200, buzz, drawn from the level's random.
        if list_len(tags, "bees") > 0 {
            fail Thrown { exception: "Unimplemented", message: "A hive's bees" }
        }
        return
    }
    if ticker == SPAWNER_TICKER {
        // `BaseSpawner.serverTick`: nothing with no player near enough, `isNearPlayer`.
        let range = f64(short_at(tags, "RequiredPlayerRange") ?? 16)
        if level.player_within(f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, range) {
            fail Thrown { exception: "Unimplemented", message: "A spawner near a player" }
        }
        return
    }
    if ticker == VIBRATION_TICKER {
        // `VibrationSystem.Ticker.tick`: a vibration it's heard, or chosen to hear, travels to it,
        // which comes with game events.
        let listener = compound_at(tags, "listener")
        if listener.contains("event") or compound_at(listener, "selector").contains("event") {
            fail Thrown { exception: "Unimplemented", message: "A vibration travelling to sculk" }
        }
        return
    }
    if ticker == CATALYST_TICKER {
        // `SculkSpreader.updateCursors`: nothing with no charge spreading.
        if list_len(tags, "cursors") > 0 {
            fail Thrown { exception: "Unimplemented", message: "Sculk spreading from a catalyst" }
        }
        return
    }
    if ticker == JUKEBOX_TICKER {
        // `JukeboxSongPlayer.tick`: a song playing goes on a tick, without `setChanged`, its note
        // sent every 20 ticks from its start, of a color drawn from the level's random, with its
        // game event, which waits for game events; once it's finished, it stops (CAL-143).
        let (song, elapsed) = playing_song(level, tags) else return
        if song.finished(elapsed) {
            try stop_song(f, mut level, state, x, y, z)
            return
        }
        if elapsed % 20 == 0 {
            let color = f32.nearest(f64(level.next_int_below(4))) / 24.0f32
            level.send_particles("note", f64(x) + 0.5, f64(y) + f64(1.2f32), f64(z) + 0.5, 0, f64(color), 0.0, 0.0, 1.0)
        }
        level.keep_block_entity_value(x, y, z, "ticks_since_song_started", Tag.Long(elapsed + 1))
        return
    }
    if ticker == TRIAL_SPAWNER_TICKER {
        fail Thrown { exception: "Unimplemented", message: "A trial spawner's tick" }
    }
    if ticker == VAULT_TICKER {
        fail Thrown { exception: "Unimplemented", message: "A vault's tick" }
    }
    if ticker == CREAKING_HEART_TICKER {
        fail Thrown { exception: "Unimplemented", message: "A creaking heart's tick" }
    }
    if ticker == END_GATEWAY_TICKER {
        try gateway_tick(f, mut level, state, x, y, z)
        return
    }
    if ticker == POTENT_SULFUR_TICKER {
        fail Thrown { exception: "Unimplemented", message: "Potent sulfur's tick" }
    }
}

/// How many ticks an end gateway cools down for once something's gone through it or its age
/// has come to a whole number of `GATEWAY_ATTENTION` ticks, `COOLDOWN_TIME`; that number,
/// `ATTENTION_INTERVAL`; and how many ticks of its age it's spawning for, `SPAWN_TIME` (D592).
pub const GATEWAY_COOLDOWN: i32 = 40
const GATEWAY_ATTENTION: i64 = 2400
const GATEWAY_SPAWNING: i64 = 200

// `TheEndGatewayBlockEntity.portalTick` of the end gateway `state` at x, y, z (D592): a tick
// older, `Age`, kept for when its chunk next saves; cooling down, its cooldown, which its level
// keeps unsaved, a tick less, else, where its age has come to a whole number of 2400 ticks, its
// cooldown begun again, `trigger_cooldown`; then `setChanged`, its chunk changed and the
// comparators by it told, where it's come out of its first 200 ticks, `isSpawning`, or its
// cooldown's begun or ended.
fn gateway_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let tags = tags_at(level, x, y, z)
    let was = if tags.contains("Age") { tags["Age"].number_long() ?? 0 } else { 0 }
    let cooling = level.gateway_cooldown(x, y, z)
    let age = was.wrapping_add(1)
    var cooldown = cooling
    if cooling > 0 {
        cooldown = cooling - 1
        level.set_gateway_cooldown(x, y, z, cooldown)
    } else if age % GATEWAY_ATTENTION == 0 {
        try trigger_cooldown(f, mut level, state, x, y, z)
        cooldown = GATEWAY_COOLDOWN
    }
    if (was < GATEWAY_SPAWNING) != (age < GATEWAY_SPAWNING) or (cooling > 0) != (cooldown > 0) {
        level.set_block_entity_value(x, y, z, "Age", Tag.Long(age))
        try update_output_signal(f, mut level, f.block(state), x, y, z)
    } else {
        level.keep_block_entity_value(x, y, z, "Age", Tag.Long(age))
    }
}

/// `TheEndGatewayBlockEntity.triggerCooldown` of the end gateway `state` at `x`, `y`, `z`
/// (D592): its cooldown 40 ticks, block event 1, 0 kept for its level to run, which sets it 40
/// again and sends it its players near, and `setChanged`.
pub fn trigger_cooldown<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let block = f.block(state)
    level.set_gateway_cooldown(x, y, z, GATEWAY_COOLDOWN)
    level.block_event(x, y, z, block, 1, 0)
    level.touch_block_entity(x, y, z)
    try update_output_signal(f, mut level, block, x, y, z)
}

/// `DaylightDetectorBlock.updateSignalStrength`: the sky's light at the block less its darkening,
/// `getEffectiveSkyBrightness`; inverted, 15 less it; else, if there's any, it times the cosine of
/// the sun's angle in radians, `SUN_ANGLE`, eased a fifth of the way to the nearer of 0 and a whole
/// turn, `Mth.cos`, rounded, `Math.round`; within 0 to 15, and set, with flags 3, where it's not
/// what the detector puts out.
pub fn update_signal_strength<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    var s = (level.sky_light(x, y, z) - level.sky_darken()).max(0)
    var angle = level.sun_angle_at(x, y, z) * 0.017453292f32
    if f.get_bool(state, "inverted") {
        s = 15 - s
    } else if s > 0 {
        let target = if angle < 3.1415927f32 { 0.0f32 } else { 6.2831855f32 }
        angle = angle + (target - angle) * 0.2f32
        s = round_float(f32.nearest(f64(s)) * table_cos(f64(angle)))
    }
    s = s.max(0).min(15)
    if (f.get_int(state, "power") ?? 0) != s {
        _ = level.set_block_limited(x, y, z, try f.with_int(state, "power", s), 3, UPDATE_LIMIT)
    }
}

// `Math.round` of a float: the nearest whole number, halves up, 0 for NaN.
fn round_float(v: f32) -> i32 {
    let d = f64(v)
    if d.is_nan() {
        return 0
    }
    let down = d.floor()
    return i32.saturate(if d - down >= 0.5 { down + 1.0 } else { down })
}

// `HopperBlockEntity.pushItemsTick`: its cooldown counted down, kept as the field it saves as,
// and once it's run out, 0, its items moved if it's enabled, `tryMoveItems`: pushed into what it
// faces if it holds any, `ejectItems`, and pulled from above if it isn't full, `suckInItems`.
// Moving items into or out of a container, which comes with items, is said; with none to move
// them to or from, as with no item entities above, of which Calcite has none yet, none move.
fn hopper_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let tags = tags_at(level, x, y, z)
    let had = int_at(tags, "TransferCooldown") ?? -1
    let cooldown = had - 1
    if cooldown > 0 {
        level.keep_block_entity_value(x, y, z, "TransferCooldown", Tag.Int(cooldown))
        return
    }
    if had != 0 {
        level.keep_block_entity_value(x, y, z, "TransferCooldown", Tag.Int(0))
    }
    if not f.get_bool(state, "enabled") {
        return
    }
    let (stacks, full) = hopper_stacks(tags)
    if stacks > 0 {
        let facing = f.get_name(state, "facing") ?? String("down")
        let (dx, dy, dz) = if facing == "north" { (0, 0, -1) } else if facing == "south" { (0, 0, 1) } else if facing == "west" { (-1, 0, 0) } else if facing == "east" { (1, 0, 0) } else { (0, -1, 0) }
        if try container_at(f, level, x + dx, y + dy, z + dz) {
            fail Thrown { exception: "Unimplemented", message: "A hopper pushing items" }
        }
    }
    if not full and try container_at(f, level, x, y + 1, z) {
        fail Thrown { exception: "Unimplemented", message: "A hopper pulling items" }
    }
}

// How many of a hopper's 5 slots hold something, and whether each holds 64, the most any stack
// can, `inventoryFull`; where a slot's item stacks to less, it's taken as not full.
fn hopper_stacks(tags: JavaHashMap<String, Tag>) -> (i32, bool) {
    var n = 0
    var full = true
    for item in list_at(tags, "Items") {
        let stack = match item {
            Tag.Compound(s) => s.copy(),
            _ => continue,
        }
        n += 1
        if (int_at(stack, "count") ?? 1) < 64 {
            full = false
        }
    }
    return (n, full and n >= 5)
}

// `HopperBlockEntity.getContainerAt` of a block alone: a composter, `WorldlyContainerHolder`, or a
// block whose block entity is a `Container`.
fn container_at<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not level.is_loaded(x, y, z) {
        return false
    }
    let block = f.block(try level.state(f, x, y, z))
    if f.class_name(block) == "ComposterBlock" {
        return true
    }
    let kind = f.block_entity_kind(block) else return false
    let containers: List<str> = ["minecraft:chest", "minecraft:trapped_chest", "minecraft:barrel", "minecraft:dispenser", "minecraft:dropper", "minecraft:hopper", "minecraft:furnace", "minecraft:blast_furnace", "minecraft:smoker", "minecraft:brewing_stand", "minecraft:shulker_box", "minecraft:crafter", "minecraft:chiseled_bookshelf", "minecraft:decorated_pot", "minecraft:jukebox", "minecraft:shelf"]
    for c in containers {
        if kind == String(c) {
            return true
        }
    }
    return false
}

// `CrafterBlockEntity.serverTick`: its crafting counted down, kept as the field it saves as,
// and, as it reaches 0, the crafter set no longer crafting, with flags 3.
fn crafter_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let left = (int_at(tags_at(level, x, y, z), "crafting_ticks_remaining") ?? 0) - 1
    if left < 0 {
        return
    }
    level.keep_block_entity_value(x, y, z, "crafting_ticks_remaining", Tag.Int(left))
    if left == 0 {
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "crafting", false), 3, UPDATE_LIMIT)
    }
}

// `BrewingStandBlockEntity.serverTick`: with anything in it, or brewing, its brewing goes on,
// which needs recipes, and its bottles shown; empty, the bottles it shows, `HAS_BOTTLE`, are set
// to none, with flags 2, the first time it ticks, as `lastPotionCount` starts as none.
fn brewing_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, first: bool, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let tags = tags_at(level, x, y, z)
    if holds_any(tags) or (int_at(tags, "BrewTime") ?? 0) > 0 {
        fail Thrown { exception: "Unimplemented", message: "A brewing stand's brewing" }
    }
    if not first {
        return
    }
    var shown = state
    for i in 0..3 {
        shown = try f.with_bool(shown, "has_bottle_{i}", false)
    }
    _ = level.set_block_limited(x, y, z, shown, 2, UPDATE_LIMIT)
}

// `ConduitBlockEntity.updateShape`'s first test: water in each of the 27 blocks about it, itself
// among them, `isWaterAt`.
fn in_water<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    for dx in -1..2 {
        for dy in -1..2 {
            for dz in -1..2 {
                if not level.is_loaded(x + dx, y + dy, z + dz) or not f.is_water(try level.state(f, x + dx, y + dy, z + dz)) {
                    return false
                }
            }
        }
    }
    return true
}

// The block entity at the place as it saves, its fields, or none, as a fresh one with nothing
// set reads.
/// The song a jukebox saved as `tags` plays and how many ticks it's been playing,
/// `ticks_since_song_started`, which it saves only while it plays: its record's song, if the world
/// has it and it isn't past its end, `none` for a jukebox playing nothing (CAL-143).
pub fn playing_song<L: BlockAccess>(level: L, tags: JavaHashMap<String, Tag>) -> (JukeboxSong, i64)? {
    if not tags.contains("ticks_since_song_started") or not tags.contains("RecordItem") {
        return none
    }
    let song = level.jukebox_song(tags["RecordItem"].copy()) else return none
    let elapsed = tags["ticks_since_song_started"].number_long() ?? 0
    if not song.playing(elapsed) {
        return none
    }
    return some((song, elapsed))
}

/// `JukeboxSongPlayer.play` of `song` by the jukebox `block` at `x`, `y`, `z`: from its start, the
/// level event 1010 with the song's ID for everyone, then `onSongChanged` (CAL-143).
pub fn play_song<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, block: u32, song: JukeboxSong, x: i32, y: i32, z: i32) ! Thrown {
    level.set_block_entity_value(x, y, z, "ticks_since_song_started", Tag.Long(0))
    level.level_event(1010, x, y, z, song.id)
    try song_changed(f, mut level, block, x, y, z)
}

/// `JukeboxSongPlayer.stop` of the song the jukebox `state` at `x`, `y`, `z` plays: it plays none,
/// with its game event, which waits for game events, and the level event 1011 for everyone, then
/// `onSongChanged` (CAL-143).
pub fn stop_song<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    level.remove_block_entity_value(x, y, z, "ticks_since_song_started")
    level.level_event(1011, x, y, z, 0)
    try song_changed(f, mut level, f.block(state), x, y, z)
}

/// `JukeboxBlockEntity.onSongChanged` of the jukebox `block` at `x`, `y`, `z`: the blocks around
/// told, then `setChanged`, the comparators by it told (CAL-143).
pub fn song_changed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, block: u32, x: i32, y: i32, z: i32) ! Thrown {
    level.update_neighbours(x, y, z, block)
    try update_output_signal(f, mut level, block, x, y, z)
}

fn tags_at<L: BlockAccess>(level: L, x: i32, y: i32, z: i32) -> JavaHashMap<String, Tag> {
    let saved = level.block_entity_tag(x, y, z) else return JavaHashMap<String, Tag>()
    return match saved {
        Tag.Compound(t) => t,
        _ => JavaHashMap<String, Tag>(),
    }
}

fn compound_at(tags: JavaHashMap<String, Tag>, key: str) -> JavaHashMap<String, Tag> {
    if not tags.contains(key) {
        return JavaHashMap<String, Tag>()
    }
    return match tags[key] {
        Tag.Compound(t) => t.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

fn int_at(tags: JavaHashMap<String, Tag>, key: str) -> i32? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Int(v) => some(v),
        _ => none,
    }
}

fn short_at(tags: JavaHashMap<String, Tag>, key: str) -> i32? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Short(v) => some(i32(v)),
        _ => none,
    }
}

fn list_at(tags: JavaHashMap<String, Tag>, key: str) -> List<Tag> {
    if not tags.contains(key) {
        return List<Tag>()
    }
    return match tags[key] {
        Tag.List(items) => items.copy(),
        _ => List<Tag>(),
    }
}

fn list_len(tags: JavaHashMap<String, Tag>, key: str) -> usize {
    if not tags.contains(key) {
        return 0
    }
    return match tags[key] {
        Tag.List(items) => items.len(),
        _ => 0,
    }
}

// Whether any of the ints of the array `key` is over 0.
fn any_positive(tags: JavaHashMap<String, Tag>, key: str) -> bool {
    if not tags.contains(key) {
        return false
    }
    let values = match tags[key] {
        Tag.IntArray(v) => v.copy(),
        _ => return false,
    }
    for v in values {
        if v > 0 {
            return true
        }
    }
    return false
}

// Whether anything's in the block entity's `Items`.
fn holds_any(tags: JavaHashMap<String, Tag>) -> bool {
    return list_len(tags, "Items") > 0
}

// Whether the slot `slot` of the block entity's `Items` holds something.
fn holds(tags: JavaHashMap<String, Tag>, slot: i32) -> bool {
    for item in list_at(tags, "Items") {
        match item {
            Tag.Compound(stack) => {
                if stack.contains("Slot") {
                    let at = match stack["Slot"] {
                        Tag.Byte(b) => i32(b) & 255,
                        _ => -1,
                    }
                    if at == slot {
                        return true
                    }
                }
            },
            _ => {},
        }
    }
    return false
}
