    /// The hives and nests a bee may call home, `#beehives`, whose block entity is a hive's (CAL-177).
    pub beehives: BlockSet
    /// The logs, `#logs`, which a parrot sits on as it does leaves, `ParrotWanderGoal` (CAL-201).
    pub logs: BlockSet
    /// The sand, `#sand`, which a turtle lays its eggs on, `TurtleEggBlock.isSand`, and the water
    /// block, which it goes to, `TurtleGoToWaterGoal` (CAL-201).
    pub sand: BlockSet
    pub water_block: u32
    /// What draws a bee, `#bee_attractive`, the sunflower, whose upper half alone does, and what
    /// a bee with nectar grows, `#bee_growables` (CAL-177).
    pub bee_attractive: BlockSet
    pub sunflower: u32
    pub bee_growables: BlockSet
    /// The infested blocks and their hosts, which a silverfish goes into and wakes its friends
    /// from (CAL-172).
    pub infested: Infested
    /// What an ender dragon flies through, `#dragon_transparent`, and what it can't break,
    /// `#dragon_immune` (D611).
    pub dragon_transparent: BlockSet
    pub dragon_immune: BlockSet
    /// The items that tempt the farm animals and horses, by their sets, vanilla's till the
    /// network reads the world's tags, and the attribute `tempt_range` (CAL-158).
    pub tempting: Temptations
    pub tempt_range: u32
    /// The blocks `minecraft:climbable` and `minecraft:crystal_sound_blocks` hold, and those a
    /// player's steps sound of over what they stand on, `minecraft:inside_step_sound_blocks`, and
    /// with it, `minecraft:combination_step_sound_blocks` (D421).
    pub climbable: BlockSet
    /// The blocks a random teleport may land on, `ENTITIES_CAN_TELEPORT_TO`, and those an enderman
    /// won't, `ENDERMAN_DOES_NOT_TELEPORT_TO` (CAL-159).
    pub teleport_onto: BlockSet
    pub enderman_avoids: BlockSet
    /// The blocks what's eaten won't teleport its eater onto, as chorus fruit, the
    /// `teleport_randomly` consume effect's `#consumable_does_not_teleport_to` (CAL-214).
    pub consumable_avoids: BlockSet
    /// The blocks a tame cat won't teleport onto with its morning gift,
    /// `#cat_does_not_teleport_to` (CAL-201).
    pub cat_avoids: BlockSet
    /// The blocks a dolphin won't jump out over, `#blocks_dolphin_jump` (CAL-201).
    pub dolphin_jump_blocks: BlockSet
    pub crystal: BlockSet
    pub inside_step: BlockSet
    pub combination_step: BlockSet
    /// The blocks that suffocate what's in them where their collision shape's full,
    /// `minecraft:causes_suffocation` (D425).
    pub suffocation: BlockSet
    /// The blocks a hoglin keeps away from, `minecraft:hoglin_repellents` (CAL-200).
    pub hoglin_repellents: BlockSet
    /// The blocks a piglin keeps away from, `minecraft:piglin_repellents`, a soul campfire only lit
    /// (CAL-200).
    pub piglin_repellents: BlockSet
    /// The blocks a tame cat lies on, `#cats_can_lie_on`, and sits on, `#cats_can_sit_on`, with
    /// beds, `#beds`, the chest and the furnace, which it sits on only as they are (CAL-201).
    pub cats_lie_on: BlockSet
    pub cats_sit_on: BlockSet
    pub beds: BlockSet
    pub chest: u32
    pub furnace: u32
    /// The blocks that support crops, `#supports_crops`, and carrots, which a rabbit raids
    /// (CAL-201).
    pub supports_crops: BlockSet
    pub carrots: u32
    ladder: u32
    pub powder_snow: u32
    scaffolding: u32
    step_names: List<String>
    fall_names: List<String>
    volumes: List<f32>
    pitches: List<f32>
    state_sounds: List<u32>
    pub max_health: u32
    pub gravity: u32
    pub jump_strength: u32
    pub friction_modifier: u32
    pub air_drag_modifier: u32
    pub water_efficiency: u32
    pub movement_efficiency: u32
    pub safe_fall: u32
    pub fall_multiplier: u32
    pub oxygen_bonus: u32
    pub movement_speed: u32
    /// How fast a flying mob flies, `FLYING_SPEED`, a bee's 0.6 (CAL-177).
    pub flying_speed: u32
    /// The damage types, by their IDs, with their tags, vanilla's till the network reads the
    /// world's, and the attributes a hurt reads (D416).
    pub damage: DamageTypes
    pub knockback_resistance: u32
    pub armor: u32
    pub armor_toughness: u32
    pub max_absorption: u32
    /// The items in `#swords`, which sweep, as the network reads them of the world (D417); in
    /// `#spears`, which skeletons don't pick up, and in `#skeleton_preferred_weapons`, which they'd
    /// rather hold (CAL-159).
    pub swords: List<String> = List<String>()
    pub spears: List<String> = List<String>()
    pub skeleton_weapons: List<String> = List<String>()
    /// The items in `#drowned_preferred_weapons`, which a drowned would rather hold (CAL-175).
    pub drowned_weapons: List<String> = List<String>()
    /// The items in `#wither_skeleton_disliked_weapons`, which a wither skeleton won't hold (CAL-200).
    pub wither_disliked: List<String> = List<String>()
    /// The items in `#piglin_loved`, which a piglin admires, `#piglin_safe_armor`, which keeps it calm,
    /// `#piglin_food`, which it eats, `#piglin_repellents`, which it won't pick up,
    /// `#ignored_by_piglin_babies` and `#piglin_preferred_weapons` (CAL-200).
    pub piglin_loved: List<String> = List<String>()
    pub piglin_safe_armor: List<String> = List<String>()
    pub piglin_food: List<String> = List<String>()
    pub piglin_repellent_items: List<String> = List<String>()
    pub piglin_baby_ignored: List<String> = List<String>()
    pub piglin_weapons: List<String> = List<String>()
    /// The items in `#villager_picks_up`, which a villager wants (CAL-160); and those in
    /// `#villager_plantable_seeds`, which a farmer plants, each with the state of the block it
    /// places, `defaultBlockState`, none where it isn't a `BlockItem`.
    pub villager_picks_up: List<String> = List<String>()
    pub plantable: List<(String, u32?)> = List<(String, u32?)>()
    /// The `compostable` components of wheat seeds and beetroot seeds, which a farmer composts,
    /// `WorkAtComposter.COMPOSTABLE_ITEMS`, in that order, none where the items can't be read
    /// (CAL-160).
    pub composts: List<Tag?> = List<Tag?>()
    /// The effects, by their IDs, and their names, as `world.effects` has them (CAL-163). And the
    /// entity types, by their IDs, that healing harms and harming heals,
    /// `#inverted_healing_and_harm`; and each type with an effect it can't have, `canBeAffected`,
    /// as vanilla's tags and types have them, `unaffected` (D512).
    pub effects: List<EffectFacts>
    pub effect_names: List<String>
    pub inverted: List<u32>
    pub unaffected: List<(u32, i32)>
    /// The entity types, by their IDs, that a wind charge's hurt doesn't anger,
    /// `#no_anger_from_wind_charge` (D676).
    pub calm_in_wind: List<u32> = List<u32>()
}

/// What a hurt did, as `hurtServer` has it (D416): whether it hurt, its answer; whether it took
/// the whole of it, `tookFullDamage`, which its damage event, its sound and its knockback follow;
/// whether `actuallyHurt` ran, which an animal's love ends with; whether it's dying of it, its
/// death sound to be played and its death to follow, `die`; and whether it was hurt but not to
/// death, its hurt sound to be played. And the target a zombie hurt called reinforcements for,
/// `Mob.after_hurt`, for its level to bring them (CAL-159); and whether its own `actuallyHurt`
/// stopped it in place before its knockback, as an armadillo rolling up does, `still_on_hurt`,
/// and how many of the sounds it made came in `actuallyHurt`, before its level broadcasts its
/// damage event, `broadcastDamageEvent`, as an armadillo's rolling up does (CAL-160); whether
/// a villager a player hurt shows its anger, entity event 13, before that damage event; and
/// whether its offers were priced again for the player trading with it who hurt it, which they're
/// sent before that, `updateSpecialPrices`.
pub struct Hurt {
    pub hurt: bool = false
    pub full: bool = false
    pub actually: bool = false
    pub dies: bool = false
    pub hurt_sound: bool = false
    pub reinforce: i32? = none
    pub stilled: bool = false
    pub early: usize = 0
    pub angry: bool = false
    pub repriced: bool = false
    /// Whether a totem saved it from the death it would have died, `checkTotemDeathProtection`
    /// (D518), its entity event 35 to follow.
    pub totem: bool = false
    /// What it was to take, `originalDamage`, and what it took before its armor, `damage` as
    /// `hurtServer` ends, which the hurt triggers read (CAL-164).
    pub dealt: f32 = 0.0f32
    pub taken: f32 = 0.0f32
    /// What its resistance and its absorption took, which the player who caused it counts,
    /// `DAMAGE_DEALT_RESISTED` and `DAMAGE_DEALT_ABSORBED` (CAL-164).
    pub resisted: f32 = 0.0f32
    pub absorbed: f32 = 0.0f32
    /// Whether what dealt it, an arrow or a wind charge, is set alight for a second, as a sitting
    /// ender dragon's `onHurt` sets one it takes none of (CAL-167).
    pub kindled: bool = false
}

impl LivingFacts {
    /// As `f` has them, its tags those its level loaded.
    pub fn new(f: Facts) -> LivingFacts {
        let ladder = f.block_named(String("minecraft:ladder")) else panic("no ladder block")
        let snow = f.block_named(String("minecraft:powder_snow")) else panic("no powder snow block")
        var steps = List<String>()
        for s in step_sound_names() {
            steps.push(String(s))
        }
        var falls = List<String>()
        for s in fall_sound_names() {
            falls.push(String(s))
        }
        return LivingFacts {
            paths: PathStates.new(f),
            doors: f.tag_or_empty(String("minecraft:doors")),
            fences: f.tag_or_empty(String("minecraft:fences")),
            cauldrons: f.tag_or_empty(String("minecraft:cauldrons")),
            follow_range: attribute("follow_range"),
            step_height: attribute("step_height"),
            grass_block: f.block_named(String("minecraft:grass_block")) ?? u32.MAX,
            sheep_food: f.tag_or_empty(String("minecraft:edible_for_sheep")),
            enderman_holdable: f.tag_or_empty(String("minecraft:enderman_holdable")),
            curing: f.tag_or_empty(String("minecraft:speeds_up_zombie_villager_curing")),
            beehives: f.tag_or_empty(String("minecraft:beehives")),
            logs: f.tag_or_empty(String("minecraft:logs")),
            sand: f.tag_or_empty(String("minecraft:sand")),
            water_block: f.block_named(String("minecraft:water")) ?? u32.MAX,
            bee_attractive: f.tag_or_empty(String("minecraft:bee_attractive")),
            sunflower: f.block_named(String("minecraft:sunflower")) ?? u32.MAX,
            bee_growables: f.tag_or_empty(String("minecraft:bee_growables")),
            infested: Infested.new(f),
            dragon_transparent: f.tag_or_empty(String("minecraft:dragon_transparent")),
            dragon_immune: f.tag_or_empty(String("minecraft:dragon_immune")),
            tempting: Temptations.vanilla(),
            tempt_range: attribute("tempt_range"),
            climbable: f.tag_or_empty(String("minecraft:climbable")),
            teleport_onto: f.tag_or_empty(String("minecraft:entities_can_teleport_to")),
            enderman_avoids: f.tag_or_empty(String("minecraft:enderman_does_not_teleport_to")),
            consumable_avoids: f.tag_or_empty(String("minecraft:consumable_does_not_teleport_to")),
            cat_avoids: f.tag_or_empty(String("minecraft:cat_does_not_teleport_to")),
            dolphin_jump_blocks: f.tag_or_empty(String("minecraft:blocks_dolphin_jump")),
            crystal: f.tag_or_empty(String("minecraft:crystal_sound_blocks")),
            inside_step: f.tag_or_empty(String("minecraft:inside_step_sound_blocks")),
            combination_step: f.tag_or_empty(String("minecraft:combination_step_sound_blocks")),
            suffocation: f.tag_or_empty(String("minecraft:causes_suffocation")),
            hoglin_repellents: f.tag_or_empty(String("minecraft:hoglin_repellents")),
            piglin_repellents: f.tag_or_empty(String("minecraft:piglin_repellents")),
            cats_lie_on: f.tag_or_empty(String("minecraft:cats_can_lie_on")),
            cats_sit_on: f.tag_or_empty(String("minecraft:cats_can_sit_on")),
            beds: f.tag_or_empty(String("minecraft:beds")),
            chest: f.block_named(String("minecraft:chest")) ?? u32.MAX,
            furnace: f.block_named(String("minecraft:furnace")) ?? u32.MAX,
            supports_crops: f.tag_or_empty(String("minecraft:supports_crops")),
            carrots: f.block_named(String("minecraft:carrots")) ?? u32.MAX,
            ladder: ladder,
            powder_snow: snow,
            scaffolding: f.block_named(String("minecraft:scaffolding")) ?? u32.MAX,
            step_names: steps,
            fall_names: falls,
            volumes: place_sound_volumes(),
            pitches: place_sound_pitches(),
            state_sounds: state_place_sounds(),
            max_health: attribute("max_health"),
            gravity: attribute("gravity"),
            jump_strength: attribute("jump_strength"),
            friction_modifier: attribute("friction_modifier"),
            air_drag_modifier: attribute("air_drag_modifier"),
            water_efficiency: attribute("water_movement_efficiency"),
            movement_efficiency: attribute("movement_efficiency"),
            safe_fall: attribute("safe_fall_distance"),
            fall_multiplier: attribute("fall_damage_multiplier"),
            oxygen_bonus: attribute("oxygen_bonus"),
            movement_speed: attribute("movement_speed"),
            flying_speed: attribute("flying_speed"),
            damage: DamageTypes.vanilla(),
            knockback_resistance: attribute("knockback_resistance"),
            armor: attribute("armor"),
            armor_toughness: attribute("armor_toughness"),
            max_absorption: attribute("max_absorption"),
            effects: effect_facts(),
            effect_names: effect_names(),
            inverted: inverted_kinds(),
            unaffected: unaffected_kinds(),
            calm_in_wind: kinds_named(["breeze", "skeleton", "bogged", "stray", "zombie", "husk", "spider", "cave_spider", "slime"]),
        }
    }

    // Whether the state is climbable to a moving entity, `isStateClimbable`: climbable, or powder
    // snow.
    fn climbable_state(self, f: Facts, state: u32) -> bool {
        return f.in_set(state, self.climbable) or f.block(state) == self.powder_snow
    }
}

// The attribute `minecraft:{name}`'s ID.
fn attribute(name: str) -> u32 {
    return attribute_id("minecraft:{name}") ?? panic("no attribute {name}")
}

/// A living entity.
pub struct Living {
    /// What every entity has; its type, by its ID in the entity type registry; its attributes and
    /// its synced values.
    pub body: Body
    pub kind: u32
    /// Whether its kind is in `#powder_snow_walkable_mobs`, as its caller says (D698).
    pub snow_walker: bool = false
    pub attributes: Attributes
    pub data: EntityData
    /// Its turns as its tick began, `yRotO` and `xRotO`, and its head's and body's, now and then.
    pub y_rot_o: f32 = 0.0f32
    pub x_rot_o: f32 = 0.0f32
    pub y_head_rot: f32 = 0.0f32
    pub y_head_rot_o: f32 = 0.0f32
    pub y_body_rot: f32 = 0.0f32
    pub y_body_rot_o: f32 = 0.0f32
    /// The ticks till an arrow in it goes, `removeArrowTime` (CAL-159).
    pub remove_arrow_time: i32 = 0
    /// Whether it climbs where its flags say it does, as a spider's `onClimbable` has it, not by
    /// the block it's in (CAL-159).
    pub climber: bool = false
    /// What it's using, `useItem`, and for how many ticks more, `useItemRemaining`, as a skeleton
    /// draws its bow (CAL-159).
    pub use_item: Tag? = none
    pub use_remaining: i32 = 0
    /// The spear it's using, its `KineticWeapon`, and the entities its use hit by the game time
    /// it hit them, `recentKineticEnemies`, in the order it first hit them (CAL-159).
    pub use_kinetic: Kinetic? = none
    pub recent_stabs: List<(i32, i64)>? = none
    /// What it's told to walk, sideways, up and ahead, whether it's told to jump, how long until
    /// it may jump again, and how fast it walks, `getSpeed`.
    pub xxa: f32 = 0.0f32
    pub yya: f32 = 0.0f32
    pub zza: f32 = 0.0f32
    pub jumping: bool = false
    pub no_jump_delay: i32 = 0
    /// What its jump strength's multiplied by as it jumps, `getJumpPower(multiplier)`, a rabbit's
    /// its own; and a rabbit's move control's speed and whether it's a baby, which its jump pushes
    /// it on by, `Rabbit.jumpFromGround` (CAL-201).
    pub jump_multiplier: f32 = 1.0f32
    pub hop: (f64, bool)? = none
    pub speed: f32 = 0.0f32
    /// How much water slows it, `getWaterSlowDown`; and whether it flies and sprints,
    /// `abilities.flying` and `isSprinting`, which only a player's travel looks at so far (D419);
    /// and whether it crouches, which steps without its feet on the ground (D421), and swims,
    /// `isSwimming`, which doesn't step at all, as only a player does so far (D444). A player's
    /// body, `Body.player`, steps as a player does (D421, D422).
    pub water_slow_down: f32 = 0.8f32
    pub flying: bool = false
    pub sprinting: bool = false
    pub crouching: bool = false
    pub swimming: bool = false
    /// Whether it glides, `isFallFlying`, its shared flags' eighth, which only a player's travel
    /// looks at so far (CAL-286); and what its travel found as it glided: that it touched what's
    /// climbable, which stops it, `stopFallFlying`, and how hard it flew into a wall,
    /// `fly_into_wall`'s damage, 0 where it didn't.
    pub gliding: bool = false
    pub glide_stopped: bool = false
    pub wall_hit: f32 = 0.0f32
    /// Whether it swims as a drowned does (CAL-175): swimming, `updateSwimming`, where its AI's
    /// on, `ai_on`, its eyes were under water, `under_water`, and it wants to swim, `wants_swim`,
    /// as its mob says, and then not pushed by the currents; and under water wanting to swim, its
    /// own way through water, `travelInWater`.
    pub drowned: bool = false
    /// Whether it's a fish, `AbstractFish` (CAL-178): in water it swims its own way,
    /// `travelInWater`, sinking 0.005 a tick as it has no target, which no fish takes up; and a
    /// water animal, `WaterAnimal`, isn't pushed by the currents, `isPushedByFluid`.
    pub fish: bool = false
    /// Whether it swims as a guardian does, `Guardian.travelInWater` (CAL-200): in water at 0.1 a
    /// tick, moved, slowed to 0.9, then down 0.005 where it's idle, `idle_in_water`, neither moving,
    /// `isMoving`, nor with a target, as its mob says before it travels.
    pub guardian_swim: bool = false
    /// Whether it moves by its motion alone, as a squid does, `Squid.travel` (CAL-201): no fluid,
    /// gravity nor friction of its travel's, which its own step has.
    pub moves_as_is: bool = false
    /// Whether it swims as a dolphin does, `Dolphin.travelInWater` (CAL-201): in water at its
    /// speed, `getSpeed`, moved, slowed to 0.9, then down 0.005 where it's idle, `idle_in_water`,
    /// with no target, as its mob says before it travels.
    pub dolphin_swim: bool = false
    /// Its most air, `getMaxAirSupply`, a dolphin's 4800 (CAL-201), and whether its air comes back
    /// whole at once, a dolphin's `increaseAirSupply`, not 4 a tick.
    pub max_air: i32 = 300
    pub air_whole: bool = false
    pub idle_in_water: bool = false
    /// Whether the currents don't push it, a turtle's `isPushedByFluid` (CAL-201); its next step
    /// only 0.15 on, `nextStep`; and its swims half as loud again, `playSwimSound`.
    pub unpushed: bool = false
    pub short_steps: bool = false
    pub swim_loud: f32 = 1.0f32
    /// A horse's or donkey's landing sound, a foal's its own, kept by its tick, where it falls as
    /// `AbstractHorse.causeFallDamage` has it (CAL-179).
    pub horse_land: String? = none
    /// A mob's whose navigation can't float, `canFloat`, as a zombie's or skeleton's: it jumps up
    /// through water or lava 0.3 a tick, `Mob.jumpInLiquid` (CAL-175).
    pub sinks: bool = false
    pub ai_on: bool = true
    pub wants_swim: bool = false
    pub under_water: bool = false
    /// Whether fire doesn't burn it, its type's `fireImmune`, an ender dragon's alone of those
    /// Calcite runs (D434, D608).
    pub fire_immune: bool = false
    /// What an ender dragon does otherwise (D608): it can't go through portals, `canUsePortal`;
    /// takes no knockback while it sits, `knockback`; has its own death's tick, `tickDeath`, for
    /// its mob to tick; and takes no effects, `addEffect`.
    pub uses_portals: bool = true
    pub knock_proof: bool = false
    pub own_death: bool = false
    pub takes_effects: bool = true
    /// What it's saved with of being hurt: its hurt and death times, its absorption, how long it
    /// can't be hurt, and the impulse it was last given, its grace time and where it was given,
    /// which a fall below it doesn't count.
    pub hurt_time: i32 = 0
    pub death_time: i32 = 0
    pub absorption: f32 = 0.0f32
    pub invulnerable_time: i32 = 0
    pub impulse_grace: i32 = 0
    pub impulse_at: (f64, f64, f64)? = none
    /// The bed it sleeps in, `getSleepingPos`, which its values hold too, `SLEEPING_POS_ID`, and
    /// it's saved with (CAL-160).
    pub sleeping: (i32, i32, i32)? = none
    /// The block it last climbed, `lastClimbablePos`.
    pub last_climbable: (i32, i32, i32)? = none
    /// Being hurt, as `hurtServer` keeps it (D416): how long it shrugs off what's no worse than
    /// its last hurt, `damageCooldownTime`, and that hurt, `lastHurt`; what last hurt it and the
    /// game time then, `lastDamageSource` and `lastDamageStamp`; the player who last hurt it, by
    /// UUID, and for how many ticks more that's kept, `lastHurtByPlayer` and
    /// `lastHurtByPlayerMemoryTime`; the living entity that last hurt it, by UUID, and its tick
    /// count then, `lastHurtByMob` and `lastHurtByMobTimestamp`; and whether it's died, `dead`.
    pub damage_cooldown: i32 = 0
    pub last_hurt: f32 = 0.0f32
    pub last_damage: Damage? = none
    pub last_damage_tags: u32 = 0
    pub last_damage_stamp: i64 = 0
    pub hurt_by_player: (i64, i64)? = none
    pub hurt_by_player_memory: i32 = 0
    pub hurt_by_mob: (i64, i64)? = none
    pub hurt_by_mob_stamp: i32 = 0
    /// Whether that living entity, where its level found it among its mobs and armor stands before
    /// its tick, not gone, is alive, `getLastHurtByMob` (D676); none where it wasn't found there.
    pub hurt_by_found: bool? = none
    /// Whether its next hurt, once it's dealt and where it doesn't leave it dying, stops it in
    /// place before its knockback, `stopInPlace`, as its mob's own `actuallyHurt` does, an
    /// armadillo's rolling up as a living entity hurts it (CAL-160); its mob sets it.
    pub still_on_hurt: bool = false
    pub dead: bool = false
    /// What's hurt it lately, `CombatTracker`, kept only for a kind whose death's told, a tame
    /// wolf's to its owner, `TamableAnimal.die`; its mob makes it, a wolf's (CAL-201). The names
    /// of who hurt it are found as it dies, as vanilla's death message names them then; where a
    /// fall began is only water's, its climbables' not yet told apart.
    pub combat: CombatTracker? = none
    /// How far it fell where the hurt it's taking is its fall's, dealt after its move's reset
    /// that, `fallDistance` as `causeFallDamage` had it (CAL-201).
    pub hurt_fall: f64? = none
    /// Whether it's a witch, which takes none of its own damage and 15% of magic's and thorns',
    /// `Witch.getDamageAfterMagicAbsorb` (CAL-159).
    pub magic_resistant: bool = false
    /// Whether its kind never freezes, `canFreeze`: a skeleton's own, `Skeleton`'s, and those in
    /// `#freeze_immune_entity_types`, of which Calcite makes the stray (CAL-175).
    pub cold_proof: bool = false
    /// Whether it's a cube mob, whose jump is always as high as it jumps, `AbstractCubeMob`'s
    /// `jumpFromGround` (CAL-159).
    pub cube: bool = false
    /// Whether its type breathes under water, `minecraft:can_breathe_under_water`, and is never
    /// hurt by a fall, `minecraft:fall_damage_immune`, and its fall sounds, `getFallSounds`, a
    /// small fall's and a big one's.
    pub breathes_water: bool = false
    pub fall_immune: bool = false
    pub small_fall: String
    pub big_fall: String
    /// Its swim's sound, `getSwimSound` (CAL-156).
    pub swim: String
    /// Its type's own step sound, `playStepSound`, at 0.15 and its pitch 1, as a cow's, where it
    /// doesn't step as the block it's on sounds; or, where `step_by_block`, as loud and high as the
    /// block sounds, a horse's, its wood step on wood and nothing on a liquid (CAL-156).
    pub own_step: String? = none
    pub step_by_block: bool = false
    /// How loud its own step is, 0.15 but an iron golem's 1, `IronGolem.playStepSound` (CAL-201).
    pub own_step_volume: f32 = 0.15f32
    /// Whether it draws to show the dust it kicks up whenever it moves across, an iron golem's
    /// `canSpawnSprintParticle` (CAL-201).
    pub golem_dust: bool = false
    /// Whether its air never runs out under water, an iron golem's `decreaseAirSupply` (CAL-201).
    pub keeps_air: bool = false
    /// A horse's steps while something rides it, `gallopSoundCounter` (D710): its wood step for
    /// the first 5, then its gallop each 3rd. Only a player steering it starts it again, which
    /// none can yet.
    pub gallop: i32 = 0
    /// Whether it gallops, `canGallop`: a horse's or a zombie horse's, not a donkey's.
    pub gallops: bool = false
    /// Its gallop's breath, a horse's, its baby's its own, `Horse.playGallopSound` (CAL-179).
    pub breath: String? = none
    /// Whether its steps and swims sound, `MovementEmission.emitsSounds`: not an endermite's,
    /// whose `EVENTS` only emit game events, its steps still counted (D583).
    pub emits_sounds: bool = true
    /// Whether its steps make no sound of their own, a bee's empty `playStepSound`, its amethyst
    /// chime still rung (CAL-177).
    pub steps_unheard: bool = false
    /// Whether it moves through the air alike every way, `omnidirectionalAirMover`, a bee's: slowed
    /// up and down as across, 0.91 a tick, not 0.98 (CAL-177).
    pub omni_air: bool = false
    /// Whether its wings are heard as it flies, a parrot's `isFlapping` and `onFlap`: past its
    /// next flap, `nextFlap`, by how far it's flown, `flyDist`, its flight heard 0.15 loud, and its
    /// next flap its wings' speed, `flapSpeed`, a half further (CAL-201).
    pub flaps: bool = false
    pub flap_speed: f32 = 0.0f32
    pub next_flap: f32 = 1.0f32
    /// Whether it ignores its falls, a bee's empty `checkFallDamage`: no fall counted, no dust, no
    /// block landed on, and its fluids not looked at again as it moves (CAL-177).
    pub ignores_falls: bool = false
    /// Whether it landed with a fall since its enchantments' location-changed effects last ran
    /// for it, `checkFallDamage`'s `onChangedBlock` (CAL-218).
    pub landed: bool = false
    /// Whether it flies its own way, `travelFlying`, a phantom's: through water at 0.02, slowed to
    /// 0.8, through lava at 0.02, slowed to a half, else through the air at 0.2, slowed to 0.91, every
    /// way alike and falling not at all; and never on what's climbable, `onClimbable` (CAL-200).
    pub flies_free: bool = false
    /// How fast it flies through the air its own way, `travelFlying`'s speed: a phantom's 0.2, a
    /// ghast's 0.02 (CAL-200).
    pub fly_speed: f32 = 0.2f32
    /// How much it rises a tick jumping in a liquid where its own says, a bee's 0.01,
    /// `Bee.jumpInLiquid` (CAL-177).
    pub liquid_rise: f64? = none
    /// A magma cube's size, for its jumps (CAL-200): a tenth of it higher off the ground,
    /// `MagmaCube.jumpFromGround`, and up through lava at 0.22 and a twentieth of it,
    /// `jumpInLiquid`; none for anything else.
    pub magma_size: i32? = none
    // How far it's gone for its steps, `moveDist` and `flyDist`, and where it next steps.
    move_dist: f32 = 0.0f32
    fly_dist: f32 = 0.0f32
    next_step: f32 = 1.0f32
    // When it last chimed on amethyst, and how loud it's been chiming.
    chimed_at: i32 = 0
    chime: f32 = 0.0f32
    /// What it was loaded with that Calcite doesn't run, by the keys it's saved under: its locator
    /// bar icon.
    pub kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    /// Its effects, `activeEffects`, in the order they came: vanilla's map is keyed by identity, so
    /// its order isn't the same from one run to the next (CAL-163). And whether they've changed
    /// since its values last showed them, `effectsDirty`; and whether it's an armor stand, which
    /// shows no particles of them and is invisible as it's set,
    /// `ArmorStand.updateInvisibilityStatus`.
    pub effects: List<ActiveEffect> = List<ActiveEffect>()
    pub effects_dirty: bool = false
    pub stand: bool = false
    /// What it wears and holds, `equipment`, by `EquipmentSlot`'s order, and that as it last looked
    /// at it, `lastEquipmentItems`, nothing at first (CAL-156).
    pub equipment: List<Tag?> = List<Tag?>()
    last_equipment: List<Tag?> = List<Tag?>()
    /// The hurt of a fall its move found, `causeFallDamage`'s `hurt`, which a mob deals as its move
    /// ends, `Mob.fall_hurt` (CAL-159).
    pub fall_hurt: FallHurt? = none
    /// What it showed since that was last taken, in the order it showed it, and how many of the
    /// sounds of its tick it had played as it showed each, for the server to send among them.
    pub shown: List<Shown> = List<Shown>()
    pub shown_after: List<usize> = List<usize>()
}

impl Living {
    /// A living entity of the type `kind` at x, y, z, `width` across and `height` high with its eyes
    /// `eyes` up, with `data` its synced values as its type defines them and its own random seeded
    /// `seed`, as `LivingEntity`'s constructor makes it: `Entity`'s, its UUID drawn from its random;
    /// its attributes; its health its most; and its turn drawn from its random, `nextFloat` of a
    /// turn's radians as degrees, its head turned with it.
    pub fn made(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64, width: f32, height: f32, eyes: f32, data: own EntityData) -> Living {
        let (l, _) = Living.made_drawing(lf, kind, id, seed, x, y, z, width, height, eyes, data, 0)
        return l
    }

    /// `made`, with a draw from its random of a number below `bound` as its type defines its
    /// values, after its UUID and before its turn, as a zombie villager draws its profession, and
    /// that number; nothing drawn and -1 where `bound` is 0 (CAL-156).
    pub fn made_drawing(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64, width: f32, height: f32, eyes: f32, data: own EntityData, bound: i32) -> (Living, i32) {
        var body = Body.made(id, seed, x, y, z, width, height, eyes, 0.0)
        body.alive = true
        let drawn = if bound > 0 { body.random.next_int_below(bound) } else { -1 }
        var l = Living { body: body, kind: kind, attributes: Attributes.of_type(kind), data: data, small_fall: String("entity.generic.small_fall"), big_fall: String("entity.generic.big_fall"), swim: String("entity.generic.swim"), equipment: unworn(), last_equipment: unworn() }
        l.refresh_body(lf)
        let most = l.max_health(lf)
        l.set_health(lf, most)
        let turn = l.body.random.next_float() * 6.2831855f32
        l.body.y_rot = turn
        l.y_head_rot = turn
        return (l, drawn)
    }

    /// A player's body as the server moves them (D419), `kind` the player's type, `id` their
    /// network ID and `data` their synced values, its place, motion, size, random and the rest set
    /// before each move: their client has the say over it, so it's not `owned`, and they sound as a
    /// player does (D421). Nothing's drawn from its random, as the player's entity was made
    /// already.
    pub fn player_body(kind: u32, id: i32, data: own EntityData) -> Living {
        let body = Body { id: id, uuid: (0i64, 0i64), x: 0.0, y: 0.0, z: 0.0, width: 0.6f32, height: 1.8f32, eyes: 1.62f32, gravity: 0.08, random: LegacyRandom.new(0i64), alive: true, owned: false, player: true, sound_source: 7 }
        return Living { body: body, kind: kind, attributes: Attributes(), data: data, small_fall: String("entity.player.small_fall"), big_fall: String("entity.player.big_fall"), swim: String("entity.player.swim") }
    }

    /// `Entity.snapTo`: at x, y, z turned `y_rot` and `x_rot`, where it was and how it was turned
    /// as its tick began the same, `setOldPosAndRot`; its head and body as they were.
    pub fn snap_to(mut self, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32) {
        self.body.x = x
        self.body.y = y
        self.body.z = z
        self.body.y_rot = y_rot
        self.body.x_rot = x_rot
        self.body.xo = x
        self.body.yo = y
        self.body.zo = z
        self.y_rot_o = y_rot
        self.x_rot_o = x_rot
    }

    /// Its body's gravity, air drag, movement efficiency and how high it steps (D420), from its
    /// attributes as they are now.
    pub fn refresh_body(mut self, lf: LivingFacts) {
        self.body.step = f32.nearest(self.attributes.value(lf.step_height))
        self.body.gravity = self.attributes.value(lf.gravity)
        self.body.air_drag = modified_friction(if self.omni_air { 0.91f32 } else { 0.98f32 }, f32.nearest(self.attributes.value(lf.air_drag_modifier)))
        self.body.efficiency = f32.nearest(self.attributes.value(lf.movement_efficiency))
    }

    /// Its health, `getHealth`, and its most, `getMaxHealth`.
    pub fn health(self) -> f32 {
        return self.data.float(HEALTH)
    }

    pub fn max_health(self, lf: LivingFacts) -> f32 {
        return f32.nearest(self.attributes.value(lf.max_health))
    }

    /// `setHealth`: its health, kept within 0 and its most.
    pub fn set_health(mut self, lf: LivingFacts, health: f32) {
        let most = self.max_health(lf)
        let kept = if health < 0.0f32 { 0.0f32 } else if health > most { most } else { health }
        self.data.set(HEALTH, Value.Float(kept))
    }

    /// `detectEquipmentUpdates`, in its tick before `aiStep`: each slot whose stack doesn't match
    /// what it last looked at, the old one's modifiers taken off and the new one's put on, unless
    /// it's broken, as `items` reads them; then shown, its hands swapped as event 55 and the other
    /// slots with what's in them, `handleEquipmentChanges` (CAL-156).
    pub fn detect_equipment<W: Wearing>(mut self, items: W, heard: usize) {
        var changed = List<usize>()
        for slot in 0..self.equipment.len() {
            if not same_stack(self.last_equipment[slot].copy(), self.equipment[slot].copy()) {
                changed.push(slot)
            }
        }
        if changed.is_empty() {
            return
        }
        let now = self.equipment.copy()
        let swapped = equip(mut self.attributes, mut self.last_equipment, now, items)
        var sent = List<(usize, Tag?)>()
        for slot in changed {
            if swapped and slot <= 1 {
                continue
            }
            sent.push((slot, self.equipment[slot].copy()))
        }
        if swapped {
            self.show(Shown.Event(55i8), heard)
        }
        if not sent.is_empty() {
            self.show(Shown.Worn(sent), heard)
        }
    }

    /// `refreshDirtyAttributes` for its most health and absorption, at the end of its tick and as
    /// its effects change their modifiers: its health and absorption no more than their most,
    /// which a lower most leaves them above (CAL-156, CAL-163).
    pub fn keep_health(mut self, lf: LivingFacts) {
        let most = self.max_health(lf)
        if self.health() > most {
            self.set_health(lf, most)
        }
        let most_absorption = f32.nearest(self.attributes.value(lf.max_absorption))
        if self.absorption > most_absorption {
            self.set_absorption(lf, most_absorption)
        }
    }

    /// `heal`: its health up by `amount` where it has any, no more than its most.
    pub fn heal(mut self, lf: LivingFacts, amount: f32) {
        let now = self.health()
        if now > 0.0f32 {
            self.set_health(lf, now + amount)
        }
    }

    /// `isAlive`: not gone and with health left.
    pub fn alive(self) -> bool {
        return not self.body.removed and self.health() > 0.0f32
    }

    /// `isDeadOrDying`: no health left, or died (D416).
    pub fn dead_or_dying(self) -> bool {
        return self.health() <= 0.0f32 or self.dead
    }

    /// `isInvulnerableTo` for the damage `d` of `types` (D416): `isInvulnerableToBase`, gone;
    /// invulnerable, for good or for now, to what doesn't bypass it and isn't a creative player's;
    /// fire immune to fire; or a type immune to falls hurt by one; else immune to it by its
    /// enchantments, `immune`, `isImmuneToDamage`, as its `Ward` says (D439).
    pub fn invulnerable_to(self, types: DamageTypes, d: Damage, fire_immune: bool, immune: bool) -> bool {
        if self.body.removed {
            return true
        }
        let invulnerable = self.body.invulnerable or self.invulnerable_time > 0
        if invulnerable and not types.is(d.kind, BYPASSES_INVULNERABILITY) and not d.creative {
            return true
        }
        if types.is(d.kind, IS_FIRE) and fire_immune {
            return true
        }
        if types.is(d.kind, IS_FALL) and self.fall_immune {
            return true
        }
        return immune
    }

    /// `LivingEntity.hurtServer` of `amount` of the damage `d` of `types` at the game time `now`,
    /// fire resistant or not, fire immune or not (D416): nothing where it's invulnerable to it,
    /// dying, or fire resistant against fire; else, no less than none, the whole of it where its
    /// cooldown's done or the type bypasses it, its cooldown 20 and its hurt time 10, or else only
    /// Where it sleeps, `setSleepingPos`, or that it doesn't, `clearSleepingPos`, its values'
    /// too (CAL-160).
    pub fn set_sleeping(mut self, at: (i32, i32, i32)?) {
        self.sleeping = at
        match at {
            some((x, y, z)) => self.data.set(SLEEPING_POS, Value.Pos(x, y, z)),
            none => self.data.set(SLEEPING_POS, Value.Empty),
        }
    }

    /// what's worse than its last hurt, nothing where it isn't, `actuallyHurt`; then who hurt it
    /// kept, the mob unless the type's `no_anger`, and the player for 100 ticks; for the whole of
    /// it, its motion to be sent, `markHurt`, unless `no_impact`, and its knockback, `0.4F` made a
    /// double, from where the damage came, unless `no_knockback`; then its death or its hurt sound
    /// to follow, and what hurt it kept with the time. What its enchanted equipment does against
    /// it is `ward`'s (D439). Where it would die, a totem the ward found saves it,
    /// `death_protection` (D518), what that plays heard in `sounds` and what's missing said in
    /// `missing`. Blocking, freezing and helmets come with them.
    pub fn hurt_server(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, fire_resistant: bool, fire_immune: bool, ward: Ward, sounds: mut List<EntitySound>, missing: mut List<String>) -> Hurt {
        var out = Hurt()
        let totem = ward.totem.copy()
        if self.invulnerable_to(types, d, fire_immune, ward.immune) or self.dead_or_dying() {
            return out
        }
        if types.is(d.kind, IS_FIRE) and fire_resistant {
            return out
        }
        var damage = if amount < 0.0f32 { 0.0f32 } else { amount }
        out.dealt = damage
        if damage.is_nan() or damage == f32.INFINITY or damage == f32.NEG_INFINITY {
            damage = f32.MAX
        }
        out.taken = damage
        out.full = true
        if f32.nearest(f64(self.damage_cooldown)) > 10.0f32 and not types.is(d.kind, BYPASSES_COOLDOWN) {
            if damage <= self.last_hurt {
                return Hurt()
            }
            let more = damage - self.last_hurt
            let (resisted, absorbed) = self.actually_hurt(lf, types, d, more, fire_immune, ward, sounds.len())
            out.resisted = resisted
            out.absorbed = absorbed
            self.last_hurt = damage
            out.full = false
        } else {
            self.last_hurt = damage
            self.damage_cooldown = 20
            let (resisted, absorbed) = self.actually_hurt(lf, types, d, damage, fire_immune, ward, sounds.len())
            out.resisted = resisted
            out.absorbed = absorbed
            self.hurt_time = 10
        }
        out.actually = true
        if self.still_on_hurt and not self.dead_or_dying() {
            // Its mob's own `actuallyHurt`'s, `stopInPlace`'s, but its navigation's, which its mob
            // stops (CAL-160).
            self.xxa = 0.0f32
            self.yya = 0.0f32
            self.speed = 0.0f32
            self.zza = 0.0f32
            self.body.vx = 0.0
            self.body.vy = 0.0
            self.body.vz = 0.0
            out.stilled = true
        }
        // `resolveMobResponsibleForDamage`: what caused it, where that's living, a player or a mob,
        // kept, `setLastHurtByMob`, unless its type's `#no_anger`, or a wind charge's where its
        // kind isn't angered by those (D676). Then `resolvePlayerResponsibleForDamage`: the player
        // who caused it kept for 100 ticks.
        if self.angered_by(lf, types, d) {
            if let who = d.player ?? d.mob {
                self.hurt_by_mob = some(who)
                self.hurt_by_mob_stamp = self.body.tick_count
            }
        }
        // A tame wolf that caused it, its owner, `tamed_by` (CAL-201).
        if let who = d.player ?? d.tamed_by {
            self.hurt_by_player = some(who)
            self.hurt_by_player_memory = 100
        }
        if out.full {
            if not types.is(d.kind, NO_IMPACT) {
                self.body.sync_velocity = true
            }
            if not types.is(d.kind, NO_KNOCKBACK) {
                // `dealDefaultKnockback`: along a projectile's way, else toward where it came
                // from (CAL-159).
                var xd = 0.0
                var zd = 0.0
                if let way = d.knock {
                    let (kx, kz) = way
                    xd = -kx
                    zd = -kz
                } else if let at = d.at {
                    let (x, _, z) = at
                    xd = x - self.body.x
                    zd = z - self.body.z
                }
                self.knockback(lf, f64(0.4f32), xd, zd)
            }
        }
        if self.dead_or_dying() {
            if self.death_protection(lf, types, d, totem, mut sounds, mut missing) {
                out.totem = true
            } else {
                out.dies = true
            }
        } else if out.full {
            out.hurt_sound = true
        }
        out.hurt = true
        self.last_damage = some(d)
        self.last_damage_tags = types.tags_of(d.kind)
        self.last_damage_stamp = now
        return out
    }

    /// Whether the damage `d` of `types` angers it at what caused it, as
    /// `resolveMobResponsibleForDamage` has it (D676): its type not `#no_anger`, nor a wind
    /// charge's where its kind is `#no_anger_from_wind_charge`.
    pub fn angered_by(self, lf: LivingFacts, types: DamageTypes, d: Damage) -> bool {
        if types.is(d.kind, NO_ANGER) {
            return false
        }
        return not (d.kind == types.id("wind_charge") and lf.calm_in_wind.contains(self.kind))
    }

    // `checkTotemDeathProtection` (D518): unless the damage `d` bypasses invulnerability, the
    // stack in the hand `totem` found, one fewer, its health 1, and its protection's death effects
    // put through in their order, `DeathProtection.applyEffects`, `consume`. Whether it saved it.
    fn death_protection(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, totem: (usize, Tag)?, sounds: mut List<EntitySound>, missing: mut List<String>) -> bool {
        if types.is(d.kind, BYPASSES_INVULNERABILITY) {
            return false
        }
        let found = totem else return false
        let (hand, protection) = found
        let stack = self.equipment[hand].copy() else return false
        self.equipment[hand] = shrunk(stack, 1)
        self.set_health(lf, 1.0f32)
        self.consume(lf, death_effects(protection), mut sounds, mut missing)
        return true
    }

    /// What the consume effects `effects` do to it (D518), in their order, as each
    /// `ConsumeEffect.apply` does: effects added, each a copy, `addEffect`, where a float drawn
    /// from its random is under their probability; those of some kinds taken off, `removeEffect`;
    /// all taken off, `removeAllEffects`; a sound played from it, of its sound source, as loud and
    /// as high as 1. Its random teleport, and a mob effect tag's effects, are said missing.
    pub fn consume(mut self, lf: LivingFacts, effects: List<ConsumeEffect>, sounds: mut List<EntitySound>, missing: mut List<String>) {
        for e in effects {
            match e {
                ConsumeEffect.Apply(list, probability) => {
                    if self.body.random.next_float() < probability {
                        for each in list {
                            _ = self.add_effect(lf, each.copy(), mut sounds)
                        }
                    }
                },
                ConsumeEffect.Remove(ids) => {
                    for id in ids {
                        _ = self.remove_effect(lf, id)
                    }
                },
                ConsumeEffect.ClearAll => {
                    _ = self.remove_all_effects(lf)
                },
                ConsumeEffect.Teleport(_, _) => missing.push(String("A consumed item's random teleport, teleport_randomly")),
                ConsumeEffect.Sound(s) => sounds.push(EntitySound { sound: s.copy(), x: self.body.x, y: self.body.y, z: self.body.z, volume: 1.0f32, pitch: 1.0f32, source: self.body.sound_source }),
                ConsumeEffect.Unknown(what) => missing.push(what.copy()),
            }
        }
    }

    /// `removeEffect` of the kind `id` (D518): where it has one, taken off, `onEffectsRemoved`;
    /// whether it had one.
    pub fn remove_effect(mut self, lf: LivingFacts, id: i32) -> bool {
        let at = self.effect_at(id) else return false
        _ = self.effects.remove(at)
        self.effect_removed(lf, id)
        return true
    }

    /// `removeAllEffects` (D518): every one taken off, `onEffectsRemoved`; whether it had any.
    pub fn remove_all_effects(mut self, lf: LivingFacts) -> bool {
        if self.effects.is_empty() {
            return false
        }
        let all = self.effects.copy()
        self.effects.clear()
        for e in all {
            self.effect_removed(lf, e.id)
        }
        return true
    }

    /// Whether what last hurt it, `getLastDamageSource()`, within 40 ticks of the game time `now`,
    /// is of a type in the tag of the bit `tag`, `is(tag)` (D416).
    pub fn recently_hurt_by(self, now: i64, tag: u32) -> bool {
        return self.recent_damage(now) != none and self.last_damage_tags & tag != 0u32
    }

    /// `getLastDamageSource()`: what last hurt it, where that was 40 ticks or less before the game
    /// time `now` (D416).
    pub fn recent_damage(self, now: i64) -> Damage? {
        if now - self.last_damage_stamp > 40 {
            return none
        }
        return self.last_damage
    }

    // `actuallyHurt` of `amount`, where it isn't invulnerable to it: less what its armor takes,
    // `getDamageAfterArmorAbsorb`, unless the type bypasses armor, that share changed by the armor
    // effectiveness of what dealt it's weapon, `ward`'s, drawing from its random where they draw,
    // and kept within 0 and 1, `modifyArmorEffectiveness` (D443); and, where it's left with any,
    // unless the type bypasses effects, what its enchantments' protection, `ward`'s, takes, unless
    // it bypasses enchantments, `getDamageAfterMagicAbsorb` (D439); a witch's own, none from itself
    // and 15% of what witches resist, `Witch.getDamageAfterMagicAbsorb` (CAL-159); its absorption
    // taken first, the rest from its health. Before its protection, resistance takes a fifth for
    // each level, all at the fifth, unless the type bypasses resistance (CAL-163). What resistance
    // took and what absorption took, for the player who caused it to count (CAL-164).
    fn actually_hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, fire_immune: bool, ward: Ward, heard: usize) -> (f32, f32) {
        if self.invulnerable_to(types, d, fire_immune, ward.immune) {
            return (0.0f32, 0.0f32)
        }
        // A wolf's armor takes all of it but what bypasses it, `Wolf.actuallyHurt`: worn by it
        // rounded up, `hurtAndBreak`, which its level does, `Shown.Wore`, its cracks heard there
        // (CAL-201).
        if self.wolf_armor_absorbs(types, d) {
            self.show(Shown.Wore((BODY_SLOT, i32.saturate(f64(amount).ceil()))), heard)
            return (0.0f32, 0.0f32)
        }
        var resisted = 0.0f32
        var damage = amount
        if not types.is(d.kind, BYPASSES_ARMOR) {
            let armor = f32.nearest(f64(floor(self.attributes.value(lf.armor))))
            let toughness = f32.nearest(self.attributes.value(lf.armor_toughness))
            if ward.armor.is_empty() {
                damage = after_absorb(damage, armor, toughness)
            } else {
                var share = armor_share(damage, armor, toughness)
                for (effect, lv) in ward.armor {
                    share = value_effect(effect.copy(), lv, share, mut self.body.random)
                }
                // `Mth.clamp`.
                share = if share < 0.0f32 { 0.0f32 } else { share.min(1.0f32) }
                damage = damage * (1.0f32 - share)
            }
        }
        if not types.is(d.kind, BYPASSES_EFFECTS) {
            if let at = self.effect_at(RESISTANCE) {
                if not types.is(d.kind, BYPASSES_RESISTANCE) {
                    let absorb = 25 - (self.effects[at].amplifier() + 1) * 5
                    let v = damage * f32.nearest(absorb)
                    let before = damage
                    damage = (v / 25.0f32).max(0.0f32)
                    resisted = before - damage
                }
            }
            if damage <= 0.0f32 {
                damage = 0.0f32
            } else if not types.is(d.kind, BYPASSES_ENCHANTMENTS) and ward.protection > 0.0f32 {
                damage = after_magic_absorb(damage, ward.protection)
            }
        }
        if self.magic_resistant {
            if d.cause == self.body.id {
                damage = 0.0f32
            }
            if types.is(d.kind, WITCH_RESISTANT_TO) {
                damage = damage * 0.15f32
            }
        }
        let original = damage
        damage = (damage - self.absorption).max(0.0f32)
        let absorbed = self.absorption - (original - damage)
        self.set_absorption(lf, absorbed)
        if damage != 0.0f32 {
            // `recordDamage` (CAL-201).
            if let tracker = self.combat.take() {
                var c = tracker
                let entry = CombatEntry { kind: d.kind, cause: d.cause, direct: d.direct, damage: damage, fall_location: if self.body.in_water { some(WATER_FALL) } else { none }, fall_distance: f32.nearest(self.hurt_fall ?? self.body.fall) }
                _ = c.record(entry, self.body.tick_count, self.health() > 0.0f32, d.living_cause or d.player != none)
                self.combat = some(c)
            }
            let now = self.health()
            self.set_health(lf, now - damage)
            let left = self.absorption - damage
            self.set_absorption(lf, left)
        }
        return (resisted, original - damage)
    }

    /// The wear of its body armor a hurt it took showed, `Shown.Wore`, taken out of what it shows,
    /// for its level to wear it before its damage event; none where there's none (CAL-201).
    pub fn take_body_wear(mut self) -> i32? {
        for i in 0..self.shown.len() {
            if let Shown.Wore((slot, n)) = self.shown[i] {
                if slot == BODY_SLOT {
                    _ = self.shown.remove(i)
                    if i < self.shown_after.len() {
                        _ = self.shown_after.remove(i)
                    }
                    return some(n)
                }
            }
        }
        return none
    }

    /// Whether its armor takes a hurt of `d`, a wolf's, `canArmorAbsorb`: it wears wolf armor in
    /// its body slot, and the hurt's type isn't `#bypasses_wolf_armor` (CAL-201).
    pub fn wolf_armor_absorbs(self, types: DamageTypes, d: Damage) -> bool {
        if BODY_SLOT >= self.equipment.len() or types.is(d.kind, BYPASSES_WOLF_ARMOR) {
            return false
        }
        let stack = self.equipment[BODY_SLOT].copy() else return false
        let Tag.Compound(c) = stack else return false
        if not c.contains("id") {
            return false
        }
        return match c["id"] {
            Tag.Str(s) => s == "minecraft:wolf_armor",
            _ => false,
        }
    }

    // `setAbsorptionAmount`: within 0 and its most absorption, `Mth.clamp`.
    fn set_absorption(mut self, lf: LivingFacts, amount: f32) {
        let most = f32.nearest(self.attributes.value(lf.max_absorption))
        self.absorption = if amount < 0.0f32 { 0.0f32 } else { amount.min(most) }
    }

    /// `knockback(power, xd, zd)` (D416): its motion pushed `power` away from the way `xd`, `zd`
    /// points, less as its knockback resistance says, and not at all where that leaves none;
    /// where the way's too short to tell, one drawn from its random, two doubles each way; half
    /// its motion across kept, and on the ground, half up and `power` more, 0.4 at most; its
    /// tracker to send it, `needsSync`.
    pub fn knockback(mut self, lf: LivingFacts, power: f64, xd: f64, zd: f64) {
        if self.knock_proof {
            return
        }
        let p = power * (1.0 - self.attributes.value(lf.knockback_resistance))
        if p <= 0.0 {
            return
        }
        self.body.needs_sync = true
        var x = xd
        var z = zd
        while x * x + z * z < f64(1.0e-5f32) {
            x = (self.body.random.next_double() - self.body.random.next_double()) * 0.01
            z = (self.body.random.next_double() - self.body.random.next_double()) * 0.01
        }
        // `Vec3.normalize`, then `scale`.
        let length = (x * x + z * z).sqrt()
        let (px, pz) = if length < f64(1.0e-5f32) { (0.0, 0.0) } else { (x / length * p, z / length * p) }
        self.body.vx = self.body.vx / 2.0 - px
        if self.body.on_ground {
            self.body.vy = (self.body.vy / 2.0 + p).min(0.4)
        }
        self.body.vz = self.body.vz / 2.0 - pz
        self.body.hold_still()
    }

    /// `handleKillingBlow` and `setPose(DYING)`, as `die` has them (D416): it's died, and lies
    /// dying. What it drops and its entity event 3 are its level's, between.
    pub fn killed(mut self) {
        self.dead = true
    }

    pub fn lie_dying(mut self) {
        self.data.set(POSE_ID, Value.Number(DYING))
    }

    /// Its air, `getAirSupply`.
    pub fn air(self) -> i32 {
        return self.data.number(AIR_SUPPLY)
    }

    /// `setAirSupply`, kept with its body for its save.
    pub fn set_air(mut self, air: i32) {
        self.data.set(AIR_SUPPLY, Value.Number(air))
        self.body.air = air
    }

    /// `WaterAnimal.handleAirSupply` after its base tick (CAL-178), `before` its air as that
    /// began: alive and out of water, that less 1, and at -20, 0 and whether it drowns; else
    /// 300.
    pub fn water_animal_air(mut self, before: i32) -> bool {
        if self.alive() and not self.body.in_water {
            self.set_air(before - 1)
            if self.air() <= -20 {
                self.set_air(0)
                return true
            }
            return false
        }
        self.set_air(300)
        return false
    }

    /// Whether it's silent, `isSilent`, which plays none of its sounds.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    // `Entity.playSound`: `sound` where it is, unless it's silent.
    pub fn play(self, sounds: mut List<EntitySound>, sound: own String, volume: f32, pitch: f32) {
        if not self.silent() {
            sounds.push(EntitySound { sound: sound, x: self.body.x, y: self.body.y, z: self.body.z, volume: volume, pitch: pitch, source: self.body.sound_source })
        }
    }

    // Its body's `updateFluidInteraction`, which splashes into water, unheard where it's silent.
    // A drowned swimming isn't pushed by the currents, `Drowned.isPushedByFluid` (CAL-175), nor a
    // fish, `WaterAnimal.isPushedByFluid` (CAL-178).
    fn update_fluids<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let heard = sounds.len()
        let pushed = not (self.drowned and self.swimming) and not self.fish and not self.unpushed
        _ = self.body.update_fluids_pushed(f, t, blocks, fast_lava, true, pushed, mut sounds)
        if self.silent() {
            sounds.truncate(heard)
        }
    }

    /// The rest of `LivingEntity.baseTick` once `entity_tick`'s done and its fire's hurt it, in a
    /// level whose floor is `min_y`, as an armor stand has it, `heard` of its tick's sounds
    /// played: below the level gone, killed, `onBelowWorld`; `entity_tick_end`; its air,
    /// `breathe`, though it breathes in water; `living_tick_end`; its effects, as an armor stand
    /// ticks them, unhurt, `tick_effects_unhurt`; and `turns_end`. A mob is hurt as it goes,
    /// `Mob.base_tick` (D424); an armor stand's fire hurts it as its own hurt has it,
    /// `ArmorStand.tick` (D441).
    pub fn base_tick_end<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, min_y: i32, heard: usize, players: List<Follower>) {
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        self.entity_tick_end()
        if self.alive() {
            _ = self.breathe(f, t, blocks, lf, false, true, heard)
        }
        self.living_tick_end(heard, players)
        self.tick_effects_unhurt(lf)
        self.turns_end()
    }

    /// `commonTick` and `Entity.baseTick` up to its look below the level, where lava's fast if
    /// `fast_lava`: its turns and place as its tick begins, its count; its portal cooldown, its
    /// fluids, its fire, and lava halving its fall. Where it's immune its fire's put out; else a
    /// tick of it burns, and every 20 out of lava it hurts, 1 of `on_fire`, which it gives back for
    /// its own hurt to deal (D434). A nether portal it's in takes it nowhere here, as one does
    /// through `entity_tick_portal` (D578).
    pub fn entity_tick<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        _ = self.entity_tick_portal(lf)
        return self.entity_tick_on(f, t, blocks, fast_lava, mut sounds)
    }

    /// `entity_tick` to its portal (D578): its turns and place as its tick begins, its count, its
    /// speed, its portal cooldown, then its way through the nether portal it's in, where it's
    /// alive and not asleep, `LivingEntity.canUsePortal`, its cooldown then 300, the portal given
    /// for its caller to save it with as it is now, `Body.travel`.
    pub fn entity_tick_portal(mut self, lf: LivingFacts) -> PortalProcess? {
        if self.invulnerable_time > 0 {
            self.invulnerable_time -= 1
        }
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.y_rot_o = self.body.y_rot
        self.x_rot_o = self.body.x_rot
        self.body.tick_count += 1
        self.refresh_body(lf)
        // `Entity.baseTick`, its speed computed first, `computeSpeed` (CAL-159).
        self.body.compute_speed()
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        let allowed = self.alive() and self.sleeping == none and self.uses_portals
        return self.body.portal_goes(allowed, PORTAL_DELAY)
    }

    /// `teleportToPortalDestination` of the end gateway `portal` took it by, as the body has it,
    /// `gateway_goes`, its head turned to its yaw, `setYHeadRot`, and its turn last tick its own,
    /// `setOldPosAndRot`; those that see it aren't told at once (D594). What its level's to do of
    /// it.
    pub fn gateway_goes<G: Gateways>(mut self, portal: PortalProcess, gates: G) -> Shown? {
        let done = self.body.gateway_goes(portal, gates, false, false) else return none
        match done {
            Acted.Moved(m) => {
                self.y_head_rot = self.body.y_rot
                self.y_rot_o = self.body.y_rot
                self.x_rot_o = self.body.x_rot
                return some(Shown.Moved(m))
            },
            Acted.Missing(what) => return some(Shown.Missing(what)),
            _ => return none,
        }
    }

    /// The rest of `entity_tick`, after its portal (D578): whether it was in powder snow kept,
    /// `wasInPowderSnow`, and none yet, and whether it walks on powder snow, `walks_on_snow`, of what
    /// isn't a player, whose server takes it from their boots (D698); then its fluids, its fire and
    /// the rest.
    pub fn entity_tick_on<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        if self.golem_dust {
            self.golem_dust_tick(f, t, blocks)
        }
        self.body.powder_snow_tick()
        if not self.body.player {
            self.body.walks_on_snow = self.walks_on_snow()
        }
        // Its eyes in water as it was last looked at, `wasEyeInWater`, `isUnderWater`.
        self.under_water = self.body.water_eyes
        self.update_fluids(f, t, blocks, fast_lava, mut sounds)
        if self.drowned {
            // `Drowned.updateSwimming`: swimming where its AI's on, its eyes under water and it
            // wants to swim (CAL-175).
            self.swimming = self.ai_on and self.under_water and self.wants_swim
            self.data.set_flag(SHARED_FLAGS, SWIMMING_FLAG, self.swimming)
        }
        let immune = self.fire_immune
        let burns = self.body.fire_tick(immune)
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        return burns
    }

    // An iron golem's `canSpawnSprintParticle` and `spawnSprintParticle` (CAL-201): where it moves
    // across more than 2.5000003E-7 squared, 1 in 5, drawn; and then, on a block that shows,
    // `getOnPosLegacy`'s not of `RenderShape.INVISIBLE`, the dust's place across, drawn, which
    // only clients show, `addParticle`.
    fn golem_dust_tick<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B) {
        let (vx, vz) = (self.body.vx, self.body.vz)
        if not (vx * vx + vz * vz > f64(2.5000003e-7f32)) or self.body.random.next_int_below(5) != 0 {
            return
        }
        let (x, y, z) = self.body.on_pos(f, t, blocks, 0.2f32)
        let state = blocks.collision_state(x, y, z) ?? 0u32
        let block = f.block(state)
        for invisible in ["AirBlock", "BarrierBlock", "BubbleColumnBlock", "EndGatewayBlock", "EndPortalBlock", "LightBlock", "LiquidBlock", "MovingPistonBlock", "StructureVoidBlock"] {
            if f.is_a(block, String(invisible)) {
                return
            }
        }
        _ = self.body.random.next_double()
        _ = self.body.random.next_double()
    }

    /// The rest of `Entity.baseTick`, after its look below the level: whether it's on fire, its
    /// shared flag, and its first tick over.
    pub fn entity_tick_end(mut self) {
        let shown = self.body.fire_shown()
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, shown)
        self.body.first_tick = false
    }

    /// `Entity.isInWall`, as a living entity that isn't asleep has it (D425), `in_wall_at` where it
    /// is.
    pub fn in_wall<B: CollisionBlocks>(self, f: Facts, m: MovementStates, lf: LivingFacts, blocks: B) -> bool {
        // Never where it has no physics, as an ender dragon hasn't (D608).
        if self.body.no_physics {
            return false
        }
        return in_wall_at(f, m, lf, blocks, self.body.x, self.body.y, self.body.z, self.body.width, self.body.eyes)
    }

    /// `LivingEntity.baseTick`'s air, alive (D424): with its eyes in water but for a bubble
    /// column there, running out where it can't breathe in water, by its type,
    /// `can_breathe_under_water`, or its effects, `breathing`, at -20 given back as 0 with event
    /// 67, then whether it drowns; where it can, coming back 4 a tick, as its effects let it,
    /// `refills`; and out of water, coming back; `heard` the sounds of its tick so far.
    pub fn breathe<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, lf: LivingFacts, breathing: bool, refills: bool, heard: usize) -> bool {
        let eye = self.body.y + f64(self.body.eyes)
        let at_eyes = blocks.collision_state(floor(self.body.x), floor(eye), floor(self.body.z)) ?? 0
        if self.body.water_eyes and f.block(at_eyes) != t.bubble_column {
            if not self.breathes_water and not breathing {
                let now = self.air()
                // An iron golem's never less, `IronGolem.decreaseAirSupply` (CAL-201).
                let breath = if self.keeps_air { now } else { self.less_air(lf, now) }
                self.set_air(breath)
                if self.air() <= -20 {
                    self.set_air(0)
                    self.show(Shown.Event(67i8), heard)
                    return true
                }
            } else if self.air() < self.max_air and refills {
                let more = self.more_air()
                self.set_air(more)
            }
        } else if self.air() < self.max_air {
            let more = self.more_air()
            self.set_air(more)
        }
        return false
    }

    // `increaseAirSupply`: 4 more, up to its most, or a dolphin's whole at once (CAL-201).
    fn more_air(self) -> i32 {
        if self.air_whole {
            return self.max_air
        }
        return (self.air() + 4).min(self.max_air)
    }

    /// The end of `LivingEntity.baseTick` up to its effects, `heard` the sounds of its tick so
    /// far: its hurt time and its cooldown counted down, its death's tick, and who hurt it
    /// forgotten. Its effects follow, `tickEffects`, then `turns_end`.
    pub fn living_tick_end(mut self, heard: usize, players: List<Follower>) {
        if self.hurt_time > 0 {
            self.hurt_time -= 1
        }
        // Its cooldown from being hurt; dying, its death's tick, `tickDeath`, gone at 20 with
        // entity event 60; and who hurt it forgotten, the player once their 100 ticks are done
        // (D416), and the entity that hurt it last, `getLastHurtByMob`, where it's found among the
        // level's players, `players`, or its mobs and armor stands, `hurt_by_found` (D676), once
        // it isn't alive or 100 ticks after; one not found, as a player who's left or a creeper
        // that's exploded, is kept (D442).
        if self.damage_cooldown > 0 {
            self.damage_cooldown -= 1
        }
        if self.dead_or_dying() and not self.own_death {
            self.death_time += 1
            if self.death_time >= 20 and not self.body.removed {
                self.show(Shown.Event(60i8), heard)
                self.body.removed = true
            }
        }
        if self.hurt_by_player_memory > 0 {
            self.hurt_by_player_memory -= 1
        } else {
            self.hurt_by_player = none
        }
        if let who = self.hurt_by_mob {
            var alive = self.hurt_by_found
            for p in players {
                if p.uuid == some(who) {
                    alive = some(not p.dead)
                    break
                }
            }
            if let is = alive {
                if not is or self.body.tick_count - self.hurt_by_mob_stamp > 100 {
                    self.hurt_by_mob = none
                }
            }
        }
        self.hurt_by_found = none
    }

    /// The last of `LivingEntity.baseTick`, after its effects: its head's and body's turns as
    /// they were.
    pub fn turns_end(mut self) {
        self.y_head_rot_o = self.y_head_rot
        self.y_body_rot_o = self.y_body_rot
    }

    /// `canBeAffected` (D512): whether its type can have an effect of the kind `id`, as
    /// `LivingFacts.unaffected` says.
    pub fn can_be_affected(self, lf: LivingFacts, id: i32) -> bool {
        for u in lf.unaffected {
            let (kind, effect) = u
            if kind == self.kind and effect == id {
                return false
            }
        }
        return true
    }

    /// `isInvertedHealAndHarm` (D512): whether healing harms it and harming heals it, its type in
    /// `#inverted_healing_and_harm`.
    pub fn inverted(self, lf: LivingFacts) -> bool {
        return lf.inverted.contains(self.kind)
    }

    /// `WebBlock.entityInside` for a living entity (D696): stuck, `makeStuckInBlock`, slowed to a
    /// quarter across and 0.05 up and down, or with weaving to a half across and a quarter up and
    /// down.
    pub fn web(mut self) {
        if self.has_effect(WEAVING) {
            self.body.make_stuck(0.5, 0.25, 0.5)
        } else {
            self.body.web()
        }
    }

    /// `LivingEntity.canFreeze` (D698): not of a kind that doesn't, `cold_proof`, and none of its
    /// armor, its feet, legs, chest, head or body, in `#freeze_immune_wearables`, leather's; a
    /// spectator, which isn't, is inside nothing.
    pub fn can_freeze(self) -> bool {
        if self.cold_proof {
            return false
        }
        for slot in 2usize..7usize {
            if slot < self.equipment.len() {
                let id = held_item(self.equipment[slot].copy())
                if id == "minecraft:leather_boots" or id == "minecraft:leather_leggings" or id == "minecraft:leather_chestplate" or id == "minecraft:leather_helmet" or id == "minecraft:leather_horse_armor" {
                    return false
                }
            }
        }
        return true
    }

    /// `HoneyBlock.entityInside` of the honey block at x, y, z (D699): sliding down its side as
    /// `Body.honey_slide` has it, then its slide's sound, where it isn't silent, and entity event,
    /// `maybeDoSlideEffects`, each drawn from its level's random, shown after `heard` of its
    /// tick's sounds, `Shown.Honey`.
    pub fn honey(mut self, x: i32, y: i32, z: i32, heard: usize) {
        if not self.body.honey_slide(x, y, z) {
            return
        }
        let at: ((f64, f64, f64), i32)? = if self.silent() { none } else { some(((self.body.x, self.body.y, self.body.z), self.body.sound_source)) }
        self.show(Shown.Honey((at, none)), heard)
    }

    /// `BubbleColumnBlock.entityInside` of the bubble column at `at`, dragging down or not,
    /// `drag` (D700): pushed as `Body.bubble_column` pushes, at its top where nothing's above it,
    /// `bubble_open_above`, where its splashes and bubbles are shown after `heard` of its tick's
    /// sounds, drawn by its level, `Shown.Bubbles`.
    pub fn bubble<B: CollisionBlocks>(mut self, f: Facts, blocks: B, drag: bool, at: (i32, i32, i32), heard: usize) {
        let (x, y, z) = at
        let above = bubble_open_above(f, blocks, x, y, z)
        self.body.bubble_column(drag, above)
        if above {
            self.show(Shown.Bubbles((at, List<(f64, f64)>())), heard)
        }
    }

    /// `PowderSnowBlock.canEntityWalkOnPowderSnow` (D698): of a kind in
    /// `#powder_snow_walkable_mobs`, as its `snow_walker` says, or in leather boots.
    pub fn walks_on_snow(self) -> bool {
        return self.snow_walker or (2 < self.equipment.len() and held_item(self.equipment[2].copy()) == "minecraft:leather_boots")
    }

    /// `InsideBlockEffectType.FREEZE` (D698): in powder snow this tick, `setIsInPowderSnow`, and
    /// where it can freeze, a tick more frozen, up to the 140 that freeze it.
    pub fn freeze(mut self) {
        self.body.in_powder_snow = true
        if self.can_freeze() {
            let frozen = self.data.number(TICKS_FROZEN)
            self.data.set(TICKS_FROZEN, Value.Number((frozen + 1).min(TICKS_TO_FREEZE)))
        }
    }

    /// `PowderSnowBlock.entityInside`'s hold on a living entity (D698), where its feet are in
    /// powder snow, `getInBlockState`, `blocks`' state at its block: `Body.powder_snow`; whether it
    /// moved across so a snowflake may come.
    pub fn in_snow<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let (bx, by, bz) = self.body.block()
        if f.block(blocks.collision_state(bx, by, bz) ?? 0) != lf.powder_snow {
            return false
        }
        return self.body.powder_snow()
    }

    /// `SweetBerryBushBlock.entityInside`'s hold on a living entity (D697): stuck,
    /// `makeStuckInBlock`, slowed to 0.8, a float, across and 0.75 up and down, weaving or not.
    pub fn berry_bush(mut self) {
        self.body.make_stuck(f64(0.8f32), 0.75, f64(0.8f32))
    }

    /// `hasEffect`: whether it has an effect of the kind `id` (CAL-163).
    pub fn has_effect(self, id: i32) -> bool {
        return self.effect_at(id) != none
    }

    /// `triggerOnDeathMobEffects` of it taken out killed (CAL-182): each of its effects' doings,
    /// `onMobRemoved` with `KILLED`, in its list's order; wind charged's burst of 3 to 5, drawn from
    /// its random, half its height up, `WindChargedMobEffect`; oozing's slimes half a block up,
    /// asked of the slimes within 2 of its box, `OozingMobEffect`; and, where it's a player or
    /// `weaves`, the level's `mob_griefing`, weaving's cobwebs about the block it's in, `webs_about`,
    /// `WeavingMobEffect`. Then its effects are gone, `activeEffects.clear()`, nothing said of it.
    /// Vanilla's are a map keyed by each effect's holder, whose order is by identity and isn't
    /// the same from run to run, so where it has two of them they come in the order they came.
    pub fn removal_effects<B: CollisionBlocks>(mut self, f: Facts, blocks: B, weaves: bool) -> List<Removal> {
        var out = List<Removal>()
        for e in self.effects.copy() {
            if e.id == WIND_CHARGED {
                let strength = 3.0f32 + self.body.random.next_float() * 2.0f32
                out.push(Removal.Gust(self.body.x, self.body.y + f64(self.body.height / 2.0f32), self.body.z, strength))
            } else if e.id == OOZING {
                out.push(Removal.Ooze(self.body.x, self.body.y + 0.5, self.body.z, self.body.bounding_box().inflate(2.0, 2.0, 2.0)))
            } else if e.id == WEAVING and weaves {
                out.push(Removal.Webs(webs_about(f, blocks, mut self.body.random, self.body.block())))
            }
        }
        self.effects.clear()
        return out
    }

    /// Where its effect of the kind `id` is among its effects, none where it has none.
    pub fn effect_at(self, id: i32) -> usize? {
        for i in 0..self.effects.len() {
            if self.effects[i].id == id {
                return some(i)
            }
        }
        return none
    }

    /// The amplifier of its effect of the kind `id`, -1 where it has none (D515).
    pub fn effect_amplifier(self, id: i32) -> i32 {
        let at = self.effect_at(id) else return -1
        return self.effects[at].amplifier()
    }

    /// `addEffect` of `e` (CAL-163), nothing where its type can't have its kind, `can_be_affected`
    /// (D512): where it has none of its kind, put on, `onEffectAdded`, to be shown, its kind's
    /// modifiers on at its level, and its sound played where its kind makes one, as its level
    /// plays it, though it's silent, `MobEffect.onEffectAdded`; else merged into the one it has,
    /// `update`, refreshed where that changed it, `onEffectUpdated`. Then its start,
    /// `onEffectStarted`: absorption's, its absorption at least 4 a level. Whether it changed.
    pub fn add_effect(mut self, lf: LivingFacts, e: ActiveEffect, sounds: mut List<EntitySound>) -> bool {
        if not self.takes_effects or not self.can_be_affected(lf, e.id) {
            return false
        }
        var changed = false
        if let at = self.effect_at(e.id) {
            if self.effects[at].update(e.now) {
                self.effect_updated(lf, at, true)
                changed = true
            }
        } else {
            self.effects.push(e.copy())
            self.effects_dirty = true
            self.modifiers_on(lf, e.id, e.amplifier())
            changed = true
            if let s = lf.effects[usize.wrap(e.id)].sound {
                sounds.push(EntitySound { sound: s.copy(), x: self.body.x, y: self.body.y, z: self.body.z, volume: 1.0f32, pitch: 1.0f32, source: self.body.sound_source })
            }
        }
        if e.id == ABSORPTION {
            let least = f32.nearest(4 * (1 + e.amplifier()))
            let now = self.absorption.max(least)
            self.set_absorption(lf, now)
        }
        return changed
    }

    /// `tickServer` of its effect at `i` up to its act, `applyEffectTick` (CAL-163), `inverted`
    /// where healing harms it and harming heals, `isInvertedHealAndHarm`: false where it has no
    /// time left; else where its kind acts now, `shouldApplyEffectTickThisTick` of its time left,
    /// or of its tick count where it lasts for ever, its act: regeneration's heal of 1 below its
    /// most and instant health's of 4 doubled each level, which it does, and absorption's end once
    /// its absorption's gone; and the hurts of poison while it has more than 1, of wither and of
    /// instant damage, 6 doubled each level, which it gives back, `MAGIC_HURT` or `WITHER_HURT`
    /// and the amount, for its kind to deal, as `hurtServer`.
    pub fn effect_act(mut self, lf: LivingFacts, i: usize, inverted: bool) -> (bool, i32, f32) {
        let e = self.effects[i].copy()
        if not e.remaining() {
            return (false, NO_HURT, 0.0f32)
        }
        let amp = e.amplifier()
        let count = if e.now.infinite() { self.body.tick_count } else { e.duration() }
        let at = usize.wrap(e.id)
        if not lf.effects[at].should_tick(count, amp) {
            return (true, NO_HURT, 0.0f32)
        }
        let kind = lf.effects[at].ticks
        if kind == HEALS {
            if self.health() < self.max_health(lf) {
                self.heal(lf, 1.0f32)
            }
        } else if kind == POISONS {
            if self.health() > 1.0f32 {
                return (true, MAGIC_HURT, 1.0f32)
            }
        } else if kind == WITHERS {
            return (true, WITHER_HURT, 1.0f32)
        } else if kind == HEALS_NOW or kind == HARMS_NOW {
            if (kind == HARMS_NOW) == inverted {
                let amount = (4 << (amp & 31)).max(0)
                self.heal(lf, f32.nearest(amount))
            } else {
                return (true, MAGIC_HURT, f32.nearest(6 << (amp & 31)))
            }
        } else if kind == ABSORBS {
            return (self.absorption > 0.0f32, NO_HURT, 0.0f32)
        }
        return (true, NO_HURT, 0.0f32)
    }

    /// The rest of `tickServer` and `tickEffects` for its effect at `i`, `kept` its act's answer
    /// (CAL-163): where it's kept, a tick less of it, and where it ran out, the one it hid in its
    /// place, refreshed, `onEffectUpdated`; then taken off where that leaves it no time,
    /// `onEffectsRemoved`, or where what's left is a whole number of 30 seconds, to be shown again,
    /// `onEffectUpdated` without its attributes. Whether it's still on, at `i`.
    pub fn effect_end(mut self, lf: LivingFacts, i: usize, kept: bool) -> bool {
        var on = kept
        if on {
            if self.effects[i].tick_down() {
                self.effect_updated(lf, i, true)
            }
            on = self.effects[i].remaining()
        }
        if not on {
            let e = self.effects.remove(i)
            self.effect_removed(lf, e.id)
            return false
        }
        if self.effects[i].duration() % 600 == 0 {
            self.effect_updated(lf, i, false)
        }
        return true
    }

    /// `tickEffects` as an armor stand has it (CAL-163): each effect ticked, its hurts not dealt,
    /// as magic's and wither's neither break nor kill one, `ArmorStand.hurtServer`.
    pub fn tick_effects_unhurt(mut self, lf: LivingFacts) {
        var i: usize = 0
        while i < self.effects.len() {
            let (kept, _, _) = self.effect_act(lf, i, false)
            if self.effect_end(lf, i, kept) {
                i += 1
            }
        }
    }

    // `onEffectUpdated` of its effect at `i`: to be shown, and where `refresh`, its kind's
    // modifiers put on again at its level and its attributes looked at, `refreshDirtyAttributes`.
    fn effect_updated(mut self, lf: LivingFacts, i: usize, refresh: bool) {
        self.effects_dirty = true
        if refresh {
            let id = self.effects[i].id
            let amp = self.effects[i].amplifier()
            self.modifiers_off(lf, id)
            self.modifiers_on(lf, id, amp)
            self.keep_health(lf)
        }
    }

    // `onEffectsRemoved` of an effect of the kind `id`: to be shown, its kind's modifiers taken
    // off and its attributes looked at.
    fn effect_removed(mut self, lf: LivingFacts, id: i32) {
        self.effects_dirty = true
        self.modifiers_off(lf, id)
        self.keep_health(lf)
    }

    // `addAttributeModifiers` of the kind `id` at `amplifier`: its modifier, where it has one, on
    // its attribute's instance, made where its type has it, in place of any with its ID, permanent
    // and its amount as much again for each level, `AttributeTemplate.create`.
    fn modifiers_on(mut self, lf: LivingFacts, id: i32, amplifier: i32) {
        let m = lf.effects[usize.wrap(id)].modifier else return
        let (a, path, amount, operation) = m
        self.attributes.take_off(a, Identifier { namespace: "minecraft", path: path.copy() })
        self.attributes.add_permanent(a, Modifier.named(path.copy(), amount * f64(amplifier + 1), operation))
    }

    // `removeAttributeModifiers` of the kind `id`: its modifier off its attribute's instance.
    fn modifiers_off(mut self, lf: LivingFacts, id: i32) {
        let m = lf.effects[usize.wrap(id)].modifier else return
        let (a, path, _, _) = m
        self.attributes.take_off(a, Identifier { namespace: "minecraft", path: path.copy() })
    }

    /// `updateDirtyEffects`, as its values are to be sent, `updateDataBeforeSync` (CAL-163):
    /// where its effects changed, `updateInvisibilityStatus`, with none its particles none and
    /// it visible, else invisible where it has invisibility and its particles those of its
    /// effects that show them, `ambient` where all those are, an armor stand invisible as it's
    /// set; and glowing where it has the glowing effect or was set to, `isCurrentlyGlowing`.
    pub fn update_dirty_effects(mut self, lf: LivingFacts) {
        if not self.effects_dirty {
            return
        }
        if not self.stand {
            if self.effects.is_empty() {
                self.data.set(EFFECT_PARTICLES, Value.Particles(List<(i32, i32?)>()))
                self.data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, false)
            } else {
                let invisible = self.has_effect(INVISIBILITY)
                self.data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, invisible)
                var shown = List<(i32, i32?)>()
                var ambient = true
                for e in self.effects {
                    if e.now.visible {
                        shown.push(lf.effects[usize.wrap(e.id)].particle_of(e.now.ambient))
                        if not e.now.ambient {
                            ambient = false
                        }
                    }
                }
                self.data.set(EFFECT_PARTICLES, Value.Particles(shown))
                self.data.set(EFFECT_AMBIENCE, Value.Bool(ambient))
            }
        }
        let glowing = self.has_effect(GLOWING) or bool_or(self.body.extras, "Glowing")
        if (i32(self.data.byte(SHARED_FLAGS)) & GLOWING_FLAG != 0) != glowing {
            self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, glowing)
        }
        self.effects_dirty = false
    }

    // `decreaseAirSupply`: a breath less, unless its oxygen bonus spares it, a draw from its
    // random where it has any. Asking for the bonus makes its instance.
    fn less_air(mut self, lf: LivingFacts, air: i32) -> i32 {
        _ = self.attributes.instance(lf.oxygen_bonus)
        let bonus = self.attributes.value(lf.oxygen_bonus)
        if bonus > 0.0 and self.body.random.next_double() >= 1.0 / (bonus + 1.0) {
            return air
        }
        return air - 1
    }

    /// `aiStep` up to what it's inside, where it moves at all, `isEffectiveAi`, as `effective`
    /// says: its jump delay; its motion under 0.003 each way let go; what it's told to walk
    /// slowed; its jump; its travel where it's effective; then what the block it's on does to it,
    /// `step_on_block`, which it gives back (D431). What it's inside follows, as its kind takes
    /// it, an armor stand's `ArmorStand.inside` (D441), then its freezing, `ai_end`.
    pub fn ai_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, effective: bool, sounds: mut List<EntitySound>) -> Stepped {
        _ = self.ai_start()
        self.ai_rest(lf, f, m, t, blocks, fast_lava, effective, mut sounds)
        return self.step_on_block(f, t, blocks)
    }

    /// `aiStep` up to where a mob thinks, `serverAiStep`: its jump's delay counted down, its
    /// motion under 0.003 each way let go, what it's told to walk slowed, `applyInput`, and all of
    /// it let go where it's dying; whether it isn't, so may think.
    pub fn ai_start(mut self) -> bool {
        let dying = not (self.health() > 0.0f32)
        return self.ai_start_as(dying)
    }

    /// `ai_start` for an entity whose `isImmobile` is `immobile`: all it's told let go there, and
    /// whether it may think.
    pub fn ai_start_as(mut self, immobile: bool) -> bool {
        if self.no_jump_delay > 0 {
            self.no_jump_delay -= 1
        }
        if self.body.vx.abs() < 0.003 {
            self.body.vx = 0.0
        }
        if self.body.vz.abs() < 0.003 {
            self.body.vz = 0.0
        }
        if self.body.vy.abs() < 0.003 {
            self.body.vy = 0.0
        }
        self.xxa = self.xxa * 0.98f32
        self.zza = self.zza * 0.98f32
        if immobile {
            self.jumping = false
            self.xxa = 0.0f32
            self.zza = 0.0f32
            return false
        }
        return true
    }

    /// The rest of `aiStep`, after a mob's thought: its jump, and `travel` where it moves,
    /// `effective`. What the block it's on does to it, `step_on_block`, and its freezing,
    /// `ai_end`, follow (D431).
    pub fn ai_rest<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, effective: bool, sounds: mut List<EntitySound>) {
        self.fall_hurt = none
        if self.jumping {
            self.jump(lf, f, m, t, blocks, sounds.len())
        } else {
            self.no_jump_delay = 0
        }
        // Its fall forgotten under slow falling or levitation, `resetFallDistance`, travelling
        // or not (D515).
        if self.has_effect(SLOW_FALLING) or self.has_effect(LEVITATION) {
            self.body.reset_fall()
        }
        if effective {
            self.travel(lf, f, m, t, blocks, fast_lava, mut sounds)
        }
    }

    /// `applyEffectsFromBlocks` as it begins, `stepOn` (D431): where blocks act on it, as they
    /// don't on what's taken out or goes through them, `isAffectedByBlocks`, and it's on the
    /// ground, what the block it's on, `getOnPosLegacy`, does to it, where it doesn't step
    /// carefully, `isSteppingCarefully`, holding shift: magma burns it, `Stepped.Magma`, as its
    /// own hurt deals it; a slime block slows it across, by 0.4 and a fifth of how fast it goes up
    /// or down, where that's under 0.1; redstone ore's lit, `Stepped.Ore`, by its level; and
    /// turtle eggs may break, `Stepped.Egg`, as its level draws (CAL-172). What sculk sensors
    /// and, for a player, sculk shriekers do however they step is said to be missing (CAL-275).
    /// What it's inside follows, `inside_blocks` (D434).
    pub fn step_on_block<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B) -> Stepped {
        if self.body.removed or self.body.no_physics or not self.body.on_ground {
            return Stepped.Nothing
        }
        let (x, y, z) = self.body.on_pos(f, t, blocks, 0.2f32)
        let state = blocks.collision_state(x, y, z) ?? 0
        let block = f.block(state)
        // A cat crouching steps carefully too, `Cat.isSteppingCarefully` (CAL-201).
        let careful = self.body.shift or (self.crouching and not self.body.player)
        if f.is_a(block, String("MagmaBlock")) {
            return if careful { Stepped.Nothing } else { Stepped.Magma }
        }
        if f.is_a(block, String("SlimeBlock")) {
            let up = self.body.vy.abs()
            if up < 0.1 and not careful {
                let scale = 0.4 + up * 0.2
                self.body.vx = self.body.vx * scale
                self.body.vz = self.body.vz * scale
            }
            return Stepped.Nothing
        }
        if f.is_a(block, String("RedStoneOreBlock")) {
            return if careful { Stepped.Nothing } else { Stepped.Ore((x, y, z)) }
        }
        if f.is_a(block, String("TurtleEggBlock")) {
            return if careful { Stepped.Nothing } else { Stepped.Egg((x, y, z)) }
        }
        if f.is_a(block, String("SculkSensorBlock")) and (f.get_name(state, String("sculk_sensor_phase")) ?? String()) == "inactive" {
            return Stepped.Missing(String("Sculk sensors stepped on"))
        }
        if self.body.player and f.is_a(block, String("SculkShriekerBlock")) {
            return Stepped.Missing(String("Sculk shriekers stepped on by players"))
        }
        return Stepped.Nothing
    }

    /// `aiStep`'s freezing, after what blocks do to it (D434, D698): its frozen ticks thawing 2 a
    /// tick out of powder snow or where it can't freeze, and the powder snow's slowing taken off
    /// and put back as they say, which makes its speed's instance. Whether it's hurt by its
    /// freezing now, every 40 of its ticks while it's frozen through and can freeze, its caller's
    /// to deal, 1 of `freeze`.
    pub fn ai_end<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B) -> bool {
        let frozen = self.data.number(TICKS_FROZEN)
        let can = self.can_freeze()
        let thawed = if not self.body.in_powder_snow or not can { if frozen - 2 > 0 { frozen - 2 } else { 0 } } else { frozen }
        self.data.set(TICKS_FROZEN, Value.Number(thawed))
        let snow = powder_snow_id()
        self.attributes.take_off(lf.movement_speed, snow.copy())
        if thawed > 0 {
            let (ox, oy, oz) = self.body.on_pos(f, t, blocks, 0.2f32)
            if not f.is_air(blocks.collision_state(ox, oy, oz) ?? 0) {
                let part = f32.nearest(f64(thawed.min(TICKS_TO_FREEZE))) / f32.nearest(f64(TICKS_TO_FREEZE))
                self.attributes.replace(lf.movement_speed, Modifier { id: snow, amount: f64(-0.05f32 * part), operation: ADD_VALUE })
            }
        }
        return self.body.tick_count % 40 == 0 and thawed >= TICKS_TO_FREEZE and can
    }

    /// The moves the blocks it's inside act on it along this tick, its body's, `final_moves`
    /// (D434).
    pub fn final_moves(mut self) -> List<Movement> {
        return self.body.final_moves()
    }

    /// Whether it's on fire, `isOnFire`: fire ticks left, where fire burns it at all.
    pub fn on_fire(self) -> bool {
        return self.body.burning(self.fire_immune)
    }

    /// What `applyEffectsFromBlocks` keeps of it before what it's inside acts on it (D434):
    /// whether it was on fire and freezing, `isFreezing`, and its fire ticks.
    pub fn fire_before(self) -> (bool, bool, i32) {
        return (self.on_fire(), self.data.number(TICKS_FROZEN) > 0, self.body.fire)
    }

    /// `entityInside` of the block `i` it went into, as it goes in, as `touch_block` has it for
    /// what's alive (D434).
    pub fn touch(self, f: Facts, i: Inside, c: mut Collector) -> Touched {
        return touch_block(f, i, mut c, true, false, self.body.on_ground, self.body.y)
    }

    /// One of the effects blocks put on it, `InsideBlockEffectType`'s (D434), `added` the fire
    /// ticks a player's level drew where fire lights them past their wait, `ignite_draws`: its
    /// thawing, `clearFreeze`; fire's lighting, `fireIgnite`; lava's, 15 seconds of fire,
    /// `lavaIgnite`; its putting out, `clearFire`; and its freezing in powder snow, `freeze` (D698).
    pub fn apply_effect(mut self, kind: i32, added: i32) {
        if kind == FREEZE {
            self.freeze()
        } else if kind == CLEAR_FREEZE {
            self.data.set(TICKS_FROZEN, Value.Number(0))
        } else if kind == FIRE_IGNITE {
            let immune = self.fire_immune
            if self.body.fire_ignite(immune, added) {
                self.data.set(TICKS_FROZEN, Value.Number(0))
            }
        } else if kind == LAVA_IGNITE {
            if not self.fire_immune {
                self.ignite_for_ticks(300)
            }
        } else if kind == EXTINGUISH {
            self.body.put_out()
        }
    }

    /// Whether fire lighting it draws from its level first, as a player's does where their fire's
    /// waited out, `fireIgnite`: 1 or 2 more ticks of it.
    pub fn ignite_draws(self) -> bool {
        return self.body.player and not self.fire_immune and self.body.fire >= 0
    }

    /// `igniteForTicks`: on fire for `ticks` where it has less left, its freezing let go.
    pub fn ignite_for_ticks(mut self, ticks: i32) {
        self.body.ignite_for(ticks)
        self.data.set(TICKS_FROZEN, Value.Number(0))
    }

    /// The end of `applyEffectsFromBlocks` (D434), `was` what `fire_before` kept, as its body's
    /// `after_inside` has it, with its freezing.
    pub fn after_inside(mut self, was: (bool, bool, i32), rained: bool, sounds: mut List<EntitySound>) {
        let immune = self.fire_immune
        let freezing = self.data.number(TICKS_FROZEN) > 0
        self.body.after_inside(immune, was, freezing, rained, mut sounds)
    }

    /// What what it wears and holds does against the damage `d` of `types`, enchanted, as its level
    /// `blocks` works it out, `Warding` (D439): whether it's immune, and if not, its protection,
    /// against the damage in its context, itself, `this` to loot, where it is, and `attacker`, a
    /// player, where that caused it and dealt it; none where nothing it has is enchanted. A mob's
    /// and an armor stand's alike (D441). And the first of its hands, the main then the off,
    /// whose stack has `death_protection`, with it, as `checkTotemDeathProtection` looks (D518).
    pub fn ward<B: Warding, W: Wearing>(self, blocks: B, items: W, types: DamageTypes, d: Damage, this: LootEntity, attacker: LootEntity?, missing: mut List<String>) -> Ward {
        var totem: (usize, Tag)? = none
        var found = false
        for hand in 0usize..2usize {
            if hand < self.equipment.len() and not found {
                if let s = self.equipment[hand].copy() {
                    if let p = items.worn_component(s, String("minecraft:death_protection")) {
                        totem = some((hand, p))
                        found = true
                    }
                }
            }
        }
        var enchanted = false
        for each in self.equipment {
            if let s = each {
                if not items.worn_enchantments(s.copy()).is_empty() {
                    enchanted = true
                }
            }
        }
        if not enchanted {
            return Ward { totem: totem }
        }
        let params = LootParams { origin: some((self.body.x, self.body.y, self.body.z)), this_entity: true, this: some(this.copy()), damage_source: true, attacker: attacker.copy(), direct_attacker: attacker.copy(), direct: true, damage_tags: some(types.tags_of(d.kind)) }
        let worn = self.equipment.copy()
        let (immune, why) = blocks.immune(worn.copy(), params.copy())
        for m in why {
            missing.push(m.copy())
        }
        if immune {
            return Ward { immune: true, totem: totem }
        }
        let (protection, unknown) = blocks.protection(worn, params)
        for m in unknown {
            missing.push(m.copy())
        }
        return Ward { protection: protection, totem: totem }
    }

    // The jump in `aiStep`, as it's told to jump: up through water or lava deeper than it jumps
    // out of, `jump_in_liquid`; else off the ground, or out of shallow water, every 10 ticks at
    // most.
    fn jump<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, heard: usize) {
        let lava = self.body.in_lava()
        let height = if lava { self.body.lava } else { self.body.water }
        let wet = self.body.in_water and height > 0.0
        let threshold = self.jump_threshold()
        if not wet or (self.body.on_ground and not (height > threshold)) {
            if not lava or (self.body.on_ground and self.body.lava <= threshold) {
                if (self.body.on_ground or (wet and height <= threshold)) and self.no_jump_delay == 0 {
                    self.jump_from_ground(lf, f, m, t, blocks)
                    if let h = self.hop {
                        self.rabbit_hop(h, heard)
                    }
                    self.no_jump_delay = 10
                }
            } else {
                self.jump_in_liquid(true)
            }
        } else {
            self.jump_in_liquid(false)
        }
    }

    // `jumpInLiquid`: up 0.04 a tick; a mob's whose navigation can't float, `sinks`, 0.3,
    // `Mob.jumpInLiquid` (CAL-175). Added as a vector is, so a -0 across becomes 0. A magma
    // cube's in `lava` its own, `MagmaCube.jumpInLiquid`: up at 0.22 and a twentieth of its size,
    // set, its place then sent.
    fn jump_in_liquid(mut self, lava: bool) {
        if lava {
            if let size = self.magma_size {
                self.body.vy = f64(0.22f32 + f32.nearest(size) * 0.05f32)
                self.body.needs_sync = true
                return
            }
        }
        self.body.vx = self.body.vx + 0.0
        self.body.vy = self.body.vy + (self.liquid_rise ?? (if self.sinks { 0.3 } else { f64(0.04f32) }))
        self.body.vz = self.body.vz + 0.0
    }

    /// `jumpFromGround`: up as fast as it jumps, `getJumpPower`, its jump strength by the jump
    /// factor of the block it's in, or of the one below where that's 1, and a tenth more a level of
    /// jump boost, `getJumpBoostPower` (D515), unless it's going up faster already; its place then
    /// sent. A cube mob's always that fast up (CAL-159), a magma cube's a tenth of its size faster
    /// (CAL-200).
    pub fn jump_from_ground<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        let (bx, by, bz) = self.body.block()
        let here = m.jump_factor(f.block(blocks.collision_state(bx, by, bz) ?? 0))
        let (px, py, pz) = self.body.on_pos(f, t, blocks, 0.500001f32)
        let below = m.jump_factor(f.block(blocks.collision_state(px, py, pz) ?? 0))
        let factor = if f64(here) == 1.0 { below } else { here }
        let power = f32.nearest(self.attributes.value(lf.jump_strength)) * self.jump_multiplier * factor + jump_boost_power(self.effect_amplifier(JUMP_BOOST))
        if self.cube {
            self.body.vy = match self.magma_size {
                some(size) => f64(power + f32.nearest(size) * 0.1f32),
                none => f64(power),
            }
            self.body.needs_sync = true
            return
        }
        if not (power <= 1.0e-5f32) {
            let up = f64(power)
            self.body.vy = if up > self.body.vy { up } else { self.body.vy }
            self.body.needs_sync = true
        }
    }

    // `Rabbit.jumpFromGround`'s, after a living entity's (CAL-201): where its move control's speed
    // is above 0 and it's barely moving across, pushed on a tenth as though told to walk 1 ahead
    // and 1.5 up, a baby 0.5, `moveRelative`; then entity event 1 to those who see it, its hop.
    fn rabbit_hop(mut self, h: (f64, bool), heard: usize) {
        let (speed, baby) = h
        if speed > 0.0 and self.body.vx * self.body.vx + self.body.vz * self.body.vz < 0.01 {
            self.move_relative_by(0.1f32, 0.0, if baby { 0.5 } else { 1.5 }, 1.0)
        }
        self.show(Shown.Event(1i8), heard)
    }

    // `getFluidJumpThreshold`: 0.4, or none where its eyes are lower than that.
    fn jump_threshold(self) -> f64 {
        return if f64(self.body.eyes) < 0.4 { 0.0 } else { 0.4 }
    }

    /// `travel`: through water or lava where it's in either and they move it, which they don't
    /// where it flies, `isAffectedByFluids`, else gliding where it glides, `travelFallFlying`
    /// (CAL-286), else through the air; then, flying, its motion up or
    /// down 0.6 of what it was, as `Player.travel` has it (D419). Through a fluid, it falls as its
    /// gravity does with slow falling, `getEffectiveGravity` (D515).
    pub fn travel<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.body.still {
            // A shulker's (CAL-200): its motion, none, moved by, what's made of it let go.
            self.body.hold_still()
            self.travel_in_air(lf, f, m, t, blocks, fast_lava, mut sounds)
            self.body.hold_still()
            return
        }
        if self.flies_free {
            self.travel_flying(lf, f, m, t, blocks, fast_lava, mut sounds)
            return
        }
        if self.moves_as_is {
            let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
            self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
            return
        }
        let was_up = self.body.vy
        self.body.slow_falling = self.has_effect(SLOW_FALLING)
        if (self.body.in_water or self.body.in_lava()) and not self.flying {
            let falling = self.body.vy <= 0.0
            let old_y = self.body.y
            let gravity = self.body.effective_gravity()
            if self.body.in_water {
                self.travel_in_water(lf, f, m, t, blocks, fast_lava, gravity, falling, old_y, mut sounds)
            } else {
                self.travel_in_lava(lf, f, m, t, blocks, fast_lava, gravity, falling, old_y, mut sounds)
            }
        } else if self.gliding {
            self.travel_fall_flying(lf, f, m, t, blocks, fast_lava, mut sounds)
        } else {
            self.travel_in_air(lf, f, m, t, blocks, fast_lava, mut sounds)
        }
        if self.flying {
            self.body.vy = was_up * 0.6
        }
    }

    // `travelFlying(input, speed)`, a phantom's whole `travel`, its speed 0.2, and a ghast's, 0.02
    // (CAL-200): in water at 0.02, moved,
    // then slowed to 0.8, a float; in lava at 0.02, then to a half; else at its `fly_speed`, then to 0.91, a
    // float, every way alike, with no gravity.
    fn travel_flying<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let (speed, slowed) = if self.body.in_water { (0.02f32, f64(0.8f32)) } else if self.body.in_lava() { (0.02f32, 0.5) } else { (self.fly_speed, f64(0.91f32)) }
        self.move_relative(speed)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        self.body.vx = self.body.vx * slowed
        self.body.vy = self.body.vy * slowed
        self.body.vz = self.body.vz * slowed
    }

    // `travelFallFlying` (CAL-286): on what's climbable, through the air, and the glide stops,
    // `glide_stopped`; else its motion as `updateFallFlyingMovement` turns it, then moved by it,
    // and where it flew into a wall, `horizontalCollision`, ten times the speed across it lost,
    // less 3, as `fly_into_wall`'s damage, `wall_hit`, where that's more than 0,
    // `handleFallFlyingCollisions`.
    fn travel_fall_flying<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.on_climbable(lf, f, blocks) {
            self.travel_in_air(lf, f, m, t, blocks, fast_lava, mut sounds)
            self.glide_stopped = true
            return
        }
        let last_speed = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
        self.glide_movement()
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        if self.body.horizontal_collision {
            let new_speed = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
            let damage = f32.nearest((last_speed - new_speed) * 10.0 - 3.0)
            if damage > 0.0f32 {
                self.wall_hit = damage
            }
        }
    }

    // `updateFallFlyingMovement` of its motion (CAL-286), by where it looks, `getLookAngle`, and
    // its pitch in radians, a float, `leanAngle`: down by its gravity, `getEffectiveGravity`, less
    // three quarters of the lift, the square of the pitch's cosine, `Math.cos`; falling, a tenth of
    // that fall times the lift turned forward along the look and up; pitched up, 0.04 of its speed
    // across times the pitch's sine, `Mth.sin`, taken from across, 3.2 times it put up; a tenth of
    // the way across to its speed across along the look; then slowed by 0.99 across and 0.98 up and
    // down.
    fn glide_movement(mut self) {
        let (lx, _, lz) = view_vector(self.body.x_rot, self.body.y_rot)
        let lean = self.body.x_rot * 0.017453292f32
        let look_across = (lx * lx + lz * lz).sqrt()
        var vx = self.body.vx
        var vy = self.body.vy
        var vz = self.body.vz
        let move_across = (vx * vx + vz * vz).sqrt()
        let gravity = self.body.effective_gravity()
        let c = java_cos(f64(lean))
        let lift = c * c
        vy = vy + gravity * (-1.0 + lift * 0.75)
        if vy < 0.0 and look_across > 0.0 {
            let convert = vy * -0.1 * lift
            vx = vx + lx * convert / look_across
            vy = vy + convert
            vz = vz + lz * convert / look_across
        }
        if lean < 0.0f32 and look_across > 0.0 {
            let convert = move_across * f64(-table_sin(f64(lean))) * 0.04
            vx = vx - lx * convert / look_across
            vy = vy + convert * 3.2
            vz = vz - lz * convert / look_across
        }
        if look_across > 0.0 {
            vx = vx + (lx / look_across * move_across - vx) * 0.1
            vz = vz + (lz / look_across * move_across - vz) * 0.1
        }
        self.body.vx = vx * f64(0.99f32)
        self.body.vy = vy * f64(0.98f32)
        self.body.vz = vz * f64(0.99f32)
    }

    // `travelInAir`: on the ground, as slippery as the block below it, `computeModifiedFriction`
    // by its friction modifier, it walks as fast as that lets it, then moves, up 0.2 a tick where it
    // climbs into a wall or jumps; levitating, a fifth of the way to 0.05 a level up a tick, else
    // it falls as its gravity says with slow falling, `getEffectiveGravity` (D515); and it's slowed
    // by the air and that block.
    fn travel_in_air<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let (px, py, pz) = self.body.on_pos(f, t, blocks, 0.500001f32)
        let friction = if self.body.on_ground {
            modified_friction(m.friction(f.block(blocks.collision_state(px, py, pz) ?? 0)), f32.nearest(self.attributes.value(lf.friction_modifier)))
        } else {
            1.0f32
        }
        // `handleRelativeFrictionAndCalculateMovement`.
        let walk = self.friction_speed(friction)
        self.move_relative(walk)
        self.climb_clamp(lf, f, blocks)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        let mx = self.body.vx
        var my = self.body.vy
        let mz = self.body.vz
        if (self.body.horizontal_collision or self.jumping) and self.on_climbable(lf, f, blocks) {
            my = 0.2
        }
        let levitation = self.effect_amplifier(LEVITATION)
        if levitation >= 0 {
            my = my + (0.05 * f64(levitation + 1) - my) * 0.2
        } else {
            my = my - self.body.effective_gravity()
        }
        let drag = f32.nearest(self.attributes.value(lf.air_drag_modifier))
        let in_air = modified_friction(0.91f32, drag)
        let across = friction * in_air
        // Up and down as across where it moves through the air every way alike (CAL-177).
        let up = if self.omni_air { in_air } else { modified_friction(0.98f32, drag) }
        self.body.vx = mx * f64(across)
        self.body.vy = my * f64(up)
        self.body.vz = mz * f64(across)
    }

    // `travelInWater`: slowed by the water, 0.9 sprinting (D419), as its movement efficiency lets
    // it, half that off the ground, or 0.96 with dolphin's grace (D515), it swims at 0.02 a tick,
    // moves, up 0.2 a tick where it climbs into a wall, is slowed 0.8 up and down, held up as water
    // holds it unless it sprints, and jumps out over an edge it's pushed against.
    fn travel_in_water<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, gravity: f64, falling: bool, old_y: f64, sounds: mut List<EntitySound>) {
        if self.drowned and self.under_water and self.wants_swim {
            // `Drowned.travelInWater`, under water and wanting to swim: 0.01 a tick, moved, then
            // slowed to 0.9 (CAL-175).
            self.move_relative(0.01f32)
            let (sx, sy, sz) = (self.body.vx, self.body.vy, self.body.vz)
            self.move_self(lf, f, m, t, blocks, sx, sy, sz, fast_lava, mut sounds)
            self.body.vx = self.body.vx * 0.9
            self.body.vy = self.body.vy * 0.9
            self.body.vz = self.body.vz * 0.9
            return
        }
        if self.fish {
            // `AbstractFish.travelInWater` (CAL-178): 0.01 a tick, moved, slowed to 0.9, then
            // down 0.005 with no target.
            self.move_relative(0.01f32)
            let (sx, sy, sz) = (self.body.vx, self.body.vy, self.body.vz)
            self.move_self(lf, f, m, t, blocks, sx, sy, sz, fast_lava, mut sounds)
            self.body.vx = self.body.vx * 0.9
            self.body.vy = self.body.vy * 0.9 - 0.005
            self.body.vz = self.body.vz * 0.9
            return
        }
        if self.guardian_swim or self.dolphin_swim {
            // `Guardian.travelInWater` (CAL-200): 0.1 a tick, moved, slowed to 0.9, then down
            // 0.005 where it's idle; a dolphin's at its speed, `Dolphin.travelInWater` (CAL-201).
            let pace = if self.dolphin_swim { self.speed } else { 0.1f32 }
            self.move_relative(pace)
            let (sx, sy, sz) = (self.body.vx, self.body.vy, self.body.vz)
            self.move_self(lf, f, m, t, blocks, sx, sy, sz, fast_lava, mut sounds)
            self.body.vx = self.body.vx * 0.9
            self.body.vy = self.body.vy * 0.9
            self.body.vz = self.body.vz * 0.9
            if self.idle_in_water {
                self.body.vy = self.body.vy + -0.005
            }
            return
        }
        var slow = if self.sprinting { 0.9f32 } else { self.water_slow_down }
        var swim = 0.02f32
        var walker = f32.nearest(self.attributes.value(lf.water_efficiency))
        if not self.body.on_ground {
            walker = walker * 0.5f32
        }
        if walker > 0.0f32 {
            slow = slow + (0.54600006f32 - slow) * walker
            swim = swim + (self.speed - swim) * walker
        }
        if self.has_effect(DOLPHINS_GRACE) {
            slow = 0.96f32
        }
        self.move_relative(swim)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        var mx = self.body.vx
        var my = self.body.vy
        var mz = self.body.vz
        if self.body.horizontal_collision and self.on_climbable(lf, f, blocks) {
            my = 0.2
        }
        mx = mx * f64(slow)
        my = my * f64(0.8f32)
        mz = mz * f64(slow)
        self.body.vx = mx
        self.body.vy = if self.sprinting { my } else { fluid_falling(gravity, falling, my) }
        self.body.vz = mz
        self.jump_out_of_fluid(f, m, blocks, old_y)
    }

    // `travelInLava`: it swims at 0.02 a tick, moves, and is slowed by half, 0.8 up and down where
    // the lava's shallow, held up as lava holds it unless it sprints (D419), then falls a quarter
    // of its gravity and jumps out over an edge it's pushed against.
    fn travel_in_lava<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, gravity: f64, falling: bool, old_y: f64, sounds: mut List<EntitySound>) {
        self.move_relative(0.02f32)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        if self.body.lava <= self.jump_threshold() {
            self.body.vx = self.body.vx * 0.5
            let my = self.body.vy * f64(0.8f32)
            self.body.vy = if self.sprinting { my } else { fluid_falling(gravity, falling, my) }
            self.body.vz = self.body.vz * 0.5
        } else {
            self.body.vx = self.body.vx * 0.5
            self.body.vy = self.body.vy * 0.5
            self.body.vz = self.body.vz * 0.5
        }
        if gravity != 0.0 {
            self.body.vx = self.body.vx + 0.0
            self.body.vy = self.body.vy + -gravity / 4.0
            self.body.vz = self.body.vz + 0.0
        }
        self.jump_out_of_fluid(f, m, blocks, old_y)
    }

    // `jumpOutOfFluid`: pushed against something across, up at 0.3 a tick where 0.6 up from where
    // it began the tick there's neither a block nor a fluid in its way.
    fn jump_out_of_fluid<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, old_y: f64) {
        if not self.body.horizontal_collision {
            return
        }
        let up = self.body.vy + f64(0.6f32) - self.body.y + old_y
        let b = moved(self.body.bounding_box(), self.body.vx, up, self.body.vz)
        if m.colliders(f, blocks, b, self.body.mover()).is_empty() and not any_liquid(f, blocks, b) {
            self.body.vy = f64(0.3f32)
        }
    }

    // `getFrictionInfluencedSpeed`: on the ground, as fast as it walks, faster on what's more
    // slippery than 0.6, the less it grips; in the air, 0.02.
    fn friction_speed(self, friction: f32) -> f32 {
        if not self.body.on_ground {
            return 0.02f32
        }
        if f64(friction) > 0.6 {
            return self.speed * (0.21600002f32 / (friction * friction * friction))
        }
        return self.speed
    }

    // `moveRelative`: what it's told to walk, as long as 1 at most, at `speed`, turned as it's
    // turned, added to its motion.
    pub fn move_relative(mut self, speed: f32) {
        let (ix, iy, iz) = (f64(self.xxa), f64(self.yya), f64(self.zza))
        self.move_relative_by(speed, ix, iy, iz)
    }

    // `moveRelative` of the input `ix`, `iy`, `iz`.
    fn move_relative_by(mut self, speed: f32, ix: f64, iy: f64, iz: f64) {
        let length = ix * ix + iy * iy + iz * iz
        var ax = 0.0
        var ay = 0.0
        var az = 0.0
        if not (length < 1.0e-7) {
            var nx = ix
            var ny = iy
            var nz = iz
            if length > 1.0 {
                let d = (ix * ix + iy * iy + iz * iz).sqrt()
                if d < f64(1.0e-5f32) {
                    nx = 0.0
                    ny = 0.0
                    nz = 0.0
                } else {
                    nx = ix / d
                    ny = iy / d
                    nz = iz / d
                }
            }
            let s = f64(speed)
            let mx = nx * s
            let my = ny * s
            let mz = nz * s
            let turn = f64(self.body.y_rot * 0.017453292f32)
            let sin = f64(table_sin(turn))
            let cos = f64(table_cos(turn))
            ax = mx * cos - mz * sin
            ay = my
            az = mz * cos + mx * sin
        }
        self.body.vx = self.body.vx + ax
        self.body.vy = self.body.vy + ay
        self.body.vz = self.body.vz + az
    }

    /// `onClimbable`: whether the block it's in is climbable, or an open trapdoor over a ladder
    /// facing its way, which it then last climbed; never where it flies, as `Player.onClimbable`
    /// has it (D419).
    pub fn on_climbable<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        if self.flies_free {
            // `Phantom.onClimbable` (CAL-200).
            return false
        }
        if self.climber {
            // `Spider.onClimbable`: climbing, its flags' first bit, `isClimbing`.
            return i32(self.data.byte(CLIMBER_FLAGS)) & 1 != 0
        }
        if self.flying {
            return false
        }
        let (bx, by, bz) = self.body.block()
        let climbs = climbable_at(lf, f, blocks, bx, by, bz)
        if climbs {
            self.last_climbable = some((bx, by, bz))
        }
        return climbs
    }

    // `handleOnClimbable`: on what's climbable, its fall forgotten, and no faster than 0.15 a tick
    // across or down, nor down at all where it holds shift, as only a player does, outside
    // scaffolding, `isSuppressingSlidingDownLadder` (D419).
    fn climb_clamp<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) {
        if not self.on_climbable(lf, f, blocks) {
            return
        }
        self.body.reset_fall()
        let most = f64(0.15f32)
        self.body.vx = clamp(self.body.vx, -most, most)
        self.body.vz = clamp(self.body.vz, -most, most)
        if self.body.vy < -most {
            self.body.vy = -most
        }
        let (bx, by, bz) = self.body.block()
        if self.body.vy < 0.0 and self.body.shift and f.block(blocks.collision_state(bx, by, bz) ?? 0) != lf.scaffolding {
            self.body.vy = 0.0
        }
    }

    /// `Entity.move` by dx, dy, dz for itself, or a player's as their client moved them,
    /// `MoverType.PLAYER`, the same: backed off an edge it holds shift at, `backed_off` (D420);
    /// with a living entity's `checkFallDamage` where its own side has the say: its fluids again
    /// out of water, its dust thrown up as it lands, the block's `fallOn`, and its last climbed
    /// block forgotten on the ground; then its bounce, unless a player steers it, not `owned`
    /// (CAL-179), its steps unless it rides something,
    /// `isPassenger` (CAL-179), or is a player flying or crouched on the ground,
    /// `getMovementEmission` (D421), and the block's slowing. One that ignores its falls, a bee,
    /// has none of `checkFallDamage` (CAL-177).
    pub fn move_self<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.body.slow_falling = self.has_effect(SLOW_FALLING)
        let (sx, sy, sz) = self.body.unstuck_move(dx, dy, dz)
        let (bx, bz) = if self.body.no_physics { (sx, sz) } else { self.backed_off(f, m, blocks, sx, sy, sz) }
        let went = self.body.collide_move(f, m, t, blocks, bx, sy, bz) else return
        if self.body.owned {
            self.fall_checks(lf, f, m, t, blocks, went, fast_lava, mut sounds)
        }
        if self.body.removed {
            return
        }
        // Not where a player steers it, whose client moves it, `canSimulateMovement` (CAL-179).
        if self.body.owned or self.body.player {
            self.body.bounce_after(f, m, t, went)
        }
        if self.body.vehicle == none and (not self.body.player or not (self.flying or (self.body.on_ground and self.body.shift))) {
            self.emit(lf, f, t, blocks, went, mut sounds)
        }
        self.body.slow_by_block(f, m, t, blocks)
    }

    // `LivingEntity.checkFallDamage` after a move `went`, but for what ignores its falls: its
    // fluids again out of water, its dust thrown up as it lands, the block's `fallOn`, and its last
    // climbed block forgotten on the ground.
    fn fall_checks<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, went: Moved, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.ignores_falls {
            return
        }
        if not self.body.in_water {
            self.update_fluids(f, t, blocks, fast_lava, mut sounds)
        }
        if self.body.on_ground and self.body.fall > 0.0 {
            // `onChangedBlock` as it lands, which a mob's next coming to tick runs (CAL-218).
            self.landed = true
            self.throw_dust(lf, f, went, sounds.len())
        }
        if let fell = self.body.fall_check(went.my) {
            self.fall_on(lf, f, m, blocks, went.effect_state, went.effect, fell, mut sounds)
        }
        if self.body.on_ground {
            self.last_climbable = none
        }
    }

    /// The end of `handleMoveVehicle` for what a player steers, which their client moved by dx,
    /// dy, dz, on the ground as it says, `ground` (CAL-179): on the ground or not with that
    /// movement, `setOnGroundWithMovement`, then `doCheckFallDamage`, its support found again and
    /// `checkFallDamage` from the block it's on, `getOnPosLegacy`.
    pub fn client_landed<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64, ground: bool, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.body.set_on_ground(f, m, blocks, ground, dx, dz)
        let (ex, ey, ez) = self.body.on_pos(f, t, blocks, 0.2f32)
        let effect = blocks.collision_state(ex, ey, ez) ?? 0
        let went = Moved { mx: dx, my: dy, mz: dz, x_hit: false, z_hit: false, vertically: dy.abs() > 0.0, effect: (ex, ey, ez), effect_state: effect }
        self.fall_checks(lf, f, m, t, blocks, went, fast_lava, mut sounds)
    }

    // `Player.maybeBackOffFromEdge` (D420): holding shift, as only a player does, not flying, not
    // going up and on the ground or no further than a step above it, `isAboveGround`, its move
    // across cut back 0.05 at a time, along x, then z, then both, while it would take it where it
    // could fall a step, `canFallAtLeast`, to none once it's 0.05 or less.
    fn backed_off<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, dx: f64, dy: f64, dz: f64) -> (f64, f64) {
        let step = f64(self.body.step)
        if not self.body.shift or self.flying or dy > 0.0 {
            return (dx, dz)
        }
        let above = self.body.on_ground or (self.body.fall < step and not self.can_fall(f, m, blocks, 0.0, 0.0, step - self.body.fall))
        if not above {
            return (dx, dz)
        }
        let sx = if dx > 0.0 { 0.05 } else if dx < 0.0 { -0.05 } else { 0.0 }
        let sz = if dz > 0.0 { 0.05 } else if dz < 0.0 { -0.05 } else { 0.0 }
        var x = dx
        var z = dz
        while x != 0.0 and self.can_fall(f, m, blocks, x, 0.0, step) {
            if x.abs() <= 0.05 {
                x = 0.0
                break
            }
            x = x - sx
        }
        while z != 0.0 and self.can_fall(f, m, blocks, 0.0, z, step) {
            if z.abs() <= 0.05 {
                z = 0.0
                break
            }
            z = z - sz
        }
        while x != 0.0 and z != 0.0 and self.can_fall(f, m, blocks, x, z, step) {
            x = if x.abs() <= 0.05 { 0.0 } else { x - sx }
            z = if z.abs() <= 0.05 { 0.0 } else { z - sz }
        }
        return (x, z)
    }

    // `canFallAtLeast`: whether its box, moved dx and dz across and a hair smaller, has nothing
    // under it as far down as `height`, `noCollision`.
    fn can_fall<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, dx: f64, dz: f64, height: f64) -> bool {
        let b = self.body.bounding_box()
        let under = Aabb { min_x: b.min_x + 1.0e-7 + dx, min_y: b.min_y - height - 1.0e-7, min_z: b.min_z + 1.0e-7 + dz, max_x: b.max_x - 1.0e-7 + dx, max_y: b.min_y, max_z: b.max_z - 1.0e-7 + dz }
        return m.colliders(f, blocks, under, self.body.mover()).is_empty()
    }

    // The dust in `checkFallDamage`, landing from a fall past its safe distance on what isn't
    // air: more the further it fell, up to 375, from its place, or from the edge of the block it
    // landed on nearest it where that isn't the one it's over.
    fn throw_dust(mut self, lf: LivingFacts, f: Facts, went: Moved, heard: usize) {
        let power = self.fall_power(lf, self.body.fall).floor()
        let p = if power > 0.0 { power } else { 0.0 }
        if not (p > 0.0) or f.is_air(went.effect_state) {
            return
        }
        var x = self.body.x
        let y = self.body.y
        var z = self.body.z
        let (ex, _, ez) = went.effect
        let (bx, _, bz) = self.body.block()
        if ex != bx or ez != bz {
            let x_off = x - f64(ex) - 0.5
            let z_off = z - f64(ez) - 0.5
            let most = if x_off.abs() > z_off.abs() { x_off.abs() } else { z_off.abs() }
            x = f64(ex) + 0.5 + x_off / most * 0.5
            z = f64(ez) + 0.5 + z_off / most * 0.5
        }
        let scaled = f64(0.2f32) + p / 15.0
        let scale = if scaled < 2.5 { scaled } else { 2.5 }
        self.show(Shown.Dust(FallDust { state: went.effect_state, x: x, y: y, z: z, count: i32.saturate(150.0 * scale) }), heard)
    }

    /// Shows `what`, `heard` of its tick's sounds played.
    pub fn show(mut self, what: own Shown, heard: usize) {
        self.shown.push(what)
        self.shown_after.push(heard)
    }

    // `calculateFallPower`: how far past its safe distance it fell.
    fn fall_power(self, lf: LivingFacts, fell: f64) -> f64 {
        return fell + 1.0e-6 - self.attributes.value(lf.safe_fall)
    }

    // The block's `fallOn`, landing on `state` from `fell` up: hay takes a fifth of its hurt;
    // honey slides, event 54, and takes a fifth; slime takes it all; powder snow plays its fall
    // sound past 4; pointed dripstone pointing up hurts more; beds and shelf mushrooms halve the
    // fall; and the rest pass it on, `causeFallDamage`. Farmland, `Shown.Trampled` (CAL-160), and
    // turtle eggs, `Shown.EggFall`, are shown before the fall's hurt, for its level to draw for
    // in their turn (CAL-172).
    fn fall_on<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, state: u32, at: (i32, i32, i32), fell: f64, sounds: mut List<EntitySound>) {
        let block = f.block(state)
        if f.is_a(block, String("HayBlock")) {
            _ = self.fall_damage(lf, f, blocks, fell, 0.2f32, false, mut sounds)
        } else if f.is_a(block, String("HoneyBlock")) {
            self.play(mut sounds, String("block.honey_block.slide"), 1.0f32, 1.0f32)
            self.show(Shown.Event(54i8), sounds.len())
            if self.fall_damage(lf, f, blocks, fell, 0.2f32, false, mut sounds) {
                let (name, volume, pitch) = lf.fall_sound(state)
                self.play(mut sounds, name, volume * 0.5f32, pitch * 0.75f32)
            }
        } else if f.is_a(block, String("SlimeBlock")) {
            _ = self.fall_damage(lf, f, blocks, fell, 0.0f32, false, mut sounds)
        } else if f.is_a(block, String("PowderSnowBlock")) {
            if not (fell < 4.0) {
                let sound = if fell < 7.0 { self.small_fall.copy() } else { self.big_fall.copy() }
                self.play(mut sounds, sound, 1.0f32, 1.0f32)
            }
        } else if f.is_a(block, String("PointedDripstoneBlock")) and (f.get_name(state, String("vertical_direction")) ?? String()) == String("up") and (f.get_name(state, String("thickness")) ?? String()) == String("tip") {
            _ = self.fall_damage(lf, f, blocks, fell + 2.5, 2.0f32, true, mut sounds)
        } else {
            if f.is_a(block, String("FarmlandBlock")) {
                let (ax, ay, az) = at
                let big = self.body.width * self.body.width * self.body.height > 0.512f32
                self.show(Shown.Trampled((fell, ax, ay, az, big)), sounds.len())
            } else if f.is_a(block, String("TurtleEggBlock")) {
                self.show(Shown.EggFall(at), sounds.len())
            }
            let reduced = fell * f64(1.0f32 - m.fall_reduction(block))
            _ = self.fall_damage(lf, f, blocks, reduced, 1.0f32, false, mut sounds)
        }
    }

    // `LivingEntity.causeFallDamage`: below where it was last given an impulse, only the fall
    // from there; how much it's hurt, `calculateFallDamage`, by its fall damage multiplier; and
    // where it's any, its fall sound, small to 4 and big past, and the block's below it,
    // `playBlockFallSound`, then its hurt, a stalagmite's where `stalagmite`, else a fall's, kept
    // for a mob to deal as its move ends, `fall_hurt` (CAL-159). Whether it's hurt.
    fn fall_damage<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, fell: f64, modifier: f32, stalagmite: bool, sounds: mut List<EntitySound>) -> bool {
        if let land = self.horse_land.copy() {
            return self.horse_fall(lf, f, blocks, land, fell, modifier, stalagmite, mut sounds)
        }
        var effective = fell
        if let at = self.impulse_at {
            let (_, iy, _) = at
            let from = iy - self.body.y
            effective = if fell < from { fell } else { from }
            if effective <= 0.0 or self.impulse_grace == 0 {
                self.impulse_grace = 0
                self.impulse_at = none
            }
        }
        let damage = if self.fall_immune { 0 } else { floor(self.fall_power(lf, effective) * f64(modifier) * self.attributes.value(lf.fall_multiplier)) }
        if damage <= 0 {
            return false
        }
        self.impulse_grace = 0
        self.impulse_at = none
        let sound = if damage > 4 { self.big_fall.copy() } else { self.small_fall.copy() }
        self.play(mut sounds, sound, 1.0f32, 1.0f32)
        let below = blocks.collision_state(floor(self.body.x), floor(self.body.y - f64(0.2f32)), floor(self.body.z)) ?? 0
        if not self.silent() and not f.is_air(below) {
            let (name, volume, pitch) = lf.fall_sound(below)
            self.play(mut sounds, name, volume * 0.5f32, pitch * 0.75f32)
        }
        self.fall_hurt = some(FallHurt { stalagmite: stalagmite, amount: f32.nearest(f64(damage)), fell: fell, heard: sounds.len(), shown: self.shown.len() })
        return true
    }

    // `AbstractHorse.causeFallDamage` (CAL-179): past a block, its landing sound, `land`, quiet;
    // then, with no impulse's grace, how much it's hurt, `calculateFallDamage`, and where it's
    // any, its hurt, kept for it to deal as its move ends, and the block's fall sound below it,
    // `playBlockFallSound`, after the hurt's; no fall sound of its own. Its riders' share of the
    // fall, `propagateFallToPassengers`, waits. Whether it's hurt.
    fn horse_fall<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, land: String, fell: f64, modifier: f32, stalagmite: bool, sounds: mut List<EntitySound>) -> bool {
        if fell > 1.0 {
            self.play(mut sounds, land.copy(), 0.4f32, 1.0f32)
        }
        let damage = if self.fall_immune { 0 } else { floor(self.fall_power(lf, fell) * f64(modifier) * self.attributes.value(lf.fall_multiplier)) }
        if damage <= 0 {
            return false
        }
        self.fall_hurt = some(FallHurt { stalagmite: stalagmite, amount: f32.nearest(f64(damage)), heard: sounds.len(), shown: self.shown.len() })
        let below = blocks.collision_state(floor(self.body.x), floor(self.body.y - f64(0.2f32)), floor(self.body.z)) ?? 0
        if not self.silent() and not f.is_air(below) {
            let (name, volume, pitch) = lf.fall_sound(below)
            self.play(mut sounds, name, volume * 0.5f32, pitch * 0.75f32)
        }
        return true
    }

    // `applyMovementEmissionAndPlaySound`: how far it's gone, up and down too on what's climbable;
    // past its next step on what isn't air, the step sound of the block it's on, and of the one it
    // stands on where that's another and it's on the ground or climbing; else, in water, a swim.
    fn emit<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, went: Moved, sounds: mut List<EntitySound>) {
        let length = (went.mx * went.mx + went.my * went.my + went.mz * went.mz).sqrt()
        let across = (went.mx * went.mx + went.mz * went.mz).sqrt()
        let gone = f32.nearest(length * f64(0.6f32))
        let gone_across = f32.nearest(across * f64(0.6f32))
        let (sx, sy, sz) = self.body.on_pos(f, t, blocks, 1.0e-5f32)
        let standing = blocks.collision_state(sx, sy, sz) ?? 0
        let climbing = lf.climbable_state(f, standing)
        self.move_dist = self.move_dist + (if climbing { gone } else { gone_across })
        self.fly_dist = self.fly_dist + gone
        if not (self.move_dist > self.next_step) or f.is_air(standing) {
            // Over air, its wings, `processFlappingMovement`, a parrot's heard (CAL-201).
            if f.is_air(standing) and self.flaps and self.fly_dist > self.next_flap {
                self.play(mut sounds, String("entity.parrot.fly"), 0.15f32, 1.0f32)
                self.next_flap = self.fly_dist + self.flap_speed / 2.0f32
            }
            return
        }
        let same = (sx, sy, sz) == went.effect
        let heard = self.emits_sounds
        var stepped = self.step_on(lf, f, blocks, went.effect, went.effect_state, heard, went.my, mut sounds)
        if not same {
            stepped = self.step_on(lf, f, blocks, (sx, sy, sz), standing, false, went.my, mut sounds) or stepped
        }
        if stepped {
            self.next_step = self.step_on_from()
        } else if self.body.in_water {
            self.next_step = self.step_on_from()
            if self.emits_sounds {
                self.swim_sound(mut sounds)
            }
        }
    }

    // `nextStep`: the next whole of how far it's gone, or 0.15 on for a turtle (CAL-201).
    fn step_on_from(self) -> f32 {
        if self.short_steps {
            return self.move_dist + 0.15f32
        }
        return f32.nearest(f64(i32.saturate(f64(self.move_dist)) + 1))
    }

    // `waterSwimSound`: its swim, as loud as it moves, mostly up and down, at 0.35 of that and 1
    // at most, a turtle's half as loud again, `playSwimSound` (CAL-201), its pitch drawn from its
    // random.
    fn swim_sound(mut self, sounds: mut List<EntitySound>) {
        let fast = f32.nearest((self.body.vx * self.body.vx * f64(0.2f32) + self.body.vy * self.body.vy + self.body.vz * self.body.vz * f64(0.2f32)).sqrt()) * 0.35f32
        let volume = (if fast < 1.0f32 { fast } else { 1.0f32 }) * self.swim_loud
        let a = self.body.random.next_float()
        let b = self.body.random.next_float()
        self.play(mut sounds, self.swim.copy(), volume, 1.0f32 + (a - b) * 0.4f32)
    }

    // `vibrationAndSoundEffectsFromBlock` on `state` at `pos`: on the ground, climbing it or
    // crouched and not going up or down, `my`, (D421), and not swimming (D444), its step sound
    // where it's `heard`, a player's as `player_step` has it, and an amethyst chime; whether it
    // stepped. The steps' game events come with vibrations.
    fn step_on<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, pos: (i32, i32, i32), state: u32, heard: bool, my: f64, sounds: mut List<EntitySound>) -> bool {
        if f.is_air(state) {
            return false
        }
        if not (self.body.on_ground or lf.climbable_state(f, state) or (self.crouching and my == 0.0)) or self.swimming {
            return false
        }
        if heard {
            if self.steps_unheard {
                // A bee's steps, `Bee.playStepSound`, sound nothing (CAL-177).
            } else if self.body.player {
                self.player_step(lf, f, blocks, pos, state, mut sounds)
            } else if self.step_by_block and self.own_step != none {
                if not f.is_liquid(state) {
                    // Snow above the block it's on, its sound the snow's, `AbstractHorse.playStepSound`
                    // (CAL-176).
                    let (px, py, pz) = pos
                    var sounding = state
                    if let above = blocks.collision_state(px, py + 1, pz) {
                        if f.block_named(String("minecraft:snow")) == some(f.block(above)) {
                            sounding = above
                        }
                    }
                    let (name, volume, pitch) = lf.step_sound(sounding)
                    if self.gallops and not self.body.passengers.is_empty() {
                        // Ridden, and one that gallops, `isVehicle() && canGallop` (D710).
                        self.gallop += 1
                        if self.gallop > 5 and self.gallop % 3 == 0 {
                            self.play(mut sounds, String("entity.horse.gallop"), volume * 0.15f32, pitch)
                            // A horse's breath, 1 in 10, drawn (CAL-179).
                            if let breath = self.breath.copy() {
                                if self.body.random.next_int_below(10) == 0 {
                                    self.play(mut sounds, breath, volume * 0.6f32, pitch)
                                }
                            }
                        } else if self.gallop <= 5 {
                            self.play(mut sounds, String("entity.horse.step_wood"), volume * 0.15f32, pitch)
                        }
                    } else {
                        let mine = self.own_step.copy() ?? String()
                        let stepped = if wood_step(name) { String("entity.horse.step_wood") } else { mine }
                        self.play(mut sounds, stepped, volume * 0.15f32, pitch)
                    }
                }
            } else if let stepped = self.own_step {
                self.play(mut sounds, stepped.copy(), self.own_step_volume, 1.0f32)
            } else {
                let (name, volume, pitch) = lf.step_sound(state)
                self.play(mut sounds, name, volume * 0.15f32, pitch)
            }
            if f.in_set(state, lf.crystal) and self.body.tick_count >= self.chimed_at + 20 {
                self.chime = self.chime * f32.nearest(pow(0.997, f64(self.body.tick_count - self.chimed_at)))
                self.chime = (self.chime + 0.07f32).min(1.0f32)
                let pitch_drawn = 0.5f32 + self.chime * self.body.random.next_float() * 1.2f32
                let loud = 0.1f32 + self.chime * 1.2f32
                self.play(mut sounds, String("block.amethyst_block.chime"), loud, pitch_drawn)
                self.chimed_at = self.body.tick_count
            }
        }
        return true
    }

    // `Player.playStepSound` on `state` at `pos` (D421): in water, a swim and the block's step
    // muffled, `playMuffledStepSound`; else the step of the block over it where that's stepped
    // inside, `getPrimaryStepSoundBlockPos`, as snow, or with it, as a carpet,
    // `playCombinationStepSounds`, the block's own muffled after it; else the block's own.
    fn player_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, pos: (i32, i32, i32), state: u32, sounds: mut List<EntitySound>) {
        if self.body.in_water {
            self.swim_sound(mut sounds)
            self.muffled_step(lf, state, mut sounds)
            return
        }
        let (x, y, z) = pos
        let above = blocks.collision_state(x, y + 1, z) ?? 0
        let combined = f.in_set(above, lf.combination_step)
        let primary = if combined or f.in_set(above, lf.inside_step) { above } else { state }
        let (name, volume, pitch) = lf.step_sound(primary)
        self.play(mut sounds, name, volume * 0.15f32, pitch)
        if combined {
            self.muffled_step(lf, state, mut sounds)
        }
    }

    // `playMuffledStepSound`: the step of `state`, a third as loud as a step and 0.8 as high.
    fn muffled_step(self, lf: LivingFacts, state: u32, sounds: mut List<EntitySound>) {
        let (name, volume, pitch) = lf.step_sound(state)
        self.play(mut sounds, name, volume * 0.05f32, pitch * 0.8f32)
    }

    /// The end of `LivingEntity.tick`, after its head's turned: each old turn kept within half a
    /// turn of the new, and its impulse's grace time counted down.
    pub fn tick_end(mut self) {
        while self.body.y_rot - self.y_rot_o < -180.0f32 {
            self.y_rot_o = self.y_rot_o - 360.0f32
        }
        while self.body.y_rot - self.y_rot_o >= 180.0f32 {
            self.y_rot_o = self.y_rot_o + 360.0f32
        }
        while self.y_body_rot - self.y_body_rot_o < -180.0f32 {
            self.y_body_rot_o = self.y_body_rot_o - 360.0f32
        }
        while self.y_body_rot - self.y_body_rot_o >= 180.0f32 {
            self.y_body_rot_o = self.y_body_rot_o + 360.0f32
        }
        while self.body.x_rot - self.x_rot_o < -180.0f32 {
            self.x_rot_o = self.x_rot_o - 360.0f32
        }
        while self.body.x_rot - self.x_rot_o >= 180.0f32 {
            self.x_rot_o = self.x_rot_o + 360.0f32
        }
        while self.y_head_rot - self.y_head_rot_o < -180.0f32 {
            self.y_head_rot_o = self.y_head_rot_o - 360.0f32
        }
        while self.y_head_rot - self.y_head_rot_o >= 180.0f32 {
            self.y_head_rot_o = self.y_head_rot_o + 360.0f32
        }
        if self.impulse_grace > 0 {
            self.impulse_grace -= 1
        }
    }

    /// `LivingEntity.tick`'s look at the arrows in it (CAL-159): with any, one goes once it's had
    /// 20 ticks for each it has fewer than 30, `removeArrowTime`.
    pub fn arrows_tick(mut self) {
        let count = self.data.number(ARROW_COUNT)
        if count <= 0 {
            return
        }
        if self.remove_arrow_time <= 0 {
            self.remove_arrow_time = 20 * (30 - count)
        }
        self.remove_arrow_time -= 1
        if self.remove_arrow_time <= 0 {
            self.data.set(ARROW_COUNT, Value.Number(count - 1))
        }
    }

    /// An arrow more in it, `setArrowCount(getArrowCount() + 1)`, as one that doesn't pierce hurts
    /// it (CAL-159).
    pub fn arrow_in(mut self) {
        let count = self.data.number(ARROW_COUNT)
        self.data.set(ARROW_COUNT, Value.Number(count + 1))
    }

    /// Whether it's using what it holds, `isUsingItem`, its living flags' first bit (CAL-159).
    pub fn using_item(self) -> bool {
        return i32(self.data.byte(LIVING_FLAGS)) & 1 > 0
    }

    // The hand it uses with, `getUsedItemHand`: the off hand where the flags' second bit's on.
    pub fn used_hand(self) -> usize {
        return if i32(self.data.byte(LIVING_FLAGS)) & 2 > 0 { 1 } else { 0 }
    }

    /// `startUsingItem` with the hand `hand`, 0 its main and 1 its off (CAL-159): where it holds
    /// something there and uses nothing, it uses it for its use's ticks, a bow's or a spear's
    /// 72000, those who see it sent the stack, `updatePlayersWithNewEquipment`, and its flags set,
    /// the hand among them. The game event it makes comes with game events.
    pub fn start_using(mut self, hand: usize, heard: usize) {
        let stack = self.equipment[hand].copy() else return
        if self.using_item() {
            return
        }
        self.use_remaining = if self.use_kinetic != none { 72000 } else { use_duration(stack) }
        self.use_item = some(stack.copy())
        var sent = List<(usize, Tag?)>()
        sent.push((hand, some(stack)))
        self.show(Shown.Worn(sent), heard)
        self.data.set_flag(LIVING_FLAGS, 1, true)
        self.data.set_flag(LIVING_FLAGS, 2, hand == 1)
    }

    /// `startUsingItem` of the spear `k` in the hand `hand` (CAL-159): as `start_using`, where it
    /// uses nothing and holds something there, with no entities hit yet,
    /// `recentKineticEnemies`.
    pub fn start_using_kinetic(mut self, hand: usize, k: Kinetic, heard: usize) {
        if self.using_item() or self.equipment[hand] == none {
            return
        }
        self.use_kinetic = some(k)
        self.start_using(hand, heard)
        self.recent_stabs = some(List<(i32, i64)>())
    }

    /// `updatingUsingItem`, as its tick has it after `Entity.tick` (CAL-159): while it uses what it
    /// holds, the same item still in that hand, its use's ticks counted down, `updateUsingItem`,
    /// which says how many were left as its use ticked, `onUseTick`; else it stops using it, and
    /// none. A bow's or a spear's use is let go before its 72000 ticks run out.
    pub fn updating_using(mut self) -> i32? {
        if not self.using_item() {
            return none
        }
        let held = self.equipment[self.used_hand()].copy()
        if held_item(held) == held_item(self.use_item) and held != none {
            self.use_item = held
            let left = self.use_remaining
            self.use_remaining -= 1
            return some(left)
        }
        self.stop_using()
        return none
    }

    /// `stopUsingItem` (CAL-159): its flag of using off, and nothing used, nor entities kept as
    /// hit by a spear.
    pub fn stop_using(mut self) {
        self.data.set_flag(LIVING_FLAGS, 1, false)
        self.use_item = none
        self.use_remaining = 0
        self.use_kinetic = none
        self.recent_stabs = none
    }

    /// `wasRecentlyStabbed` of the entity `id` at the game time `now` within `cooldown` ticks,
    /// then `rememberStabbedEntity`, where its use keeps them, as `damageEntities` has it
    /// (CAL-159): whether it was hit too lately to be hit again; where it wasn't, it's kept as hit
    /// now.
    pub fn stabbed_lately(mut self, id: i32, now: i64, cooldown: i32) -> bool {
        return stabbed_lately_in(mut self.recent_stabs, id, now, cooldown)
    }

    /// `getTicksUsingItem` (CAL-159): how long it's used what it uses, 0 where it uses nothing.
    pub fn ticks_using(self) -> i32 {
        if not self.using_item() {
            return 0
        }
        let using = self.use_item.copy() else return 0
        return use_duration(using) - self.use_remaining
    }

    /// What `Entity.load` and `LivingEntity.readAdditionalSaveData` read of `tag` into it: what
    /// every entity reads, `world.body`'s, then into its values its air, name's showing, silence,
    /// gravity, glowing and frozen ticks; its absorption, attributes, health within its most, hurt
    /// and death times, fall flying, and its impulse's grace and place; and what it keeps as it
    /// was. False where it's somewhere that isn't a number, logged in `lines`.
    pub fn load_from(mut self, lf: LivingFacts, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        // Its most where it has none, `getMaxAirSupply`, a dolphin's 4800 (CAL-201).
        let fullest = self.max_air
        self.set_air(int_or(tag, "Air", fullest))
        // Its custom name, `setCustomName`, its saved text component as it is (D441).
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        } else {
            self.data.set(CUSTOM_NAME, Value.Empty)
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.invulnerable_time = int_or(tag, "invulnerable_time", 0)
        _ = self.body.extras.remove("invulnerable_time")
        _ = self.body.extras.remove("TicksFrozen")
        self.absorption = float_or(tag, "AbsorptionAmount", 0.0f32)
        if tag.contains("attributes") {
            self.attributes.apply(tag["attributes"].copy())
        }
        let most = self.max_health(lf)
        self.set_health(lf, float_or(tag, "Health", most))
        self.hurt_time = i32(short_or(tag, "HurtTime", 0i16))
        self.death_time = i32(short_or(tag, "DeathTime", 0i16))
        self.data.set_flag(SHARED_FLAGS, FALL_FLYING_FLAG, bool_or(tag, "FallFlying"))
        self.impulse_grace = int_or(tag, "current_impulse_context_reset_grace_time", 0)
        self.impulse_at = vec3_of(tag, "current_explosion_impact_pos")
        // Where it sleeps, `BlockPos.CODEC`, and its pose then sleeping (CAL-160).
        if tag.contains("sleeping_pos") {
            if let Tag.IntArray(at) = tag["sleeping_pos"] {
                if at.len() == 3 {
                    self.set_sleeping(some((at[0], at[1], at[2])))
                    self.data.set(POSE_ID, Value.Number(SLEEPING))
                }
            }
        }
        // Its effects, `MobEffectInstance.CODEC`'s list, none where one doesn't read, one of a kind
        // in place of an earlier, as a map puts it, to be shown (CAL-163).
        // Onto an entity as it is, its effects cleared first, dirty only where it reads some
        // (D823).
        self.effects = if tag.contains("active_effects") { read_effects(tag["active_effects"]) } else { List<ActiveEffect>() }
        if not self.effects.is_empty() {
            self.effects_dirty = true
        }
        if tag.contains("locator_bar_icon") {
            self.kept.insert(String("locator_bar_icon"), tag["locator_bar_icon"].copy())
        } else {
            _ = self.kept.remove("locator_bar_icon")
        }
        // Who last hurt it (D416), each by UUID, as `EntityReference.read` reads it.
        self.hurt_by_player = uuid_of(tag, "last_hurt_by_player")
        self.hurt_by_player_memory = int_or(tag, "last_hurt_by_player_memory_time", 0)
        self.hurt_by_mob = uuid_of(tag, "last_hurt_by_mob")
        self.hurt_by_mob_stamp = self.body.tick_count - int_or(tag, "ticks_since_last_hurt_by_mob", 0)
        // All its equipment set, `setAll`, empty where the tag hasn't it (D823).
        let names = slot_names()
        for slot in 0..names.len() {
            self.equipment[slot] = none
        }
        if tag.contains("equipment") {
            if let Tag.Compound(worn) = tag["equipment"] {
                for slot in 0..names.len() {
                    if worn.contains(names[slot].copy()) {
                        self.equipment[slot] = some(worn[names[slot].copy()].copy())
                    }
                }
            }
        }
        self.y_rot_o = self.body.y_rot
        self.x_rot_o = self.body.x_rot
        self.refresh_body(lf)
        return true
    }

    /// What `saveAsPassenger` saves of it before its type's own, as `kind`: what every entity
    /// saves, `world.body`'s, its air and frozen ticks from its values; then
    /// `LivingEntity.addAdditionalSaveData`'s, in the order vanilla puts them, its health, hurt and
    /// death times, absorption, impulse, attributes, fall flying and an empty brain, with what it
    /// keeps where vanilla puts it.
    pub fn save_into(self, t: mut JavaHashMap<String, Tag>, kind: str) {
        var body = self.body.copy()
        body.air = self.air()
        if self.invulnerable_time > 0 {
            body.extras.insert(String("invulnerable_time"), Tag.Int(self.invulnerable_time))
        }
        let frozen = self.data.number(TICKS_FROZEN)
        if frozen > 0 {
            body.extras.insert(String("TicksFrozen"), Tag.Int(frozen))
        }
        body.save_into(mut t, kind)
        t.insert(String("Health"), Tag.Float(self.health()))
        t.insert(String("HurtTime"), Tag.Short(i16.wrap(self.hurt_time)))
        t.insert(String("DeathTime"), Tag.Short(i16.wrap(self.death_time)))
        t.insert(String("AbsorptionAmount"), Tag.Float(self.absorption))
        t.insert(String("current_impulse_context_reset_grace_time"), Tag.Int(self.impulse_grace))
        if let at = self.impulse_at {
            let (x, y, z) = at
            t.insert(String("current_explosion_impact_pos"), Tag.List([Tag.Double(x), Tag.Double(y), Tag.Double(z)]))
        }
        t.insert(String("attributes"), self.attributes.pack())
        if not self.effects.is_empty() {
            let names = effect_names()
            var saved = List<Tag>()
            for e in self.effects {
                saved.push(e.saved(names))
            }
            t.insert(String("active_effects"), Tag.List(saved))
        }
        t.insert(String("FallFlying"), flag(i32(self.data.byte(SHARED_FLAGS)) & FALL_FLYING_FLAG != 0))
        if let at = self.sleeping {
            let (x, y, z) = at
            t.insert(String("sleeping_pos"), Tag.IntArray([x, y, z]))
        }
        var brain = JavaHashMap<String, Tag>()
        brain.insert(String("memories"), Tag.Compound(JavaHashMap<String, Tag>()))
        t.insert(String("Brain"), Tag.Compound(brain))
        if let who = self.hurt_by_player {
            t.insert(String("last_hurt_by_player"), uuid_tag(who))
            t.insert(String("last_hurt_by_player_memory_time"), Tag.Int(self.hurt_by_player_memory))
        }
        if let who = self.hurt_by_mob {
            t.insert(String("last_hurt_by_mob"), uuid_tag(who))
            t.insert(String("ticks_since_last_hurt_by_mob"), Tag.Int(self.body.tick_count - self.hurt_by_mob_stamp))
        }
        let names = slot_names()
        var worn = JavaHashMap<String, Tag>()
        for slot in 0..names.len() {
            if let stack = self.equipment[slot] {
                worn.insert(names[slot].copy(), stack.copy())
            }
        }
        if not worn.is_empty() {
            t.insert(String("equipment"), Tag.Compound(worn))
        }
        self.put_kept(mut t, "locator_bar_icon")
    }

    fn put_kept(self, t: mut JavaHashMap<String, Tag>, key: str) {
        if self.kept.contains(key) {
            t.insert(String(key), self.kept[key].copy())
        }
    }
}

impl LivingFacts {
    // The state's sound type's step sound, with its volume and pitch.
    fn step_sound(self, state: u32) -> (String, f32, f32) {
        let at = usize(self.state_sounds[usize(state)])
        return (self.step_names[at].copy(), self.volumes[at], self.pitches[at])
    }

    /// A state's fall sound, with its volume and pitch, which a player's falls play too (D418).
    pub fn fall_sound(self, state: u32) -> (String, f32, f32) {
        let at = usize(self.state_sounds[usize(state)])
        return (self.fall_names[at].copy(), self.volumes[at], self.pitches[at])
    }
}

/// An armor stand, as vanilla's `ArmorStand` makes, runs and saves it: a living entity 0.5 across
/// and 1.975 high, its eyes 1.7775 up; half that, its eyes 0.9875 up, where it's small; and no size
/// where it's a marker. It breathes under water, its falls sound as an armor stand's, and it has
/// physics, so moves, only where it's neither a marker nor without gravity. Its body turns as it's
/// turned, `tickHeadTurn`, and its head with them as it's loaded. Its flags, whether it's small,
/// shows its arms, hides its base plate or is a marker, and its six poses are its values.
/// Who's behind a damage to an armor stand, as `ArmorStand.hurtServer` reads it (D441): a mob,
/// where mob griefing's off, which it ignores; and a player who mayn't build, `mayBuild`, who can't
/// break it.
pub struct StandHurter {
    pub mob_without_griefing: bool = false
    pub player_without_building: bool = false
}

/// What an armor stand's hurt did, `ArmorStand.hurt` (D441): whether it was hurt, as
/// `hurtServer` answers, which a player's attack goes on by; whether it was hit and shaken,
/// entity event 32; and its breaking, where it broke.
pub struct StandHurt {
    pub hurt: bool = false
    pub hit: bool = false
    pub broken: StandBreak? = none
}

/// What's left for its level to do of an armor stand's breaking (D441), it taken out already,
/// `kill`: where it was, its block `blockPosition`, and its size; whether it drops itself, an
/// armor stand item named as it was, `name`, as a player's breaking has it, `brokenByPlayer`;
/// whether it drops its loot, where it isn't small, and what it wore, `brokenByAnything`; and
/// whether its particles are shown, `showBreakingParticles`. Its sound always plays,
/// `playBrokenSound`.
pub struct StandBreak {
    pub x: f64
    pub y: f64
    pub z: f64
    pub width: f32
    pub height: f32
    pub itself: bool = false
    pub name: Tag? = none
    pub drops: bool = false
    pub small: bool = false
    pub equipment: List<Tag?> = List<Tag?>()
    pub particles: bool = false
}

pub struct ArmorStand {
    pub living: Living
    /// Whether it's invisible, as it was set, and the slots that can't be taken from or put in,
    /// `disabledSlots`, kept for its save.
    pub invisible: bool = false
    pub disabled_slots: i32 = 0
    /// The game time it was last hit, `lastHit`, which isn't saved (D441).
    pub last_hit: i64 = 0i64
}

impl ArmorStand {
    /// One at x, y, z, of the type `kind`, with its own random seeded `seed`, as vanilla's
    /// constructor makes it.
    pub fn new(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> ArmorStand {
        var l = Living.made(lf, kind, id, seed, x, y, z, 0.5f32, 1.975f32, 1.7775f32, armor_stand_data())
        l.stand = true
        l.breathes_water = true
        l.small_fall = String("entity.armor_stand.fall")
        l.big_fall = String("entity.armor_stand.fall")
        return ArmorStand { living: l }
    }

    /// The one `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `load` reads it in: what every living entity reads, `Living.load_from`; its
    /// head and body turned as it's turned; then whether it's invisible, small, shows its arms,
    /// hides its base plate or is a marker, its disabled slots, its physics, and its poses where
    /// they read, each `Rotations`' three floats, a turn at most, an angle that isn't finite none.
    /// None where it doesn't load, logged in `lines`.
    pub fn loaded(lf: LivingFacts, kind: u32, id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> ArmorStand? {
        var a = ArmorStand.new(lf, kind, id, seed, 0.0, 0.0, 0.0)
        if not a.load_onto(lf, tag, mut lines) {
            return none
        }
        return some(a)
    }

    /// `Entity.load` onto it as it is, as `data` changes an entity's data (D823), and as `loaded`
    /// reads a fresh one. False where it doesn't load, logged in `lines`.
    pub fn load_onto(mut self, lf: LivingFacts, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.living.load_from(lf, tag, mut lines) {
            return false
        }
        let turn = self.living.body.y_rot
        self.living.y_rot_o = turn
        self.living.y_head_rot = turn
        self.living.y_head_rot_o = turn
        self.living.y_body_rot_o = turn
        self.invisible = bool_or(tag, "Invisible")
        self.living.data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, self.invisible)
        self.set_flag(SMALL_FLAG, bool_or(tag, "Small"))
        self.set_flag(ARMS_FLAG, bool_or(tag, "ShowArms"))
        self.disabled_slots = int_or(tag, "DisabledSlots", 0)
        self.set_flag(NO_BASE_PLATE_FLAG, bool_or(tag, "NoBasePlate"))
        self.set_flag(MARKER_FLAG, bool_or(tag, "Marker"))
        self.living.body.no_physics = not self.has_physics()
        if tag.contains("Pose") {
            if let poses = read_poses(tag["Pose"]) {
                let ids: List<usize> = [HEAD_POSE, BODY_POSE, LEFT_ARM_POSE, RIGHT_ARM_POSE, LEFT_LEG_POSE, RIGHT_LEG_POSE]
                for i in 0..ids.len() {
                    let (x, y, z) = poses[i]
                    self.living.data.set(ids[i], Value.Rotations(x, y, z))
                }
            }
        }
        return true
    }

    /// Its flags, `DATA_CLIENT_FLAGS`.
    pub fn flags(self) -> i32 {
        return i32(self.living.data.byte(STAND_FLAGS))
    }

    /// Whether it's a marker, `isMarker`, and small, `isSmall`.
    pub fn marker(self) -> bool {
        return self.flags() & MARKER_FLAG != 0
    }

    pub fn small(self) -> bool {
        return self.flags() & SMALL_FLAG != 0
    }

    /// `hasPhysics`: neither a marker nor without gravity.
    pub fn has_physics(self) -> bool {
        return not self.marker() and not self.living.data.flag(NO_GRAVITY)
    }

    // A flag set or cleared, and its size made again where that changed it, as
    // `onSyncedDataUpdated` refreshes its dimensions, where it is.
    fn set_flag(mut self, bit: i32, on: bool) {
        self.living.data.set_flag(STAND_FLAGS, bit, on)
        if self.marker() {
            self.living.body.width = 0.0f32
            self.living.body.height = 0.0f32
            self.living.body.eyes = 0.0f32
        } else if self.small() {
            self.living.body.width = 0.5f32 * 0.5f32
            self.living.body.height = 1.975f32 * 0.5f32
            self.living.body.eyes = 0.9875f32
        } else {
            self.living.body.width = 0.5f32
            self.living.body.height = 1.975f32
            self.living.body.eyes = 1.7775f32
        }
    }

    /// What it is to loot's predicates (D441): an armor stand, on fire or not, a baby where it's
    /// small, `isBaby`, holding what's in its main hand.
    pub fn loot_entity(self) -> LootEntity {
        return LootEntity { kind: String("minecraft:armor_stand"), on_fire: self.living.body.fire > 0 or self.living.body.extras.contains("HasVisualFire"), baby: self.small(), hand: self.living.equipment[0].copy() }
    }

    /// `hurtServer` of the damage `d` of `types` at the game time `now` (D441), `by` who's behind
    /// it, `immune` where what it wears makes it immune, `isImmuneToDamage`; how much is never
    /// read. Nothing where it's gone, or a mob's behind it with mob griefing off; killed, taken
    /// out with nothing dropped, by what bypasses invulnerability; nothing where it's invulnerable
    /// to it, `isInvulnerableTo`, invisible or a marker; broken by an explosion,
    /// `brokenByAnything`. What ignites armor stands lights it for 5 seconds, or where it's on fire
    /// wears it down 0.15, `causeDamage`; what burns armor stands wears it down 4 while it has more
    /// than half a point left. Else only what can break it or always kills it does anything, and
    /// not where a player who mayn't build is behind it: a creative player breaks it at once,
    /// nothing dropped but its sound and particles shown; a hit more than 5 ticks after its last,
    /// of what doesn't always kill it, shakes it, entity event 32, its time kept; and else it's
    /// broken as a player breaks it, `brokenByPlayer`, itself dropped first, its particles
    /// after. None of those hits takes its health.
    pub fn hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, now: i64, by: StandHurter, immune: bool) -> StandHurt {
        if self.living.body.removed or by.mob_without_griefing {
            return StandHurt()
        }
        if types.is(d.kind, BYPASSES_INVULNERABILITY) {
            self.living.body.removed = true
            return StandHurt()
        }
        if self.living.invulnerable_to(types, d, self.living.fire_immune, immune) or self.invisible or self.marker() {
            return StandHurt()
        }
        if types.is(d.kind, IS_EXPLOSION) {
            return StandHurt { broken: some(self.broken(false, true, false)) }
        }
        if types.is(d.kind, IGNITES_ARMOR_STANDS) {
            if self.living.on_fire() {
                return StandHurt { broken: self.worn_down(lf, 0.15f32) }
            }
            self.living.ignite_for_ticks(100)
            return StandHurt()
        }
        if types.is(d.kind, BURNS_ARMOR_STANDS) and self.living.health() > 0.5f32 {
            return StandHurt { broken: self.worn_down(lf, 4.0f32) }
        }
        let breaks = types.is(d.kind, CAN_BREAK_ARMOR_STAND)
        let kills = types.is(d.kind, ALWAYS_KILLS_ARMOR_STANDS)
        if (not breaks and not kills) or by.player_without_building {
            return StandHurt()
        }
        if d.creative {
            return StandHurt { hurt: true, broken: some(self.broken(false, false, true)) }
        }
        if now - self.last_hit > 5i64 and not kills {
            self.last_hit = now
            return StandHurt { hurt: true, hit: true }
        }
        return StandHurt { hurt: true, broken: some(self.broken(true, true, true)) }
    }

    // `causeDamage` of `amount` (D441): its health less it, and broken where no more than half a
    // point would be left, `brokenByAnything`.
    fn worn_down(mut self, lf: LivingFacts, amount: f32) -> StandBreak? {
        let health = self.living.health() - amount
        if health <= 0.5f32 {
            return some(self.broken(false, true, false))
        }
        self.living.set_health(lf, health)
        return none
    }

    // Its breaking (D441), `kill` taking it out: what its level's to do of it, itself dropped
    // where `itself`; its loot and what it wears, taken off it, dropped where `drops`; and its
    // particles shown where `particles`.
    fn broken(mut self, itself: bool, drops: bool, particles: bool) -> StandBreak {
        var worn = List<Tag?>()
        if drops {
            for slot in 0..self.living.equipment.len() {
                worn.push(self.living.equipment[slot].take())
            }
        }
        self.living.body.removed = true
        let name: Tag? = if self.living.body.extras.contains("CustomName") { some(self.living.body.extras["CustomName"].copy()) } else { none }
        let b = self.living.body.copy()
        return StandBreak { x: b.x, y: b.y, z: b.z, width: b.width, height: b.height, itself: itself, name: name, drops: drops, small: self.small(), equipment: worn, particles: particles }
    }

    // A hurt of its own of the type named `name`, `heard` of its tick's sounds played (D441): what
    // it wears tested against it among `blocks`, as a mob's is, then `hurt`, its breaking shown
    // for its level to do. What hurts it of its own is never what breaks or kills armor stands,
    // whose hits alone read the time, so none's given.
    fn hurt_own<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, name: str, heard: usize) {
        let d = Damage.of(lf.damage, name)
        var missing = List<String>()
        let ward = self.living.ward(blocks, items, lf.damage, d, self.loot_entity(), none, mut missing)
        for m in missing {
            self.living.show(Shown.Missing(m.copy()), heard)
        }
        let h = self.hurt(lf, lf.damage, d, 0i64, StandHurter(), ward.immune)
        if let b = h.broken {
            self.living.show(Shown.StandBroken(b.copy()), heard)
        }
    }

    // What it's inside and what that does to it, as `applyEffectsFromBlocks` goes on after
    // `stepOn` (D434): where blocks act on it, the blocks it went into along its moves this tick,
    // while it's alive, a campfire's and a cactus's hurts its own, `hurt_own`, and its fluid's;
    // then the effects they put on it in their order, fire's and lava's hurts its own, lava's
    // sound never heard, as no armor stand's hurt by lava (D441); then the rain, and its fire's
    // end, `after_inside`.
    fn inside<B: CollisionBlocks + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let moves = self.living.final_moves()
        if self.living.body.removed or self.living.body.no_physics {
            return
        }
        let was = self.living.fire_before()
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.living.body.width, self.living.body.height, self.living.body.fall) {
            if not self.living.alive() {
                break
            }
            if i.block {
                c.advance(i.step)
                match self.living.touch(f, i, mut c) {
                    Touched.Campfire(_) => self.hurt_own(lf, blocks, items, "campfire", sounds.len()),
                    Touched.Cactus => self.hurt_own(lf, blocks, items, "cactus", sounds.len()),
                    Touched.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                    Touched.Plate(at) => self.living.show(Shown.Plate((at, (0, 0))), sounds.len()),
                    Touched.Tripwire(at) => {
                        // Not a marker's, which ignores block triggers (D702).
                        if not self.marker() {
                            self.living.show(Shown.Tripwire(at), sounds.len())
                        }
                    },
                    Touched.Dripleaf(at) => self.living.show(Shown.Dripleaf(at), sounds.len()),
                    Touched.Rail(at) => self.living.show(Shown.Rail(at), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.living.body.inside_portal(px, py, pz, PORTAL_DELAY, false),
                    Touched.EndPortal((px, py, pz)) => self.living.body.inside_portal(px, py, pz, PORTAL_DELAY, true),
                    Touched.Gateway(g) => {
                        // Gone into where it may go through it, `canUsePortal`, and the
                        // gateway's open, its cooldown then begun by its level (D594).
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if self.living.alive() and blocks.gateway_open(gx, gy, gz) {
                            self.living.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.living.show(Shown.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    Touched.Web => self.living.web(),
                    Touched.Berry(age) => {
                        self.living.berry_bush()
                        if age != 0 and self.living.body.moved_across() {
                            self.hurt_own(lf, blocks, items, "sweet_berry_bush", sounds.len())
                        }
                    },
                    // An armor stand takes no effects, `isAffectedByPotions` (D697).
                    Touched.WitherRose => {},
                    Touched.Honey((hx, hy, hz)) => self.living.honey(hx, hy, hz, sounds.len()),
                    Touched.Bubble((drag, at)) => self.living.bubble(f, blocks, drag, at, sounds.len()),
                    Touched.PowderSnow((_, sy, _)) => {
                        if self.living.in_snow(lf, f, blocks) {
                            let at = (self.living.body.x, f64(sy + 1), self.living.body.z)
                            self.living.show(Shown.Snow((at, none)), sounds.len())
                        }
                    },
                    Touched.Nothing => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if not self.living.alive() {
                break
            }
            match e {
                BlockEffect.Apply(kind) => self.living.apply_effect(kind, 0),
                BlockEffect.InFire(_) => self.hurt_own(lf, blocks, items, "in_fire", sounds.len()),
                BlockEffect.LavaHurt => {
                    if not self.living.fire_immune {
                        self.hurt_own(lf, blocks, items, "lava", sounds.len())
                    }
                },
                BlockEffect.Doused(at) => {
                    if self.living.on_fire() {
                        self.living.show(Shown.Doused(at), sounds.len())
                    }
                },
                BlockEffect.Melted(at) => {
                    if self.living.on_fire() {
                        self.living.show(Shown.Melted(at), sounds.len())
                    }
                },
            }
        }
        let rained = self.living.body.in_rain(blocks)
        self.living.after_inside(was, rained, mut sounds)
    }

    /// Its tick, as `tickNonPassenger` and `LivingEntity.tick` run it among `blocks`, in a level
    /// whose floor is `min_y`, where lava's fast if `fast_lava`: `baseTick`, its fire's hurt its
    /// own, `hurt_own` (D441); its equipment looked at unless it's gone, as nobody's told of a
    /// broken stand's; `aiStep` unless it's gone, moving only where it has physics, magma's hurt
    /// its own, what it's inside, `inside`, then its freezing; its body turned as it's turned, and
    /// the turns kept near.
    pub fn tick<B: CollisionBlocks + Rain + Warding + Gateways, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        // Its way through the nether portal it's in, what it saves then its level's to take on
        // (D578), or the end gateway, within its level (D594).
        if let p = self.living.entity_tick_portal(lf) {
            if p.gateway {
                if let done = self.living.gateway_goes(p, blocks) {
                    self.living.show(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.living.body.travel(p, saved)
                self.living.show(Shown.Travel(way), sounds.len())
            }
        }
        if self.living.entity_tick_on(f, t, blocks, fast_lava, mut sounds) {
            self.hurt_own(lf, blocks, items, "on_fire", sounds.len())
        }
        self.living.base_tick_end(lf, f, t, blocks, min_y, sounds.len(), players)
        self.living.arrows_tick()
        if not self.living.body.removed {
            self.living.detect_equipment(items, sounds.len())
        }
        if not self.living.body.removed {
            let physics = self.has_physics()
            match self.living.ai_step(lf, f, m, t, blocks, fast_lava, physics, mut sounds) {
                Stepped.Magma => self.hurt_own(lf, blocks, items, "hot_floor", sounds.len()),
                Stepped.Ore(at) => self.living.show(Shown.Lit(at), sounds.len()),
                Stepped.Egg(at) => self.living.show(Shown.EggStep(at), sounds.len()),
                Stepped.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                Stepped.Nothing => {},
            }
            self.inside(lf, f, blocks, items, mut sounds)
            if self.living.ai_end(lf, f, t, blocks) {
                self.hurt_own(lf, blocks, items, "freeze", sounds.len())
            }
        }
        self.living.y_body_rot_o = self.living.y_rot_o
        self.living.y_body_rot = self.living.body.y_rot
        self.living.tick_end()
    }

    /// What `saveAsPassenger` saves of it, in the order vanilla puts it: what every living entity
    /// saves, `Living.save_into`; then whether it's invisible, small, shows its arms, its disabled
    /// slots, whether it hides its base plate, whether it's a marker where it is, and its poses
    /// that aren't their defaults.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.living.save_into(mut t, "minecraft:armor_stand")
        let flags = self.flags()
        t.insert(String("Invisible"), flag(i32(self.living.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0))
        t.insert(String("Small"), flag(flags & SMALL_FLAG != 0))
        t.insert(String("ShowArms"), flag(flags & ARMS_FLAG != 0))
        t.insert(String("DisabledSlots"), Tag.Int(self.disabled_slots))
        t.insert(String("NoBasePlate"), flag(flags & NO_BASE_PLATE_FLAG != 0))
        if flags & MARKER_FLAG != 0 {
            t.insert(String("Marker"), flag(true))
        }
        var pose = JavaHashMap<String, Tag>()
        let names: List<str> = ["Head", "Body", "LeftArm", "RightArm", "LeftLeg", "RightLeg"]
        let ids: List<usize> = [HEAD_POSE, BODY_POSE, LEFT_ARM_POSE, RIGHT_ARM_POSE, LEFT_LEG_POSE, RIGHT_LEG_POSE]
        for i in 0..ids.len() {
            if not self.living.data.is_default(ids[i]) {
                let (x, y, z) = self.living.data.rotations(ids[i])
                pose.insert(String(names[i]), Tag.List([Tag.Float(x), Tag.Float(y), Tag.Float(z)]))
            }
        }
        t.insert(String("Pose"), Tag.Compound(pose))
        return Tag.Compound(t)
    }

    /// Whether it shows its arms, `showArms`.
    pub fn shows_arms(self) -> bool {
        return self.flags() & ARMS_FLAG != 0
    }

    /// A player's use of it, `ArmorStand.interact` (CAL-179), holding `held`, which they looked at
    /// `at_y` up it, `infinite` where they have infinite materials: a marker's passes; with
    /// nothing in hand, what's in the slot they clicked, `getClickedSlot`, or the main hand's
    /// where that's disabled, taken, `swapItem`; with something, it put in its slot,
    /// `getEquipmentSlotForItem`, swapped for what was there, unless the slot's disabled or a hand
    /// it shows no arms for, `FAIL`. A swap is `SUCCESS_SERVER`, with what the player's hand
    /// holds now; anything else passes. What its equipping plays is put in `sounds`.
    pub fn used<W: Wearing>(mut self, items: W, held: Tag?, at_y: f64, infinite: bool, sounds: mut List<EntitySound>) -> StandUse {
        if self.marker() {
            return StandUse.Pass
        }
        let slot = self.slot_of(items, held.copy())
        if held == none {
            let clicked = self.clicked_slot(at_y)
            let target = if self.disabled(clicked) { slot } else { clicked }
            if self.living.equipment[target] != none {
                let (swapped, hand) = self.swap(items, target, held.copy(), infinite, mut sounds)
                if swapped {
                    return StandUse.Swapped(hand)
                }
            }
        } else {
            if self.disabled(slot) or (slot <= 1 and not self.shows_arms()) {
                return StandUse.Fail
            }
            let (swapped, hand) = self.swap(items, slot, held.copy(), infinite, mut sounds)
            if swapped {
                return StandUse.Swapped(hand)
            }
        }
        return StandUse.Pass
    }

    // `isDisabled`: its disabled slots' bit for the slot, `getFilterBit(0)`, or a hand where it
    // shows no arms.
    fn disabled(self, slot: usize) -> bool {
        return self.disabled_slots & (1 << filter_bit(slot)) != 0 or (slot <= 1 and not self.shows_arms())
    }

    // `getEquipmentSlotForItem`: its equippable's slot where it may use it, `canUseSlot`, which
    // is neither the body's nor the saddle's nor disabled; else the main hand.
    pub fn slot_of<W: Wearing>(self, items: W, held: Tag?) -> usize {
        let stack = held else return 0
        let Tag.Compound(e) = items.worn_component(stack, String("minecraft:equippable")) ?? Tag.End else return 0
        let Tag.Str(named) = (if e.contains("slot") { e["slot"].copy() } else { Tag.End }) else return 0
        let names = slot_names()
        for i in 0..names.len() {
            if names[i] == named {
                if i == 6 or i == 7 or self.disabled(i) {
                    return 0
                }
                return i
            }
        }
        return 0
    }

    // `getClickedSlot`: by how far up it they looked, over its scale and a small one's half, the
    // feet's, chest's, legs' or head's where it has something there, else the offhand's where
    // only that hand holds something, else the main hand's.
    fn clicked_slot(self, at_y: f64) -> usize {
        let small = self.small()
        let scale = f32.nearest(self.living.attributes.value(attribute_id(String("scale")) ?? 0u32))
        let y = at_y / f64(scale * (if small { 0.5f32 } else { 1.0f32 }))
        let worn = self.living.equipment.copy()
        if y >= 0.1 and y < 0.1 + (if small { 0.8 } else { 0.45 }) and (worn[2] != none) {
            return 2
        }
        if y >= 0.9 + (if small { 0.3 } else { 0.0 }) and y < 0.9 + (if small { 1.0 } else { 0.7 }) and (worn[4] != none) {
            return 4
        }
        if y >= 0.4 and y < 0.4 + (if small { 1.0 } else { 0.8 }) and (worn[3] != none) {
            return 3
        }
        if y >= 1.6 and (worn[5] != none) {
            return 5
        }
        if worn[0] == none and worn[1] != none {
            return 1
        }
        return 0
    }

    // `swapItem`: nothing where what's there may not be taken, or nothing there may not be put,
    // by its disabled slots' bits 8 and 16 on; a creative player putting into an empty slot puts
    // one of theirs and keeps all; one with one or nothing swaps it for what's there; one with
    // more puts one in an empty slot. Whether it did, and what the player's hand holds then.
    fn swap<W: Wearing>(mut self, items: W, slot: usize, held: Tag?, infinite: bool, sounds: mut List<EntitySound>) -> (bool, Tag?) {
        let had = self.living.equipment[slot].copy()
        let f = filter_bit(slot)
        if had != none and self.disabled_slots & (1 << (f + 8)) != 0 {
            return (false, none)
        }
        if had == none and self.disabled_slots & (1 << (f + 16)) != 0 {
            return (false, none)
        }
        let count = match held.copy() {
            some(Tag.Compound(m)) => if m.contains("count") { m["count"].number_int() ?? 1 } else { 1 },
            _ => 0,
        }
        if infinite and had == none and held != none {
            self.put_on(items, slot, counted_one(held.copy()), mut sounds)
            return (true, held.copy())
        }
        if held == none or count <= 1 {
            self.put_on(items, slot, held.copy(), mut sounds)
            return (true, had)
        }
        if had != none {
            return (false, none)
        }
        self.put_on(items, slot, counted_one(held.copy()), mut sounds)
        return (true, shrunk(held.copy() ?? Tag.End, 1))
    }

    // `setItemSlot` and `onEquipItem`: where it's another item or has other components, its
    // equippable's sound, `getEquipSound`, unless it's silent, from its sound source, its seed
    // drawn from its random, at full volume and pitch.
    pub fn put_on<W: Wearing>(mut self, items: W, slot: usize, stack: Tag?, sounds: mut List<EntitySound>) {
        let old = self.living.equipment[slot].copy()
        self.living.equipment[slot] = stack.copy()
        let now = stack else return
        if same_stack(old, some(now.copy())) {
            return
        }
        let Tag.Compound(e) = items.worn_component(now.copy(), String("minecraft:equippable")) ?? Tag.End else return
        let Tag.Str(named) = (if e.contains("slot") { e["slot"].copy() } else { Tag.End }) else return
        if self.living.silent() or slot_names()[slot] != named {
            return
        }
        let seed = self.living.body.random.next_long()
        sounds.push(EntitySound { sound: equip_sound(e), x: self.living.body.x, y: self.living.body.y, z: self.living.body.z, volume: 1.0f32, pitch: 1.0f32, source: self.living.body.sound_source, seed: some(seed) })
    }
}

/// What a player's use of an armor stand did, `ArmorStand.interact` (CAL-179): passed, failed,
/// or swapped, with what their hand holds now.
pub enum StandUse {
    Pass
    Fail
    Swapped(Tag?)
}

// `EquipmentSlot.getFilterBit(0)` of the slot `slot`, in Calcite's order of them.
fn filter_bit(slot: usize) -> i32 {
    let bits: List<i32> = [0, 5, 1, 2, 3, 4, 6, 7]
    return if slot < bits.len() { bits[slot] } else { 0 }
}

// One of `stack`, `copyWithCount(1)`.
fn counted_one(stack: Tag?) -> Tag? {
    let Tag.Compound(m) = stack.copy() ?? Tag.End else return none
    var out = m.copy()
    out.insert(String("count"), Tag.Int(1))
    return some(Tag.Compound(out))
}

/// The sound an equippable `e` plays as it's put on, `equipSound`, by its name without
/// `minecraft:`, as Calcite plays sounds, `item.armor.equip_generic` where it names none (CAL-159).
pub fn equip_sound(e: JavaHashMap<String, Tag>) -> String {
    var named = String("minecraft:item.armor.equip_generic")
    if e.contains("equip_sound") {
        match e["equip_sound"] {
            Tag.Str(s) => named = s.copy(),
            Tag.Compound(m) => {
                if m.contains("sound_id") {
                    if let Tag.Str(s) = m["sound_id"] {
                        named = s.copy()
                    }
                }
            },
            _ => {},
        }
    }
    if named.starts_with("minecraft:") {
        return named[10..].copy()
    }
    return named
}

/// `WeavingMobEffect.spawnCobwebsRandomlyAround` the block `at` (CAL-182): how many, 2 or 3, drawn
/// from `random`, `randomBetweenInclusive`; then up to 15 places within a block of it, each drawn
/// x, y, z as it's asked for, `BlockPos.randomInCube`, taken where it isn't yet, its block can be
/// replaced and the one below is sturdy on top, `isFaceSturdy`, till there are as many. A place
/// whose chunk isn't loaded full isn't taken. They're in the order vanilla's `HashSet` of them has
/// them, 16 buckets as it's made, by the bucket of each's spread hash, `Vec3i.hashCode`, then as
/// they came.
pub fn webs_about<B: CollisionBlocks>(f: Facts, blocks: B, random: mut LegacyRandom, at: (i32, i32, i32)) -> List<(i32, i32, i32)> {
    let count = random.next_int_below(2) + 2
    let (cx, cy, cz) = at
    var taken = List<(i32, i32, i32)>()
    for _ in 0..15 {
        let x = cx - 1 + random.next_int_below(3)
        let y = cy - 1 + random.next_int_below(3)
        let z = cz - 1 + random.next_int_below(3)
        var seen = false
        for (tx, ty, tz) in taken {
            seen = seen or (tx == x and ty == y and tz == z)
        }
        if seen {
            continue
        }
        let here = blocks.collision_state(x, y, z) else continue
        let below = blocks.collision_state(x, y - 1, z) else continue
        if f.replaceable(here) and f.sturdy(below, UP, FULL) {
            taken.push((x, y, z))
            if i32.wrap(taken.len()) >= count {
                break
            }
        }
    }
    var keyed = List<(i32, usize)>()
    for i in 0..taken.len() {
        let (x, y, z) = taken[i]
        let h = y.wrapping_add(z.wrapping_mul(31)).wrapping_mul(31).wrapping_add(x)
        let spread = h ^ i32.wrap(u32.wrap(h) >> 16)
        keyed.push((spread & 15, i))
    }
    keyed.sort()
    var out = List<(i32, i32, i32)>()
    for (_, i) in keyed {
        out.push(taken[i])
    }
    return out
}

/// `Entity.isInWall` of what's at x, y, z, `width` across with its eyes `eyes` up (D425): whether a
/// block about its eyes, in a box 0.8 of its width across and 1e-6 high, `AABB.ofSize`,
/// suffocates, `isSuffocating`, with its collision shape meeting the box, `Shapes.joinIsNotEmpty`
/// with `AND`. A shulker box suffocates only with its lid closed, `NOT_CLOSED_SHULKER` (D440). A
/// block whose chunk isn't loaded full suffocates nothing.
pub fn in_wall_at<B: CollisionBlocks>(f: Facts, m: MovementStates, lf: LivingFacts, blocks: B, x: f64, y: f64, z: f64, width: f32, eyes: f32) -> bool {
    let half = f64(width * 0.8f32) / 2.0
    let eye = y + f64(eyes)
    let b = Aabb { min_x: x - half, min_y: eye - 1.0e-6 / 2.0, min_z: z - half, max_x: x + half, max_y: eye + 1.0e-6 / 2.0, max_z: z + half }
    let mover = Mover { y: 0.0 - f64.MAX, fall: 0.0 }
    for by in floor(b.min_y)..=floor(b.max_y) {
        for bz in floor(b.min_z)..=floor(b.max_z) {
            for bx in floor(b.min_x)..=floor(b.max_x) {
                let state = blocks.collision_state(bx, by, bz) else continue
                if not f.suffocating(state, lf.suffocation) {
                    continue
                }
                if f.is_a(f.block(state), "ShulkerBoxBlock") and blocks.shulker_open(bx, by, bz) {
                    continue
                }
                for s in m.state_boxes(f, state, bx, by, bz, mover) {
                    if meets(moved(s, f64(bx), f64(by), f64(bz)), b) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

/// `onClimbable`'s look at the block at x, y, z, a player's as well as a living entity's
/// (CAL-156): whether it's climbable, or an open trapdoor over a ladder facing its way.
pub fn climbable_at<B: CollisionBlocks>(lf: LivingFacts, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let state = blocks.collision_state(x, y, z) ?? 0
    if f.in_set(state, lf.climbable) {
        return true
    }
    if f.is_a(f.block(state), String("TrapDoorBlock")) and f.get_bool(state, String("open")) {
        let below = blocks.collision_state(x, y - 1, z) ?? 0
        let facing = f.get_name(state, String("facing")) ?? String()
        return f.block(below) == lf.ladder and (f.get_name(below, String("facing")) ?? String()) == facing
    }
    return false
}

/// `computeModifiedFriction`: a friction made less, `1 - (1 - friction) * modifier`, within 0 and 1.
pub fn modified_friction(friction: f32, modifier: f32) -> f32 {
    let v = 1.0f32 - (1.0f32 - friction) * modifier
    if v < 0.0f32 {
        return 0.0f32
    }
    return if v > 1.0f32 { 1.0f32 } else { v }
}

// `getFluidFallingAdjustedMovement`'s motion up and down: a sixteenth of its gravity down,
// unless it's falling and that would bring it within 0.003 of it, when it sinks at 0.003.
fn fluid_falling(gravity: f64, falling: bool, y: f64) -> f64 {
    if gravity == 0.0 {
        return y
    }
    if falling and (y - 0.005).abs() >= 0.003 and (y - gravity / 16.0).abs() < 0.003 {
        return -0.003
    }
    return y - gravity / 16.0
}

/// `LivingEntity.randomTeleport`'s place for a body `width` wide and `height` tall from x, y, z
/// (CAL-214), as a mob's `random_teleport` and a player's chorus fruit find it: held within the
/// border `border`, its west, north, east and south edges, a hair inside its east and south ones,
/// `clampVec3ToBound`; where its chunk's loaded, down from there to the first block it may
/// teleport onto, of `onto`, `ENTITIES_CAN_TELEPORT_TO`; there, where that's not of `avoids`,
/// the body's box meets no block, `noCollision`, and holds no liquid nor a block of `avoids`,
/// `checkPositionAndTeleport`, and, where `not_water`, the block below isn't water, as an
/// enderman's `canRandomlyTeleportTo` asks. None where it finds none.
pub fn random_teleport_spot<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, onto: BlockSet, avoids: BlockSet, min_y: i32, border: (f64, f64, f64, f64), wx: f64, y: f64, wz: f64, width: f32, height: f32, not_water: bool) -> (f64, f64, f64)? {
    let (west, north, east, south) = border
    let x = if wx < west { west } else { wx.min(east - f64(1.0e-5f32)) }
    let z = if wz < north { north } else { wz.min(south - f64(1.0e-5f32)) }
    let bx = floor(x)
    let bz = floor(z)
    if blocks.collision_state(bx, min_y, bz) == none {
        return none
    }
    var ty = y
    var py = floor(y)
    while py > min_y {
        py -= 1
        let state = blocks.collision_state(bx, py, bz) ?? 0
        if f.in_set(state, onto) {
            return teleport_fits(f, m, blocks, avoids, x, ty, z, state, width, height, not_water)
        }
        ty -= 1.0
    }
    return none
}

// `checkPositionAndTeleport`'s test of x, y, z over the block `below` (CAL-214), as
// `random_teleport_spot` gives it.
fn teleport_fits<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, avoids: BlockSet, x: f64, y: f64, z: f64, below: u32, width: f32, height: f32, not_water: bool) -> (f64, f64, f64)? {
    if f.in_set(below, avoids) {
        return none
    }
    let half = f64(width / 2.0f32)
    let b = Aabb { min_x: x - half, min_y: y, min_z: z - half, max_x: x + half, max_y: y + f64(height), max_z: z + half }
    let mover = Mover { y: y, fall: 0.0 }
    if not m.colliders(f, blocks, b, mover).is_empty() or any_liquid(f, blocks, b) {
        return none
    }
    for bx in floor(b.min_x)..=floor(b.max_x) {
        for by in floor(b.min_y)..=floor(b.max_y) {
            for bz in floor(b.min_z)..=floor(b.max_z) {
                if f.in_set(blocks.collision_state(bx, by, bz) ?? 0, avoids) {
                    return none
                }
            }
        }
    }
    if not_water and f.is_water(blocks.collision_state(floor(x), floor(y) - 1, floor(z)) ?? 0) {
        return none
    }
    return some((x, y, z))
}

/// `containsAnyLiquid`: whether a block from the box's least corner's to its greatest's holds a
/// fluid; one whose chunk isn't loaded doesn't.
pub fn any_liquid<B: CollisionBlocks>(f: Facts, blocks: B, b: Aabb) -> bool {
    for x in floor(b.min_x)..=floor(b.max_x) {
        for y in floor(b.min_y)..=floor(b.max_y) {
            for z in floor(b.min_z)..=floor(b.max_z) {
                if let state = blocks.collision_state(x, y, z) {
                    if f.fluid(state) != 0 {
                        return true
                    }
                }
            }
        }
    }
    return false
}

// `Mth.clamp` of a double.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo
    }
    return if v > hi { hi } else { v }
}

// A boolean as `putBoolean` saves it.
// The entity types, by their IDs, vanilla's `#inverted_healing_and_harm` holds, its `#undead`:
// `#skeletons`, `#zombies`, the wither and the phantom (D512).
fn inverted_kinds() -> List<u32> {
    return kinds_named(undead_names())
}

// The names of the entity types in vanilla's `#undead`.
fn undead_names() -> List<str> {
    return ["skeleton", "stray", "wither_skeleton", "skeleton_horse", "bogged", "parched", "zombie_horse", "camel_husk", "zombie", "zombie_villager", "zombified_piglin", "zoglin", "drowned", "husk", "zombie_nautilus", "wither", "phantom"]
}

// Each entity type, by its ID, with an effect it can't have, `canBeAffected` (D512): a silverfish
// infested, `#immune_to_infested`; a slime oozing, `#immune_to_oozing`; the undead neither
// regeneration nor poison, `#ignores_poison_and_regen`; spiders and cave spiders not poison,
// `Spider`'s; the wither and wither skeletons not wither; a parched not weakness; and nautiluses
// not poison, `AbstractNautilus`'.
fn unaffected_kinds() -> List<(u32, i32)> {
    var out = List<(u32, i32)>()
    for k in kinds_named(["silverfish"]) {
        out.push((k, INFESTED))
    }
    for k in kinds_named(["slime"]) {
        out.push((k, OOZING))
    }
    for k in kinds_named(undead_names()) {
        out.push((k, REGENERATION))
        out.push((k, POISON))
    }
    for k in kinds_named(["spider", "cave_spider", "nautilus", "zombie_nautilus"]) {
        out.push((k, POISON))
    }
    for k in kinds_named(["wither", "wither_skeleton"]) {
        out.push((k, WITHER))
    }
    for k in kinds_named(["parched"]) {
        out.push((k, WEAKNESS))
    }
    return out
}

// The IDs of the entity types named `names`, without `minecraft:`, those there are.
fn kinds_named(names: List<str>) -> List<u32> {
    let kinds = builtin_entries(6)
    var out = List<u32>()
    for n in names {
        for i in 0..kinds.len() {
            if kinds[i] == String(n) {
                out.push(u32.wrap(i))
            }
        }
    }
    return out
}

// A living entity's effects as `MobEffectInstance.CODEC.listOf()` reads `tag`, none where it
// isn't a list or one doesn't read, an effect of a kind it had in the earlier's place (CAL-163).
pub fn read_effects(tag: Tag) -> List<ActiveEffect> {
    var out = List<ActiveEffect>()
    let Tag.List(items) = tag else return out
    for item in items {
        let e = ActiveEffect.read(item) else return List<ActiveEffect>()
        var put = false
        for i in 0..out.len() {
            if out[i].id == e.id {
                out[i] = e.copy()
                put = true
            }
        }
        if not put {
            out.push(e)
        }
    }
    return out
}

fn flag(b: bool) -> Tag {
    return Tag.Byte(if b { 1i8 } else { 0i8 })
}

// `SPEED_MODIFIER_POWDER_SNOW_ID`.
fn powder_snow_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "powder_snow" }
}

// The number saved as `key` as a float, as `getFloatOr` reads it, or `fallback`.
fn float_or(tag: JavaHashMap<String, Tag>, key: str, fallback: f32) -> f32 {
    if not tag.contains(key) {
        return fallback
    }
    return tag[key].number_float() ?? fallback
}

/// The three numbers saved as `key`, as `Vec3.CODEC` reads them, or none.
pub fn vec3_of(tag: JavaHashMap<String, Tag>, key: str) -> (f64, f64, f64)? {
    if not tag.contains(key) {
        return none
    }
    let Tag.List(items) = tag[key] else return none
    if items.len() != 3 {
        return none
    }
    let x = items[0].number_double() else return none
    let y = items[1].number_double() else return none
    let z = items[2].number_double() else return none
    return some((x, y, z))
}

// An armor stand's poses as `ArmorStandPose.CODEC` reads them: each of the six its default where
// it's missing, else three floats, each within a turn, `Rotations`; none where one's there but
// isn't three numbers, which fails the whole.
fn read_poses(t: Tag) -> List<(f32, f32, f32)>? {
    let Tag.Compound(m) = t else return none
    let names: List<str> = ["Head", "Body", "LeftArm", "RightArm", "LeftLeg", "RightLeg"]
    var out: List<(f32, f32, f32)> = [(0.0f32, 0.0f32, 0.0f32), (0.0f32, 0.0f32, 0.0f32), (-10.0f32, 0.0f32, -10.0f32), (-15.0f32, 0.0f32, 10.0f32), (-1.0f32, 0.0f32, -1.0f32), (1.0f32, 0.0f32, 1.0f32)]
    for i in 0..names.len() {
        if not m.contains(names[i]) {
            continue
        }
        let Tag.List(items) = m[names[i]] else return none
        if items.len() != 3 {
            return none
        }
        var v = List<f32>()
        for item in items {
            let n = item.number_float() else return none
            v.push(if n - n == 0.0f32 { n % 360.0f32 } else { 0.0f32 })
        }
        out[i] = (v[0], v[1], v[2])
    }
    return some(out)
}

// `AbstractHorse.isWoodSoundType`, by the step sound of the block's sound type: wood's, the
// Nether's woods', stems', cherry wood's and bamboo wood's.
fn wood_step(name: String) -> bool {
    return name == "block.wood.step" or name == "block.nether_wood.step" or name == "block.stem.step" or name == "block.cherry_wood.step" or name == "block.bamboo_wood.step"
}

/// `CombatRules.getDamageAfterMagicAbsorb`: `damage` less a twenty-fifth of it for each point of
/// `protection`, from 0 to 20 (D439).
pub fn after_magic_absorb(damage: f32, protection: f32) -> f32 {
    let real = if protection < 0.0f32 { 0.0f32 } else { protection.min(20.0f32) }
    return damage * (1.0f32 - real / 25.0f32)
}

/// What a living entity's enchanted equipment does against a damage, as its level works it out
/// with its loot (D439): the protection it gives, `EnchantmentHelper.getDamageProtection`, and
/// whether it makes the entity immune, `isImmuneToDamage`, against the damage whose context is
/// `params`, `worn` the entity's equipment by slot in `slot_names`' order; each with what it
/// couldn't tell, said to be missing.
pub interface Warding {
    fn protection(self, worn: List<Tag?>, params: LootParams) -> (f32, List<String>)
    fn immune(self, worn: List<Tag?>, params: LootParams) -> (bool, List<String>)
}

/// What a living entity's enchanted equipment does against one damage, as `Warding` works it out
/// (D439): whether it's immune to it, and its protection, of which `getDamageAfterMagicAbsorb`
/// takes a twenty-fifth a point, 20 at most. And the armor effectiveness of what dealt it's
/// weapon, its enchantments' value effects with their levels, breach's (D443), which change the
/// share its armor takes.
pub struct Ward {
    pub immune: bool = false
    pub protection: f32 = 0.0f32
    pub armor: List<(Tag, i32)> = List<(Tag, i32)>()
    /// The hand that holds what has `death_protection`, the first of the main and the off, and
    /// that protection, which saves it where the damage would kill it (D518).
    pub totem: (usize, Tag)? = none
}

/// `CombatRules.getDamageAfterAbsorb` of `damage` against `armor` and `toughness`, in floats, with
/// no weapon's armor effectiveness (D416).
pub fn after_absorb(damage: f32, armor: f32, toughness: f32) -> f32 {
    return damage * (1.0f32 - armor_share(damage, armor, toughness))
}

/// The share of `damage` that `armor` and `toughness` take, `getDamageAfterAbsorb`'s
/// `armorFraction`, in floats (D443).
pub fn armor_share(damage: f32, armor: f32, toughness: f32) -> f32 {
    let t = 2.0f32 + toughness / 4.0f32
    // `Mth.clamp`.
    let v = armor - damage / t
    let least = armor * 0.2f32
    let real = if v < least { least } else { v.min(20.0f32) }
    return real / 25.0f32
}

// The item of the stack `stack`, empty for none, as `ItemStack.isSameItem` compares them.
fn held_item(stack: Tag?) -> String {
    let held = stack.copy() else return String()
    let Tag.Compound(m) = held else return String()
    if not m.contains("id") {
        return String()
    }
    let Tag.Str(id) = m["id"] else return String()
    return id.copy()
}

// `getUseDuration` of the stack `stack`: a bow's 72000 (CAL-159); a mob uses nothing else yet.
fn use_duration(stack: Tag) -> i32 {
    let item = held_item(some(stack.copy()))
    if item == "minecraft:bow" or item == "minecraft:crossbow" or item == "minecraft:trident" {
        return 72000
    }
    return 0
}

/// Whether the block state `state` is drawn, its render shape not `RenderShape.INVISIBLE` (D444):
/// not air, a liquid, a barrier, light, a structure void, an end portal or gateway, a bubble column
/// or a moving piston, the blocks whose classes say so; where a sprint's particle shows, a player's
/// or a mob's (CAL-201).
pub fn drawn_block(f: Facts, state: u32) -> bool {
    if f.is_air(state) {
        return false
    }
    let block = f.block(state)
    for name in ["LiquidBlock", "BarrierBlock", "LightBlock", "StructureVoidBlock", "EndPortalBlock", "EndGatewayBlock", "BubbleColumnBlock", "MovingPistonBlock"] {
        if f.is_a(block, String(name)) {
            return false
        }
    }
    return true
}
