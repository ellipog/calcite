    pub inventory: List<Tag> = List<Tag>()
    pub reward: i32 = 0
    pub converted_by: i32? = none
    /// A tame wolf's: its owner's UUID, what had hurt it lately, `getCombatTracker`, and who last
    /// hurt it, by UUID, its kill credit, whose death message its level tells its owner,
