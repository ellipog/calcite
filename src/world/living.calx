/// A mob's throw of a splash potion, the mob of the UUID `owner`'s, `Witch.performRangedAttack`
/// (D528): from x, y, z, a tenth below its eyes, along xd, yd, zd, at `power` blocks a tick,
/// `uncertainty` off, the potion it chose, by name.
pub struct Hurled {
    pub owner: (i64, i64)
    pub x: f64
    pub y: f64
    pub z: f64
    pub xd: f64
    pub yd: f64
    pub zd: f64
