    pub doors: BlockSet
    pub fences: BlockSet
    pub cauldrons: BlockSet
    pub follow_range: u32
    pub step_height: u32
    /// What mobs' goals read of blocks (CAL-158): the grass block, by its ID, which an animal
    /// would walk to and a sheep eats; what a sheep eats where it stands, `#edible_for_sheep`;
    /// and what an enderman may take, `#enderman_holdable` (CAL-159).
    pub grass_block: u32
    pub sheep_food: BlockSet
    pub enderman_holdable: BlockSet
    /// What speeds a zombie villager's cure, `#speeds_up_zombie_villager_curing` (CAL-175).
