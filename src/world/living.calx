/// A living entity, as vanilla's `LivingEntity` has it and moves it (CAL-155): what every entity
/// has (`world.body`), its attributes as its type's `DefaultAttributes` supplies them
/// (`world.attributes`), its synced data (`world.entity_data`), its health, and its head's and
/// body's turns; and how it moves, `aiStep` and `travel`. Its motion under 0.003 a tick each way
/// is let go; it jumps as it's told to, off the ground, in shallow water or lava, or up through
/// deeper; then it goes through the air, slowed on the ground as the block below it is slippery,
/// `computeModifiedFriction` by its friction modifier, and by the air as its air drag modifier
/// says, falling as its gravity says; through water and lava, slowed as they slow it and held up as
/// they hold it up, `getFluidFallingAdjustedMovement`, and out over an edge it's pushed against;
/// and up and down what's climbable, no faster than 0.15 a tick across or down: a ladder, a vine,
/// scaffolding, or an open trapdoor over a ladder facing its way. What it's told to walk,
/// `xxa`, `yya` and `zza`, turns with it, `moveRelative`.
///
/// Its move is `Entity.move`'s, with a living entity's own steps between: its fluids looked at
/// again, out of water; the dust a block throws up as it lands, `checkFallDamage`; the block's
/// `fallOn`, which plays its fall sounds as `causeFallDamage` plays them where the fall's past its
/// safe distance, with hay, honey, slime, powder snow, beds and pointed dripstone each their own
/// way; and its steps heard as `applyMovementEmissionAndPlaySound` hears them, the block's step
/// sound each block it goes, an amethyst chime on what chimes and a swim in water. Its air comes
/// back 4 a tick out of water, and under it runs out unless it breathes there.
///
/// An armor stand (`ArmorStand`) is the one living entity Calcite runs yet. It has no AI, so it
/// never walks or jumps; it moves only where it has physics, neither a marker nor without gravity;
/// its body turns as it's turned. It's made, loaded and saved as vanilla's is.
///
/// Not in Calcite yet: being hurt, which waits for damage (P6.5), so a fall, a wall, fire,
/// drowning and freezing hurt nothing and nothing dies, nor does cramming (CAL-156); effects, kept
/// as it was loaded with; an armor stand pushing minecarts, which Calcite doesn't have; what
/// blocks do to it, `applyEffectsFromBlocks`, as for items (CAL-172), and farmland and turtle eggs
/// fallen on; its equipment, kept as it was loaded with, and its custom name, neither sent; and
/// sleeping.
module world.living

import math.mth.{floor, table_cos, table_sin}
import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import resources.identifier.{Identifier}
import server.log.{Entry}
import std.java.math.{cos as java_cos, pow}
import world.arrow.{ArrowHit, BlockStruck}
import world.attributes.{ADD_VALUE, Attributes, Modifier, Wearing, attribute_id, equip, slot_names, unworn}
import world.block_facts.{fall_sound_names, place_sound_pitches, place_sound_volumes, state_place_sounds, step_sound_names}
import world.body.{Body, BodyFacts, EntitySound, Moved, PORTAL_DELAY, bool_or, int_or, short_or, uuid_of, uuid_tag}
import world.cloud.{Dose}
import world.collision.{Aabb, CollisionBlocks}
import world.combat.{CombatEntry, CombatTracker, WATER_FALL}
import world.consume_effects.{ConsumeEffect, death_effects}
import world.digging.{shrunk, value_effect}
import registry.builtin.{builtin_entries}
import world.effects.{ABSORBS, ABSORPTION, ActiveEffect, DOLPHINS_GRACE, EffectFacts, GLOWING, HARMS_NOW, HEALS, HEALS_NOW, INFESTED, INVISIBILITY, JUMP_BOOST, LEVITATION, MAGIC_HURT, NO_HURT, OOZING, POISON, POISONS, REGENERATION, RESISTANCE, SLOW_FALLING, WEAKNESS, WEAVING, WIND_CHARGED, WITHER, WITHERS, WITHER_HURT, effect_facts, effect_names, jump_boost_power}
import world.damage.{ALWAYS_KILLS_ARMOR_STANDS, BURNS_ARMOR_STANDS, BYPASSES_ARMOR, BYPASSES_WOLF_ARMOR, BYPASSES_COOLDOWN, BYPASSES_EFFECTS, BYPASSES_ENCHANTMENTS, BYPASSES_INVULNERABILITY, BYPASSES_RESISTANCE, CAN_BREAK_ARMOR_STAND, Damage, DamageTypes, IGNITES_ARMOR_STANDS, IS_EXPLOSION, IS_FALL, IS_FIRE, NO_ANGER, NO_IMPACT, NO_KNOCKBACK, WITCH_RESISTANT_TO}
import world.experience_orb.{Follower}
import world.entity_data.{AIR_SUPPLY, ARROW_COUNT, ARMS_FLAG, LIVING_FLAGS, BODY_POSE, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, DYING, EFFECT_AMBIENCE, EFFECT_PARTICLES, EntityData, FALL_FLYING_FLAG, GLOWING_FLAG, HEAD_POSE, HEALTH, INVISIBLE_FLAG, LEFT_ARM_POSE, LEFT_LEG_POSE, MARKER_FLAG, NO_BASE_PLATE_FLAG, NO_GRAVITY, ON_FIRE_FLAG, POSE_ID, RIGHT_ARM_POSE, RIGHT_LEG_POSE, SHARED_FLAGS, SILENT, SLEEPING, SLEEPING_POS, SMALL_FLAG, STAND_FLAGS, SWIMMING_FLAG, TICKS_FROZEN, Value, armor_stand_data}
import world.menu.{same_stack}
import world.goals.{Bred, Grazed, Temptations}
import world.infested.{Infested}
import world.inside.{Acted, CLEAR_FREEZE, Collector, EXTINGUISH, BlockEffect, bubble_open_above, FIRE_IGNITE, FREEZE, GatewayMove, Gateways, Inside, LAVA_IGNITE, Movement, PortalProcess, Rain, Touched, Travel, fluid_effects, inside_blocks, touch_block}
import world.loot.{LootEntity, LootParams}
import world.movement.{Mover, MovementStates, meets, moved}
import world.paths.{PathStates}
import world.thrown.{PearlHit, RocketBurst, Splash}
import world.fireball.{FireballHit, Homing}
import worldgen.facts.{BlockSet, FULL, Facts, UP}

/// The body slot among its equipment, `EquipmentSlot.BODY`'s, where a horse's or wolf's armor
/// goes (CAL-201).
pub const BODY_SLOT: usize = 6
/// How long it takes to freeze, `getTicksRequiredToFreeze`.
const TICKS_TO_FREEZE: i32 = 140
/// The hurt of a fall a living entity's move found, `causeFallDamage`'s `hurt` (CAL-159): a
/// stalagmite's where `stalagmite`, else a fall's, of `amount`, as it had heard `heard` of its
/// tick's sounds and shown `shown` things, and how far it fell, which what hurts it keeps
/// (CAL-201).
pub struct FallHurt {
    pub stalagmite: bool
    pub amount: f32
    pub fell: f64 = 0.0
    pub heard: usize
    pub shown: usize
}

/// The dust a block throws up where a living entity lands on it, as `checkFallDamage` sends it:
/// the block's state, where, and how many specks, `ParticleTypes.BLOCK` at 0.15 a tick.
pub struct FallDust {
    pub state: u32
    pub x: f64
    pub y: f64
    pub z: f64
    pub count: i32
}

/// An egg a chicken lays, `dropFromGiftLootTable` of `gameplay/chicken_lay` (CAL-156): where, and
/// the item, which the chicken's variant picks.
pub struct Laid {
    pub x: f64
    pub y: f64
    pub z: f64
    pub item: String
    /// The loot table it's dropped by, whose random sequence is made as it is: a chicken's egg's,
    /// `gameplay/chicken_lay`, an armadillo's scute shed, `gameplay/armadillo_shed`, or brushed
    /// off, `brush/armadillo` (CAL-160), or a tame cat's morning gift, `gameplay/cat_morning_gift`
    /// (CAL-201).
    pub table: String
    /// Whether its stacks drop as `new ItemEntity` makes them, with no pickup delay, as a cat's
    /// gift does, rather than by `spawnAtLocation` (CAL-201).
    pub loose: bool = false
}

/// What a mob's level drops at its place, `spawnAtLocation`, as a mob that picks up something
/// better drops what it had by its chance (CAL-159): where, and the stack.
pub struct Spilled {
    pub x: f64
    pub y: f64
    pub z: f64
    pub stack: Tag
}

/// An item a villager throws to another, `BehaviorUtils.throwItem` (CAL-160): where it's made,
/// its motion, the stack and its thrower's UUID.
pub struct Tossed {
    pub x: f64
    pub y: f64
    pub z: f64
    pub vx: f64
    pub vy: f64
    pub vz: f64
    pub stack: Tag
    pub thrower: (i64, i64)
    /// The ticks till it may be picked up, a dolphin's drop's 40 (CAL-201).
    pub delay: i32 = 10
}

/// A piglin's barter, `PiglinAi.throwItems` of `getBarterResponseItems` (CAL-200): where it stands,
/// how far up from there what it throws is made, 0.3 below its eyes, the place thrown toward, and
/// its UUID, the thrower; its level rolls `gameplay/piglin_bartering` of it and throws each stack.
pub struct Barter {
    pub x: f64
    pub y: f64
    pub z: f64
    pub lift: f64
    pub to: (f64, f64, f64)
    pub thrower: (i64, i64)
}

/// A piglin's hunt, `StartHuntingHoglin`, after it's angry at the hoglin `target` and not hunting
/// for a while itself (CAL-200): its level tells the grown piglins near it, `told`, of the hoglin,
/// `broadcastAngerTarget`, then has those it sees, `nearest`, not hunt for a while either, each
/// drawn from the level's random, its brain's tick stopped for it.
pub struct Hunt {
    pub target: i32
    pub told: List<i32>
    pub nearest: List<i32>
}

/// A particle a living entity has the server send, `ServerLevel.sendParticles` of one with no
/// spread or speed, as a baby fed older does, `happy_villager` (D415): its name and where.
pub struct Sent {
    pub particle: String
    pub x: f64
    pub y: f64
    pub z: f64
}

/// `ServerLevel.sendParticles` of `count` of the particle `particle`, or, where `item` names one,
/// item particles of it, `ParticleTypes.ITEM`, at x, y, z, spread so far each way, at `speed`
/// (CAL-201).
pub struct Spread {
    pub particle: String
    pub item: String = String()
    pub x: f64
    pub y: f64
    pub z: f64
    pub count: i32
    pub dx: f64
    pub dy: f64
    pub dz: f64
    pub speed: f64
}

/// What a living entity shows the players near it besides its sounds: the dust it throws up
/// landing, an entity event, `broadcastEntityEvent`, as 54, honey slid on, 55, its hands swapped,
/// and 67, air run out; a chicken's egg, which the server drops; the slots of its equipment that
/// changed, each with what's in it now, `ClientboundSetEquipmentPacket`; and a particle the server
/// sends.
pub enum Shown {
    Dust(FallDust)
    Particle(Sent)
    /// Particles the server sends, `sendParticles`, as `Spread` has them (CAL-201).
    Spread(Spread)
    /// A pufferfish's touch of a mob, which its level deals, `Pufferfish.touch`: the mob's ID and
    /// the pufferfish's puff, `(target, puff)` (CAL-201).
    Sting((i32, i32))
    Event(i8)
    /// An entity event of another entity, by its ID, as a villager breeding shows its partner's
    /// in its own tick (CAL-160).
    EventOf((i32, i8))
    Laid(Laid)
    Worn(List<(usize, Tag?)>)
    /// What a sheep's eating does to the level, which mob griefing lets it do, and what a farm
    /// animal's breeding asks of it (CAL-158).
    Grazed(Grazed)
    Bred(Bred)
    /// The carrots at a place a rabbit raided, which its level makes younger or takes away,
    /// `RaidGardenGoal.tick` (CAL-201).
    Raided((i32, i32, i32))
    /// A hurt in its own tick that took the whole of it, by the damage type's ID, whose damage
    /// event goes to those who see it; a death in its own tick, what its level does of it; and
    /// what Calcite doesn't do yet that it would have, to be said (D424).
    Damaged(i32)
    Died(Death)
    Missing(String)
    /// Its conversion done, `ConversionTracker.doConversion` (CAL-175): into the kind of mob it's
    /// turned into, which its level makes of it, `convertTo` with `ConversionParams.single`, and the
    /// level event heard where that is unless it's silent; then it's gone.
    Converted((i32, i32))
    /// Its leash tied to what has the ID, or let go, 0, which its tracker sends those who see it,
    /// `ClientboundSetEntityLinkPacket` (CAL-179).
    Leashed(i32)
    /// The knot `id` a leash tied it to, which goes where nothing's left tied to it,
    /// `notifyLeasheeRemoved` (CAL-179).
    KnotLeft(i32)
    /// Its leash's knot, at a fence's place, which its level gets or makes for it before its tick
    /// goes on, `getOrCreateKnot` (CAL-179).
    Knotted((i32, i32, i32))
    /// The player of the UUID riding it tamed it, whose `TAME_ANIMAL` its level triggers
    /// (CAL-179).
    Tamed((i64, i64))
    /// A parrot sat on the shoulder of its owner, the player of the UUID, as it's saved with its
    /// type, `setEntityOnShoulder`, its variant shown there, which its level puts on them; it's
    /// gone (CAL-201).
    Shouldered(((i64, i64), Tag, i32))
    /// It threw the player riding it off, `ejectPassengers`, as it was then, `thrown_from`,
    /// which its level puts where they get off before it's heard again (CAL-179).
    ThrewPlayer
    /// Its way through a nether portal, which its level takes it on (D578).
    Travel(Travel)
    /// An end gateway it went into, at its place, whose cooldown its level begins, its block
    /// event where the walk's cursor ended; and the way one took it within its level (D594).
    Gateway(((i32, i32, i32), (i32, i32, i32)))
    /// The boxes of an ender dragon's head, neck and body where it would break what it flies
    /// into, which its level checks in turn as it has them then, `checkWalls` (D614).
    Walls(List<Aabb>)
    /// The leaves a ravager ran into, in turn, which its level breaks with their drops, by it,
    /// `destroyBlock` (CAL-200).
    Ravaged(List<(i32, i32, i32)>)
    /// A ravager's roar, which its level does to what's near it, `Ravager.roar` (CAL-214).
    Roared
    /// Fangs' bite on the living things in their reach, which their level deals (CAL-200).
    Fanged(Fanged)
    /// The fangs an evoker cast, by its UUID, each where it is, turned, and the ticks it waits,
    /// which its level makes, `addFreshEntity` (CAL-200).
    Fangs(((i64, i64), List<(f64, f64, f64, f32, i32)>))
    /// The vexes an evoker summoned, by its UUID, each at its block, with its life, which its level
    /// makes, `EvokerSummonSpellGoal.performSpellCasting` (CAL-200).
    Summoned(((i64, i64), List<(i32, i32, i32, i32)>))
    /// A villager that wants an iron golem asking for one, where so many villagers near it want
    /// one, which its level summons, `spawnGolemIfNeeded` (CAL-201).
    CallGolem((i32, (Aabb, (i32, i32, i32))))
    /// The blocks a snow golem's trail would cover with snow, which its level does where mob
    /// griefing lets it, `SnowGolem.aiStep` (CAL-201).
    SnowTrail(List<(i32, i32, i32)>)
    /// The sheep an evoker turned red, by ID, where it's alive, which its level does, `setColor`
    /// (CAL-200).
    Wololo(i32)
    /// An ender dragon's strikes on the players its wings and head reach in its tick, in turn,
    /// which its level deals, `knockBack` and `hurt` (D615).
    Beaten(List<Beat>)
    /// An ender dragon's breath, the cloud it leaves at its place, owned by the dragon of its
    /// UUID, which its level makes and the dragon keeps, `DragonSittingFlamingPhase` (D617); and
    /// that cloud, by entity ID, gone as its breath ends, `end`.
    Breathed(((f64, f64, f64), (i64, i64)))
    Quenched(i32)
    /// An ender dragon's word to its dragon fight, whose dragon it is, `updateDragon`: its health
    /// over its most, which its fight's boss bar shows, its fight's count since it last saw it
    /// none again, and its name on the bar where it's given one (D626); and its death's end, which
    /// its fight hears of, `setDragonKilled` (D627).
    DragonSeen(f32)
    DragonKilled
    /// An ender dragon's strafe's fireball, from where it starts, along the way it's shot, owned
    /// by the dragon of its UUID, which its level makes and adds, `DragonStrafePlayerPhase` (D619).
    FireballShot(((f64, f64, f64), (f64, f64, f64), (i64, i64)))
    Moved(GatewayMove)
    /// A slime's split as it's taken out dying, what its level makes of it (D430).
    Split(Split)
    /// Redstone ore it stepped on, at its place, which its level lights (D431).
    Lit((i32, i32, i32))
    /// A wooden button an arrow went into, at its place, which its level presses (CAL-159).
    Pressed((i32, i32, i32))
    /// A pressure plate it went into that gave nothing yet, at its place, and the entities but
    /// players on it as it went in, every one and the living ones, which its level presses it by,
    /// `checkPressed` (D701).
    Plate(((i32, i32, i32), (i32, i32)))
    /// Tripwire it went into that wasn't powered, at its place, which its level presses by it
    /// where it's not ticking already, `checkPressed` (D702).
    Tripwire((i32, i32, i32))
    /// A big dripleaf it stood on that was level, at its place, which its level tilts where
    /// nothing powers it (D703).
    Dripleaf((i32, i32, i32))
    /// A detector rail it went into that wasn't powered, at its place, which its level looks for
    /// minecarts on (D704).
    Rail((i32, i32, i32))
    /// What it wears in a slot worn by so much, which its level does with its random,
    /// `hurtAndBreak`, as the sun wears an undead mob's helmet (D437).
    Wore((usize, i32))
    /// An armor stand's breaking, what its level does of it, `StandBreak` (D441).
    StandBroken(StandBreak)
    /// A mob's swing of a hand, by `InteractionHand`'s ID, with its `SwingAnimation`, its type's ID
    /// and its ticks, sent those who see it; and its attack on the player of an entity ID,
    /// `doHurtTarget`, which its level deals, with where the mob was as it attacked, in its goal's
    /// tick, before it moved, the damage's place (CAL-159).
    Swung((i32, i32, i32))
    Attack((i32, f64, f64, f64))
    /// A guardian's beam's end on the entity of an ID, `GuardianAttackGoal.tick` (CAL-200): its
    /// hurt by indirect magic of the damage, caused and dealt by the guardian, then the guardian's
    /// attack on it, `doHurtTarget`, with where it was, which its level deals.
    Beamed((i32, f32, f64, f64, f64))
    /// An elder guardian's mining fatigue on the players around where it is, and whether it's
    /// silent, `ElderGuardian.customServerAiStep`, which its level gives them (CAL-200).
    Fatigue((f64, f64, f64, bool))
    /// A dolphin's grace for the player of an ID it swims with, `DolphinSwimWithPlayerGoal`,
    /// which its level gives them (CAL-201).
    Grace(i32)
    /// A level event at a block, `levelEvent`: its kind, the block and its data (CAL-159).
    Level((i32, i32, i32, i32, i32))
    /// An enderman's take of the block at a place and its leave of what it carries at one, which
    /// its level does, `EndermanTakeBlockGoal` and `EndermanLeaveBlockGoal` (CAL-159).
    Took((i32, i32, i32))
    Left((i32, i32, i32))
    /// A villager's door at a place opened or shut, `DoorBlock.setOpen`, which its level does as
    /// its brain's tick stops for it (CAL-160).
    Door((i32, i32, i32, bool))
    /// A villager's offers priced again for the player trading with it, `updateSpecialPrices`,
    /// which they're sent, what their menu's payments buy made again (CAL-160).
    Repriced
    /// Farmland at a place it landed on from so high, and whether it's big enough to trample it,
    /// 0.512 by its width squared and height, `FarmlandBlock.fallOn`, shown before the fall's hurt
    /// (CAL-172); as its tick ends, the level's draw for it makes that whether it tramples it, and
    /// where it does and mob griefing lets it, its level turns it to dirt, `turnToBaseBlock`
    /// (CAL-160).
    Trampled((f64, i32, i32, i32, bool))
    /// A bed at a place it lay down in, or got up from, `OCCUPIED` set and updated,
    /// `setBlockAndUpdate`, which its level does (CAL-160).
    Bed((i32, i32, i32, bool))
    /// A villager's harvest of the ripe crop at a place, `destroyBlock` with its drops, which its
    /// level breaks as its brain's tick stops for it; its seed planted at one, the crop's state set
    /// and updated, `setBlockAndUpdate`; and a crop grown at one by its bone meal, set with flags 2
    /// (CAL-160).
    Harvested((i32, i32, i32))
    Planted((i32, i32, i32, u32))
    Grew((i32, i32, i32, u32))
    /// A silverfish's going into the block at a place, a host its level makes infested and
    /// updates, `setBlockAndUpdate`, as `SilverfishMergeWithStoneGoal.start` does; and an infested
    /// block at a place it woke, which its level breaks with its drops where mob griefing's on,
    /// `destroyBlock`, and else makes its host again and updates, as
    /// `SilverfishWakeUpFriendsGoal.tick` does (CAL-172).
    Merged((i32, i32, i32))
    Woke((i32, i32, i32))
    /// A bee gone into its hive, at the hive's place, with its tag as it saved, which its level
    /// keeps, `BeehiveBlockEntity.addOccupant` (CAL-177).
    Hived(((i32, i32, i32), Tag))
    /// A crop a bee grew, its new state at its place, which its level sets and updates,
    /// `setBlockAndUpdate`, as `BeeGrowCropGoal.tick` does (CAL-177).
    Grown((i32, i32, i32, u32))
    /// Turtle eggs at a place it landed on, `TurtleEggBlock.fallOn`, and stepped on, `stepOn`,
    /// which its level draws for as it takes them, in their turn in its tick (CAL-172).
    EggFall((i32, i32, i32))
    EggStep((i32, i32, i32))
    /// A water or powder snow cauldron at a place it burnt in, whose fire it takes before it's
    /// put out, which its level lowers where it may interact there, `mayInteract`,
    /// `LayeredCauldronBlock.handleEntityOnFireInside` (CAL-172).
    Doused((i32, i32, i32))
    /// What an item's stack held, let go of where it was destroyed, `Acted.Emptied` (CAL-172).
    Emptied(((f64, f64, f64), List<Tag>))
    /// A stack it dropped, `Acted.Dropped` (CAL-214).
    Dropped(((f64, f64, f64), Tag))
    /// Powder snow it moved in, at its place across and the snow's top, where a snowflake may
    /// come, and the snowflake's motion across, each way, once its level's random has drawn
    /// whether it comes and how it moves, none where it doesn't (D698).
    Snow(((f64, f64, f64), (f32, f32)?))
    /// Powder snow at a place it burnt in, which its level melts where it may (D698).
    Melted((i32, i32, i32))
    /// A honey block it slid down, where it is and its sounds' source, none where it's silent, and
    /// whether its slide's sound comes and its entity event, 53, once its level's random has drawn
    /// them, 1 in 5 each, `maybeDoSlideEffects` (D699).
    Honey((((f64, f64, f64), i32)?, (bool, bool)?))
    /// The top of a bubble column it went into, at the column's place, and where its splashes and
    /// bubbles go across, each one's x and z within its block, once its level's random has drawn
    /// them, a splash, a bubble, a splash and a bubble, `sendBubbleColumnParticles` (D700).
    Bubbles(((i32, i32, i32), List<(f64, f64)>))
    /// A villager's offers asked for where they're still to make, `getOffers`, which the level
    /// makes as its trade set has them, at the place it was then, and updates the demand of so
    /// many times, `updateDemand`, as it did them as they were made (CAL-160).
    Offers((f64, f64, f64, i32))
    /// A mob's shot, `performRangedAttack`, whose arrow its level makes (CAL-159).
    Fired(Fired)
    /// A mob's crossbow's shot, `CrossbowAttackMob.performCrossbowAttack`, whose arrows its level
    /// makes, `CrossbowItem.performShooting` (CAL-200).
    CrossbowShot(CrossbowShot)
    /// A witch's throw of a splash potion, which its level makes and adds (D528).
    Hurled(Hurled)
    FireballFired(FireballFired)
    /// What a mob that picked up something better drops of what it had, which its level makes;
    /// and its pickup of so many of the item of an entity ID, `take`, which those who see the item
    /// are told (CAL-159).
    Spilled(Spilled)
    /// What an eye of ender that survives leaves as its life runs out, its stack where it was,
    /// which its level makes as `new ItemEntity` makes one, with no pickup delay (D599).
    Survived(Spilled)
    /// A fox's spat-out item, `Fox.spitOutItem` (CAL-201): its stack at its place, which its level
    /// makes as `new ItemEntity` makes one, picked up no sooner than 40 ticks on, thrown by it.
    Spat(Tossed)
    /// A fox's berries picked at x, y, z, `FoxEatBerriesGoal.onReachedTarget` (CAL-201): from a
    /// sweet berry bush, so many dropped and the bush set to age 1, `pickSweetBerries`; or where the
    /// count's -1, cave vines' glow berries, `CaveVines.use`, which its level does.
    FoxBerries((i32, i32, i32, i32))
    Picked((i32, i32))
    /// What a villager throws to another, which its level makes, its motion as it's thrown; and
    /// its composter at a place set to a state, `setBlockAndUpdate`, ticked 20 on where a layer
    /// filled it to 7, `addLayer` (CAL-160).
    Tossed(Tossed)
    /// A piglin's barter, which its level rolls and throws (CAL-200).
    Barter(Barter)
    /// A piglin's hunt, `StartHuntingHoglin`, which its level tells the other piglins of (CAL-200).
    Hunt(Hunt)
    /// A mob boarding the entity, `startRiding`, as `Mount` has it, which its level does then and
    /// there (CAL-200).
    Mount(i32)
    /// A mob getting off the entity it rides, `stopRiding` (CAL-200).
    Dismount(i32)
    Composted((i32, i32, i32, u32, bool))
    /// An arrow's hits on the entities its way met this step, the nearest first, which its level
    /// deals before its tick goes on (CAL-159).
    Shot(List<ArrowHit>)
    /// The block an arrow struck, what it does of it, `onProjectileHit`, which its level deals
    /// before the arrow lands (CAL-159).
    Struck(BlockStruck)
    /// What a thrown potion hit, which its level splashes, `onHit`, before its removal's sent
    /// (D527).
    Splashed(Splash)
    /// What an ender pearl hit, which its level deals, its owner taken there, `onHit`, before its
    /// removal's sent (D579).
    Pearled(PearlHit)
    /// What a snowball hit, which its level deals, `onHit`, before its removal's sent (CAL-201).
    Snowballed(PearlHit)
    /// What an egg hit, as a snowball's, with how many chickens it hatches, its turn and its
    /// stack, which its level deals, `ThrownEgg.onHit` (CAL-214).
    Egged((PearlHit, i32, f32, Tag))
    /// What a bottle o' enchanting hit, as a snowball's, with how much experience it lets out,
    /// the way it's thrown, and whether it's silent, which its level deals,
    /// `ThrownExperienceBottle.onHit` (CAL-214).
    Bottled((PearlHit, i32, (f64, f64, f64), bool))
    /// What a llama's spit hit, `LlamaSpit.onHitEntity`, which its level hurts by 1, the spit
    /// going on (CAL-201).
    SpitHit(PearlHit)
    /// A firework rocket's burst, `FireworkRocketEntity.explode`, which its level sends and deals
    /// before its removal's sent (CAL-214).
    Burst(RocketBurst)
    /// A gliding player's motion as a firework rocket stuck to them boosts it, by their ID, which
    /// their level sets, `setDeltaMovement` (CAL-214).
    Boosted((i32, f64, f64, f64))
    /// What a dragon fireball hit, which its level deals, its cloud left there, `onHit`, before
    /// its removal's sent (D618).
    Fireballed(FireballHit)
    /// What an area effect cloud's pass doses, which its level gives them, before its removal's
    /// sent where it went (D529).
    Dosed(Dose)
    /// The block an end crystal in a level with a dragon fight is in, which its level sets alight
    /// where it's air, `BaseFireBlock.getState` (D589).
    Kindled((i32, i32, i32))
    /// A spear's hits on what its use met this tick, `damageEntities`, which its level deals
    /// before the user's tick goes on (CAL-159).
    Stabbed(List<Stab>)
    /// Experience its level gives where it is, so much of it, `ExperienceOrb.award`; and a level
    /// event every player's sent, `globalLevelEvent`: its kind, the block and its data, as an
    /// ender dragon's death has them (D608).
    Awarded((f64, f64, f64, i32))
    Global((i32, i32, i32, i32, i32))
    /// Primed TNT's explosion as its fuse runs out, which its level makes, `PrimedTnt.explode`
    /// (CAL-182).
    Blew(Blast)
    /// A creeper's explosion as its fuse runs out, which its level makes before its tick goes on,
    /// `Creeper.explodeCreeper` (CAL-182).
    Exploded(Creep)
    /// What its effects do as it's taken out killed, `triggerOnDeathMobEffects` (CAL-182).
    Removed(Removed)
}

/// A creeper's explosion (CAL-182): where it is, which is where it explodes; its radius, twice as
