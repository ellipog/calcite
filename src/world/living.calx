    pub this: LootEntity? = none
    pub equipment: List<Tag> = List<Tag>()
    /// What drops before all else, loot or not: a fox's mouth's, `Fox.dropAllDeathLoot` (CAL-201).
    pub first: List<Tag> = List<Tag>()
    pub carried: u32? = none
    /// What its own inventory drops after the rest, `dropEquipment`, as a donkey's chest's slots
