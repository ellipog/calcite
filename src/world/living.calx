/// A spear's `KineticWeapon`, as the component has it (CAL-159): how long an entity it hit is
/// spared another, `contactCooldownTicks`; the ticks its use waits before it hits, `delayTicks`;
/// what its hits must be for each of what they do, `dismountConditions`, `knockbackConditions`
/// and `damageConditions`; and what its speed's damage is multiplied by, `damageMultiplier`.
pub struct Kinetic {
    pub contact_cooldown: i32 = 10
    pub delay: i32 = 0
    pub dismount: KineticCondition? = none
    pub knockback: KineticCondition? = none
    pub damage: KineticCondition? = none
    pub multiplier: f32 = 1.0f32
}

/// A `KineticWeapon.Condition` (CAL-159): within so many ticks of its use's delay, the user at so
/// many blocks a second at least along its look, and so many more than what it hits.
pub struct KineticCondition {
    pub max_ticks: i32
    pub min_speed: f32 = 0.0f32
    pub min_relative: f32 = 0.0f32
}

impl KineticCondition {
    /// `test` of a hit `ticks` past the use's delay, the user going `speed` along its look and
    /// `relative` more than what it hit, times `factor`, a mob's 0.2.
    pub fn test(self, ticks: i32, speed: f64, relative: f64, factor: f64) -> bool {
        return ticks <= self.max_ticks and speed >= f64(self.min_speed) * factor and relative >= f64(self.min_relative) * factor
    }
}

/// A weapon's `AttackRange`, as the component has it, for a mob (CAL-159): how near and how far
/// it reaches, each times its `mobFactor`, `effectiveMinRange` and `effectiveMaxRange`, and the
/// margin it hits within.
pub struct Reach {
    pub least: f64
    pub most: f64
    pub margin: f64
}

/// What a living entity's use of a spear asks of its level this tick, `damageEntities` (CAL-159):
/// the ticks it's used it past the delay; its eyes; its look, `getLookAngle`, and its head's,
/// `getHeadLookAngle`; its speed in blocks a second, `getMotion`, and its motion,
/// `getKnownMovement`; its reach with the spear; the spear's component; and its own attack
/// damage, the attribute's base value.
pub struct StabDue {
    pub ticks: i32
    pub eye: (f64, f64, f64)
    pub look: (f64, f64, f64)
    pub head_look: (f64, f64, f64)
    pub speed: (f64, f64, f64)
    pub movement: (f64, f64, f64)
    pub reach: Reach
    pub kinetic: Kinetic
    pub base_damage: f64
}

/// A spear's hit on an entity its use met, `stabAttack`, which its level deals (CAL-159): the
/// entity's ID, whether it's a player, the damage, and whether it hurts, knocks back and
/// dismounts.
pub struct Stab {
    pub target: i32
    pub player: bool
    pub damage: f32
    pub hurts: bool
    pub knocks: bool
    pub dismounts: bool
}

/// A spear's `KineticWeapon` of the component `tag`, as its codec reads it, its defaults where
/// it says nothing (CAL-159).
pub fn kinetic_of(tag: Tag) -> Kinetic {
    var k = Kinetic()
    let Tag.Compound(c) = tag else return k
    k.contact_cooldown = int_or(c, "contact_cooldown_ticks", 10)
    k.delay = int_or(c, "delay_ticks", 0)
    k.dismount = condition_of(c, "dismount_conditions")
    k.knockback = condition_of(c, "knockback_conditions")
    k.damage = condition_of(c, "damage_conditions")
    k.multiplier = float_or(c, "damage_multiplier", 1.0f32)
    return k
}

// The `KineticWeapon.Condition` saved as `key`, or none.
fn condition_of(c: JavaHashMap<String, Tag>, key: str) -> KineticCondition? {
    if not c.contains(key) {
        return none
    }
    let Tag.Compound(d) = c[key].copy() else return none
    return some(KineticCondition { max_ticks: int_or(d, "max_duration_ticks", 0), min_speed: float_or(d, "min_speed", 0.0f32), min_relative: float_or(d, "min_relative_speed", 0.0f32) })
}

/// A mob's reach with a weapon whose `attack_range` component is `tag`, as its codec reads it,
/// its defaults where it says nothing, or where there's none, which no spear lacks (CAL-159).
/// `wasRecentlyStabbed` of the entity `id` at the game time `now` within `cooldown` ticks among
/// those a use of a spear keeps as hit, `kept`, `recentKineticEnemies`, a mob's or a player's,
/// then `rememberStabbedEntity` (CAL-159, CAL-214): whether it was hit too lately to be hit again;
/// where it wasn't, it's kept as hit now, where the use keeps any.
pub fn stabbed_lately_in(kept: mut List<(i32, i64)>?, id: i32, now: i64, cooldown: i32) -> bool {
    var held = kept.take() else return false
    for k in 0..held.len() {
        let (e, at) = held[k]
        if e == id {
            if now - at < i64(cooldown) {
                kept = some(held)
                return true
            }
            held[k] = (id, now)
            kept = some(held)
            return false
        }
    }
    held.push((id, now))
    kept = some(held)
    return false
}

/// A weapon's `AttackRange` for a player, of the component `tag`, as the codec reads it
/// (CAL-214): their reach in creative mode its creative one, `effectiveMinRange` and
/// `effectiveMaxRange`, with its margin; where there's none, `defaultFor`, nothing to their
/// entity interaction range, `interaction`, with no margin.
pub fn player_reach_of(tag: Tag?, creative: bool, interaction: f64) -> Reach {
    let Tag.Compound(c) = tag.copy() ?? Tag.End else {
        let most = f64(f32.nearest(interaction))
        return Reach { least: 0.0, most: most, margin: 0.0 }
    }
    let least = if creative { float_or(c, "min_creative_reach", 0.0f32) } else { float_or(c, "min_reach", 0.0f32) }
    let most = if creative { float_or(c, "max_creative_reach", 5.0f32) } else { float_or(c, "max_reach", 3.0f32) }
    return Reach { least: f64(least), most: f64(most), margin: f64(float_or(c, "hitbox_margin", 0.3f32)) }
}

pub fn reach_of(tag: Tag?) -> Reach {
    var least = 0.0f32
    var most = 3.0f32
    var margin = 0.3f32
    var factor = 1.0f32
    if let Tag.Compound(c) = tag.copy() ?? Tag.End {
        least = float_or(c, "min_reach", 0.0f32)
        most = float_or(c, "max_reach", 3.0f32)
        margin = float_or(c, "hitbox_margin", 0.3f32)
        factor = float_or(c, "mob_factor", 1.0f32)
    }
    return Reach { least: f64(least * factor), most: f64(most * factor), margin: f64(margin) }
}

/// `Entity.calculateViewVector` of the pitch `x_rot` and the yaw `y_rot`, through the sine table,
/// each product a float (CAL-159).
pub fn view_vector(x_rot: f32, y_rot: f32) -> (f64, f64, f64) {
    let rx = f64(x_rot * 0.017453292f32)
    let ry = f64(-y_rot * 0.017453292f32)
    let cy = table_cos(ry)
    let sy = table_sin(ry)
    let cx = table_cos(rx)
    let sx = table_sin(rx)
    return (f64(sy * cx), f64(-sx), f64(cy * cx))
}

/// An ender dragon's strike on a player in its tick (D615), or on a mob or an armor stand of its
/// level, `living` (D677): what it struck, by entity ID; where one of its wings knocked them back,
/// `knockBack`, the middle of its body across, which pushes them away from it, else none, its
/// head's or neck's hurt, `hurt`; and whether it sat, so a wing didn't hurt them.
pub struct Beat {
    pub player: i32
    pub from: (f64, f64)?
    pub sitting: bool
    pub living: bool = false
}

/// What the block a living entity stands on does to it that it can't do itself, `stepOn` (D431):
/// nothing; magma's burn, 1 of `hot_floor`, which its own hurt deals; redstone ore at its place,
/// lit by its level; or what Calcite doesn't do yet, to be said.
pub enum Stepped {
    Nothing
    Magma
    Ore((i32, i32, i32))
    /// Turtle eggs at a place, stepped on not carefully, which may break (CAL-172).
    Egg((i32, i32, i32))
    Missing(String)
}

