/// A living entity, as vanilla's `LivingEntity` has it and moves it (CAL-155): what every entity
/// has (`world.body`), its attributes as its type's `DefaultAttributes` supplies them
/// (`world.attributes`), its synced data (`world.entity_data`), its health, and its head's and
/// body's turns; and how it moves, `aiStep` and `travel`. Its motion under 0.003 a tick each way
/// is let go; it jumps as it's told to, off the ground, in shallow water or lava, or up through
/// deeper; then it goes through the air, slowed on the ground as the block below it is slippery,
/// `computeModifiedFriction` by its friction modifier, and by the air as its air drag modifier
/// says, falling as its gravity says; through water and lava, slowed as they slow it and held up as
/// they hold it up, `getFluidFallingAdjustedMovement`, and out over an edge it's pushed against;
/// and up and down what's climbable, no faster than 0.15 a tick across or down: a ladder, a vine,
/// scaffolding, or an open trapdoor over a ladder facing its way. What it's told to walk,
/// `xxa`, `yya` and `zza`, turns with it, `moveRelative`.
///
/// Its move is `Entity.move`'s, with a living entity's own steps between: its fluids looked at
/// again, out of water; the dust a block throws up as it lands, `checkFallDamage`; the block's
/// `fallOn`, which plays its fall sounds as `causeFallDamage` plays them where the fall's past its
/// safe distance, with hay, honey, slime, powder snow, beds and pointed dripstone each their own
/// way; and its steps heard as `applyMovementEmissionAndPlaySound` hears them, the block's step
/// sound each block it goes, an amethyst chime on what chimes and a swim in water. Its air comes
/// back 4 a tick out of water, and under it runs out unless it breathes there.
///
/// An armor stand (`ArmorStand`) is the one living entity Calcite runs yet. It has no AI, so it
/// never walks or jumps; it moves only where it has physics, neither a marker nor without gravity;
/// its body turns as it's turned. It's made, loaded and saved as vanilla's is.
///
/// Not in Calcite yet: being hurt, which waits for damage (P6.5), so a fall, a wall, fire,
/// drowning and freezing hurt nothing and nothing dies; effects, kept as it was loaded with;
/// pushing and being pushed, which waits for mobs, as an armor stand pushes only minecarts; what
/// blocks do to it, `applyEffectsFromBlocks`, as for items (CAL-172), and farmland and turtle eggs
/// fallen on; its equipment, kept as it was loaded with, and its custom name, neither sent; and
/// sleeping.
module world.living

import math.mth.{floor, table_cos, table_sin}
import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import std.java.math.{pow}
import world.attributes.{ADD_VALUE, Attributes, Modifier, attribute_id}
import world.block_facts.{fall_sound_names, place_sound_pitches, place_sound_volumes, state_place_sounds, step_sound_names}
import world.body.{Body, BodyFacts, EntitySound, Moved, bool_or, int_or, short_or}
import world.collision.{Aabb, CollisionBlocks}
import world.entity_data.{AIR_SUPPLY, ARMS_FLAG, BODY_POSE, CUSTOM_NAME_VISIBLE, EntityData, FALL_FLYING_FLAG, GLOWING_FLAG, HEAD_POSE, HEALTH, INVISIBLE_FLAG, LEFT_ARM_POSE, LEFT_LEG_POSE, MARKER_FLAG, NO_BASE_PLATE_FLAG, NO_GRAVITY, ON_FIRE_FLAG, RIGHT_ARM_POSE, RIGHT_LEG_POSE, SHARED_FLAGS, SILENT, SMALL_FLAG, STAND_FLAGS, TICKS_FROZEN, Value, armor_stand_data}
import world.movement.{MovementStates, moved}
import worldgen.facts.{BlockSet, Facts}

/// How long it takes to freeze, `getTicksRequiredToFreeze`.
const TICKS_TO_FREEZE: i32 = 140

/// The dust a block throws up where a living entity lands on it, as `checkFallDamage` sends it:
/// the block's state, where, and how many specks, `ParticleTypes.BLOCK` at 0.15 a tick.
pub struct FallDust {
    pub state: u32
    pub x: f64
    pub y: f64
    pub z: f64
    pub count: i32
}

/// What a living entity shows the players near it besides its sounds: the dust it throws up
/// landing, and an entity event, `broadcastEntityEvent`, as 54, honey slid on, and 67, air run out.
pub enum Shown {
    Dust(FallDust)
    Event(i8)
}

/// What living entities read of blocks and attributes: the climbable blocks, those that chime,
/// ladders and powder snow; each state's sound type's step and fall sounds, volume and pitch; and
/// the attributes they move by, by ID.
pub struct LivingFacts {
    /// The blocks `minecraft:climbable` and `minecraft:crystal_sound_blocks` hold.
    pub climbable: BlockSet
    pub crystal: BlockSet
    ladder: u32
    powder_snow: u32
    step_names: List<String>
    fall_names: List<String>
    volumes: List<f32>
    pitches: List<f32>
    state_sounds: List<u32>
    pub max_health: u32
    pub gravity: u32
    pub jump_strength: u32
    pub friction_modifier: u32
    pub air_drag_modifier: u32
    pub water_efficiency: u32
    pub movement_efficiency: u32
    pub safe_fall: u32
    pub fall_multiplier: u32
    pub oxygen_bonus: u32
    pub movement_speed: u32
}

impl LivingFacts {
    /// As `f` has them, its tags those its level loaded.
    pub fn new(f: Facts) -> LivingFacts {
        let ladder = f.block_named(String("minecraft:ladder")) else panic("no ladder block")
        let snow = f.block_named(String("minecraft:powder_snow")) else panic("no powder snow block")
        var steps = List<String>()
        for s in step_sound_names() {
            steps.push(String(s))
        }
        var falls = List<String>()
        for s in fall_sound_names() {
            falls.push(String(s))
        }
        return LivingFacts {
            climbable: f.tag_or_empty(String("minecraft:climbable")),
            crystal: f.tag_or_empty(String("minecraft:crystal_sound_blocks")),
            ladder: ladder,
            powder_snow: snow,
            step_names: steps,
            fall_names: falls,
            volumes: place_sound_volumes(),
            pitches: place_sound_pitches(),
            state_sounds: state_place_sounds(),
            max_health: attribute("max_health"),
            gravity: attribute("gravity"),
            jump_strength: attribute("jump_strength"),
            friction_modifier: attribute("friction_modifier"),
            air_drag_modifier: attribute("air_drag_modifier"),
            water_efficiency: attribute("water_movement_efficiency"),
            movement_efficiency: attribute("movement_efficiency"),
            safe_fall: attribute("safe_fall_distance"),
            fall_multiplier: attribute("fall_damage_multiplier"),
            oxygen_bonus: attribute("oxygen_bonus"),
            movement_speed: attribute("movement_speed"),
        }
    }

    // Whether the state is climbable to a moving entity, `isStateClimbable`: climbable, or powder
    // snow.
    fn climbable_state(self, f: Facts, state: u32) -> bool {
        return f.in_set(state, self.climbable) or f.block(state) == self.powder_snow
    }
}

// The attribute `minecraft:{name}`'s ID.
fn attribute(name: str) -> u32 {
    return attribute_id("minecraft:{name}") ?? panic("no attribute {name}")
}

/// A living entity.
pub struct Living {
    /// What every entity has; its type, by its ID in the entity type registry; its attributes and
    /// its synced values.
    pub body: Body
    pub kind: u32
    pub attributes: Attributes
    pub data: EntityData
    /// Its turns as its tick began, `yRotO` and `xRotO`, and its head's and body's, now and then.
    pub y_rot_o: f32 = 0.0f32
    pub x_rot_o: f32 = 0.0f32
    pub y_head_rot: f32 = 0.0f32
    pub y_head_rot_o: f32 = 0.0f32
    pub y_body_rot: f32 = 0.0f32
    pub y_body_rot_o: f32 = 0.0f32
    /// What it's told to walk, sideways, up and ahead, whether it's told to jump, how long until
    /// it may jump again, and how fast it walks, `getSpeed`.
    pub xxa: f32 = 0.0f32
    pub yya: f32 = 0.0f32
    pub zza: f32 = 0.0f32
    pub jumping: bool = false
    pub no_jump_delay: i32 = 0
    pub speed: f32 = 0.0f32
    /// How much water slows it, `getWaterSlowDown`.
    pub water_slow_down: f32 = 0.8f32
    /// What it's saved with of being hurt: its hurt and death times, its absorption, how long it
    /// can't be hurt, and the impulse it was last given, its grace time and where it was given,
    /// which a fall below it doesn't count.
    pub hurt_time: i32 = 0
    pub death_time: i32 = 0
    pub absorption: f32 = 0.0f32
    pub invulnerable_time: i32 = 0
    pub impulse_grace: i32 = 0
    pub impulse_at: (f64, f64, f64)? = none
    /// The block it last climbed, `lastClimbablePos`.
    pub last_climbable: (i32, i32, i32)? = none
    /// Whether its type breathes under water, `minecraft:can_breathe_under_water`, and is never
    /// hurt by a fall, `minecraft:fall_damage_immune`, and its fall sounds, `getFallSounds`, a
    /// small fall's and a big one's.
    pub breathes_water: bool = false
    pub fall_immune: bool = false
    pub small_fall: String
    pub big_fall: String
    // How far it's gone for its steps, `moveDist` and `flyDist`, and where it next steps.
    move_dist: f32 = 0.0f32
    fly_dist: f32 = 0.0f32
    next_step: f32 = 1.0f32
    // When it last chimed on amethyst, and how loud it's been chiming.
    chimed_at: i32 = 0
    chime: f32 = 0.0f32
    /// What it was loaded with that Calcite doesn't run, by the keys it's saved under: its
    /// effects, equipment, sleeping place, who last hurt it and its locator bar icon.
    pub kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    /// What it showed since that was last taken, in the order it showed it, and how many of the
    /// sounds of its tick it had played as it showed each, for the server to send among them.
    pub shown: List<Shown> = List<Shown>()
    pub shown_after: List<usize> = List<usize>()
}

impl Living {
    /// A living entity of the type `kind` at x, y, z, `width` across and `height` high with its eyes
    /// `eyes` up, with `data` its synced values as its type defines them and its own random seeded
    /// `seed`, as `LivingEntity`'s constructor makes it: `Entity`'s, its UUID drawn from its random;
    /// its attributes; its health its most; and its turn drawn from its random, `nextFloat` of a
    /// turn's radians as degrees, its head turned with it.
    pub fn made(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64, width: f32, height: f32, eyes: f32, data: own EntityData) -> Living {
        var body = Body.made(id, seed, x, y, z, width, height, eyes, 0.0)
        body.alive = true
        var l = Living { body: body, kind: kind, attributes: Attributes.of_type(kind), data: data, small_fall: String("entity.generic.small_fall"), big_fall: String("entity.generic.big_fall") }
        l.refresh_body(lf)
        let most = l.max_health(lf)
        l.set_health(lf, most)
        let turn = l.body.random.next_float() * 6.2831855f32
        l.body.y_rot = turn
        l.y_head_rot = turn
        return l
    }

    /// Its body's gravity, air drag and movement efficiency, from its attributes as they are now.
    pub fn refresh_body(mut self, lf: LivingFacts) {
        self.body.gravity = self.attributes.value(lf.gravity)
        self.body.air_drag = modified_friction(0.98f32, f32.nearest(self.attributes.value(lf.air_drag_modifier)))
        self.body.efficiency = f32.nearest(self.attributes.value(lf.movement_efficiency))
    }

    /// Its health, `getHealth`, and its most, `getMaxHealth`.
    pub fn health(self) -> f32 {
        return self.data.float(HEALTH)
    }

    pub fn max_health(self, lf: LivingFacts) -> f32 {
        return f32.nearest(self.attributes.value(lf.max_health))
    }

    /// `setHealth`: its health, kept within 0 and its most.
    pub fn set_health(mut self, lf: LivingFacts, health: f32) {
        let most = self.max_health(lf)
        let kept = if health < 0.0f32 { 0.0f32 } else if health > most { most } else { health }
        self.data.set(HEALTH, Value.Float(kept))
    }

    /// `isAlive`: not gone and with health left.
    pub fn alive(self) -> bool {
        return not self.body.removed and self.health() > 0.0f32
    }

    /// Its air, `getAirSupply`.
    pub fn air(self) -> i32 {
        return self.data.number(AIR_SUPPLY)
    }

    // `setAirSupply`, kept with its body for its save.
    fn set_air(mut self, air: i32) {
        self.data.set(AIR_SUPPLY, Value.Number(air))
        self.body.air = air
    }

    /// Whether it's silent, `isSilent`, which plays none of its sounds.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    // `Entity.playSound`: `sound` where it is, unless it's silent.
    fn play(self, sounds: mut List<EntitySound>, sound: own String, volume: f32, pitch: f32) {
        if not self.silent() {
            sounds.push(EntitySound { sound: sound, x: self.body.x, y: self.body.y, z: self.body.z, volume: volume, pitch: pitch })
        }
    }

    // Its body's `updateFluidInteraction`, which splashes into water, unheard where it's silent.
    fn update_fluids<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let heard = sounds.len()
        _ = self.body.update_fluids(f, t, blocks, fast_lava, true, mut sounds)
        if self.silent() {
            sounds.truncate(heard)
        }
    }

    /// `commonTick`, then `LivingEntity.baseTick`, in a level whose floor is `min_y`, where lava's
    /// fast if `fast_lava`: its turns and place as its tick begins, its count; then `Entity`'s, its
    /// portal cooldown, its fluids, its fire, lava halving its fall, below the level, and its
    /// first tick over; then its air, out of water coming back, in it running out where it can't
    /// breathe there, at -20 given back as 0 with event 67; and its hurt time, and its head's and
    /// body's turns as they were.
    pub fn base_tick<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.invulnerable_time > 0 {
            self.invulnerable_time -= 1
        }
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.y_rot_o = self.body.y_rot
        self.x_rot_o = self.body.x_rot
        self.body.tick_count += 1
        self.refresh_body(lf)
        // `Entity.baseTick`. Fire hurts every 20 ticks out of lava, which waits for damage.
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        self.update_fluids(f, t, blocks, fast_lava, mut sounds)
        if self.body.fire > 0 {
            self.body.fire -= 1
        }
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let visual = self.body.extras.contains("HasVisualFire")
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, self.body.fire > 0 or visual)
        self.body.first_tick = false
        // Being in a wall and drowning hurt, which waits for damage.
        if self.alive() {
            let eye = self.body.y + f64(self.body.eyes)
            let at_eyes = blocks.collision_state(floor(self.body.x), floor(eye), floor(self.body.z)) ?? 0
            if self.body.water_eyes and f.block(at_eyes) != t.bubble_column {
                if not self.breathes_water {
                    let now = self.air()
                    let breath = self.less_air(lf, now)
                    self.set_air(breath)
                    if self.air() <= -20 {
                        self.set_air(0)
                        self.show(Shown.Event(67i8), sounds.len())
                    }
                } else if self.air() < 300 {
                    let more = (self.air() + 4).min(300)
                    self.set_air(more)
                }
            } else if self.air() < 300 {
                let more = (self.air() + 4).min(300)
                self.set_air(more)
            }
        }
        if self.hurt_time > 0 {
            self.hurt_time -= 1
        }
        self.y_head_rot_o = self.y_head_rot
        self.y_body_rot_o = self.y_body_rot
    }

    // `decreaseAirSupply`: a breath less, unless its oxygen bonus spares it, a draw from its
    // random where it has any. Asking for the bonus makes its instance.
    fn less_air(mut self, lf: LivingFacts, air: i32) -> i32 {
        _ = self.attributes.instance(lf.oxygen_bonus)
        let bonus = self.attributes.value(lf.oxygen_bonus)
        if bonus > 0.0 and self.body.random.next_double() >= 1.0 / (bonus + 1.0) {
            return air
        }
        return air - 1
    }

    /// `aiStep`, where it moves at all, `isEffectiveAi`, as `effective` says: its jump delay; its
    /// motion under 0.003 each way let go; what it's told to walk slowed; its jump; its travel
    /// where it's effective; then its frozen ticks thawing 2 a tick, and the powder snow's slowing
    /// taken off and put back as they say, which makes its speed's instance.
    pub fn ai_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, effective: bool, sounds: mut List<EntitySound>) {
        if self.no_jump_delay > 0 {
            self.no_jump_delay -= 1
        }
        if self.body.vx.abs() < 0.003 {
            self.body.vx = 0.0
        }
        if self.body.vz.abs() < 0.003 {
            self.body.vz = 0.0
        }
        if self.body.vy.abs() < 0.003 {
            self.body.vy = 0.0
        }
        self.xxa = self.xxa * 0.98f32
        self.zza = self.zza * 0.98f32
        if not (self.health() > 0.0f32) {
            self.jumping = false
            self.xxa = 0.0f32
            self.zza = 0.0f32
        }
        if self.jumping {
            self.jump(lf, f, m, t, blocks)
        } else {
            self.no_jump_delay = 0
        }
        if effective {
            self.travel(lf, f, m, t, blocks, fast_lava, mut sounds)
        }
        // `applyEffectsFromBlocks` isn't in Calcite (CAL-172), so it's never in powder snow.
        let frozen = self.data.number(TICKS_FROZEN)
        let thawed = if frozen - 2 > 0 { frozen - 2 } else { 0 }
        self.data.set(TICKS_FROZEN, Value.Number(thawed))
        let snow = powder_snow_id()
        self.attributes.take_off(lf.movement_speed, snow.copy())
        if thawed > 0 {
            let (ox, oy, oz) = self.body.on_pos(f, t, blocks, 0.2f32)
            if not f.is_air(blocks.collision_state(ox, oy, oz) ?? 0) {
                let part = f32.nearest(f64(thawed.min(TICKS_TO_FREEZE))) / f32.nearest(f64(TICKS_TO_FREEZE))
                self.attributes.replace(lf.movement_speed, Modifier { id: snow, amount: f64(-0.05f32 * part), operation: ADD_VALUE })
            }
        }
    }

    // The jump in `aiStep`, as it's told to jump: up through water or lava deeper than it jumps
    // out of, 0.04 a tick; else off the ground, or out of shallow water, every 10 ticks at most.
    fn jump<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        let lava = self.body.in_lava()
        let height = if lava { self.body.lava } else { self.body.water }
        let wet = self.body.in_water and height > 0.0
        let threshold = self.jump_threshold()
        if not wet or (self.body.on_ground and not (height > threshold)) {
            if not lava or (self.body.on_ground and self.body.lava <= threshold) {
                if (self.body.on_ground or (wet and height <= threshold)) and self.no_jump_delay == 0 {
                    self.jump_from_ground(lf, f, m, t, blocks)
                    self.no_jump_delay = 10
                }
            } else {
                self.body.vx = self.body.vx + 0.0
                self.body.vy = self.body.vy + f64(0.04f32)
                self.body.vz = self.body.vz + 0.0
            }
        } else {
            self.body.vx = self.body.vx + 0.0
            self.body.vy = self.body.vy + f64(0.04f32)
            self.body.vz = self.body.vz + 0.0
        }
    }

    // `jumpFromGround`: up as fast as it jumps, `getJumpPower`, its jump strength by the jump
    // factor of the block it's in, or of the one below where that's 1, unless it's going up
    // faster already; its place then sent.
    fn jump_from_ground<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        let (bx, by, bz) = self.body.block()
        let here = m.jump_factor(f.block(blocks.collision_state(bx, by, bz) ?? 0))
        let (px, py, pz) = self.body.on_pos(f, t, blocks, 0.500001f32)
        let below = m.jump_factor(f.block(blocks.collision_state(px, py, pz) ?? 0))
        let factor = if f64(here) == 1.0 { below } else { here }
        let power = f32.nearest(self.attributes.value(lf.jump_strength)) * 1.0f32 * factor + 0.0f32
        if not (power <= 1.0e-5f32) {
            let up = f64(power)
            self.body.vy = if up > self.body.vy { up } else { self.body.vy }
            self.body.needs_sync = true
        }
    }

    // `getFluidJumpThreshold`: 0.4, or none where its eyes are lower than that.
    fn jump_threshold(self) -> f64 {
        return if f64(self.body.eyes) < 0.4 { 0.0 } else { 0.4 }
    }

    /// `travel`: through water or lava where it's in either, else through the air.
    pub fn travel<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        if self.body.in_water or self.body.in_lava() {
            let falling = self.body.vy <= 0.0
            let old_y = self.body.y
            let gravity = self.body.gravity_now()
            if self.body.in_water {
                self.travel_in_water(lf, f, m, t, blocks, fast_lava, gravity, falling, old_y, mut sounds)
            } else {
                self.travel_in_lava(lf, f, m, t, blocks, fast_lava, gravity, falling, old_y, mut sounds)
            }
        } else {
            self.travel_in_air(lf, f, m, t, blocks, fast_lava, mut sounds)
        }
    }

    // `travelInAir`: on the ground, as slippery as the block below it, `computeModifiedFriction`
    // by its friction modifier, it walks as fast as that lets it, then moves, up 0.2 a tick where it
    // climbs into a wall or jumps; it falls as its gravity says, and is slowed by the air and that
    // block.
    fn travel_in_air<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let (px, py, pz) = self.body.on_pos(f, t, blocks, 0.500001f32)
        let friction = if self.body.on_ground {
            modified_friction(m.friction(f.block(blocks.collision_state(px, py, pz) ?? 0)), f32.nearest(self.attributes.value(lf.friction_modifier)))
        } else {
            1.0f32
        }
        // `handleRelativeFrictionAndCalculateMovement`.
        let walk = self.friction_speed(friction)
        self.move_relative(walk)
        self.climb_clamp(lf, f, blocks)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        let mx = self.body.vx
        var my = self.body.vy
        let mz = self.body.vz
        if (self.body.horizontal_collision or self.jumping) and self.on_climbable(lf, f, blocks) {
            my = 0.2
        }
        my = my - self.body.gravity_now()
        let drag = f32.nearest(self.attributes.value(lf.air_drag_modifier))
        let in_air = modified_friction(0.91f32, drag)
        let across = friction * in_air
        let up = modified_friction(0.98f32, drag)
        self.body.vx = mx * f64(across)
        self.body.vy = my * f64(up)
        self.body.vz = mz * f64(across)
    }

    // `travelInWater`: slowed by the water as its movement efficiency lets it, half that off the
    // ground, it swims at 0.02 a tick, moves, up 0.2 a tick where it climbs into a wall, is slowed
    // 0.8 up and down, held up as water holds it, and jumps out over an edge it's pushed against.
    fn travel_in_water<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, gravity: f64, falling: bool, old_y: f64, sounds: mut List<EntitySound>) {
        var slow = self.water_slow_down
        var swim = 0.02f32
        var walker = f32.nearest(self.attributes.value(lf.water_efficiency))
        if not self.body.on_ground {
            walker = walker * 0.5f32
        }
        if walker > 0.0f32 {
            slow = slow + (0.54600006f32 - slow) * walker
            swim = swim + (self.speed - swim) * walker
        }
        self.move_relative(swim)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        var mx = self.body.vx
        var my = self.body.vy
        var mz = self.body.vz
        if self.body.horizontal_collision and self.on_climbable(lf, f, blocks) {
            my = 0.2
        }
        mx = mx * f64(slow)
        my = my * f64(0.8f32)
        mz = mz * f64(slow)
        self.body.vx = mx
        self.body.vy = fluid_falling(gravity, falling, my)
        self.body.vz = mz
        self.jump_out_of_fluid(f, m, blocks, old_y)
    }

    // `travelInLava`: it swims at 0.02 a tick, moves, and is slowed by half, 0.8 up and down where
    // the lava's shallow, held up as lava holds it, then falls a quarter of its gravity and jumps
    // out over an edge it's pushed against.
    fn travel_in_lava<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, gravity: f64, falling: bool, old_y: f64, sounds: mut List<EntitySound>) {
        self.move_relative(0.02f32)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        if self.body.lava <= self.jump_threshold() {
            self.body.vx = self.body.vx * 0.5
            self.body.vy = fluid_falling(gravity, falling, self.body.vy * f64(0.8f32))
            self.body.vz = self.body.vz * 0.5
        } else {
            self.body.vx = self.body.vx * 0.5
            self.body.vy = self.body.vy * 0.5
            self.body.vz = self.body.vz * 0.5
        }
        if gravity != 0.0 {
            self.body.vx = self.body.vx + 0.0
            self.body.vy = self.body.vy + -gravity / 4.0
            self.body.vz = self.body.vz + 0.0
        }
        self.jump_out_of_fluid(f, m, blocks, old_y)
    }

    // `jumpOutOfFluid`: pushed against something across, up at 0.3 a tick where 0.6 up from where
    // it began the tick there's neither a block nor a fluid in its way.
    fn jump_out_of_fluid<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, old_y: f64) {
        if not self.body.horizontal_collision {
            return
        }
        let up = self.body.vy + f64(0.6f32) - self.body.y + old_y
        let b = moved(self.body.bounding_box(), self.body.vx, up, self.body.vz)
        if m.colliders(f, blocks, b, self.body.mover()).is_empty() and not any_liquid(f, blocks, b) {
            self.body.vy = f64(0.3f32)
        }
    }

    // `getFrictionInfluencedSpeed`: on the ground, as fast as it walks, faster on what's more
    // slippery than 0.6, the less it grips; in the air, 0.02.
    fn friction_speed(self, friction: f32) -> f32 {
        if not self.body.on_ground {
            return 0.02f32
        }
        if f64(friction) > 0.6 {
            return self.speed * (0.21600002f32 / (friction * friction * friction))
        }
        return self.speed
    }

    // `moveRelative`: what it's told to walk, as long as 1 at most, at `speed`, turned as it's
    // turned, added to its motion.
    fn move_relative(mut self, speed: f32) {
        let ix = f64(self.xxa)
        let iy = f64(self.yya)
        let iz = f64(self.zza)
        let length = ix * ix + iy * iy + iz * iz
        var ax = 0.0
        var ay = 0.0
        var az = 0.0
        if not (length < 1.0e-7) {
            var nx = ix
            var ny = iy
            var nz = iz
            if length > 1.0 {
                let d = (ix * ix + iy * iy + iz * iz).sqrt()
                if d < f64(1.0e-5f32) {
                    nx = 0.0
                    ny = 0.0
                    nz = 0.0
                } else {
                    nx = ix / d
                    ny = iy / d
                    nz = iz / d
                }
            }
            let s = f64(speed)
            let mx = nx * s
            let my = ny * s
            let mz = nz * s
            let turn = f64(self.body.y_rot * 0.017453292f32)
            let sin = f64(table_sin(turn))
            let cos = f64(table_cos(turn))
            ax = mx * cos - mz * sin
            ay = my
            az = mz * cos + mx * sin
        }
        self.body.vx = self.body.vx + ax
        self.body.vy = self.body.vy + ay
        self.body.vz = self.body.vz + az
    }

    /// `onClimbable`: whether the block it's in is climbable, or an open trapdoor over a ladder
    /// facing its way, which it then last climbed.
    pub fn on_climbable<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        let (bx, by, bz) = self.body.block()
        let state = blocks.collision_state(bx, by, bz) ?? 0
        var climbs = f.in_set(state, lf.climbable)
        if not climbs and f.is_a(f.block(state), String("TrapDoorBlock")) and f.get_bool(state, String("open")) {
            let below = blocks.collision_state(bx, by - 1, bz) ?? 0
            let facing = f.get_name(state, String("facing")) ?? String()
            climbs = f.block(below) == lf.ladder and (f.get_name(below, String("facing")) ?? String()) == facing
        }
        if climbs {
            self.last_climbable = some((bx, by, bz))
        }
        return climbs
    }

    // `handleOnClimbable`: on what's climbable, its fall forgotten, and no faster than 0.15 a tick
    // across or down.
    fn climb_clamp<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) {
        if not self.on_climbable(lf, f, blocks) {
            return
        }
        self.body.fall = 0.0
        let most = f64(0.15f32)
        self.body.vx = clamp(self.body.vx, -most, most)
        self.body.vz = clamp(self.body.vz, -most, most)
        if self.body.vy < -most {
            self.body.vy = -most
        }
    }

    // `Entity.move` by dx, dy, dz for itself, with a living entity's `checkFallDamage`: its
    // fluids again out of water, its dust thrown up as it lands, the block's `fallOn`, and its
    // last climbed block forgotten on the ground; then its bounce, its steps and the block's
    // slowing.
    fn move_self<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64, fast_lava: bool, sounds: mut List<EntitySound>) {
        let went = self.body.collide_move(f, m, t, blocks, dx, dy, dz) else return
        if not self.body.in_water {
            self.update_fluids(f, t, blocks, fast_lava, mut sounds)
        }
        if self.body.on_ground and self.body.fall > 0.0 {
            self.throw_dust(lf, f, went, sounds.len())
        }
        if let fell = self.body.fall_check(went.my) {
            self.fall_on(lf, f, m, blocks, went.effect_state, fell, mut sounds)
        }
        if self.body.on_ground {
            self.last_climbable = none
        }
        if self.body.removed {
            return
        }
        self.body.bounce_after(f, m, t, went)
        self.emit(lf, f, t, blocks, went, mut sounds)
        self.body.slow_by_block(f, m, t, blocks)
    }

    // The dust in `checkFallDamage`, landing from a fall past its safe distance on what isn't
    // air: more the further it fell, up to 375, from its place, or from the edge of the block it
    // landed on nearest it where that isn't the one it's over.
    fn throw_dust(mut self, lf: LivingFacts, f: Facts, went: Moved, heard: usize) {
        let power = self.fall_power(lf, self.body.fall).floor()
        let p = if power > 0.0 { power } else { 0.0 }
        if not (p > 0.0) or f.is_air(went.effect_state) {
            return
        }
        var x = self.body.x
        let y = self.body.y
        var z = self.body.z
        let (ex, _, ez) = went.effect
        let (bx, _, bz) = self.body.block()
        if ex != bx or ez != bz {
            let x_off = x - f64(ex) - 0.5
            let z_off = z - f64(ez) - 0.5
            let most = if x_off.abs() > z_off.abs() { x_off.abs() } else { z_off.abs() }
            x = f64(ex) + 0.5 + x_off / most * 0.5
            z = f64(ez) + 0.5 + z_off / most * 0.5
        }
        let scaled = f64(0.2f32) + p / 15.0
        let scale = if scaled < 2.5 { scaled } else { 2.5 }
        self.show(Shown.Dust(FallDust { state: went.effect_state, x: x, y: y, z: z, count: i32.saturate(150.0 * scale) }), heard)
    }

    // Shows `what`, `heard` of its tick's sounds played.
    fn show(mut self, what: own Shown, heard: usize) {
        self.shown.push(what)
        self.shown_after.push(heard)
    }

    // `calculateFallPower`: how far past its safe distance it fell.
    fn fall_power(self, lf: LivingFacts, fell: f64) -> f64 {
        return fell + 1.0e-6 - self.attributes.value(lf.safe_fall)
    }

    // The block's `fallOn`, landing on `state` from `fell` up: hay takes a fifth of its hurt;
    // honey slides, event 54, and takes a fifth; slime takes it all; powder snow plays its fall
    // sound past 4; pointed dripstone pointing up hurts more; beds and shelf mushrooms halve the
    // fall; and the rest pass it on, `causeFallDamage`. Farmland and turtle eggs aren't trampled
    // or broken yet.
    fn fall_on<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, state: u32, fell: f64, sounds: mut List<EntitySound>) {
        let block = f.block(state)
        if f.is_a(block, String("HayBlock")) {
            _ = self.fall_damage(lf, f, blocks, fell, 0.2f32, mut sounds)
        } else if f.is_a(block, String("HoneyBlock")) {
            self.play(mut sounds, String("block.honey_block.slide"), 1.0f32, 1.0f32)
            self.show(Shown.Event(54i8), sounds.len())
            if self.fall_damage(lf, f, blocks, fell, 0.2f32, mut sounds) {
                let (name, volume, pitch) = lf.fall_sound(state)
                self.play(mut sounds, name, volume * 0.5f32, pitch * 0.75f32)
            }
        } else if f.is_a(block, String("SlimeBlock")) {
            _ = self.fall_damage(lf, f, blocks, fell, 0.0f32, mut sounds)
        } else if f.is_a(block, String("PowderSnowBlock")) {
            if not (fell < 4.0) {
                let sound = if fell < 7.0 { self.small_fall.copy() } else { self.big_fall.copy() }
                self.play(mut sounds, sound, 1.0f32, 1.0f32)
            }
        } else if f.is_a(block, String("PointedDripstoneBlock")) and (f.get_name(state, String("vertical_direction")) ?? String()) == String("up") and (f.get_name(state, String("thickness")) ?? String()) == String("tip") {
            _ = self.fall_damage(lf, f, blocks, fell + 2.5, 2.0f32, mut sounds)
        } else {
            let reduced = fell * f64(1.0f32 - m.fall_reduction(block))
            _ = self.fall_damage(lf, f, blocks, reduced, 1.0f32, mut sounds)
        }
    }

    // `LivingEntity.causeFallDamage`: below where it was last given an impulse, only the fall
    // from there; how much it's hurt, `calculateFallDamage`, by its fall damage multiplier; and
    // where it's any, its fall sound, small to 4 and big past, and the block's below it,
    // `playBlockFallSound`. Whether it's hurt; the hurt itself waits for damage.
    fn fall_damage<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, fell: f64, modifier: f32, sounds: mut List<EntitySound>) -> bool {
        var effective = fell
        if let at = self.impulse_at {
            let (_, iy, _) = at
            let from = iy - self.body.y
            effective = if fell < from { fell } else { from }
            if effective <= 0.0 or self.impulse_grace == 0 {
                self.impulse_grace = 0
                self.impulse_at = none
            }
        }
        let damage = if self.fall_immune { 0 } else { floor(self.fall_power(lf, effective) * f64(modifier) * self.attributes.value(lf.fall_multiplier)) }
        if damage <= 0 {
            return false
        }
        self.impulse_grace = 0
        self.impulse_at = none
        let sound = if damage > 4 { self.big_fall.copy() } else { self.small_fall.copy() }
        self.play(mut sounds, sound, 1.0f32, 1.0f32)
        let below = blocks.collision_state(floor(self.body.x), floor(self.body.y - f64(0.2f32)), floor(self.body.z)) ?? 0
        if not self.silent() and not f.is_air(below) {
            let (name, volume, pitch) = lf.fall_sound(below)
            self.play(mut sounds, name, volume * 0.5f32, pitch * 0.75f32)
        }
        return true
    }

    // `applyMovementEmissionAndPlaySound`: how far it's gone, up and down too on what's climbable;
    // past its next step on what isn't air, the step sound of the block it's on, and of the one it
    // stands on where that's another and it's on the ground or climbing; else, in water, a swim.
    fn emit<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, went: Moved, sounds: mut List<EntitySound>) {
        let length = (went.mx * went.mx + went.my * went.my + went.mz * went.mz).sqrt()
        let across = (went.mx * went.mx + went.mz * went.mz).sqrt()
        let gone = f32.nearest(length * f64(0.6f32))
        let gone_across = f32.nearest(across * f64(0.6f32))
        let (sx, sy, sz) = self.body.on_pos(f, t, blocks, 1.0e-5f32)
        let standing = blocks.collision_state(sx, sy, sz) ?? 0
        let climbing = lf.climbable_state(f, standing)
        self.move_dist = self.move_dist + (if climbing { gone } else { gone_across })
        self.fly_dist = self.fly_dist + gone
        if not (self.move_dist > self.next_step) or f.is_air(standing) {
            return
        }
        let (ex, ey, ez) = went.effect
        let same = sx == ex and sy == ey and sz == ez
        var stepped = self.step_on(lf, f, went.effect_state, true, mut sounds)
        if not same {
            stepped = self.step_on(lf, f, standing, false, mut sounds) or stepped
        }
        if stepped {
            self.next_step = f32.nearest(f64(i32.saturate(f64(self.move_dist)) + 1))
        } else if self.body.in_water {
            self.next_step = f32.nearest(f64(i32.saturate(f64(self.move_dist)) + 1))
            let fast = f32.nearest((self.body.vx * self.body.vx * f64(0.2f32) + self.body.vy * self.body.vy + self.body.vz * self.body.vz * f64(0.2f32)).sqrt()) * 0.35f32
            let volume = if fast < 1.0f32 { fast } else { 1.0f32 }
            let a = self.body.random.next_float()
            let b = self.body.random.next_float()
            self.play(mut sounds, String("entity.generic.swim"), volume, 1.0f32 + (a - b) * 0.4f32)
        }
    }

    // `vibrationAndSoundEffectsFromBlock` on `state`: on the ground or climbing it, its step
    // sound where it's `heard`, and an amethyst chime; whether it stepped.
    fn step_on(mut self, lf: LivingFacts, f: Facts, state: u32, heard: bool, sounds: mut List<EntitySound>) -> bool {
        if f.is_air(state) {
            return false
        }
        if not (self.body.on_ground or lf.climbable_state(f, state)) {
            return false
        }
        if heard {
            let (name, volume, pitch) = lf.step_sound(state)
            self.play(mut sounds, name, volume * 0.15f32, pitch)
            if f.in_set(state, lf.crystal) and self.body.tick_count >= self.chimed_at + 20 {
                self.chime = self.chime * f32.nearest(pow(0.997, f64(self.body.tick_count - self.chimed_at)))
                self.chime = (self.chime + 0.07f32).min(1.0f32)
                let pitch_drawn = 0.5f32 + self.chime * self.body.random.next_float() * 1.2f32
                let loud = 0.1f32 + self.chime * 1.2f32
                self.play(mut sounds, String("block.amethyst_block.chime"), loud, pitch_drawn)
                self.chimed_at = self.body.tick_count
            }
        }
        return true
    }

    /// The end of `LivingEntity.tick`, after its head's turned: each old turn kept within half a
    /// turn of the new, and its impulse's grace time counted down.
    pub fn tick_end(mut self) {
        while self.body.y_rot - self.y_rot_o < -180.0f32 {
            self.y_rot_o = self.y_rot_o - 360.0f32
        }
        while self.body.y_rot - self.y_rot_o >= 180.0f32 {
            self.y_rot_o = self.y_rot_o + 360.0f32
        }
        while self.y_body_rot - self.y_body_rot_o < -180.0f32 {
            self.y_body_rot_o = self.y_body_rot_o - 360.0f32
        }
        while self.y_body_rot - self.y_body_rot_o >= 180.0f32 {
            self.y_body_rot_o = self.y_body_rot_o + 360.0f32
        }
        while self.body.x_rot - self.x_rot_o < -180.0f32 {
            self.x_rot_o = self.x_rot_o - 360.0f32
        }
        while self.body.x_rot - self.x_rot_o >= 180.0f32 {
            self.x_rot_o = self.x_rot_o + 360.0f32
        }
        while self.y_head_rot - self.y_head_rot_o < -180.0f32 {
            self.y_head_rot_o = self.y_head_rot_o - 360.0f32
        }
        while self.y_head_rot - self.y_head_rot_o >= 180.0f32 {
            self.y_head_rot_o = self.y_head_rot_o + 360.0f32
        }
        if self.impulse_grace > 0 {
            self.impulse_grace -= 1
        }
    }

    /// What `Entity.load` and `LivingEntity.readAdditionalSaveData` read of `tag` into it: what
    /// every entity reads, `world.body`'s, then into its values its air, name's showing, silence,
    /// gravity, glowing and frozen ticks; its absorption, attributes, health within its most, hurt
    /// and death times, fall flying, and its impulse's grace and place; and what it keeps as it
    /// was. False where it's somewhere that isn't a number, logged in `lines`.
    pub fn load_from(mut self, lf: LivingFacts, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.set_air(int_or(tag, "Air", 300))
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.invulnerable_time = int_or(tag, "invulnerable_time", 0)
        _ = self.body.extras.remove("invulnerable_time")
        _ = self.body.extras.remove("TicksFrozen")
        self.absorption = float_or(tag, "AbsorptionAmount", 0.0f32)
        if tag.contains("attributes") {
            self.attributes.apply(tag["attributes"].copy())
        }
        let most = self.max_health(lf)
        self.set_health(lf, float_or(tag, "Health", most))
        self.hurt_time = i32(short_or(tag, "HurtTime", 0i16))
        self.death_time = i32(short_or(tag, "DeathTime", 0i16))
        self.data.set_flag(SHARED_FLAGS, FALL_FLYING_FLAG, bool_or(tag, "FallFlying"))
        self.impulse_grace = int_or(tag, "current_impulse_context_reset_grace_time", 0)
        self.impulse_at = vec3_of(tag, "current_explosion_impact_pos")
        for key in ["active_effects", "sleeping_pos", "last_hurt_by_player", "last_hurt_by_player_memory_time", "last_hurt_by_mob", "ticks_since_last_hurt_by_mob", "equipment", "locator_bar_icon"] {
            if tag.contains(key) {
                self.kept.insert(String(key), tag[key].copy())
            }
        }
        self.y_rot_o = self.body.y_rot
        self.x_rot_o = self.body.x_rot
        self.refresh_body(lf)
        return true
    }

    /// What `saveAsPassenger` saves of it before its type's own, as `kind`: what every entity
    /// saves, `world.body`'s, its air and frozen ticks from its values; then
    /// `LivingEntity.addAdditionalSaveData`'s, in the order vanilla puts them, its health, hurt and
    /// death times, absorption, impulse, attributes, fall flying and an empty brain, with what it
    /// keeps where vanilla puts it.
    pub fn save_into(self, t: mut JavaHashMap<String, Tag>, kind: str) {
        var body = self.body.copy()
        body.air = self.air()
        if self.invulnerable_time > 0 {
            body.extras.insert(String("invulnerable_time"), Tag.Int(self.invulnerable_time))
        }
        let frozen = self.data.number(TICKS_FROZEN)
        if frozen > 0 {
            body.extras.insert(String("TicksFrozen"), Tag.Int(frozen))
        }
        body.save_into(mut t, kind)
        t.insert(String("Health"), Tag.Float(self.health()))
        t.insert(String("HurtTime"), Tag.Short(i16.wrap(self.hurt_time)))
        t.insert(String("DeathTime"), Tag.Short(i16.wrap(self.death_time)))
        t.insert(String("AbsorptionAmount"), Tag.Float(self.absorption))
        t.insert(String("current_impulse_context_reset_grace_time"), Tag.Int(self.impulse_grace))
        if let at = self.impulse_at {
            let (x, y, z) = at
            t.insert(String("current_explosion_impact_pos"), Tag.List([Tag.Double(x), Tag.Double(y), Tag.Double(z)]))
        }
        t.insert(String("attributes"), self.attributes.pack())
        self.put_kept(mut t, "active_effects")
        t.insert(String("FallFlying"), flag(i32(self.data.byte(SHARED_FLAGS)) & FALL_FLYING_FLAG != 0))
        self.put_kept(mut t, "sleeping_pos")
        var brain = JavaHashMap<String, Tag>()
        brain.insert(String("memories"), Tag.Compound(JavaHashMap<String, Tag>()))
        t.insert(String("Brain"), Tag.Compound(brain))
        self.put_kept(mut t, "last_hurt_by_player")
        self.put_kept(mut t, "last_hurt_by_player_memory_time")
        self.put_kept(mut t, "last_hurt_by_mob")
        self.put_kept(mut t, "ticks_since_last_hurt_by_mob")
        self.put_kept(mut t, "equipment")
        self.put_kept(mut t, "locator_bar_icon")
    }

    fn put_kept(self, t: mut JavaHashMap<String, Tag>, key: str) {
        if self.kept.contains(key) {
            t.insert(String(key), self.kept[key].copy())
        }
    }
}

impl LivingFacts {
    // The state's sound type's step sound, with its volume and pitch.
    fn step_sound(self, state: u32) -> (String, f32, f32) {
        let at = usize(self.state_sounds[usize(state)])
        return (self.step_names[at].copy(), self.volumes[at], self.pitches[at])
    }

    // Its fall sound, with its volume and pitch.
    fn fall_sound(self, state: u32) -> (String, f32, f32) {
        let at = usize(self.state_sounds[usize(state)])
        return (self.fall_names[at].copy(), self.volumes[at], self.pitches[at])
    }
}

/// An armor stand, as vanilla's `ArmorStand` makes, runs and saves it: a living entity 0.5 across
/// and 1.975 high, its eyes 1.7775 up; half that, its eyes 0.9875 up, where it's small; and no size
/// where it's a marker. It breathes under water, its falls sound as an armor stand's, and it has
/// physics, so moves, only where it's neither a marker nor without gravity. Its body turns as it's
/// turned, `tickHeadTurn`, and its head with them as it's loaded. Its flags, whether it's small,
/// shows its arms, hides its base plate or is a marker, and its six poses are its values.
pub struct ArmorStand {
    pub living: Living
    /// Whether it's invisible, as it was set, and the slots that can't be taken from or put in,
    /// `disabledSlots`, kept for its save.
    pub invisible: bool = false
    pub disabled_slots: i32 = 0
}

impl ArmorStand {
    /// One at x, y, z, of the type `kind`, with its own random seeded `seed`, as vanilla's
    /// constructor makes it.
    pub fn new(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> ArmorStand {
        var l = Living.made(lf, kind, id, seed, x, y, z, 0.5f32, 1.975f32, 1.7775f32, armor_stand_data())
        l.breathes_water = true
        l.small_fall = String("entity.armor_stand.fall")
        l.big_fall = String("entity.armor_stand.fall")
        return ArmorStand { living: l }
    }

    /// The one `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `load` reads it in: what every living entity reads, `Living.load_from`; its
    /// head and body turned as it's turned; then whether it's invisible, small, shows its arms,
    /// hides its base plate or is a marker, its disabled slots, its physics, and its poses where
    /// they read, each `Rotations`' three floats, a turn at most, an angle that isn't finite none.
    /// None where it doesn't load, logged in `lines`.
    pub fn loaded(lf: LivingFacts, kind: u32, id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> ArmorStand? {
        var a = ArmorStand.new(lf, kind, id, seed, 0.0, 0.0, 0.0)
        if not a.living.load_from(lf, tag, mut lines) {
            return none
        }
        let turn = a.living.body.y_rot
        a.living.y_rot_o = turn
        a.living.y_head_rot = turn
        a.living.y_head_rot_o = turn
        a.living.y_body_rot_o = turn
        a.invisible = bool_or(tag, "Invisible")
        a.living.data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, a.invisible)
        a.set_flag(SMALL_FLAG, bool_or(tag, "Small"))
        a.set_flag(ARMS_FLAG, bool_or(tag, "ShowArms"))
        a.disabled_slots = int_or(tag, "DisabledSlots", 0)
        a.set_flag(NO_BASE_PLATE_FLAG, bool_or(tag, "NoBasePlate"))
        a.set_flag(MARKER_FLAG, bool_or(tag, "Marker"))
        a.living.body.no_physics = not a.has_physics()
        if tag.contains("Pose") {
            if let poses = read_poses(tag["Pose"]) {
                let ids: List<usize> = [HEAD_POSE, BODY_POSE, LEFT_ARM_POSE, RIGHT_ARM_POSE, LEFT_LEG_POSE, RIGHT_LEG_POSE]
                for i in 0..ids.len() {
                    let (x, y, z) = poses[i]
                    a.living.data.set(ids[i], Value.Rotations(x, y, z))
                }
            }
        }
        return some(a)
    }

    /// Its flags, `DATA_CLIENT_FLAGS`.
    pub fn flags(self) -> i32 {
        return i32(self.living.data.byte(STAND_FLAGS))
    }

    /// Whether it's a marker, `isMarker`, and small, `isSmall`.
    pub fn marker(self) -> bool {
        return self.flags() & MARKER_FLAG != 0
    }

    pub fn small(self) -> bool {
        return self.flags() & SMALL_FLAG != 0
    }

    /// `hasPhysics`: neither a marker nor without gravity.
    pub fn has_physics(self) -> bool {
        return not self.marker() and not self.living.data.flag(NO_GRAVITY)
    }

    // A flag set or cleared, and its size made again where that changed it, as
    // `onSyncedDataUpdated` refreshes its dimensions, where it is.
    fn set_flag(mut self, bit: i32, on: bool) {
        self.living.data.set_flag(STAND_FLAGS, bit, on)
        if self.marker() {
            self.living.body.width = 0.0f32
            self.living.body.height = 0.0f32
            self.living.body.eyes = 0.0f32
        } else if self.small() {
            self.living.body.width = 0.5f32 * 0.5f32
            self.living.body.height = 1.975f32 * 0.5f32
            self.living.body.eyes = 0.9875f32
        } else {
            self.living.body.width = 0.5f32
            self.living.body.height = 1.975f32
            self.living.body.eyes = 1.7775f32
        }
    }

    /// Its tick, as `tickNonPassenger` and `LivingEntity.tick` run it among `blocks`, in a level
    /// whose floor is `min_y`, where lava's fast if `fast_lava`: `baseTick`, `aiStep` unless it's
    /// gone, moving only where it has physics, its body turned as it's turned, and the turns kept
    /// near.
    pub fn tick<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) {
        self.living.base_tick(lf, f, t, blocks, min_y, fast_lava, mut sounds)
        if not self.living.body.removed {
            let physics = self.has_physics()
            self.living.ai_step(lf, f, m, t, blocks, fast_lava, physics, mut sounds)
        }
        self.living.y_body_rot_o = self.living.y_rot_o
        self.living.y_body_rot = self.living.body.y_rot
        self.living.tick_end()
    }

    /// What `saveAsPassenger` saves of it, in the order vanilla puts it: what every living entity
    /// saves, `Living.save_into`; then whether it's invisible, small, shows its arms, its disabled
    /// slots, whether it hides its base plate, whether it's a marker where it is, and its poses
    /// that aren't their defaults.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.living.save_into(mut t, "minecraft:armor_stand")
        let flags = self.flags()
        t.insert(String("Invisible"), flag(i32(self.living.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0))
        t.insert(String("Small"), flag(flags & SMALL_FLAG != 0))
        t.insert(String("ShowArms"), flag(flags & ARMS_FLAG != 0))
        t.insert(String("DisabledSlots"), Tag.Int(self.disabled_slots))
        t.insert(String("NoBasePlate"), flag(flags & NO_BASE_PLATE_FLAG != 0))
        if flags & MARKER_FLAG != 0 {
            t.insert(String("Marker"), flag(true))
        }
        var pose = JavaHashMap<String, Tag>()
        let names: List<str> = ["Head", "Body", "LeftArm", "RightArm", "LeftLeg", "RightLeg"]
        let ids: List<usize> = [HEAD_POSE, BODY_POSE, LEFT_ARM_POSE, RIGHT_ARM_POSE, LEFT_LEG_POSE, RIGHT_LEG_POSE]
        for i in 0..ids.len() {
            if not self.living.data.is_default(ids[i]) {
                let (x, y, z) = self.living.data.rotations(ids[i])
                pose.insert(String(names[i]), Tag.List([Tag.Float(x), Tag.Float(y), Tag.Float(z)]))
            }
        }
        t.insert(String("Pose"), Tag.Compound(pose))
        return Tag.Compound(t)
    }
}

/// `computeModifiedFriction`: a friction made less, `1 - (1 - friction) * modifier`, within 0 and 1.
pub fn modified_friction(friction: f32, modifier: f32) -> f32 {
    let v = 1.0f32 - (1.0f32 - friction) * modifier
    if v < 0.0f32 {
        return 0.0f32
    }
    return if v > 1.0f32 { 1.0f32 } else { v }
}

// `getFluidFallingAdjustedMovement`'s motion up and down: a sixteenth of its gravity down,
// unless it's falling and that would bring it within 0.003 of it, when it sinks at 0.003.
fn fluid_falling(gravity: f64, falling: bool, y: f64) -> f64 {
    if gravity == 0.0 {
        return y
    }
    if falling and (y - 0.005).abs() >= 0.003 and (y - gravity / 16.0).abs() < 0.003 {
        return -0.003
    }
    return y - gravity / 16.0
}

// `containsAnyLiquid`: whether a block from the box's least corner's to its greatest's holds a
// fluid; one whose chunk isn't loaded doesn't.
fn any_liquid<B: CollisionBlocks>(f: Facts, blocks: B, b: Aabb) -> bool {
    for x in floor(b.min_x)..=floor(b.max_x) {
        for y in floor(b.min_y)..=floor(b.max_y) {
            for z in floor(b.min_z)..=floor(b.max_z) {
                if let state = blocks.collision_state(x, y, z) {
                    if f.fluid(state) != 0 {
                        return true
                    }
                }
            }
        }
    }
    return false
}

// `Mth.clamp` of a double.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo
    }
    return if v > hi { hi } else { v }
}

// A boolean as `putBoolean` saves it.
fn flag(b: bool) -> Tag {
    return Tag.Byte(if b { 1i8 } else { 0i8 })
}

// `SPEED_MODIFIER_POWDER_SNOW_ID`.
fn powder_snow_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "powder_snow" }
}

// The number saved as `key` as a float, as `getFloatOr` reads it, or `fallback`.
fn float_or(tag: JavaHashMap<String, Tag>, key: str, fallback: f32) -> f32 {
    if not tag.contains(key) {
        return fallback
    }
    return tag[key].number_float() ?? fallback
}

// The three numbers saved as `key`, as `Vec3.CODEC` reads them, or none.
fn vec3_of(tag: JavaHashMap<String, Tag>, key: str) -> (f64, f64, f64)? {
    if not tag.contains(key) {
        return none
    }
    let Tag.List(items) = tag[key] else return none
    if items.len() != 3 {
        return none
    }
    let x = items[0].number_double() else return none
    let y = items[1].number_double() else return none
    let z = items[2].number_double() else return none
    return some((x, y, z))
}

// An armor stand's poses as `ArmorStandPose.CODEC` reads them: each of the six its default where
// it's missing, else three floats, each within a turn, `Rotations`; none where one's there but
// isn't three numbers, which fails the whole.
fn read_poses(t: Tag) -> List<(f32, f32, f32)>? {
    let Tag.Compound(m) = t else return none
    let names: List<str> = ["Head", "Body", "LeftArm", "RightArm", "LeftLeg", "RightLeg"]
    var out: List<(f32, f32, f32)> = [(0.0f32, 0.0f32, 0.0f32), (0.0f32, 0.0f32, 0.0f32), (-10.0f32, 0.0f32, -10.0f32), (-15.0f32, 0.0f32, 10.0f32), (-1.0f32, 0.0f32, -1.0f32), (1.0f32, 0.0f32, 1.0f32)]
    for i in 0..names.len() {
        if not m.contains(names[i]) {
            continue
        }
        let Tag.List(items) = m[names[i]] else return none
        if items.len() != 3 {
            return none
        }
        var v = List<f32>()
        for item in items {
            let n = item.number_float() else return none
            v.push(if n - n == 0.0f32 { n % 360.0f32 } else { 0.0f32 })
        }
        out[i] = (v[0], v[1], v[2])
    }
    return some(out)
}
