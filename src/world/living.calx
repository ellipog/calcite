/// A living entity, as vanilla's `LivingEntity` has it and moves it (CAL-155): what every entity
/// has (`world.body`), its attributes as its type's `DefaultAttributes` supplies them
/// (`world.attributes`), its synced data (`world.entity_data`), its health, and its head's and
/// body's turns; and how it moves, `aiStep` and `travel`. Its motion under 0.003 a tick each way
/// is let go; it jumps as it's told to, off the ground, in shallow water or lava, or up through
/// deeper; then it goes through the air, slowed on the ground as the block below it is slippery,
/// `computeModifiedFriction` by its friction modifier, and by the air as its air drag modifier
/// says, falling as its gravity says; through water and lava, slowed as they slow it and held up as
/// they hold it up, `getFluidFallingAdjustedMovement`, and out over an edge it's pushed against;
/// and up and down what's climbable, no faster than 0.15 a tick across or down: a ladder, a vine,
/// scaffolding, or an open trapdoor over a ladder facing its way. What it's told to walk,
/// `xxa`, `yya` and `zza`, turns with it, `moveRelative`.
///
/// Its move is `Entity.move`'s, with a living entity's own steps between: its fluids looked at
/// again, out of water; the dust a block throws up as it lands, `checkFallDamage`; the block's
/// `fallOn`, which plays its fall sounds as `causeFallDamage` plays them where the fall's past its
/// safe distance, with hay, honey, slime, powder snow, beds and pointed dripstone each their own
/// way; and its steps heard as `applyMovementEmissionAndPlaySound` hears them, the block's step
/// sound each block it goes, an amethyst chime on what chimes and a swim in water. Its air comes
/// back 4 a tick out of water, and under it runs out unless it breathes there.
///
/// An armor stand (`ArmorStand`) is the one living entity Calcite runs yet. It has no AI, so it
/// never walks or jumps; it moves only where it has physics, neither a marker nor without gravity;
/// its body turns as it's turned. It's made, loaded and saved as vanilla's is.
///
/// Not in Calcite yet: being hurt, which waits for damage (P6.5), so a fall, a wall, fire,
/// drowning and freezing hurt nothing and nothing dies, nor does cramming (CAL-156); effects, kept
/// as it was loaded with; an armor stand pushing minecarts, which Calcite doesn't have; what
/// blocks do to it, `applyEffectsFromBlocks`, as for items (CAL-172), and farmland and turtle eggs
/// fallen on; its equipment, kept as it was loaded with, and its custom name, neither sent; and
/// sleeping.
module world.living

import math.mth.{floor, table_cos, table_sin}
import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import resources.identifier.{Identifier}
import server.log.{Entry}
import std.java.math.{pow}
import world.attributes.{ADD_VALUE, Attributes, Modifier, Wearing, attribute_id, equip, slot_names, unworn}
import world.block_facts.{fall_sound_names, place_sound_pitches, place_sound_volumes, state_place_sounds, step_sound_names}
import world.body.{Body, BodyFacts, EntitySound, Moved, bool_or, int_or, short_or, uuid_of, uuid_tag}
import world.collision.{Aabb, CollisionBlocks}
import world.digging.{value_effect}
import world.damage.{ALWAYS_KILLS_ARMOR_STANDS, BURNS_ARMOR_STANDS, BYPASSES_ARMOR, BYPASSES_COOLDOWN, BYPASSES_EFFECTS, BYPASSES_ENCHANTMENTS, BYPASSES_INVULNERABILITY, CAN_BREAK_ARMOR_STAND, Damage, DamageTypes, IGNITES_ARMOR_STANDS, IS_EXPLOSION, IS_FALL, IS_FIRE, NO_ANGER, NO_IMPACT, NO_KNOCKBACK}
import world.experience_orb.{Follower}
import world.entity_data.{AIR_SUPPLY, ARMS_FLAG, BODY_POSE, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, DYING, EntityData, FALL_FLYING_FLAG, GLOWING_FLAG, HEAD_POSE, HEALTH, INVISIBLE_FLAG, LEFT_ARM_POSE, LEFT_LEG_POSE, MARKER_FLAG, NO_BASE_PLATE_FLAG, NO_GRAVITY, ON_FIRE_FLAG, POSE_ID, RIGHT_ARM_POSE, RIGHT_LEG_POSE, SHARED_FLAGS, SILENT, SMALL_FLAG, STAND_FLAGS, TICKS_FROZEN, Value, armor_stand_data}
import world.menu.{same_stack}
import world.goals.{Bred, Grazed, Temptations}
import world.inside.{CLEAR_FREEZE, Collector, EXTINGUISH, BlockEffect, FIRE_IGNITE, Inside, LAVA_IGNITE, Movement, Rain, Touched, doused, fluid_effects, inside_blocks, touch_block}
import world.loot.{LootEntity, LootParams}
import world.movement.{Mover, MovementStates, meets, moved}
import world.paths.{PathStates}
import worldgen.facts.{BlockSet, Facts}

/// How long it takes to freeze, `getTicksRequiredToFreeze`.
const TICKS_TO_FREEZE: i32 = 140
/// The dust a block throws up where a living entity lands on it, as `checkFallDamage` sends it:
/// the block's state, where, and how many specks, `ParticleTypes.BLOCK` at 0.15 a tick.
pub struct FallDust {
    pub state: u32
    pub x: f64
    pub y: f64
    pub z: f64
    pub count: i32
}

/// An egg a chicken lays, `dropFromGiftLootTable` of `gameplay/chicken_lay` (CAL-156): where, and
/// the item, which the chicken's variant picks.
pub struct Laid {
    pub x: f64
    pub y: f64
    pub z: f64
    pub item: String
}

/// A particle a living entity has the server send, `ServerLevel.sendParticles` of one with no
/// spread or speed, as a baby fed older does, `happy_villager` (D415): its name and where.
pub struct Sent {
    pub particle: String
    pub x: f64
    pub y: f64
    pub z: f64
}

/// What a living entity shows the players near it besides its sounds: the dust it throws up
/// landing, an entity event, `broadcastEntityEvent`, as 54, honey slid on, 55, its hands swapped,
/// and 67, air run out; a chicken's egg, which the server drops; the slots of its equipment that
/// changed, each with what's in it now, `ClientboundSetEquipmentPacket`; and a particle the server
/// sends.
pub enum Shown {
    Dust(FallDust)
    Particle(Sent)
    Event(i8)
    Laid(Laid)
    Worn(List<(usize, Tag?)>)
    /// What a sheep's eating does to the level, which mob griefing lets it do, and what a farm
    /// animal's breeding asks of it (CAL-158).
    Grazed(Grazed)
    Bred(Bred)
    /// A hurt in its own tick that took the whole of it, by the damage type's ID, whose damage
    /// event goes to those who see it; a death in its own tick, what its level does of it; and
    /// what Calcite doesn't do yet that it would have, to be said (D424).
    Damaged(i32)
    Died(Death)
    Missing(String)
    /// A slime's split as it's taken out dying, what its level makes of it (D430).
    Split(Split)
    /// Redstone ore it stepped on, at its place, which its level lights (D431).
    Lit((i32, i32, i32))
    /// What it wears in a slot worn by so much, which its level does with its random,
    /// `hurtAndBreak`, as the sun wears an undead mob's helmet (D437).
    Wore((usize, i32))
    /// An armor stand's breaking, what its level does of it, `StandBreak` (D441).
    StandBroken(StandBreak)
}

/// What the block a living entity stands on does to it that it can't do itself, `stepOn` (D431):
/// nothing; magma's burn, 1 of `hot_floor`, which its own hurt deals; redstone ore at its place,
/// lit by its level; or what Calcite doesn't do yet, to be said.
pub enum Stepped {
    Nothing
    Magma
    Ore((i32, i32, i32))
    Missing(String)
}

/// What a slime's split as it's taken out dying leaves its level to make (D430), as
/// `AbstractCubeMob.remove` converts it, `SPLIT_ON_DEATH`: its species and entity type, the size
/// of the smaller cubes, each one's place and yaw, drawn from its random, and what
/// `convertCommon` takes from it.
pub struct Split {
    pub species: i32
    pub kind: u32
    pub size: i32
    pub places: List<(f64, f64, f64, f32)>
    pub common: Common
}

/// What `ConversionType.convertCommon` takes from a mob to what it's made into (D430): its
/// absorption; its effects, as it keeps them; whether it's left-handed and without AI; whether it
/// must stay; whether its name shows; whether it's burning; whether it's invulnerable, and its
/// cooldown from being hurt; whether it has no gravity; its portal cooldown; whether it's silent;
/// and its tags, custom name and custom data, as it keeps them to save.
pub struct Common {
    pub absorption: f32 = 0.0f32
    pub kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    pub left_handed: bool = false
    pub no_ai: bool = false
    pub persistent: bool = false
    pub name_visible: bool = false
    pub on_fire: bool = false
    pub invulnerable: bool = false
    pub invulnerable_time: i32 = 0
    pub no_gravity: bool = false
    pub portal_cooldown: i32 = 0
    pub silent: bool = false
    pub extras: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
}

/// What a mob's death in its own tick leaves its level to do (D424): where it died, of what type
/// of damage, and the player who hurt it lately, whose luck its loot has; its loot table and
/// seed and what the table reads of it, where it drops anything; what it wears that it drops,
/// drawn as it died; and its experience, its reward drawn as it died. A slime splits as it's
/// taken out, `Shown.Split` (D430).
pub struct Death {
    pub x: f64
    pub y: f64
    pub z: f64
    pub damage: i32
    pub killed_by: (i64, i64)? = none
    pub loot: (String, i64)? = none
    pub this: LootEntity? = none
    pub equipment: List<Tag> = List<Tag>()
    pub reward: i32 = 0
}

/// What living entities read of blocks and attributes: the climbable blocks, those that chime,
/// ladders and powder snow; each state's sound type's step and fall sounds, volume and pitch; the
/// attributes they move by, by ID; and what mobs finding their way read, each state's path type
/// and the doors, fences and cauldrons, which their navigation and move control ask of blocks
/// (CAL-157).
pub struct LivingFacts {
    pub paths: PathStates
    pub doors: BlockSet
    pub fences: BlockSet
    pub cauldrons: BlockSet
    pub follow_range: u32
    pub step_height: u32
    /// What mobs' goals read of blocks (CAL-158): the grass block, by its ID, which an animal
    /// would walk to and a sheep eats; and what a sheep eats where it stands,
    /// `#edible_for_sheep`.
    pub grass_block: u32
    pub sheep_food: BlockSet
    /// The items that tempt the farm animals and horses, by their sets, vanilla's till the
    /// network reads the world's tags, and the attribute `tempt_range` (CAL-158).
    pub tempting: Temptations
    pub tempt_range: u32
    /// The blocks `minecraft:climbable` and `minecraft:crystal_sound_blocks` hold, and those a
    /// player's steps sound of over what they stand on, `minecraft:inside_step_sound_blocks`, and
    /// with it, `minecraft:combination_step_sound_blocks` (D421).
    pub climbable: BlockSet
    pub crystal: BlockSet
    pub inside_step: BlockSet
    pub combination_step: BlockSet
    /// The blocks that suffocate what's in them where their collision shape's full,
    /// `minecraft:causes_suffocation` (D425).
    pub suffocation: BlockSet
    ladder: u32
    powder_snow: u32
    scaffolding: u32
    step_names: List<String>
    fall_names: List<String>
    volumes: List<f32>
    pitches: List<f32>
    state_sounds: List<u32>
    pub max_health: u32
    pub gravity: u32
    pub jump_strength: u32
    pub friction_modifier: u32
    pub air_drag_modifier: u32
    pub water_efficiency: u32
    pub movement_efficiency: u32
    pub safe_fall: u32
    pub fall_multiplier: u32
    pub oxygen_bonus: u32
    pub movement_speed: u32
    /// The damage types, by their IDs, with their tags, vanilla's till the network reads the
    /// world's, and the attributes a hurt reads (D416).
    pub damage: DamageTypes
    pub knockback_resistance: u32
    pub armor: u32
    pub armor_toughness: u32
    pub max_absorption: u32
    /// The items in `#swords`, which sweep, as the network reads them of the world (D417).
    pub swords: List<String> = List<String>()
}

/// What a hurt did, as `hurtServer` has it (D416): whether it hurt, its answer; whether it took
/// the whole of it, `tookFullDamage`, which its damage event, its sound and its knockback follow;
/// whether `actuallyHurt` ran, which an animal's love ends with; whether it's dying of it, its
/// death sound to be played and its death to follow, `die`; and whether it was hurt but not to
/// death, its hurt sound to be played.
pub struct Hurt {
    pub hurt: bool = false
    pub full: bool = false
    pub actually: bool = false
    pub dies: bool = false
    pub hurt_sound: bool = false
}

impl LivingFacts {
    /// As `f` has them, its tags those its level loaded.
    pub fn new(f: Facts) -> LivingFacts {
        let ladder = f.block_named(String("minecraft:ladder")) else panic("no ladder block")
        let snow = f.block_named(String("minecraft:powder_snow")) else panic("no powder snow block")
        var steps = List<String>()
        for s in step_sound_names() {
            steps.push(String(s))
        }
        var falls = List<String>()
        for s in fall_sound_names() {
            falls.push(String(s))
        }
        return LivingFacts {
            paths: PathStates.new(f),
            doors: f.tag_or_empty(String("minecraft:doors")),
            fences: f.tag_or_empty(String("minecraft:fences")),
            cauldrons: f.tag_or_empty(String("minecraft:cauldrons")),
            follow_range: attribute("follow_range"),
            step_height: attribute("step_height"),
            grass_block: f.block_named(String("minecraft:grass_block")) ?? u32.MAX,
            sheep_food: f.tag_or_empty(String("minecraft:edible_for_sheep")),
            tempting: Temptations.vanilla(),
            tempt_range: attribute("tempt_range"),
            climbable: f.tag_or_empty(String("minecraft:climbable")),
            crystal: f.tag_or_empty(String("minecraft:crystal_sound_blocks")),
            inside_step: f.tag_or_empty(String("minecraft:inside_step_sound_blocks")),
            combination_step: f.tag_or_empty(String("minecraft:combination_step_sound_blocks")),
            suffocation: f.tag_or_empty(String("minecraft:causes_suffocation")),
            ladder: ladder,
            powder_snow: snow,
            scaffolding: f.block_named(String("minecraft:scaffolding")) ?? u32.MAX,
            step_names: steps,
            fall_names: falls,
            volumes: place_sound_volumes(),
            pitches: place_sound_pitches(),
            state_sounds: state_place_sounds(),
            max_health: attribute("max_health"),
            gravity: attribute("gravity"),
            jump_strength: attribute("jump_strength"),
            friction_modifier: attribute("friction_modifier"),
            air_drag_modifier: attribute("air_drag_modifier"),
            water_efficiency: attribute("water_movement_efficiency"),
            movement_efficiency: attribute("movement_efficiency"),
            safe_fall: attribute("safe_fall_distance"),
            fall_multiplier: attribute("fall_damage_multiplier"),
            oxygen_bonus: attribute("oxygen_bonus"),
            movement_speed: attribute("movement_speed"),
            damage: DamageTypes.vanilla(),
            knockback_resistance: attribute("knockback_resistance"),
            armor: attribute("armor"),
            armor_toughness: attribute("armor_toughness"),
            max_absorption: attribute("max_absorption"),
        }
    }

    // Whether the state is climbable to a moving entity, `isStateClimbable`: climbable, or powder
    // snow.
    fn climbable_state(self, f: Facts, state: u32) -> bool {
        return f.in_set(state, self.climbable) or f.block(state) == self.powder_snow
    }
}

// The attribute `minecraft:{name}`'s ID.
fn attribute(name: str) -> u32 {
    return attribute_id("minecraft:{name}") ?? panic("no attribute {name}")
}

/// A living entity.
pub struct Living {
    /// What every entity has; its type, by its ID in the entity type registry; its attributes and
    /// its synced values.
    pub body: Body
    pub kind: u32
    pub attributes: Attributes
    pub data: EntityData
    /// Its turns as its tick began, `yRotO` and `xRotO`, and its head's and body's, now and then.
    pub y_rot_o: f32 = 0.0f32
    pub x_rot_o: f32 = 0.0f32
    pub y_head_rot: f32 = 0.0f32
    pub y_head_rot_o: f32 = 0.0f32
    pub y_body_rot: f32 = 0.0f32
    pub y_body_rot_o: f32 = 0.0f32
    /// What it's told to walk, sideways, up and ahead, whether it's told to jump, how long until
    /// it may jump again, and how fast it walks, `getSpeed`.
    pub xxa: f32 = 0.0f32
    pub yya: f32 = 0.0f32
    pub zza: f32 = 0.0f32
    pub jumping: bool = false
    pub no_jump_delay: i32 = 0
    pub speed: f32 = 0.0f32
    /// How much water slows it, `getWaterSlowDown`; and whether it flies and sprints,
    /// `abilities.flying` and `isSprinting`, which only a player's travel looks at so far (D419);
    /// and whether it crouches, which steps without its feet on the ground (D421), and swims,
    /// `isSwimming`, which doesn't step at all, as only a player does so far (D444). A player's
    /// body, `Body.player`, steps as a player does (D421, D422).
    pub water_slow_down: f32 = 0.8f32
    pub flying: bool = false
    pub sprinting: bool = false
    pub crouching: bool = false
    pub swimming: bool = false
    /// Whether fire doesn't burn it, its type's `fireImmune`, which none Calcite runs is (D434).
    pub fire_immune: bool = false
    /// What it's saved with of being hurt: its hurt and death times, its absorption, how long it
    /// can't be hurt, and the impulse it was last given, its grace time and where it was given,
    /// which a fall below it doesn't count.
    pub hurt_time: i32 = 0
    pub death_time: i32 = 0
    pub absorption: f32 = 0.0f32
    pub invulnerable_time: i32 = 0
    pub impulse_grace: i32 = 0
    pub impulse_at: (f64, f64, f64)? = none
    /// The block it last climbed, `lastClimbablePos`.
    pub last_climbable: (i32, i32, i32)? = none
    /// Being hurt, as `hurtServer` keeps it (D416): how long it shrugs off what's no worse than
    /// its last hurt, `damageCooldownTime`, and that hurt, `lastHurt`; what last hurt it and the
    /// game time then, `lastDamageSource` and `lastDamageStamp`; the player who last hurt it, by
    /// UUID, and for how many ticks more that's kept, `lastHurtByPlayer` and
    /// `lastHurtByPlayerMemoryTime`; the living entity that last hurt it, by UUID, and its tick
    /// count then, `lastHurtByMob` and `lastHurtByMobTimestamp`; and whether it's died, `dead`.
    pub damage_cooldown: i32 = 0
    pub last_hurt: f32 = 0.0f32
    pub last_damage: Damage? = none
    pub last_damage_tags: u32 = 0
    pub last_damage_stamp: i64 = 0
    pub hurt_by_player: (i64, i64)? = none
    pub hurt_by_player_memory: i32 = 0
    pub hurt_by_mob: (i64, i64)? = none
    pub hurt_by_mob_stamp: i32 = 0
    pub dead: bool = false
    /// Whether its type breathes under water, `minecraft:can_breathe_under_water`, and is never
    /// hurt by a fall, `minecraft:fall_damage_immune`, and its fall sounds, `getFallSounds`, a
    /// small fall's and a big one's.
    pub breathes_water: bool = false
    pub fall_immune: bool = false
    pub small_fall: String
    pub big_fall: String
    /// Its swim's sound, `getSwimSound` (CAL-156).
    pub swim: String
    /// Its type's own step sound, `playStepSound`, at 0.15 and its pitch 1, as a cow's, where it
    /// doesn't step as the block it's on sounds; or, where `step_by_block`, as loud and high as the
    /// block sounds, a horse's, its wood step on wood and nothing on a liquid (CAL-156).
    pub own_step: String? = none
    pub step_by_block: bool = false
    // How far it's gone for its steps, `moveDist` and `flyDist`, and where it next steps.
    move_dist: f32 = 0.0f32
    fly_dist: f32 = 0.0f32
    next_step: f32 = 1.0f32
    // When it last chimed on amethyst, and how loud it's been chiming.
    chimed_at: i32 = 0
    chime: f32 = 0.0f32
    /// What it was loaded with that Calcite doesn't run, by the keys it's saved under: its
    /// effects, sleeping place, who last hurt it and its locator bar icon.
    pub kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    /// What it wears and holds, `equipment`, by `EquipmentSlot`'s order, and that as it last looked
    /// at it, `lastEquipmentItems`, nothing at first (CAL-156).
    pub equipment: List<Tag?> = List<Tag?>()
    last_equipment: List<Tag?> = List<Tag?>()
    /// What it showed since that was last taken, in the order it showed it, and how many of the
    /// sounds of its tick it had played as it showed each, for the server to send among them.
    pub shown: List<Shown> = List<Shown>()
    pub shown_after: List<usize> = List<usize>()
}

impl Living {
    /// A living entity of the type `kind` at x, y, z, `width` across and `height` high with its eyes
    /// `eyes` up, with `data` its synced values as its type defines them and its own random seeded
    /// `seed`, as `LivingEntity`'s constructor makes it: `Entity`'s, its UUID drawn from its random;
    /// its attributes; its health its most; and its turn drawn from its random, `nextFloat` of a
    /// turn's radians as degrees, its head turned with it.
    pub fn made(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64, width: f32, height: f32, eyes: f32, data: own EntityData) -> Living {
        let (l, _) = Living.made_drawing(lf, kind, id, seed, x, y, z, width, height, eyes, data, 0)
        return l
    }

    /// `made`, with a draw from its random of a number below `bound` as its type defines its
    /// values, after its UUID and before its turn, as a zombie villager draws its profession, and
    /// that number; nothing drawn and -1 where `bound` is 0 (CAL-156).
    pub fn made_drawing(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64, width: f32, height: f32, eyes: f32, data: own EntityData, bound: i32) -> (Living, i32) {
        var body = Body.made(id, seed, x, y, z, width, height, eyes, 0.0)
        body.alive = true
        let drawn = if bound > 0 { body.random.next_int_below(bound) } else { -1 }
        var l = Living { body: body, kind: kind, attributes: Attributes.of_type(kind), data: data, small_fall: String("entity.generic.small_fall"), big_fall: String("entity.generic.big_fall"), swim: String("entity.generic.swim"), equipment: unworn(), last_equipment: unworn() }
        l.refresh_body(lf)
        let most = l.max_health(lf)
        l.set_health(lf, most)
        let turn = l.body.random.next_float() * 6.2831855f32
        l.body.y_rot = turn
        l.y_head_rot = turn
        return (l, drawn)
    }

    /// A player's body as the server moves them (D419), `kind` the player's type, `id` their
    /// network ID and `data` their synced values, its place, motion, size, random and the rest set
    /// before each move: their client has the say over it, so it's not `owned`, and they sound as a
    /// player does (D421). Nothing's drawn from its random, as the player's entity was made
    /// already.
    pub fn player_body(kind: u32, id: i32, data: own EntityData) -> Living {
        let body = Body { id: id, uuid: (0i64, 0i64), x: 0.0, y: 0.0, z: 0.0, width: 0.6f32, height: 1.8f32, eyes: 1.62f32, gravity: 0.08, random: LegacyRandom.new(0i64), alive: true, owned: false, player: true, sound_source: 7 }
        return Living { body: body, kind: kind, attributes: Attributes(), data: data, small_fall: String("entity.player.small_fall"), big_fall: String("entity.player.big_fall"), swim: String("entity.player.swim") }
    }

    /// `Entity.snapTo`: at x, y, z turned `y_rot` and `x_rot`, where it was and how it was turned
    /// as its tick began the same, `setOldPosAndRot`; its head and body as they were.
    pub fn snap_to(mut self, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32) {
        self.body.x = x
        self.body.y = y
        self.body.z = z
        self.body.y_rot = y_rot
        self.body.x_rot = x_rot
        self.body.xo = x
        self.body.yo = y
        self.body.zo = z
        self.y_rot_o = y_rot
        self.x_rot_o = x_rot
    }

    /// Its body's gravity, air drag, movement efficiency and how high it steps (D420), from its
    /// attributes as they are now.
    pub fn refresh_body(mut self, lf: LivingFacts) {
        self.body.step = f32.nearest(self.attributes.value(lf.step_height))
        self.body.gravity = self.attributes.value(lf.gravity)
        self.body.air_drag = modified_friction(0.98f32, f32.nearest(self.attributes.value(lf.air_drag_modifier)))
        self.body.efficiency = f32.nearest(self.attributes.value(lf.movement_efficiency))
    }

    /// Its health, `getHealth`, and its most, `getMaxHealth`.
    pub fn health(self) -> f32 {
        return self.data.float(HEALTH)
    }

    pub fn max_health(self, lf: LivingFacts) -> f32 {
        return f32.nearest(self.attributes.value(lf.max_health))
    }

    /// `setHealth`: its health, kept within 0 and its most.
    pub fn set_health(mut self, lf: LivingFacts, health: f32) {
        let most = self.max_health(lf)
        let kept = if health < 0.0f32 { 0.0f32 } else if health > most { most } else { health }
        self.data.set(HEALTH, Value.Float(kept))
    }

    /// `detectEquipmentUpdates`, in its tick before `aiStep`: each slot whose stack doesn't match
    /// what it last looked at, the old one's modifiers taken off and the new one's put on, unless
    /// it's broken, as `items` reads them; then shown, its hands swapped as event 55 and the other
    /// slots with what's in them, `handleEquipmentChanges` (CAL-156).
    pub fn detect_equipment<W: Wearing>(mut self, items: W, heard: usize) {
        var changed = List<usize>()
        for slot in 0..self.equipment.len() {
            if not same_stack(self.last_equipment[slot].copy(), self.equipment[slot].copy()) {
                changed.push(slot)
            }
        }
        if changed.is_empty() {
            return
        }
        let now = self.equipment.copy()
        let swapped = equip(mut self.attributes, mut self.last_equipment, now, items)
        var sent = List<(usize, Tag?)>()
        for slot in changed {
            if swapped and slot <= 1 {
                continue
            }
            sent.push((slot, self.equipment[slot].copy()))
        }
        if swapped {
            self.show(Shown.Event(55i8), heard)
        }
        if not sent.is_empty() {
            self.show(Shown.Worn(sent), heard)
        }
    }

    /// `refreshDirtyAttributes` for its most health, at the end of its tick: its health no more
    /// than its most, which a lower most health leaves it above (CAL-156).
    pub fn keep_health(mut self, lf: LivingFacts) {
        let most = self.max_health(lf)
        if self.health() > most {
            self.set_health(lf, most)
        }
    }

    /// `heal`: its health up by `amount` where it has any, no more than its most.
    pub fn heal(mut self, lf: LivingFacts, amount: f32) {
        let now = self.health()
        if now > 0.0f32 {
            self.set_health(lf, now + amount)
        }
    }

    /// `isAlive`: not gone and with health left.
    pub fn alive(self) -> bool {
        return not self.body.removed and self.health() > 0.0f32
    }

    /// `isDeadOrDying`: no health left, or died (D416).
    pub fn dead_or_dying(self) -> bool {
        return self.health() <= 0.0f32 or self.dead
    }

    /// `isInvulnerableTo` for the damage `d` of `types` (D416): `isInvulnerableToBase`, gone;
    /// invulnerable, for good or for now, to what doesn't bypass it and isn't a creative player's;
    /// fire immune to fire; or a type immune to falls hurt by one; else immune to it by its
    /// enchantments, `immune`, `isImmuneToDamage`, as its `Ward` says (D439).
    pub fn invulnerable_to(self, types: DamageTypes, d: Damage, fire_immune: bool, immune: bool) -> bool {
        if self.body.removed {
            return true
        }
        let invulnerable = self.body.invulnerable or self.invulnerable_time > 0
        if invulnerable and not types.is(d.kind, BYPASSES_INVULNERABILITY) and not d.creative {
            return true
        }
        if types.is(d.kind, IS_FIRE) and fire_immune {
            return true
        }
        if types.is(d.kind, IS_FALL) and self.fall_immune {
            return true
        }
        return immune
    }

    /// `LivingEntity.hurtServer` of `amount` of the damage `d` of `types` at the game time `now`,
    /// fire resistant or not, fire immune or not (D416): nothing where it's invulnerable to it,
    /// dying, or fire resistant against fire; else, no less than none, the whole of it where its
    /// cooldown's done or the type bypasses it, its cooldown 20 and its hurt time 10, or else only
    /// what's worse than its last hurt, nothing where it isn't, `actuallyHurt`; then who hurt it
    /// kept, the mob unless the type's `no_anger`, and the player for 100 ticks; for the whole of
    /// it, its motion to be sent, `markHurt`, unless `no_impact`, and its knockback, `0.4F` made a
    /// double, from where the damage came, unless `no_knockback`; then its death or its hurt sound
    /// to follow, and what hurt it kept with the time. What its enchanted equipment does against
    /// it is `ward`'s (D439). Blocking, freezing, helmets and totems come with them.
    pub fn hurt_server(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, now: i64, fire_resistant: bool, fire_immune: bool, ward: Ward) -> Hurt {
        var out = Hurt()
        if self.invulnerable_to(types, d, fire_immune, ward.immune) or self.dead_or_dying() {
            return out
        }
        if types.is(d.kind, IS_FIRE) and fire_resistant {
            return out
        }
        var damage = if amount < 0.0f32 { 0.0f32 } else { amount }
        if damage.is_nan() or damage == f32.INFINITY or damage == f32.NEG_INFINITY {
            damage = f32.MAX
        }
        out.full = true
        if f32.nearest(f64(self.damage_cooldown)) > 10.0f32 and not types.is(d.kind, BYPASSES_COOLDOWN) {
            if damage <= self.last_hurt {
                return Hurt()
            }
            let more = damage - self.last_hurt
            self.actually_hurt(lf, types, d, more, fire_immune, ward)
            self.last_hurt = damage
            out.full = false
        } else {
            self.last_hurt = damage
            self.damage_cooldown = 20
            self.actually_hurt(lf, types, d, damage, fire_immune, ward)
            self.hurt_time = 10
        }
        out.actually = true
        // `resolveMobResponsibleForDamage` and `resolvePlayerResponsibleForDamage`: what caused it
        // is a player so far, who's a living entity, so a mob too.
        if let who = d.player {
            if not types.is(d.kind, NO_ANGER) {
                self.hurt_by_mob = some(who)
                self.hurt_by_mob_stamp = self.body.tick_count
            }
            self.hurt_by_player = some(who)
            self.hurt_by_player_memory = 100
        }
        if out.full {
            if not types.is(d.kind, NO_IMPACT) {
                self.body.sync_velocity = true
            }
            if not types.is(d.kind, NO_KNOCKBACK) {
                // `dealDefaultKnockback`: toward where it came from; a projectile's way comes
                // with them.
                var xd = 0.0
                var zd = 0.0
                if let at = d.at {
                    let (x, _, z) = at
                    xd = x - self.body.x
                    zd = z - self.body.z
                }
                self.knockback(lf, f64(0.4f32), xd, zd)
            }
        }
        if self.dead_or_dying() {
            out.dies = true
        } else if out.full {
            out.hurt_sound = true
        }
        out.hurt = true
        self.last_damage = some(d)
        self.last_damage_tags = types.tags_of(d.kind)
        self.last_damage_stamp = now
        return out
    }

    /// Whether what last hurt it, `getLastDamageSource()`, within 40 ticks of the game time `now`,
    /// is of a type in the tag of the bit `tag`, `is(tag)` (D416).
    pub fn recently_hurt_by(self, now: i64, tag: u32) -> bool {
        return self.recent_damage(now) != none and self.last_damage_tags & tag != 0u32
    }

    /// `getLastDamageSource()`: what last hurt it, where that was 40 ticks or less before the game
    /// time `now` (D416).
    pub fn recent_damage(self, now: i64) -> Damage? {
        if now - self.last_damage_stamp > 40 {
            return none
        }
        return self.last_damage
    }

    // `actuallyHurt` of `amount`, where it isn't invulnerable to it: less what its armor takes,
    // `getDamageAfterArmorAbsorb`, unless the type bypasses armor, that share changed by the armor
    // effectiveness of what dealt it's weapon, `ward`'s, drawing from its random where they draw,
    // and kept within 0 and 1, `modifyArmorEffectiveness` (D443); and, where it's left with any,
    // unless the type bypasses effects, what its enchantments' protection, `ward`'s, takes, unless
    // it bypasses enchantments, `getDamageAfterMagicAbsorb` (D439); its absorption taken first,
    // the rest from its health. What resistance takes comes with effects.
    fn actually_hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, amount: f32, fire_immune: bool, ward: Ward) {
        if self.invulnerable_to(types, d, fire_immune, ward.immune) {
            return
        }
        var damage = amount
        if not types.is(d.kind, BYPASSES_ARMOR) {
            let armor = f32.nearest(f64(floor(self.attributes.value(lf.armor))))
            let toughness = f32.nearest(self.attributes.value(lf.armor_toughness))
            if ward.armor.is_empty() {
                damage = after_absorb(damage, armor, toughness)
            } else {
                var share = armor_share(damage, armor, toughness)
                for (effect, lv) in ward.armor {
                    share = value_effect(effect.copy(), lv, share, mut self.body.random)
                }
                // `Mth.clamp`.
                share = if share < 0.0f32 { 0.0f32 } else { share.min(1.0f32) }
                damage = damage * (1.0f32 - share)
            }
        }
        if not types.is(d.kind, BYPASSES_EFFECTS) {
            if damage <= 0.0f32 {
                damage = 0.0f32
            } else if not types.is(d.kind, BYPASSES_ENCHANTMENTS) and ward.protection > 0.0f32 {
                damage = after_magic_absorb(damage, ward.protection)
            }
        }
        let original = damage
        damage = (damage - self.absorption).max(0.0f32)
        let absorbed = self.absorption - (original - damage)
        self.set_absorption(lf, absorbed)
        if damage != 0.0f32 {
            let now = self.health()
            self.set_health(lf, now - damage)
            let left = self.absorption - damage
            self.set_absorption(lf, left)
        }
    }

    // `setAbsorptionAmount`: within 0 and its most absorption, `Mth.clamp`.
    fn set_absorption(mut self, lf: LivingFacts, amount: f32) {
        let most = f32.nearest(self.attributes.value(lf.max_absorption))
        self.absorption = if amount < 0.0f32 { 0.0f32 } else { amount.min(most) }
    }

    /// `knockback(power, xd, zd)` (D416): its motion pushed `power` away from the way `xd`, `zd`
    /// points, less as its knockback resistance says, and not at all where that leaves none;
    /// where the way's too short to tell, one drawn from its random, two doubles each way; half
    /// its motion across kept, and on the ground, half up and `power` more, 0.4 at most; its
    /// tracker to send it, `needsSync`.
    pub fn knockback(mut self, lf: LivingFacts, power: f64, xd: f64, zd: f64) {
        let p = power * (1.0 - self.attributes.value(lf.knockback_resistance))
        if p <= 0.0 {
            return
        }
        self.body.needs_sync = true
        var x = xd
        var z = zd
        while x * x + z * z < f64(1.0e-5f32) {
            x = (self.body.random.next_double() - self.body.random.next_double()) * 0.01
            z = (self.body.random.next_double() - self.body.random.next_double()) * 0.01
        }
        // `Vec3.normalize`, then `scale`.
        let length = (x * x + z * z).sqrt()
        let (px, pz) = if length < f64(1.0e-5f32) { (0.0, 0.0) } else { (x / length * p, z / length * p) }
        self.body.vx = self.body.vx / 2.0 - px
        if self.body.on_ground {
            self.body.vy = (self.body.vy / 2.0 + p).min(0.4)
        }
        self.body.vz = self.body.vz / 2.0 - pz
    }

    /// `handleKillingBlow` and `setPose(DYING)`, as `die` has them (D416): it's died, and lies
    /// dying. What it drops and its entity event 3 are its level's, between.
    pub fn killed(mut self) {
        self.dead = true
    }

    pub fn lie_dying(mut self) {
        self.data.set(POSE_ID, Value.Number(DYING))
    }

    /// Its air, `getAirSupply`.
    pub fn air(self) -> i32 {
        return self.data.number(AIR_SUPPLY)
    }

    // `setAirSupply`, kept with its body for its save.
    fn set_air(mut self, air: i32) {
        self.data.set(AIR_SUPPLY, Value.Number(air))
        self.body.air = air
    }

    /// Whether it's silent, `isSilent`, which plays none of its sounds.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    // `Entity.playSound`: `sound` where it is, unless it's silent.
    pub fn play(self, sounds: mut List<EntitySound>, sound: own String, volume: f32, pitch: f32) {
        if not self.silent() {
            sounds.push(EntitySound { sound: sound, x: self.body.x, y: self.body.y, z: self.body.z, volume: volume, pitch: pitch, source: self.body.sound_source })
        }
    }

    // Its body's `updateFluidInteraction`, which splashes into water, unheard where it's silent.
    fn update_fluids<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let heard = sounds.len()
        _ = self.body.update_fluids(f, t, blocks, fast_lava, true, mut sounds)
        if self.silent() {
            sounds.truncate(heard)
        }
    }

    /// The rest of `LivingEntity.baseTick` once `entity_tick`'s done and its fire's hurt it, in a
    /// level whose floor is `min_y`, as an armor stand has it, `heard` of its tick's sounds
    /// played: below the level gone, killed, `onBelowWorld`; `entity_tick_end`; its air,
    /// `breathe`, though it breathes in water; and `living_tick_end`. A mob is hurt as it goes,
    /// `Mob.base_tick` (D424); an armor stand's fire hurts it as its own hurt has it,
    /// `ArmorStand.tick` (D441).
    pub fn base_tick_end<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, min_y: i32, heard: usize, players: List<Follower>) {
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        self.entity_tick_end()
        if self.alive() {
            _ = self.breathe(f, t, blocks, lf, false, true, heard)
        }
        self.living_tick_end(heard, players)
    }

    /// `commonTick` and `Entity.baseTick` up to its look below the level, where lava's fast if
    /// `fast_lava`: its turns and place as its tick begins, its count; its portal cooldown, its
    /// fluids, its fire, and lava halving its fall. Where it's immune its fire's put out; else a
    /// tick of it burns, and every 20 out of lava it hurts, 1 of `on_fire`, which it gives back for
    /// its own hurt to deal (D434).
    pub fn entity_tick<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        if self.invulnerable_time > 0 {
            self.invulnerable_time -= 1
        }
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.y_rot_o = self.body.y_rot
        self.x_rot_o = self.body.x_rot
        self.body.tick_count += 1
        self.refresh_body(lf)
        // `Entity.baseTick`.
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        self.update_fluids(f, t, blocks, fast_lava, mut sounds)
        let immune = self.fire_immune
        let burns = self.body.fire_tick(immune)
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        return burns
    }

    /// The rest of `Entity.baseTick`, after its look below the level: whether it's on fire, its
    /// shared flag, and its first tick over.
    pub fn entity_tick_end(mut self) {
        let shown = self.body.fire_shown()
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, shown)
        self.body.first_tick = false
    }

    /// `Entity.isInWall`, as a living entity that isn't asleep has it (D425), `in_wall_at` where it
    /// is.
    pub fn in_wall<B: CollisionBlocks>(self, f: Facts, m: MovementStates, lf: LivingFacts, blocks: B) -> bool {
        return in_wall_at(f, m, lf, blocks, self.body.x, self.body.y, self.body.z, self.body.width, self.body.eyes)
    }

    /// `LivingEntity.baseTick`'s air, alive (D424): with its eyes in water but for a bubble
    /// column there, running out where it can't breathe in water, by its type,
    /// `can_breathe_under_water`, or its effects, `breathing`, at -20 given back as 0 with event
    /// 67, then whether it drowns; where it can, coming back 4 a tick, as its effects let it,
    /// `refills`; and out of water, coming back; `heard` the sounds of its tick so far.
    pub fn breathe<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, lf: LivingFacts, breathing: bool, refills: bool, heard: usize) -> bool {
        let eye = self.body.y + f64(self.body.eyes)
        let at_eyes = blocks.collision_state(floor(self.body.x), floor(eye), floor(self.body.z)) ?? 0
        if self.body.water_eyes and f.block(at_eyes) != t.bubble_column {
            if not self.breathes_water and not breathing {
                let now = self.air()
                let breath = self.less_air(lf, now)
                self.set_air(breath)
                if self.air() <= -20 {
                    self.set_air(0)
                    self.show(Shown.Event(67i8), heard)
                    return true
                }
            } else if self.air() < 300 and refills {
                let more = (self.air() + 4).min(300)
                self.set_air(more)
            }
        } else if self.air() < 300 {
            let more = (self.air() + 4).min(300)
            self.set_air(more)
        }
        return false
    }

    /// The end of `LivingEntity.baseTick`, `heard` the sounds of its tick so far: its hurt time
    /// and its cooldown counted down, its death's tick, who hurt it forgotten, and its head's and
    /// body's turns as they were.
    pub fn living_tick_end(mut self, heard: usize, players: List<Follower>) {
        if self.hurt_time > 0 {
            self.hurt_time -= 1
        }
        // Its cooldown from being hurt; dying, its death's tick, `tickDeath`, gone at 20 with
        // entity event 60; and who hurt it forgotten, the player once their 100 ticks are done
        // (D416), and the entity that hurt it last, `getLastHurtByMob`, where it's found among the
        // level's players, `players`, once it isn't alive or 100 ticks after; one not found, as a
        // player who's left, is kept (D442). Mobs that hurt mobs come with those.
        if self.damage_cooldown > 0 {
            self.damage_cooldown -= 1
        }
        if self.dead_or_dying() {
            self.death_time += 1
            if self.death_time >= 20 and not self.body.removed {
                self.show(Shown.Event(60i8), heard)
                self.body.removed = true
            }
        }
        if self.hurt_by_player_memory > 0 {
            self.hurt_by_player_memory -= 1
        } else {
            self.hurt_by_player = none
        }
        if let who = self.hurt_by_mob {
            for p in players {
                if p.uuid == some(who) {
                    if p.dead or self.body.tick_count - self.hurt_by_mob_stamp > 100 {
                        self.hurt_by_mob = none
                    }
                    break
                }
            }
        }
        self.y_head_rot_o = self.y_head_rot
        self.y_body_rot_o = self.y_body_rot
    }

    // `decreaseAirSupply`: a breath less, unless its oxygen bonus spares it, a draw from its
    // random where it has any. Asking for the bonus makes its instance.
    fn less_air(mut self, lf: LivingFacts, air: i32) -> i32 {
        _ = self.attributes.instance(lf.oxygen_bonus)
        let bonus = self.attributes.value(lf.oxygen_bonus)
        if bonus > 0.0 and self.body.random.next_double() >= 1.0 / (bonus + 1.0) {
            return air
        }
        return air - 1
    }

    /// `aiStep` up to what it's inside, where it moves at all, `isEffectiveAi`, as `effective`
    /// says: its jump delay; its motion under 0.003 each way let go; what it's told to walk
    /// slowed; its jump; its travel where it's effective; then what the block it's on does to it,
    /// `step_on_block`, which it gives back (D431). What it's inside follows, as its kind takes
    /// it, an armor stand's `ArmorStand.inside` (D441), then its freezing, `ai_end`.
    pub fn ai_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, effective: bool, sounds: mut List<EntitySound>) -> Stepped {
        _ = self.ai_start()
        self.ai_rest(lf, f, m, t, blocks, fast_lava, effective, mut sounds)
        return self.step_on_block(f, t, blocks)
    }

    /// `aiStep` up to where a mob thinks, `serverAiStep`: its jump's delay counted down, its
    /// motion under 0.003 each way let go, what it's told to walk slowed, `applyInput`, and all of
    /// it let go where it's dying; whether it isn't, so may think.
    pub fn ai_start(mut self) -> bool {
        let dying = not (self.health() > 0.0f32)
        return self.ai_start_as(dying)
    }

    /// `ai_start` for an entity whose `isImmobile` is `immobile`: all it's told let go there, and
    /// whether it may think.
    pub fn ai_start_as(mut self, immobile: bool) -> bool {
        if self.no_jump_delay > 0 {
            self.no_jump_delay -= 1
        }
        if self.body.vx.abs() < 0.003 {
            self.body.vx = 0.0
        }
        if self.body.vz.abs() < 0.003 {
            self.body.vz = 0.0
        }
        if self.body.vy.abs() < 0.003 {
            self.body.vy = 0.0
        }
        self.xxa = self.xxa * 0.98f32
        self.zza = self.zza * 0.98f32
        if immobile {
            self.jumping = false
            self.xxa = 0.0f32
            self.zza = 0.0f32
            return false
        }
        return true
    }

    /// The rest of `aiStep`, after a mob's thought: its jump, and `travel` where it moves,
    /// `effective`. What the block it's on does to it, `step_on_block`, and its freezing,
    /// `ai_end`, follow (D431).
    pub fn ai_rest<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, effective: bool, sounds: mut List<EntitySound>) {
        if self.jumping {
            self.jump(lf, f, m, t, blocks)
        } else {
            self.no_jump_delay = 0
        }
        if effective {
            self.travel(lf, f, m, t, blocks, fast_lava, mut sounds)
        }
    }

    /// `applyEffectsFromBlocks` as it begins, `stepOn` (D431): where blocks act on it, as they
    /// don't on what's taken out or goes through them, `isAffectedByBlocks`, and it's on the
    /// ground, what the block it's on, `getOnPosLegacy`, does to it, where it doesn't step
    /// carefully, `isSteppingCarefully`, holding shift: magma burns it, `Stepped.Magma`, as its
    /// own hurt deals it; a slime block slows it across, by 0.4 and a fifth of how fast it goes up
    /// or down, where that's under 0.1; and redstone ore's lit, `Stepped.Ore`, by its level. What
    /// turtle eggs do, and sculk sensors and, for a player, sculk shriekers however they step, is
    /// said to be missing. What it's inside follows, `inside_blocks` (D434).
    pub fn step_on_block<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B) -> Stepped {
        if self.body.removed or self.body.no_physics or not self.body.on_ground {
            return Stepped.Nothing
        }
        let (x, y, z) = self.body.on_pos(f, t, blocks, 0.2f32)
        let state = blocks.collision_state(x, y, z) ?? 0
        let block = f.block(state)
        let careful = self.body.shift
        if f.is_a(block, String("MagmaBlock")) {
            return if careful { Stepped.Nothing } else { Stepped.Magma }
        }
        if f.is_a(block, String("SlimeBlock")) {
            let up = self.body.vy.abs()
            if up < 0.1 and not careful {
                let scale = 0.4 + up * 0.2
                self.body.vx = self.body.vx * scale
                self.body.vz = self.body.vz * scale
            }
            return Stepped.Nothing
        }
        if f.is_a(block, String("RedStoneOreBlock")) {
            return if careful { Stepped.Nothing } else { Stepped.Ore((x, y, z)) }
        }
        if f.is_a(block, String("TurtleEggBlock")) {
            return if careful { Stepped.Nothing } else { Stepped.Missing(String("Turtle eggs broken by what steps on them")) }
        }
        if f.is_a(block, String("SculkSensorBlock")) and (f.get_name(state, String("sculk_sensor_phase")) ?? String()) == "inactive" {
            return Stepped.Missing(String("Sculk sensors stepped on"))
        }
        if self.body.player and f.is_a(block, String("SculkShriekerBlock")) {
            return Stepped.Missing(String("Sculk shriekers stepped on by players"))
        }
        return Stepped.Nothing
    }

    /// `aiStep`'s freezing, after what blocks do to it: its frozen ticks thawing 2 a tick, and the
    /// powder snow's slowing taken off and put back as they say, which makes its speed's
    /// instance. Powder snow, which it would be in, waits for powder snow (D434).
    pub fn ai_end<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B) {
        let frozen = self.data.number(TICKS_FROZEN)
        let thawed = if frozen - 2 > 0 { frozen - 2 } else { 0 }
        self.data.set(TICKS_FROZEN, Value.Number(thawed))
        let snow = powder_snow_id()
        self.attributes.take_off(lf.movement_speed, snow.copy())
        if thawed > 0 {
            let (ox, oy, oz) = self.body.on_pos(f, t, blocks, 0.2f32)
            if not f.is_air(blocks.collision_state(ox, oy, oz) ?? 0) {
                let part = f32.nearest(f64(thawed.min(TICKS_TO_FREEZE))) / f32.nearest(f64(TICKS_TO_FREEZE))
                self.attributes.replace(lf.movement_speed, Modifier { id: snow, amount: f64(-0.05f32 * part), operation: ADD_VALUE })
            }
        }
    }

    /// The moves the blocks it's inside act on it along this tick, its body's, `final_moves`
    /// (D434).
    pub fn final_moves(mut self) -> List<Movement> {
        return self.body.final_moves()
    }

    /// Whether it's on fire, `isOnFire`: fire ticks left, where fire burns it at all.
    pub fn on_fire(self) -> bool {
        return self.body.burning(self.fire_immune)
    }

    /// What `applyEffectsFromBlocks` keeps of it before what it's inside acts on it (D434):
    /// whether it was on fire and freezing, `isFreezing`, and its fire ticks.
    pub fn fire_before(self) -> (bool, bool, i32) {
        return (self.on_fire(), self.data.number(TICKS_FROZEN) > 0, self.body.fire)
    }

    /// `entityInside` of the block `i` it went into, as it goes in, as `touch_block` has it for
    /// what's alive (D434).
    pub fn touch(self, f: Facts, i: Inside, c: mut Collector) -> Touched {
        return touch_block(f, i, mut c, true, false, self.body.on_ground, self.body.y)
    }

    /// One of the effects blocks put on it, `InsideBlockEffectType`'s (D434), `added` the fire
    /// ticks a player's level drew where fire lights them past their wait, `ignite_draws`: its
    /// thawing, `clearFreeze`; fire's lighting, `fireIgnite`; lava's, 15 seconds of fire,
    /// `lavaIgnite`; its putting out, `clearFire`. Freezing comes with powder snow.
    pub fn apply_effect(mut self, kind: i32, added: i32) {
        if kind == CLEAR_FREEZE {
            self.data.set(TICKS_FROZEN, Value.Number(0))
        } else if kind == FIRE_IGNITE {
            let immune = self.fire_immune
            if self.body.fire_ignite(immune, added) {
                self.data.set(TICKS_FROZEN, Value.Number(0))
            }
        } else if kind == LAVA_IGNITE {
            if not self.fire_immune {
                self.ignite_for_ticks(300)
            }
        } else if kind == EXTINGUISH {
            self.body.put_out()
        }
    }

    /// Whether fire lighting it draws from its level first, as a player's does where their fire's
    /// waited out, `fireIgnite`: 1 or 2 more ticks of it.
    pub fn ignite_draws(self) -> bool {
        return self.body.player and not self.fire_immune and self.body.fire >= 0
    }

    /// `igniteForTicks`: on fire for `ticks` where it has less left, its freezing let go.
    pub fn ignite_for_ticks(mut self, ticks: i32) {
        self.body.ignite_for(ticks)
        self.data.set(TICKS_FROZEN, Value.Number(0))
    }

    /// The end of `applyEffectsFromBlocks` (D434), `was` what `fire_before` kept, as its body's
    /// `after_inside` has it, with its freezing.
    pub fn after_inside(mut self, was: (bool, bool, i32), rained: bool, sounds: mut List<EntitySound>) {
        let immune = self.fire_immune
        let freezing = self.data.number(TICKS_FROZEN) > 0
        self.body.after_inside(immune, was, freezing, rained, mut sounds)
    }

    /// What what it wears and holds does against the damage `d` of `types`, enchanted, as its level
    /// `blocks` works it out, `Warding` (D439): whether it's immune, and if not, its protection,
    /// against the damage in its context, itself, `this` to loot, where it is, and `attacker`, a
    /// player, where that caused it and dealt it; none where nothing it has is enchanted. A mob's
    /// and an armor stand's alike (D441).
    pub fn ward<B: Warding, W: Wearing>(self, blocks: B, items: W, types: DamageTypes, d: Damage, this: LootEntity, attacker: LootEntity?, missing: mut List<String>) -> Ward {
        var enchanted = false
        for each in self.equipment {
            if let s = each {
                if not items.worn_enchantments(s.copy()).is_empty() {
                    enchanted = true
                }
            }
        }
        if not enchanted {
            return Ward()
        }
        let params = LootParams { origin: some((self.body.x, self.body.y, self.body.z)), this_entity: true, this: some(this.copy()), damage_source: true, attacker: attacker.copy(), direct_attacker: attacker.copy(), direct: true, damage_tags: some(types.tags_of(d.kind)) }
        let worn = self.equipment.copy()
        let (immune, why) = blocks.immune(worn.copy(), params.copy())
        for m in why {
            missing.push(m.copy())
        }
        if immune {
            return Ward { immune: true }
        }
        let (protection, unknown) = blocks.protection(worn, params)
        for m in unknown {
            missing.push(m.copy())
        }
        return Ward { protection: protection }
    }

    // The jump in `aiStep`, as it's told to jump: up through water or lava deeper than it jumps
    // out of, 0.04 a tick; else off the ground, or out of shallow water, every 10 ticks at most.
    fn jump<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        let lava = self.body.in_lava()
        let height = if lava { self.body.lava } else { self.body.water }
        let wet = self.body.in_water and height > 0.0
        let threshold = self.jump_threshold()
        if not wet or (self.body.on_ground and not (height > threshold)) {
            if not lava or (self.body.on_ground and self.body.lava <= threshold) {
                if (self.body.on_ground or (wet and height <= threshold)) and self.no_jump_delay == 0 {
                    self.jump_from_ground(lf, f, m, t, blocks)
                    self.no_jump_delay = 10
                }
            } else {
                self.body.vx = self.body.vx + 0.0
                self.body.vy = self.body.vy + f64(0.04f32)
                self.body.vz = self.body.vz + 0.0
            }
        } else {
            self.body.vx = self.body.vx + 0.0
            self.body.vy = self.body.vy + f64(0.04f32)
            self.body.vz = self.body.vz + 0.0
        }
    }

    // `jumpFromGround`: up as fast as it jumps, `getJumpPower`, its jump strength by the jump
    // factor of the block it's in, or of the one below where that's 1, unless it's going up
    // faster already; its place then sent.
    fn jump_from_ground<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        let (bx, by, bz) = self.body.block()
        let here = m.jump_factor(f.block(blocks.collision_state(bx, by, bz) ?? 0))
        let (px, py, pz) = self.body.on_pos(f, t, blocks, 0.500001f32)
        let below = m.jump_factor(f.block(blocks.collision_state(px, py, pz) ?? 0))
        let factor = if f64(here) == 1.0 { below } else { here }
        let power = f32.nearest(self.attributes.value(lf.jump_strength)) * 1.0f32 * factor + 0.0f32
        if not (power <= 1.0e-5f32) {
            let up = f64(power)
            self.body.vy = if up > self.body.vy { up } else { self.body.vy }
            self.body.needs_sync = true
        }
    }

    // `getFluidJumpThreshold`: 0.4, or none where its eyes are lower than that.
    fn jump_threshold(self) -> f64 {
        return if f64(self.body.eyes) < 0.4 { 0.0 } else { 0.4 }
    }

    /// `travel`: through water or lava where it's in either and they move it, which they don't
    /// where it flies, `isAffectedByFluids`, else through the air; then, flying, its motion up or
    /// down 0.6 of what it was, as `Player.travel` has it (D419).
    pub fn travel<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let was_up = self.body.vy
        if (self.body.in_water or self.body.in_lava()) and not self.flying {
            let falling = self.body.vy <= 0.0
            let old_y = self.body.y
            let gravity = self.body.gravity_now()
            if self.body.in_water {
                self.travel_in_water(lf, f, m, t, blocks, fast_lava, gravity, falling, old_y, mut sounds)
            } else {
                self.travel_in_lava(lf, f, m, t, blocks, fast_lava, gravity, falling, old_y, mut sounds)
            }
        } else {
            self.travel_in_air(lf, f, m, t, blocks, fast_lava, mut sounds)
        }
        if self.flying {
            self.body.vy = was_up * 0.6
        }
    }

    // `travelInAir`: on the ground, as slippery as the block below it, `computeModifiedFriction`
    // by its friction modifier, it walks as fast as that lets it, then moves, up 0.2 a tick where it
    // climbs into a wall or jumps; it falls as its gravity says, and is slowed by the air and that
    // block.
    fn travel_in_air<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) {
        let (px, py, pz) = self.body.on_pos(f, t, blocks, 0.500001f32)
        let friction = if self.body.on_ground {
            modified_friction(m.friction(f.block(blocks.collision_state(px, py, pz) ?? 0)), f32.nearest(self.attributes.value(lf.friction_modifier)))
        } else {
            1.0f32
        }
        // `handleRelativeFrictionAndCalculateMovement`.
        let walk = self.friction_speed(friction)
        self.move_relative(walk)
        self.climb_clamp(lf, f, blocks)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        let mx = self.body.vx
        var my = self.body.vy
        let mz = self.body.vz
        if (self.body.horizontal_collision or self.jumping) and self.on_climbable(lf, f, blocks) {
            my = 0.2
        }
        my = my - self.body.gravity_now()
        let drag = f32.nearest(self.attributes.value(lf.air_drag_modifier))
        let in_air = modified_friction(0.91f32, drag)
        let across = friction * in_air
        let up = modified_friction(0.98f32, drag)
        self.body.vx = mx * f64(across)
        self.body.vy = my * f64(up)
        self.body.vz = mz * f64(across)
    }

    // `travelInWater`: slowed by the water, 0.9 sprinting (D419), as its movement efficiency lets
    // it, half that off the ground, it swims at 0.02 a tick, moves, up 0.2 a tick where it climbs
    // into a wall, is slowed 0.8 up and down, held up as water holds it unless it sprints, and
    // jumps out over an edge it's pushed against.
    fn travel_in_water<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, gravity: f64, falling: bool, old_y: f64, sounds: mut List<EntitySound>) {
        var slow = if self.sprinting { 0.9f32 } else { self.water_slow_down }
        var swim = 0.02f32
        var walker = f32.nearest(self.attributes.value(lf.water_efficiency))
        if not self.body.on_ground {
            walker = walker * 0.5f32
        }
        if walker > 0.0f32 {
            slow = slow + (0.54600006f32 - slow) * walker
            swim = swim + (self.speed - swim) * walker
        }
        self.move_relative(swim)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        var mx = self.body.vx
        var my = self.body.vy
        var mz = self.body.vz
        if self.body.horizontal_collision and self.on_climbable(lf, f, blocks) {
            my = 0.2
        }
        mx = mx * f64(slow)
        my = my * f64(0.8f32)
        mz = mz * f64(slow)
        self.body.vx = mx
        self.body.vy = if self.sprinting { my } else { fluid_falling(gravity, falling, my) }
        self.body.vz = mz
        self.jump_out_of_fluid(f, m, blocks, old_y)
    }

    // `travelInLava`: it swims at 0.02 a tick, moves, and is slowed by half, 0.8 up and down where
    // the lava's shallow, held up as lava holds it unless it sprints (D419), then falls a quarter
    // of its gravity and jumps out over an edge it's pushed against.
    fn travel_in_lava<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, gravity: f64, falling: bool, old_y: f64, sounds: mut List<EntitySound>) {
        self.move_relative(0.02f32)
        let (dx, dy, dz) = (self.body.vx, self.body.vy, self.body.vz)
        self.move_self(lf, f, m, t, blocks, dx, dy, dz, fast_lava, mut sounds)
        if self.body.lava <= self.jump_threshold() {
            self.body.vx = self.body.vx * 0.5
            let my = self.body.vy * f64(0.8f32)
            self.body.vy = if self.sprinting { my } else { fluid_falling(gravity, falling, my) }
            self.body.vz = self.body.vz * 0.5
        } else {
            self.body.vx = self.body.vx * 0.5
            self.body.vy = self.body.vy * 0.5
            self.body.vz = self.body.vz * 0.5
        }
        if gravity != 0.0 {
            self.body.vx = self.body.vx + 0.0
            self.body.vy = self.body.vy + -gravity / 4.0
            self.body.vz = self.body.vz + 0.0
        }
        self.jump_out_of_fluid(f, m, blocks, old_y)
    }

    // `jumpOutOfFluid`: pushed against something across, up at 0.3 a tick where 0.6 up from where
    // it began the tick there's neither a block nor a fluid in its way.
    fn jump_out_of_fluid<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, old_y: f64) {
        if not self.body.horizontal_collision {
            return
        }
        let up = self.body.vy + f64(0.6f32) - self.body.y + old_y
        let b = moved(self.body.bounding_box(), self.body.vx, up, self.body.vz)
        if m.colliders(f, blocks, b, self.body.mover()).is_empty() and not any_liquid(f, blocks, b) {
            self.body.vy = f64(0.3f32)
        }
    }

    // `getFrictionInfluencedSpeed`: on the ground, as fast as it walks, faster on what's more
    // slippery than 0.6, the less it grips; in the air, 0.02.
    fn friction_speed(self, friction: f32) -> f32 {
        if not self.body.on_ground {
            return 0.02f32
        }
        if f64(friction) > 0.6 {
            return self.speed * (0.21600002f32 / (friction * friction * friction))
        }
        return self.speed
    }

    // `moveRelative`: what it's told to walk, as long as 1 at most, at `speed`, turned as it's
    // turned, added to its motion.
    fn move_relative(mut self, speed: f32) {
        let ix = f64(self.xxa)
        let iy = f64(self.yya)
        let iz = f64(self.zza)
        let length = ix * ix + iy * iy + iz * iz
        var ax = 0.0
        var ay = 0.0
        var az = 0.0
        if not (length < 1.0e-7) {
            var nx = ix
            var ny = iy
            var nz = iz
            if length > 1.0 {
                let d = (ix * ix + iy * iy + iz * iz).sqrt()
                if d < f64(1.0e-5f32) {
                    nx = 0.0
                    ny = 0.0
                    nz = 0.0
                } else {
                    nx = ix / d
                    ny = iy / d
                    nz = iz / d
                }
            }
            let s = f64(speed)
            let mx = nx * s
            let my = ny * s
            let mz = nz * s
            let turn = f64(self.body.y_rot * 0.017453292f32)
            let sin = f64(table_sin(turn))
            let cos = f64(table_cos(turn))
            ax = mx * cos - mz * sin
            ay = my
            az = mz * cos + mx * sin
        }
        self.body.vx = self.body.vx + ax
        self.body.vy = self.body.vy + ay
        self.body.vz = self.body.vz + az
    }

    /// `onClimbable`: whether the block it's in is climbable, or an open trapdoor over a ladder
    /// facing its way, which it then last climbed; never where it flies, as `Player.onClimbable`
    /// has it (D419).
    pub fn on_climbable<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) -> bool {
        if self.flying {
            return false
        }
        let (bx, by, bz) = self.body.block()
        let climbs = climbable_at(lf, f, blocks, bx, by, bz)
        if climbs {
            self.last_climbable = some((bx, by, bz))
        }
        return climbs
    }

    // `handleOnClimbable`: on what's climbable, its fall forgotten, and no faster than 0.15 a tick
    // across or down, nor down at all where it holds shift, as only a player does, outside
    // scaffolding, `isSuppressingSlidingDownLadder` (D419).
    fn climb_clamp<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B) {
        if not self.on_climbable(lf, f, blocks) {
            return
        }
        self.body.fall = 0.0
        let most = f64(0.15f32)
        self.body.vx = clamp(self.body.vx, -most, most)
        self.body.vz = clamp(self.body.vz, -most, most)
        if self.body.vy < -most {
            self.body.vy = -most
        }
        let (bx, by, bz) = self.body.block()
        if self.body.vy < 0.0 and self.body.shift and f.block(blocks.collision_state(bx, by, bz) ?? 0) != lf.scaffolding {
            self.body.vy = 0.0
        }
    }

    /// `Entity.move` by dx, dy, dz for itself, or a player's as their client moved them,
    /// `MoverType.PLAYER`, the same: backed off an edge it holds shift at, `backed_off` (D420);
    /// with a living entity's `checkFallDamage` where its own side has the say: its fluids again
    /// out of water, its dust thrown up as it lands, the block's `fallOn`, and its last climbed
    /// block forgotten on the ground; then its bounce, its steps unless it's a player flying or
    /// crouched on the ground, `getMovementEmission` (D421), and the block's slowing.
    pub fn move_self<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64, fast_lava: bool, sounds: mut List<EntitySound>) {
        let (bx, bz) = if self.body.no_physics { (dx, dz) } else { self.backed_off(f, m, blocks, dx, dy, dz) }
        let went = self.body.collide_move(f, m, t, blocks, bx, dy, bz) else return
        if self.body.owned {
            if not self.body.in_water {
                self.update_fluids(f, t, blocks, fast_lava, mut sounds)
            }
            if self.body.on_ground and self.body.fall > 0.0 {
                self.throw_dust(lf, f, went, sounds.len())
            }
            if let fell = self.body.fall_check(went.my) {
                self.fall_on(lf, f, m, blocks, went.effect_state, fell, mut sounds)
            }
            if self.body.on_ground {
                self.last_climbable = none
            }
        }
        if self.body.removed {
            return
        }
        self.body.bounce_after(f, m, t, went)
        if not self.body.player or not (self.flying or (self.body.on_ground and self.body.shift)) {
            self.emit(lf, f, t, blocks, went, mut sounds)
        }
        self.body.slow_by_block(f, m, t, blocks)
    }

    // `Player.maybeBackOffFromEdge` (D420): holding shift, as only a player does, not flying, not
    // going up and on the ground or no further than a step above it, `isAboveGround`, its move
    // across cut back 0.05 at a time, along x, then z, then both, while it would take it where it
    // could fall a step, `canFallAtLeast`, to none once it's 0.05 or less.
    fn backed_off<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, dx: f64, dy: f64, dz: f64) -> (f64, f64) {
        let step = f64(self.body.step)
        if not self.body.shift or self.flying or dy > 0.0 {
            return (dx, dz)
        }
        let above = self.body.on_ground or (self.body.fall < step and not self.can_fall(f, m, blocks, 0.0, 0.0, step - self.body.fall))
        if not above {
            return (dx, dz)
        }
        let sx = if dx > 0.0 { 0.05 } else if dx < 0.0 { -0.05 } else { 0.0 }
        let sz = if dz > 0.0 { 0.05 } else if dz < 0.0 { -0.05 } else { 0.0 }
        var x = dx
        var z = dz
        while x != 0.0 and self.can_fall(f, m, blocks, x, 0.0, step) {
            if x.abs() <= 0.05 {
                x = 0.0
                break
            }
            x = x - sx
        }
        while z != 0.0 and self.can_fall(f, m, blocks, 0.0, z, step) {
            if z.abs() <= 0.05 {
                z = 0.0
                break
            }
            z = z - sz
        }
        while x != 0.0 and z != 0.0 and self.can_fall(f, m, blocks, x, z, step) {
            x = if x.abs() <= 0.05 { 0.0 } else { x - sx }
            z = if z.abs() <= 0.05 { 0.0 } else { z - sz }
        }
        return (x, z)
    }

    // `canFallAtLeast`: whether its box, moved dx and dz across and a hair smaller, has nothing
    // under it as far down as `height`, `noCollision`.
    fn can_fall<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, dx: f64, dz: f64, height: f64) -> bool {
        let b = self.body.bounding_box()
        let under = Aabb { min_x: b.min_x + 1.0e-7 + dx, min_y: b.min_y - height - 1.0e-7, min_z: b.min_z + 1.0e-7 + dz, max_x: b.max_x - 1.0e-7 + dx, max_y: b.min_y, max_z: b.max_z - 1.0e-7 + dz }
        return m.colliders(f, blocks, under, self.body.mover()).is_empty()
    }

    // The dust in `checkFallDamage`, landing from a fall past its safe distance on what isn't
    // air: more the further it fell, up to 375, from its place, or from the edge of the block it
    // landed on nearest it where that isn't the one it's over.
    fn throw_dust(mut self, lf: LivingFacts, f: Facts, went: Moved, heard: usize) {
        let power = self.fall_power(lf, self.body.fall).floor()
        let p = if power > 0.0 { power } else { 0.0 }
        if not (p > 0.0) or f.is_air(went.effect_state) {
            return
        }
        var x = self.body.x
        let y = self.body.y
        var z = self.body.z
        let (ex, _, ez) = went.effect
        let (bx, _, bz) = self.body.block()
        if ex != bx or ez != bz {
            let x_off = x - f64(ex) - 0.5
            let z_off = z - f64(ez) - 0.5
            let most = if x_off.abs() > z_off.abs() { x_off.abs() } else { z_off.abs() }
            x = f64(ex) + 0.5 + x_off / most * 0.5
            z = f64(ez) + 0.5 + z_off / most * 0.5
        }
        let scaled = f64(0.2f32) + p / 15.0
        let scale = if scaled < 2.5 { scaled } else { 2.5 }
        self.show(Shown.Dust(FallDust { state: went.effect_state, x: x, y: y, z: z, count: i32.saturate(150.0 * scale) }), heard)
    }

    /// Shows `what`, `heard` of its tick's sounds played.
    pub fn show(mut self, what: own Shown, heard: usize) {
        self.shown.push(what)
        self.shown_after.push(heard)
    }

    // `calculateFallPower`: how far past its safe distance it fell.
    fn fall_power(self, lf: LivingFacts, fell: f64) -> f64 {
        return fell + 1.0e-6 - self.attributes.value(lf.safe_fall)
    }

    // The block's `fallOn`, landing on `state` from `fell` up: hay takes a fifth of its hurt;
    // honey slides, event 54, and takes a fifth; slime takes it all; powder snow plays its fall
    // sound past 4; pointed dripstone pointing up hurts more; beds and shelf mushrooms halve the
    // fall; and the rest pass it on, `causeFallDamage`. Farmland and turtle eggs aren't trampled
    // or broken yet.
    fn fall_on<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, blocks: B, state: u32, fell: f64, sounds: mut List<EntitySound>) {
        let block = f.block(state)
        if f.is_a(block, String("HayBlock")) {
            _ = self.fall_damage(lf, f, blocks, fell, 0.2f32, mut sounds)
        } else if f.is_a(block, String("HoneyBlock")) {
            self.play(mut sounds, String("block.honey_block.slide"), 1.0f32, 1.0f32)
            self.show(Shown.Event(54i8), sounds.len())
            if self.fall_damage(lf, f, blocks, fell, 0.2f32, mut sounds) {
                let (name, volume, pitch) = lf.fall_sound(state)
                self.play(mut sounds, name, volume * 0.5f32, pitch * 0.75f32)
            }
        } else if f.is_a(block, String("SlimeBlock")) {
            _ = self.fall_damage(lf, f, blocks, fell, 0.0f32, mut sounds)
        } else if f.is_a(block, String("PowderSnowBlock")) {
            if not (fell < 4.0) {
                let sound = if fell < 7.0 { self.small_fall.copy() } else { self.big_fall.copy() }
                self.play(mut sounds, sound, 1.0f32, 1.0f32)
            }
        } else if f.is_a(block, String("PointedDripstoneBlock")) and (f.get_name(state, String("vertical_direction")) ?? String()) == String("up") and (f.get_name(state, String("thickness")) ?? String()) == String("tip") {
            _ = self.fall_damage(lf, f, blocks, fell + 2.5, 2.0f32, mut sounds)
        } else {
            let reduced = fell * f64(1.0f32 - m.fall_reduction(block))
            _ = self.fall_damage(lf, f, blocks, reduced, 1.0f32, mut sounds)
        }
    }

    // `LivingEntity.causeFallDamage`: below where it was last given an impulse, only the fall
    // from there; how much it's hurt, `calculateFallDamage`, by its fall damage multiplier; and
    // where it's any, its fall sound, small to 4 and big past, and the block's below it,
    // `playBlockFallSound`. Whether it's hurt; the hurt itself waits for damage.
    fn fall_damage<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, fell: f64, modifier: f32, sounds: mut List<EntitySound>) -> bool {
        var effective = fell
        if let at = self.impulse_at {
            let (_, iy, _) = at
            let from = iy - self.body.y
            effective = if fell < from { fell } else { from }
            if effective <= 0.0 or self.impulse_grace == 0 {
                self.impulse_grace = 0
                self.impulse_at = none
            }
        }
        let damage = if self.fall_immune { 0 } else { floor(self.fall_power(lf, effective) * f64(modifier) * self.attributes.value(lf.fall_multiplier)) }
        if damage <= 0 {
            return false
        }
        self.impulse_grace = 0
        self.impulse_at = none
        let sound = if damage > 4 { self.big_fall.copy() } else { self.small_fall.copy() }
        self.play(mut sounds, sound, 1.0f32, 1.0f32)
        let below = blocks.collision_state(floor(self.body.x), floor(self.body.y - f64(0.2f32)), floor(self.body.z)) ?? 0
        if not self.silent() and not f.is_air(below) {
            let (name, volume, pitch) = lf.fall_sound(below)
            self.play(mut sounds, name, volume * 0.5f32, pitch * 0.75f32)
        }
        return true
    }

    // `applyMovementEmissionAndPlaySound`: how far it's gone, up and down too on what's climbable;
    // past its next step on what isn't air, the step sound of the block it's on, and of the one it
    // stands on where that's another and it's on the ground or climbing; else, in water, a swim.
    fn emit<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, t: BodyFacts, blocks: B, went: Moved, sounds: mut List<EntitySound>) {
        let length = (went.mx * went.mx + went.my * went.my + went.mz * went.mz).sqrt()
        let across = (went.mx * went.mx + went.mz * went.mz).sqrt()
        let gone = f32.nearest(length * f64(0.6f32))
        let gone_across = f32.nearest(across * f64(0.6f32))
        let (sx, sy, sz) = self.body.on_pos(f, t, blocks, 1.0e-5f32)
        let standing = blocks.collision_state(sx, sy, sz) ?? 0
        let climbing = lf.climbable_state(f, standing)
        self.move_dist = self.move_dist + (if climbing { gone } else { gone_across })
        self.fly_dist = self.fly_dist + gone
        if not (self.move_dist > self.next_step) or f.is_air(standing) {
            return
        }
        let same = (sx, sy, sz) == went.effect
        var stepped = self.step_on(lf, f, blocks, went.effect, went.effect_state, true, went.my, mut sounds)
        if not same {
            stepped = self.step_on(lf, f, blocks, (sx, sy, sz), standing, false, went.my, mut sounds) or stepped
        }
        if stepped {
            self.next_step = f32.nearest(f64(i32.saturate(f64(self.move_dist)) + 1))
        } else if self.body.in_water {
            self.next_step = f32.nearest(f64(i32.saturate(f64(self.move_dist)) + 1))
            self.swim_sound(mut sounds)
        }
    }

    // `waterSwimSound`: its swim, as loud as it moves, mostly up and down, at 0.35 of that and 1
    // at most, its pitch drawn from its random.
    fn swim_sound(mut self, sounds: mut List<EntitySound>) {
        let fast = f32.nearest((self.body.vx * self.body.vx * f64(0.2f32) + self.body.vy * self.body.vy + self.body.vz * self.body.vz * f64(0.2f32)).sqrt()) * 0.35f32
        let volume = if fast < 1.0f32 { fast } else { 1.0f32 }
        let a = self.body.random.next_float()
        let b = self.body.random.next_float()
        self.play(mut sounds, self.swim.copy(), volume, 1.0f32 + (a - b) * 0.4f32)
    }

    // `vibrationAndSoundEffectsFromBlock` on `state` at `pos`: on the ground, climbing it or
    // crouched and not going up or down, `my`, (D421), and not swimming (D444), its step sound
    // where it's `heard`, a player's as `player_step` has it, and an amethyst chime; whether it
    // stepped. The steps' game events come with vibrations.
    fn step_on<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, pos: (i32, i32, i32), state: u32, heard: bool, my: f64, sounds: mut List<EntitySound>) -> bool {
        if f.is_air(state) {
            return false
        }
        if not (self.body.on_ground or lf.climbable_state(f, state) or (self.crouching and my == 0.0)) or self.swimming {
            return false
        }
        if heard {
            if self.body.player {
                self.player_step(lf, f, blocks, pos, state, mut sounds)
            } else if self.step_by_block and self.own_step != none {
                if not f.is_liquid(state) {
                    let (name, volume, pitch) = lf.step_sound(state)
                    let mine = self.own_step.copy() ?? String()
                    let stepped = if wood_step(name) { String("entity.horse.step_wood") } else { mine }
                    self.play(mut sounds, stepped, volume * 0.15f32, pitch)
                }
            } else if let stepped = self.own_step {
                self.play(mut sounds, stepped.copy(), 0.15f32, 1.0f32)
            } else {
                let (name, volume, pitch) = lf.step_sound(state)
                self.play(mut sounds, name, volume * 0.15f32, pitch)
            }
            if f.in_set(state, lf.crystal) and self.body.tick_count >= self.chimed_at + 20 {
                self.chime = self.chime * f32.nearest(pow(0.997, f64(self.body.tick_count - self.chimed_at)))
                self.chime = (self.chime + 0.07f32).min(1.0f32)
                let pitch_drawn = 0.5f32 + self.chime * self.body.random.next_float() * 1.2f32
                let loud = 0.1f32 + self.chime * 1.2f32
                self.play(mut sounds, String("block.amethyst_block.chime"), loud, pitch_drawn)
                self.chimed_at = self.body.tick_count
            }
        }
        return true
    }

    // `Player.playStepSound` on `state` at `pos` (D421): in water, a swim and the block's step
    // muffled, `playMuffledStepSound`; else the step of the block over it where that's stepped
    // inside, `getPrimaryStepSoundBlockPos`, as snow, or with it, as a carpet,
    // `playCombinationStepSounds`, the block's own muffled after it; else the block's own.
    fn player_step<B: CollisionBlocks>(mut self, lf: LivingFacts, f: Facts, blocks: B, pos: (i32, i32, i32), state: u32, sounds: mut List<EntitySound>) {
        if self.body.in_water {
            self.swim_sound(mut sounds)
            self.muffled_step(lf, state, mut sounds)
            return
        }
        let (x, y, z) = pos
        let above = blocks.collision_state(x, y + 1, z) ?? 0
        let combined = f.in_set(above, lf.combination_step)
        let primary = if combined or f.in_set(above, lf.inside_step) { above } else { state }
        let (name, volume, pitch) = lf.step_sound(primary)
        self.play(mut sounds, name, volume * 0.15f32, pitch)
        if combined {
            self.muffled_step(lf, state, mut sounds)
        }
    }

    // `playMuffledStepSound`: the step of `state`, a third as loud as a step and 0.8 as high.
    fn muffled_step(self, lf: LivingFacts, state: u32, sounds: mut List<EntitySound>) {
        let (name, volume, pitch) = lf.step_sound(state)
        self.play(mut sounds, name, volume * 0.05f32, pitch * 0.8f32)
    }

    /// The end of `LivingEntity.tick`, after its head's turned: each old turn kept within half a
    /// turn of the new, and its impulse's grace time counted down.
    pub fn tick_end(mut self) {
        while self.body.y_rot - self.y_rot_o < -180.0f32 {
            self.y_rot_o = self.y_rot_o - 360.0f32
        }
        while self.body.y_rot - self.y_rot_o >= 180.0f32 {
            self.y_rot_o = self.y_rot_o + 360.0f32
        }
        while self.y_body_rot - self.y_body_rot_o < -180.0f32 {
            self.y_body_rot_o = self.y_body_rot_o - 360.0f32
        }
        while self.y_body_rot - self.y_body_rot_o >= 180.0f32 {
            self.y_body_rot_o = self.y_body_rot_o + 360.0f32
        }
        while self.body.x_rot - self.x_rot_o < -180.0f32 {
            self.x_rot_o = self.x_rot_o - 360.0f32
        }
        while self.body.x_rot - self.x_rot_o >= 180.0f32 {
            self.x_rot_o = self.x_rot_o + 360.0f32
        }
        while self.y_head_rot - self.y_head_rot_o < -180.0f32 {
            self.y_head_rot_o = self.y_head_rot_o - 360.0f32
        }
        while self.y_head_rot - self.y_head_rot_o >= 180.0f32 {
            self.y_head_rot_o = self.y_head_rot_o + 360.0f32
        }
        if self.impulse_grace > 0 {
            self.impulse_grace -= 1
        }
    }

    /// What `Entity.load` and `LivingEntity.readAdditionalSaveData` read of `tag` into it: what
    /// every entity reads, `world.body`'s, then into its values its air, name's showing, silence,
    /// gravity, glowing and frozen ticks; its absorption, attributes, health within its most, hurt
    /// and death times, fall flying, and its impulse's grace and place; and what it keeps as it
    /// was. False where it's somewhere that isn't a number, logged in `lines`.
    pub fn load_from(mut self, lf: LivingFacts, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.set_air(int_or(tag, "Air", 300))
        // Its custom name, `setCustomName`, its saved text component as it is (D441).
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.invulnerable_time = int_or(tag, "invulnerable_time", 0)
        _ = self.body.extras.remove("invulnerable_time")
        _ = self.body.extras.remove("TicksFrozen")
        self.absorption = float_or(tag, "AbsorptionAmount", 0.0f32)
        if tag.contains("attributes") {
            self.attributes.apply(tag["attributes"].copy())
        }
        let most = self.max_health(lf)
        self.set_health(lf, float_or(tag, "Health", most))
        self.hurt_time = i32(short_or(tag, "HurtTime", 0i16))
        self.death_time = i32(short_or(tag, "DeathTime", 0i16))
        self.data.set_flag(SHARED_FLAGS, FALL_FLYING_FLAG, bool_or(tag, "FallFlying"))
        self.impulse_grace = int_or(tag, "current_impulse_context_reset_grace_time", 0)
        self.impulse_at = vec3_of(tag, "current_explosion_impact_pos")
        for key in ["active_effects", "sleeping_pos", "locator_bar_icon"] {
            if tag.contains(key) {
                self.kept.insert(String(key), tag[key].copy())
            }
        }
        // Who last hurt it (D416), each by UUID, as `EntityReference.read` reads it.
        self.hurt_by_player = uuid_of(tag, "last_hurt_by_player")
        self.hurt_by_player_memory = int_or(tag, "last_hurt_by_player_memory_time", 0)
        self.hurt_by_mob = uuid_of(tag, "last_hurt_by_mob")
        self.hurt_by_mob_stamp = self.body.tick_count - int_or(tag, "ticks_since_last_hurt_by_mob", 0)
        if tag.contains("equipment") {
            if let Tag.Compound(worn) = tag["equipment"] {
                let names = slot_names()
                for slot in 0..names.len() {
                    if worn.contains(names[slot].copy()) {
                        self.equipment[slot] = some(worn[names[slot].copy()].copy())
                    }
                }
            }
        }
        self.y_rot_o = self.body.y_rot
        self.x_rot_o = self.body.x_rot
        self.refresh_body(lf)
        return true
    }

    /// What `saveAsPassenger` saves of it before its type's own, as `kind`: what every entity
    /// saves, `world.body`'s, its air and frozen ticks from its values; then
    /// `LivingEntity.addAdditionalSaveData`'s, in the order vanilla puts them, its health, hurt and
    /// death times, absorption, impulse, attributes, fall flying and an empty brain, with what it
    /// keeps where vanilla puts it.
    pub fn save_into(self, t: mut JavaHashMap<String, Tag>, kind: str) {
        var body = self.body.copy()
        body.air = self.air()
        if self.invulnerable_time > 0 {
            body.extras.insert(String("invulnerable_time"), Tag.Int(self.invulnerable_time))
        }
        let frozen = self.data.number(TICKS_FROZEN)
        if frozen > 0 {
            body.extras.insert(String("TicksFrozen"), Tag.Int(frozen))
        }
        body.save_into(mut t, kind)
        t.insert(String("Health"), Tag.Float(self.health()))
        t.insert(String("HurtTime"), Tag.Short(i16.wrap(self.hurt_time)))
        t.insert(String("DeathTime"), Tag.Short(i16.wrap(self.death_time)))
        t.insert(String("AbsorptionAmount"), Tag.Float(self.absorption))
        t.insert(String("current_impulse_context_reset_grace_time"), Tag.Int(self.impulse_grace))
        if let at = self.impulse_at {
            let (x, y, z) = at
            t.insert(String("current_explosion_impact_pos"), Tag.List([Tag.Double(x), Tag.Double(y), Tag.Double(z)]))
        }
        t.insert(String("attributes"), self.attributes.pack())
        self.put_kept(mut t, "active_effects")
        t.insert(String("FallFlying"), flag(i32(self.data.byte(SHARED_FLAGS)) & FALL_FLYING_FLAG != 0))
        self.put_kept(mut t, "sleeping_pos")
        var brain = JavaHashMap<String, Tag>()
        brain.insert(String("memories"), Tag.Compound(JavaHashMap<String, Tag>()))
        t.insert(String("Brain"), Tag.Compound(brain))
        if let who = self.hurt_by_player {
            t.insert(String("last_hurt_by_player"), uuid_tag(who))
            t.insert(String("last_hurt_by_player_memory_time"), Tag.Int(self.hurt_by_player_memory))
        }
        if let who = self.hurt_by_mob {
            t.insert(String("last_hurt_by_mob"), uuid_tag(who))
            t.insert(String("ticks_since_last_hurt_by_mob"), Tag.Int(self.body.tick_count - self.hurt_by_mob_stamp))
        }
        let names = slot_names()
        var worn = JavaHashMap<String, Tag>()
        for slot in 0..names.len() {
            if let stack = self.equipment[slot] {
                worn.insert(names[slot].copy(), stack.copy())
            }
        }
        if not worn.is_empty() {
            t.insert(String("equipment"), Tag.Compound(worn))
        }
        self.put_kept(mut t, "locator_bar_icon")
    }

    fn put_kept(self, t: mut JavaHashMap<String, Tag>, key: str) {
        if self.kept.contains(key) {
            t.insert(String(key), self.kept[key].copy())
        }
    }
}

impl LivingFacts {
    // The state's sound type's step sound, with its volume and pitch.
    fn step_sound(self, state: u32) -> (String, f32, f32) {
        let at = usize(self.state_sounds[usize(state)])
        return (self.step_names[at].copy(), self.volumes[at], self.pitches[at])
    }

    /// A state's fall sound, with its volume and pitch, which a player's falls play too (D418).
    pub fn fall_sound(self, state: u32) -> (String, f32, f32) {
        let at = usize(self.state_sounds[usize(state)])
        return (self.fall_names[at].copy(), self.volumes[at], self.pitches[at])
    }
}

/// An armor stand, as vanilla's `ArmorStand` makes, runs and saves it: a living entity 0.5 across
/// and 1.975 high, its eyes 1.7775 up; half that, its eyes 0.9875 up, where it's small; and no size
/// where it's a marker. It breathes under water, its falls sound as an armor stand's, and it has
/// physics, so moves, only where it's neither a marker nor without gravity. Its body turns as it's
/// turned, `tickHeadTurn`, and its head with them as it's loaded. Its flags, whether it's small,
/// shows its arms, hides its base plate or is a marker, and its six poses are its values.
/// Who's behind a damage to an armor stand, as `ArmorStand.hurtServer` reads it (D441): a mob,
/// where mob griefing's off, which it ignores; and a player who mayn't build, `mayBuild`, who can't
/// break it.
pub struct StandHurter {
    pub mob_without_griefing: bool = false
    pub player_without_building: bool = false
}

/// What an armor stand's hurt did, `ArmorStand.hurt` (D441): whether it was hurt, as
/// `hurtServer` answers, which a player's attack goes on by; whether it was hit and shaken,
/// entity event 32; and its breaking, where it broke.
pub struct StandHurt {
    pub hurt: bool = false
    pub hit: bool = false
    pub broken: StandBreak? = none
}

/// What's left for its level to do of an armor stand's breaking (D441), it taken out already,
/// `kill`: where it was, its block `blockPosition`, and its size; whether it drops itself, an
/// armor stand item named as it was, `name`, as a player's breaking has it, `brokenByPlayer`;
/// whether it drops its loot, where it isn't small, and what it wore, `brokenByAnything`; and
/// whether its particles are shown, `showBreakingParticles`. Its sound always plays,
/// `playBrokenSound`.
pub struct StandBreak {
    pub x: f64
    pub y: f64
    pub z: f64
    pub width: f32
    pub height: f32
    pub itself: bool = false
    pub name: Tag? = none
    pub drops: bool = false
    pub small: bool = false
    pub equipment: List<Tag?> = List<Tag?>()
    pub particles: bool = false
}

pub struct ArmorStand {
    pub living: Living
    /// Whether it's invisible, as it was set, and the slots that can't be taken from or put in,
    /// `disabledSlots`, kept for its save.
    pub invisible: bool = false
    pub disabled_slots: i32 = 0
    /// The game time it was last hit, `lastHit`, which isn't saved (D441).
    pub last_hit: i64 = 0i64
}

impl ArmorStand {
    /// One at x, y, z, of the type `kind`, with its own random seeded `seed`, as vanilla's
    /// constructor makes it.
    pub fn new(lf: LivingFacts, kind: u32, id: i32, seed: i64, x: f64, y: f64, z: f64) -> ArmorStand {
        var l = Living.made(lf, kind, id, seed, x, y, z, 0.5f32, 1.975f32, 1.7775f32, armor_stand_data())
        l.breathes_water = true
        l.small_fall = String("entity.armor_stand.fall")
        l.big_fall = String("entity.armor_stand.fall")
        return ArmorStand { living: l }
    }

    /// The one `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `load` reads it in: what every living entity reads, `Living.load_from`; its
    /// head and body turned as it's turned; then whether it's invisible, small, shows its arms,
    /// hides its base plate or is a marker, its disabled slots, its physics, and its poses where
    /// they read, each `Rotations`' three floats, a turn at most, an angle that isn't finite none.
    /// None where it doesn't load, logged in `lines`.
    pub fn loaded(lf: LivingFacts, kind: u32, id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> ArmorStand? {
        var a = ArmorStand.new(lf, kind, id, seed, 0.0, 0.0, 0.0)
        if not a.living.load_from(lf, tag, mut lines) {
            return none
        }
        let turn = a.living.body.y_rot
        a.living.y_rot_o = turn
        a.living.y_head_rot = turn
        a.living.y_head_rot_o = turn
        a.living.y_body_rot_o = turn
        a.invisible = bool_or(tag, "Invisible")
        a.living.data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, a.invisible)
        a.set_flag(SMALL_FLAG, bool_or(tag, "Small"))
        a.set_flag(ARMS_FLAG, bool_or(tag, "ShowArms"))
        a.disabled_slots = int_or(tag, "DisabledSlots", 0)
        a.set_flag(NO_BASE_PLATE_FLAG, bool_or(tag, "NoBasePlate"))
        a.set_flag(MARKER_FLAG, bool_or(tag, "Marker"))
        a.living.body.no_physics = not a.has_physics()
        if tag.contains("Pose") {
            if let poses = read_poses(tag["Pose"]) {
                let ids: List<usize> = [HEAD_POSE, BODY_POSE, LEFT_ARM_POSE, RIGHT_ARM_POSE, LEFT_LEG_POSE, RIGHT_LEG_POSE]
                for i in 0..ids.len() {
                    let (x, y, z) = poses[i]
                    a.living.data.set(ids[i], Value.Rotations(x, y, z))
                }
            }
        }
        return some(a)
    }

    /// Its flags, `DATA_CLIENT_FLAGS`.
    pub fn flags(self) -> i32 {
        return i32(self.living.data.byte(STAND_FLAGS))
    }

    /// Whether it's a marker, `isMarker`, and small, `isSmall`.
    pub fn marker(self) -> bool {
        return self.flags() & MARKER_FLAG != 0
    }

    pub fn small(self) -> bool {
        return self.flags() & SMALL_FLAG != 0
    }

    /// `hasPhysics`: neither a marker nor without gravity.
    pub fn has_physics(self) -> bool {
        return not self.marker() and not self.living.data.flag(NO_GRAVITY)
    }

    // A flag set or cleared, and its size made again where that changed it, as
    // `onSyncedDataUpdated` refreshes its dimensions, where it is.
    fn set_flag(mut self, bit: i32, on: bool) {
        self.living.data.set_flag(STAND_FLAGS, bit, on)
        if self.marker() {
            self.living.body.width = 0.0f32
            self.living.body.height = 0.0f32
            self.living.body.eyes = 0.0f32
        } else if self.small() {
            self.living.body.width = 0.5f32 * 0.5f32
            self.living.body.height = 1.975f32 * 0.5f32
            self.living.body.eyes = 0.9875f32
        } else {
            self.living.body.width = 0.5f32
            self.living.body.height = 1.975f32
            self.living.body.eyes = 1.7775f32
        }
    }

    /// What it is to loot's predicates (D441): an armor stand, on fire or not, a baby where it's
    /// small, `isBaby`, holding what's in its main hand.
    pub fn loot_entity(self) -> LootEntity {
        return LootEntity { kind: String("minecraft:armor_stand"), on_fire: self.living.body.fire > 0 or self.living.body.extras.contains("HasVisualFire"), baby: self.small(), hand: self.living.equipment[0].copy() }
    }

    /// `hurtServer` of the damage `d` of `types` at the game time `now` (D441), `by` who's behind
    /// it, `immune` where what it wears makes it immune, `isImmuneToDamage`; how much is never
    /// read. Nothing where it's gone, or a mob's behind it with mob griefing off; killed, taken
    /// out with nothing dropped, by what bypasses invulnerability; nothing where it's invulnerable
    /// to it, `isInvulnerableTo`, invisible or a marker; broken by an explosion,
    /// `brokenByAnything`. What ignites armor stands lights it for 5 seconds, or where it's on fire
    /// wears it down 0.15, `causeDamage`; what burns armor stands wears it down 4 while it has more
    /// than half a point left. Else only what can break it or always kills it does anything, and
    /// not where a player who mayn't build is behind it: a creative player breaks it at once,
    /// nothing dropped but its sound and particles shown; a hit more than 5 ticks after its last,
    /// of what doesn't always kill it, shakes it, entity event 32, its time kept; and else it's
    /// broken as a player breaks it, `brokenByPlayer`, itself dropped first, its particles
    /// after. None of those hits takes its health.
    pub fn hurt(mut self, lf: LivingFacts, types: DamageTypes, d: Damage, now: i64, by: StandHurter, immune: bool) -> StandHurt {
        if self.living.body.removed or by.mob_without_griefing {
            return StandHurt()
        }
        if types.is(d.kind, BYPASSES_INVULNERABILITY) {
            self.living.body.removed = true
            return StandHurt()
        }
        if self.living.invulnerable_to(types, d, self.living.fire_immune, immune) or self.invisible or self.marker() {
            return StandHurt()
        }
        if types.is(d.kind, IS_EXPLOSION) {
            return StandHurt { broken: some(self.broken(false, true, false)) }
        }
        if types.is(d.kind, IGNITES_ARMOR_STANDS) {
            if self.living.on_fire() {
                return StandHurt { broken: self.worn_down(lf, 0.15f32) }
            }
            self.living.ignite_for_ticks(100)
            return StandHurt()
        }
        if types.is(d.kind, BURNS_ARMOR_STANDS) and self.living.health() > 0.5f32 {
            return StandHurt { broken: self.worn_down(lf, 4.0f32) }
        }
        let breaks = types.is(d.kind, CAN_BREAK_ARMOR_STAND)
        let kills = types.is(d.kind, ALWAYS_KILLS_ARMOR_STANDS)
        if (not breaks and not kills) or by.player_without_building {
            return StandHurt()
        }
        if d.creative {
            return StandHurt { hurt: true, broken: some(self.broken(false, false, true)) }
        }
        if now - self.last_hit > 5i64 and not kills {
            self.last_hit = now
            return StandHurt { hurt: true, hit: true }
        }
        return StandHurt { hurt: true, broken: some(self.broken(true, true, true)) }
    }

    // `causeDamage` of `amount` (D441): its health less it, and broken where no more than half a
    // point would be left, `brokenByAnything`.
    fn worn_down(mut self, lf: LivingFacts, amount: f32) -> StandBreak? {
        let health = self.living.health() - amount
        if health <= 0.5f32 {
            return some(self.broken(false, true, false))
        }
        self.living.set_health(lf, health)
        return none
    }

    // Its breaking (D441), `kill` taking it out: what its level's to do of it, itself dropped
    // where `itself`; its loot and what it wears, taken off it, dropped where `drops`; and its
    // particles shown where `particles`.
    fn broken(mut self, itself: bool, drops: bool, particles: bool) -> StandBreak {
        var worn = List<Tag?>()
        if drops {
            for slot in 0..self.living.equipment.len() {
                worn.push(self.living.equipment[slot].take())
            }
        }
        self.living.body.removed = true
        let name: Tag? = if self.living.body.extras.contains("CustomName") { some(self.living.body.extras["CustomName"].copy()) } else { none }
        let b = self.living.body.copy()
        return StandBreak { x: b.x, y: b.y, z: b.z, width: b.width, height: b.height, itself: itself, name: name, drops: drops, small: self.small(), equipment: worn, particles: particles }
    }

    // A hurt of its own of the type named `name`, `heard` of its tick's sounds played (D441): what
    // it wears tested against it among `blocks`, as a mob's is, then `hurt`, its breaking shown
    // for its level to do. What hurts it of its own is never what breaks or kills armor stands,
    // whose hits alone read the time, so none's given.
    fn hurt_own<B: Warding, W: Wearing>(mut self, lf: LivingFacts, blocks: B, items: W, name: str, heard: usize) {
        let d = Damage.of(lf.damage, name)
        var missing = List<String>()
        let ward = self.living.ward(blocks, items, lf.damage, d, self.loot_entity(), none, mut missing)
        for m in missing {
            self.living.show(Shown.Missing(m.copy()), heard)
        }
        let h = self.hurt(lf, lf.damage, d, 0i64, StandHurter(), ward.immune)
        if let b = h.broken {
            self.living.show(Shown.StandBroken(b.copy()), heard)
        }
    }

    // What it's inside and what that does to it, as `applyEffectsFromBlocks` goes on after
    // `stepOn` (D434): where blocks act on it, the blocks it went into along its moves this tick,
    // while it's alive, a campfire's and a cactus's hurts its own, `hurt_own`, and its fluid's;
    // then the effects they put on it in their order, fire's and lava's hurts its own, lava's
    // sound never heard, as no armor stand's hurt by lava (D441); then the rain, and its fire's
    // end, `after_inside`.
    fn inside<B: CollisionBlocks + Rain + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, blocks: B, items: W, sounds: mut List<EntitySound>) {
        let moves = self.living.final_moves()
        if self.living.body.removed or self.living.body.no_physics {
            return
        }
        let was = self.living.fire_before()
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.living.body.width, self.living.body.height) {
            if not self.living.alive() {
                break
            }
            if i.block {
                c.advance(i.step)
                match self.living.touch(f, i, mut c) {
                    Touched.Campfire(_) => self.hurt_own(lf, blocks, items, "campfire", sounds.len()),
                    Touched.Cactus => self.hurt_own(lf, blocks, items, "cactus", sounds.len()),
                    Touched.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                    Touched.Nothing => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if not self.living.alive() {
                break
            }
            match e {
                BlockEffect.Apply(kind) => self.living.apply_effect(kind, 0),
                BlockEffect.InFire(_) => self.hurt_own(lf, blocks, items, "in_fire", sounds.len()),
                BlockEffect.LavaHurt => {
                    if not self.living.fire_immune {
                        self.hurt_own(lf, blocks, items, "lava", sounds.len())
                    }
                },
                BlockEffect.Doused(_) => {
                    if self.living.on_fire() {
                        self.living.show(Shown.Missing(doused()), sounds.len())
                    }
                },
            }
        }
        let rained = self.living.body.in_rain(blocks)
        self.living.after_inside(was, rained, mut sounds)
    }

    /// Its tick, as `tickNonPassenger` and `LivingEntity.tick` run it among `blocks`, in a level
    /// whose floor is `min_y`, where lava's fast if `fast_lava`: `baseTick`, its fire's hurt its
    /// own, `hurt_own` (D441); its equipment looked at unless it's gone, as nobody's told of a
    /// broken stand's; `aiStep` unless it's gone, moving only where it has physics, magma's hurt
    /// its own, what it's inside, `inside`, then its freezing; its body turned as it's turned, and
    /// the turns kept near.
    pub fn tick<B: CollisionBlocks + Rain + Warding, W: Wearing>(mut self, lf: LivingFacts, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, items: W, min_y: i32, fast_lava: bool, players: List<Follower>, sounds: mut List<EntitySound>) {
        if self.living.entity_tick(lf, f, t, blocks, fast_lava, mut sounds) {
            self.hurt_own(lf, blocks, items, "on_fire", sounds.len())
        }
        self.living.base_tick_end(lf, f, t, blocks, min_y, sounds.len(), players)
        if not self.living.body.removed {
            self.living.detect_equipment(items, sounds.len())
        }
        if not self.living.body.removed {
            let physics = self.has_physics()
            match self.living.ai_step(lf, f, m, t, blocks, fast_lava, physics, mut sounds) {
                Stepped.Magma => self.hurt_own(lf, blocks, items, "hot_floor", sounds.len()),
                Stepped.Ore(at) => self.living.show(Shown.Lit(at), sounds.len()),
                Stepped.Missing(what) => self.living.show(Shown.Missing(what), sounds.len()),
                Stepped.Nothing => {},
            }
            self.inside(lf, f, blocks, items, mut sounds)
            self.living.ai_end(lf, f, t, blocks)
        }
        self.living.y_body_rot_o = self.living.y_rot_o
        self.living.y_body_rot = self.living.body.y_rot
        self.living.tick_end()
    }

    /// What `saveAsPassenger` saves of it, in the order vanilla puts it: what every living entity
    /// saves, `Living.save_into`; then whether it's invisible, small, shows its arms, its disabled
    /// slots, whether it hides its base plate, whether it's a marker where it is, and its poses
    /// that aren't their defaults.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.living.save_into(mut t, "minecraft:armor_stand")
        let flags = self.flags()
        t.insert(String("Invisible"), flag(i32(self.living.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0))
        t.insert(String("Small"), flag(flags & SMALL_FLAG != 0))
        t.insert(String("ShowArms"), flag(flags & ARMS_FLAG != 0))
        t.insert(String("DisabledSlots"), Tag.Int(self.disabled_slots))
        t.insert(String("NoBasePlate"), flag(flags & NO_BASE_PLATE_FLAG != 0))
        if flags & MARKER_FLAG != 0 {
            t.insert(String("Marker"), flag(true))
        }
        var pose = JavaHashMap<String, Tag>()
        let names: List<str> = ["Head", "Body", "LeftArm", "RightArm", "LeftLeg", "RightLeg"]
        let ids: List<usize> = [HEAD_POSE, BODY_POSE, LEFT_ARM_POSE, RIGHT_ARM_POSE, LEFT_LEG_POSE, RIGHT_LEG_POSE]
        for i in 0..ids.len() {
            if not self.living.data.is_default(ids[i]) {
                let (x, y, z) = self.living.data.rotations(ids[i])
                pose.insert(String(names[i]), Tag.List([Tag.Float(x), Tag.Float(y), Tag.Float(z)]))
            }
        }
        t.insert(String("Pose"), Tag.Compound(pose))
        return Tag.Compound(t)
    }
}

/// `Entity.isInWall` of what's at x, y, z, `width` across with its eyes `eyes` up (D425): whether a
/// block about its eyes, in a box 0.8 of its width across and 1e-6 high, `AABB.ofSize`,
/// suffocates, `isSuffocating`, with its collision shape meeting the box, `Shapes.joinIsNotEmpty`
/// with `AND`. A shulker box suffocates only with its lid closed, `NOT_CLOSED_SHULKER` (D440). A
/// block whose chunk isn't loaded full suffocates nothing.
pub fn in_wall_at<B: CollisionBlocks>(f: Facts, m: MovementStates, lf: LivingFacts, blocks: B, x: f64, y: f64, z: f64, width: f32, eyes: f32) -> bool {
    let half = f64(width * 0.8f32) / 2.0
    let eye = y + f64(eyes)
    let b = Aabb { min_x: x - half, min_y: eye - 1.0e-6 / 2.0, min_z: z - half, max_x: x + half, max_y: eye + 1.0e-6 / 2.0, max_z: z + half }
    let mover = Mover { y: 0.0 - f64.MAX, fall: 0.0 }
    for by in floor(b.min_y)..=floor(b.max_y) {
        for bz in floor(b.min_z)..=floor(b.max_z) {
            for bx in floor(b.min_x)..=floor(b.max_x) {
                let state = blocks.collision_state(bx, by, bz) else continue
                if not f.suffocating(state, lf.suffocation) {
                    continue
                }
                if f.is_a(f.block(state), "ShulkerBoxBlock") and blocks.shulker_open(bx, by, bz) {
                    continue
                }
                for s in m.state_boxes(f, state, bx, by, bz, mover) {
                    if meets(moved(s, f64(bx), f64(by), f64(bz)), b) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

/// `onClimbable`'s look at the block at x, y, z, a player's as well as a living entity's
/// (CAL-156): whether it's climbable, or an open trapdoor over a ladder facing its way.
pub fn climbable_at<B: CollisionBlocks>(lf: LivingFacts, f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let state = blocks.collision_state(x, y, z) ?? 0
    if f.in_set(state, lf.climbable) {
        return true
    }
    if f.is_a(f.block(state), String("TrapDoorBlock")) and f.get_bool(state, String("open")) {
        let below = blocks.collision_state(x, y - 1, z) ?? 0
        let facing = f.get_name(state, String("facing")) ?? String()
        return f.block(below) == lf.ladder and (f.get_name(below, String("facing")) ?? String()) == facing
    }
    return false
}

/// `computeModifiedFriction`: a friction made less, `1 - (1 - friction) * modifier`, within 0 and 1.
pub fn modified_friction(friction: f32, modifier: f32) -> f32 {
    let v = 1.0f32 - (1.0f32 - friction) * modifier
    if v < 0.0f32 {
        return 0.0f32
    }
    return if v > 1.0f32 { 1.0f32 } else { v }
}

// `getFluidFallingAdjustedMovement`'s motion up and down: a sixteenth of its gravity down,
// unless it's falling and that would bring it within 0.003 of it, when it sinks at 0.003.
fn fluid_falling(gravity: f64, falling: bool, y: f64) -> f64 {
    if gravity == 0.0 {
        return y
    }
    if falling and (y - 0.005).abs() >= 0.003 and (y - gravity / 16.0).abs() < 0.003 {
        return -0.003
    }
    return y - gravity / 16.0
}

// `containsAnyLiquid`: whether a block from the box's least corner's to its greatest's holds a
// fluid; one whose chunk isn't loaded doesn't.
fn any_liquid<B: CollisionBlocks>(f: Facts, blocks: B, b: Aabb) -> bool {
    for x in floor(b.min_x)..=floor(b.max_x) {
        for y in floor(b.min_y)..=floor(b.max_y) {
            for z in floor(b.min_z)..=floor(b.max_z) {
                if let state = blocks.collision_state(x, y, z) {
                    if f.fluid(state) != 0 {
                        return true
                    }
                }
            }
        }
    }
    return false
}

// `Mth.clamp` of a double.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo
    }
    return if v > hi { hi } else { v }
}

// A boolean as `putBoolean` saves it.
fn flag(b: bool) -> Tag {
    return Tag.Byte(if b { 1i8 } else { 0i8 })
}

// `SPEED_MODIFIER_POWDER_SNOW_ID`.
fn powder_snow_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "powder_snow" }
}

// The number saved as `key` as a float, as `getFloatOr` reads it, or `fallback`.
fn float_or(tag: JavaHashMap<String, Tag>, key: str, fallback: f32) -> f32 {
    if not tag.contains(key) {
        return fallback
    }
    return tag[key].number_float() ?? fallback
}

/// The three numbers saved as `key`, as `Vec3.CODEC` reads them, or none.
pub fn vec3_of(tag: JavaHashMap<String, Tag>, key: str) -> (f64, f64, f64)? {
    if not tag.contains(key) {
        return none
    }
    let Tag.List(items) = tag[key] else return none
    if items.len() != 3 {
        return none
    }
    let x = items[0].number_double() else return none
    let y = items[1].number_double() else return none
    let z = items[2].number_double() else return none
    return some((x, y, z))
}

// An armor stand's poses as `ArmorStandPose.CODEC` reads them: each of the six its default where
// it's missing, else three floats, each within a turn, `Rotations`; none where one's there but
// isn't three numbers, which fails the whole.
fn read_poses(t: Tag) -> List<(f32, f32, f32)>? {
    let Tag.Compound(m) = t else return none
    let names: List<str> = ["Head", "Body", "LeftArm", "RightArm", "LeftLeg", "RightLeg"]
    var out: List<(f32, f32, f32)> = [(0.0f32, 0.0f32, 0.0f32), (0.0f32, 0.0f32, 0.0f32), (-10.0f32, 0.0f32, -10.0f32), (-15.0f32, 0.0f32, 10.0f32), (-1.0f32, 0.0f32, -1.0f32), (1.0f32, 0.0f32, 1.0f32)]
    for i in 0..names.len() {
        if not m.contains(names[i]) {
            continue
        }
        let Tag.List(items) = m[names[i]] else return none
        if items.len() != 3 {
            return none
        }
        var v = List<f32>()
        for item in items {
            let n = item.number_float() else return none
            v.push(if n - n == 0.0f32 { n % 360.0f32 } else { 0.0f32 })
        }
        out[i] = (v[0], v[1], v[2])
    }
    return some(out)
}

// `AbstractHorse.isWoodSoundType`, by the step sound of the block's sound type: wood's, the
// Nether's woods', stems', cherry wood's and bamboo wood's.
fn wood_step(name: String) -> bool {
    return name == "block.wood.step" or name == "block.nether_wood.step" or name == "block.stem.step" or name == "block.cherry_wood.step" or name == "block.bamboo_wood.step"
}

/// `CombatRules.getDamageAfterMagicAbsorb`: `damage` less a twenty-fifth of it for each point of
/// `protection`, from 0 to 20 (D439).
pub fn after_magic_absorb(damage: f32, protection: f32) -> f32 {
    let real = if protection < 0.0f32 { 0.0f32 } else { protection.min(20.0f32) }
    return damage * (1.0f32 - real / 25.0f32)
}

/// What a living entity's enchanted equipment does against a damage, as its level works it out
/// with its loot (D439): the protection it gives, `EnchantmentHelper.getDamageProtection`, and
/// whether it makes the entity immune, `isImmuneToDamage`, against the damage whose context is
/// `params`, `worn` the entity's equipment by slot in `slot_names`' order; each with what it
/// couldn't tell, said to be missing.
pub interface Warding {
    fn protection(self, worn: List<Tag?>, params: LootParams) -> (f32, List<String>)
    fn immune(self, worn: List<Tag?>, params: LootParams) -> (bool, List<String>)
}

/// What a living entity's enchanted equipment does against one damage, as `Warding` works it out
/// (D439): whether it's immune to it, and its protection, of which `getDamageAfterMagicAbsorb`
/// takes a twenty-fifth a point, 20 at most. And the armor effectiveness of what dealt it's
/// weapon, its enchantments' value effects with their levels, breach's (D443), which change the
/// share its armor takes.
pub struct Ward {
    pub immune: bool = false
    pub protection: f32 = 0.0f32
    pub armor: List<(Tag, i32)> = List<(Tag, i32)>()
}

/// `CombatRules.getDamageAfterAbsorb` of `damage` against `armor` and `toughness`, in floats, with
/// no weapon's armor effectiveness (D416).
pub fn after_absorb(damage: f32, armor: f32, toughness: f32) -> f32 {
    return damage * (1.0f32 - armor_share(damage, armor, toughness))
}

/// The share of `damage` that `armor` and `toughness` take, `getDamageAfterAbsorb`'s
/// `armorFraction`, in floats (D443).
pub fn armor_share(damage: f32, armor: f32, toughness: f32) -> f32 {
    let t = 2.0f32 + toughness / 4.0f32
    // `Mth.clamp`.
    let v = armor - damage / t
    let least = armor * 0.2f32
    let real = if v < least { least } else { v.min(20.0f32) }
    return real / 25.0f32
}
