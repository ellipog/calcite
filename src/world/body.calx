/// What every entity in a level has and does, as vanilla's `Entity` has it (CAL-154): its network
/// ID, its random and the UUID drawn from it, where it is and was, its motion, angles and size,
/// what it stands on and hit, its fall, the fluids it's in, and what it's saved with that Calcite
/// doesn't run yet; and moving as `Entity.move` moves it, against the blocks' shapes
/// (`world.movement`), standing on the block below it and bouncing as that block makes it, pushed
/// out of a block it's stuck in, `moveTowardsClosestSpace`, and in and out of fluids, which push
/// it with their currents (`world.currents`). An item entity (`world.item_entity`), an experience
/// orb (`world.experience_orb`) and a living entity (`world.living`) each have one; a living
/// entity's move runs its own steps between the move's, `collide_move`, `fall_check`,
/// `bounce_after` and `slow_by_block`, which `move_by` runs one after another for the rest.
///
/// It's saved as `Entity.saveWithoutId` saves it, `save_into`, and read as `Entity.load` reads it,
/// `load_from`, in the order vanilla puts each, which its compound's order follows.
module world.body

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import server.log.{Entry}
import world.clip.{ResetFacts, resets_fall}
import world.collision.{Aabb, CollisionBlocks}
import world.currents.{FlowFacts, fluids_seen, push}
import world.inside.{Acted, Movement, PortalProcess, Rain, Travel}
import world.movement.{Mover, MovementStates, collide_with, moved, swept}
import worldgen.facts.{BlockSet, EAST, Facts, NORTH, SOUTH, UP, WEST, step_x, step_y, step_z}

/// A sound an entity played, `Entity.playSound`, where it was: an item's splash as it came into
/// water, a living entity's steps and falls. Its name is the sound event's without `minecraft:`,
/// as `entity.generic.splash`, as the registry's table has it, and its source the entity's,
/// `getSoundSource`, by `SoundSource`'s order: `NEUTRAL_SOURCE`, or a monster's `HOSTILE_SOURCE`
/// (CAL-156).
pub struct EntitySound {
    pub sound: String
    pub x: f64
    pub y: f64
    pub z: f64
    pub volume: f32
    pub pitch: f32
    pub source: i32 = 6
    /// Its seed, where the entity's own random drew it, as an equip sound's is, `playSeededSound`;
    /// else the level draws it (CAL-159).
    pub seed: i64? = none
}

/// `SoundSource.BLOCKS`', `HOSTILE`'s, `NEUTRAL`'s and `PLAYERS`' places in its order.
/// How long an entity that isn't a player waits after going through a portal before it may go
/// through one again, `getDimensionChangingDelay`, and a projectile, `Projectile`'s (D578).
pub const PORTAL_DELAY: i32 = 300
pub const PROJECTILE_PORTAL_DELAY: i32 = 2

pub const BLOCKS_SOURCE: i32 = 4
pub const HOSTILE_SOURCE: i32 = 5
pub const NEUTRAL_SOURCE: i32 = 6
pub const PLAYERS_SOURCE: i32 = 7

/// Where an entity's move took it, for the steps after: how far it went, whether it hit something
/// across, along x or z, whether it moved up or down at all, and the block it's on, `getOnPosLegacy`,
/// and its state.
pub struct Moved {
    pub mx: f64
    pub my: f64
    pub mz: f64
    pub x_hit: bool
    pub z_hit: bool
    pub vertically: bool
    pub effect: (i32, i32, i32)
    pub effect_state: u32
}

/// What an entity's move reads of blocks besides their shapes: the water and bubble column
/// blocks, the fences, walls and fence gates it stands on top of, the blocks that don't bounce,
/// what fluids flow by, and what resets a fall it passes through (D422).
pub struct BodyFacts {
    pub water: u32
    pub bubble_column: u32
    pub fences: BlockSet
    pub walls: BlockSet
    pub no_bounce: BlockSet
    pub flow: FlowFacts
    pub reset: ResetFacts
}

impl BodyFacts {
    /// As `f` has them, its tags those its level loaded.
    pub fn new(f: Facts) -> BodyFacts {
        let water = f.block_named(String("minecraft:water")) else panic("no water block")
        let column = f.block_named(String("minecraft:bubble_column")) else panic("no bubble column block")
        return BodyFacts {
            water: water,
            bubble_column: column,
            fences: f.tag_or_empty(String("minecraft:fences")),
            walls: f.tag_or_empty(String("minecraft:walls")),
            no_bounce: f.tag_or_empty(String("minecraft:suppresses_bounce")),
            flow: FlowFacts.new(f),
            reset: ResetFacts.new(f),
        }
    }
}

/// An entity's body.
pub struct Body {
    /// Its network ID and UUID, most then least significant bits.
    pub id: i32
    pub uuid: (i64, i64)
    pub x: f64
    pub y: f64
    pub z: f64
    /// Where it was as its tick began, `xo`, `yo` and `zo`.
    pub xo: f64 = 0.0
    pub yo: f64 = 0.0
    pub zo: f64 = 0.0
    pub vx: f64 = 0.0
    pub vy: f64 = 0.0
    pub vz: f64 = 0.0
    /// How far it went from one base tick to the next, `lastKnownSpeed`, and where it was at the
    /// last, `lastKnownPosition`, none until its first (CAL-159).
    pub known_dx: f64 = 0.0
    pub known_dy: f64 = 0.0
    pub known_dz: f64 = 0.0
    pub last_known: (f64, f64, f64)? = none
    pub y_rot: f32 = 0.0f32
    pub x_rot: f32 = 0.0f32
    /// Its type's size, `EntityDimensions`, its eyes' height, and how fast it falls,
    /// `getDefaultGravity`.
    pub width: f32
    pub height: f32
    pub eyes: f32
    pub gravity: f64
    pub on_ground: bool = false
    pub horizontal_collision: bool = false
    pub vertical_collision: bool = false
    pub vertical_below: bool = false
    /// The block it stands on, `mainSupportingBlockPos`, and whether it stood on none when it
    /// last landed, `onGroundNoBlocks`.
    pub support: (i32, i32, i32)? = none
    pub no_blocks: bool = false
    pub fall: f64 = 0.0
    /// How far it fell as it last landed on farmland in its tick, and the farmland's place, which
    /// `FarmlandBlock.fallOn` draws for from the level's random, as what ticks it does as its
    /// move's done (CAL-160).
    pub farmland_fall: (f64, i32, i32, i32)? = none
    pub tick_count: i32 = 0
    /// Whether it was in water at its last look, `wasTouchingWater`, how deep it was in water and
    /// in lava, and whether its eyes were in water.
    pub in_water: bool = false
    pub water: f64 = 0.0
    pub lava: f64 = 0.0
    pub water_eyes: bool = false
    /// Its sounds' source, `getSoundSource`, and its splash where it comes into water slower than a
    /// quarter, `getSwimSplashSound`, `entity.generic.splash` where it has none of its own, as a
    /// faster one is (CAL-156).
    pub sound_source: i32 = 6
    pub quiet_splash: String? = none
    pub first_tick: bool = true
    pub no_gravity: bool = false
    /// Whether it has slow falling, as its living's effects say as it moves, which its gravity
    /// falling, `effective_gravity`, goes by (D515).
    pub slow_falling: bool = false
    pub no_physics: bool = false
    /// Whether its own side has the say over it, `isLocalInstanceAuthoritative`, as the server
    /// has over all but players, whose clients have; and whether it holds shift,
    /// `isShiftKeyDown`, which keeps it from bouncing, `isSuppressingBounce` (D419).
    pub owned: bool = true
    pub shift: bool = false
    /// Whether it's a player's, for whom end portals and gateways reset a fall they pass
    /// through, and nether portals where `players_nether_portal_default_delay` is 0, `portal`
    /// (D422).
    pub player: bool = false
    pub portal: bool = false
    /// Whether its tracker's to send its motion and place now, `needsSync`, and its place,
    /// `syncPosition`, as after a bounce; and its motion to all who see it after its run, however
    /// it ran, `syncVelocity`, as a hurt marks it, `markHurt` (D416).
    pub needs_sync: bool = false
    pub sync_position: bool = false
    pub sync_velocity: bool = false
    pub removed: bool = false
    /// When it came into its level, which places it in the tick list among the players there.
    pub entered: u64 = 0
    /// What `Entity` saves that Calcite doesn't run yet: its fire, `remainingFireTicks`, its air,
    /// whether it can't be hurt, its portal cooldown, which counts down; and the rest it was
    /// loaded with, by the keys it's saved under, as it's saved (CAL-148).
    pub fire: i32 = 0
    pub air: i32 = 300
    pub invulnerable: bool = false
    pub portal_cooldown: i32 = 0
    pub extras: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    /// The nether portal it's in, `portalProcess`; whether its level's nether portals may take it
    /// where they lead, `isAllowedToEnterPortal`, as its level sets it each tick; and whether one
    /// took it, `CHANGED_DIMENSION`, which keeps what the scoreboard has of it (D578).
    pub portal_process: PortalProcess? = none
    pub portal_open: bool = true
    pub moved_away: bool = false
    /// Its own random, `Entity.random`.
    pub random: LegacyRandom
    /// Whether it's a living entity, which bounces off a block as high as the block's bounce, not
    /// 0.8 of it; its air drag, `getAirDrag`, which a bounce is slowed by; and its movement
    /// efficiency, how little the block it's on slows it, as `LivingEntity.getBlockSpeedFactor`.
    pub alive: bool = false
    pub air_drag: f32 = 0.98f32
    pub efficiency: f32 = 0.0f32
    /// How high it steps up as it moves, `maxUpStep`, a living entity's step height, else none
    /// (D420).
    pub step: f32 = 0.0f32
    /// The moves it's made this tick, `movementThisTick`, which the blocks it's inside act on it
    /// along (D434).
    pub moves: List<Movement> = List<Movement>()
    /// The moves the blocks it was inside last acted on it along, `finalMovementsThisTick`, which
    /// an item at rest has them act on it along again (D435).
    pub last_moves: List<Movement> = List<Movement>()
}

impl Body {
    /// `setAsInsidePortal` of the nether portal block at x, y, z (D578): on its cooldown, the
    /// cooldown set again, `delay`, `getDimensionChangingDelay`; else in it from there, where it
    /// was in none, or, where it wasn't in it this tick, in it this tick from there.
    pub fn inside_portal(mut self, x: i32, y: i32, z: i32, delay: i32) {
        if self.portal_cooldown > 0 {
            self.portal_cooldown = delay
            return
        }
        match self.portal_process.take() {
            some(p) => {
                var q = p
                if not q.inside {
                    q.x = x
                    q.y = y
                    q.z = z
                    q.inside = true
                }
                self.portal_process = some(q)
            },
            none => self.portal_process = some(PortalProcess { x: x, y: y, z: z }),
        }
    }

    /// `handlePortal` after its cooldown's counted down, as what isn't a player has it (D578):
    /// out of its portal this tick, 4 ticks less of it, to none; in it, no longer this tick's, and
    /// where it may go through it, `allowed`, `canUsePortal`, a tick more of it, and, a nether
    /// portal's wait being none for what isn't a player, `getPortalTransitionTime`, it goes: its
    /// cooldown set, `delay`, and its portal as it is now given, for it to save itself with,
    /// `travel`. A portal it doesn't go through is let go once it's had none of it, `hasExpired`.
    pub fn portal_goes(mut self, allowed: bool, delay: i32) -> PortalProcess? {
        var p = self.portal_process.take() else return none
        if p.inside {
            p.inside = false
            if allowed {
                p.time += 1
                self.portal_cooldown = delay
                let gone = p
                self.portal_process = some(p)
                return some(gone)
            }
        } else {
            p.time = (p.time - 4).max(0)
        }
        if p.time > 0 {
            self.portal_process = some(p)
        }
        return none
    }

    /// Its way through the nether portal `portal` took it by, `saved` what it saves of itself now
    /// (D578): where its level's portals may take it, it's out of the level at once, as it changes
    /// dimension, `removeAfterChangingDimensions`, the rest of its tick going on as it is.
    pub fn travel(mut self, portal: own PortalProcess, saved: own Tag) -> Travel {
        let goes = self.portal_open
        let t = Travel { portal: portal, x: self.x, y: self.y, z: self.z, width: self.width, height: self.height, fall: self.fall, y_rot: self.y_rot, x_rot: self.x_rot, vx: self.vx, vy: self.vy, vz: self.vz, goes: goes, saved: saved }
        if goes {
            self.removed = true
            self.moved_away = true
        }
        return t
    }

    /// `computeSpeed`, as its base tick begins (CAL-159): how far it's gone since the last, from
    /// where it was then, or none at its first, and where it is now kept for the next.
    pub fn compute_speed(mut self) {
        let (lx, ly, lz) = self.last_known ?? (self.x, self.y, self.z)
        self.known_dx = self.x - lx
        self.known_dy = self.y - ly
        self.known_dz = self.z - lz
        self.last_known = some((self.x, self.y, self.z))
    }

    /// A body at x, y, z of a type `width` across and `height` high, its eyes `eyes` up, falling
    /// `gravity` a tick, with its own random seeded `seed`, as `Entity`'s constructor makes it: its
    /// random first, then its UUID drawn from it, `Mth.createInsecureUUID`.
    pub fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, width: f32, height: f32, eyes: f32, gravity: f64) -> Body {
        var random = LegacyRandom.new(seed)
        let most = (random.next_long() & -61441) | 16384
        let least = (random.next_long() & 4611686018427387903) | i64.MIN
        return Body { id: id, uuid: (most, least), x: x, y: y, z: z, xo: x, yo: y, zo: z, width: width, height: height, eyes: eyes, gravity: gravity, random: random }
    }

    /// Its box, `EntityDimensions.makeBoundingBox`, floats.
    pub fn bounding_box(self) -> Aabb {
        let half = f64(self.width / 2.0f32)
        return Aabb { min_x: self.x - half, min_y: self.y, min_z: self.z - half, max_x: self.x + half, max_y: self.y + f64(self.height), max_z: self.z + half }
    }

    /// Whether it's in lava, `isInLava`: not on its first tick.
    pub fn in_lava(self) -> bool {
        return not self.first_tick and self.lava > 0.0
    }

    /// `getGravity`: none where it has no gravity.
    pub fn gravity_now(self) -> f64 {
        return if self.no_gravity { 0.0 } else { self.gravity }
    }

    /// `getEffectiveGravity` (D515): its gravity, `gravity_now`, as `Entity`'s is; a living
    /// thing's no more than 0.01, `Math.min`, where it's falling or still and has slow falling,
    /// `LivingEntity`'s.
    pub fn effective_gravity(self) -> f64 {
        let g = self.gravity_now()
        if self.slow_falling and self.vy <= 0.0 {
            return if g <= 0.01 { g } else { 0.01 }
        }
        return g
    }

    /// What its collisions see of it, `EntityCollisionContext`: descending where it holds shift,
    /// `isDescending` (D420).
    pub fn mover(self) -> Mover {
        return Mover { y: self.y, fall: self.fall, descending: self.shift }
    }

    /// The block it's in, `blockPosition`.
    pub fn block(self) -> (i32, i32, i32) {
        return (i32.saturate(self.x.floor()), i32.saturate(self.y.floor()), i32.saturate(self.z.floor()))
    }

    /// `Entity.push(xa, ya, za)`: its motion more by as much where each is finite, and its tracker
    /// to send it, `needsSync` (CAL-156).
    pub fn push(mut self, xa: f64, ya: f64, za: f64) {
        if finite(xa) and finite(ya) and finite(za) {
            self.vx = self.vx + xa
            self.vy = self.vy + ya
            self.vz = self.vz + za
            self.needs_sync = true
        }
    }

    /// `Entity.updateFluidInteraction`: the fluids it's in and whether its eyes are in water, its
    /// fall forgotten in water, a splash as it comes into it where it `splashes`, then the
    /// currents' pushes; whether it's in any fluid.
    pub fn update_fluids<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, splashes: bool, sounds: mut List<EntitySound>) -> bool {
        return self.update_fluids_pushed(f, t, blocks, fast_lava, splashes, true, mut sounds)
    }

    /// `update_fluids`, the currents pushing it only where it's `pushed`, `isPushedByFluid`, as an
    /// arrow in the ground isn't (CAL-159).
    pub fn update_fluids_pushed<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, fast_lava: bool, splashes: bool, pushed: bool, sounds: mut List<EntitySound>) -> bool {
        let eyes = (i32.saturate(self.x.floor()), self.y + f64(self.eyes), i32.saturate(self.z.floor()))
        let r = fluids_seen(f, t.flow, blocks, self.bounding_box(), not pushed, some(eyes))
        self.water = r.water
        self.lava = r.lava
        self.water_eyes = r.water_eyes
        let wet = r.water > 0.0
        if wet {
            self.fall = 0.0
            if not self.in_water and not self.first_tick and splashes {
                self.splash(mut sounds)
            }
        }
        self.in_water = wet
        if not pushed {
            return r.any
        }
        if wet {
            let (x, y, z) = push(r.water_current, 0.014, false, self.vx, self.vy, self.vz)
            self.vx = x
            self.vy = y
            self.vz = z
        }
        if r.lava > 0.0 {
            let scale = if fast_lava { 0.007 } else { 0.0023333333333333335 }
            let (x, y, z) = push(r.lava_current, scale, false, self.vx, self.vy, self.vz)
            self.vx = x
            self.vy = y
            self.vz = z
        }
        return r.any
    }

    // `doWaterSplashEffect`: the splash's sound, as loud as it's moving, `splash_draws`.
    fn splash(mut self, sounds: mut List<EntitySound>) {
        let (volume, pitch) = splash_draws(mut self.random, self.width, self.vx, self.vy, self.vz)
        var sound = String("entity.generic.splash")
        if volume < 0.25f32 {
            if let own_splash = self.quiet_splash {
                sound = own_splash.copy()
            }
        }
        sounds.push(EntitySound { sound: sound, x: self.x, y: self.y, z: self.z, volume: volume, pitch: pitch, source: self.sound_source })
    }

    /// `moveTowardsClosestSpace`: pushed out of the block at x, y, z toward its nearest side that
    /// isn't a whole block, north, south, west, east or up, up if they all are, at 0.1 to 0.3.
    pub fn closest_space<B: CollisionBlocks>(mut self, f: Facts, blocks: B, x: f64, y: f64, z: f64) {
        let px = i32.saturate(x.floor())
        let py = i32.saturate(y.floor())
        let pz = i32.saturate(z.floor())
        let dx = x - f64(px)
        let dy = y - f64(py)
        let dz = z - f64(pz)
        var best = UP
        var closest = f64.MAX
        let sides: List<i32> = [NORTH, SOUTH, WEST, EAST, UP]
        for d in sides {
            let state = blocks.collision_state(px + step_x(d), py + step_y(d), pz + step_z(d)) ?? 0
            if f.collision_full_block(state) {
                continue
            }
            let along = if d == WEST or d == EAST { dx } else if d == UP { dy } else { dz }
            let toward = if d == SOUTH or d == EAST or d == UP { 1.0 - along } else { along }
            if toward < closest {
                closest = toward
                best = d
            }
        }
        let speed = self.random.next_float() * 0.2f32 + 0.1f32
        let step = if best == SOUTH or best == EAST or best == UP { 1.0f32 } else { -1.0f32 }
        let sx = self.vx * 0.75
        let sy = self.vy * 0.75
        let sz = self.vz * 0.75
        let out = f64(step * speed)
        if best == WEST or best == EAST {
            self.vx = out
            self.vy = sy
            self.vz = sz
        } else if best == UP {
            self.vx = sx
            self.vy = out
            self.vz = sz
        } else {
            self.vx = sx
            self.vy = sy
            self.vz = out
        }
    }

    /// `Entity.move` by dx, dy, dz, for itself: through blocks with no physics, else as far as
    /// their shapes let it, then whether it hit anything and stands on a block, its fall, its
    /// bounce off what it hit, and the speed factor of the block it's in or on. A block's `fallOn`
    /// does nothing for what isn't alive but farmland's, which draws as it's landed on, kept for
    /// what ticks it, `farmland_fall` (CAL-160).
    pub fn move_by<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64) {
        let went = self.collide_move(f, m, t, blocks, dx, dy, dz) else return
        if let fell = self.fall_check(went.my) {
            if f.is_a(f.block(went.effect_state), String("FarmlandBlock")) {
                let (ex, ey, ez) = went.effect
                self.farmland_fall = some((fell, ex, ey, ez))
            }
        }
        if self.removed {
            return
        }
        self.bounce_after(f, m, t, went)
        self.slow_by_block(f, m, t, blocks)
    }

    // `Entity.move`'s look along a move of a block or more while falling (D422): its fall reset
    // where what resets one, or water, is on the line from where it is along the move, 8 blocks
    // at most, `level.clip` with `FALLDAMAGE_RESETTING` and `WATER`. The fall from a height's
    // advancement a player's reset gives waits for advancements.
    fn reset_on_way<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, mx: f64, my: f64, mz: f64) {
        let length = (mx * mx + my * my + mz * mz).sqrt()
        let check = if length < 8.0 { length } else { 8.0 }
        let (nx, ny, nz) = (mx / length, my / length, mz / length)
        let to = (self.x + nx * check, self.y + ny * check, self.z + nz * check)
        if resets_fall(f, t.reset, blocks, self.player, self.portal, (self.x, self.y, self.z), to) {
            self.fall = 0.0
        }
    }

    /// `addMovementThisTick` (D434): the move `mv` kept among this tick's, the first two made one,
    /// from where the first began to where the second ended, where a hundred are kept already.
    pub fn record_move(mut self, mv: Movement) {
        if self.moves.len() >= 100 {
            var kept: List<Movement> = [Movement { from: self.moves[0].from, to: self.moves[1].to }]
            for i in 2..self.moves.len() {
                kept.push(self.moves[i])
            }
            self.moves = kept
        }
        self.moves.push(mv)
    }

    /// `removeLatestMovementRecording`: the last move kept forgotten, as a move the server sends
    /// back is (D434).
    pub fn forget_move(mut self) {
        if not self.moves.is_empty() {
            _ = self.moves.pop()
        }
    }

    /// The moves the blocks it's inside act on it along this tick, as `applyEffectsFromBlocks`
    /// takes them (D434): those it made, `movementThisTick`, given up, with one more from where the
    /// last ended to where it is, where they're further apart than a float's 1.0E-10 or so squared;
    /// or, where it made none, from where its tick began, `oldPosition`, to where it is. They're
    /// kept as its last, `last_moves` (D435).
    pub fn final_moves(mut self) -> List<Movement> {
        var moves = self.moves.copy()
        self.moves.clear()
        let here = (self.x, self.y, self.z)
        if moves.is_empty() {
            moves.push(Movement { from: (self.xo, self.yo, self.zo), to: here })
        } else {
            let (lx, ly, lz) = moves[moves.len() - 1].to
            let (dx, dy, dz) = (self.x - lx, self.y - ly, self.z - lz)
            if dx * dx + dy * dy + dz * dz > f64(9.9999994e-11f32) {
                moves.push(Movement { from: (lx, ly, lz), to: here })
            }
        }
        self.last_moves = moves.copy()
        return moves
    }

    /// Whether it's on fire, `isOnFire`: fire ticks left, where fire burns it at all, which it
    /// doesn't where it's `immune`, `fireImmune` (D434).
    pub fn burning(self, immune: bool) -> bool {
        return not immune and self.fire > 0
    }

    /// Whether it shows it's on fire, `setSharedFlagOnFire`'s: fire ticks left, or the fire it
    /// was loaded showing, `HasVisualFire`.
    pub fn fire_shown(self) -> bool {
        return self.fire > 0 or self.extras.contains("HasVisualFire")
    }

    /// `baseTick`'s fire (D434): where it burns, its fire put out where it's `immune`; else a tick
    /// of it gone, and whether it hurts this tick, 1 of `on_fire`, as it does every 20 out of lava.
    pub fn fire_tick(mut self, immune: bool) -> bool {
        if self.fire <= 0 {
            return false
        }
        if immune {
            self.put_out()
            return false
        }
        let burns = self.fire % 20 == 0 and not self.in_lava()
        self.fire -= 1
        return burns
    }

    /// `BaseFireBlock.fireIgnite`, where it isn't `immune` (D434): a tick of its wait gone where
    /// it's waiting, else for a player `added` more; then, where it's waited, 8 seconds of fire,
    /// `igniteForTicks`, which it says, as that lets its freezing go.
    pub fn fire_ignite(mut self, immune: bool, added: i32) -> bool {
        if immune {
            return false
        }
        if self.fire < 0 {
            self.fire += 1
        } else if self.player {
            self.fire += added
        }
        if self.fire >= 0 {
            self.ignite_for(160)
            return true
        }
        return false
    }

    /// `igniteForTicks`'s fire: on fire for `ticks` where it has less left.
    pub fn ignite_for(mut self, ticks: i32) {
        if self.fire < ticks {
            self.fire = ticks
        }
    }

    /// `clearFire`: no fire left, its wait to burn again, below nought, kept.
    pub fn put_out(mut self) {
        self.fire = self.fire.min(0)
    }

    /// `isInRain`: rain at its block, or in its column where its box's top is (D434).
    pub fn in_rain<B: Rain>(self, blocks: B) -> bool {
        let (x, y, z) = self.block()
        let top = i32.saturate((self.y + f64(self.height)).floor())
        return blocks.rains_on(x, y, z) or blocks.rains_on(x, top, z)
    }

    /// The end of `applyEffectsFromBlocks` (D434), `was` whether it was on fire and freezing and
    /// its fire ticks before what it's inside acted on it, `freezing` whether it's freezing now,
    /// `immune` whether fire doesn't burn it: its fire put out where it's in the rain, `rained`;
    /// the hiss of its fire or freezing gone, which its level plays however silent it is, its
    /// pitch drawn, `playEntityOnFireExtinguishedSound`; and where it's not on fire and wasn't
    /// lit, its fire set to wait as long as it's immune after, `getFireImmuneTicks`, 20 ticks for
    /// a player and none for the rest.
    pub fn after_inside(mut self, immune: bool, was: (bool, bool, i32), freezing: bool, rained: bool, sounds: mut List<EntitySound>) {
        let (burnt, froze, fire) = was
        if rained {
            self.put_out()
        }
        if (burnt and not self.burning(immune)) or (froze and not freezing) {
            let a = self.random.next_float()
            let b = self.random.next_float()
            sounds.push(EntitySound { sound: String("entity.generic.extinguish_fire"), x: self.x, y: self.y, z: self.z, volume: 0.7f32, pitch: 1.6f32 + (a - b) * 0.4f32, source: self.sound_source })
        }
        if not self.burning(immune) and self.fire <= fire {
            self.fire = if self.player { -20 } else { 0 }
        }
    }

    /// `stepOn` of the block it stands on, `getOnPosLegacy`, for what isn't alive, an item or an
    /// orb (D435), where blocks act on it: a slime block slows it across, by 0.4 and a fifth of
    /// how fast it goes up or down, where that's under 0.1; redstone ore's lit, `Acted.Lit`, by
    /// its level; and sculk sensors, and for an item a player threw, `thrown`, sculk shriekers,
    /// `tryGetPlayer`, are said to be missing. Magma and turtle eggs do nothing to it.
    pub fn step_on_block<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, thrown: bool) -> Acted? {
        if self.removed or self.no_physics or not self.on_ground {
            return none
        }
        let (x, y, z) = self.on_pos(f, t, blocks, 0.2f32)
        let state = blocks.collision_state(x, y, z) ?? 0
        let block = f.block(state)
        if f.is_a(block, String("SlimeBlock")) {
            let up = self.vy.abs()
            if up < 0.1 {
                let scale = 0.4 + up * 0.2
                self.vx = self.vx * scale
                self.vz = self.vz * scale
            }
            return none
        }
        if f.is_a(block, String("RedStoneOreBlock")) {
            return some(Acted.Lit((x, y, z)))
        }
        if f.is_a(block, String("SculkSensorBlock")) and (f.get_name(state, String("sculk_sensor_phase")) ?? String()) == "inactive" {
            return some(Acted.Missing(String("Sculk sensors stepped on")))
        }
        if thrown and f.is_a(block, String("SculkShriekerBlock")) {
            return some(Acted.Missing(String("Sculk shriekers stepped on by players")))
        }
        return none
    }

    /// `Entity.move`'s first part: through blocks with no physics, which is all there is of the
    /// move, so none; else as far as their shapes let it, stepping up where it steps, `step_up`
    /// (D420), its fall reset where a move of a block or more passes through what resets it,
    /// `reset_on_way` (D422), the move kept, `record_move` (D434), whether it hit anything and
    /// stands on a block, and the block it's on.
    pub fn collide_move<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, dx: f64, dy: f64, dz: f64) -> Moved? {
        if self.no_physics {
            self.x = self.x + dx
            self.y = self.y + dy
            self.z = self.z + dz
            self.horizontal_collision = false
            self.vertical_collision = false
            self.vertical_below = false
            return none
        }
        var mx = dx
        var my = dy
        var mz = dz
        let asked = dx * dx + dy * dy + dz * dz
        if asked != 0.0 {
            let b = self.bounding_box()
            let c = m.colliders(f, blocks, swept(b, dx, dy, dz), self.mover())
            let (cx, cy, cz) = collide_with(c, b, dx, dy, dz)
            let (sx, sy, sz) = self.step_up(f, m, blocks, b, dx, dy, dz, cx, cy, cz)
            mx = sx
            my = sy
            mz = sz
        }
        let length = mx * mx + my * my + mz * mz
        if length > 1.0e-7 or asked - length < 1.0e-7 {
            if self.fall != 0.0 and length >= 1.0 {
                self.reset_on_way(f, t, blocks, mx, my, mz)
            }
            let went = Movement { from: (self.x, self.y, self.z), to: (self.x + mx, self.y + my, self.z + mz), asked: some((dx, dy, dz)) }
            self.record_move(went)
            self.x = self.x + mx
            self.y = self.y + my
            self.z = self.z + mz
        }
        let x_hit = not equal(dx, mx)
        let z_hit = not equal(dz, mz)
        self.horizontal_collision = x_hit or z_hit
        let vertically = dy.abs() > 0.0
        // Whether it hit anything up or down and stands on a block, found only where it moved up
        // or down unless its own side has the say, `isLocalInstanceAuthoritative` (D419).
        if vertically or self.owned {
            self.vertical_collision = dy != my
            self.vertical_below = self.vertical_collision and dy < 0.0
            let below = self.vertical_below
            self.set_on_ground(f, m, blocks, below, mx, mz)
        }
        let (ex, ey, ez) = self.on_pos(f, t, blocks, 0.2f32)
        let effect = blocks.collision_state(ex, ey, ez) ?? 0
        return some(Moved { mx: mx, my: my, mz: mz, x_hit: x_hit, z_hit: z_hit, vertically: vertically, effect: (ex, ey, ez), effect_state: effect })
    }

    // `Entity.collide`'s step up (D420): where its box `b`, moving dx, dy, dz, got only `mx`, `my`,
    // `mz` and was stopped across, on the ground or landing as it moved and stepping at all, up
    // the least of the heights that the tops and bottoms of the shapes near make above its foot,
    // as high as it steps or less, but the one it's at, `collectCandidateStepUpHeights`, that takes
    // it further across than it got, from its foot as it landed, `collideWithShapes`; else as it
    // got.
    fn step_up<B: CollisionBlocks>(self, f: Facts, m: MovementStates, blocks: B, b: Aabb, dx: f64, dy: f64, dz: f64, mx: f64, my: f64, mz: f64) -> (f64, f64, f64) {
        let landing = dy != my and dy < 0.0
        if not (self.step > 0.0f32) or not (landing or self.on_ground) or (dx == mx and dz == mz) {
            return (mx, my, mz)
        }
        let grounded = if landing { moved(b, 0.0, my, 0.0) } else { b }
        var area = swept(grounded, dx, f64(self.step), dz)
        if not landing {
            area = swept(area, 0.0, f64(-1.0e-5f32), 0.0)
        }
        let c = m.colliders(f, blocks, area, self.mover())
        let skip = f32.nearest(my)
        var heights = List<f32>()
        for part in c.boxes {
            add_height(mut heights, f32.nearest(part.min_y - grounded.min_y), skip, self.step)
            add_height(mut heights, f32.nearest(part.max_y - grounded.min_y), skip, self.step)
        }
        let got = mx * mx + mz * mz
        for h in heights {
            let (sx, sy, sz) = collide_with(c, grounded, dx, f64(h), dz)
            if sx * sx + sz * sz > got {
                return (sx, sy - (b.min_y - grounded.min_y), sz)
            }
        }
        return (mx, my, mz)
    }

    /// `Entity.checkFallDamage`'s fall, after moving `my` down or up: out of water, the way down
    /// added to it, a float's worth; on the ground, forgotten. How far it had fallen as it landed,
    /// where it landed from a fall, which a block's `fallOn` takes.
    pub fn fall_check(mut self, my: f64) -> f64? {
        if not self.in_water and my < 0.0 {
            self.fall = self.fall - f64(f32.nearest(my))
        }
        if not self.on_ground {
            return none
        }
        let landed = self.fall
        self.fall = 0.0
        return if landed > 0.0 { some(landed) } else { none }
    }

    /// `restituteMovementAfterCollisions`, where the move hit something across, or up or down as
    /// it moved that way.
    pub fn bounce_after(mut self, f: Facts, m: MovementStates, t: BodyFacts, went: Moved) {
        if (went.vertically and self.vertical_collision) or self.horizontal_collision {
            self.restitute(f, m, t, went.effect_state, went.x_hit, went.z_hit, went.my)
        }
    }

    /// The end of `Entity.move`: its motion across slowed by the speed factor of the block it's
    /// in or on, less so for a living entity as efficient as it is.
    pub fn slow_by_block<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) {
        let factor = self.speed_factor(f, m, t, blocks)
        let speed = f64(if self.alive { factor + self.efficiency * (1.0f32 - factor) } else { factor })
        self.vx = self.vx * speed
        self.vy = self.vy * 1.0
        self.vz = self.vz * speed
    }

    // `setOnGroundWithMovement`, `checkSupportingBlock`: on the ground if it hit something going
    // down, and then standing on the nearest block just below its box's bottom, or below where it
    // came across from if there's none and it had one.
    fn set_on_ground<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, ground: bool, mx: f64, mz: f64) {
        self.on_ground = ground
        let found = support_of(f, m, blocks, self.bounding_box(), self.x, self.y, self.z, self.mover(), ground, mx, mz, self.no_blocks)
        self.support = found
        self.no_blocks = ground and found == none
    }

    /// `getOnPos`, `on_pos_of` where it stands.
    pub fn on_pos<B: CollisionBlocks>(self, f: Facts, t: BodyFacts, blocks: B, offset: f32) -> (i32, i32, i32) {
        return on_pos_of(f, t, blocks, self.support, self.x, self.y, self.z, offset)
    }

    // `restituteMovementAfterCollisions`: it doesn't bounce off a wall, its motion across into
    // it gone; and coming down onto a block, it bounces as high as the block's bounce, 0.8 of it
    // for what isn't alive, unless it was hardly falling, holds shift (D419) or the block doesn't
    // bounce, slowed by its air drag for the part of the tick it moved; hardly and the part both
    // by its gravity as slow falling leaves it, `effective_gravity` (D515).
    fn restitute(mut self, f: Facts, m: MovementStates, t: BodyFacts, effect: u32, x_hit: bool, z_hit: bool, my: f64) {
        var restitution = 0.0
        let cx = self.vx
        let cy = self.vy
        let cz = self.vz
        var bx = cx
        var by = cy
        var bz = cz
        if x_hit {
            bx = -cx * restitution
        }
        if z_hit {
            bz = -cz * restitution
        }
        var bounced = restitution > 0.0 and (x_hit or z_hit)
        if self.vertical_collision {
            let gravity = self.effective_gravity()
            if self.vertical_below {
                let block = f.block(effect)
                if not (-cy <= gravity) and not self.shift and not f.in_set(effect, t.no_bounce) {
                    let bounce = f64(if self.alive { m.bounce(block) } else { m.bounce(block) * 0.8f32 })
                    restitution = if restitution > bounce { restitution } else { bounce }
                } else {
                    restitution = 0.0
                }
            }
            var compensation = 0.0
            var drag = 1.0
            if restitution > 0.0 {
                let portion = my / cy
                compensation = portion * gravity
                drag = 1.0 + portion * (f64(self.air_drag) - 1.0)
                bounced = true
            }
            by = (compensation - cy) * drag * restitution
        }
        if bounced {
            // `bounceOn` and the `BOUNCE` game event aren't in Calcite; its place is sent.
            self.sync_position = true
        }
        self.vx = bx
        self.vy = by
        self.vz = bz
    }

    // `getBlockSpeedFactor`, `speed_factor_at` where it is.
    fn speed_factor<B: CollisionBlocks>(self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B) -> f32 {
        return speed_factor_at(f, m, t, blocks, self.support, self.x, self.y, self.z)
    }

    /// What `saveAsPassenger` saves of it before its type's own, put in the order vanilla puts it
    /// (CAL-148): its type `kind`; `Entity.saveWithoutId`'s place, motion, angles, fall, fire, air,
    /// ground, invulnerability, portal cooldown and UUID, with what it was loaded with of the rest
    /// where vanilla puts it, and `NoGravity` if it has none.
    pub fn save_into(self, t: mut JavaHashMap<String, Tag>, kind: str) {
        t.insert(String("id"), Tag.Str(String(kind)))
        t.insert(String("Pos"), Tag.List([Tag.Double(self.x), Tag.Double(self.y), Tag.Double(self.z)]))
        t.insert(String("Motion"), Tag.List([Tag.Double(self.vx), Tag.Double(self.vy), Tag.Double(self.vz)]))
        t.insert(String("Rotation"), Tag.List([Tag.Float(self.y_rot), Tag.Float(self.x_rot)]))
        t.insert(String("fall_distance"), Tag.Double(self.fall))
        t.insert(String("Fire"), Tag.Short(i16.wrap(self.fire)))
        t.insert(String("Air"), Tag.Short(i16.wrap(self.air)))
        t.insert(String("OnGround"), flag(self.on_ground))
        t.insert(String("Invulnerable"), flag(self.invulnerable))
        t.insert(String("PortalCooldown"), Tag.Int(self.portal_cooldown))
        self.put_extra(mut t, "invulnerable_time")
        t.insert(String("UUID"), uuid_tag(self.uuid))
        self.put_extra(mut t, "CustomName")
        self.put_extra(mut t, "CustomNameVisible")
        self.put_extra(mut t, "Silent")
        if self.no_gravity {
            t.insert(String("NoGravity"), Tag.Byte(1i8))
        }
        self.put_extra(mut t, "Glowing")
        self.put_extra(mut t, "TicksFrozen")
        self.put_extra(mut t, "HasVisualFire")
        self.put_extra(mut t, "Tags")
        self.put_extra(mut t, "data")
    }

    fn put_extra(self, t: mut JavaHashMap<String, Tag>, key: str) {
        if self.extras.contains(key) {
            t.insert(String(key), self.extras[key].copy())
        }
    }

    /// Reads `tag` into it as `Entity.load` reads it, before its type's own (CAL-148): its place,
    /// clamped to the world's reach, its motion, none on an axis past 10, its angles, the pitch
    /// within a right angle, and the rest, each as `ValueInput` reads a number, with vanilla's
    /// defaults; its UUID where it reads as one. It needs syncing, as `load` has it. False where
    /// it's somewhere that isn't a number, which vanilla's load throws on, logged in `lines` as
    /// `loadStaticEntity` logs it.
    pub fn load_from(mut self, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        let zero: List<f64> = [0.0, 0.0, 0.0]
        let level: List<f32> = [0.0f32, 0.0f32]
        let pos = doubles(tag, "Pos", 3) ?? zero.copy()
        let motion = doubles(tag, "Motion", 3) ?? zero.copy()
        let angles = floats(tag, "Rotation") ?? level.copy()
        self.vx = if motion[0].abs() > 10.0 { 0.0 } else { motion[0] }
        self.vy = if motion[1].abs() > 10.0 { 0.0 } else { motion[1] }
        self.vz = if motion[2].abs() > 10.0 { 0.0 } else { motion[2] }
        self.needs_sync = true
        self.x = clamp(pos[0], -3.0000512e7, 3.0000512e7)
        self.y = clamp(pos[1], -2.0e7, 2.0e7)
        self.z = clamp(pos[2], -3.0000512e7, 3.0000512e7)
        if finite(f64(angles[0])) {
            self.y_rot = angles[0]
        }
        if finite(f64(angles[1])) {
            self.x_rot = clamp_pitch(angles[1] % 360.0f32)
        }
        self.xo = self.x
        self.yo = self.y
        self.zo = self.z
        self.fall = number(tag, "fall_distance") ?? 0.0
        self.fire = i32(short_or(tag, "Fire", 0i16))
        self.air = int_or(tag, "Air", 300)
        self.on_ground = bool_or(tag, "OnGround")
        self.invulnerable = bool_or(tag, "Invulnerable")
        let invulnerable_time = int_or(tag, "invulnerable_time", 0)
        self.portal_cooldown = int_or(tag, "PortalCooldown", 0)
        if let u = uuid_of(tag, "UUID") {
            self.uuid = u
        }
        if not (finite(self.x) and finite(self.y) and finite(self.z)) {
            lines.push(Entry.warn(String("Exception loading entity: net.minecraft.ReportedException: Loading entity NBT")))
            return false
        }
        self.y_rot = self.y_rot % 360.0f32
        // What it keeps to save as it was: those vanilla saves only where they're set, as it
        // saves them.
        if invulnerable_time > 0 {
            self.extras.insert(String("invulnerable_time"), Tag.Int(invulnerable_time))
        }
        if tag.contains("CustomName") {
            self.extras.insert(String("CustomName"), tag["CustomName"].copy())
        }
        for key in ["CustomNameVisible", "Silent", "Glowing", "HasVisualFire"] {
            if bool_or(tag, key) {
                self.extras.insert(String(key), Tag.Byte(1i8))
            }
        }
        self.no_gravity = bool_or(tag, "NoGravity")
        let frozen = int_or(tag, "TicksFrozen", 0)
        if frozen > 0 {
            self.extras.insert(String("TicksFrozen"), Tag.Int(frozen))
        }
        for key in ["Tags", "data"] {
            if tag.contains(key) {
                self.extras.insert(String(key), tag[key].copy())
            }
        }
        return true
    }
}

// `Mth.equal`: closer than 1.0E-5F.
fn equal(a: f64, b: f64) -> bool {
    return (b - a).abs() < f64(1.0e-5f32)
}

// `BlockPos.compareTo(b) < 0`: `a` comes before `b` by y, then z, then x.
/// `checkSupportingBlock` for the box `b`, its feet at x, y, z, as `mover` collides (D418, as it
/// was `Body`'s): on the ground, the block it stands on, `findSupportingBlock`, or, where there's
/// none and it stood on some as it last landed, not `no_blocks`, the one below where it came across
/// by `mx`, `mz` from; none off the ground.
pub fn support_of<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, b: Aabb, x: f64, y: f64, z: f64, mover: Mover, ground: bool, mx: f64, mz: f64, no_blocks: bool) -> (i32, i32, i32)? {
    if not ground {
        return none
    }
    let test = Aabb { min_x: b.min_x, min_y: b.min_y - 1.0e-6, min_z: b.min_z, max_x: b.max_x, max_y: b.min_y, max_z: b.max_z }
    let found = supporting_at(f, m, blocks, test, x, y, z, mover)
    if found != none or no_blocks {
        return found
    }
    return supporting_at(f, m, blocks, moved(test, -mx, 0.0, -mz), x, y, z, mover)
}

// `findSupportingBlock`: of the blocks whose shapes meet `test`, the one whose middle is nearest
// the feet at x, y, z, the greatest by y, z and x of those as near.
fn supporting_at<B: CollisionBlocks>(f: Facts, m: MovementStates, blocks: B, test: Aabb, x: f64, y: f64, z: f64, mover: Mover) -> (i32, i32, i32)? {
    let c = m.colliders(f, blocks, test, mover)
    var best: (i32, i32, i32)? = none
    var nearest = f64.MAX
    for (bx, by, bz) in c.at {
        let dx = f64(bx) + 0.5 - x
        let dy = f64(by) + 0.5 - y
        let dz = f64(bz) + 0.5 - z
        let d = dx * dx + dy * dy + dz * dz
        var take = d < nearest
        if not take and d == nearest {
            take = match best {
                some(o) => before(o, (bx, by, bz)),
                none => true,
            }
        }
        if take {
            best = some((bx, by, bz))
            nearest = d
        }
    }
    return best
}

/// `getOnPos` for feet at x, y, z standing on `support` (D418, as it was `Body`'s): the block
/// stood on, at `offset` below the feet unless that's a fence's, wall's or fence gate's top; or
/// the block that far below where it stands on none.
pub fn on_pos_of<B: CollisionBlocks>(f: Facts, t: BodyFacts, blocks: B, support: (i32, i32, i32)?, x: f64, y: f64, z: f64, offset: f32) -> (i32, i32, i32) {
    let below = i32.saturate((y - f64(offset)).floor())
    if let s = support {
        let (sx, sy, sz) = s
        if not (offset > 1.0e-5f32) {
            return (sx, sy, sz)
        }
        let state = blocks.collision_state(sx, sy, sz) ?? 0
        let fence = f.in_set(state, t.fences)
        let wall = f.in_set(state, t.walls)
        let gate = f.is_a(f.block(state), String("FenceGateBlock"))
        if (not (f64(offset) <= 0.5) or not fence) and not wall and not gate {
            return (sx, below, sz)
        }
        return (sx, sy, sz)
    }
    return (i32.saturate(x.floor()), below, i32.saturate(z.floor()))
}

/// `getBlockSpeedFactor` for feet at x, y, z standing on `support` (D418, as it was `Body`'s):
/// the block they're in's, unless that's 1 and it isn't water or a bubble column, then the block
/// under them's.
pub fn speed_factor_at<B: CollisionBlocks>(f: Facts, m: MovementStates, t: BodyFacts, blocks: B, support: (i32, i32, i32)?, x: f64, y: f64, z: f64) -> f32 {
    let here = f.block(blocks.collision_state(i32.saturate(x.floor()), i32.saturate(y.floor()), i32.saturate(z.floor())) ?? 0)
    let speed = m.speed_factor(here)
    if here == t.water or here == t.bubble_column {
        return speed
    }
    if f64(speed) == 1.0 {
        let (bx, by, bz) = on_pos_of(f, t, blocks, support, x, y, z, 0.999999f32)
        return m.speed_factor(f.block(blocks.collision_state(bx, by, bz) ?? 0))
    }
    return speed
}

/// `doWaterSplashEffect`'s draws from `random` for what's `width` across moving vx, vy, vz (D418,
/// as they were `Body`'s): its sound's volume, as fast as it moves, and pitch; then the bubbles
/// and splashes, as many of each as `i < 1.0F + width * 20.0F` counts, three draws a bubble and
/// two a splash, which a server sends nothing of.
pub fn splash_draws(random: mut LegacyRandom, width: f32, vx: f64, vy: f64, vz: f64) -> (f32, f32) {
    let fast = (vx * vx * f64(0.2f32) + vy * vy + vz * vz * f64(0.2f32)).sqrt()
    let loud = f32.nearest(fast) * 0.2f32
    let volume = if loud < 1.0f32 { loud } else { 1.0f32 }
    let a = random.next_float()
    let b = random.next_float()
    let pitch = 1.0f32 + (a - b) * 0.4f32
    let n = i32.saturate(f64(1.0f32 + width * 20.0f32).ceil())
    for _ in 0..n * 3 {
        _ = random.next_double()
    }
    for _ in 0..n * 2 {
        _ = random.next_double()
    }
    return (volume, pitch)
}

fn before(a: (i32, i32, i32), b: (i32, i32, i32)) -> bool {
    let (ax, ay, az) = a
    let (bx, by, bz) = b
    if ay != by {
        return ay < by
    }
    if az != bz {
        return az < bz
    }
    return ax < bx
}

// A height `h` to step up to, kept among `heights` once, least first, as
// `collectCandidateStepUpHeights` sorts them (D420): none below the foot, none at the height it's
// at, `skip`, and none higher than it steps, `most`.
fn add_height(heights: mut List<f32>, h: f32, skip: f32, most: f32) {
    if h < 0.0f32 or h == skip or h > most {
        return
    }
    for had in heights {
        if had == h {
            return
        }
    }
    heights.push(h)
    var i = heights.len() - 1
    while i > 0 and heights[i - 1] > heights[i] {
        let lower = heights[i]
        heights[i] = heights[i - 1]
        heights[i - 1] = lower
        i -= 1
    }
}

// A boolean as `putBoolean` saves it.
fn flag(b: bool) -> Tag {
    return Tag.Byte(if b { 1i8 } else { 0i8 })
}

/// A UUID as `UUIDUtil.CODEC` saves it, four ints, most significant first.
pub fn uuid_tag(u: (i64, i64)) -> Tag {
    let (most, least) = u
    return Tag.IntArray([i32.wrap(most >> 32), i32.wrap(most), i32.wrap(least >> 32), i32.wrap(least)])
}

/// The UUID saved as `key`, as `UUIDUtil.CODEC` reads it: four ints, an int array or a list of
/// numbers.
pub fn uuid_of(tag: JavaHashMap<String, Tag>, key: str) -> (i64, i64)? {
    if not tag.contains(key) {
        return none
    }
    var ints = List<i32>()
    match tag[key] {
        Tag.IntArray(v) => {
            for i in v {
                ints.push(i)
            }
        },
        Tag.List(items) => {
            for item in items {
                let i = item.number_int() else return none
                ints.push(i)
            }
        },
        _ => return none,
    }
    if ints.len() != 4 {
        return none
    }
    let most = (i64(ints[0]) << 32) | (i64(ints[1]) & 4294967295)
    let least = (i64(ints[2]) << 32) | (i64(ints[3]) & 4294967295)
    return some((most, least))
}

// The `n` numbers saved as `key`, as `Vec3.CODEC` reads them, or none.
fn doubles(tag: JavaHashMap<String, Tag>, key: str, n: usize) -> List<f64>? {
    if not tag.contains(key) {
        return none
    }
    let Tag.List(items) = tag[key] else return none
    if items.len() != n {
        return none
    }
    var out = List<f64>()
    for item in items {
        let v = item.number_double() else return none
        out.push(v)
    }
    return some(out)
}

// The two angles saved as `key`, as `Vec2.CODEC` reads them, or none.
fn floats(tag: JavaHashMap<String, Tag>, key: str) -> List<f32>? {
    if not tag.contains(key) {
        return none
    }
    let Tag.List(items) = tag[key] else return none
    if items.len() != 2 {
        return none
    }
    var out = List<f32>()
    for item in items {
        let v = item.number_float() else return none
        out.push(v)
    }
    return some(out)
}

// The number saved as `key`, as `getDoubleOr` reads it.
fn number(tag: JavaHashMap<String, Tag>, key: str) -> f64? {
    if not tag.contains(key) {
        return none
    }
    return tag[key].number_double()
}

/// The number saved as `key`, as `getShortOr`, `getIntOr` and `getBooleanOr` read it.
pub fn short_or(tag: JavaHashMap<String, Tag>, key: str, fallback: i16) -> i16 {
    if not tag.contains(key) {
        return fallback
    }
    return tag[key].short_value() ?? fallback
}

pub fn int_or(tag: JavaHashMap<String, Tag>, key: str, fallback: i32) -> i32 {
    if not tag.contains(key) {
        return fallback
    }
    return tag[key].int_value() ?? fallback
}

pub fn bool_or(tag: JavaHashMap<String, Tag>, key: str) -> bool {
    if not tag.contains(key) {
        return false
    }
    let b = tag[key].byte_value() else return false
    return b != 0i8
}

// Whether `v` is neither infinite nor NaN, `Double.isFinite`.
/// `Entity.push(entity)`'s push between an entity at `x`, `z` and the one at `ox`, `oz` it's
/// pushed by (CAL-156): their gap across, by its greater way, `Mth.absMax`, where that's 0.01 or
/// more, over its root, no more than a whole of the root's inverse, and a twentieth of that. The
/// pusher's pushed by it and the other by its opposite; none where they're nearer.
pub fn push_between(x: f64, z: f64, ox: f64, oz: f64) -> (f64, f64)? {
    var xa = ox - x
    var za = oz - z
    let ax = xa.abs()
    let az = za.abs()
    var dd = if ax >= az { ax } else { az }
    if not (dd >= f64(0.01f32)) {
        return none
    }
    dd = dd.sqrt()
    xa = xa / dd
    za = za / dd
    var pow = 1.0 / dd
    if pow > 1.0 {
        pow = 1.0
    }
    xa = xa * pow
    za = za * pow
    xa = xa * f64(0.05f32)
    za = za * f64(0.05f32)
    return some((xa, za))
}

fn finite(v: f64) -> bool {
    return v - v == 0.0
}

// `Mth.clamp` of a double.
fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo
    }
    return if v > hi { hi } else { v }
}

// `Math.clamp(xRot, -90, 90)`.
fn clamp_pitch(v: f32) -> f32 {
    if v < -90.0f32 {
        return -90.0f32
    }
    return if v > 90.0f32 { 90.0f32 } else { v }
}
