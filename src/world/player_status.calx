/// What a player keeps of their health, food and experience (CAL-141), as `FoodData`, `Player` and
/// `ServerPlayer` keep them: their food and its saturation, exhaustion and timer; their experience's
/// level, total, progress and enchantment seed; and what of their health, food and experience
/// their client was last sent, which `doTick` sends again as it changes. Their health, absorption,
/// air, score and frozen ticks are their entity data's, `world.entity_data`.
///
/// `read_status` and `write_status` read and write them as `readAdditionalSaveData` and
/// `addAdditionalSaveData` do; `tick_regeneration` is `ServerPlayer.tickRegeneration`, peaceful's
/// healing and feeding; `tick_food` is `FoodData.tick`, its exhaustion spent and its natural
/// regeneration. Starving hurts, which waits for damage and is told of.
module world.player_status

import nbt.tag.{Tag}
import world.entity_data.{ABSORPTION, AIR_SUPPLY, EntityData, HEALTH, SCORE, TICKS_FROZEN, Value}

/// A player's food and experience, and what of them and their health was last sent.
pub struct Status {
    pub food: i32 = 20
    pub saturation: f32 = 5.0f32
    pub exhaustion: f32 = 0.0f32
    pub food_timer: i32 = 0
    pub xp_progress: f32 = 0.0f32
    pub xp_level: i32 = 0
    pub xp_total: i32 = 0
    pub xp_seed: i32 = 0
    /// `lastSentHealth`, `lastSentFood`, `lastFoodSaturationZero` and `lastSentExp`.
    pub sent_health: f32 = -1.0e8f32
    pub sent_food: i32 = -99999999
    pub sent_saturation_zero: bool = true
    pub sent_xp: i32 = -99999999
}

impl Status {
    /// `causeFoodExhaustion`'s `addExhaustion`: at most 40.
    pub fn exhaust(mut self, amount: f32) {
        self.exhaustion = (self.exhaustion + amount).min(40.0f32)
    }
}

/// `setHealth`: the player's health, kept within 0 and their most.
pub fn set_health(data: mut EntityData, health: f32, max_health: f32) {
    data.set(HEALTH, Value.Float(health.max(0.0f32).min(max_health)))
}

/// `heal`: the player's health, if they're alive, `amount` more.
pub fn heal(data: mut EntityData, amount: f32, max_health: f32) {
    let health = data.float(HEALTH)
    if health > 0.0f32 {
        set_health(mut data, health + amount, max_health)
    }
}

/// What the player's saved data `d` says of their status, as `readAdditionalSaveData` reads it,
/// each its default where it's missing: their air, frozen ticks, absorption, within 0 and
/// `max_absorption`, health, within 0 and `max_health`, and score into their entity data `data`;
/// their experience and food into what's returned. A player new to the world is at their most
/// health, as `LivingEntity`'s constructor sets it.
pub fn read_status(d: JavaHashMap<String, Tag>?, data: mut EntityData, max_health: f32, max_absorption: f32) -> Status {
    var s = Status()
    let saved = d else {
        set_health(mut data, max_health, max_health)
        return s
    }
    data.set(AIR_SUPPLY, Value.Number(int_or(saved, "Air", 300)))
    data.set(TICKS_FROZEN, Value.Number(int_or(saved, "TicksFrozen", 0)))
    data.set(ABSORPTION, Value.Float(float_or(saved, "AbsorptionAmount", 0.0f32).max(0.0f32).min(max_absorption)))
    set_health(mut data, float_or(saved, "Health", max_health), max_health)
    s.xp_progress = float_or(saved, "XpP", 0.0f32)
    s.xp_level = int_or(saved, "XpLevel", 0)
    s.xp_total = int_or(saved, "XpTotal", 0)
    s.xp_seed = int_or(saved, "XpSeed", 0)
    data.set(SCORE, Value.Number(int_or(saved, "Score", 0)))
    s.food = int_or(saved, "foodLevel", 20)
    s.food_timer = int_or(saved, "foodTickTimer", 0)
    s.saturation = float_or(saved, "foodSaturationLevel", 5.0f32)
    s.exhaustion = float_or(saved, "foodExhaustionLevel", 0.0f32)
    return s
}

/// The player's status into their saved data `d`, as `addAdditionalSaveData` writes it: their
/// air, frozen ticks where they've any, health, absorption, experience, score and food.
pub fn write_status(s: Status, data: EntityData, d: mut JavaHashMap<String, Tag>) {
    d.insert(String("Air"), Tag.Short(i16.wrap(data.number(AIR_SUPPLY))))
    let frozen = data.number(TICKS_FROZEN)
    if frozen > 0 {
        d.insert(String("TicksFrozen"), Tag.Int(frozen))
    } else {
        _ = d.remove("TicksFrozen")
    }
    d.insert(String("Health"), Tag.float(data.float(HEALTH)))
    d.insert(String("AbsorptionAmount"), Tag.float(data.float(ABSORPTION)))
    d.insert(String("XpP"), Tag.float(s.xp_progress))
    d.insert(String("XpLevel"), Tag.Int(s.xp_level))
    d.insert(String("XpTotal"), Tag.Int(s.xp_total))
    d.insert(String("XpSeed"), Tag.Int(s.xp_seed))
    d.insert(String("Score"), Tag.Int(data.number(SCORE)))
    d.insert(String("foodLevel"), Tag.Int(s.food))
    d.insert(String("foodTickTimer"), Tag.Int(s.food_timer))
    d.insert(String("foodSaturationLevel"), Tag.float(s.saturation))
    d.insert(String("foodExhaustionLevel"), Tag.float(s.exhaustion))
}

/// `ServerPlayer.tickRegeneration`, at the player's tick `tick_count`: in peaceful, with natural
/// regeneration on, every 20 ticks a heart's half back and a point of saturation, up to 20, and
/// every 10 a point of food while they're hungry.
pub fn tick_regeneration(s: mut Status, data: mut EntityData, tick_count: i32, peaceful: bool, regenerates: bool, max_health: f32) {
    if not peaceful or not regenerates {
        return
    }
    if tick_count % 20 == 0 {
        if data.float(HEALTH) < max_health {
            heal(mut data, 1.0f32, max_health)
        }
        if s.saturation < 20.0f32 {
            s.saturation = s.saturation + 1.0f32
        }
    }
    if tick_count % 10 == 0 and s.food < 20 {
        s.food += 1
    }
}

/// `FoodData.tick`: past 4 exhaustion, a point of saturation spent, or of food where there's none
/// and it isn't peaceful; then, with natural regeneration on, a hurt player full of food healed
/// from their saturation every 10 ticks, or from their food every 80; a starving one hurt every 80,
/// which is told of in `missing`; else the timer starts again.
pub fn tick_food(s: mut Status, data: mut EntityData, difficulty: i32, regenerates: bool, max_health: f32, missing: mut List<String>) {
    if s.exhaustion > 4.0f32 {
        s.exhaustion = s.exhaustion - 4.0f32
        if s.saturation > 0.0f32 {
            s.saturation = (s.saturation - 1.0f32).max(0.0f32)
        } else if difficulty != 0 {
            s.food = (s.food - 1).max(0)
        }
    }
    let health = data.float(HEALTH)
    let hurt = health > 0.0f32 and health < max_health
    if regenerates and s.saturation > 0.0f32 and hurt and s.food >= 20 {
        s.food_timer += 1
        if s.food_timer >= 10 {
            let spent = s.saturation.min(6.0f32)
            heal(mut data, spent / 6.0f32, max_health)
            s.exhaust(spent)
            s.food_timer = 0
        }
    } else if regenerates and s.food >= 18 and hurt {
        s.food_timer += 1
        if s.food_timer >= 80 {
            heal(mut data, 1.0f32, max_health)
            s.exhaust(6.0f32)
            s.food_timer = 0
        }
    } else if s.food <= 0 {
        s.food_timer += 1
        if s.food_timer >= 80 {
            if health > 10.0f32 or difficulty == 3 or (health > 1.0f32 and difficulty == 2) {
                missing.push(String("Starving"))
            }
            s.food_timer = 0
        }
    } else {
        s.food_timer = 0
    }
}

// The saved number `key`, read as `getIntOr` reads any number, or `fallback`.
fn int_or(d: JavaHashMap<String, Tag>, key: str, fallback: i32) -> i32 {
    if not d.contains(key) {
        return fallback
    }
    return d[key].number_int() ?? fallback
}

// The saved number `key` as a float, as `getFloatOr` reads it, or `fallback`.
fn float_or(d: JavaHashMap<String, Tag>, key: str, fallback: f32) -> f32 {
    if not d.contains(key) {
        return fallback
    }
    return match d[key] {
        Tag.Float(v) => v,
        Tag.Double(v) => f32.nearest(v),
        Tag.Int(v) => f32.nearest(f64(v)),
        Tag.Short(v) => f32.nearest(f64(v)),
        Tag.Byte(v) => f32.nearest(f64(v)),
        Tag.Long(v) => f32.nearest(f64.nearest(v)),
        _ => fallback,
    }
}
