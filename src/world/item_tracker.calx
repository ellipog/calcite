/// What players are told of an item entity, an experience orb, an armor stand or an arrow, as
/// vanilla's `ServerEntity` and `ChunkMap.TrackedEntity` tell them (CAL-148, CAL-154, CAL-155,
/// CAL-159): `add_entity`
/// and its data as it comes into a player's view, then, each tick its tracker runs, its motion where
/// it changed, its moves in 4096ths of a block from where it was last sent, or the whole of where it
/// is where those won't do, its data where it changed, and a living entity's head's turn. A living
/// entity's moves go as the path it took, `SteppedInterpolationTracker`'s: a step where its place
/// was to be synced since the tracker last ran, as after a bounce, and one where it is, each with
/// the ticks since the step before, sent from step to step, `VecDelta.Stepped`, or whole,
/// `PositionPath.Stepped`; the first time its tracker runs, it has none, and goes as an item does.
/// An item's
/// stack; an orb's value, which doesn't; a living entity's values and attributes, which the caller
/// packs where `Sent.Dirty` says, as `sendDirtyEntityData` sends them.
///
/// The tracker of an item or orb runs every 20 ticks, `updateInterval`, an armor stand's every 3
/// and a player's every 2 (CAL-174), an arrow's every 20, sooner where its motion changed enough or
/// its data did, and sends where it is every 60 ticks if it hasn't moved, an arrow's where it is
/// and its turn each time it runs, as `ServerEntity` has it for an `AbstractArrow`, and its values
/// as a living entity's go; each but a player's tracks its motion,
/// `trackDeltas`, so sends that whenever it changed by more than a little, as a player's does only
/// where it's to be synced, `needsSync`. Where it is goes whole,
/// `ClientboundEntityPositionSyncPacket`, as it lands or leaves the ground, after 400 ticks of
/// moves, where a move's too big for a short, and, for an item alone, where it hit something and
/// the 4096ths would leave it a little off across, `isFullPrecisionEncodingRequired`. An area
/// effect cloud's never runs on a count of ticks, `UpdateInterval.NEVER`, only where it needs
/// syncing or its values changed (D529).
module world.item_tracker

import nbt.tag.{Tag}
import protocol.wire.{Writer}
import world.body.{Body}

/// How many ticks an item's or orb's tracker waits between runs, `updateInterval`, and how far it's
/// seen, `clientTrackingRange`, in chunks, the same for both; and an armor stand's.
pub const UPDATE_INTERVAL: i32 = 20
pub const TRACKING_RANGE: i32 = 6
pub const STAND_UPDATE_INTERVAL: i32 = 3
pub const STAND_TRACKING_RANGE: i32 = 10
/// A player's, `EntityType.PLAYER`'s (CAL-174).
pub const PLAYER_UPDATE_INTERVAL: i32 = 2
pub const PLAYER_TRACKING_RANGE: i32 = 32
/// An arrow's, `EntityType.ARROW`'s (CAL-159).
pub const ARROW_UPDATE_INTERVAL: i32 = 20
pub const ARROW_TRACKING_RANGE: i32 = 4
/// A thrown potion's, `EntityType.SPLASH_POTION`'s (D527).
pub const THROWN_UPDATE_INTERVAL: i32 = 10
pub const THROWN_TRACKING_RANGE: i32 = 4
/// An area effect cloud's range, `EntityType.AREA_EFFECT_CLOUD`'s, which has no update interval,
/// `noUpdateInterval` (D529).
pub const CLOUD_TRACKING_RANGE: i32 = 10

/// What a tracker sends the players that see its item, in the order it sends them.
pub enum Sent {
    /// `ClientboundSetEntityMotionPacket`.
    Motion(f64, f64, f64)
    /// `ClientboundSetEntityMotionPacket` of its motion as it is, `syncVelocity`'s, to those who
    /// see it and, a player's, to them too, `sendToTrackingPlayersAndSelf` (CAL-174).
    Velocity(f64, f64, f64)
    /// `ClientboundMoveEntityPacket.Pos`: the move, and whether it's on the ground.
    Pos(i16, i16, i16, bool)
    /// `ClientboundMoveEntityPacket.PosRot`.
    PosRot(i16, i16, i16, i8, i8, bool)
    /// `ClientboundMoveEntityPacket.Rot`.
    Rot(i8, i8, bool)
    /// `ClientboundEntityPositionSyncPacket`: where it is, its yaw and pitch, and whether it's on
    /// the ground.
    Sync(f64, f64, f64, f32, f32, bool)
    /// `ClientboundSetEntityDataPacket` of its data: its shared flags, where they changed, and an
    /// item's stack, `DATA_ITEM`, or an orb's value, where it did (D435).
    Data(i8?, Tag?)
    /// `sendDirtyEntityData` of a living entity: its values that changed, which are then what a
    /// player coming to see it is sent, and its attributes that did, for the caller to pack.
    Dirty
    /// `ClientboundRotateHeadPacket`: its head's turn.
    Head(i8)
    /// `ClientboundMoveEntityPacket.Pos` of a living entity's path, `VecDelta.Stepped`: each
    /// step's ticks and move from the step before, and whether it's on the ground.
    StepsPos(List<DeltaStep>, bool)
    /// `ClientboundMoveEntityPacket.PosRot` of one, its yaw and pitch.
    StepsPosRot(List<DeltaStep>, i8, i8, bool)
    /// `ClientboundEntityPositionSyncPacket` of one, `PositionPath.Stepped`: each step where and
    /// its ticks, its yaw and pitch, and whether it's on the ground.
    StepsSync(List<PathStep>, f32, f32, bool)
}

/// A step of a living entity's path, `PositionStep`: where it was, and how many ticks after the
/// step before.
pub struct PathStep {
    pub x: f64
    pub y: f64
    pub z: f64
    pub ticks: i32
}

/// A step as `VecDelta.Stepped.DeltaStep` sends it: its ticks, and its move from the step before,
/// or from where the moves are counted from for the first, in 4096ths of a block.
pub struct DeltaStep {
    pub ticks: i32
    pub xa: i16
    pub ya: i16
    pub za: i16
}

/// An entity's tracker.
pub struct Tracker {
    /// The entity's ID; how many ticks it waits between runs and how far it's seen, in chunks; and
    /// whether it's an item, which alone is sent whole where 4096ths would leave it a little off,
    /// and living, whose values and head's turn are sent.
    pub id: i32
    pub interval: i32 = UPDATE_INTERVAL
    pub range: i32 = TRACKING_RANGE
    item: bool = true
    living: bool = false
    // Whether it's an arrow's, which sends where it is and its turn each run, and its values as a
    // living entity's are sent (CAL-159); and a thrown potion's, whose values go so too (D527).
    arrow: bool = false
    thrown: bool = false
    // Whether it never runs on a count of ticks, `UpdateInterval.NEVER`, as a cloud's (D529).
    never: bool = false
    // Whether it sends its motion as that changes, `trackDelta`, as all but a player's do.
    deltas: bool = true
    // Where its moves are counted from, `positionCodec`'s base; the motion, yaw and pitch last
    // sent; how many times it's run, `tickCount`, and moved since it last sent where it was whole,
    // `teleportDelay`; whether it was on the ground when that was sent, `wasOnGround`.
    base_x: f64
    base_y: f64
    base_z: f64
    sent_vx: f64
    sent_vy: f64
    sent_vz: f64
    sent_y_rot: i8
    sent_x_rot: i8
    sent_head: i8 = 0
    // A living entity's path since its tracker last ran, and the ticks since its last step,
    // `trackedSteps` and `ticksSinceLastStep`.
    steps: List<PathStep> = List<PathStep>()
    since_step: i32 = -1
    tick_count: i32 = 0
    teleport_delay: i32 = 0
    was_on_ground: bool
    /// Its data as it was last sent, `trackedDataValues`, which a player coming to see it
    /// is sent: an item's or orb's; and a living entity's values that aren't their defaults, packed,
    /// none where all are.
    pub data: Tag
    pub values: List<u8>? = none
    /// An item's or orb's shared flags as they were last sent, `trackedDataValues`' (D435).
    pub flags: i8 = 0i8
    /// The section it was in at its last look, `lastSectionPos`.
    pub section: (i32, i32, i32)
    /// The players that see it, by their entity IDs, `seenBy`.
    pub seen_by: List<i32> = List<i32>()
}

impl Tracker {
    /// The tracker of the item `e` as it's made, as `ChunkMap.addEntity` makes it.
    pub fn new(e: Body, data: own Tag) -> Tracker {
        return Tracker {
            id: e.id,
            base_x: e.x,
            base_y: e.y,
            base_z: e.z,
            sent_vx: e.vx,
            sent_vy: e.vy,
            sent_vz: e.vz,
            sent_y_rot: pack_degrees(e.y_rot),
            sent_x_rot: pack_degrees(e.x_rot),
            was_on_ground: e.on_ground,
            data: data,
            section: section_of(e),
        }
    }

    /// The tracker of the orb `e`, with its value `data`.
    pub fn of_orb(e: Body, data: own Tag) -> Tracker {
        var t = Tracker.new(e, data)
        t.item = false
        return t
    }

    /// The tracker of the armor stand `e`, its head turned `y_head_rot`, with `values` its values
    /// that aren't their defaults, packed, as `getNonDefaultValues` packs them.
    pub fn of_stand(e: Body, y_head_rot: f32, values: own List<u8>?) -> Tracker {
        var t = Tracker.new(e, Tag.End)
        t.item = false
        t.living = true
        t.interval = STAND_UPDATE_INTERVAL
        t.range = STAND_TRACKING_RANGE
        t.sent_head = pack_degrees(y_head_rot)
        t.values = values
        return t
    }

    /// The tracker of the arrow `e`, with `values` its values that aren't their defaults, packed
    /// (CAL-159): run every 20 ticks and seen 4 chunks away.
    pub fn of_arrow(e: Body, values: own List<u8>?) -> Tracker {
        var t = Tracker.new(e, Tag.End)
        t.item = false
        t.arrow = true
        t.interval = ARROW_UPDATE_INTERVAL
        t.range = ARROW_TRACKING_RANGE
        t.values = values
        return t
    }

    /// The tracker of the thrown potion `e`, as an item's but run every 10 ticks and seen 4 chunks
    /// off, its values `values`, which the caller packs, sent as a living entity's are (D527).
    pub fn of_thrown(e: Body, values: own List<u8>?) -> Tracker {
        var t = Tracker.new(e, Tag.End)
        t.item = false
        t.thrown = true
        t.interval = THROWN_UPDATE_INTERVAL
        t.range = THROWN_TRACKING_RANGE
        t.values = values
        return t
    }

    /// The tracker of the area effect cloud `e`, its values `values`, packed, as a thrown potion's,
    /// but seen 10 chunks off and run only where it needs syncing or its values changed,
    /// `UpdateInterval.NEVER` (D529).
    pub fn of_cloud(e: Body, values: own List<u8>?) -> Tracker {
        var t = Tracker.of_thrown(e, values)
        t.never = true
        t.range = CLOUD_TRACKING_RANGE
        return t
    }

    /// The tracker of the player `e`, their head turned `y_head_rot`, with `values` their values
    /// that aren't their defaults, packed (CAL-174): a living entity's, run every 2 ticks, seen 32
    /// chunks away, that doesn't send their motion as it changes.
    pub fn of_player(e: Body, y_head_rot: f32, values: own List<u8>?) -> Tracker {
        var t = Tracker.of_stand(e, y_head_rot, values)
        t.interval = PLAYER_UPDATE_INTERVAL
        t.range = PLAYER_TRACKING_RANGE
        t.deltas = false
        return t
    }

    /// What `add_entity` says of `e` after its ID, as `ClientboundAddEntityPacket` writes it from
    /// its tracker: its UUID, its type `item_type`, where its moves are counted from, the motion
    /// last sent, its pitch, yaw and head's yaw as last sent, and 0 data.
    pub fn add_entity_body(self, e: Body, item_type: i32) -> List<u8> {
        return self.add_entity_with(e, item_type, 0)
    }

    /// The same with the data `data`, as a projectile's is its owner's ID, or 0 (CAL-159).
    pub fn add_entity_with(self, e: Body, item_type: i32, data: i32) -> List<u8> {
        var w = Writer.new()
        let (most, least) = e.uuid
        w.i64(most)
        w.i64(least)
        w.varint(item_type)
        w.f64(self.base_x)
        w.f64(self.base_y)
        w.f64(self.base_z)
        lp_vec3(mut w, self.sent_vx, self.sent_vy, self.sent_vz)
        w.i8(pack_degrees(unpack_degrees(self.sent_x_rot)))
        w.i8(pack_degrees(unpack_degrees(self.sent_y_rot)))
        w.i8(pack_degrees(unpack_degrees(self.sent_head)))
        w.varint(data)
        return w.into_bytes()
    }

    /// `ServerEntity.sendChanges` for the item or orb `e`: what its players are sent this run, to
    /// `out`, with its flags and its data where they changed (D435).
    pub fn send_changes(mut self, e: mut Body, flags_changed: i8?, data_changed: Tag?, out: mut List<Sent>) {
        let dirty = flags_changed != none or data_changed != none
        self.run(mut e, dirty, flags_changed, data_changed, 0.0f32, mut out)
    }

    /// `ServerEntity.sendChanges` for the living entity `e`, whose values changed if `dirty`, its
    /// head turned `y_head_rot`.
    pub fn send_living_changes(mut self, e: mut Body, dirty: bool, y_head_rot: f32, out: mut List<Sent>) {
        self.run(mut e, dirty, none, none, y_head_rot, mut out)
    }

    /// `sendChanges` of a thrown potion, as of an arrow, `dirty` whether its values changed (D527);
    /// and of a cloud (D529).
    pub fn send_thrown_changes(mut self, e: mut Body, dirty: bool, out: mut List<Sent>) {
        self.run(mut e, dirty, none, none, 0.0f32, mut out)
    }

    /// `ServerEntity.sendChanges` for the arrow `e`, whose values changed if `dirty` (CAL-159).
    pub fn send_arrow_changes(mut self, e: mut Body, dirty: bool, out: mut List<Sent>) {
        self.run(mut e, dirty, none, none, 0.0f32, mut out)
    }

    fn run(mut self, e: mut Body, dirty: bool, flags_changed: i8?, data_changed: Tag?, y_head_rot: f32, out: mut List<Sent>) {
        // A living entity's `updateTracking`: a tick more since its last step, and a step where
        // it is where its place is to be synced, which that takes. Nothing moves one but itself
        // yet, so none of its movement is predicted, `applyPredictedMovement`.
        if self.living {
            self.since_step += 1
            if e.sync_position {
                e.sync_position = false
                self.add_step(e.x, e.y, e.z)
            }
        }
        // `UpdateInterval.nextInterval` and `test`, a cloud's 0 and never (D529).
        if e.sync_position {
            self.tick_count = if self.never { 0 } else { self.tick_count / self.interval * self.interval + self.interval }
            e.sync_position = false
        }
        let due = not self.never and self.tick_count % self.interval == 0
        if e.needs_sync or due or dirty {
            let y_rot = pack_degrees(e.y_rot)
            let x_rot = pack_degrees(e.x_rot)
            let turned = self.arrow or (i32(y_rot) - i32(self.sent_y_rot)).abs() >= 1 or (i32(x_rot) - i32(self.sent_x_rot)).abs() >= 1
            self.teleport_delay += 1
            // `getPositionPath`: a living entity's steps, the last where it is, which are then
            // cleared; none for an item's, or where it has none, which is where it is.
            var path = List<PathStep>()
            if self.living {
                self.add_step(e.x, e.y, e.z)
                path = self.steps.copy()
                self.steps.clear()
                self.since_step = 0
            }
            let dx = e.x - self.base_x
            let dy = e.y - self.base_y
            let dz = e.z - self.base_z
            let changed = dx * dx + dy * dy + dz * dz >= f64(7.6293945e-6f32)
            let send_position = self.arrow or changed or self.tick_count % 60 == 0
            // The motion, `trackDelta`'s, or where it's to be synced, where it changed by more
            // than 1.0E-7, or to none.
            let mx = e.vx - self.sent_vx
            let my = e.vy - self.sent_vy
            let mz = e.vz - self.sent_vz
            let diff = mx * mx + my * my + mz * mz
            let still = e.vx * e.vx + e.vy * e.vy + e.vz * e.vz == 0.0
            // `createMovePacket` comes first, though the motion's sent before what it makes.
            var moved = List<Sent>()
            var has_position = false
            var has_rotation = false
            if self.teleport_delay > 400 or self.was_on_ground != e.on_ground {
                self.was_on_ground = e.on_ground
                self.teleport_delay = 0
                moved.push(sync_of(e, path))
                has_position = true
                has_rotation = true
            } else if send_position and not path.is_empty() {
                if let deltas = deltas_of(self.base_x, self.base_y, self.base_z, path) {
                    if turned {
                        moved.push(Sent.StepsPosRot(deltas, y_rot, x_rot, e.on_ground))
                        has_rotation = true
                    } else {
                        moved.push(Sent.StepsPos(deltas, e.on_ground))
                    }
                } else {
                    moved.push(sync_of(e, path))
                    has_rotation = true
                }
                has_position = true
            } else if send_position {
                let xa = round(e.x * 4096.0) - round(self.base_x * 4096.0)
                let ya = round(e.y * 4096.0) - round(self.base_y * 4096.0)
                let za = round(e.z * 4096.0) - round(self.base_z * 4096.0)
                let big = xa < -32768 or xa > 32767 or ya < -32768 or ya > 32767 or za < -32768 or za > 32767
                if big or (self.item and full_precision(e, xa, za)) {
                    moved.push(Sent.Sync(e.x, e.y, e.z, e.y_rot, e.x_rot, e.on_ground))
                    has_rotation = true
                } else if turned {
                    moved.push(Sent.PosRot(i16.wrap(xa), i16.wrap(ya), i16.wrap(za), y_rot, x_rot, e.on_ground))
                    has_rotation = true
                } else {
                    moved.push(Sent.Pos(i16.wrap(xa), i16.wrap(ya), i16.wrap(za), e.on_ground))
                }
                has_position = true
            } else if turned {
                moved.push(Sent.Rot(y_rot, x_rot, e.on_ground))
                has_rotation = true
            }
            if (self.deltas or e.needs_sync) and (diff > 1.0e-7 or (diff > 0.0 and still)) {
                self.sent_vx = e.vx
                self.sent_vy = e.vy
                self.sent_vz = e.vz
                out.push(Sent.Motion(e.vx, e.vy, e.vz))
            }
            for m in moved {
                out.push(m.copy())
            }
            // `sendDirtyEntityData`.
            if self.living or self.arrow or self.thrown {
                out.push(Sent.Dirty)
            } else if dirty {
                if let data = data_changed {
                    self.data = data.copy()
                }
                if let flags = flags_changed {
                    self.flags = flags
                }
                out.push(Sent.Data(flags_changed, data_changed.copy()))
            }
            if has_position {
                self.base_x = e.x
                self.base_y = e.y
                self.base_z = e.z
            }
            if has_rotation {
                self.sent_y_rot = y_rot
                self.sent_x_rot = x_rot
            }
            if self.living {
                let head = pack_degrees(y_head_rot)
                if (i32(head) - i32(self.sent_head)).abs() >= 1 {
                    out.push(Sent.Head(head))
                    self.sent_head = head
                }
            }
            e.needs_sync = false
        }
        self.tick_count += 1
        // `syncVelocity`, `sendToTrackingPlayersAndSelf`, its motion as it is, which isn't kept as
        // what was last sent (D416).
        if e.sync_velocity {
            e.sync_velocity = false
            out.push(Sent.Velocity(e.vx, e.vy, e.vz))
        }
    }

    /// The path a living entity's kept since its tracker last ran, and the ticks since its last
    /// step, which are its interpolation tracker's, the entity's own, not its tracker's, so a
    /// player going to another level takes them to their tracker there, `take_path` (D577).
    pub fn path(self) -> (List<PathStep>, i32) {
        return (self.steps.copy(), self.since_step)
    }

    pub fn take_path(mut self, steps: own List<PathStep>, since: i32) {
        self.steps = steps
        self.since_step = since
    }

    // `addStep`: a step where it is, where a tick's gone since the last.
    fn add_step(mut self, x: f64, y: f64, z: f64) {
        if self.since_step > 0 {
            self.steps.push(PathStep { x: x, y: y, z: z, ticks: self.since_step })
            self.since_step = 0
        }
    }
}

// `ClientboundEntityPositionSyncPacket.of`: where `e` is, along `path` where it has one.
fn sync_of(e: Body, path: List<PathStep>) -> Sent {
    if path.is_empty() {
        return Sent.Sync(e.x, e.y, e.z, e.y_rot, e.x_rot, e.on_ground)
    }
    return Sent.StepsSync(path.copy(), e.y_rot, e.x_rot, e.on_ground)
}

// `VecDelta.Stepped.tryEncode`: each step's move from the one before, the first's from x, y, z,
// in 4096ths; none where one's too far for a short.
fn deltas_of(x: f64, y: f64, z: f64, path: List<PathStep>) -> List<DeltaStep>? {
    var bx = x
    var by = y
    var bz = z
    var out = List<DeltaStep>()
    for s in path {
        let xa = round(s.x * 4096.0) - round(bx * 4096.0)
        let ya = round(s.y * 4096.0) - round(by * 4096.0)
        let za = round(s.z * 4096.0) - round(bz * 4096.0)
        if xa < -32768 or xa > 32767 or ya < -32768 or ya > 32767 or za < -32768 or za > 32767 {
            return none
        }
        out.push(DeltaStep { ticks: s.ticks, xa: i16.wrap(xa), ya: i16.wrap(ya), za: i16.wrap(za) })
        bx = s.x
        by = s.y
        bz = s.z
    }
    return some(out)
}

/// The steps as `VecDelta.write` writes a stepped delta: each its ticks and its move.
pub fn delta_bytes(steps: List<DeltaStep>) -> List<u8> {
    var w = Writer.new()
    for s in steps {
        w.varint(s.ticks)
        w.i16(s.xa)
        w.i16(s.ya)
        w.i16(s.za)
    }
    return w.into_bytes()
}

/// The path as `PositionPath.STREAM_CODEC` writes a stepped one: its type, 1, how many steps, and
/// each where and its ticks.
pub fn path_bytes(steps: List<PathStep>) -> List<u8> {
    var w = Writer.new()
    w.varint(1)
    w.varint(i32.wrap(steps.len()))
    for s in steps {
        w.f64(s.x)
        w.f64(s.y)
        w.f64(s.z)
        w.varint(s.ticks)
    }
    return w.into_bytes()
}

// `isFullPrecisionEncodingRequired` for an item: where it hit something and the 4096ths of a move
// across would leave it a little off.
fn full_precision(e: Body, xa: i64, za: i64) -> bool {
    if e.vertical_collision and ((xa != 0 and loss(e.x) != 0.0) or (za != 0 and loss(e.z) != 0.0)) {
        return true
    }
    if e.horizontal_collision and ((xa != 0 and loss(e.z) != 0.0) or (za != 0 and loss(e.x) != 0.0)) {
        return true
    }
    return false
}

// `VecDeltaCodec.encodingPrecisionLoss`.
fn loss(d: f64) -> f64 {
    return f64.nearest(round(d * 4096.0)) / 4096.0 - d
}

/// The section the entity's in, `SectionPos.of`.
pub fn section_of(e: Body) -> (i32, i32, i32) {
    return (i32.saturate(e.x.floor()) >> 4, i32.saturate(e.y.floor()) >> 4, i32.saturate(e.z.floor()) >> 4)
}

/// `Mth.packDegrees`: an angle in 256ths of a turn, a byte.
pub fn pack_degrees(angle: f32) -> i8 {
    return i8.wrap(i32.saturate(f64(angle * 256.0f32 / 360.0f32).floor()))
}

/// `Mth.unpackDegrees`.
pub fn unpack_degrees(b: i8) -> f32 {
    return f32.nearest(i32(b)) * 360.0f32 / 256.0f32
}

/// `LpVec3.write`: a motion in a byte if it's nothing, else six or more: each axis in 15 bits of
/// its share of the largest, rounded up, which takes the lowest two bits and, past 3, a varint
/// more.
pub fn lp_vec3(w: mut Writer, x0: f64, y0: f64, z0: f64) {
    let x = sanitize(x0)
    let y = sanitize(y0)
    let z = sanitize(z0)
    let most = max(x.abs(), max(y.abs(), z.abs()))
    if most < 3.051944088384301e-5 {
        w.u8(0u8)
        return
    }
    let scale = i64.saturate(most.ceil())
    let partial = (scale & 3) != scale
    let markers = if partial { (scale & 3) | 4 } else { scale }
    let xn = pack(x / f64.nearest(scale)) << 3
    let yn = pack(y / f64.nearest(scale)) << 18
    let zn = pack(z / f64.nearest(scale)) << 33
    let buffer = markers | xn | yn | zn
    w.u8(u8.wrap(buffer))
    w.u8(u8.wrap(buffer >> 8))
    w.i32(i32.wrap(buffer >> 16))
    if partial {
        w.varint(i32.wrap(scale >> 2))
    }
}

/// The motion as `lp_vec3` writes it, on its own.
pub fn lp_vec3_bytes(x: f64, y: f64, z: f64) -> List<u8> {
    var w = Writer.new()
    lp_vec3(mut w, x, y, z)
    return w.into_bytes()
}

fn sanitize(v: f64) -> f64 {
    if v.is_nan() {
        return 0.0
    }
    if v < -1.7179869183e10 {
        return -1.7179869183e10
    }
    if v > 1.7179869183e10 {
        return 1.7179869183e10
    }
    return v
}

fn pack(v: f64) -> i64 {
    return round((v * 0.5 + 0.5) * 32766.0)
}

fn max(a: f64, b: f64) -> f64 {
    return if a > b { a } else { b }
}

// `Math.round`: the nearest long, halves up, 0 for NaN.
fn round(v: f64) -> i64 {
    if v.is_nan() {
        return 0
    }
    let f = v.floor()
    let r = if v - f >= 0.5 { f + 1.0 } else { f }
    return i64.saturate(r)
}
