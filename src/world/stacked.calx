/// What a player has to craft with, as vanilla's `StackedItemContents` counts it for the recipe
/// book to place a recipe (CAL-339): how many of each item, and what `StackedContents`'
/// `RecipePicker` makes of them, each of a recipe's ingredients matched to an item, as a
/// bipartite matching, as many times over as it's asked. Vanilla keeps its counts in a map hashed
/// by identity, whose order changes from run to run and decides which of several items an
/// ingredient takes; Calcite's is the order the items were first counted in.
module world.stacked

import world.recipes.{Ingredient}

/// How many of each item there are, `StackedContents.amounts`, by the items' whole IDs, in the
/// order they were first counted.
pub struct Stacked {
    items: List<String> = List<String>()
    amounts: List<i32> = List<i32>()
    at: JavaHashMap<String, usize> = JavaHashMap<String, usize>()
}

// One matching's state, `RecipePicker`: how many ingredients there are, the items any of them
// take that there are some of, by their places in `Stacked.items`, and which ingredient each
// item could go to, `connection`, and does, `residual`, by the item's place times `count` and the
// ingredient's; which of each the path's search has seen, which ingredients have an item, and the
// path, items and ingredients by turns.
struct Picker {
    count: usize
    items: List<usize> = List<usize>()
    seen_ingredients: List<bool> = List<bool>()
    seen_items: List<bool> = List<bool>()
    satisfied: List<bool> = List<bool>()
    connection: List<bool> = List<bool>()
    residual: List<bool> = List<bool>()
    path: List<usize> = List<usize>()
}

impl Stacked {
    /// `account`: `count` more of `item`.
    pub fn account(mut self, item: String, count: i32) {
        match self.at.get(item) {
            some(i) => self.amounts[i] += count,
            none => {
                self.at.insert(item.copy(), self.items.len())
                self.items.push(item.copy())
                self.amounts.push(count)
            },
        }
    }

    /// `tryPick`: whether `ingredients` can each have an item `amount` times over, and where they
    /// can, each one's item, in their order, added to `out`.
    pub fn try_pick(mut self, ingredients: List<Ingredient>, amount: i32, out: mut List<String>) -> bool {
        var p = self.picker(ingredients)
        return self.pick(mut p, amount, true, mut out)
    }

    /// `tryPick` with no output: whether `ingredients` can each have an item `amount` times over.
    pub fn can_pick(mut self, ingredients: List<Ingredient>, amount: i32) -> bool {
        var p = self.picker(ingredients)
        var unused = List<String>()
        return self.pick(mut p, amount, false, mut unused)
    }

    /// `tryPickAll`: the most times over, at most `max`, `ingredients` can each have an item,
    /// found by halving, `getResultUpperBound` the most it starts from.
    pub fn most_picks(mut self, ingredients: List<Ingredient>, max: i32) -> i32 {
        var p = self.picker(ingredients)
        var unused = List<String>()
        var low: i32 = 0
        var high = min(max, self.upper_bound(ingredients)) + 1
        loop {
            let mid = (low + high) / 2
            if self.pick(mut p, mid, false, mut unused) {
                if high - low <= 1 {
                    return mid
                }
                low = mid
            } else {
                high = mid
            }
        }
    }

    // `RecipePicker`'s constructor: the items there are some of that any of `ingredients`
    // takes, `getUniqueAvailableIngredientItems`, each joined to the ingredients that take it.
    fn picker(self, ingredients: List<Ingredient>) -> Picker {
        var p = Picker { count: ingredients.len() }
        for k in 0..self.items.len() {
            if self.amounts[k] <= 0 {
                continue
            }
            for ingredient in ingredients {
                if ingredient.items.contains(self.items[k]) {
                    p.items.push(k)
                    break
                }
            }
        }
        let size = p.count * p.items.len()
        for _ in 0..p.count {
            p.seen_ingredients.push(false)
            p.satisfied.push(false)
        }
        for _ in 0..p.items.len() {
            p.seen_items.push(false)
        }
        for _ in 0..size {
            p.connection.push(false)
            p.residual.push(false)
        }
        for i in 0..p.count {
            for item in 0..p.items.len() {
                if ingredients[i].items.contains(self.items[p.items[item]]) {
                    p.connection[item * p.count + i] = true
                }
            }
        }
        return p
    }

    // `RecipePicker.tryPick`: each ingredient given an item there are `capacity` of, path by
    // path, those taken; then each given back, and where every ingredient had one and `want`,
    // each one's item added to `out`, in the ingredients' order.
    fn pick(mut self, p: mut Picker, capacity: i32, want: bool, out: mut List<String>) -> bool {
        if capacity <= 0 {
            return true
        }
        var satisfied: usize = 0
        loop {
            let found = self.new_path(mut p, capacity)
            if found.is_empty() {
                let valid = satisfied == p.count
                let output = valid and want
                p.clear_seen()
                for i in 0..p.count {
                    p.satisfied[i] = false
                }
                for i in 0..p.count {
                    for item in 0..p.items.len() {
                        if p.residual[item * p.count + i] {
                            p.residual[item * p.count + i] = false
                            self.amounts[p.items[item]] += capacity
                            if output {
                                out.push(self.items[p.items[item]].copy())
                            }
                            break
                        }
                    }
                }
                return valid
            }
            self.amounts[p.items[found[0]]] -= capacity
            p.satisfied[found[found.len() - 1]] = true
            satisfied += 1
            for i in 0..found.len() - 1 {
                if i % 2 == 0 {
                    p.residual[found[i] * p.count + found[i + 1]] = true
                } else {
                    p.residual[found[i + 1] * p.count + found[i]] = false
                }
            }
        }
    }

    // `tryAssigningNewItem`: from the first item there are `capacity` of that has one, a path to
    // an ingredient with no item yet, or none.
    fn new_path(self, p: mut Picker, capacity: i32) -> List<usize> {
        p.clear_seen()
        for item in 0..p.items.len() {
            if self.amounts[p.items[item]] >= capacity {
                let path = p.find_path(item)
                if not path.is_empty() {
                    return path
                }
            }
        }
        return List<usize>()
    }

    // `getResultUpperBound`: the fewest, over `ingredients`, of the most of one item each takes.
    fn upper_bound(self, ingredients: List<Ingredient>) -> i32 {
        var low = i32.MAX
        for ingredient in ingredients {
            var most: i32 = 0
            var cut = false
            for k in 0..self.items.len() {
                let count = self.amounts[k]
                if count > most {
                    if ingredient.items.contains(self.items[k]) {
                        most = count
                    }
                    if most >= low {
                        cut = true
                        break
                    }
                }
            }
            if cut {
                continue
            }
            low = most
            if low == 0 {
                break
            }
        }
        return low
    }
}

impl Picker {
    // `findNewItemAssignmentPath`: from the item `start`, a path that ends at an ingredient with
    // no item yet, through ingredients that have one and the items they have, or none.
    fn find_path(mut self, start: usize) -> List<usize> {
        self.path.clear()
        self.seen_items[start] = true
        self.path.push(start)
        while not self.path.is_empty() {
            let length = self.path.len()
            let last = self.path[length - 1]
            if (length - 1) % 2 == 0 {
                for i in 0..self.count {
                    if not self.seen_ingredients[i] and self.connection[last * self.count + i] and not self.residual[last * self.count + i] {
                        self.seen_ingredients[i] = true
                        self.path.push(i)
                        break
                    }
                }
            } else {
                if not self.satisfied[last] {
                    return self.path.copy()
                }
                for item in 0..self.items.len() {
                    if not self.seen_items[item] and self.residual[item * self.count + last] {
                        self.seen_items[item] = true
                        self.path.push(item)
                        break
                    }
                }
            }
            if self.path.len() == length {
                _ = self.path.pop()
            }
        }
        return List<usize>()
    }

    // `clearAllVisited`.
    fn clear_seen(mut self) {
        for i in 0..self.seen_ingredients.len() {
            self.seen_ingredients[i] = false
        }
        for i in 0..self.seen_items.len() {
            self.seen_items[i] = false
        }
    }
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}
