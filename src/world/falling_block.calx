/// A falling block, as vanilla's `FallingBlockEntity` makes and runs it (CAL-243): 0.98 by 0.98,
/// falling 0.04 a tick; its values `Entity`'s, then where it began, `DATA_START_POS`; the block it
/// is, saved as `BlockState.CODEC` writes it; how long it's fallen, `time`; whether it drops as an
/// item where it can't land, `dropItem`, and whether it's broken where it lands, `cancelDrop`;
/// whether it hurts what it falls on, by how much a block fallen and at most, `hurtEntities`,
/// `fallDamagePerDistance` and `fallDamageMax`; and its block entity's data, `blockData`.
///
/// Each tick, as `ServerLevel.tickNonPassenger` and `FallingBlockEntity.tick` run it, with none of
/// `Entity.baseTick`, so fire, fluids and the bottom of the world are nothing to it: air is gone,
/// `discard`; else a tick older, its fall, `applyGravity`, its move, `Entity.move`, against the
/// blocks, what the blocks along its move do to it, `applyEffectsFromBlocks`, and its way through
/// a portal it's in handed to its level, `handlePortal`. Then, on the ground or, as concrete
/// powder, in water where it is or along a move faster than 1 a tick, clipped, its motion 0.7
/// across and half back up, and its level lands it, `Shown.Fell`; else, past 100 ticks at or
/// below the bottom of the world or above its top, or past 600, its level drops it. Then it's
/// slowed by the air, 0.98, and its place is sent whole while it hits something,
/// `setRequiresPrecisePosition`.
///
/// Nothing hurts it, `hurtServer`. It's saved as `saveAsPassenger` saves it, `saved`, and loaded
/// as `EntityType.create` makes one and `load` reads it in, `loaded`.
module world.falling_block

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, BodyFacts, EntitySound, PORTAL_DELAY, bool_or, int_or}
import world.clip.{clip_collider_sources}
import world.collision.{CollisionBlocks}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, falling_block_data, FALLING_START}
import world.inside.{Acted, BlockEffect, CLEAR_FREEZE, Collector, EXTINGUISH, FREEZE, Gateways, Movement, Rain, Touched, bubble_open_above, fluid_effects, inside_blocks, touch_block}
import world.living.{FallingHurt, Fell}
import world.movement.{MovementStates}
import worldgen.facts.{Facts}

/// A falling block.
pub struct FallingBlock {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s and its own.
    pub body: Body
    pub data: EntityData
    /// The block it is, and that as `BlockState.CODEC` writes it, which it saves, `BlockState`.
    pub state: u32
    pub block: Tag
    /// How many ticks it's fallen, `time`.
    pub time: i32 = 0
    /// Whether it drops as an item where it can't land, `dropItem`; whether it's broken where it
    /// lands, `cancelDrop`.
    pub drop_item: bool = true
    pub cancel_drop: bool = false
    /// Whether it hurts what it lands on, `hurtEntities`, by `fall_hurt_amount` a block fallen,
    /// floored, and at most `fall_hurt_max`.
    pub hurt_entities: bool = false
    pub fall_hurt_amount: f32 = 0.0f32
    pub fall_hurt_max: i32 = 40
    /// Its block entity's data, `blockData`, which it gives the block entity it lands as.
    pub block_data: Tag? = none
    /// What its tick had its level do, each after so many of the tick's sounds, which its level
    /// takes as it's ticked: its way through a portal, what's missing, and its landing.
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
    pub fell: Fell? = none
    /// What it hurt as it landed this tick, which its level hurts, `causeFallDamage`.
    pub hurt: FallingHurt? = none
}

impl FallingBlock {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z, as the block `state`,
    // `block` as its codec writes it.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, state: u32, block: own Tag) -> FallingBlock {
        let body = Body.made(id, seed, x, y, z, 0.98f32, 0.98f32, 0.98f32 * 0.85f32, 0.04)
        return FallingBlock { body: body, data: falling_block_data(), state: state, block: block }
    }

    /// The block `state`, written `block`, falling from x, y, z, as `FallingBlockEntity.fall`
    /// makes it: at the block's middle across and its bottom, still, where it began its block,
    /// `setStartPos(blockPosition())`. The caller takes `waterlogged` off it first.
    pub fn fall(id: i32, seed: i64, x: i32, y: i32, z: i32, state: u32, block: own Tag) -> FallingBlock {
        var b = FallingBlock.made(id, seed, f64(x) + 0.5, f64(y), f64(z) + 0.5, state, block)
        b.data.set(FALLING_START, Value.Place(x, y, z))
        return b
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// The block it stands in, `blockPosition`.
    pub fn block_at(self) -> (i32, i32, i32) {
        return (i32.saturate(self.body.x.floor()), i32.saturate(self.body.y.floor()), i32.saturate(self.body.z.floor()))
    }

    /// Its tick among `blocks`, as `tickNonPassenger` and `FallingBlockEntity.tick` run it, in a
    /// world from `min_y` to `max_y`, where `air` says its block is air and `concrete` that it's
    /// concrete powder, `ConcretePowderBlock`: what its level's to do of its landing, in `fell`.
    pub fn tick<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, air: bool, concrete: bool, min_y: i32, max_y: i32, sounds: mut List<EntitySound>) {
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        if air {
            self.body.removed = true
            return
        }
        self.time += 1
        self.body.vy = self.body.vy - self.body.gravity_now()
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        self.body.move_by(f, m, t, blocks, vx, vy, vz)
        if let landed = self.body.fell_on.take() {
            let (fell, on) = landed
            self.fall_on(f, m, on, fell)
        }
        let moves = self.body.final_moves()
        self.blocks_act(f, t, blocks, moves, mut sounds)
        // `handlePortal`: its cooldown, then its way through the portal it's in, its cooldown
        // then 300, what it saves then its level's to take on (D578).
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        let alive = not self.body.removed
        if let p = self.body.portal_goes(alive, PORTAL_DELAY) {
            if p.gateway {
                if let done = self.body.gateway_goes(p, blocks, false, true) {
                    self.act(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.body.travel(p, saved)
                self.act(Acted.Travel(way), sounds.len())
            }
        }
        if not self.body.removed {
            let (sx, sy, sz) = self.block_at()
            var bx = sx
            var by = sy
            var bz = sz
            var stuck = concrete and water_at(f, blocks, bx, by, bz)
            let (mx, my, mz) = (self.body.vx, self.body.vy, self.body.vz)
            if concrete and mx * mx + my * my + mz * mz > 1.0 {
                let hit = clip_collider_sources(f, m, blocks, self.body.mover(), (self.body.xo, self.body.yo, self.body.zo), (self.body.x, self.body.y, self.body.z))
                if not hit.missed and water_at(f, blocks, hit.bx, hit.by, hit.bz) {
                    bx = hit.bx
                    by = hit.by
                    bz = hit.bz
                    stuck = true
                }
            }
            if not self.body.on_ground and not stuck {
                if (self.time > 100 and (by <= min_y or by > max_y)) or self.time > 600 {
                    self.fell = some(Fell { at: (bx, by, bz), stuck: false, expired: true })
                }
            } else {
                self.body.vx = self.body.vx * 0.7
                self.body.vy = self.body.vy * -0.5
                self.body.vz = self.body.vz * 0.7
                self.fell = some(Fell { at: (bx, by, bz), stuck: stuck, expired: false })
            }
        }
        let drag = f64(0.98f32)
        self.body.vx = self.body.vx * drag
        self.body.vy = self.body.vy * drag
        self.body.vz = self.body.vz * drag
        self.body.precise = self.body.horizontal_collision or self.body.vertical_collision
    }

    // The block `on`'s `fallOn` of it, landed from `fell` up: powder snow's nothing to what isn't
    // alive; hay's, honey's and slime's the whole fall, as nothing that isn't alive keeps off a
    // bounce; a pointed dripstone's tip pointing up 2.5 more; any other block's the fall less its
    // `fallDistanceReduction`, `Block.fallOn`. Farmland's draw is its level's, `farmland_fall`.
    fn fall_on(mut self, f: Facts, m: MovementStates, on: u32, fell: f64) {
        let block = f.block(on)
        if f.is_a(block, String("PowderSnowBlock")) {
            return
        }
        var distance = fell * f64(1.0f32 - m.fall_reduction(block))
        if f.is_a(block, String("HayBlock")) or f.is_a(block, String("HoneyBlock")) or f.is_a(block, String("SlimeBlock")) {
            distance = fell
        } else if f.is_a(block, String("PointedDripstoneBlock")) {
            let up = f.get_name(on, String("vertical_direction")) == some(String("up"))
            let tip = f.get_name(on, String("thickness")) == some(String("tip"))
            if up and tip {
                distance = fell + 2.5
            }
        }
        self.cause_fall_damage(f, distance)
    }

    // `FallingBlockEntity.causeFallDamage` from `fell` up: where it hurts what it lands on, by
    // its damage a block fallen past the first, rounded up, floored, at most its most, the living
    // things in its box, by its level, `hurt`; then, an anvil hurting something, damaged one time
    // in 20 more each block, drawn from its own random, `AnvilBlock.damage`, a damaged anvil
    // broken, `cancelDrop`.
    fn cause_fall_damage(mut self, f: Facts, fell: f64) {
        if not self.hurt_entities {
            return
        }
        let distance = i32.saturate((fell - 1.0).ceil())
        if distance < 0 {
            return
        }
        let block = f.block(self.state)
        let scaled = i32.saturate(f64((f32.nearest(distance) * self.fall_hurt_amount).floor()))
        let damage = if scaled < self.fall_hurt_max { scaled } else { self.fall_hurt_max }
        let anvil = f.is_a(block, String("AnvilBlock"))
        var kind = 0
        if anvil {
            kind = 1
        } else if f.is_a(block, String("SpeleothemBlock")) {
            kind = 2
        }
        var chipped = false
        if anvil and damage > 0 and self.body.random.next_float() < 0.05f32 + f32.nearest(distance) * 0.05f32 {
            let name = f.codec.blocks.name(block)
            var next: String? = none
            if name == "minecraft:anvil" {
                next = some(String("minecraft:chipped_anvil"))
            } else if name == "minecraft:chipped_anvil" {
                next = some(String("minecraft:damaged_anvil"))
            }
            match next {
                some(n) => if let b = f.block_named(n) {
                    let facing = f.get_name(self.state, String("facing")) ?? String("north")
                    self.state = f.try_name(f.default_state(b), String("facing"), facing)
                    chipped = true
                },
                none => self.cancel_drop = true,
            }
        }
        self.hurt = some(FallingHurt { damage: f32.nearest(damage), kind: kind, chipped: chipped })
    }

    // `applyEffectsFromBlocks` along `moves`, as primed TNT's: what the block it's on does,
    // `stepOn`; then what it's inside, the fluids' gathered and applied in their order, cactus,
    // fire and lava hurting it not at all, as nothing does; then the rain, as for any entity.
    fn blocks_act<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, t: BodyFacts, blocks: B, moves: List<Movement>, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        if let a = self.body.step_on_block(f, t, blocks, false) {
            self.act(a, sounds.len())
        }
        let froze = self.body.extras.contains("TicksFrozen")
        let was = (false, froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height, self.body.fall) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                match touch_block(f, i, mut c, false, false, self.body.on_ground, self.body.y) {
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Plate(at) => self.act(Acted.Plate(at), sounds.len()),
                    Touched.Tripwire(at) => self.act(Acted.Tripwire(at), sounds.len()),
                    Touched.Dripleaf(at) => self.act(Acted.Dripleaf(at), sounds.len()),
                    Touched.Rail(at) => self.act(Acted.Rail(at), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, false),
                    Touched.EndPortal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, true),
                    Touched.Gateway(g) => {
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if not self.body.removed and blocks.gateway_open(gx, gy, gz) {
                            self.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.act(Acted.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    Touched.Web => self.body.web(),
                    Touched.Honey((hx, hy, hz)) => {
                        if self.body.honey_slide(hx, hy, hz) {
                            let at: ((f64, f64, f64), i32)? = if self.silent() { none } else { some(((self.body.x, self.body.y, self.body.z), self.body.sound_source)) }
                            self.act(Acted.Honey(at), sounds.len())
                        }
                    },
                    Touched.PowderSnow((_, sy, _)) => {
                        if self.body.powder_snow() {
                            let at = (self.body.x, f64(sy + 1), self.body.z)
                            self.act(Acted.Snow(at), sounds.len())
                        }
                    },
                    Touched.Bubble((drag, (bx, by, bz))) => {
                        let above = bubble_open_above(f, blocks, bx, by, bz)
                        self.body.bubble_column(drag, above)
                        if above {
                            self.act(Acted.Bubbles((bx, by, bz)), sounds.len())
                        }
                    },
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => {
                    if kind == CLEAR_FREEZE {
                        _ = self.body.extras.remove("TicksFrozen")
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == EXTINGUISH {
                        self.body.put_out()
                    } else if kind == FREEZE {
                        _ = self.body.freeze()
                        self.data.set(TICKS_FROZEN, Value.Number(self.body.frozen()))
                    }
                },
                _ => {},
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.body.extras.contains("TicksFrozen")
        self.body.after_inside(true, was, freezing, rained, mut sounds)
    }

    // What a block did that its level's to do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// then its block, how long it's fallen, whether it drops, whether it hurts, by how much and
    /// at most, its block entity's data where it has some, and whether it's broken landing.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:falling_block")
        t.insert(String("BlockState"), self.block.copy())
        t.insert(String("Time"), Tag.Int(self.time))
        t.insert(String("DropItem"), Tag.Byte(if self.drop_item { 1i8 } else { 0i8 }))
        t.insert(String("HurtEntities"), Tag.Byte(if self.hurt_entities { 1i8 } else { 0i8 }))
        t.insert(String("FallHurtAmount"), Tag.Float(self.fall_hurt_amount))
        t.insert(String("FallHurtMax"), Tag.Int(self.fall_hurt_max))
        if let data = self.block_data {
            t.insert(String("TileEntityData"), data.copy())
        }
        t.insert(String("CancelDrop"), Tag.Byte(if self.cancel_drop { 1i8 } else { 0i8 }))
        return Tag.Compound(t)
    }

    /// The falling block `tag` saves, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes one and `Entity.load` and `readAdditionalSaveData` read it in:
    /// what every entity reads, `world.body`'s, and its values from it; its block, `state` written
    /// `block` as the caller read it with `BlockState.CODEC`, sand where it didn't read; whether
    /// it hurts, by default where it's an anvil, `anvil`; and the rest, each its default where
    /// it hasn't it. `none` where it's somewhere that isn't a number, logged in `lines`.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, state: u32, block: own Tag, anvil: bool, lines: mut List<Entry>) -> FallingBlock? {
        var p = FallingBlock.made(id, seed, 0.0, 0.0, 0.0, state, block.copy())
        if not p.load_onto(tag, state, block, anvil, mut lines) {
            return none
        }
        return some(p)
    }

    /// `Entity.load` onto it as it is, as `data` changes an entity's data, and as `loaded` reads a
    /// fresh one. False where it doesn't load, logged in `lines`. It is `state`, written `block`,
    /// as the caller read its `BlockState`, an anvil where `anvil`.
    pub fn load_onto(mut self, tag: JavaHashMap<String, Tag>, state: u32, block: own Tag, anvil: bool, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.state = state
        self.block = block
        self.data.set(AIR_SUPPLY, Value.Number(self.body.air))
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.time = int_or(tag, "Time", 0)
        self.hurt_entities = flag_or(tag, "HurtEntities", anvil)
        self.fall_hurt_amount = if tag.contains("FallHurtAmount") { tag["FallHurtAmount"].number_float() ?? 0.0f32 } else { 0.0f32 }
        self.fall_hurt_max = int_or(tag, "FallHurtMax", 40)
        self.drop_item = flag_or(tag, "DropItem", true)
        self.block_data = none
        if tag.contains("TileEntityData") {
            if let Tag.Compound(_) = tag["TileEntityData"] {
                self.block_data = some(tag["TileEntityData"].copy())
            }
        }
        self.cancel_drop = flag_or(tag, "CancelDrop", false)
        return true
    }
}

// `getBooleanOr(key, fallback)`: a number's not 0, else `fallback`.
fn flag_or(tag: JavaHashMap<String, Tag>, key: str, fallback: bool) -> bool {
    if not tag.contains(key) {
        return fallback
    }
    let n = tag[key].number_double() else return fallback
    return n != 0.0
}

// Whether the fluid at x, y, z is water, `getFluidState(pos).is(FluidTags.WATER)`; none where its
// chunk isn't loaded.
fn water_at<B: CollisionBlocks>(f: Facts, blocks: B, x: i32, y: i32, z: i32) -> bool {
    let state = blocks.collision_state(x, y, z) else return false
    return f.is_water(state)
}
