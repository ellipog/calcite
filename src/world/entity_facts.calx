/// `PathType`, in its order, what pathfinding makes of a block (CAL-157).
pub const PATH_BLOCKED: u8 = 0
pub const PATH_OPEN: u8 = 1
pub const PATH_WALKABLE: u8 = 2
pub const PATH_WALKABLE_DOOR: u8 = 3
pub const PATH_TRAPDOOR: u8 = 4
pub const PATH_POWDER_SNOW: u8 = 5
pub const PATH_ON_TOP_OF_POWDER_SNOW: u8 = 6
pub const PATH_FENCE: u8 = 7
pub const PATH_LAVA: u8 = 8
pub const PATH_WATER: u8 = 9
pub const PATH_WATER_BORDER: u8 = 10
pub const PATH_RAIL: u8 = 11
pub const PATH_UNPASSABLE_RAIL: u8 = 12
pub const PATH_FIRE_IN_NEIGHBOR: u8 = 13
pub const PATH_FIRE: u8 = 14
pub const PATH_DAMAGING_IN_NEIGHBOR: u8 = 15
pub const PATH_DAMAGING: u8 = 16
pub const PATH_DOOR_OPEN: u8 = 17
pub const PATH_DOOR_WOOD_CLOSED: u8 = 18
pub const PATH_DOOR_IRON_CLOSED: u8 = 19
pub const PATH_BREACH: u8 = 20
pub const PATH_LEAVES: u8 = 21
pub const PATH_STICKY_HONEY: u8 = 22
pub const PATH_COCOA: u8 = 23
pub const PATH_DAMAGE_CAUTIOUS: u8 = 24
pub const PATH_ON_TOP_OF_TRAPDOOR: u8 = 25
pub const PATH_BIG_MOBS_CLOSE_TO_DANGER: u8 = 26
/// How many path types there are.
pub const PATH_TYPE_COUNT: usize = 27

/// The path types' names, in their order.
pub fn path_type_names() -> List<String> {
    return ["BLOCKED", "OPEN", "WALKABLE", "WALKABLE_DOOR", "TRAPDOOR", "POWDER_SNOW", "ON_TOP_OF_POWDER_SNOW", "FENCE", "LAVA", "WATER", "WATER_BORDER", "RAIL", "UNPASSABLE_RAIL", "FIRE_IN_NEIGHBOR", "FIRE", "DAMAGING_IN_NEIGHBOR", "DAMAGING", "DOOR_OPEN", "DOOR_WOOD_CLOSED", "DOOR_IRON_CLOSED", "BREACH", "LEAVES", "STICKY_HONEY", "COCOA", "DAMAGE_CAUTIOUS", "ON_TOP_OF_TRAPDOOR", "BIG_MOBS_CLOSE_TO_DANGER"]
}

/// Each path type's malus, `getMalus`, what a mob's `getPathfindingMalus` gives where it has
/// none of its own, in their order.
pub fn path_maluses() -> List<f32> {
    return [-1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, -1.0f32, 0.0f32, -1.0f32, -1.0f32, 8.0f32, 8.0f32, 0.0f32, -1.0f32, 8.0f32, 16.0f32, 8.0f32, -1.0f32, 0.0f32, -1.0f32, -1.0f32, 4.0f32, -1.0f32, 8.0f32, 0.0f32, 0.0f32, 0.0f32, 4.0f32]
}

/// What a state's path facts say `isPathfindable` gives for each `PathComputationType`, two bits
/// each from bit `2 * COMPUTATION_LAND`, `2 * COMPUTATION_WATER` and `2 * COMPUTATION_AIR`.
/// It's pathfindable never.
pub const PATHFINDABLE_NEVER: u32 = 0
/// It's pathfindable always.
pub const PATHFINDABLE_ALWAYS: u32 = 1
/// It's pathfindable where its fluid is in `#water`.
pub const PATHFINDABLE_IN_WATER: u32 = 2
/// It's pathfindable where its fluid isn't in `#lava`.
pub const PATHFINDABLE_NOT_IN_LAVA: u32 = 3
pub const COMPUTATION_LAND: u32 = 0
pub const COMPUTATION_WATER: u32 = 1
pub const COMPUTATION_AIR: u32 = 2
/// Where the class a state is, of those `getPathTypeFromState` asks about, is in its path facts,
/// and the classes.
pub const PATH_KIND_SHIFT: u32 = 6
/// It's none of the others.
pub const PATH_KIND_OTHER: u32 = 0
/// It's a door, open.
