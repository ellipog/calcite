        "################################################################################################",
        "################################################################################################",
        "############################################################################################!!!!",
        "!!!!!!!!!!!!!!!!!$!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$",
        "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$",
        "$$$$$$$$!!$",
    ]
    let alphabet = "!#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz|~"
    var digit: List<u32> = []
    for _ in 0..128 {
        digit.push(0)
    }
    for i in 0..alphabet.len() {
        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)
    }
    let pair = alphabet.byte_at(89)
    var paths: List<u32> = []
    paths.reserve(35723)
    for line in lines {
        var i: usize = 0
        while i < line.len() {
            let b = line.byte_at(i)
            if b == pair {
                paths.push(values[usize(89 + digit[usize(line.byte_at(i + 1))])])
                i += 2
            } else {
                paths.push(values[usize(digit[usize(b)])])
                i += 1
            }
        }
    }
    return paths
}

/// The block tags `getPathTypeFromState` reads, and vanilla's blocks in each, by ID, for
/// test/paths.calx.
pub fn path_block_tag_names() -> List<String> {
    return ["minecraft:trapdoors", "minecraft:speleothems", "minecraft:fences", "minecraft:walls", "minecraft:fire", "minecraft:campfires"]
}

pub fn path_block_tag_blocks() -> List<List<i32>> {
    let tags: List<List<i32>> = [
        [365, 366, 367, 368, 369, 370, 371, 372, 373, 374, 375, 580, 981, 982, 1174, 1175, 1176, 1177, 1178, 1179, 1180, 1181],
        [1223, 1224],
        [333, 432, 692, 693, 694, 695, 696, 697, 698, 699, 700, 701, 979, 980],
        [429, 460, 461, 914, 915, 916, 917, 918, 919, 920, 921, 922, 923, 924, 925, 926, 1016, 1024, 1030, 1077, 1081, 1086, 1092, 1096, 1100, 1105, 1109, 1113, 1245, 1249, 1253, 1257],
        [240, 241],
        [949, 950],
    ]
    return tags
}

/// The fluid tags it reads, and vanilla's fluids in each, by ID, for test/paths.calx.
pub fn path_fluid_tag_names() -> List<String> {
    return ["minecraft:water", "minecraft:lava"]
}

pub fn path_fluid_tag_fluids() -> List<List<i32>> {
    let tags: List<List<i32>> = [
        [1, 2],
        [3, 4],
    ]
    return tags
}