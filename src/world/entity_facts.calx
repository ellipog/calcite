/// What vanilla 26.3's natural spawning asks of each entity type, in type ID order, and of each
/// block state, in state ID order, and each attribute and the player's (D375), and what
/// pathfinding reads of each state (D409). Written by oracle/datagen/calx_tables.calx from
/// entity_facts.json (D317): don't edit it.
module world.entity_facts

/// The mob categories, in `MobCategory` order, which a type's `category` is a place in.
pub fn categories() -> List<String> {
    return ["MONSTER", "CREATURE", "AMBIENT", "AXOLOTLS", "UNDERGROUND_WATER_CREATURE", "WATER_CREATURE", "WATER_AMBIENT", "MISC"]
}

/// The categories' serialized names, as codecs read and write them, in the same order.
pub fn category_names() -> List<String> {
    return ["monster", "creature", "ambient", "axolotls", "underground_water_creature", "water_creature", "water_ambient", "misc"]
}

pub const MONSTER: i32 = 0
pub const CREATURE: i32 = 1
pub const AMBIENT: i32 = 2
pub const AXOLOTLS: i32 = 3
pub const UNDERGROUND_WATER_CREATURE: i32 = 4
pub const WATER_CREATURE: i32 = 5
pub const WATER_AMBIENT: i32 = 6
pub const MISC: i32 = 7

/// `canSummon`.
pub const SUMMON: u32 = 1
/// `fireImmune`.
pub const FIRE_IMMUNE: u32 = 2
/// `canSpawnFarFromPlayer`: it spawns however far it is from players.
pub const FAR: u32 = 4
/// `isAllowedInPeaceful`.
pub const PEACEFUL: u32 = 8

/// `SpawnPlacementTypes.NO_RESTRICTIONS`.
pub const NO_RESTRICTIONS: i32 = 0
/// `SpawnPlacementTypes.IN_WATER`.
pub const IN_WATER: i32 = 1
/// `SpawnPlacementTypes.IN_LAVA`.
pub const IN_LAVA: i32 = 2
/// `SpawnPlacementTypes.ON_GROUND`.
pub const ON_GROUND: i32 = 3

/// A state is a signal source, in its spawn facts.
pub const SIGNAL_SOURCE: u32 = 1
/// Where the spawn groups' bits are in a state's spawn facts: `isValidSpawn` holds on the state
/// for the types of group `g` where bit `VALID_SPAWN_SHIFT + g` is set.
pub const VALID_SPAWN_SHIFT: u32 = 1
/// How many spawn groups there are.
pub const SPAWN_GROUPS: i32 = 4

/// The methods the types' spawn rules call, as `Owner.method`, which a type's `rule` is a place
/// in.
pub fn rules() -> List<String> {
    return [
        "AbstractNautilus.checkNautilusSpawnRules",
        "AgeableWaterCreature.checkSurfaceAgeableWaterCreatureSpawnRules",
        "Animal.checkAnimalSpawnRules",
        "Armadillo.checkArmadilloSpawnRules",
        "Axolotl.checkAxolotlSpawnRules",
        "Bat.checkBatSpawnRules",
        "Camel.checkCamelSpawnRules",
        "Drowned.checkDrownedSpawnRules",
        "Endermite.checkEndermiteSpawnRules",
        "Fox.checkFoxSpawnRules",
        "Frog.checkFrogSpawnRules",
        "Ghast.checkGhastSpawnRules",
        "GlowSquid.checkGlowSquidSpawnRules",
        "Goat.checkGoatSpawnRules",
        "Guardian.checkGuardianSpawnRules",
        "Hoglin.checkHoglinSpawnRules",
        "MagmaCube.checkMagmaCubeSpawnRules",
        "Mob.checkMobSpawnRules",
        "Monster.checkAnyLightMonsterSpawnRules",
        "Monster.checkMonsterSpawnRules",
        "Monster.checkSurfaceMonstersSpawnRules",
        "MushroomCow.checkMushroomSpawnRules",
        "Ocelot.checkOcelotSpawnRules",
        "Parrot.checkParrotSpawnRules",
        "PatrollingMonster.checkPatrollingMonsterSpawnRules",
        "Piglin.checkPiglinSpawnRules",
        "PolarBear.checkPolarBearSpawnRules",
        "Rabbit.checkRabbitSpawnRules",
        "Silverfish.checkSilverfishSpawnRules",
        "SkeletonHorse.checkSkeletonHorseSpawnRules",
        "Slime.checkSlimeSpawnRules",
        "Stray.checkStraySpawnRules",
        "Strider.checkStriderSpawnRules",
        "SulfurCube.checkSulfurCubeSpawnRules",
        "TropicalFish.checkTropicalFishSpawnRules",
        "Turtle.checkTurtleSpawnRules",
        "WaterAnimal.checkSurfaceWaterAnimalSpawnRules",
        "Wolf.checkWolfSpawnRules",
        "ZombifiedPiglin.checkZombifiedPiglinSpawnRules",
    ]
}

/// The block tags the types are immune to, as `isBlockDangerous` reads them, in the order the
/// types first name them, which a type's `immune_to` is a place in.
pub fn immune_tags() -> List<String> {
    return [
        "minecraft:default_immune_to",
        "minecraft:fox_immune_to",
        "minecraft:polar_bear_immune_to",
        "minecraft:snow_golem_immune_to",
        "minecraft:stray_immune_to",
        "minecraft:wither_immune_to",
        "minecraft:wither_skeleton_immune_to",
    ]
}

/// What natural spawning asks of an entity type.
pub struct TypeFacts {
    /// Its place in `categories`.
    pub category: i32
    /// Its flags, from those above.
    pub flags: u32
    /// The block tag it's immune to, as its place in `immune_tags`.
    pub immune_to: i32
    /// Half its spawn box's width, and its height, as `getSpawnAABB` works them out.
    pub half_width: f32
    pub height: f32
    /// Its spawn group: which states `isValidSpawn` holds on for it.
    pub spawn_group: i32
    /// Where `SpawnPlacements` registers it, its placement type and its place in `rules`, or
    /// none where it isn't; and its heightmap, of world.chunk's kinds.
    pub placement: i32?
    pub heightmap: i32
    pub rule: i32?
}

