/// It's a door, shut, of a kind opened by hand.
pub const PATH_KIND_DOOR_BY_HAND: u32 = 2
/// It's a door, shut, of a kind that isn't.
pub const PATH_KIND_DOOR_SHUT: u32 = 3
/// It's a `BaseRailBlock`.
