/// Primed TNT, as vanilla's `PrimedTnt` makes and runs it (CAL-182): 0.98 by 0.98, its eyes 0.15
/// up, falling 0.04 a tick, immune to fire; its values `Entity`'s, then its fuse, 80 by default,
/// `DATA_FUSE_ID`, and the block it shows, TNT's default state, `DATA_BLOCK_STATE_ID`; its owner,
/// by UUID, `EntityReference<LivingEntity>`; whether a portal took it, `usedPortal`, which keeps
/// nether portals whole in its explosion; and its explosion's power, 4.
///
/// Each tick, as `ServerLevel.tickNonPassenger` and `PrimedTnt.tick` run it, with none of
/// `Entity.baseTick`, so its fire, its first tick and the bottom of the world are nothing to it:
/// where it was kept, a tick older; its portal's cooldown run down and its way through a portal
/// it's in handed to its level, `handlePortal`; its fall, `applyGravity`; its move, `Entity.move`,
/// against the blocks; what the blocks along its move do to it, `applyEffectsFromBlocks`; slowed
/// by the air, `getAirDrag`, and on the ground slowed more across and bounced up half as fast as
/// it fell. Then its fuse a tick shorter; with none left it's gone, `discard`, and explodes, which
/// its level does, where the game rule `tnt_explodes` is on; else the fluids it's in push it,
/// `updateFluidInteraction`, never with a splash, as its first tick never ends. Its place is sent
/// whole while it hits something, `setRequiresPrecisePosition`.
///
/// Nothing hurts it, `hurtServer`. It's saved as `saveAsPassenger` saves it, `saved`, and loaded
/// as `EntityType.create` makes one and `load` reads it in, `loaded`.
module world.tnt

import nbt.tag.{Tag}
import random.source.{RandomSource}
import server.log.{Entry}
import std.java.math.{cos, sin}
import world.body.{Body, BodyFacts, EntitySound, PORTAL_DELAY, bool_or, int_or, short_or, uuid_of, uuid_tag}
import world.collision.{CollisionBlocks}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, SHARED_FLAGS, SILENT, TICKS_FROZEN, TNT_FUSE, TNT_STATE, Value, tnt_data}
import world.inside.{Acted, BlockEffect, CLEAR_FREEZE, Collector, EXTINGUISH, Gateways, Movement, Rain, Touched, fluid_effects, inside_blocks, touch_block}
import world.movement.{MovementStates}
import worldgen.facts.{Facts}

/// The fuse primed TNT is made with, `DEFAULT_FUSE_TIME`, and its explosion's power,
/// `DEFAULT_EXPLOSION_POWER`.
pub const DEFAULT_FUSE: i32 = 80
pub const DEFAULT_POWER: f32 = 4.0f32

/// Primed TNT.
pub struct PrimedTnt {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s and its own.
    pub body: Body
    pub data: EntityData
    /// The block it shows as `BlockState.CODEC` writes it, which it saves, `block_state`.
    pub block: Tag
    /// Its owner, by UUID, `owner`; whether a portal took it, `usedPortal`; and its explosion's
    /// power, `explosionPower`.
    pub owner: (i64, i64)? = none
    pub used_portal: bool = false
    pub power: f32 = 4.0f32
    /// What its tick had its level do, each after so many of the tick's sounds, which its level
    /// takes as it's ticked: its way through a portal, and what's missing.
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
}

impl PrimedTnt {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z; showing the block `state`,
    // `block` as its codec writes it.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, state: u32, block: own Tag) -> PrimedTnt {
        let body = Body.made(id, seed, x, y, z, 0.98f32, 0.98f32, 0.15f32, 0.04)
        return PrimedTnt { body: body, data: tnt_data(state), block: block }
    }

    /// TNT primed at x, y, z, owned by `owner`, as `new PrimedTnt(level, x, y, z, owner)` makes it,
    /// `turn` the level's draw for it, `nextDouble`, which its level draws as it's made: moving
    /// 0.02 across the way the draw turns it and 0.2 up, its fuse 80. It shows TNT's default
    /// state, `state`, written `block`.
    pub fn primed(id: i32, seed: i64, x: f64, y: f64, z: f64, turn: f64, owner: (i64, i64)?, state: u32, block: own Tag) -> PrimedTnt {
        var t = PrimedTnt.made(id, seed, x, y, z, state, block)
        let rot = turn * f64(6.2831855f32)
        t.body.vx = -sin(rot) * 0.02
        t.body.vy = f64(0.2f32)
        t.body.vz = -cos(rot) * 0.02
        t.owner = owner
        return t
    }

    /// Its fuse, `getFuse`.
    pub fn fuse(self) -> i32 {
        return self.data.number(TNT_FUSE)
    }

    /// Its fuse set to `ticks`, `setFuse`.
    pub fn set_fuse(mut self, ticks: i32) {
        self.data.set(TNT_FUSE, Value.Number(ticks))
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// Its tick among `blocks`, as `tickNonPassenger` and `PrimedTnt.tick` run it, where lava's
    /// fast if `fast_lava`: whether its fuse ran out, so it's gone and its level's to explode it.
    pub fn tick<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, m: MovementStates, t: BodyFacts, blocks: B, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        // `handlePortal`: its cooldown, then its way through the portal it's in, its cooldown
        // then 300, what it saves then its level's to take on (D578).
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        let alive = not self.body.removed
        if let p = self.body.portal_goes(alive, PORTAL_DELAY) {
            if p.gateway {
                if let done = self.body.gateway_goes(p, blocks, false, true) {
                    self.act(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.body.travel(p, saved)
                self.act(Acted.Travel(way), sounds.len())
            }
        }
        self.body.vy = self.body.vy - self.body.gravity_now()
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        self.body.move_by(f, m, t, blocks, vx, vy, vz)
        let moves = self.body.final_moves()
        self.blocks_act(f, t, blocks, moves, mut sounds)
        let drag = f64(0.98f32)
        self.body.vx = self.body.vx * drag
        self.body.vy = self.body.vy * drag
        self.body.vz = self.body.vz * drag
        if self.body.on_ground {
            self.body.vx = self.body.vx * 0.7
            self.body.vy = self.body.vy * -0.5
            self.body.vz = self.body.vz * 0.7
        }
        let fuse = self.fuse() - 1
        self.set_fuse(fuse)
        let out = fuse <= 0
        if out {
            self.body.removed = true
        } else {
            _ = self.body.update_fluids(f, t, blocks, fast_lava, true, mut sounds)
        }
        self.body.precise = self.body.horizontal_collision or self.body.vertical_collision
        return out
    }

    // `applyEffectsFromBlocks` along `moves`, where blocks act on it, as they don't on what's
    // gone or stuck in a block: what the block it's on does, `stepOn`; then what it's inside, the
    // fluids' gathered and applied in their order, cactus, fire and lava hurting it not at all, as
    // nothing does; then the rain, its going out heard and its wait, as for any entity.
    fn blocks_act<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, t: BodyFacts, blocks: B, moves: List<Movement>, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        if let a = self.body.step_on_block(f, t, blocks, false) {
            self.act(a, sounds.len())
        }
        let froze = self.body.extras.contains("TicksFrozen")
        let was = (false, froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                match touch_block(f, i, mut c, false, false, self.body.on_ground, self.body.y) {
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, false),
                    Touched.EndPortal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, true),
                    Touched.Gateway(g) => {
                        // Gone into where it may go through it, `canUsePortal`, and the
                        // gateway's open, its cooldown then begun by its level (D594).
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if not self.body.removed and blocks.gateway_open(gx, gy, gz) {
                            self.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.act(Acted.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => {
                    // Its thawing, `clearFreeze`, and its putting out, `clearFire`; fire and lava
                    // don't light it.
                    if kind == CLEAR_FREEZE {
                        _ = self.body.extras.remove("TicksFrozen")
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == EXTINGUISH {
                        self.body.put_out()
                    }
                },
                _ => {},
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.body.extras.contains("TicksFrozen")
        self.body.after_inside(true, was, freezing, rained, mut sounds)
    }

    // What a block did that its level's to do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }

    /// Where it explodes, `getY(0.0625)`: a sixteenth of the way up it.
    pub fn blast_at(self) -> (f64, f64, f64) {
        return (self.body.x, self.body.y + f64(self.body.height) * 0.0625, self.body.z)
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// then its fuse, a short, its block, its explosion's power where it isn't 4, and its owner
    /// where it has one, `EntityReference.store`.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:tnt")
        t.insert(String("fuse"), Tag.Short(i16.wrap(self.fuse())))
        t.insert(String("block_state"), self.block.copy())
        if self.power != DEFAULT_POWER {
            t.insert(String("explosion_power"), Tag.Float(self.power))
        }
        if let owner = self.owner {
            t.insert(String("owner"), uuid_tag(owner))
        }
        return Tag.Compound(t)
    }

    /// The primed TNT `tag` saves, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes one and `Entity.load` and `readAdditionalSaveData` read it in:
    /// what every entity reads, `world.body`'s, and its values from it; its fuse, 80 where it has
    /// none; its block, `state` written `block` as the caller read it with `BlockState.CODEC`,
    /// TNT's default where it didn't read; its power, 4 where it has none, kept from 0 to 128; and
    /// its owner where it reads as a UUID. `none` where it's somewhere that isn't a number,
    /// logged in `lines` as `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, state: u32, block: own Tag, lines: mut List<Entry>) -> PrimedTnt? {
        var p = PrimedTnt.made(id, seed, 0.0, 0.0, 0.0, state, block)
        if not p.body.load_from(tag, mut lines) {
            return none
        }
        p.data.set(AIR_SUPPLY, Value.Number(p.body.air))
        if p.body.extras.contains("CustomName") {
            p.data.set(CUSTOM_NAME, Value.Name(p.body.extras["CustomName"].copy()))
        }
        p.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        p.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        p.data.set(NO_GRAVITY, Value.Bool(p.body.no_gravity))
        p.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        p.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        p.set_fuse(i32(short_or(tag, "fuse", 80i16)))
        p.data.set(TNT_STATE, Value.Number(i32.wrap(state)))
        // `Mth.clamp`, which leaves NaN as it is.
        var power = DEFAULT_POWER
        if tag.contains("explosion_power") {
            power = tag["explosion_power"].number_float() ?? DEFAULT_POWER
        }
        p.power = if power < 0.0f32 { 0.0f32 } else if power > 128.0f32 { 128.0f32 } else { power }
        p.owner = uuid_of(tag, "owner")
        return some(p)
    }
}

/// `getRandomShortFuse(fuse, random)`, the fuse of TNT an explosion primes: a draw from `random`
/// under a quarter of `fuse`, at least 1, then an eighth of it more.
pub fn short_fuse<R: RandomSource>(fuse: i32, random: mut R) -> i32 {
    return random.next_int_below((fuse / 4).max(1)) + fuse / 8
}
