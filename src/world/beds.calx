/// A bed's rule, vanilla's `BedRule`, as the environment attribute `minecraft:gameplay/bed_rule`
/// or `straw_bed_rule` gives it at a bed's head (D574): whether a player may sleep in it and set
/// their spawn by it, each always, when it's dark outside or never; whether it's destroyed as
/// it's used, as a bed explodes outside the Overworld, or as its sleeper leaves it, as a straw bed
/// does; and what a player is told where they may not sleep.
module world.beds

import chat.component.{Component}
import nbt.tag.{Tag}

/// `BedRule.Rule`, by its place in `always`, `when_dark`, `never`.
pub const ALWAYS: i32 = 0
pub const WHEN_DARK: i32 = 1
pub const NEVER: i32 = 2

/// A bed's rule, `BedRule`.
pub struct BedRule {
    pub can_sleep: i32 = WHEN_DARK
    pub can_set_spawn: i32 = ALWAYS
    pub destroy_on_use: bool = false
    pub destroy_on_leave: bool = false
    pub error_message: Component? = none
}

impl BedRule {
    /// `CAN_SLEEP_WHEN_DARK`, `bed_rule`'s default: sleep when it's dark, the spawn set always,
    /// `block.minecraft.bed.no_sleep` where it isn't.
    pub fn when_dark() -> BedRule {
        return BedRule { error_message: some(Component.translatable("block.minecraft.bed.no_sleep", [])) }
    }

    /// `DESTROY_ON_LEAVE`, `straw_bed_rule`'s default: sleep when it's dark, the spawn never set,
    /// the bed gone as its sleeper leaves it.
    pub fn straw() -> BedRule {
        return BedRule { can_set_spawn: NEVER, destroy_on_leave: true, error_message: some(Component.translatable("block.minecraft.bed.no_sleep", [])) }
    }

    /// The rule `tag` is, as `BedRule.CODEC` read it, `Tag.End` for the attribute's default:
    /// `straw`'s, `DESTROY_ON_LEAVE`, or else `CAN_SLEEP_WHEN_DARK`. A message that doesn't read
    /// as a component is none.
    pub fn of(tag: Tag, straw: bool) -> BedRule {
        let Tag.Compound(m) = tag else return if straw { BedRule.straw() } else { BedRule.when_dark() }
        var out = BedRule()
        if m.contains("can_sleep") {
            out.can_sleep = rule_named(m["can_sleep"])
        }
        if m.contains("can_set_spawn") {
            out.can_set_spawn = rule_named(m["can_set_spawn"])
        }
        out.destroy_on_use = m.contains("destroy_on_use") and flag(m["destroy_on_use"])
        out.destroy_on_leave = m.contains("destroy_on_leave") and flag(m["destroy_on_leave"])
        if m.contains("error_message") {
            out.error_message = match Component.from_nbt(m["error_message"].copy()) {
                ok(c) => some(c),
                err(_) => none,
            }
        }
        return out
    }

    /// `canSleep` in a level that's dark outside or not, `isDarkOutside`.
    pub fn may_sleep(self, dark: bool) -> bool {
        return passes(self.can_sleep, dark)
    }

    /// `canSetSpawn` in a level that's dark outside or not.
    pub fn may_set_spawn(self, dark: bool) -> bool {
        return passes(self.can_set_spawn, dark)
    }
}

// `Rule.test`: always, when it's dark outside, never.
fn passes(rule: i32, dark: bool) -> bool {
    return rule == ALWAYS or (rule == WHEN_DARK and dark)
}

// A rule by its name, as `Rule.CODEC` writes it.
fn rule_named(tag: Tag) -> i32 {
    return match tag {
        Tag.Str(s) => if s == "always" { ALWAYS } else if s == "when_dark" { WHEN_DARK } else { NEVER },
        _ => NEVER,
    }
}

fn flag(tag: Tag) -> bool {
    return match tag {
        Tag.Byte(b) => b != 0i8,
        _ => false,
    }
}
