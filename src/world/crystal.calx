/// An end crystal, as vanilla's `EndCrystal` makes and runs it (D589): 2 by 2, its eyes 1.7 up,
/// with no gravity, that never moves and is never pushed, immune to fire; its values `Entity`'s,
/// then the block its beam's at, none by default, `beam_target`, and whether it shows its bottom,
/// true by default, `ShowBottom`; and a count of its ticks that starts anywhere below 100,000,
/// drawn from its random after its UUID, `time`, which its clients spin it by.
///
/// Each tick, as `ServerLevel.tickNonPassenger` and `EndCrystal.tick` run it, it's a tick older,
/// `tickCount`, and its own count goes on, `time`; what it's inside acts on it,
/// `applyEffectsFromBlocks`, though it never moves: the block it stands on where it's on the
/// ground, `stepOn`, then the blocks its box meets, fire and lava not burning it; its portal's
/// cooldown runs down and its way through a portal it's in is handed to its level,
/// `handlePortal`; and, where its level has a dragon fight, its block is set alight where it's
/// air, `BaseFireBlock.getState`, which its level does. It has none of `Entity.baseTick`, so its
/// fluids, its fire and the bottom of the world are nothing to it.
///
/// It's hurt by what isn't an ender dragon, `hurtServer`, and isn't where it's gone, invulnerable
/// to what doesn't bypass that, `Invulnerable`, or hurt by fire, `isInvulnerableToBase`: it's gone
/// at once, `remove(KILLED)`, exploding with a radius of 6 where what hurt it wasn't an
/// explosion, which its level does (CAL-182). Its dragon fight's told, `onCrystalDestroyed`, which,
/// with no dragon and no respawn, as Calcite has neither, only counts the crystals left.
///
/// It's saved as `saveAsPassenger` saves it, `saved`, and loaded as `EntityType.create` makes one
/// and `load` reads it in, `loaded`.
module world.crystal

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, BodyFacts, EntitySound, PORTAL_DELAY, bool_or, int_or}
import world.collision.{CollisionBlocks}
import world.damage.{BYPASSES_INVULNERABILITY, DamageTypes, IS_EXPLOSION, IS_FIRE}
import world.entity_data.{AIR_SUPPLY, CRYSTAL_BEAM, CRYSTAL_BOTTOM, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, crystal_data}
import world.inside.{Acted, BlockEffect, CLEAR_FREEZE, Collector, EXTINGUISH, Gateways, Movement, Rain, Touched, fluid_effects, inside_blocks, touch_block}
import worldgen.facts.{Facts}

/// An end crystal.
pub struct EndCrystal {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s and its own.
    pub body: Body
    pub data: EntityData
    /// Its count of ticks, `time`, which wraps as an int does.
    pub time: i32
    /// What its tick had its level do, each after so many of the tick's sounds, which its level
    /// takes as it's ticked: its way through a portal, and what's missing (D589).
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
}

/// Whether what hurt an end crystal had it go, and whether it explodes then, as it does where what
/// hurt it wasn't an explosion, which its level does (CAL-182).
pub struct CrystalHurt {
    pub gone: bool
    pub explodes: bool
}

impl EndCrystal {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z; then its count, drawn from
    // its random, `nextInt(100000)`.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64) -> EndCrystal {
        var body = Body.made(id, seed, x, y, z, 2.0f32, 2.0f32, 1.7f32, 0.0)
        let time = body.random.next_int_below(100000)
        return EndCrystal { body: body, data: crystal_data(), time: time }
    }

    /// The block its beam's at, `getBeamTarget`, none where it has none.
    pub fn beam_target(self) -> (i32, i32, i32)? {
        return self.data.pos(CRYSTAL_BEAM)
    }

    /// Whether it shows its bottom, `showsBottom`.
    pub fn shows_bottom(self) -> bool {
        return self.data.flag(CRYSTAL_BOTTOM)
    }

    /// Its tick among `blocks`, as `tickNonPassenger` and `EndCrystal.tick` run it: where it was
    /// kept, `setOldPosAndRot`; a tick older, `tickCount`, and its own count on; what blocks do to
    /// it, `blocks_act`; its portal's cooldown, then its way through the portal it's in, its
    /// cooldown then 300, what it saves its level's to take on (D578), `handlePortal`. The block
    /// it's in, where it's in a level with a dragon fight, `fight`, for its level to set alight
    /// where it's air, none where it isn't.
    pub fn tick<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, t: BodyFacts, types: DamageTypes, blocks: B, fight: bool, sounds: mut List<EntitySound>) -> (i32, i32, i32)? {
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        self.time = self.time.wrapping_add(1i32)
        let here = (self.body.x, self.body.y, self.body.z)
        self.blocks_act(f, t, types, blocks, [Movement { from: here, to: here }], mut sounds)
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        let alive = not self.body.removed
        if let p = self.body.portal_goes(alive, PORTAL_DELAY) {
            if p.gateway {
                if let done = self.body.gateway_goes(p, blocks, false, true) {
                    self.act(done, sounds.len())
                }
            } else {
                let saved = self.saved()
                let way = self.body.travel(p, saved)
                self.act(Acted.Travel(way), sounds.len())
            }
        }
        if fight {
            return some(self.body.block())
        }
        return none
    }

    // `applyEffectsFromBlocks` along `moves`, where blocks act on it, as they don't on what's
    // gone: what the block it's on does, `stepOn`; then what it's inside, cactus's hurt at once, 1
    // of `cactus`, and fluids', gathered and applied in their order, fire and lava burning it not
    // at all, as it's immune; then the rain, its going out heard and its wait, as for any entity.
    fn blocks_act<B: CollisionBlocks + Rain + Gateways>(mut self, f: Facts, t: BodyFacts, types: DamageTypes, blocks: B, moves: List<Movement>, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        if let a = self.body.step_on_block(f, t, blocks, false) {
            self.act(a, sounds.len())
        }
        let froze = self.body.extras.contains("TicksFrozen")
        let was = (false, froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                match touch_block(f, i, mut c, false, false, self.body.on_ground, self.body.y) {
                    Touched.Cactus => {
                        let hurt = self.hurt(types, types.id("cactus"), false, false)
                        if hurt.explodes {
                            self.act(Acted.Missing(exploded()), sounds.len())
                        }
                    },
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, false),
                    Touched.EndPortal((px, py, pz)) => self.body.inside_portal(px, py, pz, PORTAL_DELAY, true),
                    Touched.Gateway(g) => {
                        // Gone into where it may go through it, `canUsePortal`, and the
                        // gateway's open, its cooldown then begun by its level (D594).
                        let (at, cursor) = g
                        let (gx, gy, gz) = at
                        if not self.body.removed and blocks.gateway_open(gx, gy, gz) {
                            self.body.inside_gateway(gx, gy, gz, PORTAL_DELAY)
                            self.act(Acted.Gateway((at, cursor)), sounds.len())
                        }
                    },
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => {
                    // Its thawing, `clearFreeze`, and its putting out, `clearFire`; fire and lava
                    // don't light it.
                    if kind == CLEAR_FREEZE {
                        _ = self.body.extras.remove("TicksFrozen")
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == EXTINGUISH {
                        self.body.put_out()
                    }
                },
                BlockEffect.Doused(_) => {},
                _ => {},
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.body.extras.contains("TicksFrozen")
        self.body.after_inside(true, was, freezing, rained, mut sounds)
    }

    /// `hurtServer` of the damage type `kind` of `types`, by a player in creative mode or not,
    /// `creative`, and by an ender dragon or not, `by_dragon`: nothing where it's gone,
    /// invulnerable to what doesn't bypass that, `Invulnerable`, but for a player in creative mode
    /// (D590), hurt by fire, which it's immune to, or by a dragon; else it's gone,
    /// `remove(KILLED)`, exploding where what hurt it wasn't an explosion.
    pub fn hurt(mut self, types: DamageTypes, kind: i32, creative: bool, by_dragon: bool) -> CrystalHurt {
        if self.body.removed or (self.body.invulnerable and not types.is(kind, BYPASSES_INVULNERABILITY) and not creative) or types.is(kind, IS_FIRE) or by_dragon {
            return CrystalHurt { gone: false, explodes: false }
        }
        self.body.removed = true
        return CrystalHurt { gone: true, explodes: not types.is(kind, IS_EXPLOSION) }
    }

    // What a block did that its level's to do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// then the block its beam's at where it has one, `beam_target`, and whether it shows its
    /// bottom, `ShowBottom`.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:end_crystal")
        if let (x, y, z) = self.beam_target() {
            t.insert(String("beam_target"), Tag.IntArray([x, y, z]))
        }
        t.insert(String("ShowBottom"), Tag.Byte(if self.shows_bottom() { 1i8 } else { 0i8 }))
        return Tag.Compound(t)
    }

    /// The end crystal `tag` saves, with the ID `id` and a random seeded `seed`, as
    /// `EntityType.create` makes one and `Entity.load` and `readAdditionalSaveData` read it in:
    /// what every entity reads, `world.body`'s, and its values from it; the block its beam's at,
    /// none where it isn't three ints, `BlockPos.CODEC`; and whether it shows its bottom, true
    /// where that's missing. `none` where it's somewhere that isn't a number, logged in `lines` as
    /// `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> EndCrystal? {
        var c = EndCrystal.made(id, seed, 0.0, 0.0, 0.0)
        if not c.body.load_from(tag, mut lines) {
            return none
        }
        c.data.set(AIR_SUPPLY, Value.Number(c.body.air))
        if c.body.extras.contains("CustomName") {
            c.data.set(CUSTOM_NAME, Value.Name(c.body.extras["CustomName"].copy()))
        }
        c.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        c.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        c.data.set(NO_GRAVITY, Value.Bool(c.body.no_gravity))
        c.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        c.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        if tag.contains("beam_target") {
            if let Tag.IntArray(p) = tag["beam_target"] {
                if p.len() == 3 {
                    c.data.set(CRYSTAL_BEAM, Value.Pos(p[0], p[1], p[2]))
                }
            }
        }
        var bottom = true
        if tag.contains("ShowBottom") {
            bottom = tag["ShowBottom"].number_int() != some(0)
        }
        c.data.set(CRYSTAL_BOTTOM, Value.Bool(bottom))
        return some(c)
    }
}

/// What's said to be missing as an end crystal breaks in its own tick, on cactus, where its
/// explosion would come in the middle of the tick, which its level doesn't run yet (CAL-182).
pub fn exploded() -> String {
    return String("An end crystal's explosion as cactus breaks it in its tick")
}
