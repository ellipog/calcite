/// The hanging entities, vanilla's `HangingEntity`s (CAL-354): an item frame, a glow item frame
/// or a painting, held to the block at its place, `BlockAttachedEntity.pos`, facing out of it,
/// `DATA_DIRECTION`, its box made of those, `calculateBoundingBox`, and its middle that box's.
///
/// Each tick, as `BlockAttachedEntity.tick` runs it, with none of `Entity.baseTick`: below the
/// world it's gone, `checkBelowWorld`; and once every 100 ticks after the first, its server
/// looks at whether it `survives`, and where it doesn't it's gone and drops, `dropItem`. A frame
/// holds one item, turned in eighths, `DATA_ROTATION`, and may be fixed, which keeps it; a
/// painting is of a variant of `painting_variant`, its size in blocks.
module world.hanging

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, bool_or, int_or, EntitySound}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, FRAME_ITEM, FRAME_ROTATION, GLOWING_FLAG, HANGING_DIRECTION, INVISIBLE_FLAG, NO_GRAVITY, PAINTING_VARIANT_ID, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, frame_data, painting_data}

/// How often it looks at whether it survives, `CHECK_INTERVAL`.
pub const CHECK_INTERVAL: i32 = 100

/// Its kinds: an item frame, a glow item frame and a painting.
pub const FRAME: i32 = 0
pub const GLOW_FRAME: i32 = 1
pub const PAINTING: i32 = 2

/// The directions by their `get3DDataValue`: down, up, north, south, west and east.
pub const DOWN: i32 = 0
pub const UP: i32 = 1
pub const NORTH: i32 = 2
pub const SOUTH: i32 = 3
pub const WEST: i32 = 4
pub const EAST: i32 = 5

/// A hanging entity.
pub struct Hanging {
    pub body: Body
    pub data: EntityData
    pub kind: i32
    /// The block it's held to, `pos`, the way it faces, by its `get3DDataValue`, and its ticks
    /// since it last looked at whether it survives, `ticksSinceLastCheck`.
    pub at: (i32, i32, i32)
    pub dir: i32 = SOUTH
    pub since_check: i32 = 0
    /// A frame's item, none where it's empty, the chance it drops, `dropChance`, and whether it's
    /// fixed, `fixed`.
    pub item: Tag? = none
    pub drop_chance: f32 = 1.0f32
    pub fixed: bool = false
    /// A painting's variant: its ID in `painting_variant`, its name and its width and height.
    pub variant: i32 = 0
    pub variant_name: String? = none
    pub size: (i32, i32) = (1, 1)
}

impl Hanging {
    /// A frame of `kind` made at `at` facing `dir`, `ItemFrame(level, pos, direction)`: `Entity`'s
    /// fields, its random first, then its UUID, then `setDirection`.
    pub fn frame(id: i32, seed: i64, kind: i32, at: (i32, i32, i32), dir: i32) -> Hanging {
        let (x, y, z) = at
        var body = Body.made(id, seed, f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, 0.5f32, 0.5f32, 0.0f32, 0.0)
        body.needs_sync = true
        var h = Hanging { body: body, data: frame_data(), kind: kind, at: at }
        h.set_direction(dir)
        return h
    }

    /// A painting made at `at` facing `dir`, `Painting(level, pos)`, of the variant `variant`,
    /// `(id, name, width, height)`, its values' first, `VariantUtils.getAny`, as it's defined.
    pub fn painting(id: i32, seed: i64, at: (i32, i32, i32), dir: i32, first: (i32, String, i32, i32)) -> Hanging {
        let (x, y, z) = at
        var body = Body.made(id, seed, f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, 0.5f32, 0.5f32, 0.0f32, 0.0)
        body.needs_sync = true
        let (vid, name, w, hh) = first
        var data = painting_data()
        data.redefine(PAINTING_VARIANT_ID, Value.Number(vid + 1))
        var h = Hanging { body: body, data: data, kind: PAINTING, at: at, variant: vid, variant_name: some(name.copy()), size: (w, hh) }
        h.set_direction(dir)
        return h
    }

    /// Whether it's a frame of either kind.
    pub fn is_frame(self) -> bool {
        return self.kind != PAINTING
    }

    /// Its type's name.
    pub fn type_name(self) -> str {
        if self.kind == GLOW_FRAME {
            return "minecraft:glow_item_frame"
        }
        if self.kind == FRAME {
            return "minecraft:item_frame"
        }
        return "minecraft:painting"
    }

    /// A painting's variant made `variant`, `setVariant`, its box made again, as
    /// `onSyncedDataUpdated` does as it changes.
    pub fn set_variant(mut self, variant: (i32, String, i32, i32)) {
        let (vid, name, w, hh) = variant
        self.variant = vid
        self.variant_name = some(name.copy())
        self.size = (w, hh)
        self.data.set(PAINTING_VARIANT_ID, Value.Number(vid + 1))
        self.recalculate()
    }

    /// `setDirection`: the way it faces, its angles by it, and its box, `recalculateBoundingBox`.
    pub fn set_direction(mut self, dir: i32) {
        self.dir = dir
        self.data.set(HANGING_DIRECTION, Value.Number(dir))
        if self.is_frame() and (dir == DOWN or dir == UP) {
            self.body.x_rot = if dir == UP { -90.0f32 } else { 90.0f32 }
            self.body.y_rot = 0.0f32
        } else {
            if self.is_frame() {
                self.body.x_rot = 0.0f32
            }
            self.body.y_rot = f32.nearest(data_2d(dir) * 90)
        }
        self.recalculate()
    }

    /// `BlockAttachedEntity.setPos` where it is: its block the one it's in, and its box made
    /// again, `recalculateBoundingBox`, and it needs syncing.
    pub fn snap(mut self) {
        self.at = (i32.saturate(self.body.x.floor()), i32.saturate(self.body.y.floor()), i32.saturate(self.body.z.floor()))
        self.recalculate()
        self.body.needs_sync = true
    }

    /// `recalculateBoundingBox`: its box, `calculateBoundingBox`, and its middle that box's,
    /// `setPosRaw`.
    pub fn recalculate(mut self) {
        let (x0, y0, z0, x1, y1, z1) = self.made_box(self.has_map())
        let (cx, cy, cz) = ((x0 + x1) / 2.0, (y0 + y1) / 2.0, (z0 + z1) / 2.0)
        self.body.x = cx
        self.body.y = cy
        self.body.z = cz
        self.body.own_box = some((x0 - cx, y0 - cy, z0 - cz, x1 - cx, y1 - cy, z1 - cz))
    }

    /// The box it'd have, as `createBoundingBox` and `Painting.calculateBoundingBox` make it: a
    /// frame a sixteenth deep and three quarters across, or the whole block with a map,
    /// `with_map`; a painting its variant's size across, a sixteenth deep, moved half a block
    /// left and up where its width or height is even; each against the wall it's on.
    pub fn made_box(self, with_map: bool) -> (f64, f64, f64, f64, f64, f64) {
        let (bx, by, bz) = self.at
        let (sx, sy, sz) = step(self.dir)
        var cx = f64(bx) + 0.5 + f64(sx) * -0.46875
        var cy = f64(by) + 0.5 + f64(sy) * -0.46875
        var cz = f64(bz) + 0.5 + f64(sz) * -0.46875
        var xs = 0.0
        var ys = 0.0
        var zs = 0.0
        let x_axis = self.dir == WEST or self.dir == EAST
        let y_axis = self.dir == DOWN or self.dir == UP
        let z_axis = self.dir == NORTH or self.dir == SOUTH
        if self.is_frame() {
            let side = if with_map { 1.0 } else { 0.75 }
            xs = if x_axis { 0.0625 } else { side }
            ys = if y_axis { 0.0625 } else { side }
            zs = if z_axis { 0.0625 } else { side }
        } else {
            let (w, h) = self.size
            let across = if w % 2 == 0 { 0.5 } else { 0.0 }
            let up = if h % 2 == 0 { 0.5 } else { 0.0 }
            let (lx, _, lz) = step(counter_clockwise(self.dir))
            cx = cx + f64(lx) * across
            cz = cz + f64(lz) * across
            cy = cy + up
            xs = if x_axis { 0.0625 } else { f64(w) }
            ys = f64(h)
            zs = if z_axis { 0.0625 } else { f64(w) }
        }
        return (cx - xs / 2.0, cy - ys / 2.0, cz - zs / 2.0, cx + xs / 2.0, cy + ys / 2.0, cz + zs / 2.0)
    }

    /// The box whose blocks and hanging entities it can't share, `getPopBox`: a frame's without
    /// its map, a painting's own.
    pub fn pop_box(self) -> (f64, f64, f64, f64, f64, f64) {
        return self.made_box(false)
    }

    /// The box of the blocks a painting hangs on, `calculateSupportBox`: its own moved half a block
    /// into the wall and shrunk by a ten-millionth.
    pub fn support_box(self) -> (f64, f64, f64, f64, f64, f64) {
        let (x0, y0, z0, x1, y1, z1) = self.made_box(false)
        let (sx, sy, sz) = step(self.dir)
        let (mx, my, mz) = (f64(f32.nearest(sx) * -0.5f32), f64(f32.nearest(sy) * -0.5f32), f64(f32.nearest(sz) * -0.5f32))
        let e = 1.0e-7
        return (x0 + mx + e, y0 + my + e, z0 + mz + e, x1 + mx - e, y1 + my - e, z1 + mz - e)
    }

    /// Whether a frame holds a map, `hasFramedMap`.
    pub fn has_map(self) -> bool {
        let item = self.item else return false
        let Tag.Compound(m) = item else return false
        if not m.contains("components") {
            return false
        }
        let Tag.Compound(c) = m["components"] else return false
        return c.contains("minecraft:map_id")
    }

    /// A frame's item made `item`, `setItem`, sent as `sent`, as its level's codecs send it; its
    /// box made again, `onItemChanged`.
    pub fn set_item(mut self, item: Tag?, sent: List<u8>) {
        self.item = item.copy()
        self.data.set(FRAME_ITEM, Value.Stack(sent.copy()))
        self.recalculate()
    }

    /// A frame's turn, `getRotation`.
    pub fn rotation(self) -> i32 {
        return self.data.number(FRAME_ROTATION)
    }

    /// A frame's turn made `rotation`, of 8, `setRotation`.
    pub fn set_rotation(mut self, rotation: i32) {
        self.data.set(FRAME_ROTATION, Value.Number(rotation % 8))
    }

    /// A frame's signal to a comparator, `getAnalogOutput`: none when it's empty, else its turn
    /// and 1.
    pub fn analog_output(self) -> i32 {
        if self.item == none {
            return 0
        }
        return self.rotation() % 8 + 1
    }

    /// `Entity.load` onto it as it is, as `data` changes an entity's data and `summon` reads one:
    /// what every entity reads and its values from it, then its block where its `block_pos` is
    /// within 16 of where it is, `readAdditionalSaveData`; a frame's item `item`, as its codecs
    /// read it, its turn, the chance it drops, the way it faces, down where it's not there, its
    /// invisibility and whether it's fixed; a painting's way, south where it's not there, and its
    /// variant `variant` where its `variant` names one. Its box is made again of those.
    pub fn load_onto(mut self, tag: JavaHashMap<String, Tag>, item: Tag?, item_sent: List<u8>, variant: (i32, String, i32, i32)?, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.data.set(AIR_SUPPLY, Value.Number(self.body.air))
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        // `setPos`: its block the one its place is in.
        let (px, py, pz) = (i32.saturate(self.body.x.floor()), i32.saturate(self.body.y.floor()), i32.saturate(self.body.z.floor()))
        self.at = (px, py, pz)
        // Its own: the block held to, where it's near.
        if tag.contains("block_pos") {
            if let Tag.IntArray(v) = tag["block_pos"] {
                if v.len() == 3 {
                    let (dx, dy, dz) = (f64(v[0] - px), f64(v[1] - py), f64(v[2] - pz))
                    if dx * dx + dy * dy + dz * dz < 256.0 {
                        self.at = (v[0], v[1], v[2])
                    }
                }
            }
        }
        if self.is_frame() {
            self.item = item.copy()
            self.data.set(FRAME_ITEM, Value.Stack(item_sent.copy()))
            self.set_rotation(if tag.contains("ItemRotation") { i32(tag["ItemRotation"].byte_value() ?? 0i8) } else { 0 })
            self.drop_chance = if tag.contains("ItemDropChance") { f32.nearest(tag["ItemDropChance"].number_double() ?? 1.0) } else { 1.0f32 }
            let facing = if tag.contains("Facing") { i32(tag["Facing"].byte_value() ?? 0i8) } else { DOWN }
            self.set_direction(from_3d(facing))
            self.data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, bool_or(tag, "Invisible"))
            self.fixed = bool_or(tag, "Fixed")
        } else {
            let facing = if tag.contains("facing") { from_2d(i32(tag["facing"].byte_value() ?? 0i8)) } else { SOUTH }
            if let v = variant {
                self.set_variant(v)
            }
            self.set_direction(facing)
        }
        self.body.needs_sync = true
        return true
    }

    /// What it's saved as, `saveWithoutId` with its type: what every entity saves, then its own,
    /// as `addAdditionalSaveData` writes them: a frame's block, item where it has one, turn, drop
    /// chance, way by `get3DDataValue`, invisibility and fixedness; a painting's way by
    /// `get2DDataValue`, block and variant.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, self.type_name())
        let (x, y, z) = self.at
        if self.is_frame() {
            t.insert(String("block_pos"), Tag.IntArray([x, y, z]))
            if let it = self.item {
                t.insert(String("Item"), it.copy())
            }
            t.insert(String("ItemRotation"), Tag.Byte(i8.wrap(self.rotation())))
            t.insert(String("ItemDropChance"), Tag.Float(self.drop_chance))
            t.insert(String("Facing"), Tag.Byte(i8.wrap(self.dir)))
            t.insert(String("Invisible"), Tag.Byte(if self.invisible() { 1i8 } else { 0i8 }))
            t.insert(String("Fixed"), Tag.Byte(if self.fixed { 1i8 } else { 0i8 }))
        } else {
            t.insert(String("facing"), Tag.Byte(i8.wrap(data_2d(self.dir))))
            t.insert(String("block_pos"), Tag.IntArray([x, y, z]))
            if let name = self.variant_name {
                t.insert(String("variant"), Tag.Str(name.copy()))
            }
        }
        return Tag.Compound(t)
    }

    /// Whether it's invisible, `isInvisible`.
    pub fn invisible(self) -> bool {
        return (i32(self.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG) != 0
    }

    /// Its tick, `BlockAttachedEntity.tick`, at the level's bottom `min_y`: gone below the world,
    /// `true` where it's to look at whether it survives now, after 100 ticks since it last did.
    pub fn tick(mut self, min_y: i32) -> bool {
        self.body.tick_count += 1
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
            return false
        }
        let was = self.since_check
        self.since_check += 1
        if was >= CHECK_INTERVAL {
            self.since_check = 0
            return true
        }
        return false
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// The sound `name` heard from it, `Entity.playSound`, at 1 and 1, where it isn't silent.
    pub fn sound(self, name: str) -> EntitySound? {
        if self.silent() {
            return none
        }
        return some(EntitySound { sound: String(name), x: self.body.x, y: self.body.y, z: self.body.z, volume: 1.0f32, pitch: 1.0f32, source: self.body.sound_source })
    }

    /// Its sounds by kind: placed, broken, an item put in, taken out and turned.
    pub fn place_sound(self) -> str {
        return match self.kind {
            0 => "entity.item_frame.place",
            1 => "entity.glow_item_frame.place",
            _ => "entity.painting.place",
        }
    }

    pub fn break_sound(self) -> str {
        return match self.kind {
            0 => "entity.item_frame.break",
            1 => "entity.glow_item_frame.break",
            _ => "entity.painting.break",
        }
    }

    pub fn add_item_sound(self) -> str {
        return if self.kind == GLOW_FRAME { "entity.glow_item_frame.add_item" } else { "entity.item_frame.add_item" }
    }

    pub fn remove_item_sound(self) -> str {
        return if self.kind == GLOW_FRAME { "entity.glow_item_frame.remove_item" } else { "entity.item_frame.remove_item" }
    }

    pub fn rotate_item_sound(self) -> str {
        return if self.kind == GLOW_FRAME { "entity.glow_item_frame.rotate_item" } else { "entity.item_frame.rotate_item" }
    }

    /// The item it drops as itself, `getFrameItemStack` or a painting's.
    pub fn own_item(self) -> str {
        return match self.kind {
            0 => "minecraft:item_frame",
            1 => "minecraft:glow_item_frame",
            _ => "minecraft:painting",
        }
    }

    /// Where what it drops comes from, `HangingEntity.spawnAtLocation`: 0.15 out of its wall.
    pub fn drop_place(self) -> (f64, f64, f64) {
        let (sx, _, sz) = step(self.dir)
        return (self.body.x + f64(f32.nearest(sx) * 0.15f32), self.body.y, self.body.z + f64(f32.nearest(sz) * 0.15f32))
    }
}

/// The step of the direction `dir`, by its `get3DDataValue`.
pub fn step(dir: i32) -> (i32, i32, i32) {
    return match dir {
        0 => (0, -1, 0),
        1 => (0, 1, 0),
        2 => (0, 0, -1),
        3 => (0, 0, 1),
        4 => (-1, 0, 0),
        _ => (1, 0, 0),
    }
}

/// `get2DDataValue` of a direction: south 0, west 1, north 2, east 3; -1 for up and down.
pub fn data_2d(dir: i32) -> i32 {
    return match dir {
        3 => 0,
        4 => 1,
        2 => 2,
        5 => 3,
        _ => -1,
    }
}

/// `from2DDataValue`: the direction of a 2D value, by the absolute value of its remainder of 4.
pub fn from_2d(v: i32) -> i32 {
    return match (v % 4).abs() {
        0 => SOUTH,
        1 => WEST,
        2 => NORTH,
        _ => EAST,
    }
}

/// `from3DDataValue`: the direction of a 3D value, by the absolute value of its remainder of 6.
pub fn from_3d(v: i32) -> i32 {
    return (v % 6).abs()
}

/// `getCounterClockWise` of a horizontal direction about the y axis.
pub fn counter_clockwise(dir: i32) -> i32 {
    return match dir {
        2 => WEST,
        4 => SOUTH,
        3 => EAST,
        5 => NORTH,
        _ => dir,
    }
}

/// `getOpposite`.
pub fn opposite(dir: i32) -> i32 {
    return match dir {
        0 => UP,
        1 => DOWN,
        2 => SOUTH,
        3 => NORTH,
        4 => EAST,
        _ => WEST,
    }
}
