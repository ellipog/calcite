/// Dispensers and droppers dispensing, `DispenserBlock.dispenseFrom` and `DropperBlock`'s, with
/// `DefaultDispenseItemBehavior` (CAL-378). The items with a behavior of their own,
/// `DispenseItemBehavior.bootStrap`'s, and those `getDefaultDispenseMethod` gives one, are said to
/// be missing as they're dispensed.
module world.dispenser

import nbt.tag.{Tag}
import random.source.{RandomSource}
import world.block_level.{BlockLevel, update_output_signal}
import world.containers.{items_at}
import world.drops.{DropLevel}
import world.block_use.{water_bottle}
import world.level_writer.{UPDATE_LIMIT}
import world.menu.{count_of, same_components, with_count}
import worldgen.access.{BlockAccess}
import worldgen.facts.{DOWN, EAST, Facts, NORTH, SOUTH, UP, WEST, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}

/// `levelEvent`'s types: a dispenser's click as it dispenses, and its smoke out of its front.
pub const DISPENSER_DISPENSE: i32 = 1000
pub const DISPENSER_SMOKE: i32 = 2000
pub const DISPENSER_FAIL: i32 = 1001
pub const DISPENSER_LAUNCH: i32 = 1002

/// The items with a behavior of their own, `DispenseItemBehavior.bootStrap`'s, which Calcite
/// doesn't dispense yet.
fn own_behavior() -> List<str> {
    return ["firework_rocket", "fire_charge", "wind_charge", "armor_stand", "chest", "oak_boat", "spruce_boat", "birch_boat", "jungle_boat", "dark_oak_boat", "acacia_boat", "cherry_boat", "mangrove_boat", "poplar_boat", "pale_oak_boat", "bamboo_raft", "oak_chest_boat", "spruce_chest_boat", "birch_chest_boat", "jungle_chest_boat", "dark_oak_chest_boat", "acacia_chest_boat", "cherry_chest_boat", "mangrove_chest_boat", "poplar_chest_boat", "pale_oak_chest_boat", "bamboo_chest_raft", "lava_bucket", "water_bucket", "powder_snow_bucket", "salmon_bucket", "cod_bucket", "pufferfish_bucket", "tropical_fish_bucket", "axolotl_bucket", "sulfur_cube_bucket", "tadpole_bucket", "bucket", "flint_and_steel", "bone_meal", "wither_skeleton_skull", "carved_pumpkin", "shulker_box", "white_shulker_box", "orange_shulker_box", "magenta_shulker_box", "light_blue_shulker_box", "yellow_shulker_box", "lime_shulker_box", "pink_shulker_box", "gray_shulker_box", "light_gray_shulker_box", "cyan_shulker_box", "purple_shulker_box", "blue_shulker_box", "brown_shulker_box", "green_shulker_box", "red_shulker_box", "black_shulker_box", "shears", "brush", "honeycomb", "potion", "minecart", "chest_minecart", "furnace_minecart", "tnt_minecart", "hopper_minecart", "command_block_minecart"]
}

/// `dispenseFrom` of the dispenser or dropper, `dropper`, `state` at x, y, z: its loot to come
/// made, then a slot drawn from the level's random, `getRandomSlot`, each slot that holds
/// something replacing the one drawn so far at 1 in as many as there have been; none fails, with
/// its event. A dropper puts one of the slot's into the container in front, `addItem` through the
/// side facing it, or, with none there, dispenses it as a dispenser dispenses an item with no
/// behavior of its own. A dispenser dispenses the slot's by its item's behavior. What's left is
/// set in the slot, `setItem`, the comparators by it told.
pub fn dispense_from<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, dropper: bool) ! Thrown {
    try level.unpack_container_loot(f, x, y, z)
    var slots = items_at(level, x, y, z, 9)
    var slot: usize? = none
    var odds = 1
    for i in 0usize..9 {
        if count_of(slots[i].copy()) > 0 {
            if level.next_int_below(odds) == 0 {
                slot = some(i)
            }
            odds += 1
        }
    }
    let at = slot else {
        level.level_event(DISPENSER_FAIL, x, y, z, 0)
        return
    }
    let stack = slots[at].copy() ?? Tag.End
    let front = facing(f, state)
    var left: Tag? = none
    if dropper {
        let one = with_count(stack, 1) ?? stack.copy()
        let (there, rest) = try level.put_crafted(f, x + step_x(front), y + step_y(front), z + step_z(front), opposite(front), x, y, z, one)
        if there {
            left = if rest == none { with_count(stack, count_of(some(stack.copy())) - 1) } else { some(stack.copy()) }
        } else {
            left = dispense_default(mut level, x, y, z, front, stack)
        }
    } else {
        let id = item_id(stack)
        let (shot, power, uncertainty) = shot_of(id.copy())
        if shot {
            // `ProjectileDispenseBehavior`: its projectile from 0.7 in front of its middle and a
            // tenth up, shot along its facing; one used; the launch's event, and its smoke.
            let sx = f64(x) + 0.5 + f64(step_x(front)) * 0.7
            let sy = f64(y) + 0.5 + f64(step_y(front)) * 0.7 + 0.1
            let sz = f64(z) + 0.5 + f64(step_z(front)) * 0.7
            level.add_shot(stack.copy(), sx, sy, sz, step_x(front), step_y(front), step_z(front), power, uncertainty)
            level.level_event(DISPENSER_LAUNCH, x, y, z, 0)
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
        } else if id == "minecraft:tnt" {
            // TNT's, an `OptionalDispenseItemBehavior`: with the game rule `tnt_explodes` on,
            // primed in front, as `new PrimedTnt` makes it, with its sound, and one used; else it
            // fails. Calcite has no sulfur cubes to swallow it first. Its event, either way, and
            // its smoke.
            if level.prime_tnt(x + step_x(front), y + step_y(front), z + step_z(front), none, false) {
                level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
                left = with_count(stack, count_of(some(stack.copy())) - 1)
            } else {
                level.level_event(DISPENSER_FAIL, x, y, z, 0)
                left = some(stack.copy())
            }
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if id == "minecraft:glass_bottle" {
            left = try fill_bottle(f, mut level, x, y, z, front, stack, mut slots, at)
        } else if id == "minecraft:glowstone" {
            left = try charge_anchor(f, mut level, x, y, z, front, stack)
        } else if has_own_behavior(level, stack, id.copy(), x + step_x(front), y + step_y(front), z + step_z(front)) {
            fail Thrown { exception: "Unimplemented", message: "A dispenser dispensing {id}" }
        } else {
            left = dispense_default(mut level, x, y, z, front, stack)
        }
    }
    slots[at] = left
    var items = List<Tag>()
    for i in 0usize..9 {
        let s = slots[i].copy() else continue
        if count_of(some(s.copy())) <= 0 {
            continue
        }
        let Tag.Compound(m) = s else continue
        var entry = m.copy()
        entry.insert(String("Slot"), Tag.Byte(i8.wrap(i)))
        items.push(Tag.Compound(entry))
    }
    level.set_block_entity_value(x, y, z, "Items", Tag.List(items))
    level.touch_block_entity(x, y, z)
    try update_output_signal(f, mut level, f.block(state), x, y, z)
}

// The glass bottle's behavior, an `OptionalDispenseItemBehavior`, of `stack` by the dispenser at
// x, y, z facing `front`, its slots `slots`, `stack` in slot `at`: in front, a hive full of honey's
// is said missing; water filled into a water bottle, `takeLiquid`, `consumeWithRemainder`; else
// one thrown, as `DefaultDispenseItemBehavior` throws it, with a failure's event. Then its smoke.
fn fill_bottle<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, slots: mut List<Tag?>, at: usize) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let there = try level.state(f, tx, ty, tz)
    if f.is_a(f.block(there), String("BeehiveBlock")) and (f.get_int(there, "honey_level") ?? 0) >= 5 {
        fail Thrown { exception: "Unimplemented", message: "A dispenser filling a bottle from a hive" }
    }
    if not f.fluid_in(there, "minecraft:water") {
        let left = throw_one(mut level, x, y, z, front, stack)
        level.level_event(DISPENSER_FAIL, x, y, z, 0)
        level.level_event(DISPENSER_SMOKE, x, y, z, front)
        return left
    }
    let left = consume_with_remainder(mut level, x, y, z, front, stack, water_bottle(), mut slots, at)
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// The glowstone's behavior, an `OptionalDispenseItemBehavior`, of `stack` by the dispenser at x,
// y, z facing `front`: a respawn anchor in front with fewer than 4 charges charged, `charge`, its
// state one more set with flags 3 and its sound, and one used; one that's full fails; with none,
// one thrown, as `DefaultDispenseItemBehavior` throws it. Its event, then its smoke.
fn charge_anchor<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let there = try level.state(f, tx, ty, tz)
    var left: Tag? = some(stack.copy())
    var event = DISPENSER_DISPENSE
    if f.is_a(f.block(there), String("RespawnAnchorBlock")) {
        let charges = f.get_int(there, "charges") ?? 0
        if charges != 4 {
            _ = level.set_block_limited(tx, ty, tz, try f.with_int(there, String("charges"), charges + 1), 3, UPDATE_LIMIT)
            level.play_sound(tx, ty, tz, String("block.respawn_anchor.charge"), 1.0f32, 1.0f32)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
        } else {
            event = DISPENSER_FAIL
        }
    } else {
        left = throw_one(mut level, x, y, z, front, stack)
    }
    level.level_event(event, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `consumeWithRemainder` of `stack`, giving `remainder`, by the dispenser at x, y, z facing
// `front`, its slots `slots`, `stack` in slot `at`: one used; where that leaves none, `remainder`
// is what's left; else it's put into the dispenser, `insertItem`, into each slot that's empty or
// holds the same, as far as its most there goes, and what doesn't fit is thrown with its event and
// smoke, as `addToInventoryOrDispense` throws it.
fn consume_with_remainder<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, remainder: Tag, slots: mut List<Tag?>, at: usize) -> Tag? {
    let n = count_of(some(stack.copy())) - 1
    if n <= 0 {
        return some(remainder.copy())
    }
    let left = with_count(stack, n)
    slots[at] = left.copy()
    var rest = count_of(some(remainder.copy()))
    let most = match level.world_loot() {
        some(shared) => shared.value.items.max_stack_size(remainder),
        none => 64,
    }
    for i in 0..slots.len() {
        let had = slots[i].copy()
        let there = count_of(had.copy())
        let empty = there <= 0
        var same = false
        if let s = had {
            same = not empty and same_components(some(s.copy()), some(remainder.copy()))
        }
        if empty or same {
            let moved = if rest < most - there { rest } else { most - there }
            if moved > 0 {
                slots[i] = with_count(remainder, there + moved)
                rest -= moved
            }
            if rest <= 0 {
                break
            }
        }
    }
    if rest > 0 {
        let thrown = with_count(remainder, rest) ?? remainder.copy()
        _ = throw_one(mut level, x, y, z, front, thrown)
        level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
        level.level_event(DISPENSER_SMOKE, x, y, z, front)
    }
    return left
}

// `DefaultDispenseItemBehavior.dispense` of `stack` by the dispenser at x, y, z facing `front`:
// one of it thrown, `spawnItem` at accuracy 6, from 0.7 in front of its middle, lower by 0.125 up
// or down and 0.15625 across, as the level's random draws it; then its click and its smoke. What's
// left of `stack`.
fn dispense_default<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? {
    let left = throw_one(mut level, x, y, z, front, stack)
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `DefaultDispenseItemBehavior.execute` of `stack` by the dispenser at x, y, z facing `front`:
// one of it thrown, `spawnItem` at accuracy 6. What's left of `stack`.
fn throw_one<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? {
    let one = with_count(stack, 1) ?? stack.copy()
    let sx = f64(x) + 0.5 + f64(step_x(front)) * 0.7
    let sy = f64(y) + 0.5 + f64(step_y(front)) * 0.7 - (if front == DOWN or front == UP { 0.125 } else { 0.15625 })
    let sz = f64(z) + 0.5 + f64(step_z(front)) * 0.7
    let power = level.next_double() * 0.1 + 0.2
    let spread = 0.0172275 * 6.0
    let vx = level.triangle(f64(step_x(front)) * power, spread)
    let vy = level.triangle(0.2, spread)
    let vz = level.triangle(f64(step_z(front)) * power, spread)
    level.add_spilled(sx, sy, sz, one, vx, vy, vz)
    return with_count(stack, count_of(some(stack.copy())) - 1)
}

// Whether the item `id` is shot as a projectile Calcite has, `registerProjectileBehavior`, with
// its `DispenseConfig`'s power and uncertainty: 1.1 and 6, a thrown potion's and a bottle o'
// enchanting's 1.375 and 3.
fn shot_of(id: String) -> (bool, f32, f32) {
    for n in ["minecraft:arrow", "minecraft:tipped_arrow", "minecraft:spectral_arrow", "minecraft:egg", "minecraft:blue_egg", "minecraft:brown_egg", "minecraft:snowball"] {
        if id == n {
            return (true, 1.1f32, 6.0f32)
        }
    }
    if id == "minecraft:splash_potion" or id == "minecraft:lingering_potion" or id == "minecraft:experience_bottle" {
        return (true, 1.1f32 * 1.25f32, 6.0f32 * 0.5f32)
    }
    return (false, 0.0f32, 0.0f32)
}

// Whether `stack`, of the item `id`, has a behavior of its own that does more than throw it for a
// dispenser facing the block at x, y, z: one `bootStrap` registers, or, as `getDefaultDispenseMethod`
// gives it, equipment's, `equippable`, where something living is in that block, which it puts it on
// where it can; or a spawn egg's, with its entity's data. A sulfur cube's, for what it swallows,
// throws it, as Calcite has no sulfur cubes to swallow it.
fn has_own_behavior<L: BlockLevel + DropLevel>(level: L, stack: Tag, id: String, x: i32, y: i32, z: i32) -> bool {
    let name = id.trim_prefix("minecraft:")
    if name.len() < id.len() {
        for n in own_behavior() {
            if name == n {
                return true
            }
        }
    }
    let shared = level.world_loot() else return true
    if shared.value.items.component(stack, String("minecraft:equippable")) != none {
        return level.entities_touching(f64(x), f64(y), f64(z), f64(x + 1), f64(y + 1), f64(z + 1), true) > 0
    }
    return id.ends_with("_spawn_egg") and shared.value.items.component(stack, String("minecraft:entity_data")) != none
}

// The item of `stack`.
fn item_id(stack: Tag) -> String {
    let Tag.Compound(m) = stack else return String("minecraft:air")
    if not m.contains("id") {
        return String("minecraft:air")
    }
    return match m["id"] {
        Tag.Str(i) => i.copy(),
        _ => String("minecraft:air"),
    }
}

// The way the dispenser `state` faces, its `facing`.
fn facing(f: Facts, state: u32) -> i32 {
    let name = f.get_name(state, "facing") ?? String("north")
    if name == "down" {
        return DOWN
    }
    if name == "up" {
        return UP
    }
    if name == "south" {
        return SOUTH
    }
    if name == "west" {
        return WEST
    }
    if name == "east" {
        return EAST
    }
    return NORTH
}
