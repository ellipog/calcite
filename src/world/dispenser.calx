/// Dispensers and droppers dispensing, `DispenserBlock.dispenseFrom` and `DropperBlock`'s, with
/// `DefaultDispenseItemBehavior` (CAL-378). The items with a behavior of their own,
/// `DispenseItemBehavior.bootStrap`'s, that Calcite doesn't do yet, are said to be missing as
/// they're dispensed.
module world.dispenser

import nbt.tag.{Tag}
import random.source.{RandomSource}
import world.block_level.{BlockLevel, update_output_signal}
import world.containers.{items_at}
import world.copper.{waxed_state}
import world.digging.{durability_change, with_damage}
import world.golem_building.{can_spawn_golem, can_spawn_wither}
import world.hopper_reach.{shearables_in, wearers_in}
import world.attributes.{slot_names}
import world.collision.{Aabb}
import world.block_entity_ticks.{BEE_RELEASED, empty_hive}
import world.drops.{DropLevel, interaction_drops, pop_resource}
import math.mth.{wrap_degrees}
import world.attributes.{broken}
import world.boat.{is_boat_kind}
import world.minecart.{is_minecart_kind}
import world.rails.{is_rail, rail_shape}
import world.block_updates.{fire_state}
import world.block_use.{item_stack, water_bottle, water_potion}
import world.bucket.{Poured, empty_contents, pickup_block}
import world.body.{NEUTRAL_SOURCE}
import world.level_writer.{UPDATE_LIMIT}
import world.menu.{count_of, same_components, with_count}
import worldgen.access.{BlockAccess}
import world.block_facts.{place_sound_names, place_sound_pitches, place_sound_volumes, state_place_sounds}
import worldgen.facts.{DOWN, EAST, Facts, NORTH, SOUTH, UP, WATER_FLUID, WEST, direction_name, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.portal_shape.{find_any_shape}
import worldgen.survive.{Env, can_survive}

/// `levelEvent`'s types: a dispenser's click as it dispenses, and its smoke out of its front.
pub const DISPENSER_DISPENSE: i32 = 1000
pub const DISPENSER_SMOKE: i32 = 2000
pub const DISPENSER_FAIL: i32 = 1001
pub const DISPENSER_LAUNCH: i32 = 1002

/// The items with a behavior of their own, `DispenseItemBehavior.bootStrap`'s, which Calcite
/// doesn't dispense yet.
fn own_behavior() -> List<str> {
    return ["firework_rocket", "armor_stand", "oak_boat", "spruce_boat", "birch_boat", "jungle_boat", "dark_oak_boat", "acacia_boat", "cherry_boat", "mangrove_boat", "poplar_boat", "pale_oak_boat", "bamboo_raft", "oak_chest_boat", "spruce_chest_boat", "birch_chest_boat", "jungle_chest_boat", "dark_oak_chest_boat", "acacia_chest_boat", "cherry_chest_boat", "mangrove_chest_boat", "poplar_chest_boat", "pale_oak_chest_boat", "bamboo_chest_raft", "axolotl_bucket", "sulfur_cube_bucket", "tadpole_bucket", "wither_skeleton_skull", "shulker_box", "white_shulker_box", "orange_shulker_box", "magenta_shulker_box", "light_blue_shulker_box", "yellow_shulker_box", "lime_shulker_box", "pink_shulker_box", "gray_shulker_box", "light_gray_shulker_box", "cyan_shulker_box", "purple_shulker_box", "blue_shulker_box", "brown_shulker_box", "green_shulker_box", "red_shulker_box", "black_shulker_box", "shears", "minecart", "chest_minecart", "furnace_minecart", "tnt_minecart", "hopper_minecart", "command_block_minecart"]
}

/// `dispenseFrom` of the dispenser or dropper, `dropper`, `state` at x, y, z: its loot to come
/// made, then a slot drawn from the level's random, `getRandomSlot`, each slot that holds
/// something replacing the one drawn so far at 1 in as many as there have been; none fails, with
/// its event. A dropper puts one of the slot's into the container in front, `addItem` through the
/// side facing it, or, with none there, dispenses it as a dispenser dispenses an item with no
/// behavior of its own. A dispenser dispenses the slot's by its item's behavior. What's left is
/// set in the slot, `setItem`, the comparators by it told.
pub fn dispense_from<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, dropper: bool) ! Thrown {
    let Env { facts: f, .. } = e
    try level.unpack_container_loot(f, x, y, z)
    var slots = items_at(level, x, y, z, 9)
    var slot: usize? = none
    var odds = 1
    for i in 0usize..9 {
        if count_of(slots[i].copy()) > 0 {
            if level.next_int_below(odds) == 0 {
                slot = some(i)
            }
            odds += 1
        }
    }
    let at = slot else {
        level.level_event(DISPENSER_FAIL, x, y, z, 0)
        return
    }
    let stack = slots[at].copy() ?? Tag.End
    let front = facing(f, state)
    var left: Tag? = none
    if dropper {
        let one = with_count(stack, 1) ?? stack.copy()
        let (there, rest) = try level.put_crafted(f, x + step_x(front), y + step_y(front), z + step_z(front), opposite(front), x, y, z, one)
        if there {
            left = if rest == none { with_count(stack, count_of(some(stack.copy())) - 1) } else { some(stack.copy()) }
        } else {
            left = dispense_default(mut level, x, y, z, front, stack)
        }
    } else {
        let id = item_id(stack)
        let (shot, power, uncertainty) = shot_of(id.copy())
        if id == "minecraft:fire_charge" or id == "minecraft:wind_charge" {
            // `FireChargeItem`'s and `WindChargeItem`'s `ProjectileDispenseBehavior`: the way it
            // goes, each of its facing's steps drawn about, a triangle of 0.11485, `asProjectile`;
            // a small fireball that way, holding one of it, or a wind charge, from a whole block in
            // front of the middle, shot along the facing at 1, 6.6666665 off; one used; event 1018
            // or 1051, and the smoke.
            let ax = level.triangle(f64(step_x(front)), 0.11485000000000001)
            let ay = level.triangle(f64(step_y(front)), 0.11485000000000001)
            let az = level.triangle(f64(step_z(front)), 0.11485000000000001)
            let sx = f64(x) + 0.5 + f64(step_x(front))
            let sy = f64(y) + 0.5 + f64(step_y(front))
            let sz = f64(z) + 0.5 + f64(step_z(front))
            level.add_aimed_shot(stack.copy(), sx, sy, sz, step_x(front), step_y(front), step_z(front), 1.0f32, 6.6666665f32, (ax, ay, az))
            level.level_event(if id == "minecraft:fire_charge" { 1018 } else { 1051 }, x, y, z, 0)
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
        } else if shot {
            // `ProjectileDispenseBehavior`: its projectile from 0.7 in front of its middle and a
            // tenth up, shot along its facing; one used; the launch's event, and its smoke.
            let sx = f64(x) + 0.5 + f64(step_x(front)) * 0.7
            let sy = f64(y) + 0.5 + (f64(step_y(front)) * 0.7 + 0.1)
            let sz = f64(z) + 0.5 + f64(step_z(front)) * 0.7
            level.add_shot(stack.copy(), sx, sy, sz, step_x(front), step_y(front), step_z(front), power, uncertainty)
            level.level_event(DISPENSER_LAUNCH, x, y, z, 0)
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
        } else if id == "minecraft:tnt" {
            // TNT's, an `OptionalDispenseItemBehavior`: with the game rule `tnt_explodes` on,
            // primed in front, as `new PrimedTnt` makes it, with its sound, and one used; else it
            // fails. Calcite has no sulfur cubes to swallow it first. Its event, either way, and
            // its smoke.
            if level.prime_tnt(x + step_x(front), y + step_y(front), z + step_z(front), none, false) {
                level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
                left = with_count(stack, count_of(some(stack.copy())) - 1)
            } else {
                level.level_event(DISPENSER_FAIL, x, y, z, 0)
                left = some(stack.copy())
            }
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if id == "minecraft:glass_bottle" {
            left = try fill_bottle(f, mut level, x, y, z, front, stack, mut slots, at)
        } else if id == "minecraft:water_bucket" or id == "minecraft:lava_bucket" {
            left = try empty_bucket(e, mut level, x, y, z, front, stack, id == "minecraft:lava_bucket", mut slots, at)
        } else if let fish = bucket_fish(id.copy()) {
            left = try empty_fish_bucket(e, mut level, x, y, z, front, stack, fish, mut slots, at)
        } else if id == "minecraft:powder_snow_bucket" {
            left = try empty_powder_snow(f, mut level, x, y, z, front, stack, mut slots, at)
        } else if id == "minecraft:bucket" {
            left = try fill_bucket(e, mut level, x, y, z, front, stack, mut slots, at)
        } else if id == "minecraft:carved_pumpkin" {
            // Its behavior, an `OptionalDispenseItemBehavior`: in front, in air where a golem's
            // base is found, `canSpawnGolem`, a carved pumpkin, flags 3, which builds it, and one
            // used; else equipment's, `dispenseEquipment`, which, with nothing living there to
            // wear it, fails. Its click or its failure's, and its smoke.
            let tx = x + step_x(front)
            let ty = y + step_y(front)
            let tz = z + step_z(front)
            if f.is_air(try level.state(f, tx, ty, tz)) and try can_spawn_golem(f, level, tx, ty, tz) {
                let pumpkin = try f.named_block(String("carved_pumpkin"))
                _ = level.set_block_limited(tx, ty, tz, f.default_state(pumpkin), 3, UPDATE_LIMIT)
                left = with_count(stack, count_of(some(stack.copy())) - 1)
                level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            } else if equip_in_front(mut level, tx, ty, tz, stack) {
                left = with_count(stack, count_of(some(stack.copy())) - 1)
                level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            } else {
                left = some(stack.copy())
                level.level_event(DISPENSER_FAIL, x, y, z, 0)
            }
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if id == "minecraft:bone_meal" {
            // Its behavior, an `OptionalDispenseItemBehavior`: the block in front grown,
            // `growCrop`, one used, with its particles there, level event 1505 with 15; else it
            // fails, water in front, `growWaterPlant`, said to be missing. Its click or its
            // failure's, and its smoke.
            let tx = x + step_x(front)
            let ty = y + step_y(front)
            let tz = z + step_z(front)
            if try level.bone_meal(e, tx, ty, tz) {
                left = with_count(stack, count_of(some(stack.copy())) - 1)
                level.level_event(1505, tx, ty, tz, 15)
                level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            } else {
                let there = try level.state(f, tx, ty, tz)
                if f.block(there) == f.ids.water and f.fluid(there) == WATER_FLUID {
                    fail Thrown { exception: "Unimplemented", message: "Bone meal growing seagrass and coral in water, growWaterPlant" }
                }
                left = some(stack.copy())
                level.level_event(DISPENSER_FAIL, x, y, z, 0)
            }
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if id == "minecraft:honeycomb" {
            // Its behavior, an `OptionalDispenseItemBehavior`: copper in front waxed, flags 3,
            // `getWaxed`, with level event 3003 and `item.honeycomb.wax_on` from the block's
            // middle, and one used; else one thrown. Its click, and its smoke.
            let tx = x + step_x(front)
            let ty = y + step_y(front)
            let tz = z + step_z(front)
            if let waxed = waxed_state(f, try level.state(f, tx, ty, tz)) {
                _ = level.set_block_limited(tx, ty, tz, waxed, 3, UPDATE_LIMIT)
                level.level_event(3003, tx, ty, tz, 0)
                level.play_sound_at(f64(tx) + 0.5, f64(ty) + 0.5, f64(tz) + 0.5, String("item.honeycomb.wax_on"), 1.0f32, 1.0f32)
                left = with_count(stack, count_of(some(stack.copy())) - 1)
            } else {
                left = throw_one(mut level, x, y, z, front, stack)
            }
            level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if id == "minecraft:potion" {
            left = try pour_water(f, mut level, x, y, z, front, stack, mut slots, at)
        } else if id == "minecraft:wither_skeleton_skull" {
            // Its behavior, an `OptionalDispenseItemBehavior`: in air in front where the wither's
            // base is found, `canSpawnMob`, a skull set, which Calcite can't build a wither of yet,
            // and says so; else equipment's, `dispenseEquipment`, which, with nothing living
            // there to wear it, fails. Its failure's click, and its smoke.
            let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
            if f.is_air(try level.state(f, tx, ty, tz)) and try can_spawn_wither(f, level, tx, ty, tz, level.min_y()) {
                fail Thrown { exception: "Unimplemented", message: "A dispenser setting a wither skeleton skull on a wither's base" }
            }
            if equip_in_front(mut level, tx, ty, tz, stack) {
                left = with_count(stack, count_of(some(stack.copy())) - 1)
                level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            } else {
                left = some(stack.copy())
                level.level_event(DISPENSER_FAIL, x, y, z, 0)
            }
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if id.ends_with("shulker_box") and f.block_named(id.copy()) != none {
            left = try place_shulker_box(f, mut level, x, y, z, front, stack, id.copy())
        } else if id == "minecraft:chest" {
            left = chest_onto(mut level, x, y, z, front, stack)
        } else if id == "minecraft:brush" {
            left = brush(mut level, x, y, z, front, stack)
        } else if id == "minecraft:shears" {
            left = try shear(f, mut level, x, y, z, front, stack)
        } else if id == "minecraft:flint_and_steel" {
            left = try strike(e, mut level, x, y, z, front, stack)
        } else if id == "minecraft:glowstone" {
            left = try charge_anchor(f, mut level, x, y, z, front, stack)
        } else if id == "minecraft:armor_stand" {
            // Its behavior, a `DefaultDispenseItemBehavior`: an armor stand at the bottom middle of
            // the block in front, `EntityType.spawn`, turned as the level draws, then the
            // facing's way, named as the stack is, and one used. Its click and smoke.
            let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
            let snapped = wrap_degrees(level.next_float() * 360.0f32)
            level.add_vehicle(id.copy(), with_count(stack, 1) ?? stack.copy(), f64(tx) + 0.5, f64(ty), f64(tz) + 0.5, y_rot_of(front), snapped)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
            level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if is_boat_kind(id.copy()) {
            left = try dispense_boat(f, mut level, x, y, z, front, stack, id.copy())
        } else if is_minecart_kind(id.copy()) {
            left = try dispense_cart(f, mut level, x, y, z, front, stack, id.copy())
        } else if not own_named(id.copy()) and equippable(level, stack) {
            // `EquipmentDispenseItemBehavior`, what has an equippable and no behavior of its own
            // gets: put on the first living entity in front that may wear it, `dispenseEquipment`,
            // one used, its click and smoke; else thrown, as `DefaultDispenseItemBehavior` throws it.
            let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
            if equip_in_front(mut level, tx, ty, tz, stack) {
                left = with_count(stack, count_of(some(stack.copy())) - 1)
                level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
                level.level_event(DISPENSER_SMOKE, x, y, z, front)
            } else {
                left = dispense_default(mut level, x, y, z, front, stack)
            }
        } else if let kind = egg_kind(level, stack, id.copy()) {
            // `SpawnEggItemBehavior`: its mob spawned in front, `EntityType.spawn`, moved down
            // unless the dispenser faces up, one used; its click and smoke. In peaceful, where
            // its mob may not spawn, that's said to be missing.
            if level.difficulty() == 0 {
                fail Thrown { exception: "Unimplemented", message: "A dispenser's spawn egg in peaceful" }
            }
            let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
            level.add_egg(kind, stack.copy(), tx, ty, tz, front != UP)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
            level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
        } else if own_named(id.copy()) {
            fail Thrown { exception: "Unimplemented", message: "A dispenser dispensing {id}" }
        } else {
            left = dispense_default(mut level, x, y, z, front, stack)
        }
    }
    slots[at] = left
    var items = List<Tag>()
    for i in 0usize..9 {
        let s = slots[i].copy() else continue
        if count_of(some(s.copy())) <= 0 {
            continue
        }
        let Tag.Compound(m) = s else continue
        var entry = m.copy()
        entry.insert(String("Slot"), Tag.Byte(i8.wrap(i)))
        items.push(Tag.Compound(entry))
    }
    level.set_block_entity_value(x, y, z, "Items", Tag.List(items))
    level.touch_block_entity(x, y, z)
    try update_output_signal(f, mut level, f.block(state), x, y, z)
}

// A bucket of water's or lava's behavior, a `DefaultDispenseItemBehavior`, of `stack` by the
// dispenser at x, y, z facing `front`, its slots `slots`, `stack` in slot `at`: emptied in front
// by no one, `emptyContents`, its empty sound heard from the block's middle by all, the bucket
// left, `consumeWithRemainder`; else thrown as `DefaultDispenseItemBehavior.dispense` throws it,
// with its click and smoke. Then its click and smoke.
fn empty_bucket<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, lava: bool, slots: mut List<Tag?>, at: usize) -> Tag? ! Thrown {
    let tx = x + step_x(front)
    let ty = y + step_y(front)
    let tz = z + step_z(front)
    var left: Tag? = none
    match try empty_contents(e, mut level, lava, -1, false, false, tx, ty, tz, none) {
        Poured.No => {
            left = dispense_default(mut level, x, y, z, front, stack)
        },
        Poured.At((sx, sy, sz)) => {
            let sound = if lava { "item.bucket.empty_lava" } else { "item.bucket.empty" }
            level.play_sound_at(f64(sx) + 0.5, f64(sy) + 0.5, f64(sz) + 0.5, String(sound), 1.0f32, 1.0f32)
            left = consume_with_remainder(mut level, x, y, z, front, stack, item_stack(String("minecraft:bucket")), mut slots, at)
        },
        Poured.Hissed => {
            left = consume_with_remainder(mut level, x, y, z, front, stack, item_stack(String("minecraft:bucket")), mut slots, at)
        },
    }
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// The fish a fish bucket `id` holds, `MobBucketItem`'s type; none for any other, an axolotl's and
// a tadpole's among them, which Calcite doesn't have.
fn bucket_fish(id: String) -> String? {
    if id == "minecraft:cod_bucket" or id == "minecraft:salmon_bucket" or id == "minecraft:pufferfish_bucket" or id == "minecraft:tropical_fish_bucket" {
        return some(id[10..id.len() - 7].copy())
    }
    return none
}

// A fish bucket's behavior, `filledBucketBehavior`, of `stack` by the dispenser at x, y, z facing
// `front`, its slots `slots`, `stack` in slot `at`, of the fish `fish`: its water emptied in front
// by no one, `emptyContents`, its empty sound, `item.bucket.empty_fish`, heard from the block's
// middle among the neutral sounds, `MobBucketItem.playEmptySound`, its fish let out there,
// `checkExtraContent`, and the bucket left, `consumeWithRemainder`; else thrown as
// `DefaultDispenseItemBehavior.dispense` throws it. Then its click and smoke.
fn empty_fish_bucket<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, fish: String, slots: mut List<Tag?>, at: usize) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    var left: Tag? = none
    match try empty_contents(e, mut level, false, -1, false, false, tx, ty, tz, none) {
        Poured.No => {
            left = dispense_default(mut level, x, y, z, front, stack)
        },
        Poured.At((sx, sy, sz)) => {
            level.play_sound_in(f64(sx) + 0.5, f64(sy) + 0.5, f64(sz) + 0.5, String("item.bucket.empty_fish"), NEUTRAL_SOURCE, 1.0f32, 1.0f32)
            level.add_bucketed("minecraft:{fish}", stack.copy(), tx, ty, tz)
            left = consume_with_remainder(mut level, x, y, z, front, stack, item_stack(String("minecraft:bucket")), mut slots, at)
        },
        Poured.Hissed => {
            level.add_bucketed("minecraft:{fish}", stack.copy(), tx, ty, tz)
            left = consume_with_remainder(mut level, x, y, z, front, stack, item_stack(String("minecraft:bucket")), mut slots, at)
        },
    }
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `filledBucketBehavior` of a powder snow bucket, `stack`, by the dispenser at x, y, z facing
// `front`: `SolidBucketItem.emptyContents`, powder snow set in front where it's air in the world,
// flags 3, with its sound from the block's middle, and the bucket left; else it's dispensed as an
// item with no behavior. Its click and its smoke.
fn empty_powder_snow<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, slots: mut List<Tag?>, at: usize) -> Tag? ! Thrown {
    let tx = x + step_x(front)
    let ty = y + step_y(front)
    let tz = z + step_z(front)
    var left: Tag? = none
    let block = f.block_named(String("minecraft:powder_snow")) else panic("no powder snow block")
    let snow = f.default_state(block)
    if f.is_air(try level.state(f, tx, ty, tz)) and level.set_block_limited(tx, ty, tz, snow, 3, UPDATE_LIMIT) {
        level.play_sound_at(f64(tx) + 0.5, f64(ty) + 0.5, f64(tz) + 0.5, String("item.bucket.empty_powder_snow"), 1.0f32, 1.0f32)
        left = consume_with_remainder(mut level, x, y, z, front, stack, item_stack(String("minecraft:bucket")), mut slots, at)
    } else {
        left = dispense_default(mut level, x, y, z, front, stack)
    }
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `FlintAndSteelDispenseItemBehavior`, an `OptionalDispenseItemBehavior`, of `stack` by the
// dispenser at x, y, z facing `front`. In front, as Calcite has no sulfur cubes to light first:
// in air, where fire, `BaseFireBlock.getState`, can stay or would light a portal, `isPortal`,
// fire, flags 3; a campfire, candle or candle cake that can be lit, lit, flags 3; TNT primed,
// unless the game rule `tnt_explodes` is off, which fails, and gone, flags 3. Where it didn't fail
// it's worn by 1, `hurtAndBreak` by no one, gone where that breaks it. Its click or its failure's,
// and its smoke.
fn strike<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? ! Thrown {
    let Env { facts: f, .. } = e
    let tx = x + step_x(front)
    let ty = y + step_y(front)
    let tz = z + step_z(front)
    let target = try level.state(f, tx, ty, tz)
    var success = true
    let fire = try fire_state(f, level, tx, ty, tz)
    if f.is_air(target) and (try can_survive(e, level, fire, tx, ty, tz) or try is_portal(e, mut level, tx, ty, tz, front)) {
        _ = level.set_block_limited(tx, ty, tz, fire, 3, UPDATE_LIMIT)
    } else if lights(f, target) {
        _ = level.set_block_limited(tx, ty, tz, try f.with_bool(target, String("lit"), true), 3, UPDATE_LIMIT)
    } else if f.is_a(f.block(target), String("TntBlock")) {
        if level.prime_tnt(tx, ty, tz, none, false) {
            _ = level.set_block_limited(tx, ty, tz, f.ids.air_state, 3, UPDATE_LIMIT)
        } else {
            success = false
        }
    }
    let left = if success { worn(mut level, stack) } else { some(stack.copy()) }
    level.level_event(if success { DISPENSER_DISPENSE } else { DISPENSER_FAIL }, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `stack` worn by 1, `hurtAndBreak` with no one using it: what's left of it, none where it broke.
fn worn<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, stack: Tag) -> Tag? {
    return worn_by(mut level, stack, 1)
}

// The chest's behavior, an `OptionalDispenseItemBehavior`, of `stack` by the dispenser at x, y, z
// facing `front` (CAL-378): of the donkeys and llamas in the block in front, in the level's order,
// alive and without one, the first tamed given it, its slot 499 set, `getSlot(499).set`, and one
// used; else thrown, as `DefaultDispenseItemBehavior.execute` throws it. Its click, as it's never
// failed, and its smoke.
fn chest_onto<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let ts = level.shearables()
    let block = Aabb { min_x: f64(tx), min_y: f64(ty), min_z: f64(tz), max_x: f64(tx + 1), max_y: f64(ty + 1), max_z: f64(tz + 1) }
    for at in shearables_in(ts, block) {
        if ts[at].chestable {
            level.add_chest(ts[at].id)
            let left = with_count(stack, count_of(some(stack.copy())) - 1)
            level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
            level.level_event(DISPENSER_SMOKE, x, y, z, front)
            return left
        }
    }
    return dispense_default(mut level, x, y, z, front, stack)
}

// The brush's behavior, an `OptionalDispenseItemBehavior`, of `stack` by the dispenser at x, y, z
// facing `front` (CAL-378): of the armadillos in the block in front, in the level's order, the
// first a scute's brushed off, grown, `brushOffScute`, and the brush worn by 16; else it fails.
// Its click or its failure's, and its smoke.
fn brush<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let ts = level.shearables()
    let block = Aabb { min_x: f64(tx), min_y: f64(ty), min_z: f64(tz), max_x: f64(tx + 1), max_y: f64(ty + 1), max_z: f64(tz + 1) }
    var success = false
    for at in shearables_in(ts, block) {
        if ts[at].brushable {
            level.add_brush(ts[at].id)
            success = true
            break
        }
    }
    let left = if success { worn_by(mut level, stack, 16) } else { some(stack.copy()) }
    level.level_event(if success { DISPENSER_DISPENSE } else { DISPENSER_FAIL }, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `stack` worn by `amount`, `hurtAndBreak` with no one using it: what's left of it, none where it
// broke.
fn worn_by<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, stack: Tag, amount: i32) -> Tag? {
    let shared = level.world_loot() else return some(stack.copy())
    let change = durability_change(stack, amount, shared.value.items, false, mut level)
    if change == 0 {
        return some(stack.copy())
    }
    let now = match shared.value.items.component(stack, String("minecraft:damage")) {
        some(t) => t.number_int() ?? 0,
        none => 0,
    }
    let damaged = with_damage(stack, now + change, shared.value.items)
    return if broken(damaged, shared.value.items) { with_count(damaged, count_of(some(damaged.copy())) - 1) } else { some(damaged) }
}

// `ShulkerBoxDispenseBehavior` of the shulker box `stack`, of the block `id`, by the dispenser at
// x, y, z facing `front` (CAL-378): placed in front, `BlockItem.place` with a
// `DirectionalPlaceContext`, where what's there can be replaced, facing the dispenser's way, or up
// where the block under it isn't air, set with flags 11, heard placed by all from its middle, its
// sound type's place sound at half again its volume and 0.8 its pitch, and one used. What's in
// front stopping it, and a stack with components to give its block entity, are said to be
// missing. Its click or its failure's, and its smoke.
fn place_shulker_box<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, id: String) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let block = try f.named_block(id.trim_prefix("minecraft:"))
    let clicked = if f.is_air(try level.state(f, tx, ty - 1, tz)) { front } else { UP }
    var left: Tag? = some(stack.copy())
    var success = false
    if f.replaceable(try level.state(f, tx, ty, tz)) {
        if level.entities_touching(f64(tx), f64(ty), f64(tz), f64(tx + 1), f64(ty + 1), f64(tz + 1), true) > 0 {
            fail Thrown { exception: "Unimplemented", message: "Whether what's in front stops a dispenser's shulker box, isUnobstructed" }
        }
        if let Tag.Compound(m) = stack {
            if m.contains("components") {
                fail Thrown { exception: "Unimplemented", message: "A dispensed shulker box's block entity from its item's components" }
            }
        }
        let state = try f.with_name(f.default_state(block), "facing", direction_name(clicked))
        if level.set_block_limited(tx, ty, tz, state, 11, UPDATE_LIMIT) {
            let placed = try level.state(f, tx, ty, tz)
            let i = usize(state_place_sounds()[usize(placed)])
            let sound = String(place_sound_names()[i])
            level.play_sound_at(f64(tx) + 0.5, f64(ty) + 0.5, f64(tz) + 0.5, sound, (place_sound_volumes()[i] + 1.0f32) / 2.0f32, place_sound_pitches()[i] * 0.8f32)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
            success = true
        }
    }
    level.level_event(if success { DISPENSER_DISPENSE } else { DISPENSER_FAIL }, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `ShearsDispenseItemBehavior` of the shears `stack` by the dispenser at x, y, z facing `front`
// (CAL-378): a beehive in front with 5 honey, `tryShearBeehive`, sheared: `beehive.shear` from
// its middle, its honeycomb dropped, `dropHoneycomb`, `harvest/beehive` rolled and each stack
// popped, its honey reset, flags 3, and its bees let out by no one, `BEE_RELEASED`; and the
// shears worn by 1. Else what's in front sheared or cut loose, `tryShearEntity`, the shears
// worn by 1 where it was; else it fails. Its click or its failure's, and its smoke.
fn shear<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let target = try level.state(f, tx, ty, tz)
    let hive = f.in_set(target, f.tag("minecraft:beehives")) and f.is_a(f.block(target), "BeehiveBlock")
    var success = false
    if hive and (f.get_int(target, "honey_level") ?? 0) >= 5 {
        level.play_sound_at(f64(tx) + 0.5, f64(ty) + 0.5, f64(tz) + 0.5, String("block.beehive.shear"), 1.0f32, 1.0f32)
        for dropped in interaction_drops(f, mut level, String("minecraft:harvest/beehive"), target, tx, ty, tz, stack.copy()) {
            pop_resource(mut level, tx, ty, tz, dropped.copy())
        }
        let tags = level.block_entity_tag(tx, ty, tz)
        _ = level.set_block_limited(tx, ty, tz, try f.with_int(target, String("honey_level"), 0), 3, UPDATE_LIMIT)
        if let Tag.Compound(m) = tags ?? Tag.End {
            try empty_hive(f, mut level, target, tx, ty, tz, m.copy(), none, BEE_RELEASED)
        }
        success = true
    } else {
        // `tryShearEntity`: the first entity in the block in front, in the level's order, with
        // leash links, which are cut, `shearOffAllLeashConnections`, or alive and ready to be
        // sheared, `readyForShearing`, sheared, `shear`, from the blocks' source.
        let ts = level.shearables()
        let block = Aabb { min_x: f64(tx), min_y: f64(ty), min_z: f64(tz), max_x: f64(tx + 1), max_y: f64(ty + 1), max_z: f64(tz + 1) }
        for at in shearables_in(ts, block) {
            if ts[at].leashes {
                level.add_cut(ts[at].id)
                success = true
                break
            }
            if ts[at].ready {
                level.add_shear(ts[at].id, stack.copy())
                success = true
                break
            }
        }
    }
    let left = if success { worn(mut level, stack) } else { some(stack.copy()) }
    level.level_event(if success { DISPENSER_DISPENSE } else { DISPENSER_FAIL }, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `BaseFireBlock.isPortal` at x, y, z for a dispenser facing `front`: in the Overworld or the
// Nether, by a portal's frame, obsidian, an empty frame's shape, along the axis across `front`, or
// for one up or down one drawn, then the other.
fn is_portal<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, front: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if not level.portals_light() {
        return false
    }
    let obsidian = f.block_named(String("minecraft:obsidian")) ?? 4294967295
    for d in [DOWN, UP, NORTH, SOUTH, WEST, EAST] {
        if f.block(try level.state(f, x + step_x(d), y + step_y(d), z + step_z(d))) == obsidian {
            // `getCounterClockWise().getAxis()`: across a north or south facing, x.
            let along_x = if front == NORTH or front == SOUTH { true } else if front == EAST or front == WEST { false } else { level.next_int_below(2) == 0 }
            let first = try find_any_shape(e, level, x, y, z, along_x)
            if first.is_valid() and first.portal_blocks == 0 {
                return true
            }
            let other = try find_any_shape(e, level, x, y, z, not along_x)
            return other.is_valid() and other.portal_blocks == 0
        }
    }
    return false
}

// `CampfireBlock.canLight`, `CandleBlock.canLight` or `CandleCakeBlock.canLight` of `state`: a
// campfire or candle not lit nor waterlogged, or a candle cake not lit.
fn lights(f: Facts, state: u32) -> bool {
    let lit = f.get_name(state, String("lit")) else return false
    if lit != "false" {
        return false
    }
    if f.in_set(state, f.tag(String("minecraft:candle_cakes"))) {
        return true
    }
    if not f.in_set(state, f.tag(String("minecraft:campfires"))) and not f.in_set(state, f.tag(String("minecraft:candles"))) {
        return false
    }
    return (f.get_name(state, String("waterlogged")) ?? String()) == "false"
}

// A potion's behavior, a `DefaultDispenseItemBehavior`, of `stack` by the dispenser at x, y, z
// facing `front`, its slots `slots`, `stack` in slot `at`: water poured on a block in front that
// turns to mud, `convertible_to_mud`, 5 splashes over the dispenser, `item.bottle.empty` from its
// middle, the block mud, flags 3, and the bottle left, `consumeWithRemainder`; else, or for another
// potion, thrown as `DefaultDispenseItemBehavior.dispense` throws it, with its click and smoke.
// Then its click and smoke.
fn pour_water<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, slots: mut List<Tag?>, at: usize) -> Tag? ! Thrown {
    let tx = x + step_x(front)
    let ty = y + step_y(front)
    let tz = z + step_z(front)
    var left: Tag? = none
    if water_potion(some(stack.copy())) and f.in_set(try level.state(f, tx, ty, tz), f.tag(String("minecraft:convertible_to_mud"))) {
        for _ in 0..5 {
            let px = f64(x) + level.next_double()
            let pz = f64(z) + level.next_double()
            level.send_particles("minecraft:splash", px, f64(y + 1), pz, 1, 0.0, 0.0, 0.0, 1.0)
        }
        level.play_sound_at(f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, String("item.bottle.empty"), 1.0f32, 1.0f32)
        let mud = try f.named_block(String("mud"))
        _ = level.set_block_limited(tx, ty, tz, f.default_state(mud), 3, UPDATE_LIMIT)
        left = consume_with_remainder(mut level, x, y, z, front, stack, item_stack(String("minecraft:glass_bottle")), mut slots, at)
    } else {
        left = dispense_default(mut level, x, y, z, front, stack)
    }
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// The empty bucket's behavior, a `DefaultDispenseItemBehavior`, of `stack` by the dispenser at
// x, y, z facing `front`, its slots `slots`, `stack` in slot `at`: what's in front taken up by no
// one, `pickupBlock`, the bucket of it left, `consumeWithRemainder`; else one thrown. Then its
// click and smoke.
fn fill_bucket<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, slots: mut List<Tag?>, at: usize) -> Tag? ! Thrown {
    var left: Tag? = none
    if let taken = try pickup_block(e, mut level, x + step_x(front), y + step_y(front), z + step_z(front), false) {
        left = consume_with_remainder(mut level, x, y, z, front, stack, item_stack(taken.item.copy()), mut slots, at)
    } else {
        left = throw_one(mut level, x, y, z, front, stack)
    }
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// The glass bottle's behavior, an `OptionalDispenseItemBehavior`, of `stack` by the dispenser at
// x, y, z facing `front`, its slots `slots`, `stack` in slot `at`: in front, a hive full of honey's
// is said missing; water filled into a water bottle, `takeLiquid`, `consumeWithRemainder`; else
// one thrown, as `DefaultDispenseItemBehavior` throws it, with a failure's event. Then its smoke.
fn fill_bottle<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, slots: mut List<Tag?>, at: usize) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let there = try level.state(f, tx, ty, tz)
    if f.is_a(f.block(there), String("BeehiveBlock")) and (f.get_int(there, "honey_level") ?? 0) >= 5 {
        fail Thrown { exception: "Unimplemented", message: "A dispenser filling a bottle from a hive" }
    }
    if not f.fluid_in(there, "minecraft:water") {
        let left = throw_one(mut level, x, y, z, front, stack)
        level.level_event(DISPENSER_FAIL, x, y, z, 0)
        level.level_event(DISPENSER_SMOKE, x, y, z, front)
        return left
    }
    let left = consume_with_remainder(mut level, x, y, z, front, stack, water_bottle(), mut slots, at)
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// The glowstone's behavior, an `OptionalDispenseItemBehavior`, of `stack` by the dispenser at x,
// y, z facing `front`: a respawn anchor in front with fewer than 4 charges charged, `charge`, its
// state one more set with flags 3 and its sound, and one used; one that's full fails; with none,
// one thrown, as `DefaultDispenseItemBehavior` throws it. Its event, then its smoke.
fn charge_anchor<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let there = try level.state(f, tx, ty, tz)
    var left: Tag? = some(stack.copy())
    var event = DISPENSER_DISPENSE
    if f.is_a(f.block(there), String("RespawnAnchorBlock")) {
        let charges = f.get_int(there, "charges") ?? 0
        if charges != 4 {
            _ = level.set_block_limited(tx, ty, tz, try f.with_int(there, String("charges"), charges + 1), 3, UPDATE_LIMIT)
            level.play_sound(tx, ty, tz, String("block.respawn_anchor.charge"), 1.0f32, 1.0f32)
            left = with_count(stack, count_of(some(stack.copy())) - 1)
        } else {
            event = DISPENSER_FAIL
        }
    } else {
        left = throw_one(mut level, x, y, z, front, stack)
    }
    level.level_event(event, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `consumeWithRemainder` of `stack`, giving `remainder`, by the dispenser at x, y, z facing
// `front`, its slots `slots`, `stack` in slot `at`: one used; where that leaves none, `remainder`
// is what's left; else it's put into the dispenser, `insertItem`, into each slot that's empty or
// holds the same, as far as its most there goes, and what doesn't fit is thrown with its event and
// smoke, as `addToInventoryOrDispense` throws it.
fn consume_with_remainder<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, remainder: Tag, slots: mut List<Tag?>, at: usize) -> Tag? {
    let n = count_of(some(stack.copy())) - 1
    if n <= 0 {
        return some(remainder.copy())
    }
    let left = with_count(stack, n)
    slots[at] = left.copy()
    var rest = count_of(some(remainder.copy()))
    let most = match level.world_loot() {
        some(shared) => shared.value.items.max_stack_size(remainder),
        none => 64,
    }
    for i in 0..slots.len() {
        let had = slots[i].copy()
        let there = count_of(had.copy())
        let empty = there <= 0
        var same = false
        if let s = had {
            same = not empty and same_components(some(s.copy()), some(remainder.copy()))
        }
        if empty or same {
            let moved = if rest < most - there { rest } else { most - there }
            if moved > 0 {
                slots[i] = with_count(remainder, there + moved)
                rest -= moved
            }
            if rest <= 0 {
                break
            }
        }
    }
    if rest > 0 {
        let thrown = with_count(remainder, rest) ?? remainder.copy()
        _ = throw_one(mut level, x, y, z, front, thrown)
        level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
        level.level_event(DISPENSER_SMOKE, x, y, z, front)
    }
    return left
}

// `DefaultDispenseItemBehavior.dispense` of `stack` by the dispenser at x, y, z facing `front`:
// one of it thrown, `spawnItem` at accuracy 6, from 0.7 in front of its middle, lower by 0.125 up
// or down and 0.15625 across, as the level's random draws it; then its click and its smoke. What's
// left of `stack`.
fn dispense_default<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? {
    let left = throw_one(mut level, x, y, z, front, stack)
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `BoatDispenseItemBehavior` of `stack`, of the boat `kind`, by the dispenser at x, y, z facing
// `front` (CAL-378): with water in front, a boat 1.25 out from the middle along the facing, its
// width's half and 0.5625, and 1.125 along it up or down, a block higher; with air in front and
// water under that, there; turned the facing's way, `toYRot`, and one used. Else one thrown as
// `DefaultDispenseItemBehavior.dispense` throws it, with its click and smoke. Then its click and
// smoke.
fn dispense_boat<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, kind: String) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    var lift = 0.0
    var left: Tag? = none
    var thrown = false
    if f.is_water(try level.state(f, tx, ty, tz)) {
        lift = 1.0
    } else if not f.is_air(try level.state(f, tx, ty, tz)) or not f.is_water(try level.state(f, tx, ty - 1, tz)) {
        left = dispense_default(mut level, x, y, z, front, stack)
        thrown = true
    }
    if not thrown {
        let out = 0.5625 + f64(1.375f32) / 2.0
        let sx = f64(x) + 0.5 + f64(step_x(front)) * out
        let sy = f64(y) + 0.5 + f64(step_y(front)) * f64(1.125f32)
        let sz = f64(z) + 0.5 + f64(step_z(front)) * out
        level.add_vehicle(kind.copy(), with_count(stack, 1) ?? stack.copy(), sx, sy + lift, sz, y_rot_of(front), 0.0f32)
        left = with_count(stack, count_of(some(stack.copy())) - 1)
    }
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// `MinecartDispenseItemBehavior` of `stack`, of the minecart `kind`, by the dispenser at x, y, z
// facing `front` (CAL-378): with a rail in front, `#rails`, a minecart 1.125 out from the middle
// along the facing, at the bottom of the block in front, 0.6 up on a slope and 0.1 else; with air
// in front and a rail under it, 0.4 down on a slope where it doesn't face down, else 0.9 down;
// `createMinecart`, and one used. Else one thrown as `DefaultDispenseItemBehavior.dispense` throws
// it, with its click and smoke. Then its click and smoke.
fn dispense_cart<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag, kind: String) -> Tag? ! Thrown {
    let (tx, ty, tz) = (x + step_x(front), y + step_y(front), z + step_z(front))
    let rails = f.tag("minecraft:rails")
    let ahead = try level.state(f, tx, ty, tz)
    var lift = 0.0
    var left: Tag? = none
    var thrown = false
    if f.in_set(ahead, rails) {
        lift = if sloped(f, ahead) { 0.6 } else { 0.1 }
    } else if not f.is_air(ahead) {
        left = dispense_default(mut level, x, y, z, front, stack)
        thrown = true
    } else {
        let below = try level.state(f, tx, ty - 1, tz)
        if not f.in_set(below, rails) {
            left = dispense_default(mut level, x, y, z, front, stack)
            thrown = true
        } else {
            lift = if front != DOWN and sloped(f, below) { -0.4 } else { -0.9 }
        }
    }
    if not thrown {
        let sx = f64(x) + 0.5 + f64(step_x(front)) * 1.125
        let sy = f64(y + step_y(front))
        let sz = f64(z) + 0.5 + f64(step_z(front)) * 1.125
        level.add_vehicle(kind.copy(), with_count(stack, 1) ?? stack.copy(), sx, sy + lift, sz, 0.0f32, 0.0f32)
        left = with_count(stack, count_of(some(stack.copy())) - 1)
    }
    level.level_event(DISPENSER_DISPENSE, x, y, z, 0)
    level.level_event(DISPENSER_SMOKE, x, y, z, front)
    return left
}

// The way the facing `front` turns what faces it, `Direction.toYRot`: up and down as east.
fn y_rot_of(front: i32) -> f32 {
    return if front == SOUTH { 0.0f32 } else if front == WEST { 90.0f32 } else if front == NORTH { 180.0f32 } else { 270.0f32 }
}

// Whether the rail `state` slopes, `getRailShape(state).isSlope()`; what isn't a rail is
// north-south.
fn sloped(f: Facts, state: u32) -> bool {
    if not is_rail(f, state) {
        return false
    }
    let shape = rail_shape(f, state)
    return shape >= 2 and shape <= 5
}

// `DefaultDispenseItemBehavior.execute` of `stack` by the dispenser at x, y, z facing `front`:
// one of it thrown, `spawnItem` at accuracy 6. What's left of `stack`.
fn throw_one<L: BlockAccess + BlockLevel + DropLevel + RandomSource>(level: mut L, x: i32, y: i32, z: i32, front: i32, stack: Tag) -> Tag? {
    let one = with_count(stack, 1) ?? stack.copy()
    let sx = f64(x) + 0.5 + f64(step_x(front)) * 0.7
    let sy = f64(y) + 0.5 + f64(step_y(front)) * 0.7 - (if front == DOWN or front == UP { 0.125 } else { 0.15625 })
    let sz = f64(z) + 0.5 + f64(step_z(front)) * 0.7
    let power = level.next_double() * 0.1 + 0.2
    let spread = 0.0172275 * 6.0
    let vx = level.triangle(f64(step_x(front)) * power, spread)
    let vy = level.triangle(0.2, spread)
    let vz = level.triangle(f64(step_z(front)) * power, spread)
    level.add_spilled(sx, sy, sz, one, vx, vy, vz)
    return with_count(stack, count_of(some(stack.copy())) - 1)
}

// Whether the item `id` is shot as a projectile Calcite has, `registerProjectileBehavior`, with
// its `DispenseConfig`'s power and uncertainty: 1.1 and 6, a thrown potion's and a bottle o'
// enchanting's 1.375 and 3.
fn shot_of(id: String) -> (bool, f32, f32) {
    for n in ["minecraft:arrow", "minecraft:tipped_arrow", "minecraft:spectral_arrow", "minecraft:egg", "minecraft:blue_egg", "minecraft:brown_egg", "minecraft:snowball"] {
        if id == n {
            return (true, 1.1f32, 6.0f32)
        }
    }
    if id == "minecraft:splash_potion" or id == "minecraft:lingering_potion" or id == "minecraft:experience_bottle" {
        return (true, 1.1f32 * 1.25f32, 6.0f32 * 0.5f32)
    }
    return (false, 0.0f32, 0.0f32)
}

// The type of the mob the spawn egg `stack`, of the item `id`, spawns, its `entity_data`'s `id`,
// `SpawnEggItem.getType`; none where it isn't one.
fn egg_kind<L: BlockLevel + DropLevel>(level: L, stack: Tag, id: String) -> String? {
    if not id.ends_with("_spawn_egg") {
        return none
    }
    let shared = level.world_loot() else return none
    let Tag.Compound(data) = shared.value.items.component(stack, String("minecraft:entity_data")) ?? Tag.End else return none
    if not data.contains("id") {
        return none
    }
    let Tag.Str(kind) = data["id"] else return none
    return some(kind.copy())
}

// Whether the item `id` has a behavior of its own, `DISPENSER_REGISTRY`'s, of those Calcite
// doesn't do yet.
fn own_named(id: String) -> bool {
    let name = id.trim_prefix("minecraft:")
    if name.len() < id.len() {
        for n in own_behavior() {
            if name == n {
                return true
            }
        }
    }
    return false
}

// Whether `stack` has an equippable, `DataComponents.EQUIPPABLE`.
fn equippable<L: BlockLevel + DropLevel>(level: L, stack: Tag) -> bool {
    let shared = level.world_loot() else return false
    return shared.value.items.component(stack, String("minecraft:equippable")) != none
}

// `EquipmentDispenseItemBehavior.dispenseEquipment` of `stack` into the block x, y, z in front
// of a dispenser (CAL-378): its equippable's slot, where it's `dispensable`; the first living
// entity whose box meets the block, in the level's order, that may wear it there,
// `canEquipWithDispenser`, its type among the equippable's `allowed_entities` where it has them,
// `canBeEquippedBy`; one of it put on that, `add_equip`. Whether one was.
fn equip_in_front<L: BlockLevel + DropLevel>(level: mut L, x: i32, y: i32, z: i32, stack: Tag) -> bool {
    let shared = level.world_loot() else return false
    let Tag.Compound(e) = shared.value.items.component(stack, String("minecraft:equippable")) ?? Tag.End else return false
    if e.contains("dispensable") and not (e["dispensable"].number_bool() ?? true) {
        return false
    }
    let Tag.Str(named) = (if e.contains("slot") { e["slot"].copy() } else { Tag.End }) else return false
    var slot: usize? = none
    let names = slot_names()
    for i in 0..names.len() {
        if names[i] == named {
            slot = some(i)
        }
    }
    let k = slot else return false
    let ws = level.wearers()
    let block = Aabb { min_x: f64(x), min_y: f64(y), min_z: f64(z), max_x: f64(x + 1), max_y: f64(y + 1), max_z: f64(z + 1) }
    for at in wearers_in(ws, block) {
        if k >= ws[at].open.len() or not ws[at].open[k] {
            continue
        }
        if e.contains("allowed_entities") and not shared.value.items.entity_allowed(e["allowed_entities"], ws[at].kind.copy()) {
            continue
        }
        let one = with_count(stack, 1) ?? stack.copy()
        level.add_equip(ws[at].id, k, one)
        return true
    }
    return false
}

// The item of `stack`.
fn item_id(stack: Tag) -> String {
    let Tag.Compound(m) = stack else return String("minecraft:air")
    if not m.contains("id") {
        return String("minecraft:air")
    }
    return match m["id"] {
        Tag.Str(i) => i.copy(),
        _ => String("minecraft:air"),
    }
}

// The way the dispenser `state` faces, its `facing`.
fn facing(f: Facts, state: u32) -> i32 {
    let name = f.get_name(state, "facing") ?? String("north")
    if name == "down" {
        return DOWN
    }
    if name == "up" {
        return UP
    }
    if name == "south" {
        return SOUTH
    }
    if name == "west" {
        return WEST
    }
    if name == "east" {
        return EAST
    }
    return NORTH
}
