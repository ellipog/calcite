/// `minecraft:visual/sun_angle`'s place, which a daylight detector reads at its block (CAL-130).
pub fn sun_angle() -> usize {
    return find(String("minecraft:visual/sun_angle")) ?? 0
}

/// `minecraft:gameplay/increased_fire_burnout`'s place, which fire's tick reads at its block
