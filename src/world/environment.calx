/// The environment attributes a level reads of itself, as vanilla's `EnvironmentAttributeSystem`
/// gives their dimension values (P6.1, D313).
///
/// Each attribute starts at its default. Then it's changed by, in this order:
///
/// 1. what the dimension's type sets;
/// 2. each of the type's timelines, in their order, by the keyframes of its track, at the ticks
///    of the clock the timeline goes by;
/// 3. the rain and the thunder, where the level can have weather.
///
/// That's the order `addDefaultLayers` adds them in. The biomes' layer, between the type's and the
/// timelines', is left out, as `getDimensionValue` leaves it out: only a place has a biome. A
/// float that ends outside its attribute's range is clamped to it. What each attribute is stays
/// the same for the rest of the tick once it's asked for, as `ValueSampler` keeps it, until
/// `invalidate` starts the next.
///
/// Calcite evaluates the float and boolean attributes, and the moon's phase, which local difficulty
/// reads (CAL-156). The others are colors, angles, sounds and the like, which the client works out
/// from the same data.
module world.environment

import math.mth.{SinTable}
import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import std.java.math.{pow, sin}
import world.clocks.{Clocks}

/// An attribute's kind, of those Calcite evaluates: a float, a boolean, the moon's phase, by its
/// place in `MoonPhase`'s order, `full_moon` first, or a villager's activity, by `world.brain`'s
/// numbering, `activity_names`, each of which only overrides and steps from one keyframe to the
/// next, as `ofNotInterpolated` has it (CAL-160); or a bed's rule, `BedRule`, the same, by its
/// place among the rules the environment read, `rule_of` (D574).
pub enum Kind {
    Float
    Boolean
    Phase
    Activity
    Rule
}

/// An attribute's value, or what a modifier takes: a float, with the alpha that `alpha_blend`
/// blends by, or a boolean.
pub struct Value {
    pub number: f32 = 0.0f32
    pub alpha: f32 = 1.0f32
    pub flag: bool = false
}

// What a layer does to the value so far: `AttributeModifier`'s operations on floats and
// booleans.
enum Op {
    Override
    AlphaBlend
    Add
    Subtract
    Multiply
    Minimum
    Maximum
    And
    Nand
    Or
    Nor
    Xor
    Xnor
}

// `CubicBezier.CubicCurve`: `((a t + b) t + c) t`, from a curve's two inner controls.
struct Curve {
    a: f32
    b: f32
    c: f32
}

// How a segment of a track eases from one keyframe to the next, `EasingType`.
enum Ease {
    Constant
    Linear
    InBack
    InBounce
    InCirc
    InCubic
    InElastic
    InExpo
    InQuad
    InQuart
    InQuint
    InSine
    InOutBack
    InOutBounce
    InOutCirc
    InOutCubic
    InOutElastic
    InOutExpo
    InOutQuad
    InOutQuart
    InOutQuint
    InOutSine
    OutBack
    OutBounce
    OutCirc
    OutCubic
    OutElastic
    OutExpo
    OutQuad
    OutQuart
    OutQuint
    OutSine
    Bezier { x: Curve, y: Curve }
}

// From one keyframe to the next, `KeyframeTrackSampler.Segment`.
struct Segment {
    ease: Ease
    from_ticks: i32
    from: Value
    to_ticks: i32
    to: Value
}

// A timeline's track of one attribute, `AttributeTrackSampler`: its modifier, the clock it goes
// by, by its ID in `world_clock`, the timeline's period, and its segments.
struct Track {
    op: Op
    clock: i32?
    period: i32?
    segments: List<Segment>
}

// What the rain or the thunder does to an attribute, from `WeatherAttributes.RAIN` and `THUNDER`.
struct Change {
    op: Op
    argument: Value
}

// One step of an attribute's value: the dimension type's, a timeline's, or the weather's.
enum Layer {
    Constant { op: Op, argument: Value }
    Timed(Track)
    Weather { rain: Change?, thunder: Change? }
}

// One attribute's layers, `EnvironmentAttributeSystem.ValueSampler`, and what it was this tick,
// with the attribute's name.
struct Sampler {
    name: String
    kind: Kind
    base: Value
    range: bool
    min: f32
    max: f32
    layers: List<Layer>
    cached: Value? = none
}

/// A level's environment attributes.
pub struct Environment {
    samplers: List<Sampler>
    // `Mth`'s sine table, for the sine easings, if a track has one.
    table: SinTable? = none
    // The bed rules its layers and the biomes asked about give, as their codec's input, each a
    // rule value's place in it, one on: 0 is the attribute's default (D574).
    rules: List<Tag> = List<Tag>()
}

// Each float and boolean attribute: its name, whether it's a float, its default, and its range,
// where it has one, as `EnvironmentAttributes` registers them.
fn catalog() -> List<(String, Kind, f32, bool, f32, f32)> {
    let inf = f32.INFINITY
    let f = Kind.Float
    let b = Kind.Boolean
    let p = Kind.Phase
    let a = Kind.Activity
    let r = Kind.Rule
    return [
        ("minecraft:visual/fog_start_distance", f, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:visual/fog_end_distance", f, 1024.0f32, true, 0.0f32, inf),
        ("minecraft:visual/sky_fog_end_distance", f, 512.0f32, true, 0.0f32, inf),
        ("minecraft:visual/cloud_fog_end_distance", f, 2048.0f32, true, 0.0f32, inf),
        ("minecraft:visual/water_fog_start_distance", f, -8.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:visual/water_fog_end_distance", f, 96.0f32, true, 0.0f32, inf),
        ("minecraft:visual/cloud_height", f, 192.33f32, false, 0.0f32, 0.0f32),
        // An angle in degrees, whose keyframes and modifiers are a float's (CAL-130).
        ("minecraft:visual/sun_angle", f, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:visual/star_brightness", f, 0.0f32, true, 0.0f32, 1.0f32),
        ("minecraft:visual/sky_light_factor", f, 1.0f32, true, 0.0f32, 1.0f32),
        ("minecraft:audio/music_volume", f, 1.0f32, true, 0.0f32, 1.0f32),
        ("minecraft:audio/firefly_bush_sounds", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/sky_light_level", f, 15.0f32, true, 0.0f32, 15.0f32),
        ("minecraft:gameplay/can_start_raid", b, 1.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/water_evaporates", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/respawn_anchor_works", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/nether_portal_spawns_piglin", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/fast_lava", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/increased_fire_burnout", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/turtle_egg_hatch_chance", f, 0.002f32, true, 0.0f32, 1.0f32),
        ("minecraft:gameplay/piglins_zombify", b, 1.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/snow_golem_melts", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/creaking_active", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/surface_slime_spawn_chance", f, 0.0f32, true, 0.0f32, 1.0f32),
        ("minecraft:gameplay/cat_waking_up_gift_chance", f, 0.0f32, true, 0.0f32, 1.0f32),
        ("minecraft:gameplay/bees_stay_in_hive", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/monsters_burn", b, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/can_pillager_patrol_spawn", b, 1.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/creature_world_gen_spawn_probability", f, 0.1f32, true, 0.0f32, 0.9999999f32),
        ("minecraft:visual/moon_phase", p, 0.0f32, false, 0.0f32, 0.0f32),
        // Idle, 1, by default.
        ("minecraft:gameplay/villager_activity", a, 1.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/baby_villager_activity", a, 1.0f32, false, 0.0f32, 0.0f32),
        // `CAN_SLEEP_WHEN_DARK` and `DESTROY_ON_LEAVE`, each its attribute's default, 0 (D574).
        ("minecraft:gameplay/bed_rule", r, 0.0f32, false, 0.0f32, 0.0f32),
        ("minecraft:gameplay/straw_bed_rule", r, 0.0f32, false, 0.0f32, 0.0f32),
    ]
}

/// The attributes Calcite evaluates, by the places `find` gives.
pub fn attribute_names() -> List<String> {
    var out = List<String>()
    for (name, _kind, _default, _range, _min, _max) in catalog() {
        out.push(name.copy())
    }
    return out
}

/// The place of the attribute `name` among those Calcite evaluates, if it's one.
pub fn find(name: String) -> usize? {
    let all = catalog()
    for i in 0..all.len() {
        let (n, _kind, _default, _range, _min, _max) = all[i]
        if n == name {
            return some(i)
        }
    }
    return none
}

/// The kind of the attribute at `at`.
pub fn kind_at(at: usize) -> Kind {
    let all = catalog()
    let (_name, kind, _default, _range, _min, _max) = all[at]
    return kind
}

/// `minecraft:gameplay/sky_light_level`'s place, which a level reads every tick.
pub fn sky_light_level() -> usize {
    return find(String("minecraft:gameplay/sky_light_level")) ?? 0
}

/// `minecraft:gameplay/fast_lava`'s place, which lava's tick delay reads (D324).
pub fn fast_lava() -> usize {
    return find(String("minecraft:gameplay/fast_lava")) ?? 0
}

/// `minecraft:gameplay/water_evaporates`'s place, which ice melting reads (D338).
pub fn water_evaporates() -> usize {
    return find(String("minecraft:gameplay/water_evaporates")) ?? 0
}

/// `minecraft:gameplay/surface_slime_spawn_chance`'s place, which slimes' spawn rule reads at a
/// place (D317).
pub fn surface_slime_spawn_chance() -> usize {
    return find(String("minecraft:gameplay/surface_slime_spawn_chance")) ?? 0
