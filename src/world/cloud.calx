/// An area effect cloud, as vanilla's `AreaEffectCloud` makes and runs it (D529): 6 by 0.5, its
/// eyes 0.425 up, twice its radius across as that changes, `getDimensions`, without physics, so it
/// never moves; its values `Entity`'s, then its radius, 3, whether it's waiting, and its particle,
/// `entity_effect` in its contents' colour, opaque, made anew each time it's set, so never its
/// default, `cloud_data`. Each tick, as `ServerLevel.tickNonPassenger` and `AreaEffectCloud.tick`
/// run it: `Entity.baseTick`, its fluids, its fire, which it's immune to, gone below the level, and
/// its flag; then `serverTick`: gone once it's lasted its duration past its wait; waiting, as its
/// value says, till it's waited; then its radius more by its change a tick, gone below 0.5; and,
/// every 5 ticks, its victims whose delay is up forgotten, and, where its contents have effects,
/// those it doses, `dose`, of the living things its level found in its box, `Breather`: each it
/// hasn't dosed within its delay, that potions take and one of its effects can affect, its place
/// across within its radius of the cloud's, made a victim till its delay's up, the cloud's radius
/// more by its change a use, gone below 0.5, and its duration more by its change a use, gone at
/// none. What it gives each, its level's to do, `Dose`.
///
/// A lingering potion leaves one, `lingered`, as `ThrownLingeringPotion.onHitAsPotion` does. It's
/// saved as `saveAsPassenger` saves it, `saved`, and loaded as `EntityType.create` makes one and
/// `load` reads it in, `loaded`. A particle of its own, `custom_particle`, is kept as it was read;
/// a dragon's breath, a `PowerParticleOption`, is its particle (D617), else it's said missing by
/// its level, `particle_missing`, and its particle stays its contents' colour. An ender dragon's
/// breath leaves one, `breathed` (D617).
module world.cloud

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import server.log.{Entry}
import world.body.{Body, BodyFacts, EntitySound, bool_or, int_or, uuid_of, uuid_tag}
import world.collision.{CollisionBlocks}
import world.effects.{ActiveEffect, contents_color, contents_effects, contents_empty}
import world.entity_data.{AIR_SUPPLY, CLOUD_PARTICLE, CLOUD_RADIUS, CLOUD_WAITING, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, ON_FIRE_FLAG, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, cloud_data}
import world.thrown.{Doser}
import worldgen.facts.{Facts}

/// A living thing in a cloud's box as its level found it, `getEntitiesOfClass(LivingEntity)`: its
/// ID, where it is across, whether it's a player, and whether the cloud may dose it, potions taking
/// it, `isAffectedByPotions`, and one of the cloud's effects able to affect it, `canBeAffected`.
pub struct Breather {
    pub id: i32
    pub x: f64
    pub z: f64
    pub player: bool
    pub takes: bool
}

/// What a cloud's pass doses, as `serverTick` doses them (D529): the cloud, what doses them; those
/// it doses, by ID and whether each is a player, in order; and its effects, `forEachEffect` at its
/// duration scale, each instant one done at half, `applyInstantaneousEffect`, each other added as
/// it is, `addEffect`.
pub struct Dose {
    pub by: Doser
    pub targets: List<(i32, bool)>
    pub effects: List<ActiveEffect>
}

/// An area effect cloud.
pub struct EffectCloud {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s and its own.
    pub body: Body
    pub data: EntityData
    /// Its potion's contents, `potionContents`, as their codec saves them, none at all an empty
    /// compound, `PotionContents.EMPTY`; how much longer than its potion's its effects last,
    /// `potionDurationScale`; and the particle it was given of its own, as it was read, none where
    /// it has none, `customParticle`.
    pub contents: Tag
    pub duration_scale: f32 = 1.0f32
    pub custom_particle: Tag? = none
    /// That particle where it's one Calcite shows, a dragon's breath, its type's ID in the
    /// `particle_type` registry and its power (D617).
    pub own_particle: (i32, f32)? = none
    /// Those it dosed, by ID, and the tick each may be dosed again from, `victims`.
    pub victims: List<(i32, i32)> = List<(i32, i32)>()
    /// How long it lasts past its wait, -1 for ever, `duration`; how long it waits, `waitTime`; how
    /// long till it may dose one again, `reapplicationDelay`; how much longer it lasts and how much
    /// bigger it grows each time it doses one, `durationOnUse` and `radiusOnUse`; and how much
    /// bigger it grows a tick, `radiusPerTick`.
    pub duration: i32 = -1
    pub wait_time: i32 = 20
    pub reapplication_delay: i32 = 20
    pub duration_on_use: i32 = 0
    pub radius_on_use: f32 = 0.0f32
    pub radius_per_tick: f32 = 0.0f32
    /// Its owner's UUID, `owner`.
    pub owner: (i64, i64)? = none
    // The ID of `entity_effect` in the `particle_type` registry.
    effect_particle: i32
}

impl EffectCloud {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z, without physics.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64) -> EffectCloud {
        var body = Body.made(id, seed, x, y, z, 6.0f32, 0.5f32, 0.425f32, 0.0)
        body.no_physics = true
        let particle = effect_particle()
        return EffectCloud { body: body, data: cloud_data(particle), contents: Tag.Compound(JavaHashMap<String, Tag>()), effect_particle: particle }
    }

    /// The cloud a lingering potion leaves where it hit, `ThrownLingeringPotion.onHitAsPotion`
    /// (D529), with the ID `id` and a random seeded `seed`: at x, y, z, where the entity it hit is,
    /// else where it is, as the caller has it; its owner the living thing of the UUID `owner`,
    /// where the caller found one; 3 across, a half less each it doses, lasting 600 ticks past a
    /// wait of 10, a 600th of its radius less a tick; then what the potion's stack gives it,
    /// `applyComponentsFromItemStack`: its contents `contents`, `setPotionContents`, its duration
    /// scale `scale`, its name `name` and its custom data `custom`, where it has them.
    pub fn lingered(id: i32, seed: i64, x: f64, y: f64, z: f64, owner: (i64, i64)?, contents: Tag?, scale: f32?, name: Tag?, custom: Tag?) -> EffectCloud {
        var c = EffectCloud.made(id, seed, x, y, z)
        c.owner = owner
        c.set_radius(3.0f32)
        c.radius_on_use = -0.5f32
        c.duration = 600
        c.wait_time = 10
        c.radius_per_tick = -c.radius() / f32.nearest(c.duration)
        if let t = contents {
            c.set_contents(t.copy())
        }
        if let s = scale {
            c.duration_scale = s
        }
        if let n = name {
            c.body.extras.insert(String("CustomName"), n.copy())
            c.data.set(CUSTOM_NAME, Value.Name(n.copy()))
        }
        if let data = custom {
            if let Tag.Compound(m) = data {
                if not m.is_empty() {
                    c.body.extras.insert(String("data"), data.copy())
                }
            }
        }
        return c
    }

    /// The cloud a creeper with effects leaves as it explodes, `Creeper.spawnLingeringCloud`
    /// (CAL-182), with the ID `id` and a random seeded `seed`, at x, y, z, where the creeper was:
    /// owned by nobody; of a radius of 2.5, a half less each it doses, lasting 300 ticks past a
    /// wait of 10, a 300th of its radius less a tick; its effects lasting a quarter as long; and
    /// each of the creeper's effects, `effects`, as `MobEffectInstance`'s codec writes them,
    /// `addEffect`. Vanilla's come in its `HashMap`'s order, by their effects' identity hashes,
    /// where Calcite's come as they were added.
    pub fn crept(id: i32, seed: i64, x: f64, y: f64, z: f64, effects: own List<Tag>) -> EffectCloud {
        var c = EffectCloud.made(id, seed, x, y, z)
        c.set_radius(2.5f32)
        c.radius_on_use = -0.5f32
        c.wait_time = 10
        c.duration = 300
        c.duration_scale = 0.25f32
        c.radius_per_tick = -c.radius() / f32.nearest(c.duration)
        var contents = JavaHashMap<String, Tag>()
        contents.insert(String("custom_effects"), Tag.List(effects))
        c.set_contents(Tag.Compound(contents))
        return c
    }

    /// The cloud an ender dragon's breath leaves, `DragonSittingFlamingPhase.doServerTick` (D617),
    /// with the ID `id` and a random seeded `seed`, at x, y, z: its owner the dragon of the UUID
    /// `owner`; 5 across, lasting 200 ticks past its default wait of 20; its particle a dragon's
    /// breath of power 1, `setCustomParticle`; its effects lasting a quarter as long,
    /// `setPotionDurationScale`; and instant damage, `addEffect`, as `MobEffectInstance`'s codec
    /// writes it, its icon shown.
    pub fn breathed(id: i32, seed: i64, x: f64, y: f64, z: f64, owner: (i64, i64)) -> EffectCloud {
        var c = EffectCloud.made(id, seed, x, y, z)
        c.owner = some(owner)
        c.set_radius(5.0f32)
        c.duration = 200
        var particle = JavaHashMap<String, Tag>()
        particle.insert(String("type"), Tag.Str(String("minecraft:dragon_breath")))
        particle.insert(String("power"), Tag.Float(1.0f32))
        c.custom_particle = some(Tag.Compound(particle))
        c.own_particle = some((particle_id(String("dragon_breath")), 1.0f32))
        c.update_particle()
        c.duration_scale = 0.25f32
        var effect = JavaHashMap<String, Tag>()
        effect.insert(String("id"), Tag.Str(String("minecraft:instant_damage")))
        effect.insert(String("show_icon"), Tag.Byte(1i8))
        var contents = JavaHashMap<String, Tag>()
        contents.insert(String("custom_effects"), Tag.List([Tag.Compound(effect)]))
        c.set_contents(Tag.Compound(contents))
        return c
    }

    /// The cloud a dragon fireball leaves where it hits, `DragonFireball.onHit` (D618), with the ID
    /// `id` and a random seeded `seed`, at x, y, z: its owner the living thing of the UUID `owner`,
    /// where there is one; its particle a dragon's breath of power 1; 3 across, lasting 600 ticks
    /// past its default wait of 20, growing to 7 across as it does, `setRadiusPerTick`, in floats;
    /// its effects lasting a quarter as long; and instant damage II for a tick, as
    /// `MobEffectInstance`'s codec writes it, its icon shown.
    pub fn fireballed(id: i32, seed: i64, x: f64, y: f64, z: f64, owner: (i64, i64)?) -> EffectCloud {
        var c = EffectCloud.made(id, seed, x, y, z)
        c.owner = owner
        var particle = JavaHashMap<String, Tag>()
        particle.insert(String("type"), Tag.Str(String("minecraft:dragon_breath")))
        particle.insert(String("power"), Tag.Float(1.0f32))
        c.custom_particle = some(Tag.Compound(particle))
        c.own_particle = some((particle_id(String("dragon_breath")), 1.0f32))
        c.update_particle()
        c.set_radius(3.0f32)
        c.duration = 600
        c.radius_per_tick = (7.0f32 - c.radius()) / f32.nearest(c.duration)
        c.duration_scale = 0.25f32
        var effect = JavaHashMap<String, Tag>()
        effect.insert(String("id"), Tag.Str(String("minecraft:instant_damage")))
        effect.insert(String("amplifier"), Tag.Byte(1i8))
        effect.insert(String("duration"), Tag.Int(1))
        effect.insert(String("show_icon"), Tag.Byte(1i8))
        var contents = JavaHashMap<String, Tag>()
        contents.insert(String("custom_effects"), Tag.List([Tag.Compound(effect)]))
        c.set_contents(Tag.Compound(contents))
        return c
    }

    /// Its radius, `getRadius`.
    pub fn radius(self) -> f32 {
        return self.data.float(CLOUD_RADIUS)
    }

    /// Whether it's waiting, `isWaiting`.
    pub fn waiting(self) -> bool {
        return self.data.flag(CLOUD_WAITING)
    }

    /// `setRadius`: its radius `radius`, kept from 0 to 32, `Mth.clamp`, and, where that changed
    /// it, twice that across, `refreshDimensions`, where it is still.
    pub fn set_radius(mut self, radius: f32) {
        let r = if radius < 0.0f32 { 0.0f32 } else if radius > 32.0f32 { 32.0f32 } else { radius }
        let was = self.radius()
        self.data.set(CLOUD_RADIUS, Value.Float(r))
        if r.to_bits() != was.to_bits() {
            self.body.width = r * 2.0f32
        }
    }

    /// `setPotionContents`: its contents `contents`, as their codec reads them, then its particle,
    /// `updateParticle`.
    pub fn set_contents(mut self, contents: Tag) {
        self.contents = contents_saved(contents)
        self.update_particle()
    }

    /// Whether it has a particle of its own that Calcite doesn't show yet, which its level says.
    pub fn particle_missing(self) -> bool {
        return self.custom_particle != none and self.own_particle == none
    }

    /// Its effects, `forEachEffect` at its duration scale, its potion's then its own.
    pub fn effects(self) -> List<ActiveEffect> {
        return contents_effects(self.contents.copy(), self.duration_scale)
    }

    /// It as what doses those in it, `Doser`: an area effect cloud, its name its custom name where
    /// it has one.
    pub fn doser(self) -> Doser {
        var name: Tag? = none
        if self.body.extras.contains("CustomName") {
            name = some(self.body.extras["CustomName"].copy())
        }
        return Doser { id: self.body.id, uuid: self.body.uuid, name: name, kind: String("minecraft:area_effect_cloud"), owner: self.owner, x: self.body.x, y: self.body.y, z: self.body.z }
    }

    /// Its tick up to those it doses, as `tickNonPassenger` and `AreaEffectCloud.tick` run it
    /// among `blocks`, in a level whose floor is `min_y`: a tick older, `tickCount`;
    /// `Entity.baseTick`: how far it went, nothing, its portal cooldown, its fluids, with a splash
    /// coming into water and the currents pushing it, though it never moves, its fire put out, its
    /// fall halved in lava, gone below the level, and its flag; then `serverTick`'s start,
    /// `server_tick`. Its radius, for its pass, `dose`, where it's to look for any to dose now,
    /// none where it isn't.
    pub fn tick_start<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) -> f32? {
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        self.body.compute_speed()
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        _ = self.body.update_fluids_pushed(f, t, blocks, fast_lava, true, true, mut sounds)
        _ = self.body.fire_tick(true)
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let shown = self.body.fire_shown()
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, shown)
        self.body.first_tick = false
        return self.server_tick()
    }

    /// `serverTick` up to those it doses, at its age now: gone once it's lasted past its wait,
    /// `discard`; waiting till it's waited, its value set where that changed; then its radius more
    /// by its change a tick, gone below 0.5; then, every 5 ticks, its victims whose delay is up
    /// forgotten, all where it has no effects. Its radius for its pass where it's to look for any
    /// to dose now, none where it isn't.
    pub fn server_tick(mut self) -> f32? {
        if self.duration != -1 and self.body.tick_count - self.wait_time >= self.duration {
            self.body.removed = true
            return none
        }
        let should_wait = self.body.tick_count < self.wait_time
        if self.waiting() != should_wait {
            self.data.set(CLOUD_WAITING, Value.Bool(should_wait))
        }
        if should_wait {
            return none
        }
        var radius = self.radius()
        if self.radius_per_tick != 0.0f32 {
            radius = radius + self.radius_per_tick
            if radius < 0.5f32 {
                self.body.removed = true
                return none
            }
            self.set_radius(radius)
        }
        if self.body.tick_count % 5 != 0 {
            return none
        }
        let now = self.body.tick_count
        var kept = List<(i32, i32)>()
        for v in self.victims {
            let (_, until) = v
            if now < until {
                kept.push(v)
            }
        }
        self.victims = kept
        if self.effects().is_empty() {
            self.victims.clear()
            return none
        }
        return some(radius)
    }

    /// Its pass over `near`, the living things its level found in its box, at `radius`, as
    /// `serverTick` makes it every 5 ticks: of those, in the order they were found, each it hasn't
    /// dosed within its delay, `victims`, that it may dose, `Breather.takes`, whose place across is
    /// within its radius of its own, `dist <= radius * radius`, made its victim till its delay's
    /// up; then, where it grows a use, its radius more by that, gone below 0.5; and, where it lasts
    /// longer a use and doesn't last for ever, its duration more by that, gone at none or less.
    /// Those it doses, by ID and whether each is a player, in order, the last the one it went at
    /// where it went.
    pub fn dose(mut self, radius: f32, near: List<Breather>) -> List<(i32, bool)> {
        var r = radius
        var out = List<(i32, bool)>()
        for b in near {
            if self.is_victim(b.id) or not b.takes {
                continue
            }
            let xd = b.x - self.body.x
            let zd = b.z - self.body.z
            if not (xd * xd + zd * zd <= f64(r * r)) {
                continue
            }
            self.victims.push((b.id, self.body.tick_count + self.reapplication_delay))
            out.push((b.id, b.player))
            if self.radius_on_use != 0.0f32 {
                r = r + self.radius_on_use
                if r < 0.5f32 {
                    self.body.removed = true
                    return out
                }
                self.set_radius(r)
            }
            if self.duration_on_use != 0 and self.duration != -1 {
                self.duration = self.duration + self.duration_on_use
                if self.duration <= 0 {
                    self.body.removed = true
                    return out
                }
            }
        }
        return out
    }

    // Whether it's dosed the entity `id` within its delay.
    fn is_victim(self, id: i32) -> bool {
        for v in self.victims {
            let (victim, _) = v
            if victim == id {
                return true
            }
        }
        return false
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// then its age, duration, wait, delay, changes a use and a tick, and radius; the particle of
    /// its own where it has one, its owner where it has one, its contents where they're not
    /// empty, and its duration scale where it isn't 1.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:area_effect_cloud")
        t.insert(String("Age"), Tag.Int(self.body.tick_count))
        t.insert(String("Duration"), Tag.Int(self.duration))
        t.insert(String("WaitTime"), Tag.Int(self.wait_time))
        t.insert(String("ReapplicationDelay"), Tag.Int(self.reapplication_delay))
        t.insert(String("DurationOnUse"), Tag.Int(self.duration_on_use))
        t.insert(String("RadiusOnUse"), Tag.Float(self.radius_on_use))
        t.insert(String("RadiusPerTick"), Tag.Float(self.radius_per_tick))
        t.insert(String("Radius"), Tag.Float(self.radius()))
        if let p = self.custom_particle {
            t.insert(String("custom_particle"), p.copy())
        }
        if let o = self.owner {
            t.insert(String("Owner"), uuid_tag(o))
        }
        if not contents_empty(self.contents.copy()) {
            t.insert(String("potion_contents"), self.contents.copy())
        }
        if self.duration_scale != 1.0f32 {
            t.insert(String("potion_duration_scale"), Tag.Float(self.duration_scale))
        }
        return Tag.Compound(t)
    }

    /// The cloud `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `Entity.load` and `readAdditionalSaveData` read it in: what every entity
    /// reads, `world.body`'s, and its values from it; its age, duration, wait, delay, changes and
    /// radius, each its default where it's missing; its owner; its particle of its own; its
    /// contents, empty where they're missing; and its duration scale. `none` where it's somewhere
    /// that isn't a number, logged in `lines` as `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> EffectCloud? {
        var c = EffectCloud.made(id, seed, 0.0, 0.0, 0.0)
        if not c.body.load_from(tag, mut lines) {
            return none
        }
        c.data.set(AIR_SUPPLY, Value.Number(c.body.air))
        if c.body.extras.contains("CustomName") {
            c.data.set(CUSTOM_NAME, Value.Name(c.body.extras["CustomName"].copy()))
        }
        c.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        c.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        c.data.set(NO_GRAVITY, Value.Bool(c.body.no_gravity))
        c.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        c.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        c.body.tick_count = int_or(tag, "Age", 0)
        c.duration = int_or(tag, "Duration", -1)
        c.wait_time = int_or(tag, "WaitTime", 20)
        c.reapplication_delay = int_or(tag, "ReapplicationDelay", 20)
        c.duration_on_use = int_or(tag, "DurationOnUse", 0)
        c.radius_on_use = float_or(tag, "RadiusOnUse", 0.0f32)
        c.radius_per_tick = float_or(tag, "RadiusPerTick", 0.0f32)
        c.set_radius(float_or(tag, "Radius", 3.0f32))
        c.owner = uuid_of(tag, "Owner")
        if tag.contains("custom_particle") {
            c.custom_particle = some(tag["custom_particle"].copy())
            c.own_particle = own_particle_of(tag["custom_particle"].copy())
        }
        c.update_particle()
        if tag.contains("potion_contents") {
            c.set_contents(tag["potion_contents"].copy())
        } else {
            c.set_contents(Tag.Compound(JavaHashMap<String, Tag>()))
        }
        c.duration_scale = float_or(tag, "potion_duration_scale", 1.0f32)
        return some(c)
    }

    // `updateParticle`: its own particle where it has one Calcite shows (D617); else
    // `entity_effect` in its contents' colour, opaque, `ARGB.opaque`, made anew.
    fn update_particle(mut self) {
        if let (kind, power) = self.own_particle {
            self.data.set(CLOUD_PARTICLE, Value.PowerParticle(kind, power))
            return
        }
        let color = -16777216 | contents_color(self.contents.copy())
        self.data.set(CLOUD_PARTICLE, Value.Particle(self.effect_particle, some(color)))
    }
}

// The particle saved as `tag`, `ParticleTypes.CODEC`'s, where it's one Calcite shows (D617): a
// dragon's breath, its power 1 where it's left out; none for any other.
fn own_particle_of(tag: Tag) -> (i32, f32)? {
    let Tag.Compound(m) = tag else return none
    if not m.contains("type") {
        return none
    }
    let Tag.Str(kind) = m["type"] else return none
    if kind != "minecraft:dragon_breath" and kind != "dragon_breath" {
        return none
    }
    var power = 1.0f32
    if m.contains("power") {
        power = m["power"].number_float() ?? 1.0f32
    }
    return some((particle_id(String("dragon_breath")), power))
}

// The contents `contents` as `PotionContents.CODEC` reads and saves them: a potion's ID alone as a
// compound of it; of a compound, its potion, its colour, its name and its effects where it has
// any; none of them where it's neither, `EMPTY`.
fn contents_saved(contents: Tag) -> Tag {
    var out = JavaHashMap<String, Tag>()
    if let Tag.Str(name) = contents {
        out.insert(String("potion"), Tag.Str(name.copy()))
    }
    if let Tag.Compound(m) = contents {
        for key in ["potion", "custom_color", "custom_name"] {
            if m.contains(key) {
                out.insert(String(key), m[key].copy())
            }
        }
        if m.contains("custom_effects") {
            if let Tag.List(items) = m["custom_effects"] {
                if not items.is_empty() {
                    out.insert(String("custom_effects"), m["custom_effects"].copy())
                }
            }
        }
    }
    return Tag.Compound(out)
}

// The number saved as `key`, as `getFloatOr` reads it.
fn float_or(tag: JavaHashMap<String, Tag>, key: str, fallback: f32) -> f32 {
    if not tag.contains(key) {
        return fallback
    }
    return tag[key].number_float() ?? fallback
}

// The ID of `entity_effect` in the `particle_type` registry.
fn effect_particle() -> i32 {
    return particle_id(String("entity_effect"))
}

// The ID of the particle type `name` in the `particle_type` registry, -1 where there's none.
fn particle_id(name: String) -> i32 {
    let names = builtin_entries(9)
    for i in 0..names.len() {
        if names[i] == name {
            return i32.wrap(i)
        }
    }
    return -1
}
