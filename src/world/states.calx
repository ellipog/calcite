/// Block states as vanilla 26.3's `BlockState.CODEC` reads and writes them in saves, such as in a
/// chunk section's palette: a block's default state as its block's name, and any other state as
/// `{id: name, properties: {...}}` with each of its block's properties by name.
///
/// Reading is lenient where vanilla's is. A property that's missing, isn't a string or isn't one
/// of its values keeps the default state's value, a `properties` that isn't a compound gives the
/// default state, and other keys are ignored. An integer property's value is read as Java's
/// `Integer.parseInt` reads it, so `+3` and `03` are `3`. Only a block that isn't there fails, with the
/// message of vanilla's `Codec.either`, which tries a name first and then a compound.
module world.states

import java.number.{parse_int}
import nbt.tag.{Tag}
import registry.names.{Names}
import registry.registry.{Registry}
import world.blocks.{STATE_COUNT, block_properties, default_offsets, first_states, property_names, property_starts, property_values}

/// Every block state, by its block's name and its properties' values.
pub struct StateCodec {
    /// The blocks by name, the `block` registry's entries.
    pub blocks: Names
    firsts: List<u32>
    defaults: List<u32>
    starts: List<u32>
    properties: List<u32>
    property_names: List<String>
    property_values: List<List<String>>
    // Each integer property's least value, or `none` for a property that isn't one.
    int_starts: List<i32?>
}

impl StateCodec {
    /// The states of the blocks of `blocks`, the `block` registry. Panics unless it has as many
    /// blocks as vanilla, which can only be a broken build.
    @track_caller
    pub fn new(blocks: Registry) -> StateCodec {
        let firsts = first_states()
        if blocks.entries.len() != firsts.len() {
            panic("the block registry has {blocks.entries.len()} blocks, not {firsts.len()}")
        }
        let values = property_values()
        var int_starts = List<i32?>()
        for choices in values {
            int_starts.push(int_start(choices))
        }
        return StateCodec {
            blocks: Names.from(blocks),
            firsts: firsts,
            defaults: default_offsets(),
            starts: property_starts(),
            properties: block_properties(),
            property_names: property_names(),
            property_values: values,
            int_starts: int_starts,
        }
    }

    /// The default state of the block `block`. Panics past the last block.
    @track_caller
    pub fn default_state(self, block: u32) -> u32 {
        return self.firsts[usize(block)] + self.defaults[usize(block)]
    }

    /// The block whose state `state` is. Panics past the last state.
    @track_caller
    pub fn block_of(self, state: u32) -> u32 {
        if state >= STATE_COUNT {
            panic("{state} isn't one of the {STATE_COUNT} block states")
        }
        var low: usize = 0
        var high = self.firsts.len()
        while high - low > 1 {
            let mid = (low + high) / 2
            if self.firsts[mid] <= state {
                low = mid
            } else {
                high = mid
            }
        }
        return u32.wrap(low)
    }

    /// The state `tag` holds, or the message vanilla's codec fails with when its block isn't
    /// there: `Failed to parse either. First: ...; Second: ...`, with why it isn't a name, then
    /// why it isn't a compound.
    pub fn decode(self, tag: Tag) -> u32 ! String {
        match tag {
            Tag.Str(text) => {
                return match self.blocks.parse(text) {
                    ok(block) => self.default_state(block),
                    err(first) => fail "Failed to parse either. First: {first}; Second: Not a map: {tag.to_snbt()}",
                }
            },
            Tag.Compound(tags) => {
                if not tags.contains("id") {
                    fail "Failed to parse either. First: Not a string; Second: No key id in MapLike[{tag.to_snbt()}]"
                }
                let block = match self.blocks.decode(tags["id"]) {
                    ok(b) => b,
                    err(second) => fail "Failed to parse either. First: Not a string; Second: {second}",
                }
                if tags.contains("properties") {
                    match tags["properties"] {
                        Tag.Compound(values) => return self.with_values(block, values),
                        _ => {},
                    }
                }
                return self.default_state(block)
            },
            _ => fail "Failed to parse either. First: Not a string; Second: Not a map: {tag.to_snbt()}",
        }
    }

    /// The state as vanilla writes it: its block's name if it's the default state, and otherwise
    /// `{id, properties}` with every property's value. Panics past the last state.
    @track_caller
    pub fn encode(self, state: u32) -> Tag {
        let block = self.block_of(state)
        let name = self.blocks.name(block)
        let b = usize(block)
        if state == self.firsts[b] + self.defaults[b] {
            return Tag.Str(name)
        }
        let start = usize(self.starts[b])
        let end = usize(self.starts[b + 1])
        var offset = state - self.firsts[b]
        var values = List<String>()
        // From the last property, whose value changes fastest.
        var i = end
        while i > start {
            i -= 1
            let p = usize(self.properties[i])
            let count = u32.wrap(self.property_values[p].len())
            values.push(self.property_values[p][usize(offset % count)].copy())
            offset /= count
        }
        // Vanilla's codec for a block's properties is each one's paired onto the ones before it
        // (`Codec.mapPair`), which writes the last one first, so they go in in reverse name order.
        // That's the order a compound's keys keep where they share a bucket.
        var properties = JavaHashMap<String, Tag>()
        for k in 0..values.len() {
            let p = usize(self.properties[end - 1 - k])
            properties.insert(self.property_names[p].copy(), Tag.Str(values[k].copy()))
        }
        var out = JavaHashMap<String, Tag>()
        out.insert("id", Tag.Str(name))
        out.insert("properties", Tag.Compound(properties))
        return Tag.Compound(out)
    }

    // The block's state with the values `values` names, and the default state's where a value
    // isn't there or isn't one of the property's.
    fn with_values(self, block: u32, values: JavaHashMap<String, Tag>) -> u32 {
        let b = usize(block)
        let start = usize(self.starts[b])
        let end = usize(self.starts[b + 1])
        var offset = self.defaults[b]
        var state = self.firsts[b]
        var stride: u32 = 1
        var i = end
        while i > start {
            i -= 1
            let p = usize(self.properties[i])
            let count = u32.wrap(self.property_values[p].len())
            var index = offset % count
            offset /= count
            if values.contains(self.property_names[p]) {
                match values[self.property_names[p]] {
                    Tag.Str(text) => if let j = self.value_index(p, text) {
                        index = j
                    },
                    _ => {},
                }
            }
            state += index * stride
            stride *= count
        }
        return state
    }

    // Where `text` is among property `p`'s values, as the property's `getValue` finds it: by
    // `Integer.parseInt` for an integer property, and by name for any other.
    fn value_index(self, p: usize, text: String) -> u32? {
        let count = self.property_values[p].len()
        if let low = self.int_starts[p] {
            let v = match parse_int(text, 10) {
                ok(v) => v,
                err(_) => return none,
            }
            if v < low or i64(v) - i64(low) >= i64.wrap(count) {
                return none
            }
            return some(u32.wrap(v - low))
        }
        for j in 0..count {
            if self.property_values[p][j] == text {
                return some(u32.wrap(j))
            }
        }
        return none
    }
}

// The least value of an integer property, whose values are integers counting up by one, as
// vanilla's `IntegerProperty` names them, or `none` for any other.
fn int_start(choices: List<String>) -> i32? {
    if choices.is_empty() {
        return none
    }
    let low = match parse_int(choices[0], 10) {
        ok(v) => v,
        err(_) => return none,
    }
    for j in 0..choices.len() {
        if choices[j] != "{i64(low) + i64.wrap(j)}" {
            return none
        }
    }
    return some(low)
}
