/// Containers' menus as their blocks open them (CAL-144): which menu a chest, a barrel, an ender
/// chest, a shulker box, a dispenser, a dropper or a hopper opens, of which type and with what
/// title, and the block entities it holds the slots of, a chest's two where it's half of a large
/// one, `DoubleBlockCombiner`; what they hold, read from and written to their block entities'
/// `Items`; and what opening and closing one does, `startOpen` and `stopOpen`. Chests', barrels'
/// and ender chests' `ContainerOpenersCounter` counts who has them open, with the sound as the
/// first opens and the last closes, a lid's block event, a barrel's `open`, a trapped chest's
/// neighbours told, and its recheck every 5 ticks while one's open, which counts again who has it
/// open and in reach. A shulker box counts its own, with its lid's block event and sound, and its
/// lid opens and closes over 10 ticks, telling the blocks around as it starts and stops.
///
/// What opening a container needs that Calcite doesn't have yet is said, and it isn't opened:
/// the loot a container makes as it's first opened, `unpackLootTable`, and a lock's key. The game
/// events and stats opening one sends, and the piglins it angers, wait for what hears and counts
/// them; a shulker box's lid pushing what's in its way waits for entities.
module world.containers

import chat.component.{Component}
import nbt.tag.{Tag}
import random.source.{RandomSource}
import world.block_level.{BlockLevel, SHULKER_CLOSED, SHULKER_CLOSING, SHULKER_OPENED, SHULKER_OPENING}
import world.collision.{Aabb}
import world.level_writer.{UPDATE_LIMIT}
import world.menu.{CHEST_MENU, DISPENSER_MENU, HOPPER_MENU, SHULKER_MENU}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, clockwise, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{facing_of}

/// A block entity whose slots a container's menu holds: where it is, how many slots it has, and
/// its number, `Openers.id`, as the menu opened on it.
pub struct Part {
    pub x: i32
    pub y: i32
    pub z: i32
    pub slots: usize
    pub id: u64 = 0
}

/// The menu a container's block opens: `world.menu`'s kind of menu; its type's name in the `menu`
/// registry, as `minecraft:generic_9x3`; its title; the block entities it holds the slots of, in
/// their order; whether it's the player's own ender chest, opened at `parts`' one ender chest;
/// and for a closed shulker box, the room its lid needs, which a block in it keeps it shut,
/// `ShulkerBoxBlock.canOpen`.
pub struct Opening {
    pub kind: i32
    pub menu_type: String
    pub title: Component
    pub parts: List<Part>
    pub ender: bool = false
    pub room: Aabb? = none
}

impl Opening {
    /// How many slots the container has: its block entities', or an ender chest's 27.
    pub fn slots(self) -> usize {
        if self.ender {
            return 27
        }
        var n: usize = 0
        for p in self.parts {
            n += p.slots
        }
        return n
    }
}

/// The menu the container block `state` at x, y, z opens as it's used, `useWithoutItem`, whose
/// use is `kind`'s, as `ChestBlock`; or as a spectator's used, where `spectator`,
/// `getMenuProvider`, which a spectator's opening doesn't count. `none` where it opens none: a
/// chest with a block that conducts redstone above it or its other half; an ender chest under
/// one, or for a spectator; and one whose loot is still to come, for a spectator. What opening it
/// needs that Calcite doesn't have yet is put in `missing`, and it opens none.
pub fn opening<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, kind: String, state: u32, x: i32, y: i32, z: i32, spectator: bool, missing: mut List<String>) -> Opening? ! Thrown {
    let block = f.block(state)
    if kind == "ChestBlock" {
        return try chest_opening(f, level, state, x, y, z, spectator, mut missing)
    }
    if kind == "EnderChestBlock" {
        if spectator or f.redstone_conductor(try level.state(f, x, y + 1, z)) {
            return none
        }
        return some(Opening { kind: CHEST_MENU, menu_type: String("minecraft:generic_9x3"), title: named("container.enderchest"), parts: [Part { x: x, y: y, z: z, slots: 27 }], ender: true })
    }
    let tags = own_tags(f, level, block, x, y, z)
    let entity = f.block_entity_kind(block) ?? String()
    var menu = CHEST_MENU
    var menu_type = String("minecraft:generic_9x3")
    var name = "container.barrel"
    var slots: usize = 27
    var room: Aabb? = none
    if kind == "ShulkerBoxBlock" {
        menu = SHULKER_MENU
        menu_type = String("minecraft:shulker_box")
        name = "container.shulkerBox"
        if not spectator and level.openers(x, y, z).status == SHULKER_CLOSED {
            room = some(lid_room(try facing_of(f, state), x, y, z))
        }
    } else if kind == "DispenserBlock" {
        menu = DISPENSER_MENU
        menu_type = String("minecraft:generic_3x3")
        name = if entity == "minecraft:dropper" { "container.dropper" } else { "container.dispenser" }
        slots = 9
    } else if kind == "HopperBlock" {
        menu = HOPPER_MENU
        menu_type = String("minecraft:hopper")
        name = "container.hopper"
        slots = 5
    } else if kind != "BarrelBlock" {
        return none
    }
    if not can_open(tags, spectator, mut missing) {
        return none
    }
    return some(Opening { kind: menu, menu_type: menu_type, title: title_of(tags, name), parts: [Part { x: x, y: y, z: z, slots: slots }], room: room })
}

// `ChestBlock.getMenuProvider`, `combine` with what blocks it, then `MENU_PROVIDER_COMBINER`: a
// large chest's six rows, its halves the right's first, named for the first's custom name, else
// the second's, else `container.chestDouble`, where both may be opened; else the chest's own
// three rows.
fn chest_opening<L: BlockAccess>(f: Facts, level: L, state: u32, x: i32, y: i32, z: i32, spectator: bool, missing: mut List<String>) -> Opening? ! Thrown {
    let halves = try chest_halves(f, level, state, x, y, z) else return none
    let block = f.block(state)
    if halves.len() == 1 {
        let tags = own_tags(f, level, block, x, y, z)
        if not can_open(tags, spectator, mut missing) {
            return none
        }
        return some(Opening { kind: CHEST_MENU, menu_type: String("minecraft:generic_9x3"), title: title_of(tags, "container.chest"), parts: [Part { x: x, y: y, z: z, slots: 27 }] })
    }
    let (fx, fy, fz) = halves[0]
    let (sx, sy, sz) = halves[1]
    let first = own_tags(f, level, block, fx, fy, fz)
    let second = own_tags(f, level, block, sx, sy, sz)
    let opens_first = can_open(first, spectator, mut missing)
    if not opens_first or not can_open(second, spectator, mut missing) {
        return none
    }
    var title = named("container.chestDouble")
    if first.contains("CustomName") {
        title = title_of(first, "container.chest")
    } else if second.contains("CustomName") {
        title = title_of(second, "container.chest")
    }
    return some(Opening { kind: CHEST_MENU, menu_type: String("minecraft:generic_9x6"), title: title, parts: [Part { x: fx, y: fy, z: fz, slots: 27 }, Part { x: sx, y: sy, z: sz, slots: 27 }] })
}

/// `ChestBlock.combine` of the chest `state` at x, y, z, not ignoring what blocks it,
/// `DoubleBlockCombiner.combineWithNeigbour`: `none` where it's blocked, a block that conducts
/// redstone above it, `isBlockedChestByBlock`, or above its other half; its two halves, the
/// right's first, where it's half of a large chest, the block beside it the way it joins of the
/// same block, facing the same way, the other half; else itself alone. A cat sitting on it,
/// `isCatSittingOnChest`, is an entity, which Calcite's level doesn't have yet.
pub fn chest_halves<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32) -> List<(i32, i32, i32)>? ! Thrown {
    if f.redstone_conductor(try r.state(f, x, y + 1, z)) {
        return none
    }
    let kind = f.get_name(state, String("type")) ?? String("single")
    if kind == "single" {
        return some([(x, y, z)])
    }
    let facing = try facing_of(f, state)
    let toward = if kind == "left" { clockwise(facing) } else { opposite(clockwise(facing)) }
    let (ox, oz) = (x + step_x(toward), z + step_z(toward))
    let other = try r.state(f, ox, y, oz)
    let other_kind = f.get_name(other, String("type")) ?? String("single")
    if f.block(other) == f.block(state) and other_kind != "single" and other_kind != kind and try facing_of(f, other) == facing {
        if f.redstone_conductor(try r.state(f, ox, y + 1, oz)) {
            return none
        }
        if kind == "right" {
            return some([(x, y, z), (ox, y, oz)])
        }
        return some([(ox, y, oz), (x, y, z)])
    }
    return some([(x, y, z)])
}

// `RandomizableContainerBlockEntity.canOpen` and what `createMenu` does before it opens: a lock's
// key, `LockCode.canUnlock`, which Calcite doesn't have yet; and a container whose loot is still
// to come, which no spectator opens, and which makes its loot as it's opened, `unpackLootTable`,
// which Calcite doesn't have yet either.
fn can_open(tags: JavaHashMap<String, Tag>, spectator: bool, missing: mut List<String>) -> bool {
    if tags.contains("LootTable") {
        if not spectator {
            missing.push(String("The loot a container makes as it's first opened, `unpackLootTable`"))
        }
        return false
    }
    if tags.contains("lock") {
        missing.push(String("A locked container's key, `LockCode.canUnlock`"))
        return false
    }
    return true
}

// `getDisplayName`: the block entity's `CustomName`, where it has one that reads, as
// `parseCustomNameSafe` reads it, else its default, `getDefaultName`.
fn title_of(tags: JavaHashMap<String, Tag>, fallback: str) -> Component {
    if tags.contains("CustomName") {
        match Component.from_nbt(tags["CustomName"].copy()) {
            ok(c) => return c,
            err(_) => {},
        }
    }
    return named(fallback)
}

fn named(key: str) -> Component {
    return Component.translatable(String(key), List<Component>())
}

// The block entity of `block` at x, y, z as it saves, a fresh one's where there's none of its
// type yet.
fn own_tags<R: BlockAccess>(f: Facts, r: R, block: u32, x: i32, y: i32, z: i32) -> JavaHashMap<String, Tag> {
    let saved = r.block_entity_tag(x, y, z) else return JavaHashMap<String, Tag>()
    let Tag.Compound(tags) = saved else return JavaHashMap<String, Tag>()
    let kind = f.block_entity_kind(block) else return JavaHashMap<String, Tag>()
    if not tags.contains("id") or tags["id"] != Tag.Str(kind) {
        return JavaHashMap<String, Tag>()
    }
    return tags
}

// `Shulker.getProgressDeltaAabb(1, facing, 0, 0.5, bottomCenter).deflate(1.0E-6)`: the half of
// the block the shulker box at x, y, z faces nearest it, which its lid opens into.
fn lid_room(facing: i32, x: i32, y: i32, z: i32) -> Aabb {
    let (bx, by, bz) = (f64(x), f64(y), f64(z))
    var b = Aabb { min_x: bx, min_y: by, min_z: bz, max_x: bx + 1.0, max_y: by + 1.0, max_z: bz + 1.0 }
    let (dx, dy, dz) = (step_x(facing), step_y(facing), step_z(facing))
    if dx > 0 {
        b.min_x = bx + 1.0
        b.max_x = bx + 1.5
    } else if dx < 0 {
        b.min_x = bx - 0.5
        b.max_x = bx
    }
    if dy > 0 {
        b.min_y = by + 1.0
        b.max_y = by + 1.5
    } else if dy < 0 {
        b.min_y = by - 0.5
        b.max_y = by
    }
    if dz > 0 {
        b.min_z = bz + 1.0
        b.max_z = bz + 1.5
    } else if dz < 0 {
        b.min_z = bz - 0.5
        b.max_z = bz
    }
    return b.deflate(1.0e-6)
}

/// What the container the menu `o` is of holds, slot by slot: each block entity's `Items`, as
/// `ContainerHelper.loadAllItems` reads them, each stack in its slot where that's one of the block
/// entity's, in the order of `o`'s block entities; for an ender chest, nothing, the player's own
/// being the network's.
pub fn items_of<R: BlockAccess>(r: R, o: Opening) -> List<Tag?> {
    var out = List<Tag?>()
    if o.ender {
        return out
    }
    for p in o.parts {
        for s in items_at(r, p.x, p.y, p.z, p.slots) {
            out.push(s.copy())
        }
    }
    return out
}

/// `ContainerHelper.loadAllItems` of the block entity at x, y, z: its `Items`, each stack in its
/// slot under `slots`, a later stack in place of an earlier.
pub fn items_at<R: BlockAccess>(r: R, x: i32, y: i32, z: i32, slots: usize) -> List<Tag?> {
    var out = List<Tag?>()
    for _ in 0..slots {
        out.push(none)
    }
    let saved = r.block_entity_tag(x, y, z) else return out
    let Tag.Compound(tags) = saved else return out
    if not tags.contains("Items") {
        return out
    }
    let Tag.List(list) = tags["Items"].copy() else return out
    for t in list {
        let Tag.Compound(m) = t else continue
        if not m.contains("Slot") {
            continue
        }
        let slot = match m["Slot"] {
            Tag.Byte(b) => i32(u8.wrap(b)),
            _ => continue,
        }
        if slot < 0 or usize.wrap(slot) >= slots {
            continue
        }
        var stack = m.copy()
        _ = stack.remove("Slot")
        out[usize.wrap(slot)] = some(Tag.Compound(stack))
    }
    return out
}

/// The container the menu `o` is of made to hold `items`, slot by slot, each block entity its
/// own, `ContainerHelper.saveAllItems`: `Items`, each stack with its `Slot`, empty or not, but a
/// shulker box's, which saves none where it holds nothing. An ender chest's are the network's.
pub fn put_items<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, o: Opening, items: List<Tag?>) ! Thrown {
    if o.ender {
        return
    }
    var at: usize = 0
    for p in o.parts {
        var list = List<Tag>()
        for i in 0..p.slots {
            if at + i < items.len() {
                if let stack = items[at + i].copy() {
                    if let Tag.Compound(m) = stack {
                        var slotted = JavaHashMap<String, Tag>()
                        slotted.insert(String("Slot"), Tag.Byte(i8.wrap(i32.wrap(i))))
                        for (k, v) in m {
                            slotted.insert(k.copy(), v.copy())
                        }
                        list.push(Tag.Compound(slotted))
                    }
                }
            }
        }
        at += p.slots
        let state = try level.state(f, p.x, p.y, p.z)
        let shulker = f.class_name(f.block(state)) == "ShulkerBoxBlock"
        if list.is_empty() and shulker {
            level.remove_block_entity_value(p.x, p.y, p.z, "Items")
        } else {
            level.set_block_entity_value(p.x, p.y, p.z, "Items", Tag.List(list))
        }
    }
}

/// `startOpen` of the container the menu `o` is of, for a player who isn't a spectator and
/// reaches `range` blocks, `getContainerInteractionRange`, as its menu's made: each of its block
/// entities', a large chest's halves' in turn; a dispenser's, a dropper's and a hopper's do
/// nothing.
pub fn start_open<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, o: Opening, range: f64) ! Thrown {
    for p in o.parts {
        let state = try level.state(f, p.x, p.y, p.z)
        let kind = f.block_entity_kind(f.block(state)) ?? String()
        if kind == "minecraft:shulker_box" {
            try shulker_opened(f, mut level, state, p.x, p.y, p.z, true)
        } else if counted(kind) {
            try increment(f, mut level, state, p.x, p.y, p.z, range)
        }
    }
}

/// `stopOpen` of the container the menu `o` is of, for a player who isn't a spectator, as its
/// menu's closed, `removed`.
pub fn stop_open<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, o: Opening) ! Thrown {
    for p in o.parts {
        let state = try level.state(f, p.x, p.y, p.z)
        let kind = f.block_entity_kind(f.block(state)) ?? String()
        if kind == "minecraft:shulker_box" {
            try shulker_opened(f, mut level, state, p.x, p.y, p.z, false)
        } else if counted(kind) {
            try decrement(f, mut level, state, p.x, p.y, p.z)
        }
    }
}

// Whether the block entity of the type `kind` counts who has it open with a
// `ContainerOpenersCounter`: a chest's, a trapped chest's, a barrel's and an ender chest's.
fn counted(kind: String) -> bool {
    return kind == "minecraft:chest" or kind == "minecraft:trapped_chest" or kind == "minecraft:barrel" or kind == "minecraft:ender_chest"
}

// `incrementOpeners`: one more has it open, the most any reaches kept; the first plays its
// opening, `onOpen`, and has it rechecked 5 ticks on; then `openerCountChanged`.
fn increment<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, range: f64) ! Thrown {
    var o = level.openers(x, y, z)
    let previous = o.count
    o.count += 1
    if range > o.range {
        o.range = range
    }
    level.set_openers(x, y, z, o)
    if previous == 0 {
        try opened(f, mut level, state, x, y, z, true)
        level.schedule_block(f.block(state), x, y, z, 5, 0)
    }
    try count_changed(f, mut level, state, x, y, z, previous, o.count)
}

// `decrementOpeners`: one fewer has it open; the last plays its closing, `onClose`, and the most
// any reaches goes back to none; then `openerCountChanged`.
fn decrement<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    var o = level.openers(x, y, z)
    let previous = o.count
    o.count -= 1
    if o.count == 0 {
        o.range = 0.0
    }
    level.set_openers(x, y, z, o)
    if o.count == 0 {
        try opened(f, mut level, state, x, y, z, false)
    }
    try count_changed(f, mut level, state, x, y, z, previous, o.count)
}

/// `ChestBlockEntity.recheckOpen`, `BarrelBlockEntity`'s and `EnderChestBlockEntity`'s, as the
/// container block `state` at x, y, z ticks: `recheckOpeners`, who has it open counted again,
/// those in reach of it by as far as any reached and 4 more, and the most any of them reaches;
/// its opening or closing played where that's come or gone; `openerCountChanged`, whether it
/// changed or not; and another recheck 5 ticks on while any has it open.
pub fn recheck<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let kind = f.block_entity_kind(f.block(state)) ?? String()
    if not counted(kind) or level.block_entity_tag(x, y, z) == none {
        return
    }
    var o = level.openers(x, y, z)
    let (found, most) = level.viewers(x, y, z, o.range + 4.0)
    let previous = o.count
    o.range = most
    o.count = found
    level.set_openers(x, y, z, o)
    if previous != found {
        if found != 0 and previous == 0 {
            try opened(f, mut level, state, x, y, z, true)
        } else if found == 0 {
            try opened(f, mut level, state, x, y, z, false)
        }
    }
    try count_changed(f, mut level, state, x, y, z, previous, found)
    if found > 0 {
        level.schedule_block(f.block(state), x, y, z, 5, 0)
    }
}

// `onOpen` and `onClose`, as `open` says: a chest's sound, a barrel's sound and its `open` set,
// and an ender chest's sound.
fn opened<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, open: bool) ! Thrown {
    let block = f.block(state)
    let kind = f.block_entity_kind(block) ?? String()
    if kind == "minecraft:barrel" {
        // `BarrelBlockEntity.playSound`, at its face, then `updateBlockState`, set with flags 3.
        let facing = try facing_of(f, state)
        let px = f64(x) + 0.5 + f64(step_x(facing)) / 2.0
        let py = f64(y) + 0.5 + f64(step_y(facing)) / 2.0
        let pz = f64(z) + 0.5 + f64(step_z(facing)) / 2.0
        let sound = if open { "block.barrel.open" } else { "block.barrel.close" }
        let pitch = level.next_float() * 0.1f32 + 0.9f32
        level.play_sound_at(px, py, pz, String(sound), 0.5f32, pitch)
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "open", open), 3, UPDATE_LIMIT)
        return
    }
    if kind == "minecraft:ender_chest" {
        let sound = if open { "block.ender_chest.open" } else { "block.ender_chest.close" }
        let pitch = level.next_float() * 0.1f32 + 0.9f32
        level.play_sound_at(f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, String(sound), 0.5f32, pitch)
        return
    }
    // `ChestBlockEntity.playSound`: none for a large chest's left half; its right half's between
    // the two.
    let half = 0.5
    let joined = f.get_name(state, String("type")) ?? String("single")
    if joined == "left" {
        return
    }
    var px = f64(x) + half
    var pz = f64(z) + half
    if joined == "right" {
        let toward = opposite(clockwise(try facing_of(f, state)))
        px += f64(step_x(toward)) * 0.5
        pz += f64(step_z(toward)) * 0.5
    }
    let pitch = level.next_float() * 0.1f32 + 0.9f32
    level.play_sound_at(px, f64(y) + 0.5, pz, chest_sound(f, block, open), 0.5f32, pitch)
}

// `ChestBlock.getOpenChestSound` and `getCloseChestSound`: a copper chest's hinge's, as weathered
// as it is, `CopperChestBlock.getHingeSound`, the waxed ones' as theirs; the others' a chest's.
fn chest_sound(f: Facts, block: u32, open: bool) -> String {
    let name = f.codec.blocks.name(block)
    let end = if open { "open" } else { "close" }
    if name.contains("copper_chest") {
        if name.contains("weathered") {
            return "block.copper_chest_weathered.{end}"
        }
        if name.contains("oxidized") {
            return "block.copper_chest_oxidized.{end}"
        }
        return "block.copper_chest.{end}"
    }
    return "block.chest.{end}"
}

// `openerCountChanged`: a chest's and an ender chest's lids' block event, 1 with how many have it
// open, `signalOpenCount`; and a trapped chest's, which then tells the blocks around it and those
// around the block under it, where the count changed. A barrel's does nothing.
fn count_changed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, previous: i32, current: i32) ! Thrown {
    let block = f.block(state)
    let kind = f.block_entity_kind(block) ?? String()
    if kind == "minecraft:barrel" {
        return
    }
    level.block_event(x, y, z, block, 1, current)
    if kind == "minecraft:trapped_chest" and previous != current {
        level.update_neighbours(x, y, z, block)
        level.update_neighbours(x, y - 1, z, block)
    }
}

// A shulker box's `startOpen`, where `open`, or `stopOpen`: its count one more, from none where
// it was under, or one fewer; its lid's block event, 1 with the count; and the first's opening
// sound, or the last's closing.
fn shulker_opened<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, open: bool) ! Thrown {
    var o = level.openers(x, y, z)
    if open {
        if o.count < 0 {
            o.count = 0
        }
        o.count += 1
    } else {
        o.count -= 1
    }
    level.set_openers(x, y, z, o)
    level.block_event(x, y, z, f.block(state), 1, o.count)
    if (open and o.count == 1) or (not open and o.count <= 0) {
        let sound = if open { "block.shulker_box.open" } else { "block.shulker_box.close" }
        let pitch = level.next_float() * 0.1f32 + 0.9f32
        level.play_sound_at(f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, String(sound), 0.5f32, pitch)
    }
}

/// `ShulkerBoxBlockEntity.triggerEvent` of the block event `b0`, `b1` on the shulker box at x, y,
/// z: 1 sets how many have it open, its lid closing at none and opening at one; whether it was
/// one.
pub fn shulker_event<L: BlockLevel>(level: mut L, x: i32, y: i32, z: i32, b0: i32, b1: i32) -> bool {
    if b0 != 1 {
        return false
    }
    var o = level.openers(x, y, z)
    o.count = b1
    if b1 == 0 {
        o.status = SHULKER_CLOSING
    }
    if b1 == 1 {
        o.status = SHULKER_OPENING
    }
    level.set_openers(x, y, z, o)
    return true
}

/// `ShulkerBoxBlockEntity.tick`, `updateAnimation`, of the shulker box `state` at x, y, z: its lid
/// a tenth further open while it opens, telling the blocks around as it starts and as it's open,
/// or a tenth less while it closes, the same as it starts and as it's shut. Where its lid opens
/// into a player, which it'd push, what's missing is said.
pub fn shulker_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    var o = level.openers(x, y, z)
    o.progress_old = o.progress
    let pushing = o.status == SHULKER_OPENING
    var updates = 0
    if o.status == SHULKER_CLOSED {
        o.progress = 0.0f32
    } else if o.status == SHULKER_OPENING {
        o.progress += 0.1f32
        if o.progress_old == 0.0f32 {
            updates += 1
        }
        if o.progress >= 1.0f32 {
            o.status = SHULKER_OPENED
            o.progress = 1.0f32
            updates += 1
        }
    } else if o.status == SHULKER_OPENED {
        o.progress = 1.0f32
    } else if o.status == SHULKER_CLOSING {
        o.progress -= 0.1f32
        if o.progress_old == 1.0f32 {
            updates += 1
        }
        if o.progress <= 0.0f32 {
            o.status = SHULKER_CLOSED
            o.progress = 0.0f32
            updates += 1
        }
    }
    let (from, to) = (o.progress_old, o.progress)
    level.set_openers(x, y, z, o)
    if pushing {
        let b = lid_sweep(try facing_of(f, state), x, y, z, from, to)
        if level.players_touching(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) > 0 {
            level.unimplemented(String("A shulker box's lid pushing what's in its way, `moveCollidedEntities`"))
        }
    }
    for _ in 0..updates {
        // `doNeighborUpdates`.
        level.neighbour_shapes(state, x, y, z, 3)
        level.update_neighbours(x, y, z, f.block(state))
    }
}

// `Shulker.getProgressDeltaAabb(1, facing, from, to, atBottomCenterOf(pos))`: what the lid of the
// shulker box at x, y, z sweeps through from `from` to `to`, as halves of its height.
fn lid_sweep(facing: i32, x: i32, y: i32, z: i32, from: f32, to: f32) -> Aabb {
    let most = f64(if from > to { from } else { to })
    let least = f64(if from < to { from } else { to })
    let (dx, dy, dz) = (f64(step_x(facing)), f64(step_y(facing)), f64(step_z(facing)))
    var b = Aabb { min_x: -0.5, min_y: 0.0, min_z: -0.5, max_x: 0.5, max_y: 1.0, max_z: 0.5 }
    // `expandTowards`, then `contract`.
    if dx > 0.0 { b.max_x += dx * most } else { b.min_x += dx * most }
    if dy > 0.0 { b.max_y += dy * most } else { b.min_y += dy * most }
    if dz > 0.0 { b.max_z += dz * most } else { b.min_z += dz * most }
    let (cx, cy, cz) = (-dx * (1.0 + least), -dy * (1.0 + least), -dz * (1.0 + least))
    if cx < 0.0 { b.min_x -= cx } else if cx > 0.0 { b.max_x -= cx }
    if cy < 0.0 { b.min_y -= cy } else if cy > 0.0 { b.max_y -= cy }
    if cz < 0.0 { b.min_z -= cz } else if cz > 0.0 { b.max_z -= cz }
    let (ox, oy, oz) = (f64(x) + 0.5, f64(y), f64(z) + 0.5)
    return Aabb { min_x: b.min_x + ox, min_y: b.min_y + oy, min_z: b.min_z + oz, max_x: b.max_x + ox, max_y: b.max_y + oy, max_z: b.max_z + oz }
}
