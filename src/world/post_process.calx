/// What a chunk's generation left to do as it comes to tick: vanilla's
/// `LevelChunk.postProcessGeneration` for each block the generator marked,
/// `markPosForPostprocessing`, which the chunk keeps until then (D329, CAL-91). A block holding a
/// fluid has its fluid tick at once; then a liquid's block has its own tick, and any other block
/// is made again from the blocks around it, `updateFromNeighbourShapes`.
module world.post_process

import random.source.{RandomSource}
import world.block_level.{BlockLevel}
import world.block_updates.{liquid_tick}
import world.flowing.{liquid_of, tick_fluid}
import world.level_writer.{UPDATE_LIMIT}
import worldgen.access.{BlockAccess}
import worldgen.facts.{EMPTY_FLUID}
import worldgen.interval.{Thrown}
import worldgen.shapes.{update_from_neighbours}
import worldgen.survive.{Env}

/// The flags `postProcessGeneration` sets a block with, 276: `UPDATE_INVISIBLE`,
/// `UPDATE_KNOWN_SHAPE` and `UPDATE_SKIP_BLOCK_ENTITY_SIDEEFFECTS`, so neither the players nor the
/// blocks around are told.
pub const POST_PROCESS_FLAGS: i32 = 276

/// The block at `x`, `y`, `z`, which the chunk's generation marked, done as
/// `postProcessGeneration` does it. If it holds a fluid, its tick runs at once, `FluidState.tick`.
/// Then a liquid's block has its own tick, `LiquidBlock.tick`, which changes only a source over a
/// block that makes a bubble column, making the column (D335). Any other block is updated from
/// those around it, `updateFromNeighbourShapes`, and set again if that changed it. Both read the
/// block as it was before its fluid ticked, as vanilla does.
pub fn post_process<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    let state = try level.state(f, x, y, z)
    let fluid = liquid_of(f, state).fluid
    if fluid != EMPTY_FLUID {
        try tick_fluid(e, mut level, fluid, x, y, z)
    }
    if f.is_a(f.block(state), "LiquidBlock") {
        try liquid_tick(f, mut level, state, x, y, z)
        return
    }
    let now = try update_from_neighbours(e, mut level, state, x, y, z)
    if now != state {
        _ = level.set_block_limited(x, y, z, now, POST_PROCESS_FLAGS, UPDATE_LIMIT)
    }
}
