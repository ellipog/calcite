/// The world's clocks, as vanilla's `ServerClockManager` keeps them, saved in
/// `data/minecraft/world_clocks.dat`, ticked once a server tick and sent to players (CAL-105).
///
/// Each clock in the `world_clock` registry, `minecraft:overworld` and `minecraft:the_end` in
/// vanilla's, has run some ticks, with a part of one, at a rate, unless it's paused. A tick, if
/// the `advance_time` game rule is on, adds each running clock's rate to its part of a tick, and
/// the whole ticks that makes to its ticks. A dimension's type names the clock its day goes by.
module world.clocks

import math.mth.{floor}
import nbt.tag.{Tag}
import protocol.play.{ClockUpdate}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// A clock, vanilla's `ServerClockInstance`.
pub struct Clock {
    /// Its name in `world_clock`, which it's saved by, and its ID there, which it's sent by.
    pub name: Identifier
    pub id: i32
    pub total_ticks: i64 = 0
    pub partial_tick: f32 = 0.0f32
    pub rate: f32 = 1.0f32
    pub paused: bool = false
}

/// The world's clocks, vanilla's `ServerClockManager`.
pub struct Clocks {
    /// One for each in `world_clock`, by ID.
    pub clocks: List<Clock>
    /// Whether they've changed since they were saved, as `setDirty` marks them.
    pub dirty: bool = false
}

/// A time marker, `ClockTimeMarker`: a tick of a clock's that a timeline names, such as
/// `minecraft:roll_village_siege`, once or every period of the timeline's (D314).
pub struct TimeMarker {
    pub name: Identifier
    /// The clock's ID in `world_clock`.
    pub clock: i32
    pub ticks: i32
    pub period: i32? = none
}

impl TimeMarker {
    /// Whether the clock's at it, having run `total` ticks, as `occursAt` says: at its tick, or
    /// with a period, where the ticks' remainder by the period is its tick, as Java's `%` gives
    /// the remainder, so never before 0.
    pub fn occurs_at(self, total: i64) -> bool {
        let p = self.period else return i64(self.ticks) == total
        return i64(self.ticks) == total % i64(p)
    }
}

/// The saved data type the clocks are saved as, `ServerClockManager.TYPE`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "world_clocks" }
}

impl Clocks {
    /// A new world's: each clock in `names`, the `world_clock` registry by ID, at 0, as `init`
    /// makes them before any are read.
    pub fn new(names: List<Identifier>) -> Clocks {
        var clocks = List<Clock>()
        for i in 0..names.len() {
            clocks.push(Clock { name: names[i].copy(), id: i32.wrap(i) })
        }
        return Clocks { clocks: clocks }
    }

    /// The clocks in `names`, with what the saved data's `root` holds for each, as
    /// `PackedClockStates.CODEC` reads it and `init` loads it, keeping what it could read, as
    /// `resultOrPartial` does. An entry that names no clock in the registry, or whose state isn't
    /// a map with a `total_ticks`, is left out; one with a field that's wrong is read with that
    /// field's default. Either way the entry goes in the error's missed input. The errors are
    /// joined as `unboundedMap` joins them, the last entry's first, and in each the state's
    /// before the name's.
    pub fn load(names: List<Identifier>, root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Clocks {
        var out = Clocks.new(names)
        if not root.contains("data") {
            lines.push(parse_failed(saved_id(), String("Not a map: null")))
            return out
        }
        let fields = match root["data"] {
            Tag.Compound(f) => f.copy(),
            _ => {
                lines.push(parse_failed(saved_id(), "Not a map: {root["data"].to_snbt()}"))
                return out
            },
        }
        var messages = List<String>()
        var missed = JavaHashMap<String, Tag>()
        var read = List<bool>()
        for _ in 0..out.clocks.len() {
            read.push(false)
        }
        for (key, value) in fields {
            let parsed = state_of(value)
            var clock: usize? = none
            for i in 0..out.clocks.len() {
                if out.clocks[i].name.to_string() == named(key) {
                    clock = some(i)
                }
            }
            var entry = List<String>()
            if not parsed.errors.is_empty() {
                entry.push(joined(parsed.errors))
            }
            match clock {
                some(i) => {
                    // `putIfAbsent`: a clock named twice, as `overworld` and
                    // `minecraft:overworld`, keeps the first. Vanilla's error for that names
                    // the holder with its identity hash, which nothing else can give, so it's
                    // left out.
                    if let s = parsed.state {
                        if not read[i] {
                            out.clocks[i].total_ticks = s.total_ticks
                            out.clocks[i].partial_tick = s.partial_tick
                            out.clocks[i].rate = s.rate
                            out.clocks[i].paused = s.paused
                            read[i] = true
                        }
                    }
                },
                none => entry.push("Failed to get element {named(key)} from registry minecraft:world_clock"),
            }
            if not entry.is_empty() {
                messages.insert(0, joined(entry))
                missed.insert(key.copy(), value.copy())
            }
        }
        if not messages.is_empty() {
            lines.push(parse_failed(saved_id(), "{joined(messages)} missed input: {Tag.Compound(missed).to_snbt()}"))
        }
        return out
    }

    /// The saved data's `data`, as `PackedClockStates.CODEC` writes it: each clock by its name,
    /// with `total_ticks` and whichever of the others aren't their defaults.
    pub fn pack(self) -> Tag {
        var fields = JavaHashMap<String, Tag>()
        for c in self.clocks {
            var state = JavaHashMap<String, Tag>()
            state.insert(String("total_ticks"), Tag.Long(c.total_ticks))
            if c.partial_tick.to_bits() != 0.0f32.to_bits() {
                state.insert(String("partial_tick"), Tag.float(c.partial_tick))
            }
            if c.rate.to_bits() != 1.0f32.to_bits() {
                state.insert(String("rate"), Tag.float(c.rate))
            }
            if c.paused {
                state.insert(String("paused"), Tag.Byte(1))
            }
            fields.insert(c.name.to_string(), Tag.Compound(state))
        }
        return Tag.Compound(fields)
    }

    /// A server tick of the clocks, as `ServerClockManager.tick` runs it: if `advance`, as the
    /// `advance_time` game rule says, each that's running moves on by its rate, and they're
    /// marked to be saved.
    pub fn tick(mut self, advance: bool) {
        if not advance {
            return
        }
        for i in 0..self.clocks.len() {
            if self.clocks[i].paused {
                continue
            }
            // `partialTick += rate`, `Mth.floor` of it, then `partialTick -= fullTicks`, the
            // whole ticks as a float.
            let partial = self.clocks[i].partial_tick + self.clocks[i].rate
            let whole = floor(f64(partial))
            self.clocks[i].partial_tick = partial - f32.nearest(whole)
            self.clocks[i].total_ticks += i64(whole)
        }
        self.dirty = true
    }

    /// The ticks the clock `id` has run, as `getInstance(clock).totalTicks()` gives them, or 0
    /// for none, as a dimension without a clock has it.
    pub fn total_ticks(self, id: i32?) -> i64 {
        let i = id else return 0
        for c in self.clocks {
            if c.id == i {
                return c.total_ticks
            }
        }
        return 0
    }

    /// Every clock as `createFullSyncPacket` sends them: a stopped one, or every one with
    /// `advance` off, at rate 0.
    pub fn updates(self, advance: bool) -> List<ClockUpdate> {
        var out = List<ClockUpdate>()
        for c in self.clocks {
            let stopped = c.paused or not advance
            out.push(ClockUpdate { clock: c.id, total_ticks: c.total_ticks, partial_tick: c.partial_tick, rate: if stopped { 0.0f32 } else { c.rate } })
        }
        return out
    }
}

// A clock's state, `ClockState`.
struct State {
    total_ticks: i64
    partial_tick: f32
    rate: f32
    paused: bool
}

// What `ClockState.CODEC` reads of a state: none if it isn't a map, or has no `total_ticks`
// that's a number, else the state, with the default of any other field that's wrong, and the
// errors, the last field's first, as its record codec joins them.
struct Parsed {
    state: State?
    errors: List<String>
}

fn state_of(value: Tag) -> Parsed {
    let fields = match value {
        Tag.Compound(f) => f.copy(),
        _ => return Parsed { state: none, errors: ["Not a map: {value.to_snbt()}"] },
    }
    var errors = List<String>()
    var total: i64? = none
    if not fields.contains("total_ticks") {
        errors.insert(0, "No key total_ticks in MapLike[{value.to_snbt()}]")
    } else if let t = fields["total_ticks"].number_long() {
        total = some(t)
    } else {
        errors.insert(0, String("Not a number"))
    }
    var partial = 0.0f32
    if fields.contains("partial_tick") {
        if let p = fields["partial_tick"].number_float() {
            partial = p
        } else {
            errors.insert(0, String("Not a number"))
        }
    }
    // `POSITIVE_FLOAT`: over 0 and at most the greatest float, so not -0, NaN or infinity.
    var rate = 1.0f32
    if fields.contains("rate") {
        if let r = fields["rate"].number_float() {
            if r > 0.0f32 and r <= f32.MAX {
                rate = r
            } else {
                errors.insert(0, "Value must be positive: {r}")
            }
        } else {
            errors.insert(0, String("Not a number"))
        }
    }
    var paused = false
    if fields.contains("paused") {
        if let p = fields["paused"].number_bool() {
            paused = p
        } else {
            errors.insert(0, String("Not a number"))
        }
    }
    let t = total else return Parsed { state: none, errors: errors }
    return Parsed { state: some(State { total_ticks: t, partial_tick: partial, rate: rate, paused: paused }), errors: errors }
}

// Errors joined as `DataResult` joins them.
fn joined(errors: List<String>) -> String {
    var message = String()
    for e in errors {
        if not message.is_empty() {
            message.push_str("; ")
        }
        message.push_str(e)
    }
    return message
}

// An `Identifier` as vanilla parses a clock's key, with `minecraft:` where it has none.
fn named(key: String) -> String {
    return if key.contains(":") { key.copy() } else { "minecraft:{key}" }
}
