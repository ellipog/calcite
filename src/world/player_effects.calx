/// A player's mob effects (D514), as `LivingEntity` keeps them for a `ServerPlayer`: read from and
/// saved to their data's `active_effects`; added, `addEffect`, merged into one of their kind as
/// `MobEffectInstance.update` merges them; ticked, `tickEffects`, each one's act,
/// `applyEffectTick`, then its count down; their kinds' attribute modifiers on their attributes
/// as they're added, changed and taken off, their health and absorption kept within their most,
/// `onAttributeUpdated`; and shown in their entity data, `updateDirtyEffects`, a spectator's
/// none and them invisible, `ServerPlayer.updateInvisibilityStatus`.
///
/// What their connection's to be told of, `ServerPlayer.onEffectAdded`, `onEffectUpdated` and
/// `onEffectsRemoved`, is kept in `told` in the order it happened, with the sound an effect's
/// adding makes, `MobEffect.onEffectAdded`, after its packet, and what Calcite doesn't do yet: the
/// caller sends it. An effect's hurt the caller deals, as it deals any of theirs.
module world.player_effects

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import world.attributes.{Attributes, Modifier}
import world.effects.{ABSORBS, ABSORPTION, ActiveEffect, BAD_OMEN, GLOWING, HARMS_NOW, HEALS, HEALS_NOW, HUNGER, INVISIBILITY, MAGIC_HURT, NO_HURT, PLAYERS, PLAYERS_AT_END, PLAYERS_NOW, POISONS, OOZING, WEAVING, WIND_CHARGED, WITHERS, WITHER_HURT, effect_names}
import world.entity_data.{ABSORPTION as ABSORPTION_AMOUNT, EFFECT_AMBIENCE, EFFECT_PARTICLES, EntityData, GLOWING_FLAG, HEALTH, INVISIBLE_FLAG, SHARED_FLAGS, Value}
import world.living.{LivingFacts, read_effects}
import world.player_status.{Status, heal, set_health}

/// What a player's effects did that their connection's told, in its order: an effect added, with
/// the packet's blend, `ClientboundUpdateMobEffectPacket`; one changed, without; one taken off,
/// by its kind's ID, `ClientboundRemoveMobEffectPacket`; the sound an effect makes as it's added,
/// heard by all near, by its name; and what's missing, to be said.
pub enum EffectEvent {
    Added(ActiveEffect)
    Updated(ActiveEffect)
    Removed(i32)
    Sound(String)
    Missing(String)
}

/// A player's effects, in the order they were added; whether they're to be shown again,
/// `effectsDirty`; and what their connection's to be told.
pub struct PlayerEffects {
    pub list: List<ActiveEffect> = List<ActiveEffect>()
    pub dirty: bool = false
    pub told: List<EffectEvent> = List<EffectEvent>()
}

impl PlayerEffects {
    /// Their effects as their saved data `d` holds them, `active_effects`, as
    /// `readAdditionalSaveData` reads them: none where one doesn't read, one of a kind in place of
    /// an earlier; to be shown where there are any. None for a player new to the world.
    pub fn read(d: JavaHashMap<String, Tag>?) -> PlayerEffects {
        var out = PlayerEffects()
        let saved = d else return out
        if saved.contains("active_effects") {
            out.list = read_effects(saved["active_effects"])
            out.dirty = not out.list.is_empty()
        }
        return out
    }

    /// Their effects into their saved data `d`, `active_effects`, as `addAdditionalSaveData`
    /// writes them where they have any; taken out where they have none.
    pub fn write(self, d: mut JavaHashMap<String, Tag>) {
        if self.list.is_empty() {
            _ = d.remove("active_effects")
            return
        }
        let names = effect_names()
        var saved = List<Tag>()
        for e in self.list {
            saved.push(e.saved(names))
        }
        d.insert(String("active_effects"), Tag.List(saved))
    }

    /// `hasEffect` of the kind `id`.
    pub fn has(self, id: i32) -> bool {
        return self.at(id) != none
    }

    /// Where their effect of the kind `id` is, none where they have none.
    pub fn at(self, id: i32) -> usize? {
        for i in 0..self.list.len() {
            if self.list[i].id == id {
                return some(i)
            }
        }
        return none
    }

    /// Their effect of the kind `id`'s amplifier, -1 where they have none.
    pub fn amplifier(self, id: i32) -> i32 {
        let i = self.at(id) else return -1
        return self.list[i].amplifier()
    }

    /// `addEffect` of `e`, which a player's type always lets them have: where they have none of
    /// its kind, put on, `onEffectAdded`, to be shown, its kind's modifiers on `attributes` at its
    /// level, told with the blend, and its sound where its kind makes one; else merged into the
    /// one they have, `update`, refreshed where that changed it, `onEffectUpdated`. Then its
    /// start, `onEffectStarted`: absorption's, their absorption in `data` at least 4 a level, no
    /// more than their most. Whether it changed.
    pub fn add(mut self, lf: LivingFacts, e: ActiveEffect, attributes: mut Attributes, data: mut EntityData) -> bool {
        var changed = false
        if let at = self.at(e.id) {
            if self.list[at].update(e.now) {
                self.updated(lf, at, true, mut attributes, mut data)
                changed = true
            }
        } else {
            self.list.push(e.copy())
            self.dirty = true
            modifiers_on(lf, mut attributes, e.id, e.amplifier())
            self.told.push(EffectEvent.Added(e.copy()))
            changed = true
            if let s = lf.effects[usize.wrap(e.id)].sound {
                self.told.push(EffectEvent.Sound(s.copy()))
            }
        }
        if e.id == ABSORPTION {
            let least = f32.nearest(4 * (1 + e.amplifier()))
            let most = f32.nearest(attributes.value(lf.max_absorption))
            let now = data.float(ABSORPTION_AMOUNT).max(least)
            data.set(ABSORPTION_AMOUNT, Value.Float(now.max(0.0f32).min(most)))
        }
        return changed
    }

    /// `tickServer` of their effect at `i` up to its act, `applyEffectTick`, `ticks` their own
    /// tick count, `invulnerable` whether their abilities make them so: false where it has no
    /// time left; else where its kind acts now, `shouldApplyEffectTickThisTick` of its time left,
    /// or of their ticks where it lasts for ever, its act: regeneration's heal of 1 below their
    /// most and instant health's of 4 doubled each level, which it does; absorption's end once
    /// their absorption's gone; hunger's exhaustion, 0.005 a level, unless they're invulnerable,
    /// `causeFoodExhaustion`; saturation's food, a point a level, as eating gives it,
    /// `FoodData.eat`; bad omen's raid omen in a village, and the raid omen's raid as it ends,
    /// which come with raids, said to be missing; and the hurts of poison while they have more
    /// than 1, of wither and of instant damage, 6 doubled each level, which it gives back,
    /// `MAGIC_HURT` or `WITHER_HURT` and the amount, for the caller to deal.
    pub fn act(mut self, lf: LivingFacts, i: usize, attributes: Attributes, data: mut EntityData, status: mut Status, ticks: i32, invulnerable: bool, spectator: bool) -> (bool, i32, f32) {
        let e = self.list[i].copy()
        if not e.remaining() {
            return (false, NO_HURT, 0.0f32)
        }
        let amp = e.amplifier()
        let count = if e.now.infinite() { ticks } else { e.duration() }
        let at = usize.wrap(e.id)
        if not lf.effects[at].should_tick(count, amp) {
            return (true, NO_HURT, 0.0f32)
        }
        let most = f32.nearest(attributes.value(lf.max_health))
        let health = data.float(HEALTH)
        let kind = lf.effects[at].ticks
        if kind == HEALS {
            if health < most {
                heal(mut data, 1.0f32, most)
            }
        } else if kind == POISONS {
            if health > 1.0f32 {
                return (true, MAGIC_HURT, 1.0f32)
            }
        } else if kind == WITHERS {
            return (true, WITHER_HURT, 1.0f32)
        } else if kind == HEALS_NOW {
            heal(mut data, f32.nearest((4 << (amp & 31)).max(0)), most)
        } else if kind == HARMS_NOW {
            return (true, MAGIC_HURT, f32.nearest(6 << (amp & 31)))
        } else if kind == ABSORBS {
            return (data.float(ABSORPTION_AMOUNT) > 0.0f32, NO_HURT, 0.0f32)
        } else if kind == PLAYERS {
            if e.id == HUNGER {
                if not invulnerable {
                    status.exhaust(0.005f32 * f32.nearest(amp + 1))
                }
            } else if e.id == BAD_OMEN and not spectator {
                self.told.push(EffectEvent.Missing(String("Bad omen's raid omen in a village, which comes with raids")))
            }
        } else if kind == PLAYERS_NOW {
            status.eat(amp + 1, 1.0f32)
        } else if kind == PLAYERS_AT_END {
            if not spectator {
                self.told.push(EffectEvent.Missing(String("The raid omen's raid as it ends, which comes with raids")))
            }
        }
        return (true, NO_HURT, 0.0f32)
    }

    /// The rest of `tickServer` and `tickEffects` for their effect at `i`, `kept` its act's
    /// answer: where it's kept, a tick less of it, and where it ran out, the one it hid in its
    /// place, refreshed, `onEffectUpdated`; then taken off where that leaves it no time,
    /// `onEffectsRemoved`, or told again where what's left is a whole number of 30 seconds,
    /// `onEffectUpdated` without its attributes. Whether it's still on, at `i`.
    pub fn end(mut self, lf: LivingFacts, i: usize, kept: bool, attributes: mut Attributes, data: mut EntityData) -> bool {
        var on = kept
        if on {
            if self.list[i].tick_down() {
                self.updated(lf, i, true, mut attributes, mut data)
            }
            on = self.list[i].remaining()
        }
        if not on {
            let e = self.list.remove(i)
            self.removed(lf, e.id, mut attributes, mut data)
            return false
        }
        if self.list[i].duration() % 600 == 0 {
            self.updated(lf, i, false, mut attributes, mut data)
        }
        return true
    }

    /// `triggerOnDeathMobEffects` as they're taken out of their level dead: their effects gone,
    /// as `activeEffects.clear()` takes them, without a word to their connection; what the
    /// oozing, weaving and wind charged effects do then said to be missing.
    pub fn cleared(mut self) {
        for e in self.list {
            if e.id == OOZING or e.id == WEAVING or e.id == WIND_CHARGED {
                self.told.push(EffectEvent.Missing(String("What the oozing, weaving and wind charged effects do as a player dies")))
                break
            }
        }
        self.list.clear()
    }

    /// `updateDirtyEffects`, as their values are to be sent, `updateDataBeforeSync`: where their
    /// effects changed, `updateInvisibilityStatus`, a spectator's particles none and them
    /// invisible; else with none their particles none and them visible, else invisible where they
    /// have invisibility and their particles those of their effects that show them, `ambient`
    /// where all those are; and glowing where they have the glowing effect or were saved glowing,
    /// `glowing_tag`, `isCurrentlyGlowing`.
    pub fn update_dirty(mut self, lf: LivingFacts, data: mut EntityData, spectator: bool, glowing_tag: bool) {
        if not self.dirty {
            return
        }
        if spectator or self.list.is_empty() {
            data.set(EFFECT_PARTICLES, Value.Particles(List<(i32, i32?)>()))
            data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, spectator)
        } else {
            data.set_flag(SHARED_FLAGS, INVISIBLE_FLAG, self.has(INVISIBILITY))
            var shown = List<(i32, i32?)>()
            var ambient = true
            for e in self.list {
                if e.now.visible {
                    shown.push(lf.effects[usize.wrap(e.id)].particle_of(e.now.ambient))
                    if not e.now.ambient {
                        ambient = false
                    }
                }
            }
            data.set(EFFECT_PARTICLES, Value.Particles(shown))
            data.set(EFFECT_AMBIENCE, Value.Bool(ambient))
        }
        let glowing = self.has(GLOWING) or glowing_tag
        if (i32(data.byte(SHARED_FLAGS)) & GLOWING_FLAG != 0) != glowing {
            data.set_flag(SHARED_FLAGS, GLOWING_FLAG, glowing)
        }
        self.dirty = false
    }

    // `onEffectUpdated` of their effect at `i`: to be shown, and where `refresh`, its kind's
    // modifiers put on again at its level and their health and absorption kept within their most;
    // then told, without the blend.
    fn updated(mut self, lf: LivingFacts, i: usize, refresh: bool, attributes: mut Attributes, data: mut EntityData) {
        self.dirty = true
        if refresh {
            let id = self.list[i].id
            let amp = self.list[i].amplifier()
            modifiers_off(lf, mut attributes, id)
            modifiers_on(lf, mut attributes, id, amp)
            keep_health(lf, attributes, mut data)
        }
        self.told.push(EffectEvent.Updated(self.list[i].copy()))
    }

    // `onEffectsRemoved` of an effect of the kind `id`: to be shown, its kind's modifiers taken
    // off and their health and absorption kept within their most; then told.
    fn removed(mut self, lf: LivingFacts, id: i32, attributes: mut Attributes, data: mut EntityData) {
        self.dirty = true
        modifiers_off(lf, mut attributes, id)
        keep_health(lf, attributes, mut data)
        self.told.push(EffectEvent.Removed(id))
    }
}

// `addAttributeModifiers` of the kind `id` at `amplifier`: its modifier, where it has one, on its
// attribute's instance, in place of any with its ID, permanent and its amount as much again for
// each level, `AttributeTemplate.create`.
fn modifiers_on(lf: LivingFacts, attributes: mut Attributes, id: i32, amplifier: i32) {
    let m = lf.effects[usize.wrap(id)].modifier else return
    let (a, path, amount, operation) = m
    attributes.take_off(a, Identifier { namespace: "minecraft", path: path.copy() })
    attributes.add_permanent(a, Modifier.named(path.copy(), amount * f64(amplifier + 1), operation))
}

// `removeAttributeModifiers` of the kind `id`: its modifier off its attribute's instance.
fn modifiers_off(lf: LivingFacts, attributes: mut Attributes, id: i32) {
    let m = lf.effects[usize.wrap(id)].modifier else return
    let (a, path, _, _) = m
    attributes.take_off(a, Identifier { namespace: "minecraft", path: path.copy() })
}

// `refreshDirtyAttributes`' `onAttributeUpdated`: their health no more than their most, and their
// absorption no more than its.
fn keep_health(lf: LivingFacts, attributes: Attributes, data: mut EntityData) {
    let most = f32.nearest(attributes.value(lf.max_health))
    if data.float(HEALTH) > most {
        set_health(mut data, most, most)
    }
    let most_absorption = f32.nearest(attributes.value(lf.max_absorption))
    if data.float(ABSORPTION_AMOUNT) > most_absorption {
        data.set(ABSORPTION_AMOUNT, Value.Float(most_absorption.max(0.0f32)))
    }
}
