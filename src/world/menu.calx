/// The inventory menu, as vanilla's `InventoryMenu` and the `AbstractContainerMenu` under it run
/// it for a player: what a click does to its 46 slots and to the stack the cursor carries, as
/// `doClick` does it, and what the server knows of the client's slots, as
/// `RemoteSlot.Synchronized` knows it, the stack the server last sent or the hash of the one the
/// client says it has, so only what the client hasn't got is sent again. Each stack is as
/// `ItemStack.CODEC` writes it, or nothing, as `world.inventory` keeps them (CAL-136).
///
/// A container's menu runs the same way over the container's slots and then the player's 36
/// (CAL-144): a chest's, a barrel's or an ender chest's, `ChestMenu`; a shulker box's,
/// `ShulkerBoxMenu`, whose slots take no shulker box; a dispenser's or a dropper's,
/// `DispenserMenu`; and a hopper's, `HopperMenu`, each with its own shift-click. What the click
/// does to the container is `Effect.Changed`, its `setChanged`, for the network to save and tell
/// the comparators by it.
///
/// The crafting grids, the inventory menu's 2 by 2 and a crafting table's 3 by 3, `CraftingMenu`,
/// whose container is its result and its grid, which the menu holds itself, make their result
/// as they change, `Effect.Grid`, against the recipes `Slots` has, as `world.crafting` matches
/// them; taking it uses the grid up, and a shift-click crafts for as long as the grid makes the
/// same (CAL-147).
///
/// What the player throws out as an item, a stack dropped outside the menu or by `THROW`, is
/// `Effect.Thrown`, and what doesn't fit back in the inventory `Effect.Dropped`, for the server
/// to drop as item entities (CAL-148). A bundle's own clicks, `overrideStackedOnOther`, wait for
/// bundles.
module world.menu

import nbt.tag.{Tag}
import protocol.wire.{DecodeError, Reader}
import registry.codec.{same}
import registry.components.{ItemCodecs}
import world.anvil.{Anvil, remove_component}
import world.enchanting_table.{enchantable}
import world.smithing.{smithing_find, smithing_made}
import world.grindstone.{grind_experience, grind_result, grindable, set_component}
import world.crafting.{Input, crafting_index, find as find_crafting, made_by, matches_recipe, remaining as left_in_grid}
import world.inventory.{Inventory, MENU_SLOTS}
import world.recipes.{Placing, Recipes}
import world.stacked.{Stacked}

/// `ContainerInput`'s IDs: what kind of click it is.
pub const PICKUP: i32 = 0
pub const QUICK_MOVE: i32 = 1
pub const SWAP: i32 = 2
pub const CLONE: i32 = 3
pub const THROW: i32 = 4
pub const QUICK_CRAFT: i32 = 5
pub const PICKUP_ALL: i32 = 6

/// `AbstractContainerMenu.SLOT_CLICKED_OUTSIDE`: a click outside the menu.
pub const OUTSIDE: i32 = -999

/// What kind of menu it is, by its slots and its shift-click (CAL-144): the player's inventory
/// menu, `InventoryMenu`; a chest's, a barrel's or an ender chest's, `ChestMenu`; a shulker box's,
/// `ShulkerBoxMenu`; a dispenser's or a dropper's, `DispenserMenu`; a hopper's, `HopperMenu`; and
/// a crafting table's, `CraftingMenu`, its container its result then its 3 by 3 grid (CAL-147);
/// a merchant's, `MerchantMenu`, its container its two payments then what the trade gives
/// (CAL-160); and a beacon's, `BeaconMenu`, its container its payment (D521).
pub const INVENTORY_MENU: i32 = 0
pub const CHEST_MENU: i32 = 1
pub const SHULKER_MENU: i32 = 2
pub const DISPENSER_MENU: i32 = 3
pub const HOPPER_MENU: i32 = 4
pub const CRAFTING_MENU: i32 = 5
pub const MERCHANT_MENU: i32 = 6
pub const BEACON_MENU: i32 = 7
/// A horse's inventory, `HorseInventoryMenu` (CAL-179): its saddle, its body armor, then a chest's
/// slots where it has one, then the player's.
pub const HORSE_MENU: i32 = 8
/// A furnace's, a blast furnace's or a smoker's, `AbstractFurnaceMenu` (CAL-336): its input, its
/// fuel, then its result, then the player's.
pub const FURNACE_MENU: i32 = 9
/// A brewing stand's, `BrewingStandMenu` (CAL-337): its three bottles, its reagent, its fuel, then
/// the player's.
pub const BREWING_MENU: i32 = 10
/// A stonecutter's, `StonecutterMenu` (CAL-338): its input, its result, then the player's.
pub const STONECUTTER_MENU: i32 = 11
/// A grindstone's, `GrindstoneMenu` (CAL-338): its two inputs, its result, then the player's.
pub const GRINDSTONE_MENU: i32 = 12
/// An enchanting table's, `EnchantmentMenu` (CAL-338): what's enchanted, its lapis, then the
/// player's.
pub const ENCHANTMENT_MENU: i32 = 13
/// An anvil's, `AnvilMenu` (CAL-338): its input, what's added to it and its result, then the
/// player's.
pub const ANVIL_MENU: i32 = 14
/// A smithing table's, `SmithingMenu` (CAL-338): its template, base, addition and result, then the
/// player's.
pub const SMITHING_MENU: i32 = 15
/// A loom's, `LoomMenu` (CAL-338): its banner, dye, pattern and result, then the player's.
pub const LOOM_MENU: i32 = 16
/// A crafter's, `CrafterMenu` (CAL-338): its block entity's 9 slots, the player's, then its result
/// last, slot 45, which can't be touched.
pub const CRAFTER_MENU: i32 = 17
/// A cartography table's, `CartographyTableMenu` (CAL-338): its map, what's added to it and its result,
/// then the player's.
pub const CARTOGRAPHY_MENU: i32 = 18

/// Whether a menu of the kind `kind` holds its container's slots itself, as no block entity does:
/// a crafting table's (CAL-147), a merchant's (CAL-160), a beacon's (D521), and a horse's, kept
/// as what it wears is after each click (CAL-179), and a stonecutter's, a grindstone's, an
/// enchanting table's, an anvil's, a smithing table's, a loom's and a cartography table's (CAL-338).
pub fn holds_own(kind: i32) -> bool {
    return kind == CRAFTING_MENU or kind == MERCHANT_MENU or kind == BEACON_MENU or kind == HORSE_MENU or kind == STONECUTTER_MENU or kind == GRINDSTONE_MENU or kind == ENCHANTMENT_MENU or kind == ANVIL_MENU or kind == SMITHING_MENU or kind == LOOM_MENU or kind == CARTOGRAPHY_MENU
}

/// What a horse's menu's slots take (CAL-179): whether it may use its saddle slot and its body's,
/// `canUseSlot`, and its type, by its name, which an equippable may allow, `canBeEquippedBy`.
pub struct Mount {
    pub saddle: bool
    pub body: bool
    pub entity: String
}

/// The slots a click sees (CAL-144): the player's inventory, and for a container's menu what
/// the container holds, its slots first, then the inventory's 27 and its hotbar's 9, as
/// `addStandardInventorySlots` adds them, the inventory menu's 9 to 44.
pub struct Slots {
    pub inv: Inventory
    pub container: List<Tag?> = List<Tag?>()
    pub kind: i32 = INVENTORY_MENU
    /// The recipes a crafting grid is matched against as it changes, none for a world without
    /// them, whose grids make nothing (CAL-147).
    pub recipes: Shared<Recipes>? = none
    /// A merchant's menu's (CAL-160): the merchant's offers, each as `MerchantOffer.CODEC` writes
    /// it, which a trade uses one of up; the trade its client picked, `selectionHint`; and the
    /// offer its payments buy, `activeOffer`, by their places among the offers, -1 for none.
    pub offers: List<Tag> = List<Tag>()
    pub hint: i32 = 0
    pub active: i32 = -1
    /// A beacon's menu's (D521): the items its payment slot takes, `#beacon_payment_items`, by
    /// their names.
    pub payments: List<String> = List<String>()
    /// A crafting grid's (CAL-164): the recipe that last made its result, `recipeUsed`, by its
    /// place among the world's, which isn't let go where nothing's made.
    pub used: usize? = none
    /// The result slot's `removeCount` (CAL-164): how many it's given since its crafted
    /// statistic was last counted, which each take counts, so it's none again once a click's
    /// done.
    pub removes: i32 = 0
    /// A horse's menu's (CAL-179): what its saddle and body armor slots take.
    pub mount: Mount? = none
    /// A furnace's menu's (CAL-336): the recipe property set its input takes from a shift-click,
    /// `acceptedInputs`, by its path, as `furnace_input`.
    pub inputs: String = String()
    /// A stonecutter's menu's (CAL-338): the recipe picked among its input's, `selectedRecipeIndex`,
    /// -1 for none, 0 as it opens, a `DataSlot.standalone`'s; and the item its input was of as
    /// it last changed, `input`.
    pub selected: i32 = 0
    pub cut: String = "minecraft:air"
    /// Whether the menu broadcast its changes during a click, `broadcastChanges` with remote
    /// updates held, which tells its listeners of each slot then, before any's sent: a
    /// stonecutter's `setupResultSlot` and shift-click, a grindstone's `createResult` (CAL-338).
    pub broadcast: bool = false
    /// An anvil's menu's name typed, cost and what taking its result takes (CAL-338).
    pub anvil: Anvil = Anvil()
    /// A loom's menu's patterns to pick from, `selectablePatterns`, by their names; the one picked
    /// is `selected` (CAL-338).
    pub patterns: List<String> = List<String>()
    /// The maps there's data for, by their IDs, with their scales and whether they're locked, for a
    /// cartography table's and a crafting grid's results; the next map ID, `getFreeMapId`; and
    /// the maps a result taken made, each its ID, its source's and whether it's locked, else
    /// scaled, for the network to make (CAL-338).
    pub map_facts: List<(i32, i32, bool)> = List<(i32, i32, bool)>()
    pub next_map: i32 = 0
    pub made_maps: List<(i32, i32, bool)> = List<(i32, i32, bool)>()
    /// A crafter's menu's disabled slots, and what its grid would make, its result slot's, which
    /// `server.network` makes as it lends the slots (CAL-338).
    pub disabled: List<i32> = List<i32>()
    pub crafted: Tag? = none
    /// Whether a crafting table's menu is placing a recipe from the recipe book, while which its
    /// grid tells it nothing, `placingRecipe` (CAL-339).
    pub placing: bool = false
}

impl Slots {
    /// How many slots the menu has: the inventory menu's 46, or the container's and the
    /// player's 36.
    pub fn count(self) -> usize {
        if self.kind == INVENTORY_MENU {
            return MENU_SLOTS
        }
        // A crafter's result, after the player's (CAL-338).
        if self.kind == CRAFTER_MENU {
            return self.container.len() + 37
        }
        return self.container.len() + 36
    }
}

// `HashedPatchMap.STREAM_CODEC`'s most components set and taken away.
const MAX_HASHED: i32 = 256

/// A stack as the client says it has it, vanilla's `HashedStack`: its item, its count, and each
/// component its patch sets, by its type, with its value's hash, as `HashOps.CRC32C_INSTANCE`
/// hashes it, and each type its patch takes away. Made with `HashedStack()`, it's
/// `HashedStack.EMPTY`.
pub struct HashedStack {
    /// The item's network ID, `none` for nothing.
    pub item: i32? = none
    pub count: i32 = 0
    /// Each component type the patch sets, by its network ID, and in `hashes`, its value's hash.
    pub types: List<i32> = List<i32>()
    pub hashes: List<i32> = List<i32>()
    /// Each component type the patch takes away.
    pub removed: List<i32> = List<i32>()
}

impl HashedStack {
    /// `HashedStack.STREAM_CODEC`: whether there's a stack, then its item, its count, and its
    /// `HashedPatchMap`, the types it sets with their hashes, then those it takes away, at most
    /// 256 of each, read into a hash map and a hash set, so a type given twice is there once, the
    /// later hash in place of the earlier. `items` and `types` are how many items and component
    /// types there are: an ID past them throws, as `byIdOrThrow` does.
    pub fn read(rd: mut Reader, items: usize, types: usize) -> HashedStack ! DecodeError {
        if not try rd.bool() {
            return HashedStack()
        }
        let item = try rd.varint()
        try known(item, items)
        let count = try rd.varint()
        var h = HashedStack { item: some(item), count: count }
        let given = try hashed_count(mut rd)
        for _ in 0..given {
            let t = try rd.varint()
            try known(t, types)
            let hash = try rd.i32()
            var found = false
            for i in 0..h.types.len() {
                if h.types[i] == t {
                    h.hashes[i] = hash
                    found = true
                }
            }
            if not found {
                h.types.push(t)
                h.hashes.push(hash)
            }
        }
        let taken = try hashed_count(mut rd)
        for _ in 0..taken {
            let t = try rd.varint()
            try known(t, types)
            if not has_i32(h.removed, t) {
                h.removed.push(t)
            }
        }
        return h
    }

    /// `matches`: whether `stack` is the stack this says, its count, its item and its patch, the
    /// same types taken away and each component set hashing the same, with `items`' codecs.
    pub fn matches(self, stack: Tag?, items: ItemCodecs) -> bool {
        let want = self.item else return stack == none
        var item = items.builtin_id("item", String("minecraft:air")) ?? 0
        var count = 0
        var patch = JavaHashMap<String, Tag>()
        if let t = stack {
            let Tag.Compound(m) = t else return false
            item = match m["id"] {
                Tag.Str(s) => items.builtin_id("item", s.copy()) ?? -1,
                _ => -1,
            }
            count = count_of(stack)
            if m.contains("components") {
                match m["components"] {
                    Tag.Compound(p) => patch = p.copy(),
                    _ => {},
                }
            }
        }
        if self.count != count or want != item {
            return false
        }
        var removed: usize = 0
        var added: usize = 0
        for (k, _) in patch {
            if k.starts_with("!") {
                let t = items.builtin_id("data_component_type", k[1..].copy()) else return false
                if not has_i32(self.removed, t) {
                    return false
                }
                removed += 1
            } else {
                added += 1
            }
        }
        if removed != self.removed.len() or added != self.types.len() {
            return false
        }
        for (k, v) in patch {
            if k.starts_with("!") {
                continue
            }
            let t = items.builtin_id("data_component_type", k.copy()) else return false
            var expected: i32? = none
            for i in 0..self.types.len() {
                if self.types[i] == t {
                    expected = some(self.hashes[i])
                }
            }
            let e = expected else return false
            if items.component_hash(k.copy(), v) != e {
                return false
            }
        }
        return true
    }
}

/// What the server knows of one of the client's slots, or of what its cursor carries, as
/// `RemoteSlot.Synchronized` knows it.
pub enum Remote {
    /// Nothing yet, which matches no stack.
    Unknown
    /// `force`: the stack the server sent, or nothing.
    Sent(Tag?)
    /// `receive`: the hash of the stack the client says it has.
    Hashed(HashedStack)
}

/// What a click or a close does beyond the menu's slots, in the order it happens, for the
/// network to carry out.
pub enum Effect {
    /// The crafting grid of the menu of the kind given, the inventory menu's or a crafting
    /// table's, changed, so `slotChangedCraftingGrid` set the result to this, which it takes as
    /// the client's and sends, slot 0, with that menu's next state ID (CAL-147).
    Grid(i32, Tag?)
    /// `onEquipItem`: the equipment slot, by its codec's name, the stack that was there and the
    /// one put there, for the equip sound.
    Equip(String, Tag?, Tag?)
    /// `placeItemBackInInventory` put some of a stack in the inventory's slot, by the
    /// inventory's own index, which is sent as `ClientboundSetPlayerInventoryPacket` with what
    /// the slot has once it's there.
    Placed(usize, Tag?)
    /// A stack dropped from the player's hand, `drop(stack, false)`, as an item entity
    /// (CAL-148), and whether it's the server's alone, `Prediction.SERVER_ONLY`, as what a menu
    /// gives back as it closes is, whose swing they're sent too (D521).
    Dropped(Tag, bool)
    /// A stack the player threw, `drop(stack, true)`, which keeps them as its thrower.
    Thrown(Tag)
    /// The container's `setChanged`, as a slot of it is set, taken from or clicked (CAL-144).
    Changed
    /// What a merchant's payments buy made again, `notifyTradeUpdated`, and whether they buy
    /// anything, which the merchant says yes or no to (CAL-160).
    TradeUpdated(bool)
    /// A merchant's offer, by its place among them, traded, `notifyTrade` (CAL-160).
    Traded(i32)
    /// The recipe that made the crafting grid's result, by its place among the world's, used as
    /// the result's taken, `awardUsedRecipes`, with the grid's stacks as they were, `getItems`
    /// (CAL-164).
    Crafted(usize, List<Tag?>)
    /// `ItemStack.onCraftedBy`, as a result's taken: the item, by its name, crafted as many
    /// times as the result slot says it gave, its `removeCount`, which its crafted statistic
    /// counts (CAL-164). What a merchant's trade gives counts even none.
    Made(String, i32)
    /// A furnace's input slot set, `AbstractFurnaceBlockEntity.setItem` of slot 0, from the
    /// stack there to the one given, for its cooking to start again where it's another (CAL-336).
    Input(Tag?, Tag?)
    /// A furnace's result taken, `awardUsedRecipesAndPopExperience`: the recipes it's used
    /// given to the player, with their experience, and forgotten (CAL-336).
    Cooked
    /// A brewing stand's bottle taken, `PotionSlot.onTake`, the stack as it was taken, for
    /// `BREWED_POTION` where it has `potion_contents` (CAL-337).
    Brewed(Tag?)
    /// A stonecutter's result taken, for its sound, `ui.stonecutter.take_result`, once a game
    /// tick, `lastSoundTime` (CAL-338).
    Cut
    /// A grindstone's result taken, `onTake` (CAL-338): its experience, before it's halved and
    /// drawn, `getExperienceAmount`, awarded where it is, then level event 1042.
    Ground(i32)
    /// An enchanting table's slots changed, `slotsChanged` (CAL-338): its offers made again from
    /// what's in it, the bookshelves around it and the player's enchantment seed.
    Enchanting
    /// An anvil's inputs changed, `slotsChanged`'s `createResult` (CAL-338): its result and cost
    /// made again from them, with the name typed.
    Anvil
    /// An anvil's result taken for so many levels, `AnvilMenu.onTake` (CAL-338): the levels taken
    /// unless the player has infinite materials, the anvil maybe damaged, and its sound.
    Anviled(i32)
    /// A smithing table's result taken, `SmithingMenu.onTake`'s level event 1044 (CAL-338).
    Smithed
    /// A loom's result taken, `ui.loom.take_result` unless it's been played this game tick
    /// (CAL-338).
    Woven
    /// A cartography table's result taken, `ui.cartography_table.take_result` unless it's been
    /// played this game tick (CAL-338).
    Charted
}

/// What a click needs of the player clicking.
pub struct Clicker {
    /// `hasInfiniteMaterials`, as creative mode has.
    pub infinite: bool = false
    /// `isCreative`.
    pub creative: bool = false
    /// The hotbar slot they hold, which a stack put back in the inventory goes to first.
    pub selected: i32 = 0
    /// Their experience level, which an anvil's result asks for (CAL-338).
    pub levels: i32 = 0
}

/// A menu's state beyond its slots, which `world.inventory` and the container keep: the
/// inventory menu's, made with `Menu()`, or a container's, made with `Menu.of` (CAL-144).
pub struct Menu {
    /// The stack the cursor carries, `getCarried`.
    pub carried: Tag? = none
    /// How many slots it has.
    size: usize = MENU_SLOTS
    remote: List<Remote> = List<Remote>()
    /// The cursor's, `none` for `Remote.Unknown`.
    remote_carried: Remote? = none
    /// Whether the client has been sent the whole menu, before which there's no client to send
    /// changes to, as there's no `synchronizer`.
    synced: bool = false
    /// `suppressRemoteUpdates`, which a click holds while it's handled, and which stays where
    /// the click throws, until the next click resumes it.
    suppressed: bool = false
    quickcraft_status: i32 = 0
    quickcraft_type: i32 = -1
    quickcraft_slots: List<usize> = List<usize>()
    /// What `triggerSlotListeners` last saw in each slot, `lastSlots`: nothing in each of a new
    /// menu's (CAL-164).
    last: List<Tag?> = List<Tag?>()
    /// The recipe that last made its crafting grid's result, `ResultContainer.recipeUsed`, by its
    /// place among the world's, which a click's `Slots` are lent (CAL-164).
    pub used: usize? = none
}

impl Menu {
    /// A container's menu of `size` slots, the container's and the player's 36, with nothing
    /// carried and nothing sent (CAL-144).
    pub fn of(size: usize) -> Menu {
        return Menu { size: size }
    }

    /// How many slots it has.
    pub fn slots(self) -> usize {
        return self.size
    }

    /// `sendAllDataToRemote`, as far as the client goes: it's sent every slot of `s` and what
    /// the cursor carries, which the server takes as the client's.
    pub fn sent_all(mut self, s: Slots) {
        self.remote = List<Remote>()
        for n in 0..self.size {
            self.remote.push(Remote.Sent(get(s, n)))
        }
        self.remote_carried = some(Remote.Sent(self.carried.copy()))
        self.synced = true
    }

    /// `setRemoteSlot`: the client has `stack` in slot `n`, as the server sent it or put it.
    pub fn set_remote(mut self, n: usize, stack: Tag?) {
        self.fill_remote()
        if n < self.size {
            self.remote[n] = Remote.Sent(stack.copy())
        }
    }

    /// `setRemoteSlotUnsafe`: the client says slot `n` has the stack `h` hashes, where `n` is one.
    pub fn receive(mut self, n: i32, h: HashedStack) {
        self.fill_remote()
        if n >= 0 and usize.wrap(n) < self.size {
            self.remote[usize.wrap(n)] = Remote.Hashed(h.copy())
        }
    }

    /// `transferState` into the inventory menu from `other`, a container's menu, as it's closed
    /// (CAL-144): what the server knows of the client's slots of the player's inventory, the
    /// container's menu's 36 from `first`, taken for the inventory menu's 9 to 44; a crafter's
    /// result is after them (CAL-338).
    pub fn transfer_from(mut self, other: Menu, first: usize) {
        self.fill_remote()
        if other.size < first + 36 or other.remote.len() < other.size {
            return
        }
        let offset = first
        for i in 0usize..36 {
            self.remote[9 + i] = other.remote[offset + i].copy()
        }
    }

    /// `setRemoteCarried`: the client says its cursor carries the stack `h` hashes.
    pub fn receive_carried(mut self, h: HashedStack) {
        self.remote_carried = some(Remote.Hashed(h.copy()))
    }

    /// `suppressRemoteUpdates`.
    pub fn suppress(mut self) {
        self.suppressed = true
    }

    /// `resumeRemoteUpdates`.
    pub fn resume(mut self) {
        self.suppressed = false
    }

    /// `broadcastChanges`, as far as the client goes: each slot of `s` the client hasn't got,
    /// then what the cursor carries, by slot, -1 for the cursor, with the stack, which the
    /// server sends and from then takes as the client's. Nothing while remote updates are held.
    pub fn changes(mut self, s: Slots, items: ItemCodecs) -> List<(i32, Tag?)> {
        var out = List<(i32, Tag?)>()
        if self.suppressed or not self.synced {
            return out
        }
        self.fill_remote()
        for n in 0..self.size {
            let current = get(s, n)
            let state = knows(self.remote[n], current, items)
            if state == NO {
                self.remote[n] = Remote.Sent(current.copy())
                out.push((i32.wrap(n), current))
            } else if state == LEARNED {
                self.remote[n] = Remote.Sent(current)
            }
        }
        let carried = self.carried.copy()
        let state = match self.remote_carried {
            some(r) => knows(r, carried, items),
            none => NO,
        }
        if state == NO {
            self.remote_carried = some(Remote.Sent(carried.copy()))
            out.push((-1, carried))
        } else if state == LEARNED {
            self.remote_carried = some(Remote.Sent(carried))
        }
        return out
    }

    /// A new listener, as a new menu's, `lastSlots` nothing in each slot, as a player made again by
    /// a respawn gets with their new inventory menu (CAL-164).
    pub fn new_listener(mut self) {
        self.last = List<Tag?>()
    }

    /// `triggerSlotListeners` of slot `n`, which holds `current`: whether it's changed since it
    /// was last seen, as `ItemStack.matches` tells, from then seen as it is (CAL-164).
    pub fn listen(mut self, n: usize, current: Tag?) -> bool {
        while self.last.len() < self.size {
            self.last.push(none)
        }
        if n >= self.size or same_stack(self.last[n].copy(), current.copy()) {
            return false
        }
        self.last[n] = current.copy()
        return true
    }

    /// `synchronizeSlotToRemote` of slot `n`, which holds `current`: whether the client hasn't
    /// got it, so it's sent and from then taken as the client's. Never while remote updates are
    /// held or before the client's been sent the whole menu.
    pub fn sync_slot(mut self, n: usize, current: Tag?, items: ItemCodecs) -> bool {
        if self.suppressed or not self.synced or n >= self.size {
            return false
        }
        self.fill_remote()
        let state = knows(self.remote[n], current, items)
        if state == NO {
            self.remote[n] = Remote.Sent(current.copy())
            return true
        }
        if state == LEARNED {
            self.remote[n] = Remote.Sent(current.copy())
        }
        return false
    }

    /// `synchronizeCarriedToRemote`: whether the client hasn't got what the cursor carries, so
    /// it's sent and from then taken as the client's.
    pub fn sync_carried(mut self, items: ItemCodecs) -> bool {
        if self.suppressed or not self.synced {
            return false
        }
        let carried = self.carried.copy()
        let state = match self.remote_carried {
            some(r) => knows(r, carried, items),
            none => NO,
        }
        if state == NO {
            self.remote_carried = some(Remote.Sent(carried.copy()))
            return true
        }
        if state == LEARNED {
            self.remote_carried = some(Remote.Sent(carried))
        }
        return false
    }

    /// `clicked`: what the client's click on slot `slot` with `button`, of the kind `input`,
    /// does to the slots `s` and the cursor, as `doClick` does it, with what else it does in `fx`.
    /// `false` where vanilla throws, as it does for a swap or a drag onto a slot under 0, having
    /// changed nothing. `slot` is one `isValidSlotIndex` lets through.
    pub fn click(mut self, s: mut Slots, items: ItemCodecs, who: Clicker, slot: i32, button: i32, input: i32, fx: mut List<Effect>) -> bool {
        if input == QUICK_CRAFT {
            let expected = self.quickcraft_status
            self.quickcraft_status = button & 3
            if (expected != 1 or self.quickcraft_status != 2) and expected != self.quickcraft_status {
                self.reset_quickcraft()
            } else if self.carried == none {
                self.reset_quickcraft()
            } else if self.quickcraft_status == 0 {
                self.quickcraft_type = (button >> 2) & 3
                if self.quickcraft_type == 0 or self.quickcraft_type == 1 or (self.quickcraft_type == 2 and who.infinite) {
                    self.quickcraft_status = 1
                    self.quickcraft_slots = List<usize>()
                } else {
                    self.reset_quickcraft()
                }
            } else if self.quickcraft_status == 1 {
                if slot < 0 {
                    return false
                }
                let n = usize.wrap(slot)
                let c = self.carried.copy() ?? Tag.End
                if quick_replaces(get(s, n), c, items) and may_place(s, n, c, items) and (self.quickcraft_type == 2 or count_of(self.carried) > i32.wrap(self.quickcraft_slots.len())) {
                    if not has_usize(self.quickcraft_slots, n) {
                        self.quickcraft_slots.push(n)
                    }
                }
            } else if self.quickcraft_status == 2 {
                if not self.quickcraft_slots.is_empty() {
                    if self.quickcraft_slots.len() == 1 {
                        let only = self.quickcraft_slots[0]
                        let kind = self.quickcraft_type
                        self.reset_quickcraft()
                        return self.click(mut s, items, who, i32.wrap(only), kind, PICKUP, mut fx)
                    }
                    let source = self.carried.copy() ?? Tag.End
                    var remaining = count_of(self.carried)
                    let size = i32.wrap(self.quickcraft_slots.len())
                    for n in self.quickcraft_slots.copy() {
                        if quick_replaces(get(s, n), source, items) and may_place(s, n, source, items) and (self.quickcraft_type == 2 or count_of(self.carried) >= size) {
                            let carry = count_of(get(s, n))
                            let max = min(items.max_stack_size(source), max_for(s, n, source, items))
                            let placed = min(place_count(size, self.quickcraft_type, source, items) + carry, max)
                            remaining -= placed - carry
                            let was = get(s, n)
                            set_by_player(mut s, n, with_count(source, placed), was, items, mut fx)
                        }
                    }
                    self.carried = with_count(source, remaining)
                }
                self.reset_quickcraft()
            } else {
                self.reset_quickcraft()
            }
            return true
        }
        if self.quickcraft_status != 0 {
            self.reset_quickcraft()
            return true
        }
        if (input == PICKUP or input == QUICK_MOVE) and (button == 0 or button == 1) {
            let primary = button == 0
            if slot == OUTSIDE {
                // The cursor's stack, or one of it, thrown out as an item.
                if let c = self.carried.copy() {
                    if primary {
                        fx.push(Effect.Thrown(c))
                        self.carried = none
                    } else {
                        let one = with_count(c, 1) ?? Tag.End
                        fx.push(Effect.Thrown(one))
                        self.carried = with_count(c, count_of(self.carried) - 1)
                    }
                }
                return true
            }
            if slot < 0 {
                return true
            }
            let n = usize.wrap(slot)
            if input == QUICK_MOVE {
                if not may_pickup(s, n, items, who) {
                    return true
                }
                var clicked = quick_move(mut s, n, items, who, mut fx)
                while clicked != none and same_item(get(s, n), clicked) {
                    clicked = quick_move(mut s, n, items, who, mut fx)
                }
                return true
            }
            let clicked = get(s, n)
            let carried = self.carried.copy()
            if clicked == none {
                if let c = carried {
                    let amount = if primary { count_of(carried) } else { 1 }
                    self.carried = safe_insert(mut s, n, c, amount, items, mut fx)
                }
            } else if may_pickup(s, n, items, who) {
                match carried {
                    none => {
                        let amount = if primary { count_of(clicked) } else { (count_of(clicked) + 1) / 2 }
                        if let taken = try_remove(mut s, n, amount, i32.MAX, items, who, mut fx) {
                            self.carried = some(taken.copy())
                            on_take(mut s, n, items, who, some(taken), mut fx)
                        }
                    },
                    some(c) => {
                        if may_place(s, n, c, items) {
                            if same_components(clicked, carried) {
                                let amount = if primary { count_of(carried) } else { 1 }
                                self.carried = safe_insert(mut s, n, c, amount, items, mut fx)
                            } else if count_of(carried) <= max_for(s, n, c, items) {
                                self.carried = clicked.copy()
                                set_by_player(mut s, n, carried, clicked, items, mut fx)
                            }
                        } else if same_components(clicked, carried) {
                            let room = items.max_stack_size(c) - count_of(carried)
                            if let taken = try_remove(mut s, n, count_of(clicked), room, items, who, mut fx) {
                                self.carried = with_count(c, count_of(carried) + count_of(some(taken.copy())))
                                on_take(mut s, n, items, who, some(taken), mut fx)
                            }
                        }
                    },
                }
            }
            // `slot.setChanged`, whatever the click did.
            changed(mut s, n, items, mut fx)
            return true
        }
        if input == SWAP and ((button >= 0 and button < 9) or button == 40) {
            if slot < 0 {
                return false
            }
            let n = usize.wrap(slot)
            // The inventory's own slot the key is for, `inventory.getItem(buttonNum)`.
            let from = menu_of(usize.wrap(button))
            let source = s.inv.menu_slot(from)
            let target = get(s, n)
            if source == none and target == none {
                return true
            }
            if source == none {
                if may_pickup(s, n, items, who) {
                    // A result's made as it's crafted, `onTake`'s `onCraftedBy` (CAL-338).
                    let placed = if crafts_maps(s, n) { post_processed(mut s, target.copy(), items) } else { target.copy() }
                    s.inv.set_menu_slot(from, placed)
                    // `ResultSlot.onSwapCraft` counts the whole of a crafting result.
                    if is_result(s, n) and s.kind != MERCHANT_MENU and s.kind != FURNACE_MENU and s.kind != STONECUTTER_MENU and s.kind != GRINDSTONE_MENU and s.kind != ANVIL_MENU and s.kind != SMITHING_MENU {
                        s.removes += count_of(target.copy())
                    }
                    let was = get(s, n)
                    set_by_player(mut s, n, none, was, items, mut fx)
                    on_take(mut s, n, items, who, target, mut fx)
                }
            } else if target == none {
                let t = source.copy() ?? Tag.End
                if may_place(s, n, t, items) {
                    let max = max_for(s, n, t, items)
                    if count_of(source) > max {
                        s.inv.set_menu_slot(from, with_count(t, count_of(source) - max))
                        set_by_player(mut s, n, with_count(t, max), none, items, mut fx)
                    } else {
                        s.inv.set_menu_slot(from, none)
                        set_by_player(mut s, n, source, none, items, mut fx)
                    }
                }
            } else {
                let t = source.copy() ?? Tag.End
                if may_pickup(s, n, items, who) and may_place(s, n, t, items) {
                    let max = max_for(s, n, t, items)
                    if count_of(source) > max {
                        s.inv.set_menu_slot(from, with_count(t, count_of(source) - max))
                        set_by_player(mut s, n, with_count(t, max), target, items, mut fx)
                        let back = target.copy() ?? Tag.End
                        if let left = none_added(add(mut s.inv, -1, back, items, who), back) {
                            fx.push(Effect.Thrown(left))
                        }
                    } else {
                        s.inv.set_menu_slot(from, target.copy())
                        set_by_player(mut s, n, source, target, items, mut fx)
                    }
                }
            }
            return true
        }
        if input == CLONE and who.infinite and self.carried == none and slot >= 0 {
            let n = usize.wrap(slot)
            if let here = get(s, n) {
                // `safeClone`, which a result makes as it's crafted (CAL-338).
                let cloned = with_count(here, items.max_stack_size(here))
                self.carried = if crafts_maps(s, n) { post_processed(mut s, cloned, items) } else { cloned }
            }
            return true
        }
        if input == THROW {
            // One of the slot's stack, or all of it, thrown out as an item, `safeTake`n; all of
            // it again for as long as the slot holds the same item, as a crafting result does.
            if self.carried != none or slot < 0 {
                return true
            }
            let n = usize.wrap(slot)
            let amount = if button == 0 { 1 } else { count_of(get(s, n)) }
            var thrown = safe_take(mut s, n, amount, items, who, mut fx)
            if let t = thrown.copy() {
                fx.push(Effect.Thrown(t))
            }
            if button == 1 {
                while thrown != none and same_item(get(s, n), thrown) {
                    thrown = safe_take(mut s, n, amount, items, who, mut fx)
                    if let t = thrown.copy() {
                        fx.push(Effect.Thrown(t))
                    }
                }
            }
            return true
        }
        if input == PICKUP_ALL and slot >= 0 {
            let n = usize.wrap(slot)
            let c0 = self.carried.copy() else return true
            if get(s, n) != none and may_pickup(s, n, items, who) {
                return true
            }
            let total = s.count()
            let start = if button == 0 { 0 } else { i32.wrap(total) - 1 }
            let step = if button == 0 { 1 } else { -1 }
            let max = items.max_stack_size(c0)
            for pass in 0..2 {
                var i = start
                while i >= 0 and i < i32.wrap(total) and count_of(self.carried) < max {
                    let m = usize.wrap(i)
                    let here = get(s, m)
                    // `canTakeItemForPickAll`: not from a crafting result, nor anywhere in a
                    // merchant's menu (CAL-160); a furnace's result as any slot (CAL-336), and a
                    // grindstone's (CAL-338), but not a cartography table's result.
                    let takes = (s.kind == FURNACE_MENU or s.kind == GRINDSTONE_MENU or s.kind == ANVIL_MENU or not is_result(s, m)) and s.kind != MERCHANT_MENU and not (s.kind == CARTOGRAPHY_MENU and m == 2)
                    if here != none and takes and quick_replaces(here, c0, items) and may_pickup(s, m, items, who) {
                        let h = here.copy() ?? Tag.End
                        if pass != 0 or count_of(here) != items.max_stack_size(h) {
                            let room = max - count_of(self.carried)
                            // `safeTake`: `tryRemove`, then the slot's `onTake`, which only a
                            // furnace's result here does anything with (CAL-336).
                            if let taken = try_remove(mut s, m, count_of(here), room, items, who, mut fx) {
                                self.carried = with_count(c0, count_of(self.carried) + count_of(some(taken.copy())))
                                on_take(mut s, m, items, who, some(taken), mut fx)
                            }
                        }
                    }
                    i += step
                }
            }
            return true
        }
        return true
    }

    /// `removed`, as the player closes the menu: what the cursor carries put back in the
    /// inventory, as `placeItemBackInInventory` puts it, then for the inventory menu, as
    /// `InventoryMenu.removed` does, or a crafting table's, as `CraftingMenu.removed` does, each
    /// stack in the crafting grid, or for a merchant's, as `MerchantMenu.removed` does, its two
    /// payments, with what that sends in `fx` (CAL-160). A container's `stopOpen` is the
    /// network's, and so's the merchant's trading player let go.
    pub fn close(mut self, s: mut Slots, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) {
        if let c = self.carried.take() {
            place_back(mut s.inv, c, items, who, mut fx)
        }
        if s.kind == MERCHANT_MENU {
            for slot in 0usize..2 {
                // `removeItemNoUpdate`.
                let here = get(s, slot)
                put(mut s, slot, none)
                if let stack = here {
                    place_back(mut s.inv, stack, items, who, mut fx)
                }
            }
            return
        }
        if s.kind == BEACON_MENU {
            // `BeaconMenu.removed`: its payment taken and dropped, `drop(stack, false)` (D521).
            let here = get(s, 0)
            put(mut s, 0, none)
            if let stack = here {
                fx.push(Effect.Dropped(stack, true))
            }
            return
        }
        if s.kind == CARTOGRAPHY_MENU {
            // `CartographyTableMenu.removed` (CAL-338): its result gone, `removeItemNoUpdate`, then
            // its map and what's added put back, `clearContainer`.
            put(mut s, 2, none)
            for slot in 0usize..2 {
                let here = get(s, slot)
                put(mut s, slot, none)
                if let stack = here {
                    place_back(mut s.inv, stack, items, who, mut fx)
                }
            }
            return
        }
        if s.kind == GRINDSTONE_MENU or s.kind == ENCHANTMENT_MENU or s.kind == ANVIL_MENU or s.kind == SMITHING_MENU or s.kind == LOOM_MENU {
            // `GrindstoneMenu.removed`, `EnchantmentMenu.removed` and `ItemCombinerMenu.removed`
            // (CAL-338): its inputs, two or a smithing table's or a loom's three, put back,
            // `clearContainer`.
            let inputs: usize = if s.kind == SMITHING_MENU or s.kind == LOOM_MENU { 3 } else { 2 }
            for slot in 0usize..inputs {
                let here = get(s, slot)
                put(mut s, slot, none)
                if let stack = here {
                    place_back(mut s.inv, stack, items, who, mut fx)
                }
            }
            return
        }
        if s.kind == STONECUTTER_MENU {
            // `StonecutterMenu.removed` (CAL-338): its result gone, `removeItemNoUpdate`, then its
            // input put back, `clearContainer`.
            put(mut s, 1, none)
            let here = get(s, 0)
            put(mut s, 0, none)
            if let stack = here {
                place_back(mut s.inv, stack, items, who, mut fx)
            }
            return
        }
        if s.kind != INVENTORY_MENU and s.kind != CRAFTING_MENU {
            return
        }
        // `resultSlots.clearContent`, which sends nothing; a crafting table's goes with its menu.
        put(mut s, 0, none)
        let (first, width, height) = grid_shape(s)
        for slot in first..first + width * height {
            // `removeItemNoUpdate`, which doesn't tell the menu.
            let here = get(s, slot)
            put(mut s, slot, none)
            if let stack = here {
                place_back(mut s.inv, stack, items, who, mut fx)
            }
        }
    }

    fn reset_quickcraft(mut self) {
        self.quickcraft_status = 0
        self.quickcraft_slots = List<usize>()
    }

    fn fill_remote(mut self) {
        while self.remote.len() < self.size {
            self.remote.push(Remote.Unknown)
        }
    }
}

// What `knows` finds: the remote slot doesn't match; it does; or it does by the hash the client
// sent, so the server now has the stack.
const NO: i32 = 0
const YES: i32 = 1
const LEARNED: i32 = 2

/// `setByPlayer` on the inventory menu's slot `n`, as a creative player's slot is set: `stack`
/// put there, its grid matched against `recipes`, with what that does in `fx`.
pub fn put_by_player(inv: mut Inventory, recipes: Shared<Recipes>?, n: usize, stack: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    var s = Slots { inv: inv.copy(), recipes: recipes.copy() }
    let was = get(s, n)
    set_by_player(mut s, n, stack, was, items, mut fx)
    inv = s.inv
}

/// `InventoryMenu.slotsChanged` of the inventory `inv` (CAL-255): what its crafting grid makes
/// made again, its result, and sent, `Effect.Grid`.
pub fn inventory_slots_changed(inv: mut Inventory, recipes: Shared<Recipes>?, items: ItemCodecs, fx: mut List<Effect>) {
    var s = Slots { inv: inv.copy(), recipes: recipes.copy() }
    craft(mut s, items, mut fx)
    inv = s.inv
}

/// `MerchantContainer.updateSellItem` of a merchant's menu's slots `s` (CAL-160): no offer the
/// payments buy, then, with the first payment, or the second where the first's empty, and the
/// other, nothing given where there's neither; else, where the merchant has offers, the offer
/// they buy, the picked one where it isn't the first, `getRecipeFor`, else the other way
/// round where none is or it's out of stock, given where it's in stock, `assemble`, else nothing.
/// Then, but where there was neither, the merchant's told, `notifyTradeUpdated`.
pub fn update_sell(s: mut Slots, items: ItemCodecs, fx: mut List<Effect>) {
    s.active = -1
    var a = get(s, 0)
    var b = get(s, 1)
    if a == none {
        a = b.copy()
        b = none
    }
    if a == none {
        put(mut s, 2, none)
        return
    }
    if not s.offers.is_empty() {
        var o = recipe_for(s, a.copy(), b.copy(), items)
        if o < 0 or out_of_stock(s.offers[usize.wrap(o)]) {
            s.active = o
            o = recipe_for(s, b, a, items)
        }
        if o >= 0 and not out_of_stock(s.offers[usize.wrap(o)]) {
            s.active = o
            let given = sold(s.offers[usize.wrap(o)])
            put(mut s, 2, some(given))
        } else {
            put(mut s, 2, none)
        }
    }
    fx.push(Effect.TradeUpdated(get(s, 2) != none))
}

/// `ServerboundSelectTradePacket` in a merchant's menu, the offer at `index` picked (CAL-160):
/// `setSelectionHint`, what the payments buy made again; then `tryMoveItems`: where it's an
/// offer, each payment moved back into the player's slots from the hotbar's last, stopping where
/// one won't move at all, then, where both are empty, the offer's costs filled from the player's
/// slots, `moveFromInventoryToPaymentSlot`.
pub fn select_trade(s: mut Slots, index: i32, items: ItemCodecs, fx: mut List<Effect>) {
    s.hint = index
    update_sell(mut s, items, mut fx)
    if index < 0 or usize.wrap(index) >= s.offers.len() {
        return
    }
    for slot in 0usize..2 {
        let here = get(s, slot) else continue
        var stack: Tag? = some(here)
        if not move_to(mut s, mut stack, 3, 39, true, items, mut fx) {
            return
        }
        // `tradeContainer.setItem`.
        put(mut s, slot, stack)
        update_sell(mut s, items, mut fx)
    }
    if get(s, 0) == none and get(s, 1) == none {
        let offer = compound(s.offers[usize.wrap(index)])
        fill_payment(mut s, 0, field(offer, "buy"), items, mut fx)
        if offer.contains("buyB") {
            fill_payment(mut s, 1, field(offer, "buyB"), items, mut fx)
        }
    }
}

// `MerchantMenu.moveFromInventoryToPaymentSlot`: each of the player's stacks the cost takes moved
// onto the payment, where it's empty or the same, as many as it holds, each move set,
// `setItem`, till it's full.
fn fill_payment(s: mut Slots, slot: usize, cost: Tag, items: ItemCodecs, fx: mut List<Effect>) {
    for i in 3usize..39 {
        let have = get(s, i) else continue
        if not cost_takes(cost, have, items) {
            continue
        }
        let paid = get(s, slot)
        if paid != none and not same_components(some(have.copy()), paid.copy()) {
            continue
        }
        let max = items.max_stack_size(have)
        let moving = min(max - count_of(paid), count_of(some(have.copy())))
        let now = with_count(have, count_of(paid) + moving)
        // `shrink`, which tells no one.
        put(mut s, i, with_count(have, count_of(some(have.copy())) - moving))
        put(mut s, slot, now.copy())
        update_sell(mut s, items, mut fx)
        if count_of(now) >= max {
            break
        }
    }
}

// `MerchantResultSlot.onTake`, as what the trade gives is taken: where its payments buy an offer,
// paid for either way round, `MerchantOffer.take`, the merchant told, `notifyTrade`, the offer's
// uses up one, and each payment set again, `setItem`, what they buy made again each time. The
// player's trade statistic, `TRADED_WITH_VILLAGER`, comes with the trade's (CAL-164).
fn merchant_take(s: mut Slots, items: ItemCodecs, fx: mut List<Effect>) {
    if s.active < 0 or usize.wrap(s.active) >= s.offers.len() {
        return
    }
    let at = usize.wrap(s.active)
    let (a, b) = (get(s, 0), get(s, 1))
    var paid: (Tag?, Tag?)? = none
    if let (x, y) = paid_with(s.offers[at], a.copy(), b.copy(), items) {
        paid = some((x, y))
    } else if let (x, y) = paid_with(s.offers[at], b, a, items) {
        paid = some((y, x))
    }
    let (left_a, left_b) = paid else return
    fx.push(Effect.Traded(s.active))
    s.offers[at] = used(s.offers[at])
    put(mut s, 0, left_a)
    update_sell(mut s, items, mut fx)
    put(mut s, 1, left_b)
    update_sell(mut s, items, mut fx)
}

// `MerchantOffers.getRecipeFor`: the picked offer, where it isn't the first and is among them,
// if `a` and `b` buy it; else the first they buy; -1 for none.
fn recipe_for(s: Slots, a: Tag?, b: Tag?, items: ItemCodecs) -> i32 {
    if s.hint > 0 and usize.wrap(s.hint) < s.offers.len() {
        return if satisfied_by(s.offers[usize.wrap(s.hint)], a, b, items) { s.hint } else { -1 }
    }
    for i in 0..s.offers.len() {
        if satisfied_by(s.offers[i], a.copy(), b.copy(), items) {
            return i32.wrap(i)
        }
    }
    return -1
}

// `MerchantOffer.satisfiedBy`: `a` the first cost's, as many as its price, and `b` the second
// cost's, as many as it, or nothing where there's no second.
fn satisfied_by(offer: Tag, a: Tag?, b: Tag?, items: ItemCodecs) -> bool {
    let m = compound(offer)
    let buy = field(m, "buy")
    let first = a else return false
    if not cost_takes(buy, first, items) or count_of(some(first.copy())) < price(m, buy, items) {
        return false
    }
    if not m.contains("buyB") {
        return b == none
    }
    let other = field(m, "buyB")
    let second = b else return false
    return cost_takes(other, second, items) and count_of(some(second.copy())) >= count_of(some(other))
}

// `MerchantOffer.take`: where `a` and `b` buy the offer, each less its cost, the first's price and
// the second's count.
fn paid_with(offer: Tag, a: Tag?, b: Tag?, items: ItemCodecs) -> (Tag?, Tag?)? {
    if not satisfied_by(offer.copy(), a.copy(), b.copy(), items) {
        return none
    }
    let m = compound(offer)
    let buy = field(m, "buy")
    let first = a.copy() ?? Tag.End
    let left_a = with_count(first.copy(), count_of(some(first)) - price(m, buy, items))
    if not m.contains("buyB") {
        return some((left_a, b.copy()))
    }
    let second = b.copy() ?? Tag.End
    let left_b = with_count(second.copy(), count_of(some(second)) - count_of(some(field(m, "buyB"))))
    return some((left_a, left_b))
}

// `MerchantOffer.getModifiedCostCount` of the offer `m`'s cost `cost`: its count, more by its
// count times the offer's demand times its multiplier where that's above nought, floored, and by
// its special price, from 1 to as many as its stack holds.
fn price(m: JavaHashMap<String, Tag>, cost: Tag, items: ItemCodecs) -> i32 {
    let base = count_of(some(cost.copy()))
    let demand = number(m, "demand", 0)
    let multiplier = if m.contains("priceMultiplier") { m["priceMultiplier"].number_float() ?? 0.0f32 } else { 0.0f32 }
    let more = greater(0, i32.saturate(f64(f32.nearest(base * demand) * multiplier).floor()))
    let total = base + more + number(m, "specialPrice", 0)
    return greater(1, min(total, items.max_stack_size(cost)))
}

// `ItemCost.test`: the cost's item, with each component it names as it has it.
fn cost_takes(cost: Tag, stack: Tag, items: ItemCodecs) -> bool {
    let m = compound(cost)
    if item_of(some(stack.copy())) != item_of(some(cost.copy())) {
        return false
    }
    if not m.contains("components") {
        return true
    }
    for (k, v) in compound(m["components"].copy()) {
        let have = items.component(stack.copy(), k.copy()) else return false
        if not same(have, v.copy()) {
            return false
        }
    }
    return true
}

// `MerchantOffer.isOutOfStock`: its uses at its most or more.
fn out_of_stock(offer: Tag) -> bool {
    let m = compound(offer)
    return number(m, "uses", 0) >= number(m, "maxUses", 4)
}

// `MerchantOffer.assemble`: what it gives.
fn sold(offer: Tag) -> Tag {
    return field(compound(offer), "sell")
}

// The offer with its uses up one, `increaseUses`.
fn used(offer: Tag) -> Tag {
    var m = compound(offer)
    let uses = number(m, "uses", 0)
    m.insert(String("uses"), Tag.Int(uses + 1))
    return Tag.Compound(m)
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    return match t {
        Tag.Compound(m) => m.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

fn field(m: JavaHashMap<String, Tag>, name: str) -> Tag {
    return if m.contains(name) { m[name].copy() } else { Tag.End }
}

// A saved offer's whole number `name`, `default` where it was saved without it, as its codec
// leaves a default out.
fn number(m: JavaHashMap<String, Tag>, name: str, default: i32) -> i32 {
    if not m.contains(name) {
        return default
    }
    return m[name].number_int() ?? default
}

// `RemoteSlot.Synchronized.matches`.
fn knows(remote: Remote, local: Tag?, items: ItemCodecs) -> i32 {
    return match remote {
        Remote.Unknown => NO,
        Remote.Sent(stack) => if same_stack(stack, local) { YES } else { NO },
        Remote.Hashed(h) => if h.matches(local, items) { LEARNED } else { NO },
    }
}

// `quickMoveStack`, a shift-click on slot `n`, as the menu's kind has it: the stack there, as it
// was, where some of it moved, else nothing.
fn quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    if s.kind == CRAFTING_MENU {
        return crafting_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == MERCHANT_MENU {
        return merchant_quick_move(mut s, n, items, mut fx)
    }
    if s.kind == BEACON_MENU {
        return beacon_quick_move(mut s, n, items, mut fx)
    }
    if s.kind == HORSE_MENU {
        return mount_quick_move(mut s, n, items, mut fx)
    }
    if s.kind == FURNACE_MENU {
        return furnace_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == BREWING_MENU {
        return brewing_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == STONECUTTER_MENU {
        return stonecutter_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == GRINDSTONE_MENU {
        return grindstone_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == ENCHANTMENT_MENU {
        return enchant_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == ANVIL_MENU {
        return combiner_quick_move(mut s, n, 2, true, items, who, mut fx)
    }
    if s.kind == LOOM_MENU {
        return loom_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == CARTOGRAPHY_MENU {
        return cartography_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == CRAFTER_MENU {
        return crafter_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == SMITHING_MENU {
        // `SmithingMenu.canMoveIntoInputSlots`: a template, base or addition whose slot's empty.
        var fits = false
        if let here = get(s, n) {
            fits = (in_property_set(s, "smithing_template", here, items) and get(s, 0) == none) or (in_property_set(s, "smithing_base", here, items) and get(s, 1) == none) or (in_property_set(s, "smithing_addition", here, items) and get(s, 2) == none)
        }
        return combiner_quick_move(mut s, n, 3, fits, items, who, mut fx)
    }
    if s.kind != INVENTORY_MENU {
        return container_quick_move(mut s, n, items, mut fx)
    }
    let original = get(s, n) else return none
    let worn = equipment_slot_for(original, items)
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 0 {
        stack = post_processed(mut s, stack.copy(), items)
        moved = move_to(mut s, mut stack, 9, 45, true, items, mut fx)
    } else if n >= 1 and n < 9 {
        moved = move_to(mut s, mut stack, 9, 45, false, items, mut fx)
    } else if armor_index(worn) >= 0 and get(s, usize.wrap(8 - armor_index(worn))) == none {
        let pos = usize.wrap(8 - armor_index(worn))
        moved = move_to(mut s, mut stack, pos, pos + 1, false, items, mut fx)
    } else if worn == "offhand" and get(s, 45) == none {
        moved = move_to(mut s, mut stack, 45, 46, false, items, mut fx)
    } else if n >= 9 and n < 36 {
        moved = move_to(mut s, mut stack, 36, 45, false, items, mut fx)
    } else if n >= 36 and n < 45 {
        moved = move_to(mut s, mut stack, 9, 36, false, items, mut fx)
    } else {
        moved = move_to(mut s, mut stack, 9, 45, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if n == 0 {
        quick_craft(mut s, original.copy(), stack.copy(), items, mut fx)
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        // What's left stays in the slot, shrunk where it is, which tells no one.
        put(mut s, n, stack.copy())
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    // The result taken, then what of it didn't fit dropped.
    if is_result(s, n) {
        on_take(mut s, n, items, who, stack.copy(), mut fx)
        if let left = stack {
            fx.push(Effect.Dropped(left, false))
        }
    }
    return some(original)
}

/// `StonecutterMenu.clickMenuButton` (CAL-338): the recipe `button` picked among those its input
/// has, where it isn't the one picked already, and its result made, `setupResultSlot`; whether
/// the click took, which only an unchanged pick doesn't. Other menus have no buttons Calcite has.
pub fn click_button(s: mut Slots, button: i32, items: ItemCodecs) -> bool {
    // `LoomMenu.clickMenuButton` (CAL-338): one of its patterns picked, and its result made.
    if s.kind == LOOM_MENU {
        if button < 0 or usize.wrap(button) >= s.patterns.len() {
            return false
        }
        s.selected = button
        let pattern = s.patterns[usize.wrap(button)].copy()
        weave(mut s, pattern, items)
        return true
    }
    if s.kind != STONECUTTER_MENU or s.selected == button {
        return false
    }
    if button >= 0 and usize.wrap(button) < cuts_for(s).len() {
        s.selected = button
        cut_result(mut s, button)
    }
    return true
}

// The places among the stonecutting recipes of those that take a stonecutter's input,
// `selectByInput`, none for none.
fn cuts_for(s: Slots) -> List<usize> {
    var out = List<usize>()
    let r = s.recipes.copy() else return out
    let input = get(s, 0)
    if input == none {
        return out
    }
    for i in 0..r.value.cutting.len() {
        if r.value.cutting[i].input.test(input.copy()) {
            out.push(i)
        }
    }
    return out
}

// `acceptsInput`: whether a stonecutting recipe takes `stack`.
fn accepts_cut(s: Slots, stack: Tag) -> bool {
    let r = s.recipes.copy() else return false
    for c in r.value.cutting {
        if c.input.test(some(stack.copy())) {
            return true
        }
    }
    return false
}

// `StonecutterMenu.slotsChanged`: where its input's of another item than it was, the recipes for
// it listed again, `setupRecipeList`: none picked, and nothing in the result.
fn cut_input_changed(s: mut Slots) {
    let item = item_of(get(s, 0))
    if item == s.cut {
        return
    }
    s.cut = item
    s.selected = -1
    put(mut s, 1, none)
}

// `setupResultSlot(index)`: what the recipe at `index` among the input's makes, `assemble`, its
// result's template made a stack, its count 1 where it gives none, put in the result, and the
// recipe kept as the one used, `setRecipeUsed`; else nothing there and none used. Then its changes
// broadcast.
fn cut_result(s: mut Slots, index: i32) {
    s.broadcast = true
    let cuts = cuts_for(s)
    if index >= 0 and usize.wrap(index) < cuts.len() {
        if let r = s.recipes.copy() {
            let c = r.value.cutting[cuts[usize.wrap(index)]].copy()
            s.used = some(c.at)
            put(mut s, 1, with_count(c.result.copy(), count_of(some(c.result.copy()))))
            return
        }
    }
    put(mut s, 1, none)
    s.used = none
}

// The stonecutter's result slot's `onTake`, `carried` what was taken, or of a shift-click what's
// left of it: its item crafted as many times, even none, `onCraftedBy`; the recipe used, where
// there is one, with the input as it is, `awardUsedRecipes`, and let go, as no stonecutting
// recipe is special; one of the input taken, `remove(1)`, and where there was any, the result made
// again; then its sound.
fn cut_take(s: mut Slots, carried: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    fx.push(Effect.Made(item_of(carried.copy()), count_of(carried)))
    if let at = s.used {
        fx.push(Effect.Crafted(at, [get(s, 0)]))
        s.used = none
    }
    if remove(mut s, 0, 1, items, mut fx) != none {
        let picked = s.selected
        cut_result(mut s, picked)
    }
    fx.push(Effect.Cut)
}

// `StonecutterMenu.quickMoveStack` (CAL-338): the result into the player's slots from the hotbar's
// last; the input into the player's from the inventory's first; the player's into the input where
// a stonecutting recipe takes it, `acceptsInput`; else the inventory's into the hotbar and the
// hotbar's into the inventory. Where none moved, nothing's given; what's left is set where it was,
// nothing by the player, then `setChanged`; nothing's given where all of it's left, else the
// slot's `onTake` of what's left, and of the result, what's left dropped, `drop(stack, false)`.
fn stonecutter_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n == 1 {
        if not move_to(mut s, mut stack, 2, 38, true, items, mut fx) {
            return none
        }
    } else if n == 0 {
        if not move_to(mut s, mut stack, 2, 38, false, items, mut fx) {
            return none
        }
    } else if accepts_cut(s, original) {
        if not move_to(mut s, mut stack, 0, 1, false, items, mut fx) {
            return none
        }
    } else if n >= 2 and n < 29 {
        if not move_to(mut s, mut stack, 29, 38, false, items, mut fx) {
            return none
        }
    } else if n >= 29 and n < 38 and not move_to(mut s, mut stack, 2, 29, false, items, mut fx) {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
    }
    changed(mut s, n, items, mut fx)
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    if n == 1 {
        if let left = stack {
            fx.push(Effect.Dropped(left, false))
        }
    }
    s.broadcast = true
    return some(original)
}

// `GrindstoneMenu.quickMoveStack` (CAL-338): the result into the player's slots from the hotbar's
// last; the player's into the inputs, from the first, where one of them is empty, else the
// inventory's into the hotbar and the hotbar's into the inventory; an input into the player's
// from the inventory's first. Where none moved, nothing's given; what's left is set where it was,
// nothing by the player, or else `setChanged`; nothing's given where all of it's left, else the
// slot's `onTake` of what's left, which for the result empties the inputs, so whatever of it
// didn't fit is gone.
fn grindstone_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n == 2 {
        if not move_to(mut s, mut stack, 3, 39, true, items, mut fx) {
            return none
        }
    } else if n != 0 and n != 1 {
        if get(s, 0) != none and get(s, 1) != none {
            if n >= 3 and n < 30 {
                if not move_to(mut s, mut stack, 30, 39, false, items, mut fx) {
                    return none
                }
            } else if n >= 30 and n < 39 and not move_to(mut s, mut stack, 3, 30, false, items, mut fx) {
                return none
            }
        } else if not move_to(mut s, mut stack, 0, 2, false, items, mut fx) {
            return none
        }
    } else if not move_to(mut s, mut stack, 3, 39, false, items, mut fx) {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    return some(original)
}

// A loom's `slotsChanged` (CAL-338): with a banner and a dye, its patterns from its pattern, the
// one picked kept where it's still among them, or the only one, else none; the banner with it in
// its result where there's one and the banner hasn't 6 layers, else nothing; then broadcast.
// Without both, nothing, no patterns and none picked.
fn loom_changed(s: mut Slots, items: ItemCodecs) {
    if get(s, 0) == none or get(s, 1) == none {
        put(mut s, 3, none)
        s.patterns = List<String>()
        s.selected = -1
        return
    }
    let picked = s.selected
    let valid = picked >= 0 and usize.wrap(picked) < s.patterns.len()
    let previous = s.patterns.copy()
    s.patterns = selectable_patterns(get(s, 2), items)
    var shown: String? = none
    if s.patterns.len() == 1 {
        s.selected = 0
        shown = some(s.patterns[0].copy())
    } else if not valid {
        s.selected = -1
    } else {
        let was = previous[usize.wrap(picked)].copy()
        s.selected = -1
        for i in 0..s.patterns.len() {
            if s.patterns[i] == was {
                s.selected = i32.wrap(i)
                shown = some(was.copy())
                break
            }
        }
    }
    if let pattern = shown {
        if layers_of(get(s, 0), items).len() >= 6 {
            s.selected = -1
            put(mut s, 3, none)
        } else {
            weave(mut s, pattern, items)
        }
    } else {
        put(mut s, 3, none)
    }
    s.broadcast = true
}

// `getSelectablePatterns`: without a pattern, the banner patterns `#no_item_required`; else
// those its `provides_banner_patterns` holds; by their names, in order.
fn selectable_patterns(pattern: Tag?, items: ItemCodecs) -> List<String> {
    let p = pattern else return items.synced_set_names("minecraft:banner_pattern", Tag.Str(String("#minecraft:no_item_required")))
    let found = items.component(p, String("minecraft:provides_banner_patterns")) else return List<String>()
    return items.synced_set_names("minecraft:banner_pattern", found)
}

// `setupResultSlot` of the pattern `pattern`: one of the banner with a layer of it in its dye's
// color added to its `banner_patterns`, where it has a banner and a dye with its `dye`.
fn weave(s: mut Slots, pattern: String, items: ItemCodecs) {
    let banner = get(s, 0) else {
        put(mut s, 3, none)
        return
    }
    let dye = get(s, 1) else {
        put(mut s, 3, none)
        return
    }
    let color = items.component(dye, String("minecraft:dye")) else {
        put(mut s, 3, none)
        return
    }
    var layers = layers_of(some(banner.copy()), items)
    var layer = JavaHashMap<String, Tag>()
    layer.insert(String("pattern"), Tag.Str(pattern.copy()))
    layer.insert(String("color"), color)
    layers.push(Tag.Compound(layer))
    let one = with_count(banner, 1) ?? Tag.End
    put(mut s, 3, some(set_component(one, "minecraft:banner_patterns", Tag.List(layers), items)))
}

// A banner's layers, its `banner_patterns`, none for none.
fn layers_of(banner: Tag?, items: ItemCodecs) -> List<Tag> {
    let b = banner else return List<Tag>()
    return match items.component(b, String("minecraft:banner_patterns")) {
        some(Tag.List(l)) => l.copy(),
        _ => List<Tag>(),
    }
}

// What a loom's slot `n` takes: a banner, `BannerItem`; a dye, `#loom_dyes` with its `dye`; a
// pattern, `#loom_patterns` with its `provides_banner_patterns`.
fn loom_takes(n: usize, stack: Tag, items: ItemCodecs) -> bool {
    let item = item_of(some(stack.copy()))
    if n == 0 {
        return item.ends_with("_banner") and item.starts_with("minecraft:")
    }
    let id = items.builtin_id("item", item) else return false
    if n == 1 {
        return items.holder_set_has("item", Tag.Str(String("#minecraft:loom_dyes")), id) and items.component(stack, String("minecraft:dye")) != none
    }
    return items.holder_set_has("item", Tag.Str(String("#minecraft:loom_patterns")), id) and items.component(stack, String("minecraft:provides_banner_patterns")) != none
}

// `CrafterMenu.quickMoveStack` (CAL-338): its slots into the player's from the hotbar's last; the
// player's into its slots. What's left is set where it was, `set`, or else `setChanged`; nothing's
// given where all of it's left, else the slot's `onTake` of what's left.
fn crafter_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n < 9 {
        if not move_to(mut s, mut stack, 9, 45, true, items, mut fx) {
            return none
        }
    } else if not move_to(mut s, mut stack, 0, 9, false, items, mut fx) {
        return none
    }
    if stack == none {
        set(mut s, n, none, items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    return some(original)
}

// `LoomMenu.quickMoveStack` (CAL-338): the result into the player's slots from the hotbar's last;
// an input into the player's slots; the player's banner, dye or pattern into its slot, anything
// else between the inventory and the hotbar. What's left is set where it was, nothing by the
// player, or else `setChanged`; nothing's given where all of it's left, else the slot's `onTake`
// of what's left.
fn loom_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n == 3 {
        if not move_to(mut s, mut stack, 4, 40, true, items, mut fx) {
            return none
        }
    } else if n > 3 {
        var into: usize = 99
        for k in 0usize..3 {
            if into == 99 and loom_takes(k, original.copy(), items) {
                into = k
            }
        }
        if into != 99 {
            if not move_to(mut s, mut stack, into, into + 1, false, items, mut fx) {
                return none
            }
        } else if n >= 4 and n < 31 {
            if not move_to(mut s, mut stack, 31, 40, false, items, mut fx) {
                return none
            }
        } else if n >= 31 and n < 40 and not move_to(mut s, mut stack, 4, 31, false, items, mut fx) {
            return none
        }
    } else if not move_to(mut s, mut stack, 4, 40, false, items, mut fx) {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    return some(original)
}

// A smithing table's `createResult` (CAL-338): the first smithing recipe its template, base and
// addition match, used, `setRecipeUsed`, and what it makes in its result; else none used and
// nothing.
fn smith_result(s: mut Slots, items: ItemCodecs) {
    let r = s.recipes.copy() else return
    if let k = smithing_find(r.value, get(s, 0), get(s, 1), get(s, 2)) {
        s.used = some(r.value.smithing[k].at)
        let made = smithing_made(r.value, k, get(s, 1), get(s, 2), items)
        put(mut s, 3, made)
        return
    }
    s.used = none
    put(mut s, 3, none)
}

// `ItemCombinerMenu.quickMoveStack` (CAL-338), of an anvil's or a smithing table's, whose result
// is slot `result`: the result into the player's slots from the hotbar's last; an input into the
// player's slots; the player's into the inputs where it `fits`, `canMoveIntoInputSlots`, else
// between the inventory and the hotbar. What's left is set where it was, nothing by the
// player, or else `setChanged`; nothing's given where all of it's left, else the slot's `onTake`
// of what's left.
fn combiner_quick_move(s: mut Slots, n: usize, result: usize, fits: bool, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    let start = result + 1
    let end = start + 36
    if n == result {
        if not move_to(mut s, mut stack, start, end, true, items, mut fx) {
            return none
        }
    } else if n < result {
        if not move_to(mut s, mut stack, start, end, false, items, mut fx) {
            return none
        }
    } else if fits and n >= start and n < end {
        if not move_to(mut s, mut stack, 0, result, false, items, mut fx) {
            return none
        }
    } else if n >= start and n < start + 27 {
        if not move_to(mut s, mut stack, start + 27, end, false, items, mut fx) {
            return none
        }
    } else if n >= start + 27 and n < end and not move_to(mut s, mut stack, start, start + 27, false, items, mut fx) {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    return some(original)
}

// `EnchantmentMenu.quickMoveStack` (CAL-338): what's enchanted and its lapis into the player's
// slots from the hotbar's last; the player's lapis into the lapis slot; anything else one of it
// into the empty slot for what's enchanted, `setByPlayer`, or nothing where it's full. What's left
// is set where it was, nothing by the player, or else `setChanged`; nothing's given where all of
// it's left, else the slot's `onTake` of what's left.
fn enchant_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n == 0 or n == 1 {
        if not move_to(mut s, mut stack, 2, 38, true, items, mut fx) {
            return none
        }
    } else if item_of(stack.copy()) == "minecraft:lapis_lazuli" {
        if not move_to(mut s, mut stack, 1, 2, true, items, mut fx) {
            return none
        }
    } else {
        if get(s, 0) != none or not may_place(s, 0, original.copy(), items) {
            return none
        }
        let single = with_count(original.copy(), 1)
        stack = with_count(original.copy(), count_of(stack) - 1)
        set_by_player(mut s, 0, single, none, items, mut fx)
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    return some(original)
}

// `AbstractMountInventoryMenu.quickMoveStack` (CAL-179): the saddle's, the body armor's and a
// chest's into the player's slots, from the hotbar's last; the player's into the body armor's
// slot where it takes it and it's empty, else the saddle's, else a chest's where there's one;
// else, as none of those took it, the hotbar's into the inventory and the inventory's into the
// hotbar, giving nothing either way, what's left shrunk where it is, which tells no one. Else
// what's left is set where it was, nothing by the player, or `setChanged`, and the stack as it
// was given.
fn mount_quick_move(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    let start = s.container.len()
    let total = s.count()
    if n < start {
        if not move_to(mut s, mut stack, start, total, true, items, mut fx) {
            return none
        }
    } else if may_place(s, 1, original.copy(), items) and get(s, 1) == none {
        if not move_to(mut s, mut stack, 1, 2, false, items, mut fx) {
            return none
        }
    } else if may_place(s, 0, original.copy(), items) and get(s, 0) == none {
        if not move_to(mut s, mut stack, 0, 1, false, items, mut fx) {
            return none
        }
    } else if start == 2 or not move_to(mut s, mut stack, 2, start, false, items, mut fx) {
        let inventory_end = start + 27
        let hotbar_end = inventory_end + 9
        if n >= inventory_end and n < hotbar_end {
            _ = move_to(mut s, mut stack, start, inventory_end, false, items, mut fx)
        } else if n >= start and n < inventory_end {
            _ = move_to(mut s, mut stack, inventory_end, hotbar_end, false, items, mut fx)
        } else {
            _ = move_to(mut s, mut stack, inventory_end, inventory_end, false, items, mut fx)
        }
        put(mut s, n, stack.copy())
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    return some(original)
}

// `AbstractFurnaceMenu.quickMoveStack` (CAL-336): the result into the player's slots from the
// hotbar's last, what moved counted, `onQuickCraft`; the player's into the input where the
// furnace's recipes take it, `canSmelt`, else into the fuel slot where it's fuel, else the
// inventory's into the hotbar and the hotbar's into the inventory; the input's and the fuel's
// into the player's from the inventory's first. Where none moved, nothing's given. What's left
// is set where it was, nothing by the player, or else `setChanged`; nothing's given where all of
// it's left, else the slot's `onTake` of it, and the stack as it was.
fn furnace_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n == 2 {
        if not move_to(mut s, mut stack, 3, 39, true, items, mut fx) {
            return none
        }
        quick_craft(mut s, original.copy(), stack.copy(), items, mut fx)
    } else if n != 1 and n != 0 {
        if smeltable(s, original, items) {
            if not move_to(mut s, mut stack, 0, 1, false, items, mut fx) {
                return none
            }
        } else if is_fuel(original, items) {
            if not move_to(mut s, mut stack, 1, 2, false, items, mut fx) {
                return none
            }
        } else if n >= 3 and n < 30 {
            if not move_to(mut s, mut stack, 30, 39, false, items, mut fx) {
                return none
            }
        } else if n >= 30 and n < 39 and not move_to(mut s, mut stack, 3, 30, false, items, mut fx) {
            return none
        }
    } else if not move_to(mut s, mut stack, 3, 39, false, items, mut fx) {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    return some(original)
}

// `BrewingStandMenu.quickMoveStack` (CAL-337): the player's to the fuel slot where it's fuel, else,
// where that took none, to the reagent's where it takes it; else to the reagent's where it takes
// it; else to the bottles' where it's a potion input; else the inventory's into the hotbar and the
// hotbar's into the inventory. The stand's into the player's from the hotbar's last. Where none
// moved, nothing's given; what's left is set where it was, nothing by the player, or else
// `setChanged`; nothing's given where all of it's left, else the slot's `onTake` of the stack as
// it was, and that stack.
fn brewing_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n > 4 {
        if brewing_fuel(original, items) {
            if move_to(mut s, mut stack, 4, 5, false, items, mut fx) {
                // Vanilla gives nothing at once here: what's left stays shrunk in its slot, set
                // by no one and with no `setChanged`.
                put(mut s, n, stack.copy())
                return none
            }
            let left = stack.copy() ?? Tag.End
            if stack != none and reagent_slot_takes(s, left, items) and not move_to(mut s, mut stack, 3, 4, false, items, mut fx) {
                return none
            }
        } else if reagent_slot_takes(s, original, items) {
            if not move_to(mut s, mut stack, 3, 4, false, items, mut fx) {
                return none
            }
        } else if potion_input(s, original, items) {
            if not move_to(mut s, mut stack, 0, 3, false, items, mut fx) {
                return none
            }
        } else if n >= 5 and n < 32 {
            if not move_to(mut s, mut stack, 32, 41, false, items, mut fx) {
                return none
            }
        } else if n >= 32 and n < 41 {
            if not move_to(mut s, mut stack, 5, 32, false, items, mut fx) {
                return none
            }
        } else if not move_to(mut s, mut stack, 5, 41, false, items, mut fx) {
            return none
        }
    } else {
        if not move_to(mut s, mut stack, 5, 41, true, items, mut fx) {
            return none
        }
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, some(original.copy()), mut fx)
    return some(original)
}

// `BrewingStandMenu.FuelSlot.mayPlaceItem`: whether `stack` has `brewing_fuel`.
fn brewing_fuel(stack: Tag, items: ItemCodecs) -> bool {
    return items.component(stack, String("minecraft:brewing_fuel")) != none
}

// `IngredientsSlot.mayPlace`: whether the property set `BREWING_REAGENTS` holds `stack`'s item.
fn reagent_slot_takes(s: Slots, stack: Tag, items: ItemCodecs) -> bool {
    return in_property_set(s, "brewing_reagent", stack, items)
}

// `PotionIngredient.isPotionInput`: whether the property set `BREWING_INPUTS` holds `stack`'s
// item, or it's `#brewing_potion_inputs`.
fn potion_input(s: Slots, stack: Tag, items: ItemCodecs) -> bool {
    if in_property_set(s, "brewing_input", stack, items) {
        return true
    }
    let id = items.builtin_id("item", item_of(some(stack.copy()))) else return false
    return items.holder_set_has("item", Tag.Str(String("#minecraft:brewing_potion_inputs")), id)
}

// Whether the recipe property set `key`, by its path, holds `stack`'s item.
fn in_property_set(s: Slots, key: str, stack: Tag, items: ItemCodecs) -> bool {
    let id = items.builtin_id("item", item_of(some(stack.copy()))) else return false
    let r = s.recipes else return false
    for (k, ids) in r.value.item_sets {
        if k.path == key {
            return ids.contains(id)
        }
    }
    return false
}

// `AbstractFurnaceMenu.canSmelt`: whether the furnace's recipe property set, `acceptedInputs`,
// holds `stack`'s item.
fn smeltable(s: Slots, stack: Tag, items: ItemCodecs) -> bool {
    let id = items.builtin_id("item", item_of(some(stack.copy()))) else return false
    let r = s.recipes else return false
    for (key, ids) in r.value.item_sets {
        if key.path == s.inputs {
            return ids.contains(id)
        }
    }
    return false
}

// `AbstractFurnaceMenu.isFuel`: whether `stack` has `cooking_fuel`.
fn is_fuel(stack: Tag, items: ItemCodecs) -> bool {
    return items.component(stack, String("minecraft:cooking_fuel")) != none
}

// A container's menu's `quickMoveStack` (CAL-144): from the container into the player's slots,
// from the hotbar's last, else from the player's into the container's, from its first; what's
// left `setChanged` where it is. `ChestMenu`'s, `ShulkerBoxMenu`'s and `HopperMenu`'s give the
// stack as it was wherever any moved; `DispenserMenu`'s gives nothing where none did.
fn container_quick_move(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    let size = s.container.len()
    let total = s.count()
    let moved = if n < size { move_to(mut s, mut stack, size, total, true, items, mut fx) } else { move_to(mut s, mut stack, 0, size, false, items, mut fx) }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if s.kind == DISPENSER_MENU and count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    return some(original)
}

// `CraftingMenu.quickMoveStack` (CAL-147): the result into the player's slots from the hotbar's
// last, what of it doesn't fit dropped; the player's into the grid from its first, else the
// inventory's into the hotbar and the hotbar's into the inventory; the grid's into the player's
// from the inventory's first. What's left stays where it is, which tells no one.
fn crafting_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 0 {
        // Made as it's crafted first, `onCraftedBy`, as a map's post-processing is (CAL-338).
        stack = post_processed(mut s, stack.copy(), items)
        moved = move_to(mut s, mut stack, 10, 46, true, items, mut fx)
    } else if n >= 10 and n < 46 {
        moved = move_to(mut s, mut stack, 1, 10, false, items, mut fx)
        if not moved {
            if n < 37 {
                moved = move_to(mut s, mut stack, 37, 46, false, items, mut fx)
            } else {
                moved = move_to(mut s, mut stack, 10, 37, false, items, mut fx)
            }
        }
    } else {
        moved = move_to(mut s, mut stack, 10, 46, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if n == 0 {
        quick_craft(mut s, original.copy(), stack.copy(), items, mut fx)
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    if n == 0 {
        on_take(mut s, n, items, who, stack.copy(), mut fx)
        if let left = stack {
            fx.push(Effect.Dropped(left, false))
        }
    }
    return some(original)
}

// `MerchantMenu.quickMoveStack` (CAL-160): what the trade gives into the player's slots from the
// hotbar's last, its trade's sound played on the client, `playTradeSound`; a payment into the
// player's slots from the inventory's first; the inventory's into the hotbar, and the hotbar's
// into the inventory. What's left stays where it is, `setChanged`, which makes what the payments
// buy again; and where some moved, the slot's taken from, `onTake`, which for what the trade gives
// is the trade.
fn merchant_quick_move(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 2 {
        moved = move_to(mut s, mut stack, 3, 39, true, items, mut fx)
        if moved {
            quick_craft(mut s, original.copy(), stack.copy(), items, mut fx)
        }
    } else if n == 0 or n == 1 {
        moved = move_to(mut s, mut stack, 3, 39, false, items, mut fx)
    } else if n >= 3 and n < 30 {
        moved = move_to(mut s, mut stack, 30, 39, false, items, mut fx)
    } else if n >= 30 and n < 39 {
        moved = move_to(mut s, mut stack, 3, 30, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    if n == 2 {
        take_achievements(mut s, stack, mut fx)
        merchant_take(mut s, items, mut fx)
    } else {
        // `Slot.onTake`'s `setChanged`.
        changed(mut s, n, items, mut fx)
    }
    return some(original)
}

// `BeaconMenu.quickMoveStack` (D521): the payment into the player's slots from the hotbar's last;
// one payment item alone into the payment slot where it's empty; else the inventory's into the
// hotbar, the hotbar's into the inventory. What's left stays where it is, `setChanged`; and where
// some moved, the slot's taken from, `onTake`, its `setChanged`.
fn beacon_quick_move(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 0 {
        moved = move_to(mut s, mut stack, 1, 37, true, items, mut fx)
    } else if get(s, 0) == none and may_place(s, 0, original, items) and count_of(stack) == 1 {
        moved = move_to(mut s, mut stack, 0, 1, false, items, mut fx)
    } else if n >= 1 and n < 28 {
        moved = move_to(mut s, mut stack, 28, 37, false, items, mut fx)
    } else if n >= 28 and n < 37 {
        moved = move_to(mut s, mut stack, 1, 28, false, items, mut fx)
    } else {
        moved = move_to(mut s, mut stack, 1, 37, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    changed(mut s, n, items, mut fx)
    return some(original)
}

// `moveItemStackTo`: `stack` moved into the slots from `start` to before `end`, from the last
// where `backwards`: onto stacks of it first, where it stacks, then into the first empty slot
// that takes it. Whether anything moved.
fn move_to(s: mut Slots, stack: mut Tag?, start: usize, end: usize, backwards: bool, items: ItemCodecs, fx: mut List<Effect>) -> bool {
    var moved = false
    let first = i32.wrap(start)
    let last = i32.wrap(end)
    var dest = if backwards { last - 1 } else { first }
    if stackable(stack, items) {
        while stack != none and within(dest, first, last, backwards) {
            let d = usize.wrap(dest)
            let target = get(s, d)
            if target != none and same_components(stack, target) {
                let t = target.copy() ?? Tag.End
                let total = count_of(target) + count_of(stack)
                let max = max_for(s, d, t, items)
                if total <= max {
                    stack = none
                    put(mut s, d, with_count(t, total))
                    changed(mut s, d, items, mut fx)
                    moved = true
                } else if count_of(target) < max {
                    let given = stack.copy() ?? Tag.End
                    stack = with_count(given, count_of(stack) - (max - count_of(target)))
                    put(mut s, d, with_count(t, max))
                    changed(mut s, d, items, mut fx)
                    moved = true
                }
            }
            dest += if backwards { -1 } else { 1 }
        }
    }
    if stack != none {
        dest = if backwards { last - 1 } else { first }
        while within(dest, first, last, backwards) {
            let d = usize.wrap(dest)
            let given = stack.copy() ?? Tag.End
            if get(s, d) == none and may_place(s, d, given, items) {
                let max = max_for(s, d, given, items)
                let take = min(count_of(stack), max)
                let left = count_of(stack) - take
                stack = with_count(given, left)
                set_by_player(mut s, d, with_count(given, take), none, items, mut fx)
                changed(mut s, d, items, mut fx)
                moved = true
                break
            }
            dest += if backwards { -1 } else { 1 }
        }
    }
    return moved
}

// Whether `dest` is still in the slots from `first` to before `last`, going down where `backwards`.
fn within(dest: i32, first: i32, last: i32, backwards: bool) -> bool {
    return if backwards { dest >= first } else { dest < last }
}

// `Slot.safeInsert`: as much of `stack` as `amount`, as the slot takes, put in slot `n`, onto
// what's there where it's the same. What's left of `stack`.
fn safe_insert(s: mut Slots, n: usize, stack: Tag, amount: i32, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    if not may_place(s, n, stack, items) {
        return some(stack.copy())
    }
    let here = get(s, n)
    let given = some(stack.copy())
    let moved = min(min(amount, count_of(given)), max_for(s, n, stack, items) - count_of(here))
    if moved <= 0 {
        return given
    }
    if here == none {
        set_by_player(mut s, n, with_count(stack, moved), none, items, mut fx)
        return with_count(stack, count_of(given) - moved)
    }
    if same_components(here, given) {
        let h = here.copy() ?? Tag.End
        // The slot's stack grows where it is, so it's its own previous stack.
        let grown = with_count(h, count_of(here) + moved)
        set_by_player(mut s, n, grown.copy(), grown, items, mut fx)
        return with_count(stack, count_of(given) - moved)
    }
    return given
}

// `Slot.safeTake` with no most: `tryRemove`, then the slot's `onTake` of what it gave.
fn safe_take(s: mut Slots, n: usize, amount: i32, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let taken = try_remove(mut s, n, amount, i32.MAX, items, who, mut fx) else return none
    on_take(mut s, n, items, who, some(taken.copy()), mut fx)
    return some(taken)
}

// What `add` left of `given` where none of it went in, vanilla's `false`, else nothing: where
// some went in, `add` said `true` and the rest's left in a stack no one keeps.
fn none_added(left: Tag?, given: Tag) -> Tag? {
    let l = left else return none
    if count_of(some(l.copy())) == count_of(some(given.copy())) {
        return some(l.copy())
    }
    return none
}

/// `Inventory.add(stack)`, as a player picking an item up adds it: how many of it are left, and
/// whether any went in, `add`'s answer, which holds where the inventory's creative and nothing
/// fits too (CAL-148).
pub fn pick_up(inv: mut Inventory, stack: Tag, items: ItemCodecs, who: Clicker) -> (i32, bool) {
    let given = count_of(some(stack.copy()))
    let left = add(mut inv, -1, stack, items, who)
    let n = count_of(left)
    if left == none {
        return (0, true)
    }
    return (n, n < given)
}

// `Slot.tryRemove`: up to `amount`, and no more than `max`, taken from slot `n`, where the
// player may, or nothing.
fn try_remove(s: mut Slots, n: usize, amount: i32, max: i32, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    if not may_pickup(s, n, items, who) {
        return none
    }
    let here = get(s, n)
    let modifiable = match here {
        some(h) => may_place(s, n, h, items),
        none => s.kind != INVENTORY_MENU or n >= 9 or (n >= 1 and n <= 4),
    }
    if not modifiable and max < count_of(here) {
        return none
    }
    let taken = remove(mut s, n, min(amount, max), items, mut fx) else return none
    if get(s, n) == none {
        set_by_player(mut s, n, none, some(taken.copy()), items, mut fx)
    }
    if crafts_maps(s, n) {
        return post_processed(mut s, some(taken), items)
    }
    return some(taken)
}

// Whether slot `n` is a result that makes what's taken of it as it's crafted, `onCraftedBy`,
// which a map's post-processing is done in (CAL-338): a cartography table's, and a crafting
// grid's.
fn crafts_maps(s: Slots, n: usize) -> bool {
    return (s.kind == CARTOGRAPHY_MENU and n == 2) or ((s.kind == CRAFTING_MENU or s.kind == INVENTORY_MENU) and n == 0)
}

// `Slot.remove`: up to `amount` split from slot `n`'s stack, which the crafting grid tells the
// menu of, and a container's `removeItem` its `setChanged`. The crafting result's is the whole
// stack, as `ResultContainer.removeItem` takes it.
fn remove(s: mut Slots, n: usize, amount: i32, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    if amount <= 0 {
        return none
    }
    let here = get(s, n) else return none
    if s.kind == FURNACE_MENU and n == 2 {
        // `FurnaceResultSlot.remove` counts what it gives, then gives it as a slot does.
        s.removes += min(amount, count_of(some(here.copy())))
    } else if (s.kind == STONECUTTER_MENU and n == 1) or ((s.kind == GRINDSTONE_MENU or s.kind == ANVIL_MENU or s.kind == CARTOGRAPHY_MENU) and n == 2) or (s.kind == SMITHING_MENU and n == 3) {
        // A stonecutter's result and a grindstone's are slots of a `ResultContainer`, which gives
        // it all, counting nothing (CAL-338).
        put(mut s, n, none)
        return some(here)
    } else if is_result(s, n) {
        // `ResultSlot.remove` and `MerchantResultSlot.remove` count what they're asked for,
        // though they give it all.
        s.removes += min(amount, count_of(some(here.copy())))
        put(mut s, n, none)
        return some(here)
    }
    let given = some(here.copy())
    let take = min(amount, count_of(given))
    put(mut s, n, with_count(here, count_of(given) - take))
    if is_grid(s, n) and not (s.placing and s.kind == CRAFTING_MENU) {
        craft(mut s, items, mut fx)
    }
    changed(mut s, n, items, mut fx)
    return with_count(here, take)
}

// `setByPlayer(stack, was)`: the inventory menu's armor slots and offhand's tell the player
// first, as `onEquipItem`; then `set`.
fn set_by_player(s: mut Slots, n: usize, stack: Tag?, was: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    let worn = if s.kind == INVENTORY_MENU { worn_name(n) } else { mount_slot_name(s, n) }
    if worn != "" {
        fx.push(Effect.Equip(String(worn), was.copy(), stack.copy()))
    }
    set(mut s, n, stack, items, mut fx)
}

// The equipment slot a horse's menu's slot `n` is, its saddle's or its body's, by its codec's
// name, or empty (CAL-179).
fn mount_slot_name(s: Slots, n: usize) -> str {
    if s.kind != HORSE_MENU {
        return ""
    }
    return if n == 0 { "saddle" } else if n == 1 { "body" } else { "" }
}

// `Slot.set`: the container's `setItem`, which the crafting grid tells the menu of, and a
// merchant's payments too, `MerchantContainer.setItem` (CAL-160), and a horse's saddle and body
// armor its `setItemSlot`, whose `onEquipItem` hears it again (CAL-179); then the container's
// `setChanged`.
fn set(s: mut Slots, n: usize, stack: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    let worn = mount_slot_name(s, n)
    if worn != "" {
        fx.push(Effect.Equip(String(worn), get(s, n), stack.copy()))
    }
    if s.kind == FURNACE_MENU and n == 0 {
        fx.push(Effect.Input(get(s, n), stack.copy()))
    }
    put(mut s, n, stack.copy())
    // A crafting table's grid tells its menu nothing while it places a recipe (CAL-339).
    if is_grid(s, n) and not (s.placing and s.kind == CRAFTING_MENU) {
        craft(mut s, items, mut fx)
    }
    if is_payment(s, n) {
        update_sell(mut s, items, mut fx)
    }
    changed(mut s, n, items, mut fx)
}

// Whether slot `n` is the crafting result, the inventory menu's or a crafting table's slot 0
// (CAL-147), what a merchant's trade gives, its slot 2 (CAL-160), or a furnace's result, its
// slot 2 (CAL-336), or a stonecutter's, its slot 1, or a grindstone's, its slot 2 (CAL-338).
fn is_result(s: Slots, n: usize) -> bool {
    return ((s.kind == INVENTORY_MENU or s.kind == CRAFTING_MENU) and n == 0) or ((s.kind == MERCHANT_MENU or s.kind == FURNACE_MENU) and n == 2) or (s.kind == STONECUTTER_MENU and n == 1) or ((s.kind == GRINDSTONE_MENU or s.kind == ANVIL_MENU) and n == 2) or (s.kind == SMITHING_MENU and n == 3)
}

// Whether slot `n` is one of a merchant's payments, its slots 0 and 1 (CAL-160).
fn is_payment(s: Slots, n: usize) -> bool {
    return s.kind == MERCHANT_MENU and n < 2
}

// Whether slot `n` is in the crafting grid, the inventory menu's 1 to 4 or a crafting table's 1
// to 9.
fn is_grid(s: Slots, n: usize) -> bool {
    let (first, width, height) = grid_shape(s)
    return (s.kind == INVENTORY_MENU or s.kind == CRAFTING_MENU) and n >= first and n < first + width * height
}

// The crafting grid's first slot, its width and its height: the inventory menu's 2 by 2, or a
// crafting table's 3 by 3.
fn grid_shape(s: Slots) -> (usize, usize, usize) {
    if s.kind == CRAFTING_MENU {
        return (1, 3, 3)
    }
    return (1, 2, 2)
}

// The crafting grid's stacks, as `CraftingInput.ofPositioned` makes them.
fn grid_input(s: Slots) -> Input {
    let (first, width, height) = grid_shape(s)
    var grid = List<Tag?>()
    for i in 0..width * height {
        grid.push(get(s, first + i))
    }
    var input = Input.of(width, height, grid)
    // The maps' scales, which extending a map reads (CAL-338).
    for (id, scale, _) in s.map_facts {
        input.map_scales.push((id, scale))
    }
    return input
}

// `slotChangedCraftingGrid`, as the grid changes: the result set to what the grid makes, which is
// sent, `Effect.Grid`, and the recipe that makes it kept as the one used, `setRecipeUsed`
// (CAL-164). Every recipe may be used, as `setRecipeUsed` lets one be where the game rule
// `limited_crafting` is off, which Calcite has no other way to set.
fn craft(s: mut Slots, items: ItemCodecs, fx: mut List<Effect>) {
    craft_with(mut s, none, items, mut fx)
}

// `slotChangedCraftingGrid` with the recipe `hint`, by its place among the world's, made where the
// grid matches it, as `getRecipeFor`'s hint is, else the first recipe the grid matches (CAL-339).
fn craft_with(s: mut Slots, hint: usize?, items: ItemCodecs, fx: mut List<Effect>) {
    var made: Tag? = none
    if let r = s.recipes.copy() {
        let input = grid_input(s)
        var found: usize? = none
        if let h = hint {
            if matches_recipe(r.value, h, input, items) {
                found = crafting_index(r.value, h)
            }
        }
        if found == none {
            found = find_crafting(r.value, input, items)
        }
        if let i = found {
            s.used = some(r.value.crafting[i].at)
            made = made_by(r.value, i, input, items)
        }
    }
    put(mut s, 0, made.copy())
    fx.push(Effect.Grid(s.kind, made))
}

// `Slot.onQuickCraft(picked, original)` of what a result slot had, `original`, some of which
// moved in a shift-click, `left` of it left (CAL-164): as many as moved counted,
// `onQuickCraft(original, count)`, and its achievements checked as `original`'s. That's the
// stack as it was before it was made, so a map's made again from it, `onCraftedBy`, a second new
// map no one gets, as vanilla's is (CAL-338).
fn quick_craft(s: mut Slots, original: own Tag, left: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    let count = count_of(some(original.copy())) - count_of(left)
    if count > 0 {
        s.removes += count
        _ = post_processed(mut s, some(original.copy()), items)
        take_achievements(mut s, some(original), mut fx)
    }
}

// `checkTakeAchievements` of a result, as it's taken or shifted out, `carried` what's taken, or
// left of it (CAL-164). `ResultSlot`'s, of the crafting grid's: where it's given any,
// `carried`'s item crafted as many times, `onCraftedBy`, `Effect.Made`; then the recipe that
// made it, where there is one, used, `awardUsedRecipes`, with the grid's stacks as they are,
// `Effect.Crafted`, and let go where it isn't special, as the player's recipe book is given it.
// `MerchantResultSlot`'s: `carried`'s item crafted as many times, even none, and even where
// nothing's left, which is air. Either way what it's given is none again.
fn take_achievements(s: mut Slots, carried: Tag?, fx: mut List<Effect>) {
    let count = s.removes
    s.removes = 0
    if s.kind == MERCHANT_MENU {
        fx.push(Effect.Made(item_of(carried), count))
        return
    }
    // `FurnaceResultSlot`'s (CAL-336): `carried`'s item crafted as many times, even none, then
    // `awardUsedRecipesAndPopExperience`.
    if s.kind == FURNACE_MENU {
        fx.push(Effect.Made(item_of(carried), count))
        fx.push(Effect.Cooked)
        return
    }
    if count > 0 {
        fx.push(Effect.Made(item_of(carried), count))
    }
    let at = s.used else return
    let (first, width, height) = grid_shape(s)
    var grid = List<Tag?>()
    for i in 0..width * height {
        grid.push(get(s, first + i))
    }
    fx.push(Effect.Crafted(at, grid))
    let special = match s.recipes {
        some(r) => r.value.is_special(at),
        none => false,
    }
    if not special {
        s.used = none
    }
}

// `ResultSlot.onTake`, as the crafting result's taken, `carried` what was: its achievements
// checked, `checkTakeAchievements`; one of each stack the recipe used taken from the grid, and
// what's left of it put back, `getRemainingItems`, onto the stack there where it's the same, else
// in the inventory, else dropped. Each change to the grid is one, so the result's made again
// each time. `MerchantResultSlot.onTake` checks its achievements too, then trades.
fn on_take(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, carried: Tag?, fx: mut List<Effect>) {
    // A brewing stand's bottle, `PotionSlot.onTake` (CAL-337).
    if s.kind == BREWING_MENU and n < 3 {
        fx.push(Effect.Brewed(carried.copy()))
        return
    }
    // A loom's result, `onTake` (CAL-338): one of its banner and its dye taken, each changing its
    // patterns; none picked where either's gone; then its sound.
    // A cartography table's result, `onTake` (CAL-338): one of its map and one of what's added
    // taken, each changing its result, then its sound. The result was made as it was taken,
    // `onCraftedBy`, in `try_remove`; then `setChanged`, its result made again.
    if s.kind == CARTOGRAPHY_MENU and n == 2 {
        _ = remove(mut s, 0, 1, items, mut fx)
        _ = remove(mut s, 1, 1, items, mut fx)
        fx.push(Effect.Charted)
        cartography_changed(mut s, items)
        return
    }
    if s.kind == LOOM_MENU and n == 3 {
        _ = remove(mut s, 0, 1, items, mut fx)
        _ = remove(mut s, 1, 1, items, mut fx)
        if get(s, 0) == none or get(s, 1) == none {
            s.selected = -1
        }
        fx.push(Effect.Woven)
        return
    }
    if not is_result(s, n) {
        return
    }
    if s.kind == STONECUTTER_MENU {
        cut_take(mut s, carried, items, mut fx)
        return
    }
    // A grindstone's result, `onTake`, which doesn't `setChanged` (CAL-338): its experience from
    // what's in its inputs, then both emptied, `setItem`, each making its result again.
    if s.kind == GRINDSTONE_MENU {
        fx.push(Effect.Ground(grind_experience(get(s, 0), get(s, 1), items)))
        set(mut s, 0, none, items, mut fx)
        set(mut s, 1, none, items, mut fx)
        return
    }
    // A smithing table's result, `SmithingMenu.onTake` (CAL-338): its item crafted as many times
    // as were taken, `onCraftedBy`; the recipe used, with the inputs as they are,
    // `awardUsedRecipes`, and let go; one of each input taken, each making its result again; then
    // level event 1044.
    if s.kind == SMITHING_MENU {
        fx.push(Effect.Made(item_of(carried.copy()), count_of(carried)))
        if let at = s.used {
            fx.push(Effect.Crafted(at, [get(s, 0), get(s, 1), get(s, 2)]))
            s.used = none
        }
        for slot in 0usize..3 {
            if let here = get(s, slot) {
                let left = with_count(here.copy(), count_of(some(here)) - 1)
                set(mut s, slot, left, items, mut fx)
            }
        }
        fx.push(Effect.Smithed)
        return
    }
    // An anvil's result, `AnvilMenu.onTake` (CAL-338): as much of what's added as repairing
    // took, or all of it unless it only renamed; its cost gone; its input emptied; then the
    // levels taken and the anvil maybe damaged, `Effect.Anviled`.
    if s.kind == ANVIL_MENU {
        let cost = s.anvil.cost
        if s.anvil.repair_count > 0 {
            let addition = get(s, 1)
            if addition != none and count_of(addition.copy()) > s.anvil.repair_count {
                let left = with_count(addition.copy() ?? Tag.End, count_of(addition) - s.anvil.repair_count)
                set(mut s, 1, left, items, mut fx)
            } else {
                set(mut s, 1, none, items, mut fx)
            }
        } else if not s.anvil.only_renaming {
            set(mut s, 1, none, items, mut fx)
        }
        s.anvil.cost = 0
        set(mut s, 0, none, items, mut fx)
        fx.push(Effect.Anviled(cost))
        return
    }
    take_achievements(mut s, carried, mut fx)
    if s.kind == MERCHANT_MENU {
        merchant_take(mut s, items, mut fx)
        return
    }
    // A furnace's result, `Slot.onTake`'s `setChanged` (CAL-336).
    if s.kind == FURNACE_MENU {
        changed(mut s, n, items, mut fx)
        return
    }
    let input = grid_input(s)
    let left = match s.recipes {
        some(r) => left_in_grid(r.value, input, items),
        none => input.items.copy(),
    }
    let (first, width, _) = grid_shape(s)
    for y in 0..input.height {
        for x in 0..input.width {
            let slot = first + x + input.left + (y + input.top) * width
            var here = get(s, slot)
            if let h = here.copy() {
                // `craftSlots.removeItem(slot, 1)`.
                put(mut s, slot, with_count(h, count_of(here) - 1))
                craft(mut s, items, mut fx)
                here = get(s, slot)
            }
            let back = left[x + y * input.width].copy() else continue
            if here == none {
                put(mut s, slot, some(back))
                craft(mut s, items, mut fx)
            } else if same_components(here, some(back.copy())) {
                put(mut s, slot, with_count(back.copy(), count_of(some(back)) + count_of(here)))
                craft(mut s, items, mut fx)
            } else if let dropped = none_added(add_item(mut s.inv, back, items, who), back) {
                fx.push(Effect.Dropped(dropped, false))
            }
        }
    }
}

// The container's `setChanged`, where slot `n` is the container's (CAL-144). A crafting table's
// result and grid, which no block entity keeps, tell no one (CAL-147); a merchant's slots make
// what its payments buy again, `MerchantContainer.setChanged` (CAL-160).
fn changed(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) {
    // A stonecutter's input, `StonecutterMenu.slotsChanged` (CAL-338); its result's container
    // hears nothing.
    if s.kind == STONECUTTER_MENU {
        if n == 0 {
            cut_input_changed(mut s)
        }
        return
    }
    // A grindstone's inputs, `slotsChanged`: its result made, `createResult`, then its changes
    // broadcast (CAL-338).
    if s.kind == GRINDSTONE_MENU {
        if n < 2 {
            let made = grind_result(get(s, 0), get(s, 1), items)
            put(mut s, 2, made)
            s.broadcast = true
        }
        return
    }
    // A crafter's slots, saved in its block entity, `CrafterSlot.setChanged`'s `slotsChanged`,
    // which broadcasts, its result made again as its listener's told (CAL-338).
    if s.kind == CRAFTER_MENU {
        if n < 9 {
            s.broadcast = true
            fx.push(Effect.Changed)
        }
        return
    }
    // A loom's inputs, `slotsChanged` (CAL-338).
    if s.kind == LOOM_MENU {
        if n < 3 {
            loom_changed(mut s, items)
        }
        return
    }
    // A cartography table's slots, `slotsChanged`, each of its containers telling it (CAL-338).
    if s.kind == CARTOGRAPHY_MENU {
        if n < 3 {
            cartography_changed(mut s, items)
        }
        return
    }
    // A smithing table's inputs, `createResult` (CAL-338): the recipe they match, used, and what
    // it makes, else nothing.
    if s.kind == SMITHING_MENU {
        if n < 3 {
            smith_result(mut s, items)
        }
        return
    }
    // An anvil's inputs, `createResult`, which `server.network` makes with the name typed and
    // the item's name (CAL-338).
    if s.kind == ANVIL_MENU {
        if n < 2 {
            fx.push(Effect.Anvil)
        }
        return
    }
    // An enchanting table's, `slotsChanged`: its offers made again, and where what's in it can be
    // enchanted, its changes broadcast (CAL-338).
    if s.kind == ENCHANTMENT_MENU {
        if n < 2 {
            fx.push(Effect.Enchanting)
            if let stack = get(s, 0) {
                if enchantable(stack, items) {
                    s.broadcast = true
                }
            }
        }
        return
    }
    if s.kind == MERCHANT_MENU {
        if n < s.container.len() {
            update_sell(mut s, items, mut fx)
        }
        return
    }
    if s.kind != INVENTORY_MENU and s.kind != CRAFTING_MENU and s.kind != BEACON_MENU and n < s.container.len() {
        fx.push(Effect.Changed)
    }
}

// `Inventory.placeItemBackInInventory`: `stack` put back, onto a stack of it with room, the held
// one and the offhand's first, else in the first empty slot, each part sent; what has nowhere to
// go would be dropped.
fn place_back(inv: mut Inventory, stack: Tag, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) {
    _ = place_back_as(mut inv, stack, true, items, who, mut fx)
}

// `placeItemBackInInventory(stack, send)`: as `place_back`, each part sent only where `send`
// (CAL-339). What was dropped, which vanilla leaves in the stack it was given.
fn place_back_as(inv: mut Inventory, stack: Tag, send: bool, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    var left: Tag? = some(stack.copy())
    while left != none {
        let s = left.copy() ?? Tag.End
        var slot = room_for(inv, s, items, who)
        if slot < 0 {
            slot = free_slot(inv)
        }
        if slot < 0 {
            // `dropOrPlaceInInventory`'s, as the menu closes.
            fx.push(Effect.Dropped(s.copy(), true))
            return some(s)
        }
        let i = usize.wrap(slot)
        let space = items.max_stack_size(s) - count_of(inv.menu_slot(menu_of(i)))
        let part = min(space, count_of(left))
        left = with_count(s, count_of(left) - part)
        let piece = with_count(s, part) ?? Tag.End
        if add(mut inv, slot, piece, items, who) == none and send {
            fx.push(Effect.Placed(i, inv.menu_slot(menu_of(i))))
        }
    }
    return none
}

/// `Player.addItem`, `Inventory.add` anywhere (CAL-142): what of `stack` didn't go in, `none`
/// where it all did, or where the rest couldn't and the player has infinite materials; `none`
/// where vanilla's `addItem` is `true`.
pub fn add_item(inv: mut Inventory, stack: Tag, items: ItemCodecs, who: Clicker) -> Tag? {
    return add(mut inv, -1, stack, items, who)
}

/// `Inventory.contains(stack)`: whether a slot of the inventory, its armor or its offhand holds
/// the same item with the same components (CAL-142).
pub fn contains_like(inv: Inventory, stack: Tag) -> bool {
    let wanted = some(stack.copy())
    for n in 5usize..46 {
        let here = inv.menu_slot(n)
        if here != none and same_item(here, wanted) and same_components(here, wanted) {
            return true
        }
    }
    return false
}

// `Inventory.add(slot, stack)`, the inventory's own index or -1 for anywhere: what of `stack`
// isn't added, or `none` where it all is or infinite materials take the rest, vanilla's `true`.
fn add(inv: mut Inventory, slot: i32, stack: Tag, items: ItemCodecs, who: Clicker) -> Tag? {
    let given = some(stack.copy())
    if damaged(stack, items) {
        var at = slot
        if at == -1 {
            at = free_slot(inv)
        }
        if at >= 0 {
            inv.set_menu_slot(menu_of(usize.wrap(at)), given)
            return none
        }
        if who.infinite {
            return none
        }
        return given
    }
    var left = count_of(given)
    var last = left
    var going = true
    while going {
        last = left
        left = if slot == -1 { add_anywhere(mut inv, stack, left, items, who) } else { add_resource(mut inv, usize.wrap(slot), stack, left, items) }
        going = left > 0 and left < last
    }
    // Where the last pass put none in, infinite materials take the rest away, whatever went in
    // before it (CAL-164).
    if left == last and who.infinite {
        return none
    }
    if left == 0 {
        return none
    }
    if left < count_of(given) {
        // Some went in, though vanilla's `add` says none did, as its last pass put none in; the
        // rest stays in the stack it was given.
        return with_count(stack, left)
    }
    return given
}

// `Inventory.addResource(stack)`: onto a stack of it with room, else into the first empty slot.
// How many of `count` are left.
fn add_anywhere(inv: mut Inventory, stack: Tag, count: i32, items: ItemCodecs, who: Clicker) -> i32 {
    var slot = room_for(inv, stack, items, who)
    if slot < 0 {
        slot = free_slot(inv)
    }
    if slot < 0 {
        return count
    }
    return add_resource(mut inv, usize.wrap(slot), stack, count, items)
}

// `Inventory.addResource(slot, stack)`: as many of `count` as fit put in the inventory's slot
// `slot`. How many are left.
fn add_resource(inv: mut Inventory, slot: usize, stack: Tag, count: i32, items: ItemCodecs) -> i32 {
    let m = menu_of(slot)
    let here = inv.menu_slot(m)
    let base = here.copy() ?? stack.copy()
    let max = min(99, items.max_stack_size(base))
    let room = max - count_of(here)
    let moved = min(count, room)
    if moved <= 0 {
        return count
    }
    inv.set_menu_slot(m, with_count(base, count_of(here) + moved))
    return count - moved
}

// `getSlotWithRemainingSpace`: the inventory's slot, by its own index, with a stack `stack`
// stacks onto with room: the held one, the offhand's, then the rest in order; else -1.
fn room_for(inv: Inventory, stack: Tag, items: ItemCodecs, who: Clicker) -> i32 {
    let given = some(stack.copy())
    if who.selected >= 0 and who.selected < 9 and has_room(inv.menu_slot(menu_of(usize.wrap(who.selected))), given, items) {
        return who.selected
    }
    if has_room(inv.menu_slot(45), given, items) {
        return 40
    }
    for i in 0..36 {
        if has_room(inv.menu_slot(menu_of(usize.wrap(i))), given, items) {
            return i
        }
    }
    return -1
}

// `hasRemainingSpaceForItem`.
fn has_room(here: Tag?, stack: Tag?, items: ItemCodecs) -> bool {
    let h = here else return false
    return same_components(here, stack) and stackable(here, items) and count_of(here) < min(99, items.max_stack_size(h))
}

// `getFreeSlot`: the first empty slot of the inventory's 36, or -1.
fn free_slot(inv: Inventory) -> i32 {
    for i in 0..36 {
        if inv.menu_slot(menu_of(usize.wrap(i))) == none {
            return i
        }
    }
    return -1
}

// The inventory menu's slot for the inventory's own slot `i`: the hotbar's 9, the 27, the armor
// from the feet, 36 to 39, and the offhand, 40.
fn menu_of(i: usize) -> usize {
    if i < 9 {
        return 36 + i
    }
    if i < 36 {
        return i
    }
    if i == 36 {
        return 8
    }
    if i == 37 {
        return 7
    }
    if i == 38 {
        return 6
    }
    if i == 39 {
        return 5
    }
    return 45
}

/// The stack in slot `n` of the menu `s` are the slots of, as the client's sent it (CAL-144).
pub fn stack_in(s: Slots, n: usize) -> Tag? {
    return get(s, n)
}

// The stack in slot `n`: the inventory menu's, its crafting result first (CAL-147); or a
// container's menu's, the container's, then the inventory menu's 9 to 44 (CAL-144).
/// Whether slot `n` of the menu `s` is of the player's inventory, whose changes set off
/// `inventory_changed`, as `ServerPlayer`'s slot listener tells by `slot.container`: the inventory
/// menu's armor, inventory, hotbar and offhand, or a container's last 36 (CAL-164).
pub fn of_inventory(s: Slots, n: usize) -> bool {
    if s.kind == CRAFTER_MENU {
        return n >= s.container.len() and n < s.container.len() + 36
    }
    if s.kind != INVENTORY_MENU {
        return n >= s.container.len()
    }
    return n >= 5 and n <= 45
}

fn get(s: Slots, n: usize) -> Tag? {
    if s.kind == CRAFTER_MENU and n == s.container.len() + 36 {
        return s.crafted.copy()
    }
    if s.kind != INVENTORY_MENU {
        let size = s.container.len()
        if n < size {
            return s.container[n].copy()
        }
        return s.inv.menu_slot(n - size + 9)
    }
    return s.inv.menu_slot(n)
}

// Slot `n` holding `stack`, as `Container.setItem` holds it, telling no one (CAL-144).
fn put(s: mut Slots, n: usize, stack: own Tag?) {
    if s.kind == CRAFTER_MENU and n == s.container.len() + 36 {
        s.crafted = stack
        return
    }
    if s.kind != INVENTORY_MENU {
        let size = s.container.len()
        if n < size {
            s.container[n] = stack
        } else {
            s.inv.set_menu_slot(n - size + 9, stack)
        }
        return
    }
    s.inv.set_menu_slot(n, stack)
}

// `Slot.mayPlace`: in a shulker box's slots, what `canFitInsideContainerItems`, which a shulker
// box doesn't (CAL-144); nothing in a crafting table's result (CAL-147), nor in what a merchant's
// trade gives, `MerchantResultSlot` (CAL-160); in the inventory menu, nothing in the result,
// armor only where it's equippable there; anything else anywhere else.
fn may_place(s: Slots, n: usize, stack: Tag, items: ItemCodecs) -> bool {
    if s.kind != INVENTORY_MENU {
        if (s.kind == CRAFTING_MENU and n == 0) or (s.kind == MERCHANT_MENU and n == 2) or (s.kind == STONECUTTER_MENU and n == 1) or ((s.kind == GRINDSTONE_MENU or s.kind == ANVIL_MENU) and n == 2) or (s.kind == SMITHING_MENU and n == 3) {
            return false
        }
        // A crafter's (CAL-338): its slots, `CrafterSlot`, where they're not disabled; nothing in
        // its result, `NonInteractiveResultSlot`.
        if s.kind == CRAFTER_MENU and (n < 9 or n == 45) {
            return n < 9 and not s.disabled.contains(i32.wrap(n))
        }
        // A loom's (CAL-338): a banner, a dye, a pattern, and nothing in its result.
        if s.kind == LOOM_MENU and n < 4 {
            return n < 3 and loom_takes(n, stack, items)
        }
        // A cartography table's (CAL-338): a map, paper, an empty map or a glass pane, and nothing
        // in its result.
        if s.kind == CARTOGRAPHY_MENU and n < 3 {
            return n < 2 and cartography_takes(n, stack)
        }
        // A smithing table's template, base and addition, `SmithingMenu`'s recipe property sets
        // (CAL-338).
        if s.kind == SMITHING_MENU and n < 3 {
            let key = if n == 0 { "smithing_template" } else if n == 1 { "smithing_base" } else { "smithing_addition" }
            return in_property_set(s, key, stack, items)
        }
        // An enchanting table's lapis slot: lapis lazuli (CAL-338).
        if s.kind == ENCHANTMENT_MENU and n == 1 {
            return item_of(some(stack.copy())) == "minecraft:lapis_lazuli"
        }
        // A grindstone's inputs: what can be damaged or has enchantments (CAL-338).
        if s.kind == GRINDSTONE_MENU and n < 2 {
            return grindable(stack, items)
        }
        if s.kind == SHULKER_MENU and n < s.container.len() {
            return fits_in_containers(stack)
        }
        // A furnace's (CAL-336): nothing in its result, `FurnaceResultSlot`; fuel or a bucket in
        // its fuel slot, `FurnaceFuelSlot`.
        if s.kind == FURNACE_MENU and n == 2 {
            return false
        }
        if s.kind == FURNACE_MENU and n == 1 {
            return is_fuel(stack, items) or item_of(some(stack.copy())) == "minecraft:bucket"
        }
        // A brewing stand's (CAL-337): potion inputs in its bottles' slots, `PotionSlot`; a
        // reagent in its reagent's, `IngredientsSlot`; fuel in its fuel's, `FuelSlot`.
        if s.kind == BREWING_MENU and n < 3 {
            return potion_input(s, stack, items)
        }
        if s.kind == BREWING_MENU and n == 3 {
            return reagent_slot_takes(s, stack, items)
        }
        if s.kind == BREWING_MENU and n == 4 {
            return brewing_fuel(stack, items)
        }
        // `BeaconMenu.PaymentSlot.mayPlace`: what's `#beacon_payment_items` (D521).
        if s.kind == BEACON_MENU and n == 0 {
            let item = item_of(some(stack.copy()))
            for named in s.payments {
                if named == item {
                    return true
                }
            }
            return false
        }
        // A horse's saddle and body armor, `ArmorSlot.mayPlace`, `isEquippableInSlot`: what's
        // equippable there, by a horse that may use the slot and whose type it allows (CAL-179).
        if s.kind == HORSE_MENU and n < 2 {
            let m = s.mount else return false
            let usable = if n == 0 { m.saddle } else { m.body }
            return usable and equippable_by(stack, if n == 0 { "saddle" } else { "body" }, m.entity, items)
        }
        return true
    }
    if n == 0 {
        return false
    }
    let worn = worn_name(n)
    if n >= 5 and n <= 8 {
        return equippable_in(stack, worn, items)
    }
    return true
}

// `Item.canFitInsideContainerItems`: anything but a shulker box, `BlockItem`'s of a
// `ShulkerBoxBlock`, which are the shulker box and its 16 dyed ones (CAL-144).
fn fits_in_containers(stack: Tag) -> bool {
    let item = item_of(some(stack.copy()))
    return item != "minecraft:shulker_box" and not (item.starts_with("minecraft:") and item.ends_with("_shulker_box"))
}

// `ArmorSlot.mayPickup`: the inventory menu's armor, not with the curse of binding,
// `prevent_armor_change`, out of creative mode.
fn may_pickup(s: Slots, n: usize, items: ItemCodecs, who: Clicker) -> bool {
    // A crafter's result, `NonInteractiveResultSlot`, which can't be taken (CAL-338).
    if s.kind == CRAFTER_MENU and n == 45 {
        return false
    }
    if s.kind == ANVIL_MENU and n == 2 {
        // `AnvilMenu.mayPickup` (CAL-338): a cost, and the levels for it unless the player has
        // infinite materials.
        return (who.infinite or who.levels >= s.anvil.cost) and s.anvil.cost > 0
    }
    if s.kind == MERCHANT_MENU and n == 2 {
        // `MerchantResultSlot.mayPickup` (CAL-160): an offer the payments buy, which they pay
        // for either way round.
        if s.active < 0 or usize.wrap(s.active) >= s.offers.len() {
            return false
        }
        let at = usize.wrap(s.active)
        let (a, b) = (get(s, 0), get(s, 1))
        return satisfied_by(s.offers[at], a.copy(), b.copy(), items) or satisfied_by(s.offers[at], b, a, items)
    }
    let armor = (s.kind == INVENTORY_MENU and n >= 5 and n <= 8) or (s.kind == HORSE_MENU and n < 2)
    if armor and not who.creative {
        if let here = get(s, n) {
            if items.has_enchantment_effect(here, String("minecraft:prevent_armor_change")) {
                return false
            }
        }
    }
    return true
}

// `LivingEntity.isEquippableInSlot` for a player: `equippable` in the slot `worn`, where it
// lets a player wear it.
fn equippable_in(stack: Tag, worn: str, items: ItemCodecs) -> bool {
    return equippable_by(stack, worn, String("minecraft:player"), items)
}

// `isEquippableInSlot`'s equippable for the entity type `entity`: `equippable` in the slot
// `worn`, where it lets that type wear it, `canBeEquippedBy` (CAL-179).
fn equippable_by(stack: Tag, worn: str, entity: String, items: ItemCodecs) -> bool {
    let found = items.component(stack, String("minecraft:equippable")) else return false
    let Tag.Compound(e) = found else return false
    if not e.contains("slot") {
        return false
    }
    let slot = match e["slot"] {
        Tag.Str(s) => s.copy(),
        _ => return false,
    }
    if slot != String(worn) {
        return false
    }
    if not e.contains("allowed_entities") {
        return true
    }
    return items.entity_allowed(e["allowed_entities"], entity)
}

// `getEquipmentSlotForItem` for a player: its `equippable`'s slot, else the main hand.
pub fn equipment_slot_for(stack: Tag, items: ItemCodecs) -> String {
    if let found = items.component(stack, String("minecraft:equippable")) {
        match found {
            Tag.Compound(e) => {
                if e.contains("slot") {
                    match e["slot"] {
                        Tag.Str(s) => return s.copy(),
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    return String("mainhand")
}

// `EquipmentSlot.getIndex` of a worn slot, the feet 0 to the head 3, or -1 for another.
fn armor_index(worn: String) -> i32 {
    return if worn == "feet" { 0 } else if worn == "legs" { 1 } else if worn == "chest" { 2 } else if worn == "head" { 3 } else { -1 }
}

// The equipment slot the menu's slot `n` is, by its codec's name, or empty.
fn worn_name(n: usize) -> str {
    return if n == 5 { "head" } else if n == 6 { "chest" } else if n == 7 { "legs" } else if n == 8 { "feet" } else if n == 45 { "offhand" } else { "" }
}

// `Slot.getMaxStackSize(stack)`: the inventory menu's armor slots hold one, and a beacon's payment
// slot (D521), a furnace's fuel slot a bucket (CAL-336), the rest 99, and no slot more than the
// stack stacks to.
fn max_for(s: Slots, n: usize, stack: Tag, items: ItemCodecs) -> i32 {
    let bucket = s.kind == FURNACE_MENU and n == 1 and item_of(some(stack.copy())) == "minecraft:bucket"
    // A brewing stand's bottles' slots, `PotionSlot.getMaxStackSize` (CAL-337).
    let bottle = s.kind == BREWING_MENU and n < 3
    let slot_max = if (s.kind == INVENTORY_MENU and n >= 5 and n <= 8) or (s.kind == BEACON_MENU and n == 0) or (s.kind == HORSE_MENU and n < 2) or (s.kind == ENCHANTMENT_MENU and n == 0) or bucket or bottle { 1 } else { 99 }
    return min(slot_max, items.max_stack_size(stack))
}

// `canItemQuickReplace(slot, stack, true)`: an empty slot, or one with the same stack, no more
// than it stacks to.
fn quick_replaces(here: Tag?, stack: Tag, items: ItemCodecs) -> bool {
    if here == none {
        return true
    }
    let given = some(stack.copy())
    return same_components(given, here) and count_of(here) <= items.max_stack_size(stack)
}

// `getQuickCraftPlaceCount`.
fn place_count(slots: i32, kind: i32, stack: Tag, items: ItemCodecs) -> i32 {
    let given = some(stack.copy())
    if kind == 0 {
        return count_of(given) / slots
    }
    if kind == 1 {
        return 1
    }
    if kind == 2 {
        return items.max_stack_size(stack)
    }
    return count_of(given)
}

// `isStackable`: more than one to a stack, and not a damaged one.
fn stackable(stack: Tag?, items: ItemCodecs) -> bool {
    let s = stack else return false
    return items.max_stack_size(s) > 1 and not damaged(s, items)
}

// `isDamaged`: damageable, `max_damage` and `damage` and not `unbreakable`, with damage.
fn damaged(stack: Tag, items: ItemCodecs) -> bool {
    let max = match items.component(stack, String("minecraft:max_damage")) {
        some(Tag.Int(n)) => n,
        _ => return false,
    }
    if items.component(stack, String("minecraft:unbreakable")) != none {
        return false
    }
    let damage = match items.component(stack, String("minecraft:damage")) {
        some(Tag.Int(n)) => n,
        _ => return false,
    }
    return min(greater(damage, 0), max) > 0
}

/// A stack's count, 0 for nothing, 1 where `ItemStack.CODEC` wrote none.
pub fn count_of(stack: Tag?) -> i32 {
    let s = stack else return 0
    let Tag.Compound(m) = s else return 0
    if not m.contains("count") {
        return 1
    }
    return match m["count"] {
        Tag.Int(n) => n,
        _ => 1,
    }
}

// `copyWithCount`: `stack` with `n` of it, nothing for none.
/// `copyWithCount`: `stack` with `n` of it, or nothing where `n` isn't more than 0.
pub fn with_count(stack: Tag, n: i32) -> Tag? {
    if n <= 0 {
        return none
    }
    let Tag.Compound(m) = stack else return none
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return some(Tag.Compound(out))
}

// `ItemStack.isSameItem`: the same item, nothing being air.
fn same_item(a: Tag?, b: Tag?) -> bool {
    return item_of(a) == item_of(b)
}

/// `ItemStack.isSameItemSameComponents`: the same item with the same components.
pub fn same_components(a: Tag?, b: Tag?) -> bool {
    if not same_item(a, b) {
        return false
    }
    return same(components_of(a), components_of(b))
}

/// `ItemStack.matches`: the same item with the same components and count, or nothing for both.
pub fn same_stack(a: Tag?, b: Tag?) -> bool {
    if a == none and b == none {
        return true
    }
    return count_of(a) == count_of(b) and same_components(a, b)
}

fn item_of(stack: Tag?) -> String {
    let s = stack else return String("minecraft:air")
    let Tag.Compound(m) = s else return String("minecraft:air")
    return match m["id"] {
        Tag.Str(i) => i.copy(),
        _ => String("minecraft:air"),
    }
}

fn components_of(stack: Tag?) -> Tag {
    if let s = stack {
        match s {
            Tag.Compound(m) => {
                if m.contains("components") {
                    return m["components"].copy()
                }
            },
            _ => {},
        }
    }
    return Tag.Compound(JavaHashMap<String, Tag>())
}

// A count off the network, as `ByteBufCodecs.readCount` reads it for a hash map or a hash set:
// more than 256 throws, and so does fewer than none, as `HashMap`'s constructor does.
fn hashed_count(rd: mut Reader) -> usize ! DecodeError {
    let n = try rd.varint()
    if n > MAX_HASHED {
        fail DecodeError { message: "io.netty.handler.codec.DecoderException: {n} elements exceeded max size of: {MAX_HASHED}" }
    }
    if n < 0 {
        fail DecodeError { message: "java.lang.IllegalArgumentException: Illegal initial capacity: {n}" }
    }
    return usize.wrap(n)
}

// `byIdOrThrow`: an ID of one of `n` entries.
fn known(id: i32, n: usize) ! DecodeError {
    if id < 0 or usize.wrap(id) >= n {
        fail DecodeError { message: "java.lang.IllegalArgumentException: No value with id {id}" }
    }
}

fn has_i32(list: List<i32>, v: i32) -> bool {
    for x in list {
        if x == v {
            return true
        }
    }
    return false
}

fn has_usize(list: List<usize>, v: usize) -> bool {
    for x in list {
        if x == v {
            return true
        }
    }
    return false
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

fn greater(a: i32, b: i32) -> i32 {
    return if a > b { a } else { b }
}

/// What placing a recipe from the recipe book came to, `RecipeBookMenu.PostPlaceAction`
/// (CAL-339): nothing more; its ghost to be shown, `PLACE_GHOST_RECIPE`; or a throw, as
/// vanilla's cast of a recipe of the wrong kind for the menu throws part way.
pub enum BookPlaced {
    Nothing
    Ghost
    Threw
}

/// `handlePlacement` of the recipe `recipe`, by its place among the world's, whose placement is
/// `placing`, on the menu `s` (CAL-339): the inventory menu's grid, a crafting table's, whose
/// grid tells it nothing while it's placed, `beginPlacingRecipe`, then makes its result with the
/// recipe as its hint, `finishPlacingRecipe`, or a furnace's input. `fits` is whether the recipe
/// is of the kind the menu takes, a crafting recipe for a grid or a cooking one for a furnace,
/// whose cast would throw where it isn't; `use_max`, whether as many as can be are placed;
/// `allow_drop`, whether what's in the grid may be dropped where the inventory has no room for
/// it, as in creative mode. `ServerPlaceRecipe.placeRecipe`: where nothing may be dropped and
/// the grid's stacks wouldn't all fit back in the inventory, nothing; else what the inventory's
/// 36 and the grid hold counted, and where they make the recipe once, it placed, else the grid
/// put back and the recipe's ghost shown.
pub fn place_recipe(s: mut Slots, placing: Placing, recipe: usize, fits: bool, use_max: bool, allow_drop: bool, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> BookPlaced {
    let table = s.kind == CRAFTING_MENU
    if table {
        s.placing = true
    }
    let placed = placed_on(mut s, placing, recipe, fits, use_max, allow_drop, items, who, mut fx)
    if table {
        s.placing = false
        // `slotChangedCraftingGrid` with the recipe as its hint, whose `matches` throws where
        // it isn't a crafting recipe.
        if not fits {
            return BookPlaced.Threw
        }
        craft_with(mut s, some(recipe), items, mut fx)
    }
    return placed
}

// `placeRecipe` and `tryPlaceRecipe`, on the menu `s`.
fn placed_on(s: mut Slots, placing: Placing, recipe: usize, fits: bool, use_max: bool, allow_drop: bool, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> BookPlaced {
    let inputs = input_slots(s)
    if not allow_drop and not grid_fits_back(s, inputs, items, who) {
        return BookPlaced.Nothing
    }
    var available = Stacked()
    for i in 0usize..36 {
        account_usable(mut available, s.inv.menu_slot(menu_of(i)), items)
    }
    // `fillCraftSlotsStackedContents`: a grid's usable stacks, a furnace's every one, its fuel
    // and its result too.
    if s.kind == FURNACE_MENU {
        for n in 0usize..3 {
            account_stack(mut available, get(s, n), items)
        }
    } else {
        for n in inputs {
            account_usable(mut available, get(s, n), items)
        }
    }
    if available.can_pick(placing.ingredients, 1) {
        if not fits {
            return BookPlaced.Threw
        }
        place_found(mut s, placing, recipe, mut available, use_max, inputs, items, who, mut fx)
        return BookPlaced.Nothing
    }
    clear_grid(mut s, items, who, mut fx)
    return BookPlaced.Ghost
}

// `ServerPlaceRecipe.placeRecipe(recipe, availableItems)`: where the grid already makes the
// recipe, nothing where a stack of it can't take one more; else how many to make,
// `calculateAmountToCraft`, the items each ingredient uses picked, as many as the fewest of
// their stacks hold at most, the grid put back, and each ingredient's item moved from the
// inventory to its place in the grid, `PlaceRecipeHelper.placeRecipe`.
fn place_found(s: mut Slots, placing: Placing, recipe: usize, available: mut Stacked, use_max: bool, inputs: List<usize>, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) {
    let matched = recipe_matches(s, placing, recipe, items)
    let biggest = available.most_picks(placing.ingredients, i32.MAX)
    if matched {
        for n in inputs {
            let here = get(s, n)
            if let stack = here.copy() {
                if min(biggest, items.max_stack_size(stack)) < count_of(here) + 1 {
                    return
                }
            }
        }
    }
    let amount = amount_to_craft(s, inputs, biggest, matched, use_max)
    var picked = List<String>()
    if not available.try_pick(placing.ingredients, amount, mut picked) {
        return
    }
    // `clampToMaxStackSize`, by each item's own most to a stack.
    var adjusted = amount
    for item in picked {
        var plain = JavaHashMap<String, Tag>()
        plain.insert(String("id"), Tag.Str(item.copy()))
        adjusted = min(adjusted, items.max_stack_size(Tag.Compound(plain)))
    }
    if adjusted != amount {
        picked.clear()
        if not available.try_pick(placing.ingredients, adjusted, mut picked) {
            return
        }
    }
    clear_grid(mut s, items, who, mut fx)
    let (width, height) = grid_size(s)
    let (recipe_width, recipe_height) = if placing.width > 0 { (placing.width, placing.height) } else { (width, height) }
    for (entry, grid) in placement_order(width, height, recipe_width, recipe_height, placing.slots.len()) {
        let ingredient = placing.slots[entry]
        if ingredient < 0 or grid >= inputs.len() {
            continue
        }
        let item = picked[usize.wrap(ingredient)].copy()
        var remaining = adjusted
        while remaining > 0 {
            remaining = move_to_grid(mut s, inputs[grid], item, remaining, items, mut fx)
        }
    }
}

// `calculateAmountToCraft`: as many as can be made where they're all wanted; where the grid makes
// the recipe already, one more than its smallest stack; else one.
fn amount_to_craft(s: Slots, inputs: List<usize>, biggest: i32, matched: bool, use_max: bool) -> i32 {
    if use_max {
        return biggest
    }
    if not matched {
        return 1
    }
    var smallest = i32.MAX
    for n in inputs {
        let here = get(s, n)
        if here != none and smallest > count_of(here) {
            smallest = count_of(here)
        }
    }
    if smallest != i32.MAX {
        smallest += 1
    }
    return smallest
}

// `recipeMatches`: a furnace's input taken by the recipe's ingredient, or the grid making the
// crafting recipe, as its `matches` has it.
fn recipe_matches(s: Slots, placing: Placing, recipe: usize, items: ItemCodecs) -> bool {
    if s.kind == FURNACE_MENU {
        return not placing.ingredients.is_empty() and placing.ingredients[0].test(get(s, 0))
    }
    let r = s.recipes.copy() else return false
    return matches_recipe(r.value, recipe, grid_input(s), items)
}

// `moveItemToGrid`: the first of the inventory's 36 that's `item`, usable for crafting, and the
// same as what the grid's slot `n` holds where it holds anything, `findSlotMatchingCraftingIngredient`;
// -1 where there's none; else as many of it as there are, up to `count`, taken out, put in the
// slot where it's empty, `Slot.set`, or added to its stack, which tells no one. How many of
// `count` are left.
fn move_to_grid(s: mut Slots, n: usize, item: String, count: i32, items: ItemCodecs, fx: mut List<Effect>) -> i32 {
    let here = get(s, n)
    let found = ingredient_slot(s.inv, item, here, items)
    if found < 0 {
        return -1
    }
    let m = menu_of(usize.wrap(found))
    let stack = s.inv.menu_slot(m)
    let have = count_of(stack)
    let base = stack.copy() else return -1
    var taken: Tag? = none
    if count < have {
        taken = with_count(base, count)
        s.inv.set_menu_slot(m, with_count(base, have - count))
    } else {
        taken = stack.copy()
        s.inv.set_menu_slot(m, none)
    }
    let took = count_of(taken)
    if let there = here.copy() {
        put(mut s, n, with_count(there, count_of(here) + took))
    } else {
        set(mut s, n, taken, items, mut fx)
    }
    return count - took
}

// `findSlotMatchingCraftingIngredient`: the inventory's slot of its 36, by its own index, with
// `item` usable for crafting, the same as `existing` where that's anything; else -1.
fn ingredient_slot(inv: Inventory, item: String, existing: Tag?, items: ItemCodecs) -> i32 {
    for i in 0..36 {
        let here = inv.menu_slot(menu_of(usize.wrap(i)))
        if let stack = here.copy() {
            if item_of(here) == item and usable_for_crafting(stack, items) and (existing == none or same_components(existing, here)) {
                return i
            }
        }
    }
    return -1
}

// `Inventory.isUsableForCrafting`: not damaged, not enchanted and not named.
fn usable_for_crafting(stack: Tag, items: ItemCodecs) -> bool {
    if damaged(stack, items) or items.component(stack, String("minecraft:custom_name")) != none {
        return false
    }
    return match items.component(stack, String("minecraft:enchantments")) {
        some(Tag.Compound(levels)) => levels.is_empty(),
        _ => true,
    }
}

// `accountSimpleStack`: a stack counted where it's usable for crafting.
fn account_usable(available: mut Stacked, stack: Tag?, items: ItemCodecs) {
    if let s = stack.copy() {
        if usable_for_crafting(s, items) {
            account_stack(mut available, stack, items)
        }
    }
}

// `accountStack`: a stack counted, as many as it holds, up to its most to a stack.
fn account_stack(available: mut Stacked, stack: Tag?, items: ItemCodecs) {
    let s = stack.copy() else return
    available.account(item_of(stack), min(items.max_stack_size(s), count_of(stack)))
}

// `clearGrid`: each of the slots it puts back, `slotsToClear`, put back in the inventory, unsent,
// what's dropped as it has no room left in the slot, `Slot.set`; then the grid and its result
// emptied, telling no one, `clearCraftingContent`, or a furnace's input and result set to
// nothing.
fn clear_grid(s: mut Slots, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) {
    for n in cleared_slots(s) {
        var left: Tag? = none
        if let stack = get(s, n) {
            left = place_back_as(mut s.inv, stack, false, items, who, mut fx)
        }
        set(mut s, n, left, items, mut fx)
    }
    if s.kind == FURNACE_MENU {
        set(mut s, 0, none, items, mut fx)
        set(mut s, 2, none, items, mut fx)
        return
    }
    put(mut s, 0, none)
    for n in input_slots(s) {
        put(mut s, n, none)
    }
}

// `testClearGrid`: whether each of the grid's stacks would go back in the inventory, onto a stack
// of it with room, else into its empty slots, those counted, stacks of an item going to the same
// empty slot while they fit.
fn grid_fits_back(s: Slots, inputs: List<usize>, items: ItemCodecs, who: Clicker) -> bool {
    var free: usize = 0
    for i in 0usize..36 {
        if s.inv.menu_slot(menu_of(i)) == none {
            free += 1
        }
    }
    var spare = List<Tag>()
    for n in inputs {
        let here = get(s, n)
        let stack = here.copy() else continue
        let slot = room_for(s.inv, stack, items, who)
        if slot == -1 and spare.len() <= free {
            var left = count_of(here)
            for k in 0..spare.len() {
                let there = some(spare[k].copy())
                let most = items.max_stack_size(spare[k])
                if same_item(there, here) and count_of(there) != most and count_of(there) + left <= most {
                    spare[k] = with_count(spare[k], count_of(there) + left) ?? spare[k].copy()
                    left = 0
                    break
                }
            }
            if left > 0 {
                if spare.len() >= free {
                    return false
                }
                spare.push(stack.copy())
            }
        } else if slot == -1 {
            return false
        }
    }
    return true
}

// The slots a recipe's placed in, `getInputGridSlots`: the grid's, or a furnace's input.
fn input_slots(s: Slots) -> List<usize> {
    var out = List<usize>()
    if s.kind == FURNACE_MENU {
        out.push(0)
        return out
    }
    let (first, width, height) = grid_shape(s)
    for i in 0..width * height {
        out.push(first + i)
    }
    return out
}

// The slots placing puts back, `slotsToClear`: the grid's, or a furnace's input and result.
fn cleared_slots(s: Slots) -> List<usize> {
    if s.kind == FURNACE_MENU {
        var out = List<usize>()
        out.push(0)
        out.push(2)
        return out
    }
    return input_slots(s)
}

// How wide and high the grid a recipe's placed in is: a furnace's 1 by 1, else the grid's.
fn grid_size(s: Slots) -> (i32, i32) {
    if s.kind == FURNACE_MENU {
        return (1, 1)
    }
    let (_, width, height) = grid_shape(s)
    return (i32.wrap(width), i32.wrap(height))
}

/// `PlaceRecipeHelper.placeRecipe`: for each of a recipe's `count` slots, in order, until the grid
/// runs out, its place in a grid `width` by `height`, the recipe `recipe_width` by
/// `recipe_height` in its top left, or centred across or down where it's less than half as wide
/// or high, by its place in the grid, `gridIndex`.
pub fn placement_order(width: i32, height: i32, recipe_width: i32, recipe_height: i32, count: usize) -> List<(usize, usize)> {
    var out = List<(usize, usize)>()
    var next: usize = 0
    var index: i32 = 0
    var y: i32 = 0
    while y < height {
        let start_y = i32.saturate((f64(height) / 2.0 - f64(recipe_height) / 2.0).floor())
        if f64(recipe_height) < f64(height) / 2.0 and start_y > y {
            index += width
            y += 1
        }
        var x: i32 = 0
        while x < width {
            if next >= count {
                return out
            }
            let centred = f64(recipe_width) < f64(width) / 2.0
            let start_x = i32.saturate((f64(width) / 2.0 - f64(recipe_width) / 2.0).floor())
            var total = recipe_width
            var adds = x < recipe_width
            if centred {
                total = start_x + recipe_width
                adds = start_x <= x and x < start_x + recipe_width
            }
            if adds {
                out.push((next, usize.wrap(index)))
                next += 1
            } else if total == x {
                index += width - x
                break
            }
            index += 1
            x += 1
        }
        y += 1
    }
    return out
}
// A cartography table's `slotsChanged` (CAL-338): with a result and either input gone, the result
// taken out; else with both inputs, `setupResultSlot`: where its map's data is, `map_facts`, the
// map with `SCALE` from paper where it's `#extendable_maps`, unlocked and under scale 4, with
// `LOCK` from a glass pane where it's unlocked, or two of it from an empty map, each one of it,
// set where it isn't the result already; anything else takes the result out. Each broadcasts.
fn cartography_changed(s: mut Slots, items: ItemCodecs) {
    let map = get(s, 0)
    let extra = get(s, 1)
    let result = get(s, 2)
    if result != none and (map == none or extra == none) {
        put(mut s, 2, none)
        return
    }
    let m = map else return
    let e = extra else return
    let id = map_number(some(m.copy())) else return
    let (scale, locked) = map_fact(s, id) else return
    let extra_item = item_of(some(e.copy()))
    var made: Tag? = none
    if extra_item == "minecraft:paper" and extendable(m.copy(), items) and not locked and scale < 4 {
        made = some(set_component(with_count(m.copy(), 1) ?? Tag.End, "minecraft:map_post_processing", Tag.Str(String("scale")), items))
    } else if extra_item == "minecraft:glass_pane" and not locked {
        made = some(set_component(with_count(m.copy(), 1) ?? Tag.End, "minecraft:map_post_processing", Tag.Str(String("lock")), items))
    } else if extra_item != "minecraft:map" {
        put(mut s, 2, none)
        s.broadcast = true
        return
    } else {
        made = with_count(m.copy(), 2)
    }
    s.broadcast = true
    if not same_stack(made.copy(), result) {
        put(mut s, 2, made)
    }
}

// Whether the stack's item is in `#extendable_maps`.
fn extendable(stack: Tag, items: ItemCodecs) -> bool {
    let id = items.builtin_id("item", item_of(some(stack.copy()))) else return false
    return items.holder_set_has("item", Tag.Str(String("#minecraft:extendable_maps")), id)
}

// The scale and whether it's locked of the map `id`, as the menu was told them, where its data is.
fn map_fact(s: Slots, id: i32) -> (i32, bool)? {
    for (m, scale, locked) in s.map_facts {
        if m == id {
            return some((scale, locked))
        }
    }
    return none
}

// What a cartography table's slot `n` takes: a stack with a map ID; paper, an empty map or a glass
// pane; nothing in its result.
fn cartography_takes(n: usize, stack: Tag) -> bool {
    if n == 0 {
        return map_number(some(stack.copy())) != none
    }
    let item = item_of(some(stack.copy()))
    return n == 1 and (item == "minecraft:paper" or item == "minecraft:map" or item == "minecraft:glass_pane")
}

/// `MapItem.onCraftedPostProcess` of `stack` (CAL-167): its `map_post_processing` taken off, and
/// where it had one and its map's data is, a new map made with the next ID, `getFreeMapId`, as
/// `lockMap` or `scaleMap` makes it, the stack given that ID. Each made is kept in `made_maps`,
/// for the network to make its data.
pub fn post_processed(s: mut Slots, stack: Tag?, items: ItemCodecs) -> Tag? {
    let st = stack.copy() else return none
    let post = items.component(st.copy(), String("minecraft:map_post_processing")) else return stack.copy()
    var out = remove_component(st.copy(), "minecraft:map_post_processing", items)
    let id = map_number(some(st)) else return some(out)
    if map_fact(s, id) == none {
        return some(out)
    }
    let made = s.next_map
    s.next_map += 1
    let lock = match post {
        Tag.Str(p) => p == "lock",
        _ => true,
    }
    s.made_maps.push((made, id, lock))
    out = set_component(out, "minecraft:map_id", Tag.Int(made), items)
    return some(out)
}

// `CartographyTableMenu.quickMoveStack` (CAL-338): the result, made as it's crafted,
// `onCraftedBy`, into the player's slots from the hotbar's last, `onQuickCraft`; an input into
// the player's slots; the player's map into its slot, paper, an empty map or a glass pane into
// the other, anything else between the inventory and the hotbar. What's left is set where it was,
// nothing by the player, then `setChanged`; nothing's given where all of it's left, else the
// slot's `onTake` of what's left, then a broadcast.
fn cartography_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    if n == 2 {
        stack = post_processed(mut s, stack.copy(), items)
        if not move_to(mut s, mut stack, 3, 39, true, items, mut fx) {
            return none
        }
    } else if n > 2 {
        if map_number(some(original.copy())) != none {
            if not move_to(mut s, mut stack, 0, 1, false, items, mut fx) {
                return none
            }
        } else if not cartography_takes(1, original.copy()) {
            if n >= 3 and n < 30 {
                if not move_to(mut s, mut stack, 30, 39, false, items, mut fx) {
                    return none
                }
            } else if n >= 30 and n < 39 and not move_to(mut s, mut stack, 3, 30, false, items, mut fx) {
                return none
            }
        } else if not move_to(mut s, mut stack, 1, 2, false, items, mut fx) {
            return none
        }
    } else if not move_to(mut s, mut stack, 3, 39, false, items, mut fx) {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
    }
    changed(mut s, n, items, mut fx)
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    on_take(mut s, n, items, who, stack.copy(), mut fx)
    s.broadcast = true
    return some(original)
}

// The stack's map ID, its `map_id` component, where it has one.
fn map_number(stack: Tag?) -> i32? {
    let s = stack.copy() ?? Tag.End
    let Tag.Compound(m) = s else return none
    if not m.contains("components") {
        return none
    }
    let Tag.Compound(patch) = m["components"] else return none
    if not patch.contains("minecraft:map_id") {
        return none
    }
    return patch["minecraft:map_id"].number_int()
}
