/// The inventory menu, as vanilla's `InventoryMenu` and the `AbstractContainerMenu` under it run
/// it for a player: what a click does to its 46 slots and to the stack the cursor carries, as
/// `doClick` does it, and what the server knows of the client's slots, as
/// `RemoteSlot.Synchronized` knows it, the stack the server last sent or the hash of the one the
/// client says it has, so only what the client hasn't got is sent again. Each stack is as
/// `ItemStack.CODEC` writes it, or nothing, as `world.inventory` keeps them (CAL-136).
///
/// A container's menu runs the same way over the container's slots and then the player's 36
/// (CAL-144): a chest's, a barrel's or an ender chest's, `ChestMenu`; a shulker box's,
/// `ShulkerBoxMenu`, whose slots take no shulker box; a dispenser's or a dropper's,
/// `DispenserMenu`; and a hopper's, `HopperMenu`, each with its own shift-click. What the click
/// does to the container is `Effect.Changed`, its `setChanged`, for the network to save and tell
/// the comparators by it.
///
/// The crafting grids, the inventory menu's 2 by 2 and a crafting table's 3 by 3, `CraftingMenu`,
/// whose container is its result and its grid, which the menu holds itself, make their result
/// as they change, `Effect.Grid`, against the recipes `Slots` has, as `world.crafting` matches
/// them; taking it uses the grid up, and a shift-click crafts for as long as the grid makes the
/// same (CAL-147).
///
/// What the player throws out as an item, a stack dropped outside the menu or by `THROW`, is
/// `Effect.Thrown`, and what doesn't fit back in the inventory `Effect.Dropped`, for the server
/// to drop as item entities (CAL-148). A bundle's own clicks, `overrideStackedOnOther`, wait for
/// bundles.
module world.menu

import nbt.tag.{Tag}
import protocol.wire.{DecodeError, Reader}
import registry.codec.{same}
import registry.components.{ItemCodecs}
import world.crafting.{Input, remaining as left_in_grid, result as crafted}
import world.inventory.{Inventory, MENU_SLOTS}
import world.recipes.{Recipes}

/// `ContainerInput`'s IDs: what kind of click it is.
pub const PICKUP: i32 = 0
pub const QUICK_MOVE: i32 = 1
pub const SWAP: i32 = 2
pub const CLONE: i32 = 3
pub const THROW: i32 = 4
pub const QUICK_CRAFT: i32 = 5
pub const PICKUP_ALL: i32 = 6

/// `AbstractContainerMenu.SLOT_CLICKED_OUTSIDE`: a click outside the menu.
pub const OUTSIDE: i32 = -999

/// What kind of menu it is, by its slots and its shift-click (CAL-144): the player's inventory
/// menu, `InventoryMenu`; a chest's, a barrel's or an ender chest's, `ChestMenu`; a shulker box's,
/// `ShulkerBoxMenu`; a dispenser's or a dropper's, `DispenserMenu`; a hopper's, `HopperMenu`; and
/// a crafting table's, `CraftingMenu`, its container its result then its 3 by 3 grid (CAL-147);
/// a merchant's, `MerchantMenu`, its container its two payments then what the trade gives
/// (CAL-160); and a beacon's, `BeaconMenu`, its container its payment (D521).
pub const INVENTORY_MENU: i32 = 0
pub const CHEST_MENU: i32 = 1
pub const SHULKER_MENU: i32 = 2
pub const DISPENSER_MENU: i32 = 3
pub const HOPPER_MENU: i32 = 4
pub const CRAFTING_MENU: i32 = 5
pub const MERCHANT_MENU: i32 = 6
pub const BEACON_MENU: i32 = 7

/// Whether a menu of the kind `kind` holds its container's slots itself, as no block entity does:
/// a crafting table's (CAL-147), a merchant's (CAL-160) and a beacon's (D521).
pub fn holds_own(kind: i32) -> bool {
    return kind == CRAFTING_MENU or kind == MERCHANT_MENU or kind == BEACON_MENU
}

/// The slots a click sees (CAL-144): the player's inventory, and for a container's menu what
/// the container holds, its slots first, then the inventory's 27 and its hotbar's 9, as
/// `addStandardInventorySlots` adds them, the inventory menu's 9 to 44.
pub struct Slots {
    pub inv: Inventory
    pub container: List<Tag?> = List<Tag?>()
    pub kind: i32 = INVENTORY_MENU
    /// The recipes a crafting grid is matched against as it changes, none for a world without
    /// them, whose grids make nothing (CAL-147).
    pub recipes: Shared<Recipes>? = none
    /// A merchant's menu's (CAL-160): the merchant's offers, each as `MerchantOffer.CODEC` writes
    /// it, which a trade uses one of up; the trade its client picked, `selectionHint`; and the
    /// offer its payments buy, `activeOffer`, by their places among the offers, -1 for none.
    pub offers: List<Tag> = List<Tag>()
    pub hint: i32 = 0
    pub active: i32 = -1
    /// A beacon's menu's (D521): the items its payment slot takes, `#beacon_payment_items`, by
    /// their names.
    pub payments: List<String> = List<String>()
}

impl Slots {
    /// How many slots the menu has: the inventory menu's 46, or the container's and the
    /// player's 36.
    pub fn count(self) -> usize {
        if self.kind == INVENTORY_MENU {
            return MENU_SLOTS
        }
        return self.container.len() + 36
    }
}

// `HashedPatchMap.STREAM_CODEC`'s most components set and taken away.
const MAX_HASHED: i32 = 256

/// A stack as the client says it has it, vanilla's `HashedStack`: its item, its count, and each
/// component its patch sets, by its type, with its value's hash, as `HashOps.CRC32C_INSTANCE`
/// hashes it, and each type its patch takes away. Made with `HashedStack()`, it's
/// `HashedStack.EMPTY`.
pub struct HashedStack {
    /// The item's network ID, `none` for nothing.
    pub item: i32? = none
    pub count: i32 = 0
    /// Each component type the patch sets, by its network ID, and in `hashes`, its value's hash.
    pub types: List<i32> = List<i32>()
    pub hashes: List<i32> = List<i32>()
    /// Each component type the patch takes away.
    pub removed: List<i32> = List<i32>()
}

impl HashedStack {
    /// `HashedStack.STREAM_CODEC`: whether there's a stack, then its item, its count, and its
    /// `HashedPatchMap`, the types it sets with their hashes, then those it takes away, at most
    /// 256 of each, read into a hash map and a hash set, so a type given twice is there once, the
    /// later hash in place of the earlier. `items` and `types` are how many items and component
    /// types there are: an ID past them throws, as `byIdOrThrow` does.
    pub fn read(rd: mut Reader, items: usize, types: usize) -> HashedStack ! DecodeError {
        if not try rd.bool() {
            return HashedStack()
        }
        let item = try rd.varint()
        try known(item, items)
        let count = try rd.varint()
        var h = HashedStack { item: some(item), count: count }
        let given = try hashed_count(mut rd)
        for _ in 0..given {
            let t = try rd.varint()
            try known(t, types)
            let hash = try rd.i32()
            var found = false
            for i in 0..h.types.len() {
                if h.types[i] == t {
                    h.hashes[i] = hash
                    found = true
                }
            }
            if not found {
                h.types.push(t)
                h.hashes.push(hash)
            }
        }
        let taken = try hashed_count(mut rd)
        for _ in 0..taken {
            let t = try rd.varint()
            try known(t, types)
            if not has_i32(h.removed, t) {
                h.removed.push(t)
            }
        }
        return h
    }

    /// `matches`: whether `stack` is the stack this says, its count, its item and its patch, the
    /// same types taken away and each component set hashing the same, with `items`' codecs.
    pub fn matches(self, stack: Tag?, items: ItemCodecs) -> bool {
        let want = self.item else return stack == none
        var item = items.builtin_id("item", String("minecraft:air")) ?? 0
        var count = 0
        var patch = JavaHashMap<String, Tag>()
        if let t = stack {
            let Tag.Compound(m) = t else return false
            item = match m["id"] {
                Tag.Str(s) => items.builtin_id("item", s.copy()) ?? -1,
                _ => -1,
            }
            count = count_of(stack)
            if m.contains("components") {
                match m["components"] {
                    Tag.Compound(p) => patch = p.copy(),
                    _ => {},
                }
            }
        }
        if self.count != count or want != item {
            return false
        }
        var removed: usize = 0
        var added: usize = 0
        for (k, _) in patch {
            if k.starts_with("!") {
                let t = items.builtin_id("data_component_type", k[1..].copy()) else return false
                if not has_i32(self.removed, t) {
                    return false
                }
                removed += 1
            } else {
                added += 1
            }
        }
        if removed != self.removed.len() or added != self.types.len() {
            return false
        }
        for (k, v) in patch {
            if k.starts_with("!") {
                continue
            }
            let t = items.builtin_id("data_component_type", k.copy()) else return false
            var expected: i32? = none
            for i in 0..self.types.len() {
                if self.types[i] == t {
                    expected = some(self.hashes[i])
                }
            }
            let e = expected else return false
            if items.component_hash(k.copy(), v) != e {
                return false
            }
        }
        return true
    }
}

/// What the server knows of one of the client's slots, or of what its cursor carries, as
/// `RemoteSlot.Synchronized` knows it.
pub enum Remote {
    /// Nothing yet, which matches no stack.
    Unknown
    /// `force`: the stack the server sent, or nothing.
    Sent(Tag?)
    /// `receive`: the hash of the stack the client says it has.
    Hashed(HashedStack)
}

/// What a click or a close does beyond the menu's slots, in the order it happens, for the
/// network to carry out.
pub enum Effect {
    /// The crafting grid of the menu of the kind given, the inventory menu's or a crafting
    /// table's, changed, so `slotChangedCraftingGrid` set the result to this, which it takes as
    /// the client's and sends, slot 0, with that menu's next state ID (CAL-147).
    Grid(i32, Tag?)
    /// `onEquipItem`: the equipment slot, by its codec's name, the stack that was there and the
    /// one put there, for the equip sound.
    Equip(String, Tag?, Tag?)
    /// `placeItemBackInInventory` put some of a stack in the inventory's slot, by the
    /// inventory's own index, which is sent as `ClientboundSetPlayerInventoryPacket` with what
    /// the slot has once it's there.
    Placed(usize, Tag?)
    /// A stack dropped from the player's hand, `drop(stack, false)`, as an item entity
    /// (CAL-148), and whether it's the server's alone, `Prediction.SERVER_ONLY`, as what a menu
    /// gives back as it closes is, whose swing they're sent too (D521).
    Dropped(Tag, bool)
    /// A stack the player threw, `drop(stack, true)`, which keeps them as its thrower.
    Thrown(Tag)
    /// The container's `setChanged`, as a slot of it is set, taken from or clicked (CAL-144).
    Changed
    /// What a merchant's payments buy made again, `notifyTradeUpdated`, and whether they buy
    /// anything, which the merchant says yes or no to (CAL-160).
    TradeUpdated(bool)
    /// A merchant's offer, by its place among them, traded, `notifyTrade` (CAL-160).
    Traded(i32)
}

/// What a click needs of the player clicking.
pub struct Clicker {
    /// `hasInfiniteMaterials`, as creative mode has.
    pub infinite: bool = false
    /// `isCreative`.
    pub creative: bool = false
    /// The hotbar slot they hold, which a stack put back in the inventory goes to first.
    pub selected: i32 = 0
}

/// A menu's state beyond its slots, which `world.inventory` and the container keep: the
/// inventory menu's, made with `Menu()`, or a container's, made with `Menu.of` (CAL-144).
pub struct Menu {
    /// The stack the cursor carries, `getCarried`.
    pub carried: Tag? = none
    /// How many slots it has.
    size: usize = MENU_SLOTS
    remote: List<Remote> = List<Remote>()
    /// The cursor's, `none` for `Remote.Unknown`.
    remote_carried: Remote? = none
    /// Whether the client has been sent the whole menu, before which there's no client to send
    /// changes to, as there's no `synchronizer`.
    synced: bool = false
    /// `suppressRemoteUpdates`, which a click holds while it's handled, and which stays where
    /// the click throws, until the next click resumes it.
    suppressed: bool = false
    quickcraft_status: i32 = 0
    quickcraft_type: i32 = -1
    quickcraft_slots: List<usize> = List<usize>()
}

impl Menu {
    /// A container's menu of `size` slots, the container's and the player's 36, with nothing
    /// carried and nothing sent (CAL-144).
    pub fn of(size: usize) -> Menu {
        return Menu { size: size }
    }

    /// How many slots it has.
    pub fn slots(self) -> usize {
        return self.size
    }

    /// `sendAllDataToRemote`, as far as the client goes: it's sent every slot of `s` and what
    /// the cursor carries, which the server takes as the client's.
    pub fn sent_all(mut self, s: Slots) {
        self.remote = List<Remote>()
        for n in 0..self.size {
            self.remote.push(Remote.Sent(get(s, n)))
        }
        self.remote_carried = some(Remote.Sent(self.carried.copy()))
        self.synced = true
    }

    /// `setRemoteSlot`: the client has `stack` in slot `n`, as the server sent it or put it.
    pub fn set_remote(mut self, n: usize, stack: Tag?) {
        self.fill_remote()
        if n < self.size {
            self.remote[n] = Remote.Sent(stack.copy())
        }
    }

    /// `setRemoteSlotUnsafe`: the client says slot `n` has the stack `h` hashes, where `n` is one.
    pub fn receive(mut self, n: i32, h: HashedStack) {
        self.fill_remote()
        if n >= 0 and usize.wrap(n) < self.size {
            self.remote[usize.wrap(n)] = Remote.Hashed(h.copy())
        }
    }

    /// `transferState` into the inventory menu from `other`, a container's menu, as it's closed
    /// (CAL-144): what the server knows of the client's slots of the player's inventory, the
    /// container's menu's last 36, taken for the inventory menu's 9 to 44.
    pub fn transfer_from(mut self, other: Menu) {
        self.fill_remote()
        if other.size < 36 or other.remote.len() < other.size {
            return
        }
        let offset = other.size - 36
        for i in 0usize..36 {
            self.remote[9 + i] = other.remote[offset + i].copy()
        }
    }

    /// `setRemoteCarried`: the client says its cursor carries the stack `h` hashes.
    pub fn receive_carried(mut self, h: HashedStack) {
        self.remote_carried = some(Remote.Hashed(h.copy()))
    }

    /// `suppressRemoteUpdates`.
    pub fn suppress(mut self) {
        self.suppressed = true
    }

    /// `resumeRemoteUpdates`.
    pub fn resume(mut self) {
        self.suppressed = false
    }

    /// `broadcastChanges`, as far as the client goes: each slot of `s` the client hasn't got,
    /// then what the cursor carries, by slot, -1 for the cursor, with the stack, which the
    /// server sends and from then takes as the client's. Nothing while remote updates are held.
    pub fn changes(mut self, s: Slots, items: ItemCodecs) -> List<(i32, Tag?)> {
        var out = List<(i32, Tag?)>()
        if self.suppressed or not self.synced {
            return out
        }
        self.fill_remote()
        for n in 0..self.size {
            let current = get(s, n)
            let state = knows(self.remote[n], current, items)
            if state == NO {
                self.remote[n] = Remote.Sent(current.copy())
                out.push((i32.wrap(n), current))
            } else if state == LEARNED {
                self.remote[n] = Remote.Sent(current)
            }
        }
        let carried = self.carried.copy()
        let state = match self.remote_carried {
            some(r) => knows(r, carried, items),
            none => NO,
        }
        if state == NO {
            self.remote_carried = some(Remote.Sent(carried.copy()))
            out.push((-1, carried))
        } else if state == LEARNED {
            self.remote_carried = some(Remote.Sent(carried))
        }
        return out
    }

    /// `clicked`: what the client's click on slot `slot` with `button`, of the kind `input`,
    /// does to the slots `s` and the cursor, as `doClick` does it, with what else it does in `fx`.
    /// `false` where vanilla throws, as it does for a swap or a drag onto a slot under 0, having
    /// changed nothing. `slot` is one `isValidSlotIndex` lets through.
    pub fn click(mut self, s: mut Slots, items: ItemCodecs, who: Clicker, slot: i32, button: i32, input: i32, fx: mut List<Effect>) -> bool {
        if input == QUICK_CRAFT {
            let expected = self.quickcraft_status
            self.quickcraft_status = button & 3
            if (expected != 1 or self.quickcraft_status != 2) and expected != self.quickcraft_status {
                self.reset_quickcraft()
            } else if self.carried == none {
                self.reset_quickcraft()
            } else if self.quickcraft_status == 0 {
                self.quickcraft_type = (button >> 2) & 3
                if self.quickcraft_type == 0 or self.quickcraft_type == 1 or (self.quickcraft_type == 2 and who.infinite) {
                    self.quickcraft_status = 1
                    self.quickcraft_slots = List<usize>()
                } else {
                    self.reset_quickcraft()
                }
            } else if self.quickcraft_status == 1 {
                if slot < 0 {
                    return false
                }
                let n = usize.wrap(slot)
                let c = self.carried.copy() ?? Tag.End
                if quick_replaces(get(s, n), c, items) and may_place(s, n, c, items) and (self.quickcraft_type == 2 or count_of(self.carried) > i32.wrap(self.quickcraft_slots.len())) {
                    if not has_usize(self.quickcraft_slots, n) {
                        self.quickcraft_slots.push(n)
                    }
                }
            } else if self.quickcraft_status == 2 {
                if not self.quickcraft_slots.is_empty() {
                    if self.quickcraft_slots.len() == 1 {
                        let only = self.quickcraft_slots[0]
                        let kind = self.quickcraft_type
                        self.reset_quickcraft()
                        return self.click(mut s, items, who, i32.wrap(only), kind, PICKUP, mut fx)
                    }
                    let source = self.carried.copy() ?? Tag.End
                    var remaining = count_of(self.carried)
                    let size = i32.wrap(self.quickcraft_slots.len())
                    for n in self.quickcraft_slots.copy() {
                        if quick_replaces(get(s, n), source, items) and may_place(s, n, source, items) and (self.quickcraft_type == 2 or count_of(self.carried) >= size) {
                            let carry = count_of(get(s, n))
                            let max = min(items.max_stack_size(source), max_for(s, n, source, items))
                            let placed = min(place_count(size, self.quickcraft_type, source, items) + carry, max)
                            remaining -= placed - carry
                            let was = get(s, n)
                            set_by_player(mut s, n, with_count(source, placed), was, items, mut fx)
                        }
                    }
                    self.carried = with_count(source, remaining)
                }
                self.reset_quickcraft()
            } else {
                self.reset_quickcraft()
            }
            return true
        }
        if self.quickcraft_status != 0 {
            self.reset_quickcraft()
            return true
        }
        if (input == PICKUP or input == QUICK_MOVE) and (button == 0 or button == 1) {
            let primary = button == 0
            if slot == OUTSIDE {
                // The cursor's stack, or one of it, thrown out as an item.
                if let c = self.carried.copy() {
                    if primary {
                        fx.push(Effect.Thrown(c))
                        self.carried = none
                    } else {
                        let one = with_count(c, 1) ?? Tag.End
                        fx.push(Effect.Thrown(one))
                        self.carried = with_count(c, count_of(self.carried) - 1)
                    }
                }
                return true
            }
            if slot < 0 {
                return true
            }
            let n = usize.wrap(slot)
            if input == QUICK_MOVE {
                if not may_pickup(s, n, items, who) {
                    return true
                }
                var clicked = quick_move(mut s, n, items, who, mut fx)
                while clicked != none and same_item(get(s, n), clicked) {
                    clicked = quick_move(mut s, n, items, who, mut fx)
                }
                return true
            }
            let clicked = get(s, n)
            let carried = self.carried.copy()
            if clicked == none {
                if let c = carried {
                    let amount = if primary { count_of(carried) } else { 1 }
                    self.carried = safe_insert(mut s, n, c, amount, items, mut fx)
                }
            } else if may_pickup(s, n, items, who) {
                match carried {
                    none => {
                        let amount = if primary { count_of(clicked) } else { (count_of(clicked) + 1) / 2 }
                        if let taken = try_remove(mut s, n, amount, i32.MAX, items, who, mut fx) {
                            self.carried = some(taken)
                            on_take(mut s, n, items, who, mut fx)
                        }
                    },
                    some(c) => {
                        if may_place(s, n, c, items) {
                            if same_components(clicked, carried) {
                                let amount = if primary { count_of(carried) } else { 1 }
                                self.carried = safe_insert(mut s, n, c, amount, items, mut fx)
                            } else if count_of(carried) <= max_for(s, n, c, items) {
                                self.carried = clicked.copy()
                                set_by_player(mut s, n, carried, clicked, items, mut fx)
                            }
                        } else if same_components(clicked, carried) {
                            let room = items.max_stack_size(c) - count_of(carried)
                            if let taken = try_remove(mut s, n, count_of(clicked), room, items, who, mut fx) {
                                self.carried = with_count(c, count_of(carried) + count_of(some(taken)))
                                on_take(mut s, n, items, who, mut fx)
                            }
                        }
                    },
                }
            }
            // `slot.setChanged`, whatever the click did.
            changed(mut s, n, items, mut fx)
            return true
        }
        if input == SWAP and ((button >= 0 and button < 9) or button == 40) {
            if slot < 0 {
                return false
            }
            let n = usize.wrap(slot)
            // The inventory's own slot the key is for, `inventory.getItem(buttonNum)`.
            let from = menu_of(usize.wrap(button))
            let source = s.inv.menu_slot(from)
            let target = get(s, n)
            if source == none and target == none {
                return true
            }
            if source == none {
                if may_pickup(s, n, items, who) {
                    s.inv.set_menu_slot(from, target.copy())
                    let was = get(s, n)
                    set_by_player(mut s, n, none, was, items, mut fx)
                    on_take(mut s, n, items, who, mut fx)
                }
            } else if target == none {
                let t = source.copy() ?? Tag.End
                if may_place(s, n, t, items) {
                    let max = max_for(s, n, t, items)
                    if count_of(source) > max {
                        s.inv.set_menu_slot(from, with_count(t, count_of(source) - max))
                        set_by_player(mut s, n, with_count(t, max), none, items, mut fx)
                    } else {
                        s.inv.set_menu_slot(from, none)
                        set_by_player(mut s, n, source, none, items, mut fx)
                    }
                }
            } else {
                let t = source.copy() ?? Tag.End
                if may_pickup(s, n, items, who) and may_place(s, n, t, items) {
                    let max = max_for(s, n, t, items)
                    if count_of(source) > max {
                        s.inv.set_menu_slot(from, with_count(t, count_of(source) - max))
                        set_by_player(mut s, n, with_count(t, max), target, items, mut fx)
                        let back = target.copy() ?? Tag.End
                        if let left = none_added(add(mut s.inv, -1, back, items, who), back) {
                            fx.push(Effect.Thrown(left))
                        }
                    } else {
                        s.inv.set_menu_slot(from, target.copy())
                        set_by_player(mut s, n, source, target, items, mut fx)
                    }
                }
            }
            return true
        }
        if input == CLONE and who.infinite and self.carried == none and slot >= 0 {
            let n = usize.wrap(slot)
            if let here = get(s, n) {
                self.carried = with_count(here, items.max_stack_size(here))
            }
            return true
        }
        if input == THROW {
            // One of the slot's stack, or all of it, thrown out as an item, `safeTake`n; all of
            // it again for as long as the slot holds the same item, as a crafting result does.
            if self.carried != none or slot < 0 {
                return true
            }
            let n = usize.wrap(slot)
            let amount = if button == 0 { 1 } else { count_of(get(s, n)) }
            var thrown = safe_take(mut s, n, amount, items, who, mut fx)
            if let t = thrown.copy() {
                fx.push(Effect.Thrown(t))
            }
            if button == 1 {
                while thrown != none and same_item(get(s, n), thrown) {
                    thrown = safe_take(mut s, n, amount, items, who, mut fx)
                    if let t = thrown.copy() {
                        fx.push(Effect.Thrown(t))
                    }
                }
            }
            return true
        }
        if input == PICKUP_ALL and slot >= 0 {
            let n = usize.wrap(slot)
            let c0 = self.carried.copy() else return true
            if get(s, n) != none and may_pickup(s, n, items, who) {
                return true
            }
            let total = s.count()
            let start = if button == 0 { 0 } else { i32.wrap(total) - 1 }
            let step = if button == 0 { 1 } else { -1 }
            let max = items.max_stack_size(c0)
            for pass in 0..2 {
                var i = start
                while i >= 0 and i < i32.wrap(total) and count_of(self.carried) < max {
                    let m = usize.wrap(i)
                    let here = get(s, m)
                    // `canTakeItemForPickAll`: not from a crafting result, nor anywhere in a
                    // merchant's menu (CAL-160).
                    let takes = not is_result(s, m) and s.kind != MERCHANT_MENU
                    if here != none and takes and quick_replaces(here, c0, items) and may_pickup(s, m, items, who) {
                        let h = here.copy() ?? Tag.End
                        if pass != 0 or count_of(here) != items.max_stack_size(h) {
                            let room = max - count_of(self.carried)
                            if let taken = try_remove(mut s, m, count_of(here), room, items, who, mut fx) {
                                self.carried = with_count(c0, count_of(self.carried) + count_of(some(taken)))
                            }
                        }
                    }
                    i += step
                }
            }
            return true
        }
        return true
    }

    /// `removed`, as the player closes the menu: what the cursor carries put back in the
    /// inventory, as `placeItemBackInInventory` puts it, then for the inventory menu, as
    /// `InventoryMenu.removed` does, or a crafting table's, as `CraftingMenu.removed` does, each
    /// stack in the crafting grid, or for a merchant's, as `MerchantMenu.removed` does, its two
    /// payments, with what that sends in `fx` (CAL-160). A container's `stopOpen` is the
    /// network's, and so's the merchant's trading player let go.
    pub fn close(mut self, s: mut Slots, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) {
        if let c = self.carried.take() {
            place_back(mut s.inv, c, items, who, mut fx)
        }
        if s.kind == MERCHANT_MENU {
            for slot in 0usize..2 {
                // `removeItemNoUpdate`.
                let here = get(s, slot)
                put(mut s, slot, none)
                if let stack = here {
                    place_back(mut s.inv, stack, items, who, mut fx)
                }
            }
            return
        }
        if s.kind == BEACON_MENU {
            // `BeaconMenu.removed`: its payment taken and dropped, `drop(stack, false)` (D521).
            let here = get(s, 0)
            put(mut s, 0, none)
            if let stack = here {
                fx.push(Effect.Dropped(stack, true))
            }
            return
        }
        if s.kind != INVENTORY_MENU and s.kind != CRAFTING_MENU {
            return
        }
        // `resultSlots.clearContent`, which sends nothing; a crafting table's goes with its menu.
        put(mut s, 0, none)
        let (first, width, height) = grid_shape(s)
        for slot in first..first + width * height {
            // `removeItemNoUpdate`, which doesn't tell the menu.
            let here = get(s, slot)
            put(mut s, slot, none)
            if let stack = here {
                place_back(mut s.inv, stack, items, who, mut fx)
            }
        }
    }

    fn reset_quickcraft(mut self) {
        self.quickcraft_status = 0
        self.quickcraft_slots = List<usize>()
    }

    fn fill_remote(mut self) {
        while self.remote.len() < self.size {
            self.remote.push(Remote.Unknown)
        }
    }
}

// What `knows` finds: the remote slot doesn't match; it does; or it does by the hash the client
// sent, so the server now has the stack.
const NO: i32 = 0
const YES: i32 = 1
const LEARNED: i32 = 2

/// `setByPlayer` on the inventory menu's slot `n`, as a creative player's slot is set: `stack`
/// put there, its grid matched against `recipes`, with what that does in `fx`.
pub fn put_by_player(inv: mut Inventory, recipes: Shared<Recipes>?, n: usize, stack: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    var s = Slots { inv: inv.copy(), recipes: recipes.copy() }
    let was = get(s, n)
    set_by_player(mut s, n, stack, was, items, mut fx)
    inv = s.inv
}

/// `MerchantContainer.updateSellItem` of a merchant's menu's slots `s` (CAL-160): no offer the
/// payments buy, then, with the first payment, or the second where the first's empty, and the
/// other, nothing given where there's neither; else, where the merchant has offers, the offer
/// they buy, the picked one where it isn't the first, `getRecipeFor`, else the other way
/// round where none is or it's out of stock, given where it's in stock, `assemble`, else nothing.
/// Then, but where there was neither, the merchant's told, `notifyTradeUpdated`.
pub fn update_sell(s: mut Slots, items: ItemCodecs, fx: mut List<Effect>) {
    s.active = -1
    var a = get(s, 0)
    var b = get(s, 1)
    if a == none {
        a = b.copy()
        b = none
    }
    if a == none {
        put(mut s, 2, none)
        return
    }
    if not s.offers.is_empty() {
        var o = recipe_for(s, a.copy(), b.copy(), items)
        if o < 0 or out_of_stock(s.offers[usize.wrap(o)]) {
            s.active = o
            o = recipe_for(s, b, a, items)
        }
        if o >= 0 and not out_of_stock(s.offers[usize.wrap(o)]) {
            s.active = o
            let given = sold(s.offers[usize.wrap(o)])
            put(mut s, 2, some(given))
        } else {
            put(mut s, 2, none)
        }
    }
    fx.push(Effect.TradeUpdated(get(s, 2) != none))
}

/// `ServerboundSelectTradePacket` in a merchant's menu, the offer at `index` picked (CAL-160):
/// `setSelectionHint`, what the payments buy made again; then `tryMoveItems`: where it's an
/// offer, each payment moved back into the player's slots from the hotbar's last, stopping where
/// one won't move at all, then, where both are empty, the offer's costs filled from the player's
/// slots, `moveFromInventoryToPaymentSlot`.
pub fn select_trade(s: mut Slots, index: i32, items: ItemCodecs, fx: mut List<Effect>) {
    s.hint = index
    update_sell(mut s, items, mut fx)
    if index < 0 or usize.wrap(index) >= s.offers.len() {
        return
    }
    for slot in 0usize..2 {
        let here = get(s, slot) else continue
        var stack: Tag? = some(here)
        if not move_to(mut s, mut stack, 3, 39, true, items, mut fx) {
            return
        }
        // `tradeContainer.setItem`.
        put(mut s, slot, stack)
        update_sell(mut s, items, mut fx)
    }
    if get(s, 0) == none and get(s, 1) == none {
        let offer = compound(s.offers[usize.wrap(index)])
        fill_payment(mut s, 0, field(offer, "buy"), items, mut fx)
        if offer.contains("buyB") {
            fill_payment(mut s, 1, field(offer, "buyB"), items, mut fx)
        }
    }
}

// `MerchantMenu.moveFromInventoryToPaymentSlot`: each of the player's stacks the cost takes moved
// onto the payment, where it's empty or the same, as many as it holds, each move set,
// `setItem`, till it's full.
fn fill_payment(s: mut Slots, slot: usize, cost: Tag, items: ItemCodecs, fx: mut List<Effect>) {
    for i in 3usize..39 {
        let have = get(s, i) else continue
        if not cost_takes(cost, have, items) {
            continue
        }
        let paid = get(s, slot)
        if paid != none and not same_components(some(have.copy()), paid.copy()) {
            continue
        }
        let max = items.max_stack_size(have)
        let moving = min(max - count_of(paid), count_of(some(have.copy())))
        let now = with_count(have, count_of(paid) + moving)
        // `shrink`, which tells no one.
        put(mut s, i, with_count(have, count_of(some(have.copy())) - moving))
        put(mut s, slot, now.copy())
        update_sell(mut s, items, mut fx)
        if count_of(now) >= max {
            break
        }
    }
}

// `MerchantResultSlot.onTake`, as what the trade gives is taken: where its payments buy an offer,
// paid for either way round, `MerchantOffer.take`, the merchant told, `notifyTrade`, the offer's
// uses up one, and each payment set again, `setItem`, what they buy made again each time. The
// player's trade statistic waits for statistics (CAL-164), and the item's crafted statistic,
// `checkTakeAchievements`, too.
fn merchant_take(s: mut Slots, items: ItemCodecs, fx: mut List<Effect>) {
    if s.active < 0 or usize.wrap(s.active) >= s.offers.len() {
        return
    }
    let at = usize.wrap(s.active)
    let (a, b) = (get(s, 0), get(s, 1))
    var paid: (Tag?, Tag?)? = none
    if let (x, y) = paid_with(s.offers[at], a.copy(), b.copy(), items) {
        paid = some((x, y))
    } else if let (x, y) = paid_with(s.offers[at], b, a, items) {
        paid = some((y, x))
    }
    let (left_a, left_b) = paid else return
    fx.push(Effect.Traded(s.active))
    s.offers[at] = used(s.offers[at])
    put(mut s, 0, left_a)
    update_sell(mut s, items, mut fx)
    put(mut s, 1, left_b)
    update_sell(mut s, items, mut fx)
}

// `MerchantOffers.getRecipeFor`: the picked offer, where it isn't the first and is among them,
// if `a` and `b` buy it; else the first they buy; -1 for none.
fn recipe_for(s: Slots, a: Tag?, b: Tag?, items: ItemCodecs) -> i32 {
    if s.hint > 0 and usize.wrap(s.hint) < s.offers.len() {
        return if satisfied_by(s.offers[usize.wrap(s.hint)], a, b, items) { s.hint } else { -1 }
    }
    for i in 0..s.offers.len() {
        if satisfied_by(s.offers[i], a.copy(), b.copy(), items) {
            return i32.wrap(i)
        }
    }
    return -1
}

// `MerchantOffer.satisfiedBy`: `a` the first cost's, as many as its price, and `b` the second
// cost's, as many as it, or nothing where there's no second.
fn satisfied_by(offer: Tag, a: Tag?, b: Tag?, items: ItemCodecs) -> bool {
    let m = compound(offer)
    let buy = field(m, "buy")
    let first = a else return false
    if not cost_takes(buy, first, items) or count_of(some(first.copy())) < price(m, buy, items) {
        return false
    }
    if not m.contains("buyB") {
        return b == none
    }
    let other = field(m, "buyB")
    let second = b else return false
    return cost_takes(other, second, items) and count_of(some(second.copy())) >= count_of(some(other))
}

// `MerchantOffer.take`: where `a` and `b` buy the offer, each less its cost, the first's price and
// the second's count.
fn paid_with(offer: Tag, a: Tag?, b: Tag?, items: ItemCodecs) -> (Tag?, Tag?)? {
    if not satisfied_by(offer.copy(), a.copy(), b.copy(), items) {
        return none
    }
    let m = compound(offer)
    let buy = field(m, "buy")
    let first = a.copy() ?? Tag.End
    let left_a = with_count(first.copy(), count_of(some(first)) - price(m, buy, items))
    if not m.contains("buyB") {
        return some((left_a, b.copy()))
    }
    let second = b.copy() ?? Tag.End
    let left_b = with_count(second.copy(), count_of(some(second)) - count_of(some(field(m, "buyB"))))
    return some((left_a, left_b))
}

// `MerchantOffer.getModifiedCostCount` of the offer `m`'s cost `cost`: its count, more by its
// count times the offer's demand times its multiplier where that's above nought, floored, and by
// its special price, from 1 to as many as its stack holds.
fn price(m: JavaHashMap<String, Tag>, cost: Tag, items: ItemCodecs) -> i32 {
    let base = count_of(some(cost.copy()))
    let demand = number(m, "demand", 0)
    let multiplier = if m.contains("priceMultiplier") { m["priceMultiplier"].number_float() ?? 0.0f32 } else { 0.0f32 }
    let more = greater(0, i32.saturate(f64(f32.nearest(base * demand) * multiplier).floor()))
    let total = base + more + number(m, "specialPrice", 0)
    return greater(1, min(total, items.max_stack_size(cost)))
}

// `ItemCost.test`: the cost's item, with each component it names as it has it.
fn cost_takes(cost: Tag, stack: Tag, items: ItemCodecs) -> bool {
    let m = compound(cost)
    if item_of(some(stack.copy())) != item_of(some(cost.copy())) {
        return false
    }
    if not m.contains("components") {
        return true
    }
    for (k, v) in compound(m["components"].copy()) {
        let have = items.component(stack.copy(), k.copy()) else return false
        if not same(have, v.copy()) {
            return false
        }
    }
    return true
}

// `MerchantOffer.isOutOfStock`: its uses at its most or more.
fn out_of_stock(offer: Tag) -> bool {
    let m = compound(offer)
    return number(m, "uses", 0) >= number(m, "maxUses", 4)
}

// `MerchantOffer.assemble`: what it gives.
fn sold(offer: Tag) -> Tag {
    return field(compound(offer), "sell")
}

// The offer with its uses up one, `increaseUses`.
fn used(offer: Tag) -> Tag {
    var m = compound(offer)
    let uses = number(m, "uses", 0)
    m.insert(String("uses"), Tag.Int(uses + 1))
    return Tag.Compound(m)
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    return match t {
        Tag.Compound(m) => m.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

fn field(m: JavaHashMap<String, Tag>, name: str) -> Tag {
    return if m.contains(name) { m[name].copy() } else { Tag.End }
}

// A saved offer's whole number `name`, `default` where it was saved without it, as its codec
// leaves a default out.
fn number(m: JavaHashMap<String, Tag>, name: str, default: i32) -> i32 {
    if not m.contains(name) {
        return default
    }
    return m[name].number_int() ?? default
}

// `RemoteSlot.Synchronized.matches`.
fn knows(remote: Remote, local: Tag?, items: ItemCodecs) -> i32 {
    return match remote {
        Remote.Unknown => NO,
        Remote.Sent(stack) => if same_stack(stack, local) { YES } else { NO },
        Remote.Hashed(h) => if h.matches(local, items) { LEARNED } else { NO },
    }
}

// `quickMoveStack`, a shift-click on slot `n`, as the menu's kind has it: the stack there, as it
// was, where some of it moved, else nothing.
fn quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    if s.kind == CRAFTING_MENU {
        return crafting_quick_move(mut s, n, items, who, mut fx)
    }
    if s.kind == MERCHANT_MENU {
        return merchant_quick_move(mut s, n, items, mut fx)
    }
    if s.kind == BEACON_MENU {
        return beacon_quick_move(mut s, n, items, mut fx)
    }
    if s.kind != INVENTORY_MENU {
        return container_quick_move(mut s, n, items, mut fx)
    }
    let original = get(s, n) else return none
    let worn = equipment_slot_for(original, items)
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 0 {
        moved = move_to(mut s, mut stack, 9, 45, true, items, mut fx)
    } else if n >= 1 and n < 9 {
        moved = move_to(mut s, mut stack, 9, 45, false, items, mut fx)
    } else if armor_index(worn) >= 0 and get(s, usize.wrap(8 - armor_index(worn))) == none {
        let pos = usize.wrap(8 - armor_index(worn))
        moved = move_to(mut s, mut stack, pos, pos + 1, false, items, mut fx)
    } else if worn == "offhand" and get(s, 45) == none {
        moved = move_to(mut s, mut stack, 45, 46, false, items, mut fx)
    } else if n >= 9 and n < 36 {
        moved = move_to(mut s, mut stack, 36, 45, false, items, mut fx)
    } else if n >= 36 and n < 45 {
        moved = move_to(mut s, mut stack, 9, 36, false, items, mut fx)
    } else {
        moved = move_to(mut s, mut stack, 9, 45, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        // What's left stays in the slot, shrunk where it is, which tells no one.
        put(mut s, n, stack.copy())
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    // The result taken, then what of it didn't fit dropped.
    if is_result(s, n) {
        on_take(mut s, n, items, who, mut fx)
        if let left = stack {
            fx.push(Effect.Dropped(left, false))
        }
    }
    return some(original)
}

// A container's menu's `quickMoveStack` (CAL-144): from the container into the player's slots,
// from the hotbar's last, else from the player's into the container's, from its first; what's
// left `setChanged` where it is. `ChestMenu`'s, `ShulkerBoxMenu`'s and `HopperMenu`'s give the
// stack as it was wherever any moved; `DispenserMenu`'s gives nothing where none did.
fn container_quick_move(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    let size = s.container.len()
    let total = s.count()
    let moved = if n < size { move_to(mut s, mut stack, size, total, true, items, mut fx) } else { move_to(mut s, mut stack, 0, size, false, items, mut fx) }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if s.kind == DISPENSER_MENU and count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    return some(original)
}

// `CraftingMenu.quickMoveStack` (CAL-147): the result into the player's slots from the hotbar's
// last, what of it doesn't fit dropped; the player's into the grid from its first, else the
// inventory's into the hotbar and the hotbar's into the inventory; the grid's into the player's
// from the inventory's first. What's left stays where it is, which tells no one.
fn crafting_quick_move(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 0 {
        moved = move_to(mut s, mut stack, 10, 46, true, items, mut fx)
    } else if n >= 10 and n < 46 {
        moved = move_to(mut s, mut stack, 1, 10, false, items, mut fx)
        if not moved {
            if n < 37 {
                moved = move_to(mut s, mut stack, 37, 46, false, items, mut fx)
            } else {
                moved = move_to(mut s, mut stack, 10, 37, false, items, mut fx)
            }
        }
    } else {
        moved = move_to(mut s, mut stack, 10, 46, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    if n == 0 {
        on_take(mut s, n, items, who, mut fx)
        if let left = stack {
            fx.push(Effect.Dropped(left, false))
        }
    }
    return some(original)
}

// `MerchantMenu.quickMoveStack` (CAL-160): what the trade gives into the player's slots from the
// hotbar's last, its trade's sound played on the client, `playTradeSound`; a payment into the
// player's slots from the inventory's first; the inventory's into the hotbar, and the hotbar's
// into the inventory. What's left stays where it is, `setChanged`, which makes what the payments
// buy again; and where some moved, the slot's taken from, `onTake`, which for what the trade gives
// is the trade.
fn merchant_quick_move(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 2 {
        moved = move_to(mut s, mut stack, 3, 39, true, items, mut fx)
    } else if n == 0 or n == 1 {
        moved = move_to(mut s, mut stack, 3, 39, false, items, mut fx)
    } else if n >= 3 and n < 30 {
        moved = move_to(mut s, mut stack, 30, 39, false, items, mut fx)
    } else if n >= 30 and n < 39 {
        moved = move_to(mut s, mut stack, 3, 30, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    if n == 2 {
        merchant_take(mut s, items, mut fx)
    } else {
        // `Slot.onTake`'s `setChanged`.
        changed(mut s, n, items, mut fx)
    }
    return some(original)
}

// `BeaconMenu.quickMoveStack` (D521): the payment into the player's slots from the hotbar's last;
// one payment item alone into the payment slot where it's empty; else the inventory's into the
// hotbar, the hotbar's into the inventory. What's left stays where it is, `setChanged`; and where
// some moved, the slot's taken from, `onTake`, its `setChanged`.
fn beacon_quick_move(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    let original = get(s, n) else return none
    var stack: Tag? = some(original.copy())
    var moved = false
    if n == 0 {
        moved = move_to(mut s, mut stack, 1, 37, true, items, mut fx)
    } else if get(s, 0) == none and may_place(s, 0, original, items) and count_of(stack) == 1 {
        moved = move_to(mut s, mut stack, 0, 1, false, items, mut fx)
    } else if n >= 1 and n < 28 {
        moved = move_to(mut s, mut stack, 28, 37, false, items, mut fx)
    } else if n >= 28 and n < 37 {
        moved = move_to(mut s, mut stack, 1, 28, false, items, mut fx)
    } else {
        moved = move_to(mut s, mut stack, 1, 37, false, items, mut fx)
    }
    if not moved {
        return none
    }
    if stack == none {
        set_by_player(mut s, n, none, some(original.copy()), items, mut fx)
    } else {
        put(mut s, n, stack.copy())
        changed(mut s, n, items, mut fx)
    }
    if count_of(stack) == count_of(some(original.copy())) {
        return none
    }
    changed(mut s, n, items, mut fx)
    return some(original)
}

// `moveItemStackTo`: `stack` moved into the slots from `start` to before `end`, from the last
// where `backwards`: onto stacks of it first, where it stacks, then into the first empty slot
// that takes it. Whether anything moved.
fn move_to(s: mut Slots, stack: mut Tag?, start: usize, end: usize, backwards: bool, items: ItemCodecs, fx: mut List<Effect>) -> bool {
    var moved = false
    let first = i32.wrap(start)
    let last = i32.wrap(end)
    var dest = if backwards { last - 1 } else { first }
    if stackable(stack, items) {
        while stack != none and within(dest, first, last, backwards) {
            let d = usize.wrap(dest)
            let target = get(s, d)
            if target != none and same_components(stack, target) {
                let t = target.copy() ?? Tag.End
                let total = count_of(target) + count_of(stack)
                let max = max_for(s, d, t, items)
                if total <= max {
                    stack = none
                    put(mut s, d, with_count(t, total))
                    changed(mut s, d, items, mut fx)
                    moved = true
                } else if count_of(target) < max {
                    let given = stack.copy() ?? Tag.End
                    stack = with_count(given, count_of(stack) - (max - count_of(target)))
                    put(mut s, d, with_count(t, max))
                    changed(mut s, d, items, mut fx)
                    moved = true
                }
            }
            dest += if backwards { -1 } else { 1 }
        }
    }
    if stack != none {
        dest = if backwards { last - 1 } else { first }
        while within(dest, first, last, backwards) {
            let d = usize.wrap(dest)
            let given = stack.copy() ?? Tag.End
            if get(s, d) == none and may_place(s, d, given, items) {
                let max = max_for(s, d, given, items)
                let take = min(count_of(stack), max)
                let left = count_of(stack) - take
                stack = with_count(given, left)
                set_by_player(mut s, d, with_count(given, take), none, items, mut fx)
                changed(mut s, d, items, mut fx)
                moved = true
                break
            }
            dest += if backwards { -1 } else { 1 }
        }
    }
    return moved
}

// Whether `dest` is still in the slots from `first` to before `last`, going down where `backwards`.
fn within(dest: i32, first: i32, last: i32, backwards: bool) -> bool {
    return if backwards { dest >= first } else { dest < last }
}

// `Slot.safeInsert`: as much of `stack` as `amount`, as the slot takes, put in slot `n`, onto
// what's there where it's the same. What's left of `stack`.
fn safe_insert(s: mut Slots, n: usize, stack: Tag, amount: i32, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    if not may_place(s, n, stack, items) {
        return some(stack.copy())
    }
    let here = get(s, n)
    let given = some(stack.copy())
    let moved = min(min(amount, count_of(given)), max_for(s, n, stack, items) - count_of(here))
    if moved <= 0 {
        return given
    }
    if here == none {
        set_by_player(mut s, n, with_count(stack, moved), none, items, mut fx)
        return with_count(stack, count_of(given) - moved)
    }
    if same_components(here, given) {
        let h = here.copy() ?? Tag.End
        // The slot's stack grows where it is, so it's its own previous stack.
        let grown = with_count(h, count_of(here) + moved)
        set_by_player(mut s, n, grown.copy(), grown, items, mut fx)
        return with_count(stack, count_of(given) - moved)
    }
    return given
}

// `Slot.safeTake` with no most: `tryRemove`, then the slot's `onTake` of what it gave.
fn safe_take(s: mut Slots, n: usize, amount: i32, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    let taken = try_remove(mut s, n, amount, i32.MAX, items, who, mut fx) else return none
    on_take(mut s, n, items, who, mut fx)
    return some(taken)
}

// What `add` left of `given` where none of it went in, vanilla's `false`, else nothing: where
// some went in, `add` said `true` and the rest's left in a stack no one keeps.
fn none_added(left: Tag?, given: Tag) -> Tag? {
    let l = left else return none
    if count_of(some(l.copy())) == count_of(some(given.copy())) {
        return some(l.copy())
    }
    return none
}

/// `Inventory.add(stack)`, as a player picking an item up adds it: how many of it are left, and
/// whether any went in, `add`'s answer, which holds where the inventory's creative and nothing
/// fits too (CAL-148).
pub fn pick_up(inv: mut Inventory, stack: Tag, items: ItemCodecs, who: Clicker) -> (i32, bool) {
    let given = count_of(some(stack.copy()))
    let left = add(mut inv, -1, stack, items, who)
    let n = count_of(left)
    if left == none {
        return (0, true)
    }
    return (n, n < given)
}

// `Slot.tryRemove`: up to `amount`, and no more than `max`, taken from slot `n`, where the
// player may, or nothing.
fn try_remove(s: mut Slots, n: usize, amount: i32, max: i32, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) -> Tag? {
    if not may_pickup(s, n, items, who) {
        return none
    }
    let here = get(s, n)
    let modifiable = match here {
        some(h) => may_place(s, n, h, items),
        none => s.kind != INVENTORY_MENU or n >= 9 or (n >= 1 and n <= 4),
    }
    if not modifiable and max < count_of(here) {
        return none
    }
    let taken = remove(mut s, n, min(amount, max), items, mut fx) else return none
    if get(s, n) == none {
        set_by_player(mut s, n, none, some(taken.copy()), items, mut fx)
    }
    return some(taken)
}

// `Slot.remove`: up to `amount` split from slot `n`'s stack, which the crafting grid tells the
// menu of, and a container's `removeItem` its `setChanged`. The crafting result's is the whole
// stack, as `ResultContainer.removeItem` takes it.
fn remove(s: mut Slots, n: usize, amount: i32, items: ItemCodecs, fx: mut List<Effect>) -> Tag? {
    if amount <= 0 {
        return none
    }
    let here = get(s, n) else return none
    if is_result(s, n) {
        put(mut s, n, none)
        return some(here)
    }
    let given = some(here.copy())
    let take = min(amount, count_of(given))
    put(mut s, n, with_count(here, count_of(given) - take))
    if is_grid(s, n) {
        craft(mut s, items, mut fx)
    }
    changed(mut s, n, items, mut fx)
    return with_count(here, take)
}

// `setByPlayer(stack, was)`: the inventory menu's armor slots and offhand's tell the player
// first, as `onEquipItem`; then `set`.
fn set_by_player(s: mut Slots, n: usize, stack: Tag?, was: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    let worn = if s.kind == INVENTORY_MENU { worn_name(n) } else { "" }
    if worn != "" {
        fx.push(Effect.Equip(String(worn), was.copy(), stack.copy()))
    }
    set(mut s, n, stack, items, mut fx)
}

// `Slot.set`: the container's `setItem`, which the crafting grid tells the menu of, and a
// merchant's payments too, `MerchantContainer.setItem` (CAL-160); then the container's
// `setChanged`.
fn set(s: mut Slots, n: usize, stack: Tag?, items: ItemCodecs, fx: mut List<Effect>) {
    put(mut s, n, stack.copy())
    if is_grid(s, n) {
        craft(mut s, items, mut fx)
    }
    if is_payment(s, n) {
        update_sell(mut s, items, mut fx)
    }
    changed(mut s, n, items, mut fx)
}

// Whether slot `n` is the crafting result, the inventory menu's or a crafting table's slot 0
// (CAL-147), or what a merchant's trade gives, its slot 2 (CAL-160).
fn is_result(s: Slots, n: usize) -> bool {
    return ((s.kind == INVENTORY_MENU or s.kind == CRAFTING_MENU) and n == 0) or (s.kind == MERCHANT_MENU and n == 2)
}

// Whether slot `n` is one of a merchant's payments, its slots 0 and 1 (CAL-160).
fn is_payment(s: Slots, n: usize) -> bool {
    return s.kind == MERCHANT_MENU and n < 2
}

// Whether slot `n` is in the crafting grid, the inventory menu's 1 to 4 or a crafting table's 1
// to 9.
fn is_grid(s: Slots, n: usize) -> bool {
    let (first, width, height) = grid_shape(s)
    return (s.kind == INVENTORY_MENU or s.kind == CRAFTING_MENU) and n >= first and n < first + width * height
}

// The crafting grid's first slot, its width and its height: the inventory menu's 2 by 2, or a
// crafting table's 3 by 3.
fn grid_shape(s: Slots) -> (usize, usize, usize) {
    if s.kind == CRAFTING_MENU {
        return (1, 3, 3)
    }
    return (1, 2, 2)
}

// The crafting grid's stacks, as `CraftingInput.ofPositioned` makes them.
fn grid_input(s: Slots) -> Input {
    let (first, width, height) = grid_shape(s)
    var grid = List<Tag?>()
    for i in 0..width * height {
        grid.push(get(s, first + i))
    }
    return Input.of(width, height, grid)
}

// `slotChangedCraftingGrid`, as the grid changes: the result set to what the grid makes, which is
// sent, `Effect.Grid`. Every recipe may be used, as `setRecipeUsed` lets one be where the game
// rule `limited_crafting` is off, which Calcite has no other way to set.
fn craft(s: mut Slots, items: ItemCodecs, fx: mut List<Effect>) {
    let made = match s.recipes {
        some(r) => crafted(r.value, grid_input(s), items),
        none => none,
    }
    put(mut s, 0, made.copy())
    fx.push(Effect.Grid(s.kind, made))
}

// `ResultSlot.onTake`, as the crafting result's taken: one of each stack the recipe used taken
// from the grid, and what's left of it put back, `getRemainingItems`, onto the stack there where
// it's the same, else in the inventory, else dropped. Each change to the grid is one, so the
// result's made again each time. The stats, advancements and recipe book its
// `checkTakeAchievements` gives wait for those.
fn on_take(s: mut Slots, n: usize, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) {
    if not is_result(s, n) {
        return
    }
    if s.kind == MERCHANT_MENU {
        merchant_take(mut s, items, mut fx)
        return
    }
    let input = grid_input(s)
    let left = match s.recipes {
        some(r) => left_in_grid(r.value, input, items),
        none => input.items.copy(),
    }
    let (first, width, _) = grid_shape(s)
    for y in 0..input.height {
        for x in 0..input.width {
            let slot = first + x + input.left + (y + input.top) * width
            var here = get(s, slot)
            if let h = here.copy() {
                // `craftSlots.removeItem(slot, 1)`.
                put(mut s, slot, with_count(h, count_of(here) - 1))
                craft(mut s, items, mut fx)
                here = get(s, slot)
            }
            let back = left[x + y * input.width].copy() else continue
            if here == none {
                put(mut s, slot, some(back))
                craft(mut s, items, mut fx)
            } else if same_components(here, some(back.copy())) {
                put(mut s, slot, with_count(back.copy(), count_of(some(back)) + count_of(here)))
                craft(mut s, items, mut fx)
            } else if let dropped = none_added(add_item(mut s.inv, back, items, who), back) {
                fx.push(Effect.Dropped(dropped, false))
            }
        }
    }
}

// The container's `setChanged`, where slot `n` is the container's (CAL-144). A crafting table's
// result and grid, which no block entity keeps, tell no one (CAL-147); a merchant's slots make
// what its payments buy again, `MerchantContainer.setChanged` (CAL-160).
fn changed(s: mut Slots, n: usize, items: ItemCodecs, fx: mut List<Effect>) {
    if s.kind == MERCHANT_MENU {
        if n < s.container.len() {
            update_sell(mut s, items, mut fx)
        }
        return
    }
    if s.kind != INVENTORY_MENU and s.kind != CRAFTING_MENU and s.kind != BEACON_MENU and n < s.container.len() {
        fx.push(Effect.Changed)
    }
}

// `Inventory.placeItemBackInInventory`: `stack` put back, onto a stack of it with room, the held
// one and the offhand's first, else in the first empty slot, each part sent; what has nowhere to
// go would be dropped.
fn place_back(inv: mut Inventory, stack: Tag, items: ItemCodecs, who: Clicker, fx: mut List<Effect>) {
    var left: Tag? = some(stack.copy())
    while left != none {
        let s = left.copy() ?? Tag.End
        var slot = room_for(inv, s, items, who)
        if slot < 0 {
            slot = free_slot(inv)
        }
        if slot < 0 {
            // `dropOrPlaceInInventory`'s, as the menu closes.
            fx.push(Effect.Dropped(s, true))
            return
        }
        let i = usize.wrap(slot)
        let space = items.max_stack_size(s) - count_of(inv.menu_slot(menu_of(i)))
        let part = min(space, count_of(left))
        left = with_count(s, count_of(left) - part)
        let piece = with_count(s, part) ?? Tag.End
        if add(mut inv, slot, piece, items, who) == none {
            fx.push(Effect.Placed(i, inv.menu_slot(menu_of(i))))
        }
    }
}

/// `Player.addItem`, `Inventory.add` anywhere (CAL-142): what of `stack` didn't go in, `none`
/// where it all did, or where none could and the player has infinite materials.
pub fn add_item(inv: mut Inventory, stack: Tag, items: ItemCodecs, who: Clicker) -> Tag? {
    return add(mut inv, -1, stack, items, who)
}

/// `Inventory.contains(stack)`: whether a slot of the inventory, its armor or its offhand holds
/// the same item with the same components (CAL-142).
pub fn contains_like(inv: Inventory, stack: Tag) -> bool {
    let wanted = some(stack.copy())
    for n in 5usize..46 {
        let here = inv.menu_slot(n)
        if here != none and same_item(here, wanted) and same_components(here, wanted) {
            return true
        }
    }
    return false
}

// `Inventory.add(slot, stack)`, the inventory's own index or -1 for anywhere: what of `stack`
// isn't added, `none` where it all is, or, as vanilla's `false`, where none of it is, all of it.
fn add(inv: mut Inventory, slot: i32, stack: Tag, items: ItemCodecs, who: Clicker) -> Tag? {
    let given = some(stack.copy())
    if damaged(stack, items) {
        var at = slot
        if at == -1 {
            at = free_slot(inv)
        }
        if at >= 0 {
            inv.set_menu_slot(menu_of(usize.wrap(at)), given)
            return none
        }
        if who.infinite {
            return none
        }
        return given
    }
    var left = count_of(given)
    var going = true
    while going {
        let last = left
        left = if slot == -1 { add_anywhere(mut inv, stack, left, items, who) } else { add_resource(mut inv, usize.wrap(slot), stack, left, items) }
        going = left > 0 and left < last
    }
    if left == count_of(given) and who.infinite {
        return none
    }
    if left == 0 {
        return none
    }
    if left < count_of(given) {
        // Some went in, so vanilla's `add` says it did; the rest stays in the stack it was given.
        return with_count(stack, left)
    }
    return given
}

// `Inventory.addResource(stack)`: onto a stack of it with room, else into the first empty slot.
// How many of `count` are left.
fn add_anywhere(inv: mut Inventory, stack: Tag, count: i32, items: ItemCodecs, who: Clicker) -> i32 {
    var slot = room_for(inv, stack, items, who)
    if slot < 0 {
        slot = free_slot(inv)
    }
    if slot < 0 {
        return count
    }
    return add_resource(mut inv, usize.wrap(slot), stack, count, items)
}

// `Inventory.addResource(slot, stack)`: as many of `count` as fit put in the inventory's slot
// `slot`. How many are left.
fn add_resource(inv: mut Inventory, slot: usize, stack: Tag, count: i32, items: ItemCodecs) -> i32 {
    let m = menu_of(slot)
    let here = inv.menu_slot(m)
    let base = here.copy() ?? stack.copy()
    let max = min(99, items.max_stack_size(base))
    let room = max - count_of(here)
    let moved = min(count, room)
    if moved <= 0 {
        return count
    }
    inv.set_menu_slot(m, with_count(base, count_of(here) + moved))
    return count - moved
}

// `getSlotWithRemainingSpace`: the inventory's slot, by its own index, with a stack `stack`
// stacks onto with room: the held one, the offhand's, then the rest in order; else -1.
fn room_for(inv: Inventory, stack: Tag, items: ItemCodecs, who: Clicker) -> i32 {
    let given = some(stack.copy())
    if who.selected >= 0 and who.selected < 9 and has_room(inv.menu_slot(menu_of(usize.wrap(who.selected))), given, items) {
        return who.selected
    }
    if has_room(inv.menu_slot(45), given, items) {
        return 40
    }
    for i in 0..36 {
        if has_room(inv.menu_slot(menu_of(usize.wrap(i))), given, items) {
            return i
        }
    }
    return -1
}

// `hasRemainingSpaceForItem`.
fn has_room(here: Tag?, stack: Tag?, items: ItemCodecs) -> bool {
    let h = here else return false
    return same_components(here, stack) and stackable(here, items) and count_of(here) < min(99, items.max_stack_size(h))
}

// `getFreeSlot`: the first empty slot of the inventory's 36, or -1.
fn free_slot(inv: Inventory) -> i32 {
    for i in 0..36 {
        if inv.menu_slot(menu_of(usize.wrap(i))) == none {
            return i
        }
    }
    return -1
}

// The inventory menu's slot for the inventory's own slot `i`: the hotbar's 9, the 27, the armor
// from the feet, 36 to 39, and the offhand, 40.
fn menu_of(i: usize) -> usize {
    if i < 9 {
        return 36 + i
    }
    if i < 36 {
        return i
    }
    if i == 36 {
        return 8
    }
    if i == 37 {
        return 7
    }
    if i == 38 {
        return 6
    }
    if i == 39 {
        return 5
    }
    return 45
}

/// The stack in slot `n` of the menu `s` are the slots of, as the client's sent it (CAL-144).
pub fn stack_in(s: Slots, n: usize) -> Tag? {
    return get(s, n)
}

// The stack in slot `n`: the inventory menu's, its crafting result first (CAL-147); or a
// container's menu's, the container's, then the inventory menu's 9 to 44 (CAL-144).
fn get(s: Slots, n: usize) -> Tag? {
    if s.kind != INVENTORY_MENU {
        let size = s.container.len()
        if n < size {
            return s.container[n].copy()
        }
        return s.inv.menu_slot(n - size + 9)
    }
    return s.inv.menu_slot(n)
}

// Slot `n` holding `stack`, as `Container.setItem` holds it, telling no one (CAL-144).
fn put(s: mut Slots, n: usize, stack: own Tag?) {
    if s.kind != INVENTORY_MENU {
        let size = s.container.len()
        if n < size {
            s.container[n] = stack
        } else {
            s.inv.set_menu_slot(n - size + 9, stack)
        }
        return
    }
    s.inv.set_menu_slot(n, stack)
}

// `Slot.mayPlace`: in a shulker box's slots, what `canFitInsideContainerItems`, which a shulker
// box doesn't (CAL-144); nothing in a crafting table's result (CAL-147), nor in what a merchant's
// trade gives, `MerchantResultSlot` (CAL-160); in the inventory menu, nothing in the result,
// armor only where it's equippable there; anything else anywhere else.
fn may_place(s: Slots, n: usize, stack: Tag, items: ItemCodecs) -> bool {
    if s.kind != INVENTORY_MENU {
        if (s.kind == CRAFTING_MENU and n == 0) or (s.kind == MERCHANT_MENU and n == 2) {
            return false
        }
        if s.kind == SHULKER_MENU and n < s.container.len() {
            return fits_in_containers(stack)
        }
        // `BeaconMenu.PaymentSlot.mayPlace`: what's `#beacon_payment_items` (D521).
        if s.kind == BEACON_MENU and n == 0 {
            let item = item_of(some(stack.copy()))
            for named in s.payments {
                if named == item {
                    return true
                }
            }
            return false
        }
        return true
    }
    if n == 0 {
        return false
    }
    let worn = worn_name(n)
    if n >= 5 and n <= 8 {
        return equippable_in(stack, worn, items)
    }
    return true
}

// `Item.canFitInsideContainerItems`: anything but a shulker box, `BlockItem`'s of a
// `ShulkerBoxBlock`, which are the shulker box and its 16 dyed ones (CAL-144).
fn fits_in_containers(stack: Tag) -> bool {
    let item = item_of(some(stack.copy()))
    return item != "minecraft:shulker_box" and not (item.starts_with("minecraft:") and item.ends_with("_shulker_box"))
}

// `ArmorSlot.mayPickup`: the inventory menu's armor, not with the curse of binding,
// `prevent_armor_change`, out of creative mode.
fn may_pickup(s: Slots, n: usize, items: ItemCodecs, who: Clicker) -> bool {
    if s.kind == MERCHANT_MENU and n == 2 {
        // `MerchantResultSlot.mayPickup` (CAL-160): an offer the payments buy, which they pay
        // for either way round.
        if s.active < 0 or usize.wrap(s.active) >= s.offers.len() {
            return false
        }
        let at = usize.wrap(s.active)
        let (a, b) = (get(s, 0), get(s, 1))
        return satisfied_by(s.offers[at], a.copy(), b.copy(), items) or satisfied_by(s.offers[at], b, a, items)
    }
    if s.kind == INVENTORY_MENU and n >= 5 and n <= 8 and not who.creative {
        if let here = get(s, n) {
            if items.has_enchantment_effect(here, String("minecraft:prevent_armor_change")) {
                return false
            }
        }
    }
    return true
}

// `LivingEntity.isEquippableInSlot` for a player: `equippable` in the slot `worn`, where it
// lets a player wear it.
fn equippable_in(stack: Tag, worn: str, items: ItemCodecs) -> bool {
    let found = items.component(stack, String("minecraft:equippable")) else return false
    let Tag.Compound(e) = found else return false
    if not e.contains("slot") {
        return false
    }
    let slot = match e["slot"] {
        Tag.Str(s) => s.copy(),
        _ => return false,
    }
    if slot != String(worn) {
        return false
    }
    if not e.contains("allowed_entities") {
        return true
    }
    return items.entity_allowed(e["allowed_entities"], String("minecraft:player"))
}

// `getEquipmentSlotForItem` for a player: its `equippable`'s slot, else the main hand.
fn equipment_slot_for(stack: Tag, items: ItemCodecs) -> String {
    if let found = items.component(stack, String("minecraft:equippable")) {
        match found {
            Tag.Compound(e) => {
                if e.contains("slot") {
                    match e["slot"] {
                        Tag.Str(s) => return s.copy(),
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    return String("mainhand")
}

// `EquipmentSlot.getIndex` of a worn slot, the feet 0 to the head 3, or -1 for another.
fn armor_index(worn: String) -> i32 {
    return if worn == "feet" { 0 } else if worn == "legs" { 1 } else if worn == "chest" { 2 } else if worn == "head" { 3 } else { -1 }
}

// The equipment slot the menu's slot `n` is, by its codec's name, or empty.
fn worn_name(n: usize) -> str {
    return if n == 5 { "head" } else if n == 6 { "chest" } else if n == 7 { "legs" } else if n == 8 { "feet" } else if n == 45 { "offhand" } else { "" }
}

// `Slot.getMaxStackSize(stack)`: the inventory menu's armor slots hold one, and a beacon's payment
// slot (D521), the rest 99, and no slot more than the stack stacks to.
fn max_for(s: Slots, n: usize, stack: Tag, items: ItemCodecs) -> i32 {
    let slot_max = if (s.kind == INVENTORY_MENU and n >= 5 and n <= 8) or (s.kind == BEACON_MENU and n == 0) { 1 } else { 99 }
    return min(slot_max, items.max_stack_size(stack))
}

// `canItemQuickReplace(slot, stack, true)`: an empty slot, or one with the same stack, no more
// than it stacks to.
fn quick_replaces(here: Tag?, stack: Tag, items: ItemCodecs) -> bool {
    if here == none {
        return true
    }
    let given = some(stack.copy())
    return same_components(given, here) and count_of(here) <= items.max_stack_size(stack)
}

// `getQuickCraftPlaceCount`.
fn place_count(slots: i32, kind: i32, stack: Tag, items: ItemCodecs) -> i32 {
    let given = some(stack.copy())
    if kind == 0 {
        return count_of(given) / slots
    }
    if kind == 1 {
        return 1
    }
    if kind == 2 {
        return items.max_stack_size(stack)
    }
    return count_of(given)
}

// `isStackable`: more than one to a stack, and not a damaged one.
fn stackable(stack: Tag?, items: ItemCodecs) -> bool {
    let s = stack else return false
    return items.max_stack_size(s) > 1 and not damaged(s, items)
}

// `isDamaged`: damageable, `max_damage` and `damage` and not `unbreakable`, with damage.
fn damaged(stack: Tag, items: ItemCodecs) -> bool {
    let max = match items.component(stack, String("minecraft:max_damage")) {
        some(Tag.Int(n)) => n,
        _ => return false,
    }
    if items.component(stack, String("minecraft:unbreakable")) != none {
        return false
    }
    let damage = match items.component(stack, String("minecraft:damage")) {
        some(Tag.Int(n)) => n,
        _ => return false,
    }
    return min(greater(damage, 0), max) > 0
}

/// A stack's count, 0 for nothing, 1 where `ItemStack.CODEC` wrote none.
pub fn count_of(stack: Tag?) -> i32 {
    let s = stack else return 0
    let Tag.Compound(m) = s else return 0
    if not m.contains("count") {
        return 1
    }
    return match m["count"] {
        Tag.Int(n) => n,
        _ => 1,
    }
}

// `copyWithCount`: `stack` with `n` of it, nothing for none.
fn with_count(stack: Tag, n: i32) -> Tag? {
    if n <= 0 {
        return none
    }
    let Tag.Compound(m) = stack else return none
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return some(Tag.Compound(out))
}

// `ItemStack.isSameItem`: the same item, nothing being air.
fn same_item(a: Tag?, b: Tag?) -> bool {
    return item_of(a) == item_of(b)
}

/// `ItemStack.isSameItemSameComponents`: the same item with the same components.
pub fn same_components(a: Tag?, b: Tag?) -> bool {
    if not same_item(a, b) {
        return false
    }
    return same(components_of(a), components_of(b))
}

/// `ItemStack.matches`: the same item with the same components and count, or nothing for both.
pub fn same_stack(a: Tag?, b: Tag?) -> bool {
    if a == none and b == none {
        return true
    }
    return count_of(a) == count_of(b) and same_components(a, b)
}

fn item_of(stack: Tag?) -> String {
    let s = stack else return String("minecraft:air")
    let Tag.Compound(m) = s else return String("minecraft:air")
    return match m["id"] {
        Tag.Str(i) => i.copy(),
        _ => String("minecraft:air"),
    }
}

fn components_of(stack: Tag?) -> Tag {
    if let s = stack {
        match s {
            Tag.Compound(m) => {
                if m.contains("components") {
                    return m["components"].copy()
                }
            },
            _ => {},
        }
    }
    return Tag.Compound(JavaHashMap<String, Tag>())
}

// A count off the network, as `ByteBufCodecs.readCount` reads it for a hash map or a hash set:
// more than 256 throws, and so does fewer than none, as `HashMap`'s constructor does.
fn hashed_count(rd: mut Reader) -> usize ! DecodeError {
    let n = try rd.varint()
    if n > MAX_HASHED {
        fail DecodeError { message: "io.netty.handler.codec.DecoderException: {n} elements exceeded max size of: {MAX_HASHED}" }
    }
    if n < 0 {
        fail DecodeError { message: "java.lang.IllegalArgumentException: Illegal initial capacity: {n}" }
    }
    return usize.wrap(n)
}

// `byIdOrThrow`: an ID of one of `n` entries.
fn known(id: i32, n: usize) ! DecodeError {
    if id < 0 or usize.wrap(id) >= n {
        fail DecodeError { message: "java.lang.IllegalArgumentException: No value with id {id}" }
    }
}

fn has_i32(list: List<i32>, v: i32) -> bool {
    for x in list {
        if x == v {
            return true
        }
    }
    return false
}

fn has_usize(list: List<usize>, v: usize) -> bool {
    for x in list {
        if x == v {
            return true
        }
    }
    return false
}

fn min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

fn greater(a: i32, b: i32) -> i32 {
    return if a > b { a } else { b }
}
