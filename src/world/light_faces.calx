    var digit: List<u8> = []
    for _ in 0..128 {
        digit.push(0)
    }
    for i in 0..alphabet.len() {
        digit[usize(alphabet.byte_at(i))] = u8.wrap(i)
    }
    var states: List<u8> = []
    states.reserve(35723)
    for line in lines {
        for i in 0..line.len() {
            states.push(digit[usize(line.byte_at(i))])
        }
    }
    return (palette, states)
}

/// For each shape, the shapes it and light can't pass between, bit `j` for shape `j`.
pub fn face_occludes() -> List<u64> {
    return [2, 36028797018963967, 2199163371794, 9075815351330, 634581422086, 35330672566282, 2158788738, 31103054652702786, 6, 2, 10, 2, 18, 34, 2, 11399736556781634, 130, 84825604102, 30540104699215938, 30540120805343302, 377432834086, 30540383884673122, 256895877134, 30540250731249738, 4294967298, 8589934594, 2158755970, 84836876422, 281872695458, 148457128074, 140115986, 30540104705114194, 146456313882, 279891804210, 1048578, 4194306, 2298347666, 279722328098, 146300469258, 18, 2, 6, 2, 10, 2, 34, 2, 2158788738, 2, 130, 2158755970, 2158788738, 2, 2158788738, 2158755970]
}
