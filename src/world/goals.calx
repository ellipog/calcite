/// as some read others'.
pub const BEE_ENTER_HIVE: i32 = 0
pub const BEE_VALIDATE_HIVE: i32 = 1
pub const BEE_VALIDATE_FLOWER: i32 = 2
pub const BEE_POLLINATE: i32 = 3
pub const BEE_LOCATE_HIVE: i32 = 4
pub const BEE_GO_TO_HIVE: i32 = 5
pub const BEE_GO_TO_FLOWER: i32 = 6
pub const BEE_GROW_CROP: i32 = 7
pub const BEE_WANDER: i32 = 8

/// A phantom's goals (CAL-200): `PhantomAttackStrategyGoal`, `PhantomSweepAttackGoal`,
/// `PhantomCircleAroundAnchorGoal` and its target goal, `PhantomAttackPlayerTargetGoal`.
pub const PHANTOM_STRATEGY: i32 = 0
pub const PHANTOM_SWEEP: i32 = 1
pub const PHANTOM_CIRCLE: i32 = 2
pub const PHANTOM_TARGET: i32 = 3
/// A vex's goals (CAL-200): `VexChargeAttackGoal`, `VexRandomMoveGoal` and
/// `VexCopyOwnerTargetGoal`.
pub const VEX_CHARGE: i32 = 0
pub const VEX_RANDOM_MOVE: i32 = 1
pub const VEX_COPY_OWNER: i32 = 2
/// An evoker's spell goals (CAL-200), by the spell they cast, `IllagerSpell`'s IDs:
/// `EvokerCastingSpellGoal`, then `EvokerSummonSpellGoal`, `EvokerAttackSpellGoal` and
/// `EvokerWololoSpellGoal`, each a `SpellcasterUseSpellGoal`.
pub const SPELL_CASTING: i32 = 0
pub const SPELL_SUMMON: i32 = 1
pub const SPELL_FANGS: i32 = 2
pub const SPELL_WOLOLO: i32 = 3

/// The sets of items a `TemptGoal` follows a player holding, a bit each in `Follower.tempts`:
/// `#cow_food`, a carrot on a stick, `#pig_food`, `#sheep_food`, `#chicken_food`,
/// `#horse_tempt_items` and `#zombie_horse_food`; and those an armadillo's brain's sensor finds a
/// player holding, `#armadillo_food` (CAL-160).
pub const TEMPT_COW: u32 = 1
pub const TEMPT_PIG_STICK: u32 = 2
pub const TEMPT_PIG: u32 = 4
pub const TEMPT_SHEEP: u32 = 8
pub const TEMPT_CHICKEN: u32 = 16
pub const TEMPT_HORSE: u32 = 32
pub const TEMPT_ZOMBIE_HORSE: u32 = 64
pub const TEMPT_ARMADILLO: u32 = 128
/// And `#bee_food`, the small flowers, which tempt a bee (CAL-177).
pub const TEMPT_BEE: u32 = 256
/// And `#horse_food`, what a horse or donkey eats, `isFood`, as it's fed (CAL-179).
pub const TEMPT_HORSE_FOOD: u32 = 512

/// The item tags of the sets, in their bits' order, empty for the carrot on a stick, which is an
/// item.
pub fn tempt_tags() -> List<String> {
    var out = List<String>()
    out.push(String("cow_food"))
    out.push(String())
    out.push(String("pig_food"))
    out.push(String("sheep_food"))
    out.push(String("chicken_food"))
    out.push(String("horse_tempt_items"))
    out.push(String("zombie_horse_food"))
    out.push(String("armadillo_food"))
    out.push(String("bee_food"))
    out.push(String("horse_food"))
    return out
}

/// The items in each set, by its bit, as the world's item tags have them, which a player's hands
/// are tested against (CAL-158).
pub struct Temptations {
    pub sets: List<List<String>> = List<List<String>>()
}

// The items named, as a set's list.
fn named(a: str, b: str, c: str) -> List<String> {
    var out = List<String>()
    for name in [a, b, c] {
        if name != "" {
            out.push(String(name))
        }
    }
    return out
}

impl Temptations {
    /// Vanilla's, as its data pack's tags have them, for a world without its registries.
    pub fn vanilla() -> Temptations {
        var sets = List<List<String>>()
        sets.push(named("minecraft:wheat", "", ""))
        sets.push(named("minecraft:carrot_on_a_stick", "", ""))
        sets.push(named("minecraft:carrot", "minecraft:potato", "minecraft:beetroot"))
        sets.push(named("minecraft:wheat", "", ""))
        var seeds = named("minecraft:wheat_seeds", "minecraft:melon_seeds", "minecraft:pumpkin_seeds")
        for name in named("minecraft:beetroot_seeds", "minecraft:torchflower_seeds", "minecraft:pitcher_pod") {
            seeds.push(name.copy())
        }
        sets.push(seeds)
        sets.push(named("minecraft:golden_carrot", "minecraft:golden_apple", "minecraft:enchanted_golden_apple"))
        sets.push(named("minecraft:red_mushroom", "", ""))
        sets.push(named("minecraft:spider_eye", "", ""))
        // `#bee_food`, the small flowers, of which these are the first few.
        sets.push(named("minecraft:dandelion", "minecraft:open_eyeblossom", "minecraft:poppy"))
        var horse = named("minecraft:wheat", "minecraft:sugar", "minecraft:hay_block")
        for name in named("minecraft:apple", "minecraft:carrot", "minecraft:golden_carrot") {
            horse.push(name.copy())
        }
        for name in named("minecraft:golden_apple", "minecraft:enchanted_golden_apple", "") {
            horse.push(name.copy())
        }
        sets.push(horse)
        return Temptations { sets: sets }
    }

    /// The bits of the sets the item `item`, as `minecraft:wheat`, is in, none for nothing.
    pub fn of(self, item: String) -> u32 {
        if item.is_empty() {
            return 0u32
        }
        var bits = 0u32
        var bit = 1u32
        for set in self.sets {
            for name in set {
                if name == item {
                    bits = bits | bit
                }
            }
            bit = bit << 1u32
        }
        return bits
    }
}

/// Another mob near one whose goals look among its kind, as they read it: its ID and kind, where
/// its feet and eyes are and its box, its age, whether it's in love, and whether it's alive,
/// `isAlive` (CAL-158).
pub struct Kin {
    pub id: i32
    pub species: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub eyes: f32
    pub bounds: Aabb
    pub age: i32
    pub in_love: bool
    pub alive: bool
    /// Whether it panics, `isPanicking`, which keeps it from breeding (D416).
    pub panicking: bool = false
    /// What a baby of its breeding takes of it: a cow's, pig's or chicken's variant, a mooshroom's
    /// type or a sheep's wool's colour, by their IDs.
    pub variant: i32
    /// A schooling fish's school size, `schoolSize`, and whether it follows a leader that's alive,
    /// `isFollower` (CAL-178).
    pub school_size: i32 = 1
    pub follower: bool = false
}

/// What a farm animal's breeding asks of its level, `spawnChildFromBreeding` (CAL-158): its
/// partner, by ID, 6000 ticks from breeding again and out of love; then its baby, of its kind and
/// type, at x, y, z facing south and level, of the variant drawn from its parents, or a lamb's
/// colour mixed from its parent's, `variant`, and its partner's, `partner_variant`; and where mob
/// drops are on, an orb worth `orb` there, made after the baby and added before it.
pub struct Bred {
    pub partner: i32
    pub species: i32
    pub kind: u32
    pub variant: i32
    pub partner_variant: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub orb: i32
    /// A villager's (CAL-160): the block its parent's in, whose biome is its baby's type where the
    /// parent drew that, `variant` -1, and the bed taken for the baby.
    pub block: (i32, i32, i32)? = none
    pub bed: (i32, i32, i32)? = none
}

/// A goal's own state, by its kind.
pub enum Goal {
    /// `FloatGoal`.
    Float(i32)
    LookAround(LookAround)
    LookAtPlayer(LookAtPlayer)
    Stroll(Stroll)
    EatBlock(EatBlock)
    Stand(Stand)
    /// `RunAroundLikeCrazyGoal`, a horse's under a rider that doesn't steer it (D710).
    RunAround(RunAround)
    Tempt(Tempt)
    FollowParent(FollowParent)
    Breed(Breed)
    /// `PanicGoal`, and a horse's `MountPanicGoal`, which no rider stops yet (D416).
    Panic(Panic)
    /// A target selector's `NearestAttackableTargetGoal` and `HurtByTargetGoal` (CAL-159).
    Nearest(Nearest)
    HurtBy(HurtBy)
    /// `MeleeAttackGoal`, a zombie's `ZombieAttackGoal` (CAL-159).
    Melee(Melee)
    /// `MoveThroughVillageGoal`, a zombie's (D605).
    ThroughVillage(ThroughVillage)
    /// `RemoveBlockGoal`, a zombie's for turtle eggs, `ZombieAttackTurtleEggGoal` (CAL-159).
    RemoveBlock(RemoveBlock)
    /// `SpearUseGoal`, which a mob holding a spear uses as it has a target (CAL-159).
    SpearUse(SpearUse)
    /// A skeleton's `RangedBowAttackGoal`, `RestrictSunGoal` and `FleeSunGoal` (CAL-159).
    Bow(Bow)
    /// A pillager's `RangedCrossbowAttackGoal` (CAL-200).
    Crossbow(Crossbow)
    RestrictSun(i32)
    FleeSun(FleeSun)
    /// `LeapAtTargetGoal`, a spider's, with how fast it leaps up (CAL-159).
    Leap(f32)
    /// A creeper's `SwellGoal`, with the entity ID of the target it took up as it started, -1 for
    /// none (CAL-159).
    Swell(i32)
    /// An enderman's `EndermanFreezeWhenLookedAt`, with the player it froze for, -1 for none; its
    /// `EndermanLookForPlayerGoal`; and its `EndermanTakeBlockGoal` and `EndermanLeaveBlockGoal`,
    /// whose taking and leaving wait for its carried block (CAL-159).
    Freeze(i32)
    EnderLook(EnderLook)
    TakeBlock(i32)
    LeaveBlock(i32)
    /// A `RangedAttackGoal`, a witch's; and a witch's `NearestHealableRaiderTargetGoal`, with its
    /// cooldown, which only healing a raider starts (CAL-159).
    Ranged(Ranged)
    HealRaider(i32)
    /// A cube mob's goals (CAL-159): `CubeMobFloatGoal`; `CubeMobRandomDirectionGoal`, with the
    /// way it chose and the ticks till it chooses again, `nextRandomizeTime`;
    /// `CubeMobKeepOnJumpingGoal`; and `CubeMobAttackGoal`, with its ticks till it grows tired,
    /// `growTiredTimer`.
    CubeFloat(i32)
    CubeDirection((f32, i32))
    CubeJumping(i32)
    CubeAttack(i32)
    /// A neutral mob's `ResetUniversalAngerTargetGoal`, an enderman's, which alerts no others,
    /// with when a player last hurt it as it last started, by its tick count then,
    /// `lastHurtByPlayerTimestamp` (CAL-159).
    ResetAnger(i32)
    /// A silverfish's `SilverfishWakeUpFriendsGoal`, whose count to its look the mob keeps, as
    /// its hurt starts it, `notifyHurt` (CAL-172).
    WakeFriends
    /// A drowned's own (CAL-175): `DrownedGoToWaterGoal`, `DrownedGoToBeachGoal` and
    /// `DrownedSwimUpGoal`.
    ToWater(ToWater)
    Beach(Beach)
    SwimUp(SwimUp)
    /// A bee's own, by its `BEE_` kind (CAL-177).
    Bee(i32)
    /// A phantom's own, by its `PHANTOM_` kind, whose state the phantom keeps (CAL-200).
    Phantom(i32)
    /// A vex's own, by its `VEX_` kind (CAL-200).
    Vex(i32)
    /// A spellcaster's, `SpellcasterCastingSpellGoal` or a `SpellcasterUseSpellGoal` (CAL-200).
    Spell(Spell)
    /// A ghast's `RandomFloatAroundGoal`, `GhastLookGoal`, and `GhastShootFireballGoal`, with its
    /// ticks charging, `chargeTime` (CAL-200).
    GhastFloat(i32)
    GhastLook(i32)
    GhastShoot(i32)
    /// A blaze's `BlazeAttackGoal` (CAL-200).
    BlazeAttack(BlazeAttack)
    /// A guardian's `GuardianAttackGoal`, with its ticks into its attack, `attackTime` (CAL-200).
    GuardianAttack(i32)
    /// `MoveTowardsRestrictionGoal`, toward its home where it's away from it (CAL-200).
    Restrict(Restrict)
    /// A fish's (CAL-178): `AvoidEntityGoal` of players, and a schooling fish's
    /// `FollowFlockLeaderGoal`.
    Avoid(Avoid)
    Flock(Flock)
    /// One whose workings come later, by its `LATER_` kind.
    Later(i32)
}

/// `MoveTowardsRestrictionGoal`'s (CAL-200): where it's going, and how fast.
pub struct Restrict {
    pub wanted_x: f64 = 0.0
    pub wanted_y: f64 = 0.0
    pub wanted_z: f64 = 0.0
    pub speed: f64
}

/// A target goal's own, `TargetGoal`'s (CAL-159): whether it keeps only a target it sees,
/// `mustSee`; how many of its ticks it's kept one it doesn't, `unseenTicks`, and how many it keeps
/// one unseen for, `unseenMemoryTicks`, before they're halved, `reducedTickDelay`; and the target
/// it took up, by ID, `targetMob`.
pub struct Targeting {
    pub must_see: bool
    pub unseen_ticks: i32 = 0
    pub unseen_memory: i32 = 60
    pub target_mob: i32? = none
}

/// `NearestAttackableTargetGoal`'s (CAL-159): what it looks for, a `SEEK_` kind; one in how many of
/// its tries it looks, `randomInterval`, already halved; the target it found, by ID; and its
/// `TargetGoal`'s.
pub struct Nearest {
    pub seek: i32
    pub interval: i32
    pub found: i32? = none
    pub targeting: Targeting
    /// How far above or below it a target may be, -1 for any; a slime's 4, its selector's
    /// (CAL-159).
    pub max_dy: f64 = -1.0
    /// Whether it takes up only those a drowned may, `okTarget`: any by night, by day those in
    /// water (CAL-175).
    pub drowned: bool = false
    /// Whether it's a bee's, `BeeBecomeAngryTargetGoal`: used and going on only while the bee's
    /// angry and hasn't stung, and taking up only a player it's angry at (CAL-177).
    pub bee: bool = false
    /// Whether it's a guardian's, of living entities with its `GuardianAttackSelector`: a player,
    /// a squid or an axolotl, of which Calcite has players, more than 3 from it (CAL-200).
    pub guardian: bool = false
    /// Whether it takes up only a player it's angry at, `isAngryAt`, a zombified piglin's
    /// (CAL-200).
    pub angry: bool = false
}

/// `HurtByTargetGoal`'s (CAL-159): whether it alerts the mobs of its class near it,
/// `alertSameType`, all but those it ignores, `toIgnoreAlert`; when it last took up what hurt it,
/// by its tick count then, `timestamp`; and its `TargetGoal`'s, which always sees.
pub struct HurtBy {
    pub alert: bool
    pub timestamp: i32 = 0
    pub targeting: Targeting
    /// Whether it's a bee's, `BeeHurtByOtherGoal`: going on only while the bee's angry, and
    /// alerting only the bees that see what hurt it (CAL-177).
    pub bee: bool = false
    /// Whether it ignores being hurt by a raider, its `toIgnoreDamage` of `Raider.class`, a
    /// raider's own (CAL-200).
    pub raiders_ignored: bool = false
}

/// `MeleeAttackGoal`'s (CAL-159): how fast it goes, `speedModifier`; whether it follows a target it
/// doesn't see, `followingTargetEvenIfNotSeen`; the path it found as it could be used; where its
/// target was as it last found a path to it, `pathedTargetX`, `Y` and `Z`; its ticks till it finds
/// one again and till it may attack again; the game time it was last asked whether it could be
/// used, `lastCanUseCheck`; and a zombie's ticks with its arms up, `raiseArmTicks`, where `zombie`.
pub struct Melee {
    pub speed: f64
    pub follow_unseen: bool
    pub zombie: bool
    /// Whether it's a drowned's, `DrownedAttackGoal`, used and going on only while its target's
    /// one it may take up, `okTarget` (CAL-175).
    pub drowned: bool = false
    /// Whether it's a bee's, `BeeAttackGoal`, used and going on only while the bee's angry and
    /// hasn't stung (CAL-177).
    pub bee: bool = false
    pub path: Path? = none
    pub pathed_x: f64 = 0.0
    pub pathed_y: f64 = 0.0
    pub pathed_z: f64 = 0.0
    pub recalc: i32 = 0
    pub until_attack: i32 = 0
    pub last_check: i64 = 0
    pub raise_arm: i32 = 0
}

/// `MoveThroughVillageGoal`'s (D605): how fast it goes, `speedModifier`; whether only at night,
/// `onlyAtNight`; how near the point of interest it's to come, `distanceToPoi`; the point of
/// interest it's going to, `poiPos`, and the path there; and those it's been to lately,
/// `visited`, the oldest first, which aren't saved.
pub struct ThroughVillage {
    pub speed: f64
    pub only_at_night: bool
    pub distance_to_poi: i32
    pub poi: BlockPos
    pub path: Path? = none
    pub visited: List<BlockPos> = List<BlockPos>()
}

/// `RangedCrossbowAttackGoal`'s (CAL-200): how fast it goes, `speedModifier`, and how far it
/// shoots, squared, `attackRadiusSqr`; its crossbow's state, `CrossbowState`, `CROSSBOW_UNCHARGED`
/// to `CROSSBOW_READY`; for how many ticks it's seen its target, or, below 0, not, `seeTime`; its
/// ticks till it may shoot once charged, `attackDelay`, and till it finds its path again,
/// `updatePathDelay`.
pub struct Crossbow {
    pub speed: f64
    pub radius_sqr: f32
    pub state: i32 = CROSSBOW_UNCHARGED
    pub see_time: i32 = 0
    pub attack_delay: i32 = 0
    pub update_path_delay: i32 = 0
}

/// `RangedCrossbowAttackGoal.CrossbowState`, by its order.
pub const CROSSBOW_UNCHARGED: i32 = 0
pub const CROSSBOW_CHARGING: i32 = 1
pub const CROSSBOW_CHARGED: i32 = 2
pub const CROSSBOW_READY: i32 = 3

/// `RangedBowAttackGoal`'s (CAL-159): how fast it goes, `speedModifier`; the least ticks between
/// its shots, `attackIntervalMin`, which its weapon goal's set sets as the difficulty has it; how
/// far it shoots, squared, `attackRadiusSqr`; its ticks till it draws again, `attackTime`; for how
/// many ticks it's seen its target, or, below 0, not, `seeTime`; which way it strafes,
/// `strafingClockwise` and `strafingBackwards`; and for how long it has, `strafingTime`, -1 while
/// it doesn't.
pub struct Bow {
    pub speed: f64
    pub interval: i32
    pub radius_sqr: f32
    pub attack_time: i32 = -1
    pub see_time: i32 = 0
    pub clockwise: bool = false
    pub backwards: bool = false
    pub strafing_time: i32 = -1
}

/// `SpearUseGoal`'s state, `SpearUseState`, while it runs, `on` (CAL-159): the goal ticks its
/// spear stays down for, `engageTime`, -1 until it's engaged; how long it's been getting away,
/// `fleeingTime`, -1 until then; where it's going to get away, `awayPos`; and whether it's done.
pub struct SpearUse {
    pub on: bool = false
    pub engage_time: i32 = -1
    pub fleeing_time: i32 = -1
    pub away: (f64, f64, f64)? = none
    pub done: bool = false
}

/// `EndermanLookForPlayerGoal`'s (CAL-159): the player who stared at it, whom it takes up once
/// `aggro_time` is out, -1 for none, `pendingTarget`; its ticks toward a teleport toward its
/// target, `teleportTime`; the target it took up, `target`; and `TargetGoal`'s state.
pub struct EnderLook {
    pub pending: i32 = -1
    pub aggro_time: i32 = 0
    pub teleport_time: i32 = 0
    pub target: i32 = -1
    pub targeting: Targeting
}

/// `RangedAttackGoal`'s (CAL-159): how fast it goes for its target, the least and most ticks
/// between its attacks and how near it attacks from; and the ticks till its next attack,
/// `attackTime`, -1 for none drawn up, how long it's seen its target, `seeTime`, and the target it
/// took up, -1 for none.
pub struct Ranged {
    pub speed: f64
    pub interval_min: i32
    pub interval_max: i32
    pub radius: f32
    /// Whether it.s a drowned.s, `DrownedTridentAttackGoal`, used only with a trident in its main
    /// hand, which it uses while it runs, aggressive (CAL-200).
    pub drowned: bool = false
    pub attack_time: i32 = -1
    pub see_time: i32 = 0
    pub target: i32 = -1
}

/// A spellcaster's spell goal (CAL-200): the spell it casts, a `SPELL_` kind, `SPELL_CASTING` for
/// `SpellcasterCastingSpellGoal`; then a `SpellcasterUseSpellGoal`'s ticks of its own till it
/// casts, `attackWarmupDelay`, and the tick it may cast again from, `nextAttackTickCount`.
pub struct Spell {
    pub kind: i32
    pub warmup: i32 = 0
    pub next: i32 = 0
}

/// `Blaze.BlazeAttackGoal`'s (CAL-200): which of its volley's steps it's at, `attackStep`; its
/// ticks till its next, `attackTime`; and the ticks since it last saw its target, `lastSeen`.
pub struct BlazeAttack {
    pub step: i32 = 0
    pub time: i32 = 0
    pub last_seen: i32 = 0
}

/// `FleeSunGoal`'s (CAL-159): how fast it goes, and the shade it goes to.
pub struct FleeSun {
    pub speed: f64
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
}

/// `RemoveBlockGoal`'s, of `MoveToBlockGoal` (CAL-159): the block it breaks, by name; how fast it
/// goes; how far it looks across and up and down, `searchRange` and `verticalSearchRange`; its
/// ticks till it looks again, `nextStartTick`; and the block it found.
pub struct RemoveBlock {
    pub block: String
    pub speed: f64
    pub range: i32 = 24
    pub vertical: i32
    pub next_start: i32 = 0
    pub x: i32 = 0
    pub y: i32 = 0
    pub z: i32 = 0
}

/// A drowned's `DrownedGoToWaterGoal` (CAL-175): how fast it goes, and the water it found to go
/// to, `wantedX`, `Y` and `Z`.
pub struct ToWater {
    pub speed: f64
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
}

/// A drowned's `DrownedGoToBeachGoal`, a `MoveToBlockGoal` 8 across and 2 up and down (CAL-175):
/// how fast it goes; its ticks till it looks again, `nextStartTick`; its tries and most ticks
/// there, `tryTicks` and `maxStayTicks`; the block it found; and whether it's there,
/// `reachedTarget`.
pub struct Beach {
    pub speed: f64
    pub range: i32 = 8
    pub vertical: i32 = 2
    pub next_start: i32 = 0
    pub try_ticks: i32 = 0
    pub max_stay: i32 = 0
    pub x: i32 = 0
    pub y: i32 = 0
    pub z: i32 = 0
    pub reached: bool = false
}

/// A drowned's `DrownedSwimUpGoal` (CAL-175): how fast it goes, and whether it found nowhere up to
/// go, `stuck`.
pub struct SwimUp {
    pub speed: f64
    pub stuck: bool = false
}

/// `PanicGoal`'s (D416): how fast it runs, and where to.
pub struct Panic {
    pub speed: f64
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
}

/// `AvoidEntityGoal`'s of players, a fish's (CAL-178): how near they're fled, `maxDist`; how fast
/// it goes, walking and within 7 of them, `walkSpeedModifier` and `sprintSpeedModifier`; the one
/// it flees, by ID, `toAvoid`; and the path it found away, `path`.
pub struct Avoid {
    pub max_dist: f32
    pub walk: f64
    pub sprint: f64
    pub to_avoid: i32? = none
    pub path: Path? = none
}

/// `FollowFlockLeaderGoal`'s (CAL-178): its ticks till it finds its path to its leader again,
/// `timeToRecalcPath`, and till it looks for one, `nextStartTick`.
pub struct Flock {
    pub recalc: i32 = 0
    pub next_start: i32
}

/// `RandomLookAroundGoal`'s: which way it looks, and for how long more.
pub struct LookAround {
    pub rel_x: f64 = 0.0
    pub rel_z: f64 = 0.0
    pub look_time: i32 = 0
}

/// `LookAtPlayerGoal`'s: the player it looks at, by ID; how far it looks, and how likely it is to
/// start; for how long more; and what it looks at, `lookAtType`, players, `LOOK_PLAYERS`, or among
/// the mobs its level found near it, the nearest it sees, `getNearestEntity`, of them guardians,
/// a guardian's of `Guardian.class`, `LOOK_GUARDIANS`, or any, an illager's of `Mob.class`,
/// `LOOK_MOBS` (CAL-200).
pub struct LookAtPlayer {
    pub look_at: i32? = none
    pub distance: f32
    pub probability: f32 = 0.02f32
    pub look_time: i32 = 0
    pub of: i32 = LOOK_PLAYERS
}

/// What a `LookAtPlayerGoal` looks at, `LookAtPlayer.of`.
pub const LOOK_PLAYERS: i32 = 0
pub const LOOK_GUARDIANS: i32 = 1
pub const LOOK_MOBS: i32 = 2

/// `RandomStrollGoal`'s, and `WaterAvoidingRandomStrollGoal`'s where `water_avoiding`: where it's
/// going and how fast; one in how many full ticks it starts, `interval`; whether it's told to,
/// `forceTrigger`; and whether it rests once it's done nothing for 100 ticks. A silverfish's
/// `SilverfishMergeWithStoneGoal` is one, `merge`, with the way it chose, `selectedDirection`, by
/// its 3D data value, and whether it's to go into the block that way, `doMerge` (CAL-172).
pub struct Stroll {
    pub wanted_x: f64 = 0.0
    pub wanted_y: f64 = 0.0
    pub wanted_z: f64 = 0.0
    pub speed: f64
    pub interval: i32 = 120
    pub force: bool = false
    pub check_no_action: bool = true
    pub water_avoiding: bool = true
    pub probability: f32 = 0.001f32
    pub merge: bool = false
    pub merge_way: i32 = -1
    pub merging: bool = false
    /// Whether it's a fish's `FishSwimGoal`, a `RandomSwimmingGoal` (CAL-178): used only where the
    /// fish may swim at random, `canRandomSwim`, to a place in water, `getRandomSwimmablePos`.
    pub swim: bool = false
}

/// `EatBlockGoal`'s: how long its eating has left, `eatAnimationTick`.
pub struct EatBlock {
    pub tick: i32 = 0
}

/// A horse's `RandomStandGoal`'s: its count toward standing, `nextStand`, below 0 at first.
pub struct Stand {
    pub next: i32
}

/// `RunAroundLikeCrazyGoal`'s (D710): how fast it runs, and where to.
pub struct RunAround {
    pub speed: f64
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
}

/// `TemptGoal`'s, never scared off: the set of items it follows a player holding, by its bit; how
/// fast it follows; for how many more of its tries it's calm, `calmDown`; and the player it
/// follows, by ID.
pub struct Tempt {
    pub bit: u32
    pub speed: f64
    pub calm_down: i32 = 0
    pub player: i32? = none
}

/// `BreedGoal`'s: how fast it goes to its partner; its partner, by ID; and how many of its ticks
/// it's been going to it, `loveTime`.
pub struct Breed {
    pub speed: f64
    pub partner: i32? = none
    pub love_time: i32 = 0
}

/// `FollowParentGoal`'s: how fast it follows; the parent it follows, by ID; and its ticks till it
/// finds its path to the parent again, `timeToRecalcPath`.
pub struct FollowParent {
    pub speed: f64
    pub parent: i32? = none
    pub recalc: i32 = 0
}

/// A goal as its selector keeps it, `WrappedGoal`.
pub struct Wrapped {
    pub priority: i32
    pub flags: u32
    pub every_tick: bool
    pub running: bool = false
    pub goal: Goal?
}

/// A mob's `GoalSelector`: its goals in the order they were added, which goal holds each control,
/// by the goal's place, and the controls turned off, `disabledFlags`.
pub struct GoalSelector {
    entries: List<Wrapped> = List<Wrapped>()
    move_holder: i32 = -1
    look_holder: i32 = -1
    jump_holder: i32 = -1
    target_holder: i32 = -1
    disabled: u32 = 0
}

/// `Goal.reducedTickDelay`: half, rounded up, as a goal that doesn't tick every tick counts.
pub fn reduced_tick_delay(ticks: i32) -> i32 {
    return (ticks + 1) / 2
}

impl GoalSelector {
    /// None.
    pub fn new() -> GoalSelector {
        return GoalSelector()
    }

    /// Whether a `BreedGoal` of its runs, which reads the mobs near it (CAL-158).
    pub fn breeding(self) -> bool {
        for e in self.entries {
            if e.running {
                if let g = e.goal {
                    if let Goal.Breed(_) = g {
                        return true
                    }
                }
            }
        }
        return false
    }

    /// Whether a `PanicGoal` of its runs, `PathfinderMob.isPanicking`, which its partners' breeding
    /// reads (D416).
    pub fn panicking(self) -> bool {
        for e in self.entries {
            if e.running {
                if let g = e.goal {
                    if let Goal.Panic(_) = g {
                        return true
                    }
                }
            }
        }
        return false
    }

    /// `addGoal`, its flags and whether it ticks every tick, `requiresUpdateEveryTick`, as its
    /// kind sets them.
    pub fn add(mut self, priority: i32, flags: u32, every_tick: bool, goal: own Goal) {
        self.entries.push(Wrapped { priority: priority, flags: flags, every_tick: every_tick, goal: some(goal) })
    }

    pub fn len(self) -> usize {
        return self.entries.len()
    }

    pub fn running(self, i: usize) -> bool {
        return self.entries[i].running
    }

    pub fn set_running(mut self, i: usize, on: bool) {
        self.entries[i].running = on
    }

    pub fn every_tick(self, i: usize) -> bool {
        return self.entries[i].every_tick
    }

    pub fn flags(self, i: usize) -> u32 {
        return self.entries[i].flags
    }

    /// `goalContainsAnyFlags` of the controls turned off.
    pub fn disabled_for(self, i: usize) -> bool {
        return self.entries[i].flags & self.disabled != 0
    }

    /// `setControlFlag`.
    pub fn set_control(mut self, flag: u32, enabled: bool) {
        if enabled {
            self.disabled = self.disabled & ~flag
        } else {
            self.disabled = self.disabled | flag
        }
    }

    /// The goal that holds the control of bit `k`, 0 to 3, by its place, or -1 for none.
    pub fn holder(self, k: i32) -> i32 {
        if k == 0 {
            return self.move_holder
        }
        if k == 1 {
            return self.look_holder
        }
        if k == 2 {
            return self.jump_holder
        }
        return self.target_holder
    }

    /// The control of bit `k` held by the goal at `i`.
    pub fn lock(mut self, k: i32, i: usize) {
        let at = i32.wrap(i)
        if k == 0 {
            self.move_holder = at
        } else if k == 1 {
            self.look_holder = at
        } else if k == 2 {
            self.jump_holder = at
        } else {
            self.target_holder = at
        }
    }

    /// `goalCanBeReplacedForAllFlags`: whether each control the goal at `i` takes is held by none,
    /// or by a goal of a greater priority number, running or not; every goal can be interrupted.
    pub fn replaceable(self, i: usize) -> bool {
        for k in 0..4 {
            if self.entries[i].flags & (1u32 << u32.wrap(k)) != 0 {
                let h = self.holder(k)
                if h >= 0 and not (self.entries[i].priority < self.entries[usize.wrap(h)].priority) {
                    return false
                }
            }
        }
        return true
    }

    /// `lockedFlags.entrySet().removeIf`: the holds of goals not running let go.
    pub fn unlock_stopped(mut self) {
        for k in 0..4 {
            let h = self.holder(k)
            if h >= 0 and not self.entries[usize.wrap(h)].running {
                if k == 0 {
                    self.move_holder = -1
                } else if k == 1 {
                    self.look_holder = -1
                } else if k == 2 {
                    self.jump_holder = -1
                } else {
                    self.target_holder = -1
                }
            }
        }
    }

    /// The goal at `i`'s state, lent out to be worked on and given back with `put`.
    pub fn take(mut self, i: usize) -> Goal? {
        return self.entries[i].goal.take()
    }

    /// `removeGoal` of a skeleton's weapon goal, its `RangedBowAttackGoal` or its
    /// `MeleeAttackGoal`, the first of its goals that's one (CAL-159): taken out, the holds of the
    /// goals after it a place down and its own let go, as a goal stopped lets its go before others
    /// start; its state, and whether it ran, which the caller stops it for.
    pub fn take_weapon_goal(mut self) -> (Goal, bool)? {
        for i in 0..self.entries.len() {
            var weapon = false
            if let g = self.entries[i].goal {
                weapon = match g {
                    Goal.Bow(_) => true,
                    Goal.Melee(_) => true,
                    _ => false,
                }
            }
            if not weapon {
                continue
            }
            let e = self.entries.remove(i)
            let at = i32.wrap(i)
            for k in 0..4 {
                let h = self.holder(k)
                if h == at {
                    self.lock_at(k, -1)
                } else if h > at {
                    self.lock_at(k, h - 1)
                }
            }
            let g = e.goal else return none
            return some((g.copy(), e.running))
        }
        return none
    }

    // The control of bit `k` held by the goal at `at`, -1 for none.
    fn lock_at(mut self, k: i32, at: i32) {
        if k == 0 {
            self.move_holder = at
        } else if k == 1 {
            self.look_holder = at
        } else if k == 2 {
            self.jump_holder = at
        } else {
            self.target_holder = at
        }
    }

    pub fn put(mut self, i: usize, g: own Goal) {
        self.entries[i].goal = some(g)
    }

    /// `RandomStrollGoal.trigger` of its strolls, a guardian's as it's hurt and as its attack
    /// stops (CAL-200): each told to go next time, `forceTrigger`, where it's here.
    pub fn trigger_strolls(mut self) {
        for i in 0..self.entries.len() {
            let taken = self.entries[i].goal.take() else continue
            match taken {
                Goal.Stroll(s) => {
                    var t = s
                    t.force = true
                    self.entries[i].goal = some(Goal.Stroll(t))
                },
                other => self.entries[i].goal = some(other),
            }
        }
    }
}

/// A mob's `Sensing`: the entities it's found it can see this tick, and those it can't, by ID.
pub struct Sensing {
    seen: List<i32> = List<i32>()
    unseen: List<i32> = List<i32>()
}

impl Sensing {
    /// `tick`: nothing known.
    pub fn clear(mut self) {
        self.seen.clear()
        self.unseen.clear()
    }

    /// Whether it's known to see `id` this tick, if it's known.
    pub fn known(self, id: i32) -> bool? {
        for s in self.seen {
            if s == id {
                return some(true)
            }
        }
        for s in self.unseen {
            if s == id {
                return some(false)
            }
        }
        return none
    }

    pub fn note(mut self, id: i32, seen: bool) {
        if seen {
            self.seen.push(id)
        } else {
            self.unseen.push(id)
        }
    }
}

/// `LivingEntity.hasLineOfSight` from eyes at fx, fy, fz to tx, ty, tz: none farther than 128,
/// and none where `clip` with `COLLIDER` and no fluid hits a block's collision shape as `mover`
/// meets it; a block not loaded is air.
pub fn sees<B: CollisionBlocks>(m: MovementStates, f: Facts, blocks: B, mover: Mover, fx: f64, fy: f64, fz: f64, tx: f64, ty: f64, tz: f64) -> bool {
    let dx = fx - tx
    let dy = fy - ty
    let dz = fz - tz
    if (dx * dx + dy * dy + dz * dz).sqrt() > 128.0 {
        return false
    }
    return not clips(m, f, blocks, mover, fx, fy, fz, tx, ty, tz)
}

// `BlockGetter.traverseBlocks` with `clip`'s step: each block the line from fx, fy, fz to tx,
// ty, tz goes through, nudged 1.0E-7 inward at both ends, until one's shape clips it.
fn clips<B: CollisionBlocks>(m: MovementStates, f: Facts, blocks: B, mover: Mover, fx: f64, fy: f64, fz: f64, tx: f64, ty: f64, tz: f64) -> bool {
    if fx == tx and fy == ty and fz == tz {
        return false
    }
    let to_x = tx + -1.0e-7 * (fx - tx)
    let to_y = ty + -1.0e-7 * (fy - ty)
    let to_z = tz + -1.0e-7 * (fz - tz)
    let from_x = fx + -1.0e-7 * (tx - fx)
    let from_y = fy + -1.0e-7 * (ty - fy)
    let from_z = fz + -1.0e-7 * (tz - fz)
    var bx = floor(from_x)
    var by = floor(from_y)
    var bz = floor(from_z)
    if block_clips(m, f, blocks, mover, bx, by, bz, fx, fy, fz, tx, ty, tz) {
        return true
    }
    let dx = to_x - from_x
    let dy = to_y - from_y
    let dz = to_z - from_z
    let sx = sign(dx)
    let sy = sign(dy)
    let sz = sign(dz)
    let delta_x = if sx == 0 { f64.MAX } else { f64(sx) / dx }
    let delta_y = if sy == 0 { f64.MAX } else { f64(sy) / dy }
    let delta_z = if sz == 0 { f64.MAX } else { f64(sz) / dz }
    var t_x = delta_x * (if sx > 0 { 1.0 - frac(from_x) } else { frac(from_x) })
    var t_y = delta_y * (if sy > 0 { 1.0 - frac(from_y) } else { frac(from_y) })
    var t_z = delta_z * (if sz > 0 { 1.0 - frac(from_z) } else { frac(from_z) })
    while t_x <= 1.0 or t_y <= 1.0 or t_z <= 1.0 {
        if t_x < t_y {
            if t_x < t_z {
                bx += sx
                t_x += delta_x
            } else {
                bz += sz
                t_z += delta_z
            }
        } else if t_y < t_z {
            by += sy
            t_y += delta_y
        } else {
            bz += sz
            t_z += delta_z
        }
        if block_clips(m, f, blocks, mover, bx, by, bz, fx, fy, fz, tx, ty, tz) {
            return true
        }
    }
    return false
}

// `Mth.sign`.
fn sign(v: f64) -> i32 {
    if v == 0.0 {
        return 0
    }
    return if v > 0.0 { 1 } else { -1 }
}

// `Mth.frac`.
fn frac(v: f64) -> f64 {
    return v - v.floor()
}

// `VoxelShape.clip` of the block at x, y, z's collision shape: none for an empty shape or a line
// shorter than 1.0E-7 squared; a hit where a thousandth along the line is inside it; else where the
// line crosses one of its boxes' faces, `AABB.clip`.
fn block_clips<B: CollisionBlocks>(m: MovementStates, f: Facts, blocks: B, mover: Mover, x: i32, y: i32, z: i32, fx: f64, fy: f64, fz: f64, tx: f64, ty: f64, tz: f64) -> bool {
    let state = blocks.collision_state(x, y, z) else return false
    let boxes = m.boxes_at(f, blocks, state, x, y, z, mover)
    if boxes.is_empty() {
        return false
    }
    let dx = tx - fx
    let dy = ty - fy
    let dz = tz - fz
    if dx * dx + dy * dy + dz * dz < 1.0e-7 {
        return false
    }
    let px = (fx + dx * 0.001) - f64(x)
    let py = (fy + dy * 0.001) - f64(y)
    let pz = (fz + dz * 0.001) - f64(z)
    for b in boxes {
        if b.min_x <= px and px < b.max_x and b.min_y <= py and py < b.max_y and b.min_z <= pz and pz < b.max_z {
            return true
        }
    }
    var scale = 1.0
    var hit = false
    for b in boxes {
        let min_x = b.min_x + f64(x)
        let min_y = b.min_y + f64(y)
        let min_z = b.min_z + f64(z)
        let max_x = b.max_x + f64(x)
        let max_y = b.max_y + f64(y)
        let max_z = b.max_z + f64(z)
        if dx > 1.0e-7 {
            if let s = clip_point(scale, dx, dy, dz, min_x, min_y, max_y, min_z, max_z, fx, fy, fz) {
                scale = s
                hit = true
            }
        } else if dx < -1.0e-7 {
            if let s = clip_point(scale, dx, dy, dz, max_x, min_y, max_y, min_z, max_z, fx, fy, fz) {
                scale = s
                hit = true
            }
        }
        if dy > 1.0e-7 {
            if let s = clip_point(scale, dy, dz, dx, min_y, min_z, max_z, min_x, max_x, fy, fz, fx) {
                scale = s
                hit = true
            }
        } else if dy < -1.0e-7 {
            if let s = clip_point(scale, dy, dz, dx, max_y, min_z, max_z, min_x, max_x, fy, fz, fx) {
                scale = s
                hit = true
            }
        }
        if dz > 1.0e-7 {
            if let s = clip_point(scale, dz, dx, dy, min_z, min_x, max_x, min_y, max_y, fz, fx, fy) {
                scale = s
                hit = true
            }
        } else if dz < -1.0e-7 {
            if let s = clip_point(scale, dz, dx, dy, max_z, min_x, max_x, min_y, max_y, fz, fx, fy) {
                scale = s
                hit = true
            }
        }
    }
    return hit
}

// `AABB.clipPoint`: how far along the line it crosses the face at `point` of axis a, where that's
// past its start, nearer than `scale`, and within the face's bounds but for 1.0E-7.
fn clip_point(scale: f64, da: f64, db: f64, dc: f64, point: f64, min_b: f64, max_b: f64, min_c: f64, max_c: f64, from_a: f64, from_b: f64, from_c: f64) -> f64? {
    let s = (point - from_a) / da
    let pb = from_b + s * db
    let pc = from_c + s * dc
    if 0.0 < s and s < scale and min_b - 1.0e-7 < pb and pb < max_b + 1.0e-7 and min_c - 1.0e-7 < pc and pc < max_c + 1.0e-7 {
        return some(s)
    }
    return none
}

/// What a mob that looks for a player is to them, as `TargetingConditions` for no combat test it:
/// its ID, where its feet and eyes are, and how its collisions see it; and its entity type's ID,
/// which what they wear may hide them from, `MOB_VISIBILITY` (CAL-159).
pub struct Looker {
    pub id: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub eye_y: f64
    pub mover: Mover
    pub kind: i32 = -1
}

/// `getNearestPlayer(TargetingConditions, mob, x, y, z)` with `forNonCombat().range(range)`, from
/// the mob's x and z and `from_y`, its eyes' for `LookAtPlayerGoal` and its feet's for
/// `TemptGoal`: of `players`, in the level's order, those seen by anyone, alive and not spectating,
/// holding what's in one of the sets `tempting` where that's any, `selector`, within the range from
/// the mob's feet times how visible they are to it, `getVisibilityPercent`, but 2 at least, and
/// where `sight`, in its sight, as `sensing` remembers it for the tick; the nearest, the first of
/// those as near.
pub fn nearest_player<B: CollisionBlocks>(m: MovementStates, f: Facts, blocks: B, sensing: mut Sensing, who: Looker, players: List<Follower>, range: f64, from_y: f64, sight: bool, tempting: u32) -> i32? {
    var best = -1.0
    var found: i32? = none
    for p in players {
        if p.id == who.id or p.spectator or p.dead {
            continue
        }
        if tempting != 0u32 and p.tempts & tempting == 0u32 {
            continue
        }
        let visibility = p.visibility(who.kind)
        let seen_within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
        let fx = who.x - p.x
        let fy = who.y - p.y
        let fz = who.z - p.z
        if fx * fx + fy * fy + fz * fz > seen_within * seen_within {
            continue
        }
        if sight and not sees_player(m, f, blocks, mut sensing, who, p) {
            continue
        }
        let ex = p.x - who.x
        let ey = p.y - from_y
        let ez = p.z - who.z
        let d = ex * ex + ey * ey + ez * ez
        if best == -1.0 or d < best {
            best = d
            found = some(p.id)
        }
    }
    return found
}

/// `getNearestPlayer` with `TargetingConditions.forCombat().range(range)` (CAL-159), the target
/// conditions of a target goal that looks for players, from the mob's x and z and its eyes: of
/// `players`, in the level's order, those but itself seen by anyone, alive and not spectating, who
/// may be seen as an enemy, `canAttack`; within the range from its feet times how visible they are
/// to it, `getVisibilityPercent`, crouching or in what hides them from it, `MOB_VISIBILITY`, but 2
/// at least; and in its sight, as `sensing` remembers it for the tick; the nearest, the first of
/// those as near. Invisibility comes with effects. No teams, so none are allied. Of mobs, as
/// `getNearestEntity` has them, the same (CAL-244): a target goal's conditions always ask for
/// its sight as it looks, `checkLineOfSight`, even where it needn't keep seeing them, `mustSee`.
pub fn nearest_enemy<B: CollisionBlocks>(m: MovementStates, f: Facts, blocks: B, sensing: mut Sensing, who: Looker, players: List<Follower>, range: f64) -> i32? {
    var best = -1.0
    var found: i32? = none
    for p in players {
        if p.id == who.id or p.spectator or p.dead or not p.enemy {
            continue
        }
        let visibility = p.visibility(who.kind)
        let seen_within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
        let fx = who.x - p.x
        let fy = who.y - p.y
        let fz = who.z - p.z
        if fx * fx + fy * fy + fz * fz > seen_within * seen_within {
            continue
        }
        if not sees_player(m, f, blocks, mut sensing, who, p) {
            continue
        }
        let ex = p.x - who.x
        let ey = p.y - who.eye_y
        let ez = p.z - who.z
        let d = ex * ex + ey * ey + ez * ez
        if best == -1.0 or d < best {
            best = d
            found = some(p.id)
        }
    }
    return found
}

/// The player an `AvoidEntityGoal` of players flees (CAL-178), `getNearestEntity` over those whose
/// boxes meet `near`, the mob's grown by its reach across and 3 up and down, with
/// `TargetingConditions.forCombat().range(range)`: as `nearest_enemy` has them, but none where
/// it's `peaceful`, `canAttack`, and the nearest from its feet.
pub fn nearest_avoided<B: CollisionBlocks>(m: MovementStates, f: Facts, blocks: B, sensing: mut Sensing, who: Looker, players: List<Follower>, range: f64, near: Aabb, peaceful: bool) -> i32? {
    if peaceful {
        return none
    }
    var best = -1.0
    var found: i32? = none
    for p in players {
        if p.id == who.id or p.spectator or p.dead or not p.enemy {
            continue
        }
        let half = 0.3
        let b = p.bounds ?? Aabb { min_x: p.x - half, min_y: p.y, min_z: p.z - half, max_x: p.x + half, max_y: p.y + f64(p.height), max_z: p.z + half }
        if not b.intersects(near.min_x, near.min_y, near.min_z, near.max_x, near.max_y, near.max_z) {
            continue
        }
        let visibility = p.visibility(who.kind)
        let seen_within = if range * visibility > 2.0 { range * visibility } else { 2.0 }
        let fx = who.x - p.x
        let fy = who.y - p.y
        let fz = who.z - p.z
        let d = fx * fx + fy * fy + fz * fz
        if d > seen_within * seen_within {
            continue
        }
        if not sees_player(m, f, blocks, mut sensing, who, p) {
            continue
        }
        if best == -1.0 or d < best {
            best = d
            found = some(p.id)
        }
    }
    return found
}

/// `Sensing.hasLineOfSight` of the player `p` from the mob `who`'s eyes to theirs, as `sensing`
/// remembers it for the tick, else found and remembered (CAL-159).
pub fn sees_player<B: CollisionBlocks>(m: MovementStates, f: Facts, blocks: B, sensing: mut Sensing, who: Looker, p: Follower) -> bool {
    if let k = sensing.known(p.id) {
        return k
    }
    let seen = sees(m, f, blocks, who.mover, who.x, who.eye_y, who.z, p.x, p.y + f64(p.eyes), p.z)
    sensing.note(p.id, seen)
    return seen
}

/// What the places a mob may stroll to are tried against: where it is, and the least and highest
/// y blocks are at.
pub struct Wander {
    pub x: f64
    pub y: f64
    pub z: f64
    pub min_y: i32
    pub top_y: i32
    /// Whether its navigation's amphibious, a drowned's, whose stable places are over anything
    /// but air, `AmphibiousPathNavigation.isStableDestination` (CAL-175).
    pub amphibious: bool = false
    /// Whether its navigation swims, a fish's, whose stable places are any not solid to render
    /// themselves, `WaterBoundPathNavigation.isStableDestination` (CAL-178).
    pub swimming: bool = false
    /// The home it stays near, its place and radius, where it has one, as a leash gives it about
    /// its holder, `hasHome` (CAL-179).
    pub home: ((i32, i32, i32), i32)? = none
}

// `RandomPos.generateRandomDirection`: up to `h` across and `v` up or down.
fn random_direction(random: mut LegacyRandom, h: i32, v: i32) -> (i32, i32, i32) {
    let x = random.next_int_below(2 * h + 1) - h
    let y = random.next_int_below(2 * v + 1) - v
    let z = random.next_int_below(2 * h + 1) - h
    return (x, y, z)
}

// `RandomPos.generateRandomPosTowardDirection`: the place that far from it, but, for a mob with a
// home and more than 1 across, moved toward its home's middle up to half of `xz` each way across,
// drawn from its random, x then z (CAL-179).
fn toward(random: mut LegacyRandom, w: Wander, d: (i32, i32, i32), xz: f64) -> (i32, i32, i32) {
    let (x, y, z) = d
    var xt = f64(x)
    var zt = f64(z)
    if let (at, _) = w.home {
        if xz > 1.0 {
            let (hx, _, hz) = at
            if w.x > f64(hx) {
                xt -= random.next_double() * xz / 2.0
            } else {
                xt += random.next_double() * xz / 2.0
            }
            if w.z > f64(hz) {
                zt -= random.next_double() * xz / 2.0
            } else {
                zt += random.next_double() * xz / 2.0
            }
        }
    }
    return (floor(xt + w.x), floor(f64(y) + w.y), floor(zt + w.z))
}

// `GoalUtils.mobRestricted` (CAL-179): whether it has a home whose middle is within its radius,
// `xz` and 1 more of it, `closerToCenterThan`.
fn restricted(w: Wander, xz: f64) -> bool {
    let (at, radius) = w.home else return false
    let (hx, hy, hz) = at
    let dx = f64(hx) + 0.5 - w.x
    let dy = f64(hy) + 0.5 - w.y
    let dz = f64(hz) + 0.5 - w.z
    let reach = f64(radius) + xz + 1.0
    return dx * dx + dy * dy + dz * dz < reach * reach
}

// `GoalUtils.isRestricted`: where `restrict`, whether the place is out of its home, `isWithinHome`,
// within its radius of its home's place, `distSqr` (CAL-179).
fn out_of_home(w: Wander, restrict: bool, x: i32, y: i32, z: i32) -> bool {
    if not restrict {
        return false
    }
    let (at, radius) = w.home else return false
    let (hx, hy, hz) = at
    let dx = f64(hx - x)
    let dy = f64(hy - y)
    let dz = f64(hz - z)
    return not (dx * dx + dy * dy + dz * dz < f64(radius * radius))
}

// `isOutsideLimits` and `isNotStable`: within the build height, over a block solid to render.
fn stable_within<B: CollisionBlocks>(f: Facts, blocks: B, w: Wander, x: i32, y: i32, z: i32) -> bool {
    if y < w.min_y or y > w.top_y {
        return false
    }
    if w.amphibious {
        return not f.is_air(state_at(blocks, x, y - 1, z))
    }
    if w.swimming {
        return not f.solid_render(state_at(blocks, x, y, z))
    }
    return f.solid_render(state_at(blocks, x, y - 1, z))
}

// `GoalUtils.hasMalus`: whether the mob's malus for the place's static path type isn't 0.
fn has_malus<B: CollisionBlocks>(p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, x: i32, y: i32, z: i32) -> bool {
    return maluses[usize(p.at(blocks, mut cache, w.min_y, x, y, z))] != 0.0f32
}

/// The 10 places `LandRandomPos.getPos` tries for a mob, none out of its home where it's near enough to be kept to it, `mobRestricted` (CAL-179), up to `h` across and `v` up
/// or down: each toward a direction drawn from its random, within the build height and over a
/// block solid to render, moved up out of what's solid, `movePosUpOutOfSolid`, but none in water
/// or with a malus.
pub fn land_tries<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, h: i32, v: i32) -> List<(i32, i32, i32)?> {
    var out = List<(i32, i32, i32)?>()
    let restrict = restricted(w, f64(h))
    for _ in 0..10 {
        let d = random_direction(mut random, h, v)
        out.push(land_place(mut random, f, p, blocks, mut cache, maluses, w, d, f64(h), restrict))
    }
    return out
}

/// The 10 places `LandRandomPos.getPosAway` tries for a mob, none out of its home where it's near enough to be kept to it, `mobRestricted` (CAL-179), its
/// `getPosInDirection`: each a direction drawn from its random,
/// `generateRandomDirectionWithinRadians`, within a right angle either side of the way `dir`
/// across, from `min_h` to `max_h` away and `v` up or down, none where that's past `max_h` either
/// way across, else the place as `land_tries` has it (CAL-159).
pub fn away_tries<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, min_h: f64, max_h: f64, v: i32, dir: (f64, f64)) -> List<(i32, i32, i32)?> {
    var out = List<(i32, i32, i32)?>()
    let (dx, dz) = dir
    // `(float) (Math.PI / 2)`, and `Mth.SQRT_OF_TWO`, floats.
    let right = f64(1.5707964f32)
    let root_two = f64(1.4142135f32)
    let restrict = restricted(w, max_h)
    for _ in 0..10 {
        let center = (table_atan2(dz, dx) ?? 0.0) - right
        let turn = center + f64(2.0f32 * random.next_float() - 1.0f32) * right
        let reach = random.next_double().sqrt()
        let dist = (min_h + reach * (max_h - min_h)) * root_two
        let xt = -dist * sin(turn)
        let zt = dist * cos(turn)
        if xt.abs() > max_h or zt.abs() > max_h {
            out.push(none)
            continue
        }
        let yt = random.next_int_below(2 * v + 1) - v
        out.push(land_place(mut random, f, p, blocks, mut cache, maluses, w, (floor(xt), yt, floor(zt)), max_h, restrict))
    }
    return out
}

/// The 10 places `DefaultRandomPos.getPosTowards` tries for a mob, none out of its home where it's near enough to be kept to it, `mobRestricted` (CAL-179), within a right
/// angle either side of the way `dir` across (CAL-160): each a direction drawn from its random,
/// `generateRandomDirectionWithinRadians`, up to `h` away and `v` up or down, none where that's
/// past `h` either way across, else the place that far from it where it's within the build height,
/// over a block solid to render and with no malus, as `default_tries` has them.
pub fn towards_tries<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, h: i32, v: i32, dir: (f64, f64)) -> List<(i32, i32, i32)?> {
    var out = List<(i32, i32, i32)?>()
    let (dx, dz) = dir
    // `(float) (Math.PI / 2)`, and `Mth.SQRT_OF_TWO`, floats.
    let right = f64(1.5707964f32)
    let root_two = f64(1.4142135f32)
    let most = f64(h)
    let restrict = restricted(w, most)
    for _ in 0..10 {
        let center = (table_atan2(dz, dx) ?? 0.0) - right
        let turn = center + f64(2.0f32 * random.next_float() - 1.0f32) * right
        let dist = random.next_double().sqrt() * most * root_two
        let xt = -dist * sin(turn)
        let zt = dist * cos(turn)
        if xt.abs() > most or zt.abs() > most {
            out.push(none)
            continue
        }
        let yt = random.next_int_below(2 * v + 1) - v
        let (x, y, z) = toward(mut random, w, (floor(xt), yt, floor(zt)), most)
        if stable_within(f, blocks, w, x, y, z) and not out_of_home(w, restrict, x, y, z) and not has_malus(p, blocks, mut cache, maluses, w, x, y, z) {
            out.push(some((x, y, z)))
        } else {
            out.push(none)
        }
    }
    return out
}

// `LandRandomPos`'s place toward the direction `d` from a mob, none out of its home where `restrict` (CAL-179): within the build
// height and over a block solid to render, moved up out of what's solid, `movePosUpOutOfSolid`,
// but none in water or with a malus.
fn land_place<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, d: (i32, i32, i32), xz: f64, restrict: bool) -> (i32, i32, i32)? {
    let (x, y0, z) = toward(mut random, w, d, xz)
    if not stable_within(f, blocks, w, x, y0, z) or out_of_home(w, restrict, x, y0, z) {
        return none
    }
    var y = y0
    if f.is_solid(state_at(blocks, x, y, z)) {
        y += 1
        while y <= w.top_y and f.is_solid(state_at(blocks, x, y, z)) {
            y += 1
        }
    }
    if f.is_water(state_at(blocks, x, y, z)) or has_malus(p, blocks, mut cache, maluses, w, x, y, z) {
        return none
    }
    return some((x, y, z))
}

/// The 10 places `DefaultRandomPos.getPos` tries for a mob, none out of its home where it's kept to it (CAL-179): as `land_tries`, but
/// neither moved up nor kept from water.
pub fn default_tries<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, h: i32, v: i32) -> List<(i32, i32, i32)?> {
    var out = List<(i32, i32, i32)?>()
    let restrict = restricted(w, f64(h))
    for _ in 0..10 {
        let d = random_direction(mut random, h, v)
        let (x, y, z) = toward(mut random, w, d, f64(h))
        if stable_within(f, blocks, w, x, y, z) and not out_of_home(w, restrict, x, y, z) and not has_malus(p, blocks, mut cache, maluses, w, x, y, z) {
            out.push(some((x, y, z)))
        } else {
            out.push(none)
        }
    }
    return out
}

/// The 10 places `DefaultRandomPos.getPosAway` tries for a mob, none out of its home where it's kept to it (CAL-178, CAL-179): each a way
/// drawn from its random within a right angle either side of `dir` across, up to `h` away and `v`
/// up or down, `generateRandomDirectionWithinRadians`, none where that's past `h` either way
/// across; and the place that far from it, as `default_tries` keeps them.
pub fn away_any_tries<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, h: i32, v: i32, dir: (f64, f64)) -> List<(i32, i32, i32)?> {
    var out = List<(i32, i32, i32)?>()
    let restrict = restricted(w, f64(h))
    for _ in 0..10 {
        let d = direction_within(mut random, 0.0, f64(h), v, 0, dir, f64(1.5707964f32)) else {
            out.push(none)
            continue
        }
        let (x, y, z) = toward(mut random, w, d, f64(h))
        if stable_within(f, blocks, w, x, y, z) and not out_of_home(w, restrict, x, y, z) and not has_malus(p, blocks, mut cache, maluses, w, x, y, z) {
            out.push(some((x, y, z)))
        } else {
            out.push(none)
        }
    }
    return out
}

/// What a sheep's eating does to the level, `EatBlockGoal.tick`'s, where mob griefing lets it:
/// the block at x, y, z broken without its drops, `destroyBlock`, where `whole`; else the grass
/// block there turned to dirt, its break shown, level event 2001.
pub struct Grazed {
    pub x: i32
    pub y: i32
    pub z: i32
    pub whole: bool
}

// `RandomPos.generateRandomDirectionWithinRadians` (CAL-177): a way within `max_rad` either side of
// the way `dir` across, from `min_h` to `max_h` away and `v` up or down from `fly` up, drawn from
// `random`; none where that's past `max_h` either way across.
fn direction_within(random: mut LegacyRandom, min_h: f64, max_h: f64, v: i32, fly: i32, dir: (f64, f64), max_rad: f64) -> (i32, i32, i32)? {
    let (dx, dz) = dir
    let center = (table_atan2(dz, dx) ?? 0.0) - f64(1.5707964f32)
    let turn = center + f64(2.0f32 * random.next_float() - 1.0f32) * max_rad
    let dist = (min_h + random.next_double().sqrt() * (max_h - min_h)) * f64(1.4142135f32)
    let xt = -dist * sin(turn)
    let zt = dist * cos(turn)
    if xt.abs() > max_h or zt.abs() > max_h {
        return none
    }
    let yt = random.next_int_below(2 * v + 1) - v + fly
    return some((floor(xt), yt, floor(zt)))
}

// `RandomPos.moveUpToAboveSolid`: a solid place moved up out of what's solid, then up to `up`
// more, short of the next solid block, the build's top at most.
fn above_solid<B: CollisionBlocks>(f: Facts, blocks: B, w: Wander, x: i32, y0: i32, z: i32, up: i32) -> i32 {
    if not f.is_solid(state_at(blocks, x, y0, z)) {
        return y0
    }
    var y = y0 + 1
    while y <= w.top_y and f.is_solid(state_at(blocks, x, y, z)) {
        y += 1
    }
    let first = y
    while y <= w.top_y and y - first < up {
        y += 1
        if f.is_solid(state_at(blocks, x, y, z)) {
            y -= 1
            break
        }
    }
    return y
}

/// The 10 places `HoverRandomPos.getPos` tries for a bee, none out of its home where it's kept to it (CAL-177, CAL-179): each a way drawn
/// from its random within `max_rad` of `dir`, up to `h` away and `v` up or down, and the place
/// that far from it within the build height over what isn't air, its navigation's
/// `isStableDestination`; then a height from `min_up` to `max_up` drawn, and the place moved up
/// above what's solid by it, `moveUpToAboveSolid`, but none in water or with a malus.
pub fn hover_tries<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, h: i32, v: i32, dir: (f64, f64), max_rad: f64, max_up: i32, min_up: i32) -> List<(i32, i32, i32)?> {
    var out = List<(i32, i32, i32)?>()
    let restrict = restricted(w, f64(h))
    for _ in 0..10 {
        let d = direction_within(mut random, 0.0, f64(h), v, 0, dir, max_rad) else {
            out.push(none)
            continue
        }
        let (x, y0, z) = toward(mut random, w, d, f64(h))
        if y0 < w.min_y or y0 > w.top_y or out_of_home(w, restrict, x, y0, z) or f.is_air(state_at(blocks, x, y0 - 1, z)) {
            out.push(none)
            continue
        }
        let up = random.next_int_below(max_up - min_up + 1) + min_up
        let y = above_solid(f, blocks, w, x, y0, z, up)
        if f.is_water(state_at(blocks, x, y, z)) or has_malus(p, blocks, mut cache, maluses, w, x, y, z) {
            out.push(none)
        } else {
            out.push(some((x, y, z)))
        }
    }
    return out
}

/// The 10 places `AirAndWaterRandomPos.getPos` tries for a mob, none out of its home where it's near enough to be kept to it, `mobRestricted` (CAL-179), or `AirRandomPos`'s
/// where `dry` (CAL-177): each a way drawn from its random within `max_rad` of `dir`, up to `h`
/// away and `v` up or down from `fly` up, and the place that far from it within the build height,
/// moved up out of what's solid, `moveUpOutOfSolid`, but none with a malus, nor in water where
/// `dry`.
pub fn air_tries<B: CollisionBlocks>(random: mut LegacyRandom, f: Facts, p: PathStates, blocks: B, cache: mut PathTypeCache, maluses: List<f32>, w: Wander, h: i32, v: i32, fly: i32, dir: (f64, f64), max_rad: f64, dry: bool) -> List<(i32, i32, i32)?> {
    var out = List<(i32, i32, i32)?>()
    let restrict = restricted(w, f64(h))
    for _ in 0..10 {
        let d = direction_within(mut random, 0.0, f64(h), v, fly, dir, max_rad) else {
            out.push(none)
            continue
        }
        let (x, y0, z) = toward(mut random, w, d, f64(h))
        if y0 < w.min_y or y0 > w.top_y or out_of_home(w, restrict, x, y0, z) {
            out.push(none)
            continue
        }
        var y = y0
        if f.is_solid(state_at(blocks, x, y, z)) {
            y += 1
            while y <= w.top_y and f.is_solid(state_at(blocks, x, y, z)) {
                y += 1
            }
        }
        if has_malus(p, blocks, mut cache, maluses, w, x, y, z) or (dry and f.is_water(state_at(blocks, x, y, z))) {
            out.push(none)
        } else {
            out.push(some((x, y, z)))
        }
    }
    return out
}
