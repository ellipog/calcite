/// Mobs' goals, as vanilla's `GoalSelector` keeps them (CAL-158): `GoalSelector`, the goals a mob
/// has in the order its kind adds them, `ObjectLinkedOpenHashSet`'s, each with its priority, the
/// controls it takes, `Goal.Flag`, whether it ticks every tick, whether it's running, and its own
/// state, `Goal`; and which goal holds each control, `lockedFlags`, a goal that stops keeping its
/// hold until the next tick's cleanup, as vanilla's does. The goals' workings are `world.mob`'s,
/// as they read the whole mob; what they read of the world is here: `Sensing`, the targets a mob
/// has seen or not this tick; `sees`, `hasLineOfSight`, through the blocks' collision shapes as
/// the mob meets them, `clip` with `COLLIDER` and no fluid, which `BlockGetter.traverseBlocks`
/// steps through and each shape `VoxelShape.clip`s; `nearest_player`, `getNearestPlayer` with a
/// mob's `TargetingConditions` that aren't for combat; and the places `LandRandomPos` and
/// `DefaultRandomPos` try, each drawn from the mob's random as `RandomPos` draws it, which the mob
/// weighs by its walk target value.
module world.goals

import math.mth.{floor, table_atan2}
import std.java.math.{cos, sin}
import random.legacy.{LegacyRandom}
import world.collision.{Aabb, CollisionBlocks}
import world.experience_orb.{Follower}
import world.movement.{MovementStates, Mover}
import world.path_finder.{Path}
import world.paths.{PathStates, PathTypeCache, state_at}
import world.pos.{BlockPos}
import worldgen.facts.{Facts}

/// The controls a goal takes, `Goal.Flag`, a bit each, in the enum's order.
pub const FLAG_MOVE: u32 = 1
pub const FLAG_LOOK: u32 = 2
pub const FLAG_JUMP: u32 = 4
pub const FLAG_TARGET: u32 = 8

/// The goals whose workings come later, by kind: a horse's `BreedGoal`, which only a tamed horse
/// in love uses. None of them draws as it isn't used, so each is never used till then (CAL-159).
pub const LATER_BREED: i32 = 1
/// A skeleton's `AvoidEntityGoal` of wolves, which Calcite doesn't make yet, so it finds none and
/// draws nothing (CAL-159).
pub const LATER_AVOID_WOLF: i32 = 6
/// A spider's `AvoidEntityGoal` of armadillos that aren't scared, which Calcite doesn't make yet,
/// so it finds none and draws nothing (CAL-159).
pub const LATER_AVOID_ARMADILLO: i32 = 7
/// A creeper's `AvoidEntityGoal`s of ocelots and cats, which Calcite doesn't make yet (CAL-159).
pub const LATER_AVOID_OCELOT: i32 = 8
pub const LATER_AVOID_CAT: i32 = 9
/// A patrolling monster's `LongDistancePatrolGoal`, which walks a patrol, and a raider's raid
/// goals, `ObtainRaidLeaderBannerGoal`, `PathfindToRaidGoal`, `RaiderMoveThroughVillageGoal` and
/// `RaiderCelebration`, used only in a patrol or a raid, which Calcite hasn't yet (CAL-159).
pub const LATER_PATROL: i32 = 11
pub const LATER_RAID: i32 = 12
/// `ClimbOnTopOfPowderSnowGoal`, an endermite's, used only in powder snow, which Calcite doesn't
/// find mobs in yet, and draws nothing till then (D583).
pub const LATER_POWDER_SNOW: i32 = 13
/// A drowned's `DrownedTridentAttackGoal`, used only while it holds a trident and has a target,
/// and throwing tridents, which Calcite doesn't make yet, said to be missing then (CAL-175).
pub const LATER_TRIDENT: i32 = 14
/// A vindicator's `AvoidEntityGoal` of creakings, which Calcite doesn't make yet, so it finds none
/// and draws nothing (CAL-200).
pub const LATER_AVOID_CREAKING: i32 = 15
/// A vindicator's `VindicatorBreakDoorGoal` and a raider's `RaiderOpenDoorGoal`, used only in an
/// active raid, which Calcite hasn't yet: the first asks of its raid before it draws (CAL-200).
pub const LATER_RAID_DOOR: i32 = 16
/// A raider's `HoldGroundAttackGoal`, used only by one patrolling with a target and not yet
/// aggressive, said to be missing then (CAL-200).
pub const LATER_HOLD_GROUND: i32 = 17
/// A vindicator's `VindicatorJohnnyAttackGoal`, used only by one named Johnny, said to be missing
/// then (CAL-200).
pub const LATER_JOHNNY: i32 = 18

/// What a `NearestAttackableTargetGoal` looks for, by kind (CAL-159): players; villagers,
