/// golems; and baby turtles on land, `Turtle.BABY_ON_LAND_SELECTOR`. Calcite has none of the last
/// two yet, so those find nothing, though they draw.
pub const SEEK_PLAYER: i32 = 0
pub const SEEK_VILLAGER: i32 = 1
pub const SEEK_GOLEM: i32 = 2
pub const SEEK_TURTLE: i32 = 3
/// Endermites, which an enderman looks for (D583, CAL-244).
pub const SEEK_ENDERMITE: i32 = 4
/// Axolotls, a drowned's, which Calcite doesn't make yet, so it finds none, though it draws
/// (CAL-175).
pub const SEEK_AXOLOTL: i32 = 5
/// Piglins, `AbstractPiglin`, a wither skeleton's, which Calcite doesn't make yet, so it finds none,
/// though it draws (CAL-200).
pub const SEEK_PIGLIN: i32 = 6

