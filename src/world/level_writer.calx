/// What changes a level's blocks, vanilla's `LevelWriter`, and the flags its `setBlock` takes,
/// `Block.UPDATE_*` (P6.2, D321). The server's level writes its chunks; random ticks are the first
/// to change blocks through it.
module world.level_writer

/// `UPDATE_NEIGHBORS`: the blocks around are told, `updateNeighborsAt`.
pub const UPDATE_NEIGHBORS: i32 = 1
/// `UPDATE_CLIENTS`: the players who have the chunk are sent the change.
pub const UPDATE_CLIENTS: i32 = 2
/// `UPDATE_INVISIBLE`: the client doesn't draw it again.
pub const UPDATE_INVISIBLE: i32 = 4
/// `UPDATE_IMMEDIATE`: the client draws it again at once.
pub const UPDATE_IMMEDIATE: i32 = 8
/// `UPDATE_KNOWN_SHAPE`: the shapes around aren't updated.
pub const UPDATE_KNOWN_SHAPE: i32 = 16
/// `UPDATE_SUPPRESS_DROPS`: what's replaced drops nothing.
pub const UPDATE_SUPPRESS_DROPS: i32 = 32
/// `UPDATE_MOVE_BY_PISTON`: a piston moved it.
pub const UPDATE_MOVE_BY_PISTON: i32 = 64
/// `UPDATE_SKIP_SHAPE_UPDATE_ON_WIRE`: redstone wire's shape isn't updated.
pub const UPDATE_SKIP_SHAPE_UPDATE_ON_WIRE: i32 = 128
/// `UPDATE_SKIP_BLOCK_ENTITY_SIDEEFFECTS`: the block entity taken away does nothing as it goes.
pub const UPDATE_SKIP_BLOCK_ENTITY_SIDEEFFECTS: i32 = 256
/// `UPDATE_SKIP_ON_PLACE`: the block set doesn't run its `onPlace`.
pub const UPDATE_SKIP_ON_PLACE: i32 = 512
/// `UPDATE_ALL`, as `setBlockAndUpdate` sets a block: neighbours told and clients sent it.
pub const UPDATE_ALL: i32 = 3

/// How deep shape updates go from a block set, `Block.UPDATE_LIMIT`.
pub const UPDATE_LIMIT: i32 = 512

/// A level whose blocks can be set.
pub interface LevelWriter {
    /// Sets the block at `x`, `y`, `z` to `state`, as `setBlock(pos, state, flags)` does with
    /// `flags`, and says whether it was set: not outside the world, nor where the chunk isn't
    /// full, nor where the state's already there. The server's level tells the blocks around as
    /// `flags` say (D326).
    fn set_block(mut self, x: i32, y: i32, z: i32, state: u32, flags: i32) -> bool
}
