/// Blocks' outline shapes, `getShape` with an empty context, as `ClipContext.Block.OUTLINE` reads
/// them (CAL-159): each state's from `world.outline_shapes`, laid out as its collision shapes are;
/// a state whose shape moves by its offset, as a flower's, moved by it where it is, and one whose
/// shape doesn't, as a short grass's, not; and a lectern's thirds kept as vanilla has them. A
/// shape that goes by its block entity, as a shulker box's, or by who asks, as scaffolding's for
/// one holding it, is the empty world's.
module world.outline

import world.collision.{Aabb}
import world.collision_shapes.{BOX_FLOOR, BOX_UNIT}
import world.outline_shapes.{exact_boxes, exact_shapes, exact_starts, moved_states, shape_boxes, shape_starts, state_shapes}
import worldgen.facts.{Facts}

/// Every state's outline shape.
pub struct Outlines {
    // Each state's shape; where each shape's boxes start in `boxes`, in boxes; and the boxes, six
    // coordinates each, in `BOX_UNIT`s above `BOX_FLOOR`.
    shapes: List<u16>
    starts: List<u16>
    boxes: List<u8>
    // The shapes whose coordinates aren't 32nds, by where their boxes start in `exact_starts`;
    // where each one's start in `exact`; and their coordinates, six a box.
    exact_at: Map<u32, usize>
    exact_starts: List<u32>
    exact: List<f64>
    // The states whose shape moves by their offset.
    moved: Set<u32>
}

impl Outlines {
    /// Every state's outline shape, from `world.outline_shapes`.
    pub fn new() -> Outlines {
        var exact_at = Map<u32, usize>()
        let shapes = exact_shapes()
        for i in 0..shapes.len() {
            exact_at.insert(shapes[i], i)
        }
        var moved = Set<u32>()
        for s in moved_states() {
            moved.insert(s)
        }
        return Outlines { shapes: state_shapes(), starts: shape_starts(), boxes: shape_boxes(), exact_at: exact_at, exact_starts: exact_starts(), exact: exact_boxes(), moved: moved }
    }

    /// The outline of `state` at x, z, `getShape(level, pos)`: its boxes from its block's least
    /// corner, moved by its offset there where its shape moves by it, `state.getOffset(pos)`.
    pub fn state_boxes(self, f: Facts, state: u32, x: i32, z: i32) -> List<Aabb> {
        var out = List<Aabb>()
        let shape = usize(self.shapes[usize(state)])
        if shape == 0 {
            return out
        }
        let (ox, oy, oz) = if self.moved.contains(state) { f.offset(state, x, z) } else { (0.0, 0.0, 0.0) }
        if self.exact_at.contains(u32.wrap(shape)) {
            let k = self.exact_at[u32.wrap(shape)]
            for i in usize(self.exact_starts[k])..usize(self.exact_starts[k + 1]) {
                let at = i * 6
                out.push(Aabb { min_x: self.exact[at] + ox, min_y: self.exact[at + 1] + oy, min_z: self.exact[at + 2] + oz, max_x: self.exact[at + 3] + ox, max_y: self.exact[at + 4] + oy, max_z: self.exact[at + 5] + oz })
            }
            return out
        }
        for i in usize(self.starts[shape])..usize(self.starts[shape + 1]) {
            let at = i * 6
            out.push(Aabb { min_x: self.coordinate(at) + ox, min_y: self.coordinate(at + 1) + oy, min_z: self.coordinate(at + 2) + oz, max_x: self.coordinate(at + 3) + ox, max_y: self.coordinate(at + 4) + oy, max_z: self.coordinate(at + 5) + oz })
        }
        return out
    }

    // A box's coordinate, in blocks from its block's least corner: a 32nd, so exactly vanilla's.
    fn coordinate(self, at: usize) -> f64 {
        return f64(i32(self.boxes[at]) + BOX_FLOOR) / f64(BOX_UNIT)
    }
}
