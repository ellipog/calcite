/// A leash's knot on a fence, vanilla's `LeashFenceKnotEntity` (CAL-179): 0.375 by 0.5, its eyes
/// 0.0625 up, held to the fence at its place, `BlockAttachedEntity.pos`, its middle across and
/// 0.375 up; its values only `Entity`'s. It isn't saved, `noSave`: a mob tied to it is saved with
/// the fence's place, and ties to a knot made again there as it's loaded.
///
/// Each tick, as `BlockAttachedEntity.tick` runs it, with none of `Entity.baseTick`: below the
/// world it's gone, `checkBelowWorld`; and once every 100 ticks after the first it's gone where
/// its fence isn't, `survives`, its leash's `item.lead.untied` heard from it, `dropItem`. A hit
/// takes it away the same, `hurtServer`. Its level sends it as `ClientboundAddEntityPacket` does
/// with the fence's place, and never moves it.
module world.knot

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, bool_or, int_or, EntitySound}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, knot_data}

/// How often it looks at its fence, `CHECK_INTERVAL`.
pub const CHECK_INTERVAL: i32 = 100

/// A knot.
pub struct LeashKnot {
    pub body: Body
    pub data: EntityData
    /// The fence's place, `pos`, and its ticks since it last looked at it, `ticksSinceLastCheck`.
    pub at: (i32, i32, i32)
    pub since_check: i32 = 0
}

impl LeashKnot {
    /// One made on the fence at `at`, `LeashFenceKnotEntity(level, pos)`: `Entity`'s fields, its
    /// random first, then its UUID, its place the fence's, `recalculateBoundingBox`.
    pub fn made(id: i32, seed: i64, at: (i32, i32, i32)) -> LeashKnot {
        let (x, y, z) = at
        var body = Body.made(id, seed, f64(x) + 0.5, f64(y) + 0.375, f64(z) + 0.5, 0.375f32, 0.5f32, 0.0625f32, 0.0)
        // `setPos`, which has it synced.
        body.needs_sync = true
        return LeashKnot { body: body, data: knot_data(), at: at }
    }

    /// `Entity.load` onto it as it is, as `data` changes an entity's data and `summon` reads one
    /// (CAL-165): what every entity reads and its values from it; then its fence's place the
    /// block its `Pos` is in and its place by that, as `reapplyPosition` sets it, `setPos`. It
    /// reads nothing of its own, as `LeashFenceKnotEntity.readAdditionalSaveData` reads nothing.
    pub fn load_onto(mut self, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> bool {
        if not self.body.load_from(tag, mut lines) {
            return false
        }
        self.data.set(AIR_SUPPLY, Value.Number(self.body.air))
        if self.body.extras.contains("CustomName") {
            self.data.set(CUSTOM_NAME, Value.Name(self.body.extras["CustomName"].copy()))
        }
        self.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        self.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        self.data.set(NO_GRAVITY, Value.Bool(self.body.no_gravity))
        self.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        self.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        self.snap()
        return true
    }

    /// `BlockAttachedEntity.setPos` where it is: its fence's place the block it's in, and its
    /// place by that, `recalculateBoundingBox` (CAL-165).
    pub fn snap(mut self) {
        let (x, y, z) = (i32.saturate(self.body.x.floor()), i32.saturate(self.body.y.floor()), i32.saturate(self.body.z.floor()))
        self.at = (x, y, z)
        self.body.x = f64(x) + 0.5
        self.body.y = f64(y) + 0.375
        self.body.z = f64(z) + 0.5
        self.body.needs_sync = true
    }

    /// Its tick, `BlockAttachedEntity.tick`, at the level's bottom `min_y` (CAL-179): gone below
    /// the world, `true` where it's to look at its fence now, after 100 ticks since it last did.
    pub fn tick(mut self, min_y: i32) -> bool {
        self.body.tick_count += 1
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
            return false
        }
        let was = self.since_check
        self.since_check += 1
        if was >= CHECK_INTERVAL {
            self.since_check = 0
            return true
        }
        return false
    }

    /// What it's saved as, `saveWithoutId` with its type, as `/data` reads it, though no chunk
    /// keeps it, `noSave`: what every entity saves, and nothing of its own, as
    /// `LeashFenceKnotEntity.addAdditionalSaveData` writes nothing (CAL-165).
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:leash_knot")
        return Tag.Compound(t)
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// It's gone, `discard`, and its leash's `item.lead.untied` to be heard from it, as `dropItem`
    /// plays it, `Entity.playSound`, where it isn't silent.
    pub fn untie(mut self) -> EntitySound? {
        self.body.removed = true
        return self.sound("item.lead.untied")
    }

    /// The sound `name` heard from it, `Entity.playSound`, at 1 and 1, where it isn't silent.
    pub fn sound(self, name: str) -> EntitySound? {
        if self.silent() {
            return none
        }
        return some(EntitySound { sound: String(name), x: self.body.x, y: self.body.y, z: self.body.z, volume: 1.0f32, pitch: 1.0f32, source: self.body.sound_source })
    }
}
