/// Pointed dripstone and sulfur spikes, vanilla's `SpeleothemBlock` and `PointedDripstoneBlock`,
/// and the cauldrons their drips fill (CAL-380). Their shapes as their neighbours change are
/// `worldgen.shapes`'.
///
/// Scheduled, as `SpeleothemBlock.tick` has it, a stalagmite that can't stay is broken, and a
/// stalactite falls from there down to its tip, each block a falling block, the tip hurting what
/// it lands on. At random, `randomTick`, pointed dripstone may first drip what's above the block
/// it hangs from, `maybeTransferFluid`, turning mud above to clay or a cauldron below to fill as
/// its tick comes; then a stalactite under the block it grows on, with water above that for
/// dripstone, may grow at its tip, down or as a stalagmite below.
module world.speleothem

import random.source.{RandomSource}
import world.collision_shapes.{BOX_FLOOR, BOX_UNIT}
import world.movement_shapes.{shape_boxes, shape_starts, state_shapes}
import world.block_level.{BlockLevel, destroy_block}
import world.level_writer.{UPDATE_LIMIT}
import worldgen.access.{BlockAccess}
import worldgen.facts.{EMPTY_FLUID, Facts, LAVA_FLUID, UP, WATER_FLUID}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env, can_survive, sturdy_at}

/// Whether `state` is a speleothem whose tip points down, `down`, or up:
/// `isSpeleothemWithDirection`.
pub fn tip_toward(f: Facts, state: u32, down: bool) -> bool {
    if not f.in_set(state, f.tag("minecraft:speleothems")) {
        return false
    }
    let want = if down { "down" } else { "up" }
    return (f.get_name(state, String("vertical_direction")) ?? String()) == String(want)
}

// `isTip`: a speleothem's tip, or, with `merged`, one merged with the tip it meets.
fn is_tip(f: Facts, state: u32, merged: bool) -> bool {
    if not f.in_set(state, f.tag("minecraft:speleothems")) {
        return false
    }
    let thickness = f.get_name(state, String("thickness")) ?? String()
    return thickness == "tip" or (merged and thickness == "tip_merge")
}

// `isFreeHangingStalactite`: a stalactite's tip, unmerged and dry.
fn free_hanging(f: Facts, state: u32) -> bool {
    return tip_toward(f, state, true) and (f.get_name(state, String("thickness")) ?? String()) == "tip" and not f.get_bool(state, String("waterlogged"))
}

// `isUnmergedTipWithDirection`: the tip of the same block as `block`, pointing down where `down`.
fn unmerged_tip(f: Facts, state: u32, block: u32, down: bool) -> bool {
    return is_tip(f, state, false) and tip_toward(f, state, down) and f.block(state) == block
}

/// `SpeleothemBlock.tick` of `state` at x, y, z: a stalagmite that can't stay broken, dropping
/// what it drops; else, as `spawnFallingStalactite` has it, each stalactite from here down a
/// falling block, the tip, merged or not, the last, hurting what it lands on by its length from
/// here, at least 6, a block fallen, at most 40.
pub fn speleothem_tick<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    if tip_toward(f, state, false) and not try can_survive(e, level, state, x, y, z) {
        _ = try destroy_block(e, mut level, x, y, z, true, none, UPDATE_LIMIT)
        return
    }
    var fy = y
    var at = state
    while tip_toward(f, at, true) {
        let tip = is_tip(f, at, true)
        var hurts: (f32, i32)? = none
        if tip {
            let size = if 1 + y - fy > 6 { 1 + y - fy } else { 6 }
            hurts = some((f32.nearest(size), 40))
        }
        fall_from(f, mut level, at, x, fy, z, hurts)
        if tip {
            return
        }
        fy -= 1
        at = try level.state(f, x, fy, z)
    }
}

/// `FallingBlockEntity.fall` of `state` at x, y, z: the block set to what its fluid leaves,
/// `createLegacyBlock`, with flags 3, and the falling block, not waterlogged, hurting as `hurts`
/// says, added.
pub fn fall_from<L: BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, hurts: (f32, i32)?) {
    let falls = f.try_bool(state, String("waterlogged"), false)
    let left = if f.is_water(state) { f.default_state(f.ids.water) } else { f.default_state(f.ids.air) }
    _ = level.set_block_limited(x, y, z, left, 3, UPDATE_LIMIT)
    level.fall_block(x, y, z, falls, hurts)
}

/// `randomTick` of the speleothem `state` at x, y, z, pointed dripstone's where `dripstone`: its
/// drip first, `maybeTransferFluid`, with a draw; then a draw under 0.011377778 and, where it's a
/// stalactite's first block, its growth, `growStalactiteOrStalagmiteIfPossible`.
pub fn speleothem_random<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, dripstone: bool) ! Thrown {
    let Env { facts: f, .. } = e
    if dripstone {
        let value = level.next_float()
        try transfer_fluid(f, mut level, state, x, y, z, value)
    }
    if level.next_float() < 0.011377778f32 and try start_of_stalactite(f, level, state, x, y, z) {
        try grow(e, mut level, state, x, y, z, dripstone)
    }
}

// `isStalactiteStartPos`: a stalactite not hanging from another of its block.
fn start_of_stalactite<L: BlockAccess>(f: Facts, level: L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    return tip_toward(f, state, true) and f.block(try level.state(f, x, y + 1, z)) != f.block(state)
}

// `findTip` from the speleothem `state` at y: the y of its tip, or, with `merged`, its merged
// tip, along its own block pointing its way, within `most`, `findBlockVertical`.
fn find_tip<L: BlockAccess>(f: Facts, level: L, state: u32, x: i32, y: i32, z: i32, most: i32, merged: bool) -> i32? ! Thrown {
    if is_tip(f, state, merged) {
        return some(y)
    }
    let down = tip_toward(f, state, true)
    let step = if down { -1 } else { 1 }
    let block = f.block(state)
    var at = y
    for _ in 1..most {
        at += step
        let s = try level.state(f, x, at, z)
        if is_tip(f, s, merged) {
            return some(at)
        }
        if f.block(s) != block or not tip_toward(f, s, down) {
            return none
        }
    }
    return none
}

// `getFluidAboveStalactite`: for a stalactite, the fluid above the block it hangs from, past
// its own blocks within 11, `findRootBlock`; mud's water where water doesn't evaporate there.
// With it, that block's y and state.
fn fluid_above<L: BlockAccess + BlockLevel>(f: Facts, level: L, state: u32, x: i32, y: i32, z: i32) -> (u32, i32, u32)? ! Thrown {
    if not tip_toward(f, state, true) {
        return none
    }
    let block = f.block(state)
    var at = y
    for _ in 1..11 {
        at += 1
        let s = try level.state(f, x, at, z)
        if f.block(s) != block {
            let above = try level.state(f, x, at + 1, z)
            var fluid = f.fluid(above)
            if is_block(f, above, "minecraft:mud") and not level.water_evaporates() {
                fluid = WATER_FLUID
            }
            return some((fluid, at + 1, above))
        }
        if not tip_toward(f, s, true) {
            return none
        }
    }
    return none
}

// `canDripThrough` of `state` at x, z: air; not what's solid to render or holds fluid; else a
// collision shape that leaves the middle column 4 by 4 pixels free.
fn drip_through<L: BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, z: i32) -> bool {
    if f.is_air(state) {
        return true
    }
    if f.solid_render(state) or f.fluid(state) != EMPTY_FLUID {
        return false
    }
    if f.collision_empty(state) {
        return true
    }
    if f.collision_full_block(state) {
        return false
    }
    return not level.drip_blocked(f, state, x, z)
}

/// Each state's collision shape with an empty context, before an offset, as entities move
/// against it, for whether a drip passes it.
pub struct DripShapes {
    shapes: List<u16>
    starts: List<u16>
    boxes: List<u8>
}

impl DripShapes {
    pub fn new() -> DripShapes {
        return DripShapes { shapes: state_shapes(), starts: shape_starts(), boxes: shape_boxes() }
    }

    /// Whether the collision shape of `state` at x, z, offset as its position has it, overlaps
    /// `REQUIRED_SPACE_TO_DRIP_THROUGH_NON_SOLID_BLOCK`, the column from 6 to 10 pixels across
    /// the middle, `Shapes.joinIsNotEmpty` with `AND`.
    pub fn blocks(self, f: Facts, state: u32, x: i32, z: i32) -> bool {
        let shape = usize(self.shapes[usize(state)])
        let (ox, _, oz) = f.offset(state, x, z)
        for i in usize(self.starts[shape])..usize(self.starts[shape + 1]) {
            let at = i * 6
            let min_x = self.coordinate(at) + ox
            let min_y = self.coordinate(at + 1)
            let min_z = self.coordinate(at + 2) + oz
            let max_x = self.coordinate(at + 3) + ox
            let max_y = self.coordinate(at + 4)
            let max_z = self.coordinate(at + 5) + oz
            if min_x < 0.625 and max_x > 0.375 and min_z < 0.625 and max_z > 0.375 and min_y < 1.0 and max_y > 0.0 {
                return true
            }
        }
        return false
    }

    fn coordinate(self, at: usize) -> f64 {
        return f64(i32(self.boxes[at]) + BOX_FLOOR) / f64(BOX_UNIT)
    }
}

// `canReceiveStalactiteDrip` of the block `state` for `fluid`: an empty cauldron any, a water
// cauldron water, the others none.
fn receives(f: Facts, state: u32, fluid: u32) -> bool {
    if is_block(f, state, "minecraft:cauldron") {
        return true
    }
    return is_block(f, state, "minecraft:water_cauldron") and fluid == WATER_FLUID
}

// Whether `state` is of the block `name`.
fn is_block(f: Facts, state: u32, name: str) -> bool {
    return f.block_named(String(name)) == some(f.block(state))
}

// `maybeTransferFluid` of `state` at x, y, z with the draw `value`: where it's under the chance
// of water's, 0.17578125, or lava's, 0.05859375, by the fluid above the block a stalactite
// hangs from, at its first block, the tip within 11 drips: mud above turns to clay with flags 3,
// else it schedules the first cauldron within 11 below that takes it, through what a drip passes,
// to fill 50 ticks on and a tick for each block between; either with level event 1504 at the tip.
fn transfer_fluid<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, value: f32) ! Thrown {
    if value > 0.17578125f32 and value > 0.05859375f32 {
        return
    }
    if not try start_of_stalactite(f, level, state, x, y, z) {
        return
    }
    let (fluid, above_y, above) = try fluid_above(f, level, state, x, y, z) else return
    let chance = if fluid == WATER_FLUID { 0.17578125f32 } else if fluid == LAVA_FLUID { 0.05859375f32 } else { return }
    if value >= chance {
        return
    }
    let tip = try find_tip(f, level, state, x, y, z, 11, false) else return
    if is_block(f, above, "minecraft:mud") and fluid == WATER_FLUID {
        let clay = f.block_named(String("minecraft:clay")) else return
        _ = level.set_block_limited(x, above_y, z, f.default_state(clay), 3, UPDATE_LIMIT)
        level.level_event(1504, x, tip, z, 0)
        return
    }
    var at = tip
    for _ in 1..11 {
        at -= 1
        let s = try level.state(f, x, at, z)
        if f.is_a(f.block(s), String("AbstractCauldronBlock")) and receives(f, s, fluid) {
            level.level_event(1504, x, tip, z, 0)
            level.schedule_block(f.block(s), x, at, z, 50 + tip - at, 0)
            return
        }
        if not drip_through(f, mut level, s, x, z) {
            return
        }
    }
}

/// `AbstractCauldronBlock.tick` of the cauldron `state` at x, y, z: the free-hanging stalactite
/// tip within 11 above, through what a drip passes, `findStalactiteTipAboveCauldron`, and the
/// water or lava above the block it hangs from, which the cauldron takes where it can,
/// `receiveStalactiteDrip`: an empty one becomes a water cauldron, level event 1047, or a lava
/// one, 1046; a water cauldron not full a level more, 1047; each with flags 3.
pub fn cauldron_drip<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    var at = y
    var tip: i32? = none
    for _ in 1..11 {
        at += 1
        let s = try level.state(f, x, at, z)
        if free_hanging(f, s) {
            tip = some(at)
            break
        }
        if not drip_through(f, mut level, s, x, z) {
            return
        }
    }
    let t = tip else return
    let hanging = try level.state(f, x, t, z)
    let (fluid, _, _) = try fluid_above(f, level, hanging, x, t, z) else return
    if (fluid != WATER_FLUID and fluid != LAVA_FLUID) or not receives(f, state, fluid) {
        return
    }
    if is_block(f, state, "minecraft:cauldron") {
        let made = if fluid == WATER_FLUID { "minecraft:water_cauldron" } else { "minecraft:lava_cauldron" }
        let b = f.block_named(String(made)) else return
        _ = level.set_block_limited(x, y, z, f.default_state(b), 3, UPDATE_LIMIT)
        level.level_event(if fluid == WATER_FLUID { 1047 } else { 1046 }, x, y, z, 0)
        return
    }
    let filled = f.get_int(state, String("level")) ?? 3
    if filled < 3 {
        _ = level.set_block_limited(x, y, z, try f.with_int(state, String("level"), filled + 1), 3, UPDATE_LIMIT)
        level.level_event(1047, x, y, z, 0)
    }
}

// `growStalactiteOrStalagmiteIfPossible` of the stalactite `state` whose first block is at x, y,
// z: under the block it grows on, dripstone's with water's source two above, `canGrow`, its tip
// within its length, 7 for dripstone and 2 for a sulfur spike, hanging free with room to grow,
// `canTipGrow`, grows down or, half the time, as a stalagmite below, `growStalagmiteBelow`.
fn grow<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, state: u32, x: i32, y: i32, z: i32, dripstone: bool) ! Thrown {
    let Env { facts: f, .. } = e
    let on = if dripstone { "minecraft:dripstone_block" } else { "minecraft:sulfur" }
    let base = f.block_named(String(on)) else return
    if f.block(try level.state(f, x, y + 1, z)) != base {
        return
    }
    if dripstone and f.fluid(try level.state(f, x, y + 2, z)) != WATER_FLUID {
        return
    }
    let block = f.block(state)
    let tip_y = try find_tip(f, level, state, x, y, z, if dripstone { 7 } else { 2 }, false) else return
    let tip = try level.state(f, x, tip_y, z)
    if not free_hanging(f, tip) or not try tip_grows(f, level, tip, block, x, tip_y, z) {
        return
    }
    if level.next_boolean() {
        try grow_to(f, mut level, block, x, tip_y, z, true)
    } else {
        try grow_below(e, mut level, block, x, tip_y, z, dripstone)
    }
}

// `canTipGrow` of the tip `tip` at x, y, z: what's past it holds no fluid, and is air or the
// unmerged tip of its block pointing back.
fn tip_grows<L: BlockAccess>(f: Facts, level: L, tip: u32, block: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let down = tip_toward(f, tip, true)
    let past = try level.state(f, x, y + if down { -1 } else { 1 }, z)
    if f.fluid(past) != EMPTY_FLUID {
        return false
    }
    return f.is_air(past) or unmerged_tip(f, past, block, not down)
}

// `grow` from y, down where `down`: where the block there is the unmerged tip of `block` pointing
// back, both tips merged, `createMergedTips`; where it's air or water, a tip.
fn grow_to<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, block: u32, x: i32, y: i32, z: i32, down: bool) ! Thrown {
    let to = y + if down { -1 } else { 1 }
    let there = try level.state(f, x, to, z)
    if unmerged_tip(f, there, block, not down) {
        let (stalactite, stalagmite) = if tip_toward(f, there, false) { (to + 1, to) } else { (to, to - 1) }
        try make(f, mut level, block, x, stalactite, z, true, "tip_merge")
        try make(f, mut level, block, x, stalagmite, z, false, "tip_merge")
    } else if f.is_air(there) or f.block(there) == f.ids.water {
        try make(f, mut level, block, x, to, z, down, "tip")
    }
}

// `createSpeleothem`: `block` at x, y, z pointing down where `down`, so thick, waterlogged where
// water's source is there, set with flags 3.
fn make<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, block: u32, x: i32, y: i32, z: i32, down: bool, thickness: str) ! Thrown {
    let wet = f.fluid(try level.state(f, x, y, z)) == WATER_FLUID
    var s = try f.with_name(f.default_state(block), String("vertical_direction"), String(if down { "down" } else { "up" }))
    s = try f.with_name(s, String("thickness"), String(thickness))
    s = try f.with_bool(s, String("waterlogged"), wet)
    _ = level.set_block_limited(x, y, z, s, 3, UPDATE_LIMIT)
}

// `growStalagmiteBelow` the tip at y: within 10 down, stopping at fluid, a stalagmite's unmerged
// tip with room grows; a block a stalagmite can stand on, `isValidSpeleothemPlacement`, without
// water below, grows one there; and what a drip can't pass, for dripstone, stops it.
fn grow_below<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, block: u32, x: i32, y: i32, z: i32, dripstone: bool) ! Thrown {
    let Env { facts: f, .. } = e
    var at = y
    for _ in 0..10 {
        at -= 1
        let s = try level.state(f, x, at, z)
        if f.fluid(s) != EMPTY_FLUID {
            return
        }
        if unmerged_tip(f, s, block, false) and try tip_grows(f, level, s, block, x, at, z) {
            try grow_to(f, mut level, block, x, at, z, false)
            return
        }
        let under = try level.state(f, x, at - 1, z)
        let stands = try sturdy_at(e, level, x, at - 1, z, UP) or (tip_toward(f, under, false) and f.block(under) == block)
        if stands and not f.is_water(under) {
            try grow_to(f, mut level, block, x, at - 1, z, false)
            return
        }
        if dripstone and not drip_through(f, mut level, s, x, z) {
            return
        }
    }
}
