/// An entity's synced data, as vanilla's `SynchedEntityData` keeps it (CAL-141): each value by its
/// ID, the order its classes define them in, with its serializer's ID, its place in
/// `EntityDataSerializers`' list, and whether it's changed since it was last sent. A value set to
/// what it is stays as it was. `pack_dirty` writes the changed ones as
/// `ClientboundSetEntityDataPacket` does, in ID order, each its ID, its serializer and its value,
/// then 255, and marks them sent, as `packDirty` does.
///
/// A player's values are made by `player_data`: `Entity`'s, `LivingEntity`'s, `Avatar`'s and
/// `Player`'s, with their defaults. The kinds Calcite sets have values; the rest, the sleeping
/// position and the parrots, keep their empty defaults and are never sent. A living entity's
/// effect particles are a list of particles, each its type's ID and, for `entity_effect`, its
/// colour (CAL-163).
/// A living entity's custom name is its saved one, a text component as a tag (D441). An armor
/// stand's are made by `armor_stand_data` (CAL-155): `Entity`'s, `LivingEntity`'s and
/// `ArmorStand`'s, its flags and its six poses, each a rotation. A
/// mooshroom's by `mooshroom_data` (CAL-156): `Mob`'s flags, `AgeableMob`'s baby and age lock, and
/// its type. A cow's, pig's, chicken's and sheep's by `cow_data` and its kin: a cow's and
/// chicken's variant and sound variant, a pig's boost time before them, and a sheep's wool; a
/// horse's and a donkey's by `horse_data` and `donkey_data`. An arrow's by `arrow_data` (CAL-159):
/// `Entity`'s, then its flags, pierce level, whether it's in the ground and its colour.
/// `pack_non_default` writes those that aren't their default as the packet does, as
/// `getNonDefaultValues` gives them to an entity's pairing.
module world.entity_data

import nbt.tag.{Tag}
import protocol.wire.{Writer}

/// The serializers' IDs, in `EntityDataSerializers`' list.
pub const BYTE: i32 = 0
pub const INT: i32 = 1
pub const FLOAT: i32 = 3
pub const OPTIONAL_COMPONENT: i32 = 6
pub const BOOLEAN: i32 = 8
pub const ROTATIONS: i32 = 9
pub const OPTIONAL_BLOCK_POS: i32 = 11
pub const OPTIONAL_BLOCK_STATE: i32 = 15
pub const PARTICLES: i32 = 17
pub const VILLAGER_DATA: i32 = 18
pub const OPTIONAL_UNSIGNED_INT: i32 = 19
pub const POSE: i32 = 20
pub const HUMANOID_ARM: i32 = 42
/// The farm animals' variants' and sound variants' serializers, each a registry ID (CAL-156).
pub const COW_VARIANT: i32 = 23
pub const COW_SOUND_VARIANT: i32 = 24
pub const PIG_VARIANT: i32 = 28
pub const PIG_SOUND_VARIANT: i32 = 29
pub const CHICKEN_VARIANT: i32 = 30
pub const CHICKEN_SOUND_VARIANT: i32 = 31
/// An armadillo's state's serializer, `ARMADILLO_STATE`, its state's ID (CAL-160).
pub const ARMADILLO_STATE: i32 = 36

/// A player's values' IDs.
pub const SHARED_FLAGS: usize = 0
pub const AIR_SUPPLY: usize = 1
pub const CUSTOM_NAME: usize = 2
pub const CUSTOM_NAME_VISIBLE: usize = 3
pub const SILENT: usize = 4
pub const NO_GRAVITY: usize = 5
pub const POSE_ID: usize = 6
pub const TICKS_FROZEN: usize = 7
pub const LIVING_FLAGS: usize = 8
pub const HEALTH: usize = 9
pub const EFFECT_PARTICLES: usize = 10
pub const EFFECT_AMBIENCE: usize = 11
pub const ARROW_COUNT: usize = 12
pub const STINGER_COUNT: usize = 13
pub const SLEEPING_POS: usize = 14
pub const MAIN_HAND: usize = 15
pub const MODE_CUSTOMISATION: usize = 16
pub const ABSORPTION: usize = 17
pub const SCORE: usize = 18
pub const PARROT_LEFT: usize = 19
pub const PARROT_RIGHT: usize = 20

/// An armor stand's own values' IDs, after `LivingEntity`'s: its flags, `DATA_CLIENT_FLAGS`, and
/// its head's, body's, arms' and legs' poses.
pub const STAND_FLAGS: usize = 15
pub const HEAD_POSE: usize = 16
pub const BODY_POSE: usize = 17
pub const LEFT_ARM_POSE: usize = 18
pub const RIGHT_ARM_POSE: usize = 19
pub const LEFT_LEG_POSE: usize = 20
pub const RIGHT_LEG_POSE: usize = 21

/// An arrow's own values' IDs, after `Entity`'s (CAL-159): its flags, `ID_FLAGS`, crit and without
/// physics; its pierce level, `PIERCE_LEVEL`; whether it's in the ground, `IN_GROUND`; and its
/// potion's colour, `Arrow.ID_EFFECT_COLOR`, -1 for none.
pub const ARROW_FLAGS: usize = 8
pub const PIERCE_LEVEL: usize = 9
pub const IN_GROUND: usize = 10
pub const EFFECT_COLOR: usize = 11

/// An arrow's flags' bits: crit and without physics.
pub const CRIT_FLAG: i32 = 1
pub const NO_PHYSICS_FLAG: i32 = 2

/// A mob's own values' IDs, after `LivingEntity`'s (CAL-156): its flags, `DATA_MOB_FLAGS_ID`; an
/// ageable mob's, whether it's a baby, `DATA_BABY_ID`, and its age locked, `AGE_LOCKED`; and a
/// mooshroom's type, `DATA_TYPE`, red 0 or brown 1.
pub const MOB_FLAGS: usize = 15
pub const BABY: usize = 16
pub const AGE_LOCKED: usize = 17
pub const MOOSHROOM_TYPE: usize = 18

/// A mob's flags' bits: without AI, left-handed and aggressive.
pub const NO_AI_FLAG: i32 = 1
pub const LEFT_HANDED_FLAG: i32 = 2
pub const AGGRESSIVE_FLAG: i32 = 4

/// An armor stand's flags' bits, `CLIENT_FLAG_*`: small, with arms, without its base plate and a
/// marker.
pub const SMALL_FLAG: i32 = 1
pub const ARMS_FLAG: i32 = 4
pub const NO_BASE_PLATE_FLAG: i32 = 8
pub const MARKER_FLAG: i32 = 16

/// The shared flags' bits, `Entity`'s `FLAG_*`: on fire, crouching, sprinting, swimming,
/// invisible, glowing and fall flying.
pub const ON_FIRE_FLAG: i32 = 1
pub const CROUCHING_FLAG: i32 = 2
pub const SPRINTING_FLAG: i32 = 8
pub const SWIMMING_FLAG: i32 = 16
pub const INVISIBLE_FLAG: i32 = 32
pub const GLOWING_FLAG: i32 = 64
pub const FALL_FLYING_FLAG: i32 = 128

/// `Pose`'s IDs that a player takes.
pub const STANDING: i32 = 0
pub const FALL_FLYING: i32 = 1
pub const SLEEPING: i32 = 2
pub const SWIMMING: i32 = 3
pub const SPIN_ATTACK: i32 = 4
pub const CROUCHING: i32 = 5
pub const DYING: i32 = 7

/// A value: a byte, a whole number, which an int, a pose or an arm is, a float, a boolean, a
/// rotation, `Rotations`, its three angles, a villager's data, `VillagerData`, its type's and
/// profession's IDs in their registries and its level (CAL-156), or an empty optional or list,
/// which Calcite never sets.
pub enum Value {
    Byte(i8)
    Number(i32)
    Float(f32)
    Bool(bool)
    Rotations(f32, f32, f32)
    Villager(i32, i32, i32)
    /// A text component, as the custom name's optional holds it, its tag as
    /// `ComponentSerialization` writes it (D441).
    Name(Tag)
    /// A block's place in an optional, there, as a sleeping entity's bed is held (CAL-160).
    Pos(i32, i32, i32)
    /// A list of particles, each its type's ID in the `particle_type` registry and its colour
    /// where it's `entity_effect`, a `ColorParticleOption`, as a living entity's effects show
    /// (CAL-163).
    Particles(List<(i32, i32?)>)
    Empty
}

// One value: its serializer, what it is, what it was defined as, `initialValue`, and whether it's
// changed since it was sent.
struct Item {
    serializer: i32
    value: Value
    initial: Value
    dirty: bool = false
}

/// An entity's values, by ID, and whether any changed since they were last sent, `isDirty`.
pub struct EntityData {
    items: List<Item> = List<Item>()
    dirty: bool = false
}

impl EntityData {
    /// `define`: the next value, its ID the count before it, as it starts, not changed.
    pub fn define(mut self, serializer: i32, value: own Value) {
        self.items.push(Item { serializer: serializer, value: value.copy(), initial: value })
    }

    /// The value `id` defined again as `value`, what it was defined as too and not changed, as a
    /// type whose value is drawn as it's defined defines it, a zombie villager its villager data.
    pub fn redefine(mut self, id: usize, value: own Value) {
        self.items[id].value = value.copy()
        self.items[id].initial = value
    }

    /// `set`: the value `id` made `value`, changed if that's not what it was.
    pub fn set(mut self, id: usize, value: own Value) {
        if same(self.items[id].value, value) {
            return
        }
        self.items[id].value = value
        self.items[id].dirty = true
        self.dirty = true
    }

    /// `setSharedFlag`: the byte `id` with the bits `flag` set if `on`, or cleared.
    pub fn set_flag(mut self, id: usize, flag: i32, on: bool) {
        let b = i32(self.byte(id))
        let now = if on { b | flag } else { b & ~flag }
        self.set(id, Value.Byte(i8.wrap(now)))
    }

    /// The value `id` as a byte, a number or a float, 0 for a value of another kind.
    pub fn byte(self, id: usize) -> i8 {
        return match self.items[id].value {
            Value.Byte(b) => b,
            _ => 0i8,
        }
    }

    pub fn number(self, id: usize) -> i32 {
        return match self.items[id].value {
            Value.Number(n) => n,
            _ => 0,
        }
    }

    pub fn float(self, id: usize) -> f32 {
        return match self.items[id].value {
            Value.Float(v) => v,
            _ => 0.0f32,
        }
    }

    /// The value `id` as a bool, false for a value of another kind.
    pub fn flag(self, id: usize) -> bool {
        return match self.items[id].value {
            Value.Bool(b) => b,
            _ => false,
        }
    }

    /// The value `id` as a rotation's three angles, none turned for a value of another kind.
    pub fn rotations(self, id: usize) -> (f32, f32, f32) {
        return match self.items[id].value {
            Value.Rotations(x, y, z) => (x, y, z),
            _ => (0.0f32, 0.0f32, 0.0f32),
        }
    }

    /// The value `id` as a villager's data, its type, profession and level, a plains villager of
    /// none at level 1 for a value of another kind.
    pub fn villager(self, id: usize) -> (i32, i32, i32) {
        return match self.items[id].value {
            Value.Villager(t, p, l) => (t, p, l),
            _ => (2, 0, 1),
        }
    }

    /// Whether the value `id` is what it was defined as, `isSetToDefault`.
    pub fn is_default(self, id: usize) -> bool {
        return same(self.items[id].value, self.items[id].initial)
    }

    /// `isDirty`: whether a value changed since they were last sent.
    pub fn is_dirty(self) -> bool {
        return self.dirty
    }

    /// `packDirty`: the values changed since they were last sent, as the packet writes them, and
    /// marked sent; none where nothing changed.
    pub fn pack_dirty(mut self) -> List<u8>? {
        if not self.dirty {
            return none
        }
        var w = Writer.new()
        for id in 0..self.items.len() {
            if self.items[id].dirty {
                self.items[id].dirty = false
                w.u8(u8.wrap(id))
                w.varint(self.items[id].serializer)
                write_value(mut w, self.items[id].value)
            }
        }
        w.u8(255u8)
        self.dirty = false
        return some(w.into_bytes())
    }

    /// `getNonDefaultValues`: the values that aren't what they were defined as, as the packet
    /// writes them, in ID order, which an entity's pairing sends; none where they all are. They
    /// stay as changed as they were.
    pub fn pack_non_default(self) -> List<u8>? {
        var w = Writer.new()
        var any = false
        for id in 0..self.items.len() {
            if not same(self.items[id].value, self.items[id].initial) {
                any = true
                w.u8(u8.wrap(id))
                w.varint(self.items[id].serializer)
                write_value(mut w, self.items[id].value)
            }
        }
        if not any {
            return none
        }
        w.u8(255u8)
        return some(w.into_bytes())
    }
}

// Whether two values are the same, as `ObjectUtils.notEqual` finds them, a float by its bits.
fn same(a: Value, b: Value) -> bool {
    return match a {
        Value.Byte(x) => match b {
            Value.Byte(y) => x == y,
            _ => false,
        },
        Value.Number(x) => match b {
            Value.Number(y) => x == y,
            _ => false,
        },
        Value.Float(x) => match b {
            Value.Float(y) => x.to_bits() == y.to_bits(),
            _ => false,
        },
        Value.Bool(x) => match b {
            Value.Bool(y) => x == y,
            _ => false,
        },
        // A record's floats, as `Float.compare` finds them.
        Value.Rotations(x, y, z) => match b {
            Value.Rotations(u, v, w) => x.to_bits() == u.to_bits() and y.to_bits() == v.to_bits() and z.to_bits() == w.to_bits(),
            _ => false,
        },
        Value.Villager(t, p, l) => match b {
            Value.Villager(u, q, m) => t == u and p == q and l == m,
            _ => false,
        },
        Value.Name(x) => match b {
            Value.Name(y) => x == y,
            _ => false,
        },
        Value.Pos(x, y, z) => match b {
            Value.Pos(u, v, w) => x == u and y == v and z == w,
            _ => false,
        },
        // Lists of particles, each as its `equals` finds it: a coloured one, made anew each time,
        // is never another, as `ColorParticleOption` keeps `Object.equals`; a plain one is its
        // type, one of each (CAL-163). An empty list is the empty one it starts as, `List.of()`
        // (D514).
        Value.Particles(x) => match b {
            Value.Particles(y) => same_particles(x, y),
            Value.Empty => x.is_empty(),
            _ => false,
        },
        Value.Empty => match b {
            Value.Empty => true,
            Value.Particles(y) => y.is_empty(),
            _ => false,
        },
    }
}

// A value as its serializer writes it: a byte; an int, a pose or an arm as a varint; a float; a
// boolean; a rotation's three floats; a villager's data as its type's and profession's IDs and its
// level, each a varint; a text component in an optional, there, then its tag in network form, as
// `ComponentSerialization.TRUSTED_OPTIONAL_STREAM_CODEC` writes it (D441); a block's place in an
// optional, there, then `BlockPos.asLong` (CAL-160); a list of particles as its length, then each
// particle's type's ID and a coloured one's colour, an int (CAL-163); and an empty optional or list
// as one 0, the optional's absence or the list's length.
fn write_value(w: mut Writer, v: Value) {
    match v {
        Value.Byte(b) => w.i8(b),
        Value.Number(n) => w.varint(n),
        Value.Float(f) => w.f32(f),
        Value.Bool(b) => w.bool(b),
        Value.Rotations(x, y, z) => {
            w.f32(x)
            w.f32(y)
            w.f32(z)
        },
        Value.Villager(t, p, l) => {
            w.varint(t)
            w.varint(p)
            w.varint(l)
        },
        Value.Name(t) => {
            w.bool(true)
            w.nbt(t)
        },
        Value.Pos(x, y, z) => {
            w.bool(true)
            w.i64(((i64(x) & 67108863i64) << 38) | ((i64(z) & 67108863i64) << 12) | (i64(y) & 4095i64))
        },
        Value.Particles(ps) => {
            w.varint(i32.wrap(ps.len()))
            for p in ps {
                let (kind, color) = p
                w.varint(kind)
                if let c = color {
                    w.i32(c)
                }
            }
        },
        Value.Empty => w.varint(0),
    }
}

// Whether two lists of particles are equal as `List.equals` finds them: as long, and each a plain
// particle of the same type, a coloured one never equal to another.
fn same_particles(a: List<(i32, i32?)>, b: List<(i32, i32?)>) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        let (ka, ca) = a[i]
        let (kb, cb) = b[i]
        if ka != kb or ca != none or cb != none {
            return false
        }
    }
    return true
}

// `Entity`'s values, 0 to 7: not on fire, 300 air, no name, not silent, with gravity, standing,
// not frozen.
fn define_entity(d: mut EntityData) {
    d.define(BYTE, Value.Byte(0i8))
    d.define(INT, Value.Number(300))
    d.define(OPTIONAL_COMPONENT, Value.Empty)
    d.define(BOOLEAN, Value.Bool(false))
    d.define(BOOLEAN, Value.Bool(false))
    d.define(BOOLEAN, Value.Bool(false))
    d.define(POSE, Value.Number(STANDING))
    d.define(INT, Value.Number(0))
}

// `Entity`'s and `LivingEntity`'s values, 0 to 14: `Entity`'s, then no living flags, 1 health
// until it's set, no effects, arrows or stingers, and not sleeping.
fn define_living(d: mut EntityData) {
    define_entity(mut d)
    d.define(BYTE, Value.Byte(0i8))
    d.define(FLOAT, Value.Float(1.0f32))
    d.define(PARTICLES, Value.Empty)
    d.define(BOOLEAN, Value.Bool(false))
    d.define(INT, Value.Number(0))
    d.define(INT, Value.Number(0))
    d.define(OPTIONAL_BLOCK_POS, Value.Empty)
}

/// A player's values as `Player`'s constructor defines them: not on fire or crouching, 300 air, no
/// name, standing, 1 health until it's set, the right hand their main, no skin parts shown until
/// their client says, no absorption, no score and no parrots.
pub fn player_data() -> EntityData {
    var d = EntityData()
    define_living(mut d)
    d.define(HUMANOID_ARM, Value.Number(1))
    d.define(BYTE, Value.Byte(0i8))
    d.define(FLOAT, Value.Float(0.0f32))
    d.define(INT, Value.Number(0))
    d.define(OPTIONAL_UNSIGNED_INT, Value.Empty)
    d.define(OPTIONAL_UNSIGNED_INT, Value.Empty)
    return d
}

/// A mooshroom's values as `MushroomCow`'s constructor defines them: `Entity`'s and
/// `LivingEntity`'s, then `Mob`'s flags, none; `AgeableMob`'s, not a baby and its age not locked;
/// and its type, `Variant.DEFAULT`, red.
pub fn mooshroom_data() -> EntityData {
    var d = EntityData()
    define_living(mut d)
    d.define(BYTE, Value.Byte(0i8))
    d.define(BOOLEAN, Value.Bool(false))
    d.define(BOOLEAN, Value.Bool(false))
    d.define(INT, Value.Number(0))
    return d
}

/// A cow's values as `Cow`'s constructor defines them, after an ageable mob's: its variant and
/// sound variant, `variant` and `sound` by their IDs, the defaults.
pub fn cow_data(variant: i32, sound: i32) -> EntityData {
    var d = ageable_data()
    d.define(COW_VARIANT, Value.Number(variant))
    d.define(COW_SOUND_VARIANT, Value.Number(sound))
    return d
}

/// A pig's: its boost time, none, then its variant and sound variant.
pub fn pig_data(variant: i32, sound: i32) -> EntityData {
    var d = ageable_data()
    d.define(INT, Value.Number(0))
    d.define(PIG_VARIANT, Value.Number(variant))
    d.define(PIG_SOUND_VARIANT, Value.Number(sound))
    return d
}

/// A chicken's: its variant and sound variant.
pub fn chicken_data(variant: i32, sound: i32) -> EntityData {
    var d = ageable_data()
    d.define(CHICKEN_VARIANT, Value.Number(variant))
    d.define(CHICKEN_SOUND_VARIANT, Value.Number(sound))
    return d
}

/// A sheep's: its wool, its color's ID below 16 and shorn at 16, white and not shorn.
pub fn sheep_data() -> EntityData {
    var d = ageable_data()
    d.define(BYTE, Value.Byte(0i8))
    return d
}

/// An armadillo's: its state, idle (CAL-160).
pub fn armadillo_data() -> EntityData {
    var d = ageable_data()
    d.define(ARMADILLO_STATE, Value.Number(0))
    return d
}

/// A horse's, `Horse`'s: `AbstractHorse`'s flags, none, then its variant and markings, white with
/// none.
pub fn horse_data() -> EntityData {
    var d = ageable_data()
    d.define(BYTE, Value.Byte(0i8))
    d.define(INT, Value.Number(0))
    return d
}

/// A zombie horse's, `ZombieHorse`'s: `AbstractHorse`'s flags alone, none (CAL-156).
pub fn zombie_horse_data() -> EntityData {
    var d = ageable_data()
    d.define(BYTE, Value.Byte(0i8))
    return d
}

/// A donkey's, `AbstractChestedHorse`'s: the flags, then whether it has a chest, none.
pub fn donkey_data() -> EntityData {
    var d = ageable_data()
    d.define(BYTE, Value.Byte(0i8))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A creeper's, `Creeper`'s, after `Mob`'s flags: its swell's direction, -1, and whether it's
/// powered and ignited, neither (CAL-156).
pub fn creeper_data() -> EntityData {
    var d = mob_data()
    d.define(INT, Value.Number(-1))
    d.define(BOOLEAN, Value.Bool(false))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A zombie's, `Zombie`'s: whether it's a baby, its special type, 0, and whether it's becoming a
/// drowned, none of them.
pub fn zombie_data() -> EntityData {
    var d = mob_data()
    d.define(BOOLEAN, Value.Bool(false))
    d.define(INT, Value.Number(0))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A skeleton's, `Skeleton`'s: whether it's becoming a stray, not.
pub fn skeleton_data() -> EntityData {
    var d = mob_data()
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A spider's, `Spider`'s: its flags, climbing the first, none.
pub fn spider_data() -> EntityData {
    var d = mob_data()
    d.define(BYTE, Value.Byte(0i8))
    return d
}

/// An enderman's, `Enderman`'s: the block it carries, none, then whether it's creepy and stared
/// at, neither (CAL-156).
pub fn enderman_data() -> EntityData {
    var d = mob_data()
    d.define(OPTIONAL_BLOCK_STATE, Value.Empty)
    d.define(BOOLEAN, Value.Bool(false))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A witch's, `Witch`'s: `Raider`'s, whether it's celebrating, then whether it's drinking, neither.
pub fn witch_data() -> EntityData {
    var d = mob_data()
    d.define(BOOLEAN, Value.Bool(false))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A zombie villager's, `ZombieVillager`'s, after a zombie's: whether it's being cured, not; its
/// villager data, a plains villager of none at level 1 until its profession's drawn; and whether
/// that's final, not.
pub fn zombie_villager_data() -> EntityData {
    var d = zombie_data()
    d.define(BOOLEAN, Value.Bool(false))
    d.define(VILLAGER_DATA, Value.Villager(2, 0, 1))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A villager's, `Villager`'s (CAL-160): `AbstractVillager`'s unhappy counter,
/// `DATA_UNHAPPY_COUNTER`, 0, then its data, `DATA_VILLAGER_DATA`, a plains villager with no
/// profession at level 1, and whether that's final, `DATA_VILLAGER_DATA_FINALIZED`, not yet.
pub fn villager_data() -> EntityData {
    var d = ageable_data()
    d.define(INT, Value.Number(0))
    d.define(VILLAGER_DATA, Value.Villager(2, 0, 1))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// A slime's, `Slime`'s, after `AgeableMob`'s baby and age lock: its size, `ID_SIZE`, 1.
pub fn slime_data() -> EntityData {
    var d = ageable_data()
    d.define(INT, Value.Number(1))
    return d
}

// `Entity`'s, `LivingEntity`'s and `Mob`'s flags, as they're defined.
fn mob_data() -> EntityData {
    var d = EntityData()
    define_living(mut d)
    d.define(BYTE, Value.Byte(0i8))
    return d
}

// `Entity`'s, `LivingEntity`'s, `Mob`'s flags and `AgeableMob`'s baby and age lock, as they're
// defined.
fn ageable_data() -> EntityData {
    var d = EntityData()
    define_living(mut d)
    d.define(BYTE, Value.Byte(0i8))
    d.define(BOOLEAN, Value.Bool(false))
    d.define(BOOLEAN, Value.Bool(false))
    return d
}

/// An arrow's values as `Arrow`'s constructor defines them (CAL-159): `Entity`'s, then no flags, no
/// piercing, not in the ground, and no potion's colour, -1.
pub fn arrow_data() -> EntityData {
    var d = EntityData()
    define_entity(mut d)
    d.define(BYTE, Value.Byte(0i8))
    d.define(BYTE, Value.Byte(0i8))
    d.define(BOOLEAN, Value.Bool(false))
    d.define(INT, Value.Number(-1))
    return d
}

/// A thrown potion's values but its stack (D527): `Entity`'s, 0 to 7. Its stack,
/// `DATA_ITEM_STACK`, is 8, an `ITEM_STACK`, which its level packs after them, as its codecs
/// write stacks.
pub fn thrown_data() -> EntityData {
    var d = EntityData()
    define_entity(mut d)
    return d
}

/// The ID of a thrown potion's stack among its values, and the serializer of a stack, as
/// `ThrowableItemProjectile.DATA_ITEM_STACK` and `EntityDataSerializers.ITEM_STACK` are (D527).
pub const THROWN_ITEM: u8 = 8u8
pub const ITEM_STACK: i32 = 7

/// An armor stand's values as `ArmorStand`'s constructor defines them: `Entity`'s and
/// `LivingEntity`'s, then no flags, and its poses, `DEFAULT_HEAD_POSE` to `DEFAULT_RIGHT_LEG_POSE`.
pub fn armor_stand_data() -> EntityData {
    var d = EntityData()
    define_living(mut d)
    d.define(BYTE, Value.Byte(0i8))
    d.define(ROTATIONS, Value.Rotations(0.0f32, 0.0f32, 0.0f32))
    d.define(ROTATIONS, Value.Rotations(0.0f32, 0.0f32, 0.0f32))
    d.define(ROTATIONS, Value.Rotations(-10.0f32, 0.0f32, -10.0f32))
    d.define(ROTATIONS, Value.Rotations(-15.0f32, 0.0f32, 10.0f32))
    d.define(ROTATIONS, Value.Rotations(-1.0f32, 0.0f32, -1.0f32))
    d.define(ROTATIONS, Value.Rotations(1.0f32, 0.0f32, 1.0f32))
    return d
}
