/// An enchanting table's work, as vanilla's `EnchantmentMenu` does it (CAL-338): the bookshelves
/// that power it, the three offers its seed and they make for what's in it, and what enchanting by
/// one of them puts on that.
module world.enchanting_table

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import registry.components.{ItemCodecs}
import world.block_level.{BlockLevel}
import world.enchanting.{Enchanting, upgrade}
import world.grindstone.{set_component}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts}
import worldgen.interval.{Thrown}

/// An enchanting table's three offers, as `slotsChanged` leaves them: each one's cost in levels,
/// `costs`, 0 for none; and the enchantment it shows, `enchantClue`, by its ID, with that one's
/// level, `levelClue`, -1 for none.
pub struct Offers {
    pub costs: List<i32> = [0, 0, 0]
    pub clues: List<i32> = [-1, -1, -1]
    pub levels: List<i32> = [-1, -1, -1]
}

/// The bookshelves powering the table at `x`, `y`, `z`, `isValidBookShelf` of each of
/// `BOOKSHELF_OFFSETS`: two out on the ring around it, on its level and the one above, each a
/// `#enchantment_power_provider` with a `#enchantment_power_transmitter` between it and the table.
pub fn bookshelves<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> i32 ! Thrown {
    let providers = f.tag(String("minecraft:enchantment_power_provider"))
    let transmitters = f.tag(String("minecraft:enchantment_power_transmitter"))
    var n: i32 = 0
    for dx in -2..3 {
        for dy in 0..2 {
            for dz in -2..3 {
                if dx.abs() != 2 and dz.abs() != 2 {
                    continue
                }
                if not providers.contains(f.block(try level.state(f, x + dx, y + dy, z + dz))) {
                    continue
                }
                if transmitters.contains(f.block(try level.state(f, x + dx / 2, y + dy, z + dz / 2))) {
                    n += 1
                }
            }
        }
    }
    return n
}

/// `slotsChanged` of the stack `stack`: none for nothing or what can't be enchanted,
/// `isEnchantable`; else from the menu's random seeded with the player's enchantment seed `seed`,
/// each offer's cost, `getEnchantmentCost`, none where it's less than its place and one, then for
/// each that costs anything, what it would put on, `getEnchantmentList`, and one of that drawn to
/// show.
pub fn table_offers(enchanting: Enchanting, stack: Tag?, items: ItemCodecs, seed: i32, shelves: i32) -> Offers {
    var out = Offers()
    let s = stack else return out
    if not enchantable(s, items) {
        return out
    }
    var random = LegacyRandom.new(i64(seed))
    for i in 0usize..3 {
        let place = i32.wrap(i)
        var c = offer_cost(mut random, place, shelves, s, items)
        if c < place + 1 {
            c = 0
        }
        out.costs[i] = c
    }
    for i in 0usize..3 {
        if out.costs[i] <= 0 {
            continue
        }
        let list = table_picks(enchanting, mut random, s, items, seed, i32.wrap(i), out.costs[i])
        if not list.is_empty() {
            let (id, lv) = list[usize.wrap(random.next_int_below(i32.wrap(list.len())))]
            out.clues[i] = id
            out.levels[i] = lv
        }
    }
    return out
}

/// `getEnchantmentList`: the menu's random seeded with `seed` and the offer's place, `slot`, then
/// what the cost `cost` picks for the stack from `#in_enchanting_table`, `selectEnchantment`, with
/// one of them drawn and left out for a book that would get more than one; none where the world
/// hasn't that tag.
pub fn table_picks(enchanting: Enchanting, random: mut LegacyRandom, stack: Tag, items: ItemCodecs, seed: i32, slot: i32, cost: i32) -> List<(i32, i32)> {
    random = LegacyRandom.new(i64(i32.wrap(i64(seed) + i64(slot))))
    if not enchanting.has_tag("minecraft:in_enchanting_table") {
        return List<(i32, i32)>()
    }
    let source = enchanting.set_ids(Tag.Str(String("#minecraft:in_enchanting_table")))
    let id = item(stack)
    var list = enchanting.select(mut random, id.copy(), enchantable_value(stack, items), cost, source)
    if id == "minecraft:book" and list.len() > 1 {
        _ = list.remove(usize.wrap(random.next_int_below(i32.wrap(list.len()))))
    }
    return list
}

/// The stack `stack` enchanted with `picked`, by their IDs and levels, as `clickMenuButton` does:
/// a book made an enchanted book first, `transmuteCopy`, then each put on in turn,
/// `ItemStack.enchant`, among its stored enchantments for an enchanted book, else its
/// enchantments, raised to that level where it's more, nothing where it hasn't that component.
pub fn enchanted_with(enchanting: Enchanting, stack: Tag, items: ItemCodecs, picked: List<(i32, i32)>) -> Tag {
    var out = stack.copy()
    if item(out) == "minecraft:book" {
        out = with_item(out, "minecraft:enchanted_book")
    }
    let kind = if item(out) == "minecraft:enchanted_book" { "minecraft:stored_enchantments" } else { "minecraft:enchantments" }
    for (id, lv) in picked {
        let current = items.component(out, String(kind)) else continue
        var levels = match current {
            Tag.Compound(m) => m.copy(),
            _ => JavaHashMap<String, Tag>(),
        }
        upgrade(mut levels, enchanting.name(id), lv)
        out = set_component(out, kind, Tag.Compound(levels), items)
    }
    return out
}

// `isEnchantable`: an `enchantable` and `enchantments` with none in them.
pub fn enchantable(stack: Tag, items: ItemCodecs) -> bool {
    if items.component(stack, String("minecraft:enchantable")) == none {
        return false
    }
    let found = items.component(stack, String("minecraft:enchantments")) else return false
    return match found {
        Tag.Compound(m) => m.is_empty(),
        _ => false,
    }
}

// `getEnchantmentCost`: 0 without an `enchantable`; else with the bookshelves kept to 15, a draw
// of 8 and one, half the bookshelves and a draw of up to them; a third of that, at least 1, for the
// first offer, two thirds and one for the second, and that or twice the bookshelves for the third.
fn offer_cost(random: mut LegacyRandom, slot: i32, bookcases: i32, stack: Tag, items: ItemCodecs) -> i32 {
    if enchantable_value(stack, items) == none {
        return 0
    }
    let shelves = bookcases.min(15)
    let selected = random.next_int_below(8) + 1 + (shelves >> 1) + random.next_int_below(shelves + 1)
    if slot == 0 {
        return (selected / 3).max(1)
    }
    if slot == 1 {
        return selected * 2 / 3 + 1
    }
    return selected.max(shelves * 2)
}

fn enchantable_value(stack: Tag, items: ItemCodecs) -> i32? {
    let found = items.component(stack, String("minecraft:enchantable")) else return none
    let Tag.Compound(e) = found else return none
    if not e.contains("value") {
        return none
    }
    return e["value"].number_int()
}

fn item(stack: Tag) -> String {
    let Tag.Compound(m) = stack else return String("minecraft:air")
    if not m.contains("id") {
        return String("minecraft:air")
    }
    return match m["id"].copy() {
        Tag.Str(s) => s,
        _ => String("minecraft:air"),
    }
}

fn with_item(stack: Tag, id: str) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("id"), Tag.Str(String(id)))
    return Tag.Compound(out)
}
