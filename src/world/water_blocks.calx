/// Blocks that take water up or melt into it (CAL-127), as `SpongeBlock`, `WetSpongeBlock` and
/// `FrostedIceBlock` have them, from javap: a sponge taking up the water around it, a wet sponge
/// drying where water evaporates, and frosted ice, which a player's frost walker lays, aging and
/// melting as its tick runs and as frosted ice beside it melts.
module world.water_blocks

import random.source.{RandomSource}
import world.block_level.{BlockLevel, destroy_block, remove_block}
import world.level_writer.{UPDATE_LIMIT}
import world.pos.{BlockPos}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env, can_survive}

// `SpongeBlock.removeWaterBreadthFirstSearch`'s reach, 6 blocks from the sponge, and the most
// blocks it takes, 65, the sponge among them.
const SPONGE_DEPTH: i32 = 6
const SPONGE_MOST: i32 = 65

/// `levelEvent`'s type for a wet sponge drying, `WetSpongeBlock.onPlace`.
pub const WET_SPONGE_DRIES: i32 = 2009

/// `SpongeBlock.tryAbsorbWater`, which its `onPlace`, where it wasn't a sponge, and its
/// `neighborChanged` run: where the sponge at `x`, `y`, `z` took up any water, it's set wet with
/// flags 2, with its sound.
pub fn sponge_absorb<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    let Env { facts: f, .. } = e
    if not try remove_water(e, mut level, x, y, z) {
        return
    }
    _ = level.set_block_limited(x, y, z, f.default_state(f.ids.wet_sponge), 2, UPDATE_LIMIT)
    level.play_sound(x, y, z, "block.sponge.absorb", 1.0f32, 1.0f32)
}

// `removeWaterBreadthFirstSearch`, `BlockPos.breadthFirstTraversal` from the sponge at sx, sy, sz:
// a queue of places, first in first out, each with how far it is, each taken once, as it's
// reached, whatever reached it first; each the search takes counts, until 65 have, and those
// under 6 out add the six around them in `Direction`'s order. Whether it took more than the
// sponge.
fn remove_water<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, sx: i32, sy: i32, sz: i32) -> bool ! Thrown {
    var queue = List<(i32, i32, i32, i32)>()
    queue.push((sx, sy, sz, 0))
    var head: usize = 0
    var seen = Set<i64>()
    var count = 0
    while head < queue.len() {
        let (x, y, z, depth) = queue[head]
        head += 1
        let key = BlockPos { x: x, y: y, z: z }.pack()
        if seen.contains(key) {
            continue
        }
        seen.insert(key)
        if not try take_water(e, mut level, sx, sy, sz, x, y, z) {
            continue
        }
        count += 1
        if count >= SPONGE_MOST {
            return count > 1
        }
        if depth >= SPONGE_DEPTH {
            continue
        }
        for d in 0..6 {
            queue.push((x + step_x(d), y + step_y(d), z + step_z(d), depth + 1))
        }
    }
    return count > 1
}

// The search's visitor, `lambda$removeWaterBreadthFirstSearch$1`: whether it takes the place at
// x, y, z, taking its water. The sponge's own place it takes as it is; a place whose fluid isn't
// water it passes over. Water there is picked up as a bucket would, `BucketPickup.pickupBlock`:
// a source or a bubble column set to air with flags 11; a waterlogged block's water let out, with
// the block broken where it can't stay as it was, though a barrier gives nothing up without a
// creative player. Water a bucket can't take, flowing, is set to air with flags 3, and kelp and
// seagrass are broken, what they drop coming with items. Anything else holding water it passes
// over.
fn take_water<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, sx: i32, sy: i32, sz: i32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    if x == sx and y == sy and z == sz {
        return true
    }
    let state = try level.state(f, x, y, z)
    if not f.is_water(state) {
        return false
    }
    let block = f.block(state)
    let kind = f.class_name(block)
    if kind == "LiquidBlock" {
        if (f.get_int(state, "level") ?? 0) == 0 {
            _ = level.set_block_limited(x, y, z, f.ids.air_state, 11, UPDATE_LIMIT)
        } else {
            _ = level.set_block_limited(x, y, z, f.ids.air_state, 3, UPDATE_LIMIT)
        }
        return true
    }
    if kind == "BubbleColumnBlock" {
        _ = level.set_block_limited(x, y, z, f.ids.air_state, 11, UPDATE_LIMIT)
        return true
    }
    if f.waterloggable(block) and kind != "BarrierBlock" and f.get_bool(state, "waterlogged") {
        // `SimpleWaterloggedBlock.pickupBlock`, the state as it was asked whether it can stay.
        _ = level.set_block_limited(x, y, z, try f.with_bool(state, "waterlogged", false), 3, UPDATE_LIMIT)
        if not try can_survive(e, level, state, x, y, z) {
            _ = try destroy_block(e, mut level, x, y, z, true, none, UPDATE_LIMIT)
        }
        return true
    }
    if block == f.ids.kelp or block == f.ids.kelp_plant or block == f.ids.seagrass or block == f.ids.tall_seagrass {
        level.unimplemented(String("What a broken block drops"))
        _ = level.set_block_limited(x, y, z, f.ids.air_state, 3, UPDATE_LIMIT)
        return true
    }
    return false
}

/// `WetSpongeBlock.onPlace`: where water evaporates, a wet sponge set dries at once, a sponge set
/// with flags 3, with its event and its sound, at a pitch of 0.7 to 0.84 drawn from the level's
/// random.
pub fn wet_sponge_placed<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, x: i32, y: i32, z: i32) {
    if not level.water_evaporates() {
        return
    }
    _ = level.set_block_limited(x, y, z, f.default_state(f.ids.sponge), 3, UPDATE_LIMIT)
    level.level_event(WET_SPONGE_DRIES, x, y, z, 0)
    let pitch = (1.0f32 + level.next_float() * 0.2f32) * 0.7f32
    level.play_sound(x, y, z, "block.wet_sponge.dries", 1.0f32, pitch)
}

/// `FrostedIceBlock.onPlace`, as any state of it is set: its tick 60 to 120 on, drawn from the
/// level's random.
pub fn frosted_placed<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) {
    let delay = level.next_int_between(60, 120)
    level.schedule_block(f.block(state), x, y, z, delay, 0)
}

/// `FrostedIceBlock.neighborChanged`: frosted ice beside it changed, and fewer than 2 of the six
/// around it are frosted ice, it melts.
pub fn frosted_neighbour_changed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, source: u32) ! Thrown {
    let block = f.block(state)
    if source == block and try fewer_neighbours(f, level, block, x, y, z, 2) {
        try melt(f, mut level, x, y, z)
    }
}

/// `FrostedIceBlock.tick`: one time in three, or with fewer than 4 of it around, in light over 11
/// less its age and its dampening, it ages, `slightlyMelt`, and where that melted it, each of it
/// around in `Direction`'s order ages too, and one that didn't melt ticks again 20 to 40 on.
/// Otherwise it ticks again 20 to 40 on, which waits behind the tick aging it set. Its light is
/// the block light alone in the End, else the brighter of the sky's, less its darkening, and the
/// blocks', `getMaxLocalRawBrightness`.
pub fn frosted_tick<L: BlockAccess + BlockLevel + RandomSource>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let block = f.block(state)
    var ready = level.next_int_below(3) == 0
    if not ready {
        ready = try fewer_neighbours(f, level, block, x, y, z, 4)
    }
    if ready {
        let light = if level.is_end() { level.block_light(x, y, z) } else { level.local_brightness(x, y, z) }
        let age = f.get_int(state, "age") ?? 0
        ready = light > 11 - age - f.light_dampening(state)
    }
    if ready and try slightly_melt(f, mut level, state, x, y, z) {
        for d in 0..6 {
            let (nx, ny, nz) = (x + step_x(d), y + step_y(d), z + step_z(d))
            let beside = try level.state(f, nx, ny, nz)
            if f.block(beside) == block and not try slightly_melt(f, mut level, beside, nx, ny, nz) {
                let delay = level.next_int_between(20, 40)
                level.schedule_block(block, nx, ny, nz, delay, 0)
            }
        }
        return
    }
    let delay = level.next_int_between(20, 40)
    level.schedule_block(block, x, y, z, delay, 0)
}

// `FrostedIceBlock.slightlyMelt`: under age 3 it's a step older, set with flags 2, and hasn't
// melted; at 3 it melts.
fn slightly_melt<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let age = f.get_int(state, "age") ?? 0
    if age < 3 {
        _ = level.set_block_limited(x, y, z, try f.with_int(state, "age", age + 1), 2, UPDATE_LIMIT)
        return false
    }
    try melt(f, mut level, x, y, z)
    return true
}

// `IceBlock.melt`: gone where water evaporates, `removeBlock`; elsewhere water, set with flags 3,
// which is told its block changed.
fn melt<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32) ! Thrown {
    if level.water_evaporates() {
        _ = try remove_block(f, mut level, x, y, z)
        return
    }
    _ = level.set_block_limited(x, y, z, f.ids.water_state, 3, UPDATE_LIMIT)
    level.neighbour_changed(x, y, z, f.ids.water)
}

// `FrostedIceBlock.fewerNeigboursThan`: whether fewer than `most` of the six around x, y, z, in
// `Direction`'s order, are `block`, stopping as that many are.
fn fewer_neighbours<L: BlockAccess>(f: Facts, level: L, block: u32, x: i32, y: i32, z: i32, most: i32) -> bool ! Thrown {
    var n = 0
    for d in 0..6 {
        if f.block(try level.state(f, x + step_x(d), y + step_y(d), z + step_z(d))) == block {
            n += 1
            if n >= most {
                return false
            }
        }
    }
    return true
}
