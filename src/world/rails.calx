/// Rails as vanilla lays them (CAL-124): `RailState`, a rail's shape and the places it joins, as
/// `place` lays a rail, joins it to the rails beside it that can take another, and turns those
/// toward it; `BaseRailBlock`'s hooks, a rail laid as it's placed, popped as what holds it up goes,
/// and a plain rail turned as a signal comes beside it at a three-way join; and a powered or
/// activator rail powered along a line of up to eight more of its kind from one a signal reaches,
/// `PoweredRailBlock.findPoweredRailSignal`. A detector rail is pressed by the minecarts on it, and
/// Calcite has none, so it's let go as its tick runs (CAL-128).
module world.rails

import world.block_level.{BlockLevel, legacy_block, update_output_signal}
import world.level_writer.{UPDATE_LIMIT}
import world.pos.{BlockPos}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, RIGID, UP}
import worldgen.interval.{Thrown}
import worldgen.signals.{has_neighbour_signal, is_source}

// `RailShape`'s values, by their ordinals, and none.
const NORTH_SOUTH: i32 = 0
const EAST_WEST: i32 = 1
const ASCENDING_EAST: i32 = 2
const ASCENDING_WEST: i32 = 3
const ASCENDING_NORTH: i32 = 4
const ASCENDING_SOUTH: i32 = 5
const SOUTH_EAST: i32 = 6
const SOUTH_WEST: i32 = 7
const NORTH_WEST: i32 = 8
const NORTH_EAST: i32 = 9
const NO_SHAPE: i32 = -1

// The name of the shape `s`, as the state's `shape` has it.
fn shape_name(s: i32) -> String {
    let names: List<str> = ["north_south", "east_west", "ascending_east", "ascending_west", "ascending_north", "ascending_south", "south_east", "south_west", "north_west", "north_east"]
    return String(names[usize.wrap(s)])
}

// The shape of the rail `state`.
fn shape_of(f: Facts, state: u32) -> i32 {
    let name = f.get_name(state, "shape") ?? String("north_south")
    for s in 0..10 {
        if name == shape_name(s) {
            return s
        }
    }
    return NORTH_SOUTH
}

// `RailShape.isSlope`.
fn is_slope(s: i32) -> bool {
    return s >= ASCENDING_EAST and s <= ASCENDING_SOUTH
}

/// `BaseRailBlock.isRail`: a block in `#rails` that's a rail.
pub fn is_rail(f: Facts, state: u32) -> bool {
    return f.neighbour_class(f.block(state)) == "BaseRailBlock" and f.in_set(state, f.tag("minecraft:rails"))
}

// `BaseRailBlock.isStraight`: every rail but the plain one, which turns corners.
fn straight(f: Facts, state: u32) -> bool {
    return f.class_name(f.block(state)) != "RailBlock"
}

// `RailState`: the rail `state` at x, y, z, whether it's straight, and the places it joins.
struct Rail {
    x: i32
    y: i32
    z: i32
    state: u32
    straight: bool
    connections: List<BlockPos>
}

fn rail_of(f: Facts, x: i32, y: i32, z: i32, state: u32) -> Rail {
    var r = Rail { x: x, y: y, z: z, state: state, straight: straight(f, state), connections: List<BlockPos>() }
    update_connections(mut r, shape_of(f, state))
    return r
}

fn at(x: i32, y: i32, z: i32) -> BlockPos {
    return BlockPos { x: x, y: y, z: z }
}

// `updateConnections`: the two places the shape `s` joins, a slope's upper one a block up.
fn update_connections(r: mut Rail, s: i32) {
    r.connections.clear()
    let x = r.x
    let y = r.y
    let z = r.z
    if s == NORTH_SOUTH {
        r.connections.push(at(x, y, z - 1))
        r.connections.push(at(x, y, z + 1))
    } else if s == EAST_WEST {
        r.connections.push(at(x - 1, y, z))
        r.connections.push(at(x + 1, y, z))
    } else if s == ASCENDING_EAST {
        r.connections.push(at(x - 1, y, z))
        r.connections.push(at(x + 1, y + 1, z))
    } else if s == ASCENDING_WEST {
        r.connections.push(at(x - 1, y + 1, z))
        r.connections.push(at(x + 1, y, z))
    } else if s == ASCENDING_NORTH {
        r.connections.push(at(x, y + 1, z - 1))
        r.connections.push(at(x, y, z + 1))
    } else if s == ASCENDING_SOUTH {
        r.connections.push(at(x, y, z - 1))
        r.connections.push(at(x, y + 1, z + 1))
    } else if s == SOUTH_EAST {
        r.connections.push(at(x + 1, y, z))
        r.connections.push(at(x, y, z + 1))
    } else if s == SOUTH_WEST {
        r.connections.push(at(x - 1, y, z))
        r.connections.push(at(x, y, z + 1))
    } else if s == NORTH_WEST {
        r.connections.push(at(x - 1, y, z))
        r.connections.push(at(x, y, z - 1))
    } else if s == NORTH_EAST {
        r.connections.push(at(x + 1, y, z))
        r.connections.push(at(x, y, z - 1))
    }
}

// `getRail`: the rail at `p`, or a block above it, or a block below it.
fn get_rail<L: BlockAccess>(f: Facts, level: L, p: BlockPos) -> Rail? ! Thrown {
    let offsets: List<i32> = [0, 1, -1]
    for dy in offsets {
        let s = try level.state(f, p.x, p.y + dy, p.z)
        if is_rail(f, s) {
            return some(rail_of(f, p.x, p.y + dy, p.z, s))
        }
    }
    return none
}

// `hasRail`: a rail at x, y, z, or a block above or below it.
fn has_rail<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    return is_rail(f, try level.state(f, x, y, z)) or is_rail(f, try level.state(f, x, y + 1, z)) or is_rail(f, try level.state(f, x, y - 1, z))
}

// `hasConnection`: whether the rail joins a place over x, z, at any height.
fn has_connection(r: Rail, x: i32, z: i32) -> bool {
    for c in r.connections {
        if c.x == x and c.z == z {
            return true
        }
    }
    return false
}

// `removeSoftConnections`: the places it joins that aren't rails joining it back let go, and the
// rest made the rails' own places.
fn remove_soft_connections<L: BlockAccess>(f: Facts, level: L, r: mut Rail) ! Thrown {
    var i: usize = 0
    while i < r.connections.len() {
        let c = r.connections[i]
        var kept = false
        if let other = try get_rail(f, level, c) {
            if has_connection(other, r.x, r.z) {
                r.connections[i] = at(other.x, other.y, other.z)
                kept = true
            }
        }
        if kept {
            i += 1
        } else {
            _ = r.connections.remove(i)
        }
    }
}

// `canConnectTo`: whether `r` joins `other` already or has a place free.
fn can_connect_to(r: Rail, other: Rail) -> bool {
    return has_connection(r, other.x, other.z) or r.connections.len() != 2
}

// `connectTo`: `r` joined to `other` too and shaped to what it joins, a straight line rising to a
// rail a block up, set with flags 3.
fn connect_to<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, r: mut Rail, other: Rail) ! Thrown {
    r.connections.push(at(other.x, other.y, other.z))
    let n = has_connection(r, r.x, r.z - 1)
    let s = has_connection(r, r.x, r.z + 1)
    let w = has_connection(r, r.x - 1, r.z)
    let e = has_connection(r, r.x + 1, r.z)
    var shape = NO_SHAPE
    if n or s {
        shape = NORTH_SOUTH
    }
    if w or e {
        shape = EAST_WEST
    }
    if not r.straight {
        if s and e and not n and not w {
            shape = SOUTH_EAST
        }
        if s and w and not n and not e {
            shape = SOUTH_WEST
        }
        if n and w and not s and not e {
            shape = NORTH_WEST
        }
        if n and e and not s and not w {
            shape = NORTH_EAST
        }
    }
    shape = try rising(f, level, r.x, r.y, r.z, shape)
    if shape == NO_SHAPE {
        shape = NORTH_SOUTH
    }
    r.state = try f.with_name(r.state, "shape", shape_name(shape))
    _ = level.set_block_limited(r.x, r.y, r.z, r.state, 3, UPDATE_LIMIT)
}

// A straight `shape` at x, y, z made a slope up to a rail a block up beyond either end: north's
// then south's, east's then west's.
fn rising<L: BlockAccess>(f: Facts, level: L, x: i32, y: i32, z: i32, shape: i32) -> i32 ! Thrown {
    var s = shape
    if s == NORTH_SOUTH {
        if is_rail(f, try level.state(f, x, y + 1, z - 1)) {
            s = ASCENDING_NORTH
        }
        if is_rail(f, try level.state(f, x, y + 1, z + 1)) {
            s = ASCENDING_SOUTH
        }
    }
    if s == EAST_WEST {
        if is_rail(f, try level.state(f, x + 1, y + 1, z)) {
            s = ASCENDING_EAST
        }
        if is_rail(f, try level.state(f, x - 1, y + 1, z)) {
            s = ASCENDING_WEST
        }
    }
    return s
}

// `hasNeighborRail`: whether there's a rail at x, y, z, or a block up or down, that, its loose
// ends let go, can join `r`.
fn has_neighbour_rail<L: BlockAccess>(f: Facts, level: L, r: Rail, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let found = try get_rail(f, level, at(x, y, z)) else return false
    var other = found
    try remove_soft_connections(f, level, mut other)
    return can_connect_to(other, r)
}

// `countPotentialConnections`: the rails beside it, or a block up or down from beside it.
fn count_potential_connections<L: BlockAccess>(f: Facts, level: L, r: Rail) -> i32 ! Thrown {
    var count = 0
    if try has_rail(f, level, r.x, r.y, r.z - 1) {
        count += 1
    }
    if try has_rail(f, level, r.x + 1, r.y, r.z) {
        count += 1
    }
    if try has_rail(f, level, r.x, r.y, r.z + 1) {
        count += 1
    }
    if try has_rail(f, level, r.x - 1, r.y, r.z) {
        count += 1
    }
    return count
}

// `RailState.place`: the rail shaped to the rails beside it that can join it, a plain one turning
// a corner toward them, `powered` choosing which way at a three- or four-way join; set with
// flags 3 where `always` or its state changed, and then each rail it joins joined back to it.
fn place<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, r: mut Rail, powered: bool, always: bool, current: i32) ! Thrown {
    let n = try has_neighbour_rail(f, level, r, r.x, r.y, r.z - 1)
    let s = try has_neighbour_rail(f, level, r, r.x, r.y, r.z + 1)
    let w = try has_neighbour_rail(f, level, r, r.x - 1, r.y, r.z)
    let e = try has_neighbour_rail(f, level, r, r.x + 1, r.y, r.z)
    var shape = NO_SHAPE
    let ns = n or s
    let ew = w or e
    if ns and not ew {
        shape = NORTH_SOUTH
    }
    if ew and not ns {
        shape = EAST_WEST
    }
    let se = s and e
    let sw = s and w
    let ne = n and e
    let nw = n and w
    if not r.straight {
        if se and not n and not w {
            shape = SOUTH_EAST
        }
        if sw and not n and not e {
            shape = SOUTH_WEST
        }
        if nw and not s and not e {
            shape = NORTH_WEST
        }
        if ne and not s and not w {
            shape = NORTH_EAST
        }
    }
    if shape == NO_SHAPE {
        if ns and ew {
            shape = current
        } else if ns {
            shape = NORTH_SOUTH
        } else if ew {
            shape = EAST_WEST
        }
        if not r.straight {
            if powered {
                if se {
                    shape = SOUTH_EAST
                }
                if sw {
                    shape = SOUTH_WEST
                }
                if ne {
                    shape = NORTH_EAST
                }
                if nw {
                    shape = NORTH_WEST
                }
            } else {
                if nw {
                    shape = NORTH_WEST
                }
                if ne {
                    shape = NORTH_EAST
                }
                if sw {
                    shape = SOUTH_WEST
                }
                if se {
                    shape = SOUTH_EAST
                }
            }
        }
    }
    shape = try rising(f, level, r.x, r.y, r.z, shape)
    if shape == NO_SHAPE {
        shape = current
    }
    update_connections(mut r, shape)
    r.state = try f.with_name(r.state, "shape", shape_name(shape))
    if always or try level.state(f, r.x, r.y, r.z) != r.state {
        _ = level.set_block_limited(r.x, r.y, r.z, r.state, 3, UPDATE_LIMIT)
        var i: usize = 0
        while i < r.connections.len() {
            let c = r.connections[i]
            i += 1
            let found = try get_rail(f, level, c) else continue
            var other = found
            try remove_soft_connections(f, level, mut other)
            if can_connect_to(other, r) {
                try connect_to(f, mut level, mut other, r)
            }
        }
    }
}

// `BaseRailBlock.updateDir`: the rail `state` at x, y, z laid by `place`, powered as a signal
// reaches it, and the state it's laid as.
fn update_dir<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, always: bool) -> u32 ! Thrown {
    var r = rail_of(f, x, y, z, state)
    let powered = try has_neighbour_signal(f, level, x, y, z, true)
    try place(f, mut level, mut r, powered, always, shape_of(f, state))
    return r.state
}

/// `BaseRailBlock.onPlace`, where it wasn't this rail before: laid, `updateState`.
pub fn rail_placed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, old: u32, moved: bool) ! Thrown {
    if f.block(old) == f.block(state) {
        return
    }
    _ = try update_state(f, mut level, state, x, y, z, moved)
}

// `BaseRailBlock.updateState`, as a rail's laid: laid, and a straight rail told, as laid, that it
// changed, `Level.neighborChanged`, through the level's updater; the state it's laid as.
fn update_state<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, moved: bool) -> u32 ! Thrown {
    let laid = try update_dir(f, mut level, state, x, y, z, true)
    if straight(f, laid) {
        level.neighbour_changed_as(laid, x, y, z, f.block(laid), moved)
    }
    return laid
}

/// `DetectorRailBlock.onPlace`, where it wasn't a detector rail before: laid, `updateState`, then
/// checked as laid (CAL-128).
pub fn detector_placed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, old: u32, moved: bool) ! Thrown {
    if f.block(old) == f.block(state) {
        return
    }
    let laid = try update_state(f, mut level, state, x, y, z, moved)
    try detector_check(f, mut level, laid, x, y, z)
}

/// `DetectorRailBlock.tick`: a powered one checked.
pub fn detector_tick<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if f.get_bool(state, "powered") {
        try detector_check(f, mut level, state, x, y, z)
    }
}

// `DetectorRailBlock.checkPressed`, of the detector rail `state` at x, y, z, where it can stay and
// is still there: pressed while a minecart is in `getSearchBB`, and Calcite has none, so a powered
// one is let go, set with flags 3, the rails it joins told it changed, `updatePowerToConnected`,
// then the blocks around it and under it. Its tick comes again only while it's pressed. A
// comparator reading it is told either way.
fn detector_check<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    if not f.sturdy(try level.state(f, x, y - 1, z), UP, RIGID) {
        return
    }
    let block = f.block(state)
    if f.block(try level.state(f, x, y, z)) != block {
        return
    }
    if f.get_bool(state, "powered") {
        let off = try f.with_bool(state, "powered", false)
        _ = level.set_block_limited(x, y, z, off, 3, UPDATE_LIMIT)
        try power_to_connected(f, mut level, off, x, y, z)
        level.update_neighbours(x, y, z, block)
        level.update_neighbours(x, y - 1, z, block)
    }
    try update_output_signal(f, mut level, block, x, y, z)
}

// `DetectorRailBlock.updatePowerToConnected`: each place the rail `state` at x, y, z joins, as
// `RailState` has them, told it changed, as it is, through the level's updater.
fn power_to_connected<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let r = rail_of(f, x, y, z, state)
    for p in r.connections {
        let s = try level.state(f, p.x, p.y, p.z)
        level.neighbour_changed_as(s, p.x, p.y, p.z, f.block(s), false)
    }
}

/// `BaseRailBlock.neighborChanged`: a rail that's still there, popped where what's under it, or
/// what a slope rises onto, can't hold it up, which drops it, coming with items; else a plain rail
/// turned, `RailBlock.updateState`, as a signal source beside it changed where three rails are
/// beside it, and a powered or activator rail powered, `PoweredRailBlock.updateState`.
pub fn rail_neighbour_changed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32, source: u32, moved: bool) ! Thrown {
    let here = try level.state(f, x, y, z)
    if f.block(here) != f.block(state) {
        return
    }
    if try should_be_removed(f, level, shape_of(f, state), x, y, z) {
        // `dropResources(state, level, pos)`.
        level.drop_resources(f, state, x, y, z, none, none, none)
        _ = level.set_block_limited(x, y, z, legacy_block(f, here), if moved { 67 } else { 3 }, UPDATE_LIMIT)
        return
    }
    let kind = f.class_name(f.block(state))
    if kind == "RailBlock" {
        if is_source(f, f.default_state(source), true) and try count_potential_connections(f, level, rail_of(f, x, y, z, state)) == 3 {
            _ = try update_dir(f, mut level, state, x, y, z, false)
        }
        return
    }
    if kind == "PoweredRailBlock" {
        try powered_rail_update(f, mut level, state, x, y, z)
    }
}

// `BaseRailBlock.shouldBeRemoved`: nothing rigid under it, or a slope with nothing rigid beside it
// to rise onto.
fn should_be_removed<L: BlockAccess>(f: Facts, level: L, shape: i32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    if not f.sturdy(try level.state(f, x, y - 1, z), UP, RIGID) {
        return true
    }
    if shape == ASCENDING_EAST {
        return not f.sturdy(try level.state(f, x + 1, y, z), UP, RIGID)
    }
    if shape == ASCENDING_WEST {
        return not f.sturdy(try level.state(f, x - 1, y, z), UP, RIGID)
    }
    if shape == ASCENDING_NORTH {
        return not f.sturdy(try level.state(f, x, y, z - 1), UP, RIGID)
    }
    if shape == ASCENDING_SOUTH {
        return not f.sturdy(try level.state(f, x, y, z + 1), UP, RIGID)
    }
    return false
}

/// `BaseRailBlock.affectNeighborsAfterRemoval`, unless a piston moved it: a slope's block above
/// told, and a straight rail's around it and around the block under it.
pub fn rail_removed<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, old: u32, x: i32, y: i32, z: i32, moved: bool) {
    if moved {
        return
    }
    let block = f.block(old)
    if is_slope(shape_of(f, old)) {
        level.update_neighbours(x, y + 1, z, block)
    }
    if straight(f, old) {
        level.update_neighbours(x, y, z, block)
        level.update_neighbours(x, y - 1, z, block)
    }
}

// `PoweredRailBlock.updateState`: powered while a signal reaches it, or one of its kind along the
// line either way within eight; as that changes, set with flags 3 and what's below told, and
// above where it's a slope.
fn powered_rail_update<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, state: u32, x: i32, y: i32, z: i32) ! Thrown {
    let was = f.get_bool(state, "powered")
    let now = try has_neighbour_signal(f, level, x, y, z, true) or try find_powered_rail_signal(f, level, state, x, y, z, true, 0) or try find_powered_rail_signal(f, level, state, x, y, z, false, 0)
    if now == was {
        return
    }
    _ = level.set_block_limited(x, y, z, try f.with_bool(state, "powered", now), 3, UPDATE_LIMIT)
    let block = f.block(state)
    level.update_neighbours(x, y - 1, z, block)
    if is_slope(shape_of(f, state)) {
        level.update_neighbours(x, y + 1, z, block)
    }
}

// `findPoweredRailSignal`: the next rail along the line from the one `state` at x, y, z, `forward`
// or back, a slope's upper end a block up, and on the flat a block down too, powered by a signal or
// by the next past it, `depth` of eight deep.
fn find_powered_rail_signal<L: BlockAccess>(f: Facts, level: L, state: u32, x: i32, y: i32, z: i32, forward: bool, depth: i32) -> bool ! Thrown {
    if depth >= 8 {
        return false
    }
    var nx = x
    var ny = y
    var nz = z
    var flat = true
    var shape = shape_of(f, state)
    if shape == NORTH_SOUTH {
        nz += if forward { 1 } else { -1 }
    } else if shape == EAST_WEST {
        nx += if forward { -1 } else { 1 }
    } else if shape == ASCENDING_EAST {
        if forward {
            nx -= 1
        } else {
            nx += 1
            ny += 1
            flat = false
        }
        shape = EAST_WEST
    } else if shape == ASCENDING_WEST {
        if forward {
            nx -= 1
            ny += 1
            flat = false
        } else {
            nx += 1
        }
        shape = EAST_WEST
    } else if shape == ASCENDING_NORTH {
        if forward {
            nz += 1
        } else {
            nz -= 1
            ny += 1
            flat = false
        }
        shape = NORTH_SOUTH
    } else if shape == ASCENDING_SOUTH {
        if forward {
            nz += 1
            ny += 1
            flat = false
        } else {
            nz -= 1
        }
        shape = NORTH_SOUTH
    }
    let block = f.block(state)
    if try same_rail_with_power(f, level, block, nx, ny, nz, forward, depth, shape) {
        return true
    }
    return flat and try same_rail_with_power(f, level, block, nx, ny - 1, nz, forward, depth, shape)
}

// `isSameRailWithPower`: a powered rail of the kind `block` at x, y, z, along `shape`'s line, that
// a signal reaches, or the next along from it.
fn same_rail_with_power<L: BlockAccess>(f: Facts, level: L, block: u32, x: i32, y: i32, z: i32, forward: bool, depth: i32, shape: i32) -> bool ! Thrown {
    let s = try level.state(f, x, y, z)
    if f.block(s) != block {
        return false
    }
    let other = shape_of(f, s)
    if shape == EAST_WEST and (other == NORTH_SOUTH or other == ASCENDING_NORTH or other == ASCENDING_SOUTH) {
        return false
    }
    if shape == NORTH_SOUTH and (other == EAST_WEST or other == ASCENDING_EAST or other == ASCENDING_WEST) {
        return false
    }
    if not f.get_bool(s, "powered") {
        return false
    }
    if try has_neighbour_signal(f, level, x, y, z, true) {
        return true
    }
    return try find_powered_rail_signal(f, level, s, x, y, z, forward, depth + 1)
}
