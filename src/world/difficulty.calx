/// The difficulty at a place, as vanilla's `DifficultyInstance` works it out (CAL-156), which a mob
/// finalized there draws by: the world's difficulty, scaled from 0.75 up by how long the overworld's
/// clock has run past its third day, up to 0.25 at its 1,440,000th tick past it; by how long players
/// have been near the chunk, its inhabited time, up to 0.75 at 3,600,000 ticks, 1 on hard; and by the
/// moon's brightness, a quarter of it, no more than the clock's part; the chunk's and the moon's
/// parts halved on easy. Peaceful is 0.
///
/// Its special multiplier, `getSpecialMultiplier`, 0 below 2 and 1 above 4, is what most of a mob's
/// spawn odds go by; a new world's on normal is 1.5, so 0, and on hard 2.25, so 0.125.
module world.difficulty

import world.modes.{Difficulty}

/// The difficulty at a place.
pub struct LocalDifficulty {
    pub base: Difficulty
    pub effective: f32
}

impl LocalDifficulty {
    /// `new DifficultyInstance(base, totalGameTime, localGameTime, moonBrightness)`: with `total`
    /// the overworld clock's ticks, `local` the chunk's inhabited time, and `moon` the moon's
    /// brightness there.
    pub fn new(base: Difficulty, total: i64, local: i64, moon: f32) -> LocalDifficulty {
        if base == Difficulty.Peaceful {
            return LocalDifficulty { base: base, effective: 0.0f32 }
        }
        let hard = base == Difficulty.Hard
        var scale = 0.75f32
        let global = clamp((f32.nearest(total) + -72000.0f32) / 1440000.0f32, 0.0f32, 1.0f32) * 0.25f32
        scale += global
        var local_scale = 0.0f32
        local_scale += clamp(f32.nearest(local) / 3600000.0f32, 0.0f32, 1.0f32) * (if hard { 1.0f32 } else { 0.75f32 })
        local_scale += clamp(moon * 0.25f32, 0.0f32, global)
        if base == Difficulty.Easy {
            local_scale *= 0.5f32
        }
        scale += local_scale
        return LocalDifficulty { base: base, effective: f32.nearest(base.id()) * scale }
    }

    /// `getSpecialMultiplier`.
    pub fn special(self) -> f32 {
        if self.effective < 2.0f32 {
            return 0.0f32
        }
        return if self.effective > 4.0f32 { 1.0f32 } else { (self.effective - 2.0f32) / 2.0f32 }
    }

    /// Whether the world's difficulty is hard, as a mob's finalizing asks `getDifficulty`.
    pub fn hard(self) -> bool {
        return self.base == Difficulty.Hard
    }
}

/// The moon's brightness in the phase at `phase` of `MoonPhase`'s order,
/// `MOON_BRIGHTNESS_PER_PHASE`: full at the full moon, none at the new.
pub fn moon_brightness(phase: i32) -> f32 {
    let all = [1.0f32, 0.75f32, 0.5f32, 0.25f32, 0.0f32, 0.25f32, 0.5f32, 0.75f32]
    if phase < 0 or phase >= 8 {
        return 1.0f32
    }
    return all[usize.wrap(phase)]
}

// `Mth.clamp(float, float, float)`: below `lo` is `lo`, and `Math.min` of the rest and `hi`.
fn clamp(v: f32, lo: f32, hi: f32) -> f32 {
    if v < lo {
        return lo
    }
    return if v <= hi { v } else { hi }
}
