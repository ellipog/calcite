/// The level a block's hooks change, as `world.block_updates` and `world.pistons` see it:
/// `BlockLevel`, whose blocks are set as vanilla's are, telling the blocks around, with the events
/// its players see; what a moving piston's block entity holds, `MovingPiston` (CAL-125); and
/// `Block.updateOrDestroy`, `Level.removeBlock` and `Level.destroyBlock`, which both read (D326,
/// D338). Its own module so the pistons, which `world.block_updates` runs, can read it too.
module world.block_level

import nbt.tag.{Tag}
import random.source.{RandomSource}
import world.level_writer.{UPDATE_LIMIT}
import worldgen.access.{BlockAccess}
import worldgen.facts.{EMPTY_FLUID, Facts}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env}

/// `levelEvent`'s types: a block broken, as `spawnDestroyParticles` sends it, with the state's
/// ID; a straw bed broken; and lava fizzing as water meets it.
pub const BLOCK_BROKEN: i32 = 2001
pub const STRAW_BED_BROKEN: i32 = 2014
pub const LAVA_FIZZ: i32 = 1501
/// `levelEvent`'s type for a redstone torch that burns out, toggled too often (CAL-116).
pub const TORCH_BURNOUT: i32 = 1502

/// `SoundSource`'s ordinals for the records' sounds, which a note block plays as, and the blocks',
/// which other blocks play as (CAL-124).
pub const SOUND_RECORDS: i32 = 2
pub const SOUND_BLOCKS: i32 = 4

/// What a moving piston's block entity, `PistonMovingBlockEntity`, holds (CAL-125): the state
/// it moves, `movedState`; the piston's facing, `direction`; whether it's pushed out or pulled
/// in, `extending`; whether it's the piston's own base or head rather than a block it moves,
/// `isSourcePiston`; how far along it is, `progress`, and was as its last tick started,
/// `progressO`, each from 0 to 1; and the game time of its last tick, `lastTicked`.
pub struct MovingPiston {
    pub moved: u32
    pub facing: i32
    pub extending: bool
    pub source: bool
    pub progress: f32 = 0.0f32
    pub progress_o: f32 = 0.0f32
    pub last_ticked: i64 = 0
}

/// A level whose blocks change as vanilla's do: set, telling the blocks around, with the events
/// its players see.
pub interface BlockLevel {
    /// `setBlock(pos, state, flags, limit)`: whether the block at `x`, `y`, `z` was set to
    /// `state`, telling the blocks around as `flags` say, the shapes `limit` deep at most.
    fn set_block_limited(mut self, x: i32, y: i32, z: i32, state: u32, flags: i32, limit: i32) -> bool
    /// `levelEvent(kind, pos, data)`: an event the players within 64 blocks of `x`, `y`, `z` are
    /// sent.
    fn level_event(mut self, kind: i32, x: i32, y: i32, z: i32, data: i32)
    /// Says once that `what` isn't in Calcite yet, and goes on without it.
    fn unimplemented(mut self, what: String)
    /// `scheduleTick(pos, fluid, delay)`: a tick of the fluid `fluid` at `x`, `y`, `z`, `delay`
    /// ticks on (D328).
    fn schedule_fluid_in(mut self, fluid: u32, x: i32, y: i32, z: i32, delay: i32)
    /// The game rule `lava_source_conversion` if `lava`, else `water_source_conversion`: whether
    /// two sources make a third between them.
    fn converts_to_source(self, lava: bool) -> bool
    /// `LavaFluid.isFastLava`: whether the level's dimension's lava is fast, `FAST_LAVA`.
    fn is_fast_lava(self) -> bool
    /// `Level.isLoaded`: whether `x`, `y`, `z` is inside the world, its height and 30,000,000
    /// blocks out, in a chunk that's there, full (D338).
    fn is_loaded(self, x: i32, y: i32, z: i32) -> bool
    /// `isInsideBuildHeight`: whether `y` is inside the world's height (D338).
    fn in_height(self, y: i32) -> bool
    /// `Level.neighborChanged(pos, block, null)`: the block at `x`, `y`, `z` told the block
    /// `source` changed, through the level's updater (D338).
    fn neighbour_changed(mut self, x: i32, y: i32, z: i32, source: u32)
    /// `Level.neighborChanged(state, pos, block, null, moved)`: the block at `x`, `y`, `z` told,
    /// as `state` rather than what's there when it runs, that `source` changed, through the
    /// level's updater, `FullNeighborUpdate` (CAL-124).
    fn neighbour_changed_as(mut self, state: u32, x: i32, y: i32, z: i32, source: u32, moved: bool)
    /// `ServerLevel.canSpreadFireAround`: whether fire spreads at `x`, `y`, `z`, anywhere or near
    /// a player, as the game rule `fire_spread_radius_around_player` says (D338).
    fn fire_spreads(self, x: i32, y: i32, z: i32) -> bool
    /// How far the sky's light is under 15, `skyDarken` (D338).
    fn sky_darken(self) -> i32
    /// Whether the dimension's water evaporates, `WATER_EVAPORATES` (D338).
    fn water_evaporates(self) -> bool
    /// The difficulty's ID, `Difficulty.getId`: 0 for peaceful to 3 for hard (D338).
    fn difficulty(self) -> i32
    /// `Level.isRaining` (D339).
    fn raining(self) -> bool
    /// `Level.isRainingAt`: whether it's raining on the block at `x`, `y`, `z` (D339).
    fn raining_at(self, x: i32, y: i32, z: i32) -> bool ! Thrown
    /// `BaseFireBlock.inPortalDimension`: whether fire in an empty frame lights a portal, as in the
    /// Overworld and the Nether (D339).
    fn portals_light(self) -> bool
    /// The name of the block tag of what fire burns on forever, the dimension type's `infiniburn`
    /// (D339).
    fn infiniburn(self) -> String
    /// `INCREASED_FIRE_BURNOUT` at the block `x`, `y`, `z`, as its biome has it (D339).
    fn fire_burnout(self, x: i32, y: i32, z: i32) -> bool
    /// `updateNeighborsAt(pos, block)`: the six around `x`, `y`, `z` told the block `source`
    /// there changed, in `UPDATE_ORDER`, as one update (CAL-116).
    fn update_neighbours(mut self, x: i32, y: i32, z: i32, source: u32)
    /// `updateNeighborsAtExceptFromFacing`: the six around `x`, `y`, `z` but the one toward
    /// `skip` told the block `source` there changed (CAL-116).
    fn update_neighbours_except(mut self, x: i32, y: i32, z: i32, source: u32, skip: i32)
    /// `LevelTicks.willTickThisTick`: whether a tick of the block `block` at `x`, `y`, `z` is
    /// among those still to run this tick (CAL-116).
    fn will_tick_this_tick(mut self, block: u32, x: i32, y: i32, z: i32) -> bool
    /// `getGameTime` (CAL-116).
    fn time_now(self) -> i64
    /// `RedstoneTorchBlock.isToggledTooFrequently`: the level's torches' recent toggles, with
    /// one at `x`, `y`, `z` now if `add`, and whether that place has 8 of them (CAL-116).
    fn torch_toggled(mut self, x: i32, y: i32, z: i32, add: bool) -> bool
    /// The torches' toggles more than 60 ticks old let go, oldest first, as `tick` lets them go
    /// as a torch's tick starts (CAL-116).
    fn forget_toggles(mut self)
    /// `ComparatorBlockEntity.setOutputSignal`: what the comparator at `x`, `y`, `z` holds set to
    /// `output`, its block entity made first where it has none, as `getBlockEntity` makes it
    /// (CAL-123).
    fn set_comparator_output(mut self, x: i32, y: i32, z: i32, output: i32)
    /// `Level.blockEvent(pos, block, b0, b1)`: the event kept for the level to run after its
    /// chunks tick, unless the same one is waiting already (CAL-125).
    fn block_event(mut self, x: i32, y: i32, z: i32, block: u32, b0: i32, b1: i32)
    /// `Level.playSound(null, pos, sound, BLOCKS, volume, pitch)`: the sound named `sound`, as
    /// `block.piston.extend`, played at the block's middle for its players near enough to hear it
    /// (CAL-125).
    fn play_sound(mut self, x: i32, y: i32, z: i32, sound: own String, volume: f32, pitch: f32)
    /// `Level.playSeededSound(null, x + 0.5, y + 0.5, z + 0.5, sound, source, volume, pitch,
    /// seed)`: as `play_sound`, among the sounds of `source`, `SoundSource`'s ordinal, with the
    /// seed given, as a note block draws it from the level's random (CAL-124).
    fn play_seeded_sound(mut self, x: i32, y: i32, z: i32, sound: own String, source: i32, volume: f32, pitch: f32, seed: i64)
    /// `BlockState.updateNeighbourShapes(level, pos, flags)`: the six around `x`, `y`, `z` told
    /// its shape is `state`'s, 512 deep at most (CAL-125).
    fn neighbour_shapes(mut self, state: u32, x: i32, y: i32, z: i32, flags: i32)
    /// `BlockState.updateIndirectNeighbourShapes(level, pos, flags)`, which only redstone wire's
    /// does anything (CAL-125).
    fn indirect_shapes(mut self, state: u32, x: i32, y: i32, z: i32, flags: i32)
    /// What the moving piston's block entity at `x`, `y`, `z` holds, if there's one (CAL-125).
    fn moving_piston(self, x: i32, y: i32, z: i32) -> MovingPiston?
    /// `setBlockEntity` of a moving piston's at `x`, `y`, `z` holding `m`, in place of what was
    /// there, ticking as `updateBlockEntityTicker` has it (CAL-125).
    fn put_moving_piston(mut self, x: i32, y: i32, z: i32, m: MovingPiston)
    /// `Level.removeBlockEntity`: the block entity at `x`, `y`, `z` taken away, with its ticker,
    /// and nothing it holds dropped (CAL-125).
    fn remove_block_entity_at(mut self, x: i32, y: i32, z: i32)
    /// `WorldBorder.isWithinBounds` of the block's column (CAL-125).
    fn in_border(self, x: i32, z: i32) -> bool
    /// `ServerLevel.isHandlingTick`: whether the level's block or fluid ticks are running
    /// (CAL-125).
    fn handling_tick(self) -> bool
    /// The value `key` of the block entity at `x`, `y`, `z` set to `value`, as its class's setter
    /// sets the field it saves as, its block entity made first where it has none, as
    /// `getBlockEntity` makes it; nothing where the block there has none (CAL-124).
    fn set_block_entity_value(mut self, x: i32, y: i32, z: i32, key: str, value: own Tag)
    /// `BlockState.affectNeighborsAfterRemoval(level, pos, moved)` of the block `old` that was at
    /// `x`, `y`, `z`, as `world.block_updates` runs it, for a piston that broke it (CAL-125).
    fn after_removal_of(mut self, old: u32, x: i32, y: i32, z: i32, moved: bool)
}

/// `Block.updateOrDestroy`: the block at `x`, `y`, `z`, `old`, made `new` as its shape changed,
/// or broken if `new` is air, with `flags` and `limit`.
pub fn update_or_destroy<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, old: u32, new: u32, x: i32, y: i32, z: i32, flags: i32, limit: i32) ! Thrown {
    if new == old {
        return
    }
    let Env { facts: f, .. } = e
    if f.is_air(new) {
        _ = try destroy_block(e, mut level, x, y, z, flags & 32 == 0, limit)
        return
    }
    _ = level.set_block_limited(x, y, z, new, flags & -33, limit)
}

/// `Level.removeBlock(pos, false)`: the block at `x`, `y`, `z` set to the fluid it held, with
/// flags 3. Whether it changed (D338).
pub fn remove_block<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let state = try level.state(f, x, y, z)
    return level.set_block_limited(x, y, z, legacy_block(f, state), 3, UPDATE_LIMIT)
}

/// `Level.destroyBlock`: the block at `x`, `y`, `z` broken, with what its players see, unless
/// it's fire, and left as the fluid it held, with what it drops if `drop`, which comes with
/// items. Whether it was broken.
pub fn destroy_block<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, x: i32, y: i32, z: i32, drop: bool, limit: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    let state = try level.state(f, x, y, z)
    if f.is_air(state) {
        return false
    }
    // `spawnDestroyParticles`, which a straw bed and fire have their own of.
    let block = f.block(state)
    if f.is_a(block, "StrawBedBlock") {
        level.level_event(STRAW_BED_BROKEN, x, y, z, i32.wrap(state))
    } else if not f.is_a(block, "BaseFireBlock") {
        level.level_event(BLOCK_BROKEN, x, y, z, i32.wrap(state))
    }
    if drop {
        level.unimplemented(String("What a broken block drops"))
    }
    return level.set_block_limited(x, y, z, legacy_block(f, state), 3, limit)
}

// `FluidState.createLegacyBlock` of the fluid the block `state` holds: air for none, a liquid's
// own state for a liquid, and a source's block for a block that holds water.
pub fn legacy_block(f: Facts, state: u32) -> u32 {
    if f.fluid(state) == EMPTY_FLUID {
        return f.ids.air_state
    }
    let block = f.block(state)
    if block == f.ids.water or block == f.ids.lava {
        return state
    }
    return if f.is_lava(state) { f.ids.lava_state } else { f.ids.water_state }
}
