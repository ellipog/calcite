/// The Overworld's custom spawners, as `MinecraftServer.createLevels` gives its level them:
/// phantoms, patrols, cats, the village siege and the wandering trader. `ServerLevel.tickCustomSpawners`
/// runs them in that order once `ServerChunkCache.tickChunks` has ticked the chunks, while
/// `spawn_mobs` is on (P6.1, D314).
///
/// Each keeps its timer and draws from the level's random as vanilla's does, as far as Calcite's
/// world has what it reads. The phantoms' look at each player, which makes them, is their level's,
/// `natural.spawn_phantoms` (CAL-200). Where a spawner goes on to something Calcite doesn't have
/// yet, it stops there:
///
/// - cats in swamp huts, found by structure pieces (CAL-309), and the trader: villages' points of
///   interest and the mobs they'd spawn. A village's cats come by its homes (CAL-201).
module world.spawners

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.taped.{TapedRandom}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The game rules the spawners read: `spawn_mobs`, `spawn_monsters`, `spawn_phantoms`,
/// `spawn_patrols` and `spawn_wandering_traders`, all on by default.
pub struct SpawnRules {
    pub mobs: bool = true
    pub monsters: bool = true
    pub phantoms: bool = true
    pub patrols: bool = true
    pub traders: bool = true
    /// `spawnEnemies`, as `updateMobSpawningFlags` last set it in each level's chunk cache from
    /// `isSpawningMonsters`, which natural spawning and the spawners read: as the server starts,
    /// and as `spawn_monsters` changes, `onGameRuleChanged`, but not as `spawn_mobs` does, so a
    /// world started without mobs spawns no monsters once they're turned on (CAL-298).
    pub spawn_enemies: bool = true
}

impl SpawnRules {
    /// `isSpawningMonsters`: `spawn_mobs` and `spawn_monsters` both on, whatever the difficulty,
    /// as what makes monsters but natural spawning and the spawners reads it, as it is now.
    pub fn enemies(self) -> bool {
        return self.mobs and self.monsters
    }

    /// `updateMobSpawningFlags`: `spawn_enemies` set from them as they are now.
    pub fn update_enemies(mut self) {
        self.spawn_enemies = self.enemies()
    }
}

/// A player as the spawners see one, and where they are.
pub struct SpawnerPlayer {
    pub spectator: bool
    pub alive: bool = true
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
    /// How long since they last rested, their `TIME_SINCE_REST` stat, which phantoms go by
    /// (CAL-200).
    pub since_rest: i32 = 0
}

/// What the spawners read of the level this tick.
pub struct SpawnerView {
    pub rules: SpawnRules
    /// The sky's darkness, `skyDarken`; whether the level's type has sky light; and
    /// `isBrightOutside`.
    pub sky_darken: i32
    pub sky_light: bool
    pub bright: bool
    /// Whether the type has a default clock that's at `minecraft:roll_village_siege`.
    pub siege_roll: bool
    /// The level's players, in the order they came into it, as `ServerLevel.players()` has them.
    pub players: List<SpawnerPlayer>
}

// `VillageSiege.State`.
enum Siege {
    Tonight
    Done
}

/// The wandering trader's saved data, `WanderingTraderData`, in the world's
/// `data/minecraft/wandering_trader.dat`.
pub struct TraderData {
    pub spawn_delay: i32 = 24000
    pub spawn_chance: i32 = 25
    /// Whether it's changed since it was saved, as `setDirty` marks it.
    pub dirty: bool = false
}

/// The saved data type the trader's data is saved as, `WanderingTraderData.TYPE`.
pub fn trader_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "wandering_trader" }
}

/// The spawners' state, of which only the trader's data is saved.
pub struct Spawners {
    phantom_next: i32 = 0
    patrol_next: i32 = 0
    cat_next: i32 = 0
    siege: Siege = Siege.Done
    siege_set_up: bool = false
    // The siege's zombies to come, `zombiesToSpawn`, the ticks till the next, `nextSpawnTime`,
    // and where they come about, `spawnX`, `spawnY` and `spawnZ` (CAL-167).
    siege_zombies: i32 = 0
    siege_next: i32 = 0
    siege_at: (i32, i32, i32) = (0, 0, 0)
    trader_delay: i32 = 1200
    /// The trader spawner's own random, made with `RandomSource.create()`, which the level's
    /// random doesn't draw for.
    trader_random: LegacyRandom
    pub trader: TraderData = TraderData()
}

impl Spawners {
    /// The spawners as the level's made: the trader's random from `trader_seed`, and its data.
    pub fn new(trader_seed: i64, trader: own TraderData) -> Spawners {
        return Spawners { trader_random: LegacyRandom.new(trader_seed), trader: trader }
    }

    /// A tick of each, in order, as `tickCustomSpawners` runs them, but for the phantoms' look at
    /// each player, which `phantoms_due` leaves to the level.
    pub fn tick(mut self, view: SpawnerView, random: mut TapedRandom) {
        _ = self.phantoms_due(view, mut random)
        self.after_phantoms(view, mut random)
    }

    /// The spawners after the phantoms', in order: the patrols', the cats', whose cat's left out,
    /// the siege's and the trader's.
    pub fn after_phantoms(mut self, view: SpawnerView, random: mut TapedRandom) {
        if self.patrols(view, mut random) != none {
            _ = patrol_offset(mut random)
        }
        _ = self.cat_due(view, mut random)
        self.after_cats(view, mut random)
    }

    /// `PatrolSpawner.tick` up to its player, after the phantoms' and before the cats': the one
    /// of `view`'s players its patrol may come by, which the level goes on with, `isCloseToVillage`
    /// and `patrol_offset` (CAL-167).
    pub fn patrols(mut self, view: SpawnerView, random: mut TapedRandom) -> usize? {
        return self.patrol(view, mut random)
    }

    /// The spawners after the cats', in order: the siege's, which sets up nowhere, and the
    /// trader's.
    pub fn after_cats(mut self, view: SpawnerView, random: mut TapedRandom) {
        _ = self.siege_rolled(view, mut random)
        self.wandering_trader(view, mut random)
    }

    /// The trader's spawner's tick, `WanderingTraderSpawner.tick`, after the siege's.
    pub fn traders(mut self, view: SpawnerView, random: mut TapedRandom) {
        self.wandering_trader(view, mut random)
    }

    /// `PhantomSpawner.tick` up to its players: once a minute or two, its next time drawn, whether
    /// it's at least 5 darker than full light, or the level has no sky light, so that the level
    /// looks at each player, `natural.spawn_phantoms` (CAL-200).
    pub fn phantoms_due(mut self, view: SpawnerView, random: mut TapedRandom) -> bool {
        if not view.rules.spawn_enemies or not view.rules.phantoms {
            return false
        }
        self.phantom_next -= 1
        if self.phantom_next > 0 {
            return false
        }
        self.phantom_next += (60 + random.next_int_below(60)) * 20
        return view.sky_darken >= 5 or not view.sky_light
    }

    // `PatrolSpawner.tick`: every ten minutes or so, by day, one in five times, at a random
    // player's.
    fn patrol(mut self, view: SpawnerView, random: mut TapedRandom) -> usize? {
        if not view.rules.spawn_enemies or not view.rules.patrols {
            return none
        }
        self.patrol_next -= 1
        if self.patrol_next > 0 {
            return none
        }
        self.patrol_next += 12000 + random.next_int_below(1200)
        if not view.bright {
            return none
        }
        if random.next_int_below(5) != 0 {
            return none
        }
        let count = view.players.len()
        if count < 1 {
            return none
        }
        let i = usize.wrap(random.next_int_below(i32.wrap(count)))
        if view.players[i].spectator {
            return none
        }
        return some(i)
    }

    /// `CatSpawner.tick` up to its place (CAL-201): once a minute, a random living player's,
    /// `getRandomPlayer`, then 8 to 31 blocks off each way across, drawn, where a cat may come,
    /// which the level looks at, `spawn_cat`, as it reads the village and the cats there.
    pub fn cat_due(mut self, view: SpawnerView, random: mut TapedRandom) -> (i32, i32, i32)? {
        self.cat_next -= 1
        if self.cat_next > 0 {
            return none
        }
        self.cat_next = 1200
        let i = pick_player(view, mut random) else return none
        let p = view.players[i]
        let dx = (8 + random.next_int_below(24)) * sign(mut random)
        let dz = (8 + random.next_int_below(24)) * sign(mut random)
        return some((i32.saturate(p.x.floor()) + dx, i32.saturate(p.y.floor()), i32.saturate(p.z.floor()) + dz))
    }

    /// `VillageSiege.tick` up to its setting up: at night, rolled once a night at the default
    /// clock's `roll_village_siege`, one in ten; by day, or without monsters, done and not set up.
    /// Whether there's a siege tonight, which the level sets up, `set_up_siege`, and spawns,
    /// `siege_spawn_due` (CAL-167).
    pub fn siege_rolled(mut self, view: SpawnerView, random: mut TapedRandom) -> bool {
        if view.bright or not view.rules.spawn_enemies {
            self.siege = Siege.Done
            self.siege_set_up = false
            return false
        }
        if view.siege_roll {
            self.siege = if random.next_int_below(10) == 0 { Siege.Tonight } else { Siege.Done }
        }
        return self.siege != Siege.Done
    }

    /// Whether tonight's siege is set up, `hasSetupSiege` (CAL-167).
    pub fn siege_is_set_up(self) -> bool {
        return self.siege_set_up
    }

    /// `tryToSetupSiege` having passed (CAL-167): set up about `at`, its last try; where that was
    /// a place its zombies may come, `found`, 20 to come from now.
    pub fn set_up_siege(mut self, at: (i32, i32, i32)?, found: bool) {
        self.siege_set_up = true
        if let p = at {
            self.siege_at = p
        }
        if found {
            self.siege_next = 0
            self.siege_zombies = 20
        }
    }

    /// Where the siege's zombies come about, `spawnX`, `spawnY` and `spawnZ` (CAL-167).
    pub fn siege_place(self) -> (i32, i32, i32) {
        return self.siege_at
    }

    /// The set up siege's tick (CAL-167): every third, a zombie where any are left to come,
    /// which the level tries to make, else the siege done.
    pub fn siege_spawn_due(mut self) -> bool {
        if self.siege_next > 0 {
            self.siege_next -= 1
            return false
        }
        self.siege_next = 2
        if self.siege_zombies > 0 {
            self.siege_zombies -= 1
            return true
        }
        self.siege = Siege.Done
        return false
    }

    // `WanderingTraderSpawner.tick`: once a minute the saved delay goes down, and once it's
    // out, the trader may come, by its own random.
    fn wandering_trader(mut self, view: SpawnerView, random: mut TapedRandom) {
        if not view.rules.traders {
            return
        }
        self.trader_delay -= 1
        if self.trader_delay > 0 {
            return
        }
        self.trader_delay = 1200
        let delay = self.trader.spawn_delay - 1200
        self.trader.set_delay(delay)
        if delay > 0 {
            return
        }
        self.trader.set_delay(24000)
        let chance = self.trader.spawn_chance
        self.trader.set_chance(clamp(chance + 25, 25, 75))
        if self.trader_random.next_int_below(100) > chance {
            return
        }
        // `spawn`: with no living player it's done, and the chance starts again; with one, its
        // own random draws, then it needs a place by a meeting point, which comes with points
        // of interest.
        if not random_player(view, mut random) {
            self.trader.set_chance(25)
            return
        }
        _ = self.trader_random.next_int_below(10)
    }
}

impl TraderData {
    /// The data in the saved data's `root`, as `WanderingTraderData.CODEC` reads it, keeping what
    /// it could read, as `resultOrPartial` does. A field that isn't a number is its default, and
    /// the errors are joined the last field's first.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> TraderData {
        if not root.contains("data") {
            lines.push(parse_failed(trader_id(), String("Not a map: null")))
            return TraderData()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(trader_id(), "Not a map: {root["data"].to_snbt()}"))
                return TraderData()
            },
        }
        var errors = List<String>()
        var out = TraderData()
        if data.contains("spawn_delay") {
            match data["spawn_delay"].number_int() {
                some(v) => out.spawn_delay = v,
                none => errors.insert(0, String("Not a number")),
            }
        }
        if data.contains("spawn_chance") {
            match data["spawn_chance"].number_int() {
                some(v) => out.spawn_chance = v,
                none => errors.insert(0, String("Not a number")),
            }
        }
        if not errors.is_empty() {
            var message = String()
            for e in errors {
                if not message.is_empty() {
                    message.push_str("; ")
                }
                message.push_str(e)
            }
            lines.push(parse_failed(trader_id(), message))
        }
        return out
    }

    /// The data as `WanderingTraderData.CODEC` writes it.
    pub fn pack(self) -> Tag {
        var fields = JavaHashMap<String, Tag>()
        fields.insert(String("spawn_delay"), Tag.Int(self.spawn_delay))
        fields.insert(String("spawn_chance"), Tag.Int(self.spawn_chance))
        return Tag.Compound(fields)
    }

    // `setSpawnDelay` and `setSpawnChance`, which mark it to be saved if it changes.
    fn set_delay(mut self, v: i32) {
        if self.spawn_delay != v {
            self.spawn_delay = v
            self.dirty = true
        }
    }

    fn set_chance(mut self, v: i32) {
        if self.spawn_chance != v {
            self.spawn_chance = v
            self.dirty = true
        }
    }
}

// `ServerLevel.getRandomPlayer`: one of the living players, drawn, or none.
fn random_player(view: SpawnerView, random: mut TapedRandom) -> bool {
    var alive = 0
    for p in view.players {
        if p.alive {
            alive += 1
        }
    }
    if alive == 0 {
        return false
    }
    _ = random.next_int_below(alive)
    return true
}

// `getRandomPlayer`: one of the living players, in the level's order, drawn; none where none
// lives (CAL-201).
fn pick_player(view: SpawnerView, random: mut TapedRandom) -> usize? {
    var alive = List<usize>()
    for i in 0..view.players.len() {
        if view.players[i].alive {
            alive.push(i)
        }
    }
    if alive.is_empty() {
        return none
    }
    return some(alive[usize.wrap(random.next_int_below(i32.wrap(alive.len())))])
}

// `random.nextBoolean() ? -1 : 1`.
/// The patrol's place off its player's block, 24 to 47 blocks out each way, east or west and
/// then south or north, drawn (CAL-167).
pub fn patrol_offset(random: mut TapedRandom) -> (i32, i32) {
    let dx = (24 + random.next_int_below(24)) * sign(mut random)
    let dz = (24 + random.next_int_below(24)) * sign(mut random)
    return (dx, dz)
}

fn sign(random: mut TapedRandom) -> i32 {
    return if random.next_boolean() { -1 } else { 1 }
}

fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}
