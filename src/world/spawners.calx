/// The Overworld's custom spawners, as `MinecraftServer.createLevels` gives its level them:
/// phantoms, patrols, cats, the village siege and the wandering trader. `ServerLevel.tickCustomSpawners`
/// runs them in that order once `ServerChunkCache.tickChunks` has ticked the chunks, while
/// `spawn_mobs` is on (P6.1, D314).
///
/// Each keeps its timer and draws from the level's random as vanilla's does, as far as Calcite's
/// world has what it reads. Where a spawner goes on to something Calcite doesn't have yet, it
/// stops there:
///
/// - phantoms, at a player at night: whether the sky's open above them, the chunk's inhabited
///   time and their time since they last slept come with light, the chunks' tick and stats;
/// - patrols, once the early game's over: the biomes' say in `can_pillager_patrol_spawn`, and the
///   pillagers;
/// - cats, the siege and the trader: villages' points of interest and swamp huts, and the mobs
///   they'd spawn.
module world.spawners

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.taped.{TapedRandom}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The game rules the spawners read: `spawn_mobs`, `spawn_monsters`, `spawn_phantoms`,
/// `spawn_patrols` and `spawn_wandering_traders`, all on by default.
pub struct SpawnRules {
    pub mobs: bool = true
    pub monsters: bool = true
    pub phantoms: bool = true
    pub patrols: bool = true
    pub traders: bool = true
}

impl SpawnRules {
    /// `spawnEnemies`, as `updateMobSpawningFlags` sets it in each level's chunk cache from
    /// `isSpawningMonsters`: `spawn_mobs` and `spawn_monsters` both on, whatever the difficulty.
    pub fn enemies(self) -> bool {
        return self.mobs and self.monsters
    }
}

/// A player as the spawners see one, and where they are.
pub struct SpawnerPlayer {
    pub spectator: bool
    pub alive: bool = true
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
}

/// What the spawners read of the level this tick.
pub struct SpawnerView {
    pub rules: SpawnRules
    /// The sky's darkness, `skyDarken`; whether the level's type has sky light; and
    /// `isBrightOutside`.
    pub sky_darken: i32
    pub sky_light: bool
    pub bright: bool
    /// Whether the type has a default clock that's at `minecraft:roll_village_siege`.
    pub siege_roll: bool
    /// The level's players, in the order they came into it, as `ServerLevel.players()` has them.
    pub players: List<SpawnerPlayer>
}

// `VillageSiege.State`.
enum Siege {
    Tonight
    Done
}

/// The wandering trader's saved data, `WanderingTraderData`, in the world's
/// `data/minecraft/wandering_trader.dat`.
pub struct TraderData {
    pub spawn_delay: i32 = 24000
    pub spawn_chance: i32 = 25
    /// Whether it's changed since it was saved, as `setDirty` marks it.
    pub dirty: bool = false
}

/// The saved data type the trader's data is saved as, `WanderingTraderData.TYPE`.
pub fn trader_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "wandering_trader" }
}

/// The spawners' state, of which only the trader's data is saved.
pub struct Spawners {
    phantom_next: i32 = 0
    patrol_next: i32 = 0
    cat_next: i32 = 0
    siege: Siege = Siege.Done
    siege_set_up: bool = false
    trader_delay: i32 = 1200
    /// The trader spawner's own random, made with `RandomSource.create()`, which the level's
    /// random doesn't draw for.
    trader_random: LegacyRandom
    pub trader: TraderData = TraderData()
}

impl Spawners {
    /// The spawners as the level's made: the trader's random from `trader_seed`, and its data.
    pub fn new(trader_seed: i64, trader: own TraderData) -> Spawners {
        return Spawners { trader_random: LegacyRandom.new(trader_seed), trader: trader }
    }

    /// A tick of each, in order, as `tickCustomSpawners` runs them.
    pub fn tick(mut self, view: SpawnerView, random: mut TapedRandom) {
        self.phantom(view, mut random)
        self.patrol(view, mut random)
        self.cat(view, mut random)
        self.village_siege(view, mut random)
        self.wandering_trader(view, mut random)
    }

    // `PhantomSpawner.tick`: once a minute or two, while it's at least 5 darker than full
    // light under a sky.
    fn phantom(mut self, view: SpawnerView, random: mut TapedRandom) {
        if not view.rules.enemies() or not view.rules.phantoms {
            return
        }
        self.phantom_next -= 1
        if self.phantom_next > 0 {
            return
        }
        self.phantom_next += (60 + random.next_int_below(60)) * 20
        if view.sky_darken < 5 and view.sky_light {
            return
        }
        // Each player not spectating, above the sea with the sky open over them, has a chance
        // from the difficulty where they stand and from how long since they slept. Those come
        // with light, the chunks' inhabited time and stats.
    }

    // `PatrolSpawner.tick`: every ten minutes or so, by day, one in five times, at a random
    // player's.
    fn patrol(mut self, view: SpawnerView, random: mut TapedRandom) {
        if not view.rules.enemies() or not view.rules.patrols {
            return
        }
        self.patrol_next -= 1
        if self.patrol_next > 0 {
            return
        }
        self.patrol_next += 12000 + random.next_int_below(1200)
        if not view.bright {
            return
        }
        if random.next_int_below(5) != 0 {
            return
        }
        let count = view.players.len()
        if count < 1 {
            return
        }
        if view.players[usize.wrap(random.next_int_below(i32.wrap(count)))].spectator {
            return
        }
        // `isCloseToVillage(pos, 2)` reads villages' points of interest, of which there are
        // none yet. Then the patrol's place, 24 to 47 blocks out each way.
        let dx = (24 + random.next_int_below(24)) * sign(mut random)
        let dz = (24 + random.next_int_below(24)) * sign(mut random)
        _ = (dx, dz)
        // Then `hasChunksAt` around it and `can_pillager_patrol_spawn` there: false through the
        // early game whatever the biome, so nothing more is drawn. After it, the biome's say and
        // the pillagers come with the biomes' layer and the mobs.
    }

    // `CatSpawner.tick`: once a minute, around a random living player.
    fn cat(mut self, view: SpawnerView, random: mut TapedRandom) {
        self.cat_next -= 1
        if self.cat_next > 0 {
            return
        }
        self.cat_next = 1200
        if not random_player(view, mut random) {
            return
        }
        let dx = (8 + random.next_int_below(24)) * sign(mut random)
        let dz = (8 + random.next_int_below(24)) * sign(mut random)
        _ = (dx, dz)
        // A cat comes only in a village or a swamp hut, found by points of interest and structure
        // pieces, which come later.
    }

    // `VillageSiege.tick`: at night, rolled once a night at the default clock's
    // `roll_village_siege`.
    fn village_siege(mut self, view: SpawnerView, random: mut TapedRandom) {
        if view.bright or not view.rules.enemies() {
            self.siege = Siege.Done
            self.siege_set_up = false
            return
        }
        if view.siege_roll {
            self.siege = if random.next_int_below(10) == 0 { Siege.Tonight } else { Siege.Done }
        }
        if self.siege == Siege.Done {
            return
        }
        // `tryToSetupSiege` needs a player in a village, which comes with points of interest, so
        // it isn't set up and draws nothing.
    }

    // `WanderingTraderSpawner.tick`: once a minute the saved delay goes down, and once it's
    // out, the trader may come, by its own random.
    fn wandering_trader(mut self, view: SpawnerView, random: mut TapedRandom) {
        if not view.rules.traders {
            return
        }
        self.trader_delay -= 1
        if self.trader_delay > 0 {
            return
        }
        self.trader_delay = 1200
        let delay = self.trader.spawn_delay - 1200
        self.trader.set_delay(delay)
        if delay > 0 {
            return
        }
        self.trader.set_delay(24000)
        let chance = self.trader.spawn_chance
        self.trader.set_chance(clamp(chance + 25, 25, 75))
        if self.trader_random.next_int_below(100) > chance {
            return
        }
        // `spawn`: with no living player it's done, and the chance starts again; with one, its
        // own random draws, then it needs a place by a meeting point, which comes with points
        // of interest.
        if not random_player(view, mut random) {
            self.trader.set_chance(25)
            return
        }
        _ = self.trader_random.next_int_below(10)
    }
}

impl TraderData {
    /// The data in the saved data's `root`, as `WanderingTraderData.CODEC` reads it, keeping what
    /// it could read, as `resultOrPartial` does. A field that isn't a number is its default, and
    /// the errors are joined the last field's first.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> TraderData {
        if not root.contains("data") {
            lines.push(parse_failed(trader_id(), String("Not a map: null")))
            return TraderData()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(trader_id(), "Not a map: {root["data"].to_snbt()}"))
                return TraderData()
            },
        }
        var errors = List<String>()
        var out = TraderData()
        if data.contains("spawn_delay") {
            match data["spawn_delay"].number_int() {
                some(v) => out.spawn_delay = v,
                none => errors.insert(0, String("Not a number")),
            }
        }
        if data.contains("spawn_chance") {
            match data["spawn_chance"].number_int() {
                some(v) => out.spawn_chance = v,
                none => errors.insert(0, String("Not a number")),
            }
        }
        if not errors.is_empty() {
            var message = String()
            for e in errors {
                if not message.is_empty() {
                    message.push_str("; ")
                }
                message.push_str(e)
            }
            lines.push(parse_failed(trader_id(), message))
        }
        return out
    }

    /// The data as `WanderingTraderData.CODEC` writes it.
    pub fn pack(self) -> Tag {
        var fields = JavaHashMap<String, Tag>()
        fields.insert(String("spawn_delay"), Tag.Int(self.spawn_delay))
        fields.insert(String("spawn_chance"), Tag.Int(self.spawn_chance))
        return Tag.Compound(fields)
    }

    // `setSpawnDelay` and `setSpawnChance`, which mark it to be saved if it changes.
    fn set_delay(mut self, v: i32) {
        if self.spawn_delay != v {
            self.spawn_delay = v
            self.dirty = true
        }
    }

    fn set_chance(mut self, v: i32) {
        if self.spawn_chance != v {
            self.spawn_chance = v
            self.dirty = true
        }
    }
}

// `ServerLevel.getRandomPlayer`: one of the living players, drawn, or none.
fn random_player(view: SpawnerView, random: mut TapedRandom) -> bool {
    var alive = 0
    for p in view.players {
        if p.alive {
            alive += 1
        }
    }
    if alive == 0 {
        return false
    }
    _ = random.next_int_below(alive)
    return true
}

// `random.nextBoolean() ? -1 : 1`.
fn sign(random: mut TapedRandom) -> i32 {
    return if random.next_boolean() { -1 } else { 1 }
}

fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    return if v < lo { lo } else if v > hi { hi } else { v }
}
