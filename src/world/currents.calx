/// What fluids do to an entity in them, as vanilla's `EntityFluidInteraction` finds it (CAL-148):
/// how deep the entity is in water and in lava, and the current each pushes it with, summed over
/// the fluid blocks its box is in, each block's `FlowingFluid.getFlow`.
///
/// The box is the entity's, 0.001 smaller on every side, and the blocks it's in are gone through x
/// first, then y, then z, as vanilla does: the order matters, as a block's flow is scaled down by
/// the depth found so far while that's less than 0.4. Where a chunk within a block of the box
/// isn't loaded the entity is in no fluid, as `hasFluidAndLoaded` says.
module world.currents

import world.collision.{Aabb, CollisionBlocks}
import world.flowing.{Liquid, liquid_of}
import worldgen.facts.{BlockSet, EMPTY_FLUID, FLOWING_LAVA, FULL, Facts, LAVA_FLUID, horizontal, step_x, step_z}

/// A fluid's current on an entity, `CurrentAccumulator`: the flows of the blocks of it the entity
/// is in, summed, and how many.
pub struct Current {
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub z: f64 = 0.0
    pub count: i32 = 0
    // The depth found so far, which scales a block's flow while it's less than 0.4.
    height: f64 = 0.0
}

/// The fluids an entity is in: whether it's in any, how deep it's in water and in lava,
/// `getFluidHeight`, from its feet to the highest top of each it's in, and their currents.
pub struct InFluids {
    pub any: bool = false
    pub water: f64 = 0.0
    pub lava: f64 = 0.0
    pub water_current: Current = Current()
    pub lava_current: Current = Current()
}

/// What `blocks` hold that fluids flow by: the blocks of the tag `blocks_fluid_flow`, which a fluid
/// doesn't look past to the block below.
pub struct FlowFacts {
    pub blockers: BlockSet
}

impl FlowFacts {
    /// The blockers as `f`'s tags have them.
    pub fn new(f: Facts) -> FlowFacts {
        return FlowFacts { blockers: f.tag_or_empty(String("minecraft:blocks_fluid_flow")) }
    }
}

/// The fluids the entity whose box is `b` is in, `EntityFluidInteraction.update`, with their
/// currents unless `still`, as for an entity fluids don't push.
pub fn fluids_at<B: CollisionBlocks>(f: Facts, w: FlowFacts, blocks: B, b: Aabb, still: bool) -> InFluids {
    var out = InFluids()
    let inner = b.deflate(0.001)
    let x0 = i32.saturate(inner.min_x.floor())
    let y0 = i32.saturate(inner.min_y.floor())
    let z0 = i32.saturate(inner.min_z.floor())
    let x1 = i32.saturate(inner.max_x.ceil()) - 1
    let y1 = i32.saturate(inner.max_y.ceil()) - 1
    let z1 = i32.saturate(inner.max_z.ceil()) - 1
    // `hasFluidAndLoaded`: nothing unless every chunk within a block of the box is loaded. Its
    // sections having no fluid is only a shortcut: the box would find none in them.
    for cz in (z0 - 1) >> 4..=(z1 + 1) >> 4 {
        for cx in (x0 - 1) >> 4..=(x1 + 1) >> 4 {
            if blocks.collision_state(cx * 16, y0, cz * 16) == none {
                return out
            }
        }
    }
    let feet = b.min_y
    for x in x0..=x1 {
        for y in y0..=y1 {
            for z in z0..=z1 {
                let state = blocks.collision_state(x, y, z) ?? 0
                let l = liquid_of(f, state)
                if l.fluid == EMPTY_FLUID {
                    continue
                }
                let bottom = f64(y)
                let top = bottom + f64(height(f, blocks, l, x, y, z))
                if top < inner.min_y {
                    continue
                }
                out.any = true
                let lava = is_lava(l.fluid)
                let depth = top - feet
                if lava {
                    out.lava = max(depth, out.lava)
                } else {
                    out.water = max(depth, out.water)
                }
                if still {
                    continue
                }
                let (fx, fy, fz) = flow(f, w, blocks, l, x, y, z)
                if lava {
                    add_flow(mut out.lava_current, out.lava, fx, fy, fz)
                } else {
                    add_flow(mut out.water_current, out.water, fx, fy, fz)
                }
            }
        }
    }
    return out
}

// `CurrentAccumulator.accumulate`, with the depth found so far, which scales the flow while it's
// less than 0.4.
fn add_flow(c: mut Current, depth: f64, fx: f64, fy: f64, fz: f64) {
    c.height = max(depth, c.height)
    var x = fx
    var y = fy
    var z = fz
    if c.height < 0.4 {
        x = x * c.height
        y = y * c.height
        z = z * c.height
    }
    c.x = c.x + x
    c.y = c.y + y
    c.z = c.z + z
    c.count += 1
}

/// The motion vx, vy, vz with the current `c` added at `scale`, `CurrentAccumulator.applyTo`: its
/// direction for anything but a player, its mean for a player, and at least 0.0045 for something
/// moving less than 0.003 across, with no current too slight to count.
pub fn push(c: Current, scale: f64, player: bool, vx: f64, vy: f64, vz: f64) -> (f64, f64, f64) {
    if c.count == 0 or c.x * c.x + c.y * c.y + c.z * c.z < f64(1.0e-5f32) {
        return (vx, vy, vz)
    }
    var (ix, iy, iz) = if player {
        let inv = 1.0 / f64(c.count)
        (c.x * inv, c.y * inv, c.z * inv)
    } else {
        normalize(c.x, c.y, c.z)
    }
    ix = ix * scale
    iy = iy * scale
    iz = iz * scale
    if vx.abs() < 0.003 and vz.abs() < 0.003 and (ix * ix + iy * iy + iz * iz).sqrt() < 0.0045000000000000005 {
        let (nx, ny, nz) = normalize(ix, iy, iz)
        ix = nx * 0.0045000000000000005
        iy = ny * 0.0045000000000000005
        iz = nz * 0.0045000000000000005
    }
    return (vx + ix, vy + iy, vz + iz)
}

/// `Vec3.normalize`: the direction, or nothing for a vector shorter than 1.0E-5F.
pub fn normalize(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let d = (x * x + y * y + z * z).sqrt()
    if d < f64(1.0e-5f32) {
        return (0.0, 0.0, 0.0)
    }
    return (x / d, y / d, z / d)
}

/// How far up its block the fluid `l` at x, y, z comes, `FlowingFluid.getHeight`: all the way with
/// the same fluid above, else its amount in ninths.
pub fn height<B: CollisionBlocks>(f: Facts, blocks: B, l: Liquid, x: i32, y: i32, z: i32) -> f32 {
    let above = liquid_of(f, blocks.collision_state(x, y + 1, z) ?? 0)
    if same(l.fluid, above.fluid) {
        return 1.0f32
    }
    return own_height(l)
}

/// `FlowingFluid.getFlow`: which way the fluid `l` at x, y, z flows, from how much less of it,
/// or of it below an empty block beside, there is to each side, and down if it's falling beside a
/// face it can't pass, a unit vector or nothing.
pub fn flow<B: CollisionBlocks>(f: Facts, w: FlowFacts, blocks: B, l: Liquid, x: i32, y: i32, z: i32) -> (f64, f64, f64) {
    var fx = 0.0
    var fz = 0.0
    let mine = own_height(l)
    for i in 0..4 {
        let d = horizontal(i)
        let nx = x + step_x(d)
        let nz = z + step_z(d)
        let beside = blocks.collision_state(nx, y, nz) ?? 0
        let n = liquid_of(f, beside)
        if not affects(l, n) {
            continue
        }
        var nh = own_height(n)
        var distance = 0.0f32
        if nh == 0.0f32 {
            if not f.in_set(beside, w.blockers) {
                let below = liquid_of(f, blocks.collision_state(nx, y - 1, nz) ?? 0)
                if affects(l, below) {
                    nh = own_height(below)
                    if nh > 0.0f32 {
                        distance = mine - (nh - 0.8888889f32)
                    }
                }
            }
        } else if nh > 0.0f32 {
            distance = mine - nh
        }
        if distance != 0.0f32 {
            fx = fx + f64(f32.nearest(step_x(d)) * distance)
            fz = fz + f64(f32.nearest(step_z(d)) * distance)
        }
    }
    var vx = fx
    var vy = 0.0
    var vz = fz
    if l.falling {
        for i in 0..4 {
            let d = horizontal(i)
            let nx = x + step_x(d)
            let nz = z + step_z(d)
            if solid_face(f, blocks, l, nx, y, nz, d) or solid_face(f, blocks, l, nx, y + 1, nz, d) {
                let (ax, ay, az) = normalize(vx, vy, vz)
                vx = ax + 0.0
                vy = ay + -6.0
                vz = az + 0.0
                break
            }
        }
    }
    return normalize(vx, vy, vz)
}

// `FlowingFluid.isSolidFace` toward `d`, a side: not where the same fluid is, nor ice, else
// whether the block's face toward `d` is sturdy.
fn solid_face<B: CollisionBlocks>(f: Facts, blocks: B, l: Liquid, x: i32, y: i32, z: i32, d: i32) -> bool {
    let state = blocks.collision_state(x, y, z) ?? 0
    if same(l.fluid, f.fluid(state)) {
        return false
    }
    if f.is_a(f.block(state), String("IceBlock")) {
        return false
    }
    return f.sturdy(state, d, FULL)
}

// `affectsFlow`: no fluid, or the same one.
fn affects(l: Liquid, n: Liquid) -> bool {
    return n.fluid == EMPTY_FLUID or same(l.fluid, n.fluid)
}

// `getOwnHeight`: the amount in ninths, a float.
fn own_height(l: Liquid) -> f32 {
    if l.fluid == EMPTY_FLUID {
        return 0.0f32
    }
    return f32.nearest(l.amount) / 9.0f32
}

// `Fluid.isSame`: water and flowing water are the same, as are lava and flowing lava.
fn same(a: u32, b: u32) -> bool {
    if a == EMPTY_FLUID or b == EMPTY_FLUID {
        return a == b
    }
    return is_lava(a) == is_lava(b)
}

fn is_lava(fluid: u32) -> bool {
    return fluid == LAVA_FLUID or fluid == FLOWING_LAVA
}

fn max(a: f64, b: f64) -> f64 {
    return if a > b { a } else { b }
}
