/// What a comparator reads of the block behind it (CAL-123): `BlockState.getAnalogOutputSignal`,
/// as the class that declares it for each block has it, from the block's state and from its block
/// entity as it saves. A block entity a block should have and doesn't yet reads as a fresh one,
/// as `Level.getBlockEntity` makes it. What the outputs read that Calcite doesn't have yet throws
/// `Unimplemented`: entities, a book's pages, a disc's song, a creaking, and the loot a container
/// makes as it's first looked into.
module world.analog_output

import nbt.tag.{Tag}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, clockwise, opposite, step_x, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{facing_of}

/// `BlockState.getAnalogOutputSignal`: what a comparator reads of `state`, at x, y, z, from the
/// side `d`, the way from the block toward the comparator.
pub fn analog_output<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32, d: i32) -> i32 ! Thrown {
    let block = f.block(state)
    let kind = f.analog_class(block)
    if kind == "BlockBehaviour" {
        // An empty cauldron's, `AbstractCauldronBlock`'s, which has one but declares none.
        return 0
    }
    // Those of the state alone.
    if kind == "CakeBlock" {
        return (7 - (f.get_int(state, String("bites")) ?? 0)) * 2
    }
    if kind == "CandleCakeBlock" {
        return 14
    }
    if kind == "ComposterBlock" or kind == "LayeredCauldronBlock" {
        return f.get_int(state, String("level")) ?? 0
    }
    if kind == "LavaCauldronBlock" {
        return 3
    }
    if kind == "BeehiveBlock" {
        return f.get_int(state, String("honey_level")) ?? 0
    }
    if kind == "EndPortalFrameBlock" {
        return if f.get_bool(state, String("eye")) { 15 } else { 0 }
    }
    if kind == "RespawnAnchorBlock" {
        // `getScaledChargeLevel`, in floats.
        let charges = f32.nearest(f.get_int(state, String("charges")) ?? 0)
        return floor_f32(charges / 4.0 * 15.0)
    }
    if kind == "CopperBulbBlock" {
        // Lit, as the block there is now.
        return if f.get_bool(try r.state(f, x, y, z), String("lit")) { 15 } else { 0 }
    }
    if kind == "CopperGolemStatueBlock" {
        return pose_of(f, state) + 1
    }
    if kind == "DetectorRailBlock" {
        if f.get_bool(state, String("powered")) {
            fail unimplemented("What a comparator reads of a detector rail a minecart's on")
        }
        return 0
    }
    if kind == "LecternBlock" {
        if f.get_bool(state, String("has_book")) {
            fail unimplemented("What a comparator reads of a lectern's book")
        }
        return 0
    }
    if kind == "CreakingHeartBlock" {
        if (f.get_name(state, String("creaking_heart_state")) ?? String()) == "uprooted" {
            return 0
        }
        fail unimplemented("What a comparator reads of a creaking heart, its creaking")
    }
    // Those of the block entity.
    let tags = own_block_entity(f, r, block, x, y, z)
    if kind == "ChestBlock" {
        return try chest_output(f, r, state, x, y, z, tags)
    }
    if kind == "AbstractFurnaceBlock" or kind == "BarrelBlock" or kind == "BrewingStandBlock" or kind == "DispenserBlock" or kind == "HopperBlock" or kind == "ShulkerBoxBlock" or kind == "DecoratedPotBlock" {
        // `getRedstoneSignalFromBlockEntity`, of a container.
        let size = container_size(f.block_entity_kind(block) ?? String())
        if size == 0 {
            return 0
        }
        try check_loot(tags)
        var stacks = Stacks.of(size)
        stacks.add(f, tags, 0, size)
        return stacks.signal()
    }
    if kind == "CrafterBlock" {
        // `CrafterBlockEntity.getRedstoneSignal`: its slots that hold something or are disabled.
        try check_loot(tags)
        var stacks = Stacks.of(9)
        stacks.add(f, tags, 0, 9)
        var disabled = List<bool>()
        for _ in 0..9 {
            disabled.push(false)
        }
        if tags.contains("disabled_slots") {
            match tags["disabled_slots"] {
                Tag.IntArray(slots) => {
                    for s in slots {
                        if s >= 0 and s < 9 {
                            disabled[usize.wrap(s)] = true
                        }
                    }
                },
                _ => {},
            }
        }
        var n = 0
        for i in 0..9 {
            if stacks.filled[usize.wrap(i)] or disabled[usize.wrap(i)] {
                n += 1
            }
        }
        return n
    }
    if kind == "ChiseledBookShelfBlock" {
        return (int_at(tags, "last_interacted_slot") ?? -1) + 1
    }
    if kind == "CommandBlock" {
        return int_at(tags, "SuccessCount") ?? 0
    }
    if kind == "SculkSensorBlock" {
        if (f.get_name(state, String("sculk_sensor_phase")) ?? String()) != "active" {
            return 0
        }
        return int_at(tags, "last_vibration_frequency") ?? 0
    }
    if kind == "ShelfBlock" {
        // Read from in front alone: a bit for each of its three slots that holds something.
        if d != opposite(try facing_of(f, state)) {
            return 0
        }
        var stacks = Stacks.of(3)
        stacks.add(f, tags, 0, 3)
        var bits = 0
        for i in 0..3 {
            if stacks.filled[usize.wrap(i)] {
                bits = bits | (1 << i)
            }
        }
        return bits
    }
    if kind == "JukeboxBlock" {
        if tags.contains("RecordItem") {
            fail unimplemented("What a comparator reads of a jukebox's disc, its song")
        }
        return 0
    }
    fail unimplemented("What a comparator reads of {kind}")
}

// `ChestBlock.getContainer`, not ignoring what blocks it, and `getRedstoneSignalFromContainer` of
// it: none where it's blocked; of the two chests where it's half of one,
// `DoubleBlockCombiner.combineWithNeigbour`, the right half's slots first, unless the other half
// is blocked; else of its own.
fn chest_output<R: BlockAccess>(f: Facts, r: R, state: u32, x: i32, y: i32, z: i32, tags: JavaHashMap<String, Tag>) -> i32 ! Thrown {
    if try chest_blocked(f, r, x, y, z) {
        return 0
    }
    let kind = f.get_name(state, String("type")) ?? String("single")
    var stacks = Stacks.of(27)
    if kind != "single" {
        let facing = try facing_of(f, state)
        let toward = if kind == "left" { clockwise(facing) } else { opposite(clockwise(facing)) }
        let (ox, oz) = (x + step_x(toward), z + step_z(toward))
        let other = try r.state(f, ox, y, oz)
        let other_kind = f.get_name(other, String("type")) ?? String("single")
        if f.block(other) == f.block(state) and other_kind != "single" and other_kind != kind and try facing_of(f, other) == facing {
            if try chest_blocked(f, r, ox, y, oz) {
                return 0
            }
            let other_tags = own_block_entity(f, r, f.block(other), ox, y, oz)
            try check_loot(tags)
            try check_loot(other_tags)
            stacks = Stacks.of(54)
            if kind == "right" {
                stacks.add(f, tags, 0, 27)
                stacks.add(f, other_tags, 27, 27)
            } else {
                stacks.add(f, other_tags, 0, 27)
                stacks.add(f, tags, 27, 27)
            }
            return stacks.signal()
        }
    }
    try check_loot(tags)
    stacks.add(f, tags, 0, 27)
    return stacks.signal()
}

// `ChestBlock.isChestBlockedAt`: a redstone conductor above it, `isBlockedChestByBlock`. A cat
// sitting on it, `isCatSittingOnChest`, is an entity, which Calcite's level doesn't have yet.
fn chest_blocked<R: BlockAccess>(f: Facts, r: R, x: i32, y: i32, z: i32) -> bool ! Thrown {
    return f.redstone_conductor(try r.state(f, x, y + 1, z))
}

// `getContainerSize` of the containers whose output is `getRedstoneSignalFromBlockEntity`'s, by
// their block entity's type.
fn container_size(kind: String) -> usize {
    if kind == "minecraft:furnace" or kind == "minecraft:blast_furnace" or kind == "minecraft:smoker" {
        return 3
    }
    if kind == "minecraft:barrel" or kind == "minecraft:shulker_box" {
        return 27
    }
    if kind == "minecraft:brewing_stand" or kind == "minecraft:hopper" {
        return 5
    }
    if kind == "minecraft:dispenser" or kind == "minecraft:dropper" {
        return 9
    }
    if kind == "minecraft:decorated_pot" {
        return 1
    }
    return 0
}

// A container whose loot is still to come makes it as it's first looked into,
// `RandomizableContainer.unpackLootTable`, which Calcite doesn't yet.
fn check_loot(tags: JavaHashMap<String, Tag>) ! Thrown {
    if tags.contains("LootTable") {
        fail unimplemented("What a comparator reads of a container whose loot is to come, `unpackLootTable`")
    }
}

// What a container's slots hold, for `getRedstoneSignalFromContainer`: each slot's count and the
// most it holds of its item, `Container.getMaxStackSize`, the least of 99 and the stack's.
struct Stacks {
    filled: List<bool>
    counts: List<i32>
    most: List<i32>
}

impl Stacks {
    fn of(size: usize) -> Stacks {
        var s = Stacks { filled: List<bool>(), counts: List<i32>(), most: List<i32>() }
        for _ in 0..size {
            s.filled.push(false)
            s.counts.push(0)
            s.most.push(1)
        }
        return s
    }

    // The stacks a block entity of `size` slots saved, `ContainerHelper.loadAllItems` of its
    // `Items`, each at its `Slot`, where that's one of its slots, past `start`; or a decorated
    // pot's one, its `item`.
    fn add(mut self, f: Facts, tags: JavaHashMap<String, Tag>, start: usize, size: usize) {
        if tags.contains("item") {
            match tags["item"] {
                Tag.Compound(stack) => self.put(f, stack, start),
                _ => {},
            }
        }
        if not tags.contains("Items") {
            return
        }
        match tags["Items"] {
            Tag.List(items) => {
                for item in items {
                    match item {
                        Tag.Compound(stack) => {
                            let slot = usize.wrap(i32(byte_at(stack, "Slot") ?? 0) & 255)
                            if slot < size {
                                self.put(f, stack, start + slot)
                            }
                        },
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }

    // A stack at slot `at`, unless it's empty: its `count`, and the most of it, its
    // `max_stack_size` as its components have it, else its item's.
    fn put(mut self, f: Facts, stack: JavaHashMap<String, Tag>, at: usize) {
        let id = text_at(stack, "id") ?? String("minecraft:air")
        let count = int_at(stack, "count") ?? 1
        if id == "minecraft:air" or count <= 0 {
            return
        }
        var most = f.max_stack_size(id)
        if stack.contains("components") {
            match stack["components"] {
                Tag.Compound(c) => {
                    if c.contains("minecraft:max_stack_size") {
                        most = int_at(c, "minecraft:max_stack_size") ?? most
                    } else if c.contains("!minecraft:max_stack_size") {
                        most = 1
                    }
                },
                _ => {},
            }
        }
        self.filled[at] = true
        self.counts[at] = count
        self.most[at] = most.min(99)
    }

    // `AbstractContainerMenu.getRedstoneSignalFromContainer`: the share of each slot full, added
    // in slot order, over the slots, in floats, `Mth.lerpDiscrete` from 0 to 15.
    fn signal(self) -> i32 {
        var sum: f32 = 0.0
        for i in 0..self.filled.len() {
            if self.filled[i] {
                sum = sum + f32.nearest(self.counts[i]) / f32.nearest(self.most[i])
            }
        }
        let share = sum / f32.nearest(i32.wrap(self.filled.len()))
        return floor_f32(share * 14.0) + if share > 0.0 { 1 } else { 0 }
    }
}

// `CopperGolemStatueBlock.Pose`'s ordinal, the statue's `copper_golem_pose`.
fn pose_of(f: Facts, state: u32) -> i32 {
    let pose = f.get_name(state, String("copper_golem_pose")) ?? String("standing")
    let poses: List<str> = ["standing", "sitting", "running", "star"]
    for i in 0..poses.len() {
        if pose == String(poses[i]) {
            return i32.wrap(i)
        }
    }
    return 0
}

// The block entity at x, y, z, of `block`'s type, as it saves; a fresh one's, with nothing in it,
// where there's none of that type, as `getBlockEntity` makes it.
fn own_block_entity<R: BlockAccess>(f: Facts, r: R, block: u32, x: i32, y: i32, z: i32) -> JavaHashMap<String, Tag> {
    let saved = r.block_entity_tag(x, y, z) else return JavaHashMap<String, Tag>()
    let tags = match saved {
        Tag.Compound(m) => m.copy(),
        _ => return JavaHashMap<String, Tag>(),
    }
    let kind = f.block_entity_kind(block) else return JavaHashMap<String, Tag>()
    if (text_at(tags, "id") ?? String()) != kind {
        return JavaHashMap<String, Tag>()
    }
    return tags
}

// `Mth.floor` of a float.
fn floor_f32(v: f32) -> i32 {
    let i = i32.saturate(v)
    return if v < f32.nearest(i) { i - 1 } else { i }
}

fn unimplemented(what: own String) -> Thrown {
    return Thrown { exception: "Unimplemented", message: what }
}

fn int_at(tags: JavaHashMap<String, Tag>, key: str) -> i32? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Int(v) => some(v),
        _ => none,
    }
}

fn byte_at(tags: JavaHashMap<String, Tag>, key: str) -> i8? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Byte(v) => some(v),
        _ => none,
    }
}

fn text_at(tags: JavaHashMap<String, Tag>, key: str) -> String? {
    if not tags.contains(key) {
        return none
    }
    return match tags[key] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}
