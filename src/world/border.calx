/// A dimension's world border, as vanilla's `WorldBorder` keeps it, saved in
/// `data/minecraft/world_border.dat` in the dimension's folder, and moves it each tick of its
/// level, as `WorldBorder.tick` does (CAL-105).
///
/// A border is a square about its center, standing still at a size or moving from one size to
/// another over some ticks, a step each tick, with the damage, safe zone and warnings it gives
/// players. It's saved as its `Settings` and set up from them the first time its level asks for
/// it, as `applyInitialSettings` sets it up, with a moving one starting again from where it was.
module world.border

import nbt.tag.{Tag}
import protocol.play.{ClientboundInitializeBorder}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The farthest a border's center can be, `MAX_CENTER_COORDINATE`.
pub const MAX_CENTER: f64 = 29999984.0

/// What a border is saved as, vanilla's `WorldBorder.Settings`.
pub struct BorderSettings {
    pub center_x: f64
    pub center_z: f64
    pub damage_per_block: f64
    pub safe_zone: f64
    pub warning_blocks: i32
    pub warning_time: i32
    pub size: f64
    pub lerp_time: i64
    pub lerp_target: f64
}

/// A dimension's border, vanilla's `WorldBorder` once `applyInitialSettings` has set it up. Its
/// size stands still, as a `StaticBorderExtent`'s, or moves, as a `MovingBorderExtent`'s.
pub struct Border {
    pub center_x: f64 = 0.0
    pub center_z: f64 = 0.0
    pub damage_per_block: f64 = 0.2
    pub safe_zone: f64 = 5.0
    pub warning_blocks: i32 = 5
    pub warning_time: i32 = 300
    /// The most it reaches from 0, `max-world-size`, as `setAbsoluteMaxSize` sets it.
    pub absolute_max_size: i32 = 29999984
    /// Its size, and a moving one's a tick ago.
    pub size: f64 = 59999968.0
    pub previous: f64 = 0.0
    /// Whether it's moving, and if it is, from what size to what, from when to when, over how
    /// many ticks, and how many it has left.
    pub moving: bool = false
    pub from: f64 = 0.0
    pub to: f64 = 0.0
    pub lerp_begin: i64 = 0
    pub lerp_end: i64 = 0
    pub duration: f64 = 0.0
    pub progress: i64 = 0
    /// Whether it's changed since it was saved, as each setter and a moving border's tick marks
    /// it.
    pub dirty: bool = false
}

/// The saved data type a border is saved as, `WorldBorder.TYPE`.
pub fn saved_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "world_border" }
}

/// The largest a border is, and a new world's, `MAX_SIZE`: the float 5.999997E7, 59,999,968.
pub fn max_size() -> f64 {
    return f64(f32.nearest(59999968.0))
}

impl BorderSettings {
    /// A new world's border, `Settings.DEFAULT`.
    pub fn default() -> BorderSettings {
        return BorderSettings { center_x: 0.0, center_z: 0.0, damage_per_block: 0.2, safe_zone: 5.0, warning_blocks: 5, warning_time: 300, size: max_size(), lerp_time: 0, lerp_target: 0.0 }
    }

    /// The settings the saved data's `root` holds, as `Settings.CODEC` reads them, or a new
    /// world's, with vanilla's error, if its `data` isn't a map or a field is missing or wrong.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> BorderSettings {
        if not root.contains("data") {
            lines.push(parse_failed(saved_id(), String("Not a map: null")))
            return BorderSettings.default()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(saved_id(), "Not a map: {root["data"].to_snbt()}"))
                return BorderSettings.default()
            },
        }
        var errors = List<String>()
        let center_x = centered(data, "center_x", mut errors)
        let center_z = centered(data, "center_z", mut errors)
        let damage = double_field(data, "damage_per_block", mut errors)
        let safe_zone = double_field(data, "safe_zone", mut errors)
        let warning_blocks = int_field(data, "warning_blocks", mut errors)
        let warning_time = int_field(data, "warning_time", mut errors)
        let size = double_field(data, "size", mut errors)
        let lerp_time = long_field(data, "lerp_time", mut errors)
        let lerp_target = double_field(data, "lerp_target", mut errors)
        if not errors.is_empty() {
            // Joined as the record codec joins them, the last field's first.
            var message = String()
            var i = errors.len()
            while i > 0 {
                i -= 1
                if not message.is_empty() {
                    message.push_str("; ")
                }
                message.push_str(errors[i])
            }
            lines.push(parse_failed(saved_id(), message))
            return BorderSettings.default()
        }
        return BorderSettings { center_x: center_x, center_z: center_z, damage_per_block: damage, safe_zone: safe_zone, warning_blocks: warning_blocks, warning_time: warning_time, size: size, lerp_time: lerp_time, lerp_target: lerp_target }
    }
}

impl Border {
    /// The border `settings` set up at `game_time`, as `applyInitialSettings` sets it up, which
    /// marks it to be saved, with the reach `absolute_max_size`.
    pub fn new(settings: BorderSettings, game_time: i64, absolute_max_size: i32) -> Border {
        var border = Border { center_x: settings.center_x, center_z: settings.center_z, damage_per_block: settings.damage_per_block, safe_zone: settings.safe_zone, warning_blocks: settings.warning_blocks, warning_time: settings.warning_time, absolute_max_size: absolute_max_size, size: settings.size, dirty: true }
        if settings.lerp_time > 0 {
            border.lerp(settings.size, settings.lerp_target, settings.lerp_time, game_time)
        }
        return border
    }

    /// Starts it moving from `from` to `to` over `ticks`, at `game_time`, as `lerpSizeBetween`
    /// does, or standing at `to` if they're the same.
    pub fn lerp(mut self, from: f64, to: f64, ticks: i64, game_time: i64) {
        self.dirty = true
        if from == to {
            self.moving = false
            self.size = to
            return
        }
        self.moving = true
        self.from = from
        self.to = to
        self.duration = f64.nearest(ticks)
        self.progress = ticks
        self.lerp_begin = game_time
        self.lerp_end = game_time + ticks
        self.size = self.calculate()
        self.previous = self.size
    }

    /// A tick of the border, as `WorldBorder.tick` runs it: a moving one takes its step, and
    /// stands still at the size it was going to once it's taken its last.
    pub fn tick(mut self) {
        if not self.moving {
            return
        }
        self.progress -= 1
        self.previous = self.size
        self.size = self.calculate()
        self.dirty = true
        if self.progress <= 0 {
            self.moving = false
            self.size = self.to
        }
    }

    /// The ticks a moving border has left, or 0, `getLerpTime`.
    pub fn lerp_time(self) -> i64 {
        return if self.moving { self.progress } else { 0 }
    }

    /// The size it's moving to, or its size, `getLerpTarget`.
    pub fn lerp_target(self) -> f64 {
        return if self.moving { self.to } else { self.size }
    }

    /// Its west, north, east and south edges, as `getMinX`, `getMinZ`, `getMaxX` and `getMaxZ`
    /// give them a tick's start: half its size from its center, within its reach.
    pub fn min_x(self) -> f64 {
        return self.edge(self.center_x, false)
    }

    pub fn min_z(self) -> f64 {
        return self.edge(self.center_z, false)
    }

    pub fn max_x(self) -> f64 {
        return self.edge(self.center_x, true)
    }

    pub fn max_z(self) -> f64 {
        return self.edge(self.center_z, true)
    }

    /// How far the point is from its nearest edge, inside it, `getDistanceToBorder`: less than 0
    /// outside it (D426).
    pub fn distance(self, x: f64, z: f64) -> f64 {
        let from_north = z - self.min_z()
        let from_south = self.max_z() - z
        let from_west = x - self.min_x()
        let from_east = self.max_x() - x
        return from_west.min(from_east).min(from_north).min(from_south)
    }

    /// Whether the point is inside it, as `isWithinBounds(x, z)` says.
    pub fn within(self, x: f64, z: f64) -> bool {
        return x >= self.min_x() and x < self.max_x() and z >= self.min_z() and z < self.max_z()
    }

    /// What it's saved as, `Settings(WorldBorder)` as `Settings.CODEC` writes it, its file's
    /// `data`.
    pub fn pack(self) -> Tag {
        var fields = JavaHashMap<String, Tag>()
        fields.insert(String("center_x"), Tag.double(self.center_x))
        fields.insert(String("center_z"), Tag.double(self.center_z))
        fields.insert(String("damage_per_block"), Tag.double(self.damage_per_block))
        fields.insert(String("safe_zone"), Tag.double(self.safe_zone))
        fields.insert(String("warning_blocks"), Tag.Int(self.warning_blocks))
        fields.insert(String("warning_time"), Tag.Int(self.warning_time))
        fields.insert(String("size"), Tag.double(self.size))
        fields.insert(String("lerp_time"), Tag.Long(self.lerp_time()))
        fields.insert(String("lerp_target"), Tag.double(self.lerp_target()))
        return Tag.Compound(fields)
    }

    /// The packet a player entering its level is sent, `ClientboundInitializeBorderPacket`.
    pub fn packet(self) -> ClientboundInitializeBorder {
        return ClientboundInitializeBorder { center_x: self.center_x, center_z: self.center_z, old_size: self.size, new_size: self.lerp_target(), lerp_time: self.lerp_time(), absolute_max_size: self.absolute_max_size, warning_blocks: self.warning_blocks, warning_time: self.warning_time }
    }

    // A moving border's size with `progress` ticks left, `calculateSize`.
    fn calculate(self) -> f64 {
        let done = (self.duration - f64.nearest(self.progress)) / self.duration
        return if done < 1.0 { self.from + done * (self.to - self.from) } else { self.to }
    }

    // An edge, the greater if `greater`, as the extent's `getMinX` and the like give it at a
    // tick's start: a still border's from its size, and a moving one's from
    // `Mth.lerp(0, previous, size)`, which is its size a tick ago.
    fn edge(self, center: f64, greater: bool) -> f64 {
        let size = if self.moving { self.previous + 0.0 * (self.size - self.previous) } else { self.size }
        let reach = f64(self.absolute_max_size)
        let v = if greater { center + size / 2.0 } else { center - size / 2.0 }
        return if v < -reach { -reach } else if v > reach { reach } else { v }
    }
}

// A center's coordinate, `Codec.doubleRange(-2.9999984E7, 2.9999984E7)`.
fn centered(data: JavaHashMap<String, Tag>, name: str, errors: mut List<String>) -> f64 {
    let v = double_field(data, name, mut errors)
    if data.contains(name) and not (v >= -MAX_CENTER and v <= MAX_CENTER) {
        errors.push("Value {v} outside of range [-2.9999984E7:2.9999984E7]")
    }
    return v
}

// A field of `Codec.DOUBLE`, or 0 with the codec's error: `NbtOps.getNumberValue`'s, which doesn't
// say the value.
fn double_field(data: JavaHashMap<String, Tag>, name: str, errors: mut List<String>) -> f64 {
    if not data.contains(name) {
        errors.push("No key {name} in MapLike[{Tag.Compound(data.copy()).to_snbt()}]")
        return 0.0
    }
    let v = data[name].number_double() else {
        errors.push(String("Not a number"))
        return 0.0
    }
    return v
}

// A field of `Codec.INT`, or 0 with the codec's error.
fn int_field(data: JavaHashMap<String, Tag>, name: str, errors: mut List<String>) -> i32 {
    if not data.contains(name) {
        errors.push("No key {name} in MapLike[{Tag.Compound(data.copy()).to_snbt()}]")
        return 0
    }
    let v = data[name].number_int() else {
        errors.push(String("Not a number"))
        return 0
    }
    return v
}

// A field of `Codec.LONG`, or 0 with the codec's error.
fn long_field(data: JavaHashMap<String, Tag>, name: str, errors: mut List<String>) -> i64 {
    if not data.contains(name) {
        errors.push("No key {name} in MapLike[{Tag.Compound(data.copy()).to_snbt()}]")
        return 0
    }
    let v = data[name].number_long() else {
        errors.push(String("Not a number"))
        return 0
    }
    return v
}
