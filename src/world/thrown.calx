/// A thrown splash potion, as vanilla's `ThrownSplashPotion` and its `AbstractThrownPotion`,
/// `ThrowableItemProjectile`, `ThrowableProjectile` and `Projectile` make and run it (D527), or a
/// lingering one, `ThrownLingeringPotion`, which runs the same, but for its type (D529): 0.25
/// by 0.25, its eyes 0.2125 up, falling 0.05 a tick, its values `Entity`'s, `thrown_data`, and the
/// stack it is, one of what was thrown, `DATA_ITEM_STACK`, which its level packs. Each tick, as
/// `ServerLevel.tickNonPassenger` and `ThrowableProjectile.tick` run it: on its first, what a
/// bubble column in its box would do, said missing; it falls, `applyGravity`; water slows it to
/// 0.8, else the air to 0.99, `applyInertia`; the first block on its way, `clip` with
/// `ClipContext.Block.COLLIDER`, held by the world border, `clipIncludingBorder`, and before that
/// the nearest entity whose box, grown by a margin of up to 0.3, a fiftieth a tick on, its way
/// goes into, `getEntityHitResult`, among those its level found in its reach that it may hit,
/// `canHitEntity`; it goes to what it met, or along its motion, `setPos`; it turns a fifth of the
/// way toward where it's going, `updateRotation`; what blocks do to it, `applyEffectsFromBlocks`;
/// `Projectile.tick`'s, shot, and whether it's left its owner's box, `checkLeftOwner`; and
/// `baseTick`. Then, where it met an entity, the world border, or a block that isn't air by then,
/// it hits it, `hitTargetOrDeflectSelf`: what it hit and where, `Splash`, its level's to deal,
/// `onHit`, and it's gone. What the block it hit does of it, `onProjectileHit`, is said missing
/// where it'd do anything, `struck_missing`.
///
/// It's saved as `saveAsPassenger` saves it, `saved`, and loaded as `EntityType.create` makes one
/// and `load` reads it in, `loaded`. What doses living things with a potion's effects, as the
/// damage it deals tells it, a splash potion or a cloud, is a `Doser` (D529).
///
/// A thrown ender pearl, `ThrownEnderpearl`, runs the same, falling 0.03 a tick, a
/// `ThrowableItemProjectile`'s, but for what it does as it hits, `PearlHit`, which its level
/// deals: its owner taken to where it was as its tick began (D579).
module world.thrown

import math.mth.{RAD_TO_DEG, table_atan2, table_cos, table_sin}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.arrow.{OwnerView, Target}
import world.body.{Body, BodyFacts, EntitySound, PROJECTILE_PORTAL_DELAY, bool_or, int_or, uuid_of, uuid_tag}
import world.clip.{BlockHit, clip_including_border}
import world.collision.{Aabb, CollisionBlocks}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, ON_FIRE_FLAG, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, thrown_data}
import world.inside.{Acted, BlockEffect, Collector, EXTINGUISH, FIRE_IGNITE, LAVA_IGNITE, Movement, Rain, Touched, box_clip, doused, fluid_effects, inside_blocks, touch_block}
import world.movement.{MovementStates}
import worldgen.facts.{Facts}

/// What doses living things with a potion's effects, as the damage it deals tells it (D529): its
/// ID, its UUID, its custom name, its type's name, its owner's UUID, and where it is.
pub struct Doser {
    pub id: i32
    pub uuid: (i64, i64)
    pub name: Tag?
    pub kind: String
    pub owner: (i64, i64)?
    pub x: f64
    pub y: f64
    pub z: f64
}

/// What a thrown potion hit, which its level splashes, `onHit` (D527): its ID, its UUID and its
/// custom name, which a death it deals tells; the stack it is; its owner's UUID; where it is, at
/// what it hit; its box there, `potionAabb`; the margin its hit grew boxes by, `computeMargin`;
/// the block it hit and the face it met, else none; the entity it hit, else none; whether it's
/// silent; and whether it's a lingering potion, which leaves a cloud (D529).
pub struct Splash {
    pub id: i32
    pub uuid: (i64, i64)
    pub name: Tag?
    pub item: Tag
    pub owner: (i64, i64)?
    pub x: f64
    pub y: f64
    pub z: f64
    pub bounds: Aabb
    pub margin: f32
    pub block: (i32, i32, i32, i32)?
    pub entity: i32?
    pub silent: bool
    pub lingering: bool = false
}

impl Splash {
    /// It as what doses those it splashes, `Doser` (D529): a splash potion or a lingering one.
    pub fn doser(self) -> Doser {
        let kind = if self.lingering { String("minecraft:lingering_potion") } else { String("minecraft:splash_potion") }
        return Doser { id: self.id, uuid: self.uuid, name: self.name.copy(), kind: kind, owner: self.owner, x: self.x, y: self.y, z: self.z }
    }
}

/// What a thrown ender pearl hit, which its level deals, `ThrownEnderpearl.onHit` (D579): its ID
/// and its owner's UUID; where it was as its tick began, `oldPosition`, where its owner's taken;
/// the entity it hit, else none, for a block; whether it's on its portal cooldown,
/// `isOnPortalCooldown`, which puts its owner on theirs; and its random's draw for an endermite,
/// after its 32 portal particles' draws, each a double and two gaussians, which the server's
/// level shows none of but draws all the same, `addParticle`. For what it hit, which it hurts
/// (D581): its UUID and custom name, which name it; where it is; and its motion across, which
/// what it hurts is knocked back along.
pub struct PearlHit {
    pub id: i32
    pub owner: (i64, i64)?
    pub at: (f64, f64, f64)
    pub entity: i32?
    pub cooled: bool
    pub mite: f32
    pub uuid: (i64, i64)
    pub name: Tag?
    pub hit_at: (f64, f64, f64)
    pub motion: (f64, f64)
}

/// The nearest entity a thrown potion's way met, `EntityHitResult`: its ID, where it met it, and
/// whether it's a player.
pub struct ThrownHit {
    pub target: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub player: bool
}

/// A thrown potion or ender pearl.
pub struct ThrownItem {
    /// What every entity has, `world.body`'s.
    pub body: Body
    /// Its values, `Entity`'s; and the stack it is, `DATA_ITEM_STACK`, which is never its
    /// default, `ItemStack` having no `equals` of its own, and changed since its tracker last
    /// sent it, as it is once it's set.
    pub data: EntityData
    pub item: Tag
    pub item_dirty: bool = true
    /// Whether it's a lingering potion, `ThrownLingeringPotion`, not a splash potion (D529); or an
    /// ender pearl, `ThrownEnderpearl`, and the ticks till it puts its ticket again,
    /// `ticketTimer` (D579).
    pub lingering: bool = false
    pub pearl: bool = false
    pub ticket_timer: i64 = 0
    /// The player a pearl's among the pearls of, by their serial, which a respawn's new player
    /// has anew, `registerEnderPearl`, 0 for none (D580): the one throwing it, the one it's loaded
    /// with, or the one owning it as it's loaded or puts its ticket again.
    pub registered: i64 = 0
    /// Its owner's UUID, `Projectile.owner`; whether it's been out of its owner's box,
    /// `leftOwner`; and whether it's been shot, `hasBeenShot`.
    pub owner: (i64, i64)? = none
    pub left_owner: bool = false
    pub shot: bool = false
    /// The block its way meets this tick, `clipIncludingBorder`'s.
    pub way: BlockHit
    /// What blocks did that its level's to do, with how many of its tick's sounds came before.
    pub acted: List<Acted> = List<Acted>()
    pub acted_after: List<usize> = List<usize>()
    // What it keeps to save as it was read, `can_break`.
    kept: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
}

impl ThrownItem {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z, the stack `item`, falling
    // `gravity` a tick, a potion's 0.05.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, item: own Tag, gravity: f64) -> ThrownItem {
        let body = Body.made(id, seed, x, y, z, 0.25f32, 0.25f32, 0.2125f32, gravity)
        let way = BlockHit { x: x, y: y, z: z, face: 0, bx: 0, by: 0, bz: 0, missed: true }
        return ThrownItem { body: body, data: thrown_data(), item: item, way: way }
    }

    /// The potion a living thing of the UUID `owner` throws, `ThrowableItemProjectile`'s
    /// constructor with it the owner (D527), with the ID `id` and a random seeded `seed`: at x,
    /// y, z, a tenth below its eyes as the caller has it, one of the stack `item`,
    /// `copyWithCount(1)`.
    pub fn thrown(id: i32, seed: i64, x: f64, y: f64, z: f64, owner: (i64, i64), item: Tag) -> ThrownItem {
        var p = ThrownItem.made(id, seed, x, y, z, one_of(item), 0.05)
        p.owner = some(owner)
        return p
    }

    /// The ender pearl a player of the UUID `owner` throws, `ThrownEnderpearl`'s constructor with
    /// them the owner (D579), as `thrown` makes a potion, falling 0.03 a tick.
    pub fn pearl_thrown(id: i32, seed: i64, x: f64, y: f64, z: f64, owner: (i64, i64), item: Tag) -> ThrownItem {
        var p = ThrownItem.made(id, seed, x, y, z, one_of(item), 0.03)
        p.pearl = true
        p.owner = some(owner)
        return p
    }

    /// `Projectile.shoot` along xd, yd, zd at `pow` blocks a tick, `uncertainty` off (D527): the
    /// way made a unit long, `normalize`, none where it's shorter than `1.0E-5`, its random's three
    /// triangle draws across it added, x's first, then made `pow` long; facing that way, sent
    /// again, `needsSync`.
    pub fn shoot(mut self, xd: f64, yd: f64, zd: f64, pow: f32, uncertainty: f32) {
        let dist = (xd * xd + yd * yd + zd * zd).sqrt()
        var x = 0.0
        var y = 0.0
        var z = 0.0
        if not (dist < 1.0e-5) {
            x = xd / dist
            y = yd / dist
            z = zd / dist
        }
        let spread = 0.0172275 * f64(uncertainty)
        let ax = self.body.random.triangle(0.0, spread)
        let ay = self.body.random.triangle(0.0, spread)
        let az = self.body.random.triangle(0.0, spread)
        self.body.vx = (x + ax) * f64(pow)
        self.body.vy = (y + ay) * f64(pow)
        self.body.vz = (z + az) * f64(pow)
        self.body.needs_sync = true
        let across = (self.body.vx * self.body.vx + self.body.vz * self.body.vz).sqrt()
        self.body.y_rot = f32.nearest((table_atan2(self.body.vx, self.body.vz) ?? 0.0) * RAD_TO_DEG)
        self.body.x_rot = f32.nearest((table_atan2(self.body.vy, across) ?? 0.0) * RAD_TO_DEG)
    }

    /// `shootFromRotation` of a thrower facing `y_rot` and `x_rot`, `y_offset` degrees more up or
    /// down, at `pow`, `uncertainty` off (D527): the way they face, as `Mth`'s tables have it,
    /// `shoot` along it, then their known movement added, `getKnownMovement`, up and down only
    /// where they're not on the ground.
    pub fn shoot_from_rotation(mut self, y_rot: f32, x_rot: f32, y_offset: f32, pow: f32, uncertainty: f32, known: (f64, f64, f64), on_ground: bool) {
        let rad = 0.017453292f32
        let xd = -table_sin(f64(y_rot * rad)) * table_cos(f64(x_rot * rad))
        let yd = -table_sin(f64((x_rot + y_offset) * rad))
        let zd = table_cos(f64(y_rot * rad)) * table_cos(f64(x_rot * rad))
        self.shoot(f64(xd), f64(yd), f64(zd), pow, uncertainty)
        let (kx, ky, kz) = known
        self.body.vx = self.body.vx + kx
        self.body.vy = self.body.vy + (if on_ground { 0.0 } else { ky })
        self.body.vz = self.body.vz + kz
    }

    /// Its type's name, a lingering potion's or a splash potion's (D529), or an ender pearl's
    /// (D579).
    pub fn type_name(self) -> str {
        if self.pearl {
            return "minecraft:ender_pearl"
        }
        return if self.lingering { "minecraft:lingering_potion" } else { "minecraft:splash_potion" }
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// `Projectile`'s owner, as a UUID, whether it's left them where it has, whether it's been
    /// shot, and its `can_break` as it was read; then its stack, `Item`.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, self.type_name())
        if let o = self.owner {
            t.insert(String("Owner"), uuid_tag(o))
        }
        if self.left_owner {
            t.insert(String("LeftOwner"), Tag.Byte(1i8))
        }
        t.insert(String("HasBeenShot"), Tag.Byte(if self.shot { 1i8 } else { 0i8 }))
        for (k, v) in self.kept {
            t.insert(k.copy(), v.copy())
        }
        t.insert(String("Item"), self.item.copy())
        return Tag.Compound(t)
    }

    /// The potion `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `Entity.load` and `readAdditionalSaveData` read it in: what every entity
    /// reads, `world.body`'s, and its values from it; its owner, whether it left them and whether
    /// it was shot; and its stack as the caller read it with its codec, `item`, a splash potion,
    /// or a lingering one where it's `lingering` (D529), where it's none, its default,
    /// `getDefaultItem`. `none` where it's somewhere that isn't a number, logged in `lines` as
    /// `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, item: Tag?, lingering: bool, lines: mut List<Entry>) -> ThrownItem? {
        var p = ThrownItem.made(id, seed, 0.0, 0.0, 0.0, default_item(lingering), 0.05)
        p.lingering = lingering
        return p.load_rest(tag, item, mut lines)
    }

    /// The ender pearl `tag` saves, as `loaded` loads a potion (D579), an ender pearl where its
    /// stack's none, its ticket's timer, which isn't saved, at 0.
    pub fn loaded_pearl(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, item: Tag?, lines: mut List<Entry>) -> ThrownItem? {
        var p = ThrownItem.made(id, seed, 0.0, 0.0, 0.0, pearl_item(), 0.03)
        p.pearl = true
        return p.load_rest(tag, item, mut lines)
    }

    // What `loaded` reads in after it's made, of `tag`, `item` its stack as it was read.
    fn load_rest(self, tag: JavaHashMap<String, Tag>, item: Tag?, lines: mut List<Entry>) -> ThrownItem? {
        var p = self.copy()
        if not p.body.load_from(tag, mut lines) {
            return none
        }
        p.data.set(AIR_SUPPLY, Value.Number(p.body.air))
        if p.body.extras.contains("CustomName") {
            p.data.set(CUSTOM_NAME, Value.Name(p.body.extras["CustomName"].copy()))
        }
        p.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        p.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        p.data.set(NO_GRAVITY, Value.Bool(p.body.no_gravity))
        p.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        p.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        p.owner = uuid_of(tag, "Owner")
        p.left_owner = bool_or(tag, "LeftOwner")
        p.shot = bool_or(tag, "HasBeenShot")
        if tag.contains("can_break") {
            p.kept.insert(String("can_break"), tag["can_break"].copy())
        }
        if let stack = item {
            p.item = one_of(stack.copy())
        }
        p.item_dirty = true
        return some(p)
    }

    /// Whether it's silent, `isSilent`.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// The first part of its tick, as `tickNonPassenger` and `ThrowableProjectile.tick` run it
    /// among `blocks`, up to where its level looks for what it may hit: on its first tick, a bubble
    /// column in its box said missing, `handleFirstTickBubbleColumn`; its fall, `applyGravity`; its
    /// slowing, in water to 0.8, else by the air to 0.99, `applyInertia`, its bubbles the
    /// server's level doesn't show; and the first block on its way, `way`, held by the world border
    /// `border`, its west, north, east and south edges.
    pub fn tick_start<B: CollisionBlocks>(mut self, f: Facts, m: MovementStates, blocks: B, border: (f64, f64, f64, f64), heard: usize) {
        // `commonTick`.
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        if self.body.first_tick and self.in_bubble_column(f, blocks) {
            self.act(Acted.Missing(String("A bubble column a thrown potion's first tick is in")), heard)
        }
        let g = self.body.gravity_now()
        if g != 0.0 {
            self.body.vy = self.body.vy - g
        }
        let inertia = f64(if self.body.in_water { 0.8f32 } else { 0.99f32 })
        self.body.vx = self.body.vx * inertia
        self.body.vy = self.body.vy * inertia
        self.body.vz = self.body.vz * inertia
        let from = (self.body.x, self.body.y, self.body.z)
        let to = (self.body.x + self.body.vx, self.body.y + self.body.vy, self.body.z + self.body.vz)
        self.way = clip_including_border(f, m, blocks, self.body.mover(), from, to, border)
    }

    // Whether a bubble column's among the blocks its box is in, `findBlocksIn`.
    fn in_bubble_column<B: CollisionBlocks>(self, f: Facts, blocks: B) -> bool {
        let b = self.body.bounding_box()
        let (x0, y0, z0) = (i32.saturate(b.min_x.floor()), i32.saturate(b.min_y.floor()), i32.saturate(b.min_z.floor()))
        let (x1, y1, z1) = (i32.saturate(b.max_x.floor()), i32.saturate(b.max_y.floor()), i32.saturate(b.max_z.floor()))
        for x in x0..x1 + 1 {
            for y in y0..y1 + 1 {
                for z in z0..z1 + 1 {
                    let state = blocks.collision_state(x, y, z) ?? 0
                    if f.codec.blocks.name(f.block(state)) == "minecraft:bubble_column" {
                        return true
                    }
                }
            }
        }
        return false
    }

    /// Its box stretched along its motion, `expandTowards`, and a block bigger, `inflate(1.0)`,
    /// where its level looks for what it may hit and its owner's box is looked for.
    pub fn reach(self) -> Aabb {
        var b = self.body.bounding_box()
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        if vx < 0.0 {
            b.min_x = b.min_x + vx
        } else if vx > 0.0 {
            b.max_x = b.max_x + vx
        }
        if vy < 0.0 {
            b.min_y = b.min_y + vy
        } else if vy > 0.0 {
            b.max_y = b.max_y + vy
        }
        if vz < 0.0 {
            b.min_z = b.min_z + vz
        } else if vz > 0.0 {
            b.max_z = b.max_z + vz
        }
        return Aabb { min_x: b.min_x - 1.0, min_y: b.min_y - 1.0, min_z: b.min_z - 1.0, max_x: b.max_x + 1.0, max_y: b.max_y + 1.0, max_z: b.max_z + 1.0 }
    }

    /// Whether it may hit the entity `id`, as `canHitEntity` asks past its being alive and
    /// pickable: not its owner while it hasn't left them, `isPassengerOfSameVehicle`.
    pub fn may_hit(self, id: i32, owner: OwnerView?) -> bool {
        if let o = owner {
            if not self.left_owner and o.id == id {
                return false
            }
        }
        return true
    }

    /// The margin its hits grow boxes by, `computeMargin`: its ticks less 2, a twentieth each, from
    /// none up to 0.3, in floats.
    pub fn margin(self) -> f32 {
        let raw = f32.nearest(self.body.tick_count - 2) / 20.0f32
        return if raw < 0.3f32 { if raw > 0.0f32 { raw } else { 0.0f32 } } else { 0.3f32 }
    }

    /// `getEntityHitResult` among `targets`, in the order its level found them: of those whose
    /// box, grown by its margin, its way goes into from where it is up to the block it meets, or
    /// to the end of its motion, the nearest, by where its way goes in, the first where they tie.
    pub fn nearest(self, targets: List<Target>) -> ThrownHit? {
        let from = (self.body.x, self.body.y, self.body.z)
        let to = (self.way.x, self.way.y, self.way.z)
        let margin = f64(self.margin())
        let (fx, fy, fz) = from
        var best: ThrownHit? = none
        var nearest = 1.7976931348623157e308
        for t in targets {
            let b = t.bounds
            let at = box_clip(b.min_x - margin, b.min_y - margin, b.min_z - margin, b.max_x + margin, b.max_y + margin, b.max_z + margin, from, to) else continue
            let (hx, hy, hz) = at
            let d = (hx - fx) * (hx - fx) + (hy - fy) * (hy - fy) + (hz - fz) * (hz - fz)
            if d < nearest {
                nearest = d
                best = some(ThrownHit { target: t.id, x: hx, y: hy, z: hz, player: t.player })
            }
        }
        return best
    }

    /// From the start of its tick to its hits, `hit` the entity its way met: it goes there, else
    /// to the block its way met or the end of its motion, `setPos`; it turns a fifth of the way
    /// toward where it's going, `updateRotation`; and what blocks do to it along the way,
    /// `applyEffectsFromBlocks`.
    pub fn go<B: CollisionBlocks + Rain>(mut self, f: Facts, blocks: B, hit: ThrownHit?, sounds: mut List<EntitySound>) {
        if let h = hit {
            self.body.x = h.x
            self.body.y = h.y
            self.body.z = h.z
        } else {
            self.body.x = self.way.x
            self.body.y = self.way.y
            self.body.z = self.way.z
        }
        let (vx, vy, vz) = (self.body.vx, self.body.vy, self.body.vz)
        let across = (vx * vx + vz * vz).sqrt()
        self.body.x_rot = lerp_rotation(self.body.x_rot, f32.nearest((table_atan2(vy, across) ?? 0.0) * RAD_TO_DEG))
        self.body.y_rot = lerp_rotation(self.body.y_rot, f32.nearest((table_atan2(vx, vz) ?? 0.0) * RAD_TO_DEG))
        let moves = self.body.final_moves()
        self.blocks_act(f, blocks, moves, mut sounds)
    }

    /// The end of its tick: `Projectile.tick`'s, shot, and whether it's out of its owner's box,
    /// `checkLeftOwner`, its owner as its level found them, `owner`; then `baseTick`, its fluids,
    /// the currents pushing it, with a splash coming into water, its fire, its fall halved in lava,
    /// gone below the level, and its flag.
    pub fn tick_end<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, owner: OwnerView?, sounds: mut List<EntitySound>) {
        self.shot = true
        if not self.left_owner {
            self.left_owner = self.outside_owner(owner)
        }
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        // Its way through the nether portal it's in, which a thrown projectile may always take,
        // `ThrowableProjectile.canUsePortal`, its cooldown then a projectile's 2, out of its level
        // before it hits what it met (D578).
        if let p = self.body.portal_goes(true, PROJECTILE_PORTAL_DELAY) {
            let saved = self.saved()
            let way = self.body.travel(p, saved)
            self.act(Acted.Travel(way), sounds.len())
        }
        _ = self.body.update_fluids_pushed(f, t, blocks, fast_lava, true, true, mut sounds)
        if self.body.fire_tick(false) {
            self.hurt_marked()
        }
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let shown = self.body.fire_shown()
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, shown)
        self.body.first_tick = false
    }

    // `isOutsideOwnerCollisionRange`: its reach meets nothing of its owner that may be picked;
    // true with no owner found.
    fn outside_owner(self, owner: OwnerView?) -> bool {
        let o = owner else return true
        let ob = o.bounds else return true
        let b = self.reach()
        return not ob.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z)
    }

    /// What it hit as `hitTargetOrDeflectSelf` has it, `hit` the entity its way met, with
    /// `state` the block its way met as it is now, `Splash`: the entity; else the world border,
    /// which it doesn't bounce off; else a block that isn't air; else nothing.
    pub fn hit(self, f: Facts, hit: ThrownHit?, state: u32) -> Splash? {
        var block: (i32, i32, i32, i32)? = none
        var entity: i32? = none
        if let h = hit {
            entity = some(h.target)
        } else if self.way.missed {
            return none
        } else if self.way.border {
            block = some((self.way.bx, self.way.by, self.way.bz, self.way.face))
        } else if f.is_air(state) {
            return none
        } else {
            block = some((self.way.bx, self.way.by, self.way.bz, self.way.face))
        }
        var name: Tag? = none
        if self.body.extras.contains("CustomName") {
            name = some(self.body.extras["CustomName"].copy())
        }
        return some(Splash { id: self.body.id, uuid: self.body.uuid, name: name, item: self.item.copy(), owner: self.owner, x: self.body.x, y: self.body.y, z: self.body.z, bounds: self.body.bounding_box(), margin: self.margin(), block: block, entity: entity, silent: self.silent(), lingering: self.lingering })
    }

    /// What an ender pearl hit, as `hit` finds it, `PearlHit` (D579): its 32 portal particles'
    /// draws, which the server draws but doesn't show, then its draw for an endermite, its
    /// random's last, as it's gone at once.
    pub fn pearl_hit(mut self, f: Facts, hit: ThrownHit?, state: u32) -> PearlHit? {
        let what = self.hit(f, hit, state) else return none
        for _ in 0..32 {
            _ = self.body.random.next_double()
            _ = self.body.random.next_gaussian()
            _ = self.body.random.next_gaussian()
        }
        let mite = self.body.random.next_float()
        var name: Tag? = none
        if self.body.extras.contains("CustomName") {
            name = some(self.body.extras["CustomName"].copy())
        }
        return some(PearlHit { id: self.body.id, owner: self.owner, at: (self.body.xo, self.body.yo, self.body.zo), entity: what.entity, cooled: self.body.portal_cooldown > 0, mite: mite, uuid: self.body.uuid, name: name, hit_at: (self.body.x, self.body.y, self.body.z), motion: (self.body.vx, self.body.vz) })
    }

    // `Projectile.hurtServer`'s look: its motion to be sent, `markHurt`, unless it's invulnerable.
    fn hurt_marked(mut self) {
        if not self.body.removed and not self.body.invulnerable {
            self.body.sync_velocity = true
        }
    }

    // `applyEffectsFromBlocks` along `moves` (D435), as an arrow's but for a wooden button, which
    // only an arrow presses.
    fn blocks_act<B: CollisionBlocks + Rain>(mut self, f: Facts, blocks: B, moves: List<Movement>, sounds: mut List<EntitySound>) {
        if self.body.removed or self.body.no_physics {
            return
        }
        let froze = self.data.number(TICKS_FROZEN) > 0
        let was = (self.body.burning(false), froze, self.body.fire)
        var c = Collector()
        for i in inside_blocks(f, blocks, moves, self.body.width, self.body.height) {
            if self.body.removed {
                break
            }
            if i.block {
                c.advance(i.step)
                match touch_block(f, i, mut c, false, false, self.body.on_ground, self.body.y) {
                    Touched.Cactus => self.hurt_marked(),
                    Touched.Missing(what) => self.act(Acted.Missing(what), sounds.len()),
                    Touched.Portal((px, py, pz)) => self.body.inside_portal(px, py, pz, PROJECTILE_PORTAL_DELAY, false),
                    Touched.EndPortal((px, py, pz)) => self.body.inside_portal(px, py, pz, PROJECTILE_PORTAL_DELAY, true),
                    Touched.Gateway(_) => self.act(Acted.Missing(String("End gateways gone into by what isn't a player")), sounds.len()),
                    _ => {},
                }
            }
            if i.fluid {
                c.advance(i.step)
                fluid_effects(f, i, mut c)
            }
        }
        for e in c.finish() {
            if self.body.removed {
                break
            }
            match e {
                BlockEffect.Apply(kind) => {
                    if kind == FIRE_IGNITE {
                        if self.body.fire_ignite(false, 0) {
                            self.data.set(TICKS_FROZEN, Value.Number(0))
                        }
                    } else if kind == LAVA_IGNITE {
                        self.body.ignite_for(300)
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    } else if kind == EXTINGUISH {
                        self.body.put_out()
                    } else {
                        self.data.set(TICKS_FROZEN, Value.Number(0))
                    }
                },
                BlockEffect.InFire(_) => self.hurt_marked(),
                BlockEffect.LavaHurt => self.hurt_marked(),
                BlockEffect.Doused(_) => {
                    if self.body.burning(false) {
                        self.act(Acted.Missing(doused()), sounds.len())
                    }
                },
            }
        }
        let rained = self.body.in_rain(blocks)
        let freezing = self.data.number(TICKS_FROZEN) > 0
        self.body.after_inside(false, was, freezing, rained, mut sounds)
    }

    // What a block did that its level's to do, after `heard` of its tick's sounds.
    fn act(mut self, a: own Acted, heard: usize) {
        self.acted.push(a)
        self.acted_after.push(heard)
    }
}

/// What a block of the state `state` does of a thrown potion that hits it, `onProjectileHit`, that
/// Calcite doesn't do yet, to be said (D527): amethyst's chime, a chorus flower's or a decorated
/// pot's breaking, a target block's signal, a bell's ring and a big dripleaf's tilt.
pub fn struck_missing(f: Facts, state: u32) -> String? {
    let block = f.block(state)
    for cls in ["AmethystBlock", "ChorusFlowerBlock", "DecoratedPotBlock", "TargetBlock", "BellBlock", "BigDripleafBlock"] {
        if f.is_a(block, String(cls)) {
            return some("What a block of the class {cls} does as a thrown potion hits it")
        }
    }
    return none
}

/// The ender pearl a thrown one is where it has none of its own, `getDefaultItem` (D579).
pub fn pearl_item() -> Tag {
    var t = JavaHashMap<String, Tag>()
    t.insert(String("id"), Tag.Str(String("minecraft:ender_pearl")))
    t.insert(String("count"), Tag.Int(1))
    return Tag.Compound(t)
}

/// The splash potion a thrown one is where it has none of its own, `getDefaultItem`, or the
/// lingering potion where it's `lingering` (D529), its contents `PotionContents.EMPTY` as its
/// item's default.
pub fn default_item(lingering: bool) -> Tag {
    var t = JavaHashMap<String, Tag>()
    t.insert(String("id"), Tag.Str(String(if lingering { "minecraft:lingering_potion" } else { "minecraft:splash_potion" })))
    t.insert(String("count"), Tag.Int(1))
    return Tag.Compound(t)
}

// One of the stack `stack`, `copyWithCount(1)`.
fn one_of(stack: Tag) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var c = m.copy()
    c.insert(String("count"), Tag.Int(1))
    return Tag.Compound(c)
}

// `Projectile.lerpRotation`: from `from`, brought within half a turn of `to`, a fifth of the way
// there, `Mth.lerp(0.2F, ...)`.
fn lerp_rotation(from: f32, to: f32) -> f32 {
    var o = from
    while to - o < -180.0f32 {
        o -= 360.0f32
    }
    while to - o >= 180.0f32 {
        o += 360.0f32
    }
    return o + 0.2f32 * (to - o)
}
