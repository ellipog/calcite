/// The world's stopwatches, vanilla's `Stopwatches`, in `data/minecraft/stopwatches.dat`
/// (CAL-170). The server asks `computeIfAbsent` for them as it starts, so a new world saves them,
/// none, at its first save. Calcite has no `stopwatch` command yet, so those a world saved are
/// kept as they were.
module world.stopwatches

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data type they're saved as, `Stopwatches.TYPE`.
pub fn stopwatches_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "stopwatches" }
}

/// The stopwatches saved, by ID, as their `stopwatches` map has them.
pub struct Stopwatches {
    saved: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    /// Whether they've changed since they were saved, as `setDirty` marks them.
    pub dirty: bool = false
}

impl Stopwatches {
    /// None, as `computeIfAbsent` makes them where there's no file, or one that can't be read,
    /// and `set` marks them to be saved.
    pub fn fresh() -> Stopwatches {
        return Stopwatches { dirty: true }
    }

    /// The stopwatches of a saved file's root, its `stopwatches` map kept as it is. Where it
    /// can't be read, what the codec says is logged and they start `fresh`.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Stopwatches {
        if not root.contains("data") {
            lines.push(parse_failed(stopwatches_id(), String("Not a map: null")))
            return Stopwatches.fresh()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(stopwatches_id(), "Not a map: {root["data"].to_snbt()}"))
                return Stopwatches.fresh()
            },
        }
        if not data.contains("stopwatches") {
            lines.push(parse_failed(stopwatches_id(), "No key stopwatches in MapLike[{Tag.Compound(data.copy()).to_snbt()}]"))
            return Stopwatches.fresh()
        }
        return match data["stopwatches"] {
            Tag.Compound(s) => Stopwatches { saved: s.copy() },
            other => {
                lines.push(parse_failed(stopwatches_id(), "Not a map: {other.to_snbt()}"))
                Stopwatches.fresh()
            },
        }
    }

    /// Their `data`, as the codec writes it.
    pub fn pack(self) -> Tag {
        var fields = JavaHashMap<String, Tag>()
        fields.insert(String("stopwatches"), Tag.Compound(self.saved.copy()))
        return Tag.Compound(fields)
    }
}
