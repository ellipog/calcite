/// The world's stopwatches, vanilla's `Stopwatches`, in `data/minecraft/stopwatches.dat`
/// (CAL-170), which `stopwatch` and `execute if stopwatch` use (CAL-165). The server asks
/// `computeIfAbsent` for them as it starts, so a new world saves them, none, at its first save.
/// Each counts by the server's millisecond clock, `Util.getMillis`.
module world.stopwatches

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.saved.{parse_failed}

/// The saved data type they're saved as, `Stopwatches.TYPE`.
pub fn stopwatches_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "stopwatches" }
}

/// A stopwatch, vanilla's `Stopwatch`: when it was made, by the server's millisecond clock, and
/// what it had counted before then, as one loaded from the world has.
pub struct Watch {
    pub created: i64
    pub counted: i64 = 0
}

impl Watch {
    /// `elapsedMilliseconds` at `now`.
    pub fn elapsed_ms(self, now: i64) -> i64 {
        return self.counted.wrapping_add(now.wrapping_sub(self.created))
    }

    /// `elapsedSeconds` at `now`.
    pub fn elapsed_seconds(self, now: i64) -> f64 {
        return f64.nearest(self.elapsed_ms(now)) / 1000.0
    }
}

/// The stopwatches, by their IDs, as `Identifier.toString` writes them.
pub struct Stopwatches {
    /// Those saved, by ID, as their `stopwatches` map has them, till `begin` starts them.
    saved: JavaHashMap<String, Tag> = JavaHashMap<String, Tag>()
    watches: JavaHashMap<String, Watch> = JavaHashMap<String, Watch>()
    started: bool = false
    /// Whether they've changed since they were saved, as `setDirty` marks them.
    pub dirty: bool = false
}

impl Stopwatches {
    /// None, as `computeIfAbsent` makes them where there's no file, or one that can't be read,
    /// and `set` marks them to be saved.
    pub fn fresh() -> Stopwatches {
        return Stopwatches { dirty: true }
    }

    /// The stopwatches of a saved file's root, its `stopwatches` map kept as it is till they
    /// `begin`. Where it can't be read, what the codec says is logged and they start `fresh`.
    pub fn load(root: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Stopwatches {
        if not root.contains("data") {
            lines.push(parse_failed(stopwatches_id(), String("Not a map: null")))
            return Stopwatches.fresh()
        }
        let data = match root["data"] {
            Tag.Compound(d) => d.copy(),
            _ => {
                lines.push(parse_failed(stopwatches_id(), "Not a map: {root["data"].to_snbt()}"))
                return Stopwatches.fresh()
            },
        }
        if not data.contains("stopwatches") {
            lines.push(parse_failed(stopwatches_id(), "No key stopwatches in MapLike[{Tag.Compound(data.copy()).to_snbt()}]"))
            return Stopwatches.fresh()
        }
        return match data["stopwatches"] {
            Tag.Compound(s) => Stopwatches { saved: s.copy() },
            other => {
                lines.push(parse_failed(stopwatches_id(), "Not a map: {other.to_snbt()}"))
                Stopwatches.fresh()
            },
        }
    }

    /// Whether they've been started, `begin`.
    pub fn begun(self) -> bool {
        return self.started
    }

    /// Those saved started at `now`, as `unpack` starts them as the world loads: each made now,
    /// with what it had counted, its ID as `Identifier` reads it.
    pub fn begin(mut self, now: i64) {
        for (id, counted) in self.saved {
            let full = if id.contains(":") { id.copy() } else { "minecraft:{id}" }
            self.watches.insert(full, Watch { created: now, counted: counted.number_long() ?? 0 })
        }
        self.saved = JavaHashMap<String, Tag>()
        self.started = true
    }

    /// The stopwatch called `id`, `get`.
    pub fn get(self, id: String) -> Watch? {
        if let w = self.watches.find(id) {
            return some(w)
        }
        return none
    }

    /// `add`: `w` called `id` where none is, marked to be saved. Whether it was added.
    pub fn add(mut self, id: String, w: Watch) -> bool {
        if self.watches.contains(id.copy()) {
            return false
        }
        self.watches.insert(id.copy(), w)
        self.dirty = true
        return true
    }

    /// `update` of the one called `id` to `w`, where there's one, marked to be saved. Whether
    /// there was.
    pub fn replace(mut self, id: String, w: Watch) -> bool {
        if not self.watches.contains(id.copy()) {
            return false
        }
        self.watches.insert(id.copy(), w)
        self.dirty = true
        return true
    }

    /// `remove` of the one called `id`, marked to be saved where there was one. Whether there was.
    pub fn remove(mut self, id: String) -> bool {
        let gone = self.watches.remove(id) != none
        if gone {
            self.dirty = true
        }
        return gone
    }

    /// Their IDs, `ids`, in their map's order.
    pub fn ids(self) -> List<String> {
        var out = List<String>()
        for (id, _) in self.watches {
            out.push(id.copy())
        }
        return out
    }

    /// `isDirty`: changed, or any there at all, so they're saved each time the world is.
    pub fn needs_save(self) -> bool {
        return self.dirty or not self.watches.is_empty() or not self.saved.is_empty()
    }

    /// Their `data` at `now`, as the codec writes it, `pack`: each one's elapsed milliseconds;
    /// those not yet begun as they were saved.
    pub fn pack(self, now: i64) -> Tag {
        var map = self.saved.copy()
        for (id, w) in self.watches {
            map.insert(id.copy(), Tag.Long(w.elapsed_ms(now)))
        }
        var fields = JavaHashMap<String, Tag>()
        fields.insert(String("stopwatches"), Tag.Compound(map))
        return Tag.Compound(fields)
    }
}
