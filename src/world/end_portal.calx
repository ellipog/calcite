/// An end portal's frame given an eye of ender, the level's part of `EnderEyeItem.useOn` (D596):
/// the frame set with its eye, the comparators by it told, its level event; then the portal's
/// pattern looked for about it, `EndPortalFrameBlock.getOrCreatePortalShape().find`, and, where the
/// ring is whole, the portal opened inside it, which every player hears.
module world.end_portal

import random.source.{RandomSource}
import world.block_level.{BlockLevel, destroy_block, update_output_signal}
import world.level_writer.{UPDATE_LIMIT}
import world.pos.{BlockPos}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.survive.{Env}

/// `LevelEvent.END_PORTAL_FRAME_FILL`, the eye set in a frame.
pub const FRAME_FILLED: i32 = 1503
/// `LevelEvent.SOUND_END_PORTAL_SPAWN`, the portal opened, sent to every player,
/// `globalLevelEvent`.
pub const PORTAL_OPENED: i32 = 1038

/// The frame at x, y, z given its eye, its state now `eyed`, as `useOn` does once what was in the
/// way is pushed up: set with flags 2, `UPDATE_CLIENTS`, the comparators by it told,
/// `updateNeighbourForOutputSignal`, and the fill's level event. Then where the frames about it
/// make the portal's ring, each block inside broken with its drops, `destroyBlock`, and the
/// portal set there, flags 2, a row along x at a time, west to east, each north to south, and
/// every player told it opened at the middle. Whether it opened.
pub fn fill_frame<L: BlockAccess + BlockLevel + RandomSource>(e: Env, level: mut L, eyed: u32, x: i32, y: i32, z: i32) -> bool ! Thrown {
    let Env { facts: f, .. } = e
    _ = level.set_block_limited(x, y, z, eyed, 2, UPDATE_LIMIT)
    try update_output_signal(f, mut level, f.block(eyed), x, y, z)
    level.level_event(FRAME_FILLED, x, y, z, 0)
    let found = try portal_corner(f, level, x, y, z)
    let corner = found else return false
    // `getFrontTopLeft().offset(-3, 0, -3)`, whichever way the pattern was found.
    let (px, py, pz) = (corner.x - 3, corner.y, corner.z - 3)
    let portal = f.default_state(try f.named_block(String("end_portal")))
    for i in 0..3 {
        for j in 0..3 {
            _ = try destroy_block(e, mut level, px + i, py, pz + j, true, none, UPDATE_LIMIT)
            _ = level.set_block_limited(px + i, py, pz + j, portal, 2, UPDATE_LIMIT)
        }
    }
    level.global_level_event(PORTAL_OPENED, px + 1, py, pz + 1, 0)
    return true
}

/// `BlockPattern.find(level, pos)` of the end portal's pattern, `getOrCreatePortalShape`: the
/// first place, from x, y, z to 4 past it each way, in `betweenClosed`'s order, x first, then y,
/// then z, and the first way it's turned, each forwards in `Direction`'s order and each up that
/// isn't along it, that the pattern matches, its `frontTopLeft`. The pattern is one aisle of five
/// rows, "?vvv?", ">???<" three times and "?^^^?": a `?` anything, the others frames with an eye
/// facing south for `^`, west for `>`, north for `v` and east for `<`. A block in a chunk that
/// isn't there is no frame, as `BlockInWorld` reads none there.
pub fn portal_corner<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32) -> BlockPos? ! Thrown {
    for dz in 0..5 {
        for dy in 0..5 {
            for dx in 0..5 {
                for forwards in 0..6 {
                    for up in 0..6 {
                        if up == forwards or up == opposite(forwards) {
                            continue
                        }
                        if try matches(f, level, x + dx, y + dy, z + dz, forwards, up) {
                            return some(BlockPos { x: x + dx, y: y + dy, z: z + dz })
                        }
                    }
                }
            }
        }
    }
    return none
}

// `BlockPattern.matches(origin, forwards, up)`: whether each of the pattern's frames is where
// `translateAndRotate` puts it, `right` along `forwards` crossed with `up`, `down` against `up`.
fn matches<L: BlockAccess + BlockLevel>(f: Facts, level: L, ox: i32, oy: i32, oz: i32, forwards: i32, up: i32) -> bool ! Thrown {
    let (fx, fy, fz) = (step_x(forwards), step_y(forwards), step_z(forwards))
    let (ux, uy, uz) = (step_x(up), step_y(up), step_z(up))
    let (rx, ry, rz) = (fy * uz - fz * uy, fz * ux - fx * uz, fx * uy - fy * ux)
    for right in 0..5 {
        for down in 0..5 {
            let want = facing_at(right, down) else continue
            let bx = ox + ux * -down + rx * right
            let by = oy + uy * -down + ry * right
            let bz = oz + uz * -down + rz * right
            if not try frame_with_eye(f, level, bx, by, bz, want) {
                return false
            }
        }
    }
    return true
}

// The facing the pattern's frame at `right`, `down` has, by name; none for a `?`, the corners and
// the middle.
fn facing_at(right: i32, down: i32) -> String? {
    let edge_row = down == 0 or down == 4
    let edge_column = right == 0 or right == 4
    if edge_row == edge_column {
        return none
    }
    if down == 0 {
        return some(String("north"))
    }
    if down == 4 {
        return some(String("south"))
    }
    return some(String(if right == 0 { "west" } else { "east" }))
}

// Whether the block at x, y, z is an end portal frame with an eye, facing `want`.
fn frame_with_eye<L: BlockAccess + BlockLevel>(f: Facts, level: L, x: i32, y: i32, z: i32, want: String) -> bool ! Thrown {
    if not level.is_loaded(x, y, z) {
        return false
    }
    let state = try level.state(f, x, y, z)
    if not f.is_a(f.block(state), "EndPortalFrameBlock") or not f.get_bool(state, String("eye")) {
        return false
    }
    return (f.get_name(state, String("facing")) ?? String()) == want
}
