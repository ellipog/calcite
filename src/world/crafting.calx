/// Crafting, as vanilla's crafting menus craft (CAL-147): a grid's stacks, trimmed to what's in
/// them, `CraftingInput.ofPositioned`; the first crafting recipe that matches them in the
/// registry's order, as `RecipeMap.getRecipesFor` finds it; what it makes of them, `assemble`;
/// and what's left in the grid once that's taken, `getRemainingItems`. Each kind matches as its
/// recipe class does: a shaped recipe's pattern, mirrored too; a shapeless one's ingredients, each
/// to its own stack, as `StackedContents` picks them; a transmute's input and materials; a dye's,
/// an imbue's, a book clone's, a firework rocket's, a star's and a star's fade, a banner's copy, a
/// shield's decoration, a decorated pot's sherds, and two worn tools repaired into one. A map
/// can't be extended until Calcite keeps maps' data, as vanilla's can't without it.
///
/// Stacks are as `ItemStack.CODEC` writes them, or nothing; what's made is written the same,
/// its components against its item's defaults with `items`.
module world.crafting

import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import world.recipes.{Crafting, Ingredient, Recipes}

/// A crafting grid's stacks, as `CraftingInput.ofPositioned` makes them: trimmed to the rows and
/// columns with something in them, `width` by `height`, with where that is in the grid.
pub struct Input {
    pub width: usize = 0
    pub height: usize = 0
    pub items: List<Tag?> = List<Tag?>()
    pub left: usize = 0
    pub top: usize = 0
}

impl Input {
    /// The grid `grid`, `width` by `height`, row by row, trimmed to what's in it, or nothing
    /// where it's empty, `CraftingInput.Positioned.EMPTY`.
    pub fn of(width: usize, height: usize, grid: List<Tag?>) -> Input {
        if width == 0 or height == 0 {
            return Input()
        }
        var left = width - 1
        var right: usize = 0
        var top = height - 1
        var bottom: usize = 0
        var any = false
        for y in 0..height {
            for x in 0..width {
                if grid[x + y * width] != none {
                    left = left.min(x)
                    right = right.max(x)
                    top = top.min(y)
                    bottom = bottom.max(y)
                    any = true
                }
            }
        }
        if not any {
            return Input()
        }
        let w = right - left + 1
        let h = bottom - top + 1
        var items = List<Tag?>()
        for y in 0..h {
            for x in 0..w {
                items.push(grid[x + left + (y + top) * width].copy())
            }
        }
        return Input { width: w, height: h, items: items, left: left, top: top }
    }

    /// The stack at `x`, `y`.
    pub fn at(self, x: usize, y: usize) -> Tag? {
        return self.items[x + y * self.width].copy()
    }

    /// How many of its slots have something, `ingredientCount`.
    pub fn count(self) -> usize {
        var n: usize = 0
        for item in self.items {
            if item != none {
                n += 1
            }
        }
        return n
    }
}

/// The place in `recipes.crafting` of the first recipe `input` matches, as
/// `getRecipeFor(RecipeType.CRAFTING, ...)` finds it with no hint, or none where none does or
/// the grid's empty.
pub fn find(recipes: Recipes, input: Input, items: ItemCodecs) -> usize? {
    if input.count() == 0 {
        return none
    }
    for i in 0..recipes.crafting.len() {
        if matches(recipes.crafting[i], recipes.all[recipes.crafting[i].at].value, input, items) {
            return some(i)
        }
    }
    return none
}

/// What the grid `input` makes, `slotChangedCraftingGrid`'s result: its first recipe's
/// `assemble`, or nothing.
pub fn result(recipes: Recipes, input: Input, items: ItemCodecs) -> Tag? {
    let i = find(recipes, input, items) else return none
    return assemble(recipes.crafting[i], recipes.all[recipes.crafting[i].at].value, input, items)
}

/// What's left in each of `input`'s slots once its result's taken, `ResultSlot.getRemainingItems`:
/// its first recipe's `getRemainingItems`, or, where none matches, each stack as it is.
pub fn remaining(recipes: Recipes, input: Input, items: ItemCodecs) -> List<Tag?> {
    let found = find(recipes, input, items)
    let i = found else return input.items.copy()
    let kind = recipes.crafting[i].kind.copy()
    var out = List<Tag?>()
    var cloned = false
    for stack in input.items {
        var left = remainder(stack)
        if left == none and stack != none {
            if kind == "minecraft:crafting_special_bannerduplicate" and patterns(stack, items) > 0 {
                left = with_count(stack, 1)
            } else if kind == "minecraft:crafting_special_bookcloning" and not cloned and has(stack, "minecraft:written_book_content", items) {
                // Only the first written book is kept, as vanilla's loop stops there.
                left = with_count(stack, 1)
                cloned = true
            }
        }
        out.push(left)
    }
    return out
}

// `Item.getCraftingRemainder` of `stack`'s item, as a stack: a bucket for a bucket of water, of
// lava or of milk, and a glass bottle for a honey bottle or dragon's breath.
fn remainder(stack: Tag?) -> Tag? {
    let item = item_of(stack)
    if item == "minecraft:water_bucket" or item == "minecraft:lava_bucket" or item == "minecraft:milk_bucket" {
        return some(plain(String("minecraft:bucket"), 1))
    }
    if item == "minecraft:honey_bottle" or item == "minecraft:dragon_breath" {
        return some(plain(String("minecraft:glass_bottle"), 1))
    }
    return none
}

// Whether `input` matches the recipe `c`, whose value is `value`, as its class's `matches` has it.
fn matches(c: Crafting, value: Tag, input: Input, items: ItemCodecs) -> bool {
    let kind = c.kind.copy()
    if kind == "minecraft:crafting_shaped" {
        return shaped(c, input)
    }
    if kind == "minecraft:crafting_shapeless" {
        return shapeless(c, input)
    }
    if kind == "minecraft:crafting_transmute" {
        return transmutes(c, value, input, items)
    }
    if kind == "minecraft:crafting_dye" {
        return dyes(c, input, items)
    }
    if kind == "minecraft:crafting_special_firework_star_fade" {
        return fades(c, input, items)
    }
    if kind == "minecraft:crafting_imbue" {
        if input.width != 3 or input.height != 3 or input.count() != 9 {
            return false
        }
        for y in 0..3usize {
            for x in 0..3usize {
                let name = if x == 1 and y == 1 { "source" } else { "material" }
                if not c.tests(name, input.at(x, y)) {
                    return false
                }
            }
        }
        return true
    }
    if kind == "minecraft:crafting_decorated_pot" {
        if input.width != 3 or input.height != 3 or input.count() != 4 {
            return false
        }
        return c.tests("back", input.at(1, 0)) and c.tests("left", input.at(0, 1)) and c.tests("right", input.at(2, 1)) and c.tests("front", input.at(1, 2))
    }
    if kind == "minecraft:crafting_special_bookcloning" {
        return clones(c, value, input, items)
    }
    if kind == "minecraft:crafting_special_firework_rocket" {
        return rocket(c, input)
    }
    if kind == "minecraft:crafting_special_firework_star" {
        return star(c, input, items)
    }
    if kind == "minecraft:crafting_special_bannerduplicate" {
        return copies_banner(c, input, items)
    }
    if kind == "minecraft:crafting_special_shielddecoration" {
        return decorates_shield(c, input, items)
    }
    if kind == "minecraft:crafting_special_repairitem" {
        return repaired(input, items) != none
    }
    // `MapExtendingRecipe`: a filled map's data, which Calcite doesn't keep yet, so none is
    // there to be extended, as vanilla's isn't without it.
    return false
}

// `ShapedRecipePattern.matches`: as many stacks as the pattern has symbols, in a grid its size,
// each its cell's, mirrored or not.
fn shaped(c: Crafting, input: Input) -> bool {
    var symbols: usize = 0
    for cell in c.cells {
        if cell >= 0 {
            symbols += 1
        }
    }
    if input.count() != symbols or input.width != c.width or input.height != c.height {
        return false
    }
    return shaped_as(c, input, true) or shaped_as(c, input, false)
}

fn shaped_as(c: Crafting, input: Input, flipped: bool) -> bool {
    for y in 0..c.height {
        for x in 0..c.width {
            let cell = if flipped { c.cells[c.width - x - 1 + y * c.width] } else { c.cells[x + y * c.width] }
            let actual = input.at(x, y)
            if cell < 0 {
                if actual != none {
                    return false
                }
            } else if not c.ingredients[usize.wrap(cell)].test(actual) {
                return false
            }
        }
    }
    return true
}

// `ShapelessRecipe.matches`: as many stacks as ingredients, and each ingredient to a stack of its
// own, as `StackedItemContents.canCraft` finds one where there is, a stack of one alone tested
// by the one ingredient. An ingredient of no items can't be placed, so it never matches.
fn shapeless(c: Crafting, input: Input) -> bool {
    if input.count() != c.ingredients.len() {
        return false
    }
    if input.items.len() == 1 and c.ingredients.len() == 1 {
        return c.ingredients[0].test(input.items[0])
    }
    for ingredient in c.ingredients {
        if ingredient.is_empty() {
            return false
        }
    }
    var stacks = List<Tag?>()
    for item in input.items {
        if item != none {
            stacks.push(item.copy())
        }
    }
    // Each stack's ingredient, by place, or -1: Kuhn's augmenting paths, which find an assignment
    // wherever there is one, as `tryPick` does.
    var owner = List<i32>()
    for _ in stacks {
        owner.push(-1)
    }
    for i in 0..c.ingredients.len() {
        var seen = List<bool>()
        for _ in stacks {
            seen.push(false)
        }
        if not assign(c.ingredients, stacks, i, mut owner, mut seen) {
            return false
        }
    }
    return true
}

// Ingredient `i` given a stack, moving others' where they can go elsewhere.
fn assign(ingredients: List<Ingredient>, stacks: List<Tag?>, i: usize, owner: mut List<i32>, seen: mut List<bool>) -> bool {
    for s in 0..stacks.len() {
        if seen[s] or not ingredients[i].test(stacks[s]) {
            continue
        }
        seen[s] = true
        let held = owner[s]
        if held < 0 or assign(ingredients, stacks, usize.wrap(held), mut owner, mut seen) {
            owner[s] = i32.wrap(i)
            return true
        }
    }
    return false
}

// `TransmuteRecipe.matches`: one input and between the least and most materials, each stack one
// or the other, and a result that isn't the input as it was.
fn transmutes(c: Crafting, value: Tag, input: Input, items: ItemCodecs) -> bool {
    let (low, high) = material_counts(value)
    let least = low ?? 1
    let most = high ?? 8
    let n = i32.wrap(input.count())
    if n < least + 1 or n > most + 1 {
        return false
    }
    var found: Tag? = none
    var materials: i32 = 0
    for stack in input.items {
        if stack == none {
            continue
        }
        if c.tests("input", stack) {
            if found != none {
                return false
            }
            found = stack.copy()
        } else {
            if not c.tests("material", stack) {
                return false
            }
            materials += 1
            if materials > most {
                return false
            }
        }
    }
    let given = found else return false
    if (low != none and materials < least) or (high != none and materials > most) {
        return false
    }
    if result_count(value, materials) != 1 {
        return true
    }
    let back = transmuted(value, some(given.copy()), 0, items) else return false
    return not same_item_components(some(given), some(back))
}

// The ends of a transmute's `material_count`, either left out.
fn material_counts(value: Tag) -> (i32?, i32?) {
    return match field(value, "material_count") {
        Tag.Int(n) => (some(n), some(n)),
        Tag.Compound(_) => (int_of(field(field(value, "material_count"), "min")), int_of(field(field(value, "material_count"), "max"))),
        _ => (some(1), some(1)),
    }
}

// `computeResultSize`: the result's count, with the materials where it adds them.
fn result_count(value: Tag, materials: i32) -> i32 {
    let base = int_of(field(field(value, "result"), "count")) ?? 1
    return if flag(field(value, "add_material_count_to_result")) { materials + base } else { base }
}

// `computeResult`: the transmute's result for its input `input`, the input's item where it names
// none, with the input's components and `extra` more.
fn transmuted(value: Tag, input: Tag?, extra: i32, items: ItemCodecs) -> Tag? {
    let given = field(value, "result")
    let item = match field(given, "id") {
        Tag.Str(s) => s.copy(),
        _ => item_of(input),
    }
    let count = (int_of(field(given, "count")) ?? 1) + extra
    return with_original(item, count, field(given, "components"), input, items)
}

// `TransmuteRecipe.createWithOriginalComponents`: `count` of `item` with `input`'s patch, then
// `components`, a template's, over it, `applyComponents`.
fn with_original(item: String, count: i32, components: Tag, input: Tag?, items: ItemCodecs) -> Tag? {
    var patch = patch_of(input)
    apply(mut patch, components)
    return made(item, count, patch, items)
}

// `DyeRecipe.matches`: two or more stacks, one the target and the rest dyes, each with its `dye`.
fn dyes(c: Crafting, input: Input, items: ItemCodecs) -> bool {
    if input.count() < 2 {
        return false
    }
    var target = false
    var dyed = false
    for stack in input.items {
        if stack == none {
            continue
        }
        if c.tests("target", stack) {
            if target {
                return false
            }
            target = true
        } else {
            if not c.tests("dye", stack) or not has(stack, "minecraft:dye", items) {
                return false
            }
            dyed = true
        }
    }
    return target and dyed
}

// `FireworkStarFadeRecipe.matches`: as a dye's, the dyes tested first.
fn fades(c: Crafting, input: Input, items: ItemCodecs) -> bool {
    if input.count() < 2 {
        return false
    }
    var target = false
    var dyed = false
    for stack in input.items {
        if stack == none {
            continue
        }
        if c.tests("dye", stack) and has(stack, "minecraft:dye", items) {
            dyed = true
        } else {
            if not c.tests("target", stack) or target {
                return false
            }
            target = true
        }
    }
    return target and dyed
}

// `BookCloningRecipe.matches`: one written book whose generation may be copied, and one or more
// books to copy it into.
fn clones(c: Crafting, value: Tag, input: Input, items: ItemCodecs) -> bool {
    if input.count() < 2 {
        return false
    }
    let (low, high) = generations(value)
    var material = false
    var source = false
    for stack in input.items {
        if stack == none {
            continue
        }
        if c.tests("source", stack) {
            let content = items.component(stack.copy() ?? Tag.End, String("minecraft:written_book_content")) else return false
            let generation = int_of(field(content, "generation")) ?? 0
            if (low != none and generation < (low ?? 0)) or (high != none and generation > (high ?? 0)) {
                return false
            }
            if source {
                return false
            }
            source = true
        } else {
            if not c.tests("material", stack) {
                return false
            }
            material = true
        }
    }
    return source and material
}

// A book clone's `allowed_generations`, 0 to 1 where it's left out.
fn generations(value: Tag) -> (i32?, i32?) {
    return match field(value, "allowed_generations") {
        Tag.Int(n) => (some(n), some(n)),
        Tag.Compound(_) => (int_of(field(field(value, "allowed_generations"), "min")), int_of(field(field(value, "allowed_generations"), "max"))),
        _ => (some(0), some(1)),
    }
}

// `FireworkRocketRecipe.matches`: one shell, one to three fuel, and stars.
fn rocket(c: Crafting, input: Input) -> bool {
    if input.count() < 2 {
        return false
    }
    var shell = false
    var fuel: i32 = 0
    for stack in input.items {
        if stack == none {
            continue
        }
        if c.tests("shell", stack) {
            if shell {
                return false
            }
            shell = true
        } else if c.tests("fuel", stack) {
            fuel += 1
            if fuel > 3 {
                return false
            }
        } else if not c.tests("star", stack) {
            return false
        }
    }
    return shell and fuel >= 1
}

// `FireworkStarRecipe.matches`: one fuel, dyes, and at most one twinkle, trail and shape each.
fn star(c: Crafting, input: Input, items: ItemCodecs) -> bool {
    if input.count() < 2 {
        return false
    }
    var fuel = false
    var dyed = false
    var shape = false
    var trail = false
    var twinkle = false
    for stack in input.items {
        if stack == none {
            continue
        }
        if c.tests("twinkle", stack) {
            if twinkle {
                return false
            }
            twinkle = true
        } else if c.tests("trail", stack) {
            if trail {
                return false
            }
            trail = true
        } else if c.tests("fuel", stack) {
            if fuel {
                return false
            }
            fuel = true
        } else if c.tests("dye", stack) and has(stack, "minecraft:dye", items) {
            dyed = true
        } else {
            if shape_of(c, stack) == "" {
                return false
            }
            if shape {
                return false
            }
            shape = true
        }
    }
    return fuel and dyed
}

// The shape a firework star's ingredient gives, `findShape`, or nothing.
fn shape_of(c: Crafting, stack: Tag?) -> String {
    for (name, ingredient) in c.parts {
        if name.starts_with("shape:") and ingredient.test(stack) {
            return name[6..].copy()
        }
    }
    return String()
}

// `BannerDuplicateRecipe.matches`: two banners of one color, one with up to 6 patterns and one
// with none.
fn copies_banner(c: Crafting, input: Input, items: ItemCodecs) -> bool {
    if input.count() != 2 {
        return false
    }
    var color = String()
    var target = false
    var source = false
    for stack in input.items {
        if stack == none {
            continue
        }
        let this_color = banner_color(stack)
        if not c.tests("banner", stack) or this_color == "" {
            return false
        }
        if color == "" {
            color = this_color.copy()
        } else if color != this_color {
            return false
        }
        let n = patterns(stack, items)
        if n > 6 {
            return false
        }
        if n > 0 {
            if source {
                return false
            }
            source = true
        } else {
            if target {
                return false
            }
            target = true
        }
    }
    return source and target
}

// `ShieldDecorationRecipe.matches`: a banner and a shield with no patterns.
fn decorates_shield(c: Crafting, input: Input, items: ItemCodecs) -> bool {
    if input.count() != 2 {
        return false
    }
    var target = false
    var banner = false
    for stack in input.items {
        if stack == none {
            continue
        }
        if c.tests("banner", stack) and banner_color(stack) != "" {
            if banner {
                return false
            }
            banner = true
        } else {
            if not c.tests("target", stack) {
                return false
            }
            if target {
                return false
            }
            if patterns(stack, items) > 0 {
                return false
            }
            target = true
        }
    }
    return target and banner
}

// `RepairItemRecipe.getItemsToCombine`: two stacks of one item, one of each, both with a maximum
// damage and a damage.
fn repaired(input: Input, items: ItemCodecs) -> (Tag, Tag)? {
    if input.count() != 2 {
        return none
    }
    var first: Tag? = none
    for stack in input.items {
        if stack == none {
            continue
        }
        if let f = first {
            let s = stack.copy() ?? Tag.End
            let combines = item_of(stack) == item_of(some(f.copy())) and count_of(some(f.copy())) == 1 and count_of(stack) == 1 and has(some(f.copy()), "minecraft:max_damage", items) and has(stack, "minecraft:max_damage", items) and has(some(f.copy()), "minecraft:damage", items) and has(stack, "minecraft:damage", items)
            if combines {
                return some((f.copy(), s))
            }
            return none
        }
        first = stack.copy()
    }
    return none
}

// What the recipe `c`, whose value is `value`, makes of `input`, as its class's `assemble` has it.
fn assemble(c: Crafting, value: Tag, input: Input, items: ItemCodecs) -> Tag? {
    let kind = c.kind.copy()
    let given = field(value, "result")
    if kind == "minecraft:crafting_shaped" or kind == "minecraft:crafting_shapeless" {
        return template(given, items)
    }
    if kind == "minecraft:crafting_transmute" {
        var found: Tag? = none
        var materials: i32 = 0
        let adds = flag(field(value, "add_material_count_to_result"))
        for stack in input.items {
            if stack == none {
                continue
            }
            if c.tests("input", stack) {
                found = stack.copy()
                if not adds {
                    break
                }
            } else if c.tests("material", stack) {
                materials += 1
            }
        }
        if found == none {
            return none
        }
        return transmuted(value, found, if adds { materials } else { 0 }, items)
    }
    if kind == "minecraft:crafting_dye" {
        var target: Tag? = none
        var colors = List<String>()
        for stack in input.items {
            if stack == none {
                continue
            }
            if c.tests("target", stack) {
                if target != none {
                    return none
                }
                target = stack.copy()
            } else {
                if not c.tests("dye", stack) {
                    return none
                }
                colors.push(dye_of(stack, items))
            }
        }
        if target == none or colors.is_empty() {
            return none
        }
        let current = items.component(target.copy() ?? Tag.End, String("minecraft:dyed_color"))
        var patch = patch_of(target)
        apply(mut patch, field(given, "components"))
        put(mut patch, "minecraft:dyed_color", Tag.Int(mixed(current, colors)))
        return made(result_item(given), result_count_of(given), patch, items)
    }
    if kind == "minecraft:crafting_imbue" {
        var patch = components_of(given)
        let source = input.at(1, 1)
        match items.component(source.copy() ?? Tag.End, String("minecraft:potion_contents")) {
            some(p) => put(mut patch, "minecraft:potion_contents", p),
            none => {
                // `set(POTION_CONTENTS, null)` takes it away.
                _ = patch.remove(String("minecraft:potion_contents"))
                patch.insert(String("!minecraft:potion_contents"), Tag.Compound(JavaHashMap<String, Tag>()))
            },
        }
        return made(result_item(given), result_count_of(given), patch, items)
    }
    if kind == "minecraft:crafting_decorated_pot" {
        var decorations = JavaHashMap<String, Tag>()
        let sides: List<(str, usize, usize)> = [("back", 1, 0), ("left", 0, 1), ("right", 2, 1), ("front", 1, 2)]
        for (side, x, y) in sides {
            let stack = input.at(x, y)
            if stack != none {
                var one = JavaHashMap<String, Tag>()
                one.insert(String("id"), Tag.Str(item_of(stack)))
                let patch = patch_of(stack)
                if not patch.is_empty() {
                    one.insert(String("components"), Tag.Compound(patch))
                }
                decorations.insert(String(side), Tag.Compound(one))
            }
        }
        var patch = components_of(given)
        put(mut patch, "minecraft:pot_decorations", Tag.Compound(decorations))
        return made(result_item(given), result_count_of(given), patch, items)
    }
    if kind == "minecraft:crafting_special_bookcloning" {
        var source: Tag? = none
        var count: i32 = 0
        for stack in input.items {
            if stack == none {
                continue
            }
            if c.tests("source", stack) and has(stack, "minecraft:written_book_content", items) {
                if source != none {
                    return none
                }
                source = stack.copy()
            } else {
                if not c.tests("material", stack) {
                    return none
                }
                count += 1
            }
        }
        let book = source else return none
        let content = items.component(book.copy(), String("minecraft:written_book_content")) else return none
        let Tag.Compound(m) = content else return none
        var copied = m.copy()
        copied.insert(String("generation"), Tag.Int((int_of(field(content, "generation")) ?? 0) + 1))
        var patch = patch_of(some(book))
        apply(mut patch, field(given, "components"))
        put(mut patch, "minecraft:written_book_content", Tag.Compound(copied))
        return made(result_item(given), result_count_of(given) + count - 1, patch, items)
    }
    if kind == "minecraft:crafting_special_firework_rocket" {
        var fuel: i32 = 0
        var explosions = List<Tag>()
        for stack in input.items {
            if stack == none {
                continue
            }
            if c.tests("fuel", stack) {
                fuel += 1
            } else if c.tests("star", stack) {
                if let e = items.component(stack.copy() ?? Tag.End, String("minecraft:firework_explosion")) {
                    explosions.push(e)
                }
            }
        }
        var fireworks = JavaHashMap<String, Tag>()
        fireworks.insert(String("flight_duration"), Tag.Byte(i8.wrap(fuel)))
        fireworks.insert(String("explosions"), Tag.List(explosions))
        var patch = components_of(given)
        put(mut patch, "minecraft:fireworks", Tag.Compound(fireworks))
        return made(result_item(given), result_count_of(given), patch, items)
    }
    if kind == "minecraft:crafting_special_firework_star" {
        var shape = String("small_ball")
        var twinkle = false
        var trail = false
        var colors = List<Tag>()
        for stack in input.items {
            if stack == none {
                continue
            }
            let found = shape_of(c, stack)
            if found != "" {
                shape = found
            } else if c.tests("twinkle", stack) {
                twinkle = true
            } else if c.tests("trail", stack) {
                trail = true
            } else if c.tests("dye", stack) {
                colors.push(Tag.Int(firework_color(dye_of(stack, items))))
            }
        }
        var explosion = JavaHashMap<String, Tag>()
        explosion.insert(String("shape"), Tag.Str(shape))
        explosion.insert(String("colors"), Tag.List(colors))
        explosion.insert(String("has_trail"), Tag.Byte(if trail { 1i8 } else { 0i8 }))
        explosion.insert(String("has_twinkle"), Tag.Byte(if twinkle { 1i8 } else { 0i8 }))
        var patch = components_of(given)
        put(mut patch, "minecraft:firework_explosion", Tag.Compound(explosion))
        return made(result_item(given), result_count_of(given), patch, items)
    }
    if kind == "minecraft:crafting_special_firework_star_fade" {
        var target: Tag? = none
        var colors = List<Tag>()
        for stack in input.items {
            if c.tests("dye", stack) {
                colors.push(Tag.Int(firework_color(dye_of(stack, items))))
            } else if c.tests("target", stack) {
                target = stack.copy()
            }
        }
        if target == none or colors.is_empty() {
            return none
        }
        let current = items.component(target.copy() ?? Tag.End, String("minecraft:firework_explosion"))
        var explosion = match current {
            some(Tag.Compound(m)) => m.copy(),
            _ => {
                var d = JavaHashMap<String, Tag>()
                d.insert(String("shape"), Tag.Str(String("small_ball")))
                d
            },
        }
        explosion.insert(String("fade_colors"), Tag.List(colors))
        var patch = patch_of(target)
        apply(mut patch, field(given, "components"))
        put(mut patch, "minecraft:firework_explosion", Tag.Compound(explosion))
        return made(result_item(given), result_count_of(given), patch, items)
    }
    if kind == "minecraft:crafting_special_bannerduplicate" {
        for stack in input.items {
            if stack == none {
                continue
            }
            let n = patterns(stack, items)
            if n > 0 and n <= 6 {
                return with_original(result_item(given), result_count_of(given), field(given, "components"), stack, items)
            }
        }
        return none
    }
    if kind == "minecraft:crafting_special_shielddecoration" {
        var layers: Tag? = none
        var color = String("white")
        var target: Tag? = none
        for stack in input.items {
            if stack == none {
                continue
            }
            if c.tests("banner", stack) and banner_color(stack) != "" {
                layers = items.component(stack.copy() ?? Tag.End, String("minecraft:banner_patterns"))
                color = banner_color(stack)
            } else if c.tests("target", stack) {
                target = stack.copy()
            }
        }
        var patch = patch_of(target)
        apply(mut patch, field(given, "components"))
        match layers {
            some(l) => put(mut patch, "minecraft:banner_patterns", l),
            none => {
                _ = patch.remove(String("minecraft:banner_patterns"))
                patch.insert(String("!minecraft:banner_patterns"), Tag.Compound(JavaHashMap<String, Tag>()))
            },
        }
        put(mut patch, "minecraft:base_color", Tag.Str(color))
        return made(result_item(given), result_count_of(given), patch, items)
    }
    if kind == "minecraft:crafting_special_repairitem" {
        let (first, second) = repaired(input, items) else return none
        let most = int_of(items.component(first.copy(), String("minecraft:max_damage")) ?? Tag.End) ?? 0
        let other = int_of(items.component(second.copy(), String("minecraft:max_damage")) ?? Tag.End) ?? 0
        let durability = most.max(other)
        let left_first = most - (int_of(items.component(first.copy(), String("minecraft:damage")) ?? Tag.End) ?? 0)
        let left_second = other - (int_of(items.component(second.copy(), String("minecraft:damage")) ?? Tag.End) ?? 0)
        let left = left_first + left_second + durability * 5 / 100
        var patch = JavaHashMap<String, Tag>()
        put(mut patch, "minecraft:max_damage", Tag.Int(durability))
        put(mut patch, "minecraft:damage", Tag.Int((durability - left).max(0)))
        let item = item_of(some(first.copy()))
        let stored = item == "minecraft:enchanted_book"
        let name = if stored { "minecraft:stored_enchantments" } else { "minecraft:enchantments" }
        let curses = curses_of(first, second, name, items)
        if not curses.is_empty() {
            put(mut patch, name, Tag.Compound(curses))
        }
        return made(item, 1, patch, items)
    }
    return none
}

// The curses `first` and `second` have of the enchantments component `name`, each at the higher
// of their levels, as `RepairItemRecipe.assemble` keeps them.
fn curses_of(first: Tag, second: Tag, name: str, items: ItemCodecs) -> JavaHashMap<String, Tag> {
    var out = JavaHashMap<String, Tag>()
    for stack in [first.copy(), second.copy()] {
        match items.component(stack, String(name)) {
            some(Tag.Compound(m)) => {
                for (enchantment, level) in m {
                    if not items.is_curse(enchantment) {
                        continue
                    }
                    let n = int_of(level.copy()) ?? 0
                    let had = if out.contains(enchantment.copy()) { int_of(out[enchantment.copy()].copy()) ?? 0 } else { 0 }
                    out.insert(enchantment.copy(), Tag.Int(n.max(had)))
                }
            },
            _ => {},
        }
    }
    return out
}

// `DyedItemColor.applyDyes`: the color `current`, if there's one, mixed with each of `dyes`'
// texture colors, averaged, then brightened to their average brightness.
fn mixed(current: Tag?, added: List<String>) -> i32 {
    var red: i32 = 0
    var green: i32 = 0
    var blue: i32 = 0
    var intensity: i32 = 0
    var n: i32 = 0
    var colors = List<i32>()
    if let c = current {
        if let rgb = int_of(c) {
            colors.push(rgb)
        }
    }
    for dye in added {
        colors.push(texture_color(dye))
    }
    for color in colors {
        let r = (color >> 16) & 255
        let g = (color >> 8) & 255
        let b = color & 255
        intensity += r.max(g.max(b))
        red += r
        green += g
        blue += b
        n += 1
    }
    let r = red / n
    let g = green / n
    let b = blue / n
    let average = f32.nearest(intensity) / f32.nearest(n)
    let most = f32.nearest(r.max(g.max(b)))
    let rr = i32.saturate(f32.nearest(r) * average / most)
    let gg = i32.saturate(f32.nearest(g) * average / most)
    let bb = i32.saturate(f32.nearest(b) * average / most)
    return (rr << 16) | (gg << 8) | bb
}

// The 16 dyes, in `DyeColor`'s order, each with its texture's color and its firework's.
fn dye_table() -> List<(str, i32, i32)> {
    return [
        ("white", 16383998, 15790320), ("orange", 16351261, 15435844), ("magenta", 13061821, 12801229),
        ("light_blue", 3847130, 6719955), ("yellow", 16701501, 14602026), ("lime", 8439583, 4312372),
        ("pink", 15961002, 14188952), ("gray", 4673362, 4408131), ("light_gray", 10329495, 11250603),
        ("cyan", 1481884, 2651799), ("purple", 8991416, 8073150), ("blue", 3949738, 2437522),
        ("brown", 8606770, 5320730), ("green", 6192150, 3887386), ("red", 11546150, 11743532),
        ("black", 1908001, 1973019),
    ]
}

// `DyeColor.getTextureDiffuseColor` of the dye `name`.
fn texture_color(name: String) -> i32 {
    for (n, texture, _) in dye_table() {
        if name == String(n) {
            return texture
        }
    }
    return 16383998
}

// `DyeColor.getFireworkColor` of the dye `name`.
fn firework_color(name: String) -> i32 {
    for (n, _, firework) in dye_table() {
        if name == String(n) {
            return firework
        }
    }
    return 15790320
}

// The dye `stack` is, its `dye`, white where it has none, as `getOrDefault` gives it.
fn dye_of(stack: Tag?, items: ItemCodecs) -> String {
    return match items.component(stack.copy() ?? Tag.End, String("minecraft:dye")) {
        some(Tag.Str(s)) => s.copy(),
        _ => String("white"),
    }
}

// The color of the banner `stack` is, `BannerItem.getColor`, or nothing where it isn't a banner.
fn banner_color(stack: Tag?) -> String {
    let item = item_of(stack)
    for (n, _, _) in dye_table() {
        if item == "minecraft:{n}_banner" {
            return String(n)
        }
    }
    return String()
}

// How many patterns `stack`'s banner layers have.
fn patterns(stack: Tag?, items: ItemCodecs) -> usize {
    return match items.component(stack.copy() ?? Tag.End, String("minecraft:banner_patterns")) {
        some(Tag.List(layers)) => layers.len(),
        _ => 0,
    }
}

// Whether `stack` has the component `name`, its patch's or its item's.
fn has(stack: Tag?, name: str, items: ItemCodecs) -> bool {
    let s = stack else return false
    return items.component(s, String(name)) != none
}

// `ItemStackTemplate.create`: the template `t`, `{id, count, components}`, as a stack.
fn template(t: Tag, items: ItemCodecs) -> Tag? {
    return made(result_item(t), result_count_of(t), components_of(t), items)
}

fn result_item(t: Tag) -> String {
    return match field(t, "id") {
        Tag.Str(s) => s.copy(),
        _ => String("minecraft:air"),
    }
}

fn result_count_of(t: Tag) -> i32 {
    return int_of(field(t, "count")) ?? 1
}

// The patch `components` of a template, as a map.
fn components_of(t: Tag) -> JavaHashMap<String, Tag> {
    return match field(t, "components") {
        Tag.Compound(m) => m.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

// `stack`'s patch, as a map.
fn patch_of(stack: Tag?) -> JavaHashMap<String, Tag> {
    return components_of(stack.copy() ?? Tag.End)
}

// `applyComponents`: each of `components`, a patch, over `patch`, a value in place of what was
// there and a type taken away in place of its value.
fn apply(patch: mut JavaHashMap<String, Tag>, components: Tag) {
    let Tag.Compound(m) = components else return
    for (k, v) in m {
        if k.starts_with("!") {
            _ = patch.remove(k[1..].copy())
            patch.insert(k.copy(), v.copy())
        } else {
            _ = patch.remove("!{k}")
            patch.insert(k.copy(), v.copy())
        }
    }
}

// The component `name` set to `value` in `patch`, `ItemStack.set`.
fn put(patch: mut JavaHashMap<String, Tag>, name: str, value: own Tag) {
    _ = patch.remove("!{name}")
    patch.insert(String(name), value)
}

// `count` of `item` with `patch`, made as `ItemStack`'s constructor makes it, against the item's
// defaults: nothing where it's air, there are none, or it doesn't read.
fn made(item: String, count: i32, patch: JavaHashMap<String, Tag>, items: ItemCodecs) -> Tag? {
    if item == "minecraft:air" or count <= 0 {
        return none
    }
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(item.copy()))
    m.insert(String("count"), Tag.Int(count))
    if not patch.is_empty() {
        m.insert(String("components"), Tag.Compound(patch.copy()))
    }
    return items.stack(Tag.Compound(m), false)
}

// A stack of `count` of `item`, with no components of its own.
fn plain(item: String, count: i32) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(item.copy()))
    m.insert(String("count"), Tag.Int(count))
    return Tag.Compound(m)
}

// `stack` with a count of `n`.
fn with_count(stack: Tag?, n: i32) -> Tag? {
    let Tag.Compound(m) = stack.copy() ?? Tag.End else return none
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return some(Tag.Compound(out))
}

// `ItemStack.isSameItemSameComponents`.
fn same_item_components(a: Tag?, b: Tag?) -> bool {
    return item_of(a) == item_of(b) and same_tag(field(a.copy() ?? Tag.End, "components"), field(b.copy() ?? Tag.End, "components"))
}

fn same_tag(a: Tag, b: Tag) -> bool {
    return a.to_snbt() == b.to_snbt()
}

fn item_of(stack: Tag?) -> String {
    return match field(stack.copy() ?? Tag.End, "id") {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}

fn count_of(stack: Tag?) -> i32 {
    if stack == none {
        return 0
    }
    return int_of(field(stack.copy() ?? Tag.End, "count")) ?? 1
}

// The field `key` of the compound `value`, or `Tag.End` where it has none.
fn field(value: Tag, key: str) -> Tag {
    match value {
        Tag.Compound(m) => {
            if m.contains(String(key)) {
                return m[String(key)].copy()
            }
        },
        _ => {},
    }
    return Tag.End
}

fn int_of(t: Tag) -> i32? {
    return match t {
        Tag.Int(n) => some(n),
        Tag.Byte(n) => some(i32(n)),
        Tag.Short(n) => some(i32(n)),
        _ => none,
    }
}

fn flag(t: Tag) -> bool {
    return match t {
        Tag.Byte(n) => n != 0,
        _ => false,
    }
}
