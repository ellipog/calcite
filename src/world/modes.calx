/// A player's game mode and the world's difficulty, as vanilla's `GameType` and `Difficulty`
/// name, number and send them.
module world.modes

import protocol.wire.{Reader, Writer, DecodeError, Wire}

/// How a player plays, vanilla's `GameType`.
pub enum GameType {
    Survival
    Creative
    Adventure
    Spectator
}

impl GameType {
    /// The mode with the ID, or survival for one out of range, as vanilla's `byId`.
    pub fn by_id(id: i32) -> GameType {
        return if id == 1 { GameType.Creative } else if id == 2 { GameType.Adventure } else if id == 3 { GameType.Spectator } else { GameType.Survival }
    }

    /// The mode named `name`, such as `creative`, or none.
    pub fn by_name(name: String) -> GameType? {
        for m in [GameType.Survival, GameType.Creative, GameType.Adventure, GameType.Spectator] {
            if m.name() == name {
                return some(m)
            }
        }
        return none
    }

    pub fn id(self) -> i32 {
        return match self {
            GameType.Survival => 0,
            GameType.Creative => 1,
            GameType.Adventure => 2,
            GameType.Spectator => 3,
        }
    }

    /// Its name, as server.properties and commands write it.
    pub fn name(self) -> String {
        return match self {
            GameType.Survival => String("survival"),
            GameType.Creative => String("creative"),
            GameType.Adventure => String("adventure"),
            GameType.Spectator => String("spectator"),
        }
    }
}

impl Wire for GameType {
    fn read(r: mut Reader) -> GameType ! DecodeError {
        return GameType.by_id(try r.varint())
    }

    fn write(self, w: mut Writer) {
        w.varint(self.id())
    }
}

/// A game mode a player may not have had, as vanilla's `GameType.OPTIONAL_STREAM_CODEC` sends
/// it: the ID plus one, or 0 for none.
pub struct PreviousGameType {
    pub mode: GameType?
}

impl Wire for PreviousGameType {
    fn read(r: mut Reader) -> PreviousGameType ! DecodeError {
        let id = try r.varint()
        return PreviousGameType { mode: if id == 0 { none } else { some(GameType.by_id(id - 1)) } }
    }

    fn write(self, w: mut Writer) {
        w.varint(match self.mode {
            some(m) => m.id() + 1,
            none => 0,
        })
    }
}

/// How hard the world is, vanilla's `Difficulty`.
pub enum Difficulty {
    Peaceful
    Easy
    Normal
    Hard
}

impl Difficulty {
    /// The difficulty with the ID, which wraps around, as vanilla's `byId`.
    pub fn by_id(id: i32) -> Difficulty {
        let n = ((id % 4) + 4) % 4
        return if n == 0 { Difficulty.Peaceful } else if n == 1 { Difficulty.Easy } else if n == 2 { Difficulty.Normal } else { Difficulty.Hard }
    }

    /// The difficulty named `name`, such as `hard`, or none.
    pub fn by_name(name: String) -> Difficulty? {
        for d in [Difficulty.Peaceful, Difficulty.Easy, Difficulty.Normal, Difficulty.Hard] {
            if d.name() == name {
                return some(d)
            }
        }
        return none
    }

    pub fn id(self) -> i32 {
        return match self {
            Difficulty.Peaceful => 0,
            Difficulty.Easy => 1,
            Difficulty.Normal => 2,
            Difficulty.Hard => 3,
        }
    }

    pub fn name(self) -> String {
        return match self {
            Difficulty.Peaceful => String("peaceful"),
            Difficulty.Easy => String("easy"),
            Difficulty.Normal => String("normal"),
            Difficulty.Hard => String("hard"),
        }
    }
}

impl Wire for Difficulty {
    fn read(r: mut Reader) -> Difficulty ! DecodeError {
        return Difficulty.by_id(try r.varint())
    }

    fn write(self, w: mut Writer) {
        w.varint(self.id())
    }
}
