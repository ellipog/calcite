/// A smithing table's work, as vanilla's `SmithingMenu` does it (CAL-338): the smithing recipe its
/// template, base and addition match, `getRecipeFor`, and what it makes of them, `assemble`.
module world.smithing

import nbt.tag.{Tag}
import registry.codec.{same}
import registry.components.{ItemCodecs}
import world.crafting.{with_original}
import world.grindstone.{set_component}
import world.recipes.{Ingredient, Recipes}

/// `getRecipeFor(RecipeType.SMITHING, ...)`: the first smithing recipe, by its place among
/// `recipes.smithing`, whose template, base and addition hold the three stacks, `matches`, a
/// missing template or addition taking only nothing; none where none does.
pub fn smithing_find(recipes: Recipes, template: Tag?, base: Tag?, addition: Tag?) -> usize? {
    for k in 0..recipes.smithing.len() {
        let r = recipes.smithing[k].copy()
        if optional_holds(r.template, template.copy()) and r.base.test(base.copy()) and optional_holds(r.addition, addition.copy()) {
            return some(k)
        }
    }
    return none
}

/// `assemble` of the smithing recipe `k` of `recipes.smithing` for the three stacks: a transform's
/// result with the base's components, `createWithOriginalComponents`; a trim's base, one of it,
/// with the trim of the addition's `provides_trim_material` and the recipe's pattern,
/// `applyTrim`, none where the addition gives no material or the base has that trim already.
pub fn smithing_made(recipes: Recipes, k: usize, base: Tag?, addition: Tag?, items: ItemCodecs) -> Tag? {
    let r = recipes.smithing[k].copy()
    if not r.trim {
        let item = match field(r.result, "id") {
            Tag.Str(s) => s.copy(),
            _ => return none,
        }
        let count = match field(r.result, "count") {
            Tag.Int(n) => n,
            _ => 1,
        }
        return with_original(item, count, field(r.result, "components"), base, items)
    }
    let b = base else return none
    let a = addition else return none
    let material = items.component(a, String("minecraft:provides_trim_material")) else return none
    var trim = JavaHashMap<String, Tag>()
    trim.insert(String("material"), material)
    trim.insert(String("pattern"), r.pattern.copy())
    let made = Tag.Compound(trim)
    if let existing = items.component(b, String("minecraft:trim")) {
        if same(existing, made.copy()) {
            return none
        }
    }
    return some(set_component(with_count(b, 1), "minecraft:trim", made, items))
}

// `Ingredient.testOptionalIngredient`: the ingredient's test, or nothing where there's none.
fn optional_holds(ingredient: Ingredient?, stack: Tag?) -> bool {
    return match ingredient {
        some(i) => i.test(stack),
        none => stack == none,
    }
}

fn field(t: Tag, name: str) -> Tag {
    let Tag.Compound(m) = t else return Tag.End
    if not m.contains(name) {
        return Tag.End
    }
    return m[name].copy()
}

fn with_count(stack: Tag, n: i32) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var out = m.copy()
    out.insert(String("count"), Tag.Int(n))
    return Tag.Compound(out)
}
