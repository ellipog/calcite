/// What each of vanilla 26.3's block states is, as the game's state cache holds it, in state ID
/// order. Written by oracle/datagen/calx_tables.py from block_flags.json (D164): don't edit it.
module world.block_flags

/// `isAir`: air, cave air and void air.
pub const AIR: u32 = 1
/// `isRandomlyTicking`: the state takes random ticks.
pub const RANDOMLY_TICKING: u32 = 2
/// The state's fluid isn't empty: water, lava, or a waterlogged block.
pub const FLUID: u32 = 4
/// The state's fluid takes random ticks: lava.
pub const FLUID_RANDOMLY_TICKING: u32 = 8
/// `propagatesSkylightDown`: skylight goes down through it undimmed.
pub const PROPAGATES_SKYLIGHT_DOWN: u32 = 16
/// `useShapeForLightOcclusion`: light is stopped by its faces, not the whole block.
pub const SHAPE_FOR_LIGHT_OCCLUSION: u32 = 32
/// `canOcclude`.
pub const CAN_OCCLUDE: u32 = 64
/// `isSolidRender`: a full, opaque cube.
pub const SOLID_RENDER: u32 = 128
/// `hasBlockEntity`.
pub const BLOCK_ENTITY: u32 = 256
/// `Block.isFaceFull` of its collision shape on `UP`: something can stand on all of its top.
pub const COLLISION_TOP_FULL: u32 = 512
/// `hasLargeCollisionShape`: its collision shape reaches out of its block, or changes with where it is.
pub const LARGE_COLLISION: u32 = 1024
/// `hasOffsetFunction`: its shapes are moved in its block by where it is, as bamboo's.
pub const OFFSET: u32 = 2048

/// Where a state's light emission, 0 to 15, is in its flags.
pub const LIGHT_EMISSION_SHIFT: u32 = 12
/// Where a state's light dampening, 0 to 15, is in its flags: how much light it takes away.
pub const LIGHT_DAMPENING_SHIFT: u32 = 16

