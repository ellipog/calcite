/// What an entity is inside as it moves, vanilla's `Entity.checkInsideBlocks` (D434): the blocks
/// its box goes through along each of the moves it made in its tick, `movementThisTick`, each
/// move gone along axis by axis where it was asked for, `axisDependentOriginalMovement`, the
/// blocks met as `BlockGetter.forEachBlockIntersectedBetween` meets them, in its steps; and the
/// effects those blocks put on it, gathered step by step and applied in their order,
/// `InsideBlockEffectApplier.StepBasedCollector`.
///
/// A block's inside is all of it, `Shapes.block()`, but a cauldron's, which is its walls and what
/// fills it. A block met is gone into once in a tick, however many moves meet it.
module world.inside

import java.long_set.{LongOpenHashSet}
import world.collision.{Aabb, CollisionBlocks}
import world.currents.{height}
import world.flowing.{liquid_of}
import worldgen.facts.{EMPTY_FLUID, FLOWING_LAVA, Facts, LAVA_FLUID}

/// A move an entity made in its tick, `Entity.Movement`: from where to where, and the move it was
/// asked to make, which says the order the axes are gone along in, where there was one.
pub struct Movement {
    pub from: (f64, f64, f64)
    pub to: (f64, f64, f64)
    pub asked: (f64, f64, f64)? = none
}

/// A block a move went into: where it is, its state, the step of the move it was met at, whether
/// the entity's box went into its inside, `block`, or its fluid, `fluid`, and whether it's met
/// where the box ends or on a move of a block or more, `isPrecise`.
pub struct Inside {
    pub x: i32
    pub y: i32
    pub z: i32
    pub state: u32
    pub step: i32
    pub block: bool
    pub fluid: bool
    pub precise: bool
}

/// The blocks an entity `width` across and `height` high goes into along `moves`, in the order it
/// goes into them, each once: `checkInsideBlocks`. Each move may meet 16 steps of blocks, and
/// those after a move that used them all up are only those where it ends.
pub fn inside_blocks<B: CollisionBlocks>(f: Facts, blocks: B, moves: List<Movement>, width: f32, high: f32) -> List<Inside> {
    var out = List<Inside>()
    var visited = LongOpenHashSet.new()
    for mv in moves {
        let (fx, fy, fz) = mv.from
        let (tx, ty, tz) = mv.to
        let (dx, dy, dz) = (tx - fx, ty - fy, tz - fz)
        var left = 16
        if let (ax, _, az) = mv.asked {
            if dx * dx + dy * dy + dz * dz > 0.0 {
                // `Direction.axisStepOrder`: y first, then the one it was asked to go less along.
                let order: List<i32> = if ax.abs() < az.abs() { [1, 2, 0] } else { [1, 0, 2] }
                var px = fx
                var py = fy
                var pz = fz
                for axis in order {
                    let along = if axis == 0 { dx } else if axis == 1 { dy } else { dz }
                    if along != 0.0 {
                        let (nx, ny, nz) = if axis == 0 { (px + along, py, pz) } else if axis == 1 { (px, py + along, pz) } else { (px, py, pz + along) }
                        left -= walk(f, blocks, (px, py, pz), (nx, ny, nz), width, high, mut visited, left, mut out)
                        px = nx
                        py = ny
                        pz = nz
                    }
                }
            } else {
                left -= walk(f, blocks, mv.from, mv.to, width, high, mut visited, 16, mut out)
            }
        } else {
            left -= walk(f, blocks, mv.from, mv.to, width, high, mut visited, 16, mut out)
        }
        if left <= 0 {
            _ = walk(f, blocks, mv.to, mv.to, width, high, mut visited, 1, mut out)
        }
    }
    return out
}

// One stretch of a move, from `from` to `to`, its steps below `most`: each block met that isn't
// air and whose inside or fluid the box went into, `collidedWithShapeMovingFrom` from where it
// began, kept where it isn't yet; how many steps it went, the last one met and 1.
fn walk<B: CollisionBlocks>(f: Facts, blocks: B, from: (f64, f64, f64), to: (f64, f64, f64), width: f32, high: f32, visited: mut LongOpenHashSet, most: i32, out: mut List<Inside>) -> i32 {
    let (tx, ty, tz) = to
    let (fx, fy, fz) = from
    let target = box_at(tx, ty, tz, width, high).deflate(f64(1.0e-5f32))
    let start = box_at(fx, fy, fz, width, high)
    let (dx, dy, dz) = (tx - fx, ty - fy, tz - fz)
    let far = dx * dx + dy * dy + dz * dz > 0.9999900000002526 * 0.9999900000002526
    var last = 0
    for (x, y, z, step) in intersected(from, to, target) {
        if step >= most {
            break
        }
        last = step
        let state = blocks.collision_state(x, y, z) ?? 0
        if f.is_air(state) {
            continue
        }
        var block = true
        if let boxes = inside_shape(f, state) {
            block = swept_into(start, dx, dy, dz, boxes, x, y, z)
        }
        let fluid = fluid_met(f, blocks, state, x, y, z, start, dx, dy, dz)
        if (block or fluid) and visited.add(key(x, y, z)) {
            let precise = far or target.intersects(f64(x), f64(y), f64(z), f64(x + 1), f64(y + 1), f64(z + 1))
            out.push(Inside { x: x, y: y, z: z, state: state, step: step, block: block, fluid: fluid, precise: precise })
        }
    }
    return last + 1
}

// `BlockGetter.forEachBlockIntersectedBetween` of a move from `from` to `to` of the box `target`
// where it ends: where it hardly moves, the blocks of that box, x first, then y, then z, all at
// step 0; else the blocks of the box where it began, at 0, then those its leading corner goes
// through, `addCollisionsAlongTravel`, at each step, then the rest of the box where it ends, a
// step after the last.
fn intersected(from: (f64, f64, f64), to: (f64, f64, f64), target: Aabb) -> List<(i32, i32, i32, i32)> {
    var out = List<(i32, i32, i32, i32)>()
    let (fx, fy, fz) = from
    let (tx, ty, tz) = to
    let (dx, dy, dz) = (tx - fx, ty - fy, tz - fz)
    if dx * dx + dy * dy + dz * dz < f64(1.0e-5f32 * 1.0e-5f32) {
        let (x0, y0, z0) = (floor(target.min_x), floor(target.min_y), floor(target.min_z))
        let (x1, y1, z1) = (floor(target.max_x), floor(target.max_y), floor(target.max_z))
        for z in z0.min(z1)..=z0.max(z1) {
            for y in y0.min(y1)..=y0.max(y1) {
                for x in x0.min(x1)..=x0.max(x1) {
                    out.push((x, y, z, 0))
                }
            }
        }
        return out
    }
    var seen = LongOpenHashSet.new()
    let back = Aabb { min_x: target.min_x - dx, min_y: target.min_y - dy, min_z: target.min_z - dz, max_x: target.max_x - dx, max_y: target.max_y - dy, max_z: target.max_z - dz }
    for (x, y, z) in corners_toward(floor(back.min_x), floor(back.min_y), floor(back.min_z), floor(back.max_x), floor(back.max_y), floor(back.max_z), dx, dy, dz) {
        out.push((x, y, z, 0))
        _ = seen.add(key(x, y, z))
    }
    let steps = along_travel(mut seen, dx, dy, dz, target, mut out)
    for (x, y, z) in corners_toward(floor(target.min_x), floor(target.min_y), floor(target.min_z), floor(target.max_x), floor(target.max_y), floor(target.max_z), dx, dy, dz) {
        if seen.add(key(x, y, z)) {
            out.push((x, y, z, steps + 1))
        }
    }
    return out
}

// `addCollisionsAlongTravel`: the blocks the box's leading corner, `getFurthestCorner`, goes
// through on its way, as a line through the grid, each step the blocks between the block it went
// into, where the line meets it, and the corner opposite, as far back as the box is across, in
// the move's direction; how many steps there were.
fn along_travel(seen: mut LongOpenHashSet, dx: f64, dy: f64, dz: f64, target: Aabb, out: mut List<(i32, i32, i32, i32)>) -> i32 {
    let (sx, sy, sz) = (target.max_x - target.min_x, target.max_y - target.min_y, target.max_z - target.min_z)
    let (kx, ky, kz) = furthest_corner(dx, dy, dz)
    let (cx, cy, cz) = ((target.min_x + target.max_x) * 0.5, (target.min_y + target.max_y) * 0.5, (target.min_z + target.max_z) * 0.5)
    let to_x = cx + sx * 0.5 * f64(kx)
    let to_y = cy + sy * 0.5 * f64(ky)
    let to_z = cz + sz * 0.5 * f64(kz)
    let (from_x, from_y, from_z) = (to_x - dx, to_y - dy, to_z - dz)
    var bx = floor(from_x)
    var by = floor(from_y)
    var bz = floor(from_z)
    let (gx, gy, gz) = (sign(dx), sign(dy), sign(dz))
    let delta_x = if gx == 0 { f64.MAX } else { f64(gx) / dx }
    let delta_y = if gy == 0 { f64.MAX } else { f64(gy) / dy }
    let delta_z = if gz == 0 { f64.MAX } else { f64(gz) / dz }
    var t_x = delta_x * (if gx > 0 { 1.0 - frac(from_x) } else { frac(from_x) })
    var t_y = delta_y * (if gy > 0 { 1.0 - frac(from_y) } else { frac(from_y) })
    var t_z = delta_z * (if gz > 0 { 1.0 - frac(from_z) } else { frac(from_z) })
    var steps = 0
    while t_x <= 1.0 or t_y <= 1.0 or t_z <= 1.0 {
        if t_x < t_y {
            if t_x < t_z {
                bx += gx
                t_x += delta_x
            } else {
                bz += gz
                t_z += delta_z
            }
        } else if t_y < t_z {
            by += gy
            t_y += delta_y
        } else {
            bz += gz
            t_z += delta_z
        }
        let hit = box_clip(f64(bx), f64(by), f64(bz), f64(bx + 1), f64(by + 1), f64(bz + 1), (from_x, from_y, from_z), (to_x, to_y, to_z)) else continue
        steps += 1
        let (hx, hy, hz) = hit
        // The bounds are a float's nudge in, and a double's out, as vanilla's sums are.
        let px = clamp(hx, f64(f32.nearest(bx) + 1.0e-5f32), f64(bx) + 1.0 - f64(1.0e-5f32))
        let py = clamp(hy, f64(f32.nearest(by) + 1.0e-5f32), f64(by) + 1.0 - f64(1.0e-5f32))
        let pz = clamp(hz, f64(f32.nearest(bz) + 1.0e-5f32), f64(bz) + 1.0 - f64(1.0e-5f32))
        let ox = floor(px - sx * f64(kx))
        let oy = floor(py - sy * f64(ky))
        let oz = floor(pz - sz * f64(kz))
        for (x, y, z) in corners_toward(bx, by, bz, ox, oy, oz, dx, dy, dz) {
            if seen.add(key(x, y, z)) {
                out.push((x, y, z, steps))
            }
        }
    }
    return steps
}

// `getFurthestCorner` of the direction dx, dy, dz, as vanilla picks it from the axis it goes
// least along.
fn furthest_corner(dx: f64, dy: f64, dz: f64) -> (i32, i32, i32) {
    let (ax, ay, az) = (dx.abs(), dy.abs(), dz.abs())
    let xs = if dx >= 0.0 { 1 } else { -1 }
    let ys = if dy >= 0.0 { 1 } else { -1 }
    let zs = if dz >= 0.0 { 1 } else { -1 }
    if ax <= ay and ax <= az {
        return (-xs, -zs, ys)
    }
    if ay <= az {
        return (zs, -ys, -xs)
    }
    return (-ys, xs, -zs)
}

// `BlockPos.betweenCornersInDirection` of the corners x0, y0, z0 and x1, y1, z1 toward dx, dy, dz:
// from the corner the direction leaves, along the axes in `axisStepOrder`'s order, the last
// fastest, each the way the direction goes, a nought counting as forward.
fn corners_toward(x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, dx: f64, dy: f64, dz: f64) -> List<(i32, i32, i32)> {
    var out = List<(i32, i32, i32)>()
    let (lx, ly, lz) = (x0.min(x1), y0.min(y1), z0.min(z1))
    let (hx, hy, hz) = (x0.max(x1), y0.max(y1), z0.max(z1))
    let start: List<i32> = [if dx >= 0.0 { lx } else { hx }, if dy >= 0.0 { ly } else { hy }, if dz >= 0.0 { lz } else { hz }]
    let ways: List<i32> = [if dx >= 0.0 { 1 } else { -1 }, if dy >= 0.0 { 1 } else { -1 }, if dz >= 0.0 { 1 } else { -1 }]
    let spans: List<i32> = [hx - lx, hy - ly, hz - lz]
    let order: List<usize> = if dx.abs() < dz.abs() { [1, 2, 0] } else { [1, 0, 2] }
    let (a, b, c) = (order[0], order[1], order[2])
    for i in 0..=spans[a] {
        for j in 0..=spans[b] {
            for k in 0..=spans[c] {
                var at: List<i32> = [start[0], start[1], start[2]]
                at[a] = at[a] + ways[a] * i
                at[b] = at[b] + ways[b] * j
                at[c] = at[c] + ways[c] * k
                out.push((at[0], at[1], at[2]))
            }
        }
    }
    return out
}

/// The boxes of the inside of the state, `getEntityInsideCollisionShape`, where it isn't all of
/// the block: a water or powder snow cauldron's walls and what fills it to its level, a lava
/// cauldron's walls and its lava, `FILLED_SHAPE`. None for all of it.
pub fn inside_shape(f: Facts, state: u32) -> List<Aabb>? {
    let block = f.block(state)
    if f.is_a(block, String("LayeredCauldronBlock")) {
        let level = f.get_int(state, String("level")) ?? 1
        return some(filled_cauldron(6.0 + f64(level) * 3.0))
    }
    if f.is_a(block, String("LavaCauldronBlock")) {
        return some(filled_cauldron(15.0))
    }
    return none
}

// A cauldron's walls, `AbstractCauldronBlock.SHAPE`, a block but its inside, 12 across from 4 up,
// and the gaps between its feet, 3 high; and what fills it up to `top` pixels, in blocks.
fn filled_cauldron(top: f64) -> List<Aabb> {
    var boxes: List<Aabb> = [
        pixels(0.0, 3.0, 0.0, 16.0, 4.0, 16.0),
        pixels(0.0, 4.0, 0.0, 2.0, 16.0, 16.0),
        pixels(14.0, 4.0, 0.0, 16.0, 16.0, 16.0),
        pixels(2.0, 4.0, 0.0, 14.0, 16.0, 2.0),
        pixels(2.0, 4.0, 14.0, 14.0, 16.0, 16.0),
        pixels(2.0, 4.0, 2.0, 14.0, top, 14.0),
    ]
    // Its feet: in each corner, the 4 by 4 but the 2 by 2 toward the middle.
    for (x, z) in [(0.0, 0.0), (12.0, 0.0), (0.0, 12.0), (12.0, 12.0)] {
        let ix = if x == 0.0 { 2.0 } else { 12.0 }
        let (ox, oz) = (if x == 0.0 { 0.0 } else { 14.0 }, if z == 0.0 { 0.0 } else { 14.0 })
        boxes.push(pixels(ox, 0.0, z, ox + 2.0, 3.0, z + 4.0))
        boxes.push(pixels(ix, 0.0, oz, ix + 2.0, 3.0, oz + 2.0))
    }
    return boxes
}

fn pixels(x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) -> Aabb {
    return Aabb { min_x: x0 / 16.0, min_y: y0 / 16.0, min_z: z0 / 16.0, max_x: x1 / 16.0, max_y: y1 / 16.0, max_z: z1 / 16.0 }
}

// `collidedWithFluid`: whether the box `start`, moving dx, dy, dz, goes into the fluid of the state
// at x, y, z, as high as it comes up its block, `FluidState.getAABB`.
fn fluid_met<B: CollisionBlocks>(f: Facts, blocks: B, state: u32, x: i32, y: i32, z: i32, start: Aabb, dx: f64, dy: f64, dz: f64) -> bool {
    let l = liquid_of(f, state)
    if l.fluid == EMPTY_FLUID {
        return false
    }
    let top = f64(height(f, blocks, l, x, y, z))
    let boxes: List<Aabb> = [Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: top, max_z: 1.0 }]
    return swept_into(start, dx, dy, dz, boxes, x, y, z)
}

// `AABB.collidedAlongVector`: whether the box `start`, moving dx, dy, dz, meets any of `boxes`,
// those of the block at x, y, z: each made larger by half the box less 1.0E-7, whether the box's
// middle is in it where it begins or ends, or the line between crosses it.
fn swept_into(start: Aabb, dx: f64, dy: f64, dz: f64, boxes: List<Aabb>, x: i32, y: i32, z: i32) -> bool {
    let (sx, sy, sz) = (start.max_x - start.min_x, start.max_y - start.min_y, start.max_z - start.min_z)
    let from = ((start.min_x + start.max_x) * 0.5, (start.min_y + start.max_y) * 0.5, (start.min_z + start.max_z) * 0.5)
    let (fx, fy, fz) = from
    let to = (fx + dx, fy + dy, fz + dz)
    for b in boxes {
        let (ix, iy, iz) = (sx * 0.5 - 1.0e-7, sy * 0.5 - 1.0e-7, sz * 0.5 - 1.0e-7)
        let g = Aabb { min_x: b.min_x + f64(x) - ix, min_y: b.min_y + f64(y) - iy, min_z: b.min_z + f64(z) - iz, max_x: b.max_x + f64(x) + ix, max_y: b.max_y + f64(y) + iy, max_z: b.max_z + f64(z) + iz }
        if contains(g, to) or contains(g, from) {
            return true
        }
        if box_clip(g.min_x, g.min_y, g.min_z, g.max_x, g.max_y, g.max_z, from, to) != none {
            return true
        }
    }
    return false
}

// `AABB.contains`: the point in the box, its least sides in and its greatest out.
fn contains(b: Aabb, p: (f64, f64, f64)) -> bool {
    let (x, y, z) = p
    return x >= b.min_x and x < b.max_x and y >= b.min_y and y < b.max_y and z >= b.min_z and z < b.max_z
}

/// `AABB.clip` of the box from x0, y0, z0 to x1, y1, z1 by the line from `from` to `to`: where the
/// line first goes into it through a face, the faces facing the line's way each tried in turn,
/// x's, y's and z's; none where it doesn't.
pub fn box_clip(x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64, from: (f64, f64, f64), to: (f64, f64, f64)) -> (f64, f64, f64)? {
    let (fx, fy, fz) = from
    let (tx, ty, tz) = to
    let (dx, dy, dz) = (tx - fx, ty - fy, tz - fz)
    var scale = 1.0
    var hit = false
    if dx > 1.0e-7 {
        if let s = clip_point(scale, dx, dy, dz, x0, y0, y1, z0, z1, fx, fy, fz) {
            scale = s
            hit = true
        }
    } else if dx < -1.0e-7 {
        if let s = clip_point(scale, dx, dy, dz, x1, y0, y1, z0, z1, fx, fy, fz) {
            scale = s
            hit = true
        }
    }
    if dy > 1.0e-7 {
        if let s = clip_point(scale, dy, dz, dx, y0, z0, z1, x0, x1, fy, fz, fx) {
            scale = s
            hit = true
        }
    } else if dy < -1.0e-7 {
        if let s = clip_point(scale, dy, dz, dx, y1, z0, z1, x0, x1, fy, fz, fx) {
            scale = s
            hit = true
        }
    }
    if dz > 1.0e-7 {
        if let s = clip_point(scale, dz, dx, dy, z0, x0, x1, y0, y1, fz, fx, fy) {
            scale = s
            hit = true
        }
    } else if dz < -1.0e-7 {
        if let s = clip_point(scale, dz, dx, dy, z1, x0, x1, y0, y1, fz, fx, fy) {
            scale = s
            hit = true
        }
    }
    if not hit {
        return none
    }
    return some((fx + scale * dx, fy + scale * dy, fz + scale * dz))
}

// `AABB.clipPoint`: how far along the line it crosses the face at `point` of axis a, where that's
// past its start, nearer than `scale`, and within the face's bounds but for 1.0E-7.
fn clip_point(scale: f64, da: f64, db: f64, dc: f64, point: f64, min_b: f64, max_b: f64, min_c: f64, max_c: f64, from_a: f64, from_b: f64, from_c: f64) -> f64? {
    let s = (point - from_a) / da
    let pb = from_b + s * db
    let pc = from_c + s * dc
    if 0.0 < s and s < scale and min_b - 1.0e-7 < pb and pb < max_b + 1.0e-7 and min_c - 1.0e-7 < pc and pc < max_c + 1.0e-7 {
        return some(s)
    }
    return none
}

// `EntityDimensions.makeBoundingBox` at x, y, z, the half width a float.
fn box_at(x: f64, y: f64, z: f64, width: f32, high: f32) -> Aabb {
    let half = f64(width / 2.0f32)
    return Aabb { min_x: x - half, min_y: y, min_z: z - half, max_x: x + half, max_y: y + f64(high), max_z: z + half }
}

// `BlockPos.asLong`.
fn key(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 0x3FFFFFF) << 38) | ((i64(z) & 0x3FFFFFF) << 12) | (i64(y) & 0xFFF)
}

fn floor(v: f64) -> i32 {
    return i32.saturate(v.floor())
}

// `Mth.sign`.
fn sign(v: f64) -> i32 {
    if v == 0.0 {
        return 0
    }
    return if v > 0.0 { 1 } else { -1 }
}

// `Mth.frac`.
fn frac(v: f64) -> f64 {
    return v - v.floor()
}

fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo
    }
    return if v > hi { hi } else { v }
}

/// The effects blocks put on what's inside them, `InsideBlockEffectType`, in the order each step's
/// are applied: freezing, its thawing, fire's lighting, lava's, and putting fire out.
pub const FREEZE: i32 = 0
pub const CLEAR_FREEZE: i32 = 1
pub const FIRE_IGNITE: i32 = 2
pub const LAVA_IGNITE: i32 = 3
pub const EXTINGUISH: i32 = 4

/// What's done to what's inside, in its turn: an effect, a fire's hurt of so much, `in_fire`
/// after fire lights it, lava's, `lavaHurt`, after lava lights it, and a water or powder snow
/// cauldron's taking a burning entity's fire, before putting it out, at its place.
pub enum BlockEffect {
    Apply(i32),
    InFire(f32),
    LavaHurt,
    Doused((i32, i32, i32)),
}

/// `StepBasedCollector`: the effects of each step of the walk, gathered as the blocks met put them
/// on, each once a step, with what's to come before and after each, then put in order as the
/// step's done, `flushStep`, by the effects' order.
pub struct Collector {
    in_step: u32 = 0u32
    around: List<(i32, bool, BlockEffect)> = List<(i32, bool, BlockEffect)>()
    pub effects: List<BlockEffect> = List<BlockEffect>()
    last_step: i32 = -1
}

impl Collector {
    /// `advanceStep`: where the walk's come to a new step, the last one's effects put in order.
    pub fn advance(mut self, step: i32) {
        if self.last_step != step {
            self.last_step = step
            self.flush()
        }
    }

    /// `apply` of the effect `kind` this step.
    pub fn apply(mut self, kind: i32) {
        self.in_step = self.in_step | (1u32 << u32.wrap(kind))
    }

    /// `runBefore`, or with `after` `runAfter`, of `e` beside the effect `kind` this step.
    pub fn beside(mut self, kind: i32, after: bool, e: BlockEffect) {
        self.around.push((kind, after, e))
    }

    /// `applyAndClear`'s order: the last step's put in order, then all of them, which it gives up.
    pub fn finish(mut self) -> List<BlockEffect> {
        self.flush()
        self.last_step = -1
        let done = self.effects.copy()
        self.effects.clear()
        return done
    }

    fn flush(mut self) {
        var out = List<BlockEffect>()
        for kind in FREEZE..=EXTINGUISH {
            for (k, after, e) in self.around {
                if k == kind and not after {
                    out.push(e)
                }
            }
            if self.in_step & (1u32 << u32.wrap(kind)) != 0 {
                out.push(BlockEffect.Apply(kind))
            }
            for (k, after, e) in self.around {
                if k == kind and after {
                    out.push(e)
                }
            }
        }
        self.in_step = 0u32
        self.around.clear()
        for e in out {
            self.effects.push(e)
        }
    }
}

/// Where it rains, which puts out what burns in it (D434).
pub interface Rain {
    /// `isRainingAt`: raining, the block open to the sky, and its biome rainy there.
    fn rains_on(self, x: i32, y: i32, z: i32) -> bool
}

/// What a block an entity goes into does to it at once, as it goes in, `entityInside` (D434):
/// nothing; a lit campfire's hurt of so much of `campfire`; a cactus's, 1 of `cactus`; or what
/// Calcite doesn't do yet, to be said.
pub enum Touched {
    Nothing
    Campfire(f32)
    Cactus
    Missing(String)
}

/// What a block an item or orb steps on or goes into does that its level's to do (D435): redstone
/// ore at its place lit, a wooden button an arrow went into at its place pressed (CAL-159), or
/// what Calcite doesn't do yet, to be said.
pub enum Acted {
    Lit((i32, i32, i32))
    Pressed((i32, i32, i32))
    Missing(String)
}

/// What's said to be missing of a cauldron taking the fire of what burns in it (D434).
pub fn doused() -> String {
    return String("Cauldrons taking the fire of what burns in them")
}

/// `entityInside` of the block `i` an entity went into, as it goes in, the effects that puts on it
/// gathered in `c` (D434), `alive` where it's a living entity and `item` where it's an item, on
/// the ground or not, `on_ground`, at the height `y`: fire, and soul fire, thaws it and lights it,
/// then hurts it, 1, or 2, of `in_fire`; a lit campfire hurts what's alive at once, 1, or 2 for a
/// soul campfire, `Touched`, as cactus does anything; a water or powder snow cauldron puts it out,
/// taking the fire of what burns in it first, `Doused`; a lava cauldron is as lava is,
/// `lava_effects`. What pressure plates, tripwire, big dripleaves, cobwebs, powder snow, honey,
/// bubble columns, portals, end gateways and detector rails do is said to be missing, and sweet
/// berry bushes and wither roses for what's alive, and hoppers for an item (D435); the rest do
/// nothing to what Calcite runs, but bees in open eyeblossoms.
pub fn touch_block(f: Facts, i: Inside, c: mut Collector, alive: bool, item: bool, on_ground: bool, y: f64) -> Touched {
    let block = f.block(i.state)
    let name = f.codec.blocks.name(block)
    if f.is_a(block, String("BaseFireBlock")) {
        c.apply(CLEAR_FREEZE)
        c.apply(FIRE_IGNITE)
        c.beside(FIRE_IGNITE, true, BlockEffect.InFire(if name == "minecraft:soul_fire" { 2.0f32 } else { 1.0f32 }))
        return Touched.Nothing
    }
    if f.is_a(block, String("CampfireBlock")) {
        if alive and f.get_bool(i.state, String("lit")) {
            return Touched.Campfire(if name == "minecraft:soul_campfire" { 2.0f32 } else { 1.0f32 })
        }
        return Touched.Nothing
    }
    if f.is_a(block, String("CactusBlock")) {
        return Touched.Cactus
    }
    if f.is_a(block, String("LayeredCauldronBlock")) {
        c.beside(EXTINGUISH, false, BlockEffect.Doused((i.x, i.y, i.z)))
        c.apply(EXTINGUISH)
        return Touched.Nothing
    }
    if f.is_a(block, String("LavaCauldronBlock")) {
        lava_effects(mut c)
        return Touched.Nothing
    }
    let powered = f.get_bool(i.state, String("powered")) or (f.get_int(i.state, String("power")) ?? 0) > 0
    if f.is_a(block, String("BasePressurePlateBlock")) and not powered {
        return Touched.Missing(String("Pressure plates pressed by what's on them"))
    }
    if f.is_a(block, String("TripWireBlock")) and not powered {
        return Touched.Missing(String("Tripwire gone through"))
    }
    if f.is_a(block, String("DetectorRailBlock")) and not powered {
        return Touched.Missing(String("Detector rails gone into, which look for minecarts"))
    }
    if f.is_a(block, String("BigDripleafBlock")) {
        let flat = (f.get_name(i.state, String("tilt")) ?? String()) == "none"
        if flat and on_ground and y > f64(i.y) + f64(0.6875f32) {
            return Touched.Missing(String("Big dripleaves tilting under what stands on them"))
        }
        return Touched.Nothing
    }
    if item and f.is_a(block, String("HopperBlock")) {
        return Touched.Missing(String("Hoppers taking in the items that go into them"))
    }
    for (cls, what) in [("WebBlock", "Cobwebs slowing what's in them"), ("PowderSnowBlock", "Powder snow"), ("HoneyBlock", "Sliding down honey blocks"), ("BubbleColumnBlock", "Bubble columns"), ("NetherPortalBlock", "Portals gone into"), ("EndPortalBlock", "Portals gone into"), ("EndGatewayBlock", "End gateways gone into")] {
        if f.is_a(block, String(cls)) {
            return Touched.Missing(String(what))
        }
    }
    if alive {
        for (cls, what) in [("SweetBerryBushBlock", "Sweet berry bushes slowing and hurting what's in them"), ("WitherRoseBlock", "Wither roses withering what's in them")] {
            if f.is_a(block, String(cls)) {
                return Touched.Missing(String(what))
            }
        }
    }
    return Touched.Nothing
}

/// What the fluid of the block `i` an entity went into does to it, `FluidState.entityInside`,
/// gathered in `c` (D434): water puts it out, lava as `lava_effects` has it.
pub fn fluid_effects(f: Facts, i: Inside, c: mut Collector) {
    let l = liquid_of(f, i.state)
    if l.fluid == LAVA_FLUID or l.fluid == FLOWING_LAVA {
        lava_effects(mut c)
    } else if l.fluid != EMPTY_FLUID {
        c.apply(EXTINGUISH)
    }
}

// Lava's, and a lava cauldron's: thawing, lighting, then its hurt, `lavaHurt`.
fn lava_effects(c: mut Collector) {
    c.apply(CLEAR_FREEZE)
    c.apply(LAVA_IGNITE)
    c.beside(LAVA_IGNITE, true, BlockEffect.LavaHurt)
}
