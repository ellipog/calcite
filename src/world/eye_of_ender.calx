/// An eye of ender, as vanilla's `EyeOfEnder` makes and runs it (D598): 0.25 by 0.25, its eyes
/// 0.2125 up, with no gravity; its values `Entity`'s, then its stack, `DATA_ITEM_STACK`, one of
/// what it was made from, an eye of ender where that's empty; where it flies to, `target`, none
/// till it's sent off, `signalTo`; its ticks since, `life`; and whether it's dropped as an item as
/// it goes, `surviveAfterDeath`. It saves only its stack, so one loaded flies on as it's moving,
/// to go as an eye does that doesn't survive.
///
/// Each tick, as `tickNonPassenger` and `EyeOfEnder.tick` run it, it's kept where it was,
/// `commonTick`; then `Entity.baseTick`'s: its speed, its portal's cooldown run down, which it
/// never goes through, as it's never inside what it's in, `applyEffectsFromBlocks`; its fluids,
/// the currents pushing it, with a splash coming into water; its fire, which doesn't hurt it,
/// `hurtServer`; its fall halved in lava; and gone below the world. Then it goes where its motion
/// takes it, through anything, its motion turned toward where it's sent first where it's sent,
/// `updateDeltaMovement`; and 80 ticks after it's sent, or made, it's gone, its sound heard,
/// `ENDER_EYE_DEATH`, and its level event 2003 sent where it's gone, `levelEvent`.
module world.eye_of_ender

import nbt.tag.{Tag}
import server.log.{Entry}
import world.body.{Body, BodyFacts, EntitySound, bool_or, int_or}
import world.collision.{CollisionBlocks}
import world.entity_data.{AIR_SUPPLY, CUSTOM_NAME, CUSTOM_NAME_VISIBLE, EntityData, GLOWING_FLAG, NO_GRAVITY, ON_FIRE_FLAG, SHARED_FLAGS, SILENT, TICKS_FROZEN, Value, thrown_data}
import worldgen.facts.{Facts}

/// `LevelEvent.PARTICLES_EYE_OF_ENDER_DEATH`, sent where an eye that doesn't survive goes.
pub const EYE_GONE: i32 = 2003

/// An eye of ender.
pub struct EyeOfEnder {
    /// What every entity has, `world.body`'s; and its values, `Entity`'s, then its stack, as it
    /// saves, which the network packs, and whether it's to be sent again, as a thrown potion's.
    pub body: Body
    pub data: EntityData
    pub item: Tag
    pub item_dirty: bool = true
    /// Where it's sent, `target`; its ticks since, `life`; and whether it's dropped as an item as
    /// it goes, `surviveAfterDeath`.
    pub target: (f64, f64, f64)? = none
    pub life: i32 = 0
    pub survives: bool = false
}

impl EyeOfEnder {
    // `Entity`'s fields, its random first, then its UUID, at x, y, z, the stack `item`.
    fn made(id: i32, seed: i64, x: f64, y: f64, z: f64, item: own Tag) -> EyeOfEnder {
        let body = Body.made(id, seed, x, y, z, 0.25f32, 0.25f32, 0.2125f32, 0.0)
        return EyeOfEnder { body: body, data: thrown_data(), item: item }
    }

    /// An eye thrown from x, y, z, with the ID `id` and a random seeded `seed`, as
    /// `EnderEyeItem.use` makes one: of one of the stack `held`, `setItem`, an eye of ender where
    /// that's empty (D599).
    pub fn thrown(id: i32, seed: i64, x: f64, y: f64, z: f64, held: Tag) -> EyeOfEnder {
        let empty = match held {
            Tag.Compound(m) => (m.contains("count") and (m["count"].number_int() ?? 1) <= 0) or not m.contains("id"),
            _ => true,
        }
        let item = if empty { eye_item() } else { one_of(held) }
        return EyeOfEnder.made(id, seed, x, y, z, item)
    }

    /// `signalTo`: sent toward tx, ty, tz, but where that's more than 12 blocks off across, 12
    /// blocks that way and 8 up; its life begun again, and whether it survives drawn from its
    /// random, four in five (D599).
    pub fn signal_to(mut self, tx: f64, ty: f64, tz: f64) {
        let (dx, dz) = (tx - self.body.x, tz - self.body.z)
        let across = (dx * dx + dz * dz).sqrt()
        if across > 12.0 {
            self.target = some((self.body.x + dx / across * 12.0, self.body.y + 8.0, self.body.z + dz / across * 12.0))
        } else {
            self.target = some((tx, ty, tz))
        }
        self.life = 0
        self.survives = self.body.random.next_int_below(5) > 0
    }

    /// Whether it's silent, `isSilent`, which its sound isn't heard where it is.
    pub fn silent(self) -> bool {
        return self.data.flag(SILENT)
    }

    /// Its tick among `blocks`, as `tickNonPassenger` and `EyeOfEnder.tick` run it, `min_y` the
    /// bottom of its level and `fast_lava` whether its lava's fast: what it heard put in `sounds`.
    /// Whether its life ran out, gone then, for its level to send its event where it is, as it
    /// doesn't survive; gone below the world, it's gone without, unless its life runs out too.
    pub fn tick<B: CollisionBlocks>(mut self, f: Facts, t: BodyFacts, blocks: B, min_y: i32, fast_lava: bool, sounds: mut List<EntitySound>) -> bool {
        // `commonTick`.
        self.body.xo = self.body.x
        self.body.yo = self.body.y
        self.body.zo = self.body.z
        self.body.tick_count += 1
        // `baseTick`.
        self.body.compute_speed()
        if self.body.portal_cooldown > 0 {
            self.body.portal_cooldown -= 1
        }
        _ = self.body.update_fluids_pushed(f, t, blocks, fast_lava, true, true, mut sounds)
        // Its fire burns down; what it'd hurt every 20 ticks doesn't, `hurtServer`.
        _ = self.body.fire_tick(false)
        if self.body.in_lava() {
            self.body.fall = self.body.fall * 0.5
        }
        if self.body.y < f64(min_y - 64) {
            self.body.removed = true
        }
        let shown = self.body.fire_shown()
        self.data.set_flag(SHARED_FLAGS, ON_FIRE_FLAG, shown)
        self.body.first_tick = false
        // `EyeOfEnder.tick`'s own, which goes on where it's gone below the world, as vanilla's
        // doesn't look.
        let (nx, ny, nz) = (self.body.x + self.body.vx, self.body.y + self.body.vy, self.body.z + self.body.vz)
        if let (tx, ty, tz) = self.target {
            let (vx, vy, vz) = turned_toward(self.body.vx, self.body.vy, self.body.vz, nx, ny, nz, tx, ty, tz)
            self.body.vx = vx
            self.body.vy = vy
            self.body.vz = vz
        }
        self.body.x = nx
        self.body.y = ny
        self.body.z = nz
        self.life += 1
        if self.life <= 80 {
            return false
        }
        if not self.silent() {
            sounds.push(EntitySound { sound: String("entity.ender_eye.death"), x: nx, y: ny, z: nz, volume: 1.0f32, pitch: 1.0f32, source: self.body.sound_source })
        }
        self.body.removed = true
        return true
    }

    /// What `saveAsPassenger` saves of it: its type and what every entity saves, `world.body`'s;
    /// then its stack, `Item`.
    pub fn saved(self) -> Tag {
        var t = JavaHashMap<String, Tag>()
        self.body.save_into(mut t, "minecraft:eye_of_ender")
        t.insert(String("Item"), self.item.copy())
        return Tag.Compound(t)
    }

    /// The eye `tag` saves, with the ID `id` and a random seeded `seed`, as `EntityType.create`
    /// makes one and `Entity.load` and `readAdditionalSaveData` read it in: what every entity
    /// reads, `world.body`'s, and its values from it; and one of its stack as the caller read it
    /// with its codec, `item`, an eye of ender where that's none, `setItem`. `none` where it's
    /// somewhere that isn't a number, logged in `lines` as `loadStaticEntity` logs it.
    pub fn loaded(id: i32, seed: i64, tag: JavaHashMap<String, Tag>, item: Tag?, lines: mut List<Entry>) -> EyeOfEnder? {
        var e = EyeOfEnder.made(id, seed, 0.0, 0.0, 0.0, eye_item())
        if not e.body.load_from(tag, mut lines) {
            return none
        }
        e.data.set(AIR_SUPPLY, Value.Number(e.body.air))
        if e.body.extras.contains("CustomName") {
            e.data.set(CUSTOM_NAME, Value.Name(e.body.extras["CustomName"].copy()))
        }
        e.data.set(CUSTOM_NAME_VISIBLE, Value.Bool(bool_or(tag, "CustomNameVisible")))
        e.data.set(SILENT, Value.Bool(bool_or(tag, "Silent")))
        e.data.set(NO_GRAVITY, Value.Bool(e.body.no_gravity))
        e.data.set_flag(SHARED_FLAGS, GLOWING_FLAG, bool_or(tag, "Glowing"))
        e.data.set(TICKS_FROZEN, Value.Number(int_or(tag, "TicksFrozen", 0)))
        if let stack = item {
            e.item = one_of(stack.copy())
        }
        e.item_dirty = true
        return some(e)
    }
}

/// An eye of ender's stack, `getDefaultItem`.
pub fn eye_item() -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String("minecraft:ender_eye")))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

// `updateDeltaMovement`: the motion vx, vy, vz of an eye at x, y, z turned toward tx, ty, tz,
// across at what it was moving across eased a 400th of the way to how far off that is, a fifth
// slower within a block of it, up and down eased toward 1 up, or down where it's above it.
fn turned_toward(vx: f64, vy: f64, vz: f64, x: f64, y: f64, z: f64, tx: f64, ty: f64, tz: f64) -> (f64, f64, f64) {
    let (hx, hz) = (tx - x, tz - z)
    let length = (hx * hx + 0.0 * 0.0 + hz * hz).sqrt()
    let across = (vx * vx + vz * vz).sqrt()
    var speed = across + 0.0025 * (length - across)
    var my = vy
    if length < 1.0 {
        speed = speed * 0.8
        my = my * 0.8
    }
    let wanted = if y - vy < ty { 1.0 } else { -1.0 }
    let scale = speed / length
    // `scale(...).add(0.0, ..., 0.0)`, a zero added across as vanilla adds it, so none is -0.
    return (hx * scale + 0.0, 0.0 * scale + (my + (wanted - my) * 0.015), hz * scale + 0.0)
}

// One of the stack `stack`, `copyWithCount(1)`.
fn one_of(stack: Tag) -> Tag {
    let Tag.Compound(m) = stack else return stack.copy()
    var c = m.copy()
    c.insert(String("count"), Tag.Int(1))
    return Tag.Compound(c)
}
