/// Damage, as vanilla's `DamageSource` and `DamageType` carry it (D416): the damage types, by
/// their IDs in the synchronized registry `damage_type`, each with the tags of `DamageTypeTags`
/// that what's hurt reads, and its exhaustion, scaling and effects (D418); and a damage source, its
/// type, the entity that caused it, the one that dealt it, where it came from, and whether a player
/// in creative mode dealt it.
module world.damage

/// The tags of `DamageTypeTags` a damage type may be in, as bits: `bypasses_cooldown`,
/// `no_knockback`, `no_impact`, `panic_causes`, `is_fire`, `is_fall`, `bypasses_invulnerability`,
/// `bypasses_armor`, `no_anger`, `is_player_attack`, `bypasses_effects`,
/// `bypasses_enchantments`, `is_projectile` and `is_explosion`; and `is_drowning`, `is_freezing`
/// and `damages_helmet` (D418).
pub const BYPASSES_COOLDOWN: u32 = 1u32
pub const NO_KNOCKBACK: u32 = 2u32
pub const NO_IMPACT: u32 = 4u32
pub const PANIC_CAUSES: u32 = 8u32
pub const IS_FIRE: u32 = 16u32
pub const IS_FALL: u32 = 32u32
pub const BYPASSES_INVULNERABILITY: u32 = 64u32
pub const BYPASSES_ARMOR: u32 = 128u32
pub const NO_ANGER: u32 = 256u32
pub const IS_PLAYER_ATTACK: u32 = 512u32
pub const BYPASSES_EFFECTS: u32 = 1024u32
pub const BYPASSES_ENCHANTMENTS: u32 = 2048u32
pub const IS_PROJECTILE: u32 = 4096u32
pub const IS_EXPLOSION: u32 = 8192u32
pub const IS_DROWNING: u32 = 16384u32
pub const IS_FREEZING: u32 = 32768u32
pub const DAMAGES_HELMET: u32 = 65536u32

/// How a damage type scales with the difficulty, `DamageScaling`, and its effects on a player hurt
/// by it, `DamageEffects`, by their places in vanilla's enums (D418).
pub const NEVER: u8 = 0u8
pub const WHEN_CAUSED_BY_LIVING_NON_PLAYER: u8 = 1u8
pub const ALWAYS: u8 = 2u8
pub const HURT: u8 = 0u8
pub const THORNS: u8 = 1u8
pub const DROWNING: u8 = 2u8
pub const BURNING: u8 = 3u8
pub const POKING: u8 = 4u8
pub const FREEZING: u8 = 5u8

/// The tags' names, by their bits' order.
pub fn damage_tag_names() -> List<str> {
    return ["bypasses_cooldown", "no_knockback", "no_impact", "panic_causes", "is_fire", "is_fall", "bypasses_invulnerability", "bypasses_armor", "no_anger", "is_player_attack", "bypasses_effects", "bypasses_enchantments", "is_projectile", "is_explosion", "is_drowning", "is_freezing", "damages_helmet"]
}

/// The damage types: each one's name, without `minecraft:`, its tags' bits, and its food
/// exhaustion, scaling and effects (D418), by its ID.
pub struct DamageTypes {
    pub names: List<String>
    pub tags: List<u32>
    pub exhaustion: List<f32> = List<f32>()
    pub scaling: List<u8> = List<u8>()
    pub effects: List<u8> = List<u8>()
}

impl DamageTypes {
    /// Vanilla 26.3's, in its registry's order, the names' (D416), till the world's are read.
    pub fn vanilla() -> DamageTypes {
        let names: List<str> = ["arrow", "bad_respawn_point", "cactus", "campfire", "cramming", "dragon_breath", "drown", "dry_out", "ender_pearl", "explosion", "fall", "falling_anvil", "falling_block", "falling_stalactite", "fireball", "fireworks", "fly_into_wall", "freeze", "generic", "generic_kill", "hot_floor", "in_fire", "in_wall", "indirect_magic", "lava", "lightning_bolt", "mace_smash", "magic", "mob_attack", "mob_attack_no_aggro", "mob_projectile", "on_fire", "out_of_world", "outside_border", "player_attack", "player_explosion", "sonic_boom", "spear", "spit", "stalagmite", "starve", "sting", "sulfur_cube_hot", "sweet_berry_bush", "thorns", "thrown", "trident", "unattributed_fireball", "wind_charge", "wither", "wither_skull"]
        let tags: List<u32> = [4104u32, 8194u32, 10u32, 18u32, 130u32, 138u32, 16518u32, 2u32, 162u32, 8202u32, 162u32, 65536u32, 65536u32, 65536u32, 4120u32, 8200u32, 130u32, 32906u32, 130u32, 194u32, 26u32, 26u32, 130u32, 136u32, 26u32, 10u32, 520u32, 138u32, 8u32, 256u32, 4104u32, 154u32, 194u32, 130u32, 520u32, 8202u32, 2184u32, 522u32, 0u32, 162u32, 1154u32, 8u32, 26u32, 2u32, 0u32, 4104u32, 4104u32, 4120u32, 4104u32, 138u32, 4104u32]
        let exhaustion: List<f32> = [0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.0f32, 0.0f32, 0.0f32, 0.1f32, 0.0f32, 0.1f32, 0.0f32, 0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 0.1f32, 0.1f32, 0.0f32, 0.0f32, 0.1f32, 0.1f32, 0.1f32, 0.0f32, 0.1f32, 0.1f32, 0.1f32, 0.0f32, 0.0f32, 0.0f32, 0.1f32, 0.1f32, 0.0f32, 0.1f32, 0.1f32, 0.0f32, 0.0f32, 0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.1f32, 0.0f32, 0.1f32]
        let scaling: List<u8> = [1u8, 2u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 2u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 2u8, 2u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8]
        let effects: List<u8> = [0u8, 0u8, 0u8, 3u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 3u8, 0u8, 0u8, 5u8, 0u8, 0u8, 3u8, 3u8, 0u8, 0u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 3u8, 4u8, 1u8, 0u8, 0u8, 3u8, 0u8, 0u8, 0u8]
        var out = List<String>()
        for n in names {
            out.push(String(n))
        }
        return DamageTypes { names: out, tags: tags, exhaustion: exhaustion, scaling: scaling, effects: effects }
    }

    /// The ID of the type named `name`, without `minecraft:`, -1 where there's none.
    pub fn id(self, name: str) -> i32 {
        let wanted = String(name)
        for i in 0..self.names.len() {
            if self.names[i] == wanted {
                return i32.wrap(i)
            }
        }
        return -1
    }

    /// The bits of the tags the type `id` is in, none for one that isn't a type.
    pub fn tags_of(self, id: i32) -> u32 {
        if id < 0 or usize.wrap(id) >= self.tags.len() {
            return 0u32
        }
        return self.tags[usize.wrap(id)]
    }

    /// The food exhaustion a hurt of the type `id` costs, `getFoodExhaustion` (D418).
    pub fn exhaustion_of(self, id: i32) -> f32 {
        if id < 0 or usize.wrap(id) >= self.exhaustion.len() {
            return 0.0f32
        }
        return self.exhaustion[usize.wrap(id)]
    }

    /// How the type `id` scales with the difficulty, `NEVER` for one that isn't a type (D418).
    pub fn scaling_of(self, id: i32) -> u8 {
        if id < 0 or usize.wrap(id) >= self.scaling.len() {
            return NEVER
        }
        return self.scaling[usize.wrap(id)]
    }

    /// The sound a player hurt by the type `id` makes, `DamageEffects.sound()` (D418).
    pub fn player_hurt_sound(self, id: i32) -> str {
        let effect = if id < 0 or usize.wrap(id) >= self.effects.len() { HURT } else { self.effects[usize.wrap(id)] }
        if effect == THORNS {
            return "enchant.thorns.hit"
        }
        if effect == DROWNING {
            return "entity.player.hurt_drown"
        }
        if effect == BURNING {
            return "entity.player.hurt_on_fire"
        }
        if effect == POKING {
            return "entity.player.hurt_sweet_berry_bush"
        }
        if effect == FREEZING {
            return "entity.player.hurt_freeze"
        }
        return "entity.player.hurt"
    }

    /// Whether the type `id` is in the tag of the bit `tag`, `DamageSource.is(tag)`.
    pub fn is(self, id: i32, tag: u32) -> bool {
        if id < 0 or usize.wrap(id) >= self.tags.len() {
            return false
        }
        return self.tags[usize.wrap(id)] & tag != 0u32
    }
}

/// The game rules that keep a player from some damage, `Player.isInvulnerableTo` (D418):
/// `drowning_damage`, `fall_damage`, `fire_damage` and `freeze_damage`, each on by default.
pub struct DamageRules {
    pub drowning: bool = true
    pub fall: bool = true
    pub fire: bool = true
    pub freeze: bool = true
}

impl DamageRules {
    /// Whether they keep a player from being hurt by the type `id`: the first of its tags
    /// `is_drowning`, `is_fall`, `is_fire` and `is_freezing` it's in decides.
    pub fn spare(self, types: DamageTypes, id: i32) -> bool {
        if types.is(id, IS_DROWNING) {
            return not self.drowning
        }
        if types.is(id, IS_FALL) {
            return not self.fall
        }
        if types.is(id, IS_FIRE) {
            return not self.fire
        }
        return types.is(id, IS_FREEZING) and not self.freeze
    }
}

/// A damage source, `DamageSource`: its type, by its ID; the entity that caused it,
/// `getEntity`, and the one that dealt it, `getDirectEntity`, by their IDs, -1 for none; where it
/// came from, `getSourcePosition`, the place it was made with or else the dealer's, and whether it
/// was made with one, `sourcePositionRaw`, which `ClientboundDamageEventPacket` sends; the causing
/// player's UUID where a player caused it, and whether they're in creative mode,
/// `isCreativePlayer`; and whether what caused it is living and not a player, which a type that
/// scales then does (D418).
pub struct Damage {
    pub kind: i32
    pub cause: i32 = -1
    pub direct: i32 = -1
    pub at: (f64, f64, f64)? = none
    pub raw: bool = false
    pub player: (i64, i64)? = none
    pub creative: bool = false
    pub living_cause: bool = false
}

impl Damage {
    /// `DamageSources.playerAttack(player)`: `player_attack` by the player `id` at `x`, `y`,
    /// `z`, of UUID `uuid`, in creative mode or not.
    pub fn player_attack(types: DamageTypes, id: i32, x: f64, y: f64, z: f64, uuid: (i64, i64), creative: bool) -> Damage {
        return Damage { kind: types.id("player_attack"), cause: id, direct: id, at: some((x, y, z)), player: some(uuid), creative: creative }
    }

    /// A source of the type named `name` with nothing behind it, as `DamageSources.fall()` and
    /// `stalagmite()` are (D418).
    pub fn of(types: DamageTypes, name: str) -> Damage {
        return Damage { kind: types.id(name) }
    }

    /// `scalesWithDifficulty` (D418): never, always, or where what caused it is living and not a
    /// player, as its type says.
    pub fn scales(self, types: DamageTypes) -> bool {
        let scaling = types.scaling_of(self.kind)
        return scaling == ALWAYS or (scaling == WHEN_CAUSED_BY_LIVING_NON_PLAYER and self.living_cause)
    }
}
