/// Game events and the block entities that hear them (CAL-275): `GameEventDispatcher.post`,
/// which tells each listener in range of a game event, by its section, as the chunk's
/// `GameEventListenerRegistry` keeps them; a sculk sensor's and a calibrated sensor's
/// `VibrationSystem.Listener.handleGameEvent`, which keeps the vibration it'll take; and its
/// `VibrationSystem.Ticker.tick`, which sends it on its way and has the sensor hear it once it's
/// there; a calibrated sensor only where the signal into its back is 0 or the vibration's
/// frequency; a shrieker's, which its server has shriek; and a catalyst's, which takes a death in,
/// `catalyst_heard`. Entities' listeners are said to be missing.
module world.game_events

import nbt.tag.{Tag}
import world.block_level.{BlockLevel}
import world.pos.{BlockPos}
import world.event_source.{EventSource}
import world.vibrations.{Carried, EntityListener, Hearing, Vibration, frequency, ignored_sneaking, line_blocks, notification_radius, occlusion_lines, redstone_strength}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, opposite, step_x, step_y, step_z}
import worldgen.interval.{Thrown}
import worldgen.signals.{signal}
import worldgen.survive.{facing_of}

/// The game event `event` at x, y, z, made by `source`, of the block `state` where it's a
/// block's, `GameEventDispatcher.post`: each listener of each loaded chunk's sections within the
/// event's radius, chunk by chunk along x then z and up through their sections, whose own radius
/// it's within, block to block, `getPostableListenerPosition`, hears it in its registry's order;
/// all of them are told by distance, `handleGameEventMessagesInQueue`, which only the catalysts
/// told of a death, which the nearest takes in, are kept for, the nearest first, the first found
/// first where two are as near.
pub fn post<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, event: String, x: f64, y: f64, z: f64, source: EventSource, state: u32?) ! Thrown {
    let radius = notification_radius(event.copy())
    let (cx, cy, cz) = (floor(x), floor(y), floor(z))
    var catalysts = List<(f64, BlockPos)>()
    for chunk_x in ((cx - radius) >> 4)..(((cx + radius) >> 4) + 1) {
        for chunk_z in ((cz - radius) >> 4)..(((cz + radius) >> 4) + 1) {
            let found = level.listeners_in(chunk_x, chunk_z) else continue
            for section in ((cy - radius) >> 4)..(((cy + radius) >> 4) + 1) {
                for p in found {
                    if (p.y >> 4) != section {
                        continue
                    }
                    let saved = level.block_entity_tag(p.x, p.y, p.z) else continue
                    let Tag.Compound(tags) = saved else continue
                    let kind = id_of(tags)
                    let reach = listener_radius(kind.copy())
                    let (dx, dy, dz) = (f64(p.x - cx), f64(p.y - cy), f64(p.z - cz))
                    if dx * dx + dy * dy + dz * dz > f64(reach * reach) {
                        continue
                    }
                    if kind == "minecraft:sculk_catalyst" {
                        if event == "minecraft:entity_die" {
                            let (ex, ey, ez) = (x - (f64(p.x) + 0.5), y - (f64(p.y) + 0.5), z - (f64(p.z) + 0.5))
                            let far = ex * ex + ey * ey + ez * ez
                            var at = catalysts.len()
                            while at > 0 and catalysts[at - 1].0 > far {
                                at -= 1
                            }
                            catalysts.insert(at, (far, p))
                        }
                        continue
                    }
                    try hear(f, mut level, p, kind, tags, event.copy(), x, y, z, source, state)
                }
            }
        }
    }
    // The entities' listeners in the sections it reaches, by where they are: an allay's
    // vibrations', `#allay_can_listen`, a note block's, within 16, kept where none's on its way,
    // the event's valid, `isValidVibration`, the allay takes it, `canReceiveVibration`, and the
    // way to its eyes isn't occluded, its distance the source's to its eyes; its jukebox
    // listener's, a jukebox's playing or stopping, within 10, `JukeboxListener`.
    for l in level.entity_listeners() {
        if not reaches(l, cx, cy, cz, radius) {
            continue
        }
        let (dx, dy, dz) = (floor(l.x) - cx, floor(l.y) - cy, floor(l.z) - cz)
        let far = dx * dx + dy * dy + dz * dz
        if event == "minecraft:jukebox_play" or event == "minecraft:jukebox_stop_play" {
            if far <= 100 {
                level.entity_heard(l.id, Hearing.Jukebox(((cx, cy, cz), event == "minecraft:jukebox_play")))
            }
            continue
        }
        if event != "minecraft:note_block_play" or far > 256 or l.busy or l.deaf {
            continue
        }
        if not valid_vibration(f, mut level, event.copy(), source, state, false) {
            continue
        }
        if let liked = l.liked {
            if liked != (cx, cy, cz) {
                continue
            }
        }
        if try occluded(f, level, (x, y, z), (l.x, l.y, l.z)) {
            continue
        }
        let (ex, ey, ez) = (x - l.x, y - l.y, z - l.z)
        let distance = f32.nearest((ex * ex + ey * ey + ez * ez).sqrt())
        let now = level.time_now()
        level.entity_heard(l.id, Hearing.Vibration((Vibration { event: event.copy(), distance: distance, x: x, y: y, z: z, source: source.uuid, owner: source.owner }, now)))
    }
    // A catalyst's `CatalystListener.handleGameEvent` of a death.
    for (_, p) in catalysts {
        try level.catalyst_heard(f, p.x, p.y, p.z, source, (x, y, z))
    }
}

// Whether the listener `l` is in a section an event at `cx`, `cy`, `cz` of `radius` reaches.
fn reaches(l: EntityListener, cx: i32, cy: i32, cz: i32, radius: i32) -> bool {
    let (sx, sy, sz) = (floor(l.x) >> 4, floor(l.y) >> 4, floor(l.z) >> 4)
    return sx >= (cx - radius) >> 4 and sx <= (cx + radius) >> 4 and sz >= (cz - radius) >> 4 and sz <= (cz + radius) >> 4 and sy >= (cy - radius) >> 4 and sy <= (cy + radius) >> 4
}

// A listener's radius by its block entity's type: a calibrated sensor's 16, the others' 8.
fn listener_radius(kind: String) -> i32 {
    return if kind == "minecraft:calibrated_sculk_sensor" { 16 } else { 8 }
}

fn id_of(tags: JavaHashMap<String, Tag>) -> String {
    if not tags.contains("id") {
        return String()
    }
    let Tag.Str(id) = tags["id"] else return String()
    return id.copy()
}

// `VibrationSystem.Listener.handleGameEvent` of the sensor or shrieker at `p`: nothing where it
// has a vibration on its way, the event isn't one of its, `isValidVibration`, it can't take it,
// `canReceiveVibration`, or the way's occluded, `isOccluded`; else kept as a candidate,
// `scheduleVibration`, its distance the source's to its block's middle. A shrieker listens only
// to `#shrieker_can_listen`, a sensor's tendrils clicking, and takes it only where it isn't
// shrieking and there's a player behind it, `tryGetPlayer`. A catalyst hears only deaths, which
// `post` tells it of.
fn hear<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, p: BlockPos, kind: String, tags: JavaHashMap<String, Tag>, event: String, x: f64, y: f64, z: f64, source: EventSource, state: u32?) ! Thrown {
    if kind == "minecraft:sculk_catalyst" {
        return
    }
    let shrieker = kind == "minecraft:sculk_shrieker"
    if not shrieker and kind != "minecraft:sculk_sensor" and kind != "minecraft:calibrated_sculk_sensor" {
        return
    }
    var carried = if tags.contains("listener") { Carried.from_tag(tags["listener"].copy()) } else { Carried {} }
    if carried.current != none {
        return
    }
    let listens = if shrieker { event == "minecraft:sculk_sensor_tendrils_clicking" } else { frequency(event.copy()) != 0 }
    if not listens or not valid_vibration(f, mut level, event.copy(), source, state, not shrieker) {
        return
    }
    let sensor = try level.state(f, p.x, p.y, p.z)
    if shrieker {
        if f.get_bool(sensor, "shrieking") or source.responsible == none {
            return
        }
    } else {
        if (floor(x), floor(y), floor(z)) == (p.x, p.y, p.z) and (event == "minecraft:block_destroy" or event == "minecraft:block_place") {
            return
        }
        if (f.get_name(sensor, "sculk_sensor_phase") ?? String("inactive")) != "inactive" {
            return
        }
    }
    if kind == "minecraft:calibrated_sculk_sensor" and try calibrated_refuses(f, level, p, sensor, event.copy()) {
        return
    }
    let (tx, ty, tz) = (f64(p.x) + 0.5, f64(p.y) + 0.5, f64(p.z) + 0.5)
    if try occluded(f, level, (x, y, z), (tx, ty, tz)) {
        return
    }
    let (dx, dy, dz) = (x - tx, y - ty, z - tz)
    let distance = f32.nearest((dx * dx + dy * dy + dz * dz).sqrt())
    carried.selector.add(Vibration { event: event.copy(), distance: distance, x: x, y: y, z: z, source: source.uuid, owner: source.owner }, level.time_now())
    level.set_block_entity_value(p.x, p.y, p.z, "listener", carried.to_tag())
}

// `CalibratedSculkSensorBlockEntity.VibrationUser.canReceiveVibration`'s input: whether the
// calibrated sensor `state` at `p` refuses `event`, the signal into its back, `getBackSignal`, not
// 0 and not the event's frequency.
fn calibrated_refuses<L: BlockAccess>(f: Facts, level: L, p: BlockPos, state: u32, event: String) -> bool ! Thrown {
    let back = opposite(try facing_of(f, state))
    let input = try signal(f, level, p.x + step_x(back), p.y + step_y(back), p.z + step_z(back), back, true)
    return input != 0 and frequency(event) != input
}

// `VibrationSystem.User.isValidVibration`, the event one its listener listens to: not a
// spectator's, nor one stepping carefully's that's ignored then, which a sensor's `AVOID_VIBRATION`
// trigger, `avoids`, would count for a player, nor one that dampens vibrations; nor of a block of
// `#dampens_vibrations`.
fn valid_vibration<L: BlockLevel>(f: Facts, level: mut L, event: String, source: EventSource, state: u32?, avoids: bool) -> bool {
    if source.id >= 0 {
        if source.spectator {
            return false
        }
        if source.careful and ignored_sneaking(event.copy()) {
            if source.player and avoids {
                level.avoided_vibration(source.id)
            }
            return false
        }
        if source.dampens {
            return false
        }
    }
    let s = state else return true
    return not f.in_set(s, f.tag(String("minecraft:dampens_vibrations")))
}

// `VibrationSystem.Listener.isOccluded`: whether each of the six lines from the source's block's
// middle to the listener's meets a block of `#occludes_vibration_signals`.
fn occluded<L: BlockAccess>(f: Facts, level: L, origin: (f64, f64, f64), dest: (f64, f64, f64)) -> bool ! Thrown {
    let occludes = f.tag(String("minecraft:occludes_vibration_signals"))
    for (from, to) in occlusion_lines(origin, dest) {
        var met = false
        for (bx, by, bz) in line_blocks(from, to) {
            if f.in_set(try level.state(f, bx, by, bz), occludes) {
                met = true
                break
            }
        }
        if not met {
            return false
        }
    }
    return true
}

/// `VibrationSystem.Listener.forceScheduleVibration` of the sculk sensor at x, y, z, stepped on
/// by `source` from `origin`, as `SculkSensorBlock.stepOn` has it: a `STEP` kept as a candidate,
/// its distance the source's to the sensor's middle, whether a vibration's on its way or not, and
/// whoever's it is; a calibrated sensor's where its input lets a step through.
pub fn force_step<L: BlockAccess + BlockLevel>(f: Facts, level: mut L, x: i32, y: i32, z: i32, origin: (f64, f64, f64), source: EventSource) ! Thrown {
    let saved = level.block_entity_tag(x, y, z) else return
    let Tag.Compound(tags) = saved else return
    let kind = id_of(tags)
    if kind == "minecraft:calibrated_sculk_sensor" {
        let state = try level.state(f, x, y, z)
        if try calibrated_refuses(f, level, BlockPos { x: x, y: y, z: z }, state, String("minecraft:step")) {
            return
        }
    } else if kind != "minecraft:sculk_sensor" {
        return
    }
    var carried = if tags.contains("listener") { Carried.from_tag(tags["listener"].copy()) } else { Carried {} }
    let (ox, oy, oz) = origin
    let (dx, dy, dz) = (ox - (f64(x) + 0.5), oy - (f64(y) + 0.5), oz - (f64(z) + 0.5))
    let distance = f32.nearest((dx * dx + dy * dy + dz * dz).sqrt())
    carried.selector.add(Vibration { event: String("minecraft:step"), distance: distance, x: ox, y: oy, z: oz, source: source.uuid, owner: source.owner }, level.time_now())
    level.set_block_entity_value(x, y, z, "listener", carried.to_tag())
}

/// `VibrationSystem.Ticker.tick` of the sensor at x, y, z, its block entity's saved `tags`:
/// with no vibration on its way, the one its selector chose, sent on its way to it, its
/// particle sent, `trySelectAndScheduleVibration`; then the one on its way, its particle sent
/// again once it was read back where a player sees it, `tryReloadVibrationParticle`, a tick
/// nearer, and heard where it's there, `receiveVibration`, as `heard` has the sensor hear it.
/// Its data's saved again where it changed, `onDataChanged`. None of it needs a draw.
pub fn tick_vibration<L: BlockAccess + BlockLevel>(level: mut L, tags: JavaHashMap<String, Tag>, x: i32, y: i32, z: i32) -> Vibration? {
    var carried = if tags.contains("listener") { Carried.from_tag(tags["listener"].copy()) } else { Carried {} }
    var changed = false
    var arrived: Vibration? = none
    if carried.current == none {
        if let chosen = carried.selector.chosen_by(level.time_now()) {
            carried.travel = floor(f64(chosen.distance))
            _ = level.send_vibration(chosen.x, chosen.y, chosen.z, (x, y, z), carried.travel)
            carried.current = some(chosen)
            carried.selector.start_over()
            changed = true
        }
    }
    if let v = carried.current.copy() {
        var moved = carried.travel > 0
        if level.vibration_reload_pending(x, y, z) {
            let (tx, ty, tz) = (f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)
            let initial = floor(f64(v.distance))
            let alpha = 1.0 - f64(carried.travel) / f64(initial)
            let (nx, ny, nz) = (v.x + alpha * (tx - v.x), v.y + alpha * (ty - v.y), v.z + alpha * (tz - v.z))
            if level.send_vibration(nx, ny, nz, (x, y, z), carried.travel) {
                level.vibration_reloaded(x, y, z)
            }
        }
        carried.count_down()
        if carried.travel <= 0 {
            // `receiveVibration`: a sensor's only where the chunks around it tick blocks,
            // `requiresAdjacentChunksToBeTicking`.
            moved = level.chunks_tick_around(x >> 4, z >> 4)
            if moved {
                arrived = some(v.copy())
                carried.current = none
            }
        }
        if moved {
            changed = true
        }
    }
    if changed {
        level.set_block_entity_value(x, y, z, "listener", carried.to_tag())
    }
    return arrived
}

/// `SculkSensorBlockEntity.VibrationUser.onReceiveVibration`'s power for the vibration `v` that
/// came to the sensor at x, y, z: by the blocks between where it came from and the sensor,
/// `distanceBetweenInBlocks`, of its radius, 8, or a calibrated sensor's 16.
pub fn received_power(v: Vibration, x: i32, y: i32, z: i32, calibrated: bool) -> i32 {
    let (dx, dy, dz) = (f64(floor(v.x) - x), f64(floor(v.y) - y), f64(floor(v.z) - z))
    let blocks = f32.nearest((dx * dx + dy * dy + dz * dz).sqrt())
    return redstone_strength(blocks, if calibrated { 16 } else { 8 })
}

// `Mth.floor`.
fn floor(v: f64) -> i32 {
    return i32.saturate(v.floor())
}
