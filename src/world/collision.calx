/// Block collisions, as vanilla's spawn finder checks them: whether a box meets any block,
/// liquids included, `CollisionGetter.noCollision` with no entity and fluids colliding, over the
/// blocks `BlockCollisions` goes through; and whether a block's top can be stood on, from each
/// state's collision shape (`world.collision_shapes`).
///
/// A box meets a block where it overlaps one of the block's boxes, by more than nothing on every
/// axis. The blocks gone through are those within one of the box, as `Cursor3D` gives them:
/// those it's in, those beside them on one face only if their shape can reach out of their block,
/// and none on an edge or a corner, as moving pistons, the only ones vanilla checks there, have no
/// shape without their block entity. A block whose chunk isn't loaded full isn't met, as
/// `getChunkForCollisions` gives none.
///
/// Bamboo, pointed dripstone and sulfur spikes are offset in their blocks by where they are, which
/// these shapes leave out: a player's box at the middle of a block meets one in its own column
/// wherever it's offset to, and one in another column nowhere.
module world.collision

import world.block_flags.{COLLISION_TOP_FULL, FLUID, LARGE_COLLISION, state_flags}
import world.collision_shapes.{BOX_FLOOR, BOX_UNIT, shape_boxes, shape_starts, state_shapes}

/// The blocks collisions are checked against: the state at each, or `none` where its chunk isn't
/// loaded full.
pub interface CollisionBlocks {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32?
}

/// A box, from its least corner to its greatest, vanilla's `AABB`.
pub struct Aabb {
    pub min_x: f64
    pub min_y: f64
    pub min_z: f64
    pub max_x: f64
    pub max_y: f64
    pub max_z: f64
}

impl Aabb {
    /// Whether it overlaps the box from `x0`, `y0`, `z0` to `x1`, `y1`, `z1` by more than nothing
    /// on every axis, as `AABB.intersects`.
    pub fn intersects(self, x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) -> bool {
        return self.min_x < x1 and self.max_x > x0 and self.min_y < y1 and self.max_y > y0 and self.min_z < z1 and self.max_z > z0
    }
}

/// A player's box standing at the bottom middle of the block `x`, `y`, `z`, as
/// `EntityDimensions.makeBoundingBox` makes it of the player's 0.6 by 1.8, which are floats.
pub fn player_box(x: i32, y: i32, z: i32) -> Aabb {
    let half = f64(0.6f32 / 2.0f32)
    let height = f64(1.8f32)
    let cx = f64(x) + 0.5
    let cz = f64(z) + 0.5
    return Aabb { min_x: cx - half, min_y: f64(y), min_z: cz - half, max_x: cx + half, max_y: f64(y) + height, max_z: cz + half }
}

/// A player's box standing at `x`, `y`, `z`, as `player_box` makes it (CAL-139).
pub fn standing_box(x: f64, y: f64, z: f64) -> Aabb {
    let half = f64(0.6f32 / 2.0f32)
    let height = f64(1.8f32)
    return Aabb { min_x: x - half, min_y: y, min_z: z - half, max_x: x + half, max_y: y + height, max_z: z + half }
}

/// What collisions see of each block state.
pub struct CollisionStates {
    // Each state's shape, and its flags.
    shapes: List<u16>
    flags: List<u32>
    // Where each shape's boxes start in `boxes`, in boxes, and the boxes, six coordinates each.
    starts: List<u16>
    boxes: List<u8>
}

impl CollisionStates {
    /// Every state's collision shape and flags.
    pub fn new() -> CollisionStates {
        let shapes = state_shapes()
        let flags = state_flags()
        if shapes.len() != flags.len() {
            panic("{shapes.len()} states' collision shapes for {flags.len()} states")
        }
        return CollisionStates { shapes: shapes, flags: flags, starts: shape_starts(), boxes: shape_boxes() }
    }

    /// Whether something can stand on all of the state's top, `Block.isFaceFull` of its collision
    /// shape on `UP`.
    pub fn top_full(self, state: u32) -> bool {
        return self.flags[usize(state)] & COLLISION_TOP_FULL != 0
    }

    /// Whether the state has a fluid: water, lava, or a waterlogged block.
    pub fn has_fluid(self, state: u32) -> bool {
        return self.flags[usize(state)] & FLUID != 0
    }

    /// Whether `b` meets no block of `blocks`, liquids included, as `noCollision` with fluids
    /// colliding and no entity: no entity collides with it, and the world border doesn't, with
    /// no entity to hold it back.
    pub fn no_collision<B: CollisionBlocks>(self, blocks: B, b: Aabb) -> bool {
        return self.no_collision_but(blocks, b, List<bool>())
    }

    /// Whether `b` meets no block of `blocks`, as `noCollision` with no entity and fluids not
    /// colliding, as natural spawning checks a mob's room (D317): as `no_collision`, but a
    /// liquid, a state `liquid` marks, has no shape, as `LiquidBlock` has none for no entity.
    pub fn no_collision_without_fluids<B: CollisionBlocks>(self, blocks: B, b: Aabb, liquid: List<bool>) -> bool {
        return self.no_collision_but(blocks, b, liquid)
    }

    // `no_collision`, with the states `liquid` marks, if it has any, taken to have no shape.
    fn no_collision_but<B: CollisionBlocks>(self, blocks: B, b: Aabb, liquid: List<bool>) -> bool {
        let x0 = i32.saturate((b.min_x - 1.0e-7).floor()) - 1
        let x1 = i32.saturate((b.max_x + 1.0e-7).floor()) + 1
        let y0 = i32.saturate((b.min_y - 1.0e-7).floor()) - 1
        let y1 = i32.saturate((b.max_y + 1.0e-7).floor()) + 1
        let z0 = i32.saturate((b.min_z - 1.0e-7).floor()) - 1
        let z1 = i32.saturate((b.max_z + 1.0e-7).floor()) + 1
        for z in z0..=z1 {
            for y in y0..=y1 {
                for x in x0..=x1 {
                    var edges = 0
                    if x == x0 or x == x1 {
                        edges += 1
                    }
                    if y == y0 or y == y1 {
                        edges += 1
                    }
                    if z == z0 or z == z1 {
                        edges += 1
                    }
                    if edges >= 2 {
                        continue
                    }
                    let state = blocks.collision_state(x, y, z) else continue
                    if liquid.len() > 0 and liquid[usize(state)] {
                        continue
                    }
                    if edges == 1 and self.flags[usize(state)] & LARGE_COLLISION == 0 {
                        continue
                    }
                    if self.meets(state, x, y, z, b) {
                        return false
                    }
                }
            }
        }
        return true
    }

    /// Whether the state's collision shape at `x`, `y`, `z` overlaps `b` by more than nothing,
    /// as `Shapes.joinIsNotEmpty` with `AND` finds it (CAL-139).
    pub fn meets(self, state: u32, x: i32, y: i32, z: i32, b: Aabb) -> bool {
        let shape = usize(self.shapes[usize(state)])
        for i in usize(self.starts[shape])..usize(self.starts[shape + 1]) {
            let at = i * 6
            if b.intersects(
                f64(x) + self.coordinate(at),
                f64(y) + self.coordinate(at + 1),
                f64(z) + self.coordinate(at + 2),
                f64(x) + self.coordinate(at + 3),
                f64(y) + self.coordinate(at + 4),
                f64(z) + self.coordinate(at + 5),
            ) {
                return true
            }
        }
        return false
    }

    // A box's coordinate, in blocks from its block's least corner: a 32nd, so exactly vanilla's.
    fn coordinate(self, at: usize) -> f64 {
        return f64(i32(self.boxes[at]) + BOX_FLOOR) / f64(BOX_UNIT)
    }
}
