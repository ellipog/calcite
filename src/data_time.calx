/// Scratch, for CAL-88: how long reading vanilla's data takes, and its parts. Not a test.
///
///     calx run --release src/data_time.calx -- PATH
module data_time

import pack.vanilla.{vanilla_data}
import server.log.{Entry}
import std.env.{args}
import std.fs.{read}
import std.hash.{sha256}
import std.time.{Instant}
import std.zip.{Zip}

fn main() {
    let a = args()
    let path = a[0].copy()
    var logs = List<Entry>()
    let t0 = unsafe { Instant.now() }
    let z = vanilla_data(path.copy(), mut logs)!
    let t1 = unsafe { Instant.now() }
    let bytes = read(path.copy())!
    let t2 = unsafe { Instant.now() }
    let h = sha256(bytes)
    let t3 = unsafe { Instant.now() }
    let w = Zip.walk(bytes.copy())!
    let t4 = unsafe { Instant.now() }
    println("vanilla_data {t1.nanos_since(t0) / 1000} us ({z.len()} files); read {t2.nanos_since(t1) / 1000} us, sha256 {t3.nanos_since(t2) / 1000} us ({h.len()}), walk {t4.nanos_since(t3) / 1000} us ({w.len()})")
}
