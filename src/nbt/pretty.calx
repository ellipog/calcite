/// NBT as text, as vanilla's `NbtUtils.toPrettyComponent` shows it, which `data get` answers
/// with (CAL-165): `TextComponentTagVisitor` with no indentation and its rich styling. Keys are
/// aqua, strings green, numbers gold and their type letters red. Each piece is a sibling of one
/// empty component, in the order the visitor appends them, with an empty piece before each of a
/// compound's entries and of a list's that's spread out, where an indentation would go.
/// Compounds go in their maps' order, as vanilla's do unless its debug logging is on. Below 64
/// deep a compound or list shows as `<...>`, as an array's elements past the 128th do.
module nbt.pretty

import chat.component.{Component}
import nbt.tag.{Tag, quote_and_escape}

const MAX_DEPTH: usize = 64
const MAX_LENGTH: usize = 128

/// `tag` as `toPrettyComponent` shows it.
pub fn pretty(tag: Tag) -> Component {
    var p = Printer { out: List<Component>() }
    p.visit(tag)
    var result = Component.empty()
    result.extra = p.out
    return result
}

// The visitor: what it's appended, and how deep it is.
struct Printer {
    out: List<Component>
    depth: usize = 0
}

impl Printer {
    // A piece of plain text.
    fn plain(mut self, text: String) {
        self.out.push(Component.literal(text))
    }

    // A piece of text in the named color.
    fn colored(mut self, text: String, color: str) {
        self.out.push(Component.literal(text).colored(String(color)))
    }

    // A number, then its type's letter where it has one.
    fn number(mut self, text: String, suffix: str) {
        self.colored(text, "gold")
        if suffix != "" {
            self.colored(String(suffix), "red")
        }
    }

    fn visit(mut self, tag: Tag) {
        match tag {
            Tag.End => {},
            Tag.Byte(v) => self.number("{v}", "b"),
            Tag.Short(v) => self.number("{v}", "s"),
            Tag.Int(v) => self.number("{v}", ""),
            Tag.Long(v) => self.number("{v}", "L"),
            Tag.Float(v) => self.number("{v}", "f"),
            Tag.Double(v) => self.number("{v}", "d"),
            Tag.Str(s) => {
                // `visitString`: the quote plain, what's between in green.
                let quoted = quote_and_escape(s)
                let mark = quoted[..1]
                self.plain(mark)
                self.colored(quoted[1..quoted.len() - 1], "green")
                self.plain(mark)
            },
            Tag.ByteArray(values) => {
                var texts = List<String>()
                for v in values {
                    texts.push("{v}")
                }
                self.array("B", texts, "b")
            },
            Tag.IntArray(values) => {
                var texts = List<String>()
                for v in values {
                    texts.push("{v}")
                }
                self.array("I", texts, "")
            },
            Tag.LongArray(values) => {
                var texts = List<String>()
                for v in values {
                    texts.push("{v}")
                }
                self.array("L", texts, "L")
            },
            Tag.List(items) => self.list(items),
            Tag.Compound(m) => self.compound(m),
        }
    }

    // `visitByteArray` and the like: `[`, the type's letter, `;`, then each number after a
    // space, up to 128 of them, with a `,` after each but the last.
    fn array(mut self, prefix: str, texts: List<String>, suffix: str) {
        self.plain("[")
        self.colored(String(prefix), "red")
        self.plain(";")
        var i: usize = 0
        while i < texts.len() and i < MAX_LENGTH {
            self.plain(" ")
            self.number(texts[i].copy(), suffix)
            if i != texts.len() - 1 {
                self.plain(",")
            }
            i += 1
        }
        if texts.len() > MAX_LENGTH {
            self.colored(String("<...>"), "gray")
        }
        self.plain("]")
    }

    // `visitList`: all on one line with `, ` between where it's 8 or more long or only numbers;
    // else each element after an empty piece, at most 128 of them.
    fn list(mut self, items: List<Tag>) {
        if items.is_empty() {
            self.plain("[")
            self.plain("]")
            return
        }
        if self.depth >= MAX_DEPTH {
            self.plain("[")
            self.colored(String("<...>"), "gray")
            self.plain("]")
            return
        }
        self.plain("[")
        if not spread(items) {
            for i in 0..items.len() {
                if i != 0 {
                    self.plain(",")
                    self.plain(" ")
                }
                self.sub(items[i])
            }
        } else {
            var i: usize = 0
            while i < items.len() and i < MAX_LENGTH {
                self.plain("")
                self.sub(items[i])
                if i != items.len() - 1 {
                    self.plain(",")
                    self.plain(" ")
                }
                i += 1
            }
            if items.len() > MAX_LENGTH {
                self.plain("")
                self.colored(String("<...>"), "gray")
            }
        }
        self.plain("]")
    }

    // `visitCompound`: each entry after an empty piece, its key, `:`, a space and its value,
    // with `, ` between.
    fn compound(mut self, m: JavaHashMap<String, Tag>) {
        if m.is_empty() {
            self.plain("\{")
            self.plain("\}")
            return
        }
        if self.depth >= MAX_DEPTH {
            self.plain("\{")
            self.colored(String("<...>"), "gray")
            self.plain("\}")
            return
        }
        self.plain("\{")
        var left = m.len()
        for (k, v) in m {
            self.plain("")
            self.out.push(key_of(k))
            self.plain(":")
            self.plain(" ")
            self.sub(v)
            left -= 1
            if left > 0 {
                self.plain(",")
                self.plain(" ")
            }
        }
        self.plain("\}")
    }

    // `appendSubTag`: `tag` one deeper.
    fn sub(mut self, tag: Tag) {
        self.depth += 1
        self.visit(tag)
        self.depth -= 1
    }
}

// `shouldWrapListElements`: whether a list is spread out, each element after a piece where an
// indentation would go: shorter than 8, with something in it that isn't a number.
fn spread(items: List<Tag>) -> bool {
    if items.len() >= 8 {
        return false
    }
    for t in items {
        match t {
            Tag.Byte(_) => {},
            Tag.Short(_) => {},
            Tag.Int(_) => {},
            Tag.Long(_) => {},
            Tag.Float(_) => {},
            Tag.Double(_) => {},
            _ => return true,
        }
    }
    return false
}

// `handleEscapePretty`: a key in aqua as it is if it's only `[A-Za-z0-9._+-]`, else quoted, the
// quotes plain around it.
fn key_of(key: String) -> Component {
    if simple(key) {
        return Component.literal(key).colored(String("aqua"))
    }
    let quoted = quote_and_escape(key)
    let mark = quoted[..1]
    var c = Component.literal(mark)
    c.extra.push(Component.literal(quoted[1..quoted.len() - 1]).colored(String("aqua")))
    c.extra.push(Component.literal(mark))
    return c
}

// Whether `key` matches `[A-Za-z0-9._+-]+`.
fn simple(key: String) -> bool {
    if key.is_empty() {
        return false
    }
    for i in 0..key.len() {
        let b = key.byte_at(i)
        let allowed = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 46 or b == 95 or b == 43 or b == 45
        if not allowed {
            return false
        }
    }
    return true
}
