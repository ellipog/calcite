/// Vanilla's `Identifier`: a namespace and a path, written `namespace:path`, such as
/// `minecraft:stone`. Without a namespace it's `minecraft`.
module resources.identifier

/// A namespaced name: `namespace` holds `[a-z0-9_.-]` and isn't `..`, and `path` holds
/// `[a-z0-9/._-]`.
pub struct Identifier {
    pub namespace: String
    pub path: String
}

impl Identifier {
    /// `text` as vanilla's `Identifier.parse` reads it: split at the first `:`, with
    /// `minecraft` for a missing or empty namespace. Fails with vanilla's message when a part
    /// has a character it can't.
    pub fn parse(text: String) -> Identifier ! String {
        if let c = text.find(":") {
            let path = text[c + 1..]
            if c == 0 {
                return try Identifier.with_default(path)
            }
            let namespace = text[..c]
            if not valid_namespace(namespace) {
                fail "Non [a-z0-9_.-] character in namespace of identifier: {namespace}:{path}"
            }
            if not valid_path(path) {
                fail "Non [a-z0-9/._-] character in path of location: {namespace}:{path}"
            }
            return Identifier { namespace: namespace, path: path }
        }
        return try Identifier.with_default(text.copy())
    }

    // `path` in `minecraft`.
    fn with_default(path: own String) -> Identifier ! String {
        if not valid_path(path) {
            fail "Non [a-z0-9/._-] character in path of location: minecraft:{path}"
        }
        return Identifier { namespace: "minecraft", path: path }
    }

    /// `namespace:path`, as vanilla's `toString`.
    pub fn to_string(self) -> String {
        return "{self.namespace}:{self.path}"
    }
}

fn valid_path(s: String) -> bool {
    for i in 0..s.len() {
        let c = s.byte_at(i)
        let allowed = c == 95 or c == 45 or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 47 or c == 46
        if not allowed {
            return false
        }
    }
    return true
}

fn valid_namespace(s: String) -> bool {
    if s == ".." {
        return false
    }
    for i in 0..s.len() {
        let c = s.byte_at(i)
        let allowed = c == 95 or c == 45 or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 46
        if not allowed {
            return false
        }
    }
    return true
}
