/// The server's language, vanilla's `Language`: the English text of each translation key, which
/// the server uses where it turns a component into text, as in its log and in the errors of
/// SNBT it reads. A client translates components into its own language, so what it's sent
/// doesn't depend on this.
///
/// The server reads its table from the jar at startup, as vanilla's `Language.loadDefault` does
/// (`pack.vanilla.vanilla_language`). A key the table hasn't is its own text, as in vanilla.
module chat.language

import json.tree.{Json, get, parse_object}

pub struct Language {
    table: Map<String, String>
}

impl Language {
    /// No translations, so every key is its own text.
    pub fn empty() -> Language {
        return Language { table: Map<String, String>() }
    }

    /// The language vanilla's `Language.loadDefault` makes from the text of en_us.json and
    /// deprecated.json. Each of en_us.json's texts has its formats of numbers made formats of
    /// text, as `%d` and `%1$.2f` become `%s` and `%1$s`, since only those are filled in. Then
    /// deprecated.json's `removed` keys are taken out, and each of its `renamed` keys moved to
    /// its new name, in the order the file has them. A rename whose key isn't there takes the
    /// new name out instead, and says so in `warnings`, as vanilla logs it.
    pub fn from_json(en_us: String, deprecated: String, warnings: mut List<String>) -> Language ! String {
        let strings = parse_object(en_us) else fail String("en_us.json isn't a JSON object")
        var table = Map<String, String>()
        for m in strings {
            // Gson's `convertToString` takes any value but an array, an object or `null`.
            let text = match m.value {
                Json.Str(s) => s.copy(),
                Json.Number(n) => n.copy(),
                Json.Bool(b) => "{b}",
                _ => fail "en_us.json's {m.key} isn't a string",
            }
            table.insert(m.key.copy(), text_formats(text))
        }
        let changes = parse_object(deprecated) else fail String("deprecated.json isn't a JSON object")
        let removed = match get(changes, "removed") {
            some(Json.Array(keys)) => keys,
            _ => fail String("deprecated.json has no `removed` list"),
        }
        let renamed = match get(changes, "renamed") {
            some(Json.Object(pairs)) => pairs,
            _ => fail String("deprecated.json has no `renamed` map"),
        }
        for k in removed {
            match k {
                Json.Str(key) => {
                    _ = table.remove(key)
                },
                _ => fail String("deprecated.json's `removed` list holds something that isn't a key"),
            }
        }
        for pair in renamed {
            let to = match pair.value {
                Json.Str(t) => t.copy(),
                _ => fail "deprecated.json renames {pair.key} to something that isn't a key",
            }
            match table.remove(pair.key) {
                some(text) => table.insert(to, text),
                none => {
                    warnings.push("Missing translation key for rename: {pair.key}")
                    _ = table.remove(to)
                },
            }
        }
        return Language { table: table }
    }

    /// Sets the text of `key`.
    pub fn add(mut self, key: own String, text: own String) {
        self.table.insert(key, text)
    }

    /// The text of `key`, or `fallback` if there's none, as vanilla's `getOrDefault`.
    pub fn get_or_default(self, key: String, fallback: String) -> String {
        if self.table.contains(key) {
            return self.table[key].copy()
        }
        return fallback.copy()
    }

    /// How many keys have text.
    pub fn len(self) -> usize {
        return self.table.len()
    }
}

// The text with each format of a number made a format of text, as vanilla replaces
// `%(\d+\$)?[\d.]*[df]` with `%$1s`: `%d` and `%.2f` become `%s`, and `%1$d` becomes `%1$s`.
fn text_formats(text: own String) -> String {
    if not text.contains("%") {
        return text
    }
    var out = String()
    var copied: usize = 0
    var i: usize = 0
    while i < text.len() {
        if text.byte_at(i) != 37 {
            i += 1
            continue
        }
        // With the `n$` first, and if that doesn't match, without it.
        var position = i + 1
        var end = number_format(text, i + 1, true)
        if end == none {
            position = i + 1
            end = number_format(text, i + 1, false)
        } else {
            while text.byte_at(position) != 36 {
                position += 1
            }
            position += 1
        }
        match end {
            some(e) => {
                out.push_str(text[copied..i])
                out.push('%')
                out.push_str(text[i + 1..position])
                out.push('s')
                copied = e
                i = e
            },
            none => i += 1,
        }
    }
    out.push_str(text[copied..])
    return out
}

// Where a format of a number that starts at `at`, just past its `%`, ends: digits and `$` if
// `positional`, then digits and `.`s, then `d` or `f`.
fn number_format(text: String, at: usize, positional: bool) -> usize? {
    let n = text.len()
    var i = at
    if positional {
        while i < n and is_digit(text.byte_at(i)) {
            i += 1
        }
        if i == at or i >= n or text.byte_at(i) != 36 {
            return none
        }
        i += 1
    }
    while i < n and (is_digit(text.byte_at(i)) or text.byte_at(i) == 46) {
        i += 1
    }
    if i < n and (text.byte_at(i) == 100 or text.byte_at(i) == 102) {
        return some(i + 1)
    }
    return none
}

fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57
}
