/// Chat types, vanilla's `ChatType`: how each kind of chat message is shown, from the
/// `chat_type` registry of the data packs. A client knows them from the packs it shares with the
/// server, and is sent each message's type by its ID, so the server needs only the decoration of
/// chat, which turns a message into the text the console logs, as vanilla's
/// `MinecraftServer.logChatMessage` does.
module chat.chat_type

import chat.component.{Component}
import json.tree.{Json, get, parse}
import pack.resources.{Resources}
import registry.registries.{Registries}
import resources.identifier.{Identifier}

/// What fills one of a decoration's `%s`s, vanilla's `ChatTypeDecoration.Parameter`, by its ID.
pub enum Parameter {
    /// Who sent the message, by the name its type was bound to.
    Sender
    /// Who it's for, or nothing.
    Target
    /// The message.
    Content
}

/// How a message is shown, vanilla's `ChatTypeDecoration`: the translation key, and what fills
/// its `%s`s, in order. Its style only colors the text, which the console doesn't show, so it
/// isn't kept.
pub struct Decoration {
    pub translation_key: String
    pub parameters: List<Parameter>
}

impl Decoration {
    /// Vanilla's chat: `<Steve> hello`, as `ChatTypeDecoration.withSender("chat.type.text")`.
    pub fn chat() -> Decoration {
        return Decoration { translation_key: String("chat.type.text"), parameters: [Parameter.Sender, Parameter.Content] }
    }

    /// The decoration of `content`, sent by `name`, to `target` if it's to someone, as
    /// `ChatTypeDecoration.decorate` makes it.
    pub fn decorate(self, content: Component, name: Component, target: Component?) -> Component {
        var args = List<Component>()
        for p in self.parameters {
            args.push(match p {
                Parameter.Sender => name.copy(),
                Parameter.Target => target.copy() ?? Component.empty(),
                Parameter.Content => content.copy(),
            })
        }
        return Component.translatable(self.translation_key, args)
    }

    /// The `chat` decoration of a chat type's JSON, as its codec reads it, or why it can't be
    /// read.
    pub fn from_json(text: String) -> Decoration ! String {
        let value = parse(text) else fail String("isn't JSON")
        let members = match value {
            Json.Object(m) => m,
            _ => fail String("isn't a JSON object"),
        }
        let chat = match get(members, "chat") {
            some(Json.Object(m)) => m,
            _ => fail String("No key chat"),
        }
        let key = match get(chat, "translation_key") {
            some(Json.Str(s)) => s,
            _ => fail String("No key translation_key"),
        }
        let list = match get(chat, "parameters") {
            some(Json.Array(a)) => a,
            _ => fail String("No key parameters"),
        }
        var parameters = List<Parameter>()
        for p in list {
            parameters.push(match p {
                Json.Str(s) => {
                    if s == "sender" {
                        Parameter.Sender
                    } else if s == "target" {
                        Parameter.Target
                    } else if s == "content" {
                        Parameter.Content
                    } else {
                        fail "Unknown element name:{s}"
                    }
                },
                _ => fail String("Not a string"),
            })
        }
        return Decoration { translation_key: key, parameters: parameters }
    }
}

/// Each chat type's decoration, by its ID in the `chat_type` registry, read from its file in the
/// packs, or why one can't be read.
pub fn load_chat_types(resources: Resources, registries: Registries) -> List<Decoration> ! String {
    let r = registries.find(String("chat_type")) else fail String("there's no chat_type registry")
    var files = Map<String, usize>()
    let listed = resources.list(String("chat_type"), String(".json"))
    for i in 0..listed.len() {
        files.insert(listed[i].id.to_string(), i)
    }
    var out = List<Decoration>()
    for entry in registries.synced[r].entries {
        let file = Identifier { namespace: entry.namespace.copy(), path: "chat_type/{entry.path}.json" }
        let i = files.get(file.to_string()) else fail "there's no file for the chat type {entry.to_string()}"
        let bytes = try resources.read(listed[i])
        let text = String.from_utf8(bytes) else fail "{file.to_string()} isn't UTF-8"
        match Decoration.from_json(text) {
            ok(d) => out.push(d),
            err(message) => fail "Couldn't read the chat type {entry.to_string()}: {message}",
        }
    }
    return out
}
