/// Text components, vanilla's `Component`: what chat, disconnect reasons, the server list's
/// description and every other piece of text a client shows are made of.
module chat.component

import chat.language.{Language}
import json.gson.{JsonWriter}

/// A piece of text: what it shows, then its siblings, which follow it. Styles, click and hover
/// events, and the other kinds of contents come with chat.
pub struct Component {
    pub contents: Contents
    pub extra: List<Component>
}

/// What a component shows.
pub enum Contents {
    /// Text as it is, vanilla's `PlainTextContents`.
    Text(String)
    /// A translation key the client looks up in its language, with its arguments, vanilla's
    /// `TranslatableContents`.
    Translatable(Translation)
}

/// A translation key and its arguments, as `{"translate":"multiplayer.disconnect.incompatible","with":["26.3"]}`.
pub struct Translation {
    pub key: String
    /// What to show when the client's language has no such key.
    pub fallback: String?
    pub args: List<Component>
}

impl Component {
    /// `text` as it is, vanilla's `Component.literal`.
    pub fn literal(text: String) -> Component {
        return Component { contents: Contents.Text(text.copy()), extra: List<Component>() }
    }

    /// No text, vanilla's `Component.empty()`, which `literal("")` equals.
    pub fn empty() -> Component {
        return Component.literal("")
    }

    /// The translation of `key`, with `args` in its `%s`s, vanilla's `Component.translatable`.
    pub fn translatable(key: String, args: own List<Component>) -> Component {
        let t = Translation { key: key.copy(), fallback: none, args: args }
        return Component { contents: Contents.Translatable(t), extra: List<Component>() }
    }

    /// Whether it shows nothing: empty text with no siblings, which vanilla's codecs treat as
    /// their default and leave out.
    pub fn is_empty(self) -> bool {
        return match self.contents {
            Contents.Text(t) => t.is_empty() and self.extra.is_empty(),
            _ => false,
        }
    }

    /// The component as vanilla's `ComponentSerialization.CODEC` writes it to JSON: plain text
    /// with no siblings as a bare string, and anything else as an object of its contents' fields,
    /// then `extra`.
    pub fn write_json(self, w: mut JsonWriter) {
        match self.contents {
            Contents.Text(t) => {
                if self.extra.is_empty() {
                    w.string(t)
                    return
                }
                w.begin_object()
                w.name("text")
                w.string(t)
            },
            Contents.Translatable(t) => {
                w.begin_object()
                w.name("translate")
                w.string(t.key)
                if let f = t.fallback {
                    w.name("fallback")
                    w.string(f)
                }
                if not t.args.is_empty() {
                    w.name("with")
                    w.begin_array()
                    for a in t.args {
                        a.write_json(mut w)
                    }
                    w.end_array()
                }
            },
        }
        if not self.extra.is_empty() {
            w.name("extra")
            w.begin_array()
            for e in self.extra {
                e.write_json(mut w)
            }
            w.end_array()
        }
        w.end_object()
    }

    /// The component's JSON, as `write_json` writes it.
    pub fn to_json(self) -> String {
        var w = JsonWriter.new()
        self.write_json(mut w)
        return w.into_string()
    }

    /// The component as text, as vanilla's `getString` gives it: its contents, with a
    /// translation's text from `lang` and its arguments put in, then its siblings'.
    pub fn get_string(self, lang: Language) -> String {
        var out = String()
        self.append_string(lang, mut out)
        return out
    }

    fn append_string(self, lang: Language, out: mut String) {
        match self.contents {
            Contents.Text(t) => out.push_str(t),
            Contents.Translatable(t) => t.append_string(lang, mut out),
        }
        for e in self.extra {
            e.append_string(lang, mut out)
        }
    }
}

impl Translation {
    // The translation as text, as vanilla's `TranslatableContents.decompose` makes it: the key's
    // text in `lang`, or the fallback, or the key, with the arguments put in. Text that isn't a
    // format vanilla reads is shown as it is.
    fn append_string(self, lang: Language, out: mut String) {
        let format = match self.fallback {
            some(f) => lang.get_or_default(self.key, f),
            none => lang.get_or_default(self.key, self.key),
        }
        var filled = String()
        if self.fill(format, lang, mut filled) {
            out.push_str(filled)
        } else {
            out.push_str(format)
        }
    }

    // The format with each `%s` the next argument, each `%n$s` the nth, and each `%%` a `%`, as
    // vanilla's `decomposeTemplate` reads it with its pattern: a `%`, digits and a `$` if it's
    // positional, then a letter, a `%` or the end. False where vanilla throws: another letter,
    // a `%` the pattern doesn't match, or an argument that isn't there.
    fn fill(self, format: String, lang: Language, out: mut String) -> bool {
        let n = format.len()
        var next: usize = 0
        var i: usize = 0
        loop {
            let at = match format[i..].find("%") {
                some(a) => i + a,
                none => {
                    out.push_str(format[i..])
                    return true
                },
            }
            out.push_str(format[i..at])
            var digits = at + 1
            var position: i64 = 0
            while digits < n and is_digit(format.byte_at(digits)) {
                position = position * 10 + i64(format.byte_at(digits) - 48)
                if position > 2147483647 {
                    // Integer.parseInt fails.
                    return false
                }
                digits += 1
            }
            var kind = at + 1
            var positional = false
            if digits > at + 1 and digits < n and format.byte_at(digits) == 36 {
                kind = digits + 1
                positional = true
            }
            if kind == n {
                // The pattern takes a `%` at the end as a format with no letter.
                return false
            }
            let letter = format.byte_at(kind)
            if letter == 37 and kind == at + 1 {
                out.push('%')
                i = kind + 1
                continue
            }
            if letter != 115 {
                return false
            }
            var index = next
            if positional {
                if position == 0 {
                    return false
                }
                index = usize.wrap(position - 1)
            } else {
                next += 1
            }
            if index >= self.args.len() {
                return false
            }
            self.args[index].append_string(lang, mut out)
            i = kind + 1
        }
    }
}

fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57
}
