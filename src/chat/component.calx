/// Text components, vanilla's `Component`: what chat, disconnect reasons, the server list's
/// description and every other piece of text a client shows are made of.
module chat.component

import chat.language.{Language}
import json.gson.{JsonWriter}
import json.tree.{Json, Member, as_string, get, write}
import nbt.tag.{Tag}

/// A piece of text: what it shows, then its siblings, which follow it. Styles, click and hover
/// events, and the other kinds of contents come with chat.
pub struct Component {
    pub contents: Contents
    pub extra: List<Component>
}

/// What a component shows.
pub enum Contents {
    /// Text as it is, vanilla's `PlainTextContents`.
    Text(String)
    /// A translation key the client looks up in its language, with its arguments, vanilla's
    /// `TranslatableContents`.
    Translatable(Translation)
}

/// A translation key and its arguments, as `{"translate":"multiplayer.disconnect.incompatible","with":["26.3"]}`.
pub struct Translation {
    pub key: String
    /// What to show when the client's language has no such key.
    pub fallback: String?
    pub args: List<Component>
}

impl Component {
    /// `text` as it is, vanilla's `Component.literal`.
    pub fn literal(text: String) -> Component {
        return Component { contents: Contents.Text(text.copy()), extra: List<Component>() }
    }

    /// No text, vanilla's `Component.empty()`, which `literal("")` equals.
    pub fn empty() -> Component {
        return Component.literal("")
    }

    /// The translation of `key`, with `args` in its `%s`s, vanilla's `Component.translatable`.
    pub fn translatable(key: String, args: own List<Component>) -> Component {
        let t = Translation { key: key.copy(), fallback: none, args: args }
        return Component { contents: Contents.Translatable(t), extra: List<Component>() }
    }

    /// Whether it shows nothing: empty text with no siblings, which vanilla's codecs treat as
    /// their default and leave out.
    pub fn is_empty(self) -> bool {
        return match self.contents {
            Contents.Text(t) => t.is_empty() and self.extra.is_empty(),
            _ => false,
        }
    }

    /// The component as vanilla's `ComponentSerialization.CODEC` writes it to JSON: plain text
    /// with no siblings as a bare string, and anything else as an object of its contents' fields,
    /// then `extra`.
    pub fn write_json(self, w: mut JsonWriter) {
        match self.contents {
            Contents.Text(t) => {
                if self.extra.is_empty() {
                    w.string(t)
                    return
                }
                w.begin_object()
                w.name("text")
                w.string(t)
            },
            Contents.Translatable(t) => {
                w.begin_object()
                w.name("translate")
                w.string(t.key)
                if let f = t.fallback {
                    w.name("fallback")
                    w.string(f)
                }
                if not t.args.is_empty() {
                    w.name("with")
                    w.begin_array()
                    for a in t.args {
                        a.write_json(mut w)
                    }
                    w.end_array()
                }
            },
        }
        if not self.extra.is_empty() {
            w.name("extra")
            w.begin_array()
            for e in self.extra {
                e.write_json(mut w)
            }
            w.end_array()
        }
        w.end_object()
    }

    /// The component's JSON, as `write_json` writes it.
    pub fn to_json(self) -> String {
        var w = JsonWriter.new()
        self.write_json(mut w)
        return w.into_string()
    }

    /// The component as NBT, as vanilla's `ComponentSerialization.CODEC` writes it with
    /// `NbtOps`, which is how it goes to a client since 1.20.3: the same fields as its JSON, in
    /// the same order, in compounds and lists, with plain text with no siblings as a string.
    pub fn to_nbt(self) -> Tag {
        var m = JavaHashMap<String, Tag>()
        match self.contents {
            Contents.Text(t) => {
                if self.extra.is_empty() {
                    return Tag.Str(t.copy())
                }
                m.insert(String("text"), Tag.Str(t.copy()))
            },
            Contents.Translatable(t) => {
                m.insert(String("translate"), Tag.Str(t.key.copy()))
                if let f = t.fallback {
                    m.insert(String("fallback"), Tag.Str(f.copy()))
                }
                if not t.args.is_empty() {
                    var args = List<Tag>()
                    for a in t.args {
                        args.push(a.to_nbt())
                    }
                    m.insert(String("with"), Tag.List(args))
                }
            },
        }
        if not self.extra.is_empty() {
            var extra = List<Tag>()
            for e in self.extra {
                extra.push(e.to_nbt())
            }
            m.insert(String("extra"), Tag.List(extra))
        }
        return Tag.Compound(m)
    }

    /// The component in NBT that `to_nbt` writes: a string, a list whose first component the
    /// rest follow, or a compound of text or a translation and its siblings. A translation's
    /// arguments that are numbers or booleans become their text. Other contents and styles come
    /// with chat.
    pub fn from_nbt(tag: Tag) -> Component ! String {
        match tag {
            Tag.Str(s) => return Component.literal(s),
            Tag.List(items) => {
                if items.is_empty() {
                    fail String("List must have contents")
                }
                var first = try Component.from_nbt(items[0])
                for i in 1..items.len() {
                    first.extra.push(try Component.from_nbt(items[i]))
                }
                return first
            },
            Tag.Compound(m) => {
                var extra = List<Component>()
                for item in try list_at(m, String("extra")) {
                    extra.push(try Component.from_nbt(item))
                }
                if let text = string_at(m, String("text")) {
                    return Component { contents: Contents.Text(text), extra: extra }
                }
                let key = string_at(m, String("translate")) else {
                    fail String("No matching codec found")
                }
                var args = List<Component>()
                for item in try list_at(m, String("with")) {
                    args.push(try argument(item))
                }
                let t = Translation { key: key, fallback: string_at(m, String("fallback")), args: args }
                return Component { contents: Contents.Translatable(t), extra: extra }
            },
            _ => {
                fail "Not a component: {tag.to_snbt()}"
            },
        }
    }

    /// The component in JSON, as vanilla's `ComponentSerialization.CODEC` reads it, with the
    /// limits of `from_nbt`: a string, an array whose first component the rest follow, or an
    /// object of text or a translation and its siblings. A key given twice is the last, as Gson
    /// reads it.
    pub fn from_json(value: Json) -> Component ! String {
        match value {
            Json.Str(s) => return Component.literal(s),
            Json.Array(items) => {
                if items.is_empty() {
                    fail String("List must have contents")
                }
                var first = try Component.from_json(items[0])
                for i in 1..items.len() {
                    first.extra.push(try Component.from_json(items[i]))
                }
                return first
            },
            Json.Object(members) => {
                var extra = List<Component>()
                for item in try json_list_at(members, String("extra")) {
                    extra.push(try Component.from_json(item))
                }
                if let text = json_string_at(members, String("text")) {
                    return Component { contents: Contents.Text(text), extra: extra }
                }
                let key = json_string_at(members, String("translate")) else {
                    fail String("No matching codec found")
                }
                var args = List<Component>()
                for item in try json_list_at(members, String("with")) {
                    args.push(try json_argument(item))
                }
                let t = Translation { key: key, fallback: json_string_at(members, String("fallback")), args: args }
                return Component { contents: Contents.Translatable(t), extra: extra }
            },
            _ => {
                fail "Not a component: {to_json_text(value)}"
            },
        }
    }

    /// The component as text, as vanilla's `getString` gives it: its contents, with a
    /// translation's text from `lang` and its arguments put in, then its siblings'.
    pub fn get_string(self, lang: Language) -> String {
        var out = String()
        self.append_string(lang, mut out)
        return out
    }

    fn append_string(self, lang: Language, out: mut String) {
        match self.contents {
            Contents.Text(t) => out.push_str(t),
            Contents.Translatable(t) => t.append_string(lang, mut out),
        }
        for e in self.extra {
            e.append_string(lang, mut out)
        }
    }
}

impl Translation {
    // The translation as text, as vanilla's `TranslatableContents.decompose` makes it: the key's
    // text in `lang`, or the fallback, or the key, with the arguments put in. Text that isn't a
    // format vanilla reads is shown as it is.
    fn append_string(self, lang: Language, out: mut String) {
        let format = match self.fallback {
            some(f) => lang.get_or_default(self.key, f),
            none => lang.get_or_default(self.key, self.key),
        }
        var filled = String()
        if self.fill(format, lang, mut filled) {
            out.push_str(filled)
        } else {
            out.push_str(format)
        }
    }

    // The format with each `%s` the next argument, each `%n$s` the nth, and each `%%` a `%`, as
    // vanilla's `decomposeTemplate` reads it with its pattern: a `%`, digits and a `$` if it's
    // positional, then a letter, a `%` or the end. False where vanilla throws: another letter,
    // a `%` the pattern doesn't match, or an argument that isn't there.
    fn fill(self, format: String, lang: Language, out: mut String) -> bool {
        let n = format.len()
        var next: usize = 0
        var i: usize = 0
        loop {
            let at = match format[i..].find("%") {
                some(a) => i + a,
                none => {
                    out.push_str(format[i..])
                    return true
                },
            }
            out.push_str(format[i..at])
            var digits = at + 1
            var position: i64 = 0
            while digits < n and is_digit(format.byte_at(digits)) {
                position = position * 10 + i64(format.byte_at(digits) - 48)
                if position > 2147483647 {
                    // Integer.parseInt fails.
                    return false
                }
                digits += 1
            }
            var kind = at + 1
            var positional = false
            if digits > at + 1 and digits < n and format.byte_at(digits) == 36 {
                kind = digits + 1
                positional = true
            }
            if kind == n {
                // The pattern takes a `%` at the end as a format with no letter.
                return false
            }
            let letter = format.byte_at(kind)
            if letter == 37 and kind == at + 1 {
                out.push('%')
                i = kind + 1
                continue
            }
            if letter != 115 {
                return false
            }
            var index = next
            if positional {
                if position == 0 {
                    return false
                }
                index = usize.wrap(position - 1)
            } else {
                next += 1
            }
            if index >= self.args.len() {
                return false
            }
            self.args[index].append_string(lang, mut out)
            i = kind + 1
        }
    }
}

// The string under `key`, or `none` if there's none.
fn string_at(m: JavaHashMap<String, Tag>, key: String) -> String? {
    if not m.contains(key) {
        return none
    }
    return match m[key] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

// The list under `key`, which is empty if there's none.
fn list_at(m: JavaHashMap<String, Tag>, key: String) -> List<Tag> ! String {
    if not m.contains(key) {
        return []
    }
    return match m[key] {
        Tag.List(items) => items.copy(),
        _ => {
            fail "Not a list: {key}"
        },
    }
}

// A translation's argument: a component, or a number or boolean, which is shown as its text.
fn argument(tag: Tag) -> Component ! String {
    return match tag {
        Tag.Byte(v) => Component.literal("{v}"),
        Tag.Short(v) => Component.literal("{v}"),
        Tag.Int(v) => Component.literal("{v}"),
        Tag.Long(v) => Component.literal("{v}"),
        Tag.Float(v) => Component.literal("{v}"),
        Tag.Double(v) => Component.literal("{v}"),
        _ => try Component.from_nbt(tag),
    }
}

// The JSON string under `key`, or `none` if there's none.
fn json_string_at(members: List<Member>, key: String) -> String? {
    let value = get(members, key) else return none
    return as_string(value)
}

// The JSON array under `key`, which is empty if there's none.
fn json_list_at(members: List<Member>, key: String) -> List<Json> ! String {
    let value = get(members, key) else return []
    return match value {
        Json.Array(items) => items,
        _ => {
            fail "Not a list: {key}"
        },
    }
}

// A translation's argument in JSON: a component, or a number or boolean, which is shown as its
// text.
fn json_argument(value: Json) -> Component ! String {
    return match value {
        Json.Number(text) => Component.literal(text),
        Json.Bool(b) => Component.literal("{b}"),
        _ => try Component.from_json(value),
    }
}

// A JSON value as text, for a message.
fn to_json_text(value: Json) -> String {
    var out = List<u8>()
    write(mut out, value)
    return String.from_utf8(out) ?? String("?")
}

fn is_digit(b: u8) -> bool {
    return b >= 48 and b <= 57
}
