/// Scratch, for CAL-68 and CAL-88: makes the Overworld's chunks within RADIUS of the spawn origin,
/// or of CX, CZ, on THREADS worker threads, or with the one-thread `Generator` if THREADS is 0;
/// says how long they took and how fast, writes each chunk's hash to build/scratch/hashes.txt and
/// a map of their tops to build/scratch/map.ppm. Not a test.
///
///     calx run --release src/gen_bench.calx -- SEED RADIUS [CX CZ [THREADS]]
module gen_bench

import pack.vanilla.{vanilla_data}
import rig.registries.{load_vanilla}
import server.log.{Entry}
import server.play.{block_states}
import std.env.{args, variable}
import std.fs.{write}
import std.thread.{Task}
import std.time.{Instant}

import json.tree.{Json, Member}
import world.chunk.{AIR_STATE, BlockStates, Chunk, MOTION_BLOCKING}
import worldgen.generator.{GenSetup, Job, Made, Worker}
import worldgen.scheduler.{Generator, scheduler_for}

fn number(s: String) -> i64 {
    var n: i64 = 0
    var neg = false
    for i in 0..s.len() {
        let c = s.byte_at(i)
        if c == 45 {
            neg = true
        } else {
            n = n * 10 + i64(c - 48)
        }
    }
    return if neg { -n } else { n }
}

fn color(name: String, y: i32) -> (u8, u8, u8) {
    var r = 128
    var g = 128
    var b = 128
    if name.contains("water") or name.contains("kelp") or name.contains("seagrass") {
        r = 40
        g = 70
        b = 200
    } else if name.contains("grass_block") or name.contains("short_grass") or name.contains("tall_grass") or name.contains("fern") {
        r = 90
        g = 160
        b = 60
    } else if name.contains("leaves") {
        r = 40
        g = 110
        b = 30
    } else if name.contains("log") or name.contains("wood") {
        r = 100
        g = 70
        b = 40
    } else if name.contains("sand") {
        r = 220
        g = 210
        b = 150
    } else if name.contains("snow") or name.contains("ice") {
        r = 240
        g = 240
        b = 250
    } else if name.contains("stone") or name.contains("andesite") or name.contains("diorite") or name.contains("granite") or name.contains("gravel") {
        r = 130
        g = 130
        b = 130
    } else if name.contains("dirt") or name.contains("podzol") or name.contains("mud") {
        r = 120
        g = 85
        b = 55
    } else if name.contains("terracotta") {
        r = 190
        g = 110
        b = 70
    } else if name.contains("lava") {
        r = 240
        g = 100
        b = 0
    } else if name.contains("flower") or name.contains("tulip") or name.contains("poppy") or name.contains("dandelion") {
        r = 200
        g = 60
        b = 160
    }
    // Shade by height around the sea.
    let shade = (y - 63).max(-40).min(60)
    let f = 100 + shade
    return (u8.wrap((r * f / 100).min(255).max(0)), u8.wrap((g * f / 100).min(255).max(0)), u8.wrap((b * f / 100).min(255).max(0)))
}

// FNV-1a over every block state and biome of the chunk, a section at a time.
fn chunk_hash(c: Chunk) -> u64 {
    var h: u64 = 14695981039346656037u64
    for i in 0..c.section_count() {
        let s = c.section(i)
        for y in 0..16 {
            for z in 0..16 {
                for x in 0..16 {
                    h = (h ^ u64(s.block(x, y, z))).wrapping_mul(1099511628211u64)
                }
            }
        }
        for y in 0..4 {
            for z in 0..4 {
                for x in 0..4 {
                    h = (h ^ u64(s.biome(x, y, z))).wrapping_mul(1099511628211u64)
                }
            }
        }
    }
    return h
}

// The block at the top of each column, and its height, by x + 16 z.
fn tops(c: Chunk, table: BlockStates) -> (List<u32>, List<i32>) {
    var blocks = List<u32>()
    var ys = List<i32>()
    for z in 0..16 {
        for x in 0..16 {
            var y = c.height(MOTION_BLOCKING, x, z) - 1
            // The Nether's roof is bedrock: its floor is mapped, the first block from 100 down.
            if c.min_y() == 0 and y >= 127 {
                y = 100
                while y > 0 and c.block(x, y, z) == AIR_STATE {
                    y -= 1
                }
            }
            blocks.push(table.block_of(c.block(x, y, z)))
            ys.push(y)
        }
    }
    return (blocks, ys)
}

// What a worker thread hands back: what a job made, a chunk finished, as its hash and tops, or
// how long it spent on each kind of job, once there are no more.
enum Back {
    Made(u32, Made)
    Done(u32, i32, i32, u64, List<u32>, List<i32>)
    Spent(List<u64>, List<u64>)
}

// A job, with the epoch of the scheduler that handed it out.
struct Tagged {
    epoch: u32
    job: Job
}

struct BenchWorker {
    worker: Shared<Worker>
    jobs: Receiver<Tagged>
    out: Sender<Back>
}

impl Task for BenchWorker {
    fn run(own self) {
        let BenchWorker { worker: worker, jobs: taken, out: sender } = self
        var jobs = taken
        var out = sender
        // As the server's workers do: each copies the one worker.
        var w = worker.value.copy()
        let table = w.table()
        var spent: List<u64> = [0u64; 5]
        var count: List<u64> = [0u64; 5]
        while let tagged = jobs.wait() {
            let Tagged { epoch: epoch, job: job } = tagged
            let kind: usize = match job {
                Job.Ring(_) => 0,
                Job.Starts(_, _, _) => 0,
                Job.Biomes(_, _) => 1,
                Job.Terrain(_) => 2,
                Job.Decorate(_) => 3,
                Job.Finish(_) => 4,
            }
            let t0 = unsafe { Instant.now() }
            let made = w.run(job)
            let finished = match made {
                Made.Finished(_, _, _) => true,
                _ => false,
            }
            if finished {
                match made {
                    Made.Finished(x, z, chunk) => {
                        let h = chunk_hash(chunk)
                        let (blocks, ys) = tops(chunk, table)
                        out.send(Back.Done(epoch, x, z, h, blocks, ys))
                    },
                    _ => {},
                }
            } else {
                out.send(Back.Made(epoch, made))
            }
            let t1 = unsafe { Instant.now() }
            spent[kind] += t1.nanos_since(t0)
            count[kind] += 1
        }
        out.send(Back.Spent(spent, count))
    }
}

fn main() ! String {
    let a = args()
    let seed = number(a[0])
    let radius = i32.wrap(number(a[1]))
    var threads: usize = 0
    if a.len() >= 5 {
        threads = usize.wrap(number(a[4]))
    }
    // With threads, the scheduler starts again after every this many chunks, as the server's
    // does when it keeps too much far terrain (D220); a chunk made again must hash the same.
    var renew_every = 0
    if a.len() >= 6 {
        renew_every = i32.wrap(number(a[5]))
    }
    let loaded = try load_vanilla()
    var lines = List<Entry>()
    let zip = try vanilla_data(String("build/fly/cache/vanilla-26.3.data"), mut lines)
    let b = loaded.registries.find_builtin(String("block")) else fail String("no block registry")
    let f = loaded.registries.find_builtin(String("fluid")) else fail String("no fluid registry")
    let bi = loaded.registries.find(String("worldgen/biome")) else fail String("no biome registry")
    let table = try block_states(loaded.registries)
    let uncarvable = loaded.registries.builtin[b].tag_values(String("uncarvable"))
    let t0 = unsafe { Instant.now() }
    var setup = GenSetup { settings: String("minecraft:overworld"), blocks: loaded.registries.builtin[b].copy(), fluids: loaded.registries.builtin[f].copy(), biomes: loaded.registries.synced[bi].copy(), table: table, uncarvable: uncarvable, seed: seed }
    if let dim = variable(String("CALCITE_DIM")) {
        if dim == "nether" {
            setup.settings = String("minecraft:nether")
            setup.source = some(Json.Object([Member { key: String("type"), value: Json.Str(String("minecraft:multi_noise")) }, Member { key: String("preset"), value: Json.Str(String("minecraft:nether")) }]))
            setup.min_y = 0
            setup.height = 256
            setup.sky_light = false
        } else if dim == "end" {
            setup.settings = String("minecraft:end")
            setup.source = some(Json.Object([Member { key: String("type"), value: Json.Str(String("minecraft:the_end")) }]))
            setup.min_y = 0
            setup.height = 256
        }
    }
    var gen = try Generator.new(zip.copy(), setup.copy())
    let t1 = unsafe { Instant.now() }
    println("generator made in {t1.secs_since(t0)} s")
    var (ox, oz) = match gen.origin() {
        ok(o) => o,
        err(t) => fail "origin: {t.exception}: {t.message}",
    }
    if a.len() >= 4 {
        ox = i32.wrap(number(a[2]))
        oz = i32.wrap(number(a[3]))
    }
    let t2 = unsafe { Instant.now() }
    println("origin chunk {ox}, {oz} in {t2.secs_since(t1)} s")
    let side = radius * 2 + 1
    var top_blocks: List<u32> = [0u32; usize.wrap(side * side * 256)]
    var top_ys: List<i32> = [0; usize.wrap(side * side * 256)]
    var hashes = Map<i64, u64>()
    let table2 = gen.table()
    var n = 0
    var problems = List<String>()
    if threads == 0 {
        for cz in oz - radius..oz + radius + 1 {
            for cx in ox - radius..ox + radius + 1 {
                let c: Chunk = match gen.full(cx, cz) {
                    ok(c) => c,
                    err(t) => fail "chunk {cx}, {cz}: {t.exception}: {t.message}",
                }
                n += 1
                hashes.insert(i64(cx) * 100000 + i64(cz), chunk_hash(c))
                let (blocks, ys) = tops(c, table2)
                for i in 0..256usize {
                    let px = (cx - ox + radius) * 16 + i32.wrap(i % 16)
                    let pz = (cz - oz + radius) * 16 + i32.wrap(i / 16)
                    top_blocks[usize.wrap(pz * side * 16 + px)] = blocks[i]
                    top_ys[usize.wrap(pz * side * 16 + px)] = ys[i]
                }
            }
        }
        for p in gen.problems {
            problems.push(p.copy())
        }
    } else {
        let jobs = Receiver<Tagged>()
        var to_jobs = jobs.sender()
        var back = Receiver<Back>()
        var one = try Worker.new(zip.copy(), setup)
        // Set CALCITE_LOCAL_TEMPLATES to compare against each worker loading its own templates.
        if variable(String("CALCITE_LOCAL_TEMPLATES")) == none {
            _ = one.serve_templates()
        }
        let shared = Shared(one)
        for _ in 0..threads {
            _ = unsafe { Thread.spawn(BenchWorker { worker: shared.copy(), jobs: jobs.share(), out: back.sender() }) }
        }
        var s = try scheduler_for(zip, setup)
        for cz in oz - radius..oz + radius + 1 {
            for cx in ox - radius..ox + radius + 1 {
                s.want(cx, cz)
            }
        }
        let cap = threads * 2
        let total = side * side
        var first: Instant? = none
        var most_kept: usize = 0
        var epoch: u32 = 0
        var stale: usize = 0
        var renews = 0
        var again = 0
        // With CALCITE_UNWANT set, the far half not yet made is withdrawn a quarter of the way
        // in, and asked for again once the rest is made (D243): the hashes must be the same.
        let unwant_at = if variable(String("CALCITE_UNWANT")) != none { total / 4 } else { 0 }
        var withdrew = false
        var rewanted = false
        while n < total {
            if unwant_at > 0 and not withdrew and n >= unwant_at {
                withdrew = true
                let before = s.jobs()
                for cz in oz + 1..oz + radius + 1 {
                    for cx in ox - radius..ox + radius + 1 {
                        if not hashes.contains(i64(cx) * 100000 + i64(cz)) {
                            s.unwant(cx, cz)
                        }
                    }
                }
                println("withdrew the far half at {n} chunks: {before} jobs, then {s.jobs()}")
            }
            if renew_every > 0 and n >= (renews + 1) * renew_every {
                renews += 1
                stale += s.running()
                epoch += 1
                s = s.renewed()
                for cz in oz - radius..oz + radius + 1 {
                    for cx in ox - radius..ox + radius + 1 {
                        if not hashes.contains(i64(cx) * 100000 + i64(cz)) {
                            s.want(cx, cz)
                        }
                    }
                }
            }
            while s.running() + stale < cap {
                let job = s.next() else break
                to_jobs.send(Tagged { epoch: epoch, job: job })
            }
            if s.running() + stale == 0 {
                if withdrew and not rewanted {
                    rewanted = true
                    println("asked for the far half again at {n} chunks")
                    for cz in oz + 1..oz + radius + 1 {
                        for cx in ox - radius..ox + radius + 1 {
                            if not hashes.contains(i64(cx) * 100000 + i64(cz)) {
                                s.want(cx, cz)
                            }
                        }
                    }
                    continue
                }
                fail "nothing to do with {total - n} chunks to go"
            }
            let m = back.wait() else fail String("the workers stopped")
            var got = some(m)
            while let item = got.take() {
                match item {
                    Back.Made(e, made) => {
                        if e == epoch {
                            s.take(made)
                        } else {
                            stale -= 1
                        }
                    },
                    Back.Done(e, cx, cz, h, blocks, ys) => {
                        if e == epoch {
                            s.finished_at(cx, cz)
                        } else {
                            stale -= 1
                        }
                        let key = i64(cx) * 100000 + i64(cz)
                        if hashes.contains(key) {
                            again += 1
                            if hashes[key] != h {
                                fail "chunk {cx}, {cz} made again hashes {h}, not {hashes[key]}"
                            }
                            got = back.next()
                            continue
                        }
                        if first == none {
                            first = some(unsafe { Instant.now() })
                        }
                        n += 1
                        hashes.insert(key, h)
                        for i in 0..256usize {
                            let px = (cx - ox + radius) * 16 + i32.wrap(i % 16)
                            let pz = (cz - oz + radius) * 16 + i32.wrap(i / 16)
                            top_blocks[usize.wrap(pz * side * 16 + px)] = blocks[i]
                            top_ys[usize.wrap(pz * side * 16 + px)] = ys[i]
                        }
                    },
                    Back.Spent(_, _) => {},
                }
                got = back.next()
            }
            most_kept = most_kept.max(s.kept())
        }
        let t3 = unsafe { Instant.now() }
        if let at = first {
            println("first chunk after {at.secs_since(t2)} s; the rest at {f64(n - 1) / t3.secs_since(at)} chunks/s")
        }
        println("most terrain kept: {most_kept}")
        if renews > 0 {
            println("started again {renews} times; {again} chunks made again, each the same")
        }
        to_jobs.close()
        var spent: List<u64> = [0u64; 5]
        var count: List<u64> = [0u64; 5]
        var stopped: usize = 0
        while stopped < threads {
            let m = back.wait() else break
            match m {
                Back.Spent(sp, c) => {
                    for k in 0..5usize {
                        spent[k] += sp[k]
                        count[k] += c[k]
                    }
                    stopped += 1
                },
                _ => {},
            }
        }
        let names: List<str> = ["starts", "biomes", "terrain", "decorate", "finish"]
        for k in 0..5usize {
            let each = if count[k] > 0 { f64.nearest(spent[k]) / f64.nearest(count[k]) / 1000000.0 } else { 0.0 }
            println("{names[k]}: {count[k]} jobs, {f64.nearest(spent[k]) / 1000000000.0} s, {each} ms each")
        }
        for p in s.problems {
            problems.push(p.copy())
        }
    }
    let t4 = unsafe { Instant.now() }
    println("{n} chunks in {t4.secs_since(t2)} s: {f64(n) / t4.secs_since(t2)} chunks/s")
    var out_hashes = String()
    var total_hash: u64 = 14695981039346656037u64
    for cz in oz - radius..oz + radius + 1 {
        for cx in ox - radius..ox + radius + 1 {
            let h = hashes.get(i64(cx) * 100000 + i64(cz)) ?? 0u64
            out_hashes.push_str("{cx} {cz} {h}\n")
            total_hash = (total_hash ^ h).wrapping_mul(1099511628211u64)
        }
    }
    println("hash {total_hash}")
    for p in problems {
        println("problem: {p}")
    }
    match write(String("build/scratch/hashes.txt"), out_hashes.to_bytes()) {
        ok => {},
        err(_) => fail String("couldn't write the hashes"),
    }
    let w = side * 16
    var out = List<u8>()
    let header = "P6\n{w} {w}\n255\n"
    for i in 0..header.len() {
        out.push(header.byte_at(i))
    }
    for i in 0..top_blocks.len() {
        let name = loaded.registries.builtin[b].entries[usize(top_blocks[i])].path.copy()
        let (r, g, bl) = color(name, top_ys[i])
        out.push(r)
        out.push(g)
        out.push(bl)
    }
    match write(String("build/scratch/map.ppm"), out) {
        ok => {},
        err(_) => fail String("couldn't write the map"),
    }
}
