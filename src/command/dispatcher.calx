/// Brigadier's dispatcher over a command tree: vanilla's, from `command.tree`, with what Calcite
/// adds to it. A command is read as `CommandDispatcher.parse` reads it, against the nodes its
/// source may use, each argument by its type, and what went wrong is found as
/// `Commands.finishParsing` finds it (CAL-165).
///
/// Each node's level is its own requirement's, as `canUse` tests it; a node under one that needs
/// a level needs none itself, as brigadier's `requires` is the node's own.
module command.dispatcher

import chat.component.{Argument as TextArgument, Component, Contents}
import command.coordinates.{Coordinates, block_pos, rotation, vec3}
import command.reader.{Reader}
import protocol.wire.{Reader as WireReader}
import command.selector.{Ints, Selector, read_entities, read_ints}
import command.tree.{NODES, node_facts, node_names, node_parents, node_properties, node_redirects, suggestion_names}
import math.mth.{round_float}
import nbt.snbt.{SyntaxError, compound_at, from_units, tag_at, units_of}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.components.{ItemCodecs}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.modes.{GameType}
import world.states.{Prop, StateCodec}

/// The permission level that lets a source use selectors, vanilla's `COMMANDS_ENTITY_SELECTORS`,
/// the game masters'.
pub const SELECTORS: i32 = 2

/// The most a message argument may have, in UTF-16 units, `MessageArgument.MAX_LENGTH`.
pub const MESSAGE_MOST: usize = 256

/// Where a failure with no place in the input is, as vanilla's `create()` makes one with none.
pub const NOWHERE: usize = 4294967295

/// How an argument reads, by its type and its properties.
pub enum ArgType {
    /// `brigadier:bool`.
    Bool
    /// `brigadier:float`, `double`, `integer` and `long`, from their least to their most.
    Float(f32, f32)
    Double(f64, f64)
    Integer(i32, i32)
    Long(i64, i64)
    /// `brigadier:string`: a word, `readUnquotedString`; a phrase, `readString`; or the rest.
    Word
    Phrase
    Greedy
    /// `minecraft:entity`: whether it's one only, and whether it's players only.
    Entity(bool, bool)
    /// `minecraft:gamemode`.
    GameMode
    /// `minecraft:resource_location` and `minecraft:dimension`: an identifier.
    Id
    /// `minecraft:message`: the rest, with selectors in it where the source may use them.
    Message
    /// `minecraft:objective`: a word.
    Objective
    /// `minecraft:int_range`.
    IntRange
    /// `minecraft:component`: a text component, as SNBT.
    TextComponent
    /// `minecraft:time`: a number of ticks, days or seconds, no fewer ticks than its least.
    Time(i32)
    /// `minecraft:vec3`, its whole x and z centred on their blocks, and `minecraft:rotation`.
    Vec3
    Rotation
    /// `minecraft:entity_anchor`: `feet` or `eyes`.
    Anchor
    /// `minecraft:resource`: an entry of the registry named.
    Resource(String)
    /// `minecraft:item_stack`: an item and the components it changes, `ItemArgument`.
    Item
    /// `minecraft:block_pos`: whole numbers, each relative or not, or local coordinates.
    BlockPos
    /// `minecraft:block_state`: a block, its properties and its block entity's NBT,
    /// `BlockStateArgument`.
    Block
    /// A type Calcite doesn't read yet, by its name.
    Unread(String)
}

/// What a node is.
pub enum Kind {
    Root
    Literal
    Argument(ArgType)
}

/// A node of the tree: its kind and name, its children, in the order they were added, whether a
/// command may end there, the level its requirement asks for, the node it redirects to, and an
/// argument's type's ID in `command_argument_type`, its properties as the commands packet sends
/// them, and the custom suggestions it asks for.
pub struct Node {
    pub kind: Kind
    pub name: String
    pub children: List<usize>
    pub executable: bool
    pub level: i32
    pub redirect: usize?
    pub parser: i32
    pub properties: List<u8>
    pub suggestions: String?
}

impl Node {
    /// A literal named `name`.
    pub fn literal(name: str, executable: bool, level: i32) -> Node {
        return Node { kind: Kind.Literal, name: String(name), children: [], executable: executable, level: level, redirect: none, parser: -1, properties: [], suggestions: none }
    }

    /// An argument named `name` of the type named `parser` in `command_argument_type`, such as
    /// `entity` or `brigadier:float`, with its properties as `serializeToNetwork` writes them.
    pub fn argument(name: str, parser: str, properties: own List<u8>, executable: bool) -> Node {
        let id = argument_type(parser)
        let reads = arg_type(String(parser), properties)
        return Node { kind: Kind.Argument(reads), name: String(name), children: [], executable: executable, level: 0, redirect: none, parser: id, properties: properties, suggestions: none }
    }
}

/// A command tree, the root first.
pub struct Tree {
    pub nodes: List<Node>
    /// The names in each registry a `resource` argument may name, which the server gives it
    /// once its registries are loaded (CAL-165).
    pub resources: List<ResourceNames> = List<ResourceNames>()
    /// The item codecs an `item_stack` argument reads its item and components with, which the
    /// server gives it once its registries are loaded (CAL-165).
    pub items: Shared<ItemCodecs>? = none
    /// The blocks a `block_state` argument names, which the server gives it once its registries
    /// are loaded (CAL-165).
    pub blocks: Shared<BlockNames>? = none
}

/// The blocks, with their states, and those whose states have block entities, by their IDs
/// (CAL-165).
pub struct BlockNames {
    pub states: StateCodec
    pub entities: List<u32>
}

/// A block argument as written, `BlockInput`: its state, the properties written, which
/// `overwriteWithDefinedProperties` keeps, and the NBT given for its block entity (CAL-165).
pub struct BlockInput {
    pub state: u32
    pub given: List<Prop>
    pub nbt: Tag?
}

/// An item argument as written, `ItemInput`: its item's whole ID and what it changes of the
/// item's components, in the order written, each a type's whole ID with its value as its codec
/// writes it, or `!` and the ID of one taken away, with `{}` (CAL-165).
pub struct ItemInput {
    pub item: String
    pub patch: List<(String, Tag)>
}

/// A registry's entries' names, by the registry's name, as `minecraft:world_clock` (CAL-165).
pub struct ResourceNames {
    pub registry: String
    pub names: List<Identifier>
}

impl Tree {
    /// Vanilla's tree, as a dedicated server registers it.
    pub fn vanilla() -> Tree {
        let parent = node_parents()
        let fact = node_facts()
        let name = node_names()
        let bytes = node_properties()
        let asks = suggestion_names()
        let types = argument_types()
        var nodes = List<Node>()
        var at: usize = 0
        for i in 0..NODES {
            let f = fact[i]
            let size = usize((f >> 9) & 127)
            var properties = List<u8>()
            for b in at..at + size {
                properties.push(bytes[b])
            }
            at += size
            var parser: i32 = -1
            let kind = match f & 3 {
                0 => Kind.Root,
                1 => Kind.Literal,
                _ => {
                    parser = i32.wrap(f >> 16)
                    Kind.Argument(arg_type(types[usize.wrap(parser)].copy(), properties))
                },
            }
            var suggestions: String? = none
            let which = usize((f >> 6) & 7)
            if which > 0 {
                suggestions = some(String(asks[which - 1]))
            }
            nodes.push(Node { kind: kind, name: String(name[i]), children: [], executable: f & 4 != 0, level: i32.wrap((f >> 3) & 7), redirect: none, parser: parser, properties: properties, suggestions: suggestions })
            if i > 0 {
                nodes[usize.wrap(parent[i])].children.push(i)
            }
        }
        let pairs = node_redirects()
        var k: usize = 0
        while k < pairs.len() {
            nodes[usize.wrap(pairs[k])].redirect = some(usize.wrap(pairs[k + 1]))
            k += 2
        }
        return Tree { nodes: nodes }
    }

    /// `node`, added under `parent` after its other children, at its place in the tree.
    pub fn add(mut self, parent: usize, node: own Node) -> usize {
        self.nodes.push(node)
        let at = self.nodes.len() - 1
        self.nodes[parent].children.push(at)
        return at
    }

    /// `getRelevantNodes`: where `node` has literals, the one named by the word at the reader's
    /// place, up to a space, if there is one; else its arguments.
    fn relevant(self, node: usize, r: Reader) -> List<usize> {
        var word_end = r.at
        while word_end < r.units.len() and r.units[word_end] != ' ' {
            word_end += 1
        }
        var has_literals = false
        var arguments = List<usize>()
        var word: String? = none
        for c in self.nodes[node].children {
            match self.nodes[c].kind {
                Kind.Literal => {
                    if not has_literals {
                        has_literals = true
                        word = some(from_units(r.units, r.at, word_end))
                    }
                    if let w = word {
                        if w == self.nodes[c].name {
                            return [c]
                        }
                    }
                },
                Kind.Argument(_) => arguments.push(c),
                Kind.Root => {},
            }
        }
        return arguments
    }

    /// The names of the nodes from the root to `node`, such as `trigger objective` (CAL-165).
    pub fn path_to(self, node: usize) -> String {
        var names = List<String>()
        var at = node
        while at != 0 {
            names.push(self.nodes[at].name.copy())
            var up: usize = 0
            for i in 0..self.nodes.len() {
                if self.nodes[i].children.contains(at) {
                    up = i
                    break
                }
            }
            at = up
        }
        var out = String()
        var i = names.len()
        while i > 0 {
            i -= 1
            if not out.is_empty() {
                out.push_str(" ")
            }
            out.push_str(names[i])
        }
        return out
    }

    /// The names of the nodes a context read, from the command's own: where it was redirected
    /// to, the name of the node it went to first, such as `msg targets message` for `tell`'s.
    pub fn path(self, c: Context) -> String {
        var out = String()
        if c.root != 0 {
            out.push_str(self.nodes[c.root].name)
        }
        for n in c.nodes {
            if not out.is_empty() {
                out.push_str(" ")
            }
            out.push_str(self.nodes[n.node].name)
        }
        return out
    }
}

/// A selector in a message, where it is in the message's text, in UTF-16 units.
pub struct Part {
    pub start: usize
    pub end: usize
    pub selector: Selector
}

/// A message argument as written, `MessageArgument.Message`: its text and the selectors in it.
pub struct Message {
    pub text: String
    pub parts: List<Part>
}

/// An argument's value, as its type reads it.
pub enum Value {
    Bool(bool)
    Float(f32)
    Double(f64)
    Int(i32)
    Long(i64)
    Text(String)
    Entities(Selector)
    Mode(GameType)
    Id(Identifier)
    Message(Message)
    Range(Ints)
    Shown(Component)
    Place(Coordinates)
    /// An anchor: whether it's the eyes rather than the feet.
    Eyes(bool)
    /// An item and the components it changes.
    Stack(ItemInput)
    /// A block's state, the properties written and its NBT.
    Block(BlockInput)
}

/// An argument read: its node's name, where it is in the input, in UTF-16 units, and its value.
pub struct Argument {
    pub name: String
    pub start: usize
    pub end: usize
    pub value: Value
}

/// A node read, and where.
pub struct Read {
    pub node: usize
    pub start: usize
    pub end: usize
}

/// What a parse read from one node on, `CommandContextBuilder`: the node it started at and where
/// in the input, the nodes read, their arguments, and the node whose command runs, where the last
/// read has one.
pub struct Context {
    pub root: usize
    pub start: usize
    pub nodes: List<Read>
    pub arguments: List<Argument>
    pub command: usize?
}

impl Context {
    /// The last argument named `name`.
    pub fn argument(self, name: str) -> Value? {
        var i = self.arguments.len()
        while i > 0 {
            i -= 1
            if self.arguments[i].name == String(name) {
                return some(self.arguments[i].value.copy())
            }
        }
        return none
    }

    /// Where the last argument named `name` is, in the input.
    pub fn place(self, name: str) -> (usize, usize)? {
        var i = self.arguments.len()
        while i > 0 {
            i -= 1
            if self.arguments[i].name == String(name) {
                return some((self.arguments[i].start, self.arguments[i].end))
            }
        }
        return none
    }
}

/// What a parse found, `ParseResults`: its contexts, the first from the root and each after it
/// where the one before redirected; where reading stopped; and each node that failed to read
/// there, in the order they were tried, with why.
pub struct Parse {
    pub contexts: List<Context>
    pub reader: Reader
    pub errors: List<(usize, SyntaxError)>
}

impl Parse {
    /// The context whose command runs, the last.
    pub fn last(self) -> Context {
        return self.contexts[self.contexts.len() - 1].copy()
    }
}

/// `CommandDispatcher.parse`: `input` read from the root, for a source whose permission level
/// is `level`.
pub fn parse(t: Tree, input: String, level: i32, types: Registry) -> Parse {
    return parse_from(t, input, 0, level, types)
}

/// `parse` of `input` from `at`, in UTF-16 units, such as past a `/` (CAL-165).
pub fn parse_from(t: Tree, input: String, at: usize, level: i32, types: Registry) -> Parse {
    var r = Reader.new(input)
    r.at = at
    let start = Context { root: 0, start: at, nodes: [], arguments: [], command: none }
    return parse_nodes(t, 0, r, start, level, types)
}

/// `Commands.finishParsing`: the context whose command runs, or why there's none.
/// `getParseException`: where reading stopped short, the one node's failure there, or else an
/// unknown command where nothing was read and an unknown argument where something was; then
/// `ContextChain.tryFlatten`: a last context with no command is an unknown command, where
/// reading stopped.
pub fn finish(p: Parse) -> Context ! SyntaxError {
    if p.reader.can_read() {
        if p.errors.len() == 1 {
            let (_, e) = p.errors[0].copy()
            fail e
        }
        let first = p.contexts[0].copy()
        if first.nodes.is_empty() {
            fail p.reader.error_here("command.unknown.command", [])
        }
        fail p.reader.error_here("command.unknown.argument", [])
    }
    let last = p.last()
    if last.command == none {
        fail p.reader.error_here("command.unknown.command", [])
    }
    return last
}

/// `SignableCommand.of`: the message arguments a parse read, each context's in order, by name,
/// with what was written for each, which a client signs.
pub fn signable(t: Tree, p: Parse) -> List<(String, String)> {
    var out = List<(String, String)>()
    for c in p.contexts {
        for n in c.nodes {
            if is_message(t.nodes[n.node].kind) {
                out.push((t.nodes[n.node].name.copy(), from_units(p.reader.units, n.start, n.end)))
            }
        }
    }
    return out
}

/// A suggestion, brigadier's `Suggestion`: the text that would take the place of `start` to
/// `end` of what was typed, in UTF-16 units, and what's shown beside it, where there's something
/// (CAL-165).
pub struct Suggestion {
    pub start: usize
    pub end: usize
    pub text: String
    pub tooltip: Component?
    /// The number it is, an `IntegerSuggestion`, which sorts among others by number (CAL-165).
    pub number: i32? = none
}

/// The suggestions for what was typed, brigadier's `Suggestions`: the range they all take the
/// place of, in UTF-16 units, and each, sorted without regard to case.
pub struct Suggestions {
    pub start: usize
    pub end: usize
    pub list: List<Suggestion>
}

/// `SuggestionsBuilder`: what was typed, up to the cursor, where what it suggests starts, and
/// what it has suggested so far.
pub struct Builder {
    pub units: List<char>
    pub start: usize
    pub list: List<Suggestion>
}

impl Builder {
    /// A builder for suggestions from `start` of `input`.
    pub fn new(input: String, start: usize) -> Builder {
        return Builder { units: units_of(input), start: start, list: [] }
    }

    /// `getRemaining`: what was typed from `start`.
    pub fn remaining(self) -> String {
        return from_units(self.units, self.start, self.units.len())
    }

    /// `suggest`: `text` in place of what was typed from `start`, with `tooltip`, unless that's
    /// what was typed already.
    pub fn suggest(mut self, text: own String, tooltip: own Component?) {
        if text == self.remaining() {
            return
        }
        self.list.push(Suggestion { start: self.start, end: self.units.len(), text: text, tooltip: tooltip })
    }

    /// `SharedSuggestionProvider.suggest`: each of `values` that what was typed from `start`,
    /// in lower case, begins, or begins a part of after a `.`, `_` or `/`, `matchesSubStr`.
    /// `SharedSuggestionProvider.suggestResource` (CAL-165): each identifier a part of whose text
    /// what was typed begins, `filterResources`: with a `:` typed, of its whole text; else of its
    /// namespace, or of its path too where that's `minecraft`; each suggested whole.
    pub fn suggest_resources(mut self, ids: List<Identifier>) {
        self.suggest_resources_ending(ids, "")
    }

    /// `suggest_resources`, each with `suffix` after it, as `ItemParser.suggestComponent`
    /// suggests a type with `=` after it (CAL-165).
    pub fn suggest_resources_ending(mut self, ids: List<Identifier>, suffix: str) {
        let typed = self.remaining().to_lower_root()
        let namespaced = typed.contains(":")
        for id in ids {
            let whole = id.to_string()
            let fits = if namespaced { matches_part(typed, whole) } else { matches_part(typed, id.namespace) or (id.namespace == "minecraft" and matches_part(typed, id.path)) }
            if fits {
                self.suggest("{whole}{suffix}", none)
            }
        }
    }

    /// `suggest(int)`: the number `value` in place of what was typed from `start`, even where
    /// it's what was typed, an `IntegerSuggestion` (CAL-165).
    pub fn suggest_int(mut self, value: i32) {
        self.list.push(Suggestion { start: self.start, end: self.units.len(), text: "{value}", tooltip: none, number: some(value) })
    }

    pub fn suggest_matching(mut self, values: List<String>) {
        let typed = self.remaining().to_lower_root()
        for v in values {
            if matches_part(typed, v.to_lower_root()) {
                self.suggest(v.copy(), none)
            }
        }
    }

    /// `createOffset`: a builder for the same input from `start`.
    pub fn from(self, start: usize) -> Builder {
        return Builder { units: self.units.copy(), start: start, list: [] }
    }

    /// `add`: what `other` suggested, too.
    pub fn add(mut self, other: Builder) {
        for each in other.list {
            self.list.push(each.copy())
        }
    }
}

/// What the server knows that an argument's own suggestions need: the players' names, in the
/// order they joined, whether the source may use selectors, and the scoreboard's objectives.
pub struct Known {
    pub players: List<String>
    pub selectors: bool
    pub objectives: List<String>
}

/// `CommandContextBuilder.findSuggestionContext`: the node whose children may come at `cursor`,
/// in UTF-16 units, and where what they'd suggest starts, in the context a redirect led to where
/// the cursor's past the one before it (CAL-165).
pub fn suggestion_context(p: Parse, cursor: usize) -> (usize, usize) {
    var k: usize = 0
    while k < p.contexts.len() {
        let c = p.contexts[k].copy()
        var end = c.start
        for n in c.nodes {
            if n.end > end {
                end = n.end
            }
        }
        if end < cursor {
            if k + 1 < p.contexts.len() {
                k += 1
                continue
            }
            if not c.nodes.is_empty() {
                let last = c.nodes[c.nodes.len() - 1]
                return (last.node, last.end + 1)
            }
            return (c.root, c.start)
        }
        var before = c.root
        for n in c.nodes {
            if n.start <= cursor and cursor <= n.end {
                return (before, n.start)
            }
            before = n.node
        }
        return (before, c.start)
    }
    return (0, 0)
}

/// `CommandNode.listSuggestions` of the node `at` without custom suggestions, in `b`: a literal
/// whose name what was typed begins, without regard to case; `true` and `false`; game modes;
/// objectives; players' names and selectors; a time's units after its number; and anchors.
/// Other types suggest nothing, as brigadier's numbers and strings don't (CAL-165).
pub fn suggest_node(t: Tree, at: usize, b: mut Builder, known: Known) {
    let typed = b.remaining().to_lower_root()
    match t.nodes[at].kind {
        Kind.Literal => {
            if t.nodes[at].name.to_lower_root().starts_with(typed) {
                b.suggest(t.nodes[at].name.copy(), none)
            }
        },
        Kind.Argument(reads) => match reads {
            ArgType.Bool => {
                for word in ["true", "false"] {
                    if String(word).starts_with(typed) {
                        b.suggest(String(word), none)
                    }
                }
            },
            ArgType.GameMode => {
                var names = List<String>()
                for m in [GameType.Survival, GameType.Creative, GameType.Adventure, GameType.Spectator] {
                    names.push(m.name())
                }
                b.suggest_matching(names)
            },
            ArgType.Objective => b.suggest_matching(known.objectives),
            ArgType.Entity(_, _) => suggest_entities(mut b, known),
            ArgType.Time(_) => suggest_time(mut b),
            ArgType.Anchor => b.suggest_matching([String("eyes"), String("feet")]),
            ArgType.Item => {
                if let items = t.items {
                    suggest_item(mut b, items.value)
                }
            },
            ArgType.Block => {
                if let blocks = t.blocks {
                    suggest_block(mut b, blocks.value)
                }
            },
            _ => {},
        },
        Kind.Root => {},
    }
}

// What `ItemParser`'s reading asks to suggest, by where it's got to: an item; a `[` after one;
// a component's type to give or `!`, then its type to take away; an `=` after a type; a `,` or
// `]` after a component; else nothing.
const ITEM_NOTHING: i32 = 0
const ITEM_ID: i32 = 1
const ITEM_START: i32 = 2
const ITEM_GIVE_OR_TAKE: i32 = 3
const ITEM_TAKE: i32 = 4
const ITEM_ASSIGN: i32 = 5
const ITEM_NEXT: i32 = 6

// `ItemParser.fillSuggestions`: what was typed read as `ItemParser.State.parse` reads it, until
// it ends or fails, each step saying what to suggest where the reader's got to, the last said
// suggested from there, `resolveSuggestions` (CAL-165).
fn suggest_item(b: mut Builder, items: ItemCodecs) {
    var r = Reader.new(b.remaining())
    let wants = item_suggestion(mut r, items)
    var at = b.from(b.start + r.at)
    let typed = at.remaining()
    if wants == ITEM_ID {
        at.suggest_resources(items.builtin_entries_of("item"))
    } else if wants == ITEM_START and typed.is_empty() {
        at.suggest(String("["), none)
    } else if wants == ITEM_GIVE_OR_TAKE {
        at.suggest(String("!"), none)
        at.suggest_resources_ending(saved_components(items), "=")
    } else if wants == ITEM_TAKE {
        at.suggest_resources_ending(saved_components(items), "")
    } else if wants == ITEM_ASSIGN and typed.is_empty() {
        at.suggest(String("="), none)
    } else if wants == ITEM_NEXT and typed.is_empty() {
        at.suggest(String(","), none)
        at.suggest(String("]"), none)
    }
    b.add(at)
}

// What `BlockStateParser`'s reading asks to suggest, by where it's got to: a block; a `[` or
// `{` after one; a property's name or `]`, or a name alone after a `,`; an `=`; a property's
// values; a `]` or `,` after a value; a `{` after the properties; else nothing.
const BLOCK_NOTHING: i32 = 0
const BLOCK_ID: i32 = 1
const BLOCK_OPEN: i32 = 2
const BLOCK_NAME_OR_END: i32 = 3
const BLOCK_NAME: i32 = 4
const BLOCK_EQUALS: i32 = 5
const BLOCK_VALUE: i32 = 6
const BLOCK_NEXT: i32 = 7
const BLOCK_NBT: i32 = 8

// Where `BlockStateParser`'s reading of a block stopped, for its suggestions: what it asks for,
// the block and state read so far, the properties written, and the property whose value's next.
struct BlockSuggestion {
    wants: i32
    block: u32
    state: u32
    given: List<Prop>
    property: Prop?
}

// `BlockStateParser.fillSuggestions`, not for testing, with NBT allowed: what was typed read as
// `parse` reads it, until it ends or fails, the last suggestions it asked for made from where
// the reader stopped (CAL-165).
fn suggest_block(b: mut Builder, blocks: BlockNames) {
    var r = Reader.new(b.remaining())
    let s = block_suggestion(mut r, blocks)
    var at = b.from(b.start + r.at)
    let typed = at.remaining()
    let w = s.wants
    if w == BLOCK_ID {
        var ids = List<Identifier>()
        for i in 0..blocks.states.blocks.len() {
            match Identifier.parse(blocks.states.blocks.name(i)) {
                ok(id) => ids.push(id),
                err(_) => {},
            }
        }
        at.suggest_resources(ids)
    } else if w == BLOCK_OPEN and typed.is_empty() {
        if not blocks.states.props(s.block).is_empty() {
            at.suggest(String("["), none)
        }
        if blocks.entities.contains(s.block) {
            at.suggest(String("\{"), none)
        }
    } else if w == BLOCK_NAME_OR_END or w == BLOCK_NAME {
        if w == BLOCK_NAME_OR_END and typed.is_empty() {
            at.suggest(String("]"), none)
        }
        let prefix = typed.to_lower_root()
        for p in blocks.states.props(s.block) {
            let name = blocks.states.prop_name(p)
            if not given_has(s.given, p) and name.starts_with(prefix) {
                at.suggest("{name}=", none)
            }
        }
    } else if w == BLOCK_EQUALS and typed.is_empty() {
        at.suggest(String("="), none)
    } else if w == BLOCK_VALUE {
        if let p = s.property {
            let low = blocks.states.int_start(p)
            for i in 0..p.count {
                match low {
                    some(n) => at.suggest_int(n + i32.wrap(i)),
                    none => at.suggest(blocks.states.value_name(p, i), none),
                }
            }
        }
    } else if w == BLOCK_NEXT and typed.is_empty() {
        at.suggest(String("]"), none)
        if s.given.len() < blocks.states.props(s.block).len() {
            at.suggest(String(","), none)
        }
    } else if w == BLOCK_NBT and typed.is_empty() and blocks.entities.contains(s.block) {
        at.suggest(String("\{"), none)
    }
    b.add(at)
}

// `BlockStateParser.parse` with the suggestions it asks for at each step, and the reader where
// it stopped, back at a part's start where that part failed as vanilla's parts set the cursor
// back.
fn block_suggestion(r: mut Reader, blocks: BlockNames) -> BlockSuggestion {
    var s = BlockSuggestion { wants: BLOCK_ID, block: 0, state: 0, given: [], property: none }
    if r.can_read() and r.peek() == '#' {
        return s
    }
    let start = r.at
    let id = match r.read_identifier() {
        ok(i) => i,
        err(_) => return s,
    }
    s.block = match blocks.states.blocks.parse(id.to_string()) {
        ok(block) => block,
        err(_) => {
            r.at = start
            return s
        },
    }
    s.state = blocks.states.default_state(s.block)
    s.wants = BLOCK_OPEN
    if r.can_read() and r.peek() == '[' {
        r.skip()
        s.wants = BLOCK_NAME_OR_END
        r.skip_whitespace()
        while r.can_read() and r.peek() != ']' {
            r.skip_whitespace()
            let key_start = r.at
            let key = match r.read_string() {
                ok(k) => k,
                err(_) => return s,
            }
            let p = match blocks.states.prop(s.block, key) {
                some(p) => p,
                none => {
                    r.at = key_start
                    return s
                },
            }
            if given_has(s.given, p) {
                r.at = key_start
                return s
            }
            r.skip_whitespace()
            s.wants = BLOCK_EQUALS
            if not r.can_read() or r.peek() != '=' {
                return s
            }
            r.skip()
            r.skip_whitespace()
            s.wants = BLOCK_VALUE
            s.property = some(p)
            let value_start = r.at
            let raw = match r.read_string() {
                ok(v) => v,
                err(_) => return s,
            }
            let index = match blocks.states.value_of(p, raw) {
                some(i) => i,
                none => {
                    r.at = value_start
                    return s
                },
            }
            s.state = p.set(s.state, index)
            s.given.push(p)
            s.wants = BLOCK_NEXT
            r.skip_whitespace()
            if r.can_read() {
                if r.peek() != ',' {
                    if r.peek() != ']' {
                        return s
                    }
                    break
                }
                r.skip()
                s.wants = BLOCK_NAME
            }
        }
        if not r.can_read() {
            return s
        }
        r.skip()
        s.wants = BLOCK_NBT
    }
    if r.can_read() and r.peek() == '{' {
        s.wants = BLOCK_NOTHING
    }
    return s
}

// Whether `p` is among the properties `given`.
fn given_has(given: List<Prop>, p: Prop) -> bool {
    for g in given {
        if g.id == p.id {
            return true
        }
    }
    return false
}

// The component types that are saved, whose codecs `suggestComponent` asks for.
fn saved_components(items: ItemCodecs) -> List<Identifier> {
    var out = List<Identifier>()
    for id in items.builtin_entries_of("data_component_type") {
        if items.saved_component(id.to_string()) {
            out.push(id.copy())
        }
    }
    return out
}

// `ItemParser.State.parse` with the suggestions visitor: what it last asked to suggest, with the
// reader where it stopped, back at a part's start where that part failed as vanilla's parts set
// the cursor back.
fn item_suggestion(r: mut Reader, items: ItemCodecs) -> i32 {
    let start = r.at
    match r.read_identifier() {
        ok(id) => {
            if items.builtin_id("item", id.to_string()) == none {
                r.at = start
                return ITEM_ID
            }
        },
        err(_) => return ITEM_ID,
    }
    if not r.can_read() or r.peek() != '[' {
        return ITEM_START
    }
    r.skip()
    var wants = ITEM_GIVE_OR_TAKE
    var seen = List<String>()
    while r.can_read() and r.peek() != ']' {
        r.skip_whitespace()
        if r.can_read() and r.peek() == '!' {
            r.skip()
            wants = ITEM_TAKE
            let name = match component_type(mut r, items) {
                ok(n) => n,
                err(_) => return wants,
            }
            if seen.contains(name) {
                return wants
            }
            seen.push(name)
            wants = ITEM_NOTHING
            r.skip_whitespace()
        } else {
            let name = match component_type(mut r, items) {
                ok(n) => n,
                err(_) => return wants,
            }
            if seen.contains(name) {
                return wants
            }
            seen.push(name.copy())
            wants = ITEM_ASSIGN
            r.skip_whitespace()
            if not r.can_read() or r.peek() != '=' {
                return wants
            }
            r.skip()
            wants = ITEM_NOTHING
            r.skip_whitespace()
            let at = r.at
            let (tag, end) = match tag_at(r.units, r.text, r.at) {
                ok(read) => read,
                err(_) => return wants,
            }
            r.at = end
            match items.read_component(name, tag) {
                ok(_) => {},
                err(_) => {
                    r.at = at
                    return wants
                },
            }
            r.skip_whitespace()
        }
        wants = ITEM_NEXT
        if not r.can_read() or r.peek() != ',' {
            break
        }
        r.skip()
        r.skip_whitespace()
        wants = ITEM_GIVE_OR_TAKE
        if not r.can_read() {
            return wants
        }
    }
    if not r.can_read() or r.peek() != ']' {
        return wants
    }
    r.skip()
    return ITEM_NOTHING
}

// `EntityArgument.listSuggestions` as `EntitySelectorParser.fillSuggestions` fills it, where
// the selector's read stops: with nothing typed, the players' names, then the selectors where
// the source may use them; a name, the names it begins; an `@` alone or with a type it doesn't
// have, the selectors from the `@`; a selector's type with no `[` after it, a `[` after the
// type. An `@` where the source may not use selectors suggests nothing, and inside a selector's
// options Calcite doesn't suggest yet.
fn suggest_entities(b: mut Builder, known: Known) {
    let units = units_of(b.remaining())
    if units.is_empty() {
        b.suggest_matching(known.players)
        if known.selectors {
            fill_selectors(mut b)
        }
        return
    }
    if units[0] != '@' {
        b.suggest_matching(known.players)
        return
    }
    if not known.selectors {
        return
    }
    if units.len() == 1 or not is_selector_type(units[1]) {
        fill_selectors(mut b)
        return
    }
    if units.len() == 2 or units[2] != '[' {
        var after = b.from(b.start + 2)
        after.suggest(String("["), none)
        b.add(after)
    }
}

// Whether `c` is one of a selector's types.
fn is_selector_type(c: char) -> bool {
    for t in units_of(String("parsen")) {
        if t == c {
            return true
        }
    }
    return false
}

// `fillSelectorSuggestions`: each selector, with what it picks.
fn fill_selectors(b: mut Builder) {
    let pairs: List<(str, str)> = [("@p", "nearestPlayer"), ("@a", "allPlayers"), ("@r", "randomPlayer"), ("@s", "self"), ("@e", "allEntities"), ("@n", "nearestEntity")]
    for (text, key) in pairs {
        b.suggest(String(text), some(Component.translatable("argument.entity.selector.{key}", [])))
    }
}

// `TimeArgument.listSuggestions`: after a number, its units, `d`, `s`, `t` and none, as its map
// gives them, which the sort puts in order anyway.
fn suggest_time(b: mut Builder) {
    var r = Reader.new(b.remaining())
    match r.read_float() {
        ok(_) => {},
        err(_) => return,
    }
    var units = b.from(b.start + r.at)
    units.suggest_matching([String(""), String("s"), String("d"), String("t")])
    b.add(units)
}

/// `Suggestions.create` of what every builder suggested for `input`: each widened to the range
/// they all cover, `expand`, once each, sorted by `compareToIgnoreCase`, those the same without
/// regard to case in the order they came; or none, over nothing, where there's none (CAL-165).
pub fn create(input: String, all: List<Suggestion>) -> Suggestions {
    if all.is_empty() {
        return Suggestions { start: 0, end: 0, list: [] }
    }
    var start = all[0].start
    var end = all[0].end
    for s in all {
        if s.start < start {
            start = s.start
        }
        if s.end > end {
            end = s.end
        }
    }
    let units = units_of(input)
    var once = List<Suggestion>()
    for s in all {
        var text = String()
        if start < s.start {
            text.push_str(from_units(units, start, s.start))
        }
        text.push_str(s.text)
        if end > s.end {
            text.push_str(from_units(units, s.end, end))
        }
        // `expand` keeps an `IntegerSuggestion` only where the range is its own already.
        let number = if start == s.start and end == s.end { s.number } else { none }
        let wide = Suggestion { start: start, end: end, text: text, tooltip: s.tooltip.copy(), number: number }
        var seen = false
        for o in once {
            if o.text == wide.text and o.tooltip == wide.tooltip {
                seen = true
                break
            }
        }
        if not seen {
            once.push(wide)
        }
    }
    var keys = List<String>()
    for o in once {
        keys.push(o.text.to_lower_root())
    }
    for i in 1..once.len() {
        var j = i
        while j > 0 and sorts_before(once[j], keys[j], once[j - 1], keys[j - 1]) {
            let k = keys[j].copy()
            keys[j] = keys[j - 1].copy()
            keys[j - 1] = k
            let s = once[j].copy()
            once[j] = once[j - 1].copy()
            once[j - 1] = s
            j -= 1
        }
    }
    return Suggestions { start: start, end: end, list: once }
}

// `compareToIgnoreCase`: by number where both are numbers, as `IntegerSuggestion` compares, else
// by their texts in lower case, `ka` and `kb`.
fn sorts_before(a: Suggestion, ka: String, b: Suggestion, kb: String) -> bool {
    if let x = a.number {
        if let y = b.number {
            return x < y
        }
    }
    return ka < kb
}

// `matchesSubStr`: whether `pattern` begins `input`, or begins it after one of its `.`, `_`
// and `/`.
fn matches_part(pattern: String, input: String) -> bool {
    let p = units_of(pattern)
    let s = units_of(input)
    var index: usize = 0
    loop {
        if index + p.len() <= s.len() {
            var same = true
            for k in 0..p.len() {
                if s[index + k] != p[k] {
                    same = false
                    break
                }
            }
            if same {
                return true
            }
        }
        var next: usize? = none
        for k in index..s.len() {
            if s[k] == '.' or s[k] == '_' or s[k] == '/' {
                next = some(k)
                break
            }
        }
        let found = next else return false
        index = found + 1
    }
}

// Whether a node is a message argument, the one `SignedArgument` vanilla has.
fn is_message(k: Kind) -> bool {
    return match k {
        Kind.Argument(a) => match a {
            ArgType.Message => true,
            _ => false,
        },
        _ => false,
    }
}

// `parseNodes`: each child of `node` the source may use and the reader's place lets in, read
// on a copy of the reader and the context. One that fails is kept with its failure. One that
// reads, with more after it, goes on to its children, or, where it redirects, to the node it
// redirects to in a context of its own, which is the parse. Of the rest, the first that read to
// the end, else the first with no failures, else the first.
fn parse_nodes(t: Tree, node: usize, original: Reader, so_far: Context, level: i32, types: Registry) -> Parse {
    var errors = List<(usize, SyntaxError)>()
    var potentials = List<Parse>()
    for child in t.relevant(node, original) {
        if t.nodes[child].level > level {
            continue
        }
        var context = so_far.copy()
        var reader = original.copy()
        match read_node(t, child, mut reader, mut context, level, types) {
            ok => {},
            err(e) => {
                errors.push((child, e))
                continue
            },
        }
        context.command = if t.nodes[child].executable { some(child) } else { none }
        let redirect = t.nodes[child].redirect
        let need: usize = if redirect == none { 2 } else { 1 }
        if reader.at + need <= reader.units.len() {
            reader.skip()
            if let to = redirect {
                let inner = Context { root: to, start: reader.at, nodes: [], arguments: [], command: none }
                let p = parse_nodes(t, to, reader, inner, level, types)
                var contexts: List<Context> = [context]
                for c in p.contexts {
                    contexts.push(c.copy())
                }
                return Parse { contexts: contexts, reader: p.reader.copy(), errors: p.errors.copy() }
            }
            potentials.push(parse_nodes(t, child, reader, context, level, types))
        } else {
            potentials.push(Parse { contexts: [context], reader: reader, errors: [] })
        }
    }
    if potentials.is_empty() {
        return Parse { contexts: [so_far.copy()], reader: original.copy(), errors: errors }
    }
    var best: usize = 0
    for i in 1..potentials.len() {
        if rank(potentials[i]) < rank(potentials[best]) {
            best = i
        }
    }
    return potentials.swap_remove(best)
}

// How brigadier sorts the potential parses: those read to the end first, then those with no
// failures.
fn rank(p: Parse) -> i32 {
    var r = 0
    if p.reader.can_read() {
        r += 2
    }
    if not p.errors.is_empty() {
        r += 1
    }
    return r
}

// `CommandNode.parse`, then `parseNodes`' check that a space or the end comes after it.
fn read_node(t: Tree, at: usize, r: mut Reader, context: mut Context, level: i32, types: Registry) ! SyntaxError {
    let start = r.at
    match t.nodes[at].kind {
        Kind.Literal => {
            // `relevant` only gives a literal its own word, which reads.
            r.at += units_of(t.nodes[at].name).len()
        },
        Kind.Argument(reads) => {
            let value = try read_argument(reads, mut r, level, types, t.resources, t.items, t.blocks)
            context.arguments.push(Argument { name: t.nodes[at].name.copy(), start: start, end: r.at, value: value })
        },
        Kind.Root => {},
    }
    context.nodes.push(Read { node: at, start: start, end: r.at })
    if r.can_read() and r.peek() != ' ' {
        fail r.error_here("command.expected.separator", [])
    }
}

// An argument of the type `reads`, as its `parse` reads it from the reader's place.
fn read_argument(reads: ArgType, r: mut Reader, level: i32, types: Registry, resources: List<ResourceNames>, items: Shared<ItemCodecs>?, blocks: Shared<BlockNames>?) -> Value ! SyntaxError {
    let start = r.at
    match reads {
        ArgType.Bool => return Value.Bool(try r.read_boolean()),
        ArgType.Float(min, max) => {
            let v = try r.read_float()
            if v < min {
                r.at = start
                fail number_error(r, "argument.float.low", Tag.Float(min), Tag.Float(v))
            }
            if v > max {
                r.at = start
                fail number_error(r, "argument.float.big", Tag.Float(max), Tag.Float(v))
            }
            return Value.Float(v)
        },
        ArgType.Double(min, max) => {
            let v = try r.read_double()
            if v < min {
                r.at = start
                fail number_error(r, "argument.double.low", Tag.Double(min), Tag.Double(v))
            }
            if v > max {
                r.at = start
                fail number_error(r, "argument.double.big", Tag.Double(max), Tag.Double(v))
            }
            return Value.Double(v)
        },
        ArgType.Integer(min, max) => {
            let v = try r.read_int()
            if v < min {
                r.at = start
                fail number_error(r, "argument.integer.low", Tag.Int(min), Tag.Int(v))
            }
            if v > max {
                r.at = start
                fail number_error(r, "argument.integer.big", Tag.Int(max), Tag.Int(v))
            }
            return Value.Int(v)
        },
        ArgType.Long(min, max) => {
            let v = try r.read_long()
            if v < min {
                r.at = start
                fail number_error(r, "argument.long.low", Tag.Long(min), Tag.Long(v))
            }
            if v > max {
                r.at = start
                fail number_error(r, "argument.long.big", Tag.Long(max), Tag.Long(v))
            }
            return Value.Long(v)
        },
        ArgType.Word => return Value.Text(r.read_unquoted()),
        ArgType.Phrase => return Value.Text(try r.read_string()),
        ArgType.Greedy => {
            let rest = r.remaining()
            r.at = r.units.len()
            return Value.Text(rest)
        },
        ArgType.Entity(single, players) => {
            let s = try read_entities(mut r, types, level >= SELECTORS)
            // `EntityArgument.parse`'s checks, each at the input's start.
            if s.most > 1 and single {
                r.at = 0
                fail r.error_here(if players { String("argument.player.toomany") } else { String("argument.entity.toomany") }, [])
            }
            if s.entities and players and not s.current {
                r.at = 0
                fail r.error_here("argument.player.entities", [])
            }
            return Value.Entities(s)
        },
        ArgType.GameMode => {
            let name = r.read_unquoted()
            let mode = GameType.by_name(name) else fail r.error_here("argument.gamemode.invalid", [Component.literal(name)])
            return Value.Mode(mode)
        },
        ArgType.Id => return Value.Id(try r.read_identifier()),
        ArgType.Message => return Value.Message(try read_message(mut r, level >= SELECTORS, types)),
        ArgType.Objective => return Value.Text(r.read_unquoted()),
        ArgType.IntRange => return Value.Range(try read_ints(mut r)),
        ArgType.TextComponent => {
            // `CommandArgumentParser.withCodec`: the tag, then the component it holds, or why
            // not where the tag starts.
            let (tag, end) = try tag_at(r.units, r.text, r.at)
            return match Component.from_nbt(tag) {
                ok(c) => {
                    r.at = end
                    Value.Shown(c)
                },
                err(why) => fail r.error_here("argument.component.invalid", [Component.literal(why)]),
            }
        },
        ArgType.Time(least) => {
            // `TimeArgument.parse`: a number, then its unit, days, seconds or ticks, none being
            // ticks, rounded as `Math.round` rounds a float.
            let value = try r.read_float()
            let unit = r.read_unquoted()
            let factor: i32 = if unit == "" or unit == "t" { 1 } else if unit == "s" { 20 } else if unit == "d" { 24000 } else { 0 }
            if factor == 0 {
                fail r.error_here("argument.time.invalid_unit", [])
            }
            let ticks = round_float(value * f32.nearest(factor))
            if ticks < least {
                fail number_error(r, "argument.time.tick_count_too_low", Tag.Int(least), Tag.Int(ticks))
            }
            return Value.Int(ticks)
        },
        ArgType.Vec3 => return Value.Place(try vec3(mut r, true)),
        ArgType.Rotation => return Value.Place(try rotation(mut r)),
        ArgType.Resource(registry) => {
            // `ResourceArgument.parse`: an identifier, then the entry of that name, or why not
            // after it. A registry the tree wasn't given doesn't read yet.
            var known: List<Identifier>? = none
            for n in resources {
                if n.registry == registry {
                    known = some(n.names.copy())
                }
            }
            let names = known else fail SyntaxError { message: Component.literal("Calcite can't read {registry} resources yet"), input: r.text.copy(), cursor: r.at }
            let id = try r.read_identifier()
            for n in names {
                if n.namespace == id.namespace and n.path == id.path {
                    return Value.Id(id)
                }
            }
            fail r.error_here("argument.resource.not_found", [Component.literal(id.to_string()), Component.literal(registry)])
        },
        ArgType.Item => {
            let codecs = items else fail SyntaxError { message: Component.literal("Calcite can't read items yet"), input: r.text.copy(), cursor: r.at }
            return Value.Stack(try read_item(mut r, codecs.value))
        },
        ArgType.BlockPos => return Value.Place(try block_pos(mut r)),
        ArgType.Block => {
            let names = blocks else fail SyntaxError { message: Component.literal("Calcite can't read blocks yet"), input: r.text.copy(), cursor: r.at }
            return Value.Block(try read_block(mut r, names.value))
        },
        ArgType.Anchor => {
            // `EntityAnchorArgument.parse`: a word, `feet` or `eyes`, or why not where it begins.
            let word = r.read_unquoted()
            if word == "feet" or word == "eyes" {
                return Value.Eyes(word == "eyes")
            }
            r.at = start
            fail r.error_here("argument.anchor.invalid", [Component.literal(word)])
        },
        ArgType.Unread(name) => fail SyntaxError { message: Component.literal("Calcite can't read {name} arguments yet"), input: r.text.copy(), cursor: r.at },
    }
}

// `ItemParser.parse`: an item by its ID, or `argument.item.id.invalid` where it starts; then,
// where a `[` follows, its components, each a type's ID, `=` and its value as SNBT, which the
// type's codec must read, else `arguments.item.component.malformed` where the value starts, or
// `!` and the ID of one taken away, no type twice, split by `,`s, up to a `]` (CAL-165).
fn read_item(r: mut Reader, items: ItemCodecs) -> ItemInput ! SyntaxError {
    let start = r.at
    let id = try r.read_identifier()
    let item = id.to_string()
    if items.builtin_id("item", item.copy()) == none {
        r.at = start
        fail r.error_here("argument.item.id.invalid", [Component.literal(item)])
    }
    var patch = List<(String, Tag)>()
    if not r.can_read() or r.peek() != '[' {
        return ItemInput { item: item, patch: patch }
    }
    try r.expect('[')
    var seen = List<String>()
    while r.can_read() and r.peek() != ']' {
        r.skip_whitespace()
        if r.can_read() and r.peek() == '!' {
            r.skip()
            let name = try component_type(mut r, items)
            if seen.contains(name) {
                fail repeated(name)
            }
            seen.push(name.copy())
            patch.push(("!{name}", Tag.Compound(JavaHashMap<String, Tag>())))
            r.skip_whitespace()
        } else {
            let name = try component_type(mut r, items)
            if seen.contains(name) {
                fail repeated(name)
            }
            seen.push(name.copy())
            r.skip_whitespace()
            try r.expect('=')
            r.skip_whitespace()
            let at = r.at
            let (tag, end) = try tag_at(r.units, r.text, r.at)
            r.at = end
            match items.read_component(name.copy(), tag) {
                ok(v) => patch.push((name.copy(), v)),
                err(why) => {
                    r.at = at
                    fail r.error_here("arguments.item.component.malformed", [Component.literal(name), Component.literal(why)])
                },
            }
            r.skip_whitespace()
        }
        if not r.can_read() or r.peek() != ',' {
            break
        }
        r.skip()
        r.skip_whitespace()
        if not r.can_read() {
            fail r.error_here("arguments.item.component.expected", [])
        }
    }
    try r.expect(']')
    return ItemInput { item: item, patch: patch }
}

// `BlockStateParser.parseForBlock` with NBT allowed: a block by its ID, or
// `argument.block.id.invalid` where it starts, and no tag; then, where a `[` follows, its
// properties, each a name, `=` and a value, read as strings, split by `,`s, up to a `]`: one it
// hasn't, one written twice, one with no value and a value it hasn't each failing where vanilla's
// do; then, where a `{` follows, the NBT of its block entity (CAL-165).
fn read_block(r: mut Reader, blocks: BlockNames) -> BlockInput ! SyntaxError {
    if r.can_read() and r.peek() == '#' {
        fail r.error_here("argument.block.tag.disallowed", [])
    }
    let start = r.at
    let id = try r.read_identifier()
    let name = id.to_string()
    let block = match blocks.states.blocks.parse(name.copy()) {
        ok(found) => found,
        err(_) => {
            r.at = start
            fail r.error_here("argument.block.id.invalid", [Component.literal(name)])
        },
    }
    var state = blocks.states.default_state(block)
    var given = List<Prop>()
    if r.can_read() and r.peek() == '[' {
        r.skip()
        r.skip_whitespace()
        while r.can_read() and r.peek() != ']' {
            r.skip_whitespace()
            let key_start = r.at
            let key = try r.read_string()
            let p = match blocks.states.prop(block, key.copy()) {
                some(found) => found,
                none => {
                    r.at = key_start
                    fail r.error_here("argument.block.property.unknown", [Component.literal(name), Component.literal(key)])
                },
            }
            if given_has(given, p) {
                r.at = key_start
                fail r.error_here("argument.block.property.duplicate", [Component.literal(key), Component.literal(name)])
            }
            r.skip_whitespace()
            if not r.can_read() or r.peek() != '=' {
                fail r.error_here("argument.block.property.novalue", [Component.literal(key), Component.literal(name)])
            }
            r.skip()
            r.skip_whitespace()
            let value_start = r.at
            let raw = try r.read_string()
            let index = match blocks.states.value_of(p, raw.copy()) {
                some(i) => i,
                none => {
                    r.at = value_start
                    fail r.error_here("argument.block.property.invalid", [Component.literal(name), Component.literal(raw), Component.literal(key)])
                },
            }
            state = p.set(state, index)
            given.push(p)
            r.skip_whitespace()
            if r.can_read() {
                if r.peek() != ',' {
                    if r.peek() != ']' {
                        fail r.error_here("argument.block.property.unclosed", [])
                    }
                    break
                }
                r.skip()
            }
        }
        if not r.can_read() {
            fail r.error_here("argument.block.property.unclosed", [])
        }
        r.skip()
    }
    var nbt: Tag? = none
    if r.can_read() and r.peek() == '{' {
        let (tag, end) = try compound_at(r.units, r.text, r.at)
        r.at = end
        nbt = some(tag)
    }
    return BlockInput { state: state, given: given, nbt: nbt }
}

// `readComponentType`: a component type that's saved, by its ID, as its whole ID; nothing is
// `arguments.item.component.expected` here, and a type there isn't or that isn't saved
// `arguments.item.component.unknown` where its ID starts.
fn component_type(r: mut Reader, items: ItemCodecs) -> String ! SyntaxError {
    if not r.can_read() {
        fail r.error_here("arguments.item.component.expected", [])
    }
    let start = r.at
    let id = try r.read_identifier()
    let name = id.to_string()
    if items.saved_component(name.copy()) {
        return name
    }
    r.at = start
    fail r.error_here("arguments.item.component.unknown", [Component.literal(name)])
}

// `ERROR_REPEATED_COMPONENT.create`: a type given twice, with no place in the input.
fn repeated(name: String) -> SyntaxError {
    return SyntaxError { message: Component.translatable("arguments.item.component.repeated", [Component.literal(name)]), input: String(), cursor: NOWHERE }
}

// A number argument's bound error at the reader's place, with the bound and what was found as
// numbers.
fn number_error(r: Reader, key: str, bound: own Tag, found: own Tag) -> SyntaxError {
    return SyntaxError { message: Component.translatable_args(String(key), [TextArgument.Number(bound), TextArgument.Number(found)]), input: r.text.copy(), cursor: r.at }
}

// `MessageArgument.Message.parseText`: the rest, of at most `MESSAGE_MOST` units, else a
// failure with no place; with the selectors in it where the source may use them, each `@`
// that isn't one's start passed by.
fn read_message(r: mut Reader, selectors: bool, types: Registry) -> Message ! SyntaxError {
    let left = r.units.len() - r.at
    if left > MESSAGE_MOST {
        fail SyntaxError { message: Component.translatable_args(String("argument.message.too_long"), [TextArgument.Number(Tag.Int(i32.wrap(left))), TextArgument.Number(Tag.Int(i32.wrap(MESSAGE_MOST)))]), input: String(), cursor: NOWHERE }
    }
    let text = r.remaining()
    if not selectors {
        r.at = r.units.len()
        return Message { text: text, parts: [] }
    }
    let offset = r.at
    var parts = List<Part>()
    while r.can_read() {
        if r.peek() != '@' {
            r.skip()
            continue
        }
        let start = r.at
        match read_entities(mut r, types, true) {
            ok(s) => parts.push(Part { start: start - offset, end: r.at - offset, selector: s }),
            err(e) => {
                if not passed_by(e) {
                    fail e
                }
                r.at = start + 1
            },
        }
    }
    return Message { text: text, parts: parts }
}

// Whether a message passes by what failed to read as a selector: an `@` with no type after it,
// or one it hasn't.
fn passed_by(e: SyntaxError) -> bool {
    return match e.message.contents {
        Contents.Translatable(t) => t.key == "argument.entity.selector.missing" or t.key == "argument.entity.selector.unknown",
        _ => false,
    }
}

/// The ID of the argument type `name`, such as `entity` or `brigadier:float`, in
/// `command_argument_type`.
pub fn argument_type(name: str) -> i32 {
    let types = argument_types()
    for i in 0..types.len() {
        if types[i] == String(name) {
            return i32.wrap(i)
        }
    }
    panic("there's no command argument type {name}")
}

// The argument types' names, in ID order, as `registry.builtin` writes them.
fn argument_types() -> List<String> {
    let names = builtin_names()
    for r in 0..names.len() {
        if names[r] == "command_argument_type" {
            return builtin_entries(r)
        }
    }
    panic("there's no command_argument_type registry")
}

/// The entity types, as a selector's `type` reads them: a registry made from the built-in
/// one's names.
pub fn entity_types() -> Registry {
    let names = builtin_names()
    var types = Registry.new(Identifier { namespace: "minecraft", path: "entity_type" }, false)
    for r in 0..names.len() {
        if names[r] == "entity_type" {
            for e in builtin_entries(r) {
                types.add(Identifier { namespace: "minecraft", path: e.copy() }, none)
            }
        }
    }
    return types
}

// How an argument of the type `name` reads, with its `properties`.
fn arg_type(name: String, properties: List<u8>) -> ArgType {
    if name == "brigadier:bool" {
        return ArgType.Bool
    }
    if name == "brigadier:float" {
        let flags = properties[0]
        var at: usize = 1
        var min = -f32.MAX
        var max = f32.MAX
        if flags & 1 != 0 {
            min = f32.from_bits(u32.wrap(be(properties, at, 4)))
            at += 4
        }
        if flags & 2 != 0 {
            max = f32.from_bits(u32.wrap(be(properties, at, 4)))
        }
        return ArgType.Float(min, max)
    }
    if name == "brigadier:double" {
        let flags = properties[0]
        var at: usize = 1
        var min = -f64.MAX
        var max = f64.MAX
        if flags & 1 != 0 {
            min = f64.from_bits(be(properties, at, 8))
            at += 8
        }
        if flags & 2 != 0 {
            max = f64.from_bits(be(properties, at, 8))
        }
        return ArgType.Double(min, max)
    }
    if name == "brigadier:integer" {
        let flags = properties[0]
        var at: usize = 1
        var min = i32.MIN
        var max = i32.MAX
        if flags & 1 != 0 {
            min = i32.wrap(be(properties, at, 4))
            at += 4
        }
        if flags & 2 != 0 {
            max = i32.wrap(be(properties, at, 4))
        }
        return ArgType.Integer(min, max)
    }
    if name == "brigadier:long" {
        let flags = properties[0]
        var at: usize = 1
        var min = i64.MIN
        var max = i64.MAX
        if flags & 1 != 0 {
            min = i64.wrap(be(properties, at, 8))
            at += 8
        }
        if flags & 2 != 0 {
            max = i64.wrap(be(properties, at, 8))
        }
        return ArgType.Long(min, max)
    }
    if name == "brigadier:string" {
        return match properties[0] {
            0 => ArgType.Word,
            1 => ArgType.Phrase,
            _ => ArgType.Greedy,
        }
    }
    if name == "entity" {
        return ArgType.Entity(properties[0] & 1 != 0, properties[0] & 2 != 0)
    }
    if name == "gamemode" {
        return ArgType.GameMode
    }
    if name == "resource_location" or name == "dimension" {
        return ArgType.Id
    }
    if name == "message" {
        return ArgType.Message
    }
    if name == "objective" {
        return ArgType.Objective
    }
    if name == "component" {
        return ArgType.TextComponent
    }
    if name == "time" {
        return ArgType.Time(i32.wrap(be(properties, 0, 4)))
    }
    if name == "int_range" {
        return ArgType.IntRange
    }
    if name == "vec3" {
        return ArgType.Vec3
    }
    if name == "rotation" {
        return ArgType.Rotation
    }
    if name == "entity_anchor" {
        return ArgType.Anchor
    }
    if name == "item_stack" {
        return ArgType.Item
    }
    if name == "block_pos" {
        return ArgType.BlockPos
    }
    if name == "block_state" {
        return ArgType.Block
    }
    if name == "resource" {
        // Its registry's name, as the packet writes a string.
        var w = WireReader.new(properties.copy())
        return match w.string(32767) {
            ok(registry) => ArgType.Resource(registry),
            err(_) => ArgType.Unread(name.copy()),
        }
    }
    return ArgType.Unread(name.copy())
}

// `size` bytes from `at`, high first, as a `u64`.
fn be(bytes: List<u8>, at: usize, size: usize) -> u64 {
    var v: u64 = 0
    for i in at..at + size {
        v = (v << 8) | u64(bytes[i])
    }
    return v
}
