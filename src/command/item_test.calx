/// `item_predicate` arguments, `ItemPredicateArgument` (CAL-255): read as
/// `ComponentPredicateParser.createGrammar`'s packrat grammar reads them, an item, an item tag or
/// `*`, then, in `[...]`, tests split by `,`, each any of its terms split by `|`, a term a test
/// or `!` and a test, a test a component and `=` its value, a predicate and `~` its value, or a
/// component it must have. Where nothing reads, the error is the first stored where reading got
/// furthest, `ErrorCollector.LongestOnly`. `world.loot` tests stacks with what's read.
module command.item_test

import chat.component.{Component}
import command.reader.{Reader}
import nbt.snbt.{SyntaxError, from_units, tag_at}
import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import resources.identifier.{Identifier}

/// The stack's item is `name`'s.
pub const ITEM_IS: i32 = 0
/// The stack's item is in the tag `name`.
pub const ITEM_IN: i32 = 1
/// The stack's component `name` is `value`, as its codec writes it.
pub const VALUE_IS: i32 = 2
/// The stack has the component `name`, its own or its item's.
pub const HAS: i32 = 3
/// The predicate `name` holds of the stack, `value` as written.
pub const HOLDS: i32 = 4
/// The stack's count is within `value`, `MinMaxBounds.Ints` as written, the `count` pseudo
/// component's and predicate's.
pub const COUNT_IN: i32 = 5
/// Always, `count` as a component it must have.
pub const ALWAYS: i32 = 6

/// A test of a stack, negated or not.
pub struct ItemTerm {
    pub kind: i32
    pub name: String = String()
    pub value: Tag
    pub negated: bool = false
}

/// What an `item_predicate` argument read: each of `all` must hold, each where any of its terms
/// does, `Util.allOf` of `Util.anyOf`s.
pub struct ItemTest {
    pub all: List<List<ItemTerm>> = List<List<ItemTerm>>()
}

impl ItemTest {
    /// Every stack, `*` with no tests.
    pub fn any() -> ItemTest {
        return ItemTest()
    }
}

// `ErrorCollector.LongestOnly`, of which only the first error where reading got furthest is
// thrown, as `Grammar.parseForCommands` throws the first `CommandSyntaxException`.
struct Longest {
    at: i64 = -1
    first: SyntaxError? = none
}

impl Longest {
    fn store(mut self, cursor: usize, e: own SyntaxError) {
        let c = i64.wrap(cursor)
        if c > self.at {
            self.at = c
            self.first = some(e)
        } else if c == self.at and self.first == none {
            self.first = some(e)
        }
    }
}

// An error made at `cursor` of `r`'s text, as `createWithContext` or a `DelayedException` makes
// it there.
fn error_at(r: Reader, cursor: usize, key: str, args: own List<Component>) -> SyntaxError {
    return SyntaxError { message: Component.translatable(String(key), args), input: r.text.copy(), cursor: cursor }
}

// `StringReaderTerms.character`: past whitespace, `c`, else `argument.literal.incorrect` there.
fn character(r: mut Reader, c: char, errors: mut Longest) -> bool {
    r.skip_whitespace()
    let at = r.at
    if r.can_read() and r.peek() == c {
        r.skip()
        return true
    }
    errors.store(at, error_at(r, at, "argument.literal.incorrect", [Component.literal(from_units([c], 0, 1))]))
    return false
}

// `IdentifierParseRule` within `ResourceLookupRule`: past whitespace, an identifier, not empty,
// else `argument.id.invalid` where it starts. With where it starts.
fn identifier(r: mut Reader, errors: mut Longest) -> (Identifier, usize)? {
    r.skip_whitespace()
    let at = r.at
    let read = match r.read_identifier() {
        ok(id) => if r.at > at { some(id) } else { none },
        err(_) => none,
    }
    if let id = read {
        return some((id, at))
    }
    r.at = at
    errors.store(at, error_at(r, at, "argument.id.invalid", []))
    return none
}

/// `ItemPredicateArgument.parse` from the reader's place, with the items, item tags, components
/// and predicate types of `items`' registries; or the error where it doesn't read.
pub fn read_item_test(r: mut Reader, items: ItemCodecs) -> ItemTest ! SyntaxError {
    var errors = Longest()
    let start = r.at
    // `type`, `[`, a cut, conditions or none, `]`; else, from the start, `type` alone.
    if let first = item_type(mut r, items, mut errors) {
        var all = List<List<ItemTerm>>()
        if not first.is_empty() {
            all.push(first)
        }
        let typed = r.at
        if character(mut r, '[', mut errors) {
            let before = r.at
            match conditions(mut r, items, mut errors) {
                some(more) => {
                    for each in more {
                        all.push(each.copy())
                    }
                },
                none => r.at = before,
            }
            if character(mut r, ']', mut errors) {
                return ItemTest { all: all }
            }
        } else {
            r.at = typed
            return ItemTest { all: all }
        }
    }
    r.at = start
    let e = errors.first else fail error_at(r, start, "argument.id.invalid", [])
    fail e.copy()
}

// `type`: an item, `#` and, past a cut, an item tag, or `*`, which tests nothing, as a list of
// the one term or none.
fn item_type(r: mut Reader, items: ItemCodecs, errors: mut Longest) -> List<ItemTerm>? {
    let mark = r.at
    if let (id, at) = identifier(mut r, mut errors) {
        let name = id.to_string()
        if items.builtin_id("item", name.copy()) != none {
            return some([ItemTerm { kind: ITEM_IS, name: name, value: Tag.End }])
        }
        errors.store(at, error_at(r, r.at, "argument.item.id.invalid", [Component.literal(name)]))
    }
    r.at = mark
    if character(mut r, '#', mut errors) {
        let (id, at) = identifier(mut r, mut errors) else return none
        let name = id.to_string()
        if items.has_tag("item", name.copy()) {
            return some([ItemTerm { kind: ITEM_IN, name: name, value: Tag.End }])
        }
        errors.store(at, error_at(r, r.at, "arguments.item.tag.unknown", [Component.literal(name)]))
        return none
    }
    r.at = mark
    if character(mut r, '*', mut errors) {
        return some(List<ItemTerm>())
    }
    r.at = mark
    return none
}

// `conditions`: alternatives, then, where it reads, `,` and more conditions.
fn conditions(r: mut Reader, items: ItemCodecs, errors: mut Longest) -> List<List<ItemTerm>>? {
    let first = alternatives(mut r, items, mut errors) else return none
    var out: List<List<ItemTerm>> = [first]
    let mark = r.at
    if character(mut r, ',', mut errors) {
        if let rest = conditions(mut r, items, mut errors) {
            for each in rest {
                out.push(each.copy())
            }
            return some(out)
        }
    }
    r.at = mark
    return some(out)
}

// `alternatives`: a term, then, where it reads, `|` and more alternatives.
fn alternatives(r: mut Reader, items: ItemCodecs, errors: mut Longest) -> List<ItemTerm>? {
    let first = term(mut r, items, mut errors) else return none
    var out: List<ItemTerm> = [first]
    let mark = r.at
    if character(mut r, '|', mut errors) {
        if let rest = alternatives(mut r, items, mut errors) {
            for each in rest {
                out.push(each.copy())
            }
            return some(out)
        }
    }
    r.at = mark
    return some(out)
}

// `term`: a test, or `!` and a test, negated.
fn term(r: mut Reader, items: ItemCodecs, errors: mut Longest) -> ItemTerm? {
    let mark = r.at
    if let t = test(mut r, items, mut errors) {
        return some(t)
    }
    r.at = mark
    if character(mut r, '!', mut errors) {
        if let found = test(mut r, items, mut errors) {
            var t = found
            t.negated = true
            return some(t)
        }
    }
    r.at = mark
    return none
}

// `test`: a component, `=`, a cut and its value; a predicate, `~`, a cut and its value; or a
// component the stack must have.
fn test(r: mut Reader, items: ItemCodecs, errors: mut Longest) -> ItemTerm? {
    let mark = r.at
    if let name = component_type(mut r, items, mut errors) {
        if character(mut r, '=', mut errors) {
            let (value, _) = tag(mut r, mut errors) else return none
            return component_test(r, name, value, items, mut errors)
        }
    }
    r.at = mark
    if let name = predicate_type(mut r, items, mut errors) {
        if character(mut r, '~', mut errors) {
            let (value, _) = tag(mut r, mut errors) else return none
            return predicate_test(r, name, value, items, mut errors)
        }
    }
    r.at = mark
    if let name = component_type(mut r, items, mut errors) {
        if name == "minecraft:count" {
            return some(ItemTerm { kind: ALWAYS, name: name, value: Tag.End })
        }
        return some(ItemTerm { kind: HAS, name: name, value: Tag.End })
    }
    r.at = mark
    return none
}

// `component_type`: a component a stack can be given, with a codec, or the pseudo component
// `count`, else `arguments.item.component.unknown`.
fn component_type(r: mut Reader, items: ItemCodecs, errors: mut Longest) -> String? {
    let (id, at) = identifier(mut r, mut errors) else return none
    let name = id.to_string()
    if name == "minecraft:count" or items.saved_component(name.copy()) {
        return some(name)
    }
    errors.store(at, error_at(r, r.at, "arguments.item.component.unknown", [Component.literal(name)]))
    return none
}

// `predicate_type`: the pseudo predicate `count`, a `DataComponentPredicate.Type`, or else any
// component, whose test is that the stack has it, else `arguments.item.predicate.unknown`.
fn predicate_type(r: mut Reader, items: ItemCodecs, errors: mut Longest) -> String? {
    let (id, at) = identifier(mut r, mut errors) else return none
    let name = id.to_string()
    if name == "minecraft:count" or items.builtin_id("data_component_predicate_type", name.copy()) != none or items.builtin_id("data_component_type", name.copy()) != none {
        return some(name)
    }
    errors.store(at, error_at(r, r.at, "arguments.item.predicate.unknown", [Component.literal(name)]))
    return none
}

// `TagParseRule`: past whitespace, a tag as SNBT, `parseAsArgument`, else its error.
fn tag(r: mut Reader, errors: mut Longest) -> (Tag, usize)? {
    r.skip_whitespace()
    let at = r.at
    match tag_at(r.units, r.text, r.at) {
        ok((t, end)) => {
            r.at = end
            return some((t, at))
        },
        err(e) => {
            errors.store(at, e)
            return none
        },
    }
}

// `createComponentTest` of `value`: `count`'s bounds; else the value as the component's codec
// reads it, else `arguments.item.component.malformed` where reading got to.
fn component_test(r: Reader, name: String, value: Tag, items: ItemCodecs, errors: mut Longest) -> ItemTerm? {
    if name == "minecraft:count" {
        return count_test(r, name, value, "arguments.item.component.malformed", mut errors)
    }
    match items.read_component(name.copy(), value) {
        ok(v) => return some(ItemTerm { kind: VALUE_IS, name: name.copy(), value: v }),
        err(why) => {
            errors.store(r.at, error_at(r, r.at, "arguments.item.component.malformed", [Component.literal(name), Component.literal(why)]))
            return none
        },
    }
}

// `createPredicateTest` of `value`: `count`'s bounds; a predicate's value, kept as written for
// `world.loot` to test; or, for a component that isn't a predicate type, that the stack has it,
// whatever the value, `Unit.CODEC`.
fn predicate_test(r: Reader, name: String, value: Tag, items: ItemCodecs, errors: mut Longest) -> ItemTerm? {
    if name == "minecraft:count" {
        return count_test(r, name, value, "arguments.item.predicate.malformed", mut errors)
    }
    if items.builtin_id("data_component_predicate_type", name.copy()) == none {
        return some(ItemTerm { kind: HAS, name: name.copy(), value: Tag.End })
    }
    return some(ItemTerm { kind: HOLDS, name: name.copy(), value: value.copy() })
}

// `MinMaxBounds.Ints.CODEC` of `value`: a whole number, or a compound of `min` and `max`, each a
// whole number where it's there, `min` no more than `max`.
fn count_test(r: Reader, name: String, value: Tag, key: str, errors: mut Longest) -> ItemTerm? {
    var why: String? = none
    match value {
        Tag.Compound(m) => {
            var bounds = List<i32>()
            for k in ["min", "max"] {
                if m.contains(k) {
                    match m[k].number_int() {
                        some(n) => bounds.push(n),
                        none => why = some("Not a number: {m[k].to_snbt()}"),
                    }
                }
            }
            if why == none and m.contains("min") and m.contains("max") and bounds.len() == 2 and bounds[0] > bounds[1] {
                why = some("Swapped min/max in range ({bounds[0]}, {bounds[1]})")
            }
        },
        other => if other.number_int() == none {
            why = some("Not a number: {other.to_snbt()}")
        },
    }
    if let w = why {
        errors.store(r.at, error_at(r, r.at, key, [Component.literal(name), Component.literal(w)]))
        return none
    }
    return some(ItemTerm { kind: COUNT_IN, name: name.copy(), value: value.copy() })
}
