/// Positions as commands write them, read as vanilla's `BlockPosArgument` reads them: three
/// world coordinates, each a number or `~` and an offset from where the command runs, or three
/// local ones, each `^` and an offset along where it faces (D368).
module command.coordinates

import command.reader.{Reader}
import math.mth.{table_cos, table_sin}
import nbt.snbt.{SyntaxError}

/// One world coordinate, vanilla's `WorldCoordinate`: a value, or an offset where it's
/// relative.
pub struct Coordinate {
    pub relative: bool
    pub value: f64
}

impl Coordinate {
    /// `get`: the value, or the offset from `original` where it's relative.
    pub fn get(self, original: f64) -> f64 {
        return if self.relative { self.value + original } else { self.value }
    }
}

/// A position as written, vanilla's `Coordinates`.
pub enum Coordinates {
    /// `WorldCoordinates`: x, y and z.
    World(Coordinate, Coordinate, Coordinate)
    /// `LocalCoordinates`: left, up and forwards.
    Local(f64, f64, f64)
}

impl Coordinates {
    /// `getPosition` for a source at `x`, `y` and `z` that looks at the pitch `x_rot` and the yaw
    /// `y_rot`, its anchor its feet (CAL-165): world ones each from the source's where they're
    /// relative; local ones along where it looks, as `LocalCoordinates.apply` turns them, with
    /// `Mth`'s sines.
    pub fn position(self, x: f64, y: f64, z: f64, x_rot: f32, y_rot: f32) -> (f64, f64, f64) {
        match self {
            Coordinates.World(cx, cy, cz) => return (cx.get(x), cy.get(y), cz.get(z)),
            Coordinates.Local(left, up, forwards) => {
                let rad = 0.017453292f32
                let y_cos = table_cos(f64((y_rot + 90.0f32) * rad))
                let y_sin = table_sin(f64((y_rot + 90.0f32) * rad))
                let x_cos = table_cos(f64(-x_rot * rad))
                let x_sin = table_sin(f64(-x_rot * rad))
                let x_cos_up = table_cos(f64((-x_rot + 90.0f32) * rad))
                let x_sin_up = table_sin(f64((-x_rot + 90.0f32) * rad))
                let (fx, fy, fz) = (f64(y_cos * x_cos), f64(x_sin), f64(y_sin * x_cos))
                let (ux, uy, uz) = (f64(y_cos * x_cos_up), f64(x_sin_up), f64(y_sin * x_cos_up))
                // `forwards.cross(up).scale(-1.0)`.
                let lx = (fy * uz - fz * uy) * -1.0
                let ly = (fz * ux - fx * uz) * -1.0
                let lz = (fx * uy - fy * ux) * -1.0
                return (x + (fx * forwards + ux * up + lx * left), y + (fy * forwards + uy * up + ly * left), z + (fz * forwards + uz * up + lz * left))
            },
        }
    }

    /// `getRotation` for a source that looks at the pitch `x_rot` and the yaw `y_rot`, as a
    /// pitch and a yaw (CAL-165): a rotation's, written yaw first, each from the source's where
    /// it's relative, as floats; local ones none, `Vec2.ZERO`.
    pub fn turn(self, x_rot: f32, y_rot: f32) -> (f32, f32) {
        match self {
            Coordinates.World(cx, cy, _) => return (f32.nearest(cx.get(f64(x_rot))), f32.nearest(cy.get(f64(y_rot)))),
            Coordinates.Local(_, _, _) => return (0.0f32, 0.0f32),
        }
    }

    /// `isXRelative`, `isYRelative` and `isZRelative`: each world one's, and all of local ones.
    pub fn relative(self) -> (bool, bool, bool) {
        match self {
            Coordinates.World(cx, cy, cz) => return (cx.relative, cy.relative, cz.relative),
            Coordinates.Local(_, _, _) => return (true, true, true),
        }
    }
}

/// `Vec3Argument.parse` (CAL-165): local coordinates where the text starts with `^`, else world
/// ones, `WorldCoordinates.parseDouble`, a whole x and z centred on their block where `center`.
pub fn vec3(r: mut Reader, center: bool) -> Coordinates ! SyntaxError {
    if r.can_read() and r.peek() == '^' {
        return try local(mut r)
    }
    let start = r.at
    let x = try world_double(mut r, center)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let y = try world_double(mut r, false)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let z = try world_double(mut r, center)
    return Coordinates.World(x, y, z)
}

/// `RotationArgument.parse` (CAL-165): a yaw, then a pitch, kept as vanilla keeps them, the pitch
/// as x, the yaw as y, and z relative.
pub fn rotation(r: mut Reader) -> Coordinates ! SyntaxError {
    let start = r.at
    if not r.can_read() {
        fail r.error_here("argument.rotation.incomplete", [])
    }
    let y = try world_double(mut r, false)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.rotation.incomplete", [])
    }
    r.skip()
    let x = try world_double(mut r, false)
    return Coordinates.World(x, y, Coordinate { relative: true, value: 0.0 })
}

// `WorldCoordinate.parseDouble`: `~` and an offset, none being none, or a number, one written
// without a `.` centred on its block where `center`.
fn world_double(r: mut Reader, center: bool) -> Coordinate ! SyntaxError {
    if r.can_read() and r.peek() == '^' {
        fail r.error_here("argument.pos.mixed", [])
    }
    if not r.can_read() {
        fail r.error_here("argument.pos.missing.double", [])
    }
    let relative = r.peek() == '~'
    if relative {
        r.skip()
    }
    let start = r.at
    var value = 0.0
    if r.can_read() and r.peek() != ' ' {
        value = try r.read_double()
    }
    if relative and r.at == start {
        return Coordinate { relative: true, value: 0.0 }
    }
    var whole = true
    for i in start..r.at {
        if r.units[i] == '.' {
            whole = false
        }
    }
    if whole and not relative and center {
        value += 0.5
    }
    return Coordinate { relative: relative, value: value }
}

/// `BlockPosArgument.parse`: local coordinates where the text starts with `^`, else world ones
/// of whole numbers, each relative one a `double`.
pub fn block_pos(r: mut Reader) -> Coordinates ! SyntaxError {
    if r.can_read() and r.peek() == '^' {
        return try local(mut r)
    }
    let start = r.at
    let x = try world_int(mut r)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let y = try world_int(mut r)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let z = try world_int(mut r)
    return Coordinates.World(x, y, z)
}

// `WorldCoordinate.parseInt`.
fn world_int(r: mut Reader) -> Coordinate ! SyntaxError {
    if r.can_read() and r.peek() == '^' {
        fail r.error_here("argument.pos.mixed", [])
    }
    if not r.can_read() {
        fail r.error_here("argument.pos.missing.int", [])
    }
    let relative = r.peek() == '~'
    if relative {
        r.skip()
    }
    var value = 0.0
    if r.can_read() and r.peek() != ' ' {
        value = if relative { try r.read_double() } else { f64(try r.read_int()) }
    }
    return Coordinate { relative: relative, value: value }
}

// `LocalCoordinates.parse`.
fn local(r: mut Reader) -> Coordinates ! SyntaxError {
    let start = r.at
    let left = try local_double(mut r, start)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let up = try local_double(mut r, start)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let forwards = try local_double(mut r, start)
    return Coordinates.Local(left, up, forwards)
}

// `LocalCoordinates.readDouble`: `^`, then an offset if one's there.
fn local_double(r: mut Reader, start: usize) -> f64 ! SyntaxError {
    if not r.can_read() {
        fail r.error_here("argument.pos.missing.double", [])
    }
    if r.peek() != '^' {
        r.at = start
        fail r.error_here("argument.pos.mixed", [])
    }
    r.skip()
    if r.can_read() and r.peek() != ' ' {
        return try r.read_double()
    }
    return 0.0
}
