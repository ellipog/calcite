/// Positions as commands write them, read as vanilla's `BlockPosArgument` reads them: three
/// world coordinates, each a number or `~` and an offset from where the command runs, or three
/// local ones, each `^` and an offset along where it faces (D368).
module command.coordinates

import command.reader.{Reader}
import nbt.snbt.{SyntaxError}

/// One world coordinate, vanilla's `WorldCoordinate`: a value, or an offset where it's
/// relative.
pub struct Coordinate {
    pub relative: bool
    pub value: f64
}

/// A position as written, vanilla's `Coordinates`.
pub enum Coordinates {
    /// `WorldCoordinates`: x, y and z.
    World(Coordinate, Coordinate, Coordinate)
    /// `LocalCoordinates`: left, up and forwards.
    Local(f64, f64, f64)
}

/// `BlockPosArgument.parse`: local coordinates where the text starts with `^`, else world ones
/// of whole numbers, each relative one a `double`.
pub fn block_pos(r: mut Reader) -> Coordinates ! SyntaxError {
    if r.can_read() and r.peek() == '^' {
        return try local(mut r)
    }
    let start = r.at
    let x = try world_int(mut r)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let y = try world_int(mut r)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let z = try world_int(mut r)
    return Coordinates.World(x, y, z)
}

// `WorldCoordinate.parseInt`.
fn world_int(r: mut Reader) -> Coordinate ! SyntaxError {
    if r.can_read() and r.peek() == '^' {
        fail r.error_here("argument.pos.mixed", [])
    }
    if not r.can_read() {
        fail r.error_here("argument.pos.missing.int", [])
    }
    let relative = r.peek() == '~'
    if relative {
        r.skip()
    }
    var value = 0.0
    if r.can_read() and r.peek() != ' ' {
        value = if relative { try r.read_double() } else { f64(try r.read_int()) }
    }
    return Coordinate { relative: relative, value: value }
}

// `LocalCoordinates.parse`.
fn local(r: mut Reader) -> Coordinates ! SyntaxError {
    let start = r.at
    let left = try local_double(mut r, start)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let up = try local_double(mut r, start)
    if not r.can_read() or r.peek() != ' ' {
        r.at = start
        fail r.error_here("argument.pos3d.incomplete", [])
    }
    r.skip()
    let forwards = try local_double(mut r, start)
    return Coordinates.Local(left, up, forwards)
}

// `LocalCoordinates.readDouble`: `^`, then an offset if one's there.
fn local_double(r: mut Reader, start: usize) -> f64 ! SyntaxError {
    if not r.can_read() {
        fail r.error_here("argument.pos.missing.double", [])
    }
    if r.peek() != '^' {
        r.at = start
        fail r.error_here("argument.pos.mixed", [])
    }
    r.skip()
    if r.can_read() and r.peek() != ' ' {
        return try r.read_double()
    }
    return 0.0
}
