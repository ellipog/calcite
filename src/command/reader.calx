/// Brigadier's `StringReader`, as vanilla's argument parsers read a command's text with it: a
/// place in the text, in UTF-16 units, and its numbers, strings, booleans and identifiers, read
/// as Java and brigadier read them, with vanilla's errors where they don't read (D368, D371).
module command.reader

import chat.component.{Component}
import chat.language.{Language}
import java.character.{is_whitespace}
import java.number.{parse_int}
import nbt.snbt.{SyntaxError, from_units, units_of}
import resources.identifier.{Identifier}

/// Text, and where in it reading has got to.
pub struct Reader {
    pub units: List<char>
    pub text: String
    pub at: usize
}

impl Reader {
    /// A reader at the start of `text`.
    pub fn new(text: String) -> Reader {
        return Reader { units: units_of(text), text: text.copy(), at: 0 }
    }

    /// Whether there's a unit left to read.
    pub fn can_read(self) -> bool {
        return self.at < self.units.len()
    }

    /// The unit at the reader's place, which must be there.
    pub fn peek(self) -> char {
        return self.units[self.at]
    }

    /// The unit `n` past the reader's place, `none` past the end: `peek(n)` where `canRead(n + 1)`.
    pub fn peek_at(self, n: usize) -> char? {
        if self.at + n < self.units.len() {
            return some(self.units[self.at + n])
        }
        return none
    }

    /// Goes past the unit at the reader's place.
    pub fn skip(mut self) {
        self.at += 1
    }

    /// `skipWhitespace`: past the units Java's `Character.isWhitespace` takes.
    pub fn skip_whitespace(mut self) {
        while self.can_read() and is_whitespace(self.peek()) {
            self.at += 1
        }
    }

    /// `expect`: past `c`, which must be next, else `parsing.expected` here.
    pub fn expect(mut self, c: char) ! SyntaxError {
        if not self.can_read() or self.peek() != c {
            fail self.error_here("parsing.expected", [Component.literal(from_units([c], 0, 1))])
        }
        self.at += 1
    }

    /// `readUnquotedString`: the letters, digits and `_-.+` from here.
    pub fn read_unquoted(mut self) -> String {
        let start = self.at
        while self.can_read() and is_unquoted_unit(self.peek()) {
            self.at += 1
        }
        return from_units(self.units, start, self.at)
    }

    /// `readString`: a string in double or single quotes, as `read_until` reads it, or an
    /// unquoted one, or nothing at the end.
    pub fn read_string(mut self) -> String ! SyntaxError {
        if not self.can_read() {
            return String()
        }
        let quote = self.peek()
        if quote != '"' and quote != '\'' {
            return self.read_unquoted()
        }
        self.at += 1
        return try self.read_until(quote)
    }

    /// `readStringUntil`: the units to `end`, which the reader goes past, with `\` before an
    /// `end` or a `\` in them. Another unit after a `\` is `parsing.quote.escape` at it, and no
    /// `end` is `parsing.quote.expected.end` at the end.
    pub fn read_until(mut self, end: char) -> String ! SyntaxError {
        var out = List<char>()
        var escaped = false
        while self.can_read() {
            let c = self.peek()
            self.at += 1
            if escaped {
                if c == end or c == '\\' {
                    out.push(c)
                    escaped = false
                } else {
                    self.at -= 1
                    fail self.error_here("parsing.quote.escape", [Component.literal(from_units(self.units, self.at, self.at + 1))])
                }
            } else if c == '\\' {
                escaped = true
            } else if c == end {
                return from_units(out, 0, out.len())
            } else {
                out.push(c)
            }
        }
        fail self.error_here("parsing.quote.expected.end", [])
    }

    /// `readBoolean`: `true` or `false`, as `read_string` reads it. Nothing is
    /// `parsing.bool.expected` where the string ends, and anything else `parsing.bool.invalid`
    /// where it starts.
    pub fn read_boolean(mut self) -> bool ! SyntaxError {
        let start = self.at
        let value = try self.read_string()
        if value.is_empty() {
            fail self.error_here("parsing.bool.expected", [])
        }
        if value == "true" {
            return true
        }
        if value == "false" {
            return false
        }
        self.at = start
        fail self.error_here("parsing.bool.invalid", [Component.literal(value)])
    }

    /// `Identifier.read`: the units an identifier may have, from here, as an identifier, or
    /// `argument.id.invalid` at their start where they aren't one. Nothing is `minecraft:`.
    pub fn read_identifier(mut self) -> Identifier ! SyntaxError {
        let start = self.at
        while self.can_read() and is_identifier_unit(self.peek()) {
            self.at += 1
        }
        match Identifier.parse(from_units(self.units, start, self.at)) {
            ok(id) => return id,
            err(_) => {
                self.at = start
                fail self.error_here("argument.id.invalid", [])
            },
        }
    }

    /// A syntax error at the reader's place, as `createWithContext` makes one: the translation
    /// of `key` with `args`.
    pub fn error_here(self, key: String, args: own List<Component>) -> SyntaxError {
        return SyntaxError { message: Component.translatable(key, args), input: self.text.copy(), cursor: self.at }
    }

    /// `readInt`: the digits, `.`s and `-`s from here, as `Integer.parseInt` reads them.
    pub fn read_int(mut self) -> i32 ! SyntaxError {
        let start = self.at
        let number = self.number()
        if number.is_empty() {
            fail self.error_here("parsing.int.expected", List<Component>())
        }
        match parse_int(number, 10) {
            ok(value) => return value,
            err(_) => {
                self.at = start
                fail self.error_here("parsing.int.invalid", [Component.literal(number)])
            },
        }
    }

    /// `readDouble`: the digits, `.`s and `-`s from here, as `Double.parseDouble` reads them.
    pub fn read_double(mut self) -> f64 ! SyntaxError {
        let start = self.at
        let number = self.number()
        if number.is_empty() {
            fail self.error_here("parsing.double.expected", List<Component>())
        }
        let value = java_double(number) else {
            self.at = start
            fail self.error_here("parsing.double.invalid", [Component.literal(number)])
        }
        return value
    }

    // The units from here that `isAllowedNumber` allows.
    fn number(mut self) -> String {
        let start = self.at
        while self.can_read() and is_number_unit(self.peek()) {
            self.at += 1
        }
        return from_units(self.units, start, self.at)
    }

    /// What `CompilableString.CommandParserHelper` says where a parser read only part of the
    /// text: `command.trailing_data` in `lang` with what was read and, in brackets, what wasn't.
    pub fn trailing_data(self, lang: Language) -> String {
        let shown = "{from_units(self.units, 0, self.at)}[{from_units(self.units, self.at, self.units.len())}]"
        return Component.translatable("command.trailing_data", [Component.literal(shown)]).get_string(lang)
    }
}

/// `StringReader.isAllowedNumber`: a digit, `.` or `-`.
pub fn is_number_unit(c: char) -> bool {
    return (c >= '0' and c <= '9') or c == '.' or c == '-'
}

/// `StringReader.isAllowedInUnquotedString`: an ASCII letter or digit, `_`, `-`, `.` or `+`.
pub fn is_unquoted_unit(c: char) -> bool {
    return (c >= '0' and c <= '9') or (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or c == '_' or c == '-' or c == '.' or c == '+'
}

/// `Identifier.isAllowedInIdentifier`: `[0-9a-z_:/.-]`.
pub fn is_identifier_unit(c: char) -> bool {
    return (c >= '0' and c <= '9') or (c >= 'a' and c <= 'z') or c == '_' or c == ':' or c == '/' or c == '.' or c == '-'
}

/// Digits, `.`s and `-`s as `Double.parseDouble` reads them, or `none` where it throws.
pub fn java_double(text: String) -> f64? {
    let full = java_decimal(text) else return none
    return f64.parse(full)
}

/// Digits, `.`s and `-`s as `Float.parseFloat` reads them, or `none` where it throws.
pub fn java_float(text: String) -> f32? {
    let full = java_decimal(text) else return none
    return f32.parse(full)
}

// Digits, `.`s and `-`s as Java reads a decimal: a `-` if it's first, then digits with at most
// one `.` among or around them, and at least one digit, written out in full, or `none`.
fn java_decimal(text: String) -> String? {
    var digits = 0
    var points = 0
    for i in 0..text.len() {
        let b = text.byte_at(i)
        if b == 45 {
            if i != 0 {
                return none
            }
        } else if b == 46 {
            points += 1
        } else {
            digits += 1
        }
    }
    if digits == 0 or points > 1 {
        return none
    }
    // Java reads `.5` and `5.`, which are written out in full here.
    var full = String()
    var i: usize = 0
    if text.starts_with("-") {
        full.push('-')
        i = 1
    }
    if text.byte_at(i) == 46 {
        full.push('0')
    }
    full.push_str(text[i..])
    if text.ends_with(".") {
        full.push('0')
    }
    return some(full)
}
