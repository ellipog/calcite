/// Brigadier's `StringReader`, as vanilla's argument parsers read a command's text with it: a
/// place in the text, in UTF-16 units, and its numbers, read as Java parses them, with
/// vanilla's errors where they don't read (D368).
module command.reader

import chat.component.{Component}
import chat.language.{Language}
import java.number.{parse_int}
import nbt.snbt.{SyntaxError, from_units, units_of}

/// Text, and where in it reading has got to.
pub struct Reader {
    pub units: List<char>
    pub text: String
    pub at: usize
}

impl Reader {
    /// A reader at the start of `text`.
    pub fn new(text: String) -> Reader {
        return Reader { units: units_of(text), text: text.copy(), at: 0 }
    }

    /// Whether there's a unit left to read.
    pub fn can_read(self) -> bool {
        return self.at < self.units.len()
    }

    /// The unit at the reader's place, which must be there.
    pub fn peek(self) -> char {
        return self.units[self.at]
    }

    /// Goes past the unit at the reader's place.
    pub fn skip(mut self) {
        self.at += 1
    }

    /// A syntax error at the reader's place, as `createWithContext` makes one: the translation
    /// of `key` with `args`.
    pub fn error_here(self, key: String, args: own List<Component>) -> SyntaxError {
        return SyntaxError { message: Component.translatable(key, args), input: self.text.copy(), cursor: self.at }
    }

    /// `readInt`: the digits, `.`s and `-`s from here, as `Integer.parseInt` reads them.
    pub fn read_int(mut self) -> i32 ! SyntaxError {
        let start = self.at
        let number = self.number()
        if number.is_empty() {
            fail self.error_here("parsing.int.expected", List<Component>())
        }
        match parse_int(number, 10) {
            ok(value) => return value,
            err(_) => {
                self.at = start
                fail self.error_here("parsing.int.invalid", [Component.literal(number)])
            },
        }
    }

    /// `readDouble`: the digits, `.`s and `-`s from here, as `Double.parseDouble` reads them.
    pub fn read_double(mut self) -> f64 ! SyntaxError {
        let start = self.at
        let number = self.number()
        if number.is_empty() {
            fail self.error_here("parsing.double.expected", List<Component>())
        }
        let value = java_decimal(number) else {
            self.at = start
            fail self.error_here("parsing.double.invalid", [Component.literal(number)])
        }
        return value
    }

    // The units from here that `isAllowedNumber` allows.
    fn number(mut self) -> String {
        let start = self.at
        while self.can_read() and is_number_unit(self.peek()) {
            self.at += 1
        }
        return from_units(self.units, start, self.at)
    }

    /// What `CompilableString.CommandParserHelper` says where a parser read only part of the
    /// text: `command.trailing_data` in `lang` with what was read and, in brackets, what wasn't.
    pub fn trailing_data(self, lang: Language) -> String {
        let shown = "{from_units(self.units, 0, self.at)}[{from_units(self.units, self.at, self.units.len())}]"
        return Component.translatable("command.trailing_data", [Component.literal(shown)]).get_string(lang)
    }
}

/// `StringReader.isAllowedNumber`: a digit, `.` or `-`.
pub fn is_number_unit(c: char) -> bool {
    return (c >= '0' and c <= '9') or c == '.' or c == '-'
}

// Digits, `.`s and `-`s as `Double.parseDouble` reads them: a `-` if it's first, then digits
// with at most one `.` among or around them, and at least one digit.
fn java_decimal(text: String) -> f64? {
    var digits = 0
    var points = 0
    for i in 0..text.len() {
        let b = text.byte_at(i)
        if b == 45 {
            if i != 0 {
                return none
            }
        } else if b == 46 {
            points += 1
        } else {
            digits += 1
        }
    }
    if digits == 0 or points > 1 {
        return none
    }
    // Java reads `.5` and `5.`, which are written out in full here.
    var full = String()
    var i: usize = 0
    if text.starts_with("-") {
        full.push('-')
        i = 1
    }
    if text.byte_at(i) == 46 {
        full.push('0')
    }
    full.push_str(text[i..])
    if text.ends_with(".") {
        full.push('0')
    }
    return f64.parse(full)
}
