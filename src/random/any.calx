/// A legacy or a xoroshiro source, whichever a world's settings pick, as vanilla's worldgen holds
/// a `RandomSource` without knowing which. Noises are made from these; nothing samples them in a
/// hot loop, so each call matching on the kind costs nothing that matters.
module random.any

import random.legacy.{LegacyPositional, LegacyRandom}
import random.source.{RandomSource}
import random.xoroshiro.{XoroshiroPositional, XoroshiroRandom}

/// A source of either kind.
pub enum AnyRandom {
    Legacy(LegacyRandom)
    Xoroshiro(XoroshiroRandom)
}

/// A factory of either kind, as `PositionalRandomFactory`.
pub enum AnyPositional {
    Legacy(LegacyPositional)
    Xoroshiro(XoroshiroPositional)
}

impl AnyRandom {
    /// A source as `WorldgenRandom.Algorithm.newInstance` makes one: legacy if `legacy`, and
    /// xoroshiro if not.
    pub fn of(legacy: bool, seed: i64) -> AnyRandom {
        if legacy {
            return AnyRandom.Legacy(LegacyRandom.new(seed))
        }
        return AnyRandom.Xoroshiro(XoroshiroRandom.new(seed))
    }

    pub fn fork(mut self) -> AnyRandom {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let f = s.fork()
                self = AnyRandom.Legacy(s)
                return AnyRandom.Legacy(f)
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let f = s.fork()
                self = AnyRandom.Xoroshiro(s)
                return AnyRandom.Xoroshiro(f)
            },
        }
    }

    pub fn fork_positional(mut self) -> AnyPositional {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let f = s.fork_positional()
                self = AnyRandom.Legacy(s)
                return AnyPositional.Legacy(f)
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let f = s.fork_positional()
                self = AnyRandom.Xoroshiro(s)
                return AnyPositional.Xoroshiro(f)
            },
        }
    }
}

impl AnyPositional {
    pub fn at(self, x: i32, y: i32, z: i32) -> AnyRandom {
        return match self {
            AnyPositional.Legacy(f) => AnyRandom.Legacy(f.at(x, y, z)),
            AnyPositional.Xoroshiro(f) => AnyRandom.Xoroshiro(f.at(x, y, z)),
        }
    }

    pub fn from_hash_of(self, name: String) -> AnyRandom {
        return match self {
            AnyPositional.Legacy(f) => AnyRandom.Legacy(f.from_hash_of(name)),
            AnyPositional.Xoroshiro(f) => AnyRandom.Xoroshiro(f.from_hash_of(name)),
        }
    }

    pub fn from_seed(self, seed: i64) -> AnyRandom {
        return match self {
            AnyPositional.Legacy(_) => AnyRandom.Legacy(LegacyPositional.from_seed(seed)),
            AnyPositional.Xoroshiro(f) => AnyRandom.Xoroshiro(f.from_seed(seed)),
        }
    }
}

impl RandomSource for AnyRandom {
    fn set_seed(mut self, seed: i64) {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                s.set_seed(seed)
                self = AnyRandom.Legacy(s)
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                s.set_seed(seed)
                self = AnyRandom.Xoroshiro(s)
            },
        }
    }

    fn next_int(mut self) -> i32 {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let v = s.next_int()
                self = AnyRandom.Legacy(s)
                return v
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let v = s.next_int()
                self = AnyRandom.Xoroshiro(s)
                return v
            },
        }
    }

    fn next_int_below(mut self, bound: i32) -> i32 {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let v = s.next_int_below(bound)
                self = AnyRandom.Legacy(s)
                return v
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let v = s.next_int_below(bound)
                self = AnyRandom.Xoroshiro(s)
                return v
            },
        }
    }

    fn next_long(mut self) -> i64 {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let v = s.next_long()
                self = AnyRandom.Legacy(s)
                return v
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let v = s.next_long()
                self = AnyRandom.Xoroshiro(s)
                return v
            },
        }
    }

    fn next_boolean(mut self) -> bool {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let v = s.next_boolean()
                self = AnyRandom.Legacy(s)
                return v
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let v = s.next_boolean()
                self = AnyRandom.Xoroshiro(s)
                return v
            },
        }
    }

    fn next_float(mut self) -> f32 {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let v = s.next_float()
                self = AnyRandom.Legacy(s)
                return v
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let v = s.next_float()
                self = AnyRandom.Xoroshiro(s)
                return v
            },
        }
    }

    fn next_double(mut self) -> f64 {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let v = s.next_double()
                self = AnyRandom.Legacy(s)
                return v
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let v = s.next_double()
                self = AnyRandom.Xoroshiro(s)
                return v
            },
        }
    }

    fn next_gaussian(mut self) -> f64 {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                let v = s.next_gaussian()
                self = AnyRandom.Legacy(s)
                return v
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                let v = s.next_gaussian()
                self = AnyRandom.Xoroshiro(s)
                return v
            },
        }
    }

    fn consume(mut self, count: i32) {
        match self {
            AnyRandom.Legacy(r) => {
                var s = r
                s.consume(count)
                self = AnyRandom.Legacy(s)
            },
            AnyRandom.Xoroshiro(r) => {
                var s = r
                s.consume(count)
                self = AnyRandom.Xoroshiro(s)
            },
        }
    }
}
