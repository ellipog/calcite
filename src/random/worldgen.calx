/// Vanilla's `WorldgenRandom`, which worldgen seeds per chunk and per feature.
module random.worldgen

import random.source.{Bits, RandomSource, bits_double, bits_float, bits_int_below, bits_long, polar}

/// A worldgen source over a legacy or xoroshiro one, as vanilla's `WorldgenRandom`. Every
/// number comes from the inner source's `next(bits)`, through `BitRandomSource`'s formulas,
/// even with a xoroshiro source inside.
pub struct WorldgenRandom<T> {
    /// The inner source. Vanilla's `fork` and `forkPositional` are the inner source's.
    pub source: T
    // Vanilla's `setSeed` skips this cache, so seeding never clears it.
    gaussian: f64 = 0.0
    has_gaussian: bool = false
}

impl<T: RandomSource + Bits> WorldgenRandom<T> {
    pub fn new(source: own T) -> WorldgenRandom<T> {
        return WorldgenRandom { source: source }
    }

    /// Seeds for decorating a chunk, and returns the seed it set.
    pub fn set_decoration_seed(mut self, seed: i64, chunk_x: i32, chunk_z: i32) -> i64 {
        self.set_seed(seed)
        let x_scale = self.next_long() | 1
        let z_scale = self.next_long() | 1
        let result = (i64(chunk_x) * x_scale + i64(chunk_z) * z_scale) ^ seed
        self.set_seed(result)
        return result
    }

    /// Seeds for one feature of a decoration step. `10000 * step` wraps as an `i32`, as in
    /// vanilla.
    pub fn set_feature_seed(mut self, seed: i64, index: i32, step: i32) {
        self.set_seed(seed + i64(index) + i64(10000 * step))
    }

    /// Seeds for a structure or carver start in a chunk.
    pub fn set_large_feature_seed(mut self, seed: i64, chunk_x: i32, chunk_z: i32) {
        self.set_seed(seed)
        let x_scale = self.next_long()
        let z_scale = self.next_long()
        self.set_seed((i64(chunk_x) * x_scale) ^ (i64(chunk_z) * z_scale) ^ seed)
    }

    pub fn set_large_feature_with_salt(mut self, seed: i64, x: i32, z: i32, salt: i32) {
        self.set_seed(i64(x) * 341873128712 + i64(z) * 132897987541 + seed + i64(salt))
    }
}

impl<T: RandomSource + Bits> Bits for WorldgenRandom<T> {
    fn next(mut self, bits: i32) -> i32 {
        return self.source.next(bits)
    }
}

impl<T: RandomSource + Bits> RandomSource for WorldgenRandom<T> {
    fn set_seed(mut self, seed: i64) {
        self.source.set_seed(seed)
    }

    fn next_int(mut self) -> i32 {
        return self.next(32)
    }

    fn next_int_below(mut self, bound: i32) -> i32 {
        return bits_int_below(mut self, bound)
    }

    fn next_long(mut self) -> i64 {
        return bits_long(mut self)
    }

    fn next_boolean(mut self) -> bool {
        return self.next(1) != 0
    }

    fn next_float(mut self) -> f32 {
        return bits_float(mut self)
    }

    fn next_double(mut self) -> f64 {
        return bits_double(mut self)
    }

    fn next_gaussian(mut self) -> f64 {
        if self.has_gaussian {
            self.has_gaussian = false
            return self.gaussian
        }
        let (first, second) = polar(mut self)
        self.gaussian = second
        self.has_gaussian = true
        return first
    }
}
