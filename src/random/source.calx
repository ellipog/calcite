/// What every random source does. Each source gives vanilla's sequence bit for bit, since
/// worldgen, loot and mob behavior all hang on it.
module random.source

import std.java.math.{log}

/// A random source, as vanilla's `RandomSource`. Methods that take a bound panic on a bound
/// vanilla rejects, where vanilla throws `IllegalArgumentException`.
pub interface RandomSource {
    /// Starts the sequence again from `seed`.
    fn set_seed(mut self, seed: i64)
    /// Any `i32`.
    fn next_int(mut self) -> i32
    /// A number from 0 up to, not including, `bound`, which must be positive.
    fn next_int_below(mut self, bound: i32) -> i32
    /// Any `i64`.
    fn next_long(mut self) -> i64
    fn next_boolean(mut self) -> bool
    /// A number in [0, 1), a multiple of 2^-24.
    fn next_float(mut self) -> f32
    /// A number in [0, 1), a multiple of 2^-53.
    fn next_double(mut self) -> f64
    /// A number from the normal distribution with mean 0 and deviation 1.
    fn next_gaussian(mut self) -> f64

    /// A number from `min` to `max`, both included. `max - min + 1` must be positive, wrapping
    /// as in Java.
    fn next_int_between(mut self, min: i32, max: i32) -> i32 {
        return self.next_int_below(max - min + 1) + min
    }

    /// A number from `origin` up to, not including, `bound`. `origin` must be below `bound`.
    fn next_int_range(mut self, origin: i32, bound: i32) -> i32 {
        if origin >= bound {
            panic("bound - origin is non positive")
        }
        return origin + self.next_int_below(bound - origin)
    }

    /// A number around `mean`, at most `spread` away, more likely near the middle.
    fn triangle(mut self, mean: f64, spread: f64) -> f64 {
        return mean + spread * (self.next_double() - self.next_double())
    }

    /// Skips `count` numbers, as `count` calls to `next_int`.
    fn consume(mut self, count: i32) {
        var i = 0
        while i < count {
            _ = self.next_int()
            i += 1
        }
    }
}

/// A source built on `next(bits)`, as vanilla's `BitRandomSource`. Its other numbers come from
/// the functions below.
pub interface Bits {
    /// The next number's top `bits` bits, 1 to 32, as an `i32`.
    fn next(mut self, bits: i32) -> i32
}

/// A number below `bound` from `next(31)`, as `BitRandomSource.nextInt(bound)`.
pub fn bits_int_below<T: Bits>(r: mut T, bound: i32) -> i32 {
    if bound <= 0 {
        panic("Bound must be positive")
    }
    if (bound & -bound) == bound {
        return i32.wrap((i64(bound) * i64(r.next(31))) >> 31)
    }
    // Draw again when the sample falls in the last, partial run of `bound` numbers.
    loop {
        let sample = r.next(31)
        let n = sample % bound
        if sample - n + (bound - 1) >= 0 {
            return n
        }
    }
}

/// Two `next(32)`s, high then low.
pub fn bits_long<T: Bits>(r: mut T) -> i64 {
    let high = i64(r.next(32)) << 32
    return high + i64(r.next(32))
}

pub fn bits_float<T: Bits>(r: mut T) -> f32 {
    return f32.nearest(r.next(24)) * 5.9604645e-8f32
}

pub fn bits_double<T: Bits>(r: mut T) -> f64 {
    let high = i64(r.next(26)) << 27
    return f64.nearest(high + i64(r.next(27))) * 1.1102230246251565e-16
}

/// Marsaglia's polar method, as vanilla's `MarsagliaPolarGaussian`: two numbers from the normal
/// distribution. A source gives the first, then the second at its next call.
pub fn polar<T: RandomSource>(r: mut T) -> (f64, f64) {
    loop {
        let x = 2.0 * r.next_double() - 1.0
        let y = 2.0 * r.next_double() - 1.0
        let s = x * x + y * y
        if s < 1.0 and s != 0.0 {
            let m = (-2.0 * log(s) / s).sqrt()
            return (x * m, y * m)
        }
    }
}

/// A seed from a block position, as vanilla's `Mth.getSeed`. `x * 3129871` wraps as an `i32`,
/// as in vanilla.
pub fn position_seed(x: i32, y: i32, z: i32) -> i64 {
    var seed = i64(x * 3129871) ^ (i64(z) * 116129781) ^ i64(y)
    seed = seed * seed * 42317861 + seed * 11
    return seed >> 16
}
