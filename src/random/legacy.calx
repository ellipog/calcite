/// Java's `java.util.Random` generator, which vanilla's `LegacyRandomSource` and
/// `SingleThreadedRandomSource` both are: a 48-bit linear congruential generator.
module random.legacy

import java.text.{string_hash}
import random.source.{Bits, RandomSource, bits_double, bits_float, bits_int_below, bits_long, polar, position_seed}

const MULTIPLIER: i64 = 0x5DEECE66D
const INCREMENT: i64 = 11
const MASK: i64 = 0xFFFFFFFFFFFF

/// Vanilla's `LegacyRandomSource`, and its `SingleThreadedRandomSource`, which gives the same
/// numbers. It's a `Copy` value of 24 bytes.
pub struct LegacyRandom {
    seed: i64
    gaussian: f64 = 0.0
    has_gaussian: bool = false
}

impl LegacyRandom {
    pub fn new(seed: i64) -> LegacyRandom {
        return LegacyRandom { seed: scramble(seed) }
    }

    /// A new source seeded from this one's next long, as vanilla's `fork`.
    pub fn fork(mut self) -> LegacyRandom {
        return LegacyRandom.new(self.next_long())
    }

    /// A factory for sources at positions and names, seeded from this one's next long.
    pub fn fork_positional(mut self) -> LegacyPositional {
        return LegacyPositional { seed: self.next_long() }
    }
}

fn scramble(seed: i64) -> i64 {
    return (seed ^ MULTIPLIER) & MASK
}

impl Bits for LegacyRandom {
    fn next(mut self, bits: i32) -> i32 {
        self.seed = (self.seed * MULTIPLIER + INCREMENT) & MASK
        return i32.wrap(self.seed >> (48 - bits))
    }
}

impl RandomSource for LegacyRandom {
    fn set_seed(mut self, seed: i64) {
        self.seed = scramble(seed)
        self.has_gaussian = false
    }

    fn next_int(mut self) -> i32 {
        return self.next(32)
    }

    fn next_int_below(mut self, bound: i32) -> i32 {
        return bits_int_below(mut self, bound)
    }

    fn next_long(mut self) -> i64 {
        return bits_long(mut self)
    }

    fn next_boolean(mut self) -> bool {
        return self.next(1) != 0
    }

    fn next_float(mut self) -> f32 {
        return bits_float(mut self)
    }

    fn next_double(mut self) -> f64 {
        return bits_double(mut self)
    }

    fn next_gaussian(mut self) -> f64 {
        if self.has_gaussian {
            self.has_gaussian = false
            return self.gaussian
        }
        let (first, second) = polar(mut self)
        self.gaussian = second
        self.has_gaussian = true
        return first
    }
}

/// Vanilla's `LegacyPositionalRandomFactory`: legacy sources for positions and names.
pub struct LegacyPositional {
    seed: i64
}

impl LegacyPositional {
    pub fn new(seed: i64) -> LegacyPositional {
        return LegacyPositional { seed: seed }
    }

    pub fn at(self, x: i32, y: i32, z: i32) -> LegacyRandom {
        return LegacyRandom.new(position_seed(x, y, z) ^ self.seed)
    }

    /// From the name's Java `hashCode`.
    pub fn from_hash_of(self, name: String) -> LegacyRandom {
        return LegacyRandom.new(i64(string_hash(name)) ^ self.seed)
    }

    /// A source seeded with `seed` alone: vanilla's legacy factory ignores its own seed here,
    /// so this needs no factory.
    pub fn from_seed(seed: i64) -> LegacyRandom {
        return LegacyRandom.new(seed)
    }
}
