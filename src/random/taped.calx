/// A level's random, vanilla's `Level.random`, which can write each value it draws to the RNG
/// tape (P6.1, D312), as the rig's agent writes vanilla's (D311).
module random.taped

import random.legacy.{LegacyRandom}
import random.source.{Bits, RandomSource, bits_double, bits_float, bits_int_below, bits_long, polar}

/// A `LegacyRandom`, `LegacyRandomSource`, whose every value comes through its own `next`, so
/// each can be written down. While it's taping, each `next` adds a line to `lines`: the level's
/// name, the game time it's set to, the bits drawn and the value, as the agent's tape has them,
/// without where it was drawn.
///
/// ```text
/// minecraft:overworld 0 31 1530525153
/// ```
pub struct TapedRandom {
    random: LegacyRandom
    gaussian: f64 = 0.0
    has_gaussian: bool = false
    on: bool = false
    name: String = String()
    /// The game time the lines it writes are at, which the level sets as its tick moves it on.
    pub time: i64 = 0
    lines: String = String()
}

impl TapedRandom {
    pub fn new(seed: i64) -> TapedRandom {
        return TapedRandom { random: LegacyRandom.new(seed) }
    }

    /// From now on, each value it draws is a line on the tape, starting with `name`.
    pub fn tape(mut self, name: own String) {
        self.on = true
        self.name = name
    }

    /// Whether it's taping.
    pub fn taping(self) -> bool {
        return self.on
    }

    /// The tape's lines since this was last asked.
    pub fn take_lines(mut self) -> String {
        let out = self.lines.copy()
        self.lines.clear()
        return out
    }
}

impl Bits for TapedRandom {
    fn next(mut self, bits: i32) -> i32 {
        let value = self.random.next(bits)
        if self.on {
            let line = "{self.name} {self.time} {bits} {value}\n"
            self.lines.push_str(line)
        }
        return value
    }
}

/// Each number as `LegacyRandom`'s, from this one's own `next`.
impl RandomSource for TapedRandom {
    fn set_seed(mut self, seed: i64) {
        self.random.set_seed(seed)
        self.has_gaussian = false
    }

    fn next_int(mut self) -> i32 {
        return self.next(32)
    }

    fn next_int_below(mut self, bound: i32) -> i32 {
        return bits_int_below(mut self, bound)
    }

    fn next_long(mut self) -> i64 {
        return bits_long(mut self)
    }

    fn next_boolean(mut self) -> bool {
        return self.next(1) != 0
    }

    fn next_float(mut self) -> f32 {
        return bits_float(mut self)
    }

    fn next_double(mut self) -> f64 {
        return bits_double(mut self)
    }

    fn next_gaussian(mut self) -> f64 {
        if self.has_gaussian {
            self.has_gaussian = false
            return self.gaussian
        }
        let (first, second) = polar(mut self)
        self.gaussian = second
        self.has_gaussian = true
        return first
    }
}
