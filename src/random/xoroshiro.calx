/// Vanilla's `XoroshiroRandomSource`, on the xoroshiro128++ generator. Modern worldgen uses it.
module random.xoroshiro

import hash.md5.{md5_text}
import random.source.{Bits, RandomSource, polar, position_seed}

/// 2^64 over the golden ratio, and over the silver ratio, as odd numbers.
const GOLDEN: i64 = -7046029254386353131
const SILVER: i64 = 7640891576956012809

/// Vanilla's `XoroshiroRandomSource`. It's a `Copy` value of 32 bytes.
pub struct XoroshiroRandom {
    lo: i64
    hi: i64
    gaussian: f64 = 0.0
    has_gaussian: bool = false
}

impl XoroshiroRandom {
    /// A source from a 64-bit seed, spread over 128 bits as vanilla's `upgradeSeedTo128bit`.
    pub fn new(seed: i64) -> XoroshiroRandom {
        let lo = seed ^ SILVER
        return XoroshiroRandom.of(mix(lo), mix(lo + GOLDEN))
    }

    /// A source with exactly this state, except that all zeros, which would give only zeros,
    /// becomes the golden and silver ratios.
    pub fn of(lo: i64, hi: i64) -> XoroshiroRandom {
        if (lo | hi) == 0 {
            return XoroshiroRandom { lo: GOLDEN, hi: SILVER }
        }
        return XoroshiroRandom { lo: lo, hi: hi }
    }

    /// The generator's next 64 bits.
    pub fn next_raw(mut self) -> i64 {
        let s0 = self.lo
        var s1 = self.hi
        let result = (s0 + s1).rotate_left(17) + s0
        s1 ^= s0
        self.lo = s0.rotate_left(49) ^ s1 ^ (s1 << 21)
        self.hi = s1.rotate_left(28)
        return result
    }

    pub fn fork(mut self) -> XoroshiroRandom {
        let lo = self.next_raw()
        return XoroshiroRandom.of(lo, self.next_raw())
    }

    pub fn fork_positional(mut self) -> XoroshiroPositional {
        let lo = self.next_raw()
        return XoroshiroPositional { lo: lo, hi: self.next_raw() }
    }
}

/// Stafford's variant 13 of the SplitMix64 finalizer, as vanilla's `mixStafford13`.
fn mix(seed: i64) -> i64 {
    var z = seed
    z = (z ^ (z >>> 30)) * -4658895280553007687
    z = (z ^ (z >>> 27)) * -7723592293110705685
    return z ^ (z >>> 31)
}

/// Bits from the top of `next_raw`, as vanilla's `WorldgenRandom` draws them from a xoroshiro
/// source. Xoroshiro's own methods don't use it.
impl Bits for XoroshiroRandom {
    fn next(mut self, bits: i32) -> i32 {
        return i32.wrap(self.next_raw() >>> (64 - bits))
    }
}

impl RandomSource for XoroshiroRandom {
    fn set_seed(mut self, seed: i64) {
        self = XoroshiroRandom.new(seed)
    }

    fn next_int(mut self) -> i32 {
        return i32.wrap(self.next_raw())
    }

    /// Lemire's method: the high half of a 32-bit sample times `bound`, drawing again while the
    /// low half lands in the biased part.
    fn next_int_below(mut self, bound: i32) -> i32 {
        if bound <= 0 {
            panic("Bound must be positive")
        }
        let range = i64(bound)
        var product = i64(u32.wrap(self.next_int())) * range
        var low = product & 0xFFFFFFFF
        if low < range {
            let start = i64(u32.wrap(-bound) % u32.wrap(bound))
            while low < start {
                product = i64(u32.wrap(self.next_int())) * range
                low = product & 0xFFFFFFFF
            }
        }
        return i32.wrap(product >> 32)
    }

    fn next_long(mut self) -> i64 {
        return self.next_raw()
    }

    fn next_boolean(mut self) -> bool {
        return (self.next_raw() & 1) != 0
    }

    fn next_float(mut self) -> f32 {
        return f32.nearest(self.next_raw() >>> 40) * 5.9604645e-8f32
    }

    fn next_double(mut self) -> f64 {
        return f64.nearest(self.next_raw() >>> 11) * 1.1102230246251565e-16
    }

    fn next_gaussian(mut self) -> f64 {
        if self.has_gaussian {
            self.has_gaussian = false
            return self.gaussian
        }
        let (first, second) = polar(mut self)
        self.gaussian = second
        self.has_gaussian = true
        return first
    }

    fn consume(mut self, count: i32) {
        var i = 0
        while i < count {
            _ = self.next_raw()
            i += 1
        }
    }
}

/// Vanilla's `XoroshiroPositionalRandomFactory`: xoroshiro sources for positions and names.
pub struct XoroshiroPositional {
    lo: i64
    hi: i64
}

impl XoroshiroPositional {
    pub fn new(lo: i64, hi: i64) -> XoroshiroPositional {
        return XoroshiroPositional { lo: lo, hi: hi }
    }

    pub fn at(self, x: i32, y: i32, z: i32) -> XoroshiroRandom {
        return XoroshiroRandom.of(position_seed(x, y, z) ^ self.lo, self.hi)
    }

    /// From the MD5 of the name's UTF-8, its first 8 bytes and last 8 read big-endian.
    pub fn from_hash_of(self, name: String) -> XoroshiroRandom {
        let digest = md5_text(name)
        var lo: i64 = 0
        var hi: i64 = 0
        let n: usize = 8
        for i in 0..n {
            lo = (lo << 8) | i64(digest[i])
            hi = (hi << 8) | i64(digest[i + 8])
        }
        return XoroshiroRandom.of(lo ^ self.lo, hi ^ self.hi)
    }

    pub fn from_seed(self, seed: i64) -> XoroshiroRandom {
        return XoroshiroRandom.of(seed ^ self.lo, seed ^ self.hi)
    }
}
