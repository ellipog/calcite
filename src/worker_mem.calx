/// Scratch, for CAL-88's memory work: how much a generator `Worker` and its copies take, read
/// from /proc/self/statm on Linux. Not a test.
///
///     calx run --release src/worker_mem.calx -- COPIES
module worker_mem

import pack.vanilla.{vanilla_data}
import rig.registries.{load_vanilla}
import server.log.{Entry}
import server.play.{block_states}
import std.env.{args}
import std.fs.{read_text}
import std.memory.{trim}
import std.time.{Instant}
import worldgen.generator.{GenSetup, Worker}

// The resident set, in MB.
fn resident() -> f64 {
    let text = match read_text(String("/proc/self/statm")) {
        ok(some(s)) => s,
        _ => String("0 0"),
    }
    // The second number: pages resident.
    var pages: i64 = 0
    var field = 0
    for i in 0..text.len() {
        let c = text.byte_at(i)
        if c == 32 {
            field += 1
        } else if field == 1 {
            pages = pages * 10 + i64(c - 48)
        }
    }
    return f64.nearest(pages) * 4096.0 / 1048576.0
}

fn main() ! String {
    let a = args()
    var copies: i64 = 0
    for i in 0..a[0].len() {
        copies = copies * 10 + i64(a[0].byte_at(i) - 48)
    }
    let r0 = resident()
    let loaded = try load_vanilla()
    var lines = List<Entry>()
    let zip = try vanilla_data(String("build/fly/cache/vanilla-26.3.data"), mut lines)
    let b = loaded.registries.find_builtin(String("block")) else fail String("no block registry")
    let f = loaded.registries.find_builtin(String("fluid")) else fail String("no fluid registry")
    let bi = loaded.registries.find(String("worldgen/biome")) else fail String("no biome registry")
    let table = try block_states(loaded.registries)
    let uncarvable = loaded.registries.builtin[b].tag_values(String("uncarvable"))
    let setup = GenSetup { settings: String("minecraft:overworld"), blocks: loaded.registries.builtin[b].copy(), fluids: loaded.registries.builtin[f].copy(), biomes: loaded.registries.synced[bi].copy(), table: table, uncarvable: uncarvable, seed: 20261101 }
    trim()
    let r1 = resident()
    println("registries and data: {r1 - r0} MB")
    let w = try Worker.new(zip.copy(), setup)
    trim()
    let r2 = resident()
    println("one worker made: {r2 - r1} MB")
    var held = List<Worker>()
    let copy_start = unsafe { Instant.now() }
    for _ in 0..copies {
        held.push(w.copy())
    }
    let copy_ms = unsafe { Instant.now() }.secs_since(copy_start) * 1000.0 / f64.nearest(copies)
    println("a copy takes {copy_ms} ms")
    trim()
    let r3 = resident()
    println("{copies} copies: {r3 - r2} MB, {(r3 - r2) / f64.nearest(copies)} MB each")
}
