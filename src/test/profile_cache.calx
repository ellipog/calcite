/// Checks `fetchprofile`'s cache of profiles (CAL-374), as vanilla's `ProfileResolver.Cached`
/// keeps them: what's found by name and by UUID, none where there was none, kept till ten minutes
/// after it was last asked for, `expireAfterAccess`, and at most 256 of each, the one longest
/// unasked going first.
module test.profile_cache

import auth.profile.{GameProfile}
import server.profile_cache.{ProfileCache}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// What the cache gives for the name `name` at `now`: missed, nobody or the profile's name.
fn named(c: mut ProfileCache, name: str, now: i64) -> String {
    let (hit, p) = c.named(String(name), now)
    if not hit {
        return String("missed")
    }
    return match p {
        some(found) => found.name.copy(),
        none => String("nobody"),
    }
}

fn main() {
    var c = ProfileCache()
    let steve = GameProfile.offline(String("Steve"))
    check(named(mut c, "Steve", 0), "missed")
    c.keep_named(String("Steve"), some(steve.copy()), 0)
    c.keep_id(steve.id, some(steve.copy()), 0)
    c.keep_named(String("Nobody"), none, 0)
    check(named(mut c, "Steve", 1000), "Steve")
    check(named(mut c, "Nobody", 1000), "nobody")
    // Names are kept as they're written.
    check(named(mut c, "steve", 1000), "missed")
    let (by_id, _) = c.by_id(steve.id, 1000)
    check("{by_id}", "true")

    // Kept ten minutes after it was last asked for: asked at 1,000, so still there at 600,999,
    // and asked again then, so still there at 1,200,000; gone ten minutes on from that.
    check(named(mut c, "Steve", 600999), "Steve")
    check(named(mut c, "Steve", 1200000), "Steve")
    check(named(mut c, "Steve", 1800000), "missed")
    // The UUID, last asked at 1,000, went long before.
    let (later, _) = c.by_id(steve.id, 1800000)
    check("{later}", "false")

    // At most 256 names: the 257th puts out the one longest unasked.
    var full = ProfileCache()
    for i in 0..256 {
        full.keep_named("p{i}", none, i64(i))
    }
    check(named(mut full, "p0", 300), "nobody")
    full.keep_named(String("late"), none, 400)
    check("{full.names.len()}", "256")
    check(named(mut full, "p1", 500), "missed")
    check(named(mut full, "p0", 500), "nobody")
    check(named(mut full, "late", 500), "nobody")
    println("ok")
}
