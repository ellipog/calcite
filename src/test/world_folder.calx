/// Checks `storage.world` on a folder of its own: the lock, `level.dat` saved and read back, the
/// old one kept, a corrupt one replaced from `level.dat_old` and kept, and the lines vanilla
/// logs on the way. The rig's `world_folder` probe checks the same against vanilla.
module test.world_folder

import nbt.tag.{Accounter, Tag}
import server.log.{Entry}
import std.fs.{list, read, remove_dir_all, temp_dir, write}
import std.time.{DateTime}
import storage.world.{WorldFolder, exists, join, read_compressed, safe_replace}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn data(name: String) -> Tag {
    var tags = JavaHashMap<String, Tag>()
    tags.insert(String("LevelName"), Tag.Str(name.copy()))
    return Tag.Compound(tags)
}

fn name_of(found: JavaHashMap<String, Tag>?) -> String {
    let tags = found else return String("none")
    if not tags.contains("LevelName") {
        return String("no name")
    }
    return tags["LevelName"].to_snbt()
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn opened(universe: String) -> WorldFolder {
    return match WorldFolder.open(universe, String("world")) {
        ok(w) => w,
        err(e) => panic("the world didn't open: {e}"),
    }
}

fn main() {
    let universe = temp_dir()!
    let now = DateTime { year: 2026, month: 10, day: 30, hour: 9, minute: 5, second: 7, milli: 0 }
    let world = opened(universe)
    check(world.path, join(universe, String("world")), "the folder")

    // A second server on it is refused.
    let prefix = "net.minecraft.util.DirectoryLock$LockException: "
    let suffix = "session.lock: already locked (possibly by other Minecraft instance?)"
    match WorldFolder.open(universe, String("world")) {
        ok(_) => panic("opened twice"),
        err(e) => check("{e.starts_with(prefix)} {e.ends_with(suffix)}", "true true", "the lock's exception"),
    }

    // Saved, then read back, then saved again with the first kept.
    var lines = List<Entry>()
    check("{world.has_level()}", "false", "a new world")
    world.save_level(data("first"), mut lines)
    let first = world.load_level(now, mut lines)
    check("{world.has_level()} {name_of(first)}", "true \"first\"", "level.dat")
    world.save_level(data("second"), mut lines)
    check(name_of(world.load_level(now, mut lines)), "\"second\"", "level.dat again")
    var accounter = Accounter.unlimited()
    let old = read_compressed(world.resource(String("level.dat_old")), mut accounter)!
    let old_data = match old["Data"] {
        Tag.Compound(tags) => some(tags.copy()),
        _ => none,
    }
    check(name_of(old_data), "\"first\"", "level.dat_old")
    check(shown(lines), "", "nothing logged")

    // A corrupt level.dat: level.dat_old is read and moved over it, and it's kept.
    let current = world.resource(String("level.dat"))
    let fallback = world.resource(String("level.dat_old"))
    write(current, [1, 2, 3])!
    check(name_of(world.load_level(now, mut lines)), "\"first\"", "the fallback")
    check(shown(lines), "[Failed to load world data from {current}][Attempting to use fallback {fallback}]", "the fallback's lines")
    let corrupted = world.resource(String("level.dat_corrupted_2026-10-30_09-05-07"))
    let kept = read(corrupted)!
    check("{exists(fallback)} {exists(corrupted)} {kept.len()}", "false true 3", "the files after")
    check(name_of(world.load_level(now, mut lines)), "\"first\"", "level.dat restored")

    // Neither can be read: the server stops.
    lines = List<Entry>()
    write(current, [31, 139])!
    check(name_of(world.load_level(now, mut lines)), "none", "nothing to read")
    check(shown(lines), "[Failed to load world data from {current}][Attempting to use fallback {fallback}]", "the lines when nothing can be read")

    // A move that can't be done is tried 10 times and given up, then so is putting the backup
    // back.
    lines = List<Entry>()
    let missing = world.resource(String("missing"))
    let target = world.resource(String("target"))
    let moved = safe_replace(target, missing, fallback, false, mut lines)
    check("{moved} {lines.len()}", "false 62", "a move that fails")
    check("[{lines[0].message}][{lines[1].message}]", "[Failed to rename][Failed to execute rename {missing} to {target}]", "a failed try")
    check(lines[29].message, "Failed to replace {target} with {missing}, retrying 9/10", "the last retry")
    check(lines[30].message, "Failed to replace {target} with {missing}, aborting, progress might be lost", "giving up")
    check(lines[61].message, "Failed to restore {target} from {fallback}, aborting, progress might be lost", "giving up the backup")

    // Once it's closed, it opens again. On Windows the lock stops even this program's reads
    // of the file while it's held.
    world.close(mut lines)
    let lock = read(join(universe, String("world/session.lock")))!
    check("{lock.len()} {lock[0]} {lock[1]} {lock[2]}", "3 226 152 131", "the snowman")
    let again = opened(universe)
    again.close(mut lines)
    let files = list(join(universe, String("world")))!
    check("{files.len()}", "3", "the files")
    remove_dir_all(universe)!
    print("ok")
}
