/// Checks java.date against Java 25: `Date.toString` with the default zone Europe/Oslo, as
/// build/scratch/store/zones.sh ran it, and the zone names Java gave there in other zones.
module test.date

import java.date.{to_string, zone_name}
import std.time.{Timestamp}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn main() {
    check(to_string(Timestamp { unix_ms: 1793267283000 }, 3600, String("CET")), "Thu Oct 29 10:48:03 CET 2026")
    check(to_string(Timestamp { unix_ms: 1784894400000 }, 7200, String("CEST")), "Fri Jul 24 14:00:00 CEST 2026")
    check(to_string(Timestamp { unix_ms: 1769947200000 }, 3600, String("CET")), "Sun Feb 01 13:00:00 CET 2026")
    check(to_string(Timestamp { unix_ms: -1000 }, 0, String("GMT")), "Wed Dec 31 23:59:59 GMT 1969")
    // The local day, not UTC's: 23:30 UTC is the next day an hour ahead.
    check(to_string(Timestamp { unix_ms: 1793230200000 }, 3600, String("CET")), "Thu Oct 29 00:30:00 CET 2026")

    // tzdata's names in letters are Java's, and its numbers, or none, are an offset from GMT.
    check(zone_name(some(String("CET")), 3600), "CET")
    check(zone_name(some(String("AEDT")), 39600), "AEDT")
    check(zone_name(some(String("+03")), 10800), "GMT+03:00")
    check(zone_name(some(String("+0330")), 12600), "GMT+03:30")
    check(zone_name(some(String("-03")), -10800), "GMT-03:00")
    check(zone_name(none, 3600), "GMT+01:00")
    check(zone_name(none, -16200), "GMT-04:30")
    check(zone_name(none, 0), "GMT")
    println("ok")
}
