/// Tests of `world.effects` (CAL-163): the effects in the `mob_effect` registry's order; which
/// ticks they act on, halved each level, the amplifier's shift by its low five bits; a stronger,
/// shorter effect hiding the one it takes over, which comes back once it runs out, and a weaker,
/// longer one hidden behind; an effect saved as `MobEffectInstance.CODEC` saves it, its defaults
/// left out but its icon, and read back with what it hides; and a particle's colour, faint where
/// it's ambient. Then a living entity's: health boost's modifier on and off as it ends, its health
/// kept to its most; absorption's start and its end once its absorption's gone; regeneration's
/// heal; and its values, its particles, ambience and invisibility, as they're to be sent, and its
/// effects saved with it and loaded back.
module test.effects

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.body.{EntitySound}
import world.chunk.{BlockStates}
import world.effects.{ABSORPTION, ActiveEffect, Details, INVISIBILITY, REGENERATION, RESISTANCE, contents_effects, effect_facts, effect_id, effect_names, potion_effects}
import world.entity_data.{EFFECT_PARTICLES, INVISIBLE_FLAG, SHARED_FLAGS, armor_stand_data}
import world.damage.{Damage}
import world.living.{Living, LivingFacts, Ward}
import worldgen.facts.{Facts}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

// The entity type `name`'s ID.
fn kind_of(name: str) -> u32 {
    let kinds = builtin_entries(6)
    for i in 0..kinds.len() {
        if kinds[i] == String(name) {
            return u32.wrap(i)
        }
    }
    panic("no entity type {name}")
}

// An effect's chain, each its amplifier and duration, what it hides after.
fn chain(e: ActiveEffect) -> String {
    var out = "{e.now.amplifier}/{e.now.duration}"
    for h in e.hidden {
        out.push_str(" {h.amplifier}/{h.duration}")
    }
    return out
}

fn registry_order() {
    let all = effect_facts()
    let names = builtin_entries(3)
    check("{all.len()}", "{names.len()}", "an effect for each in the registry")
    for i in 0..all.len() {
        check(all[i].name.copy(), names[i].copy(), "effect {i}'s name")
    }
    check("{effect_id(String("minecraft:regeneration")) ?? -1} {effect_id(String("poison")) ?? -1} {effect_id(String("minecraft:nothing")) ?? -1}", "9 18 -1", "effects by name")
    println("registry: 40 effects, in order")
}

fn ticks() {
    let all = effect_facts()
    let regeneration = all[usize.wrap(REGENERATION)].copy()
    check("{regeneration.should_tick(50, 0)} {regeneration.should_tick(49, 0)} {regeneration.should_tick(25, 1)} {regeneration.should_tick(7, 6)}", "true false true true", "regeneration every 50, halved each level, every tick past")
    check("{regeneration.should_tick(49, 32)} {regeneration.should_tick(50, 32)}", "false true", "an amplifier of 32 shifts as one of 0")
    let poison = all[18].copy()
    check("{poison.should_tick(25, 0)} {poison.should_tick(24, 0)}", "true false", "poison every 25")
    let instant = all[5].copy()
    check("{instant.should_tick(1, 0)} {instant.should_tick(0, 0)} {instant.instantaneous()}", "true false true", "instant health on each tick it lasts")
    let speed = all[0].copy()
    check("{speed.should_tick(40, 0)}", "false", "speed never acts")
    println("ticks: regeneration's, poison's and instant health's")
}

fn hiding() {
    var e = ActiveEffect.new(REGENERATION, 100, 0)
    check("{e.update(Details { duration: 50, amplifier: 1 })}", "true", "a stronger effect takes over")
    check(chain(e), "1/50 0/100", "the weaker hidden")
    check("{e.update(Details { duration: 300, amplifier: 0 })}", "false", "a weaker, longer one changes nothing shown")
    check(chain(e), "1/50 0/300", "the longer one taking over the hidden")
    check("{e.update(Details { duration: 20, amplifier: 2 })}", "true", "a stronger, shorter one")
    check(chain(e), "2/20 1/50 0/300", "each hidden as it was")
    check("{e.update(Details { duration: 400, amplifier: 3 })}", "true", "the strongest, longest")
    check(chain(e), "3/400 1/50 0/300", "what was shown dropped, being shorter")
    var f = ActiveEffect.new(REGENERATION, 3, 1)
    _ = f.update(Details { duration: 10, amplifier: 0 })
    check(chain(f), "1/3 0/10", "a weaker, longer one hidden")
    var downgraded = 0
    for _ in 0..3 {
        if f.tick_down() {
            downgraded += 1
        }
    }
    check("{chain(f)} {downgraded} {f.remaining()}", "0/7 1 true", "the hidden back as the stronger runs out")
    var forever = ActiveEffect.new(REGENERATION, -1, 0)
    _ = forever.tick_down()
    check("{forever.duration()} {forever.remaining()}", "-1 true", "for ever stays")
    check("{ActiveEffect.new(REGENERATION, 5, 300).amplifier()} {ActiveEffect.new(REGENERATION, 5, -2).amplifier()}", "255 0", "an amplifier from 0 to 255")
    println("hiding: stronger over weaker, and back")
}

fn saving() {
    let names = effect_names()
    var e = ActiveEffect.new(REGENERATION, 100, 0)
    _ = e.update(Details { duration: 50, amplifier: 1 })
    let saved = e.saved(names)
    let want = snbt("\{id:\"minecraft:regeneration\",amplifier:1b,duration:50,show_icon:1b,hidden_effect:\{duration:100,show_icon:1b\}\}")
    check(saved.to_snbt(), want.to_snbt(), "an effect saved, its defaults left out but its icon")
    let back = ActiveEffect.read(saved) ?? panic("an effect saved doesn't read")
    check(chain(back), "1/50 0/100", "read back with what it hides")
    let hidden = snbt("\{id:\"minecraft:poison\",amplifier:-56b,show_particles:0b,ambient:1b\}")
    let p = ActiveEffect.read(hidden) ?? panic("poison doesn't read")
    check("{p.id} {p.now.amplifier} {p.now.duration} {p.now.visible} {p.now.show_icon} {p.now.ambient}", "18 200 0 false false true", "an unsigned amplifier, its icon as its particles")
    let nothing = snbt("\{id:\"minecraft:nothing\"\}")
    check("{ActiveEffect.read(nothing) == none}", "true", "no such effect")
    println("saving: as the codec has it")
}

// Potions' effects, as `Potions` registers them, and a stack's, scaled (D511).
fn potions() {
    var turtle = String()
    for e in potion_effects(String("minecraft:turtle_master")) {
        turtle.push_str("{e.id}:{e.now.amplifier}/{e.now.duration} ")
    }
    check(turtle, "1:3/400 10:2/400 ", "the turtle master's slowness and resistance")
    check("{potion_effects(String("water")).len()} {potion_effects(String("minecraft:nothing")).len()}", "0 0", "water's none")
    let custom = snbt("\{potion:\"minecraft:poison\",custom_effects:[\{id:\"minecraft:luck\",duration:-1\}]\}")
    var both = String()
    for e in contents_effects(custom, 0.25f32) {
        both.push_str("{e.id}/{e.now.duration} ")
    }
    check(both, "18/225 25/-1 ", "a potion's then its own, a quarter as long, for ever as long")
    var healing = String()
    for e in contents_effects(Tag.Str(String("minecraft:strong_healing")), 0.25f32) {
        healing.push_str("{e.id}:{e.now.amplifier}/{e.now.duration}")
    }
    check(healing, "5:1/1", "at least a tick")
    println("potions: their effects, scaled")
}

fn particles() {
    let all = effect_facts()
    let (kind, color) = all[usize.wrap(REGENERATION)].particle_of(false)
    let (_, faint) = all[usize.wrap(REGENERATION)].particle_of(true)
    let names = builtin_entries(9)
    check("{names[usize.wrap(kind)]} {color ?? 0} {faint ?? 0}", "entity_effect {i32.wrap(4278190080u32 | 13458603u32)} {i32.wrap(637534208u32 | 13458603u32)}", "regeneration's colour, faint where it's ambient")
    let (trial, none_color) = all[33].particle_of(false)
    check("{names[usize.wrap(trial)]} {none_color == none}", "trial_omen true", "the trial omen's own particle")
    println("particles: entity_effect in its colour")
}

fn living(lf: LivingFacts) {
    let villager = kind_of("villager")
    var l = Living.made(lf, villager, 9, 163i64, 0.5, 64.0, 0.5, 0.6f32, 1.95f32, 1.74f32, armor_stand_data())
    var sounds = List<EntitySound>()
    check("{l.max_health(lf)}", "20.0", "a villager's most health")
    // Health boost: 4 more most health a level, off as it ends, its health kept to its most.
    _ = l.add_effect(lf, ActiveEffect.new(20, 2, 1), mut sounds)
    check("{l.max_health(lf)}", "28.0", "health boost's modifier on")
    l.set_health(lf, 28.0f32)
    for _ in 0..2 {
        let (kept, _, _) = l.effect_act(lf, 0, false)
        _ = l.effect_end(lf, 0, kept)
    }
    check("{l.max_health(lf)} {l.health()} {l.effects.len()}", "20.0 20.0 0", "health boost off, its health kept to its most")
    // Absorption: 8 at its second level, and its end once that's gone.
    _ = l.add_effect(lf, ActiveEffect.new(ABSORPTION, 100, 1), mut sounds)
    check("{l.absorption}", "8.0", "absorption's start")
    l.absorption = 0.0f32
    let (kept, _, _) = l.effect_act(lf, 0, false)
    check("{kept} {l.effect_end(lf, 0, kept)} {l.effects.len()}", "false false 0", "absorption's end once its absorption's gone")
    // Regeneration: 1 every 50 ticks of its duration below its most.
    l.set_health(lf, 10.0f32)
    _ = l.add_effect(lf, ActiveEffect.new(REGENERATION, 101, 0), mut sounds)
    for _ in 0..101 {
        let (k, _, _) = l.effect_act(lf, 0, false)
        _ = l.effect_end(lf, 0, k)
    }
    check("{l.health()} {l.effects.len()}", "12.0 0", "regeneration's heal at 100 and 50")
    // Its values: the particles of those shown, ambient where all are, invisible.
    _ = l.add_effect(lf, ActiveEffect.new(INVISIBILITY, 100, 0), mut sounds)
    l.update_dirty_effects(lf)
    let packed = l.data.pack_dirty() ?? panic("nothing to send")
    check("{(i32(l.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG) != 0} {packed.len() > 0} {l.effects_dirty}", "true true false", "invisible, with its particles to send")
    _ = l.data.pack_dirty()
    l.effects_dirty = true
    l.update_dirty_effects(lf)
    check("{l.data.is_dirty()}", "true", "coloured particles are never equal, so sent again")
    // Saved with it and loaded back.
    var t = JavaHashMap<String, Tag>()
    l.save_into(mut t, "minecraft:villager")
    check("{t.contains("active_effects")}", "true", "its effects saved")
    var back = Living.made(lf, villager, 10, 164i64, 0.5, 64.0, 0.5, 0.6f32, 1.95f32, 1.74f32, armor_stand_data())
    var lines = List<Entry>()
    check("{back.load_from(lf, t, mut lines)} {back.effects.len()} {back.has_effect(INVISIBILITY)} {back.effects_dirty}", "true 1 true true", "its effects loaded back, to be shown")
    _ = EFFECT_PARTICLES
    println("living: modifiers, absorption, regeneration, values and saving")
}

// Effects a type can't have, `canBeAffected` (D512): a zombie neither regeneration nor poison,
// healed by harming; a spider not poison; a slime not oozing; a cow any.
fn unaffected(lf: LivingFacts) {
    var sounds = List<EntitySound>()
    var zombie = Living.made(lf, kind_of("zombie"), 14, 168i64, 0.5, 64.0, 0.5, 0.6f32, 1.95f32, 1.74f32, armor_stand_data())
    let regenerated = zombie.add_effect(lf, ActiveEffect.new(REGENERATION, 100, 0), mut sounds)
    let poisoned = zombie.add_effect(lf, ActiveEffect.new(18, 100, 0), mut sounds)
    let weakened = zombie.add_effect(lf, ActiveEffect.new(17, 100, 0), mut sounds)
    check("{regenerated} {poisoned} {weakened} {zombie.effects.len()} {zombie.inverted(lf)}", "false false true 1 true", "a zombie's effects")
    var spider = Living.made(lf, kind_of("spider"), 15, 169i64, 0.5, 64.0, 0.5, 1.4f32, 0.9f32, 0.65f32, armor_stand_data())
    check("{spider.add_effect(lf, ActiveEffect.new(18, 100, 0), mut sounds)} {spider.add_effect(lf, ActiveEffect.new(REGENERATION, 100, 0), mut sounds)} {spider.inverted(lf)}", "false true false", "a spider's effects")
    let slime = Living.made(lf, kind_of("slime"), 16, 170i64, 0.5, 64.0, 0.5, 0.52f32, 0.52f32, 0.325f32, armor_stand_data())
    let cow = Living.made(lf, kind_of("cow"), 17, 171i64, 0.5, 64.0, 0.5, 0.9f32, 1.4f32, 1.3f32, armor_stand_data())
    check("{slime.can_be_affected(lf, 37)} {slime.can_be_affected(lf, 18)} {cow.can_be_affected(lf, 18)} {cow.can_be_affected(lf, 37)}", "false true true true", "a slime's and a cow's")
    println("unaffected: by type, as vanilla's tags have it")
}

// Resistance: a fifth less for each level, of what doesn't bypass it, `getDamageAfterMagicAbsorb`
// (D510); none at the fifth.
fn resistance(lf: LivingFacts) {
    let zombie = kind_of("zombie")
    var sounds = List<EntitySound>()
    var l = Living.made(lf, zombie, 11, 165i64, 0.5, 64.0, 0.5, 0.6f32, 1.95f32, 1.74f32, armor_stand_data())
    _ = l.add_effect(lf, ActiveEffect.new(RESISTANCE, 1000, 1), mut sounds)
    _ = l.hurt_server(lf, lf.damage, Damage.of(lf.damage, "generic"), 10.0f32, 0i64, false, false, Ward())
    check("{l.health()}", "14.0", "two levels of resistance take 40% of a generic hurt")
    var m = Living.made(lf, zombie, 12, 166i64, 0.5, 64.0, 0.5, 0.6f32, 1.95f32, 1.74f32, armor_stand_data())
    _ = m.add_effect(lf, ActiveEffect.new(RESISTANCE, 1000, 1), mut sounds)
    _ = m.hurt_server(lf, lf.damage, Damage.of(lf.damage, "out_of_world"), 4.0f32, 0i64, false, false, Ward())
    check("{m.health()}", "16.0", "the void bypasses resistance")
    var n = Living.made(lf, zombie, 13, 167i64, 0.5, 64.0, 0.5, 0.6f32, 1.95f32, 1.74f32, armor_stand_data())
    _ = n.add_effect(lf, ActiveEffect.new(RESISTANCE, 1000, 4), mut sounds)
    _ = n.hurt_server(lf, lf.damage, Damage.of(lf.damage, "generic"), 10.0f32, 0i64, false, false, Ward())
    check("{n.health()}", "20.0", "five levels take all of it")
    println("resistance: a fifth a level, none of the void's")
}

fn main() {
    let f = facts()
    let lf = LivingFacts.new(f)
    registry_order()
    ticks()
    hiding()
    saving()
    potions()
    particles()
    living(lf)
    resistance(lf)
    unaffected(lf)
    println("ok")
}
