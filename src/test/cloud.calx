/// Checks `world.cloud` (D529): a lingering potion's cloud, 3 across, lasting 600 ticks past a wait
/// of 10, a 600th of 3 less a tick, a half less a use, its radius its default and its particle
/// never, its effects a quarter as long; its server tick, waiting till its wait's up, then a tick's
/// less, its pass every 5 ticks, gone below 0.5 and once it's lasted; its pass, each in reach that
/// it may dose dosed and made a victim, its radius a half less each, those beyond it left, a victim
/// not dosed again till its delay's up, and gone at once where a dose leaves it below 0.5; one
/// saved and read back the same; and an ender dragon's breath's, its own particle shown (D617).
module test.cloud

import nbt.tag.{Tag}
import server.log.{Entry}
import world.cloud.{Breather, EffectCloud}
import world.effects.{effect_id}
import world.entity_data.{CLOUD_PARTICLE, CLOUD_RADIUS}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn poison() -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("potion"), Tag.Str(String("minecraft:poison")))
    return Tag.Compound(m)
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    let Tag.Compound(m) = t else panic("not a compound")
    return m.copy()
}

// A living thing of the ID `id` at x, z, which the cloud may dose where `takes`.
fn near(id: i32, x: f64, z: f64, takes: bool) -> Breather {
    return Breather { id: id, x: x, z: z, player: false, takes: takes }
}

fn lingered() -> EffectCloud {
    return EffectCloud.lingered(9, 77, 0.5, 64.0, 0.5, some((1i64, 2i64)), some(poison()), some(0.25f32), none, none)
}

fn main() {
    var c = lingered()
    let shrink = -3.0f32 / 600.0f32
    check(c.radius() == 3.0f32 and c.body.width == 6.0f32, "3 across")
    check(c.duration == 600 and c.wait_time == 10 and c.radius_on_use == -0.5f32 and c.radius_per_tick == shrink, "600 ticks past 10, a 600th of 3 less a tick, a half less a use")
    check(c.data.is_default(CLOUD_RADIUS) and not c.data.is_default(CLOUD_PARTICLE), "its radius its default, its particle never")
    let effects = c.effects()
    check(effects.len() == 1 and effects[0].now.duration == 225, "poison a quarter of 900 ticks")

    // Waiting through its 9th tick, then its pass at its 10th, a tick's less.
    var t = 1
    while t < 10 {
        c.body.tick_count = t
        if c.server_tick() != none or not c.waiting() {
            panic("waiting at {t}")
        }
        t += 1
    }
    c.body.tick_count = 10
    let r = c.server_tick() ?? -1.0f32
    check(not c.waiting() and r == 3.0f32 + shrink and c.radius() == r, "its pass at its 10th, a tick's less")
    check(c.body.width == r * 2.0f32, "twice its radius across")

    // The first at its middle dosed, its radius a half less; the second beyond that left; the
    // third within it dosed; the fourth, which it may not dose, left.
    let first = c.dose(r, [near(1, 0.5, 0.5, true), near(2, 3.2, 0.5, true), near(3, 0.5, 2.4, true), near(4, 0.5, 0.5, false)])
    check(first.len() == 2 and first[0] == (1, false) and first[1] == (3, false), "the first and third dosed")
    let after = r - 0.5f32 - 0.5f32
    check(c.radius() == after, "a half less each")

    // A tick that's not its fifth, no pass; its 15th, the first still a victim.
    c.body.tick_count = 11
    check(c.server_tick() == none, "no pass at its 11th")
    c.body.tick_count = 15
    let r15 = c.server_tick() ?? -1.0f32
    check(r15 == after + shrink + shrink, "a tick's less each")
    check(c.dose(r15, [near(1, 0.5, 0.5, true)]).is_empty(), "not dosed again within its delay")

    // Its 30th, its delay up: dosed again, then two more leave it below 0.5, the last left.
    c.body.tick_count = 30
    let r30 = c.server_tick() ?? -1.0f32
    let again = c.dose(r30, [near(1, 0.5, 0.5, true), near(5, 0.5, 0.5, true), near(6, 0.5, 0.5, true), near(7, 0.5, 0.5, true)])
    check(c.body.removed, "gone below 0.5")
    check(again.len() == 3 and again[2] == (6, false), "those till it went dosed")

    // Gone once it's lasted 600 past its wait, and once a tick leaves it below 0.5.
    var old = lingered()
    old.body.tick_count = 609
    check(old.server_tick() == none and not old.body.removed, "not gone at 599 past its wait")
    old.body.tick_count = 610
    check(old.server_tick() == none and old.body.removed, "gone at 600 past its wait")
    var small = lingered()
    small.set_radius(0.504f32)
    small.body.tick_count = 12
    check(small.server_tick() == none and small.body.removed, "gone below 0.5")

    // Saved and read back the same: its age, its owner, its contents and its scale.
    var saved = lingered()
    saved.body.tick_count = 42
    saved.set_radius(2.25f32)
    let tag = saved.saved()
    let m = compound(tag.copy())
    check(m["id"] == Tag.Str(String("minecraft:area_effect_cloud")) and m["Age"] == Tag.Int(42) and m["Radius"] == Tag.Float(2.25f32), "its type, age and radius")
    check(m["potion_contents"] == poison() and m["potion_duration_scale"] == Tag.Float(0.25f32) and m.contains("Owner"), "its contents, scale and owner")
    check(m["Duration"] == Tag.Int(600) and m["WaitTime"] == Tag.Int(10) and m["RadiusOnUse"] == Tag.Float(-0.5f32), "its duration, wait and change a use")
    var lines = List<Entry>()
    let back = EffectCloud.loaded(10, 78, m, mut lines) else panic("not read back")
    check(back.saved() == tag, "saved back the same")
    check(back.radius() == 2.25f32 and back.body.width == 4.5f32 and back.body.tick_count == 42, "read back as it was")

    // An ender dragon's breath's cloud (D617): 5 across, lasting 200 past its default wait of
    // 20, the dragon's; its own particle a dragon's breath of power 1, which it shows; instant
    // damage, a quarter as long; saved and read back the same, its particle still shown.
    let b = EffectCloud.breathed(11, 79, 9.5, -59.0, 0.5, (3i64, 4i64))
    check(b.radius() == 5.0f32 and b.body.width == 10.0f32 and b.duration == 200 and b.wait_time == 20, "5 across, 200 past 20")
    check(b.owner == some((3i64, 4i64)), "the dragon's")
    check(not b.particle_missing() and not b.data.is_default(CLOUD_PARTICLE), "its own particle, shown")
    let (kind, power) = b.own_particle ?? (-1, 0.0f32)
    check(kind >= 0 and power == 1.0f32, "a dragon's breath of power 1")
    let breath = b.effects()
    let harm = effect_id(String("minecraft:instant_damage")) ?? -1
    check(breath.len() == 1 and breath[0].id == harm and b.duration_scale == 0.25f32, "instant damage, a quarter as long")
    let bt = b.saved()
    let bm = compound(bt.copy())
    let particle = compound(bm["custom_particle"].copy())
    check(particle["type"] == Tag.Str(String("minecraft:dragon_breath")) and particle["power"] == Tag.Float(1.0f32), "its particle saved")
    let bb = EffectCloud.loaded(12, 80, bm, mut lines) else panic("the breath's cloud not read back")
    check(bb.saved() == bt and not bb.particle_missing() and bb.own_particle == b.own_particle, "read back, its particle shown")
    println("ok")
}
