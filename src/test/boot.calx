/// Checks the boot cache, as server.boot writes and reads it: what goes in comes out, a cache
/// with another key is ignored, and one that's cut short or has bytes after its end is refused.
module test.boot

import chat.language.{Language}
import pack.resources.{KnownPack}
import registry.registries.{Registries}
import registry.registry.{Registry, Tag}
import resources.identifier.{Identifier}
import server.boot.{Boot, decode, encode}
import server.log.{Entry, Level}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn id(path: str) -> Identifier {
    return Identifier { namespace: "minecraft", path: String(path) }
}

fn sample() -> Boot {
    var language = Language.empty()
    language.add("gui.done", "Done")
    language.add("chat.type.text", "<%s> %s")
    language.add("empty", "")
    var biome = Registry.new(id("worldgen/biome"), true)
    biome.add(id("plains"), some(0))
    biome.add(Identifier { namespace: "example", path: "glade" }, some(1))
    biome.tags.push(Tag { name: id("is_overworld"), values: [0, 1] })
    var block = Registry.new(id("block"), false)
    block.add(id("air"), none)
    block.add(id("stone"), none)
    block.tags.push(Tag { name: id("mineable/pickaxe"), values: [1] })
    block.tags.push(Tag { name: id("empty"), values: [] })
    let packs: List<KnownPack?> = [some(KnownPack { namespace: "minecraft", id: "core", version: "26.3" }), none]
    let logs: List<Entry> = [Entry.warn("Missing translation key for rename: a"), Entry { level: Level.Error, message: "héllo", thread: some(String("Worker-Main-1")) }]
    return Boot { language: language, registries: Registries { synced: [biome], builtin: [block] }, packs: packs, logs: logs }
}

// Everything the boot holds, as text.
fn show(b: Boot) -> String {
    var out = "{b.language.len()} {b.language.get_or_default("gui.done", "?")} {b.language.get_or_default("chat.type.text", "?")} [{b.language.get_or_default("empty", "?")}]"
    for r in [b.registries.synced.copy(), b.registries.builtin.copy()] {
        out.push_str(" |")
        for reg in r {
            out.push_str(" {reg.name.to_string()} {reg.synced}")
            for k in 0..reg.entries.len() {
                out.push_str(" {reg.entries[k].to_string()}@{reg.packs[k]}={reg.id(reg.entries[k])}")
            }
            for t in reg.tags {
                out.push_str(" #{t.name.to_string()}{t.values}")
            }
        }
    }
    out.push_str(" |")
    for p in b.packs {
        match p {
            some(k) => out.push_str(" {k.namespace}:{k.id}:{k.version}"),
            none => out.push_str(" none"),
        }
    }
    for e in b.logs {
        let level = match e.level {
            Level.Info => "info",
            Level.Warn => "warn",
            Level.Error => "error",
        }
        out.push_str(" | {level} {e.message} {e.thread}")
    }
    return out
}

fn main() {
    let boot = sample()
    let bytes = encode(boot, String("build data"))
    let back = decode(bytes.copy(), String("build data"))!
    let want = "3 Done <%s> %s [] | minecraft:worldgen/biome true minecraft:plains@some(0)=some(0) example:glade@some(1)=some(1) #minecraft:is_overworld[0, 1] | minecraft:block false minecraft:air@none=some(0) minecraft:stone@none=some(1) #minecraft:mineable/pickaxe[1] #minecraft:empty[] | minecraft:core:26.3 none | warn Missing translation key for rename: a none | error héllo some(Worker-Main-1)"
    match back {
        some(b) => check(show(b), String(want)),
        none => panic("the cache's own key didn't match"),
    }
    // Another build's or another data's cache is ignored.
    check("{decode(bytes.copy(), String("build other"))! == none}", "true")
    // One cut short anywhere is refused, and so is one with a byte after its end.
    let cuts: List<usize> = [0, 5, bytes.len() / 2, bytes.len() - 1]
    for n in cuts {
        var cut = bytes.copy()
        cut.truncate(n)
        match decode(cut, String("build data")) {
            ok(_) => panic("a cache cut to {n} bytes read"),
            err(_) => {},
        }
    }
    var longer = bytes.copy()
    longer.push(0)
    match decode(longer, String("build data")) {
        ok(_) => panic("a cache with a byte after its end read"),
        err(e) => check(e.message, "1 bytes after the end"),
    }
    println("ok")
}
