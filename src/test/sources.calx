/// Checks the blocks that make a signal of their own in the server's level (CAL-128), on a flat
/// level whose chunks tick, with block facts made from the built-in block and fluid registries:
/// each source's signal, weak and strong, from its state; a button let go as its tick runs and a
/// lever taken away, each telling the block it's fixed to; pressure plates that stay pressed while
/// a player stands on them and are let go once nobody does; a tripwire line attached as its last
/// wire is laid, tripped as a wire is broken, and detached 10 ticks on; a target and a sculk
/// sensor set with power losing it as they're placed; a lightning rod and a lectern let go as they
/// tick; a detector rail let go, with the powered rail it joins; and a sculk sensor's cooldown.
module test.sources

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Heard, Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{AIR_STATE, BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL, UPDATE_CLIENTS}
import world.pos.{ChunkPos}
import worldgen.facts.{DOWN, EAST, Facts, NORTH, SIGNAL_ATTACHED, SIGNAL_CALIBRATED, SIGNAL_FACING, SIGNAL_FROM_BLOCK_ENTITY, SIGNAL_JUKEBOX, SIGNAL_PLATE, SIGNAL_POWER, SIGNAL_SCULK, SIGNAL_TRAPPED_CHEST, SIGNAL_UP, SOUTH, UP, WEST}
import worldgen.providers.{GenContext}
import worldgen.signals.{has_neighbour_signal}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// A flat level, its spawn's chunks full and given the facts, with a player's ticket at its
// middle, so its chunks tick, and nobody standing in it.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn block_of(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => b,
        err(_) => panic("no block {name}"),
    }
}

fn named(f: Facts, name: str) -> u32 {
    return f.default_state(block_of(f, name))
}

fn with(f: Facts, state: u32, prop: str, value: str) -> u32 {
    return match f.with_name(state, String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("no {prop} {value}"),
    }
}

// Runs `ticks` of the level's ticks: its block and fluid ticks, then its block events, then its
// block entities.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.handling = true
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
        level.run_block_events()
        level.handling = false
        level.tick_block_entities()
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn flag(f: Facts, level: Level, x: i32, y: i32, z: i32, prop: str) -> bool {
    return f.get_bool(level.spawn_state(x, y, z), String(prop))
}

fn number(f: Facts, level: Level, x: i32, y: i32, z: i32, prop: str) -> i32 {
    return f.get_int(level.spawn_state(x, y, z), String(prop)) ?? -1
}

fn powered_at(f: Facts, level: Level, x: i32, y: i32, z: i32) -> bool {
    return match has_neighbour_signal(f, level, x, y, z, true) {
        ok(b) => b,
        err(t) => panic("the signal at {x} {y} {z}: {t.message}"),
    }
}

// The sounds heard since they were last taken, each with its pitch and volume.
struct Sounds {
    names: List<String>
    pitches: List<f32>
    volumes: List<f32>
}

fn heard(level: mut Level) -> Sounds {
    var out = Sounds { names: List<String>(), pitches: List<f32>(), volumes: List<f32>() }
    for h in level.take_heard() {
        match h {
            Heard.Sound(s) => {
                out.names.push(s.sound.copy())
                out.pitches.push(s.pitch)
                out.volumes.push(s.volume)
            },
            _ => {},
        }
    }
    return out
}

// What the level reported isn't in Calcite yet, one line each.
fn quiet(level: mut Level, what: str) {
    quiet_but(mut level, what, "")
}

// As `quiet`, but for lines with `but` in them, where it isn't empty.
fn quiet_but(level: mut Level, what: str, but: str) {
    var out = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") and (but.is_empty() or not e.message.contains(but)) {
            out = "{out}{e.message}; "
        }
    }
    if not out.is_empty() {
        panic("{what} reported {out}")
    }
}

// Whether the state's weak signal is `weak` toward each side and its strong one `strong` toward
// `toward` and none elsewhere, -1 for none anywhere.
fn gives(f: Facts, state: u32, weak: u8, strong: u8, toward: i32) -> bool {
    for d in 0..6 {
        if f.weak_signal(state, d) != weak {
            return false
        }
        let s = if d == toward { strong } else { 0 }
        if f.strong_signal(state, d) != s {
            return false
        }
    }
    return true
}

// Each source's signal from its state, by the class whose `ownSignal` it runs.
fn signals() {
    let f = facts()
    check(f.signal_kind(block_of(f, "stone_button")) == SIGNAL_ATTACHED and f.signal_kind(block_of(f, "lever")) == SIGNAL_ATTACHED, "a button's or lever's kind")
    check(f.signal_kind(block_of(f, "oak_pressure_plate")) == SIGNAL_PLATE and f.signal_kind(block_of(f, "heavy_weighted_pressure_plate")) == SIGNAL_PLATE, "a plate's kind")
    check(f.signal_kind(block_of(f, "lightning_rod")) == SIGNAL_FACING and f.signal_kind(block_of(f, "tripwire_hook")) == SIGNAL_FACING, "a rod's or hook's kind")
    check(f.signal_kind(block_of(f, "detector_rail")) == SIGNAL_UP and f.signal_kind(block_of(f, "lectern")) == SIGNAL_UP, "a detector rail's or lectern's kind")
    check(f.signal_kind(block_of(f, "target")) == SIGNAL_POWER and f.signal_kind(block_of(f, "daylight_detector")) == SIGNAL_POWER, "a target's or daylight detector's kind")
    check(f.signal_kind(block_of(f, "sculk_sensor")) == SIGNAL_SCULK and f.signal_kind(block_of(f, "calibrated_sculk_sensor")) == SIGNAL_CALIBRATED, "a sculk sensor's kind")
    check(f.signal_kind(block_of(f, "trapped_chest")) == SIGNAL_TRAPPED_CHEST and f.signal_kind(block_of(f, "jukebox")) == SIGNAL_JUKEBOX, "a trapped chest's or jukebox's kind")
    let button = with(f, named(f, "stone_button"), "powered", "true")
    check(gives(f, with(f, button, "face", "floor"), 15, 15, UP), "a pressed button on the floor")
    check(gives(f, with(f, button, "face", "ceiling"), 15, 15, DOWN), "a pressed button on the ceiling")
    check(gives(f, with(f, with(f, button, "face", "wall"), "facing", "east"), 15, 15, EAST), "a pressed button on a wall")
    check(gives(f, with(f, named(f, "stone_button"), "face", "floor"), 0, 0, -1), "a button let go")
    check(gives(f, with(f, with(f, named(f, "lever"), "face", "ceiling"), "powered", "true"), 15, 15, DOWN), "a lever on")
    check(gives(f, with(f, named(f, "oak_pressure_plate"), "powered", "true"), 15, 15, UP), "a pressed plate")
    check(gives(f, with(f, named(f, "light_weighted_pressure_plate"), "power", "7"), 7, 7, UP), "a weighted plate")
    check(gives(f, with(f, with(f, named(f, "lightning_rod"), "facing", "north"), "powered", "true"), 15, 15, NORTH), "a struck rod")
    check(gives(f, with(f, with(f, named(f, "tripwire_hook"), "facing", "south"), "powered", "true"), 15, 15, SOUTH), "a tripped hook")
    check(gives(f, with(f, named(f, "detector_rail"), "powered", "true"), 15, 15, UP), "a pressed detector rail")
    check(gives(f, with(f, named(f, "lectern"), "powered", "true"), 15, 15, UP), "a lectern turning")
    check(gives(f, with(f, named(f, "target"), "power", "5"), 5, 0, -1), "a target hit")
    check(gives(f, with(f, named(f, "daylight_detector"), "power", "3"), 3, 0, -1), "a daylight detector")
    check(gives(f, with(f, named(f, "sculk_sensor"), "power", "6"), 6, 6, UP), "a sculk sensor")
    // A trapped chest's signal is as many as have it open, which its block entity's openers count
    // (CAL-144): weak to every side and strong up.
    let trapped = named(f, "trapped_chest")
    check(f.weak_signal(trapped, NORTH) == SIGNAL_FROM_BLOCK_ENTITY and f.strong_signal(trapped, UP) == SIGNAL_FROM_BLOCK_ENTITY and f.strong_signal(trapped, NORTH) == 0, "a trapped chest's signal")
    let calibrated = with(f, with(f, named(f, "calibrated_sculk_sensor"), "facing", "west"), "power", "6")
    check(f.weak_signal(calibrated, WEST) == 0 and f.weak_signal(calibrated, EAST) == 6 and f.weak_signal(calibrated, UP) == 6, "a calibrated sensor's weak signal")
    check(f.strong_signal(calibrated, UP) == 6 and f.strong_signal(calibrated, EAST) == 0, "a calibrated sensor's strong signal")
    check(f.weak_signal(named(f, "jukebox"), NORTH) == SIGNAL_FROM_BLOCK_ENTITY and f.strong_signal(named(f, "jukebox"), UP) == 0, "a jukebox's signal")
    check(f.button_ticks(block_of(f, "stone_button")) == 20 and f.button_ticks(block_of(f, "oak_button")) == 30, "the buttons' times")
    check(f.plate_weight(block_of(f, "light_weighted_pressure_plate")) == 15 and f.plate_weight(block_of(f, "heavy_weighted_pressure_plate")) == 150, "the plates' weights")
    // A jukebox with no block entity plays nothing.
    var level = flat_level(f)
    set(mut level, 20, -60, 20, named(f, "jukebox"), "the jukebox wasn't set")
    check(not powered_at(f, level, 21, -60, 20), "an empty jukebox gives a signal")
    println("ok signals")
}

// A pressed stone button on the grass lights the lamp beside it and powers the grass under it
// strongly; as its tick runs it's let go, with its sound, telling the lamp, which goes out 4
// ticks on. A lever on a wall, taken away while on, tells the blocks around the block it was on.
fn button_and_lever() {
    let f = facts()
    var level = flat_level(f)
    let lamp = named(f, "redstone_lamp")
    set(mut level, 5, -60, 4, lamp, "the lamp wasn't set")
    let pressed = with(f, with(f, named(f, "stone_button"), "face", "floor"), "powered", "true")
    set(mut level, 4, -60, 4, pressed, "the button wasn't set")
    check(flag(f, level, 5, -60, 4, "lit"), "the lamp beside the button isn't lit")
    check(powered_at(f, level, 5, -61, 4), "the grass under the button isn't strongly powered")
    _ = heard(mut level)
    level.schedule_block_tick(block_of(f, "stone_button"), 4, -60, 4, f.button_ticks(block_of(f, "stone_button")), 0)
    run(mut level, 20)
    check(not flag(f, level, 4, -60, 4, "powered"), "the button wasn't let go")
    let click = heard(mut level)
    check(click.names.len() == 1 and click.names[0] == "block.stone_button.click_off", "the button's sound")
    check(click.pitches[0] == 1.0f32 and click.volumes[0] == 1.0f32, "the button's pitch and volume")
    check(not powered_at(f, level, 5, -61, 4), "the grass stayed powered")
    run(mut level, 4)
    check(not flag(f, level, 5, -60, 4, "lit"), "the lamp didn't go out")
    // The lever, on the east face of a stone, powering it strongly; a lamp past the stone, set lit
    // without telling anything, goes out once the lever's taken away.
    set(mut level, 8, -60, 4, named(f, "stone"), "the stone wasn't set")
    let lever = with(f, with(f, with(f, named(f, "lever"), "face", "wall"), "facing", "east"), "powered", "true")
    set(mut level, 9, -60, 4, lever, "the lever wasn't set")
    check(powered_at(f, level, 8, -60, 5), "the stone behind the lever isn't strongly powered")
    check(level.set_block(8, -60, 5, with(f, lamp, "lit", "true"), UPDATE_CLIENTS), "the lit lamp wasn't set")
    set(mut level, 9, -60, 4, AIR_STATE, "the lever wasn't taken away")
    run(mut level, 4)
    check(not flag(f, level, 8, -60, 5, "lit"), "the lamp past the stone wasn't told")
    quiet(mut level, "a button and a lever")
    println("ok button_and_lever")
}

// An oak pressure plate set pressed stays pressed while a player stands on it, ticking again 20
// on, and is let go with its sound the tick after nobody does; a light weighted plate with one
// player on it gives 1, and none once they've gone, ticking 10 on.
fn pressure_plates() {
    let f = facts()
    var level = flat_level(f)
    let plate = block_of(f, "oak_pressure_plate")
    set(mut level, 4, -60, 8, with(f, named(f, "oak_pressure_plate"), "powered", "true"), "the plate wasn't set")
    check(powered_at(f, level, 5, -61, 8), "the grass under the plate isn't strongly powered")
    _ = heard(mut level)
    level.place.players.push((4.5, -60.0, 8.5))
    level.schedule_block_tick(plate, 4, -60, 8, 1, 0)
    run(mut level, 1)
    check(flag(f, level, 4, -60, 8, "powered"), "the plate was let go with a player on it")
    check(heard(mut level).names.is_empty(), "the plate made a sound while pressed")
    level.place.players.clear()
    run(mut level, 19)
    check(flag(f, level, 4, -60, 8, "powered"), "the plate ticked early")
    run(mut level, 1)
    check(not flag(f, level, 4, -60, 8, "powered"), "the plate wasn't let go")
    let off = heard(mut level)
    check(off.names.len() == 1 and off.names[0] == "block.wooden_pressure_plate.click_off", "the plate's sound")
    check(not powered_at(f, level, 5, -61, 8), "the grass under the plate stayed powered")
    // The weighted plate, its signal 9 as a command might set it, counting one player.
    let gold = block_of(f, "light_weighted_pressure_plate")
    set(mut level, 8, -60, 8, with(f, named(f, "light_weighted_pressure_plate"), "power", "9"), "the weighted plate wasn't set")
    level.place.players.push((8.5, -60.0, 8.5))
    level.schedule_block_tick(gold, 8, -60, 8, 1, 0)
    run(mut level, 1)
    check(number(f, level, 8, -60, 8, "power") == 1, "the weighted plate doesn't give 1 for one player")
    check(heard(mut level).names.is_empty(), "the weighted plate made a sound staying pressed")
    level.place.players.clear()
    run(mut level, 10)
    check(number(f, level, 8, -60, 8, "power") == 0, "the weighted plate wasn't let go 10 on")
    let gold_off = heard(mut level)
    check(gold_off.names.len() == 1 and gold_off.names[0] == "block.metal_pressure_plate.click_off", "the weighted plate's sound")
    quiet(mut level, "pressure plates")
    println("ok pressure_plates")
}

// Two hooks facing each other across three tripwires are attached as the last wire's laid, each
// with its sound, and the wires with them; breaking the middle wire trips the line, both hooks
// powered with their sounds, the stone one's fixed to powered strongly; 10 ticks on the gap
// detaches them, and the wires left.
fn tripwire() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 10, -60, 3, named(f, "stone"), "the north stone wasn't set")
    set(mut level, 10, -60, 9, named(f, "stone"), "the south stone wasn't set")
    let hook = named(f, "tripwire_hook")
    set(mut level, 10, -60, 4, with(f, hook, "facing", "south"), "the north hook wasn't set")
    set(mut level, 10, -60, 8, with(f, hook, "facing", "north"), "the south hook wasn't set")
    let wire = named(f, "tripwire")
    set(mut level, 10, -60, 5, wire, "the first wire wasn't set")
    set(mut level, 10, -60, 6, wire, "the second wire wasn't set")
    check(not flag(f, level, 10, -60, 4, "attached"), "the hooks attached early")
    _ = heard(mut level)
    set(mut level, 10, -60, 7, wire, "the third wire wasn't set")
    check(flag(f, level, 10, -60, 4, "attached") and flag(f, level, 10, -60, 8, "attached"), "the hooks didn't attach")
    for z in 5..8 {
        check(flag(f, level, 10, -60, z, "attached"), "a wire didn't attach")
    }
    let attach = heard(mut level)
    check(attach.names.len() == 2 and attach.names[0] == "block.tripwire.attach" and attach.names[1] == "block.tripwire.attach", "the hooks' attaching sounds")
    check(attach.volumes[0] == 0.4f32 and attach.pitches[0] == 0.7f32, "the attaching sound's volume and pitch")
    set(mut level, 10, -60, 6, AIR_STATE, "the middle wire wasn't broken")
    check(flag(f, level, 10, -60, 4, "powered") and flag(f, level, 10, -60, 8, "powered"), "the line wasn't tripped")
    check(powered_at(f, level, 11, -60, 3), "the stone the north hook's on isn't strongly powered")
    let trip = heard(mut level)
    check(trip.names.len() == 2 and trip.names[0] == "block.tripwire.click_on" and trip.pitches[0] == 0.6f32, "the tripping sounds")
    run(mut level, 10)
    check(not flag(f, level, 10, -60, 4, "attached") and not flag(f, level, 10, -60, 4, "powered"), "the north hook didn't let go")
    check(not flag(f, level, 10, -60, 8, "attached") and not flag(f, level, 10, -60, 8, "powered"), "the south hook didn't let go")
    check(not flag(f, level, 10, -60, 5, "attached") and not flag(f, level, 10, -60, 7, "attached"), "the wires stayed attached")
    check(not powered_at(f, level, 11, -60, 3), "the stone stayed powered")
    let release = heard(mut level)
    check(release.names.len() == 2 and release.names[0] == "block.tripwire.click_off" and release.names[1] == "block.tripwire.click_off", "the letting go sounds")
    quiet(mut level, "a tripwire")
    println("ok tripwire")
}

// A target and a sculk sensor set with power lose it as they're placed; a target given power
// again loses it as it ticks. A lightning rod set struck stays so 8 ticks, powering the block
// it's on; a lectern set turning lets go as it ticks.
fn targets_rods_lecterns() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 14, with(f, named(f, "target"), "power", "9"), "the target wasn't set")
    check(number(f, level, 4, -60, 14, "power") == 0, "the target kept its power")
    check(level.set_block(4, -60, 14, with(f, named(f, "target"), "power", "4"), UPDATE_ALL), "the target wasn't given power")
    check(number(f, level, 4, -60, 14, "power") == 4, "the target lost its power again as it was set")
    level.schedule_block_tick(block_of(f, "target"), 4, -60, 14, 1, 0)
    run(mut level, 1)
    check(number(f, level, 4, -60, 14, "power") == 0, "the target didn't lose its power ticking")
    set(mut level, 6, -60, 14, with(f, with(f, named(f, "sculk_sensor"), "sculk_sensor_phase", "active"), "power", "15"), "the sensor wasn't set")
    check(number(f, level, 6, -60, 14, "power") == 0, "the sensor kept its power")
    set(mut level, 8, -60, 14, with(f, named(f, "lightning_rod"), "powered", "true"), "the rod wasn't set")
    check(powered_at(f, level, 9, -61, 14), "the grass under the rod isn't strongly powered")
    run(mut level, 7)
    check(flag(f, level, 8, -60, 14, "powered"), "the rod let go early")
    run(mut level, 1)
    check(not flag(f, level, 8, -60, 14, "powered"), "the rod didn't let go")
    check(not powered_at(f, level, 9, -61, 14), "the grass under the rod stayed powered")
    set(mut level, 10, -60, 14, with(f, named(f, "lectern"), "powered", "true"), "the lectern wasn't set")
    check(powered_at(f, level, 11, -61, 14), "the grass under the lectern isn't strongly powered")
    level.schedule_block_tick(block_of(f, "lectern"), 10, -60, 14, 2, 0)
    run(mut level, 2)
    check(not flag(f, level, 10, -60, 14, "powered"), "the lectern didn't let go")
    check(not powered_at(f, level, 11, -61, 14), "the grass under the lectern stayed powered")
    // A lightning rod is a point of interest, which comes with entities.
    quiet_but(mut level, "targets, rods and lecterns", "Points of interest")
    println("ok targets_rods_lecterns")
}

// A detector rail laid powered is let go at once, with no minecart on it; set powered again, it
// powers the powered rail it joins, and lets go of it as it ticks.
fn detector_rail() {
    let f = facts()
    var level = flat_level(f)
    let detector = with(f, named(f, "detector_rail"), "shape", "east_west")
    set(mut level, 4, -60, 18, with(f, detector, "powered", "true"), "the detector rail wasn't set")
    check(not flag(f, level, 4, -60, 18, "powered"), "the detector rail stayed powered as it was laid")
    set(mut level, 5, -60, 18, with(f, named(f, "powered_rail"), "shape", "east_west"), "the powered rail wasn't set")
    check(not flag(f, level, 5, -60, 18, "powered"), "the powered rail is powered by nothing")
    let laid = level.spawn_state(4, -60, 18)
    check(level.set_block(4, -60, 18, f.try_bool(laid, "powered", true), UPDATE_ALL), "the detector rail wasn't powered")
    check(flag(f, level, 5, -60, 18, "powered"), "the powered rail isn't powered by the detector rail")
    level.schedule_block_tick(block_of(f, "detector_rail"), 4, -60, 18, 1, 0)
    run(mut level, 1)
    check(not flag(f, level, 4, -60, 18, "powered"), "the detector rail didn't let go")
    check(not flag(f, level, 5, -60, 18, "powered"), "the powered rail wasn't told")
    quiet(mut level, "a detector rail")
    println("ok detector_rail")
}

// An active sculk sensor ticks to its cooldown, telling the blocks around, and 10 ticks on goes
// inactive with its clicking stopping, at a pitch of 0.8 to 1; under water, silently.
fn sculk_sensor() {
    let f = facts()
    var level = flat_level(f)
    let sensor = block_of(f, "sculk_sensor")
    set(mut level, 4, -60, 22, with(f, named(f, "sculk_sensor"), "sculk_sensor_phase", "active"), "the sensor wasn't set")
    _ = heard(mut level)
    level.schedule_block_tick(sensor, 4, -60, 22, 1, 0)
    run(mut level, 1)
    check(f.get_name(level.spawn_state(4, -60, 22), "sculk_sensor_phase") == some(String("cooldown")), "the sensor didn't cool down")
    run(mut level, 9)
    check(f.get_name(level.spawn_state(4, -60, 22), "sculk_sensor_phase") == some(String("cooldown")), "the sensor went inactive early")
    run(mut level, 1)
    check(f.get_name(level.spawn_state(4, -60, 22), "sculk_sensor_phase") == some(String("inactive")), "the sensor didn't go inactive")
    let stop = heard(mut level)
    check(stop.names.len() == 1 and stop.names[0] == "block.sculk_sensor.clicking_stop", "the sensor's sound")
    check(stop.pitches[0] >= 0.8f32 and stop.pitches[0] < 1.0f32, "the sensor's pitch")
    let wet = with(f, with(f, named(f, "sculk_sensor"), "sculk_sensor_phase", "cooldown"), "waterlogged", "true")
    set(mut level, 6, -60, 22, wet, "the wet sensor wasn't set")
    level.schedule_block_tick(sensor, 6, -60, 22, 1, 0)
    run(mut level, 1)
    check(f.get_name(level.spawn_state(6, -60, 22), "sculk_sensor_phase") == some(String("inactive")), "the wet sensor didn't go inactive")
    check(heard(mut level).names.is_empty(), "the wet sensor made a sound")
    quiet(mut level, "a sculk sensor")
    println("ok sculk_sensor")
}

fn main() {
    signals()
    button_and_lever()
    pressure_plates()
    tripwire()
    targets_rods_lecterns()
    detector_rail()
    sculk_sensor()
}
