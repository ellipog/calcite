/// Checks `world.random_ticks` (D318): `BlockRandom`, the level's `getBlockRandomPos`, against
/// Java's `int` arithmetic worked out by hand from the same values.
module test.random_ticks

import world.random_ticks.{BlockRandom}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// `n` places from `start` up from `x`, `y`, `z`, and the value after them.
fn places(start: i32, x: i32, y: i32, z: i32, mask: i32, n: i32) -> String {
    var r = BlockRandom { value: start }
    var out = String()
    for _ in 0..n {
        let (px, py, pz) = r.next_pos(x, y, z, mask)
        out.push_str("{px},{py},{pz} ")
    }
    out.push_str("{r.value}")
    return out
}

fn block_random() {
    check(places(0, 16, -64, -32, 15, 4), "23,-53,-20 31,-50,-29 20,-56,-26 22,-59,-31 1901463256")
    check(places(-123456789, 16, -64, -32, 15, 4), "24,-58,-29 31,-64,-27 23,-52,-18 28,-62,-24 491397939")
    check(places(2147483647, 16, -64, -32, 15, 4), "23,-53,-20 28,-50,-29 30,-56,-26 17,-59,-31 -246020473")
    check(places(7, 0, 0, 0, 255, 3), "13,27,12 14,110,3 4,104,7 295853200")
}

fn main() {
    block_random()
    println("ok")
}
