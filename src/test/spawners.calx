/// Tests of `world.spawners`, the Overworld's custom spawners (D314): their timers and what they
/// draw from the level's random, in vanilla's order; the wandering trader's saved data; and the
/// time markers the village siege rolls at.
module test.spawners

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.taped.{TapedRandom}
import resources.identifier.{Identifier}
import server.log.{Entry}
import server.play.{World}
import world.clocks.{TimeMarker}
import world.spawners.{SpawnRules, SpawnerPlayer, SpawnerView, Spawners, TraderData}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn siege_name() -> Identifier {
    return Identifier { namespace: "minecraft", path: "roll_village_siege" }
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn view(bright: bool, sky_darken: i32, siege_roll: bool, players: own List<SpawnerPlayer>) -> SpawnerView {
    return SpawnerView { rules: SpawnRules(), sky_darken: sky_darken, sky_light: true, bright: bright, siege_roll: siege_roll, players: players }
}

fn taped(seed: i64) -> TapedRandom {
    var r = TapedRandom.new(seed)
    r.tape(String("minecraft:overworld"))
    return r
}

// `occursAt`: with a period, where the clock's ticks' remainder by it is the marker's tick, as
// Java's `%` gives the remainder, so never before 0; without one, at its tick only.
fn markers() {
    let siege = TimeMarker { name: siege_name(), clock: 0, ticks: 18000, period: some(24000) }
    let once = TimeMarker { name: siege_name(), clock: 0, ticks: 500 }
    let ticks: List<i64> = [18000, 42000, 17999, -6000, -30000, 0]
    var seen = List<String>()
    for t in ticks {
        seen.push("{siege.occurs_at(t)}")
    }
    check("{seen}", "[true, true, false, false, false, false]", "a marker with a period")
    check("{once.occurs_at(500)} {once.occurs_at(24500)}", "true false", "a marker without one")
}

// `isAtTimeMarker` on a dimension's default clock: the marker of the name registered last on that
// clock, and none for a type without a default clock, as the Nether's.
fn at_marker() {
    var world = World.defaults()
    check("{world.at_marker(0, siege_name())}", "false", "a world with no markers")
    world.markers.push(TimeMarker { name: siege_name(), clock: 1, ticks: 18000, period: some(24000) })
    world.markers.push(TimeMarker { name: siege_name(), clock: 0, ticks: 100, period: some(24000) })
    world.markers.push(TimeMarker { name: siege_name(), clock: 0, ticks: 18000, period: some(24000) })
    world.clocks.clocks[0].total_ticks = 18000
    world.clocks.clocks[1].total_ticks = 18000
    check("{world.at_marker(0, siege_name())} {world.at_marker(1, siege_name())} {world.at_marker(2, siege_name())}", "true false true", "the markers at 18000")
    world.clocks.clocks[0].total_ticks = 100
    check("{world.at_marker(0, siege_name())}", "false", "a marker registered again")
}

// By day with a player, the first tick draws the phantoms' next time, the patrols' and their one
// in five, with their player and place if it's 0, and the cat's player and place, as vanilla's
// spawners draw them in turn.
fn first_tick() {
    var spawners = Spawners.new(0, TraderData())
    var random = taped(1103)
    spawners.tick(view(true, 0, false, [SpawnerPlayer { spectator: false }]), mut random)
    var hand = taped(1103)
    _ = hand.next_int_below(60)
    _ = hand.next_int_below(1200)
    if hand.next_int_below(5) == 0 {
        _ = hand.next_int_below(1)
        for _ in 0..2 {
            _ = hand.next_int_below(24)
            _ = hand.next_boolean()
        }
    }
    _ = hand.next_int_below(1)
    for _ in 0..2 {
        _ = hand.next_int_below(24)
        _ = hand.next_boolean()
    }
    let got = random.take_lines()
    check(got, hand.take_lines(), "the first tick's draws")
    // The next tick, nothing's due.
    spawners.tick(view(true, 0, false, [SpawnerPlayer { spectator: false }]), mut random)
    check(random.take_lines(), "", "the second tick's draws")
}

// The tick from `tick` on at which the spawners next draw, ticking them until then.
fn next_draw(spawners: mut Spawners, v: SpawnerView, random: mut TapedRandom, tick: i32) -> i32 {
    var t = tick
    loop {
        spawners.tick(v, mut random)
        if not random.take_lines().is_empty() {
            return t
        }
        t += 1
        if t > 100000 {
            panic("the spawners drew nothing up to tick {t}")
        }
    }
}

// When each draws next, alone: the phantoms 60 to 119 seconds on, the patrols 12000 to 13199
// ticks on, each by what it drew, added to its timer at -1 as vanilla's `+=` adds it, and the
// cat 1200 ticks on, its timer set.
fn timers() {
    var phantoms = Spawners.new(0, TraderData())
    var random = taped(42)
    var v = view(true, 0, false, List<SpawnerPlayer>())
    v.rules.patrols = false
    v.rules.traders = false
    var hand = LegacyRandom.new(42)
    let n = hand.next_int_below(60)
    let first = next_draw(mut phantoms, v, mut random, 1)
    check("{first} {next_draw(mut phantoms, v, mut random, 2)}", "1 {(60 + n) * 20}", "the phantoms' draws")

    var patrols = Spawners.new(0, TraderData())
    random = taped(42)
    var w = view(true, 0, false, List<SpawnerPlayer>())
    w.rules.phantoms = false
    w.rules.traders = false
    hand = LegacyRandom.new(42)
    let m = hand.next_int_below(1200)
    let start = next_draw(mut patrols, w, mut random, 1)
    check("{start} {next_draw(mut patrols, w, mut random, 2)}", "1 {12000 + m}", "the patrols' draws")

    var cats = Spawners.new(0, TraderData())
    random = taped(42)
    var c = view(true, 0, false, [SpawnerPlayer { spectator: false }])
    c.rules.phantoms = false
    c.rules.patrols = false
    c.rules.traders = false
    let once = next_draw(mut cats, c, mut random, 1)
    check("{once} {next_draw(mut cats, c, mut random, 2)}", "1 1201", "the cat's draws")
}

// At night the patrols wait for day, and the siege is rolled at its marker, one in ten.
fn night() {
    var spawners = Spawners.new(0, TraderData())
    var random = taped(7)
    spawners.tick(view(false, 11, true, List<SpawnerPlayer>()), mut random)
    var hand = taped(7)
    _ = hand.next_int_below(60)
    _ = hand.next_int_below(1200)
    _ = hand.next_int_below(10)
    check(random.take_lines(), hand.take_lines(), "a night tick at the siege's marker")
    // With `spawn_monsters` off, phantoms, patrols and the siege draw nothing, and no player
    // means no cat.
    var off = Spawners.new(0, TraderData())
    var quiet = taped(7)
    var v = view(false, 11, true, List<SpawnerPlayer>())
    v.rules.monsters = false
    off.tick(v, mut quiet)
    check(quiet.take_lines(), "", "a tick without monsters")
}

// The trader's saved delay goes down 1200 a minute, marked to be saved as it changes, and when
// it's out it's 24000 again and the chance goes up 25, unless the trader's own random lets it
// come, which with no player sets it back to 25. The level's random draws nothing for it.
fn trader() {
    var spawners = Spawners.new(5, TraderData())
    var random = taped(0)
    var v = view(false, 11, false, List<SpawnerPlayer>())
    v.rules.monsters = false
    for _ in 0..1199 {
        spawners.tick(v, mut random)
    }
    check("{spawners.trader.spawn_delay} {spawners.trader.dirty}", "24000 false", "the trader before a minute")
    spawners.tick(v, mut random)
    check("{spawners.trader.spawn_delay} {spawners.trader.spawn_chance} {spawners.trader.dirty}", "22800 25 true", "the trader after a minute")
    for _ in 0..1200 * 19 {
        spawners.tick(v, mut random)
    }
    var trader_random = LegacyRandom.new(5)
    let chance = if trader_random.next_int_below(100) > 25 { 50 } else { 25 }
    check("{spawners.trader.spawn_delay} {spawners.trader.spawn_chance}", "24000 {chance}", "the trader after twenty minutes")
    check(random.take_lines(), "", "the level's draws for the trader")
}

// `WanderingTraderData.CODEC`: each field a number, its default where it's missing or isn't one,
// with the errors the last field's first; written back, it reads the same.
fn trader_data() {
    var fields = JavaHashMap<String, Tag>()
    fields.insert(String("spawn_delay"), Tag.Long(1200))
    fields.insert(String("spawn_chance"), Tag.Int(75))
    var root = JavaHashMap<String, Tag>()
    root.insert(String("data"), Tag.Compound(fields))
    var lines = List<Entry>()
    let read = TraderData.load(root, mut lines)
    check("{shown(lines)} {read.spawn_delay} {read.spawn_chance} {read.dirty}", " 1200 75 false", "whole trader data")
    var again = JavaHashMap<String, Tag>()
    again.insert(String("data"), read.pack())
    let back = TraderData.load(again, mut lines)
    check("{shown(lines)} {back.spawn_delay} {back.spawn_chance}", " 1200 75", "the packed trader data")

    var bad = JavaHashMap<String, Tag>()
    bad.insert(String("spawn_delay"), Tag.Str(String("soon")))
    bad.insert(String("spawn_chance"), Tag.Str(String("high")))
    var bad_root = JavaHashMap<String, Tag>()
    bad_root.insert(String("data"), Tag.Compound(bad))
    let fallback = TraderData.load(bad_root, mut lines)
    check("{shown(lines)} {fallback.spawn_delay} {fallback.spawn_chance}", "[Failed to parse saved data for 'SavedDataType[minecraft:wandering_trader]': Not a number; Not a number] 24000 25", "trader data with both fields wrong")
    lines.clear()
    let none_read = TraderData.load(JavaHashMap<String, Tag>(), mut lines)
    check("{shown(lines)} {none_read.spawn_delay}", "[Failed to parse saved data for 'SavedDataType[minecraft:wandering_trader]': Not a map: null] 24000", "trader data without data")
}

fn main() {
    markers()
    at_marker()
    first_tick()
    timers()
    night()
    trader()
    trader_data()
    println("ok")
}
