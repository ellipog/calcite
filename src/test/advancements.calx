/// Checks advancements' codecs (CAL-164): an advancement read as `Advancement.CODEC` reads it,
/// its requirements each criterion alone, in their order, where it gives none, its rewards and
/// the rest at their defaults, a criterion by its trigger with its conditions written only where
/// there are some, and vanilla's messages for what doesn't read. Then the vanilla data's
/// advancements, all read, two of them as they're written. Run from the repository's root, as it
/// reads the pinned server jar in oracle/jars/.
module test.advancements

import json.tree.{parse}
import nbt.tag.{Accounter, Tag, read_any}
import pack.vanilla.{vanilla_jar, vanilla_only}
import registry.advancements.{advancement}
import registry.codec.{Codecs, Refs}
import registry.load.{load_registries}
import registry.registries.{Registries, builtin_registries}
import rig.nbt.{load_language}
import server.log.{Entry}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// What the advancement `text` reads as, in SNBT, or its error, read as the reloadable registries
// are, with the recipes among them.
fn read(text: String) -> String {
    let r = Registries { synced: [], builtin: builtin_registries() }
    var c = Codecs.new()
    c.frozen = true
    c.reloading.push(String("minecraft:advancement"))
    c.reloading.push(String("minecraft:recipe"))
    let at = advancement(mut c)
    let json = parse(text) else panic("not JSON: {text}")
    var refs = Refs.new()
    var got = c.read(at, json, r, mut refs)
    if let e = got.error.take() {
        return "error: {e}"
    }
    if let t = got.thrown.take() {
        return "thrown: {t}"
    }
    let value = got.value.take() ?? Tag.End
    return value.to_snbt()
}

fn defaults() {
    // Each criterion alone, as they're given; no conditions written where there are none.
    check(read("\{\"criteria\":\{\"b\":\{\"trigger\":\"minecraft:tick\"\},\"a\":\{\"trigger\":\"minecraft:impossible\",\"conditions\":\{\}\}\}\}"), "\{criteria:\{a:\{trigger:\"minecraft:impossible\"\},b:\{trigger:\"minecraft:tick\"\}\},requirements:[[\"b\"],[\"a\"]]\}")
    // A criterion's conditions, at their defaults where they're left out.
    check(read("\{\"parent\":\"minecraft:story/root\",\"criteria\":\{\"iron\":\{\"trigger\":\"minecraft:inventory_changed\",\"conditions\":\{\"items\":[\{\"items\":\"minecraft:iron_ingot\"\}]\}\}\},\"rewards\":\{\"experience\":5,\"recipes\":[\"minecraft:iron_block\"]\}\}"), "\{criteria:\{iron:\{conditions:\{items:[\{items:\"minecraft:iron_ingot\"\}]\},trigger:\"minecraft:inventory_changed\"\}\},parent:\"minecraft:story/root\",requirements:[[\"iron\"]],rewards:\{experience:5,recipes:[\"minecraft:iron_block\"]\}\}")
    check(read("\{\"criteria\":\{\"r\":\{\"trigger\":\"minecraft:recipe_unlocked\",\"conditions\":\{\"recipes\":\"minecraft:crafting_table\"\}\}\},\"requirements\":[[\"r\"]],\"sends_telemetry_event\":true\}"), "\{criteria:\{r:\{conditions:\{recipes:\"minecraft:crafting_table\"\},trigger:\"minecraft:recipe_unlocked\"\}\},requirements:[[\"r\"]],sends_telemetry_event:1b\}")
    check(read("\{\"display\":\{\"icon\":\{\"id\":\"minecraft:stone\"\},\"title\":\"T\",\"description\":\{\"translate\":\"d\"\},\"background\":\"minecraft:gui/advancements/backgrounds/stone\",\"frame\":\"goal\",\"hidden\":true\},\"criteria\":\{\"k\":\{\"trigger\":\"minecraft:player_killed_entity\",\"conditions\":\{\"entity\":\{\"type\":\"minecraft:entity_properties\",\"entity\":\"this\",\"predicate\":\{\"minecraft:entity_type\":\"minecraft:zombie\"\}\}\}\}\}\}"), "\{criteria:\{k:\{conditions:\{entity:\{entity:\"this\",predicate:\{\"minecraft:entity_type\":\"minecraft:zombie\"\},type:\"minecraft:entity_properties\"\}\},trigger:\"minecraft:player_killed_entity\"\}\},display:\{background:\"minecraft:gui/advancements/backgrounds/stone\",description:\{translate:\"d\"\},frame:\"goal\",hidden:1b,icon:\{id:\"minecraft:stone\"\},title:\"T\"\},requirements:[[\"k\"]]\}")
}

fn errors() {
    check(read("\{\"criteria\":\{\}\}"), "error: Advancement criteria cannot be empty")
    check(read("\{\"parent\":\"minecraft:a\"\}"), "error: No key criteria in MapLike[\{\"parent\":\"minecraft:a\"\}]")
    let shown = "\"display\":\{\"icon\":\{\"id\":\"minecraft:stone\"\},\"title\":\"T\",\"description\":\"D\""
    let tick = "\"criteria\":\{\"t\":\{\"trigger\":\"minecraft:tick\"\}\}"
    check(read("\{{shown}\},{tick}\}"), "error: Visible advancement roots must have background")
    check(read("\{\"parent\":\"minecraft:a\",{shown},\"background\":\"minecraft:b\"\},{tick}\}"), "error: Only advancement roots can have background")
    check(read("\{{tick},\"requirements\":[[\"u\"]]\}"), "error: Advancement completion requirements did not exactly match specified criteria. Missing: [t]. Unknown: [u]")
    check(read("\{\"criteria\":\{\"a\":\{\"conditions\":\{\}\}\}\}"), "error: Missing \"trigger\" in: MapLike[\{\"conditions\":\{\}\}] missed input: \{\"a\":\{\"conditions\":\{\}\}\}; Advancement criteria cannot be empty")
    check(read("\{\"criteria\":\{\"a\":\{\"trigger\":\"minecraft:nope\"\}\}\}"), "error: Unknown registry key in ResourceKey[minecraft:root / minecraft:trigger_type]: minecraft:nope missed input: \{\"a\":\{\"trigger\":\"minecraft:nope\"\}\}; Advancement criteria cannot be empty")
    check(read("\{\"criteria\":\{\"a\":\{\"trigger\":\"minecraft:construct_beacon\",\"conditions\":\{\"level\":\"x\"\}\}\}\}"), "error: Failed to parse either. First: Not a JSON object: \"x\"; Second: Not a number: \"x\" missed input: \{\"a\":\{\"trigger\":\"minecraft:construct_beacon\",\"conditions\":\{\"level\":\"x\"\}\}\}")
}

// The vanilla data's advancements, all read, and two as they're written.
fn vanilla() {
    var logs = List<Entry>()
    let resources = vanilla_only(vanilla_jar(String("oracle/jars/server-26.3.jar"))!)
    let lang = load_language()!
    let r = load_registries(resources, some(lang), mut logs) else panic("the registries didn't load: {logs.len()} lines")
    let at = r.find_reloadable(String("advancement")) else panic("no advancements")
    check("{r.reloadable[at].entries.len()}", "1866")
    check(entry(r, at, "minecraft:story/root"), "\{criteria:\{crafting_table:\{conditions:\{items:[\{items:\"minecraft:crafting_table\"\}]\},trigger:\"minecraft:inventory_changed\"\}\},display:\{announce_to_chat:0b,background:\"minecraft:gui/advancements/backgrounds/stone\",description:\{translate:\"advancements.story.root.description\"\},icon:\{id:\"minecraft:grass_block\"\},show_toast:0b,title:\{translate:\"advancements.story.root.title\"\}\},requirements:[[\"crafting_table\"]],sends_telemetry_event:1b\}")
    check(entry(r, at, "minecraft:recipes/decorations/crafting_table"), "\{criteria:\{has_the_recipe:\{conditions:\{recipes:\"minecraft:crafting_table\"\},trigger:\"minecraft:recipe_unlocked\"\},unlock_right_away:\{trigger:\"minecraft:tick\"\}\},parent:\"minecraft:recipes/root\",requirements:[[\"has_the_recipe\",\"unlock_right_away\"]],rewards:\{recipes:[\"minecraft:crafting_table\"]\}\}")
}

// The entry `name` of the reloadable registry at `at`, in SNBT.
fn entry(r: Registries, at: usize, name: str) -> String {
    for i in 0..r.reloadable[at].entries.len() {
        if r.reloadable[at].entries[i].to_string() == String(name) {
            var pos: usize = 0
            var accounter = Accounter.unlimited()
            return match read_any(r.reloadable[at].contents[i], mut pos, mut accounter) {
                ok(t) => t.to_snbt(),
                err(_) => String("not NBT"),
            }
        }
    }
    return String("no entry")
}

fn main() {
    defaults()
    errors()
    vanilla()
    println("ok")
}
