/// Tests of `world.brain` (CAL-160): a brain made of an armadillo's sensors and activities, its
/// sensors put off as its random draws and scanning at their rates; its behaviors in the order
/// vanilla goes over them, by priority, then core, idle and panic as their names' hashes put them;
/// the memories registered by its sensors and behaviors and none else; memories set, held for
/// ever or for so many ticks, an empty list held as nothing, and forgotten as their time's up;
/// its activities, the panic one on only where danger's been seen and it isn't panicking, its
/// memories forgotten as it stops; its memories saved and read back; and a gate's shuffle.
module test.brain

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import world.brain.{ACTIVITY_CORE, ACTIVITY_IDLE, ACTIVITY_PANIC, Behavior, Brain, Gate, MEMORIES, MEMORY_BREED_TARGET, MEMORY_DANGER_DETECTED_RECENTLY, MEMORY_GOLEM_DETECTED_RECENTLY, MEMORY_IS_PANICKING, MEMORY_NEAREST_LIVING_ENTITIES, MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, MEMORY_PATH, MEMORY_TEMPTATION_COOLDOWN_TICKS, Memo, SENSOR_ARMADILLO_SCARE, SENSOR_FOOD_TEMPTATIONS, SENSOR_HURT_BY, SENSOR_NEAREST_ADULT, SENSOR_NEAREST_LIVING, STATUS_ABSENT, STATUS_PRESENT, STATUS_REGISTERED, Weighted, armadillo_activities, deed, memory_name, start_deed, timed_out}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// The kind of a behavior, by name, for its order.
fn kind_name(b: Behavior) -> str {
    return match b {
        Behavior.Swim(_) => "swim",
        Behavior.Panic(_) => "panic",
        Behavior.LookAtTarget(_) => "look_at",
        Behavior.MoveToTarget(_) => "move_to",
        Behavior.CountDown(_) => "count",
        Behavior.RollOut(_) => "roll_out",
        Behavior.LookSometimes(_) => "look_sometimes",
        Behavior.MakeLove(_) => "make_love",
        Behavior.Tempted(_) => "tempted",
        Behavior.FollowAdult(_) => "follow_adult",
        Behavior.LookAround(_) => "look_around",
        Behavior.Stroll(_) => "stroll",
        Behavior.WalkToLook(_) => "walk_to_look",
        Behavior.Idle(_) => "idle",
        Behavior.BallUp(_) => "ball_up",
        Behavior.Gate(_) => "gate",
    }
}

fn main() {
    let sensors: List<i32> = [SENSOR_NEAREST_LIVING, SENSOR_HURT_BY, SENSOR_FOOD_TEMPTATIONS, SENSOR_NEAREST_ADULT, SENSOR_ARMADILLO_SCARE]
    var random = LegacyRandom.new(42)
    var b = Brain.made(sensors, armadillo_activities(5), mut random)

    // Each sensor put off as the mob's random draws, below its rate.
    var drawn = LegacyRandom.new(42)
    var delays = String()
    for s in b.sensors {
        delays.push_str("{s.time_to_tick} ")
    }
    let want = "{drawn.next_int_below(20)} {drawn.next_int_below(20)} {drawn.next_int_below(20)} {drawn.next_int_below(20)} {drawn.next_int_below(5)} "
    check(delays, want, "the sensors' delays")
    check("{random.next_int()}", "{drawn.next_int()}", "the brain draws only its sensors' delays")

    // Its behaviors, by priority, then core, idle and panic.
    var order = String()
    for r in b.runs {
        order.push_str("{r.priority}:{kind_name(r.deed.kind)} ")
    }
    check(order, "0:swim 0:look_sometimes 0:ball_up 1:panic 1:make_love 2:look_at 2:gate 3:move_to 3:look_around 4:count 4:gate 5:count 6:roll_out ", "the behaviors' order")

    // The memories registered.
    var registered = String()
    for m in 0..MEMORIES {
        if b.registered(m) {
            registered.push_str("{memory_name(m)} ")
        }
    }
    check(registered, "minecraft:walk_target minecraft:look_target minecraft:breed_target minecraft:path minecraft:hurt_by minecraft:hurt_by_entity minecraft:cant_reach_walk_target_since minecraft:danger_detected_recently minecraft:nearest_visible_adult minecraft:tempting_player minecraft:temptation_cooldown_ticks minecraft:gaze_cooldown_ticks minecraft:is_panicking minecraft:mobs minecraft:visible_mobs ", "the memories registered")

    // Sensors scan as their counts run out, then at their rates.
    var scans = 0
    for _ in 0..40 {
        if b.sensor_due(4) {
            scans += 1
        }
    }
    check("{scans}", "8", "the scare sensor scans every 5 ticks")

    // Memories held for ever, or for so many ticks, then forgotten.
    b.set(MEMORY_TEMPTATION_COOLDOWN_TICKS, Memo.Int(100))
    b.set_for(MEMORY_DANGER_DETECTED_RECENTLY, Memo.Flag(true), 2)
    b.set(MEMORY_NEAREST_LIVING_ENTITIES, Memo.Entities(List<i32>()))
    check("{b.int(MEMORY_TEMPTATION_COOLDOWN_TICKS) ?? -1} {b.has(MEMORY_DANGER_DETECTED_RECENTLY)} {b.ttl(MEMORY_DANGER_DETECTED_RECENTLY)} {b.has(MEMORY_NEAREST_LIVING_ENTITIES)}", "100 true 2 false", "memories set, an empty list held as nothing")
    var held = String()
    for _ in 0..3 {
        b.forget_outdated()
        held.push_str("{b.has(MEMORY_DANGER_DETECTED_RECENTLY)}:{b.ttl(MEMORY_DANGER_DETECTED_RECENTLY)} ")
    }
    check(held, "true:1 true:0 false:0 ", "a memory forgotten as its time's up")
    check("{b.has(MEMORY_TEMPTATION_COOLDOWN_TICKS)}", "true", "a memory held for ever")

    // The panic activity on only where danger's been seen and it isn't panicking.
    let first: List<i32> = [ACTIVITY_PANIC, ACTIVITY_IDLE]
    b.set_first_valid(first)
    check("{b.is_active(ACTIVITY_IDLE)} {b.is_active(ACTIVITY_PANIC)} {b.is_active(ACTIVITY_CORE)}", "true false true", "idle without danger")
    b.set_for(MEMORY_DANGER_DETECTED_RECENTLY, Memo.Flag(true), 80)
    b.set_first_valid(first)
    check("{b.is_active(ACTIVITY_IDLE)} {b.is_active(ACTIVITY_PANIC)} {b.is_active(ACTIVITY_CORE)}", "false true true", "scared with danger")
    b.set(MEMORY_IS_PANICKING, Memo.Flag(true))
    b.set_first_valid(first)
    check("{b.is_active(ACTIVITY_IDLE)} {b.is_active(ACTIVITY_PANIC)}", "true false", "idle while panicking")
    check("{b.check(MEMORY_PATH, STATUS_ABSENT)} {b.check(MEMORY_BREED_TARGET, STATUS_PRESENT)} {b.check(MEMORY_NEAREST_VISIBLE_LIVING_ENTITIES, STATUS_ABSENT)}", "true false true", "memory states")
    // A memory its brain doesn't register, a villager's, is in no state, as `checkMemory` has it.
    check("{b.registered(MEMORY_GOLEM_DETECTED_RECENTLY)} {b.check(MEMORY_GOLEM_DETECTED_RECENTLY, STATUS_ABSENT)} {b.check(MEMORY_GOLEM_DETECTED_RECENTLY, STATUS_REGISTERED)}", "false false false", "an unregistered memory's states")

    // Its memories that may be saved packed as `Brain.Packed` keeps them, by name, with the ticks
    // left of one that runs out, and read back into a brain made afresh.
    let packed = b.packed()
    let Tag.Compound(top) = packed else panic("a brain packs into a compound")
    let Tag.Compound(memories) = top["memories"] else panic("its memories in a compound")
    var saved = String()
    for name in [String("minecraft:temptation_cooldown_ticks"), String("minecraft:danger_detected_recently"), String("minecraft:is_panicking")] {
        let Tag.Compound(entry) = memories[name.copy()] else panic("each memory in a compound")
        saved.push_str("{entry.contains("value")}:{entry.contains("ttl")} ")
    }
    check(saved, "true:false true:true true:false ", "the memories saved, with a ttl where they run out")
    check("{memories.len()}", "3", "only the memories that may be saved")
    var again = Brain.made(sensors, armadillo_activities(5), mut random)
    again.unpack(packed)
    check("{again.int(MEMORY_TEMPTATION_COOLDOWN_TICKS) ?? -1} {again.flag(MEMORY_DANGER_DETECTED_RECENTLY) ?? false}:{again.ttl(MEMORY_DANGER_DETECTED_RECENTLY)} {again.flag(MEMORY_IS_PANICKING) ?? false}:{again.ttl(MEMORY_IS_PANICKING) == i64.MAX}", "100 true:80 true:true", "memories read back")

    // A behavior's duration drawn from the level's random as it starts, every time.
    var level = LegacyRandom.new(7)
    var copy = LegacyRandom.new(7)
    var d = deed(Behavior.LookAtTarget(0), 45, 90)
    start_deed(mut d, 100, mut level)
    check("{d.running} {d.end} {timed_out(d, d.end)} {timed_out(d, d.end + 1)}", "true {100 + 45 + copy.next_int_below(46)} false true", "a behavior's duration")
    var swim = deed(Behavior.Swim(0.8f32), 60, 60)
    start_deed(mut swim, 0, mut level)
    let skip = copy.next_int_below(1)
    check("{swim.end} {level.next_int()}", "{60 + skip} {copy.next_int()}", "a duration drawn even where it's fixed")

    // A gate's shuffle: each drawn a float, sorted by -pow(draw, 1 / weight), least first.
    var entries = List<Weighted>()
    entries.push(Weighted { deed: deed(Behavior.Stroll(1.0f32), 1, 1), weight: 1 })
    entries.push(Weighted { deed: deed(Behavior.WalkToLook((1.0f32, 3)), 1, 1), weight: 1 })
    entries.push(Weighted { deed: deed(Behavior.Idle(0), 30, 60), weight: 1 })
    var g = Gate { entries: entries, random: LegacyRandom.new(3) }
    g.shuffle()
    var draws = LegacyRandom.new(3)
    let (a0, a1, a2) = (draws.next_float(), draws.next_float(), draws.next_float())
    var want_order = List<(f32, str)>()
    want_order.push((a0, "stroll"))
    want_order.push((a1, "walk_to_look"))
    want_order.push((a2, "idle"))
    // Greatest draw first, as -draw sorts least first.
    var names = String()
    while not want_order.is_empty() {
        var best = 0usize
        for i in 1..want_order.len() {
            let (x, _) = want_order[i]
            let (y, _) = want_order[best]
            if x > y {
                best = i
            }
        }
        let (_, n) = want_order.remove(best)
        names.push_str("{n} ")
    }
    var got = String()
    for e in g.entries {
        got.push_str("{kind_name(e.deed.kind)} ")
    }
    check(got, names, "a gate's shuffle")
    println("ok")
}
