/// Checks the players the server knows by name, as vanilla's `CachedUserNameToIdResolver` keeps
/// usercache.json: read with its warnings, found by name in any case and by UUID, forgotten
/// after their month, given offline profiles, and written back, the most recently used first.
module test.users

import auth.profile.{GameProfile}
import java.uuid.{Uuid}
import server.access.{Named, list_date}
import server.log.{Entry}
import server.users.{UserCache}
import std.fs.{make_dir_all, read, remove_dir_all, temp_dir, write}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn warnings(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("{e.message}|")
    }
    return out
}

fn shown(n: Named?) -> String {
    let p = n else return String("none")
    return "{p.name} {p.id.to_string()}"
}

fn main() {
    let folder = "{temp_dir()!}/calcite-users-test"
    match remove_dir_all(folder.copy()) {
        ok => {},
        err(_) => {},
    }
    match make_dir_all(folder.copy()) {
        ok => {},
        err(_) => panic("can't make {folder}"),
    }
    let file = "{folder}/usercache.json"
    let noon: i64 = 1793275200000
    let later = list_date(noon + 86400000)

    // Nothing there: no one known, and no warning.
    var lines = List<Entry>()
    var none_yet = UserCache.load(file.copy(), mut lines)
    check("{shown(none_yet.cached(String("Steve"), noon))} {warnings(lines)}", "none ")

    // Steve and Alex, with an entry whose date doesn't parse and one that isn't an object.
    let text = "[\{\"uuid\":\"8667ba71-b85a-4004-af54-457a9734eed7\",\"name\":\"Steve\",\"expiresOn\":\"{later}\"\},5,\{\"uuid\":\"ec561538-f3fd-461d-aff5-086b22154bce\",\"name\":\"Alex\",\"expiresOn\":\"soon\"\},\{\"uuid\":\"00000000-0000-0000-0000-000000000001\",\"name\":\"Old\",\"expiresOn\":\"{list_date(noon - 1)}\"\}]"
    match write(file.copy(), text.to_bytes()) {
        ok => {},
        err(_) => panic("can't write usercache.json"),
    }
    lines = List<Entry>()
    var cache = UserCache.load(file.copy(), mut lines)
    check(warnings(lines), "Failed to parse date soon|")
    cache.writes_back()
    check(shown(cache.cached(String("STEVE"), noon)), "Steve 8667ba71-b85a-4004-af54-457a9734eed7")
    check(shown(cache.of_id(Uuid.parse(String("8667ba71-b85a-4004-af54-457a9734eed7")) ?? Uuid.new(0, 0))), "Steve 8667ba71-b85a-4004-af54-457a9734eed7")
    check(shown(cache.cached(String("Alex"), noon)), "none")
    // Old's month is over: forgotten, and the file written, where no profile's given.
    cache.offline = false
    check(shown(cache.cached(String("old"), noon)), "none")
    check(shown(cache.resolved(String("old"), none, noon)), "none")
    check(String.from_utf8(read(file.copy())!) ?? String(), "[\{\"uuid\":\"8667ba71-b85a-4004-af54-457a9734eed7\",\"name\":\"Steve\",\"expiresOn\":\"{later}\"\}]")

    // A name no one has, offline: in lower case, with its offline UUID, added first.
    cache.offline = true
    let ghost = GameProfile.offline(String("nobodyatallhere17x")).id.to_string()
    check(shown(cache.resolved(String("NobodyAtAllHere17x"), none, noon)), "nobodyatallhere17x {ghost}")
    check(shown(cache.cached(String("nobodyatallhere17x"), noon)), "nobodyatallhere17x {ghost}")
    let ghost_ends = list_date(1795953600000)
    check(String.from_utf8(read(file.copy())!) ?? String(), "[\{\"uuid\":\"{ghost}\",\"name\":\"nobodyatallhere17x\",\"expiresOn\":\"{ghost_ends}\"\},\{\"uuid\":\"8667ba71-b85a-4004-af54-457a9734eed7\",\"name\":\"Steve\",\"expiresOn\":\"{later}\"\}]")
    // One the lookup found, as it's named.
    let found = Named { id: Uuid.new(7, 7), name: String("Found") }
    check(shown(cache.resolved(String("found"), some(found), noon)), "Found 00000000-0000-0007-0000-000000000007")

    remove_dir_all(folder)!
    println("ok")
}
