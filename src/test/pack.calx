/// Checks data packs as pack.zip, pack.resources and the registry modules read them, on small
/// zips made here: entries stored and deflated, stretches of archives walked file by file, files
/// listed in vanilla's order with later packs
/// over earlier ones, and tags built and refused as vanilla's `TagLoader` builds and refuses them.
/// The registries of the real vanilla pack are checked against vanilla by the rig's `registries`
/// probe.
module test.pack

import pack.resources.{Pack, Resources}
import pack.zip.{Zip}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry}
import std.zlib.{Format, compress, crc32}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

struct File {
    name: String
    text: String
    deflate: bool
}

fn file(name: str, contents: str) -> File {
    return File { name: String(name), text: String(contents), deflate: true }
}

fn push16(out: mut List<u8>, v: usize) {
    out.push(u8.wrap(v % 256))
    out.push(u8.wrap(v / 256 % 256))
}

fn push32(out: mut List<u8>, v: u64) {
    var x = v
    for _ in 0..4 {
        out.push(u8.wrap(x % 256))
        x /= 256
    }
}

// A zip of the files, then `comment`.
fn zip(files: List<File>, comment: String) -> List<u8> {
    var out = List<u8>()
    var central = List<u8>()
    for f in files {
        let data = f.text.to_bytes()
        let stored = if f.deflate { compress(data, Format.Raw, 6) } else { data.copy() }
        let offset = out.len()
        let name = f.name.to_bytes()
        let method: usize = if f.deflate { 8 } else { 0 }
        for part in 0..2 {
            var h = List<u8>()
            push32(mut h, if part == 0 { 0x04034b50u64 } else { 0x02014b50u64 })
            if part == 1 {
                push16(mut h, 20)
            }
            push16(mut h, 20)
            push16(mut h, 0)
            push16(mut h, method)
            push16(mut h, 0)
            push16(mut h, 0)
            push32(mut h, u64(crc32(data)))
            push32(mut h, u64(stored.len()))
            push32(mut h, u64(data.len()))
            push16(mut h, name.len())
            push16(mut h, 0)
            if part == 1 {
                push16(mut h, 0)
                push16(mut h, 0)
                push16(mut h, 0)
                push32(mut h, 0)
                push32(mut h, u64(offset))
            }
            for b in name {
                h.push(b)
            }
            if part == 0 {
                for b in h {
                    out.push(b)
                }
                for b in stored {
                    out.push(b)
                }
            } else {
                for b in h {
                    central.push(b)
                }
            }
        }
    }
    let at = out.len()
    for b in central {
        out.push(b)
    }
    push32(mut out, 0x06054b50)
    push16(mut out, 0)
    push16(mut out, 0)
    push16(mut out, files.len())
    push16(mut out, files.len())
    push32(mut out, u64(central.len()))
    push32(mut out, u64(at))
    push16(mut out, comment.len())
    for b in comment.to_bytes() {
        out.push(b)
    }
    return out
}

// The files' local headers and data one after another, as a stretch of an archive holds them:
// deflated ones with their sizes and CRC in a data descriptor after them, which has its signature
// if `signature`, as Java's `ZipOutputStream` writes them, and stored ones with them in the header.
fn stretch(files: List<File>, signature: bool) -> List<u8> {
    var out = List<u8>()
    for f in files {
        let data = f.text.to_bytes()
        let stored = if f.deflate { compress(data, Format.Raw, 6) } else { data.copy() }
        let name = f.name.to_bytes()
        push32(mut out, 0x04034b50)
        push16(mut out, 20)
        push16(mut out, if f.deflate { 0x808 } else { 0x800 })
        push16(mut out, if f.deflate { 8 } else { 0 })
        push16(mut out, 0)
        push16(mut out, 0)
        for v in [u64(crc32(data)), u64(stored.len()), u64(data.len())] {
            push32(mut out, if f.deflate { 0 } else { v })
        }
        push16(mut out, name.len())
        push16(mut out, 0)
        for b in name {
            out.push(b)
        }
        for b in stored {
            out.push(b)
        }
        if f.deflate {
            if signature {
                push32(mut out, 0x08074b50)
            }
            push32(mut out, u64(crc32(data)))
            push32(mut out, u64(stored.len()))
            push32(mut out, u64(data.len()))
        }
    }
    return out
}

fn text(bytes: List<u8>) -> String {
    return String.from_utf8(bytes.copy()) ?? String("not UTF-8")
}

fn zips() {
    var stored = file("a.txt", "stored text")
    stored.deflate = false
    let files: List<File> = [stored.copy(), file("dir/b.txt", "deflated text, deflated text, deflated text")]
    let z = Zip.open(zip(files, String("a comment")))!
    check("{z.len()} {z.name(0)} {z.name(1)}", "2 a.txt dir/b.txt")
    check(text(z.read(0)!), "stored text")
    check(text(z.read_named(String("dir/b.txt"))!), "deflated text, deflated text, deflated text")
    check("{z.find(String("missing")) == none}", "true")
    // A byte changed in a file's data fails its CRC.
    var broken = zip([stored.copy()], String())
    broken[30 + 5] ^= 1
    match Zip.open(broken)!.read(0) {
        ok(_) => panic("a broken file read"),
        err(message) => check(message, "invalid entry CRC in a.txt"),
    }
    match Zip.open([1, 2, 3]) {
        ok(_) => panic("three bytes opened as a zip"),
        err(message) => check(message, "zip END header not found"),
    }
}

fn walks() {
    var stored = file("dir/", "")
    stored.deflate = false
    // Long enough to take its inflater a few rounds.
    var long = String()
    for _ in 0..3000 {
        long.push_str("deflated text, ")
    }
    long.push_str("the end")
    let files: List<File> = [file("a.txt", "deflated text"), stored.copy(), File { name: "dir/b.txt", text: long.copy(), deflate: true }, file("empty", "")]
    for signature in [true, false] {
        let z = Zip.walk(stretch(files, signature))!
        check("{z.len()} {z.name(0)} {z.name(1)} {z.name(2)} {z.name(3)}", "4 a.txt dir/ dir/b.txt empty")
        check(text(z.read(0)!), "deflated text")
        check("{z.read(1)!.len()} {z.read(3)!.len()}", "0 0")
        check(text(z.read_named(String("dir/b.txt"))!), long.copy())
        check("{z.entries()[2].size}", "{long.len()}")
    }
    // A byte changed in an inflated file's data fails its CRC when it's read, and one in a
    // descriptor that doesn't match where the data ends fails the walk.
    var broken = stretch([file("a.txt", "deflated text")], true)
    let crc_at = broken.len() - 12
    broken[crc_at] ^= 1
    match Zip.walk(broken)!.read(0) {
        ok(_) => panic("a broken file read"),
        err(message) => check(message, "invalid entry CRC in a.txt"),
    }
    var short = stretch([file("a.txt", "deflated text")], true)
    let size_at = short.len() - 4
    short[size_at] ^= 1
    match Zip.walk(short) {
        ok(_) => panic("a descriptor with the wrong size read"),
        err(message) => check(message, "invalid data descriptor in a.txt"),
    }
    var trailing = stretch([file("a.txt", "deflated text")], false)
    trailing.push(0)
    let stray = trailing.len() - 1
    match Zip.walk(trailing) {
        ok(_) => panic("a stray byte after the last file read"),
        err(message) => check(message, "invalid LOC header (bad signature) at {stray}"),
    }
}

fn pack(id: str, files: List<File>) -> Pack {
    return Pack.from_zip(String(id), none, Zip.open(zip(files, String()))!)
}

fn ids(r: Resources, directory: str) -> String {
    var out = String()
    for f in r.list(String(directory), String(".json")) {
        out.push_str("{f.id.to_string()}@{f.pack} ")
    }
    return out
}

fn listing() {
    let base: List<File> = [
        file("data/minecraft/dimension_type/b.json", "\{\}"),
        file("data/zeta/dimension_type/a.json", "\{\}"),
        file("data/minecraft/dimension_type/sub/c.json", "\{\}"),
        file("data/minecraft/dimension_type/a.txt", "\{\}"),
        file("data/minecraft/dimension_type.json", "\{\}"),
        file("data/minecraft/other/x.json", "\{\}"),
        file("pack.mcmeta", "\{\}"),
    ]
    let top: List<File> = [file("data/minecraft/dimension_type/b.json", "\{\"top\":1\}"), file("data/alpha/dimension_type/a.json", "\{\}")]
    let packs: List<Pack> = [pack("base", base), pack("top", top)]
    let r = Resources.new(packs)
    // By path, then namespace, with the top pack's b.json, and only .json files in the folder.
    check(ids(r, "dimension_type"), "alpha:dimension_type/a.json@1 zeta:dimension_type/a.json@0 minecraft:dimension_type/b.json@1 minecraft:dimension_type/sub/c.json@0 ")
    let stacks = r.stacks(String("dimension_type"), String(".json"))
    check("{stacks.len()} {stacks[2].resources.len()} {stacks[2].resources[0].pack} {stacks[2].resources[1].pack}", "4 2 0 1")
    check(text(r.read(stacks[2].resources[1])!), "\{\"top\":1\}")
    check(r.pack_id(1), "top")
}

fn registry_named(r: Registries, name: String) -> Registry {
    for x in r.synced {
        if x.name.path == name {
            return x.copy()
        }
    }
    for x in r.builtin {
        if x.name.path == name {
            return x.copy()
        }
    }
    panic("no registry {name}")
}

// The tag's entries by name, or `none` if it wasn't built.
fn tag(r: Registry, name: String) -> String {
    for t in r.tags {
        if t.name.path == name {
            var out = String()
            for v in t.values {
                if not out.is_empty() {
                    out.push_str(" ")
                }
                out.push_str(r.entries[usize.wrap(v)].path)
            }
            return "[{out}]"
        }
    }
    return String("none")
}

fn tags() {
    let base: List<File> = [
        file("data/minecraft/dimension_type/overworld.json", "\{\}"),
        file("data/minecraft/tags/dimension_type/all.json", "\{\"values\":[\"overworld\"]\}"),
        file("data/minecraft/tags/block/t1.json", "\{\"values\":[\"stone\",\"#minecraft:t2\"]\}"),
        file("data/minecraft/tags/block/t2.json", "\{\"values\":[\"dirt\",\{\"id\":\"minecraft:nope\",\"required\":false\},\{\"id\":\"#minecraft:absent\",\"required\":false\}]\}"),
        file("data/minecraft/tags/block/t3.json", "\{\"values\":[\"stone\"]\}"),
        file("data/minecraft/tags/block/t4.json", "\{\"values\":[\"minecraft:nope\",\"#minecraft:absent\",\"granite\"]\}"),
        file("data/minecraft/tags/block/t5.json", "not json"),
        file("data/minecraft/tags/block/t6.json", "\{\"values\":3\}"),
        file("data/minecraft/tags/block/t7.json", "\{\"values\":[\"stone\",\"stone\",\"#t1\"]\}"),
        file("data/minecraft/tags/block/c1.json", "\{\"values\":[\"#c2\"]\}"),
        file("data/minecraft/tags/block/c2.json", "\{\"values\":[\"#c1\"]\}"),
    ]
    let top: List<File> = [
        file("data/minecraft/tags/block/t1.json", "\{\"values\":[\"granite\"]\}"),
        file("data/minecraft/tags/block/t3.json", "\{\"replace\":true,\"values\":[\"dirt\"]\}"),
    ]
    let packs: List<Pack> = [pack("base", base), pack("top", top)]
    var logs = List<Entry>()
    let r = Registries.load(Resources.new(packs), mut logs)!
    let blocks = registry_named(r, String("block"))
    // A later pack's file adds to a tag, unless it replaces it; a tag's tags go in where they're
    // listed, and each entry once.
    check(tag(blocks, String("t1")), "[stone dirt granite]")
    check(tag(blocks, String("t2")), "[dirt]")
    check(tag(blocks, String("t3")), "[dirt]")
    check(tag(blocks, String("t7")), "[stone dirt granite]")
    // A tag missing what it needs isn't built, nor one a cycle needs; a file that's JSON but not
    // a tag file leaves an empty tag.
    check(tag(blocks, String("t4")), "none")
    check(tag(blocks, String("t5")), "none")
    check(tag(blocks, String("t6")), "[]")
    check("{tag(blocks, String("c1"))} {tag(blocks, String("c2"))}", "none none")
    let dims = registry_named(r, String("dimension_type"))
    check("{dims.entries.len()} {dims.entries[0].to_string()} {tag(dims, String("all"))}", "1 minecraft:overworld [overworld]")
    var lines = List<String>()
    for e in logs {
        lines.push(e.message.copy())
    }
    lines.sort()
    check("{lines.len()}", "5")
    check(lines[0], "Couldn't load tag minecraft:c1 as it is missing following references: #minecraft:c2 (from base)")
    check(lines[1], "Couldn't load tag minecraft:c2 as it is missing following references: #minecraft:c1 (from base)")
    check(lines[2], "Couldn't load tag minecraft:t4 as it is missing following references: minecraft:nope (from base), #minecraft:absent (from base)")
    check(lines[3], "Couldn't read tag list minecraft:t5 from minecraft:tags/block/t5.json in data pack base")
    check(lines[4], "Couldn't read tag list minecraft:t6 from minecraft:tags/block/t6.json in data pack base")

    // A synchronized registry's tag that needs an entry it hasn't stops the server.
    let unbound: List<File> = [file("data/minecraft/tags/dimension_type/all.json", "\{\"values\":[\"minecraft:gone\"]\}")]
    let bad: List<Pack> = [pack("base", unbound)]
    var bad_logs = List<Entry>()
    check("{Registries.load(Resources.new(bad), mut bad_logs) == none}", "true")
    check(bad_logs[0].message, "Unbound values in registry minecraft:dimension_type: [minecraft:gone]")
}

fn identifiers() {
    // Vanilla's `hashCode`, which orders its hash maps of identifiers.
    let id = Identifier { namespace: "minecraft", path: "stone" }
    check("{id.java_hash()}", "{31 * String("minecraft").java_hash() + String("stone").java_hash()}")
}

fn main() {
    zips()
    walks()
    listing()
    tags()
    identifiers()
    println("ok")
}
