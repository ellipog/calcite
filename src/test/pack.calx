/// Checks data packs as pack.zip, pack.resources and the registry modules read them, on small
/// zips and folders made here: entries stored and deflated, stretches of archives walked file by
/// file, files listed in vanilla's order with later packs over earlier ones, overlays over their
/// packs, filters hiding what's below them, vanilla's warnings for names that can't be
/// namespaces or paths, and tags built and refused as vanilla's `TagLoader` builds and refuses
/// them.
/// The registries of the real vanilla pack are checked against vanilla by the rig's `registries`
/// probe.
module test.pack

import pack.meta.{read_filter}
import pack.resources.{Pack, Resources}
import pack.zip.{Zip}
import registry.load.{load_registries}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry, Level}
import std.fs.{make_dir_all, remove_dir_all, separator, temp_dir, write}
import std.zlib.{Format, compress, crc32}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

struct File {
    name: String
    text: String
    deflate: bool
}

fn file(name: str, contents: str) -> File {
    return File { name: String(name), text: String(contents), deflate: true }
}

fn push16(out: mut List<u8>, v: usize) {
    out.push(u8.wrap(v % 256))
    out.push(u8.wrap(v / 256 % 256))
}

fn push32(out: mut List<u8>, v: u64) {
    var x = v
    for _ in 0..4 {
        out.push(u8.wrap(x % 256))
        x /= 256
    }
}

// A zip of the files, then `comment`.
fn zip(files: List<File>, comment: String) -> List<u8> {
    var out = List<u8>()
    var central = List<u8>()
    for f in files {
        let data = f.text.to_bytes()
        let stored = if f.deflate { compress(data, Format.Raw, 6) } else { data.copy() }
        let offset = out.len()
        let name = f.name.to_bytes()
        let method: usize = if f.deflate { 8 } else { 0 }
        for part in 0..2 {
            var h = List<u8>()
            push32(mut h, if part == 0 { 0x04034b50u64 } else { 0x02014b50u64 })
            if part == 1 {
                push16(mut h, 20)
            }
            push16(mut h, 20)
            push16(mut h, 0)
            push16(mut h, method)
            push16(mut h, 0)
            push16(mut h, 0)
            push32(mut h, u64(crc32(data)))
            push32(mut h, u64(stored.len()))
            push32(mut h, u64(data.len()))
            push16(mut h, name.len())
            push16(mut h, 0)
            if part == 1 {
                push16(mut h, 0)
                push16(mut h, 0)
                push16(mut h, 0)
                push32(mut h, 0)
                push32(mut h, u64(offset))
            }
            for b in name {
                h.push(b)
            }
            if part == 0 {
                for b in h {
                    out.push(b)
                }
                for b in stored {
                    out.push(b)
                }
            } else {
                for b in h {
                    central.push(b)
                }
            }
        }
    }
    let at = out.len()
    for b in central {
        out.push(b)
    }
    push32(mut out, 0x06054b50)
    push16(mut out, 0)
    push16(mut out, 0)
    push16(mut out, files.len())
    push16(mut out, files.len())
    push32(mut out, u64(central.len()))
    push32(mut out, u64(at))
    push16(mut out, comment.len())
    for b in comment.to_bytes() {
        out.push(b)
    }
    return out
}

// The files' local headers and data one after another, as a stretch of an archive holds them:
// deflated ones with their sizes and CRC in a data descriptor after them, which has its signature
// if `signature`, as Java's `ZipOutputStream` writes them, and stored ones with them in the header.
fn stretch(files: List<File>, signature: bool) -> List<u8> {
    var out = List<u8>()
    for f in files {
        let data = f.text.to_bytes()
        let stored = if f.deflate { compress(data, Format.Raw, 6) } else { data.copy() }
        let name = f.name.to_bytes()
        push32(mut out, 0x04034b50)
        push16(mut out, 20)
        push16(mut out, if f.deflate { 0x808 } else { 0x800 })
        push16(mut out, if f.deflate { 8 } else { 0 })
        push16(mut out, 0)
        push16(mut out, 0)
        for v in [u64(crc32(data)), u64(stored.len()), u64(data.len())] {
            push32(mut out, if f.deflate { 0 } else { v })
        }
        push16(mut out, name.len())
        push16(mut out, 0)
        for b in name {
            out.push(b)
        }
        for b in stored {
            out.push(b)
        }
        if f.deflate {
            if signature {
                push32(mut out, 0x08074b50)
            }
            push32(mut out, u64(crc32(data)))
            push32(mut out, u64(stored.len()))
            push32(mut out, u64(data.len()))
        }
    }
    return out
}

fn text(bytes: List<u8>) -> String {
    return String.from_utf8(bytes.copy()) ?? String("not UTF-8")
}

fn zips() {
    var stored = file("a.txt", "stored text")
    stored.deflate = false
    let files: List<File> = [stored.copy(), file("dir/b.txt", "deflated text, deflated text, deflated text")]
    let z = Zip.open(zip(files, String("a comment")))!
    check("{z.len()} {z.name(0)} {z.name(1)}", "2 a.txt dir/b.txt")
    check(text(z.read(0)!), "stored text")
    check(text(z.read_named(String("dir/b.txt"))!), "deflated text, deflated text, deflated text")
    check("{z.find(String("missing")) == none}", "true")
    // A byte changed in a file's data fails its CRC.
    var broken = zip([stored.copy()], String())
    broken[30 + 5] ^= 1
    match Zip.open(broken)!.read(0) {
        ok(_) => panic("a broken file read"),
        err(message) => check(message, "invalid entry CRC in a.txt"),
    }
    match Zip.open([1, 2, 3]) {
        ok(_) => panic("three bytes opened as a zip"),
        err(message) => check(message, "zip END header not found"),
    }
    match Zip.open([]) {
        ok(_) => panic("no bytes opened as a zip"),
        err(message) => check(message, "zip file is empty"),
    }
}

fn walks() {
    var stored = file("dir/", "")
    stored.deflate = false
    // Long enough to take its inflater a few rounds.
    var long = String()
    for _ in 0..3000 {
        long.push_str("deflated text, ")
    }
    long.push_str("the end")
    let files: List<File> = [file("a.txt", "deflated text"), stored.copy(), File { name: "dir/b.txt", text: long.copy(), deflate: true }, file("empty", "")]
    for signature in [true, false] {
        let z = Zip.walk(stretch(files, signature))!
        check("{z.len()} {z.name(0)} {z.name(1)} {z.name(2)} {z.name(3)}", "4 a.txt dir/ dir/b.txt empty")
        check(text(z.read(0)!), "deflated text")
        check("{z.read(1)!.len()} {z.read(3)!.len()}", "0 0")
        check(text(z.read_named(String("dir/b.txt"))!), long.copy())
        check("{z.entries()[2].size}", "{long.len()}")
    }
    // A byte changed in an inflated file's data fails its CRC when it's read, and one in a
    // descriptor that doesn't match where the data ends fails the walk.
    var broken = stretch([file("a.txt", "deflated text")], true)
    let crc_at = broken.len() - 12
    broken[crc_at] ^= 1
    match Zip.walk(broken)!.read(0) {
        ok(_) => panic("a broken file read"),
        err(message) => check(message, "invalid entry CRC in a.txt"),
    }
    var short = stretch([file("a.txt", "deflated text")], true)
    let size_at = short.len() - 4
    short[size_at] ^= 1
    match Zip.walk(short) {
        ok(_) => panic("a descriptor with the wrong size read"),
        err(message) => check(message, "invalid data descriptor in a.txt"),
    }
    var trailing = stretch([file("a.txt", "deflated text")], false)
    trailing.push(0)
    let stray = trailing.len() - 1
    match Zip.walk(trailing) {
        ok(_) => panic("a stray byte after the last file read"),
        err(message) => check(message, "invalid LOC header (bad signature) at {stray}"),
    }
}

// What's in a pack to be: its files, the layers they're under, top first, and its pack.mcmeta.
struct Made {
    id: String
    files: List<File>
    layers: List<String>
    meta: String
}

fn made(id: str, files: List<File>) -> Made {
    return Made { id: String(id), files: files.copy(), layers: [""], meta: String() }
}

// The packs, each a world's zip in an archive of its own, with its filter.
fn open(sets: List<Made>, logs: mut List<Entry>) -> Resources {
    var archives = List<Zip>()
    var packs = List<Pack>()
    for k in 0..sets.len() {
        let z = Zip.open(zip(sets[k].files, String()))!
        var filter_lines = List<Entry>()
        let meta: List<u8>? = if sets[k].meta.is_empty() { none } else { some(sets[k].meta.to_bytes()) }
        let filter = read_filter(sets[k].id, meta, mut filter_lines)
        packs.push(Pack.in_archive(sets[k].id.copy(), none, k, z, sets[k].layers, some("{sets[k].id}.zip"), filter, filter_lines))
        archives.push(z)
    }
    return Resources.new(archives, packs, mut logs)
}

fn opened(sets: List<Made>) -> Resources {
    var logs = List<Entry>()
    return open(sets, mut logs)
}

fn ids(r: Resources, directory: str) -> String {
    var out = String()
    var logs = List<Entry>()
    for f in r.list(String(directory), String(".json"), mut logs) {
        out.push_str("{f.id.to_string()}@{f.pack} ")
    }
    return out
}

// The lines, each its level's letter and its message, then `|`.
fn lines_of(logs: List<Entry>) -> String {
    var out = String()
    for e in logs {
        let mark = match e.level {
            Level.Info => "I",
            Level.Warn => "W",
            Level.Error => "E",
        }
        out.push_str("{mark} {e.message}|")
    }
    return out
}

fn listing() {
    let base: List<File> = [
        file("data/minecraft/dimension_type/b.json", "\{\}"),
        file("data/zeta/dimension_type/a.json", "\{\}"),
        file("data/minecraft/dimension_type/sub/c.json", "\{\}"),
        file("data/minecraft/dimension_type/a.txt", "\{\}"),
        file("data/minecraft/dimension_type.json", "\{\}"),
        file("data/minecraft/other/x.json", "\{\}"),
        file("pack.mcmeta", "\{\}"),
    ]
    let top: List<File> = [file("data/minecraft/dimension_type/b.json", "\{\"top\":1\}"), file("data/alpha/dimension_type/a.json", "\{\}")]
    let r = opened([made("base", base), made("top", top)])
    // By path, then namespace, with the top pack's b.json, and only .json files in the folder.
    check(ids(r, "dimension_type"), "alpha:dimension_type/a.json@1 zeta:dimension_type/a.json@0 minecraft:dimension_type/b.json@1 minecraft:dimension_type/sub/c.json@0 ")
    var logs = List<Entry>()
    let stacks = r.stacks(String("dimension_type"), String(".json"), mut logs)
    check("{stacks.len()} {stacks[2].resources.len()} {stacks[2].resources[0].pack} {stacks[2].resources[1].pack}", "4 2 0 1")
    check(text(r.read(stacks[2].resources[1])!), "\{\"top\":1\}")
    check(r.pack_id(1), "top")
}

// An overlay's files go over its pack's, the last listed on top, and its namespaces are the
// pack's too.
fn overlays() {
    let files: List<File> = [
        file("data/minecraft/dimension_type/a.json", "root a"),
        file("data/minecraft/dimension_type/b.json", "root b"),
        file("one/data/minecraft/dimension_type/b.json", "one b"),
        file("one/data/minecraft/dimension_type/c.json", "one c"),
        file("two/data/minecraft/dimension_type/c.json", "two c"),
        file("two/data/extra/dimension_type/d.json", "two d"),
    ]
    var m = made("p", files)
    m.layers = ["two/", "one/", ""]
    let r = opened([m])
    check(ids(r, "dimension_type"), "minecraft:dimension_type/a.json@0 minecraft:dimension_type/b.json@0 minecraft:dimension_type/c.json@0 extra:dimension_type/d.json@0 ")
    var logs = List<Entry>()
    var got = String()
    for f in r.list(String("dimension_type"), String(".json"), mut logs) {
        got.push_str("{text(r.read(f)!)},")
    }
    check(got, "root a,one b,two c,two d,")
}

// A pack's filter hides the files of the packs below it whose namespace and path it takes, but
// not its own, nor those of the packs above it.
fn filters() {
    let base: List<File> = [file("data/minecraft/dimension_type/a.json", "base a"), file("data/minecraft/dimension_type/b.json", "base b"), file("data/other/dimension_type/b.json", "other b")]
    var middle = made("middle", [file("data/minecraft/dimension_type/b.json", "middle b")])
    middle.meta = String(#"{"filter":{"block":[{"namespace":"minecraft","path":"dimension_type/b"}]}}"#)
    let top = made("top", [file("data/minecraft/dimension_type/a.json", "top a")])
    let r = opened([made("base", base), middle, top])
    check(ids(r, "dimension_type"), "minecraft:dimension_type/a.json@2 minecraft:dimension_type/b.json@1 other:dimension_type/b.json@0 ")
    var logs = List<Entry>()
    let stacks = r.stacks(String("dimension_type"), String(".json"), mut logs)
    check("{stacks[0].resources.len()} {stacks[1].resources.len()} {stacks[1].resources[0].pack}", "2 1 1")
    // A filter that can't be read is left out, with vanilla's error.
    var broken = made("broken", [file("data/minecraft/dimension_type/c.json", "c")])
    broken.meta = String(#"{"filter":{"block":[{"namespace":"("}]}}"#)
    var opening = List<Entry>()
    let r2 = open([made("base", base), broken], mut opening)
    check(ids(r2, "dimension_type"), "minecraft:dimension_type/a.json@0 minecraft:dimension_type/b.json@0 other:dimension_type/b.json@0 minecraft:dimension_type/c.json@1 ")
    check(lines_of(opening), "E Failed to get filter section from pack broken|")
}

// Names in a zip that can't be namespaces are warned of for each entry, each time the packs'
// namespaces are read, and paths that can't be identifiers when their folder's listed.
fn zip_warnings() {
    let files: List<File> = [
        file("data/Bad/", ""),
        file("data/Bad/x.json", "\{\}"),
        file("data/minecraft/dimension_type/Upper.json", "\{\}"),
        file("data/minecraft/dimension_type/fine.json", "\{\}"),
        file("data/minecraft/other/Upper.json", "\{\}"),
        file("data/loose", ""),
    ]
    var logs = List<Entry>()
    let r = open([made("p", files)], mut logs)
    let bad = "W Non [a-z0-9_.-] character in namespace Bad in pack p.zip, ignoring|"
    check(lines_of(logs), "{bad}{bad}{bad}{bad}")
    var listed = List<Entry>()
    let found = r.list(String("dimension_type"), String(".json"), mut listed)
    check("{found.len()} {lines_of(listed)}", "1 W Invalid path in datapack: minecraft:dimension_type/Upper.json, ignoring|")
}

// A pack in a folder: each folder in data/ a namespace, and each regular file in one a file,
// with vanilla's warnings for what can't be.
fn folders() {
    let root = temp_dir()!
    let sep = separator()
    let pack_dir = "{root}{sep}p"
    for dir in ["data/minecraft/dimension_type/sub", "data/Bad", "over/data/minecraft/dimension_type"] {
        make_dir_all("{pack_dir}/{dir}")!
    }
    let written: List<File> = [
        file("data/minecraft/dimension_type/a.json", "a"),
        file("data/minecraft/dimension_type/sub/b.json", "b"),
        file("data/minecraft/dimension_type/Upper.json", "upper"),
        file("data/stray.txt", "stray"),
        file("over/data/minecraft/dimension_type/a.json", "over a"),
    ]
    for f in written {
        write("{pack_dir}/{f.name}", f.text.to_bytes())!
    }
    let roots: List<String> = ["{pack_dir}{sep}over", pack_dir.copy()]
    let p = Pack.folder(String("file/p"), roots, none, [])
    let archives = List<Zip>()
    let packs: List<Pack> = [p]
    var logs = List<Entry>()
    let r = Resources.new(archives, packs, mut logs)
    // Java lists data/ as Bad, minecraft, stray.txt, by bytes and on Windows uppercased alike.
    let data = "{pack_dir}{sep}data"
    let bad = "W Non [a-z0-9_.-] character in namespace Bad in pack directory {data}, ignoring|"
    let stray = "W Non-directory entry {data}{sep}stray.txt found in namespace directory, rejecting|"
    check(lines_of(logs), "{bad}{stray}{bad}{stray}")
    var listed = List<Entry>()
    var got = String()
    for f in r.list(String("dimension_type"), String(".json"), mut listed) {
        got.push_str("{f.id.to_string()}={text(r.read(f)!)},")
    }
    check(got, "minecraft:dimension_type/a.json=over a,minecraft:dimension_type/sub/b.json=b,")
    check(lines_of(listed), "E Invalid path in pack: minecraft:dimension_type/Upper.json, ignoring|")
    remove_dir_all(root)!
}

fn registry_named(r: Registries, name: String) -> Registry {
    for x in r.synced {
        if x.name.path == name {
            return x.copy()
        }
    }
    for x in r.builtin {
        if x.name.path == name {
            return x.copy()
        }
    }
    panic("no registry {name}")
}

// The tag's entries by name, or `none` if it wasn't built.
fn tag(r: Registry, name: String) -> String {
    for t in r.tags {
        if t.name.path == name {
            var out = String()
            for v in t.values {
                if not out.is_empty() {
                    out.push_str(" ")
                }
                out.push_str(r.entries[usize.wrap(v)].path)
            }
            return "[{out}]"
        }
    }
    return String("none")
}

fn tags() {
    let base = plus(variants(), [
        file("data/minecraft/dimension_type/overworld.json", dimension("#minecraft:t3")),
        file("data/minecraft/tags/dimension_type/all.json", "\{\"values\":[\"overworld\"]\}"),
        file("data/minecraft/tags/block/t1.json", "\{\"values\":[\"stone\",\"#minecraft:t2\"]\}"),
        file("data/minecraft/tags/block/t2.json", "\{\"values\":[\"dirt\",\{\"id\":\"minecraft:nope\",\"required\":false\},\{\"id\":\"#minecraft:absent\",\"required\":false\}]\}"),
        file("data/minecraft/tags/block/t3.json", "\{\"values\":[\"stone\"]\}"),
        file("data/minecraft/tags/block/t4.json", "\{\"values\":[\"minecraft:nope\",\"#minecraft:absent\",\"granite\"]\}"),
        file("data/minecraft/tags/block/t5.json", "not json"),
        file("data/minecraft/tags/block/t6.json", "\{\"values\":3\}"),
        file("data/minecraft/tags/block/t7.json", "\{\"values\":[\"stone\",\"stone\",\"#t1\"]\}"),
        file("data/minecraft/tags/block/c1.json", "\{\"values\":[\"#c2\"]\}"),
        file("data/minecraft/tags/block/c2.json", "\{\"values\":[\"#c1\"]\}"),
    ])
    let top: List<File> = [
        file("data/minecraft/tags/block/t1.json", "\{\"values\":[\"granite\"]\}"),
        file("data/minecraft/tags/block/t3.json", "\{\"replace\":true,\"values\":[\"dirt\"]\}"),
    ]
    var logs = List<Entry>()
    let r = load_registries(opened([made("base", base), made("top", top)]), none, mut logs)!
    let blocks = registry_named(r, String("block"))
    // A later pack's file adds to a tag, unless it replaces it; a tag's tags go in where they're
    // listed, and each entry once.
    check(tag(blocks, String("t1")), "[stone dirt granite]")
    check(tag(blocks, String("t2")), "[dirt]")
    check(tag(blocks, String("t3")), "[dirt]")
    check(tag(blocks, String("t7")), "[stone dirt granite]")
    // A tag missing what it needs isn't built, nor one a cycle needs; a file that's JSON but not
    // a tag file leaves an empty tag.
    check(tag(blocks, String("t4")), "none")
    check(tag(blocks, String("t5")), "none")
    check(tag(blocks, String("t6")), "[]")
    check("{tag(blocks, String("c1"))} {tag(blocks, String("c2"))}", "none none")
    let dims = registry_named(r, String("dimension_type"))
    check("{dims.entries.len()} {dims.entries[0].to_string()} {tag(dims, String("all"))}", "1 minecraft:overworld [overworld]")
    var lines = List<String>()
    for e in logs {
        lines.push(e.message.copy())
    }
    lines.sort()
    check("{lines.len()}", "5")
    check(lines[0], "Couldn't load tag minecraft:c1 as it is missing following references: #minecraft:c2 (from base)")
    check(lines[1], "Couldn't load tag minecraft:c2 as it is missing following references: #minecraft:c1 (from base)")
    check(lines[2], "Couldn't load tag minecraft:t4 as it is missing following references: minecraft:nope (from base), #minecraft:absent (from base)")
    check(lines[3], "Couldn't read tag list minecraft:t5 from minecraft:tags/block/t5.json in data pack base")
    check(lines[4], "Couldn't read tag list minecraft:t6 from minecraft:tags/block/t6.json in data pack base")
}

// A dimension type whose blocks that burn forever are `infiniburn`.
fn dimension(infiniburn: str) -> str {
    if infiniburn == "#minecraft:t3" {
        return "\{\"has_skylight\":true,\"has_ceiling\":false,\"has_ender_dragon_fight\":false,\"coordinate_scale\":1,\"min_y\":0,\"height\":256,\"logical_height\":256,\"infiniburn\":\"#minecraft:t3\",\"ambient_light\":0,\"monster_spawn_light_level\":0,\"monster_spawn_block_light_limit\":0\}"
    }
    return "\{\"has_skylight\":true,\"has_ceiling\":false,\"has_ender_dragon_fight\":false,\"coordinate_scale\":1,\"min_y\":0,\"height\":256,\"logical_height\":256,\"infiniburn\":\"#minecraft:absent\",\"ambient_light\":0,\"monster_spawn_light_level\":0,\"monster_spawn_block_light_limit\":0,\"timelines\":\"#minecraft:missing\"\}"
}

fn plus(a: List<File>, b: List<File>) -> List<File> {
    var out = a.copy()
    for f in b {
        out.push(f.copy())
    }
    return out
}

// One entry in each registry that must have some, as small as their codecs let it be.
fn variants() -> List<File> {
    let one = "\{\"asset_id\":\"a\"\}"
    let both = "\{\"asset_id\":\"a\",\"baby_asset_id\":\"b\"\}"
    let wolf = "\{\"assets\":\{\"wild\":\"a\",\"tame\":\"a\",\"angry\":\"a\"\},\"baby_assets\":\{\"wild\":\"a\",\"tame\":\"a\",\"angry\":\"a\"\}\}"
    return [
        file("data/minecraft/frog_variant/a.json", one),
        file("data/minecraft/zombie_nautilus_variant/a.json", one),
        file("data/minecraft/cat_variant/a.json", both),
        file("data/minecraft/cow_variant/a.json", both),
        file("data/minecraft/chicken_variant/a.json", both),
        file("data/minecraft/pig_variant/a.json", both),
        file("data/minecraft/wolf_variant/a.json", wolf),
        file("data/minecraft/painting_variant/a.json", "\{\"asset_id\":\"a\",\"width\":1,\"height\":1\}"),
        entry("wolf_sound_variant", grown(sounds(["ambient", "death", "growl", "hurt", "pant", "whine", "step"]))),
        entry("pig_sound_variant", grown(sounds(["ambient", "hurt", "death", "step", "eat"]))),
        entry("cat_sound_variant", grown(sounds(["ambient", "stray_ambient", "hiss", "hurt", "death", "eat", "beg_for_food", "purr", "purreow"]))),
        entry("chicken_sound_variant", grown(sounds(["ambient", "hurt", "death", "step"]))),
        entry("cow_sound_variant", sounds(["ambient", "hurt", "death", "step"])),
    ]
}

// The entry `a` of the registry `name`.
fn entry(name: str, json: own String) -> File {
    return File { name: "data/minecraft/{name}/a.json", text: json, deflate: true }
}

// A sound variant's sounds, each stone's being stepped on.
fn sounds(names: List<str>) -> String {
    var out = String("\{")
    for i in 0..names.len() {
        if i > 0 {
            out.push_str(",")
        }
        out.push_str("\"{names[i]}_sound\":\"block.stone.step\"")
    }
    out.push_str("\}")
    return out
}

// The same sounds for adults and young.
fn grown(set: String) -> String {
    return "\{\"adult_sounds\":{set},\"baby_sounds\":{set}\}"
}

// The registries load as vanilla's `RegistryDataLoader.load` loads them: each entry read with its
// network codec, which the server keeps to send, and what stops it all logged at once.
fn loads() {
    var logs = List<Entry>()
    let r = load_registries(opened([made("base", plus(variants(), [file("data/minecraft/tags/block/t3.json", "\{\"values\":[\"stone\"]\}"), file("data/minecraft/dimension_type/overworld.json", dimension("#minecraft:t3"))]))]), none, mut logs)!
    check("{logs.len()}", "0")
    let dims = registry_named(r, String("dimension_type"))
    check("{dims.contents.len()} {dims.contents[0][0]}", "1 10")

    // An entry that isn't JSON, or isn't what its codec reads, or names a built-in tag that isn't
    // there, and a tag or an entry that's named but never comes, as one that can't be read never
    // does, unless what names it can do without it.
    let broken: List<File> = [
        file("data/minecraft/dimension_type/a.json", "not json"),
        file("data/minecraft/dimension_type/b.json", dimension("")),
        file("data/minecraft/painting_variant/b.json", "\{\"asset_id\":\"a\",\"width\":1\}"),
        file("data/minecraft/tags/dimension_type/all.json", "\{\"values\":[\"minecraft:gone\"]\}"),
        file("data/minecraft/tags/painting_variant/p.json", "\{\"values\":[\"minecraft:b\"]\}"),
        file("data/minecraft/tags/painting_variant/q.json", "\{\"values\":[\{\"id\":\"minecraft:b\",\"required\":false\}]\}"),
    ]
    var bad = List<Entry>()
    check("{load_registries(opened([made("base", broken)]), none, mut bad) == none}", "true")
    check("{bad.len()}", "1")
    let failed = "java.lang.IllegalStateException: Failed to parse"
    check(bad[0].message, "Registry loading errors:\n> Errors in registry minecraft:dimension_type:\n>> Errors in element minecraft:a:\n{failed} minecraft:a from pack base\nCaused by: com.google.gson.JsonSyntaxException\n>> Errors in element minecraft:b:\n{failed} minecraft:b from pack base\nCaused by: java.lang.IllegalStateException: Missing tag: 'minecraft:absent' in 'minecraft:block'\n> Errors in registry minecraft:painting_variant:\n>> Errors in element minecraft:b:\n{failed} minecraft:b from pack base\nCaused by: java.lang.IllegalStateException: No key height in MapLike[\{\"asset_id\":\"a\",\"width\":1\}]\n> Errors in registry minecraft:root:\n>> Errors in element minecraft:dimension_type:\njava.lang.IllegalStateException: Unbound values in registry ResourceKey[minecraft:root / minecraft:dimension_type]: [minecraft:gone]\n>> Errors in element minecraft:painting_variant:\njava.lang.IllegalStateException: Unbound values in registry ResourceKey[minecraft:root / minecraft:painting_variant]: [minecraft:b]\n>> Errors in element minecraft:timeline:\njava.lang.IllegalStateException: Unbound tags in registry ResourceKey[minecraft:root / minecraft:timeline]: [minecraft:missing]\n")

    // Once they've loaded, a registry of mob variants with none, and a time marker of a clock two
    // timelines define.
    let markers: List<File> = [
        file("data/minecraft/world_clock/day.json", "\{\}"),
        file("data/minecraft/timeline/a.json", "\{\"clock\":\"minecraft:day\",\"time_markers\":\{\"m\":\{\"ticks\":0\}\}\}"),
        file("data/minecraft/timeline/b.json", "\{\"clock\":\"minecraft:day\",\"time_markers\":\{\"m\":\{\"ticks\":1\}\}\}"),
    ]
    var invalid = List<Entry>()
    var some_variants = variants()
    _ = some_variants.pop()
    check("{load_registries(opened([made("base", plus(some_variants, markers))]), none, mut invalid) == none}", "true")
    check("{invalid.len()}", "1")
    check(invalid[0].message, "Registry loading errors:\n> Errors in registry minecraft:root:\n>> Errors in element minecraft:cow_sound_variant:\njava.lang.IllegalStateException: Registry must be non-empty: minecraft:cow_sound_variant\n> Errors in registry minecraft:timeline:\n>> Errors in element minecraft:b:\njava.lang.IllegalStateException: ResourceKey[minecraft:clock_time_marker / minecraft:m] was defined multiple times in minecraft:day\n")
}

fn identifiers() {
    // Vanilla's `hashCode`, which orders its hash maps of identifiers.
    let id = Identifier { namespace: "minecraft", path: "stone" }
    check("{id.java_hash()}", "{31 * String("minecraft").java_hash() + String("stone").java_hash()}")
}

fn main() {
    zips()
    walks()
    listing()
    overlays()
    filters()
    zip_warnings()
    folders()
    loads()
    tags()
    identifiers()
    println("ok")
}
