/// Checks where a nether portal takes what goes into it (D577): the largest rectangle of portal
/// blocks about one, as `BlockUtil.getLargestRectangleAround` and `getMaxRectangleLocation` find
/// it; where in it an entity is, `PortalShape.getRelativePosition`, and where it comes out of
/// another, `createDimensionTransition`; a place there the blocks leave room for,
/// `findCollisionFreePosition`; the columns `spiralAround` goes through; and where
/// `createPortal` builds a portal: on the ground at its origin, the column after it where the
/// origin's chunk wasn't there, as `getHeight` has it, nearer a wall it can't, and on a floor of
/// its own where there's no room. And how what isn't a player goes through one (D578): in it, on
/// its cooldown, out of it, and taken out of its level, `Body`'s portal.
module test.portal

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.body.{Body, PORTAL_DELAY, PROJECTILE_PORTAL_DELAY}
import world.chunk.{BlockStates}
import world.collision.{CollisionBlocks}
import world.movement.{MovementStates, Mover}
import world.portal.{Heights, PortalLevel, Rect, chunk_key, exit_target, free_position, largest_rectangle, max_rectangle_location, portal_site, relative_position, spiral}
import worldgen.facts.{Facts}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn near(got: f64, want: f64, what: str) {
    if (got - want).abs() > 1.0e-6 {
        panic("{what}: got {got}, want {want}")
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn state(f: Facts, name: str) -> u32 {
    let block = f.block_named(String(name)) else panic("no block {name}")
    return f.default_state(block)
}

// A world of blocks: stone at `ground` and below, air above, but for the blocks placed.
struct World {
    stone: u32
    ground: i32
    placed: Map<i64, u32>
}

fn key(x: i32, y: i32, z: i32) -> i64 {
    return (i64(x) & 0xFFFFF) << 40 | (i64(y) & 0xFFFFF) << 20 | (i64(z) & 0xFFFFF)
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        let k = key(x, y, z)
        if self.placed.contains(k) {
            return some(self.placed[k])
        }
        if y <= self.ground {
            return some(self.stone)
        }
        return some(0)
    }
}

impl PortalLevel for World {
    fn portal_state(self, x: i32, y: i32, z: i32) -> u32 {
        return self.collision_state(x, y, z) ?? 0
    }

    // One above the ground, or the highest block placed over it.
    fn motion_height(self, x: i32, z: i32) -> i32 {
        var top = self.ground
        for y in self.ground + 1..self.ground + 40 {
            if self.placed.contains(key(x, y, z)) and self.placed[key(x, y, z)] != 0u32 {
                top = y
            }
        }
        return top + 1
    }
}

fn rect(r: Rect) -> String {
    return "{r.x} {r.y} {r.z} {r.width}x{r.height}"
}

const WIDE: (f64, f64, f64, f64) = (-1000.0, -1000.0, 1000.0, 1000.0)

// The columns of chunks within 2 of the middle's.
fn all_known() -> Set<i64> {
    var known = Set<i64>()
    for x in -2..3 {
        for z in -2..3 {
            known.insert(chunk_key(x * 16, z * 16))
        }
    }
    return known
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    let stone = state(f, "stone")
    let portal = state(f, "nether_portal")
    // The largest rectangle under heights, the first of the largest.
    check("{max_rectangle_location([2, 1, 2])}", "(0, 2, 1)")
    check("{max_rectangle_location([3, 3])}", "(0, 1, 3)")
    check("{max_rectangle_location([1, 3, 3, 1])}", "(1, 2, 3)")
    // A portal two wide and three high, from any of its blocks.
    var w = World { stone: stone, ground: 0, placed: Map<i64, u32>() }
    for x in 0..2 {
        for y in 1..4 {
            w.placed.insert(key(x, y, 0), portal)
        }
    }
    check(rect(largest_rectangle(w, 0, 1, 0, true, 21, 21, portal)), "0 1 0 2x3")
    check(rect(largest_rectangle(w, 1, 3, 0, true, 21, 21, portal)), "0 1 0 2x3")
    // A column more, a block high: the two by three still from the first; from the new one, the
    // three by one, as each column reaches no higher than the one before it from there.
    w.placed.insert(key(2, 1, 0), portal)
    check(rect(largest_rectangle(w, 0, 1, 0, true, 21, 21, portal)), "0 1 0 2x3")
    check(rect(largest_rectangle(w, 2, 1, 0, true, 21, 21, portal)), "0 1 0 3x1")
    // Along z, nothing's there but the block itself.
    check(rect(largest_rectangle(w, 1, 2, 0, false, 21, 21, portal)), "1 1 0 1x3")
    // Where a player stands in the middle of it, its foot, and where they come out of another.
    let r = Rect { x: 0, y: 1, z: 0, width: 2, height: 3 }
    let (rx, ry, rz) = relative_position(r, true, 1.0, 1.0, 0.5, 0.6f32, 1.8f32)
    near(rx, 0.5, "right")
    near(ry, 0.0, "up")
    near(rz, 0.0, "forward")
    let (ex, ey, ez) = exit_target(Rect { x: 10, y: 64, z: 20, width: 2, height: 3 }, true, (rx, ry, rz), 0.6f32, 1.8f32)
    near(ex, 11.0, "x")
    near(ey, 64.0, "y")
    near(ez, 20.5, "z")
    let (zx, _, zz) = exit_target(Rect { x: 10, y: 64, z: 20, width: 2, height: 3 }, false, (rx, ry, rz), 0.6f32, 1.8f32)
    near(zx, 10.5, "x along z")
    near(zz, 21.0, "z along z")
    // Its west edge, high up: the most to the left, the top it can be.
    let (lx, ly, _) = relative_position(r, true, 0.0, 9.0, 0.5, 0.6f32, 1.8f32)
    near(lx, 0.0, "left")
    near(ly, 1.0, "top")
    // In the open, where it's aimed; in stone, on top of it.
    var open = World { stone: stone, ground: 0, placed: Map<i64, u32>() }
    let mover = Mover { y: 1.0, fall: 0.0 }
    let (fx, fy, fz) = free_position(f, m, open, WIDE, (0.5, 1.0, 0.5), 0.6f32, 1.8f32, mover)
    near(fx, 0.5, "free x")
    near(fy, 1.0, "free y")
    near(fz, 0.5, "free z")
    open.placed.insert(key(0, 1, 0), stone)
    let (_, sy, _) = free_position(f, m, open, WIDE, (0.5, 1.0, 0.5), 0.6f32, 1.8f32, mover)
    near(sy, 2.0, "over stone")
    // A wall to the east: pushed west of it.
    var walled = World { stone: stone, ground: 0, placed: Map<i64, u32>() }
    walled.placed.insert(key(1, 1, 0), stone)
    walled.placed.insert(key(1, 2, 0), stone)
    let (wx, wy, _) = free_position(f, m, walled, WIDE, (0.9, 1.0, 0.5), 0.6f32, 1.8f32, mover)
    near(wx, 0.7, "west of the wall")
    near(wy, 1.0, "on the ground")
    // The spiral: every column within 16, once, from the middle out.
    let s = spiral(0, 0, 16)
    check("{s.len()}", "1089")
    var seen = Set<i64>()
    for (x, z) in s {
        if x < -16 or x > 16 or z < -16 or z > 16 {
            panic("{x} {z} is outside")
        }
        seen.insert(key(x, 0, z))
    }
    check("{seen.len()}", "1089")
    check("{s[0]} {s[1]} {s[2]} {s[3]} {s[4]} {s[9]}", "(0, 0) (1, 0) (1, 1) (0, 1) (-1, 1) (2, -1)")
    check("{s[s.len() - 1]}", "(16, -16)")
    let heights = Heights { min_y: -64, height: 384, logical: 384 }
    // On the ground at the origin, where its chunk's there.
    let flat = World { stone: stone, ground: 0, placed: Map<i64, u32>() }
    var known = all_known()
    let at = portal_site(f, flat, mut known, (0, 1, 0), true, WIDE, heights) else panic("no site")
    check("{at.x} {at.y} {at.z} {at.platform}", "0 1 0 false")
    // Its chunk not there: its column's read at the bottom, which loads it, and the next's taken.
    var none_known = Set<i64>()
    let next = portal_site(f, flat, mut none_known, (0, 1, 0), true, WIDE, heights) else panic("no site")
    check("{next.x} {next.y} {next.z} {next.platform}", "1 1 0 false")
    // Stone all the way up: a floor made for it, a block west, at 70.
    let solid = World { stone: stone, ground: 400, placed: Map<i64, u32>() }
    var solid_known = all_known()
    let made = portal_site(f, solid, mut solid_known, (0, 1, 0), true, WIDE, heights) else panic("no site")
    check("{made.x} {made.y} {made.z} {made.platform}", "-1 70 0 true")
    // Along z, a block north.
    let made_z = portal_site(f, solid, mut solid_known, (0, 100, 0), false, WIDE, heights) else panic("no site")
    check("{made_z.x} {made_z.y} {made_z.z} {made_z.platform}", "0 100 -1 true")
    // What isn't a player in a portal (D578): it goes the tick after it went in, its cooldown
    // set; on that a portal sets it again, a projectile's 2, and doesn't take it in; out of one,
    // its time goes 4 a tick, to none, which lets it go.
    var b = Body.made(1, 0i64, 0.5, 1.0, 0.5, 0.25f32, 0.25f32, 0.2125f32, 0.04)
    b.inside_portal(0, 1, 0, PORTAL_DELAY)
    let p = b.portal_goes(true, PORTAL_DELAY) else panic("it didn't go")
    check("{p.x} {p.y} {p.z} {p.time} {p.inside} {b.portal_cooldown}", "0 1 0 1 false 300")
    b.inside_portal(1, 2, 0, PROJECTILE_PORTAL_DELAY)
    check("{b.portal_cooldown}", "2")
    if let _ = b.portal_goes(true, PORTAL_DELAY) {
        panic("it went on its cooldown")
    }
    if let _ = b.portal_process {
        panic("its portal outlasted its time")
    }
    // Where it may not go through, it doesn't go, and its portal, with no time in it, goes,
    // `hasExpired`.
    b.portal_cooldown = 0
    b.inside_portal(0, 1, 0, PORTAL_DELAY)
    if let _ = b.portal_goes(false, PORTAL_DELAY) {
        panic("it went where it may not")
    }
    if let _ = b.portal_process {
        panic("its portal outlasted its time")
    }
    // Its way takes it out of its level where its level's portals may take it, else not.
    let way = b.travel(p, Tag.End)
    check("{way.goes} {b.removed} {b.moved_away} {way.x} {way.y}", "true true true 0.5 1.0")
    var shut = Body.made(2, 0i64, 0.5, 1.0, 0.5, 0.25f32, 0.25f32, 0.2125f32, 0.04)
    shut.portal_open = false
    let held = shut.travel(p, Tag.End)
    check("{held.goes} {shut.removed}", "false false")
    println("ok")
}
