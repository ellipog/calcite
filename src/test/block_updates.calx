/// Checks the server's level telling the blocks around a block set, as vanilla's
/// `CollectingNeighborUpdater` tells them (D326), with block facts made from the built-in block
/// and fluid registries: lava set beside water turned to obsidian, or cobblestone if it's
/// flowing, with a fizz, and the water's tick scheduled once; a poppy broken as the grass under
/// it goes, with what its players see and what it would drop reported; a chest set and taken
/// away with nothing reported, its block entity made and taken away in the level and the
/// comparators around told as it goes; and a chain past
/// `max-chained-neighbor-updates` cut short, with vanilla's error. And what blocks do as a player
/// breaks them, `playerDestroy` (CAL-156): a turtle egg one fewer, ice melting, and a beehive's
/// bees reported.
module test.block_updates

import nbt.snbt.{parse}
import random.taped.{TapedRandom}
import server.level.{Heard}
import world.digging.{player_destroy}

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry, Tag}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{AIR_STATE, BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts, LAVA_FLUID, WATER_FLUID}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

// The block facts, from the built-in block and fluid registries (4 and 2), with the fluid tags
// water and lava, and grass and dirt holding up plants, as vanilla's data has them.
fn facts() -> Facts {
    var blocks = Registry.new(full("block"), false)
    for e in builtin_entries(4) {
        blocks.add(full(e), none)
    }
    blocks.tags.push(Tag { name: full("supports_vegetation"), values: [8, 9] })
    var fluids = Registry.new(full("fluid"), false)
    for e in builtin_entries(2) {
        fluids.add(full(e), none)
    }
    fluids.tags.push(Tag { name: full("water"), values: [1, 2] })
    fluids.tags.push(Tag { name: full("lava"), values: [3, 4] })
    return match Facts.new(blocks, fluids, BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// The block facts with the grass block in `#ice_melts_when_destroyed_above`, as vanilla's
// `#blocks_motion` puts it there.
fn ice_facts() -> Facts {
    var blocks = Registry.new(full("block"), false)
    var grass = 0
    let entries = builtin_entries(4)
    for i in 0..entries.len() {
        blocks.add(full(entries[i].copy()), none)
        if entries[i] == "grass_block" or entries[i] == "minecraft:grass_block" {
            grass = i32.wrap(i)
        }
    }
    blocks.tags.push(Tag { name: full("ice_melts_when_destroyed_above"), values: [grass] })
    var fluids = Registry.new(full("fluid"), false)
    for e in builtin_entries(2) {
        fluids.add(full(e), none)
    }
    fluids.tags.push(Tag { name: full("water"), values: [1, 2] })
    fluids.tags.push(Tag { name: full("lava"), values: [3, 4] })
    return match Facts.new(blocks, fluids, BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// A flat level, its spawn's chunks full and given the facts, as the server's are once natural
// spawning's are made.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn has_line(level: mut Level, text: str) -> bool {
    var found = false
    for e in level.take_lines() {
        if e.message.contains(text) {
            found = true
        }
    }
    return found
}

// Lava set beside water: `onPlace`'s `shouldSpreadLiquid` turns it to obsidian, or cobblestone
// if it's flowing, with a fizz, and it has no tick; the water's tick, scheduled as it was set,
// isn't scheduled twice as the obsidian beside it tells it.
fn lava_meets_water() {
    let f = facts()
    var level = flat_level(f)
    check(level.set_block(4, -60, 4, f.ids.water_state, UPDATE_ALL), "the water wasn't set")
    check(level.has_fluid_tick(WATER_FLUID, 4, -60, 4), "the water has no tick")
    check(level.set_block(5, -60, 4, f.ids.lava_state, UPDATE_ALL), "the lava wasn't set")
    check(level.spawn_state(5, -60, 4) == named(f, "obsidian"), "the lava beside the water isn't obsidian")
    check(not level.has_fluid_tick(LAVA_FLUID, 5, -60, 4), "the lava turned to obsidian has a tick")
    let (_, fluids) = level.tick_count()
    check(fluids == 1, "the water's tick is scheduled more than once")
    let flowing = match f.with_int(f.ids.lava_state, String("level"), 2) {
        ok(s) => s,
        err(_) => panic("lava has no level"),
    }
    check(level.set_block(4, -60, 5, flowing, UPDATE_ALL), "the flowing lava wasn't set")
    check(level.spawn_state(4, -60, 5) == named(f, "cobblestone"), "the flowing lava beside the water isn't cobblestone")
    let events = level.take_events()
    check(events.len() == 2, "a fizz for each")
    check(events[0].kind == 1501 and events[0].x == 5 and events[0].y == -60 and events[0].z == 4 and events[0].data == 0, "the obsidian's fizz")
    check(events[1].kind == 1501 and events[1].x == 4 and events[1].z == 5, "the cobblestone's fizz")
    println("ok lava_meets_water")
}

// A poppy on grass: the grass set to air, the poppy's shape update finds it can't stay, and it's
// broken, `BLOCK_BROKEN` with its state for its players, and left as air; what it drops is
// reported, once.
fn poppy_broken() {
    let f = facts()
    var level = flat_level(f)
    let poppy = named(f, "poppy")
    check(level.set_block(8, -60, 8, poppy, UPDATE_ALL), "the poppy wasn't set")
    check(level.spawn_state(8, -60, 8) == poppy, "the poppy on grass broke")
    check(level.set_block(8, -61, 8, AIR_STATE, UPDATE_ALL), "the grass wasn't taken away")
    check(level.spawn_state(8, -60, 8) == AIR_STATE, "the poppy stayed with nothing under it")
    let events = level.take_events()
    check(events.len() == 1 and events[0].kind == 2001 and events[0].x == 8 and events[0].y == -60 and events[0].data == i32.wrap(poppy), "the poppy broken, for its players")
    check(has_line(mut level, "What a broken block drops isn't in Calcite yet"), "what the poppy drops wasn't reported")
    println("ok poppy_broken")
}

// A chest set and taken away: its block entity made and then taken away in the level (CAL-115),
// and, with no comparator by it, no one told as it goes, `updateNeighbourForOutputSignal`; nothing
// reported.
fn chest_quiet() {
    let f = facts()
    var level = flat_level(f)
    let chest = named(f, "chest")
    check(level.set_block(2, -60, 2, chest, UPDATE_ALL), "the chest wasn't set")
    check(level.set_block(2, -60, 2, AIR_STATE, UPDATE_ALL), "the chest wasn't taken away")
    check(level.set_block(3, -60, 2, chest, UPDATE_ALL), "the second chest wasn't set")
    check(not has_line(mut level, "isn't in Calcite yet"), "a chest set and taken away reported what Calcite hasn't")
    println("ok chest_quiet")
}

// With `max-chained-neighbor-updates` at 0, every update is cut short, with vanilla's error at
// the first; so the poppy stays as the grass goes.
fn chain_cut_short() {
    let f = facts()
    var level = flat_level(f)
    level.max_chained = 0
    let poppy = named(f, "poppy")
    check(level.set_block(8, -60, 8, poppy, UPDATE_ALL), "the poppy wasn't set")
    check(has_line(mut level, "Too many chained neighbor updates. Skipping the rest. First skipped position: 8, -60, 8"), "no error for the chain cut short")
    check(level.set_block(8, -61, 8, AIR_STATE, UPDATE_ALL), "the grass wasn't taken away")
    check(level.spawn_state(8, -60, 8) == poppy, "the poppy broke though its shape update was cut")
    println("ok chain_cut_short")
}

// What a player breaking a block leaves (CAL-156), each first set and then taken away as the
// break takes it, with the level's random seeded 0: a turtle egg of three is set back with two,
// after its break's sound, pitched 0.9 and a fifth of the random's float, then its break shown
// as it was; one of one leaves air after its sound. Ice over grass, of
// `#ice_melts_when_destroyed_above`, melts into water, and so over that water; over air, or broken
// with silk touch, it doesn't. A beehive with bees reports that they're not let out yet, and one
// without, or broken with silk touch, reports nothing.
fn destroyed() {
    let f = ice_facts()
    var level = flat_level(f)
    let e = Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 }
    level.set_random(TapedRandom.new(0))
    var mirror = TapedRandom.new(0)
    let three = match f.with_int(named(f, "turtle_egg"), String("eggs"), 3) {
        ok(s) => s,
        err(_) => panic("a turtle egg has no eggs"),
    }
    check(level.set_block(6, -60, 6, three, UPDATE_ALL) and level.set_block(6, -60, 6, AIR_STATE, UPDATE_ALL), "the eggs weren't set and broken")
    _ = level.take_heard()
    match player_destroy(e, mut level, three, 6, -60, 6, none, false, false) {
        ok => {},
        err(t) => panic("the eggs: {t.message}"),
    }
    let two = match f.with_int(three, String("eggs"), 2) {
        ok(s) => s,
        err(_) => panic("a turtle egg has no eggs"),
    }
    check(level.spawn_state(6, -60, 6) == two, "a turtle egg of three wasn't set back with two")
    let heard = level.take_heard()
    let pitch = 0.9f32 + mirror.next_float() * 0.2f32
    check(heard.len() == 2, "a turtle egg's break heard other than once and shown once")
    let Heard.Sound(s) = heard[0].copy() else panic("a turtle egg's break first isn't its sound")
    check(s.sound == "entity.turtle.egg_break" and s.volume == 0.7f32 and s.pitch == pitch and s.x == 6.5 and s.y == -59.5, "a turtle egg's break sound")
    let Heard.Event(ev) = heard[1].copy() else panic("a turtle egg's break then isn't shown")
    check(ev.kind == 2001 and ev.x == 6 and ev.data == i32.wrap(three), "a turtle egg's break shown as it was")
    let one = named(f, "turtle_egg")
    match player_destroy(e, mut level, one, 6, -60, 7, none, false, false) {
        ok => {},
        err(t) => panic("the egg: {t.message}"),
    }
    _ = mirror.next_float()
    check(level.spawn_state(6, -60, 7) == AIR_STATE and level.take_heard().len() == 1 and level.next_long() == mirror.next_long(), "a turtle egg of one")
    let ice = named(f, "ice")
    for (x, y, keeps, melts) in [(8, -60, false, true), (8, -59, false, true), (10, -59, false, false), (12, -60, true, false)] {
        match player_destroy(e, mut level, ice, x, y, 8, none, keeps, false) {
            ok => {},
            err(t) => panic("the ice: {t.message}"),
        }
        let left = level.spawn_state(x, y, 8)
        check(if melts { left == f.ids.water_state } else { left == AIR_STATE }, "ice broken melted or didn't other than vanilla's")
    }
    let hive = named(f, "beehive")
    let full_hive = parse(String("\{id:\"minecraft:beehive\",bees:[\{entity_data:\{id:\"minecraft:bee\"\},min_ticks_in_hive:600,ticks_in_hive:0\}]\}"))!
    let empty_hive = parse(String("\{id:\"minecraft:beehive\",bees:[]\}"))!
    _ = level.take_lines()
    for (be, keeps, reported) in [(empty_hive.copy(), false, false), (full_hive.copy(), true, false), (full_hive.copy(), false, true)] {
        match player_destroy(e, mut level, hive, 14, -60, 8, some(be.copy()), false, keeps) {
            ok => {},
            err(t) => panic("the beehive: {t.message}"),
        }
        check(has_line(mut level, "Bees let out of a beehive a player breaks") == reported, "a beehive's bees reported other than as they come out")
    }
    println("ok destroyed")
}

fn main() {
    lava_meets_water()
    poppy_broken()
    chest_quiet()
    chain_cut_short()
    destroyed()
    println("ok")
}
