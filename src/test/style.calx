/// Checks styled components in JSON and NBT, and read back from both. Each expected text is what
/// vanilla 26.3's `ComponentSerialization.CODEC` gives for the same component, with `JsonOps` and
/// with `NbtOps`, whose compounds print with their keys sorted.
module test.style

import chat.component.{Component, Style, TextColor, ClickEvent, HoverEvent, EntityTooltip}
import java.uuid.{Uuid}
import json.tree.{parse}
import nbt.tag.{Tag}
import nbt.snbt.{parse as parse_snbt}
import resources.identifier.{Identifier}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn id(text: String) -> Identifier {
    return Identifier.parse(text)!
}

// The component in both forms, and both read back.
fn both(c: Component, json: String, snbt: String) {
    check(c.to_json(), json)
    check(c.to_nbt().to_snbt(), snbt)
    let from_json = Component.from_json(parse(json)!)!
    check(from_json.to_json(), json)
    let from_nbt = Component.from_nbt(parse_snbt(snbt)!)!
    check(from_nbt.to_nbt().to_snbt(), snbt)
}

// A player's name as `Player.getDisplayName` styles it.
fn name() -> Component {
    let uuid = Uuid.parse("069a79f4-44e9-4726-a5be-fca90e38aaf5")!
    let tooltip = EntityTooltip { kind: id("minecraft:player"), uuid: uuid, name: some(Box(Component.literal("Notch"))) }
    return Component.literal("Notch").styled(Style { click_event: some(ClickEvent.SuggestCommand("/tell Notch ")), hover_event: some(HoverEvent.ShowEntity(tooltip)), insertion: some("Notch") })
}

fn main() {
    both(name(),
         "\{\"text\":\"Notch\",\"click_event\":\{\"command\":\"/tell Notch \",\"action\":\"suggest_command\"\},\"hover_event\":\{\"id\":\"minecraft:player\",\"uuid\":[110787060,1156138790,-1514210135,238594805],\"name\":\"Notch\",\"action\":\"show_entity\"\},\"insertion\":\"Notch\"\}",
         "\{click_event:\{action:\"suggest_command\",command:\"/tell Notch \"\},hover_event:\{action:\"show_entity\",id:\"minecraft:player\",name:\"Notch\",uuid:[I;110787060,1156138790,-1514210135,238594805]\},insertion:\"Notch\",text:\"Notch\"\}")
    both(Component.translatable("multiplayer.player.joined", [name()]).colored("yellow"),
         "\{\"translate\":\"multiplayer.player.joined\",\"with\":[\{\"text\":\"Notch\",\"click_event\":\{\"command\":\"/tell Notch \",\"action\":\"suggest_command\"\},\"hover_event\":\{\"id\":\"minecraft:player\",\"uuid\":[110787060,1156138790,-1514210135,238594805],\"name\":\"Notch\",\"action\":\"show_entity\"\},\"insertion\":\"Notch\"\}],\"color\":\"yellow\"\}",
         "\{color:\"yellow\",translate:\"multiplayer.player.joined\",with:[\{click_event:\{action:\"suggest_command\",command:\"/tell Notch \"\},hover_event:\{action:\"show_entity\",id:\"minecraft:player\",name:\"Notch\",uuid:[I;110787060,1156138790,-1514210135,238594805]\},insertion:\"Notch\",text:\"Notch\"\}]\}")
    let styles = Style { color: some(TextColor.from_rgb(0x12ab34)), shadow_color: some(i32.wrap(0x80ff0000u32)), bold: some(true), italic: some(false), underlined: some(true), strikethrough: some(true), obfuscated: some(false), font: some(id("uniform")) }
    both(Component.literal("x").styled(styles),
         "\{\"text\":\"x\",\"color\":\"#12AB34\",\"shadow_color\":-2130771968,\"bold\":true,\"italic\":false,\"underlined\":true,\"strikethrough\":true,\"obfuscated\":false,\"font\":\"minecraft:uniform\"\}",
         "\{bold:1b,color:\"#12AB34\",font:\"minecraft:uniform\",italic:0b,obfuscated:0b,shadow_color:-2130771968,strikethrough:1b,text:\"x\",underlined:1b\}")
    both(Component.literal("u").styled(Style { click_event: some(ClickEvent.OpenUrl("https://example.com/a?b=c")) }),
         "\{\"text\":\"u\",\"click_event\":\{\"url\":\"https://example.com/a?b=c\",\"action\":\"open_url\"\}\}",
         "\{click_event:\{action:\"open_url\",url:\"https://example.com/a?b=c\"\},text:\"u\"\}")
    let tip = Component.literal("tip").colored("red")
    both(Component.literal("r").styled(Style { click_event: some(ClickEvent.RunCommand("/say hi")), hover_event: some(HoverEvent.ShowText(Box(tip))) }),
         "\{\"text\":\"r\",\"click_event\":\{\"command\":\"/say hi\",\"action\":\"run_command\"\},\"hover_event\":\{\"value\":\{\"text\":\"tip\",\"color\":\"red\"\},\"action\":\"show_text\"\}\}",
         "\{click_event:\{action:\"run_command\",command:\"/say hi\"\},hover_event:\{action:\"show_text\",value:\{color:\"red\",text:\"tip\"\}\},text:\"r\"\}")
    both(Component.literal("p").styled(Style { click_event: some(ClickEvent.ChangePage(3)) }),
         "\{\"text\":\"p\",\"click_event\":\{\"page\":3,\"action\":\"change_page\"\}\}",
         "\{click_event:\{action:\"change_page\",page:3\},text:\"p\"\}")
    both(Component.literal("c").styled(Style { click_event: some(ClickEvent.CopyToClipboard("abc")) }),
         "\{\"text\":\"c\",\"click_event\":\{\"value\":\"abc\",\"action\":\"copy_to_clipboard\"\}\}",
         "\{click_event:\{action:\"copy_to_clipboard\",value:\"abc\"\},text:\"c\"\}")
    both(Component.literal("k").styled(Style { click_event: some(ClickEvent.Custom(id("my:act"), some(Tag.Str("p")))) }),
         "\{\"text\":\"k\",\"click_event\":\{\"id\":\"my:act\",\"payload\":\"p\",\"action\":\"custom\"\}\}",
         "\{click_event:\{action:\"custom\",id:\"my:act\",payload:\"p\"\},text:\"k\"\}")
    both(Component.literal("k").styled(Style { click_event: some(ClickEvent.Custom(id("my:act"), none)) }),
         "\{\"text\":\"k\",\"click_event\":\{\"id\":\"my:act\",\"action\":\"custom\"\}\}",
         "\{click_event:\{action:\"custom\",id:\"my:act\"\},text:\"k\"\}")
    let pig = EntityTooltip { kind: id("pig"), uuid: Uuid.parse("069a79f4-44e9-4726-a5be-fca90e38aaf5")!, name: none }
    both(Component.literal("e").styled(Style { hover_event: some(HoverEvent.ShowEntity(pig)) }),
         "\{\"text\":\"e\",\"hover_event\":\{\"id\":\"minecraft:pig\",\"uuid\":[110787060,1156138790,-1514210135,238594805],\"action\":\"show_entity\"\}\}",
         "\{hover_event:\{action:\"show_entity\",id:\"minecraft:pig\",uuid:[I;110787060,1156138790,-1514210135,238594805]\},text:\"e\"\}")
    var green = Component.literal("a").colored("green")
    green.extra.push(Component.literal("b"))
    both(green, "\{\"text\":\"a\",\"extra\":[\"b\"],\"color\":\"green\"\}", "\{color:\"green\",extra:[\"b\"],text:\"a\"\}")
    both(Component.literal("a").styled(Style { bold: some(true) }), "\{\"text\":\"a\",\"bold\":true\}", "\{bold:1b,text:\"a\"\}")

    // What vanilla's codecs refuse.
    for (text, message) in [("\{\"text\":\"a\",\"color\":\"pink\"\}", "Invalid color name: pink"),
                            ("\{\"text\":\"a\",\"color\":\"#1000000\"\}", "Color value out of range: #1000000"),
                            ("\{\"text\":\"a\",\"color\":\"#xyz\"\}", "Invalid color value: #xyz"),
                            ("\{\"text\":\"a\",\"click_event\":\{\"action\":\"change_page\",\"page\":0\}\}", "Value must be positive: 0"),
                            ("\{\"text\":\"a\",\"click_event\":\{\"action\":\"run_command\",\"command\":\"\u{a7}c\"\}\}", "Disallowed chat character: '\u{a7}'"),
                            ("\{\"text\":\"a\",\"click_event\":\{\"action\":\"open_file\",\"path\":\"x\"\}\}", "Click event type not allowed: OPEN_FILE"),
                            ("\{\"text\":\"a\",\"hover_event\":\{\"action\":\"show_entity\",\"id\":\"nope\",\"uuid\":[1,2,3,4]\}\}", "Unknown registry key in ResourceKey[minecraft:root / minecraft:entity_type]: minecraft:nope")] {
        match Component.from_json(parse(String(text))!) {
            ok(c) => panic("{text} was read as {c.to_json()}"),
            err(e) => check(e, String(message)),
        }
    }
    // A flag can be a number, and a UUID its text, as vanilla's codecs read them.
    let lenient = Component.from_json(parse("\{\"text\":\"a\",\"bold\":1,\"hover_event\":\{\"action\":\"show_entity\",\"id\":\"cow\",\"uuid\":\"069a79f4-44e9-4726-a5be-fca90e38aaf5\"\}\}")!)!
    check(lenient.to_json(), "\{\"text\":\"a\",\"bold\":true,\"hover_event\":\{\"id\":\"minecraft:cow\",\"uuid\":[110787060,1156138790,-1514210135,238594805],\"action\":\"show_entity\"\}\}")
    // Plain text with a style isn't a bare string.
    check(Component.literal("a").styled(Style { italic: some(false) }).to_nbt().to_snbt(), "\{italic:0b,text:\"a\"\}")
    check(TextColor.parse("#+ff")!.to_string(), "#0000FF")
    println("ok")
}
