/// Checks what `command.selector` makes of a selector, past whether it reads, which the rig's
/// `text` probe checks against vanilla: each type's limit, order and whether it takes entities
/// that aren't players, the tests in the order vanilla adds its predicates, the ranges' ends, a
/// later score's range in place of an earlier one's, and where reading stops.
module test.selector

import command.reader.{Reader}
import command.selector.{Ints, Progress, Selector, Sorting, Test, read_selector}
import registry.builtin.{builtin_names}
import registry.registries.{builtin_registries}
import registry.registry.{Registry}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn sorting(s: Sorting) -> String {
    return match s {
        Sorting.Arbitrary => String("arbitrary"),
        Sorting.Nearest => String("nearest"),
        Sorting.Furthest => String("furthest"),
        Sorting.Random => String("random"),
    }
}

fn bang(inverted: bool) -> String {
    return if inverted { String("!") } else { String() }
}

fn end<T: Display>(v: T?) -> String {
    return match v {
        some(x) => "{x}",
        none => String(),
    }
}

fn ints(i: Ints) -> String {
    return "{end(i.min)}..{end(i.max)}"
}

fn shown_test(t: Test) -> String {
    return match t {
        Test.Alive => String("alive"),
        Test.Name(n, inv) => "name={bang(inv)}{n}",
        Test.GameMode(m, inv) => "gamemode={bang(inv)}{m.name()}",
        Test.Team(n, inv) => "team={bang(inv)}{n}",
        Test.Type(id, inv) => "type={bang(inv)}{id.to_string()}",
        Test.TypeTag(id, inv) => "type={bang(inv)}#{id.to_string()}",
        Test.EntityTag(n, inv) => "tag={bang(inv)}{n}",
        Test.Nbt(_, inv) => "nbt={bang(inv)}",
        Test.Scores(list) => {
            var out = String("scores")
            for s in list {
                out.push_str(" {s.objective}={ints(s.range)}")
            }
            out
        },
        Test.Advancements(list) => {
            var out = String("advancements")
            for a in list {
                match a.progress {
                    Progress.Done(d) => out.push_str(" {a.id.to_string()}={d}"),
                    Progress.Criteria(c) => out.push_str(" {a.id.to_string()}={c.len()} criteria"),
                }
            }
            out
        },
        Test.Predicate(id, inv) => "predicate={bang(inv)}{id.to_string()}",
        Test.XRotation(d) => "x_rotation={end(d.min)}..{end(d.max)}",
        Test.YRotation(d) => "y_rotation={end(d.min)}..{end(d.max)}",
        Test.Level(l) => "level={ints(l)}",
    }
}

// The selector's limit, order, whether it takes other entities and where it looks, then its
// tests.
fn shown(s: Selector) -> String {
    var out = "{s.most} {sorting(s.order)} {if s.entities { "entities" } else { "players" }}"
    if s.world_limited {
        out.push_str(" here")
    }
    if s.current {
        out.push_str(" self")
    }
    if let only = s.only {
        out.push_str(" only={only.to_string()}")
    }
    if let p = s.player {
        out.push_str(" player={p}")
    }
    if let u = s.uuid {
        out.push_str(" uuid={u.to_string()}")
    }
    if let d = s.distance {
        out.push_str(" distance={end(d.min)}..{end(d.max)}")
    }
    for t in s.tests {
        out.push_str(" ")
        out.push_str(shown_test(t))
    }
    return out
}

fn read(text: str, types: Registry) -> String {
    var r = Reader.new(String(text))
    return match read_selector(mut r, types) {
        ok(s) => "{shown(s)} @{r.at}",
        err(e) => "error {e.cursor}",
    }
}

fn main() {
    let names = builtin_names()
    var all = builtin_registries()
    var at: usize = 0
    while names[at] != "entity_type" {
        at += 1
    }
    let types = all.swap_remove(at)
    check(read("@e", types), "2147483647 arbitrary entities alive @2", "all entities")
    check(read("@a", types), "2147483647 arbitrary players only=minecraft:player @2", "all players")
    check(read("@n", types), "1 nearest entities alive @2", "nearest entity")
    check(read("@r", types), "1 random players only=minecraft:player @2", "random player")
    check(read("@s", types), "1 arbitrary entities self @2", "self")
    check(read("@p[limit=3,sort=furthest] x", types), "3 furthest players only=minecraft:player @25", "options and where it stops")
    check(read("@e[type=player]", types), "2147483647 arbitrary players only=minecraft:player alive type=minecraft:player @15", "players by type")
    check(read("@e[type=!player,type=!#skeletons]", types), "2147483647 arbitrary entities alive type=!minecraft:player type=!#minecraft:skeletons @33", "types turned round")
    check(read("@e[level=1..,x_rotation=..10,name=a]", types), "2147483647 arbitrary players alive name=a x_rotation=..10.0 level=1.. @36", "ranges after the other tests")
    check(read("@e[scores=\{a=1,b=2..,a=..5\}]", types), "2147483647 arbitrary entities alive scores a=..5 b=2.. @28", "a later score in place")
    check(read("@a[advancements=\{story/root=true,a=\{b=false\}\}]", types), "2147483647 arbitrary players only=minecraft:player advancements minecraft:story/root=true minecraft:a=1 criteria @46", "advancements")
    check(read("@e[distance=..5,gamemode=!creative,team=,tag=!x,predicate=a:b]", types), "2147483647 arbitrary players here distance=..5.0 alive gamemode=!creative team= tag=!x predicate=a:b @62", "the rest")
    check(read("Steve", types), "1 arbitrary players player=Steve @5", "a name")
    check(read("f81d4fae-7dec-11d0-a765-00a0c91e6bf6", types), "1 arbitrary entities uuid=f81d4fae-7dec-11d0-a765-00a0c91e6bf6 @36", "a UUID")
    check(read("@e[limit=0]", types), "error 9", "an error's place")
    check(read("@e[distance=5..1]", types), "error 12", "a range's error at its start")
    print("ok")
}
