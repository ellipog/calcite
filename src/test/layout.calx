/// Checks server.layout: players near each other share a region and those apart don't, by
/// D47's rule in each dimension; a region keeps its ID as it changes, splits keep it for the part
/// with the longest-joined player, merges keep the smallest; and the layout depends only on where
/// the players are and the last layout, not the order they're given in.
module test.layout

import server.layout.{Layout, MERGE_DISTANCE, Placed, near}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn at(player: i32, x: i32, z: i32, view: i32) -> Placed {
    return Placed { player: player, dim: 0, x: x, z: z, view: view }
}

// The layout as `id:players` for each region, by ID.
fn shown(l: Layout) -> String {
    var out = String()
    for r in l.regions {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str("{r.id}@{r.dim}:")
        for i in 0..r.players.len() {
            if i > 0 {
                out.push_str(",")
            }
            out.push_str("{r.players[i]}")
        }
    }
    return out
}

fn main() {
    // Two views of 10 touch when their centres are 29 chunks apart, and not at 30.
    let reach = 10 + 10 + MERGE_DISTANCE
    check("{near(at(1, 0, 0, 10), at(2, reach, 0, 10))}", "true")
    check("{near(at(1, 0, 0, 10), at(2, reach + 1, 0, 10))}", "false")
    check("{near(at(1, 0, 0, 10), at(2, reach, -reach, 10))}", "true")
    check("{near(at(1, 0, 0, 10), at(2, -reach, reach + 1, 10))}", "false")
    // Wider views reach further, and other dimensions never.
    check("{near(at(1, 0, 0, 32), at(2, 70, 0, 32))}", "true")
    check("{near(at(1, 0, 0, 2), Placed { player: 2, dim: 1, x: 0, z: 0, view: 2 })}", "false")

    var l = Layout.new()
    check("{l.update([])} {shown(l)}", "false ")
    // Two apart, then a third between that joins them.
    check("{l.update([at(5, 0, 0, 10), at(7, 58, 0, 10)])}", "true")
    check(shown(l), "1@0:5 2@0:7")
    check("{l.update([at(7, 58, 0, 10), at(5, 0, 0, 10)])}", "false")
    check("{l.update([at(5, 0, 0, 10), at(7, 58, 0, 10), at(9, 29, 0, 10)])} {shown(l)}", "true 1@0:5,7,9")
    // The one between goes, and the region splits: the part with the longest-joined player, 5,
    // keeps its ID.
    check("{l.update([at(7, 58, 0, 10), at(5, 0, 0, 10)])} {shown(l)}", "true 1@0:5 3@0:7")
    // 5 walks to 7: the merged region keeps the smaller ID.
    check("{l.update([at(5, 40, 0, 10), at(7, 58, 0, 10)])} {shown(l)}", "true 1@0:5,7")
    // Moving within a region changes nothing but what it was worked out from.
    check("{l.update([at(5, 41, 3, 10), at(7, 58, 0, 10)])} {shown(l)}", "false 1@0:5,7")
    // 5 goes to the Nether at the same place: a region of its own there, with a new ID, as 7's
    // part keeps none it could, since 5 was its region's first and 7's part comes after.
    check("{l.update([Placed { player: 5, dim: 1, x: 41, z: 3, view: 10 }, at(7, 58, 0, 10)])} {shown(l)}", "true 1@1:5 4@0:7")
    // A chain: each near the next, so all are one region, whatever order they come in.
    var chain = List<Placed>()
    for i in 0..20 {
        chain.push(at(100 + i, i * reach, 0, 10))
    }
    var other = Layout.new()
    _ = other.update(chain)
    var reversed = List<Placed>()
    for i in 0..chain.len() {
        reversed.push(chain[chain.len() - 1 - i])
    }
    var again = Layout.new()
    _ = again.update(reversed)
    check(shown(other), shown(again))
    check("{other.regions.len()} {other.regions[0].players.len()}", "1 20")
    check("{other.region_of(110)} {other.region_of(99)}", "some(0) none")
    // Pulled one chunk apart each, every player is a region of their own.
    var apart = List<Placed>()
    for i in 0..20 {
        apart.push(at(100 + i, i * (reach + 1), 0, 10))
    }
    _ = other.update(apart)
    check("{other.regions.len()} {other.regions[0].id} {other.regions[0].players[0]} {other.regions[19].id}", "20 1 100 20")

    // Players crowded and scattered, with every view and in two dimensions, on both sides of 0:
    // the regions are the parts every pair `near` makes, as comparing every pair finds them, and
    // each player's slot comes back with them.
    var seed: u64 = 12345
    var round: i32 = 0
    while round < 40 {
        var many = List<Placed>()
        let count: i32 = 2 + round * 3
        let spread: i32 = 8 + round * 6
        var i: i32 = 0
        while i < count {
            seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
            let x = i32.wrap(i64.wrap(seed >> 33) % i64(spread * 2 + 1)) - spread
            seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
            let z = i32.wrap(i64.wrap(seed >> 33) % i64(spread * 2 + 1)) - spread
            seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
            let view = 2 + i32.wrap(i64.wrap(seed >> 33) % 31)
            let dim = usize.wrap(i64.wrap(seed >> 40) % 2)
            many.push(Placed { player: i + 1, dim: dim, x: x, z: z, view: view, slot: usize.wrap(i) + 50 })
            i += 1
        }
        round += 1
        var grid = Layout.new()
        _ = grid.update(many)
        check(regions_of(grid), pairwise(many))
        for r in grid.regions {
            for j in 0..r.players.len() {
                check("{r.slots[j]}", "{usize.wrap(r.players[j]) + 49}")
            }
        }
    }
    println("ok")
}

// Each region's players, the regions by their first player.
fn regions_of(l: Layout) -> String {
    var firsts = List<(i32, String)>()
    for r in l.regions {
        firsts.push((r.players[0], "{r.players}"))
    }
    firsts.sort()
    var out = String()
    for (_, s) in firsts {
        out.push_str(s)
    }
    return out
}

// The parts of `placed` as joining every pair that's near makes them, each part's players by
// entity ID, the parts by their first player.
fn pairwise(placed: List<Placed>) -> String {
    let n = placed.len()
    var part = List<usize>()
    for i in 0..n {
        part.push(i)
    }
    var changed = true
    while changed {
        changed = false
        for i in 0..n {
            for j in 0..n {
                if near(placed[i], placed[j]) and part[j] > part[i] {
                    part[j] = part[i]
                    changed = true
                }
            }
        }
    }
    var groups = List<(i32, String)>()
    for i in 0..n {
        if part[i] != i {
            continue
        }
        var players = List<i32>()
        for j in 0..n {
            if part[j] == i {
                players.push(placed[j].player)
            }
        }
        players.sort()
        groups.push((players[0], "{players}"))
    }
    groups.sort()
    var out = String()
    for (_, s) in groups {
        out.push_str(s)
    }
    return out
}
