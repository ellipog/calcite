/// Checks `world.levels`: a source's level spreading out a step a chunk, two sources meeting,
/// and a source taken away, with the levels set in vanilla's order. The rig's `levels` probe
/// checks the graph against vanilla's own `ChunkTracker`.
module test.levels

import world.levels.{ChunkLevels, ChunkTracker, LevelSources, SOURCE_CHUNK}
import world.pos.{ChunkPos}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// Levels kept in a map, as the simulation tracker keeps them: a chunk at `unset` or above isn't
// kept.
struct Kept {
    at: Map<i64, i32> = Map<i64, i32>()
    unset: i32
    sets: i32 = 0
}

impl ChunkLevels for Kept {
    fn level(self, chunk: i64) -> i32 {
        return self.at.get(chunk) ?? self.unset
    }
    fn set_level(mut self, chunk: i64, level: i32) {
        self.sets += 1
        if level >= self.unset {
            _ = self.at.remove(chunk)
        } else {
            self.at.insert(chunk, level)
        }
    }
}

// Each chunk's source level, as a ticket gives it.
struct Sources {
    at: Map<i64, i32> = Map<i64, i32>()
    unset: i32
}

impl LevelSources<Sources> for Kept {
    fn source_level(self, sources: Sources, chunk: i64) -> i32 {
        return sources.at.get(chunk) ?? sources.unset
    }
}

fn packed(x: i32, z: i32) -> i64 {
    return ChunkPos { x: x, z: z }.pack()
}

fn main() {
    check("{SOURCE_CHUNK}", "{packed(1875066, 1875066)}", "the source is vanilla's INVALID_CHUNK_POS")

    // A ticket at 31 reaches 13 chunks out, the loading tracker's 46 levels ending at 44.
    var graph = ChunkTracker.new(46)
    var levels = Kept { unset: 45 }
    var sources = Sources { unset: 45 }
    sources.at.insert(packed(0, 0), 31)
    graph.update(packed(0, 0), 31, true, levels)
    check("{graph.has_work()} {graph.queue_size()}", "true 1", "a new source is queued")
    let left = graph.run_updates(i32.MAX, mut levels, sources)
    check("{graph.has_work()} {graph.queue_size()} {levels.at.len()}", "false 0 729", "a level 31 source reaches 27 by 27 chunks")
    check("{levels.level(packed(0, 0))} {levels.level(packed(5, -3))} {levels.level(packed(-13, 13))} {levels.level(packed(14, 0))}", "31 36 44 45", "a step a chunk")
    check("{i32.MAX - left}", "729", "a chunk settles a level at a time")

    // A source no lower than its chunk changes nothing, coming or going.
    sources.at.insert(packed(3, 0), 34)
    graph.update(packed(3, 0), 34, true, levels)
    check("{graph.queue_size()}", "0", "a source no lower than its chunk")
    _ = sources.at.remove(packed(3, 0))
    graph.update(packed(3, 0), 45, false, levels)
    check("{graph.queue_size()}", "0", "a source the neighbours outdo, taken away")

    // A second source lowers only the chunks nearer it than the first.
    sources.at.insert(packed(20, 0), 33)
    graph.update(packed(20, 0), 33, true, levels)
    _ = graph.run_updates(i32.MAX, mut levels, sources)
    check("{levels.level(packed(20, 0))} {levels.level(packed(17, 0))} {levels.level(packed(10, 0))} {levels.level(packed(16, 5))}", "33 36 41 38", "two sources meet")

    // Taking the first away puts its chunks back to what the second gives, or none.
    _ = sources.at.remove(packed(0, 0))
    graph.update(packed(0, 0), 45, false, levels)
    _ = graph.run_updates(i32.MAX, mut levels, sources)
    check("{levels.level(packed(0, 0))} {levels.level(packed(3, 0))} {levels.level(packed(10, 0))} {levels.level(packed(9, 0))} {levels.level(packed(8, 0))}", "45 45 43 44 45", "a source taken away")
    check("{graph.has_work()} {graph.queue_size()} {levels.at.len()}", "false 0 529", "only the second's chunks are left")

    // Updates run a few at a time leave the rest queued.
    var counted = ChunkTracker.new(46)
    var few = Kept { unset: 45 }
    var one = Sources { unset: 45 }
    one.at.insert(packed(0, 0), 31)
    counted.update(packed(0, 0), 31, true, few)
    check("{counted.run_updates(5, mut few, one)} {counted.has_work()} {few.at.len()}", "0 true 5", "five settle")
    check("{counted.run_updates(1000, mut few, one)} {counted.has_work()} {few.at.len()} {few.sets}", "276 false 729 729", "the rest settle")

    // At the world's edge, a chunk next to the source reads its own source there, and the
    // source chunk itself never gets a level.
    var edge = ChunkTracker.new(34)
    var near = Kept { unset: 33 }
    var edge_sources = Sources { unset: 33 }
    edge_sources.at.insert(packed(1875065, 1875065), 30)
    edge.update(packed(1875065, 1875065), 30, true, near)
    _ = edge.run_updates(i32.MAX, mut near, edge_sources)
    check("{near.level(packed(1875065, 1875065))} {near.level(packed(1875064, 1875066))} {near.at.contains(SOURCE_CHUNK)} {near.at.len()}", "30 31 false 23", "the edge of the world")
    println("ok")
}
