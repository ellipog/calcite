/// Checks `world.chunk` and `world.block_flags`: the flags of states whose flags are known, which
/// heightmaps count which states, the flat world's chunk as vanilla sends it, and what
/// `set_block` changes and leaves alone. The rig's `chunk` probe checks the rest against vanilla's
/// own sections and heightmaps (rig/README.md).
module test.chunk

import server.play.{World}
import std.hash.{sha256}
import world.block_flags.{AIR, BLOCK_ENTITY, CAN_OCCLUDE, FLUID, FLUID_RANDOMLY_TICKING, LIGHT_DAMPENING_SHIFT, LIGHT_EMISSION_SHIFT, PROPAGATES_SKYLIGHT_DOWN, RANDOMLY_TICKING, SOLID_RENDER}
import world.blocks.{STATE_COUNT}
import world.chunk.{AIR_STATE, BlockStates, Chunk, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES, OCEAN_FLOOR, OCEAN_FLOOR_WG, Section, WORLD_SURFACE, WORLD_SURFACE_WG}

// Vanilla 26.3's IDs of a few blocks and states.
const STONE: u32 = 1
const GRASS_BLOCK: u32 = 9
const WATER: u32 = 89
const LAVA: u32 = 105
const OAK_LEAVES: u32 = 294
const TORCH: u32 = 4926
const CHEST: u32 = 5544
const CAVE_AIR: u32 = 18650
const OAK_LEAVES_BLOCK: i32 = 94

fn check(got: i64, want: i64, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn check_bool(got: bool, want: bool, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn flags() {
    // Three of the leaves' states, and every state of stone and bedrock, as motion blocking.
    let table = BlockStates.new([1, 2, OAK_LEAVES_BLOCK], [1, 2], 1)
    check(i64(table.len()), i64(STATE_COUNT), "states")
    // Air lets skylight through and takes none of it.
    check(i64(table.flags(AIR_STATE)), i64(AIR | PROPAGATES_SKYLIGHT_DOWN), "air")
    check(i64(table.flags(CAVE_AIR)), i64(AIR | PROPAGATES_SKYLIGHT_DOWN), "cave air")
    // Stone is a solid cube, which takes all the light; grass takes random ticks too.
    let solid = CAN_OCCLUDE | SOLID_RENDER | (15 << LIGHT_DAMPENING_SHIFT)
    check(i64(table.flags(STONE)), i64(solid), "stone")
    check(i64(table.flags(GRASS_BLOCK)), i64(solid | RANDOMLY_TICKING), "grass block")
    // Water still: a fluid, through which light dims by one.
    check(i64(table.flags(WATER) & (FLUID | FLUID_RANDOMLY_TICKING | AIR)), i64(FLUID), "water")
    check(i64((table.flags(WATER) >> LIGHT_DAMPENING_SHIFT) & 15), 1, "water's dampening")
    // Lava ticks at random as a fluid, and gives light 15.
    check(i64(table.flags(LAVA) & (FLUID | FLUID_RANDOMLY_TICKING)), i64(FLUID | FLUID_RANDOMLY_TICKING), "lava")
    check(i64((table.flags(LAVA) >> LIGHT_EMISSION_SHIFT) & 15), 15, "lava's light")
    check(i64((table.flags(TORCH) >> LIGHT_EMISSION_SHIFT) & 15), 14, "a torch's light")
    check(i64(table.flags(CHEST) & BLOCK_ENTITY), i64(BLOCK_ENTITY), "a chest")

    check_bool(table.is_air(CAVE_AIR), true, "cave air is air")
    check_bool(table.is_air(STONE), false, "stone is air")
    check(i64(table.block_of(AIR_STATE)), 0, "air's block")
    check(i64(table.block_of(GRASS_BLOCK)), 8, "grass's block")
    check(i64(table.block_of(OAK_LEAVES)), i64(OAK_LEAVES_BLOCK), "the leaves' block")
    check(i64(table.block_of(STATE_COUNT - 1)), 1285, "the last state's block")

    // Every heightmap that counts a state, as `Heightmap.Types` says, from the tags given.
    let cases: List<(u32, List<i32>)> = [
        (AIR_STATE, []),
        (CAVE_AIR, []),
        (STONE, [WORLD_SURFACE_WG, WORLD_SURFACE, OCEAN_FLOOR_WG, OCEAN_FLOOR, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES]),
        (OAK_LEAVES, [WORLD_SURFACE_WG, WORLD_SURFACE, OCEAN_FLOOR_WG, OCEAN_FLOOR, MOTION_BLOCKING]),
        (WATER, [WORLD_SURFACE_WG, WORLD_SURFACE, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES]),
        (TORCH, [WORLD_SURFACE_WG, WORLD_SURFACE]),
    ]
    for (state, kinds) in cases {
        for kind in 0..6 {
            check_bool(table.counts_in(kind, state), kinds.contains(kind), "heightmap {kind} counting {state}")
        }
    }
}

fn flat() {
    // The flat world's chunk, as vanilla 26.3 sends it: the bytes it was written as by hand.
    let world = World.defaults()
    let packet = world.flat.chunk_packet(3, -7)
    check(i64.wrap(packet.len()), 7260, "the flat chunk's length")
    let want: List<u8> = [0xab, 0x7c, 0x43, 0x7d, 0x2d, 0xb2, 0x3f, 0xf2, 0xc0, 0x9a, 0xa8, 0x6b, 0xfa, 0xf9, 0x34, 0x01, 0x36, 0x94, 0xb9, 0xc0, 0x08, 0x93, 0x6d, 0x5e, 0xdd, 0xca, 0xdb, 0x30, 0xe8, 0xc1, 0x29, 0xd7]
    let got = sha256(packet)
    if got != want {
        panic("the flat chunk's SHA-256 is {got}")
    }
}

fn setting() {
    let table = BlockStates.new([1, 2], [1, 2], 1)
    var c = Chunk.new(table, -64, 24, 0)
    // Air into a section of only air changes nothing, and nor does a state that's there.
    check_bool(c.set_block(table, 1, 70, 2, CAVE_AIR) == none, true, "cave air into air")
    check_bool(c.set_block(table, 1, 70, 2, STONE) == some(AIR_STATE), true, "stone into air")
    check_bool(c.set_block(table, 1, 70, 2, STONE) == none, true, "stone onto stone")
    check(i64(c.height(WORLD_SURFACE, 1, 2)), 71, "the surface over the stone")
    check(i64(c.height(MOTION_BLOCKING, 1, 2)), 71, "what blocks motion over the stone")
    // The generation heightmaps aren't kept as blocks are set in the world.
    check(i64(c.height(WORLD_SURFACE_WG, 1, 2)), -64, "the generation surface")
    check(i64(c.highest_section_y()), 64, "the highest section")
    let s = c.section(8)
    check(i64(s.non_empty()), 1, "blocks in the stone's section")
    check(i64(c.block(1, 70, 2)), i64(STONE), "the stone")
    // A torch over the stone is in the surface, and blocks no motion.
    _ = c.set_block(table, 1, 71, 2, TORCH)
    check(i64(c.height(WORLD_SURFACE, 1, 2)), 72, "the surface over the torch")
    check(i64(c.height(MOTION_BLOCKING, 1, 2)), 71, "what blocks motion under the torch")
    // Taking the stone out from under it leaves the surface on the torch, and the motion
    // heightmap at the bottom.
    check_bool(c.set_block(table, 1, 70, 2, AIR_STATE) == some(STONE), true, "air over the stone")
    check(i64(c.height(WORLD_SURFACE, 1, 2)), 72, "the surface with the stone gone")
    check(i64(c.height(MOTION_BLOCKING, 1, 2)), -64, "what blocks motion with the stone gone")
    // Both hold a fluid, and lava takes random ticks, as a block and as a fluid.
    _ = c.set_block(table, 0, 0, 0, WATER)
    _ = c.set_block(table, 0, 1, 0, LAVA)
    let w = c.section(4)
    check(i64(w.non_empty()), 2, "blocks in the fluids' section")
    check(i64(w.fluids()), 2, "fluids")
    check(i64(w.ticking_fluids()), 1, "ticking fluids")
    check(i64(w.ticking()), 1, "ticking blocks")
    // A section made of the containers counts them again.
    let again = Section.from(table, w.states(), w.biomes())
    check(i64(again.fluids()), 2, "fluids counted again")
}

fn main() {
    flags()
    flat()
    setting()
    println("ok")
}
