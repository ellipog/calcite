/// Checks `storage.players` on a world of its own: a player's data saved, saved again with the
/// first kept as `.dat_old`, read back, a broken one copied aside with its time, and the line
/// for a save with nowhere to go. The rig's `world_folder` probe checks reading against vanilla.
module test.players

import java.uuid.{Uuid}
import nbt.tag.{Accounter, Tag}
import server.log.{Entry}
import std.fs.{list, metadata, read, remove_dir_all, set_modified, temp_dir, write}
import std.time.{DateTime, Timestamp}
import storage.players.{PlayerFiles}
import storage.world.{WorldFolder, join, read_compressed}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn player(points: i32) -> Tag {
    var tags = JavaHashMap<String, Tag>()
    tags.insert(String("DataVersion"), Tag.Int(5023))
    tags.insert(String("Health"), Tag.Int(points))
    return Tag.Compound(tags)
}

fn health(found: JavaHashMap<String, Tag>?) -> String {
    let tags = found else return String("none")
    return tags["Health"].to_snbt()
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn main() {
    let universe = temp_dir()!
    let now = DateTime { year: 2026, month: 10, day: 31, hour: 1, minute: 2, second: 3, milli: 0 }
    let world = match WorldFolder.open(universe, String("world")) {
        ok(w) => w,
        err(e) => panic("the world didn't open: {e}"),
    }
    let players = PlayerFiles.open(world)
    check(players.folder, join(universe, String("world/players/data")), "the folder")
    let id = Uuid.parse(String("069a79f4-44e9-4726-a5be-fca90e38aaf5")) ?? Uuid.new(0, 0)
    let name = String("Notch")
    var lines = List<Entry>()

    // New to the world.
    check(health(players.load(id, name, now, mut lines)), "none", "a new player")

    // Saved, then saved again: the first is kept, and no new file is left.
    players.save(id, name, player(20), mut lines)
    players.save(id, name, player(7), mut lines)
    check(health(players.load(id, name, now, mut lines)), "7", "the player's data")
    var accounter = Accounter.unlimited()
    let old = read_compressed(join(players.folder, String("069a79f4-44e9-4726-a5be-fca90e38aaf5.dat_old")), mut accounter)!
    check(old["Health"].to_snbt(), "20", "the data before")
    let files = list(players.folder)!
    check("{files.len()}", "2", "the files")
    check(shown(lines), "", "nothing logged")

    // A broken file: the old one is read, and the broken one copied aside, its time kept.
    let current = join(players.folder, String("069a79f4-44e9-4726-a5be-fca90e38aaf5.dat"))
    write(current, [1, 2, 3])!
    let then = Timestamp { unix_ms: 1700000000000 }
    set_modified(current, then)!
    check(health(players.load(id, name, now, mut lines)), "20", "the fallback")
    check(shown(lines), "[Failed to load player data for Notch]", "the fallback's line")
    let copy = join(players.folder, String("069a79f4-44e9-4726-a5be-fca90e38aaf5_corrupted_2026-10-31_01-02-03.dat"))
    let kept = read(copy)!
    check("{kept.len()} {metadata(copy)!.modified.unix_ms}", "3 1700000000000", "the copy")
    check("{read(current)!.len()}", "3", "the broken file left where it was")

    // Nowhere to save: vanilla's warning.
    lines = List<Entry>()
    remove_dir_all(players.folder)!
    players.save(id, name, player(1), mut lines)
    check(shown(lines), "[Failed to save player data for Notch]", "a save with nowhere to go")

    world.close(mut lines)
    remove_dir_all(universe)!
    print("ok")
}
