/// Checks NBT as nbt.tag reads, writes and prints it: each type in binary, lists of mixed types
/// wrapped and unwrapped, a compound's order, the accounter's limits, the exceptions vanilla
/// throws, and SNBT's quotes and keys. The rig's `nbt` probe checks the same against vanilla.
module test.nbt

import nbt.tag.{Accounter, Tag, read_any}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn hex(bytes: List<u8>) -> String {
    let digits = "0123456789abcdef"
    var out = String()
    for b in bytes {
        out.push_str(digits[usize(b / 16)..usize(b / 16) + 1])
        out.push_str(digits[usize(b % 16)..usize(b % 16) + 1])
    }
    return out
}

fn unhex(text: str) -> List<u8> {
    var out = List<u8>()
    var high: i32 = -1
    for i in 0..text.len() {
        let b = text.byte_at(i)
        let v: i32 = if b >= 97 { i32(b) - 87 } else if b >= 48 and b <= 57 { i32(b) - 48 } else { -1 }
        if v < 0 {
            continue
        }
        if high < 0 {
            high = v
        } else {
            out.push(u8.wrap(high * 16 + v))
            high = -1
        }
    }
    return out
}

// The tag in `text`'s hex as SNBT and back in network form, or the error.
fn round(text: str) -> String {
    var at: usize = 0
    var acc = Accounter.unlimited()
    match read_any(unhex(text), mut at, mut acc) {
        ok(tag) => {
            var out = List<u8>()
            tag.write_any(mut out)!
            return "{tag.to_snbt()} {hex(out)}"
        },
        err(e) => return "{e.exception}: {e.message}",
    }
}

fn error(text: str, acc: Accounter) -> String {
    var at: usize = 0
    var a = acc
    match read_any(unhex(text), mut at, mut a) {
        ok(tag) => return "read {tag.to_snbt()}",
        err(e) => return "{e.exception}: {e.message}",
    }
}

fn binary() {
    check(round("00"), "END 00")
    check(round("01 7f"), "127b 017f")
    check(round("02 8000"), "-32768s 028000")
    check(round("04 8000000000000000"), "-9223372036854775808L 048000000000000000")
    // Every NaN goes back as Java's own.
    check(round("05 7fc00001"), "NaNf 057fc00000")
    // Reading makes -0.0 the tag for 0.0, as vanilla's `valueOf` does.
    check(round("06 8000000000000000"), "0.0d 060000000000000000")
    check(round("05 80000000"), "0.0f 0500000000")
    check(round("07 00000002 80 7f"), "[B;-128B,127B] 0700000002807f")
    check(round("0b 00000002 80000000 7fffffff"), "[I;-2147483648,2147483647] 0b00000002800000007fffffff")
    check(round("0c 00000001 0000000000000005"), "[L;5L] 0c000000010000000000000005")
    check(round("08 000a c080 c3a9 eda0bdedb880"), "\"\\x00é\u{1F600}\" 08000ac080c3a9eda0bdedb880")
    check(round("09 03 00000002 00000001 00000002"), "[1,2] 0903000000020000000100000002")
    // A compound holding only `""` in a list is the element it wraps.
    check(round("09 0a 00000002 0100006100 0300000000000700"), "[97b,7] 090a0000000201000061000300000000000700")
    check(round("0a 01000162 05 03000161 00000007 00"), "\{a:7,b:5b\} 0a0300016100000007010001620500")
    // A key read twice keeps its place, with the second value.
    check(round("0a 010001610503000161 0000000700"), "\{a:7\} 0a030001610000000700")
    check(round("09 00 00000000"), "[] 090000000000")
}

fn errors() {
    check(error("", Accounter.unlimited()), "EOFException: ")
    check(error("03 0000", Accounter.unlimited()), "ReportedNbtException: Loading NBT data")
    check(error("0d 00", Accounter.unlimited()), "ReportedNbtException: Loading NBT data")
    check(error("08 0002 ff41", Accounter.unlimited()), "ReportedNbtException: Loading NBT data")
    check(error("09 00 00000003", Accounter.unlimited()), "NbtFormatException: Missing type on ListTag")
    check(error("09 01 ffffffff", Accounter.unlimited()), "NbtFormatException: ListTag length cannot be negative: -1")
    check(error("0b ffffffff", Accounter.unlimited()), "IllegalArgumentException: Tried to account NBT tag with negative size: -4")
    check(error("0b 00000004 00000001", Accounter.with_quota(32)), "NbtAccounterException: Tried to read NBT tag that was too big; tried to allocate: 24 + 16 bytes where max allowed: 32")
    // Depth: a list in a list in a list, with a limit of two.
    check(error("09 09 00000001 09 00000001 00 00000000", Accounter.new(1000, 2)), "NbtAccounterException: Tried to read NBT tag with too high complexity, depth > 2")
    check(error("09 09 00000001 00 00000000", Accounter.new(1000, 2)), "read [[]]")
}

fn printing() {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("plain"), Tag.Str(String("it's")))
    m.insert(String("true"), Tag.Str(String("say \"hi\"")))
    m.insert(String("9lives"), Tag.Str(String("a\tb\u{1}\\")))
    m.insert(String(""), Tag.Str(String()))
    m.insert(String("a.b-c+d_e"), Tag.Float(0.1f32))
    m.insert(String("TRUE"), Tag.Double(1e10))
    let tag = Tag.Compound(m)
    check(tag.to_snbt(), "\{\"\":\"\",\"9lives\":\"a\\tb\\x01\\\\\",\"TRUE\":1.0E10d,a.b-c+d_e:0.1f,plain:\"it's\",\"true\":'say \"hi\"'\}")
    // A compound sorts its keys by UTF-16 unit, which puts U+FFFD after an emoji.
    var wide = JavaHashMap<String, Tag>()
    wide.insert(String("\u{FFFD}"), Tag.Int(1))
    wide.insert(String("\u{1F600}"), Tag.Int(2))
    check(Tag.Compound(wide).to_snbt(), "\{\"\u{1F600}\":2,\"\u{FFFD}\":1\}")
}

fn long_strings() {
    var s = String("abcdefghij")
    for _ in 0..6553 {
        s.push_str("xxxxxxxxxx")
    }
    s.push_str("0123456789")
    let tag = Tag.Str(s)
    var out: List<u8> = [1, 2]
    match tag.write_any(mut out) {
        ok => panic("a string of 65,550 bytes was written"),
        err(message) => check(message, "encoded string (abcdefgh...23456789) too long: 65550 bytes"),
    }
    check(hex(out), "0102")
    var file = List<u8>()
    tag.write_unnamed(mut file)
    check(hex(file), "0800000000")
}

fn main() {
    binary()
    errors()
    printing()
    long_strings()
    println("ok")
}
