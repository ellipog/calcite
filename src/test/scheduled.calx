/// Checks `world.scheduled`: events kept as vanilla's `TimerQueue` keeps them, due in the order of
/// their times and then of when they were scheduled, one a name at a time, run at the game time
/// and taken off their name's times then, saved and read back (D569).
module test.scheduled

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.scheduled.{Scheduled, ScheduledEvents}

fn check(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

fn id(path: str) -> Identifier {
    return Identifier { namespace: String("rig"), path: String(path) }
}

// What's due by `now`, each taken off, as names.
fn due(events: mut ScheduledEvents, now: i64) -> String {
    var out = String()
    while let run = events.next_due(now) {
        if not out.is_empty() {
            out.push_str(" ")
        }
        match run {
            Scheduled.Function(f) => out.push_str(f.to_string()),
            Scheduled.Tag(t) => out.push_str("#{t.to_string()}"),
        }
    }
    return out
}

fn main() {
    var events = ScheduledEvents.fresh()
    check("{events.dirty}", "true", "fresh ones to be saved")
    events.schedule(String("rig:b"), 10, Scheduled.Function(id("b")))
    events.schedule(String("rig:a"), 10, Scheduled.Function(id("a")))
    events.schedule(String("#rig:t"), 5, Scheduled.Tag(id("t")))
    events.schedule(String("rig:a"), 10, Scheduled.Function(id("again")))
    events.schedule(String("rig:a"), 12, Scheduled.Function(id("a2")))
    check(due(mut events, 4), "", "nothing due yet")
    check(due(mut events, 10), "#rig:t rig:b rig:a", "due by time, then by when scheduled, one a name at a time")
    // The tag ran at 10, not its own 5, so its name keeps 5.
    check("{events.remove(String("#rig:t"))}", "1", "an event run late still counted")
    check("{events.remove(String("rig:a"))}", "1", "a name's event yet to run")
    check("{events.remove(String("rig:a"))}", "0", "a name with none")
    check(due(mut events, 20), "", "what was cleared doesn't run")
    // Saved and read back, oldest first.
    events.schedule(String("rig:x"), 30, Scheduled.Function(id("x")))
    events.schedule(String("#rig:y"), 25, Scheduled.Tag(id("y")))
    let packed = events.pack()
    check(packed.to_snbt(), "\{events:[\{callback:\{id:\"rig:y\",type:\"minecraft:function_tag\"\},id:\"#rig:y\",trigger_time:25L\},\{callback:\{id:\"rig:x\",type:\"minecraft:function\"\},id:\"rig:x\",trigger_time:30L\}]\}", "saved")
    var root = JavaHashMap<String, Tag>()
    root.insert(String("data"), packed)
    var lines = List<Entry>()
    var read = ScheduledEvents.load(root, mut lines)
    check("{lines.len()}", "0", "read back without problems")
    check("{read.dirty}", "false", "what's read not to be saved till it changes")
    check(due(mut read, 40), "#rig:y rig:x", "read back in order")
    var bad = JavaHashMap<String, Tag>()
    bad.insert(String("data"), Tag.Compound(JavaHashMap<String, Tag>()))
    let unread = ScheduledEvents.load(bad, mut lines)
    check("{unread.dirty}", "true", "what can't be read made fresh, to be saved")
    check(lines[0].message.copy(), "Failed to parse saved data for 'SavedDataType[minecraft:scheduled_events]': No key events in MapLike[\{\}]", "a file without events")
    print("ok\n")
}
