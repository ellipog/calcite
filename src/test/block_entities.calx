/// Checks `worldgen.block_entities` where a structure template's data is loaded: a mob spawner, as
/// `BaseSpawner.load` reads it and `save` writes it back, with the woodland mansion's spider
/// spawner's data, one with no potentials, and one whose next spawn has no entity.
module test.block_entities

import nbt.tag.{Tag}
import worldgen.block_entities.{loaded}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// A tag as a line: compounds by their keys in order, numbers with their type.
fn shown(t: Tag) -> String {
    return match t {
        Tag.Byte(v) => "{v}b",
        Tag.Short(v) => "{v}s",
        Tag.Int(v) => "{v}",
        Tag.Long(v) => "{v}L",
        Tag.Float(v) => "{v}f",
        Tag.Double(v) => "{v}d",
        Tag.Str(s) => "\"{s}\"",
        Tag.List(l) => {
            var out = String("[")
            for i in 0..l.len() {
                if i > 0 {
                    out.push_str(",")
                }
                out.push_str(shown(l[i]))
            }
            out.push_str("]")
            out
        },
        Tag.Compound(m) => {
            var out = String("\{")
            var first = true
            for (k, v) in m {
                if not first {
                    out.push_str(",")
                }
                first = false
                out.push_str("{k}:{shown(v)}")
            }
            out.push_str("\}")
            out
        },
        _ => String("?"),
    }
}

fn compound(pairs: List<(str, Tag)>) -> JavaHashMap<String, Tag> {
    var m = JavaHashMap<String, Tag>()
    for (k, v) in pairs {
        m.insert(String(k), v.copy())
    }
    return m
}

fn spider() -> Tag {
    return Tag.Compound(compound([("entity", Tag.Compound(compound([("id", Tag.Str("minecraft:spider"))])))]))
}

fn main() {
    // `woodland_mansion/1x1_as2`'s spawner, its numbers ints, as the template has them.
    let mansion = compound([
        ("MaxNearbyEntities", Tag.Int(6)), ("RequiredPlayerRange", Tag.Int(16)), ("SpawnCount", Tag.Int(4)),
        ("SpawnData", spider()), ("MaxSpawnDelay", Tag.Int(800)), ("id", Tag.Str("minecraft:mob_spawner")),
        ("SpawnRange", Tag.Int(4)), ("Delay", Tag.Int(0)), ("MinSpawnDelay", Tag.Int(200)),
        ("SpawnPotentials", Tag.List([Tag.Compound(compound([("data", spider()), ("weight", Tag.Int(1))]))])),
    ])
    let saved = loaded(String("minecraft:mob_spawner"), mansion, none)!
    check(shown(Tag.Compound(saved)), shown(Tag.Compound(compound([
        ("Delay", Tag.Short(0)), ("MinSpawnDelay", Tag.Short(200)), ("MaxSpawnDelay", Tag.Short(800)),
        ("SpawnCount", Tag.Short(4)), ("MaxNearbyEntities", Tag.Short(6)), ("RequiredPlayerRange", Tag.Short(16)),
        ("SpawnRange", Tag.Short(4)), ("SpawnData", spider()),
        ("SpawnPotentials", Tag.List([Tag.Compound(compound([("data", spider()), ("weight", Tag.Int(1))]))])),
    ]))), "the mansion's spawner")

    // No potentials: one, the next spawn's data, weighted 1; the counts' defaults where missing.
    let alone = loaded(String("minecraft:mob_spawner"), compound([("SpawnData", spider()), ("Delay", Tag.Byte(7))]), none)!
    check(shown(alone["Delay"]), "7s", "a delay given as a byte")
    check(shown(alone["SpawnCount"]), "4s", "the spawn count's default")
    check(shown(alone["SpawnPotentials"]), shown(Tag.List([Tag.Compound(compound([("data", spider()), ("weight", Tag.Int(1))]))])), "the potentials made from the next spawn")

    // A next spawn with no entity doesn't read: there's none, and the potentials are an empty
    // entity's.
    let empty = loaded(String("minecraft:mob_spawner"), compound([("SpawnData", Tag.Compound(compound([("id", Tag.Str("minecraft:zombie"))])))]), none)!
    check("{empty.contains("SpawnData")}", "false", "spawn data with no entity")
    check(shown(empty["SpawnPotentials"]), "[\{data:\{entity:\{\}\},weight:1\}]", "the potentials of an empty entity")
    println("ok")
}
