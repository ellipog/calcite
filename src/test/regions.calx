/// Checks `storage.regions`: chunks' NBT written to the region files of their regions and read
/// back, in batches across regions with clears between, files made only when a chunk is written,
/// a missing region kept as missing until it's dropped, 256 kept, and roots that aren't
/// compounds. Also `storage.region.configured`, vanilla's error for a compression that isn't one.
module test.regions

import nbt.tag.{Tag}
import server.log.{Entry, Level}
import std.fs.{is_dir, is_file, list, remove_dir_all, temp_dir}
import storage.region.{Compression, configured, encode}
import storage.regions.{KEPT, RegionStorage, encode_tag}
import world.pos.{ChunkPos}

fn check(got: i64, want: i64, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn check_bool(got: bool, want: bool, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// A chunk's NBT, a compound with its position and `n` longs.
fn root(pos: ChunkPos, n: usize) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("xPos"), Tag.Int(pos.x))
    m.insert(String("zPos"), Tag.Int(pos.z))
    var longs: List<i64> = []
    for i in 0..n {
        longs.push(i64.wrap(i) * 2654435761 + i64(pos.x))
    }
    m.insert(String("data"), Tag.LongArray(longs))
    return Tag.Compound(m)
}

fn read_back(storage: mut RegionStorage, pos: ChunkPos, want: Tag, what: String) {
    var lines: List<Entry> = []
    match storage.read(pos, mut lines) {
        ok(some(got)) => check_bool(got.to_snbt() == want.to_snbt(), true, what),
        ok(none) => panic("{what}: not there"),
        err(e) => panic("{what}: {e.exception}: {e.message}"),
    }
    check(i64.wrap(lines.len()), 0, "{what}: lines")
}

fn not_there(storage: mut RegionStorage, pos: ChunkPos, what: String) {
    var lines: List<Entry> = []
    match storage.read(pos, mut lines) {
        ok(none) => {},
        ok(some(_)) => panic("{what}: there"),
        err(e) => panic("{what}: {e.exception}: {e.message}"),
    }
}

fn main() {
    let dir = temp_dir()!
    let folder = "{dir}/region"
    var storage = RegionStorage.new(folder, true)
    var lines: List<Entry> = []

    // Reading makes nothing, not even the folder.
    let a = ChunkPos { x: 3, z: 4 }
    not_there(mut storage, a, "a before")
    check_bool(is_dir(folder), false, "the folder, after a read")
    check(i64.wrap(storage.regions_kept()), 1, "a's region, kept as missing")

    // A batch across three regions, with a clear between two writes of b.
    let b = ChunkPos { x: -1, z: -1 }
    let c = ChunkPos { x: 40, z: 4 }
    let a_root = root(a, 300)
    let b_root = root(b, 2000)
    let c_root = root(c, 10)
    let first: List<(ChunkPos, List<u8>?)> = [
        (a, some(encode_tag(a_root, Compression.Deflate))),
        (b, some(encode_tag(root(b, 5), Compression.Lz4))),
        (c, some(encode_tag(c_root, Compression.Stored))),
        (b, none),
        (b, some(encode_tag(b_root, Compression.Lz4))),
    ]
    storage.write(first, 1000, mut lines)!
    check(i64.wrap(lines.len()), 0, "the batch's lines")
    // The missing region found its file once a chunk was written to it.
    read_back(mut storage, a, a_root, "a")
    read_back(mut storage, b, b_root, "b, written again after it was cleared")
    read_back(mut storage, c, c_root, "c")
    let names = list(folder)!
    check(i64.wrap(names.len()), 3, "the region files")
    check_bool(names[0] == "r.-1.-1.mca" and names[1] == "r.0.0.mca" and names[2] == "r.1.0.mca", true, "the region files' names")
    check(i64.wrap(storage.regions_kept()), 3, "three regions kept")
    not_there(mut storage, ChunkPos { x: 5, z: 4 }, "a chunk never written, in a's region")

    // Clearing a chunk in a region without a file makes the file, as vanilla's does.
    let d = ChunkPos { x: 100, z: -100 }
    let clear_d: List<(ChunkPos, List<u8>?)> = [(d, none)]
    storage.write(clear_d, 1001, mut lines)!
    check_bool(is_file("{folder}/r.3.-4.mca"), true, "the file a clear makes")
    not_there(mut storage, d, "d, cleared")

    // A region kept as missing isn't looked for again, until it's dropped for others.
    let e = ChunkPos { x: -64, z: 0 }
    not_there(mut storage, e, "e before its file")
    let e_root = root(e, 1)
    var other = RegionStorage.new(folder, false)
    let write_e: List<(ChunkPos, List<u8>?)> = [(e, some(encode_tag(e_root, Compression.Gzip)))]
    other.write(write_e, 1002, mut lines)!
    other.close()!
    not_there(mut storage, e, "e, kept as missing")
    for i in 0..KEPT {
        not_there(mut storage, ChunkPos { x: 32 * i32.wrap(i), z: 1000 }, "region {i}")
    }
    check(i64.wrap(storage.regions_kept()), i64.wrap(KEPT), "as many kept as vanilla keeps")
    read_back(mut storage, e, e_root, "e, once it's looked for again")

    // A root that isn't a compound fails as vanilla's `NbtIo.read` fails it.
    let f = ChunkPos { x: 7, z: 7 }
    var not_compound: List<u8> = []
    Tag.Int(5).write_unnamed(mut not_compound)
    let write_f: List<(ChunkPos, List<u8>?)> = [(f, some(encode(not_compound, Compression.Deflate)))]
    storage.write(write_f, 1003, mut lines)!
    match storage.read(f, mut lines) {
        err(problem) => {
            check_bool(problem.exception == "IOException", true, "f's exception")
            check_bool(problem.message == "Root tag must be a named compound tag", true, "f's message")
        },
        _ => panic("f read"),
    }
    // Bytes that end in the middle of a tag.
    let cut: List<u8> = [10, 0, 0, 3, 0, 1]
    let write_cut: List<(ChunkPos, List<u8>?)> = [(f, some(encode(cut, Compression.Stored)))]
    storage.write(write_cut, 1004, mut lines)!
    match storage.read(f, mut lines) {
        err(problem) => check_bool(problem.exception == "ReportedNbtException", true, "the cut tag's exception: {problem.exception}"),
        _ => panic("the cut tag read"),
    }
    storage.close()!

    // `region-file-compression`, as vanilla reads it.
    var picked: List<Entry> = []
    check(i64(configured("lz4", mut picked).id()), 4, "lz4")
    check(i64(configured("none", mut picked).id()), 3, "none")
    check(i64.wrap(picked.len()), 0, "no lines for good names")
    check(i64(configured("gzip", mut picked).id()), 2, "gzip, which no option names")
    check(i64.wrap(picked.len()), 1, "a line for a bad name")
    match picked[0].level {
        Level.Error => {},
        _ => panic("the line for a bad name isn't an error"),
    }
    check_bool(picked[0].message == "Invalid `region-file-compression` value `gzip` in server.properties. Please use one of: lz4, none, deflate", true, "its words: {picked[0].message}")

    remove_dir_all(dir)!
    println("ok")
}
