/// Checks the block entities' tickers in the server's level (CAL-130), on a flat level whose
/// chunks tick, with block facts made from the built-in block and fluid registries: a daylight
/// detector putting out the sky's light as the sun's angle and the sky's darkening have it, once a
/// second, inverted too, and with no ticker where there's no sky; a crafter done crafting as its
/// count runs out; an empty brewing stand showing no bottles once it first ticks; a hopper's
/// cooldown run out; the tickers that do nothing where there's nothing to do saying nothing; and
/// those with something to do saying what's missing.
module test.block_entity_ticks

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// A flat level, its spawn's chunks full and given the facts, with a player's ticket at its
// middle, so its chunks tick, and nobody standing in it.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn block_of(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => b,
        err(_) => panic("no block {name}"),
    }
}

fn named(f: Facts, name: str) -> u32 {
    return f.default_state(block_of(f, name))
}

fn with(f: Facts, state: u32, prop: str, value: str) -> u32 {
    return match f.with_name(state, String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("no {prop} {value}"),
    }
}

// Runs `ticks` of the level's ticks: its block and fluid ticks, then its block events, then its
// block entities.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.handling = true
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
        level.run_block_events()
        level.handling = false
        level.tick_block_entities()
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn flag(f: Facts, level: Level, x: i32, y: i32, z: i32, prop: str) -> bool {
    return f.get_bool(level.spawn_state(x, y, z), String(prop))
}

fn number(f: Facts, level: Level, x: i32, y: i32, z: i32, prop: str) -> i32 {
    return f.get_int(level.spawn_state(x, y, z), String(prop)) ?? -1
}

// What the level reported isn't in Calcite yet, one line each.
fn quiet(level: mut Level, what: str) {
    quiet_but(mut level, what, "")
}

// As `quiet`, but for lines with `but` in them, where it isn't empty.
fn quiet_but(level: mut Level, what: str, but: str) {
    var out = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") and (but.is_empty() or not e.message.contains(but)) {
            out = "{out}{e.message}; "
        }
    }
    if not out.is_empty() {
        panic("{what} reported {out}")
    }
}

// Runs the level's ticks until the game time is a whole number of seconds, as a daylight
// detector's ticker reads it.
fn to_second(level: mut Level) {
    run(mut level, 1)
    while level.game_time % 20 != 0 {
        run(mut level, 1)
    }
}

// The field `key` of the block entity at the place, as an int, or -100 where there's none.
fn field(level: Level, x: i32, y: i32, z: i32, key: str) -> i32 {
    let saved = level.block_entity_tag(x, y, z) else return -100
    let tags = match saved {
        Tag.Compound(t) => t,
        _ => return -100,
    }
    if not tags.contains(key) {
        return -100
    }
    return match tags[key] {
        Tag.Int(v) => v,
        _ => -100,
    }
}

// A daylight detector under the open sky at noon puts out 15; with the sun 60 degrees on, eased
// to 48, 15 times its cosine, 10; with it 300 degrees on, eased towards a whole turn, the same;
// and with the sky darkened by 5, 10 times it, 7. An inverted one puts out 15 less the sky's
// light: 0, then 5 as it darkens. Each changes once a second, by the game time, and not between.
fn daylight() {
    let f = facts()
    var level = flat_level(f)
    level.place.darken = 0
    level.place.sun_angle = 0.0f32
    let detector = named(f, "daylight_detector")
    set(mut level, 4, -60, 4, detector, "the detector wasn't set")
    set(mut level, 6, -60, 4, with(f, detector, "inverted", "true"), "the inverted detector wasn't set")
    to_second(mut level)
    check(number(f, level, 4, -60, 4, "power") == 15, "the detector at noon")
    check(number(f, level, 6, -60, 4, "power") == 0, "the inverted detector at noon")
    level.place.sun_angle = 60.0f32
    run(mut level, 19)
    check(number(f, level, 4, -60, 4, "power") == 15, "the detector changed between seconds")
    run(mut level, 1)
    let at_60 = number(f, level, 4, -60, 4, "power")
    if at_60 != 10 {
        panic("the detector with the sun 60 degrees on: {at_60}")
    }
    level.place.sun_angle = 300.0f32
    to_second(mut level)
    check(number(f, level, 4, -60, 4, "power") == 10, "the detector with the sun 300 degrees on")
    level.place.darken = 5
    to_second(mut level)
    let darker = number(f, level, 4, -60, 4, "power")
    if darker != 7 {
        panic("the detector with the sky darkened by 5: {darker}")
    }
    check(number(f, level, 6, -60, 4, "power") == 5, "the inverted detector with the sky darkened by 5")
    quiet(mut level, "daylight detectors")
    println("ok daylight")
}

// Where the dimension has no sky light, a daylight detector has no ticker, and an inverted one
// stays as it was set.
fn no_sky() {
    let f = facts()
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for cx in -reach..reach + 1 {
        for cz in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: cx, z: cz }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: false, gen_depth: 384 })
    set(mut level, 4, -60, 4, with(f, named(f, "daylight_detector"), "inverted", "true"), "the detector wasn't set")
    run(mut level, 40)
    check(number(f, level, 4, -60, 4, "power") == 0, "a detector without a sky ticked")
    quiet(mut level, "a detector without a sky")
    println("ok no_sky")
}

// A crafter crafting with 3 ticks to go stops crafting on the third; a brewing stand set showing
// a bottle it hasn't shows none once it first ticks; a hopper's cooldown runs out to 0.
fn counted() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 4, with(f, named(f, "crafter"), "crafting", "true"), "the crafter wasn't set")
    level.set_block_entity_value(4, -60, 4, "crafting_ticks_remaining", Tag.Int(3))
    set(mut level, 6, -60, 4, with(f, named(f, "brewing_stand"), "has_bottle_1", "true"), "the brewing stand wasn't set")
    set(mut level, 8, -60, 4, named(f, "hopper"), "the hopper wasn't set")
    check(field(level, 8, -60, 4, "TransferCooldown") == -1, "a fresh hopper's cooldown")
    run(mut level, 1)
    check(not flag(f, level, 6, -60, 4, "has_bottle_1"), "the brewing stand still shows a bottle")
    check(field(level, 8, -60, 4, "TransferCooldown") == 0, "the hopper's cooldown didn't run out")
    check(field(level, 4, -60, 4, "crafting_ticks_remaining") == 2, "the crafter didn't count down")
    run(mut level, 1)
    check(flag(f, level, 4, -60, 4, "crafting"), "the crafter stopped early")
    run(mut level, 1)
    check(not flag(f, level, 4, -60, 4, "crafting"), "the crafter didn't stop")
    check(field(level, 4, -60, 4, "crafting_ticks_remaining") == 0, "the crafter's count")
    quiet_but(mut level, "counted tickers", "Points of interest")
    println("ok counted")
}

// Block entities whose tickers do nothing where there's nothing to do say nothing over a
// hundred ticks: signs, a bell, a shulker box, an empty furnace, campfires lit and not, a beacon
// on dirt, a conduit in air, an empty hive, a spawner with no one near, a sculk sensor and
// catalyst, and a jukebox with no record.
fn idle() {
    let f = facts()
    var level = flat_level(f)
    let names: List<str> = ["oak_sign", "oak_hanging_sign", "bell", "shulker_box", "furnace", "smoker", "campfire", "soul_campfire", "beacon", "conduit", "beehive", "spawner", "sculk_sensor", "calibrated_sculk_sensor", "sculk_catalyst", "sculk_shrieker", "jukebox", "chest", "ender_chest", "skeleton_skull"]
    var i = 0
    for n in names {
        var state = named(f, n)
        if n == "conduit" {
            state = with(f, state, "waterlogged", "false")
        }
        set(mut level, 1 + 3 * (i % 5), -60, 2 + 3 * (i / 5), state, "an idle block entity wasn't set")
        i += 1
    }
    set(mut level, 14, -60, 14, with(f, named(f, "campfire"), "lit", "false"), "the unlit campfire wasn't set")
    run(mut level, 100)
    quiet_but(mut level, "idle block entities", "Points of interest")
    println("ok idle")
}

// A spawner with a player near, a trial spawner, and a hopper holding stone over a chest each say
// what's missing.
fn reported() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 4, named(f, "spawner"), "the spawner wasn't set")
    level.place.players.push((4.5, -60.0, 8.5))
    run(mut level, 1)
    said(mut level, "A spawner near a player")
    set(mut level, 8, -60, 4, named(f, "trial_spawner"), "the trial spawner wasn't set")
    run(mut level, 1)
    said(mut level, "A trial spawner's tick")
    set(mut level, 12, -61, 4, named(f, "chest"), "the chest wasn't set")
    set(mut level, 12, -60, 4, named(f, "hopper"), "the hopper wasn't set")
    var stone = JavaHashMap<String, Tag>()
    stone.insert("Slot", Tag.Byte(0))
    stone.insert("id", Tag.Str("minecraft:stone"))
    stone.insert("count", Tag.Int(1))
    level.set_block_entity_value(12, -60, 4, "Items", Tag.List([Tag.Compound(stone)]))
    run(mut level, 1)
    said(mut level, "A hopper pushing items")
    println("ok reported")
}

// That the level reported `what` isn't in Calcite yet, and nothing else.
fn said(level: mut Level, what: str) {
    var found = false
    var others = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") {
            if e.message.contains(what) {
                found = true
            } else {
                others = "{others}{e.message}; "
            }
        }
    }
    if not found {
        panic("nothing said {what}; said {others}")
    }
    if not others.is_empty() {
        panic("said {others}")
    }
}

fn main() {
    daylight()
    no_sky()
    counted()
    idle()
    reported()
}
