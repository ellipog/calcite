/// Checks what a chunk's packet sends of its block entities (CAL-115), as
/// `ClientboundLevelChunkPacketData.BlockEntityInfo.create` makes them: a chest sends no update
/// tag, a sign sends its own data but not its type, place or components, a banner its
/// components too, a spawner all but `SpawnPotentials`, a trial spawner its next mob's time only
/// while it's active; each in the order fastutil's map of their places goes over them, with its
/// type's registry ID and its place in the chunk.
module test.block_entity_updates

import nbt.tag.{Tag}
import world.block_entity_updates.{block_entity_ids, block_entity_infos, update_tag}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

// A block entity of `kind` at x, y, z, as a chunk saves it, with `own_data` its own data.
fn saved(kind: str, x: i32, y: i32, z: i32, own_data: JavaHashMap<String, Tag>) -> Tag {
    var m = own_data.copy()
    m.insert(String("id"), Tag.Str(String(kind)))
    m.insert(String("x"), Tag.Int(x))
    m.insert(String("y"), Tag.Int(y))
    m.insert(String("z"), Tag.Int(z))
    m.insert(String("keepPacked"), Tag.Byte(0))
    return Tag.Compound(m)
}

fn tags() {
    var sign = JavaHashMap<String, Tag>()
    sign.insert(String("is_waxed"), Tag.Byte(1))
    sign.insert(String("front_text"), Tag.Compound(JavaHashMap<String, Tag>()))
    sign.insert(String("components"), Tag.Compound(JavaHashMap<String, Tag>()))
    let sign_tag = match saved("minecraft:sign", 1, 2, 3, sign) {
        Tag.Compound(m) => m.copy(),
        _ => panic("not a compound"),
    }
    let s = update_tag(String("minecraft:sign"), sign_tag, false)
    check(s.len() == 2 and s.contains("is_waxed") and s.contains("front_text"), "a sign's update tag isn't its own data")
    let b = update_tag(String("minecraft:banner"), sign_tag, false)
    check(b.len() == 3 and b.contains("components"), "a banner's update tag hasn't its components")
    check(update_tag(String("minecraft:chest"), sign_tag, false).is_empty(), "a chest has an update tag")
    var spawner = JavaHashMap<String, Tag>()
    spawner.insert(String("Delay"), Tag.Short(20))
    spawner.insert(String("SpawnPotentials"), Tag.List(List<Tag>()))
    let sp = update_tag(String("minecraft:mob_spawner"), spawner, false)
    check(sp.len() == 1 and sp.contains("Delay"), "a spawner's update tag has its spawn potentials")
    var trial = JavaHashMap<String, Tag>()
    trial.insert(String("next_mob_spawns_at"), Tag.Long(40))
    trial.insert(String("total_mobs_spawned"), Tag.Int(0))
    check(update_tag(String("minecraft:trial_spawner"), trial, false).is_empty(), "an inactive trial spawner sends when its next mob spawns")
    let active = update_tag(String("minecraft:trial_spawner"), trial, true)
    check(active.len() == 1 and active.contains("next_mob_spawns_at"), "an active trial spawner doesn't send when its next mob spawns")
    println("ok tags")
}

fn infos() {
    let ids = block_entity_ids()
    check(ids.get(String("minecraft:chest")) == some(1) and ids.get(String("minecraft:sign")) == some(7), "the block entity types' IDs")
    var sign = JavaHashMap<String, Tag>()
    sign.insert(String("is_waxed"), Tag.Byte(0))
    let all: List<Tag> = [saved("minecraft:chest", 20, 70, 37, JavaHashMap<String, Tag>()), saved("minecraft:sign", 17, 64, 33, sign), saved("minecraft:chest", 16, 64, 32, JavaHashMap<String, Tag>())]
    let inactive: List<bool> = [false, false, false]
    let got = block_entity_infos(all, inactive, ids)
    check(got.len() == 3, "a block entity wasn't sent")
    // `HashCommon.mix` of their `Vec3i` hashes puts 20, 70, 37 in slot 11 of 32, 17, 64, 33 in
    // slot 30 and 16, 64, 32 in slot 20, and fastutil's loop goes down from the top.
    check(got[0].kind == 7 and got[0].packed_xz == 17 and got[0].y == 64 and got[0].data != none, "the first isn't the sign at 17, 64, 33")
    check(got[1].kind == 1 and got[1].packed_xz == 0 and got[1].y == 64 and got[1].data == none, "the second isn't the chest at 16, 64, 32")
    check(got[2].kind == 1 and got[2].packed_xz == 69 and got[2].y == 70, "the third isn't the chest at 20, 70, 37")
    println("ok infos")
}

fn main() {
    tags()
    infos()
    println("ok")
}
