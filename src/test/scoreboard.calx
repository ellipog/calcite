/// Checks the scoreboard (CAL-164) against vanilla's, as the rig's `scores` session saw vanilla
/// 26.3 save it: the objectives and teams in the order vanilla packs them, the scores it keeps of
/// an objective there is, what's saved again only once it's changed, the scores of criteria set,
/// added to and reset, with what's sent of those shown, the teams players are in, and number
/// formats as they're sent.
module test.scoreboard

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.scoreboard.{Change, Objective, RULE_ALWAYS, RULE_NEVER, RULE_OTHER_TEAMS, RULE_OWN_TEAM, Scoreboard, color_rgb, custom_criteria, format_on_wire, read_only, slot_name, team_pushes}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// The tag as SNBT, or `none`.
fn snbt(t: Tag?) -> String {
    return match t {
        some(x) => x.to_snbt(),
        none => String("none"),
    }
}

// The rig's `scores` scoreboard, as SNBT.
fn fixture() -> String {
    return String("\{Objectives:[\{Name:\"left\",CriteriaName:\"minecraft.custom:minecraft.leave_game\",DisplayName:\"Left\"\},\{Name:\"hp\",CriteriaName:\"health\",DisplayName:\{text:\"Health\",color:\"red\"\},RenderType:\"hearts\"\},\{Name:\"food\",CriteriaName:\"food\",DisplayName:\"Food\",display_auto_update:1b,format:\{type:\"minecraft:styled\",color:\"gold\",bold:1b\}\},\{Name:\"air\",CriteriaName:\"air\",DisplayName:\"Air\",format:\{type:\"minecraft:fixed\",value:\"lots\"\}\},\{Name:\"armor\",CriteriaName:\"armor\",DisplayName:\"Armor\"\},\{Name:\"xp\",CriteriaName:\"xp\",DisplayName:\"XP\",format:\{type:\"minecraft:blank\"\}\},\{Name:\"level\",CriteriaName:\"level\",DisplayName:\"Level\"\},\{Name:\"deaths\",CriteriaName:\"deathCount\",DisplayName:\"Deaths\"\},\{Name:\"plain\",DisplayName:\"Plain\"\}],PlayerScores:[\{Name:\"alice\",Objective:\"plain\",Score:5,Locked:1b\},\{Name:\"#fake\",Objective:\"plain\",Score:-3,display:\"Fake\",format:\{type:\"minecraft:fixed\",value:\"?\"\}\},\{Name:\"Bot\",Objective:\"deaths\",Score:2\},\{Name:\"carol\",Objective:\"ghost\",Score:1\}],DisplaySlots:\{list:\"hp\",sidebar:\"food\",below_name:\"deaths\",\"sidebar.team.red\":\"plain\"\},Teams:[\{Name:\"red\",DisplayName:\"Red\",TeamColor:\"red\",AllowFriendlyFire:0b,MemberNamePrefix:\"[R] \",MemberNameSuffix:\{text:\" *\",color:\"gray\"\},NameTagVisibility:\"hideForOtherTeams\",CollisionRule:\"pushOwnTeam\",Players:[\"Bot\",\"alice\"]\},\{Name:\"blue\",DisplayName:\"Blue\",SeeFriendlyInvisibles:0b,DeathMessageVisibility:\"never\",Players:[\"carol\"]\},\{Name:\"empty\",DisplayName:\"Empty\"\}]\}")
}

// The scoreboard in the saved data `data`, with the lines it logged reading it.
fn loaded(data: String, lines: mut List<Entry>) -> Scoreboard {
    var root = JavaHashMap<String, Tag>()
    root.insert(String("data"), parse(data)!)
    return Scoreboard.load(root, mut lines)
}

// The names of what's in the list `key` of the packed scoreboard, in order, `field` of each.
fn names(packed: Tag, key: str, field: str) -> String {
    var out = String()
    let Tag.Compound(m) = packed else return out
    if not m.contains(key) {
        return out
    }
    let Tag.List(each) = m[key].copy() else return out
    for t in each {
        if let Tag.Compound(e) = t {
            if e.contains(field) {
                if let Tag.Str(s) = e[field].copy() {
                    out.push_str("{s} ")
                }
            }
        }
    }
    return out
}

// Read, it's packed in vanilla's order, and saved again only once it's changed; a score of an
// objective there isn't is left out, with vanilla's error.
fn saved() {
    var lines = List<Entry>()
    var board = loaded(fixture(), mut lines)
    check("{lines.len()} {lines[0].message}", "1 Unknown objective ghost for name carol, ignoring")
    let packed = board.pack()
    check(names(packed.copy(), "Objectives", "Name"), "hp level deaths food air armor left plain xp ")
    check(names(packed.copy(), "Teams", "Name"), "red blue empty ")
    // What it loaded marks it changed, and its file wasn't in vanilla's order, so it's saved, once.
    check("{board.take_save() != none} {board.take_save() == none}", "true true")
    // Read as it saved itself, it's the same, so it isn't saved again.
    var quiet = List<Entry>()
    var again = loaded(packed.to_snbt(), mut quiet)
    check("{quiet.len()} {again.take_save() == none}", "0 true")
    var made = Scoreboard.fresh()
    check(snbt(made.take_save()), "\{\}")
    var fresh = Scoreboard.fresh()
    check("{fresh.take_save() != none} {fresh.take_save() == none}", "true true")
    check(slot_name(18), "sidebar.team.white")
}

// Scores of criteria: set, as health is, sent where the objective's shown, and again only once
// it's changed; added to, as a stat is, saved where it's not shown; reset, which takes the score
// away; and the team a player's in.
fn criteria() {
    var lines = List<Entry>()
    var board = loaded(fixture(), mut lines)
    let first = board.set_for(String("health"), String("Bot"), none, 20)
    check("{first.len()} {first[0].owner} {first[0].objective} {first[0].value}", "1 Bot hp 20")
    check("{board.set_for(String("health"), String("Bot"), none, 20).len()}", "0")
    check("{board.set_for(String("health"), String("Bot"), none, 19)[0].value}", "19")
    check("{board.add_for(String("minecraft.custom:minecraft.leave_game"), String("Bot"), none, 1).len()}", "0")
    check("{board.add_for(String("minecraft.custom:minecraft.leave_game"), String("Bot"), none, 2).len()}", "0")
    check("{board.scores[String("Bot")][String("left")].value} {board.scores[String("Bot")][String("left")].locked}", "3 true")
    check("{board.take_save() != none}", "true")
    let shown = some(Tag.Str(String("Bot!")))
    let food = board.set_for(String("food"), String("Bot"), shown.copy(), 20)
    check(snbt(food[0].display.copy()), "\"Bot!\"")
    check("{board.set_for(String("food"), String("Bot"), shown, 20).len()}", "0")
    let reset = board.reset_for(String("health"), String("Bot"))
    check("{reset.len()} {reset[0].0} {reset[0].1}", "1 Bot some(hp)")
    let gone = board.reset_for(String("minecraft.custom:minecraft.leave_game"), String("nobody"))
    check("{gone.len()} {gone[0].1}", "1 none")
    check("{board.scores.contains(String("nobody"))}", "false")
    let red = board.team(String("alice")) ?? panic("alice is in red")
    check("{red.name} {red.color} {red.options()} {red.prefix.to_snbt()}", "red some(12) 2 \"[R] \"")
    check("{board.team(String("dave")) == none}", "true")
}

// Number formats as they're sent: blank, styled with the style, fixed with the text.
fn formats() {
    let blank = format_on_wire(some(parse(String("\{type:\"minecraft:blank\"\}"))!))
    check("{blank}", "some((0, none))")
    let styled = format_on_wire(some(parse(String("\{type:\"styled\",color:\"gold\"\}"))!)) ?? panic("styled")
    check("{styled.0} {snbt(styled.1.copy())}", "1 \{color:\"gold\"\}")
    let fixed = format_on_wire(some(parse(String("\{type:\"minecraft:fixed\",value:\"?\"\}"))!)) ?? panic("fixed")
    check("{fixed.0} {snbt(fixed.1.copy())}", "2 \"?\"")
    check("{format_on_wire(none)} {format_on_wire(some(Tag.Int(1)))}", "none none")
}

// Teams' rules: who pushes whom, `pushableBy`; who may hurt whom, `doTeamsAllowDamage`; and a
// dead mob's scores and team forgotten, `entityRemoved`, by its UUID.
fn rules() {
    check("{team_pushes(RULE_ALWAYS, RULE_ALWAYS, false)} {team_pushes(RULE_NEVER, RULE_ALWAYS, true)} {team_pushes(RULE_ALWAYS, RULE_NEVER, false)}", "true false false")
    check("{team_pushes(RULE_OWN_TEAM, RULE_ALWAYS, false)} {team_pushes(RULE_OWN_TEAM, RULE_OWN_TEAM, true)} {team_pushes(RULE_ALWAYS, RULE_OWN_TEAM, false)}", "true false true")
    check("{team_pushes(RULE_OTHER_TEAMS, RULE_ALWAYS, false)} {team_pushes(RULE_OTHER_TEAMS, RULE_OTHER_TEAMS, true)} {team_pushes(RULE_ALWAYS, RULE_OTHER_TEAMS, false)}", "false true false")
    var lines = List<Entry>()
    var board = loaded(String("\{Objectives:[\{Name:\"k\",CriteriaName:\"killedByTeam.red\",DisplayName:\"K\"\}],DisplaySlots:\{sidebar:\"k\"\},Teams:[\{Name:\"red\",DisplayName:\"Red\",TeamColor:\"red\",AllowFriendlyFire:0b,Players:[\"Bot\",\"Mate\",\"00000000-0000-0001-0000-000000000002\"]\},\{Name:\"blue\",DisplayName:\"Blue\",Players:[\"Eve\"]\}]\}"), mut lines)
    check("{board.allows_damage(String("Bot"), String("Mate"))} {board.allows_damage(String("Bot"), String("Eve"))} {board.allows_damage(String("Eve"), String("Bot"))} {board.allows_damage(String("Zed"), String("Bot"))}", "false true true true")
    check("{board.allied(String("Bot"), String("Mate"))} {board.allied(String("Bot"), String("Eve"))} {board.allied(String("Zed"), String("Zed"))}", "true false false")
    let mob = String("00000000-0000-0001-0000-000000000002")
    _ = board.add_for(String("killedByTeam.red"), String("00000000-0000-0003-0000-000000000004"), none, 1)
    check("{board.uuid_holders()}", "[(3, 4), (1, 2)]")
    let (scores, left) = board.entity_removed(mob.copy())
    check("{scores} {left}", "false some(red)")
    check("{board.team(mob.copy()) == none} {board.teams[String("red")].players.len()}", "true 2")
    let (gone, none_left) = board.entity_removed(String("00000000-0000-0003-0000-000000000004"))
    check("{gone} {none_left}", "true none")
    check("{color_rgb(9)} {color_rgb(0)} {color_rgb(15)}", "5592575 0 16777215")
}

// The changes as the players are told of them, in turn.
fn described(told: List<Change>) -> String {
    var out = String()
    for c in told {
        let part = match c {
            Change.Objective(o, method) => "objective {o.name} {method}",
            Change.Display(slot, name) => "display {slot} {name.copy() ?? String("none")}",
            Change.Score(s) => "score {s.owner} {s.objective} {s.value}",
            Change.Reset(owner, objective) => "reset {owner} {objective.copy() ?? String("none")}",
        }
        if not out.is_empty() {
            out.push_str(", ")
        }
        out.push_str(part)
    }
    return out
}

// What `scoreboard`'s commands change, as `ServerScoreboard` tells the players of it (CAL-165):
// an objective added, which nobody's told of; a score made and set, sent only once it's shown;
// the objective shown in a slot, which starts tracking it, then in another, which doesn't; it
// taken off one slot, then the last, which stops tracking it; a holder's last score reset, which
// resets them; and an objective taken away, its slot cleared and a holder whose last score it
// was kept with none.
fn commands() {
    var board = Scoreboard.fresh()
    board.create(Objective { name: String("k"), criteria: String("dummy"), display_name: Tag.Str(String("K")) })
    let fresh = board.touch(String("Bot"), String("k"))
    let (unshown, sent) = board.set_value(String("Bot"), String("k"), 0, none, fresh)
    check("{fresh} {unshown.len()} {sent} {board.touch(String("Bot"), String("k"))}", "true 0 true false")
    check(described(board.set_display(1, some(String("k")))), "objective k 0, display 1 k, score Bot k 0")
    check(described(board.set_display(0, some(String("k")))), "display 0 k")
    let (set, _) = board.set_value(String("Bot"), String("k"), 5, none, false)
    check(described(set), "score Bot k 5")
    let (same, again) = board.set_value(String("Bot"), String("k"), 5, none, false)
    check("{same.len()} {again}", "0 false")
    check(described(board.set_display(1, none)), "display 1 none")
    check(described(board.set_display(0, none)), "objective k 1")
    _ = board.set_display(1, some(String("k")))
    check(described(board.reset_one(String("Bot"), String("k"))), "reset Bot none")
    check(described(board.reset_one(String("Bot"), String("k"))), "")
    _ = board.touch(String("#a"), String("k"))
    _ = board.touch(String("#b"), String("k"))
    board.create(Objective { name: String("t"), criteria: String("trigger"), display_name: Tag.Str(String("T")) })
    _ = board.touch(String("#a"), String("t"))
    check(described(board.unlock(String("#a"), String("t"), true)), "")
    check(described(board.remove(String("k"))), "objective k 1")
    check("{board.scores_held(String("#a"))} {board.scores_held(String("#b")).len()} {board.holders().len()}", "[(t, 0)] 0 2")
    check("{board.objective(String("k")) == none} {board.added} {board.display[1]}", "true [t] none")
    check("{read_only(String("health"))} {read_only(String("dummy"))} {custom_criteria().len()} {custom_criteria()[42]}", "true false 43 killedByTeam.white")
}

fn main() {
    saved()
    criteria()
    formats()
    rules()
    commands()
    print("ok")
}
