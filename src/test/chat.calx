/// Checks server.chat: the characters chat can't have, the spam throttle, and the window of
/// signed messages a player has seen, with vanilla's messages for what doesn't add up and its
/// checksum, worked out with Java's arithmetic.
module test.chat

import protocol.chat.{LastSeenUpdate, MessageSignature}
import server.chat.{LastSeenValidator, Throttler, checksum, is_illegal}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn check_int(got: i64, want: i64) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// A signature of 256 bytes from `first` up, wrapping.
fn signature(first: u8, down: bool) -> MessageSignature {
    var bytes = List<u8>()
    for i in 0..256 {
        let n = u8.wrap(i)
        bytes.push(if down { first - n } else { first + n })
    }
    return MessageSignature { bytes: bytes }
}

fn bits(acknowledged: List<usize>) -> List<u8> {
    var out: List<u8> = [0, 0, 0]
    for i in acknowledged {
        out[i / 8] = out[i / 8] | u8.wrap(1 << i32.wrap(i % 8))
    }
    return out
}

fn update(moved: i32, acknowledged: List<usize>, sum: i8) -> LastSeenUpdate {
    return LastSeenUpdate { offset: moved, acknowledged: bits(acknowledged), checksum: sum }
}

fn applied(v: mut LastSeenValidator, u: LastSeenUpdate) -> String {
    return match v.apply_update(u) {
        ok(_) => String("ok"),
        err(p) => p,
    }
}

fn offset(v: mut LastSeenValidator, n: i32) -> String {
    return match v.apply_offset(n) {
        ok => String("ok"),
        err(p) => p,
    }
}

fn illegal() {
    check("{is_illegal("hello there")} {is_illegal("")} {is_illegal("café ü 中")}", "false false false")
    check("{is_illegal("a\tb")} {is_illegal("a\u{7f}")} {is_illegal("§aGreen")} {is_illegal("end §")}", "true true true true")
    println("ok illegal")
}

fn throttle() {
    // Ten seconds' worth: nine at once are let through, and the tenth is one too many.
    var t = Throttler.per_second(10)
    for _ in 0..9 {
        t.increment()
    }
    check("{t.is_under_threshold()}", "true")
    t.increment()
    check("{t.is_under_threshold()}", "false")
    // A tick takes one back, which lets none more through.
    t.tick()
    check_int(i64(t.count), 199)
    check("{t.is_under_threshold()}", "true")
    // No threshold, and one so large that Java's `20 * seconds` wraps below 0, are no limit.
    var none_at_all = Throttler.per_second(0)
    var wrapped = Throttler.per_second(2147483647)
    check_int(i64(wrapped.threshold), -20)
    for _ in 0..100 {
        none_at_all.increment()
        wrapped.increment()
    }
    check("{none_at_all.is_under_threshold()} {wrapped.is_under_threshold()}", "true true")
    // The count never goes below 0.
    var idle = Throttler()
    idle.tick()
    check_int(i64(idle.count), 0)
    println("ok throttle")
}

fn checksums() {
    let a = signature(0, false)
    let b = signature(255, true)
    check_int(i64(checksum([])), 1)
    check_int(i64(checksum([a.copy()])), -96)
    check_int(i64(checksum([b.copy()])), -96)
    check_int(i64(checksum([a, b])), -31)
    println("ok checksums")
}

fn window() {
    let a = signature(0, false)
    let b = signature(255, true)
    var v = LastSeenValidator.new()
    check_int(i64.wrap(v.tracked_count()), 20)
    // A client that has seen nothing.
    check(applied(mut v, LastSeenUpdate.empty()), "ok")
    // The same signature twice in a row is tracked once.
    v.add_pending(a)
    v.add_pending(a)
    v.add_pending(b)
    check_int(i64.wrap(v.tracked_count()), 22)
    check(offset(mut v, 3), "Advanced last seen window by 3 messages, but expected at most 2")
    check(offset(mut v, -1), "Advanced last seen window by -1 messages, but expected at most 2")
    // Moving on by 2 puts both at the window's end, where the client says it saw them, with the
    // checksum of what it saw.
    match v.apply_update(update(2, [18, 19], -31)) {
        ok(seen) => {
            check_int(i64.wrap(seen.len()), 2)
            check("{seen[0].bytes == a.bytes} {seen[1].bytes == b.bytes}", "true true")
        },
        err(p) => panic(p),
    }
    // Once seen, they can't be unseen, but the checksum can be left out.
    check(applied(mut v, update(0, [18, 19], 0)), "ok")
    let unseen = applied(mut v, update(0, [19], 0))
    if not unseen.starts_with("Last seen update ignored previously acknowledged message at index 18 and signature AAECAwQFBgcICQoL") {
        panic(unseen)
    }
    println("ok window")
}

fn refused() {
    // What wasn't sent can't be seen.
    var v = LastSeenValidator.new()
    check(applied(mut v, update(0, [0], 0)), "Last seen update acknowledged unknown or previously ignored message at index 0")
    // Bits past the 20th count toward the window's length, as a `BitSet`'s do.
    var w = LastSeenValidator.new()
    check(applied(mut w, update(0, [20], 0)), "Last seen update contained 21 messages, but maximum window size is 20")
    var x = LastSeenValidator.new()
    check(applied(mut x, update(0, [23], 0)), "Last seen update contained 24 messages, but maximum window size is 20")
    // A checksum that isn't what the server makes of the same messages.
    var y = LastSeenValidator.new()
    y.add_pending(signature(0, false))
    check(applied(mut y, update(1, [19], 5)), "Checksum mismatch on last seen update: the client and server must have desynced")
    // A message the client ignored is gone, so it can't be seen later.
    var z = LastSeenValidator.new()
    z.add_pending(signature(0, false))
    check(applied(mut z, update(1, [], 0)), "ok")
    check(applied(mut z, update(0, [19], 0)), "Last seen update acknowledged unknown or previously ignored message at index 19")
    println("ok refused")
}

fn main() {
    illegal()
    throttle()
    checksums()
    window()
    refused()
    println("ok")
}
