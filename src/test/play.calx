import world.pos.{ChunkPos}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn check_int(got: i64, want: i64) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn core() -> KnownPack {
    return KnownPack { namespace: "minecraft", id: "core", version: "26.3" }
}

fn new_server(link: own Link, services: own Services, rate_limit: i32, login_throttle: i32, force_view: i32) -> Network {
    let packs: List<KnownPack?> = [some(core())]
    let configuration = Configuration.new("calcite", [], [Identifier { namespace: "minecraft", path: "vanilla" }], Registries { synced: [], builtin: [] }, packs)
    let settings = LoginSettings { online_mode: false, accepts_transfers: false, compression_threshold: -1, log_ips: true, prevent_proxy_connections: false, velocity_secret: none, rate_limit: rate_limit, login_throttle: login_throttle }
    let status = StatusInfo { enabled: true, status: ServerStatus.starting(Component.literal("A Minecraft Server"), 20, none), motd: "A Minecraft Server" }
    var lang = Language.empty()
    lang.add("multiplayer.player.joined", "%s joined the game")
    lang.add("multiplayer.player.left", "%s left the game")
    // Not vanilla's text, which stays out of the repository, but in the same form.
    lang.add("chat.type.text", "%s says %s")
    lang.add("chat.disabled.missingProfileKey", "no key")
    var world = World.defaults()
    world.settings.force_view_distance = force_view
    return Network.new(link, status, settings, lang, services, key_ready(RsaKey.generate(1024)), configuration, world)
}

fn packet<T: Wire + Packet>(p: T, state: State) -> List<u8> {
    var w = Writer.new()
    write_packet(p, state, mut w)
    return w.into_bytes()
}

fn play<T: Wire + Packet>(p: T) -> List<u8> {
    return packet(p, State.Play)
}

// A packet the client was sent, by its name in play, with the fields after its ID; or
// `nothing`, or `closed` once the server closed the connection and nothing is left.
struct Got {
    name: String
    body: List<u8>
}

struct Client {
    conn: Conn
    codec: Codec
    closed: bool
    // The state the client reads in, which names the packets.
    state: State
}

impl Client {
    fn send(mut self, net: Net, p: own List<u8>) {
        net.write(self.conn, self.codec.encode(p)!)
    }

    fn next(mut self) -> Got {
        let body = match self.codec.next()! {
            some(b) => b,
            none => return Got { name: if self.closed { String("closed") } else { String("nothing") }, body: [] },
        }
        capture(self.state, body)
        var r = Reader.new(body)
        let id = usize.wrap(r.varint()!)
        let names = packet_names(self.state, Bound.Clientbound)
        return Got { name: names[id].copy(), body: r.rest() }
    }

    // The names of what came, up to the first that isn't one of `skip`, which is returned.
    fn after(mut self, skip: List<String>) -> Got {
        loop {
            let got = self.next()
            var skipped = false
            for s in skip {
                if got.name == s {
                    skipped = true
                }
            }
            if not skipped {
                return got
            }
        }
    }

    // Reads everything that came.
    fn drain(mut self) {
        loop {
            let got = self.next()
            if got.name == "nothing" or got.name == "closed" {
                return
            }
        }
    }
}

// Where the packets clients are sent go, for `oracle/vanilla-adapter`'s `PacketCheck`.
fn capture_path() -> String {
    return String("build/packets/play.bin")
}

// Adds a packet a client was sent in `state` to the capture: its state's number, as vanilla's
// `ConnectionProtocol` orders them from handshake at 0, its length as 4 bytes, big-endian, then
// its ID and fields.
fn capture(state: State, sent: List<u8>) {
    let number: u8 = match state {
        State.Handshake => 0,
        State.Status => 1,
        State.Login => 2,
        State.Configuration => 3,
        State.Play => 4,
    }
    var w = Writer.new()
    w.u8(number)
    w.i32(i32.wrap(sent.len()))
    w.raw(sent)
    append(capture_path(), w.into_bytes())!
}

// A server and its clients, on a clock the test moves.
struct Rig {
    net: Net
    server: Network
    port: u16
    clients: List<Client>
    now: u64
    // The server's `rate-limit`, `login-throttle` and `force-view-distance`, which its replay
    // has too.
    rate_limit: i32
    login_throttle: i32
    force_view: i32
}

impl Rig {
    // Polls until nothing more comes for 50 ms, giving the server its events and the clients
    // what they were sent.
    fn settle(mut self) {
        loop {
            var events = List<Event>()
            self.net.poll(50, mut events)
            if events.is_empty() {
                return
            }
            for e in events {
                if self.server.handle(e, self.now) {
                    continue
                }
                for i in 0..self.clients.len() {
                    match e {
                        Event.Received(c) => {
                            if c == self.clients[i].conn {
                                _ = self.clients[i].codec.read_from(self.net, c)
                            }
                        },
                        Event.Closed(c) => {
                            if c == self.clients[i].conn {
                                self.clients[i].closed = true
                            }
                        },
                        _ => {},
                    }
                }
            }
        }
    }

    fn send(mut self, client: usize, p: own List<u8>) {
        let net = self.net
        self.clients[client].send(net, p)
        self.settle()
    }

    // A server tick, `ms` milliseconds after the last.
    fn tick(mut self, ms: u64) {
        self.now += ms * 1000000
        self.server.tick(self.now)
        self.settle()
    }

    fn next(mut self, client: usize) -> Got {
        return self.clients[client].next()
    }

    fn expect(mut self, client: usize, names: List<String>) {
        for name in names {
            check(self.clients[client].next().name, name)
        }
    }

    // Replays what the server was handed into another made the same way, with `services`,
    // which must send and log what this one did.
    fn replays(mut self, services: own Services) {
        _ = self.server.take_logs()
        var replay = new_server(Link.replay(self.server.take_log())!, services, self.rate_limit, self.login_throttle, self.force_view)
        let report = replay.replay_all()
        assert(report.same(), "the replay differs: {report.to_string()}")
    }

    // The server's log since the last call.
    fn logs(mut self) -> String {
        var out = String()
        for e in self.server.take_logs() {
            out.push_str("{e.message}|")
        }
        return out
    }

    // A client that connects and sends the handshake for a login, and nothing else.
    fn try_login(mut self) -> usize {
        let conn = self.net.connect("127.0.0.1", self.port)!
        self.clients.push(Client { conn: conn, codec: Codec.new(), closed: false, state: State.Login })
        let at = self.clients.len() - 1
        self.settle()
        let intention = ClientIntention { protocol_version: 777, host_name: "localhost", port: 25565, intention: ClientIntent.Login }
        self.send(at, packet(intention, State.Handshake))
        return at
    }

    // A player who logs in and goes through configuration, up to finishing it.
    fn join(mut self, name: String) -> usize {
        let conn = self.net.connect("127.0.0.1", self.port)!
        self.clients.push(Client { conn: conn, codec: Codec.new(), closed: false, state: State.Login })
        let at = self.clients.len() - 1
        self.settle()
        let intention = ClientIntention { protocol_version: 777, host_name: "localhost", port: 25565, intention: ClientIntent.Login }
        let net = self.net
        self.clients[at].send(net, packet(intention, State.Handshake))
        self.send(at, packet(ServerboundHello { name: name.copy(), profile_id: Uuid.new(0, 0) }, State.Login))
        self.tick(50)
        self.clients[at].drain()
        self.send(at, packet(ServerboundLoginAcknowledged {}, State.Login))
        self.clients[at].state = State.Configuration
        self.send(at, packet(ServerboundClientInformation { information: information() }, State.Configuration))
        self.send(at, packet(ServerboundSelectKnownPacks { packs: [core()] }, State.Configuration))
        self.tick(50)
        self.clients[at].drain()
        self.clients[at].state = State.Play
        self.send(at, packet(ServerboundFinishConfiguration {}, State.Configuration))
        return at
    }

    // Takes the batch the client was sent, if one came, past the time sent each second: the
    // chunks' positions, in order.
    fn batch(mut self, client: usize) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        let start = self.clients[client].after(["set_time"])
        if start.name == "nothing" {
            return out
        }
        check(start.name, "chunk_batch_start")
        loop {
            let got = self.next(client)
            if got.name == "chunk_batch_finished" {
                var r = Reader.new(got.body)
                check_int(i64(r.varint()!), i64.wrap(out.len()))
                return out
            }
            check(got.name, "level_chunk_with_light")
            var r = Reader.new(got.body)
            let x = r.i32()!
            let z = r.i32()!
            out.push(ChunkPos { x: x, z: z })
        }
    }
}

fn information() -> ClientInformation {
    return ClientInformation { language: "en_us", view_distance: 12, chat_visibility: ChatVisibility.Full, chat_colors: true, model_customisation: 127, main_hand: HumanoidArm.Right, text_filtering_enabled: false, allows_listing: true, particle_status: ParticleStatus.All }
}

fn new_rig() -> Rig {
    return new_rig_with(Services.offline())
}

fn new_rig_with(services: own Services) -> Rig {
    return new_rig_limited(services, 0, 0)
}

fn new_rig_limited(services: own Services, rate_limit: i32, login_throttle: i32) -> Rig {
    return new_rig_settings(services, rate_limit, login_throttle, 0)
}

fn new_rig_settings(services: own Services, rate_limit: i32, login_throttle: i32, force_view: i32) -> Rig {
    let net = Net.new()!
    let server = new_server(Link.record(net), services, rate_limit, login_throttle, force_view)
    let port = server.listen("127.0.0.1", 0)!
    return Rig { net: net, server: server, port: port, clients: [], now: 0, rate_limit: rate_limit, login_throttle: login_throttle, force_view: force_view }
}

// Everything that's sent as a player joins, in vanilla's order, before their chunks.
fn joining() -> List<String> {
    return [
        "login", "change_difficulty", "player_abilities", "set_held_slot", "update_recipes",
        "entity_event", "commands", "recipe_book_settings", "recipe_book_add", "player_position",
        "server_data", "player_info_update", "player_info_update", "initialize_border", "set_time",
        "set_default_spawn_position", "game_event", "ticking_state", "ticking_step",
        "set_chunk_cache_center", "post_effects", "container_set_content", "nothing",
    ]
}

// Sends chunk batches, acknowledging each, until the client has every chunk it's to have.
fn load_all(rig: mut Rig, client: usize) -> List<ChunkPos> {
    var all = List<ChunkPos>()
    loop {
        rig.tick(50)
        let batch = rig.batch(client)
        if batch.is_empty() {
            return all
        }
        for c in batch {
            all.push(c)
        }
        rig.send(client, play(ServerboundChunkBatchReceived { desired_chunks_per_tick: 25.0 }))
    }
}

fn join() {
    var rig = new_rig()
    let steve = rig.join("Steve")
    rig.expect(steve, joining())
    let log = rig.logs()
    let at = log.find("[/127.0.0.1:") else panic("no address in {log}")
    check(log[..at], "Steve")
    let end = log.find("] logged in") else panic("no login in {log}")
    check(log[end..], "] logged in with entity id 1 at (0.5, -60.0, 0.5)|System chat: Steve joined the game|")

    // The first batch is as many as the client is first thought to want, 9, nearest first;
    // the next waits for the client to say it has it.
    rig.tick(50)
    let first = rig.batch(steve)
    check_int(i64.wrap(first.len()), 9)
    check_int(i64(first[0].x), 0)
    check_int(i64(first[0].z), 0)
    for c in first {
        if c.distance_squared(ChunkPos { x: 0, z: 0 }) > 2 {
            panic("{c.x}, {c.z} isn't among the nearest")
        }
    }
    rig.tick(50)
    check(rig.next(steve).name, "nothing")
    rig.send(steve, play(ServerboundChunkBatchReceived { desired_chunks_per_tick: 25.0 }))
    rig.tick(50)
    check_int(i64.wrap(rig.batch(steve).len()), 25)
    rig.send(steve, play(ServerboundChunkBatchReceived { desired_chunks_per_tick: 25.0 }))
    var have = load_all(mut rig, steve)
    for c in first {
        have.push(c)
    }
    // The view is the client's 12 chunks, down to the server's 10, and every chunk in it came
    // once.
    let view = in_view_all(ChunkPos { x: 0, z: 0 }, 10)
    check_int(i64.wrap(have.len()) + 25, i64.wrap(view.len()))
    rig.replays(Services.offline())
    println("ok join")
}

fn moving() {
    var rig = new_rig()
    let steve = rig.join("Steve")
    rig.clients[steve].drain()
    // A move before the teleport is accepted doesn't count.
    rig.send(steve, play(ServerboundMovePlayerPos { x: 40.5, y: -60.0, z: 0.5, flags: ON_GROUND }))
    rig.send(steve, play(ServerboundClientTickEnd {}))
    check(rig.next(steve).name, "nothing")
    // Nor does one more than 20 ticks later, and the teleport is sent again.
    _ = load_all(mut rig, steve)
    rig.send(steve, play(ServerboundMovePlayerPos { x: 40.5, y: -60.0, z: 0.5, flags: ON_GROUND }))
    rig.send(steve, play(ServerboundClientTickEnd {}))
    let again = rig.next(steve)
    check(again.name, "player_position")
    var t = Reader.new(again.body)
    check_int(i64(t.varint()!), 2)
    check(rig.next(steve).name, "nothing")
    // Once it's accepted, a move two chunks east moves the view: the chunks that left it are
    // forgotten and those that came in are sent.
    rig.send(steve, play(ServerboundAcceptTeleportation { teleport_id: 2, x: 0.5, y: -60.0, z: 0.5, y_rot: 0.0, x_rot: 0.0 }))
    check(rig.next(steve).name, "nothing")
    rig.send(steve, play(ServerboundMovePlayerPos { x: 40.5, y: -60.0, z: 0.5, flags: ON_GROUND }))
    let center = rig.next(steve)
    check(center.name, "set_chunk_cache_center")
    var r = Reader.new(center.body)
    check_int(i64(r.varint()!), 2)
    check_int(i64(r.varint()!), 0)
    let old = ChunkPos { x: 0, z: 0 }
    let new = ChunkPos { x: 2, z: 0 }
    var left = 0
    var came = 0
    for x in -14..15 {
        for z in -14..15 {
            let saw = in_view(old, 10, x, z)
            let sees = in_view(new, 10, x, z)
            if saw and not sees {
                left += 1
            } else if sees and not saw {
                came += 1
            }
        }
    }
    var forgotten = 0
    loop {
        let got = rig.next(steve)
        if got.name == "nothing" {
            break
        }
        check(got.name, "forget_level_chunk")
        var f = Reader.new(got.body)
        let packed = f.i64()!
        let x = i32.wrap(packed)
        let z = i32.wrap(packed >> 32)
        if in_view(new, 10, x, z) {
            panic("{x}, {z} is still in view")
        }
        forgotten += 1
    }
    check_int(i64(forgotten), i64(left))
    rig.send(steve, play(ServerboundClientTickEnd {}))
    let sent = load_all(mut rig, steve)
    check_int(i64.wrap(sent.len()), i64(came))
    for c in sent {
        if in_view(old, 10, c.x, c.z) {
            panic("{c.x}, {c.z} was in view already")
        }
    }
    // Two moves in one tick are one too many.
    rig.send(steve, play(ServerboundMovePlayerPos { x: 40.5, y: -60.0, z: 1.5, flags: ON_GROUND }))
    rig.send(steve, play(ServerboundMovePlayerPos { x: 40.5, y: -60.0, z: 2.5, flags: ON_GROUND }))
    check(rig.next(steve).name, "disconnect")
    rig.replays(Services.offline())
    println("ok moving")
}

fn forced_view() {
    // With force-view-distance at 16, a client that asks for 12, on a server whose
    // view-distance is 10, is sent 16, and told so in the login.
    var rig = new_rig_settings(Services.offline(), 0, 0, 16)
    let steve = rig.join("Steve")
    let login = rig.next(steve)
    check(login.name, "login")
    var r = Reader.new(login.body)
    check_int(i64(ClientboundLogin.read(mut r)!.chunk_radius), 16)
    rig.clients[steve].drain()
    let log = rig.logs()
    if log.find("|Steve asks for a view distance of 12 and is sent 16, from force-view-distance|") == none {
        panic("no forced view in {log}")
    }
    let have = load_all(mut rig, steve)
    let view = in_view_all(ChunkPos { x: 0, z: 0 }, 16)
    check_int(i64.wrap(have.len()), i64.wrap(view.len()))
    check_int(i64.wrap(in_view_count(16)), i64.wrap(view.len()))
    for c in view {
        if not have.contains(c) {
            panic("{c.x}, {c.z} wasn't sent")
        }
    }
    check("{rig.server.chunks_in_view()}", "{view.len()}")
    // Asking for less changes nothing but the log.
    var less = information()
    less.view_distance = 2
    rig.send(steve, play(ServerboundClientInformation { information: less }))
    rig.tick(50)
    check(rig.next(steve).name, "nothing")
    check(rig.logs(), "Steve asks for a view distance of 2 and is sent 16, from force-view-distance|")
    // Once the client accepts its position, a move a chunk south and east forgets and sends
    // the chunks at the view's edge alone.
    rig.send(steve, play(ServerboundMovePlayerPos { x: 16.5, y: -60.0, z: 16.5, flags: ON_GROUND }))
    rig.send(steve, play(ServerboundClientTickEnd {}))
    let again = rig.next(steve)
    check(again.name, "player_position")
    var t = Reader.new(again.body)
    let teleport = t.varint()!
    rig.send(steve, play(ServerboundAcceptTeleportation { teleport_id: teleport, x: 0.5, y: -60.0, z: 0.5, y_rot: 0.0, x_rot: 0.0 }))
    rig.send(steve, play(ServerboundMovePlayerPos { x: 16.5, y: -60.0, z: 16.5, flags: ON_GROUND }))
    check(rig.next(steve).name, "set_chunk_cache_center")
    let new = ChunkPos { x: 1, z: 1 }
    var forgotten = 0
    loop {
        let got = rig.next(steve)
        if got.name == "nothing" {
            break
        }
        check(got.name, "forget_level_chunk")
        var f = Reader.new(got.body)
        let packed = f.i64()!
        if in_view(new, 16, i32.wrap(packed), i32.wrap(packed >> 32)) {
            panic("a chunk still in view was forgotten")
        }
        forgotten += 1
    }
    var left = 0
    var came = 0
    for x in -19..20 {
        for z in -19..20 {
            let saw = in_view(ChunkPos { x: 0, z: 0 }, 16, x, z)
            let sees = in_view(new, 16, x, z)
            if saw and not sees {
                left += 1
            } else if sees and not saw {
                came += 1
            }
        }
    }
    check_int(i64(forgotten), i64(left))
    rig.send(steve, play(ServerboundChunkBatchReceived { desired_chunks_per_tick: 25.0 }))
    let sent = load_all(mut rig, steve)
    check_int(i64.wrap(sent.len()), i64(came))
    rig.replays(Services.offline())
    println("ok forced view")
}

fn others() {
    var rig = new_rig()
    let steve = rig.join("Steve")
    rig.clients[steve].drain()
    _ = load_all(mut rig, steve)
    _ = rig.logs()
    // Steve is told Alex joined, and sees them in the tab list; Alex is sent Steve, then
    // themself, and not their own joining.
    let alex = rig.join("Alex")
    check(rig.next(steve).name, "system_chat")
    check(rig.next(steve).name, "player_info_update")
    check(rig.next(steve).name, "nothing")
    check(rig.clients[alex].after(["login", "change_difficulty", "player_abilities", "set_held_slot", "update_recipes", "entity_event", "commands", "recipe_book_settings", "recipe_book_add", "player_position", "server_data"]).name, "player_info_update")
    let them = rig.next(alex)
    check(them.name, "player_info_update")
    let log = rig.logs()
    let at = log.find("|System chat: ") else panic("no join message in {log}")
    check(log[at..], "|System chat: Alex joined the game|")
    // The console's bar counts both, and the chunks their views hold between them once each.
    let spawn = in_view_all(ChunkPos { x: 0, z: 0 }, 10).len()
    check("{rig.server.players_online()} {rig.server.max_players()} {rig.server.chunks_in_view()}", "2 20 {spawn}")
    rig.clients[alex].drain()
    // As Alex leaves, Steve is told, and they're taken off the tab list.
    let conn = rig.clients[alex].conn
    rig.net.close(conn)
    rig.settle()
    check(rig.next(steve).name, "system_chat")
    check(rig.next(steve).name, "player_info_remove")
    check(rig.logs(), "Alex lost connection: disconnect.endOfStream|System chat: Alex left the game|")
    check("{rig.server.players_online()} {rig.server.chunks_in_view()}", "1 {spawn}")
    rig.replays(Services.offline())
    println("ok others")
}

fn keep_alive() {
    var rig = new_rig()
    let steve = rig.join("Steve")
    rig.clients[steve].drain()
    _ = load_all(mut rig, steve)
    // The keep-alive is 15 seconds after the last, which was configuration's first.
    rig.tick(15000)
    let k = rig.clients[steve].after(["chunk_batch_start", "level_chunk_with_light", "chunk_batch_finished", "set_time"])
    check(k.name, "keep_alive")
    var r = Reader.new(k.body)
    let challenge = r.i64()!
    rig.send(steve, play(ServerboundKeepAlive { challenge: challenge }))
    rig.clients[steve].drain()
    rig.tick(14000)
    rig.clients[steve].drain()
    if rig.clients[steve].closed {
        panic("Steve was disconnected")
    }
    rig.replays(Services.offline())
    println("ok keep_alive")
}

// The clock the server stamps messages with in these tests.
const CLOCK_MS: i64 = 1761696000000

// A message as a client without a chat session sends it, having seen nothing.
fn say(text: String) -> List<u8> {
    return play(ServerboundChat { message: text.copy(), time_stamp: 42, salt: 7, signature: none, last_seen: LastSeenUpdate.empty() })
}

fn command(text: String) -> List<u8> {
    return play(ServerboundChatCommand { command: text.copy() })
}

// A packet's fields, as they follow its ID.
fn fields<T: Wire>(p: T) -> List<u8> {
    var w = Writer.new()
    p.write(mut w)
    return w.into_bytes()
}

// The player chat packet vanilla sends of an unsigned message from `name`, the `global`th its
// recipient was sent.
fn player_chat(name: String, text: String, global: i32) -> List<u8> {
    let profile = GameProfile.offline(name)
    let body = SignedBody { content: text.copy(), time_stamp: CLOCK_MS, salt: 0, last_seen: [] }
    let chat = ChatTypeBound { chat_type: 0, name: display_name(profile), target_name: none }
    return fields(ClientboundPlayerChat { global_index: global, sender: profile.id, index: 0, signature: none, body: body, unsigned_content: none, filter_mask: FilterMask.PassThrough, chat_type: chat })
}

fn system(content: own Component) -> List<u8> {
    return fields(ClientboundSystemChat { content: content, overlay: false })
}

fn expect_bytes(rig: mut Rig, client: usize, name: String, want: List<u8>) {
    let got = rig.next(client)
    check(got.name, name)
    if got.body != want {
        panic("{name}: got {got.body}, want {want}")
    }
}

// Two players in the world, with everything they were sent as they joined read.
fn two(rig: mut Rig) -> (usize, usize) {
    rig.server.set_clock(Timestamp { unix_ms: CLOCK_MS })
    let steve = rig.join("Steve")
    let alex = rig.join("Alex")
    rig.clients[steve].drain()
    rig.clients[alex].drain()
    _ = rig.logs()
    return (steve, alex)
}

fn chatting() {
    var rig = new_rig()
    let (steve, alex) = two(mut rig)
    // Everyone gets the message, the sender too, unsigned and stamped with the server's clock,
    // and the console logs it as not secure.
    rig.send(steve, say("hello"))
    expect_bytes(mut rig, steve, "player_chat", player_chat("Steve", "hello", 0))
    expect_bytes(mut rig, alex, "player_chat", player_chat("Steve", "hello", 0))
    check(rig.logs(), "[Not Secure] Steve says hello|")
    // Each player counts what they were sent.
    rig.send(alex, say("hi"))
    expect_bytes(mut rig, steve, "player_chat", player_chat("Alex", "hi", 1))
    expect_bytes(mut rig, alex, "player_chat", player_chat("Alex", "hi", 1))
    check(rig.next(steve).name, "nothing")
    check(rig.next(alex).name, "nothing")
    check(rig.logs(), "[Not Secure] Alex says hi|")
    // A player who hides chat gets none, and can't send any: they're told so, in red, and the
    // others see nothing.
    var hidden = information()
    hidden.chat_visibility = ChatVisibility.Hidden
    rig.send(alex, play(ServerboundClientInformation { information: hidden }))
    rig.clients[alex].drain()
    rig.send(steve, say("anyone?"))
    expect_bytes(mut rig, steve, "player_chat", player_chat("Steve", "anyone?", 2))
    check(rig.next(alex).name, "nothing")
    rig.send(alex, say("me"))
    expect_bytes(mut rig, alex, "system_chat", system(Component.translatable("chat.disabled.options", []).colored("red")))
    check(rig.next(alex).name, "nothing")
    check(rig.next(steve).name, "nothing")
    check(rig.logs(), "[Not Secure] Steve says anyone?|")
    // A player who shows only system messages gets those, and not the others' chat.
    var system_only = information()
    system_only.chat_visibility = ChatVisibility.System
    rig.send(alex, play(ServerboundClientInformation { information: system_only }))
    rig.clients[alex].drain()
    rig.send(steve, say("still there?"))
    expect_bytes(mut rig, steve, "player_chat", player_chat("Steve", "still there?", 3))
    check(rig.next(alex).name, "nothing")
    // A character chat can't have ends the connection.
    rig.send(alex, say("§cred"))
    check(rig.next(alex).name, "disconnect")
    rig.replays(Services.offline())
    println("ok chatting")
}

fn commands() {
    var rig = new_rig()
    let (steve, alex) = two(mut rig)
    // Calcite has no commands yet, so each is unknown, and only the player who sent it is told,
    // with where it went wrong, which they can click to send again.
    rig.send(steve, command("spawn here"))
    let unknown = Component.translatable("command.unknown.command", [])
    var failure = Component.empty().colored("red")
    failure.extra.push(unknown.copy())
    expect_bytes(mut rig, steve, "system_chat", system(failure))
    var context = Component.empty().colored("gray")
    context.style.click_event = some(ClickEvent.SuggestCommand("/spawn here"))
    context.extra.push(Component.literal(""))
    var rest = Component.literal("spawn here").colored("red")
    rest.style.underlined = some(true)
    context.extra.push(rest)
    var here = Component.translatable("command.context.here", []).colored("red")
    here.style.italic = some(true)
    context.extra.push(here.copy())
    var second = Component.empty().colored("red")
    second.extra.push(context)
    expect_bytes(mut rig, steve, "system_chat", system(second))
    check(rig.next(steve).name, "nothing")
    check(rig.next(alex).name, "nothing")
    check(rig.logs(), "")
    // An empty command has nothing to underline.
    rig.send(steve, command(""))
    check(rig.next(steve).name, "system_chat")
    var empty = Component.empty().colored("gray")
    empty.style.click_event = some(ClickEvent.SuggestCommand("/"))
    empty.extra.push(Component.literal(""))
    empty.extra.push(here)
    var third = Component.empty().colored("red")
    third.extra.push(empty)
    expect_bytes(mut rig, steve, "system_chat", system(third))
    // A player who hides chat can still send commands, but isn't told what came of them.
    var hidden = information()
    hidden.chat_visibility = ChatVisibility.Hidden
    rig.send(alex, play(ServerboundClientInformation { information: hidden }))
    rig.clients[alex].drain()
    rig.send(alex, command("help"))
    check(rig.next(alex).name, "nothing")
    rig.replays(Services.offline())
    println("ok commands")
}

fn spam() {
    var rig = new_rig()
    let (steve, alex) = two(mut rig)
    // Ten seconds' worth of messages at once is one too many, after which the player is kicked,
    // once the last has gone out.
    for _ in 0..9 {
        rig.send(steve, say("buy now"))
    }
    // A tick takes one back.
    rig.tick(50)
    rig.clients[steve].drain()
    rig.clients[alex].drain()
    rig.send(steve, say("buy now"))
    check(rig.clients[steve].after(["set_time"]).name, "player_chat")
    check(rig.next(steve).name, "nothing")
    rig.send(steve, say("buy now"))
    check(rig.next(steve).name, "player_chat")
    check(rig.next(steve).name, "disconnect")
    check(rig.next(alex).name, "player_chat")
    check(rig.next(alex).name, "player_chat")
    // Commands count apart from chat.
    for _ in 0..9 {
        rig.send(alex, command("x"))
    }
    rig.clients[alex].drain()
    rig.send(alex, command("x"))
    rig.clients[alex].drain()
    if not rig.clients[alex].closed {
        panic("Alex wasn't kicked")
    }
    let log = rig.logs()
    let at = log.find("Steve lost connection: ") else panic("Steve wasn't kicked: {log}")
    check(log[at..at + 38], "Steve lost connection: disconnect.spam")
    rig.replays(Services.offline())
    println("ok spam")
}

fn acknowledgements() {
    var rig = new_rig()
    let (steve, alex) = two(mut rig)
    // The window can't move past messages that weren't sent, and a client that says it can is
    // disconnected, with vanilla's exception logged.
    rig.send(steve, play(ServerboundChatAck { offset: 1 }))
    check(rig.next(steve).name, "disconnect")
    check(rig.logs(), "Failed to validate message acknowledgement offset from Steve\nnet.minecraft.network.chat.LastSeenMessagesValidator$ValidationException: Advanced last seen window by 1 messages, but expected at most 0|Steve lost connection: multiplayer.disconnect.chat_validation_failed|System chat: Steve left the game|")
    // Nor can a message say it saw one that wasn't, which is checked before anything else.
    rig.clients[alex].drain()
    rig.send(alex, play(ServerboundChat { message: "§", time_stamp: 0, salt: 0, signature: none, last_seen: LastSeenUpdate { offset: 0, acknowledged: [1, 0, 0], checksum: 0 } }))
    check(rig.next(alex).name, "disconnect")
    check(rig.logs(), "Failed to validate message acknowledgements from Alex\nnet.minecraft.network.chat.LastSeenMessagesValidator$ValidationException: Last seen update acknowledged unknown or previously ignored message at index 0|Alex lost connection: multiplayer.disconnect.chat_validation_failed|System chat: Alex left the game|")
    rig.replays(Services.offline())
    println("ok acknowledgements")
}

// Signed chat. A key of the test's own stands in for Mojang's, which signs players' chat keys.
const HOUR_MS: i64 = 3600000

fn mojang_keys(mojang: RsaKey) -> Services {
    return Services.with_keys(KeySet { profile_property: [], player_certificate: [mojang.public_der()] })
}

// A chat session of `name`'s, with `key`, which expires at `expires_at`, signed by `services`
// as Mojang signs a player's key.
fn session_of(name: String, services: RsaKey, key: RsaKey, expires_at: i64) -> ChatSession {
    let id = GameProfile.offline(name).id
    var session = ChatSession { session_id: Uuid.new(7, expires_at), expires_at: expires_at, key: key.public_key(), key_signature: [] }
    session.key_signature = services.sign(Algorithm.Sha1, key_payload(id, session))
    return session
}

// The signature of the `index`th message of `name`'s session, as their client signs it.
fn sign_message(name: String, key: RsaKey, session: ChatSession, index: i32, body: MessageBody) -> MessageSignature {
    let id = GameProfile.offline(name).id
    return MessageSignature { bytes: key.sign(Algorithm.Sha256, signed_payload(id, session.session_id, index, body)) }
}

// A message as a client sends it, with what it says it saw.
fn chat_packet(body: MessageBody, signature: MessageSignature?, update: own LastSeenUpdate) -> List<u8> {
    return play(ServerboundChat { message: body.content.copy(), time_stamp: body.time_stamp, salt: body.salt, signature: signature.copy(), last_seen: update })
}

// What a client says it saw: its window moved on by `offset`, with the last `count` of its 20
// acknowledged, and no checksum.
fn seen_last(count: usize, offset: i32) -> LastSeenUpdate {
    var bits: List<u8> = [0, 0, 0]
    for i in (20 - count)..20 {
        bits[i / 8] = bits[i / 8] | u8.wrap(1 << i32.wrap(i % 8))
    }
    return LastSeenUpdate { offset: offset, acknowledged: bits, checksum: 0 }
}

// The player chat packet vanilla sends of a signed message from `name`, the `global`th its
// recipient was sent, with the signatures its sender saw as the recipient's cache packs them.
fn signed_player_chat(name: String, body: MessageBody, global: i32, index: i32, signature: MessageSignature, seen: own List<PackedSignature>) -> List<u8> {
    let profile = GameProfile.offline(name)
    let packed = SignedBody { content: body.content.copy(), time_stamp: body.time_stamp, salt: body.salt, last_seen: seen }
    let chat = ChatTypeBound { chat_type: 0, name: display_name(profile), target_name: none }
    return fields(ClientboundPlayerChat { global_index: global, sender: profile.id, index: index, signature: some(signature.copy()), body: packed, unsigned_content: none, filter_mask: FilterMask.PassThrough, chat_type: chat })
}

fn cached(id: i32) -> PackedSignature {
    return PackedSignature { id: id, full: none }
}

// The tab list update that tells everyone of `name`'s chat session.
fn initialize_chat(name: String, session: ChatSession?) -> List<u8> {
    let player = PlayerEntry { id: GameProfile.offline(name).id, chat_session: session.copy() }
    return fields(ClientboundPlayerInfoUpdate { info: PlayerInfo { actions: INITIALIZE_CHAT, entries: [player] } })
}

fn refused(problem: String) -> List<u8> {
    return system(Component.translatable(problem, []).colored("red"))
}

fn signed_chat() {
    let mojang = RsaKey.generate(1024)
    var rig = new_rig_with(mojang_keys(mojang))
    let (steve, alex) = two(mut rig)
    // Steve's session goes to everyone, Steve too; the same key again is nothing new.
    let key = RsaKey.generate(2048)
    let session = session_of("Steve", mojang, key, CLOCK_MS + HOUR_MS)
    rig.send(steve, play(ServerboundChatSessionUpdate { session: session.copy() }))
    expect_bytes(mut rig, alex, "player_info_update", initialize_chat("Steve", some(session.copy())))
    expect_bytes(mut rig, steve, "player_info_update", initialize_chat("Steve", some(session.copy())))
    rig.send(steve, play(ServerboundChatSessionUpdate { session: session.copy() }))
    check(rig.next(steve).name, "nothing")
    check(rig.logs(), "")

    // A signed message goes to everyone with its signature, and the console logs it as it is.
    let hello = MessageBody { content: "hello", time_stamp: CLOCK_MS, salt: 99, last_seen: [] }
    let s0 = sign_message("Steve", key, session, 0, hello)
    rig.send(steve, chat_packet(hello, some(s0.copy()), LastSeenUpdate.empty()))
    expect_bytes(mut rig, steve, "player_chat", signed_player_chat("Steve", hello, 0, 0, s0, []))
    expect_bytes(mut rig, alex, "player_chat", signed_player_chat("Steve", hello, 0, 0, s0, []))
    check(rig.logs(), "Steve says hello|")

    // Alex has no session, so his message is unsigned, though he says he saw Steve's, and
    // the checksum of what he saw matches.
    var saw = seen_last(1, 1)
    saw.checksum = checksum([s0.copy()])
    rig.send(alex, play(ServerboundChat { message: "hi", time_stamp: 5, salt: 6, signature: none, last_seen: saw }))
    expect_bytes(mut rig, steve, "player_chat", player_chat("Alex", "hi", 1))
    expect_bytes(mut rig, alex, "player_chat", player_chat("Alex", "hi", 1))
    check(rig.logs(), "[Not Secure] Alex says hi|")

    // Steve's next message is the next in his chain, signed with what he saw, which each client
    // is sent by its place in its cache.
    let again = MessageBody { content: "again", time_stamp: CLOCK_MS + 1000, salt: 100, last_seen: [s0.copy()] }
    let s1 = sign_message("Steve", key, session, 1, again)
    rig.send(steve, chat_packet(again, some(s1.copy()), seen_last(1, 1)))
    expect_bytes(mut rig, steve, "player_chat", signed_player_chat("Steve", again, 2, 1, s1, [cached(0)]))
    expect_bytes(mut rig, alex, "player_chat", signed_player_chat("Steve", again, 2, 1, s1, [cached(0)]))
    check(rig.logs(), "Steve says again|")

    // A signature that isn't Steve's of the message is refused, which breaks the chain, so the
    // next is refused too, however it's signed. So is one that isn't signed at all.
    let tampered = MessageBody { content: "agian", time_stamp: CLOCK_MS + 2000, salt: 101, last_seen: [s0.copy(), s1.copy()] }
    rig.send(steve, chat_packet(tampered, some(sign_message("Steve", key, session, 2, again)), seen_last(2, 1)))
    expect_bytes(mut rig, steve, "system_chat", refused("chat.disabled.invalid_signature"))
    check(rig.next(alex).name, "nothing")
    check(rig.logs(), "Failed to update secure chat state for Steve: 'chat.disabled.invalid_signature'|")
    rig.send(steve, chat_packet(tampered, some(sign_message("Steve", key, session, 2, tampered)), seen_last(2, 0)))
    expect_bytes(mut rig, steve, "system_chat", refused("chat.disabled.chain_broken"))
    check(rig.logs(), "Failed to update secure chat state for Steve: 'chat.disabled.chain_broken'|")
    rig.send(steve, chat_packet(tampered, none, seen_last(2, 0)))
    expect_bytes(mut rig, steve, "system_chat", refused("chat.disabled.missingProfileKey"))
    check(rig.next(alex).name, "nothing")
    check(rig.logs(), "Failed to update secure chat state for Steve: 'no key'|")

    // A new key starts a new chain, and everyone is told of it.
    let renewed_key = RsaKey.generate(2048)
    let renewed = session_of("Steve", mojang, renewed_key, CLOCK_MS + 2 * HOUR_MS)
    rig.send(steve, play(ServerboundChatSessionUpdate { session: renewed.copy() }))
    expect_bytes(mut rig, alex, "player_info_update", initialize_chat("Steve", some(renewed.copy())))
    expect_bytes(mut rig, steve, "player_info_update", initialize_chat("Steve", some(renewed.copy())))
    let fresh = MessageBody { content: "fresh", time_stamp: CLOCK_MS + 3000, salt: 102, last_seen: [s0.copy(), s1.copy()] }
    let t0 = sign_message("Steve", renewed_key, renewed, 0, fresh)
    rig.send(steve, chat_packet(fresh, some(t0.copy()), seen_last(2, 0)))
    // Each cache has the last signature first.
    expect_bytes(mut rig, steve, "player_chat", signed_player_chat("Steve", fresh, 3, 0, t0, [cached(1), cached(0)]))
    expect_bytes(mut rig, alex, "player_chat", signed_player_chat("Steve", fresh, 3, 0, t0, [cached(1), cached(0)]))
    check(rig.logs(), "Steve says fresh|")

    // A player who joins now gets Steve's session with the tab list, and Alex without one.
    let notch = rig.join("Notch")
    let list = rig.clients[notch].after(["login", "change_difficulty", "player_abilities", "set_held_slot", "update_recipes", "entity_event", "commands", "recipe_book_settings", "recipe_book_add", "player_position", "server_data"])
    check(list.name, "player_info_update")
    var r = Reader.new(list.body)
    let info = PlayerInfo.read(mut r)!
    let steve_session = info.entries[0].chat_session.copy()!
    check("{info.entries.len()} {info.entries[0].name} {steve_session.key.der() == renewed.key.der()} {info.entries[1].chat_session == none}", "2 Steve true true")
    rig.clients[notch].drain()
    rig.clients[steve].drain()
    rig.clients[alex].drain()
    _ = rig.logs()

    // A message from more than 5 minutes ago is taken, with a warning, and isn't taken as
    // Steve's, so it's logged as not secure.
    rig.server.set_clock(Timestamp { unix_ms: CLOCK_MS + 600000 })
    let late = MessageBody { content: "late", time_stamp: CLOCK_MS + 4000, salt: 103, last_seen: [s0.copy(), s1.copy(), t0.copy()] }
    let t1 = sign_message("Steve", renewed_key, renewed, 1, late)
    rig.send(steve, chat_packet(late, some(t1.copy()), seen_last(3, 1)))
    check(rig.next(steve).name, "player_chat")
    check(rig.logs(), "Received expired chat: 'late'. Is the client/server system time unsynchronized?|[Not Secure] Steve says late|")
    // One from before the last is refused, and breaks the chain.
    let early = MessageBody { content: "early", time_stamp: CLOCK_MS + 3500, salt: 104, last_seen: [s0.copy(), s1.copy(), t0.copy(), t1.copy()] }
    rig.send(steve, chat_packet(early, some(sign_message("Steve", renewed_key, renewed, 2, early)), seen_last(4, 1)))
    expect_bytes(mut rig, steve, "system_chat", refused("chat.disabled.out_of_order_chat"))
    check(rig.logs(), "Failed to update secure chat state for Steve: 'chat.disabled.out_of_order_chat'|")

    // A signed command whose signatures aren't of the command's arguments is refused, and
    // Calcite's commands have none; one without signatures is unknown, as an unsigned one is.
    let signed_args: List<ArgumentSignature> = [ArgumentSignature { name: "message", signature: t1.copy() }, ArgumentSignature { name: "target", signature: t1.copy() }]
    rig.send(steve, play(ServerboundChatCommandSigned { command: "msg Alex hi", time_stamp: CLOCK_MS + 5000, salt: 105, argument_signatures: signed_args, last_seen: seen_last(4, 0) }))
    expect_bytes(mut rig, steve, "system_chat", refused("chat.disabled.invalid_command_signature"))
    check(rig.next(steve).name, "nothing")
    check(rig.logs(), "Signed command mismatch between server and client ('msg Alex hi'): got [message, target] from client, but expected []|Failed to update secure chat state for Steve: 'chat.disabled.invalid_command_signature'|")
    rig.send(steve, play(ServerboundChatCommandSigned { command: "spawn", time_stamp: CLOCK_MS + 6000, salt: 106, argument_signatures: [], last_seen: seen_last(4, 0) }))
    check(rig.next(steve).name, "system_chat")
    check(rig.next(steve).name, "system_chat")
    check(rig.next(steve).name, "nothing")
    check(rig.logs(), "")

    // A key that expires before the last ends the connection.
    rig.send(steve, play(ServerboundChatSessionUpdate { session: session_of("Steve", mojang, renewed_key, CLOCK_MS + HOUR_MS) }))
    expect_bytes(mut rig, steve, "disconnect", fields(ClientboundDisconnect { reason: Component.translatable("multiplayer.disconnect.expired_public_key", []) }))
    check(rig.logs(), "Steve lost connection: multiplayer.disconnect.expired_public_key|System chat: Steve left the game|")
    rig.replays(mojang_keys(mojang))
    println("ok signed chat")
}

fn chat_sessions() {
    let mojang = RsaKey.generate(1024)
    let key = RsaKey.generate(2048)
    // Without the services' keys, a session is ignored, and bytes that aren't a key don't
    // decode.
    var rig = new_rig()
    let (steve, alex) = two(mut rig)
    rig.send(steve, play(ServerboundChatSessionUpdate { session: session_of("Steve", mojang, key, CLOCK_MS + HOUR_MS) }))
    check(rig.next(steve).name, "nothing")
    check(rig.logs(), "Ignoring chat session from Steve due to missing Services public key|")
    var w = Writer.new()
    w.varint(ServerboundChatSessionUpdate.id(State.Play))
    w.uuid(Uuid.new(1, 2))
    w.i64(CLOCK_MS + HOUR_MS)
    w.byte_array([0x30, 0x03, 0x02, 0x01, 0x01])
    w.byte_array([])
    rig.send(alex, w.into_bytes())
    let problem = Component.literal("Internal Exception: io.netty.handler.codec.DecoderException: Failed to decode packet 'serverbound/minecraft:chat_session_update'")
    expect_bytes(mut rig, alex, "disconnect", fields(ClientboundDisconnect { reason: Component.translatable("disconnect.genericReason", [problem]) }))

    var keyed = new_rig_with(mojang_keys(mojang))
    let (a, b) = two(mut keyed)
    // A key that has expired is taken, though no one is shown it, and the player's messages are
    // refused.
    let expired = session_of("Alex", mojang, key, CLOCK_MS - 1)
    keyed.send(b, play(ServerboundChatSessionUpdate { session: expired.copy() }))
    expect_bytes(mut keyed, a, "player_info_update", initialize_chat("Alex", none))
    expect_bytes(mut keyed, b, "player_info_update", initialize_chat("Alex", none))
    let body = MessageBody { content: "old key", time_stamp: CLOCK_MS, salt: 1, last_seen: [] }
    keyed.send(b, chat_packet(body, some(sign_message("Alex", key, expired, 0, body)), LastSeenUpdate.empty()))
    expect_bytes(mut keyed, b, "system_chat", refused("chat.disabled.expiredProfileKey"))
    check(keyed.next(a).name, "nothing")
    check(keyed.logs(), "Failed to update secure chat state for Alex: 'chat.disabled.expiredProfileKey'|")
    // A key the services didn't sign ends the connection. A signature that isn't their key's
    // length logs Java's exception first.
    var forged = session_of("Steve", mojang, key, CLOCK_MS + HOUR_MS)
    forged.key_signature = [1, 2, 3]
    keyed.send(a, play(ServerboundChatSessionUpdate { session: forged }))
    expect_bytes(mut keyed, a, "disconnect", fields(ClientboundDisconnect { reason: Component.translatable("multiplayer.disconnect.invalid_public_key_signature", []) }))
    check(keyed.logs(), "Failed to verify Services signature\njava.security.SignatureException: Bad signature length: got 3 but was expecting 128|Failed to validate profile key\nnet.minecraft.world.entity.player.ProfilePublicKey$ValidationException: multiplayer.disconnect.invalid_public_key_signature|Steve lost connection: multiplayer.disconnect.invalid_public_key_signature|System chat: Steve left the game|")
    // Nor is a key signed for someone else.
    keyed.clients[b].drain()
    keyed.send(b, play(ServerboundChatSessionUpdate { session: session_of("Steve", mojang, key, CLOCK_MS + HOUR_MS) }))
    check(keyed.next(b).name, "disconnect")
    check(keyed.logs(), "Failed to validate profile key\nnet.minecraft.world.entity.player.ProfilePublicKey$ValidationException: multiplayer.disconnect.invalid_public_key_signature|Alex lost connection: multiplayer.disconnect.invalid_public_key_signature|System chat: Alex left the game|")
    rig.replays(Services.offline())
    keyed.replays(mojang_keys(mojang))
    println("ok chat sessions")
}

fn rate_limited() {
    var rig = new_rig_limited(Services.offline(), 10, 0)
    let steve = rig.join("Steve")
    rig.clients[steve].drain()
    // His first tick averaged in the handshake and the hello, 2 packets, to 0.5. Since then he's
    // sent configuration's 4 and 60 more, which go into the average at his 21st tick, when it's
    // 64 + 0.75 * (0.5 - 64) = 16.375, over the 10 allowed; until then nothing's checked.
    for _ in 0..60 {
        rig.send(steve, play(ServerboundClientTickEnd {}))
    }
    for _ in 0..18 {
        rig.tick(50)
    }
    rig.clients[steve].drain()
    if rig.clients[steve].closed {
        panic("Steve was kicked before his 21st tick")
    }
    rig.tick(50)
    check(rig.clients[steve].after(["chunk_batch_start", "level_chunk_with_light", "chunk_batch_finished", "set_time"]).name, "disconnect")
    rig.clients[steve].drain()
    if not rig.clients[steve].closed {
        panic("Steve wasn't kicked")
    }
    let log = rig.logs()
    if log.find("Player exceeded rate-limit (sent 16.375 packets per second)|") == none {
        panic("no rate-limit warning: {log}")
    }
    if log.find("Steve lost connection: disconnect.exceeded_packet_rate|") == none {
        panic("Steve wasn't kicked for his rate: {log}")
    }
    rig.replays(Services.offline())
    println("ok rate limit")
}

// The console's commands: brigadier's errors for what isn't one, then `stop`, which says so and
// tells each player the server closed, and the console's request to stop, which doesn't say so.
// The test's language has no text for them, so the lines show the keys.
fn stopping() {
    var rig = new_rig()
    let steve = rig.join("Steve")
    rig.clients[steve].drain()
    let alex = rig.join("Alex")
    rig.clients[alex].drain()
    rig.clients[steve].drain()
    _ = rig.logs()
    rig.server.command("help")
    rig.server.command("")
    rig.server.command("/stop now")
    rig.server.command("stop ")
    rig.server.command("STOP")
    check(rig.logs(), "command.unknown.command|helpcommand.context.here|command.unknown.command|command.context.here|command.unknown.argument|stop nowcommand.context.here|command.unknown.argument|stop command.context.here|command.unknown.command|STOPcommand.context.here|")
    assert(not rig.server.stopping(), "a command that isn't stop stopped the server")
    rig.server.command("/stop")
    assert(rig.server.stopping(), "stop didn't stop the server")
    rig.settle()
    for client in [steve, alex] {
        expect_bytes(mut rig, client, "disconnect", fields(ClientboundDisconnect { reason: Component.translatable("multiplayer.disconnect.server_shutdown", []) }))
        assert(rig.clients[client].closed, "a player told the server closed is still connected")
    }
    // Each player's lines come as their connection closes, in whichever order they close.
    let log = rig.logs()
    let start = "commands.stop.stopping|Stopping server|"
    let gone = "Steve lost connection: multiplayer.disconnect.server_shutdown|System chat: Steve left the game|"
    let also_gone = "Alex lost connection: multiplayer.disconnect.server_shutdown|System chat: Alex left the game|"
    assert(log.starts_with(start), "the log as the server stopped: {log}")
    let rest = log[start.len()..]
    assert(rest == "{gone}{also_gone}" or rest == "{also_gone}{gone}", "the log as the server stopped: {log}")
    check_int(i64.wrap(rig.server.closing()), 0)
    rig.replays(Services.offline())

    var halted = new_rig()
    let player = halted.join("Steve")
    halted.clients[player].drain()
    _ = halted.logs()
    halted.server.halt()
    halted.settle()
    check(halted.next(player).name, "disconnect")
    check(halted.logs(), "Stopping server|Steve lost connection: multiplayer.disconnect.server_shutdown|System chat: Steve left the game|")
    halted.replays(Services.offline())
    println("ok stopping")
}

fn throttled_logins() {
    var rig = new_rig_limited(Services.offline(), 0, 4000)
    let steve = rig.join("Steve")
    rig.clients[steve].drain()
    // Alex, from the same address 100 ms later, is refused, and the connection closed.
    let alex = rig.try_login()
    check(rig.next(alex).name, "login_disconnect")
    check(rig.next(alex).name, "closed")
    // A try starts the wait again, so 3.9 seconds later is still too soon.
    rig.tick(3900)
    let again = rig.try_login()
    check(rig.next(again).name, "login_disconnect")
    // 4 seconds after that, Alex gets in. Steve's already in, and stays.
    for _ in 0..80 {
        rig.tick(50)
    }
    let alex_in = rig.join("Alex")
    rig.clients[alex_in].drain()
    if rig.clients[alex_in].closed or rig.clients[steve].closed {
        panic("a player was disconnected")
    }
    rig.replays(Services.offline())
    println("ok login throttle")
}

