    make_dir_all("build/packets")!
    write(capture_path(), [])!
    join()
    moving()
    forced_view()
    others()
    keep_alive()
    chatting()
    commands()
    spam()
    acknowledgements()
    signed_chat()
    chat_sessions()
    rate_limited()
    throttled_logins()
    stopping()
    println("ok")
}
