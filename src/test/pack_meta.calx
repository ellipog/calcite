/// Checks `pack.meta` against what vanilla's `Pack.readPackMetadata` and `PackFormat` make of the
/// same `pack.mcmeta`: formats old and new and whether they're for 26.3, the fallback to the
/// description alone, files that aren't JSON or aren't objects, `PackFormat`'s messages, feature
/// flags, overlays, and filters.
module test.pack_meta

import pack.meta.{Compatibility, blocks_namespace, blocks_path, read_filter, read_meta, valid_overlay}
import server.log.{Entry, Level}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}:\n got {got}\nwant {want}")
    }
}

// The lines logged, then what was read: its compatibility, features and overlays.
fn meta(json: String) -> String {
    var logs = List<Entry>()
    let got = read_meta(String("file/p"), some(json.to_bytes()), mut logs)
    var out = lines(logs)
    match got {
        some(m) => {
            let c = match m.compatibility {
                Compatibility.TooOld => "too_old",
                Compatibility.TooNew => "too_new",
                Compatibility.Unknown => "unknown",
                Compatibility.Compatible => "compatible",
            }
            out.push_str("{c} {m.features} [")
            for i in 0..m.overlays.len() {
                if i > 0 {
                    out.push_str(",")
                }
                out.push_str(m.overlays[i])
            }
            out.push_str("] {m.description.to_json()}")
        },
        none => out.push_str("none"),
    }
    return out
}

fn lines(logs: List<Entry>) -> String {
    var out = String()
    for e in logs {
        let l = match e.level {
            Level.Info => "I",
            Level.Warn => "W",
            Level.Error => "E",
        }
        out.push_str("{l} {e.message}|")
    }
    return out
}

// The lines of a pack whose `pack` section fails and whose fallback reads, and of one left
// out, before their exception's message.
fn fallen() -> String {
    return String("W Error reading pack metadata, attempting fallback type\ncom.google.gson.JsonParseException: ")
}

fn failed() -> String {
    return String("W Failed to read pack file/p metadata\ncom.google.gson.JsonParseException: ")
}

// A pack failing its `pack` section with `message`, and then its description too.
fn both(message: String) -> String {
    return "{fallen()}{message}|{failed()}{message}|none"
}

// A pack whose `pack` section fails with `message` and falls back to its description alone.
fn unknown(message: String) -> String {
    return #"#{fallen()}#{message}|unknown 0 [] """#
}

// A pack with this `pack` section and nothing else.
fn pack(section: String) -> String {
    return meta(#"{"pack":#{section}}"#)
}

// A pack whose `pack` section reads, with `pack_format` 81 and the rest given.
fn with(rest: String) -> String {
    return meta(#"{"pack":{"description":"d","pack_format":81},#{rest}}"#)
}

fn formats() {
    check(pack(#"{"description":"hi","pack_format":81}"#), #"too_old 0 [] "hi""#, "pack_format alone")
    check(pack(#"{"description":"hi","min_format":121,"max_format":121}"#), #"compatible 0 [] "hi""#, "121 to 121.*")
    check(pack(#"{"description":"hi","min_format":[121,1],"max_format":122}"#), #"too_new 0 [] "hi""#, "from 121.1")
    check(pack(#"{"description":"","min_format":[120,5],"max_format":[121]}"#), #"compatible 0 [] """#, "max as a list of one")
    check(pack(#"{"description":"","min_format":100,"max_format":[121,0,7]}"#), #"compatible 0 [] """#, "max with three parts")
    check(pack(#"{"description":"","min_format":100,"max_format":[120,9]}"#), #"too_old 0 [] """#, "up to 120.9")
    check(pack(#"{"description":"","supported_formats":[18,81],"pack_format":48}"#), #"too_old 0 [] """#, "supported_formats")
    check(pack(#"{"description":"","supported_formats":{"min_inclusive":18,"max_inclusive":81},"pack_format":18}"#), #"too_old 0 [] """#, "supported_formats as an object")
    check(pack(#"{"description":"","min_format":48,"max_format":121,"supported_formats":[48,81],"pack_format":48}"#), #"compatible 0 [] """#, "both ways")
    check(pack(#"{"description":"","pack_format":null,"min_format":121,"max_format":121}"#), #"compatible 0 [] """#, "null is absent")
}

fn fallback() {
    check(pack(#"{"description":"hi"}"#), #"#{fallen()}Pack could not be parsed, missing format version information|unknown 0 [] "hi""#, "no formats")
    check(pack(#"{"description":"","pack_format":82}"#), unknown("Pack declares support for version newer than 81, but is missing mandatory fields min_format and max_format"), "pack_format 82")
    check(pack(#"{"description":"","min_format":121}"#), unknown("Pack missing field, must declare both min_format and max_format"), "min alone")
    check(pack(#"{"description":"","min_format":[121,3],"max_format":[121,2]}"#), unknown("Pack min_format (121.3) is greater than max_format (121.2)"), "min after max")
    check(pack(#"{"description":"","min_format":122,"max_format":121}"#), unknown("Pack min_format (122.0) is greater than max_format (121.*)"), "min after max.*")
    check(pack(#"{"description":"","min_format":121,"max_format":121,"supported_formats":121}"#), unknown("Pack key supported_formats is deprecated starting from pack format 82. Remove supported_formats from your pack.mcmeta."), "deprecated")
    check(pack(#"{"description":"","min_format":60,"max_format":121}"#), unknown(#"Pack declares support for format 60, but game versions supporting formats 15 to 81 require a supported_formats field. Add "supported_formats": [60, 81] or require a version greater or equal to 82.0."#), "old without supported_formats")
    check(pack(#"{"description":"","min_format":60,"max_format":121,"supported_formats":[61,81]}"#), unknown("Pack version declaration mismatch between supported_formats (from 61) and min_format (60.0)"), "from mismatch")
    check(pack(#"{"description":"","min_format":60,"max_format":121,"supported_formats":[60,80]}"#), unknown("Pack version declaration mismatch between supported_formats (up to 80) and max_format (121.*)"), "up to mismatch")
    check(pack(#"{"description":"","min_format":60,"max_format":121,"supported_formats":[60,81]}"#), unknown(#"Pack declares support for formats up to 81, but game versions supporting formats 15 to 81 require a pack_format field. Add "pack_format": 60 or require a version greater or equal to 82.0."#), "no pack_format")
    check(pack(#"{"description":"","min_format":60,"max_format":121,"supported_formats":[60,81],"pack_format":59}"#), unknown("Pack declared support for versions 60 to 121 but declared main format is 59"), "pack_format outside")
    check(pack(#"{"description":"","pack_format":true,"supported_formats":[1,81]}"#), unknown("Multi-version packs cannot support minimum version of less than 15, since this will leave versions in range unable to load pack."), "true as 1")
    check(pack(#"{"description":"","supported_formats":[60,82]}"#), unknown("Pack declares support for version newer than 81, but is missing mandatory fields min_format and max_format"), "old up to 82")
    check(pack(#"{"description":"","supported_formats":[61,60],"pack_format":60}"#), unknown("min_inclusive must be less than or equal to max_inclusive"), "range backwards")
    check(pack(#"{"description":"","min_format":-1,"max_format":121}"#), unknown("Failed to parse either. First: Not a json array: -1; Second: Value must be non-negative: -1"), "negative")
    check(pack(#"{"description":"","min_format":[],"max_format":121}"#), unknown("Failed to parse either. First: List is too short: 0, expected range [1-256]; Second: Not a number: []"), "empty list")
    check(pack(#"{"description":"","pack_format":"81"}"#), unknown(#"Not a number: "81""#), "a string")
}

fn unread() {
    var logs = List<Entry>()
    check("{read_meta(String("file/p"), none, mut logs) == none}", "true", "no file")
    check(lines(logs), "W Missing metadata in pack file/p|", "no file's line")
    check(meta(#"{"id":1}"#), "W Missing metadata in pack file/p|none", "no pack section")
    check(pack(#"{"pack_format":81}"#), both(#"No key description in MapLike[{"pack_format":81}]"#), "no description")
    check(pack("null"), both("Not a JSON object: null"), "null pack")
    check(pack("[1]"), both("Not a JSON object: [1]"), "array pack")
    let not_object = "W Error reading pack metadata, attempting fallback type\ncom.google.gson.JsonSyntaxException: Expected a com.google.gson.JsonObject but was "
    let not_object_failed = "W Failed to read pack file/p metadata\ncom.google.gson.JsonSyntaxException: Expected a com.google.gson.JsonObject but was "
    check(meta("[]"), "{not_object}com.google.gson.JsonArray; at path $|{not_object_failed}com.google.gson.JsonArray; at path $|none", "array")
    check(meta("null"), "{not_object}com.google.gson.JsonNull; at path $|{not_object_failed}com.google.gson.JsonNull; at path $|none", "null")
    check(meta(#""x" junk"#), "{not_object}com.google.gson.JsonPrimitive; at path $|{not_object_failed}com.google.gson.JsonPrimitive; at path $|none", "string")
    check(meta(" \n  "), both("java.io.EOFException: End of input at line 2 column 3 path $"), "white space")
    check(meta(""), both("java.io.EOFException: End of input at line 1 column 1 path $"), "empty")
    check(meta(#"{pack:1}"#), both("com.google.gson.stream.MalformedJsonException: pack.mcmeta isn't JSON as strict Gson reads it"), "unquoted")
    // Strict Gson reads the first value and no more.
    check(meta(#"{"pack":{"description":"hi","pack_format":81}} { ]"#), #"too_old 0 [] "hi""#, "junk after")
    let marked = #"{"pack":{"description":"hi","pack_format":81}}"#
    check(meta("\u{FEFF}{marked}"), #"too_old 0 [] "hi""#, "byte order mark")
}

fn features() {
    check(with(#""features":{"enabled":["minecraft:trade_rebalance","vanilla"]}"#), #"too_old 3 [] "d""#, "two flags")
    check(with(#""features":{"enabled":["redstone_experiments","minecart_improvements"]}"#), #"too_old 12 [] "d""#, "experiments")
    check(with(#""features":{"enabled":[]}"#), #"too_old 0 [] "d""#, "none")
    check(with(#""features":{"enabled":["minecraft:bundle","a:b"]}"#), "{failed()}Unknown feature ids: [a:b, minecraft:bundle]|none", "unknown, in HashSet order")
    check(with(#""features":{"enabled":["Bad"]}"#), "{failed()}Not a valid resource location: Bad Non [a-z0-9/._-] character in path of location: minecraft:Bad|none", "invalid")
    check(with(#""features":{}"#), #"#{failed()}No key enabled in MapLike[{}]|none"#, "no enabled")
    // Only the codec's own fields take `null` as absent: a section that's `null` is there.
    check(with(#""features":null"#), "{failed()}Not a JSON object: null|none", "null features")
}

fn overlays() {
    let entries = #"[{"min_format":121,"max_format":121,"directory":"a"},{"min_format":90,"max_format":100,"directory":"b"},{"directory":"c"},{"min_format":121,"max_format":[121,0],"directory":"d"}]"#
    check(with(#""overlays":{"entries":#{entries}}"#), #"W Unknown or broken overlay entry c|too_old 0 [a,d] "d""#, "for 26.3")
    check(with(#""overlays":{"entries":[{"formats":[70,81],"directory":"old"},{"min_format":121,"max_format":121,"directory":"new"}]}"#), #"#{failed()}Overlay "new" missing required field formats, must be present in all overlays for any overlays to work across game versions|none"#, "formats needed")
    check(with(#""overlays":{"entries":[{"formats":[70,81],"directory":"old"},{"min_format":70,"max_format":121,"formats":[70,81],"directory":"new"}]}"#), #"too_old 0 [new] "d""#, "both ways")
    check(with(#""overlays":{"entries":[{"formats":[70,90],"directory":"x"}]}"#), #"#{failed()}Overlay "x" declares support for version newer than 81, but is missing mandatory fields min_format and max_format|none"#, "old formats past 81")
    check(with(#""overlays":{"entries":[{"min_format":121,"max_format":121,"directory":"a/b"}]}"#), "{failed()}a/b is not accepted directory name|none", "bad folder")
    check(with(#""overlays":{"entries":[]}"#), #"too_old 0 [] "d""#, "no entries")
    check(with(#""overlays":null"#), "{failed()}Not a JSON object: null|none", "null overlays")
    check(with(#""overlays":{}"#), #"#{failed()}No key entries in MapLike[{}]|none"#, "no entries key")
    check("{valid_overlay(String("a-b_c.D9"))}", "true", "folder chars")
    check("{valid_overlay(String(""))}", "false", "empty folder")
}

fn filters() {
    var logs = List<Entry>()
    let file = String(#"{"pack":{},"filter":{"block":[{"namespace":"^mine","path":"recipe/.*_slab"},{"path":"loot"}]}}"#).to_bytes()
    let f = read_filter(String("file/p"), some(file), mut logs)!
    check("{f.len()}", "2", "two patterns")
    check("{blocks_namespace(f, String("minecraft"))}", "true", "any namespace takes it")
    check("{blocks_namespace(f, String("other"))}", "true", "a pattern without a namespace")
    check("{blocks_path(f, String("recipe/oak_slab.json"))}", "true", "found in the path")
    check("{blocks_path(f, String("tags/x"))}", "false", "no pattern finds it")
    let one = read_filter(String("file/p"), some(String(#"{"filter":{"block":[{"namespace":"^mine"}]}}"#).to_bytes()), mut logs)!
    check("{blocks_namespace(one, String("other"))}", "false", "a namespace no pattern takes")
    check(lines(logs), "", "no lines")
    check("{read_filter(String("file/p"), some(String(#"{"pack":{}}"#).to_bytes()), mut logs) == none}", "true", "no filter")
    check("{read_filter(String("file/p"), none, mut logs) == none}", "true", "no file")
    check("{read_filter(String("file/p"), some(String(#"{"filter":{"block":[{"namespace":"("}]}}"#).to_bytes()), mut logs) == none}", "true", "a broken pattern")
    check(lines(logs), "E Failed to get filter section from pack file/p|", "its line")
    logs.clear()
    check("{read_filter(String("file/p"), some(String(#"{"filter":{"block":[{"path":"\\p{L}"}]}}"#).to_bytes()), mut logs) == none}", "true", "a pattern Calcite can't match")
    check(lines(logs), #"W Calcite can't match the pattern `\p{L}` in the filter of pack file/p yet, which uses Unicode properties, so the filter is left out|"#, "its warning")
    logs.clear()
    check("{read_filter(String("file/p"), some(String("[").to_bytes()), mut logs) == none}", "true", "not JSON")
    check(lines(logs), "E Failed to get filter section from pack file/p|", "not JSON's line")
}

fn main() {
    formats()
    fallback()
    unread()
    features()
    overlays()
    filters()
    println("ok")
}
