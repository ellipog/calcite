/// Checks primed TNT in `world.tnt` and its priming by the level (CAL-182), on a flat level whose
/// blocks are vanilla's, read from the server jar at oracle/jars/ as the rig's adapter loads them,
/// so it's run from the repository's root: TNT primed moves 0.02 across the way its draw turns it
/// and 0.2 up, its fuse 80; it rises, falls back onto the grass and stays, its place sent whole
/// as it lands, its fuse a tick shorter each tick and out at the 80th, which explodes it a
/// sixteenth of the way up; a save is read back, its power kept to 128 and its fuse 80 where it
/// has none; the level primes TNT drawing its turn, and on a short fuse, as an explosion primes
/// it, a fuse under 30 next, and nothing where the game rule `tnt_explodes` is off; and an
/// explosion reaching TNT leaves it air and primes it, owned by who's behind the explosion, on a
/// short fuse.
module test.tnt

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.taped.{TapedRandom}
import rig.registries.{load_vanilla}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Dropped, Level, SPAWN_RADIUS}
import server.log.{Entry}
import registry.registries.{Registries}
import std.java.math.{cos, sin}
import storage.chunk.{ChunkFormat}
import world.body.{BodyFacts, EntitySound}
import world.chunk.{BlockStates}
import world.entity_data.{TNT_FUSE}
import world.explosion.{Calculator, Explosion, Interaction, blow_blocks, blown_places}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.loot.{Loot}
import world.movement.{MovementStates}
import world.pos.{ChunkPos}
import world.random_sequences.{RandomSequences}
import world.tnt.{PrimedTnt, short_fuse}
import worldgen.facts.{Facts}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: String) {
    if not got {
        panic(what)
    }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

// A flat level of the registries `r`, its spawn's chunks full and given the facts and the loot,
// with a player at its middle, and its random seeded 0.
fn flat_level(f: Facts, r: Registries) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    let format = ChunkFormat.new(r.copy())!
    level.open(none, ChunkContext { format: format, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }, none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    level.loot = some(Shared(Loot.new(Shared(r.copy()))))
    level.sequences = some(RandomSequences())
    level.set_random(TapedRandom.new(0))
    return level
}

fn tnt_state(f: Facts) -> u32 {
    return match f.named_block(String("tnt")) {
        ok(b) => f.default_state(b),
        err(_) => panic("no TNT"),
    }
}

// TNT's default state as `BlockState.CODEC` writes it.
fn tnt_tag() -> Tag {
    var props = JavaHashMap<String, Tag>()
    props.insert(String("unstable"), Tag.Str(String("false")))
    var m = JavaHashMap<String, Tag>()
    m.insert(String("Name"), Tag.Str(String("minecraft:tnt")))
    m.insert(String("Properties"), Tag.Compound(props))
    return Tag.Compound(m)
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    let Tag.Compound(m) = t else panic("not a compound")
    return m.copy()
}

// Primed with a quarter turn: 0.02 one way across, none the other, 0.2 up as a float, its fuse
// 80, its default, and TNT's block shown.
fn primed(f: Facts) {
    let p = PrimedTnt.primed(3, 42, 0.5, -60.0, 0.5, 0.25, some((1i64, 2i64)), tnt_state(f), tnt_tag())
    let rot = 0.25 * f64(6.2831855f32)
    check(p.body.vx == -sin(rot) * 0.02 and p.body.vz == -cos(rot) * 0.02, "its motion across is {p.body.vx}, {p.body.vz}")
    check((p.body.vx + 0.02).abs() < 1.0e-9 and p.body.vz.abs() < 1.0e-9, "a quarter turn isn't 0.02 west")
    check(p.body.vy == f64(0.2f32), "it isn't moving 0.2 up")
    check(p.fuse() == 80 and p.data.is_default(TNT_FUSE), "its fuse isn't 80")
    check(p.body.width == 0.98f32 and p.body.height == 0.98f32 and p.body.eyes == 0.15f32, "it isn't 0.98 by 0.98")
    let (bx, by, bz) = p.blast_at()
    check(bx == 0.5 and by == -60.0 + f64(0.98f32) * 0.0625 and bz == 0.5, "it explodes at {bx}, {by}, {bz}")
}

// On the grass, with no turn across: up 0.16 its first tick, its motion then slowed by the air;
// back on the grass and still there, its place sent whole as it lands; its fuse a tick shorter
// each tick, out at the 80th, when it's gone.
fn ticks(f: Facts, r: Registries) {
    let level = flat_level(f, r)
    let m = MovementStates.new(f)
    let t = BodyFacts.new(f)
    var p = PrimedTnt.primed(3, 42, 0.5, -60.0, 0.5, 0.0, none, tnt_state(f), tnt_tag())
    p.body.vz = 0.0
    var sounds = List<EntitySound>()
    check(not p.tick(f, m, t, level, false, mut sounds), "it went off at once")
    let rise = f64(0.2f32) - 0.04
    check(p.body.y == -60.0 + rise, "its first tick took it to {p.body.y}")
    check(p.body.vy == rise * f64(0.98f32), "its motion after its first tick is {p.body.vy}")
    check(p.fuse() == 79 and p.data.is_dirty(), "its fuse isn't 79, to be sent")
    var landed_at = -1
    var tick = 1
    while tick < 79 {
        check(not p.tick(f, m, t, level, false, mut sounds), "it went off at tick {tick + 1}")
        tick += 1
        if landed_at < 0 and p.body.on_ground {
            landed_at = tick
            check(p.body.precise, "its place isn't sent whole as it lands")
        }
    }
    check(landed_at > 0, "it never landed")
    check(p.body.y == -60.0 and p.body.on_ground, "it rests at {p.body.y}")
    check(p.fuse() == 1, "its fuse is {p.fuse()} at tick 79")
    check(p.tick(f, m, t, level, false, mut sounds), "it didn't go off at tick 80")
    check(p.body.removed and p.fuse() == 0, "it isn't gone at tick 80")
    check(sounds.is_empty(), "it made a sound")
}

// A save read back: its fuse, block, power and owner; a power past 128 kept to it, and the fuse
// 80 where it has none.
fn saves(f: Facts) {
    var p = PrimedTnt.primed(3, 42, 0.5, -60.0, 0.5, 0.0, some((5i64, 6i64)), tnt_state(f), tnt_tag())
    p.set_fuse(33)
    p.power = 6.5f32
    let saved = compound(p.saved())
    check(saved["id"] == Tag.Str(String("minecraft:tnt")), "it isn't saved as tnt")
    check(saved["fuse"] == Tag.Short(33i16) and saved["explosion_power"] == Tag.Float(6.5f32), "its fuse and power aren't saved")
    check(saved["block_state"] == tnt_tag(), "its block isn't saved")
    var lines = List<Entry>()
    let back = PrimedTnt.loaded(4, 43, saved, tnt_state(f), tnt_tag(), mut lines) else panic("not read back")
    check(lines.is_empty(), "reading it back logged")
    check(back.fuse() == 33 and back.power == 6.5f32 and back.owner == some((5i64, 6i64)), "it read back otherwise")
    check(back.body.x == 0.5 and back.body.y == -60.0 and back.body.z == 0.5, "it read back elsewhere")
    var bare = saved.copy()
    _ = bare.remove("fuse")
    bare.insert(String("explosion_power"), Tag.Float(200.0f32))
    let clamped = PrimedTnt.loaded(5, 44, bare, tnt_state(f), tnt_tag(), mut lines) else panic("not read")
    check(clamped.fuse() == 80 and clamped.power == 128.0f32, "a bare save read as {clamped.fuse()}, {clamped.power}")
    var plain = PrimedTnt.primed(3, 42, 0.5, -60.0, 0.5, 0.0, none, tnt_state(f), tnt_tag())
    plain.set_fuse(80)
    let m = compound(plain.saved())
    check(not m.contains("explosion_power") and not m.contains("owner"), "a plain one saved its power or owner")
}

// The level's priming: its turn drawn as it's made, a short fuse, under a quarter of 80 and an
// eighth more, drawn next; nothing with the game rule off.
fn priming(f: Facts, r: Registries) {
    var level = flat_level(f, r)
    check(level.prime_tnt(4, -60, 7, some((1i64, 1i64)), false), "lit TNT wasn't primed")
    check(level.prime_tnt(5, -60, 7, none, true), "TNT an explosion reached wasn't primed")
    var want = LegacyRandom.new(0)
    let first = want.next_double()
    let second = want.next_double()
    let fuse = want.next_int_below(20) + 10
    let dropped = level.take_dropped()
    check(dropped.len() == 2, "it dropped {dropped.len()}")
    let Dropped.Tnt(lit) = dropped[0].copy() else panic("lit TNT isn't primed TNT")
    check(lit.x == 4.5 and lit.y == -60.0 and lit.z == 7.5 and lit.turn == first and lit.fuse == none and lit.owner == some((1i64, 1i64)), "lit TNT")
    let Dropped.Tnt(burst) = dropped[1].copy() else panic("blown TNT isn't primed TNT")
    check(burst.turn == second and burst.fuse == some(fuse) and burst.owner == none, "blown TNT")
    check(level.next_long() == want.next_long(), "priming drew otherwise")
    var bound = LegacyRandom.new(7)
    var low = 30
    var high = 0
    for _ in 0..200 {
        let n = short_fuse(80, mut bound)
        low = low.min(n)
        high = high.max(n)
    }
    check(low >= 10 and high <= 29, "a short fuse came {low} to {high}")
    level.tnt_explodes = false
    check(not level.prime_tnt(4, -60, 7, none, false), "TNT was primed with tnt_explodes off")
    check(level.take_dropped().is_empty(), "TNT was made with tnt_explodes off")
    for line in level.take_lines() {
        panic("unimplemented: {line.message}")
    }
}

// An explosion reaching a TNT block: it's air, drops nothing, and is primed owned by who's behind
// the explosion, at its middle across and its bottom, on a short fuse.
fn blown(f: Facts, r: Registries) {
    var level = flat_level(f, r)
    check(level.set_block(2, -60, 0, tnt_state(f), UPDATE_ALL), "TNT wasn't set")
    let e = Explosion { x: 0.5, y: -59.5, z: 0.5, radius: 4.0f32, interaction: Interaction.Destroy, calculator: Calculator.Plain, indirect: some((8i64, 9i64)) }
    var places = blown_places(f, mut level, e)
    var reached = false
    for p in places {
        if p.x == 2 and p.y == -60 and p.z == 0 {
            reached = true
        }
    }
    check(reached, "the TNT wasn't reached")
    blow_blocks(f, mut level, e, mut places)
    check(f.is_air(level.spawn_state(2, -60, 0)), "the TNT is still there")
    var primed_tnt = 0
    for d in level.take_dropped() {
        match d {
            Dropped.Tnt(p) => {
                check(p.x == 2.5 and p.y == -60.0 and p.z == 0.5, "it was primed at {p.x}, {p.y}, {p.z}")
                check(p.owner == some((8i64, 9i64)), "it isn't owned by who's behind the explosion")
                let fuse = p.fuse ?? 0
                check(fuse >= 10 and fuse < 30, "its fuse is {fuse}")
                primed_tnt += 1
            },
            Dropped.Item(_, _, _, stack) => check(not stack.to_snbt().contains("minecraft:tnt"), "the TNT dropped itself"),
            _ => {},
        }
    }
    check(primed_tnt == 1, "{primed_tnt} TNT primed")
    for line in level.take_lines() {
        panic("unimplemented: {line.message}")
    }
}

fn main() {
    let loaded = load_vanilla()!
    let r = loaded.registries.copy()
    let blocks = r.find_builtin(String("block")) ?? panic("no blocks")
    let fluids = r.find_builtin(String("fluid")) ?? panic("no fluids")
    let f = match Facts.new(r.builtin[blocks].copy(), r.builtin[fluids].copy(), BlockStates.new([1], [1], 1)) {
        ok(made) => made,
        err(e) => panic("the block facts: {e}"),
    }
    primed(f)
    ticks(f, r)
    saves(f)
    priming(f, r)
    blown(f, r)
    println("ok")
}
