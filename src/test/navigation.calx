/// Tests of `world.navigation` and a mob's thinking (CAL-157): a zombie told to go 5 blocks east,
/// as a goal tells it, walking there on stone, its pitch let go, facing its way, and done with its
/// head back with its body; the same with a block of stone in its way, which it jumps onto and off;
/// a zombie told to go where it can't stand, which finds no path; and a slime, which turns toward
/// its way, 0 as it's made, 90 degrees a tick, its head and body with it; and paths numbered, a
/// path let go still giving its nodes as they were.
module test.navigation

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry, Tag as RegistryTag}
import resources.identifier.{Identifier}
import world.attributes.{Wearing}
import world.body.{BodyFacts, EntitySound}
import world.chunk.{AIR_STATE, BlockStates}
import world.collision.{CollisionBlocks}
import world.experience_orb.{Follower}
import world.entity_facts.{path_block_tag_blocks, path_block_tag_names, path_fluid_tag_fluids, path_fluid_tag_names}
import world.inside.{Rain, GatewayExit, Gateways}
import world.living.{LivingFacts, Warding}
import world.loot.{LootParams}
import world.goals.{GoalSelector}
import world.mob.{Mob, MobLight, SLIME, ZOMBIE}
import world.movement.{MovementStates}
import world.navigation.{NavLevel, SentBlock}
import world.paths.{PathTypeCache}
import world.variants.{MobFacts}
import worldgen.facts.{Facts}
import math.mth.{wrap_degrees}

fn check(cond: bool, what: str) {
    if not cond {
        panic(what)
    }
}

fn check_in(cond: bool, what: str, said: str) {
    if not cond {
        panic("{what}: {said}")
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The block facts, from the built-in block and fluid registries (4 and 2), with the tags paths
// read and `#entity_floatable`, as vanilla's data has them.
fn facts() -> Facts {
    var blocks = Registry.new(full("block"), false)
    for e in builtin_entries(4) {
        blocks.add(full(e), none)
    }
    let names = path_block_tag_names()
    let held = path_block_tag_blocks()
    for i in 0..names.len() {
        blocks.tags.push(RegistryTag { name: full(names[i].copy()), values: held[i].copy() })
    }
    var fluids = Registry.new(full("fluid"), false)
    for e in builtin_entries(2) {
        fluids.add(full(e), none)
    }
    let fluid_names = path_fluid_tag_names()
    let fluid_held = path_fluid_tag_fluids()
    for i in 0..fluid_names.len() {
        fluids.tags.push(RegistryTag { name: full(fluid_names[i].copy()), values: fluid_held[i].copy() })
    }
    fluids.tags.push(RegistryTag { name: full("entity_floatable"), values: [1, 2] })
    return match Facts.new(blocks, fluids, BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn default_of(f: Facts, name: str) -> u32 {
    let b = f.block_named(String(name)) else panic("no block {name}")
    return f.default_state(b)
}

// Stone below y 1 and air above, but for the blocks set, loaded from -64 to 64 across; dark, its
// game time `time`.
struct World {
    set: List<(i32, i32, i32, u32)>
    stone: u32
    time: i64 = 0
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -64 or x >= 64 or z < -64 or z >= 64 {
            return none
        }
        for (bx, by, bz, s) in self.set {
            if bx == x and by == y and bz == z {
                return some(s)
            }
        }
        return some(if y < 1 { self.stone } else { AIR_STATE })
    }
}

impl Rain for World {
    fn rains_on(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }
}

impl Gateways for World {
    fn gateway_open(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }

    fn gateway_exit(self, x: i32, y: i32, z: i32) -> GatewayExit {
        _ = x + y + z
        return GatewayExit.Nowhere
    }

    fn gateways_allowed(self) -> bool {
        return true
    }
}

impl MobLight for World {
    fn magic_light(self, x: i32, y: i32, z: i32) -> f32 {
        _ = x + y + z
        return 0.0f32
    }

    fn monsters_burn(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }

    fn sees_sky(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return true
    }
}

impl Warding for World {
    fn protection(self, worn: List<Tag?>, params: LootParams) -> (f32, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (0.0f32, List<String>())
    }

    fn immune(self, worn: List<Tag?>, params: LootParams) -> (bool, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (false, List<String>())
    }
}

impl NavLevel for World {
    fn level_time(self) -> i64 {
        return self.time
    }

    fn top_y(self) -> i32 {
        return 319
    }

    fn sent_first(self) -> u64 {
        return 0
    }

    fn sent_total(self) -> u64 {
        return 0
    }

    fn sent_at(self, i: u64) -> SentBlock {
        return SentBlock { x: i32.wrap(i), y: 0, z: 0, old: 0, now: 0 }
    }
}

// Nothing worn has components.
struct Items {}

impl Wearing for Items {
    fn worn_component(self, stack: Tag, name: String) -> Tag? {
        _ = stack
        _ = name
        return none
    }

    fn worn_types(self, set: Tag) -> List<i32> {
        _ = set
        return List<i32>()
    }

    fn worn_enchantments(self, stack: Tag) -> List<(i32, JavaHashMap<String, Tag>)> {
        _ = stack
        return List<(i32, JavaHashMap<String, Tag>)>()
    }
}

struct Setup {
    f: Facts
    m: MovementStates
    t: BodyFacts
    lf: LivingFacts
    kinds: List<String>
}

// A mob of the kind `species`, its type named `name`, standing at x, 1, z.
fn mob(s: Setup, species: i32, name: str, x: f64, z: f64) -> Mob {
    var kind: u32 = 0
    for i in 0..s.kinds.len() {
        if s.kinds[i] == String(name) {
            kind = u32.wrap(i)
        }
    }
    return Mob.made(s.lf, MobFacts.vanilla(4, [1], [2]), species, kind, 7, 155, x, 1.0, z)
}

// Its ticks in `w`, the game time going on.
fn ticks(s: Setup, a: mut Mob, w: mut World, cache: mut PathTypeCache, n: i32) {
    for _ in 0..n {
        w.time += 1
        var sounds = List<EntitySound>()
        a.tick(s.lf, s.f, s.m, s.t, w, Items {}, mut cache, List<Follower>(), -64, false, mut sounds)
    }
}

// A zombie told to go 5 blocks east of where it stands on stone, over the blocks `set`, landed
// first; after `n` ticks, it's done, at its path's last node but for less than its waypoint,
// facing east, and its head back with its body. Its highest on the way. Its goals are taken
// away, so only its navigation moves it (CAL-159).
fn walked(s: Setup, set: own List<(i32, i32, i32, u32)>, n: i32, what: str) -> f64 {
    var w = World { set: set, stone: default_of(s.f, "minecraft:stone") }
    var cache = PathTypeCache()
    var zombie = mob(s, ZOMBIE, "zombie", 0.5, 0.5)
    zombie.goals = GoalSelector()
    zombie.targets = GoalSelector()
    zombie.living.body.x_rot = 30.0f32
    ticks(s, mut zombie, mut w, mut cache, 2)
    check_in(zombie.living.body.on_ground, what, "a zombie on stone isn't on the ground")
    check_in(zombie.living.body.x_rot == 0.0f32, what, "a zombie's look control didn't let its pitch go")
    check_in(zombie.move_to(s.lf, s.f, s.m, w, mut cache, -64, 5.5, 1.0, 0.5, 1.0), what, "a zombie found no path east")
    check_in(zombie.navigating(), what, "a zombie with a path isn't navigating")
    var highest = zombie.living.body.y
    var done_at = -1
    for tick in 0..n {
        ticks(s, mut zombie, mut w, mut cache, 1)
        if zombie.living.body.y > highest {
            highest = zombie.living.body.y
        }
        if done_at < 0 and not zombie.navigating() {
            done_at = tick
        }
    }
    let x = zombie.living.body.x
    println("{what}: done at tick {done_at}, at {x}, {zombie.living.body.y}, {zombie.living.body.z}, highest {highest}, facing {zombie.living.body.y_rot}, head {zombie.living.y_head_rot}, body {zombie.living.y_body_rot}")
    check_in(done_at >= 0, what, "a zombie didn't get there")
    check_in(x > 4.5 - 0.45 and x < 4.5 + 0.45 and (zombie.living.body.z - 0.5).abs() < 0.01, what, "a zombie stopped elsewhere")
    check_in(wrap_degrees(zombie.living.body.y_rot - 270.0f32).abs() < 1.0f32, what, "a zombie isn't facing east")
    check_in(wrap_degrees(zombie.living.y_head_rot - zombie.living.y_body_rot).abs() < 1.0f32, what, "a zombie's head didn't come back to its body")
    return highest
}

fn main() {
    let f = facts()
    let kinds = builtin_entries(6)
    let m = MovementStates.new(f)
    let t = BodyFacts.new(f)
    let lf = LivingFacts.new(f)
    let s = Setup { f: f, m: m, t: t, lf: lf, kinds: kinds.copy() }
    let stone = default_of(s.f, "minecraft:stone")

    // On flat stone: walked there, never up.
    let flat = walked(s, List<(i32, i32, i32, u32)>(), 120, "flat")
    check(flat < 1.01, "flat: a zombie went up")

    // A block of stone in its way: jumped onto, walked off.
    let over = walked(s, [(3, 1, 0, stone)], 160, "over a block")
    check(over > 1.99, "over a block: a zombie didn't get onto it")

    // Into stone two high all round: no path, and it stays, its goals taken away as `walked`'s.
    var shut = List<(i32, i32, i32, u32)>()
    for x in 4..7 {
        for z in -1..2 {
            for y in 1..4 {
                shut.push((x, y, z, stone))
            }
        }
    }
    var w = World { set: shut, stone: stone }
    var cache = PathTypeCache()
    var zombie = mob(s, ZOMBIE, "zombie", 0.5, 0.5)
    zombie.goals = GoalSelector()
    zombie.targets = GoalSelector()
    ticks(s, mut zombie, mut w, mut cache, 2)
    let moved =zombie.move_to(s.lf, s.f, s.m, w, mut cache, -64, 5.5, 1.0, 0.5, 1.0)
    println("into stone: {moved}, navigating {zombie.navigating()}")
    ticks(s, mut zombie, mut w, mut cache, 200)
    check(not zombie.navigating(), "into stone: a zombie is still going")
    check(zombie.living.body.x < 4.0 - 0.3 + 0.01, "into stone: a zombie went into it")

    // Paths numbered (CAL-160): a zombie told to go east has a path with a number, whose nodes
    // about it the navigation gives; told to go west, another with a later number, and the
    // first's nodes as they were when it let it go, as a brain's `PATH` memory may still hold it.
    var open_world = World { set: List<(i32, i32, i32, u32)>(), stone: stone }
    var walker = mob(s, ZOMBIE, "zombie", 0.5, 0.5)
    walker.goals = GoalSelector()
    walker.targets = GoalSelector()
    ticks(s, mut walker, mut open_world, mut cache, 2)
    check(walker.move_to(s.lf, s.f, s.m, open_world, mut cache, -64, 6.5, 1.0, 0.5, 1.0), "numbered: no path east")
    let first = match walker.navigation.path_id() {
        some(n) => n,
        none => -1,
    }
    check(first > 0, "numbered: the path east has no number")
    ticks(s, mut walker, mut open_world, mut cache, 10)
    let east = walker.navigation.about_path(first)
    check(east != none, "numbered: no nodes about the path east")
    check(walker.move_to(s.lf, s.f, s.m, open_world, mut cache, -64, -5.5, 1.0, 0.5, 1.0), "numbered: no path west")
    let second = match walker.navigation.path_id() {
        some(n) => n,
        none => -1,
    }
    check(second > first, "numbered: the path west's number isn't later")
    check(walker.navigation.about_path(first) == east, "numbered: the path east's nodes moved on")
    check(walker.navigation.about_path(second + 1) == none, "numbered: nodes about a path never had")

    // A slime turned 135, its way 0, which its move control otherwise makes from its turn as it's
    // made (CAL-159): toward 0, 90 a tick at most, its head and body with it.
    var flat_world = World { set: List<(i32, i32, i32, u32)>(), stone: stone }
    var slime = mob(s, SLIME, "slime", 0.5, 0.5)
    slime.moves.cube_y_rot = 0.0f32
    slime.living.body.y_rot = 135.0f32
    ticks(s, mut slime, mut flat_world, mut cache, 1)
    check(slime.living.body.y_rot == 45.0f32 and slime.living.y_head_rot == 45.0f32 and slime.living.y_body_rot == 45.0f32, "a slime didn't turn 90 toward its way")
    ticks(s, mut slime, mut flat_world, mut cache, 1)
    check(slime.living.body.y_rot == 0.0f32 and slime.living.y_head_rot == 0.0f32 and slime.living.y_body_rot == 0.0f32, "a slime didn't come to its way")
    println("ok")
}
