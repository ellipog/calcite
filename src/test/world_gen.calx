/// Checks `storage.world_gen`: a new world's settings byte for byte as vanilla 26.3 saved them for
/// a normal world and a flat one, settings read back and written the same, the preset the
/// Overworld's generator is, the codec's errors, and the file read from a world's folder, saved
/// by the saver as a save writes it, gzipped, and what a missing or plain one fails with.
module test.world_gen

import nbt.tag.{Accounter, Tag, read_unnamed}
import protocol.ids.{DATA_VERSION}
import server.log.{Entry}
import std.fs.{make_dir_all, remove_dir_all, temp_dir, write}
import storage.saved.{SavedFiles}
import storage.world.{WorldFolder, join}
import storage.world_gen.{WorldGenSettings, read_world_gen, world_gen_id}

// The uncompressed `world_gen_settings.dat` of vanilla 26.3's new worlds with `level-seed` set to
// `calcite`: a normal one, and a flat one with `generate-structures=false`.
fn normal_hex() -> String {
    return String("")
}
fn flat_hex() -> String {
    return String("")
}

// `"calcite".hashCode()`, the seed `level-seed=calcite` gives.
const SEED: i64 = 548373029

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn hex(bytes: List<u8>) -> String {
    let digits = "0123456789abcdef"
    var out = String()
    for b in bytes {
        out.push(rune(digits.byte_at(usize(u32(b) >> 4))))
        out.push(rune(digits.byte_at(usize(b & 15))))
    }
    return out
}

fn unhex(text: String) -> List<u8> {
    var out = List<u8>()
    var i: usize = 0
    while i + 1 < text.len() {
        out.push(u8.wrap((u32(nibble(text.byte_at(i))) << 4) | u32(nibble(text.byte_at(i + 1)))))
        i += 2
    }
    return out
}

fn nibble(c: u8) -> u8 {
    return if c >= 97 { c - 87 } else { c - 48 }
}

// The file's bytes, uncompressed, for `data`.
fn file_of(data: own Tag) -> String {
    var root = JavaHashMap<String, Tag>()
    root.insert("data", data)
    root.insert("DataVersion", Tag.Int(DATA_VERSION))
    var bytes = List<u8>()
    Tag.Compound(root).write_unnamed(mut bytes)
    return hex(bytes)
}

// The `data` of the file whose bytes are `text`.
fn data_of(text: String) -> JavaHashMap<String, Tag> {
    var at: usize = 0
    var accounter = Accounter.unlimited()
    let root = match read_unnamed(unhex(text), mut at, mut accounter) {
        ok(Tag.Compound(r)) => r,
        _ => panic("the bytes aren't a compound"),
    }
    return match root["data"] {
        Tag.Compound(d) => d.copy(),
        _ => panic("no data"),
    }
}

fn parsed(data: JavaHashMap<String, Tag>) -> WorldGenSettings {
    return match WorldGenSettings.parse(data) {
        ok(s) => s,
        err(e) => panic("didn't parse: {e}"),
    }
}

fn failure(data: JavaHashMap<String, Tag>) -> String {
    return match WorldGenSettings.parse(data) {
        ok(_) => String("parsed"),
        err(e) => e,
    }
}

fn main() {
    // A new world's, as vanilla makes them.
    check(file_of(WorldGenSettings.new_world(SEED, true, String("minecraft:normal")).write()), normal_hex(), "a normal world's")
    check(file_of(WorldGenSettings.new_world(SEED, false, String("minecraft:flat")).write()), flat_hex(), "a flat world's")
    check(file_of(WorldGenSettings.new_world(SEED, true, String("flat")).write()), file_of(WorldGenSettings.new_world(SEED, true, String("minecraft:flat")).write()), "a preset without its namespace")
    check(file_of(WorldGenSettings.new_world(SEED, true, String("minecraft:debug_all_block_states")).write()), normal_hex(), "a preset Calcite generates as normal")

    // Read, and written back the same.
    let normal = parsed(data_of(normal_hex()))
    check("{normal.seed} {normal.structures} {normal.bonus_chest}", "548373029 true false", "a normal world's options")
    check(normal.overworld_type(), "minecraft:normal", "a normal world's preset")
    check(file_of(normal.write()), normal_hex(), "a normal world's written back")
    let flat = parsed(data_of(flat_hex()))
    check("{flat.seed} {flat.structures}", "548373029 false", "a flat world's options")
    check(flat.overworld_type(), "minecraft:flat", "a flat world's preset")
    check(file_of(flat.write()), flat_hex(), "a flat world's written back")
    check(parsed(data_of(file_of(WorldGenSettings.new_world(1, true, String("minecraft:amplified")).write()))).overworld_type(), "minecraft:amplified", "an amplified world's preset")
    check(parsed(data_of(file_of(WorldGenSettings.new_world(1, true, String("minecraft:large_biomes")).write()))).overworld_type(), "minecraft:large_biomes", "a large biomes world's preset")

    // The flags default where they're missing, the seed is any number, and the legacy options
    // are kept only as a string.
    var bare = data_of(normal_hex())
    _ = bare.remove("generate_structures")
    _ = bare.remove("bonus_chest")
    bare.insert("seed", Tag.Int(-5))
    bare.insert("legacy_custom_options", Tag.Str("\{\}"))
    let defaulted = parsed(bare)
    check("{defaulted.seed} {defaulted.structures} {defaulted.bonus_chest} {defaulted.legacy ?? String("none")}", "-5 true false \{\}", "the defaults")
    var odd = data_of(normal_hex())
    odd.insert("legacy_custom_options", Tag.Int(1))
    check("{parsed(odd).legacy ?? String("none")}", "none", "legacy options that aren't a string")

    // The codec's errors.
    var no_seed = JavaHashMap<String, Tag>()
    no_seed.insert("generate_structures", Tag.Byte(1))
    check(failure(no_seed), "No key seed in MapLike[\{generate_structures:1b\}]", "no seed")
    var text_seed = data_of(normal_hex())
    text_seed.insert("seed", Tag.Str("x"))
    check(failure(text_seed), "Not a number: \"x\"", "a seed that isn't a number")
    var text_flag = data_of(normal_hex())
    text_flag.insert("bonus_chest", Tag.Str("yes"))
    check(failure(text_flag), "Not a number: \"yes\"", "a flag that isn't a number")
    var no_dimensions = data_of(normal_hex())
    _ = no_dimensions.remove("dimensions")
    _ = no_dimensions.remove("bonus_chest")
    _ = no_dimensions.remove("generate_structures")
    check(failure(no_dimensions), "No key dimensions in MapLike[\{seed:548373029L\}]", "no dimensions")
    var list_dimensions = data_of(normal_hex())
    list_dimensions.insert("dimensions", Tag.Int(3))
    check(failure(list_dimensions), "Not a map: 3", "dimensions that aren't a map")

    // A dimension that isn't a compound, and an ID that isn't one.
    var not_stem = data_of(normal_hex())
    var stems = JavaHashMap<String, Tag>()
    stems.insert("minecraft:overworld", Tag.Int(1))
    not_stem.insert("dimensions", Tag.Compound(stems.copy()))
    check(failure(not_stem), "Not a map: 1", "a dimension that isn't a compound")
    var bad_key = data_of(normal_hex())
    var bad = JavaHashMap<String, Tag>()
    bad.insert("Over World", Tag.Compound(JavaHashMap<String, Tag>()))
    bad_key.insert("dimensions", Tag.Compound(bad))
    check(failure(bad_key), "Not a valid resource location: Over World Non [a-z0-9/._-] character in path of location: minecraft:Over World", "a dimension whose ID isn't one")

    // An Overworld whose generator Calcite doesn't know is generated as the normal one, as is a
    // world without one.
    var custom = data_of(normal_hex())
    var generator = JavaHashMap<String, Tag>()
    generator.insert("type", Tag.Str("minecraft:debug"))
    var stem = JavaHashMap<String, Tag>()
    stem.insert("type", Tag.Str("minecraft:overworld"))
    stem.insert("generator", Tag.Compound(generator))
    var custom_stems = JavaHashMap<String, Tag>()
    custom_stems.insert("minecraft:overworld", Tag.Compound(stem))
    custom.insert("dimensions", Tag.Compound(custom_stems))
    check(parsed(custom).overworld_type(), "minecraft:normal", "an Overworld Calcite doesn't generate")
    var none_stems = data_of(normal_hex())
    none_stems.insert("dimensions", Tag.Compound(JavaHashMap<String, Tag>()))
    check(parsed(none_stems).overworld_type(), "minecraft:normal", "no Overworld")

    // From a world's folder: missing, then saved as a save writes it, then plain.
    let universe = temp_dir()!
    var lines = List<Entry>()
    let world = match WorldFolder.open(universe, String("world"), mut lines) {
        ok(w) => w,
        err(e) => panic("the world didn't open: {e}"),
    }
    let path = join(universe, String("world/data/minecraft/world_gen_settings.dat"))
    match read_world_gen(world) {
        ok(_) => panic("a missing file was read"),
        err(e) => check(e, path, "a missing file"),
    }
    SavedFiles.world(world).save(world_gen_id(), WorldGenSettings.new_world(SEED, true, String("minecraft:normal")).write(), mut lines)!
    match read_world_gen(world) {
        ok(root) => {
            var bytes = List<u8>()
            Tag.Compound(root).write_unnamed(mut bytes)
            check(hex(bytes), normal_hex(), "the file saved and read")
        },
        err(e) => panic("the saved file wasn't read: {e}"),
    }
    make_dir_all(join(universe, String("world/data/minecraft")))!
    write(path, unhex(normal_hex()))!
    match read_world_gen(world) {
        ok(_) => panic("a plain file was read"),
        err(e) => check(e, "the file isn't gzip, or is corrupt", "a plain file"),
    }
    check("{lines.len()}", "0", "nothing logged")
    world.close(mut lines)
    remove_dir_all(universe)!
    print("ok")
}
