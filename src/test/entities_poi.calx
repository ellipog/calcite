/// Checks `storage.entities` and `storage.poi`: an entity chunk's `Position` checked and its
/// `Entities` read, with vanilla's lines and problems, and saved; a POI chunk's sections and
/// records read leniently, records that clash, the order vanilla saves them in, and an empty
/// chunk. The rig's `entities_poi` probe checks each line and byte against vanilla's.
module test.entities_poi

import nbt.snbt.{parse_compound}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.entities.{EntityChunk, Placed, logger, write_entities}
import storage.poi.{PoiChunk, PoiFormat, PoiRecord, PoiSection}
import world.pos.{BlockPos, ChunkPos}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn poi_format() -> PoiFormat {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    return PoiFormat.new(Registries { synced: [], builtin: builtin })!
}

fn compound(snbt: String) -> JavaHashMap<String, Tag> {
    return match parse_compound(snbt)! {
        Tag.Compound(tags) => tags,
        _ => panic("not a compound"),
    }
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn placed(p: Placed) -> String {
    return match p {
        Placed.Right => String("right"),
        Placed.Misplaced(at) => "at {at.x}, {at.z}",
        Placed.Unreadable => String("unreadable"),
    }
}

// The entity chunk `snbt` holds read at `x`, `z`: where it says it is, its entities, and the
// lines, the problems' last.
fn entities(x: i32, z: i32, snbt: String) -> String {
    var lines = List<Entry>()
    let chunk = EntityChunk.read(ChunkPos { x: x, z: z }, compound(snbt), mut lines)
    if let line = chunk.problems.close(logger()) {
        lines.push(line)
    }
    var out = placed(chunk.placed)
    for e in chunk.entities {
        let reporter = if e.reporter == none { "-" } else { "r" }
        out.push_str(" {Tag.Compound(e.tag.copy()).to_snbt()}{reporter}")
    }
    return "{out} {shown(lines)}"
}

// The POI chunk `snbt` holds, in a world from y -64 to 320, written back, then the lines.
fn poi(snbt: String) -> String {
    let f = poi_format()
    var lines = List<Entry>()
    let chunk = PoiChunk.read(f, ChunkPos { x: 0, z: 0 }, -4, 24, compound(snbt), mut lines)
    return "{chunk.write(f).to_snbt()} {shown(lines)}"
}

fn main() {
    // A chunk where it says it is, with an entity, an empty one and one that isn't a compound.
    check(entities(3, 4, "\{DataVersion:5023,Position:[I;3,4],Entities:[\{id:\"minecraft:pig\"\},\{\},5]\}"),
        "right \{id:\"minecraft:pig\"\}r \{\}- [[net.minecraft.world.level.chunk.storage.EntityStorage] Serialization errors:\nchunk@[3, 4]: Expected list 'Entities' to contain at index 2 value of type COMPOUND, but got INT]",
        "entities")
    check(entities(0, 0, "\{DataVersion:5023,Position:[I;1,2],Entities:[]\}"),
        "at 1, 2 [Chunk file at [0, 0] is in the wrong location. (Expected [0, 0], got [1, 2])]", "misplaced")
    check(entities(0, 0, "\{DataVersion:5023\}"), "unreadable [Failed to parse chunk [0, 0] position info]", "no position")
    check(entities(0, 0, "\{DataVersion:5023,Position:[I;0,0,7]\}"),
        "right [Failed to read field (Position=[I;0,0,7]): Input is not a list of 2 ints]", "three numbers")
    check(entities(0, 0, "\{DataVersion:5023,Position:[I;0],Entities:1\}"),
        "unreadable [Failed to read field (Position=[I;0]): Input is not a list of 2 ints][Failed to parse chunk [0, 0] position info][[net.minecraft.world.level.chunk.storage.EntityStorage] Serialization errors:\nchunk@[0, 0]: Expected field 'Entities' to contain value of type LIST, but got INT]",
        "nothing readable")
    check(entities(0, 0, "\{DataVersion:3700,Position:[I;0,0]\}"),
        "right [Entity chunk [0, 0] was saved in data version 3700, older than 26.3's 5023, and is read as it is, without the upgrade vanilla gives it]",
        "an older chunk")

    // Saved: nothing for no entities, and the chunk for any, even none saved.
    if write_entities(ChunkPos { x: 0, z: 0 }, none) != none {
        panic("a chunk with no entities was saved")
    }
    let saved = write_entities(ChunkPos { x: 7, z: -8 }, some([Tag.Compound(compound("\{id:\"minecraft:pig\"\}"))])) else panic("not saved")
    check(saved.to_snbt(), "\{DataVersion:5023,Entities:[\{id:\"minecraft:pig\"\}],Position:[I;7,-8]\}", "saved")

    // POI: no file, then sections read leniently. SNBT sorts the keys, as vanilla's
    // `toString` does; the rig checks the order they're saved in.
    let f = poi_format()
    check(PoiChunk.empty(-4, 24).write(f).to_snbt(), "\{DataVersion:5023,Sections:\{\}\}", "no file")
    check(poi("\{DataVersion:5023,Sections:\{\"0\":\{Valid:1b,Records:[\{pos:[I;1,2,3],type:\"home\",free_tickets:1\}]\},\"1\":5,\"2\":\{Valid:\"x\"\}\}\}"),
        "\{DataVersion:5023,Sections:\{\"0\":\{Records:[\{free_tickets:1,pos:[I;1,2,3],type:\"minecraft:home\"\}],Valid:1b\}\}\} [Not a map: 5][No key Records in MapLike[\{Valid:\"x\"\}]]",
        "sections")
    check(poi("\{DataVersion:5023,Sections:\{\"0\":\{Records:[5,\{pos:[I;1,2,3,4],type:\"minecraft:meeting\"\},\{pos:[I;1],type:\"nope\",free_tickets:\"a\"\}]\}\}\}"),
        "\{DataVersion:5023,Sections:\{\"0\":\{Records:[\{pos:[I;1,2,3],type:\"minecraft:meeting\"\}]\}\}\} [Not a number; Failed to get element minecraft:nope from registry minecraft:point_of_interest_type; Input is not a list of 3 ints; Input is not a list of 3 ints; Not a map: 5]",
        "records")

    // A record where one of another type is takes its place; one of the same type doesn't.
    var lines = List<Entry>()
    var section = PoiSection.new(true)
    let at = BlockPos { x: 1, y: 2, z: 3 }
    let home = f.types.parse(String("minecraft:home"))!
    let bell = f.types.parse(String("minecraft:meeting"))!
    if not section.add(PoiRecord { pos: at, kind: home, free_tickets: 0 }, mut lines) {
        panic("the first record wasn't added")
    }
    if section.add(PoiRecord { pos: BlockPos { x: 17, y: 18, z: 19 }, kind: home, free_tickets: 5 }, mut lines) {
        panic("a record of the same type was added")
    }
    if not section.add(PoiRecord { pos: at, kind: bell, free_tickets: 0 }, mut lines) {
        panic("a record of another type wasn't added")
    }
    check(shown(lines), "[POI data mismatch: already registered at BlockPos\{x=1, y=2, z=3\}]", "a clash")
    check("{section.len()} {f.types.name(section.records()[0].kind)}", "1 minecraft:meeting", "the record kept")

    // The record at the section's first block is saved first, then the rest from the table's
    // first slot up: 5, 5, 5 is in slot 1 of 32, and 2, 0, 0 in slot 19.
    check(poi("\{DataVersion:5023,Sections:\{\"0\":\{Valid:1b,Records:[\{pos:[I;5,5,5],type:\"home\"\},\{pos:[I;16,16,16],type:\"home\"\},\{pos:[I;2,0,0],type:\"home\"\}]\}\}\}"),
        "\{DataVersion:5023,Sections:\{\"0\":\{Records:[\{pos:[I;16,16,16],type:\"minecraft:home\"\},\{pos:[I;5,5,5],type:\"minecraft:home\"\},\{pos:[I;2,0,0],type:\"minecraft:home\"\}],Valid:1b\}\}\} ",
        "the order")
    println("ok")
}
