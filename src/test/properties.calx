/// Checks java.properties against what Java 25's `Properties.load` gives for the same text. Each
/// expected line is what build/scratch/props/PropsProbe.java printed: the keys in order, each
/// with its value, every character outside printable ASCII as a `\u` escape of its UTF-16 units.
/// Then `store` against what `Properties.store` wrote, as build/scratch/store/StoreProbe.java
/// showed it, and `compare_to` against `String.compareTo`.
module test.properties

import java.properties.{Properties}
import java.text.{compare_to}

fn show(s: String) -> String {
    let hex = "0123456789abcdef"
    var out = String()
    for c in s.chars() {
        let u = u16(c)
        if u >= 0x20 and u < 0x7F and u != 92 and u != 124 {
            out.push(rune(u8.wrap(u)))
        } else {
            out.push_str("\\u")
            var shift: i32 = 12
            while shift >= 0 {
                let d = usize.wrap((i32(u) >> shift) & 15)
                out.push_str(hex[d..d + 1])
                shift -= 4
            }
        }
    }
    return out
}

fn loaded(text: String) -> String {
    return match Properties.parse(text) {
        ok(p) => {
            // By key, as Java's `TreeSet` orders them: no key here has a rune past U+FFFF, where
            // the orders of code points and of UTF-16 units differ.
            var entries = p.entries()
            entries.sort()
            var out = String()
            for e in entries {
                out.push_str("{show(e.key)}={show(e.value)}|")
            }
            out
        },
        err(message) => "error: {message}",
    }
}

fn check(text: String, want: String) {
    let got = loaded(text)
    if got != want {
        panic("for {show(text)}: got {got}, want {want}")
    }
}

fn main() {
    check("motd=A Minecraft Server\nserver-port=25565", "motd=A Minecraft Server|server-port=25565|")
    check("# a comment\n! another\n   key   value\na:b\nc = d\ne\t=\tf", "a=b|c=d|e=f|key=value|")
    check("fruits                           apple, banana, pear, \\\n                                  cantaloupe, watermelon, \\\n                                  kiwi, mango", "fruits=apple, banana, pear, cantaloupe, watermelon, kiwi, mango|")
    // A continued line isn't a comment, though it starts with `#`, and a comment can't continue.
    check("a=b\\\n#c", "a=b#c|")
    check("# comment \\\nb=c", "b=c|")
    // A blank line after a continuation ends it.
    check("a=b\\\n\nc=d", "a=b|c=d|")
    // An even run of backslashes escapes itself, not the line end.
    check("a=b\\\\\nc=d", "a=b\\u005c|c=d|")
    check("a=b\\\\\\\n  c", "a=b\\u005cc|")
    check("a=b\\", "a=b|")
    check("key\\=x=1\nkey\\:y:2\nkey\\ z 3", "key z=3|key:y=2|key=x=1|")
    check("=empty key\nempty value=\nlonely", "=empty key|empty=value=|lonely=|")
    check("a=\\t\\n\\r\\f\\b\\q\\\"\\'", "a=\\u0009\\u000a\\u000d\\u000cbq\"'|")
    check("a=\\u00e9\\u20AC", "a=\\u00e9\\u20ac|")
    check("a=\\uD83D\\uDE00", "a=\\ud83d\\ude00|")
    // Java keeps an unpaired surrogate, which a `String` can't hold: Java gives `a=\ud83d|`.
    check("a=\\uD83D", "a=\\ufffd|")
    check("a=\\u12", "error: Malformed \\uxxxx encoding.")
    check("a=\\u12G4", "error: Malformed \\uxxxx encoding.")
    check("a=1\na=2", "a=2|")
    check("a=b\rc=d\r\re=f", "a=b|c=d|e=f|")
    check("a=b\\\r  c\r", "a=bc|")
    check("  \u{C}\tk\tv", "k=v|")
    check("a==b\nb=:c\nc :=d", "a==b|b=:c|c==d|")
    check("é=ü", "\\u00e9=\\u00fc|")
    check("a\\\nb=c", "ab=c|")
    check("\\#a=b\n\\!c=d", "!c=d|#a=b|")
    check("a=b \\", "a=b |")
    check("a = b \\\\\\\\\nc=d", "a=b \\u005c\\u005c|c=d|")
    check("", "")

    // What Java 25 wrote for these, with `\r\n` as `\n`.
    var p = Properties.new()
    p.set("motd", "A Minecraft Server")
    p.set("server-port", "25565")
    p.set("b key", "lead")
    p.set("a=key", " two  spaces ")
    p.set("c:key", "x=y:z")
    p.set("#hash", "#v!v")
    p.set("!bang", "!")
    p.set("tab\tkey", "tab\tvalue\nnew\rline\u{C}form")
    p.set("back\\slash", "a\\b")
    p.set("uni", "caf\u{E9} \u{A7}c \u{4E2D} \u{1F600} \u{7F} \u{1}")
    p.set("empty", "")
    p.set("Zed", "upper")
    p.set("level-seed", "")
    let entries = "\\!bang=\\!\n\\#hash=\\#v\\!v\nZed=upper\na\\=key=\\ two  spaces \nb\\ key=lead\nback\\\\slash=a\\\\b\nc\\:key=x\\=y\\:z\nempty=\nlevel-seed=\nmotd=A Minecraft Server\nserver-port=25565\ntab\\tkey=tab\\tvalue\\nnew\\rline\\fform\nuni=caf\u{E9} \u{A7}c \u{4E2D} \u{1F600} \u{7F} \u{1}\n"
    same(p.store(some(String("Minecraft server properties")), String("Thu Oct 29 10:48:03 CET 2026")), "#Minecraft server properties\n#Thu Oct 29 10:48:03 CET 2026\n{entries}")
    same(p.store(some(String("line one\nline two\r\n#kept\n!kept\ncaf\u{E9}")), String("D")), "#line one\n#line two\n#kept\n!kept\n#caf\u{E9}\n#D\n{entries}")
    // Past U+00FF, a comment has escapes, and a line break that ends it starts an empty comment.
    same(Properties.new().store(some(String("\u{4E2D}\u{1F600}\n")), String("D")), "#\\u4E2D\\uD83D\\uDE00\n#\n#D\n")
    same(Properties.new().store(none, String("D")), "#D\n")
    // What `store` writes, `parse` reads back.
    let back = Properties.parse(p.store(none, String("D")))!
    for e in p.entries() {
        same(back.get(e.key) ?? String("missing"), e.value)
    }

    // A rune past U+FFFF is two UTF-16 units, the first a high surrogate, before U+E000.
    same("{compare_to("a", "b")} {compare_to("b", "a")} {compare_to("ab", "a")} {compare_to("a", "a")}", "Less Greater Greater Equal")
    same("{compare_to("\u{1F600}", "\u{FFFD}")} {compare_to("\u{E000}", "\u{1F600}")} {compare_to("\u{1F600}", "\u{1F601}")} {compare_to("x\u{10000}", "x\u{FFFF}")}", "Less Greater Less Less")
    println("ok")
}

fn same(got: String, want: String) {
    if got != want {
        panic("got {show(got)}, want {show(want)}")
    }
}
