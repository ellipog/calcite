/// Checks `storage.progress` on a world of its own: advancements and statistics saved and read
/// back, files that aren't there, aren't JSON or aren't UTF-8, the data versions vanilla reads
/// and Calcite's warnings for them, statistics moved from a player's name to their UUID, and
/// the lines for a save with nowhere to go. The rig's `world_folder` probe checks it against
/// vanilla.
module test.progress

import json.gson.{JsonWriter}
import json.tree.{Json, Member}
import server.log.{Entry}
import std.fs.{is_file, make_dir_all, read, remove_dir_all, temp_dir, write}
import storage.progress.{ProgressFiles, version_of}
import storage.world.{WorldFolder, join}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn found(json: Json?) -> String {
    let j = json else return String("none")
    var w = JsonWriter.new()
    w.tree(j)
    return w.into_string()
}

fn text(path: String) -> String {
    return String.from_utf8(read(path)!)!
}

fn number(t: str) -> Json {
    return Json.Number(String(t))
}

fn version(json: Json) -> String {
    return match version_of(json) {
        some(v) => "{v}",
        none => String("throws"),
    }
}

fn with_version(value: own Json) -> Json {
    var m = List<Member>()
    m.push(Member { key: String("DataVersion"), value: value })
    return Json.Object(m)
}

fn uuid() -> String {
    return String("0a1b2c3d-0000-4000-8000-000000000001")
}

fn main() {
    let universe = temp_dir()!
    let world = match WorldFolder.open(universe, String("world")) {
        ok(w) => w,
        err(e) => panic("the world didn't open: {e}"),
    }
    var lines = List<Entry>()
    let advancements = ProgressFiles.advancements(world)
    let stats = ProgressFiles.stats(world)
    check(advancements.folder, join(universe, String("world/players/advancements")), "the advancements folder")
    check(stats.folder, join(universe, String("world/players/stats")), "the stats folder")
    let a = advancements.file(uuid())
    check(a, join(universe, "world/players/advancements/{uuid()}.json"), "an advancements file")

    // Nothing saved yet.
    check(found(advancements.load(a, mut lines)), "none", "no file")

    // Saved, pretty, with the version after, and read back.
    var members = List<Member>()
    var criteria = List<Member>()
    criteria.push(Member { key: String("has_the_recipe"), value: Json.Str(String("2026-10-31 12:00:00 +0000")) })
    var progress = List<Member>()
    progress.push(Member { key: String("criteria"), value: Json.Object(criteria) })
    progress.push(Member { key: String("done"), value: Json.Bool(true) })
    members.push(Member { key: String("minecraft:recipes/misc/<x>"), value: Json.Object(progress) })
    advancements.save(a, members, mut lines)
    check(text(a), "\{\n  \"minecraft:recipes/misc/\\u003cx\\u003e\": \{\n    \"criteria\": \{\n      \"has_the_recipe\": \"2026-10-31 12:00:00 +0000\"\n    \},\n    \"done\": true\n  \},\n  \"DataVersion\": 5023\n\}", "saved advancements")
    check(found(advancements.load(a, mut lines)), "\{\"minecraft:recipes/misc/<x>\":\{\"criteria\":\{\"has_the_recipe\":\"2026-10-31 12:00:00 +0000\"\},\"done\":true\},\"DataVersion\":5023\}", "read back")
    check(shown(lines), "", "nothing logged")

    // A `DataVersion` already there keeps its place.
    var placed = List<Member>()
    placed.push(Member { key: String("DataVersion"), value: number("1") })
    placed.push(Member { key: String("x"), value: Json.Null })
    advancements.save(a, placed, mut lines)
    check(text(a), "\{\n  \"DataVersion\": 5023\n\}", "a version in place, and a null left out")

    // Statistics, under `stats`.
    let s = stats.file(uuid())
    var counts = List<Member>()
    var custom = List<Member>()
    custom.push(Member { key: String("minecraft:jump"), value: number("3") })
    counts.push(Member { key: String("minecraft:custom"), value: Json.Object(custom) })
    stats.save(s, counts, mut lines)
    check(text(s), "\{\n  \"stats\": \{\n    \"minecraft:custom\": \{\n      \"minecraft:jump\": 3\n    \}\n  \},\n  \"DataVersion\": 5023\n\}", "saved stats")
    check(found(stats.load(s, mut lines)), "\{\"stats\":\{\"minecraft:custom\":\{\"minecraft:jump\":3\}\},\"DataVersion\":5023\}", "stats read back")
    check(shown(lines), "", "nothing logged for stats")

    // Files that can't be read, each kind's lines.
    write(a, "\{\"a\":".to_bytes())!
    check(found(advancements.load(a, mut lines)), "none", "not JSON")
    write(a, [123, 125, 255])!
    check(found(advancements.load(a, mut lines)), "none", "not UTF-8")
    write(s, "[1 2]".to_bytes())!
    check(found(stats.load(s, mut lines)), "none", "stats not JSON")
    write(s, [255])!
    check(found(stats.load(s, mut lines)), "none", "stats not UTF-8")
    check(shown(lines), "[Couldn't parse player advancements in {a}][Couldn't access player advancements in {a}][Couldn't parse statistics file {s}][Couldn't parse statistics file {s}]", "unreadable files")
    lines = List<Entry>()

    // An empty file is null, and a folder isn't read.
    write(a, [])!
    check(found(advancements.load(a, mut lines)), "null", "an empty file")
    let folder = advancements.file(String("folder"))
    make_dir_all(folder)!
    check(found(advancements.load(folder, mut lines)), "none", "a folder")
    check(shown(lines), "", "nothing logged for those")

    // Versions: older ones, none, and one Java throws for, are read as they are with warnings.
    write(a, "\{\"DataVersion\": 100\}".to_bytes())!
    check(found(advancements.load(a, mut lines)), "\{\"DataVersion\":100\}", "an old version")
    write(a, "\{\}".to_bytes())!
    check(found(advancements.load(a, mut lines)), "\{\}", "no version")
    write(a, "\{\"DataVersion\": 1e10000\}".to_bytes())!
    check(found(advancements.load(a, mut lines)), "\{\"DataVersion\":1e10000\}", "a version Java throws for")
    write(a, "[]".to_bytes())!
    check(found(advancements.load(a, mut lines)), "[]", "not an object")
    check(shown(lines), "[{a} was saved in data version 100, older than 26.3's 5023, and is read as it is, without the upgrade vanilla gives it][{a} was saved in data version 1343, older than 26.3's 5023, and is read as it is, without the upgrade vanilla gives it][{a} has a DataVersion vanilla can't read as an int, and is read as it is]", "the versions' warnings")
    lines = List<Entry>()

    check(version(with_version(number("5023"))), "5023", "a version")
    check(version(with_version(number("5023.9"))), "5023", "a fraction")
    check(version(with_version(number("4294972319"))), "5023", "a long")
    check(version(with_version(number("1e2"))), "100", "an exponent")
    check(version(with_version(number("1e10000"))), "throws", "too great a scale")
    check(version(with_version(Json.Bool(true))), "1343", "true")
    check(version(with_version(Json.Bool(false))), "1343", "false")
    check(version(with_version(Json.Str(String("5023")))), "1343", "a string")
    check(version(with_version(Json.Null)), "1343", "null")
    check(version(Json.Object(List<Member>())), "1343", "none")
    check(version(Json.Null), "1343", "not an object")
    var twice = List<Member>()
    twice.push(Member { key: String("DataVersion"), value: number("1") })
    twice.push(Member { key: String("DataVersion"), value: number("2") })
    check(version(Json.Object(twice)), "2", "the last of two")

    // Statistics under a name: moved to the UUID's file when the name makes a file name.
    let moved_uuid = String("0a1b2c3d-0000-4000-8000-000000000002")
    let old = join(stats.folder, String("steve.json"))
    write(old, "\{\}".to_bytes())!
    let located = stats.locate(moved_uuid, String("steve"), mut lines)
    check(located, stats.file(moved_uuid), "moved")
    check("{is_file(old)} {is_file(located)}", "false true", "the file moved")
    // The UUID's file is found first.
    write(join(stats.folder, String("alex.json")), "\{\}".to_bytes())!
    check(stats.locate(moved_uuid, String("alex"), mut lines), stats.file(moved_uuid), "the UUID's first")
    check("{is_file(join(stats.folder, String("alex.json")))}", "true", "alex kept")
    // A name with capitals isn't one vanilla looks for, nor a folder under it.
    let third = String("0a1b2c3d-0000-4000-8000-000000000003")
    write(join(stats.folder, String("Notch.json")), "\{\}".to_bytes())!
    check(stats.locate(third, String("Notch"), mut lines), stats.file(third), "a name with capitals")
    make_dir_all(join(stats.folder, String("dir.json")))!
    check(stats.locate(third, String("dir"), mut lines), stats.file(third), "a folder under the name")
    check("{is_file(stats.file(third))}", "false", "nothing moved")
    check(shown(lines), "", "nothing logged for the moves")

    // Nowhere to save: a folder where the file goes, and a file where the folder does.
    make_dir_all(stats.file(String("blocked")))!
    stats.save(stats.file(String("blocked")), List<Member>(), mut lines)
    write(join(universe, String("world/players/file")), [1])!
    let nowhere = ProgressFiles.at(stats.kind, join(universe, String("world/players/file")))
    advancements.save(join(nowhere.folder, String("x.json")), List<Member>(), mut lines)
    check(shown(lines), "[Couldn't save stats to {stats.file(String("blocked"))}][Couldn't save player advancements to {join(nowhere.folder, String("x.json"))}]", "saves with nowhere to go")

    world.close(mut lines)
    remove_dir_all(universe)!
    print("ok")
}
