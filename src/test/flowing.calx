/// Checks water and lava flowing in the server's level as their ticks run, vanilla's
/// `FlowingFluid.tick` (D328), on a flat level whose chunks tick, with block facts made from the
/// built-in block and fluid registries: a source spreads a step to each side, the way to a hole
/// alone where there's one, two sources make a third between them unless the game rule says no,
/// and lava flowing down onto water makes stone, with a fizz. And blocks a chunk's generation
/// marked, done as it starts ticking, `postProcessGeneration` (D329), with the shapes of the
/// last classes `updateShape` took, D332's. And each block's scheduled tick, as the class that
/// declares its `tick` has it (D335), and random ticks, by the class that declares `randomTick`
/// (D338). And fire, set by lava, ticking, burning and lighting a portal (D339). And
/// precipitation: water freezing, snow laid and cauldrons filling (D340).
module test.flowing

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry, Tag}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{AIR_STATE, BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL, UPDATE_KNOWN_SHAPE, UPDATE_SKIP_ON_PLACE}
import world.post_process.{post_process}
import world.precipitation.{Precipitation}
import world.random_ticks.{RandomTicks, TickPlace}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}
import worldgen.temperature.{Temperatures}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: table(), min_section: -4, sections: 24, sky_light: true }
}

// The block states' table, with the blocks the tests' heightmaps meet that block motion: the
// flat world's ground, stone, ice and cauldrons (D340).
fn table() -> BlockStates {
    var motion = List<i32>()
    let entries = builtin_entries(4)
    for name in ["stone", "grass_block", "dirt", "bedrock", "ice", "cauldron", "water_cauldron", "powder_snow_cauldron"] {
        var found = false
        for i in 0..entries.len() {
            if full(entries[i].copy()).path == String(name) {
                motion.push(i32.wrap(i))
                found = true
            }
        }
        if not found {
            panic("no block {name}")
        }
    }
    return BlockStates.new(motion.copy(), motion, 1)
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, table())
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2), with the fluid tags
// water and lava, the airs and the poppy washed away by fluids, the snow tag, the blocks and
// fluid of bubble columns, obsidian as a portal's frame, farmland under crops, the oak log
// keeping leaves from decaying, the fires, and netherrack burning forever in the Overworld, as
// vanilla's data has them.
fn facts() -> Facts {
    let plain = match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
    var washed = List<i32>()
    for name in ["air", "cave_air", "void_air", "water", "lava", "poppy"] {
        washed.push(i32.wrap(plain.block(named(plain, name))))
    }
    var snow = List<i32>()
    for name in ["snow", "snow_block", "powder_snow"] {
        snow.push(i32.wrap(plain.block(named(plain, name))))
    }
    var blocks = registry(4, "block")
    blocks.tags.push(Tag { name: full("washed_away_by_fluids"), values: washed })
    blocks.tags.push(Tag { name: full("snow"), values: snow })
    blocks.tags.push(Tag { name: full("enables_bubble_column_drag_down"), values: [i32.wrap(plain.block(named(plain, "magma_block")))] })
    blocks.tags.push(Tag { name: full("enables_bubble_column_push_up"), values: [i32.wrap(plain.block(named(plain, "soul_sand")))] })
    blocks.tags.push(Tag { name: full("nether_portal_frame"), values: [i32.wrap(plain.block(named(plain, "obsidian")))] })
    blocks.tags.push(Tag { name: full("supports_crops"), values: [i32.wrap(plain.block(named(plain, "farmland")))] })
    blocks.tags.push(Tag { name: full("prevents_nearby_leaf_decay"), values: [i32.wrap(plain.block(named(plain, "oak_log")))] })
    var fires = List<i32>()
    for name in ["fire", "soul_fire"] {
        fires.push(i32.wrap(plain.block(named(plain, name))))
    }
    blocks.tags.push(Tag { name: full("fire"), values: fires })
    blocks.tags.push(Tag { name: full("infiniburn_overworld"), values: [i32.wrap(plain.block(named(plain, "netherrack")))] })
    var fluids = registry(2, "fluid")
    fluids.tags.push(Tag { name: full("water"), values: [1, 2] })
    fluids.tags.push(Tag { name: full("lava"), values: [3, 4] })
    fluids.tags.push(Tag { name: full("bubble_column_can_occupy"), values: [2] })
    return match Facts.new(blocks, fluids, BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// A flat level, its spawn's chunks full and given the facts, with a player at its middle, so
// its chunks tick.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(env(f))
    return level
}

fn env(f: Facts) -> Env {
    return Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 }
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn water(f: Facts, level: i32) -> u32 {
    return match f.with_int(f.ids.water_state, String("level"), level) {
        ok(s) => s,
        err(_) => panic("water has no level {level}"),
    }
}

// Runs `ticks` ticks of the level's blocks, then its fluids, as `ServerLevel.tick` runs them.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
    }
}

// What the level reported, one line each.
fn reported(level: mut Level) -> String {
    var out = String("")
    for e in level.take_lines() {
        out = "{out}{e.message}; "
    }
    return out
}

// A source on flat ground: its tick, five ticks on, spreads it a step to each side, level 1,
// and those ticks spread them a step more.
fn spreads() {
    let f = facts()
    var level = flat_level(f)
    check(level.set_block(4, -60, 4, f.ids.water_state, UPDATE_ALL), "the water wasn't set")
    run(mut level, 4)
    check(level.spawn_state(5, -60, 4) == AIR_STATE, "the water spread before its tick")
    run(mut level, 1)
    check(level.spawn_state(5, -60, 4) == water(f, 1) and level.spawn_state(3, -60, 4) == water(f, 1), "the water didn't spread east and west")
    check(level.spawn_state(4, -60, 5) == water(f, 1) and level.spawn_state(4, -60, 3) == water(f, 1), "the water didn't spread north and south")
    check(level.spawn_state(5, -60, 5) == AIR_STATE, "the water spread to a corner at once")
    run(mut level, 5)
    check(level.spawn_state(6, -60, 4) == water(f, 2) and level.spawn_state(5, -60, 5) == water(f, 2), "the flowing water didn't spread a step more")
    check(level.spawn_state(4, -60, 4) == f.ids.water_state, "the source didn't stay")
    let lines = reported(mut level)
    if lines.contains("isn't in Calcite yet") {
        panic("water on grass reported {lines}")
    }
    println("ok spreads")
}

// A hole two blocks east: the water flows that way alone.
fn finds_hole() {
    let f = facts()
    var level = flat_level(f)
    check(level.set_block(6, -61, 4, AIR_STATE, UPDATE_ALL), "the hole wasn't dug")
    check(level.set_block(4, -60, 4, f.ids.water_state, UPDATE_ALL), "the water wasn't set")
    run(mut level, 5)
    check(level.spawn_state(5, -60, 4) == water(f, 1), "the water didn't flow toward the hole")
    check(level.spawn_state(3, -60, 4) == AIR_STATE and level.spawn_state(4, -60, 5) == AIR_STATE and level.spawn_state(4, -60, 3) == AIR_STATE, "the water flowed away from the hole")
    run(mut level, 5)
    check(level.spawn_state(6, -60, 4) == water(f, 2), "the water didn't reach the hole")
    run(mut level, 5)
    check(level.spawn_state(6, -61, 4) == water(f, 8), "the water didn't fall into the hole")
    println("ok finds_hole")
}

// Two sources a block apart on grass make a third between them as the first spreads, since
// what it spreads is what the block between becomes from both, unless the game rule's off.
fn makes_source() {
    let f = facts()
    for converts in [true, false] {
        var level = flat_level(f)
        level.water_source_conversion = converts
        check(level.set_block(2, -60, 12, f.ids.water_state, UPDATE_ALL) and level.set_block(4, -60, 12, f.ids.water_state, UPDATE_ALL), "the sources weren't set")
        run(mut level, 5)
        let between = level.spawn_state(3, -60, 12)
        if converts {
            check(between == f.ids.water_state, "two sources didn't make a third")
        } else {
            check(between == water(f, 1), "two sources made a third with the rule off")
        }
        run(mut level, 5)
        check(level.spawn_state(3, -60, 12) == between, "the water between the sources changed on its tick")
    }
    println("ok makes_source")
}

// Lava above water: it doesn't turn as it's set, since its own check looks above and beside, but
// its tick, 30 on, flows down onto the water, which turns to stone, with a fizz.
fn lava_makes_stone() {
    let f = facts()
    var level = flat_level(f)
    check(level.set_block(8, -60, 8, f.ids.water_state, UPDATE_ALL), "the water wasn't set")
    check(level.set_block(8, -59, 8, f.ids.lava_state, UPDATE_ALL), "the lava wasn't set")
    check(level.spawn_state(8, -59, 8) == f.ids.lava_state, "the lava above the water turned as it was set")
    _ = level.take_events()
    run(mut level, 29)
    check(level.spawn_state(8, -60, 8) == f.ids.water_state, "the lava flowed before its tick")
    run(mut level, 1)
    check(level.spawn_state(8, -60, 8) == named(f, "stone"), "the lava didn't turn the water under it to stone")
    let events = level.take_events()
    check(events.len() == 1 and events[0].kind == 1501 and events[0].x == 8 and events[0].y == -60 and events[0].z == 8, "the stone's fizz")
    println("ok lava_makes_stone")
}

// Post-processes the block at `x`, `y`, `z`, as a chunk does as it starts ticking.
fn post(e: Env, level: mut Level, x: i32, y: i32, z: i32) {
    match post_process(e, mut level, x, y, z) {
        ok => {},
        err(thrown) => panic("post-processing {x}, {y}, {z} threw {thrown.message}"),
    }
}

// Blocks a chunk's generation marked, done as it starts ticking (D329): a source set without its
// tick spreads a step at once, with the ticks of what it set; grass set under snow without being
// told turns snowy; and a source over magma makes a bubble column dragging down through it and
// the source over it (D335).
fn post_processed() {
    let f = facts()
    let e = env(f)
    var level = flat_level(f)
    let quiet = UPDATE_KNOWN_SHAPE | UPDATE_SKIP_ON_PLACE
    check(level.set_block(4, -60, 4, f.ids.water_state, quiet), "the water wasn't set")
    run(mut level, 10)
    check(level.spawn_state(5, -60, 4) == AIR_STATE, "the water set without its tick spread")
    post(e, mut level, 4, -60, 4)
    check(level.spawn_state(5, -60, 4) == water(f, 1) and level.spawn_state(3, -60, 4) == water(f, 1), "the water didn't spread east and west at once")
    check(level.spawn_state(4, -60, 5) == water(f, 1) and level.spawn_state(4, -60, 3) == water(f, 1), "the water didn't spread north and south at once")
    run(mut level, 5)
    check(level.spawn_state(6, -60, 4) == water(f, 2), "what the water set at once had no ticks")
    let grass = named(f, "grass_block")
    check(level.set_block(10, -60, 10, named(f, "snow"), quiet), "the snow wasn't set")
    check(level.spawn_state(10, -61, 10) == grass, "the grass under the snow was told")
    post(e, mut level, 10, -61, 10)
    let snowy = match f.with_bool(grass, String("snowy"), true) {
        ok(s) => s,
        err(_) => panic("grass has no snowy"),
    }
    check(level.spawn_state(10, -61, 10) == snowy, "the grass under the snow didn't turn snowy")
    post(e, mut level, 10, -62, 10)
    check(level.spawn_state(10, -62, 10) == named(f, "dirt"), "the dirt changed")
    // A red mushroom on grass in the sun can't stay, as `MushroomBlock.canSurvive` has it.
    check(level.set_block(12, -60, 10, named(f, "red_mushroom"), quiet), "the mushroom wasn't set")
    post(e, mut level, 12, -60, 10)
    check(level.spawn_state(12, -60, 10) == AIR_STATE, "the mushroom in the sun stayed")
    let lines = reported(mut level)
    if lines.contains("isn't in Calcite yet") {
        panic("post-processing water and grass reported {lines}")
    }
    check(level.set_block(14, -61, 14, named(f, "magma_block"), quiet) and level.set_block(14, -60, 14, f.ids.water_state, quiet) and level.set_block(14, -59, 14, f.ids.water_state, quiet), "the water over magma wasn't set")
    post(e, mut level, 14, -60, 14)
    let dragging = column_of(f, true)
    check(level.spawn_state(14, -60, 14) == dragging and level.spawn_state(14, -59, 14) == dragging, "the water over magma didn't make a bubble column dragging down")
    check(level.spawn_state(14, -58, 14) == AIR_STATE, "the bubble column went past the water")
    let later = reported(mut level)
    if later.contains("isn't in Calcite yet") {
        panic("the bubble column reported {later}")
    }
    println("ok post_processed")
}

// A bubble column, dragging down or pushing up.
fn column_of(f: Facts, drag: bool) -> u32 {
    return match f.with_bool(named(f, "bubble_column"), String("drag"), drag) {
        ok(s) => s,
        err(_) => panic("a bubble column has no drag"),
    }
}

// Oak leaves `distance` from a log.
fn leaves_at(f: Facts, distance: i32) -> u32 {
    return match f.with_int(named(f, "oak_leaves"), String("distance"), distance) {
        ok(s) => s,
        err(_) => panic("leaves have no distance {distance}"),
    }
}

// Each block's scheduled tick, as the class that declares its `tick` has it (D335): leaves a log's
// set by take 1 as their distance on the tick their shape update gave them, and the leaves past
// them 2 a tick on; water over soul sand makes a bubble column pushing up through the water over
// it as its tick comes, 20 on; a cactus with stone set by it breaks; a coral block out of water,
// and a coral fan, die; and a path and farmland under stone turn to dirt.
fn block_ticks() {
    let f = facts()
    var level = flat_level(f)
    let quiet = UPDATE_KNOWN_SHAPE | UPDATE_SKIP_ON_PLACE
    let stone = named(f, "stone")
    let leaves = named(f, "oak_leaves")
    check(level.set_block(2, -60, 2, leaves, quiet) and level.set_block(1, -60, 2, leaves, quiet), "the leaves weren't set")
    check(level.set_block(3, -60, 2, named(f, "oak_log"), UPDATE_ALL), "the log wasn't set")
    check(level.spawn_state(2, -60, 2) == leaves, "the leaves by the log changed before their tick")
    run(mut level, 1)
    check(level.spawn_state(2, -60, 2) == leaves_at(f, 1), "the leaves by the log aren't 1 from it")
    check(level.spawn_state(1, -60, 2) == leaves, "the leaves past them changed on the same tick")
    run(mut level, 1)
    check(level.spawn_state(1, -60, 2) == leaves_at(f, 2), "the leaves past them aren't 2 from the log")
    check(level.set_block(6, -60, 6, f.ids.water_state, quiet) and level.set_block(6, -59, 6, f.ids.water_state, quiet), "the water wasn't set")
    check(level.set_block(6, -61, 6, named(f, "soul_sand"), UPDATE_ALL), "the soul sand wasn't set")
    run(mut level, 19)
    check(level.spawn_state(6, -60, 6) == f.ids.water_state, "the bubble column came before the water's tick")
    run(mut level, 1)
    let pushing = column_of(f, false)
    check(level.spawn_state(6, -60, 6) == pushing and level.spawn_state(6, -59, 6) == pushing, "the water over soul sand didn't make a bubble column pushing up")
    check(level.spawn_state(6, -58, 6) == AIR_STATE, "the bubble column went past the water")
    let cactus = named(f, "cactus")
    check(level.set_block(10, -60, 10, cactus, quiet) and level.set_block(11, -60, 10, stone, UPDATE_ALL), "the cactus and the stone by it weren't set")
    check(level.spawn_state(10, -60, 10) == cactus, "the cactus broke before its tick")
    run(mut level, 1)
    check(level.spawn_state(10, -60, 10) == AIR_STATE, "the cactus by stone stayed")
    let coral = named(f, "tube_coral_block")
    check(level.set_block(14, -60, 14, coral, quiet) and level.set_block(15, -60, 14, stone, UPDATE_ALL), "the coral block and the stone by it weren't set")
    check(level.has_block_tick(f.block(coral), 14, -60, 14), "the coral block out of water has no tick")
    let fan = match f.with_bool(with(f, "tube_coral_wall_fan", "facing", "east"), String("waterlogged"), false) {
        ok(s) => s,
        err(_) => panic("a coral wall fan has no waterlogged"),
    }
    check(level.set_block(18, -60, 18, fan, UPDATE_ALL), "the coral fan wasn't set")
    check(level.spawn_state(18, -60, 18) == fan, "the coral fan changed as it was set")
    run(mut level, 100)
    check(level.spawn_state(14, -60, 14) == named(f, "dead_tube_coral_block"), "the coral block out of water didn't die")
    let dead_fan = match f.with_bool(with(f, "dead_tube_coral_wall_fan", "facing", "east"), String("waterlogged"), false) {
        ok(s) => s,
        err(_) => panic("a dead coral wall fan has no waterlogged"),
    }
    check(level.spawn_state(18, -60, 18) == dead_fan, "the coral fan out of water didn't die facing as it did")
    check(level.set_block(2, -61, 14, named(f, "dirt_path"), quiet) and level.set_block(4, -61, 14, named(f, "farmland"), quiet), "the path and farmland weren't set")
    check(level.set_block(2, -60, 14, stone, UPDATE_ALL) and level.set_block(4, -60, 14, stone, UPDATE_ALL), "the stone over them wasn't set")
    run(mut level, 1)
    check(level.spawn_state(2, -61, 14) == named(f, "dirt") and level.spawn_state(4, -61, 14) == named(f, "dirt"), "the path and farmland under stone didn't turn to dirt")
    let lines = reported(mut level)
    if lines.contains("tick of") or lines.contains("Place of") or lines.contains("Changed of") {
        panic("the block ticks reported {lines}")
    }
    println("ok block_ticks")
}

// The state `state` with its `age` at `value`.
fn aged(f: Facts, state: u32, value: i32) -> u32 {
    return match f.with_int(state, String("age"), value) {
        ok(s) => s,
        err(_) => panic("no age {value}"),
    }
}

// Random ticks by the class that declares `randomTick` (D338): sugar cane at 15 grows a cane
// above and goes back to 0, a new one ages, and none grows past three high; leaves decaying go,
// saying what they drop isn't in Calcite yet, and placed ones stay; and lava by planks, with air
// over them, sets fire near a player, which has its tick (D339), and none away from every player.
fn random_ticks_by_class() {
    let f = facts()
    var level = flat_level(f)
    let ticks = match RandomTicks.new(f) {
        ok(made) => made,
        err(e) => panic("the random ticks: {e}"),
    }
    let quiet = UPDATE_KNOWN_SHAPE | UPDATE_SKIP_ON_PLACE
    level.place = TickPlace {}
    let cane = named(f, "sugar_cane")
    let ripe = aged(f, cane, 15)
    check(level.set_block(20, -60, 20, ripe, quiet), "the cane wasn't set")
    level.random_tick(ticks, 20, -60, 20)
    check(level.spawn_state(20, -59, 20) == cane and level.spawn_state(20, -60, 20) == cane, "the ripe cane didn't grow one above and go back to 0")
    level.random_tick(ticks, 20, -59, 20)
    check(level.spawn_state(20, -59, 20) == aged(f, cane, 1), "the new cane didn't age")
    check(level.set_block(20, -58, 20, ripe, quiet), "the third cane wasn't set")
    level.random_tick(ticks, 20, -58, 20)
    check(level.spawn_state(20, -57, 20) == AIR_STATE and level.spawn_state(20, -58, 20) == ripe, "the cane grew past three high")
    _ = reported(mut level)
    let leaves = named(f, "oak_leaves")
    let placed = match f.with_bool(leaves, String("persistent"), true) {
        ok(s) => s,
        err(_) => panic("leaves have no persistent"),
    }
    check(level.set_block(22, -60, 22, leaves, quiet) and level.set_block(24, -60, 22, placed, quiet), "the leaves weren't set")
    level.random_tick(ticks, 22, -60, 22)
    level.random_tick(ticks, 24, -60, 22)
    check(level.spawn_state(22, -60, 22) == AIR_STATE, "the decaying leaves stayed")
    check(level.spawn_state(24, -60, 22) == placed, "the placed leaves went")
    check(reported(mut level).contains("What a broken block drops"), "the decaying leaves didn't say what they drop isn't in this level, which has no loot")
    let planks = named(f, "oak_planks")
    check(level.set_block(26, -61, 26, f.ids.lava_state, quiet), "the lava wasn't set")
    for dx in -1..2 {
        for dz in -1..2 {
            if dx != 0 or dz != 0 {
                check(level.set_block(26 + dx, -61, 26 + dz, planks, quiet), "the planks weren't set")
            }
        }
    }
    for _ in 0..50 {
        level.random_tick(ticks, 26, -61, 26)
    }
    let fire = f.block(named(f, "fire"))
    check(fire_by(f, level, 26, -60, 26) == none, "lava away from every player set fire")
    var players = List<(f64, f64, f64)>()
    players.push((26.5, -60.0, 26.5))
    level.place = TickPlace { players: players }
    for _ in 0..20 {
        level.random_tick(ticks, 26, -61, 26)
    }
    let (fx, fz) = fire_by(f, level, 26, -60, 26) else panic("lava by planks near a player set no fire")
    check(level.has_block_tick(fire, fx, -60, fz), "the fire lava set has no tick")
    let lines = reported(mut level)
    if lines.contains("onPlace of") or lines.contains("Fire") {
        panic("the fire lava set reported {lines}")
    }
    println("ok random_ticks_by_class")
}

// Where in the 3 by 3 around `x`, `z` at `y` there's fire, if anywhere.
fn fire_by(f: Facts, level: Level, x: i32, y: i32, z: i32) -> (i32, i32)? {
    let fire = f.block(named(f, "fire"))
    for dx in -1..2 {
        for dz in -1..2 {
            if f.block(level.spawn_state(x + dx, y, z + dz)) == fire {
                return some((x + dx, z + dz))
            }
        }
    }
    return none
}

// Fire (D339), placed as a player would light it, each on the grass but where it says: on what
// won't burn with nothing by it to burn, fire older than 3 goes at its tick, 30 to 39 on, and
// younger fire stays; fire by planks burns them in time; fire on netherrack, which burns forever
// in the Overworld, stays at 15; fire at the bottom of an empty frame of obsidian lights a portal
// where fire lights portals, and stays fire elsewhere; away from every player its tick comes again
// and does nothing. And where it rains, `isRainingAt`: on the grass in plains while it's raining,
// not under stone, not while it isn't, not in a biome with no precipitation and not where it's
// cold enough to snow; and fire's tick in the rain reports nothing.
fn fire_burns() {
    let f = facts()
    var level = flat_level(f)
    let quiet = UPDATE_KNOWN_SHAPE | UPDATE_SKIP_ON_PLACE
    let fire = named(f, "fire")
    var players = List<(f64, f64, f64)>()
    players.push((0.5, -60.0, 0.5))
    level.place = TickPlace { players: players.copy(), infiniburn: String("minecraft:infiniburn_overworld"), portals: true }
    check(level.set_block(2, -60, 2, aged(f, fire, 4), UPDATE_ALL) and level.set_block(4, -60, 2, fire, UPDATE_ALL), "the fires on grass weren't set")
    check(level.has_block_tick(f.block(fire), 2, -60, 2), "the fire set has no tick")
    let planks = named(f, "oak_planks")
    check(level.set_block(8, -60, 2, planks, quiet) and level.set_block(7, -60, 2, fire, UPDATE_ALL), "the fire by planks wasn't set")
    check(level.set_block(12, -61, 2, named(f, "netherrack"), quiet) and level.set_block(12, -60, 2, aged(f, fire, 15), UPDATE_ALL), "the fire on netherrack wasn't set")
    run(mut level, 40)
    check(level.spawn_state(2, -60, 2) == AIR_STATE, "fire at 4 with nothing to burn stayed")
    check(f.block(level.spawn_state(4, -60, 2)) == f.block(fire), "young fire with nothing to burn went")
    run(mut level, 3000)
    check(level.spawn_state(8, -60, 2) != planks, "the planks by fire didn't burn")
    check(level.spawn_state(12, -60, 2) == aged(f, fire, 15), "the fire on netherrack went")
    let obsidian = named(f, "obsidian")
    for (x0, lights) in [(16, true), (22, false)] {
        for x in x0..x0 + 2 {
            check(level.set_block(x, -61, 2, obsidian, quiet) and level.set_block(x, -57, 2, obsidian, quiet), "the frame's bottom and top weren't set")
        }
        for y in -60..-57 {
            check(level.set_block(x0 - 1, y, 2, obsidian, quiet) and level.set_block(x0 + 2, y, 2, obsidian, quiet), "the frame's sides weren't set")
        }
        level.place.portals = lights
        check(level.set_block(x0, -60, 2, fire, UPDATE_ALL), "the fire in the frame wasn't set")
        let portal = with(f, "nether_portal", "axis", "x")
        for x in x0..x0 + 2 {
            for y in -60..-57 {
                let lit = level.spawn_state(x, y, 2) == portal
                if lit != lights {
                    panic("the frame at {x0} lit {lit} at {x}, {y}")
                }
            }
        }
        if not lights {
            check(level.spawn_state(x0, -60, 2) == fire, "the fire in a frame where fire lights no portal went")
        }
    }
    level.place = TickPlace {}
    check(level.set_block(2, -60, 8, aged(f, fire, 4), UPDATE_ALL), "the fire away from players wasn't set")
    run(mut level, 40)
    check(level.spawn_state(2, -60, 8) == aged(f, fire, 4) and level.has_block_tick(f.block(fire), 2, -60, 8), "the fire away from every player changed or has no tick")
    check(not reported(mut level).contains("Rain"), "fire with no rain reported rain")
    level.climate = some(Shared(Temperatures.of([0.8f32], [false], [true])))
    level.place = TickPlace { players: players.copy(), raining: true }
    check(level.set_block(8, -59, 8, named(f, "stone"), quiet), "the stone over the grass wasn't set")
    check(rains(level, 4, -60, 8), "it isn't raining on the grass in plains")
    check(not rains(level, 8, -60, 8), "it's raining under stone")
    check(level.set_block(4, -60, 8, fire, UPDATE_ALL), "the fire in the rain wasn't set")
    run(mut level, 40)
    level.place = TickPlace { players: players.copy() }
    check(not rains(level, 4, -60, 8), "it's raining while it isn't")
    level.place = TickPlace { players: players, raining: true }
    level.climate = some(Shared(Temperatures.of([0.8f32], [false], [false])))
    check(not rains(level, 4, -60, 8), "it's raining in a biome with no precipitation")
    level.climate = some(Shared(Temperatures.of([-0.5f32], [false], [true])))
    check(not rains(level, 4, -60, 8), "it's raining where it's cold enough to snow")
    let lines = reported(mut level)
    if lines.contains("onPlace of") or lines.contains("tick of") or lines.contains("TNT") or lines.contains("Rain") {
        panic("fire reported {lines}")
    }
    println("ok fire_burns")
}

// Precipitation (D340), each column's as `tickPrecipitation` brings it, in plains made cold
// enough to snow: water at the top with land beside it freezes, raining or not, and water with
// water on all four sides doesn't; while it rains, snow's laid on the grass, which goes snowy, a
// layer more each time to the game rule's 3 and no more, and none where the rule's 0 or while it
// isn't raining; an empty cauldron fills with powder snow and a level more each time it comes up
// to full, and one of water gets no more. Made warm, it rains: an empty cauldron fills with water,
// to full; and none of it reports anything left out but the cauldrons' points of interest.
fn precipitation() {
    let f = facts()
    var level = flat_level(f)
    let p = match Precipitation.new(f) {
        ok(made) => made,
        err(e) => panic("the precipitation: {e}"),
    }
    let quiet = UPDATE_KNOWN_SHAPE | UPDATE_SKIP_ON_PLACE
    level.climate = some(Shared(Temperatures.of([-0.5f32], [false], [true])))
    level.place = TickPlace {}
    check(level.set_block(2, -61, 2, f.ids.water_state, quiet), "the water wasn't set")
    for x in 6..9 {
        for z in 6..9 {
            check(level.set_block(x, -61, z, f.ids.water_state, quiet), "the pool wasn't set")
        }
    }
    level.precipitate(p, 2, 2)
    level.precipitate(p, 7, 7)
    check(level.spawn_state(2, -61, 2) == f.default_state(f.ids.ice), "the water by land didn't freeze")
    check(level.spawn_state(7, -61, 7) == f.ids.water_state, "the water with water all round froze")
    level.precipitate(p, 4, 2)
    check(level.spawn_state(4, -60, 2) == AIR_STATE, "snow was laid while it isn't raining")
    level.place = TickPlace { raining: true, max_snow: 0 }
    level.precipitate(p, 4, 2)
    check(level.spawn_state(4, -60, 2) == AIR_STATE, "snow was laid where the game rule's 0")
    level.place = TickPlace { raining: true, max_snow: 3 }
    let snow = f.default_state(f.ids.snow)
    for layers in 1..5 {
        level.precipitate(p, 4, 2)
        let want = if layers > 3 { 3 } else { layers }
        if level.spawn_state(4, -60, 2) != aged_by(f, snow, "layers", want) {
            panic("the snow isn't {want} layers after {layers} times")
        }
    }
    check(level.spawn_state(4, -61, 2) == with(f, "grass_block", "snowy", "true"), "the grass under the snow isn't snowy")
    let cauldron = named(f, "cauldron")
    let water_cauldron = named(f, "water_cauldron")
    check(level.set_block(12, -60, 12, cauldron, quiet) and level.set_block(14, -60, 12, water_cauldron, quiet), "the cauldrons weren't set")
    for _ in 0..1000 {
        level.precipitate(p, 12, 12)
        level.precipitate(p, 14, 12)
    }
    check(level.spawn_state(12, -60, 12) == aged_by(f, named(f, "powder_snow_cauldron"), "level", 3), "the cauldron in the snow isn't full of powder snow")
    check(level.spawn_state(14, -60, 12) == water_cauldron, "the water cauldron in the snow changed")
    level.climate = some(Shared(Temperatures.of([0.8f32], [false], [true])))
    check(level.set_block(16, -60, 12, cauldron, quiet), "the cauldron in the rain wasn't set")
    for _ in 0..1000 {
        level.precipitate(p, 16, 12)
    }
    check(level.spawn_state(16, -60, 12) == aged_by(f, water_cauldron, "level", 3), "the cauldron in the rain isn't full of water")
    let lines = reported(mut level)
    if lines.contains("recipitation") or lines.contains("onPlace of") or lines.contains("tick of") {
        panic("precipitation reported {lines}")
    }
    println("ok precipitation")
}

// The state `state` with its integer property `prop` at `value`.
fn aged_by(f: Facts, state: u32, prop: str, value: i32) -> u32 {
    return match f.with_int(state, String(prop), value) {
        ok(s) => s,
        err(_) => panic("no {prop} {value}"),
    }
}

// Whether it's raining at the block, as the level says, `isRainingAt`.
fn rains(level: Level, x: i32, y: i32, z: i32) -> bool {
    return match level.raining_at(x, y, z) {
        ok(r) => r,
        err(e) => panic("where it rains threw {e.message}"),
    }
}

// The state named `name` with property `prop` at `value`.
fn with(f: Facts, name: str, prop: str, value: str) -> u32 {
    return match f.with_name(named(f, name), String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("{name} has no {prop} {value}"),
    }
}

// The last classes' `updateShape`, each as post-processing asks it (D332): concrete powder by
// water sets, a note block plays a head's instrument above it or the block's below it, a pitcher
// crop needs farmland, a bubble column with nothing under to hold it ticks to go, and a portal
// stands while its frame does.
fn shapes() {
    let f = facts()
    let e = env(f)
    var level = flat_level(f)
    let quiet = UPDATE_KNOWN_SHAPE | UPDATE_SKIP_ON_PLACE
    let powder = named(f, "white_concrete_powder")
    check(level.set_block(2, -60, 2, powder, quiet) and level.set_block(3, -60, 2, f.ids.water_state, quiet), "the powder by water wasn't set")
    post(e, mut level, 2, -60, 2)
    check(level.spawn_state(2, -60, 2) == named(f, "white_concrete"), "the powder by water didn't set")
    check(level.set_block(2, -60, 6, powder, quiet) and level.set_block(2, -61, 6, f.ids.water_state, quiet), "the powder over water wasn't set")
    post(e, mut level, 2, -60, 6)
    check(level.spawn_state(2, -60, 6) == powder, "the powder over water set")
    check(level.set_block(6, -60, 6, named(f, "note_block"), quiet) and level.set_block(6, -61, 6, named(f, "stone"), quiet), "the note block wasn't set")
    post(e, mut level, 6, -60, 6)
    check(level.spawn_state(6, -60, 6) == with(f, "note_block", "instrument", "basedrum"), "the note block on stone doesn't play the bass drum")
    check(level.set_block(6, -59, 6, named(f, "zombie_head"), quiet), "the head wasn't set")
    post(e, mut level, 6, -60, 6)
    check(level.spawn_state(6, -60, 6) == with(f, "note_block", "instrument", "zombie"), "the note block under a head doesn't play it")
    let crop = named(f, "pitcher_crop")
    check(level.set_block(8, -61, 2, named(f, "farmland"), quiet) and level.set_block(8, -60, 2, crop, quiet) and level.set_block(9, -60, 2, crop, quiet), "the pitcher crops weren't set")
    post(e, mut level, 8, -60, 2)
    post(e, mut level, 9, -60, 2)
    check(level.spawn_state(8, -60, 2) == crop, "the pitcher crop on farmland went")
    check(level.spawn_state(9, -60, 2) == AIR_STATE, "the pitcher crop on grass stayed")
    let column = named(f, "bubble_column")
    check(level.set_block(12, -60, 2, column, quiet), "the bubble column wasn't set")
    post(e, mut level, 12, -60, 2)
    check(level.has_block_tick(f.block(column), 12, -60, 2), "the bubble column over grass has no tick")
    // A frame of obsidian two wide and three high inside, along x, full of portal.
    let obsidian = named(f, "obsidian")
    let portal = named(f, "nether_portal")
    for x in 20..22 {
        check(level.set_block(x, -61, 20, obsidian, quiet) and level.set_block(x, -57, 20, obsidian, quiet), "the frame's bottom and top weren't set")
        for y in -60..-57 {
            check(level.set_block(x, y, 20, portal, quiet), "the portal wasn't set")
        }
    }
    for y in -60..-57 {
        check(level.set_block(19, y, 20, obsidian, quiet) and level.set_block(22, y, 20, obsidian, quiet), "the frame's sides weren't set")
    }
    post(e, mut level, 20, -59, 20)
    check(level.spawn_state(20, -59, 20) == portal, "the portal in its frame went")
    check(level.set_block(19, -59, 20, AIR_STATE, quiet), "the frame wasn't broken")
    post(e, mut level, 20, -59, 20)
    check(level.spawn_state(20, -59, 20) == AIR_STATE, "the portal stayed with its frame broken")
    let lines = reported(mut level)
    if lines.contains("Unimplemented") {
        panic("the shapes reported {lines}")
    }
    println("ok shapes")
}

fn main() {
    spreads()
    finds_hole()
    makes_source()
    lava_makes_stone()
    post_processed()
    shapes()
    block_ticks()
    random_ticks_by_class()
    fire_burns()
    precipitation()
    println("ok")
}
