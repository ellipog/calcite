/// Checks loot tables' codecs (CAL-153): tables, pools, entries and item modifiers each read as
/// vanilla's codec reads them and written back as it writes them, with vanilla's messages for what
/// doesn't read, and the vanilla data's reloadable registries all read together, naming each
/// other's entries, with none left unbound. Run from the repository's root, as it reads the pinned
/// server jar in oracle/jars/.
module test.loot

import json.tree.{parse}
import nbt.tag.{Tag}
import pack.vanilla.{vanilla_jar, vanilla_only}
import registry.codec.{Codecs, RELOADING, Refs}
import registry.load.{load_registries}
import registry.loot_tables.{loot_table, modifier_typed}
import registry.registries.{Registries, builtin_registries}
import rig.nbt.{load_language}
import server.log.{Entry}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// What `text` reads as with the codec `make` makes, in SNBT, or its error, with the references to
// the reloadable registries it made after it.
fn read(text: String, table: bool) -> String {
    var c = Codecs.new()
    c.frozen = true
    c.reloading = [String("minecraft:loot_table"), String("minecraft:predicate"), String("minecraft:item_modifier")]
    let at = if table { loot_table(mut c) } else { modifier_typed(mut c) }
    let json = parse(text) else panic("not JSON: {text}")
    var refs = Refs.new()
    let r = Registries { synced: [], builtin: builtin_registries() }
    var got = c.read(at, json, r, mut refs)
    if let e = got.error.take() {
        return "error: {e}"
    }
    if let t = got.thrown.take() {
        return "thrown: {t}"
    }
    let value = got.value.take() ?? Tag.End
    var out = value.to_snbt()
    for (place, id) in refs.values {
        if place >= RELOADING {
            out.push_str(" {c.reloading[place - RELOADING]}={id.to_string()}")
        }
    }
    return out
}

fn tables() {
    // A block's table as vanilla's data has it: its alternatives, the silk touch predicate named,
    // which goes to be checked once all are read, and the fortune bonus with no parameters.
    check(read("\{\"type\":\"minecraft:block\",\"pools\":[\{\"entries\":[\{\"type\":\"minecraft:alternatives\",\"children\":[\{\"type\":\"minecraft:item\",\"condition\":\"minecraft:tool/can_silk_touch\",\"name\":\"minecraft:diamond_ore\"\},\{\"type\":\"minecraft:item\",\"modifier\":[\{\"type\":\"minecraft:apply_bonus\",\"enchantment\":\"minecraft:fortune\",\"formula\":\"minecraft:ore_drops\"\},\{\"type\":\"minecraft:explosion_decay\"\}],\"name\":\"minecraft:diamond\"\}]\}],\"rolls\":1\}],\"random_sequence\":\"minecraft:blocks/diamond_ore\"\}", true), "\{pools:[\{entries:[\{children:[\{condition:\"minecraft:tool/can_silk_touch\",name:\"minecraft:diamond_ore\",type:\"minecraft:item\"\},\{modifier:[\{enchantment:\"minecraft:fortune\",formula:\"minecraft:ore_drops\",type:\"minecraft:apply_bonus\"\},\{type:\"minecraft:explosion_decay\"\}],name:\"minecraft:diamond\",type:\"minecraft:item\"\}],type:\"minecraft:alternatives\"\}],rolls:1\}],random_sequence:\"minecraft:blocks/diamond_ore\",type:\"minecraft:block\"\} minecraft:predicate=minecraft:tool/can_silk_touch")
    // Left out, the kind is generic and the pools none; a kind that isn't one is generic too, as
    // `lenientOptionalFieldOf` reads it, and isn't written.
    check(read("\{\}", true), "\{\}")
    check(read("\{\"type\":\"minecraft:nope\",\"pools\":[]\}", true), "\{\}")
    // A pool must say how many times it rolls.
    check(read("\{\"pools\":[\{\"entries\":[]\}]\}", true), "error: No key rolls in MapLike[\{\"entries\":[]\}]")
    check(read("\{\"pools\":[\{\"entries\":[\{\"type\":\"minecraft:item\",\"name\":\"minecraft:air\"\}],\"rolls\":1\}]\}", true), "error: Item must not be minecraft:air")
    check(read("\{\"pools\":[\{\"entries\":[\{\"type\":\"minecraft:nope\"\}],\"rolls\":1\}]\}", true), "error: Unknown registry key in ResourceKey[minecraft:root / minecraft:loot_pool_entry_type]: minecraft:nope")
    // An entry's weight and quality, and a nested table by its ID.
    check(read("\{\"pools\":[\{\"entries\":[\{\"type\":\"minecraft:loot_table\",\"value\":\"minecraft:chests/simple_dungeon\",\"weight\":3\},\{\"type\":\"minecraft:empty\",\"quality\":2\}],\"rolls\":\{\"type\":\"minecraft:uniform\",\"min\":1,\"max\":3\},\"bonus_rolls\":0.5\}]\}", true), "\{pools:[\{bonus_rolls:0.5f,entries:[\{type:\"minecraft:loot_table\",value:\"minecraft:chests/simple_dungeon\",weight:3\},\{quality:2,type:\"minecraft:empty\"\}],rolls:\{max:3,min:1,type:\"minecraft:uniform\"\}\}]\} minecraft:loot_table=minecraft:chests/simple_dungeon")
}

fn modifiers() {
    check(read("\{\"type\":\"minecraft:set_count\",\"count\":\{\"type\":\"minecraft:uniform\",\"min\":1,\"max\":2\}\}", false), "\{count:\{max:2,min:1,type:\"minecraft:uniform\"\},type:\"minecraft:set_count\"\}")
    check(read("\{\"type\":\"minecraft:set_count\",\"count\":2,\"add\":true,\"condition\":\{\"type\":\"minecraft:survives_explosion\"\}\}", false), "\{add:1b,condition:\{type:\"minecraft:survives_explosion\"\},count:2,type:\"minecraft:set_count\"\}")
    check(read("\{\"type\":\"minecraft:apply_bonus\",\"enchantment\":\"minecraft:fortune\",\"formula\":\"minecraft:binomial_with_bonus_count\",\"parameters\":\{\"extra\":3,\"probability\":0.5714286\}\}", false), "\{enchantment:\"minecraft:fortune\",formula:\"minecraft:binomial_with_bonus_count\",parameters:\{extra:3,probability:0.5714286f\},type:\"minecraft:apply_bonus\"\}")
    check(read("\{\"type\":\"minecraft:apply_bonus\",\"enchantment\":\"minecraft:fortune\"\}", false), "error: Missing \"formula\" in: MapLike[\{\"type\":\"minecraft:apply_bonus\",\"enchantment\":\"minecraft:fortune\"\}]")
    check(read("\{\"type\":\"minecraft:apply_bonus\",\"enchantment\":\"minecraft:fortune\",\"formula\":\"minecraft:nope\"\}", false), "error: No formula type with id: 'minecraft:nope'")
    check(read("\{\"type\":\"minecraft:copy_components\",\"source\":\"block_entity\",\"include\":[\"minecraft:pot_decorations\"]\}", false), "\{include:[\"minecraft:pot_decorations\"],source:\"block_entity\",type:\"minecraft:copy_components\"\}")
    check(read("\{\"type\":\"minecraft:copy_components\",\"source\":\"nowhere\"\}", false), "error: Unknown element id: nowhere")
    check(read("\{\"type\":\"minecraft:copy_state\",\"block\":\"minecraft:candle\",\"properties\":[\"candles\"]\}", false), "\{block:\"minecraft:candle\",properties:[\"candles\"],type:\"minecraft:copy_state\"\}")
    check(read("\{\"type\":\"minecraft:limit_count\",\"limit\":\{\"max\":64\}\}", false), "\{limit:\{max:64\},type:\"minecraft:limit_count\"\}")
    check(read("\{\"type\":\"minecraft:set_contents\",\"component\":\"minecraft:damage\",\"entries\":[]\}", false), "error: No items in component")
    check(read("\{\"type\":\"minecraft:set_lore\",\"lore\":[],\"mode\":\"replace_section\",\"size\":300\}", false), "error: Size value too large: 300, max size is 256")
    check(read("\{\"type\":\"minecraft:set_lore\",\"lore\":[]\}", false), "error: No key mode in MapLike[\{\"type\":\"minecraft:set_lore\",\"lore\":[]\}]")
    check(read("\{\"type\":\"minecraft:sequence\",\"functions\":[\"minecraft:a\",\{\"type\":\"minecraft:explosion_decay\"\}]\}", false), "\{functions:[\"minecraft:a\",\{type:\"minecraft:explosion_decay\"\}],type:\"minecraft:sequence\"\} minecraft:item_modifier=minecraft:a")
    check(read("\{\"type\":\"minecraft:nope\"\}", false), "error: Unknown registry key in ResourceKey[minecraft:root / minecraft:loot_function_type]: minecraft:nope")
}

// The vanilla data's reloadable registries, all read with no problems, by how many entries each
// has.
fn vanilla() {
    var logs = List<Entry>()
    let resources = vanilla_only(vanilla_jar(String("oracle/jars/server-26.3.jar"))!)
    let lang = load_language()!
    let r = load_registries(resources, some(lang), mut logs) else panic("the registries didn't load: {logs.len()} lines")
    var counts = String()
    for reg in r.reloadable {
        counts.push_str(" {reg.name.path}={reg.entries.len()}")
    }
    check(counts, " loot_table=1447 predicate=3 context_float_provider=4 context_int_provider=26 item_modifier=0 slot_source=0 recipe=2042")
}

fn main() {
    tables()
    modifiers()
    vanilla()
    print("ok")
}
