/// Tests of `world.environment`, a level's environment attributes (D313), against what vanilla's
/// `EnvironmentAttributeSystem` gave the rig for the same data (`cases/environment`), and of the
/// level's sky as `updateSkyBrightness` and `isBrightOutside` see it.
module test.environment

import chat.component.{Component}
import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.play.{World}
import world.beds.{BedRule}
import world.clocks.{Clocks}
import world.environment.{Environment, bed_rule, find, sky_light_level, straw_bed_rule}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn compound(pairs: own List<(String, Tag)>) -> Tag {
    var m = JavaHashMap<String, Tag>()
    for (k, v) in pairs {
        m.insert(k.copy(), v.copy())
    }
    return Tag.Compound(m)
}

fn frame(ticks: i32, value: own Tag) -> Tag {
    return compound([(String("ticks"), Tag.Int(ticks)), (String("value"), value)])
}

// Vanilla's `minecraft:day` timeline, with only its sky light and bees tracks, and its
// `minecraft:early_game`, as the registries read them.
fn day() -> Tag {
    let light = compound([
        (String("modifier"), Tag.Str(String("multiply"))),
        (String("ease"), Tag.Str(String("linear"))),
        (String("keyframes"), Tag.List([frame(133, Tag.Float(1.0f32)), frame(11867, Tag.Float(1.0f32)), frame(13670, Tag.Float(0.26666668f32)), frame(22330, Tag.Float(0.26666668f32))])),
    ])
    let bees = compound([
        (String("modifier"), Tag.Str(String("or"))),
        (String("ease"), Tag.Str(String("linear"))),
        (String("keyframes"), Tag.List([frame(12542, Tag.Byte(1i8)), frame(23460, Tag.Byte(0i8))])),
    ])
    let tracks = compound([(String("minecraft:gameplay/sky_light_level"), light), (String("minecraft:gameplay/bees_stay_in_hive"), bees)])
    return compound([(String("clock"), Tag.Str(String("minecraft:overworld"))), (String("period_ticks"), Tag.Int(24000)), (String("tracks"), tracks)])
}

fn early_game() -> Tag {
    let patrols = compound([
        (String("modifier"), Tag.Str(String("and"))),
        (String("ease"), Tag.Str(String("linear"))),
        (String("keyframes"), Tag.List([frame(0, Tag.Byte(0i8)), frame(120000, Tag.Byte(1i8))])),
    ])
    return compound([(String("clock"), Tag.Str(String("minecraft:overworld"))), (String("tracks"), compound([(String("minecraft:gameplay/can_pillager_patrol_spawn"), patrols)]))])
}

fn clock_names() -> List<Identifier> {
    return [Identifier { namespace: "minecraft", path: "overworld" }, Identifier { namespace: "minecraft", path: "the_end" }]
}

fn at(ticks: i64) -> Clocks {
    var clocks = Clocks.new(clock_names())
    clocks.clocks[0].total_ticks = ticks
    return clocks
}

fn bits(v: f32) -> String {
    return "{v.to_bits()}"
}

// The Overworld's sky light, as vanilla gave it for these clocks and weathers.
fn overworld_sky() {
    var env = Environment.build(Tag.End, [day(), early_game()], clock_names(), true)
    let sky = sky_light_level()
    let cases: List<(i64, f32, f32, u32)> = [
        (0, 0.0f32, 0.0f32, 0x41630467u32),
        (133, 0.0f32, 0.0f32, 0x41700000u32),
        (23999, 0.0f32, 0.0f32, 0x4162eb6bu32),
        (-1, 0.0f32, 0.0f32, 0x4162eb6bu32),
        (18000, 0.0f32, 0.0f32, 0x40800000u32),
        (18000, 1.0f32, 0.0f32, 0x40800000u32),
        (6000, 1.0f32, 0.0f32, 0x41390000u32),
        (6000, 1.0f32, 0.009999999776482582f32, 0x4138e8b5u32),
        (13000, 1.0f32, 0.019999999552965164f32, 0x40d9c9d2u32),
        (13000, 0.4199998676776886f32, 0.0f32, 0x40f1a2ddu32),
        (12000, 0.5499997735023499f32, 0.0f32, 0x4146ffa6u32),
        (6000, 1.0f32, 1.0f32, 0x41133000u32),
    ]
    for (ticks, rain, thunder, want) in cases {
        env.invalidate()
        let got = env.number(sky, at(ticks), rain, thunder)
        if got.to_bits() != want {
            panic("sky light at {ticks} with rain {rain} and thunder {thunder}: got {got} ({bits(got)}), want {want}")
        }
    }
    // Bees stay in at night and in rain, and patrols only once the early game's over.
    let bees = find(String("minecraft:gameplay/bees_stay_in_hive"))!
    let patrols = find(String("minecraft:gameplay/can_pillager_patrol_spawn"))!
    var seen = List<String>()
    let checks: List<(i64, f32)> = [(6000, 0.0f32), (18000, 0.0f32), (6000, 0.5f32), (119999, 0.0f32), (120000, 0.0f32), (200000, 0.0f32)]
    for (ticks, rain) in checks {
        env.invalidate()
        seen.push("{env.flag(bees, at(ticks), rain, 0.0f32)}/{env.flag(patrols, at(ticks), rain, 0.0f32)}")
    }
    check("{seen}", "[false/false, true/false, true/false, false/false, false/true, false/true]")
}

// What an attribute was this tick stays until the next, as `ValueSampler` keeps it.
fn kept_for_the_tick() {
    var env = Environment.build(Tag.End, [day()], clock_names(), true)
    let sky = sky_light_level()
    let noon = env.number(sky, at(6000), 0.0f32, 0.0f32)
    let still = env.number(sky, at(18000), 0.0f32, 0.0f32)
    env.invalidate()
    let night = env.number(sky, at(18000), 0.0f32, 0.0f32)
    check("{noon} {still} {night}", "15.0 15.0 4.0")
}

// The Nether's type sets its sky light to 4, and nothing changes it; an attribute nothing sets
// is its default.
fn constant_layer() {
    let attributes = compound([(String("minecraft:gameplay/sky_light_level"), Tag.Float(4.0f32)), (String("minecraft:gameplay/fast_lava"), Tag.Byte(1i8))])
    var env = Environment.build(attributes, [], clock_names(), false)
    let lava = find(String("minecraft:gameplay/fast_lava"))!
    let raid = find(String("minecraft:gameplay/can_start_raid"))!
    let egg = find(String("minecraft:gameplay/turtle_egg_hatch_chance"))!
    check("{env.number(sky_light_level(), at(6000), 1.0f32, 1.0f32)} {env.flag(lava, at(0), 0.0f32, 0.0f32)} {env.flag(raid, at(0), 0.0f32, 0.0f32)} {env.number(egg, at(0), 0.0f32, 0.0f32)}", "4.0 true true 0.002")
    // A modifier's value is clamped to the attribute's range: 4 + 20 is 15.
    let raised = compound([(String("minecraft:gameplay/sky_light_level"), compound([(String("modifier"), Tag.Str(String("add"))), (String("argument"), Tag.Float(20.0f32))]))])
    var high = Environment.build(raised, [], clock_names(), false)
    check("{high.number(sky_light_level(), at(0), 0.0f32, 0.0f32)}", "15.0")
}

// A level's sky as its tick sees it: dark from 4 under 15, and never bright or dark with fixed
// time, as the End has it.
fn level_sky() {
    var world = World.defaults()
    world.dims[0].environment = Environment.build(Tag.End, [day()], clock_names(), true)
    world.dims[0].fixed_time = false
    var seen = List<String>()
    let checks: List<(i64, f32, f32)> = [(6000, 0.0f32, 0.0f32), (6000, 1.0f32, 0.0f32), (6000, 1.0f32, 1.0f32), (18000, 0.0f32, 0.0f32)]
    for (ticks, rain, thunder) in checks {
        world.dims[0].environment.invalidate()
        world.dims[0].weather.rain = rain
        world.dims[0].weather.o_rain = rain
        world.dims[0].weather.thunder = thunder
        world.dims[0].weather.o_thunder = thunder
        world.dims[0].update_sky_brightness(at(ticks))
        seen.push("{world.dims[0].sky_darken} {world.dims[0].bright_outside()} {world.dims[0].dark_outside()}")
    }
    check("{seen}", "[0 true false, 3 true false, 5 false true, 11 false true]")
    let end = world.dims.len() - 1
    world.dims[end].update_sky_brightness(at(18000))
    check("{world.dims[end].sky_darken} {world.dims[end].bright_outside()} {world.dims[end].dark_outside()}", "0 false false")
}

// The bed rules (D574): the Nether's, as its type sets them, a bed that explodes as it's used and
// can't be slept in or set the spawn; the Overworld's defaults, a bed that sets the spawn and is
// slept in when it's dark, a straw bed that's slept in when it's dark, never sets it, and goes as
// it's left; and a biome's rule, which goes after its type's.
fn bed_rules() {
    let nether_rule = compound([(String("can_sleep"), Tag.Str(String("never"))), (String("can_set_spawn"), Tag.Str(String("never"))), (String("destroy_on_use"), Tag.Byte(1i8))])
    let attributes = compound([(String("minecraft:gameplay/bed_rule"), nether_rule.copy())])
    var env = Environment.build(attributes, [], clock_names(), false)
    let nether = BedRule.of(env.rule_of(env.value(bed_rule(), at(0), 0.0f32, 0.0f32)), false)
    check("{nether.may_sleep(true)} {nether.may_set_spawn(true)} {nether.destroy_on_use} {nether.destroy_on_leave} {nether.error_message == none}", "false false true false true")
    var plain = Environment.build(Tag.End, [], clock_names(), false)
    let bed = BedRule.of(plain.rule_of(plain.value(bed_rule(), at(0), 0.0f32, 0.0f32)), false)
    let straw = BedRule.of(plain.rule_of(plain.value(straw_bed_rule(), at(0), 0.0f32, 0.0f32)), true)
    check("{bed.may_sleep(true)} {bed.may_sleep(false)} {bed.may_set_spawn(false)} {bed.destroy_on_leave}", "true false true false")
    check("{straw.may_sleep(true)} {straw.may_set_spawn(true)} {straw.destroy_on_leave}", "true false true")
    let message = bed.error_message ?? Component.literal(String())
    check(message.to_json(), "\{\"translate\":\"block.minecraft.bed.no_sleep\"\}")
    // A biome that lets the bed set the spawn always and be slept in always, again and again, one
    // rule kept of it.
    let always = compound([(String("can_sleep"), Tag.Str(String("always"))), (String("can_set_spawn"), Tag.Str(String("always")))])
    let biome = compound([(String("minecraft:gameplay/bed_rule"), always)])
    let first = BedRule.of(env.rule_of(env.value_at(bed_rule(), biome.copy(), at(0), 0.0f32, 0.0f32)), false)
    let again = env.value_at(bed_rule(), biome.copy(), at(0), 0.0f32, 0.0f32)
    let kept = env.value_at(bed_rule(), biome, at(0), 0.0f32, 0.0f32)
    check("{first.may_sleep(false)} {first.may_set_spawn(false)} {first.destroy_on_use} {again.number == kept.number}", "true true false true")
}

fn main() {
    overworld_sky()
    kept_for_the_tick()
    constant_layer()
    level_sky()
    bed_rules()
    println("ok")
}
