/// Checks `server.chunks`: that a view's columns hold what `in_view` does, and that the chunk
/// sender sends what one that sorts every chunk waiting each batch would, in its order, and
/// says the same of which chunks the client has, while a player walks, jumps far and changes
/// their view; and that chunks that aren't ready wait, in their place, until they are.
module test.chunks

import server.chunks.{ChunkSender, Chunks, NEAR, Next, Spiral, chunks_held, column, in_view, in_view_all, in_view_count}
import world.pos.{ChunkPos}

// Every chunk is ready.
struct Ready {
    _unused: bool = false
}

impl Chunks for Ready {
    fn next(mut self, pos: ChunkPos, near: bool) -> Next {
        return Next.Send
    }
}

// Chunks that aren't ready yet, and the chunk at which the sender's to stop, if any, with how
// many near chunks and far ones it was asked of.
struct Gate {
    closed: Set<i64> = Set<i64>()
    stop: i64? = none
    near: i32 = 0
    far: i32 = 0
}

impl Chunks for Gate {
    fn next(mut self, pos: ChunkPos, near: bool) -> Next {
        if near {
            self.near += 1
        } else {
            self.far += 1
        }
        if self.stop == some(pos.pack()) {
            return Next.Stop
        }
        if self.closed.contains(pos.pack()) {
            return Next.Skip
        }
        return Next.Send
    }
}

fn check_int(got: i64, want: i64) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn columns() {
    let center = ChunkPos { x: 3, z: -7 }
    for view in 0..41 {
        for x in center.x - view - 4..center.x + view + 5 {
            let (lo, hi) = column(center, view, x)
            for z in center.z - view - 4..center.z + view + 5 {
                let inside = z >= lo and z <= hi
                if inside != in_view(center, view, x, z) {
                    panic("view {view}: {x}, {z} is {inside} by its column")
                }
            }
        }
        check_int(i64.wrap(in_view_all(center, view).len()), i64.wrap(in_view_count(view)))
    }
    // 127 is the most a client can ask for, as it asks in a byte.
    check_int(i64.wrap(in_view_count(10)), 473)
    check_int(i64.wrap(in_view_count(32)), 3725)
    check_int(i64.wrap(in_view_count(127)), 52653)
    check_int(i64.wrap(in_view_count(1024)), 3310485)
    println("ok columns")
}

// The chunks views hold between them, as a set of every one counts them.
fn held() {
    var seed: u64 = 11
    for round in 0..40 {
        var views = List<(ChunkPos, i32)>()
        var every = Set<i64>()
        for _ in 0..1 + roll(mut seed, 6) {
            let center = ChunkPos { x: roll(mut seed, 61) - 30 + round * 1000, z: roll(mut seed, 61) - 30 - round * 999 }
            let view = roll(mut seed, 25)
            views.push((center, view))
            for c in in_view_all(center, view) {
                every.insert(c.pack())
            }
        }
        check_int(i64.wrap(chunks_held(views)), i64.wrap(every.len()))
    }
    // The edge of the world, and the widest forced view.
    let far: List<(ChunkPos, i32)> = [(ChunkPos { x: -1875000, z: 1875000 }, 1024), (ChunkPos { x: -1874990, z: 1874000 }, 1024)]
    var both = Set<i64>()
    for (center, view) in far {
        for c in in_view_all(center, view) {
            both.insert(c.pack())
        }
    }
    check_int(i64.wrap(chunks_held(far)), i64.wrap(both.len()))
    println("ok held")
}

// The sender as it was: every chunk waiting in a list, all of them sorted each batch, by their
// distance squared, then `x`, then `z`.
struct Reference {
    pending: List<ChunkPos> = []
}

impl Reference {
    fn unmark(mut self, pos: ChunkPos) -> bool {
        for i in 0..self.pending.len() {
            if self.pending[i] == pos {
                _ = self.pending.swap_remove(i)
                return false
            }
        }
        return true
    }

    fn take(mut self, center: ChunkPos, n: usize) -> List<ChunkPos> {
        var near = List<(i32, i32, i32)>()
        for p in self.pending {
            near.push((p.distance_squared(center), p.x, p.z))
        }
        near.sort()
        var out = List<ChunkPos>()
        for (_, x, z) in near {
            if out.len() == n {
                break
            }
            out.push(ChunkPos { x: x, z: z })
        }
        for p in out {
            _ = self.unmark(p)
        }
        return out
    }
}

// A random number from 0 to `n` - 1, from a linear congruential generator.
fn roll(seed: mut u64, n: i32) -> i32 {
    seed = seed * 6364136223846793005 + 1442695040888963407
    return i32.wrap((seed >> 33) % u64.wrap(n))
}

// Moves both senders' view from `old` to `center`, as the network does: those that left are
// dropped, then the view moves, then those that came are queued, all at once if the views
// don't meet.
fn step(sender: mut ChunkSender, reference: mut Reference, spiral: mut Spiral, old: ChunkPos, old_view: i32, center: ChunkPos, view: i32) {
    spiral.fit(view)
    for c in in_view_all(old, old_view) {
        if not in_view(center, view, c.x, c.z) {
            let has = sender.drop_chunk(c)
            if has != reference.unmark(c) {
                panic("the sender says the client has {c.x}, {c.z}: {has}")
            }
        }
    }
    sender.move_to(center, view)
    let apart = old_view == 0 or old.x - old_view - 1 > center.x + view + 1 or old.x + old_view + 1 < center.x - view - 1 or old.z - old_view - 1 > center.z + view + 1 or old.z + old_view + 1 < center.z - view - 1
    if apart {
        sender.mark_all()
    }
    for c in in_view_all(center, view) {
        if apart or not in_view(old, old_view, c.x, c.z) {
            if not apart {
                sender.mark_pending(c)
            }
            reference.pending.push(c)
        }
    }
}

// Takes a batch from each, which must be the same, and acknowledges it, asking for `desired`.
fn batch(sender: mut ChunkSender, reference: mut Reference, spiral: mut Spiral, center: ChunkPos, desired: f32) -> usize {
    var ready = Ready()
    let got = sender.next_batch(mut spiral, mut ready)
    let want = reference.take(center, got.len())
    check_int(i64.wrap(got.len()), i64.wrap(want.len()))
    for i in 0..got.len() {
        if got[i] != want[i] {
            panic("chunk {i} of the batch is {got[i].x}, {got[i].z}, where {want[i].x}, {want[i].z} is next")
        }
    }
    if not got.is_empty() {
        sender.batch_received(desired)
    }
    return got.len()
}

fn sending() {
    var seed: u64 = 7
    var sender = ChunkSender()
    var reference = Reference()
    var spiral = Spiral()
    var center = ChunkPos { x: 0, z: 0 }
    var view = 3
    step(mut sender, mut reference, mut spiral, center, 0, center, view)
    for turn in 0..600 {
        let old = center
        let old_view = view
        let what = roll(mut seed, 40)
        if what == 0 {
            center = ChunkPos { x: center.x + roll(mut seed, 10001) - 5000, z: center.z + roll(mut seed, 10001) - 5000 }
        } else if what < 4 {
            view = 2 + roll(mut seed, 23)
        } else if turn == 300 {
            view = 60
        } else {
            center = ChunkPos { x: center.x + roll(mut seed, 5) - 2, z: center.z + roll(mut seed, 5) - 2 }
        }
        step(mut sender, mut reference, mut spiral, old, old_view, center, view)
        for _ in 0..roll(mut seed, 4) {
            _ = batch(mut sender, mut reference, mut spiral, center, f32.nearest(f64(1 + roll(mut seed, 64))))
        }
    }
    // What's left goes in the same order, and then nothing's left of either.
    while batch(mut sender, mut reference, mut spiral, center, 64.0) > 0 {
    }
    check_int(i64.wrap(reference.pending.len()), 0)
    println("ok sending")
}

// The order chunks go in from `center`: by distance squared, then `x`, then `z`.
fn ordered(center: ChunkPos, chunks: List<ChunkPos>) -> List<ChunkPos> {
    var near = List<(i32, i32, i32)>()
    for p in chunks {
        near.push((p.distance_squared(center), p.x, p.z))
    }
    near.sort()
    var out = List<ChunkPos>()
    for (_, x, z) in near {
        out.push(ChunkPos { x: x, z: z })
    }
    return out
}

// Takes batches until `stop` chunks of `order` are sent, or all of them, checking each is the
// next, and gives how far it got.
fn send_to(sender: mut ChunkSender, spiral: mut Spiral, order: List<ChunkPos>, from: usize, stop: usize, sent: mut Set<i64>) -> usize {
    var next = from
    var ready = Ready()
    while next < stop {
        let got = sender.next_batch(mut spiral, mut ready)
        if got.is_empty() {
            return next
        }
        for c in got {
            if next >= order.len() or c != order[next] {
                panic("chunk {next} sent is {c.x}, {c.z}")
            }
            sent.insert(c.pack())
            next += 1
        }
        sender.batch_received(64.0)
    }
    return next
}

// A view wide enough that the spiral is made in several rings, which the player moves in,
// widens and narrows while it's sent: it goes on in the order a whole sort gives.
fn wide() {
    var sender = ChunkSender()
    var spiral = Spiral()
    var center = ChunkPos { x: 5, z: -3 }
    var view = 300
    spiral.fit(view)
    sender.move_to(center, view)
    sender.mark_all()
    var order = ordered(center, in_view_all(center, view))
    var next: usize = 0
    var sent = Set<i64>()
    for turn in 0..3 {
        next = send_to(mut sender, mut spiral, order, next, next + (order.len() - next) / 3, mut sent)
        let old = center
        let old_view = view
        if turn == 0 {
            center = ChunkPos { x: 6, z: -1 }
        } else if turn == 1 {
            view = 340
        } else {
            center = ChunkPos { x: 3, z: -4 }
            view = 290
        }
        spiral.fit(view)
        var waiting = List<ChunkPos>()
        for i in next..order.len() {
            if in_view(center, view, order[i].x, order[i].z) {
                waiting.push(order[i])
            }
        }
        for c in in_view_all(old, old_view) {
            if not in_view(center, view, c.x, c.z) {
                let has = sender.drop_chunk(c)
                if has != sent.contains(c.pack()) {
                    panic("the sender says the client has {c.x}, {c.z}: {has}")
                }
                sent.remove(c.pack())
            }
        }
        sender.move_to(center, view)
        for c in in_view_all(center, view) {
            if not in_view(old, old_view, c.x, c.z) {
                sender.mark_pending(c)
                waiting.push(c)
            }
        }
        order = ordered(center, waiting)
        next = 0
    }
    next = send_to(mut sender, mut spiral, order, next, order.len() + 1, mut sent)
    check_int(i64.wrap(next), i64.wrap(order.len()))
    check_int(i64.wrap(sent.len()), i64.wrap(in_view_count(290)))
    println("ok wide")
}

// Chunks that aren't ready are passed over and wait in their place: once they're ready, they go
// first, nearest first. One the sender's told to stop at waits with all after it.
fn not_ready() {
    var sender = ChunkSender()
    var spiral = Spiral()
    let center = ChunkPos { x: 2, z: 1 }
    let view = 40
    spiral.fit(view)
    sender.move_to(center, view)
    sender.mark_all()
    let order = ordered(center, in_view_all(center, view))
    var gate = Gate()
    for c in order {
        if c.x == center.x + 1 {
            gate.closed.insert(c.pack())
        }
    }
    gate.stop = some(ChunkPos { x: center.x, z: center.z + 30 }.pack())
    // Up to the stop, all but the closed go, in order.
    var want = List<ChunkPos>()
    for c in order {
        if c.pack() == gate.stop! {
            break
        }
        if not gate.closed.contains(c.pack()) {
            want.push(c)
        }
    }
    var got = List<ChunkPos>()
    loop {
        let took = sender.next_batch(mut spiral, mut gate)
        if took.is_empty() {
            break
        }
        for c in took {
            got.push(c)
        }
        sender.batch_received(64.0)
    }
    check_int(i64.wrap(got.len()), i64.wrap(want.len()))
    for i in 0..got.len() {
        if got[i] != want[i] {
            panic("chunk {i} sent is {got[i].x}, {got[i].z}, where {want[i].x}, {want[i].z} is next")
        }
    }
    // Nothing past the stop was asked of, so none of the far chunks.
    check_int(i64(gate.far), 0)
    // Once all are ready, the rest go in order.
    gate.closed.clear()
    gate.stop = none
    var rest = List<ChunkPos>()
    for c in order {
        if not contains(got, c) {
            rest.push(c)
        }
    }
    var next: usize = 0
    var sent = Set<i64>()
    next = send_to(mut sender, mut spiral, rest, 0, rest.len() + 1, mut sent)
    check_int(i64.wrap(next), i64.wrap(rest.len()))
    // A chunk 34 out on an axis is far, one 33 out near.
    check_int(if sender.near(ChunkPos { x: center.x + NEAR, z: center.z - NEAR }) { 1 } else { 0 }, 1)
    check_int(if sender.near(ChunkPos { x: center.x + NEAR + 1, z: center.z }) { 1 } else { 0 }, 0)
    println("ok not ready")
}

fn contains(chunks: List<ChunkPos>, c: ChunkPos) -> bool {
    for d in chunks {
        if d == c {
            return true
        }
    }
    return false
}

fn main() {
    columns()
    held()
    sending()
    wide()
    not_ready()
    println("ok")
}
