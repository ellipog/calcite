/// Checks `world.advancements` (CAL-164): the vanilla data's advancements put in their tree, each
/// once its parent is, with vanilla's line for how many; each shown one laid out across at its
/// depth, as vanilla lays the adventure tab out; a fresh player's progress, the tick's criterion
/// of the crafting table's recipe advancement awarded, which finishes it, and the first update
/// that gives, as vanilla's join sends it: the advancement and the root it's under shown, the
/// root though it's hidden, as one under it is done, and its progress; then nothing more to send.
/// Then that progress saved and read back as a player's file has it.
/// Run from the repository's root, as it reads the pinned server jar in oracle/jars/.
module test.advancement_tree

import json.tree.{Json, Member, write}
import pack.vanilla.{vanilla_jar, vanilla_only}
import protocol.wire.{Reader, Writer}
import registry.load.{load_registries}
import registry.streams.{Streams}
import rig.nbt.{load_language}
import server.log.{Entry}
import world.advancements.{Advancements, PlayerAdvancements}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn main() {
    var logs = List<Entry>()
    let resources = vanilla_only(vanilla_jar(String("oracle/jars/server-26.3.jar"))!)
    let lang = load_language()!
    let r = load_registries(resources, some(lang), mut logs) else panic("the registries didn't load")
    var lines = List<Entry>()
    let a = Advancements.of(r, mut lines)
    check("{a.nodes.len()} {lines.len()} {lines[0].message} {lines[0].thread.copy() ?? String()}", "1866 1 Loaded 1866 advancements Worker-Main-1")

    // Across, each at its depth, as vanilla's adventure tab has them.
    var across = String()
    for name in ["adventure/root", "adventure/kill_a_mob", "adventure/kill_all_mobs", "adventure/sniper_duel", "adventure/bullseye", "adventure/avoid_vibration"] {
        let at = a.find("minecraft:{name}") else panic("no {name}")
        across.push_str(" {a.x[at]}")
    }
    check(across, " 0.0 1.0 2.0 3.0 3.0 1.0")
    // Down, none above the tab's top, the root amid its children.
    let root = a.find(String("minecraft:adventure/root")) ?? 0
    var lowest = 0.0f32
    for i in 0..a.all.len() {
        if a.root(i) == root and a.y[i] < lowest {
            lowest = a.y[i]
        }
    }
    check("{lowest} {a.y[root] > 0.0f32}", "0.0 true")

    // A fresh player: the crafting table's recipe advancement finished by its tick criterion.
    var p = PlayerAdvancements.fresh(a)
    let table = a.find(String("minecraft:recipes/decorations/crafting_table")) ?? 0
    let first = p.award(a, table, String("unlock_right_away"), 1000)
    check("{first.granted} {first.finished}", "true true")
    let again = p.award(a, table, String("has_the_recipe"), 2000)
    check("{again.granted} {again.finished}", "true false")
    let listening = p.listening(String("minecraft:tick"))
    check("{listening.len()}", "0")

    // The first update: reset, the advancement and its root added, its progress.
    let sent = p.flush(a, true, Streams.new(), r) else panic("nothing sent")
    var w = Writer.new()
    sent.write(mut w)
    var rd = Reader.new(w.into_bytes())
    let reset = rd.bool()!
    let added = rd.varint()!
    var ids = String()
    for _ in 0..added {
        let id = rd.string(32767)!
        if rd.bool()! {
            _ = rd.string(32767)!
        }
        if rd.bool()! {
            panic("{id} is shown")
        }
        let sets = rd.varint()!
        for _ in 0..sets {
            let n = rd.varint()!
            for _ in 0..n {
                _ = rd.string(32767)!
            }
        }
        _ = rd.bool()!
        _ = rd.bytes(8)!
        ids.push_str(" {id}")
    }
    check("{reset}{ids}", "true minecraft:recipes/decorations/crafting_table minecraft:recipes/root")
    check("{rd.varint()!}", "0")
    // Both added ones' progress, the root's too, as it was started as the player's were loaded,
    // each's criteria in the order of its `HashMap`.
    let progress = rd.varint()!
    var got = List<String>()
    for _ in 0..progress {
        var each = rd.string(32767)!
        let n = rd.varint()!
        for _ in 0..n {
            let name = rd.string(32767)!
            let obtained = rd.bool()!
            if obtained {
                each.push_str(" {name}={rd.i64()!}")
            } else {
                each.push_str(" {name}")
            }
        }
        got.push(each)
    }
    got.sort()
    check("{got}", "[minecraft:recipes/decorations/crafting_table unlock_right_away=1000 has_the_recipe=2000, minecraft:recipes/root impossible]")
    check("{rd.rest().len()}", "1")
    // Nothing more till something changes.
    let later = p.flush(a, true, Streams.new(), r)
    check("{later == none}", "true")
    saved(a, p, table)
    println("ok")
}

// Saved as `save` writes the player's file (CAL-164): only the advancement with progress, its
// criteria obtained with when, an hour ahead of UTC, and done; read back as `load` reads it, the
// same, an advancement there's none of warned of and the `DataVersion` left out; and a file that
// can't be read, nothing of it, with vanilla's error.
fn saved(a: Advancements, p: PlayerAdvancements, table: usize) {
    let members = p.to_json(a, 3600)
    check(plain(Json.Object(members.copy())), "('minecraft:recipes/decorations/crafting_table':('criteria':('unlock_right_away':'1970-01-01 01:00:01 +0100','has_the_recipe':'1970-01-01 01:00:02 +0100'),'done':true))")
    var file = members.copy()
    var gone = List<Member>()
    gone.push(Member { key: String("done"), value: Json.Bool(false) })
    file.push(Member { key: String("minecraft:gone"), value: Json.Object(gone) })
    file.push(Member { key: String("DataVersion"), value: Json.Number(String("4790")) })
    var lines = List<Entry>()
    var back = PlayerAdvancements.loaded(a, some(Json.Object(file)), String("f.json"), mut lines)
    check("{lines.len()} {lines[0].message}", "1 Ignored advancement 'minecraft:gone' in progress file f.json - it doesn't exist anymore?")
    check(plain(Json.Object(back.to_json(a, 3600))), plain(Json.Object(members.copy())))
    check("{back.is_done(a, table)}", "true")
    var bad = List<Member>()
    var criteria = List<Member>()
    criteria.push(Member { key: String("unlock_right_away"), value: Json.Str(String("1970-13-01 01:00:01 +0100")) })
    var progress = List<Member>()
    progress.push(Member { key: String("criteria"), value: Json.Object(criteria) })
    bad.push(Member { key: String("minecraft:recipes/decorations/crafting_table"), value: Json.Object(progress) })
    var broken_lines = List<Entry>()
    var broken = PlayerAdvancements.loaded(a, some(Json.Object(bad)), String("f.json"), mut broken_lines)
    check("{broken_lines.len()} {broken_lines[0].message} {broken.is_done(a, table)}", "1 Couldn't parse player advancements in f.json false")
}

// `value` as JSON, its braces round and its quotes single, to be written in a check.
fn plain(value: Json) -> String {
    var out = List<u8>()
    write(mut out, value)
    var s = String()
    for b in out {
        if b == 123u8 {
            s.push_str("(")
        } else if b == 125u8 {
            s.push_str(")")
        } else if b == 34u8 {
            s.push_str("'")
        } else {
            s.push_str(String.from_utf8([b]) ?? String())
        }
    }
    return s
}
