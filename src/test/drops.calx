// The state `text` names, `name[property=value,...]`, as `BlockStateParser` reads it.
fn state_of(f: Facts, text: String) -> u32 {
    var m = JavaHashMap<String, Tag>()
    var name = text.copy()
    if let open = text.find("[") {
        name = text[..open]
        var props = JavaHashMap<String, Tag>()
        var rest = text[open + 1..text.len() - 1]
        while rest.len() > 0 {
            let end = rest.find(",") ?? rest.len()
            let part = rest[..end]
            let eq = part.find("=") ?? panic("no = in {part}")
            props.insert(part[..eq], Tag.Str(part[eq + 1..]))
            rest = if end < rest.len() { rest[end + 1..] } else { String() }
        }
        m.insert(String("properties"), Tag.Compound(props))
    }
    m.insert(String("id"), Tag.Str(name))
    return match f.codec.decode(Tag.Compound(m)) {
        ok(s) => s,
        err(e) => panic("the state {text}: {e}"),
    }
}

// Stone broken at 3, -60, 5 three times, with the level's random seeded 0: its cobblestone popped
// where vanilla's `popResource` would put it each time, but made only where `block_drops` is on.
fn pops(f: Facts, level: mut Level) {
    level.sequences = some(RandomSequences())
    level.set_random(TapedRandom.new(0))
    let stone = state_of(f, String("minecraft:stone"))
    level.drop_resources(f, stone, 3, -60, 5, none, none, none)
    level.block_drops = false
    level.drop_resources(f, stone, 3, -60, 5, none, none, none)
    level.block_drops = true
    level.drop_resources(f, stone, 3, -60, 5, none, none, none)
    let dropped = level.take_dropped()
    if dropped.len() != 2 {
        panic("dropped {dropped.len()} items, want 2")
    }
    let want: List<(f64, f64, f64)> = [(3.6154838936883285, -59.75473179216426, 5.568708712675054), (3.442594592370359, -59.382579229900095, 5.68959125893624)]
    for i in 0..dropped.len() {
        let Dropped.Item(dx, dy, dz, stack) = dropped[i].copy() else panic("dropped {i} isn't an item")
        let (x, y, z) = want[i]
        if dx != x or dy != y or dz != z {
            panic("item {i} at {dx}, {dy}, {dz}, want {x}, {y}, {z}")
        }
        let snbt = stack.to_snbt()
        if snbt != "\{count:1,id:\"minecraft:cobblestone\"\}" {
            panic("item {i} is {snbt}")
        }
    }
}

// What the level queued, each item where it's popped and each orb's value and merge ID, the orbs
// at the block's middle.
fn queued(level: mut Level) -> String {
    var out = String()
    for d in level.take_dropped() {
        let one = match d {
            Dropped.Item(x, y, z, _) => " item({bits(x)},{bits(y)},{bits(z)})",
            Dropped.Orb(x, y, z, value, pick) => {
                if x != 3.5 or y != -59.5 or z != 5.5 {
                    panic("an orb at {x}, {y}, {z}, not the block's middle")
                }
                " orb({value},{pick})"
            },
        }
        out.push_str(one)
    }
    return out
}

fn bits(v: f64) -> i64 {
    return i64.wrap(v.to_bits())
}

// Blocks that drop experience broken at 3, -60, 5 in turn, with the level's random seeded 0: each
// stack popped, then the block's xp range sampled, then each orb's merge ID drawn, `nextInt(40)`,
// as `ExperienceOrb.award` draws them, the orbs only where `block_drops` is on and none with silk
// touch, as orb_model.py has them; and the random after.
fn experience(f: Facts, level: mut Level, silk: Tag?) {
    level.set_random(TapedRandom.new(0))
    let broken: List<(str, bool, bool, str)> = [
        ("minecraft:diamond_ore", false, true, " item(4615323764758206801,-4589765488675500951,4617955827048222456) orb(3,1) orb(1,39)"),
        ("minecraft:sculk_catalyst", false, true, " orb(3,14) orb(1,37) orb(1,37)"),
        ("minecraft:sculk_catalyst", true, true, " item(4614934452661710825,-4589817864492399009,4618091928695796824)"),
        ("minecraft:spawner", false, true, " orb(17,23) orb(7,8) orb(7,4)"),
        ("minecraft:redstone_ore", false, true, " item(4614915072066946992,-4589798184691195695,4617597773569981330) orb(3,25) orb(1,5)"),
        ("minecraft:diamond_ore", false, false, ""),
        ("minecraft:sculk_catalyst", false, true, " orb(3,35) orb(1,0) orb(1,15)"),
    ]
    for (name, with_silk, drops, want) in broken {
        level.block_drops = drops
        let tool: Tag? = if with_silk { silk.copy() } else { none }
        level.drop_resources(f, state_of(f, String(name)), 3, -60, 5, none, some(1), tool)
        let got = queued(mut level)
        if got != String(want) {
            panic("{name}: queued{got}, want{want}")
        }
    }
    level.block_drops = true
    let after = level.next_long()
    if after != 8987859488885190724 {
        panic("the level's random after is {after}")
    }
    for line in level.take_lines() {
        panic("unimplemented: {line.message}")
    }
}

// The tool's value effects as vanilla's enchantments give them: mending's `repair_with_xp`, a
// `multiply` by its `factor`, 2; silk touch's `block_experience`, `set` to 0; and none where an
// enchantment hasn't the component, unbreaking's on experience.
fn effects(items: ItemCodecs, silk: Tag?) {
    let mending = items.stack(parse(String("\{id:\"minecraft:diamond_hoe\",count:1,components:\{\"minecraft:damage\":2,\"minecraft:enchantments\":\{\"minecraft:mending\":1,\"minecraft:unbreaking\":3\}\}\}"))!, false) ?? panic("no hoe")
    var random = TapedRandom.new(0)
    let repair = enchanted_value(mending, "minecraft:repair_with_xp", 3, items, mut random)
    let unchanged = enchanted_value(mending, "minecraft:block_experience", 3, items, mut random)
    let silk_stack = silk.copy() ?? panic("no pickaxe")
    let none_left = enchanted_value(silk_stack, "minecraft:block_experience", 7, items, mut random)
    if repair != 6 or unchanged != 3 or none_left != 0 {
        panic("mending's repair {repair}, unbreaking's experience {unchanged}, silk touch's {none_left}")
    }
}

// Mobs' death tables rolled as a player's kill rolls them (D416), from their random sequences: a
// cow's beef, and leather or not; a white sheep's mutton and wool, a shorn one's mutton alone; a
// zombie's flesh and its rare drops; a creeper's gunpowder, no disc as a player killed it; a
// slime's of size 1 its balls, of size 2 none; a burning cow's and pig's meat cooked,
// `furnace_smelt` (D436); and none of what they ask missing.
fn deaths(f: Facts, level: mut Level, loot: Loot) {
    let player = LootEntity { kind: String("minecraft:player") }
    let white = LootEntity { kind: String("minecraft:sheep"), sheep_color: some(String("white")) }
    let shorn = LootEntity { kind: String("minecraft:sheep"), sheep_color: some(String("white")), sheared: true }
    let killed: List<(str, LootEntity, List<str>, List<str>)> = [
        ("cow", LootEntity { kind: String("minecraft:cow") }, ["minecraft:beef"], ["minecraft:beef", "minecraft:leather"]),
        ("sheep", white, ["minecraft:mutton", "minecraft:white_wool"], ["minecraft:mutton", "minecraft:white_wool"]),
        ("sheep", shorn, ["minecraft:mutton"], ["minecraft:mutton"]),
        ("zombie", LootEntity { kind: String("minecraft:zombie") }, [], ["minecraft:rotten_flesh", "minecraft:iron_ingot", "minecraft:carrot", "minecraft:potato"]),
        ("creeper", LootEntity { kind: String("minecraft:creeper") }, [], ["minecraft:gunpowder"]),
        ("slime", LootEntity { kind: String("minecraft:slime"), cube_size: 1 }, [], ["minecraft:slime_ball"]),
        ("slime", LootEntity { kind: String("minecraft:slime"), cube_size: 2 }, [], []),
        ("cow", LootEntity { kind: String("minecraft:cow"), on_fire: true }, ["minecraft:cooked_beef"], ["minecraft:cooked_beef", "minecraft:leather"]),
        ("pig", LootEntity { kind: String("minecraft:pig"), on_fire: true }, ["minecraft:cooked_porkchop"], ["minecraft:cooked_porkchop"]),
    ]
    for (name, this, must, may) in killed {
        let table = "minecraft:entities/{name}"
        let params = LootParams { origin: some((0.5, -60.0, 0.5)), this_entity: true, this: some(this.copy()), damage_source: true, attacker: some(player.copy()), direct_attacker: some(player.copy()), killed_by_player: true }
        let sequence = random_sequence(loot, table.copy()) ?? panic("{table} has no sequence")
        var random = level.lend_sequence(sequence.copy()) ?? panic("no sequence {sequence}")
        var missing = List<String>()
        let stacks = roll_table(loot, f, level, mut random, params, table.copy(), mut missing)
        level.give_back_sequence(sequence, random)
        for m in missing {
            panic("{table}: missing {m}")
        }
        var ids = List<String>()
        for s in stacks {
            let t = s.copy() else continue
            let Tag.Compound(m) = t else continue
            let Tag.Str(id) = m["id"] else continue
            ids.push(id.copy())
        }
        for want in must {
            if not ids.contains(String(want)) {
                panic("{table} dropped no {want}")
            }
        }
        for id in ids {
            var allowed = false
            for allowed_id in may {
                if id == String(allowed_id) {
                    allowed = true
                }
            }
            if not allowed {
                panic("{table} dropped {id}")
            }
        }
    }
}

fn main() {
    let loaded = load_vanilla()!
    let r = loaded.registries.copy()
    let blocks = r.find_builtin(String("block")) ?? panic("no blocks")
    let fluids = r.find_builtin(String("fluid")) ?? panic("no fluids")
    let f = match Facts.new(r.builtin[blocks].copy(), r.builtin[fluids].copy(), BlockStates.new([1], [1], 1)) {
        ok(made) => made,
        err(e) => panic("the block facts: {e}"),
    }
    let loot = Loot.new(Shared(r.copy()))
    var level = Level.new(10, 10)
    level.loot = some(Shared(loot.copy()))
    level.sequences = some(RandomSequences())
    level.world_seed = SEED

    var got = List<String>()
    var names = List<String>()
    for (text, tool_text, be_text, entity) in cases() {
        let state = state_of(f, String(text))
        let tool: Tag? = if tool_text == "" { none } else { loaded.items.value.stack(parse(String(tool_text))!, false) }
        let be: Tag? = if be_text == "" { none } else { some(parse(String(be_text))!) }
        let breaker: i32? = if entity { some(1) } else { none }
        got.push("case {text} tool={if tool_text == "" { "-" } else { tool_text }} entity={if entity { 1 } else { 0 }}")
        let table = loot_table_of(f, f.block(state)) else {
            got.push(String("  none"))
            continue
        }
        for s in get_drops(f, mut level, state, 0, 0, 0, be, breaker, tool) {
            got.push(match s {
                some(t) => "  {t.to_snbt()}",
                none => String("  empty"),
            })
        }
        let sequence = random_sequence(loot, table.copy()) ?? String("-")
        got.push("  table {table} sequence {sequence}")
        if not names.contains(sequence) {
            names.push(sequence)
        }
    }
    for line in level.take_lines() {
        got.push("unimplemented: {line.message}")
    }
    names.sort()
    var sequences = level.sequences.take() ?? panic("the level hasn't the sequences")
    for name in names {
        var random = sequences.lend(name.copy(), SEED)
        got.push("after {name} {random.next_long()}")
    }

    let want = wanted()
    for i in 0..got.len() {
        if i >= want.len() {
            panic("line {i + 1}: got {got[i]}, want nothing more")
        }
        if got[i] != String(want[i]) {
            panic("line {i + 1}: got {got[i]}, want {want[i]}")
        }
    }
    if got.len() < want.len() {
        panic("line {got.len() + 1}: got nothing more, want {want[got.len()]}")
    }
    pops(f, mut level)
    let silk = loaded.items.value.stack(parse(String("\{id:\"minecraft:diamond_pickaxe\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:silk_touch\":1\}\}\}"))!, false)
    experience(f, mut level, silk)
    effects(loaded.items.value.copy(), silk)
    deaths(f, mut level, loot)
    println("ok")
}
