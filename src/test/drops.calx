// The state `text` names, `name[property=value,...]`, as `BlockStateParser` reads it.
fn state_of(f: Facts, text: String) -> u32 {
    var m = JavaHashMap<String, Tag>()
    var name = text.copy()
    if let open = text.find("[") {
        name = text[..open]
        var props = JavaHashMap<String, Tag>()
        var rest = text[open + 1..text.len() - 1]
        while rest.len() > 0 {
            let end = rest.find(",") ?? rest.len()
            let part = rest[..end]
            let eq = part.find("=") ?? panic("no = in {part}")
            props.insert(part[..eq], Tag.Str(part[eq + 1..]))
            rest = if end < rest.len() { rest[end + 1..] } else { String() }
        }
        m.insert(String("properties"), Tag.Compound(props))
    }
    m.insert(String("id"), Tag.Str(name))
    return match f.codec.decode(Tag.Compound(m)) {
        ok(s) => s,
        err(e) => panic("the state {text}: {e}"),
    }
}

// Stone broken at 3, -60, 5 three times, with the level's random seeded 0: its cobblestone popped
// where vanilla's `popResource` would put it each time, but made only where `block_drops` is on.
fn pops(f: Facts, level: mut Level) {
    level.sequences = some(RandomSequences())
    level.set_random(TapedRandom.new(0))
    let stone = state_of(f, String("minecraft:stone"))
    level.drop_resources(f, stone, 3, -60, 5, none, none, none)
    level.block_drops = false
    level.drop_resources(f, stone, 3, -60, 5, none, none, none)
    level.block_drops = true
    level.drop_resources(f, stone, 3, -60, 5, none, none, none)
    let dropped = level.take_dropped()
    if dropped.len() != 2 {
        panic("dropped {dropped.len()} items, want 2")
    }
    let want: List<(f64, f64, f64)> = [(3.6154838936883285, -59.75473179216426, 5.568708712675054), (3.442594592370359, -59.382579229900095, 5.68959125893624)]
    for i in 0..dropped.len() {
        let Dropped.Item(dx, dy, dz, stack) = dropped[i].copy() else panic("dropped {i} isn't an item")
        let (x, y, z) = want[i]
        if dx != x or dy != y or dz != z {
            panic("item {i} at {dx}, {dy}, {dz}, want {x}, {y}, {z}")
        }
        let snbt = stack.to_snbt()
        if snbt != "\{count:1,id:\"minecraft:cobblestone\"\}" {
            panic("item {i} is {snbt}")
        }
    }
}

// What the level queued, each item where it's popped and each orb's value and merge ID, the orbs
// at the block's middle.
fn queued(level: mut Level) -> String {
    var out = String()
    for d in level.take_dropped() {
        let one = match d {
            Dropped.Item(x, y, z, _) => " item({bits(x)},{bits(y)},{bits(z)})",
            Dropped.Orb(x, y, z, value, pick) => {
                if x != 3.5 or y != -59.5 or z != 5.5 {
                    panic("an orb at {x}, {y}, {z}, not the block's middle")
                }
                " orb({value},{pick})"
            },
            Dropped.Tnt(p) => " tnt({bits(p.x)},{bits(p.y)},{bits(p.z)})",
        }
        out.push_str(one)
    }
    return out
}

fn bits(v: f64) -> i64 {
    return i64.wrap(v.to_bits())
}

// Blocks that drop experience broken at 3, -60, 5 in turn, with the level's random seeded 0: each
// stack popped, then the block's xp range sampled, then each orb's merge ID drawn, `nextInt(40)`,
// as `ExperienceOrb.award` draws them, the orbs only where `block_drops` is on and none with silk
// touch, as models/orb.calx has them; and the random after.
fn experience(f: Facts, level: mut Level, silk: Tag?) {
    level.set_random(TapedRandom.new(0))
    let broken: List<(str, bool, bool, str)> = [
        ("minecraft:diamond_ore", false, true, " item(4615323764758206801,-4589765488675500951,4617955827048222456) orb(3,1) orb(1,39)"),
        ("minecraft:sculk_catalyst", false, true, " orb(3,14) orb(1,37) orb(1,37)"),
        ("minecraft:sculk_catalyst", true, true, " item(4614934452661710825,-4589817864492399009,4618091928695796824)"),
        ("minecraft:spawner", false, true, " orb(17,23) orb(7,8) orb(7,4)"),
        ("minecraft:redstone_ore", false, true, " item(4614915072066946992,-4589798184691195695,4617597773569981330) orb(3,25) orb(1,5)"),
        ("minecraft:diamond_ore", false, false, ""),
        ("minecraft:sculk_catalyst", false, true, " orb(3,35) orb(1,0) orb(1,15)"),
    ]
    for (name, with_silk, drops, want) in broken {
        level.block_drops = drops
        let tool: Tag? = if with_silk { silk.copy() } else { none }
        level.drop_resources(f, state_of(f, String(name)), 3, -60, 5, none, some(1), tool)
        let got = queued(mut level)
        if got != String(want) {
            panic("{name}: queued{got}, want{want}")
        }
    }
    level.block_drops = true
    let after = level.next_long()
    if after != 8987859488885190724 {
        panic("the level's random after is {after}")
    }
    for line in level.take_lines() {
        panic("unimplemented: {line.message}")
    }
}

// The tool's value effects as vanilla's enchantments give them: mending's `repair_with_xp`, a
// `multiply` by its `factor`, 2; silk touch's `block_experience`, `set` to 0; and none where an
// enchantment hasn't the component, unbreaking's on experience.
fn effects(items: ItemCodecs, silk: Tag?) {
    let mending = items.stack(parse(String("\{id:\"minecraft:diamond_hoe\",count:1,components:\{\"minecraft:damage\":2,\"minecraft:enchantments\":\{\"minecraft:mending\":1,\"minecraft:unbreaking\":3\}\}\}"))!, false) ?? panic("no hoe")
    var random = TapedRandom.new(0)
    let repair = enchanted_value(mending, "minecraft:repair_with_xp", 3, items, mut random)
    let unchanged = enchanted_value(mending, "minecraft:block_experience", 3, items, mut random)
    let silk_stack = silk.copy() ?? panic("no pickaxe")
    let none_left = enchanted_value(silk_stack, "minecraft:block_experience", 7, items, mut random)
    if repair != 6 or unchanged != 3 or none_left != 0 {
        panic("mending's repair {repair}, unbreaking's experience {unchanged}, silk touch's {none_left}")
    }
}

// Mobs' death tables rolled as a player's kill rolls them (D416), from their random sequences: a
// cow's beef, and leather or not; a white sheep's mutton and wool, a shorn one's mutton alone; a
// zombie's flesh and its rare drops; a creeper's gunpowder, no disc as a player killed it; a
// slime's of size 1 its balls, of size 2 none; a burning cow's and pig's meat cooked,
// `furnace_smelt` (D436); and none of what they ask missing.
fn deaths(f: Facts, level: mut Level, loot: Loot) {
    let player = LootEntity { kind: String("minecraft:player") }
    let white = LootEntity { kind: String("minecraft:sheep"), sheep_color: some(String("white")) }
    let shorn = LootEntity { kind: String("minecraft:sheep"), sheep_color: some(String("white")), sheared: true }
    let killed: List<(str, LootEntity, List<str>, List<str>)> = [
        ("cow", LootEntity { kind: String("minecraft:cow") }, ["minecraft:beef"], ["minecraft:beef", "minecraft:leather"]),
        ("sheep", white, ["minecraft:mutton", "minecraft:white_wool"], ["minecraft:mutton", "minecraft:white_wool"]),
        ("sheep", shorn, ["minecraft:mutton"], ["minecraft:mutton"]),
        ("zombie", LootEntity { kind: String("minecraft:zombie") }, [], ["minecraft:rotten_flesh", "minecraft:iron_ingot", "minecraft:carrot", "minecraft:potato"]),
        ("creeper", LootEntity { kind: String("minecraft:creeper") }, [], ["minecraft:gunpowder"]),
        ("slime", LootEntity { kind: String("minecraft:slime"), cube_size: 1 }, [], ["minecraft:slime_ball"]),
        ("slime", LootEntity { kind: String("minecraft:slime"), cube_size: 2 }, [], []),
        ("cow", LootEntity { kind: String("minecraft:cow"), on_fire: true }, ["minecraft:cooked_beef"], ["minecraft:cooked_beef", "minecraft:leather"]),
        ("pig", LootEntity { kind: String("minecraft:pig"), on_fire: true }, ["minecraft:cooked_porkchop"], ["minecraft:cooked_porkchop"]),
    ]
    for (name, this, must, may) in killed {
        let table = "minecraft:entities/{name}"
        let params = LootParams { origin: some((0.5, -60.0, 0.5)), this_entity: true, this: some(this.copy()), damage_source: true, attacker: some(player.copy()), direct_attacker: some(player.copy()), killed_by_player: true }
        let sequence = random_sequence(loot, table.copy()) ?? panic("{table} has no sequence")
        var random = level.lend_sequence(sequence.copy()) ?? panic("no sequence {sequence}")
        var missing = List<String>()
        let stacks = roll_table(loot, f, level, mut random, params, table.copy(), mut missing)
        level.give_back_sequence(sequence, random)
        for m in missing {
            panic("{table}: missing {m}")
        }
        var ids = List<String>()
        for s in stacks {
            let t = s.copy() else continue
            let Tag.Compound(m) = t else continue
            let Tag.Str(id) = m["id"] else continue
            ids.push(id.copy())
        }
        for want in must {
            if not ids.contains(String(want)) {
                panic("{table} dropped no {want}")
            }
        }
        for id in ids {
            var allowed = false
            for allowed_id in may {
                if id == String(allowed_id) {
                    allowed = true
                }
            }
            if not allowed {
                panic("{table} dropped {id}")
            }
        }
    }
}

// What enchanted armor does against a damage (D439): protection IV on a chestplate takes 4 of a
// player's attack, and nothing held in the hand or against what bypasses invulnerability;
// feather falling IV on boots 12 of a fall, 16 with the chestplate's, and nothing of an attack;
// fire protection IV on a helmet 8 of fire and of a magma block's burn; frost walker on boots
// makes them immune to the magma's burn and not to a fall, nor held in the hand; 16 points take
// 64 hundredths of 10; and none of what they ask missing.
fn wards(f: Facts, level: Level, loot: Loot, items: ItemCodecs) {
    let types = DamageTypes.vanilla()
    let chest = armor(items, "diamond_chestplate", "\"minecraft:protection\":4")
    let boots = armor(items, "diamond_boots", "\"minecraft:feather_falling\":4")
    let helmet = armor(items, "leather_helmet", "\"minecraft:fire_protection\":4")
    let frost = armor(items, "diamond_boots", "\"minecraft:frost_walker\":2")
    let protections: List<(List<Tag?>, str, f32)> = [
        (worn_set(none, none, some(chest.copy()), none), "player_attack", 4.0f32),
        (worn_set(some(chest.copy()), none, none, none), "player_attack", 0.0f32),
        (worn_set(none, none, some(chest.copy()), none), "out_of_world", 0.0f32),
        (worn_set(none, some(boots.copy()), none, none), "fall", 12.0f32),
        (worn_set(none, some(boots.copy()), some(chest.copy()), none), "fall", 16.0f32),
        (worn_set(none, some(boots.copy()), none, none), "player_attack", 0.0f32),
        (worn_set(none, none, none, some(helmet.copy())), "in_fire", 8.0f32),
        (worn_set(none, none, none, some(helmet.copy())), "hot_floor", 8.0f32),
        (worn_set(none, none, none, some(helmet.copy())), "fall", 0.0f32),
    ]
    for (worn, kind, want) in protections {
        var random = TapedRandom.new(0)
        var drawn = TapedRandom.new(0)
        var missing = List<String>()
        let got = worn_amount(loot, f, level, mut random, mut drawn, worn.copy(), "minecraft:damage_protection", hurt_by(types, kind), 0.0f32, mut missing)
        for m in missing {
            panic("protection against {kind}: missing {m}")
        }
        if got != want {
            panic("protection against {kind}: {got}, want {want}")
        }
    }
    let immunities: List<(List<Tag?>, str, bool)> = [
        (worn_set(none, some(frost.copy()), none, none), "hot_floor", true),
        (worn_set(none, some(frost.copy()), none, none), "campfire", true),
        (worn_set(none, some(frost.copy()), none, none), "fall", false),
        (worn_set(some(frost.copy()), none, none, none), "hot_floor", false),
        (worn_set(none, some(boots.copy()), none, none), "hot_floor", false),
    ]
    for (worn, kind, want) in immunities {
        var random = TapedRandom.new(0)
        var missing = List<String>()
        let got = worn_immune(loot, f, level, mut random, worn.copy(), hurt_by(types, kind), mut missing)
        for m in missing {
            panic("immunity to {kind}: missing {m}")
        }
        if got != want {
            panic("immunity to {kind}: {got}, want {want}")
        }
    }
    let left = after_magic_absorb(10.0f32, 16.0f32)
    if left != 10.0f32 * (1.0f32 - 16.0f32 / 25.0f32) or after_magic_absorb(10.0f32, 30.0f32) != 10.0f32 * (1.0f32 - 20.0f32 / 25.0f32) {
        panic("after_magic_absorb gave {left}")
    }
}

// A stack of the item `item` with the enchantments `enchantments`, as SNBT gives them.
fn armor(items: ItemCodecs, item: str, enchantments: str) -> Tag {
    let text = "\{id:\"minecraft:{item}\",count:1,components:\{\"minecraft:enchantments\":\{{enchantments}\}\}\}"
    return items.stack(parse(text)!, false) ?? panic("no {item} with {enchantments}")
}

// What a living entity wears and holds by slot: `hand` in its main hand, `feet`, `chest` and
// `head`, and nothing else.
fn worn_set(hand: own Tag?, feet: own Tag?, chest: own Tag?, head: own Tag?) -> List<Tag?> {
    return [hand, none, feet, none, chest, head, none, none]
}

// What looting does to a mob's equipment drop chance as it's killed (D526), as
// `processEquipmentDropChance` has it with the killer as both its victim and its attacker:
// looting III in a player's main hand adds 0.03, a hundredth a level, to 0.085; in a zombie's
// main hand, or on a player's feet, or with nothing enchanted, nothing; and what it asks, that
// the attacker's a player, isn't missing.
fn looted(f: Facts, level: Level, loot: Loot, items: ItemCodecs) {
    let types = DamageTypes.vanilla()
    let looting = sword(items, "\"minecraft:looting\":3")
    let player = LootEntity { kind: String("minecraft:player") }
    let zombie = LootEntity { kind: String("minecraft:zombie") }
    let raised = 0.085f32 + (0.01f32 + 0.01f32 * 2.0f32)
    let kills: List<(List<Tag?>, LootEntity, f32)> = [
        (worn_set(some(looting.copy()), none, none, none), player.copy(), raised),
        (worn_set(some(looting.copy()), none, none, none), zombie.copy(), 0.085f32),
        (worn_set(none, some(looting.copy()), none, none), player.copy(), 0.085f32),
        (worn_set(none, none, none, none), player.copy(), 0.085f32),
    ]
    for (worn, killer, want) in kills {
        var random = TapedRandom.new(0)
        var drawn = TapedRandom.new(0)
        var missing = List<String>()
        let params = LootParams { origin: some((0.5, -60.0, 0.5)), this_entity: true, this: some(killer.copy()), damage_source: true, attacker: some(killer.copy()), direct_attacker: some(killer.copy()), damage_tags: some(types.tags_of(types.id("player_attack"))) }
        let got = equipment_drop_chance(loot, f, level, mut random, mut drawn, worn, params, 0.085f32, mut missing)
        for m in missing {
            panic("looting: missing {m}")
        }
        if got != want {
            panic("looting for a {killer.kind}: {got}, want {want}")
        }
    }
}

// A player hurt by a damage of the type `kind`, nothing causing it, as `Enchantment.damageContext`
// gives it, with its type's tags.
fn hurt_by(types: DamageTypes, kind: str) -> LootParams {
    return LootParams { origin: some((0.5, -60.0, 0.5)), this_entity: true, this: some(LootEntity { kind: String("minecraft:player") }), damage_source: true, damage_tags: some(types.tags_of(types.id(kind))) }
}

// What enchanted swords' effects come to against mobs (D438): sharpness V adds 3 to a cow's
// damage; smite V 12.5 to a zombie's, of `#sensitive_to_smite` by `#undead`, and nothing to a
// cow's; bane of arthropods I 2.5 to a spider's and nothing to a cow's; knockback II 2 to the
// knockback; fire aspect II lights a cow for 8 seconds where the damage is direct, and not where
// it isn't; bane's slowness, one effect, for 1.5 seconds at 3, done to a spider and not a cow; and
// none of what they ask missing.
fn weapons(f: Facts, level: Level, loot: Loot, items: ItemCodecs) {
    let sharp = sword(items, "\"minecraft:sharpness\":5")
    let smite = sword(items, "\"minecraft:smite\":5")
    let bane = sword(items, "\"minecraft:bane_of_arthropods\":1")
    let knock = sword(items, "\"minecraft:knockback\":2")
    let fire = sword(items, "\"minecraft:fire_aspect\":2")
    let amounts: List<(Tag, str, str, f32, f32)> = [
        (sharp.copy(), "minecraft:damage", "minecraft:cow", 6.0f32, 9.0f32),
        (smite.copy(), "minecraft:damage", "minecraft:zombie", 6.0f32, 18.5f32),
        (smite.copy(), "minecraft:damage", "minecraft:cow", 6.0f32, 6.0f32),
        (bane.copy(), "minecraft:damage", "minecraft:spider", 6.0f32, 8.5f32),
        (bane.copy(), "minecraft:damage", "minecraft:cow", 6.0f32, 6.0f32),
        (knock.copy(), "minecraft:knockback", "minecraft:cow", 0.0f32, 2.0f32),
        (sharp.copy(), "minecraft:knockback", "minecraft:cow", 0.0f32, 0.0f32),
    ]
    for (stack, name, victim, amount, want) in amounts {
        var random = TapedRandom.new(0)
        var drawn = TapedRandom.new(0)
        var missing = List<String>()
        let got = enchanted_amount(loot, f, level, mut random, mut drawn, stack.copy(), name, context(victim, true), amount, mut missing)
        for m in missing {
            panic("{name} against {victim}: missing {m}")
        }
        if got != want {
            panic("{name} against {victim}: {got}, want {want}")
        }
    }
    let lit = effects_after(f, level, loot, fire.copy(), "minecraft:cow", true)
    if lit.len() != 1 or lit[0].affected != "victim" {
        panic("fire aspect did {lit.len()} effects")
    }
    match lit[0].what {
        Attacked.Ignite(seconds) => {
            if seconds != 8.0f32 {
                panic("fire aspect lit for {seconds} seconds")
            }
        },
        _ => panic("fire aspect did something else"),
    }
    if not effects_after(f, level, loot, fire.copy(), "minecraft:cow", false).is_empty() {
        panic("fire aspect lit a cow it didn't hurt directly")
    }
    let slowed = effects_after(f, level, loot, bane.copy(), "minecraft:spider", true)
    if slowed.len() != 1 {
        panic("bane of arthropods did {slowed.len()} effects to a spider")
    }
    match slowed[0].what {
        Attacked.Effect(n, low, high, weak, strong) => {
            if n != [1] or low != 1.5f32 or high != 1.5f32 or weak != 3.0f32 or strong != 3.0f32 {
                panic("bane of arthropods' slowness {n} {low} {high} {weak} {strong}")
            }
        },
        _ => panic("bane of arthropods did something else"),
    }
    if not effects_after(f, level, loot, bane.copy(), "minecraft:cow", true).is_empty() {
        panic("bane of arthropods slowed a cow")
    }
}

// An iron sword with the enchantments `enchantments`, as SNBT gives them.
fn sword(items: ItemCodecs, enchantments: str) -> Tag {
    let text = "\{id:\"minecraft:iron_sword\",count:1,components:\{\"minecraft:enchantments\":\{{enchantments}\}\}\}"
    return items.stack(parse(text)!, false) ?? panic("no sword with {enchantments}")
}

// A player's damage to a mob of the type `victim`, direct or not, as `Enchantment.damageContext`
// gives it.
fn context(victim: str, direct: bool) -> LootParams {
    let player = LootEntity { kind: String("minecraft:player") }
    return LootParams { origin: some((0.5, -60.0, 0.5)), this_entity: true, this: some(LootEntity { kind: String(victim) }), damage_source: true, attacker: some(player.copy()), direct_attacker: some(player), direct: direct }
}

// The post-attack effects of `stack` in the main hand against a mob of the type `victim`.
fn effects_after(f: Facts, level: Level, loot: Loot, stack: Tag, victim: str, direct: bool) -> List<PostAttack> {
    var random = TapedRandom.new(0)
    var missing = List<String>()
    let out = post_attack_effects(loot, f, level, mut random, stack, 0, "attacker", context(victim, direct), mut missing)
    for m in missing {
        panic("post-attack effects against {victim}: missing {m}")
    }
    return out
}

// `DistancePredicate.matches` (CAL-164), as `adventure/bullseye`'s `minecraft:distance` asks it
// of a target hit from a player: at least 30 across, not up; each axis's distance within its
// bounds; and the whole distance within `absolute`'s.
fn distances() {
    let across = parse(String("\{horizontal:\{min:30.0d\}\}"))!
    if not distance_holds(across.copy(), 8.5, -60.0, 8.5, 40.0, -59.5, 8.5) {
        panic("31.5 across, not at least 30")
    }
    if distance_holds(across, 8.5, -60.0, 8.5, 30.0, -20.0, 8.5) {
        panic("21.5 across and 40 up, at least 30 across")
    }
    let axes = parse(String("\{x:\{max:2.0d\},y:\{min:1.0d\}\}"))!
    if not distance_holds(axes.copy(), 0.0, 0.0, 0.0, -1.5, 3.0, 9.0) or distance_holds(axes, 0.0, 0.0, 0.0, 2.5, 3.0, 0.0) {
        panic("each axis's distance")
    }
    let whole = parse(String("\{absolute:\{max:5.0d\}\}"))!
    if not distance_holds(whole.copy(), 0.0, 0.0, 0.0, 3.0, 4.0, 0.0) or distance_holds(whole, 0.0, 0.0, 0.0, 3.0, 4.0, 0.1) {
        panic("the whole distance")
    }
}

// The int providers `add`, `sub`, `mul`, `min`, `max`, `negate` and `abs` (D523), each written
// as a loot table writes it, and what Java's exact arithmetic makes of it.
fn int_providers(loot: Loot) {
    let providers: List<(str, i32)> = [
        ("\{type:\"minecraft:add\",inputs:[1,2,\{type:\"minecraft:constant\",value:3\}]\}", 6),
        ("\{type:\"minecraft:add\",inputs:[2147483647,1]\}", 0),
        ("\{type:\"minecraft:add\",inputs:[2147483647,1,-5]\}", 2147483643),
        ("\{type:\"minecraft:sub\",left:5,right:7\}", -2),
        ("\{type:\"minecraft:sub\",left:-2147483648,right:1\}", 0),
        ("\{type:\"minecraft:mul\",inputs:[3,-4]\}", -12),
        ("\{type:\"minecraft:mul\",inputs:[65536,65536]\}", 0),
        ("\{type:\"minecraft:min\",inputs:[4,-1,9]\}", -1),
        ("\{type:\"minecraft:max\",inputs:[4,-1,9]\}", 9),
        ("\{type:\"minecraft:negate\",input:5\}", -5),
        ("\{type:\"minecraft:negate\",input:-2147483648\}", 0),
        ("\{type:\"minecraft:abs\",input:-7\}", 7),
        ("\{type:\"minecraft:abs\",input:-2147483648\}", 0),
        ("\{type:\"minecraft:add\",inputs:[1,\{type:\"minecraft:mul\",inputs:[65536,65536]\}]\}", 0),
        ("\{type:\"minecraft:uniform\",min:\{type:\"minecraft:negate\",input:2\},max:-2\}", -2),
    ]
    for (text, want) in providers {
        var random = TapedRandom.new(0)
        var missing = List<String>()
        let got = context_int(loot, mut random, parse(String(text))!, mut missing)
        for m in missing {
            panic("{text}: missing {m}")
        }
        if got != want {
            panic("{text}: {got}, want {want}")
        }
    }
}

fn main() {
    let loaded = load_vanilla()!
    let r = loaded.registries.copy()
    let blocks = r.find_builtin(String("block")) ?? panic("no blocks")
    let fluids = r.find_builtin(String("fluid")) ?? panic("no fluids")
    let f = match Facts.new(r.builtin[blocks].copy(), r.builtin[fluids].copy(), BlockStates.new([1], [1], 1)) {
        ok(made) => made,
        err(e) => panic("the block facts: {e}"),
    }
    let loot = Loot.new(Shared(r.copy()))
    var level = Level.new(10, 10)
    level.loot = some(Shared(loot.copy()))
    level.sequences = some(RandomSequences())
    level.world_seed = SEED

    var got = List<String>()
    var names = List<String>()
    for (text, tool_text, be_text, entity) in cases() {
        let state = state_of(f, String(text))
        let tool: Tag? = if tool_text == "" { none } else { loaded.items.value.stack(parse(String(tool_text))!, false) }
        let be: Tag? = if be_text == "" { none } else { some(parse(String(be_text))!) }
        let breaker: i32? = if entity { some(1) } else { none }
        got.push("case {text} tool={if tool_text == "" { "-" } else { tool_text }} entity={if entity { 1 } else { 0 }}")
        let table = loot_table_of(f, f.block(state)) else {
            got.push(String("  none"))
            continue
        }
        for s in get_drops(f, mut level, state, 0, 0, 0, be, breaker, tool) {
            got.push(match s {
                some(t) => "  {t.to_snbt()}",
                none => String("  empty"),
            })
        }
        let sequence = random_sequence(loot, table.copy()) ?? String("-")
        got.push("  table {table} sequence {sequence}")
        if not names.contains(sequence) {
            names.push(sequence)
        }
    }
    for line in level.take_lines() {
        got.push("unimplemented: {line.message}")
    }
    names.sort()
    var sequences = level.sequences.take() ?? panic("the level hasn't the sequences")
    for name in names {
        var random = sequences.lend(name.copy(), SEED)
        got.push("after {name} {random.next_long()}")
    }

    let want = wanted()
    for i in 0..got.len() {
        if i >= want.len() {
            panic("line {i + 1}: got {got[i]}, want nothing more")
        }
        if got[i] != String(want[i]) {
            panic("line {i + 1}: got {got[i]}, want {want[i]}")
        }
    }
    if got.len() < want.len() {
        panic("line {got.len() + 1}: got nothing more, want {want[got.len()]}")
    }
    pops(f, mut level)
    let silk = loaded.items.value.stack(parse(String("\{id:\"minecraft:diamond_pickaxe\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:silk_touch\":1\}\}\}"))!, false)
    experience(f, mut level, silk)
    effects(loaded.items.value.copy(), silk)
    deaths(f, mut level, loot)
    weapons(f, level, loot, loaded.items.value.copy())
    wards(f, level, loot, loaded.items.value.copy())
    looted(f, level, loot, loaded.items.value.copy())
    thorny(f, level, loot, loaded.items.value.copy())
    maced(f, level, loot, loaded.items.value.copy())
    bowed(f, level, loot, loaded.items.value.copy())
    int_providers(loot)
    distances()
    println("ok")
}

// A mace with density III and breach IV (D443): density's damage for each block fallen, 1.5, as
// `modifyFallBasedDamage` makes it of nothing; breach's armor effectiveness, found once at its
// level, taking 0.6 from an armor share, here a chestplate's and a zombie's 10 with 2 toughness
// against a heavy smash's 54.75, the least 2 points' 0.08, which leaves it the whole; and a mace
// without enchantments, which has none.
fn maced(f: Facts, level: Level, loot: Loot, items: ItemCodecs) {
    let text = "\{id:\"minecraft:mace\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:density\":3,\"minecraft:breach\":4\}\}\}"
    let mace = items.stack(parse(String(text))!, false) ?? panic("no mace")
    var random = TapedRandom.new(0)
    var drawn = TapedRandom.new(0)
    var missing = List<String>()
    let per = enchanted_amount(loot, f, level, mut random, mut drawn, mace.copy(), "minecraft:smash_damage_per_fallen_block", context("minecraft:zombie", true), 0.0f32, mut missing)
    if per != 1.5f32 {
        panic("density III gave {per} a block")
    }
    let found = weapon_effects(loot, f, level, mut random, mace.copy(), "minecraft:armor_effectiveness", context("minecraft:zombie", true), mut missing)
    for m in missing {
        panic("mace: missing {m}")
    }
    if found.len() != 1usize {
        panic("breach gave {found.len()} armor effects")
    }
    let (effect, lv) = found[0].copy()
    if lv != 4 {
        panic("breach found at {lv}")
    }
    let share = armor_share(54.75f32, 10.0f32, 2.0f32)
    if share != 0.08f32 {
        panic("the armor's share was {share}")
    }
    if after_absorb(54.75f32, 10.0f32, 2.0f32) != 54.75f32 * (1.0f32 - share) {
        panic("after_absorb isn't its share")
    }
    let changed = value_effect(effect, lv, share, mut drawn)
    if changed != share + (-0.15f32 + -0.15f32 * 3.0f32) {
        panic("breach IV made the share {changed}")
    }
    let plain = items.stack(parse(String("\{id:\"minecraft:mace\",count:1\}"))!, false) ?? panic("no plain mace")
    if not weapon_effects(loot, f, level, mut random, plain, "minecraft:armor_effectiveness", context("minecraft:zombie", true), mut missing).is_empty() {
        panic("a plain mace had armor effects")
    }
}

// Thorns III on a chestplate, worn where it goes (D442): its chance, 0.15 a level, its
// `enchantment_level`, drawn from the level's random, about 45 times in 100; then what it does to
// the attacker, hurt by `thorns` between 1 and 5, and the chestplate worn 2.
fn thorny(f: Facts, level: Level, loot: Loot, items: ItemCodecs) {
    let text = "\{id:\"minecraft:diamond_chestplate\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:thorns\":3\}\}\}"
    let chest = items.stack(parse(String(text))!, false) ?? panic("no chestplate with thorns")
    var random = LegacyRandom.new(42i64)
    var came = 0
    for _ in 0..200 {
        var missing = List<String>()
        let out = post_attack_effects(loot, f, level, mut random, chest.copy(), 4usize, "victim", context("minecraft:zombie", true), mut missing)
        for m in missing {
            panic("thorns: missing {m}")
        }
        if out.is_empty() {
            continue
        }
        came += 1
        if out.len() != 2 or out[0].affected != "attacker" or out[1].affected != "attacker" {
            panic("thorns did {out.len()} effects")
        }
        match out[0].what {
            Attacked.Damage(kind, low, high) => {
                if kind != "minecraft:thorns" or low != 1.0f32 or high != 5.0f32 {
                    panic("thorns hurt by {kind} from {low} to {high}")
                }
            },
            _ => panic("thorns did something else first"),
        }
        match out[1].what {
            Attacked.ItemDamage(n) => {
                if n != 2.0f32 {
                    panic("thorns wore its chestplate {n}")
                }
            },
            _ => panic("thorns did something else second"),
        }
    }
    if came < 70 or came > 110 {
        panic("thorns III came {came} times in 200")
    }
    // None for the attacker's weapon, as thorns' are for the victim.
    var missing = List<String>()
    var never = 0usize
    for _ in 0..50 {
        never += post_attack_effects(loot, f, level, mut random, chest.copy(), 0usize, "attacker", context("minecraft:zombie", true), mut missing).len()
    }
    if never != 0usize {
        panic("thorns came from a weapon")
    }
}

// A bow with power III, punch II and flame (CAL-159): against a zombie its skeleton's arrow hit,
// power adds 2 to 4 of damage and punch makes 2 of knockback from none, `#minecraft:arrows` the
// arrow; where the skeleton dealt it itself, neither; flame lights the arrow for 100 seconds as
// it's spawned; and a bow without flame does nothing then.
fn bowed(f: Facts, level: Level, loot: Loot, items: ItemCodecs) {
    let text = "\{id:\"minecraft:bow\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:power\":3,\"minecraft:punch\":2,\"minecraft:flame\":1\}\}\}"
    let bow = items.stack(parse(String(text))!, false) ?? panic("no bow")
    let plain = items.stack(parse(String("\{id:\"minecraft:bow\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:power\":1\}\}\}"))!, false) ?? panic("no plain bow")
    let skeleton = LootEntity { kind: String("minecraft:skeleton") }
    let arrow = LootEntity { kind: String("minecraft:arrow") }
    let zombie = LootEntity { kind: String("minecraft:zombie") }
    let shot = LootParams { origin: some((0.5, -60.0, 0.5)), this_entity: true, this: some(zombie.copy()), damage_source: true, attacker: some(skeleton.copy()), direct_attacker: some(arrow.copy()), direct: false }
    let hit = LootParams { origin: some((0.5, -60.0, 0.5)), this_entity: true, this: some(zombie), damage_source: true, attacker: some(skeleton.copy()), direct_attacker: some(skeleton), direct: true }
    let amounts: List<(LootParams, str, f32, f32)> = [
        (shot.copy(), "minecraft:damage", 4.0f32, 6.0f32),
        (shot.copy(), "minecraft:knockback", 0.0f32, 2.0f32),
        (hit.copy(), "minecraft:damage", 4.0f32, 4.0f32),
        (hit.copy(), "minecraft:knockback", 0.0f32, 0.0f32),
    ]
    for (params, name, amount, want) in amounts {
        var random = TapedRandom.new(0)
        var drawn = TapedRandom.new(0)
        var missing = List<String>()
        let got = enchanted_amount(loot, f, level, mut random, mut drawn, bow.copy(), name, params, amount, mut missing)
        for m in missing {
            panic("a bow's {name}: missing {m}")
        }
        if got != want {
            panic("a bow's {name}, direct {params.direct}: {got}, want {want}")
        }
    }
    let spawned = LootParams { origin: some((0.5, -58.5, 0.5)), this_entity: true, this: some(arrow) }
    var random = TapedRandom.new(0)
    var missing = List<String>()
    let lit = spawned_effects(loot, f, level, mut random, bow.copy(), spawned, mut missing)
    let unlit = spawned_effects(loot, f, level, mut random, plain.copy(), spawned, mut missing)
    for m in missing {
        panic("a bow's arrow spawned: missing {m}")
    }
    if lit.len() != 1 or not unlit.is_empty() {
        panic("a bow's arrow spawned with {lit.len()} effects, a plain one's with {unlit.len()}")
    }
    match lit[0] {
        Attacked.Ignite(seconds) => {
            if seconds != 100.0f32 {
                panic("flame lit an arrow for {seconds} seconds")
            }
        },
        _ => panic("flame did something else"),
    }
}
