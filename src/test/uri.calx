    check("https://:]%zz/", "Expected hostname|8")

    // Vanilla's links: http or https, in any case.
    if untrusted("HTTPS://example.com/bugs") != "HTTPS://example.com/bugs" {
        panic("https")
    }
    if untrusted("example.com/bugs") != "java.net.URISyntaxException: Missing protocol in URI: example.com/bugs: example.com/bugs" {
        panic("missing")
    }
    if untrusted("ftp://example.com/") != "java.net.URISyntaxException: Unsupported protocol in URI: ftp://example.com/: ftp://example.com/" {
        panic("ftp")
    }
    if untrusted("https://example.com/a b") != "java.net.URISyntaxException: Illegal character in path at index 21: https://example.com/a b" {
        panic("space")
    }
    println("ok")
}
