/// Checks `java.uri` against Java's `java.net.URI` on JDK 25: each case is the scheme Java finds,
/// or the reason and index of the exception it throws. They're links that work and links that
/// don't, in each part of a URI, with escapes, IPv6 addresses and characters outside ASCII.
module test.uri

import java.uri.{Uri}

fn check(text: String, want: String) {
    let got = match Uri.parse(text) {
        ok(u) => "ok {u.scheme ?? String("null")}",
        err(e) => e,
    }
    // Java's message is the reason, the index if there is one, then the input.
    var expected = want.copy()
    if not want.starts_with("ok ") {
        let bar = want.find_last("|")!
        let index = want[bar + 1..]
        let reason = want[..bar]
        expected = if index == "-1" { "java.net.URISyntaxException: {reason}: {text}" } else { "java.net.URISyntaxException: {reason} at index {index}: {text}" }
    }
    if got != expected {
        panic("{text}: got {got}, want {expected}")
    }
}

fn untrusted(text: String) -> String {
    return match Uri.untrusted(text) {
        ok(u) => u.text,
        err(e) => e,
    }
}

fn main() {
    check("https://example.com/issues", "ok https")
    check("HTTPS://Example.com/", "ok HTTPS")
    check("http://", "Expected authority|7")
    check("http:", "Expected scheme-specific part|5")
    check("http:/", "ok http")
    check("http:///x", "ok http")
    check("http://?q", "ok http")
    check("http://#f", "ok http")
    check("http:#f", "Expected scheme-specific part|5")
    check("https://exa mple.com/", "Illegal character in authority|11")
    check("https://example.com/a b", "Illegal character in path|21")
    check("https://example.com/a%2", "Malformed escape pair|21")
    check("https://example.com/a%zz", "Malformed escape pair|21")
    check("https://example.com/a%41", "ok https")
    check("https://example.com/a\"b", "Illegal character in path|21")
    check("https://example.com/a<b", "Illegal character in path|21")
    check("https://example.com/a>b", "Illegal character in path|21")
