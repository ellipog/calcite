/// Checks NBT paths as nbt.path reads them: each kind of step, where reading stops, the text a
/// path gives back, and each error with its place. The rig's `packs` probe checks paths in a
/// pack's enchantments against vanilla's `NbtPathArgument`.
module test.nbt_path

import chat.language.{Language}
import nbt.path.{Node, PathError, parse, read}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// Text of our own for the keys the errors here use, as the jar's en_us.json gives the server.
fn language() -> Language {
    var lang = Language.empty()
    lang.add(String("arguments.nbtpath.node.invalid"), String("bad step"))
    lang.add(String("parsing.expected"), String("wanted '%s'"))
    lang.add(String("parsing.int.expected"), String("wanted an int"))
    lang.add(String("parsing.int.invalid"), String("bad int '%s'"))
    lang.add(String("parsing.quote.escape"), String("bad escape '\\%s'"))
    lang.add(String("parsing.quote.expected.end"), String("unclosed"))
    lang.add(String("argument.literal.incorrect"), String("wanted %s"))
    return lang
}

// The path's steps and its text, or its error.
fn steps(text: String, lang: Language) -> String {
    let path = match parse(text) {
        ok(p) => p,
        err(PathError.Syntax(e)) => return e.text(lang),
        err(PathError.PastEnd(at)) => return "past the end at {at}",
    }
    var out = String()
    for node in path.nodes {
        if not out.is_empty() {
            out.push_str(" ")
        }
        let step = match node {
            Node.MatchRootObject(t) => "root{t.to_snbt()}",
            Node.CompoundChild(name) => "child({name})",
            Node.MatchObject(name, t) => "child({name}){t.to_snbt()}",
            Node.AllElements => String("all"),
            Node.IndexedElement(i) => "index({i})",
            Node.MatchElement(t) => "each{t.to_snbt()}",
        }
        out.push_str(step)
    }
    return "{out} = {path.original}"
}

fn kinds(lang: Language) {
    check(steps("foo", lang), "child(foo) = foo")
    check(steps("foo.bar[0]", lang), "child(foo) child(bar) index(0) = foo.bar[0]")
    check(steps("[0]", lang), "index(0) = [0]")
    check(steps("a[-1][]", lang), "child(a) index(-1) all = a[-1][]")
    check(steps("\{a:1b\}", lang), "root\{a:1b\} = \{a:1b\}")
    check(steps("\{a:1b\}.b", lang), "root\{a:1b\} child(b) = \{a:1b\}.b")
    check(steps("foo\{a:1b\}.bar", lang), "child(foo)\{a:1b\} child(bar) = foo\{a:1b\}.bar")
    check(steps("foo[\{a:1b\}]", lang), "child(foo) each\{a:1b\} = foo[\{a:1b\}]")
    check(steps("\"a b\".'c\\'d'", lang), "child(a b) child(c'd) = \"a b\".'c\\'d'")
    check(steps("x-y_z:w+", lang), "child(x-y_z:w+) = x-y_z:w+")
    // Reading stops at a space, and the path is what came before it. A `.` may end it.
    check(steps("a b", lang), "child(a) = a")
    check(steps("a.", lang), "child(a) = a.")
    check(steps("", lang), " = ")
    check(steps(" a", lang), " = ")
}

fn errors(lang: Language) {
    check(steps("a..b", lang), "bad step at position 2: a.<--[HERE]")
    check(steps("a.\{b:1\}", lang), "bad step at position 2: a.<--[HERE]")
    check(steps("\{a:1\}\{b:2\}", lang), "bad step at position 5: \{a:1\}<--[HERE]")
    check(steps("\"\"", lang), "bad step at position 2: \"\"<--[HERE]")
    check(steps("a]", lang), "wanted '.' at position 1: a<--[HERE]")
    check(steps("[0]x", lang), "wanted '.' at position 3: [0]<--[HERE]")
    check(steps("[x]", lang), "wanted an int at position 1: [<--[HERE]")
    check(steps("[[1]]", lang), "wanted an int at position 1: [<--[HERE]")
    check(steps("[1.5]", lang), "bad int '1.5' at position 1: [<--[HERE]")
    check(steps("[1", lang), "wanted ']' at position 2: [1<--[HERE]")
    check(steps("[1 ]", lang), "wanted ']' at position 2: [1<--[HERE]")
    check(steps("[\{a:1\}", lang), "wanted ']' at position 6: [\{a:1\}<--[HERE]")
    check(steps("\"abc", lang), "unclosed at position 4: \"abc<--[HERE]")
    check(steps("\"a\\x\"", lang), "bad escape '\\x' at position 3: \"a\\<--[HERE]")
    // A pattern's errors are SNBT's, placed in the whole path.
    check(steps("abc\{a:1", lang), "wanted . at position 7: abc\{a:1<--[HERE]")
    // Brigadier's `peek` past the end throws.
    check(steps("[", lang), "past the end at 1")
    check(steps("a[", lang), "past the end at 2")
}

// A path read from the middle of a command, as `/data` will read one.
fn within() {
    match read(String("get a.b[0] rest"), 4) {
        ok((path, end)) => check("{path.original} {end} {path.nodes.len()}", "a.b[0] 10 3"),
        err(_) => panic("a.b[0] didn't read"),
    }
}

fn main() {
    let lang = language()
    kinds(lang)
    errors(lang)
    within()
    println("ok")
}
