/// Checks NBT paths as nbt.path reads them: each kind of step, where reading stops, the text a
/// path gives back, and each error with its place. The rig's `packs` probe checks paths in a
/// pack's enchantments against vanilla's `NbtPathArgument`.
module test.nbt_path

import chat.component.{Component, Contents}
import chat.language.{Language}
import nbt.path.{Node, NbtPath, PathError, PathFailure, parse, read}
import nbt.pretty.{pretty}
import nbt.snbt.{parse as parse_snbt}
import nbt.tag.{Tag}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// Text of our own for the keys the errors here use, as the jar's en_us.json gives the server.
fn language() -> Language {
    var lang = Language.empty()
    lang.add(String("arguments.nbtpath.node.invalid"), String("bad step"))
    lang.add(String("parsing.expected"), String("wanted '%s'"))
    lang.add(String("parsing.int.expected"), String("wanted an int"))
    lang.add(String("parsing.int.invalid"), String("bad int '%s'"))
    lang.add(String("parsing.quote.escape"), String("bad escape '\\%s'"))
    lang.add(String("parsing.quote.expected.end"), String("unclosed"))
    lang.add(String("argument.literal.incorrect"), String("wanted %s"))
    return lang
}

// The path's steps and its text, or its error.
fn steps(text: String, lang: Language) -> String {
    let path = match parse(text) {
        ok(p) => p,
        err(PathError.Syntax(e)) => return e.text(lang),
        err(PathError.PastEnd(at)) => return "past the end at {at}",
    }
    var out = String()
    for node in path.nodes {
        if not out.is_empty() {
            out.push_str(" ")
        }
        let step = match node {
            Node.MatchRootObject(t) => "root{t.to_snbt()}",
            Node.CompoundChild(name) => "child({name})",
            Node.MatchObject(name, t) => "child({name}){t.to_snbt()}",
            Node.AllElements => String("all"),
            Node.IndexedElement(i) => "index({i})",
            Node.MatchElement(t) => "each{t.to_snbt()}",
        }
        out.push_str(step)
    }
    return "{out} = {path.original}"
}

fn kinds(lang: Language) {
    check(steps("foo", lang), "child(foo) = foo")
    check(steps("foo.bar[0]", lang), "child(foo) child(bar) index(0) = foo.bar[0]")
    check(steps("[0]", lang), "index(0) = [0]")
    check(steps("a[-1][]", lang), "child(a) index(-1) all = a[-1][]")
    check(steps("\{a:1b\}", lang), "root\{a:1b\} = \{a:1b\}")
    check(steps("\{a:1b\}.b", lang), "root\{a:1b\} child(b) = \{a:1b\}.b")
    check(steps("foo\{a:1b\}.bar", lang), "child(foo)\{a:1b\} child(bar) = foo\{a:1b\}.bar")
    check(steps("foo[\{a:1b\}]", lang), "child(foo) each\{a:1b\} = foo[\{a:1b\}]")
    check(steps("\"a b\".'c\\'d'", lang), "child(a b) child(c'd) = \"a b\".'c\\'d'")
    check(steps("x-y_z:w+", lang), "child(x-y_z:w+) = x-y_z:w+")
    // Reading stops at a space, and the path is what came before it. A `.` may end it.
    check(steps("a b", lang), "child(a) = a")
    check(steps("a.", lang), "child(a) = a.")
    check(steps("", lang), " = ")
    check(steps(" a", lang), " = ")
}

fn errors(lang: Language) {
    check(steps("a..b", lang), "bad step at position 2: a.<--[HERE]")
    check(steps("a.\{b:1\}", lang), "bad step at position 2: a.<--[HERE]")
    check(steps("\{a:1\}\{b:2\}", lang), "bad step at position 5: \{a:1\}<--[HERE]")
    check(steps("\"\"", lang), "bad step at position 2: \"\"<--[HERE]")
    check(steps("a]", lang), "wanted '.' at position 1: a<--[HERE]")
    check(steps("[0]x", lang), "wanted '.' at position 3: [0]<--[HERE]")
    check(steps("[x]", lang), "wanted an int at position 1: [<--[HERE]")
    check(steps("[[1]]", lang), "wanted an int at position 1: [<--[HERE]")
    check(steps("[1.5]", lang), "bad int '1.5' at position 1: [<--[HERE]")
    check(steps("[1", lang), "wanted ']' at position 2: [1<--[HERE]")
    check(steps("[1 ]", lang), "wanted ']' at position 2: [1<--[HERE]")
    check(steps("[\{a:1\}", lang), "wanted ']' at position 6: [\{a:1\}<--[HERE]")
    check(steps("\"abc", lang), "unclosed at position 4: \"abc<--[HERE]")
    check(steps("\"a\\x\"", lang), "bad escape '\\x' at position 3: \"a\\<--[HERE]")
    // A pattern's errors are SNBT's, placed in the whole path.
    check(steps("abc\{a:1", lang), "wanted . at position 7: abc\{a:1<--[HERE]")
    // Brigadier's `peek` past the end throws.
    check(steps("[", lang), "past the end at 1")
    check(steps("a[", lang), "past the end at 2")
}

// A path read from the middle of a command, as `/data` will read one.
fn within() {
    match read(String("get a.b[0] rest"), 4) {
        ok((path, end)) => check("{path.original} {end} {path.nodes.len()}", "a.b[0] 10 3"),
        err(_) => panic("a.b[0] didn't read"),
    }
}

fn tag_of(text: str) -> Tag {
    return match parse_snbt(String(text)) {
        ok(t) => t,
        err(_) => panic("{text} isn't SNBT"),
    }
}

fn path_of(text: str) -> NbtPath {
    return match parse(String(text)) {
        ok(p) => p,
        err(_) => panic("{text} isn't a path"),
    }
}

fn failure(f: PathFailure) -> String {
    return match f {
        PathFailure.NothingFound(p) => "nothing at {p}",
        PathFailure.TooDeep => String("too deep"),
        PathFailure.ExpectedList(t) => "not a list: {t.to_snbt()}",
        PathFailure.ExpectedObject(t) => "not a compound: {t.to_snbt()}",
        PathFailure.InvalidIndex(i) => "bad index {i}",
        PathFailure.Unexpected(m) => "unexpected: {m}",
    }
}

// What `path` finds in `data`, each as SNBT, or why nothing.
fn found(path: str, data: str) -> String {
    return match path_of(path).get(tag_of(data)) {
        ok(tags) => {
            var out = String()
            for t in tags {
                if not out.is_empty() {
                    out.push_str(" ")
                }
                out.push_str(t.to_snbt())
            }
            out
        },
        err(f) => failure(f),
    }
}

// How many a change changed, or why it failed, and the data after it, which keeps what was made
// on the way where it fails.
fn after(n: i32?, f: PathFailure?, data: Tag) -> String {
    if let why = f {
        return "{failure(why)}; {data.to_snbt()}"
    }
    return "{n ?? 0} {data.to_snbt()}"
}

fn setting(path: str, data: str, value: str) -> String {
    var t = tag_of(data)
    return match path_of(path).set(mut t, tag_of(value)) {
        ok(n) => after(some(n), none, t),
        err(f) => after(none, some(f), t),
    }
}

fn inserting(path: str, index: i32, data: str, value: str) -> String {
    var t = tag_of(data)
    return match path_of(path).insert(index, mut t, [tag_of(value)]) {
        ok(n) => after(some(n), none, t),
        err(f) => after(none, some(f), t),
    }
}

fn merging(path: str, data: str, from: str) -> String {
    var t = tag_of(data)
    let m = match tag_of(from) {
        Tag.Compound(x) => x.copy(),
        _ => panic("{from} isn't a compound"),
    }
    return match path_of(path).merge(mut t, m) {
        ok(n) => after(some(n), none, t),
        err(f) => after(none, some(f), t),
    }
}

fn removing(path: str, data: str) -> String {
    var t = tag_of(data)
    return match path_of(path).remove(mut t) {
        ok(n) => after(some(n), none, t),
        err(f) => after(none, some(f), t),
    }
}

// Finding, as `NbtPath.get` and `countMatching` find, and where nothing's found.
fn finding() {
    check(found("a.b", "\{a:\{b:1\}\}"), "1")
    check(found("a[]", "\{a:[1,2]\}"), "1 2")
    check(found("a[-1]", "\{a:[1,2,3]\}"), "3")
    check(found("a[]", "\{a:[I;4,5]\}"), "4 5")
    check(found("a[\{x:1\}]", "\{a:[\{x:1,y:2\},\{x:2\}]\}"), "\{x:1,y:2\}")
    check(found("\{x:1\}", "\{x:1,y:2\}"), "\{x:1,y:2\}")
    check(found("a\{p:[1]\}", "\{a:\{p:[3,1]\}\}"), "\{p:[3,1]\}")
    check(found("a\{p:[]\}", "\{a:\{p:[3]\}\}"), "nothing at a\{p:[]\}")
    check(found("a.c", "\{a:\{b:1\}\}"), "nothing at a.c")
    check(found("a[].b", "\{a:[1,2]\}"), "nothing at a[].b")
    // Every `[]` is one step in vanilla's map of where steps end, so the first names the last's.
    check(found("x[].y[]", "\{x:[]\}"), "nothing at x[].y[]")
    check(found("x[0].y[]", "\{x:[]\}"), "nothing at x[0]")
    if path_of("a[]").count_matching(tag_of("\{a:[1,2,3]\}")) != 3 {
        panic("a[] should count 3")
    }
}

// Changes, as `set`, `insert`, `DataCommands`' merge and `remove` make them.
fn changing() {
    check(setting("a.b", "\{\}", "1"), "1 \{a:\{b:1\}\}")
    check(setting("a.b", "\{a:\{b:1\}\}", "1"), "0 \{a:\{b:1\}\}")
    check(setting("a[]", "\{a:[1,2,1]\}", "1"), "1 \{a:[1,1,1]\}")
    check(setting("a[]", "\{a:[]\}", "1"), "1 \{a:[1]\}")
    check(setting("a[0]", "\{a:[]\}", "1"), "0 \{a:[]\}")
    check(setting("a[0].b", "\{\}", "1"), "nothing at a[0]; \{a:[]\}")
    check(setting("a.b.c", "\{a:1\}", "1"), "nothing at a.b; \{a:1\}")
    check(setting("\{x:1\}.y", "\{x:1\}", "2"), "1 \{x:1,y:2\}")
    check(setting("\{x:2\}.y", "\{x:1\}", "2"), "nothing at \{x:2\}; \{x:1\}")
    check(setting("a[\{k:1\}].v", "\{a:[]\}", "5"), "1 \{a:[\{k:1,v:5\}]\}")
    check(setting("a\{k:1\}.v", "\{\}", "5"), "1 \{a:\{k:1,v:5\}\}")
    check(setting("b[]", "\{b:[B;1B,2B]\}", "3b"), "2 \{b:[B;3B,3B]\}")
    check(setting("b[]", "\{b:[B;1B,2B]\}", "\"s\""), "0 \{b:[B;]\}")
    check(setting("b[1]", "\{b:[I;1,2]\}", "7L"), "1 \{b:[I;1,7]\}")
    check(inserting("a", 0, "\{a:[1]\}", "5"), "1 \{a:[5,1]\}")
    check(inserting("a", -1, "\{a:[1]\}", "5"), "1 \{a:[1,5]\}")
    check(inserting("a", 5, "\{a:[1]\}", "5"), "bad index 5; \{a:[1]\}")
    check(inserting("a", -3, "\{a:[1]\}", "5"), "bad index -1; \{a:[1]\}")
    check(inserting("b", 0, "\{b:1\}", "5"), "not a list: 1; \{b:1\}")
    check(inserting("n", -1, "\{\}", "5"), "1 \{n:[5]\}")
    check(inserting("b", -1, "\{b:[B;1B]\}", "\"x\""), "0 \{b:[B;1B]\}")
    check(inserting("b", 9, "\{b:[B;1B]\}", "\"x\""), "0 \{b:[B;1B]\}")
    check(inserting("b", -1, "\{b:[B;1B]\}", "300"), "1 \{b:[B;1B,44B]\}")
    check(merging("a", "\{a:\{y:2\}\}", "\{x:1\}"), "1 \{a:\{x:1,y:2\}\}")
    check(merging("a", "\{a:\{x:1\}\}", "\{x:1\}"), "0 \{a:\{x:1\}\}")
    check(merging("a", "\{a:5\}", "\{x:1\}"), "not a compound: 5; \{a:5\}")
    check(merging("n", "\{\}", "\{x:1\}"), "1 \{n:\{x:1\}\}")
    check(merging("n", "\{\}", "\{\}"), "0 \{n:\{\}\}")
    check(merging("a", "\{a:\{d:\{p:1\}\}\}", "\{d:\{q:2\}\}"), "1 \{a:\{d:\{p:1,q:2\}\}\}")
    check(removing("a[]", "\{a:[1,2]\}"), "2 \{a:[]\}")
    check(removing("a[\{x:1\}]", "\{a:[\{x:1\},\{x:2\},\{x:1\}]\}"), "2 \{a:[\{x:2\}]\}")
    check(removing("a.b", "\{\}"), "0 \{\}")
    check(removing("a[-1]", "\{a:[L;1L,2L]\}"), "1 \{a:[L;1L]\}")
    // What's put may be no more than 512 deep, counting the path's steps.
    var deep = Tag.Int(0)
    for _ in 0..511 {
        deep = Tag.List([deep])
    }
    var t = tag_of("\{\}")
    let deep_set = match path_of("a").set(mut t, deep) {
        ok(n) => after(some(n), none, t),
        err(f) => after(none, some(f), t),
    }
    check(deep_set, "too deep; \{\}")
    // A path of no steps has no last step, and vanilla throws looking for it.
    check(setting("", "\{\}", "1"), "unexpected: Index -1 out of bounds for length 0; \{\}")
}

// A component's text, each colored piece as `color(text)`.
fn shown(c: Component) -> String {
    var out = String()
    match c.contents {
        Contents.Text(t) => {
            if let color = c.style.color {
                out.push_str("{color.name.copy() ?? String()}({t})")
            } else {
                out.push_str(t)
            }
        },
        _ => out.push_str("?"),
    }
    for e in c.extra {
        out.push_str(shown(e))
    }
    return out
}

// NBT as `toPrettyComponent` shows it.
fn printing() {
    check(shown(pretty(tag_of("\{a:1b\}"))), "\{aqua(a): gold(1)red(b)\}")
    check(shown(pretty(tag_of("[1,2]"))), "[gold(1), gold(2)]")
    check(shown(pretty(tag_of("[\"x\",3s]"))), "[\"green(x)\", gold(3)red(s)]")
    check(shown(pretty(tag_of("[I;1,2]"))), "[red(I); gold(1), gold(2)]")
    check(shown(pretty(tag_of("\{\"a b\":1.5d\}"))), "\{\"aqua(a b)\": gold(1.5)red(d)\}")
    check(shown(pretty(tag_of("\{s:'say \"hi\"'\}"))), "\{aqua(s): 'green(say \"hi\")'\}")
    check(shown(pretty(tag_of("\{\}"))), "\{\}")
    check(shown(pretty(tag_of("[L;5L]"))), "[red(L); gold(5)red(L)]")
    check(shown(pretty(tag_of("1.0E10f"))), "gold(1.0E10)red(f)")
    // Each entry of a compound starts with an empty piece, where an indentation would go.
    if pretty(tag_of("\{a:1b\}")).extra.len() != 8 {
        panic("a compound of one entry should be 8 pieces")
    }
}

fn main() {
    let lang = language()
    kinds(lang)
    errors(lang)
    within()
    finding()
    changing()
    printing()
    println("ok")
}
