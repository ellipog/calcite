/// Tests of `world.beacon` (D520): the effect a beacon gives, for its levels and amplifier, and
/// none for what isn't an effect; and a beacon's block entity as it's loaded, its levels 0, and
/// others' as they were.
module test.beacon

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import world.beacon.{beacon_effect, loaded_beacon}
import world.effects.{effect_id}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

fn main() {
    // `new MobEffectInstance(power, (9 + levels * 2) * 20, amplifier, true, true)`: 11 seconds at
    // one level, 17 at four, ambient, its particles and icon shown.
    let speed = beacon_effect(String("minecraft:speed"), 1, 0)!
    check("{speed.id == effect_id(String("minecraft:speed"))!} {speed.duration()} {speed.amplifier()}", "true 220 0", "a beacon of one level's speed")
    let haste = beacon_effect(String("minecraft:haste"), 4, 1)!
    check("{haste.duration()} {haste.amplifier()}", "340 1", "a beacon of four levels' haste II")
    check("{beacon_effect(String("minecraft:nothing"), 1, 0) == none}", "true", "what isn't an effect")

    // `Levels` is saved but not loaded, so a beacon's 0 till its base is next read.
    let beacon = loaded_beacon(snbt("\{id:\"minecraft:beacon\",Levels:3,primary_effect:\"minecraft:speed\",x:3,y:-60,z:3\}"))
    check("{beacon}", "{snbt("\{id:\"minecraft:beacon\",Levels:0,primary_effect:\"minecraft:speed\",x:3,y:-60,z:3\}")}", "a beacon loaded")
    let without = loaded_beacon(snbt("\{id:\"minecraft:beacon\",x:3,y:-60,z:3\}"))
    check("{without}", "{snbt("\{id:\"minecraft:beacon\",x:3,y:-60,z:3\}")}", "a beacon saved without its levels")
    let chest = loaded_beacon(snbt("\{id:\"minecraft:chest\",Levels:3,x:3,y:-60,z:3\}"))
    check("{chest}", "{snbt("\{id:\"minecraft:chest\",Levels:3,x:3,y:-60,z:3\}")}", "a chest, as it was")
    println("ok")
}
