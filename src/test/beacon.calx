/// Tests of `world.beacon` (D520): the effect a beacon gives, for its levels and amplifier, and
/// none for what isn't an effect; a beacon's block entity as it's loaded, its levels 0, and
/// others' as they were; and its menu's data and the effects it may pick (D521).
module test.beacon

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import world.beacon.{beacon_data, beacon_effect, loaded_beacon, valid_effects}
import world.effects.{effect_id}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

fn main() {
    // `new MobEffectInstance(power, (9 + levels * 2) * 20, amplifier, true, true)`: 11 seconds at
    // one level, 17 at four, ambient, its particles and icon shown.
    let speed = beacon_effect(String("minecraft:speed"), 1, 0)!
    check("{speed.id == effect_id(String("minecraft:speed"))!} {speed.duration()} {speed.amplifier()}", "true 220 0", "a beacon of one level's speed")
    let haste = beacon_effect(String("minecraft:haste"), 4, 1)!
    check("{haste.duration()} {haste.amplifier()}", "340 1", "a beacon of four levels' haste II")
    check("{beacon_effect(String("minecraft:nothing"), 1, 0) == none}", "true", "what isn't an effect")

    // `Levels` is saved but not loaded, so a beacon's 0 till its base is next read.
    let beacon = loaded_beacon(snbt("\{id:\"minecraft:beacon\",Levels:3,primary_effect:\"minecraft:speed\",x:3,y:-60,z:3\}"))
    check("{beacon}", "{snbt("\{id:\"minecraft:beacon\",Levels:0,primary_effect:\"minecraft:speed\",x:3,y:-60,z:3\}")}", "a beacon loaded")
    let without = loaded_beacon(snbt("\{id:\"minecraft:beacon\",x:3,y:-60,z:3\}"))
    check("{without}", "{snbt("\{id:\"minecraft:beacon\",x:3,y:-60,z:3\}")}", "a beacon saved without its levels")
    let chest = loaded_beacon(snbt("\{id:\"minecraft:chest\",Levels:3,x:3,y:-60,z:3\}"))
    check("{chest}", "{snbt("\{id:\"minecraft:chest\",Levels:3,x:3,y:-60,z:3\}")}", "a chest, as it was")

    // `dataAccess`: its levels, then each effect's ID and 1 more, 0 for none; an effect that's no
    // beacon's is none, as `loadEffect` filters it.
    let saved = snbt("\{id:\"minecraft:beacon\",primary_effect:\"minecraft:speed\",secondary_effect:\"minecraft:night_vision\"\}")
    let data = beacon_data(2, some(saved))
    check("{data[0]} {data[1] == effect_id(String("minecraft:speed"))! + 1} {data[2]}", "2 true 0", "a beacon's menu's data")
    check("{beacon_data(0, none)[1]}", "0", "a beacon's menu's data without its block entity")

    // `validateEffects`.
    let s = String("minecraft:speed")
    let r = String("minecraft:regeneration")
    let st = String("minecraft:strength")
    let none_picked = String()
    check("{valid_effects(s.copy(), none_picked.copy(), 1)} {valid_effects(none_picked.copy(), none_picked.copy(), 0)}", "true true", "speed at one level, and nothing")
    check("{valid_effects(st.copy(), none_picked.copy(), 2)} {valid_effects(st.copy(), none_picked.copy(), 3)}", "false true", "strength takes three levels")
    check("{valid_effects(s.copy(), r.copy(), 3)} {valid_effects(s.copy(), r.copy(), 4)} {valid_effects(s.copy(), s.copy(), 4)}", "false true true", "a secondary takes four levels: regeneration, or the primary again")
    check("{valid_effects(s.copy(), st.copy(), 4)} {valid_effects(r.copy(), none_picked.copy(), 4)}", "false false", "a secondary of another tier, and regeneration as the primary")
    check("{valid_effects(String("minecraft:night_vision"), none_picked.copy(), 4)} {valid_effects(none_picked.copy(), s.copy(), 4)}", "false false", "an effect that's no beacon's, and a secondary with no primary")
    println("ok")
}
