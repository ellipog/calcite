/// Checks the blocks that take water up or melt into it in the server's level (CAL-127), on a flat
/// level whose chunks tick, with block facts made from the built-in block and fluid registries: a
/// sponge taking up the water around it, flowing, waterlogged and kelp too, and no more than 65
/// blocks of a lake; a wet sponge drying where water evaporates; and frosted ice aging to water as
/// it ticks, and melting as frosted ice beside it goes with no other there.
module test.water_blocks

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Heard, Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// A flat level, its spawn's chunks full and given the facts, with a player's ticket at its
// middle, so its chunks tick, and nobody standing in it.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn block_of(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => b,
        err(_) => panic("no block {name}"),
    }
}

fn named(f: Facts, name: str) -> u32 {
    return f.default_state(block_of(f, name))
}

fn with(f: Facts, state: u32, prop: str, value: str) -> u32 {
    return match f.with_name(state, String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("no {prop} {value}"),
    }
}

// Runs `ticks` of the level's ticks: its block and fluid ticks, then its block events, then its
// block entities.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.handling = true
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
        level.run_block_events()
        level.handling = false
        level.tick_block_entities()
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn flag(f: Facts, level: Level, x: i32, y: i32, z: i32, prop: str) -> bool {
    return f.get_bool(level.spawn_state(x, y, z), String(prop))
}

fn number(f: Facts, level: Level, x: i32, y: i32, z: i32, prop: str) -> i32 {
    return f.get_int(level.spawn_state(x, y, z), String(prop)) ?? -1
}

fn is(f: Facts, level: Level, x: i32, y: i32, z: i32, name: str) -> bool {
    return f.block(level.spawn_state(x, y, z)) == block_of(f, name)
}

// The sounds heard since they were last taken, each with its pitch and volume, and the level
// events' types.
struct Sounds {
    names: List<String>
    pitches: List<f32>
    volumes: List<f32>
    events: List<i32>
}

fn heard(level: mut Level) -> Sounds {
    var out = Sounds { names: List<String>(), pitches: List<f32>(), volumes: List<f32>(), events: List<i32>() }
    for h in level.take_heard() {
        match h {
            Heard.Sound(s) => {
                out.names.push(s.sound.copy())
                out.pitches.push(s.pitch)
                out.volumes.push(s.volume)
            },
            Heard.Event(e) => out.events.push(e.kind),
            _ => {},
        }
    }
    return out
}

// What the level reported isn't in Calcite yet, one line each.
fn quiet(level: mut Level, what: str) {
    quiet_but(mut level, what, "")
}

// As `quiet`, but for lines with `but` in them, where it isn't empty.
fn quiet_but(level: mut Level, what: str, but: str) {
    var out = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") and (but.is_empty() or not e.message.contains(but)) {
            out = "{out}{e.message}; "
        }
    }
    if not out.is_empty() {
        panic("{what} reported {out}")
    }
}

// A sponge set in a pool of 24 water sources, one of them flowing, one an oak slab holding water
// and one kelp, takes them all up, the kelp's drops reported, and turns wet with its sound. The
// first water it takes tells it, beside it, that it changed, and with no updates running that
// runs at once, `neighborChanged`, a second search inside the first, which takes the rest and
// turns it wet with its sound; then the first, having taken one, does it again.
fn sponge() {
    let f = facts()
    var level = flat_level(f)
    let water = named(f, "water")
    for x in 4..9 {
        for z in 4..9 {
            if x != 6 or z != 6 {
                set(mut level, x, -60, z, water, "the water wasn't set")
            }
        }
    }
    set(mut level, 4, -60, 4, with(f, water, "level", "3"), "the flowing water wasn't set")
    set(mut level, 8, -60, 8, with(f, with(f, named(f, "oak_slab"), "waterlogged", "true"), "type", "bottom"), "the slab wasn't set")
    set(mut level, 4, -60, 8, named(f, "kelp"), "the kelp wasn't set")
    _ = heard(mut level)
    set(mut level, 6, -60, 6, named(f, "sponge"), "the sponge wasn't set")
    check(is(f, level, 6, -60, 6, "wet_sponge"), "the sponge isn't wet")
    for x in 4..9 {
        for z in 4..9 {
            if (x != 6 or z != 6) and (x != 8 or z != 8) {
                if not is(f, level, x, -60, z, "air") {
                    panic("water was left at {x} {z}")
                }
            }
        }
    }
    check(is(f, level, 8, -60, 8, "oak_slab") and not flag(f, level, 8, -60, 8, "waterlogged"), "the slab still holds water")
    let sounds = heard(mut level)
    if sounds.names.len() != 2 or sounds.names[0] != "block.sponge.absorb" or sounds.names[1] != "block.sponge.absorb" {
        var all = String("")
        for n in sounds.names {
            all = "{all}{n} "
        }
        panic("the sponge's sound: {all}")
    }
    quiet_but(mut level, "a sponge", "What a broken block drops")
    println("ok sponge")
}

// A sponge set in the middle of a lake 13 by 13 takes up 65 blocks of it: the first, which runs a
// second search inside it, `neighborChanged`, and the 64 that takes, as many as one search takes,
// itself among them; the first search finds nothing more by what it took.
fn sponge_most() {
    let f = facts()
    var level = flat_level(f)
    let water = named(f, "water")
    for x in 0..13 {
        for z in 0..13 {
            set(mut level, x, -60, z, water, "the lake wasn't set")
        }
    }
    set(mut level, 6, -60, 6, named(f, "sponge"), "the sponge wasn't set")
    check(is(f, level, 6, -60, 6, "wet_sponge"), "the sponge isn't wet")
    var taken = 0
    for x in 0..13 {
        for z in 0..13 {
            if is(f, level, x, -60, z, "air") {
                taken += 1
            }
        }
    }
    if taken != 65 {
        panic("the sponge took {taken}, not 65")
    }
    quiet(mut level, "a sponge in a lake")
    println("ok sponge_most")
}

// A wet sponge set where water evaporates dries at once, with event 2009 and its sound at a pitch
// of 0.7 to 0.84; where it doesn't, it stays wet.
fn wet_sponge() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 4, named(f, "wet_sponge"), "the wet sponge wasn't set")
    check(is(f, level, 4, -60, 4, "wet_sponge"), "the wet sponge dried")
    _ = heard(mut level)
    level.place.evaporates = true
    set(mut level, 6, -60, 4, named(f, "wet_sponge"), "the second wet sponge wasn't set")
    check(is(f, level, 6, -60, 4, "sponge"), "the wet sponge didn't dry")
    let dried = heard(mut level)
    check(dried.events.len() == 1 and dried.events[0] == 2009, "the drying event")
    check(dried.names.len() == 1 and dried.names[0] == "block.wet_sponge.dries", "the drying sound")
    check(dried.pitches[0] >= 0.7f32 and dried.pitches[0] <= 0.84f32, "the drying sound's pitch")
    quiet(mut level, "a wet sponge")
    println("ok wet_sponge")
}

// Frosted ice alone in daylight ages as it ticks, 60 to 120 ticks after each step, and at age 3
// melts into water. Frosted ice set beside another leaves it be, the blocks around told of the air
// it replaced; taken away, they're told of frosted ice, and the other, with none left by it, melts
// at once.
fn frosted_ice() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 12, named(f, "frosted_ice"), "the ice wasn't set")
    run(mut level, 59)
    check(number(f, level, 4, -60, 12, "age") == 0, "the ice aged early")
    var ticks = 59
    while ticks < 600 and is(f, level, 4, -60, 12, "frosted_ice") {
        run(mut level, 1)
        ticks += 1
    }
    check(is(f, level, 4, -60, 12, "water"), "the ice didn't melt in 600 ticks")
    if ticks < 240 {
        panic("the ice melted in {ticks} ticks, before four steps could")
    }
    set(mut level, 8, -60, 24, named(f, "frosted_ice"), "the first ice wasn't set")
    set(mut level, 9, -60, 24, named(f, "frosted_ice"), "the second ice wasn't set")
    check(is(f, level, 8, -60, 24, "frosted_ice") and is(f, level, 9, -60, 24, "frosted_ice"), "ice set beside ice melted it")
    set(mut level, 9, -60, 24, named(f, "air"), "the second ice wasn't taken away")
    check(is(f, level, 8, -60, 24, "water"), "the first ice didn't melt as the second was taken away")
    quiet(mut level, "frosted ice")
    println("ok frosted_ice")
}

fn main() {
    sponge()
    sponge_most()
    wet_sponge()
    frosted_ice()
}
