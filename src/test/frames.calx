/// Checks frames: lengths of 1 to 3 bytes, frames that arrive a byte at a time, and the errors
/// vanilla's `Varint21FrameDecoder` and `Varint21LengthFieldPrepender` give.
module test.frames

import protocol.frame.{FrameReader, MAX_FRAME, frame}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn filled(n: usize) -> List<u8> {
    var out = List<u8>()
    for i in 0..n {
        out.push(u8.wrap(i))
    }
    return out
}

fn header(n: usize) -> String {
    let f = frame(filled(n))!
    var out = List<u8>()
    for i in 0..f.len() - n {
        out.push(f[i])
    }
    return "{out}"
}

fn main() {
    // The length is a VarInt of at most 3 bytes.
    check(header(1), "[1]")
    check(header(127), "[127]")
    check(header(128), "[128, 1]")
    check(header(16384), "[128, 128, 1]")
    check(header(MAX_FRAME), "[255, 255, 127]")
    match frame(filled(MAX_FRAME + 1)) {
        ok(_) => panic("a frame too long was written"),
        err(e) => check(e, "Packet too large: size 2097152 is over 8"),
    }

    // Two frames, a byte at a time: each is whole only once its last byte arrives.
    var stream = frame([7, 8, 9])!
    for b in frame(filled(300))! {
        stream.push(b)
    }
    var frames = FrameReader.new()
    var got = List<String>()
    for b in stream {
        frames.push([b])
        loop {
            let body = frames.next()! else break
            got.push("{body.len()}:{body[0]}:{body[body.len() - 1]}")
        }
    }
    check("{got} {frames.waiting()}", "[3:7:9, 300:0:43] 0")

    // A length of 0, or one whose third byte goes on, breaks the connection.
    var zero = FrameReader.new()
    zero.push([0])
    match zero.next() {
        ok(_) => panic("a frame of no bytes was read"),
        err(e) => check(e.message, "Frame length cannot be zero"),
    }
    var wide = FrameReader.new()
    wide.push([0x80, 0x80])
    check("{wide.next()! == none}", "true")
    wide.push([0x80])
    match wide.next() {
        ok(_) => panic("a 4-byte length was read"),
        err(e) => check(e.message, "length wider than 21-bit"),
    }
    println("ok")
}
