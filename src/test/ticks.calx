/// Checks `world.ticks` (D322): scheduled ticks drained in vanilla's order, worked out by hand
/// from `LevelTicks.collectTicks`, those a chunk was saved with scheduled as it ticks and saved
/// again, one tick a block and kind, and the limit on a tick's ticks. Ties between chunks, which
/// fastutil's table decides, are the `ticks` probe's.
module test.ticks

import storage.chunk.{SavedTick}
import world.pos.{ChunkPos}
import world.ticks.{ChunkTicks, LevelTicks, ScheduledTick}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn tick(kind: u32, x: i32, z: i32, trigger: i64, priority: i32, sub: i64) -> ScheduledTick {
    return ScheduledTick { kind: kind, x: x, y: 64, z: z, trigger: trigger, priority: priority, sub: sub }
}

fn chunk(x: i32, z: i32) -> i64 {
    return ChunkPos { x: x, z: z }.pack()
}

// The ticks, as `kind@x,z`.
fn shown(ticks: List<ScheduledTick>) -> String {
    var out = String()
    for t in ticks {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str("{t.kind}@{t.x},{t.z}")
    }
    return out
}

fn saved_shown(ticks: List<SavedTick>) -> String {
    var out = String()
    for t in ticks {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str("{t.kind}@{t.x},{t.z}+{t.delay}/{t.priority}")
    }
    return out
}

fn level_of(chunks: List<i64>) -> LevelTicks {
    var level = LevelTicks.new()
    for k in chunks {
        level.add_container(k, ChunkTicks.new())
    }
    return level
}

fn all(chunks: List<i64>) -> OpenHashSet<i64> {
    var out = OpenHashSet<i64>()
    for k in chunks {
        out.insert(k)
    }
    return out
}

// One chunk's ticks go by time, then priority, then the order they were scheduled in; those not
// due wait.
fn one_chunk() {
    let a = chunk(0, 0)
    var level = level_of([a])
    _ = level.schedule(tick(1, 1, 1, 12, 0, 0))
    _ = level.schedule(tick(2, 2, 1, 10, 0, 1))
    _ = level.schedule(tick(3, 3, 1, 10, -1, 2))
    _ = level.schedule(tick(4, 4, 1, 10, 0, 3))
    _ = level.schedule(tick(5, 5, 1, 11, 2, 4))
    check(shown(level.collect(9, 65536, all([a]))), "")
    check(shown(level.collect(10, 65536, all([a]))), "3@3,1 2@2,1 4@4,1")
    check(shown(level.collect(12, 65536, all([a]))), "5@5,1 1@1,1")
    check("{level.count()}", "0")
}

// Two chunks' ticks due in the same tick interleave by priority and order: a chunk gives its
// ticks until its next comes after the other's first.
fn two_chunks() {
    let a = chunk(0, 0)
    let b = chunk(1, 0)
    var level = level_of([a, b])
    _ = level.schedule(tick(1, 1, 1, 5, 0, 1))
    _ = level.schedule(tick(3, 2, 1, 5, 0, 3))
    _ = level.schedule(tick(2, 17, 1, 5, 0, 2))
    _ = level.schedule(tick(4, 18, 1, 5, 0, 4))
    _ = level.schedule(tick(5, 3, 1, 5, 0, 5))
    _ = level.schedule(tick(9, 19, 1, 6, -3, 0))
    check(shown(level.collect(5, 65536, all([a, b]))), "1@1,1 2@17,1 3@2,1 4@18,1 5@3,1")
    // A higher priority goes first wherever its chunk is.
    _ = level.schedule(tick(6, 4, 1, 6, 1, 6))
    _ = level.schedule(tick(7, 5, 1, 6, -1, 7))
    check(shown(level.collect(6, 65536, all([a, b]))), "9@19,1 7@5,1 6@4,1")
}

// A chunk that doesn't tick keeps its ticks, due, until it does.
fn not_ticking() {
    let a = chunk(0, 0)
    let b = chunk(-1, 0)
    var level = level_of([a, b])
    _ = level.schedule(tick(1, 1, 1, 3, 0, 0))
    _ = level.schedule(tick(2, -1, 1, 3, 0, 1))
    check(shown(level.collect(3, 65536, all([a]))), "1@1,1")
    check("{level.due(4)}", "[{b}]")
    check(shown(level.collect(4, 65536, all([a]))), "")
    check(shown(level.collect(5, 65536, all([a, b]))), "2@-1,1")
}

// A tick's ticks stop at the limit, and the rest run the next tick, first.
fn limit() {
    let a = chunk(0, 0)
    let b = chunk(0, 1)
    var level = level_of([a, b])
    for i in 0..4 {
        _ = level.schedule(tick(1, i, 1, 2, 0, i64(i * 2)))
        _ = level.schedule(tick(2, i, 17, 2, 0, i64(i * 2 + 1)))
    }
    _ = level.schedule(tick(3, 9, 1, 3, -3, 100))
    check(shown(level.collect(2, 3, all([a, b]))), "1@0,1 2@0,17 1@1,1")
    // Those left from the last tick come first in their chunk, being due earlier, and the
    // chunks still go by their first ticks' priorities and orders.
    check(shown(level.collect(3, 4, all([a, b]))), "2@1,17 1@2,1 2@2,17 1@3,1")
    check(shown(level.collect(3, 65536, all([a, b]))), "3@9,1 2@3,17")
}

// A block has one tick of a kind at a time, those saved too, and one taken out frees it.
fn one_a_block() {
    let a = chunk(0, 0)
    var level = LevelTicks.new()
    check("{level.schedule(tick(1, 1, 1, 4, 0, 0))}", "false")
    level.add_container(a, ChunkTicks.saved([SavedTick { kind: 1, x: 1, y: 64, z: 1, delay: 3, priority: 0 }]))
    check("{level.has(1, 1, 64, 1)} {level.has(2, 1, 64, 1)} {level.count()}", "true false 1")
    _ = level.schedule(tick(1, 1, 1, 4, 0, 0))
    _ = level.schedule(tick(2, 1, 1, 4, 0, 1))
    check("{level.count()}", "2")
    level.unpack(a, 10)
    check(shown(level.collect(13, 65536, all([a]))), "2@1,1 1@1,1")
    check(shown(level.collect(14, 65536, all([a]))), "")
    _ = level.schedule(tick(1, 1, 1, 15, 0, 2))
    check(shown(level.collect(15, 65536, all([a]))), "1@1,1")
}

// Saved ticks are scheduled as the chunk ticks, in as many ticks as they had left, the first
// saved first among those due together, and before any scheduled since; they're saved with the
// ticks left at the time, by their order, those not yet scheduled first, as they were.
fn saved_ticks() {
    let a = chunk(2, 0)
    var level = LevelTicks.new()
    var saved = List<SavedTick>()
    saved.push(SavedTick { kind: 7, x: 32, y: 200, z: 0, delay: 5, priority: 0 })
    saved.push(SavedTick { kind: 8, x: 33, y: 200, z: 0, delay: 2, priority: 0 })
    saved.push(SavedTick { kind: 9, x: 34, y: 200, z: 0, delay: 5, priority: 0 })
    level.add_container(a, ChunkTicks.saved(saved))
    _ = level.schedule(tick(6, 35, 0, 105, 0, 0))
    check(saved_shown(level.pack(a, 50) ?? []), "7@32,0+5/0 8@33,0+2/0 9@34,0+5/0 6@35,0+55/0")
    check(shown(level.collect(105, 65536, all([a]))), "6@35,0")
    level.unpack(a, 100)
    check(saved_shown(level.pack(a, 101) ?? []), "7@32,0+4/0 8@33,0+1/0 9@34,0+4/0")
    _ = level.schedule(tick(5, 36, 0, 105, 0, 0))
    check(shown(level.collect(102, 65536, all([a]))), "8@33,0")
    check(shown(level.collect(105, 65536, all([a]))), "7@32,0 9@34,0 5@36,0")
    let had = match level.remove_container(a) {
        some(_) => true,
        none => false,
    }
    check("{had} {level.has_container(a)} {level.due(200)}", "true false []")
}

fn main() {
    one_chunk()
    two_chunks()
    not_ticking()
    limit()
    one_a_block()
    saved_ticks()
    println("ok")
}
