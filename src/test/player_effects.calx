/// Tests of `world.player_effects` (D514): a player's effects added, their modifiers on and the
/// packets they're told, one merged into another of its kind; regeneration's heal, poison's hurt
/// given back, hunger's exhaustion and saturation's food; the count down, a whole number of 30
/// seconds told again, the end told and health boost's modifier off, their health kept to their
/// most; their values, particles, invisibility, glowing and a spectator's; saved and read back;
/// and cleared without a word as they die.
module test.player_effects

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.attributes.{Attributes}
import world.chunk.{BlockStates}
import world.effects.{ABSORPTION, ActiveEffect, GLOWING, HUNGER, INVISIBILITY, MAGIC_HURT, NO_HURT, REGENERATION, SPEED, WITHER_HURT}
import world.entity_data.{ABSORPTION as ABSORPTION_AMOUNT, EFFECT_PARTICLES, EntityData, GLOWING_FLAG, HEALTH, INVISIBLE_FLAG, SHARED_FLAGS, Value, player_data}
import world.living.{LivingFacts}
import world.player_effects.{EffectEvent, PlayerEffects}
import world.player_status.{Status}
import worldgen.facts.{Facts}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// What the connection's told, each in a word, then cleared.
fn told(e: mut PlayerEffects) -> String {
    var out = String()
    for t in e.told {
        let word = match t {
            EffectEvent.Added(a) => "added {a.id}:{a.amplifier()}/{a.duration()}",
            EffectEvent.Updated(a) => "updated {a.id}:{a.amplifier()}/{a.duration()}",
            EffectEvent.Removed(k) => "removed {k}",
            EffectEvent.Sound(s) => "sound {s}",
            EffectEvent.Missing(m) => "missing {m}",
        }
        if not out.is_empty() {
            out.push_str(", ")
        }
        out.push_str(word)
    }
    e.told.clear()
    return out
}

// A tick of their effects, the hurts given back each `kind:amount`.
fn tick(e: mut PlayerEffects, lf: LivingFacts, a: mut Attributes, data: mut EntityData, status: mut Status, ticks: i32) -> String {
    var hurts = String()
    var i: usize = 0
    while i < e.list.len() {
        let (kept, hurt, amount) = e.act(lf, i, a, mut data, mut status, ticks, false, false)
        if hurt != NO_HURT {
            hurts.push_str("{hurt}:{amount} ")
        }
        if e.end(lf, i, kept, mut a, mut data) {
            i += 1
        }
    }
    return hurts
}

fn main() {
    let f = facts()
    let lf = LivingFacts.new(f)
    var a = Attributes()
    a.set_base(lf.max_health, 20.0)
    a.set_base(lf.max_absorption, 0.0)
    a.set_base(lf.movement_speed, 0.1)
    var data = player_data()
    data.set(HEALTH, Value.Float(10.0f32))
    var status = Status()
    var e = PlayerEffects()

    // Speed II for 1200 ticks: added, told with the blend, its modifier on.
    check("{e.add(lf, ActiveEffect.new(SPEED, 1200, 1), mut a, mut data)} {told(mut e)}", "true added 0:1/1200", "speed added")
    check("{a.value(lf.movement_speed)}", "{0.1 * (1.0 + f64(0.2f32) * 2.0)}", "speed's modifier, a fifth more a level")
    // A weaker, shorter one changes nothing; a stronger one takes over, told without the blend.
    check("{e.add(lf, ActiveEffect.new(SPEED, 100, 0), mut a, mut data)} {told(mut e)}", "false ", "a weaker, shorter speed")
    check("{e.add(lf, ActiveEffect.new(SPEED, 1300, 2), mut a, mut data)} {told(mut e)}", "true updated 0:2/1300", "a stronger speed")
    check("{a.value(lf.movement_speed)}", "{0.1 * (1.0 + f64(0.2f32) * 3.0)}", "its modifier at its level")

    // Absorption's start: 8 at its second level, no more than its most, which its modifier makes.
    _ = e.add(lf, ActiveEffect.new(ABSORPTION, 40, 1), mut a, mut data)
    check("{data.float(ABSORPTION_AMOUNT)} {a.value(lf.max_absorption)} {told(mut e)}", "8.0 8.0 added 21:1/40", "absorption's start")

    // Regeneration I for 101 ticks heals at 100 and 50; poison II's hurts given back every 12.
    _ = e.add(lf, ActiveEffect.new(REGENERATION, 101, 0), mut a, mut data)
    _ = e.add(lf, ActiveEffect.new(18, 25, 1), mut a, mut data)
    _ = told(mut e)
    var hurts = String()
    for t in 0..101 {
        hurts.push_str(tick(mut e, lf, mut a, mut data, mut status, t))
    }
    check("{data.float(HEALTH)}", "12.0", "regeneration's heal at 100 and 50")
    check(hurts, "{MAGIC_HURT}:1.0 {MAGIC_HURT}:1.0 ", "poison II's hurts at 24 and 12")
    // Absorption ran out at 40 and took its modifier and the absorption over its most with it;
    // poison at 25 and regeneration at 101.
    check("{e.list.len()} {a.value(lf.max_absorption)} {data.float(ABSORPTION_AMOUNT)}", "1 0.0 0.0", "absorption, poison and regeneration gone")
    check(told(mut e), "removed 18, removed 21, updated 0:2/1200, removed 9", "their ends told, and speed again at 1200")

    // Speed with 1199 ticks left, told again at 600.
    check("{e.list[0].duration()}", "1199", "speed's time left")
    for t in 0..599 {
        _ = tick(mut e, lf, mut a, mut data, mut status, t)
    }
    check(told(mut e), "updated 0:2/600", "told again at a whole number of 30 seconds")

    // Hunger III's exhaustion, 0.005 a level a tick; saturation's food.
    _ = e.add(lf, ActiveEffect.new(HUNGER, 10, 2), mut a, mut data)
    for t in 0..10 {
        _ = tick(mut e, lf, mut a, mut data, mut status, t)
    }
    check("{status.exhaustion}", "{0.015f32 * 10.0f32}", "hunger's exhaustion")
    status.food = 10
    status.saturation = 0.0f32
    _ = e.add(lf, ActiveEffect.new(22, 1, 1), mut a, mut data)
    _ = tick(mut e, lf, mut a, mut data, mut status, 0)
    check("{status.food} {status.saturation}", "12 4.0", "saturation II's food, as eating 2 gives it")
    _ = told(mut e)

    // Health boost I: their most 24, then 20 again as it ends, their health kept to it.
    _ = e.add(lf, ActiveEffect.new(20, 2, 0), mut a, mut data)
    data.set(HEALTH, Value.Float(24.0f32))
    for t in 0..2 {
        _ = tick(mut e, lf, mut a, mut data, mut status, t)
    }
    check("{a.value(lf.max_health)} {data.float(HEALTH)}", "20.0 20.0", "health boost off, their health kept to their most")
    _ = told(mut e)

    // Wither's hurt given back.
    _ = e.add(lf, ActiveEffect.new(19, 40, 0), mut a, mut data)
    check(tick(mut e, lf, mut a, mut data, mut status, 0), "{WITHER_HURT}:1.0 ", "wither's hurt at 40")

    // Their values: invisible with invisibility, glowing with glowing, a spectator's none.
    _ = e.add(lf, ActiveEffect.new(INVISIBILITY, 100, 0), mut a, mut data)
    _ = e.add(lf, ActiveEffect.new(GLOWING, 100, 0), mut a, mut data)
    e.update_dirty(lf, mut data, false, false)
    let flags = i32(data.byte(SHARED_FLAGS))
    check("{flags & INVISIBLE_FLAG != 0} {flags & GLOWING_FLAG != 0} {not data.is_default(EFFECT_PARTICLES)} {e.dirty}", "true true true false", "invisible and glowing, their effects' particles")
    e.dirty = true
    e.update_dirty(lf, mut data, true, false)
    check("{i32(data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0} {data.is_default(EFFECT_PARTICLES)}", "true true", "a spectator invisible, without particles")

    // Saved and read back, to be shown; gone without a word as they die.
    var saved = JavaHashMap<String, Tag>()
    e.write(mut saved)
    let back = PlayerEffects.read(some(saved.copy()))
    check("{back.list.len()} {back.list.len() == e.list.len()} {back.dirty}", "{e.list.len()} true true", "saved and read back")
    _ = told(mut e)
    e.cleared()
    e.write(mut saved)
    check("{e.list.len()} {told(mut e)} {saved.contains("active_effects")}", "0  false", "cleared as they die, and none saved")
    _ = told(mut e)
    println("ok")
}
