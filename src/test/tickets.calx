/// Checks `world.tickets`: tickets added and taken out, with what the trackers are told, stale
/// ones run down, deactivated and activated again, forced chunks, and `chunk_tickets` written
/// and read back, with the lines for what can't be read. The rig's `tickets` probe checks it
/// against vanilla's own `TicketStorage`.
module test.tickets

import nbt.tag.{Tag}
import server.log.{Entry}
import world.pos.{ChunkPos}
import world.tickets.{FORCED_LEVEL, Holders, NO_TICKET, NoListener, Ticket, TicketListener, TicketStorage, TicketType}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// What the trackers were told, as `l` or `s`, the chunk, the level, and `!` for a change that
// can only have lowered it.
struct Heard {
    told: String = String()
}

impl TicketListener for Heard {
    fn loading(mut self, chunk: i64, level: i32, only_decreased: bool) {
        self.told.push_str("l{chunk}:{level}{if only_decreased { "!" } else { "" }} ")
    }
    fn simulation(mut self, chunk: i64, level: i32, only_decreased: bool) {
        self.told.push_str("s{chunk}:{level}{if only_decreased { "!" } else { "" }} ")
    }
}

// Holders of which only chunk 7's isn't ready to save.
struct Busy {
    chunk: i64 = 7
}

impl Holders for Busy {
    fn ready_for_saving(self, chunk: i64) -> bool {
        return chunk != self.chunk
    }
}

fn heard(h: mut Heard) -> String {
    let out = h.told.copy()
    h.told = String()
    return out
}

fn listed(tickets: List<Ticket>) -> String {
    var out = String()
    for t in tickets {
        out.push_str("{t.kind.name()}/{t.level}/{t.ticks_left} ")
    }
    return out
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn adding() {
    var s = TicketStorage.new()
    var h = Heard {}
    check("{s.add(1, Ticket.new(TicketType.PlayerLoading, 33), mut h)}", "true", "a ticket added")
    check(heard(mut h), "l1:33! ", "a loading ticket tells the loading tracker")
    check("{s.add(1, Ticket.new(TicketType.Forced, FORCED_LEVEL), mut h)}", "true", "a forced ticket added")
    check(heard(mut h), "s1:31! l1:31! ", "a lower ticket tells both, the simulation tracker first")
    check("{s.add(1, Ticket.new(TicketType.PlayerSpawn, 32), mut h)}", "true", "a higher ticket added")
    check(heard(mut h), "", "a ticket that lowers nothing tells no one")
    check("{s.add(1, Ticket.new(TicketType.Forced, FORCED_LEVEL), mut h)}", "false", "the same ticket again")
    check("{s.is_forced(1)} {s.forced_chunks()} {s.level_at(1, false)} {s.level_at(1, true)} {s.level_at(2, false)}", "true [1] 31 31 {NO_TICKET}", "levels")
    check(s.debug_string(1, false), "Ticket[minecraft:forced 31] with no timeout", "the debug string")
    check(s.debug_string(2, true), "no_ticket", "no ticket's debug string")
    check("{s.remove(1, Ticket.new(TicketType.Forced, FORCED_LEVEL), mut h)}", "true", "the forced ticket taken out")
    check(heard(mut h), "s1:{NO_TICKET} l1:32 ", "taking one out tells each tracker its type counts")
    check("{s.is_forced(1)} {s.remove(1, Ticket.new(TicketType.Forced, FORCED_LEVEL), mut h)}", "false false", "no forced ticket left")
    check("{s.remove(3, Ticket.new(TicketType.Forced, FORCED_LEVEL), mut h)} {heard(mut h)}", "false ", "a chunk with no tickets")
    _ = s.remove(1, Ticket.new(TicketType.PlayerSpawn, 32), mut h)
    _ = s.remove(1, Ticket.new(TicketType.PlayerLoading, 33), mut h)
    check("{heard(mut h)}{s.has_tickets()} {s.chunks()}", "l1:33 l1:{NO_TICKET} false []", "the last ticket taken out")
}

fn purging() {
    var s = TicketStorage.new()
    var h = Heard {}
    _ = s.add(5, Ticket.new(TicketType.Unknown, 33), mut h)
    _ = s.add(7, Ticket.new(TicketType.Portal, 30), mut h)
    _ = s.add(9, Ticket.new(TicketType.Portal, 30), mut h)
    _ = s.add(9, Ticket.new(TicketType.PlayerLoading, 31), mut h)
    _ = heard(mut h)
    s.purge_stale(Busy {}, mut h)
    check("{listed(s.tickets_at(5))}| {listed(s.tickets_at(7))}| {listed(s.tickets_at(9))}", "unknown/33/0 | portal/30/300 | portal/30/299 player_loading/31/0 ", "one tick")
    s.purge_stale(Busy {}, mut h)
    check("{s.chunks()} {heard(mut h)}", "[9, 7] l5:{NO_TICKET} ", "an unknown ticket lasts 2 ticks")
    for _ in 0..299 {
        s.purge_stale(Busy {}, mut h)
    }
    check("{listed(s.tickets_at(9))} {heard(mut h)}", "player_loading/31/0  l9:31 s9:{NO_TICKET} ", "a portal ticket lasts 301 ticks where the chunk's ready")
    check(listed(s.tickets_at(7)), "portal/30/300 ", "and doesn't run down where it isn't")
}

fn closing() {
    var s = TicketStorage.new()
    var h = Heard {}
    _ = s.add(1, Ticket.new(TicketType.Forced, FORCED_LEVEL), mut h)
    _ = s.add(2, Ticket.new(TicketType.Unknown, 33), mut h)
    _ = s.add(2, Ticket.new(TicketType.Portal, 30), mut h)
    _ = s.add(3, Ticket.new(TicketType.PlayerLoading, 31), mut h)
    _ = heard(mut h)
    s.deactivate_on_closing(mut h)
    check("{s.chunks()} {listed(s.tickets_at(2))}{s.forced_chunks()}", "[2] unknown/33/1 []", "only unknown tickets stay")
    check("{s.deactivated_chunks()} {listed(s.deactivated_at(2))}", "[1, 3, 2] portal/30/300 ", "the rest are deactivated")
    check(heard(mut h), "l3:{NO_TICKET} l2:33 s2:{NO_TICKET} l1:{NO_TICKET} s1:{NO_TICKET} ", "each chunk is told of, loading first")
    let saved = s.pack()
    check(saved.to_snbt(), "\{tickets:[\{chunk_pos:[I;1,0],level:31,type:\"minecraft:forced\"\},\{chunk_pos:[I;2,0],level:30,ticks_left:300L,type:\"minecraft:portal\"\}]\}", "what's saved")
    s.activate_all_deactivated(mut h)
    check("{s.chunks()} {s.deactivated_chunks()} {s.forced_chunks()}", "[3, 2, 1] [] [1]", "activated again")
}

fn reading() {
    var lines = List<Entry>()
    var root = JavaHashMap<String, Tag>()
    var none_lines = List<Entry>()
    check("{TicketStorage.parse(root, mut none_lines) == none} {shown(none_lines)}", "true [Failed to parse saved data for 'SavedDataType[minecraft:chunk_tickets]': Not a map: null]", "no data")
    var s = TicketStorage.new()
    var quiet = NoListener {}
    _ = s.update_forced(ChunkPos { x: -3, z: 4 }, true, mut quiet)
    root.insert("data", s.pack())
    let read = TicketStorage.parse(root, mut lines) else panic("not read")
    check("{read.chunks()} {read.deactivated_chunks()} {ChunkPos { x: -3, z: 4 }.pack()} {shown(lines)}", "[] [{ChunkPos { x: -3, z: 4 }.pack()}] {ChunkPos { x: -3, z: 4 }.pack()} ", "read back, deactivated")
}

fn main() {
    adding()
    purging()
    closing()
    reading()
    println("ok")
}
