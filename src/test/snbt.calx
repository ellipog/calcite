/// Checks SNBT as nbt.snbt reads it: each kind of literal, the error at the furthest place with
/// the text before it, the depth limit, and the language its errors are written in. The rig's
/// `nbt` probe checks the same against vanilla's `TagParser`.
module test.snbt

import chat.language.{Language}
import nbt.snbt.{parse, parse_compound}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn read(text: String, lang: Language) -> String {
    return match parse(text) {
        ok(tag) => tag.to_snbt(),
        err(e) => e.text(lang),
    }
}

fn repeat(s: str, n: usize) -> String {
    var out = String()
    for _ in 0..n {
        out.push_str(s)
    }
    return out
}

// Text of our own for the keys the errors here use, as the jar's en_us.json gives the server.
fn language() -> Language {
    var lang = Language.empty()
    lang.add(String("argument.literal.incorrect"), String("wanted %s"))
    lang.add(String("argument.nbt.trailing"), String("more after the end"))
    lang.add(String("snbt.parser.no_such_operation"), String("no operation %s"))
    lang.add(String("snbt.parser.number_parse_failure"), String("bad number: %s"))
    return lang
}

fn literals(lang: Language) {
    check(read("\{b:[1,2],a:1b,c:\"x\"\}", lang), "\{a:1b,b:[1,2],c:\"x\"\}")
    check(read("[B;1b,2B]", lang), "[B;1B,2B]")
    check(read("[L;1,2l]", lang), "[L;1L,2L]")
    check(read("0x1F", lang), "31")
    check(read("0b101s", lang), "5s")
    check(read("1_000", lang), "1000")
    check(read("0xffub", lang), "-1b")
    check(read("1.5e3f", lang), "1500.0f")
    check(read(".5", lang), "0.5d")
    check(read("true", lang), "1b")
    check(read("bool(0)", lang), "0b")
    check(read("'say \"hi\"'", lang), "'say \"hi\"'")
    check(read("\"it\\'s\"", lang), "\"it's\"")
    check(read("\"\\x41\\u00e9\\N\{SNOWMAN\}\"", lang), "\"A\u{e9}\u{2603}\"")
    check(read("  plain-word  ", lang), "\"plain-word\"")
    check(read("[I;1b]", lang), "[I;1]")
}

fn errors(lang: Language) {
    // The furthest any rule got, and the first thing wanted there. These are vanilla's errors,
    // in the language above.
    check(read("\{a:1", lang), "wanted . at position 4: \{a:1<--[HERE]")
    check(read("01", lang), "wanted . at position 2: 01<--[HERE]")
    check(read("\{:1\}", lang), "wanted \" at position 1: \{<--[HERE]")
    check(read("1 2", lang), "more after the end at position 2: 1 <--[HERE]")
    check(read("1a", lang), "more after the end at position 1: 1<--[HERE]")
    check(read("nope(1)", lang), "no operation nope/1 at position 7: nope(1)<--[HERE]")
    check(read("128b", lang), "bad number: Value out of range. Value:\"128\" Radix:10 at position 4: 128b<--[HERE]")
    // More than ten units before the place are cut to the last ten.
    check(read("[1,2,3,4,5,6,7", lang), "wanted . at position 14: ...,3,4,5,6,7<--[HERE]")
    // A key the language hasn't is its own text.
    check(read("1 2", Language.empty()), "argument.nbt.trailing at position 2: 1 <--[HERE]")
    match parse_compound("[1]") {
        ok(tag) => panic("{tag.to_snbt()} was read as a compound"),
        err(e) => check(e.text(lang), "argument.nbt.expected.compound at position 3: [1]<--[HERE]"),
    }
}

// Vanilla's parser has no limit, and overflows its stack somewhere past it; Calcite's stops at the
// limit NBT has everywhere else (rig/differences/snbt-depth.md).
fn depth(lang: Language) {
    let fits = "{repeat("[", 512)}{repeat("]", 512)}"
    check(read(fits, lang), fits)
    let deep = "{repeat("[", 513)}{repeat("]", 513)}"
    check(read(deep, lang), "Tried to read NBT tag with too high complexity, depth > 512 at position 512: ...[[[[[[[[[[<--[HERE]")
    // Operations count as well as lists and compounds, at the bracket of the one too deep.
    check(read(repeat("bool(", 600), lang), "Tried to read NBT tag with too high complexity, depth > 512 at position 2564: ...(bool(bool<--[HERE]")
}

fn languages() {
    let en_us = "\{\"count\":\"%d of %1$.2f\",\"kept\":\"x\",\"old\":\"moved\",\"gone\":\"bye\",\"n\":5\}"
    let deprecated = "\{\"removed\":[\"gone\"],\"renamed\":\{\"old\":\"new\",\"missing\":\"kept\"\}\}"
    var warnings = List<String>()
    match Language.from_json(String(en_us), String(deprecated), mut warnings) {
        ok(lang) => {
            check(lang.get_or_default("count", "-"), "%s of %1$s")
            check(lang.get_or_default("new", "-"), "moved")
            check(lang.get_or_default("old", "-"), "-")
            check(lang.get_or_default("gone", "-"), "-")
            // Renaming a key that isn't there takes the new name out.
            check(lang.get_or_default("kept", "-"), "-")
            check(lang.get_or_default("n", "-"), "5")
            check("{lang.len()}", "3")
        },
        err(e) => panic(e),
    }
    check("{warnings.len()} {warnings[0]}", "1 Missing translation key for rename: missing")
}

fn main() {
    let lang = language()
    literals(lang)
    errors(lang)
    depth(lang)
    languages()
    println("ok")
}
