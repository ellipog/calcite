/// Checks `server.commands`: commands read as brigadier reads them, each failure's message and
/// where in the input it is, the context line vanilla shows under it, and the tree a player is
/// sent at each permission level, read back.
module test.commands

import chat.component.{Contents}
import chat.language.{Language}
import protocol.play.{ClientboundCommands, NodeKind}
import protocol.wire.{Reader, Writer}
import server.commands.{Failure, Parsed, Targets, argument_type, failure_context, parse, tree}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// What a command reads as, in a word or two, or its failure: the message's key, its arguments'
// text, and the cursor.
fn read(input: str, level: i32) -> String {
    return match parse(String(input), level) {
        ok(Parsed.Stop) => String("stop"),
        ok(Parsed.GameMode(mode, targets)) => "gamemode {mode.name()} {who(targets)}",
        ok(Parsed.FlySpeed(speed)) => match speed {
            some(s) => "flyspeed {s}",
            none => String("flyspeed"),
        },
        err(f) => failed(f),
    }
}

fn who(targets: Targets?) -> String {
    let t = targets else return String("me")
    return match t {
        Targets.Name(n) => "name {n}",
        Targets.Me => String("@s"),
        Targets.All => String("@a"),
        Targets.Nearest => String("@p"),
        Targets.Random => String("@r"),
    }
}

fn failed(f: Failure) -> String {
    var lang = Language.empty()
    lang.add("command.context.here", "<--[HERE]")
    let key = match f.message.contents {
        Contents.Translatable(t) => {
            var args = String()
            for a in t.args {
                args.push_str(" ")
                args.push_str(a.get_string(lang))
            }
            "{t.key}{args}"
        },
        _ => f.message.get_string(lang),
    }
    var line = String()
    if let c = failure_context(f) {
        line = " | {c.get_string(lang)}"
    }
    return "{key} @{f.cursor}{line}"
}

fn main() {
    // Commands that read.
    check(read("gamemode creative", 4), "gamemode creative me", "gamemode")
    check(read("gamemode spectator Steve", 2), "gamemode spectator name Steve", "a name")
    check(read("gamemode adventure \"Steve\"", 2), "gamemode adventure name Steve", "a quoted name")
    check(read("gamemode survival @a", 2), "gamemode survival @a", "@a")
    check(read("gamemode survival @s", 2), "gamemode survival @s", "@s")
    check(read("gamemode survival @p", 2), "gamemode survival @p", "@p")
    check(read("gamemode survival @r", 2), "gamemode survival @r", "@r")
    check(read("gmc", 2), "gamemode creative me", "gmc")
    check(read("gms Alex", 2), "gamemode survival name Alex", "gms")
    check(read("gma", 2), "gamemode adventure me", "gma")
    check(read("gmsp", 2), "gamemode spectator me", "gmsp")
    check(read("stop", 4), "stop", "stop")
    check(read("calcite flyspeed", 2), "flyspeed", "flyspeed alone")
    check(read("calcite flyspeed 2.5", 2), "flyspeed 2.5", "flyspeed")
    check(read("calcite flyspeed .5", 2), "flyspeed 0.5", "a float without its 0")

    // What a level doesn't let in isn't there.
    check(read("gamemode creative", 1), "command.unknown.command @0 | gamemode creative<--[HERE]", "gamemode at level 1")
    check(read("stop", 3), "command.unknown.command @0 | stop<--[HERE]", "stop at level 3")
    check(read("gmc", 0), "command.unknown.command @0 | gmc<--[HERE]", "gmc at level 0")
    check(read("", 4), "command.unknown.command @0 | <--[HERE]", "nothing")
    check(read("GAMEMODE creative", 4), "command.unknown.command @0 | GAMEMODE creative<--[HERE]", "a capital")

    // Brigadier's failures, and where they are.
    check(read("gamemode", 4), "command.unknown.command @8 | gamemode<--[HERE]", "gamemode alone")
    check(read("gamemode ", 4), "command.unknown.argument @8 | gamemode <--[HERE]", "gamemode and a space")
    check(read("gamemode foo", 4), "argument.gamemode.invalid foo @12 | ...memode foo<--[HERE]", "an unknown mode")
    check(read("gamemode Creative", 4), "argument.gamemode.invalid Creative @17 | ...e Creative<--[HERE]", "a mode in capitals")
    check(read("gamemode creative!", 4), "command.expected.separator @17 | ...e creative!<--[HERE]", "trailing data")
    check(read("gamemode creative ", 4), "command.unknown.argument @17 | ...e creative <--[HERE]", "a space after the mode")
    check(read("gamemode creative Steve more", 4), "command.unknown.argument @24 | ...ive Steve more<--[HERE]", "more after the player")
    check(read("gamemode creative @e", 4), "argument.player.entities @0 | gamemode creative @e<--[HERE]", "@e")
    check(read("gamemode creative @n", 4), "argument.player.entities @0 | gamemode creative @n<--[HERE]", "@n")
    check(read("gamemode creative 5d5cfed6-258c-4035-9ea0-4f4e03ee8015", 4), "argument.player.entities @0 | gamemode creative 5d5cfed6-258c-4035-9ea0-4f4e03ee8015<--[HERE]", "a UUID")
    check(read("gamemode creative @", 4), "argument.entity.selector.missing @19 | ...creative @<--[HERE]", "@ alone")
    check(read("gamemode creative @x", 4), "argument.entity.selector.unknown @x @19 | ...creative @x<--[HERE]", "@x")
    check(read("gamemode creative @ab", 4), "command.expected.separator @20 | ...reative @ab<--[HERE]", "@ab")
    check(read("gamemode creative SeventeenLetters1", 4), "argument.entity.invalid @18 | ... creative SeventeenLetters1<--[HERE]", "a name too long")
    check(read("gamemode creative \"Steve", 4), "parsing.quote.expected.end @24 | ...ive \"Steve<--[HERE]", "an unclosed quote")
    check(read("gamemode creative \"St\\eve\"", 4), "parsing.quote.escape e @22 | ...ative \"St\\eve\"<--[HERE]", "a bad escape")
    check(read("stop now", 4), "command.unknown.argument @5 | stop now<--[HERE]", "stop and more")
    check(read("stop ", 4), "command.unknown.argument @4 | stop <--[HERE]", "stop and a space")
    check(read("calcite", 2), "command.unknown.command @7 | calcite<--[HERE]", "calcite alone")
    check(read("calcite fly", 2), "command.unknown.argument @8 | calcite fly<--[HERE]", "calcite and another word")
    check(read("calcite flyspeed x", 2), "parsing.float.expected @17 | ... flyspeed x<--[HERE]", "no float")
    check(read("calcite flyspeed 1.2.3", 2), "parsing.float.invalid 1.2.3 @17 | ... flyspeed 1.2.3<--[HERE]", "a bad float")
    check(read("calcite flyspeed -1", 2), "argument.float.low 0.0 -1.0 @17 | ... flyspeed -1<--[HERE]", "too slow")
    check(read("calcite flyspeed 1000.5", 2), "argument.float.big 1000.0 1000.5 @17 | ... flyspeed 1000.5<--[HERE]", "too fast")
    check(read("gmc  Steve", 2), "argument.entity.invalid @4 | gmc  Steve<--[HERE]", "two spaces")

    // The trees, read back: the root, then a level at a time.
    check(shape(tree(0)), "root", "a player's tree")
    check(shape(tree(2)), "root[1,2,3,4,5,6] gamemode![7] calcite![8] gmc!*[9] gms!*[10] gma!*[11] gmsp!*[12] <gamemode:{argument_type("gamemode")}>*[13] flyspeed*[14] <target:{argument_type("entity")}>* <target:6>* <target:6>* <target:6>* <target:6>* <speed:1>*", "a game master's tree")
    check(shape(tree(4)), "root[1,2,3,4,5,6,7] gamemode![8] stop!* calcite![9] gmc!*[10] gms!*[11] gma!*[12] gmsp!*[13] <gamemode:{argument_type("gamemode")}>*[14] flyspeed*[15] <target:6>* <target:6>* <target:6>* <target:6>* <target:6>* <speed:1>*", "an owner's tree")
    print("ok")
}

// The tree, written and read back: each node's name, `!` where it's restricted, `*` where it
// runs, and its children.
fn shape(t: ClientboundCommands) -> String {
    var w = Writer.new()
    t.write(mut w)
    var r = Reader.new(w.into_bytes())
    let back = match ClientboundCommands.read(mut r) {
        ok(b) => b,
        err(e) => panic("the tree didn't read back: {e.message}"),
    }
    var out = String()
    for n in back.nodes {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str(match n.kind {
            NodeKind.Root => String("root"),
            NodeKind.Literal(word) => word.copy(),
            NodeKind.Argument { name, parser, .. } => "<{name}:{parser}>",
        })
        if n.restricted {
            out.push_str("!")
        }
        if n.executable {
            out.push_str("*")
        }
        if not n.children.is_empty() {
            var ids = String()
            for c in n.children {
                if not ids.is_empty() {
                    ids.push_str(",")
                }
                ids.push_str("{c}")
            }
            out.push_str("[{ids}]")
        }
    }
    return out
}
