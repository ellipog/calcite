/// Checks `world.arrow` and the clip its way takes, `world.clip` (CAL-159): a shape's faces met
/// in `AABB.clip`'s order, from inside facing back the way the line goes, and missed; the
/// nearest direction of a way, the first where they tie and north for none; an arrow read from
/// its tag and saved back the same; a hit's damage, its speed times its base damage rounded up,
/// a crit's draw added, and a piercing arrow's hits, gone once it's hit one more than its level;
/// what it may hit, not its owner till it's left them nor a player where its player owner may
/// not harm them; a hit that didn't hurt turning it back at a tenth of its speed, and one that
/// leaves it too slow dropping it where anyone may pick it up; and whether it may be picked up.
/// A hit held by the world border, from within it to past it, on its edge, facing the way the
/// line went, and a hit within it or from outside it kept; and an arrow bounced off it.
/// And a mob's arrow (CAL-159): owned by it, no one's to pick up, its damage drawn about the
/// difficulty's, and shot along its way at its speed, facing it.
module test.arrow

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.arrow.{ALLOWED, Arrow, CREATIVE_ONLY, DISALLOWED, OwnerView}
import world.body.{EntitySound}
import world.clip.{BlockHit, border_hit, nearest_direction, shape_clip, widest_border}
import world.collision.{Aabb}
import world.loot.{LootEntity}
import worldgen.facts.{DOWN, EAST, NORTH, SOUTH, UP, WEST}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    let Tag.Compound(m) = t else panic("not a compound")
    return m.copy()
}

fn arrow(id: i32, text: str) -> Arrow {
    var lines = List<Entry>()
    let a = Arrow.loaded(id, 1103, compound(snbt(text)), none, none, none, mut lines) else panic("not loaded")
    check(lines.is_empty(), "nothing logged")
    return a
}

fn whole() -> List<Aabb> {
    var boxes = List<Aabb>()
    boxes.push(Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 1.0, max_z: 1.0 })
    return boxes
}

fn main() {
    // A whole block at (2, 0, 0), met from above on its top, from the west on its west face, and
    // a slab's top from the side, at its edge.
    let top = shape_clip(whole(), (2.5, 2.0, 0.5), (2.5, 0.5, 0.5), 2, 0, 0) ?? panic("the top missed")
    check(top.face == UP and top.y == 1.0 and top.bx == 2 and not top.missed, "the top, facing up")
    let west = shape_clip(whole(), (0.0, 0.5, 0.5), (4.0, 0.5, 0.5), 2, 0, 0) ?? panic("the west face missed")
    check(west.face == WEST and west.x == 2.0, "the west face")
    var slab = List<Aabb>()
    slab.push(Aabb { min_x: 0.0, min_y: 0.0, min_z: 0.0, max_x: 1.0, max_y: 0.5, max_z: 1.0 })
    check(shape_clip(slab, (2.5, 0.75, -1.0), (2.5, 0.75, 2.0), 2, 0, 0) == none, "over the slab")
    let side = shape_clip(slab, (2.5, 0.25, 2.0), (2.5, 0.25, -1.0), 2, 0, 0) ?? panic("the slab's side missed")
    check(side.face == SOUTH and side.z == 1.0, "the slab's south side")
    // From inside, a thousandth along the line, facing back the way it goes; and a line too short.
    let inside = shape_clip(whole(), (2.5, 0.5, 0.5), (2.5, 0.5, 3.0), 2, 0, 0) ?? panic("inside missed")
    check(inside.face == NORTH and inside.z == 0.5 + 2.5 * 0.001, "inside, facing back")
    check(shape_clip(whole(), (2.5, 2.0, 0.5), (2.5, 2.0001, 0.5), 2, 0, 0) == none, "too short a line")
    check(shape_clip(List<Aabb>(), (2.5, 2.0, 0.5), (2.5, 0.5, 0.5), 2, 0, 0) == none, "no shape")

    // The nearest direction: down before up, the first of a tie, north for none.
    check(nearest_direction(0.0, -1.0, 0.0) == DOWN and nearest_direction(0.0, 1.0, 0.0) == UP, "down and up")
    check(nearest_direction(1.0, 0.2, 0.0) == EAST and nearest_direction(-1.0, 0.0, 0.9) == WEST, "east and west")
    check(nearest_direction(0.0, 1.0, 1.0) == UP, "a tie, the first")
    check(nearest_direction(0.0, 0.0, 0.0) == NORTH, "none, north")

    // The world border, 10 out each way: a line from within it to past its east edge is held a
    // hair inside it, facing east, at the block there, neither missed nor a block's; one to its
    // north-west, on both edges, facing the way it went, up most; a hit within it, or from
    // outside it, is kept; and the widest border has its edges 29,999,984 out.
    let border = (-10.0, -10.0, 10.0, 10.0)
    let past = BlockHit { x: 12.0, y: 3.5, z: 4.0, face: WEST, bx: 12, by: 3, bz: 4, missed: true }
    let east = border_hit(past, (8.0, 3.5, 4.0), border)
    check(east.border and not east.missed and east.x == 10.0 - f64(1.0e-5f32) and east.y == 3.5 and east.z == 4.0, "held at the east edge")
    check(east.face == EAST and east.bx == 9 and east.by == 3 and east.bz == 4, "facing east, at the block inside")
    let corner = BlockHit { x: -10.5, y: 4.2, z: -10.5, face: DOWN, bx: -11, by: 4, bz: -11, missed: true }
    let north_west = border_hit(corner, (-9.8, 3.4, -9.8), border)
    check(north_west.border and north_west.x == -10.0 and north_west.z == -10.0 and north_west.face == UP, "the corner, up most")
    check(north_west.bx == -10 and north_west.bz == -10, "at the corner's block")
    let within = BlockHit { x: 9.0, y: 3.5, z: 4.0, face: WEST, bx: 9, by: 3, bz: 4, missed: false }
    check(not border_hit(within, (8.0, 3.5, 4.0), border).border and border_hit(within, (8.0, 3.5, 4.0), border).x == 9.0, "within it, kept")
    check(not border_hit(past, (11.0, 3.5, 4.0), border).border, "from outside it, kept")
    check(widest_border() == (-29999984.0, -29999984.0, 29999984.0, 29999984.0), "the widest border")

    // Read and saved back the same.
    let text = "\{id:\"minecraft:arrow\",Pos:[9.5d,-59.0d,12.5d],Motion:[0.8d,0.1d,0.0d],Rotation:[0.0f,0.0f],pickup:1b,life:3s,shake:7b,inGround:0b,damage:2.0d,crit:0b,PierceLevel:0b,SoundEvent:\"minecraft:entity.arrow.hit\",HasBeenShot:1b,item:\{id:\"minecraft:arrow\",count:1\}\}"
    let first = arrow(1, text)
    var lines = List<Entry>()
    let again = Arrow.loaded(1, 1103, compound(first.saved()), none, none, none, mut lines) else panic("not read back")
    check(again.saved() == first.saved(), "saved back the same")
    let m = compound(first.saved())
    check(m["pickup"] == Tag.Byte(1i8) and m["life"] == Tag.Short(3i16) and m["shake"] == Tag.Byte(7i8), "its bytes and short")
    check(m["damage"] == Tag.Double(2.0) and m["inGround"] == Tag.Byte(0i8) and not m.contains("LeftOwner"), "its damage, and no LeftOwner where it hasn't")
    check(m["id"] == Tag.Str(String("minecraft:arrow")), "its type")

    // A hit's damage: 0.806 a tick times 2, rounded up, as Pin took it in the rig's `arrows`.
    var plain = arrow(2, text)
    let base = plain.base_damage
    check(plain.strike(7, base) == some(2), "a hit's damage")
    // A crit at 3 a tick: 6, and up to 4 more.
    var crit = arrow(3, "\{Pos:[0.0d,0.0d,0.0d],Motion:[3.0d,0.0d,0.0d],crit:1b\}")
    let dealt = crit.strike(7, 2.0) ?? panic("a crit dealt nothing")
    check(dealt >= 6 and dealt <= 10, "a crit's damage")
    // Pierce 1: two hit, the third ends it.
    var piercing = arrow(4, "\{Pos:[0.0d,0.0d,0.0d],Motion:[1.0d,0.0d,0.0d],PierceLevel:1b\}")
    check(piercing.strike(7, 2.0) == some(2) and piercing.strike(8, 2.0) == some(2), "a piercing arrow's two hits")
    check(piercing.strike(9, 2.0) == none and piercing.body.removed, "its third, the end of it")
    check(not piercing.may_hit(7, false, none, true), "what it's pierced, not again")
    // What it kills, kept from its first hit as it pierces, for its owner's `KILLED_BY_ARROW`, and
    // forgotten as it lands, `resetPiercedEntities`; a plain arrow's never kept (CAL-164).
    let begun = match piercing.pierced_killed {
        some(k) => k.is_empty(),
        none => false,
    }
    let never = match plain.pierced_killed {
        some(_) => false,
        none => true,
    }
    check(begun and never, "what a piercing arrow kills, kept from its first hit")
    piercing.pierced_killed = some([LootEntity { kind: String("minecraft:phantom") }])
    var landing = List<EntitySound>()
    piercing.hit_block(1u32, Tag.End, mut landing)
    let forgotten = match piercing.pierced_killed {
        some(k) => k.is_empty(),
        none => false,
    }
    check(forgotten, "what it killed, forgotten as it lands")

    // What it may hit: not its owner till it's left them, nor a player its player owner may not harm.
    let owner = OwnerView { id: 10, bounds: none, player: true }
    let fresh = arrow(5, "\{Pos:[0.0d,0.0d,0.0d],Motion:[1.0d,0.0d,0.0d]\}")
    check(not fresh.may_hit(10, true, some(owner), true) and fresh.may_hit(11, true, some(owner), true), "not its owner yet")
    check(not fresh.may_hit(11, true, some(owner), false) and fresh.may_hit(2, false, some(owner), false), "no player without pvp")
    let left = arrow(6, "\{Pos:[0.0d,0.0d,0.0d],Motion:[1.0d,0.0d,0.0d],LeftOwner:1b\}")
    check(left.may_hit(10, true, some(owner), true), "its owner, once it's left them")

    // Not hurt: turned back half round and up to 20 degrees more, a tenth as fast the other way.
    var sounds = List<EntitySound>()
    var bounced = arrow(7, "\{Pos:[0.0d,0.0d,0.0d],Motion:[1.0d,0.0d,0.0d],pickup:1b\}")
    check(not bounced.struck(false, mut sounds) and not bounced.body.removed, "turned back")
    // Off the border, the same turn, `turn_back`, its draw the same as a hit's.
    var off = arrow(4, "\{Pos:[0.0d,0.0d,0.0d],Motion:[1.0d,0.2d,0.0d]\}")
    off.turn_back()
    check(off.body.vx == -0.1 and off.body.needs_sync and off.body.y_rot == bounced.body.y_rot, "bounced off the border")
    check(bounced.body.vx == -0.1 and bounced.body.y_rot >= 170.0f32 and bounced.body.y_rot <= 190.0f32 and bounced.body.needs_sync, "a tenth the other way")
    check(sounds.is_empty(), "no sound turned back")
    // Too slow after: gone, dropping itself where anyone may pick it up, not where no one may.
    var slow = arrow(8, "\{Pos:[0.0d,0.0d,0.0d],Motion:[0.001d,0.0d,0.0d],pickup:1b\}")
    check(slow.struck(false, mut sounds) and slow.body.removed, "too slow, dropped")
    var kept = arrow(9, "\{Pos:[0.0d,0.0d,0.0d],Motion:[0.001d,0.0d,0.0d]\}")
    check(not kept.struck(false, mut sounds) and kept.body.removed and kept.pickup == DISALLOWED, "too slow, gone")
    // Hurt: its sound, and gone.
    var hit = arrow(10, "\{Pos:[0.0d,0.0d,0.0d],Motion:[1.0d,0.0d,0.0d]\}")
    check(not hit.struck(true, mut sounds) and hit.body.removed and sounds.len() == 1, "hurt, heard and gone")
    check(sounds[0].sound == "entity.arrow.hit" and sounds[0].volume == 1.0f32, "its hit sound")

    // Picked up: in the ground and done shaking.
    let flying = arrow(11, "\{Pos:[0.0d,0.0d,0.0d],Motion:[1.0d,0.0d,0.0d],pickup:1b\}")
    check(not flying.touchable(), "not in flight")
    let shaking = arrow(12, "\{Pos:[0.0d,0.0d,0.0d],inGround:1b,shake:3b,pickup:1b\}")
    check(not shaking.touchable(), "not while it shakes")
    let landed = arrow(13, "\{Pos:[0.0d,0.0d,0.0d],inGround:1b,pickup:2b\}")
    check(landed.touchable() and landed.pickup == CREATIVE_ONLY, "landed, for creative players")
    let odd = arrow(14, "\{Pos:[0.0d,0.0d,0.0d],pickup:5b\}")
    check(odd.pickup == DISALLOWED and ALLOWED == 1, "an odd pickup, no one's")

    // A mob's arrow: its owner's, no one's to pick up, from its bow; on normal at full power, 2
    // and a triangle draw about 0.22, 0.57425 either way; shot east at 1.6 with nothing off, east
    // at 1.6, facing it, its ticks in the ground none.
    let item = snbt("\{id:\"minecraft:arrow\",count:1\}")
    let bow = snbt("\{id:\"minecraft:bow\",count:1\}")
    var fired = Arrow.fired(15, 1103, 1.5, 2.0, 3.5, (5i64, 6i64), item, bow)
    check(fired.owner == some((5i64, 6i64)) and fired.pickup == DISALLOWED and fired.weapon != none, "a mob's arrow, its owner's")
    fired.base_from_mob(1.0f32, 2)
    check(fired.base_damage >= 2.22 - 0.57425 and fired.base_damage <= 2.22 + 0.57425, "a mob's arrow's damage")
    fired.life = 5
    fired.shoot(3.0, 0.0, 0.0, 1.6f32, 0.0f32)
    check(fired.body.vx == f64(1.6f32) and fired.body.vy == 0.0 and fired.body.vz == 0.0, "shot east at 1.6")
    check((fired.body.y_rot - 90.0f32).abs() < 0.001f32 and fired.body.x_rot == 0.0f32 and fired.life == 0 and fired.body.needs_sync, "facing east, its life none")

    // Tipped arrows' colours, their potions' (D513): a mob's of poison, opaque; one loaded with
    // its own colour; a plain one's and an empty tipped one's none.
    check(fired.color() == -1, "a plain arrow, no colour")
    let poison = snbt("\{id:\"minecraft:tipped_arrow\",count:1,components:\{\"minecraft:potion_contents\":\{potion:\"minecraft:poison\"\}\}\}")
    let shot = Arrow.fired(16, 1103, 1.5, 2.0, 3.5, (5i64, 6i64), poison, bow)
    check(shot.color() == -7888029, "poison's colour")
    let red = snbt("\{id:\"minecraft:tipped_arrow\",count:1,components:\{\"minecraft:potion_contents\":\{custom_color:16711680\}\}\}")
    let empty = snbt("\{id:\"minecraft:tipped_arrow\",count:1,components:\{\"minecraft:potion_contents\":\{\}\}\}")
    let pos = compound(snbt("\{Pos:[0.0d,0.0d,0.0d]\}"))
    let reddened = Arrow.loaded(17, 1103, pos.copy(), some(red), none, none, mut lines) else panic("not loaded")
    let none_shown = Arrow.loaded(18, 1103, pos, some(empty), none, none, mut lines) else panic("not loaded")
    check(reddened.color() == 16711680 and none_shown.color() == -1, "its own colour, and an empty potion's none")
    println("ok")
}
