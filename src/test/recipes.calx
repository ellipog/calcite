/// Checks recipes (CAL-146): each kind read as its codec reads it, with vanilla's messages for
/// what doesn't read, a shaped recipe's pattern shrunk to its symbols, and what the vanilla
/// data's recipes make of the property sets and the stonecutter's recipes. Run from the
/// repository's root, as it reads the pinned server jar in oracle/jars/.
module test.recipes

import json.tree.{parse}
import nbt.tag.{Tag}
import pack.vanilla.{vanilla_jar, vanilla_only}
import protocol.wire.{Reader, Writer}
import registry.codec.{Codecs, Refs}
import registry.load.{load_registries}
import registry.recipes.{recipe, shrunk}
import registry.registries.{Registries, builtin_registries}
import registry.registry.{Tag as ItemTag}
import registry.streams.{Streams}
import resources.identifier.{Identifier}
import rig.nbt.{load_language}
import server.log.{Entry}
import world.recipes.{Recipes}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn id(path: str) -> Identifier {
    return Identifier { namespace: "minecraft", path: String(path) }
}

// The built-in registries, with the item tags `minecraft:planks`, of oak and birch planks, and
// `minecraft:nothing`, empty.
fn registries() -> Registries {
    var builtin = builtin_registries()
    for i in 0..builtin.len() {
        if builtin[i].name.path != "item" {
            continue
        }
        let oak = builtin[i].id(id("oak_planks")) ?? -1
        let birch = builtin[i].id(id("birch_planks")) ?? -1
        builtin[i].tags.push(ItemTag { name: id("planks"), values: [oak, birch] })
        builtin[i].tags.push(ItemTag { name: id("nothing"), values: [] })
    }
    return Registries { synced: [], builtin: builtin }
}

// What the recipe `text` reads as, in SNBT, or its error.
fn read(r: Registries, text: String) -> String {
    var c = Codecs.new()
    c.frozen = true
    let at = recipe(mut c)
    let json = parse(text) else panic("not JSON: {text}")
    var refs = Refs.new()
    var got = c.read(at, json, r, mut refs)
    if let e = got.error.take() {
        return "error: {e}"
    }
    if let t = got.thrown.take() {
        return "thrown: {t}"
    }
    let value = got.value.take() ?? Tag.End
    return value.to_snbt()
}

fn kinds() {
    let r = registries()
    check(read(r, "\{\"type\":\"minecraft:crafting_shaped\",\"key\":\{\"#\":\"minecraft:stick\"\},\"pattern\":[\"#\",\"#\"],\"result\":\{\"id\":\"minecraft:torch\",\"count\":4\}\}"), "\{key:\{\"#\":\"minecraft:stick\"\},pattern:[\"#\",\"#\"],result:\{count:4,id:\"minecraft:torch\"\},type:\"minecraft:crafting_shaped\"\}")
    // Left out, the book's category and group and the notification are their defaults, which
    // aren't written; given, they are.
    check(read(r, "\{\"type\":\"minecraft:crafting_shapeless\",\"category\":\"redstone\",\"group\":\"g\",\"show_notification\":false,\"ingredients\":[\"#minecraft:planks\",[\"minecraft:stick\",\"minecraft:coal\"]],\"result\":\"minecraft:torch\"\}"), "\{category:\"redstone\",group:\"g\",ingredients:[\"#minecraft:planks\",[\"minecraft:stick\",\"minecraft:coal\"]],result:\{id:\"minecraft:torch\"\},show_notification:0b,type:\"minecraft:crafting_shapeless\"\}")
    check(read(r, "\{\"type\":\"minecraft:smelting\",\"ingredient\":\"minecraft:raw_iron\",\"result\":\{\"id\":\"minecraft:iron_ingot\"\},\"experience\":0.7,\"cookingtime\":200\}"), "\{cookingtime:200,experience:0.7f,ingredient:\"minecraft:raw_iron\",result:\{id:\"minecraft:iron_ingot\"\},type:\"minecraft:smelting\"\}")
    check(read(r, "\{\"type\":\"minecraft:smelting\",\"ingredient\":\"minecraft:raw_iron\",\"result\":\{\"id\":\"minecraft:iron_ingot\"\}\}"), "error: No key cookingtime in MapLike[\{\"type\":\"minecraft:smelting\",\"ingredient\":\"minecraft:raw_iron\",\"result\":\{\"id\":\"minecraft:iron_ingot\"\}\}]")
    check(read(r, "\{\"type\":\"minecraft:stonecutting\",\"ingredient\":\"minecraft:andesite\",\"result\":\{\"id\":\"minecraft:andesite_slab\",\"count\":2\}\}"), "\{ingredient:\"minecraft:andesite\",result:\{count:2,id:\"minecraft:andesite_slab\"\},type:\"minecraft:stonecutting\"\}")
    check(read(r, "\{\"type\":\"minecraft:smithing_transform\",\"template\":\"minecraft:netherite_upgrade_smithing_template\",\"base\":\"minecraft:diamond_sword\",\"addition\":\"minecraft:netherite_ingot\",\"result\":\{\"id\":\"minecraft:netherite_sword\"\}\}"), "\{addition:\"minecraft:netherite_ingot\",base:\"minecraft:diamond_sword\",result:\{id:\"minecraft:netherite_sword\"\},template:\"minecraft:netherite_upgrade_smithing_template\",type:\"minecraft:smithing_transform\"\}")
    check(read(r, "\{\"type\":\"minecraft:crafting_transmute\",\"input\":\"minecraft:stick\",\"material\":\"minecraft:coal\",\"material_count\":\{\"min\":1,\"max\":8\},\"result\":\"minecraft:torch\"\}"), "\{input:\"minecraft:stick\",material:\"minecraft:coal\",material_count:\{max:8,min:1\},result:\{id:\"minecraft:torch\"\},type:\"minecraft:crafting_transmute\"\}")
    check(read(r, "\{\"type\":\"minecraft:crafting_transmute\",\"input\":\"minecraft:stick\",\"material\":\"minecraft:coal\",\"material_count\":9,\"result\":\{\"count\":2\}\}"), "error: Range must be within [1..8], but was [9..9]")
    check(read(r, "\{\"type\":\"minecraft:crafting_transmute\",\"input\":\"minecraft:stick\",\"material\":\"minecraft:coal\",\"material_count\":\{\"min\":2\},\"result\":\"minecraft:torch\"\}"), "error: Range must be within [1..8], but was [2..+∞)")
    check(read(r, "\{\"type\":\"minecraft:crafting_special_bookcloning\",\"source\":\"minecraft:written_book\",\"material\":\"minecraft:writable_book\",\"result\":\"minecraft:written_book\"\}"), "\{material:\"minecraft:writable_book\",result:\{id:\"minecraft:written_book\"\},source:\"minecraft:written_book\",type:\"minecraft:crafting_special_bookcloning\"\}")
    check(read(r, "\{\"type\":\"minecraft:crafting_special_bookcloning\",\"source\":\"minecraft:written_book\",\"material\":\"minecraft:writable_book\",\"allowed_generations\":\{\"min\":0,\"max\":3\},\"result\":\"minecraft:written_book\"\}"), "error: Range must be within [0..2], but was [0..3]")
    check(read(r, "\{\"type\":\"minecraft:crafting_special_firework_star\",\"shapes\":\{\"star\":\"minecraft:gold_nugget\",\"creeper\":\"minecraft:creeper_head\"\},\"trail\":\"minecraft:diamond\",\"twinkle\":\"minecraft:glowstone_dust\",\"fuel\":\"minecraft:gunpowder\",\"dye\":\"minecraft:red_dye\",\"result\":\"minecraft:firework_star\"\}"), "\{dye:\"minecraft:red_dye\",fuel:\"minecraft:gunpowder\",result:\{id:\"minecraft:firework_star\"\},shapes:\{creeper:\"minecraft:creeper_head\",star:\"minecraft:gold_nugget\"\},trail:\"minecraft:diamond\",twinkle:\"minecraft:glowstone_dust\",type:\"minecraft:crafting_special_firework_star\"\}")
    check(read(r, "\{\"type\":\"minecraft:crafting_special_repairitem\"\}"), "\{type:\"minecraft:crafting_special_repairitem\"\}")
    check(read(r, "\{\"type\":\"minecraft:brewing\",\"input\":\{\"item\":\"minecraft:potion\",\"potion_contents\":\{\"potions\":\"minecraft:water\"\}\},\"reagent\":\{\"item\":\"minecraft:nether_wart\"\},\"output\":\"minecraft:potion\"\}"), "\{input:\{item:\"minecraft:potion\",potion_contents:\{potions:\"minecraft:water\"\}\},output:\{id:\"minecraft:potion\"\},reagent:\{item:\"minecraft:nether_wart\"\},type:\"minecraft:brewing\"\}")
}

fn errors() {
    let r = registries()
    let shaped = "\"type\":\"minecraft:crafting_shaped\",\"result\":\"minecraft:torch\""
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\",\"X\":\"minecraft:coal\",\"Y\":\"minecraft:coal\"\},\"pattern\":[\"#\"]\}"), "error: Key defines symbols that aren't used in pattern: \{X, Y\}")
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\"\},\"pattern\":[\"#Y\"]\}"), "error: Pattern references symbol 'Y' but it's not defined in the key")
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\"\},\"pattern\":[\"#\",\"#\",\"#\",\"#\"]\}"), "error: Invalid pattern: too many rows, 3 is maximum")
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\"\},\"pattern\":[]\}"), "error: Invalid pattern: empty pattern not allowed")
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\"\},\"pattern\":[\"####\"]\}"), "error: Invalid pattern: too many columns, 3 is maximum")
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\"\},\"pattern\":[\"##\",\"#\"]\}"), "error: Invalid pattern: each row must be the same width")
    check(read(r, "\{{shaped},\"key\":\{\"ab\":\"minecraft:stick\"\},\"pattern\":[\"a\"]\}"), "error: Invalid key entry: 'ab' is an invalid symbol (must be 1 character only).")
    check(read(r, "\{{shaped},\"key\":\{\" \":\"minecraft:stick\"\},\"pattern\":[\"#\"]\}"), "error: Invalid key entry: ' ' is a reserved symbol.")
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\",\"X\":\"minecraft:air\"\},\"pattern\":[\"#X\"]\}"), "error: Map entry 'X' : Failed to parse either. First: Not a tag id; Second: Failed to parse either. First: Not a json array: \"minecraft:air\"; Second: Item must not be minecraft:air")
    check(read(r, "\{{shaped},\"key\":\{\"#\":\"minecraft:stick\"\},\"pattern\":[\"   \",\"   \"]\}"), "error: java.lang.ArrayIndexOutOfBoundsException: Index 0 out of bounds for length 0")
    let single = "\"type\":\"minecraft:stonecutting\",\"result\":\"minecraft:stone_slab\""
    check(read(r, "\{{single},\"ingredient\":\"minecraft:air\"\}"), "error: Failed to parse either. First: Not a tag id; Second: Failed to parse either. First: Not a json array: \"minecraft:air\"; Second: Item must not be minecraft:air")
    check(read(r, "\{{single},\"ingredient\":[]\}"), "error: List must have contents")
    check(read(r, "\{{single},\"ingredient\":\"#minecraft:missing\"\}"), "error: Missing tag: 'minecraft:missing' in 'minecraft:item'")
    check(read(r, "\{{single},\"ingredient\":\"minecraft:nope\"\}"), "error: Failed to parse either. First: Not a tag id; Second: Failed to parse either. First: Not a json array: \"minecraft:nope\"; Second: Unknown registry key in ResourceKey[minecraft:root / minecraft:item]: minecraft:nope")
    check(read(r, "\{{single},\"ingredient\":[\"minecraft:stone\",\"minecraft:air\"]\}"), "error: Item must not be minecraft:air")
    check(read(r, "\{\"type\":\"minecraft:nope\"\}"), "error: Unknown registry key in ResourceKey[minecraft:root / minecraft:recipe_serializer]: minecraft:nope")
    check(read(r, "\{\"type\":\"minecraft:smelting\",\"ingredient\":\"minecraft:raw_iron\",\"result\":\"minecraft:iron_ingot\"\}"), "error: No key cookingtime in MapLike[\{\"type\":\"minecraft:smelting\",\"ingredient\":\"minecraft:raw_iron\",\"result\":\"minecraft:iron_ingot\"\}]")
    check(read(r, "\{\"type\":\"minecraft:crafting_shapeless\",\"ingredients\":[\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\",\"minecraft:stick\"],\"result\":\"minecraft:torch\"\}"), "error: List is too long: 10, expected range [1-9]")
}

fn shrinking() {
    check("{shrunk(["   ", " # ", "   "])}", "[#]")
    check("{shrunk(["#  ", "   ", "  #"])}", "[#  ,    ,   #]")
    check("{shrunk([" ##", " # "])}", "[##, # ]")
    check("{shrunk(["   ", "   "])}", "[]")
}

// The vanilla data's recipes, all of them read, and the property sets and stonecutter's recipes
// vanilla sends, by how many items each set holds and how many recipes the stonecutter has.
fn vanilla() {
    var logs = List<Entry>()
    let resources = vanilla_only(vanilla_jar(String("oracle/jars/server-26.3.jar"))!)
    let lang = load_language()!
    let r = load_registries(resources, some(lang), mut logs) else panic("the registries didn't load")
    check("{r.reloadable.len()} {r.reloadable[0].name.to_string()} {r.reloadable[0].entries.len()}", "1 minecraft:recipe 2042")
    var warnings = List<Entry>()
    let recipes = Recipes.of(r, Streams.new(), mut warnings)
    check("{recipes.all.len()} {warnings.len()}", "2042 0")
    var sets = String()
    for (key, items) in recipes.item_sets {
        sets.push_str(" {key.path}={items.len()}")
    }
    check(sets, " smithing_base=37 smithing_template=19 smithing_addition=11 furnace_input=163 blast_furnace_input=62 smoker_input=9 campfire_input=9 brewing_input=3 brewing_reagent=21")
    var w = Writer.new()
    recipes.stonecutter.write(mut w)
    var rd = Reader.new(w.into_bytes())
    check("{rd.varint()!}", "351")
}

fn main() {
    kinds()
    errors()
    shrinking()
    vanilla()
    print("ok")
}
