/// Checks `storage.level`: a `level.dat` read and written and read again, the defaults of one
/// with nothing in it, and what's dropped or replaced on the way. The rig's `level_data` probe
/// checks every byte against vanilla's `PrimaryLevelData`.
module test.level_data

import nbt.snbt.{parse_compound}
import nbt.tag.{Tag}
import storage.level.{LevelData, VANILLA_FEATURES}
import world.modes.{Difficulty, GameType}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn read(snbt: String) -> LevelData {
    return match parse_compound(snbt)! {
        Tag.Compound(tags) => LevelData.parse(tags),
        _ => panic("not a compound"),
    }
}

fn field(tag: Tag, key: String) -> String {
    return match tag {
        Tag.Compound(tags) => if tags.contains(key) { tags[key].to_snbt() } else { String("none") },
        _ => panic("not a compound"),
    }
}

fn main() {
    // Nothing in it: a normal survival world, spawning at 0 0 0 in the overworld.
    let empty = read("\{\}")
    check("{empty.game_type == GameType.Survival} {empty.difficulty.difficulty == Difficulty.Normal} {empty.commands} {empty.initialized}", "true true false true", "the defaults")
    check("{empty.spawn.dimension.to_string()} {empty.spawn.pos.y} {empty.features == VANILLA_FEATURES}", "minecraft:overworld 0 true", "the default spawn")
    let blank = empty.write(0)
    check(field(blank, "version_history"), "[5023]", "the current version added")
    let packs = field(blank, "DataPacks")
    let flags = field(blank, "enabled_features")
    check("{packs} {flags}", "none none", "the default packs and flags left out")

    // Creative allows commands unless it says otherwise.
    check("{read("\{GameType: 1\}").commands} {read("\{GameType: 1, allowCommands: 0b\}").commands}", "true false", "creative's commands")

    let snbt = String("\{LevelName: \"Test\", GameType: 2, Time: 99L, difficulty_settings: \{difficulty: \"hard\", hardcore: 1b, locked: 0b\}, spawn: \{dimension: \"the_nether\", pos: [I; 1, 2, 3], yaw: 90.0f, pitch: -0.0f\}, ServerBrands: [\"vanilla\", \"Paper\", \"vanilla\"], version_history: [4000], singleplayer_uuid: [I; 1, 2, 3, 4], enabled_features: [\"vanilla\", \"trade_rebalance\"], DataPacks: \{Enabled: [\"vanilla\"], Disabled: []\}, raining: 1b, version: 1\}")
    let level = read(snbt)
    check("{level.name} {level.game_type == GameType.Adventure} {level.time} {level.difficulty.hardcore}", "Test true 99 true", "what was read")
    check("{level.spawn.dimension.to_string()} {level.spawn.pos.z} {level.brands.len()} {level.features}", "minecraft:the_nether 3 2 3", "the spawn, brands and flags")
    let written = level.write(5)
    check(field(written, "raining"), "none", "what 26.3 doesn't keep")
    let version = field(written, "version")
    let saved = field(written, "LastPlayed")
    check("{version} {saved}", "19133 5L", "the format's version and the time saved")
    check(field(written, "version_history"), "[4000,5023]", "the history")
    check(field(written, "singleplayer_uuid"), "[I;1,2,3,4]", "the player")
    check(field(written, "enabled_features"), "[\"minecraft:vanilla\",\"minecraft:trade_rebalance\"]", "the flags")
    // `-0.0f` is written as `0.0f`, as vanilla's `FloatTag.valueOf` makes it.
    check(field(written, "spawn"), "\{dimension:\"minecraft:the_nether\",pitch:0.0f,pos:[I;1,2,3],yaw:90.0f\}", "the spawn")
    let again = read(written.to_snbt()).write(5)
    check(again.to_snbt(), written.to_snbt(), "written again")

    // A spawn that can't be read is the default, as a whole.
    check("{read("\{spawn: \{dimension: \"overworld\", pos: [I; 1, 2, 3], yaw: 181.0f, pitch: 0.0f\}\}").spawn.pos.x}", "0", "a yaw out of range")
    print("ok")
}
