/// Checks `world.attributes` against what vanilla's `AttributeMap` and `AttributeInstance` do: the
/// facts against the attribute registry, values worked out from each operation, instances made as
/// they're first asked for and sent once they change, saved and read back, and the modifiers of
/// worn and held stacks, their own and their enchantments', put on and taken off as equipment
/// changes; the creative ranges; and sprinting. The items are read against the vanilla data
/// pack's registries, from the server jar, as the rig's adapter loads them.
module test.attributes

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import rig.registries.{load_vanilla}
import world.attributes.{ADD_MULTIPLIED_BASE, ADD_MULTIPLIED_TOTAL, ADD_VALUE, Attributes, Modifier, Snapshot, attribute_id, attribute_name, equip, sprint, stack_modifiers, unworn, update_player}
import world.entity_facts.{attribute_names}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn stack(text: str) -> Tag? {
    return some(parse(String(text))!)
}

fn id(name: str) -> u32 {
    return attribute_id(String(name)) ?? 9999
}

// The attributes sent, by name, each with its base and modifiers, in the order given.
fn sent(list: List<Snapshot>) -> String {
    var out = String()
    for s in list {
        if not out.is_empty() {
            out.push_str("; ")
        }
        out.push_str(attribute_name(s.attribute))
        out.push_str(" {s.base}")
        for m in s.modifiers {
            out.push_str(" {m.id.to_string()}={m.amount}/{m.operation}")
        }
    }
    return out
}

fn main() {
    let loaded = load_vanilla()!
    let items = loaded.items.value.copy()

    // The facts are in the attribute registry's order.
    let names = attribute_names()
    for i in 0..names.len() {
        let want = items.builtin_name("attribute", i32.wrap(i)) ?? String("-")
        check("minecraft:{names[i]}", want, "attribute {i}")
    }
    check("{items.builtin_name("attribute", i32.wrap(names.len())) ?? String("-")}", "-", "no attribute past the facts'")

    // Values: added, then multiplied by the base, then by the total, then kept in range; and
    // none made by asking for a value.
    var a = Attributes()
    let armor = id("armor")
    check("{a.value(armor)}", "0.0", "armor with nothing on")
    check("{a.value(id("movement_speed"))}", "0.10000000149011612", "a player's walking speed")
    check("{a.instances.len()}", "0", "instances made by asking for values")
    a.replace(armor, Modifier.named("a", 4.0, ADD_VALUE))
    a.replace(armor, Modifier.named("b", 0.5, ADD_MULTIPLIED_BASE))
    a.replace(armor, Modifier.named("c", 1.0, ADD_MULTIPLIED_TOTAL))
    check("{a.value(armor)}", "12.0", "4, half again, doubled")
    a.replace(armor, Modifier.named("d", 100.0, ADD_VALUE))
    check("{a.value(armor)}", "30.0", "armor at its most")
    a.take_off(armor, Modifier.named("d", 0.0, ADD_VALUE).id)
    a.replace(armor, Modifier.named("a", 2.0, ADD_VALUE))
    check("{a.value(armor)}", "6.0", "a modifier put in place of one with its ID")
    check(sent(a.take_synced()), "minecraft:armor 0.0 minecraft:b=0.5/1 minecraft:c=1.0/2 minecraft:a=2.0/0", "armor sent, its modifiers in the order they came")
    check(sent(a.take_synced()), "", "nothing sent twice")
    // An attribute that isn't sent is made but not sent.
    a.replace(id("attack_damage"), Modifier.named("base_attack_damage", 6.0, ADD_VALUE))
    check("{a.value(id("attack_damage"))}", "7.0", "attack damage, 1 and 6")
    check(sent(a.take_synced()), "", "attack damage isn't sent")
    // Many modifiers of one operation, past where its map doubles, and taken off again.
    for i in 0..40 {
        a.replace(id("luck"), Modifier.named("m{i}", 1.0, ADD_VALUE))
    }
    check("{a.value(id("luck"))}", "40.0", "40 modifiers of luck")
    for i in 0..39 {
        a.take_off(id("luck"), Modifier.named("m{i}", 0.0, ADD_VALUE).id)
    }
    check("{a.value(id("luck"))}", "1.0", "one left")

    // Saved and read back: each instance with its base and the modifiers saved with it, which
    // transient ones aren't.
    var b = Attributes()
    b.set_base(id("movement_speed"), 0.25)
    b.apply(parse(String("[\{id:\"minecraft:max_health\",base:30.0d,modifiers:[\{id:\"minecraft:extra\",amount:2.0d,operation:\"add_value\"\}]\},\{id:\"nope\",base:1.0d\},\{id:\"armor\"\}]"))!)
    check("{b.value(id("max_health"))}", "32.0", "saved health and its modifier")
    check("{b.value(id("armor"))}", "0.0", "armor saved without a base")
    check(sent(b.take_synced()), "minecraft:movement_speed 0.25; minecraft:max_health 30.0 minecraft:extra=2.0/0; minecraft:armor 0.0", "what's read is sent")
    b.replace(id("max_health"), Modifier.named("worn", 4.0, ADD_VALUE))
    let packed = b.pack()
    var c = Attributes()
    c.apply(packed)
    check("{c.value(id("max_health"))}", "32.0", "the worn modifier isn't saved")
    check("{c.value(id("movement_speed"))}", "0.25", "the base is")

    // What's worn: a diamond helmet's armor and toughness on the head and none in a hand, and a
    // sword's damage and speed in the main hand only.
    let helmet = stack("\{id:\"minecraft:diamond_helmet\",count:1\}")
    var on_head = List<String>()
    for (attribute, m) in stack_modifiers(helmet.copy() ?? Tag.Byte(0), 5, items) {
        on_head.push("{attribute_name(attribute)} {m.id.to_string()}={m.amount}")
    }
    check("{on_head.len()}", "2", "a helmet's modifiers")
    check(on_head[0].copy(), "minecraft:armor minecraft:armor.helmet=3.0", "a helmet's armor")
    check(on_head[1].copy(), "minecraft:armor_toughness minecraft:armor.helmet=2.0", "a helmet's toughness")
    check("{stack_modifiers(helmet.copy() ?? Tag.Byte(0), 0, items).len()}", "0", "a helmet in a hand")
    let pick = stack("\{id:\"minecraft:diamond_pickaxe\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:efficiency\":3\}\}\}")
    var held = List<String>()
    for (attribute, m) in stack_modifiers(pick.copy() ?? Tag.Byte(0), 0, items) {
        held.push("{attribute_name(attribute)} {m.id.to_string()}={m.amount}")
    }
    check("{held.len()}", "3", "an enchanted pickaxe's modifiers")
    check(held[2].copy(), "minecraft:mining_efficiency minecraft:enchantment.efficiency/mainhand=10.0", "efficiency III, 3 squared and 1")

    // Equipment changing: the helmet put on, the sword held, then the helmet off.
    var p = Attributes()
    var worn = unworn()
    var now = unworn()
    now[0] = stack("\{id:\"minecraft:diamond_sword\",count:1\}")
    now[5] = helmet.copy()
    check("{equip(mut p, mut worn, now, items)}", "false", "nothing swapped")
    check("{p.value(armor)}", "3.0", "the helmet's armor")
    check("{p.value(id("attack_speed"))}", "1.5999999046325684", "the sword's speed")
    check(sent(p.take_synced()), "minecraft:attack_speed 4.0 minecraft:base_attack_speed=-2.4000000953674316/0; minecraft:armor 0.0 minecraft:armor.helmet=3.0/0; minecraft:armor_toughness 0.0 minecraft:armor.helmet=2.0/0", "what changed is sent")
    _ = equip(mut p, mut worn, now, items)
    check(sent(p.take_synced()), "", "nothing changed")
    now[5] = none
    _ = equip(mut p, mut worn, now, items)
    check("{p.value(armor)}", "0.0", "the helmet off")
    check(sent(p.take_synced()), "minecraft:armor 0.0; minecraft:armor_toughness 0.0", "armor sent again")
    // The hands swapped.
    now[1] = stack("\{id:\"minecraft:torch\",count:3\}")
    _ = equip(mut p, mut worn, now, items)
    _ = p.take_synced()
    let in_hand = now[0].copy()
    now[0] = now[1].copy()
    now[1] = in_hand
    check("{equip(mut p, mut worn, now, items)}", "true", "the hands swapped")
    check("{p.value(id("attack_speed"))}", "4.0", "the sword in the offhand")
    // A broken sword gives nothing.
    var q = Attributes()
    var q_worn = unworn()
    var q_now = unworn()
    q_now[0] = stack("\{id:\"minecraft:diamond_sword\",count:1,components:\{\"minecraft:damage\":1561\}\}")
    _ = equip(mut q, mut q_worn, q_now, items)
    check("{q.value(id("attack_speed"))}", "4.0", "a broken sword")

    // Creative mode's ranges, on once, and off again.
    var r = Attributes()
    update_player(mut r, true)
    check("{r.value(id("block_interaction_range"))}", "5.0", "creative block range")
    check("{r.value(id("entity_interaction_range"))}", "5.0", "creative entity range")
    check(sent(r.take_synced()), "minecraft:block_interaction_range 4.5 minecraft:creative_mode_block_range=0.5/0; minecraft:entity_interaction_range 3.0 minecraft:creative_mode_entity_range=2.0/0", "the ranges sent")
    update_player(mut r, true)
    check(sent(r.take_synced()), "", "the ranges not sent again")
    update_player(mut r, false)
    check(sent(r.take_synced()), "minecraft:block_interaction_range 4.5; minecraft:entity_interaction_range 3.0", "the ranges off")
    var s = Attributes()
    update_player(mut s, false)
    check(sent(s.take_synced()), "minecraft:block_interaction_range 4.5; minecraft:entity_interaction_range 3.0", "made as they're asked for")
    check("{s.instances.len()}", "3", "the waypoint range made too")

    // Sprinting: 30% faster in all.
    sprint(mut s, true)
    check("{s.value(id("movement_speed"))}", "0.13000000312924387", "sprinting")
    sprint(mut s, false)
    check("{s.value(id("movement_speed"))}", "0.10000000149011612", "walking again")
    print("ok")
}
