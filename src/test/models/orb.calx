module test.models.orb

// An independent model of vanilla's ExperienceOrb and of Block.popExperience, written from the
// decompiled Java apart from Calcite's, for test/experience_orb.calx and test/drops.calx: an orb
// made with seed 148, falling onto stone and bouncing; one made with seed 149 following a player;
// and the level's random as breaking blocks that drop experience draws from it. It prints what
// the tests check, each double as its bits.
//
//     calx src/test/models/orb.calx

// A double rounded to a float, as Java's `(float)` does, and kept as a double.
fn f32r(x: f64) -> f64 {
    return f64(f32.nearest(x))
}

fn bits(x: f64) -> i64 {
    return i64.wrap(x.to_bits())
}

fn float_bits(x: f64) -> u32 {
    return f32.nearest(x).to_bits()
}

// An int, as Java's `(int)` keeps the low 32 bits of a long.
fn int(v: i64) -> i64 {
    return i64(i32.wrap(v))
}

const MASK: i64 = (1i64 << 48) - 1

/// java.util.Random, which LegacyRandomSource is.
struct JavaRandom {
    seed: i64
}

fn java_random(seed: i64) -> JavaRandom {
    return JavaRandom { seed: (seed ^ 0x5DEECE66D) & MASK }
}

fn next(r: mut JavaRandom, n: i64) -> i64 {
    r.seed = (r.seed * 0x5DEECE66D + 0xB) & MASK
    return int(r.seed >> (48 - n))
}

fn next_int(r: mut JavaRandom, bound: i64) -> i64 {
    var v = next(mut r, 31)
    let m = bound - 1
    if bound & m == 0 {
        return int((bound * v) >> 31)
    }
    var u = v
    loop {
        v = u % bound
        if int(u - v + m) >= 0 {
            return v
        }
        u = next(mut r, 31)
    }
}

fn next_long(r: mut JavaRandom) -> i64 {
    let hi = next(mut r, 32)
    let lo = next(mut r, 32)
    return (hi << 32) + lo
}

fn next_float(r: mut JavaRandom) -> f64 {
    return f64.nearest(next(mut r, 24) & 0xFFFFFF) / 16777216.0
}

fn next_double(r: mut JavaRandom) -> f64 {
    let hi = next(mut r, 26) & ((1i64 << 26) - 1)
    let lo = next(mut r, 27) & ((1i64 << 27) - 1)
    return f64.nearest((hi << 27) + lo) * (1.0 / 9007199254740992.0)
}

const GRAVITY: f64 = 0.03
const HALF: f64 = 0.25
const HEIGHT: f64 = 0.5

/// `new ExperienceOrb(level, pos, Vec3.ZERO, value)`: Entity's random and UUID, then its spin, then
/// its motion.
struct Orb {
    most: i64
    least: i64
    y_rot: f64
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    on_ground: bool
    following: bool
}

fn orb(seed: i64, x: f64, y: f64, z: f64) -> Orb {
    var r = java_random(seed)
    let most = (next_long(mut r) & -61441) | 16384
    let least = (next_long(mut r) & 4611686018427387903) | i64.MIN
    let y_rot = f32r(next_float(mut r) * 360.0)
    let vx = (next_double(mut r) * 0.2 - 0.1) * 2.0
    let vy = next_double(mut r) * 0.2 * 2.0
    let vz = (next_double(mut r) * 0.2 - 0.1) * 2.0
    return Orb { most: most, least: least, y_rot: y_rot, x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, on_ground: false, following: false }
}

/// How many stone blocks of the y 0 row and below meet the box, as BlockCollisions finds them.
fn floor_meets(minx: f64, miny: f64, minz: f64, maxx: f64, maxy: f64, maxz: f64) -> i64 {
    if not (miny < 1.0 and maxy > -64.0) {
        return 0
    }
    var n = 0i64
    for bx in i64.saturate((minx - 1e-7).floor())..=i64.saturate((maxx + 1e-7).floor()) {
        for bz in i64.saturate((minz - 1e-7).floor())..=i64.saturate((maxz + 1e-7).floor()) {
            let fx = f64.nearest(bx)
            let fz = f64.nearest(bz)
            if minx < fx + 1.0 and maxx > fx and minz < fz + 1.0 and maxz > fz {
                n += 1
            }
        }
    }
    return n
}

/// `collide` against the floor, the only thing there is: only a fall can be stopped, by the top
/// of the stone at y 1.
fn collide_y(o: Orb, dy: f64) -> f64 {
    if dy >= 0.0 {
        return dy
    }
    let miny = o.y
    if floor_meets(o.x - HALF, miny + dy, o.z - HALF, o.x + HALF, miny + HEIGHT, o.z + HALF) == 0 {
        return dy
    }
    if dy.abs() < 1e-7 {
        return 0.0
    }
    let gap = 1.0 - miny
    if gap <= 1e-7 and gap > dy {
        return gap
    }
    return dy
}

/// `Entity.move`, then `restituteMovementAfterCollisions` on stone, whose bounciness is none.
fn move_by(o: mut Orb, dx: f64, dy: f64, dz: f64) -> bool {
    let my = collide_y(o, dy)
    let mx = dx
    let mz = dz
    let asked = dx * dx + dy * dy + dz * dz
    let length = mx * mx + my * my + mz * mz
    if length > 1e-7 or asked - length < 1e-7 {
        o.x = o.x + mx
        o.y = o.y + my
        o.z = o.z + mz
    }
    let vertical = dy != my
    let below = vertical and dy < 0.0
    o.on_ground = below
    if dy.abs() > 0.0 and vertical {
        // Restitution 0: (gravityCompensation - y) * effectiveDrag * restitution.
        o.vy = (0.0 - o.vy) * 1.0 * 0.0
    }
    // The block speed factor of stone is 1.
    o.vx = o.vx * 1.0
    o.vy = o.vy * 1.0
    o.vz = o.vz * 1.0
    return below
}

/// A player the orb may follow: where they stand, and their eye height.
struct Player {
    x: f64
    y: f64
    z: f64
    eyes: f64
}

/// `ExperienceOrb.tick` on the stone floor, nothing in its box, no fluid, no other orb.
fn tick(o: mut Orb, player: Player?) {
    let colliding = floor_meets(o.x - HALF, o.y, o.z - HALF, o.x + HALF, o.y + HEIGHT, o.z + HALF) > 0
    if not colliding {
        o.vy = o.vy + -GRAVITY
    }
    if let p = player {
        let d = (p.x - o.x) * (p.x - o.x) + (p.y - o.y) * (p.y - o.y) + (p.z - o.z) * (p.z - o.z)
        if o.following and d > 64.0 {
            o.following = false
        }
        if not o.following and d < 64.0 {
            o.following = true
        }
        if o.following {
            let ex = p.x - o.x
            let ey = p.y + f32r(p.eyes) / 2.0 - o.y
            let ez = p.z - o.z
            let length = ex * ex + ey * ey + ez * ez
            let power = 1.0 - length.sqrt() / 8.0
            let dist = (ex * ex + ey * ey + ez * ez).sqrt()
            var (nx, ny, nz) = (0.0, 0.0, 0.0)
            if not (dist < f32r(1.0e-5)) {
                nx = ex / dist
                ny = ey / dist
                nz = ez / dist
            }
            let pull = power * power * 0.1
            o.vx = o.vx + nx * pull
            o.vy = o.vy + ny * pull
            o.vz = o.vz + nz * pull
        }
    }
    let fall_speed = o.vy
    let (dx, dy, dz) = (o.vx, o.vy, o.vz)
    let below = move_by(mut o, dx, dy, dz)
    var friction = f32r(0.98)
    if o.on_ground {
        friction = f32r(friction * f32r(0.6))
    }
    o.vx = o.vx * friction
    o.vy = o.vy * friction
    o.vz = o.vz * friction
    if below and fall_speed < -GRAVITY {
        o.vy = -fall_speed * 0.4
    }
}

fn state(o: Orb) -> String {
    return "{bits(o.x)} {bits(o.y)} {bits(o.z)} {bits(o.vx)} {bits(o.vy)} {bits(o.vz)} {if o.on_ground { 1 } else { 0 }}"
}

/// `awardWithDirection`'s split, `getExperienceValue` of what's left each time.
fn orb_values(total: i64) -> List<i64> {
    var amount = total
    var out: List<i64> = []
    while amount > 0 {
        var v = 1i64
        for s in [2477i64, 1237, 617, 307, 149, 73, 37, 17, 7, 3] {
            if amount >= s {
                v = s
                break
            }
        }
        amount -= v
        out.push(v)
    }
    return out
}

/// A block broken: its name, the stacks its loot pops, whether block_drops is on, and whether
/// silk touch sets its experience to 0.
struct Case {
    name: str
    stacks: i64
    drops: bool
    silk: bool
}

/// `spawnAfterBreak`'s sample of case `i`'s experience range.
fn sample(r: mut JavaRandom, i: usize) -> i64 {
    return match i {
        0 => next_int(mut r, 5) + 3,
        3 => 15 + next_int(mut r, 15) + next_int(mut r, 15),
        4 => next_int(mut r, 5) + 1,
        5 => next_int(mut r, 5) + 3,
        _ => 5,
    }
}

fn main() {
    var o = orb(148, 0.5, 2.0, 0.5)
    println("made {o.most} {o.least} {float_bits(o.y_rot)} {bits(o.vx)} {bits(o.vy)} {bits(o.vz)}")
    for t in 1..=40i64 {
        tick(mut o, none)
        if [1i64, 3, 5, 10, 20, 40].contains(t) {
            println("falling {t} {state(o)}")
        }
    }

    var p = orb(149, 0.5, 1.0, 0.5)
    for t in 1..=20i64 {
        tick(mut p, some(Player { x: 3.5, y: 1.0, z: 0.5, eyes: 1.62 }))
        if [1i64, 2, 5, 10, 20].contains(t) {
            println("following {t} {state(p)}")
        }
    }

    // Blocks broken at 3, -60, 5 with the level's random seeded 0, in turn: each stack its loot
    // gives popped, three nextDoubles each, `popResource`; then `spawnAfterBreak`'s sample of its
    // xp range; then, with block_drops on, each orb's `nextInt(40)` as `tryMergeToExisting` draws
    // it.
    var r = java_random(0)
    let cases: List<Case> = [
        Case { name: "diamond_ore", stacks: 1, drops: true, silk: false },
        Case { name: "sculk_catalyst", stacks: 0, drops: true, silk: false },
        Case { name: "sculk_catalyst silk touch", stacks: 1, drops: true, silk: true },
        Case { name: "spawner", stacks: 0, drops: true, silk: false },
        Case { name: "redstone_ore", stacks: 1, drops: true, silk: false },
        Case { name: "diamond_ore, block_drops off", stacks: 1, drops: false, silk: false },
        Case { name: "sculk_catalyst again", stacks: 0, drops: true, silk: false },
    ]
    for (i, c) in cases.enumerate() {
        var line: List<String> = ["{c.name}:"]
        for _ in 0..c.stacks {
            let px = 3.0 + 0.5 + (next_double(mut r) * 0.5 + -0.25)
            let py = -60.0 + 0.5 + (next_double(mut r) * 0.5 + -0.25) - 0.125
            let pz = 5.0 + 0.5 + (next_double(mut r) * 0.5 + -0.25)
            if c.drops {
                line.push("item({bits(px)},{bits(py)},{bits(pz)})")
            }
        }
        var amount = sample(mut r, i)
        if c.silk {
            amount = 0
        }
        if amount > 0 and c.drops {
            for v in orb_values(amount) {
                line.push("orb({v},{next_int(mut r, 40)})")
            }
        }
        println("award {line.join(" ")}")
    }
    println("after {next_long(mut r)}")
}
