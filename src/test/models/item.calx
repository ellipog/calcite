module test.models.item

// An independent model of vanilla's ItemEntity, written from the decompiled Java apart from
// Calcite's, for test/item_entity.calx: an item made with seed 148, then one falling onto stone
// and sliding. It prints what the test checks, each double as its bits.
//
//     calx src/test/models/item.calx

import std.math.{PI}

// A double rounded to a float, as Java's `(float)` does, and kept as a double.
fn f32r(x: f64) -> f64 {
    return f64(f32.nearest(x))
}

fn bits(x: f64) -> i64 {
    return i64.wrap(x.to_bits())
}

fn float_bits(x: f64) -> u32 {
    return f32.nearest(x).to_bits()
}

fn shown(b: bool) -> str {
    return if b { "True" } else { "False" }
}

const MASK: i64 = (1i64 << 48) - 1

// java.util.Random.
struct JavaRandom {
    seed: i64
}

fn java_random(seed: i64) -> JavaRandom {
    return JavaRandom { seed: (seed ^ 0x5DEECE66D) & MASK }
}

fn next(r: mut JavaRandom, n: i64) -> i64 {
    r.seed = (r.seed * 0x5DEECE66D + 0xB) & MASK
    var v = r.seed >> (48 - n)
    if v >= 1i64 << (n - 1) {
        v -= 1i64 << n
    }
    return v
}

fn next_long(r: mut JavaRandom) -> i64 {
    let hi = next(mut r, 32)
    let lo = next(mut r, 32)
    return (hi << 32) + lo
}

fn next_float(r: mut JavaRandom) -> f64 {
    return f64.nearest(next(mut r, 24) & 0xFFFFFF) / 16777216.0
}

fn next_double(r: mut JavaRandom) -> f64 {
    let hi = next(mut r, 26) & ((1i64 << 26) - 1)
    let lo = next(mut r, 27) & ((1i64 << 27) - 1)
    return f64.nearest((hi << 27) + lo) * (1.0 / 9007199254740992.0)
}

fn half() -> f64 {
    return f32r(0.25) / 2.0
}

// How many stone blocks of the y 0 row BlockCollisions gives for the swept box.
fn ground_shapes(minx: f64, miny: f64, minz: f64, maxx: f64, maxy: f64, maxz: f64) -> i64 {
    if not (miny < 1.0 and maxy > 0.0) {
        return 0
    }
    var n = 0i64
    for bx in i64.saturate((minx - 1e-7).floor())..=i64.saturate((maxx + 1e-7).floor()) {
        for bz in i64.saturate((minz - 1e-7).floor())..=i64.saturate((maxz + 1e-7).floor()) {
            let fx = f64.nearest(bx)
            let fz = f64.nearest(bz)
            if minx < fx + 1.0 and maxx > fx and minz < fz + 1.0 and maxz > fz {
                n += 1
            }
        }
    }
    return n
}

// One axis's movement against the row: only downward movement meets it, its top at y 1.
fn along(axis: i64, d0: f64, n: i64, miny: f64, ry: f64) -> f64 {
    var d = d0
    for _ in 0..n {
        if d.abs() < 1e-7 {
            return 0.0
        }
        if axis == 1 and d < 0.0 {
            let low = miny + ry
            let top = 1.0
            // The row is under the box across, so it counts if its top is below.
            if top <= low + 1e-7 {
                let gap = top - low
                if gap <= 1e-7 and gap > d {
                    d = gap
                }
            }
        }
    }
    return d
}

fn swept(lo: f64, hi: f64, d: f64) -> (f64, f64) {
    if d < 0.0 {
        return (lo + d, hi)
    }
    if d > 0.0 {
        return (lo, hi + d)
    }
    return (lo, hi)
}

fn collide(x: f64, y: f64, z: f64, dx: f64, dy: f64, dz: f64) -> (f64, f64, f64) {
    let (minx, miny, minz) = (x - half(), y, z - half())
    let (maxx, maxy, maxz) = (x + half(), y + f32r(0.25), z + half())
    let (sx0, sx1) = swept(minx, maxx, dx)
    let (sy0, sy1) = swept(miny, maxy, dy)
    let (sz0, sz1) = swept(minz, maxz, dz)
    let n = ground_shapes(sx0, sy0, sz0, sx1, sy1, sz1)
    if n == 0 {
        return (dx, dy, dz)
    }
    var rx = 0.0
    var ry = 0.0
    var rz = 0.0
    if dy != 0.0 {
        ry = along(1, dy, n, miny, ry)
    }
    let order: List<i64> = if dx.abs() < dz.abs() { [2, 0] } else { [0, 2] }
    for a in order {
        if a == 0 and dx != 0.0 {
            rx = along(0, dx, n, miny, ry)
        }
        if a == 2 and dz != 0.0 {
            rz = along(2, dz, n, miny, ry)
        }
    }
    return (rx, ry, rz)
}

struct Tick {
    tick: i64
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    on_ground: bool
}

fn main() {
    var r = java_random(148)
    let most = (next_long(mut r) & -61441) | 16384
    let least = (next_long(mut r) & 4611686018427387903) | i64.MIN
    let bob = f32r(f32r(next_float(mut r) * f32r(PI)) * 2.0)
    let spin = f32r(next_float(mut r) * 360.0)
    let vx0 = next_double(mut r) * 0.2 - 0.1
    let vz0 = next_double(mut r) * 0.2 - 0.1
    println("made {most} {least} {float_bits(bob)} {float_bits(spin)} {bits(vx0)} {bits(vz0)}")

    // Falling onto stone, whose tops are at y 1, and sliding: id 7, from 0.5, 2, 0.5 moving
    // 0.05, 0.1, -0.03.
    let id = 7i64
    var (x, y, z) = (0.5, 2.0, 0.5)
    var (vx, vy, vz) = (0.05, 0.1, -0.03)
    var on_ground = false
    var trace: List<Tick> = []
    for tick in 1..=40i64 {
        vy = vy + -0.04
        let resting = on_ground and not (vx * vx + vz * vz > f32r(1.0e-5)) and (tick + id) % 4 != 0
        if not resting {
            let (dx, dy, dz) = (vx, vy, vz)
            let asked = dx * dx + dy * dy + dz * dz
            let (mx, my, mz) = if asked != 0.0 { collide(x, y, z, dx, dy, dz) } else { (dx, dy, dz) }
            let length = mx * mx + my * my + mz * mz
            if length > 1e-7 or asked - length < 1e-7 {
                x = x + mx
                y = y + my
                z = z + mz
            }
            let x_hit = not ((mx - dx).abs() < f32r(1e-5))
            let z_hit = not ((mz - dz).abs() < f32r(1e-5))
            let vertical = dy != my
            on_ground = vertical and dy < 0.0
            if (dy.abs() > 0.0 and vertical) or x_hit or z_hit {
                let (cx, cy, cz) = (vx, vy, vz)
                var (bx, by, bz) = (cx, cy, cz)
                if x_hit {
                    bx = -cx * 0.0
                }
                if z_hit {
                    bz = -cz * 0.0
                }
                if vertical {
                    by = (0.0 - cy) * 1.0 * 0.0
                }
                vx = bx
                vy = by
                vz = bz
            }
            // The speed factors are all 1.
            vx = vx * 1.0
            vy = vy * 1.0
            vz = vz * 1.0
            let air = f32r(0.98)
            var ground = air
            if on_ground {
                ground = f32r(ground * f32r(0.6))
            }
            vx = vx * ground
            vy = vy * air
            vz = vz * ground
            if on_ground and vy < 0.0 {
                vx = vx * 1.0
                vy = vy * -0.5
                vz = vz * 1.0
            }
        }
        trace.push(Tick { tick: tick, x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, on_ground: on_ground })
    }
    for t in [1usize, 3, 5, 10, 20, 40] {
        let k = trace[t - 1]
        println("tick {k.tick} {bits(k.x)} {bits(k.y)} {bits(k.z)} {bits(k.vx)} {bits(k.vy)} {bits(k.vz)} {shown(k.on_ground)}")
    }
}
