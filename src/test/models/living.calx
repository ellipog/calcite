module test.models.living

// An independent model of vanilla's LivingEntity and ArmorStand moving, written from the decompiled
// Java apart from Calcite's, for test/living.calx: an armor stand falling onto stone, sliding on
// ice, sliding down a ladder, falling into water and into lava; and a living entity walking and
// jumping on stone. Each prints the ticks the test checks, each double as its bits, with the
// sounds played and the dust thrown up.
//
//     calx src/test/models/living.calx

import std.math.{PI, sin}
import std.text.python.{repr_float}

// A double rounded to a float, as Java's `(float)` does, and kept as a double.
fn f32r(x: f64) -> f64 {
    return f64(f32.nearest(x))
}

fn bits(x: f64) -> i64 {
    return i64.wrap(x.to_bits())
}

fn float_bits(x: f64) -> i64 {
    return i64(i32.wrap(i64(f32.nearest(x).to_bits())))
}

fn int(v: i64) -> i64 {
    return i64(i32.wrap(v))
}

fn floor(x: f64) -> i64 {
    return i64.saturate(x.floor())
}

fn ceil(x: f64) -> i64 {
    return i64.saturate(x.ceil())
}

// Python's `min` and `max` of two: the first unless the second is less, or more.
fn least_of(a: f64, b: f64) -> f64 {
    return if b < a { b } else { a }
}

fn most_of(a: f64, b: f64) -> f64 {
    return if b > a { b } else { a }
}

fn shown(b: bool) -> str {
    return if b { "True" } else { "False" }
}

const MASK: i64 = (1i64 << 48) - 1

/// java.util.Random, which LegacyRandomSource is.
struct JavaRandom {
    seed: i64
}

fn java_random(seed: i64) -> JavaRandom {
    return JavaRandom { seed: (seed ^ 0x5DEECE66D) & MASK }
}

fn next(r: mut JavaRandom, n: i64) -> i64 {
    r.seed = (r.seed * 0x5DEECE66D + 0xB) & MASK
    return int(r.seed >> (48 - n))
}

fn next_long(r: mut JavaRandom) -> i64 {
    let hi = next(mut r, 32)
    let lo = next(mut r, 32)
    return (hi << 32) + lo
}

fn next_float(r: mut JavaRandom) -> f64 {
    return f64.nearest(next(mut r, 24) & 0xFFFFFF) / 16777216.0
}

fn next_double(r: mut JavaRandom) -> f64 {
    let hi = next(mut r, 26) & ((1i64 << 26) - 1)
    let lo = next(mut r, 27) & ((1i64 << 27) - 1)
    return f64.nearest((hi << 27) + lo) * (1.0 / 9007199254740992.0)
}

const SIN_SCALE: f64 = 10430.378350470453

fn table(i: i64) -> f64 {
    return f32r(sin(f64.nearest(i) / SIN_SCALE))
}

fn mth_sin(v: f64) -> f64 {
    return table(i64.saturate(v * SIN_SCALE) & 65535)
}

fn mth_cos(v: f64) -> f64 {
    return table(i64.saturate(v * SIN_SCALE + 16384.0) & 65535)
}

/// computeModifiedFriction.
fn cmf(friction: f64, modifier: f64) -> f64 {
    let v = f32r(1.0 - f32r(f32r(1.0 - friction) * modifier))
    return least_of(most_of(v, 0.0), 1.0)
}

// The blocks the cases use: whether they're whole cubes, their friction, their sound type's step
// and fall sounds, the fluid in them and whether they're climbable.
fn friction_of(name: String) -> f64 {
    return if name == "ice" { f32r(0.98) } else { f32r(0.6) }
}

fn sound_of(name: String) -> String {
    return match name {
        "stone" => "block.stone",
        "ice" => "block.glass",
        "ladder" => "block.ladder",
        _ => panic("{name} has no sounds here"),
    }
}

fn fluid_of(name: String) -> String {
    return if name == "water" or name == "lava" { name.copy() } else { String() }
}

fn own_height() -> f64 {
    return f32r(8.0 / 9.0)
}

struct World {
    floor_block: String
    fluid: String
    ladder: bool
}

fn world(floor_block: String, fluid: String, ladder: bool) -> World {
    return World { floor_block: floor_block.copy(), fluid: fluid.copy(), ladder: ladder }
}

fn block_at(w: World, x: i64, y: i64, z: i64) -> String {
    if y < 0 {
        return "stone"
    }
    if y == 0 {
        return w.floor_block.copy()
    }
    if not w.fluid.is_empty() and 1 <= y and y <= 3 {
        return w.fluid.copy()
    }
    if w.ladder and x == 0 and z == 0 and 1 <= y and y <= 10 {
        return "ladder"
    }
    return "air"
}

struct Sound {
    tick: i64
    name: String
    volume: i64
    pitch: i64
}

struct Dust {
    tick: i64
    block: String
    x: i64
    y: i64
    z: i64
    count: i64
}

struct Living {
    w: World
    random: JavaRandom
    yrot: f64
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    width: f64
    height: f64
    eyes: f64
    gravity: f64
    on_ground: bool
    hc: bool
    vc: bool
    below: bool
    fall: f64
    first_tick: bool
    in_water: bool
    water: f64
    lava: f64
    water_eyes: bool
    tick_count: i64
    move_dist: f64
    next_step: f64
    zza: f64
    speed: f64
    jumping: bool
    no_jump_delay: i64
    sounds: List<Sound>
    dust: List<Dust>
    splash: i64
}

fn living(w: World, seed: i64, x: f64, y: f64, z: f64) -> Living {
    var random = java_random(seed)
    _ = next_long(mut random)
    _ = next_long(mut random)
    let yrot = f32r(next_float(mut random) * f32r(PI * 2.0))
    return Living {
        w: w.copy(), random: random, yrot: yrot, x: x, y: y, z: z, vx: 0.0, vy: 0.0, vz: 0.0,
        width: f32r(0.5), height: f32r(1.975), eyes: f32r(1.7775), gravity: 0.08,
        on_ground: false, hc: false, vc: false, below: false, fall: 0.0, first_tick: true,
        in_water: false, water: 0.0, lava: 0.0, water_eyes: false, tick_count: 0, move_dist: 0.0,
        next_step: 1.0, zza: 0.0, speed: 0.0, jumping: false, no_jump_delay: 0, sounds: [],
        dust: [], splash: 0,
    }
}

fn box_of(e: Living) -> List<f64> {
    let h = f32r(e.width / 2.0)
    return [e.x - h, e.y, e.z - h, e.x + h, e.y + e.height, e.z + h]
}

fn in_lava(e: Living) -> bool {
    return not e.first_tick and e.lava > 0.0
}

fn play(e: mut Living, name: String, volume: f64, pitch: f64) {
    e.sounds.push(Sound { tick: e.tick_count, name: "minecraft:{name}", volume: float_bits(volume), pitch: float_bits(pitch) })
}

fn fluid_height(e: Living, x: i64, y: i64, z: i64, kind: String) -> f64 {
    let above = block_at(e.w, x, y + 1, z)
    return if fluid_of(above) == kind { 1.0 } else { own_height() }
}

/// updateFluidInteraction: the fluids' heights over the box 0.001 in, its eyes, a splash.
fn update_fluids(e: mut Living) {
    let b = box_of(e)
    let d = [b[0] + 0.001, b[1] + 0.001, b[2] + 0.001, b[3] - 0.001, b[4] - 0.001, b[5] - 0.001]
    var water = 0.0
    var lava = 0.0
    var eyes = false
    let eye_x = floor(e.x)
    let eye_z = floor(e.z)
    let eye_y = e.y + e.eyes
    for x in floor(d[0])..ceil(d[3]) {
        for y in floor(d[1])..ceil(d[4]) {
            for z in floor(d[2])..ceil(d[5]) {
                let kind = fluid_of(block_at(e.w, x, y, z))
                if kind.is_empty() {
                    continue
                }
                let top = f64.nearest(y) + fluid_height(e, x, y, z, kind)
                if top < d[1] {
                    continue
                }
                if x == eye_x and z == eye_z and eye_y >= f64.nearest(y) and eye_y <= top and kind == "water" {
                    eyes = true
                }
                if kind == "water" {
                    water = most_of(top - b[1], water)
                } else {
                    lava = most_of(top - b[1], lava)
                }
            }
        }
    }
    e.water = water
    e.lava = lava
    e.water_eyes = eyes
    let wet = e.water > 0.0
    if wet {
        e.fall = 0.0
        if not e.in_water and not e.first_tick {
            let fast = f32r((e.vx * e.vx * f32r(0.2) + e.vy * e.vy + e.vz * e.vz * f32r(0.2)).sqrt())
            let volume = least_of(1.0, f32r(fast * f32r(0.2)))
            let a = next_float(mut e.random)
            let c = next_float(mut e.random)
            play(mut e, "entity.generic.splash", volume, f32r(1.0 + f32r(f32r(a - c) * f32r(0.4))))
            let n = ceil(f32r(1.0 + f32r(e.width * 20.0)))
            for _ in 0..n * 5 {
                _ = next_double(mut e.random)
            }
            e.splash += 1
        }
    }
    e.in_water = wet
}

fn on_pos(e: Living, offset: f64) -> (i64, i64, i64) {
    return (floor(e.x), floor(e.y - offset), floor(e.z))
}

fn climbable(e: Living) -> bool {
    return block_at(e.w, floor(e.x), floor(e.y), floor(e.z)) == "ladder"
}

/// Whether a whole block's shape meets the box: the floor only, in these cases.
fn colliders(b: List<f64>) -> bool {
    return b[1] < 1.0 and b[4] > 0.0
}

/// Entity.move by dx, dy, dz, with a living entity's checkFallDamage and steps.
fn move_by(e: mut Living, dx: f64, dy: f64, dz: f64) {
    var mx = dx
    var my = dy
    var mz = dz
    let asked = dx * dx + dy * dy + dz * dz
    if asked != 0.0 {
        let b = box_of(e)
        let swept: List<f64> = [b[0] + least_of(dx, 0.0), b[1] + least_of(dy, 0.0), b[2] + least_of(dz, 0.0), b[3] + most_of(dx, 0.0), b[4] + most_of(dy, 0.0), b[5] + most_of(dz, 0.0)]
        if colliders(swept) {
            if dy != 0.0 {
                my = if dy.abs() < 1.0e-7 { 0.0 } else { most_of(dy, 1.0 - b[1]) }
            }
            let z_first = dx.abs() < dz.abs()
            if z_first and dz != 0.0 and dz.abs() < 1.0e-7 {
                mz = 0.0
            }
            if dx != 0.0 and dx.abs() < 1.0e-7 {
                mx = 0.0
            }
            if not z_first and dz != 0.0 and dz.abs() < 1.0e-7 {
                mz = 0.0
            }
        }
    }
    let length = mx * mx + my * my + mz * mz
    if length > 1.0e-7 or asked - length < 1.0e-7 {
        e.x = e.x + mx
        e.y = e.y + my
        e.z = e.z + mz
    }
    let x_hit = not ((mx - dx).abs() < f32r(1.0e-5))
    let z_hit = not ((mz - dz).abs() < f32r(1.0e-5))
    e.hc = x_hit or z_hit
    e.vc = dy != my
    e.below = e.vc and dy < 0.0
    e.on_ground = e.below
    let effect = on_pos(e, f32r(0.2))
    let effect_block = block_at(e.w, effect.0, effect.1, effect.2)
    // LivingEntity.checkFallDamage.
    if not e.in_water {
        update_fluids(mut e)
    }
    if e.on_ground and e.fall > 0.0 {
        let power = floor(e.fall + 1.0e-6 - 3.0).max(0)
        if power > 0 and effect_block != "air" {
            let scale = least_of(f32r(0.2) + f64.nearest(power) / 15.0, 2.5)
            e.dust.push(Dust { tick: e.tick_count, block: effect_block.copy(), x: bits(e.x), y: bits(e.y), z: bits(e.z), count: i64.saturate(150.0 * scale) })
        }
    }
    if not e.in_water and my < 0.0 {
        e.fall -= f32r(my)
    }
    if e.on_ground {
        if e.fall > 0.0 {
            let fell = e.fall
            fall_on(mut e, effect_block, fell)
        }
        e.fall = 0.0
    }
    // restituteMovementAfterCollisions, nothing here bouncing.
    let cy = e.vy
    if (dy.abs() > 0.0 and e.vc) or e.hc {
        if x_hit {
            e.vx = -e.vx * 0.0
        }
        if z_hit {
            e.vz = -e.vz * 0.0
        }
        if e.vc {
            e.vy = (0.0 - cy) * 1.0 * 0.0
        }
    }
    emit(mut e, mx, my, mz, effect, effect_block)
    // The block's speed factor, 1 for all of these.
    e.vx = e.vx * 1.0
    e.vy = e.vy * 1.0
    e.vz = e.vz * 1.0
}

fn fall_on(e: mut Living, landed_on: String, fell: f64) {
    _ = landed_on
    let damage = floor((fell + 1.0e-6 - 3.0) * 1.0 * 1.0)
    if damage > 0 {
        play(mut e, "entity.armor_stand.fall", 1.0, 1.0)
        let below = block_at(e.w, floor(e.x), floor(e.y - f32r(0.2)), floor(e.z))
        if below != "air" {
            play(mut e, "{sound_of(below)}.fall", f32r(1.0 * f32r(0.5)), f32r(1.0 * f32r(0.75)))
        }
    }
}

fn emit(e: mut Living, mx: f64, my: f64, mz: f64, effect: (i64, i64, i64), effect_block: String) {
    let gone = f32r((mx * mx + my * my + mz * mz).sqrt() * f32r(0.6))
    let across = f32r((mx * mx + mz * mz).sqrt() * f32r(0.6))
    let standing_pos = on_pos(e, f32r(1.0e-5))
    let standing = block_at(e.w, standing_pos.0, standing_pos.1, standing_pos.2)
    let climbing = standing == "ladder"
    e.move_dist = f32r(e.move_dist + (if climbing { gone } else { across }))
    if not (e.move_dist > e.next_step) or standing == "air" {
        return
    }
    var stepped = step_on(mut e, effect_block, true)
    if standing_pos != effect {
        let also = step_on(mut e, standing, false)
        stepped = also or stepped
    }
    if stepped {
        e.next_step = f64.nearest(i64.saturate(e.move_dist) + 1)
    } else if e.in_water {
        e.next_step = f64.nearest(i64.saturate(e.move_dist) + 1)
        let fast = f32r(f32r((e.vx * e.vx * f32r(0.2) + e.vy * e.vy + e.vz * e.vz * f32r(0.2)).sqrt()) * f32r(0.35))
        let a = next_float(mut e.random)
        let c = next_float(mut e.random)
        play(mut e, "entity.generic.swim", least_of(1.0, fast), f32r(1.0 + f32r(f32r(a - c) * f32r(0.4))))
    }
}

fn step_on(e: mut Living, on: String, heard: bool) -> bool {
    if on == "air" {
        return false
    }
    if not (e.on_ground or on == "ladder") {
        return false
    }
    if heard {
        play(mut e, "{sound_of(on)}.step", f32r(1.0 * f32r(0.15)), 1.0)
    }
    return true
}

fn move_relative(e: mut Living, speed: f64) {
    var (ix, iy, iz) = (0.0, 0.0, f32r(e.zza))
    let length = ix * ix + iy * iy + iz * iz
    var (ax, ay, az) = (0.0, 0.0, 0.0)
    if not (length < 1.0e-7) {
        if length > 1.0 {
            let d = length.sqrt()
            ix = ix / d
            iy = iy / d
            iz = iz / d
        }
        let (mx, my, mz) = (ix * speed, iy * speed, iz * speed)
        let turn = f32r(e.yrot * f32r(PI / 180.0))
        let s = mth_sin(turn)
        let c = mth_cos(turn)
        ax = mx * c - mz * s
        ay = my
        az = mz * c + mx * s
    }
    e.vx = e.vx + ax
    e.vy = e.vy + ay
    e.vz = e.vz + az
}

fn jump(e: mut Living) {
    let lava = in_lava(e)
    let height = if lava { e.lava } else { e.water }
    let wet = e.in_water and height > 0.0
    let threshold = if e.eyes < 0.4 { 0.0 } else { 0.4 }
    if not wet or (e.on_ground and not (height > threshold)) {
        if not lava or (e.on_ground and e.lava <= threshold) {
            if (e.on_ground or (wet and height <= threshold)) and e.no_jump_delay == 0 {
                let power = f32r(f32r(f32r(0.41999998688697815) * 1.0) * 1.0)
                if not (power <= f32r(1.0e-5)) {
                    e.vy = most_of(power, e.vy)
                }
                e.no_jump_delay = 10
            }
        } else {
            e.vy += f32r(0.04)
        }
    } else {
        e.vy += f32r(0.04)
    }
}

fn fluid_falling(g: f64, falling: bool, y: f64) -> f64 {
    if g == 0.0 {
        return y
    }
    if falling and (y - 0.005).abs() >= 0.003 and (y - g / 16.0).abs() < 0.003 {
        return -0.003
    }
    return y - g / 16.0
}

fn travel(e: mut Living) {
    if e.in_water or in_lava(e) {
        let falling = e.vy <= 0.0
        let g = e.gravity
        if e.in_water {
            let slow = f32r(0.8)
            move_relative(mut e, f32r(0.02))
            let (dx, dy, dz) = (e.vx, e.vy, e.vz)
            move_by(mut e, dx, dy, dz)
            var (mx, my, mz) = (e.vx, e.vy, e.vz)
            if e.hc and climbable(e) {
                my = 0.2
            }
            mx = mx * slow
            my = my * f32r(0.8)
            mz = mz * slow
            e.vx = mx
            e.vy = fluid_falling(g, falling, my)
            e.vz = mz
        } else {
            move_relative(mut e, f32r(0.02))
            let (dx, dy, dz) = (e.vx, e.vy, e.vz)
            move_by(mut e, dx, dy, dz)
            if e.lava <= (if e.eyes < 0.4 { 0.0 } else { 0.4 }) {
                let y = fluid_falling(g, falling, e.vy * f32r(0.8))
                e.vx = e.vx * 0.5
                e.vy = y
                e.vz = e.vz * 0.5
            } else {
                e.vx = e.vx * 0.5
                e.vy = e.vy * 0.5
                e.vz = e.vz * 0.5
            }
            e.vx = e.vx + 0.0
            e.vy = e.vy + -g / 4.0
            e.vz = e.vz + 0.0
        }
        // jumpOutOfFluid: nothing across to be pushed against here.
        if e.hc {
            panic("pushed against something in a fluid")
        }
        return
    }
    let under = on_pos(e, f32r(0.500001))
    let friction = if e.on_ground { cmf(friction_of(block_at(e.w, under.0, under.1, under.2)), 1.0) } else { 1.0 }
    var walk = f32r(0.02)
    if e.on_ground {
        walk = if friction > 0.6 { f32r(e.speed * f32r(f32r(0.21600002) / f32r(f32r(friction * friction) * friction))) } else { e.speed }
    }
    move_relative(mut e, walk)
    if climbable(e) {
        e.fall = 0.0
        let most = f32r(0.15)
        e.vx = least_of(most_of(e.vx, -most), most)
        e.vz = least_of(most_of(e.vz, -most), most)
        e.vy = most_of(e.vy, -most)
    }
    let (dx, dy, dz) = (e.vx, e.vy, e.vz)
    move_by(mut e, dx, dy, dz)
    let mx = e.vx
    var my = e.vy
    let mz = e.vz
    if (e.hc or e.jumping) and climbable(e) {
        my = 0.2
    }
    my -= e.gravity
    let air = cmf(f32r(0.91), 1.0)
    let across = f32r(friction * air)
    let up = cmf(f32r(0.98), 1.0)
    e.vx = mx * across
    e.vy = my * up
    e.vz = mz * across
}

/// tickNonPassenger and ArmorStand's tick, with physics.
fn tick(e: mut Living) {
    e.tick_count += 1
    // baseTick.
    update_fluids(mut e)
    if in_lava(e) {
        e.fall *= 0.5
    }
    e.first_tick = false
    // aiStep.
    if e.no_jump_delay > 0 {
        e.no_jump_delay -= 1
    }
    if e.vx.abs() < 0.003 {
        e.vx = 0.0
    }
    if e.vz.abs() < 0.003 {
        e.vz = 0.0
    }
    if e.vy.abs() < 0.003 {
        e.vy = 0.0
    }
    e.zza = f32r(e.zza * f32r(0.98))
    if e.jumping {
        jump(mut e)
    } else {
        e.no_jump_delay = 0
    }
    travel(mut e)
}

fn state(e: Living) -> List<i64> {
    return [bits(e.x), bits(e.y), bits(e.z), bits(e.vx), bits(e.vy), bits(e.vz), if e.on_ground { 1 } else { 0 }]
}

fn sounds_shown(e: Living) -> String {
    var parts: List<String> = []
    for s in e.sounds {
        parts.push("({s.tick}, '{s.name}', {s.volume}, {s.pitch})")
    }
    return "[{parts.join(", ")}]"
}

fn dust_shown(e: Living) -> String {
    var parts: List<String> = []
    for d in e.dust {
        parts.push("({d.tick}, '{d.block}', {d.x}, {d.y}, {d.z}, {d.count})")
    }
    return "[{parts.join(", ")}]"
}

fn run(name: String, e: mut Living, ticks: i64, checked: List<i64>, walking: bool) {
    var rows: List<String> = []
    for t in 1..=ticks {
        if walking {
            e.zza = 1.0
        }
        tick(mut e)
        if checked.contains(t) {
            var row: List<String> = ["{t}"]
            for v in state(e) {
                row.push("{v}")
            }
            rows.push("        {row.join(", ")},")
        }
    }
    println("== {name}")
    for r in rows {
        println(r)
    }
    println("   sounds: {sounds_shown(e)}")
    println("   dust: {dust_shown(e)}")
    println("   x {repr_float(e.x)} y {repr_float(e.y)} z {repr_float(e.z)} v {repr_float(e.vx)} {repr_float(e.vy)} {repr_float(e.vz)} ground {shown(e.on_ground)} fall {repr_float(e.fall)} splashes {e.splash}")
}

fn main() {
    var e = living(world("stone", "", false), 155, 0.5, 10.0, 0.5)
    println("== made: y rot bits {float_bits(e.yrot)}")
    run("falling", mut e, 40, [1, 5, 10, 13, 14, 15, 20, 40], false)

    var ice = living(world("ice", "", false), 156, 0.5, 1.0, 0.5)
    ice.on_ground = true
    ice.vx = 0.6
    run("ice", mut ice, 60, [1, 2, 10, 30, 60], false)

    var ladder = living(world("stone", "", true), 157, 0.5, 8.0, 0.5)
    run("ladder", mut ladder, 70, [1, 2, 5, 10, 30, 47, 48, 49, 50, 70], false)

    var water = living(world("stone", "water", false), 158, 0.5, 6.0, 0.5)
    run("water", mut water, 80, [1, 5, 10, 15, 20, 40, 80], false)

    var lava = living(world("stone", "lava", false), 159, 0.5, 5.0, 0.5)
    run("lava", mut lava, 60, [1, 5, 10, 20, 40, 60], false)

    var walker = living(world("stone", "", false), 160, 0.5, 1.0, 0.5)
    walker.yrot = 30.0
    walker.on_ground = true
    walker.speed = f32r(0.1)
    walker.jumping = true
    run("walker", mut walker, 40, [1, 2, 5, 10, 11, 12, 20, 40], true)
}
