/// Checks `world.spawn` and `world.collision`: how a spawn search walks its square, how far it
/// reaches, which columns a player can stand on, where they fit, and where in a column a player
/// going to another dimension stands, in blocks made with vanilla
/// 26.3's state IDs. The rig's spawn probe checks the same against vanilla's own
/// `PlayerSpawnFinder` (rig/README.md).
module test.spawn

import world.chunk.{AIR_STATE, BlockStates, Chunk}
import world.collision.{CollisionBlocks, CollisionStates, player_box}
import world.flat.{MIN_Y, SECTIONS}
import world.pos.{BlockPos}
import world.spawn.{SpawnSearch, border_distance, candidate_count, fits, fixup_height, respawn_pos, search_radius, standing_y}

// Vanilla 26.3's IDs of a few states.
const STONE: u32 = 1
const GRASS_BLOCK: u32 = 9
const WATER: u32 = 89
const OAK_LEAVES: u32 = 294
const TORCH: u32 = 4926
const CHEST: u32 = 5544

fn check(got: i64, want: i64, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn check_bool(got: bool, want: bool, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// Blocks for collisions: `ground` up to `top`, then `above` at `top + 1`, in the 3×3 chunks
// around the origin, and nothing loaded past them.
struct Ground {
    ground: u32
    top: i32
    above: u32
}

impl CollisionBlocks for Ground {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -16 or x >= 32 or z < -16 or z >= 32 {
            return none
        }
        if y <= self.top {
            return some(self.ground)
        }
        if y == self.top + 1 {
            return some(self.above)
        }
        return some(AIR_STATE)
    }
}

fn walks() {
    check(i64(candidate_count(0)), 1, "a square of 0")
    check(i64(candidate_count(1)), 9, "a square of 1")
    check(i64(candidate_count(10)), 441, "a square of 10")
    check(i64(candidate_count(16)), 1024, "a square of 16, past the most")
    check(i64(candidate_count(2147483647)), 1024, "the widest square")

    check(i64(search_radius(10, border_distance(0, 0))), 10, "the default radius")
    check(i64(search_radius(-5, border_distance(0, 0))), 0, "a radius below 0")
    check(i64(search_radius(10, 5.5)), 5, "a radius past the border")
    check(i64(search_radius(10, 0.5)), 1, "a spawn by the border")
    check(i64(search_radius(0, 1.0)), 1, "a spawn 1 from the border")
    check(i64(search_radius(10, -3.0)), 1, "a spawn past the border")
    check_bool(border_distance(29999983, 0) == 1.0, true, "1 from the border")

    // A square of 0 is the spawn alone, then the spawn again as the last.
    var alone = SpawnSearch.new(BlockPos { x: 5, y: 70, z: -3 }, 0, 0)
    let first = alone.next()
    check(i64(first.x), 5, "the only candidate's x")
    check(i64(first.z), -3, "the only candidate's z")
    check_bool(first.last, false, "the only candidate")
    check_bool(alone.next().last, true, "after the only candidate")
    check_bool(alone.next().last, true, "after that")

    // Each square's walk comes to every column of it once, from any candidate, by 17 or by one
    // less than how many there are; one past 1024 columns comes to its first 1024, row by row.
    for (radius, offset) in [(1, 0), (1, 8), (3, 20), (10, 0), (10, 440), (20, 1000)] {
        var search = SpawnSearch.new(BlockPos { x: 0, y: 0, z: 0 }, radius, offset)
        let side = radius * 2 + 1
        let count = search.count()
        var seen = List<bool>()
        for _ in 0..count {
            seen.push(false)
        }
        for i in 0..count {
            let c = search.next()
            check_bool(c.last, false, "candidate {i} of {count}")
            let value = (c.z + radius) * side + c.x + radius
            if value < 0 or value >= count or seen[usize.wrap(value)] {
                panic("candidate {i} of a square of {radius} is {c.x}, {c.z} again, or outside it")
            }
            seen[usize.wrap(value)] = true
            if i == 0 {
                check(i64(value), i64(offset), "the first candidate")
            }
        }
        check_bool(search.next().last, true, "after every candidate")
    }
    println("ok walks")
}

fn collisions() {
    let states = CollisionStates.new()
    check_bool(states.top_full(STONE), true, "stone's top")
    check_bool(states.top_full(OAK_LEAVES), true, "leaves' top")
    check_bool(states.top_full(TORCH), false, "a torch's top")
    check_bool(states.top_full(CHEST), false, "a chest's top")
    check_bool(states.top_full(AIR_STATE), false, "air's top")
    check_bool(states.has_fluid(WATER), true, "water")
    check_bool(states.has_fluid(STONE), false, "stone")

    // A player's box is 0.6 wide and 1.8 high, as floats.
    let b = player_box(0, 64, 0)
    check_bool(b.min_x == 0.5 - f64(0.3f32), true, "the box's west")
    check_bool(b.max_y == 64.0 + f64(1.8f32), true, "the box's top")

    // On grass, a player fits standing on it, and not in it; a torch they stand in doesn't
    // stop them, and a chest does; a liquid does too.
    let grass = Ground { ground: GRASS_BLOCK, top: -61, above: AIR_STATE }
    check_bool(fits(states, grass, 0, -60, 0), true, "on the grass")
    check_bool(fits(states, grass, 0, -61, 0), false, "in the grass")
    check_bool(fits(states, Ground { ground: GRASS_BLOCK, top: -61, above: TORCH }, 0, -60, 0), true, "in a torch")
    check_bool(fits(states, Ground { ground: GRASS_BLOCK, top: -61, above: CHEST }, 0, -60, 0), false, "in a chest")
    check_bool(fits(states, Ground { ground: GRASS_BLOCK, top: -61, above: WATER }, 0, -60, 0), false, "in water")
    // Beside a wall, which only blocks whose shapes reach out of them are checked past.
    check_bool(fits(states, Ground { ground: STONE, top: 63, above: AIR_STATE }, 0, 64, 0), true, "on stone")

    // A player is moved up out of the ground, or down onto it, to where they fit; with nothing
    // loaded, down to the bottom of the world.
    let max_y = MIN_Y + SECTIONS * 16 - 1
    check(i64(fixup_height(states, grass, 0, -64, 0, MIN_Y, max_y)), -60, "up out of the ground")
    check(i64(fixup_height(states, grass, 0, 100, 0, MIN_Y, max_y)), -60, "down onto it")
    check(i64(fixup_height(states, grass, 0, -60, 0, MIN_Y, max_y)), -60, "on it")
    check(i64(fixup_height(states, grass, 100, 100, 100, MIN_Y, max_y)), i64(MIN_Y + 1), "in nothing loaded")
    let solid = Ground { ground: STONE, top: 400, above: AIR_STATE }
    check(i64(fixup_height(states, solid, 0, 0, 0, MIN_Y, max_y)), i64(max_y), "in stone to the top")
    println("ok collisions")
}

fn columns() {
    let states = CollisionStates.new()
    // Stone, leaves and grass count in every heightmap that blocks motion, and water in those
    // that count fluids, as vanilla's tags and fluids have them.
    let untagged = BlockStates.new([], [], 1)
    let blocks: List<i32> = [i32.wrap(untagged.block_of(STONE)), i32.wrap(untagged.block_of(GRASS_BLOCK)), i32.wrap(untagged.block_of(OAK_LEAVES))]
    let table = BlockStates.new(blocks, [blocks[0], blocks[1]], 1)
    var chunk = Chunk.new(table, MIN_Y, SECTIONS, 0)
    // Column 0, 0: stone, then grass at -61.
    _ = chunk.set_block(table, 0, -64, 0, STONE)
    _ = chunk.set_block(table, 0, -61, 0, GRASS_BLOCK)
    // Column 1, 0: water at -61 over grass.
    _ = chunk.set_block(table, 1, -62, 0, GRASS_BLOCK)
    _ = chunk.set_block(table, 1, -61, 0, WATER)
    // Column 2, 0: a torch on grass.
    _ = chunk.set_block(table, 2, -61, 0, GRASS_BLOCK)
    _ = chunk.set_block(table, 2, -60, 0, TORCH)
    // Column 3, 0: leaves on grass.
    _ = chunk.set_block(table, 3, -61, 0, GRASS_BLOCK)
    _ = chunk.set_block(table, 3, -60, 0, OAK_LEAVES)
    // Column 4, 0: a chest on grass, whose top isn't whole.
    _ = chunk.set_block(table, 4, -61, 0, GRASS_BLOCK)
    _ = chunk.set_block(table, 4, -60, 0, CHEST)

    check_y(respawn_pos(states, chunk, 0, 0), some(-60), "on grass")
    check_y(respawn_pos(states, chunk, 1, 0), none, "under water")
    check_y(respawn_pos(states, chunk, 2, 0), some(-60), "by a torch")
    check_y(respawn_pos(states, chunk, 3, 0), some(-59), "on leaves")
    check_y(respawn_pos(states, chunk, 5, 0), none, "on nothing")
    // The chunk's column 4 is a chest on grass, which the chest's chunk's place gives as 16 on.
    check_y(respawn_pos(states, chunk, 20, 0), some(-60), "on the grass a chest's on")
    println("ok columns")
}

// A chunk's blocks for collisions, and nothing loaded past it.
struct InChunk {
    chunk: Chunk
}

impl CollisionBlocks for InChunk {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < 0 or x >= 16 or z < 0 or z >= 16 {
            return none
        }
        return some(self.chunk.block(x, y, z))
    }
}

// `standing_y` (CAL-69): the highest place in a column, from where it's looked from, where a
// player fits on a block they can stand on: on grass, not under water, not in a column of
// nothing, and on stone from above it, or, from under it, as below a ceiling, on a cave's floor.
fn standing() {
    let states = CollisionStates.new()
    let untagged = BlockStates.new([], [], 1)
    let blocks: List<i32> = [i32.wrap(untagged.block_of(STONE)), i32.wrap(untagged.block_of(GRASS_BLOCK))]
    let table = BlockStates.new(blocks, [blocks[0], blocks[1]], 1)
    var chunk = Chunk.new(table, MIN_Y, SECTIONS, 0)
    _ = chunk.set_block(table, 0, -61, 0, GRASS_BLOCK)
    _ = chunk.set_block(table, 1, -62, 0, GRASS_BLOCK)
    _ = chunk.set_block(table, 1, -61, 0, WATER)
    // Column 2, 0: stone from the bottom to -50, but for a cave at -55 and -54.
    for y in -64..-49 {
        if y != -55 and y != -54 {
            _ = chunk.set_block(table, 2, y, 0, STONE)
        }
    }
    let around = InChunk { chunk: chunk.copy() }
    check_at(standing_y(states, chunk, around, 0, 0, 0), some(-60), "on grass")
    check_at(standing_y(states, chunk, around, 1, 0, 0), none, "under water")
    check_at(standing_y(states, chunk, around, 3, 0, 0), none, "on nothing")
    check_at(standing_y(states, chunk, around, 2, 0, 0), some(-49), "on the stone")
    check_at(standing_y(states, chunk, around, 2, -52, 0), some(-55), "in the cave")
    println("ok standing")
}

fn check_at(got: i32?, want: i32?, what: String) {
    match (got, want) {
        (some(g), some(w)) => check(i64(g), i64(w), what),
        (none, none) => {},
        _ => panic("{what}: got {got != none}, want {want != none}"),
    }
}

fn check_y(got: BlockPos?, want: i32?, what: String) {
    match (got, want) {
        (some(p), some(y)) => check(i64(p.y), i64(y), what),
        (none, none) => {},
        _ => panic("{what}: got {got != none}, want {want != none}"),
    }
}

fn main() {
    walks()
    collisions()
    columns()
    standing()
    println("ok")
}
