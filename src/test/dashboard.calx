/// Checks the console's dashboard (CAL-55): the bar `bar` draws, on one line or two by the
/// terminal's width, cut where it would run over, with its numbers amber or red where they look
/// bad; TPS and MSPT from the ticks' times, a stuck server's too; the line editor, which takes
/// what a terminal sends for each key; the input line as it shows; and `console-dashboard`.
module test.dashboard

import java.properties.{Properties}
import server.config.{CalciteConfig}
import server.dashboard.{Edit, Editor, Shown, Ticks, bar, input_row, place_of, rows_of}
import server.paint.{Colors}

fn check(got: String, want: String) {
    if got != want {
        panic("got\n{got}\nwant\n{want}")
    }
}

fn check_lines(got: List<String>, want: List<String>) {
    if got != want {
        panic("got\n{got}\nwant\n{want}")
    }
}

// The text with each color code written as `<code>`, so a test can read it.
fn codes(s: String) -> String {
    var out = List<u8>()
    var i: usize = 0
    let bytes = s.to_bytes()
    while i < bytes.len() {
        if bytes[i] == 27 {
            out.push(60)
            i += 2
            while bytes[i] != 109 {
                out.push(bytes[i])
                i += 1
            }
            out.push(62)
        } else {
            out.push(bytes[i])
        }
        i += 1
    }
    return String.from_utf8(out)!
}

// A server keeping up, 12 minutes and 4 seconds in.
fn steady() -> Shown {
    return Shown {
        tps: some(200),
        mspt: some(1400000),
        players: 1,
        max_players: 20,
        chunks: 441,
        memory: 224395264,
        memory_limit: 17179869184,
        cpu: some(32),
        uptime: 724000000000,
        stopping: false,
    }
}

fn bars() {
    // Wide enough for one line, whose numbers start where the log's words do.
    check_lines(bar(steady(), 120, Colors.Off, true), ["    calcite    20.0 TPS · 1.4 MSPT · 3.2% CPU · 214 MB / 16 GB RAM · 1/20 players · 441 chunks · up 12m 4s"])
    check_lines(bar(steady(), 107, Colors.Off, true), ["    calcite    20.0 TPS · 1.4 MSPT · 3.2% CPU · 214 MB / 16 GB RAM · 1/20 players · 441 chunks · up 12m 4s"])
    // One column less, and it's two, the world's under the rest.
    check_lines(bar(steady(), 106, Colors.Off, true), ["    calcite    20.0 TPS · 1.4 MSPT · 3.2% CPU · 214 MB / 16 GB RAM", "               1/20 players · 441 chunks · up 12m 4s"])
    // Narrower, each line keeps what fits.
    check_lines(bar(steady(), 50, Colors.Off, true), ["    calcite    20.0 TPS · 1.4 MSPT · 3.2% CPU", "               1/20 players · 441 chunks"])
    // Too narrow for the badge.
    check_lines(bar(steady(), 30, Colors.Off, true), ["20.0 TPS · 1.4 MSPT", "1/20 players · 441 chunks"])
    // In vanilla's style, the numbers start after the badge.
    check_lines(bar(steady(), 80, Colors.Off, false), ["calcite    20.0 TPS · 1.4 MSPT · 3.2% CPU · 214 MB / 16 GB RAM", "           1/20 players · 441 chunks · up 12m 4s"])

    // Before two ticks, and before a second's CPU time, and without a memory limit.
    var s = steady()
    s.tps = none
    s.mspt = none
    s.cpu = none
    s.memory_limit = 0
    s.chunks = 1
    s.uptime = 4000000000
    check_lines(bar(s, 120, Colors.Off, true), ["    calcite    starting · 214 MB RAM · 1/20 players · 1 chunk · up 4s"])
    var stopping = steady()
    stopping.stopping = true
    check_lines(bar(stopping, 140, Colors.Off, true), ["    calcite    stopping · Ctrl+C ends it at once · 3.2% CPU · 214 MB / 16 GB RAM · 1/20 players · 441 chunks · up 12m 4s"])

    // The badge in the logo's ink on the calcite block's off-white, and the labels muted.
    check(codes(bar(steady(), 120, Colors.Basic, true)[0]), "    <1;30;47> calcite <0>  20.0 <90>TPS<0><90> · <0>1.4 <90>MSPT<0><90> · <0>3.2% <90>CPU<0><90> · <0>214 MB / 16 GB <90>RAM<0><90> · <0>1/20 <90>players<0><90> · <0>441 <90>chunks<0><90> · <0><90>up<0> 12m 4s")

    // What looks bad is amber, then red.
    var slow = steady()
    slow.tps = some(194)
    slow.mspt = some(40000001)
    slow.cpu = some(800)
    slow.memory = 13743895348
    check(codes(bar(slow, 80, Colors.Basic, true)[0]), "    <1;30;47> calcite <0>  <33>19.4<0> <90>TPS<0><90> · <0><33>40.0<0> <90>MSPT<0><90> · <0><33>80%<0> <90>CPU<0><90> · <0><33>13 GB / 16 GB<0> <90>RAM<0>")
    var worse = steady()
    worse.tps = some(149)
    worse.mspt = some(250000000)
    worse.cpu = some(950)
    worse.memory = 15461882266
    check(codes(bar(worse, 80, Colors.Basic, true)[0]), "    <1;30;47> calcite <0>  <31>14.9<0> <90>TPS<0><90> · <0><31>250<0> <90>MSPT<0><90> · <0><31>95%<0> <90>CPU<0><90> · <0><31>14 GB / 16 GB<0> <90>RAM<0>")
    // At 19.5 and 40 ms it's still fine; a quiet server's MSPT is in hundredths.
    var fine = steady()
    fine.tps = some(195)
    fine.mspt = some(40000)
    fine.uptime = 90061000000000
    check_lines(bar(fine, 120, Colors.Off, true), ["    calcite    19.5 TPS · 0.04 MSPT · 3.2% CPU · 214 MB / 16 GB RAM · 1/20 players · 441 chunks · up 1d 1h"])
    if codes(bar(fine, 120, Colors.Basic, true)[0]).contains("<33>") {
        panic("19.5 TPS and 40 ms aren't amber")
    }
    // Under 10 GB, RAM is to a tenth.
    var small = steady()
    small.memory = 1610612736
    small.memory_limit = 8589934592
    check_lines(bar(small, 120, Colors.Off, true), ["    calcite    20.0 TPS · 1.4 MSPT · 3.2% CPU · 1.5 GB / 8.0 GB RAM · 1/20 players · 441 chunks · up 12m 4s"])
}

fn ticks() {
    var t = Ticks()
    if t.tps(0) != none or t.mspt(0) != none {
        panic("a server that hasn't ticked has no TPS or MSPT")
    }
    for i in 0..100 {
        t.push(u64.wrap(i) * 50000000, 1000000)
    }
    let last: u64 = 99 * 50000000
    check("{t.tps(last + 10000000)} {t.mspt(last + 10000000)}", "some(200) some(1000000)")
    // Stuck for 2 seconds since the last tick: it shows before any tick says so.
    check("{t.tps(last + 2000000000)} {t.mspt(last + 2000000000)}", "some(143) some(2000000000)")
    // The oldest go as new ones come.
    for i in 100..150 {
        t.push(u64.wrap(i) * 50000000, 3000000)
    }
    let later: u64 = 149 * 50000000
    check("{t.tps(later)} {t.mspt(later)}", "some(200) some(2000000)")
    // Ticks at 10 a second.
    var half = Ticks()
    for i in 0..100 {
        half.push(u64.wrap(i) * 100000000, 90000000)
    }
    check("{half.tps(99 * 100000000)} {half.mspt(99 * 100000000)}", "some(100) some(90000000)")
}

// What the edits were, as `run:stop|halt|at:3`.
fn said(edits: List<Edit>) -> String {
    var out = String()
    for e in edits {
        if not out.is_empty() {
            out.push('|')
        }
        match e {
            Edit.Run(line) => out.push_str("run:{line}"),
            Edit.Halt => out.push_str("halt"),
            Edit.At(row) => out.push_str("at:{row}"),
        }
    }
    return out
}

fn type_in(e: mut Editor, keys: str) -> String {
    return said(e.keys(String(keys).to_bytes()))
}

fn editing() {
    var e = Editor()
    check(type_in(mut e, "stop"), "")
    check("{e.line()} {e.cursor_at()}", "stop 4")
    check(type_in(mut e, "\r"), "run:stop")
    check(e.line(), "")
    // A line feed right after a carriage return is the same Enter, as a paste has it.
    check(type_in(mut e, "say hi\r\nlist\n"), "run:say hi|run:list")
    // Backspace, from either key, and the arrows' sequences.
    check(type_in(mut e, "stpo\u{7F}\u{8}p\u{1B}[Do\u{1B}[C"), "")
    check(e.line(), "stop")
    // Home and End, as each terminal sends them, and Delete.
    check(type_in(mut e, "\u{1B}[H/\u{1B}[F!\u{1B}[1~\u{1B}[3~\u{1B}OF\u{7F}"), "")
    check(e.line(), "stop")
    // Ctrl+A, then Ctrl+K, and Ctrl+U.
    check(type_in(mut e, "\u{1}\u{6}\u{6}\u{B}"), "")
    check(e.line(), "st")
    check(type_in(mut e, "\u{15}"), "")
    check(e.line(), "")
    // Ctrl+W and the word moves.
    check(type_in(mut e, "say hello there\u{17}"), "")
    check(e.line(), "say hello ")
    check(type_in(mut e, "\u{1B}[1;5D\u{1B}[1;5Dx\u{1B}[1;5C!"), "")
    check(e.line(), "xsay! hello ")
    // Esc alone clears the line.
    check(type_in(mut e, "\u{1B}"), "")
    check(e.line(), "")
    // Up and down go through what was typed, and back to the line being typed.
    check(type_in(mut e, "draft\u{1B}[A"), "")
    check(e.line(), "list")
    check(type_in(mut e, "\u{1B}[A\u{1B}[A\u{1B}[A\u{1B}[A"), "")
    check(e.line(), "stop")
    check(type_in(mut e, "\u{1B}[B\u{1B}[B\u{1B}[B"), "")
    check(e.line(), "draft")
    check(type_in(mut e, "\u{15}\u{10}\r"), "run:list")
    // A character, and a key's sequence, split between two reads.
    check(said(e.keys([104, 195])), "")
    check(said(e.keys([169, 108, 108, 111, 27, 91])), "")
    check(type_in(mut e, "D\u{1B}[D\u{1B}[D\u{1B}[D!"), "")
    check("{e.line()} {e.cursor_at()}", "h!éllo 2")
    // Ctrl+C asks the server to stop, and the terminal's answer to where the cursor is.
    check(type_in(mut e, "\u{3}\u{1B}[12;1R"), "halt|at:12")
    check(e.line(), "h!éllo")
    // Other controls and keys change nothing.
    check(type_in(mut e, "\t\u{1B}[5~\u{1B}[200~\u{1B}x"), "")
    check(e.line(), "h!éllo")
}

fn input_rows() {
    var e = Editor()
    let (empty, at) = input_row(e, 80, Colors.Off, true)
    check("{empty}|{at}", "            ›  type a command, such as stop|15")
    let (plain, at_plain) = input_row(e, 80, Colors.Off, false)
    check("{plain}|{at_plain}", "> type a command, such as stop|2")
    _ = e.keys(String("say hello").to_bytes())
    let (said_row, said_at) = input_row(e, 80, Colors.Off, true)
    check("{said_row}|{said_at}", "            ›  say hello|24")
    // Too long for the width: the part around the cursor shows.
    let (cut, cut_at) = input_row(e, 22, Colors.Off, true)
    check("{cut}|{cut_at}", "            ›  hello|20")
    _ = e.keys(String("\u{1}").to_bytes())
    let (start, start_at) = input_row(e, 22, Colors.Off, true)
    check("{start}|{start_at}", "            ›  say he|15")
}

// The rows a line takes, as the bottom panel counts them to know where the log reaches.
fn rows() {
    var long = String()
    for _ in 0..80 {
        long.push('x')
    }
    let painted = String("\u{1B}[90mabc\u{1B}[0m \u{1B}[1;38;2;30;31;36mé\u{1B}[0m")
    check("{rows_of(String("abc"), 80)} {rows_of(String(), 80)} {rows_of(String("a\nb"), 80)} {rows_of(long, 80)} {rows_of("{long}y", 80)} {rows_of(painted, 5)} {rows_of(painted, 4)} {rows_of(String("\nX\n"), 80)}", "1 1 2 1 2 1 2 3")
}

fn settings() {
    check("{place_of(String("bottom")) != none} {place_of(String("top")) != none} {place_of(String("off")) != none} {place_of(String("Bottom")) != none}", "true true false false")
    var p = Properties.new()
    check(CalciteConfig.from(p).console_dashboard, "off")
    p.set("console-dashboard", "top")
    check(CalciteConfig.from(p).console_dashboard, "top")
    p.set("console-dashboard", "left")
    check(CalciteConfig.from(p).console_dashboard, "off")
    check(CalciteConfig.defaults().console_dashboard, "off")
}

fn main() {
    bars()
    ticks()
    editing()
    input_rows()
    rows()
    settings()
    println("ok")
}
