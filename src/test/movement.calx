/// Checks how entities move against blocks, `world.movement` (CAL-148): vanilla's own
/// `VoxelShape.collide` cases, which datagen wrote, to the bit; then by hand, an item falling on
/// stone, against a wall, onto a fence's top from beside it, onto scaffolding from above, inside
/// it and going down, onto powder snow falling far and not, against bamboo where it's offset, and
/// where no chunk is loaded; and the blocks' friction, speed and jump factors and bounce.
module test.movement

import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.chunk.{BlockStates}
import world.collision.{Aabb, CollisionBlocks}
import world.movement.{Colliders, Mover, MovementStates, collide_shape, collide_with, swept}
import world.movement_shapes.{collide_cases}
import worldgen.facts.{Facts}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn state(f: Facts, name: str) -> u32 {
    let block = f.block_named(String(name)) else panic("no block {name}")
    return f.default_state(block)
}

fn with_int(f: Facts, s: u32, name: str, value: i32) -> u32 {
    return match f.with_int(s, String(name), value) {
        ok(v) => v,
        err(_) => panic("no {name} of {s}"),
    }
}

// A world of blocks: the ground's state at y 0 and below, air above, but for the blocks placed,
// with chunks loaded within 32 blocks of 0, 0.
struct World {
    ground: u32
    placed: Map<i64, u32>
}

fn key(x: i32, y: i32, z: i32) -> i64 {
    return (i64(x) & 0xFFFFF) << 40 | (i64(y) & 0xFFFFF) << 20 | (i64(z) & 0xFFFFF)
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -32 or x >= 32 or z < -32 or z >= 32 {
            return none
        }
        let k = key(x, y, z)
        if self.placed.contains(k) {
            return some(self.placed[k])
        }
        if y <= 0 {
            return some(self.ground)
        }
        return some(0)
    }
}

// An item's box, 0.25 across and high, with its feet at the middle of x, y, z.
fn item(x: f64, y: f64, z: f64) -> Aabb {
    return Aabb { min_x: x - 0.125, min_y: y, min_z: z - 0.125, max_x: x + 0.125, max_y: y + 0.25, max_z: z + 0.125 }
}

// How far the box moves by dx, dy, dz in `w`, for an entity whose feet are where the box's bottom is.
fn moves(m: MovementStates, f: Facts, w: World, b: Aabb, dx: f64, dy: f64, dz: f64, fall: f64, descending: bool) -> (f64, f64, f64) {
    let c = m.colliders(f, w, swept(b, dx, dy, dz), Mover { y: b.min_y, fall: fall, descending: descending })
    return collide_with(c, b, dx, dy, dz)
}

fn same(got: f64, want: f64) -> bool {
    return got.to_bits() == want.to_bits()
}

// Every case vanilla's `VoxelShape.collide` gave, to the bit.
fn vanilla(m: MovementStates) {
    let cases = collide_cases()
    check(cases.len() % 10 == 0, "the collide cases aren't ten numbers each")
    var wrong = 0
    var stopped = 0
    var i: usize = 0
    while i < cases.len() {
        let shape = u32.wrap(cases[i])
        let axis = i32.wrap(cases[i + 1])
        let b = Aabb {
            min_x: f64.from_bits(u64.wrap(cases[i + 2])),
            min_y: f64.from_bits(u64.wrap(cases[i + 3])),
            min_z: f64.from_bits(u64.wrap(cases[i + 4])),
            max_x: f64.from_bits(u64.wrap(cases[i + 5])),
            max_y: f64.from_bits(u64.wrap(cases[i + 6])),
            max_z: f64.from_bits(u64.wrap(cases[i + 7])),
        }
        let asked = f64.from_bits(u64.wrap(cases[i + 8]))
        let given = f64.from_bits(u64.wrap(cases[i + 9]))
        let boxes = m.boxes_of(shape)
        let got = collide_shape(boxes, 0, boxes.len(), axis, b, asked)
        if not same(got, given) {
            if wrong < 10 {
                println("shape {shape} axis {axis} box {b.min_x} {b.min_y} {b.min_z} {b.max_x} {b.max_y} {b.max_z} by {asked}: {got}, vanilla {given}")
            }
            wrong += 1
        }
        if given != asked {
            stopped += 1
        }
        i += 10
    }
    check(wrong == 0, "collide differs from vanilla's")
    check(stopped >= 200, "too few cases where vanilla stopped short")
    println("{cases.len() / 10} collide cases, {stopped} stopped short, as vanilla")
}

fn by_hand(m: MovementStates, f: Facts) {
    let stone = state(f, "minecraft:stone")
    var w = World { ground: stone, placed: Map<i64, u32>() }

    // Falling on stone: it stops on the top, as far as the top is below its feet.
    let (x0, y0, z0) = moves(m, f, w, item(0.5, 1.1, 0.5), 0.0, -0.2, 0.0, 0.0, false)
    check(same(x0, 0.0) and same(y0, 1.0 - 1.1) and same(z0, 0.0), "an item didn't land on stone")
    // Falling short of it, it falls the whole way.
    let (_, y1, _) = moves(m, f, w, item(0.5, 1.5, 0.5), 0.0, -0.2, 0.0, 0.0, false)
    check(same(y1, -0.2), "an item above stone didn't fall")

    // Against a wall, along x and along z.
    w.placed.insert(key(2, 1, 0), stone)
    w.placed.insert(key(0, 1, 2), stone)
    let (x2, y2, z2) = moves(m, f, w, item(0.5, 1.0, 0.5), 1.5, 0.0, 0.0, 0.0, false)
    check(same(x2, 2.0 - 0.625) and same(y2, 0.0) and same(z2, 0.0), "an item went through a wall along x")
    let (x3, _, z3) = moves(m, f, w, item(0.5, 1.0, 0.5), 0.0, 0.0, 1.5, 0.0, false)
    check(same(x3, 0.0) and same(z3, 2.0 - 0.625), "an item went through a wall along z")
    // Moving across, more along z: z first, then x along the wall.
    let (x4, _, z4) = moves(m, f, w, item(1.5, 1.0, 1.5), 0.3, 0.0, 1.0, 0.0, false)
    check(same(z4, 1.0) and same(x4, 0.3), "an item moving across didn't miss the walls")
    _ = w.placed.remove(key(2, 1, 0))
    _ = w.placed.remove(key(0, 1, 2))

    // A fence's top, 1.5 up, from the block above it, beside the box's own: it's on a face of
    // the blocks gone through, and its shape reaches out of its block.
    w.placed.insert(key(4, 1, 4), state(f, "minecraft:oak_fence"))
    let (_, y5, _) = moves(m, f, w, item(4.5, 2.6, 4.5), 0.0, -0.2, 0.0, 0.0, false)
    check(same(y5, 2.5 - 2.6), "an item didn't land on a fence's top")
    _ = w.placed.remove(key(4, 1, 4))

    // Scaffolding: whole from above, unless going down; inside it, only an unstable one's bottom.
    let stable = with_int(f, state(f, "minecraft:scaffolding"), "distance", 0)
    let unstable = f.try_bool(with_int(f, stable, "distance", 1), "bottom", true)
    w.placed.insert(key(6, 1, 6), stable)
    let (_, y6, _) = moves(m, f, w, item(6.5, 2.05, 6.5), 0.0, -0.1, 0.0, 0.0, false)
    check(same(y6, 2.0 - 2.05), "an item didn't land on scaffolding")
    let (_, y7, _) = moves(m, f, w, item(6.5, 2.05, 6.5), 0.0, -0.1, 0.0, 0.0, true)
    check(same(y7, -0.1), "something going down didn't go through scaffolding")
    let (_, y8, _) = moves(m, f, w, item(6.5, 1.5, 6.5), 0.0, -0.3, 0.0, 0.0, false)
    check(same(y8, -0.3), "an item inside stable scaffolding didn't fall through it")
    w.placed.insert(key(6, 1, 6), unstable)
    let (_, y9, _) = moves(m, f, w, item(6.5, 1.5, 6.5), 0.0, -0.4, 0.0, 0.0, false)
    check(same(y9, 1.125 - 1.5), "an item inside unstable scaffolding didn't land on its bottom")
    _ = w.placed.remove(key(6, 1, 6))

    // Powder snow holds up only something that has fallen more than 2.5 blocks.
    w.placed.insert(key(8, 1, 8), state(f, "minecraft:powder_snow"))
    let (_, y10, _) = moves(m, f, w, item(8.5, 2.0, 8.5), 0.0, -0.2, 0.0, 3.0, false)
    check(same(y10, (f64(0.9f32) + 1.0) - 2.0), "an item falling far didn't land on powder snow")
    let (_, y11, _) = moves(m, f, w, item(8.5, 2.0, 8.5), 0.0, -0.2, 0.0, 1.0, false)
    check(same(y11, -0.2), "an item falling a little landed on powder snow")
    _ = w.placed.remove(key(8, 1, 8))

    // Bamboo, offset by where it is.
    let bamboo = state(f, "minecraft:bamboo")
    w.placed.insert(key(10, 1, 10), bamboo)
    let (ox, _, _) = f.offset(bamboo, 10, 10)
    check(ox != 0.0, "bamboo at 10, 10 isn't offset")
    let (x12, _, _) = moves(m, f, w, item(9.5, 1.0, 10.5), 1.0, 0.0, 0.0, 0.0, false)
    check(same(x12, ((6.5 / 16.0 + ox) + 10.0) - 9.625), "an item didn't stop at bamboo where it's offset")
    _ = w.placed.remove(key(10, 1, 10))

    // Where no chunk is loaded there's nothing to meet.
    let (_, y13, _) = moves(m, f, w, item(40.5, 1.1, 0.5), 0.0, -0.2, 0.0, 0.0, false)
    check(same(y13, -0.2), "an item met a block where no chunk is loaded")
    let none_near = m.colliders(f, w, item(40.5, 1.1, 0.5), Mover { y: 1.1, fall: 0.0 })
    check(none_near.is_empty(), "shapes where no chunk is loaded")
    let some_near: Colliders = m.colliders(f, w, item(0.5, 0.9, 0.5), Mover { y: 0.9, fall: 0.0 })
    check(some_near.len() == 1, "not the one block an item's box is in")
    println("by hand: stone, walls, a fence, scaffolding, powder snow, bamboo and no chunk")
}

fn block_of(f: Facts, name: str) -> u32 {
    let block = f.block_named(String(name)) else panic("no block {name}")
    return block
}

fn factors(m: MovementStates, f: Facts) {
    check(m.friction(block_of(f, "minecraft:stone")) == 0.6f32 and m.speed_factor(block_of(f, "minecraft:stone")) == 1.0f32, "stone's factors")
    check(m.jump_factor(block_of(f, "minecraft:stone")) == 1.0f32 and m.bounce(block_of(f, "minecraft:stone")) == 0.0f32, "stone's jump and bounce")
    check(m.friction(block_of(f, "minecraft:ice")) == 0.98f32 and m.friction(block_of(f, "minecraft:packed_ice")) == 0.98f32, "ice's friction")
    check(m.friction(block_of(f, "minecraft:blue_ice")) == 0.989f32, "blue ice's friction")
    check(m.friction(block_of(f, "minecraft:slime_block")) == 0.8f32 and m.bounce(block_of(f, "minecraft:slime_block")) == 1.0f32, "slime's friction and bounce")
    check(m.speed_factor(block_of(f, "minecraft:soul_sand")) == 0.4f32, "soul sand's speed")
    check(m.speed_factor(block_of(f, "minecraft:honey_block")) == 0.4f32 and m.jump_factor(block_of(f, "minecraft:honey_block")) == 0.5f32, "honey's speed and jump")
    println("factors: ice, blue ice, slime, soul sand and honey")
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    vanilla(m)
    by_hand(m, f)
    factors(m, f)
    println("ok")
}
