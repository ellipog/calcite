/// Checks what Calcite writes back to server.properties against what the 26.3 server jar wrote
/// with `--initSettings`, run in a folder with no server.properties and in one with tricky values,
/// each line ending with `\n` for `\r\n`. The jar's date and secret are given. Then the cases
/// vanilla fails to start on, and Gson's writing of `generator-settings`, as Gson 2.14 wrote it.
module test.settled

import java.properties.{Properties}
import server.properties.{new_secret, settled}

fn check(got: String, want: String) {
    if got != want {
        panic("got:\n{got}\nwant:\n{want}")
    }
}

// What vanilla writes for a file holding `text`.
fn written(text: String, secret: String, date: String) -> String {
    return match settled(Properties.parse(text)!, secret) {
        ok(p) => p.store(some(String("Minecraft server properties")), date),
        err(message) => "error: {message}",
    }
}

// The setting `key` that vanilla writes for a file holding `line`.
fn one(line: String, key: String) -> String {
    let text = written(line, String("secret"), String("D"))
    if text.starts_with("error: ") {
        return text
    }
    let p = Properties.parse(text)!
    return p.get(key) ?? String("none")
}

fn main() {
    let fresh_date = String("Thu Oct 29 10:49:03 CET 2026")
    let fresh = String("accepts-transfers=false\nallow-flight=false\nbroadcast-console-to-ops=true\nbroadcast-rcon-to-ops=true\nbug-report-link=\nchat-spam-threshold-seconds=10\ncommand-spam-threshold-seconds=10\ndifficulty=easy\nenable-code-of-conduct=false\nenable-jmx-monitoring=false\nenable-query=false\nenable-rcon=false\nenable-status=true\nenforce-secure-profile=true\nenforce-whitelist=false\nentity-broadcast-range-percentage=100\nforce-gamemode=false\nfunction-permission-level=2\ngamemode=survival\ngenerate-structures=true\ngenerator-settings=\{\}\nhardcore=false\nhide-online-players=false\ninitial-disabled-packs=\ninitial-enabled-packs=vanilla\nlevel-name=world\nlevel-seed=\nlevel-type=minecraft\\:normal\nlog-ips=true\nmanagement-server-allowed-origins=\nmanagement-server-enabled=false\nmanagement-server-host=localhost\nmanagement-server-port=0\nmanagement-server-secret=S7HZpi0bcAKgFTehZ4oeURp8v3eF6R4h1rz6rCzM\nmanagement-server-tls-enabled=true\nmanagement-server-tls-keystore=\nmanagement-server-tls-keystore-password=\nmax-chained-neighbor-updates=1000000\nmax-players=20\nmax-tick-time=60000\nmax-world-size=29999984\nmotd=A Minecraft Server\nnetwork-compression-threshold=256\nonline-mode=true\nop-permission-level=4\npause-when-empty-seconds=60\nplayer-idle-timeout=0\nprevent-proxy-connections=false\nquery.port=25565\nrate-limit=0\nrcon.password=\nrcon.port=25575\nregion-file-compression=deflate\nrequire-resource-pack=false\nresource-pack=\nresource-pack-id=\nresource-pack-prompt=\nresource-pack-sha1=\nserver-ip=\nserver-port=25565\nsimulation-distance=10\nspawn-protection=16\nstatus-heartbeat-interval=0\nsync-chunk-writes=true\ntext-filtering-config=\ntext-filtering-version=0\nuse-native-transport=true\nview-distance=10\nwhite-list=true\n")
    check(written(String(), String("S7HZpi0bcAKgFTehZ4oeURp8v3eF6R4h1rz6rCzM"), fresh_date), "#Minecraft server properties\n#{fresh_date}\n{fresh}")
    let tricky_date = String("Thu Oct 29 10:49:49 CET 2026")
    let tricky = String("Custom.Key=value\\:with\\=specials\\#\\!\naccepts-transfers=false\nallow-flight=false\nbroadcast-console-to-ops=true\nbroadcast-rcon-to-ops=true\nbug-report-link=\nchat-spam-threshold-seconds=10\ncommand-spam-threshold-seconds=10\ndifficulty=normal\nenable-code-of-conduct=false\nenable-jmx-monitoring=false\nenable-query=false\nenable-rcon=false\nenable-status=true\nenforce-secure-profile=true\nenforce-whitelist=false\nentity-broadcast-range-percentage=100\nforce-gamemode=false\nfunction-permission-level=0\ngamemode=survival\ngenerate-structures=true\ngenerator-settings=\{\"a\"\\:[1,2.50,\"x\"],\"b\"\\:\{\}\}\nhardcore=false\nhide-online-players=false\ninitial-disabled-packs=\ninitial-enabled-packs=vanilla\nlevel-name=world\nlevel-seed=spaced seed\nlevel-type=flat\nlog-ips=true\nmanagement-server-allowed-origins=\nmanagement-server-enabled=false\nmanagement-server-host=localhost\nmanagement-server-port=0\nmanagement-server-secret=\nmanagement-server-tls-enabled=true\nmanagement-server-tls-keystore=\nmanagement-server-tls-keystore-password=\nmax-chained-neighbor-updates=1000000\nmax-players=20\nmax-tick-time=99999999999\nmax-world-size=1\nmotd=\u{A7}cRed \u{4E2D} caf\u{E9}  two\nnetwork-compression-threshold=256\nonline-mode=true\nop-permission-level=4\npause-when-empty-seconds=60\nplayer-idle-timeout=0\nprevent-proxy-connections=false\npvp=false\nquery.port=25565\nrate-limit=5\nrcon.password=\nrcon.port=25575\nregion-file-compression=deflate\nrequire-resource-pack=false\nresource-pack=\nresource-pack-id=\nresource-pack-prompt=\nresource-pack-sha1=\nserver-ip=\nserver-port=25566\nsimulation-distance=0\nspawn-protection=16\nstatus-heartbeat-interval=0\nsync-chunk-writes=true\ntab\\tkey=a\\tb\ntext-filtering-config=\ntext-filtering-version=0\nuse-native-transport=true\nview-distance=32\nwhite-list=false\nzzz-unknown=kept as is \n")
    check(written(String("# my comment\nzzz-unknown = kept as is \nCustom.Key:  value:with=specials#!\nonline-mode=TRUE\npvp=false\nhardcore=yes\nmax-players=abc\nserver-port= 25566\nview-distance=32\ndifficulty=2\ngamemode=7\nop-permission-level=9\nfunction-permission-level=-3\nmax-world-size=0\nlevel-type=FLAT\ngenerator-settings=\{ \"a\" : [1, 2.50, \"x\"], \"b\": \{\} \}\nresource-pack-hash=abc\nannounce-player-achievements=true\nmotd=\\u00a7cRed \\u4e2d caf\\u00e9  two\nlevel-seed=  spaced seed\nmanagement-server-secret=\nmax-tick-time=99999999999\nspawn-protection=1e3\nrate-limit=+5\nsimulation-distance=-0\nwhite-list=false\ntab\\tkey=a\\tb\n"), String("unused"), tricky_date), "#Minecraft server properties\n#{tricky_date}\n{tricky}")

    // Vanilla doesn't start with this. Calcite gives it the default, as every other number has.
    check(one("entity-broadcast-range-percentage=abc", "entity-broadcast-range-percentage"), "100")
    check(one("entity-broadcast-range-percentage=5", "entity-broadcast-range-percentage"), "10")
    check(one("entity-broadcast-range-percentage=5000", "entity-broadcast-range-percentage"), "1000")
    check(one("max-world-size=40000000", "max-world-size"), "29999984")
    check(one("max-world-size=x", "max-world-size"), "29999984")
    check(one("op-permission-level=-1", "op-permission-level"), "0")
    check(one("max-tick-time=-1", "max-tick-time"), "-1")
    check(one("max-tick-time=9223372036854775808", "max-tick-time"), "60000")
    check(one("max-players=30 ", "max-players"), "20")
    check(one("difficulty=7", "difficulty"), "hard")
    check(one("difficulty=HARD", "difficulty"), "easy")
    check(one("difficulty=hard", "difficulty"), "hard")
    check(one("gamemode=2", "gamemode"), "adventure")
    check(one("gamemode=x", "gamemode"), "survival")
    check(one("level-type=Minecraft:Large_Biomes", "level-type"), "minecraft:large_biomes")

    // generator-settings, as Gson's JsonObject reads it and writes it again.
    check(one("generator-settings=", "generator-settings"), "\{\}")
    check(one("generator-settings=\{ \"a\" : [1, 2.50, \"x\"], \"b\": \{\} \}", "generator-settings"), "\{\"a\":[1,2.50,\"x\"],\"b\":\{\}\}")
    check(one("generator-settings=\{\"a\":1,\"b\":2,\"a\":3\}", "generator-settings"), "\{\"a\":3,\"b\":2\}")
    check(one("generator-settings=\{\"a\":1\} x", "generator-settings"), "\{\"a\":1\}")
    check(one("generator-settings=\{\"a\":1\}// comment", "generator-settings"), "\{\"a\":1\}")
    check(one("generator-settings=\{\"n\":[1.0e5,-0,1E+2,0.10,-1.5e-3,123456789012345678901234567890]\}", "generator-settings"), "\{\"n\":[1.0e5,-0,1E+2,0.10,-1.5e-3,123456789012345678901234567890]\}")
    check(one("generator-settings=\{\"a\":\"\\\\u00e9 \\\\u0041 \\\\/ \\\\u2028 \\\\t \\\\u0001\"\}", "generator-settings"), "\{\"a\":\"\u{E9} A / \\u2028 \\t \\u0001\"\}")
    check(one("generator-settings=\{\"t\":true,\"f\":false,\"z\":null,\"e\":[],\"o\":\{\"x\":\{\"y\":[[]]\}\}\}", "generator-settings"), "\{\"t\":true,\"f\":false,\"z\":null,\"e\":[],\"o\":\{\"x\":\{\"y\":[[]]\}\}\}")
    // Vanilla doesn't start with these either.
    check(one("generator-settings=[1]", "generator-settings"), "error: generator-settings isn't a JSON object: [1]")
    check(one("generator-settings=null", "generator-settings"), "error: generator-settings isn't a JSON object: null")
    check(one("generator-settings=\{'a':1\}", "generator-settings"), "error: generator-settings isn't a JSON object: \{'a':1\}")
    check(one("generator-settings=\{\"a\":1,\}", "generator-settings"), "error: generator-settings isn't a JSON object: \{\"a\":1,\}")

    // A new secret is 40 letters and digits, and two differ.
    let a = new_secret()
    let b = new_secret()
    var plain = true
    for r in a.runes() {
        if not ((r >= 'A' and r <= 'Z') or (r >= 'a' and r <= 'z') or (r >= '0' and r <= '9')) {
            plain = false
        }
    }
    check("{a.len()} {plain} {a != b}", "40 true true")
    println("ok")
}
