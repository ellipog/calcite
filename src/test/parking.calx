/// Checks a scheduler started again from what an old one parked (D683) against one that keeps
/// everything, in a real world: vanilla's Overworld of seed 20261103, the lockstep check's, its
/// chunks finished out to 4 from the origin, a ring at a time, by both; the second parks all it
/// keeps once those out to 1 are finished, writes each chunk and reads it back, and starts again
/// from them, knowing those finished as full, as the generator's thread does. Each chunk finished
/// has the same blocks, block entities, ticks, entities and structures from both. Where the
/// scheduler started again made its starts again, what their pieces had placed before the park
/// was placed again, such as a mineshaft corridor's spider spawner (CAL-114).
module test.parking

import nbt.tag.{Tag}
import pack.data.{Data}
import pack.vanilla.{vanilla_jar}
import rig.registries.{load_vanilla}
import server.log.{Entry}
import server.play.{block_states}
import storage.chunk.{ChunkData, ChunkFormat, ChunkRest}
import storage.regions.{read_root}
import world.chunk.{Chunk}
import worldgen.generator.{GenSetup, Worker, parked_data}
import worldgen.references.{chunk_key}
import worldgen.scheduler.{Saved, Scheduler, scheduler_for}

const SEED: i64 = 20261103
const PARKED_AT: i32 = 1
const OUT_TO: i32 = 4

// Each block state of the chunk, hashed, a section at a time.
fn blocks_hash(c: Chunk) -> u64 {
    var h: u64 = 14695981039346656037u64
    for i in 0..c.section_count() {
        let s = c.section(i)
        for y in 0..16 {
            for z in 0..16 {
                for x in 0..16 {
                    h = (h ^ u64(s.block(x, y, z))).wrapping_mul(1099511628211u64)
                }
            }
        }
    }
    return h
}

// The rest of what a chunk saves, as text: its block entities and its entities but for their
// UUIDs, each in order of their text, its ticks counted and its structures.
fn rest_text(r: ChunkRest) -> String {
    var be = List<String>()
    for b in r.block_entities {
        be.push("{b}")
    }
    be.sort()
    var es = List<String>()
    for e in r.entities {
        if let Tag.Compound(m) = e {
            var kept = m.copy()
            _ = kept.remove("UUID")
            es.push("{Tag.Compound(kept)}")
        }
    }
    es.sort()
    return "{be.join(String("; "))} | {r.block_ticks.len()} {r.fluid_ticks.len()} | {es.join(String("; "))} | {r.structures}"
}

struct Made {
    blocks: Map<i64, u64> = Map<i64, u64>()
    rests: Map<i64, String> = Map<i64, String>()
}

// The chunk at `x`, `z` finished, each look finding what `disk` has, or full where `full` says,
// and every chunk finished on the way kept in `out`.
fn finish(s: mut Scheduler, w: mut Worker, x: i32, z: i32, disk: Map<i64, ChunkData>, full: Map<i64, bool>, format: ChunkFormat, out: mut Made) {
    s.want(x, z)
    while not s.is_finished(x, z) {
        if let spot = s.next_peek() {
            let (px, pz) = spot
            let key = chunk_key(px, pz)
            var saved = Saved.Nothing
            if full.contains(key) {
                saved = Saved.Full
            } else if let data = disk.find(key) {
                saved = if format.has_features(data.status) { Saved.Decorated(data.copy()) } else { Saved.Terrain(data.copy()) }
            }
            s.peeked(px, pz, saved)
            continue
        }
        let job = s.next() else panic("nothing to do, with the chunk at {x}, {z} not finished")
        s.take(w.run(job))
    }
    while let (fx, fz, chunk, rest) = s.take_finished() {
        out.blocks.insert(chunk_key(fx, fz), blocks_hash(chunk))
        out.rests.insert(chunk_key(fx, fz), rest_text(rest))
    }
}

// The chunks out to `r`, a ring at a time from the origin.
fn ring(r: i32) -> List<(i32, i32)> {
    var out = List<(i32, i32)>()
    for z in -r..r + 1 {
        for x in -r..r + 1 {
            if x.abs().max(z.abs()) == r {
                out.push((x, z))
            }
        }
    }
    return out
}

fn written_and_read(format: ChunkFormat, data: own ChunkData) -> ChunkData {
    var bytes = List<u8>()
    data.write_bytes(format, mut bytes)!
    let Tag.Compound(fields) = read_root(bytes)! else panic("a parked chunk's root isn't a compound")
    var lines = List<Entry>()
    return ChunkData.parse(format, -4, 24, fields, mut lines)! ?? panic("a parked chunk has no status")
}

fn main() {
    let loaded = load_vanilla()!
    let zip = Data.of_zip(vanilla_jar(String("oracle/jars/server-26.3.jar"))!)
    let b = loaded.registries.find_builtin(String("block")) ?? panic("no block registry")
    let f = loaded.registries.find_builtin(String("fluid")) ?? panic("no fluid registry")
    let bi = loaded.registries.find(String("worldgen/biome")) ?? panic("no biome registry")
    let table = block_states(loaded.registries)!
    let uncarvable = loaded.registries.builtin[b].tag_values(String("uncarvable"))
    let setup = GenSetup { settings: String("minecraft:overworld"), blocks: loaded.registries.builtin[b].copy(), fluids: loaded.registries.builtin[f].copy(), biomes: loaded.registries.synced[bi].copy(), table: table, uncarvable: uncarvable, seed: SEED }
    let format = ChunkFormat.new(loaded.registries)!
    var w = Worker.new(zip.copy(), setup.copy())!
    let gen_table = w.table()
    let nothing = Map<i64, ChunkData>()
    let none_full = Map<i64, bool>()

    var whole = scheduler_for(zip.copy(), setup.copy())!
    var kept = Made {}
    for r in 0..OUT_TO + 1 {
        for (x, z) in ring(r) {
            finish(mut whole, mut w, x, z, nothing, none_full, format, mut kept)
        }
    }

    var s = scheduler_for(zip.copy(), setup.copy())!
    var carried = Made {}
    var disk = Map<i64, ChunkData>()
    var full = Map<i64, bool>()
    var decorated = 0
    for r in 0..OUT_TO + 1 {
        for (x, z) in ring(r) {
            finish(mut s, mut w, x, z, disk, full, format, mut carried)
        }
        if r != PARKED_AT {
            continue
        }
        for (k, _) in carried.blocks {
            full.insert(k, true)
        }
        var own_terrain = Map<i64, bool>()
        var parked = s.parked()
        while let p = parked.pop() {
            let key = chunk_key(p.x, p.z)
            if p.decorated {
                decorated += 1
            } else {
                own_terrain.insert(key, true)
            }
            disk.insert(key, written_and_read(format, parked_data(format, gen_table, p)))
        }
        var fresh = s.renewed()
        fresh.own_terrain = own_terrain
        for (k, _) in full {
            fresh.peeked(i32.wrap(k), i32.wrap(k >> 32), Saved.Full)
        }
        s = fresh
    }
    let side = OUT_TO * 2 + 1
    if kept.blocks.len() != usize.wrap(side * side) or carried.blocks.len() != kept.blocks.len() or decorated == 0 {
        panic("finished {kept.blocks.len()} and {carried.blocks.len()}, of {side * side}, {decorated} parked decorated")
    }
    for (k, h) in carried.blocks {
        let x = i32.wrap(k)
        let z = i32.wrap(k >> 32)
        if (kept.blocks.get(k) ?? 0u64) != h {
            panic("the chunk at {x}, {z} carried on from what was parked has other blocks than one kept")
        }
        if carried.rests[k] != kept.rests[k] {
            panic("the chunk at {x}, {z} carried on from what was parked saves otherwise than one kept:\n  kept    {kept.rests[k]}\n  carried {carried.rests[k]}")
        }
    }
    println("ok")
}
