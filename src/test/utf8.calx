/// Checks `java.text`'s `decode_utf8` and `LineReader` against JDK 25: the lines vanilla's console
/// thread reads, through a `BufferedReader` over an `InputStreamReader` in UTF-8, from each input.
/// Each case's lines are what the JDK gave, covering every way a sequence is malformed, cut off,
/// overlong, a surrogate or past U+10FFFF, and each way a line ends. LineReader was compared with
/// the JDK on 200,000 random inputs too, each split into two pieces at every point.
module test.utf8

import java.text.{LineReader}

fn nibble(c: u8) -> u8 {
    return if c >= 97 { c - 87 } else { c - 48 }
}

fn unhex(s: str) -> List<u8> {
    let text = String(s)
    var out = List<u8>()
    var i: usize = 0
    while i + 1 < text.len() {
        out.push(nibble(text.byte_at(i)) * 16 + nibble(text.byte_at(i + 1)))
        i += 2
    }
    return out
}

// Reads `input` whole, then in two pieces split at every point, so a line or a character can
// span them.
fn check(input: str, want: List<String>) {
    let bytes = unhex(input)
    for cut in 0..bytes.len() + 1 {
        var first = List<u8>()
        var second = List<u8>()
        for i in 0..bytes.len() {
            if i < cut {
                first.push(bytes[i])
            } else {
                second.push(bytes[i])
            }
        }
        var reader = LineReader()
        var got = reader.push(first)
        for line in reader.push(second) {
            got.push(line.copy())
        }
        if let last = reader.finish() {
            got.push(last)
        }
        if got != want {
            panic("{input} split at {cut}: got {got}, want {want}")
        }
    }
}

fn main() {
    check("", [])
    check("68690a", ["hi"])
    check("610d0a620d630a0a64", ["a", "b", "c", "", "d"])
    check("0d", [""])
    check("c3a9", ["\u{E9}"])
    check("c3", ["\u{FFFD}"])
    check("c328", ["\u{FFFD}("])
    check("c0af", ["\u{FFFD}\u{FFFD}"])
    check("c1bf", ["\u{FFFD}\u{FFFD}"])
    check("e282ac", ["\u{20AC}"])
    check("e282", ["\u{FFFD}"])
    check("e28228", ["\u{FFFD}("])
    check("e08080", ["\u{FFFD}\u{FFFD}\u{FFFD}"])
    check("e0a080", ["\u{800}"])
    check("eda080", ["\u{FFFD}"])
    check("eda0", ["\u{FFFD}"])
    check("ed9fbf", ["\u{D7FF}"])
    check("eebfbf", ["\u{EFFF}"])
    check("f09f9880", ["\u{1F600}"])
    check("f09f98", ["\u{FFFD}"])
    check("f09f", ["\u{FFFD}"])
    check("f0", ["\u{FFFD}"])
    check("f08f8080", ["\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}"])
    check("f4908080", ["\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}"])
    check("f48fbfbf", ["\u{10FFFF}"])
    check("f5808080", ["\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}"])
    check("f09f28", ["\u{FFFD}("])
    check("f09f9828", ["\u{FFFD}("])
    check("80", ["\u{FFFD}"])
    check("bf", ["\u{FFFD}"])
    check("ff", ["\u{FFFD}"])
    check("f8", ["\u{FFFD}"])
    check("e20a82", ["\u{FFFD}", "\u{FFFD}"])
    check("73746f70", ["stop"])
    check("2f73746f70", ["/stop"])
    println("ok")
}
