/// Checks `java.regex` against JDK 25's `java.util.regex`: for each case, whether the pattern,
/// compiled with its flags, matches all of the input, or the description and index of the
/// `PatternSyntaxException` it throws, and for some its whole message. Each answer is Java's.
/// The parts Calcite doesn't match yet fail as unsupported, which is checked at the end.
module test.regex

import java.regex.{CANON_EQ, CASE_INSENSITIVE, COMMENTS, DOTALL, LITERAL, MULTILINE, UNICODE_CASE, UNIX_LINES, Pattern, UNICODE_CHARACTER_CLASS}

fn check(flags: u32, pattern: String, input: String, want: String) {
    let got = match Pattern.compile(pattern, flags) {
        ok(p) => if p.matches(input) { String("match") } else { String("no") },
        err(e) => "error {e.description} @{e.index}",
    }
    if got != want {
        panic("`{pattern}` with flags {flags} on `{input}`: got {got}, want {want}")
    }
}

// Java's `getMessage`, with `\n` for the system's line separator.
fn message(flags: u32, pattern: String, want: String) {
    match Pattern.compile(pattern, flags) {
        ok(_) => panic("`{pattern}` compiled"),
        err(e) => {
            let got = e.message("\n")
            if got != want {
                panic("`{pattern}`: got {got}, want {want}")
            }
        },
    }
}

// What Calcite can't match yet fails, saying it's unsupported, rather than matching otherwise.
fn unsupported(flags: u32, pattern: String, what: String) {
    match Pattern.compile(pattern, flags) {
        ok(_) => panic("`{pattern}` compiled"),
        err(e) => {
            if not e.unsupported or e.description != "Unsupported: {what}" {
                panic("`{pattern}`: {e.description}, unsupported {e.unsupported}")
            }
        },
    }
}

fn main() {
    check(0, "abc", "abc", "match")
    check(0, "abc", "abcd", "no")
    check(0, "", "", "match")
    check(0, "", "a", "no")
    check(0, "a.c", "abc", "match")
    check(0, "a.c", "a\nc", "no")
    check(DOTALL, "a.c", "a\nc", "match")
    check(0, "a.c", "a\u{d}c", "no")
    check(UNIX_LINES, "a.c", "a\u{d}c", "match")
    check(0, "a.c", "a\u{2028}c", "no")
    check(0, ".", "\u{1f600}", "match")
    check(0, "..", "\u{1f600}", "no")
    check(0, "[\u{1f600}]", "\u{1f600}", "match")
    check(0, "a*", "", "match")
    check(0, "a*", "aaaa", "match")
    check(0, "a+", "", "no")
    check(0, "a?b", "b", "match")
    check(0, "a+?b", "aaab", "match")
    check(0, "a\{2,3\}", "aaa", "match")
    check(0, "a\{2,3\}", "aaaa", "no")
    check(0, "a\{2,\}", "aaaaaa", "match")
    check(0, "a\{3\}", "aaa", "match")
    check(0, "a*+a", "aaa", "no")
    check(0, "a++b", "aab", "match")
    check(0, "(a|aa)*b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", "match")
    check(0, "(a|aa)*c", "aaaaaaaaaaaaaaaaaaaab", "no")
    check(0, "(?:ab)*", "ababab", "match")
    check(0, "(a*)*", "aaa", "match")
    check(0, "(a?)+?b", "aab", "match")
    check(0, "cat|dog", "dog", "match")
    check(0, "cat|dog", "cow", "no")
    check(0, "(a)(b)?", "a", "match")
    check(0, "(a+)b\\1", "aabaa", "match")
    check(0, "(a+)b\\1", "aaba", "no")
    check(0, "(?<x>a+)-\\k<x>", "aa-aa", "match")
    check(0, "\\1", "", "no")
    check(0, "(a)\\2", "a", "no")
    check(0, "(a)\\11", "aa1", "match")
    check(0, "(?:a)\\1", "a", "no")
    check(0, "(?=a)a", "a", "match")
    check(0, "(?!a).", "b", "match")
    check(0, "(?!a).", "a", "no")
    check(0, ".(?<=a)", "a", "match")
    check(0, ".(?<!a)", "a", "no")
    check(0, "a(?=b).", "ab", "match")
    check(0, "(?>a+)a", "aaa", "no")
    check(0, "x(?<=x|xyz)", "x", "match")
    check(0, "[a-z]+", "hello", "match")
    check(0, "[^abc]", "d", "match")
    check(0, "[^abc]", "a", "no")
    check(0, "[a-z&&[^aeiou]]+", "bcd", "match")
    check(0, "[a-z&&[^aeiou]]+", "bad", "no")
    check(0, "[\\w&&\\D]+", "ab_", "match")
    check(0, "[\\w&&\\D]+", "a1", "no")
    check(0, "\\s+", " \t\n", "match")
    check(0, "\\S", " ", "no")
    check(0, "\\d+", "0123", "match")
    check(0, "\\d", "\u{663}", "no")
    check(0, "\\w", "\u{e9}", "no")
    check(0, "\\h", "\u{a0}", "match")
    check(0, "\\v", "\u{b}", "match")
    check(0, "\\R", "\u{d}\n", "match")
    check(0, "\\R\\R", "\u{d}\n", "match")
    check(0, "[]a]", "]", "match")
    check(0, "[a-]", "-", "match")
    check(0, "[-a]", "-", "match")
    check(0, "[\\]]", "]", "match")
    check(0, "[a[b]]", "b", "match")
    check(0, "[^a[b]]", "b", "no")
    check(0, "[\\x41-\\x43]", "B", "match")
    check(0, "[\u{e9}-\u{ff}]", "\u{f0}", "match")
    check(0, "[\\Q]\\E]", "]", "match")
    check(0, "^a$", "a", "match")
    check(0, "a$", "a\n", "no")
    check(0, "a\\z", "a", "match")
    check(0, "a\\Z", "a", "match")
    check(0, "\\Aa", "a", "match")
    check(MULTILINE, "a$\n^b", "a\nb", "match")
    check(0, "a\\b", "a", "match")
    check(0, "\\bfoo\\b", "foo", "match")
    check(0, "a\\Bb", "ab", "match")
    check(0, "a\\b b", "a b", "match")
    check(0, "\\G", "", "match")
    check(0, "\u{e9}\\b", "\u{e9}", "no")
    check(0, "a\\b\u{e9}", "a\u{e9}", "match")
    check(0, "\\B\u{e9}", "\u{e9}", "match")
    check(0, "\u{663}\\b", "\u{663}", "no")
    check(0, "e\\b\u{301}", "e\u{301}", "no")
    check(0, ".\\b.", "a\u{e9}", "match")
    check(0, "e\\B\u{301}", "e\u{301}", "match")
    check(0, "\\b\u{301}", "\u{301}", "no")
    check(0, "\u{e9}\\b\u{301}", "\u{e9}\u{301}", "match")
    check(0, "_\\b\u{301}", "_\u{301}", "match")
    check(0, "1\\b\u{301}", "1\u{301}", "no")
    check(0, "\u{2160}\\b\u{301}", "\u{2160}\u{301}", "no")
    check(0, "\u{2ca}\\b\u{301}", "\u{2ca}\u{301}", "match")
    check(0, "\u{1d400}\\b\u{301}", "\u{1d400}\u{301}", "no")
    check(0, "a\\b\u{1d167}", "a\u{1d167}", "no")
    check(0, "a\u{1d167}\\b", "a\u{1d167}", "no")
    check(0, "\u{903}\\b\u{301}", "\u{903}\u{301}", "no")
    check(0, "a\u{301}\\b", "a\u{301}", "match")
    check(0, "\u{e9}\u{301}\\b\u{308}", "\u{e9}\u{301}\u{308}", "no")
    check(0, "e\u{301}\u{308}\\b", "e\u{301}\u{308}", "match")
    check(0, "\u{1d167}\\b\u{301}", "\u{1d167}\u{301}", "no")
    check(0, "\\b\u{301}a", "\u{301}a", "no")
    check(0, "\\Ba\\B\u{301}\u{34f}", "a\u{301}\u{34f}", "no")
    check(0, "\\Q.*\\E", ".*", "match")
    check(0, "\\Q.*", ".*", "match")
    check(0, "\\x41", "A", "match")
    check(0, "\\x\{1F600\}", "\u{1f600}", "match")
    check(0, "\\u00e9", "\u{e9}", "match")
    check(0, "\\ud83d\\ude00", "\u{1f600}", "match")
    check(0, "\\0101", "A", "match")
    check(0, "\\0777", "?7", "match")
    check(0, "\\cA", "\u{1}", "match")
    check(0, "\\t\\n\\r\\f\\a\\e", "\t\n\u{d}\u{c}\u{7}\u{1b}", "match")
    check(0, "\\.", ".", "match")
    check(0, "\\-", "-", "match")
    check(0, "\\N\{LATIN SMALL LETTER E WITH ACUTE\}", "\u{e9}", "match")
    check(CASE_INSENSITIVE, "abc", "ABC", "match")
    check(CASE_INSENSITIVE, "\u{e9}", "\u{c9}", "no")
    check(CASE_INSENSITIVE | UNICODE_CASE, "\u{e9}", "\u{c9}", "match")
    check(CASE_INSENSITIVE | UNICODE_CASE, "k", "\u{212a}", "match")
    check(CASE_INSENSITIVE, "k", "\u{212a}", "no")
    check(CASE_INSENSITIVE | UNICODE_CASE, "\u{df}", "SS", "no")
    check(CASE_INSENSITIVE | UNICODE_CASE, "\u{3c3}", "\u{3a3}", "match")
    check(CASE_INSENSITIVE | UNICODE_CASE, "\u{3c3}", "\u{3c2}", "match")
    check(CASE_INSENSITIVE | UNICODE_CASE, "[a-z]", "\u{212a}", "match")
    check(CASE_INSENSITIVE, "[a-z]+", "ABC", "match")
    check(CASE_INSENSITIVE | UNICODE_CASE, "(a)\\1", "aA", "match")
    check(0, "(?i)a", "A", "match")
    check(0, "(?i:a)b", "Ab", "match")
    check(0, "(?i:a)b", "AB", "no")
    check(CASE_INSENSITIVE, "(?-i)a", "A", "no")
    check(0, "(?iu)\u{e9}", "\u{c9}", "match")
    check(0, "(?i)\u{e9}", "\u{c9}", "no")
    check(COMMENTS, "a b # c", "ab", "match")
    check(COMMENTS, "a\\ b", "a b", "match")
    check(COMMENTS, "[a b]", " ", "no")
    check(0, "(?x)a b", "ab", "match")
    check(LITERAL, ".*", ".*", "match")
    check(LITERAL, ".*", "x", "no")
    check(LITERAL | CASE_INSENSITIVE, "a.", "A.", "match")
    check(0, "(?s).", "\n", "match")
    check(0, "(?d).", "\u{d}", "match")
    check(0, "(?m)^b", "b", "match")
    check(0, "(", "", "error Unclosed group @1")
    check(0, ")", "", "error Unmatched closing ')' @-1")
    check(0, "[", "", "error Unclosed character class @0")
    check(0, "*a", "", "error Dangling meta character '*' @0")
    check(0, "a**", "", "error Dangling meta character '*' @2")
    check(0, "+", "", "error Dangling meta character '+' @0")
    check(0, "a\{2,1\}", "", "error Illegal repetition range @5")
    check(0, "a\{", "", "error Illegal repetition @2")
    check(0, "\{", "", "error Illegal repetition @1")
    check(0, "a\{,2\}", "", "error Illegal repetition @2")
    check(0, "\\", "", "error Unescaped trailing backslash @1")
    check(0, "a\\", "", "error Unescaped trailing backslash @2")
    check(0, "\\y", "", "error Illegal/unsupported escape sequence @1")
    check(0, "\\k<nope>", "", "error named capturing group <nope> does not exist @7")
    check(0, "(?<1a>x)", "", "error capturing group name does not start with a Latin letter @3")
    check(0, "(?<a>x)(?<a>y)", "", "error Named capturing group <a> is already defined @11")
    check(0, "[z-a]", "", "error Illegal character range @3")
    check(0, "(?", "", "error Unknown inline modifier @2")
    check(0, "(?z)", "", "error Unknown inline modifier @2")
    check(0, "\\x\{110000\}", "", "error Hexadecimal codepoint is too big @8")
    check(0, "\\xg", "", "error Illegal hexadecimal escape sequence @2")
    check(0, "\\c", "", "error Illegal control escape sequence @1")
    check(0, "\\N\{NOT A NAME\}", "", "error Unknown character name [NOT A NAME] @13")
    check(0, "[a-", "", "error Illegal character range @3")
    check(0, "a\{99999999999\}", "", "error Illegal repetition range @11")
    check(0, "(?<=a+)b", "", "no")
    check(0, "\\Q", "", "match")
    check(0, "x|*", "", "error Dangling meta character '*' @2")
    check(COMMENTS, "( # open", "", "error Unclosed group @8")
    check(0, "ab(cd", "", "error Unclosed group @5")
    check(0, "a\n(", "", "error Unclosed group @3")

    message(0, "(", "Unclosed group near index 1\n(")
    message(0, ")", "Unmatched closing ')'\n)")
    message(0, "[", "Unclosed character class near index 0\n[\n^")
    message(0, "*a", "Dangling meta character '*' near index 0\n*a\n^")
    message(0, "a**", "Dangling meta character '*' near index 2\na**\n  ^")
    message(0, "+", "Dangling meta character '+' near index 0\n+\n^")
    message(0, "a\{2,1\}", "Illegal repetition range near index 5\na\{2,1\}\n     ^")
    message(0, "a\{", "Illegal repetition near index 2\na\{")
    message(0, "\{", "Illegal repetition near index 1\n\{")
    message(0, "a\{,2\}", "Illegal repetition near index 2\na\{,2\}\n  ^")
    message(0, "\\", "Unescaped trailing backslash near index 1\n\\")
    message(0, "a\\", "Unescaped trailing backslash near index 2\na\\")

    unsupported(0, "\\p\{L\}", "Unicode properties")
    unsupported(0, "\\X", "grapheme clusters")
    unsupported(0, "\\b\{g\}", "grapheme cluster boundaries")
    unsupported(CANON_EQ, "a", "CANON_EQ")
    unsupported(UNICODE_CHARACTER_CLASS, "\\w", "Unicode classes")
    println("ok")
}
