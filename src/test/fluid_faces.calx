/// Checks the faces a fluid sees of block states, `Facts.passes_wall`, as vanilla's
/// `FlowingFluid.canPassThroughWall` says (D327): by hand, between whole blocks, air, slabs and
/// stairs; and at the places datagen wrote, where a state vanilla offsets by its position meets
/// another and its moving changes the answer, and where vanilla offsets those states.
module test.fluid_faces

import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.chunk.{BlockStates}
import world.fluid_faces.{offset_cases, wall_cases}
import worldgen.facts.{DOWN, EAST, Facts, NORTH, SOUTH, UP, WEST}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn facts() -> Facts {
    var blocks = Registry.new(full("block"), false)
    for e in builtin_entries(4) {
        blocks.add(full(e), none)
    }
    var fluids = Registry.new(full("fluid"), false)
    for e in builtin_entries(2) {
        fluids.add(full(e), none)
    }
    return match Facts.new(blocks, fluids, BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn with(f: Facts, state: u32, name: str, value: str) -> u32 {
    return match f.with_name(state, String(name), String(value)) {
        ok(s) => s,
        err(_) => panic("no {name} {value}"),
    }
}

// Whole blocks and air, a slab each way up, and stairs, by hand.
fn by_hand() {
    let f = facts()
    let air = named(f, "air")
    let water = f.ids.water_state
    let stone = named(f, "stone")
    let slab = named(f, "oak_slab")
    let top = with(f, slab, "type", "top")
    let stairs = named(f, "oak_stairs")
    check(f.passes_wall(DOWN, 0, 64, 0, water, air), "water doesn't pass down into air")
    check(not f.passes_wall(DOWN, 0, 64, 0, water, stone), "water passes into stone")
    check(not f.passes_wall(UP, 0, 64, 0, stone, water), "stone lets water through")
    check(f.passes_wall(DOWN, 0, 64, 0, water, slab), "a bottom slab's top shuts water out above it")
    check(not f.passes_wall(DOWN, 0, 64, 0, water, top), "a top slab's top lets water through")
    check(f.passes_wall(EAST, 0, 64, 0, water, slab), "a bottom slab's side shuts water out")
    // A bottom slab's top and a top slab's bottom both stop short of the gap between them.
    check(f.passes_wall(UP, 0, 64, 0, slab, top), "a bottom slab under a top slab shuts water out between them")
    check(f.passes_wall(WEST, 0, 64, 0, slab, slab), "two bottom slabs side by side shut water out")
    // Stairs facing north have their step to the north: their north side is whole, their south
    // side the slab's half.
    check(not f.passes_wall(SOUTH, 0, 64, -1, water, stairs), "the back of stairs lets water through")
    check(f.passes_wall(NORTH, 0, 64, 1, water, stairs), "the front of stairs shuts water out")
    check(f.passes_wall(EAST, 0, 64, 0, water, stairs), "the side of stairs shuts water out")
    check(f.fluid_face(stone, UP) == 1 and f.fluid_face(air, UP) == 0 and f.fluid_face(water, DOWN) == 0, "the whole and empty faces")
    println("ok by_hand")
}

// Where datagen found vanilla's answer changes as a state moves, and some where it doesn't.
fn moving() {
    let f = facts()
    let cases = wall_cases()
    var i: usize = 0
    var n = 0
    while i + 6 < cases.len() {
        let got = f.passes_wall(cases[i + 3], cases[i], cases[i + 1], cases[i + 2], u32.wrap(cases[i + 4]), u32.wrap(cases[i + 5]))
        if got != (cases[i + 6] == 1) {
            panic("canPassThroughWall {cases[i + 3]} from {cases[i + 4]} at {cases[i]}, {cases[i + 1]}, {cases[i + 2]} to {cases[i + 5]}: vanilla says {cases[i + 6]}")
        }
        n += 1
        i += 7
    }
    check(n >= 32, "too few cases")
    println("ok moving, {n} cases")
}

// Where vanilla offsets the states that move, to the bit.
fn offsets() {
    let f = facts()
    let cases = offset_cases()
    var i: usize = 0
    var n = 0
    while i + 5 < cases.len() {
        let (dx, dy, dz) = f.offset(u32.wrap(cases[i]), i32.wrap(cases[i + 1]), i32.wrap(cases[i + 2]))
        let want_x = f64.from_bits(u64.wrap(cases[i + 3]))
        let want_y = f64.from_bits(u64.wrap(cases[i + 4]))
        let want_z = f64.from_bits(u64.wrap(cases[i + 5]))
        if dx != want_x or dy != want_y or dz != want_z {
            panic("state {cases[i]} at {cases[i + 1]}, {cases[i + 2]} is offset {dx}, {dy}, {dz}, not {want_x}, {want_y}, {want_z}")
        }
        n += 1
        i += 6
    }
    check(n > 0, "no offset cases")
    println("ok offsets, {n} cases")
}

fn main() {
    by_hand()
    moving()
    offsets()
    println("ok")
}
