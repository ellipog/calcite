// Pregenerating chunks (CAL-71, D275): each shape holds the chunks whose middles are in it, each
// pattern walks an area's chunks once each in its order, a task holds a window of them in a level
// until each is full, and a task saved partway carries on from where it was.
module test.pregen

import nbt.tag.{Tag}
import server.pregen.{Holds, MOST_HELD, MOST_STARTED_A_TICK, Pattern, Selection, Shape, Task, Walk, duration, saved_task}
import world.pos.{ChunkPos}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// The chunks a selection's area holds.
fn count(shape: Shape, radius: f64, radius_z: f64) -> u64 {
    return Selection { shape: shape, radius: radius, radius_z: radius_z }.area().count()
}

fn shapes() {
    // A square 500 blocks around 0, 0 holds the chunks from -31 to 30 on each axis, whose middles,
    // -488 to 488, are within 500: 62 × 62.
    let square = Selection {}.area()
    check("{square.min_x} {square.max_x} {square.count()}", String("-31 30 3844"))
    check("{count(Shape.Rectangle, 500.0, 100.0)}", "{62 * 12}")
    // A circle's is about π r², a diamond's 2 r², an ellipse's π a b, in chunks of 16 × 16.
    let circle = count(Shape.Circle, 1000.0, 1000.0)
    let diamond = count(Shape.Diamond, 1000.0, 1000.0)
    let ellipse = count(Shape.Ellipse, 1000.0, 400.0)
    check("{near(circle, 3.141592653589793 * 1000.0 * 1000.0 / 256.0)} {near(diamond, 2.0 * 1000.0 * 1000.0 / 256.0)} {near(ellipse, 3.141592653589793 * 1000.0 * 400.0 / 256.0)}", String("true true true"))
    // A regular polygon's area is n r² sin(2π / n) / 2; a pentagram's, with its inner points at
    // (3 - √5) / 2, about 1.12 r².
    let triangle = count(Shape.Triangle, 1000.0, 1000.0)
    let hexagon = count(Shape.Hexagon, 1000.0, 1000.0)
    let star = count(Shape.Star, 1000.0, 1000.0)
    check("{near(triangle, 1.299038 * 1000000.0 / 256.0)} {near(hexagon, 2.598076 * 1000000.0 / 256.0)} {near(star, 1.122569 * 1000000.0 / 256.0)}", String("true true true"))
    // The triangle's first point is north: it holds the chunk at the top of its middle, not the
    // one as far south.
    let t = Selection { shape: Shape.Triangle, radius: 1000.0 }.area()
    check("{t.contains(ChunkPos { x: -1, z: -60 })} {t.contains(ChunkPos { x: -1, z: 58 })}", String("true false"))
    // Counted a row at a time, each shape holds as many as `contains` says, chunk by chunk, around
    // centers on and off the chunks' corners and middles.
    for s in Shape.all() {
        for (cx, cz, r, rz) in [(0.0, 0.0, 300.0, 200.0), (13.5, -1001.25, 517.0, 333.3), (-8.0, 8.0, 96.0, 160.0), (7.99, 4096.0, 1000.0, 64.0), (0.0, 0.0, 24.0, 8.0)] {
            let area = Selection { shape: s, center_x: cx, center_z: cz, radius: r, radius_z: rz }.area()
            var n: u64 = 0
            for z in area.min_z - 2..area.max_z + 3 {
                for x in area.min_x - 2..area.max_x + 3 {
                    if area.contains(ChunkPos { x: x, z: z }) {
                        n += 1
                    }
                }
            }
            check("{s.name()} {cx} {area.count()}", "{s.name()} {cx} {n}")
        }
    }
    // The world border's square, 29999984 around, is counted at once.
    check("{Selection { radius: 29999984.0 }.area().count()}", "{3749998u64 * 3749998}")
    // A radius under 8 holds no chunk, as the middles nearest 0, 0 are at ±8; one of 8 holds the
    // four around it. The names read back.
    check("{count(Shape.Square, 7.0, 7.0)} {count(Shape.Square, 8.0, 8.0)}", String("0 4"))
    for s in Shape.all() {
        check("{Shape.named(String(s.name())) == some(s)}", String("true"))
    }
    check("{Shape.named(String("blob")) == none} {Pattern.named(String("spiral")) == some(Pattern.Spiral)}", String("true true"))
    println("ok shapes")
}

// Whether `n` is within 2% of `want`.
fn near(n: u64, want: f64) -> bool {
    let d = f64.nearest(n) - want
    return d.abs() <= want * 0.02
}

// The walk's chunks, in order.
fn walked(pattern: Pattern, selection: Selection) -> List<ChunkPos> {
    var w = Walk.new(pattern, selection.area())
    var out = List<ChunkPos>()
    while let p = w.next() {
        out.push(p)
    }
    return out
}

fn patterns() {
    let s = Selection { shape: Shape.Circle, center_x: 100.0, center_z: -300.0, radius: 700.0 }
    let total = s.area().count()
    for p in Pattern.all() {
        let chunks = walked(p, s)
        var seen = Set<i64>()
        for c in chunks {
            if not s.area().contains(c) {
                panic("{p.name()} walks {c.x}, {c.z}, outside the area")
            }
            seen.insert(c.pack())
        }
        check("{p.name()} {chunks.len()} {seen.len()}", "{p.name()} {total} {total}")
    }
    // A loop goes row by row; a region's 32 × 32 one at a time; rings and the spiral start at the
    // center and go out a ring at a time.
    let square = Selection { radius: 600.0 }
    let rows = walked(Pattern.Loop, square)
    check("{rows[0].x} {rows[0].z} {rows[1].x} {rows[1].z}", String("-38 -38 -37 -38"))
    let regions = walked(Pattern.Region, square)
    // The area's corner region, -2, -2, holds chunks -38 to -33 of each of its rows.
    check("{regions[0].x} {regions[0].z} {regions[5].x} {regions[5].z} {regions[6].x} {regions[6].z}", String("-38 -38 -33 -38 -38 -37"))
    for i in 0..regions.len() - 1 {
        let a = regions[i]
        let b = regions[i + 1]
        let back = (b.z >> 5) < (a.z >> 5) or ((b.z >> 5) == (a.z >> 5) and (b.x >> 5) < (a.x >> 5))
        if back {
            panic("the region walk goes back from {a.x}, {a.z} to {b.x}, {b.z}")
        }
    }
    for p in [Pattern.Concentric, Pattern.Spiral] {
        let chunks = walked(p, square)
        check("{p.name()} {chunks[0].x} {chunks[0].z}", "{p.name()} 0 0")
        var ring = 0
        for c in chunks {
            let r = c.x.abs().max(c.z.abs())
            if r < ring {
                panic("{p.name()} goes back in from ring {ring} to {r}")
            }
            ring = r
        }
    }
    println("ok patterns")
}

// A level that holds chunks, each full `wait` steps after it's held.
struct Fake {
    held: Map<i64, i32>
    full_at: i32
    step: i32
    holds: u64
    released: u64
    most_held: usize
    gone: Set<i64>
}

impl Holds for Fake {
    fn hold(mut self, pos: ChunkPos) {
        self.held.insert(pos.pack(), self.step)
        self.holds += 1
        self.most_held = self.most_held.max(self.held.len())
    }

    fn done(self, pos: ChunkPos) -> bool {
        let k = pos.pack()
        return self.held.contains(k) and self.step - self.held[k] >= self.full_at
    }

    fn unhold(mut self, pos: ChunkPos) {
        _ = self.held.remove(pos.pack())
        self.gone.insert(pos.pack())
        self.released += 1
    }
}

fn fake() -> Fake {
    return Fake { held: Map<i64, i32>(), full_at: 3, step: 0, holds: 0, released: 0, most_held: 0, gone: Set<i64>() }
}

// Steps the task until it's done, or `steps` times, a 50 ms tick each.
fn run(task: mut Task, level: mut Fake, steps: i32) {
    for _ in 0..steps {
        if task.finished() {
            return
        }
        let now = u64(u32.wrap(level.step)) * 50000000
        task.step(mut level, now)
        level.step += 1
    }
}

fn tasks() {
    let s = Selection { radius: 1000.0 }
    var task = Task.new(s)
    var level = fake()
    check("{task.total}", "{s.area().count()}")
    task.step(mut level, 0)
    level.step += 1
    // The first step holds as many as start a tick.
    check("{task.held()} {level.holds}", "{MOST_STARTED_A_TICK} {MOST_STARTED_A_TICK}")
    run(mut task, mut level, 100000)
    // Every chunk was held once and let go once it was full; as each is full 3 steps after it's
    // held, it held 3 steps' starts at most.
    check("{task.finished()} {task.done} {task.passed} {level.holds} {level.released} {level.held.len()}", "true {task.total} {task.total} {task.total} {task.total} 0")
    check("{level.most_held}", "{3 * MOST_STARTED_A_TICK}")
    check("{task.percent()} {task.spent > 0}", String("100.0 true"))
    // Where chunks take longer, it holds `MOST_HELD` at most.
    var slow_task = Task.new(s)
    var slow = fake()
    slow.full_at = 20
    run(mut slow_task, mut slow, 100000)
    check("{slow_task.finished()} {slow.holds} {slow.most_held}", "true {slow_task.total} {MOST_HELD}")

    // Paused, it starts nothing, and what it holds finishes; then it goes on.
    var paused = Task.new(s)
    var held = fake()
    run(mut paused, mut held, 2)
    paused.set_paused(true)
    let was = held.holds
    run(mut paused, mut held, 10)
    check("{held.holds == was} {paused.held()} {held.held.len()}", String("true 0 0"))
    // Paused, it says no rate and no time left.
    if paused.progress().contains("a second") or paused.progress().contains("left") {
        panic("a paused task says a rate: {paused.progress()}")
    }
    paused.set_paused(false)
    run(mut paused, mut held, 100000)
    check("{paused.finished()} {held.holds}", "true {paused.total}")
    println("ok tasks")
}

fn resuming() {
    let s = Selection { shape: Shape.Circle, pattern: Pattern.Spiral, center_x: -2000.0, center_z: 50.0, radius: 800.0 }
    var task = Task.new(s)
    var level = fake()
    run(mut task, mut level, 40)
    let tag = task.saved(String("minecraft:the_nether"))
    let (id, again) = saved_task(tag)!
    check("{id} {again.passed} {again.done} {again.total} {again.paused}", "minecraft:the_nether {task.passed} {task.passed} {task.total} false")
    check("{again.spent / 1000000 == task.spent / 1000000} {again.selection.shape == Shape.Circle} {again.selection.pattern == Pattern.Spiral} {again.selection.center_x}", String("true true true -2000.0"))
    // Carried on, it holds the chunks from where it had passed, some of which the first held,
    // and every chunk of the area is done once it's finished.
    var rest = again
    var second = fake()
    run(mut rest, mut second, 100000)
    var all = Set<i64>()
    for k in level.gone {
        all.insert(k)
    }
    for k in second.gone {
        all.insert(k)
    }
    check("{rest.finished()} {u64(all.len())}", "true {task.total}")
    check("{second.holds}", "{task.total - task.passed}")
    // A tag that isn't a task's is none.
    check("{saved_task(Tag.Int(3)) == none}", String("true"))
    println("ok resuming")
}

fn durations() {
    check("{duration(45)} {duration(185)} {duration(7620)}", String("45 s 3 m 05 s 2 h 07 m"))
    println("ok durations")
}

fn main() {
    shapes()
    patterns()
    tasks()
    resuming()
    durations()
    println("ok")
}
