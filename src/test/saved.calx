/// Checks `storage.saved` on a world of its own: saved data written and read back, a file that
/// isn't gzipped, one that can't be read, an `..` that leaves the folder, a dimension's folder
/// made, and the lines for a save with nowhere to go. The rig's `world_folder` probe checks it
/// against vanilla.
module test.saved

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import std.fs.{is_dir, make_dir_all, remove_dir_all, temp_dir, write}
import storage.saved.{SavedFiles, parse_failed}
import storage.world.{WorldFolder, join}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn id(text: String) -> Identifier {
    return match Identifier.parse(text) {
        ok(i) => i,
        err(e) => panic("{text}: {e}"),
    }
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn found(tags: JavaHashMap<String, Tag>?) -> String {
    let t = tags else return String("none")
    var out = String()
    for key in ["data", "DataVersion"] {
        if t.contains(key) {
            out.push_str("{key}={t[key].to_snbt()} ")
        }
    }
    return out
}

fn main() {
    let universe = temp_dir()!
    let world = match WorldFolder.open(universe, String("world")) {
        ok(w) => w,
        err(e) => panic("the world didn't open: {e}"),
    }
    var lines = List<Entry>()
    let data = SavedFiles.world(world)
    check(data.folder, join(universe, String("world/data")), "the folder")
    check(data.file(id(String("minecraft:maps/last_id")))!, join(universe, String("world/data/minecraft/maps/last_id.dat")), "a file")

    // Nothing saved yet.
    check(found(data.load(id(String("minecraft:weather")), mut lines)), "none", "nothing saved")

    // Saved, then read back, with the version.
    var weather = JavaHashMap<String, Tag>()
    weather.insert(String("raining"), Tag.Byte(1))
    data.save(id(String("minecraft:weather")), Tag.Compound(weather), mut lines)!
    check(found(data.load(id(String("minecraft:weather")), mut lines)), "data=\{raining:1b\} DataVersion=5023 ", "saved and read")

    check(shown(lines), "", "nothing logged")

    // Not gzipped, and with no `DataVersion`: read as it is, with a warning.
    let plain = join(data.folder, String("minecraft/plain.dat"))
    write(plain, [10, 0, 0, 3, 0, 4, 100, 97, 116, 97, 0, 0, 0, 7, 0])!
    check(found(data.load(id(String("minecraft:plain")), mut lines)), "data=7 ", "a plain file")
    check(shown(lines), "[{plain} was saved in data version 1343, older than 26.3's 5023, and is read as it is, without the upgrade vanilla gives it]", "an old file's warning")
    lines = List<Entry>()

    // Can't be read, or isn't a compound.
    write(join(data.folder, String("minecraft/broken.dat")), [31, 139, 1])!
    check(found(data.load(id(String("minecraft:broken")), mut lines)), "none", "a broken file")
    write(join(data.folder, String("minecraft/empty.dat")), [])!
    check(found(data.load(id(String("minecraft:empty")), mut lines)), "none", "an empty file")
    write(join(data.folder, String("minecraft/end.dat")), [0])!
    check(found(data.load(id(String("minecraft:end")), mut lines)), "none", "an end tag")
    check(shown(lines), "[Error loading saved data: SavedDataType[minecraft:broken]][Error loading saved data: SavedDataType[minecraft:empty]][Error loading saved data: SavedDataType[minecraft:end]]", "the lines")

    // An `..` that leaves the folder, and one that doesn't.
    lines = List<Entry>()
    let out = id(String("minecraft:../../level"))
    check(found(data.load(out, mut lines)), "none", "a path out")
    check(shown(lines), "[Error loading saved data: SavedDataType[minecraft:../../level]]", "a path out's line")
    match data.save(out, Tag.Int(1), mut lines) {
        ok => panic("a path out was saved"),
        err(e) => check(e, "java.lang.IllegalStateException: Identifier \"minecraft:../../level.dat\" tried to access path \"{join(universe, String("world/level.dat"))}\" from root \"{data.folder}\"", "a path out's exception"),
    }
    check(data.file(id(String("minecraft:../x")))!, join(universe, String("world/data/minecraft/../x.dat")), "a path in")

    // A codec's message.
    check(parse_failed(id(String("minecraft:raids")), String("No key raids in MapLike[\{\}]")).message, "Failed to parse saved data for 'SavedDataType[minecraft:raids]': No key raids in MapLike[\{\}]", "a codec's line")

    // A dimension's folder is made.
    lines = List<Entry>()
    let nether = SavedFiles.dimension(world, id(String("minecraft:the_nether")), mut lines)
    check("{is_dir(nether.folder)}", "true", "the dimension's folder")
    check(nether.folder, join(universe, String("world/dimensions/minecraft/the_nether/data")), "the dimension's folder's path")

    // Nowhere to save: a folder where the file goes, and a file where a folder does.
    make_dir_all(join(data.folder, String("minecraft/raids.dat")))!
    data.save(id(String("minecraft:raids")), Tag.Int(1), mut lines)!
    write(join(data.folder, String("blocked")), [1])!
    data.save(id(String("blocked:raids")), Tag.Int(1), mut lines)!
    check(shown(lines), "[Could not save data to raids.dat][Could not save data to raids.dat]", "saves with nowhere to go")

    world.close(mut lines)
    remove_dir_all(universe)!
    print("ok")
}
