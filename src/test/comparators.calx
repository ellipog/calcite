/// Checks comparators as vanilla runs them (CAL-123). What a comparator reads of a block,
/// `getAnalogOutputSignal`, on blocks held in a map: a chest's share of its slots full, of both
/// halves where it's double and none where it's blocked; a dispenser's, by each item's most to a
/// stack and a stack's own `max_stack_size`; a crafter's slots full or disabled; a shelf's slots
/// from in front alone; a cake's, a respawn anchor's and an empty cauldron's of their state; a
/// lectern's by its book's page; and a container's loot to come, which Calcite doesn't have yet. Then
/// comparators on a flat level whose chunks tick: reading a cake behind them, and behind a
/// block, 2 ticks after it's set; a side's signal turning one off where it compares and taken
/// from its output where it subtracts; and its output, held by its block entity, along wire.
module test.comparators

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.analog_output.{analog_output}
import world.chunk.{AIR_STATE, BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.pos.{BlockPos, ChunkPos}
import worldgen.access.{BlockAccess}
import worldgen.facts.{Facts, NORTH, SOUTH, WEST}
import worldgen.interval.{Thrown}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn block_facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn with(f: Facts, state: u32, prop: str, value: str) -> u32 {
    return match f.with_name(state, String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("no {prop} {value}"),
    }
}

// Blocks held in a map, air elsewhere, and their block entities as they save.
struct Blocks {
    air: u32
    states: Map<i64, u32>
    tags: Map<i64, Tag>
}

impl Blocks {
    fn put(mut self, x: i32, y: i32, z: i32, state: u32) {
        self.states.insert(BlockPos { x: x, y: y, z: z }.pack(), state)
    }

    // A block entity of type `kind` holding `fields`, as it saves.
    fn put_entity(mut self, x: i32, y: i32, z: i32, kind: str, fields: JavaHashMap<String, Tag>) {
        var tags = fields.copy()
        tags.insert("components", Tag.Compound(JavaHashMap<String, Tag>()))
        tags.insert("id", Tag.Str(String(kind)))
        tags.insert("x", Tag.Int(x))
        tags.insert("y", Tag.Int(y))
        tags.insert("z", Tag.Int(z))
        self.tags.insert(BlockPos { x: x, y: y, z: z }.pack(), Tag.Compound(tags))
    }
}

impl BlockAccess for Blocks {
    fn state(self, facts: Facts, x: i32, y: i32, z: i32) -> u32 ! Thrown {
        return self.states.get(BlockPos { x: x, y: y, z: z }.pack()) ?? self.air
    }

    fn schedule_block(mut self, block: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32) {}

    fn schedule_fluid(mut self, fluid: u32, x: i32, y: i32, z: i32) {}

    fn has_block_tick(self, block: u32, x: i32, y: i32, z: i32) -> bool {
        return false
    }

    fn block_entity(mut self, facts: Facts, x: i32, y: i32, z: i32) -> String? ! Thrown {
        return none
    }

    fn block_entity_tag(self, x: i32, y: i32, z: i32) -> Tag? {
        let k = BlockPos { x: x, y: y, z: z }.pack()
        if not self.tags.contains(k) {
            return none
        }
        return some(self.tags[k].copy())
    }

    fn raw_brightness(self, sky_light: bool, x: i32, y: i32, z: i32) -> i32 {
        return 15
    }
}

// A stack as a container saves it, at `slot`.
fn stack(id: str, count: i32, slot: i32) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert("Slot", Tag.Byte(i8.wrap(slot)))
    m.insert("id", Tag.Str(String(id)))
    m.insert("count", Tag.Int(count))
    return Tag.Compound(m)
}

// A container's fields holding `items`.
fn holding(items: own List<Tag>) -> JavaHashMap<String, Tag> {
    var m = JavaHashMap<String, Tag>()
    m.insert("Items", Tag.List(items))
    return m
}

// A lectern's fields holding a book `id` at `page`, with `pages` pages of `content` where it's
// named.
fn on_lectern(id: str, content: str, pages: i32, page: i32) -> JavaHashMap<String, Tag> {
    var book = JavaHashMap<String, Tag>()
    book.insert("id", Tag.Str(String(id)))
    book.insert("count", Tag.Int(1))
    if content != "" {
        var texts = List<Tag>()
        for i in 0..pages {
            texts.push(Tag.Str("page {i}"))
        }
        var fields = JavaHashMap<String, Tag>()
        fields.insert("pages", Tag.List(texts))
        var patch = JavaHashMap<String, Tag>()
        patch.insert(String(content), Tag.Compound(fields))
        book.insert("components", Tag.Compound(patch))
    }
    var m = JavaHashMap<String, Tag>()
    m.insert("Book", Tag.Compound(book))
    m.insert("Page", Tag.Int(page))
    return m
}

// `n` full stacks of stone from slot 0.
fn full_stacks(n: i32) -> List<Tag> {
    var items = List<Tag>()
    for i in 0..n {
        items.push(stack("minecraft:stone", 64, i))
    }
    return items
}

fn read(f: Facts, b: Blocks, x: i32, y: i32, z: i32, d: i32) -> i32 {
    let state = match b.state(f, x, y, z) {
        ok(s) => s,
        err(_) => panic("no state"),
    }
    return match analog_output(f, b, state, x, y, z, d) {
        ok(v) => v,
        err(t) => panic("what a comparator reads threw: {t.message}"),
    }
}

fn empty_blocks(f: Facts) -> Blocks {
    return Blocks { air: named(f, "air"), states: Map<i64, u32>(), tags: Map<i64, Tag>() }
}

// Chests: a share of 27 slots, a double chest's of 54, the right half's first; none blocked by a
// conductor above, either half.
fn chests() {
    let f = block_facts()
    var b = empty_blocks(f)
    b.put(0, 0, 0, named(f, "chest"))
    check(read(f, b, 0, 0, 0, WEST) == 0, "an empty chest, with no block entity yet, isn't 0")
    b.put_entity(0, 0, 0, "minecraft:chest", holding([stack("minecraft:diamond", 3, 0)]))
    check(read(f, b, 0, 0, 0, WEST) == 1, "3 diamonds in a chest aren't 1")
    b.put_entity(0, 0, 0, "minecraft:chest", holding(full_stacks(10)))
    check(read(f, b, 0, 0, 0, WEST) == 6, "10 full stacks in a chest aren't 6")
    b.put_entity(0, 0, 0, "minecraft:chest", holding(full_stacks(27)))
    check(read(f, b, 0, 0, 0, WEST) == 15, "a full chest isn't 15")
    // Facing north, the left half joins the chest to its east.
    let north = with(f, named(f, "chest"), "facing", "north")
    b.put(0, 0, 0, with(f, north, "type", "right"))
    b.put(-1, 0, 0, with(f, north, "type", "left"))
    check(read(f, b, 0, 0, 0, WEST) == 8, "a double chest with one half full isn't 8")
    check(read(f, b, -1, 0, 0, WEST) == 8, "the other half of a double chest isn't 8")
    b.put(-1, 1, 0, named(f, "stone"))
    check(read(f, b, 0, 0, 0, WEST) == 0, "a double chest whose other half's blocked isn't 0")
    b.put(-1, 0, 0, with(f, north, "type", "single"))
    check(read(f, b, 0, 0, 0, WEST) == 15, "a right half with no left half isn't read alone")
    b.put(0, 1, 0, named(f, "glass"))
    check(read(f, b, 0, 0, 0, WEST) == 15, "glass blocks a chest")
    b.put(0, 1, 0, named(f, "stone"))
    check(read(f, b, 0, 0, 0, WEST) == 0, "a chest under stone isn't 0")
    println("ok chests")
}

// A dispenser's share of 9 slots, each by the most of its item to a stack, or its own.
fn containers() {
    let f = block_facts()
    var b = empty_blocks(f)
    b.put(0, 0, 0, named(f, "dispenser"))
    b.put_entity(0, 0, 0, "minecraft:dispenser", holding([stack("minecraft:snowball", 9, 4)]))
    check(read(f, b, 0, 0, 0, WEST) == 1, "9 snowballs in a dispenser aren't 1")
    b.put_entity(0, 0, 0, "minecraft:dispenser", holding([stack("minecraft:snowball", 16, 0)]))
    check(read(f, b, 0, 0, 0, WEST) == 2, "16 snowballs in a dispenser aren't 2")
    var one = JavaHashMap<String, Tag>()
    one.insert("Slot", Tag.Byte(0))
    one.insert("id", Tag.Str(String("minecraft:diamond")))
    one.insert("count", Tag.Int(1))
    var components = JavaHashMap<String, Tag>()
    components.insert("minecraft:max_stack_size", Tag.Int(1))
    one.insert("components", Tag.Compound(components))
    b.put_entity(0, 0, 0, "minecraft:dispenser", holding([Tag.Compound(one)]))
    check(read(f, b, 0, 0, 0, WEST) == 2, "a diamond stacking to 1 in a dispenser isn't 2")
    // A crafter: its slots that hold something or are disabled.
    b.put(2, 0, 0, named(f, "crafter"))
    var crafter = holding([stack("minecraft:stone", 1, 0), stack("minecraft:stone", 1, 1)])
    crafter.insert("disabled_slots", Tag.IntArray([0, 4, 8]))
    b.put_entity(2, 0, 0, "minecraft:crafter", crafter)
    check(read(f, b, 2, 0, 0, WEST) == 4, "a crafter with 2 stacks and 3 disabled slots, one of them full, isn't 4")
    // A shelf facing south, read from in front alone.
    b.put(4, 0, 0, with(f, named(f, "oak_shelf"), "facing", "south"))
    b.put_entity(4, 0, 0, "minecraft:shelf", holding([stack("minecraft:apple", 2, 1)]))
    check(read(f, b, 4, 0, 0, NORTH) == 2, "a shelf with its middle slot full isn't 2 from in front")
    check(read(f, b, 4, 0, 0, SOUTH) == 0, "a shelf isn't 0 from behind")
    // Loot still to come.
    b.put(6, 0, 0, named(f, "barrel"))
    var loot = JavaHashMap<String, Tag>()
    loot.insert("LootTable", Tag.Str(String("minecraft:chests/simple_dungeon")))
    b.put_entity(6, 0, 0, "minecraft:barrel", loot)
    let state = named(f, "barrel")
    check(match analog_output(f, b, state, 6, 0, 0, WEST) { ok(_) => false, err(t) => t.exception == "Unimplemented" }, "a barrel's loot to come didn't throw")
    println("ok containers")
}

// What comes of the state alone, or isn't read.
fn states() {
    let f = block_facts()
    var b = empty_blocks(f)
    b.put(0, 0, 0, with(f, named(f, "cake"), "bites", "6"))
    check(read(f, b, 0, 0, 0, WEST) == 2, "a cake with 6 bites isn't 2")
    b.put(0, 0, 0, with(f, named(f, "respawn_anchor"), "charges", "3"))
    check(read(f, b, 0, 0, 0, WEST) == 11, "a respawn anchor of 3 charges isn't 11")
    b.put(0, 0, 0, named(f, "cauldron"))
    check(f.has_analog_output(f.block(named(f, "cauldron"))) and read(f, b, 0, 0, 0, WEST) == 0, "an empty cauldron isn't read as 0")
    check(not f.has_analog_output(f.block(named(f, "stone"))), "stone is read")
    // A lectern's book: how far through it its page is, of 14, and one for the book.
    b.put(0, 0, 0, named(f, "lectern"))
    check(read(f, b, 0, 0, 0, WEST) == 0, "a lectern without a book isn't 0")
    b.put(0, 0, 0, with(f, named(f, "lectern"), "has_book", "true"))
    b.put_entity(0, 0, 0, "minecraft:lectern", on_lectern("minecraft:written_book", "minecraft:written_book_content", 5, 2))
    check(read(f, b, 0, 0, 0, WEST) == 8, "a written book at the third of 5 pages isn't 8")
    b.put_entity(0, 0, 0, "minecraft:lectern", on_lectern("minecraft:writable_book", "minecraft:writable_book_content", 4, 1))
    check(read(f, b, 0, 0, 0, WEST) == 5, "a book and quill at the second of 4 pages isn't 5")
    b.put_entity(0, 0, 0, "minecraft:lectern", on_lectern("minecraft:written_book", "minecraft:written_book_content", 3, 9))
    check(read(f, b, 0, 0, 0, WEST) == 15, "a page past a book's last isn't kept to it")
    b.put_entity(0, 0, 0, "minecraft:lectern", on_lectern("minecraft:writable_book", "", 0, 0))
    check(read(f, b, 0, 0, 0, WEST) == 15, "a new book and quill isn't 15")
    b.put_entity(0, 0, 0, "minecraft:lectern", on_lectern("minecraft:written_book", "", 0, 0))
    check(read(f, b, 0, 0, 0, WEST) == 14, "a written book without content isn't 14")
    check(f.max_stack_size(String("minecraft:snowball")) == 16 and f.max_stack_size(String("minecraft:stone")) == 64, "the most to a stack isn't the item's")
    println("ok states")
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

// A flat level, its spawn's chunks full and given the facts, with a player at its middle, so
// its chunks tick.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

// Runs `ticks` ticks of the level's blocks, as `ServerLevel.tick` runs them.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.game_time += 1
        level.run_block_ticks()
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn powered(f: Facts, level: Level, x: i32, y: i32, z: i32) -> bool {
    return f.get_bool(level.spawn_state(x, y, z), String("powered"))
}

fn power(f: Facts, level: Level, x: i32, y: i32, z: i32) -> i32 {
    return f.get_int(level.spawn_state(x, y, z), String("power")) ?? -1
}

// What the level reported isn't in Calcite yet, one line each.
fn quiet(level: mut Level, what: str) {
    var out = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") {
            out = "{out}{e.message}; "
        }
    }
    if not out.is_empty() {
        panic("{what} reported {out}")
    }
}

// A comparator facing west reads a cake set behind it 2 ticks on, its output along wire in
// front; as the cake's eaten, it reads less. Behind stone, it reads the cake past it.
fn reading() {
    let f = block_facts()
    var level = flat_level(f)
    let comparator = with(f, named(f, "comparator"), "facing", "west")
    set(mut level, 2, -60, 2, comparator, "the comparator wasn't set")
    set(mut level, 3, -60, 2, named(f, "redstone_wire"), "the wire wasn't set")
    set(mut level, 4, -60, 2, named(f, "redstone_wire"), "the wire wasn't set")
    set(mut level, 1, -60, 2, with(f, named(f, "cake"), "bites", "2"), "the cake wasn't set")
    run(mut level, 1)
    check(not powered(f, level, 2, -60, 2), "the comparator's powered before its tick")
    run(mut level, 1)
    check(powered(f, level, 2, -60, 2), "the comparator reading a cake isn't powered 2 ticks on")
    check(power(f, level, 3, -60, 2) == 10 and power(f, level, 4, -60, 2) == 9, "the wire in front of the comparator isn't 10 and 9")
    set(mut level, 1, -60, 2, with(f, named(f, "cake"), "bites", "6"), "the cake wasn't eaten")
    run(mut level, 2)
    check(powered(f, level, 2, -60, 2) and power(f, level, 3, -60, 2) == 2, "the comparator doesn't read the eaten cake as 2")
    set(mut level, 1, -60, 2, AIR_STATE, "the cake wasn't taken away")
    run(mut level, 2)
    check(not powered(f, level, 2, -60, 2) and power(f, level, 3, -60, 2) == 0, "the comparator's still on with the cake gone")
    // Through stone, to a cake past it, told as the cake's set beyond the stone.
    set(mut level, 1, -60, 2, named(f, "stone"), "the stone wasn't set")
    set(mut level, 0, -60, 2, named(f, "cake"), "the cake past the stone wasn't set")
    run(mut level, 2)
    check(powered(f, level, 2, -60, 2) and power(f, level, 3, -60, 2) == 14, "the comparator doesn't read the cake past the stone as 14")
    quiet(mut level, "reading")
    println("ok reading")
}

// A comparator with a redstone block behind it, 15 in, and wire at its side, 13: comparing, 15
// out; subtracting, 2; with the side 15, subtracting off, and comparing on at 15 once a side's
// change tells it.
fn modes() {
    let f = block_facts()
    var level = flat_level(f)
    let comparator = with(f, named(f, "comparator"), "facing", "west")
    set(mut level, 2, -60, 6, comparator, "the comparator wasn't set")
    set(mut level, 3, -60, 6, named(f, "redstone_wire"), "the wire in front wasn't set")
    set(mut level, 1, -60, 6, named(f, "redstone_block"), "the redstone block behind wasn't set")
    run(mut level, 2)
    check(powered(f, level, 2, -60, 6) and power(f, level, 3, -60, 6) == 15, "the comparator with 15 in isn't 15 out")
    for z in 3..6 {
        set(mut level, 2, -60, z, named(f, "redstone_wire"), "the side's wire wasn't set")
    }
    set(mut level, 2, -60, 2, named(f, "redstone_block"), "the side's redstone block wasn't set")
    check(power(f, level, 2, -60, 5) == 13, "the side's wire isn't 13")
    run(mut level, 2)
    check(powered(f, level, 2, -60, 6) and power(f, level, 3, -60, 6) == 15, "comparing, a side of 13 under 15 changed it")
    set(mut level, 2, -60, 6, with(f, comparator, "mode", "subtract"), "the comparator wasn't set to subtract")
    run(mut level, 2)
    check(powered(f, level, 2, -60, 6) and power(f, level, 3, -60, 6) == 2, "subtracting 13 from 15 isn't 2")
    set(mut level, 2, -60, 5, named(f, "redstone_block"), "the side's wire wasn't made a redstone block")
    run(mut level, 2)
    check(not powered(f, level, 2, -60, 6) and power(f, level, 3, -60, 6) == 0, "subtracting 15 from 15 is still on")
    // Set to compare, as a command sets it, it isn't told; a side changed and back tells it.
    set(mut level, 2, -60, 6, comparator, "the comparator wasn't set to compare")
    run(mut level, 2)
    check(not powered(f, level, 2, -60, 6), "the comparator set to compare ticked untold")
    set(mut level, 2, -60, 5, named(f, "stone"), "the side's redstone block wasn't made stone")
    set(mut level, 2, -60, 5, named(f, "redstone_block"), "the side's stone wasn't made a redstone block")
    run(mut level, 2)
    check(powered(f, level, 2, -60, 6) and power(f, level, 3, -60, 6) == 15, "comparing 15 with 15 at the side isn't on at 15")
    quiet(mut level, "modes")
    println("ok modes")
}

fn main() {
    chests()
    containers()
    states()
    reading()
    modes()
    println("ok")
}
