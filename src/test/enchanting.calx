/// Checks enchanting (D522) against what vanilla's own `EnchantmentHelper` gives on the same
/// seeds, as a one-off probe of vanilla's code printed it: `selectEnchantment` for ten items, a
/// book among them and a stick, which nothing goes on, with all the enchantments and three of
/// their tags, at five costs and three seeds; `enchantItem` with `#on_traded_equipment` at two
/// costs and two seeds, as `enchant_with_levels` enchants; and `enchantItemFromProvider` with
/// `mob_spawn_equipment` on normal and hard at three local difficulties and two seeds. Each line
/// ends with the random's next int, to show as many draws were made. All 760 lines are checked by
/// their count and hash, and a few spelled out, so a difference shows where to look; where they
/// differ, every line's printed. Then `upgrade`, which keeps the higher level and no more than 255.
/// Then the location-changed effects of frost walker and soul speed (D524): frost walker's disk of
/// frosted ice, at each level its radius across, and soul speed's speed, movement efficiency and
/// wear. Then float providers' samples (D525), each kind's draws and clamps, as soul speed's sound
/// draws its pitch. The items and enchantments are read from the vanilla data pack in the server
/// jar at oracle/jars/, so it's run from the repository's root.
module test.enchanting

import java.text.{string_hash}
import nbt.snbt.{parse}
import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import rig.registries.{load_vanilla}
import world.difficulty.{LocalDifficulty}
import world.enchanting.{upgrade}
import world.chunk.{BlockStates}
import world.loot.{Located, Loot, disk_blocks, enchant_item, float_sample, location_entries, spawn_enchanted}
import world.modes.{Difficulty}
import worldgen.facts.{Facts}

// How many lines vanilla's probe printed, and the Java `hashCode` of them joined by newlines.
const LINES: usize = 760
const HASH: i32 = -1727612007

// A few of vanilla's lines, spelled out.
fn spelled() -> List<str> {
    return [
        "select diamond_sword on_random_loot 30 22: minecraft:knockback=2 next=-1724358601",
        "select book all 45 333: minecraft:smite=5 minecraft:efficiency=5 next=1416667966",
        "enchant iron_chestplate 30 4: minecraft:iron_chestplate minecraft:protection=4 minecraft:unbreaking=3 next=336672924",
        "enchant book 30 55: minecraft:enchanted_book stored:minecraft:bane_of_arthropods=4 stored:minecraft:quick_charge=2 next=-1582493058",
        "spawn trident hard 3600000 3600000 7: minecraft:trident minecraft:impaling=3 minecraft:loyalty=2 minecraft:unbreaking=2 next=-203339871",
        "spawn stick hard 1500000 600000 88: minecraft:stick next=-441328586",
    ]
}

fn stack(item: str) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str("minecraft:{item}"))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

// A stack of `item` with `enchantment` at `level` (D524).
fn enchanted(item: str, enchantment: str, level: i32) -> Tag {
    var levels = JavaHashMap<String, Tag>()
    levels.insert("minecraft:{enchantment}", Tag.Int(level))
    var components = JavaHashMap<String, Tag>()
    components.insert(String("minecraft:enchantments"), Tag.Compound(levels))
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str("minecraft:{item}"))
    m.insert(String("count"), Tag.Int(1))
    m.insert(String("components"), Tag.Compound(components))
    return Tag.Compound(m)
}

// Frost walker's and soul speed's location-changed effects as the registry has them (D524): none
// in the main hand; on the feet, frost walker's disk of frosted ice a block down, its radius
// clamped from 3 and one more a level, so 25 blocks round the block at level I and 45 at level
// II, the first a corner nearest the north-west in `betweenClosed`'s order; and soul speed's
// speed at its level and movement efficiency for the feet, then its wear.
fn located(f: Facts, loot: Loot) {
    if not location_entries(loot, enchanted("diamond_boots", "frost_walker", 2), 0).is_empty() {
        panic("frost walker's effects in the main hand")
    }
    let frosted = f.block_named(String("minecraft:frosted_ice")) ?? panic("no frosted ice")
    let ice = f.default_state(frosted)
    let cases: List<(i32, usize, i32, i32)> = [(1, 25, -2, -2), (2, 45, -2, -3)]
    for (lv, want, first_x, first_z) in cases {
        let entries = location_entries(loot, enchanted("diamond_boots", "frost_walker", lv), 2)
        if entries.len() != 1 or entries[0].what.len() != 1 or entries[0].lv != lv or entries[0].requirements == none {
            panic("frost walker {lv}: {entries.len()} effects")
        }
        let Located.Disk(effect) = entries[0].what[0].copy() else panic("frost walker {lv}: not a disk")
        var missing = List<String>()
        let blocks = disk_blocks(f, effect, lv, 0.5, -60.0, 0.5, mut missing)
        for m in missing {
            panic("frost walker {lv}: missing {m}")
        }
        if blocks.len() != want {
            panic("frost walker {lv}: {blocks.len()} blocks, want {want}")
        }
        let (bx, by, bz, state) = blocks[0]
        if bx != first_x or by != -61 or bz != first_z or state != ice {
            panic("frost walker {lv}: first {bx} {by} {bz} state {state}")
        }
    }
    let soul = location_entries(loot, enchanted("diamond_boots", "soul_speed", 3), 2)
    if soul.len() != 2 or soul[0].what.len() != 2 or soul[1].what.len() != 1 {
        panic("soul speed: {soul.len()} effects")
    }
    let speed = f64(0.0405f32 + 0.0105f32 * 2.0f32)
    let Located.Attribute(speed_id, speed_name, speed_amount, speed_operation) = soul[0].what[0].copy() else panic("soul speed: no speed")
    if speed_id != "minecraft:enchantment.soul_speed/feet" or speed_name != "minecraft:movement_speed" or speed_amount != speed or speed_operation != "add_value" {
        panic("soul speed's speed: {speed_id} {speed_name} {speed_amount} {speed_operation}")
    }
    let Located.Attribute(efficiency_id, efficiency_name, efficiency_amount, _) = soul[0].what[1].copy() else panic("soul speed: no efficiency")
    if efficiency_id != "minecraft:enchantment.soul_speed/feet" or efficiency_name != "minecraft:movement_efficiency" or efficiency_amount != 1.0 {
        panic("soul speed's efficiency: {efficiency_id} {efficiency_name} {efficiency_amount}")
    }
    let Located.ItemDamage(wear) = soul[1].what[0].copy() else panic("soul speed: no wear")
    if wear != 1 {
        panic("soul speed's wear: {wear}")
    }
}

// `FloatProvider.sample` of each kind (D525), against the draws it should make of a random seeded
// the same: a number and `constant` none; `uniform` a float across its range; `clamped_normal` a
// gaussian about its mean, clamped; and `trapezoid` two floats, the plateau's end then its start.
fn floats() {
    let cases: List<(str, i32)> = [
        ("0.6f", 0),
        ("\{type:\"minecraft:constant\",value:2.5f\}", 1),
        ("\{type:\"minecraft:uniform\",min_inclusive:0.6f,max_exclusive:1.0f\}", 2),
        ("\{type:\"minecraft:clamped_normal\",mean:0.0f,deviation:10.0f,min:-1.0f,max:1.0f\}", 3),
        ("\{type:\"minecraft:trapezoid\",min:1.0f,max:5.0f,plateau:2.0f\}", 4),
    ]
    for (text, kind) in cases {
        for seed in [1i64, 22i64, 333i64] {
            var r = LegacyRandom.new(seed)
            let got = float_sample(mut r, parse(String(text))!)
            var w = LegacyRandom.new(seed)
            var want = 0.6f32
            if kind == 1 {
                want = 2.5f32
            } else if kind == 2 {
                want = w.next_float() * (1.0f32 - 0.6f32) + 0.6f32
            } else if kind == 3 {
                want = 0.0f32 + f32.nearest(w.next_gaussian()) * 10.0f32
                if want < -1.0f32 {
                    want = -1.0f32
                } else if want > 1.0f32 {
                    want = 1.0f32
                }
            } else if kind == 4 {
                let first = w.next_float() * 3.0f32
                want = 1.0f32 + first + w.next_float() * 1.0f32
            }
            if got != want or r.next_int() != w.next_int() {
                panic("{text} on {seed}: {got}, want {want}")
            }
        }
    }
}

// The stack's item and its enchantments and stored enchantments, by name, sorted, as the probe
// writes them.
fn describe(t: Tag?) -> String {
    let given = t else return String("minecraft:air")
    let Tag.Compound(m) = given else return String("?")
    var out = match m["id"] {
        Tag.Str(s) => s.copy(),
        _ => String("?"),
    }
    var names = List<String>()
    if m.contains("components") {
        if let Tag.Compound(c) = m["components"] {
            for (key, prefix) in [("minecraft:enchantments", ""), ("minecraft:stored_enchantments", "stored:")] {
                if c.contains(key) {
                    if let Tag.Compound(levels) = c[key] {
                        for (name, level) in levels {
                            names.push("{prefix}{name}={level.number_int() ?? 0}")
                        }
                    }
                }
            }
        }
    }
    names.sort()
    for n in names {
        out = "{out} {n}"
    }
    return out
}

fn main() {
    let loaded = load_vanilla()!
    let loot = Loot.new(Shared(loaded.registries.copy()))
    let items: List<str> = ["diamond_sword", "iron_chestplate", "bow", "book", "iron_shovel", "fishing_rod", "leather_boots", "golden_helmet", "trident", "stick"]
    let sources: List<str> = ["", "on_mob_spawn_equipment", "on_random_loot", "on_traded_equipment"]
    var got = List<String>()
    for item in items {
        for source in sources {
            let ids = if source == "" { loot.enchanting.all() } else { loot.enchanting.set_ids(Tag.Str("#minecraft:{source}")) }
            for cost in [1, 8, 20, 30, 45] {
                for seed in [1i64, 22i64, 333i64] {
                    var r = LegacyRandom.new(seed)
                    var value: i32? = none
                    if let Tag.Compound(e) = loot.items.default_component("minecraft:{item}", String("minecraft:enchantable")) ?? Tag.End {
                        if e.contains("value") {
                            value = e["value"].number_int()
                        }
                    }
                    let picked = loot.enchanting.select(mut r, "minecraft:{item}", value, cost, ids.copy())
                    var line = "select {item} {if source == "" { "all" } else { source }} {cost} {seed}:"
                    for (id, level) in picked {
                        line = "{line} {loot.enchanting.name(id)}={level}"
                    }
                    got.push("{line} next={r.next_int()}")
                }
            }
        }
    }
    let traded = loot.enchanting.set_ids(Tag.Str(String("#minecraft:on_traded_equipment")))
    for item in items {
        for cost in [5, 30] {
            for seed in [4i64, 55i64] {
                var r = LegacyRandom.new(seed)
                let made = enchant_item(loot, mut r, stack(item), cost, traded.copy())
                got.push("enchant {item} {cost} {seed}: {describe(made)} next={r.next_int()}")
            }
        }
    }
    let times: List<(i64, i64)> = [(0i64, 0i64), (3600000i64, 3600000i64), (1500000i64, 600000i64)]
    for item in items {
        for (base, named) in [(Difficulty.Normal, "normal"), (Difficulty.Hard, "hard")] {
            for (total, local) in times {
                for seed in [7i64, 88i64] {
                    let special = LocalDifficulty.new(base, total, local, 1.0f32).special()
                    var r = LegacyRandom.new(seed)
                    let made = spawn_enchanted(loot, mut r, stack(item), special)
                    got.push("spawn {item} {named} {total} {local} {seed}: {describe(some(made))} next={r.next_int()}")
                }
            }
        }
    }
    var joined = String()
    for i in 0..got.len() {
        if i > 0 {
            joined = "{joined}\n"
        }
        joined = "{joined}{got[i]}"
    }
    let hash = string_hash(joined)
    var differs = got.len() != LINES or hash != HASH
    for want in spelled() {
        if not got.contains(String(want)) {
            println("missing: {want}")
            differs = true
        }
    }
    if differs {
        for line in got {
            println(line)
        }
        panic("{got.len()} lines, hash {hash}; vanilla's {LINES}, hash {HASH}")
    }

    var levels = JavaHashMap<String, Tag>()
    upgrade(mut levels, String("minecraft:sharpness"), 3)
    upgrade(mut levels, String("minecraft:sharpness"), 2)
    upgrade(mut levels, String("minecraft:looting"), 300)
    upgrade(mut levels, String("minecraft:mending"), 0)
    if levels["minecraft:sharpness"].number_int() != some(3) or levels["minecraft:looting"].number_int() != some(255) or levels.contains("minecraft:mending") {
        panic("upgrade: {Tag.Compound(levels).to_snbt()}")
    }

    let r = loaded.registries.copy()
    let blocks = r.find_builtin(String("block")) ?? panic("no blocks")
    let fluids = r.find_builtin(String("fluid")) ?? panic("no fluids")
    let f = match Facts.new(r.builtin[blocks].copy(), r.builtin[fluids].copy(), BlockStates.new([1], [1], 1)) {
        ok(made) => made,
        err(e) => panic("the block facts: {e}"),
    }
    located(f, loot)
    floats()
    println("ok")
}
