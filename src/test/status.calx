/// Checks the status response's JSON, the components in it, Base64 and the server icon's check.
/// Each expected JSON is what vanilla 26.3's `ServerStatus.CODEC` and
/// `ComponentSerialization.CODEC` give for the same value, written by its Gson.
module test.status

import chat.component.{Component, Contents, Translation}
import java.base64.{encode}
import java.uuid.{Uuid}
import server.status.{ServerStatus, PlayerSample, check_icon}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn bytes(s: String) -> List<u8> {
    var out = List<u8>()
    for i in 0..s.len() {
        out.push(s.byte_at(i))
    }
    return out
}

fn with_extra(c: own Component, extra: own List<Component>) -> Component {
    var out = c
    out.extra = extra
    return out
}

// A PNG's signature and IHDR chunk, of `width` by `height`.
fn png(width: i32, height: i32, depth: u8, color: u8) -> List<u8> {
    var out: List<u8> = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0, 0, 0, 13, 0x49, 0x48, 0x44, 0x52]
    for v in [width, height] {
        out.push(u8.wrap(v >> 24))
        out.push(u8.wrap(v >> 16))
        out.push(u8.wrap(v >> 8))
        out.push(u8.wrap(v))
    }
    out.push(depth)
    out.push(color)
    for _ in 0..7 {
        out.push(0)
    }
    return out
}

fn icon_error(file: List<u8>) -> String {
    return match check_icon(file) {
        ok(_) => String("ok"),
        err(e) => e,
    }
}

fn main() {
    // Base64: RFC 4648's vectors, and bytes that use `+` and `/`.
    var b64 = List<String>()
    for s in ["", "f", "fo", "foo", "foob", "fooba", "foobar"] {
        b64.push(encode(bytes(String(s))))
    }
    check("{b64}", "[, Zg==, Zm8=, Zm9v, Zm9vYg==, Zm9vYmE=, Zm9vYmFy]")
    check(encode([0xFB, 0xFF, 0xFE]), "+//+")

    // The status: the default, then every field, then a translated description.
    var status = ServerStatus {
        description: Component.literal("A Minecraft Server"),
        max_players: 20,
        online: 0,
        sample: [],
        version_name: "26.3",
        protocol: 777,
        favicon: none,
        enforces_secure_chat: false,
    }
    check(status.to_json(), #"{"description":"A Minecraft Server","players":{"max":20,"online":0},"version":{"name":"26.3","protocol":777}}"#)
    status.description = Component.empty()
    status.max_players = 10
    status.online = 2
    let low: u64 = 0xfedcba9876543210
    status.sample = [
        PlayerSample { id: Uuid.new(0x0123456789abcdef, i64.wrap(low)), name: "Alex" },
        PlayerSample { id: Uuid.new(0, 2), name: "Steve" },
    ]
    status.favicon = some([0x89, 0x50, 0x4E, 0x47, 0x00, 0xFF, 0xFE])
    status.enforces_secure_chat = true
    check(status.to_json(), #"{"players":{"max":10,"online":2,"sample":[{"id":"01234567-89ab-cdef-fedc-ba9876543210","name":"Alex"},{"id":"00000000-0000-0000-0000-000000000002","name":"Steve"}]},"version":{"name":"26.3","protocol":777},"favicon":"data:image/png;base64,iVBORwD//g==","enforcesSecureChat":true}"#)
    status.description = Component.translatable("menu.title", [Component.literal("x")])
    status.max_players = 0
    status.online = -1
    status.sample = []
    status.version_name = ""
    status.protocol = -5
    status.favicon = none
    status.enforces_secure_chat = false
    check(status.to_json(), #"{"description":{"translate":"menu.title","with":["x"]},"players":{"max":0,"online":-1},"version":{"name":"","protocol":-5}}"#)

    // Gson's escapes, with HTML escaping off: DEL and everything above it but U+2028 and U+2029
    // are written as themselves.
    let del = "\u{7F}"
    check(Component.literal("q\"b\\t\tb\u{8}n\nr\rf\u{C}c\u{1}\u{1F}\u{7F}l\u{2028}p\u{2029}h<>&='é😀").to_json(), #""q\"b\\t\tb\bn\nr\rf\fc\u0001\u001f#{del}l\u2028p\u2029h<>&='é😀""#)

    // Components: siblings, arguments and fallbacks.
    let siblings = with_extra(Component.literal("a"), [Component.literal("b"), with_extra(Component.literal("c"), [Component.literal("d")])])
    check(siblings.to_json(), #"{"text":"a","extra":["b",{"text":"c","extra":["d"]}]}"#)
    check(with_extra(Component.empty(), [Component.literal("x")]).to_json(), #"{"text":"","extra":["x"]}"#)
    check(Component.translatable("multiplayer.disconnect.incompatible", [Component.literal("26.3")]).to_json(), #"{"translate":"multiplayer.disconnect.incompatible","with":["26.3"]}"#)
    let ab = with_extra(Component.literal("a"), [Component.literal("b")])
    check(Component.translatable("k", [ab, Component.translatable("j", [])]).to_json(), #"{"translate":"k","with":[{"text":"a","extra":["b"]},{"translate":"j"}]}"#)
    let fallback = Component { contents: Contents.Translatable(Translation { key: "k", fallback: some("Fallback"), args: [Component.literal("x")] }), extra: [] }
    check(fallback.to_json(), #"{"translate":"k","fallback":"Fallback","with":["x"]}"#)
    let fallback_alone = Component { contents: Contents.Translatable(Translation { key: "k", fallback: some("F"), args: [] }), extra: [] }
    check(fallback_alone.to_json(), #"{"translate":"k","fallback":"F"}"#)
    check(with_extra(Component.translatable("k", []), [Component.literal("s")]).to_json(), #"{"translate":"k","extra":["s"]}"#)
    check(Component.translatable("multiplayer.disconnect.transfers_disabled", []).to_json(), #"{"translate":"multiplayer.disconnect.transfers_disabled"}"#)

    // The server icon: a 64 by 64 PNG, or vanilla's reason why not.
    check(icon_error(png(64, 64, 8, 6)), "ok")
    check(icon_error(png(64, 32, 8, 6)), "Couldn't load server icon: Invalid world icon size [64, 32], but expected [64, 64]")
    check(icon_error(png(64, 64, 3, 6)), "Couldn't load server icon: Invalid bit depth: 3")
    check(icon_error(png(64, 64, 8, 5)), "Couldn't load server icon: Invalid color type: 5")
    check(icon_error(png(65536, 65536, 16, 6)), "Couldn't load server icon: Bounds check failed, 65536x65536@16, type: 6")
    var bad = png(64, 64, 8, 6)
    bad[1] = 0x70
    check(icon_error(bad), "Couldn't load server icon: Bad PNG Signature: 89704E470D0A1A0A")
    bad = png(64, 64, 8, 6)
    bad[11] = 14
    check(icon_error(bad), "Couldn't load server icon: Bad length for IHDR chunk: 14")
    bad = png(64, 64, 8, 6)
    bad[12] = 0x69
    check(icon_error(bad), "Couldn't load server icon: Bad type for IHDR chunk: 69484452")
    check(icon_error([0x89, 0x50]), "Couldn't load server icon: EOFException")
    println("ok")
}
