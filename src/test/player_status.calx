/// Checks `world.entity_data` and `world.player_status` against what vanilla's `SynchedEntityData`,
/// `FoodData` and `ServerPlayer` do (CAL-141): a player's values defined with their defaults, set
/// only where they change, and packed as `ClientboundSetEntityDataPacket` writes them; their
/// shared flags; their status read from a save, or a new player's, and written back; peaceful's
/// healing and feeding; food spent and healed from; and the boxes and eyes of `world.collision`'s
/// poses.
module test.player_status

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import world.collision.{eye_height, pose_box}
import world.entity_data.{ABSORPTION, AIR_SUPPLY, CROUCHING, CROUCHING_FLAG, EntityData, HEALTH, MODE_CUSTOMISATION, POSE_ID, SHARED_FLAGS, SPRINTING_FLAG, STANDING, SWIMMING, Value, player_data}
import world.player_status.{Status, read_status, tick_food, tick_regeneration, write_status}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// The bytes, as hex, of what's packed of `data`, or "none".
fn packed(data: mut EntityData) -> String {
    let bytes = data.pack_dirty() else return String("none")
    var out = String()
    let digits = "0123456789abcdef"
    for b in bytes {
        let hi = usize(u32(b) >> 4)
        let lo = usize(u32(b) & 15)
        out.push_str(digits[hi..hi + 1])
        out.push_str(digits[lo..lo + 1])
    }
    return out
}

fn saved(text: str) -> JavaHashMap<String, Tag> {
    return match parse(String(text))! {
        Tag.Compound(m) => m,
        _ => JavaHashMap<String, Tag>(),
    }
}

fn entity_data() {
    var d = player_data()
    check("{d.number(AIR_SUPPLY)} {d.float(HEALTH)} {d.number(POSE_ID)} {d.is_dirty()}", "300 1.0 0 false", "defaults")
    check(packed(mut d), "none", "nothing changed")
    // A value set to what it is isn't changed.
    d.set(AIR_SUPPLY, Value.Number(300))
    check("{d.is_dirty()}", "false", "set the same")
    // The join's: health 20, then every skin part shown, packed in ID order.
    d.set(MODE_CUSTOMISATION, Value.Byte(127i8))
    d.set(HEALTH, Value.Float(20.0f32))
    check(packed(mut d), "090341a0000010007fff", "health and skin parts")
    check(packed(mut d), "none", "sent once")
    // 0.0 and -0.0 differ, as their bits do.
    d.set(ABSORPTION, Value.Float(-0.0f32))
    check(packed(mut d), "110380000000ff", "negative zero")
    // The shared flags, set and cleared bit by bit; set and cleared again before they're sent,
    // they're sent as they are.
    d.set_flag(SHARED_FLAGS, CROUCHING_FLAG, true)
    d.set_flag(SHARED_FLAGS, SPRINTING_FLAG, true)
    check("{d.byte(SHARED_FLAGS)}", "10", "two flags")
    d.set_flag(SHARED_FLAGS, SPRINTING_FLAG, false)
    check(packed(mut d), "000002ff", "crouching")
    d.set_flag(SHARED_FLAGS, CROUCHING_FLAG, false)
    d.set_flag(SHARED_FLAGS, CROUCHING_FLAG, true)
    check(packed(mut d), "000002ff", "let go and held again")
    d.set(POSE_ID, Value.Number(CROUCHING))
    check(packed(mut d), "061405ff", "the pose")
}

fn status() {
    // A player new to the world is at their most health.
    var d = player_data()
    let fresh = read_status(none, mut d, 20.0f32, 0.0f32)
    check("{d.float(HEALTH)} {fresh.food} {fresh.saturation}", "20.0 20 5.0", "new")
    // A saved one's, kept within their most; a number of another kind read as the kind wanted.
    var e = player_data()
    let s = read_status(some(saved("\{Health:30.0f,AbsorptionAmount:4.0f,Air:200s,XpLevel:3,XpP:0.5f,XpTotal:20,XpSeed:7,Score:9,foodLevel:15b,foodTickTimer:4,foodSaturationLevel:2.5d,foodExhaustionLevel:1.0f\}")), mut e, 20.0f32, 0.0f32)
    check("{e.float(HEALTH)} {e.float(ABSORPTION)} {e.number(AIR_SUPPLY)}", "20.0 0.0 200", "saved health")
    check("{s.xp_level} {s.xp_progress} {s.xp_total} {s.xp_seed} {s.food} {s.food_timer} {s.saturation} {s.exhaustion}", "3 0.5 20 7 15 4 2.5 1.0", "saved status")
    var out = JavaHashMap<String, Tag>()
    write_status(s, e, mut out)
    check("{out["Air"]} {out["Health"]} {out["foodLevel"]} {out["foodSaturationLevel"]} {out.contains("TicksFrozen")}", "{Tag.Short(200i16)} {Tag.Float(20.0f32)} {Tag.Int(15)} {Tag.Float(2.5f32)} false", "written")
}

fn regeneration() {
    var d = player_data()
    var s = Status()
    s.food = 10
    s.saturation = 19.5f32
    d.set(HEALTH, Value.Float(19.5f32))
    // Not peaceful, or without natural regeneration, nothing.
    tick_regeneration(mut s, mut d, 20, false, true, 20.0f32)
    tick_regeneration(mut s, mut d, 20, true, false, 20.0f32)
    check("{d.float(HEALTH)} {s.food} {s.saturation}", "19.5 10 19.5", "not peaceful")
    // Every 20 ticks a heart's half, to their most, and saturation; every 10, food.
    tick_regeneration(mut s, mut d, 20, true, true, 20.0f32)
    check("{d.float(HEALTH)} {s.food} {s.saturation}", "20.0 11 20.5", "the 20th tick")
    tick_regeneration(mut s, mut d, 30, true, true, 20.0f32)
    check("{d.float(HEALTH)} {s.food} {s.saturation}", "20.0 12 20.5", "the 30th")
    tick_regeneration(mut s, mut d, 31, true, true, 20.0f32)
    check("{s.food}", "12", "between")
}

fn food() {
    // Past 4 exhaustion, saturation's spent, then food, but not in peaceful.
    var d = player_data()
    d.set(HEALTH, Value.Float(20.0f32))
    var s = Status()
    s.saturation = 0.5f32
    s.exhaust(4.5f32)
    _ = tick_food(mut s, mut d, 2, true, 20.0f32)
    check("{s.exhaustion} {s.saturation} {s.food}", "0.5 0.0 20", "saturation spent")
    s.exhaust(4.0f32)
    _ = tick_food(mut s, mut d, 0, true, 20.0f32)
    check("{s.food}", "20", "peaceful keeps food")
    s.exhaust(4.0f32)
    _ = tick_food(mut s, mut d, 2, true, 20.0f32)
    check("{s.food} {s.food_timer}", "19 0", "food spent")
    // Exhaustion's at most 40.
    s.exhaust(100.0f32)
    check("{s.exhaustion}", "40.0", "most exhaustion")
    // Hurt and full, healed from saturation every 10 ticks.
    var h = player_data()
    h.set(HEALTH, Value.Float(10.0f32))
    var t = Status()
    t.saturation = 3.0f32
    for _ in 0..10 {
        _ = tick_food(mut t, mut h, 2, true, 20.0f32)
    }
    check("{h.float(HEALTH)} {t.exhaustion} {t.food_timer}", "10.5 3.0 0", "healed from saturation")
    // Starving, hurt every 80 ticks on hard, by 1 of `starve` (D426); on easy not at 10 health.
    var u = Status()
    u.food = 0
    u.saturation = 0.0f32
    var starved = 0
    for _ in 0..160 {
        if tick_food(mut u, mut h, 3, true, 20.0f32) {
            starved += 1
        }
    }
    check("{starved} {u.food_timer}", "2 0", "starving")
    var low = player_data()
    low.set(HEALTH, Value.Float(10.0f32))
    var e = Status()
    e.food = 0
    e.saturation = 0.0f32
    var spared = 0
    for _ in 0..80 {
        if tick_food(mut e, mut low, 1, true, 20.0f32) {
            spared += 1
        }
    }
    check("{spared} {e.food_timer}", "0 0", "starving on easy")
}

fn poses() {
    let b = pose_box(CROUCHING, 0.5, -60.0, 0.5)
    check("{b.min_x} {b.max_y} {b.max_z}", "0.19999998807907104 -58.5 0.800000011920929", "crouching box")
    let w = pose_box(SWIMMING, 0.0, 0.0, 0.0)
    check("{w.max_y}", "0.6000000238418579", "swimming box")
    check("{eye_height(STANDING)} {eye_height(CROUCHING)} {eye_height(SWIMMING)}", "1.6200000047683716 1.2699999809265137 0.4000000059604645", "eyes")
}

fn main() {
    entity_data()
    status()
    regeneration()
    food()
    poses()
    print("ok")
}
