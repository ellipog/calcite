/// Checks `storage.problems`: problems kept once each in the order they came, and written as
/// vanilla's `getTreeReport` writes them, a step with one child or one problem on one line with
/// it and the rest two spaces in, children before problems. The rig's `entities_poi` probe
/// checks the report against vanilla's.
module test.problems

import storage.problems.{Problems, Step}
import world.pos.{ChunkPos}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn chunk() -> Problems {
    return Problems.new(Step.Chunk(ChunkPos { x: 3, z: -4 }))
}

fn main() {
    // Nothing reported, nothing logged.
    let none_yet = chunk()
    if none_yet.close(String("L")) != none {
        panic("a report with no problems")
    }

    // One problem at the root, on one line with it; two, under it.
    var one = chunk()
    one.report(0, String("a"))
    check(one.tree(), "chunk@[3, -4]: a", "one problem")
    one.report(0, String("b"))
    check(one.tree(), "chunk@[3, -4]:\n  a\n  b", "two problems")

    // The same problem to the same reporter is kept once.
    one.report(0, String("a"))
    check(one.tree(), "chunk@[3, -4]:\n  a\n  b", "a problem again")
    let logged = one.close(String("x.Y")) else panic("no line")
    check(logged.message, "[x.Y] Serialization errors:\nchunk@[3, -4]:\n  a\n  b", "the line")

    // A chain of steps with one problem at its end is one line.
    var deep = chunk()
    let entity = deep.child(0, Step.IndexedField { name: String("Entities"), index: 1 })
    let item = deep.child(entity, Step.Field(String("Item")))
    deep.report(item, String("bad"))
    check(deep.tree(), "chunk@[3, -4].Entities[1].Item: bad", "a chain")

    // Children first, then the node's own problems; a child with two problems has them under it.
    deep.report(0, String("root"))
    deep.report(entity, String("one"))
    deep.report(entity, String("two"))
    check(deep.tree(), "chunk@[3, -4]:\n  .Entities[1]:\n    .Item: bad\n    one\n    two\n  root", "a tree")

    // Two reporters for equal steps are one node, and each keeps its own copy of a problem.
    var twins = Problems.new(Step.Empty)
    let a = twins.child(0, Step.Indexed(0))
    let b = twins.child(0, Step.Indexed(0))
    twins.report(a, String("p"))
    twins.report(b, String("p"))
    twins.report(b, String("q"))
    check(twins.tree(), "[0]:\n  p\n  p\n  q", "equal steps")

    // Steps of other kinds, and a root of its own.
    var kinds = Problems.new(Step.Root(String("player")))
    let entry = kinds.child(0, Step.MapEntry { name: String("recipes"), key: String("minecraft:stick") })
    kinds.report(entry, String("unknown"))
    check(kinds.tree(), "player.recipes[minecraft:stick]: unknown", "a map entry")
    println("ok")
}
