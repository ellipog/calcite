/// Checks `world.placing` as vanilla's block items and `BlockPlaceContext` work out where a block
/// goes and its state (D378): the directions nearest a look, a turn's horizontal direction and
/// its sixteenth; what the tables say of block items, their walls and their blocks' sounds;
/// whether a state's replaced, as grass, stone and slabs are; and on a flat level, stairs, slabs,
/// logs, a torch on a wall and beside one, a chest joined to the one beside it, a fence joined
/// to stone, and a door, which doesn't fit at the top of the world.
module test.placing

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.placing.{PlaceFacts, Placement, can_be_replaced, direction_segment, from_y_rot, ordered_by_nearest, placement_state, rotation_segment}
import world.pos.{ChunkPos}
import worldgen.facts.{DOWN, EAST, Facts, NORTH, SOUTH, UP, WEST, step_x, step_y, step_z}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn env(f: Facts) -> Env {
    return Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 }
}

fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(env(f))
    return level
}

// The block `name`, by ID.
fn block(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => b,
        err(_) => panic("no block {name}"),
    }
}

fn named(f: Facts, name: str) -> u32 {
    return f.default_state(block(f, name))
}

fn with(f: Facts, state: u32, property: str, value: str) -> u32 {
    return match f.with_name(state, String(property), String(value)) {
        ok(s) => s,
        err(_) => panic("no {property} {value}"),
    }
}

// The item `name`, by ID, in the built-in item registry, the 8th.
fn item(name: str) -> i32 {
    let items = builtin_entries(7)
    for i in 0..items.len() {
        if items[i] == String(name) {
            return i32.wrap(i)
        }
    }
    panic("no item {name}")
}

// The directions as their 3D data values, with spaces between.
fn spaced(ds: List<i32>) -> String {
    var out = String("")
    for d in ds {
        out = if out.is_empty() { "{d}" } else { "{out} {d}" }
    }
    return out
}

// A click on the face `face` of the block at x, y, z, `up` from its bottom and in the middle
// across, with `held` in the hand and the player turned to `y_rot` and tilted to `x_rot`, made
// into a placement as `BlockPlaceContext` makes it: the block clicked if it's replaced, else the
// one beside the face.
fn click(e: Env, p: PlaceFacts, level: Level, x: i32, y: i32, z: i32, face: i32, up: f64, held: str, y_rot: f32, x_rot: f32) -> Placement {
    let at_x = if face == WEST { 0.0 } else if face == EAST { 1.0 } else { 0.5 }
    let at_z = if face == NORTH { 0.0 } else if face == SOUTH { 1.0 } else { 0.5 }
    var c = Placement.new(x, y, z, face, f64(x) + at_x, f64(y) + up, f64(z) + at_z, false)
    c.item = item(held)
    c.y_rot = y_rot
    c.x_rot = x_rot
    let clicked = match level.state(e.facts, x, y, z) {
        ok(s) => s,
        err(_) => panic("the block clicked threw"),
    }
    c.replace_clicked = match can_be_replaced(e, p, level, clicked, c) {
        ok(r) => r,
        err(_) => panic("canBeReplaced threw"),
    }
    if not c.replace_clicked {
        c.x = x + step_x(face)
        c.y = y + step_y(face)
        c.z = z + step_z(face)
    }
    return c
}

// The state the click's item places, or none where it can't.
fn placed(e: Env, p: PlaceFacts, level: mut Level, c: Placement) -> u32? {
    let b = p.block_of(c.item) else panic("not a block item")
    var missing = List<String>()
    let state = match placement_state(e, p, mut level, b, c, mut missing) {
        ok(s) => s,
        err(_) => panic("getStateForPlacement threw"),
    }
    check(missing.is_empty(), "placing reported something missing")
    return state
}

// The state the item `held` places, clicked as `click` has it.
fn place(e: Env, p: PlaceFacts, level: mut Level, x: i32, y: i32, z: i32, face: i32, up: f64, held: str, y_rot: f32, x_rot: f32) -> u32? {
    let c = click(e, p, level, x, y, z, face, up, held, y_rot, x_rot)
    return placed(e, p, mut level, c)
}

// The state's property `name`, or "-" where it has none.
fn prop(f: Facts, state: u32?, name: str) -> String {
    let s = state else return String("none")
    return f.get_name(s, String(name)) ?? String("-")
}

// The block placed's name, or "none".
fn block_name(f: Facts, state: u32?) -> String {
    let s = state else return String("none")
    return f.codec.blocks.name(f.block(s)).copy()
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn main() {
    // The directions nearest a look: ahead, then down, then the sides; turned west; looking
    // down.
    check(spaced(ordered_by_nearest(0.0f32, 0.0f32)) == "3 0 4 5 1 2", "looking south")
    check(spaced(ordered_by_nearest(90.0f32, 0.0f32)) == "4 0 2 3 1 5", "looking west")
    check(spaced(ordered_by_nearest(0.0f32, 60.0f32)) == "0 3 4 5 2 1", "looking down")
    check(spaced(ordered_by_nearest(-120.0f32, -30.0f32)) == "5 1 2 3 0 4", "looking up to the east-north-east")
    // A turn's horizontal direction, from south at 0 round to east, its 2D data value rounded;
    // and its sixteenth, `Math.round`, and a direction's.
    check(from_y_rot(0.0) == SOUTH and from_y_rot(90.0) == WEST and from_y_rot(180.0) == NORTH and from_y_rot(-90.0) == EAST, "the four turns")
    check(from_y_rot(44.9) == SOUTH and from_y_rot(45.0) == WEST and from_y_rot(-45.1) == EAST and from_y_rot(400.0) == SOUTH, "turns between")
    check(rotation_segment(210.0f32) == 9 and rotation_segment(180.0f32) == 8 and rotation_segment(-11.0f32) == 0 and rotation_segment(-12.0f32) == 15, "sixteenths")
    check(direction_segment(SOUTH) == 0 and direction_segment(WEST) == 4 and direction_segment(NORTH) == 8 and direction_segment(EAST) == 12, "the directions' sixteenths")

    // What the tables say: each block item's block and class, a torch's wall, a block's item,
    // and a state's place sound.
    let f = facts()
    let e = env(f)
    let p = PlaceFacts.new()
    check(p.block_of(item("stone")) == some(block(f, "stone")) and p.block_of(item("stick")) == none, "the stone item's block")
    check(p.kind_of(item("stone")) == "BlockItem" and p.kind_of(item("oak_door")) == "DoubleHighBlockItem" and p.kind_of(item("stick")) == "", "the block items' classes")
    check(p.kind_of(item("torch")) == "StandingAndWallBlockItem", "a torch's class")
    let w = p.wall_of(item("torch")) else panic("a torch has no wall torch")
    let (wall_torch, attached) = w
    check(wall_torch == block(f, "wall_torch") and attached == DOWN, "a torch's wall torch")
    check(p.wall_of(item("stone")) == none and p.item_of(block(f, "wall_torch")) == item("torch"), "a wall torch's item")
    check(p.placement_class(block(f, "oak_stairs")) == "StairBlock" and p.replace_class(block(f, "oak_slab")) == "SlabBlock", "the blocks' classes")
    let (sound, volume, pitch) = p.place_sound(named(f, "stone"))
    check(sound == "block.stone.place" and volume == 1.0f32 and pitch == 1.0f32, "stone's place sound")

    // What's replaced: short grass and air are, stone isn't; a bottom slab is by the same slab
    // from above, or its side's top half, and not by stone.
    var level = flat_level(f)
    set(mut level, 2, -60, 2, named(f, "short_grass"), "the short grass wasn't set")
    set(mut level, 4, -60, 4, named(f, "oak_slab"), "the slab wasn't set")
    check(click(e, p, level, 2, -60, 2, UP, 0.5, "stone", 0.0f32, 0.0f32).replace_clicked, "short grass wasn't replaced")
    check(not click(e, p, level, 0, -61, 0, UP, 1.0, "stone", 0.0f32, 0.0f32).replace_clicked, "grass was replaced")
    check(click(e, p, level, 4, -60, 4, UP, 0.5, "oak_slab", 0.0f32, 0.0f32).replace_clicked, "the slab wasn't doubled from above")
    check(click(e, p, level, 4, -60, 4, NORTH, 0.7, "oak_slab", 0.0f32, 0.0f32).replace_clicked, "the slab wasn't doubled from its side's top")
    check(not click(e, p, level, 4, -60, 4, NORTH, 0.3, "oak_slab", 0.0f32, 0.0f32).replace_clicked, "the slab was doubled from its side's bottom")
    check(not click(e, p, level, 4, -60, 4, UP, 0.5, "stone", 0.0f32, 0.0f32).replace_clicked, "stone went in the slab")
    let doubled = place(e, p, mut level, 4, -60, 4, UP, 0.5, "oak_slab", 0.0f32, 0.0f32)
    check(prop(f, doubled, "type") == "double", "the slab placed in a slab isn't double")
    set(mut level, 0, -60, 8, named(f, "stone"), "the stone wasn't set")
    let top = place(e, p, mut level, 0, -60, 8, NORTH, 0.8, "oak_slab", 0.0f32, 0.0f32)
    check(prop(f, top, "type") == "top", "the slab on a side's top half isn't a top slab")

    // Stairs face the way the player does, upside down on a side's top half; a log lies along
    // the face clicked.
    let stairs = place(e, p, mut level, 6, -61, 6, UP, 1.0, "oak_stairs", 0.0f32, 0.0f32)
    check(prop(f, stairs, "facing") == "south" and prop(f, stairs, "half") == "bottom" and prop(f, stairs, "shape") == "straight", "the stairs")
    set(mut level, 10, -60, 10, named(f, "stone"), "the stone wasn't set")
    let turned = place(e, p, mut level, 10, -60, 10, EAST, 0.8, "oak_stairs", 90.0f32, 0.0f32)
    check(prop(f, turned, "facing") == "west" and prop(f, turned, "half") == "top", "the stairs turned west on a side's top")
    let log = place(e, p, mut level, 10, -60, 10, EAST, 0.5, "oak_log", 0.0f32, 0.0f32)
    check(prop(f, log, "axis") == "x", "the log isn't along x")

    // A torch on stone's side is a wall torch facing away from it; beside a wall, whose side
    // isn't sturdy, it falls back to the floor.
    set(mut level, 8, -60, 0, named(f, "stone"), "the stone wasn't set")
    let wall = place(e, p, mut level, 8, -60, 0, EAST, 0.5, "torch", 0.0f32, 0.0f32)
    check(block_name(f, wall) == "minecraft:wall_torch" and prop(f, wall, "facing") == "east", "the wall torch")
    set(mut level, 8, -60, 2, named(f, "cobblestone_wall"), "the wall wasn't set")
    let floor = place(e, p, mut level, 8, -60, 2, EAST, 0.5, "torch", 0.0f32, 0.0f32)
    check(block_name(f, floor) == "minecraft:torch", "the torch by the wall isn't on the floor")

    // A chest joins the single chest beside it facing the same way, on the right where that's to
    // its west facing north. A fence joins the sturdy block beside it; fences join each other by
    // their tags, which facts made from the built-in registries haven't, so the rig's `place`
    // checks that.
    set(mut level, -4, -60, 6, with(f, named(f, "chest"), "facing", "north"), "the chest wasn't set")
    let chest = place(e, p, mut level, -3, -61, 6, UP, 1.0, "chest", 0.0f32, 0.0f32)
    check(prop(f, chest, "facing") == "north" and prop(f, chest, "type") == "right", "the chest beside a chest")
    let alone = place(e, p, mut level, -3, -61, 8, UP, 1.0, "chest", 0.0f32, 0.0f32)
    check(prop(f, alone, "type") == "single", "the chest alone")
    set(mut level, -5, -60, 1, named(f, "stone"), "the stone by the fence wasn't set")
    let fence = place(e, p, mut level, -5, -61, 0, UP, 1.0, "oak_fence", 0.0f32, 0.0f32)
    check(prop(f, fence, "south") == "true" and prop(f, fence, "east") == "false" and prop(f, fence, "west") == "false", "the fence beside stone")

    // A door's bottom half faces the way the player does; at the top of the world, where its top
    // doesn't fit, it isn't placed.
    let door = place(e, p, mut level, 0, -61, 10, UP, 1.0, "oak_door", 0.0f32, 0.0f32)
    check(block_name(f, door) == "minecraft:oak_door" and prop(f, door, "half") == "lower" and prop(f, door, "facing") == "south", "the door")
    set(mut level, 0, 318, 0, named(f, "stone"), "the stone at the top wasn't set")
    let high = click(e, p, level, 0, 318, 0, UP, 1.0, "oak_door", 0.0f32, 0.0f32)
    check(high.y == 319, "the door doesn't go on top")
    check(placed(e, p, mut level, high) == none, "a door was placed at the world's top")
    println("ok placing")
}
