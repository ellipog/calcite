/// Checks experience orbs, `world.experience_orb` and their part of `world.entities` (CAL-154): an
/// orb made with its random's UUID, spin and motion, one falling onto stone and bouncing to a
/// stop, and one following a player, each to the bit against a model of vanilla's `ExperienceOrb`
/// written apart from Calcite's, [`orb_model.py`](orb_model.py), which prints what this checks;
/// who an orb follows, not a spectator, and no one where the nearest is dead; orbs taking in
/// those of their value whose IDs are 40 apart, on their first tick and every 20 after, and an
/// award merged into one there; an orb going at 6000 ticks; how `award` splits experience; and
/// an orb's saved tag, read back.
module test.experience_orb

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.attributes.{Wearing}
import world.body.{BodyFacts, EntitySound}
import world.chunk.{BlockStates}
import world.collision.{CollisionBlocks}
import world.damage.{DamageTypes}
import world.entities.{EntityTicking, Entities, StackSizes}
import world.experience_orb.{ExperienceOrb, Follower, orb_values}
import world.inside.{Rain}
import world.living.{LivingFacts, Warding}
import world.loot.{LootParams}
import world.mob.{MobLight}
import world.movement.{MovementStates}
import world.navigation.{NavLevel, SentBlock}
import worldgen.facts.{Facts}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// Stone at y 0 and below, air above, loaded and ticking everywhere near.
struct World {
    stone: u32
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -64 or x >= 64 or z < -64 or z >= 64 {
            return none
        }
        if y <= 0 {
            return some(self.stone)
        }
        return some(0)
    }
}

impl EntityTicking for World {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool {
        return chunk_x > -100 and chunk_z > -100
    }

    fn listed(self, chunk_x: i32, chunk_z: i32) -> bool {
        return self.ticks_entities(chunk_x, chunk_z)
    }
}

impl Rain for World {
    fn rains_on(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }
}

impl MobLight for World {
    fn magic_light(self, x: i32, y: i32, z: i32) -> f32 {
        _ = x + y + z
        return 0.0f32
    }

    fn monsters_burn(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }

    fn sees_sky(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return true
    }
}

impl Warding for World {
    fn protection(self, worn: List<Tag?>, params: LootParams) -> (f32, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (0.0f32, List<String>())
    }

    fn immune(self, worn: List<Tag?>, params: LootParams) -> (bool, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (false, List<String>())
    }
}

impl NavLevel for World {
    fn level_time(self) -> i64 {
        return 0
    }

    fn top_y(self) -> i32 {
        return 319
    }

    fn sent_first(self) -> u64 {
        return 0
    }

    fn sent_total(self) -> u64 {
        return 0
    }

    fn sent_at(self, i: u64) -> SentBlock {
        return SentBlock { x: i32.wrap(i), y: 0, z: 0, old: 0, now: 0 }
    }
}

struct Sizes {
    most: i32
}

impl StackSizes for Sizes {
    fn stack_most(self, stack: Tag) -> i32 {
        return if stack == Tag.Int(0) { 0 } else { self.most }
    }
}

impl Wearing for Sizes {
    fn worn_component(self, stack: Tag, name: String) -> Tag? {
        _ = stack
        _ = name
        return none
    }

    fn worn_enchantments(self, stack: Tag) -> List<(i32, JavaHashMap<String, Tag>)> {
        _ = stack
        return List<(i32, JavaHashMap<String, Tag>)>()
    }
}

fn bits(v: f64) -> i64 {
    return i64.wrap(v.to_bits())
}

fn state_bits(o: ExperienceOrb) -> List<i64> {
    return [bits(o.body.x), bits(o.body.y), bits(o.body.z), bits(o.body.vx), bits(o.body.vy), bits(o.body.vz), if o.body.on_ground { 1 } else { 0 }]
}

// Its ticks against the model's: `want` is each tick checked, then its seven numbers.
fn against(o: mut ExperienceOrb, f: Facts, m: MovementStates, t: BodyFacts, w: World, players: List<Follower>, ticks: i32, want: List<i64>, what: str) {
    var at: usize = 0
    var unheard = List<EntitySound>()
    for tick in 1..=ticks {
        o.tick_start(f, m, t, DamageTypes.vanilla(), w, -64, false)
        o.tick_rest(f, m, t, DamageTypes.vanilla(), w, players, mut unheard)
        if at < want.len() and want[at] == i64(tick) {
            let got = state_bits(o)
            for k in 0..got.len() {
                if got[k] != want[at + 1 + k] {
                    panic("{what}, tick {tick}: {o.body.x} {o.body.y} {o.body.z} moving {o.body.vx} {o.body.vy} {o.body.vz}, on the ground {o.body.on_ground}, differs from the model at {k}")
                }
            }
            at += 8
        }
    }
    check(at == want.len(), "not every tick of the model was checked")
}

// Made with seed 148: its UUID, spin and motion, as the model's `java.util.Random` drew them.
fn made() {
    let o = ExperienceOrb.new(7, 148, 0.5, 2.0, 0.5, 3)
    let (most, least) = o.body.uuid
    check(most == -4731420712261433922 and least == -9143664734749418238, "an orb's UUID isn't vanilla's")
    check(i64(o.body.y_rot.to_bits()) == 1133460856, "an orb's spin isn't vanilla's")
    check(bits(o.body.vx) == 4563502396099755392 and bits(o.body.vy) == 4592058055151265056 and bits(o.body.vz) == 4590222503965389776, "an orb's motion isn't vanilla's")
    check(o.value == 3 and o.count == 1 and o.age == 0 and o.health == 5, "an orb's value, count, age and health")
    check(o.value_changed and not ExperienceOrb.new(8, 148, 0.5, 2.0, 0.5, 0).value_changed, "an orb's value isn't to be sent as it's made, or one of 0 is")
    println("made: UUID, spin and motion")
}

// Falling onto stone, bouncing at 0.4 of its fall and coming to rest, each tick as the model.
fn falling(f: Facts, m: MovementStates, t: BodyFacts, w: World) {
    var o = ExperienceOrb.new(7, 148, 0.5, 2.0, 0.5, 3)
    let want: List<i64> = [
        1, 4602690263651554751, 4611849515510730476, 4603373579585425018, 4563385204747501613, 4589791689296578672, 4590111342405357305, 0,
        3, 4602712470519073648, 4611965454355847090, 4604721692729604105, 4563157806640972046, 4576990519389268561, 4589895644507994392, 0,
        5, 4602733797995468980, 4611809288206588560, 4606016420643671607, 4562939413490959991, -4636223421416902215, 4589688488239303393, 0,
        10, 4602783494501637579, 4608910143139804864, 4608107883559183453, 4562430521753110971, -4627536334325049589, 4589205780271701561, 0,
        20, 4602838436468969235, 4607182418800017408, 4609775565600872453, 4550891787656389649, 0, 4577565578441447210, 1,
        40, 4602842344786444573, 4607182418800017408, 4609894196789076850, 4481984686880167443, 0, 4508728098418645613, 1,
    ]
    against(mut o, f, m, t, w, List<Follower>(), 40, want, "falling")
    check(o.age == 40 and o.following == none, "a falling orb's age, or it followed no one")
    println("falling onto stone and bouncing, 40 ticks as the model")
}

fn player(id: i32, x: f64, spectator: bool, dead: bool) -> Follower {
    return Follower { id: id, x: x, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: spectator, dead: dead }
}

// Following a player three blocks off, pulled toward the middle of their eyes' height; not a
// spectator; and no one where the nearest is dead, though another isn't.
fn following(f: Facts, m: MovementStates, t: BodyFacts, w: World) {
    var o = ExperienceOrb.new(8, 149, 0.5, 1.0, 0.5, 3)
    let want: List<i64> = [
        1, 4601386348920117408, 4608529449767013842, 4603118513754498350, -4633641132703087572, 4598951981411302247, 4587055232213409117, 0,
        2, 4600782417429863510, 4609741987108473606, 4603544148754628862, -4638476392843238184, 4598424766388937454, 4586834777967734356, 0,
        5, 4602851884722940545, 4612074989973350499, 4604689376953633149, 4590214167834157005, 4595014689706567047, 4585729810288787204, 0,
        10, 4609354944193678347, 4612598157436551771, 4605834710298944427, 4598490815331488647, -4637968727886809571, 4578561275264630520, 0,
        20, 4617685206588557337, 4607452432598749938, 4589734640553076154, 4593256614323668324, 4588628453928849901, -4634549249736674062, 0,
    ]
    against(mut o, f, m, t, w, [player(1, 3.5, false, false)], 20, want, "following")
    check(o.following == some(1), "an orb didn't follow the player near it")

    var unheard = List<EntitySound>()
    var s = ExperienceOrb.new(9, 150, 0.5, 1.0, 0.5, 3)
    s.tick_start(f, m, t, DamageTypes.vanilla(), w, -64, false)
    s.tick_rest(f, m, t, DamageTypes.vanilla(), w, [player(2, 2.5, true, false), player(3, 4.5, false, false)], mut unheard)
    check(s.following == some(3), "an orb followed a spectator, or not the player past them")
    var d = ExperienceOrb.new(10, 151, 0.5, 1.0, 0.5, 3)
    d.tick_start(f, m, t, DamageTypes.vanilla(), w, -64, false)
    d.tick_rest(f, m, t, DamageTypes.vanilla(), w, [player(4, 2.5, false, true), player(5, 4.5, false, false)], mut unheard)
    check(d.following == none, "an orb whose nearest player is dead followed another")
    var far = ExperienceOrb.new(11, 152, 0.5, 1.0, 0.5, 3)
    far.tick_start(f, m, t, DamageTypes.vanilla(), w, -64, false)
    far.tick_rest(f, m, t, DamageTypes.vanilla(), w, [player(6, 8.5, false, false)], mut unheard)
    check(far.following == none, "an orb followed a player 8 blocks off")
    println("following: the nearest within 8, as the model, not a spectator, not past the dead")
}

fn still(id: i32, x: f64, value: i32) -> ExperienceOrb {
    var o = ExperienceOrb.new(id, i64(id), x, 1.0, 0.5, value)
    o.body.vx = 0.0
    o.body.vy = 0.0
    o.body.vz = 0.0
    o.body.on_ground = true
    return o
}

// Orbs whose IDs are 40 apart, of one value, taken in on the first tick, the count summed and
// the younger age kept; not those of another value or ID; and an award merged into the first
// that can take it.
fn merging(f: Facts, m: MovementStates, t: BodyFacts, w: World) {
    let lf = LivingFacts.new(f)
    var store = Entities.new()
    var a = still(7, 0.5, 3)
    a.age = 100
    var b = still(47, 0.9, 3)
    b.age = 50
    b.count = 2
    store.add_orb(a)
    store.add_orb(b)
    store.add_orb(still(8, 0.7, 3))
    store.add_orb(still(87, 0.6, 1))
    var sounds = List<EntitySound>()
    store.tick(f, m, t, lf, Sizes { most: 64 }, w, -64, false, mut sounds)
    check(store.contains(7) and not store.contains(47), "the orb 40 IDs on wasn't taken in")
    let kept = store.orb(7)
    check(kept.count == 3 and kept.age == 51, "the merged orb's count and age")
    check(store.contains(8) and store.contains(87), "an orb of another ID or value was taken in")
    let gone = store.take_gone()
    check(gone.len() == 1 and gone[0] == 47, "the taken-in orb isn't told of as gone")
    // Not again till its 21st tick.
    var c = still(127, 0.5, 3)
    c.body.tick_count = 1
    store.add_orb(c)
    store.tick(f, m, t, lf, Sizes { most: 64 }, w, -64, false, mut sounds)
    check(store.contains(127), "an orb looked for others to take in on its second tick")
    // An award of 3 drawing 47, which is 7's: merged into it, its age none.
    check(store.merge_award(0.5, 1.25, 0.5, 3, 47), "an award didn't merge into the orb whose ID it drew")
    check(store.orb(7).count == 4 and store.orb(7).age == 0, "the award's merge")
    check(not store.merge_award(0.5, 1.25, 0.5, 3, 9), "an award merged into an orb whose ID it didn't draw")
    check(not store.merge_award(5.5, 1.25, 0.5, 3, 47), "an award merged into an orb not there")
    // Lifetime.
    var old = still(200, 8.5, 5)
    old.age = 5999
    store.add_orb(old)
    store.tick(f, m, t, lf, Sizes { most: 64 }, w, -64, false, mut sounds)
    check(not store.contains(200), "an orb outlived 6000 ticks")
    println("merging: 40 IDs apart, of a value, on the first tick, and awards")
}

// `award`'s split: the biggest of vanilla's sizes that fits, then what's left.
fn splits() {
    let cases: List<(i32, List<i32>)> = [(1, [1]), (2, [1, 1]), (4, [3, 1]), (5, [3, 1, 1]), (16, [7, 7, 1, 1]), (2500, [2477, 17, 3, 3]), (0, List<i32>())]
    for (amount, want) in cases {
        if orb_values(amount) != want {
            panic("award's split of {amount}")
        }
    }
    println("award: split into vanilla's sizes")
}

// Its tag: what every entity saves, then its health, age and value as shorts, and its count; read
// back the same, a count that isn't positive read as 1.
fn saving() {
    var o = still(12, 2.5, 17)
    o.count = 3
    o.age = 1234
    let tag = o.saved()
    let Tag.Compound(m) = tag else panic("an orb's tag isn't a compound")
    check(m["id"] == Tag.Str(String("minecraft:experience_orb")), "an orb's tag's id")
    check(m["Health"] == Tag.Short(5i16) and m["Age"] == Tag.Short(1234i16) and m["Value"] == Tag.Short(17i16) and m["Count"] == Tag.Int(3), "an orb's own fields")
    var lines = List<Entry>()
    let back = ExperienceOrb.loaded(12, 12, m, mut lines) ?? panic("an orb's tag didn't read back")
    check(back.saved() == tag, "an orb's tag read back isn't the same")
    check(back.value_changed, "an orb's value read isn't to be sent")
    var odd = m.copy()
    odd.insert(String("Count"), Tag.Int(-2))
    let one = ExperienceOrb.loaded(13, 13, odd, mut lines) ?? panic("an orb with a bad count didn't read")
    check(one.count == 1 and lines.is_empty(), "a count that isn't positive")
    println("saving: an orb's tag as vanilla's, read back the same")
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    let t = BodyFacts.new(f)
    let stone = f.block_named(String("minecraft:stone")) ?? panic("no stone")
    let w = World { stone: f.default_state(stone) }
    made()
    falling(f, m, t, w)
    following(f, m, t, w)
    merging(f, m, t, w)
    splits()
    saving()
    println("ok")
}
