/// Checks `java.decimal`: doubles written as JDK 25's `DecimalFormat("#")` with 15 fraction digits
/// writes them, as vanilla's macros put floats and doubles in their lines (D568). Each case is the
/// double's bits and what JDK 25 gives.
module test.decimal

import java.decimal.{format_plain}

fn check(bits: u64, want: str) {
    let got = format_plain(f64.from_bits(bits), 15)
    if got != String(want) {
        panic("{bits}: got {got}, want {want}")
    }
}

fn main() {
    // Zeros, signs and no zero before the point.
    check(0x0000000000000000, "0")
    check(0x8000000000000000, "-0")
    check(0x3FF0000000000000, "1")
    check(0xBFF0000000000000, "-1")
    check(0x3FE0000000000000, ".5")
    check(0xBFE0000000000000, "-.5")
    check(0x3FB999999999999A, ".1")
    check(0x3FD3333333333333, ".3")
    check(0x4004000000000000, "2.5")
    check(0x40934A0000000000, "1234.5")
    check(0x416312D000000000, "10000000")
    check(0x41678C29D0000000, "12345678.5")
    // At most 15 fraction digits, rounded half to even by where the double is exactly.
    check(0x3CD203AF9EE75616, ".000000000000001")
    check(0x3CC203AF9EE75616, ".000000000000001")
    check(0x3CDB05876E5B0120, ".000000000000001")
    check(0x3CE6849B86A12B9B, ".000000000000002")
    check(0x3CEF86735614D6A6, ".000000000000004")
    check(0x3C9CD2B297D889BC, "0")
    check(0x3CC1A773C9CE3AC3, "0")
    check(0x3CC25FEB74007168, ".000000000000001")
    check(0xBBC79CA10C924223, "-0")
    check(0xBCBCD2B297D889BC, "-0")
    check(0xBCC59E05F1E2674D, "-.000000000000001")
    check(0x3EF0000000000000, ".000015258789062")
    check(0x3F08000000000000, ".000045776367188")
    check(0xBEF0000000000000, "-.000015258789062")
    check(0x3EE0000000000000, ".000007629394531")
    check(0x3FD5555555555555, ".333333333333333")
    check(0x3FE5555555555555, ".666666666666667")
    check(0x3FBF9ADD3746F65F, ".123456789012346")
    check(0x3FEFFFFFFFFFFFFF, "1")
    check(0x4008000000000001, "3")
    check(0x0000000000000001, "0")
    check(0x0010000000000000, "0")
    check(0x01A56E1FC2F8F359, "0")
    // Floats as doubles, as a float tag's value is given.
    check(0x3FB99999A0000000, ".100000001490116")
    check(0x3FD3333340000000, ".300000011920929")
    check(0x405EDD2F20000000, "123.45600128173828")
    check(0x3DDB7CDFE0000000, ".0000000001")
    // The shortest digits, and integers from 2⁵² exactly, rounded off from 2⁵⁸.
    check(0x419D6F34547E6B75, "123456789.12345679")
    check(0x430C6BF526340000, "1000000000000000")
    check(0x4341C37937E08000, "10000000000000000")
    check(0x4376345785D8A000, "100000000000000000")
    check(0x438EB78580000000, "276673065834774528")
    check(0x4386263C00000000, "199503636080885760")
    check(0x43B2162B629B7D20, "1303276844685795330")
    check(0x43AD434A04000000, "1054305215789924350")
    check(0x43CE6B2093B88000, "4383762924947111900")
    check(0x43AF800000000000, "1134907106097364990")
    // Not numbers.
    check(0x7FF8000000000000, "NaN")
    check(0x7FF0000000000000, "∞")
    check(0xFFF0000000000000, "-∞")
    print("ok\n")
}
