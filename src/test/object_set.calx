/// fastutil's `ObjectOpenHashSet` of strings as Calcite has it, `java.object_set` (CAL-164): the
/// names of eight of vanilla's advancements' requirements, each set added in turn as
/// `AdvancementRequirements.names` adds them, come out in the order fastutil 8.5.18's set gives
/// them, as a Java program run with it printed them, past both of its rehashes, with sets of one
/// and of many.
module test.object_set

import java.object_set.{StringOpenHashSet}

// The names of `requirements` in the set's order, a space between each.
fn order(requirements: List<List<str>>) -> String {
    var names = StringOpenHashSet.new()
    for set in requirements {
        var each = List<String>()
        for n in set {
            each.push(String(n))
        }
        names.add_all(each)
    }
    var out = String()
    for n in names.values() {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str(n)
    }
    return out
}

fn check(requirements: List<List<str>>, want: str, what: str) {
    let got = order(requirements)
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

fn main() {
    // minecraft:husbandry/balanced_diet.
    check([["apple"], ["mushroom_stew"], ["bread"], ["porkchop"], ["cooked_porkchop"], ["golden_apple"], ["enchanted_golden_apple"], ["cod"], ["salmon"], ["tropical_fish"], ["pufferfish"], ["cooked_cod"], ["cooked_salmon"], ["cookie"], ["melon_slice"], ["beef"], ["cooked_beef"], ["chicken"], ["cooked_chicken"], ["rotten_flesh"], ["spider_eye"], ["carrot"], ["potato"], ["baked_potato"], ["poisonous_potato"], ["golden_carrot"], ["pumpkin_pie"], ["rabbit"], ["cooked_rabbit"], ["rabbit_stew"], ["mutton"], ["cooked_mutton"], ["chorus_fruit"], ["beetroot"], ["beetroot_soup"], ["dried_kelp"], ["suspicious_stew"], ["sweet_berries"], ["honey_bottle"], ["glow_berries"]], "pumpkin_pie golden_carrot poisonous_potato apple golden_apple mushroom_stew melon_slice porkchop carrot rabbit cooked_porkchop pufferfish rotten_flesh honey_bottle bread cod cookie potato rabbit_stew tropical_fish beetroot sweet_berries salmon cooked_mutton dried_kelp enchanted_golden_apple cooked_cod spider_eye cooked_beef chicken glow_berries chorus_fruit cooked_chicken suspicious_stew cooked_rabbit beef baked_potato beetroot_soup cooked_salmon mutton", "husbandry/balanced_diet")
    // minecraft:adventure/adventuring_time.
    check([["minecraft:mushroom_fields"], ["minecraft:deep_frozen_ocean"], ["minecraft:frozen_ocean"], ["minecraft:deep_cold_ocean"], ["minecraft:cold_ocean"], ["minecraft:deep_ocean"], ["minecraft:ocean"], ["minecraft:deep_lukewarm_ocean"], ["minecraft:lukewarm_ocean"], ["minecraft:warm_ocean"], ["minecraft:stony_shore"], ["minecraft:swamp"], ["minecraft:mangrove_swamp"], ["minecraft:snowy_slopes"], ["minecraft:snowy_plains"], ["minecraft:snowy_beach"], ["minecraft:windswept_gravelly_hills"], ["minecraft:grove"], ["minecraft:windswept_hills"], ["minecraft:snowy_taiga"], ["minecraft:windswept_forest"], ["minecraft:taiga"], ["minecraft:plains"], ["minecraft:meadow"], ["minecraft:beach"], ["minecraft:forest"], ["minecraft:old_growth_spruce_taiga"], ["minecraft:flower_forest"], ["minecraft:birch_forest"], ["minecraft:dark_forest"], ["minecraft:pale_garden"], ["minecraft:savanna_plateau"], ["minecraft:savanna"], ["minecraft:jungle"], ["minecraft:badlands"], ["minecraft:desert"], ["minecraft:wooded_badlands"], ["minecraft:jagged_peaks"], ["minecraft:stony_peaks"], ["minecraft:frozen_river"], ["minecraft:river"], ["minecraft:ice_spikes"], ["minecraft:dappled_forest"], ["minecraft:old_growth_pine_taiga"], ["minecraft:sunflower_plains"], ["minecraft:old_growth_birch_forest"], ["minecraft:sparse_jungle"], ["minecraft:bamboo_jungle"], ["minecraft:eroded_badlands"], ["minecraft:windswept_savanna"], ["minecraft:cherry_grove"], ["minecraft:frozen_peaks"], ["minecraft:dripstone_caves"], ["minecraft:lush_caves"], ["minecraft:sulfur_caves"], ["minecraft:deep_dark"]], "minecraft:badlands minecraft:birch_forest minecraft:meadow minecraft:grove minecraft:mangrove_swamp minecraft:desert minecraft:old_growth_birch_forest minecraft:lush_caves minecraft:wooded_badlands minecraft:taiga minecraft:ocean minecraft:beach minecraft:warm_ocean minecraft:deep_frozen_ocean minecraft:dripstone_caves minecraft:cherry_grove minecraft:dappled_forest minecraft:stony_shore minecraft:sulfur_caves minecraft:frozen_river minecraft:old_growth_spruce_taiga minecraft:snowy_taiga minecraft:dark_forest minecraft:deep_lukewarm_ocean minecraft:jagged_peaks minecraft:windswept_forest minecraft:windswept_gravelly_hills minecraft:bamboo_jungle minecraft:frozen_peaks minecraft:sunflower_plains minecraft:flower_forest minecraft:jungle minecraft:plains minecraft:old_growth_pine_taiga minecraft:deep_cold_ocean minecraft:windswept_savanna minecraft:savanna minecraft:river minecraft:ice_spikes minecraft:frozen_ocean minecraft:pale_garden minecraft:snowy_slopes minecraft:deep_dark minecraft:swamp minecraft:windswept_hills minecraft:deep_ocean minecraft:forest minecraft:savanna_plateau minecraft:mushroom_fields minecraft:eroded_badlands minecraft:cold_ocean minecraft:snowy_plains minecraft:stony_peaks minecraft:snowy_beach minecraft:sparse_jungle minecraft:lukewarm_ocean", "adventure/adventuring_time")
    // minecraft:adventure/kill_all_mobs.
    check([["minecraft:blaze"], ["minecraft:bogged"], ["minecraft:breeze"], ["minecraft:camel_husk"], ["minecraft:cave_spider"], ["minecraft:creaking"], ["minecraft:creeper"], ["minecraft:drowned"], ["minecraft:elder_guardian"], ["minecraft:ender_dragon"], ["minecraft:enderman"], ["minecraft:endermite"], ["minecraft:evoker"], ["minecraft:ghast"], ["minecraft:guardian"], ["minecraft:hoglin"], ["minecraft:husk"], ["minecraft:magma_cube"], ["minecraft:parched"], ["minecraft:phantom"], ["minecraft:piglin"], ["minecraft:piglin_brute"], ["minecraft:pillager"], ["minecraft:ravager"], ["minecraft:shulker"], ["minecraft:silverfish"], ["minecraft:skeleton"], ["minecraft:slime"], ["minecraft:spider"], ["minecraft:stray"], ["minecraft:vex"], ["minecraft:vindicator"], ["minecraft:witch"], ["minecraft:wither_skeleton"], ["minecraft:wither"], ["minecraft:zoglin"], ["minecraft:zombie_villager"], ["minecraft:zombie"], ["minecraft:zombie_horse"], ["minecraft:zombified_piglin"], ["minecraft:zombie_nautilus"]], "minecraft:wither_skeleton minecraft:husk minecraft:shulker minecraft:pillager minecraft:ender_dragon minecraft:camel_husk minecraft:phantom minecraft:slime minecraft:drowned minecraft:hoglin minecraft:enderman minecraft:bogged minecraft:zoglin minecraft:witch minecraft:parched minecraft:piglin_brute minecraft:magma_cube minecraft:creaking minecraft:ravager minecraft:zombie_horse minecraft:vex minecraft:piglin minecraft:breeze minecraft:elder_guardian minecraft:guardian minecraft:silverfish minecraft:creeper minecraft:zombie_villager minecraft:vindicator minecraft:endermite minecraft:spider minecraft:cave_spider minecraft:evoker minecraft:skeleton minecraft:zombie_nautilus minecraft:zombie minecraft:blaze minecraft:zombified_piglin minecraft:wither minecraft:stray minecraft:ghast", "adventure/kill_all_mobs")
    // minecraft:husbandry/bred_all_animals.
    check([["minecraft:horse"], ["minecraft:donkey"], ["minecraft:mule"], ["minecraft:sheep"], ["minecraft:cow"], ["minecraft:mooshroom"], ["minecraft:pig"], ["minecraft:chicken"], ["minecraft:wolf"], ["minecraft:ocelot"], ["minecraft:rabbit"], ["minecraft:llama"], ["minecraft:cat"], ["minecraft:panda"], ["minecraft:fox"], ["minecraft:bee"], ["minecraft:hoglin"], ["minecraft:strider"], ["minecraft:goat"], ["minecraft:axolotl"], ["minecraft:camel"], ["minecraft:armadillo"], ["minecraft:nautilus"], ["minecraft:turtle"], ["minecraft:frog"], ["minecraft:sniffer"]], "minecraft:strider minecraft:pig minecraft:chicken minecraft:hoglin minecraft:panda minecraft:camel minecraft:sniffer minecraft:armadillo minecraft:nautilus minecraft:cat minecraft:sheep minecraft:rabbit minecraft:donkey minecraft:cow minecraft:turtle minecraft:horse minecraft:axolotl minecraft:bee minecraft:goat minecraft:frog minecraft:ocelot minecraft:mooshroom minecraft:wolf minecraft:llama minecraft:mule minecraft:fox", "husbandry/bred_all_animals")
    // minecraft:nether/all_effects.
    check([["all_effects"]], "all_effects", "nether/all_effects")
    // minecraft:adventure/kill_a_mob.
    check([["minecraft:blaze", "minecraft:bogged", "minecraft:breeze", "minecraft:camel_husk", "minecraft:cave_spider", "minecraft:creaking", "minecraft:creeper", "minecraft:drowned", "minecraft:elder_guardian", "minecraft:ender_dragon", "minecraft:enderman", "minecraft:endermite", "minecraft:evoker", "minecraft:ghast", "minecraft:guardian", "minecraft:hoglin", "minecraft:husk", "minecraft:magma_cube", "minecraft:parched", "minecraft:phantom", "minecraft:piglin", "minecraft:piglin_brute", "minecraft:pillager", "minecraft:ravager", "minecraft:shulker", "minecraft:silverfish", "minecraft:skeleton", "minecraft:slime", "minecraft:spider", "minecraft:stray", "minecraft:vex", "minecraft:vindicator", "minecraft:witch", "minecraft:wither_skeleton", "minecraft:wither", "minecraft:zoglin", "minecraft:zombie_villager", "minecraft:zombie", "minecraft:zombie_horse", "minecraft:zombified_piglin", "minecraft:zombie_nautilus"]], "minecraft:wither_skeleton minecraft:husk minecraft:shulker minecraft:pillager minecraft:ender_dragon minecraft:phantom minecraft:camel_husk minecraft:slime minecraft:hoglin minecraft:enderman minecraft:drowned minecraft:bogged minecraft:zoglin minecraft:witch minecraft:parched minecraft:piglin_brute minecraft:magma_cube minecraft:creaking minecraft:ravager minecraft:zombie_horse minecraft:vex minecraft:piglin minecraft:breeze minecraft:guardian minecraft:elder_guardian minecraft:silverfish minecraft:creeper minecraft:zombie_villager minecraft:vindicator minecraft:endermite minecraft:spider minecraft:evoker minecraft:cave_spider minecraft:skeleton minecraft:zombie_nautilus minecraft:zombie minecraft:blaze minecraft:zombified_piglin minecraft:wither minecraft:stray minecraft:ghast", "adventure/kill_a_mob")
    // minecraft:adventure/salvage_sherd.
    check([["desert_pyramid", "desert_well", "ocean_ruin_cold", "ocean_ruin_warm", "trail_ruins_rare", "trail_ruins_common"], ["has_sherd"]], "desert_well desert_pyramid has_sherd trail_ruins_common ocean_ruin_cold trail_ruins_rare ocean_ruin_warm", "adventure/salvage_sherd")
    // minecraft:recipes/misc_iron_nugget_from_smelting.
    check([["has_the_recipe", "has_iron_pickaxe", "has_iron_shovel", "has_iron_axe", "has_iron_hoe", "has_iron_sword", "has_iron_spear", "has_iron_helmet", "has_iron_chestplate", "has_iron_leggings", "has_iron_boots", "has_iron_horse_armor", "has_chainmail_helmet", "has_chainmail_chestplate", "has_chainmail_leggings", "has_chainmail_boots", "has_iron_nautilus_armor"]], "has_iron_nautilus_armor has_iron_horse_armor has_iron_chestplate has_iron_hoe has_iron_shovel has_iron_axe has_chainmail_boots has_iron_spear has_iron_pickaxe has_iron_helmet has_chainmail_leggings has_chainmail_chestplate has_chainmail_helmet has_iron_sword has_iron_boots has_iron_leggings has_the_recipe", "recipes/misc_iron_nugget_from_smelting")
