/// Checks `server.level` as a replay drives it, with no IO thread: which chunks a player's and a
/// spawn's tickets load, the reads they ask for, handed back by hand, what's ready to send, a
/// holder that unloads while its chunk is read, and the far chunks of a view past the tickets'
/// reach; what `prepare` makes of a chunk as its region file holds it; the light of a flat
/// chunk among flat ones, with lit terrain past them; and a chunk's packet kept for the players
/// still to be sent it, and its compressed body once an encoder has made it, until its light
/// changes or it goes; chunks lit a tick's worth at a time; and blocks set, with the light they
/// change and what's kept to broadcast (D321).
module test.level

import nbt.snbt.{parse_compound}
import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import protocol.compression.{compress}
import protocol.play.{LightData, LightLayer}
import nbt.tag.{Tag}
import server.chunk_jobs.{ChunkContext, Loaded, SavedChunk, saved_bytes}
import server.chunks.{Next}
import server.level.{ChunkPacket, Level, MOST_FAR_LOADS, SPAWN_RADIUS, light_value}
import server.light_service.{LIGHT_STEP, LightAsk, LightBody, LightService}
import server.log.{Entry}
import storage.chunk.{ChunkData, ChunkFormat, ChunkRest, PackedRest, RestStore, SavedTick}
import storage.region.{Compression, External, Stored}
import storage.regions.{ChunkRead, encode_tag, region_of}
import world.chunk.{AIR_STATE, BlockStates, Chunk}
import world.level_writer.{UPDATE_ALL, UPDATE_NEIGHBORS}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.light.{LightStates, SkySources}
import world.pos.{ChunkPos}
import world.tickets.{TicketStorage}

const STONE: u32 = 1
const GLOWSTONE: u32 = 8686

fn check_int(got: i64, want: i64, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world's blocks, by vanilla's IDs.
fn flat_blocks() -> FlatBlocks {
    return FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }
}

// The flat chunk, as `world.flat` makes it, for the level to light flat chunks with.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(flat_blocks(), BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn at(x: i32, z: i32) -> ChunkPos {
    return ChunkPos { x: x, z: z }
}

// Hands back each read asked for within `radius` of `center`, generated, until none is asked
// for, as the IO thread would, and how many it handed back. A test's light steps as the level
// settles, so what can be lit is.
fn hand_back(level: mut Level, center: ChunkPos, radius: i32) -> i64 {
    var n: i64 = 0
    loop {
        var any = false
        for x in center.x - radius..center.x + radius + 1 {
            for z in center.z - radius..center.z + radius + 1 {
                if level.read_chunk(at(x, z), [], Loaded.Generate, []) {
                    n += 1
                    any = true
                }
            }
        }
        if not any {
            return n
        }
    }
}

// Whether every chunk within `radius` of `center` can be sent.
fn sendable_around(level: Level, center: ChunkPos, radius: i32) -> bool {
    for x in center.x - radius..center.x + radius + 1 {
        for z in center.z - radius..center.z + radius + 1 {
            if not level.sendable(at(x, z)) {
                return false
            }
        }
    }
    return true
}

fn holders(level: Level) -> i64 {
    let (near, _) = level.chunk_count()
    return i64.wrap(near)
}

fn far_count(level: Level) -> i64 {
    let (_, n) = level.chunk_count()
    return i64.wrap(n)
}

// A world that reads nothing: a player's tickets make the chunks 12 around them full, those 11
// around them tick, so they can be sent, and nothing past that.
fn flat() {
    var level = Level.new(10, 10)
    let player = at(3, -2)
    level.add_player(player, 1)
    level.pump()
    check_int(holders(level), 25 * 25, "chunks loaded for a view of 10")
    check(sendable_around(level, player, 11), "a chunk 11 out can't be sent")
    check(not level.sendable(at(player.x + 12, player.z)), "a chunk 12 out can be sent")
    // Going into the next chunk east loads a column. The column now 13 out keeps its chunk: its
    // holder's level is 34, and a holder goes only once it's past 44.
    let east = at(player.x + 1, player.z)
    level.move_player(player, east, 1)
    level.pump()
    level.tick()
    check_int(holders(level), 25 * 26, "chunks loaded after moving")
    check(level.sendable(at(east.x + 11, east.z)), "the new column can't be sent")
    // Walking on, the 11 columns behind those 12 out keep theirs, and the rest go.
    var here = east
    for _ in 0..30 {
        let next = at(here.x + 1, here.z)
        level.move_player(here, next, 1)
        level.pump()
        level.tick()
        here = next
    }
    check_int(holders(level), 25 * (25 + 11), "chunks loaded after walking")
    // Leaving lets them all go.
    level.remove_player(here, 1)
    level.pump()
    level.tick()
    check_int(holders(level), 0, "chunks loaded after leaving")
    println("ok flat")
}

// The chunks mobs may spawn in, as `collectSpawningChunks` finds them (D315): within 8 of a
// player by the natural spawn counter, ticking, and closer than 128 blocks to someone not
// spectating. At a view of 10 the circle's the limit; at 4, the 11 by 11 that tick, as both
// servers have it once the player's chunks are in.
fn spawning() {
    var level = Level.new(10, 10)
    let player = at(3, -2)
    level.add_player(player, 1)
    level.pump()
    let middle = (f64(player.x * 16 + 8), f64(player.z * 16 + 8))
    let wide = level.spawning_chunks([middle])
    check_int(i64.wrap(wide.len()), 193, "spawning chunks at a view of 10")
    for c in wide {
        let dx = c.x - player.x
        let dz = c.z - player.z
        check(dx * dx + dz * dz < 64, "a spawning chunk 128 blocks or more away")
    }
    check_int(i64.wrap(level.spawning_chunks([]).len()), 0, "spawning chunks with no one near")
    // 400 blocks away is past 128 blocks from any of the counter's, which reach 8 chunks out.
    check_int(i64.wrap(level.spawning_chunks([(middle.0 + 400.0, middle.1)]).len()), 0, "spawning chunks for someone far off")

    var near = Level.new(4, 4)
    near.add_player(player, 1)
    near.pump()
    check_int(i64.wrap(near.spawning_chunks([middle]).len()), 121, "spawning chunks at a view of 4")
    println("ok spawning")
}

// A world that reads: each chunk the tickets make full is asked for once, and loads as it's
// handed back; one not asked for, or handed back twice, is a replay gone another way.
fn reads() {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    check(level.reads(), "it doesn't read")
    let spawn = at(0, 0)
    level.load_spawn(spawn)
    check(not level.full_around(spawn, SPAWN_RADIUS), "the spawn is ready before it's read")
    // The full chunks, and the ring around them at 34 to light them with.
    let reach = SPAWN_RADIUS + 1
    let side = reach * 2 + 1
    check_int(holders(level), i64(side * side), "chunks asked for by the spawn ticket")
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            if x == SPAWN_RADIUS and z == SPAWN_RADIUS {
                continue
            }
            check(level.read_chunk(at(x, z), [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(not level.full_around(spawn, SPAWN_RADIUS), "the spawn is ready with a chunk still read")
    check(level.light_of(at(SPAWN_RADIUS - 1, SPAWN_RADIUS - 1)) == none, "a chunk beside one still read is lit")
    check(level.light_of(at(SPAWN_RADIUS - 2, SPAWN_RADIUS - 1)) != none, "a chunk with its 3×3 read isn't lit")
    check(level.read_chunk(at(SPAWN_RADIUS, SPAWN_RADIUS), [], Loaded.Generate, []), "the last spawn chunk wasn't asked for")
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't ready once it's read")
    check(not level.read_chunk(at(0, 0), [], Loaded.Generate, []), "a chunk was taken back twice")
    check(not level.read_chunk(at(20, 20), [], Loaded.Generate, []), "a chunk no one asked for was taken")
    // A player's tickets are handed over as the chunks before them load, so their reads come a
    // few at a time, as they're handed back.
    level.add_player(spawn, 1)
    level.pump()
    let first = holders(level)
    check(first < 27 * 27, "every chunk was asked for before any was read")
    check_int(hand_back(mut level, spawn, 14), 27 * 27 - i64(side * side), "chunks read for the player")
    check_int(holders(level), 27 * 27, "chunks loaded for the player")
    check(sendable_around(level, spawn, 11), "a chunk 11 out can't be sent")
    check(level.light_of(at(12, 0)) != none, "a full chunk isn't lit")
    check(level.light_of(at(13, 0)) == none, "a chunk at 34 is lit")
    // A holder that unloads while its chunk is read keeps its place until the read is back,
    // then lets it go.
    let east = at(1, 0)
    level.move_player(spawn, east, 1)
    level.pump()
    level.remove_player(east, 1)
    level.pump()
    for _ in 0..400 {
        level.tick()
    }
    let still = holders(level)
    check(still > 0, "the chunks being read went before they were back")
    check_int(hand_back(mut level, east, 14), still, "chunks back after their holders went")
    check_int(holders(level), 0, "chunks kept after their holders went")
    println("ok reads")
}

// A region's chunks as `Region.Known` holds them, a bit each by `x + z * 32` in 16 words: all
// of them but `missing`.
fn all_but(missing: ChunkPos) -> List<u64> {
    var bits: List<u64> = []
    for _ in 0..16 {
        bits.push(0xFFFF_FFFF_FFFF_FFFFu64)
    }
    let i = (missing.x & 31) + (missing.z & 31) * 32
    bits[usize.wrap(i >> 6)] &= ~(1u64 << u64.wrap(i & 63))
    return bits
}

// Chunks past the tickets' reach are sent flat at once if nothing's read; otherwise their
// region's file is asked which it has, those it hasn't are sent at once, and the rest are read
// for the player, at most 64 at a time, and let go once they're sent or out of view.
fn far() {
    var unread = Level.new(40, 10)
    check(unread.next(at(100, 0), false) == Next.Send, "a far chunk of a world that reads nothing waits")
    var level = Level.new(40, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    level.serve(7)
    let saved = at(100, 0)
    let region = region_of(saved)
    check(level.next(saved, false) == Next.Stop, "a far chunk went before its region's file said")
    check(level.next(saved, false) == Next.Stop, "a far chunk went while its region's file was asked")
    let missing = at(100, 1)
    check(level.read_region(region, [], all_but(missing)), "the region wasn't asked about")
    check(not level.read_region(region, [], all_but(missing)), "the region was taken twice")
    check(not level.read_region(at(9, 9), [], all_but(missing)), "a region no one asked about was taken")
    check(level.next(missing, false) == Next.Send, "a far chunk its file hasn't waits")
    check(level.next(saved, false) == Next.Skip, "a far chunk went before it was read")
    check(level.next(saved, false) == Next.Skip, "a far chunk went while it was read")
    check(level.read_chunk(saved, [], Loaded.Generate, []), "the far chunk wasn't asked for")
    check(level.next(saved, false) == Next.Send, "a far chunk read waits")
    check_int(far_count(level), 1, "far chunks held")
    level.forget_far(saved, 7)
    check_int(far_count(level), 0, "far chunks held once out of view")
    // 64 at once: the first two rows of the region, but the one its file hasn't, then one more,
    // and the sender stops at the next.
    check_int(i64(MOST_FAR_LOADS), 64, "the most far chunks read at once")
    var asked: i64 = 0
    for z in 0..2 {
        for x in 96..128 {
            if level.next(at(x, z), false) == Next.Skip {
                asked += 1
            }
        }
    }
    check_int(asked, 63, "far chunks being read")
    check(level.next(at(96, 2), false) == Next.Skip, "the 64th far chunk wasn't read")
    check(level.next(at(97, 2), false) == Next.Stop, "a 65th far chunk was read")
    check_int(far_count(level), 64, "far chunks being read")
    // Another player has 64 of their own.
    level.serve(8)
    check(level.next(at(97, 2), false) == Next.Skip, "another player's far chunk wasn't read")
    level.serve(7)
    check(level.read_chunk(at(96, 0), [], Loaded.Generate, []), "a far chunk wasn't asked for")
    check(level.next(at(98, 2), false) == Next.Skip, "a far chunk wasn't read once another was")
    // A player who leaves lets theirs go, and reads that come back after are let go too.
    level.forget_player(7)
    check_int(far_count(level), 1, "far chunks held once the player left")
    check(level.read_chunk(at(97, 0), [], Loaded.Generate, []), "a far chunk wasn't asked for")
    check_int(far_count(level), 1, "far chunks held once a read came back")
    println("ok far")
}

// 2,048 bytes of light, the first 15.
fn light() -> String {
    var out = String("[B;15b")
    for _ in 1..2048 {
        out.push_str(",0b")
    }
    out.push_str("]")
    return out
}

// What `snbt`'s chunk, as a region file holds it, comes to at `pos`, with what it logs.
fn loaded_from(level: mut Level, pos: ChunkPos, snbt: String, lines: mut List<Entry>) -> Loaded {
    let root = parse_compound(snbt)!
    let stored = Stored { sectors: encode_tag(root, Compression.Deflate), length: 4096, external: External.None }
    return level.make(pos, ChunkRead.Stored(stored), mut lines)
}

// A chunk saved full loads with its light; one saved before its terrain is generated; one saved
// under another position loads, with vanilla's lines.
fn prepared() {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let pos = at(2, 1)
    var lines = List<Entry>()
    let full_chunk = "\{Status: \"minecraft:full\", xPos: 2, zPos: 1, isLightOn: 1b, sections: [\{Y: 0b, block_states: \{palette: [\"minecraft:stone\"]\}, biomes: \{palette: [\"minecraft:plains\"]\}, SkyLight: {light()}\}]\}"
    match loaded_from(mut level, pos, full_chunk, mut lines) {
        Loaded.Saved(s) => {
            check_int(i64.wrap(s.saved_light().sky.len()), 1, "sky light layers")
            check(s.lighted, "a full chunk with its light on isn't lit")
            // Stone fills the section from y 0 to 15, so the sky comes down to 16.
            if let sources = s.sources {
                check_int(i64(sources.lowest_source_y(3, 3)), 16, "the sky's lowest source")
            } else {
                panic("a full chunk has no sky sources")
            }
        },
        Loaded.Generate => panic("a full chunk was generated"),
    }
    check_int(i64.wrap(lines.len()), 0, "lines for a full chunk")
    let early = "\{Status: \"minecraft:empty\", xPos: 2, zPos: 1, sections: []\}"
    match loaded_from(mut level, pos, String(early), mut lines) {
        Loaded.Generate => {},
        _ => panic("a chunk saved before its terrain loaded"),
    }
    let moved = "\{Status: \"minecraft:full\", xPos: 9, zPos: 1, sections: []\}"
    match loaded_from(mut level, pos, String(moved), mut lines) {
        Loaded.Saved(s) => check(not s.lighted, "a chunk saved with its light off is lit"),
        _ => panic("a chunk saved elsewhere was generated"),
    }
    check_int(i64.wrap(lines.len()), 2, "lines for a chunk saved elsewhere")
    if lines[0].message != "Chunk file at [2, 1] is in the wrong location; relocating. (Expected [2, 1], got [9, 1])" {
        panic("got {lines[0].message}")
    }
    if lines[1].message != "Failed to load chunk 2,1" {
        panic("got {lines[1].message}")
    }
    println("ok prepared")
}

// `bytes`, as a region file's sectors hold a chunk, read.
fn read_of(bytes: own List<u8>) -> ChunkRead {
    let length = i64.wrap((bytes.len() + 4095) / 4096 * 4096)
    return ChunkRead.Stored(Stored { sectors: bytes, length: length, external: External.None })
}

// A chunk the server holds whole, saved with the engine's light and the rest of what it saves,
// reads back lit and whole, with the blocks, the light and the rest it was saved with: its block
// entities, ticks, blocks to update and structures (D288). A chunk saved with a root tag Calcite
// doesn't write, with a time, or with no data version, isn't whole, and nor is one saved at
// another position (D258).
fn saved_lit() {
    let states = LightStates.new()
    var level = spawned(states)
    let given = level.light_of(at(SPAWN_RADIUS, 0)) else panic("the spawn's edge isn't lit")
    check(given.sky.len() > 0 and given.block.len() > 0, "the light to save has no sky or no block layers")
    let pos = at(5, 7)
    var draws = Draws { x: 11 }
    let made = match terrain(pos, states, mut draws) {
        Loaded.Saved(s) => s,
        Loaded.Generate => panic("the terrain wasn't made"),
    }
    let c = context()
    let rest = sample_rest()
    let bytes = saved_bytes(c, pos, made.chunk.value, rest.copy(), some(given.copy())) else panic("a lit chunk couldn't be encoded")
    var lines = List<Entry>()
    match level.make(pos, read_of(bytes), mut lines) {
        Loaded.Saved(s) => {
            check(s.lighted, "a chunk saved lit isn't lit")
            check(s.whole, "a chunk saved whole isn't whole")
            let rest_back = s.rest.copy() else panic("a chunk read back whole has no rest")
            rest_is(rest_back.unpack(), rest)
            let back = s.saved_light()
            bytes_are(back.sky_mask, given.sky_mask, String("the sky mask read back"))
            bytes_are(back.block_mask, given.block_mask, String("the block mask read back"))
            check_int(i64.wrap(back.sky.len()), i64.wrap(given.sky.len()), "sky layers read back")
            check_int(i64.wrap(back.block.len()), i64.wrap(given.block.len()), "block layers read back")
            for i in 0..back.sky.len() {
                bytes_are(back.sky[i].data, given.sky[i].data, "sky layer {i} read back")
            }
            for i in 0..back.block.len() {
                bytes_are(back.block[i].data, given.block[i].data, "block layer {i} read back")
            }
            let read = s.sources.copy() else panic("a chunk read back has no sky sources")
            let first = made.sources.copy() else panic("the terrain has no sky sources")
            for x in 0..16 {
                for z in 0..16 {
                    check_int(i64(read.lowest_source_y(x, z)), i64(first.lowest_source_y(x, z)), "a column's lowest sky source read back")
                }
            }
        },
        Loaded.Generate => panic("a chunk saved lit was generated"),
    }
    check_int(i64.wrap(lines.len()), 0, "lines for a chunk saved lit")
    // The same chunk with a tag Calcite doesn't write, a time, or no data version, isn't whole.
    let empty: List<List<u8>?> = []
    let root = ChunkData.lit(c.format, pos, made.chunk.value, ChunkRest.empty(24), empty.copy(), empty.copy()).write(c.format)!
    let fields = match root {
        Tag.Compound(f) => f,
        _ => panic("a chunk's root isn't a compound"),
    }
    var extra = fields.copy()
    extra.insert(String("Paper"), Tag.Int(1))
    check(not whole_from(mut level, pos, extra), "a chunk with a tag Calcite doesn't write is whole")
    var timed = fields.copy()
    timed.insert(String("LastUpdate"), Tag.Long(1200))
    check(not whole_from(mut level, pos, timed), "a chunk saved at a time is whole")
    var unlit = fields.copy()
    _ = unlit.remove(String("DataVersion"))
    check(not whole_from(mut level, pos, unlit), "a chunk with no data version is whole")
    var moved = fields.copy()
    moved.insert(String("xPos"), Tag.Int(pos.x + 1))
    check(not whole_from(mut level, pos, moved), "a chunk saved at another position is whole")
    check(whole_from(mut level, pos, fields), "a chunk written whole isn't whole")
    println("ok saved_lit")
}

// A rest with a block entity, a block tick and a fluid tick, blocks to update in one section, and
// a structure's start and references.
fn sample_rest() -> ChunkRest {
    var rest = ChunkRest.empty(24)
    rest.block_entities.push(parse_compound("\{id:\"minecraft:chest\",x:85,y:-20,z:117,components:\{\},keepPacked:0b,LootTable:\"minecraft:chests/simple_dungeon\",LootTableSeed:7L\}")!)
    rest.block_ticks.push(SavedTick { kind: 1, x: 84, y: 30, z: 120, delay: 0, priority: 0 })
    rest.fluid_ticks.push(SavedTick { kind: 1, x: 86, y: 12, z: 113, delay: 0, priority: -1 })
    rest.post_processing[3] = some([5, 17, 5])
    rest.structures = parse_compound("\{starts:\{\"minecraft:mineshaft\":\{id:\"minecraft:mineshaft\",ChunkX:5,ChunkZ:7,references:0,Children:[\{id:\"minecraft:mscorridor\",BB:[I;80,10,112,95,12,114],O:0,GD:0,hps:0b,hr:0b,sc:0b,Num:3\}]\}\},References:\{\"minecraft:mineshaft\":[L;30064771077L]\}\}")!
    return rest
}

// A rest packed as the server keeps it unpacks as it was (D289): the sample, an empty one, and
// one whose ticks are at the ends of their numbers, with a section whose list of blocks to update
// is there and empty, which isn't one with none.
fn packed_rest() {
    let sample = sample_rest()
    rest_is(PackedRest.of(sample).unpack(), sample)
    let empty = ChunkRest.empty(24)
    let back = PackedRest.of(empty).unpack()
    rest_is(back, empty)
    for i in 0..24usize {
        check(back.post_processing[i] == none, "a section with no blocks to update has some once unpacked")
    }
    var ends = ChunkRest.empty(3)
    ends.block_ticks.push(SavedTick { kind: u32.MAX, x: i32.MIN, y: -64, z: i32.MAX, delay: -1, priority: -3 })
    ends.fluid_ticks.push(SavedTick { kind: 0, x: -1, y: 319, z: -30000000, delay: i32.MAX, priority: 3 })
    ends.post_processing[0] = some([i16.MIN, i16.MAX, 0, -1])
    ends.post_processing[2] = some(List<i16>())
    let ends_back = PackedRest.of(ends).unpack()
    rest_is(ends_back, ends)
    check(ends_back.post_processing[1] == none, "a section with no blocks to update has some once unpacked")
    check(ends_back.post_processing[2] != none, "a section with an empty list of blocks to update has none once unpacked")
    let packed = PackedRest.of(empty).len()
    if packed >= 64 {
        panic("an empty rest packs to {packed} bytes")
    }
    // A chunk that ticked saves its ticks as they are then, with the rest as it was (D322).
    var ticked = sample_rest()
    ticked.block_ticks = [SavedTick { kind: 9, x: 80, y: 1, z: 112, delay: 4, priority: 1 }, SavedTick { kind: 3, x: 81, y: 2, z: 113, delay: -2, priority: 0 }]
    ticked.fluid_ticks = List<SavedTick>()
    rest_is(PackedRest.of(sample).with_ticks(ticked.block_ticks, ticked.fluid_ticks).unpack(), ticked)
    rest_is(PackedRest.of(ends).with_ticks(sample.block_ticks, sample.fluid_ticks).with_ticks(ends.block_ticks, ends.fluid_ticks).unpack(), ends)
    println("ok packed_rest")
}

// The store a level keeps its chunks' rests in gives each back as it was put in, the last one
// put in for a chunk, and none for a chunk taken out; and still does once enough are taken out
// that it moves those left up (D289).
fn rest_store() {
    var store = RestStore()
    for i in 0..100 {
        store.put(i64(i), PackedRest.of(numbered(i, 0)))
    }
    store.put(7, PackedRest.of(numbered(7, 1)))
    check_int(i64.wrap(store.len()), 100, "rests in the store")
    let first = store.held()
    for i in 0..60 {
        let r = store.take(i64(i)) else panic("the store has no rest for chunk {i}")
        rest_is(r.unpack(), numbered(i, if i == 7 { 1 } else { 0 }))
        check(store.take(i64(i)) == none, "the store gives a rest taken out back again")
    }
    check(store.held() < first, "the store didn't move its rests up once most were taken out")
    // Its ticks, which a chunk that comes to be full is given (D322).
    let ticks = store.ticks(77) else panic("the store has no ticks for chunk 77")
    let (block, fluid) = ticks
    check(block == numbered(77, 0).block_ticks and fluid.is_empty(), "a rest in the store has other ticks")
    check(store.ticks(7) == none, "the store has ticks for a chunk taken out")
    for i in 60..100 {
        let r = store.take(i64(i)) else panic("the store has no rest for chunk {i} once it moved them up")
        rest_is(r.unpack(), numbered(i, 0))
    }
    check_int(i64.wrap(store.len()), 0, "rests in the store once all are taken out")
    println("ok rest_store")
}

// A rest of 1,000 blocks to update and a tick, told apart by `i` and `version`.
fn numbered(i: i32, version: i32) -> ChunkRest {
    var rest = ChunkRest.empty(4)
    var marks = List<i16>()
    for m in 0..1000 {
        marks.push(i16.wrap(m * 7 + i))
    }
    rest.post_processing[1] = some(marks)
    rest.block_ticks.push(SavedTick { kind: u32.wrap(i), x: i * 16, y: version, z: -i, delay: i, priority: version })
    return rest
}

// Checks `got` is `want`: its block entities and structures as the same bytes, and its ticks and
// blocks to update the same.
fn rest_is(got: ChunkRest, want: ChunkRest) {
    check_int(i64.wrap(got.block_entities.len()), i64.wrap(want.block_entities.len()), "block entities read back")
    for i in 0..want.block_entities.len() {
        bytes_are(tag_bytes(got.block_entities[i]), tag_bytes(want.block_entities[i]), String("a block entity read back"))
    }
    bytes_are(tag_bytes(got.structures), tag_bytes(want.structures), String("the structures read back"))
    for (g, w) in [(got.block_ticks.copy(), want.block_ticks.copy()), (got.fluid_ticks.copy(), want.fluid_ticks.copy())] {
        check_int(i64.wrap(g.len()), i64.wrap(w.len()), "ticks read back")
        for i in 0..w.len() {
            check(g[i].kind == w[i].kind and g[i].x == w[i].x and g[i].y == w[i].y and g[i].z == w[i].z and g[i].delay == w[i].delay and g[i].priority == w[i].priority, "a tick read back isn't the one saved")
        }
    }
    check_int(i64.wrap(got.post_processing.len()), i64.wrap(want.post_processing.len()), "sections of blocks to update read back")
    for i in 0..want.post_processing.len() {
        let g = got.post_processing[i].copy() ?? List<i16>()
        let w = want.post_processing[i].copy() ?? List<i16>()
        if g != w {
            panic("the blocks to update in section {i} read back aren't those saved")
        }
    }
}

fn tag_bytes(tag: Tag) -> List<u8> {
    var out = List<u8>()
    tag.write_any(mut out)!
    return out
}

// Whether the chunk `fields` is the root of reads back whole.
fn whole_from(level: mut Level, pos: ChunkPos, fields: own JavaHashMap<String, Tag>) -> bool {
    var lines = List<Entry>()
    match level.make(pos, read_of(encode_tag(Tag.Compound(fields), Compression.Deflate)), mut lines) {
        Loaded.Saved(s) => return s.whole,
        Loaded.Generate => panic("a chunk saved full was generated"),
    }
}

// The probe's 64-bit LCG, for the terrain.
struct Draws {
    x: i64
}

impl Draws {
    fn next(mut self) -> i32 {
        self.x = self.x * 6364136223846793005 + 1442695040888963407
        return i32.wrap(self.x >>> 33)
    }
}

// A chunk of random terrain at `pos`, saved before it was lit: stone up to a height that changes
// from column to column, with glowstone here and there, and a glowstone at the west edge of the
// chunk east of 1, 0, so its light reaches into that one.
fn terrain(pos: ChunkPos, states: LightStates, draws: mut Draws) -> Loaded {
    let table = BlockStates.new([1], [1], 1)
    var chunk = Chunk.new(table, -64, 24, 0)
    for x in 0..16 {
        for z in 0..16 {
            let top = -60 + (draws.next() & 31)
            for y in -64..top {
                _ = chunk.set_block(table, x, y, z, STONE)
            }
            if draws.next() & 15 == 0 {
                _ = chunk.set_block(table, x, top, z, GLOWSTONE)
            }
        }
    }
    if pos.x == 2 and pos.z == 0 {
        _ = chunk.set_block(table, 0, -59, 8, GLOWSTONE)
    }
    var sources = SkySources.new(-64)
    sources.fill_from(chunk, states)
    var sky = List<List<u8>?>()
    var block = List<List<u8>?>()
    for _ in 0..26 {
        sky.push(none)
        block.push(none)
    }
    return Loaded.Saved(SavedChunk { chunk: Shared(chunk), sources: some(sources), sky: sky, block: block, lighted: false })
}

fn bytes_are(got: List<u8>, want: List<u8>, what: String) {
    if got.len() != want.len() {
        panic("{what}: {got.len()} bytes, want {want.len()}")
    }
    for i in 0..got.len() {
        if got[i] != want[i] {
            panic("{what}: byte {i} is {got[i]}, want {want[i]}")
        }
    }
}

fn same_light(got: LightData, want: LightData, what: String) {
    bytes_are(got.sky_mask, want.sky_mask, "{what}'s sky mask")
    bytes_are(got.block_mask, want.block_mask, "{what}'s block mask")
    bytes_are(got.empty_sky_mask, want.empty_sky_mask, "{what}'s empty sky mask")
    bytes_are(got.empty_block_mask, want.empty_block_mask, "{what}'s empty block mask")
    if got.sky.len() != want.sky.len() or got.block.len() != want.block.len() {
        panic("{what}: {got.sky.len()} and {got.block.len()} layers, want {want.sky.len()} and {want.block.len()}")
    }
    for i in 0..got.sky.len() {
        bytes_are(got.sky[i].data, want.sky[i].data, "{what}'s sky layer {i}")
    }
    for i in 0..got.block.len() {
        bytes_are(got.block[i].data, want.block[i].data, "{what}'s block layer {i}")
    }
}

// Whether two packets differ.
fn differ(a: List<u8>, b: List<u8>) -> bool {
    if a.len() != b.len() {
        return true
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return true
        }
    }
    return false
}

// A level whose spawn's chunks are read: the 3×3 in the middle flat, the rest random terrain,
// lit as it comes.
fn spawned(states: LightStates) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = at(0, 0)
    level.load_spawn(spawn)
    var draws = Draws { x: 76 }
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            let pos = at(x, z)
            let loaded = if x >= -1 and x <= 1 and z >= -1 and z <= 1 { Loaded.Generate } else { terrain(pos, states, mut draws) }
            check(level.read_chunk(pos, [], loaded, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full once it's read")
    return level
}

// The spawn's chunks: the 3×3 in the middle flat, the rest random terrain lit as it comes. Light
// from the terrain reaches into the flat chunks beside it, but not into the middle one, which
// has the flat world's light, and is sent as the flat world's chunk; a flat one beside the
// terrain is sent with its own. Once its holders go, a chunk's light goes with it.
fn lit() {
    let world = FlatWorld.new(flat_blocks(), BlockStates.new([1], [1], 1))
    let flat_light = flat_chunk().light()
    let states = LightStates.new()
    var level = spawned(states)
    let spawn = at(0, 0)
    let middle = level.light_of(spawn) else panic("the middle chunk isn't lit")
    same_light(middle, flat_light, String("the middle chunk's light"))
    let beside = level.light_of(at(1, 0)) else panic("the chunk beside it isn't lit")
    check(beside.block_mask.len() > 0, "light from the terrain doesn't reach the flat chunk beside it")
    let sent = whole(level.packet(spawn, world, false))
    bytes_are(sent, world.chunk_packet(0, 0), String("the middle chunk's packet"))
    let sent_beside = whole(level.packet(at(1, 0), world, false))
    check(sent_beside.len() > world.chunk_packet(1, 0).len(), "the chunk beside it is sent as the flat world's")
    // The spawn ticket runs out, and every chunk goes, with its light.
    for _ in 0..30 {
        level.tick()
    }
    check_int(holders(level), 0, "chunks kept after the spawn ticket ran out")
    check(level.light_of(spawn) == none, "a chunk's light stayed once it went")
    println("ok lit")
}

// What the level gave to send as a packet's ID and fields, whether or not it's kept.
fn whole(p: ChunkPacket) -> List<u8> {
    match p {
        ChunkPacket.Plain(bytes) => return bytes.copy(),
        ChunkPacket.Shared { packet, .. } => return packet.copy(),
        ChunkPacket.Compressed { .. } => panic("a packet was given compressed"),
    }
}

// The key and version of a packet the level gave as kept for other players.
fn shared_as(p: ChunkPacket) -> (i64, u64) {
    match p {
        ChunkPacket.Shared { key, version, .. } => return (key, version),
        _ => panic("a packet kept for another player wasn't given as kept"),
    }
}

// A packet the level gave compressed: its frame's body, its threshold, and its ID and fields if
// they're kept.
fn compressed_as(p: ChunkPacket) -> (List<u8>, i32, List<u8>?) {
    match p {
        ChunkPacket.Compressed { body, threshold, packet } => return (body.copy(), threshold, packet.copy()),
        _ => panic("a packet compressed for a player before wasn't given compressed"),
    }
}

// A chunk at the spawn's edge, which another player is still to be sent, is encoded once and
// kept, and they're sent the same bytes as a level that keeps nothing sends. Once one player's
// encoder has compressed it, its body is kept in its place, and the others are sent that, but
// not a body compressed from a packet the chunk had before; the last of them takes it. A player's
// tickets make the terrain past it full, which lights it, and the light at the edge changes, so
// the chunk is encoded again with it. Once its holder goes, so does what's kept for it.
fn kept() {
    let world = FlatWorld.new(flat_blocks(), BlockStates.new([1], [1], 1))
    let states = LightStates.new()
    var level = spawned(states)
    var plain = spawned(states)
    let spawn = at(0, 0)
    let edge = at(SPAWN_RADIUS, 0)
    let given = level.packet(edge, world, true)
    check_int(i64.wrap(level.kept()), 1, "packets kept for another player")
    let (key, version) = shared_as(given.copy())
    check_int(key, edge.pack(), "a kept packet's key")
    let first = whole(given)
    bytes_are(first.copy(), whole(plain.packet(edge, world, false)), String("a kept chunk's packet"))
    check_int(i64.wrap(plain.kept()), 0, "packets kept for no other player")
    bytes_are(whole(level.packet(edge, world, true)), first.copy(), String("the packet a second player is sent before it's compressed"))
    // A body compressed from a packet the chunk had before isn't kept.
    level.compressed(key, version + 1, [9, 9], 256, false)
    check_int(i64.wrap(level.kept_compressed()), 0, "kept packets compressed from another")
    let squeezed = compress(first, 256)!
    level.compressed(key, version, squeezed.copy(), 256, false)
    check_int(i64.wrap(level.kept_compressed()), 1, "kept packets compressed")
    let (body, threshold, rest) = compressed_as(level.packet(edge, world, true))
    bytes_are(body, squeezed.copy(), String("the body a player after is sent"))
    check_int(i64(threshold), 256, "the threshold a kept packet is compressed from")
    check(rest == none, "a compressed packet's ID and fields were kept for a link that doesn't check them")
    // A second body for it, from another player's encoder, changes nothing.
    level.compressed(key, version, [9, 9], 256, false)
    let (taken, _, _) = compressed_as(level.packet(edge, world, false))
    bytes_are(taken, squeezed.copy(), String("the body the last player takes"))
    check_int(i64.wrap(level.kept()), 0, "packets kept once the last player took it")
    level.compressed(key, version, squeezed.copy(), 256, false)
    check_int(i64.wrap(level.kept()), 0, "packets kept once a body came back for one taken")
    // The middle chunk, flat among flat ones, is the flat world's, so there's nothing to keep.
    _ = level.packet(spawn, world, true)
    check_int(i64.wrap(level.kept()), 0, "a flat chunk among flat ones kept")
    // Kept again, it's another version, and for a link that checks what's sent, its ID and fields
    // stay with its body.
    let (key_again, version_again) = shared_as(level.packet(edge, world, true))
    check(version_again != version, "a packet kept again has the version of the one before")
    level.compressed(key_again, version_again, squeezed.copy(), 256, true)
    let (_, _, kept_whole) = compressed_as(level.packet(edge, world, true))
    bytes_are(kept_whole!, first.copy(), String("the ID and fields kept with a body"))
    level.add_player(spawn, 1)
    level.pump()
    _ = hand_back(mut level, spawn, 14)
    plain.add_player(spawn, 1)
    plain.pump()
    _ = hand_back(mut plain, spawn, 14)
    // Its light changed, so what was kept went, and it's encoded again.
    let relit = whole(level.packet(edge, world, true))
    check(differ(relit.copy(), first.copy()), "the light at the spawn's edge didn't change")
    bytes_are(relit, whole(plain.packet(edge, world, false)), String("the packet once its light changed"))
    // The player leaves, the tickets run out, and what's kept goes with the chunk.
    level.remove_player(spawn, 1)
    for _ in 0..400 {
        level.tick()
    }
    check_int(holders(level), 0, "chunks kept after the player left")
    check_int(i64.wrap(level.kept()), 0, "packets kept once their chunks went")
    println("ok kept")
}

// A player's view brings hundreds of chunks to light, which light takes a step at a time, and
// every one is lit once they're all read (D264).
fn steps() {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = at(0, 0)
    level.load_spawn(spawn)
    _ = hand_back(mut level, spawn, SPAWN_RADIUS + 1)
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn's chunks wait for light")
    level.add_player(spawn, 1)
    level.pump()
    _ = hand_back(mut level, spawn, 14)
    check(sendable_around(level, spawn, 11), "a chunk 11 out can't be sent once they're all lit")
    println("ok steps")
}

// Light lights at most `LIGHT_STEP` chunks a step, in the order they came to be ready, and the
// rest in the steps after, with no more asks; a chunk is lit once its holder's full and the 3×3
// around it is initialized; and a step that has nothing to do says so (D264).
fn light_steps() {
    let c = context()
    var service = LightService.new(c.min_section, c.sections, true, flat_chunk())
    var asks = Deque<LightAsk>()
    let side: i32 = 30
    for x in 0..side {
        for z in 0..side {
            let k = at(x, z).pack()
            asks.push_last(LightAsk.Came { k: k, body: LightBody.Flat, sky: [], block: [], lighted: false })
            // The edge isn't full, so the chunks inside it can be lit.
            if x > 0 and x < side - 1 and z > 0 and z < side - 1 {
                asks.push_last(LightAsk.Full { k: k, full: true })
            }
        }
    }
    let inside = i64((side - 2) * (side - 2))
    let n = asks.len()
    let first = service.step(mut asks, n) else panic("a step with asks did nothing")
    check_int(i64.wrap(first.covered), i64.wrap(n), "the asks the first step covered")
    check_int(i64.wrap(first.initialized.len()), i64(side * side), "chunks the first step initialized")
    check_int(i64.wrap(first.lit.len()), i64.wrap(LIGHT_STEP), "chunks the first step lit")
    var count = i64.wrap(first.lit.len())
    var taken = 1
    while service.pending() {
        let d = service.step(mut asks, 0) else panic("a step with chunks to light did nothing")
        check(i64.wrap(d.covered) == i64.wrap(n), "a step with no asks covered more")
        check(d.lit.len() <= LIGHT_STEP, "a step lit more than LIGHT_STEP")
        count += i64.wrap(d.lit.len())
        taken += 1
    }
    check_int(count, inside, "chunks lit")
    check_int(i64(taken), (inside + i64.wrap(LIGHT_STEP) - 1) / i64.wrap(LIGHT_STEP), "steps")
    check(service.step(mut asks, 0) == none, "a step with nothing to do did something")
    println("ok light_steps")
}

// A chunk saved lit is saved with its light again once it's initialized, though its holder never
// came to be full, as its light can change as those beside it are lit; one saved unlit isn't,
// until it's lit (CAL-71).
fn saved_light_kept() {
    let c = context()
    var service = LightService.new(c.min_section, c.sections, true, flat_chunk())
    var asks = Deque<LightAsk>()
    let was_lit = at(0, 0).pack()
    let unlit = at(5, 5).pack()
    asks.push_last(LightAsk.Came { k: was_lit, body: LightBody.Flat, sky: [], block: [], lighted: true })
    asks.push_last(LightAsk.Came { k: unlit, body: LightBody.Flat, sky: [], block: [], lighted: false })
    let n = asks.len()
    _ = service.step(mut asks, n)
    asks.push_last(LightAsk.Save(was_lit))
    asks.push_last(LightAsk.Save(unlit))
    let d = service.step(mut asks, 2) else panic("a step with saves did nothing")
    check_int(i64.wrap(d.saves.len()), 2, "saves given")
    var given = List<bool>()
    for s in d.saves {
        given.push(if let _ = s { true } else { false })
    }
    check(given[0], "a chunk saved lit was saved without its light")
    check(not given[1], "a chunk saved unlit was saved with light")
    println("ok saved light kept")
}

// A spawn ticket runs out 20 ticks after its own chunk is ready to save, whether the chunks
// around it are full or not, and those still read are let go: the place is ready then, as
// vanilla's future for the range is done, though it isn't full.
fn let_go() {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = at(0, 0)
    level.load_spawn(spawn)
    // The spawn's own chunk and those beside it, so it's lit, and ready to save.
    for x in -1..2 {
        for z in -1..2 {
            check(level.read_chunk(at(x, z), [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    level.tick()
    check(level.light_of(spawn) != none, "the spawn's chunk isn't lit")
    check(not level.around_done(spawn, SPAWN_RADIUS), "the spawn is ready with chunks still read")
    var ticks = 1
    while not level.around_done(spawn, SPAWN_RADIUS) and ticks < 100 {
        level.tick()
        ticks += 1
    }
    check_int(i64(ticks), 21, "ticks before the spawn ticket ran out")
    check(not level.full_around(spawn, SPAWN_RADIUS), "the chunks still read were taken in")
    // Nothing else holds the spawn's own chunk, so it goes too, until the player's ready spawn
    // adds the ticket again.
    check(not level.full(spawn), "the spawn's own chunk was kept")
    level.keep_spawn(spawn)
    level.pump()
    let side = (SPAWN_RADIUS + 1) * 2 + 1
    check_int(holders(level), i64(side * side), "chunks asked for again by the spawn ticket")
    check(not level.around_done(spawn, SPAWN_RADIUS), "the chunks around the spawn weren't asked for again")
    println("ok let go")
}

// A holder that unloads while its chunk is read has the generator told nothing wants the chunk
// (D243), once. Handed back unmade, a chunk nothing holds goes, and one whose holder came back
// is asked for again, and loads when it's read.
fn withdrawn() {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = at(0, 0)
    level.add_player(spawn, 1)
    level.pump()
    check(holders(level) > 0, "a player's chunks weren't asked for")
    check_int(i64.wrap(level.dropping_count()), 0, "chunks dropped while they were wanted")
    level.remove_player(spawn, 1)
    level.pump()
    for _ in 0..400 {
        level.tick()
    }
    let reading = holders(level)
    check(reading > 0, "the chunks being read went before they were back")
    check_int(i64.wrap(level.dropping_count()), reading, "chunks being read the generator wasn't told nothing wants")
    // One of them is held again before it's handed back: it's asked for again.
    level.add_player(spawn, 1)
    level.pump()
    check(level.withdrawn(spawn, [], []), "the spawn's chunk wasn't being read")
    check(not level.full(spawn), "a chunk handed back unmade loaded")
    check(level.read_chunk(spawn, [], Loaded.Generate, []), "a chunk held again wasn't asked for again")
    level.remove_player(spawn, 1)
    level.pump()
    for _ in 0..400 {
        level.tick()
    }
    var unmade: i64 = 0
    for x in -14..15 {
        for z in -14..15 {
            if level.withdrawn(at(x, z), [], []) {
                unmade += 1
            }
        }
    }
    check(unmade > 0, "no chunk was handed back unmade")
    check(not level.withdrawn(spawn, [], []), "a chunk was handed back unmade twice")
    check_int(hand_back(mut level, spawn, 14), 0, "chunks still asked for after they were handed back unmade")
    for _ in 0..400 {
        level.tick()
    }
    check_int(holders(level), 0, "chunks kept after they were handed back unmade")
    check_int(i64.wrap(level.dropping_count()), 0, "chunks still dropping after they were handed back")
    println("ok withdrawn")
}

// The light natural spawning reads, `light_value`, from a chunk's light as its packet has it,
// in a world of two sections from 0, so four with the ones below and above: the sky's from the
// section's layer, or the bottom row of the first layer above, or 0 in a section sent empty, or
// 15 above them all; the blocks' from the layer, or 0.
fn light_values() {
    var low = dark_layer()
    put_nibble(mut low, 1, 0, 2, 7)
    put_nibble(mut low, 1, 5, 2, 9)
    put_nibble(mut low, 15, 15, 15, 4)
    var top = dark_layer()
    put_nibble(mut top, 1, 0, 2, 12)
    var lamp = dark_layer()
    put_nibble(mut lamp, 3, 4, 5, 13)
    put_nibble(mut lamp, 2, 4, 5, 6)
    let data = LightData { sky_mask: mask_of(10), block_mask: mask_of(2), empty_sky_mask: [], empty_block_mask: mask_of(4), sky: [low.copy(), top.copy()], block: [lamp.copy()] }
    check_int(i64(light_value(data, true, 0, 2, 1, 5, 2)), 9, "the sky's light in its section")
    check_int(i64(light_value(data, true, 0, 2, 17, 0, 18)), 7, "the sky's light in its section, another chunk's block")
    check_int(i64(light_value(data, true, 0, 2, 15, 15, 15)), 4, "the sky's light at the section's top corner")
    check_int(i64(light_value(data, true, 0, 2, 1, 20, 2)), 12, "the sky's light under a section with no layer")
    check_int(i64(light_value(data, true, 0, 2, 1, -5, 2)), 7, "the sky's light below the world")
    check_int(i64(light_value(data, true, 0, 2, 1, 32, 2)), 12, "the sky's light in the section above the world")
    check_int(i64(light_value(data, true, 0, 2, 1, 40, 2)), 0, "the sky's light up the section above the world")
    check_int(i64(light_value(data, true, 0, 2, 1, 50, 2)), 15, "the sky's light above every section")
    check_int(i64(light_value(data, false, 0, 2, 3, 4, 5)), 13, "the blocks' light, an odd index")
    check_int(i64(light_value(data, false, 0, 2, 2, 4, 5)), 6, "the blocks' light, an even index")
    check_int(i64(light_value(data, false, 0, 2, 3, 20, 5)), 0, "the blocks' light in a section sent empty")
    check_int(i64(light_value(data, false, 0, 2, 3, 40, 5)), 0, "the blocks' light with no layer")
    let empty = LightData { sky_mask: mask_of(8), block_mask: [], empty_sky_mask: mask_of(6), empty_block_mask: [], sky: [top.copy()], block: [] }
    check_int(i64(light_value(empty, true, 0, 2, 1, 20, 2)), 0, "the sky's light in a section sent empty")
    check_int(i64(light_value(empty, true, 0, 2, 1, -5, 2)), 0, "the sky's light under a section sent empty")
    println("ok light_values")
}

// A mask of one byte, as a `BitSet` sends its first eight sections.
fn mask_of(byte: u8) -> List<u8> {
    var mask = List<u8>()
    mask.push(byte)
    return mask
}

// A section's light layer, all 0.
fn dark_layer() -> LightLayer {
    var data = List<u8>()
    for _ in 0..2048 {
        data.push(0)
    }
    return LightLayer { data: data }
}

// Sets the light at `x`, `y`, `z` in the layer, as `DataLayer.set` does.
fn put_nibble(layer: mut LightLayer, x: i32, y: i32, z: i32, value: i32) {
    let index = (y << 8) | (z << 4) | x
    let byte = usize.wrap(index >> 1)
    let shift = (index & 1) * 4
    let other = i32(layer.data[byte]) & (if shift == 0 { 240 } else { 15 })
    layer.data[byte] = u8.wrap(other | (value << shift))
}

// A dimension's saved tickets (D319): given to the level deactivated, they load nothing until
// they're activated, as `prepareLevels` activates them, when a forced chunk's ticket, at 31, has
// the 5 by 5 around it come to a full chunk's level, which the first tick waits for. They're
// saved again, as they're marked, once they've changed.
fn saved_tickets() {
    var level = Level.new(10, 10)
    var lines = List<Entry>()
    let tag = match parse_compound(String("\{data: \{tickets: [\{chunk_pos: [I; 3, 4], type: \"minecraft:forced\", level: 31\}]\}\}")) {
        ok(t) => t,
        err(_) => panic("the saved tickets' SNBT doesn't parse"),
    }
    let root = match tag {
        Tag.Compound(fields) => fields,
        _ => panic("the saved tickets' SNBT isn't a compound"),
    }
    let saved = TicketStorage.parse(root, mut lines) else panic("the saved tickets don't read")
    level.load_tickets(saved)
    level.pump()
    check_int(holders(level), 0, "chunks loaded before the saved tickets are activated")
    let wanted = level.activate_saved_tickets()
    check_int(i64.wrap(wanted.len()), 25, "chunks the forced ticket loads full")
    check(level.all_full(wanted), "the forced chunk's 5 by 5 isn't full in a flat world")
    check(level.entity_ticking(at(3, 4)), "the forced chunk's entities aren't in range to tick")
    check(not level.entity_ticking(at(4, 4)), "the chunk next to the forced chunk is in range for its entities to tick")
    let packed = level.take_dirty_tickets() else panic("the activated tickets aren't marked to be saved")
    check(packed.to_snbt().contains("minecraft:forced"), "the forced ticket isn't saved")
    check(level.take_dirty_tickets() == none, "the tickets are saved again unchanged")
    println("ok saved_tickets")
}

// A block set (D321): it's set in its chunk's own copy, which what's read reads and what's sent
// is made from, while the other flat chunks are still the flat world's; light's told, so the
// light a glowstone gave goes with it; the same state set again, or a block outside the world,
// sets nothing. The blocks set with `UPDATE_CLIENTS` in chunks that tick are given once for the
// broadcast, a section at a time, the chunks in the order they first had one, each block with
// its place in the section and its state as it is now; one set without it isn't.
fn block_changes() {
    let world = FlatWorld.new(flat_blocks(), BlockStates.new([1], [1], 1))
    var level = spawned(LightStates.new())
    let before = level.light_of(at(1, 0)) else panic("the chunk beside the glowstone isn't lit")
    check_int(i64(light_value(before, false, -4, 24, 31, -59, 8)), 14, "the glowstone's light beside it")
    check(level.set_block(32, -59, 8, STONE, UPDATE_ALL), "the glowstone wasn't set to stone")
    check(level.spawn_state(32, -59, 8) == STONE, "the stone set isn't read")
    check(not level.set_block(32, -59, 8, STONE, UPDATE_ALL), "the same state was set again")
    check(not level.set_block(0, 320, 0, STONE, UPDATE_ALL), "a block above the world was set")
    check(not level.set_block(0, -65, 0, STONE, UPDATE_ALL), "a block below the world was set")
    level.pump()
    let after = level.light_of(at(1, 0)) else panic("the chunk beside the glowstone isn't lit once it's gone")
    check(light_value(after, false, -4, 24, 31, -59, 8) < 14, "the glowstone's light stayed once it was stone")
    // Two blocks in the middle flat chunk's section above the grass, and one set without
    // `UPDATE_CLIENTS`.
    check(level.set_block(5, -60, 5, STONE, UPDATE_ALL), "a block in a flat chunk wasn't set")
    check(level.set_block(6, -60, 5, STONE, UPDATE_ALL), "a second block in a flat chunk wasn't set")
    check(level.set_block(7, -60, 5, STONE, UPDATE_NEIGHBORS), "a block set without telling clients wasn't set")
    check(level.spawn_state(5, -60, 5) == STONE, "the block set in a flat chunk isn't read")
    check(level.spawn_state(5, -60, 21) == AIR_STATE, "a block set in a flat chunk was set in another")
    check(differ(whole(level.packet(at(0, 0), world, false)), world.chunk_packet(0, 0)), "a flat chunk with a block set is sent as the flat world's")
    let changes = level.take_changes()
    check_int(i64.wrap(changes.len()), 2, "sections with blocks set")
    check(changes[0].chunk.x == 2 and changes[0].chunk.z == 0 and changes[0].section_y == -4, "the first section with a block set isn't the glowstone's")
    check_int(i64.wrap(changes[0].places.len()), 1, "blocks set in the glowstone's section")
    check_int(i64(changes[0].places[0]), (8 << 4) | 5, "the glowstone's place in its section")
    check_int(i64(changes[0].states[0]), i64(STONE), "the state the glowstone's section's block has")
    check(changes[1].chunk.x == 0 and changes[1].chunk.z == 0 and changes[1].section_y == -4, "the second section with blocks set isn't the flat chunk's")
    check_int(i64.wrap(changes[1].places.len()), 2, "blocks set in the flat chunk's section, told to clients")
    var places = List<i64>()
    for p in changes[1].places {
        places.push(i64(p))
    }
    places.sort()
    check(places[0] == (5 << 8) | (5 << 4) | 4 and places[1] == (6 << 8) | (5 << 4) | 4, "the flat chunk's blocks' places in their section")
    check_int(i64.wrap(level.take_changes().len()), 0, "sections given again")
    println("ok block_changes")
}

// A level's scheduled ticks (D322): a full chunk takes them, one that ticks runs them as they're
// due, and one that isn't full drops them.
fn level_ticks() {
    var level = Level.new(4, 4)
    let player = at(3, -2)
    level.add_player(player, 1)
    level.pump()
    level.game_time = 100
    let x = player.x * 16 + 5
    let z = player.z * 16 + 9
    level.schedule_block_tick(7, x, -60, z, 2, 0)
    level.schedule_block_tick(7, x, -60, z, 1, 0)
    level.schedule_block_tick(8, x, -60, z, 1, -1)
    level.schedule_fluid_tick(1, x + 1, -60, z, 0, 0)
    level.schedule_block_tick(7, x + 4000, -60, z, 1, 0)
    check(level.has_block_tick(7, x, -60, z) and level.has_block_tick(8, x, -60, z), "a ticking chunk has no tick scheduled in it")
    check(not level.has_block_tick(7, x + 4000, -60, z), "a chunk that isn't loaded has a tick scheduled in it")
    let (blocks, fluids) = level.tick_count()
    check_int(i64.wrap(blocks), 2, "block ticks scheduled")
    check_int(i64.wrap(fluids), 1, "fluid ticks scheduled")
    check_int(i64.wrap(level.take_block_ticks().len()), 0, "block ticks due at once")
    let fluid = level.take_fluid_ticks()
    check(fluid.len() == 1 and fluid[0].x == x + 1, "the fluid tick due at once")
    level.game_time = 101
    let first = level.take_block_ticks()
    check(first.len() == 1 and first[0].kind == 8, "the block tick due first")
    level.game_time = 102
    let second = level.take_block_ticks()
    check(second.len() == 1 and second[0].kind == 7 and second[0].sub == 0, "the block tick due next")
    check_int(i64.wrap(level.take_block_ticks().len()), 0, "block ticks left")
    // A chunk 6 out is full, and keeps its tick, but doesn't tick, so it isn't run.
    let edge = player.x * 16 + 6 * 16
    level.schedule_block_tick(7, edge, -60, z, 0, 0)
    check(level.has_block_tick(7, edge, -60, z), "a full chunk has no tick scheduled in it")
    level.game_time = 110
    check_int(i64.wrap(level.take_block_ticks().len()), 0, "block ticks in a chunk that doesn't tick")
    // Leaving lets its chunks go, with their ticks.
    level.remove_player(player, 1)
    level.pump()
    level.tick()
    let (left, _) = level.tick_count()
    check_int(i64.wrap(left), 0, "block ticks once the chunks are gone")
    println("ok level_ticks")
}

fn main() {
    block_changes()
    light_values()
    saved_tickets()
    flat()
    level_ticks()
    spawning()
    reads()
    withdrawn()
    let_go()
    steps()
    light_steps()
    saved_light_kept()
    far()
    prepared()
    saved_lit()
    packed_rest()
    rest_store()
    lit()
    kept()
    println("ok")
}
