/// Checks `world.fireball` (D618): a dragon fireball read from its tag with its acceleration, 0.1
/// where it has none or it isn't a number, its owner and whether it's left them and been shot;
/// saved back the same, its acceleration a double; its reach, its box a block bigger stretched
/// along its motion; and the nearest of what it may hit, as a thrown potion's. And a wind charge
/// (CAL-182): thrown with no acceleration and 5 ticks it can't be deflected; read with 0.1 where
/// its tag has none; 0.3125 across, its box 0.15 below it; its motion kept, in water too; what it
/// hits, an entity where it is, a block 0.25 out of the face it met, none in the air; and
/// bursting where it is once it's more than 30 above the world's top.
module test.fireball

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import rig.registries.{load_vanilla}
import server.log.{Entry}
import world.arrow.{Target}
import world.chunk.{BlockStates}
import world.clip.{BlockHit}
import world.collision.{Aabb}
import world.fireball.{DRAGON_FIREBALL, Fireball, WIND_CHARGE}
import world.thrown.{ThrownHit}
import worldgen.facts.{Facts}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn compound(text: str) -> JavaHashMap<String, Tag> {
    return match parse(String(text)) {
        ok(Tag.Compound(m)) => m.copy(),
        ok(_) => panic("the SNBT isn't a compound"),
        err(e) => panic("the SNBT: {e}"),
    }
}

fn main() {
    var lines = List<Entry>()
    let tag = compound("\{id:\"minecraft:dragon_fireball\",Pos:[1.5d,2.0d,3.5d],Motion:[0.0d,0.0d,0.5d],acceleration_power:0.25d,Owner:[I;1,2,3,4],LeftOwner:1b,HasBeenShot:1b\}")
    let b = Fireball.loaded(DRAGON_FIREBALL, 7, 1103, tag, mut lines) else panic("not read")
    check(b.body.x == 1.5 and b.body.y == 2.0 and b.body.z == 3.5 and b.body.vz == 0.5, "where it is and its motion")
    check(b.acceleration == 0.25 and b.left_owner and b.shot and b.owner != none, "its acceleration, owner, leaving and shot")
    check(b.body.width == 1.0f32 and b.body.height == 1.0f32 and b.data.pack_non_default() == none, "1 by 1, its values their defaults")
    let saved = b.saved()
    let Tag.Compound(m) = saved.copy() else panic("not saved as a compound")
    check(m["acceleration_power"] == Tag.Double(0.25) and m["LeftOwner"] == Tag.Byte(1i8) and m["HasBeenShot"] == Tag.Byte(1i8), "saved with its acceleration")
    check(m["id"] == Tag.Str(String("minecraft:dragon_fireball")), "its type")
    let again = Fireball.loaded(DRAGON_FIREBALL, 8, 1104, m, mut lines) else panic("not read back")
    check(again.saved() == saved, "read back the same")

    // No acceleration, or one that isn't a number: 0.1; never shot, and no owner to leave.
    let plain = Fireball.loaded(DRAGON_FIREBALL, 9, 1105, compound("\{id:\"minecraft:dragon_fireball\",acceleration_power:\"fast\"\}"), mut lines) else panic("plain not read")
    check(plain.acceleration == 0.1 and not plain.shot and not plain.left_owner and plain.owner == none, "0.1, not shot, no owner")
    let Tag.Compound(pm) = plain.saved() else panic("plain not saved")
    check(pm["acceleration_power"] == Tag.Double(0.1) and not pm.contains("LeftOwner") and not pm.contains("Owner"), "saved with 0.1")

    // Its reach: its box, from 1, 2, 3 to 2, 3, 4, stretched half a block south and a block
    // bigger.
    let r = b.reach()
    check(r.min_x == 0.0 and r.min_y == 1.0 and r.min_z == 2.0 and r.max_x == 3.0 and r.max_y == 4.0 and r.max_z == 5.5, "its reach")

    // The nearest it may hit along its way south: the nearer of two blocks, none past where its
    // way stops.
    var way = b.copy()
    way.way = BlockHit { x: 1.5, y: 2.0, z: 6.0, face: 0, bx: 0, by: 0, bz: 0, missed: true }
    let near = Aabb { min_x: 1.0, min_y: 1.5, min_z: 4.0, max_x: 2.0, max_y: 2.5, max_z: 5.0 }
    let far = Aabb { min_x: 1.0, min_y: 1.5, min_z: 5.0, max_x: 2.0, max_y: 2.5, max_z: 5.5 }
    let past = Aabb { min_x: 1.0, min_y: 1.5, min_z: 7.0, max_x: 2.0, max_y: 2.5, max_z: 8.0 }
    let targets: List<Target> = [Target { id: 3, bounds: far, x: 1.5, y: 1.5, z: 5.0, player: false }, Target { id: 2, bounds: near, x: 1.5, y: 1.5, z: 4.5, player: false }, Target { id: 4, bounds: past, x: 1.5, y: 1.5, z: 7.5, player: false }]
    let hit = way.nearest(targets) else panic("nothing hit")
    check(hit.target == 2 and hit.z == 4.0, "the nearer, where its way goes in")
    let missed: List<Target> = [Target { id: 4, bounds: past, x: 1.5, y: 1.5, z: 7.5, player: false }]
    check(way.nearest(missed) == none, "none past where its way stops")
    winds(mut lines)
    println("ok")
}

// A wind charge's make, save, box, motion, hits and burst above the world (CAL-182).
fn winds(lines: mut List<Entry>) {
    let thrown = Fireball.wind_thrown(10, 1106, 0.5, 64.0, 0.5, (5i64, 6i64))
    check(thrown.kind == WIND_CHARGE and thrown.acceleration == 0.0 and thrown.no_deflect == 5 and thrown.owner == some((5i64, 6i64)), "a thrown wind charge's acceleration, deflection and owner")
    check(thrown.type_name() == "minecraft:wind_charge" and thrown.body.width == 0.3125f32 and thrown.body.height == 0.3125f32 and thrown.body.eyes == 0.0f32, "a wind charge's type and size")
    let box = thrown.body.bounding_box()
    let bottom = 64.0 - f64(0.15f32)
    check(box.min_y == bottom and box.max_y == bottom + f64(0.3125f32) and box.min_x == 0.5 - f64(0.15625f32), "a wind charge's box, 0.15 below it")
    let Tag.Compound(ws) = thrown.saved() else panic("a wind charge not saved")
    check(ws["id"] == Tag.Str(String("minecraft:wind_charge")) and ws["acceleration_power"] == Tag.Double(0.0), "a wind charge saved")
    let read = Fireball.loaded(WIND_CHARGE, 11, 1107, compound("\{id:\"minecraft:wind_charge\"\}"), mut lines) else panic("a wind charge not read")
    check(read.acceleration == 0.1 and read.kind == WIND_CHARGE, "a wind charge read with 0.1")
    let back = Fireball.loaded(WIND_CHARGE, 12, 1108, ws, mut lines) else panic("a wind charge not read back")
    check(back.acceleration == 0.0, "a wind charge read back with none")

    let loaded = load_vanilla()!
    let reg = loaded.registries.copy()
    let blocks = reg.find_builtin(String("block")) ?? panic("no blocks")
    let fluids = reg.find_builtin(String("fluid")) ?? panic("no fluids")
    let f = match Facts.new(reg.builtin[blocks].copy(), reg.builtin[fluids].copy(), BlockStates.new([1], [1], 1)) {
        ok(made) => made,
        err(e) => panic("the block facts: {e}"),
    }
    let stone = f.default_state(f.block_named(String("minecraft:stone")) ?? panic("no stone"))
    let air = f.ids.air_state

    // An entity hit: it bursts where it is, the entity its target, even its owner's.
    var at = thrown.copy()
    at.body.vx = 0.0
    at.body.vy = 0.0
    at.body.vz = 1.5
    let met = ThrownHit { target: 3, x: 0.5, y: 64.0, z: 1.0, player: false }
    let struck = at.hit(f, some(met), air, none) else panic("a wind charge hit nothing")
    check(struck.kind == WIND_CHARGE and struck.target == some(3) and struck.x == 0.5 and struck.y == 64.0 and struck.z == 0.5 and struck.motion == (0.0, 0.0, 1.5) and struck.uuid == at.body.uuid, "a wind charge's entity hit")

    // A block met on its north face: it bursts a quarter out of it; in the air, nothing.
    at.way = BlockHit { x: 0.5, y: 64.0, z: 2.0, face: 2, bx: 0, by: 64, bz: 2, missed: false }
    let walled = at.hit(f, none, stone, none) else panic("a wind charge missed the stone")
    check(walled.target == none and walled.x == 0.5 and walled.y == 64.0 and walled.z == 1.75, "a wind charge's burst out of the face")
    check(at.hit(f, none, air, none) == none, "a wind charge hit the air")

    // At a block more than 30 above the top it bursts where it is; at 30, it doesn't.
    var high = thrown.copy()
    high.body.y = 349.5
    check(high.burst_above(319) == none, "a wind charge burst 30 above the top")
    high.body.y = 350.0
    let burst = high.burst_above(319) else panic("a wind charge didn't burst above the top")
    check(burst.target == none and burst.y == 350.0, "a wind charge's burst above the top")
    check(b_dragon().burst_above(319) == none, "a dragon fireball burst above the top")
}

// A dragon fireball far above the world's top.
fn b_dragon() -> Fireball {
    var lines = List<Entry>()
    var b = Fireball.loaded(DRAGON_FIREBALL, 13, 1109, compound("\{id:\"minecraft:dragon_fireball\"\}"), mut lines) else panic("no dragon fireball")
    b.body.y = 400.0
    return b
}
