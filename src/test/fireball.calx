/// Checks `world.fireball` (D618): a dragon fireball read from its tag with its acceleration, 0.1
/// where it has none or it isn't a number, its owner and whether it's left them and been shot;
/// saved back the same, its acceleration a double; its reach, its box a block bigger stretched
/// along its motion; and the nearest of what it may hit, as a thrown potion's.
module test.fireball

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.arrow.{Target}
import world.clip.{BlockHit}
import world.collision.{Aabb}
import world.fireball.{DragonFireball}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn compound(text: str) -> JavaHashMap<String, Tag> {
    return match parse(String(text)) {
        ok(Tag.Compound(m)) => m.copy(),
        ok(_) => panic("the SNBT isn't a compound"),
        err(e) => panic("the SNBT: {e}"),
    }
}

fn main() {
    var lines = List<Entry>()
    let tag = compound("\{id:\"minecraft:dragon_fireball\",Pos:[1.5d,2.0d,3.5d],Motion:[0.0d,0.0d,0.5d],acceleration_power:0.25d,Owner:[I;1,2,3,4],LeftOwner:1b,HasBeenShot:1b\}")
    let b = DragonFireball.loaded(7, 1103, tag, mut lines) else panic("not read")
    check(b.body.x == 1.5 and b.body.y == 2.0 and b.body.z == 3.5 and b.body.vz == 0.5, "where it is and its motion")
    check(b.acceleration == 0.25 and b.left_owner and b.shot and b.owner != none, "its acceleration, owner, leaving and shot")
    check(b.body.width == 1.0f32 and b.body.height == 1.0f32 and b.data.pack_non_default() == none, "1 by 1, its values their defaults")
    let saved = b.saved()
    let Tag.Compound(m) = saved.copy() else panic("not saved as a compound")
    check(m["acceleration_power"] == Tag.Double(0.25) and m["LeftOwner"] == Tag.Byte(1i8) and m["HasBeenShot"] == Tag.Byte(1i8), "saved with its acceleration")
    check(m["id"] == Tag.Str(String("minecraft:dragon_fireball")), "its type")
    let again = DragonFireball.loaded(8, 1104, m, mut lines) else panic("not read back")
    check(again.saved() == saved, "read back the same")

    // No acceleration, or one that isn't a number: 0.1; never shot, and no owner to leave.
    let plain = DragonFireball.loaded(9, 1105, compound("\{id:\"minecraft:dragon_fireball\",acceleration_power:\"fast\"\}"), mut lines) else panic("plain not read")
    check(plain.acceleration == 0.1 and not plain.shot and not plain.left_owner and plain.owner == none, "0.1, not shot, no owner")
    let Tag.Compound(pm) = plain.saved() else panic("plain not saved")
    check(pm["acceleration_power"] == Tag.Double(0.1) and not pm.contains("LeftOwner") and not pm.contains("Owner"), "saved with 0.1")

    // Its reach: its box, from 1, 2, 3 to 2, 3, 4, stretched half a block south and a block
    // bigger.
    let r = b.reach()
    check(r.min_x == 0.0 and r.min_y == 1.0 and r.min_z == 2.0 and r.max_x == 3.0 and r.max_y == 4.0 and r.max_z == 5.5, "its reach")

    // The nearest it may hit along its way south: the nearer of two blocks, none past where its
    // way stops.
    var way = b.copy()
    way.way = BlockHit { x: 1.5, y: 2.0, z: 6.0, face: 0, bx: 0, by: 0, bz: 0, missed: true }
    let near = Aabb { min_x: 1.0, min_y: 1.5, min_z: 4.0, max_x: 2.0, max_y: 2.5, max_z: 5.0 }
    let far = Aabb { min_x: 1.0, min_y: 1.5, min_z: 5.0, max_x: 2.0, max_y: 2.5, max_z: 5.5 }
    let past = Aabb { min_x: 1.0, min_y: 1.5, min_z: 7.0, max_x: 2.0, max_y: 2.5, max_z: 8.0 }
    let targets: List<Target> = [Target { id: 3, bounds: far, x: 1.5, y: 1.5, z: 5.0, player: false }, Target { id: 2, bounds: near, x: 1.5, y: 1.5, z: 4.5, player: false }, Target { id: 4, bounds: past, x: 1.5, y: 1.5, z: 7.5, player: false }]
    let hit = way.nearest(targets) else panic("nothing hit")
    check(hit.target == 2 and hit.z == 4.0, "the nearer, where its way goes in")
    let missed: List<Target> = [Target { id: 4, bounds: past, x: 1.5, y: 1.5, z: 7.5, player: false }]
    check(way.nearest(missed) == none, "none past where its way stops")
    println("ok")
}
