/// Tests of `world.gossip` (CAL-160): gossip added, summed and held to its type's most, a gossip
/// under 2 dropped; a day's decay, by each type's own, dropping what falls under 2 and an entity
/// with nothing left; reputation, each value by its type's weight; and gossip saved as
/// `GossipContainer.CODEC` saves it, its entities in a `HashMap`'s order of their UUIDs, and read
/// back, a list with an entry it can't read as none.
module test.gossip

import nbt.tag.{Tag}
import world.gossip.{Gossips, MAJOR_NEGATIVE, MAJOR_POSITIVE, MINOR_NEGATIVE, MINOR_POSITIVE, TRADING}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// Each entity's gossips, as they're saved: its UUID's low half, each type and value.
fn shown(g: Gossips) -> String {
    var out = String()
    let Tag.List(entries) = g.saved() else panic("gossip saves as a list")
    for e in entries {
        let Tag.Compound(m) = e else panic("each entry a compound")
        let Tag.IntArray(target) = m["Target"] else panic("its target an int array")
        let Tag.Str(kind) = m["Type"] else panic("its type a string")
        out.push_str("{target[3]}:{kind}:{m["Value"].int_value() ?? -1} ")
    }
    return out
}

fn main() {
    let a = (0i64, 1i64)
    let b = (0i64, 0i64)
    var g = Gossips()
    g.add(a, MINOR_NEGATIVE, 25)
    g.add(a, MINOR_NEGATIVE, 25)
    check(shown(g), "1:minor_negative:50 ", "gossip summed")
    for _ in 0..10 {
        g.add(a, MINOR_NEGATIVE, 25)
    }
    check(shown(g), "1:minor_negative:200 ", "gossip held to its type's most")
    g.add(a, TRADING, 1)
    check(shown(g), "1:minor_negative:200 ", "a gossip under 2 dropped")
    g.add(a, TRADING, 2)
    g.add(b, MAJOR_POSITIVE, 20)
    // `b`'s UUID hashes to 0, `a`'s to 1, so a `HashMap` goes over `b` first.
    check(shown(g), "0:major_positive:20 1:minor_negative:200 1:trading:2 ", "entities in a HashMap's order")
    check("{g.reputation(a)} {g.reputation(b)} {g.reputation((5i64, 5i64))}", "-198 100 0", "reputation by weight")

    // A day's decay: minor negative by 20, trading by 2, major positive not at all.
    g.decay()
    check(shown(g), "0:major_positive:20 1:minor_negative:180 ", "a day's decay")
    var h = Gossips()
    h.add(a, MINOR_POSITIVE, 2)
    h.decay()
    check("{h.of.len()}", "0", "an entity with nothing left forgotten")

    // Read back as saved; an entry it can't read reads as none.
    let again = Gossips.read(g.saved())
    check(shown(again), shown(g), "gossip read back")
    var bad = List<Tag>()
    let Tag.List(entries) = g.saved() else panic("gossip saves as a list")
    for e in entries {
        bad.push(e.copy())
    }
    var wrong = JavaHashMap<String, Tag>()
    wrong.insert(String("Type"), Tag.Str(String("major_negative")))
    wrong.insert(String("Value"), Tag.Int(5))
    bad.push(Tag.Compound(wrong))
    check("{Gossips.read(Tag.List(bad)).of.len()}", "0", "an entry without a target reads as none")
    var mixed = Gossips()
    mixed.add(b, MAJOR_NEGATIVE, 25)
    check("{mixed.reputation(b)}", "-125", "major negative weighs 5")
    println("ok")
}
