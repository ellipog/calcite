/// Tests of `world.poi` and `storage.poi`'s sections (CAL-160): records added, each type's in a
/// `HashSet`'s order of their places' hashes, `BlockPos.hashCode`, the same place's record of
/// another type taking a record's place but leaving it in its type's set, as vanilla's does;
/// removed; searched for by chunk, square and range; a ticket taken and given back, by
/// occupancy, a clash's old record's from its type's set; the chunks changed, in the order they
/// were, a chunk read with data among them; a chunk read checked against its blocks,
/// `checkConsistencyWithBlocks`; how far a section is from a village, `sectionsToVillage`; and a
/// section's key as `SectionPos.asLong` packs it.
module test.poi

import server.log.{Entry}
import storage.poi.{PoiChunk, PoiRecord, PoiSection}
import world.poi.{HOME, MEETING, Occupancy, Pois, Scanned, max_tickets, section_key, valid_range}
import world.pos.{BlockPos, ChunkPos}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn at(x: i32, y: i32, z: i32) -> BlockPos {
    return BlockPos { x: x, y: y, z: z }
}

// The types a search wants: those listed.
fn wanting(kinds: List<i32>) -> List<bool> {
    var out = List<bool>()
    for _ in 0..21 {
        out.push(false)
    }
    for k in kinds {
        out[usize.wrap(k)] = true
    }
    return out
}

// The places of `records`, as `x,y,z` each.
fn places(records: List<PoiRecord>) -> String {
    var out = String()
    for r in records {
        out.push_str("{r.pos.x},{r.pos.y},{r.pos.z} ")
    }
    return out
}

// Where `pos` is, as `x,y,z`, or `none`.
fn shown(pos: BlockPos?) -> String {
    let p = pos else return String("none")
    return "{p.x},{p.y},{p.z}"
}

fn main() {
    // `SectionPos.asLong`: 22 bits of x from bit 42, 22 of z from bit 20, 20 of y.
    check("{section_key(1, 2, 3)} {section_key(-1, -4, -1)}", "{(1i64 << 42) | (3i64 << 20) | 2} {(0x3FFFFFi64 << 42) | (0x3FFFFFi64 << 20) | 0xFFFFC}", "section keys")
    check("{max_tickets(0)} {max_tickets(HOME)} {max_tickets(MEETING)} {max_tickets(17)} {valid_range(MEETING)} {valid_range(HOME)}", "1 1 32 0 6 1", "tickets and ranges")

    var lines = List<Entry>()
    var pois = Pois.new(-4, 24)
    check("{pois.add(at(1, 0, 0), HOME, mut lines)}", "false", "nothing added to a chunk not loaded")
    pois.load(ChunkPos { x: 0, z: 0 }, none)
    pois.load(ChunkPos { x: 1, z: 0 }, none)
    // Each type's set goes by its places' hashes, `(y + z * 31) * 31 + x`, a bucket each of 16:
    // (0, 0, 1) hashes to 961, in bucket 1 with (1, 0, 0), before which it came.
    _ = pois.add(at(0, 0, 1), HOME, mut lines)
    _ = pois.add(at(1, 0, 0), HOME, mut lines)
    _ = pois.add(at(5, 0, 0), HOME, mut lines)
    _ = pois.add(at(3, 0, 0), HOME, mut lines)
    _ = pois.add(at(2, 0, 0), MEETING, mut lines)
    _ = pois.add(at(17, 0, 0), HOME, mut lines)
    check("{pois.add(at(3, 0, 0), HOME, mut lines)}", "false", "a record of its type there already")
    check(places(pois.in_chunk(wanting([HOME]), ChunkPos { x: 0, z: 0 }, Occupancy.Any)), "0,0,1 1,0,0 3,0,0 5,0,0 ", "a type's set in its hashes' order")
    // Types by their IDs: homes, 13, then bells, 14.
    check(places(pois.in_chunk(wanting([HOME, MEETING]), ChunkPos { x: 0, z: 0 }, Occupancy.Any)), "0,0,1 1,0,0 3,0,0 5,0,0 2,0,0 ", "types by their IDs")
    check(places(pois.in_square(wanting([HOME]), at(0, 0, 0), 4, Occupancy.Any)), "0,0,1 1,0,0 3,0,0 ", "a square")
    check(places(pois.in_square(wanting([HOME]), at(0, 0, 0), 17, Occupancy.Any)), "0,0,1 1,0,0 3,0,0 5,0,0 17,0,0 ", "a square across chunks")
    check(places(pois.in_range(wanting([HOME]), at(0, 2, 0), 3, Occupancy.Any)), "0,0,1 1,0,0 ", "a range, the square's far corner left out")
    check("{lines.len()}", "0", "nothing logged yet")

    // A ticket taken and given back.
    check(shown(pois.take(wanting([HOME]), some(at(3, 0, 0)), at(0, 0, 0), 8)), "3,0,0", "the bed named taken")
    check(places(pois.in_chunk(wanting([HOME]), ChunkPos { x: 0, z: 0 }, Occupancy.HasSpace)), "0,0,1 1,0,0 5,0,0 ", "those with space")
    check(places(pois.in_chunk(wanting([HOME]), ChunkPos { x: 0, z: 0 }, Occupancy.IsOccupied)), "3,0,0 ", "those occupied")
    check(shown(pois.take(wanting([HOME]), none, at(0, 0, 0), 8)), "0,0,1", "the first with space taken")
    check("{pois.release(at(3, 0, 0)) ?? false} {pois.release(at(3, 0, 0)) ?? true} {pois.release(at(9, 0, 9)) == none}", "true false true", "tickets given back")

    // A record of another type at a record's place takes its place, with vanilla's error, but
    // stays in its old type's set, as vanilla's does; removed, it's taken out of its new type's.
    _ = pois.add(at(5, 0, 0), MEETING, mut lines)
    check("{lines.len()} {pois.type_at(at(5, 0, 0)) ?? -1}", "1 {MEETING}", "a clash")
    check(places(pois.in_chunk(wanting([HOME]), ChunkPos { x: 0, z: 0 }, Occupancy.Any)), "0,0,1 1,0,0 3,0,0 5,0,0 ", "the old record left in its set")
    // A bed taken there takes the old record's ticket, the one its type's set holds.
    check(shown(pois.take(wanting([HOME]), some(at(5, 0, 0)), at(0, 0, 0), 8)), "5,0,0", "the old record taken")
    check("{(pois.record_at(at(5, 0, 0)) ?? PoiRecord { pos: at(0, 0, 0), kind: 0, free_tickets: -1 }).free_tickets}", "32", "the new record's tickets all free")
    check(places(pois.in_chunk(wanting([HOME]), ChunkPos { x: 0, z: 0 }, Occupancy.IsOccupied)), "0,0,1 5,0,0 ", "the old record occupied")
    pois.remove(at(5, 0, 0), mut lines)
    check(places(pois.in_chunk(wanting([MEETING]), ChunkPos { x: 0, z: 0 }, Occupancy.Any)), "2,0,0 ", "the new one taken out of its set")
    check("{pois.type_at(at(5, 0, 0)) == none}", "true", "nothing there")
    pois.remove(at(5, 0, 0), mut lines)
    check("{lines.len()}", "2", "a removal where there's none logs vanilla's error")

    // The chunks changed, each once, in the order they first did.
    var changed = String()
    for c in pois.take_dirty() {
        changed.push_str("{c.x},{c.z} ")
    }
    check(changed, "0,0 1,0 ", "the chunks changed")
    check("{pois.take_dirty().len()}", "0", "none changed since")
    // A chunk as it's saved: its one section with data.
    var with_data = 0
    for s in pois.chunk(ChunkPos { x: 0, z: 0 }).sections {
        if s != none {
            with_data += 1
        }
    }
    check("{with_data}", "1", "a chunk's sections with data")

    // A chunk read with a section is to be saved again, as vanilla counts it upgraded; one
    // read with none isn't.
    var read = Pois.new(-4, 24)
    var sections = List<PoiSection?>()
    for _ in 0..24 {
        sections.push(none)
    }
    var stale = PoiSection.new(false)
    _ = stale.add(PoiRecord { pos: at(33, 0, 0), kind: u32.wrap(HOME), free_tickets: 0 }, mut lines)
    _ = stale.add(PoiRecord { pos: at(36, 0, 0), kind: u32.wrap(HOME), free_tickets: 1 }, mut lines)
    sections[4] = some(stale)
    read.load(ChunkPos { x: 3, z: 0 }, none)
    read.load(ChunkPos { x: 2, z: 0 }, some(PoiChunk { min_section: -4, sections: sections }))
    changed = String()
    for c in read.take_dirty() {
        changed.push_str("{c.x},{c.z} ")
    }
    check(changed, "2,0 ", "a chunk read with data changed")
    // Checked against its blocks: the section that isn't valid made again from them, keeping
    // the record at a place that's still a bed, its ticket taken and all; a section with no
    // data whose blocks may hold one made; and one whose may not, left.
    var scanned = List<Scanned>()
    scanned.push(Scanned { y: 0, may: true, points: [PoiRecord { pos: at(33, 0, 0), kind: u32.wrap(HOME), free_tickets: 1 }, PoiRecord { pos: at(34, 0, 0), kind: u32.wrap(HOME), free_tickets: 1 }] })
    scanned.push(Scanned { y: 1, may: true, points: [PoiRecord { pos: at(35, 16, 0), kind: u32.wrap(MEETING), free_tickets: 32 }] })
    scanned.push(Scanned { y: 2, may: false, points: List<PoiRecord>() })
    read.check(ChunkPos { x: 2, z: 0 }, scanned, mut lines)
    check(places(read.in_chunk(wanting([HOME, MEETING]), ChunkPos { x: 2, z: 0 }, Occupancy.Any)), "33,0,0 34,0,0 35,16,0 ", "made again from its blocks")
    check(places(read.in_chunk(wanting([HOME]), ChunkPos { x: 2, z: 0 }, Occupancy.HasSpace)), "34,0,0 ", "the record kept, its ticket taken")
    var made = 0
    for s in read.chunk(ChunkPos { x: 2, z: 0 }).sections {
        if let section = s {
            if section.valid {
                made += 1
            }
        }
    }
    check("{made} {read.take_dirty().len()} {lines.len()}", "2 1 2", "both valid, the chunk changed")

    // How far from a village: a bed no one's claimed makes none; claimed, its section's a
    // center, and the sections near it as far as 5 sections the most of the three ways; given
    // back, those near it once are 6, and the rest 7.
    var village = Pois.new(-4, 24)
    village.load(ChunkPos { x: 0, z: 0 }, none)
    _ = village.add(at(1, 0, 0), HOME, mut lines)
    check("{village.sections_to_village(0, 0, 0)}", "7", "no village")
    check(shown(village.take(wanting([HOME]), none, at(0, 0, 0), 4)), "1,0,0", "the bed claimed")
    check("{village.sections_to_village(0, 0, 0)} {village.sections_to_village(3, 1, -2)} {village.sections_to_village(5, 0, 0)} {village.sections_to_village(6, 0, 0)} {village.close_to_village(at(20, 0, 0), 1)} {village.close_to_village(at(40, 0, 0), 1)}", "0 3 5 7 true false", "near a village")
    _ = village.release(at(1, 0, 0))
    check("{village.sections_to_village(0, 0, 0)} {village.sections_to_village(5, 5, 5)} {village.sections_to_village(6, 0, 0)}", "6 6 7", "a village gone")
    println("ok")
}
