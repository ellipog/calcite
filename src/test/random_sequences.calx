/// Checks the server's random sequences (CAL-153) against vanilla's, as a probe of vanilla's
/// `RandomSequence` and `RandomSequences` gave them: each sequence's numbers from a world's seed
/// and its name; the salt and what goes into the seed; the dirty mark a draw leaves; the saved
/// data as `RandomSequences.CODEC` writes it; and what it reads, with vanilla's messages, of
/// data that's wrong.
module test.random_sequences

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.random_sequences.{RandomSequences, sequence_of}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn numbers() {
    let seeds: List<i64> = [0, 12345, -4172144997902289642]
    let names = [String("minecraft:blocks/stone"), String("minecraft:blocks/diamond_ore")]
    var got = String()
    for s in seeds {
        for n in names {
            var x = sequence_of(s, some(n.copy()))
            let a = x.next_int()
            let b = x.next_int_below(10)
            let c = x.next_long()
            let d = x.next_float()
            let e = x.next_double()
            got.push_str("{a} {b} {c} {d} {e}\n")
        }
    }
    check(got, "-387380468 6 -5730003522462650654 0.64095324 0.583115322104097\n802687520 8 385155658653361065 0.47257477 0.6129297325744935\n-679324527 6 3287341084594599814 0.22903043 0.9818927234357792\n-45230581 4 7569714020024213671 0.51479733 0.2536641585592031\n-484471827 9 -7973323587396416600 0.7321958 0.7322079523572588\n-1719841609 4 -5101253888555418954 0.642443 0.4460445475390691\n")
}

// A sequence drawn from once, then made with a salt and without the world's seed, then with no
// name, and the data as it's saved, all as vanilla's gave them.
fn sequences() {
    var rs = RandomSequences()
    var g = rs.lend(String("minecraft:blocks/stone"), 99)
    let first = g.next_int()
    check("{rs.dirty}", "false")
    rs.give_back(String("minecraft:blocks/stone"), g)
    check("{first} {rs.dirty}", "149318606 true")
    rs.salt = 7
    rs.include_world_seed = false
    var dirt = rs.lend(String("minecraft:blocks/dirt"), 99)
    check("{dirt.next_int()}", "2047564412")
    rs.give_back(String("minecraft:blocks/dirt"), dirt)
    rs.salt = -3
    rs.include_world_seed = true
    rs.include_sequence_id = false
    var sand = rs.lend(String("minecraft:blocks/sand"), 99)
    check("{sand.next_int()}", "712086639")
    rs.give_back(String("minecraft:blocks/sand"), sand)
    // Lent and given back undrawn, it's the same.
    let again = rs.lend(String("minecraft:blocks/sand"), 99)
    rs.give_back(String("minecraft:blocks/sand"), again)
    check(rs.pack().to_snbt(), "\{include_sequence_id:0b,salt:-3,sequences:\{\"minecraft:blocks/dirt\":\{source:[L;-7940619184884802883L,-2144809765644231699L]\},\"minecraft:blocks/sand\":\{source:[L;-2880078062182631780L,-8818663488184238882L]\},\"minecraft:blocks/stone\":\{source:[L;-8015003892226007766L,859607967966229897L]\}\}\}")
    check("{RandomSequences.fresh().dirty}", "true")
}

// What `text`, the saved data's `data`, reads as: the error logged, or none, then the data as
// it's written again, and whether it's marked to be saved, as fresh data is.
fn read(text: String) -> String {
    let data = parse(text)!
    var root = JavaHashMap<String, Tag>()
    root.insert(String("data"), data)
    var lines = List<Entry>()
    let rs = RandomSequences.load(root, mut lines)
    var out = String()
    for e in lines {
        out.push_str("{e.message}\n")
    }
    if lines.is_empty() {
        out.push_str("none\n")
    }
    out.push_str("{rs.pack().to_snbt()} {rs.dirty}")
    return out
}

fn saved() {
    let fresh = "\{salt:0,sequences:\{\}\} true"
    check(read(String("\{salt:1,sequences:\{\}\}")), "none\n\{salt:1,sequences:\{\}\} false")
    check(read(String("\{sequences:\{\}\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': No key salt in MapLike[\{sequences:\{\}\}]\n{fresh}")
    check(read(String("\{salt:1\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': No key sequences in MapLike[\{salt:1\}]\n{fresh}")
    check(read(String("\{salt:\"x\",sequences:\{\}\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': Not a number\n{fresh}")
    check(read(String("\{salt:1,include_world_seed:\"x\",sequences:\{\}\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': Not a number\n\{salt:1,sequences:\{\}\} false")
    check(read(String("\{salt:1,sequences:5\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': Not a map: 5\n{fresh}")
    check(read(String("\{salt:1,sequences:\{\"minecraft:a\":\{source:[L;1L,2L]\},\"b\":\{source:[L;3L]\},\"C\":\{source:[L;4L,5L]\},\"d\":5,\"e\":\{\},\"f\":\{source:[L;6L,7L,8L]\},\"g\":\{source:[1,2]\},\"h\":\{source:[I;9,10]\},\"i\":\{source:\"x\"\},\"minecraft:j\":\{source:[L;1L,1L]\},\"j\":\{source:[L;2L,2L]\},\"k\":\{source:[\"x\"]\}\}\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': Some elements are not longs: [\"x\"]; Duplicate entry for key: 'minecraft:j'; Not a list; Input is not a list of 2 longs; No key source in MapLike[\{\}]; Not a map: 5; Not a valid resource location: C Non [a-z0-9/._-] character in path of location: minecraft:C; Input is not a list of 2 longs missed input: \{C:\{source:[L;4L,5L]\},b:\{source:[L;3L]\},d:5,e:\{\},f:\{source:[L;6L,7L,8L]\},i:\{source:\"x\"\},k:\{source:[\"x\"]\},\"minecraft:j\":\{source:[L;1L,1L]\}\}\n\{salt:1,sequences:\{\"minecraft:a\":\{source:[L;1L,2L]\},\"minecraft:f\":\{source:[L;6L,7L]\},\"minecraft:g\":\{source:[L;1L,2L]\},\"minecraft:h\":\{source:[L;9L,10L]\},\"minecraft:j\":\{source:[L;2L,2L]\}\}\} false")
    check(read(String("\{salt:\"x\",sequences:\{\"b\":\{source:[L;3L]\}\}\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': Input is not a list of 2 longs missed input: \{b:\{source:[L;3L]\}\}; Not a number\n{fresh}")
    check(read(String("\{salt:1,sequences:\{\"a\":\{source:[L;0L,0L]\}\}\}")), "none\n\{salt:1,sequences:\{\"minecraft:a\":\{source:[L;-7046029254386353131L,7640891576956012809L]\}\}\} false")
    check(read(String("\{salt:1,sequences:\{\"Q\":\{source:[L;3L]\}\}\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': Input is not a list of 2 longs; Not a valid resource location: Q Non [a-z0-9/._-] character in path of location: minecraft:Q missed input: \{Q:\{source:[L;3L]\}\}\n\{salt:1,sequences:\{\}\} false")
    check(read(String("\{salt:1,include_world_seed:\"x\",include_sequence_id:\"y\",sequences:\{\"b\":5\}\}")), "Failed to parse saved data for 'SavedDataType[minecraft:random_sequences]': Not a map: 5 missed input: \{b:5\}; Not a number; Not a number\n\{salt:1,sequences:\{\}\} false")
}

fn main() {
    numbers()
    sequences()
    saved()
    print("ok")
}
