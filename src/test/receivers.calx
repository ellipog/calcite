/// Checks the blocks a signal changes in the server's level, as vanilla's `neighborChanged` changes
/// each (CAL-124), on a flat level whose chunks tick, with block facts made from the built-in block
/// and fluid registries: a door opens both its halves with its sound, a trapdoor and a fence gate
/// open, a copper bulb lights as it's first powered and goes out as it's next powered, a hopper
/// stops, a dispenser and a crafter trigger and, empty, fail four ticks on with their events, the
/// dispenser only as something beside it changes, and a big dripleaf levels.
module test.receivers

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry, Tag as RegistryTag}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Heard, Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{AIR_STATE, BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// The block facts with vanilla's `#rails`, which rails join, and `#wooden_shelves`, which
// shelves chain.
fn rail_facts() -> Facts {
    var blocks = registry(4, "block")
    let rail_names: List<str> = ["rail", "powered_rail", "detector_rail", "activator_rail"]
    add_tag(mut blocks, "rails", rail_names)
    let shelf_names: List<str> = ["acacia_shelf", "bamboo_shelf", "birch_shelf", "cherry_shelf", "crimson_shelf", "dark_oak_shelf", "jungle_shelf", "mangrove_shelf", "oak_shelf", "pale_oak_shelf", "spruce_shelf", "warped_shelf", "poplar_shelf"]
    add_tag(mut blocks, "wooden_shelves", shelf_names)
    return match Facts.new(blocks, registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn add_tag(blocks: mut Registry, name: str, values: List<str>) {
    var ids = List<i32>()
    for n in values {
        let id = blocks.id(full(String(n))) else panic("no {n}")
        ids.push(id)
    }
    blocks.tags.push(RegistryTag { name: full(String(name)), values: ids })
}

// A flat level, its spawn's chunks full and given the facts, with a player at its middle, so
// its chunks tick.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn with(f: Facts, state: u32, prop: str, value: str) -> u32 {
    return match f.with_name(state, String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("no {prop} {value}"),
    }
}

// Runs `ticks` of the level's ticks: its block and fluid ticks, then its block events, then its
// block entities.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.handling = true
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
        level.run_block_events()
        level.handling = false
        level.tick_block_entities()
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn flag(f: Facts, level: Level, x: i32, y: i32, z: i32, prop: str) -> bool {
    return f.get_bool(level.spawn_state(x, y, z), String(prop))
}

// The sounds heard since they were last taken, each with its pitch, volume and source, the level
// events' types, and the block events' two numbers.
struct Heard2 {
    sounds: List<String>
    pitches: List<f32>
    volumes: List<f32>
    sources: List<i32>
    events: List<i32>
    b0: List<i32>
    b1: List<i32>
}

fn heard(level: mut Level) -> Heard2 {
    var out = Heard2 { sounds: List<String>(), pitches: List<f32>(), volumes: List<f32>(), sources: List<i32>(), events: List<i32>(), b0: List<i32>(), b1: List<i32>() }
    for h in level.take_heard() {
        match h {
            Heard.Sound(s) => {
                out.sounds.push(s.sound.copy())
                out.pitches.push(s.pitch)
                out.volumes.push(s.volume)
                out.sources.push(s.source)
            },
            Heard.Event(e) => out.events.push(e.kind),
            Heard.Block(e) => {
                out.b0.push(e.b0)
                out.b1.push(e.b1)
            },
            Heard.Particles(_) => {},
            Heard.Pulse(_) => {},
        }
    }
    return out
}

// The value `key` the block entity at x, y, z saved.
fn kept(level: Level, x: i32, y: i32, z: i32, key: str) -> Tag {
    let tag = level.block_entity_tag(x, y, z) else panic("no block entity at {x} {y} {z}")
    let tags = match tag {
        Tag.Compound(t) => t.copy(),
        _ => panic("the block entity at {x} {y} {z} isn't a compound"),
    }
    if not tags.contains(key) {
        panic("the block entity at {x} {y} {z} saved no {key}")
    }
    return tags[key].copy()
}

fn kept_flag(level: Level, x: i32, y: i32, z: i32, key: str) -> bool {
    return kept(level, x, y, z, key) == Tag.Byte(1)
}

// What the level reported isn't in Calcite yet, one line each.
fn quiet(level: mut Level, what: str) {
    quiet_but(mut level, what, "")
}

// As `quiet`, but for lines with `but` in them, where it isn't empty.
fn quiet_but(level: mut Level, what: str, but: str) {
    var out = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") and (but.is_empty() or not e.message.contains(but)) {
            out = "{out}{e.message}; "
        }
    }
    if not out.is_empty() {
        panic("{what} reported {out}")
    }
}

// An oak door, powered beside its lower half, opens both halves with one sound at a pitch of 0.9
// to 1, and shuts with one as it's let go.
fn door() {
    let f = facts()
    var level = flat_level(f)
    let lower = named(f, "oak_door")
    set(mut level, 4, -60, 4, lower, "the lower half wasn't set")
    set(mut level, 4, -59, 4, with(f, lower, "half", "upper"), "the upper half wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 4, named(f, "redstone_block"), "the redstone block wasn't set")
    check(flag(f, level, 4, -60, 4, "open") and flag(f, level, 4, -60, 4, "powered"), "the lower half isn't open and powered")
    check(flag(f, level, 4, -59, 4, "open") and flag(f, level, 4, -59, 4, "powered"), "the upper half isn't open and powered")
    let opened = heard(mut level)
    check(opened.sounds.len() == 1 and opened.sounds[0] == "block.wooden_door.open", "the door's opening sound")
    check(opened.pitches[0] >= 0.9f32 and opened.pitches[0] < 1.0f32, "the door's pitch")
    set(mut level, 5, -60, 4, AIR_STATE, "the redstone block wasn't taken away")
    check(not flag(f, level, 4, -60, 4, "open") and not flag(f, level, 4, -59, 4, "open"), "the door didn't shut")
    let shut = heard(mut level)
    check(shut.sounds.len() == 1 and shut.sounds[0] == "block.wooden_door.close", "the door's closing sound")
    quiet(mut level, "a door")
    println("ok door")
}

// An oak trapdoor and an oak fence gate open as they're powered, each with its sound, and shut.
fn trapdoor_and_gate() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 6, named(f, "oak_trapdoor"), "the trapdoor wasn't set")
    set(mut level, 8, -60, 6, named(f, "oak_fence_gate"), "the fence gate wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 6, named(f, "redstone_block"), "the trapdoor's redstone block wasn't set")
    check(flag(f, level, 4, -60, 6, "open") and flag(f, level, 4, -60, 6, "powered"), "the trapdoor isn't open")
    let trap = heard(mut level)
    check(trap.sounds.len() == 1 and trap.sounds[0] == "block.wooden_trapdoor.open", "the trapdoor's sound")
    set(mut level, 8, -60, 7, named(f, "redstone_block"), "the gate's redstone block wasn't set")
    check(flag(f, level, 8, -60, 6, "open") and flag(f, level, 8, -60, 6, "powered"), "the fence gate isn't open")
    let gate = heard(mut level)
    check(gate.sounds.len() == 1 and gate.sounds[0] == "block.fence_gate.open", "the fence gate's sound")
    set(mut level, 8, -60, 7, AIR_STATE, "the gate's redstone block wasn't taken away")
    check(not flag(f, level, 8, -60, 6, "open"), "the fence gate didn't shut")
    let gate_shut = heard(mut level)
    check(gate_shut.sounds.len() == 1 and gate_shut.sounds[0] == "block.fence_gate.close", "the fence gate's closing sound")
    quiet(mut level, "a trapdoor and a fence gate")
    println("ok trapdoor_and_gate")
}

// A copper bulb lights as it's powered, stays lit as it's let go, and goes out as it's powered
// again, its sounds at a pitch of 1.
fn copper_bulb() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 8, named(f, "copper_bulb"), "the bulb wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 8, named(f, "redstone_block"), "the redstone block wasn't set")
    check(flag(f, level, 4, -60, 8, "lit") and flag(f, level, 4, -60, 8, "powered"), "the bulb isn't lit")
    let on = heard(mut level)
    check(on.sounds.len() == 1 and on.sounds[0] == "block.copper_bulb.turn_on" and on.pitches[0] == 1.0f32, "the bulb's sound on")
    set(mut level, 5, -60, 8, AIR_STATE, "the redstone block wasn't taken away")
    check(flag(f, level, 4, -60, 8, "lit") and not flag(f, level, 4, -60, 8, "powered"), "the bulb went out as it was let go")
    check(heard(mut level).sounds.is_empty(), "the bulb made a sound as it was let go")
    set(mut level, 5, -60, 8, named(f, "redstone_block"), "the redstone block wasn't set again")
    check(not flag(f, level, 4, -60, 8, "lit"), "the bulb didn't go out")
    let off = heard(mut level)
    check(off.sounds.len() == 1 and off.sounds[0] == "block.copper_bulb.turn_off", "the bulb's sound off")
    quiet(mut level, "a copper bulb")
    println("ok copper_bulb")
}

// A hopper stops as it's powered and goes again as it's let go.
fn hopper() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 10, named(f, "hopper"), "the hopper wasn't set")
    check(flag(f, level, 4, -60, 10, "enabled"), "the hopper isn't enabled")
    set(mut level, 5, -60, 10, named(f, "redstone_block"), "the redstone block wasn't set")
    check(not flag(f, level, 4, -60, 10, "enabled"), "the hopper didn't stop")
    set(mut level, 5, -60, 10, AIR_STATE, "the redstone block wasn't taken away")
    check(flag(f, level, 4, -60, 10, "enabled"), "the hopper didn't go again")
    quiet(mut level, "a hopper")
    println("ok hopper")
}

// An empty dispenser powered beside it triggers, and four ticks on fails with event 1001. Powered
// from above the block over it, it doesn't trigger until something beside it changes.
fn dispenser() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 12, named(f, "dispenser"), "the dispenser wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 12, named(f, "redstone_block"), "the redstone block wasn't set")
    check(flag(f, level, 4, -60, 12, "triggered"), "the dispenser wasn't triggered")
    run(mut level, 3)
    check(heard(mut level).events.is_empty(), "the dispenser fired early")
    run(mut level, 1)
    let fired = heard(mut level)
    check(fired.events.len() == 1 and fired.events[0] == 1001, "the dispenser's failing event")
    set(mut level, 5, -60, 12, AIR_STATE, "the redstone block wasn't taken away")
    check(not flag(f, level, 4, -60, 12, "triggered"), "the dispenser stayed triggered")
    set(mut level, 4, -58, 12, named(f, "redstone_block"), "the redstone block above wasn't set")
    check(not flag(f, level, 4, -60, 12, "triggered"), "the dispenser heard a block two above it")
    set(mut level, 3, -60, 12, named(f, "stone"), "the stone beside wasn't set")
    check(flag(f, level, 4, -60, 12, "triggered"), "the dispenser wasn't triggered from above")
    run(mut level, 4)
    check(heard(mut level).events.len() == 1, "the dispenser didn't fire from above")
    quiet(mut level, "a dispenser")
    println("ok dispenser")
}

// An empty crafter powered triggers, its block entity told, and four ticks on fails with event
// 1050; let go, it's untriggered.
fn crafter() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 14, named(f, "crafter"), "the crafter wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 14, named(f, "redstone_block"), "the redstone block wasn't set")
    check(flag(f, level, 4, -60, 14, "triggered"), "the crafter wasn't triggered")
    check(triggered(level, 4, -60, 14) == 1, "the crafter's block entity wasn't triggered")
    run(mut level, 4)
    let fired = heard(mut level)
    check(fired.events.len() == 1 and fired.events[0] == 1050, "the crafter's failing event")
    set(mut level, 5, -60, 14, AIR_STATE, "the redstone block wasn't taken away")
    check(not flag(f, level, 4, -60, 14, "triggered"), "the crafter stayed triggered")
    check(triggered(level, 4, -60, 14) == 0, "the crafter's block entity stayed triggered")
    quiet(mut level, "a crafter")
    println("ok crafter")
}

fn triggered(level: Level, x: i32, y: i32, z: i32) -> i32 {
    let saved = level.block_entity_tag(x, y, z) else panic("the crafter has no block entity")
    return match saved {
        Tag.Compound(t) => match t["triggered"] {
            Tag.Int(n) => n,
            _ => panic("the crafter's triggered isn't an int"),
        },
        _ => panic("the crafter's block entity isn't a compound"),
    }
}

// A big dripleaf tilted all the way levels as it's powered, with its sound.
fn dripleaf() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 16, with(f, named(f, "big_dripleaf"), "tilt", "full"), "the dripleaf wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 16, named(f, "redstone_block"), "the redstone block wasn't set")
    check(f.get_name(level.spawn_state(4, -60, 16), String("tilt")) == some(String("none")), "the dripleaf didn't level")
    let up = heard(mut level)
    check(up.sounds.len() == 1 and up.sounds[0] == "block.big_dripleaf.tilt_up", "the dripleaf's sound")
    check(up.pitches[0] >= 0.8f32 and up.pitches[0] < 1.2f32, "the dripleaf's pitch")
    quiet(mut level, "a big dripleaf")
    println("ok dripleaf")
}

// A note block on note 7 plays the harp at 2^(-5/12) as its event runs, among the records'
// sounds at volume 3; with a block on it, it doesn't play; with a zombie's head on it, it
// imitates a zombie at a pitch of 1.
fn note_block() {
    let f = facts()
    var level = flat_level(f)
    let note = match f.with_int(named(f, "note_block"), String("note"), 7) {
        ok(s) => s,
        err(_) => panic("no note 7"),
    }
    set(mut level, 4, -60, 18, note, "the note block wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 18, named(f, "redstone_block"), "the redstone block wasn't set")
    check(flag(f, level, 4, -60, 18, "powered"), "the note block isn't powered")
    check(heard(mut level).sounds.is_empty(), "the note played before its event ran")
    run(mut level, 1)
    let played = heard(mut level)
    check(played.b0.len() == 1 and played.b0[0] == 0 and played.b1[0] == 0, "the note block's event")
    check(played.sounds.len() == 1 and played.sounds[0] == "block.note_block.harp", "the harp")
    // `(float) Math.pow(2.0, -5 / 12.0)`, as JDK 25 gives it: 0x3f3fc887.
    check(played.pitches[0] == 0.74915355f32 and played.volumes[0] == 3.0f32 and played.sources[0] == 2, "the harp's pitch, volume and source")
    set(mut level, 5, -60, 18, AIR_STATE, "the redstone block wasn't taken away")
    set(mut level, 4, -59, 18, named(f, "stone"), "the stone on it wasn't set")
    set(mut level, 5, -60, 18, named(f, "redstone_block"), "the redstone block wasn't set again")
    run(mut level, 1)
    check(heard(mut level).b0.is_empty(), "the note block played under stone")
    set(mut level, 8, -60, 18, with(f, named(f, "note_block"), "instrument", "zombie"), "the zombie note block wasn't set")
    set(mut level, 8, -59, 18, named(f, "zombie_head"), "the zombie head wasn't set")
    _ = heard(mut level)
    set(mut level, 9, -60, 18, named(f, "redstone_block"), "the zombie's redstone block wasn't set")
    run(mut level, 1)
    let zombie = heard(mut level)
    check(zombie.sounds.len() == 1 and zombie.sounds[0] == "block.note_block.imitate.zombie" and zombie.pitches[0] == 1.0f32, "the zombie's sound")
    quiet(mut level, "a note block")
    println("ok note_block")
}

// A bell rung by a signal: its sound at once, at volume 2, and its event, toward the north it
// faces, as it runs.
fn bell() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 20, named(f, "bell"), "the bell wasn't set")
    _ = heard(mut level)
    set(mut level, 5, -60, 20, named(f, "redstone_block"), "the redstone block wasn't set")
    check(flag(f, level, 4, -60, 20, "powered"), "the bell isn't powered")
    let rung = heard(mut level)
    check(rung.sounds.len() == 1 and rung.sounds[0] == "block.bell.use" and rung.volumes[0] == 2.0f32 and rung.pitches[0] == 1.0f32, "the bell's sound")
    run(mut level, 1)
    let shook = heard(mut level)
    check(shook.b0.len() == 1 and shook.b0[0] == 1 and shook.b1[0] == 2, "the bell's event")
    // A bell's a meeting place, which comes with villagers.
    quiet_but(mut level, "a bell", "Points of interest")
    println("ok bell")
}

// TNT powered is primed, which comes with entities, and is reported.
fn tnt() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 22, named(f, "tnt"), "the TNT wasn't set")
    set(mut level, 5, -60, 22, named(f, "redstone_block"), "the redstone block wasn't set")
    var primed = false
    for e in level.take_lines() {
        if e.message.contains("Primed TNT") {
            primed = true
        }
    }
    check(primed, "primed TNT wasn't reported")
    println("ok tnt")
}

// A command block powered keeps it and meets its condition, and a tick on, with no command, has
// succeeded at nothing; a conditional one with nothing behind it doesn't meet it.
fn command_block() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 24, named(f, "command_block"), "the command block wasn't set")
    set(mut level, 5, -60, 24, named(f, "redstone_block"), "the redstone block wasn't set")
    check(kept_flag(level, 4, -60, 24, "powered") and kept_flag(level, 4, -60, 24, "conditionMet"), "the command block isn't powered and met")
    run(mut level, 1)
    check(kept(level, 4, -60, 24, "SuccessCount") == Tag.Int(0), "the command block succeeded")
    let conditional = match f.with_bool(named(f, "command_block"), String("conditional"), true) {
        ok(s) => s,
        err(_) => panic("no conditional command block"),
    }
    set(mut level, 8, -60, 24, conditional, "the conditional command block wasn't set")
    set(mut level, 9, -60, 24, named(f, "redstone_block"), "the conditional's redstone block wasn't set")
    check(kept_flag(level, 8, -60, 24, "powered") and not kept_flag(level, 8, -60, 24, "conditionMet"), "the conditional command block met its condition")
    run(mut level, 1)
    set(mut level, 5, -60, 24, AIR_STATE, "the redstone block wasn't taken away")
    check(not kept_flag(level, 4, -60, 24, "powered"), "the command block stayed powered")
    quiet(mut level, "a command block")
    println("ok command_block")
}

// A structure block in save mode, as its state has it, and a test block logging, each keep that
// they're powered, with no name to save and no message to log; one starting a test doesn't.
fn structure_and_test_blocks() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 26, with(f, named(f, "structure_block"), "mode", "save"), "the structure block wasn't set")
    check(kept(level, 4, -60, 26, "mode") == Tag.Str(String("SAVE")), "the structure block's mode isn't its state's")
    set(mut level, 5, -60, 26, named(f, "redstone_block"), "the structure block's redstone block wasn't set")
    check(kept_flag(level, 4, -60, 26, "powered"), "the structure block isn't powered")
    set(mut level, 8, -60, 26, with(f, named(f, "test_block"), "mode", "log"), "the test block wasn't set")
    check(kept(level, 8, -60, 26, "mode") == Tag.Str(String("log")), "the test block's mode isn't its state's")
    set(mut level, 9, -60, 26, named(f, "redstone_block"), "the test block's redstone block wasn't set")
    check(kept_flag(level, 8, -60, 26, "powered"), "the test block isn't powered")
    set(mut level, 12, -60, 26, with(f, named(f, "test_block"), "mode", "start"), "the starting test block wasn't set")
    set(mut level, 13, -60, 26, named(f, "redstone_block"), "the starting test block's redstone block wasn't set")
    check(not kept_flag(level, 12, -60, 26, "powered"), "the starting test block took the power")
    quiet(mut level, "structure and test blocks")
    println("ok structure_and_test_blocks")
}

fn shape(f: Facts, level: Level, x: i32, y: i32, z: i32) -> String {
    return f.get_name(level.spawn_state(x, y, z), String("shape")) ?? String()
}

// Two rails side by side lie east and west; a third south of the first turns it to a corner. A
// rail beside one on a block a step up rises to it.
fn rails() {
    let f = rail_facts()
    var level = flat_level(f)
    let rail = named(f, "rail")
    set(mut level, 4, -60, 30, rail, "the first rail wasn't set")
    set(mut level, 5, -60, 30, rail, "the second rail wasn't set")
    check(shape(f, level, 4, -60, 30) == "east_west" and shape(f, level, 5, -60, 30) == "east_west", "the two rails don't lie east and west")
    set(mut level, 4, -60, 31, rail, "the third rail wasn't set")
    check(shape(f, level, 4, -60, 31) == "north_south", "the third rail doesn't lie north and south")
    check(shape(f, level, 4, -60, 30) == "south_east", "the first rail didn't turn the corner")
    set(mut level, 8, -60, 30, rail, "the low rail wasn't set")
    set(mut level, 9, -60, 30, named(f, "stone"), "the step wasn't set")
    set(mut level, 9, -59, 30, rail, "the high rail wasn't set")
    check(shape(f, level, 9, -59, 30) == "east_west", "the high rail doesn't lie east and west")
    check(shape(f, level, 8, -60, 30) == "ascending_east", "the low rail doesn't rise to the high one")
    quiet(mut level, "rails")
    println("ok rails")
}

// Ten powered rails in a line, a redstone block at the west end: the nine nearest it are powered,
// the tenth too far. Without the block, all go off.
fn powered_rails() {
    let f = rail_facts()
    var level = flat_level(f)
    for x in 4..14 {
        set(mut level, x, -60, 34, named(f, "powered_rail"), "a powered rail wasn't set")
    }
    check(shape(f, level, 8, -60, 34) == "east_west", "the powered rails don't lie east and west")
    set(mut level, 3, -60, 34, named(f, "redstone_block"), "the redstone block wasn't set")
    for x in 4..13 {
        check(flag(f, level, x, -60, 34, "powered"), "a powered rail within reach isn't powered")
    }
    check(not flag(f, level, 13, -60, 34, "powered"), "the tenth powered rail is powered")
    set(mut level, 3, -60, 34, AIR_STATE, "the redstone block wasn't taken away")
    for x in 4..14 {
        check(not flag(f, level, x, -60, 34, "powered"), "a powered rail stayed powered")
    }
    quiet(mut level, "powered rails")
    println("ok powered_rails")
}

// A rail whose ground goes is popped, which drops it, reported.
fn rail_popped() {
    let f = rail_facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 38, named(f, "rail"), "the rail wasn't set")
    set(mut level, 4, -61, 38, AIR_STATE, "the grass under it wasn't taken away")
    check(level.spawn_state(4, -60, 38) == AIR_STATE, "the rail wasn't popped")
    var dropped = false
    for e in level.take_lines() {
        if e.message.contains("What a broken block drops") {
            dropped = true
        }
    }
    check(dropped, "the rail's drop wasn't reported")
    println("ok rail_popped")
}

fn chain(f: Facts, level: Level, x: i32, y: i32, z: i32) -> String {
    return f.get_name(level.spawn_state(x, y, z), String("side_chain")) ?? String()
}

// Four oak shelves facing north, powered one at a time from the west: the first two join, the
// third joins them as their left end, and the fourth's left out of the full chain. Let go, the
// middle one leaves the chain and its neighbours let go of it.
fn shelves() {
    let f = rail_facts()
    var level = flat_level(f)
    for x in 4..8 {
        set(mut level, x, -60, 42, named(f, "oak_shelf"), "a shelf wasn't set")
    }
    _ = heard(mut level)
    for x in 4..8 {
        set(mut level, x, -59, 42, named(f, "redstone_block"), "a redstone block wasn't set")
    }
    check(chain(f, level, 4, -60, 42) == "right" and chain(f, level, 5, -60, 42) == "center" and chain(f, level, 6, -60, 42) == "left", "the three shelves didn't chain")
    check(chain(f, level, 7, -60, 42) == "unconnected", "the fourth shelf joined a full chain")
    let sounds = heard(mut level)
    check(sounds.sounds.len() == 4 and sounds.sounds[0] == "block.shelf.activate", "the shelves' sounds")
    set(mut level, 5, -59, 42, AIR_STATE, "the middle redstone block wasn't taken away")
    check(not flag(f, level, 5, -60, 42, "powered") and chain(f, level, 5, -60, 42) == "unconnected", "the middle shelf stayed in the chain")
    check(chain(f, level, 4, -60, 42) == "unconnected" and chain(f, level, 6, -60, 42) == "unconnected", "the ends didn't let go")
    quiet(mut level, "shelves")
    println("ok shelves")
}

fn main() {
    shelves()
    rails()
    powered_rails()
    rail_popped()
    note_block()
    bell()
    tnt()
    command_block()
    structure_and_test_blocks()
    door()
    trapdoor_and_gate()
    copper_bulb()
    hopper()
    dispenser()
    crafter()
    dripleaf()
    println("ok")
}
