/// Checks server.properties: each setting's default and parsing, as vanilla's
/// `DedicatedServerProperties` reads them, and loading the file as UTF-8 or else ISO-8859-1.
module test.settings

import java.properties.{Properties}
import server.log.{Entry, Level}
import server.properties.{ServerProperties, load}
import std.fs.{temp_dir, is_dir, make_dir_all, remove_dir_all, write}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn bytes(s: String) -> List<u8> {
    var out = List<u8>()
    for i in 0..s.len() {
        out.push(s.byte_at(i))
    }
    return out
}

fn logged(e: Entry?) -> String {
    let entry = e else return "nothing"
    let level = match entry.level {
        Level.Info => "info",
        Level.Warn => "warn",
        Level.Error => "error",
    }
    return "{level}: {entry.message}"
}

fn summary(s: ServerProperties) -> String {
    return "{s.online_mode} [{s.server_ip}] {s.server_port} [{s.motd}] {s.max_players} {s.enable_status} {s.hide_online_players} {s.enforce_secure_profile} {s.accepts_transfers} {s.prevent_proxy_connections} {s.network_compression_threshold} {s.rate_limit} {s.log_ips}"
}

fn main() {
    check(summary(ServerProperties.defaults()), "true [] 25565 [A Minecraft Server] 20 true false true false false 256 0 true")

    // `Boolean.valueOf` takes `true` in any case, and anything else as false. `Integer.parseInt`
    // takes a sign but no spaces, and a value it can't read is the default.
    var p = Properties.new()
    p.set("online-mode", "TRUE")
    p.set("enable-status", "yes")
    p.set("enforce-secure-profile", "")
    p.set("accepts-transfers", "True")
    p.set("server-port", "+25566")
    p.set("max-players", " 5")
    p.set("network-compression-threshold", "-1")
    p.set("rate-limit", "2147483648")
    p.set("server-ip", "127.0.0.1")
    p.set("motd", "")
    check(summary(ServerProperties.from(p)), "true [127.0.0.1] 25566 [] 20 false false false true false -1 0 true")

    let dir = "{temp_dir()!}/calcite-settings-test"
    if is_dir(dir) {
        remove_dir_all(dir)!
    }
    make_dir_all(dir)!

    // No file: the defaults, and vanilla's message.
    var problem: Entry? = none
    let missing = load("{dir}/server.properties", mut problem)!
    check("{missing.len()} {logged(problem)}", "0 error: Failed to load properties from file: {dir}/server.properties")

    // UTF-8.
    let utf8 = "{dir}/utf8.properties"
    write(utf8, bytes("motd=Caf\u{E9} \u{1F600}\nmax-players=7\n"))!
    problem = none
    let loaded = ServerProperties.from(load(utf8, mut problem)!)
    check("{loaded.motd} {loaded.max_players} {logged(problem)}", "Caf\u{E9} \u{1F600} 7 nothing")

    // Not UTF-8, so read again as ISO-8859-1, where each byte is the character it numbers.
    let latin = "{dir}/latin.properties"
    write(latin, [0x6D, 0x6F, 0x74, 0x64, 0x3D, 0x43, 0x61, 0x66, 0xE9, 0x0A])!
    problem = none
    let fallback = ServerProperties.from(load(latin, mut problem)!)
    check("{fallback.motd} {logged(problem)}", "Caf\u{E9} info: Failed to load properties as UTF-8 from file {latin}, trying ISO_8859_1")

    // A malformed `\u` escape stops vanilla from starting.
    let broken = "{dir}/broken.properties"
    write(broken, bytes("motd=\\u12\n"))!
    problem = none
    match load(broken, mut problem) {
        ok(_) => panic("a malformed escape loaded"),
        err(e) => check(e, "Malformed \\uxxxx encoding."),
    }

    remove_dir_all(dir)!
    println("ok")
}
