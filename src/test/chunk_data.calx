/// Checks `storage.chunk`: a chunk read and written and read again, what's dropped on the way,
/// and the errors thrown when it's read and when it's written, with a biome registry of two
/// biomes in place of the data pack's. The rig's `chunk_nbt` probe checks every line, message
/// and byte against vanilla's `SerializableChunkData`.
module test.chunk_data

import nbt.snbt.{parse_compound}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry}
import storage.chunk.{ChunkData, ChunkError, ChunkFormat}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains and desert as the biomes.
fn format() -> ChunkFormat {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    biomes.add(Identifier { namespace: "minecraft", path: "desert" }, some(0))
    return ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
}

// The chunk `snbt` holds, in a world from y -64 to 320.
fn read(f: ChunkFormat, snbt: String, lines: mut List<Entry>) -> ChunkData? ! ChunkError {
    let root = match parse_compound(snbt)! {
        Tag.Compound(tags) => tags,
        _ => panic("not a compound"),
    }
    return try ChunkData.parse(f, -4, 24, root, mut lines)
}

fn thrown(f: ChunkFormat, snbt: String) -> String {
    var lines = List<Entry>()
    match read(f, snbt, mut lines) {
        ok(some(data)) => match data.write(f) {
            ok(_) => return String("nothing"),
            err(e) => return "{e.exception}: {e.message}",
        },
        ok(none) => return String("no chunk"),
        err(e) => return "{e.exception}: {e.message}",
    }
}

// 4,096 values of 4 bits, the first 1 and the rest 0.
fn first_set() -> String {
    var out = String("[L;1L")
    for _ in 1..256 {
        out.push_str(",0L")
    }
    out.push_str("]")
    return out
}

fn bytes(n: usize) -> String {
    var out = String("[B;")
    for i in 0..n {
        out.push_str(if i == 0 { "7b" } else { ",0b" })
    }
    out.push_str("]")
    return out
}

fn main() {
    let f = format()
    let stone = f.states.decode(Tag.Str("minecraft:stone"))!
    var lines = List<Entry>()

    // Without a status string, there's no chunk.
    let empty = read(f, "\{\}", mut lines)!
    check("{empty == none}", "true", "no status")
    let number = read(f, "\{Status: 5\}", mut lines)!
    check("{number == none}", "true", "a status that isn't a string")

    let snbt = "\{Status: \"minecraft:full\", xPos: 3, zPos: -2, yPos: 7, LastUpdate: 7L, extra: 1b, entities: [\{id: \"minecraft:pig\"\}, 5], sections: [\{Y: 0b, block_states: \{palette: [\"minecraft:air\", \"stone\"], data: {first_set()}\}, biomes: \{palette: [\"minecraft:desert\"]\}, SkyLight: {bytes(2048)}\}, \{Y: 1b\}, 7], block_ticks: [\{i: \"minecraft:stone\", x: 48, y: 0, z: -32, t: 1, p: 9\}, \{i: \"minecraft:stone\", x: 0, y: 0, z: 0, t: 1, p: 0\}]\}"
    let data = read(f, snbt, mut lines)! else panic("no chunk")
    check("{lines.len()}", "0", "lines")
    check("{data.pos.x} {data.pos.z} {data.min_section} {data.last_update}", "3 -2 -4 7", "the chunk's place")
    check("{f.statuses.name(data.status)}", "minecraft:full", "status")
    check("{data.sections.len()}", "2", "sections")
    check("{data.entities.len()}", "1", "entities")
    match data.sections[0].blocks {
        some(blocks) => check("{blocks.get_at(0) == stone} {blocks.get_at(1)}", "true 0", "blocks"),
        none => panic("no blocks"),
    }
    match data.sections[0].biomes {
        some(biomes) => check("{f.biomes.name(biomes.get_at(63))}", "minecraft:desert", "biomes"),
        none => panic("no biomes"),
    }
    // A section with nothing saved gets air and plains.
    match data.sections[1].biomes {
        some(biomes) => check("{f.biomes.name(biomes.get_at(0))}", "minecraft:plains", "default biomes"),
        none => panic("no default biomes"),
    }
    // Only the tick in the chunk is kept, its priority clamped.
    check("{data.block_ticks.len()} {data.block_ticks[0].x} {data.block_ticks[0].priority}", "1 48 3", "ticks")

    // Written, a full chunk keeps no entities, and what was read again is written the same.
    let tag = data.write(f)!
    match tag {
        Tag.Compound(tags) => {
            let dropped = not tags.contains("entities") and not tags.contains("extra")
            check("{dropped}", "true", "what's dropped")
            check(tags["DataVersion"].to_snbt(), "5023", "the data version")
            check(tags["yPos"].to_snbt(), "-4", "the lowest section")
        },
        _ => panic("not a compound"),
    }
    let written = tag.to_snbt()
    let again = read(f, written, mut lines)! else panic("no chunk again")
    check(again.write(f)!.to_snbt(), written, "written again")

    // A palette entry that isn't a block is air, logged.
    lines.clear()
    let unknown = read(f, "\{Status: \"minecraft:full\", sections: [\{Y: 0b, block_states: \{palette: [\"minecraft:nope\"]\}\}]\}", mut lines)! else panic("no chunk")
    check("{lines.len()}", "1", "a block that isn't one")
    match unknown.sections[0].blocks {
        some(blocks) => check("{blocks.get_at(0)}", "0", "air in its place"),
        none => panic("no blocks"),
    }

    // What vanilla throws, as it reads and as it writes.
    check(thrown(f, "\{Status: \"minecraft:full\", sections: [\{Y: 99b, BlockLight: [B; 1b]\}]\}"), "IllegalArgumentException: DataLayer should be 2048 bytes not: 1", "light")
    check(thrown(f, "\{Status: \"minecraft:full\", sections: [\{Y: 0b, block_states: \{data: [L; 1L]\}\}]\}"), "ChunkReadException: No key palette in MapLike[\{data:[L;1L]\}]", "no palette")
    check(thrown(f, "\{Status: \"minecraft:full\", sections: [\{Y: 0b, block_states: \{palette: [\"air\", \"stone\"], data: [L; 1L]\}\}]\}"), "ChunkReadException: Failed to read PalettedContainer: Invalid length given for storage, got: 1 but expected: 256", "short data")
    check(thrown(f, "\{Status: \"minecraft:full\", sections: [\{Y: 0b, biomes: \{palette: [\"plains\", \"desert\", \"plains\"], data: [L; 3L, 0L]\}\}]\}"), "MissingPaletteEntryException: Missing Palette entry for index 3.", "a biome past the palette")
    check(thrown(f, "\{Status: \"minecraft:full\", sections: [\{Y: 0b, biomes: \{palette: []\}\}]\}"), "IllegalStateException: Missing Palette entry for id 0.", "no biomes in the palette")
    print("ok")
}
