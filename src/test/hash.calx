/// Checks `hash.crc32c` against CRC-32C's check value, and `hash.ops`' tokens: an empty map and
/// list, a boolean apart from a byte, a map's entries in any order, and a string by its UTF-16
/// units. The `items` probe checks the hashes of whole components against vanilla's (D373).
module test.hash

import hash.crc32c.{crc32c}
import hash.ops.{hash_bool, hash_byte, hash_int_array, hash_list, hash_map, hash_string}

fn check(got: u32, want: u32, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn main() {
    // RFC 3720's check value, the CRC of the ASCII digits 1 to 9.
    check(crc32c([49, 50, 51, 52, 53, 54, 55, 56, 57]), 0xE3069283, "the check value")
    check(crc32c([]), 0, "nothing")
    check(hash_map([]), crc32c([2, 3]), "an empty map")
    check(hash_list([]), crc32c([4, 5]), "an empty list")
    check(hash_bool(true), crc32c([13, 1]), "true")
    check(hash_byte(1i8), crc32c([6, 1]), "a byte")
    if hash_bool(true) == hash_byte(1i8) {
        panic("a boolean hashes as a byte")
    }
    check(hash_int_array([]), crc32c([16, 17]), "an empty int array")
    let a = hash_string(String("a"))
    let b = hash_string(String("b"))
    check(hash_map([(a, b), (b, a)]), hash_map([(b, a), (a, b)]), "a map's order")
    // "é" is one UTF-16 unit, and U+1F600 two.
    check(hash_string(String("é")), crc32c([12, 1, 0, 0, 0, 0xE9, 0]), "a string")
    check(hash_string(String("\u{1F600}")), crc32c([12, 2, 0, 0, 0, 0x3D, 0xD8, 0x00, 0xDE]), "a surrogate pair")
    println("ok")
}
