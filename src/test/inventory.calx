/// Checks `world.inventory` against what vanilla's `Inventory` and `EntityEquipment` make of a
/// player's data: a later stack in a slot in place of an earlier, a slot past 35 and a stack that
/// doesn't read left out, equipment by its slots' names, a name that isn't one left out and a
/// main hand's kept, the inventory menu's slots, and the data written back, with `equipment`
/// where the player holds something, and as it was for data older than 26.3's until a slot
/// changes. The items are read against the built-in registries.
module test.inventory

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import registry.registries.{Registries, builtin_registries}
import world.inventory.{Inventory}
import world.item.{ItemStack}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn data(text: str) -> JavaHashMap<String, Tag> {
    let t = parse(String(text))!
    let Tag.Compound(m) = t else panic("not a compound")
    return m
}

fn shown(t: Tag?) -> String {
    return match t {
        some(x) => x.to_snbt(),
        none => String("-"),
    }
}

fn field(m: JavaHashMap<String, Tag>, key: str) -> String {
    if not m.contains(key) {
        return String("-")
    }
    return m[key].to_snbt()
}

fn main() {
    let items = ItemCodecs.new(Shared(Registries { synced: [], builtin: builtin_registries() }))
    let saved = data("\{Inventory:[\{Slot:0b,id:\"minecraft:stone\",count:5\},\{Slot:9b,id:\"minecraft:diamond_sword\",count:1,components:\{\"minecraft:damage\":3\}\},\{Slot:40b,id:\"minecraft:apple\",count:1\},\{Slot:3b,id:\"minecraft:air\",count:1\},\{Slot:0b,id:\"minecraft:dirt\",count:2\}],equipment:\{head:\{id:\"minecraft:diamond_helmet\",count:1\},offhand:\{id:\"minecraft:shield\",count:1\},nope:\{id:\"minecraft:stone\",count:1\},mainhand:\{id:\"minecraft:stick\",count:1\}\}\}")
    let inv = Inventory.read(saved, items, false)
    check(shown(inv.items[0]), "\{count:2,id:\"minecraft:dirt\"\}", "a later stack in a slot")
    check(shown(inv.items[9]), "\{components:\{\"minecraft:damage\":3\},count:1,id:\"minecraft:diamond_sword\"\}", "a stack with components")
    check(shown(inv.items[3]), "-", "air doesn't read")
    check(shown(inv.menu_slot(36)), "\{count:2,id:\"minecraft:dirt\"\}", "the hotbar in the menu")
    check(shown(inv.menu_slot(9)), "\{components:\{\"minecraft:damage\":3\},count:1,id:\"minecraft:diamond_sword\"\}", "the inventory in the menu")
    check(shown(inv.menu_slot(5)), "\{count:1,id:\"minecraft:diamond_helmet\"\}", "the head in the menu")
    check(shown(inv.menu_slot(45)), "\{count:1,id:\"minecraft:shield\"\}", "the offhand in the menu")
    check(shown(inv.menu_slot(0)), "-", "no crafting result")
    let sword = ItemStack.from_saved(inv.menu_slot(9) ?? Tag.End)
    check("{sword.item} {sword.count} {sword.patch.len()}", "minecraft:diamond_sword 1 1", "a stack for the network")
    var out = JavaHashMap<String, Tag>()
    inv.write(mut out, 0)
    check(field(out, "Inventory"), "[\{Slot:0b,count:2,id:\"minecraft:dirt\"\},\{Slot:9b,components:\{\"minecraft:damage\":3\},count:1,id:\"minecraft:diamond_sword\"\}]", "the inventory written")
    check(field(out, "equipment"), "\{head:\{count:1,id:\"minecraft:diamond_helmet\"\},mainhand:\{count:1,id:\"minecraft:stick\"\},offhand:\{count:1,id:\"minecraft:shield\"\}\}", "the equipment written")
    // Nothing anywhere: an empty list, and no equipment; something held: an empty equipment.
    var empty = JavaHashMap<String, Tag>()
    Inventory.empty().write(mut empty, 0)
    check("{field(empty, "Inventory")} {field(empty, "equipment")}", "[] -", "nothing")
    var holding = Inventory.empty()
    holding.set_menu_slot(36, some(Tag.Compound(data("\{id:\"minecraft:stone\",count:1\}"))))
    var held = JavaHashMap<String, Tag>()
    holding.write(mut held, 0)
    check(field(held, "equipment"), "\{\}", "something held")
    var other = JavaHashMap<String, Tag>()
    holding.write(mut other, 1)
    check(field(other, "equipment"), "-", "something in another slot")
    // Older data is written back as it was, until a slot changes.
    let old = data("\{Inventory:[\{Slot:0b,id:\"minecraft:stone\",Count:5b\}]\}")
    var older = Inventory.read(old, items, true)
    check(shown(older.items[0]), "\{count:1,id:\"minecraft:stone\"\}", "an older stack, its `Count` not 26.3's `count`")
    var kept = JavaHashMap<String, Tag>()
    older.write(mut kept, 0)
    check(field(kept, "Inventory"), "[\{Count:5b,Slot:0b,id:\"minecraft:stone\"\}]", "older data kept")
    older.set_menu_slot(37, some(Tag.Compound(data("\{id:\"minecraft:dirt\",count:1\}"))))
    var changed = JavaHashMap<String, Tag>()
    older.write(mut changed, 0)
    check(field(changed, "Inventory"), "[\{Slot:0b,count:1,id:\"minecraft:stone\"\},\{Slot:1b,count:1,id:\"minecraft:dirt\"\}]", "older data once changed")
    print("ok")
}
