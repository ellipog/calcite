        ],
        sounds: [],
        names: [],
    }
    _ = stand_against(mut a, s, w, 60, want, "lava")
    println("into lava: 60 ticks as the model")
}

// A living entity turned 30 degrees, told to walk ahead at 0.1 and to jump, on stone: it jumps
// every time it lands and may, and steps on stone.
fn walker(s: Setup) {
    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: none, ladder: none }
    var l = Living.made(s.lf, s.kind, 12, 160, 0.5, 1.0, 0.5, 0.5f32, 1.975f32, 1.7775f32, armor_stand_data())
    l.body.y_rot = 30.0f32
    l.body.on_ground = true
    l.speed = 0.1f32
    l.jumping = true
    let want = Want {
        states: [
            1, 4601796162493152338, 4609073930584457216, 4603443278695986202, -4640003925798647179, 4599674017386589685, 4586839140207390786, 0,
            2, 4601137700560848184, 4610574529951628157, 4604013565543183165, -4638417612813656327, 4598108061816866538, 4588464197770284096, 0,
            5, 4598499963349090233, 4612247137844877948, 4606298081571260406, -4636080031148960118, 4569101448040898630, 4590840663544837261, 0,
            10, -4633722403757282999, 4609412605285174773, 4609370843431080349, -4633798269387208127, -4622964760619654472, 4593168286334130067, 0,
            11, -4628903674286229846, 4607728691205870919, 4609978780985001766, -4633597536413598456, -4621687144746895153, 4593515991703361502, 0,
            12, -4625995571738578414, 4607182418800017408, 4610608450124500147, -4633414869402349224, -4633058300709086167, 4593752011758193482, 1,
            20, -4616735222562868814, 4611741016584676900, 4613922826896400691, -4632767899895994521, -4626000674262927107, 4594312345138014704, 0,
            40, -4609707038367038245, 4612060063230219968, 4618838591299118450, -4632814929679967194, 4590650808332220283, 4594271613144393939, 0,
        ],
        sounds: [24, 1041865114, 1065353216, 36, 1041865114, 1065353216],
        names: ["block.stone.step", "block.stone.step"],
    }
    var at: usize = 0
    var heard = Heard { at: [], sounds: [] }
    for tick in 1..=40 {
        l.zza = 1.0f32
        var sounds = List<EntitySound>()
        _ = l.entity_tick(s.lf, s.f, s.t, w, false, mut sounds)
        l.base_tick_end(s.lf, s.f, s.t, w, -64, sounds.len(), List<Follower>())
        _ = l.ai_step(s.lf, s.f, s.m, s.t, w, false, true, mut sounds)
        l.ai_end(s.lf, s.f, s.t, w)
        l.tick_end()
        for e in sounds {
            heard.at.push(tick)
            heard.sounds.push(e.copy())
        }
        compare(l, tick, want, mut at, "walker")
    }
    check(at == want.states.len(), "not every tick of the walker was checked")
    compare_sounds(heard, want, "walker")
    println("walking and jumping: 40 ticks and its steps as the model")
}

// Its speed's instance made as it first ticks, as `removeFrost` asks for it, and sent; then its
// tag as vanilla's, read back the same, with its flags, size and poses.
fn saving(s: Setup) {
    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: none, ladder: none }
    var a = stand(s, 161, 2.5, 1.0, 2.5)
    var sounds = List<EntitySound>()
    a.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, -64, false, List<Follower>(), mut sounds)
    let synced = a.living.attributes.take_synced()
    check(synced.len() == 1 and synced[0].base == 0.7, "an armor stand's first tick sends more than its speed")
    let tag = a.saved()
    let Tag.Compound(m) = tag else panic("an armor stand's tag isn't a compound")
    check(m["id"] == Tag.Str(String("minecraft:armor_stand")) and m["Health"] == Tag.Float(20.0f32) and m["DisabledSlots"] == Tag.Int(0) and m["Small"] == Tag.Byte(0i8), "an armor stand's own fields")
    let Tag.List(attributes) = m["attributes"] else panic("an armor stand's attributes aren't a list")
    check(attributes.len() == 1, "an armor stand saves more attributes than its speed")
    let Tag.Compound(pose) = m["Pose"] else panic("an armor stand's pose isn't a compound")
    check(pose.is_empty(), "an armor stand saves poses it hasn't changed")
    var lines = List<Entry>()
    let back = ArmorStand.loaded(s.lf, s.kind, 7, 7, m, mut lines) ?? panic("an armor stand's tag didn't read back")
    check(back.saved() == tag, "an armor stand's tag read back isn't the same")
    var odd = m.copy()
    odd.insert(String("Small"), Tag.Byte(1i8))
    odd.insert(String("Invisible"), Tag.Byte(1i8))
    odd.insert(String("ShowArms"), Tag.Byte(1i8))
    odd.insert(String("NoGravity"), Tag.Byte(1i8))
    var posed = JavaHashMap<String, Tag>()
    posed.insert(String("Head"), Tag.List([Tag.Float(370.0f32), Tag.Float(-5.0f32), Tag.Float(0.0f32)]))
    odd.insert(String("Pose"), Tag.Compound(posed))
    let small = ArmorStand.loaded(s.lf, s.kind, 8, 8, odd, mut lines) ?? panic("a small armor stand didn't read")
    check(small.small() and small.living.body.width == 0.25f32 and small.living.body.height == 0.9875f32 and small.living.body.eyes == 0.9875f32, "a small armor stand's size")
    check(not small.has_physics() and small.living.body.no_physics, "an armor stand without gravity has physics")
    check(i32(small.living.data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0 and i32(small.living.data.byte(STAND_FLAGS)) == 5, "an armor stand's flags")
    let (hx, hy, hz) = small.living.data.rotations(HEAD_POSE)
    check(hx == 10.0f32 and hy == -5.0f32 and hz == 0.0f32, "an armor stand's head pose isn't within a turn")
    let Tag.Compound(again) = small.saved() else panic("a small armor stand's tag isn't a compound")
    let Tag.Compound(head) = again["Pose"] else panic("a small armor stand's pose isn't a compound")
    check(head.len() == 1 and head["Head"] == Tag.List([Tag.Float(10.0f32), Tag.Float(-5.0f32), Tag.Float(0.0f32)]), "an armor stand's posed head isn't saved")
    check(lines.is_empty(), "loading armor stands logged something")
    var still = small
    let before = state_bits(still.living)
    for _ in 0..5 {
        var heard = List<EntitySound>()
        still.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, -64, false, List<Follower>(), mut heard)
    }
    check(state_bits(still.living) == before, "an armor stand without gravity moved")
    println("saving: an armor stand's tag as vanilla's, read back the same, its flags and poses")
}

// The falling case's stand in a level's entities: ticked in their tick list as it ticks alone,
// its dust kept with its ID before its two fall sounds as it lands at tick 17, found as an armor
// stand but not as an item or orb, and saved as it saves; then its tracker, which runs every 3
// ticks, sends its values only where they changed, and its head's turn where it turned.
fn listed(s: Setup) {
    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: none, ladder: none }
    var store = Entities.new()
    store.add_stand(stand(s, 155, 0.5, 10.0, 0.5))
    var alone = stand(s, 155, 0.5, 10.0, 0.5)
    var landed: i32 = 0
    for tick in 1..=40 {
        var sounds = List<EntitySound>()
        store.tick(s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, mut sounds)
        var heard = List<EntitySound>()
        alone.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, -64, false, List<Follower>(), mut heard)
        check(sounds.len() == heard.len(), "an armor stand in the list heard otherwise than alone")
        let a = store.stand(7)
        check(a.living.body.y == alone.living.body.y and a.living.body.vy == alone.living.body.vy, "an armor stand in the list moved otherwise than alone")
        if not store.shown.is_empty() {
            check(landed == 0 and store.shown_by == [7] and store.shown_after == [0usize] and sounds.len() == 2, "an armor stand's dust wasn't kept with its ID, before its sounds, once")
            let shown = store.take_shown()
            let Shown.Dust(d) = shown[0] else panic("an armor stand landing showed what isn't dust")
            check(d.count == 80 and store.shown.is_empty() and store.shown_by.is_empty(), "the dust taken isn't the stand's, or wasn't taken")
            landed = tick
        }
    }
    check(landed == 17, "an armor stand in the list didn't land at tick 17")
    let b = store.stand(7).living.body.bounding_box()
    check(store.find_any(b, -1).is_empty() and store.is_stand(7) and not store.is_orb(7), "an armor stand's found as an item or orb, or isn't one")
    check(store.saved(7) == alone.saved(), "an armor stand in the list saves otherwise than alone")
    // Its tracker.
    var a = stand(s, 155, 0.5, 1.0, 0.5)
    var tr = Tracker.of_stand(a.living.body, a.living.y_head_rot, a.living.data.pack_non_default())
    check(tr.interval == 3 and tr.range == 10 and tr.values != none, "an armor stand's tracker's interval, range or values")
    var ran = List<i32>()
    for tick in 0..7 {
        var out = List<Sent>()
        let dirty = a.living.data.is_dirty()
        if tick == 4 {
            a.living.y_head_rot = a.living.y_head_rot + 90.0f32
        }
        tr.send_living_changes(mut a.living.body, dirty, a.living.y_head_rot, mut out)
        for o in out {
            match o {
                Sent.Dirty => {
                    ran.push(tick)
                    _ = a.living.data.pack_dirty()
                },
                Sent.Head(h) => check(tick == 6 and h == pack_degrees(a.living.y_head_rot), "an armor stand's head was sent before it ran, or not as it turned"),
                _ => {},
            }
        }
    }
    check(ran == [0, 3, 6], "an armor stand's tracker didn't run every 3 ticks")
    check(tr.add_entity_body(a.living.body, 1).len() > 40, "an armor stand's add_entity is short")
    // Its moves go as its path: as an item's the first run, with no step yet; then a step where
    // it is, 3 ticks on; and where its place is to be synced, as after a bounce, a step there
    // too, and the run no sooner.
    var mover = stand(s, 155, 0.5, 5.0, 0.5)
    var moving = Tracker.of_stand(mover.living.body, mover.living.y_head_rot, mover.living.data.pack_non_default())
    var kinds = List<String>()
    for tick in 0..7 {
        mover.living.body.y = mover.living.body.y - 0.1
        if tick == 4 {
            mover.living.body.sync_position = true
        }
        var out = List<Sent>()
        moving.send_living_changes(mut mover.living.body, false, mover.living.y_head_rot, mut out)
        for o in out {
            match o {
                Sent.Pos(_, ya, _, _) => kinds.push("pos {tick} {ya}"),
                Sent.StepsPos(steps, _) => {
                    var k = "steps {tick}"
                    for st in steps {
                        k.push_str(" {st.ticks}:{st.ya}")
                    }
                    kinds.push(k)
                },
                _ => {},
            }
        }
    }
    let path: List<String> = ["pos 0 -410", "steps 3 3:-1228", "steps 6 1:-410 2:-819"]
    if kinds != path {
        panic("an armor stand's moves aren't its path: {kinds}")
    }
    println("listed: ticked in a level's entities as alone, its dust kept with its ID, tracked every 3 ticks")
}

// A player's body as the server moves it (D421): 0.3 a move east on stone, a step past each
// block and two thirds, `block.stone.step` as loud as a step; none crouched on the ground or
// flying; in water, a swim and the step muffled, a third as loud and 0.8 as high.
fn player_steps(s: Setup) {
    let dry = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: none, ladder: none }
    var l = Living.player_body(s.kind, 7, armor_stand_data())
    l.attributes = Attributes.of_type(s.kind)
    l.refresh_body(s.lf)
    l.body.x = 0.5
    l.body.y = 1.0
    l.body.z = 0.5
    l.body.on_ground = true
    var sounds = List<EntitySound>()
    for _ in 0..12 {
        l.move_self(s.lf, s.f, s.m, s.t, dry, 0.3, 0.0, 0.0, false, mut sounds)
    }
    check(sounds.len() == 2, "a player walking 3.6 blocks on stone didn't step twice")
    check(sounds[0].sound == "block.stone.step" and sounds[0].volume == 0.15f32 and sounds[0].source == 7, "a player's step wasn't stone's")
    l.body.shift = true
    for _ in 0..12 {
        l.move_self(s.lf, s.f, s.m, s.t, dry, 0.3, 0.0, 0.0, false, mut sounds)
    }
    l.body.shift = false
    l.flying = true
    for _ in 0..12 {
        l.move_self(s.lf, s.f, s.m, s.t, dry, 0.3, 0.0, 0.0, false, mut sounds)
    }
    check(sounds.len() == 2, "a player crouched on the ground or flying stepped")
    l.flying = false
    let wet = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: some(state(s.f, "minecraft:water")), ladder: none }
    l.body.in_water = true
    for _ in 0..6 {
        l.move_self(s.lf, s.f, s.m, s.t, wet, 0.3, 0.0, 0.0, false, mut sounds)
    }
    check(sounds.len() == 4, "a player stepping in water didn't swim and step")
    check(sounds[2].sound == "entity.player.swim" and sounds[3].sound == "block.stone.step" and sounds[3].volume == 0.05f32 and sounds[3].pitch == 0.8f32, "a player's step in water wasn't a swim and a muffled step")
    println("a player's steps: on stone, none crouched or flying, muffled in water")
}

// A fall's look along a fast move (D422): an armor stand falling 2 in a tick past the ladder,
// which resets a fall, its fall reset, and beside it not; 0.9 in a tick, under a block, never
// looked along; 3 down toward water, short of its top at eight ninths, not reset, and 3.5 down,
// into it, reset; and a player falling past an end portal reset where a stand isn't.
fn fall_clip(s: Setup) {
    let ladder_state = state(s.f, "minecraft:ladder")
    let stone = state(s.f, "minecraft:stone")
    var t = BodyFacts.new(s.f)
    var resetting = BlockSet.empty(4096)
    resetting.add(s.f.block(ladder_state))
    t.reset.resetting = resetting
    let w = World { stone: stone, floor: stone, fluid: none, ladder: some(ladder_state) }
    check(clipped(s, t, w, 0.5, 12.0, 0.5, -2.0, false), "a fall past a ladder wasn't reset")
    check(not clipped(s, t, w, 3.5, 12.0, 3.5, -2.0, false), "a fall beside a ladder was reset")
    check(not clipped(s, t, w, 0.5, 12.0, 0.5, -0.9, false), "a slow fall past a ladder was reset")
    let wet = World { stone: stone, floor: stone, fluid: some(state(s.f, "minecraft:water")), ladder: none }
    check(not clipped(s, t, wet, 5.5, 7.0, 5.5, -3.0, false), "a fall short of water's top was reset")
    check(clipped(s, t, wet, 5.5, 7.0, 5.5, -3.5, false), "a fall into water wasn't reset")
    let portal = World { stone: stone, floor: stone, fluid: none, ladder: some(state(s.f, "minecraft:end_portal")) }
    check(clipped(s, t, portal, 0.5, 12.0, 0.5, -2.0, true), "a player's fall past an end portal wasn't reset")
    check(not clipped(s, t, portal, 0.5, 12.0, 0.5, -2.0, false), "a stand's fall past an end portal was reset")
    println("a fall's look along a fast move: past a ladder, into water to its height, a player's end portal")
}

// Whether a body at x, y, z that has fallen 5 blocks, moved `dy` through `w` in a tick, a
// `player`'s or not, has its fall reset.
fn clipped(s: Setup, t: BodyFacts, w: World, x: f64, y: f64, z: f64, dy: f64, player: bool) -> bool {
    var l = Living.made(s.lf, s.kind, 12, 160, x, y, z, 0.5f32, 1.975f32, 1.7775f32, armor_stand_data())
    l.body.player = player
    l.body.fall = 5.0
    _ = l.body.collide_move(s.f, s.m, t, w, 0.0, dy, 0.0)
    return l.body.fall == 0.0
}

// What the block a living entity stands on does to it, `stepOn` (D431): a slime block slows it
// across by 0.4 and a fifth of how fast it falls, but not as it falls 0.1 a tick or faster, nor
// for a careful step; magma burns it and redstone ore lights, but not for a careful step, and
// nothing does where it isn't on the ground; a sculk sensor's said to be missing, careful or not.
fn stepped_on(s: Setup) {
    let stone = state(s.f, "minecraft:stone")
    let slime = World { stone: stone, floor: state(s.f, "minecraft:slime_block"), fluid: none, ladder: none }
    var l = Living.made(s.lf, s.kind, 13, 170, 0.5, 1.0, 0.5, 0.5f32, 1.975f32, 1.7775f32, armor_stand_data())
    l.body.on_ground = true
    l.body.vx = 0.5
    l.body.vy = -0.05
    l.body.vz = -0.25
    check(named(l.step_on_block(s.f, s.t, slime)) == "nothing", "a slime block did more than slow")
    let scale = 0.4 + 0.05 * 0.2
    check(l.body.vx == 0.5 * scale and l.body.vz == -0.25 * scale and l.body.vy == -0.05, "a slime block didn't slow it across")
    l.body.vx = 0.5
    l.body.vy = -0.1
    _ = l.step_on_block(s.f, s.t, slime)
    check(l.body.vx == 0.5, "a slime block slowed what fell onto it fast")
    l.body.vy = 0.0
    l.body.shift = true
    _ = l.step_on_block(s.f, s.t, slime)
    check(l.body.vx == 0.5, "a slime block slowed a careful step")
    let magma = World { stone: stone, floor: state(s.f, "minecraft:magma_block"), fluid: none, ladder: none }
    check(named(l.step_on_block(s.f, s.t, magma)) == "nothing", "magma burnt a careful step")
    let ore = World { stone: stone, floor: state(s.f, "minecraft:redstone_ore"), fluid: none, ladder: none }
    check(named(l.step_on_block(s.f, s.t, ore)) == "nothing", "redstone ore was lit by a careful step")
    let sensor = World { stone: stone, floor: state(s.f, "minecraft:sculk_sensor"), fluid: none, ladder: none }
    check(named(l.step_on_block(s.f, s.t, sensor)) == "missing", "a careful step on a sculk sensor wasn't said to be missing")
    l.body.shift = false
    check(named(l.step_on_block(s.f, s.t, magma)) == "magma", "magma didn't burn")
    check(named(l.step_on_block(s.f, s.t, ore)) == "ore 0 0 0", "redstone ore wasn't lit")
    l.body.on_ground = false
    check(named(l.step_on_block(s.f, s.t, magma)) == "nothing", "magma burnt what wasn't on the ground")
    println("blocks stepped on: slime blocks slowing, magma burning, redstone ore lit, careful steps")
}

// What's inside blocks acting on a living entity (D434): a move of 2 east through fire meets the
// blocks its box goes through once each, those where it began first, then those it goes into step
// by step, and lights it for 8 seconds, each step's thawing, lighting and hurts in order; water
// puts it out, heard, and its fire's then none, a player's waiting 20 ticks.
fn inside(s: Setup) {
    let stone = state(s.f, "minecraft:stone")
    let fire = World { stone: stone, floor: stone, fluid: some(state(s.f, "minecraft:fire")), ladder: none }
    let moves: List<Movement> = [Movement { from: (0.5, 1.0, 0.5), to: (2.5, 1.0, 0.5), asked: some((2.0, 0.0, 0.0)) }]
    let met = inside_blocks(s.f, fire, moves, 0.5f32, 1.975f32)
    var places = String()
    for i in met {
        places = "{places}{i.x},{i.y},{i.z}@{i.step} "
    }
    check(places == "0,1,0@0 0,2,0@0 1,1,0@1 1,2,0@1 2,1,0@2 2,2,0@2 ", "a move through fire met other blocks, or in other steps")
    var l = Living.made(s.lf, s.kind, 14, 171, 2.5, 1.0, 0.5, 0.5f32, 1.975f32, 1.7775f32, armor_stand_data())
    var c = Collector()
    for i in met {
        c.advance(i.step)
        _ = l.touch(s.f, i, mut c)
    }
    var order = String()
    for e in c.finish() {
        match e {
            BlockEffect.Apply(kind) => {
                order = "{order}{kind} "
                l.apply_effect(kind, 0)
            },
            BlockEffect.InFire(amount) => {
                order = if amount == 1.0f32 { "{order}hurt 1 " } else { "{order}hurt ? " }
            },
            _ => {
                order = "{order}? "
            },
        }
    }
    let step = "1 2 hurt 1 hurt 1 "
    check(order == "{step}{step}{step}", "fire's effects came in another order")
    check(l.body.fire == 160, "fire didn't light it for 8 seconds")
    let wet = World { stone: stone, floor: stone, fluid: some(state(s.f, "minecraft:water")), ladder: none }
    let still: List<Movement> = [Movement { from: (2.5, 1.0, 0.5), to: (2.5, 1.0, 0.5) }]
    let was = l.fire_before()
    var d = Collector()
    for i in inside_blocks(s.f, wet, still, 0.5f32, 1.975f32) {
        d.advance(i.step)
        check(i.fluid, "it wasn't in the water it met")
        fluid_effects(s.f, i, mut d)
    }
    for e in d.finish() {
        if let BlockEffect.Apply(kind) = e {
            l.apply_effect(kind, 0)
        }
    }
    var sounds = List<EntitySound>()
    l.after_inside(was, false, mut sounds)
    check(sounds.len() == 1 and sounds[0].sound == "entity.generic.extinguish_fire", "water put it out unheard")
    check(l.body.fire == 0, "its fire wasn't none once put out")
    l.body.player = true
    let out = l.fire_before()
    l.after_inside(out, false, mut sounds)
    check(l.body.fire == -20, "a player's fire didn't wait 20 ticks")
    println("inside blocks: a move's blocks in steps, fire lighting, water putting out")
}

// What a step gave back, as a word.
fn named(stepped: Stepped) -> String {
    return match stepped {
        Stepped.Nothing => String("nothing"),
        Stepped.Magma => String("magma"),
        Stepped.Ore((x, y, z)) => "ore {x} {y} {z}",
        Stepped.Missing(_) => String("missing"),
    }
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    let t = BodyFacts.new(f)
    var lf = LivingFacts.new(f)
    let ladder_block = f.block_named(String("minecraft:ladder")) ?? panic("no ladder")
    var climbable = BlockSet.empty(4096)
    climbable.add(ladder_block)
    lf.climbable = climbable
    let kinds = builtin_entries(6)
    var kind: u32? = none
    for i in 0..kinds.len() {
        if kinds[i] == "armor_stand" {
            kind = some(u32.wrap(i))
        }
    }
    let s = Setup { f: f, m: m, t: t, lf: lf, kind: kind ?? panic("no armor stand type") }
    made(s)
    falling(s)
    ice(s)
    ladder(s)
    water(s)
    lava(s)
    walker(s)
    saving(s)
    listed(s)
    player_steps(s)
    fall_clip(s)
    stepped_on(s)
    inside(s)
    println("ok")
}
