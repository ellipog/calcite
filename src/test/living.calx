    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: some(state(s.f, "minecraft:lava")), ladder: none }
    var a = stand(s, 159, 0.5, 5.0, 0.5)
    let want = Want {
        states: [
            1, 4602678819172646912, 4617315517961601024, 4602678819172646912, 0, -4633058300709086167, 0, 0,
            5, 4602678819172646912, 4616450290676893466, 4602678819172646912, 0, -4622915645050774002, 0, 0,
            10, 4602678819172646912, 4613782071927131175, 4602678819172646912, 0, -4633990105053084982, 0, 0,
