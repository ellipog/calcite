/// Checks living entities, `world.living` (CAL-155): an armor stand falling onto stone, its fall
/// sounds and the dust it throws up; sliding on ice, slowed as ice slows it, with its steps; sliding
/// down a ladder no faster than 0.15 a tick, with its steps; falling into water, its splash, and
/// sinking; falling into lava and sinking; and a living entity walking where it's turned and
/// jumping on stone, each to the bit against a model of vanilla's `LivingEntity` written apart from
/// Calcite's, [`living_model.py`](living_model.py), which prints what this checks. Then an armor
/// stand's values as it's made and paired, its speed's instance made as it first ticks, and its
/// saved tag, read back, with its flags, size and poses; one in a level's entities, ticked in their
/// tick list, what it shows kept with its ID; and its tracker. Last a player's body as the server
/// moves them, its steps on stone and in water, and none crouched on the ground or flying (D421);
/// and a fall reset by what a fast move passes through (D422).
module test.living

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.attributes.{Attributes, Wearing}
import world.body.{BodyFacts, EntitySound}
import world.chunk.{BlockStates}
import world.collision.{CollisionBlocks}
import world.entities.{EntityTicking, Entities, StackSizes}
import world.experience_orb.{Follower}
import world.entity_data.{HEAD_POSE, INVISIBLE_FLAG, SHARED_FLAGS, STAND_FLAGS, armor_stand_data}
import world.item_tracker.{Sent, Tracker, pack_degrees}
import world.inside.{BlockEffect, Collector, fluid_effects, inside_blocks, Movement, Rain}
import world.living.{ArmorStand, Living, LivingFacts, Shown, Stepped, Warding}
import world.loot.{LootParams}
import world.mob.{MobLight}
import world.movement.{MovementStates}
import world.navigation.{NavLevel, SentBlock}
import worldgen.facts.{BlockSet, Facts}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn state(f: Facts, name: str) -> u32 {
    let b = f.block_named(String(name)) ?? panic("no {name}")
    return f.default_state(b)
}

// Stone below y 0, `floor` at it, and above it air but where there's `fluid`, at y 1 to 3, or a
// ladder, at x 0 and z 0 from y 1 to 10; loaded everywhere near.
struct World {
    stone: u32
    floor: u32
    fluid: u32?
    ladder: u32?
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -64 or x >= 64 or z < -64 or z >= 64 {
            return none
        }
        if y < 0 {
            return some(self.stone)
        }
        if y == 0 {
            return some(self.floor)
        }
        if let s = self.fluid {
            if y <= 3 {
                return some(s)
            }
        }
        if let s = self.ladder {
            if x == 0 and z == 0 and y <= 10 {
                return some(s)
            }
        }
        return some(0)
    }
}

impl EntityTicking for World {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool {
        return chunk_x >= -4 and chunk_x < 4 and chunk_z >= -4 and chunk_z < 4
    }

    fn listed(self, chunk_x: i32, chunk_z: i32) -> bool {
        return self.ticks_entities(chunk_x, chunk_z)
    }
}

impl Rain for World {
    fn rains_on(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }
}

impl MobLight for World {
    fn magic_light(self, x: i32, y: i32, z: i32) -> f32 {
        _ = x + y + z
        return 0.0f32
    }

    fn monsters_burn(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }

    fn sees_sky(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return true
    }
}

impl Warding for World {
    fn protection(self, worn: List<Tag?>, params: LootParams) -> (f32, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (0.0f32, List<String>())
    }

    fn immune(self, worn: List<Tag?>, params: LootParams) -> (bool, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (false, List<String>())
    }
}

impl NavLevel for World {
    fn level_time(self) -> i64 {
        return 0
    }

    fn top_y(self) -> i32 {
        return 319
    }

    fn sent_first(self) -> u64 {
        return 0
    }

    fn sent_total(self) -> u64 {
        return 0
    }

    fn sent_at(self, i: u64) -> SentBlock {
        return SentBlock { x: i32.wrap(i), y: 0, z: 0, old: 0, now: 0 }
    }
}

// Every stack a whole stack at 64, which no armor stand reads.
struct Sizes {}

impl StackSizes for Sizes {
    fn stack_most(self, stack: Tag) -> i32 {
        return if stack == Tag.End { 0 } else { 64 }
    }
}

impl Wearing for Sizes {
    fn worn_component(self, stack: Tag, name: String) -> Tag? {
        _ = stack
        _ = name
        return none
    }

    fn worn_types(self, set: Tag) -> List<i32> {
        _ = set
        return List<i32>()
    }

    fn worn_enchantments(self, stack: Tag) -> List<(i32, JavaHashMap<String, Tag>)> {
        _ = stack
        return List<(i32, JavaHashMap<String, Tag>)>()
    }
}

// What the cases run with.
struct Setup {
    f: Facts
    m: MovementStates
    t: BodyFacts
    lf: LivingFacts
    kind: u32
}

fn bits(v: f64) -> i64 {
    return i64.wrap(v.to_bits())
}

fn state_bits(l: Living) -> List<i64> {
    return [bits(l.body.x), bits(l.body.y), bits(l.body.z), bits(l.body.vx), bits(l.body.vy), bits(l.body.vz), if l.body.on_ground { 1 } else { 0 }]
}

// What a case is checked against: each tick checked with its seven numbers, and each sound's
// tick, volume and pitch, with its name.
struct Want {
    states: List<i64>
    sounds: List<i64>
    names: List<str>
}

// What a case heard and saw: each sound with the tick it was heard.
struct Heard {
    at: List<i32>
    sounds: List<EntitySound>
}

// Its tick checked against the model's, `want.states` eight numbers a tick checked.
fn compare(l: Living, tick: i32, want: Want, at: mut usize, what: str) {
    if at < want.states.len() and want.states[at] == i64(tick) {
        let got = state_bits(l)
        for k in 0..got.len() {
            if got[k] != want.states[at + 1 + k] {
                panic("{what}, tick {tick}: {l.body.x} {l.body.y} {l.body.z} moving {l.body.vx} {l.body.vy} {l.body.vz}, on the ground {l.body.on_ground}, differs from the model at {k}")
            }
        }
        at += 8
    }
}

// The sounds heard against the model's.
fn compare_sounds(heard: Heard, want: Want, what: str) {
    if heard.sounds.len() != want.names.len() {
        panic("{what}: {heard.sounds.len()} sounds, the model {want.names.len()}")
    }
    for i in 0..heard.sounds.len() {
        let s = heard.sounds[i].copy()
        let tick = i64(heard.at[i])
        let volume = i64(s.volume.to_bits())
        let pitch = i64(s.pitch.to_bits())
        if s.sound != String(want.names[i]) or tick != want.sounds[i * 3] or volume != want.sounds[i * 3 + 1] or pitch != want.sounds[i * 3 + 2] {
            panic("{what}: sound {i}, {s.sound} at tick {tick}, {s.volume} {s.pitch}, isn't the model's")
        }
    }
}

// An armor stand's ticks against the model's.
fn stand_against(a: mut ArmorStand, s: Setup, w: World, ticks: i32, want: Want, what: str) -> Heard {
    var at: usize = 0
    var heard = Heard { at: [], sounds: [] }
    for tick in 1..=ticks {
        var sounds = List<EntitySound>()
        a.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, -64, false, List<Follower>(), mut sounds)
        for e in sounds {
            heard.at.push(tick)
            heard.sounds.push(e.copy())
        }
        compare(a.living, tick, want, mut at, what)
    }
    check(at == want.states.len(), "not every tick of the model was checked")
    compare_sounds(heard, want, what)
    return heard
}

fn stand(s: Setup, seed: i64, x: f64, y: f64, z: f64) -> ArmorStand {
    return ArmorStand.new(s.lf, s.kind, 7, seed, x, y, z)
}

// Made with seed 155: its turn drawn after its UUID, its health its most, sent as it's paired.
fn made(s: Setup) {
    let a = stand(s, 155, 0.5, 10.0, 0.5)
    check(i64(a.living.body.y_rot.to_bits()) == 1078705807 and a.living.y_head_rot == a.living.body.y_rot, "an armor stand's turn isn't vanilla's")
    check(a.living.health() == 20.0f32 and a.living.data.is_dirty(), "an armor stand's health isn't its most, to be sent")
    let paired = a.living.data.pack_non_default() ?? panic("an armor stand has nothing to pair with")
    let health: List<u8> = [9, 3, 65, 160, 0, 0, 255]
    check(paired == health, "an armor stand pairs with more than its health")
    check(a.living.body.width == 0.5f32 and a.living.body.height == 1.975f32 and a.has_physics(), "an armor stand's size or physics")
    println("made: its turn and health")
}

// Falling 9 blocks onto stone: its fall sounds, an armor stand's and stone's, and 80 specks of
// stone's dust where it lands, at tick 17.
fn falling(s: Setup) {
    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: none, ladder: none }
    var a = stand(s, 155, 0.5, 10.0, 0.5)
    let want = Want {
        states: [
            1, 4602678819172646912, 4621819117588971520, 4602678819172646912, 0, -4633058300709086167, 0, 0,
            5, 4602678819172646912, 4621386503946617741, 4602678819172646912, 0, -4622915645050774002, 0, 0,
            10, 4602678819172646912, 4619177451983986912, 4602678819172646912, 0, -4618737982863350984, 0, 0,
            13, 4602678819172646912, 4616540461083885159, 4602678819172646912, 0, -4617041407699047619, 0, 0,
            14, 4602678819172646912, 4614852451710398975, 4602678819172646912, 0, -4616498351300388972, 0, 0,
            15, 4602678819172646912, 4612677835208121370, 4602678819172646912, 0, -4616077887037051959, 0, 0,
            20, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4633058300709086167, 0, 1,
            40, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4633058300709086167, 0, 1,
        ],
        sounds: [17, 1065353216, 1065353216, 17, 1056964608, 1061158912],
        names: ["entity.armor_stand.fall", "block.stone.fall"],
    }
    _ = stand_against(mut a, s, w, 40, want, "falling")
    check(a.living.shown.len() == 1 and a.living.shown_after == [0usize], "an armor stand landing showed nothing, or more, or not before its sounds")
    let Shown.Dust(d) = a.living.shown[0] else panic("an armor stand landing showed what isn't dust")
    check(d.state == w.stone and d.count == 80 and bits(d.x) == 4602678819172646912 and bits(d.y) == 4607182418800017408 and bits(d.z) == 4602678819172646912, "an armor stand's dust isn't the model's")
    println("falling onto stone: 40 ticks, its fall sounds and dust as the model")
}

// Sliding on ice at 0.6 a tick: slowed as ice slows it, with glass's steps.
fn ice(s: Setup) {
    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:ice"), fluid: none, ladder: none }
    var a = stand(s, 156, 0.5, 1.0, 0.5)
    a.living.body.on_ground = true
    a.living.body.vx = 0.6
    let want = Want {
        states: [
            1, 4607632778762754458, 4607182418800017408, 4602678819172646912, 4602994791970924134, -4633058300709086167, 0, 0,
            2, 4610042564975578317, 4607182418800017408, 4602678819172646912, 4602443241985381401, -4633058300709086167, 0, 1,
            10, 4616566655461616264, 4607182418800017408, 4602678819172646912, 4596186609596430799, -4633058300709086167, 0, 1,
            30, 4618388522898702294, 4607182418800017408, 4602678819172646912, 4581341686781220916, -4633058300709086167, 0, 1,
            60, 4618564450859926200, 4607182418800017408, 4602678819172646912, 0, -4633058300709086167, 0, 1,
        ],
        sounds: [4, 1041865114, 1065353216, 8, 1041865114, 1065353216, 20, 1041865114, 1065353216],
        names: ["block.glass.step", "block.glass.step", "block.glass.step"],
    }
    _ = stand_against(mut a, s, w, 60, want, "ice")
    println("sliding on ice: 60 ticks and its steps as the model")
}

// Sliding down a ladder from 7 above the stone: no faster than 0.15 a tick, its fall forgotten
// as it climbs, so landing is unheard, with the ladder's steps.
fn ladder(s: Setup) {
    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: none, ladder: some(state(s.f, "minecraft:ladder")) }
    var a = stand(s, 157, 0.5, 8.0, 0.5)
    let want = Want {
        states: [
            1, 4602678819172646912, 4620693217682128896, 4602678819172646912, 0, -4633058300709086167, 0, 0,
            2, 4602678819172646912, 4620604947127714447, 4602678819172646912, 0, -4628611194182664847, 0, 0,
            5, 4602678819172646912, 4620098292149502607, 4602678819172646912, 0, -4626083125347657707, 0, 0,
            10, 4602678819172646912, 4619253867185816207, 4602678819172646912, 0, -4626083125347657707, 0, 0,
            30, 4602678819172646912, 4615562716607382814, 4602678819172646912, 0, -4626083125347657707, 0, 0,
            47, 4602678819172646912, 4607955235281242684, 4602678819172646912, 0, -4626083125347657707, 0, 0,
            48, 4602678819172646912, 4607279695310293564, 4602678819172646912, 0, -4626083125347657707, 0, 0,
            49, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4633058300709086167, 0, 1,
            50, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4633058300709086167, 0, 1,
            70, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4633058300709086167, 0, 1,
        ],
        sounds: [13, 1041865114, 1065353216, 24, 1041865114, 1065353216, 35, 1041865114, 1065353216, 46, 1041865114, 1065353216],
        names: ["block.ladder.step", "block.ladder.step", "block.ladder.step", "block.ladder.step"],
    }
    _ = stand_against(mut a, s, w, 70, want, "ladder")
    check(a.living.shown.is_empty(), "an armor stand off a ladder threw up dust")
    check(a.living.last_climbable == none, "an armor stand on the ground still climbs")
    println("down a ladder: 70 ticks and its steps as the model")
}

// Falling 2 blocks into water 3 deep: its splash, then sinking, held up as water holds it.
fn water(s: Setup) {
    let w = World { stone: state(s.f, "minecraft:stone"), floor: state(s.f, "minecraft:stone"), fluid: some(state(s.f, "minecraft:water")), ladder: none }
    var a = stand(s, 158, 0.5, 6.0, 0.5)
    let want = Want {
        states: [
            1, 4602678819172646912, 4618441417868443648, 4602678819172646912, 0, -4633058300709086167, 0, 0,
            5, 4602678819172646912, 4617576190583736090, 4602678819172646912, 0, -4622915645050774002, 0, 0,
            10, 4602678819172646912, 4613158086658474431, 4602678819172646912, 0, -4620455724182946866, 0, 0,
            15, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4650957407178058629, 0, 1,
            20, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4650957407178058629, 0, 1,
            40, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4650957407178058629, 0, 1,
            80, 4602678819172646912, 4607182418800017408, 4602678819172646912, 0, -4650957407178058629, 0, 1,
        ],
        sounds: [9, 1039113891, 1065827587],
        names: ["entity.generic.splash"],
    }
    _ = stand_against(mut a, s, w, 80, want, "water")
    check(a.living.air() == 300 and a.living.shown.is_empty(), "an armor stand ran out of air")
    println("into water: 80 ticks and its splash as the model, its air kept")
}

