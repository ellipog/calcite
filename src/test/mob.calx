import worldgen.facts.{Facts}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, their only tag `causes_suffocation`, of stone, glass and farmland, which the
// wall test reads (D425).
fn facts() -> Facts {
    var blocks = registry(4, "block")
    var held = List<i32>()
    for name in ["stone", "glass", "farmland"] {
        held.push(blocks.id(full(String(name))) ?? panic("no {name}"))
    }
    blocks.tags.push(RegistryTag { name: full(String("causes_suffocation")), values: held })
    return match Facts.new(blocks, registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// Stone below y 1, air above, or `water` from y 1 to 3 where there's some, and `head` at y 2
// where there's one; loaded everywhere near, its light at a mob's eyes `lit` and monsters burning
// in it where `burn`.
struct World {
    stone: u32
    lit: f32 = 0.0f32
    burn: bool = false
    water: u32? = none
    head: u32? = none
    open: bool = false
}

impl CollisionBlocks for World {
    fn shulker_open(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return self.open
    }

    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -64 or x >= 64 or z < -64 or z >= 64 {
            return none
        }
        if y == 2 {
            if let h = self.head {
                return some(h)
            }
        }
        if y >= 1 and y <= 3 {
            if let w = self.water {
                return some(w)
            }
        }
        return some(if y < 1 { self.stone } else { 0 })
    }
}

impl EntityTicking for World {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool {
        return chunk_x >= -4 and chunk_x < 4 and chunk_z >= -4 and chunk_z < 4
    }

    fn listed(self, chunk_x: i32, chunk_z: i32) -> bool {
        return self.ticks_entities(chunk_x, chunk_z)
    }
}

impl Rain for World {
    fn rains_on(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }
}

impl MobLight for World {
    fn magic_light(self, x: i32, y: i32, z: i32) -> f32 {
        _ = x + y + z
        return self.lit
    }

    fn monsters_burn(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return self.burn
    }

    fn sees_sky(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return true
    }
}

impl Warding for World {
    fn protection(self, worn: List<Tag?>, params: LootParams) -> (f32, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (0.0f32, List<String>())
    }

    fn immune(self, worn: List<Tag?>, params: LootParams) -> (bool, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (false, List<String>())
    }
}

impl NavLevel for World {
    fn level_time(self) -> i64 {
        return 0
    }

    fn top_y(self) -> i32 {
        return 319
    }

    fn sent_first(self) -> u64 {
        return 0
    }

    fn sent_total(self) -> u64 {
        return 0
    }

    fn sent_at(self, i: u64) -> SentBlock {
        return SentBlock { x: i32.wrap(i), y: 0, z: 0, old: 0, now: 0 }
    }
}

// A maker for a mob's finalizing, as natural spawning's: each mob made of its kind, its ID the
// next from 100 and its random seeded 800 more, where it's to stand, its variants by the biome;
// what's added kept in order, and its riders apart.
struct Maker {
    lf: LivingFacts
    facts: MobFacts
    kinds: List<String>
    next: i32 = 100
    made: List<Mob> = List<Mob>()
    riders: List<Mob> = List<Mob>()
}

impl Making for Maker {
    fn make_kind(mut self, species: i32, x: f64, y: f64, z: f64, biome: i32) -> Mob? {
        self.next += 1
        var kind: u32 = 0
        for i in 0..self.kinds.len() {
            if "minecraft:{self.kinds[i]}" == String(type_name(species)) {
                kind = u32.wrap(i)
            }
        }
        var mob = Mob.made(self.lf, self.facts, species, kind, self.next, i64(self.next) + 800, x, y, z)
        mob.spawning_in(self.facts, biome)
        return some(mob)
    }

    fn add_made(mut self, mob: own Mob) {
        self.made.push(mob)
    }

    fn add_passenger(mut self, mob: own Mob) {
        self.riders.push(mob)
    }
}

fn maker(s: Setup) -> Maker {
    return Maker { lf: s.lf.copy(), facts: s.facts.copy(), kinds: s.kinds.copy() }
}

struct Sizes {}

impl StackSizes for Sizes {
    fn stack_most(self, stack: Tag) -> i32 {
        return if stack == Tag.End { 0 } else { 64 }
    }
}

impl Wearing for Sizes {
    fn worn_component(self, stack: Tag, name: String) -> Tag? {
        _ = stack
        _ = name
        return none
    }

    fn worn_types(self, set: Tag) -> List<i32> {
        _ = set
        return List<i32>()
    }

    fn worn_enchantments(self, stack: Tag) -> List<(i32, JavaHashMap<String, Tag>)> {
        _ = stack
        return List<(i32, JavaHashMap<String, Tag>)>()
    }
}

struct Setup {
    f: Facts
    m: MovementStates
    t: BodyFacts
    lf: LivingFacts
    kind: u32
    facts: MobFacts
    kinds: List<String>
}

// A mob of the kind `species`, its type named `name`, made at 0.5, 5, 0.5.
fn animal(s: Setup, species: i32, name: str, id: i32, seed: i64) -> Mob {
    var kind: u32 = 0
    for i in 0..s.kinds.len() {
        if s.kinds[i] == String(name) {
            kind = u32.wrap(i)
        }
    }
    return Mob.made(s.lf, s.facts, species, kind, id, seed, 0.5, 5.0, 0.5)
}

fn mooshroom(s: Setup, id: i32, seed: i64) -> Mob {
    return Mob.mooshroom(s.lf, s.kind, id, seed, 0.5, 1.0, 0.5)
}

// Made with seed 155, as an armor stand of that seed is: its turn drawn after its UUID, its health
// its most, the only value it pairs with that isn't its default; 0.9 across and 1.4 high.
fn made(s: Setup) {
    let mb = mooshroom(s, 7, 155)
    check(i64(mb.living.body.y_rot.to_bits()) == 1078705807 and mb.living.y_head_rot == mb.living.body.y_rot, "a mooshroom's turn isn't vanilla's")
    check(mb.living.health() == 10.0f32 and mb.category == CREATURE and mb.animal and mb.ageable, "a mooshroom's health or kind")
    let paired = mb.living.data.pack_non_default() ?? panic("a mooshroom has nothing to pair with")
    let health: List<u8> = [9, 3, 65, 32, 0, 0, 255]
    check(paired == health, "a mooshroom pairs with more than its health")
    check(mb.living.body.width == 0.9f32 and mb.living.body.height == 1.4f32 and mb.living.body.eyes == 1.3f32, "a mooshroom's size")
    check(not mb.baby() and not mb.left_handed() and not mb.no_ai() and mb.living.data.number(MOOSHROOM_TYPE) == 0, "a mooshroom's flags or type")
    println("made: its turn, health and size")
}

// `finalizeSpawn` with seed 400: the first of a pack draws no baby chance, then the bonus as
// `triangle(0, 0.11485)` draws it and its hand; the pack's group counts it.
fn finalized(s: Setup) {
    var nobody = Unmade {}
    var r = LegacyRandom.new(400)
    var mirror = LegacyRandom.new(400)
    var mb = mooshroom(s, 7, 155)
    let group = mb.finalize_spawn(none, Occasion.plain(), mut nobody, mut r) ?? panic("a mooshroom's pack has no group")
    let a = mirror.next_double()
    let b = mirror.next_double()
    let bonus = 0.0 + 0.11485000000000001 * (a - b)
    let left = mirror.next_float() < 0.05f32
    check(group.ageable and group.size == 1 and not mb.baby(), "the first of a pack isn't its group's first, grown")
    check(r.next_long() == mirror.next_long(), "finalizing drew other than the bonus and the hand")
    let follow = attribute_id("minecraft:follow_range") ?? panic("no follow range")
    let range = mb.living.attributes.value(follow)
    if range != 16.0 + 16.0 * bonus {
        panic("the follow range's random spawn bonus isn't vanilla's: {range}")
    }
    check(mb.left_handed() == left, "a mooshroom's hand isn't its draw")
    // Again with the bonus there, which isn't drawn twice.
    var again = LegacyRandom.new(400)
    var check_r = LegacyRandom.new(400)
    _ = mb.finalize_spawn(some(SpawnGroup { ageable: true, size: 1 }), Occasion.plain(), mut nobody, mut again)
    _ = check_r.next_float()
    _ = check_r.next_float()
    check(again.next_long() == check_r.next_long(), "a bonus drawn twice, or a later one's baby chance not drawn")
    // The first seed whose first float is a baby's, 1 in 20: the pack's second is a baby, half
    // the size, its age to grow from.
    var seed: i64 = 0
    loop {
        var probe = LegacyRandom.new(seed)
        if probe.next_float() <= 0.05f32 {
            break
        }
        seed += 1
    }
    var br = LegacyRandom.new(seed)
    var calf = mooshroom(s, 8, 156)
    let next = calf.finalize_spawn(some(group), Occasion.plain(), mut nobody, mut br) ?? panic("no group")
    check(next.size == 2 and calf.baby() and calf.age == BABY_START_AGE and calf.living.data.flag(BABY), "the pack's second isn't a baby at its chance")
    check(calf.living.body.width == 0.45f32 and calf.living.body.height == 0.7f32 and calf.living.body.eyes == 0.69f32, "a baby mooshroom's size")
    calf.set_age(0)
    check(not calf.baby() and not calf.living.data.flag(BABY) and calf.living.body.width == 0.9f32, "a grown calf's size")
    println("finalized: its bonus, hand and pack, a baby at its chance (seed {seed})")
}

// `checkDespawn`: an animal never goes for being far, nor in peaceful, which its type's allowed
// in; after 600 ticks doing nothing it draws its chance each tick from its own random, past 32
// blocks; within 32 its ticks doing nothing start again.
fn despawning(s: Setup) {
    var mb = mooshroom(s, 7, 155)
    check(not mb.check_despawn(true, none), "a mooshroom went in peaceful with no player")
    check(not mb.check_despawn(false, some(200.0 * 200.0)), "an animal went for being far")
    mb.no_action_time = 700
    var mirror = mb.living.body.random
    check(not mb.check_despawn(false, some(100.0 * 100.0)), "an animal went after doing nothing")
    _ = mirror.next_int_below(800)
    check(mb.living.body.random.next_long() == mirror.next_long() and mb.no_action_time == 700, "doing nothing past 32 blocks didn't draw its chance")
    var near = mooshroom(s, 8, 155)
    near.no_action_time = 700
    check(not near.check_despawn(false, some(10.0 * 10.0)) and near.no_action_time == 0, "within 32 blocks its ticks doing nothing didn't start again")
    var stays = mooshroom(s, 9, 155)
    stays.persistence_required = true
    stays.no_action_time = 700
    var same = stays.living.body.random
    _ = stays.check_despawn(false, some(100.0 * 100.0))
    check(stays.living.body.random.next_long() == same.next_long(), "one that must stay drew its chance")
    println("despawning: an animal stays, its chance drawn after 600 ticks")
}

// Its tag as vanilla saves a mooshroom's, read back the same; a brown one's type read.
fn saving(s: Setup) {
    let mb = mooshroom(s, 7, 155)
    let tag = mb.saved()
    let Tag.Compound(m) = tag else panic("a mooshroom's tag isn't a compound")
    check(m["id"] == Tag.Str(String("minecraft:mooshroom")) and m["Health"] == Tag.Float(10.0f32) and m["Type"] == Tag.Str(String("red")), "a mooshroom's id, health or type")
    check(m["Age"] == Tag.Int(0) and m["ForcedAge"] == Tag.Int(0) and m["AgeLocked"] == Tag.Byte(0i8) and m["InLove"] == Tag.Int(0), "an ageable mob's fields")
    check(m["CanPickUpLoot"] == Tag.Byte(0i8) and m["PersistenceRequired"] == Tag.Byte(0i8) and m["LeftHanded"] == Tag.Byte(0i8) and not m.contains("NoAI"), "a mob's fields")
    var lines = List<Entry>()
    let back = Mob.loaded(s.lf, s.facts, s.kind, 7, 7, m, mut lines) ?? panic("a mooshroom's tag didn't read back")
    check(back.saved() == tag, "a mooshroom's tag read back isn't the same")
    var odd = m.copy()
    odd.insert(String("Type"), Tag.Str(String("brown")))
    odd.insert(String("Age"), Tag.Int(-100))
    odd.insert(String("NoAI"), Tag.Byte(1i8))
    odd.insert(String("stew_effects"), Tag.List([]))
    let brown = Mob.loaded(s.lf, s.facts, s.kind, 8, 8, odd, mut lines) ?? panic("a brown mooshroom didn't read")
    check(brown.living.data.number(MOOSHROOM_TYPE) == 1 and brown.baby() and brown.no_ai() and brown.living.body.height == 0.7f32, "a brown calf's type, age or flags")
    let Tag.Compound(again) = brown.saved() else panic("a brown mooshroom's tag isn't a compound")
    check(again["Type"] == Tag.Str(String("brown")) and again["NoAI"] == Tag.Byte(1i8) and again["stew_effects"] == Tag.List([]), "a brown mooshroom's tag")
    check(lines.is_empty(), "loading mooshrooms logged something")
    println("saving: a mooshroom's tag as vanilla's, read back the same")
}

// One on stone in a level's entities for 400 ticks with a player 10 blocks off: it stays, on the
// ground, strolls as its goals say, its steps `entity.cow.step` at 0.15, and moos as its own random
// says, `entity.cow.ambient` at 0.4, each at least 120 ticks after the last, an animal's interval
// (CAL-158).
fn listed(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var store = Entities.new()
    store.add_mob(mooshroom(s, 7, 155))
    let players: List<Follower> = [Follower { id: 1, x: 10.5, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false }]
    var moos = List<i32>()
    var steps = 0
    for tick in 1..=400 {
        store.begin_tick()
        var sounds = List<EntitySound>()
        while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
        store.end_tick()
        for e in sounds {
            if e.sound == "entity.cow.step" and e.volume == 0.15f32 {
                steps += 1
                continue
            }
            if e.sound != "entity.cow.ambient" or e.volume != 0.4f32 {
                panic("a mooshroom played {e.sound}")
            }
            moos.push(tick)
        }
    }
    check(store.is_mob(7), "a mooshroom went")
    let mb = store.mob(7)
    check(mb.living.body.y == 1.0 and mb.living.body.on_ground and mb.no_action_time == 1, "a mooshroom left the ground or did nothing near a player")
    check(steps > 0 and (mb.living.body.x != 0.5 or mb.living.body.z != 0.5), "a mooshroom never strolled in 400 ticks")
    check(not moos.is_empty(), "a mooshroom never mooed in 400 ticks")
    for i in 1..moos.len() {
        check(moos[i] - moos[i - 1] >= 120, "a mooshroom mooed again too soon")
    }
    println("listed: it stays, strolls, {steps} steps, and moos at ticks {moos}")
}

// Each kind's size grown and a baby's, its sounds by its sound variant, and a chicken's egg time,
// drawn from its own random right after its turn, as a mooshroom of its seed leaves it.
fn sizes(s: Setup) {
    let cow = animal(s, COW, "cow", 7, 155)
    check(cow.living.body.width == 0.9f32 and cow.living.body.height == 1.4f32 and cow.living.health() == 10.0f32, "a cow's size or health")
    check(cow.ambient == some(String("entity.cow.ambient")) and cow.sound_volume == 0.4f32 and cow.variant == 1 and cow.sound_variant == 0, "a cow's sounds or variants")
    var moody = animal(s, COW, "cow", 8, 155)
    moody.set_sound_variant(1)
    check(moody.ambient == some(String("entity.cow_moody.ambient")) and moody.living.own_step == some(String("entity.cow_moody.step")) and moody.living.data.number(OWN + 1) == 1, "a moody cow's sounds")
    var pig = animal(s, PIG, "pig", 9, 155)
    check(pig.living.body.height == 0.9f32 and pig.living.body.eyes == 0.9f32 * 0.85f32 and pig.living.health() == 10.0f32 and pig.living.data.number(OWN) == 0 and pig.living.data.number(OWN + 1) == 1, "a pig's size, health or values")
    pig.set_sound_variant(0)
    check(pig.ambient == some(String("entity.pig_big.ambient")) and pig.living.own_step == some(String("entity.pig.step")), "a big pig's sounds")
    pig.set_age(BABY_START_AGE)
    check(pig.ambient == some(String("entity.baby_pig.ambient")) and pig.living.own_step == some(String("entity.baby_pig.step")) and pig.living.body.height == 0.45f32, "a piglet's sounds or size")
    var chicken = animal(s, CHICKEN, "chicken", 10, 155)
    var moo = mooshroom(s, 10, 155)
    let lay = moo.living.body.random.next_int_below(6000) + 6000
    check(chicken.egg_time == lay and chicken.living.body.random.next_long() == moo.living.body.random.next_long(), "a chicken's egg time isn't drawn after its turn")
    check(chicken.living.body.width == 0.4f32 and chicken.living.body.height == 0.7f32 and chicken.living.health() == 4.0f32 and chicken.living.fall_immune, "a chicken's size, health or fall")
    check(chicken.ambient == some(String("entity.chicken.ambient")) and chicken.egg() == some(String("minecraft:egg")), "a chicken's sound or egg")
    let sheep = animal(s, SHEEP, "sheep", 11, 155)
    check(sheep.living.body.height == 1.3f32 and sheep.living.health() == 8.0f32 and sheep.color() == 0 and not sheep.sheared(), "a sheep's size, health or wool")
    check(sheep.ambient == some(String("entity.sheep.ambient")) and sheep.living.own_step == some(String("entity.sheep.step")), "a sheep's sounds")
    println("kinds: sizes, sounds and a chicken's egg time")
}

// The biome's variants as their selectors pick them, biome 1 warm and 2 cold; `finalizeSpawn`
// drawing the variant, one of them, then the sound variant, any, before an ageable mob's own.
fn variants(s: Setup) {
    var nobody = Unmade {}
    check(s.facts.cow.spawnable(0) == [1] and s.facts.cow.spawnable(1) == [2] and s.facts.cow.spawnable(2) == [0], "the variants a biome's selectors pick")
    for species in [COW, PIG, CHICKEN] {
        for biome in 0..3 {
            var r = LegacyRandom.new(400)
            var mirror = LegacyRandom.new(400)
            var mb = animal(s, species, if species == COW { "cow" } else if species == PIG { "pig" } else { "chicken" }, 7, 155)
            mb.spawning_in(s.facts, biome)
            _ = mb.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
            _ = mirror.next_int_below(1)
            let sounds = if species == PIG { 3 } else { 2 }
            let sound = mirror.next_int_below(sounds)
            _ = mirror.next_double()
            _ = mirror.next_double()
            _ = mirror.next_float()
            let want = if biome == 0 { 1 } else if biome == 1 { 2 } else { 0 }
            let at = if species == PIG { OWN + 1 } else { OWN }
            check(mb.variant == want and mb.living.data.number(at) == want and mb.sound_variant == sound and mb.living.data.number(at + 1) == sound, "a farm animal's variants aren't its draws")
            check(r.next_long() == mirror.next_long(), "finalizing a farm animal drew other than vanilla")
        }
    }
    var warm = animal(s, CHICKEN, "chicken", 7, 155)
    warm.set_variant(2)
    var cold = animal(s, CHICKEN, "chicken", 8, 155)
    cold.set_variant(0)
    check(warm.egg() == some(String("minecraft:brown_egg")) and cold.egg() == some(String("minecraft:blue_egg")), "a warm or cold chicken's egg")
    println("variants: picked by the biome and drawn with their sound variants")
}

// A sheep's color: three colors 5 in 100 each and one 3, by its climate, and otherwise its
// climate's own, pink 1 in 500.
fn colors(s: Setup) {
    var nobody = Unmade {}
    // White 0, pink 6, gray 7, light gray 8, brown 12, black 15.
    let firsts: List<List<i32>> = [[15, 7, 8, 12, 0], [7, 8, 0, 15, 12], [8, 7, 0, 12, 15]]
    let lows: List<i32> = [0, 5, 10, 15, 18]
    for biome in 0..3 {
        for band in 0..5 {
            var seed: i64 = 0
            loop {
                var probe = LegacyRandom.new(seed)
                let pick = probe.next_int_below(100)
                let high = if band < 4 { lows[usize.wrap(band + 1)] } else { 100 }
                if pick >= lows[usize.wrap(band)] and pick < high and (band < 4 or probe.next_int_below(500) < 499) {
                    break
                }
                seed += 1
            }
            var r = LegacyRandom.new(seed)
            var mb = animal(s, SHEEP, "sheep", 7, 155)
            mb.spawning_in(s.facts, biome)
            _ = mb.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
            if mb.color() != firsts[usize.wrap(biome)][usize.wrap(band)] {
                panic("a sheep in biome {biome} drew {mb.color()} at band {band}")
            }
        }
        var seed: i64 = 0
        loop {
            var probe = LegacyRandom.new(seed)
            if probe.next_int_below(100) >= 18 and probe.next_int_below(500) == 499 {
                break
            }
            seed += 1
        }
        var r = LegacyRandom.new(seed)
        var pink = animal(s, SHEEP, "sheep", 7, 155)
        pink.spawning_in(s.facts, biome)
        _ = pink.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
        check(pink.color() == 6, "a sheep isn't pink 1 in 500")
    }
    println("colors: a sheep's by its climate, pink 1 in 500")
}

// Each kind's tag read back the same, its variants by name; a warm cow's variant read.
fn farm_saving(s: Setup) {
    var lines = List<Entry>()
    var cow = animal(s, COW, "cow", 7, 155)
    cow.set_sound_variant(1)
    let Tag.Compound(cm) = cow.saved() else panic("a cow's tag isn't a compound")
    check(cm["id"] == Tag.Str(String("minecraft:cow")) and cm["variant"] == Tag.Str(String("minecraft:temperate")) and cm["sound_variant"] == Tag.Str(String("minecraft:moody")), "a cow's tag")
    var warm = cm.copy()
    warm.insert(String("variant"), Tag.Str(String("minecraft:warm")))
    let back = Mob.loaded(s.lf, s.facts, cow.living.kind, 7, 7, warm, mut lines) ?? panic("a cow didn't read")
    check(back.variant == 2 and back.sound_variant == 1 and back.living.data.number(OWN) == 2 and back.ambient == some(String("entity.cow_moody.ambient")), "a warm moody cow read")
    var sheep = animal(s, SHEEP, "sheep", 8, 155)
    sheep.set_color(12)
    let Tag.Compound(sm) = sheep.saved() else panic("a sheep's tag isn't a compound")
    check(sm["Color"] == Tag.Byte(12i8) and sm["Sheared"] == Tag.Byte(0i8), "a sheep's tag")
    var shorn = sm.copy()
    shorn.insert(String("Sheared"), Tag.Byte(1i8))
    let wool = Mob.loaded(s.lf, s.facts, sheep.living.kind, 8, 8, shorn, mut lines) ?? panic("a sheep didn't read")
    check(wool.sheared() and wool.color() == 12 and wool.living.data.byte(OWN) == 28i8, "a shorn brown sheep read")
    let chicken = animal(s, CHICKEN, "chicken", 9, 155)
    let Tag.Compound(km) = chicken.saved() else panic("a chicken's tag isn't a compound")
    check(km["EggLayTime"] == Tag.Int(chicken.egg_time) and km["IsChickenJockey"] == Tag.Byte(0i8) and km["sound_variant"] == Tag.Str(String("minecraft:classic")), "a chicken's tag")
    for mb in [cow.copy(), sheep.copy(), chicken.copy(), animal(s, PIG, "pig", 10, 155)] {
        let tag = mb.saved()
        let Tag.Compound(m) = tag.copy() else panic("a tag isn't a compound")
        let again = Mob.loaded(s.lf, s.facts, mb.living.kind, mb.living.body.id, 7, m, mut lines) ?? panic("a farm animal didn't read back")
        check(again.saved() == tag, "a farm animal's tag read back isn't the same")
    }
    check(lines.is_empty(), "loading farm animals logged something")
    println("farm saving: each kind's tag read back the same")
}

// A chicken in the air keeps 0.6 of its fall; on stone, it lays its egg when its time's up, then
// clucks the egg's sound and draws its time again.
fn laying(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var store = Entities.new()
    store.add_mob(animal(s, CHICKEN, "chicken", 7, 155))
    let players: List<Follower> = [Follower { id: 1, x: 10.5, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false }]
    store.begin_tick()
    var first = List<EntitySound>()
    while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut first) {}
    store.end_tick()
    let fell = store.mob(7).living.body.vy
    if fell != (0.0 - 0.08) * 0.9800000190734863 * 0.6 {
        panic("a chicken doesn't fall slowly: {fell}")
    }
    var laid = List<i32>()
    var clucks = List<i32>()
    var due: i32 = 0
    for tick in 2..=200 {
        if tick == 100 {
            var mb = store.lend_mob(7) ?? panic("no chicken")
            mb.egg_time = 1
            due = tick
            store.give_back_mob(mb)
        }
        store.begin_tick()
        var sounds = List<EntitySound>()
        while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
        store.end_tick()
        for e in sounds {
            if e.sound == "entity.chicken.egg" {
                clucks.push(tick)
            }
        }
        for shown in store.take_shown() {
            if let Shown.Laid(l) = shown {
                check(l.item == "minecraft:egg" and l.y == store.mob(7).living.body.y, "a chicken's egg isn't its variant's, where it is")
                laid.push(tick)
            }
        }
    }
    if laid != [due] or clucks != [due] {
        panic("a chicken didn't lay once when its time was up: {laid}, {clucks}")
    }
    let left = store.mob(7).egg_time
    check(left >= 6000 - (200 - due) and left < 12000, "a chicken's egg time wasn't drawn again")
    println("laying: it falls slowly and lays when its time's up")
}

// A horse's and a donkey's sizes and sounds; `finalizeSpawn` drawing a horse's variant for its
// pack's first, then its markings, its most health, speed and jump, then its baby chance after the
// first and the follow range's bonus and its hand; and a donkey's, its most health alone, its
// pack's babies 1 in 5.
fn horses(s: Setup) {
    var nobody = Unmade {}
    let horse = animal(s, HORSE, "horse", 7, 155)
    check(horse.living.body.width == 1.3964844f32 and horse.living.body.height == 1.6f32 and horse.living.body.eyes == 1.52f32 and horse.living.health() == 53.0f32, "a horse's size or health")
    check(horse.ambient == some(String("entity.horse.ambient")) and horse.sound_volume == 0.8f32 and horse.ambient_interval == 400 and horse.max_cluster == 6 and horse.living.step_by_block, "a horse's sounds or pack")
    var r = LegacyRandom.new(400)
    var mirror = LegacyRandom.new(400)
    var first = animal(s, HORSE, "horse", 7, 155)
    let group = first.finalize_spawn(none, Occasion.plain(), mut nobody, mut r) ?? panic("a horse's pack has no group")
    let variant = mirror.next_int_below(7)
    let markings = mirror.next_int_below(5)
    let most = 15 + mirror.next_int_below(8) + mirror.next_int_below(9)
    let speed = (f64(0.45f32) + mirror.next_double() * 0.3 + mirror.next_double() * 0.3 + mirror.next_double() * 0.3) * 0.25
    let jump = f64(0.4f32) + mirror.next_double() * 0.2 + mirror.next_double() * 0.2 + mirror.next_double() * 0.2
    _ = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_float()
    check(r.next_long() == mirror.next_long(), "finalizing a horse drew other than vanilla")
    check(group.variant == variant and group.baby_chance == 0.05f32 and group.size == 1 and first.horse_variant() == (variant | (markings << 8)), "a horse's variant, markings or group")
    let health = attribute_id("minecraft:max_health") ?? panic("no max health")
    let moves = attribute_id("minecraft:movement_speed") ?? panic("no speed")
    let jumps = attribute_id("minecraft:jump_strength") ?? panic("no jump")
    check(first.living.attributes.value(health) == f64(most) and first.living.attributes.value(moves) == speed and first.living.attributes.value(jumps) == jump, "a horse's randomized attributes")
    check(first.living.health() == 53.0f32, "a horse's health was brought down before its tick")
    // The pack's second shares its variant, drawing only its markings, and its baby chance.
    var second = animal(s, HORSE, "horse", 8, 156)
    var r2 = LegacyRandom.new(77)
    var m2 = LegacyRandom.new(77)
    _ = second.finalize_spawn(some(group), Occasion.plain(), mut nobody, mut r2)
    let markings2 = m2.next_int_below(5)
    _ = m2.next_int_below(8)
    _ = m2.next_int_below(9)
    for _ in 0..6 {
        _ = m2.next_double()
    }
    let baby = m2.next_float() <= 0.05f32
    _ = m2.next_double()
    _ = m2.next_double()
    _ = m2.next_float()
    check(r2.next_long() == m2.next_long() and second.horse_variant() == (variant | (markings2 << 8)) and second.baby() == baby, "a horses' pack's second")
    var donkey = animal(s, DONKEY, "donkey", 9, 155)
    var foal = animal(s, DONKEY, "donkey", 10, 155)
    foal.set_age(BABY_START_AGE)
    check(foal.living.body.height == 0.75f32 and foal.living.body.width == 1.3964844f32 * 0.5f32 and foal.ambient == some(String("entity.donkey.ambient")) and foal.living.own_step == some(String("entity.baby_horse.step")), "a donkey foal's size or sounds")
    check(donkey.living.body.height == 1.5f32 and donkey.ambient == some(String("entity.donkey.ambient")), "a donkey's size or sound")
    var r3 = LegacyRandom.new(400)
    var m3 = LegacyRandom.new(400)
    let dg = donkey.finalize_spawn(none, Occasion.plain(), mut nobody, mut r3) ?? panic("a donkey's pack has no group")
    let dmost = 15 + m3.next_int_below(8) + m3.next_int_below(9)
    _ = m3.next_double()
    _ = m3.next_double()
    _ = m3.next_float()
    check(r3.next_long() == m3.next_long() and dg.baby_chance == 0.2f32 and donkey.living.attributes.value(health) == f64(dmost), "finalizing a donkey drew other than vanilla")
    println("horses: sizes, sounds and finalizeSpawn's draws")
}

// A spawned horse's health brought within its most on its first tick; on grass it grazes for 50
// ticks at a time, and heals now and then.
fn grazing(s: Setup) {
    var nobody = Unmade {}
    let w = World { stone: f_state(s.f, "minecraft:grass_block") }
    var store = Entities.new()
    var horse = animal(s, HORSE, "horse", 7, 155)
    var r = LegacyRandom.new(400)
    _ = horse.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
    let health = attribute_id("minecraft:max_health") ?? panic("no max health")
    let most = f32.nearest(horse.living.attributes.value(health))
    horse.living.body.y = 1.0
    store.add_mob(horse)
    let players: List<Follower> = [Follower { id: 1, x: 10.5, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false }]
    var stints = List<i32>()
    var began: i32 = -1
    var healed = 0
    for tick in 1..=6000 {
        if tick == 2 {
            var mb = store.lend_mob(7) ?? panic("no horse")
            if mb.living.health() != most {
                panic("a horse's health wasn't brought within its most on its first tick")
            }
            mb.living.set_health(s.lf, 5.0f32)
            store.give_back_mob(mb)
        }
        let before = store.mob(7).living.health()
        store.begin_tick()
        var sounds = List<EntitySound>()
        while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
        store.end_tick()
        let mb = store.mob(7)
        if mb.living.health() > before and tick > 2 {
            healed += 1
        }
        let eating = mb.horse_flag(16)
        if eating and began < 0 {
            began = tick
        } else if not eating and began >= 0 {
            stints.push(tick - began)
            began = -1
        }
    }
    check(not stints.is_empty() and healed > 0, "a horse never grazed or healed in 6000 ticks")
    for n in stints {
        check(n == 50, "a horse grazed other than 50 ticks")
    }
    println("grazing: its health within its most, grazing 50 ticks at a time ({stints.len()} times), healed {healed} times")
}

// A horse's and a donkey's tags read back the same, their flags, temper, variant and chest.
fn horse_saving(s: Setup) {
    var nobody = Unmade {}
    var lines = List<Entry>()
    var horse = animal(s, HORSE, "horse", 7, 155)
    var r = LegacyRandom.new(400)
    _ = horse.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
    // Its first tick brings its health within its most, as loading it would.
    horse.living.keep_health(s.lf)
    horse.set_horse_flag(2, true)
    horse.temper = 12
    let Tag.Compound(hm) = horse.saved() else panic("a horse's tag isn't a compound")
    check(hm["id"] == Tag.Str(String("minecraft:horse")) and hm["Variant"] == Tag.Int(horse.horse_variant()) and hm["Tame"] == Tag.Byte(1i8) and hm["Temper"] == Tag.Int(12) and hm["EatingHaystack"] == Tag.Byte(0i8) and hm["Bred"] == Tag.Byte(0i8), "a horse's tag")
    let donkey = animal(s, DONKEY, "donkey", 8, 155)
    let Tag.Compound(dm) = donkey.saved() else panic("a donkey's tag isn't a compound")
    check(dm["ChestedHorse"] == Tag.Byte(0i8) and not dm.contains("Variant"), "a donkey's tag")
    var chested = dm.copy()
    chested.insert(String("ChestedHorse"), Tag.Byte(1i8))
    chested.insert(String("Items"), Tag.List([]))
    let packed = Mob.loaded(s.lf, s.facts, donkey.living.kind, 8, 8, chested, mut lines) ?? panic("a chested donkey didn't read")
    let Tag.Compound(again) = packed.saved() else panic("a chested donkey's tag isn't a compound")
    check(packed.living.data.flag(OWN + 1) and again["Items"] == Tag.List([]), "a chested donkey's chest")
    for mb in [horse.copy(), donkey.copy()] {
        let tag = mb.saved()
        let Tag.Compound(m) = tag.copy() else panic("a tag isn't a compound")
        let back = Mob.loaded(s.lf, s.facts, mb.living.kind, mb.living.body.id, 7, m, mut lines) ?? panic("a horse didn't read back")
        check(back.saved() == tag, "a horse's tag read back isn't the same")
    }
    check(lines.is_empty(), "loading horses logged something")
    println("horse saving: their tags read back the same")
}

// A stack of one of the item `name`.
fn one(name: str) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String(name)))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

// What a mob in a level's entities shows of its equipment over a tick.
fn worn_shown(s: Setup, store: mut Entities, w: World, players: List<Follower>) -> List<Shown> {
    store.begin_tick()
    var sounds = List<EntitySound>()
    while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
    store.end_tick()
    var out = List<Shown>()
    for shown in store.take_shown() {
        match shown {
            Shown.Worn(_) => out.push(shown.copy()),
            Shown.Event(_) => out.push(shown.copy()),
            _ => {},
        }
    }
    return out
}

// `detectEquipmentUpdates`: a bow given in the main hand shown on the mob's next tick, as it last
// looked at nothing, then not again; the bow moved to the empty off hand, which is its hands
// swapped, and those swapped again, each event 55 and no slots; a helmet put on,
// that slot alone; and its slots saved under their names and read back.
fn equipment(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var store = Entities.new()
    var cow = animal(s, COW, "cow", 7, 155)
    cow.living.body.y = 1.0
    cow.living.equipment[0] = some(one("minecraft:bow"))
    store.add_mob(cow)
    let players: List<Follower> = [Follower { id: 1, x: 10.5, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false }]
    let first = worn_shown(s, mut store, w, players)
    let bow: List<(usize, Tag?)> = [(0usize, some(one("minecraft:bow")))]
    check(first.len() == 1 and first[0] == Shown.Worn(bow), "a mob's bow wasn't shown on its first tick")
    check(worn_shown(s, mut store, w, players).is_empty(), "a mob's equipment was shown again unchanged")
    var mb = store.lend_mob(7) ?? panic("no cow")
    mb.living.equipment[1] = mb.living.equipment[0].copy()
    mb.living.equipment[0] = none
    store.give_back_mob(mb)
    let moved = worn_shown(s, mut store, w, players)
    check(moved.len() == 1 and moved[0] == Shown.Event(55i8), "a bow moved to an empty off hand isn't its hands swapped, as `handleHandSwap` has it")
    var swap = store.lend_mob(7) ?? panic("no cow")
    swap.living.equipment[0] = some(one("minecraft:stick"))
    store.give_back_mob(swap)
    _ = worn_shown(s, mut store, w, players)
    var both = store.lend_mob(7) ?? panic("no cow")
    let held = both.living.equipment[0].copy()
    both.living.equipment[0] = both.living.equipment[1].copy()
    both.living.equipment[1] = held
    store.give_back_mob(both)
    let swapped = worn_shown(s, mut store, w, players)
    check(swapped.len() == 1 and swapped[0] == Shown.Event(55i8), "a mob's hands swapped weren't event 55 alone")
    var helmet = store.lend_mob(7) ?? panic("no cow")
    helmet.living.equipment[5] = some(one("minecraft:iron_helmet"))
    store.give_back_mob(helmet)
    let head = worn_shown(s, mut store, w, players)
    check(head.len() == 1 and head[0] == Shown.Worn([(5usize, some(one("minecraft:iron_helmet")))]), "a helmet put on isn't its slot alone")
    let worn = store.mob(7)
    let Tag.Compound(m) = worn.saved() else panic("a cow's tag isn't a compound")
    let Tag.Compound(e) = m["equipment"] else panic("a cow's equipment isn't saved")
    check(e["mainhand"] == one("minecraft:bow") and e["offhand"] == one("minecraft:stick") and e["head"] == one("minecraft:iron_helmet") and e.len() == 3, "a cow's equipment saved")
    var lines = List<Entry>()
    let back = Mob.loaded(s.lf, s.facts, worn.living.kind, 7, 7, m, mut lines) ?? panic("a worn cow didn't read")
    check(back.living.equipment == worn.living.equipment and back.saved() == worn.saved(), "a cow's equipment read back")
    let bare = animal(s, COW, "cow", 8, 155)
    let Tag.Compound(bm) = bare.saved() else panic("a cow's tag isn't a compound")
    check(not bm.contains("equipment"), "nothing worn was saved")
    println("equipment: shown when it changes, its hands swapped as event 55, saved and read back")
}

// A stack of one of the item `name`.
fn one_named(name: own String) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(name))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

// Local difficulty: a new world's on normal 1.5 and on hard 2.25; past the clock's ramp a quarter
// more and a full moon's quarter, up to the clock's part; a chunk lived in its most three quarters
// more, all on hard, half on easy; peaceful none. And the moon's brightness by its phase.
fn difficulty() {
    let fresh = LocalDifficulty.new(Difficulty.Normal, 0, 0, 1.0f32)
    check(fresh.effective == 1.5f32 and fresh.special() == 0.0f32 and not fresh.hard(), "a new world's difficulty on normal")
    let hard = LocalDifficulty.new(Difficulty.Hard, 0, 0, 1.0f32)
    check(hard.effective == 2.25f32 and hard.special() == 0.125f32 and hard.hard(), "a new world's difficulty on hard")
    let late = LocalDifficulty.new(Difficulty.Normal, 72000 + 1440000, 0, 1.0f32)
    check(late.effective == 2.5f32 and late.special() == 0.25f32, "an old world's difficulty under a full moon")
    let lived = LocalDifficulty.new(Difficulty.Hard, 72000 + 1440000, 3600000, 1.0f32)
    check(lived.effective == 6.75f32 and lived.special() == 1.0f32, "a lived-in chunk's difficulty on hard")
    let easy = LocalDifficulty.new(Difficulty.Easy, 72000 + 1440000, 3600000, 1.0f32)
    check(easy.effective == 1.5f32, "a lived-in chunk's difficulty on easy")
    check(LocalDifficulty.new(Difficulty.Peaceful, 72000 + 1440000, 3600000, 1.0f32).effective == 0.0f32, "peaceful's difficulty")
    check(moon_brightness(0) == 1.0f32 and moon_brightness(4) == 0.0f32 and moon_brightness(6) == 0.5f32, "the moon's brightness by its phase")
    println("difficulty: by the clock, the chunk and the moon, its special multiplier")
}

// Each monster's kind, size and sounds, the hostile source's, and its values.
fn monsters(s: Setup) {
    let zombie = animal(s, ZOMBIE, "zombie", 7, 155)
    check(zombie.category == MONSTER and zombie.monster and zombie.burns and not zombie.peaceful_ok and not zombie.animal and not zombie.ageable, "a zombie's kind")
    check(zombie.living.body.width == 0.6f32 and zombie.living.body.height == 1.95f32 and zombie.living.body.eyes == 1.74f32 and zombie.living.health() == 20.0f32, "a zombie's size or health")
    check(zombie.ambient == some(String("entity.zombie.ambient")) and zombie.living.own_step == some(String("entity.zombie.step")) and zombie.living.small_fall == "entity.hostile.small_fall" and zombie.living.swim == "entity.hostile.swim", "a zombie's sounds")
    var sounds = List<EntitySound>()
    zombie.living.play(mut sounds, String("entity.zombie.ambient"), 1.0f32, 1.0f32)
    check(sounds.len() == 1 and sounds[0].source == HOSTILE_SOURCE, "a zombie's sounds aren't the hostile source's")
    let paired = zombie.living.data.pack_non_default() ?? panic("a zombie pairs with nothing")
    let health: List<u8> = [9, 3, 65, 160, 0, 0, 255]
    check(paired == health, "a zombie pairs with more than its health")
    let creeper = animal(s, CREEPER, "creeper", 8, 155)
    check(creeper.ambient == none and creeper.living.own_step == none and creeper.living.body.height == 1.7f32 and creeper.living.body.eyes == 1.7f32 * 0.85f32 and creeper.living.data.number(MONSTER_OWN) == -1 and not creeper.burns, "a creeper's sounds, size or swell")
    let skeleton = animal(s, SKELETON, "skeleton", 9, 155)
    check(skeleton.living.body.height == 1.99f32 and skeleton.living.body.eyes == 1.74f32 and skeleton.ambient == some(String("entity.skeleton.ambient")) and skeleton.burns, "a skeleton's size or sounds")
    let spider = animal(s, SPIDER, "spider", 10, 155)
    check(spider.living.body.width == 1.4f32 and spider.living.body.height == 0.9f32 and spider.living.health() == 16.0f32 and spider.ambient == some(String("entity.spider.ambient")) and not spider.burns, "a spider's size, health or sounds")
    println("monsters: their kinds, sizes and sounds, the hostile source's")
}

// A zombie's `finalizeSpawn` at a plain occasion from the level's random, up to its jockey:
// `Mob`'s draws, its loot, its pack's baby, and a baby's two jockey draws; whether it's a baby and
// drew a new chicken.
fn zombie_draws(mirror: mut LegacyRandom) -> (bool, bool) {
    _ = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_float()
    _ = mirror.next_float()
    let baby = mirror.next_float() < 0.05f32
    var chicken = false
    if baby and not (mirror.next_float() < 0.05f32) {
        chicken = mirror.next_float() < 0.05f32
    }
    return (baby, chicken)
}

// The rest: its doors, its armor's and its weapon's draws, and the weapon's enchanting's where it
// has one.
fn zombie_rest(mirror: mut LegacyRandom) {
    _ = mirror.next_float()
    _ = mirror.next_float()
    if mirror.next_float() < 0.01f32 {
        _ = mirror.next_int_below(6)
        _ = mirror.next_float()
    }
}

// A zombie finalized as vanilla finalizes it: the level's draws, then its attributes from its own
// random's four; a baby's, with its new chicken made where it stands, finalized and its mount.
fn zombies(s: Setup) {
    var nobody = Unmade {}
    var r = LegacyRandom.new(400)
    var mirror = LegacyRandom.new(400)
    var zombie = animal(s, ZOMBIE, "zombie", 7, 155)
    var its = zombie.living.body.random
    let group = zombie.finalize_spawn(none, Occasion.plain(), mut nobody, mut r) ?? panic("a zombie's pack has no group")
    let (baby, _) = zombie_draws(mut mirror)
    zombie_rest(mut mirror)
    check(group.zombie and group.baby == baby and zombie.baby() == baby and r.next_long() == mirror.next_long(), "a zombie's finalizing drew other than vanilla")
    let a = its.next_double()
    let k = its.next_double()
    _ = its.next_double()
    _ = its.next_float()
    check(zombie.living.body.random.next_long() == its.next_long(), "a zombie's attributes drew other than its own random's four")
    let reinforcements = attribute_id("minecraft:spawn_reinforcements") ?? panic("no reinforcements")
    let knockback = attribute_id("minecraft:knockback_resistance") ?? panic("no knockback resistance")
    check(zombie.living.attributes.value(reinforcements) == a * f64(0.1f32) and zombie.living.attributes.value(knockback) == k * f64(0.05f32), "a zombie's reinforcements' chance or knockback resistance")
    check(not zombie.can_pick_up_loot and not zombie.can_break_doors, "a zombie at no special multiplier picks up loot or breaks doors")
    // Hurt on hard, `Zombie.hurtServer`: with no target and by a fall, nothing drawn for its
    // reinforcements; by a player, or with a target, a float; not on hard, nothing (D467).
    let fall = Damage.of(s.lf.damage, "fall")
    var by_player = Damage.of(s.lf.damage, "player_attack")
    by_player.player = some((1i64, 2i64))
    var calm = zombie.living.body.random
    _ = zombie.after_hurt(Hurt { hurt: true }, true, fall)
    check(zombie.living.body.random.next_long() == calm.next_long(), "a zombie with no target hurt by a fall drew for reinforcements")
    var struck = zombie.living.body.random
    _ = struck.next_float()
    _ = zombie.after_hurt(Hurt { hurt: true }, true, by_player)
    check(zombie.living.body.random.next_long() == struck.next_long(), "a zombie hurt by a player on hard didn't draw for reinforcements")
    zombie.target = some(1)
    var hunting = zombie.living.body.random
    _ = hunting.next_float()
    _ = zombie.after_hurt(Hurt { hurt: true }, true, fall)
    check(zombie.living.body.random.next_long() == hunting.next_long(), "a zombie with a target hurt on hard didn't draw for reinforcements")
    var easy = zombie.living.body.random
    _ = zombie.after_hurt(Hurt { hurt: true }, false, by_player)
    check(zombie.living.body.random.next_long() == easy.next_long(), "a zombie hurt off hard drew for reinforcements")
    zombie.target = none
    // The first seed whose pack is babies and whose baby drew a new chicken.
    var seed: i64 = 0
    loop {
        var probe = LegacyRandom.new(seed)
        let (b, c) = zombie_draws(mut probe)
        if b and c {
            break
        }
        seed += 1
    }
    var mk = maker(s)
    var br = LegacyRandom.new(seed)
    var bm = LegacyRandom.new(seed)
    var small = animal(s, ZOMBIE, "zombie", 8, 156)
    small.spawning_in(s.facts, 0)
    let bg = small.finalize_spawn(none, Occasion.plain(), mut mk, mut br) ?? panic("a baby zombie's pack has no group")
    _ = zombie_draws(mut bm)
    var twin = maker(s)
    var chick = twin.make_kind(CHICKEN, 0.5, 5.0, 0.5, 0) ?? panic("no chicken")
    chick.living.snap_to(0.5, 5.0, 0.5, small.living.body.y_rot, 0.0f32)
    _ = chick.finalize_spawn(none, Occasion.plain(), mut nobody, mut bm)
    zombie_rest(mut bm)
    check(bg.baby and small.baby() and small.living.data.flag(BABY) and small.living.body.width == 0.49f32 and small.living.body.height == 0.98f32 and small.living.body.eyes == 0.775f32, "a baby zombie's size")
    check(mk.made.len() == 1 and mk.made[0].species == CHICKEN and mk.made[0].jockey and mk.made[0].living.body.id == 101 and mk.riders.is_empty(), "a baby zombie's new chicken")
    check(mk.made[0].variant == chick.variant and mk.made[0].living.body.y_rot == small.living.body.y_rot, "a jockey's chicken isn't made where its zombie stands")
    check(br.next_long() == bm.next_long(), "a chicken jockey's finalizing drew other than vanilla")
    let speed = attribute_id("minecraft:movement_speed") ?? panic("no speed")
    let base = f64(0.23f32)
    check(small.living.attributes.value(speed) == base + base * 0.5, "a baby zombie isn't half as fast again")
    println("zombies: finalized as vanilla, a baby's new chicken (seed {seed}), their attributes from their own random")
}

// What picking up reads of a few items (CAL-159): a helmet's equippable, for the head, with its
// sound, and its armor, an iron or a golden one's 2 and a diamond one's 3; and a sword's attack
// damage, an iron one's 5 and a wooden one's 3; nothing else.
struct Gear {}

impl Wearing for Gear {
    fn worn_component(self, stack: Tag, name: String) -> Tag? {
        let Tag.Compound(m) = stack else return none
        let Tag.Str(item) = m["id"].copy() else return none
        let helmet = item.ends_with("_helmet")
        if name == "minecraft:equippable" {
            if not helmet {
                return none
            }
            var e = JavaHashMap<String, Tag>()
            e.insert(String("slot"), Tag.Str(String("head")))
            e.insert(String("equip_sound"), Tag.Str(String("minecraft:item.armor.equip_iron")))
            return some(Tag.Compound(e))
        }
        if name != "minecraft:attribute_modifiers" {
            return none
        }
        if item == "minecraft:diamond_helmet" {
            return some(gear_modifier("minecraft:armor", 3.0, "head"))
        }
        if helmet {
            return some(gear_modifier("minecraft:armor", 2.0, "head"))
        }
        if item == "minecraft:iron_sword" {
            return some(gear_modifier("minecraft:attack_damage", 5.0, "mainhand"))
        }
        if item == "minecraft:wooden_sword" {
            return some(gear_modifier("minecraft:attack_damage", 3.0, "mainhand"))
        }
        return none
    }

    fn worn_types(self, set: Tag) -> List<i32> {
        _ = set
        return List<i32>()
    }

    fn worn_enchantments(self, stack: Tag) -> List<(i32, JavaHashMap<String, Tag>)> {
        _ = stack
        return List<(i32, JavaHashMap<String, Tag>)>()
    }
}

// An `attribute_modifiers` of one modifier, adding `amount` to `attribute` in `slot`.
fn gear_modifier(attribute: str, amount: f64, slot: str) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("type"), Tag.Str(String(attribute)))
    m.insert(String("id"), Tag.Str(String("minecraft:base")))
    m.insert(String("amount"), Tag.double(amount))
    m.insert(String("operation"), Tag.Str(String("add_value")))
    m.insert(String("slot"), Tag.Str(String(slot)))
    return Tag.List([Tag.Compound(m)])
}

// Picking up (CAL-159): a zombie doesn't want a glow ink sac; it takes up a sword in its main
// hand, kept from going, drawing and hearing nothing, then not a worse one; one of three iron
// helmets on its head, its equip sound's seed drawn from its random; not a golden one, which
// defends as much, nor into its hand, which holds the sword; then a diamond one, which defends
// more, the iron one dropped by its sure chance, a draw; and what it took up it's sure to drop.
// A skeleton doesn't want a spear; it takes up a bow, which it'd rather hold, for its sword, and
// its weapon goal becomes its bow goal; and with it, it doesn't take up a sword.
fn pickups(s: Setup) {
    var lf = LivingFacts.new(s.f)
    lf.spears = [String("minecraft:iron_spear")]
    lf.skeleton_weapons = [String("minecraft:bow")]
    let gear = Gear {}
    var sounds = List<EntitySound>()
    var zombie = animal(s, ZOMBIE, "zombie", 7, 155)
    check(not zombie.wants_to_pick_up(lf, one("minecraft:glow_ink_sac")) and zombie.wants_to_pick_up(lf, one("minecraft:iron_spear")), "what a zombie wants")
    var calm = zombie.living.body.random
    let sword = zombie.equip_if_possible(lf, gear, one("minecraft:iron_sword"), mut sounds)
    check(sword == some(one("minecraft:iron_sword")) and zombie.living.equipment[0] == sword and zombie.persistence_required, "a zombie's sword")
    check(zombie.living.body.random.next_long() == calm.next_long() and sounds.is_empty(), "a zombie drew or heard taking up a sword")
    check(zombie.equip_if_possible(lf, gear, one("minecraft:wooden_sword"), mut sounds) == none, "a zombie took up a worse sword")
    let Tag.Compound(three) = one("minecraft:iron_helmet") else panic("no helmet")
    var helmets = three.copy()
    helmets.insert(String("count"), Tag.Int(3))
    var heard = zombie.living.body.random
    let helmet = zombie.equip_if_possible(lf, gear, Tag.Compound(helmets), mut sounds)
    check(helmet == some(one("minecraft:iron_helmet")) and zombie.living.equipment[5] == helmet, "a zombie's helmet, one of three")
    check(sounds.len() == 1 and sounds[0].sound == "item.armor.equip_iron" and sounds[0].seed == some(heard.next_long()), "a helmet's equip sound")
    check(zombie.equip_if_possible(lf, gear, one("minecraft:golden_helmet"), mut sounds) == none, "a zombie took up a helmet that defends as much")
    var dropping = zombie.living.body.random
    _ = dropping.next_float()
    let seed = dropping.next_long()
    let better = zombie.equip_if_possible(lf, gear, one("minecraft:diamond_helmet"), mut sounds)
    check(better == some(one("minecraft:diamond_helmet")) and sounds.len() == 2 and sounds[1].seed == some(seed), "a zombie's better helmet")
    var spilled = false
    for w in zombie.living.shown {
        if let Shown.Spilled(sp) = w {
            spilled = sp.stack == one("minecraft:iron_helmet")
        }
    }
    check(spilled, "the iron helmet not dropped")
    let drops = zombie.equipment_drops(gear, false)
    check(drops.len() == 2 and drops[0] == one("minecraft:iron_sword") and drops[1] == one("minecraft:diamond_helmet"), "what a zombie took up isn't sure to drop")
    var skeleton = animal(s, SKELETON, "skeleton", 8, 155)
    check(not skeleton.wants_to_pick_up(lf, one("minecraft:iron_spear")), "a skeleton wants a spear")
    _ = skeleton.equip_if_possible(lf, gear, one("minecraft:iron_sword"), mut sounds)
    let bow = skeleton.equip_if_possible(lf, gear, one("minecraft:bow"), mut sounds)
    check(bow == some(one("minecraft:bow")) and skeleton.living.equipment[0] == bow, "a skeleton didn't take up a bow for its sword")
    check(skeleton.equip_if_possible(lf, gear, one("minecraft:iron_sword"), mut sounds) == none, "a skeleton took up a sword for its bow")
    let (goal, _) = skeleton.goals.take_weapon_goal() ?? panic("a skeleton with no weapon goal")
    let bowed = match goal {
        Goal.Bow(_) => true,
        _ => false,
    }
    check(bowed, "a skeleton with a bow hasn't its bow goal")
    println("pickups: a zombie's sword and helmets, the better one taken up and the old dropped, its equip sound's seed; a skeleton's bow and its goal")
}

// A skeleton's `finalizeSpawn` at a plain occasion from the level's random: `Mob`'s draws, its
// armor's, its bow's enchanting's, then its loot.
fn skeleton_draws(mirror: mut LegacyRandom) {
    _ = mirror.next_double()
    _ = mirror.next_double()
    for _ in 0..4 {
        _ = mirror.next_float()
    }
}

// A skeleton finalized with its bow; on hard at a special multiplier of 1, its armor by its
// tier, head first and then each further piece unless a tenth's draw stops it; on Halloween a
// pumpkin on its head, never dropped.
fn skeletons(s: Setup) {
    var nobody = Unmade {}
    var r = LegacyRandom.new(400)
    var mirror = LegacyRandom.new(400)
    var skeleton = animal(s, SKELETON, "skeleton", 7, 155)
    _ = skeleton.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
    skeleton_draws(mut mirror)
    check(skeleton.living.equipment[0] == some(one("minecraft:bow")) and skeleton.living.equipment[5] == none, "a skeleton's bow")
    check(r.next_long() == mirror.next_long(), "a skeleton's finalizing drew other than vanilla")
    let topped = Occasion { local: LocalDifficulty { base: Difficulty.Hard, effective: 6.0f32 } }
    var seed: i64 = 0
    loop {
        var probe = LegacyRandom.new(seed)
        _ = probe.next_double()
        _ = probe.next_double()
        _ = probe.next_float()
        if probe.next_float() < 0.15f32 {
            break
        }
        seed += 1
    }
    var ar = LegacyRandom.new(seed)
    var am = LegacyRandom.new(seed)
    var armored = animal(s, SKELETON, "skeleton", 8, 155)
    _ = armored.finalize_spawn(none, topped, mut nobody, mut ar)
    _ = am.next_double()
    _ = am.next_double()
    _ = am.next_float()
    _ = am.next_float()
    var tier = am.next_int_below(3)
    for _ in 0..3 {
        if am.next_float() < 0.1087f32 {
            tier += 1
        }
    }
    var pieces = 1
    for _ in 0..3 {
        if am.next_float() < 0.1f32 {
            break
        }
        pieces += 1
    }
    for _ in 0..pieces + 2 {
        _ = am.next_float()
    }
    let materials = ["leather", "copper", "golden", "chainmail", "iron", "diamond"]
    let material = materials[usize.wrap(tier)]
    let names = ["helmet", "chestplate", "leggings", "boots"]
    for i in 0usize..4usize {
        let slot = 5 - i
        let want: Tag? = if i32.wrap(i) < pieces { some(one_named("minecraft:{material}_{names[i]}")) } else { none }
        if armored.living.equipment[slot] != want {
            panic("an armored skeleton's slot {slot} isn't its tier {tier}'s, {pieces} pieces")
        }
    }
    check(ar.next_long() == am.next_long(), "an armored skeleton's finalizing drew other than its armor's and enchanting's")
    // Halloween: the first seed whose pumpkin draw comes up.
    let spooky = Occasion { local: LocalDifficulty.new(Difficulty.Normal, 0, 0, 0.0f32), halloween: true }
    var hseed: i64 = 0
    loop {
        var probe = LegacyRandom.new(hseed)
        skeleton_draws(mut probe)
        if probe.next_float() < 0.25f32 {
            break
        }
        hseed += 1
    }
    var hr = LegacyRandom.new(hseed)
    var hm = LegacyRandom.new(hseed)
    var pumpkin = animal(s, SKELETON, "skeleton", 9, 155)
    _ = pumpkin.finalize_spawn(none, spooky, mut nobody, mut hr)
    skeleton_draws(mut hm)
    _ = hm.next_float()
    let lantern = hm.next_float() < 0.1f32
    let head = if lantern { "minecraft:jack_o_lantern" } else { "minecraft:carved_pumpkin" }
    check(pumpkin.living.equipment[5] == some(one(head)) and hr.next_long() == hm.next_long(), "a skeleton's Halloween pumpkin")
    let Tag.Compound(pm) = pumpkin.saved() else panic("a skeleton's tag isn't a compound")
    let Tag.Compound(chances) = pm["drop_chances"] else panic("a pumpkin's drop chance isn't saved")
    check(chances.len() == 1 and chances["head"] == Tag.Float(0.0f32), "a pumpkin's drop chance")
    println("skeletons: a bow, armor of tier {tier} in {pieces} pieces (seed {seed}), a Halloween pumpkin (seed {hseed})")
}

// A spider finalized: `Mob`'s draws, then 1 in 100 its rider, a skeleton made where it stands and
// finalized, added after it; its pack's group, its effect drawn on hard by a tenth of the special
// multiplier and given it for ever (CAL-163).
fn spiders(s: Setup) {
    var nobody = Unmade {}
    var r = LegacyRandom.new(400)
    var mirror = LegacyRandom.new(400)
    var spider = animal(s, SPIDER, "spider", 7, 155)
    let g = spider.finalize_spawn(none, Occasion.plain(), mut nobody, mut r) ?? panic("a spider's pack has no group")
    _ = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_float()
    let rider = mirror.next_int_below(100) == 0
    check(not rider and g.spider and g.effect == -1 and r.next_long() == mirror.next_long(), "a spider's finalizing drew other than vanilla")
    var seed: i64 = 0
    loop {
        var probe = LegacyRandom.new(seed)
        _ = probe.next_double()
        _ = probe.next_double()
        _ = probe.next_float()
        if probe.next_int_below(100) == 0 {
            break
        }
        seed += 1
    }
    var mk = maker(s)
    var jr = LegacyRandom.new(seed)
    var jm = LegacyRandom.new(seed)
    var jockey = animal(s, SPIDER, "spider", 8, 155)
    _ = jockey.finalize_spawn(none, Occasion.plain(), mut mk, mut jr)
    _ = jm.next_double()
    _ = jm.next_double()
    _ = jm.next_float()
    _ = jm.next_int_below(100)
    skeleton_draws(mut jm)
    check(mk.riders.len() == 1 and mk.made.is_empty() and mk.riders[0].species == SKELETON and mk.riders[0].living.equipment[0] == some(one("minecraft:bow")), "a spider's rider")
    check(jr.next_long() == jm.next_long(), "a spider jockey's finalizing drew other than vanilla")
    let topped = Occasion { local: LocalDifficulty { base: Difficulty.Hard, effective: 6.0f32 } }
    var eseed: i64 = 0
    loop {
        var probe = LegacyRandom.new(eseed)
        _ = probe.next_double()
        _ = probe.next_double()
        _ = probe.next_float()
        if probe.next_int_below(100) != 0 and probe.next_float() < 0.1f32 {
            break
        }
        eseed += 1
    }
    var er = LegacyRandom.new(eseed)
    var em = LegacyRandom.new(eseed)
    var strong = animal(s, SPIDER, "spider", 9, 155)
    let eg = strong.finalize_spawn(none, topped, mut nobody, mut er) ?? panic("no group")
    _ = em.next_double()
    _ = em.next_double()
    _ = em.next_float()
    _ = em.next_int_below(100)
    _ = em.next_float()
    let effect = em.next_int_below(5)
    check(eg.effect == effect and er.next_long() == em.next_long(), "a spider's pack's effect on hard")
    let kinds: List<i32> = [0, 0, 4, 9, 13]
    check(strong.living.effects.len() == 1 and strong.living.effects[0].id == kinds[usize.wrap(effect)] and strong.living.effects[0].duration() == -1, "a spider's pack's effect not given it for ever")
    let next = strong.finalize_spawn(some(eg), topped, mut nobody, mut er) ?? panic("no group")
    check(next.effect == effect, "a spider's pack doesn't share its effect")
    println("spiders: a rider (seed {seed}), a pack's effect on hard (seed {eseed})")
}

// A zombie's tick in light over half where monsters burn: its ticks doing nothing three a tick,
// and its burn's draw after its ambient sound's, from its own random, its goals taken away, as
// they draw too (CAL-159). A creeper ignited swells to its fuse, its primed sound once, its swell
// goal, with no target, setting it to shrink after each tick's swell, as vanilla's does.
fn lit(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone"), lit: 0.75f32, burn: true }
    var zombie = animal(s, ZOMBIE, "zombie", 7, 155)
    zombie.goals = GoalSelector()
    zombie.targets = GoalSelector()
    zombie.living.body.y = 1.0
    var its = zombie.living.body.random
    var sounds = List<EntitySound>()
    var time = 0
    var paths = PathTypeCache()
    for _ in 0..10 {
        zombie.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
        let drawn = its.next_int_below(1000)
        let due = drawn < time
        time += 1
        if due {
            time = -80
            _ = its.next_float()
            _ = its.next_float()
        }
        _ = its.next_float()
    }
    check(zombie.no_action_time == 30, "a zombie in light didn't do nothing three times as fast")
    check(zombie.living.body.random.next_long() == its.next_long(), "a zombie's tick drew other than its ambient sound and its burn")
    let dark = World { stone: f_state(s.f, "minecraft:stone") }
    var creeper = animal(s, CREEPER, "creeper", 8, 155)
    creeper.living.body.y = 1.0
    creeper.living.data.set(MONSTER_OWN + 2, Value.Bool(true))
    var heard = List<EntitySound>()
    for _ in 0..40 {
        creeper.tick(s.lf, s.f, s.m, s.t, dark, Sizes {}, mut paths, List<Follower>(), -64, false, mut heard)
    }
    var primed = 0
    for h in heard {
        if h.sound == "entity.creeper.primed" and h.source == HOSTILE_SOURCE and h.pitch == 0.5f32 {
            primed += 1
        }
    }
    check(primed == 1 and creeper.swell == 30 and creeper.living.data.number(MONSTER_OWN) == -1, "an ignited creeper's swell")
    println("lit: a zombie's ticks doing nothing and its burn's draw; a creeper's swell")
}

// Each monster's tag read back the same: a baby zombie's, with its doors and its drowning not
// begun; a creeper's fuse and radius; a skeleton's freezing not begun.
fn monster_saving(s: Setup) {
    var lines = List<Entry>()
    var zombie = animal(s, ZOMBIE, "zombie", 7, 155)
    zombie.set_zombie_baby(true)
    zombie.can_break_doors = true
    let tag = zombie.saved()
    let Tag.Compound(zm) = tag.copy() else panic("a zombie's tag isn't a compound")
    check(zm["IsBaby"] == Tag.Byte(1i8) and zm["CanBreakDoors"] == Tag.Byte(1i8) and zm["DrownedConversionTime"] == Tag.Int(-1) and zm["InWaterTime"] == Tag.Int(-1) and not zm.contains("Age"), "a zombie's tag")
    let back = Mob.loaded(s.lf, s.facts, zombie.living.kind, 7, 7, zm, mut lines) ?? panic("a zombie didn't read")
    check(back.baby() and back.living.body.width == 0.49f32 and back.can_break_doors and back.saved() == tag, "a baby zombie read back")
    var creeper = animal(s, CREEPER, "creeper", 8, 155)
    creeper.max_swell = 45
    let Tag.Compound(cm) = creeper.saved() else panic("a creeper's tag isn't a compound")
    check(cm["Fuse"] == Tag.Short(45i16) and cm["ExplosionRadius"] == Tag.Byte(3i8) and cm["powered"] == Tag.Byte(0i8) and cm["ignited"] == Tag.Byte(0i8), "a creeper's tag")
    let skeleton = animal(s, SKELETON, "skeleton", 9, 155)
    let Tag.Compound(sk) = skeleton.saved() else panic("a skeleton's tag isn't a compound")
    check(sk["StrayConversionTime"] == Tag.Int(-1) and sk["FreezingTime"] == Tag.Int(-1), "a skeleton's tag")
    for mb in [creeper.copy(), skeleton.copy(), animal(s, SPIDER, "spider", 10, 155)] {
        let saved = mb.saved()
        let Tag.Compound(m) = saved.copy() else panic("a tag isn't a compound")
        let read = Mob.loaded(s.lf, s.facts, mb.living.kind, 8, 8, m, mut lines) ?? panic("a monster didn't read")
        check(read.saved() == saved, "a monster's tag read back differently")
    }
    check(lines.is_empty(), "reading monsters logged")
    println("monster saving: their tags read back the same")
}

// A slime: made of size 1, 0.52 across, of the monsters' category but no monster, its sounds the
// hostile source's and none of its own; finalized with `Mob`'s draws, then its size's power of 2
// drawn, 1, 2 and 4 each found, its health its most and its speed by its size, turned as its head
// is where its size changed; its pack an ageable one without babies; landing first, before its
// hops, which `test/goals.calx` tries (CAL-159), its particles' draws and its squish, small for
// size 1; and its tag read back, its size less 1.
fn slimes(s: Setup) {
    var nobody = Unmade {}
    let fresh = animal(s, SLIME, "slime", 7, 155)
    check(fresh.category == MONSTER and not fresh.monster and not fresh.peaceful_ok and not fresh.ageable and fresh.slime_size() == 1, "a slime as it's made")
    check(fresh.living.body.width == 0.52f32 and fresh.living.body.height == 0.52f32 and fresh.living.body.eyes == 0.325f32, "a slime's size as it's made")
    check(fresh.living.body.sound_source == HOSTILE_SOURCE and fresh.ambient == none and fresh.living.own_step == none, "a slime's sounds")
    let speed = attribute_id(String("minecraft:movement_speed")) ?? panic("no movement speed")
    let most = attribute_id(String("minecraft:max_health")) ?? panic("no max health")
    var found = [false, false, false]
    var seed: i64 = 0
    var big: Mob? = none
    while not (found[0] and found[1] and found[2]) {
        var r = LegacyRandom.new(seed)
        var mirror = LegacyRandom.new(seed)
        var slime = animal(s, SLIME, "slime", 8, 155)
        slime.living.snap_to(0.5, 5.0, 0.5, 90.0f32, 0.0f32)
        let head = slime.living.y_head_rot
        let g = slime.finalize_spawn(none, Occasion.plain(), mut nobody, mut r) ?? panic("a slime's pack has no group")
        _ = mirror.next_double()
        _ = mirror.next_double()
        _ = mirror.next_float()
        let scale = mirror.next_int_below(3)
        if scale < 2 {
            _ = mirror.next_float()
        }
        let size = 1 << scale
        check(r.next_long() == mirror.next_long(), "a slime's finalizing drew other than vanilla")
        check(g.ageable and not g.babies and g.size == 1, "a slime's pack's group")
        check(slime.slime_size() == size and slime.living.body.width == 0.52f32 * f32.nearest(size), "a slime's size")
        check(slime.living.attributes.value(most) == f64(size * size) and slime.living.data.float(HEALTH) == f32.nearest(size * size), "a slime's health")
        check(slime.living.attributes.value(speed) == f64(0.2f32 + 0.1f32 * f32.nearest(size)), "a slime's speed")
        let turned = if size == 1 { 90.0f32 } else { head }
        check(slime.living.body.y_rot == turned and slime.sound_volume == 0.4f32 * f32.nearest(size), "a slime's turn and its sounds' volume")
        found[usize.wrap(scale)] = true
        if size == 4 {
            big = some(slime.copy())
        }
        seed += 1
    }
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var small = animal(s, SLIME, "slime", 9, 155)
    var sounds = List<EntitySound>()
    var paths = PathTypeCache()
    var squished = 0
    for _ in 0..40 {
        small.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
        for h in sounds {
            if h.sound == "entity.slime.squish_small" and h.source == HOSTILE_SOURCE and h.volume == 0.4f32 {
                squished += 1
            }
        }
        sounds.clear()
        if squished > 0 {
            break
        }
    }
    check(squished == 1 and small.was_on_ground and small.living.body.y == 1.0, "a slime's landing")
    var lines = List<Entry>()
    var four = big ?? panic("no slime of size 4")
    four.was_on_ground = true
    let tag = four.saved()
    let Tag.Compound(m) = tag.copy() else panic("a slime's tag isn't a compound")
    check(m["Size"] == Tag.Int(3) and m["wasOnGround"] == Tag.Byte(1i8) and not m.contains("Age") and not m.contains("InLove"), "a slime's tag")
    let back = Mob.loaded(s.lf, s.facts, four.living.kind, 9, 9, m, mut lines) ?? panic("a slime didn't read")
    check(back.slime_size() == 4 and back.living.body.width == 2.08f32 and back.living.attributes.value(most) == 16.0, "a slime's size read back")
    // Its attributes are made in another order as it's read, its size's first, as vanilla's hash
    // map has them in no order of its own; each is read back the same.
    let Tag.Compound(bm) = back.saved() else panic("a slime's tag isn't a compound")
    check(bm.len() == m.len(), "a slime's tag read back with other keys")
    for (k, v) in m {
        if k == "attributes" {
            let Tag.List(had) = v.copy() else panic("a slime's attributes aren't a list")
            let Tag.List(got) = bm[k].copy() else panic("a slime's attributes read back aren't a list")
            check(had.len() == got.len(), "a slime's attributes read back")
            for a in had {
                check(got.contains(a), "a slime's attribute read back differently")
            }
        } else {
            check(bm.contains(k) and bm[k] == v, "a slime's tag read back differently")
        }
    }
    check(lines.is_empty(), "reading a slime logged")
    println("slimes: sizes 1, 2 and 4 by seed {seed - 1} at the latest, a landing's squish, their tags")
}

// A zombie villager: its profession drawn from its own random after its UUID and before its turn,
// any of the 15, its villager data defined as that, so it's not paired until it changes; then
// finalized as a zombie is, its type the biome's first and its data final, paired then only where
// the type isn't plains; a zombie's draws after; and its tag read back, its villager data by name.
fn zombie_villagers(s: Setup) {
    var nobody = Unmade {}
    let professions = builtin_entries(24)
    check(professions.len() == 15 and professions[0] == "none", "the villager professions")
    var mirror = LegacyRandom.new(155)
    _ = mirror.next_long()
    _ = mirror.next_long()
    let profession = mirror.next_int_below(15)
    let turn = mirror.next_float() * 6.2831855f32
    var zv = animal(s, ZOMBIE_VILLAGER, "zombie_villager", 7, 155)
    check(zv.living.data.villager(MONSTER_OWN + 4) == (2, profession, 1) and zv.living.body.y_rot == turn, "a zombie villager's profession drawn as it's made")
    check(zv.living.data.is_default(MONSTER_OWN + 4) and zv.monster and zv.burns and zv.ambient == some(String("entity.zombie_villager.ambient")), "a zombie villager as it's made")
    var desert = s.facts.copy()
    desert.villager_types = [0, 2, 2, 2]
    zv.spawning_in(desert, 0)
    var r = LegacyRandom.new(400)
    var zm = LegacyRandom.new(400)
    _ = zv.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
    check(zv.living.data.villager(MONSTER_OWN + 4) == (0, profession, 1) and zv.living.data.flag(MONSTER_OWN + 5) and not zv.living.data.is_default(MONSTER_OWN + 4), "a zombie villager's type by its biome")
    var zombie = animal(s, ZOMBIE, "zombie", 8, 155)
    _ = zombie.finalize_spawn(none, Occasion.plain(), mut nobody, mut zm)
    check(r.next_long() == zm.next_long() and zv.baby() == zombie.baby(), "a zombie villager's finalizing drew other than a zombie's")
    var plains = animal(s, ZOMBIE_VILLAGER, "zombie_villager", 9, 156)
    plains.spawning_in(s.facts, 1)
    _ = plains.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
    check(plains.living.data.is_default(MONSTER_OWN + 4) and plains.living.data.flag(MONSTER_OWN + 5), "a plains zombie villager's data")
    var lines = List<Entry>()
    zv.villager_xp = 3
    let tag = zv.saved()
    let Tag.Compound(m) = tag.copy() else panic("a zombie villager's tag isn't a compound")
    let Tag.Compound(v) = m["VillagerData"].copy() else panic("a zombie villager's data isn't a compound")
    let named = "minecraft:{professions[usize.wrap(profession)]}"
    check(v["type"] == Tag.Str(String("minecraft:desert")) and v["profession"] == Tag.Str(named.copy()) and v["level"] == Tag.Int(1), "a zombie villager's data saved")
    check(m["VillagerDataFinalized"] == Tag.Byte(1i8) and m["ConversionTime"] == Tag.Int(-1) and m["Xp"] == Tag.Int(3) and m["DrownedConversionTime"] == Tag.Int(-1) and m.contains("IsBaby"), "a zombie villager's tag")
    let back = Mob.loaded(s.lf, s.facts, zv.living.kind, 7, 7, m, mut lines) ?? panic("a zombie villager didn't read")
    // Read back, it has its speed's attribute too, which `setBaby` makes as it reads its tag, as
    // vanilla's `getAttribute` does.
    let Tag.Compound(bm) = back.saved() else panic("a zombie villager's tag isn't a compound")
    check(read_back(m, bm) and back.living.data.villager(MONSTER_OWN + 4) == (0, profession, 1) and not back.removed_far_away(1.0e9), "a zombie villager read back")
    check(lines.is_empty(), "reading a zombie villager logged")
    println("zombie villagers: profession {named} drawn as it's made, a desert type as it's finalized")
}

// A villager's trades (CAL-160): one at level 2 with 65 experience trading an offer worth 10, the
// offer used once, its experience up by it, and up a level, its orb 3 to 6 drawn from its own
// random and 5 more; then one at level 3 with 75, which isn't enough for the next, its orb
// without the 5; and an offer that rewards no experience making no orb.
fn villager_trades(s: Setup) {
    let offer = parse(String("\{buy:\{count:6,id:\"minecraft:pumpkin\"\},sell:\{count:1,id:\"minecraft:emerald\"\},maxUses:12,xp:10,priceMultiplier:0.05f\}"))!
    let bare = parse(String("\{buy:\{id:\"minecraft:emerald\"\},sell:\{count:4,id:\"minecraft:apple\"\},rewardExp:0b\}"))!
    var fen = animal(s, VILLAGER, "villager", 21, 160)
    let (kind, profession, _) = fen.living.data.villager(OWN + 1)
    fen.living.data.set(OWN + 1, Value.Villager(kind, profession, 2))
    fen.villager_xp = 65
    fen.set_offers([offer.copy(), bare.copy()])
    var mirror = fen.living.body.random
    let first = 3 + mirror.next_int_below(4) + 5
    let up = fen.notify_trade(0)
    check(up.leveled and up.orb == some(first) and fen.villager_xp == 75 and fen.villager_level() == 3, "a villager's trade taking it up a level")
    let Tag.Compound(used) = fen.offers()[0].copy() else panic("an offer isn't a compound")
    check(used["uses"] == Tag.Int(1) and fen.ambient_sound_time == -fen.ambient_interval, "the offer used and the ambient timer put back")
    let second = 3 + mirror.next_int_below(4)
    let again = fen.notify_trade(0)
    check(not again.leveled and again.orb == some(second) and fen.villager_xp == 85 and fen.villager_level() == 3, "a trade short of the next level")
    _ = mirror.next_int_below(4)
    let none_given = fen.notify_trade(1)
    check(none_given.orb == none and fen.villager_xp == 86, "an offer rewarding no experience")
    println("villager trades: up to level 3 with an orb of {first}, then {second}")
}

// A villager's offers' demand updated, `MerchantOffer.updateDemand` (CAL-160): up by the uses,
// less the uses left, so 5 of 16 used is 6 less, none of 12 used 12 less, from the -3 it had, and
// half used none, left out as the codec leaves it out.
fn villager_demand(s: Setup) {
    let paper = parse(String("\{buy:\{count:24,id:\"minecraft:paper\"\},sell:\{id:\"minecraft:emerald\"\},maxUses:16,uses:5\}"))!
    let gold = parse(String("\{buy:\{id:\"minecraft:gold_ingot\"\},sell:\{id:\"minecraft:emerald\"\},maxUses:12,demand:-3\}"))!
    let half = parse(String("\{buy:\{id:\"minecraft:flint\"\},sell:\{id:\"minecraft:emerald\"\},maxUses:12,uses:6\}"))!
    var gi = animal(s, VILLAGER, "villager", 22, 170)
    gi.set_offers([paper.copy(), gold.copy(), half.copy()])
    gi.update_demand()
    let offers = gi.offers()
    let Tag.Compound(a) = offers[0].copy() else panic("an offer isn't a compound")
    let Tag.Compound(b) = offers[1].copy() else panic("an offer isn't a compound")
    let Tag.Compound(c) = offers[2].copy() else panic("an offer isn't a compound")
    check(a["demand"] == Tag.Int(-6) and a["uses"] == Tag.Int(5), "5 of 16 used")
    check(b["demand"] == Tag.Int(-15), "none of 12 used, from -3")
    check(not c.contains("demand"), "half used, its demand 0 left out")
    println("villager demand: -6, -15 and none")
}

// A villager's inventory (CAL-160): what it saved read as `fromItemList` reads it, 60 seeds, 2
// bread and 10 more seeds making a full stack, the bread, then the 6 left over; 12 seeds picked up
// going in with those 6, the full stack taking none; and saved in its slots' order.
fn villager_inventory(s: Setup) {
    var jo = animal(s, VILLAGER, "villager", 23, 180)
    let seeds = parse(String("\{count:60,id:\"minecraft:wheat_seeds\"\}"))!
    let bread = parse(String("\{count:2,id:\"minecraft:bread\"\}"))!
    let more = parse(String("\{count:10,id:\"minecraft:wheat_seeds\"\}"))!
    jo.kept.insert(String("Inventory"), Tag.List([seeds.copy(), bread.copy(), more.copy()]))
    let found = parse(String("\{count:12,id:\"minecraft:wheat_seeds\"\}"))!
    check(jo.pick_up_into(found.copy(), s.f) == 12, "12 seeds picked up")
    let Tag.Compound(saved) = jo.saved() else panic("a villager didn't save")
    let Tag.List(held) = saved["Inventory"].copy() else panic("a villager saved no inventory")
    var counts = List<String>()
    for t in held {
        let Tag.Compound(c) = t else continue
        let Tag.Str(id) = c["id"].copy() else continue
        let Tag.Int(n) = c["count"].copy() else continue
        counts.push("{id} {n}")
    }
    check(counts.len() == 3, "three stacks")
    check(counts[0] == "minecraft:wheat_seeds 64" and counts[1] == "minecraft:bread 2" and counts[2] == "minecraft:wheat_seeds 18", "the seeds merged as they're read and picked up")
    println("villager inventory: {counts[0]}, {counts[1]}, {counts[2]}")
}

// Whether `back`, a tag read back and saved again, has each key `m` has the same, with each of its
// attributes among those it has then, in any order.
fn read_back(m: JavaHashMap<String, Tag>, back: JavaHashMap<String, Tag>) -> bool {
    if back.len() != m.len() {
        return false
    }
    for (k, v) in m {
        if not back.contains(k) {
            return false
        }
        if k == "attributes" {
            let Tag.List(had) = v.copy() else return false
            let Tag.List(got) = back[k].copy() else return false
            for a in had {
                if not got.contains(a) {
                    return false
                }
            }
        } else if back[k] != v {
            return false
        }
    }
    return true
}

// A witch: finalized with its patrol leader's draw before `Mob`'s; each tick, without its AI,
// whose goals the rig's `witch` session holds to vanilla's (CAL-159), its ambient sound's draw,
// then its four potions' and its particles', entity event 15 where that's under 7.5 in 10,000;
// doing nothing twice as fast in the dark, as a raider does, `Raider.updateNoActionTime`, with no
// AI to count its ticks too; and its tag read back.
fn witches(s: Setup) {
    var nobody = Unmade {}
    var r = LegacyRandom.new(500)
    var mirror = LegacyRandom.new(500)
    var witch = animal(s, WITCH, "witch", 7, 155)
    check(witch.monster and not witch.burns and witch.ambient == some(String("entity.witch.ambient")) and witch.living.body.eyes == 1.62f32, "a witch as it's made")
    _ = witch.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
    _ = mirror.next_float()
    _ = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_float()
    check(r.next_long() == mirror.next_long() and not witch.can_join_raid, "a witch's finalizing drew other than vanilla")
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    witch.living.body.y = 1.0
    witch.living.data.set(MOB_FLAGS, Value.Byte(i8.wrap(NO_AI_FLAG)))
    var its = witch.living.body.random
    var sounds = List<EntitySound>()
    var time = 0
    var events = 0
    var paths = PathTypeCache()
    for _ in 0..3000 {
        witch.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
        let drawn = its.next_int_below(1000)
        let due = drawn < time
        time += 1
        if due {
            time = -80
            _ = its.next_float()
            _ = its.next_float()
        }
        for _ in 0..4 {
            _ = its.next_float()
        }
        if its.next_float() < 0.00075f32 {
            events += 1
        }
    }
    var shown = 0
    for sh in witch.living.shown {
        if sh == Shown.Event(15i8) {
            shown += 1
        }
    }
    check(witch.living.body.random.next_long() == its.next_long() and shown == events and events > 0, "a witch's ticks drew other than vanilla")
    check(witch.no_action_time == 6000, "a witch in the dark didn't do nothing twice as fast")
    var lines = List<Entry>()
    let tag = witch.saved()
    let Tag.Compound(m) = tag.copy() else panic("a witch's tag isn't a compound")
    check(m["PatrolLeader"] == Tag.Byte(0i8) and m["Patrolling"] == Tag.Byte(0i8) and m["Wave"] == Tag.Int(0) and m["CanJoinRaid"] == Tag.Byte(0i8), "a witch's tag")
    let back = Mob.loaded(s.lf, s.facts, witch.living.kind, 7, 7, m, mut lines) ?? panic("a witch didn't read")
    check(back.saved() == tag and lines.is_empty(), "a witch read back")
    println("witches: its finalizing's and ticks' draws, {events} times its particles in 3000 ticks")
}

// An enderman: finalized by `Mob`'s draws alone; angry at no one, its anger's end 0 as it's made
// and -1 read where none's saved; staying where it carries a block, but not air; and its tag read
// back.
fn endermen(s: Setup) {
    var nobody = Unmade {}
    var r = LegacyRandom.new(600)
    var mirror = LegacyRandom.new(600)
    var enderman = animal(s, ENDERMAN, "enderman", 7, 155)
    check(enderman.monster and enderman.living.body.height == 2.9f32 and enderman.ambient == some(String("entity.enderman.ambient")), "an enderman as it's made")
    _ = enderman.finalize_spawn(none, Occasion.plain(), mut nobody, mut r)
    _ = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_float()
    check(r.next_long() == mirror.next_long(), "an enderman's finalizing drew other than vanilla")
    var lines = List<Entry>()
    let tag = enderman.saved()
    let Tag.Compound(m) = tag.copy() else panic("an enderman's tag isn't a compound")
    check(m["anger_end_time"] == Tag.Long(0) and not m.contains("carriedBlockState"), "an enderman's tag")
    let back = Mob.loaded(s.lf, s.facts, enderman.living.kind, 7, 7, m, mut lines) ?? panic("an enderman didn't read")
    check(back.saved() == tag, "an enderman read back")
    var bare = m.copy()
    _ = bare.remove("anger_end_time")
    var air = JavaHashMap<String, Tag>()
    air.insert(String("Name"), Tag.Str(String("minecraft:air")))
    bare.insert(String("carriedBlockState"), Tag.Compound(air))
    let none_saved = Mob.loaded(s.lf, s.facts, enderman.living.kind, 8, 8, bare, mut lines) ?? panic("an enderman didn't read")
    let Tag.Compound(nm) = none_saved.saved() else panic("an enderman's tag isn't a compound")
    check(nm["anger_end_time"] == Tag.Long(-1) and not nm.contains("carriedBlockState"), "an enderman read without its anger, carrying air")
    // Its legacy anger, `AngerTime`, where its end isn't saved, read as the game time plus it; an
    // end saved as an int read as a number; and `AngerTime` left alone where the end's saved.
    var legacy = bare.copy()
    legacy.insert(String("AngerTime"), Tag.Int(300))
    var old = Mob.loaded(s.lf, s.facts, enderman.living.kind, 10, 10, legacy, mut lines) ?? panic("an enderman didn't read")
    old.anger_from(1000i64)
    let Tag.Compound(om) = old.saved() else panic("an enderman's tag isn't a compound")
    check(om["anger_end_time"] == Tag.Long(1300) and not om.contains("AngerTime"), "an enderman's legacy anger didn't end at the game time plus it")
    var both = legacy.copy()
    both.insert(String("anger_end_time"), Tag.Int(50))
    var ended = Mob.loaded(s.lf, s.facts, enderman.living.kind, 11, 11, both, mut lines) ?? panic("an enderman didn't read")
    ended.anger_from(1000i64)
    let Tag.Compound(em) = ended.saved() else panic("an enderman's tag isn't a compound")
    check(em["anger_end_time"] == Tag.Long(50), "an enderman's saved anger end, an int, wasn't read as a number before its legacy anger")
    var stone = JavaHashMap<String, Tag>()
    stone.insert(String("Name"), Tag.Str(String("minecraft:stone")))
    var carrying = m.copy()
    carrying.insert(String("carriedBlockState"), Tag.Compound(stone.copy()))
    var holder = Mob.loaded(s.lf, s.facts, enderman.living.kind, 9, 9, carrying, mut lines) ?? panic("an enderman didn't read")
    check(holder.carried() == none and holder.kept.contains("carriedBlockState"), "an enderman's carried block wasn't kept for the server to read")
    // The server reads the kept block as a state, as `readAdditionalSaveData` does: stone's is 1.
    holder.set_carried(some(1u32), some(Tag.Compound(stone)))
    check(holder.carried() == some(1u32), "an enderman didn't carry the block it read")
    holder.no_action_time = 10000
    var far = 0
    for _ in 0..2000 {
        if holder.check_despawn(false, some(1.0e9)) {
            far += 1
        }
    }
    check(far == 0 and lines.is_empty(), "an enderman carrying a block went")
    println("endermen: finalized by Mob's draws, their anger and carried blocks saved")
}

// A zombie horse: a horse's size, its category the monsters' though it's no monster, allowed in
// peaceful and burning; finalized with its rider first, a zombie made where it stands, turned as
// it is and finalized as a zombie alone would be, then holding an iron spear and added after it;
// then its jump and speed, a pack's group of foals 1 in 5 and `Mob`'s draws; a foal that never
// grows up; and its tag read back, a horse's without a variant or chest.
fn zombie_horses(s: Setup) {
    let zh = animal(s, ZOMBIE_HORSE, "zombie_horse", 7, 155)
    check(zh.category == MONSTER and not zh.monster and zh.peaceful_ok and zh.burns and zh.animal and zh.equine() and zh.living.body.width == 1.3964844f32, "a zombie horse as it's made")
    check(zh.ambient == some(String("entity.zombie_horse.ambient")) and zh.ambient_interval == 400 and zh.max_cluster == 6 and zh.removed_far_away(1.0), "a zombie horse's sounds and despawning")
    // A seed whose rider isn't a baby, so it makes no chicken.
    var seed: i64 = 0
    loop {
        var probe = LegacyRandom.new(seed)
        _ = probe.next_double()
        _ = probe.next_double()
        _ = probe.next_float()
        _ = probe.next_float()
        if not (probe.next_float() < 0.05f32) {
            break
        }
        seed += 1
    }
    var mk = maker(s)
    var r = LegacyRandom.new(seed)
    var horse = animal(s, ZOMBIE_HORSE, "zombie_horse", 7, 155)
    horse.living.snap_to(0.5, 5.0, 0.5, 45.0f32, 0.0f32)
    let g = horse.finalize_spawn(none, Occasion.plain(), mut mk, mut r) ?? panic("a zombie horse's pack has no group")
    var mirror = LegacyRandom.new(seed)
    var nobody = Unmade {}
    var alone = Mob.made(s.lf, s.facts, ZOMBIE, mk.riders[0].living.kind, 101, 901, 0.5, 5.0, 0.5)
    alone.living.snap_to(0.5, 5.0, 0.5, 45.0f32, 0.0f32)
    _ = alone.finalize_spawn(none, Occasion.plain(), mut nobody, mut mirror)
    let j1 = mirror.next_double()
    let j2 = mirror.next_double()
    let j3 = mirror.next_double()
    let s1 = mirror.next_double()
    let s2 = mirror.next_double()
    let s3 = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_float()
    check(r.next_long() == mirror.next_long() and g.ageable and g.baby_chance == 0.2f32 and g.size == 1, "a zombie horse's finalizing drew other than vanilla")
    check(mk.riders.len() == 1 and mk.made.is_empty() and mk.riders[0].species == ZOMBIE and mk.riders[0].living.body.y_rot == 45.0f32, "a zombie horse's rider")
    check(mk.riders[0].living.equipment[0] == some(one("minecraft:iron_spear")) and mk.riders[0].saved() == alone_with_spear(alone), "a zombie horse's rider finalized as a zombie, with its spear")
    let jump = attribute_id(String("minecraft:jump_strength")) ?? panic("no jump strength")
    let speed = attribute_id(String("minecraft:movement_speed")) ?? panic("no movement speed")
    let most = attribute_id(String("minecraft:max_health")) ?? panic("no max health")
    check(horse.living.attributes.value(jump) == 0.5 + j1 * 0.06666666666666667 + j2 * 0.06666666666666667 + j3 * 0.06666666666666667, "a zombie horse's jump")
    check(horse.living.attributes.value(speed) == (9.0 + s1 * 1.0 + s2 * 1.0 + s3 * 1.0) / f64(42.16f32) and horse.living.attributes.value(most) == 25.0, "a zombie horse's speed and health")
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var foal = animal(s, ZOMBIE_HORSE, "zombie_horse", 8, 155)
    foal.set_age(-2)
    foal.living.body.y = 1.0
    var sounds = List<EntitySound>()
    var paths = PathTypeCache()
    for _ in 0..5 {
        foal.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
    }
    check(foal.baby() and foal.age == -2, "a zombie foal grew up")
    var lines = List<Entry>()
    let tag = horse.saved()
    let Tag.Compound(m) = tag.copy() else panic("a zombie horse's tag isn't a compound")
    check(m.contains("EatingHaystack") and m.contains("Temper") and m.contains("Age") and not m.contains("Variant") and not m.contains("ChestedHorse"), "a zombie horse's tag")
    let back = Mob.loaded(s.lf, s.facts, horse.living.kind, 7, 7, m, mut lines) ?? panic("a zombie horse didn't read")
    let Tag.Compound(bm) = back.saved() else panic("a zombie horse's tag isn't a compound")
    check(read_back(m, bm) and lines.is_empty(), "a zombie horse read back")
    println("zombie horses: a rider with its spear (seed {seed}), then their jump and speed")
}

// A zombie's tag holding an iron spear in its main hand, as a zombie horse's rider is given one.
fn alone_with_spear(zombie: Mob) -> Tag {
    var z = zombie.copy()
    z.living.equipment[0] = some(one("minecraft:iron_spear"))
    return z.saved()
}

// Pushing (CAL-156): two pigs without AI side by side on stone, each pushing the other as it ticks,
// a twentieth over the root of their gap across, each push both ways, so after a tick each has
// two; one beside a chunk that doesn't tick its entities, which neither pushes nor is pushed; one
// beside a player, pushed away from them by its own push and by theirs; and 25 in one place, too
// near to push, the first drawing 4 more from its own random for the cramming than where the game
// rule is 0.
fn pushing(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    let nobody = List<Follower>()
    var pair = Entities.new()
    pair.add_mob(still_pig(s, 7, 0.3, 0.5))
    pair.add_mob(still_pig(s, 8, 0.8, 0.5))
    tick_once(s, mut pair, w, nobody)
    let gap = 0.8 - 0.3
    let p = gap / gap.sqrt() * f64(0.05f32)
    let a = pair.mob(7)
    let b = pair.mob(8)
    check(a.living.body.vx == -p - p and b.living.body.vx == p + p and a.living.body.vz == 0.0 and b.living.body.vz == 0.0, "two pigs pushed each other other than vanilla")
    check(a.living.body.needs_sync and b.living.body.needs_sync and a.living.body.x == 0.3, "pushed pigs to be sent, or moved without AI")
    var edge = Entities.new()
    edge.add_mob(still_pig(s, 7, 63.6, 0.5))
    edge.add_mob(still_pig(s, 8, 64.1, 0.5))
    tick_once(s, mut edge, w, nobody)
    check(edge.mob(7).living.body.vx == 0.0 and edge.mob(8).living.body.vx == 0.0, "a pig pushed one whose chunk doesn't tick")
    var near = Entities.new()
    near.add_mob(still_pig(s, 7, 10.4, 0.5))
    let player = Aabb { min_x: 9.7, min_y: 1.0, min_z: 0.2, max_x: 10.3, max_y: 2.8, max_z: 0.8 }
    let players: List<Follower> = [Follower { id: 1, x: 10.0, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false, pushable: some(player) }]
    tick_once(s, mut near, w, players)
    let across = 10.4 - 10.0
    let q = across / across.sqrt() * f64(0.05f32)
    check(near.mob(7).living.body.vx == q, "a pig wasn't pushed away from a player by its own push")
    // The pig's own push pushed the player away from it too, kept for the server (CAL-174).
    let by_pig = near.take_player_pushes()
    check(by_pig.len() == 1 and by_pig[0] == (1, -q, 0.0), "a pig's push of a player wasn't kept")
    let found = near.pushed_by_player(1, 10.0, 0.5, player, true, true, s.lf, s.f, w)
    check(found == 1 and near.mob(7).living.body.vx == q + q, "a player didn't push a pig away")
    let back = near.take_player_pushes()
    check(back.len() == 1 and back[0] == (1, -q, 0.0), "a player pushing a pig wasn't pushed back")
    check(near.pushed_by_player(1, 10.0, 0.5, player, false, false, s.lf, s.f, w) == 1 and near.mob(7).living.body.vx == q + q, "a spectator pushed a pig")
    check(near.take_player_pushes().is_empty(), "a spectator was pushed")
    var crammed = Entities.new()
    var spared = Entities.new()
    spared.cramming = 0
    for id in 7..32 {
        crammed.add_mob(still_pig(s, id, 20.5, 0.5))
        spared.add_mob(still_pig(s, id, 20.5, 0.5))
    }
    tick_once(s, mut crammed, w, nobody)
    tick_once(s, mut spared, w, nobody)
    var mirror = spared.mob(7).living.body.random
    _ = mirror.next_int_below(4)
    var drawn = crammed.mob(7).living.body.random
    check(drawn.next_long() == mirror.next_long() and crammed.mob(7).living.body.vx == 0.0, "the cramming's draw")
    println("pushing: two pigs a push of {p} each way, a player's {q}, the cramming's draw")
}

// A pig without AI standing on stone at x, 1, z.
fn still_pig(s: Setup, id: i32, x: f64, z: f64) -> Mob {
    var m = animal(s, PIG, "pig", id, i64(id) + 155)
    m.living.snap_to(x, 1.0, z, 0.0f32, 0.0f32)
    m.living.data.set_flag(MOB_FLAGS, NO_AI_FLAG, true)
    return m
}

// A tick of `store`'s entities in `w` with `players`.
fn tick_once(s: Setup, store: mut Entities, w: World, players: List<Follower>) {
    store.begin_tick()
    var sounds = List<EntitySound>()
    while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
    store.end_tick()
}

fn f_state(f: Facts, name: str) -> u32 {
    let b = f.block_named(String(name)) ?? panic("no {name}")
    return f.default_state(b)
}

// Mobs hurt in their own tick (D424): a cow at the bottom of water, its air at -19, hurt by 2 of
// `drown` at once with event 67 before its damage event, then every 20 ticks as its air runs out
// again, till the fifth hurt kills it, its loot table's and nothing else left to its level, and
// it lies dying; and a cow far below the level hurt by 4 of `out_of_world`, its cooldown's 10
// ticks between, dying on the third.
fn drowning(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone"), water: some(f_state(s.f, "minecraft:water")) }
    var cow = animal(s, COW, "cow", 7, 155)
    cow.living.body.y = 1.0
    cow.living.data.set_flag(MOB_FLAGS, NO_AI_FLAG, true)
    cow.living.data.set(AIR_SUPPLY, Value.Number(-19))
    var sounds = List<EntitySound>()
    var paths = PathTypeCache()
    var hurt_at = List<i32>()
    for tick in 0..90 {
        let before = cow.living.shown.len()
        cow.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
        for k in before..cow.living.shown.len() {
            if let Shown.Damaged(_) = cow.living.shown[k] {
                hurt_at.push(tick)
            }
        }
    }
    let every: List<i32> = [0, 20, 40, 60, 80]
    check(hurt_at == every, "a drowning cow wasn't hurt every 20 ticks")
    var events = 0
    var died = 0
    for e in cow.living.shown {
        match e {
            Shown.Event(n) => {
                if n == 67i8 {
                    events += 1
                }
            },
            Shown.Died(d) => {
                died += 1
                let (table, seed) = d.loot.copy() ?? (String(), -1i64)
                check(table == "minecraft:entities/cow" and seed == 0 and d.equipment.is_empty() and d.reward == 0 and d.killed_by == none, "a drowned cow's death wasn't its loot table's alone")
                check(d.damage == s.lf.damage.id("drown"), "a drowned cow didn't die of drowning")
            },
            _ => {},
        }
    }
    check(events == 5 and died == 1, "a drowning cow had other events or deaths")
    check(cow.living.dead_or_dying(), "a drowned cow isn't dying")
    var deep = animal(s, COW, "cow", 8, 155)
    deep.living.body.y = -200.0
    deep.living.data.set_flag(MOB_FLAGS, NO_AI_FLAG, true)
    var below = List<i32>()
    for tick in 0..30 {
        let before = deep.living.shown.len()
        deep.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
        for k in before..deep.living.shown.len() {
            if let Shown.Damaged(_) = deep.living.shown[k] {
                below.push(tick)
            }
        }
    }
    let tens: List<i32> = [0, 10, 20]
    check(below == tens, "a cow below the level wasn't hurt every 10 ticks")
    check(deep.living.dead_or_dying() and not deep.living.body.removed, "a cow below the level didn't die there")
    println("drowning: hurt every 20 ticks to its death, its loot left to its level; below the level, 4 every 10 ticks")
}

// Mobs in a wall (D425): a cow whose eyes are in stone hurt by 1 of `in_wall` at once, then every
// 10 ticks as its cooldown lets it; glass, which never suffocates, doesn't hold it, and farmland,
// which always does, holds it inside its collision shape but not above it, 15/16 of a block up;
// a shulker box holds it closed and not open (D440).
fn walls(s: Setup) {
    let stone = f_state(s.f, "minecraft:stone")
    let w = World { stone: stone, head: some(stone) }
    var cow = animal(s, COW, "cow", 9, 155)
    let eyes = f64(cow.living.body.eyes)
    cow.living.body.y = 2.5 - eyes
    cow.living.data.set_flag(MOB_FLAGS, NO_AI_FLAG, true)
    var sounds = List<EntitySound>()
    var paths = PathTypeCache()
    var hurt_at = List<i32>()
    for tick in 0..30 {
        let before = cow.living.shown.len()
        cow.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
        for k in before..cow.living.shown.len() {
            if let Shown.Damaged(kind) = cow.living.shown[k] {
                check(kind == s.lf.damage.id("in_wall"), "a cow in a wall was hurt by something else")
                hurt_at.push(tick)
            }
        }
    }
    let tens: List<i32> = [0, 10, 20]
    check(hurt_at == tens, "a cow in a wall wasn't hurt every 10 ticks")
    check(cow.living.health() == 7.0f32, "a cow in a wall lost other than 3 health")
    let glass = World { stone: stone, head: some(f_state(s.f, "minecraft:glass")) }
    check(not cow.living.in_wall(s.f, s.m, s.lf, glass), "glass suffocated a cow")
    let farmland = World { stone: stone, head: some(f_state(s.f, "minecraft:farmland")) }
    check(cow.living.in_wall(s.f, s.m, s.lf, farmland), "farmland didn't suffocate a cow inside it")
    cow.living.body.y = 2.95 - eyes
    check(not cow.living.in_wall(s.f, s.m, s.lf, farmland), "farmland suffocated a cow above its shape")
    check(cow.living.in_wall(s.f, s.m, s.lf, w), "stone didn't suffocate a cow at its top")
    cow.living.body.y = 2.5 - eyes
    let shut = World { stone: stone, head: some(f_state(s.f, "minecraft:shulker_box")) }
    check(cow.living.in_wall(s.f, s.m, s.lf, shut), "a closed shulker box didn't suffocate a cow")
    let open = World { stone: stone, head: some(f_state(s.f, "minecraft:shulker_box")), open: true }
    check(not cow.living.in_wall(s.f, s.m, s.lf, open), "an open shulker box suffocated a cow")
    println("walls: hurt every 10 ticks in stone; not in glass, nor above farmland's shape, nor in an open shulker box")
}

// A mob's fall (D477): a cow dropped 6 blocks onto stone hurt by 3 of `fall` once, as it lands,
// to 7 health, its hurt sound right after the fall's sounds, its own small fall and the stone's,
// as vanilla's `causeFallDamage` plays them before it hurts.
fn falling(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var cow = animal(s, COW, "cow", 10, 155)
    cow.living.body.y = 7.0
    var sounds = List<EntitySound>()
    var paths = PathTypeCache()
    for _ in 0..40 {
        cow.tick(s.lf, s.f, s.m, s.t, w, Sizes {}, mut paths, List<Follower>(), -64, false, mut sounds)
    }
    var hurt = 0
    for e in cow.living.shown {
        if let Shown.Damaged(kind) = e {
            check(kind == s.lf.damage.id("fall"), "a falling cow was hurt by something else")
            hurt += 1
        }
    }
    check(hurt == 1, "a cow that fell 6 blocks wasn't hurt once")
    check(cow.living.health() == 7.0f32, "a cow that fell 6 blocks lost other than 3 health")
    var fell = sounds.len()
    for i in 0..sounds.len() {
        if sounds[i].sound == "entity.generic.small_fall" and fell == sounds.len() {
            fell = i
        }
    }
    check(fell + 2 < sounds.len(), "a falling cow's fall wasn't heard")
    check(sounds[fell + 1].sound == "block.stone.fall" and sounds[fell + 2].sound == "entity.cow.hurt", "a falling cow's hurt wasn't heard right after its fall")
    println("falling: hurt by 3 of a 6-block fall as it lands, after the fall's sounds")
}

// Spears (D480): the iron spear's `kinetic_weapon` and `attack_range` as their codecs read them,
// a mob's reach with it half the spear's own; its conditions as `test` has them, at a mob's
// fifth; a zombie using it for 72000 ticks, each tick of its use seeing the ticks left, what it
// hit spared for its contact cooldown, then hit again, and nothing kept once it's let go; and the
// view vectors of a look south, west and down.
fn spears(s: Setup) {
    var hurt = JavaHashMap<String, Tag>()
    hurt.insert(String("max_duration_ticks"), Tag.Int(225))
    hurt.insert(String("min_relative_speed"), Tag.Float(4.6f32))
    var knock = JavaHashMap<String, Tag>()
    knock.insert(String("max_duration_ticks"), Tag.Int(135))
    knock.insert(String("min_speed"), Tag.Float(5.1f32))
    var c = JavaHashMap<String, Tag>()
    c.insert(String("damage_conditions"), Tag.Compound(hurt))
    c.insert(String("knockback_conditions"), Tag.Compound(knock))
    c.insert(String("delay_ticks"), Tag.Int(12))
    c.insert(String("damage_multiplier"), Tag.Float(0.95f32))
    let spear = kinetic_of(Tag.Compound(c))
    check(spear.delay == 12 and spear.contact_cooldown == 10 and spear.multiplier == 0.95f32 and spear.dismount == none, "the iron spear's kinetic_weapon wasn't read as its codec reads it")
    let hurts = spear.damage ?? panic("the iron spear has no damage conditions")
    let knocks = spear.knockback ?? panic("the iron spear has no knockback conditions")
    check(hurts.max_ticks == 225 and hurts.min_relative == 4.6f32 and hurts.min_speed == 0.0f32 and knocks.min_speed == 5.1f32, "the iron spear's conditions weren't read")
    let fifth = f64(0.2f32)
    check(hurts.test(225, 1.3, 1.3, fifth) and not hurts.test(226, 1.3, 1.3, fifth) and not hurts.test(0, 1.3, 0.9, fifth), "a spear's damage condition at a mob's fifth")
    check(knocks.test(0, 1.03, 0.0, fifth) and not knocks.test(0, 1.0, 5.0, fifth), "a spear's knockback condition at a mob's fifth")
    var range = JavaHashMap<String, Tag>()
    range.insert(String("min_reach"), Tag.Float(2.0f32))
    range.insert(String("max_reach"), Tag.Float(4.5f32))
    range.insert(String("hitbox_margin"), Tag.Float(0.125f32))
    range.insert(String("mob_factor"), Tag.Float(0.5f32))
    let reach = reach_of(some(Tag.Compound(range)))
    check(reach.least == 1.0 and reach.most == 2.25 and reach.margin == 0.125, "a mob's reach with the iron spear isn't half its own")
    let bare = reach_of(none)
    check(bare.least == 0.0 and bare.most == 3.0 and bare.margin == f64(0.3f32), "attack_range's defaults")
    var zombie = animal(s, ZOMBIE, "zombie", 7, 155)
    var item = JavaHashMap<String, Tag>()
    item.insert(String("id"), Tag.Str(String("minecraft:iron_spear")))
    item.insert(String("count"), Tag.Int(1))
    zombie.living.equipment[0] = some(Tag.Compound(item))
    zombie.living.start_using_kinetic(0, spear, 0)
    check(zombie.living.using_item(), "a zombie with a spear didn't use it")
    check(zombie.living.updating_using() == some(72000) and zombie.living.updating_using() == some(71999), "a spear's use isn't 72000 ticks, each seen as it ticks")
    check(not zombie.living.stabbed_lately(9, 100, 10) and zombie.living.stabbed_lately(9, 109, 10), "an entity a spear hit isn't spared for its contact cooldown")
    check(not zombie.living.stabbed_lately(9, 110, 10) and zombie.living.stabbed_lately(9, 119, 10), "an entity a spear hit isn't hit again after its contact cooldown")
    zombie.living.stop_using()
    check(zombie.living.use_kinetic == none and zombie.living.recent_stabs == none and not zombie.living.stabbed_lately(9, 300, 10), "a spear let go keeps what it hit")
    let (sx, sy, sz) = view_vector(0.0f32, 0.0f32)
    let (wx, wy, wz) = view_vector(0.0f32, 90.0f32)
    let (dx, dy, dz) = view_vector(90.0f32, 0.0f32)
    check(sx.abs() < 1.0e-6 and sy == 0.0 and sz == 1.0, "the view vector of a look south")
    check(wx == -1.0 and wy == 0.0 and wz.abs() < 1.0e-6, "the view vector of a look west")
    check(dx.abs() < 1.0e-6 and dy == -1.0 and dz.abs() < 1.0e-6, "the view vector of a look down")
    println("spears: the iron spear's components read, its conditions at a mob's fifth, its use's ticks, what it hit spared 10 ticks")
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    let t = BodyFacts.new(f)
    let lf = LivingFacts.new(f)
    let kinds = builtin_entries(6)
    var kind: u32? = none
    for i in 0..kinds.len() {
        if kinds[i] == "mooshroom" {
            kind = some(u32.wrap(i))
        }
    }
    let s = Setup { f: f, m: m, t: t, lf: lf, kind: kind ?? panic("no mooshroom type"), facts: MobFacts.vanilla(4, [1], [2]), kinds: kinds.copy() }
    made(s)
    finalized(s)
    despawning(s)
    saving(s)
    listed(s)
    sizes(s)
    variants(s)
    colors(s)
    farm_saving(s)
    laying(s)
    horses(s)
    grazing(s)
    horse_saving(s)
    equipment(s)
    difficulty()
    monsters(s)
    zombies(s)
    skeletons(s)
    pickups(s)
    spiders(s)
    lit(s)
    monster_saving(s)
    slimes(s)
    zombie_villagers(s)
    villager_trades(s)
    villager_demand(s)
    villager_inventory(s)
    witches(s)
    endermen(s)
    zombie_horses(s)
    pushing(s)
    drowning(s)
    walls(s)
    falling(s)
    spears(s)
    println("ok")
}
