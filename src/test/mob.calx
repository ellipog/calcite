/// Checks mobs, `world.mob` (CAL-156): a mooshroom as it's made, its turn drawn after its UUID and
/// its health its most; finalized as natural spawning finalizes it from the level's random, its
/// follow range's random spawn bonus and its hand, a pack's first never a baby and the rest one at
/// its chance, a baby half the size; whether it goes, `checkDespawn`; its saved tag, read back the
/// same; and one in a level's entities on stone, ticked in their tick list, mooing now and then
/// as its own random says. Then the other farm animals: each one's size and sounds, a chicken's
/// egg time drawn after its turn; their variants picked by the biome's selectors and drawn with
/// their sound variants as `finalizeSpawn` draws them; a sheep's color by its climate, pink 1 in
/// 500; their tags read back the same; and a chicken falling slowly and laying its egg. And
/// horses and donkeys: their sizes, `finalizeSpawn`'s draws, a horses' pack sharing its variant;
/// their health brought within its most on their first tick, healing and grazing; and their tags
/// read back the same.
module test.mob

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.attributes.{attribute_id}
import world.body.{BodyFacts, EntitySound}
import world.chunk.{BlockStates}
import world.collision.{CollisionBlocks}
import world.entities.{EntityTicking, Entities, StackSizes}
import world.entity_data.{BABY, MOOSHROOM_TYPE}
import world.entity_facts.{CREATURE}
import world.experience_orb.{Follower}
import world.living.{LivingFacts, Shown}
import world.mob.{BABY_START_AGE, CHICKEN, COW, DONKEY, HORSE, Mob, OWN, PIG, SHEEP, SpawnGroup}
import world.movement.{MovementStates}
import world.variants.{MobFacts}
import worldgen.facts.{Facts}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// Stone below y 1, air above; loaded everywhere near.
struct World {
    stone: u32
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -64 or x >= 64 or z < -64 or z >= 64 {
            return none
        }
        return some(if y < 1 { self.stone } else { 0 })
    }
}

impl EntityTicking for World {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool {
        return chunk_x >= -4 and chunk_x < 4 and chunk_z >= -4 and chunk_z < 4
    }
}

struct Sizes {}

impl StackSizes for Sizes {
    fn stack_most(self, stack: Tag) -> i32 {
        return if stack == Tag.End { 0 } else { 64 }
    }
}

struct Setup {
    f: Facts
    m: MovementStates
    t: BodyFacts
    lf: LivingFacts
    kind: u32
    facts: MobFacts
    kinds: List<String>
}

// A mob of the kind `species`, its type named `name`, made at 0.5, 5, 0.5.
fn animal(s: Setup, species: i32, name: str, id: i32, seed: i64) -> Mob {
    var kind: u32 = 0
    for i in 0..s.kinds.len() {
        if s.kinds[i] == String(name) {
            kind = u32.wrap(i)
        }
    }
    return Mob.made(s.lf, s.facts, species, kind, id, seed, 0.5, 5.0, 0.5)
}

fn mooshroom(s: Setup, id: i32, seed: i64) -> Mob {
    return Mob.mooshroom(s.lf, s.kind, id, seed, 0.5, 1.0, 0.5)
}

// Made with seed 155, as an armor stand of that seed is: its turn drawn after its UUID, its health
// its most, the only value it pairs with that isn't its default; 0.9 across and 1.4 high.
fn made(s: Setup) {
    let mb = mooshroom(s, 7, 155)
    check(i64(mb.living.body.y_rot.to_bits()) == 1078705807 and mb.living.y_head_rot == mb.living.body.y_rot, "a mooshroom's turn isn't vanilla's")
    check(mb.living.health() == 10.0f32 and mb.category == CREATURE and mb.animal and mb.ageable, "a mooshroom's health or kind")
    let paired = mb.living.data.pack_non_default() ?? panic("a mooshroom has nothing to pair with")
    let health: List<u8> = [9, 3, 65, 32, 0, 0, 255]
    check(paired == health, "a mooshroom pairs with more than its health")
    check(mb.living.body.width == 0.9f32 and mb.living.body.height == 1.4f32 and mb.living.body.eyes == 1.3f32, "a mooshroom's size")
    check(not mb.baby() and not mb.left_handed() and not mb.no_ai() and mb.living.data.number(MOOSHROOM_TYPE) == 0, "a mooshroom's flags or type")
    println("made: its turn, health and size")
}

// `finalizeSpawn` with seed 400: the first of a pack draws no baby chance, then the bonus as
// `triangle(0, 0.11485)` draws it and its hand; the pack's group counts it.
fn finalized(s: Setup) {
    var r = LegacyRandom.new(400)
    var mirror = LegacyRandom.new(400)
    var mb = mooshroom(s, 7, 155)
    let group = mb.finalize_spawn(none, mut r) ?? panic("a mooshroom's pack has no group")
    let a = mirror.next_double()
    let b = mirror.next_double()
    let bonus = 0.0 + 0.11485000000000001 * (a - b)
    let left = mirror.next_float() < 0.05f32
    check(group.ageable and group.size == 1 and not mb.baby(), "the first of a pack isn't its group's first, grown")
    check(r.next_long() == mirror.next_long(), "finalizing drew other than the bonus and the hand")
    let follow = attribute_id("minecraft:follow_range") ?? panic("no follow range")
    let range = mb.living.attributes.value(follow)
    if range != 16.0 + 16.0 * bonus {
        panic("the follow range's random spawn bonus isn't vanilla's: {range}")
    }
    check(mb.left_handed() == left, "a mooshroom's hand isn't its draw")
    // Again with the bonus there, which isn't drawn twice.
    var again = LegacyRandom.new(400)
    var check_r = LegacyRandom.new(400)
    _ = mb.finalize_spawn(some(SpawnGroup { ageable: true, size: 1 }), mut again)
    _ = check_r.next_float()
    _ = check_r.next_float()
    check(again.next_long() == check_r.next_long(), "a bonus drawn twice, or a later one's baby chance not drawn")
    // The first seed whose first float is a baby's, 1 in 20: the pack's second is a baby, half
    // the size, its age to grow from.
    var seed: i64 = 0
    loop {
        var probe = LegacyRandom.new(seed)
        if probe.next_float() <= 0.05f32 {
            break
        }
        seed += 1
    }
    var br = LegacyRandom.new(seed)
    var calf = mooshroom(s, 8, 156)
    let next = calf.finalize_spawn(some(group), mut br) ?? panic("no group")
    check(next.size == 2 and calf.baby() and calf.age == BABY_START_AGE and calf.living.data.flag(BABY), "the pack's second isn't a baby at its chance")
    check(calf.living.body.width == 0.45f32 and calf.living.body.height == 0.7f32 and calf.living.body.eyes == 0.69f32, "a baby mooshroom's size")
    calf.set_age(0)
    check(not calf.baby() and not calf.living.data.flag(BABY) and calf.living.body.width == 0.9f32, "a grown calf's size")
    println("finalized: its bonus, hand and pack, a baby at its chance (seed {seed})")
}

// `checkDespawn`: an animal never goes for being far, nor in peaceful, which its type's allowed
// in; after 600 ticks doing nothing it draws its chance each tick from its own random, past 32
// blocks; within 32 its ticks doing nothing start again.
fn despawning(s: Setup) {
    var mb = mooshroom(s, 7, 155)
    check(not mb.check_despawn(true, none), "a mooshroom went in peaceful with no player")
    check(not mb.check_despawn(false, some(200.0 * 200.0)), "an animal went for being far")
    mb.no_action_time = 700
    var mirror = mb.living.body.random
    check(not mb.check_despawn(false, some(100.0 * 100.0)), "an animal went after doing nothing")
    _ = mirror.next_int_below(800)
    check(mb.living.body.random.next_long() == mirror.next_long() and mb.no_action_time == 700, "doing nothing past 32 blocks didn't draw its chance")
    var near = mooshroom(s, 8, 155)
    near.no_action_time = 700
    check(not near.check_despawn(false, some(10.0 * 10.0)) and near.no_action_time == 0, "within 32 blocks its ticks doing nothing didn't start again")
    var stays = mooshroom(s, 9, 155)
    stays.persistence_required = true
    stays.no_action_time = 700
    var same = stays.living.body.random
    _ = stays.check_despawn(false, some(100.0 * 100.0))
    check(stays.living.body.random.next_long() == same.next_long(), "one that must stay drew its chance")
    println("despawning: an animal stays, its chance drawn after 600 ticks")
}

// Its tag as vanilla saves a mooshroom's, read back the same; a brown one's type read.
fn saving(s: Setup) {
    let mb = mooshroom(s, 7, 155)
    let tag = mb.saved()
    let Tag.Compound(m) = tag else panic("a mooshroom's tag isn't a compound")
    check(m["id"] == Tag.Str(String("minecraft:mooshroom")) and m["Health"] == Tag.Float(10.0f32) and m["Type"] == Tag.Str(String("red")), "a mooshroom's id, health or type")
    check(m["Age"] == Tag.Int(0) and m["ForcedAge"] == Tag.Int(0) and m["AgeLocked"] == Tag.Byte(0i8) and m["InLove"] == Tag.Int(0), "an ageable mob's fields")
    check(m["CanPickUpLoot"] == Tag.Byte(0i8) and m["PersistenceRequired"] == Tag.Byte(0i8) and m["LeftHanded"] == Tag.Byte(0i8) and not m.contains("NoAI"), "a mob's fields")
    var lines = List<Entry>()
    let back = Mob.loaded(s.lf, s.facts, s.kind, 7, 7, m, mut lines) ?? panic("a mooshroom's tag didn't read back")
    check(back.saved() == tag, "a mooshroom's tag read back isn't the same")
    var odd = m.copy()
    odd.insert(String("Type"), Tag.Str(String("brown")))
    odd.insert(String("Age"), Tag.Int(-100))
    odd.insert(String("NoAI"), Tag.Byte(1i8))
    odd.insert(String("stew_effects"), Tag.List([]))
    let brown = Mob.loaded(s.lf, s.facts, s.kind, 8, 8, odd, mut lines) ?? panic("a brown mooshroom didn't read")
    check(brown.living.data.number(MOOSHROOM_TYPE) == 1 and brown.baby() and brown.no_ai() and brown.living.body.height == 0.7f32, "a brown calf's type, age or flags")
    let Tag.Compound(again) = brown.saved() else panic("a brown mooshroom's tag isn't a compound")
    check(again["Type"] == Tag.Str(String("brown")) and again["NoAI"] == Tag.Byte(1i8) and again["stew_effects"] == Tag.List([]), "a brown mooshroom's tag")
    check(lines.is_empty(), "loading mooshrooms logged something")
    println("saving: a mooshroom's tag as vanilla's, read back the same")
}

// One standing on stone in a level's entities for 400 ticks with a player 10 blocks off: it stays,
// stands still, and moos as its own random says, `entity.cow.ambient` at 0.4, each at least 120
// ticks after the last, an animal's interval.
fn listed(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var store = Entities.new()
    store.add_mob(mooshroom(s, 7, 155))
    let players: List<Follower> = [Follower { id: 1, x: 10.5, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false }]
    var moos = List<i32>()
    for tick in 1..=400 {
        store.begin_tick()
        var sounds = List<EntitySound>()
        while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
        store.end_tick()
        for e in sounds {
            if e.sound != "entity.cow.ambient" or e.volume != 0.4f32 {
                panic("a mooshroom played {e.sound}")
            }
            moos.push(tick)
        }
    }
    check(store.is_mob(7), "a mooshroom went")
    let mb = store.mob(7)
    check(mb.living.body.y == 1.0 and mb.living.body.on_ground and mb.no_action_time == 1, "a mooshroom moved or did nothing near a player")
    check(not moos.is_empty(), "a mooshroom never mooed in 400 ticks")
    for i in 1..moos.len() {
        check(moos[i] - moos[i - 1] >= 120, "a mooshroom mooed again too soon")
    }
    println("listed: it stays, stands and moos at ticks {moos}")
}

// Each kind's size grown and a baby's, its sounds by its sound variant, and a chicken's egg time,
// drawn from its own random right after its turn, as a mooshroom of its seed leaves it.
fn sizes(s: Setup) {
    let cow = animal(s, COW, "cow", 7, 155)
    check(cow.living.body.width == 0.9f32 and cow.living.body.height == 1.4f32 and cow.living.health() == 10.0f32, "a cow's size or health")
    check(cow.ambient == some(String("entity.cow.ambient")) and cow.sound_volume == 0.4f32 and cow.variant == 1 and cow.sound_variant == 0, "a cow's sounds or variants")
    var moody = animal(s, COW, "cow", 8, 155)
    moody.set_sound_variant(1)
    check(moody.ambient == some(String("entity.cow_moody.ambient")) and moody.living.own_step == some(String("entity.cow_moody.step")) and moody.living.data.number(OWN + 1) == 1, "a moody cow's sounds")
    var pig = animal(s, PIG, "pig", 9, 155)
    check(pig.living.body.height == 0.9f32 and pig.living.body.eyes == 0.9f32 * 0.85f32 and pig.living.health() == 10.0f32 and pig.living.data.number(OWN) == 0 and pig.living.data.number(OWN + 1) == 1, "a pig's size, health or values")
    pig.set_sound_variant(0)
    check(pig.ambient == some(String("entity.pig_big.ambient")) and pig.living.own_step == some(String("entity.pig.step")), "a big pig's sounds")
    pig.set_age(BABY_START_AGE)
    check(pig.ambient == some(String("entity.baby_pig.ambient")) and pig.living.own_step == some(String("entity.baby_pig.step")) and pig.living.body.height == 0.45f32, "a piglet's sounds or size")
    var chicken = animal(s, CHICKEN, "chicken", 10, 155)
    var moo = mooshroom(s, 10, 155)
    let lay = moo.living.body.random.next_int_below(6000) + 6000
    check(chicken.egg_time == lay and chicken.living.body.random.next_long() == moo.living.body.random.next_long(), "a chicken's egg time isn't drawn after its turn")
    check(chicken.living.body.width == 0.4f32 and chicken.living.body.height == 0.7f32 and chicken.living.health() == 4.0f32 and chicken.living.fall_immune, "a chicken's size, health or fall")
    check(chicken.ambient == some(String("entity.chicken.ambient")) and chicken.egg() == some(String("minecraft:egg")), "a chicken's sound or egg")
    let sheep = animal(s, SHEEP, "sheep", 11, 155)
    check(sheep.living.body.height == 1.3f32 and sheep.living.health() == 8.0f32 and sheep.color() == 0 and not sheep.sheared(), "a sheep's size, health or wool")
    check(sheep.ambient == some(String("entity.sheep.ambient")) and sheep.living.own_step == some(String("entity.sheep.step")), "a sheep's sounds")
    println("kinds: sizes, sounds and a chicken's egg time")
}

// The biome's variants as their selectors pick them, biome 1 warm and 2 cold; `finalizeSpawn`
// drawing the variant, one of them, then the sound variant, any, before an ageable mob's own.
fn variants(s: Setup) {
    check(s.facts.cow.spawnable(0) == [1] and s.facts.cow.spawnable(1) == [2] and s.facts.cow.spawnable(2) == [0], "the variants a biome's selectors pick")
    for species in [COW, PIG, CHICKEN] {
        for biome in 0..3 {
            var r = LegacyRandom.new(400)
            var mirror = LegacyRandom.new(400)
            var mb = animal(s, species, if species == COW { "cow" } else if species == PIG { "pig" } else { "chicken" }, 7, 155)
            mb.spawning_in(s.facts, biome)
            _ = mb.finalize_spawn(none, mut r)
            _ = mirror.next_int_below(1)
            let sounds = if species == PIG { 3 } else { 2 }
            let sound = mirror.next_int_below(sounds)
            _ = mirror.next_double()
            _ = mirror.next_double()
            _ = mirror.next_float()
            let want = if biome == 0 { 1 } else if biome == 1 { 2 } else { 0 }
            let at = if species == PIG { OWN + 1 } else { OWN }
            check(mb.variant == want and mb.living.data.number(at) == want and mb.sound_variant == sound and mb.living.data.number(at + 1) == sound, "a farm animal's variants aren't its draws")
            check(r.next_long() == mirror.next_long(), "finalizing a farm animal drew other than vanilla")
        }
    }
    var warm = animal(s, CHICKEN, "chicken", 7, 155)
    warm.set_variant(2)
    var cold = animal(s, CHICKEN, "chicken", 8, 155)
    cold.set_variant(0)
    check(warm.egg() == some(String("minecraft:brown_egg")) and cold.egg() == some(String("minecraft:blue_egg")), "a warm or cold chicken's egg")
    println("variants: picked by the biome and drawn with their sound variants")
}

// A sheep's color: three colors 5 in 100 each and one 3, by its climate, and otherwise its
// climate's own, pink 1 in 500.
fn colors(s: Setup) {
    // White 0, pink 6, gray 7, light gray 8, brown 12, black 15.
    let firsts: List<List<i32>> = [[15, 7, 8, 12, 0], [7, 8, 0, 15, 12], [8, 7, 0, 12, 15]]
    let lows: List<i32> = [0, 5, 10, 15, 18]
    for biome in 0..3 {
        for band in 0..5 {
            var seed: i64 = 0
            loop {
                var probe = LegacyRandom.new(seed)
                let pick = probe.next_int_below(100)
                let high = if band < 4 { lows[usize.wrap(band + 1)] } else { 100 }
                if pick >= lows[usize.wrap(band)] and pick < high and (band < 4 or probe.next_int_below(500) < 499) {
                    break
                }
                seed += 1
            }
            var r = LegacyRandom.new(seed)
            var mb = animal(s, SHEEP, "sheep", 7, 155)
            mb.spawning_in(s.facts, biome)
            _ = mb.finalize_spawn(none, mut r)
            if mb.color() != firsts[usize.wrap(biome)][usize.wrap(band)] {
                panic("a sheep in biome {biome} drew {mb.color()} at band {band}")
            }
        }
        var seed: i64 = 0
        loop {
            var probe = LegacyRandom.new(seed)
            if probe.next_int_below(100) >= 18 and probe.next_int_below(500) == 499 {
                break
            }
            seed += 1
        }
        var r = LegacyRandom.new(seed)
        var pink = animal(s, SHEEP, "sheep", 7, 155)
        pink.spawning_in(s.facts, biome)
        _ = pink.finalize_spawn(none, mut r)
        check(pink.color() == 6, "a sheep isn't pink 1 in 500")
    }
    println("colors: a sheep's by its climate, pink 1 in 500")
}

// Each kind's tag read back the same, its variants by name; a warm cow's variant read.
fn farm_saving(s: Setup) {
    var lines = List<Entry>()
    var cow = animal(s, COW, "cow", 7, 155)
    cow.set_sound_variant(1)
    let Tag.Compound(cm) = cow.saved() else panic("a cow's tag isn't a compound")
    check(cm["id"] == Tag.Str(String("minecraft:cow")) and cm["variant"] == Tag.Str(String("minecraft:temperate")) and cm["sound_variant"] == Tag.Str(String("minecraft:moody")), "a cow's tag")
    var warm = cm.copy()
    warm.insert(String("variant"), Tag.Str(String("minecraft:warm")))
    let back = Mob.loaded(s.lf, s.facts, cow.living.kind, 7, 7, warm, mut lines) ?? panic("a cow didn't read")
    check(back.variant == 2 and back.sound_variant == 1 and back.living.data.number(OWN) == 2 and back.ambient == some(String("entity.cow_moody.ambient")), "a warm moody cow read")
    var sheep = animal(s, SHEEP, "sheep", 8, 155)
    sheep.set_color(12)
    let Tag.Compound(sm) = sheep.saved() else panic("a sheep's tag isn't a compound")
    check(sm["Color"] == Tag.Byte(12i8) and sm["Sheared"] == Tag.Byte(0i8), "a sheep's tag")
    var shorn = sm.copy()
    shorn.insert(String("Sheared"), Tag.Byte(1i8))
    let wool = Mob.loaded(s.lf, s.facts, sheep.living.kind, 8, 8, shorn, mut lines) ?? panic("a sheep didn't read")
    check(wool.sheared() and wool.color() == 12 and wool.living.data.byte(OWN) == 28i8, "a shorn brown sheep read")
    let chicken = animal(s, CHICKEN, "chicken", 9, 155)
    let Tag.Compound(km) = chicken.saved() else panic("a chicken's tag isn't a compound")
    check(km["EggLayTime"] == Tag.Int(chicken.egg_time) and km["IsChickenJockey"] == Tag.Byte(0i8) and km["sound_variant"] == Tag.Str(String("minecraft:classic")), "a chicken's tag")
    for mb in [cow.copy(), sheep.copy(), chicken.copy(), animal(s, PIG, "pig", 10, 155)] {
        let tag = mb.saved()
        let Tag.Compound(m) = tag.copy() else panic("a tag isn't a compound")
        let again = Mob.loaded(s.lf, s.facts, mb.living.kind, mb.living.body.id, 7, m, mut lines) ?? panic("a farm animal didn't read back")
        check(again.saved() == tag, "a farm animal's tag read back isn't the same")
    }
    check(lines.is_empty(), "loading farm animals logged something")
    println("farm saving: each kind's tag read back the same")
}

// A chicken in the air keeps 0.6 of its fall; on stone, it lays its egg when its time's up, then
// clucks the egg's sound and draws its time again.
fn laying(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:stone") }
    var store = Entities.new()
    store.add_mob(animal(s, CHICKEN, "chicken", 7, 155))
    let players: List<Follower> = [Follower { id: 1, x: 10.5, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false }]
    store.begin_tick()
    var first = List<EntitySound>()
    while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut first) {}
    store.end_tick()
    let fell = store.mob(7).living.body.vy
    if fell != (0.0 - 0.08) * 0.9800000190734863 * 0.6 {
        panic("a chicken doesn't fall slowly: {fell}")
    }
    var laid = List<i32>()
    var clucks = List<i32>()
    var due: i32 = 0
    for tick in 2..=200 {
        if tick == 100 {
            var mb = store.lend_mob(7) ?? panic("no chicken")
            mb.egg_time = 1
            due = tick
            store.give_back_mob(mb)
        }
        store.begin_tick()
        var sounds = List<EntitySound>()
        while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
        store.end_tick()
        for e in sounds {
            if e.sound == "entity.chicken.egg" {
                clucks.push(tick)
            }
        }
        for shown in store.take_shown() {
            if let Shown.Laid(l) = shown {
                check(l.item == "minecraft:egg" and l.y == store.mob(7).living.body.y, "a chicken's egg isn't its variant's, where it is")
                laid.push(tick)
            }
        }
    }
    if laid != [due] or clucks != [due] {
        panic("a chicken didn't lay once when its time was up: {laid}, {clucks}")
    }
    let left = store.mob(7).egg_time
    check(left >= 6000 - (200 - due) and left < 12000, "a chicken's egg time wasn't drawn again")
    println("laying: it falls slowly and lays when its time's up")
}

// A horse's and a donkey's sizes and sounds; `finalizeSpawn` drawing a horse's variant for its
// pack's first, then its markings, its most health, speed and jump, then its baby chance after the
// first and the follow range's bonus and its hand; and a donkey's, its most health alone, its
// pack's babies 1 in 5.
fn horses(s: Setup) {
    let horse = animal(s, HORSE, "horse", 7, 155)
    check(horse.living.body.width == 1.3964844f32 and horse.living.body.height == 1.6f32 and horse.living.body.eyes == 1.52f32 and horse.living.health() == 53.0f32, "a horse's size or health")
    check(horse.ambient == some(String("entity.horse.ambient")) and horse.sound_volume == 0.8f32 and horse.ambient_interval == 400 and horse.max_cluster == 6 and horse.living.step_by_block, "a horse's sounds or pack")
    var r = LegacyRandom.new(400)
    var mirror = LegacyRandom.new(400)
    var first = animal(s, HORSE, "horse", 7, 155)
    let group = first.finalize_spawn(none, mut r) ?? panic("a horse's pack has no group")
    let variant = mirror.next_int_below(7)
    let markings = mirror.next_int_below(5)
    let most = 15 + mirror.next_int_below(8) + mirror.next_int_below(9)
    let speed = (f64(0.45f32) + mirror.next_double() * 0.3 + mirror.next_double() * 0.3 + mirror.next_double() * 0.3) * 0.25
    let jump = f64(0.4f32) + mirror.next_double() * 0.2 + mirror.next_double() * 0.2 + mirror.next_double() * 0.2
    _ = mirror.next_double()
    _ = mirror.next_double()
    _ = mirror.next_float()
    check(r.next_long() == mirror.next_long(), "finalizing a horse drew other than vanilla")
    check(group.variant == variant and group.baby_chance == 0.05f32 and group.size == 1 and first.horse_variant() == (variant | (markings << 8)), "a horse's variant, markings or group")
    let health = attribute_id("minecraft:max_health") ?? panic("no max health")
    let moves = attribute_id("minecraft:movement_speed") ?? panic("no speed")
    let jumps = attribute_id("minecraft:jump_strength") ?? panic("no jump")
    check(first.living.attributes.value(health) == f64(most) and first.living.attributes.value(moves) == speed and first.living.attributes.value(jumps) == jump, "a horse's randomized attributes")
    check(first.living.health() == 53.0f32, "a horse's health was brought down before its tick")
    // The pack's second shares its variant, drawing only its markings, and its baby chance.
    var second = animal(s, HORSE, "horse", 8, 156)
    var r2 = LegacyRandom.new(77)
    var m2 = LegacyRandom.new(77)
    _ = second.finalize_spawn(some(group), mut r2)
    let markings2 = m2.next_int_below(5)
    _ = m2.next_int_below(8)
    _ = m2.next_int_below(9)
    for _ in 0..6 {
        _ = m2.next_double()
    }
    let baby = m2.next_float() <= 0.05f32
    _ = m2.next_double()
    _ = m2.next_double()
    _ = m2.next_float()
    check(r2.next_long() == m2.next_long() and second.horse_variant() == (variant | (markings2 << 8)) and second.baby() == baby, "a horses' pack's second")
    var donkey = animal(s, DONKEY, "donkey", 9, 155)
    var foal = animal(s, DONKEY, "donkey", 10, 155)
    foal.set_age(BABY_START_AGE)
    check(foal.living.body.height == 0.75f32 and foal.living.body.width == 1.3964844f32 * 0.5f32 and foal.ambient == some(String("entity.donkey.ambient")) and foal.living.own_step == some(String("entity.baby_horse.step")), "a donkey foal's size or sounds")
    check(donkey.living.body.height == 1.5f32 and donkey.ambient == some(String("entity.donkey.ambient")), "a donkey's size or sound")
    var r3 = LegacyRandom.new(400)
    var m3 = LegacyRandom.new(400)
    let dg = donkey.finalize_spawn(none, mut r3) ?? panic("a donkey's pack has no group")
    let dmost = 15 + m3.next_int_below(8) + m3.next_int_below(9)
    _ = m3.next_double()
    _ = m3.next_double()
    _ = m3.next_float()
    check(r3.next_long() == m3.next_long() and dg.baby_chance == 0.2f32 and donkey.living.attributes.value(health) == f64(dmost), "finalizing a donkey drew other than vanilla")
    println("horses: sizes, sounds and finalizeSpawn's draws")
}

// A spawned horse's health brought within its most on its first tick; on grass it grazes for 50
// ticks at a time, and heals now and then.
fn grazing(s: Setup) {
    let w = World { stone: f_state(s.f, "minecraft:grass_block") }
    var store = Entities.new()
    var horse = animal(s, HORSE, "horse", 7, 155)
    var r = LegacyRandom.new(400)
    _ = horse.finalize_spawn(none, mut r)
    let health = attribute_id("minecraft:max_health") ?? panic("no max health")
    let most = f32.nearest(horse.living.attributes.value(health))
    horse.living.body.y = 1.0
    store.add_mob(horse)
    let players: List<Follower> = [Follower { id: 1, x: 10.5, y: 1.0, z: 0.5, eyes: 1.62f32, spectator: false, dead: false }]
    var stints = List<i32>()
    var began: i32 = -1
    var healed = 0
    for tick in 1..=6000 {
        if tick == 2 {
            var mb = store.lend_mob(7) ?? panic("no horse")
            if mb.living.health() != most {
                panic("a horse's health wasn't brought within its most on its first tick")
            }
            mb.living.set_health(s.lf, 5.0f32)
            store.give_back_mob(mb)
        }
        let before = store.mob(7).living.health()
        store.begin_tick()
        var sounds = List<EntitySound>()
        while store.tick_next(u64.MAX, s.f, s.m, s.t, s.lf, Sizes {}, w, -64, false, players, mut sounds) {}
        store.end_tick()
        let mb = store.mob(7)
        if mb.living.health() > before and tick > 2 {
            healed += 1
        }
        let eating = mb.horse_flag(16)
        if eating and began < 0 {
            began = tick
        } else if not eating and began >= 0 {
            stints.push(tick - began)
            began = -1
        }
    }
    check(not stints.is_empty() and healed > 0, "a horse never grazed or healed in 6000 ticks")
    for n in stints {
        check(n == 50, "a horse grazed other than 50 ticks")
    }
    println("grazing: its health within its most, grazing 50 ticks at a time ({stints.len()} times), healed {healed} times")
}

// A horse's and a donkey's tags read back the same, their flags, temper, variant and chest.
fn horse_saving(s: Setup) {
    var lines = List<Entry>()
    var horse = animal(s, HORSE, "horse", 7, 155)
    var r = LegacyRandom.new(400)
    _ = horse.finalize_spawn(none, mut r)
    // Its first tick brings its health within its most, as loading it would.
    horse.living.keep_health(s.lf)
    horse.set_horse_flag(2, true)
    horse.temper = 12
    let Tag.Compound(hm) = horse.saved() else panic("a horse's tag isn't a compound")
    check(hm["id"] == Tag.Str(String("minecraft:horse")) and hm["Variant"] == Tag.Int(horse.horse_variant()) and hm["Tame"] == Tag.Byte(1i8) and hm["Temper"] == Tag.Int(12) and hm["EatingHaystack"] == Tag.Byte(0i8) and hm["Bred"] == Tag.Byte(0i8), "a horse's tag")
    let donkey = animal(s, DONKEY, "donkey", 8, 155)
    let Tag.Compound(dm) = donkey.saved() else panic("a donkey's tag isn't a compound")
    check(dm["ChestedHorse"] == Tag.Byte(0i8) and not dm.contains("Variant"), "a donkey's tag")
    var chested = dm.copy()
    chested.insert(String("ChestedHorse"), Tag.Byte(1i8))
    chested.insert(String("Items"), Tag.List([]))
    let packed = Mob.loaded(s.lf, s.facts, donkey.living.kind, 8, 8, chested, mut lines) ?? panic("a chested donkey didn't read")
    let Tag.Compound(again) = packed.saved() else panic("a chested donkey's tag isn't a compound")
    check(packed.living.data.flag(OWN + 1) and again["Items"] == Tag.List([]), "a chested donkey's chest")
    for mb in [horse.copy(), donkey.copy()] {
        let tag = mb.saved()
        let Tag.Compound(m) = tag.copy() else panic("a tag isn't a compound")
        let back = Mob.loaded(s.lf, s.facts, mb.living.kind, mb.living.body.id, 7, m, mut lines) ?? panic("a horse didn't read back")
        check(back.saved() == tag, "a horse's tag read back isn't the same")
    }
    check(lines.is_empty(), "loading horses logged something")
    println("horse saving: their tags read back the same")
}

fn f_state(f: Facts, name: str) -> u32 {
    let b = f.block_named(String(name)) ?? panic("no {name}")
    return f.default_state(b)
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    let t = BodyFacts.new(f)
    let lf = LivingFacts.new(f)
    let kinds = builtin_entries(6)
    var kind: u32? = none
    for i in 0..kinds.len() {
        if kinds[i] == "mooshroom" {
            kind = some(u32.wrap(i))
        }
    }
    let s = Setup { f: f, m: m, t: t, lf: lf, kind: kind ?? panic("no mooshroom type"), facts: MobFacts.vanilla(4, [1], [2]), kinds: kinds.copy() }
    made(s)
    finalized(s)
    despawning(s)
    saving(s)
    listed(s)
    sizes(s)
    variants(s)
    colors(s)
    farm_saving(s)
    laying(s)
    horses(s)
    grazing(s)
    horse_saving(s)
    println("ok")
}
