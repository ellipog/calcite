/// Checks a level's taped random lent out and given back (CAL-368): what's drawn from what it
/// lends, then put back, is what it would have drawn itself, values, its kept gaussian and its
/// tape's lines alike, and a random of another kind lends nothing.
module test.taped_lend

import random.legacy.{LegacyRandom}
import random.source.{RandomSource}
import random.taped.{TapedRandom}

fn draws<R: RandomSource>(r: mut R) -> String {
    let a = r.next_int()
    let b = r.next_int_below(20)
    let c = r.next_long()
    let d = r.next_double()
    let e = r.next_gaussian()
    return "{a} {b} {c} {d} {e}"
}

fn main() {
    var direct = TapedRandom.new(42)
    direct.tape(String("minecraft:overworld"))
    direct.time = 7
    var lending = TapedRandom.new(42)
    lending.tape(String("minecraft:overworld"))
    lending.time = 7

    let before = draws(mut direct)
    let before_lent = draws(mut lending)
    if before != before_lent {
        panic("before: {before} against {before_lent}")
    }

    // Drawn through a lent copy, with a gaussian kept over from the draws before.
    let middle = draws(mut direct)
    let lent = lending.lend() else panic("a taped random lends")
    var copy = TapedRandom.from_lent(lent)
    let middle_lent = draws(mut copy)
    lending.put_back(copy.given_back())
    if middle != middle_lent {
        panic("lent: {middle} against {middle_lent}")
    }

    let after = draws(mut direct)
    let after_lent = draws(mut lending)
    if after != after_lent {
        panic("after: {after} against {after_lent}")
    }
    let tape = direct.take_lines()
    let tape_lent = lending.take_lines()
    if tape != tape_lent {
        panic("the tapes differ")
    }

    var legacy = LegacyRandom.new(42)
    if legacy.lend() != none {
        panic("a legacy random lends nothing")
    }
    _ = legacy.next_int()
    print("ok")
}
