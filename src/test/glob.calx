/// Checks `java.glob` against JDK 25: the regular expression each glob stands for on Unix and on
/// Windows, as `sun.nio.fs.Globs` gives it to `getPathMatcher`, or the description and index of
/// the `PatternSyntaxException` it throws. Each answer is Java's.
module test.glob

import java.glob.{glob_regex}

fn check(glob: String, windows: bool, want: String) {
    let got = match glob_regex(glob, windows) {
        ok(r) => r,
        err(e) => "error {e.description} @{e.index}",
    }
    if got != want {
        panic("`{glob}` on Windows {windows}: got {got}, want {want}")
    }
}

fn main() {
    check("*.txt", false, "^[^/]*\\.txt$")
    check("*.txt", true, "^[^\\\\]*\\.txt$")
    check("**/x", false, "^.*/x$")
    check("**/x", true, "^.*\\\\x$")
    check("?", false, "^[^/]$")
    check("?", true, "^[^\\\\]$")
    check("a/b", false, "^a/b$")
    check("a/b", true, "^a\\\\b$")
    check("[a-c]", false, "^[[^/]&&[a-c]]$")
    check("[a-c]", true, "^[[^\\\\]&&[a-c]]$")
    check("[!a]", false, "^[[^/]&&[^a]]$")
    check("[!a]", true, "^[[^\\\\]&&[^a]]$")
    check("[^a]", false, "^[[^/]&&[\\^a]]$")
    check("[^a]", true, "^[[^\\\\]&&[\\^a]]$")
    check("[-a]", false, "^[[^/]&&[-a]]$")
    check("[-a]", true, "^[[^\\\\]&&[-a]]$")
    check("[!-a]", false, "^[[^/]&&[^-a]]$")
    check("[!-a]", true, "^[[^\\\\]&&[^-a]]$")
    check("\{a,b\}", false, "^(?:(?:a)|(?:b))$")
    check("\{a,b\}", true, "^(?:(?:a)|(?:b))$")
    check("\{a,b,\}", false, "^(?:(?:a)|(?:b)|(?:))$")
    check("\{a,b,\}", true, "^(?:(?:a)|(?:b)|(?:))$")
    check("\{\}", false, "^(?:(?:))$")
    check("\{\}", true, "^(?:(?:))$")
    check("a\\*", false, "^a\\*$")
    check("a\\*", true, "^a\\*$")
    check("\\b", false, "^b$")
    check("\\b", true, "^b$")
    check("\\/", false, "^/$")
    check("\\/", true, "^/$")
    check("[a/b]", false, "error Explicit 'name separator' in class @2")
    check("[a/b]", true, "error Explicit 'name separator' in class @2")
    check("[a\\b]", false, "^[[^/]&&[a\\\\b]]$")
    check("[a\\b]", true, "error Explicit 'name separator' in class @2")
    check("\{a\{b\}\}", false, "error Cannot nest groups @2")
    check("\{a\{b\}\}", true, "error Cannot nest groups @2")
    check("\{a", false, "error Missing '\} @1")
    check("\{a", true, "error Missing '\} @1")
    check("[a", false, "error Missing '] @1")
    check("[a", true, "error Missing '] @1")
    check("\\", false, "error No character to escape @0")
    check("\\", true, "error No character to escape @0")
    check("[z-a]", false, "error Invalid range @1")
    check("[z-a]", true, "error Invalid range @1")
    check("[a-]", false, "^[[^/]&&[a-]]$")
    check("[a-]", true, "^[[^\\\\]&&[a-]]$")
    check("[]", false, "^[[^/]&&[]]$")
    check("[]", true, "^[[^\\\\]&&[]]$")
    check("[]a]", false, "^[[^/]&&[]]a\\]$")
    check("[]a]", true, "^[[^\\\\]&&[]]a\\]$")
    check("[[]", false, "^[[^/]&&[\\[]]$")
    check("[[]", true, "^[[^\\\\]&&[\\[]]$")
    check("a&&b", false, "^a&&b$")
    check("a&&b", true, "^a&&b$")
    check("[a&&b]", false, "^[[^/]&&[a\\&&b]]$")
    check("[a&&b]", true, "^[[^\\\\]&&[a\\&&b]]$")
    check("[a&b]", false, "^[[^/]&&[a&b]]$")
    check("[a&b]", true, "^[[^\\\\]&&[a&b]]$")
    check(".^$+()|", false, "^\\.\\^\\$\\+\\(\\)\\|$")
    check(".^$+()|", true, "^\\.\\^\\$\\+\\(\\)\\|$")
    check("\u{e9}", false, "^\u{e9}$")
    check("\u{e9}", true, "^\u{e9}$")
    check("\u{1f600}", false, "^\u{1f600}$")
    check("\u{1f600}", true, "^\u{1f600}$")
    check("\}", false, "^\}$")
    check("\}", true, "^\}$")
    check(",", false, "^,$")
    check(",", true, "^,$")
    check("[a-c-e]", false, "error Invalid range @4")
    check("[a-c-e]", true, "error Invalid range @4")
    check("[a-cb-d]", false, "^[[^/]&&[a-cb-d]]$")
    check("[a-cb-d]", true, "^[[^\\\\]&&[a-cb-d]]$")
    check("**", false, "^.*$")
    check("**", true, "^.*$")
    check("***", false, "^.*[^/]*$")
    check("***", true, "^.*[^\\\\]*$")
    check("a**b", false, "^a.*b$")
    check("a**b", true, "^a.*b$")
    check("[*?]", false, "^[[^/]&&[*?]]$")
    check("[*?]", true, "^[[^\\\\]&&[*?]]$")
    check("\{a,[bc]\}", false, "^(?:(?:a)|(?:[[^/]&&[bc]]))$")
    check("\{a,[bc]\}", true, "^(?:(?:a)|(?:[[^\\\\]&&[bc]]))$")
    check("\{*,?\}", false, "^(?:(?:[^/]*)|(?:[^/]))$")
    check("\{*,?\}", true, "^(?:(?:[^\\\\]*)|(?:[^\\\\]))$")
    check("[\\]]", false, "^[[^/]&&[\\\\]]\\]$")
    check("[\\]]", true, "error Explicit 'name separator' in class @1")
    check("[a-\\]", false, "error Invalid range @1")
    check("[a-\\]", true, "error Invalid range @1")
    check("x\\\{", false, "^x\\\{$")
    check("x\\\{", true, "^x\\\{$")
    check("[!]", false, "^[[^/]&&[^]]$")
    check("[!]", true, "^[[^\\\\]&&[^]]$")
    check("[!]a]", false, "^[[^/]&&[^]]a\\]$")
    check("[!]a]", true, "^[[^\\\\]&&[^]]a\\]$")
    println("ok")
}
