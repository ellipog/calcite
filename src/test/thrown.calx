/// Checks `world.thrown` (D527): a thrown potion one of what was thrown, owned, where it's thrown;
/// shot along its way, made a unit long, three triangle draws across it from its own random after
/// its UUID's, then as fast as it's thrown, facing that way; shot from a rotation as `Mth`'s tables
/// have the way, its thrower's known movement added, up and down only off the ground; its margin,
/// none till its third tick, then a twentieth a tick more, up to 0.3; the nearest entity its way
/// goes into, its box grown by the margin, the first where they tie, and none it misses; and one
/// read from its tag and saved back the same.
module test.thrown

import math.mth.{RAD_TO_DEG, table_atan2, table_cos, table_sin}
import nbt.snbt.{parse}
import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import server.log.{Entry}
import world.arrow.{Target}
import world.clip.{BlockHit}
import world.collision.{Aabb}
import world.thrown.{ThrownPotion}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    let Tag.Compound(m) = t else panic("not a compound")
    return m.copy()
}

// A target of the ID `id` whose box is a block from x, 0, 0.
fn block_at(id: i32, x: f64) -> Target {
    let b = Aabb { min_x: x, min_y: 0.0, min_z: 0.0, max_x: x + 1.0, max_y: 1.0, max_z: 1.0 }
    return Target { id: id, bounds: b, x: x + 0.5, y: 0.0, z: 0.5, player: false }
}

fn main() {
    let item = snbt("\{id:\"minecraft:splash_potion\",count:3,components:\{\"minecraft:potion_contents\":\{potion:\"minecraft:poison\"\}\}\}")
    var p = ThrownPotion.thrown(7, 1103, 1.5, 2.0, 3.5, (5i64, 6i64), item)
    check(p.owner == some((5i64, 6i64)) and p.body.x == 1.5 and p.body.y == 2.0 and p.body.z == 3.5, "owned, where it's thrown")
    check(compound(p.item)["count"] == Tag.Int(1), "one of what was thrown")
    check(p.item_dirty and p.data.pack_non_default() == none, "its stack to be sent, its other values their defaults")

    // Shot along 3, 4, 0 at half a block a tick, a degree or so off: the draws after its UUID's.
    p.shoot(3.0, 4.0, 0.0, 0.5f32, 1.0f32)
    var r = LegacyRandom.new(1103)
    _ = r.next_long()
    _ = r.next_long()
    let spread = 0.0172275 * f64(1.0f32)
    let ax = r.triangle(0.0, spread)
    let ay = r.triangle(0.0, spread)
    let az = r.triangle(0.0, spread)
    let (wx, wy, wz) = ((3.0 / 5.0 + ax) * f64(0.5f32), (4.0 / 5.0 + ay) * f64(0.5f32), (0.0 + az) * f64(0.5f32))
    check(p.body.vx == wx and p.body.vy == wy and p.body.vz == wz and p.body.needs_sync, "shot along its way")
    let across = (wx * wx + wz * wz).sqrt()
    let facing = f32.nearest((table_atan2(wx, wz) ?? 0.0) * RAD_TO_DEG)
    let pitched = f32.nearest((table_atan2(wy, across) ?? 0.0) * RAD_TO_DEG)
    check(p.body.y_rot == facing and p.body.x_rot == pitched, "facing its way")

    // Shot from facing east, 20 degrees up, with no spread, its thrower's known movement added
    // but up and down, as they're on the ground; and off the ground, all of it.
    let rad = 0.017453292f32
    let xd = f64(-table_sin(f64(-90.0f32 * rad)) * table_cos(f64(0.0f32 * rad)))
    let yd = f64(-table_sin(f64((0.0f32 + -20.0f32) * rad)))
    let zd = f64(table_cos(f64(-90.0f32 * rad)) * table_cos(f64(0.0f32 * rad)))
    let dist = (xd * xd + yd * yd + zd * zd).sqrt()
    for ground in [true, false] {
        var q = ThrownPotion.thrown(8, 22, 0.0, 0.0, 0.0, (5i64, 6i64), snbt("\{id:\"minecraft:splash_potion\",count:1\}"))
        q.shoot_from_rotation(-90.0f32, 0.0f32, -20.0f32, 0.5f32, 0.0f32, (0.1, 0.2, 0.3), ground)
        let ex = (xd / dist + 0.0) * f64(0.5f32) + 0.1
        let ey = (yd / dist + 0.0) * f64(0.5f32) + (if ground { 0.0 } else { 0.2 })
        let ez = (zd / dist + 0.0) * f64(0.5f32) + 0.3
        check((q.body.vx - ex).abs() < 1.0e-12 and (q.body.vy - ey).abs() < 1.0e-12 and (q.body.vz - ez).abs() < 1.0e-12, "shot from a rotation, its thrower's movement added")
    }

    // Its margin: none till its third tick, then a twentieth a tick, up to 0.3.
    let ticks: List<(i32, f32)> = [(0, 0.0f32), (2, 0.0f32), (3, 1.0f32 / 20.0f32), (8, 0.3f32), (40, 0.3f32)]
    for (t, want) in ticks {
        p.body.tick_count = t
        if p.margin() != want {
            panic("its margin at its tick {t}")
        }
    }

    // From 0, 0.5, 0.5 east to 10: of blocks at 6 and 3, the one at 3; of two at 3, the first; a
    // block 0.2 above its way, met only with the margin of its tenth tick; none past its way's end.
    p.body.x = 0.0
    p.body.y = 0.5
    p.body.z = 0.5
    p.way = BlockHit { x: 10.0, y: 0.5, z: 0.5, face: 0, bx: 0, by: 0, bz: 0, missed: true }
    p.body.tick_count = 0
    let nearest = p.nearest([block_at(1, 6.0), block_at(2, 3.0)]) ?? panic("nothing hit")
    check(nearest.target == 2 and nearest.x == 3.0 and nearest.y == 0.5, "the nearer")
    let tied = p.nearest([block_at(3, 3.0), block_at(4, 3.0)]) ?? panic("nothing hit")
    check(tied.target == 3, "the first where they tie")
    var raised = block_at(5, 3.0)
    raised.bounds = Aabb { min_x: 3.0, min_y: 0.7, min_z: 0.0, max_x: 4.0, max_y: 1.7, max_z: 1.0 }
    check(p.nearest([raised]) == none, "above its way, no margin")
    p.body.tick_count = 10
    let grown = p.nearest([raised]) ?? panic("missed with the margin")
    check(grown.target == 5 and grown.x == 3.0 - f64(0.3f32), "met with its margin")
    check(p.nearest([block_at(6, 11.0)]) == none, "past its way's end")

    // Read from its tag and saved back the same.
    var lines = List<Entry>()
    let saved = p.saved()
    let tag = compound(saved.copy())
    check(tag["id"] == Tag.Str(String("minecraft:splash_potion")) and tag.contains("Owner") and tag.contains("Item"), "saved as a splash potion, its owner and stack")
    let again = ThrownPotion.loaded(9, 1103, tag.copy(), some(tag["Item"].copy()), mut lines) ?? panic("not loaded")
    check(lines.is_empty() and again.saved() == saved, "read and saved back the same")
    check(again.item_dirty and again.owner == some((5i64, 6i64)), "its stack to be sent again, its owner kept")
    println("ok")
}
