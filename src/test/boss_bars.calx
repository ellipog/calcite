/// Checks `world.boss_bars`: boss bars kept as vanilla's `CustomBossEvent` keeps them, each change
/// sent as `ServerBossEvent` sends it to those it's shown to, a player who died kept among them,
/// saved and read back as `CustomBossEvents`' codec writes and reads them (D606).
module test.boss_bars

import auth.profile.{GameProfile}
import chat.component.{Component}
import java.uuid.{Uuid}
import nbt.tag.{Tag}
import protocol.play.{BossOperation}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.boss_bars.{BossBar, BossBars, BossSent, Viewer}

fn check(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

fn id(path: str) -> Identifier {
    return Identifier { namespace: String("rig"), path: String(path) }
}

fn player(name: str, entity: i32, serial: i64, least: i64) -> Viewer {
    return Viewer { entity: entity, serial: serial, profile: GameProfile { id: Uuid.new(1, least), name: String(name), properties: [] } }
}

// What was sent, each as whom it's to and what it does.
fn told(sent: List<BossSent>) -> String {
    var out = String()
    for s in sent {
        if not out.is_empty() {
            out.push_str(" ")
        }
        let what = match s.operation {
            BossOperation.Add(a) => "add {a.progress}",
            BossOperation.Remove => String("remove"),
            BossOperation.Progress(p) => "progress {p}",
            BossOperation.Name(_) => String("name"),
            BossOperation.Style(c, o) => "style {c} {o}",
            BossOperation.Properties(f) => "properties {f}",
        }
        out.push_str("{s.to}:{what}")
    }
    return out
}

fn main() {
    var bar = BossBar { id: id("a"), uuid: Uuid.new(5, 6), name: Component.literal("A") }
    var sent = List<BossSent>()
    let bot = player("Bot", 2, 1, 10)
    let mate = player("Mate", 3, 2, 11)
    check("{bar.set_players([bot.copy(), mate.copy()], mut sent)}", "true", "players given")
    check(told(sent), "2:add 0.0 3:add 0.0", "each shown all it has")
    sent.clear()
    check("{bar.set_players([bot.copy(), mate.copy()], mut sent)}", "false", "the same players again")
    bar.set_value(25, mut sent)
    bar.set_value(25, mut sent)
    check(told(sent), "2:progress 0.25 3:progress 0.25", "a value sent where its progress changes")
    sent.clear()
    bar.set_max(10, mut sent)
    check(told(sent), "2:progress 1.0 3:progress 1.0", "a value past its most, 1")
    sent.clear()
    bar.set_color(5, mut sent)
    bar.set_overlay(2, mut sent)
    check(told(sent), "2:style 5 0 3:style 5 0 2:style 5 2 3:style 5 2", "its color and notches")
    sent.clear()
    bar.set_visible(false, mut sent)
    bar.set_max(20, mut sent)
    check(told(sent), "2:remove 3:remove", "hidden, taken away, and nothing sent of it unseen")
    sent.clear()
    bar.set_visible(true, mut sent)
    check(told(sent), "2:add 1.0 3:add 1.0", "shown again, all it has, its value past its most")
    sent.clear()
    // 0 of 0 is a NaN, which is never its progress, so sent each time.
    bar.set_value(0, mut sent)
    bar.set_max(0, mut sent)
    bar.set_max(0, mut sent)
    check(told(sent), "2:progress 0.0 3:progress 0.0 2:progress NaN 3:progress NaN 2:progress NaN 3:progress NaN", "a NaN sent each time")
    sent.clear()
    // The bot respawns, another life of its player: the one who died is still shown it, and the
    // one who lives, whose UUID it has, isn't added.
    let reborn = player("Bot", 2, 3, 10)
    check("{bar.set_players([reborn.copy(), mate.copy()], mut sent)}", "false", "the one who lives has the UUID it has")
    check("{bar.viewers.len()}", "2", "the one who died kept")
    check("{bar.shows(bot)} {bar.shows(reborn)}", "true false", "shown to the one who died, not the one who lives")
    check("{bar.set_players([mate.copy()], mut sent)}", "true", "the bot taken out")
    check(told(sent), "2:remove", "its UUID's first shown it, the one who died, taken it from")
    sent.clear()
    check("{bar.add_player(reborn, mut sent)}", "true", "the one who lives added")
    check(told(sent), "2:add NaN", "and shown it, its progress the NaN it has")
    sent.clear()
    bar.set_flags(true, false, true, mut sent)
    check(told(sent), "3:properties 1 2:properties 1 3:properties 5 2:properties 5", "each flag sent as it changes")
    check(bar.display_name().to_nbt().to_snbt(), "\{color:\"dark_blue\",hover_event:\{action:\"show_text\",value:\"rig:a\"\},insertion:\"rig:a\",translate:\"chat.square_brackets\",with:[\"A\"]\}", "its display name, purple's dark blue")

    // Saved and read back.
    var bars = BossBars.fresh()
    check("{bars.dirty}", "true", "fresh ones to be saved")
    bars.put(bar, true)
    var plain = BossBar { id: id("plain"), uuid: Uuid.new(7, 8), name: Component.literal("P") }
    plain.set_visible(false, mut sent)
    bars.put(plain, true)
    let packed = bars.take_save() ?? Tag.End
    check("{bars.dirty}", "false", "saved")
    check(packed.to_snbt(), "\{\"rig:a\":\{Color:\"purple\",CreateWorldFog:1b,DarkenScreen:1b,Max:0,Name:\"A\",Overlay:\"notched_10\",Players:[[I;0,1,0,11],[I;0,1,0,10]],Visible:1b\},\"rig:plain\":\{Name:\"P\"\}\}", "each left out at its default")
    var root = JavaHashMap<String, Tag>()
    root.insert(String("data"), packed)
    var lines = List<Entry>()
    var read = BossBars.load(root, mut lines)
    check("{lines.len()} {read.dirty}", "0 true", "read back, to be saved, as setValue marks them")
    let back = read.get(id("a")) ?? BossBar { id: id("none"), uuid: Uuid.new(0, 0), name: Component.empty() }
    check("{back.value} {back.max} {back.progress} {back.color} {back.overlay} {back.flags()} {back.visible} {back.players.len()} {back.viewers.len()}", "0 0 NaN 5 2 5 true 2 0", "read back as packed, shown to no one yet")
    check("{back.uuid.most == 5 and back.uuid.least == 6}", "false", "a fresh random UUID")
    var joined = List<BossSent>()
    read.connected(mate, mut joined)
    check(told(joined), "3:add NaN", "a player among its players shown it as they join")
    read.disconnected(mate)
    check("{(read.get(id("a")) ?? back.copy()).viewers.len()} {(read.get(id("a")) ?? back.copy()).players.len()}", "0 2", "taken out as they leave, their UUID kept")

    // What doesn't read.
    var bad = JavaHashMap<String, Tag>()
    var data = JavaHashMap<String, Tag>()
    var fine = JavaHashMap<String, Tag>()
    fine.insert(String("Name"), Tag.Str(String("F")))
    data.insert(String("rig:fine"), Tag.Compound(fine))
    data.insert(String("rig:nameless"), Tag.Compound(JavaHashMap<String, Tag>()))
    bad.insert(String("data"), Tag.Compound(data))
    var problems = List<Entry>()
    let partial = BossBars.load(bad, mut problems)
    check("{partial.bars.len()} {problems.len()}", "1 1", "a bar without a name left out, the rest kept")
    check(problems[0].message.copy(), "Failed to parse saved data for 'SavedDataType[minecraft:custom_boss_events]': No key Name in MapLike[\{\}]", "a bar without a name")
    let none_root = JavaHashMap<String, Tag>()
    let unread = BossBars.load(none_root, mut problems)
    check("{unread.dirty} {unread.bars.len()}", "true 0", "a file without data made fresh, to be saved")
    print("ok\n")
}
