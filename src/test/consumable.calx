/// Tests of `world.consumable` (D519): a consumable with the codec's defaults and with its own
/// fields, its ticks and when it makes its particles and sound, and what doesn't read; food, with
/// and without being always eaten, and what doesn't read; a suspicious stew's effects; and an
/// ominous bottle's bad omen.
module test.consumable

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import world.consumable.{bad_omen, read_consumable, read_food, stew_effects}
import world.effects.{effect_id}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

fn main() {
    // `Consumable.CODEC`'s defaults: 1.6 seconds, 32 ticks, eaten with `entity.generic.eat`, its
    // particles made, nothing more done.
    let plain = read_consumable(snbt("\{\}"))!
    check("{plain.seconds} {plain.ticks()} {plain.animation} {plain.drinks()} {plain.sound} {plain.particles} {plain.effects.len()}", "1.6 32 eat false minecraft:entity.generic.eat true 0", "a plain consumable")
    // Past the first 7 of its 32 ticks, every fourth: 24 left is 8 used.
    check("{plain.emits(28)} {plain.emits(25)} {plain.emits(24)} {plain.emits(4)} {plain.emits(0)}", "false false true true true", "when it's heard")
    // A honey bottle's: 2 seconds drunk, its sound, no particles, poison taken off.
    let honey = read_consumable(snbt("\{animation:\"drink\",consume_seconds:2.0d,has_consume_particles:0b,on_consume_effects:[\{effects:\"minecraft:poison\",type:\"minecraft:remove_effects\"\}],sound:\"minecraft:item.honey_bottle.drink\"\}"))!
    check("{honey.ticks()} {honey.drinks()} {honey.sound} {honey.particles} {honey.effects.len()}", "40 true minecraft:item.honey_bottle.drink false 1", "a honey bottle")
    check("{honey.emits(36)} {honey.emits(32)} {honey.emits(28)}", "false false true", "a honey bottle heard once it's past its first 8")
    // A sound made in place, by its `sound_id`; at once, 0 seconds.
    let made = read_consumable(snbt("\{consume_seconds:0.0f,sound:\{sound_id:\"minecraft:block.note_block.bell\"\}\}"))!
    check("{made.ticks()} {made.sound}", "0 minecraft:block.note_block.bell", "a sound made in place")
    // A third of a tick's cut to none.
    check("{read_consumable(snbt("\{consume_seconds:0.04f\}"))!.ticks()}", "0", "less than a tick")
    check("{read_consumable(snbt("\{consume_seconds:-1.0f\}")) == none}", "true", "seconds below 0")
    check("{read_consumable(snbt("\{animation:\"chew\"\}")) == none}", "true", "an animation that isn't one")
    check("{read_consumable(snbt("\{on_consume_effects:[\{type:\"minecraft:nothing\"\}]\}")) == none}", "true", "an effect that isn't one")
    check("{read_consumable(snbt("1")) == none}", "true", "what isn't a compound")

    // `FoodProperties.DIRECT_CODEC`.
    let apple = read_food(snbt("\{nutrition:4,saturation:2.4d\}"))!
    check("{apple.nutrition} {apple.saturation} {apple.always}", "4 2.4 false", "an apple")
    let golden = read_food(snbt("\{can_always_eat:1b,nutrition:4,saturation:9.6f\}"))!
    check("{golden.always}", "true", "a golden apple, always eaten")
    check("{read_food(snbt("\{nutrition:4\}")) == none} {read_food(snbt("\{nutrition:-1,saturation:1.0f\}")) == none}", "true true", "food without saturation, and with less than none")

    // `SuspiciousStewEffects`: each effect for its duration, 160 where it's left out.
    let stew = stew_effects(snbt("[\{id:\"minecraft:night_vision\",duration:100\},\{id:\"minecraft:blindness\"\},\{id:\"minecraft:nothing\"\}]"))
    check("{stew.len()} {stew[0].id == effect_id(String("minecraft:night_vision"))!} {stew[0].duration()} {stew[1].duration()} {stew[1].amplifier()}", "2 true 100 160 0", "a suspicious stew's effects")
    check("{stew_effects(snbt("1")).len()}", "0", "a stew's effects that aren't a list")

    // `OminousBottleAmplifier`: bad omen for 120000 ticks, its particles hidden, its icon shown.
    let omen = bad_omen(snbt("3"))!
    check("{omen.id == effect_id(String("minecraft:bad_omen"))!} {omen.duration()} {omen.amplifier()}", "true 120000 3", "an ominous bottle's bad omen")
    check("{bad_omen(snbt("5")) == none} {bad_omen(snbt("-1")) == none}", "true true", "an ominous bottle's level out of 0 to 4")
    println("ok")
}
