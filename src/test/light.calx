/// Checks `world.light_faces` and `world.light`: the faces light sees of a few states, and the
/// light of a few small worlds. The rig's `light` probe checks the rest against vanilla's own
/// light engines (rig/README.md).
module test.light

import world.blocks.{STATE_COUNT}
import world.chunk.{BlockStates, Chunk}
import world.flat.{flat_light}
import world.light.{Light, LightChunks, LightStates, SkySources, light_sources}
import world.light_faces.{FACE_BITS, FACE_SHAPES, face_occludes, state_faces}

// Vanilla 26.3's IDs of a few states.
const AIR: u32 = 0
const STONE: u32 = 1
const TORCH: u32 = 4926
const OAK_SLAB_BOTTOM: u32 = 15180
const OAK_SLAB_TOP: u32 = 15178
const OAK_STAIRS_NORTH: u32 = 5474
const BEDROCK: u32 = 88
const DIRT: u32 = 10
const GRASS_BLOCK: u32 = 9
const GLOWSTONE: u32 = 8686

// The overworld's height.
const MIN_Y: i32 = -64
const SECTIONS: i32 = 24

fn check(got: i64, want: i64, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

/// The shape of face `direction` (0 down to 5 east) of `state`.
fn face(palette: List<u64>, states: List<u8>, state: u32, direction: u32) -> u32 {
    let packed = palette[usize(states[usize(state)])]
    return u32.wrap((packed >> u64(FACE_BITS * direction)) & 63)
}

/// Bit `j` of `row`.
fn bit(row: u64, j: u32) -> i64 {
    return i64.wrap((row >> u64(j)) & 1)
}

fn faces() {
    let (palette, states) = state_faces()
    check(i64.wrap(states.len()), i64(STATE_COUNT), "states with faces")
    check(i64.wrap(palette[0]), 0, "the commonest faces")
    for d in 0..6u32 {
        let direction = d
        check(i64(face(palette, states, AIR, direction)), 0, "air's faces")
        check(i64(face(palette, states, STONE, direction)), 0, "stone's faces, which don't use its shape")
        check(i64(face(palette, states, TORCH, direction)), 0, "a torch's faces")
    }
    // A bottom slab's whole face is down, a top one's up, and their sides are halves.
    check(i64(face(palette, states, OAK_SLAB_BOTTOM, 0)), 1, "a bottom slab's bottom")
    check(i64(face(palette, states, OAK_SLAB_BOTTOM, 1)), 0, "a bottom slab's top")
    check(i64(face(palette, states, OAK_SLAB_TOP, 1)), 1, "a top slab's top")
    check(i64(face(palette, states, OAK_SLAB_TOP, 0)), 0, "a top slab's bottom")
    check(i64(face(palette, states, OAK_STAIRS_NORTH, 2)), 1, "a stair's back")
    let occludes = face_occludes()
    check(i64.wrap(occludes.len()), i64(FACE_SHAPES), "rows of shapes")
    for i in 0..FACE_SHAPES {
        // A whole face blocks light against any other, and the table is the same both ways.
        check(bit(occludes[1], i), 1, "a whole face against shape {i}")
        for j in 0..FACE_SHAPES {
            check(bit(occludes[usize(i)], j), bit(occludes[usize(j)], i), "shapes {i} and {j} both ways")
        }
    }
    // Two empty faces let light through, and a bottom slab's side against a top one's doesn't.
    check(bit(occludes[0], 0), 0, "two empty faces")
    let bottom_side = face(palette, states, OAK_SLAB_BOTTOM, 2)
    let top_side = face(palette, states, OAK_SLAB_TOP, 3)
    check(bit(occludes[usize(bottom_side)], top_side), 1, "a bottom slab's side against a top slab's")
    check(bit(occludes[usize(bottom_side)], bottom_side), 0, "two bottom slabs' sides")
    println("ok faces")
}

fn key(chunk_x: i32, chunk_z: i32) -> i64 {
    return (i64(chunk_x) << 32) | (i64(chunk_z) & 0xFFFFFFFF)
}

/// A few chunks, with their sky sources, as light finds them.
struct World {
    table: BlockStates
    states: LightStates
    chunks: Map<i64, Chunk> = Map<i64, Chunk>()
    sources: Map<i64, SkySources> = Map<i64, SkySources>()
}

impl World {
    fn new() -> World {
        return World { table: BlockStates.new([], [], 1), states: LightStates.new() }
    }

    /// Adds an empty chunk.
    fn add(mut self, chunk_x: i32, chunk_z: i32) {
        self.chunks.insert(key(chunk_x, chunk_z), Chunk.new(self.table, MIN_Y, SECTIONS, 0))
        self.sources.insert(key(chunk_x, chunk_z), SkySources.new(MIN_Y))
    }

    /// Sets a block without telling light, as a chunk is made.
    fn put(mut self, x: i32, y: i32, z: i32, state: u32) {
        _ = self.chunks[key(x >> 4, z >> 4)].set_block(self.table, x & 15, y, z & 15, state)
    }

    /// Works out the chunk's sky sources from its blocks, `initializeLightSources`.
    fn fill_sources(mut self, chunk_x: i32, chunk_z: i32) {
        let k = key(chunk_x, chunk_z)
        self.sources[k].fill_from(self.chunks[k], self.states)
    }
}

impl LightChunks for World {
    fn light_state(self, x: i32, y: i32, z: i32) -> u32? {
        let k = key(x >> 4, z >> 4)
        if not self.chunks.contains(k) {
            return none
        }
        return some(self.chunks[k].block(x & 15, y, z & 15))
    }

    fn lowest_sky_source(self, x: i32, z: i32) -> i32? {
        let k = key(x >> 4, z >> 4)
        if not self.sources.contains(k) {
            return none
        }
        return some(self.sources[k].lowest_source_y(x & 15, z & 15))
    }

    fn highest_sky_source(self, chunk_x: i32, chunk_z: i32) -> i32? {
        let k = key(chunk_x, chunk_z)
        if not self.sources.contains(k) {
            return none
        }
        return some(self.sources[k].highest_lowest_source_y())
    }

    fn light_sources_in(self, chunk_x: i32, chunk_z: i32) -> List<i64> {
        let k = key(chunk_x, chunk_z)
        if not self.chunks.contains(k) {
            return []
        }
        return light_sources(self.chunks[k], self.states, chunk_x, chunk_z)
    }
}

/// Lights the chunks from `from` to `to` each way as a server does when it makes them: each
/// one's sources and sections, then each one lit. Its sections are told one at a time, or with
/// `at_once`, a chunk's at once (D262).
fn light_all(world: World, light: mut Light, from: i32, to: i32, at_once: bool) {
    for cx in from..to + 1 {
        for cz in from..to + 1 {
            let k = key(cx, cz)
            var ys = List<i32>()
            for i in 0..world.chunks[k].section_count() {
                if not world.chunks[k].section_only_air(i) {
                    ys.push((MIN_Y >> 4) + i32.wrap(i))
                }
            }
            if at_once {
                light.update_column_status(cx, cz, ys, false)
            } else {
                for y in ys {
                    light.update_section_status(cx, y, cz, false)
                }
            }
            _ = light.run(world.states, world)
            light.set_light_enabled(world, cx, cz, false)
            light.retain_data(cx, cz, false)
        }
    }
    for cx in from..to + 1 {
        for cz in from..to + 1 {
            light.propagate_light_sources(world.states, world, cx, cz)
            _ = light.run(world.states, world)
        }
    }
}

fn flat_world(from: i32, to: i32) -> World {
    var world = World.new()
    for cx in from..to + 1 {
        for cz in from..to + 1 {
            world.add(cx, cz)
            var y = MIN_Y
            for state in [BEDROCK, DIRT, DIRT, GRASS_BLOCK] {
                for x in 0..16 {
                    for z in 0..16 {
                        world.put(cx * 16 + x, y, cz * 16 + z, state)
                    }
                }
                y += 1
            }
            world.fill_sources(cx, cz)
        }
    }
    return world
}

fn bytes_are(got: List<u8>, want: List<u8>, what: String) {
    check(i64.wrap(got.len()), i64.wrap(want.len()), "{what}'s length")
    for i in 0..got.len() {
        if got[i] != want[i] {
            panic("{what}: byte {i} is {got[i]}, want {want[i]}")
        }
    }
}

/// A flat chunk lit as vanilla lights it: what `world.flat` sends.
fn flat() {
    let world = flat_world(-1, 1)
    var light = Light.new(MIN_Y, SECTIONS * 16, true)
    light_all(world, mut light, -1, 1, false)
    let data = light.light_data(0, 0)
    bytes_are(data.sky_mask, [6], "the sky mask")
    bytes_are(data.empty_sky_mask, [1], "the empty sky mask")
    bytes_are(data.block_mask, [], "the block mask")
    bytes_are(data.empty_block_mask, [7], "the empty block mask")
    check(i64.wrap(data.sky.len()), 2, "sky layers")
    var bottom = List<u8>()
    for i in 0..2048 {
        bottom.push(if i < 512 { 0 } else { 0xFF })
    }
    bytes_are(data.sky[0].data, bottom, "the bottom section's sky")
    bytes_are(data.sky[1].data, [0xFF; 2048], "the second section's sky")
    check(i64(light.value(true, 3, -60, 3)), 15, "the sky on the grass")
    check(i64(light.value(true, 3, -61, 3)), 0, "the sky in the grass")
    check(i64(light.value(true, 3, 100, 3)), 15, "the sky high up")
    check(i64(light.value(false, 3, -60, 3)), 0, "block light on the grass")
    // `world.flat` lights one chunk in a world of it, and gets the same.
    let k = key(0, 0)
    var chunk = Chunk.new(world.table, MIN_Y, SECTIONS, 0)
    var y = MIN_Y
    for state in [BEDROCK, DIRT, DIRT, GRASS_BLOCK] {
        for x in 0..16 {
            for z in 0..16 {
                _ = chunk.set_block(world.table, x, y, z, state)
            }
        }
        y += 1
    }
    check(i64.wrap(chunk.section_count()), i64.wrap(world.chunks[k].section_count()), "sections")
    let sent = flat_light(chunk)
    bytes_are(sent.sky_mask, data.sky_mask, "world.flat's sky mask")
    bytes_are(sent.empty_sky_mask, data.empty_sky_mask, "world.flat's empty sky mask")
    bytes_are(sent.block_mask, data.block_mask, "world.flat's block mask")
    bytes_are(sent.empty_block_mask, data.empty_block_mask, "world.flat's empty block mask")
    check(i64.wrap(sent.sky.len()), 2, "world.flat's sky layers")
    bytes_are(sent.sky[0].data, data.sky[0].data, "world.flat's bottom section's sky")
    bytes_are(sent.sky[1].data, data.sky[1].data, "world.flat's second section's sky")
    println("ok flat")
}

/// Glowstone on a flat chunk: light falls off a level a block, and the ground stops it.
fn glow() {
    var world = flat_world(-1, 1)
    world.put(8, -60, 8, GLOWSTONE)
    world.fill_sources(0, 0)
    var light = Light.new(MIN_Y, SECTIONS * 16, true)
    light_all(world, mut light, -1, 1, false)
    check(i64(light.value(false, 8, -60, 8)), 15, "the glowstone")
    check(i64(light.value(false, 9, -60, 8)), 14, "next to it")
    check(i64(light.value(false, 8, -59, 8)), 14, "on it")
    check(i64(light.value(false, 12, -58, 9)), 8, "seven blocks off")
    check(i64(light.value(false, 8, -61, 8)), 0, "in the grass below it")
    check(i64(light.value(false, 23, -60, 8)), 0, "fifteen blocks off")
    let data = light.light_data(0, 0)
    bytes_are(data.block_mask, [6], "the block mask")
    bytes_are(data.empty_block_mask, [1], "the empty block mask")
    println("ok glow")
}

/// The same light, sent and read, from two engines, over the chunks from `from` to `to` each
/// way.
fn same_light(a: Light, b: Light, from: i32, to: i32, what: String) {
    for cx in from..to + 1 {
        for cz in from..to + 1 {
            let x = a.light_data(cx, cz)
            let y = b.light_data(cx, cz)
            let at = "{what}, chunk {cx} {cz}"
            bytes_are(x.sky_mask, y.sky_mask, "{at}: the sky mask")
            bytes_are(x.empty_sky_mask, y.empty_sky_mask, "{at}: the empty sky mask")
            bytes_are(x.block_mask, y.block_mask, "{at}: the block mask")
            bytes_are(x.empty_block_mask, y.empty_block_mask, "{at}: the empty block mask")
            check(i64.wrap(x.sky.len()), i64.wrap(y.sky.len()), "{at}: sky layers")
            for i in 0..x.sky.len() {
                bytes_are(x.sky[i].data, y.sky[i].data, "{at}: sky layer {i}")
            }
            check(i64.wrap(x.block.len()), i64.wrap(y.block.len()), "{at}: block layers")
            for i in 0..x.block.len() {
                bytes_are(x.block[i].data, y.block[i].data, "{at}: block layer {i}")
            }
            for by in [-64, -41, -20, 0, 17, 21, 40, 99, 150, 300] {
                check(i64(a.value(true, cx * 16 + 3, by, cz * 16 + 6)), i64(b.value(true, cx * 16 + 3, by, cz * 16 + 6)), "{at}: the sky at y {by}")
                check(i64(a.value(false, cx * 16 + 9, by, cz * 16 + 8)), i64(b.value(false, cx * 16 + 9, by, cz * 16 + 8)), "{at}: block light at y {by}")
            }
        }
    }
}

/// A chunk's sections told at once give the light they give told one at a time: chunks with dirt
/// in sections with gaps between and glowstone in one, lit both ways, then the middle one's
/// sections all told they're empty (D262).
fn columns() {
    var world = flat_world(-2, 2)
    for cx in -2..3 {
        for cz in -2..3 {
            for y in [-40, -20, 0, 1, 40, 100, 150, 300] {
                world.put(cx * 16 + 3, y, cz * 16 + 5, DIRT)
            }
            world.put(cx * 16 + 8, 20, cz * 16 + 8, GLOWSTONE)
            world.fill_sources(cx, cz)
        }
    }
    var one = Light.new(MIN_Y, SECTIONS * 16, true)
    var all = Light.new(MIN_Y, SECTIONS * 16, true)
    light_all(world, mut one, -2, 2, false)
    light_all(world, mut all, -2, 2, true)
    same_light(one, all, -2, 2, "made")
    var ys = List<i32>()
    for i in 0..SECTIONS {
        ys.push((MIN_Y >> 4) + i)
    }
    for y in ys {
        one.update_section_status(0, y, 0, true)
    }
    all.update_column_status(0, 0, ys, true)
    _ = one.run(world.states, world)
    _ = all.run(world.states, world)
    same_light(one, all, -2, 2, "the middle gone")
    println("ok columns")
}

fn main() {
    faces()
    flat()
    glow()
    columns()
    println("ok")
}
