/// Checks `world.combat` against vanilla's `CombatTracker` (D427): its death messages, told by the
/// last hurt's type, by the most significant fall and where it began, or with the bug report's
/// link, and naming who hurt them (D442); and the hurts kept, and forgotten 100 ticks after the
/// last, or as the entity dies.
module test.combat

import chat.component.{Component}
import java.uuid.{Uuid}
import world.combat.{CombatEntry, CombatTracker, LADDER_FALL, WATER_FALL, entity_display_name}
import world.damage.{DamageTypes}

// The damage types' IDs in vanilla's registry, by name.
const BAD_RESPAWN_POINT: i32 = 1
const FALL: i32 = 10
const IN_WALL: i32 = 22
const OUT_OF_WORLD: i32 = 32

fn check(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

// The death message `t` tells of Steve, as JSON, and what it said was missing after.
fn told(t: CombatTracker, types: DamageTypes) -> String {
    var missing = List<String>()
    let m = t.death_message(types, Component.literal(String("Steve")), none, mut missing)
    var out = m.to_json()
    for each in missing {
        out = "{out}; missing {each}"
    }
    return out
}

// A hurt of the type `kind` by the entity `id`, named `name`, for `damage`.
fn by(kind: i32, id: i32, name: Component, damage: f32) -> CombatEntry {
    return CombatEntry { kind: kind, cause: id, direct: id, damage: damage, fall_distance: 0.0f32, cause_name: some(name.copy()), direct_name: some(name.copy()) }
}

fn hurt(kind: i32, damage: f32, at: u8?, fell: f32) -> CombatEntry {
    return CombatEntry { kind: kind, damage: damage, fall_location: at, fall_distance: fell }
}

fn main() {
    let types = DamageTypes.vanilla()
    var t = CombatTracker()
    check(told(t, types), "\{\"translate\":\"death.attack.generic\",\"with\":[\"Steve\"]\}", "without a hurt")
    _ = t.record(hurt(IN_WALL, 1.0f32, none, 0.0f32), 0, true, false)
    check(told(t, types), "\{\"translate\":\"death.attack.inWall\",\"with\":[\"Steve\"]\}", "in a wall")

    // A fall over 5 blocks is told by where it began: nowhere, then a ladder.
    t = CombatTracker()
    _ = t.record(hurt(FALL, 7.0f32, none, 10.0f32), 0, true, false)
    check(told(t, types), "\{\"translate\":\"death.fell.accident.generic\",\"with\":[\"Steve\"]\}", "a long fall")
    t = CombatTracker()
    _ = t.record(hurt(FALL, 7.0f32, some(LADDER_FALL), 10.0f32), 0, true, false)
    check(told(t, types), "\{\"translate\":\"death.fell.accident.ladder\",\"with\":[\"Steve\"]\}", "off a ladder")
    // One of 5 or less, with no hurt over 5 where a fall began, as the type's own.
    t = CombatTracker()
    _ = t.record(hurt(FALL, 1.0f32, none, 4.0f32), 0, true, false)
    check(told(t, types), "\{\"translate\":\"death.attack.fall\",\"with\":[\"Steve\"]\}", "a short fall")
    // A short fall after a hurt over 5 in water: knocked off by that hurt, which no one caused.
    t = CombatTracker()
    _ = t.record(hurt(IN_WALL, 6.0f32, some(WATER_FALL), 0.0f32), 0, true, false)
    _ = t.record(hurt(FALL, 1.0f32, none, 3.0f32), 5, true, false)
    check(told(t, types), "\{\"translate\":\"death.fell.killer\",\"with\":[\"Steve\"]\}", "knocked off")
    // The void always falls the farthest, and the hurt before it knocked them off.
    t = CombatTracker()
    _ = t.record(hurt(FALL, 7.0f32, some(LADDER_FALL), 10.0f32), 0, true, false)
    _ = t.record(hurt(OUT_OF_WORLD, 4.0f32, none, 40.0f32), 5, true, false)
    check(told(t, types), "\{\"translate\":\"death.attack.outOfWorld\",\"with\":[\"Steve\"]\}", "the void, told as its own")
    _ = t.record(hurt(FALL, 1.0f32, none, 50.0f32), 6, true, false)
    check(told(t, types), "\{\"translate\":\"death.fell.accident.ladder\",\"with\":[\"Steve\"]\}", "a fall after the void")

    // A bed in the nether: the bug report's link.
    t = CombatTracker()
    _ = t.record(hurt(BAD_RESPAWN_POINT, 20.0f32, none, 0.0f32), 0, true, false)
    check(told(t, types), "\{\"translate\":\"death.attack.badRespawnPoint.message\",\"with\":[\"Steve\",\{\"translate\":\"chat.square_brackets\",\"with\":[\{\"translate\":\"death.attack.badRespawnPoint.link\"\}],\"click_event\":\{\"url\":\"https://bugs.mojang.com/browse/MCPE-28723\",\"action\":\"open_url\"\},\"hover_event\":\{\"value\":\"MCPE-28723\",\"action\":\"show_text\"\}\}]\}", "a bad respawn point")

    // Hurts kept till 100 ticks after the last, and forgotten as it dies.
    t = CombatTracker()
    _ = t.record(hurt(IN_WALL, 1.0f32, none, 0.0f32), 10, true, false)
    _ = t.recheck(110, true)
    check("{t.entries.len()}", "1", "hurts 100 ticks after")
    _ = t.recheck(111, true)
    check("{t.entries.len()}", "0", "hurts 101 ticks after")
    _ = t.record(hurt(IN_WALL, 1.0f32, none, 0.0f32), 120, true, false)
    _ = t.recheck(121, false)
    check("{t.entries.len()}", "0", "hurts as it dies")
    // A living entity's hurt brings it into combat, which keeps its hurts 300 ticks.
    let (_, entered) = t.record(hurt(IN_WALL, 1.0f32, none, 0.0f32), 200, true, true)
    check("{entered}", "true", "into combat")
    _ = t.recheck(450, true)
    check("{t.entries.len()}", "1", "hurts 250 ticks after in combat")
    check("{t.recheck(501, true)}", "true", "out of combat")
    check("{t.duration(600)}", "301", "combat's duration")
    // A hurt 301 ticks after the last in combat takes it out of combat first, then into it again
    // (D442).
    _ = t.record(hurt(IN_WALL, 1.0f32, none, 0.0f32), 700, true, true)
    let (left, again) = t.record(hurt(IN_WALL, 1.0f32, none, 0.0f32), 1001, true, true)
    check("{left ?? -1} {again}", "301 true", "out of combat and in again")

    // Hurt by a zombie, which the message names, hovering showing it, its UUID to put in the chat
    // box (D442).
    let zombie = entity_display_name(String("minecraft:zombie"), Uuid.new(1i64, 2i64), none)
    let thorns = types.id("thorns")
    let mob_attack = types.id("mob_attack")
    t = CombatTracker()
    _ = t.record(by(thorns, 7, zombie, 3.0f32), 0, true, true)
    check(told(t, types), "\{\"translate\":\"death.attack.thorns\",\"with\":[\"Steve\",\{\"translate\":\"entity.minecraft.zombie\",\"hover_event\":\{\"id\":\"minecraft:zombie\",\"uuid\":[0,1,0,2],\"name\":\{\"translate\":\"entity.minecraft.zombie\"\},\"action\":\"show_entity\"\},\"insertion\":\"00000000-0000-0001-0000-000000000002\"\}]\}", "by a zombie")
    // A named one, by its name.
    let spike = entity_display_name(String("minecraft:zombie"), Uuid.new(1i64, 2i64), some(Component.literal(String("Spike"))))
    t = CombatTracker()
    _ = t.record(by(thorns, 7, spike, 3.0f32), 0, true, true)
    check(told(t, types), "\{\"translate\":\"death.attack.thorns\",\"with\":[\"Steve\",\{\"text\":\"Spike\",\"hover_event\":\{\"id\":\"minecraft:zombie\",\"uuid\":[0,1,0,2],\"name\":\"Spike\",\"action\":\"show_entity\"\},\"insertion\":\"00000000-0000-0001-0000-000000000002\"\}]\}", "by a named zombie")
    // A long fall after the zombie's hit: it assisted. The same fall the zombie dealt: it
    // finished them.
    t = CombatTracker()
    _ = t.record(by(mob_attack, 7, spike, 2.0f32), 0, true, true)
    _ = t.record(hurt(FALL, 7.0f32, none, 10.0f32), 5, true, false)
    check(told(t, types), "\{\"translate\":\"death.fell.assist\",\"with\":[\"Steve\",\{\"text\":\"Spike\",\"hover_event\":\{\"id\":\"minecraft:zombie\",\"uuid\":[0,1,0,2],\"name\":\"Spike\",\"action\":\"show_entity\"\},\"insertion\":\"00000000-0000-0001-0000-000000000002\"\}]\}", "an assisted fall")
    t = CombatTracker()
    _ = t.record(by(mob_attack, 7, spike, 2.0f32), 0, true, true)
    _ = t.record(CombatEntry { kind: FALL, cause: 7, direct: 7, damage: 7.0f32, fall_distance: 10.0f32, cause_name: some(spike.copy()), direct_name: some(spike.copy()) }, 5, true, true)
    check(told(t, types), "\{\"translate\":\"death.fell.finish\",\"with\":[\"Steve\",\{\"text\":\"Spike\",\"hover_event\":\{\"id\":\"minecraft:zombie\",\"uuid\":[0,1,0,2],\"name\":\"Spike\",\"action\":\"show_entity\"\},\"insertion\":\"00000000-0000-0001-0000-000000000002\"\}]\}", "a fall the zombie finished")
    println("combat: ok")
}
