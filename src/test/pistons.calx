/// Checks pistons in the server's level as vanilla moves blocks with them (CAL-125), on a flat
/// level whose chunks tick, with block facts made from the built-in block and fluid registries: a
/// piston powered pushes the block in front out over two ticks, with its sound and its block
/// event heard; unpowered, it pulls its head back and leaves the block, and a sticky one brings
/// it back with it; slime pulls the blocks it touches along; and nothing moves past twelve
/// blocks, nor obsidian.
module test.pistons

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Heard, Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{AIR_STATE, BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// A flat level, its spawn's chunks full and given the facts, with a player at its middle, so
// its chunks tick.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn with(f: Facts, name: str, prop: str, value: str) -> u32 {
    return match f.with_name(named(f, name), String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("{name} has no {prop} {value}"),
    }
}

// Runs `ticks` of the level's ticks as `ServerLevel.tick` runs what pistons read: its block and
// fluid ticks, then its block events, then its block entities.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.handling = true
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
        level.run_block_events()
        level.handling = false
        level.tick_block_entities()
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn block_at(f: Facts, level: Level, x: i32, y: i32, z: i32) -> String {
    return f.codec.blocks.name(f.block(level.spawn_state(x, y, z))).copy()
}

// What the level reported isn't in Calcite yet, one line each, but entities moved by a piston.
fn quiet(level: mut Level, what: str) {
    var out = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") and not e.message.contains("Entities moved by a piston") {
            out = "{out}{e.message}; "
        }
    }
    if not out.is_empty() {
        panic("{what} reported {out}")
    }
}

// A piston facing east with stone in front, powered from behind by a redstone block: its event
// runs that tick, the head and the stone moving pistons until two ticks on, when they're set;
// the players hear the sound, then the event. Unpowered, the head goes back at once and the
// piston's base is set two ticks on; the stone stays.
fn push() {
    let f = facts()
    var level = flat_level(f)
    let piston = with(f, "piston", "facing", "east")
    set(mut level, 4, -60, 4, piston, "the piston wasn't set")
    set(mut level, 5, -60, 4, named(f, "stone"), "the stone wasn't set")
    _ = level.take_heard()
    set(mut level, 3, -60, 4, named(f, "redstone_block"), "the redstone block wasn't set")
    check(block_at(f, level, 5, -60, 4) == "minecraft:stone", "the stone moved before the event ran")
    run(mut level, 1)
    check(f.get_bool(level.spawn_state(4, -60, 4), String("extended")), "the piston isn't out")
    check(block_at(f, level, 5, -60, 4) == "minecraft:moving_piston", "the head isn't moving")
    check(block_at(f, level, 6, -60, 4) == "minecraft:moving_piston", "the stone isn't moving")
    let heard = level.take_heard()
    var sounds = 0
    var events = 0
    for h in heard {
        match h {
            Heard.Sound(s) => {
                check(s.sound == "block.piston.extend" and s.x == 4.5 and s.volume == 0.5f32 and s.pitch >= 0.6f32 and s.pitch < 0.85f32, "the extend sound")
                check(events == 0, "the sound came after the event")
                sounds += 1
            },
            Heard.Block(e) => {
                check(e.x == 4 and e.b0 == 0 and e.b1 == 5, "the event to move out east")
                events += 1
            },
            _ => {},
        }
    }
    check(sounds == 1 and events == 1, "the sound and the event weren't heard once each")
    run(mut level, 1)
    check(block_at(f, level, 6, -60, 4) == "minecraft:moving_piston", "the stone was set a tick early")
    run(mut level, 1)
    check(block_at(f, level, 5, -60, 4) == "minecraft:piston_head", "the head wasn't set")
    check(block_at(f, level, 6, -60, 4) == "minecraft:stone", "the stone wasn't set in front")
    check(level.moving_piston_count() == 0, "a moving piston's left")
    set(mut level, 3, -60, 4, AIR_STATE, "the redstone block wasn't taken away")
    run(mut level, 1)
    check(block_at(f, level, 4, -60, 4) == "minecraft:moving_piston", "the piston isn't moving in")
    check(block_at(f, level, 5, -60, 4) == "minecraft:air", "the head wasn't taken away")
    run(mut level, 2)
    check(level.spawn_state(4, -60, 4) == piston, "the piston wasn't set back in")
    check(block_at(f, level, 6, -60, 4) == "minecraft:stone", "the stone moved back")
    quiet(mut level, "pushing stone")
    println("ok push")
}

// A sticky piston pulls the stone it pushed back with its head.
fn sticky() {
    let f = facts()
    var level = flat_level(f)
    let piston = with(f, "sticky_piston", "facing", "east")
    set(mut level, 4, -60, 4, piston, "the piston wasn't set")
    set(mut level, 5, -60, 4, named(f, "stone"), "the stone wasn't set")
    set(mut level, 3, -60, 4, named(f, "redstone_block"), "the redstone block wasn't set")
    run(mut level, 3)
    check(block_at(f, level, 5, -60, 4) == "minecraft:piston_head", "the head wasn't set")
    check(f.get_name(level.spawn_state(5, -60, 4), String("type")) == some(String("sticky")), "the head isn't sticky")
    set(mut level, 3, -60, 4, AIR_STATE, "the redstone block wasn't taken away")
    run(mut level, 3)
    check(level.spawn_state(4, -60, 4) == piston, "the piston wasn't set back in")
    check(block_at(f, level, 5, -60, 4) == "minecraft:stone", "the stone wasn't pulled back")
    check(block_at(f, level, 6, -60, 4) == "minecraft:air", "the stone stayed out")
    quiet(mut level, "pulling stone")
    println("ok sticky")
}

// Slime in front, in the air, with stone on it above and beside: all three move. On the ground
// it sticks to the grass under it, whose line runs on past twelve blocks, so nothing moves; and
// honey beside it doesn't stick to it.
fn slime() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 4, -60, 4, with(f, "piston", "facing", "east"), "the piston on the ground wasn't set")
    set(mut level, 5, -60, 4, named(f, "slime_block"), "the slime on the ground wasn't set")
    set(mut level, 3, -60, 4, named(f, "redstone_block"), "the redstone block on the ground wasn't set")
    run(mut level, 3)
    check(not f.get_bool(level.spawn_state(4, -60, 4), String("extended")), "the slime stuck to the ground moved")
    set(mut level, 4, -55, 4, with(f, "piston", "facing", "east"), "the piston wasn't set")
    set(mut level, 5, -55, 4, named(f, "slime_block"), "the slime wasn't set")
    set(mut level, 5, -54, 4, named(f, "stone"), "the stone above wasn't set")
    set(mut level, 5, -55, 5, named(f, "stone"), "the stone beside wasn't set")
    set(mut level, 5, -55, 3, named(f, "honey_block"), "the honey wasn't set")
    set(mut level, 3, -55, 4, named(f, "redstone_block"), "the redstone block wasn't set")
    run(mut level, 3)
    check(block_at(f, level, 6, -55, 4) == "minecraft:slime_block", "the slime wasn't pushed")
    check(block_at(f, level, 6, -54, 4) == "minecraft:stone", "the stone above wasn't pulled along")
    check(block_at(f, level, 6, -55, 5) == "minecraft:stone", "the stone beside wasn't pulled along")
    check(block_at(f, level, 5, -54, 4) == "minecraft:air", "the stone above stayed")
    check(block_at(f, level, 5, -55, 3) == "minecraft:honey_block", "the honey moved with the slime")
    quiet(mut level, "pushing slime")
    println("ok slime")
}

// Thirteen blocks in a line, or obsidian, and the piston stays in, with no event kept.
fn stuck() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 1, -60, 1, with(f, "piston", "facing", "east"), "the piston wasn't set")
    for i in 0..13 {
        set(mut level, 2 + i, -60, 1, named(f, "stone"), "a stone wasn't set")
    }
    set(mut level, 0, -60, 1, named(f, "redstone_block"), "the redstone block wasn't set")
    run(mut level, 1)
    check(not f.get_bool(level.spawn_state(1, -60, 1), String("extended")), "thirteen blocks were pushed")
    set(mut level, 14, -60, 1, AIR_STATE, "the last stone wasn't taken away")
    run(mut level, 1)
    check(not f.get_bool(level.spawn_state(1, -60, 1), String("extended")), "the piston moved with nothing changed beside it")
    set(mut level, 1, -60, 3, with(f, "piston", "facing", "east"), "the second piston wasn't set")
    set(mut level, 2, -60, 3, named(f, "obsidian"), "the obsidian wasn't set")
    set(mut level, 0, -60, 3, named(f, "redstone_block"), "the second redstone block wasn't set")
    run(mut level, 3)
    check(not f.get_bool(level.spawn_state(1, -60, 3), String("extended")), "obsidian was pushed")
    check(block_at(f, level, 2, -60, 3) == "minecraft:obsidian", "the obsidian moved")
    quiet(mut level, "pushing what can't move")
    println("ok stuck")
}

fn main() {
    push()
    sticky()
    slime()
    stuck()
    println("ok")
}
