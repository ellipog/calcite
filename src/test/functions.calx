/// Checks `server.functions`: functions read from their files' text as vanilla's
/// `CommandFunction.fromLines` reads them, and the exceptions it throws for those it can't (D567);
/// macro functions made with their arguments as `MacroFunction.instantiate` makes them, each value
/// written as `stringify` writes it (D568).
module test.functions

import chat.component.{Argument, Component, Contents}
import chat.language.{Language}
import command.dispatcher.{entity_types}
import nbt.snbt.{parse as parse_snbt}
import resources.identifier.{Identifier}
import server.commands.{full_tree}
import server.functions.{Function, instantiate, macro_value, read_function}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

// The function `t:f` with the file's text, or the exception it can't be read for.
fn function_of(text: String) -> Function ! String {
    let id = Identifier { namespace: String("t"), path: String("f") }
    return try read_function(id, text, full_tree(), entity_types(), Language.empty())
}

// How many commands the function `t:f` with the file's text has, or for a macro function how many
// lines and its parameters; or the exception it can't be read for.
fn read(text: String) -> String {
    return match function_of(text) {
        ok(f) => shown(f),
        err(message) => message,
    }
}

fn shown(f: Function) -> String {
    if not f.is_macro() {
        return "{f.lines.len()} lines"
    }
    var names = String()
    for p in f.parameters {
        if not names.is_empty() {
            names.push_str(", ")
        }
        names.push_str(p)
    }
    return "macro of {f.template.len()} lines with {names}"
}

// The macro function `t:f` with the file's text made with the arguments in SNBT: how many commands
// it has, or why it can't be made, its key and its arguments' text.
fn made_with(text: String, arguments: str) -> String {
    let f = match function_of(text) {
        ok(f) => f,
        err(_) => panic("{text} doesn't read"),
    }
    let given = match parse_snbt(String(arguments)) {
        ok(t) => t,
        err(_) => panic("{arguments} doesn't read"),
    }
    return match instantiate(f, given, full_tree(), entity_types(), Language.empty()) {
        ok(made) => shown(made),
        err(c) => reason(c),
    }
}

fn reason(c: Component) -> String {
    let Contents.Translatable(t) = c.contents else return c.get_string(Language.empty())
    var out = t.key.copy()
    for a in t.args {
        match a {
            Argument.Text(x) => out.push_str(" | {reason(x)}"),
            _ => out.push_str(" | ?"),
        }
    }
    return out
}

// A macro argument's value given in SNBT, as a macro line has it.
fn value(snbt: str) -> String {
    let t = match parse_snbt(String(snbt)) {
        ok(t) => t,
        err(_) => panic("{snbt} doesn't read"),
    }
    return macro_value(t)
}

fn main() {
    let illegal = "java.lang.IllegalArgumentException: "
    check(read(String("say hi\nkill")), "2 lines", "two commands")
    check(read(String("# a comment\n\n  say hi  \r\n\r\n")), "1 lines", "comments, blank lines and spaces")
    check(read(String("say a\rkill\r\nkill")), "3 lines", "lines ended each way")
    check(read(String("say a \\\n  b \\\n c")), "1 lines", "a line continued twice")
    check(read(String("say a \\")), "{illegal}Line continuation at end of file", "a continuation at the end")
    check(read(String("say a \\\n\\")), "{illegal}Line continuation at end of file", "a continuation continued at the end")
    check(read(String("/say hi")), "{illegal}Unknown or invalid command '/say hi' on line 1 (did you mean 'say'? Do not use a preceding forwards slash.)", "a slash")
    check(read(String("say a\n  //x")), "{illegal}Unknown or invalid command '//x' on line 2 (if you intended to make a comment, use '#' not '//')", "two slashes")
    check(read(String("/")), "java.lang.StringIndexOutOfBoundsException: Index 1 out of bounds for length 1", "a slash alone")
    check(read(String("$say $(a)")), "macro of 1 lines with a", "a macro line")
    check(read(String("kill\n$say $(a) and $(b_2)\nkill")), "macro of 3 lines with a, b_2", "commands around a macro line")
    check(read(String("$say $(b) $(a) $(b)\n$say $(c)$(a)")), "macro of 2 lines with b, a, c", "parameters in the order first named")
    check(read(String("$say $a $( $(x)")), "{illegal}Can't parse function line 1: 'say $a $( $(x)'", "a `$(` with a space in its name")
    check(read(String("$say $a $(x) $")), "macro of 1 lines with x", "a `$` that's no variable")
    check(read(String("$say a")), "{illegal}Can't parse function line 1: 'say a'", "a macro line with no variables")
    check(read(String("$say $(a")), "{illegal}Can't parse function line 1: 'say $(a'", "a macro variable unclosed")
    check(read(String("\n$say $(a-b)")), "{illegal}Can't parse function line 2: 'say $(a-b)'", "a macro variable's name")
    check(read(String("say a\nfoo")), "{illegal}Whilst parsing command on line 2: command.unknown.command at position 0: <--[HERE]", "a command there isn't")
    check(read(String("kill @s\ngamemode creative nobody_at_all_here")), "{illegal}Whilst parsing command on line 2: argument.entity.invalid at position 18: ... creative <--[HERE]", "a failure past ten characters in")
    check(read(String("say a \\\nb\nfoo")), "{illegal}Whilst parsing command on line 3: command.unknown.command at position 0: <--[HERE]", "the line after a continued one")
    // Macro functions made with their arguments.
    let macro = String("kill\n$say $(a) and $(b)\n$gamemode $(mode)")
    check(made_with(macro.copy(), "\{a:1,b:\"x y\",mode:creative\}"), "3 lines", "a macro function made")
    check(made_with(macro.copy(), "\{a:1,mode:creative\}"), "commands.function.error.missing_argument | t:f | b", "an argument missing")
    check(made_with(macro.copy(), "\{b:1\}"), "commands.function.error.missing_argument | t:f | a", "the first argument missing first")
    check(made_with(macro.copy(), "\{a:1,b:2,mode:sideways\}"), "commands.function.error.parse | t:f | gamemode sideways | argument.gamemode.invalid at position 17: ...e sideways<--[HERE]", "a line that doesn't read once made")
    check(made_with(String("$$(c)"), "\{c:\"kill\"\}"), "1 lines", "a line that's all variable")
    // Values as `stringify` writes them.
    check(value("1"), "1", "an int")
    check(value("2b"), "2", "a byte")
    check(value("-3s"), "-3", "a short")
    check(value("5L"), "5", "a long")
    check(value("0.1f"), ".100000001490116", "a float")
    check(value("-0.0d"), "0", "a double's negative zero, which DoubleTag.valueOf makes 0")
    check(value("1.5d"), "1.5", "a double")
    check(value("1e20d"), "100000000000000000000", "a big double")
    check(value("\"a b\""), "a b", "a string")
    check(value("[1,2]"), "[1,2]", "a list")
    check(value("\{b:1b,a:\"x\"\}"), "\{a:\"x\",b:1b\}", "a compound, its keys in order")
    check(value("[I;1,2]"), "[I;1,2]", "an int array")
    print("ok\n")
}
