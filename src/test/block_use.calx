/// Checks `world.block_use`'s uses by hand, as vanilla's blocks' `useWithoutItem` has them (D379),
/// on a flat level whose chunks tick: a door opened, its top following, and shut; an iron door
/// that won't; a fence gate opened away from the player and shut; a lever pulled on and off,
/// lighting a lamp; a button pressed, then pressed again while it's down, and let go on its tick;
/// a repeater's delay going round; a comparator's mode; a note block tuned round and played; redstone
/// dust turned to a cross and back; and a light block's level, only for a game master.
module test.block_use

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Heard, Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.block_use.{Handed, Used, User, use_without_item}
import world.chunk.{BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.placing.{PlaceFacts}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts, NORTH, UP, WEST}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn with(f: Facts, state: u32, property: str, value: str) -> u32 {
    return match f.with_name(state, String(property), String(value)) {
        ok(s) => s,
        err(_) => panic("no {property} {value}"),
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.handling = true
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
        level.run_block_events()
        level.handling = false
        level.tick_block_entities()
    }
}

// A survival player, entity 7, facing south, with nothing in their hands, clicking the face given.
fn hand(face: i32) -> User {
    return User { item: String(), held: none, item_id: -1, hand: 0, offhand: String(), may_build: true, game_master: false, can_eat: false, face: face, at_y: 0.5, block_item: false, can_place: false, player: 7 }
}

// The block at x, y, z used by `u`: what the use came to, nothing told of as missing.
fn used(f: Facts, p: PlaceFacts, level: mut Level, x: i32, y: i32, z: i32, u: User) -> Used {
    let state = level.spawn_state(x, y, z)
    var missing = List<String>()
    var handed = List<Handed>()
    let result = match use_without_item(f, p, mut level, state, x, y, z, u, mut handed, mut missing) {
        ok(r) => r,
        err(e) => panic("the use threw: {e.message}"),
    }
    check(missing.is_empty(), "a use was told of as missing")
    return result
}

fn done(u: Used) -> bool {
    return match u {
        Used.Done => true,
        _ => false,
    }
}

fn prop(f: Facts, level: Level, x: i32, y: i32, z: i32, name: str) -> String {
    return f.get_name(level.spawn_state(x, y, z), String(name)) ?? String("-")
}

// The sounds heard, by name, and whom each leaves out.
fn sounds(level: mut Level) -> String {
    var out = String("")
    for h in level.take_heard() {
        match h {
            Heard.Sound(s) => out = "{out}{s.sound}/{s.except} ",
            _ => {},
        }
    }
    return out
}

fn main() {
    let f = facts()
    let p = PlaceFacts.new()
    var level = flat_level(f)

    // A door opened from its bottom, the top following, its sound for all but the player; shut.
    set(mut level, 2, -60, 0, with(f, with(f, named(f, "oak_door"), "half", "lower"), "facing", "west"), "the door's bottom")
    set(mut level, 2, -59, 0, with(f, with(f, named(f, "oak_door"), "half", "upper"), "facing", "west"), "the door's top")
    _ = level.take_heard()
    check(done(used(f, p, mut level, 2, -60, 0, hand(WEST))), "the door didn't take the use")
    check(prop(f, level, 2, -60, 0, "open") == "true" and prop(f, level, 2, -59, 0, "open") == "true", "the door isn't open")
    check(sounds(mut level) == "block.wooden_door.open/7 ", "the door's sound")
    check(done(used(f, p, mut level, 2, -59, 0, hand(WEST))), "the door's top didn't take the use")
    check(prop(f, level, 2, -60, 0, "open") == "false", "the door isn't shut")
    // An iron door passes.
    set(mut level, 4, -60, 0, with(f, named(f, "iron_door"), "half", "lower"), "the iron door")
    check(not done(used(f, p, mut level, 4, -60, 0, hand(WEST))), "the iron door took the use")
    println("ok doors")

    // A fence gate facing the player opens away from them; shut, it keeps that way.
    set(mut level, 0, -60, 2, with(f, named(f, "oak_fence_gate"), "facing", "north"), "the gate")
    check(done(used(f, p, mut level, 0, -60, 2, hand(NORTH))), "the gate didn't take the use")
    check(prop(f, level, 0, -60, 2, "open") == "true" and prop(f, level, 0, -60, 2, "facing") == "south", "the gate didn't open away")
    check(done(used(f, p, mut level, 0, -60, 2, hand(NORTH))), "the gate didn't shut")
    check(prop(f, level, 0, -60, 2, "open") == "false" and prop(f, level, 0, -60, 2, "facing") == "south", "the gate turned as it shut")
    println("ok gate")

    // A lever on the floor lights the lamp beside it, its click heard by everyone; off, the lamp
    // goes out 4 ticks on.
    set(mut level, 0, -60, -2, with(f, with(f, named(f, "lever"), "face", "floor"), "facing", "north"), "the lever")
    set(mut level, 1, -60, -2, named(f, "redstone_lamp"), "the lamp")
    _ = level.take_heard()
    check(done(used(f, p, mut level, 0, -60, -2, hand(UP))), "the lever didn't take the use")
    check(prop(f, level, 0, -60, -2, "powered") == "true" and prop(f, level, 1, -60, -2, "lit") == "true", "the lamp isn't lit")
    check(sounds(mut level) == "block.lever.click/-1 ", "the lever's click")
    _ = used(f, p, mut level, 0, -60, -2, hand(UP))
    check(prop(f, level, 1, -60, -2, "lit") == "true", "the lamp went out at once")
    run(mut level, 4)
    check(prop(f, level, 1, -60, -2, "lit") == "false", "the lamp didn't go out")
    println("ok lever")

    // A stone button stays down 20 ticks, taking another use while it is, then lets go.
    set(mut level, -2, -60, -2, with(f, with(f, named(f, "stone_button"), "face", "floor"), "facing", "north"), "the button")
    set(mut level, -3, -60, -2, named(f, "redstone_lamp"), "the button's lamp")
    _ = level.take_heard()
    check(done(used(f, p, mut level, -2, -60, -2, hand(UP))), "the button didn't take the use")
    check(prop(f, level, -2, -60, -2, "powered") == "true" and prop(f, level, -3, -60, -2, "lit") == "true", "the button's lamp isn't lit")
    check(sounds(mut level) == "block.stone_button.click_on/7 ", "the button's click")
    check(done(used(f, p, mut level, -2, -60, -2, hand(UP))), "the button down didn't take the use")
    run(mut level, 19)
    check(prop(f, level, -2, -60, -2, "powered") == "true", "the button let go early")
    run(mut level, 1)
    check(prop(f, level, -2, -60, -2, "powered") == "false", "the button didn't let go")
    println("ok button")

    // A repeater's delay goes round from 4 to 1; a comparator switches to subtract; a note block
    // goes round from 24 to 0.
    set(mut level, 2, -60, -2, named(f, "repeater"), "the repeater")
    for want in ["2", "3", "4", "1"] {
        _ = used(f, p, mut level, 2, -60, -2, hand(UP))
        check(prop(f, level, 2, -60, -2, "delay") == String(want), "the repeater's delay")
    }
    set(mut level, 3, -60, -1, named(f, "comparator"), "the comparator")
    _ = used(f, p, mut level, 3, -60, -1, hand(UP))
    check(prop(f, level, 3, -60, -1, "mode") == "subtract", "the comparator's mode")
    set(mut level, -1, -60, 3, with(f, named(f, "note_block"), "note", "24"), "the note block")
    _ = used(f, p, mut level, -1, -60, 3, hand(UP))
    check(prop(f, level, -1, -60, 3, "note") == "0", "the note block's note")
    println("ok switches")

    // Redstone dust on its own, a dot, turns to a cross and back; one joined to another passes.
    set(mut level, -1, -60, -5, named(f, "redstone_wire"), "the dust")
    check(done(used(f, p, mut level, -1, -60, -5, hand(UP))), "the dot didn't turn")
    check(prop(f, level, -1, -60, -5, "north") == "side" and prop(f, level, -1, -60, -5, "east") == "side", "the dust isn't a cross")
    check(done(used(f, p, mut level, -1, -60, -5, hand(UP))), "the cross didn't turn")
    check(prop(f, level, -1, -60, -5, "north") == "none" and prop(f, level, -1, -60, -5, "west") == "none", "the dust isn't a dot")
    println("ok dust")

    // A light block's level turns only for a game master, the use taken either way.
    set(mut level, 5, -60, 5, with(f, named(f, "light"), "level", "15"), "the light")
    check(done(used(f, p, mut level, 5, -60, 5, hand(UP))), "the light didn't take the use")
    check(prop(f, level, 5, -60, 5, "level") == "15", "the light turned for a player")
    var master = hand(UP)
    master.game_master = true
    _ = used(f, p, mut level, 5, -60, 5, master)
    check(prop(f, level, 5, -60, 5, "level") == "0", "the light didn't turn round")
    println("ok light")
}
