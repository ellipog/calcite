/// Checks `storage.symlinks`: `allowed_symlinks.txt` read as vanilla's `PathAllowList` reads it,
/// targets matched as its entries match them, on this system, and a world's folder walked for
/// the links it doesn't allow. The rig's `allow_list` and `world_folder` probes check the same
/// against vanilla, on Windows and on Linux. Where this system won't make a symbolic link, as
/// Windows won't without a privilege, the walk is checked without them.
module test.symlinks

import server.log.{Entry}
import std.fs.{FsError, make_dir_all, make_link, remove_dir_all, separator, temp_dir, write}
import storage.symlinks.{AllowList, Forbidden, WalkError, forbidden_links, read_allow_list, refusal}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn windows() -> bool {
    return separator() == "\\"
}

// A path written with `/`, as this system writes it: under `C:` on Windows, if it's absolute.
fn native(path: String) -> String {
    if not windows() {
        return path.copy()
    }
    var out = if path.starts_with("/") { String("C:") } else { String() }
    for c in path.runes() {
        if c == '/' {
            out.push_str("\\")
        } else {
            out.push(c)
        }
    }
    return out
}

// A glob for an absolute path: `/` stands for Windows' separator in a glob too.
fn glob_path(path: String) -> String {
    return if windows() { "C:{path}" } else { path.copy() }
}

fn parsed(text: String) -> String {
    return match AllowList.parse(text) {
        ok(_) => String("ok"),
        err(e) => e,
    }
}

fn shown(yes: bool, lines: List<Entry>) -> String {
    var out = if yes { String("yes") } else { String("no") }
    for l in lines {
        out.push_str(" [{l.message}]")
    }
    return out
}

fn allows(text: String, target: String) -> String {
    var lines = List<Entry>()
    var allow = match AllowList.parse(text) {
        ok(a) => a,
        err(e) => panic("`{text}` didn't parse: {e}"),
    }
    let yes = allow.matches(target, mut lines)
    return shown(yes, lines)
}

fn found_text(found: List<Forbidden>) -> String {
    var out = String()
    for f in found {
        out.push_str("[{f.link}->{f.target}]")
    }
    return out
}

fn walked(directory: String, text: String) -> String {
    var lines = List<Entry>()
    var allow = match AllowList.parse(text) {
        ok(a) => a,
        err(e) => panic("`{text}` didn't parse: {e}"),
    }
    return match forbidden_links(directory, mut allow, mut lines) {
        ok(found) => found_text(found),
        err(WalkError.NotDirectory) => String("not a directory"),
        err(WalkError.Files { error, path }) => match error {
            FsError.NotFound => "not found: {path}",
            _ => "failed: {path}",
        },
    }
}

fn main() {
    // Lines, as `readPlain` reads them.
    check(parsed(""), "ok", "an empty file")
    check(parsed("# a comment\n\n   \n\t\n/srv"), "ok", "comments and blank lines")
    check(parsed("[x"), "Unterminated type in line '[x'", "no ]")
    check(parsed("ok\n["), "Unterminated type in line '['", "[ alone")
    check(parsed("[]x"), "Unsupported definition type in line '[]x'", "no type")
    check(parsed("[Glob]x"), "Unsupported definition type in line '[Glob]x'", "a type's case")
    check(parsed("[prefix]a\n[path]b"), "Unsupported definition type in line '[path]b'", "an unknown type")
    check(parsed("[glob]]x"), "ok", "] after the type")
    check(allows(" [prefix]x", " [prefix]xyz"), "yes", "a space first makes a prefix")
    check(allows("a\r\nb\rc", "c1"), "yes", "lines ended each way")
    check(allows("", native("/srv")), "no", "nothing allowed")
    check(allows("# /srv", native("/srv")), "no", "a comment allows nothing")

    // Prefixes, which are only text.
    let prefix = "[prefix]{native("/srv")}"
    check(allows(prefix, native("/srv/x")), "yes", "a prefix")
    check(allows(prefix, native("/srvx")), "yes", "a prefix of a name")
    check(allows(prefix, native("/other")), "no", "another folder")
    check(allows(native("/srv/"), native("/srv/x")), "yes", "a prefix without its type")
    check(allows("[prefix]", native("/anything")), "yes", "an empty prefix")
    check(allows("[prefix]..", "../x"), "yes", "a relative prefix")

    // Globs and regular expressions, matched against the whole target, without regard to case on
    // Windows.
    let star = "[glob]{glob_path("/srv/*")}"
    check(allows(star, native("/srv/x")), "yes", "a glob")
    check(allows(star, native("/srv/x/y")), "no", "* in one name")
    check(allows("[glob]{glob_path("/srv/**")}", native("/srv/x/y")), "yes", "** across names")
    check(allows("[glob]{glob_path("/\{srv,data\}/?")}", native("/data/x")), "yes", "braces and ?")
    check(allows("[glob]{glob_path("/SRV/*")}", native("/srv/x")), if windows() { "yes" } else { "no" }, "a glob's case")
    check(allows("[regex].*x", native("/srv/x")), "yes", "a regular expression")
    check(allows("[regex]x", native("/srv/x")), "no", "the whole target")
    check(allows("[regex].*X", native("/srv/x")), if windows() { "yes" } else { "no" }, "a regular expression's case")
    check(allows("/nowhere\n[regex]nothing\n[glob]{glob_path("/srv/*")}", native("/srv/x")), "yes", "the third entry")

    // An entry that doesn't compile refuses every link, and says so once.
    var lines = List<Entry>()
    var broken = match AllowList.parse("[prefix]{native("/srv")}\n[glob]\{a\{b\}\}") {
        ok(a) => a,
        err(e) => panic(e),
    }
    let first = broken.matches(native("/srv/x"), mut lines)
    let second = broken.matches(native("/srv/x"), mut lines)
    check(shown(first or second, lines), "no [Failed to compile file pattern list]", "a glob that doesn't compile")
    check(allows("[regex](\n[prefix]", "x"), "no [Failed to compile file pattern list]", "a regular expression that doesn't compile")
    check(allows("[regex]\\p\{L\}+", "x"), "no [Calcite can't match the pattern `\\p\{L\}+` in allowed_symlinks.txt yet, which uses Unicode properties, so no symbolic link is allowed]", "a pattern Calcite can't match")
    check(allows("[regex]\\p\{L\}+\n[glob]\{", "x"), "no [Failed to compile file pattern list]", "a pattern that doesn't compile after one Calcite can't match")
    var none_lines = List<Entry>()
    var nothing = AllowList.nothing()
    check(shown(nothing.matches(native("/srv"), mut none_lines), none_lines), "no", "nothing allowed")

    // The file, read as the server starts.
    let universe = temp_dir()!
    let sep = separator()
    let file = "{universe}{sep}allowed_symlinks.txt"
    var read_lines = List<Entry>()
    var missing = read_allow_list(file, mut read_lines)
    check(shown(missing.matches(native("/srv"), mut read_lines), read_lines), "no", "no file")
    write(file, "[prefix]{native("/srv")}".to_bytes())!
    var good = read_allow_list(file, mut read_lines)
    check(shown(good.matches(native("/srv/x"), mut read_lines), read_lines), "yes", "a file")
    let not_utf8: List<u8> = [47, 255, 10]
    write(file, not_utf8)!
    var bad = read_allow_list(file, mut read_lines)
    check(shown(bad.matches(native("/"), mut read_lines), read_lines), "no [Failed to parse allowed_symlinks.txt, disallowing all symbolic links]", "a file that isn't UTF-8")
    read_lines.clear()
    write(file, "[prefix]/\n[nope]".to_bytes())!
    var unknown = read_allow_list(file, mut read_lines)
    check(shown(unknown.matches(native("/"), mut read_lines), read_lines), "no [Failed to parse allowed_symlinks.txt, disallowing all symbolic links]", "a file with a line that isn't an entry")

    // The walk.
    let world = "{universe}{sep}world"
    check(walked(world, ""), "", "no folder")
    write(world, "a file".to_bytes())!
    check(walked(world, ""), "not a directory", "a file")
    remove_dir_all(universe)!
    make_dir_all("{world}{sep}region")!
    write("{world}{sep}level.dat", "x".to_bytes())!
    check(walked(world, ""), "", "no links")
    let elsewhere = native("/elsewhere")
    match make_link(elsewhere, "{world}{sep}region{sep}b") {
        ok => {
            check(walked(world, ""), "[{world}{sep}region{sep}b->{elsewhere}]", "a link")
            check(walked(world, "[prefix]{elsewhere}"), "", "an allowed link")
            let up_a = native("../a")
            let up_b = native("../B")
            make_link(up_a, "{world}{sep}a")!
            make_link(up_b, "{world}{sep}B")!
            let a = "[{world}{sep}a->{up_a}]"
            let b = "[{world}{sep}B->{up_b}]"
            let region = "[{world}{sep}region{sep}b->{elsewhere}]"
            check(walked(world, "[prefix]..\n[prefix]{elsewhere}"), "", "relative links allowed")
            check(walked(world, "[prefix]..\n# not elsewhere"), region, "relative links allowed and one that isn't")
            // Windows lists names by their letters uppercased, and Calcite lists them by their
            // bytes elsewhere, where the file system's order is its own.
            check(walked(world, "[prefix]{elsewhere}"), if windows() { "{a}{b}" } else { "{b}{a}" }, "the walk's order")
            check(refusal(world, [Forbidden { link: "{world}{sep}a", target: String("x") }, Forbidden { link: String("y"), target: String("z") }]), "Failed to validate '{world}'. Found forbidden symlinks: {world}{sep}a->x, y->z", "the refusal")
            // A world that's a link is walked from its target, as it's written.
            let other = "{universe}{sep}other"
            make_link("{universe}{sep}.", other)!
            let rest = "[prefix]..\n[prefix]{elsewhere}"
            check(walked(other, "[prefix]{universe}\n{rest}"), "", "a world that's an allowed link")
            check(walked(other, rest), "[{universe}{sep}.{sep}other->{universe}{sep}.]", "a world that's a link to its own folder")
            let dangling = "{universe}{sep}dangling"
            make_link("{universe}{sep}nowhere", dangling)!
            check(walked(dangling, ""), "not found: {universe}{sep}nowhere", "a world that's a link to nothing")
        },
        err(_) => {
            // This system doesn't make links for this user.
            check(refusal(world, []), "Failed to validate '{world}'. Found forbidden symlinks: ", "the refusal of nothing")
        },
    }
    remove_dir_all(universe)!
    println("ok")
}
