/// Checks items saved and loaded, `world.item_entity`'s `saved` and `loaded` and
/// `world.entities`' `in_chunk` (CAL-148): an item's tag in the order vanilla's compound has it,
/// as vanilla saved one in the rig's `items` session, each value of the type vanilla saves; read
/// back as it was, and saved again the same; what Calcite doesn't run kept as it was loaded; a
/// motion past 10 dropped, an angle cut to a turn and a pitch to a right angle; an item with no
/// stack, or somewhere that isn't a number, not loaded; and a chunk's items in its sections' order,
/// with an entity Calcite keeps as it was read among them.
module test.entity_saving

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import server.log.{Entry}
import world.collision.{Aabb}
import world.entities.{Entities}
import world.item_entity.{ItemEntity}
import world.pos.{ChunkPos}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    let Tag.Compound(m) = t else panic("not a compound")
    return m.copy()
}

fn keys(t: Tag) -> String {
    var out = String()
    for (k, _) in compound(t) {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str(k)
    }
    return out
}

fn main() {
    let stone = snbt("\{id:\"minecraft:stone\",count:63\}")
    var e = ItemEntity.moving(5, 1103, 4.102014886508505, -60.0, 0.6758897867037035, stone.copy(), 0.0, -0.12, 0.0)
    e.body.on_ground = true
    e.age = 156
    e.thrower = some((-4964674128258451032, -8381834819709487033))
    let saved = e.saved()
    // The keys in the order vanilla's `CompoundTag`, a `HashMap`, has them, as it saved an item
    // like it.
    check(keys(saved) == "Motion Health Invulnerable fall_distance Air OnGround PortalCooldown Rotation Thrower Item Pos PickupDelay Fire id UUID Age", "the keys' order")
    let m = compound(saved)
    check(m["Health"] == Tag.Short(5i16) and m["Age"] == Tag.Short(156i16) and m["PickupDelay"] == Tag.Short(0i16), "health, age and pickup delay, shorts")
    check(m["Air"] == Tag.Short(300i16) and m["Fire"] == Tag.Short(0i16) and m["OnGround"] == Tag.Byte(1i8) and m["Invulnerable"] == Tag.Byte(0i8) and m["PortalCooldown"] == Tag.Int(0), "Entity's own")
    check(m["Thrower"] == Tag.IntArray([-1155928273, 798308776, -1951547997, -315148217]), "the thrower, four ints")
    check(m["id"] == Tag.Str(String("minecraft:item")) and m["Item"] == stone, "its type and stack")
    let Tag.List(pos) = m["Pos"] else panic("no place")
    check(pos.len() == 3 and pos[0] == Tag.Double(4.102014886508505), "its place, doubles")
    let Tag.List(angles) = m["Rotation"] else panic("no angles")
    check(angles.len() == 2 and angles[0] == Tag.Float(e.body.y_rot), "its angles, floats")

    // Read back, it's as it was, and saves the same.
    var lines = List<Entry>()
    let back = ItemEntity.loaded(9, 7, m, some(m["Item"].copy()), mut lines) else panic("not loaded")
    check(lines.is_empty(), "nothing logged")
    check(back.body.id == 9 and back.body.uuid == e.body.uuid and back.thrower == e.thrower and back.target == none, "its ID and UUIDs")
    check(back.body.x == e.body.x and back.body.y == e.body.y and back.body.z == e.body.z and back.body.vy == -0.12 and back.body.y_rot == e.body.y_rot, "its place, motion and angle")
    check(back.body.on_ground and back.age == 156 and back.health == 5 and back.body.needs_sync, "its ground, age, health, and syncing")
    check(back.saved().to_snbt() == saved.to_snbt(), "saved again the same")

    // What Calcite doesn't run is kept as it was loaded, where vanilla saves it.
    var odd = m.copy()
    odd.insert(String("CustomName"), Tag.Str(String("Rock")))
    odd.insert(String("Silent"), Tag.Byte(1i8))
    odd.insert(String("Glowing"), Tag.Byte(0i8))
    odd.insert(String("Tags"), Tag.List([Tag.Str(String("kept"))]))
    odd.insert(String("Fire"), Tag.Short(12i16))
    odd.insert(String("PortalCooldown"), Tag.Int(3))
    odd.insert(String("NoGravity"), Tag.Byte(1i8))
    odd.insert(String("Owner"), Tag.IntArray([1, 2, 3, 4]))
    let kept = ItemEntity.loaded(10, 7, odd, some(m["Item"].copy()), mut lines) else panic("the odd one not loaded")
    let again = compound(kept.saved())
    check(again["CustomName"] == Tag.Str(String("Rock")) and again["Silent"] == Tag.Byte(1i8) and not again.contains("Glowing"), "its name and silence kept, its glow not saved as it's off")
    check(again["Tags"] == Tag.List([Tag.Str(String("kept"))]) and again["Fire"] == Tag.Short(12i16) and again["PortalCooldown"] == Tag.Int(3), "its tags, fire and portal cooldown")
    check(again["NoGravity"] == Tag.Byte(1i8) and kept.body.no_gravity and kept.target == some((4294967298, 12884901892)), "no gravity and its owner")

    // A motion past 10 is none on that axis; an angle's cut to a turn, a pitch to a right angle.
    var wild = m.copy()
    wild.insert(String("Motion"), Tag.List([Tag.Double(11.0), Tag.Double(-0.5), Tag.Double(-10.5)]))
    wild.insert(String("Rotation"), Tag.List([Tag.Float(450.0f32), Tag.Float(-120.0f32)]))
    let calm = ItemEntity.loaded(11, 7, wild, some(m["Item"].copy()), mut lines) else panic("the wild one not loaded")
    check(calm.body.vx == 0.0 and calm.body.vy == -0.5 and calm.body.vz == 0.0, "the motion past 10")
    check(calm.body.y_rot == 90.0f32 and calm.body.x_rot == -90.0f32, "the angles")

    // None of a stack isn't loaded, nor is an item somewhere that isn't a number.
    var bare = m.copy()
    _ = bare.remove("Item")
    check(ItemEntity.loaded(12, 7, bare, none, mut lines) == none and lines.is_empty(), "no stack")
    var nowhere = m.copy()
    let zero = 0.0
    nowhere.insert(String("Pos"), Tag.List([Tag.Double(zero / zero), Tag.Double(0.0), Tag.Double(0.0)]))
    check(ItemEntity.loaded(13, 7, nowhere, some(m["Item"].copy()), mut lines) == none and lines.len() == 1, "nowhere")

    // A chunk's items in its sections' order, by `SectionPos.asLong`: up from 0, then the
    // sections below 0; and each section's in the order they came into it.
    var es = Entities.new()
    es.add(ItemEntity.new(1, 1, 1.5, 70.0, 1.5, stone.copy()))
    es.add(ItemEntity.new(2, 2, 2.5, -20.0, 2.5, stone.copy()))
    es.add(ItemEntity.new(3, 3, 3.5, 5.0, 3.5, stone.copy()))
    es.add(ItemEntity.new(4, 4, 4.5, 71.0, 4.5, stone.copy()))
    es.add(ItemEntity.new(5, 5, 20.5, 70.0, 4.5, stone.copy()))
    let ids = es.in_chunk(ChunkPos { x: 0, z: 0 })
    check(ids.len() == 4 and ids[0] == 3 and ids[1] == 1 and ids[2] == 4 and ids[3] == 2, "the sections' order")
    check(es.chunks().len() == 2, "two chunks")
    // An entity Calcite keeps as it was read has a place among them, last in its section, which
    // nothing finds.
    es.place_kept(-1, 1.0, 72.0, 1.0)
    let with = es.in_chunk(ChunkPos { x: 0, z: 0 })
    check(with.len() == 5 and with[2] == 4 and with[3] == -1 and with[4] == 2, "a kept one in its section")
    let near = es.find(Aabb { min_x: 0.0, min_y: 60.0, min_z: 0.0, max_x: 5.0, max_y: 80.0, max_z: 5.0 }, -2)
    check(near.len() == 2 and near[0] == 1 and near[1] == 4, "the kept one isn't found")
    es.remove_kept(-1)
    check(es.in_chunk(ChunkPos { x: 0, z: 0 }).len() == 4, "let go of")
    println("saving: an item's tag as vanilla's, read back and saved again the same")
    println("ok")
}
