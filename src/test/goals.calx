/// Tests of `world.goals` and the goals mobs run (CAL-158): the selector's holds, a goal of a
/// greater priority number kept out by a stopped goal's hold till the next cleanup, as vanilla's
/// is; the line of sight through air, a slab's top and stone, and from inside stone; the nearest
/// player in sight, not a spectator, one behind stone or one crouching past 0.8 of the range; one
/// in what hides them from a mob's type, `MOB_VISIBILITY`, seen only as far as it leaves them
/// visible, crouching or not, and by other types as far as ever; then a cow on grass looking at a
/// player 4 blocks off and strolling, a sheep eating its grass block to dirt with its wool back,
/// and a horse standing for 20 ticks. And a cow hurt by a player (D416): knocked back, shrugging
/// off what's no worse, panicking, and dying. And a zombie (CAL-159): a player it sees its target,
/// gone for and attacked in reach 20 ticks apart, its arms up; one in creative never its target;
/// and one who hurt it its target unseen. And a skeleton's weapon goal taken out, its hold let go,
/// and a skeleton with a bow drawing on a player and shooting them 60 ticks apart, at full power,
/// its melee goal back once its bow's gone. And a spider: no target in the light; in the dark, a
/// player 3 blocks off its target, leapt at and attacked; and one who hurt it, walled in, climbed
/// to over the wall. And a creeper: a player 8 blocks off its target, gone for and swelled at once
/// within 3 blocks, its fuse run out in 30 ticks and its explosion said missing, with no attack
/// dealt. And an enderman: a player looking away or wearing a carved pumpkin never its target; one
/// staring at its eyes 8 blocks off taken up, creepy, its attacking speed on, its anger at them
/// kept, frozen while they stare; and stared at within 4 blocks, it teleports away. And a witch: a
/// player 6 blocks off its target, thrown at 60 ticks apart, a potion of poison said missing; hurt,
/// it drinks healing, slowed as it drinks, its potion's effects said missing; and magic hurts it
/// 15% as much. And a slime: with no one about, hopping a way of its own; a player 4 blocks off its
/// target, hopped toward; and one 6 blocks up never its target. And an enderman with mob griefing
/// on in a pit of dirt: taking a block of its wall beside it, which the outlines let it reach, and
/// carrying one, staying and leaving it.
module test.goals

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry, Tag as RegistryTag}
import resources.identifier.{Identifier}
import world.attributes.{Wearing}
import world.body.{BodyFacts, EntitySound}
import world.chunk.{AIR_STATE, BlockStates}
import world.collision.{Aabb, CollisionBlocks}
import world.damage.{Damage, DamageTypes}
import world.entity_data.{Value}
import world.entity_facts.{path_block_tag_blocks, path_block_tag_names, path_fluid_tag_fluids, path_fluid_tag_names}
import world.experience_orb.{Follower, Mask}
import world.goals.{FLAG_LOOK, FLAG_MOVE, Goal, GoalSelector, Kin, Looker, Melee, Sensing, TEMPT_COW, TEMPT_PIG, Temptations, nearest_enemy, nearest_player, sees}
import world.inside.{Rain}
import world.living.{LivingFacts, Shown, Ward, after_absorb, Warding}
import world.loot.{LootParams}
import math.mth.{RAD_TO_DEG, table_atan2}
import world.mob.{COW, CREEPER, ENDERMAN, HORSE, INTERACT_PASS, INTERACT_SERVER, INTERACT_SUCCESS, Mob, MobLight, OWN, PIG, SHEEP, SKELETON, SLIME, SPIDER, WITCH, ZOMBIE}
import world.movement.{Mover, MovementStates}
import world.navigation.{NavLevel, SentBlock}
import world.paths.{PathTypeCache}
import world.variants.{MobFacts}
import worldgen.facts.{Facts}

fn check(cond: bool, what: str) {
    if not cond {
        panic(what)
    }
}

// The same, its message made from what's found.
fn ensure(cond: bool, what: own String) {
    if not cond {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The block facts, from the built-in block and fluid registries (4 and 2), with the tags paths
// read and `#entity_floatable`, as vanilla's data has them.
fn facts() -> Facts {
    var blocks = Registry.new(full("block"), false)
    for e in builtin_entries(4) {
        blocks.add(full(e), none)
    }
    let names = path_block_tag_names()
    let held = path_block_tag_blocks()
    for i in 0..names.len() {
        blocks.tags.push(RegistryTag { name: full(names[i].copy()), values: held[i].copy() })
    }
    var fluids = Registry.new(full("fluid"), false)
    for e in builtin_entries(2) {
        fluids.add(full(e), none)
    }
    let fluid_names = path_fluid_tag_names()
    let fluid_held = path_fluid_tag_fluids()
    for i in 0..fluid_names.len() {
        fluids.tags.push(RegistryTag { name: full(fluid_names[i].copy()), values: fluid_held[i].copy() })
    }
    fluids.tags.push(RegistryTag { name: full("entity_floatable"), values: [1, 2] })
    // The tags an enderman's teleports read (CAL-159), of the blocks the tests stand on: grass,
    // dirt and stone it may teleport onto, and bedrock it won't; and the grass and dirt it may
    // take, `enderman_holdable`.
    let entries = builtin_entries(4)
    var onto = List<i32>()
    var avoid = List<i32>()
    var holdable = List<i32>()
    for i in 0..entries.len() {
        let e = entries[i].copy()
        if e == "grass_block" or e == "dirt" or e == "stone" {
            onto.push(i32.wrap(i))
        } else if e == "bedrock" {
            avoid.push(i32.wrap(i))
        }
        if e == "grass_block" or e == "dirt" {
            holdable.push(i32.wrap(i))
        }
    }
    blocks_tags_pushed(mut blocks, onto, avoid)
    blocks.tags.push(RegistryTag { name: full("enderman_holdable"), values: holdable })
    return match Facts.new(blocks, fluids, BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn blocks_tags_pushed(blocks: mut Registry, onto: List<i32>, avoid: List<i32>) {
    blocks.tags.push(RegistryTag { name: full("entities_can_teleport_to"), values: onto.copy() })
    blocks.tags.push(RegistryTag { name: full("enderman_does_not_teleport_to"), values: avoid.copy() })
}

fn default_of(f: Facts, name: str) -> u32 {
    let b = f.block_named(String(name)) else panic("no block {name}")
    return f.default_state(b)
}

// `ground` below y 1 and air above, but for the blocks set, loaded from -64 to 64 across; lit
// fully, its game time `time`.
struct World {
    set: List<(i32, i32, i32, u32)>
    ground: u32
    time: i64 = 0
    // Whether it's dark everywhere, where it's light everywhere else.
    dark: bool = false
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -64 or x >= 64 or z < -64 or z >= 64 {
            return none
        }
        for (bx, by, bz, s) in self.set {
            if bx == x and by == y and bz == z {
                return some(s)
            }
        }
        return some(if y < 1 { self.ground } else { AIR_STATE })
    }
}

impl Rain for World {
    fn rains_on(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }
}

impl MobLight for World {
    fn magic_light(self, x: i32, y: i32, z: i32) -> f32 {
        _ = x + y + z
        return if self.dark { 0.0f32 } else { 1.0f32 }
    }

    fn monsters_burn(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return false
    }

    fn sees_sky(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return true
    }
}

impl Warding for World {
    fn protection(self, worn: List<Tag?>, params: LootParams) -> (f32, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (0.0f32, List<String>())
    }

    fn immune(self, worn: List<Tag?>, params: LootParams) -> (bool, List<String>) {
        _ = worn.len()
        _ = params.this_entity
        return (false, List<String>())
    }
}

impl NavLevel for World {
    fn level_time(self) -> i64 {
        return self.time
    }

    fn top_y(self) -> i32 {
        return 319
    }

    fn sent_first(self) -> u64 {
        return 0
    }

    fn sent_total(self) -> u64 {
        return 0
    }

    fn sent_at(self, i: u64) -> SentBlock {
        return SentBlock { x: i32.wrap(i), y: 0, z: 0, old: 0, now: 0 }
    }
}

// Nothing worn has components.
struct Items {}

impl Wearing for Items {
    fn worn_component(self, stack: Tag, name: String) -> Tag? {
        _ = stack
        _ = name
        return none
    }

    fn worn_types(self, set: Tag) -> List<i32> {
        _ = set
        return List<i32>()
    }

    fn worn_enchantments(self, stack: Tag) -> List<(i32, JavaHashMap<String, Tag>)> {
        _ = stack
        return List<(i32, JavaHashMap<String, Tag>)>()
    }
}

struct Setup {
    f: Facts
    m: MovementStates
    t: BodyFacts
    lf: LivingFacts
    kinds: List<String>
}

// A mob of the kind `species`, its type named `name`, standing at x, 1, z, seeded `seed`.
fn mob(s: Setup, species: i32, name: str, x: f64, z: f64, seed: i64) -> Mob {
    var kind: u32 = 0
    for i in 0..s.kinds.len() {
        if s.kinds[i] == String(name) {
            kind = u32.wrap(i)
        }
    }
    return Mob.made(s.lf, MobFacts.vanilla(4, [1], [2]), species, kind, 7, seed, x, 1.0, z)
}

// A player at x, 1, z, standing or crouching.
fn player(id: i32, x: f64, z: f64, crouching: bool, spectator: bool) -> Follower {
    return Follower { id: id, x: x, y: 1.0, z: z, eyes: 1.62f32, spectator: spectator, dead: false, discrete: crouching }
}

// Its tick in `w`, the game time going on, among `players`; what it showed then kept.
fn tick(s: Setup, a: mut Mob, w: mut World, cache: mut PathTypeCache, players: List<Follower>, shown: mut List<Shown>) {
    w.time += 1
    var sounds = List<EntitySound>()
    a.tick(s.lf, s.f, s.m, s.t, w, Items {}, mut cache, players, -64, false, mut sounds)
    for e in a.living.shown {
        shown.push(e.copy())
    }
    a.living.shown.clear()
    a.living.shown_after.clear()
}

// The selector's holds: B of priority 3 may take MOVE from A of 5, which stops it; C of 6 is kept
// out of LOOK by A's hold, though A's stopped, until the holds are cleaned up.
fn holds() {
    var g = GoalSelector.new()
    g.add(5, FLAG_MOVE | FLAG_LOOK, false, Goal.Float(0))
    g.add(3, FLAG_MOVE, false, Goal.Float(0))
    g.add(6, FLAG_LOOK, false, Goal.Float(0))
    check(g.replaceable(0) and g.replaceable(1) and g.replaceable(2), "goals held out with nothing held")
    g.set_running(0, true)
    g.lock(0, 0)
    g.lock(1, 0)
    check(g.replaceable(1) and not g.replaceable(2), "a goal's priority doesn't decide its hold")
    g.set_running(0, false)
    g.lock(0, 1)
    g.set_running(1, true)
    check(not g.replaceable(2), "a stopped goal's hold let go before the cleanup")
    g.unlock_stopped()
    check(g.replaceable(2) and g.holder(0) == 1 and g.holder(1) == -1, "the cleanup let go of the wrong holds")
    println("holds: a stopped goal's hold kept till the cleanup")
}

// The line of sight over stone from eyes 1.62 up: clear, over a bottom slab's top, through stone
// not, down through the slab not, and from inside stone not.
fn sight(s: Setup) {
    let stone = default_of(s.f, "minecraft:stone")
    let slab = default_of(s.f, "minecraft:stone_slab")
    let mover = Mover { y: 1.0, fall: 0.0 }
    let open = World { set: List<(i32, i32, i32, u32)>(), ground: stone }
    check(sees(s.m, s.f, open, mover, 0.5, 2.62, 0.5, 5.5, 2.62, 0.5), "no sight over open stone")
    let slabbed = World { set: [(3, 2, 0, slab)], ground: stone }
    check(sees(s.m, s.f, slabbed, mover, 0.5, 2.62, 0.5, 5.5, 2.62, 0.5), "no sight over a slab's top")
    check(not sees(s.m, s.f, slabbed, mover, 0.5, 2.62, 0.5, 5.5, 2.1, 0.5), "sight down through a slab")
    let walled = World { set: [(3, 2, 0, stone)], ground: stone }
    check(not sees(s.m, s.f, walled, mover, 0.5, 2.62, 0.5, 5.5, 2.62, 0.5), "sight through stone")
    check(not sees(s.m, s.f, open, mover, 0.5, 0.5, 0.5, 0.5, 2.62, 3.5), "sight from inside stone")
    check(not sees(s.m, s.f, open, mover, 0.5, 2.62, 0.5, 200.5, 2.62, 0.5), "sight past 128")
    println("sight: through air and over a slab, not through stone or from inside it")
}

// The nearest player in sight within 6: the one behind stone, the spectator and the one crouching
// past 0.8 of 6 passed over; the nearest of the rest.
fn nearest(s: Setup) {
    let stone = default_of(s.f, "minecraft:stone")
    let w = World { set: [(-3, 2, 0, stone)], ground: stone }
    let who = Looker { id: 7, x: 0.5, y: 1.0, z: 0.5, eye_y: 2.3, mover: Mover { y: 1.0, fall: 0.0 } }
    var sensing = Sensing()
    let players: List<Follower> = [player(1, -4.5, 0.5, false, false), player(2, 0.5, 2.5, false, true), player(3, 5.5, 0.5, true, false), player(4, 0.5, -4.5, false, false), player(5, 4.5, 0.5, false, false)]
    let found = nearest_player(s.m, s.f, w, mut sensing, who, players, 6.0, 2.3, true, 0u32)
    check(found == some(4) or found == some(5), "the nearest player is one that shouldn't be seen")
    check(found == some(5), "of two in sight, the nearer isn't the one found")
    check(sensing.known(1) == some(false) and sensing.known(4) == some(true) and sensing.known(2) == none, "sensing didn't keep what it saw")
    println("nearest: the nearest player in sight, {found}")
}

// Players in what hides them from mobs of the type 100 to half as far, `MOB_VISIBILITY` (CAL-159):
// one 20 blocks off seen by a mob of that type within 35 only within 17.5, so not, and by one of
// the type 101 it doesn't hide them from; one 15 off seen, but not crouching, within 14.
fn mob_visibility(s: Setup) {
    let w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:stone") }
    let hidden_from = Looker { id: 7, x: 0.5, y: 1.0, z: 0.5, eye_y: 2.74, mover: Mover { y: 1.0, fall: 0.0 }, kind: 100 }
    let other = Looker { id: 8, x: 0.5, y: 1.0, z: 0.5, eye_y: 2.74, mover: Mover { y: 1.0, fall: 0.0 }, kind: 101 }
    let mask = Mask { types: [99, 100], visibility: 0.5f32 }
    var far = enemy(1, 20.5, 0.5, false)
    far.masks = [mask.copy()]
    var sensing = Sensing()
    check(far.visibility(100) == 0.5 and far.visibility(101) == 1.0, "a mask's visibility isn't for its types alone")
    check(nearest_enemy(s.m, s.f, w, mut sensing, hidden_from, [far.copy()], 35.0) == none, "a masked player 20 off was seen within half of 35")
    var others = Sensing()
    check(nearest_enemy(s.m, s.f, w, mut others, other, [far.copy()], 35.0) == some(1), "a player masked from another type wasn't seen within 35")
    var near = enemy(2, 15.5, 0.5, false)
    near.masks = [mask]
    var seen = Sensing()
    check(nearest_enemy(s.m, s.f, w, mut seen, hidden_from, [near.copy()], 35.0) == some(2), "a masked player 15 off wasn't seen within 17.5")
    near.discrete = true
    var crouched = Sensing()
    check(near.visibility(100) == 0.8 * 0.5 and nearest_enemy(s.m, s.f, w, mut crouched, hidden_from, [near.copy()], 35.0) == none, "a masked player crouching 15 off was seen past 14")
    println("mob visibility: seen half as far by the types their mask names, crouching or not")
}

// A cow 4 blocks from a player on grass: within 400 ticks it's looked at the player, its head
// turned toward them, and strolled from where it was.
fn cow(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    var a = mob(s, COW, "cow", 0.5, 0.5, 155)
    let players: List<Follower> = [player(1, 4.5, 0.5, false, false)]
    var shown = List<Shown>()
    var looked = -1
    var strolled = -1
    for t in 0..400 {
        tick(s, mut a, mut w, mut cache, players, mut shown)
        // Facing east is a turn of 270 or -90.
        let head = a.living.y_head_rot
        if looked < 0 and ((head - 270.0f32).abs() < 20.0f32 or (head + 90.0f32).abs() < 20.0f32) and a.living.body.x_rot != 0.0f32 {
            looked = t
        }
        if strolled < 0 and a.navigating() {
            strolled = t
        }
    }
    let dx = a.living.body.x - 0.5
    let dz = a.living.body.z - 0.5
    println("cow: looked at tick {looked}, strolled at tick {strolled}, now {a.living.body.x}, {a.living.body.z}")
    check(looked >= 0, "a cow never looked at the player")
    check(strolled >= 0 and dx * dx + dz * dz > 1.0, "a cow never strolled")
}

// A sheep on grass, shorn: within 8000 ticks it eats, entity event 10, then the grass block below
// it turned to dirt 34 ticks on (its 20 goal ticks, every other tick, the first as it starts),
// and its wool's back.
fn sheep(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    var a = mob(s, SHEEP, "sheep", 0.5, 0.5, 156)
    a.living.data.set(OWN, Value.Byte(16))
    var shown = List<Shown>()
    var began = -1
    var grazed = -1
    var whole = true
    for t in 0..8000 {
        tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
        for e in shown {
            match e {
                Shown.Event(n) => {
                    if n == 10 and began < 0 {
                        began = t
                    }
                },
                Shown.Grazed(g) => {
                    if grazed < 0 {
                        grazed = t
                        whole = g.whole
                    }
                },
                _ => {},
            }
        }
        shown.clear()
        if grazed >= 0 {
            break
        }
    }
    println("sheep: began eating at tick {began}, grazed at tick {grazed}")
    check(began >= 0 and grazed - began == 34 and not whole, "a sheep didn't graze its grass block as it should")
    check(not a.sheared(), "a sheep's wool didn't come back as it ate")
}

// Vanilla's tempting items: wheat a cow's and a sheep's, a carrot a pig's, a carrot on a stick a
// pig's apart, nothing for nothing.
fn temptations() {
    let t = Temptations.vanilla()
    check(t.of(String("minecraft:wheat")) == 9u32, "wheat doesn't tempt cows and sheep alone")
    check(t.of(String("minecraft:carrot")) == TEMPT_PIG and t.of(String("minecraft:carrot_on_a_stick")) == 2u32, "a pig's carrots")
    check(t.of(String("minecraft:stone")) == 0u32 and t.of(String()) == 0u32, "stone or nothing tempts")
    println("temptations: vanilla's sets")
}

// A cow on grass 6 blocks from a player holding wheat: it's tempted, walks to within 2.5 of them
// and stops; once the wheat's gone it stops, and is calm for 50 tries, 100 ticks, though the wheat
// comes back at once.
fn tempt(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    var a = mob(s, COW, "cow", 0.5, 0.5, 158)
    var p = player(1, 6.5, 0.5, false, false)
    p.tempts = TEMPT_COW
    var shown = List<Shown>()
    var tempted = -1
    for t in 0..200 {
        let players: List<Follower> = [p.copy()]
        tick(s, mut a, mut w, mut cache, players, mut shown)
        if tempted < 0 and a.goals.running(3) {
            tempted = t
        }
    }
    let dx = a.living.body.x - 6.5
    let dz = a.living.body.z - 0.5
    let near = (dx * dx + dz * dz).sqrt()
    println("tempt: tempted at tick {tempted}, {near} from the player, head {a.living.y_head_rot}")
    check(tempted >= 0 and tempted < 4, "a cow wasn't tempted by wheat at once")
    check(near < 3.0 and near > 2.0, "a cow didn't stop within 2.5 of the player")
    check((a.living.y_head_rot > 260.0f32 and a.living.y_head_rot < 280.0f32) or (a.living.y_head_rot > -100.0f32 and a.living.y_head_rot < -80.0f32), "a cow didn't look at the player")
    p.tempts = 0u32
    var stopped = -1
    var again = -1
    for t in 0..300 {
        let players: List<Follower> = [p.copy()]
        tick(s, mut a, mut w, mut cache, players, mut shown)
        if stopped < 0 and not a.goals.running(3) {
            stopped = t
            p.tempts = TEMPT_COW
        }
        if stopped >= 0 and again < 0 and a.goals.running(3) {
            again = t
        }
    }
    println("tempt: stopped at tick {stopped}, again at tick {again}")
    check(stopped >= 0 and stopped < 3, "a cow stayed tempted with nothing held")
    check(again - stopped >= 100 and again - stopped <= 104, "a cow wasn't calm for 50 tries")
}

// A calf on grass 8 blocks from a grown cow: it follows it to within 3; a calf near only a grown
// pig doesn't follow.
fn follow(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    var a = mob(s, COW, "cow", 0.5, 0.5, 159)
    a.set_age(-24000)
    let parent = Kin { id: 9, species: COW, x: 8.5, y: 1.0, z: 0.5, eyes: 1.3f32, bounds: Aabb { min_x: 8.05, min_y: 1.0, min_z: 0.05, max_x: 8.95, max_y: 2.4, max_z: 0.95 }, age: 0, in_love: false, alive: true, variant: 0 }
    a.kin.push(parent)
    var shown = List<Shown>()
    var followed = -1
    var close = -1
    for t in 0..200 {
        tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
        if followed < 0 and a.goals.running(4) {
            followed = t
        }
        let dx = a.living.body.x - 8.5
        let dz = a.living.body.z - 0.5
        if close < 0 and dx * dx + dz * dz < 9.0 {
            close = t
        }
    }
    println("follow: following at tick {followed}, within 3 at tick {close}, now {a.living.body.x}, {a.living.body.z}")
    check(a.wants_kin() and followed >= 0 and followed < 4, "a calf didn't follow its parent at once")
    check(close >= 0 and not a.goals.running(4), "a calf didn't follow its parent to within 3")
    var b = mob(s, COW, "cow", 0.5, 0.5, 160)
    b.set_age(-24000)
    var pig = parent
    pig.species = PIG
    b.kin.push(pig)
    for _ in 0..40 {
        tick(s, mut b, mut w, mut cache, List<Follower>(), mut shown)
        check(not b.goals.running(4), "a calf followed a pig")
    }
}

// Feeding: wheat makes a grown cow fall in love for 600 ticks, event 18, the server swinging, and
// does nothing more while it's in love, nor does stone; a calf's made a tenth of its time older,
// 2400 ticks, its forced age with it, and shows a happy villager's particle each 4th of the next
// 40 ticks, 10, within its width of it and half a block to its height above it, then none (D415);
// a pig takes carrots, not wheat, and a horse nothing yet. Love counts down a tick a tick.
fn feed(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    var a = mob(s, COW, "cow", 0.5, 0.5, 161)
    let me = (5i64, 6i64)
    let wheat = String("minecraft:wheat")
    let first = a.interact(s.lf, wheat.copy(), me, 0, true)
    check(first.result == INTERACT_SERVER and first.used and a.in_love == 600, "wheat didn't make a cow fall in love")
    check(a.living.shown.len() == 1 and a.kept.contains("LoveCause"), "a cow in love wasn't shown or its cause kept")
    let again = a.interact(s.lf, wheat.copy(), me, 0, true)
    let stone = a.interact(s.lf, String("minecraft:stone"), me, 0, true)
    check(again.result == INTERACT_PASS and not again.used and stone.result == INTERACT_PASS, "a cow in love ate again, or ate stone")
    a.living.shown.clear()
    a.living.shown_after.clear()
    var shown = List<Shown>()
    tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
    check(a.in_love == 599, "a cow's love didn't count down")
    var calf = mob(s, COW, "cow", 0.5, 0.5, 162)
    calf.set_age(-24000)
    let fed = calf.interact(s.lf, wheat.copy(), me, 0, true)
    check(fed.result == INTERACT_SUCCESS and fed.used and calf.age == -21600 and calf.forced_age == 2400 and calf.in_love == 0, "a calf wasn't made a tenth older")
    calf.living.shown.clear()
    calf.living.shown_after.clear()
    var sparkles = 0
    for _ in 0..50 {
        shown.clear()
        tick(s, mut calf, mut w, mut cache, List<Follower>(), mut shown)
        for e in shown {
            match e {
                Shown.Particle(p) => {
                    let (bx, by, bz) = (calf.living.body.x, calf.living.body.y, calf.living.body.z)
                    let width = f64(calf.living.body.width) + 0.5
                    let height = f64(calf.living.body.height)
                    check(p.particle == "happy_villager" and (p.x - bx).abs() <= width and (p.z - bz).abs() <= width, "a calf's particle or where")
                    check(p.y >= by + 0.5 - 0.1 and p.y <= by + 0.5 + height + 0.1, "a calf's particle's height")
                    sparkles += 1
                },
                _ => {},
            }
        }
    }
    check(sparkles == 10 and calf.forced_age_timer == 0, "a calf fed older didn't show 10 particles")
    var pig = mob(s, PIG, "pig", 0.5, 0.5, 163)
    let pig_wheat = pig.interact(s.lf, wheat.copy(), me, 0, true)
    let pig_carrot = pig.interact(s.lf, String("minecraft:carrot"), me, 0, true)
    check(pig_wheat.result == INTERACT_PASS and pig_carrot.result == INTERACT_SERVER, "a pig's food")
    var foal = mob(s, HORSE, "horse", 0.5, 0.5, 164)
    check(foal.interact(s.lf, wheat.copy(), me, 0, true).result == INTERACT_PASS, "a horse ate wheat")
    println("feed: in love for {a.in_love} more ticks, a calf {calf.age} from grown, {sparkles} particles")
}

// Two cows in love 2 apart: one breeds on its 30th goal tick, entity event 18 then its breeding,
// partner 9, an orb of 1 to 7, and is 6000 from breeding again, less that tick's ageing, out of
// love; without mob drops no orb; a cow in love beside only a pig in love doesn't breed.
fn breed(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    let partner = Kin { id: 9, species: COW, x: 2.5, y: 1.0, z: 0.5, eyes: 1.3f32, bounds: Aabb { min_x: 2.05, min_y: 1.0, min_z: 0.05, max_x: 2.95, max_y: 2.4, max_z: 0.95 }, age: 0, in_love: true, alive: true, variant: 1 }
    for drops in [true, false] {
        var a = mob(s, COW, "cow", 0.5, 0.5, 165)
        a.in_love = 600
        a.mob_drops = drops
        a.kin.push(partner)
        var shown = List<Shown>()
        var bred = -1
        var orb = -1
        var evented = false
        var age_then = 0
        var love_then = -1
        for t in 0..100 {
            tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
            for e in shown {
                match e {
                    Shown.Event(n) => {
                        if n == 18 and bred < 0 {
                            evented = true
                        }
                    },
                    Shown.Bred(b) => {
                        if bred < 0 {
                            bred = t
                            orb = b.orb
                            age_then = a.age
                            love_then = a.in_love
                            check(b.partner == 9 and b.species == COW and (b.variant == 1 or b.variant == a.breed_variant()), "a calf's partner, kind or variant")
                        }
                    },
                    _ => {},
                }
            }
            shown.clear()
        }
        println("breed: bred at tick {bred}, an orb of {orb}, mob drops {drops}")
        check(bred >= 56 and bred <= 62 and evented, "a cow didn't breed on its 30th goal tick, after its event")
        check(age_then == 5999 and love_then == 0, "a cow that bred isn't 6000 from breeding again, less the tick's ageing")
        check((drops and orb >= 1 and orb <= 7) or (not drops and orb == 0), "a cow's orb")
    }
    var lone = mob(s, COW, "cow", 0.5, 0.5, 166)
    lone.in_love = 600
    var pig = partner
    pig.species = PIG
    lone.kin.push(pig)
    var shown = List<Shown>()
    for _ in 0..40 {
        tick(s, mut lone, mut w, mut cache, List<Follower>(), mut shown)
        check(not lone.goals.running(2), "a cow went to breed with a pig")
    }
}

// A horse on grass: within 8000 ticks it stands, for 19 ticks seen after them, its counter of 20
// set in its AI step and counted down after it that tick.
fn horse(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    var a = mob(s, HORSE, "horse", 0.5, 0.5, 157)
    var shown = List<Shown>()
    var stood = -1
    var sat = -1
    for t in 0..8000 {
        tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
        shown.clear()
        if stood < 0 and a.horse_flag(32) {
            stood = t
        }
        if stood >= 0 and sat < 0 and not a.horse_flag(32) {
            sat = t
            break
        }
    }
    println("horse: stood at tick {stood}, down at tick {sat}")
    check(stood >= 0 and sat - stood == 19, "a horse didn't stand for 19 ticks")
}

// A cow on grass, standing still, hit by a player a block east of it for 1, `player_attack`
// (D416): 9 health left, hurt for 10 ticks and shrugging off for 20, knocked `0.4F` west and 0.4
// up, its motion to be sent, the player kept for 100 ticks, its hurt sound played; hit again for
// 1, nothing; for 3, only the 2 more, with no sound; panicking on its next full tick, running once
// it's down; then, its cooldown done, hit for 20, dying whole with its death sound, gone 20 ticks
// on with entity event 60. A zombie's armor of 2 takes 6 in 100 of a hurt of 1.
fn hurt(s: Setup) {
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: default_of(s.f, "minecraft:grass_block") }
    var cache = PathTypeCache()
    var a = mob(s, COW, "cow", 0.5, 0.5, 158)
    var shown = List<Shown>()
    tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
    a.living.body.vx = 0.0
    a.living.body.vy = 0.0
    a.living.body.vz = 0.0
    a.living.body.on_ground = true
    a.living.body.needs_sync = false
    let types = DamageTypes.vanilla()
    let hit = Damage.player_attack(types, 1, 1.5, 1.0, 0.5, (1i64, 2i64), false)
    var sounds = List<EntitySound>()
    var missing = List<String>()
    let first = a.hurt(s.lf, types, hit, 1.0f32, 0, Ward(), mut sounds, mut missing)
    check(first.hurt and first.full and not first.dies, "a cow wasn't hurt whole")
    ensure(a.living.health() == 9.0f32 and a.living.hurt_time == 10 and a.living.damage_cooldown == 20, "a cow's health {a.living.health()}, hurt time {a.living.hurt_time}, cooldown {a.living.damage_cooldown}")
    ensure(a.living.body.vx == -f64(0.4f32) and a.living.body.vy == 0.4 and a.living.body.vz == 0.0, "a cow knocked {a.living.body.vx}, {a.living.body.vy}, {a.living.body.vz}")
    check(a.living.body.sync_velocity and a.living.body.needs_sync, "a cow's knockback not to be sent")
    check(a.living.hurt_by_player == some((1i64, 2i64)) and a.living.hurt_by_player_memory == 100, "a cow didn't keep the player")
    ensure(sounds.len() == 1 and sounds[0].sound == "entity.cow.hurt", "a cow's hurt sounds {sounds.len()}")
    sounds.clear()
    let again = a.hurt(s.lf, types, hit, 1.0f32, 0, Ward(), mut sounds, mut missing)
    check(not again.hurt and a.living.health() == 9.0f32, "a cow hurt again for no more")
    let more = a.hurt(s.lf, types, hit, 3.0f32, 0, Ward(), mut sounds, mut missing)
    ensure(more.hurt and not more.full and a.living.health() == 7.0f32 and sounds.is_empty(), "a cow hurt for 3 in its cooldown: health {a.living.health()}")
    // Its goals are looked at in full on its odd ticks, as its ID is 7; knocked up, it can't
    // find a path till it's down, `canUpdatePath`, nor always a place to run to, stable within 4
    // up or down, `DefaultRandomPos`.
    var ran = -1
    for t in 0..20 {
        tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
        if t == 1 {
            check(a.goals.panicking(), "a hurt cow didn't panic")
        }
        if ran < 0 and a.goals.panicking() and a.navigating() {
            ran = t
        }
    }
    ensure(ran > 0, "a panicking cow never ran: {ran}")
    let dying = a.hurt(s.lf, types, hit, 20.0f32, 1, Ward(), mut sounds, mut missing)
    check(dying.hurt and dying.dies and dying.full and sounds.len() == 1 and sounds[0].sound == "entity.cow.death", "a cow hit for 20 didn't die as it should")
    a.living.killed()
    shown.clear()
    var gone = -1
    for t in 0..30 {
        tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
        if a.living.body.removed {
            gone = t
            break
        }
    }
    var events = List<i8>()
    for e in shown {
        if let Shown.Event(n) = e {
            events.push(n)
        }
    }
    ensure(gone == 19 and events.contains(60i8), "a dead cow gone at tick {gone}, events {events.len()}")
    ensure(missing.is_empty(), "missing: {missing.len()}")
    let absorbed = after_absorb(1.0f32, 2.0f32, 0.0f32)
    ensure(absorbed == 0.94f32, "armor 2 left {absorbed} of 1")
    println("hurt: knocked back, shrugged off, panicked and ran at tick {ran}, died and gone at tick {gone}")
}

// A player at x, 1, z whom mobs may see as an enemy, of UUID 1, 2, with their box, in creative
// or not (CAL-159).
fn enemy(id: i32, x: f64, z: f64, creative: bool) -> Follower {
    var p = player(id, x, z, false, false)
    p.enemy = not creative
    p.creative = creative
    p.uuid = some((1i64, 2i64))
    p.bounds = some(Aabb { min_x: x - 0.3, min_y: 1.0, min_z: z - 0.3, max_x: x + 0.3, max_y: 2.8, max_z: z + 0.3 })
    return p
}

// A zombie's ticks among `players`, the game time going on as its level would say, what it showed
// kept; the ticks it attacked and how many times it swung, whether its arms were up, and the
// tick its target was first the player 1 (CAL-159).
fn hunt(s: Setup, a: mut Mob, w: mut World, cache: mut PathTypeCache, players: List<Follower>, n: i32) -> (List<i32>, i32, bool, i32) {
    var attacks = List<i32>()
    var swings = 0
    var arms = false
    var targeted = -1
    for t in 0..n {
        a.game_time = w.time + 1
        var shown = List<Shown>()
        tick(s, mut a, mut w, mut cache, players, mut shown)
        if targeted < 0 and a.target == some(1) {
            targeted = t
        }
        for e in shown {
            match e {
                Shown.Attack((id, _, _, _)) => {
                    check(id == 1, "a zombie attacked another")
                    attacks.push(t)
                },
                Shown.Swung((hand, kind, ticks)) => {
                    ensure(hand == 0 and kind == 1 and ticks == 6, "a zombie swung {hand}, {kind}, {ticks}")
                    swings += 1
                },
                Shown.Missing(what) => ensure(false, "a zombie missed {what}"),
                _ => {},
            }
        }
        if a.flags() & 4 != 0 {
            arms = true
        }
    }
    return (attacks, swings, arms, targeted)
}

fn zombie(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    var cache = PathTypeCache()
    var a = mob(s, ZOMBIE, "zombie", 0.5, 0.5, 159)
    let (attacks, swings, arms, targeted) = hunt(s, mut a, mut w, mut cache, [enemy(1, 6.5, 0.5, false)], 200)
    ensure(targeted >= 0 and targeted < 40, "a zombie took up the player at tick {targeted}")
    ensure(attacks.len() >= 3 and usize.wrap(swings) == attacks.len(), "a zombie attacked {attacks.len()} times, swung {swings}")
    // No more than one in 20 ticks while its attack goal runs; the player here has no box to stop
    // it, so it walks into their block, its path done, and its goal stops, then starts again once
    // 20 ticks of game time are by, its cooldown reset, as vanilla's does, `MeleeAttackGoal`.
    for i in 1..attacks.len() {
        ensure(attacks[i] - attacks[i - 1] > 0 and attacks[i] - attacks[i - 1] <= 20, "a zombie's attacks {attacks[i - 1]} and {attacks[i]}")
    }
    check(arms, "a zombie's arms never went up")
    let x = a.living.body.x
    ensure(x > 5.0 and x < 7.0, "a zombie went for the player to {x}")

    var b = mob(s, ZOMBIE, "zombie", 0.5, 0.5, 159)
    let (none_made, _, _, never) = hunt(s, mut b, mut w, mut cache, [enemy(1, 6.5, 0.5, true)], 100)
    ensure(never < 0 and none_made.is_empty(), "a zombie took up a creative player at tick {never}")

    // Behind a wall of stone three high, the player's out of its sight; once they've hurt it,
    // it takes them up anyway, `HurtByTargetGoal`.
    var wall = List<(i32, i32, i32, u32)>()
    let stone = default_of(s.f, "minecraft:stone")
    for z in -4..5 {
        for y in 1..4 {
            wall.push((3, y, z, stone))
        }
    }
    var walled = World { set: wall, ground: grass }
    var c = mob(s, ZOMBIE, "zombie", 0.5, 0.5, 159)
    var behind = List<Follower>()
    behind.push(enemy(1, 6.5, 0.5, false))
    let (_, _, _, unseen) = hunt(s, mut c, mut walled, mut cache, behind, 40)
    ensure(unseen < 0, "a zombie took up a player behind stone at tick {unseen}")
    c.living.hurt_by_mob = some((1i64, 2i64))
    c.living.hurt_by_mob_stamp = c.living.body.tick_count
    let (_, _, _, hurt_by) = hunt(s, mut c, mut walled, mut cache, behind, 4)
    ensure(hurt_by >= 0, "a zombie hurt by a player behind stone didn't take them up")
    println("zombie: took up the player at tick {targeted}, attacked from tick {attacks[0]}, not a creative one, and one behind stone who hurt it at tick {hurt_by}")
}

// A skeleton's weapon goal taken out (CAL-159): the first bow or melee goal, with whether it ran,
// its hold let go and the holds of the goals after it a place down; then none left to take.
fn weapons() {
    var g = GoalSelector.new()
    g.add(2, FLAG_MOVE, false, Goal.Float(0))
    g.add(4, FLAG_MOVE | FLAG_LOOK, true, Goal.Melee(Melee { speed: 1.2, follow_unseen: false, zombie: false }))
    g.add(6, FLAG_LOOK, false, Goal.Float(0))
    g.set_running(1, true)
    g.lock(0, 1)
    g.set_running(2, true)
    g.lock(1, 2)
    let (taken, ran) = g.take_weapon_goal() ?? panic("no weapon goal taken")
    check(ran and g.len() == 2, "the melee goal not taken out")
    check(g.holder(0) == -1 and g.holder(1) == 1, "its hold kept, or the look goal's not a place down")
    let Goal.Melee(ml) = taken else panic("not the melee goal")
    check(ml.speed == 1.2 and not ml.zombie, "the melee goal's state")
    check(g.take_weapon_goal() == none, "a second weapon goal")
    println("weapons: the melee goal taken out, its hold let go")
}

// A skeleton with a bow in its main hand (CAL-159): its weapon goal its bow goal once it's
// reassessed; a player 10 blocks off its target, its bow drawn from its main hand, `Shown.Worn`,
// and the player shot at full power 60 ticks apart, drawn for 20 and 40 more on normal; and with
// its bow gone and reassessed, its melee goal back.
fn skeleton(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    var cache = PathTypeCache()
    var a = mob(s, SKELETON, "skeleton", 0.5, 0.5, 159)
    var bow = JavaHashMap<String, Tag>()
    bow.insert(String("id"), Tag.Str(String("minecraft:bow")))
    bow.insert(String("count"), Tag.Int(1))
    a.living.equipment[0] = some(Tag.Compound(bow))
    a.reassess_weapon(false)
    var players = List<Follower>()
    players.push(enemy(1, 10.5, 0.5, false))
    var shots = List<i32>()
    var drawn = 0
    var targeted = -1
    for t in 0..200 {
        a.game_time = w.time + 1
        var shown = List<Shown>()
        tick(s, mut a, mut w, mut cache, players, mut shown)
        if targeted < 0 and a.target == some(1) {
            targeted = t
        }
        for e in shown {
            match e {
                Shown.Fired(shot) => {
                    ensure(shot.target == 1 and shot.power == 1.0f32, "a skeleton shot {shot.target} at {shot.power}")
                    shots.push(t)
                },
                Shown.Worn(_) => {
                    drawn += 1
                },
                Shown.Missing(what) => ensure(false, "a skeleton missed {what}"),
                _ => {},
            }
        }
    }
    ensure(targeted >= 0 and targeted < 40, "a skeleton took up the player at tick {targeted}")
    ensure(shots.len() >= 2 and usize.wrap(drawn) >= shots.len(), "a skeleton shot {shots.len()} times, drew {drawn}")
    for i in 1..shots.len() {
        ensure(shots[i] - shots[i - 1] == 60, "a skeleton's shots at {shots[i - 1]} and {shots[i]}")
    }
    a.living.equipment[0] = none
    a.reassess_weapon(false)
    var melee = false
    for i in 0..a.goals.len() {
        if let Goal.Melee(_) = a.goals.take(i) {
            melee = true
        }
    }
    check(melee, "no melee goal once the bow's gone")
    println("skeleton: took up the player at tick {targeted}, shot at {shots[0]}, {shots.len()} shots 60 ticks apart")
}

// A spider (CAL-159): in the light, never a target; in the dark, a player 3 blocks off its target
// within 40 ticks, leapt at, off the ground with them too near to path to, and attacked; then,
// one who hurt it in a ring of stone 3 high, gone for along its path to the ring and on toward
// their block once that's done, climbing the stone, `onClimbable` by its flags, to over its top.
fn spider(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var cache = PathTypeCache()
    var lit = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    var players = List<Follower>()
    players.push(enemy(1, 3.5, 0.5, false))
    var a = mob(s, SPIDER, "spider", 0.5, 0.5, 159)
    for _ in 0..40 {
        a.game_time = lit.time + 1
        var shown = List<Shown>()
        tick(s, mut a, mut lit, mut cache, players, mut shown)
    }
    check(a.target == none, "a spider took up a player in the light")
    var dark = World { set: List<(i32, i32, i32, u32)>(), ground: grass, dark: true }
    var b = mob(s, SPIDER, "spider", 0.5, 0.5, 159)
    var targeted = -1
    var leapt = -1
    var attacked = -1
    for t in 0..200 {
        b.game_time = dark.time + 1
        var shown = List<Shown>()
        tick(s, mut b, mut dark, mut cache, players, mut shown)
        if targeted < 0 and b.target == some(1) {
            targeted = t
        }
        if leapt < 0 and b.living.body.y > 1.1 {
            leapt = t
        }
        for e in shown {
            match e {
                Shown.Attack(_) => {
                    if attacked < 0 {
                        attacked = t
                    }
                },
                Shown.Missing(what) => ensure(false, "a spider missed {what}"),
                _ => {},
            }
        }
    }
    ensure(targeted >= 0 and targeted < 40, "a spider took up the player at tick {targeted}")
    ensure(leapt > targeted and attacked >= 0, "a spider leapt at tick {leapt}, attacked at tick {attacked}")

    var ring = List<(i32, i32, i32, u32)>()
    let stone = default_of(s.f, "minecraft:stone")
    for i in -2..3 {
        for y in 1..4 {
            ring.push((i, y, -2, stone))
            ring.push((i, y, 2, stone))
            if i > -2 and i < 2 {
                ring.push((-2, y, i, stone))
                ring.push((2, y, i, stone))
            }
        }
    }
    var walled = World { set: ring, ground: grass, dark: true }
    var c = mob(s, SPIDER, "spider", 8.5, 0.5, 159)
    var inside = List<Follower>()
    inside.push(enemy(1, 0.5, 0.5, false))
    // A tick first, as a hurt at its first tick's stamp, 0, is one its `HurtByTargetGoal` has seen.
    var before = List<Shown>()
    tick(s, mut c, mut walled, mut cache, List<Follower>(), mut before)
    c.living.hurt_by_mob = some((1i64, 2i64))
    c.living.hurt_by_mob_stamp = c.living.body.tick_count
    var top = 0.0
    var climbed = -1
    for t in 0..300 {
        c.game_time = walled.time + 1
        var shown = List<Shown>()
        tick(s, mut c, mut walled, mut cache, inside, mut shown)
        if c.living.body.y > top {
            top = c.living.body.y
        }
        if climbed < 0 and c.living.body.y > 4.0 {
            climbed = t
        }
    }
    ensure(climbed >= 0, "a spider walled out climbed only to {top}")
    println("spider: none in the light; took up the player at tick {targeted}, leapt at {leapt}, attacked at {attacked}; over the wall at {climbed}")
}

// A creeper (CAL-159): a player 8 blocks off taken up within 40 ticks and gone for; within 3
// blocks, its swell goal stops its path and it swells, `setSwellDir(1)`, its primed sound as it
// starts, and 30 ticks on its fuse is out, its explosion said missing; its melee goal never deals
// an attack, as a creeper's `doHurtTarget` doesn't.
fn creeper(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var cache = PathTypeCache()
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    var players = List<Follower>()
    players.push(enemy(1, 8.5, 0.5, false))
    var a = mob(s, CREEPER, "creeper", 0.5, 0.5, 159)
    var targeted = -1
    var swelled = -1
    var missing = -1
    var primed = 0
    var attacks = 0
    for t in 0..200 {
        a.game_time = w.time + 1
        w.time += 1
        var shown = List<Shown>()
        var sounds = List<EntitySound>()
        a.tick(s.lf, s.f, s.m, s.t, w, Items {}, mut cache, players, -64, false, mut sounds)
        for e in a.living.shown {
            shown.push(e.copy())
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        for heard in sounds {
            if heard.sound == "entity.creeper.primed" {
                primed += 1
            }
        }
        if targeted < 0 and a.target == some(1) {
            targeted = t
        }
        if swelled < 0 and a.living.data.number(16) > 0 {
            swelled = t
        }
        for e in shown {
            match e {
                Shown.Attack(_) => {
                    attacks += 1
                },
                Shown.Missing(what) => {
                    ensure(what == "A creeper's explosion, explodeCreeper", "a creeper missed {what}")
                    if missing < 0 {
                        missing = t
                    }
                },
                _ => {},
            }
        }
    }
    ensure(targeted >= 0 and targeted < 40, "a creeper took up the player at tick {targeted}")
    ensure(swelled > targeted and missing == swelled + 30 and primed == 1, "a creeper swelled at tick {swelled}, its fuse out at {missing}, primed {primed} times")
    ensure(attacks == 0, "a creeper dealt {attacks} attacks")
    println("creeper: took up the player at tick {targeted}, swelled at {swelled}, its fuse out at {missing}")
}

// The player `p` turned to look at the eyes of `a`, as `Mob.lookAt` would turn them.
fn aim(p: mut Follower, a: Mob) {
    let xd = a.living.body.x - p.x
    let zd = a.living.body.z - p.z
    let yd = (a.living.body.y + f64(a.living.body.eyes)) - (p.y + f64(p.eyes))
    let sd = (xd * xd + zd * zd).sqrt()
    p.y_rot = f32.nearest((table_atan2(zd, xd) ?? 0.0) * RAD_TO_DEG) - 90.0f32
    p.x_rot = f32.nearest(-((table_atan2(yd, sd) ?? 0.0) * RAD_TO_DEG))
}

// An enderman's ticks among the one player `p`, turned to its eyes each tick where `staring`; the
// tick its target was first the player 1, how many times it teleported, and what it missed.
fn ender_ticks(s: Setup, a: mut Mob, w: mut World, cache: mut PathTypeCache, p: mut Follower, staring: bool, n: i32) -> (i32, i32, i32) {
    var targeted = -1
    var teleports = 0
    var missed = 0
    for t in 0..n {
        if staring {
            aim(mut p, a)
        }
        var players = List<Follower>()
        players.push(p.copy())
        a.game_time = w.time + 1
        var shown = List<Shown>()
        var sounds = List<EntitySound>()
        w.time += 1
        a.tick(s.lf, s.f, s.m, s.t, w, Items {}, mut cache, players, -64, false, mut sounds)
        for e in a.living.shown {
            shown.push(e.copy())
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        if targeted < 0 and a.target == some(1) {
            targeted = t
        }
        var heard = 0
        for e in sounds {
            if e.sound == "entity.enderman.teleport" {
                heard += 1
            }
        }
        for e in shown {
            match e {
                Shown.Level((kind, _, _, _, _)) => {
                    ensure(kind == 2018 and heard == 2, "an enderman's level event {kind}, {heard} teleport sounds")
                    teleports += 1
                },
                Shown.Missing(what) => {
                    println("an enderman missed {what}")
                    missed += 1
                },
                _ => {},
            }
        }
    }
    return (targeted, teleports, missed)
}

// An enderman (CAL-159): a player 8 blocks off looking away, then wearing a carved pumpkin, never
// its target; staring at its eyes, taken up 3 of its target goals' ticks after it's stared at,
// `aggroTime`, it creepy and stared at, its attacking speed on and its anger at them kept by UUID
// for 20 to 39 seconds; frozen while they stare, not moving; then stared at by them from 3 blocks
// off, it teleports away, its level event 2018 and two teleport sounds.
fn enderman(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var cache = PathTypeCache()
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    var a = mob(s, ENDERMAN, "enderman", 0.5, 0.5, 162)
    a.mob_griefing = false
    var away = enemy(1, 8.5, 0.5, false)
    away.y_rot = -90.0f32
    let (looked, _, missed_away) = ender_ticks(s, mut a, mut w, mut cache, mut away, false, 40)
    ensure(looked < 0 and a.target == none and not a.living.data.flag(18) and missed_away == 0, "an enderman took up a player looking away at tick {looked}")
    var masked = enemy(1, 8.5, 0.5, false)
    masked.disguised = true
    let (hidden, _, missed_masked) = ender_ticks(s, mut a, mut w, mut cache, mut masked, true, 40)
    ensure(hidden < 0 and a.target == none and missed_masked == 0, "an enderman took up a disguised player at tick {hidden}")
    var p = enemy(1, a.living.body.x + 8.0, a.living.body.z, false)
    let base = a.living.attributes.value(s.lf.movement_speed)
    let (targeted, early, missed) = ender_ticks(s, mut a, mut w, mut cache, mut p, true, 12)
    ensure(targeted >= 4 and targeted <= 8 and early == 0 and missed == 0, "an enderman took up a staring player at tick {targeted}, teleported {early} times")
    let sped = a.living.attributes.value(s.lf.movement_speed)
    ensure(a.living.data.flag(17) and a.living.data.flag(18) and (sped - base - 0.15).abs() < 1.0e-6, "an enderman stared at: creepy {a.living.data.flag(17)}, speed {base} to {sped}")
    let left = a.anger_end_time - a.game_time
    ensure(a.anger_target == some((1i64, 2i64)) and left >= 399 and left <= 780, "an enderman's anger at {a.anger_target}, {left} ticks left")
    let (fx, fz) = (a.living.body.x, a.living.body.z)
    let (_, still, missed_still) = ender_ticks(s, mut a, mut w, mut cache, mut p, true, 20)
    ensure(a.living.body.x == fx and a.living.body.z == fz and still == 0 and missed_still == 0 and a.target == some(1), "an enderman stared at moved from {fx}, {fz} to {a.living.body.x}, {a.living.body.z}")
    var near = enemy(1, a.living.body.x + 3.0, a.living.body.z, false)
    let (_, teleports, missed_near) = ender_ticks(s, mut a, mut w, mut cache, mut near, true, 20)
    let gone = (a.living.body.x - fx) * (a.living.body.x - fx) + (a.living.body.z - fz) * (a.living.body.z - fz)
    ensure(teleports >= 1 and gone > 16.0 and missed_near == 0, "an enderman stared at from 3 blocks teleported {teleports} times, {gone} away")
    println("enderman: took up the staring player at tick {targeted}, teleported {teleports} times stared at close")
}

// An enderman hurt by a player 8 blocks off looking away (CAL-159): without `universal_anger`,
// taking them up at once, `HurtByTargetGoal`, its anger at them by UUID; with it, not, but angry
// at all players, `ResetUniversalAngerTargetGoal`, so its look for players takes them up a few
// ticks after, its anger then at them by UUID; and told they died, `playerDied`, forgiving them,
// angry at no one, without a target. Neither teleports or misses anything.
fn ender_anger(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var cache = PathTypeCache()
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    for universal in [false, true] {
        var a = mob(s, ENDERMAN, "enderman", 0.5, 0.5, 165)
        a.mob_griefing = false
        a.universal_anger = universal
        var p = enemy(1, 8.5, 0.5, false)
        p.y_rot = -90.0f32
        let (_, _, missed_calm) = ender_ticks(s, mut a, mut w, mut cache, mut p, false, 10)
        ensure(a.target == none and a.anger_target == none and missed_calm == 0, "an enderman took up a player looking away before they hurt it")
        a.living.hurt_by_mob = some((1i64, 2i64))
        a.living.hurt_by_mob_stamp = a.living.body.tick_count
        let (targeted, teleports, missed) = ender_ticks(s, mut a, mut w, mut cache, mut p, false, 20)
        ensure(teleports == 0 and missed == 0, "an enderman hurt by a player teleported {teleports} times, missed {missed}")
        if universal {
            ensure(targeted >= 2 and targeted <= 12, "an enderman angry at all players took up the one who hurt it at tick {targeted}")
        } else {
            ensure(targeted >= 0 and targeted <= 1, "an enderman hurt by a player took them up at tick {targeted}")
        }
        let left = a.anger_end_time - a.game_time
        ensure(a.target == some(1) and a.anger_target == some((1i64, 2i64)) and left >= 380 and left <= 780, "an enderman hurt by a player, universal anger {universal}: target {a.target}, angry at {a.anger_target}, {left} ticks left")
        a.player_died((5i64, 6i64))
        ensure(a.anger_target == some((1i64, 2i64)) and a.target == some(1), "an enderman forgave another player's death")
        a.player_died((1i64, 2i64))
        ensure(a.anger_target == none and a.target == none and a.anger_end_time == -1 and a.living.hurt_by_mob == none, "an enderman didn't forgive the player who died")
        ensure(not a.living.data.flag(17), "an enderman that forgave a player stayed creepy")
        println("ender_anger: universal anger {universal}: took up the player who hurt it at tick {targeted}, forgave their death")
    }
}

// An enderman shot by an arrow (CAL-159): not hurt, its health and idle time as they were, nothing
// heard or missed, but left to dodge, `repeatedlyTryToTeleport`, which teleports it within 32
// across, its level event 2018 and two teleport sounds; shot again inside a world border 4 across,
// it teleports within it, a hair inside its east and south edges, `clampVec3ToBound`.
fn ender_dodge(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    let w = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    var a = mob(s, ENDERMAN, "enderman", 0.5, 0.5, 166)
    let types = DamageTypes.vanilla()
    var shot = Damage.of(types, "arrow")
    shot.cause = 7
    shot.direct = 7
    let health = a.living.health()
    a.no_action_time = 40
    var sounds = List<EntitySound>()
    var missing = List<String>()
    let h = a.hurt(s.lf, types, shot, 6.0f32, 0, Ward(), mut sounds, mut missing)
    ensure(not h.hurt and a.living.health() == health and a.no_action_time == 40 and a.dodge_due, "an enderman shot: hurt {h.hurt}, health {a.living.health()}, idle {a.no_action_time}, to dodge {a.dodge_due}")
    ensure(sounds.is_empty() and missing.is_empty(), "an enderman shot heard {sounds.len()} sounds, missed {missing}")
    let (x, z) = (a.living.body.x, a.living.body.z)
    let dodged = a.dodge(s.lf, s.f, s.m, w, -64, mut sounds)
    let (dx, dz) = (a.living.body.x - x, a.living.body.z - z)
    var events = 0
    for e in a.living.shown {
        if let Shown.Level((kind, _, _, _, _)) = e {
            ensure(kind == 2018, "an enderman's dodge showed level event {kind}")
            events += 1
        }
    }
    a.living.shown.clear()
    a.living.shown_after.clear()
    ensure(dodged and not a.dodge_due and (dx != 0.0 or dz != 0.0) and dx.abs() <= 32.0 and dz.abs() <= 32.0, "an enderman's dodge went {dx}, {dz}")
    ensure(events == 1 and sounds.len() == 2 and sounds[0].sound == "entity.enderman.teleport", "an enderman's dodge showed {events} level events and played {sounds.len()} sounds")
    a.border = some((-2.0, -2.0, 2.0, 2.0))
    _ = a.hurt(s.lf, types, shot, 6.0f32, 0, Ward(), mut sounds, mut missing)
    ensure(a.dodge(s.lf, s.f, s.m, w, -64, mut sounds), "an enderman shot inside a border didn't dodge")
    let (bx, bz) = (a.living.body.x, a.living.body.z)
    ensure(bx >= -2.0 and bx < 2.0 and bz >= -2.0 and bz < 2.0, "an enderman dodged to {bx}, {bz}, outside a border 4 across")
    println("ender_dodge: dodged an arrow {dx}, {dz} away, then to {bx}, {bz} inside a border")
}

// An enderman's tick with no one about (CAL-159): where it took a block where `take`, else where
// it left the one it carries, if it did; it misses nothing.
fn ender_block_tick(s: Setup, a: mut Mob, w: mut World, cache: mut PathTypeCache, take: bool) -> (i32, i32, i32)? {
    a.game_time = w.time + 1
    var shown = List<Shown>()
    tick(s, mut a, mut w, mut cache, List<Follower>(), mut shown)
    var at: (i32, i32, i32)? = none
    for e in shown {
        match e {
            Shown.Took(p) => {
                if take {
                    at = some(p)
                }
            },
            Shown.Left(p) => {
                if not take {
                    at = some(p)
                }
            },
            Shown.Missing(what) => {
                ensure(false, "an enderman missed {what}")
            },
            _ => {},
        }
    }
    return at
}

// An enderman with mob griefing on, in the dark, in a pit of dirt 3 blocks deep and 7 across
// (CAL-159): taking a block of its wall within 400 ticks, `EndermanTakeBlockGoal`, one beside it,
// as the outlines from the middle of its own block reach none behind another; then carrying one,
// staying, `requiresCustomPersistence`, and leaving it within 8000 ticks,
// `EndermanLeaveBlockGoal`, within a block across and 2 up of where it is.
fn ender_blocks(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    let dirt = default_of(s.f, "minecraft:dirt")
    var cache = PathTypeCache()
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass, dark: true }
    for x in -3..4 {
        for z in -3..4 {
            for y in 1..4 {
                if x != 0 or z != 0 {
                    w.set.push((x, y, z, dirt))
                }
            }
        }
    }
    var a = mob(s, ENDERMAN, "enderman", 0.5, 0.5, 164)
    a.mob_griefing = true
    var took: (i32, i32, i32)? = none
    var t = 0
    while took == none and t < 400 {
        took = ender_block_tick(s, mut a, mut w, mut cache, true)
        t += 1
    }
    let (x, y, z) = took else panic("an enderman in a pit of dirt took nothing in {t} ticks")
    ensure(x >= -1 and x <= 1 and z >= -1 and z <= 1 and y >= 1 and y <= 3, "an enderman took the block at {x}, {y}, {z}, behind the wall beside it")
    ensure(a.carried() == none and not a.custom_persistence(), "an enderman carried a block its level hadn't given it")
    a.set_carried(some(dirt), none)
    ensure(a.carried() == some(dirt) and a.custom_persistence(), "an enderman carrying a block may go")
    var left: (i32, i32, i32)? = none
    var u = 0
    while left == none and u < 8000 {
        left = ender_block_tick(s, mut a, mut w, mut cache, false)
        u += 1
    }
    let (lx, ly, lz) = left else panic("an enderman carrying a block left nothing in {u} ticks")
    let (bx, by, bz) = (i32.saturate(a.living.body.x.floor()), i32.saturate(a.living.body.y.floor()), i32.saturate(a.living.body.z.floor()))
    ensure((lx - bx).abs() <= 1 and (lz - bz).abs() <= 1 and ly >= by and ly <= by + 2, "an enderman at {bx}, {by}, {bz} left its block at {lx}, {ly}, {lz}")
    println("enderman blocks: took the block at {x}, {y}, {z} at tick {t}, left its own at {lx}, {ly}, {lz} at tick {u}")
}

// A witch's ticks among `players` (CAL-159): the ticks it threw at the player 1, how many times it
// drank, the tick it first stopped drinking, and its least speed.
fn witch_ticks(s: Setup, a: mut Mob, w: mut World, cache: mut PathTypeCache, players: List<Follower>, n: i32) -> (List<i32>, i32, i32, f64) {
    var throws = List<i32>()
    var drinks = 0
    var drunk = -1
    var slowest = 1.0
    for t in 0..n {
        a.game_time = w.time + 1
        w.time += 1
        var sounds = List<EntitySound>()
        a.tick(s.lf, s.f, s.m, s.t, w, Items {}, mut cache, players, -64, false, mut sounds)
        var shown = List<Shown>()
        for e in a.living.shown {
            shown.push(e.copy())
        }
        a.living.shown.clear()
        a.living.shown_after.clear()
        var thrown = false
        for e in sounds {
            if e.sound == "entity.witch.throw" {
                thrown = true
            } else if e.sound == "entity.witch.drink" {
                drinks += 1
            }
        }
        for e in shown {
            match e {
                Shown.Hurled(h) => {
                    ensure(h.potion == "minecraft:poison", "a witch threw {h.potion} at tick {t}")
                    ensure(thrown, "a witch threw at tick {t} without its sound")
                    throws.push(t)
                },
                Shown.Missing(what) => {
                    ensure(false, "a witch missed {what}")
                },
                _ => {},
            }
        }
        // Its potion of healing drunk, its instant health on it till its next tick (CAL-163).
        if drunk < 0 and a.living.has_effect(5) {
            drunk = t
        }
        let speed = a.living.attributes.value(s.lf.movement_speed)
        if speed < slowest {
            slowest = speed
        }
    }
    return (throws, drinks, drunk, slowest)
}

// A witch (CAL-159): a player 6 blocks off taken up and thrown at once it's seen them, at once its
// first 60 ticks are out and then every 60, of poison as they've 20 health and are within 8
// blocks, a potion for its level to make (D528); then a witch at half health with no one about,
// which drinks healing within 200 ticks, slowed by a quarter as it drinks, and stops 33 ticks on,
// healed 4 by its instant health the tick after (CAL-163).
fn witch(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var cache = PathTypeCache()
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass, dark: true }
    var players = List<Follower>()
    players.push(enemy(1, 6.5, 0.5, false))
    var a = mob(s, WITCH, "witch", 0.5, 0.5, 163)
    let (throws, _, _, _) = witch_ticks(s, mut a, mut w, mut cache, players, 200)
    ensure(throws.len() >= 2 and a.target == some(1), "a witch threw {throws.len()} times, its target {a.target}")
    for i in 1..throws.len() {
        ensure(throws[i] - throws[i - 1] == 60, "a witch threw at ticks {throws[i - 1]} and {throws[i]}")
    }
    var b = mob(s, WITCH, "witch", 0.5, 0.5, 164)
    b.living.data.set(9, Value.Float(13.0f32))
    let base = b.living.attributes.value(s.lf.movement_speed)
    let (none_thrown, drinks, drunk, slowest) = witch_ticks(s, mut b, mut w, mut cache, List<Follower>(), 240)
    ensure(none_thrown.is_empty() and drinks >= 1 and drunk >= 33, "a hurt witch drank {drinks} times, done at tick {drunk}")
    ensure(b.living.health() >= 17.0f32 and not b.living.has_effect(5), "a witch's healing healed it to {b.living.health()}")
    ensure((base - slowest - 0.25).abs() < 1.0e-9 and (b.living.attributes.value(s.lf.movement_speed) == base or b.living.data.flag(17)), "a witch's speed {base}, {slowest} drinking")
    // Magic hurts a witch 15% as much, `witch_resistant_to`; a player's attack in full.
    var c = mob(s, WITCH, "witch", 0.5, 0.5, 165)
    let types = DamageTypes.vanilla()
    var sounds = List<EntitySound>()
    var missing = List<String>()
    _ = c.hurt(s.lf, types, Damage.of(types, "magic"), 10.0f32, 0, Ward(), mut sounds, mut missing)
    let after_magic = c.living.health()
    c.living.damage_cooldown = 0
    c.living.invulnerable_time = 0
    _ = c.hurt(s.lf, types, Damage.player_attack(types, 1, 1.5, 1.0, 0.5, (1i64, 2i64), false), 2.0f32, 0, Ward(), mut sounds, mut missing)
    ensure((after_magic - 24.5f32).abs() < 1.0e-5f32 and (c.living.health() - 22.5f32).abs() < 1.0e-5f32, "a witch hurt by magic to {after_magic}, then by a player to {c.living.health()}")
    println("witch: threw at ticks {throws}, drank {drinks} times, done drinking at tick {drunk}; magic took {26.0f32 - after_magic}")
}

// A slime's ticks among `players` (CAL-159): how many times it jumped off the ground, and the
// tick its target was first the player 1.
fn slime_ticks(s: Setup, a: mut Mob, w: mut World, cache: mut PathTypeCache, players: List<Follower>, n: i32) -> (i32, i32) {
    var jumps = 0
    var targeted = -1
    for t in 0..n {
        let was_on = a.living.body.on_ground
        a.game_time = w.time + 1
        var shown = List<Shown>()
        tick(s, mut a, mut w, mut cache, players, mut shown)
        for e in shown {
            if let Shown.Missing(what) = e {
                ensure(false, "a slime missed {what}")
            }
        }
        if was_on and a.living.body.vy > 0.0 {
            jumps += 1
        }
        if targeted < 0 and a.target == some(1) {
            targeted = t
        }
    }
    return (jumps, targeted)
}

// A slime of size 2 (CAL-159): with no one about, hopping a way of its own, `CubeMobKeepOnJumping`
// and `CubeMobRandomDirectionGoal`, a block or more from where it was; a player 4 blocks off taken
// up within 40 ticks and hopped toward, `CubeMobAttackGoal`, within 2 blocks; and a second slime
// with a player 6 blocks up, past its selector's 4, never taking them up.
fn slime(s: Setup) {
    let grass = default_of(s.f, "minecraft:grass_block")
    var cache = PathTypeCache()
    var w = World { set: List<(i32, i32, i32, u32)>(), ground: grass }
    var a = mob(s, SLIME, "slime", 0.5, 0.5, 166)
    a.set_slime_size(2, true)
    let (jumps, _) = slime_ticks(s, mut a, mut w, mut cache, List<Follower>(), 200)
    let moved = ((a.living.body.x - 0.5) * (a.living.body.x - 0.5) + (a.living.body.z - 0.5) * (a.living.body.z - 0.5)).sqrt()
    ensure(jumps >= 3 and moved >= 1.0, "a slime alone jumped {jumps} times, {moved} from where it was")
    var players = List<Follower>()
    players.push(enemy(1, a.living.body.x + 4.0, a.living.body.z, false))
    let (_, targeted) = slime_ticks(s, mut a, mut w, mut cache, players, 200)
    let near = ((a.living.body.x - players[0].x) * (a.living.body.x - players[0].x) + (a.living.body.z - players[0].z) * (a.living.body.z - players[0].z)).sqrt()
    ensure(targeted >= 0 and targeted < 40 and near < 2.0, "a slime took up the player at tick {targeted}, {near} from them")
    var b = mob(s, SLIME, "slime", 0.5, 0.5, 167)
    b.set_slime_size(2, true)
    var up = enemy(1, 3.5, 0.5, false)
    up.y = 7.0
    up.bounds = some(Aabb { min_x: 3.2, min_y: 7.0, min_z: 0.2, max_x: 3.8, max_y: 8.8, max_z: 0.8 })
    var high = List<Follower>()
    high.push(up)
    let (_, never) = slime_ticks(s, mut b, mut w, mut cache, high, 100)
    ensure(never < 0 and b.target == none, "a slime took up a player 6 blocks up at tick {never}")
    println("slime: jumped {jumps} times alone, {moved} away; took up the player at tick {targeted}, {near} from them")
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    let t = BodyFacts.new(f)
    let lf = LivingFacts.new(f)
    let kinds = builtin_entries(6)
    let s = Setup { f: f, m: m, t: t, lf: lf, kinds: kinds.copy() }
    holds()
    sight(s)
    nearest(s)
    mob_visibility(s)
    cow(s)
    sheep(s)
    horse(s)
    temptations()
    tempt(s)
    follow(s)
    feed(s)
    breed(s)
    hurt(s)
    zombie(s)
    weapons()
    skeleton(s)
    spider(s)
    creeper(s)
    enderman(s)
    witch(s)
    slime(s)
    ender_blocks(s)
    ender_anger(s)
    ender_dodge(s)
    println("ok")
}
