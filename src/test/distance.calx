/// Checks `world.distance`: a player joining loads the chunks in view four at a time, nearest
/// first, each waiting for the one before to tick its entities. Leaving drops them all, and
/// they unload. The rig's `distance` probe checks the manager against vanilla's own
/// `DistanceManager`.
module test.distance

import world.distance.{DistanceManager, Holder, Nearby, Ticking}
import world.pos.{ChunkPos}
import world.tickets.{TicketStorage, TicketType}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn packed(x: i32, z: i32) -> i64 {
    return ChunkPos { x: x, z: z }.pack()
}

// Runs the dispatcher's jobs and the main thread's tasks until neither has any, and how many ran.
fn drain(dm: mut DistanceManager) -> i32 {
    var ran = 0
    loop {
        var any = false
        while dm.run_dispatcher() {
            ran += 1
            any = true
        }
        while dm.run_main() {
            ran += 1
            any = true
        }
        if not any {
            return ran
        }
    }
}

// The chunks whose player loading tickets are in use.
fn player_tickets(dm: DistanceManager) -> i32 {
    var n = 0
    for chunk in dm.tickets.chunks() {
        for t in dm.tickets.tickets_at(chunk) {
            if t.kind == TicketType.PlayerLoading {
                n += 1
            }
        }
    }
    return n
}

// The holders waiting for their chunks to tick their entities.
fn waiting(dm: DistanceManager) -> List<i64> {
    var out = List<i64>()
    for chunk in dm.holder_chunks() {
        let h = dm.holder(chunk) else panic("a holder in use is missing")
        if h.ticking == Ticking.Waiting {
            out.push(chunk)
        }
    }
    return out
}

// Updates, drains and has every chunk waited for tick its entities, until nothing changes.
fn settle(dm: mut DistanceManager) -> i32 {
    var rounds = 0
    loop {
        rounds += 1
        var any = dm.run_all_updates()
        if drain(mut dm) > 0 {
            any = true
        }
        for chunk in waiting(dm) {
            if dm.entity_ticking_ready(chunk) {
                any = true
            }
        }
        if not any {
            return rounds
        }
    }
}

fn main() {
    var dm = DistanceManager.new(TicketStorage.new())
    dm.update_player_tickets(3)
    dm.add_player(packed(0, 0), 7)
    check("{dm.run_all_updates()} {dm.holder_chunks().len()}", "false 0", "a player's simulation ticket loads nothing")
    check("{dm.chunk_level(packed(0, 0), true)} {dm.chunk_level(packed(11, 0), true)} {dm.chunk_level(packed(12, 0), true)}", "21 32 33", "the simulation ticket, at 31 less 10")
    check("{dm.in_entity_ticking_range(packed(10, 10))} {dm.in_entity_ticking_range(packed(11, 0))} {dm.in_block_ticking_range(packed(11, 0))}", "true false true", "ticking ranges")
    check("{dm.natural_spawn_chunk_count()} {dm.players_nearby(packed(5, -5)) == Nearby.Yes} {dm.players_nearby(packed(6, 0)) == Nearby.Check} {dm.players_nearby(packed(9, 0)) == Nearby.No}", "289 true true true", "the natural spawn counter")

    // The dispatcher hands the nearest chunks over first, four of them, then sleeps while each
    // waits for its chunk to tick its entities.
    _ = drain(mut dm)
    check("{player_tickets(dm)} {dm.debug_status().ends_with("s=true")} {dm.tickets.tickets_at(packed(0, 0)).len()}", "4 true 2", "four chunks handed over, the player's own first")
    for chunk in dm.tickets.chunks() {
        let x = i32.wrap(chunk)
        let z = i32.wrap(chunk >> 32)
        if x < -1 or x > 1 or z < -1 or z > 1 {
            panic("a chunk {x}, {z} two away got a ticket before the nearer ones")
        }
    }
    check("{dm.run_all_updates()} {waiting(dm).len()} {holder_at(dm, 0, 0).ticket_level}", "true 4 31", "the holders are made, those with tickets waiting")
    check("{dm.run_all_updates()} {holder_at(dm, 0, 0).waiting}", "false 1", "the next update has the dispatcher wait for them")
    check("{dm.entity_ticking_ready(packed(0, 0))} {dm.entity_ticking_ready(packed(0, 0))} {drain(mut dm) > 0} {player_tickets(dm)}", "true false true 5", "one ready lets one more through")

    // Settled, each chunk in view has its ticket, and the holders reach 13 past them.
    _ = settle(mut dm)
    check("{player_tickets(dm)} {dm.holder_chunks().len()} {ready_count(dm)} {dm.chunk_level(packed(16, -16), false)} {dm.chunk_level(packed(17, 0), false)}", "49 1089 49 44 45", "a view distance of 3")
    let serial = holder_at(dm, 16, 0).serial

    // A smaller view distance lets the outer ring's tickets go, and their chunks drop.
    dm.update_player_tickets(2)
    _ = settle(mut dm)
    check("{player_tickets(dm)} {dm.holder_chunks().len()} {dm.dropping_chunks().len()} {dm.chunk_level(packed(16, 0), false)}", "25 1089 128 45", "a view distance of 2")
    check("{dm.drop_unloaded().len()} {dm.holder_chunks().len()} {dm.unloading_chunks().len()} {dm.unloads_queued()} {dm.promote()} {dm.promote()}", "128 961 128 128 true false", "the dropped holders wait to unload")

    // Back to 3, the holders waiting come back, and their old unloads find them gone.
    dm.update_player_tickets(3)
    _ = settle(mut dm)
    check("{player_tickets(dm)} {dm.holder_chunks().len()} {dm.unloading_chunks().len()} {holder_at(dm, 16, 0).serial == serial}", "49 1089 0 true", "the holders come back")
    var unloads = 0
    while dm.unload_next() {
        unloads += 1
    }
    check("{unloads} {dm.holder_chunks().len()}", "128 1089", "the old unloads unload nothing")

    // The player leaving lets every ticket go, and every chunk drops and unloads.
    dm.remove_player(packed(0, 0), 7)
    _ = settle(mut dm)
    check("{dm.has_tickets()} {dm.dropping_chunks().len()} {dm.drop_unloaded().len()}", "false 1089 1089", "the player leaves")
    while dm.unload_next() {}
    check("{dm.holder_chunks().len()} {dm.unloading_chunks().len()} {dm.natural_spawn_chunk_count()} {dm.entity_ticking_chunks().len()}", "0 0 0 0", "everything unloads")
    println("ok")
}

// The holder in use at `x`, `z`.
fn holder_at(dm: DistanceManager, x: i32, z: i32) -> Holder {
    let h = dm.holder(packed(x, z)) else panic("no holder at {x}, {z}")
    return h
}

// The holders whose chunks tick their entities.
fn ready_count(dm: DistanceManager) -> i32 {
    var n = 0
    for chunk in dm.holder_chunks() {
        let h = dm.holder(chunk) else panic("a holder in use is missing")
        if h.ticking == Ticking.Ready {
            n += 1
        }
    }
    return n
}
