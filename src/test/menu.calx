/// Checks `world.menu` against what vanilla's `InventoryMenu` does with each kind of click: a
/// stack picked up, half of one, put down, one of it put down, swapped and merged; a shift-click
/// between the hotbar and the rest, and onto the armor; a hotbar key's swap; armor that isn't
/// one refused; a double-click gathering a stack; a drag split evenly; the crafting grid telling
/// the menu; closing, which puts the cursor's and the grid's stacks back; and the remote slots,
/// what the client is sent and what it says it has, by hash. The items are read against the
/// vanilla data pack's registries, from the server jar, as the rig's adapter loads them.
module test.menu

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import rig.registries.{load_vanilla}
import world.inventory.{Inventory}
import world.menu.{Clicker, Effect, HashedStack, Menu, PICKUP, PICKUP_ALL, QUICK_CRAFT, QUICK_MOVE, SWAP}

fn check(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

fn stack(text: str) -> Tag? {
    return some(parse(String(text))!)
}

fn shown(t: Tag?) -> String {
    return match t {
        some(x) => x.to_snbt(),
        none => String("-"),
    }
}

fn effects(fx: List<Effect>) -> String {
    var out = String()
    for e in fx {
        let part = match e {
            Effect.Grid => String("grid"),
            Effect.Equip(worn, old, now) => "equip {worn} {shown(old)} {shown(now)}",
            Effect.Placed(slot, now) => "placed {slot} {shown(now)}",
            Effect.Dropped(t) => "dropped {t.to_snbt()}",
        }
        if not out.is_empty() {
            out.push_str("; ")
        }
        out.push_str(part)
    }
    return out
}

fn main() {
    let loaded = load_vanilla()!
    let items = loaded.items.value.copy()
    let who = Clicker { infinite: false, creative: false, selected: 0 }
    var inv = Inventory.empty()
    var menu = Menu()
    var fx = List<Effect>()
    inv.set_menu_slot(36, stack("\{id:\"minecraft:stone\",count:5\}"))

    // A left click picks the whole stack up; another puts it down.
    _ = menu.click(mut inv, items, who, 36, 0, PICKUP, mut fx)
    check(shown(menu.carried), "\{count:5,id:\"minecraft:stone\"\}", "picked up")
    check(shown(inv.menu_slot(36)), "-", "the slot picked from")
    _ = menu.click(mut inv, items, who, 37, 0, PICKUP, mut fx)
    check(shown(inv.menu_slot(37)), "\{count:5,id:\"minecraft:stone\"\}", "put down")
    check(shown(menu.carried), "-", "nothing carried")

    // A right click takes half, rounded up, and puts one down.
    _ = menu.click(mut inv, items, who, 37, 1, PICKUP, mut fx)
    check(shown(menu.carried), "\{count:3,id:\"minecraft:stone\"\}", "half picked up")
    check(shown(inv.menu_slot(37)), "\{count:2,id:\"minecraft:stone\"\}", "half left")
    _ = menu.click(mut inv, items, who, 38, 1, PICKUP, mut fx)
    check(shown(inv.menu_slot(38)), "\{count:1,id:\"minecraft:stone\"\}", "one put down")
    check(shown(menu.carried), "\{count:2,id:\"minecraft:stone\"\}", "the rest carried")

    // Onto the same, they merge, up to 64; onto another, they swap.
    menu.carried = stack("\{id:\"minecraft:stone\",count:63\}")
    _ = menu.click(mut inv, items, who, 37, 0, PICKUP, mut fx)
    check(shown(inv.menu_slot(37)), "\{count:64,id:\"minecraft:stone\"\}", "merged")
    check(shown(menu.carried), "\{count:1,id:\"minecraft:stone\"\}", "what didn't fit")
    menu.carried = stack("\{id:\"minecraft:dirt\",count:4\}")
    _ = menu.click(mut inv, items, who, 38, 0, PICKUP, mut fx)
    check(shown(inv.menu_slot(38)), "\{count:4,id:\"minecraft:dirt\"\}", "swapped in")
    check(shown(menu.carried), "\{count:1,id:\"minecraft:stone\"\}", "swapped out")
    menu.carried = none

    // A shift-click moves the hotbar to the rest, onto a stack of it first, and back.
    inv.set_menu_slot(20, stack("\{id:\"minecraft:dirt\",count:62\}"))
    _ = menu.click(mut inv, items, who, 38, 0, QUICK_MOVE, mut fx)
    check(shown(inv.menu_slot(20)), "\{count:64,id:\"minecraft:dirt\"\}", "onto a stack of it")
    check(shown(inv.menu_slot(9)), "\{count:2,id:\"minecraft:dirt\"\}", "the rest in the first empty slot")
    check(shown(inv.menu_slot(38)), "-", "moved out of the hotbar")
    _ = menu.click(mut inv, items, who, 9, 0, QUICK_MOVE, mut fx)
    check(shown(inv.menu_slot(36)), "\{count:2,id:\"minecraft:dirt\"\}", "into the hotbar")

    // A helmet shift-clicks onto the head, which tells the player; stone can't go there.
    inv.set_menu_slot(10, stack("\{id:\"minecraft:iron_helmet\",count:1\}"))
    fx = List<Effect>()
    _ = menu.click(mut inv, items, who, 10, 0, QUICK_MOVE, mut fx)
    check(shown(inv.menu_slot(5)), "\{count:1,id:\"minecraft:iron_helmet\"\}", "worn")
    check(effects(fx), "equip head - \{count:1,id:\"minecraft:iron_helmet\"\}", "the equip")
    menu.carried = stack("\{id:\"minecraft:stone\",count:1\}")
    _ = menu.click(mut inv, items, who, 6, 0, PICKUP, mut fx)
    check(shown(inv.menu_slot(6)), "-", "stone isn't a chestplate")
    menu.carried = none

    // A hotbar key swaps its slot with the one under the cursor.
    _ = menu.click(mut inv, items, who, 20, 0, SWAP, mut fx)
    check(shown(inv.menu_slot(36)), "\{count:64,id:\"minecraft:dirt\"\}", "into the hotbar")
    check(shown(inv.menu_slot(20)), "\{count:2,id:\"minecraft:dirt\"\}", "out of it")

    // A double click gathers the stacks of it, those that aren't full first.
    inv.set_menu_slot(30, stack("\{id:\"minecraft:stone\",count:10\}"))
    menu.carried = stack("\{id:\"minecraft:stone\",count:1\}")
    _ = menu.click(mut inv, items, who, 31, 0, PICKUP_ALL, mut fx)
    check(shown(menu.carried), "\{count:64,id:\"minecraft:stone\"\}", "gathered")
    check(shown(inv.menu_slot(30)), "-", "a stack that isn't full, taken first")
    check(shown(inv.menu_slot(37)), "\{count:11,id:\"minecraft:stone\"\}", "a full one, taken from in the second pass")

    // A left drag over three slots splits the stack evenly.
    menu.carried = stack("\{id:\"minecraft:stone\",count:10\}")
    _ = menu.click(mut inv, items, who, -999, 0, QUICK_CRAFT, mut fx)
    _ = menu.click(mut inv, items, who, 40, 1, QUICK_CRAFT, mut fx)
    _ = menu.click(mut inv, items, who, 41, 1, QUICK_CRAFT, mut fx)
    _ = menu.click(mut inv, items, who, 42, 1, QUICK_CRAFT, mut fx)
    _ = menu.click(mut inv, items, who, -999, 2, QUICK_CRAFT, mut fx)
    check("{shown(inv.menu_slot(40))} {shown(inv.menu_slot(42))}", "\{count:3,id:\"minecraft:stone\"\} \{count:3,id:\"minecraft:stone\"\}", "split")
    check(shown(menu.carried), "\{count:1,id:\"minecraft:stone\"\}", "the remainder")

    // The crafting grid tells the menu; closing puts the grid and the cursor back.
    fx = List<Effect>()
    _ = menu.click(mut inv, items, who, 1, 0, PICKUP, mut fx)
    check(effects(fx), "grid", "the grid changed")
    check(shown(inv.menu_slot(1)), "\{count:1,id:\"minecraft:stone\"\}", "in the grid")
    menu.carried = stack("\{id:\"minecraft:dirt\",count:1\}")
    fx = List<Effect>()
    menu.close(mut inv, items, who, mut fx)
    // The held slot's dirt is full, so the dirt goes onto the next with room; the stone onto the
    // hotbar's.
    check(effects(fx), "placed 20 \{count:3,id:\"minecraft:dirt\"\}; placed 1 \{count:12,id:\"minecraft:stone\"\}", "put back")
    check(shown(inv.menu_slot(1)), "-", "the grid emptied")
    check(shown(menu.carried), "-", "the cursor emptied")

    // What the client's sent, and what it says it has, by hash.
    var synced = Menu()
    check("{synced.changes(inv, items).len()}", "0", "nothing before the menu's sent")
    synced.sent_all(inv)
    check("{synced.changes(inv, items).len()}", "0", "nothing new")
    inv.set_menu_slot(44, stack("\{id:\"minecraft:diamond_sword\",count:1,components:\{\"minecraft:damage\":7\}\}"))
    let changed = synced.changes(inv, items)
    check("{changed.len()}", "1", "one slot changed")
    let sword = items.builtin_id("item", String("minecraft:diamond_sword")) ?? -1
    let damage = items.builtin_id("data_component_type", String("minecraft:damage")) ?? -1
    let right = HashedStack { item: some(sword), count: 1, types: [damage], hashes: [items.component_hash(String("minecraft:damage"), Tag.Int(7))] }
    let wrong = HashedStack { item: some(sword), count: 1, types: [damage], hashes: [items.component_hash(String("minecraft:damage"), Tag.Int(8))] }
    synced.receive(44, right)
    check("{synced.changes(inv, items).len()}", "0", "the client has it")
    synced.receive(44, wrong)
    check("{synced.changes(inv, items).len()}", "1", "the client has another")
    synced.receive(43, HashedStack())
    check("{synced.changes(inv, items).len()}", "0", "an empty slot the client has empty")
    println("ok")
}
