/// Checks `world.menu` against what vanilla's `InventoryMenu` does with each kind of click: a
/// stack picked up, half of one, put down, one of it put down, swapped and merged; a shift-click
/// between the hotbar and the rest, and onto the armor; a hotbar key's swap; armor that isn't
/// one refused; a double-click gathering a stack; a drag split evenly; the crafting grid telling
/// the menu; closing, which puts the cursor's and the grid's stacks back; and the remote slots,
/// what the client is sent and what it says it has, by hash. Then a container's menus
/// (CAL-144): a chest's shift-clicks, from it into the hotbar's last and back, its
/// `setChanged`, a shulker box's refusing a shulker box, a dispenser's shift-click, and what the
/// inventory menu takes of what the client was sent as a container's closes. Then crafting in
/// the inventory's grid (CAL-147): a result set as the grid changes, taken with a click, the grid
/// used up one of each, a mirrored shaped recipe, a shapeless one, a shift-click crafting as many
/// as there are, and a recipe's leftovers put back in the grid; and at a crafting table, its 3 by
/// 3 grid's recipes, a shift-click out of its result and into its grid, nothing put in its result,
/// and its grid put back as it closes. The items and recipes are read
/// against the vanilla data pack's registries, from the server jar, as the rig's adapter loads
/// them.
module test.menu

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import registry.streams.{Streams}
import rig.registries.{load_vanilla}
import server.log.{Entry}
import world.inventory.{Inventory}
import world.recipes.{Recipes}
import world.menu.{CHEST_MENU, CRAFTING_MENU, Clicker, DISPENSER_MENU, Effect, HashedStack, Menu, PICKUP, PICKUP_ALL, QUICK_CRAFT, QUICK_MOVE, SHULKER_MENU, SWAP, Slots}

fn check(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

fn stack(text: str) -> Tag? {
    return some(parse(String(text))!)
}

fn shown(t: Tag?) -> String {
    return match t {
        some(x) => x.to_snbt(),
        none => String("-"),
    }
}

fn effects(fx: List<Effect>) -> String {
    var out = String()
    for e in fx {
        let part = match e {
            Effect.Grid(_, made) => "grid {shown(made)}",
            Effect.Equip(worn, old, now) => "equip {worn} {shown(old)} {shown(now)}",
            Effect.Placed(slot, now) => "placed {slot} {shown(now)}",
            Effect.Dropped(t) => "dropped {t.to_snbt()}",
            Effect.Changed => String("changed"),
        }
        if not out.is_empty() {
            out.push_str("; ")
        }
        out.push_str(part)
    }
    return out
}

fn main() {
    let loaded = load_vanilla()!
    let items = loaded.items.value.copy()
    let who = Clicker { infinite: false, creative: false, selected: 0 }
    var s = Slots { inv: Inventory.empty() }
    var menu = Menu()
    var fx = List<Effect>()
    s.inv.set_menu_slot(36, stack("\{id:\"minecraft:stone\",count:5\}"))

    // A left click picks the whole stack up; another puts it down.
    _ = menu.click(mut s, items, who, 36, 0, PICKUP, mut fx)
    check(shown(menu.carried), "\{count:5,id:\"minecraft:stone\"\}", "picked up")
    check(shown(s.inv.menu_slot(36)), "-", "the slot picked from")
    _ = menu.click(mut s, items, who, 37, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(37)), "\{count:5,id:\"minecraft:stone\"\}", "put down")
    check(shown(menu.carried), "-", "nothing carried")

    // A right click takes half, rounded up, and puts one down.
    _ = menu.click(mut s, items, who, 37, 1, PICKUP, mut fx)
    check(shown(menu.carried), "\{count:3,id:\"minecraft:stone\"\}", "half picked up")
    check(shown(s.inv.menu_slot(37)), "\{count:2,id:\"minecraft:stone\"\}", "half left")
    _ = menu.click(mut s, items, who, 38, 1, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(38)), "\{count:1,id:\"minecraft:stone\"\}", "one put down")
    check(shown(menu.carried), "\{count:2,id:\"minecraft:stone\"\}", "the rest carried")

    // Onto the same, they merge, up to 64; onto another, they swap.
    menu.carried = stack("\{id:\"minecraft:stone\",count:63\}")
    _ = menu.click(mut s, items, who, 37, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(37)), "\{count:64,id:\"minecraft:stone\"\}", "merged")
    check(shown(menu.carried), "\{count:1,id:\"minecraft:stone\"\}", "what didn't fit")
    menu.carried = stack("\{id:\"minecraft:dirt\",count:4\}")
    _ = menu.click(mut s, items, who, 38, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(38)), "\{count:4,id:\"minecraft:dirt\"\}", "swapped in")
    check(shown(menu.carried), "\{count:1,id:\"minecraft:stone\"\}", "swapped out")
    menu.carried = none

    // A shift-click moves the hotbar to the rest, onto a stack of it first, and back.
    s.inv.set_menu_slot(20, stack("\{id:\"minecraft:dirt\",count:62\}"))
    _ = menu.click(mut s, items, who, 38, 0, QUICK_MOVE, mut fx)
    check(shown(s.inv.menu_slot(20)), "\{count:64,id:\"minecraft:dirt\"\}", "onto a stack of it")
    check(shown(s.inv.menu_slot(9)), "\{count:2,id:\"minecraft:dirt\"\}", "the rest in the first empty slot")
    check(shown(s.inv.menu_slot(38)), "-", "moved out of the hotbar")
    _ = menu.click(mut s, items, who, 9, 0, QUICK_MOVE, mut fx)
    check(shown(s.inv.menu_slot(36)), "\{count:2,id:\"minecraft:dirt\"\}", "into the hotbar")

    // A helmet shift-clicks onto the head, which tells the player; stone can't go there.
    s.inv.set_menu_slot(10, stack("\{id:\"minecraft:iron_helmet\",count:1\}"))
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 10, 0, QUICK_MOVE, mut fx)
    check(shown(s.inv.menu_slot(5)), "\{count:1,id:\"minecraft:iron_helmet\"\}", "worn")
    check(effects(fx), "equip head - \{count:1,id:\"minecraft:iron_helmet\"\}", "the equip")
    menu.carried = stack("\{id:\"minecraft:stone\",count:1\}")
    _ = menu.click(mut s, items, who, 6, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(6)), "-", "stone isn't a chestplate")
    menu.carried = none

    // A hotbar key swaps its slot with the one under the cursor.
    _ = menu.click(mut s, items, who, 20, 0, SWAP, mut fx)
    check(shown(s.inv.menu_slot(36)), "\{count:64,id:\"minecraft:dirt\"\}", "into the hotbar")
    check(shown(s.inv.menu_slot(20)), "\{count:2,id:\"minecraft:dirt\"\}", "out of it")

    // A double click gathers the stacks of it, those that aren't full first.
    s.inv.set_menu_slot(30, stack("\{id:\"minecraft:stone\",count:10\}"))
    menu.carried = stack("\{id:\"minecraft:stone\",count:1\}")
    _ = menu.click(mut s, items, who, 31, 0, PICKUP_ALL, mut fx)
    check(shown(menu.carried), "\{count:64,id:\"minecraft:stone\"\}", "gathered")
    check(shown(s.inv.menu_slot(30)), "-", "a stack that isn't full, taken first")
    check(shown(s.inv.menu_slot(37)), "\{count:11,id:\"minecraft:stone\"\}", "a full one, taken from in the second pass")

    // A left drag over three slots splits the stack evenly.
    menu.carried = stack("\{id:\"minecraft:stone\",count:10\}")
    _ = menu.click(mut s, items, who, -999, 0, QUICK_CRAFT, mut fx)
    _ = menu.click(mut s, items, who, 40, 1, QUICK_CRAFT, mut fx)
    _ = menu.click(mut s, items, who, 41, 1, QUICK_CRAFT, mut fx)
    _ = menu.click(mut s, items, who, 42, 1, QUICK_CRAFT, mut fx)
    _ = menu.click(mut s, items, who, -999, 2, QUICK_CRAFT, mut fx)
    check("{shown(s.inv.menu_slot(40))} {shown(s.inv.menu_slot(42))}", "\{count:3,id:\"minecraft:stone\"\} \{count:3,id:\"minecraft:stone\"\}", "split")
    check(shown(menu.carried), "\{count:1,id:\"minecraft:stone\"\}", "the remainder")

    // The crafting grid tells the menu; closing puts the grid and the cursor back.
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 1, 0, PICKUP, mut fx)
    check(effects(fx), "grid -", "the grid changed")
    check(shown(s.inv.menu_slot(1)), "\{count:1,id:\"minecraft:stone\"\}", "in the grid")
    menu.carried = stack("\{id:\"minecraft:dirt\",count:1\}")
    fx = List<Effect>()
    menu.close(mut s, items, who, mut fx)
    // The held slot's dirt is full, so the dirt goes onto the next with room; the stone onto the
    // hotbar's.
    check(effects(fx), "placed 20 \{count:3,id:\"minecraft:dirt\"\}; placed 1 \{count:12,id:\"minecraft:stone\"\}", "put back")
    check(shown(s.inv.menu_slot(1)), "-", "the grid emptied")
    check(shown(menu.carried), "-", "the cursor emptied")

    // What the client's sent, and what it says it has, by hash.
    var synced = Menu()
    check("{synced.changes(s, items).len()}", "0", "nothing before the menu's sent")
    synced.sent_all(s)
    check("{synced.changes(s, items).len()}", "0", "nothing new")
    s.inv.set_menu_slot(44, stack("\{id:\"minecraft:diamond_sword\",count:1,components:\{\"minecraft:damage\":7\}\}"))
    let changed = synced.changes(s, items)
    check("{changed.len()}", "1", "one slot changed")
    let sword = items.builtin_id("item", String("minecraft:diamond_sword")) ?? -1
    let damage = items.builtin_id("data_component_type", String("minecraft:damage")) ?? -1
    let right = HashedStack { item: some(sword), count: 1, types: [damage], hashes: [items.component_hash(String("minecraft:damage"), Tag.Int(7))] }
    let wrong = HashedStack { item: some(sword), count: 1, types: [damage], hashes: [items.component_hash(String("minecraft:damage"), Tag.Int(8))] }
    synced.receive(44, right)
    check("{synced.changes(s, items).len()}", "0", "the client has it")
    synced.receive(44, wrong)
    check("{synced.changes(s, items).len()}", "1", "the client has another")
    synced.receive(43, HashedStack())
    check("{synced.changes(s, items).len()}", "0", "an empty slot the client has empty")
    containers(items, who)
    var logs = List<Entry>()
    let recipes = Shared(Recipes.of(loaded.registries, Streams.new(), mut logs))
    crafting(items, who, recipes)
    table(items, who, recipes)
    println("ok")
}

// A crafting table's menu (CAL-147): its result, its 3 by 3 grid, then the player's 36.
fn table(items: ItemCodecs, who: Clicker, recipes: Shared<Recipes>) {
    var s = Slots { inv: Inventory.empty(), container: empty_slots(10), kind: CRAFTING_MENU, recipes: some(recipes.copy()) }
    var menu = Menu.of(s.count())
    check("{menu.slots()}", "46", "a crafting table's slots")
    var fx = List<Effect>()
    // Three iron ingots across the top and two sticks down the middle make a pickaxe; two
    // ingots alone, a pressure plate.
    menu.carried = stack("\{id:\"minecraft:iron_ingot\",count:3\}")
    _ = menu.click(mut s, items, who, 1, 1, PICKUP, mut fx)
    _ = menu.click(mut s, items, who, 2, 1, PICKUP, mut fx)
    check(shown(s.container[0]), "\{count:1,id:\"minecraft:heavy_weighted_pressure_plate\"\}", "a pressure plate")
    _ = menu.click(mut s, items, who, 3, 1, PICKUP, mut fx)
    menu.carried = stack("\{id:\"minecraft:stick\",count:2\}")
    _ = menu.click(mut s, items, who, 5, 1, PICKUP, mut fx)
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 8, 1, PICKUP, mut fx)
    check("{shown(s.container[0])} {effects(fx)}", "\{count:1,id:\"minecraft:iron_pickaxe\"\} grid \{count:1,id:\"minecraft:iron_pickaxe\"\}", "a pickaxe")
    // Shift-clicked into the hotbar's last, the grid used up.
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 0, 0, QUICK_MOVE, mut fx)
    check("{shown(s.inv.menu_slot(44))} {shown(s.container[1])} {shown(s.container[8])} {shown(s.container[0])}", "\{count:1,id:\"minecraft:iron_pickaxe\"\} - - -", "shifted out")
    check(effects(fx), "grid \{count:1,id:\"minecraft:iron_hoe\"\}; grid -; grid -; grid -; grid -", "each stack used up, a mirrored hoe on the way")
    // Nothing goes in the result.
    menu.carried = stack("\{id:\"minecraft:oak_planks\",count:4\}")
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 0, 0, PICKUP, mut fx)
    check("{shown(s.container[0])} {shown(menu.carried)} {effects(fx)}", "- \{count:4,id:\"minecraft:oak_planks\"\} ", "nothing put in the result")
    // Four planks in the grid's lower right make a crafting table.
    let corner: List<i32> = [5, 6, 8, 9]
    for n in corner {
        _ = menu.click(mut s, items, who, n, 1, PICKUP, mut fx)
    }
    check(shown(s.container[0]), "\{count:1,id:\"minecraft:crafting_table\"\}", "a 2 by 2 recipe in a corner")
    // A stack shift-clicked from the inventory goes into the grid's first empty slot.
    s.inv.set_menu_slot(9, stack("\{id:\"minecraft:oak_log\",count:2\}"))
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 10, 0, QUICK_MOVE, mut fx)
    check("{shown(s.container[1])} {shown(s.inv.menu_slot(9))} {shown(s.container[0])} {effects(fx)}", "\{count:2,id:\"minecraft:oak_log\"\} - - grid -", "shifted into the grid")
    // Closing puts the grid's stacks back in the inventory.
    fx = List<Effect>()
    menu.close(mut s, items, who, mut fx)
    check("{effects(fx)} {shown(s.container[1])} {shown(s.container[5])}", "placed 0 \{count:2,id:\"minecraft:oak_log\"\}; placed 1 \{count:1,id:\"minecraft:oak_planks\"\}; placed 1 \{count:2,id:\"minecraft:oak_planks\"\}; placed 1 \{count:3,id:\"minecraft:oak_planks\"\}; placed 1 \{count:4,id:\"minecraft:oak_planks\"\} - -", "the grid put back")
}

// The inventory's crafting grid, against the vanilla recipes (CAL-147).
fn crafting(items: ItemCodecs, who: Clicker, recipes: Shared<Recipes>) {
    var s = Slots { inv: Inventory.empty(), recipes: some(recipes.copy()) }
    var menu = Menu()
    var fx = List<Effect>()
    // A log anywhere in the grid makes 4 planks.
    menu.carried = stack("\{id:\"minecraft:oak_log\",count:1\}")
    _ = menu.click(mut s, items, who, 4, 0, PICKUP, mut fx)
    check(effects(fx), "grid \{count:4,id:\"minecraft:oak_planks\"\}", "planks")
    check(shown(s.inv.menu_slot(0)), "\{count:4,id:\"minecraft:oak_planks\"\}", "the result")
    // Taking them uses the log up, and the grid makes nothing.
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 0, 0, PICKUP, mut fx)
    check(shown(menu.carried), "\{count:4,id:\"minecraft:oak_planks\"\}", "taken")
    check(effects(fx), "grid -", "the log used up")
    check("{shown(s.inv.menu_slot(4))} {shown(s.inv.menu_slot(0))}", "- -", "the grid emptied")
    // Two planks one above the other make sticks; a right click puts one down at a time.
    _ = menu.click(mut s, items, who, 1, 1, PICKUP, mut fx)
    _ = menu.click(mut s, items, who, 3, 1, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(0)), "\{count:4,id:\"minecraft:stick\"\}", "sticks")
    // Onto what's carried, a result of another item can't be taken.
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 0, 0, PICKUP, mut fx)
    check("{shown(menu.carried)} {effects(fx)}", "\{count:2,id:\"minecraft:oak_planks\"\} ", "not taken")
    menu.carried = none
    s.inv.set_menu_slot(1, none)
    s.inv.set_menu_slot(3, none)
    // Shears, mirrored or not.
    fx = List<Effect>()
    menu.carried = stack("\{id:\"minecraft:iron_ingot\",count:2\}")
    _ = menu.click(mut s, items, who, 2, 1, PICKUP, mut fx)
    _ = menu.click(mut s, items, who, 3, 1, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(0)), "\{count:1,id:\"minecraft:shears\"\}", "shears")
    _ = menu.click(mut s, items, who, 2, 0, PICKUP, mut fx)
    _ = menu.click(mut s, items, who, 1, 0, PICKUP, mut fx)
    _ = menu.click(mut s, items, who, 3, 0, PICKUP, mut fx)
    _ = menu.click(mut s, items, who, 4, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(0)), "\{count:1,id:\"minecraft:shears\"\}", "mirrored shears")
    _ = menu.click(mut s, items, who, 1, 0, PICKUP, mut fx)
    _ = menu.click(mut s, items, who, 4, 1, PICKUP, mut fx)
    menu.carried = none
    s.inv.set_menu_slot(4, none)
    // Flint and steel, its two anywhere.
    menu.carried = stack("\{id:\"minecraft:flint\",count:1\}")
    _ = menu.click(mut s, items, who, 1, 0, PICKUP, mut fx)
    menu.carried = stack("\{id:\"minecraft:iron_ingot\",count:1\}")
    _ = menu.click(mut s, items, who, 4, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(0)), "\{count:1,id:\"minecraft:flint_and_steel\"\}", "flint and steel")
    s.inv.set_menu_slot(1, none)
    s.inv.set_menu_slot(4, none)
    // A shift-click crafts as many as there are, into the hotbar's last first.
    menu.carried = stack("\{id:\"minecraft:birch_log\",count:3\}")
    _ = menu.click(mut s, items, who, 2, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(0)), "\{count:4,id:\"minecraft:birch_planks\"\}", "birch planks")
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 0, 0, QUICK_MOVE, mut fx)
    check(shown(s.inv.menu_slot(44)), "\{count:12,id:\"minecraft:birch_planks\"\}", "crafted three times")
    check("{shown(s.inv.menu_slot(2))} {shown(s.inv.menu_slot(0))}", "- -", "the logs used up")
    check(effects(fx), "grid \{count:4,id:\"minecraft:birch_planks\"\}; grid \{count:4,id:\"minecraft:birch_planks\"\}; grid -", "each made again")
    // Honey bottles make a honey block and leave their bottles.
    for n in 1..5 {
        s.inv.set_menu_slot(usize.wrap(n), stack("\{id:\"minecraft:honey_bottle\",count:1\}"))
    }
    menu.carried = stack("\{id:\"minecraft:honey_bottle\",count:1\}")
    _ = menu.click(mut s, items, who, 1, 0, PICKUP, mut fx)
    check(shown(s.inv.menu_slot(0)), "\{count:1,id:\"minecraft:honey_block\"\}", "a honey block")
    menu.carried = none
    fx = List<Effect>()
    _ = menu.click(mut s, items, who, 0, 0, PICKUP, mut fx)
    check(shown(menu.carried), "\{count:1,id:\"minecraft:honey_block\"\}", "the honey block taken")
    check("{shown(s.inv.menu_slot(1))} {shown(s.inv.menu_slot(4))}", "\{count:1,id:\"minecraft:honey_bottle\"\} \{count:1,id:\"minecraft:glass_bottle\"\}", "the bottles left")
}

// What's in `n` slots, nothing in any.
fn empty_slots(n: usize) -> List<Tag?> {
    var out = List<Tag?>()
    for _ in 0..n {
        out.push(none)
    }
    return out
}

// A container's menus (CAL-144).
fn containers(items: ItemCodecs, who: Clicker) {
    // A chest's: its 27 slots, then the inventory's 27, then the hotbar's 9.
    var chest = Slots { inv: Inventory.empty(), container: empty_slots(27), kind: CHEST_MENU }
    chest.container[0] = stack("\{id:\"minecraft:stone\",count:5\}")
    chest.inv.set_menu_slot(9, stack("\{id:\"minecraft:dirt\",count:3\}"))
    var menu = Menu.of(chest.count())
    check("{menu.slots()}", "63", "a chest's slots")
    var fx = List<Effect>()
    _ = menu.click(mut chest, items, who, 0, 0, QUICK_MOVE, mut fx)
    check(shown(chest.inv.menu_slot(44)), "\{count:5,id:\"minecraft:stone\"\}", "into the hotbar's last")
    check(shown(chest.container[0]), "-", "out of the chest")
    check(effects(fx), "changed", "the chest's setChanged")
    // The inventory's first, the menu's 27, into the chest's first.
    fx = List<Effect>()
    _ = menu.click(mut chest, items, who, 27, 0, QUICK_MOVE, mut fx)
    check(shown(chest.container[0]), "\{count:3,id:\"minecraft:dirt\"\}", "into the chest")
    check(shown(chest.inv.menu_slot(9)), "-", "out of the inventory")
    // A pick-up from the chest, and a click on the player's slots, which isn't the chest's.
    fx = List<Effect>()
    _ = menu.click(mut chest, items, who, 0, 0, PICKUP, mut fx)
    check(shown(menu.carried), "\{count:3,id:\"minecraft:dirt\"\}", "picked up from the chest")
    check(effects(fx), "changed; changed; changed", "taken, emptied and clicked")
    fx = List<Effect>()
    _ = menu.click(mut chest, items, who, 30, 0, PICKUP, mut fx)
    check(effects(fx), "", "the inventory isn't the chest")
    check(shown(chest.inv.menu_slot(12)), "\{count:3,id:\"minecraft:dirt\"\}", "put down in the inventory")
    // What the inventory menu takes of the client's slots as the chest's closes: what the
    // chest's sent of the player's, the stone and the dirt, which it then needn't send again.
    var inventory = Menu()
    inventory.sent_all(Slots { inv: Inventory.empty() })
    menu.sent_all(chest)
    let plain = Slots { inv: chest.inv.copy() }
    var unsent = inventory.copy()
    check("{unsent.changes(plain, items).len()}", "2", "what the inventory menu sent")
    inventory.transfer_from(menu)
    check("{inventory.changes(plain, items).len()}", "0", "what the chest's menu sent")

    // A shulker box's slots take no shulker box.
    var box = Slots { inv: Inventory.empty(), container: empty_slots(27), kind: SHULKER_MENU }
    box.inv.set_menu_slot(36, stack("\{id:\"minecraft:red_shulker_box\",count:1\}"))
    box.inv.set_menu_slot(37, stack("\{id:\"minecraft:stone\",count:1\}"))
    var boxed = Menu.of(box.count())
    fx = List<Effect>()
    _ = boxed.click(mut box, items, who, 54, 0, QUICK_MOVE, mut fx)
    check(shown(box.container[0]), "-", "a shulker box refused")
    _ = boxed.click(mut box, items, who, 55, 0, QUICK_MOVE, mut fx)
    check(shown(box.container[0]), "\{count:1,id:\"minecraft:stone\"\}", "stone taken")

    // A dispenser's 9, its shift-click into the inventory from the hotbar's last.
    var dispenser = Slots { inv: Inventory.empty(), container: empty_slots(9), kind: DISPENSER_MENU }
    dispenser.container[4] = stack("\{id:\"minecraft:arrow\",count:16\}")
    var dispensing = Menu.of(dispenser.count())
    fx = List<Effect>()
    _ = dispensing.click(mut dispenser, items, who, 4, 0, QUICK_MOVE, mut fx)
    check(shown(dispenser.inv.menu_slot(44)), "\{count:16,id:\"minecraft:arrow\"\}", "out of the dispenser")
    check("{dispensing.slots()}", "45", "a dispenser's slots")
}
