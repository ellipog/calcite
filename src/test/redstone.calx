/// Checks redstone in the server's level as vanilla runs it (CAL-116), on a flat level whose
/// chunks tick, with block facts made from the built-in block and fluid registries: a lamp lit
/// at once by a redstone block and put out 4 ticks after it goes; wire powered a step less from
/// it, and all of it off once it goes; a torch on a block put out and lit again 2 ticks after,
/// and burnt out at its eighth toggle in 60 ticks; a repeater passing a signal on its delay,
/// and locked by another powering its side; and an observer pulsing as the block it watches
/// changes.
module test.redstone

import registry.builtin.{builtin_entries, builtin_names}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.chunk.{AIR_STATE, BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts}
import worldgen.providers.{GenContext}
import worldgen.survive.{Env}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The built-in registries, and plains as the one biome, in a world from y -64 to 320.
fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

// The flat world: bedrock, two dirt and grass, by vanilla's IDs, air from y -60.
fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

// The block facts, from the built-in block and fluid registries (4 and 2).
fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

// A flat level, its spawn's chunks full and given the facts, with a player at its middle, so
// its chunks tick.
fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn with(f: Facts, name: str, prop: str, value: str) -> u32 {
    return match f.with_name(named(f, name), String(prop), String(value)) {
        ok(s) => s,
        err(_) => panic("{name} has no {prop} {value}"),
    }
}

// Runs `ticks` ticks of the level's blocks, as `ServerLevel.tick` runs them.
fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.game_time += 1
        level.run_block_ticks()
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), what)
}

fn flag(f: Facts, level: Level, x: i32, y: i32, z: i32, name: str) -> bool {
    return f.get_bool(level.spawn_state(x, y, z), String(name))
}

fn power(f: Facts, level: Level, x: i32, y: i32, z: i32) -> i32 {
    return f.get_int(level.spawn_state(x, y, z), String("power")) ?? -1
}

// What the level reported isn't in Calcite yet, one line each.
fn quiet(level: mut Level, what: str) {
    var out = String("")
    for e in level.take_lines() {
        if e.message.contains("isn't in Calcite yet") {
            out = "{out}{e.message}; "
        }
    }
    if not out.is_empty() {
        panic("{what} reported {out}")
    }
}

// A redstone block set beside a lamp lights it at once, `neighborChanged`; taken away, the lamp
// stays lit until its tick, 4 ticks on.
fn lamp() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 2, -60, 2, named(f, "redstone_lamp"), "the lamp wasn't set")
    check(not flag(f, level, 2, -60, 2, "lit"), "the lamp's lit with nothing by it")
    set(mut level, 3, -60, 2, named(f, "redstone_block"), "the redstone block wasn't set")
    check(flag(f, level, 2, -60, 2, "lit"), "the lamp by the redstone block isn't lit")
    set(mut level, 3, -60, 2, AIR_STATE, "the redstone block wasn't taken away")
    check(flag(f, level, 2, -60, 2, "lit"), "the lamp went out before its tick")
    run(mut level, 3)
    check(flag(f, level, 2, -60, 2, "lit"), "the lamp went out before 4 ticks")
    run(mut level, 1)
    check(not flag(f, level, 2, -60, 2, "lit"), "the lamp didn't go out 4 ticks on")
    quiet(mut level, "the lamp")
    println("ok lamp")
}

// Wire laid from a redstone block: 15 beside it and a step less each block on; with the block
// gone, all of it off.
fn wire() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 0, -60, 6, named(f, "redstone_block"), "the redstone block wasn't set")
    for x in 1..5 {
        set(mut level, x, -60, 6, named(f, "redstone_wire"), "the wire wasn't set")
    }
    for x in 1..5 {
        check(power(f, level, x, -60, 6) == 16 - x, "the wire's power isn't a step less each block")
    }
    set(mut level, 0, -60, 6, AIR_STATE, "the redstone block wasn't taken away")
    for x in 1..5 {
        check(power(f, level, x, -60, 6) == 0, "the wire's still powered with the block gone")
    }
    quiet(mut level, "the wire")
    println("ok wire")
}

// A torch on stone: the stone swapped for a redstone block puts it out 2 ticks on, and back
// to stone lights it again 2 ticks on. Put out 8 times in 60 ticks, it burns out, with its
// event, and stays out until it tries again 160 ticks on.
fn torch() {
    let f = facts()
    var level = flat_level(f)
    let stone = named(f, "stone")
    let block = named(f, "redstone_block")
    set(mut level, 8, -60, 6, stone, "the stone wasn't set")
    set(mut level, 8, -59, 6, named(f, "redstone_torch"), "the torch wasn't set")
    check(flag(f, level, 8, -59, 6, "lit"), "the torch isn't lit")
    for i in 0..8 {
        set(mut level, 8, -60, 6, block, "the redstone block wasn't set")
        run(mut level, 1)
        check(flag(f, level, 8, -59, 6, "lit"), "the torch went out before its tick")
        run(mut level, 1)
        check(not flag(f, level, 8, -59, 6, "lit"), "the torch on the redstone block didn't go out")
        set(mut level, 8, -60, 6, stone, "the stone wasn't set again")
        run(mut level, 2)
        if i < 7 {
            check(flag(f, level, 8, -59, 6, "lit"), "the torch didn't light again")
        }
    }
    check(not flag(f, level, 8, -59, 6, "lit"), "the torch lit again after its eighth toggle")
    var burnt = 0
    for e in level.take_events() {
        if e.kind == 1502 and e.x == 8 and e.y == -59 and e.z == 6 {
            burnt += 1
        }
    }
    check(burnt == 1, "the torch didn't burn out once")
    run(mut level, 157)
    check(not flag(f, level, 8, -59, 6, "lit"), "the burnt out torch lit before 160 ticks")
    run(mut level, 1)
    check(flag(f, level, 8, -59, 6, "lit"), "the burnt out torch didn't light 160 ticks on")
    quiet(mut level, "the torch")
    println("ok torch")
}

// A repeater, delay 1, passes a redstone block's signal on to a lamp 2 ticks on, and its going
// 2 ticks on, the lamp out 4 after. Another repeater powering its side locks it.
fn repeater() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 3, -60, 10, named(f, "redstone_lamp"), "the lamp wasn't set")
    set(mut level, 2, -60, 10, with(f, "repeater", "facing", "west"), "the repeater wasn't set")
    set(mut level, 1, -60, 10, named(f, "redstone_block"), "the redstone block wasn't set")
    run(mut level, 1)
    check(not flag(f, level, 2, -60, 10, "powered"), "the repeater's powered before its delay")
    run(mut level, 1)
    check(flag(f, level, 2, -60, 10, "powered"), "the repeater isn't powered 2 ticks on")
    check(flag(f, level, 3, -60, 10, "lit"), "the lamp in front of the repeater isn't lit")
    set(mut level, 1, -60, 10, AIR_STATE, "the redstone block wasn't taken away")
    run(mut level, 2)
    check(not flag(f, level, 2, -60, 10, "powered"), "the repeater's still powered 2 ticks on")
    check(flag(f, level, 3, -60, 10, "lit"), "the lamp went out before its tick")
    run(mut level, 4)
    check(not flag(f, level, 3, -60, 10, "lit"), "the lamp didn't go out")
    set(mut level, 6, -60, 12, with(f, "repeater", "facing", "west"), "the locked repeater wasn't set")
    set(mut level, 6, -60, 11, with(f, "repeater", "facing", "north"), "the side repeater wasn't set")
    check(not flag(f, level, 6, -60, 12, "locked"), "the repeater's locked with its side off")
    set(mut level, 6, -60, 10, named(f, "redstone_block"), "the side's redstone block wasn't set")
    run(mut level, 2)
    check(flag(f, level, 6, -60, 11, "powered"), "the side repeater isn't powered")
    check(flag(f, level, 6, -60, 12, "locked"), "the repeater with its side powered isn't locked")
    quiet(mut level, "the repeater")
    println("ok repeater")
}

// An observer facing the block a stone's set in pulses 2 ticks on, for 2 ticks, lighting the
// lamp behind it, which goes out 4 ticks after.
fn observer() {
    let f = facts()
    var level = flat_level(f)
    set(mut level, 9, -60, 13, named(f, "redstone_lamp"), "the lamp wasn't set")
    set(mut level, 10, -60, 13, with(f, "observer", "facing", "east"), "the observer wasn't set")
    set(mut level, 11, -60, 13, named(f, "stone"), "the stone wasn't set")
    run(mut level, 1)
    check(not flag(f, level, 10, -60, 13, "powered"), "the observer's powered before its tick")
    run(mut level, 1)
    check(flag(f, level, 10, -60, 13, "powered"), "the observer isn't powered 2 ticks on")
    check(flag(f, level, 9, -60, 13, "lit"), "the lamp behind the observer isn't lit")
    run(mut level, 2)
    check(not flag(f, level, 10, -60, 13, "powered"), "the observer's still powered 2 ticks on")
    run(mut level, 4)
    check(not flag(f, level, 9, -60, 13, "lit"), "the lamp didn't go out")
    quiet(mut level, "the observer")
    println("ok observer")
}

fn main() {
    lamp()
    wire()
    torch()
    repeater()
    observer()
    println("ok")
}
