/// Checks `world.dragon`: an ender dragon's phases by their IDs, which it sits in, and its parts,
/// their IDs after its own, their sizes and boxes, at 0, 0, 0 as they're made and lifted as its
/// death lifts it (D608); its phases' fly speeds, its flight's history, a hover's flight at its
/// target and its parts placed about it at rest (D611).
module test.dragon

import world.dragon.{CHARGING_PLAYER, DYING, Dragon, Flight, HEAD, HOLDING_PATTERN, HOVERING, LANDING, NECK, PARTS, SITTING_ATTACKING, SITTING_FLAMING, SITTING_SCANNING, TAKEOFF, fly_speed, part_index, part_size, phase_of, sits}

fn check(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

fn main() {
    // `EnderDragonPhase.getById`: the holding pattern for what's out of range.
    check("{phase_of(0)} {phase_of(4)} {phase_of(10)} {phase_of(11)} {phase_of(99)} {phase_of(-1)}", "0 4 10 0 0 0", "phases by their IDs")
    check("{HOLDING_PATTERN} {TAKEOFF} {DYING} {HOVERING}", "0 4 9 10", "the phases' IDs")

    // `isSitting`: hovering and the three sitting phases.
    var sitting = String()
    for p in 0..11 {
        sitting.push_str(if sits(p) { "s" } else { "-" })
    }
    check(sitting, "-----sss--s", "the phases it sits in")
    check("{sits(SITTING_FLAMING) and sits(SITTING_SCANNING) and sits(SITTING_ATTACKING)}", "true", "the sitting phases")

    // Its parts: head, neck, body, the tail's three and the wings, by `EnderDragonPart`'s sizes.
    var sizes = String()
    for i in 0..PARTS {
        let (w, h) = part_size(i)
        sizes.push_str("{w}x{h} ")
    }
    check(sizes, "1.0x1.0 3.0x3.0 5.0x3.0 2.0x2.0 2.0x2.0 2.0x2.0 4.0x2.0 4.0x2.0 ", "the parts' sizes")

    // Their IDs, the eight after the dragon's.
    check("{part_index(10, 10) ?? 99} {part_index(10, 11) ?? 99} {part_index(10, 18) ?? 99} {part_index(10, 19) ?? 99} {part_index(10, 9) ?? 99}", "99 0 7 99 99", "the parts by their IDs")

    // Made at 0, 0, 0, hovering, so sitting.
    var d = Dragon.made()
    check("{d.parts.len()} {d.phase} {d.sitting()} {d.death_time} {d.sitting_damage}", "8 10 true 0 0.0", "a dragon as it's made")
    let (x0, y0, z0, x1, y1, z1) = d.part_box(HEAD)
    check("{x0} {y0} {z0} {x1} {y1} {z1}", "-0.5 0.0 -0.5 0.5 1.0 0.5", "its head's box at 0, 0, 0")
    d.move_parts(0.0, 0.5, 0.0)
    let (bx0, by0, _, bx1, by1, _) = d.part_box(2)
    check("{bx0} {by0} {bx1} {by1}", "-2.5 0.5 2.5 3.5", "its body's box lifted")
    d.phase = TAKEOFF
    check("{d.sitting()}", "false", "taking off, it doesn't sit")

    // `getFlySpeed`: hovering 1, landing 1.5, charging and dying 3, the rest 0.6.
    check("{fly_speed(HOVERING)} {fly_speed(LANDING)} {fly_speed(CHARGING_PLAYER)} {fly_speed(DYING)} {fly_speed(HOLDING_PATTERN)}", "1.0 1.5 3.0 3.0 0.6", "the phases' fly speeds")

    // Its flight's history: all 0 as it's made, all the first it keeps, then the newest first.
    var h = Dragon.made()
    let (hy, hr) = h.sample(0)
    check("{hy} {hr}", "0.0 0.0", "its history as it's made")
    h.record(70.0, 10.0f32)
    let (fy, _) = h.sample(63)
    check("{h.history_head} {fy}", "0 70.0", "its first height filling its history")
    h.record(71.0, 20.0f32)
    let (ny, nr) = h.sample(0)
    let (oy, o_r) = h.sample(1)
    check("{ny} {nr} {oy} {o_r}", "71.0 20.0 70.0 10.0", "its newest two")
    for i in 0..62 {
        h.record(80.0 + f64(i), 0.0f32)
    }
    h.record(200.0, 0.0f32)
    let (wy, _) = h.sample(0)
    let (ly, _) = h.sample(63)
    check("{h.history_head} {wy} {ly}", "0 200.0 71.0", "its history wrapping round")

    // A hover begun again forgets where it was held.
    h.hover_target = some((1.0, 2.0, 3.0))
    h.begin(HOVERING)
    check("{h.phase} {h.hover_target == none}", "10 true", "a hover begun")

    // At rest at its hover's target, facing south: pushed back a fiftieth, along z only.
    var r = Dragon.made()
    let went = r.fly(Flight { x: 0.0, y: 64.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, y_rot: 0.0f32 }, (0.0, 64.0, 0.0))
    check("{went.x} {went.y} {went.y_rot} {went.z > 0.0199 and went.z < 0.0201} {r.y_rot_a}", "0.0 64.0 0.0 true 0.0", "a hover's flight at its target")

    // Its parts at rest at 0, 64, 0, facing south, its history all there, hovering, so sitting.
    var s = Dragon.made()
    s.record(64.0, 0.0f32)
    s.place_parts(0.0, 64.0, 0.0, 0.0f32, true)
    var placed = String()
    for i in 0..PARTS {
        let (px, py, pz) = s.parts[i]
        placed.push_str("{px},{py},{pz} ")
    }
    check(placed, "0.0,63.0,-6.5 0.0,63.0,-5.5 0.0,64.0,-0.5 0.0,65.5,3.5 0.0,65.5,5.5 0.0,65.5,7.5 4.5,66.0,0.0 -4.5,66.0,0.0 ", "its parts at rest")
    let wing = s.strikes[0]
    let near = s.strikes[2]
    check("{s.strikes.len()} {wing.min_x} {wing.min_y} {wing.max_x} {wing.max_y} {near.min_y} {near.max_y}", "4 -1.5 62.0 10.5 68.0 -1.0 2.0", "what its wings and head reach")
    s.place_parts(0.0, 64.0, 0.0, 0.0f32, false)
    let (_, neck_y, _) = s.parts[NECK]
    check("{s.strikes.len()} {neck_y}", "0 63.0", "hurt lately, it reaches nothing")
    print("ok\n")
}
