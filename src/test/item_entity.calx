/// Checks item entities, `world.item_entity` and `world.entities` (CAL-148): an item made with
/// its random's UUID, spin and motion, and one falling onto stone and sliding to a stop, each to
/// the bit against a model of vanilla's `ItemEntity` written apart from Calcite's,
/// [`item_model.py`](item_model.py), which prints what this checks; an item held up in still
/// water, and one splashing into it; two stacks merging, the smaller into the larger; an item
/// going at 6000 ticks; and the order `find` gives items in, section by section as vanilla's
/// `getEntities` does.
module test.item_entity

import nbt.tag.{Tag}
import registry.builtin.{builtin_entries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.chunk.{BlockStates}
import world.collision.{Aabb, CollisionBlocks}
import world.entities.{EntityTicking, Entities, StackSizes}
import world.item_entity.{ItemEntity, ItemFacts, ItemSound}
import world.movement.{MovementStates}
import worldgen.facts.{Facts}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    return match Facts.new(registry(4, "block"), registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn state(f: Facts, name: str) -> u32 {
    let block = f.block_named(String(name)) else panic("no block {name}")
    return f.default_state(block)
}

// Stone at y 0 and below, air above but where water is, loaded and ticking everywhere near.
struct World {
    stone: u32
    water: u32
    wet: Set<i64>
}

fn key(x: i32, y: i32, z: i32) -> i64 {
    return (i64(x) & 0xFFFFF) << 40 | (i64(y) & 0xFFFFF) << 20 | (i64(z) & 0xFFFFF)
}

impl CollisionBlocks for World {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        if x < -64 or x >= 64 or z < -64 or z >= 64 {
            return none
        }
        if self.wet.contains(key(x, y, z)) {
            return some(self.water)
        }
        if y <= 0 {
            return some(self.stone)
        }
        return some(0)
    }
}

impl EntityTicking for World {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool {
        return chunk_x > -100 and chunk_z > -100
    }
}

struct Sizes {
    most: i32
}

impl StackSizes for Sizes {
    fn stack_most(self, stack: Tag) -> i32 {
        return if stack == Tag.Int(0) { 0 } else { self.most }
    }
}

fn item_stack(name: str, count: i32) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String(name)))
    m.insert(String("count"), Tag.Int(count))
    return Tag.Compound(m)
}

fn bits(v: f64) -> i64 {
    return i64.wrap(v.to_bits())
}

fn float_bits(v: f32) -> i64 {
    return i64(v.to_bits())
}

// Made with seed 148: its UUID, `bobOffs`, spin and motion, as the model's `java.util.Random` drew them.
fn made() {
    let e = ItemEntity.new(7, 148, 0.5, 2.0, 0.5, item_stack("minecraft:stone", 1))
    let (most, least) = e.uuid
    check(most == -4731420712261433922 and least == -9143664734749418238, "an item's UUID isn't vanilla's")
    check(float_bits(e.bob) == 1084227633 and float_bits(e.y_rot) == 1127556286, "an item's bob and spin aren't vanilla's")
    check(bits(e.vx) == -4631951951806159840 and e.vy == 0.2 and bits(e.vz) == 4587887067637413436, "an item's motion isn't vanilla's")
    println("made: UUID, bob, spin and motion")
}

// Falling onto stone and sliding, each tick to the bit as the model has it.
fn falling(f: Facts, m: MovementStates, t: ItemFacts, w: World) {
    var e = ItemEntity.moving(7, 1, 0.5, 2.0, 0.5, item_stack("minecraft:stone", 1), 0.05, 0.1, -0.03)
    var sounds = List<ItemSound>()
    let want: List<i64> = [
        1, 4603129179135383962, 4611821126416209019, 4602138387217362452, 4587222465388950324, 4588634794259581502, -4639240842222564803, 0,
        3, 4604003057632505139, 4611814875425836104, 4601089733020817039, 4586942824536558100, -4641620334321882528, -4639576411245435472, 0,
        5, 4604842330573809421, 4611218355333661200, 4600082605491251901, 4586674257451466506, -4631651508835091182, -4639898691747545386, 0,
        10, 4606797973713744991, 4607182418800017408, 4597296447901382019, 4582722379430620273, 0, -4643740225447086765, 1,
        20, 4607247066584973478, 4607182418800017408, 4596063470326539083, 4562314857828583772, -4630060704907059528, -4664626371667634169, 1,
        40, 4607255889358522403, 4607182418800017408, 4596021121013504243, 4544882700758300756, -4630060704907059528, -4681942080450077393, 1,
    ]
    var at: usize = 0
    for tick in 1..=40 {
        e.tick_moving(f, m, t, w, -64, false, mut sounds)
        e.tick_after(f, t, w, false, mut sounds)
        if at < want.len() and want[at] == i64(tick) {
            let got: List<i64> = [bits(e.x), bits(e.y), bits(e.z), bits(e.vx), bits(e.vy), bits(e.vz), if e.on_ground { 1 } else { 0 }]
            for k in 0..got.len() {
                if got[k] != want[at + 1 + k] {
                    panic("tick {tick}: {e.x} {e.y} {e.z} moving {e.vx} {e.vy} {e.vz}, on the ground {e.on_ground}, differs from the model at {k}")
                }
            }
            at += 8
        }
    }
    check(at == want.len(), "not every tick of the model was checked")
    check(sounds.is_empty(), "an item on stone made a sound")
    check(e.support != none, "an item on stone stands on no block")
    println("falling onto stone and sliding, 40 ticks as the model")
}

// In still water: held up 5.0E-4F a tick and slowed as the air slows it; and splashing in.
fn water(f: Facts, m: MovementStates, t: ItemFacts) {
    var w = World { stone: state(f, "minecraft:stone"), water: state(f, "minecraft:water"), wet: Set<i64>() }
    for x in -2..=2 {
        for z in -2..=2 {
            w.wet.insert(key(x, 1, z))
        }
    }
    var sounds = List<ItemSound>()
    var e = ItemEntity.moving(3, 1, 0.5, 1.5, 0.5, item_stack("minecraft:stone", 1), 0.0, 0.0, 0.0)
    e.tick_moving(f, m, t, w, -64, false, mut sounds)
    e.tick_after(f, t, w, false, mut sounds)
    let up = (0.0 + f64(5.0e-4f32)) * f64(0.98f32)
    check(e.in_water and e.vy == up and e.y == 1.5 + f64(5.0e-4f32), "an item in still water isn't held up")
    check(sounds.is_empty(), "an item made in water splashed")
    // From above, falling in: one splash as it comes in.
    var g = ItemEntity.moving(4, 2, 0.5, 2.2, 0.5, item_stack("minecraft:stone", 1), 0.0, -0.3, 0.0)
    for _ in 0..3 {
        g.tick_moving(f, m, t, w, -64, false, mut sounds)
        g.tick_after(f, t, w, false, mut sounds)
    }
    check(sounds.len() == 1 and sounds[0].sound == "minecraft:entity.generic.splash", "an item falling into water didn't splash once")
    check(sounds[0].volume > 0.0f32 and sounds[0].volume <= 1.0f32, "a splash's volume")
    println("water: held up, and a splash coming in")
}

// Two stacks side by side on stone merge on the 40th tick, the smaller into the larger, with the
// larger's pickup delay and the younger age; an item goes at 6000 ticks.
fn merging(f: Facts, m: MovementStates, t: ItemFacts, w: World) {
    var store = Entities.new()
    var a = ItemEntity.moving(10, 1, 0.5, 1.0, 0.5, item_stack("minecraft:stone", 3), 0.0, 0.0, 0.0)
    a.on_ground = true
    a.tick_count = 39
    a.age = 100
    a.pickup_delay = 10
    var b = ItemEntity.moving(11, 2, 0.9, 1.0, 0.5, item_stack("minecraft:stone", 5), 0.0, 0.0, 0.0)
    b.on_ground = true
    b.tick_count = 39
    b.age = 200
    b.pickup_delay = 2
    store.add(a)
    store.add(b)
    var sounds = List<ItemSound>()
    store.tick(f, m, t, Sizes { most: 64 }, w, -64, false, mut sounds)
    check(store.len() == 1 and not store.contains(10) and store.contains(11), "the smaller stack didn't merge into the larger")
    let kept = store.item(11)
    check(kept.count() == 8, "the merged stack isn't 8")
    check(kept.age == 101 and kept.pickup_delay == 8, "the merged stack's age and pickup delay")
    check(kept.stack_changed, "the merged stack wasn't marked to be sent")
    let gone = store.take_gone()
    check(gone.len() == 1 and gone[0] == 10, "the merged-away item isn't told of as gone")
    // Too many to fit together: no merge.
    var c = ItemEntity.moving(12, 3, 4.5, 1.0, 4.5, item_stack("minecraft:stone", 40), 0.0, 0.0, 0.0)
    c.on_ground = true
    c.tick_count = 79
    var d = ItemEntity.moving(13, 4, 4.8, 1.0, 4.5, item_stack("minecraft:stone", 30), 0.0, 0.0, 0.0)
    d.on_ground = true
    d.tick_count = 79
    store.add(c)
    store.add(d)
    store.tick(f, m, t, Sizes { most: 64 }, w, -64, false, mut sounds)
    check(store.contains(12) and store.contains(13), "stacks too big to fit together merged")
    // Lifetime.
    var old = ItemEntity.moving(14, 5, 8.5, 1.0, 8.5, item_stack("minecraft:dirt", 1), 0.0, 0.0, 0.0)
    old.age = 5998
    store.add(old)
    store.tick(f, m, t, Sizes { most: 64 }, w, -64, false, mut sounds)
    check(store.contains(14), "an item went before 6000 ticks")
    store.tick(f, m, t, Sizes { most: 64 }, w, -64, false, mut sounds)
    check(not store.contains(14), "an item outlived 6000 ticks")
    println("merging, the smaller into the larger, not past a stack, and going at 6000 ticks")
}

// `find`'s order: by section x, then z and y as `SectionPos.asLong` orders them, so z 0 before
// z -1; and in a section in the order items came into it.
fn order() {
    var store = Entities.new()
    store.add(ItemEntity.moving(1, 1, 3.0, 3.0, 3.0, item_stack("minecraft:stone", 1), 0.0, 0.0, 0.0))
    store.add(ItemEntity.moving(2, 1, 3.0, 3.0, -3.0, item_stack("minecraft:stone", 1), 0.0, 0.0, 0.0))
    store.add(ItemEntity.moving(3, 1, 3.0, 19.0, 3.0, item_stack("minecraft:stone", 1), 0.0, 0.0, 0.0))
    store.add(ItemEntity.moving(4, 1, -3.0, 3.0, 3.0, item_stack("minecraft:stone", 1), 0.0, 0.0, 0.0))
    store.add(ItemEntity.moving(5, 1, 4.0, 3.0, 3.0, item_stack("minecraft:stone", 1), 0.0, 0.0, 0.0))
    let all = store.find(Aabb { min_x: -10.0, min_y: -10.0, min_z: -10.0, max_x: 10.0, max_y: 30.0, max_z: 10.0 }, -1)
    let want: List<i32> = [4, 1, 5, 3, 2]
    check(all.len() == want.len(), "find didn't find every item")
    for i in 0..want.len() {
        check(all[i] == want[i], "find's order isn't getEntities'")
    }
    let some_of = store.find(Aabb { min_x: 2.0, min_y: 2.0, min_z: 2.0, max_x: 3.5, max_y: 4.0, max_z: 4.0 }, 1)
    check(some_of.is_empty(), "find gave an item it was told to leave out, or one outside its box")
    println("find: sections by x, then z and y as asLong orders them")
}

fn main() {
    let f = facts()
    let m = MovementStates.new(f)
    let t = ItemFacts.new(f)
    let w = World { stone: state(f, "minecraft:stone"), water: state(f, "minecraft:water"), wet: Set<i64>() }
    made()
    falling(f, m, t, w)
    water(f, m, t)
    merging(f, m, t, w)
    order()
    println("ok")
}
