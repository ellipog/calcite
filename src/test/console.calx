/// Checks Calcite's style of console (CAL-53): each look's line as `styled` writes it, with the
/// time faint, a mark for what happened, and later lines under the first; the card `card` writes
/// when the server is ready; and both without color, as with `NO_COLOR`. Then that a `Log` on a
/// pipe, as here, prints vanilla's lines.
module test.console

import server.log.{Accounts, Card, Level, Log, Look, Style, card, line, styled}
import server.paint.{Colors}
import std.time.{Timestamp}

fn check(got: String, want: String) {
    if got != want {
        panic("got\n{got}\nwant\n{want}")
    }
}

// The text with each escape code written as `<code>`, so a test can read it.
fn codes(s: String) -> String {
    var out = List<u8>()
    var i: usize = 0
    let bytes = s.to_bytes()
    while i < bytes.len() {
        if bytes[i] == 27 {
            // ESC [ code m
            out.push(60)
            i += 2
            while bytes[i] != 109 {
                out.push(bytes[i])
                i += 1
            }
            out.push(62)
        } else {
            out.push(bytes[i])
        }
        i += 1
    }
    return String.from_utf8(out)!
}

// 2026-10-21 00:00:05 UTC, shown two hours ahead.
fn at() -> Timestamp {
    return Timestamp { unix_ms: 1792540805000 }
}

fn shown(level: Level, message: str, look: Look) -> String {
    let s = styled(at(), 7200, level, String(message), look, Colors.Exact) else return String("none")
    return codes(s)
}

fn plain(level: Level, message: str, look: Look) -> String {
    return styled(at(), 7200, level, String(message), look, Colors.Off) ?? String("none")
}

fn main() {
    let time = "<38;2;110;118;129>02:00:05<0>"
    check(shown(Level.Info, "Loading properties", Look.Plain), "  {time}     Loading properties")
    check(shown(Level.Info, "Starting minecraft server version 26.3", Look.Words(String("Starting"))), "  {time}     Starting")
    check(shown(Level.Warn, "careful", Look.Plain), "  {time}  <1;38;2;210;153;34>▲<0>  <38;2;210;153;34>careful<0>")
    check(shown(Level.Error, "broken", Look.Plain), "  {time}  <1;38;2;248;81;73>×<0>  <38;2;248;81;73>broken<0>")
    check(shown(Level.Info, "x", Look.Join(String("Steve joined from 127.0.0.1"))), "  {time}  <1;38;2;63;185;80>→<0>  Steve joined from 127.0.0.1")
    check(shown(Level.Info, "x", Look.Leave(String("Steve left: End of stream"))), "  {time}  <1;38;2;139;148;158>←<0>  Steve left: End of stream")
    check(shown(Level.Info, "<Steve> hi", Look.Chat { name: String("Steve"), words: String("hi"), signed: true }), "  {time}     <1>Steve<0>  hi")
    check(shown(Level.Info, "[Not Secure] <Steve> hi", Look.Chat { name: String("Steve"), words: String("hi"), signed: false }), "  {time}     <1>Steve<0>  hi<38;2;139;148;158>  unsigned<0>")
    check(shown(Level.Info, "Generating keypair", Look.Quiet), "none")

    // A message's later lines start under its first, muted.
    check(shown(Level.Error, "Failed\njava.io.IOException: gone\nmore", Look.Plain), "  {time}  <1;38;2;248;81;73>×<0>  <38;2;248;81;73>Failed<0>\n               <38;2;139;148;158>java.io.IOException: gone<0>\n               <38;2;139;148;158>more<0>")

    // Without color, the same text.
    check(plain(Level.Warn, "careful", Look.Plain), "  02:00:05  ▲  careful")
    check(plain(Level.Info, "x", Look.Chat { name: String("Steve"), words: String("hi"), signed: false }), "  02:00:05     Steve  hi  unsigned")

    // The card, online, and offline with the files a first start made.
    let online = Card { version: String("26.3"), took: String("4.8 ms"), address: String("localhost:25565"), accounts: Accounts.Online, view_distance: 32, simulation_distance: 10, max_players: 20, made: List<String>() }
    check(card(online, Colors.Off), "\n  calcite  Minecraft 26.3 · ready in 4.8 ms\n\n  ›  Address    localhost:25565\n  ›  Accounts   checked with Mojang\n  ›  World      flat, 32 chunks in view, 10 simulated\n  ›  Players    up to 20\n")
    check("{codes(card(online, Colors.Exact)).find("<1;38;2;30;31;36;48;2;237;236;230> calcite <0>") != none}", "true")
    let offline = Card { version: String("26.3"), took: String("4.8 ms"), address: String("10.0.0.2:25570"), accounts: Accounts.Offline, view_distance: 10, simulation_distance: 10, max_players: 5, made: [String("server.properties"), String("calcite.properties")] }
    check(card(offline, Colors.Off), "\n  calcite  Minecraft 26.3 · ready in 4.8 ms\n\n  ›  Address    10.0.0.2:25570\n  ›  Accounts   not checked: offline mode, so anyone can join with any name\n                set online-mode=true in server.properties to check them\n  ›  World      flat, 10 chunks in view, 10 simulated\n  ›  Players    up to 5\n\n  Made server.properties and calcite.properties, with every setting at its default.\n")
    let velocity = Card { version: String("26.3"), took: String("1.0 ms"), address: String("localhost:25565"), accounts: Accounts.Velocity, view_distance: 10, simulation_distance: 10, max_players: 20, made: [String("server.properties")] }
    let v = card(velocity, Colors.Off)
    check("{v.find("checked by the Velocity proxy") != none} {v.find("Made server.properties, with every setting") != none}", "true true")

    // Vanilla's line is the same whatever the look.
    check(line(at(), 7200, String("Server thread"), Level.Info, String("Done")), "[02:00:05] [Server thread/INFO]: Done")

    // Standard output is a pipe here, so a log prints vanilla's lines unless it's told otherwise,
    // and shows no card.
    var out = Log.console()
    out.write(String("Server thread"), Level.Info, String("Generating keypair"), Look.Quiet)
    out.show_card(online)
    out.set_style(Style.Calcite)
    out.write(String("Server thread"), Level.Info, String("Generating keypair"), Look.Quiet)
    out.set_style(Style.Vanilla)
    out.close()
    println("ok")
}
