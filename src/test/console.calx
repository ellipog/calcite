/// Checks Calcite's style of console line, as `styled` writes it (CAL-50): the time dimmed, each
/// look's tag and colors, a thread named only when it isn't the server's own, a message's later
/// lines under its first, and a quiet line not shown. Then that a `Log` on a pipe, as here,
/// prints vanilla's lines.
module test.console

import server.log.{Level, Log, Look, Style, line, styled}
import std.time.{Timestamp}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// The line with each escape code written as `<code>`, so a test can read it.
fn shown(at: Timestamp, thread: str, level: Level, message: str, look: Look) -> String {
    let s = styled(at, 7200, String(thread), level, String(message), look) else return String("none")
    var out = List<u8>()
    var i: usize = 0
    let bytes = s.to_bytes()
    while i < bytes.len() {
        if bytes[i] == 27 {
            // ESC [ code m
            out.push(60)
            i += 2
            while bytes[i] != 109 {
                out.push(bytes[i])
                i += 1
            }
            out.push(62)
        } else {
            out.push(bytes[i])
        }
        i += 1
    }
    return String.from_utf8(out)!
}

fn main() {
    // 2026-10-21 00:00:05 UTC, two hours behind the console's zone.
    let at = Timestamp { unix_ms: 1792540805000 }
    check(shown(at, "Server thread", Level.Info, "Loading properties", Look.Plain), "<2>02:00:05<0> <36>INFO <0> <0>Loading properties<0>")
    check(shown(at, "Server thread", Level.Info, "Starting minecraft server version 26.3", Look.Words(String("Starting Calcite, for Minecraft 26.3"))), "<2>02:00:05<0> <36>INFO <0> <0>Starting Calcite, for Minecraft 26.3<0>")
    check(shown(at, "Server thread", Level.Warn, "careful", Look.Plain), "<2>02:00:05<0> <1;33>WARN <0> <33>careful<0>")
    check(shown(at, "Server thread", Level.Error, "broken", Look.Plain), "<2>02:00:05<0> <1;31>ERROR<0> <31>broken<0>")
    check(shown(at, "Server thread", Level.Info, "Done", Look.Ready(String("Ready"))), "<2>02:00:05<0> <1;32>READY<0> <1>Ready<0>")
    check(shown(at, "Server thread", Level.Info, "x", Look.Join(String("Steve joined from 127.0.0.1:5000"))), "<2>02:00:05<0> <32>JOIN <0> <0>Steve joined from 127.0.0.1:5000<0>")
    check(shown(at, "Server thread", Level.Info, "x", Look.Leave(String("Steve left: End of stream"))), "<2>02:00:05<0> <35>LEAVE<0> <0>Steve left: End of stream<0>")
    check(shown(at, "Server thread", Level.Info, "<Steve> hi", Look.Chat(String("Steve: hi"))), "<2>02:00:05<0> <37>CHAT <0> <0>Steve: hi<0>")
    check(shown(at, "Server thread", Level.Info, "Generating keypair", Look.Quiet), "none")

    // Only another thread is named, and `main` isn't.
    check(shown(at, "main", Level.Info, "a", Look.Plain), "<2>02:00:05<0> <36>INFO <0> <0>a<0>")
    check(shown(at, "User Authenticator #1", Level.Info, "a", Look.Plain), "<2>02:00:05<0> <36>INFO <0> <2>User Authenticator #1:<0> <0>a<0>")

    // A message's later lines start under its first.
    check(shown(at, "Server thread", Level.Error, "Failed\njava.io.IOException: gone\nmore", Look.Plain), "<2>02:00:05<0> <1;31>ERROR<0> <31>Failed\n               java.io.IOException: gone\n               more<0>")

    // Vanilla's line is the same whatever the look.
    check(line(at, 7200, String("Server thread"), Level.Info, String("Done")), "[02:00:05] [Server thread/INFO]: Done")

    // Standard output is a pipe here, so a log prints vanilla's lines unless it's told otherwise.
    var out = Log.console()
    out.write(String("Server thread"), Level.Info, String("Generating keypair"), Look.Quiet)
    out.set_style(Style.Calcite)
    out.write(String("Server thread"), Level.Info, String("Generating keypair"), Look.Quiet)
    out.set_style(Style.Vanilla)
    out.close()
    println("ok")
}
