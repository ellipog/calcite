/// Checks logs/latest.log's archives against what log4j 2.26.0 did with Mojang's log4j2.xml, run
/// in the same folders (CAL-46): at start, at midnight, a day's numbers with gaps, 7 a day, an
/// empty file, leftovers and names that only look like archives. Where log4j's second, empty roll
/// changes the result, the case says what vanilla left instead (rig/differences/log-second-roll.md).
/// Then the file's thread, through `Log`, with an archive compressed beside it.
module test.log_file

import server.log.{Level, Log}
import server.log_file.{FileLine, LogFile, Zone, compress_archive}
import std.fs.{list, make_dir_all, read, remove_dir_all, set_modified, temp_dir, write}
import std.time.{Timestamp}
import std.zlib.{Format, compress, decompress}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

// Central European winter time, an hour ahead of UTC, where log4j ran.
const OFFSET: i32 = 3600

// The days from 1970-01-01 to the date, on the Gregorian calendar.
fn days(y: i64, m: i64, d: i64) -> i64 {
    let year = if m <= 2 { y - 1 } else { y }
    let era = year.floor_div(400)
    let of_era = year - era * 400
    let of_year = (153 * ((m + 9) % 12) + 2) / 5 + d - 1
    return era * 146097 + of_era * 365 + of_era / 4 - of_era / 100 + of_year - 719468
}

// 2026-10-`day` at the local time `h`:`min`:`s`.
fn oct(day: i64, h: i64, min: i64, s: i64) -> Timestamp {
    let secs = days(2026, 10, day) * 86400 + h * 3600 + min * 60 + s - i64(OFFSET)
    return Timestamp { unix_ms: secs * 1000 }
}

// When each case's server starts: 02:53 on the 29th, as log4j's runs did.
fn start() -> Timestamp {
    return oct(29, 2, 53, 22)
}

// A new, empty folder for a case's logs.
fn folder() -> String {
    let dir = "{temp_dir()!}/logs"
    make_dir_all(dir)!
    return dir
}

// The file `name` in `dir`, holding `text`, compressed if its name ends in `.gz`, and last
// written at `at`.
fn put(dir: String, name: String, text: String, at: Timestamp) {
    let path = "{dir}/{name}"
    let bytes = text.to_bytes()
    write(path, if path.ends_with(".gz") { compress(bytes, Format.Gzip, 6) } else { bytes })!
    set_modified(path, at)!
}

// Each file in `dir`, as `name=text`, with a compressed one's text inflated and each line break
// a `|`.
fn show(dir: String) -> String {
    var out = List<u8>()
    for name in list(dir)! {
        var bytes = read("{dir}/{name}")!
        if name.ends_with(".gz") {
            bytes = decompress(bytes, Format.Gzip, 1048576)!
        }
        if not out.is_empty() {
            out.push(32)
        }
        for b in "{name}=".to_bytes() {
            out.push(b)
        }
        for b in bytes {
            out.push(if b == 10 { 124 } else { b })
        }
    }
    return String.from_utf8(out)!
}

fn line(at: Timestamp, text: String) -> FileLine {
    return FileLine { at: at, text: "{text}\n" }
}

// Opens the log in `dir` at `start()`, writes `lines` in one go, compresses what it archived,
// and gives what the folder holds.
fn after(dir: String, lines: List<FileLine>) -> String {
    var file = LogFile.open(dir, start(), Zone.fixed(OFFSET))!
    file.write(lines)!
    for path in file.take_archived() {
        compress_archive(path)!
    }
    let shown = show(dir)
    remove_dir_all(dir)!
    return shown
}

// The server's first line, as it starts.
fn first() -> List<FileLine> {
    return [line(start(), "new")]
}

// A latest.log from noon on the 28th.
fn yesterday(dir: String) {
    put(dir, "latest.log", "old\n", oct(28, 12, 0, 0))
}

// Archives of the 28th, `2026-10-28-N.log.gz` holding `fN`, for each N.
fn archives(dir: String, which: List<i32>) {
    for n in which {
        put(dir, "2026-10-28-{n}.log.gz", "f{n}\n", oct(28, 10, 0, 0))
    }
}

fn starts() {
    // No folder at all: it's made.
    let missing = "{temp_dir()!}/logs"
    check(after(missing, first()), "latest.log=new|")

    // Yesterday's file is archived under yesterday.
    var dir = folder()
    yesterday(dir)
    check(after(dir, first()), "2026-10-28-1.log.gz=old| latest.log=new|")

    // One from earlier today is archived under today.
    dir = folder()
    put(dir, "latest.log", "old\n", oct(29, 1, 0, 0))
    check(after(dir, first()), "2026-10-29-1.log.gz=old| latest.log=new|")

    // An empty one isn't archived, and the first line goes in it.
    dir = folder()
    put(dir, "latest.log", "", oct(28, 12, 0, 0))
    check(after(dir, first()), "latest.log=new|")
}

fn numbers() {
    // Gaps stay: the new one is one past the highest.
    var dir = folder()
    archives(dir, [1, 3])
    yesterday(dir)
    check(after(dir, first()), "2026-10-28-1.log.gz=f1| 2026-10-28-3.log.gz=f3| 2026-10-28-4.log.gz=old| latest.log=new|")

    // With 7, the lowest goes and the rest move down. Vanilla's second roll also removes f2,
    // leaving f3 to f7 and old as 1 to 6.
    dir = folder()
    archives(dir, [1, 2, 3, 4, 5, 6, 7])
    put(dir, "latest.log", "old\n", oct(28, 13, 0, 0))
    check(after(dir, first()), "2026-10-28-1.log.gz=f2| 2026-10-28-2.log.gz=f3| 2026-10-28-3.log.gz=f4| 2026-10-28-4.log.gz=f5| 2026-10-28-5.log.gz=f6| 2026-10-28-6.log.gz=f7| 2026-10-28-7.log.gz=old| latest.log=new|")

    // A 7 there moves every one down, gaps and all, and the new one is 7. Vanilla's second roll
    // moves them down again, to 1, 5 and 6.
    dir = folder()
    archives(dir, [3, 7])
    yesterday(dir)
    check(after(dir, first()), "2026-10-28-2.log.gz=f3| 2026-10-28-6.log.gz=f7| 2026-10-28-7.log.gz=old| latest.log=new|")

    // Past 7 too. Vanilla's second roll leaves old as 6 and f9 as 7.
    dir = folder()
    archives(dir, [9])
    yesterday(dir)
    check(after(dir, first()), "2026-10-28-7.log.gz=old| 2026-10-28-8.log.gz=f9| latest.log=new|")

    // An archive that was never compressed counts, and so does `01`. A name without a number
    // doesn't, nor does another day's.
    dir = folder()
    put(dir, "2026-10-28-2.log", "left\n", oct(28, 10, 0, 0))
    yesterday(dir)
    check(after(dir, first()), "2026-10-28-2.log=left| 2026-10-28-3.log.gz=old| latest.log=new|")
    dir = folder()
    put(dir, "2026-10-28-01.log.gz", "z\n", oct(28, 10, 0, 0))
    put(dir, "2026-10-28-x.log.gz", "x\n", oct(28, 10, 0, 0))
    put(dir, "2026-10-27-5.log.gz", "y\n", oct(27, 10, 0, 0))
    yesterday(dir)
    check(after(dir, first()), "2026-10-27-5.log.gz=y| 2026-10-28-01.log.gz=z| 2026-10-28-2.log.gz=old| 2026-10-28-x.log.gz=x| latest.log=new|")
}

fn midnight() {
    // The first line of the next day archives the day before, in the same write.
    check(after(folder(), [line(oct(29, 23, 59, 59), "a"), line(oct(30, 0, 0, 1), "b")]), "2026-10-29-1.log.gz=a| latest.log=b|")

    // Days skipped between are no matter: it's named for the day its lines are from.
    check(after(folder(), [line(oct(29, 23, 59, 59), "a"), line(oct(31, 8, 0, 0), "b"), line(oct(31, 9, 0, 0), "c")]), "2026-10-29-1.log.gz=a| latest.log=b|c|")

    // Yesterday's file at the start, then today's lines at midnight.
    var dir = folder()
    yesterday(dir)
    check(after(dir, [line(start(), "new"), line(oct(30, 0, 0, 1), "next")]), "2026-10-28-1.log.gz=old| 2026-10-29-1.log.gz=new| latest.log=next|")

    // Lines in separate writes roll the same, and a clock set back doesn't roll.
    dir = folder()
    var file = LogFile.open(dir, start(), Zone.fixed(OFFSET))!
    file.write([line(oct(29, 23, 0, 0), "a")])!
    file.write([line(oct(30, 0, 30, 0), "b")])!
    file.write([line(oct(29, 23, 30, 0), "c")])!
    for path in file.take_archived() {
        compress_archive(path)!
    }
    check(show(dir), "2026-10-29-1.log.gz=a| latest.log=b|c|")
    remove_dir_all(dir)!
}

// The file's own thread: a `Log` writes each line to the console and latest.log, archives the
// day before's file, compresses it on another thread, and waits for both as it closes.
fn thread() {
    let dir = folder()
    let now = unsafe { Timestamp.now() }
    let two_days_ago = Timestamp { unix_ms: now.unix_ms - 2 * 86400000 }
    put(dir, "latest.log", "old\n", two_days_ago)
    var out = unsafe { Log.open(dir, now) }
    out.log("test", Level.Info, "one")
    var other = out.share()
    other.log("other", Level.Warn, "two")
    out.close()
    let names = list(dir)!
    check("{names.len()}", "2")
    check(names[0], "{Zone.local().day_name(two_days_ago)}-1.log.gz")
    let text = String.from_utf8(read("{dir}/latest.log")!)!
    if not text.contains("] [test/INFO]: one\n[") or not text.ends_with("] [other/WARN]: two\n") {
        panic("latest.log holds {text}")
    }
    remove_dir_all(dir)!
}

fn main() {
    starts()
    numbers()
    midnight()
    thread()
    println("ok")
}
