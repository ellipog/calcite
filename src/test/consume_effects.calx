/// Tests of `world.consume_effects` (D518): a totem of undying's death effects, every effect
/// cleared and three given; an effect given at a probability, which must be from 0 to 1; effects
/// taken off by name and by list, a tag of them unknown; a random teleport within 16 or what's
/// given, which must be more than 0; a sound by name and made in place; and a list with what isn't
/// a consume effect none, and a protection without death effects none of them.
module test.consume_effects

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import world.consume_effects.{ConsumeEffect, death_effects, read_consume_effects}
import world.effects.{effect_id}

fn check(got: String, want: String, what: str) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn snbt(text: str) -> Tag {
    return match parse(String(text)) {
        ok(t) => t,
        err(e) => panic("the SNBT: {e}"),
    }
}

// What `effects` are, each by its kind and what it holds; `none` where they didn't read.
fn shown(effects: List<ConsumeEffect>?) -> String {
    let list = effects else return String("none")
    var out = String()
    for e in list {
        var one = String()
        match e {
            ConsumeEffect.Apply(given, p) => {
                var each = String()
                for g in given {
                    each = "{each}{g.id}:{g.amplifier()}/{g.duration()},"
                }
                one = "apply[{each}]@{p}"
            },
            ConsumeEffect.Remove(ids) => {
                var each = String()
                for id in ids {
                    each = "{each}{id},"
                }
                one = "remove[{each}]"
            },
            ConsumeEffect.ClearAll => one = String("clear"),
            ConsumeEffect.Teleport(d) => one = "teleport {d}",
            ConsumeEffect.Sound(s) => one = "sound {s}",
            ConsumeEffect.Unknown(what) => one = "unknown {what}",
        }
        out = "{out}{one}; "
    }
    return out
}

fn main() {
    let regeneration = effect_id(String("minecraft:regeneration")) ?? 0
    let absorption = effect_id(String("minecraft:absorption")) ?? 0
    let fire = effect_id(String("minecraft:fire_resistance")) ?? 0
    let poison = effect_id(String("minecraft:poison")) ?? 0
    let wither = effect_id(String("minecraft:wither")) ?? 0
    check(shown(some(death_effects(snbt("\{death_effects:[\{type:\"minecraft:clear_all_effects\"\},\{type:\"minecraft:apply_effects\",effects:[\{id:\"minecraft:regeneration\",amplifier:1,duration:900,show_icon:1b\},\{id:\"minecraft:absorption\",amplifier:1,duration:100,show_icon:1b\},\{id:\"minecraft:fire_resistance\",duration:800,show_icon:1b\}]\}]\}")))), "clear; apply[{regeneration}:1/900,{absorption}:1/100,{fire}:0/800,]@1.0; ", "a totem's death effects")
    check(shown(read_consume_effects(snbt("[\{type:\"apply_effects\",effects:[\{id:\"minecraft:poison\",duration:100\}],probability:0.5f\}]"))), "apply[{poison}:0/100,]@0.5; ", "an effect at a probability")
    check(shown(read_consume_effects(snbt("[\{type:\"apply_effects\",effects:[\{id:\"minecraft:poison\",duration:100\}],probability:1.5f\}]"))), "none", "a probability over 1")
    check(shown(read_consume_effects(snbt("[\{type:\"remove_effects\",effects:\"minecraft:poison\"\},\{type:\"remove_effects\",effects:[\"minecraft:poison\",\"minecraft:wither\"]\},\{type:\"remove_effects\",effects:\"#minecraft:bad\"\}]"))), "remove[{poison},]; remove[{poison},{wither},]; unknown The mob effect tag #minecraft:bad of a remove_effects consume effect; ", "effects taken off")
    check(shown(read_consume_effects(snbt("[\{type:\"teleport_randomly\"\},\{type:\"teleport_randomly\",diameter:8.0f\}]"))), "teleport 16.0; teleport 8.0; ", "teleports")
    check(shown(read_consume_effects(snbt("[\{type:\"teleport_randomly\",diameter:0.0f\}]"))), "none", "a teleport within nothing")
    check(shown(read_consume_effects(snbt("[\{type:\"play_sound\",sound:\"minecraft:entity.generic.eat\"\},\{type:\"play_sound\",sound:\{sound_id:\"minecraft:block.bell.use\"\}\}]"))), "sound minecraft:entity.generic.eat; sound minecraft:block.bell.use; ", "sounds")
    check(shown(read_consume_effects(snbt("[\{type:\"clear_all_effects\"\},\{type:\"minecraft:dance\"\}]"))), "none", "what isn't a consume effect")
    check(shown(some(death_effects(snbt("\{\}")))), "", "a protection without death effects")
    println("ok")
}
