/// Checks the saved data a world has from its start, as vanilla's `computeIfAbsent` makes it and
/// marks it to be saved where there's no file, or one that can't be read (CAL-170): the weather,
/// the clocks, the game rules, the stopwatches and a level's raids, each fresh and marked, and as
/// read from a file, unmarked but where vanilla marks it; the game rules filled in and taken out
/// as `GameRules` does, and the raids' tick counted, marking them every 200.
module test.fresh_data

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.clocks.{Clocks}
import world.game_rule_map.{GameRuleMap}
import world.raids.{Raids}
import world.stopwatches.{Stopwatches}
import world.weather.{Weather}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

// A saved data file's root, its `data` the compound of `fields`.
fn root_of(fields: JavaHashMap<String, Tag>) -> JavaHashMap<String, Tag> {
    var root = JavaHashMap<String, Tag>()
    root.insert(String("data"), Tag.Compound(fields.copy()))
    return root
}

// A packed value's compound.
fn fields_of(t: Tag) -> JavaHashMap<String, Tag> {
    return match t {
        Tag.Compound(m) => m.copy(),
        _ => panic("not packed as a compound"),
    }
}

// What `key` of a packed value is, as SNBT, or `-` where it has none.
fn at(fields: JavaHashMap<String, Tag>, key: str) -> String {
    if not fields.contains(key) {
        return String("-")
    }
    return fields[key].to_snbt()
}

fn weather_and_clocks() {
    check("{Weather.fresh().dirty}", "true", "fresh weather is marked")
    var lines = List<Entry>()
    let unread = Weather.load(JavaHashMap<String, Tag>(), mut lines)
    check("{unread.dirty}", "true", "weather that can't be read is made afresh, marked")
    var f = JavaHashMap<String, Tag>()
    f.insert(String("clear_weather_time"), Tag.Int(5))
    f.insert(String("rain_time"), Tag.Int(100))
    f.insert(String("thunder_time"), Tag.Int(200))
    f.insert(String("raining"), Tag.Byte(1))
    f.insert(String("thundering"), Tag.Byte(0))
    lines.clear()
    check("{Weather.load(root_of(f), mut lines).dirty}", "false", "weather read isn't marked")
    check(shown(lines), "", "weather read logs nothing")

    let names: List<Identifier> = [Identifier { namespace: "minecraft", path: "overworld" }]
    check("{Clocks.fresh(names).dirty}", "true", "fresh clocks are marked")
    check("{Clocks.new(names).dirty}", "false", "new clocks aren't, till they're asked for")
    lines.clear()
    check("{Clocks.load(names, JavaHashMap<String, Tag>(), mut lines).dirty}", "true", "clocks that can't be read are made afresh, marked")
    var c = JavaHashMap<String, Tag>()
    var state = JavaHashMap<String, Tag>()
    state.insert(String("total_ticks"), Tag.Long(17))
    c.insert(String("minecraft:overworld"), Tag.Compound(state))
    lines.clear()
    check("{Clocks.load(names, root_of(c), mut lines).dirty}", "false", "clocks read aren't marked")
}

fn game_rules() {
    // A new world's: every rule its features enable, at its default, marked.
    let fresh = GameRuleMap.fresh(false)
    let rules = fields_of(fresh.pack())
    check("{rules.len()} {fresh.dirty}", "58 true", "a new world's rules")
    check("{at(rules, "minecraft:fire_spread_radius_around_player")} {at(rules, "minecraft:keep_inventory")} {at(rules, "minecraft:respawn_radius")} {at(rules, "minecraft:raids")}", "128 0b 10 1b", "some defaults")
    check(at(rules, "minecraft:max_minecart_speed"), "-", "the minecart rule without its feature")
    let with_minecarts = fields_of(GameRuleMap.fresh(true).pack())
    check("{with_minecarts.len()} {at(with_minecarts, "minecraft:max_minecart_speed")}", "59 8", "the minecart rule with minecart_improvements")

    // All of them read: nothing to save.
    let whole = GameRuleMap.load(rules.copy(), false)
    check("{whole.dirty} {fields_of(whole.pack()).len()}", "false 58", "every rule read")

    // One missing, one its codec can't read, one out of its range, one the registry hasn't, and
    // the minecart rule without its feature: each set or taken out as `GameRules` makes them,
    // which marks them.
    var some_rules = rules.copy()
    _ = some_rules.remove(String("minecraft:pvp"))
    some_rules.insert(String("minecraft:keep_inventory"), Tag.Str(String("yes")))
    some_rules.insert(String("minecraft:random_tick_speed"), Tag.Int(-1))
    some_rules.insert(String("minecraft:not_a_rule"), Tag.Byte(1))
    some_rules.insert(String("minecraft:max_minecart_speed"), Tag.Int(20))
    some_rules.insert(String("minecraft:max_entity_cramming"), Tag.Long(7))
    let mended = GameRuleMap.load(some_rules, false)
    let out = fields_of(mended.pack())
    check("{mended.dirty} {out.len()}", "true 58", "rules mended")
    check("{at(out, "minecraft:pvp")} {at(out, "minecraft:keep_inventory")} {at(out, "minecraft:random_tick_speed")} {at(out, "minecraft:not_a_rule")} {at(out, "minecraft:max_minecart_speed")} {at(out, "minecraft:max_entity_cramming")}", "1b 0b 3 - - 7", "each mended")

    // Only the minecart rule missing, with its feature on: it's added.
    let added = GameRuleMap.load(rules.copy(), true)
    check("{added.dirty} {at(fields_of(added.pack()), "minecraft:max_minecart_speed")}", "true 8", "the minecart rule added")
}

fn stopwatches() {
    let fresh = Stopwatches.fresh()
    check("{fresh.dirty} {fresh.pack(0).to_snbt()}", String(#"true {stopwatches:{}}"#), "fresh stopwatches")
    var saved = JavaHashMap<String, Tag>()
    var each = JavaHashMap<String, Tag>()
    each.insert(String("minecraft:race"), Tag.Long(1234))
    saved.insert(String("stopwatches"), Tag.Compound(each))
    var lines = List<Entry>()
    let read = Stopwatches.load(root_of(saved), mut lines)
    check("{read.dirty} {read.pack(0).to_snbt()} {shown(lines)}", String(#"false {stopwatches:{"minecraft:race":1234L}} "#), "stopwatches read")
    lines.clear()
    let unread = Stopwatches.load(root_of(JavaHashMap<String, Tag>()), mut lines)
    check("{unread.dirty} {shown(lines)}", String(#"true [Failed to parse saved data for 'SavedDataType[minecraft:stopwatches]': No key stopwatches in MapLike[{}]]"#), "stopwatches without their map")
}

fn raids() {
    var fresh = Raids.fresh()
    check("{fresh.dirty} {fresh.pack().to_snbt()}", String(#"true {next_id:1,tick:0}"#), "fresh raids")
    // Counted each tick, marked every 200.
    fresh.dirty = false
    for _ in 0..199 {
        fresh.tick()
    }
    check("{fresh.dirty} {fresh.ticks}", "false 199", "199 ticks")
    fresh.tick()
    check("{fresh.dirty} {fresh.ticks}", "true 200", "the 200th")

    // Read, the raids kept as they were.
    var saved = JavaHashMap<String, Tag>()
    var raid = JavaHashMap<String, Tag>()
    raid.insert(String("id"), Tag.Int(3))
    saved.insert(String("raids"), Tag.List([Tag.Compound(raid)]))
    saved.insert(String("next_id"), Tag.Int(4))
    saved.insert(String("tick"), Tag.Int(5000))
    var lines = List<Entry>()
    let read = Raids.load(root_of(saved), mut lines)
    let packed = fields_of(read.pack())
    check("{read.dirty} {at(packed, "raids")} {at(packed, "next_id")} {at(packed, "tick")} {shown(lines)}", String(#"false [{id:3}] 4 5000 "#), "raids read")

    // Without the tick: vanilla's error, and fresh ones.
    var short = JavaHashMap<String, Tag>()
    short.insert(String("next_id"), Tag.Int(4))
    lines.clear()
    let unread = Raids.load(root_of(short), mut lines)
    check("{unread.dirty} {unread.next_id} {shown(lines)}", String(#"true 1 [Failed to parse saved data for 'SavedDataType[minecraft:raids]': No key tick in MapLike[{next_id:4}]]"#), "raids without their tick")
}

fn main() {
    weather_and_clocks()
    game_rules()
    stopwatches()
    raids()
    println("ok")
}
