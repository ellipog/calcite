/// Checks `world.weather`, `world.clocks` and `world.border` (CAL-105): each read from its saved
/// data as its codec reads it, with vanilla's errors in its order, written back, and ticked; the
/// weather's draws and game events, the clocks' rates, and a moving border's steps; and each
/// level's random as `level-random-seed` seeds it, as the rig's agent seeds vanilla's (D311), and
/// what it writes to the RNG tape (D312).
module test.world_state

import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import random.taped.{TapedRandom}
import resources.identifier.{Identifier}
import server.log.{Entry}
import server.play.{level_random_seed}
import world.border.{Border, BorderSettings, max_size}
import world.clocks.{Clocks}
import world.weather.{RAIN_LEVEL_CHANGE, START_RAINING, STOP_RAINING, THUNDER_LEVEL_CHANGE, Weather, WeatherEvent, WeatherLevels, advance, joining}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn id(text: String) -> Identifier {
    return match Identifier.parse(text) {
        ok(i) => i,
        err(e) => panic("{text}: {e}"),
    }
}

fn shown(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("[{e.message}]")
    }
    return out
}

fn events(list: List<WeatherEvent>) -> String {
    var out = String()
    for e in list {
        out.push_str("{e.event}:{e.param}{if e.everyone { "*" } else { "" }} ")
    }
    return out
}

// A saved data file's root, its `data` the compound of `fields`.
fn root_of(fields: JavaHashMap<String, Tag>) -> JavaHashMap<String, Tag> {
    var root = JavaHashMap<String, Tag>()
    root.insert(String("data"), Tag.Compound(fields.copy()))
    return root
}

fn snbt(fields: JavaHashMap<String, Tag>) -> String {
    return Tag.Compound(fields.copy()).to_snbt()
}

fn weather_read() {
    var f = JavaHashMap<String, Tag>()
    f.insert(String("clear_weather_time"), Tag.Int(5))
    f.insert(String("rain_time"), Tag.Int(100))
    f.insert(String("thunder_time"), Tag.Long(200))
    f.insert(String("raining"), Tag.Byte(1))
    f.insert(String("thundering"), Tag.Double(0.0))
    var lines = List<Entry>()
    let w = Weather.load(root_of(f), mut lines)
    check(shown(lines), "", "a whole weather's lines")
    check("{w.clear_weather_time} {w.rain_time} {w.thunder_time} {w.raining} {w.thundering} {w.dirty}", "5 100 200 true false false", "a whole weather")
    // Written back, it reads the same.
    let packed = match w.pack() {
        Tag.Compound(m) => m,
        _ => panic("the weather isn't packed as a compound"),
    }
    let again = Weather.load(root_of(packed), mut lines)
    check(shown(lines), "", "the packed weather's lines")
    check("{again.clear_weather_time} {again.rain_time} {again.thunder_time} {again.raining} {again.thundering}", "5 100 200 true false", "the packed weather")

    // Two fields wrong: the record codec's errors, the last field's first, and a new weather.
    var bad = JavaHashMap<String, Tag>()
    bad.insert(String("clear_weather_time"), Tag.Int(0))
    bad.insert(String("thunder_time"), Tag.Int(0))
    bad.insert(String("raining"), Tag.Byte(0))
    bad.insert(String("thundering"), Tag.Str(String("yes")))
    lines.clear()
    let fresh = Weather.load(root_of(bad), mut lines)
    check(shown(lines), "[Failed to parse saved data for 'SavedDataType[minecraft:weather]': Not a number; No key rain_time in MapLike[{snbt(bad)}]]", "a weather with two fields wrong")
    check("{fresh.rain_time} {fresh.raining}", "0 false", "the weather that replaces it")

    // No `data`.
    lines.clear()
    _ = Weather.load(JavaHashMap<String, Tag>(), mut lines)
    check(shown(lines), "[Failed to parse saved data for 'SavedDataType[minecraft:weather]': Not a map: null]", "a weather without data")
}

fn weather_tick() {
    // A new world's weather: the first tick draws the thunder's delay, then the rain's.
    var w = Weather()
    var levels = WeatherLevels()
    var random = LegacyRandom.new(1)
    let first = advance(mut w, mut levels, mut random, true)
    var drawn = LegacyRandom.new(1)
    let thunder = drawn.next_int_below(180000 - 12000 + 1) + 12000
    let rain = drawn.next_int_below(180000 - 12000 + 1) + 12000
    check("{w.thunder_time} {w.rain_time} {w.dirty} {events(first)}", "{thunder} {rain} true ", "a new world's first tick")

    // With `advance_weather` off, nothing's drawn and the times stand.
    w.dirty = false
    let off = advance(mut w, mut levels, mut random, false)
    check("{w.thunder_time} {w.rain_time} {w.dirty} {events(off)}", "{thunder} {rain} false ", "a tick without advance_weather")

    // The rain starts as its time runs out: its level goes up a hundredth a tick, each change sent
    // to the level's players, until it's past 0.2, when everyone's told it started.
    w = Weather { rain_time: 1, thunder_time: 50000 }
    levels = WeatherLevels()
    var level = 0.0f32
    var ticks = 0
    var started = 0
    while ticks < 40 {
        let e = advance(mut w, mut levels, mut random, true)
        ticks += 1
        let was = level
        level = level + 0.01f32
        var want = "{RAIN_LEVEL_CHANGE}:{level} "
        if f64(was) <= 0.2 and f64(level) > 0.2 {
            want.push_str("{START_RAINING}:0.0* {RAIN_LEVEL_CHANGE}:{level}* {THUNDER_LEVEL_CHANGE}:0.0* ")
            started = ticks
        }
        check(events(e), want, "tick {ticks} of the rain starting")
    }
    // Once it's raining, the rain's time is drawn again, as its duration.
    check("{w.raining} {started > 0} {levels.raining()} {w.rain_time >= 12000 and w.rain_time <= 24000}", "true true true true", "the rain")
    check(events(joining(levels)), "{START_RAINING}:0.0 {RAIN_LEVEL_CHANGE}:{level} {THUNDER_LEVEL_CHANGE}:0.0 ", "what a player joining in the rain is told")

    // Clear weather set by a command stops it at once, and holds the rain and thunder off. Once
    // it's over, their times are 1, so they start again the tick after, as vanilla's do.
    w.clear_weather_time = 100
    w.thundering = true
    _ = advance(mut w, mut levels, mut random, true)
    check("{w.clear_weather_time} {w.raining} {w.thundering} {w.rain_time} {w.thunder_time}", "99 false false 0 0", "clear weather")

    // As the rain's level falls back under 0.2, everyone's told it stopped.
    var stopped = false
    for _ in 0..40 {
        for e in advance(mut w, mut levels, mut random, true) {
            if e.event == STOP_RAINING {
                stopped = true
            }
        }
    }
    check("{stopped} {levels.raining()}", "true false", "the rain stopping")
    check(events(joining(levels)), "", "what a player joining in clear weather is told")
}

fn level_seeds() {
    // With `level-random-seed=1103`, the Overworld's random draws what vanilla's drew with the
    // rig's agent at seed 1103, as a session's tape has it: at game time 0, through
    // `UniformInt.sample`, its thunder's delay and then its rain's, which a new world's first tick
    // makes 48043 and 120668.
    let overworld = level_random_seed(1103, id(String("minecraft:overworld")))
    var r = LegacyRandom.new(overworld)
    check("{overworld} {r.next(31)} {r.next(31)}", "9027772975569123898 1530525153 353078769", "the Overworld's first draws")
    var w = Weather()
    var levels = WeatherLevels()
    var drawn = LegacyRandom.new(overworld)
    _ = advance(mut w, mut levels, mut drawn, true)
    check("{w.thunder_time} {w.rain_time}", "48043 120668", "the Overworld's first tick's weather")
    // `mixStafford13(base ^ name.hashCode())`, as worked out apart from either server.
    let nether = level_random_seed(1103, id(String("minecraft:the_nether")))
    let end = level_random_seed(0, id(String("minecraft:the_end")))
    let below = level_random_seed(-1, id(String("minecraft:overworld")))
    check("{nether} {end} {below}", "3060800974469652627 7016031882033859372 -7902564675308560684", "other levels' seeds")

    // A level's random draws what a `LegacyRandom` does, every kind of number (D312).
    var taped = TapedRandom.new(overworld)
    var plain = LegacyRandom.new(overworld)
    var differ = 0
    for _ in 0..200 {
        if taped.next_int_below(168001) != plain.next_int_below(168001) or taped.next_int_below(64) != plain.next_int_below(64) or taped.next_int() != plain.next_int() or taped.next_long() != plain.next_long() or taped.next_boolean() != plain.next_boolean() or taped.next_float() != plain.next_float() or taped.next_double() != plain.next_double() or taped.next_gaussian() != plain.next_gaussian() {
            differ += 1
        }
    }
    check("{differ} {taped.taping()} [{taped.take_lines()}]", "0 false []", "a level's random, not taping")
    // Taping, each value it draws is a line, at the game time it's set to, as on vanilla's tape.
    var tape = TapedRandom.new(overworld)
    tape.tape(String("minecraft:overworld"))
    let thunder = tape.next_int_between(12000, 180000)
    tape.time = 5
    let rain = tape.next_int_between(12000, 180000)
    check("{thunder} {rain} [{tape.take_lines()}] [{tape.take_lines()}]", "48043 120668 [minecraft:overworld 0 31 1530525153\nminecraft:overworld 5 31 353078769\n] []", "a level's random, taping")
}

fn clocks() {
    let names: List<Identifier> = [id(String("minecraft:overworld")), id(String("minecraft:the_end"))]
    var c = Clocks.new(names)
    c.clocks[1].rate = 0.5f32
    for _ in 0..3 {
        c.tick(true)
    }
    check("{c.clocks[0].total_ticks} {c.clocks[1].total_ticks} {c.clocks[1].partial_tick} {c.dirty}", "3 1 0.5 true", "three ticks")
    c.dirty = false
    c.tick(false)
    check("{c.clocks[0].total_ticks} {c.dirty}", "3 false", "a tick without advance_time")
    c.clocks[0].paused = true
    c.tick(true)
    check("{c.clocks[0].total_ticks} {c.clocks[1].total_ticks}", "3 2", "a paused clock's tick")
    var rates = String()
    for u in c.updates(true) {
        rates.push_str("{u.clock}:{u.total_ticks}:{u.rate} ")
    }
    check(rates, "0:3:0.0 1:2:0.5 ", "the full sync, one clock paused")
    rates = String()
    for u in c.updates(false) {
        rates.push_str("{u.rate} ")
    }
    check(rates, "0.0 0.0 ", "the full sync without advance_time")
    check("{c.total_ticks(some(1))} {c.total_ticks(none)}", "2 0", "a clock's ticks")

    // Read: a key without a namespace is vanilla's, and what's left out is a default.
    var saved = JavaHashMap<String, Tag>()
    var overworld = JavaHashMap<String, Tag>()
    overworld.insert(String("total_ticks"), Tag.Long(7))
    saved.insert(String("overworld"), Tag.Compound(overworld))
    var end = JavaHashMap<String, Tag>()
    end.insert(String("total_ticks"), Tag.Int(3))
    end.insert(String("rate"), Tag.float(2.0f32))
    end.insert(String("paused"), Tag.Byte(1))
    saved.insert(String("minecraft:the_end"), Tag.Compound(end))
    var lines = List<Entry>()
    let read = Clocks.load(names, root_of(saved), mut lines)
    check(shown(lines), "", "the clocks' lines")
    check("{read.clocks[0].total_ticks} {read.clocks[0].rate} {read.clocks[1].total_ticks} {read.clocks[1].rate} {read.clocks[1].paused}", "7 1.0 3 2.0 true", "the clocks read")

    // Written back, only what isn't a default is kept, and it reads the same.
    let packed = match read.pack() {
        Tag.Compound(m) => m,
        _ => panic("the clocks aren't packed as a compound"),
    }
    let again = Clocks.load(names, root_of(packed), mut lines)
    check(shown(lines), "", "the packed clocks' lines")
    check("{again.clocks[0].total_ticks} {again.clocks[1].rate} {again.clocks[1].paused}", "7 2.0 true", "the packed clocks")

    // A clock with a field that's wrong is read with its default, one the registry hasn't is left
    // out, and both are in the missed input. `moon` comes before `overworld` in a HashMap, so the
    // overworld's error is first.
    var wrong = JavaHashMap<String, Tag>()
    var bad_overworld = JavaHashMap<String, Tag>()
    bad_overworld.insert(String("total_ticks"), Tag.Long(9))
    bad_overworld.insert(String("partial_tick"), Tag.Str(String("x")))
    wrong.insert(String("overworld"), Tag.Compound(bad_overworld))
    var moon = JavaHashMap<String, Tag>()
    moon.insert(String("total_ticks"), Tag.Long(1))
    wrong.insert(String("moon"), Tag.Compound(moon))
    lines.clear()
    let partly = Clocks.load(names, root_of(wrong), mut lines)
    check(shown(lines), "[Failed to parse saved data for 'SavedDataType[minecraft:world_clocks]': Not a number; Failed to get element minecraft:moon from registry minecraft:world_clock missed input: {snbt(wrong)}]", "clocks partly wrong")
    check("{partly.clocks[0].total_ticks} {partly.clocks[0].partial_tick} {partly.clocks[1].total_ticks}", "9 0.0 0", "the clocks read of them")

    // A rate that isn't over 0 is wrong too.
    var slow = JavaHashMap<String, Tag>()
    var negative = JavaHashMap<String, Tag>()
    negative.insert(String("total_ticks"), Tag.Long(4))
    negative.insert(String("rate"), Tag.float(-1.0f32))
    slow.insert(String("the_end"), Tag.Compound(negative))
    lines.clear()
    let slowed = Clocks.load(names, root_of(slow), mut lines)
    check(shown(lines), "[Failed to parse saved data for 'SavedDataType[minecraft:world_clocks]': Value must be positive: -1.0 missed input: {snbt(slow)}]", "a rate under 0")
    check("{slowed.clocks[1].total_ticks} {slowed.clocks[1].rate}", "4 1.0", "the clock with it")
}

// A border's saved fields, centered at `center_x`, -4, moving from 100 to 50 over 10 ticks,
// with its `lerp_target` if `target`.
fn border_fields(center_x: f64, target: bool) -> JavaHashMap<String, Tag> {
    var f = JavaHashMap<String, Tag>()
    f.insert(String("center_x"), Tag.Double(center_x))
    f.insert(String("center_z"), Tag.Double(-4.0))
    f.insert(String("damage_per_block"), Tag.Double(0.2))
    f.insert(String("safe_zone"), Tag.Double(5.0))
    f.insert(String("warning_blocks"), Tag.Int(5))
    f.insert(String("warning_time"), Tag.Int(15))
    f.insert(String("size"), Tag.Double(100.0))
    f.insert(String("lerp_time"), Tag.Long(10))
    if target {
        f.insert(String("lerp_target"), Tag.Double(50.0))
    }
    return f
}

fn border() {
    check("{max_size()}", "5.9999968E7", "the largest border")
    let f = border_fields(10.5, true)
    var lines = List<Entry>()
    let settings = BorderSettings.load(root_of(f), mut lines)
    check(shown(lines), "", "a border's lines")

    // Set up at game time 1000, moving from 100 to 50 over 10 ticks.
    var b = Border.new(settings, 1000, 29999984)
    check("{b.size} {b.lerp_time()} {b.lerp_target()} {b.dirty} {b.warning_time}", "100.0 10 50.0 true 15", "a moving border set up")
    b.tick()
    check("{b.size} {b.previous} {b.lerp_time()}", "95.0 100.0 9", "its first step")
    check("{b.min_x()} {b.max_x()} {b.min_z()} {b.max_z()}", "-39.5 60.5 -54.0 46.0", "its edges after a step, from its size a tick ago")
    for _ in 0..9 {
        b.tick()
    }
    check("{b.size} {b.moving} {b.lerp_time()} {b.lerp_target()}", "50.0 false 0 50.0", "the border at rest")
    check("{b.min_x()} {b.max_x()} {b.within(35.4, 0.0)} {b.within(35.5, 0.0)} {b.within(-14.5, -29.0)}", "-14.5 35.5 true false true", "the border's edges at rest")
    let p = b.packet()
    check("{p.center_x} {p.center_z} {p.old_size} {p.new_size} {p.lerp_time} {p.absolute_max_size} {p.warning_blocks} {p.warning_time}", "10.5 -4.0 50.0 50.0 0 29999984 5 15", "its packet")

    // Written back, it reads as it is now.
    let packed = match b.pack() {
        Tag.Compound(m) => m,
        _ => panic("the border isn't packed as a compound"),
    }
    let again = BorderSettings.load(root_of(packed), mut lines)
    check(shown(lines), "", "the packed border's lines")
    check("{again.size} {again.lerp_time} {again.lerp_target} {again.center_x}", "50.0 0 50.0 10.5", "the packed border")

    // A new world's, and edges within the world's reach.
    let wide = Border.new(BorderSettings.default(), 0, 1000)
    check("{wide.size} {wide.min_x()} {wide.max_z()} {wide.dirty}", "5.9999968E7 -1000.0 1000.0 true", "a new world's border")

    // A center out of range, and a field missing: the last field's error first.
    let bad = border_fields(30000000.0, false)
    lines.clear()
    let fallen = BorderSettings.load(root_of(bad), mut lines)
    check(shown(lines), "[Failed to parse saved data for 'SavedDataType[minecraft:world_border]': No key lerp_target in MapLike[{snbt(bad)}]; Value 3.0E7 outside of range [-2.9999984E7:2.9999984E7]]", "a border with two fields wrong")
    check("{fallen.size} {fallen.center_x}", "5.9999968E7 0.0", "the border that replaces it")
}

fn main() {
    weather_read()
    weather_tick()
    level_seeds()
    clocks()
    border()
    println("ok")
}
