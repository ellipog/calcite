/// Checks `world.crystal` (D589): an end crystal read as a spike saves one, 2 by 2, its bottom
/// shown and no beam, its values their defaults, saved back the same; one with a beam and no
/// bottom read and saved with them; its count drawn below 100,000; and its hurt, which takes it at
/// once, exploding where it wasn't an explosion, but not where it's gone, invulnerable, burnt or
/// hit by a dragon.
module test.crystal

import nbt.tag.{Tag}
import server.log.{Entry}
import world.crystal.{EndCrystal}
import world.damage.{DamageTypes}
import world.entity_data.{CRYSTAL_BEAM, CRYSTAL_BOTTOM}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn compound(t: Tag) -> JavaHashMap<String, Tag> {
    let Tag.Compound(m) = t else panic("not a compound")
    return m.copy()
}

// An end crystal as a spike at x 42, 75 high, saves one: its place, a block over its bedrock, its
// UUID, and its bottom shown, the rest as `saveWithoutId` puts it.
fn spiked() -> JavaHashMap<String, Tag> {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String("minecraft:end_crystal")))
    m.insert(String("Pos"), Tag.List([Tag.Double(42.5), Tag.Double(76.0), Tag.Double(0.5)]))
    m.insert(String("Motion"), Tag.List([Tag.Double(0.0), Tag.Double(0.0), Tag.Double(0.0)]))
    m.insert(String("Rotation"), Tag.List([Tag.Float(0.0f32), Tag.Float(0.0f32)]))
    m.insert(String("fall_distance"), Tag.Double(0.0))
    m.insert(String("Fire"), Tag.Short(0i16))
    m.insert(String("Air"), Tag.Short(300i16))
    m.insert(String("OnGround"), Tag.Byte(0i8))
    m.insert(String("Invulnerable"), Tag.Byte(0i8))
    m.insert(String("PortalCooldown"), Tag.Int(0))
    m.insert(String("UUID"), Tag.IntArray([1, 2, 3, 4]))
    m.insert(String("ShowBottom"), Tag.Byte(1i8))
    return m
}

fn read(id: i32, m: JavaHashMap<String, Tag>) -> EndCrystal {
    var lines = List<Entry>()
    let c = EndCrystal.loaded(id, i64(id) * 31, m, mut lines) else panic("not read")
    check(lines.is_empty(), "nothing logged")
    return c
}

fn main() {
    let types = DamageTypes.vanilla()

    // Read as a spike saves it: 2 by 2, its eyes 1.7 up, its bottom shown and no beam, both their
    // defaults, so a player coming to see it is sent none of its values.
    let c = read(5, spiked())
    check(c.body.width == 2.0f32 and c.body.height == 2.0f32 and c.body.eyes == 1.7f32, "2 by 2, its eyes 1.7 up")
    check(c.body.x == 42.5 and c.body.y == 76.0 and c.body.z == 0.5, "where it was saved")
    check(c.shows_bottom() and c.beam_target() == none, "its bottom shown, no beam")
    check(c.data.is_default(CRYSTAL_BEAM) and c.data.is_default(CRYSTAL_BOTTOM), "its values their defaults")
    check(c.data.pack_non_default() == none, "none of its values sent")
    check(c.time >= 0 and c.time < 100000, "its count below 100,000")
    check(c.saved() == Tag.Compound(spiked()), "saved back the same")

    // A beam at a block and no bottom, as a respawn's crystals have, read and saved with them.
    var beamed = spiked()
    beamed.insert(String("beam_target"), Tag.IntArray([0, 128, 0]))
    beamed.insert(String("ShowBottom"), Tag.Byte(0i8))
    let b = read(6, beamed)
    check(b.beam_target() == some((0, 128, 0)) and not b.shows_bottom(), "its beam and no bottom")
    check(not b.data.is_default(CRYSTAL_BEAM) and not b.data.is_default(CRYSTAL_BOTTOM), "its values not their defaults")
    let back = compound(b.saved())
    check(back["beam_target"] == Tag.IntArray([0, 128, 0]) and back["ShowBottom"] == Tag.Byte(0i8), "saved with them")

    // Its bottom shown where `ShowBottom` is missing, and no beam where it isn't three ints.
    var bare = spiked()
    _ = bare.remove("ShowBottom")
    bare.insert(String("beam_target"), Tag.IntArray([1, 2]))
    let d = read(7, bare)
    check(d.shows_bottom() and d.beam_target() == none, "its defaults where they're missing")

    // Hurt by cactus, gone at once, exploding; hurt again, nothing more.
    var hit = read(8, spiked())
    let first = hit.hurt(types, types.id("cactus"), false, false)
    check(first.gone and first.explodes and hit.body.removed, "gone, exploding")
    let again = hit.hurt(types, types.id("cactus"), false, false)
    check(not again.gone and not again.explodes, "nothing more once it's gone")

    // An explosion takes it without its own; fire, a dragon and its invulnerability don't.
    var blown = read(9, spiked())
    let boom = blown.hurt(types, types.id("explosion"), false, false)
    check(boom.gone and not boom.explodes, "an explosion takes it without its own")
    var burnt = read(10, spiked())
    check(not burnt.hurt(types, types.id("in_fire"), false, false).gone and not burnt.body.removed, "fire doesn't")
    var clawed = read(11, spiked())
    check(not clawed.hurt(types, types.id("mob_attack"), false, true).gone, "a dragon doesn't")
    var kept = spiked()
    kept.insert(String("Invulnerable"), Tag.Byte(1i8))
    var shielded = read(12, kept.copy())
    check(not shielded.hurt(types, types.id("cactus"), false, false).gone, "invulnerable to what doesn't bypass it")
    check(not shielded.hurt(types, types.id("player_attack"), false, false).gone, "or to a player")
    check(shielded.hurt(types, types.id("out_of_world"), false, false).gone, "but not to what does")
    // A player in creative mode breaks it all the same (D590).
    var built = read(13, kept)
    let broke = built.hurt(types, types.id("player_attack"), true, false)
    check(broke.gone and broke.explodes, "nor to a player in creative mode")
    println("ok")
}
