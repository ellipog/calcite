/// Tests of `world.natural`, natural spawning's draws and checks (D317), and of
/// `world.entity_facts`, the table they read of each entity type and block state.
module test.natural

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import world.entity_facts.{CREATURE, FAR, MONSTER, ON_GROUND, PEACEFUL, SUMMON, WATER_AMBIENT, categories, rules, state_spawn_facts, types}
import world.natural.{MobSettings, Rule, rule_of, slime_chunk, spawning_categories}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn compound(pairs: own List<(String, Tag)>) -> Tag {
    var m = JavaHashMap<String, Tag>()
    for (k, v) in pairs {
        m.insert(k.copy(), v.copy())
    }
    return Tag.Compound(m)
}

fn id(path: str) -> Identifier {
    return Identifier { namespace: "minecraft", path: String(path) }
}

// The table: every type and state, a zombie's facts, and every rule's method one Calcite knows
// or `Unknown`.
fn table() {
    let all = types()
    check("{all.len()} {categories().len()}", "161 8")
    // `minecraft:zombie` is a monster, summonable, not allowed in peaceful, and spawns on the
    // ground by `Monster.checkMonsterSpawnRules`.
    var zombie: usize? = none
    let names = rules()
    for i in 0..all.len() {
        if let r = all[i].rule {
            if names[usize.wrap(r)] == "Monster.checkMonsterSpawnRules" and all[i].half_width == 0.3f32 and all[i].height == 1.95f32 {
                zombie = some(i)
            }
        }
    }
    let z = all[zombie ?? 0]
    check("{z.category == MONSTER} {z.flags & SUMMON != 0} {z.flags & PEACEFUL != 0} {z.flags & FAR != 0} {z.placement == some(ON_GROUND)}", "true true false false true")
    var known = 0
    for name in names {
        if rule_of(name) != Rule.Unknown {
            known += 1
        }
    }
    check("{names.len()} {known}", "39 10")
    check("{state_spawn_facts().len()}", "35723")
}

// The categories that may spawn: monsters only where enemies may, creatures only every 400
// ticks, and none whose cap the chunks counted leave at nothing.
fn filtered() {
    check("{spawning_categories(true, false, 289)}", "[0, 2, 3, 4, 5, 6]")
    check("{spawning_categories(false, true, 289)}", "[1, 2, 3, 4, 5, 6]")
    // 57 chunks leave the categories of 5 at nothing, 5 * 57 / 289 being 0.
    check("{spawning_categories(true, true, 57)}", "[0, 1, 2, 6]")
    check("{spawning_categories(true, true, 0)}", "[]")
}

// A biome's `natural_mob_spawns`, as the registries keep it, over the empty default: overlay
// keeps the categories it doesn't name as they were.
fn settings() {
    let entity_types: List<Identifier> = [id("bat"), id("cow"), id("zombie")]
    let zombie = compound([(String("type"), Tag.Str(String("minecraft:zombie"))), (String("count"), Tag.Int(4)), (String("weight"), Tag.Int(95))])
    let uniform = compound([(String("type"), Tag.Str(String("minecraft:uniform"))), (String("min_inclusive"), Tag.Int(2)), (String("max_inclusive"), Tag.Int(3))])
    let cow = compound([(String("type"), Tag.Str(String("minecraft:cow"))), (String("count"), uniform), (String("weight"), Tag.Int(8))])
    let unknown = compound([(String("type"), Tag.Str(String("minecraft:nothing"))), (String("count"), Tag.Int(1)), (String("weight"), Tag.Int(1))])
    let by = compound([(String("monster"), Tag.List([zombie, unknown])), (String("creature"), Tag.List([cow]))])
    let argument = compound([(String("spawns_by_category"), by), (String("spawn_costs"), compound([]))])
    let entry = compound([(String("argument"), argument.copy()), (String("modifier"), Tag.Str(String("overlay")))])
    let s = MobSettings.empty().applied(entry, entity_types)
    let monsters = s.mobs(MONSTER)
    let creatures = s.mobs(CREATURE)
    check("{monsters.len()} {monsters[0].type_id} {monsters[0].weight} {creatures.len()} {creatures[0].type_id} {s.mobs(WATER_AMBIENT).len()}", "1 2 95 1 1 0")
    check("{monsters[0].same(monsters[0])} {monsters[0].same(creatures[0])}", "true false")
    // Overlaid again with only creatures, the monsters stay; overridden, they go.
    let creatures_only = compound([(String("spawns_by_category"), compound([(String("creature"), Tag.List([]))]))])
    let over = s.applied(compound([(String("argument"), creatures_only.copy()), (String("modifier"), Tag.Str(String("overlay")))]), entity_types)
    check("{over.mobs(MONSTER).len()} {over.mobs(CREATURE).len()}", "1 0")
    let replaced = s.applied(creatures_only, entity_types)
    check("{replaced.mobs(MONSTER).len()} {replaced.mobs(CREATURE).len()}", "0 0")
}

// Slime chunks, as `WorldgenRandom.seedSlimeChunk` seeds them, against `java.util.Random`'s
// `nextInt(10)` worked out by hand from the same seed: the chunks around the origin of seeds 0
// and 1103, and far out, where the formula's `int` products wrap.
fn slimes() {
    check(slimes_near(0), "-2,0 1,-3 2,-3 2,2")
    check(slimes_near(1103), "-3,-1 -3,2 -2,0 -1,3 1,0 2,-3 2,0 3,-4")
    check("{slime_chunk(100000, -1874997, 1103)} {slime_chunk(100002, -1874995, 1103)} {slime_chunk(46341, -46341, 1103)} {slime_chunk(100000, 3, 1103)} {slime_chunk(-70000, 25000, 1103)}", "true true true false false")
}

// The slime chunks of `seed` from -4 to 3 each way, `x` first.
fn slimes_near(seed: i64) -> String {
    var found = String()
    for cx in -4..4 {
        for cz in -4..4 {
            if slime_chunk(cx, cz, seed) {
                if not found.is_empty() {
                    found.push_str(" ")
                }
                found.push_str("{cx},{cz}")
            }
        }
    }
    return found
}

fn main() {
    table()
    filtered()
    settings()
    slimes()
    println("ok")
}
