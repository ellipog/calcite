/// Tests of `world.natural`, natural spawning's draws and checks (D317) and its caps (CAL-156),
/// and of `world.entity_facts`, the table they read of each entity type and block state.
module test.natural

import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import world.entity_facts.{AMBIENT, CREATURE, FAR, MISC, MONSTER, ON_GROUND, PEACEFUL, SUMMON, WATER_AMBIENT, categories, rules, state_spawn_facts, types}
import world.natural.{MobSettings, Rule, SpawnLevel, SpawnState, rule_of, slime_chunk, spawning_categories}
import world.spawners.{SpawnerPlayer}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn holds(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn compound(pairs: own List<(String, Tag)>) -> Tag {
    var m = JavaHashMap<String, Tag>()
    for (k, v) in pairs {
        m.insert(k.copy(), v.copy())
    }
    return Tag.Compound(m)
}

fn id(path: str) -> Identifier {
    return Identifier { namespace: "minecraft", path: String(path) }
}

// A level that says only whether players may be near a chunk: those with x below `far`.
struct Near {
    far: i32
}

impl SpawnLevel for Near {
    fn spawn_state(self, x: i32, y: i32, z: i32) -> u32 {
        _ = x + y + z
        return 0
    }

    fn surface(self, kind: i32, x: i32, z: i32) -> i32 {
        _ = kind + x + z
        return 0
    }

    fn biome(mut self, x: i32, y: i32, z: i32) -> i32 {
        _ = x + y + z
        return 0
    }

    fn noise_biome(self, qx: i32, qy: i32, qz: i32) -> i32 {
        _ = qx + qy + qz
        return 0
    }

    fn light(self, sky: bool, x: i32, y: i32, z: i32) -> i32 {
        _ = sky
        _ = x + y + z
        return 15
    }

    fn entities_tick(self, chunk_x: i32, chunk_z: i32) -> bool {
        _ = chunk_x + chunk_z
        return true
    }

    fn inhabited_at(self, chunk_x: i32, chunk_z: i32) -> i64? {
        _ = chunk_x + chunk_z
        return some(0)
    }

    fn players_near(mut self, chunk_x: i32, chunk_z: i32) -> bool {
        _ = chunk_z
        return chunk_x < self.far
    }
}

fn player(x: f64, z: f64, spectator: bool) -> SpawnerPlayer {
    return SpawnerPlayer { spectator: spectator, x: x, z: z }
}

fn nobody(chunks: i32) -> SpawnState {
    return SpawnState.new(chunks, List<SpawnerPlayer>())
}

// The table: every type and state, a zombie's facts, and every rule's method one Calcite knows
// or `Unknown`.
fn table() {
    let all = types()
    check("{all.len()} {categories().len()}", "161 8")
    // `minecraft:zombie` is a monster, summonable, not allowed in peaceful, and spawns on the
    // ground by `Monster.checkMonsterSpawnRules`.
    var zombie: usize? = none
    let names = rules()
    for i in 0..all.len() {
        if let r = all[i].rule {
            if names[usize.wrap(r)] == "Monster.checkMonsterSpawnRules" and all[i].half_width == 0.3f32 and all[i].height == 1.95f32 {
                zombie = some(i)
            }
        }
    }
    let z = all[zombie ?? 0]
    check("{z.category == MONSTER} {z.flags & SUMMON != 0} {z.flags & PEACEFUL != 0} {z.flags & FAR != 0} {z.placement == some(ON_GROUND)}", "true true false false true")
    var known = 0
    for name in names {
        if rule_of(name) != Rule.Unknown {
            known += 1
        }
    }
    check("{names.len()} {known}", "39 12")
    check("{state_spawn_facts().len()}", "35723")
}

// The categories that may spawn: monsters only where enemies may, creatures only every 400
// ticks, and none whose cap the chunks counted leave at nothing or the mobs counted reach.
fn filtered() {
    check("{spawning_categories(true, false, nobody(289))}", "[0, 2, 3, 4, 5, 6]")
    check("{spawning_categories(false, true, nobody(289))}", "[1, 2, 3, 4, 5, 6]")
    // 57 chunks leave the categories of 5 at nothing, 5 * 57 / 289 being 0.
    check("{spawning_categories(true, true, nobody(57))}", "[0, 1, 2, 6]")
    check("{spawning_categories(true, true, nobody(0))}", "[]")
    // Ten creatures over 289 chunks reach theirs, 10 * 289 / 289; nine don't. `MISC` isn't
    // counted.
    var level = Near { far: 100 }
    var state = nobody(289)
    for _ in 0..9 {
        state.count(mut level, CREATURE, 8.0, 8.0)
        state.count(mut level, MISC, 8.0, 8.0)
    }
    check("{spawning_categories(true, true, state)} {state.counts}", "[0, 1, 2, 3, 4, 5, 6] [0, 9, 0, 0, 0, 0, 0, 0]")
    state.count(mut level, CREATURE, 8.0, 8.0)
    check("{spawning_categories(true, true, state)}", "[0, 2, 3, 4, 5, 6]")
}

// The local caps: a category may spawn in a chunk where a player near it, within 128 blocks of
// its middle and not a spectator, has fewer of it near them than its most a chunk, or none
// counted; a mob counts near every player near its chunk; none are near a chunk with no players
// nearby.
fn local_caps() {
    var level = Near { far: 30 }
    let players: List<SpawnerPlayer> = [player(8.0, 8.0, false), player(328.0, 8.0, false), player(8.0, 8.0, true)]
    var state = SpawnState.new(289, players)
    holds(state.can_spawn_local(mut level, CREATURE, 0, 0), "a chunk near a player with none counted can't spawn creatures")
    for _ in 0..10 {
        state.after_spawn(mut level, CREATURE, 8.5, 8.5)
    }
    holds(not state.can_spawn_local(mut level, CREATURE, 0, 0), "a player with 10 creatures near them still lets them spawn")
    holds(state.can_spawn_local(mut level, AMBIENT, 0, 0), "a player's creatures stop bats spawning")
    // The chunk at 20, 0 is 320 blocks from the first player and none from the second, who has
    // none counted; the one at 10, 0, 160 blocks from both, is near neither.
    holds(state.can_spawn_local(mut level, CREATURE, 20, 0), "a chunk near a player with none counted can't spawn")
    holds(not state.can_spawn_local(mut level, CREATURE, 10, 0), "a chunk near no player can spawn")
    // A mob at 232, 8, in the chunk at 14, 0, is near the second player only.
    for _ in 0..10 {
        state.after_spawn(mut level, CREATURE, 232.0, 8.0)
    }
    holds(not state.can_spawn_local(mut level, CREATURE, 20, 0), "the second player's creatures don't count near them")
    // With players nearby only below chunk 30 across, the chunk at 30, 0 has none near it.
    let far: List<SpawnerPlayer> = [player(488.0, 8.0, false)]
    var lone = SpawnState.new(289, far)
    holds(not lone.can_spawn_local(mut level, CREATURE, 30, 0), "a chunk without players nearby can spawn")
    holds(lone.can_spawn_local(mut level, CREATURE, 29, 0), "a chunk with a player near it can't")
}

// A biome's `natural_mob_spawns`, as the registries keep it, over the empty default: overlay
// keeps the categories it doesn't name as they were.
fn settings() {
    let entity_types: List<Identifier> = [id("bat"), id("cow"), id("zombie")]
    let zombie = compound([(String("type"), Tag.Str(String("minecraft:zombie"))), (String("count"), Tag.Int(4)), (String("weight"), Tag.Int(95))])
    let uniform = compound([(String("type"), Tag.Str(String("minecraft:uniform"))), (String("min_inclusive"), Tag.Int(2)), (String("max_inclusive"), Tag.Int(3))])
    let cow = compound([(String("type"), Tag.Str(String("minecraft:cow"))), (String("count"), uniform), (String("weight"), Tag.Int(8))])
    let unknown = compound([(String("type"), Tag.Str(String("minecraft:nothing"))), (String("count"), Tag.Int(1)), (String("weight"), Tag.Int(1))])
    let by = compound([(String("monster"), Tag.List([zombie, unknown])), (String("creature"), Tag.List([cow]))])
    let argument = compound([(String("spawns_by_category"), by), (String("spawn_costs"), compound([]))])
    let entry = compound([(String("argument"), argument.copy()), (String("modifier"), Tag.Str(String("overlay")))])
    let s = MobSettings.empty().applied(entry, entity_types)
    let monsters = s.mobs(MONSTER)
    let creatures = s.mobs(CREATURE)
    check("{monsters.len()} {monsters[0].type_id} {monsters[0].weight} {creatures.len()} {creatures[0].type_id} {s.mobs(WATER_AMBIENT).len()}", "1 2 95 1 1 0")
    check("{monsters[0].same(monsters[0])} {monsters[0].same(creatures[0])}", "true false")
    // Overlaid again with only creatures, the monsters stay; overridden, they go.
    let creatures_only = compound([(String("spawns_by_category"), compound([(String("creature"), Tag.List([]))]))])
    let over = s.applied(compound([(String("argument"), creatures_only.copy()), (String("modifier"), Tag.Str(String("overlay")))]), entity_types)
    check("{over.mobs(MONSTER).len()} {over.mobs(CREATURE).len()}", "1 0")
    let replaced = s.applied(creatures_only, entity_types)
    check("{replaced.mobs(MONSTER).len()} {replaced.mobs(CREATURE).len()}", "0 0")
}

// Slime chunks, as `WorldgenRandom.seedSlimeChunk` seeds them, against `java.util.Random`'s
// `nextInt(10)` worked out by hand from the same seed: the chunks around the origin of seeds 0
// and 1103, and far out, where the formula's `int` products wrap.
fn slimes() {
    check(slimes_near(0), "-2,0 1,-3 2,-3 2,2")
    check(slimes_near(1103), "-3,-1 -3,2 -2,0 -1,3 1,0 2,-3 2,0 3,-4")
    check("{slime_chunk(100000, -1874997, 1103)} {slime_chunk(100002, -1874995, 1103)} {slime_chunk(46341, -46341, 1103)} {slime_chunk(100000, 3, 1103)} {slime_chunk(-70000, 25000, 1103)}", "true true true false false")
}

// The slime chunks of `seed` from -4 to 3 each way, `x` first.
fn slimes_near(seed: i64) -> String {
    var found = String()
    for cx in -4..4 {
        for cz in -4..4 {
            if slime_chunk(cx, cz, seed) {
                if not found.is_empty() {
                    found.push_str(" ")
                }
                found.push_str("{cx},{cz}")
            }
        }
    }
    return found
}

fn main() {
    table()
    filtered()
    local_caps()
    settings()
    slimes()
    println("ok")
}
