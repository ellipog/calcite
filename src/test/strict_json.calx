/// Checks `json.strict`, `java.reader` and the pretty writing and `int` reading of `json.gson`
/// against what real Gson and Java do with the same text: empty and white-space documents, the
/// byte order mark, what follows a value, keywords, numbers up to Gson's 1024 chars, strings and
/// escapes, keys given twice, nesting 255 deep, and bytes that aren't UTF-8 near and far from a
/// fault in the text. The rig's `world_folder` probe checks them against vanilla's reading.
module test.strict_json

import json.gson.{JsonWriter, int_value, pretty}
import json.strict.{Unread, parse_strict}
import json.tree.{Json, Member}
import std.env.{variable}
import std.fs.{write}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn b(text: str) -> List<u8> {
    return String(text).to_bytes()
}

fn add(bytes: mut List<u8>, more: List<u8>) {
    for x in more {
        bytes.push(x)
    }
}

fn repeat(s: str, n: usize) -> String {
    var out = String()
    for _ in 0..n {
        out.push_str(s)
    }
    return out
}

// The text's value, as the compact writer writes it, or `io` or `syntax`.
fn read(bytes: List<u8>) -> String {
    return match parse_strict(bytes) {
        ok(v) => {
            var w = JsonWriter.new()
            w.tree(v)
            w.into_string()
        },
        err(Unread.Io) => String("io"),
        err(Unread.Syntax) => String("syntax"),
    }
}

// The texts to read and what each should read as, which `STRICT_DUMP` names a folder to write
// them to, for a check against Gson itself.
struct Cases {
    names: List<String>
    inputs: List<List<u8>>
    wants: List<String>
    // Numbers' text, and the `int` each should read as.
    int_texts: List<String>
    int_wants: List<String>
}

impl Cases {
    fn add(mut self, name: String, bytes: own List<u8>, want: own String) {
        self.names.push(name.copy())
        self.inputs.push(bytes)
        self.wants.push(want)
    }

    fn reads(mut self, text: str, want: str) {
        self.add("read {text}", b(text), String(want))
    }

    fn ints(mut self, text: str, want: str) {
        self.int_case(String(text), String(want))
    }

    fn int_case(mut self, text: own String, want: own String) {
        self.int_texts.push(text)
        self.int_wants.push(want)
    }

    // Checks every case, after writing them to the folder `STRICT_DUMP` names, if it names one,
    // with each value that reads written pretty as well, and the numbers in `ints.txt`.
    fn check_all(self) {
        if let dir = variable(String("STRICT_DUMP")) {
            for i in 0..self.names.len() {
                write("{dir}/{i}.json", self.inputs[i])!
                write("{dir}/{i}.want", self.wants[i].to_bytes())!
                match parse_strict(self.inputs[i]) {
                    ok(v) => write("{dir}/{i}.pretty", pretty(v).to_bytes())!,
                    err(_) => {},
                }
            }
            var lines = String()
            for i in 0..self.int_texts.len() {
                lines.push_str("{self.int_texts[i]}\t{self.int_wants[i]}\n")
            }
            write("{dir}/ints.txt", lines.to_bytes())!
        }
        for i in 0..self.int_texts.len() {
            check(int_of(self.int_texts[i].copy()), self.int_wants[i], "int_value {self.int_texts[i]}")
        }
        var failed = 0
        for i in 0..self.names.len() {
            let got = read(self.inputs[i])
            if got != self.wants[i] {
                println("{i} {self.names[i]}: got {got.len()} chars, want {self.wants[i].len()}: {got[0..got.len().min(80)]}")
                failed += 1
            }
        }
        if failed > 0 {
            panic("{failed} cases read wrong")
        }
    }
}

// A `\u` escape with these hex digits.
fn esc(hex: str) -> String {
    return "\\u{hex}"
}

fn int_of(text: String) -> String {
    return match int_value(text) {
        some(v) => "{v}",
        none => String("none"),
    }
}

fn documents(c: mut Cases) {
    c.reads("", "null")
    c.reads("   \n\t\r ", "null")
    c.reads("\{\}", "\{\}")
    c.reads("  [ ]  ", "[]")
    c.reads("null x", "null")
    c.reads("null,", "null")
    c.reads("\{\} x", "syntax")
    c.reads("\{\}\{\}", "syntax")
    c.reads("1 2", "syntax")
    c.reads("\{\} /", "syntax")
    c.reads("\{\} #", "syntax")
    c.reads("// x\n\{\}", "syntax")
    c.reads("/* x */ \{\}", "syntax")
    // A byte order mark at the start is stepped past, and nowhere else.
    var bom = List<u8>()
    bom.push(0xEF)
    bom.push(0xBB)
    bom.push(0xBF)
    var first = bom.copy()
    add(mut first, b("\{\"a\": 1\}"))
    c.add("bom first", first, String("\{\"a\":1\}"))
    var after_space = b(" ")
    add(mut after_space, bom.copy())
    add(mut after_space, b("\{\}"))
    c.add("bom after space", after_space, String("syntax"))
    var twice = bom.copy()
    add(mut twice, bom.copy())
    add(mut twice, b("\{\}"))
    c.add("bom twice", twice, String("syntax"))
    var after_line = b("\n")
    add(mut after_line, bom.copy())
    c.add("bom after a line", after_line, String("syntax"))
    let only = bom.copy()
    c.add("bom only", only, String("null"))
}

fn keywords(c: mut Cases) {
    c.reads("true", "true")
    c.reads("false", "false")
    c.reads("[true,false,null]", "[true,false,null]")
    c.reads("TRUE", "syntax")
    c.reads("True", "syntax")
    c.reads("nul", "syntax")
    c.reads("nullx", "syntax")
    c.reads("truefalse", "syntax")
    c.reads("[null]", "[null]")
    c.reads("[nul]", "syntax")
    c.reads("null/", "syntax")
    c.reads("true;", "syntax")
    c.reads("abc", "syntax")
    c.reads("'a'", "syntax")
    c.reads("[1,]", "syntax")
    c.reads("[,1]", "syntax")
    c.reads("[1;2]", "syntax")
    c.reads("\{\"a\"=1\}", "syntax")
    c.reads("\{\"a\":1;\"b\":2\}", "syntax")
    c.reads("\{a:1\}", "syntax")
    c.reads("\{\"a\":1,\}", "syntax")
    c.reads("[", "syntax")
    c.reads("\{", "syntax")
    c.reads("\{\"a\"", "syntax")
    c.reads("\{\"a\":", "syntax")
    c.reads("[1", "syntax")
}

fn numbers(c: mut Cases) {
    c.reads("0", "0")
    c.reads("-0", "-0")
    c.reads("[-0.0e-0]", "[-0.0e-0]")
    c.reads("1.5E+3", "1.5E+3")
    c.reads("01", "syntax")
    c.reads("-01", "syntax")
    c.reads("00", "syntax")
    c.reads("1.", "syntax")
    c.reads(".5", "syntax")
    c.reads("-", "syntax")
    c.reads("+1", "syntax")
    c.reads("1e", "syntax")
    c.reads("1e+", "syntax")
    c.reads("1.e5", "syntax")
    c.reads("1x", "syntax")
    c.reads("NaN", "syntax")
    c.reads("-Infinity", "syntax")
    c.reads("[1,2]", "[1,2]")
    c.reads("\{\"a\":-12.5e3\}", "\{\"a\":-12.5e3\}")
    c.reads("9223372036854775808", "9223372036854775808")
    c.reads("92233720368547758080", "92233720368547758080")
    // The digits wrap as a `long` does, to 0 here, and a digit after a 0 is a leading zero.
    c.reads("922337203685477580801", "syntax")
    let zeros = "1{repeat("0", 64)}"
    c.add(String("1 and 64 zeros"), zeros.to_bytes(), zeros.copy())
    c.add(String("1 and 65 zeros"), "{zeros}0".to_bytes(), String("syntax"))
    // Under 1024 chars, a number is one wherever it is; at 1024 Gson gives up on it.
    let long = repeat("1", 1023)
    c.add("1023 digits", long.copy().to_bytes(), long.copy())
    c.add("1023 digits in an array", "[{long}]".to_bytes(), "[{long}]")
    c.add("1024 digits", "{long}0".to_bytes(), String("syntax"))
    c.add("1024 digits in an array", "[{long}0]".to_bytes(), String("syntax"))
    let spaced = "{repeat(" ", 1000)}12345678901234567890"
    c.add("a number across the window", spaced.to_bytes(), String("12345678901234567890"))
}

fn strings(c: mut Cases) {
    c.reads("\"\"", "\"\"")
    c.reads("\"abc\"", "\"abc\"")
    c.add("unicode escapes", "\"a{esc("0041")}{esc("00e9")}\"".to_bytes(), String("\"aA\u{e9}\""))
    c.add("uppercase hex", "\"{esc("00E9")}\"".to_bytes(), String("\"\u{e9}\""))
    c.add("a surrogate pair", "\"{esc("d83d")}{esc("de00")}\"".to_bytes(), String("\"\u{1f600}\""))
    // Half a pair alone is U+FFFD, where Java would keep it.
    c.add("a lone high surrogate", "\"{esc("d83d")}x\"".to_bytes(), String("\"\u{fffd}x\""))
    c.add("a lone low surrogate", "\"{esc("de00")}\"".to_bytes(), String("\"\u{fffd}\""))
    c.add("a bad hex digit", "\"{esc("00g0")}\"".to_bytes(), String("syntax"))
    c.add("a short escape", "\"{esc("00")}\"".to_bytes(), String("syntax"))
    c.reads("\"\\t\\b\\n\\r\\f\\\"\\\\\\/\"", "\"\\t\\b\\n\\r\\f\\\"\\\\/\"")
    c.reads("\"\\'\"", "syntax")
    c.reads("\"\\x\"", "syntax")
    c.reads("\"\\\n\"", "syntax")
    c.reads("\"a\tb\"", "syntax")
    c.reads("\"a\nb\"", "syntax")
    c.reads("\"abc", "syntax")
    c.reads("\"abc\\", "syntax")
    c.reads("\"\u{7f}\"", "\"\u{7f}\"")
    c.reads("\"\u{e9}\u{1f600}\"", "\"\u{e9}\u{1f600}\"")
    let wide = repeat("x", 3000)
    c.add("a string across windows", "\"{wide}\"".to_bytes(), "\"{wide}\"")
}

fn objects(c: mut Cases) {
    c.reads("\{\"a\":1,\"b\":2,\"a\":3\}", "\{\"a\":3,\"b\":2\}")
    c.reads("\{\"a\":\{\"x\":1\},\"a\":[2]\}", "\{\"a\":[2]\}")
    // Past 16 keys, they're found by a table.
    var many = String("\{")
    for i in 0..20 {
        many.push_str("\"k{i}\":{i},")
    }
    many.push_str("\"k3\":30,\"k19\":190,\"new\":0\}")
    var want = String("\{")
    for i in 0..20 {
        let v = if i == 3 { 30 } else if i == 19 { 190 } else { i }
        want.push_str("\"k{i}\":{v},")
    }
    want.push_str("\"new\":0\}")
    c.add("many keys", many.to_bytes(), want)
    c.reads("\{\"\":1\}", "\{\"\":1\}")
    c.reads("\{\"<a>\":[\"&='\",\{\},[],null,\{\"x\":null\}]\}", "\{\"<a>\":[\"&='\",\{\},[],null,\{\"x\":null\}]\}")
    c.reads(" \{ \"a\" : [ 1 , \{ \} ] \} ", "\{\"a\":[1,\{\}]\}")
}

fn nesting(c: mut Cases) {
    let fits = "{repeat("[", 255)}{repeat("]", 255)}"
    c.add("255 deep", fits.copy().to_bytes(), fits)
    let deep = "{repeat("[", 256)}{repeat("]", 256)}"
    c.add("256 deep", deep.to_bytes(), String("syntax"))
    let nested = "{repeat("\{\"a\":", 255)}1{repeat("\}", 255)}"
    c.add("255 objects deep", nested.copy().to_bytes(), nested)
    let mixed = "{repeat("[\{\"a\":", 128)}1{repeat("\}]", 128)}"
    c.add("256 mixed deep", mixed.to_bytes(), String("syntax"))
}

// Bytes that aren't UTF-8 are met only when Gson reads that far.
fn decoding(c: mut Cases) {
    var bad = b("\{\}")
    bad.push(0xFF)
    c.add("a bad byte in the first window", bad, String("io"))
    var far = b("\{x")
    for _ in 0..20000 {
        far.push(32)
    }
    far.push(0xFF)
    c.add("a fault in the text before a bad byte", far, String("syntax"))
    var after_null = b("null")
    for _ in 0..20000 {
        after_null.push(32)
    }
    after_null.push(0xFF)
    c.add("null before a bad byte", after_null, String("null"))
    var spaces = b("\{\}")
    for _ in 0..20000 {
        spaces.push(32)
    }
    spaces.push(0xFF)
    c.add("white space up to a bad byte", spaces, String("io"))
    var truncated = b("[\"x\"]")
    truncated.push(0xE2)
    truncated.push(0x82)
    c.add("a character the file ends inside", truncated, String("io"))
    var x_truncated = b("x")
    x_truncated.push(0xE2)
    x_truncated.push(0x82)
    c.add("x then a truncated character", x_truncated, String("io"))
    var far_truncated = b("[x")
    for _ in 0..20000 {
        far_truncated.push(32)
    }
    far_truncated.push(0xE2)
    far_truncated.push(0x82)
    c.add("x far before a truncated character", far_truncated, String("syntax"))
    var overlong = b("[1,")
    overlong.push(0xC0)
    overlong.push(0x80)
    overlong.push(93)
    c.add("an overlong form", overlong, String("io"))
    var surrogate = b("\"")
    surrogate.push(0xED)
    surrogate.push(0xA0)
    surrogate.push(0x80)
    surrogate.push(34)
    c.add("an encoded surrogate", surrogate, String("io"))
    var high = b("\"")
    high.push(0xF4)
    high.push(0x90)
    high.push(0x80)
    high.push(0x80)
    high.push(34)
    c.add("past U+10FFFF", high, String("io"))
    var good = b("\"")
    good.push(0xF0)
    good.push(0x9F)
    good.push(0x98)
    good.push(0x80)
    good.push(34)
    c.add("four bytes", good, String("\"\u{1f600}\""))
}

fn u(hex: str) -> String {
    return "\\u00{hex}"
}

fn writes_pretty() {
    var members = List<Member>()
    members.push(Member { key: String("a"), value: Json.Number(String("1")) })
    var items = List<Json>()
    items.push(Json.Number(String("1")))
    items.push(Json.Null)
    members.push(Member { key: String("b"), value: Json.Array(items) })
    members.push(Member { key: String("c"), value: Json.Object(List<Member>()) })
    members.push(Member { key: String("d"), value: Json.Array(List<Json>()) })
    members.push(Member { key: String("e"), value: Json.Null })
    members.push(Member { key: String("f<"), value: Json.Str(String("<&>='\"\n")) })
    members.push(Member { key: String("a"), value: Json.Bool(true) })
    let got = pretty(Json.Object(members))
    let want = "\{\n  \"a\": true,\n  \"b\": [\n    1,\n    null\n  ],\n  \"c\": \{\},\n  \"d\": [],\n  \"f{u("3c")}\": \"{u("3c")}{u("26")}{u("3e")}{u("3d")}{u("27")}\\\"\\n\"\n\}"
    check(got, want, "pretty")
    var nulls = List<Member>()
    nulls.push(Member { key: String("x"), value: Json.Null })
    check(pretty(Json.Object(nulls)), String("\{\}"), "only null members")
    check(pretty(Json.Null), String("null"), "pretty null")
    check(pretty(Json.Str(String("a\u{2028}"))), "\"a\\u{"2028"}\"", "a line separator")
    // The compact writer doesn't escape for HTML.
    var w = JsonWriter.new()
    w.string(String("<&>"))
    check(w.into_string(), String("\"<&>\""), "compact")
}

fn reads_ints(c: mut Cases) {
    c.ints("5", "5")
    c.ints("-5", "-5")
    c.ints("-0", "0")
    c.ints("2147483647", "2147483647")
    c.ints("2147483648", "-2147483648")
    c.ints("4294967296", "0")
    c.ints("-2147483649", "2147483647")
    c.ints("1.9", "1")
    c.ints("-1.9", "-1")
    c.ints("1.0", "1")
    c.ints("1e2", "100")
    c.ints("1E+2", "100")
    c.ints("1e-1", "0")
    c.ints("1e-5", "0")
    c.ints("123.456e2", "12345")
    c.ints("4294967297.5", "1")
    c.ints("12345678901234567890", "-350287150")
    c.ints("-12345678901234567890", "350287150")
    c.ints("9223372036854775808", "0")
    c.ints("-9223372036854775809", "-1")
    c.ints("1e20", "1661992960")
    c.ints("1e9999", "0")
    c.ints("1e10000", "none")
    c.ints("1e-9999", "0")
    c.ints("0.5e-9999", "none")
    c.ints("1e99999999999", "none")
    c.ints("x", "none")
    c.ints("", "none")
    c.ints("1e", "none")
    c.ints("1x", "none")
    c.int_case(repeat("1", 10001), String("none"))
}

fn main() {
    var c = Cases { names: List<String>(), inputs: List<List<u8>>(), wants: List<String>(), int_texts: List<String>(), int_wants: List<String>() }
    documents(mut c)
    keywords(mut c)
    numbers(mut c)
    strings(mut c)
    objects(mut c)
    nesting(mut c)
    decoding(mut c)
    writes_pretty()
    reads_ints(mut c)
    c.check_all()
    print("ok")
}
