/// Checks the locator bar, `server.waypoints` (D454): two players linked by their blocks as the
/// second comes; past 332 blocks by the way to one that went, a link to one that stayed holding;
/// by a chunk where the receiver's view doesn't take it in; a spectator source ignored by all but
/// spectators, and a spectator receiver ignoring no one; nothing on a source's first tick or with
/// the game rule off; a range too short for the distance; and a player's removal telling both
/// sides. The rig's `duel` session checks the packets against vanilla's.
module test.waypoints

import server.waypoints.{Beacon, Told, Waypoints, receives, transmits}

const TRACK: i32 = 0
const UNTRACK: i32 = 1
const UPDATE: i32 = 2

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn expect(got: bool, what: String) {
    if not got {
        panic(what)
    }
}

// A player at `x`, 0, `z`, seeing `view` chunks about the chunk they're in, with a player's ranges.
fn player(id: i32, x: f64, z: f64, view: i32) -> Beacon {
    return Beacon { id: id, uuid: (0i64, i64(id)), x: x, y: -60.0, z: z, center_x: i32.saturate(x.floor()) >> 4, center_z: i32.saturate(z.floor()) >> 4, view: view, spectator: false, first_tick: false, transmit: 6.0e7, receive: 6.0e7, style: String("minecraft:default"), color: none }
}

// The kind of the waypoint told, after its UUID, its style and its color's flag: 0 none, 1 a
// block, 2 a chunk, 3 a way.
fn kind(t: Told) -> u8 {
    return t.body[36]
}

fn one(out: List<Told>, receiver: i32, operation: i32, k: u8, what: str) {
    var found = 0
    for t in out {
        if t.receiver == receiver {
            found += 1
            expect(t.operation == operation, "{what}: the operation, {t.operation}")
            expect(kind(t) == k, "{what}: the kind, {kind(t)}")
        }
    }
    expect(found == 1, "{what}: {found} told")
}

fn main() {
    let a = player(1, 0.5, 0.5, 10)
    var b = player(2, 2.5, 0.5, 10)
    check(transmits(a) and receives(a), "a player transmits and receives")
    var w = Waypoints()
    var out = List<Told>()
    w.add_player(1, [a.copy()], true, mut out)
    check(out.is_empty() and w.is_source(1) and w.is_receiver(1), "alone, nothing's told")
    w.add_player(2, [a.copy(), b.copy()], true, mut out)
    expect(out.len() == 2, "a second player's links: {out.len()}")
    one(out, 2, TRACK, 1u8, "the second sees the first's block")
    one(out, 1, TRACK, 1u8, "the first sees the second's block")

    // Within a block, nothing; a block on, an update.
    out.clear()
    b.x = 2.9
    w.update_player(2, [a.copy(), b.copy()], true, mut out)
    w.update_waypoint(2, [a.copy(), b.copy()], true, mut out)
    expect(out.is_empty(), "a move within the block: {out.len()} told")
    b.x = 3.5
    w.update_waypoint(2, [a.copy(), b.copy()], true, mut out)
    one(out, 1, UPDATE, 1u8, "a block on")

    // Past 332 blocks, the way to the one that went; its link to the first, which stayed, holds,
    // as a block link breaks only as its source moves, `isBroken`.
    out.clear()
    b.x = 400.5
    b.center_x = 25
    w.update_player(2, [a.copy(), b.copy()], true, mut out)
    w.update_waypoint(2, [a.copy(), b.copy()], true, mut out)
    expect(out.len() == 1, "the far one's move: {out.len()} told")
    one(out, 1, TRACK, 3u8, "the first sees the way to the far one")

    // Back within 332, its block again.
    out.clear()
    b.x = 100.5
    b.center_x = 6
    b.view = 2
    w.update_player(2, [a.copy(), b.copy()], true, mut out)
    w.update_waypoint(2, [a.copy(), b.copy()], true, mut out)
    expect(out.len() == 1, "back within reach: {out.len()} told")
    one(out, 1, TRACK, 1u8, "a block in view")

    // A spectator source is ignored, but a spectator receiver ignores no one.
    out.clear()
    b.spectator = true
    w.update_player(2, [a.copy(), b.copy()], true, mut out)
    w.update_waypoint(2, [a.copy(), b.copy()], true, mut out)
    one(out, 1, UNTRACK, 0u8, "a spectator's waypoint goes")
    expect(out.len() == 1, "a spectator receiver keeps theirs: {out.len()} told")
    b.spectator = false
    out.clear()
    w.update_waypoint(2, [a.copy(), b.copy()], true, mut out)
    one(out, 1, TRACK, 1u8, "back from spectating")

    // A range too short for the distance.
    out.clear()
    var deaf = a.copy()
    deaf.receive = 50.0
    w.update_player(1, [deaf.copy(), b.copy()], true, mut out)
    one(out, 1, UNTRACK, 0u8, "out of the receiver's range")
    expect(out.len() == 1, "a short receive range leaves the other's: {out.len()} told")

    // A source whose chunk the receiver's view of 2 doesn't take in, its chunk.
    var viewed = Waypoints()
    var chunk_told = List<Told>()
    let near = player(4, 100.5, 0.5, 2)
    viewed.add_player(1, [a.copy(), near.copy()], true, mut chunk_told)
    viewed.add_player(4, [a.copy(), near.copy()], true, mut chunk_told)
    one(chunk_told, 4, TRACK, 2u8, "a chunk out of view")
    one(chunk_told, 1, TRACK, 1u8, "a block in view of 10")

    // Nothing on a source's first tick, nor with the locator bar off.
    var fresh = Waypoints()
    var none_told = List<Told>()
    var first = player(3, 0.5, 0.5, 10)
    first.first_tick = true
    fresh.add_player(1, [a.copy(), first.copy()], true, mut none_told)
    fresh.add_player(3, [a.copy(), first.copy()], true, mut none_told)
    expect(none_told.len() == 1, "on the new one's first tick, only its view of the first: {none_told.len()}")
    one(none_told, 3, TRACK, 1u8, "the new one sees the first")
    var off = Waypoints()
    var off_told = List<Told>()
    off.add_player(1, [a.copy(), b.copy()], false, mut off_told)
    off.add_player(2, [a.copy(), b.copy()], false, mut off_told)
    expect(off_told.is_empty(), "the locator bar off: {off_told.len()} told")

    // A removal tells the player their links are gone, and the others theirs.
    out.clear()
    w.update_player(1, [a.copy(), b.copy()], true, mut out)
    one(out, 1, TRACK, 1u8, "in the receiver's range again")
    out.clear()
    w.remove_player(2, mut out)
    expect(out.len() == 2, "a removal's told: {out.len()}")
    one(out, 1, UNTRACK, 0u8, "the others lose the removed one")
    one(out, 2, UNTRACK, 0u8, "the removed one loses the others")
    check(not w.is_source(2) and not w.is_receiver(2), "the removed one's gone")
    println("ok")
}
