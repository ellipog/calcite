/// Checks `world.slots` (D571): the slots `SlotRanges`' names stand for, the stacks an
/// `ItemProvider` gives in turn, as each kind gives them, and how a selector's limit and filters
/// go on.
module test.slots

import nbt.tag.{Tag}
import world.slots.{Pick, Provider, range_slots}

fn check(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

// The slots of the range `name`, as the test shows them.
fn ranged(name: str) -> String {
    let ids = range_slots(String(name)) else return String("none")
    var out = String()
    for id in ids {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str("{id}")
    }
    return out
}

// The next `n` stacks of `p`, each its count, `-` for nothing, `.` where there's none left.
fn given(p: mut Provider, n: i32) -> String {
    var out = String()
    for _ in 0..n {
        if not p.has_next() {
            out.push_str(".")
            continue
        }
        match p.next() {
            some(Tag.Int(c)) => out.push_str("{c}"),
            _ => out.push_str("-"),
        }
    }
    return out
}

fn main() {
    check(ranged("contents"), "0", "contents")
    check(ranged("container.5"), "5", "a container's slot")
    check(ranged("hotbar.*"), "0 1 2 3 4 5 6 7 8", "the hotbar")
    check(ranged("inventory.0"), "9", "the inventory's first, past the hotbar")
    check(ranged("enderchest.26"), "226", "the ender chest's last")
    check(ranged("mob.inventory.7"), "307", "a mob's inventory")
    check(ranged("horse.14"), "514", "a horse's last")
    check(ranged("horse.chest"), "499", "a horse's chest, a name past the range's prefix")
    check(ranged("player.cursor"), "499", "the cursor")
    check(ranged("player.crafting.*"), "500 501 502 503", "the crafting grid")
    check(ranged("weapon"), "98", "the main hand")
    check(ranged("weapon.*"), "98 99", "both hands")
    check(ranged("armor.*"), "103 102 101 100 105", "the armor, head first, then the body")
    check(ranged("saddle"), "106", "the saddle")
    check(ranged("hotbar.9"), "none", "past the hotbar")
    check(ranged("hotbar"), "none", "a prefix alone")
    check(ranged("nope"), "none", "a name there isn't")

    let three: List<Tag?> = [some(Tag.Int(1)), some(Tag.Int(2)), none]
    var once = Provider.of(three.copy())
    check(given(mut once, 5), "12-..", "each once")
    once.restart()
    check(given(mut once, 1), "1", "started again")
    var round = Provider.cycle(three.copy())
    check(given(mut round, 7), "12-12-1", "round again")
    var after = Provider.or_empty([some(Tag.Int(4))])
    check(given(mut after, 3), "4--", "then nothing")
    after.restart()
    check(given(mut after, 2), "4-", "then nothing, started again")
    var none_at_all = Provider.cycle(List<Tag?>())
    check(given(mut none_at_all, 2), "..", "nothing to cycle")

    let p = Pick()
    check("{p.limited(5).limited(9).limit}", "5", "a limit only lowers")
    check("{p.limited(5).limited(2).limit}", "2", "a lower limit")
    check("{p.filtered(Tag.Byte(1i8)).filtered(Tag.Byte(2i8)).filters.len()}", "2", "filters add up")
    println("ok")
}
