/// Checks `world.block_use`'s uses of items on blocks, as vanilla's `useItemOn` and
/// `CauldronInteractions` have them (CAL-142), on a flat level whose chunks tick: a composter
/// filled, ready 20 ticks after its seventh layer and emptied; a flower pot planted, full and
/// emptied, an azalea into its bush's pot; a candle put out; a candle on a cake, and cake eaten to
/// its end; and cauldrons filled and emptied with buckets and bottles, lava under water refused, a
/// helmet's dye and a banner's last pattern washed off; a book on a lectern; books put in a
/// chiseled bookshelf's slot by where it's hit and taken out; stone in a decorated pot, which puffs
/// dust and wobbles at dirt; a record in a jukebox, played, ticked, stopped and taken out; and
/// stacks swapped on a shelf by the slot hit and, powered, a chain of shelves' with the hotbar
/// (CAL-143); and containers' menus (CAL-144): a chest's, a large chest's halves, a blocked
/// chest's none, its lid's block event and sounds as it's opened and closed and as its recheck
/// finds no one, a barrel's `open`, a trapped chest's signal, a shulker box's lid opening over 10
/// ticks and a blocked one's none, an ender chest's, a dispenser's, a dropper's and a hopper's
/// types and titles, items read and written, and a container whose loot is to come told of.
/// Each use's `Handed`, what it does to the
/// player, is checked as well. The items are read against the vanilla data pack's registries, from
/// the server jar, as the rig's adapter loads them.
module test.item_use

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.components.{ItemCodecs}
import registry.registries.{Registries}
import registry.registry.{Registry, Tag as RegistryTag}
import resources.identifier.{Identifier}
import rig.registries.{load_vanilla}
import server.chunk_jobs.{ChunkContext, Loaded}
import server.level.{Heard, Level, SPAWN_RADIUS}
import storage.chunk.{ChunkFormat}
import world.analog_output.{analog_output}
import world.block_use.{Handed, Used, User, use_item_on, use_without_item}
import world.containers.{Opening, items_of, opening, put_items, start_open, stop_open}
import world.chunk.{BlockStates}
import world.flat.{FlatBlocks, FlatChunk, FlatWorld}
import world.level_writer.{UPDATE_ALL}
import world.placing.{PlaceFacts}
import world.pos.{ChunkPos}
import worldgen.facts.{Facts, NORTH, UP}
import worldgen.providers.{GenContext}
import worldgen.signals.{weak_of}
import worldgen.survive.{Env}

fn check(got: bool, what: String) {
    if not got {
        panic(what)
    }
}

fn same(got: String, want: str, what: str) {
    if got != String(want) {
        panic("{what}: got {got}, want {want}")
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

fn context() -> ChunkContext {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    var biomes = Registry.new(Identifier { namespace: "minecraft", path: "worldgen/biome" }, true)
    biomes.add(Identifier { namespace: "minecraft", path: "plains" }, some(0))
    let made = ChunkFormat.new(Registries { synced: [biomes], builtin: builtin })!
    return ChunkContext { format: made, table: BlockStates.new([1], [1], 1), min_section: -4, sections: 24, sky_light: true }
}

fn flat_chunk() -> FlatChunk {
    var world = FlatWorld.new(FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }, BlockStates.new([1], [1], 1))
    let made = world.take_chunk() else panic("the flat world has no chunk")
    return made
}

fn registry(index: usize, name: str) -> Registry {
    var r = Registry.new(full(String(name)), false)
    for e in builtin_entries(index) {
        r.add(full(e), none)
    }
    return r
}

fn facts() -> Facts {
    // Vanilla's `#wooden_shelves`, which shelves chain.
    var blocks = registry(4, "block")
    let shelf_names: List<str> = ["acacia_shelf", "bamboo_shelf", "birch_shelf", "cherry_shelf", "crimson_shelf", "dark_oak_shelf", "jungle_shelf", "mangrove_shelf", "oak_shelf", "pale_oak_shelf", "spruce_shelf", "warped_shelf", "poplar_shelf"]
    var ids = List<i32>()
    for n in shelf_names {
        let id = blocks.id(full(String(n))) else panic("no {n}")
        ids.push(id)
    }
    blocks.tags.push(RegistryTag { name: full(String("wooden_shelves")), values: ids })
    return match Facts.new(blocks, registry(2, "fluid"), BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn flat_level(f: Facts) -> Level {
    var level = Level.new(10, 10)
    level.ground(flat_chunk())
    level.open(none, context(), none)
    let spawn = ChunkPos { x: 0, z: 0 }
    level.load_spawn(spawn)
    let reach = SPAWN_RADIUS + 1
    for x in -reach..reach + 1 {
        for z in -reach..reach + 1 {
            check(level.read_chunk(ChunkPos { x: x, z: z }, [], Loaded.Generate, []), "a spawn chunk wasn't asked for")
        }
    }
    check(level.full_around(spawn, SPAWN_RADIUS), "the spawn isn't full")
    level.add_player(spawn, 1)
    level.pump()
    level.set_env(Env { facts: f.copy(), ctx: GenContext { min_y: -64, depth: 384, sea: -63 }, sky_light: true, gen_depth: 384 })
    return level
}

fn named(f: Facts, name: str) -> u32 {
    return match f.named_block(String(name)) {
        ok(b) => f.default_state(b),
        err(_) => panic("no block {name}"),
    }
}

fn with(f: Facts, state: u32, property: str, value: str) -> u32 {
    return match f.with_name(state, String(property), String(value)) {
        ok(s) => s,
        err(_) => panic("no {property} {value}"),
    }
}

fn set(level: mut Level, x: i32, y: i32, z: i32, state: u32, what: str) {
    check(level.set_block(x, y, z, state, UPDATE_ALL), String(what))
}

fn run(level: mut Level, ticks: i32) {
    for _ in 0..ticks {
        level.handling = true
        level.game_time += 1
        level.run_block_ticks()
        level.run_fluid_ticks()
        level.run_block_events()
        level.handling = false
        level.tick_block_entities()
    }
}

// A survival player, entity 7, holding the stack `snbt` in their main hand, clicking the top.
fn holding(items: ItemCodecs, snbt: str) -> User {
    let stack = parse(String(snbt))!
    let item = match stack {
        Tag.Compound(m) => match m["id"] {
            Tag.Str(s) => s.copy(),
            _ => String(),
        },
        _ => String(),
    }
    let id = items.builtin_id("item", item.copy()) ?? -1
    return User { item: item, held: some(stack), item_id: id, hand: 0, offhand: String(), may_build: true, game_master: false, can_eat: true, face: UP, at_y: 0.5, block_item: false, can_place: false, player: 7 }
}

fn empty_hand() -> User {
    return User { item: String(), held: none, item_id: -1, hand: 0, offhand: String(), may_build: true, game_master: false, can_eat: true, face: UP, at_y: 0.5, block_item: false, can_place: false, player: 7 }
}

// What a use came to, with what it handed the player and what it told of as missing.
struct Outcome {
    used: String
    handed: String
    missing: List<String>
}

fn used_name(u: Used) -> String {
    return match u {
        Used.Done => String("done"),
        Used.Empty => String("empty"),
        Used.Pass => String("pass"),
    }
}

fn snbt_or_none(t: Tag?) -> String {
    return match t {
        some(v) => v.to_snbt(),
        none => String("-"),
    }
}

fn handed_text(handed: List<Handed>) -> String {
    var out = String()
    for h in handed {
        let one = match h {
            Handed.Spent => String("spent"),
            Handed.Filled(t, limit) => "filled {t.to_snbt()} {limit}",
            Handed.Changed(t) => "changed {t.to_snbt()}",
            Handed.Added(t) => "added {t.to_snbt()}",
            Handed.Ate(n, m) => "ate {n} {m}",
            Handed.Swapped(t) => "swapped {snbt_or_none(t)}",
            Handed.Slot(i, t) => "slot {i} {snbt_or_none(t)}",
            Handed.Swing => String("swing"),
            Handed.Open(o) => "open {o.menu_type} {o.title.to_json()} {o.slots()}",
            Handed.Stat(kind, value) => "stat {kind} {value}",
        }
        out = if out.is_empty() { one } else { "{out}; {one}" }
    }
    return out
}

// The block at x, y, z used with what `u` holds, then without it where that tries the empty hand.
fn use_on(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level, x: i32, y: i32, z: i32, u: User) -> Outcome {
    let state = level.spawn_state(x, y, z)
    var handed = List<Handed>()
    var missing = List<String>()
    var used = match use_item_on(f, p, items, mut level, state, x, y, z, u, mut handed, mut missing) {
        ok(r) => r,
        err(e) => panic("the use threw: {e.message}"),
    }
    match used {
        Used.Empty => {
            let now = level.spawn_state(x, y, z)
            used = match use_without_item(f, p, mut level, now, x, y, z, u, mut handed, mut missing) {
                ok(r) => r,
                err(e) => panic("the use without an item threw: {e.message}"),
            }
        },
        _ => {},
    }
    return Outcome { used: used_name(used), handed: handed_text(handed), missing: missing }
}

fn block(f: Facts, level: Level, x: i32, y: i32, z: i32) -> String {
    let state = level.spawn_state(x, y, z)
    return f.codec.blocks.name(f.block(state))
}

fn prop(f: Facts, level: Level, x: i32, y: i32, z: i32, name: str) -> String {
    return f.get_name(level.spawn_state(x, y, z), String(name)) ?? String("-")
}

// The sounds heard, the level events, the wobbles and the particles, by name or kind, in order.
fn heard(level: mut Level) -> String {
    var out = String("")
    for h in level.take_heard() {
        match h {
            Heard.Sound(s) => out = "{out}{s.sound} ",
            Heard.Event(e) => out = "{out}event {e.kind}/{e.data} ",
            Heard.Block(b) => out = "{out}wobble {b.b0}/{b.b1} ",
            Heard.Particles(p) => out = "{out}{p.particle}x{p.count} ",
            Heard.Pulse(p) => out = "{out}pulse {p.levels} ",
        }
    }
    return out
}

fn composters(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    set(mut level, 0, -60, 2, named(f, "composter"), "the composter")
    _ = level.take_heard()
    // An empty composter always takes its first layer, with no draw.
    var o = use_on(f, p, items, mut level, 0, -60, 2, holding(items, "\{id:\"minecraft:wheat_seeds\",count:5\}"))
    same(o.used, "done", "seeds in the composter")
    same(o.handed, "stat minecraft:used minecraft:wheat_seeds; spent", "the seeds spent")
    same(prop(f, level, 0, -60, 2, "level"), "1", "the composter's first layer")
    same(heard(mut level), "event 1500/1 ", "the composter's event")
    // A cake always adds one: from 6 to 7, ready 20 ticks on.
    set(mut level, 0, -60, 2, with(f, named(f, "composter"), "level", "6"), "the composter at 6")
    o = use_on(f, p, items, mut level, 0, -60, 2, holding(items, "\{id:\"minecraft:cake\",count:1\}"))
    same(prop(f, level, 0, -60, 2, "level"), "7", "the composter at 7")
    // At 7 it takes the use and nothing else.
    o = use_on(f, p, items, mut level, 0, -60, 2, holding(items, "\{id:\"minecraft:cake\",count:1\}"))
    same("{o.used} {o.handed}", "done ", "the composter at 7 taking the use")
    _ = level.take_heard()
    run(mut level, 19)
    same(prop(f, level, 0, -60, 2, "level"), "7", "the composter ready early")
    run(mut level, 1)
    same(prop(f, level, 0, -60, 2, "level"), "8", "the composter isn't ready")
    same(heard(mut level), "block.composter.ready ", "the composter's ready sound")
    // Full, it takes no more, and an empty hand empties it, its bone meal dropped.
    o = use_on(f, p, items, mut level, 0, -60, 2, empty_hand())
    same(o.used, "done", "the full composter emptied")
    same(prop(f, level, 0, -60, 2, "level"), "0", "the composter's left full")
    same(heard(mut level), "block.composter.empty ", "the composter's empty sound")
    check(o.missing.is_empty(), "the bone meal said to be missing")
    check(level.take_dropped().len() == 1, "the bone meal not dropped")
    // What doesn't compost tries the empty hand.
    o = use_on(f, p, items, mut level, 0, -60, 2, holding(items, "\{id:\"minecraft:stone\",count:1\}"))
    same("{o.used} {o.handed}", "pass ", "stone in the composter")
    println("ok composters")
}

fn pots(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    set(mut level, 2, -60, 2, named(f, "flower_pot"), "the pot")
    var o = use_on(f, p, items, mut level, 2, -60, 2, holding(items, "\{id:\"minecraft:oak_sapling\",count:3\}"))
    same("{o.used} {o.handed} {block(f, level, 2, -60, 2)}", "done stat minecraft:custom minecraft:pot_flower; spent minecraft:potted_oak_sapling", "the sapling potted")
    // A full pot takes the use and nothing else.
    o = use_on(f, p, items, mut level, 2, -60, 2, holding(items, "\{id:\"minecraft:oak_sapling\",count:3\}"))
    same("{o.used} {o.handed}", "done ", "the full pot")
    o = use_on(f, p, items, mut level, 2, -60, 2, empty_hand())
    same("{o.used} {o.handed} {block(f, level, 2, -60, 2)}", "done added \{count:1,id:\"minecraft:oak_sapling\"\} minecraft:flower_pot", "the sapling taken")
    // An azalea goes in its bush's pot, and comes back as an azalea.
    o = use_on(f, p, items, mut level, 2, -60, 2, holding(items, "\{id:\"minecraft:azalea\",count:1\}"))
    same(block(f, level, 2, -60, 2), "minecraft:potted_azalea_bush", "the azalea potted")
    o = use_on(f, p, items, mut level, 2, -60, 2, empty_hand())
    same(o.handed, "added \{count:1,id:\"minecraft:azalea\"\}", "the azalea taken")
    // What doesn't pot tries the empty hand, which an empty pot takes.
    o = use_on(f, p, items, mut level, 2, -60, 2, holding(items, "\{id:\"minecraft:stone\",count:1\}"))
    same("{o.used} {o.handed}", "done ", "stone in the pot")
    println("ok pots")
}

fn candles_and_cakes(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    set(mut level, 4, -60, 2, with(f, named(f, "candle"), "lit", "true"), "the candle")
    _ = level.take_heard()
    var o = use_on(f, p, items, mut level, 4, -60, 2, empty_hand())
    same("{o.used} {prop(f, level, 4, -60, 2, "lit")}", "done false", "the candle put out")
    same(heard(mut level), "block.candle.extinguish ", "the candle's sound")
    // A candle on a cake.
    set(mut level, 6, -60, 2, named(f, "cake"), "the cake")
    o = use_on(f, p, items, mut level, 6, -60, 2, holding(items, "\{id:\"minecraft:red_candle\",count:2\}"))
    same("{o.used} {o.handed} {block(f, level, 6, -60, 2)}", "done spent; stat minecraft:used minecraft:red_candle minecraft:red_candle_cake", "the candle on the cake")
    same(heard(mut level), "block.cake.add_candle ", "the cake's candle sound")
    // A lit candle cake's candle put out, hit above the cake's middle.
    set(mut level, 6, -60, 2, with(f, named(f, "red_candle_cake"), "lit", "true"), "the lit candle cake")
    var high = empty_hand()
    high.at_y = -59.2
    o = use_on(f, p, items, mut level, 6, -60, 2, high)
    same("{o.used} {prop(f, level, 6, -60, 2, "lit")}", "done false", "the candle cake put out")
    // Eaten, a candle cake is a cake a slice in, its candle told of.
    o = use_on(f, p, items, mut level, 6, -60, 2, empty_hand())
    same("{o.used} {o.handed} {block(f, level, 6, -60, 2)} {prop(f, level, 6, -60, 2, "bites")}", "done stat minecraft:custom minecraft:eat_cake_slice; ate 2 0.1 minecraft:cake 1", "the candle cake eaten")
    check(o.missing.len() == 1, "the candle cake's candle isn't told of")
    // A cake can't be eaten by a player who isn't hungry, and its last slice takes it.
    var sated = empty_hand()
    sated.can_eat = false
    o = use_on(f, p, items, mut level, 6, -60, 2, sated)
    same("{o.used} {o.handed}", "pass ", "the cake eaten by a full player")
    set(mut level, 6, -60, 2, with(f, named(f, "cake"), "bites", "6"), "the last slice")
    o = use_on(f, p, items, mut level, 6, -60, 2, empty_hand())
    same("{o.used} {block(f, level, 6, -60, 2)}", "done minecraft:air", "the last slice eaten")
    println("ok candles and cakes")
}

fn cauldrons(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    set(mut level, -2, -60, 2, named(f, "cauldron"), "the cauldron")
    _ = level.take_heard()
    // A water bucket fills it, the bucket given back.
    var o = use_on(f, p, items, mut level, -2, -60, 2, holding(items, "\{id:\"minecraft:water_bucket\",count:1\}"))
    same("{o.used} {o.handed}", "done filled \{count:1,id:\"minecraft:bucket\"\} true; stat minecraft:custom minecraft:fill_cauldron; stat minecraft:used minecraft:water_bucket", "the water bucket")
    same("{block(f, level, -2, -60, 2)} {prop(f, level, -2, -60, 2, "level")}", "minecraft:water_cauldron 3", "the cauldron filled")
    same(heard(mut level), "item.bucket.empty ", "the bucket's sound")
    // A bottle takes a level as a water bottle.
    o = use_on(f, p, items, mut level, -2, -60, 2, holding(items, "\{id:\"minecraft:glass_bottle\",count:4\}"))
    same(o.handed, "filled \{components:\{\"minecraft:potion_contents\":\{potion:\"minecraft:water\"\}\},count:1,id:\"minecraft:potion\"\} true; stat minecraft:custom minecraft:use_cauldron; stat minecraft:used minecraft:glass_bottle", "the water bottle")
    same(prop(f, level, -2, -60, 2, "level"), "2", "the bottle's level")
    // At 2 a bucket tries the empty hand; a water bottle puts the level back, its use counted as
    // air's, as vanilla reads it from the hand it emptied.
    o = use_on(f, p, items, mut level, -2, -60, 2, holding(items, "\{id:\"minecraft:bucket\",count:1\}"))
    same("{o.used} {o.handed}", "pass ", "the bucket at 2")
    o = use_on(f, p, items, mut level, -2, -60, 2, holding(items, "\{id:\"minecraft:potion\",count:1,components:\{\"minecraft:potion_contents\":\{potion:\"minecraft:water\"\}\}\}"))
    same("{o.used} {o.handed} {prop(f, level, -2, -60, 2, "level")}", "done filled \{count:1,id:\"minecraft:glass_bottle\"\} true; stat minecraft:custom minecraft:use_cauldron; stat minecraft:used minecraft:air 3", "the water bottle poured")
    // A dyed helmet's dye washed off, a level spent.
    o = use_on(f, p, items, mut level, -2, -60, 2, holding(items, "\{id:\"minecraft:leather_helmet\",count:1,components:\{\"minecraft:dyed_color\":255\}\}"))
    same("{o.used} {o.handed} {prop(f, level, -2, -60, 2, "level")}", "done changed \{count:1,id:\"minecraft:leather_helmet\"\}; stat minecraft:custom minecraft:clean_armor 2", "the helmet washed")
    // A banner's last pattern washed off, one banner made of it.
    o = use_on(f, p, items, mut level, -2, -60, 2, holding(items, "\{id:\"minecraft:white_banner\",count:2,components:\{\"minecraft:banner_patterns\":[\{pattern:\"minecraft:stripe_top\",color:\"red\"\},\{pattern:\"minecraft:cross\",color:\"blue\"\}]\}\}"))
    same(o.handed, "filled \{components:\{\"minecraft:banner_patterns\":[\{color:\"red\",pattern:\"minecraft:stripe_top\"\}]\},count:1,id:\"minecraft:white_banner\"\} false; stat minecraft:custom minecraft:clean_banner", "the banner washed")
    same(prop(f, level, -2, -60, 2, "level"), "1", "the banner's level")
    // A bucket of lava under water does nothing, but takes the use.
    set(mut level, -4, -60, 2, named(f, "cauldron"), "the cauldron under water")
    set(mut level, -4, -59, 2, named(f, "water"), "the water")
    o = use_on(f, p, items, mut level, -4, -60, 2, holding(items, "\{id:\"minecraft:lava_bucket\",count:1\}"))
    same("{o.used} {o.handed} {block(f, level, -4, -60, 2)}", "done  minecraft:cauldron", "the lava under water")
    // Lava, then a bucket of it back.
    set(mut level, -4, -59, 2, named(f, "air"), "the water gone")
    o = use_on(f, p, items, mut level, -4, -60, 2, holding(items, "\{id:\"minecraft:lava_bucket\",count:1\}"))
    same(block(f, level, -4, -60, 2), "minecraft:lava_cauldron", "the lava poured")
    o = use_on(f, p, items, mut level, -4, -60, 2, holding(items, "\{id:\"minecraft:bucket\",count:1\}"))
    same("{o.handed} {block(f, level, -4, -60, 2)}", "filled \{count:1,id:\"minecraft:lava_bucket\"\} true; stat minecraft:custom minecraft:use_cauldron; stat minecraft:used minecraft:bucket minecraft:cauldron", "the lava taken")
    println("ok cauldrons")
}

// The block entity at x, y, z, as SNBT, "-" for none.
fn entity(level: Level, x: i32, y: i32, z: i32) -> String {
    let t = level.block_entity_tag(x, y, z) else return String("-")
    return t.to_snbt()
}

fn books(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    // A book and quill on a lectern: one of it, at its first page, the lectern with a book.
    set(mut level, 4, -60, -2, named(f, "lectern"), "the lectern")
    _ = level.take_heard()
    var o = use_on(f, p, items, mut level, 4, -60, -2, holding(items, "\{id:\"minecraft:writable_book\",count:1\}"))
    same("{o.used} {o.handed} {prop(f, level, 4, -60, -2, "has_book")}", "done spent true", "the book on the lectern")
    check(entity(level, 4, -60, -2).contains("Book:\{count:1,id:\"minecraft:writable_book\"\}") and entity(level, 4, -60, -2).contains("Page:0"), "the lectern's book: {entity(level, 4, -60, -2)}")
    same(heard(mut level), "item.book.put ", "the lectern's sound")
    // A chiseled bookshelf facing north, hit on its north face at the top left as one faces it,
    // its first slot.
    set(mut level, 4, -60, -4, with(f, named(f, "chiseled_bookshelf"), "facing", "north"), "the bookshelf")
    _ = level.take_heard()
    var hit = holding(items, "\{id:\"minecraft:book\",count:2\}")
    hit.face = NORTH
    hit.at_x = 4.9
    hit.at_y = -59.25
    hit.at_z = -4.0
    o = use_on(f, p, items, mut level, 4, -60, -4, hit)
    same("{o.used} {o.handed} {prop(f, level, 4, -60, -4, "slot_0_occupied")} {prop(f, level, 4, -60, -4, "slot_1_occupied")}", "done stat minecraft:used minecraft:book; spent true false", "the book in the first slot")
    check(entity(level, 4, -60, -4).contains("Items:[\{Slot:0b,count:1,id:\"minecraft:book\"\}]") and entity(level, 4, -60, -4).contains("last_interacted_slot:0"), "the bookshelf's books: {entity(level, 4, -60, -4)}")
    same(heard(mut level), "block.chiseled_bookshelf.insert ", "the bookshelf's sound")
    // The bottom right, its last slot.
    hit.at_x = 4.1
    hit.at_y = -59.75
    o = use_on(f, p, items, mut level, 4, -60, -4, hit)
    same(prop(f, level, 4, -60, -4, "slot_5_occupied"), "true", "the book in the last slot")
    _ = level.take_heard()
    // A book on a full slot tries the empty hand, which takes the book there.
    hit.at_x = 4.9
    hit.at_y = -59.25
    o = use_on(f, p, items, mut level, 4, -60, -4, hit)
    same("{o.used} {o.handed} {prop(f, level, 4, -60, -4, "slot_0_occupied")}", "done added \{count:1,id:\"minecraft:book\"\} false", "the book taken")
    same(heard(mut level), "block.chiseled_bookshelf.pickup ", "the bookshelf's pickup sound")
    check(entity(level, 4, -60, -4).contains("Items:[\{Slot:5b,count:1,id:\"minecraft:book\"\}]"), "the bookshelf's books after: {entity(level, 4, -60, -4)}")
    // Its top passes.
    hit.face = UP
    o = use_on(f, p, items, mut level, 4, -60, -4, hit)
    same("{o.used} {o.handed}", "pass ", "the bookshelf's top")
    println("ok books")
}

fn decorated_pots(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    set(mut level, 6, -60, -2, named(f, "decorated_pot"), "the pot")
    _ = level.take_heard()
    var o = use_on(f, p, items, mut level, 6, -60, -2, holding(items, "\{id:\"minecraft:stone\",count:3\}"))
    same("{o.used} {o.handed}", "done stat minecraft:used minecraft:stone; spent", "the stone in the pot")
    run(mut level, 1)
    check(entity(level, 6, -60, -2).contains("item:\{count:1,id:\"minecraft:stone\"\}"), "the pot's item: {entity(level, 6, -60, -2)}")
    same(heard(mut level), "block.decorated_pot.insert dust_plumex7 wobble 1/0 ", "the pot's sound, dust and wobble")
    o = use_on(f, p, items, mut level, 6, -60, -2, holding(items, "\{id:\"minecraft:stone\",count:3\}"))
    check(entity(level, 6, -60, -2).contains("item:\{count:2,id:\"minecraft:stone\"\}"), "the pot's second stone: {entity(level, 6, -60, -2)}")
    run(mut level, 1)
    _ = level.take_heard()
    // Dirt won't go in with stone: the pot wobbles the other way.
    o = use_on(f, p, items, mut level, 6, -60, -2, holding(items, "\{id:\"minecraft:dirt\",count:1\}"))
    same("{o.used} {o.handed}", "done ", "the dirt at the pot")
    run(mut level, 1)
    same(heard(mut level), "block.decorated_pot.insert_fail wobble 1/1 ", "the pot's fail")
    println("ok decorated pots")
}

// A jukebox: stone won't go in; a record put in plays its song from its start, a comparator
// reading its song's output and the jukebox giving a signal while it plays, a note every 20
// ticks from its start; it stops 20 ticks after its song's length, and the record's taken out by
// hand, its song stopped if it still plays.
fn jukeboxes(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    level.songs = items.songs()
    set(mut level, 8, -60, -2, named(f, "jukebox"), "the jukebox")
    _ = level.take_heard()
    let stone = holding(items, "\{id:\"minecraft:stone\",count:1\}")
    var o = use_on(f, p, items, mut level, 8, -60, -2, stone)
    same("{o.used} {o.handed} {prop(f, level, 8, -60, -2, "has_record")}", "pass  false", "stone at the jukebox")
    let cat = holding(items, "\{id:\"minecraft:music_disc_cat\",count:1\}")
    o = use_on(f, p, items, mut level, 8, -60, -2, cat)
    same("{o.used} {o.handed} {prop(f, level, 8, -60, -2, "has_record")}", "done spent; stat minecraft:custom minecraft:play_record true", "the record in the jukebox")
    let box = entity(level, 8, -60, -2)
    check(box.contains("RecordItem:\{count:1,id:\"minecraft:music_disc_cat\"\}") and box.contains("ticks_since_song_started:0L"), "the jukebox's record: {box}")
    same(heard(mut level), "event 1010/5 ", "the song played, by its place in the registry")
    check(output_of(f, level, 8, -60, -2) == 2 and signal_of(f, level, 8, -60, -2) == 15, "the jukebox playing cat isn't read as 2 or doesn't give 15")
    run(mut level, 1)
    same(heard(mut level), "notex0 ", "the first note")
    run(mut level, 19)
    same(heard(mut level), "", "the ticks between notes")
    run(mut level, 1)
    same(heard(mut level), "notex0 ", "the second note")
    check(entity(level, 8, -60, -2).contains("ticks_since_song_started:21L"), "the song's ticks: {entity(level, 8, -60, -2)}")
    // Cat is 185 seconds, 3700 ticks, and stops 20 ticks after.
    level.set_block_entity_value(8, -60, -2, "ticks_since_song_started", Tag.Long(3720))
    run(mut level, 1)
    same(heard(mut level), "event 1011/0 ", "the song's end")
    check(not entity(level, 8, -60, -2).contains("ticks_since_song_started"), "the stopped song's ticks: {entity(level, 8, -60, -2)}")
    check(output_of(f, level, 8, -60, -2) == 2 and signal_of(f, level, 8, -60, -2) == 0, "the jukebox stopped isn't read as 2 or gives a signal")
    o = use_on(f, p, items, mut level, 8, -60, -2, empty_hand())
    same("{o.used} {prop(f, level, 8, -60, -2, "has_record")} {o.missing.len()}", "done false 1", "the record taken out")
    check(not entity(level, 8, -60, -2).contains("RecordItem"), "the record's still in: {entity(level, 8, -60, -2)}")
    same(heard(mut level), "", "a stopped record taken out")
    check(output_of(f, level, 8, -60, -2) == 0, "an empty jukebox isn't read as 0")
    // Taken out while it plays, its song stops.
    _ = use_on(f, p, items, mut level, 8, -60, -2, cat)
    _ = level.take_heard()
    _ = use_on(f, p, items, mut level, 8, -60, -2, empty_hand())
    same(heard(mut level), "event 1011/0 ", "a playing record taken out")
    println("ok jukeboxes")
}

// Shelves facing north: stone put in the slot hit, the left as one faces it; dirt swapped for it;
// the dirt taken back by hand; nothing on nothing passing; and two powered shelves side by side,
// a chain, swapping their slots with the hotbar's last 6, the chain's left end with the first 3
// of them.
fn shelves(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    let shelf = with(f, named(f, "oak_shelf"), "facing", "north")
    set(mut level, 10, -60, -4, shelf, "the shelf")
    _ = level.take_heard()
    var hit = holding(items, "\{id:\"minecraft:stone\",count:3\}")
    hit.face = NORTH
    hit.at_x = 10.9
    hit.at_y = -59.5
    hit.at_z = -4.0
    var o = use_on(f, p, items, mut level, 10, -60, -4, hit)
    same("{o.used} {o.handed}", "done swapped -; swing", "stone on the shelf")
    check(entity(level, 10, -60, -4).contains("Items:[\{Slot:0b,count:3,id:\"minecraft:stone\"\}]"), "the shelf's stone: {entity(level, 10, -60, -4)}")
    same(heard(mut level), "block.shelf.place_item ", "the stone's sound")
    var dirt = holding(items, "\{id:\"minecraft:dirt\",count:1\}")
    dirt.face = NORTH
    dirt.at_x = 10.9
    dirt.at_y = -59.5
    dirt.at_z = -4.0
    o = use_on(f, p, items, mut level, 10, -60, -4, dirt)
    same("{o.used} {o.handed}", "done swapped \{count:3,id:\"minecraft:stone\"\}; swing", "dirt swapped for the stone")
    same(heard(mut level), "block.shelf.single_swap ", "the swap's sound")
    var hand = empty_hand()
    hand.face = NORTH
    hand.at_x = 10.9
    hand.at_y = -59.5
    hand.at_z = -4.0
    o = use_on(f, p, items, mut level, 10, -60, -4, hand)
    same("{o.used} {o.handed}", "done swapped \{count:1,id:\"minecraft:dirt\"\}; swing", "the dirt taken")
    same(heard(mut level), "block.shelf.take_item ", "the taking's sound")
    check(entity(level, 10, -60, -4).contains("Items:[]"), "the shelf emptied: {entity(level, 10, -60, -4)}")
    hand.at_x = 10.5
    o = use_on(f, p, items, mut level, 10, -60, -4, hand)
    same("{o.used} {o.handed}", "pass swapped -", "nothing on nothing")
    same(heard(mut level), "", "nothing's sound")
    // Two shelves powered by redstone blocks under them, joined, the one to the east on the
    // chain's left as they face north.
    set(mut level, 10, -61, -6, named(f, "redstone_block"), "the first redstone block")
    set(mut level, 11, -61, -6, named(f, "redstone_block"), "the second redstone block")
    let powered = with(f, shelf, "powered", "true")
    set(mut level, 10, -60, -6, powered, "the first powered shelf")
    set(mut level, 11, -60, -6, powered, "the second powered shelf")
    same("{prop(f, level, 11, -60, -6, "side_chain")} {prop(f, level, 10, -60, -6, "side_chain")}", "left right", "the chain's parts")
    var stick = JavaHashMap<String, Tag>()
    stick.insert(String("Slot"), Tag.Byte(1i8))
    stick.insert(String("id"), Tag.Str(String("minecraft:stick")))
    stick.insert(String("count"), Tag.Int(1))
    let held: List<Tag> = [Tag.Compound(stick)]
    level.set_block_entity_value(10, -60, -6, "Items", Tag.List(held))
    _ = level.take_heard()
    var row = holding(items, "\{id:\"minecraft:stone\",count:1\}")
    row.face = NORTH
    row.at_x = 10.5
    row.at_y = -59.5
    row.at_z = -6.0
    for _ in 0..9 {
        row.hotbar.push(none)
    }
    row.hotbar[3] = row.held.copy()
    row.hotbar[8] = some(parse(String("\{id:\"minecraft:dirt\",count:2\}"))!)
    o = use_on(f, p, items, mut level, 10, -60, -6, row)
    same("{o.used} {o.handed}", "done slot 3 -; slot 7 \{count:1,id:\"minecraft:stick\"\}; slot 8 -; swing", "the hotbar swapped")
    check(entity(level, 11, -60, -6).contains("Items:[\{Slot:0b,count:1,id:\"minecraft:stone\"\}]") and entity(level, 10, -60, -6).contains("Items:[\{Slot:2b,count:2,id:\"minecraft:dirt\"\}]"), "the chain's items: {entity(level, 11, -60, -6)} {entity(level, 10, -60, -6)}")
    same(heard(mut level), "block.shelf.multi_swap ", "the hotbar's sound")
    println("ok shelves")
}

// The menu the container block at x, y, z opens, which must be one.
fn opened(f: Facts, p: PlaceFacts, level: mut Level, x: i32, y: i32, z: i32) -> Opening {
    let state = level.spawn_state(x, y, z)
    var missing = List<String>()
    let found = match opening(f, mut level, p.use_class(f.block(state)), state, x, y, z, false, mut missing) {
        ok(o) => o,
        err(t) => panic("the opening threw: {t.message}"),
    }
    let o = found else panic("nothing opens at {x}, {y}, {z}")
    return o
}

fn open(f: Facts, level: mut Level, o: Opening) {
    match start_open(f, mut level, o, 4.5) {
        ok => {},
        err(t) => panic("startOpen threw: {t.message}"),
    }
}

fn close(f: Facts, level: mut Level, o: Opening) {
    match stop_open(f, mut level, o) {
        ok => {},
        err(t) => panic("stopOpen threw: {t.message}"),
    }
}

// Containers' menus (CAL-144).
fn containers(f: Facts, p: PlaceFacts, items: ItemCodecs, level: mut Level) {
    // A chest's three rows, opened by hand: its sound at once, its lid's block event as the
    // events run; then its recheck 5 ticks on finds no one with it open, as the level's players
    // have none, and it closes.
    let chest = with(f, named(f, "chest"), "facing", "south")
    set(mut level, 0, -60, 6, chest, "the chest")
    _ = level.take_heard()
    var o = use_on(f, p, items, mut level, 0, -60, 6, empty_hand())
    same("{o.used} {o.handed}", "done open minecraft:generic_9x3 \{\"translate\":\"container.chest\"\} 27; stat minecraft:custom minecraft:open_chest", "the chest opened")
    let menu = opened(f, p, mut level, 0, -60, 6)
    open(f, mut level, menu)
    same(heard(mut level), "block.chest.open ", "the chest's sound")
    run(mut level, 1)
    same(heard(mut level), "wobble 1/1 ", "the chest's lid")
    run(mut level, 4)
    same(heard(mut level), "block.chest.close wobble 1/0 ", "the recheck finding no one")
    // A large chest, its right half's slots first, named for both.
    let left = with(f, with(f, chest, "type", "left"), "facing", "south")
    let right = with(f, with(f, chest, "type", "right"), "facing", "south")
    set(mut level, 2, -60, 6, right, "the right half")
    set(mut level, 3, -60, 6, left, "the left half")
    let large = opened(f, p, mut level, 3, -60, 6)
    same("{large.menu_type} {large.title.to_json()} {large.parts[0].x} {large.parts[1].x}", "minecraft:generic_9x6 \{\"translate\":\"container.chestDouble\"\} 2 3", "the large chest")
    // Its sound is between its halves, its left half's none.
    _ = level.take_heard()
    open(f, mut level, large)
    let sounds = level.take_heard()
    var at = String()
    for h in sounds {
        if let Heard.Sound(sound) = h {
            at = "{at}{sound.x} "
        }
    }
    same(at, "3.0 ", "the large chest's sound")
    close(f, mut level, large)
    _ = level.take_heard()
    // A chest under stone opens nothing.
    set(mut level, 0, -59, 6, named(f, "stone"), "the stone on the chest")
    o = use_on(f, p, items, mut level, 0, -60, 6, empty_hand())
    same("{o.used} {o.handed}", "done ", "the blocked chest")
    // A barrel's open while it's open.
    set(mut level, 5, -60, 6, with(f, named(f, "barrel"), "facing", "up"), "the barrel")
    let barrel = opened(f, p, mut level, 5, -60, 6)
    _ = level.take_heard()
    open(f, mut level, barrel)
    same("{heard(mut level)} {prop(f, level, 5, -60, 6, "open")}", "block.barrel.open  true", "the barrel opened")
    close(f, mut level, barrel)
    same("{heard(mut level)} {prop(f, level, 5, -60, 6, "open")}", "block.barrel.close  false", "the barrel closed")
    // A trapped chest gives a signal of how many have it open.
    set(mut level, 7, -60, 6, named(f, "trapped_chest"), "the trapped chest")
    let trapped = opened(f, p, mut level, 7, -60, 6)
    open(f, mut level, trapped)
    check(signal_of(f, level, 7, -60, 6) == 1, "the open trapped chest's signal isn't 1")
    close(f, mut level, trapped)
    check(signal_of(f, level, 7, -60, 6) == 0, "the shut trapped chest gives a signal")
    // Their lids' block events, and their rechecks, which find no one.
    run(mut level, 6)
    _ = level.take_heard()
    // A shulker box's lid opens over 10 ticks, from its block event; one with stone in front of
    // it opens nothing.
    set(mut level, 9, -60, 6, named(f, "shulker_box"), "the shulker box")
    let shulker = opened(f, p, mut level, 9, -60, 6)
    same("{shulker.menu_type} {shulker.title.to_json()}", "minecraft:shulker_box \{\"translate\":\"container.shulkerBox\"\}", "the shulker box's menu")
    open(f, mut level, shulker)
    run(mut level, 1)
    same(heard(mut level), "block.shulker_box.open wobble 1/1 ", "the shulker box's sound and lid")
    check(level.openers(9, -60, 6).status == 1, "the shulker box isn't opening")
    run(mut level, 10)
    check(level.openers(9, -60, 6).status == 2, "the shulker box isn't open")
    close(f, mut level, shulker)
    run(mut level, 11)
    check(level.openers(9, -60, 6).status == 0, "the shulker box isn't shut")
    _ = level.take_heard()
    set(mut level, 9, -59, 6, named(f, "stone"), "the stone on the shulker box")
    let boxed = opened(f, p, mut level, 9, -60, 6)
    check(boxed.room != none, "the shut shulker box needs no room")
    // An ender chest's is the player's own; a dispenser's, a dropper's and a hopper's.
    set(mut level, 11, -60, 6, named(f, "ender_chest"), "the ender chest")
    let ender = opened(f, p, mut level, 11, -60, 6)
    same("{ender.menu_type} {ender.ender} {ender.slots()}", "minecraft:generic_9x3 true 27", "the ender chest's menu")
    set(mut level, 13, -60, 6, named(f, "dispenser"), "the dispenser")
    set(mut level, 15, -60, 6, named(f, "dropper"), "the dropper")
    set(mut level, 17, -60, 6, named(f, "hopper"), "the hopper")
    let dispenser = opened(f, p, mut level, 13, -60, 6)
    let dropper = opened(f, p, mut level, 15, -60, 6)
    let hopper = opened(f, p, mut level, 17, -60, 6)
    same("{dispenser.menu_type} {dispenser.title.to_json()} {dropper.title.to_json()} {hopper.menu_type} {hopper.slots()}", "minecraft:generic_3x3 \{\"translate\":\"container.dispenser\"\} \{\"translate\":\"container.dropper\"\} minecraft:hopper 5", "the dispenser's, the dropper's and the hopper's")
    // What a container holds, written and read back by slot.
    var held = List<Tag?>()
    for _ in 0..5 {
        held.push(none)
    }
    held[3] = some(parse(String("\{id:\"minecraft:stone\",count:7\}"))!)
    match put_items(f, mut level, hopper, held) {
        ok => {},
        err(t) => panic("putting items threw: {t.message}"),
    }
    check(entity(level, 17, -60, 6).contains("Items:[\{Slot:3b,count:7,id:\"minecraft:stone\"\}]"), "the hopper's items: {entity(level, 17, -60, 6)}")
    let back = items_of(level, hopper)
    same("{snbt_or_none(back[3])} {snbt_or_none(back[0])}", "\{count:7,id:\"minecraft:stone\"\} -", "the hopper's items read")
    // A container whose loot is to come is told of, and opens nothing.
    level.set_block_entity_value(13, -60, 6, "LootTable", Tag.Str(String("minecraft:chests/simple_dungeon")))
    o = use_on(f, p, items, mut level, 13, -60, 6, empty_hand())
    same("{o.used} {o.handed} {o.missing.len()}", "done  1", "the dispenser's loot")
    println("ok containers")
}

// What a comparator reads of the block at x, y, z.
fn output_of(f: Facts, level: Level, x: i32, y: i32, z: i32) -> i32 {
    return match analog_output(f, level, level.spawn_state(x, y, z), x, y, z, NORTH) {
        ok(v) => v,
        err(t) => panic("what a comparator reads threw: {t.message}"),
    }
}

// The weak signal the block at x, y, z gives toward the north.
fn signal_of(f: Facts, level: Level, x: i32, y: i32, z: i32) -> i32 {
    return match weak_of(f, level, level.spawn_state(x, y, z), x, y, z, NORTH, true) {
        ok(v) => v,
        err(t) => panic("the signal threw: {t.message}"),
    }
}

fn main() {
    let loaded = load_vanilla()!
    let items = loaded.items.value.copy()
    let f = facts()
    let p = PlaceFacts.new()
    var level = flat_level(f)
    composters(f, p, items, mut level)
    pots(f, p, items, mut level)
    candles_and_cakes(f, p, items, mut level)
    cauldrons(f, p, items, mut level)
    books(f, p, items, mut level)
    decorated_pots(f, p, items, mut level)
    jukeboxes(f, p, items, mut level)
    shelves(f, p, items, mut level)
    containers(f, p, items, mut level)
    println("ok")
}
