/// Checks a player's item cooldowns (D579), as vanilla's `ItemCooldowns` keeps them: how much of
/// one is left, `getCooldownPercent`; that one ends once its ticks are out, `tick`; that those
/// ending together end in the order vanilla's `HashMap` keyed by `Identifier` holds them, at 16
/// and grown to 32, as a JDK 25 run of that map ordered them; and the ticks of a `use_cooldown`.
module test.cooldowns

import world.cooldowns.{ItemCooldowns, cooldown_ticks}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn joined(names: List<String>) -> String {
    var out = String()
    for n in names {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str(n)
    }
    return out
}

fn main() {
    // An ender pearl's second: on cooldown till its 20th tick, three quarters left after 5.
    var c = ItemCooldowns()
    c.add(String("minecraft:ender_pearl"), 20)
    check("{c.on_cooldown(String("minecraft:ender_pearl"))} {c.on_cooldown(String("minecraft:snowball"))}", "true false")
    for _ in 0..5 {
        check(joined(c.tick()), "")
    }
    check("{c.left(String("minecraft:ender_pearl"))}", "0.75")
    for _ in 5..19 {
        check(joined(c.tick()), "")
    }
    check("{c.on_cooldown(String("minecraft:ender_pearl"))}", "true")
    check(joined(c.tick()), "minecraft:ender_pearl")
    check("{c.on_cooldown(String("minecraft:ender_pearl"))} {c.entries.len()}", "false 0")
    // Put in again, it begins again from now.
    c.add(String("minecraft:ender_pearl"), 5)
    c.add(String("minecraft:ender_pearl"), 2)
    check("{c.entries.len()} {c.entries[0].start} {c.entries[0].end}", "1 20 22")
    // None long, it's on no cooldown, and ends at the next tick.
    var none_long = ItemCooldowns()
    none_long.add(String("minecraft:snowball"), 0)
    check("{none_long.on_cooldown(String("minecraft:snowball"))}", "false")
    check(joined(none_long.tick()), "minecraft:snowball")
    // Ending together, in the map's order.
    var many = ItemCooldowns()
    for n in ["minecraft:ender_pearl", "minecraft:chorus_fruit", "minecraft:goat_horn", "minecraft:wind_charge", "minecraft:shield", "rig:group", "minecraft:snowball"] {
        many.add(String(n), 1)
    }
    check(joined(many.tick()), "minecraft:shield rig:group minecraft:ender_pearl minecraft:wind_charge minecraft:goat_horn minecraft:chorus_fruit minecraft:snowball")
    // Thirteen, past three quarters of 16, which grows the table to 32.
    var grown = ItemCooldowns()
    for i in 0..13 {
        grown.add("minecraft:item_{i}", 1)
    }
    var paths = List<String>()
    for g in grown.tick() {
        paths.push(g[10..])
    }
    check(joined(paths), "item_0 item_1 item_2 item_3 item_4 item_5 item_11 item_6 item_10 item_7 item_8 item_9 item_12")
    // A use cooldown's ticks, its part of a tick dropped.
    check("{cooldown_ticks(1.0f32)} {cooldown_ticks(0.07f32)} {cooldown_ticks(0.75f32)}", "20 1 15")
    println("ok")
}
