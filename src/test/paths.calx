/// Tests of `world.paths`, what pathfinding makes of blocks (CAL-157): every state's path type,
/// with vanilla's tags, as vanilla's own `getPathTypeFromState` gives it; `isPathfindable` of a
/// few; and a block's path type over and beside others, `getPathTypeStatic`.
module test.paths

import registry.builtin.{builtin_entries}
import registry.registry.{Registry, Tag}
import resources.identifier.{Identifier}
import world.chunk.{AIR_STATE, BlockStates}
import world.collision.{CollisionBlocks}
import world.entity_facts.{COMPUTATION_AIR, COMPUTATION_LAND, COMPUTATION_WATER, PATH_DAMAGE_CAUTIOUS, PATH_DAMAGING_IN_NEIGHBOR, PATH_FIRE, PATH_FIRE_IN_NEIGHBOR, PATH_ON_TOP_OF_POWDER_SNOW, PATH_ON_TOP_OF_TRAPDOOR, PATH_OPEN, PATH_WALKABLE, PATH_WATER, PATH_WATER_BORDER, path_block_tag_blocks, path_block_tag_names, path_fluid_tag_fluids, path_fluid_tag_names, path_type_names, vanilla_path_types}
import world.paths.{PathStates}
import worldgen.facts.{Facts}

fn check(cond: bool, what: str) {
    if not cond {
        panic(what)
    }
}

fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}

// The block facts, from the built-in block and fluid registries (4 and 2), with the tags
// `getPathTypeFromState` reads as vanilla's data has them.
fn facts() -> Facts {
    var blocks = Registry.new(full("block"), false)
    for e in builtin_entries(4) {
        blocks.add(full(e), none)
    }
    let names = path_block_tag_names()
    let held = path_block_tag_blocks()
    for i in 0..names.len() {
        blocks.tags.push(Tag { name: full(names[i].copy()), values: held[i].copy() })
    }
    var fluids = Registry.new(full("fluid"), false)
    for e in builtin_entries(2) {
        fluids.add(full(e), none)
    }
    let fluid_names = path_fluid_tag_names()
    let fluid_held = path_fluid_tag_fluids()
    for i in 0..fluid_names.len() {
        fluids.tags.push(Tag { name: full(fluid_names[i].copy()), values: fluid_held[i].copy() })
    }
    return match Facts.new(blocks, fluids, BlockStates.new([1], [1], 1)) {
        ok(f) => f,
        err(e) => panic("the block facts: {e}"),
    }
}

fn default_of(f: Facts, name: str) -> u32 {
    let b = f.block_named(String(name)) else panic("no block {name}")
    return f.default_state(b)
}

// Every state's path type is vanilla's, which `EntityFacts` wrote with vanilla's tags loaded.
fn every_state(f: Facts, p: PathStates) {
    let vanilla = vanilla_path_types()
    let names = path_type_names()
    var differ = 0
    for s in 0..vanilla.len() {
        let got = p.of(u32.wrap(s))
        if u32(got) != vanilla[s] {
            if differ < 5 {
                println("state {s}: {names[usize(got)]}, vanilla's {names[usize(vanilla[s])]}")
            }
            differ += 1
        }
    }
    check(differ == 0, "states' path types other than vanilla's")
    // Air is pathfindable on land and in the air, not in water; water on land and in water,
    // lava in none; stone in none; an open oak door on land and in the air.
    let water = f.ids.water_state
    let lava = f.ids.lava_state
    let stone = default_of(f, "minecraft:stone")
    check(p.pathfindable(AIR_STATE, COMPUTATION_LAND) and p.pathfindable(AIR_STATE, COMPUTATION_AIR) and not p.pathfindable(AIR_STATE, COMPUTATION_WATER), "air's isPathfindable")
    check(p.pathfindable(water, COMPUTATION_LAND) and p.pathfindable(water, COMPUTATION_WATER) and p.pathfindable(water, COMPUTATION_AIR), "water's isPathfindable")
    check(not p.pathfindable(lava, COMPUTATION_LAND) and not p.pathfindable(lava, COMPUTATION_WATER) and not p.pathfindable(lava, COMPUTATION_AIR), "lava's isPathfindable")
    check(not p.pathfindable(stone, COMPUTATION_LAND) and not p.pathfindable(stone, COMPUTATION_AIR), "stone's isPathfindable")
    let door = default_of(f, "minecraft:oak_door")
    let open = match f.with_bool(door, String("open"), true) {
        ok(s) => s,
        err(_) => panic("an oak door can't open"),
    }
    check(not p.pathfindable(door, COMPUTATION_LAND) and p.pathfindable(open, COMPUTATION_LAND) and p.pathfindable(open, COMPUTATION_AIR) and not p.pathfindable(open, COMPUTATION_WATER), "an oak door's isPathfindable")
    println("every state: {vanilla.len()} path types, vanilla's")
}

// A level of grass below y 0 and air above, but for the blocks set.
struct Level {
    set: List<(i32, i32, i32, u32)>
    grass: u32
}

impl CollisionBlocks for Level {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        for (bx, by, bz, s) in self.set {
            if bx == x and by == y and bz == z {
                return some(s)
            }
        }
        return some(if y < 0 { self.grass } else { AIR_STATE })
    }
}

// Blocks' path types over and beside others, each case 10 blocks from the others along x.
fn static_types(f: Facts, p: PathStates) {
    let grass = default_of(f, "minecraft:grass_block")
    let water = f.ids.water_state
    let lava = f.ids.lava_state
    let cactus = default_of(f, "minecraft:cactus")
    let magma = default_of(f, "minecraft:magma_block")
    let snow = default_of(f, "minecraft:powder_snow")
    let trapdoor = default_of(f, "minecraft:oak_trapdoor")
    let fence = default_of(f, "minecraft:oak_fence")
    let rose = default_of(f, "minecraft:wither_rose")
    let level = Level {
        set: [
            // Water beside, lava beside, a cactus beside and above, a wither rose below beside.
            (11, 0, 0, water), (21, 0, 0, lava), (31, 1, 1, cactus), (41, -1, 0, rose),
            // A cactus before water, by x, and water before one.
            (49, 0, 0, cactus), (51, 0, 0, water), (59, 0, 0, water), (61, 0, 0, cactus),
            // Air, magma, powder snow, a trapdoor and a fence below.
            (70, -1, 0, AIR_STATE), (80, -1, 0, magma), (90, -1, 0, snow), (100, -1, 0, trapdoor), (110, -1, 0, fence),
            // Air at the bottom of the level.
            (120, -64, 0, AIR_STATE),
        ],
        grass: grass,
    }
    let cases: List<(i32, i32, u8)> = [
        (0, 0, PATH_WALKABLE), (10, 0, PATH_WATER_BORDER), (20, 0, PATH_FIRE_IN_NEIGHBOR), (30, 0, PATH_DAMAGING_IN_NEIGHBOR),
        (40, 0, PATH_DAMAGE_CAUTIOUS), (50, 0, PATH_DAMAGING_IN_NEIGHBOR), (60, 0, PATH_WATER_BORDER), (70, 0, PATH_OPEN),
        (80, 0, PATH_FIRE), (90, 0, PATH_ON_TOP_OF_POWDER_SNOW), (100, 0, PATH_ON_TOP_OF_TRAPDOOR), (110, 0, PATH_WALKABLE),
        (120, -64, PATH_OPEN), (11, 0, PATH_WATER),
    ]
    let names = path_type_names()
    for (x, y, want) in cases {
        let got = p.at(level, -64, x, y, 0)
        if got != want {
            panic("the block at {x}, {y}: {names[usize(got)]}, vanilla's {names[usize(want)]}")
        }
    }
    println("static types: {cases.len()} blocks over and beside others")
}

fn main() {
    let f = facts()
    let p = PathStates.new(f)
    every_state(f, p)
    static_types(f, p)
    println("ok")
}
