/// Checks what an item's tracker sends, `world.item_tracker` (CAL-148): its first run, a move of
/// its place and data; a run every 20 ticks, sooner where it needs syncing or its stack changed;
/// where it is whole as it lands; its moves in 4096ths of a block, and whole past a short's
/// reach; its motion where it changed, or went to none; where it is every 60 runs though it's
/// still; and `add_entity`'s body and the motion's `LpVec3` bytes. The rig's `items` session
/// checks the same against vanilla's packets.
module test.item_tracker

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import world.item_entity.{ItemEntity}
import world.item_tracker.{Tracker, Sent, lp_vec3_bytes, pack_degrees, unpack_degrees}

fn check(got: bool, what: str) {
    if not got {
        panic(what)
    }
}

fn stone() -> Tag {
    return match parse("\{id:\"minecraft:stone\",count:1\}") {
        ok(t) => t,
        err(e) => panic("the stack: {e}"),
    }
}

fn shown(out: List<Sent>) -> String {
    var s = String()
    for o in out {
        if not s.is_empty() {
            s.push_str(" ")
        }
        s.push_str(match o {
            Sent.Motion(_, _, _) => String("motion"),
            Sent.Pos(a, b, c, g) => "pos({a},{b},{c},{g})",
            Sent.PosRot(_, _, _, _, _, _) => String("posrot"),
            Sent.Rot(_, _, _) => String("rot"),
            Sent.Sync(_, _, _, _, _, g) => "sync({g})",
            Sent.Data(_, _) => String("data"),
            Sent.Dirty => String("dirty"),
            Sent.Head(h) => "head({h})",
            Sent.StepsPos(steps, g) => "steps({steps.len()},{g})",
            Sent.StepsPosRot(steps, _, _, g) => "stepsrot({steps.len()},{g})",
            Sent.StepsSync(path, _, _, g) => "stepssync({path.len()},{g})",
        })
    }
    return s
}

// The tracker's run on `e`, and what it sent, its stack given where it changed, as the network
// gives it.
fn run(tr: mut Tracker, e: mut ItemEntity) -> String {
    var out = List<Sent>()
    let changed: Tag? = if e.stack_changed { some(e.stack.copy()) } else { none }
    e.stack_changed = false
    tr.send_changes(mut e.body, none, changed, mut out)
    return shown(out)
}

fn main() {
    var e = ItemEntity.moving(2, 7, 0.5, 64.0, 0.5, stone(), 0.0, 0.2, 0.0)
    var tr = Tracker.new(e.body, e.stack.copy())

    // Its first run sends where it is, nothing moved yet, and its data, which was set as it was
    // made; its motion's what the tracker was made with.
    check(run(mut tr, mut e) == "pos(0,0,0,false) data", "the first run")
    // Then nothing till the 20th, but where it needs syncing.
    for _ in 1..20 {
        e.body.y += 0.01
        check(run(mut tr, mut e) == "", "a run between")
    }
    e.body.needs_sync = true
    e.body.vy = 0.1
    e.body.y = 64.05
    check(run(mut tr, mut e) == "motion pos(0,205,0,false)", "a run it needs syncing for")
    check(not e.body.needs_sync, "synced")

    // Landing, it's sent whole, with the motion before it.
    e.body.on_ground = true
    e.body.vy = 0.0
    e.body.y = 64.0
    e.body.needs_sync = true
    check(run(mut tr, mut e) == "motion sync(true)", "landing")

    // A move further than a short reaches goes whole.
    e.body.x = 20.5
    e.body.needs_sync = true
    check(run(mut tr, mut e) == "sync(true)", "a long move")

    // Still, where it is goes every 60 runs, and its stack as it changes.
    var sent = 0
    for _ in 0..120 {
        let s = run(mut tr, mut e)
        if s == "pos(0,0,0,true)" {
            sent += 1
        } else {
            check(s == "", "a still run")
        }
    }
    check(sent == 2, "where it is, every 60 runs")
    e.stack_changed = true
    check(run(mut tr, mut e) == "data", "its stack changed")

    // Its motion where it changed by more than a little, or to none, however little.
    e.body.vx = 1.0e-3
    e.body.needs_sync = true
    check(run(mut tr, mut e) == "motion", "a motion")
    e.body.vx = 1.1e-3
    e.body.needs_sync = true
    check(run(mut tr, mut e) == "", "a little change isn't sent")
    e.body.vx = 2.0e-4
    e.body.needs_sync = true
    check(run(mut tr, mut e) == "motion", "a little motion")
    e.body.vx = 0.0
    e.body.needs_sync = true
    check(run(mut tr, mut e) == "motion", "none is sent")

    // Angles in 256ths of a turn.
    check(pack_degrees(90.0f32) == 64i8, "90 degrees")
    check(pack_degrees(270.0f32) == -64i8, "270 degrees")
    check(unpack_degrees(-64i8) == -90.0f32, "back")

    // No motion is a byte; a little, six, its scale in the low bits.
    check(lp_vec3_bytes(0.0, 0.0, 0.0).len() == 1, "no motion")
    let b = lp_vec3_bytes(0.1, 0.2, -0.3)
    check(b.len() == 6 and (b[0] & 3u8) == 1u8 and (b[0] & 4u8) == 0u8, "a little motion")
    check(lp_vec3_bytes(5.0, 0.0, 0.0).len() == 7, "more than 3, with its varint")

    // `add_entity`'s body: its UUID, type, place, motion, none now, a byte, angles and data.
    let body = tr.add_entity_body(e.body, 71)
    check(body.len() == 16 + 1 + 24 + 1 + 3 + 1, "the body length")
    println("tracker: runs, moves, syncs, motion and data as ServerEntity sends them")
    println("ok")
}
