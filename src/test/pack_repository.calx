/// Checks pack.repository on packs made here: a stand-in for Mojang's archive with a feature pack
/// in it, and a world's `datapacks` folder with a folder pack, zips, and entries that aren't
/// packs. Each is found and picked as vanilla's `PackRepository` and `configurePackRepository`
/// find and pick them, with their lines, and the fingerprint changes when the folder does.
module test.pack_repository

import pack.repository.{Repository, Selection, Setup, discover, fingerprint, missing_flags}
import std.zip.{Zip}
import server.log.{Entry, Level}
import std.fs.{make_dir_all, remove_dir_all, separator, temp_dir, write}
import std.zlib.{crc32}
import storage.level.{DataPacks}
import storage.symlinks.{AllowList}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn push16(out: mut List<u8>, v: usize) {
    out.push(u8.wrap(v % 256))
    out.push(u8.wrap(v / 256 % 256))
}

fn push32(out: mut List<u8>, v: u64) {
    var x = v
    for _ in 0..4 {
        out.push(u8.wrap(x % 256))
        x /= 256
    }
}

// A zip of the files, each a name and its text, stored.
fn zip(files: List<(String, String)>) -> List<u8> {
    var out = List<u8>()
    var central = List<u8>()
    for f in files {
        let data = f.1.to_bytes()
        let offset = out.len()
        let name = f.0.to_bytes()
        for part in 0..2 {
            var h = List<u8>()
            push32(mut h, if part == 0 { 0x04034b50u64 } else { 0x02014b50u64 })
            if part == 1 {
                push16(mut h, 20)
            }
            push16(mut h, 20)
            push16(mut h, 0)
            push16(mut h, 0)
            push16(mut h, 0)
            push16(mut h, 0)
            push32(mut h, u64(crc32(data)))
            push32(mut h, u64(data.len()))
            push32(mut h, u64(data.len()))
            push16(mut h, name.len())
            push16(mut h, 0)
            if part == 1 {
                push16(mut h, 0)
                push16(mut h, 0)
                push16(mut h, 0)
                push32(mut h, 0)
                push32(mut h, u64(offset))
            }
            for b in name {
                h.push(b)
            }
            if part == 0 {
                for b in h {
                    out.push(b)
                }
                for b in data {
                    out.push(b)
                }
            } else {
                for b in h {
                    central.push(b)
                }
            }
        }
    }
    let at = out.len()
    for b in central {
        out.push(b)
    }
    push32(mut out, 0x06054b50)
    push16(mut out, 0)
    push16(mut out, 0)
    push16(mut out, files.len())
    push16(mut out, files.len())
    push32(mut out, u64(central.len()))
    push32(mut out, u64(at))
    push16(mut out, 0)
    return out
}

fn plain_meta() -> String {
    return String(#"{"pack":{"description":"a pack","min_format":121,"max_format":121}}"#)
}

fn rebalance_meta() -> String {
    return String(#"{"features":{"enabled":["minecraft:trade_rebalance"]},"pack":{"description":{"translate":"dataPack.trade_rebalance.description"},"min_format":121,"max_format":121}}"#)
}

// A stand-in for Mojang's archive: vanilla's pack, and the feature pack `trade_rebalance`.
fn vanilla() -> Zip {
    let files: List<(String, String)> = [
        ("data/minecraft/dimension_type/overworld.json", "vanilla"),
        ("data/minecraft/datapacks/trade_rebalance/", ""),
        ("data/minecraft/datapacks/trade_rebalance/pack.mcmeta", rebalance_meta()),
        ("data/minecraft/datapacks/trade_rebalance/data/minecraft/dimension_type/t.json", "rebalanced"),
    ]
    return Zip.open(zip(files))!
}

// The lines, each its level's letter and its message, then `|`.
fn lines_of(logs: List<Entry>) -> String {
    var out = String()
    for e in logs {
        let mark = match e.level {
            Level.Info => "I",
            Level.Warn => "W",
            Level.Error => "E",
        }
        out.push_str("{mark} {e.message}|")
    }
    return out
}

fn ids(r: Repository) -> String {
    var out = String()
    for p in r.packs {
        out.push_str("{p.id} ")
    }
    return out
}

fn joined(list: List<String>) -> String {
    var out = String()
    for s in list {
        if not out.is_empty() {
            out.push_str(",")
        }
        out.push_str(s)
    }
    return out
}

fn summary(s: Selection) -> String {
    return "[{joined(s.packs.enabled)}] [{joined(s.packs.disabled)}] {s.features}"
}

// The packs `setup` picks from the world's folder, the lines picking them, and the
// files of `dimension_type` they list.
fn picked(setup: Setup) -> String {
    var found = List<Entry>()
    var allow = AllowList.nothing()
    let r = discover(vanilla(), setup, mut allow, mut found)
    var logs = List<Entry>()
    let s = r.select(setup, mut logs)
    let chosen = summary(s)
    var opening = List<Entry>()
    let resources = r.open(s, mut opening)
    var files = String()
    for f in resources.list(String("dimension_type"), String(".json"), mut opening) {
        files.push_str("{f.id.path}@{f.pack} ")
    }
    return "{chosen} {lines_of(logs)}{files}{lines_of(opening)}"
}

fn made(datapacks: String, init: bool, enabled: List<String>, disabled: List<String>, features: u32) -> Setup {
    return Setup { datapacks: datapacks.copy(), make: true, safe: false, init: init, config: DataPacks { enabled: enabled.copy(), disabled: disabled.copy() }, features: features }
}

fn main() {
    let root = temp_dir()!
    let sep = separator()
    let folder = "{root}{sep}world{sep}datapacks"
    // A missing folder is made, and has nothing yet, so there's no fingerprint until it's made.
    let fresh = made(folder, true, ["vanilla"], [""], 1)
    check("{fingerprint(fresh) == none}", "true")
    var none_found = List<Entry>()
    var allow = AllowList.nothing()
    let empty = discover(vanilla(), fresh, mut allow, mut none_found)
    check("{ids(empty)}{lines_of(none_found)}", "trade_rebalance vanilla ")
    let before = fingerprint(fresh)!

    // A folder pack, a zip, a pack that needs trade_rebalance, and what isn't a pack.
    for dir in ["a_folder/data/minecraft/dimension_type", "e", "f"] {
        make_dir_all("{folder}/{dir}")!
    }
    write("{folder}/a_folder/pack.mcmeta", plain_meta().to_bytes())!
    write("{folder}/a_folder/data/minecraft/dimension_type/a.json", "a".to_bytes())!
    let b: List<(String, String)> = [("pack.mcmeta", plain_meta()), ("data/minecraft/dimension_type/b.json", "b")]
    write("{folder}/b.zip", zip(b))!
    write("{folder}/c.txt", "c".to_bytes())!
    write("{folder}/d.zip", [])!
    write("{folder}/f/pack.mcmeta", rebalance_meta().to_bytes())!
    let after = fingerprint(fresh)!
    check("{before == after}", "false")
    check("{fingerprint(fresh)! == after}", "true")

    var found = List<Entry>()
    var allow_again = AllowList.nothing()
    let r = discover(vanilla(), fresh, mut allow_again, mut found)
    check(ids(r), "file/a_folder file/b.zip file/f trade_rebalance vanilla ")
    let c = "{folder}{sep}c.txt"
    let d = "{folder}{sep}d.zip"
    let e = "{folder}{sep}e"
    check(lines_of(found), "I Found non-pack entry '{c}', ignoring|E Failed to open pack {d}\njava.util.zip.ZipException: zip file is empty|W Missing metadata in pack file/d.zip|I Found non-pack entry '{e}', ignoring|")

    // A new world loads every pack but the feature packs, and has the features they need.
    check(picked(fresh), "[vanilla,file/a_folder,file/b.zip,file/f] [trade_rebalance] 3 I Found new data pack file/a_folder, loading it automatically|I Found new data pack file/b.zip, loading it automatically|I Found new data pack file/f, loading it automatically|dimension_type/a.json@1 dimension_type/b.json@2 dimension_type/overworld.json@0 ")

    // A world with trade_rebalance on whose packs don't give it has its feature pack forced on,
    // after a pack it hasn't is warned of, and those it has off stay off.
    let forced = made(folder, false, ["vanilla", "file/gone"], ["file/b.zip", "file/f"], 3)
    check(picked(forced), "[vanilla,file/a_folder,trade_rebalance] [file/b.zip,file/f] 3 W Missing data pack file/gone|I Found new data pack file/a_folder, loading it automatically|I Found feature pack ('trade_rebalance') for requested feature, forcing to enabled|dimension_type/a.json@1 dimension_type/overworld.json@0 dimension_type/t.json@2 ")

    // A world without it turns off a pack that needs it, and doesn't load a new one that does.
    let without = made(folder, false, ["vanilla", "file/f", "file/a_folder"], ["file/b.zip"], 1)
    check(picked(without), "[vanilla,file/a_folder] [file/b.zip,file/f,trade_rebalance] 1 W Pack file/f requires features minecraft:trade_rebalance that are not enabled for this world, disabling pack.|dimension_type/a.json@1 dimension_type/overworld.json@0 ")
    let new_one = made(folder, false, ["vanilla"], ["file/a_folder", "file/b.zip"], 1)
    check(picked(new_one), "[vanilla] [file/a_folder,file/b.zip,file/f,trade_rebalance] 1 I Found new data pack file/f, but can't load it due to missing features minecraft:trade_rebalance|dimension_type/overworld.json@0 ")

    // A world with no features at all can load nothing, so vanilla's forced on.
    let nothing = made(folder, false, ["vanilla"], ["file/a_folder", "file/b.zip"], 0)
    check(picked(nothing), "[vanilla] [file/a_folder,file/b.zip,file/f,trade_rebalance] 1 I Found new data pack file/f, but can't load it due to missing features minecraft:trade_rebalance|W Pack vanilla requires features minecraft:vanilla that are not enabled for this world, disabling pack.|I No datapacks selected, forcing vanilla|dimension_type/overworld.json@0 ")

    // Safe mode loads vanilla's pack, and the feature packs the world needs, and turns nothing off.
    var safe = made(folder, false, ["vanilla", "file/a_folder"], [], 3)
    safe.safe = true
    check(picked(safe), "[vanilla,trade_rebalance] [] 3 I Found feature pack ('trade_rebalance') for requested feature, forcing to enabled|dimension_type/overworld.json@0 dimension_type/t.json@1 ")

    check(missing_flags(1, 3), "minecraft:trade_rebalance")
    check(missing_flags(3, 3), "")

    // A replay doesn't make the folder, and a missing one has a fingerprint.
    var replay = made("{root}{sep}elsewhere", false, ["vanilla"], [], 1)
    replay.make = false
    check("{fingerprint(replay) != none}", "true")
    remove_dir_all(root)!
    println("ok")
}
