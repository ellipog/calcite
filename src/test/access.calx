/// Checks who may join, as vanilla's `PlayerList.canPlayerLogin` decides from the lists in the
/// server's folder: the dates bans end on, the IP an address is banned by, the lists as they're
/// read, with their warnings, and the order the checks go in.
module test.access

import java.uuid.{Uuid}
import server.access.{Access, ban_ip, parse_date}
import server.log.{Entry}
import std.fs.{is_file, make_dir_all, read, remove_dir_all, temp_dir, write}
import std.time.{Timestamp}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn warnings(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        out.push_str("{e.message}|")
    }
    return out
}

fn put(folder: String, name: str, text: str) {
    match write("{folder}/{name}", String(text).to_bytes()) {
        ok => {},
        err(_) => panic("can't write {name}"),
    }
}

fn reason(a: Access, id: Uuid, ip: str, online: usize, max: i32, now: i64) -> String {
    let r = a.refusal(id, String(ip), online, max, Timestamp { unix_ms: now }) else return String("let in")
    return r.to_json()
}

fn main() {
    // `yyyy-MM-dd HH:mm:ss Z`, leniently: any count of digits, fields that carry, and the zone as
    // an offset.
    check("{parse_date(String("1970-01-01 00:00:00 +0000"))}", "some(0)")
    check("{parse_date(String("2026-10-29 12:00:00 +0100"))}", "some(1793271600000)")
    check("{parse_date(String("2026-10-29 12:00:00 -0230"))}", "some(1793284200000)")
    check("{parse_date(String("2026-10-32 12:00:00 +0100"))}", "{parse_date(String("2026-11-01 12:00:00 +0100"))}")
    check("{parse_date(String("2026-13-01 00:00:00 +0000"))}", "{parse_date(String("2027-01-01 00:00:00 +0000"))}")
    check("{parse_date(String("2026-1-5 3:4:5 +0000"))}", "{parse_date(String("2026-01-05 03:04:05 +0000"))}")
    check("{parse_date(String("2026-10-29 12:00:00 GMT+01:00"))}", "{parse_date(String("2026-10-29 12:00:00 +0100"))}")
    check("{parse_date(String("2026-10-29 12:00:00 UTC"))}", "{parse_date(String("2026-10-29 12:00:00 +0000"))}")
    check("{parse_date(String("2000-02-29 00:00:00 +0000 and more"))}", "some(951782400000)")
    check("{parse_date(String("forever"))}", "none")
    check("{parse_date(String("2026-10-29 12:00:00"))}", "none")
    check("{parse_date(String("2026-10-29 12:00:00 +01"))}", "none")

    // The IP is cut from the address as Java writes it, so IPv6 is cut at its first colon.
    check(ban_ip(String("/127.0.0.1:50412")), "127.0.0.1")
    check(ban_ip(String("/[0:0:0:0:0:0:0:1]:50412")), "[0")
    check(ban_ip(String("local")), "local")

    let folder = "{temp_dir()!}/calcite-access-test"
    match remove_dir_all(folder.copy()) {
        ok => {},
        err(_) => {},
    }
    match make_dir_all(folder.copy()) {
        ok => {},
        err(_) => panic("can't make {folder}"),
    }

    // Nothing there: no one is listed, and writing them makes each list as vanilla does.
    var lines = List<Entry>()
    let none_yet = Access.load(folder.copy(), true, mut lines)
    check("{none_yet.listed()} {warnings(lines)}", "0 ")
    Access.make_missing(folder.copy(), mut lines)
    check(String.from_utf8(read("{folder}/whitelist.json")!) ?? String(), "[]")
    check("{is_file("{folder}/ops.json")} {is_file("{folder}/banned-players.json")} {is_file("{folder}/banned-ips.json")}", "true true true")
    check(warnings(lines), "")

    let steve = Uuid.parse(String("8667ba71-b85a-4004-af54-457a9734eed7")) ?? Uuid.new(0, 0)
    let alex = Uuid.parse(String("ec561538-f3fd-461d-aff5-086b22154bce")) ?? Uuid.new(0, 0)
    let op = Uuid.parse(String("00000000-0000-0000-0000-000000000001")) ?? Uuid.new(0, 0)
    let banned = Uuid.parse(String("00000000-0000-0000-0000-000000000002")) ?? Uuid.new(0, 0)
    let stranger = Uuid.new(5, 5)

    // Steve is listed with a UUID Java reads leniently. An entry without a name names no one,
    // and the value that isn't an object stops the list, with what was read before it kept.
    put(folder, "whitelist.json", #"[{"uuid": "8667ba71-b85a-4004-af54-457a9734eed7", "name": "Steve"}, {"uuid": "ec561538-f3fd-461d-aff5-086b22154bce"}, 5, {"uuid": "00000000-0000-0000-0000-000000000009", "name": "Late"}]"#)
    put(folder, "ops.json", #"[{"uuid": "0-0-0-0-1", "name": "Op", "level": 4, "bypassesPlayerLimit": "TRUE"}]"#)
    put(folder, "banned-players.json", #"[{"uuid": "00000000-0000-0000-0000-000000000002", "name": "Banned", "created": "2026-01-01 00:00:00 +0000", "source": "Server", "expires": "forever", "reason": "Griefing"}, {"uuid": "8667ba71-b85a-4004-af54-457a9734eed7", "name": "Steve", "expires": "2026-10-29 12:00:00 +0000"}]"#)
    put(folder, "banned-ips.json", #"{"ip": "10.0.0.9"}"#)
    lines = List<Entry>()
    let a = Access.load(folder.copy(), true, mut lines)
    check(warnings(lines), "Failed to load ip banlist: banned-ips.json isn't a JSON array|Failed to load white-list: an entry in whitelist.json isn't an object|")
    check("{a.listed()}", "2")

    let noon: i64 = 1793275200000
    // A ban comes first, with its reason, then the whitelist, which lets ops past.
    check(reason(a, banned, "1.2.3.4", 0, 20, noon), #"{"translate":"multiplayer.disconnect.banned.reason","with":["Griefing"]}"#)
    check(reason(a, stranger, "1.2.3.4", 0, 20, noon), #"{"translate":"multiplayer.disconnect.not_whitelisted"}"#)
    check(reason(a, alex, "1.2.3.4", 0, 20, noon), #"{"translate":"multiplayer.disconnect.not_whitelisted"}"#)
    check(reason(a, op, "1.2.3.4", 0, 20, noon), "let in")
    // Steve's ban ends at noon: until then, noon included, it says when, and after, it's gone.
    let before = reason(a, steve, "1.2.3.4", 0, 20, noon)
    check("{before.starts_with(#"{"translate":"multiplayer.disconnect.banned.reason","with":[{"translate":"multiplayer.disconnect.banned.reason.default"}],"extra":[{"translate":"multiplayer.disconnect.banned.expiration","with":["2026-10-29 at "#)}", "true")
    check(reason(a, steve, "1.2.3.4", 0, 20, noon + 1), "let in")
    // A full server, which an op who may bypass the limit gets into anyway.
    check(reason(a, steve, "1.2.3.4", 20, 20, noon + 1), #"{"translate":"multiplayer.disconnect.server_full"}"#)
    check(reason(a, op, "1.2.3.4", 20, 20, noon), "let in")

    // Without the whitelist, anyone not banned; and an address's ban, after the whitelist.
    put(folder, "banned-ips.json", #"[{"ip": "10.0.0.9", "reason": "Spam"}]"#)
    lines = List<Entry>()
    let open = Access.load(folder.copy(), false, mut lines)
    check(warnings(lines), "Failed to load white-list: an entry in whitelist.json isn't an object|")
    check(reason(open, stranger, "1.2.3.4", 0, 20, noon), "let in")
    check(reason(open, stranger, "10.0.0.9", 0, 20, noon), #"{"translate":"multiplayer.disconnect.banned_ip.reason","with":["Spam"]}"#)
    check(reason(a, stranger, "10.0.0.9", 0, 20, noon), #"{"translate":"multiplayer.disconnect.not_whitelisted"}"#)

    // An empty file is no list, as Gson reads it, without a warning.
    put(folder, "ops.json", "  \n")
    lines = List<Entry>()
    _ = Access.load(folder.copy(), true, mut lines)
    check(warnings(lines), "Failed to load white-list: an entry in whitelist.json isn't an object|")

    remove_dir_all(folder)!
    println("ok")
}
