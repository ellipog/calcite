// A player's warden spawn tracker (CAL-275), as `WardenSpawnTracker` has it: read and saved as
// its codec does, its level fading and its cooldown counting down as it ticks, and the players a
// shrieker reaches warned together.
module test.warden_tracker

import nbt.tag.{Tag}
import world.warden_tracker.{MOST_WARNINGS, WARNING_COOLDOWN, WARNING_FADES, WardenTracker, try_warn}

fn check(ok_now: bool, what: str) {
    if not ok_now {
        panic(what)
    }
}

// Read and saved: each field 0 where it's missing, all of it new where one's negative.
fn saved() {
    let t = WardenTracker { since_warning: 7, level: 3, cooldown: 120 }
    let back = WardenTracker.from_tag(some(t.to_tag()))
    check(back.since_warning == 7 and back.level == 3 and back.cooldown == 120, "a tracker didn't read back as it was saved")
    var partial = JavaHashMap<String, Tag>()
    partial.insert(String("warning_level"), Tag.Int(2))
    let read = WardenTracker.from_tag(some(Tag.Compound(partial)))
    check(read.since_warning == 0 and read.level == 2 and read.cooldown == 0, "missing fields weren't 0")
    var wrong = JavaHashMap<String, Tag>()
    wrong.insert(String("warning_level"), Tag.Int(2))
    wrong.insert(String("cooldown_ticks"), Tag.Int(-1))
    let fresh = WardenTracker.from_tag(some(Tag.Compound(wrong)))
    check(fresh.level == 0 and fresh.cooldown == 0, "a negative field didn't make it new")
    check(WardenTracker.from_tag(none).level == 0, "no tag didn't make a new tracker")
    println("ok saved")
}

// Ticking: the cooldown down to 0, and the level down one each `WARNING_FADES` ticks.
fn ticks() {
    var t = WardenTracker { level: 2, cooldown: 2 }
    t.tick()
    t.tick()
    t.tick()
    check(t.cooldown == 0 and t.since_warning == 3, "the cooldown or the ticks since a warning")
    for _ in 0..(WARNING_FADES - 3) {
        t.tick()
    }
    check(t.level == 2 and t.since_warning == WARNING_FADES, "the level faded too soon")
    t.tick()
    check(t.level == 1 and t.since_warning == 0, "the level didn't fade")
    println("ok ticks")
}

// Warning: the highest level raised by one and copied to all, the cooldown started; none while
// any's on cooldown; never past `MOST_WARNINGS`.
fn warns() {
    var both = [WardenTracker { level: 1 }, WardenTracker { level: 3, since_warning: 50 }].to_list()
    check(try_warn(mut both) == some(4), "the highest level wasn't raised")
    check(both[0].level == 4 and both[1].level == 4 and both[0].cooldown == WARNING_COOLDOWN and both[0].since_warning == 0, "the raised tracker wasn't copied")
    check(try_warn(mut both) == none, "warned while on cooldown")
    var most = [WardenTracker { level: MOST_WARNINGS }].to_list()
    check(try_warn(mut most) == some(MOST_WARNINGS), "warned past the most")
    var none_here = List<WardenTracker>()
    check(try_warn(mut none_here) == none, "warned no one")
    println("ok warns")
}

fn main() {
    saved()
    ticks()
    warns()
    println("ok")
}
