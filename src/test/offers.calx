/// Checks what server.properties and the `codeofconduct` folder give configuration, as vanilla's
/// `DedicatedServer` and `DedicatedServerProperties` read them: the bug report link, the resource
/// pack with each of its warnings, and the code of conduct in each language, with the errors that
/// stop the server.
module test.offers

import chat.component.{Component}
import java.properties.{Properties}
import json.tree.{parse}
import protocol.common.{LinkKind}
import server.configuration.{read_codes, resource_pack, server_links}
import server.log.{Entry, Level}
import server.properties.{ServerProperties}
import std.fs.{temp_dir, is_dir, make_dir_all, remove_dir_all, write}

fn check(got: String, want: String) {
    if got != want {
        panic("got {got}, want {want}")
    }
}

fn logged(lines: List<Entry>) -> String {
    var out = String()
    for e in lines {
        let level = match e.level {
            Level.Info => "info",
            Level.Warn => "warn",
            Level.Error => "error",
        }
        out.push_str("{level}: {e.message}|")
    }
    return out
}

fn props(settings: List<(String, String)>) -> ServerProperties {
    var p = Properties.new()
    for (key, value) in settings {
        p.set(key.copy(), value.copy())
    }
    return ServerProperties.from(p)
}

// The bug report link a server with `link` sends, then what's logged.
fn links(link: String) -> String {
    var lines = List<Entry>()
    let all = server_links(props([(String("bug-report-link"), link.copy())]), mut lines)
    var out = String()
    for l in all {
        let kind = match l.kind {
            LinkKind.Known(id) => "{id}",
            LinkKind.Named(name) => name.to_json(),
        }
        out.push_str("{kind} {l.link}|")
    }
    return "{out}{logged(lines)}"
}

// The resource pack a server with `settings` offers, then what's logged.
fn pack(settings: List<(String, String)>) -> String {
    var lines = List<Entry>()
    let offer = resource_pack(props(settings), mut lines)
    let shown = match offer {
        some(p) => {
            let prompt = match p.prompt {
                some(c) => c.to_json(),
                none => String("none"),
            }
            "{p.id.to_string()} {p.url} [{p.hash}] {p.required} {prompt}"
        },
        none => String("none"),
    }
    return "{shown}|{logged(lines)}"
}

fn setting(key: str, value: own String) -> (String, String) {
    return (String(key), value)
}

// The pack with an ID and a hash, and `prompt`.
fn with_prompt(prompt: String) -> String {
    let sha1 = String("0123456789abcdefABCDEF0123456789abcdef01")
    return pack([setting("resource-pack", "https://example.com/pack.zip"), setting("resource-pack-id", "5627dd98-e6be-3c21-b8a8-e92344183641"), setting("resource-pack-sha1", sha1.copy()), setting("resource-pack-prompt", prompt.copy())])
}

fn codes(folder: String) -> String {
    return match read_codes(folder) {
        ok(all) => {
            var out = String()
            for c in all {
                out.push_str("{c.language}=[{c.text}]|")
            }
            out
        },
        err(e) => e,
    }
}

fn main() {
    let none_set = props([])
    check("{none_set.enable_code_of_conduct} [{none_set.bug_report_link}] [{none_set.resource_pack}] {none_set.resource_pack_hash == none} {none_set.require_resource_pack}", "false [] [] true false")

    // The bug report link is any http or https URI; one that isn't is logged, with why.
    check(links(""), "")
    check(links("https://example.com/bugs?x=1"), "0 https://example.com/bugs?x=1|")
    check(links("HTTP://Example.com"), "0 HTTP://Example.com|")
    check(links("example.com/bugs"), "warn: Failed to parse bug link example.com/bugs\njava.net.URISyntaxException: Missing protocol in URI: example.com/bugs: example.com/bugs|")
    check(links("ftp://example.com/"), "warn: Failed to parse bug link ftp://example.com/\njava.net.URISyntaxException: Unsupported protocol in URI: ftp://example.com/: ftp://example.com/|")
    check(links("https://exa mple.com/"), "warn: Failed to parse bug link https://exa mple.com/\njava.net.URISyntaxException: Illegal character in authority at index 11: https://exa mple.com/|")

    // A pack needs a URL. Without an ID, it gets one from the URL, which is logged, as is a
    // missing or bad hash.
    let url = setting("resource-pack", "https://example.com/pack.zip")
    let sha1 = String("0123456789abcdefABCDEF0123456789abcdef01")
    check(pack([setting("resource-pack-sha1", sha1.copy())]), "none|")
    check(pack([url.copy()]), "50227fe1-89d1-393b-8884-7d487e29fa5a https://example.com/pack.zip [] false none|warn: You specified a resource pack without providing a sha1 hash. Pack will be updated on the client only if you change the name of the pack.|warn: resource-pack-id missing, using default of 50227fe1-89d1-393b-8884-7d487e29fa5a|")
    let id = setting("resource-pack-id", "5627dd98-e6be-3c21-b8a8-e92344183641")
    check(pack([url.copy(), id.copy(), setting("resource-pack-sha1", sha1.copy()), setting("require-resource-pack", "true")]), "5627dd98-e6be-3c21-b8a8-e92344183641 https://example.com/pack.zip [{sha1}] true none|")
    // The old key is ignored beside the new one, and taken alone.
    check(pack([url.copy(), id.copy(), setting("resource-pack-sha1", sha1.copy()), setting("resource-pack-hash", "abc")]), "5627dd98-e6be-3c21-b8a8-e92344183641 https://example.com/pack.zip [{sha1}] false none|warn: resource-pack-hash is deprecated and found along side resource-pack-sha1. resource-pack-hash will be ignored.|")
    check(pack([url.copy(), id.copy(), setting("resource-pack-hash", "abc")]), "5627dd98-e6be-3c21-b8a8-e92344183641 https://example.com/pack.zip [abc] false none|warn: resource-pack-hash is deprecated. Please use resource-pack-sha1 instead.|warn: Invalid sha1 for resource-pack-sha1|")
    check(pack([url.copy(), id.copy(), setting("resource-pack-sha1", sha1.copy()), setting("resource-pack-hash", "")]), "5627dd98-e6be-3c21-b8a8-e92344183641 https://example.com/pack.zip [{sha1}] false none|")
    check(pack([url.copy(), id.copy(), setting("resource-pack-sha1", "{sha1}0")]), "5627dd98-e6be-3c21-b8a8-e92344183641 https://example.com/pack.zip [{sha1}0] false none|warn: Invalid sha1 for resource-pack-sha1|")
    // An ID that isn't a UUID means no pack.
    check(pack([url.copy(), setting("resource-pack-id", "not-a-uuid"), setting("resource-pack-sha1", sha1.copy())]), "none|warn: Failed to parse 'not-a-uuid' into UUID|")

    // The prompt is a component's JSON; one that isn't is logged, and the pack has none.
    let offered = "5627dd98-e6be-3c21-b8a8-e92344183641 https://example.com/pack.zip [{sha1}] false"
    check(with_prompt("\"Please\""), "{offered} \"Please\"|")
    check(with_prompt("\{\"text\":\"Please\",\"extra\":[\"!\"]\}"), "{offered} \{\"text\":\"Please\",\"extra\":[\"!\"]\}|")
    check(with_prompt("\{\"translate\":\"pack.prompt\",\"with\":[\"x\",2]\}"), "{offered} \{\"translate\":\"pack.prompt\",\"with\":[\"x\",\"2\"]\}|")
    check(with_prompt("\{bad"), "{offered} none|warn: Failed to parse resource pack prompt '\{bad'|")
    check(with_prompt("\{\}"), "{offered} none|warn: Failed to parse resource pack prompt '\{\}': No matching codec found|")
    check(with_prompt("[]"), "{offered} none|warn: Failed to parse resource pack prompt '[]': List must have contents|")

    // The code of conduct: each .txt file's lines, joined by \n, without § codes, in the
    // language its name gives, in lowercase.
    let dir = "{temp_dir()!}/calcite-offers-test"
    if is_dir(dir) {
        remove_dir_all(dir)!
    }
    make_dir_all(dir)!
    let folder = "{dir}/codeofconduct"
    check(codes(folder), "java.lang.IllegalArgumentException: Code of Conduct folder does not exist: {folder}")
    write(folder, [])!
    check(codes(folder), "java.lang.IllegalArgumentException: Code of Conduct folder does not exist: {folder}")
    remove_dir_all(dir)!
    make_dir_all(folder)!
    check(codes(folder), "")
    write("{folder}/en_US.txt", "Be §lnice§r.\r\nThanks§".to_bytes())!
    write("{folder}/fr_fr.txt", "a\r\nb\rc\n\nd\n".to_bytes())!
    write("{folder}/notes.md", "Not a code".to_bytes())!
    write("{folder}/codes.txt", "§§a§Kx§zy§\u{10}".to_bytes())!
    write("{folder}/empty.txt", [])!
    check(codes(folder), "codes=[§x§zy§\u{10}]|empty=[]|en_us=[Be nice.\nThanks§]|fr_fr=[a\nb\nc\n\nd]|")
    // A file that isn't UTF-8, or a folder named as a file, can't be read.
    write("{folder}/bad.txt", [0xC3, 0x28])!
    check(codes(folder), "java.lang.IllegalArgumentException: Failed to read Code of Conduct file bad.txt")
    remove_dir_all(folder)!
    make_dir_all("{folder}/inner.txt")!
    check(codes(folder), "java.lang.IllegalArgumentException: Failed to read Code of Conduct file inner.txt")
    remove_dir_all(dir)!

    // A parsed prompt is the component vanilla's codec gives.
    check(Component.from_json(parse("[\"a\",\{\"text\":\"b\"\}]")!)!.to_json(), "\{\"text\":\"a\",\"extra\":[\"b\"]\}")
    println("ok")
}
