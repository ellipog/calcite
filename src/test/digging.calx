/// Checks `world.digging` against what vanilla's player and game mode work out: Java's float to
/// int, each block's destroy speed and tool needs, a held tool's speed and whether it's right,
/// dig progress with the attributes, water and the ground, reach, the creative sword, a tool's
/// damage per block, durability with unbreaking's binomial, damage set in a stack's patch and a
/// stack shrunk, and adventure mode's `can_break`. The items are read against the vanilla data
/// pack's registries, from the server jar, as the rig's adapter loads them (D376).
module test.digging

import nbt.snbt.{parse}
import nbt.tag.{Tag}
import random.legacy.{LegacyRandom}
import rig.registries.{load_vanilla}
import world.attributes.{ADD_VALUE, Attributes, Modifier, attribute_id}
import world.digging.{can_destroy, correct_for_drops, damage_per_block, destroy_progress, destroy_speed, durability_change, in_reach, java_int, may_break_in_adventure, mining_speed, needs_tool, shrunk, with_damage}
import registry.components.{ItemCodecs}

fn check(got: String, want: String, what: String) {
    if got != want {
        panic("{what}: got {got}, want {want}")
    }
}

fn stack(text: str) -> Tag? {
    return some(parse(String(text))!)
}

fn block(items: ItemCodecs, name: str) -> i32 {
    return items.builtin_id("block", String(name)) ?? -1
}

fn main() {
    let loaded = load_vanilla()!
    let items = loaded.items.value.copy()

    // Java's `(int)` of a float.
    check("{java_int(2.9f32)} {java_int(-2.9f32)} {java_int(0.0f32 / 0.0f32)} {java_int(1.0e20f32)}", "2 -2 0 2147483647", "(int) of floats")

    // Destroy speeds and the blocks that need the right tool.
    let stone = block(items, "stone")
    let dirt = block(items, "dirt")
    let torch = block(items, "torch")
    let cobweb = block(items, "cobweb")
    let diamond_ore = block(items, "diamond_ore")
    check("{destroy_speed(stone)} {destroy_speed(dirt)} {destroy_speed(block(items, "bedrock"))} {destroy_speed(torch)} {destroy_speed(block(items, "obsidian"))}", "1.5 0.5 -1.0 0.0 50.0", "destroy speeds")
    check("{needs_tool(stone)} {needs_tool(dirt)} {needs_tool(diamond_ore)} {needs_tool(cobweb)}", "true false true true", "blocks that need the right tool")

    // A held tool's speed, by its rules, and whether it's right for a block's drops.
    let wooden_pickaxe = stack("\{id:\"minecraft:wooden_pickaxe\",count:1\}")
    let diamond_pickaxe = stack("\{id:\"minecraft:diamond_pickaxe\",count:1\}")
    let wooden_shovel = stack("\{id:\"minecraft:wooden_shovel\",count:1\}")
    let shears = stack("\{id:\"minecraft:shears\",count:1\}")
    let sword = stack("\{id:\"minecraft:diamond_sword\",count:1\}")
    let golden_pickaxe = stack("\{id:\"minecraft:golden_pickaxe\",count:1\}")
    check("{mining_speed(none, stone, items)} {mining_speed(wooden_pickaxe, stone, items)} {mining_speed(diamond_pickaxe, stone, items)} {mining_speed(wooden_shovel, dirt, items)} {mining_speed(wooden_shovel, stone, items)}", "1.0 2.0 8.0 2.0 1.0", "tool speeds")
    check("{mining_speed(shears, cobweb, items)} {mining_speed(sword, cobweb, items)} {mining_speed(golden_pickaxe, stone, items)}", "15.0 15.0 12.0", "shears', a sword's and gold's speeds")
    check("{correct_for_drops(wooden_pickaxe, stone, items)} {correct_for_drops(wooden_pickaxe, diamond_ore, items)} {correct_for_drops(diamond_pickaxe, diamond_ore, items)} {correct_for_drops(none, stone, items)} {correct_for_drops(sword, cobweb, items)}", "true false true false true", "right tools for drops")

    // Dig progress: the player's speed over the block's, over 30 with the right tool or 100
    // without; mining efficiency added past 1; under water with its instance made; a fifth off
    // the ground; and a block that breaks at once.
    var a = Attributes()
    check("{destroy_progress(none, dirt, items, mut a, false, true, -1, -1)}", "0.06666667", "dirt by hand")
    check("{destroy_progress(none, stone, items, mut a, false, true, -1, -1)}", "0.006666667", "stone by hand, without the right tool")
    check("{destroy_progress(wooden_pickaxe, stone, items, mut a, false, true, -1, -1)}", "0.044444446", "stone with a wooden pickaxe")
    check("{destroy_progress(wooden_pickaxe, stone, items, mut a, false, false, -1, -1)}", "0.008888889", "stone off the ground")
    check("{a.instances.len()}", "0", "instances made on land")
    check("{destroy_progress(wooden_pickaxe, stone, items, mut a, true, true, -1, -1)}", "0.008888889", "stone under water")
    check("{a.instances.len()}", "1", "submerged mining speed made under water")
    a.replace(attribute_id(String("mining_efficiency")) ?? 0, Modifier.named("efficiency", 26.0, ADD_VALUE))
    check("{destroy_progress(wooden_pickaxe, stone, items, mut a, false, true, -1, -1)}", "0.6222222", "stone with efficiency V's 26")
    check("{destroy_progress(none, stone, items, mut a, false, true, -1, -1)}", "0.006666667", "efficiency only past a speed of 1")
    check("{destroy_progress(none, torch, items, mut a, false, true, -1, -1) >= 1.0f32} {destroy_progress(none, block(items, "bedrock"), items, mut a, false, true, -1, -1)}", "true 0.0", "a torch at once, bedrock never")
    // Haste II, or the conduit's power, a fifth more a level; mining fatigue I 0.3 of it (D514).
    var plain = Attributes()
    check("{destroy_progress(wooden_pickaxe, stone, items, mut plain, false, true, 1, -1)}", "{2.0f32 * (1.0f32 + 2.0f32 * 0.2f32) / 1.5f32 / 30.0f32}", "stone with haste II")
    check("{destroy_progress(wooden_pickaxe, stone, items, mut plain, false, true, -1, 0)}", "{2.0f32 * 0.3f32 / 1.5f32 / 30.0f32}", "stone with mining fatigue I")

    // Reach: 4.5 and 1 from the eyes of a survival player.
    let b = Attributes()
    check("{in_reach(b, 0, 0.5, -60.0, 0.5, 5, -60, 1)} {in_reach(b, 0, 0.5, -60.0, 0.5, 6, -61, 0)} {in_reach(b, 0, 0.5, -60.0, 0.5, 12, -61, 0)}", "true false false", "reach")

    // A sword can't break blocks in creative mode; a tool's damage per block.
    check("{can_destroy(sword, items, true)} {can_destroy(sword, items, false)} {can_destroy(wooden_pickaxe, items, true)} {can_destroy(none, items, true)}", "false true true true", "what may break blocks in creative")
    check("{damage_per_block(sword, items) ?? -1} {damage_per_block(wooden_pickaxe, items) ?? -1} {damage_per_block(none, items) ?? -1}", "2 1 -1", "damage per block")

    // Durability: none for what isn't damageable or a player with infinite materials; unbreaking
    // III takes each point away at 3 in 4, a float drawn for each.
    let pick = (stack("\{id:\"minecraft:iron_pickaxe\",count:1\}")).copy() ?? Tag.End
    var r = LegacyRandom.new(42)
    check("{durability_change(pick, 1, items, false, mut r)} {durability_change(pick, 1, items, true, mut r)}", "1 0", "plain damage, and in creative")
    let dirt_stack = (stack("\{id:\"minecraft:dirt\",count:1\}")).copy() ?? Tag.End
    check("{durability_change(dirt_stack, 1, items, false, mut r)}", "0", "dirt isn't damageable")
    let unbreaking = (stack("\{id:\"minecraft:iron_pickaxe\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:unbreaking\":3\}\}\}")).copy() ?? Tag.End
    var drawn = LegacyRandom.new(7)
    var mirror = LegacyRandom.new(7)
    var want = 0
    var got = 0
    for _ in 0..20 {
        got += durability_change(unbreaking, 1, items, false, mut drawn)
        want += if mirror.next_float() < 0.75f32 { 0 } else { 1 }
    }
    check("{got}", "{want}", "unbreaking III over 20 uses")
    check("{durability_change(unbreaking, 10, items, false, mut drawn) <= 10}", "true", "unbreaking on more than one point")

    // Damage in a stack's patch, out of it where it's the item's own; a stack shrunk.
    let damaged = with_damage(pick, 5, items)
    check(damaged.to_snbt(), "\{components:\{\"minecraft:damage\":5\},count:1,id:\"minecraft:iron_pickaxe\"\}", "damage set")
    check(with_damage(damaged, 0, items).to_snbt(), "\{count:1,id:\"minecraft:iron_pickaxe\"\}", "damage back to the item's own")
    check(with_damage(pick, 9999, items).to_snbt(), "\{components:\{\"minecraft:damage\":250\},count:1,id:\"minecraft:iron_pickaxe\"\}", "damage kept to the most")
    let torches = (stack("\{id:\"minecraft:torch\",count:32\}")).copy() ?? Tag.End
    check((shrunk(torches, 1) ?? Tag.End).to_snbt(), "\{count:31,id:\"minecraft:torch\"\}", "one taken")
    check("{shrunk(torches, 32) == none}", "true", "all taken")

    // Adventure mode: `can_break`'s blocks, one predicate or a list.
    var missing = List<String>()
    let can_stone = stack("\{id:\"minecraft:diamond_pickaxe\",count:1,components:\{\"minecraft:can_break\":\{blocks:\"minecraft:stone\"\}\}\}")
    let can_list = stack("\{id:\"minecraft:diamond_pickaxe\",count:1,components:\{\"minecraft:can_break\":[\{blocks:\"minecraft:dirt\"\},\{blocks:\"#minecraft:mineable/pickaxe\"\}]\}\}")
    check("{may_break_in_adventure(can_stone, stone, items, mut missing)} {may_break_in_adventure(can_stone, dirt, items, mut missing)} {may_break_in_adventure(diamond_pickaxe, stone, items, mut missing)}", "true false false", "can_break one block")
    check("{may_break_in_adventure(can_list, dirt, items, mut missing)} {may_break_in_adventure(can_list, diamond_ore, items, mut missing)} {may_break_in_adventure(can_list, block(items, "oak_log"), items, mut missing)}", "true true false", "can_break a list, with a tag")
    check("{missing.len()}", "0", "nothing missing")
    println("ok")
}
