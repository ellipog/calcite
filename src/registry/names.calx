/// A registry's entries by name, as vanilla's `Registry.byNameCodec` and `holderByNameCodec` read
/// and write them in saves: as identifiers, failing with the messages vanilla's codecs fail with,
/// which the lines vanilla logs about a broken save quote.
module registry.names

import nbt.tag.{Tag}
import registry.registry.{Registry}
import resources.identifier.{Identifier}

/// A registry's entries by name, with the IDs a registry gives them.
pub struct Names {
    // The registry's name, as `minecraft:block`.
    registry: String
    // Each entry's name, as `minecraft:stone`, in ID order.
    names: List<String>
    ids: Map<String, u32>
}

impl Names {
    /// The entries of `registry`.
    pub fn from(registry: Registry) -> Names {
        var names = List<String>()
        var ids = Map<String, u32>()
        for i in 0..registry.entries.len() {
            let name = registry.entries[i].to_string()
            ids.insert(name.copy(), u32.wrap(i))
            names.push(name)
        }
        return Names { registry: registry.name.to_string(), names: names, ids: ids }
    }

    /// How many entries there are.
    pub fn len(self) -> u32 {
        return u32.wrap(self.names.len())
    }

    /// The name of the entry `id`, as `minecraft:stone`. Panics past the last entry.
    @track_caller
    pub fn name(self, id: u32) -> String {
        if usize(id) >= self.names.len() {
            panic("{id} isn't one of the {self.names.len()} entries of {self.registry}")
        }
        return self.names[usize(id)].copy()
    }

    /// The entry `tag` names, or what vanilla's codec fails with: `Not a string` unless it's a
    /// string, and otherwise as `parse` fails.
    pub fn decode(self, tag: Tag) -> u32 ! String {
        return match tag {
            Tag.Str(text) => try self.parse(text),
            _ => fail "Not a string",
        }
    }

    /// The entry `text` names, with `minecraft:` where it has no namespace, or what vanilla's
    /// codec fails with: `Not a valid resource location: ...` if it isn't an identifier, and
    /// `Unknown registry key in ResourceKey[minecraft:root / ...]: ...` if no entry has it.
    pub fn parse(self, text: String) -> u32 ! String {
        // A name as it's saved is found as it is, without parsing it.
        if let id = self.ids.get(text) {
            return id
        }
        let identifier = match Identifier.parse(text) {
            ok(i) => i,
            err(message) => fail "Not a valid resource location: {text} {message}",
        }
        let full = identifier.to_string()
        if let id = self.ids.get(full) {
            return id
        }
        fail "Unknown registry key in ResourceKey[minecraft:root / {self.registry}]: {full}"
    }

    /// The entry `id` as it's saved: its name, as a string. Panics past the last entry.
    @track_caller
    pub fn encode(self, id: u32) -> Tag {
        return Tag.Str(self.name(id))
    }
}
