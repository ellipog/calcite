/// The jukebox songs a world has, `JukeboxSong` (CAL-143). Each song is kept by its name, with
/// its ID in the `jukebox_song` registry, which the client plays it by; how long it is; and what
/// a comparator reads of a jukebox holding it. The items that play a song as their own
/// `jukebox_playable`, as music discs do, are kept too. `ItemCodecs.songs` makes the table from
/// the world's registries.
module registry.songs

import nbt.tag.{Tag}

/// A jukebox song, `JukeboxSong`: its ID in the `jukebox_song` registry, -1 for one that isn't
/// in it, its `length_in_seconds` and its `comparator_output`.
pub struct JukeboxSong {
    pub id: i32
    pub length: f32
    pub output: i32
}

impl JukeboxSong {
    /// `lengthInTicks`: its length in ticks, rounded up, `Mth.ceil`.
    pub fn ticks(self) -> i32 {
        let v = self.length * 20.0f32
        let i = i32.saturate(v)
        return if v > f32.nearest(f64(i)) { i + 1 } else { i }
    }

    /// `hasFinished`: whether a song `elapsed` ticks in has finished, 20 ticks after its length.
    pub fn finished(self, elapsed: i64) -> bool {
        return elapsed >= i64(self.ticks()) + 20
    }

    /// Whether a jukebox saved `elapsed` ticks into the song is playing it: up to the tick it
    /// stops on, once it's finished. One saved past that plays nothing once it's read, as
    /// `setSongWithoutPlaying` sets no song that's finished.
    pub fn playing(self, elapsed: i64) -> bool {
        return elapsed <= i64(self.ticks()) + 20
    }
}

/// The world's jukebox songs by name, as `minecraft:cat`, and the items that play one of them by
/// default, by item.
pub struct Songs {
    by_name: OpenHashMap<String, JukeboxSong> = OpenHashMap<String, JukeboxSong>()
    of_item: OpenHashMap<String, String> = OpenHashMap<String, String>()
}

impl Songs {
    /// Keeps the song `name`, as `minecraft:cat`.
    pub fn add(mut self, name: own String, song: own JukeboxSong) {
        self.by_name.insert(name, song)
    }

    /// Keeps that the item `item`, as `minecraft:music_disc_cat`, plays the song `song` by default.
    pub fn add_item(mut self, item: own String, song: own String) {
        self.of_item.insert(item, song)
    }

    /// `JukeboxSong.fromStack`: the song `stack` plays, as its `jukebox_playable` names it, the
    /// one its patch gives or else its item's, `none` where it has none or names one the world
    /// hasn't. A song given in full, not by name, is read as it's given, with no ID.
    pub fn of(self, stack: Tag) -> JukeboxSong? {
        let Tag.Compound(m) = stack else return none
        if m.contains("components") {
            if let Tag.Compound(patch) = m["components"].copy() {
                if patch.contains("minecraft:jukebox_playable") {
                    return self.named(patch["minecraft:jukebox_playable"].copy())
                }
                if patch.contains("!minecraft:jukebox_playable") {
                    return none
                }
            }
        }
        if not m.contains("id") {
            return none
        }
        let Tag.Str(item) = m["id"].copy() else return none
        if not self.of_item.contains(item.copy()) {
            return none
        }
        return self.by_name.get(self.of_item[item].copy())
    }

    // The song a `jukebox_playable` gives, by name or in full.
    fn named(self, given: Tag) -> JukeboxSong? {
        return match given {
            Tag.Str(name) => self.by_name.get(if name.contains(":") { name.copy() } else { "minecraft:{name}" }),
            Tag.Compound(song) => {
                if not song.contains("length_in_seconds") or not song.contains("comparator_output") {
                    return none
                }
                let length = song["length_in_seconds"].number_float() ?? 0.0f32
                let output = song["comparator_output"].number_int() ?? 0
                some(JukeboxSong { id: -1, length: length, output: output })
            },
            _ => none,
        }
    }
}
