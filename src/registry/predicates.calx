/// Advancements' predicates, described for `registry.codec`: what an item, an entity, a place,
/// a block, a fluid or a source of damage must be, as loot conditions test them, with the ranges
/// of numbers they're made of. Each reads what vanilla's codec reads from a data pack and gives
/// what it writes back.
module registry.predicates

import chat.language.{Language}
import json.tree.{Json}
import nbt.snbt.{parse}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.codec.{Codec, Codecs, Dispatched, Field, HolderCodec, HolderKind, Kinds, Many, MapOf, Read, Refs, Then, same}
import registry.codecs.{bool_codec, by_name, def, f64_codec, field, i32_codec, id, inline, opt, positive_int, read_compound_tag, req, string, text}
import registry.registries.{Registries}

/// `RegistryCodecs.holderSet(registry)`: a tag of `registry`, as `#` and its ID, or its entries
/// by ID, one alone or a list.
pub fn holder_set(c: mut Codecs, registry: String) -> usize {
    return c.shared("holder set {registry}", Codec.Holders(HolderCodec { registry: registry.copy(), inline: none, kind: HolderKind.Fixed }))
}

/// `MinMaxBounds.Ints.CODEC`: a range of ints.
pub fn ints(c: mut Codecs) -> usize {
    let n = i32_codec(mut c)
    return bounds(mut c, String("ints"), n)
}

/// `MinMaxBounds.Doubles.CODEC`: a range of doubles.
pub fn doubles(c: mut Codecs) -> usize {
    let n = f64_codec(mut c)
    return bounds(mut c, String("doubles"), n)
}

/// `MinMaxBounds.Ints.ANY` and the like, a range with no ends, as they're written.
pub fn any_range() -> Tag {
    return Tag.Compound(JavaHashMap<String, Tag>())
}

// A range of `number`s as `MinMaxBounds.Bounds.createCodec` reads it, `{min, max}` with either
// left out or one number alone for the range from it to it, then checked to be in order. It's
// written as the number where both ends are the same.
fn bounds(c: mut Codecs, name: String, number: usize) -> usize {
    let key = "bounds {name}"
    if let at = c.find(key) {
        return at
    }
    let fields: List<Field> = [opt("min", number), opt("max", number)]
    let range = c.add(Codec.Record(fields))
    let either = c.add(Codec.Either(range, number))
    return c.shared(key, Codec.Then(Then { of: either, then: check_bounds, with: Tag.End }))
}

fn check_bounds(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let (min, max) = match value {
        Tag.Compound(_) => (field(value, "min"), field(value, "max")),
        _ => (value.copy(), value.copy()),
    }
    let both = present(min) and present(max)
    if both and above(min, max) {
        return Read.bad("Swapped bounds in range: Optional[{number_text(min)}] is higher than Optional[{number_text(max)}]")
    }
    if both and same(min, max) {
        return Read.ok(min.copy())
    }
    var out = JavaHashMap<String, Tag>()
    if present(min) {
        out.insert(String("min"), min.copy())
    }
    if present(max) {
        out.insert(String("max"), max.copy())
    }
    return Read.ok(Tag.Compound(out))
}

fn present(value: Tag) -> bool {
    return match value {
        Tag.End => false,
        _ => true,
    }
}

// Whether `a` is above `b`, as `compareTo` orders `Integer`s and `Double`s.
fn above(a: Tag, b: Tag) -> bool {
    return match a {
        Tag.Int(x) => match b {
            Tag.Int(y) => x > y,
            _ => false,
        },
        Tag.Double(x) => match b {
            Tag.Double(y) => x.total_cmp(y) == Ordering.Greater,
            _ => false,
        },
        _ => false,
    }
}

fn number_text(value: Tag) -> String {
    return match value {
        Tag.Int(v) => "{v}",
        Tag.Double(v) => "{v}",
        _ => String(),
    }
}

/// `NbtPredicate.CODEC`: a compound, as SNBT text or as JSON, written as the text, as
/// `TagParser.LENIENT_CODEC` reads and writes it.
pub fn nbt(c: mut Codecs) -> usize {
    let key = String("nbt predicate")
    if let at = c.find(key) {
        return at
    }
    let snbt = c.add(Codec.Custom(read_snbt))
    let json = c.add(Codec.Custom(read_compound_tag))
    let either = c.add(Codec.Either(snbt, json))
    return c.shared(key, Codec.Then(Then { of: either, then: as_snbt, with: Tag.End }))
}

/// `TagParser.FLATTENED_CODEC`, made in `c`: a compound given as SNBT, written as the compound.
pub fn snbt_compound(c: mut Codecs) -> usize {
    return c.shared(String("snbt compound"), Codec.Custom(read_snbt))
}

// `TagParser.FLATTENED_CODEC`: a compound given as SNBT. A syntax error says what
// `CommandSyntaxException.getMessage` does, in the language of `c`.
fn read_snbt(c: Codecs, value: Json, _r: Registries) -> Read {
    let s = match value {
        Json.Str(s) => s.copy(),
        _ => return Read.bad(c.not_string(value)),
    }
    return match parse(s) {
        ok(tag) => if tag.id() == 10 { Read.ok(tag) } else { Read.bad("Expected compound tag, got {tag.to_snbt()}") },
        err(e) => Read.bad(match c.lang {
            some(lang) => e.text(lang),
            none => e.text(Language.empty()),
        }),
    }
}

// A compound as `CompoundTag.toString` writes it, which is how the predicate is written.
fn as_snbt(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return Read.ok(Tag.Str(value.to_snbt()))
}

// `StatePropertiesPredicate.CODEC`: each property's value, or the range of values it may have.
fn state_properties(c: mut Codecs) -> usize {
    let key = String("state properties")
    if let at = c.find(key) {
        return at
    }
    let s = string(mut c)
    let fields: List<Field> = [opt("min", s), opt("max", s)]
    let range = c.add(Codec.Record(fields))
    let matcher = c.add(Codec.Either(s, range))
    return c.shared(key, Codec.MapOf(MapOf { key: s, value: matcher }))
}

/// `BlockPredicate.CODEC` of advancements: which blocks, in which states, with what data and
/// components.
pub fn block(c: mut Codecs) -> usize {
    return c.named(String("block predicate"), make_block)
}

fn make_block(c: mut Codecs) -> Codec {
    let fields: List<Field> = [
        opt("blocks", holder_set(mut c, "minecraft:block")),
        opt("state", state_properties(mut c)),
        opt("nbt", nbt(mut c)),
        inline(matchers(mut c)),
    ]
    return Codec.Record(fields)
}

/// `ItemPredicate.CODEC`: which items, how many, with what components.
pub fn item(c: mut Codecs) -> usize {
    return c.named(String("item predicate"), make_item)
}

fn make_item(c: mut Codecs) -> Codec {
    let fields: List<Field> = [
        opt("items", holder_set(mut c, "minecraft:item")),
        def("count", ints(mut c), any_range()),
        inline(matchers(mut c)),
    ]
    return Codec.Record(fields)
}

// `DataComponentMatchers.CODEC`: the components something must have exactly, and the tests of
// the others.
fn matchers(c: mut Codecs) -> usize {
    return c.named(String("data component matchers"), make_matchers)
}

fn make_matchers(c: mut Codecs) -> Codec {
    let exact = exact_components(mut c)
    let fields: List<Field> = [
        def("components", exact, Tag.Compound(JavaHashMap<String, Tag>())),
        def("predicates", partial(mut c), Tag.Compound(JavaHashMap<String, Tag>())),
    ]
    return Codec.Record(fields)
}

// `DataComponentExactPredicate.CODEC`: each component type that's saved, by its ID, with the
// value an item's must be.
fn exact_components(c: mut Codecs) -> usize {
    return c.shared(String("exact components"), Codec.Nested(read_component_map))
}

// `DataComponentType.VALUE_MAP_CODEC`, as `registry.components` makes it in `c`, named
// `component map`. Where it hasn't, Calcite reads only a map that holds nothing.
fn read_component_map(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    if let at = c.find(String("component map")) {
        return c.read(at, value, r, mut refs)
    }
    return match value {
        Json.Object(members) => {
            if members.is_empty() {
                Read.ok(Tag.Compound(JavaHashMap<String, Tag>()))
            } else {
                Read.bad(String("Calcite can't read item components yet"))
            }
        },
        _ => Read.bad(c.not_map(value)),
    }
}

// `DataComponentPredicate.CODEC`: tests of components by their kind, where a component's own
// name tests only that it's there. A kind of test named as a component is the test.
fn partial(c: mut Codecs) -> usize {
    return c.named(String("data component predicates"), make_partial)
}

fn make_partial(c: mut Codecs) -> Codec {
    let tests = by_name(mut c, "minecraft:data_component_predicate_type")
    let components = by_name(mut c, "minecraft:data_component_type")
    let key = c.add(Codec.Either(tests, components))
    let n = ints(mut c)
    let d = doubles(mut c)
    let flag = bool_codec(mut c)
    let s = string(mut c)
    let stack = item(mut c)
    let damage_fields: List<Field> = [def("durability", n, any_range()), def("damage", n, any_range())]
    let enchantment_fields: List<Field> = [
        opt("enchantments", holder_set(mut c, "minecraft:enchantment")),
        def("levels", n, any_range()),
    ]
    let enchantment = c.add(Codec.Record(enchantment_fields))
    let enchantments = c.add(Codec.ListOf(Many { of: enchantment }))
    let container_fields: List<Field> = [opt("items", collection(mut c, stack))]
    let container = c.add(Codec.Record(container_fields))
    let shapes = c.add(Codec.Names(["small_ball", "large_ball", "star", "creeper", "burst"]))
    let explosion_fields: List<Field> = [opt("shape", shapes), opt("has_twinkle", flag), opt("has_trail", flag)]
    let explosion = c.add(Codec.Record(explosion_fields))
    let fireworks_fields: List<Field> = [opt("explosions", collection(mut c, explosion)), def("flight_duration", n, any_range())]
    let writable_fields: List<Field> = [opt("pages", collection(mut c, s))]
    let page = text(mut c)
    let written_fields: List<Field> = [
        opt("pages", collection(mut c, page)),
        opt("author", s),
        opt("title", s),
        def("generation", n, any_range()),
        opt("resolved", flag),
    ]
    let operations = c.add(Codec.Names(["add_value", "add_multiplied_base", "add_multiplied_total"]))
    let modifier_fields: List<Field> = [
        opt("attribute", holder_set(mut c, "minecraft:attribute")),
        opt("id", id(mut c)),
        def("amount", d, any_range()),
        opt("operation", operations),
        opt("slot", slot_groups(mut c)),
    ]
    let modifier = c.add(Codec.Record(modifier_fields))
    let modifiers_fields: List<Field> = [opt("modifiers", collection(mut c, modifier))]
    let trim_fields: List<Field> = [
        opt("material", holder_set(mut c, "minecraft:trim_material")),
        opt("pattern", holder_set(mut c, "minecraft:trim_pattern")),
    ]
    let song_fields: List<Field> = [opt("song", holder_set(mut c, "minecraft:jukebox_song"))]
    let tested: List<(String, usize)> = [
        ("damage", c.add(Codec.Record(damage_fields))),
        ("enchantments", enchantments),
        ("stored_enchantments", enchantments),
        ("potion_contents", potions(mut c)),
        ("custom_data", nbt(mut c)),
        ("container", container),
        ("bundle_contents", container),
        ("firework_explosion", explosion),
        ("fireworks", c.add(Codec.Record(fireworks_fields))),
        ("writable_book_content", c.add(Codec.Record(writable_fields))),
        ("written_book_content", c.add(Codec.Record(written_fields))),
        ("attribute_modifiers", c.add(Codec.Record(modifiers_fields))),
        ("trim", c.add(Codec.Record(trim_fields))),
        ("jukebox_playable", c.add(Codec.Record(song_fields))),
        ("villager/variant", holder_set(mut c, "minecraft:villager_type")),
    ]
    let no_fields: List<Field> = []
    let any = c.add(Codec.Record(no_fields))
    var values = List<(String, usize)>()
    let names = builtin_names()
    for i in 0..names.len() {
        if names[i] != "data_component_type" {
            continue
        }
        for component in builtin_entries(i) {
            var is_test = false
            for (t, _of) in tested {
                if t == component {
                    is_test = true
                }
            }
            if not is_test {
                values.push(("minecraft:{component}", any))
            }
        }
    }
    for (t, of) in tested {
        values.push(("minecraft:{t}", of))
    }
    return Codec.Dispatched(Dispatched { key: key, values: values })
}

/// `PotionsPredicate.CODEC`: the potions an item's contents may be, and the effects they must
/// have, as an item predicate and a brewing recipe's ingredients test them.
pub fn potions(c: mut Codecs) -> usize {
    let key = String("potions predicate")
    if let at = c.find(key) {
        return at
    }
    let effects = mob_effects(mut c)
    let fields: List<Field> = [
        opt("potions", holder_set(mut c, "minecraft:potion")),
        opt("effects", collection(mut c, effects)),
    ]
    return c.shared(key, Codec.Record(fields))
}

/// `EquipmentSlotGroup.CODEC`: which slots, by their group.
pub fn slot_groups(c: mut Codecs) -> usize {
    return c.shared(String("equipment slot group"), Codec.Names(["any", "mainhand", "offhand", "hand", "feet", "legs", "chest", "head", "armor", "body", "saddle"]))
}

// `CollectionPredicate.codec` of `of`: what a collection must contain, how many of its items
// must pass each test, and how many it holds.
fn collection(c: mut Codecs, of: usize) -> usize {
    let n = ints(mut c)
    let contains = c.add(Codec.ListOf(Many { of: of }))
    let count_fields: List<Field> = [req("test", of), req("count", n)]
    let count = c.add(Codec.Record(count_fields))
    let counts = c.add(Codec.ListOf(Many { of: count }))
    let fields: List<Field> = [opt("contains", contains), opt("count", counts), opt("size", n)]
    return c.add(Codec.Record(fields))
}

// `MobEffectsPredicate.CODEC`: the effects an entity must have, each with its amplifier and
// duration.
fn mob_effects(c: mut Codecs) -> usize {
    let key = String("mob effects predicate")
    if let at = c.find(key) {
        return at
    }
    let n = ints(mut c)
    let flag = bool_codec(mut c)
    let fields: List<Field> = [
        def("amplifier", n, any_range()),
        def("duration", n, any_range()),
        opt("ambient", flag),
        opt("visible", flag),
    ]
    let instance = c.add(Codec.Record(fields))
    let effect = by_name(mut c, "minecraft:mob_effect")
    return c.shared(key, Codec.MapOf(MapOf { key: effect, value: instance }))
}

/// `LocationPredicate.CODEC`: where a place is, what's there, and its light.
pub fn location(c: mut Codecs) -> usize {
    let key = String("location predicate")
    if let at = c.find(key) {
        return at
    }
    let d = doubles(mut c)
    let flag = bool_codec(mut c)
    let position_fields: List<Field> = [def("x", d, any_range()), def("y", d, any_range()), def("z", d, any_range())]
    let position = c.add(Codec.Record(position_fields))
    let light_fields: List<Field> = [def("light", ints(mut c), any_range())]
    let light = c.add(Codec.Record(light_fields))
    let fluid_fields: List<Field> = [opt("fluids", holder_set(mut c, "minecraft:fluid")), opt("state", state_properties(mut c))]
    let fluid = c.add(Codec.Record(fluid_fields))
    let fields: List<Field> = [
        opt("position", position),
        opt("biomes", holder_set(mut c, "minecraft:worldgen/biome")),
        opt("structures", holder_set(mut c, "minecraft:worldgen/structure")),
        opt("dimension", id(mut c)),
        opt("smokey", flag),
        opt("light", light),
        opt("block", block(mut c)),
        opt("fluid", fluid),
        opt("can_see_sky", flag),
    ]
    return c.shared(key, Codec.Record(fields))
}

/// `DamageSourcePredicate.CODEC`: the tags a source of damage must have or not, and the entities
/// that dealt it.
pub fn damage_source(c: mut Codecs) -> usize {
    let key = String("damage source predicate")
    if let at = c.find(key) {
        return at
    }
    let tag_fields: List<Field> = [req("id", holder_set(mut c, "minecraft:damage_type")), req("expected", bool_codec(mut c))]
    let tag = c.add(Codec.Record(tag_fields))
    let tags = c.add(Codec.ListOf(Many { of: tag }))
    let e = entity(mut c)
    let fields: List<Field> = [
        def("tags", tags, Tag.List(List<Tag>())),
        opt("direct_entity", e),
        opt("source_entity", e),
        opt("is_direct", bool_codec(mut c)),
    ]
    return c.shared(key, Codec.Record(fields))
}

/// `EntityPredicate.CODEC`: tests of an entity, each by its kind.
pub fn entity(c: mut Codecs) -> usize {
    return c.named(String("entity predicate"), make_entity)
}

fn make_entity(c: mut Codecs) -> Codec {
    let me = entity(mut c)
    let n = ints(mut c)
    let d = doubles(mut c)
    let flag = bool_codec(mut c)
    let stack = item(mut c)
    let place = location(mut c)
    let distance_fields: List<Field> = [
        def("x", d, any_range()), def("y", d, any_range()), def("z", d, any_range()),
        def("horizontal", d, any_range()), def("absolute", d, any_range()),
    ]
    let movement_fields: List<Field> = [
        def("x", d, any_range()), def("y", d, any_range()), def("z", d, any_range()),
        def("speed", d, any_range()), def("horizontal_speed", d, any_range()),
        def("vertical_speed", d, any_range()), def("fall_distance", d, any_range()),
    ]
    var flags_fields = List<Field>()
    for name in ["is_on_ground", "is_on_fire", "is_sneaking", "is_sprinting", "is_swimming", "is_flying", "is_baby", "is_in_water", "is_fall_flying"] {
        flags_fields.push(opt(String(name), flag))
    }
    var equipment_fields = List<Field>()
    for name in ["head", "chest", "legs", "feet", "body", "mainhand", "offhand"] {
        equipment_fields.push(opt(String(name), stack))
    }
    let slots = c.add(Codec.Names(slot_ranges()))
    let s = string(mut c)
    let strings = c.add(Codec.ListOf(Many { of: s }))
    let tags_fields: List<Field> = [opt("any_of", strings), opt("all_of", strings), opt("none_of", strings)]
    let lightning_fields: List<Field> = [def("blocks_set_on_fire", n, any_range()), opt("entity_struck", me)]
    let hook_fields: List<Field> = [opt("in_open_water", flag)]
    let cube_fields: List<Field> = [def("size", n, any_range())]
    let raider_fields: List<Field> = [def("has_raid", flag, Tag.Byte(0i8)), def("is_captain", flag, Tag.Byte(0i8))]
    let sheep_fields: List<Field> = [opt("sheared", flag)]
    let values: List<(String, usize)> = [
        ("minecraft:entity_type", holder_set(mut c, "minecraft:entity_type")),
        ("minecraft:location", place),
        ("minecraft:stepping_on", place),
        ("minecraft:movement_affected_by", place),
        ("minecraft:distance", c.add(Codec.Record(distance_fields))),
        ("minecraft:movement", c.add(Codec.Record(movement_fields))),
        ("minecraft:effects", mob_effects(mut c)),
        ("minecraft:nbt", nbt(mut c)),
        ("minecraft:flags", c.add(Codec.Record(flags_fields))),
        ("minecraft:equipment", c.add(Codec.Record(equipment_fields))),
        ("minecraft:periodic_tick", positive_int(mut c)),
        ("minecraft:vehicle", me),
        ("minecraft:passenger", me),
        ("minecraft:targeted_entity", me),
        ("minecraft:team", s),
        ("minecraft:slots", c.add(Codec.MapOf(MapOf { key: slots, value: stack }))),
        ("minecraft:components", exact_components(mut c)),
        ("minecraft:predicates", partial(mut c)),
        ("minecraft:entity_tags", c.add(Codec.Record(tags_fields))),
        ("minecraft:type_specific/lightning", c.add(Codec.Record(lightning_fields))),
        ("minecraft:type_specific/fishing_hook", c.add(Codec.Record(hook_fields))),
        ("minecraft:type_specific/player", player(mut c)),
        ("minecraft:type_specific/cube_mob", c.add(Codec.Record(cube_fields))),
        ("minecraft:type_specific/raider", c.add(Codec.Record(raider_fields))),
        ("minecraft:type_specific/sheep", c.add(Codec.Record(sheep_fields))),
    ]
    let key = by_name(mut c, "minecraft:entity_sub_predicate_type")
    return Codec.Dispatched(Dispatched { key: key, values: values })
}

/// `SlotRanges`: the names of an entity's slots and ranges of them.
pub fn slot_ranges() -> List<String> {
    var out: List<String> = [String("contents")]
    let ranges: List<(String, i32)> = [
        ("container.", 54), ("hotbar.", 9), ("inventory.", 27), ("enderchest.", 27), ("mob.inventory.", 8), ("horse.", 15),
    ]
    for (prefix, size) in ranges {
        for i in 0..size {
            out.push("{prefix}{i}")
        }
        out.push("{prefix}*")
    }
    for name in [
        "weapon", "weapon.mainhand", "weapon.offhand", "weapon.*", "armor.head", "armor.chest", "armor.legs",
        "armor.feet", "armor.body", "armor.*", "saddle", "horse.chest", "player.cursor",
    ] {
        out.push(String(name))
    }
    for i in 0..4 {
        out.push("player.crafting.{i}")
    }
    out.push(String("player.crafting.*"))
    return out
}

// `PlayerPredicate.CODEC`: a player's level, food, game mode, stats, recipes, advancements,
// what they look at and the keys they hold.
fn player(c: mut Codecs) -> usize {
    let n = ints(mut c)
    let flag = bool_codec(mut c)
    let food_fields: List<Field> = [def("level", n, any_range()), def("saturation", doubles(mut c), any_range())]
    let food = c.add(Codec.Record(food_fields))
    let modes: List<String> = ["survival", "creative", "adventure", "spectator"]
    let mode = c.add(Codec.Names(modes.copy()))
    let gamemodes = c.add(Codec.ListOf(Many { of: mode }))
    var all_modes = List<Tag>()
    for m in modes {
        all_modes.push(Tag.Str(m.copy()))
    }
    var kinds = List<(String, usize)>()
    let names = builtin_names()
    for i in 0..names.len() {
        if names[i] != "stat_type" {
            continue
        }
        for kind in builtin_entries(i) {
            let registry = if kind == "mined" {
                "minecraft:block"
            } else if kind == "killed" or kind == "killed_by" {
                "minecraft:entity_type"
            } else if kind == "custom" {
                "minecraft:custom_stat"
            } else {
                "minecraft:item"
            }
            let stat = by_name(mut c, String(registry))
            let stat_fields: List<Field> = [req("stat", stat), def("value", n, any_range())]
            kinds.push(("minecraft:{kind}", c.add(Codec.Record(stat_fields))))
        }
    }
    let stat_type = by_name(mut c, "minecraft:stat_type")
    let stat = c.add(Codec.Dispatch(Kinds { key: "type", by: stat_type, kinds: kinds }))
    let stats = c.add(Codec.ListOf(Many { of: stat }))
    let key = id(mut c)
    let s = string(mut c)
    let recipes = c.add(Codec.MapOf(MapOf { key: key, value: flag }))
    let criteria = c.add(Codec.MapOf(MapOf { key: s, value: flag }))
    let done_or_criteria = c.add(Codec.Either(flag, criteria))
    let advancements = c.add(Codec.MapOf(MapOf { key: key, value: done_or_criteria }))
    var input_fields = List<Field>()
    for name in ["forward", "backward", "left", "right", "jump", "sneak", "sprint"] {
        input_fields.push(opt(String(name), flag))
    }
    let input = c.add(Codec.Record(input_fields))
    let fields: List<Field> = [
        def("level", n, any_range()),
        def("food", food, Tag.Compound(JavaHashMap<String, Tag>())),
        def("gamemode", gamemodes, Tag.List(all_modes)),
        def("stats", stats, Tag.List(List<Tag>())),
        def("recipes", recipes, Tag.Compound(JavaHashMap<String, Tag>())),
        def("advancements", advancements, Tag.Compound(JavaHashMap<String, Tag>())),
        opt("looking_at", entity(mut c)),
        opt("input", input),
    ]
    return c.add(Codec.Record(fields))
}
