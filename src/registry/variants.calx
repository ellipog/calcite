/// The mob variants as the server reads them, `DIRECT_CODEC`: what clients are sent, then the
/// `spawn_conditions` that pick which spawns get each variant, which only the server reads, so a
/// pack's variant without them, or with ones that don't read, fails as it fails in vanilla. A
/// client is sent the variant without them, as `NETWORK_CODEC` writes it.
module registry.variants

import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Field, Kinds, Many, Read, Then}
import registry.codecs.{by_name, i32_codec, inline, opt, registry_codec, req}
import registry.predicates.{doubles, holder_set}

/// The server's codec for the variant registry `name`, if it's one of the variants with spawn
/// conditions.
pub fn variant_codec(c: mut Codecs, name: String) -> usize? {
    var known = false
    for v in ["wolf_variant", "pig_variant", "frog_variant", "cat_variant", "cow_variant", "chicken_variant", "zombie_nautilus_variant"] {
        known = known or name == String(v)
    }
    if not known {
        return none
    }
    let base = registry_codec(mut c, name) else return none
    let fields: List<Field> = [inline(base), req("spawn_conditions", spawn_selectors(mut c))]
    let record = c.shared("{name} full", Codec.Record(fields))
    return some(c.add(Codec.Then(Then { of: record, then: without, with: Tag.Str(String("spawn_conditions")) })))
}

/// The codec the server reads the variant registry `name` with in full, with its spawn
/// conditions, once `variant_codec` has made it; none for the others.
pub fn variant_full(c: Codecs, name: String) -> usize? {
    return c.find("{name} full")
}

// `SpawnPrioritySelectors.CODEC`: each selector a priority and, if any, the condition a spawn
// needs for it: a biome, the moon's brightness or a structure.
fn spawn_selectors(c: mut Codecs) -> usize {
    let key = String("spawn priority selectors")
    if let at = c.find(key) {
        return at
    }
    let biome_fields: List<Field> = [req("biomes", holder_set(mut c, "minecraft:worldgen/biome"))]
    let moon_fields: List<Field> = [req("range", doubles(mut c))]
    let structure_fields: List<Field> = [req("structures", holder_set(mut c, "minecraft:worldgen/structure"))]
    let kinds: List<(String, usize)> = [
        ("minecraft:structure", c.add(Codec.Record(structure_fields))),
        ("minecraft:moon_brightness", c.add(Codec.Record(moon_fields))),
        ("minecraft:biome", c.add(Codec.Record(biome_fields))),
    ]
    let by = by_name(mut c, "minecraft:spawn_condition_type")
    let condition = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    let selector_fields: List<Field> = [opt("condition", condition), req("priority", i32_codec(mut c))]
    let selector = c.add(Codec.Record(selector_fields))
    return c.shared(key, Codec.ListOf(Many { of: selector }))
}

// The value without the field `with` names, as the network codec leaves it out.
fn without(_c: Codecs, value: Tag, with: Tag) -> Read {
    let name = match with {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    match value {
        Tag.Compound(m) => {
            var out = m.copy()
            _ = out.remove(name)
            return Read.ok(Tag.Compound(out))
        },
        _ => return Read.ok(value.copy()),
    }
}
