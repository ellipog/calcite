/// Loot tables' codecs, described for `registry.codec` (CAL-153): `LootTable.DIRECT_CODEC`, its
/// pools, the nine kinds of entry `LootPoolEntries` registers, the 42 item modifiers
/// `LootItemFunctions` registers and the six slot sources `SlotSources` does, each reading what
/// vanilla's codec reads from a data pack's `loot_table/`, `item_modifier/` and `slot_source/`
/// and giving what it writes back. Conditions and the context providers are `registry.loot`'s.
///
/// Each of these registries is reloadable, read with the others as `ReloadableServerRegistries`
/// reads them, so an entry of one can name an entry of another, which must be there once they've
/// all been read.
module registry.loot_tables

import json.tree.{Json, Member}
import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Field, HolderCodec, HolderKind, IntRange, Kinds, Many, MapOf, Need, Read, Refs, Then, given}
import registry.codecs.{bool_codec, by_name, def, f32_codec, i32_codec, i64_codec, id, inline, non_negative_int, not_air, opt, positive_int, req, rgb_int, string, string_within, text}
import registry.components.{banner_layers, component_patch, filterable, firework_explosion, writable_pages, written_pages}
import registry.loot.{condition, condition_direct, context_float, context_int, entity_target, nbt_path}
import registry.predicates.{holder_set, item, nbt, slot_groups, slot_ranges}
import registry.registries.{Registries}
import world.states.{StateCodec}

/// `LootTable.DIRECT_CODEC`: a table, with the kind of loot it's for, its random sequence, its
/// pools and what modifies all it gives. A kind it doesn't know is the generic one, as
/// `lenientOptionalFieldOf` reads it.
pub fn loot_table(c: mut Codecs) -> usize {
    return c.named(String("loot table"), make_table)
}

fn make_table(c: mut Codecs) -> Codec {
    let one_pool = pool(mut c)
    let pools = c.add(Codec.ListOf(Many { of: one_pool }))
    let nothing: List<Tag> = []
    let sets = by_name(mut c, "minecraft:context_key_set")
    let ids = id(mut c)
    let modifier = item_modifier(mut c)
    let fields: List<Field> = [
        Field { name: String("type"), of: sets, need: Need.Lenient(Tag.Str(String("minecraft:generic"))) },
        opt("random_sequence", ids),
        def("pools", pools, Tag.List(nothing)),
        opt("modifier", modifier),
    ]
    return Codec.Record(fields)
}

/// `LootTable.CODEC`: a table by its ID, or given in full.
pub fn loot_table_holder(c: mut Codecs) -> usize {
    return c.named(String("loot table holder"), make_table_holder)
}

fn make_table_holder(c: mut Codecs) -> Codec {
    return Codec.Holder(HolderCodec { registry: "minecraft:loot_table", inline: some(loot_table(mut c)) })
}

// `LootTable.LIST_CODEC`: a tag of tables, or a list of them, each by its ID or in full.
fn loot_tables(c: mut Codecs) -> usize {
    return c.named(String("loot tables"), make_tables)
}

fn make_tables(c: mut Codecs) -> Codec {
    return Codec.Holders(HolderCodec { registry: "minecraft:loot_table", inline: some(loot_table(mut c)) })
}

// `LootPool.CODEC`: its entries, a condition and a modifier for all of them, and how many times
// it rolls, with more for each point of luck.
fn pool(c: mut Codecs) -> usize {
    return c.named(String("loot pool"), make_pool)
}

fn make_pool(c: mut Codecs) -> Codec {
    let one_entry = entry(mut c)
    let entries = c.add(Codec.ListOf(Many { of: one_entry }))
    let test = condition(mut c)
    let modifier = item_modifier(mut c)
    let rolls = context_int(mut c)
    let bonus = context_float(mut c)
    let fields: List<Field> = [req("entries", entries), opt("condition", test), opt("modifier", modifier), req("rolls", rolls), def("bonus_rolls", bonus, Tag.Float(0.0f32))]
    return Codec.Record(fields)
}

// `LootPoolEntries.CODEC`: an entry by its kind.
fn entry(c: mut Codecs) -> usize {
    return c.named(String("loot pool entry"), make_entry)
}

fn make_entry(c: mut Codecs) -> Codec {
    let me = entry(mut c)
    let nothing: List<Tag> = []
    let children = c.add(Codec.ListOf(Many { of: me }))
    // `CompositeEntryBase.createCodec`: its children, then the common fields.
    let test = condition(mut c)
    let modifier = item_modifier(mut c)
    let composite_fields: List<Field> = [def("children", children, Tag.List(nothing)), opt("condition", test), opt("modifier", modifier)]
    let composite = c.add(Codec.Record(composite_fields))
    let item_name = item_codec(mut c)
    let item_fields: List<Field> = with_uniform(mut c, [req("name", item_name)])
    let ids = id(mut c)
    let dynamic_fields: List<Field> = with_uniform(mut c, [req("name", ids)])
    let empty_fields: List<Field> = with_uniform(mut c, [])
    let tables = loot_tables(mut c)
    let nested_fields: List<Field> = with_expandable(mut c, [req("value", tables)])
    let items = holder_set(mut c, "minecraft:item")
    let tag_fields: List<Field> = with_expandable(mut c, [req("items", items)])
    let sources = slot_source(mut c)
    let slots_fields: List<Field> = with_uniform(mut c, [req("slot_source", sources)])
    let kinds: List<(String, usize)> = [
        ("minecraft:empty", c.add(Codec.Record(empty_fields))),
        ("minecraft:item", c.add(Codec.Record(item_fields))),
        ("minecraft:loot_table", c.add(Codec.Record(nested_fields))),
        ("minecraft:dynamic", c.add(Codec.Record(dynamic_fields))),
        ("minecraft:tag", c.add(Codec.Record(tag_fields))),
        ("minecraft:slots", c.add(Codec.Record(slots_fields))),
        ("minecraft:alternatives", composite),
        ("minecraft:sequence", composite),
        ("minecraft:group", composite),
    ]
    let by = by_name(mut c, "minecraft:loot_pool_entry_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `UniformContainerBase.uniformFields` after an entry's own: its weight, 1 by default, its quality,
// a condition and a modifier.
fn with_uniform(c: mut Codecs, own_fields: own List<Field>) -> List<Field> {
    var out = own_fields
    let n = i32_codec(mut c)
    out.push(def("weight", n, Tag.Int(1)))
    out.push(def("quality", n, Tag.Int(0)))
    let test = condition(mut c)
    out.push(opt("condition", test))
    let modifier = item_modifier(mut c)
    out.push(opt("modifier", modifier))
    return out
}

// `ExpandableContainerBase.expandableFields`: whether it's each of what it holds, then the
// uniform fields.
fn with_expandable(c: mut Codecs, own_fields: own List<Field>) -> List<Field> {
    var out = own_fields
    let flag = bool_codec(mut c)
    out.push(def("expand", flag, Tag.Byte(0i8)))
    return with_uniform(mut c, out)
}

// `Item.CODEC`: an item by its ID, not air.
fn item_codec(c: mut Codecs) -> usize {
    let key = String("item not air")
    if let at = c.find(key) {
        return at
    }
    let items = by_name(mut c, "minecraft:item")
    return c.shared(key, Codec.Then(Then { of: items, then: not_air, with: Tag.End }))
}

/// `LootItemFunctions.CODEC`: an item modifier by its ID, or given in full, a list of them given
/// in full being one that runs each in turn.
pub fn item_modifier(c: mut Codecs) -> usize {
    return c.named(String("item modifier"), make_modifier)
}

fn make_modifier(c: mut Codecs) -> Codec {
    return Codec.Holder(HolderCodec { registry: "minecraft:item_modifier", inline: some(modifier_direct(mut c)) })
}

// `LootItemFunctions.LIST_CODEC`: a tag of them, or a list, each by its ID or given in full by
// its kind.
fn item_modifiers(c: mut Codecs) -> usize {
    return c.named(String("item modifiers"), make_modifiers)
}

fn make_modifiers(c: mut Codecs) -> Codec {
    return Codec.Holders(HolderCodec { registry: "minecraft:item_modifier", inline: some(modifier_typed(mut c)) })
}

/// `LootItemFunctions.DIRECT_CODEC`: a modifier by its kind, or a list, as a `sequence` given
/// inline, `SequenceFunction.INLINE_CODEC`.
pub fn modifier_direct(c: mut Codecs) -> usize {
    return c.named(String("item modifier direct"), make_modifier_direct)
}

fn make_modifier_direct(c: mut Codecs) -> Codec {
    return Codec.Either(modifier_typed(mut c), item_modifiers(mut c))
}

/// `LootItemFunctions.TYPED_CODEC`: a modifier by its kind, as an `item_modifier/` file is.
pub fn modifier_typed(c: mut Codecs) -> usize {
    return c.named(String("item modifier typed"), make_modifier_typed)
}

fn make_modifier_typed(c: mut Codecs) -> Codec {
    let me = item_modifier(mut c)
    let list = item_modifiers(mut c)
    let flag = bool_codec(mut c)
    let n = i32_codec(mut c)
    let ints = context_int(mut c)
    let floats = context_float(mut c)
    let s = string(mut c)
    let enchantment = c.add(Codec.Holder(HolderCodec { registry: "minecraft:enchantment", inline: none, kind: HolderKind.Fixed }))
    let enchantments = holder_set(mut c, "minecraft:enchantment")
    let nothing: List<Tag> = []
    let target = entity_target(mut c)
    let component_types = by_name(mut c, "minecraft:data_component_type")
    let component_list = c.add(Codec.ListOf(Many { of: component_types }))
    let container = container_component(mut c)
    let one_entry = entry(mut c)
    let entries = c.add(Codec.ListOf(Many { of: one_entry }))
    let one_text = text(mut c)
    let texts = c.add(Codec.ListOf(Many { of: one_text, max: 256 }))
    let not_air_item = item_codec(mut c)
    let enchantment_map = c.add(Codec.MapOf(MapOf { key: enchantment, value: ints }))
    let tag = nbt(mut c)
    let patch = component_patch(mut c)
    let attributes = attribute_modifiers(mut c)
    let name_target = c.add(Codec.Names(["custom_name", "item_name"]))
    let text_codec = text(mut c)
    let exploration = exploration_fields(mut c)
    let stew = stew_effects(mut c)
    let name_source = arg_names(mut c, "entity or block", entity_or_block())
    let filter = item(mut c)
    let limit = int_limit(mut c)
    let formula = bonus_formula(mut c)
    let table_id = named_table(mut c)
    let seed = i64_codec(mut c)
    let lore_mode = list_operation(mut c, 256)
    let nbt_source = nbt_provider(mut c)
    let operations = copy_operations(mut c)
    let blocks = by_name(mut c, "minecraft:block")
    let names = c.add(Codec.ListOf(Many { of: s }))
    let layers = banner_layers(mut c)
    let potion = by_name(mut c, "minecraft:potion")
    let potions = holder_set(mut c, "minecraft:potion")
    let instruments = holder_set(mut c, "minecraft:instrument")
    let component_source = arg_names(mut c, "component source", component_sources())
    let explosion = firework_explosion(mut c)
    let explosions = stand_alone(mut c, explosion, 256)
    let flight = c.add(Codec.Int(IntRange { min: 0, max: 255, before: String("Unsigned byte was out of range: ") }))
    let fireworks = firework_fields(mut c)
    let short = string_within(mut c, 0, 32)
    let title = filterable(mut c, short)
    let generation = c.add(Codec.Int(IntRange { min: 0, max: 3, before: String("Value must be within range [0;3]: ") }))
    let written = written_pages(mut c)
    let all_pages = list_operation(mut c, 2147483647)
    let writable = writable_pages(mut c)
    let hundred_pages = list_operation(mut c, 100)
    let toggles = c.add(Codec.MapOf(MapOf { key: component_types, value: flag }))
    let model_data = model_data_fields(mut c)
    // Each kind's own fields, after `LootItemConditionalFunction.commonFields`, its condition.
    let set_count: List<Field> = [req("count", ints), def("add", flag, Tag.Byte(0i8))]
    let set_item: List<Field> = [req("item", not_air_item)]
    let with_levels: List<Field> = [req("levels", ints), opt("options", enchantments), def("include_additional_cost_component", flag, Tag.Byte(0i8))]
    let randomly: List<Field> = [opt("options", enchantments), def("only_compatible", flag, Tag.Byte(1i8)), def("include_additional_cost_component", flag, Tag.Byte(0i8))]
    let set_enchantments: List<Field> = [def("enchantments", enchantment_map, Tag.Compound(JavaHashMap<String, Tag>())), def("add", flag, Tag.Byte(0i8))]
    let custom_data: List<Field> = [req("tag", tag)]
    let components: List<Field> = [req("components", patch)]
    let smelt: List<Field> = [def("use_input_count", flag, Tag.Byte(1i8))]
    let count_increase: List<Field> = [req("enchantment", enchantment), req("count", floats), def("limit", n, Tag.Int(0))]
    let damage: List<Field> = [req("damage", floats), def("add", flag, Tag.Byte(0i8))]
    let set_attributes: List<Field> = [req("modifiers", attributes), def("replace", flag, Tag.Byte(1i8))]
    let set_name: List<Field> = [opt("name", text_codec), opt("entity", target), def("target", name_target, Tag.Str(String("custom_name")))]
    let effects: List<Field> = [def("effects", stew, Tag.List(nothing.copy()))]
    let copy_name: List<Field> = [req("source", name_source)]
    let set_contents: List<Field> = [req("component", container), req("entries", entries)]
    let modify_contents: List<Field> = [req("component", container), req("modifier", me)]
    let filtered: List<Field> = [req("item_filter", filter), opt("on_pass", me), opt("on_fail", me)]
    let limit_count: List<Field> = [req("limit", limit)]
    let apply_bonus: List<Field> = [req("enchantment", enchantment), inline(formula)]
    let set_loot_table: List<Field> = [req("loot_table_id", table_id), def("seed", seed, Tag.Long(0))]
    let lore: List<Field> = [req("lore", texts), inline(lore_mode), opt("entity", target)]
    let head: List<Field> = [req("entity", target)]
    let copy_custom: List<Field> = [req("source", nbt_source), req("ops", operations)]
    let copy_state: List<Field> = [req("block", blocks), req("properties", names)]
    let banner: List<Field> = [req("patterns", layers), req("append", flag)]
    let set_potion: List<Field> = [req("id", potion)]
    let dyes: List<Field> = [req("number_of_dyes", ints)]
    let random_potion: List<Field> = [opt("options", potions)]
    let instrument: List<Field> = [req("options", instruments)]
    let sequence: List<Field> = [req("functions", list)]
    let copy_components: List<Field> = [req("source", component_source), opt("include", component_list), opt("exclude", component_list)]
    let set_fireworks: List<Field> = [opt("explosions", explosions), opt("flight_duration", flight)]
    let book_cover: List<Field> = [opt("title", title), opt("author", s), opt("generation", generation)]
    let written_book: List<Field> = [req("pages", written), inline(all_pages)]
    let writable_book: List<Field> = [req("pages", writable), inline(hundred_pages)]
    let toggle: List<Field> = [req("toggles", toggles)]
    let amplifier: List<Field> = [req("amplifier", ints)]
    let none_of_its_own: List<Field> = []
    var kinds = List<(String, usize)>()
    kinds.push(("minecraft:set_count", conditional(mut c, set_count)))
    kinds.push(("minecraft:set_item", conditional(mut c, set_item)))
    kinds.push(("minecraft:enchant_with_levels", conditional(mut c, with_levels)))
    kinds.push(("minecraft:enchant_randomly", conditional(mut c, randomly)))
    kinds.push(("minecraft:set_enchantments", conditional(mut c, set_enchantments)))
    kinds.push(("minecraft:set_custom_data", conditional(mut c, custom_data)))
    kinds.push(("minecraft:set_components", conditional(mut c, components)))
    kinds.push(("minecraft:furnace_smelt", conditional(mut c, smelt)))
    kinds.push(("minecraft:enchanted_count_increase", conditional(mut c, count_increase)))
    kinds.push(("minecraft:set_damage", conditional(mut c, damage)))
    kinds.push(("minecraft:set_attributes", conditional(mut c, set_attributes)))
    kinds.push(("minecraft:set_name", conditional(mut c, set_name)))
    kinds.push(("minecraft:exploration_map", conditional(mut c, exploration)))
    kinds.push(("minecraft:set_stew_effect", conditional(mut c, effects)))
    kinds.push(("minecraft:copy_name", conditional(mut c, copy_name)))
    kinds.push(("minecraft:set_contents", conditional(mut c, set_contents)))
    kinds.push(("minecraft:modify_contents", conditional(mut c, modify_contents)))
    kinds.push(("minecraft:filtered", conditional(mut c, filtered)))
    kinds.push(("minecraft:limit_count", conditional(mut c, limit_count)))
    kinds.push(("minecraft:apply_bonus", conditional(mut c, apply_bonus)))
    kinds.push(("minecraft:set_loot_table", conditional(mut c, set_loot_table)))
    kinds.push(("minecraft:explosion_decay", conditional(mut c, none_of_its_own.copy())))
    kinds.push(("minecraft:set_lore", conditional(mut c, lore)))
    kinds.push(("minecraft:fill_player_head", conditional(mut c, head)))
    kinds.push(("minecraft:copy_custom_data", conditional(mut c, copy_custom)))
    kinds.push(("minecraft:copy_state", conditional(mut c, copy_state)))
    kinds.push(("minecraft:set_banner_pattern", conditional(mut c, banner)))
    kinds.push(("minecraft:set_potion", conditional(mut c, set_potion)))
    kinds.push(("minecraft:set_random_dyes", conditional(mut c, dyes)))
    kinds.push(("minecraft:set_random_potion", conditional(mut c, random_potion)))
    kinds.push(("minecraft:set_instrument", conditional(mut c, instrument)))
    kinds.push(("minecraft:sequence", conditional(mut c, sequence)))
    kinds.push(("minecraft:copy_components", conditional(mut c, copy_components)))
    kinds.push(("minecraft:set_fireworks", conditional(mut c, set_fireworks)))
    kinds.push(("minecraft:set_firework_explosion", conditional(mut c, fireworks)))
    kinds.push(("minecraft:set_book_cover", conditional(mut c, book_cover)))
    kinds.push(("minecraft:set_written_book_pages", conditional(mut c, written_book)))
    kinds.push(("minecraft:set_writable_book_pages", conditional(mut c, writable_book)))
    kinds.push(("minecraft:toggle_tooltips", conditional(mut c, toggle)))
    kinds.push(("minecraft:set_ominous_bottle_amplifier", conditional(mut c, amplifier)))
    kinds.push(("minecraft:set_custom_model_data", conditional(mut c, model_data)))
    kinds.push(("minecraft:discard", conditional(mut c, none_of_its_own)))
    let by = by_name(mut c, "minecraft:loot_function_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// A conditional function's record: its condition, `commonFields`, then its own fields.
fn conditional(c: mut Codecs, own_fields: own List<Field>) -> usize {
    let test = condition(mut c)
    var fields: List<Field> = [opt("condition", test)]
    for f in own_fields {
        fields.push(f.copy())
    }
    return c.add(Codec.Record(fields))
}

// `ContainerComponentManipulators.CODEC`: a component that holds items, by its ID.
fn container_component(c: mut Codecs) -> usize {
    let key = String("container component")
    if let at = c.find(key) {
        return at
    }
    let types = by_name(mut c, "minecraft:data_component_type")
    return c.shared(key, Codec.Then(Then { of: types, then: holds_items, with: Tag.End }))
}

fn holds_items(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let name = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    if name == "minecraft:container" or name == "minecraft:bundle_contents" or name == "minecraft:charged_projectiles" {
        return Read.ok(value.copy())
    }
    return Read.bad(String("No items in component"))
}

// `LootContextArg.createArgCodec`: one of the names, as `LateBoundIdMapper.codec` reads them.
fn arg_names(c: mut Codecs, name: str, names: own List<String>) -> usize {
    let key = "loot context arg {name}"
    if let at = c.find(key) {
        return at
    }
    var listed = List<Tag>()
    for n in names {
        listed.push(Tag.Str(n.copy()))
    }
    let s = string(mut c)
    return c.shared(key, Codec.Then(Then { of: s, then: known_arg, with: Tag.List(listed) }))
}

fn known_arg(_c: Codecs, value: Tag, with: Tag) -> Read {
    let name = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    match with {
        Tag.List(names) => {
            for n in names {
                if let Tag.Str(s) = n {
                    if s == name {
                        return Read.ok(value.copy())
                    }
                }
            }
        },
        _ => {},
    }
    return Read.bad("Unknown element id: {name}")
}

// `LootContext.EntityTarget`'s names, then `BlockEntityTarget`'s, as `ENTITY_OR_BLOCK` has them.
fn entity_or_block() -> List<String> {
    return entity_targets_and([String("block_entity")])
}

// `CopyComponentsFunction.GETTER_CODEC`'s names: any entity, the block entity, the tool.
fn component_sources() -> List<String> {
    return entity_targets_and([String("block_entity"), String("tool")])
}

fn entity_targets_and(more: own List<String>) -> List<String> {
    var out: List<String> = [String("this"), String("attacker"), String("direct_attacker"), String("attacking_player"), String("target_entity"), String("interacting_entity")]
    for m in more {
        out.push(m.copy())
    }
    return out
}

// `SetAttributesFunction.Modifier.CODEC`'s list.
fn attribute_modifiers(c: mut Codecs) -> usize {
    let groups = slot_groups(mut c)
    let compact = c.add(Codec.Compact(groups))
    let slots = c.add(Codec.Then(Then { of: compact, then: some_slots, with: Tag.End }))
    let ids = id(mut c)
    let attributes = by_name(mut c, "minecraft:attribute")
    let operations = c.add(Codec.Names(["add_value", "add_multiplied_base", "add_multiplied_total"]))
    let amount = context_float(mut c)
    let fields: List<Field> = [req("id", ids), req("attribute", attributes), req("operation", operations), req("amount", amount), req("slot", slots)]
    let one = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: one }))
}

// `ExtraCodecs.nonEmptyList`: at least one.
fn some_slots(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.List(l) => {
            if l.is_empty() {
                return Read.bad(String("List must have contents"))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `ExplorationMapFunction`'s fields.
fn exploration_fields(c: mut Codecs) -> List<Field> {
    let structures = holder_set(mut c, "minecraft:worldgen/structure")
    let decorations = by_name(mut c, "minecraft:map_decoration_type")
    let zoom = c.add(Codec.Int(IntRange { min: -128, max: 127 }))
    let n = i32_codec(mut c)
    let flag = bool_codec(mut c)
    return [
        req("destination", structures),
        def("decoration", decorations, Tag.Str(String("minecraft:mansion"))),
        def("zoom", zoom, Tag.Byte(2i8)),
        def("search_radius", n, Tag.Int(50)),
        def("skip_existing_chunks", flag, Tag.Byte(1i8)),
    ]
}

// `SetStewEffectFunction.EFFECTS_LIST`: each effect and how long, none twice.
fn stew_effects(c: mut Codecs) -> usize {
    let effect = by_name(mut c, "minecraft:mob_effect")
    let duration = context_int(mut c)
    let fields: List<Field> = [req("type", effect), req("duration", duration)]
    let one = c.add(Codec.Record(fields))
    let list = c.add(Codec.ListOf(Many { of: one }))
    return c.add(Codec.Then(Then { of: list, then: no_effect_twice, with: Tag.End }))
}

fn no_effect_twice(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var seen = List<String>()
    match value {
        Tag.List(l) => {
            for e in l {
                var name = String()
                if let Tag.Compound(m) = e {
                    if m.contains("type") {
                        if let Tag.Str(s) = m["type"] {
                            name = s.copy()
                        }
                    }
                }
                if seen.contains(name) {
                    return Read.bad("Encountered duplicate mob effect: 'Reference\{ResourceKey[minecraft:mob_effect / {name}]={short_name(name)}\}'")
                }
                seen.push(name)
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// What a mob effect's `toString` shows of it in a reference's message: its class's, which
// Calcite doesn't have, so the effect's own path stands in for it.
fn short_name(name: String) -> String {
    let at = name.find(":") ?? 0
    return name[at + 1..name.len()]
}

// `IntLimit.CODEC`: a least and a greatest count, each from a provider.
fn int_limit(c: mut Codecs) -> usize {
    let ints = context_int(mut c)
    let fields: List<Field> = [opt("min", ints), opt("max", ints)]
    return c.add(Codec.Record(fields))
}

// `SetContainerLootTable.ID_ONLY_CODEC`: a table by its ID only.
fn named_table(c: mut Codecs) -> usize {
    let holder = loot_table_holder(mut c)
    return c.add(Codec.Then(Then { of: holder, then: only_named, with: Tag.End }))
}

fn only_named(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return match value {
        Tag.Str(_) => Read.ok(value.copy()),
        _ => Read.bad(String("Only tag names supported")),
    }
}

// `ApplyBonusCount.FORMULA_CODEC`: the formula by its ID in `formula`, and its parameters in
// `parameters`, an empty map where they aren't given, as `ExtraCodecs.dispatchOptionalValue`
// reads them.
fn bonus_formula(c: mut Codecs) -> usize {
    let key = String("bonus formula")
    if let at = c.find(key) {
        return at
    }
    let n = i32_codec(mut c)
    let binomial_fields: List<Field> = [req("extra", n), req("probability", f32_codec(mut c))]
    _ = c.shared(String("bonus formula binomial_with_bonus_count"), Codec.Record(binomial_fields))
    let uniform_fields: List<Field> = [req("bonusMultiplier", n)]
    _ = c.shared(String("bonus formula uniform_bonus_count"), Codec.Record(uniform_fields))
    _ = id(mut c)
    return c.shared(key, Codec.Nested(read_formula))
}

fn read_formula(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    let members = match value {
        Json.Object(m) => m.copy(),
        _ => return Read.bad("Not a map: {c.shown(value)}"),
    }
    let at = given(members, String("formula")) else return Read.bad("Missing \"formula\" in: MapLike[{c.shown(value)}]")
    let ids = c.find(String("identifier")) ?? 0
    var name = c.read(ids, members[at].value, r, mut refs)
    if let e = name.error.take() {
        return Read.bad(e)
    }
    let formula = match name.value.take() {
        some(Tag.Str(s)) => s,
        _ => String(),
    }
    var out = JavaHashMap<String, Tag>()
    out.insert(String("formula"), Tag.Str(formula.copy()))
    let params = match given(members, String("parameters")) {
        some(p) => members[p].value.copy(),
        none => Json.Object(List<Member>()),
    }
    if formula == "minecraft:ore_drops" {
        return match params {
            Json.Object(_) => Read.ok(Tag.Compound(out)),
            _ => Read.bad("Not a map: {c.shown(params)}"),
        }
    }
    let path = if formula.starts_with("minecraft:") { formula[10..formula.len()] } else { String() }
    let record = c.find("bonus formula {path}") else return Read.bad("No formula type with id: '{formula}'")
    var got = c.read(record, params, r, mut refs)
    if got.threw() {
        return got
    }
    if let e = got.error.take() {
        return Read.bad(e)
    }
    if let Tag.Compound(p) = got.value.take() ?? Tag.End {
        if not p.is_empty() {
            out.insert(String("parameters"), Tag.Compound(p))
        }
    }
    return Read.ok(Tag.Compound(out))
}

// `ListOperation.codec(max)`: how a list given is put with the one there, by `mode`, with where
// and how much, a section's size no more than `max`.
fn list_operation(c: mut Codecs, max: i32) -> usize {
    let key = "list operation {max}"
    if let at = c.find(key) {
        return at
    }
    let nn = non_negative_int(mut c)
    let empty: List<Field> = []
    let section_fields: List<Field> = [def("offset", nn, Tag.Int(0)), opt("size", nn)]
    let insert_fields: List<Field> = [def("offset", nn, Tag.Int(0))]
    let none_at = c.add(Codec.Record(empty))
    let kinds: List<(String, usize)> = [
        ("replace_all", none_at),
        ("replace_section", c.add(Codec.Record(section_fields))),
        ("insert", c.add(Codec.Record(insert_fields))),
        ("append", none_at),
    ]
    let modes = c.add(Codec.Names(["replace_all", "replace_section", "insert", "append"]))
    let dispatch = c.add(Codec.Dispatch(Kinds { key: "mode", by: modes, kinds: kinds }))
    return c.shared(key, Codec.Then(Then { of: dispatch, then: section_within, with: Tag.Int(max) }))
}

fn section_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let max = match with {
        Tag.Int(m) => m,
        _ => 2147483647,
    }
    if let Tag.Compound(m) = value {
        if m.contains("mode") and m.contains("size") {
            if m["mode"] == Tag.Str(String("replace_section")) {
                if let Tag.Int(size) = m["size"] {
                    if size > max {
                        return Read.bad("Size value too large: {size}, max size is {max}")
                    }
                }
            }
        }
    }
    return Read.ok(value.copy())
}

// `ListOperation.StandAlone.codec(of, max)`: up to `max` values, and how they're put with the
// list there.
fn stand_alone(c: mut Codecs, of: usize, max: i32) -> usize {
    let values = c.add(Codec.ListOf(Many { of: of, max: usize.wrap(max) }))
    let operation = list_operation(mut c, max)
    let fields: List<Field> = [req("values", values), inline(operation)]
    return c.add(Codec.Record(fields))
}

// `NbtProviders.CODEC`: an entity or the block entity by its name alone, else a provider by its
// kind.
fn nbt_provider(c: mut Codecs) -> usize {
    let key = String("nbt provider")
    if let at = c.find(key) {
        return at
    }
    let names = arg_names(mut c, "nbt source", block_entity_and_entities())
    let ids = id(mut c)
    let storage_fields: List<Field> = [req("source", ids)]
    let context_fields: List<Field> = [req("target", names)]
    let kinds: List<(String, usize)> = [
        ("minecraft:storage", c.add(Codec.Record(storage_fields))),
        ("minecraft:context", c.add(Codec.Record(context_fields))),
    ]
    let by = by_name(mut c, "minecraft:loot_nbt_provider_type")
    let typed = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    return c.shared(key, Codec.Either(names, typed))
}

// `ContextNbtProvider.GETTER_CODEC`'s names: the block entity, then the entities.
fn block_entity_and_entities() -> List<String> {
    var out: List<String> = [String("block_entity")]
    for t in entity_targets_and([]) {
        out.push(t.copy())
    }
    return out
}

// `CopyCustomDataFunction.CopyOperation.CODEC`'s list: from where, to where, and how.
fn copy_operations(c: mut Codecs) -> usize {
    let path = nbt_path(mut c)
    let strategies = c.add(Codec.Names(["replace", "append", "merge"]))
    let fields: List<Field> = [req("source", path), req("target", path), req("op", strategies)]
    let one = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: one }))
}

// `SetFireworkExplosionFunction`'s fields, each left as it is where it isn't given.
fn firework_fields(c: mut Codecs) -> List<Field> {
    let n = i32_codec(mut c)
    let colors = c.add(Codec.ListOf(Many { of: n }))
    let flag = bool_codec(mut c)
    let shapes = c.add(Codec.Names(["small_ball", "large_ball", "star", "creeper", "burst"]))
    return [
        opt("shape", shapes),
        opt("colors", colors),
        opt("fade_colors", colors),
        opt("trail", flag),
        opt("twinkle", flag),
    ]
}

// `SetCustomModelDataFunction`'s fields: lists of floats, flags, strings and colors, each with how
// it's put with what's there.
fn model_data_fields(c: mut Codecs) -> List<Field> {
    let max = 2147483647
    let ints = context_int(mut c)
    let rgb = rgb_int(mut c)
    let colors = c.add(Codec.Either(ints, rgb))
    let floats = context_float(mut c)
    let flag = bool_codec(mut c)
    let s = string(mut c)
    let float_list = stand_alone(mut c, floats, max)
    let flag_list = stand_alone(mut c, flag, max)
    let string_list = stand_alone(mut c, s, max)
    let color_list = stand_alone(mut c, colors, max)
    return [opt("floats", float_list), opt("flags", flag_list), opt("strings", string_list), opt("colors", color_list)]
}

/// `SlotSources.CODEC`: a slot source by its ID, or given in full, a list of them given in full
/// being a group of them.
pub fn slot_source(c: mut Codecs) -> usize {
    return c.named(String("slot source"), make_slot_source)
}

fn make_slot_source(c: mut Codecs) -> Codec {
    return Codec.Holder(HolderCodec { registry: "minecraft:slot_source", inline: some(slot_source_direct(mut c)) })
}

// `SlotSources.LIST_CODEC`: a tag of them, or a list, each by its ID or given in full by its kind.
fn slot_sources(c: mut Codecs) -> usize {
    return c.named(String("slot sources"), make_slot_sources)
}

fn make_slot_sources(c: mut Codecs) -> Codec {
    return Codec.Holders(HolderCodec { registry: "minecraft:slot_source", inline: some(slot_source_typed(mut c)) })
}

// `SlotSources.DIRECT_CODEC`: by its kind, or a list as a group given inline.
fn slot_source_direct(c: mut Codecs) -> usize {
    return c.named(String("slot source direct"), make_slot_source_direct)
}

fn make_slot_source_direct(c: mut Codecs) -> Codec {
    return Codec.Either(slot_source_typed(mut c), slot_sources(mut c))
}

/// `SlotSources.TYPED_CODEC`: a slot source by its kind, as a `slot_source/` file is.
pub fn slot_source_typed(c: mut Codecs) -> usize {
    return c.named(String("slot source typed"), make_slot_source_typed)
}

fn make_slot_source_typed(c: mut Codecs) -> Codec {
    let me = slot_source(mut c)
    let terms = slot_sources(mut c)
    let terms_fields: List<Field> = [req("terms", terms)]
    let filter = item(mut c)
    let filtered_fields: List<Field> = [req("slot_source", me), req("item_filter", filter)]
    let positive = positive_int(mut c)
    let limit_fields: List<Field> = [req("slot_source", me), req("limit", positive)]
    var range_names = entity_targets_and([String("block_entity")])
    range_names.push(String("container"))
    let range_source = arg_names(mut c, "slot range source", range_names)
    let ranges = c.add(Codec.Names(slot_ranges()))
    let range_fields: List<Field> = [def("source", range_source, Tag.Str(String("container"))), req("slots", ranges)]
    let container = container_component(mut c)
    let contents_fields: List<Field> = [req("slot_source", me), req("component", container)]
    let empty: List<Field> = []
    let kinds: List<(String, usize)> = [
        ("minecraft:group", c.add(Codec.Record(terms_fields))),
        ("minecraft:filtered", c.add(Codec.Record(filtered_fields))),
        ("minecraft:limit_slots", c.add(Codec.Record(limit_fields))),
        ("minecraft:slot_range", c.add(Codec.Record(range_fields))),
        ("minecraft:contents", c.add(Codec.Record(contents_fields))),
        ("minecraft:empty", c.add(Codec.Record(empty))),
    ]
    let by = by_name(mut c, "minecraft:slot_source_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

/// The codecs a command's loot arguments read what's given inline with, `ResourceOrIdArgument`'s:
/// `LootItemCondition.DIRECT_CODEC` for `loot_predicate`, `LootItemFunctions.DIRECT_CODEC` for
/// `loot_modifier` and `LootTable.DIRECT_CODEC` for `loot_table`, each reading NBT against the
/// registries, the reloadable ones among them, as `CommandBuildContext` has them once a server's
/// resources have loaded (D570). Reading changes nothing, so the commands share one.
pub struct LootCodecs {
    codecs: Codecs
    registries: Shared<Registries>
    predicate_at: usize
    modifier_at: usize
    table_at: usize
}

impl LootCodecs {
    /// The codecs, against `registries`.
    pub fn new(registries: own Shared<Registries>) -> LootCodecs {
        var c = Codecs.new()
        if let b = registries.value.find_builtin(String("block")) {
            c.states = some(StateCodec.new(registries.value.builtin[b]))
        }
        c.frozen = true
        c.nbt = true
        c.defaults_bound = true
        c.reloaded = true
        let predicate = condition_direct(mut c)
        let modifier = modifier_direct(mut c)
        let table = loot_table(mut c)
        return LootCodecs { codecs: c, registries: registries, predicate_at: predicate, modifier_at: modifier, table_at: table }
    }

    /// What the codec of `registry`, `minecraft:predicate`, `minecraft:item_modifier` or
    /// `minecraft:loot_table`, reads of `t`, written back, or why it doesn't read, as `getOrThrow`
    /// fails even where there's a partial value.
    pub fn read(self, registry: String, t: Tag) -> Tag ! String {
        let at = if registry == "minecraft:predicate" { self.predicate_at } else if registry == "minecraft:item_modifier" { self.modifier_at } else { self.table_at }
        var refs = Refs.new()
        var got = self.codecs.read(at, t.to_typed_json(), self.registries.value, mut refs)
        if let e = got.error.take() {
            fail e
        }
        let v = got.value.take() else fail String("Nothing was read")
        return v
    }
}
