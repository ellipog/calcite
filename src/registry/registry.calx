/// A registry: its entries, each with its ID, and its tags.
module registry.registry

import pack.resources.{order}
import resources.identifier.{Identifier}

/// A registry: its entries in ID order, and its tags.
pub struct Registry {
    /// Its name, such as `minecraft:worldgen/biome`.
    pub name: Identifier
    /// Whether data packs define its entries, as for the synchronized registries, rather than
    /// code.
    pub synced: bool
    /// Its entries, in ID order.
    pub entries: List<Identifier>
    /// The pack each entry came from, by its place in the server's packs, or `none` for one
    /// defined in code.
    pub packs: List<usize?>
    /// Its tags, in vanilla's order of their names.
    pub tags: List<Tag>
    /// Each entry's contents, in ID order, as its registry's network codec writes them, in NBT
    /// as `NbtIo.writeAnyTag` writes it, which a client that doesn't know its pack is sent. None
    /// for a built-in registry.
    pub contents: List<List<u8>>
    /// For `dimension_type` and `timeline`, each entry's contents in full, in ID order, as the
    /// server reads them, with what clients aren't sent, in the same NBT (D313), and for the
    /// mob variants with their spawn conditions (CAL-156). Empty for the others.
    pub full: List<List<u8>> = List<List<u8>>()
    ids: Map<String, i32>
}

impl Registry {
    /// An empty registry.
    pub fn new(name: own Identifier, synced: bool) -> Registry {
        return Registry { name: name, synced: synced, entries: List<Identifier>(), packs: List<usize?>(), tags: List<Tag>(), contents: List<List<u8>>(), ids: Map<String, i32>() }
    }

    /// Adds `entry`, from the pack at `pack`, with the next ID.
    pub fn add(mut self, entry: own Identifier, pack: usize?) {
        self.ids.insert(entry.to_string(), i32.wrap(self.entries.len()))
        self.entries.push(entry)
        self.packs.push(pack)
    }

    /// The ID of `entry`, or `none` if it isn't in the registry.
    pub fn id(self, entry: Identifier) -> i32? {
        return self.ids.get(entry.to_string())
    }

    /// Whether the registry has the tag `name`.
    pub fn has_tag(self, name: Identifier) -> bool {
        for tag in self.tags {
            if tag.name.namespace == name.namespace and tag.name.path == name.path {
                return true
            }
        }
        return false
    }

    /// The IDs of the entries in the tag `name`, in its order, none if no pack defines it.
    pub fn tag_ids(self, name: Identifier) -> List<i32> {
        for tag in self.tags {
            if tag.name.namespace == name.namespace and tag.name.path == name.path {
                return tag.values.copy()
            }
        }
        return []
    }

    /// The IDs of the entries in the tag `minecraft:{path}`, none if no pack defines it, as in
    /// vanilla.
    pub fn tag_values(self, path: String) -> List<i32> {
        for tag in self.tags {
            if tag.name.namespace == "minecraft" and tag.name.path == path {
                return tag.values.copy()
            }
        }
        return []
    }
}

/// A tag: its name, and the IDs of its entries, in the order vanilla's holds them.
pub struct Tag {
    pub name: Identifier
    pub values: List<i32>
}

// Tags sort by name in vanilla's order of identifiers.
impl Order for Tag {
    fn cmp(self, other: Self) -> Ordering {
        return order(self.name, other.name)
    }
}
