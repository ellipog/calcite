/// Recipes' codecs, described for `registry.codec` (CAL-146): `Recipe.DIRECT_CODEC`, a recipe of
/// each of the 22 kinds `RecipeSerializers` registers, by its `type`, with the ingredients,
/// results, patterns and book categories each reads. Each reads what vanilla's codec reads from a
/// data pack's `recipe/` and gives what it writes back, with vanilla's messages for what doesn't
/// read: a shaped recipe's pattern and key checked against each other as `ShapedRecipePattern`
/// unpacks them, its pattern's rows and its key's symbols, and the ranges a transmute's material
/// count and a book clone's generations must be within.
module registry.recipes

import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Field, HolderCodec, HolderKind, IntRange, Kinds, Many, MapOf, Read, Then}
import registry.codecs.{bool_codec, by_name, checked, def, f32_codec, field, i32_codec, inline, item_stack_template, non_empty, not_air, opt, read_component_patch, registry_codec, req, string}
import registry.predicates.{ints, potions}

/// `Ingredient.CODEC`: an item, a list of them, or a tag of them as `#` and its ID, none of them
/// air, and not an empty list.
pub fn ingredient(c: mut Codecs) -> usize {
    if let at = c.find(String("ingredient")) {
        return at
    }
    let items = c.add(Codec.Holders(HolderCodec { registry: "minecraft:item", inline: none, kind: HolderKind.ByName }))
    let checked_items = c.add(Codec.Then(Then { of: items, then: no_air, with: Tag.End }))
    let at = non_empty(mut c, checked_items)
    c.name(String("ingredient"), at)
    return at
}

// `Item.CODEC`'s check on each of a holder set's items: none is air. A list's item fails with the
// list, which has a partial value, so its message is the item's; one alone fails with nothing,
// so its message is both `Codec.either`s', after the tag's and the list's.
fn no_air(c: Codecs, value: Tag, with: Tag) -> Read {
    match value {
        Tag.List(items) => {
            for item in items {
                let read = not_air(c, item, with)
                if not read.is_ok() {
                    return read
                }
            }
            return Read.ok(value.copy())
        },
        Tag.Str(s) => {
            let read = not_air(c, value, with)
            if read.is_ok() {
                return read
            }
            return Read.bad("Failed to parse either. First: Not a tag id; Second: Failed to parse either. First: Not a json array: \"{s}\"; Second: Item must not be minecraft:air")
        },
        _ => return Read.ok(value.copy()),
    }
}

/// `Recipe.DIRECT_CODEC`: a recipe, by the serializer its `type` names.
pub fn recipe(c: mut Codecs) -> usize {
    return c.named(String("recipe"), make_recipe)
}

fn make_recipe(c: mut Codecs) -> Codec {
    let item = ingredient(mut c)
    let result = item_stack_template(mut c)
    let flag = bool_codec(mut c)
    let s = string(mut c)
    // `Recipe.CommonInfo.MAP_CODEC`, and the book's `category` and `group`, as
    // `Recipe.BookInfo.mapCodec` reads them, `misc` and empty where they're left out.
    let common_fields: List<Field> = [def("show_notification", flag, Tag.Byte(1i8))]
    let common = c.add(Codec.Record(common_fields))
    let crafting_categories = c.add(Codec.Names(["building", "redstone", "equipment", "misc"]))
    let crafting_fields: List<Field> = [def("category", crafting_categories, Tag.Str(String("misc"))), def("group", s, Tag.Str(String()))]
    let crafting = c.add(Codec.Record(crafting_fields))
    let cooking_categories = c.add(Codec.Names(["food", "blocks", "misc"]))
    let cooking_fields: List<Field> = [def("category", cooking_categories, Tag.Str(String("misc"))), def("group", s, Tag.Str(String()))]
    let cooking_book = c.add(Codec.Record(cooking_fields))
    // `ShapedRecipePattern.MAP_CODEC`: a key of one-character symbols, each an ingredient, and
    // a pattern of up to 3 rows of the same width, up to 3 each, unpacked against each other.
    let symbol = c.add(Codec.Then(Then { of: s, then: check_symbol, with: Tag.End }))
    let key = c.add(Codec.MapOf(MapOf { key: symbol, value: item, strict: true }))
    let rows = c.add(Codec.ListOf(Many { of: s }))
    let pattern = c.add(Codec.Then(Then { of: rows, then: check_pattern, with: Tag.End }))
    let pattern_fields: List<Field> = [req("key", key), req("pattern", pattern)]
    let shaped_pattern = checked(mut c, pattern_fields, unpack_pattern)
    let shaped_fields: List<Field> = [inline(common), inline(crafting), inline(shaped_pattern), req("result", result)]
    let some_ingredients = c.add(Codec.ListOf(Many { of: item, min: 1, max: 9 }))
    let shapeless_fields: List<Field> = [inline(common), inline(crafting), req("result", result), req("ingredients", some_ingredients)]
    let dye_fields: List<Field> = [inline(common), inline(crafting), req("target", item), req("dye", item), req("result", result)]
    let imbue_fields: List<Field> = [inline(common), inline(crafting), req("source", item), req("material", item), req("result", result)]
    let transmuted = transmute_result(mut c)
    let counts = ints(mut c)
    let material_count = c.add(Codec.Then(Then { of: counts, then: within, with: range_tag(1, 8) }))
    let transmute_fields: List<Field> = [
        inline(common),
        inline(crafting),
        req("input", item),
        req("material", item),
        def("material_count", material_count, Tag.Int(1)),
        req("result", transmuted),
        def("add_material_count_to_result", flag, Tag.Byte(0i8)),
    ]
    let pot_fields: List<Field> = [req("back", item), req("left", item), req("right", item), req("front", item), req("result", result)]
    let generations = c.add(Codec.Then(Then { of: counts, then: within, with: range_tag(0, 2) }))
    let cloning_fields: List<Field> = [
        req("source", item),
        req("material", item),
        def("allowed_generations", generations, range_tag(0, 1)),
        req("result", result),
    ]
    let extending_fields: List<Field> = [req("map", item), req("material", item), req("result", transmuted)]
    let rocket_fields: List<Field> = [req("shell", item), req("fuel", item), req("star", item), req("result", result)]
    let shape = c.add(Codec.Names(["small_ball", "large_ball", "star", "creeper", "burst"]))
    let shapes = c.add(Codec.MapOf(MapOf { key: shape, value: item }))
    let star_fields: List<Field> = [
        req("shapes", shapes),
        req("trail", item),
        req("twinkle", item),
        req("fuel", item),
        req("dye", item),
        req("result", result),
    ]
    let fade_fields: List<Field> = [req("target", item), req("dye", item), req("result", result)]
    let banner_fields: List<Field> = [req("banner", item), req("result", result)]
    let shield_fields: List<Field> = [req("banner", item), req("target", item), req("result", result)]
    let no_fields: List<Field> = []
    let cooking_kind_fields: List<Field> = [
        inline(common),
        inline(cooking_book),
        req("ingredient", item),
        req("result", result),
        def("experience", f32_codec(mut c), Tag.Float(0.0f32)),
        req("cookingtime", i32_codec(mut c)),
    ]
    let cooking = c.add(Codec.Record(cooking_kind_fields))
    let stonecutting_fields: List<Field> = [inline(common), req("ingredient", item), req("result", result)]
    let transform_fields: List<Field> = [inline(common), opt("template", item), req("base", item), opt("addition", item), req("result", result)]
    let trim = trim_pattern(mut c)
    let trim_fields: List<Field> = [inline(common), req("template", item), req("base", item), req("addition", item), req("pattern", trim)]
    let potion_fields: List<Field> = [req("item", item), opt("potion_contents", potions(mut c))]
    let potion = c.add(Codec.Record(potion_fields))
    let brewing_fields: List<Field> = [req("input", potion), req("reagent", potion), req("output", result)]
    let kinds: List<(String, usize)> = [
        ("minecraft:crafting_shaped", c.add(Codec.Record(shaped_fields))),
        ("minecraft:crafting_shapeless", c.add(Codec.Record(shapeless_fields))),
        ("minecraft:crafting_dye", c.add(Codec.Record(dye_fields))),
        ("minecraft:crafting_imbue", c.add(Codec.Record(imbue_fields))),
        ("minecraft:crafting_transmute", c.add(Codec.Record(transmute_fields))),
        ("minecraft:crafting_decorated_pot", c.add(Codec.Record(pot_fields))),
        ("minecraft:crafting_special_bookcloning", c.add(Codec.Record(cloning_fields))),
        ("minecraft:crafting_special_mapextending", c.add(Codec.Record(extending_fields))),
        ("minecraft:crafting_special_firework_rocket", c.add(Codec.Record(rocket_fields))),
        ("minecraft:crafting_special_firework_star", c.add(Codec.Record(star_fields))),
        ("minecraft:crafting_special_firework_star_fade", c.add(Codec.Record(fade_fields))),
        ("minecraft:crafting_special_bannerduplicate", c.add(Codec.Record(banner_fields))),
        ("minecraft:crafting_special_shielddecoration", c.add(Codec.Record(shield_fields))),
        ("minecraft:crafting_special_repairitem", c.add(Codec.Record(no_fields))),
        ("minecraft:smelting", cooking),
        ("minecraft:blasting", cooking),
        ("minecraft:smoking", cooking),
        ("minecraft:campfire_cooking", cooking),
        ("minecraft:stonecutting", c.add(Codec.Record(stonecutting_fields))),
        ("minecraft:smithing_transform", c.add(Codec.Record(transform_fields))),
        ("minecraft:brewing", c.add(Codec.Record(brewing_fields))),
        ("minecraft:smithing_trim", c.add(Codec.Record(trim_fields))),
    ]
    let by = by_name(mut c, "minecraft:recipe_serializer")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `TransmuteResult.CODEC`: `{id, count, components}`, each left out as it may be, or an item
// alone.
fn transmute_result(c: mut Codecs) -> usize {
    let items = by_name(mut c, "minecraft:item")
    let item = c.add(Codec.Then(Then { of: items, then: not_air, with: Tag.End }))
    let count = c.add(Codec.Int(IntRange { min: 1, max: 99, before: "Value must be within range [1;99]: " }))
    let components = c.shared(String("nested component patch"), Codec.Nested(read_component_patch))
    let fields: List<Field> = [
        opt("id", item),
        def("count", count, Tag.Int(1)),
        def("components", components, Tag.Compound(JavaHashMap<String, Tag>())),
    ]
    let full = c.add(Codec.Record(fields))
    let bare = c.add(Codec.Then(Then { of: item, then: result_of_item, with: Tag.End }))
    return c.add(Codec.Either(full, bare))
}

// A transmute's result of the item `value` alone.
fn result_of_item(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), value.copy())
    return Read.ok(Tag.Compound(m))
}

// `TrimPattern.CODEC`: a trim pattern by its ID, or given in full.
fn trim_pattern(c: mut Codecs) -> usize {
    let direct = registry_codec(mut c, String("trim_pattern"))
    return c.add(Codec.Holder(HolderCodec { registry: "minecraft:trim_pattern", inline: direct, kind: HolderKind.File }))
}

// `ShapedRecipePattern.Data.SYMBOL_CODEC`: one character, not a space.
fn check_symbol(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let symbol = text_of(value)
    if symbol.utf16_len() != 1 {
        return Read.bad("Invalid key entry: '{symbol}' is an invalid symbol (must be 1 character only).")
    }
    if symbol == " " {
        return Read.bad(String("Invalid key entry: ' ' is a reserved symbol."))
    }
    return Read.ok(value.copy())
}

// `ShapedRecipePattern.Data.PATTERN_CODEC`'s checks: up to 3 rows, at least one, each of up to 3
// and all as wide as the first.
fn check_pattern(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let lines = lines_of(value)
    if lines.len() > 3 {
        return Read.bad(String("Invalid pattern: too many rows, 3 is maximum"))
    }
    if lines.is_empty() {
        return Read.bad(String("Invalid pattern: empty pattern not allowed"))
    }
    let width = lines[0].utf16_len()
    for line in lines {
        let n = line.utf16_len()
        if n > 3 {
            return Read.bad(String("Invalid pattern: too many columns, 3 is maximum"))
        }
        if n != width {
            return Read.bad(String("Invalid pattern: each row must be the same width"))
        }
    }
    return Read.ok(value.copy())
}

// The text of the string tag `t`, or nothing.
fn text_of(t: Tag) -> String {
    return match t {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}

// The rows of the list of strings `t`.
fn lines_of(t: Tag) -> List<String> {
    var out = List<String>()
    match t {
        Tag.List(rows) => {
            for r in rows {
                out.push(text_of(r))
            }
        },
        _ => {},
    }
    return out
}

// `ShapedRecipePattern.unpack`: the pattern, shrunk to its symbols, names only symbols in the key,
// and the key has none the pattern doesn't use.
fn unpack_pattern(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let key = field(value, "key")
    let Tag.Compound(symbols) = key else return Read.ok(value.copy())
    let rows = shrunk(lines_of(field(value, "pattern")))
    if rows.is_empty() {
        // `shrunkPattern[0]` of a pattern of spaces alone, which throws.
        return Read.exception(String("java.lang.ArrayIndexOutOfBoundsException: Index 0 out of bounds for length 0"))
    }
    // The symbols the key defines, in its order, each crossed off as the pattern uses it, as
    // `unusedSymbols`, a `CharArraySet` of the key's, has them.
    var unused = List<String>()
    for (k, _) in symbols {
        unused.push(k.copy())
    }
    for row in rows {
        for cell in characters(row) {
            if cell != " " and not symbols.contains(cell) {
                return Read.bad("Pattern references symbol '{cell}' but it's not defined in the key")
            }
            var kept = List<String>()
            for u in unused {
                if u != cell {
                    kept.push(u.copy())
                }
            }
            unused = kept
        }
    }
    if not unused.is_empty() {
        var shown = String()
        for i in 0..unused.len() {
            if i > 0 {
                shown.push_str(", ")
            }
            shown.push_str(unused[i])
        }
        return Read.bad("Key defines symbols that aren't used in pattern: \{{shown}\}")
    }
    return Read.ok(value.copy())
}

/// `ShapedRecipePattern.shrink`: the pattern without the rows above and below its symbols, and
/// the columns to their left and right, that are only spaces. Nothing for a pattern of spaces.
pub fn shrunk(lines: List<String>) -> List<String> {
    var left: i64 = 2147483647
    var right: i64 = 0
    var top: usize = 0
    var bottom: usize = 0
    for y in 0..lines.len() {
        let cells = characters(lines[y])
        left = left.min(i64.wrap(first_symbol(cells)))
        let last = last_symbol(cells)
        right = right.max(last)
        if last < 0 {
            if top == y {
                top += 1
            }
            bottom += 1
        } else {
            bottom = 0
        }
    }
    var out = List<String>()
    if lines.len() == bottom {
        return out
    }
    for y in top..lines.len() - bottom {
        let cells = characters(lines[y])
        var row = String()
        for x in usize.wrap(left)..usize.wrap(right + 1) {
            row.push_str(cells[x])
        }
        out.push(row)
    }
    return out
}

// The place of a row's first symbol that isn't a space, or its length where there's none.
fn first_symbol(cells: List<String>) -> usize {
    for i in 0..cells.len() {
        if cells[i] != " " {
            return i
        }
    }
    return cells.len()
}

// The place of a row's last symbol that isn't a space, or -1 where there's none.
fn last_symbol(cells: List<String>) -> i64 {
    var i = i64.wrap(cells.len()) - 1
    while i >= 0 and cells[usize.wrap(i)] == " " {
        i -= 1
    }
    return i
}

/// The characters of `s`, each a string of its own.
pub fn characters(s: String) -> List<String> {
    var out = List<String>()
    for ch in s.runes() {
        var one = String()
        one.push(ch)
        out.push(one)
    }
    return out
}

// The range from `min` to `max`, as `MinMaxBounds.Ints.between` is written.
fn range_tag(min: i32, max: i32) -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("min"), Tag.Int(min))
    m.insert(String("max"), Tag.Int(max))
    return Tag.Compound(m)
}

// `MinMaxBounds.validateContainedInRange`: the range read is within `with`'s, as Guava's
// `Range.encloses` has it.
fn within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let (min, max) = ends(value)
    let (lo, hi) = ends(with)
    let enclosed = match (min, max) {
        (some(a), some(b)) => a >= (lo ?? i32.MIN) and b <= (hi ?? i32.MAX),
        _ => false,
    }
    if enclosed {
        return Read.ok(value.copy())
    }
    return Read.bad("Range must be within {guava(lo, hi)}, but was {guava(min, max)}")
}

// A range's ends, from its number alone or its `{min, max}`, either left out.
fn ends(t: Tag) -> (i32?, i32?) {
    return match t {
        Tag.Int(n) => (some(n), some(n)),
        Tag.Compound(_) => (int_of(field(t, "min")), int_of(field(t, "max"))),
        _ => (none, none),
    }
}

fn int_of(t: Tag) -> i32? {
    return match t {
        Tag.Int(n) => some(n),
        _ => none,
    }
}

// A range as Guava's `Range.toString` writes it: `[1..8]`, `[1..+∞)`, `(-∞..8]` or `(-∞..+∞)`.
fn guava(min: i32?, max: i32?) -> String {
    let low = match min {
        some(n) => "[{n}",
        none => String("(-∞"),
    }
    let high = match max {
        some(n) => "{n}]",
        none => String("+∞)"),
    }
    return "{low}..{high}"
}
