/// The codec of enchantment providers (CAL-217), `EnchantmentProvider.DIRECT_CODEC`, as a data
/// pack's `enchantment_provider/` files give them. Vanilla reads them with the world registries,
/// before the reloadable ones; Calcite reads them with the trades, once the others are frozen, so
/// they're kept with the reloadable registries, boot cache and all.
module registry.providers

import registry.codec.{Codec, Codecs, Field, Kinds}
import registry.codecs.{by_name, int_provider, req}
import registry.components.{fixed, int_within}
import registry.predicates.{holder_set}

/// `EnchantmentProvider.DIRECT_CODEC`, by its kind: `by_cost`'s enchantments and cost, a number;
/// `by_cost_with_difficulty`'s enchantments, least cost, from 1 to 10,000, and span, from 0 to
/// 10,000; `single`'s enchantment and level, a number.
pub fn enchantment_provider(c: mut Codecs) -> usize {
    return c.named(String("enchantment provider"), make_enchantment_provider)
}

fn make_enchantment_provider(c: mut Codecs) -> Codec {
    let set = holder_set(mut c, "minecraft:enchantment")
    let ints = int_provider(mut c)
    let by_cost: List<Field> = [req("enchantments", set), req("cost", ints)]
    let with_difficulty: List<Field> = [
        req("enchantments", set),
        req("min_cost", int_within(mut c, 1, 10000)),
        req("max_cost_span", int_within(mut c, 0, 10000)),
    ]
    let single: List<Field> = [req("enchantment", fixed(mut c, "minecraft:enchantment")), req("level", ints)]
    let kinds: List<(String, usize)> = [
        ("minecraft:by_cost", c.add(Codec.Record(by_cost))),
        ("minecraft:by_cost_with_difficulty", c.add(Codec.Record(with_difficulty))),
        ("minecraft:single", c.add(Codec.Record(single))),
    ]
    return Codec.Dispatch(Kinds { key: "type", by: by_name(mut c, "minecraft:enchantment_provider_type"), kinds: kinds })
}
