/// Vanilla's codecs described as data, and what they read from a data pack's JSON: each value
/// read as DataFixerUpper's `Codec.parse` reads it with `JsonOps`, and given as the NBT the codec
/// then writes with `NbtOps`. That NBT is the value in canonical form: a field left at its
/// default isn't there, each number has its type, and a value that can be written more than one
/// way, such as a list of one holder, is written vanilla's way. What it can't read fails with
/// DataFixerUpper's message, and with what could be read anyway, its partial value, as a
/// `DataResult` holds it, since `Codec.either` picks by that.
///
/// A codec is a `Codec` in a `Codecs`, by its place there, so codecs can share one and a codec
/// can hold itself, as a text component holds others.
module registry.codec

import chat.language.{Language}
import json.gson.{JsonWriter, int_value, long_value}
import json.tree.{Json, Member}
import nbt.tag.{Tag}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import world.states.{StateCodec}

/// One of vanilla's codecs.
pub enum Codec {
    /// A codec still being made: what a codec that holds itself sees until it's done.
    Pending
    /// `Codec.BOOL`, written as a byte.
    Bool
    /// `Codec.INT`, or one of the ranges built on it.
    Int(IntRange)
    /// `Codec.LONG`, or a range.
    Long(LongRange)
    /// `Codec.FLOAT`, or a range.
    Float(FloatRange)
    /// `Codec.DOUBLE`, or a range.
    Double(DoubleRange)
    /// `Codec.STRING`.
    Str
    /// `Identifier.CODEC`, written as `namespace:path`.
    Id
    /// `StringRepresentable.fromEnum`: one of these names.
    Names(List<String>)
    /// `Codec.list`, or `listOf`: a JSON array of the codec's values, with at least `min` and
    /// at most `max`.
    ListOf(Many)
    /// `RecordCodecBuilder`: an object's fields, as a compound.
    Record(List<Field>)
    /// `Codec.dispatch`: an object whose `key` field names the kind, and whose other fields are
    /// that kind's record. The kind is written after them, as `KeyDispatchCodec` writes it.
    Dispatch(Kinds)
    /// `Codec.either`: the first if it reads, else the second.
    Either(usize, usize)
    /// `ExtraCodecs.compactListCodec`: a list of the codec's values, or one value alone, which
    /// is how a list of one is written.
    Compact(usize)
    /// `RegistryFileCodec`, `RegistryFixedCodec` and `byNameCodec`: an entry of a registry, by
    /// its ID, or, where `inline` is the entry's own codec, given in full.
    Holder(HolderCodec)
    /// `HolderSetCodec`: a registry's tag as `#` and its ID, or its entries, as `Compact`.
    Holders(HolderCodec)
    /// `Codec.dispatchedMap`: an object whose keys each pick the codec of their value.
    Dispatched(Dispatched)
    /// `Codec.unboundedMap`: an object whose keys one codec reads and whose values another does.
    MapOf(MapOf)
    /// `validate`, `xmap` and the like: the codec, then what's done with what it read, which can
    /// fail, or give another value in its place.
    Then(Then)
    /// `Codec.xor`: whichever of the two reads, and an error if both do.
    Xor(usize, usize)
    /// A codec of vanilla's own that's written out by hand, such as text components'.
    Custom(fn(Codecs, Json, Registries) -> Read)
    /// One written out by hand that reads some of its value with other codecs, which note what
    /// they name in `Refs`, such as a biome's.
    Nested(fn(Codecs, Json, Registries, mut Refs) -> Read)
    /// `Codec.promotePartial`: what the codec reads, with its error dropped where it has a partial
    /// value, as vanilla logs it and goes on.
    Promote(usize)
}

/// Where an `int` must be, and what's said of one that isn't: `before`, the number, then
/// `after`.
pub struct IntRange {
    pub min: i32 = i32.MIN
    pub max: i32 = i32.MAX
    pub before: String = String()
    pub after: String = String()
}

/// Where a `long` must be.
pub struct LongRange {
    pub min: i64 = i64.MIN
    pub max: i64 = i64.MAX
    pub before: String = String()
    pub after: String = String()
}

/// Where a `float` must be, ordered as `Float.compareTo` orders them, with `-0.0` below `0.0`.
/// `above` leaves `min` itself out.
pub struct FloatRange {
    pub min: f32 = f32.NEG_INFINITY
    pub max: f32 = f32.INFINITY
    pub above: bool = false
    pub checked: bool = false
    pub before: String = String()
    pub after: String = String()
}

/// Where a `double` must be.
pub struct DoubleRange {
    pub min: f64 = f64.NEG_INFINITY
    pub max: f64 = f64.INFINITY
    pub checked: bool = false
    pub before: String = String()
    pub after: String = String()
}

/// A list's codec and how long it may be, with what's said of one too short.
pub struct Many {
    pub of: usize
    pub min: usize = 0
    pub max: usize = 2147483647
    /// The message for a list shorter than `min`, before its length. Empty for
    /// DataFixerUpper's own.
    pub short: String = String()
}

/// One field of a record.
pub struct Field {
    /// Its key. Empty for a record whose fields are this one's, as a `MapCodec` in a group is.
    pub name: String
    pub of: usize
    pub need: Need
}

/// Whether a field must be there, and what it is when it isn't.
pub enum Need {
    /// `fieldOf`.
    Required
    /// `optionalFieldOf(name)`: nothing when it isn't there.
    Optional
    /// `optionalFieldOf(name, default)`: the default when it isn't there, and not written when
    /// it's the default.
    Default(Tag)
    /// `lenientOptionalFieldOf(name, default)`: as `Default`, and the default when it doesn't
    /// read too.
    Lenient(Tag)
    /// `lenientOptionalFieldOf(name)`: as `Optional`, and nothing when it doesn't read too.
    Loose
    /// `ExtraCodecs.optionalAlwaysPresentFieldOf`: the default when it isn't there, and always
    /// written.
    Always(Tag)
    /// A record whose fields go in this one, as its own.
    Inline
}

/// The kinds a `Dispatch` picks from.
pub struct Kinds {
    /// The field that names the kind, `type` for most.
    pub key: String
    /// What names a kind, an `Id` or `Names` codec, or a `Holder` of the registry of kinds.
    pub by: usize
    /// Each kind's name as `by` writes it, and its record.
    pub kinds: List<(String, usize)>
    /// The kind when `key` isn't there, as `optionalFieldOf(key, default)` reads it, which isn't
    /// written. Empty where `key` must be there.
    pub default: String = String()
}

/// A registry's entries, by ID.
pub struct HolderCodec {
    /// The registry, such as `minecraft:sound_event`.
    pub registry: String
    /// The entry's own codec, for one given in full, or `none` where only an ID will do.
    pub inline: usize?
    /// Which of vanilla's codecs it is.
    pub kind: HolderKind = HolderKind.File
}

/// The codecs that read a registry's entry.
pub enum HolderKind {
    /// `RegistryFileCodec`: an ID, else the entry in full if that's allowed.
    File
    /// `RegistryFixedCodec`: an ID only.
    Fixed
    /// `Registry.byNameCodec`: an ID only, and `Unknown registry key` for one that isn't an
    /// entry.
    ByName
}

/// A codec, and what's done with what it reads.
pub struct Then {
    pub of: usize
    /// What's done with a value, or a partial one: given the codecs, the value and `with`, it gives
    /// the value in its place, or an error.
    pub then: fn(Codecs, Tag, Tag) -> Read
    /// What `then` is given with the value, such as the least it may be, or `Tag.End`.
    pub with: Tag
}

/// The keys of a `Dispatched` map and their values' codecs.
pub struct Dispatched {
    /// What reads a key, from the key as a JSON string.
    pub key: usize
    /// Each key as `key` gives it, and its value's codec.
    pub values: List<(String, usize)>
    /// What reads the value of a key that isn't in `values`: a `Then`, given the key as its
    /// `with`, as a codec vanilla picks from the key, such as the debug stick's block's property.
    pub keyed: usize? = none
}

/// The codecs of an `unboundedMap`'s keys and values.
pub struct MapOf {
    /// What reads a key, from the key as a JSON string.
    pub key: usize
    pub value: usize
    /// What a duplicate's message says around its key, as the key's `toString` gives it.
    pub before: String = String()
    pub after: String = String()
    /// Whether the key shows in capitals there, as an enum constant's name.
    pub upper: bool = false
    /// Whether the key shows with `.` for its `:` and `/` there, as `Util.makeDescriptionId`
    /// makes a description ID.
    pub dotted: bool = false
}

/// What reading gives, vanilla's `DataResult`: a value, or an error and maybe what could be read
/// anyway. Or an exception a codec threw, as `NbtPath.CODEC` throws at a path ending in `[`, which
/// isn't a `DataResult` and ends the read there: no alternative is tried after it, and nothing
/// else is read.
pub struct Read {
    pub value: Tag?
    pub error: String?
    /// The exception, as `Throwable.toString` gives it, with `error` saying it too.
    pub thrown: String? = none
}

impl Read {
    /// A value that read.
    pub fn ok(value: own Tag) -> Read {
        return Read { value: some(value), error: none }
    }

    /// An error, with nothing read.
    pub fn bad(message: own String) -> Read {
        return Read { value: none, error: some(message) }
    }

    /// An exception thrown, `cause`.
    pub fn exception(cause: own String) -> Read {
        return Read { value: none, error: some(cause.copy()), thrown: some(cause) }
    }

    /// Whether a codec threw.
    pub fn threw(self) -> bool {
        return self.thrown != none
    }

    /// Whether it read, with no error.
    pub fn is_ok(self) -> bool {
        return self.error == none
    }

    /// Whether there's a value, or a partial one.
    pub fn has_value(self) -> bool {
        return self.value != none
    }
}

/// What the values read name in the synchronized registries: entries, and tags, each by its
/// registry's place in `Registries.synced`. Vanilla makes a placeholder for each that isn't
/// registered yet while the packs load, and once they have, finds those never filled, as
/// `MappedRegistry.freeze` does, so these are checked once the registries are filled.
pub struct Refs {
    pub values: List<(usize, Identifier)>
    pub tags: List<(usize, Identifier)>
}

impl Refs {
    pub fn new() -> Refs {
        return Refs { values: List<(usize, Identifier)>(), tags: List<(usize, Identifier)>() }
    }
}

/// The codecs, each by its place, and what they need to read some values.
pub struct Codecs {
    all: List<Codec>
    names: Map<String, usize>
    /// The block states, for the codecs that read them, or `none` where none do.
    pub states: StateCodec? = none
    /// The language vanilla's messages are given in where they're text, as an SNBT syntax
    /// error's is, or `none` for their keys alone.
    pub lang: Language? = none
    /// Whether the registries read against are complete, as a server's are once its packs have
    /// loaded: a data pack registry's entry or tag that isn't there then fails as it's read, as a
    /// built-in one's does, rather than going in `refs` to be checked once the packs load.
    pub frozen: bool = false
    /// Each item's default components by its ID, as `read_item_defaults` reads them, which
    /// `ItemStack.CODEC` checks a stack's patch against, or none, where nothing has read them.
    pub item_defaults: Map<String, Tag> = Map<String, Tag>()
}

impl Codecs {
    pub fn new() -> Codecs {
        return Codecs { all: List<Codec>(), names: Map<String, usize>() }
    }

    /// Adds a codec, and gives its place.
    pub fn add(mut self, c: own Codec) -> usize {
        self.all.push(c)
        return self.all.len() - 1
    }

    /// The codec named `name`, added as `c` the first time it's asked for, so codecs that use
    /// it share one.
    pub fn shared(mut self, name: String, c: own Codec) -> usize {
        if let at = self.names.get(name) {
            return at
        }
        let at = self.add(c)
        self.names.insert(name.copy(), at)
        return at
    }

    /// The codec named `name`, made with `make` the first time it's asked for. It has its place
    /// before `make` runs, so a codec can hold itself.
    pub fn named(mut self, name: String, make: fn(mut Codecs) -> Codec) -> usize {
        if let at = self.names.get(name) {
            return at
        }
        let at = self.add(Codec.Pending)
        self.names.insert(name.copy(), at)
        let c = make(mut self)
        self.all[at] = c
        return at
    }

    /// Names the codec at `at` `name` as well, so `find` finds it by that name.
    pub fn name(mut self, name: String, at: usize) {
        self.names.insert(name.copy(), at)
    }

    /// The place of the codec `shared` or `named` made as `name`, if there is one.
    pub fn find(self, name: String) -> usize? {
        return self.names.get(name)
    }

    /// Reads `value` with the codec at `at`, as `Codec.parse` reads it, with what it names that
    /// the synchronized registries in `r` haven't in `refs`.
    pub fn read(self, at: usize, value: Json, r: Registries, refs: mut Refs) -> Read {
        match self.all[at] {
            Codec.Pending => return Read.bad(String("a codec that isn't made yet")),
            Codec.Bool => {
                return match value {
                    Json.Bool(b) => Read.ok(Tag.Byte(if b { 1i8 } else { 0i8 })),
                    _ => Read.bad("Not a boolean: {json_text(value)}"),
                }
            },
            Codec.Int(range) => {
                let text = number_text(value) else return Read.bad("Not a number: {json_text(value)}")
                let v = int_value(text) else return Read.bad("Not a number: {json_text(value)}")
                if v < range.min or v > range.max {
                    return Read.bad("{range.before}{v}{range.after}")
                }
                return Read.ok(Tag.Int(v))
            },
            Codec.Long(range) => {
                let text = number_text(value) else return Read.bad("Not a number: {json_text(value)}")
                let v = long_value(text) else return Read.bad("Not a number: {json_text(value)}")
                if v < range.min or v > range.max {
                    return Read.bad("{range.before}{v}{range.after}")
                }
                return Read.ok(Tag.Long(v))
            },
            Codec.Float(range) => {
                let text = number_text(value) else return Read.bad("Not a number: {json_text(value)}")
                let v = f32.parse(text) else return Read.bad("Not a number: {json_text(value)}")
                if range.checked {
                    let low = v.total_cmp(range.min)
                    let fine_low = if range.above { low == Ordering.Greater } else { low != Ordering.Less }
                    if not fine_low or v.total_cmp(range.max) == Ordering.Greater {
                        return Read.bad("{range.before}{v}{range.after}")
                    }
                }
                return Read.ok(Tag.float(v))
            },
            Codec.Double(range) => {
                let text = number_text(value) else return Read.bad("Not a number: {json_text(value)}")
                let v = f64.parse(text) else return Read.bad("Not a number: {json_text(value)}")
                if range.checked {
                    if v.total_cmp(range.min) == Ordering.Less or v.total_cmp(range.max) == Ordering.Greater {
                        return Read.bad("{range.before}{v}{range.after}")
                    }
                }
                return Read.ok(Tag.double(v))
            },
            Codec.Str => {
                return match value {
                    Json.Str(s) => Read.ok(Tag.Str(s.copy())),
                    _ => Read.bad("Not a string: {json_text(value)}"),
                }
            },
            Codec.Id => {
                let s = string_of(value) else return Read.bad("Not a string: {json_text(value)}")
                return match Identifier.parse(s) {
                    ok(id) => Read.ok(Tag.Str(id.to_string())),
                    err(e) => Read.bad("Not a valid resource location: {s} {e}"),
                }
            },
            Codec.Names(names) => {
                let s = string_of(value) else return Read.bad("Not a string: {json_text(value)}")
                for n in names {
                    if n == s {
                        return Read.ok(Tag.Str(s.copy()))
                    }
                }
                return Read.bad("Unknown element name:{s}")
            },
            Codec.ListOf(many) => {
                return match value {
                    Json.Array(items) => self.read_items(many, items, r, mut refs),
                    _ => Read.bad("Not a json array: {json_text(value)}"),
                }
            },
            Codec.Record(fields) => {
                match value {
                    Json.Object(members) => {
                        var out = JavaHashMap<String, Tag>()
                        let got = self.read_fields(fields, value, members, r, mut refs, mut out)
                        return with_value(got, Tag.Compound(out))
                    },
                    _ => return Read.bad("Not a JSON object: {json_text(value)}"),
                }
            },
            Codec.Dispatch(kinds) => {
                match value {
                    Json.Object(members) => {
                        var out = JavaHashMap<String, Tag>()
                        let got = self.read_kind(kinds, value, members, r, mut refs, mut out)
                        return with_value(got, Tag.Compound(out))
                    },
                    _ => return Read.bad("Not a JSON object: {json_text(value)}"),
                }
            },
            Codec.Either(first, second) => {
                let a = self.read(first, value, r, mut refs)
                if a.is_ok() or a.threw() {
                    return a
                }
                return either(a, self.read(second, value, r, mut refs))
            },
            Codec.Compact(of) => {
                let list = match value {
                    Json.Array(items) => compact(self.read_items(Many { of: of }, items, r, mut refs)),
                    _ => Read.bad("Not a json array: {json_text(value)}"),
                }
                if list.is_ok() or list.threw() {
                    return list
                }
                return either(list, self.read(of, value, r, mut refs))
            },
            Codec.Holder(h) => return self.read_holder(h, value, r, mut refs),
            Codec.Holders(h) => {
                // A tag, then a compact list of entries, as `Codec.either` tries them.
                let tag = match value {
                    Json.Str(s) => {
                        if s.starts_with("#") {
                            match Identifier.parse(s[1..]) {
                                ok(id) => {
                                    if reloadable(h.registry) {
                                        return Read.bad("Registry {h.registry} is not available in this context")
                                    }
                                    // A synchronized registry's tag is made where it's named, and
                                    // checked for once the packs load; a built-in one's tags are
                                    // there already, so one that isn't fails.
                                    let synced = r.find(h.registry)
                                    if let place = synced {
                                        if self.frozen and not r.synced[place].has_tag(id) {
                                            return Read.bad("Missing tag: '{id.to_string()}' in '{h.registry}'")
                                        }
                                        refs.tags.push((place, id.copy()))
                                    } else if let w = r.find_world(h.registry) {
                                        if self.frozen and not r.world[w].has_tag(id) {
                                            return Read.bad("Missing tag: '{id.to_string()}' in '{h.registry}'")
                                        }
                                        refs.tags.push((r.synced.len() + w, id.copy()))
                                    } else {
                                        if let b = r.find_builtin(h.registry) {
                                            if not r.builtin[b].has_tag(id) {
                                                return Read.bad("Missing tag: '{id.to_string()}' in '{h.registry}'")
                                            }
                                        }
                                    }
                                    return Read.ok(Tag.Str("#{id.to_string()}"))
                                },
                                err(e) => Read.bad("Not a valid resource location: {s[1..]} {e}"),
                            }
                        } else {
                            Read.bad(String("Not a tag id"))
                        }
                    },
                    _ => Read.bad("Not a string: {json_text(value)}"),
                }
                let list = match value {
                    Json.Array(items) => compact(self.read_holders(h, items, r, mut refs)),
                    _ => Read.bad("Not a json array: {json_text(value)}"),
                }
                if list.is_ok() or list.threw() {
                    return list
                }
                return either(tag, either(list, self.read_holder(h, value, r, mut refs)))
            },
            Codec.Dispatched(d) => {
                return match value {
                    Json.Object(members) => self.read_dispatched(d, members, r, mut refs),
                    _ => Read.bad("Not a JSON object: {json_text(value)}"),
                }
            },
            Codec.MapOf(m) => {
                return match value {
                    Json.Object(members) => self.read_map(m, members, r, mut refs),
                    _ => Read.bad("Not a JSON object: {json_text(value)}"),
                }
            },
            Codec.Then(t) => {
                var got = self.read(t.of, value, r, mut refs)
                if got.threw() {
                    return got
                }
                let v = got.value.take() else return got
                let f = t.then
                return after(got.error.take(), f(self, v, t.with))
            },
            Codec.Xor(first, second) => {
                var a = self.read(first, value, r, mut refs)
                if a.threw() {
                    return a
                }
                var b = self.read(second, value, r, mut refs)
                if b.threw() {
                    return b
                }
                if a.is_ok() and b.is_ok() {
                    let left = a.value.take() ?? Tag.End
                    let right = b.value.take() ?? Tag.End
                    let both = "first: {left.to_snbt()} second: {right.to_snbt()}"
                    return Read { value: some(left), error: some("Both alternatives read successfully, can not pick the correct one; {both}") }
                }
                if a.is_ok() {
                    return a
                }
                if b.is_ok() {
                    return b
                }
                // As `apply2` puts them together: the second's error first, and its partial value
                // only if both have one.
                let partial = if a.has_value() { b.value.take() } else { none }
                return Read { value: partial, error: some("{b.error ?? String()}; {a.error ?? String()}") }
            },
            Codec.Custom(f) => return f(self, value, r),
            Codec.Nested(f) => return f(self, value, r, mut refs),
            Codec.Promote(of) => {
                var got = self.read(of, value, r, mut refs)
                if got.has_value() {
                    got.error = none
                }
                return got
            },
        }
    }

    /// Reads the fields of the record at `at` from `value`, an object whose members are
    /// `members`, into `out`, as a `MapCodec` in a group reads them. What it gives has no value,
    /// only whether every field read: a value of `Tag.End` where they all did or gave a partial
    /// one, and the error.
    pub fn read_into(self, at: usize, value: Json, members: List<Member>, r: Registries, refs: mut Refs, out: mut JavaHashMap<String, Tag>) -> Read {
        match self.all[at] {
            Codec.Record(fields) => return self.read_fields(fields, value, members, r, mut refs, mut out),
            Codec.Dispatch(kinds) => return self.read_kind(kinds, value, members, r, mut refs, mut out),
            Codec.Either(first, second) => {
                // `Codec.mapEither`: the first record's fields, else the second's. Where neither
                // reads, both errors, as `apply2` puts them together: the second's first, and its
                // fields only if both have a partial value.
                var a_fields = JavaHashMap<String, Tag>()
                let a = self.read_into(first, value, members, r, mut refs, mut a_fields)
                if a.threw() {
                    return a
                }
                if a.is_ok() {
                    put_all(mut out, a_fields)
                    return a
                }
                var b_fields = JavaHashMap<String, Tag>()
                let b = self.read_into(second, value, members, r, mut refs, mut b_fields)
                if b.threw() {
                    return b
                }
                if b.is_ok() {
                    put_all(mut out, b_fields)
                    return b
                }
                let both = a.has_value() and b.has_value()
                if both {
                    put_all(mut out, b_fields)
                }
                return Read { value: if both { some(Tag.End) } else { none }, error: some("{b.error ?? String()}; {a.error ?? String()}") }
            },
            Codec.Then(t) => {
                // `MapCodec.validate` and the like: the record read on its own, then its fields put
                // in with the others.
                var mine = JavaHashMap<String, Tag>()
                var got = self.read_into(t.of, value, members, r, mut refs, mut mine)
                if got.value == none or got.threw() {
                    return got
                }
                let f = t.then
                var next = after(got.error.take(), f(self, Tag.Compound(mine), t.with))
                match next.value.take() {
                    some(Tag.Compound(fields)) => {
                        for (k, v) in fields {
                            out.insert(k.copy(), v.copy())
                        }
                        next.value = some(Tag.End)
                    },
                    _ => {},
                }
                return next
            },
            _ => return Read.bad(String("not a record")),
        }
    }

    // A record's fields, each in turn. The errors go last field first, as `RecordCodecBuilder`
    // puts them together, and there's a partial value only if every required field has one: an
    // optional field always has one.
    fn read_fields(self, fields: List<Field>, value: Json, members: List<Member>, r: Registries, refs: mut Refs, out: mut JavaHashMap<String, Tag>) -> Read {
        var errors = List<String>()
        var whole = true
        for f in fields {
            match f.need {
                Need.Inline => {
                    var got = self.read_into(f.of, value, members, r, mut refs, mut out)
                    if got.threw() {
                        return got
                    }
                    whole = whole and got.has_value()
                    if let e = got.error.take() {
                        errors.push(e)
                    }
                    continue
                },
                _ => {},
            }
            let at = given(members, f.name) else {
                match f.need {
                    Need.Required => {
                        errors.push("No key {f.name} in MapLike[{json_text(value)}]")
                        whole = false
                    },
                    Need.Always(d) => out.insert(f.name.copy(), d.copy()),
                    _ => {},
                }
                continue
            }
            var got = self.read(f.of, members[at].value, r, mut refs)
            if got.threw() {
                return got
            }
            match f.need {
                Need.Lenient(d) => {
                    if got.is_ok() {
                        let v = got.value.take() ?? Tag.End
                        if not same(v, d) {
                            out.insert(f.name.copy(), v)
                        }
                    }
                    continue
                },
                Need.Loose => {
                    if got.is_ok() {
                        out.insert(f.name.copy(), got.value.take() ?? Tag.End)
                    }
                    continue
                },
                _ => {},
            }
            if let e = got.error.take() {
                errors.push(e)
            }
            let v = got.value.take() else {
                // `OptionalFieldCodec` keeps `Optional.empty()` as its partial value, so the
                // record still has one: with nothing for the field, or its default.
                match f.need {
                    Need.Required => whole = false,
                    Need.Always(d) => out.insert(f.name.copy(), d.copy()),
                    _ => {},
                }
                continue
            }
            match f.need {
                Need.Default(d) => {
                    if not same(v, d) {
                        out.insert(f.name.copy(), v)
                    }
                },
                _ => out.insert(f.name.copy(), v),
            }
        }
        if errors.is_empty() {
            return Read.ok(Tag.End)
        }
        var message = String()
        var i = errors.len()
        while i > 0 {
            i -= 1
            if not message.is_empty() {
                message.push_str("; ")
            }
            message.push_str(errors[i])
        }
        return Read { value: if whole { some(Tag.End) } else { none }, error: some(message) }
    }

    // A dispatched record: its kind, then that kind's fields, then the kind written after them,
    // unless it's the default kind.
    fn read_kind(self, kinds: Kinds, value: Json, members: List<Member>, r: Registries, refs: mut Refs, out: mut JavaHashMap<String, Tag>) -> Read {
        let at = given(members, kinds.key)
        if at == none and kinds.default.is_empty() {
            return Read.bad("No key {kinds.key} in MapLike[{json_text(value)}]")
        }
        var name = kinds.default.copy()
        if let i = at {
            var kind = self.read(kinds.by, members[i].value, r, mut refs)
            if kind.threw() {
                return kind
            }
            if let e = kind.error.take() {
                return Read.bad(e)
            }
            name = match kind.value.take() {
                some(Tag.Str(s)) => s,
                _ => String(),
            }
        }
        for (n, of) in kinds.kinds {
            if n == name {
                let got = self.read_into(of, value, members, r, mut refs, mut out)
                if name != kinds.default {
                    out.insert(kinds.key.copy(), Tag.Str(name))
                }
                return got
            }
        }
        return Read.bad("no codec for the kind {name}")
    }

    // The items of a list, each with the codec. Each new error goes before the ones already
    // met, as `apply2stable` puts them, and the items that read are its partial value.
    fn read_items(self, many: Many, items: List<Json>, r: Registries, refs: mut Refs) -> Read {
        var out = List<Tag>()
        var message: String? = none
        for item in items {
            if out.len() >= many.max {
                continue
            }
            var got = self.read(many.of, item, r, mut refs)
            if got.threw() {
                return got
            }
            if let e = got.error.take() {
                message = some(match message.take() {
                    some(m) => "{e}; {m}",
                    none => e,
                })
            }
            if let v = got.value.take() {
                out.push(v)
            }
        }
        if out.len() < many.min {
            if not many.short.is_empty() {
                return Read.bad("{many.short}{out.len()}")
            }
            return Read.bad("List is too short: {out.len()}, expected range [{many.min}-{many.max}]")
        }
        if items.len() > many.max {
            return Read { value: some(Tag.List(out)), error: some("List is too long: {items.len()}, expected range [{many.min}-{many.max}]") }
        }
        return Read { value: some(Tag.List(out)), error: message }
    }

    // A list of a registry's entries.
    fn read_holders(self, h: HolderCodec, items: List<Json>, r: Registries, refs: mut Refs) -> Read {
        var out = List<Tag>()
        var message: String? = none
        for item in items {
            var got = self.read_holder(h, item, r, mut refs)
            if got.threw() {
                return got
            }
            if let e = got.error.take() {
                message = some(match message.take() {
                    some(m) => "{e}; {m}",
                    none => e,
                })
            }
            if let v = got.value.take() {
                out.push(v)
            }
        }
        return Read { value: some(Tag.List(out)), error: message }
    }

    // An entry by its ID, or in full where that's allowed. An ID of a registry that comes from
    // data packs is taken as it is: vanilla makes a holder for any ID while the packs load, and
    // checks they were all filled once they have, so one that isn't there goes in `refs`.
    fn read_holder(self, h: HolderCodec, value: Json, r: Registries, refs: mut Refs) -> Read {
        let id = match value {
            Json.Str(s) => match Identifier.parse(s) {
                ok(id) => some(id),
                err(e) => {
                    if h.kind != HolderKind.File {
                        return Read.bad("Not a valid resource location: {s} {e}")
                    }
                    none
                },
            },
            _ => {
                if h.kind != HolderKind.File {
                    return Read.bad("Not a string: {json_text(value)}")
                }
                none
            },
        }
        let key = id else {
            let inline = h.inline else return Read.bad(String("Inline definitions not allowed here"))
            return self.read(inline, value, r, mut refs)
        }
        if reloadable(h.registry) {
            if h.kind == HolderKind.File {
                return Read.bad("Registry does not exist: {h.registry}")
            }
            return Read.bad("Can't access registry {h.registry}")
        }
        if let s = r.find(h.registry) {
            if self.frozen {
                return known(r.synced[s], h, key)
            }
            refs.values.push((s, key.copy()))
            return Read.ok(Tag.Str(key.to_string()))
        }
        if let w = r.find_world(h.registry) {
            if self.frozen {
                return known(r.world[w], h, key)
            }
            refs.values.push((r.synced.len() + w, key.copy()))
            return Read.ok(Tag.Str(key.to_string()))
        }
        let b = r.find_builtin(h.registry) else return Read.ok(Tag.Str(key.to_string()))
        return known(r.builtin[b], h, key)
    }

    // A map whose keys pick their values' codecs, as `DispatchedMapCodec` reads one: each entry
    // in turn, the errors newest first, a key that doesn't read said twice, as its value fails
    // with its error too, and the entries that failed after them. What read is its partial value.
    fn read_dispatched(self, d: Dispatched, members: List<Member>, r: Registries, refs: mut Refs) -> Read {
        var out = JavaHashMap<String, Tag>()
        var message: String? = none
        var failed = List<Member>()
        for m in members {
            var key = self.read(d.key, Json.Str(m.key.copy()), r, mut refs)
            if key.threw() {
                return key
            }
            var error: String? = none
            if let e = key.error.take() {
                error = some("{e}; {e}")
            } else {
                let name = match key.value.take() {
                    some(Tag.Str(s)) => s,
                    _ => String(),
                }
                var of: usize? = none
                for (n, c) in d.values {
                    if n == name {
                        of = some(c)
                    }
                }
                var got = Read.ok(Tag.End)
                if let at = of {
                    got = self.read(at, m.value, r, mut refs)
                } else {
                    let k = d.keyed else return Read.bad("no codec for the key {name}")
                    got = self.read_keyed(k, m.value, Tag.Str(name.copy()), r, mut refs)
                }
                if got.threw() {
                    return got
                }
                error = got.error.take()
                if let v = got.value.take() {
                    if out.contains(name) {
                        failed.push(Member { key: m.key.copy(), value: m.value.copy() })
                        let e = "Duplicate entry for key: '{name}'"
                        message = some(match message.take() {
                            some(old) => "{e}; {old}",
                            none => e,
                        })
                        continue
                    }
                    out.insert(name, v)
                }
            }
            if let e = error {
                failed.push(Member { key: m.key.copy(), value: m.value.copy() })
                message = some(match message.take() {
                    some(old) => "{e}; {old}",
                    none => e,
                })
            }
        }
        let e = message else return Read.ok(Tag.Compound(out))
        return Read { value: some(Tag.Compound(out)), error: some("{e} missed input: {json_text(Json.Object(failed))}") }
    }

    // A value read with the `Then` at `at`, given `with` in place of its own.
    fn read_keyed(self, at: usize, value: Json, with: Tag, r: Registries, refs: mut Refs) -> Read {
        match self.all[at] {
            Codec.Then(t) => {
                var got = self.read(t.of, value, r, mut refs)
                if got.threw() {
                    return got
                }
                let v = got.value.take() else return got
                let f = t.then
                return after(got.error.take(), f(self, v, with))
            },
            _ => return self.read(at, value, r, mut refs),
        }
    }

    // A map as `BaseMapCodec` reads one: each entry's key and value read, the value's error
    // before the key's, as `apply2stable` puts them, the errors newest first, and the entries
    // that failed after them. What read is its partial value.
    fn read_map(self, m: MapOf, members: List<Member>, r: Registries, refs: mut Refs) -> Read {
        var out = JavaHashMap<String, Tag>()
        var message: String? = none
        var failed = List<Member>()
        for member in members {
            var key = self.read(m.key, Json.Str(member.key.copy()), r, mut refs)
            if key.threw() {
                return key
            }
            var got = self.read(m.value, member.value, r, mut refs)
            if got.threw() {
                return got
            }
            let key_error = key.error.take()
            let value_error = got.error.take()
            var error: String? = none
            if let k = key_error {
                error = some(match value_error {
                    some(v) => "{v}; {k}",
                    none => k,
                })
            } else {
                error = value_error
            }
            let name: String? = match key.value.take() {
                some(Tag.Str(s)) => some(s),
                _ => none,
            }
            if let n = name {
                if let v = got.value.take() {
                    if out.contains(n) {
                        failed.push(Member { key: member.key.copy(), value: member.value.copy() })
                        let e = "Duplicate entry for key: '{m.before}{shown_key(m, n)}{m.after}'"
                        message = some(match message.take() {
                            some(old) => "{e}; {old}",
                            none => e,
                        })
                        continue
                    }
                    out.insert(n, v)
                }
            }
            if let e = error {
                failed.push(Member { key: member.key.copy(), value: member.value.copy() })
                message = some(match message.take() {
                    some(old) => "{e}; {old}",
                    none => e,
                })
            }
        }
        let e = message else return Read.ok(Tag.Compound(out))
        return Read { value: some(Tag.Compound(out)), error: some("{e} missed input: {json_text(Json.Object(failed))}") }
    }
}

// Whether the registry `name` is one vanilla loads with a server's resources, after the ones a
// data pack's other entries are read with, so `RegistryOps` has no lookup for it while they're
// read and none of its entries can be named then, only given in full.
fn reloadable(name: String) -> bool {
    for r in ["loot_table", "predicate", "item_modifier", "slot_source", "context_float_provider", "context_int_provider"] {
        if name == "minecraft:{r}" {
            return true
        }
    }
    return false
}

// A map's key as its `toString` shows it in a duplicate's message.
fn shown_key(m: MapOf, key: String) -> String {
    var out = String()
    for i in 0..key.len() {
        var b = key.byte_at(i)
        if m.upper and b >= 97 and b <= 122 {
            b = b - 32
        }
        if m.dotted and (b == 58 or b == 47) {
            b = 46
        }
        out.push(rune(b))
    }
    return out
}

/// What a check or change, `next`, of a value that read with the error `before` gives, as
/// `DataResult.flatMap` puts them together: the error first, then the check's.
pub fn after(before: own String?, next: own Read) -> Read {
    var n = next
    if n.threw() {
        return n
    }
    let e = before else return n
    return match n.error.take() {
        some(m) => Read { value: n.value.take(), error: some("{e}; {m}") },
        none => Read { value: n.value.take(), error: some(e) },
    }
}

// The entry `key` of `registry`, which `h` reads, or the error for one that isn't there.
fn known(registry: Registry, h: HolderCodec, key: Identifier) -> Read {
    if registry.id(key) == none {
        if h.kind == HolderKind.ByName {
            return Read.bad("Unknown registry key in ResourceKey[minecraft:root / {h.registry}]: {key.to_string()}")
        }
        return Read.bad("Failed to get element {key.to_string()} from registry {h.registry}")
    }
    return Read.ok(Tag.Str(key.to_string()))
}

// Puts each of `fields` in `out`.
fn put_all(out: mut JavaHashMap<String, Tag>, fields: JavaHashMap<String, Tag>) {
    for (k, v) in fields {
        out.insert(k.copy(), v.copy())
    }
}

// `Codec.either`'s answer once the first, `a`, didn't read: the second if it did, else
// whichever has a partial value, else both errors.
fn either(a: own Read, b: own Read) -> Read {
    if b.is_ok() or b.threw() {
        return b
    }
    if a.has_value() {
        return a
    }
    if b.has_value() {
        return b
    }
    return Read.bad("Failed to parse either. First: {a.error ?? String()}; Second: {b.error ?? String()}")
}

/// Whether two values are equal as vanilla's `Objects.equals` finds the values they're read
/// into: numbers by their bits, so `-0.0` isn't `0.0`, and compounds by their keys in any order.
pub fn same(a: Tag, b: Tag) -> bool {
    match a {
        Tag.Float(x) => {
            return match b {
                Tag.Float(y) => x.to_bits() == y.to_bits(),
                _ => false,
            }
        },
        Tag.Double(x) => {
            return match b {
                Tag.Double(y) => x.to_bits() == y.to_bits(),
                _ => false,
            }
        },
        Tag.List(x) => {
            match b {
                Tag.List(y) => {
                    if x.len() != y.len() {
                        return false
                    }
                    for i in 0..x.len() {
                        if not same(x[i], y[i]) {
                            return false
                        }
                    }
                    return true
                },
                _ => return false,
            }
        },
        Tag.Compound(x) => {
            match b {
                Tag.Compound(y) => {
                    if x.len() != y.len() {
                        return false
                    }
                    for (k, v) in x {
                        if not y.contains(k) or not same(v, y[k]) {
                            return false
                        }
                    }
                    return true
                },
                _ => return false,
            }
        },
        _ => return a == b,
    }
}

/// `value` as Gson's `JsonElement.toString` writes it, as DataFixerUpper's messages show it.
pub fn json_text(value: Json) -> String {
    var w = JsonWriter.new()
    w.tree(value)
    return w.into_string()
}

// A number's text, or `none` for anything else.
fn number_text(value: Json) -> String? {
    return match value {
        Json.Number(t) => some(t.copy()),
        _ => none,
    }
}

// A string's text, or `none` for anything else.
fn string_of(value: Json) -> String? {
    return match value {
        Json.Str(s) => some(s.copy()),
        _ => none,
    }
}

/// Where the last member with the key is, as Gson's `JsonObject` keeps it, if it isn't `null`,
/// which `JsonOps` takes as no value.
pub fn given(members: List<Member>, key: String) -> usize? {
    var i = members.len()
    while i > 0 {
        i -= 1
        if members[i].key == key {
            return match members[i].value {
                Json.Null => none,
                _ => some(i),
            }
        }
    }
    return none
}

// What a record's fields gave, with the compound they were read into as its value.
fn with_value(got: own Read, value: own Tag) -> Read {
    var g = got
    if g.threw() {
        return g
    }
    if g.value == none {
        return Read { value: none, error: g.error.take() }
    }
    return Read { value: some(value), error: g.error.take() }
}

// A list read for a `Compact`, written as its value alone if it holds one.
fn compact(got: own Read) -> Read {
    var g = got
    match g.value.take() {
        some(Tag.List(items)) => {
            var all = items
            if all.len() == 1 {
                g.value = all.pop()
            } else {
                g.value = some(Tag.List(all))
            }
        },
        other => g.value = other,
    }
    return g
}
