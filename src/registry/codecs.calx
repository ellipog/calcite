/// Vanilla's network codecs for the synchronized registries, described for `registry.codec`:
/// the codec vanilla writes an entry's contents with when it sends them to a client that doesn't
/// know the entry's pack. Each reads what the registry's own codec reads from a data pack and
/// gives what vanilla sends, so where the network codec leaves fields out, as the variants leave
/// out their spawn conditions, the description reads only the ones it keeps.
module registry.codecs

import chat.component.{Component, Style}
import json.gson.{int_value}
import json.tree.{Json, Member}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.codec.{Codec, Codecs, Dispatched, DoubleRange, Field, FloatRange, HolderCodec, HolderKind, IntRange, Kinds, LongRange, Many, Need, Read, Then, given, json_text}
import registry.registries.{Registries}
import world.states.{StateCodec}

/// The network codec of the synchronized registry `name`, such as `damage_type` or
/// `worldgen/biome`, made in `c`, or `none` for a registry Calcite can't read yet.
pub fn network_codec(c: mut Codecs, name: String) -> usize? {
    if name == "damage_type" {
        let names = c.add(Codec.Names(["never", "when_caused_by_living_non_player", "always"]))
        let effects = c.add(Codec.Names(["hurt", "thorns", "drowning", "burning", "poking", "freezing"]))
        let deaths = c.add(Codec.Names(["default", "fall_variants", "intentional_game_design"]))
        let fields: List<Field> = [
            req("message_id", string(mut c)),
            req("scaling", names),
            req("exhaustion", c.add(Codec.Float(FloatRange()))),
            def("effects", effects, Tag.Str(String("hurt"))),
            def("death_message_type", deaths, Tag.Str(String("default"))),
        ]
        return record(mut c, fields)
    }
    if name == "chat_type" {
        let parameters = c.add(Codec.Names(["sender", "target", "content"]))
        let list = c.add(Codec.ListOf(Many { of: parameters }))
        let style = c.add(Codec.Custom(read_style))
        let decoration: List<Field> = [
            req("translation_key", string(mut c)),
            req("parameters", list),
            def("style", style, Tag.Compound(JavaHashMap<String, Tag>())),
        ]
        let d = c.add(Codec.Record(decoration))
        let fields: List<Field> = [req("chat", d), req("narration", d)]
        return record(mut c, fields)
    }
    if name == "test_environment" {
        return some(test_environment(mut c))
    }
    if name == "test_instance" {
        let data = test_data(mut c)
        let function_fields: List<Field> = [req("function", id(mut c)), inline(data)]
        let function = c.add(Codec.Record(function_fields))
        let block_fields: List<Field> = [inline(data)]
        let block = c.add(Codec.Record(block_fields))
        let by = by_name(mut c, "minecraft:test_instance_type")
        let kinds: List<(String, usize)> = [("minecraft:block_based", block), ("minecraft:function", function)]
        return some(c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })))
    }
    if name == "banner_pattern" {
        let fields: List<Field> = [req("asset_id", id(mut c)), req("translation_key", string(mut c))]
        return record(mut c, fields)
    }
    if name == "decorated_pot_pattern" {
        let fields: List<Field> = [req("asset_id", id(mut c))]
        return record(mut c, fields)
    }
    if name == "painting_variant" {
        let size = c.add(Codec.Int(IntRange { min: 1, max: 16, before: "Value must be within range [1;16]: " }))
        let fields: List<Field> = [
            req("width", size),
            req("height", size),
            req("asset_id", id(mut c)),
            opt("title", text(mut c)),
            opt("author", text(mut c)),
        ]
        return record(mut c, fields)
    }
    if name == "jukebox_song" {
        let output = c.add(Codec.Int(IntRange { min: 0, max: 15, before: "Value must be within range [0;15]: " }))
        let fields: List<Field> = [
            req("sound_event", sound(mut c)),
            req("description", text(mut c)),
            req("length_in_seconds", positive_float(mut c)),
            req("comparator_output", output),
        ]
        return record(mut c, fields)
    }
    if name == "instrument" {
        let damage = c.add(Codec.Int(IntRange { min: 0, before: "Value must be non-negative: " }))
        let fields: List<Field> = [
            req("sound_event", sound(mut c)),
            req("use_duration", c.add(Codec.Float(FloatRange { min: 0.0f32, max: f32.MAX, checked: true, before: "Value must be non-negative: " }))),
            req("range", positive_float(mut c)),
            def("durability_damage", damage, Tag.Int(0)),
            req("description", text(mut c)),
        ]
        return record(mut c, fields)
    }
    if name == "trim_pattern" {
        let fields: List<Field> = [
            req("asset_id", id(mut c)),
            req("description", text(mut c)),
            Field { name: "decal", of: c.add(Codec.Bool), need: Need.Always(Tag.Byte(0i8)) },
        ]
        return record(mut c, fields)
    }
    if name == "trim_material" {
        let fields: List<Field> = [req("palette_id", id(mut c)), req("description", text(mut c))]
        return record(mut c, fields)
    }
    if name == "world_clock" {
        let fields: List<Field> = []
        return record(mut c, fields)
    }
    if name == "frog_variant" {
        let fields: List<Field> = [req("asset_id", id(mut c))]
        return record(mut c, fields)
    }
    if name == "cat_variant" {
        let fields: List<Field> = [req("asset_id", id(mut c)), req("baby_asset_id", id(mut c))]
        return record(mut c, fields)
    }
    if name == "pig_variant" or name == "chicken_variant" {
        return some(modelled(mut c, ["normal", "cold"], true))
    }
    if name == "cow_variant" {
        return some(modelled(mut c, ["normal", "cold", "warm"], true))
    }
    if name == "zombie_nautilus_variant" {
        return some(modelled(mut c, ["normal", "warm"], false))
    }
    if name == "wolf_variant" {
        let asset_fields: List<Field> = [req("wild", id(mut c)), req("tame", id(mut c)), req("angry", id(mut c))]
        let assets = c.add(Codec.Record(asset_fields))
        let fields: List<Field> = [req("assets", assets), req("baby_assets", assets)]
        return record(mut c, fields)
    }
    if name == "wolf_sound_variant" {
        return some(sound_sets(mut c, ["ambient_sound", "death_sound", "growl_sound", "hurt_sound", "pant_sound", "whine_sound", "step_sound"]))
    }
    if name == "pig_sound_variant" {
        return some(sound_sets(mut c, ["ambient_sound", "hurt_sound", "death_sound", "step_sound", "eat_sound"]))
    }
    if name == "cat_sound_variant" {
        return some(sound_sets(mut c, [
            "ambient_sound", "stray_ambient_sound", "hiss_sound", "hurt_sound", "death_sound", "eat_sound",
            "beg_for_food_sound", "purr_sound", "purreow_sound",
        ]))
    }
    if name == "chicken_sound_variant" {
        return some(sound_sets(mut c, ["ambient_sound", "hurt_sound", "death_sound", "step_sound"]))
    }
    if name == "cow_sound_variant" {
        return some(sounds(mut c, ["ambient_sound", "hurt_sound", "death_sound", "step_sound"]))
    }
    if name == "sulfur_cube_archetype" {
        return some(sulfur_cube_archetype(mut c))
    }
    if name == "worldgen/block_state_provider" {
        return some(block_state_provider_direct(mut c))
    }
    if name == "block_transformer" {
        return some(block_transformer(mut c))
    }
    return none
}

// `BlockTransformer.DIRECT_CODEC`: from 1 to 200 ways a tool changes a block, each tried in turn.
fn block_transformer(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let face = direction(mut c)
    let faces = c.add(Codec.ListOf(Many { of: face }))
    let particles = c.add(Codec.Names(["none", "scrape", "wax_on", "wax_off"]))
    let drops = c.add(Codec.Names(["clicked_face", "from_middle"]))
    let kinds = c.add(Codec.Names(["single_block", "copper_chest"]))
    let fields: List<Field> = [
        req("block_state_provider", block_state_provider(mut c)),
        // `SoundEvents.EMPTY`, the holder an ID of it reads as, so it's left out as the default.
        def("sound", sound(mut c), Tag.Str(String("minecraft:intentionally_empty"))),
        def("particle", particles, Tag.Str(String("none"))),
        def("disallowed_faces", faces, Tag.List(List<Tag>())),
        opt("loot", id(mut c)),
        def("drop_strategy", drops, Tag.Str(String("from_middle"))),
        def("update_from_neighbors", flag, Tag.Byte(1i8)),
        def("transform_type", kinds, Tag.Str(String("single_block"))),
        def("consume_on_use", flag, Tag.Byte(1i8)),
        def("item_damage_per_use", non_negative_int(mut c), Tag.Int(0)),
    ]
    let transform = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: transform, min: 1, max: 200 }))
}

// `SulfurCubeArchetype.DIRECT_CODEC`.
fn sulfur_cube_archetype(c: mut Codecs) -> usize {
    let items = c.add(Codec.Holders(HolderCodec { registry: "minecraft:item", inline: none, kind: HolderKind.Fixed }))
    let operations = c.add(Codec.Names(["add_value", "add_multiplied_base", "add_multiplied_total"]))
    let modifier_fields: List<Field> = [
        req("attribute", by_name(mut c, "minecraft:attribute")),
        req("id", id(mut c)),
        req("amount", f64_codec(mut c)),
        req("operation", operations),
    ]
    let modifier = c.add(Codec.Record(modifier_fields))
    let modifiers = c.add(Codec.ListOf(Many { of: modifier }))
    let explosion_fields: List<Field> = [
        req("power", non_negative_int(mut c)),
        req("causes_fire", bool_codec(mut c)),
        req("fuse", positive_int(mut c)),
    ]
    let explosion = c.add(Codec.Record(explosion_fields))
    let damage_type = c.add(Codec.Holder(HolderCodec { registry: "minecraft:damage_type", inline: none, kind: HolderKind.Fixed }))
    let amount = float_provider_at_least(mut c, 0.0f32)
    let damage_fields: List<Field> = [
        req("damage_type", damage_type),
        req("amount", amount),
        req("attribute_to_source", bool_codec(mut c)),
    ]
    let damage = c.add(Codec.Record(damage_fields))
    let f = f32_codec(mut c)
    let knockback_fields: List<Field> = [req("horizontal_power", f), req("vertical_power", f)]
    let knockback = c.add(Codec.Record(knockback_fields))
    let s = sound(mut c)
    let sound_fields: List<Field> = [
        req("hit_sound", s),
        req("push_sound", s),
        req("push_sound_impulse_threshold", f),
        req("push_sound_cooldown", f),
    ]
    let sound_settings = c.add(Codec.Record(sound_fields))
    let fields: List<Field> = [
        req("items", items),
        req("attribute_modifiers", modifiers),
        def("buoyant", bool_codec(mut c), Tag.Byte(0i8)),
        opt("explosion", explosion),
        opt("contact_damage", damage),
        req("knockback_modifiers", knockback),
        req("sound_settings", sound_settings),
    ]
    return c.add(Codec.Record(fields))
}

// `BlockStateProvider.CODEC`: a provider by its ID, or given in full.
fn block_state_provider(c: mut Codecs) -> usize {
    let direct = block_state_provider_direct(mut c)
    return c.shared(String("block_state_provider"), Codec.Holder(HolderCodec { registry: "minecraft:worldgen/block_state_provider", inline: some(direct) }))
}

// `BlockStateProvider.DIRECT_CODEC`: a block state as `BlockState.FULL_CODEC` reads it, or a
// provider by its kind, where a `simple` one is written as its state.
fn block_state_provider_direct(c: mut Codecs) -> usize {
    return c.named(String("block_state_provider_direct"), make_block_state_provider)
}

fn make_block_state_provider(c: mut Codecs) -> Codec {
    let provider = block_state_provider(mut c)
    let state = block_state(mut c)
    let states = c.add(Codec.ListOf(Many { of: state }))
    let some_states = non_empty(mut c, states)
    let noise = noise_parameters(mut c)
    let positive = positive_float(mut c)
    let copy_fields: List<Field> = [req("source", provider)]
    let noise_fields: List<Field> = [
        req("seed", i64_codec(mut c)),
        req("noise", noise),
        req("scale", positive),
        req("states", some_states),
    ]
    let noise_provider = c.add(Codec.Record(noise_fields))
    let dual_fields: List<Field> = [
        req("variety", int_interval(mut c, 1, 64)),
        req("slow_noise", noise),
        req("slow_scale", positive),
        inline(noise_provider),
    ]
    let threshold = c.add(Codec.Float(FloatRange { min: -1.0f32, max: 1.0f32, checked: true, before: "Value ", after: " outside of range [-1.0:1.0]" }))
    let chance = c.add(Codec.Float(FloatRange { min: 0.0f32, max: 1.0f32, checked: true, before: "Value ", after: " outside of range [0.0:1.0]" }))
    let threshold_fields: List<Field> = [
        req("seed", i64_codec(mut c)),
        req("noise", noise),
        req("scale", positive),
        req("threshold", threshold),
        req("high_chance", chance),
        req("default_state", state),
        req("low_states", some_states),
        req("high_states", some_states),
    ]
    let blocks = c.add(Codec.Holders(HolderCodec { registry: "minecraft:block", inline: none, kind: HolderKind.Fixed }))
    let random_fields: List<Field> = [req("blocks", blocks)]
    let randomized_fields: List<Field> = [
        req("source", provider),
        req("property", string(mut c)),
        req("values", int_provider(mut c)),
    ]
    let rotated_fields: List<Field> = [req("state", provider), opt("direction", direction(mut c))]
    let rule_fields: List<Field> = [req("if_true", block_predicate(mut c)), req("then", provider)]
    let rule = c.add(Codec.Record(rule_fields))
    let rules = c.add(Codec.ListOf(Many { of: rule }))
    let rule_based_fields: List<Field> = [opt("fallback", provider), req("rules", rules)]
    let simple_fields: List<Field> = [req("state", state)]
    let weighted_fields: List<Field> = [req("entries", weighted(mut c, state))]
    let kinds: List<(String, usize)> = [
        ("minecraft:copy_properties", c.add(Codec.Record(copy_fields))),
        ("minecraft:dual_noise", c.add(Codec.Record(dual_fields))),
        ("minecraft:noise", noise_provider),
        ("minecraft:noise_threshold", c.add(Codec.Record(threshold_fields))),
        ("minecraft:random_block", c.add(Codec.Record(random_fields))),
        ("minecraft:randomized_int", c.add(Codec.Record(randomized_fields))),
        ("minecraft:rotated", c.add(Codec.Record(rotated_fields))),
        ("minecraft:rule_based", c.add(Codec.Record(rule_based_fields))),
        ("minecraft:simple", c.add(Codec.Record(simple_fields))),
        ("minecraft:weighted", c.add(Codec.Record(weighted_fields))),
    ]
    let by = by_name(mut c, "minecraft:block_state_provider_type")
    let typed = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    let full = full_block_state(mut c)
    let either = c.add(Codec.Xor(full, typed))
    return Codec.Then(Then { of: either, then: unwrap_simple, with: Tag.End })
}

// A `simple` provider as `BlockStateProvider.DIRECT_CODEC` writes it: its state, in full.
fn unwrap_simple(c: Codecs, value: Tag, _with: Tag) -> Read {
    if kind_of(value) != "minecraft:simple" {
        return Read.ok(value.copy())
    }
    match c.states {
        some(states) => {
            return match states.decode(field(value, "state")) {
                ok(s) => Read.ok(states.encode_full(s)),
                err(e) => Read.bad(e),
            }
        },
        none => return Read.bad(String("no block states to read")),
    }
}

// `BlockPredicate.CODEC`: a test of a block, by its kind.
fn block_predicate(c: mut Codecs) -> usize {
    return c.named(String("block_predicate"), make_block_predicate)
}

fn make_block_predicate(c: mut Codecs) -> Codec {
    let me = block_predicate(mut c)
    let near = offset(mut c)
    let blocks = c.add(Codec.Holders(HolderCodec { registry: "minecraft:block", inline: none, kind: HolderKind.Fixed }))
    let fluids = c.add(Codec.Holders(HolderCodec { registry: "minecraft:fluid", inline: none, kind: HolderKind.Fixed }))
    let biomes = c.add(Codec.Holders(HolderCodec { registry: "minecraft:worldgen/biome", inline: none, kind: HolderKind.Fixed }))
    let predicates = c.add(Codec.ListOf(Many { of: me }))
    let anchor = vertical_anchor(mut c)
    let blocks_fields: List<Field> = [def("offset", near, origin()), req("blocks", blocks)]
    let tag_fields: List<Field> = [def("offset", near, origin()), req("tag", id(mut c))]
    let fluids_fields: List<Field> = [def("offset", near, origin()), req("fluids", fluids)]
    let biomes_fields: List<Field> = [req("biomes", biomes)]
    let sturdy_fields: List<Field> = [def("offset", near, origin()), req("direction", direction(mut c))]
    let offset_fields: List<Field> = [def("offset", near, origin())]
    let offset_only = c.add(Codec.Record(offset_fields))
    let survive_fields: List<Field> = [def("offset", near, origin()), req("state", block_state(mut c))]
    let combining_fields: List<Field> = [req("predicates", predicates)]
    let combining = c.add(Codec.Record(combining_fields))
    let not_fields: List<Field> = [req("predicate", me)]
    let true_fields: List<Field> = []
    let unobstructed_fields: List<Field> = [def("offset", vec3i(mut c), origin())]
    let height_fields: List<Field> = [req("min_inclusive", anchor), req("max_inclusive", anchor)]
    let volume_fields: List<Field> = [req("min", near), req("max", near), req("match", me)]
    let kinds: List<(String, usize)> = [
        ("minecraft:matching_blocks", c.add(Codec.Record(blocks_fields))),
        ("minecraft:matching_block_tag", c.add(Codec.Record(tag_fields))),
        ("minecraft:matching_fluids", c.add(Codec.Record(fluids_fields))),
        ("minecraft:matching_biomes", c.add(Codec.Record(biomes_fields))),
        ("minecraft:has_sturdy_face", c.add(Codec.Record(sturdy_fields))),
        ("minecraft:solid", offset_only),
        ("minecraft:replaceable", offset_only),
        ("minecraft:would_survive", c.add(Codec.Record(survive_fields))),
        ("minecraft:inside_world_bounds", offset_only),
        ("minecraft:any_of", combining),
        ("minecraft:all_of", combining),
        ("minecraft:not", c.add(Codec.Record(not_fields))),
        ("minecraft:true", c.add(Codec.Record(true_fields))),
        ("minecraft:unobstructed", c.add(Codec.Record(unobstructed_fields))),
        ("minecraft:height_range", c.add(Codec.Record(height_fields))),
        ("minecraft:volume_match", checked(mut c, volume_fields, check_volume)),
    ]
    return Codec.Dispatch(Kinds { key: "type", by: by_name(mut c, "minecraft:block_predicate_type"), kinds: kinds })
}

// `VolumeMatchPredicate.CODEC`'s check of its bounds.
fn check_volume(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = field(value, "min")
    let max = field(value, "max")
    match min {
        Tag.IntArray(low) => match max {
            Tag.IntArray(high) => {
                if low[0] > high[0] or low[1] > high[1] or low[2] > high[2] {
                    return Read.bad(String("min bound cannot be larger than max bound"))
                }
            },
            _ => {},
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `VerticalAnchor.CODEC`: a height, absolute or from the bottom, the top or the sea.
fn vertical_anchor(c: mut Codecs) -> usize {
    let y = c.add(Codec.Int(IntRange { min: -2032, max: 2031, before: "Value ", after: " outside of range [-2032:2031]" }))
    var anchors = List<usize>()
    for name in ["absolute", "above_bottom", "below_top", "relative_to_sea_level"] {
        let fields: List<Field> = [req(String(name), y)]
        anchors.push(c.add(Codec.Record(fields)))
    }
    let last = c.add(Codec.Xor(anchors[2], anchors[3]))
    let middle = c.add(Codec.Xor(anchors[1], last))
    return c.add(Codec.Xor(anchors[0], middle))
}

// `Direction.CODEC`.
fn direction(c: mut Codecs) -> usize {
    return c.shared(String("direction"), Codec.Names(["down", "up", "north", "south", "west", "east"]))
}

// `Vec3i.ZERO`, as `Vec3i.CODEC` writes it.
fn origin() -> Tag {
    let zero: List<i32> = [0, 0, 0]
    return Tag.IntArray(zero)
}

// `Vec3i.CODEC`: three ints, written as an int array.
fn vec3i(c: mut Codecs) -> usize {
    return c.shared(String("vec3i"), Codec.Custom(read_vec3i))
}

fn read_vec3i(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Array(items) => vec3i_of(value, items),
        _ => Read.bad("Not a json array: {json_text(value)}"),
    }
}

// The `Vec3i` of `items`, the items of the array `value`.
fn vec3i_of(value: Json, items: List<Json>) -> Read {
    var ints = List<i32>()
    for item in items {
        let v = match item {
            Json.Number(digits) => int_value(digits),
            _ => none,
        }
        let n = v else return Read.bad("Some elements are not ints: {json_text(value)}")
        if ints.len() < 3 {
            ints.push(n)
        }
    }
    if items.len() < 3 {
        return Read.bad(String("Input is not a list of 3 ints"))
    }
    if items.len() > 3 {
        return Read { value: some(Tag.IntArray(ints)), error: some(String("Input is not a list of 3 ints")) }
    }
    return Read.ok(Tag.IntArray(ints))
}

// `Vec3i.offsetCodec(16)`: a `Vec3i` at most 16 from the origin on each axis.
fn offset(c: mut Codecs) -> usize {
    let v = vec3i(mut c)
    return c.shared(String("offset 16"), Codec.Then(Then { of: v, then: offset_within, with: Tag.Int(16) }))
}

fn offset_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let most = match with {
        Tag.Int(m) => m,
        _ => i32.MAX,
    }
    match value {
        Tag.IntArray(v) => {
            if java_abs(v[0]) > most or java_abs(v[1]) > most or java_abs(v[2]) > most {
                return Read.bad("Position out of range, expected at most {most}: Vec3i\{x={v[0]}, y={v[1]}, z={v[2]}\}")
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `Math.abs` of an int, which leaves the least int as it is.
fn java_abs(v: i32) -> i32 {
    if v == i32.MIN or v >= 0 {
        return v
    }
    return -v
}

// `InclusiveRange.codec(Codec.INT, least, most)`: an int, `[min, max]` or `{min_inclusive,
// max_inclusive}`, written as the int where both are the same and the pair otherwise.
fn int_interval(c: mut Codecs, least: i32, most: i32) -> usize {
    let i = i32_codec(mut c)
    let ints = c.add(Codec.ListOf(Many { of: i }))
    let array = c.add(Codec.Then(Then { of: ints, then: pair_of_ints, with: Tag.End }))
    let object_fields: List<Field> = [req("min_inclusive", i), req("max_inclusive", i)]
    let object_record = c.add(Codec.Record(object_fields))
    let object = c.add(Codec.Then(Then { of: object_record, then: pair_of_bounds, with: Tag.End }))
    let pair = c.add(Codec.Either(array, object))
    let any = c.add(Codec.Either(i, pair))
    let limits: List<i32> = [least, most]
    return c.add(Codec.Then(Then { of: any, then: interval_within, with: Tag.IntArray(limits) }))
}

// `Util.fixedSize(list, 2)`, then the interval, as a list of the two.
fn pair_of_ints(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return match value {
        Tag.List(items) => pair_of(items),
        _ => Read.bad(String("not a list")),
    }
}

fn pair_of(items: List<Tag>) -> Read {
    if items.len() < 2 {
        return Read.bad(String("Input is not a list of 2 elements"))
    }
    let pair = make_interval(items[0], items[1])
    if items.len() > 2 {
        return Read { value: pair.value, error: some(match pair.error {
            some(e) => "Input is not a list of 2 elements; {e}",
            none => String("Input is not a list of 2 elements"),
        }) }
    }
    return pair
}

fn pair_of_bounds(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return make_interval(field(value, "min_inclusive"), field(value, "max_inclusive"))
}

// `InclusiveRange.create`.
fn make_interval(min: Tag, max: Tag) -> Read {
    let low = int_tag(min)
    let high = int_tag(max)
    if low > high {
        return Read.bad(String("min_inclusive must be less than or equal to max_inclusive"))
    }
    let pair: List<Tag> = [Tag.Int(low), Tag.Int(high)]
    return Read.ok(Tag.List(pair))
}

fn interval_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let (min, max) = match value {
        Tag.Int(v) => (v, v),
        Tag.List(items) => (int_tag(items[0]), int_tag(items[1])),
        _ => (0, 0),
    }
    let (least, most) = match with {
        Tag.IntArray(v) => (v[0], v[1]),
        _ => (i32.MIN, i32.MAX),
    }
    if min < least {
        return Read.bad("Range limit too low, expected at least {least} [{min}-{max}]")
    }
    if max > most {
        return Read.bad("Range limit too high, expected at most {most} [{min}-{max}]")
    }
    if min == max {
        return Read.ok(Tag.Int(min))
    }
    let pair: List<Tag> = [Tag.Int(min), Tag.Int(max)]
    return Read.ok(Tag.List(pair))
}

// `NormalNoise.Parameters.CODEC`: a noise's first octave and its octaves' amplitudes.
fn noise_parameters(c: mut Codecs) -> usize {
    return c.named(String("noise_parameters"), make_noise_parameters)
}

fn make_noise_parameters(c: mut Codecs) -> Codec {
    let amplitude = c.add(Codec.Double(DoubleRange {
        min: f64(0.00001f32),
        max: 1000000.0,
        checked: true,
        before: "Value ",
        after: " outside of range [9.999999747378752E-6:1000000.0]",
    }))
    let base_octave = c.add(Codec.Int(IntRange { min: -32, max: 32, before: "Value ", after: " outside of range [-32:32]" }))
    let octave_count = c.add(Codec.Int(IntRange { min: 1, max: 32, before: "Value ", after: " outside of range [1:32]" }))
    let s = string(mut c)
    let legacy = c.add(Codec.Then(Then { of: s, then: check_legacy, with: Tag.End }))
    let flag = bool_codec(mut c)
    let normalize = c.add(Codec.Either(flag, legacy))
    let modifier = c.add(Codec.Double(DoubleRange { min: 0.0, max: 1000000.0, checked: true, before: "Value ", after: " outside of range [0.0:1000000.0]" }))
    let modifiers = c.add(Codec.ListOf(Many { of: modifier, min: 0, max: 32 }))
    let fields: List<Field> = [
        def("base_amplitude", amplitude, Tag.Double(1.0)),
        req("base_octave", base_octave),
        def("octave_count", octave_count, Tag.Int(1)),
        def("normalize", normalize, Tag.Byte(1i8)),
        def("amplitude_modifiers", modifiers, Tag.List(List<Tag>())),
    ]
    let parameters = c.add(Codec.Record(fields))
    return Codec.Then(Then { of: parameters, then: check_noise, with: Tag.End })
}

// `NormalNoise.Normalization.CODEC`'s check of a string.
fn check_legacy(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.Str(s) => {
            if s != "legacy" {
                return Read.bad("Invalid normalization type: {s}")
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `NormalNoise.Parameters.validate`.
fn check_noise(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let count = match field(value, "octave_count") {
        Tag.Int(n) => n,
        _ => 1,
    }
    let size = match field(value, "amplitude_modifiers") {
        Tag.List(items) => items.len(),
        _ => 0,
    }
    if size != 0 and i64.wrap(size) != i64(count) {
        return Read.bad("amplitude_modifiers had size {size}, but octave_count was {count}")
    }
    return Read.ok(value.copy())
}

// `BlockState.CODEC`: a block's default state by the block's name, or a state as `FULL_CODEC`
// reads it, written as its block's name if it's the default state.
fn block_state(c: mut Codecs) -> usize {
    return c.shared(String("block_state"), Codec.Custom(read_block_state))
}

fn read_block_state(c: Codecs, value: Json, _r: Registries) -> Read {
    match c.states {
        some(states) => {
            let first = match value {
                Json.Str(s) => match states.blocks.parse(s) {
                    ok(block) => return Read.ok(states.encode(states.default_state(block))),
                    err(e) => e,
                },
                _ => "Not a string: {json_text(value)}",
            }
            return match full_state(states, value) {
                ok(state) => Read.ok(states.encode(state)),
                err(second) => Read.bad("Failed to parse either. First: {first}; Second: {second}"),
            }
        },
        none => return Read.bad(String("no block states to read")),
    }
}

// `BlockState.FULL_CODEC`: `{id, properties}`, written with every property, even at the default
// state's values.
fn full_block_state(c: mut Codecs) -> usize {
    return c.shared(String("full_block_state"), Codec.Custom(read_full_block_state))
}

fn read_full_block_state(c: Codecs, value: Json, _r: Registries) -> Read {
    match c.states {
        some(states) => {
            return match full_state(states, value) {
                ok(state) => Read.ok(states.encode_full(state)),
                err(e) => Read.bad(e),
            }
        },
        none => return Read.bad(String("no block states to read")),
    }
}

// The state `FULL_CODEC` reads from `value`, its block by `id` and its properties as leniently as
// `StateCodec.decode` reads them, or the message it fails with.
fn full_state(states: StateCodec, value: Json) -> u32 ! String {
    match value {
        Json.Object(members) => return try state_of(states, value, members),
        _ => fail "Not a JSON object: {json_text(value)}",
    }
}

// The state `FULL_CODEC` reads from `members`, the members of the object `value`.
fn state_of(states: StateCodec, value: Json, members: List<Member>) -> u32 ! String {
    let at = given(members, "id") else fail "No key id in MapLike[{json_text(value)}]"
    let name = match members[at].value {
        Json.Str(s) => s.copy(),
        _ => fail "Not a string: {json_text(members[at].value)}",
    }
    let block = try states.blocks.parse(name)
    var tags = JavaHashMap<String, Tag>()
    tags.insert("id", Tag.Str(states.blocks.name(block)))
    if let p = given(members, "properties") {
        match members[p].value {
            Json.Object(given_values) => {
                var values = JavaHashMap<String, Tag>()
                for m in given_values {
                    match m.value {
                        Json.Str(s) => values.insert(m.key.copy(), Tag.Str(s.copy())),
                        _ => values.insert(m.key.copy(), Tag.End),
                    }
                }
                tags.insert("properties", Tag.Compound(values))
            },
            _ => {},
        }
    }
    return try states.decode(Tag.Compound(tags))
}

// `FloatProviders.CODEC`: a float, or a provider of one by its kind, where a constant one is
// written as its value alone.
fn float_provider(c: mut Codecs) -> usize {
    return c.named(String("float_provider"), make_float_provider)
}

fn make_float_provider(c: mut Codecs) -> Codec {
    let f = f32_codec(mut c)
    let constant_fields: List<Field> = [req("value", f)]
    let constant = c.add(Codec.Record(constant_fields))
    let uniform_fields: List<Field> = [req("min_inclusive", f), req("max_exclusive", f)]
    let normal_fields: List<Field> = [req("mean", f), req("deviation", f), req("min", f), req("max", f)]
    let trapezoid_fields: List<Field> = [req("min", f), req("max", f), req("plateau", f)]
    let kinds: List<(String, usize)> = [
        ("minecraft:constant", constant),
        ("minecraft:uniform", checked(mut c, uniform_fields, check_uniform_float)),
        ("minecraft:clamped_normal", checked(mut c, normal_fields, check_normal_float)),
        ("minecraft:trapezoid", checked(mut c, trapezoid_fields, check_trapezoid_float)),
    ]
    return constant_or(mut c, f, kinds, "minecraft:float_provider_type")
}

// `FloatProviders.codec(least)`: a float provider that gives no less than `least`.
fn float_provider_at_least(c: mut Codecs, least: f32) -> usize {
    let p = float_provider(mut c)
    return c.add(Codec.Then(Then { of: p, then: float_at_least, with: Tag.Float(least) }))
}

fn float_at_least(_c: Codecs, value: Tag, with: Tag) -> Read {
    let least = match with {
        Tag.Float(v) => v,
        _ => f32.NEG_INFINITY,
    }
    let (min, max) = float_bounds(value)
    if min < least {
        return Read.bad("Value provider too low: {least} [{min}-{max}]")
    }
    return Read.ok(value.copy())
}

// The least and most a float provider gives, as `FloatProvider.min` and `max` give them.
fn float_bounds(value: Tag) -> (f32, f32) {
    return match value {
        Tag.Float(v) => (v, v),
        _ => {
            if kind_of(value) == "minecraft:uniform" {
                (float_tag(field(value, "min_inclusive")), float_tag(field(value, "max_exclusive")))
            } else {
                (float_tag(field(value, "min")), float_tag(field(value, "max")))
            }
        },
    }
}

fn check_uniform_float(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = float_tag(field(value, "min_inclusive"))
    let max = float_tag(field(value, "max_exclusive"))
    if max <= min {
        return Read.bad("Max must be larger than min, min: {min}, max: {max}")
    }
    return Read.ok(value.copy())
}

fn check_normal_float(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = float_tag(field(value, "min"))
    let max = float_tag(field(value, "max"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

fn check_trapezoid_float(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = float_tag(field(value, "min"))
    let max = float_tag(field(value, "max"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    if float_tag(field(value, "plateau")) > max - min {
        return Read.bad("Plateau can at most be the full span: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

// `IntProviders.CODEC`: an int, or a provider of one by its kind, where a constant one is written
// as its value alone.
fn int_provider(c: mut Codecs) -> usize {
    return c.named(String("int_provider"), make_int_provider)
}

fn make_int_provider(c: mut Codecs) -> Codec {
    let me = int_provider(mut c)
    let i = i32_codec(mut c)
    let f = f32_codec(mut c)
    let constant_fields: List<Field> = [req("value", i)]
    let constant = c.add(Codec.Record(constant_fields))
    let uniform_fields: List<Field> = [req("min_inclusive", i), req("max_inclusive", i)]
    let uniform = checked(mut c, uniform_fields, check_int_order)
    let clamped_fields: List<Field> = [req("source", me), req("min_inclusive", i), req("max_inclusive", i)]
    let weighted_fields: List<Field> = [req("distribution", weighted(mut c, me))]
    let normal_fields: List<Field> = [req("mean", f), req("deviation", f), req("min_inclusive", i), req("max_inclusive", i)]
    let trapezoid_fields: List<Field> = [req("min", i), req("max", i), req("plateau", i)]
    let kinds: List<(String, usize)> = [
        ("minecraft:constant", constant),
        ("minecraft:uniform", uniform),
        ("minecraft:biased_to_bottom", uniform),
        ("minecraft:very_biased_to_bottom", uniform),
        ("minecraft:clamped", checked(mut c, clamped_fields, check_int_order)),
        ("minecraft:weighted_list", c.add(Codec.Record(weighted_fields))),
        ("minecraft:clamped_normal", checked(mut c, normal_fields, check_normal_int)),
        ("minecraft:trapezoid", checked(mut c, trapezoid_fields, check_trapezoid_int)),
    ]
    return constant_or(mut c, i, kinds, "minecraft:int_provider_type")
}

fn check_int_order(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = int_tag(field(value, "min_inclusive"))
    let max = int_tag(field(value, "max_inclusive"))
    if max < min {
        return Read.bad("Max must be at least min, min_inclusive: {min}, max_inclusive: {max}")
    }
    return Read.ok(value.copy())
}

fn check_normal_int(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = int_tag(field(value, "min_inclusive"))
    let max = int_tag(field(value, "max_inclusive"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

fn check_trapezoid_int(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = int_tag(field(value, "min"))
    let max = int_tag(field(value, "max"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    // As Java's `int` subtracts, wrapping.
    if int_tag(field(value, "plateau")) > i32.wrap(i64(max) - i64(min)) {
        return Read.bad("Plateau can at most be the full span: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

// A value, or a provider of one by its kind, as `FloatProviders` and `IntProviders` read them.
fn constant_or(c: mut Codecs, value: usize, kinds: own List<(String, usize)>, registry: String) -> Codec {
    let by = by_name(mut c, registry)
    let typed = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    let either = c.add(Codec.Either(value, typed))
    return Codec.Then(Then { of: either, then: unwrap_constant, with: Tag.End })
}

// A constant provider as `ConstantFloat` and `ConstantInt` are written: its value alone.
fn unwrap_constant(_c: Codecs, value: Tag, _with: Tag) -> Read {
    if kind_of(value) == "minecraft:constant" {
        return Read.ok(field(value, "value"))
    }
    return Read.ok(value.copy())
}

// `WeightedList.nonEmptyCodec` of `of`: entries `{data, weight}`, at least one with a weight.
fn weighted(c: mut Codecs, of: usize) -> usize {
    let fields: List<Field> = [req("data", of), req("weight", non_negative_int(mut c))]
    let entry = c.add(Codec.Record(fields))
    let list = c.add(Codec.ListOf(Many { of: entry }))
    return c.add(Codec.Then(Then { of: list, then: check_weighted, with: Tag.End }))
}

fn check_weighted(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var total: i64 = 0
    match value {
        Tag.List(entries) => {
            for e in entries {
                total += i64(int_tag(field(e, "weight")))
            }
        },
        _ => {},
    }
    if total == 0 {
        return Read.bad(String("Weighted list must contain at least one entry with non-zero weight"))
    }
    return Read.ok(value.copy())
}

// `ExtraCodecs.nonEmptyList` of the list codec `list`.
fn non_empty(c: mut Codecs, list: usize) -> usize {
    return c.add(Codec.Then(Then { of: list, then: check_non_empty, with: Tag.End }))
}

fn check_non_empty(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.List(items) => {
            if items.is_empty() {
                return Read.bad(String("List must have contents"))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// A record whose fields `check` checks once they've read, as `MapCodec.validate` does.
fn checked(c: mut Codecs, fields: own List<Field>, check: fn(Codecs, Tag, Tag) -> Read) -> usize {
    let at = c.add(Codec.Record(fields))
    return c.add(Codec.Then(Then { of: at, then: check, with: Tag.End }))
}

// The field `key` of a compound, or `Tag.End` where there's none.
fn field(value: Tag, key: String) -> Tag {
    match value {
        Tag.Compound(fields) => {
            if fields.contains(key) {
                return fields[key].copy()
            }
        },
        _ => {},
    }
    return Tag.End
}

// The kind a dispatched value names in its `type`, or nothing.
fn kind_of(value: Tag) -> String {
    return match field(value, "type") {
        Tag.Str(s) => s,
        _ => String(),
    }
}

fn float_tag(value: Tag) -> f32 {
    return match value {
        Tag.Float(v) => v,
        _ => 0.0f32,
    }
}

fn int_tag(value: Tag) -> i32 {
    return match value {
        Tag.Int(v) => v,
        _ => 0,
    }
}

fn bool_codec(c: mut Codecs) -> usize {
    return c.shared(String("bool"), Codec.Bool)
}

fn i32_codec(c: mut Codecs) -> usize {
    return c.shared(String("int"), Codec.Int(IntRange()))
}

fn i64_codec(c: mut Codecs) -> usize {
    return c.shared(String("long"), Codec.Long(LongRange()))
}

fn f32_codec(c: mut Codecs) -> usize {
    return c.shared(String("float"), Codec.Float(FloatRange()))
}

fn f64_codec(c: mut Codecs) -> usize {
    return c.shared(String("double"), Codec.Double(DoubleRange()))
}

// `ExtraCodecs.POSITIVE_INT`.
fn positive_int(c: mut Codecs) -> usize {
    return c.shared(String("positive_int"), Codec.Int(IntRange { min: 1, before: "Value must be positive: " }))
}

// A record of `fields`.
fn record(c: mut Codecs, fields: own List<Field>) -> usize? {
    return some(c.add(Codec.Record(fields)))
}

// A variant with a model and a texture, `ModelAndTexture.codec` with the first model as the
// default, and with a texture for its young if `baby`.
fn modelled(c: mut Codecs, models: own List<String>, baby: bool) -> usize {
    let model = c.add(Codec.Names(models.copy()))
    let asset = id(mut c)
    var fields: List<Field> = [def("model", model, Tag.Str(models[0].copy())), req("asset_id", asset)]
    if baby {
        fields.push(req("baby_asset_id", asset))
    }
    return c.add(Codec.Record(fields))
}

// A sound variant with a set of sounds for adults and one for the young.
fn sound_sets(c: mut Codecs, names: List<String>) -> usize {
    let set = sounds(mut c, names)
    return c.add(Codec.Record([req("adult_sounds", set), req("baby_sounds", set)]))
}

// A record of sounds, each a `SoundEvent.CODEC`.
fn sounds(c: mut Codecs, names: List<String>) -> usize {
    let s = sound(mut c)
    var fields = List<Field>()
    for n in names {
        fields.push(req(n, s))
    }
    return c.add(Codec.Record(fields))
}

// `TestEnvironmentDefinition.DIRECT_CODEC`.
fn test_environment(c: mut Codecs) -> usize {
    return c.named(String("test_environment"), make_test_environment)
}

fn make_test_environment(c: mut Codecs) -> Codec {
    let me = test_environment(mut c)
    let holder = c.add(Codec.Holder(HolderCodec { registry: "minecraft:test_environment", inline: some(me) }))
    let definitions = c.add(Codec.ListOf(Many { of: holder }))
    let all_of_fields: List<Field> = [req("definitions", definitions)]
    let all_of = c.add(Codec.Record(all_of_fields))
    let clock = c.add(Codec.Holder(HolderCodec { registry: "minecraft:world_clock", inline: none, kind: HolderKind.Fixed }))
    let clock_fields: List<Field> = [req("clock", clock), req("time", non_negative_int(mut c))]
    let clock_time = c.add(Codec.Record(clock_fields))
    let difficulties = c.add(Codec.Names(["peaceful", "easy", "normal", "hard"]))
    let difficulty_fields: List<Field> = [req("difficulty", difficulties)]
    let difficulty = c.add(Codec.Record(difficulty_fields))
    let function_fields: List<Field> = [opt("setup", id(mut c)), opt("teardown", id(mut c))]
    let function = c.add(Codec.Record(function_fields))
    let rules_fields: List<Field> = [req("rules", game_rules(mut c))]
    let rules = c.add(Codec.Record(rules_fields))
    let timeline = c.add(Codec.Holder(HolderCodec { registry: "minecraft:timeline", inline: none, kind: HolderKind.Fixed }))
    let timelines = c.add(Codec.ListOf(Many { of: timeline }))
    let timeline_fields: List<Field> = [req("timelines", timelines)]
    let timeline_attributes = c.add(Codec.Record(timeline_fields))
    let weathers = c.add(Codec.Names(["clear", "rain", "thunder"]))
    let weather_fields: List<Field> = [req("weather", weathers)]
    let weather = c.add(Codec.Record(weather_fields))
    let kinds: List<(String, usize)> = [
        ("minecraft:all_of", all_of),
        ("minecraft:clock_time", clock_time),
        ("minecraft:difficulty", difficulty),
        ("minecraft:function", function),
        ("minecraft:game_rules", rules),
        ("minecraft:timeline_attributes", timeline_attributes),
        ("minecraft:weather", weather),
    ]
    return Codec.Dispatch(Kinds { key: "type", by: by_name(mut c, "minecraft:test_environment_definition_type"), kinds: kinds })
}

// `TestData.CODEC`, a test's settings.
fn test_data(c: mut Codecs) -> usize {
    let direct = test_environment(mut c)
    let environment = c.add(Codec.Holder(HolderCodec { registry: "minecraft:test_environment", inline: some(direct) }))
    let positive = c.add(Codec.Int(IntRange { min: 1, before: "Value must be positive: " }))
    let flag = c.add(Codec.Bool)
    let rotations = c.add(Codec.Names(["none", "clockwise_90", "180", "counterclockwise_90"]))
    let padding = c.add(Codec.Int(IntRange { min: 0, max: 128, before: "Value must be within range [0;128]: " }))
    let fields: List<Field> = [
        req("environment", environment),
        def("dimension", id(mut c), Tag.Str(String("minecraft:overworld"))),
        req("structure", id(mut c)),
        req("max_ticks", positive),
        def("setup_ticks", non_negative_int(mut c), Tag.Int(0)),
        def("required", flag, Tag.Byte(1i8)),
        def("rotation", rotations, Tag.Str(String("none"))),
        def("manual_only", flag, Tag.Byte(0i8)),
        def("max_attempts", positive, Tag.Int(1)),
        def("required_successes", positive, Tag.Int(1)),
        def("sky_access", flag, Tag.Byte(0i8)),
        def("padding", padding, Tag.Int(0)),
    ]
    return c.add(Codec.Record(fields))
}

// `GameRuleMap.CODEC`: game rules by name, each with its value's codec, `Codec.BOOL` or
// `Codec.intRange`.
fn game_rules(c: mut Codecs) -> usize {
    let flag = c.add(Codec.Bool)
    let ints: List<(String, i32, i32)> = [
        ("fire_spread_radius_around_player", -1, i32.MAX),
        ("max_block_modifications", 1, i32.MAX),
        ("max_command_forks", 0, i32.MAX),
        ("max_command_sequence_length", 0, i32.MAX),
        ("max_entity_cramming", 0, i32.MAX),
        ("max_minecart_speed", 1, 1000),
        ("max_snow_accumulation_height", 0, 8),
        ("players_nether_portal_creative_delay", 0, i32.MAX),
        ("players_nether_portal_default_delay", 0, i32.MAX),
        ("players_sleeping_percentage", 0, i32.MAX),
        ("random_tick_speed", 0, i32.MAX),
        ("respawn_radius", 0, i32.MAX),
    ]
    let names = builtin_names()
    var values = List<(String, usize)>()
    for i in 0..names.len() {
        if names[i] != "game_rule" {
            continue
        }
        for rule in builtin_entries(i) {
            var of = flag
            for (n, min, max) in ints {
                if n == rule {
                    of = c.add(Codec.Int(IntRange { min: min, max: max, before: "Value ", after: " outside of range [{min}:{max}]" }))
                }
            }
            values.push(("minecraft:{rule}", of))
        }
    }
    let key = by_name(mut c, "minecraft:game_rule")
    return c.add(Codec.Dispatched(Dispatched { key: key, values: values }))
}

// `ExtraCodecs.NON_NEGATIVE_INT`.
fn non_negative_int(c: mut Codecs) -> usize {
    return c.shared(String("non_negative_int"), Codec.Int(IntRange { min: 0, before: "Value must be non-negative: " }))
}

// `Registry.byNameCodec` of the built-in registry `registry`.
fn by_name(c: mut Codecs, registry: String) -> usize {
    return c.shared("by_name {registry}", Codec.Holder(HolderCodec { registry: registry.copy(), inline: none, kind: HolderKind.ByName }))
}

// A record whose fields go in this one's.
fn inline(of: usize) -> Field {
    return Field { name: String(), of: of, need: Need.Inline }
}

// A field that must be there.
fn req(name: String, of: usize) -> Field {
    return Field { name: name.copy(), of: of, need: Need.Required }
}

// A field that may be left out.
fn opt(name: String, of: usize) -> Field {
    return Field { name: name.copy(), of: of, need: Need.Optional }
}

// A field with a default, not written when it has it.
fn def(name: String, of: usize, default: own Tag) -> Field {
    return Field { name: name.copy(), of: of, need: Need.Default(default) }
}

fn string(c: mut Codecs) -> usize {
    return c.shared(String("string"), Codec.Str)
}

fn id(c: mut Codecs) -> usize {
    return c.shared(String("identifier"), Codec.Id)
}

// `ExtraCodecs.POSITIVE_FLOAT`.
fn positive_float(c: mut Codecs) -> usize {
    let range = FloatRange { min: 0.0f32, max: f32.MAX, above: true, checked: true, before: "Value must be positive: " }
    return c.shared(String("positive_float"), Codec.Float(range))
}

// `ComponentSerialization.CODEC`.
fn text(c: mut Codecs) -> usize {
    return c.shared(String("text"), Codec.Custom(read_text))
}

fn read_text(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match Component.from_json(value) {
        ok(t) => Read.ok(t.to_nbt()),
        err(e) => Read.bad(e),
    }
}

// `Style.Serializer.CODEC`.
fn read_style(_c: Codecs, value: Json, _r: Registries) -> Read {
    match value {
        Json.Object(members) => {
            match Style.from_json(members) {
                ok(s) => {
                    var m = JavaHashMap<String, Tag>()
                    s.write_nbt(mut m)
                    return Read.ok(Tag.Compound(m))
                },
                err(e) => return Read.bad(e),
            }
        },
        _ => return Read.bad("Not a JSON object: {json_text(value)}"),
    }
}

// `SoundEvent.CODEC`: a sound event by its ID, or given in full.
fn sound(c: mut Codecs) -> usize {
    return c.named(String("sound_event"), make_sound)
}

fn make_sound(c: mut Codecs) -> Codec {
    let range = c.add(Codec.Float(FloatRange()))
    let fields: List<Field> = [req("sound_id", id(mut c)), Field { name: "range", of: range, need: Need.Loose }]
    let direct = c.add(Codec.Record(fields))
    return Codec.Holder(HolderCodec { registry: "minecraft:sound_event", inline: some(direct) })
}
