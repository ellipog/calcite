/// Vanilla's network codecs for the synchronized registries, described for `registry.codec`:
/// the codec vanilla writes an entry's contents with when it sends them to a client that doesn't
/// know the entry's pack. Each reads what the registry's own codec reads from a data pack and
/// gives what vanilla sends, so where the network codec leaves fields out, as the variants leave
/// out their spawn conditions, the description reads only the ones it keeps.
module registry.codecs

import chat.component.{Component, Style, as_8bit_channel, chat_string}
import java.categories.{is_letter_or_digit}
import java.uri.{Uri, exception_message}
import json.gson.{int_value}
import json.tree.{Json, Member}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.codec.{Codec, Codecs, Dispatched, DoubleRange, Field, FloatRange, HolderCodec, HolderKind, IntRange, Kinds, LongRange, Many, MapOf, Need, Read, Then, after, given, json_text, same}
import registry.registries.{Registries}
import resources.identifier.{Identifier}
import world.states.{StateCodec}

/// The network codec of the synchronized registry `name`, such as `damage_type` or
/// `worldgen/biome`, made in `c`, or `none` for a registry Calcite can't read yet.
pub fn network_codec(c: mut Codecs, name: String) -> usize? {
    if name == "damage_type" {
        let names = c.add(Codec.Names(["never", "when_caused_by_living_non_player", "always"]))
        let effects = c.add(Codec.Names(["hurt", "thorns", "drowning", "burning", "poking", "freezing"]))
        let deaths = c.add(Codec.Names(["default", "fall_variants", "intentional_game_design"]))
        let fields: List<Field> = [
            req("message_id", string(mut c)),
            req("scaling", names),
            req("exhaustion", c.add(Codec.Float(FloatRange()))),
            def("effects", effects, Tag.Str(String("hurt"))),
            def("death_message_type", deaths, Tag.Str(String("default"))),
        ]
        return record(mut c, fields)
    }
    if name == "chat_type" {
        let parameters = c.add(Codec.Names(["sender", "target", "content"]))
        let list = c.add(Codec.ListOf(Many { of: parameters }))
        let style = c.add(Codec.Custom(read_style))
        let decoration: List<Field> = [
            req("translation_key", string(mut c)),
            req("parameters", list),
            def("style", style, Tag.Compound(JavaHashMap<String, Tag>())),
        ]
        let d = c.add(Codec.Record(decoration))
        let fields: List<Field> = [req("chat", d), req("narration", d)]
        return record(mut c, fields)
    }
    if name == "test_environment" {
        return some(test_environment(mut c))
    }
    if name == "test_instance" {
        let data = test_data(mut c)
        let function_fields: List<Field> = [req("function", id(mut c)), inline(data)]
        let function = c.add(Codec.Record(function_fields))
        let block_fields: List<Field> = [inline(data)]
        let block = c.add(Codec.Record(block_fields))
        let by = by_name(mut c, "minecraft:test_instance_type")
        let kinds: List<(String, usize)> = [("minecraft:block_based", block), ("minecraft:function", function)]
        return some(c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })))
    }
    if name == "banner_pattern" {
        let fields: List<Field> = [req("asset_id", id(mut c)), req("translation_key", string(mut c))]
        return record(mut c, fields)
    }
    if name == "decorated_pot_pattern" {
        let fields: List<Field> = [req("asset_id", id(mut c))]
        return record(mut c, fields)
    }
    if name == "painting_variant" {
        let size = c.add(Codec.Int(IntRange { min: 1, max: 16, before: "Value must be within range [1;16]: " }))
        let fields: List<Field> = [
            req("width", size),
            req("height", size),
            req("asset_id", id(mut c)),
            opt("title", text(mut c)),
            opt("author", text(mut c)),
        ]
        return record(mut c, fields)
    }
    if name == "jukebox_song" {
        let output = c.add(Codec.Int(IntRange { min: 0, max: 15, before: "Value must be within range [0;15]: " }))
        let fields: List<Field> = [
            req("sound_event", sound(mut c)),
            req("description", text(mut c)),
            req("length_in_seconds", positive_float(mut c)),
            req("comparator_output", output),
        ]
        return record(mut c, fields)
    }
    if name == "instrument" {
        let damage = c.add(Codec.Int(IntRange { min: 0, before: "Value must be non-negative: " }))
        let fields: List<Field> = [
            req("sound_event", sound(mut c)),
            req("use_duration", c.add(Codec.Float(FloatRange { min: 0.0f32, max: f32.MAX, checked: true, before: "Value must be non-negative: " }))),
            req("range", positive_float(mut c)),
            def("durability_damage", damage, Tag.Int(0)),
            req("description", text(mut c)),
        ]
        return record(mut c, fields)
    }
    if name == "trim_pattern" {
        let fields: List<Field> = [
            req("asset_id", id(mut c)),
            req("description", text(mut c)),
            Field { name: "decal", of: c.add(Codec.Bool), need: Need.Always(Tag.Byte(0i8)) },
        ]
        return record(mut c, fields)
    }
    if name == "trim_material" {
        let fields: List<Field> = [req("palette_id", id(mut c)), req("description", text(mut c))]
        return record(mut c, fields)
    }
    if name == "world_clock" {
        let fields: List<Field> = []
        return record(mut c, fields)
    }
    if name == "frog_variant" {
        let fields: List<Field> = [req("asset_id", id(mut c))]
        return record(mut c, fields)
    }
    if name == "cat_variant" {
        let fields: List<Field> = [req("asset_id", id(mut c)), req("baby_asset_id", id(mut c))]
        return record(mut c, fields)
    }
    if name == "pig_variant" or name == "chicken_variant" {
        return some(modelled(mut c, ["normal", "cold"], true))
    }
    if name == "cow_variant" {
        return some(modelled(mut c, ["normal", "cold", "warm"], true))
    }
    if name == "zombie_nautilus_variant" {
        return some(modelled(mut c, ["normal", "warm"], false))
    }
    if name == "wolf_variant" {
        let asset_fields: List<Field> = [req("wild", id(mut c)), req("tame", id(mut c)), req("angry", id(mut c))]
        let assets = c.add(Codec.Record(asset_fields))
        let fields: List<Field> = [req("assets", assets), req("baby_assets", assets)]
        return record(mut c, fields)
    }
    if name == "wolf_sound_variant" {
        return some(sound_sets(mut c, ["ambient_sound", "death_sound", "growl_sound", "hurt_sound", "pant_sound", "whine_sound", "step_sound"]))
    }
    if name == "pig_sound_variant" {
        return some(sound_sets(mut c, ["ambient_sound", "hurt_sound", "death_sound", "step_sound", "eat_sound"]))
    }
    if name == "cat_sound_variant" {
        return some(sound_sets(mut c, [
            "ambient_sound", "stray_ambient_sound", "hiss_sound", "hurt_sound", "death_sound", "eat_sound",
            "beg_for_food_sound", "purr_sound", "purreow_sound",
        ]))
    }
    if name == "chicken_sound_variant" {
        return some(sound_sets(mut c, ["ambient_sound", "hurt_sound", "death_sound", "step_sound"]))
    }
    if name == "cow_sound_variant" {
        return some(sounds(mut c, ["ambient_sound", "hurt_sound", "death_sound", "step_sound"]))
    }
    if name == "sulfur_cube_archetype" {
        return some(sulfur_cube_archetype(mut c))
    }
    if name == "worldgen/block_state_provider" {
        return some(block_state_provider_direct(mut c))
    }
    if name == "block_transformer" {
        return some(block_transformer(mut c))
    }
    if name == "dialog" {
        return some(dialog_direct(mut c))
    }
    if name == "timeline" {
        return some(timeline_codec(mut c))
    }
    if name == "dimension_type" {
        return some(dimension_type(mut c))
    }
    if name == "worldgen/biome" {
        return some(biome(mut c))
    }
    return none
}

// `Dialog.DIRECT_CODEC`: a dialog by its kind.
fn dialog_direct(c: mut Codecs) -> usize {
    return c.named(String("dialog_direct"), make_dialog)
}

// `Dialog.CODEC`: a dialog by its ID, or given in full.
fn dialog_holder(c: mut Codecs) -> usize {
    let direct = dialog_direct(mut c)
    return c.shared(String("dialog"), Codec.Holder(HolderCodec { registry: "minecraft:dialog", inline: some(direct) }))
}

fn make_dialog(c: mut Codecs) -> Codec {
    let common = common_dialog(mut c)
    let button = action_button(mut c)
    let width = dialog_width(mut c)
    let positive = positive_int(mut c)
    let buttons = c.add(Codec.ListOf(Many { of: button }))
    let direct = dialog_direct(mut c)
    let dialogs = c.add(Codec.Holders(HolderCodec { registry: "minecraft:dialog", inline: some(direct) }))
    let notice_fields: List<Field> = [inline(common), def("action", button, gui_ok())]
    let links_fields: List<Field> = [
        inline(common),
        opt("exit_action", button),
        def("columns", positive, Tag.Int(2)),
        def("button_width", width, Tag.Int(150)),
    ]
    let list_fields: List<Field> = [
        inline(common),
        req("dialogs", dialogs),
        opt("exit_action", button),
        def("columns", positive, Tag.Int(2)),
        def("button_width", width, Tag.Int(150)),
    ]
    let multi_fields: List<Field> = [
        inline(common),
        req("actions", non_empty(mut c, buttons)),
        opt("exit_action", button),
        def("columns", positive, Tag.Int(2)),
    ]
    let confirm_fields: List<Field> = [inline(common), req("yes", button), req("no", button)]
    let kinds: List<(String, usize)> = [
        ("minecraft:notice", c.add(Codec.Record(notice_fields))),
        ("minecraft:server_links", c.add(Codec.Record(links_fields))),
        ("minecraft:dialog_list", c.add(Codec.Record(list_fields))),
        ("minecraft:multi_action", c.add(Codec.Record(multi_fields))),
        ("minecraft:confirmation", c.add(Codec.Record(confirm_fields))),
    ]
    let by = by_name(mut c, "minecraft:dialog_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `NoticeDialog.DEFAULT_ACTION`, as `ActionButton.CODEC` writes it: an OK button.
fn gui_ok() -> Tag {
    var label = JavaHashMap<String, Tag>()
    label.insert(String("translate"), Tag.Str(String("gui.ok")))
    var button = JavaHashMap<String, Tag>()
    button.insert(String("label"), Tag.Compound(label))
    return Tag.Compound(button)
}

// `Dialog.WIDTH_CODEC`.
fn dialog_width(c: mut Codecs) -> usize {
    return c.shared(String("dialog_width"), Codec.Int(IntRange { min: 1, max: 1024, before: "Value must be within range [1;1024]: " }))
}

// `CommonDialogData.MAP_CODEC`: what every kind of dialog has.
fn common_dialog(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let actions = c.add(Codec.Names(["close", "none", "wait_for_response"]))
    let body = dialog_body(mut c)
    let bodies = c.add(Codec.Compact(body))
    let control = dialog_input(mut c)
    let controls = c.add(Codec.ListOf(Many { of: control }))
    let fields: List<Field> = [
        req("title", text(mut c)),
        opt("external_title", text(mut c)),
        def("can_close_with_escape", flag, Tag.Byte(1i8)),
        def("pause", flag, Tag.Byte(1i8)),
        def("after_action", actions, Tag.Str(String("close"))),
        def("body", bodies, Tag.List(List<Tag>())),
        def("inputs", controls, Tag.List(List<Tag>())),
    ]
    return checked(mut c, fields, check_pause)
}

// `CommonDialogData`'s check that a dialog that pauses the game unpauses it once it's answered.
fn check_pause(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let pause = match field(value, "pause") {
        Tag.Byte(b) => b != 0,
        _ => true,
    }
    let unpauses = match field(value, "after_action") {
        Tag.Str(s) => s != "none",
        _ => true,
    }
    if pause and not unpauses {
        return Read.bad(String("Dialogs that pause the game must use after_action values that unpause it after user action!"))
    }
    return Read.ok(value.copy())
}

// `ActionButton.CODEC`: a button's label, tooltip and width, and what it does.
fn action_button(c: mut Codecs) -> usize {
    return c.named(String("action_button"), make_action_button)
}

fn make_action_button(c: mut Codecs) -> Codec {
    let fields: List<Field> = [
        req("label", text(mut c)),
        opt("tooltip", text(mut c)),
        def("width", dialog_width(mut c), Tag.Int(150)),
        opt("action", dialog_action(mut c)),
    ]
    return Codec.Record(fields)
}

// `Action.CODEC`: what a dialog's button does, by its kind: a click event's, or a command or a
// custom payload made from the dialog's inputs.
fn dialog_action(c: mut Codecs) -> usize {
    return c.named(String("dialog_action"), make_dialog_action)
}

fn make_dialog_action(c: mut Codecs) -> Codec {
    let command = c.add(Codec.Custom(read_chat_string))
    let url_fields: List<Field> = [req("url", c.add(Codec.Custom(read_untrusted_uri)))]
    let run_fields: List<Field> = [req("command", command)]
    let suggest_fields: List<Field> = [req("command", command)]
    let show_fields: List<Field> = [req("dialog", dialog_holder(mut c))]
    let page_fields: List<Field> = [req("page", positive_int(mut c))]
    let copy_fields: List<Field> = [req("value", string(mut c))]
    let custom_fields: List<Field> = [req("id", id(mut c)), opt("payload", c.add(Codec.Custom(read_nbt)))]
    let template_fields: List<Field> = [req("template", c.add(Codec.Custom(read_template)))]
    let all_fields: List<Field> = [req("id", id(mut c)), opt("additions", c.add(Codec.Custom(read_compound_tag)))]
    // `StaticAction.WRAPPED_CODECS`: each click event the server may send, by its action's name.
    let kinds: List<(String, usize)> = [
        ("minecraft:open_url", c.add(Codec.Record(url_fields))),
        ("minecraft:run_command", c.add(Codec.Record(run_fields))),
        ("minecraft:suggest_command", c.add(Codec.Record(suggest_fields))),
        ("minecraft:show_dialog", c.add(Codec.Record(show_fields))),
        ("minecraft:change_page", c.add(Codec.Record(page_fields))),
        ("minecraft:copy_to_clipboard", c.add(Codec.Record(copy_fields))),
        ("minecraft:custom", c.add(Codec.Record(custom_fields))),
        ("minecraft:dynamic/run_command", c.add(Codec.Record(template_fields))),
        ("minecraft:dynamic/custom", c.add(Codec.Record(all_fields))),
    ]
    let by = by_name(mut c, "minecraft:dialog_action_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `ExtraCodecs.CHAT_STRING`: a string with only what chat allows.
fn read_chat_string(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Str(s) => match chat_string(s.copy()) {
            ok(t) => Read.ok(Tag.Str(t)),
            err(e) => Read.bad(e),
        },
        _ => Read.bad("Not a string: {json_text(value)}"),
    }
}

// `ExtraCodecs.UNTRUSTED_URI`: a link vanilla lets players open, written as it was given, as
// `URI.toString` gives a URI read from text.
fn read_untrusted_uri(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Str(s) => match Uri.untrusted(s) {
            ok(_) => Read.ok(Tag.Str(s.copy())),
            err(e) => Read.bad(exception_message(e)),
        },
        _ => Read.bad("Not a string: {json_text(value)}"),
    }
}

// `ExtraCodecs.NBT`: any JSON, as NBT.
fn read_nbt(_c: Codecs, value: Json, _r: Registries) -> Read {
    return Read.ok(Tag.from_json(value))
}

// `CompoundTag.CODEC`: a JSON object, as NBT.
fn read_compound_tag(_c: Codecs, value: Json, _r: Registries) -> Read {
    let tag = Tag.from_json(value)
    let compound = match tag {
        Tag.Compound(_) => true,
        _ => false,
    }
    if not compound {
        return Read.bad("Not a compound tag: {tag.to_snbt()}")
    }
    return Read.ok(tag)
}

// `ParsedTemplate.CODEC`: a command with `$(name)` where an input's value goes, written as it
// was given.
fn read_template(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Str(s) => match template_error(s) {
            some(e) => Read.bad("Failed to parse template {s}: {e}"),
            none => Read.ok(Tag.Str(s.copy())),
        },
        _ => Read.bad("Not a string: {json_text(value)}"),
    }
}

// What `StringTemplate.fromString` throws for `s`, or `none` if it's a template.
fn template_error(s: String) -> String? {
    let n = s.len()
    var start: usize = 0
    var i: usize = 0
    while i < n {
        if s.byte_at(i) == 36 and i + 1 < n and s.byte_at(i + 1) == 40 {
            var end = i + 2
            while end < n and s.byte_at(end) != 41 {
                end += 1
            }
            if end == n {
                return some(String("Unterminated macro variable"))
            }
            let variable = s[i + 2..end]
            if not is_variable_name(variable) {
                return some("Invalid macro variable name '{variable}'")
            }
            start = end + 1
            i = end + 1
        } else {
            i += 1
        }
    }
    if start == 0 {
        return some(String("No variables in macro"))
    }
    return none
}

// `StringTemplate.isValidVariableName`: only letters, digits and `_`, each UTF-16 unit on its
// own, so a character past the BMP, whose halves are neither, isn't one.
fn is_variable_name(s: String) -> bool {
    for ch in s.chars() {
        let u = u32(ch)
        if u > 0xFFFF or (u != 95 and not is_letter_or_digit(u)) {
            return false
        }
    }
    return true
}

// `ParsedTemplate.VARIABLE_CODEC`: an input's key, a name a template can hold.
fn read_input_name(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Str(s) => {
            if is_variable_name(s) {
                Read.ok(Tag.Str(s.copy()))
            } else {
                Read.bad("{s} is not a valid input name")
            }
        },
        _ => Read.bad("Not a string: {json_text(value)}"),
    }
}

// `Input.CODEC`: an input's key, and its control, by its kind.
fn dialog_input(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let width = dialog_width(mut c)
    let label = text(mut c)
    let words = string(mut c)
    let number = f32_codec(mut c)
    let positive = positive_int(mut c)
    let boolean_fields: List<Field> = [
        req("label", label),
        def("initial", flag, Tag.Byte(0i8)),
        def("on_true", words, Tag.Str(String("true"))),
        def("on_false", words, Tag.Str(String("false"))),
    ]
    let range_fields: List<Field> = [
        req("start", number),
        req("end", number),
        opt("initial", number),
        opt("step", positive_float(mut c)),
    ]
    let range_info = checked(mut c, range_fields, check_range_initial)
    let number_fields: List<Field> = [
        def("width", width, Tag.Int(200)),
        req("label", label),
        def("label_format", words, Tag.Str(String("options.generic_value"))),
        inline(range_info),
    ]
    let entry_fields: List<Field> = [req("id", words), opt("display", label), def("initial", flag, Tag.Byte(0i8))]
    let full_entry = c.add(Codec.Record(entry_fields))
    let bare_entry = c.add(Codec.Then(Then { of: words, then: entry_of_id, with: Tag.End }))
    let entry = c.add(Codec.Either(full_entry, bare_entry))
    let entries = c.add(Codec.ListOf(Many { of: entry }))
    let option_fields: List<Field> = [
        def("width", width, Tag.Int(200)),
        req("options", non_empty(mut c, entries)),
        req("label", label),
        def("label_visible", flag, Tag.Byte(1i8)),
    ]
    let height = c.add(Codec.Int(IntRange { min: 1, max: 512, before: "Value must be within range [1;512]: " }))
    let multiline_fields: List<Field> = [opt("max_lines", positive), opt("height", height)]
    let multiline = c.add(Codec.Record(multiline_fields))
    let text_fields: List<Field> = [
        def("width", width, Tag.Int(200)),
        req("label", label),
        def("label_visible", flag, Tag.Byte(1i8)),
        def("initial", words, Tag.Str(String())),
        def("max_length", positive, Tag.Int(32)),
        opt("multiline", multiline),
    ]
    let kinds: List<(String, usize)> = [
        ("minecraft:boolean", c.add(Codec.Record(boolean_fields))),
        ("minecraft:number_range", c.add(Codec.Record(number_fields))),
        ("minecraft:single_option", checked(mut c, option_fields, check_one_initial)),
        ("minecraft:text", checked(mut c, text_fields, check_text_length)),
    ]
    let by = by_name(mut c, "minecraft:input_control_type")
    let control = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    let fields: List<Field> = [req("key", c.add(Codec.Custom(read_input_name))), inline(control)]
    return c.add(Codec.Record(fields))
}

// `NumberRangeInput.RangeInfo`'s check that the slider starts in its range.
fn check_range_initial(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let initial = match field(value, "initial") {
        Tag.Float(v) => f64(v),
        _ => return Read.ok(value.copy()),
    }
    let start = float_tag(field(value, "start"))
    let end = float_tag(field(value, "end"))
    let low = f64(java_min(start, end))
    let high = f64(java_max(start, end))
    if initial < low or initial > high {
        return Read.bad("Initial value {initial} is outside of range [{low}, {high}]")
    }
    return Read.ok(value.copy())
}

// `Math.min` of two floats: NaN if either is, and `-0.0` below `0.0`.
fn java_min(a: f32, b: f32) -> f32 {
    if a != a {
        return a
    }
    if a == 0.0f32 and b == 0.0f32 and b.to_bits() == 0x80000000u32 {
        return b
    }
    return if a <= b { a } else { b }
}

// `Math.max` of two floats: NaN if either is, and `0.0` above `-0.0`.
fn java_max(a: f32, b: f32) -> f32 {
    if a != a {
        return a
    }
    if a == 0.0f32 and b == 0.0f32 and a.to_bits() == 0x80000000u32 {
        return b
    }
    return if a >= b { a } else { b }
}

// `SingleOptionInput.Entry.CODEC`'s other way: an option by its ID alone.
fn entry_of_id(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), value.copy())
    return Read.ok(Tag.Compound(m))
}

// `SingleOptionInput`'s check that at most one option is picked at the start.
fn check_one_initial(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var picked = 0
    match field(value, "options") {
        Tag.List(entries) => {
            for e in entries {
                match field(e, "initial") {
                    Tag.Byte(b) => {
                        if b != 0 {
                            picked += 1
                        }
                    },
                    _ => {},
                }
            }
        },
        _ => {},
    }
    if picked > 1 {
        return Read.bad(String("Multiple initial values"))
    }
    return Read.ok(value.copy())
}

// `TextInput`'s check that its first text fits, in UTF-16 units, as Java's `length` counts.
fn check_text_length(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let length = match field(value, "initial") {
        Tag.Str(s) => s.utf16_len(),
        _ => 0,
    }
    let most = match field(value, "max_length") {
        Tag.Int(n) => usize.wrap(n),
        _ => 32,
    }
    if length > most {
        return Read.bad(String("Default text length exceeds allowed size"))
    }
    return Read.ok(value.copy())
}

// `DialogBody.DIALOG_BODY_CODEC`: what a dialog shows, by its kind.
fn dialog_body(c: mut Codecs) -> usize {
    let width = dialog_width(mut c)
    let words = text(mut c)
    let plain_fields: List<Field> = [req("contents", words), def("width", width, Tag.Int(200))]
    let plain = c.add(Codec.Record(plain_fields))
    // `PlainMessage.CODEC`: in full, or its text alone.
    let bare = c.add(Codec.Then(Then { of: words, then: contents_of, with: Tag.End }))
    let message = c.add(Codec.Either(plain, bare))
    let flag = bool_codec(mut c)
    let size = c.add(Codec.Int(IntRange { min: 1, max: 256, before: "Value must be within range [1;256]: " }))
    let item_fields: List<Field> = [
        req("item", item_stack_template(mut c)),
        opt("description", message),
        def("show_decorations", flag, Tag.Byte(1i8)),
        def("show_tooltip", flag, Tag.Byte(1i8)),
        def("width", size, Tag.Int(16)),
        def("height", size, Tag.Int(16)),
    ]
    let kinds: List<(String, usize)> = [
        ("minecraft:item", c.add(Codec.Record(item_fields))),
        ("minecraft:plain_message", plain),
    ]
    let by = by_name(mut c, "minecraft:dialog_body_type")
    return c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
}

// A plain message of the text `value`, at its default width.
fn contents_of(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("contents"), value.copy())
    return Read.ok(Tag.Compound(m))
}

// `ItemStackTemplate.CODEC`: an item and how many, as `{id, count, components}` or by its ID
// alone, written in full.
fn item_stack_template(c: mut Codecs) -> usize {
    let items = by_name(mut c, "minecraft:item")
    let item = c.add(Codec.Then(Then { of: items, then: not_air, with: Tag.End }))
    let count = c.add(Codec.Int(IntRange { min: 1, max: 99, before: "Value must be within range [1;99]: " }))
    let components = c.add(Codec.Custom(read_component_patch))
    let fields: List<Field> = [
        req("id", item),
        def("count", count, Tag.Int(1)),
        def("components", components, Tag.Compound(JavaHashMap<String, Tag>())),
    ]
    let full = c.add(Codec.Record(fields))
    let bare = c.add(Codec.Then(Then { of: item, then: stack_of_item, with: Tag.End }))
    return c.add(Codec.Either(full, bare))
}

// `Item.CODEC`'s check.
fn not_air(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let air = match value {
        Tag.Str(s) => s == "minecraft:air",
        _ => false,
    }
    if air {
        return Read.bad(String("Item must not be minecraft:air"))
    }
    return Read.ok(value.copy())
}

// One of the item `value`, as `ItemStackTemplate.MAP_CODEC` writes it.
fn stack_of_item(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), value.copy())
    return Read.ok(Tag.Compound(m))
}

// `DataComponentPatch.CODEC`, which Calcite reads only when it changes nothing (CAL-77).
fn read_component_patch(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Object(members) => {
            if members.is_empty() {
                Read.ok(Tag.Compound(JavaHashMap<String, Tag>()))
            } else {
                Read.bad(String("Calcite can't read item components yet"))
            }
        },
        _ => Read.bad("Not a JSON object: {json_text(value)}"),
    }
}

// `BlockTransformer.DIRECT_CODEC`: from 1 to 200 ways a tool changes a block, each tried in turn.
fn block_transformer(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let face = direction(mut c)
    let faces = c.add(Codec.ListOf(Many { of: face }))
    let particles = c.add(Codec.Names(["none", "scrape", "wax_on", "wax_off"]))
    let drops = c.add(Codec.Names(["clicked_face", "from_middle"]))
    let kinds = c.add(Codec.Names(["single_block", "copper_chest"]))
    let fields: List<Field> = [
        req("block_state_provider", block_state_provider(mut c)),
        // `SoundEvents.EMPTY`, the holder an ID of it reads as, so it's left out as the default.
        def("sound", sound(mut c), Tag.Str(String("minecraft:intentionally_empty"))),
        def("particle", particles, Tag.Str(String("none"))),
        def("disallowed_faces", faces, Tag.List(List<Tag>())),
        opt("loot", id(mut c)),
        def("drop_strategy", drops, Tag.Str(String("from_middle"))),
        def("update_from_neighbors", flag, Tag.Byte(1i8)),
        def("transform_type", kinds, Tag.Str(String("single_block"))),
        def("consume_on_use", flag, Tag.Byte(1i8)),
        def("item_damage_per_use", non_negative_int(mut c), Tag.Int(0)),
    ]
    let transform = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: transform, min: 1, max: 200 }))
}

// `SulfurCubeArchetype.DIRECT_CODEC`.
fn sulfur_cube_archetype(c: mut Codecs) -> usize {
    let items = c.add(Codec.Holders(HolderCodec { registry: "minecraft:item", inline: none, kind: HolderKind.Fixed }))
    let operations = c.add(Codec.Names(["add_value", "add_multiplied_base", "add_multiplied_total"]))
    let modifier_fields: List<Field> = [
        req("attribute", by_name(mut c, "minecraft:attribute")),
        req("id", id(mut c)),
        req("amount", f64_codec(mut c)),
        req("operation", operations),
    ]
    let modifier = c.add(Codec.Record(modifier_fields))
    let modifiers = c.add(Codec.ListOf(Many { of: modifier }))
    let explosion_fields: List<Field> = [
        req("power", non_negative_int(mut c)),
        req("causes_fire", bool_codec(mut c)),
        req("fuse", positive_int(mut c)),
    ]
    let explosion = c.add(Codec.Record(explosion_fields))
    let damage_type = c.add(Codec.Holder(HolderCodec { registry: "minecraft:damage_type", inline: none, kind: HolderKind.Fixed }))
    let amount = float_provider_at_least(mut c, 0.0f32)
    let damage_fields: List<Field> = [
        req("damage_type", damage_type),
        req("amount", amount),
        req("attribute_to_source", bool_codec(mut c)),
    ]
    let damage = c.add(Codec.Record(damage_fields))
    let f = f32_codec(mut c)
    let knockback_fields: List<Field> = [req("horizontal_power", f), req("vertical_power", f)]
    let knockback = c.add(Codec.Record(knockback_fields))
    let s = sound(mut c)
    let sound_fields: List<Field> = [
        req("hit_sound", s),
        req("push_sound", s),
        req("push_sound_impulse_threshold", f),
        req("push_sound_cooldown", f),
    ]
    let sound_settings = c.add(Codec.Record(sound_fields))
    let fields: List<Field> = [
        req("items", items),
        req("attribute_modifiers", modifiers),
        def("buoyant", bool_codec(mut c), Tag.Byte(0i8)),
        opt("explosion", explosion),
        opt("contact_damage", damage),
        req("knockback_modifiers", knockback),
        req("sound_settings", sound_settings),
    ]
    return c.add(Codec.Record(fields))
}

// `BlockStateProvider.CODEC`: a provider by its ID, or given in full.
fn block_state_provider(c: mut Codecs) -> usize {
    let direct = block_state_provider_direct(mut c)
    return c.shared(String("block_state_provider"), Codec.Holder(HolderCodec { registry: "minecraft:worldgen/block_state_provider", inline: some(direct) }))
}

// `BlockStateProvider.DIRECT_CODEC`: a block state as `BlockState.FULL_CODEC` reads it, or a
// provider by its kind, where a `simple` one is written as its state.
fn block_state_provider_direct(c: mut Codecs) -> usize {
    return c.named(String("block_state_provider_direct"), make_block_state_provider)
}

fn make_block_state_provider(c: mut Codecs) -> Codec {
    let provider = block_state_provider(mut c)
    let state = block_state(mut c)
    let states = c.add(Codec.ListOf(Many { of: state }))
    let some_states = non_empty(mut c, states)
    let noise = noise_parameters(mut c)
    let positive = positive_float(mut c)
    let copy_fields: List<Field> = [req("source", provider)]
    let noise_fields: List<Field> = [
        req("seed", i64_codec(mut c)),
        req("noise", noise),
        req("scale", positive),
        req("states", some_states),
    ]
    let noise_provider = c.add(Codec.Record(noise_fields))
    let dual_fields: List<Field> = [
        req("variety", int_interval(mut c, 1, 64)),
        req("slow_noise", noise),
        req("slow_scale", positive),
        inline(noise_provider),
    ]
    let threshold = c.add(Codec.Float(FloatRange { min: -1.0f32, max: 1.0f32, checked: true, before: "Value ", after: " outside of range [-1.0:1.0]" }))
    let chance = c.add(Codec.Float(FloatRange { min: 0.0f32, max: 1.0f32, checked: true, before: "Value ", after: " outside of range [0.0:1.0]" }))
    let threshold_fields: List<Field> = [
        req("seed", i64_codec(mut c)),
        req("noise", noise),
        req("scale", positive),
        req("threshold", threshold),
        req("high_chance", chance),
        req("default_state", state),
        req("low_states", some_states),
        req("high_states", some_states),
    ]
    let blocks = c.add(Codec.Holders(HolderCodec { registry: "minecraft:block", inline: none, kind: HolderKind.Fixed }))
    let random_fields: List<Field> = [req("blocks", blocks)]
    let randomized_fields: List<Field> = [
        req("source", provider),
        req("property", string(mut c)),
        req("values", int_provider(mut c)),
    ]
    let rotated_fields: List<Field> = [req("state", provider), opt("direction", direction(mut c))]
    let rule_fields: List<Field> = [req("if_true", block_predicate(mut c)), req("then", provider)]
    let rule = c.add(Codec.Record(rule_fields))
    let rules = c.add(Codec.ListOf(Many { of: rule }))
    let rule_based_fields: List<Field> = [opt("fallback", provider), req("rules", rules)]
    let simple_fields: List<Field> = [req("state", state)]
    let weighted_fields: List<Field> = [req("entries", weighted(mut c, state))]
    let kinds: List<(String, usize)> = [
        ("minecraft:copy_properties", c.add(Codec.Record(copy_fields))),
        ("minecraft:dual_noise", c.add(Codec.Record(dual_fields))),
        ("minecraft:noise", noise_provider),
        ("minecraft:noise_threshold", c.add(Codec.Record(threshold_fields))),
        ("minecraft:random_block", c.add(Codec.Record(random_fields))),
        ("minecraft:randomized_int", c.add(Codec.Record(randomized_fields))),
        ("minecraft:rotated", c.add(Codec.Record(rotated_fields))),
        ("minecraft:rule_based", c.add(Codec.Record(rule_based_fields))),
        ("minecraft:simple", c.add(Codec.Record(simple_fields))),
        ("minecraft:weighted", c.add(Codec.Record(weighted_fields))),
    ]
    let by = by_name(mut c, "minecraft:block_state_provider_type")
    let typed = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    let full = full_block_state(mut c)
    let either = c.add(Codec.Xor(full, typed))
    return Codec.Then(Then { of: either, then: unwrap_simple, with: Tag.End })
}

// A `simple` provider as `BlockStateProvider.DIRECT_CODEC` writes it: its state, in full.
fn unwrap_simple(c: Codecs, value: Tag, _with: Tag) -> Read {
    if kind_of(value) != "minecraft:simple" {
        return Read.ok(value.copy())
    }
    match c.states {
        some(states) => {
            return match states.decode(field(value, "state")) {
                ok(s) => Read.ok(states.encode_full(s)),
                err(e) => Read.bad(e),
            }
        },
        none => return Read.bad(String("no block states to read")),
    }
}

// `BlockPredicate.CODEC`: a test of a block, by its kind.
fn block_predicate(c: mut Codecs) -> usize {
    return c.named(String("block_predicate"), make_block_predicate)
}

fn make_block_predicate(c: mut Codecs) -> Codec {
    let me = block_predicate(mut c)
    let near = offset(mut c)
    let blocks = c.add(Codec.Holders(HolderCodec { registry: "minecraft:block", inline: none, kind: HolderKind.Fixed }))
    let fluids = c.add(Codec.Holders(HolderCodec { registry: "minecraft:fluid", inline: none, kind: HolderKind.Fixed }))
    let biomes = c.add(Codec.Holders(HolderCodec { registry: "minecraft:worldgen/biome", inline: none, kind: HolderKind.Fixed }))
    let predicates = c.add(Codec.ListOf(Many { of: me }))
    let anchor = vertical_anchor(mut c)
    let blocks_fields: List<Field> = [def("offset", near, origin()), req("blocks", blocks)]
    let tag_fields: List<Field> = [def("offset", near, origin()), req("tag", id(mut c))]
    let fluids_fields: List<Field> = [def("offset", near, origin()), req("fluids", fluids)]
    let biomes_fields: List<Field> = [req("biomes", biomes)]
    let sturdy_fields: List<Field> = [def("offset", near, origin()), req("direction", direction(mut c))]
    let offset_fields: List<Field> = [def("offset", near, origin())]
    let offset_only = c.add(Codec.Record(offset_fields))
    let survive_fields: List<Field> = [def("offset", near, origin()), req("state", block_state(mut c))]
    let combining_fields: List<Field> = [req("predicates", predicates)]
    let combining = c.add(Codec.Record(combining_fields))
    let not_fields: List<Field> = [req("predicate", me)]
    let true_fields: List<Field> = []
    let unobstructed_fields: List<Field> = [def("offset", vec3i(mut c), origin())]
    let height_fields: List<Field> = [req("min_inclusive", anchor), req("max_inclusive", anchor)]
    let volume_fields: List<Field> = [req("min", near), req("max", near), req("match", me)]
    let kinds: List<(String, usize)> = [
        ("minecraft:matching_blocks", c.add(Codec.Record(blocks_fields))),
        ("minecraft:matching_block_tag", c.add(Codec.Record(tag_fields))),
        ("minecraft:matching_fluids", c.add(Codec.Record(fluids_fields))),
        ("minecraft:matching_biomes", c.add(Codec.Record(biomes_fields))),
        ("minecraft:has_sturdy_face", c.add(Codec.Record(sturdy_fields))),
        ("minecraft:solid", offset_only),
        ("minecraft:replaceable", offset_only),
        ("minecraft:would_survive", c.add(Codec.Record(survive_fields))),
        ("minecraft:inside_world_bounds", offset_only),
        ("minecraft:any_of", combining),
        ("minecraft:all_of", combining),
        ("minecraft:not", c.add(Codec.Record(not_fields))),
        ("minecraft:true", c.add(Codec.Record(true_fields))),
        ("minecraft:unobstructed", c.add(Codec.Record(unobstructed_fields))),
        ("minecraft:height_range", c.add(Codec.Record(height_fields))),
        ("minecraft:volume_match", checked(mut c, volume_fields, check_volume)),
    ]
    return Codec.Dispatch(Kinds { key: "type", by: by_name(mut c, "minecraft:block_predicate_type"), kinds: kinds })
}

// `VolumeMatchPredicate.CODEC`'s check of its bounds.
fn check_volume(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = field(value, "min")
    let max = field(value, "max")
    match min {
        Tag.IntArray(low) => match max {
            Tag.IntArray(high) => {
                if low[0] > high[0] or low[1] > high[1] or low[2] > high[2] {
                    return Read.bad(String("min bound cannot be larger than max bound"))
                }
            },
            _ => {},
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `VerticalAnchor.CODEC`: a height, absolute or from the bottom, the top or the sea.
fn vertical_anchor(c: mut Codecs) -> usize {
    let y = c.add(Codec.Int(IntRange { min: -2032, max: 2031, before: "Value ", after: " outside of range [-2032:2031]" }))
    var anchors = List<usize>()
    for name in ["absolute", "above_bottom", "below_top", "relative_to_sea_level"] {
        let fields: List<Field> = [req(String(name), y)]
        anchors.push(c.add(Codec.Record(fields)))
    }
    let last = c.add(Codec.Xor(anchors[2], anchors[3]))
    let middle = c.add(Codec.Xor(anchors[1], last))
    return c.add(Codec.Xor(anchors[0], middle))
}

// `Direction.CODEC`.
fn direction(c: mut Codecs) -> usize {
    return c.shared(String("direction"), Codec.Names(["down", "up", "north", "south", "west", "east"]))
}

// `Vec3i.ZERO`, as `Vec3i.CODEC` writes it.
fn origin() -> Tag {
    let zero: List<i32> = [0, 0, 0]
    return Tag.IntArray(zero)
}

// `Vec3i.CODEC`: three ints, written as an int array.
fn vec3i(c: mut Codecs) -> usize {
    return c.shared(String("vec3i"), Codec.Custom(read_vec3i))
}

fn read_vec3i(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Array(items) => ints_of(value, items, 3),
        _ => Read.bad("Not a json array: {json_text(value)}"),
    }
}

// The `n` ints of `items`, the items of the array `value`, as `Codec.INT_STREAM` and
// `Util.fixedSize` read them.
fn ints_of(value: Json, items: List<Json>, n: usize) -> Read {
    var ints = List<i32>()
    for item in items {
        let v = match item {
            Json.Number(digits) => int_value(digits),
            _ => none,
        }
        let i = v else return Read.bad("Some elements are not ints: {json_text(value)}")
        if ints.len() < n {
            ints.push(i)
        }
    }
    if items.len() < n {
        return Read.bad("Input is not a list of {n} ints")
    }
    if items.len() > n {
        return Read { value: some(Tag.IntArray(ints)), error: some("Input is not a list of {n} ints") }
    }
    return Read.ok(Tag.IntArray(ints))
}

// `Vec3i.offsetCodec(16)`: a `Vec3i` at most 16 from the origin on each axis.
fn offset(c: mut Codecs) -> usize {
    let v = vec3i(mut c)
    return c.shared(String("offset 16"), Codec.Then(Then { of: v, then: offset_within, with: Tag.Int(16) }))
}

fn offset_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let most = match with {
        Tag.Int(m) => m,
        _ => i32.MAX,
    }
    match value {
        Tag.IntArray(v) => {
            if java_abs(v[0]) > most or java_abs(v[1]) > most or java_abs(v[2]) > most {
                return Read.bad("Position out of range, expected at most {most}: Vec3i\{x={v[0]}, y={v[1]}, z={v[2]}\}")
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `Math.abs` of an int, which leaves the least int as it is.
fn java_abs(v: i32) -> i32 {
    if v == i32.MIN or v >= 0 {
        return v
    }
    return -v
}

// `InclusiveRange.codec(Codec.INT, least, most)`: an int, `[min, max]` or `{min_inclusive,
// max_inclusive}`, written as the int where both are the same and the pair otherwise.
fn int_interval(c: mut Codecs, least: i32, most: i32) -> usize {
    let i = i32_codec(mut c)
    let ints = c.add(Codec.ListOf(Many { of: i }))
    let array = c.add(Codec.Then(Then { of: ints, then: pair_of_ints, with: Tag.End }))
    let object_fields: List<Field> = [req("min_inclusive", i), req("max_inclusive", i)]
    let object_record = c.add(Codec.Record(object_fields))
    let object = c.add(Codec.Then(Then { of: object_record, then: pair_of_bounds, with: Tag.End }))
    let pair = c.add(Codec.Either(array, object))
    let any = c.add(Codec.Either(i, pair))
    let limits: List<i32> = [least, most]
    return c.add(Codec.Then(Then { of: any, then: interval_within, with: Tag.IntArray(limits) }))
}

// `Util.fixedSize(list, 2)`, then the interval, as a list of the two.
fn pair_of_ints(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return match value {
        Tag.List(items) => pair_of(items),
        _ => Read.bad(String("not a list")),
    }
}

fn pair_of(items: List<Tag>) -> Read {
    if items.len() < 2 {
        return Read.bad(String("Input is not a list of 2 elements"))
    }
    let pair = make_interval(items[0], items[1])
    if items.len() > 2 {
        return Read { value: pair.value, error: some(match pair.error {
            some(e) => "Input is not a list of 2 elements; {e}",
            none => String("Input is not a list of 2 elements"),
        }) }
    }
    return pair
}

fn pair_of_bounds(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return make_interval(field(value, "min_inclusive"), field(value, "max_inclusive"))
}

// `InclusiveRange.create`.
fn make_interval(min: Tag, max: Tag) -> Read {
    let low = int_tag(min)
    let high = int_tag(max)
    if low > high {
        return Read.bad(String("min_inclusive must be less than or equal to max_inclusive"))
    }
    let pair: List<Tag> = [Tag.Int(low), Tag.Int(high)]
    return Read.ok(Tag.List(pair))
}

fn interval_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let (min, max) = match value {
        Tag.Int(v) => (v, v),
        Tag.List(items) => (int_tag(items[0]), int_tag(items[1])),
        _ => (0, 0),
    }
    let (least, most) = match with {
        Tag.IntArray(v) => (v[0], v[1]),
        _ => (i32.MIN, i32.MAX),
    }
    if min < least {
        return Read.bad("Range limit too low, expected at least {least} [{min}-{max}]")
    }
    if max > most {
        return Read.bad("Range limit too high, expected at most {most} [{min}-{max}]")
    }
    if min == max {
        return Read.ok(Tag.Int(min))
    }
    let pair: List<Tag> = [Tag.Int(min), Tag.Int(max)]
    return Read.ok(Tag.List(pair))
}

// `NormalNoise.Parameters.CODEC`: a noise's first octave and its octaves' amplitudes.
fn noise_parameters(c: mut Codecs) -> usize {
    return c.named(String("noise_parameters"), make_noise_parameters)
}

fn make_noise_parameters(c: mut Codecs) -> Codec {
    let amplitude = c.add(Codec.Double(DoubleRange {
        min: f64(0.00001f32),
        max: 1000000.0,
        checked: true,
        before: "Value ",
        after: " outside of range [9.999999747378752E-6:1000000.0]",
    }))
    let base_octave = c.add(Codec.Int(IntRange { min: -32, max: 32, before: "Value ", after: " outside of range [-32:32]" }))
    let octave_count = c.add(Codec.Int(IntRange { min: 1, max: 32, before: "Value ", after: " outside of range [1:32]" }))
    let s = string(mut c)
    let legacy = c.add(Codec.Then(Then { of: s, then: check_legacy, with: Tag.End }))
    let flag = bool_codec(mut c)
    let normalize = c.add(Codec.Either(flag, legacy))
    let modifier = c.add(Codec.Double(DoubleRange { min: 0.0, max: 1000000.0, checked: true, before: "Value ", after: " outside of range [0.0:1000000.0]" }))
    let modifiers = c.add(Codec.ListOf(Many { of: modifier, min: 0, max: 32 }))
    let fields: List<Field> = [
        def("base_amplitude", amplitude, Tag.Double(1.0)),
        req("base_octave", base_octave),
        def("octave_count", octave_count, Tag.Int(1)),
        def("normalize", normalize, Tag.Byte(1i8)),
        def("amplitude_modifiers", modifiers, Tag.List(List<Tag>())),
    ]
    let parameters = c.add(Codec.Record(fields))
    return Codec.Then(Then { of: parameters, then: check_noise, with: Tag.End })
}

// `NormalNoise.Normalization.CODEC`'s check of a string.
fn check_legacy(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.Str(s) => {
            if s != "legacy" {
                return Read.bad("Invalid normalization type: {s}")
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `NormalNoise.Parameters.validate`.
fn check_noise(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let count = match field(value, "octave_count") {
        Tag.Int(n) => n,
        _ => 1,
    }
    let size = match field(value, "amplitude_modifiers") {
        Tag.List(items) => items.len(),
        _ => 0,
    }
    if size != 0 and i64.wrap(size) != i64(count) {
        return Read.bad("amplitude_modifiers had size {size}, but octave_count was {count}")
    }
    return Read.ok(value.copy())
}

// `BlockState.CODEC`: a block's default state by the block's name, or a state as `FULL_CODEC`
// reads it, written as its block's name if it's the default state.
fn block_state(c: mut Codecs) -> usize {
    return c.shared(String("block_state"), Codec.Custom(read_block_state))
}

fn read_block_state(c: Codecs, value: Json, _r: Registries) -> Read {
    match c.states {
        some(states) => {
            let first = match value {
                Json.Str(s) => match states.blocks.parse(s) {
                    ok(block) => return Read.ok(states.encode(states.default_state(block))),
                    err(e) => e,
                },
                _ => "Not a string: {json_text(value)}",
            }
            return match full_state(states, value) {
                ok(state) => Read.ok(states.encode(state)),
                err(second) => Read.bad("Failed to parse either. First: {first}; Second: {second}"),
            }
        },
        none => return Read.bad(String("no block states to read")),
    }
}

// `BlockState.FULL_CODEC`: `{id, properties}`, written with every property, even at the default
// state's values.
fn full_block_state(c: mut Codecs) -> usize {
    return c.shared(String("full_block_state"), Codec.Custom(read_full_block_state))
}

fn read_full_block_state(c: Codecs, value: Json, _r: Registries) -> Read {
    match c.states {
        some(states) => {
            return match full_state(states, value) {
                ok(state) => Read.ok(states.encode_full(state)),
                err(e) => Read.bad(e),
            }
        },
        none => return Read.bad(String("no block states to read")),
    }
}

// The state `FULL_CODEC` reads from `value`, its block by `id` and its properties as leniently as
// `StateCodec.decode` reads them, or the message it fails with.
fn full_state(states: StateCodec, value: Json) -> u32 ! String {
    match value {
        Json.Object(members) => return try state_of(states, value, members),
        _ => fail "Not a JSON object: {json_text(value)}",
    }
}

// The state `FULL_CODEC` reads from `members`, the members of the object `value`.
fn state_of(states: StateCodec, value: Json, members: List<Member>) -> u32 ! String {
    let at = given(members, "id") else fail "No key id in MapLike[{json_text(value)}]"
    let name = match members[at].value {
        Json.Str(s) => s.copy(),
        _ => fail "Not a string: {json_text(members[at].value)}",
    }
    let block = try states.blocks.parse(name)
    var tags = JavaHashMap<String, Tag>()
    tags.insert("id", Tag.Str(states.blocks.name(block)))
    if let p = given(members, "properties") {
        match members[p].value {
            Json.Object(given_values) => {
                var values = JavaHashMap<String, Tag>()
                for m in given_values {
                    match m.value {
                        Json.Str(s) => values.insert(m.key.copy(), Tag.Str(s.copy())),
                        _ => values.insert(m.key.copy(), Tag.End),
                    }
                }
                tags.insert("properties", Tag.Compound(values))
            },
            _ => {},
        }
    }
    return try states.decode(Tag.Compound(tags))
}

// `FloatProviders.CODEC`: a float, or a provider of one by its kind, where a constant one is
// written as its value alone.
fn float_provider(c: mut Codecs) -> usize {
    return c.named(String("float_provider"), make_float_provider)
}

fn make_float_provider(c: mut Codecs) -> Codec {
    let f = f32_codec(mut c)
    let constant_fields: List<Field> = [req("value", f)]
    let constant = c.add(Codec.Record(constant_fields))
    let uniform_fields: List<Field> = [req("min_inclusive", f), req("max_exclusive", f)]
    let normal_fields: List<Field> = [req("mean", f), req("deviation", f), req("min", f), req("max", f)]
    let trapezoid_fields: List<Field> = [req("min", f), req("max", f), req("plateau", f)]
    let kinds: List<(String, usize)> = [
        ("minecraft:constant", constant),
        ("minecraft:uniform", checked(mut c, uniform_fields, check_uniform_float)),
        ("minecraft:clamped_normal", checked(mut c, normal_fields, check_normal_float)),
        ("minecraft:trapezoid", checked(mut c, trapezoid_fields, check_trapezoid_float)),
    ]
    return constant_or(mut c, f, kinds, "minecraft:float_provider_type")
}

// `FloatProviders.codec(least)`: a float provider that gives no less than `least`.
fn float_provider_at_least(c: mut Codecs, least: f32) -> usize {
    let p = float_provider(mut c)
    return c.add(Codec.Then(Then { of: p, then: float_at_least, with: Tag.Float(least) }))
}

fn float_at_least(_c: Codecs, value: Tag, with: Tag) -> Read {
    let least = match with {
        Tag.Float(v) => v,
        _ => f32.NEG_INFINITY,
    }
    let (min, max) = float_bounds(value)
    if min < least {
        return Read.bad("Value provider too low: {least} [{min}-{max}]")
    }
    return Read.ok(value.copy())
}

// The least and most a float provider gives, as `FloatProvider.min` and `max` give them.
fn float_bounds(value: Tag) -> (f32, f32) {
    return match value {
        Tag.Float(v) => (v, v),
        _ => {
            if kind_of(value) == "minecraft:uniform" {
                (float_tag(field(value, "min_inclusive")), float_tag(field(value, "max_exclusive")))
            } else {
                (float_tag(field(value, "min")), float_tag(field(value, "max")))
            }
        },
    }
}

fn check_uniform_float(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = float_tag(field(value, "min_inclusive"))
    let max = float_tag(field(value, "max_exclusive"))
    if max <= min {
        return Read.bad("Max must be larger than min, min: {min}, max: {max}")
    }
    return Read.ok(value.copy())
}

fn check_normal_float(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = float_tag(field(value, "min"))
    let max = float_tag(field(value, "max"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

fn check_trapezoid_float(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = float_tag(field(value, "min"))
    let max = float_tag(field(value, "max"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    if float_tag(field(value, "plateau")) > max - min {
        return Read.bad("Plateau can at most be the full span: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

// `IntProviders.CODEC`: an int, or a provider of one by its kind, where a constant one is written
// as its value alone.
fn int_provider(c: mut Codecs) -> usize {
    return c.named(String("int_provider"), make_int_provider)
}

fn make_int_provider(c: mut Codecs) -> Codec {
    let me = int_provider(mut c)
    let i = i32_codec(mut c)
    let f = f32_codec(mut c)
    let constant_fields: List<Field> = [req("value", i)]
    let constant = c.add(Codec.Record(constant_fields))
    let uniform_fields: List<Field> = [req("min_inclusive", i), req("max_inclusive", i)]
    let uniform = checked(mut c, uniform_fields, check_int_order)
    let clamped_fields: List<Field> = [req("source", me), req("min_inclusive", i), req("max_inclusive", i)]
    let weighted_fields: List<Field> = [req("distribution", weighted(mut c, me))]
    let normal_fields: List<Field> = [req("mean", f), req("deviation", f), req("min_inclusive", i), req("max_inclusive", i)]
    let trapezoid_fields: List<Field> = [req("min", i), req("max", i), req("plateau", i)]
    let kinds: List<(String, usize)> = [
        ("minecraft:constant", constant),
        ("minecraft:uniform", uniform),
        ("minecraft:biased_to_bottom", uniform),
        ("minecraft:very_biased_to_bottom", uniform),
        ("minecraft:clamped", checked(mut c, clamped_fields, check_int_order)),
        ("minecraft:weighted_list", c.add(Codec.Record(weighted_fields))),
        ("minecraft:clamped_normal", checked(mut c, normal_fields, check_normal_int)),
        ("minecraft:trapezoid", checked(mut c, trapezoid_fields, check_trapezoid_int)),
    ]
    return constant_or(mut c, i, kinds, "minecraft:int_provider_type")
}

fn check_int_order(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = int_tag(field(value, "min_inclusive"))
    let max = int_tag(field(value, "max_inclusive"))
    if max < min {
        return Read.bad("Max must be at least min, min_inclusive: {min}, max_inclusive: {max}")
    }
    return Read.ok(value.copy())
}

fn check_normal_int(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = int_tag(field(value, "min_inclusive"))
    let max = int_tag(field(value, "max_inclusive"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

fn check_trapezoid_int(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = int_tag(field(value, "min"))
    let max = int_tag(field(value, "max"))
    if max < min {
        return Read.bad("Max must be larger than min: [{min}, {max}]")
    }
    // As Java's `int` subtracts, wrapping.
    if int_tag(field(value, "plateau")) > i32.wrap(i64(max) - i64(min)) {
        return Read.bad("Plateau can at most be the full span: [{min}, {max}]")
    }
    return Read.ok(value.copy())
}

// A value, or a provider of one by its kind, as `FloatProviders` and `IntProviders` read them.
fn constant_or(c: mut Codecs, value: usize, kinds: own List<(String, usize)>, registry: String) -> Codec {
    let by = by_name(mut c, registry)
    let typed = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    let either = c.add(Codec.Either(value, typed))
    return Codec.Then(Then { of: either, then: unwrap_constant, with: Tag.End })
}

// A constant provider as `ConstantFloat` and `ConstantInt` are written: its value alone.
fn unwrap_constant(_c: Codecs, value: Tag, _with: Tag) -> Read {
    if kind_of(value) == "minecraft:constant" {
        return Read.ok(field(value, "value"))
    }
    return Read.ok(value.copy())
}

// `WeightedList.nonEmptyCodec` of `of`: entries `{data, weight}`, at least one with a weight.
fn weighted(c: mut Codecs, of: usize) -> usize {
    let fields: List<Field> = [req("data", of), req("weight", non_negative_int(mut c))]
    let entry = c.add(Codec.Record(fields))
    let list = c.add(Codec.ListOf(Many { of: entry }))
    return c.add(Codec.Then(Then { of: list, then: check_weighted, with: Tag.End }))
}

fn check_weighted(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var total: i64 = 0
    match value {
        Tag.List(entries) => {
            for e in entries {
                total += i64(int_tag(field(e, "weight")))
            }
        },
        _ => {},
    }
    if total == 0 {
        return Read.bad(String("Weighted list must contain at least one entry with non-zero weight"))
    }
    return Read.ok(value.copy())
}

// `ExtraCodecs.nonEmptyList` of the list codec `list`.
fn non_empty(c: mut Codecs, list: usize) -> usize {
    return c.add(Codec.Then(Then { of: list, then: check_non_empty, with: Tag.End }))
}

fn check_non_empty(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.List(items) => {
            if items.is_empty() {
                return Read.bad(String("List must have contents"))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// A record whose fields `check` checks once they've read, as `MapCodec.validate` does.
fn checked(c: mut Codecs, fields: own List<Field>, check: fn(Codecs, Tag, Tag) -> Read) -> usize {
    let at = c.add(Codec.Record(fields))
    return c.add(Codec.Then(Then { of: at, then: check, with: Tag.End }))
}

// The field `key` of a compound, or `Tag.End` where there's none.
fn field(value: Tag, key: String) -> Tag {
    match value {
        Tag.Compound(fields) => {
            if fields.contains(key) {
                return fields[key].copy()
            }
        },
        _ => {},
    }
    return Tag.End
}

// The kind a dispatched value names in its `type`, or nothing.
fn kind_of(value: Tag) -> String {
    return match field(value, "type") {
        Tag.Str(s) => s,
        _ => String(),
    }
}

fn float_tag(value: Tag) -> f32 {
    return match value {
        Tag.Float(v) => v,
        _ => 0.0f32,
    }
}

fn int_tag(value: Tag) -> i32 {
    return match value {
        Tag.Int(v) => v,
        _ => 0,
    }
}

fn bool_codec(c: mut Codecs) -> usize {
    return c.shared(String("bool"), Codec.Bool)
}

fn i32_codec(c: mut Codecs) -> usize {
    return c.shared(String("int"), Codec.Int(IntRange()))
}

fn i64_codec(c: mut Codecs) -> usize {
    return c.shared(String("long"), Codec.Long(LongRange()))
}

fn f32_codec(c: mut Codecs) -> usize {
    return c.shared(String("float"), Codec.Float(FloatRange()))
}

fn f64_codec(c: mut Codecs) -> usize {
    return c.shared(String("double"), Codec.Double(DoubleRange()))
}

// `ExtraCodecs.POSITIVE_INT`.
fn positive_int(c: mut Codecs) -> usize {
    return c.shared(String("positive_int"), Codec.Int(IntRange { min: 1, before: "Value must be positive: " }))
}

// A record of `fields`.
fn record(c: mut Codecs, fields: own List<Field>) -> usize? {
    return some(c.add(Codec.Record(fields)))
}

// A variant with a model and a texture, `ModelAndTexture.codec` with the first model as the
// default, and with a texture for its young if `baby`.
fn modelled(c: mut Codecs, models: own List<String>, baby: bool) -> usize {
    let model = c.add(Codec.Names(models.copy()))
    let asset = id(mut c)
    var fields: List<Field> = [def("model", model, Tag.Str(models[0].copy())), req("asset_id", asset)]
    if baby {
        fields.push(req("baby_asset_id", asset))
    }
    return c.add(Codec.Record(fields))
}

// A sound variant with a set of sounds for adults and one for the young.
fn sound_sets(c: mut Codecs, names: List<String>) -> usize {
    let set = sounds(mut c, names)
    return c.add(Codec.Record([req("adult_sounds", set), req("baby_sounds", set)]))
}

// A record of sounds, each a `SoundEvent.CODEC`.
fn sounds(c: mut Codecs, names: List<String>) -> usize {
    let s = sound(mut c)
    var fields = List<Field>()
    for n in names {
        fields.push(req(n, s))
    }
    return c.add(Codec.Record(fields))
}

// `TestEnvironmentDefinition.DIRECT_CODEC`.
fn test_environment(c: mut Codecs) -> usize {
    return c.named(String("test_environment"), make_test_environment)
}

fn make_test_environment(c: mut Codecs) -> Codec {
    let me = test_environment(mut c)
    let holder = c.add(Codec.Holder(HolderCodec { registry: "minecraft:test_environment", inline: some(me) }))
    let definitions = c.add(Codec.ListOf(Many { of: holder }))
    let all_of_fields: List<Field> = [req("definitions", definitions)]
    let all_of = c.add(Codec.Record(all_of_fields))
    let clock = c.add(Codec.Holder(HolderCodec { registry: "minecraft:world_clock", inline: none, kind: HolderKind.Fixed }))
    let clock_fields: List<Field> = [req("clock", clock), req("time", non_negative_int(mut c))]
    let clock_time = c.add(Codec.Record(clock_fields))
    let difficulties = c.add(Codec.Names(["peaceful", "easy", "normal", "hard"]))
    let difficulty_fields: List<Field> = [req("difficulty", difficulties)]
    let difficulty = c.add(Codec.Record(difficulty_fields))
    let function_fields: List<Field> = [opt("setup", id(mut c)), opt("teardown", id(mut c))]
    let function = c.add(Codec.Record(function_fields))
    let rules_fields: List<Field> = [req("rules", game_rules(mut c))]
    let rules = c.add(Codec.Record(rules_fields))
    let timeline = c.add(Codec.Holder(HolderCodec { registry: "minecraft:timeline", inline: none, kind: HolderKind.Fixed }))
    let timelines = c.add(Codec.ListOf(Many { of: timeline }))
    let timeline_fields: List<Field> = [req("timelines", timelines)]
    let timeline_attributes = c.add(Codec.Record(timeline_fields))
    let weathers = c.add(Codec.Names(["clear", "rain", "thunder"]))
    let weather_fields: List<Field> = [req("weather", weathers)]
    let weather = c.add(Codec.Record(weather_fields))
    let kinds: List<(String, usize)> = [
        ("minecraft:all_of", all_of),
        ("minecraft:clock_time", clock_time),
        ("minecraft:difficulty", difficulty),
        ("minecraft:function", function),
        ("minecraft:game_rules", rules),
        ("minecraft:timeline_attributes", timeline_attributes),
        ("minecraft:weather", weather),
    ]
    return Codec.Dispatch(Kinds { key: "type", by: by_name(mut c, "minecraft:test_environment_definition_type"), kinds: kinds })
}

// `TestData.CODEC`, a test's settings.
fn test_data(c: mut Codecs) -> usize {
    let direct = test_environment(mut c)
    let environment = c.add(Codec.Holder(HolderCodec { registry: "minecraft:test_environment", inline: some(direct) }))
    let positive = c.add(Codec.Int(IntRange { min: 1, before: "Value must be positive: " }))
    let flag = c.add(Codec.Bool)
    let rotations = c.add(Codec.Names(["none", "clockwise_90", "180", "counterclockwise_90"]))
    let padding = c.add(Codec.Int(IntRange { min: 0, max: 128, before: "Value must be within range [0;128]: " }))
    let fields: List<Field> = [
        req("environment", environment),
        def("dimension", id(mut c), Tag.Str(String("minecraft:overworld"))),
        req("structure", id(mut c)),
        req("max_ticks", positive),
        def("setup_ticks", non_negative_int(mut c), Tag.Int(0)),
        def("required", flag, Tag.Byte(1i8)),
        def("rotation", rotations, Tag.Str(String("none"))),
        def("manual_only", flag, Tag.Byte(0i8)),
        def("max_attempts", positive, Tag.Int(1)),
        def("required_successes", positive, Tag.Int(1)),
        def("sky_access", flag, Tag.Byte(0i8)),
        def("padding", padding, Tag.Int(0)),
    ]
    return c.add(Codec.Record(fields))
}

// `GameRuleMap.CODEC`: game rules by name, each with its value's codec, `Codec.BOOL` or
// `Codec.intRange`.
fn game_rules(c: mut Codecs) -> usize {
    let flag = c.add(Codec.Bool)
    let ints: List<(String, i32, i32)> = [
        ("fire_spread_radius_around_player", -1, i32.MAX),
        ("max_block_modifications", 1, i32.MAX),
        ("max_command_forks", 0, i32.MAX),
        ("max_command_sequence_length", 0, i32.MAX),
        ("max_entity_cramming", 0, i32.MAX),
        ("max_minecart_speed", 1, 1000),
        ("max_snow_accumulation_height", 0, 8),
        ("players_nether_portal_creative_delay", 0, i32.MAX),
        ("players_nether_portal_default_delay", 0, i32.MAX),
        ("players_sleeping_percentage", 0, i32.MAX),
        ("random_tick_speed", 0, i32.MAX),
        ("respawn_radius", 0, i32.MAX),
    ]
    let names = builtin_names()
    var values = List<(String, usize)>()
    for i in 0..names.len() {
        if names[i] != "game_rule" {
            continue
        }
        for rule in builtin_entries(i) {
            var of = flag
            for (n, min, max) in ints {
                if n == rule {
                    of = c.add(Codec.Int(IntRange { min: min, max: max, before: "Value ", after: " outside of range [{min}:{max}]" }))
                }
            }
            values.push(("minecraft:{rule}", of))
        }
    }
    let key = by_name(mut c, "minecraft:game_rule")
    return c.add(Codec.Dispatched(Dispatched { key: key, values: values }))
}

// `ExtraCodecs.NON_NEGATIVE_INT`.
fn non_negative_int(c: mut Codecs) -> usize {
    return c.shared(String("non_negative_int"), Codec.Int(IntRange { min: 0, before: "Value must be non-negative: " }))
}

// `Registry.byNameCodec` of the built-in registry `registry`.
fn by_name(c: mut Codecs, registry: String) -> usize {
    return c.shared("by_name {registry}", Codec.Holder(HolderCodec { registry: registry.copy(), inline: none, kind: HolderKind.ByName }))
}

// A record whose fields go in this one's.
fn inline(of: usize) -> Field {
    return Field { name: String(), of: of, need: Need.Inline }
}

// A field that must be there.
fn req(name: String, of: usize) -> Field {
    return Field { name: name.copy(), of: of, need: Need.Required }
}

// A field that may be left out.
fn opt(name: String, of: usize) -> Field {
    return Field { name: name.copy(), of: of, need: Need.Optional }
}

// A field with a default, not written when it has it.
fn def(name: String, of: usize, default: own Tag) -> Field {
    return Field { name: name.copy(), of: of, need: Need.Default(default) }
}

fn string(c: mut Codecs) -> usize {
    return c.shared(String("string"), Codec.Str)
}

fn id(c: mut Codecs) -> usize {
    return c.shared(String("identifier"), Codec.Id)
}

// `ExtraCodecs.POSITIVE_FLOAT`.
fn positive_float(c: mut Codecs) -> usize {
    let range = FloatRange { min: 0.0f32, max: f32.MAX, above: true, checked: true, before: "Value must be positive: " }
    return c.shared(String("positive_float"), Codec.Float(range))
}

// `ComponentSerialization.CODEC`.
fn text(c: mut Codecs) -> usize {
    return c.shared(String("text"), Codec.Custom(read_text))
}

fn read_text(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match Component.from_json(value) {
        ok(t) => Read.ok(t.to_nbt()),
        err(e) => Read.bad(e),
    }
}

// `Style.Serializer.CODEC`.
fn read_style(_c: Codecs, value: Json, _r: Registries) -> Read {
    match value {
        Json.Object(members) => {
            match Style.from_json(members) {
                ok(s) => {
                    var m = JavaHashMap<String, Tag>()
                    s.write_nbt(mut m)
                    return Read.ok(Tag.Compound(m))
                },
                err(e) => return Read.bad(e),
            }
        },
        _ => return Read.bad("Not a JSON object: {json_text(value)}"),
    }
}

// `SoundEvent.CODEC`: a sound event by its ID, or given in full.
fn sound(c: mut Codecs) -> usize {
    return c.named(String("sound_event"), make_sound)
}

fn make_sound(c: mut Codecs) -> Codec {
    let range = c.add(Codec.Float(FloatRange()))
    let fields: List<Field> = [req("sound_id", id(mut c)), Field { name: "range", of: range, need: Need.Loose }]
    let direct = c.add(Codec.Record(fields))
    return Codec.Holder(HolderCodec { registry: "minecraft:sound_event", inline: some(direct) })
}

// `Timeline.NETWORK_CODEC`: `DIRECT_CODEC`, then only the tracks of attributes clients are sent.
// The checks of its markers and tracks go in the order they're given, so it reads its record
// itself.
fn timeline_codec(c: mut Codecs) -> usize {
    let clock = c.add(Codec.Holder(HolderCodec { registry: "minecraft:world_clock", inline: none, kind: HolderKind.Fixed }))
    let key = by_name(mut c, "minecraft:environment_attribute")
    var tracks = List<(String, usize)>()
    for (name, kind, _flags) in environment_attributes() {
        let track = attribute_track(mut c, name, kind)
        tracks.push(("minecraft:{name}", track))
    }
    let track_map = c.add(Codec.Dispatched(Dispatched { key: key, values: tracks }))
    let marker = time_marker(mut c)
    let marker_key = id(mut c)
    let markers = c.add(Codec.MapOf(MapOf { key: marker_key, value: marker, before: "ResourceKey[minecraft:clock_time_marker / ", after: "]" }))
    let fields: List<Field> = [
        req("clock", clock),
        opt("period_ticks", positive_int(mut c)),
        def("tracks", track_map, Tag.Compound(JavaHashMap<String, Tag>())),
        def("time_markers", markers, Tag.Compound(JavaHashMap<String, Tag>())),
    ]
    let _direct = c.shared(String("timeline_direct"), Codec.Record(fields))
    return c.add(Codec.Custom(read_timeline))
}

fn read_timeline(c: Codecs, value: Json, r: Registries) -> Read {
    let at = c.find(String("timeline_direct")) else return Read.bad(String("no codec for timelines"))
    var got = c.read(at, value, r)
    let v = got.value.take() else return got
    var done = after(got.error.take(), check_timeline(v, value))
    let w = done.value.take() else return done
    return Read { value: some(synced_tracks(w)), error: done.error.take() }
}

// `Timeline.validateInternal`: with a period, each marker within it, and then each track's
// keyframes, the errors newest first, as `apply2stable` puts them.
fn check_timeline(value: Tag, json: Json) -> Read {
    let period = match field(value, "period_ticks") {
        Tag.Int(p) => p,
        _ => return Read.ok(value.copy()),
    }
    let markers = field(value, "time_markers")
    for name in ids_in_order(json, "time_markers") {
        let marker = field(markers, name)
        // A marker is written as its tick unless it's shown in commands.
        let ticks = match marker {
            Tag.Int(t) => t,
            _ => int_tag(field(marker, "ticks")),
        }
        if ticks >= period {
            return Read.bad("Time Marker ResourceKey[minecraft:clock_time_marker / {name}] must be in range [0; {period})")
        }
    }
    var message: String? = none
    let tracks = field(value, "tracks")
    for name in ids_in_order(json, "tracks") {
        match field(field(tracks, name), "keyframes") {
            Tag.List(frames) => {
                for f in frames {
                    let t = int_tag(field(f, "ticks"))
                    if t < 0 or t > period {
                        let e = "Keyframe at tick {t} must be in range [0; {period}]"
                        message = some(match message.take() {
                            some(old) => "{e}; {old}",
                            none => e,
                        })
                        break
                    }
                }
            },
            _ => {},
        }
    }
    let e = message else return Read.ok(value.copy())
    return Read.bad(e)
}

// The keys of the object under `key` in `json`, as the identifiers they name, each once, in the
// order they're first given, as an `ImmutableMap` read from them keeps them.
fn ids_in_order(json: Json, key: String) -> List<String> {
    match json {
        Json.Object(members) => {
            if let at = given(members, key) {
                return object_ids(members[at].value)
            }
        },
        _ => {},
    }
    return List<String>()
}

// The keys of the object `json`, as the identifiers they name, each once, in the order they're
// first given.
fn object_ids(json: Json) -> List<String> {
    var out = List<String>()
    match json {
        Json.Object(members) => {
            for m in members {
                match Identifier.parse(m.key) {
                    ok(i) => {
                        let s = i.to_string()
                        if not listed(out, s) {
                            out.push(s)
                        }
                    },
                    err(_) => {},
                }
            }
        },
        _ => {},
    }
    return out
}

fn has_field(value: Tag, key: String) -> bool {
    return match value {
        Tag.Compound(fields) => fields.contains(key),
        _ => false,
    }
}

fn listed(names: List<String>, name: String) -> bool {
    for n in names {
        if n == name {
            return true
        }
    }
    return false
}

// A timeline as `NETWORK_CODEC` writes it: only the tracks clients are sent, and none at all if
// that's none.
fn synced_tracks(value: Tag) -> Tag {
    match value {
        Tag.Compound(fields) => {
            var out = JavaHashMap<String, Tag>()
            for (k, v) in fields {
                if k == "tracks" {
                    let kept = synced_only(v)
                    if not is_empty_compound(kept) {
                        out.insert(k.copy(), kept)
                    }
                } else {
                    out.insert(k.copy(), v.copy())
                }
            }
            return Tag.Compound(out)
        },
        _ => return value.copy(),
    }
}

// The entries of a map of attributes whose attribute clients are sent, as
// `EnvironmentAttribute.isSyncable` picks them.
fn synced_only(value: Tag) -> Tag {
    var out = JavaHashMap<String, Tag>()
    match value {
        Tag.Compound(fields) => {
            for (k, v) in fields {
                if attribute_flag(k, "s") {
                    out.insert(k.copy(), v.copy())
                }
            }
        },
        _ => {},
    }
    return Tag.Compound(out)
}

fn is_empty_compound(value: Tag) -> bool {
    return match value {
        Tag.Compound(fields) => fields.is_empty(),
        _ => false,
    }
}

// Whether the attribute `key` has the flag `flag` in `environment_attributes`.
fn attribute_flag(key: String, flag: String) -> bool {
    for (name, _kind, flags) in environment_attributes() {
        if key == "minecraft:{name}" {
            return flags.contains(flag)
        }
    }
    return false
}

// `Timeline.TimeMarkerInfo.CODEC`: its tick, or `{ticks, show_in_commands}`, written as its tick
// unless it's shown in commands.
fn time_marker(c: mut Codecs) -> usize {
    let ticks = non_negative_int(mut c)
    let fields: List<Field> = [req("ticks", ticks), def("show_in_commands", bool_codec(mut c), Tag.Byte(0i8))]
    let full = c.add(Codec.Record(fields))
    let either = c.add(Codec.Either(ticks, full))
    return c.add(Codec.Then(Then { of: either, then: marker_of, with: Tag.End }))
}

fn marker_of(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.Compound(fields) => {
            if not fields.contains("show_in_commands") {
                return Read.ok(field(value, "ticks"))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `EnvironmentAttributes`: each attribute's name and type, with `s` where clients are sent it,
// `isSyncable`, and `n` where it can't be set for a place, only for a dimension, as
// `isPositional` says.
fn environment_attributes() -> List<(String, String, String)> {
    return [
        ("visual/fog_color", "rgb_color", "s"),
        ("visual/fog_start_distance", "float", "s"),
        ("visual/fog_end_distance", "float", "s"),
        ("visual/sky_fog_end_distance", "float", "s"),
        ("visual/cloud_fog_end_distance", "float", "s"),
        ("visual/water_fog_color", "rgb_color", "s"),
        ("visual/water_fog_start_distance", "float", "s"),
        ("visual/water_fog_end_distance", "float", "s"),
        ("visual/sky_color", "rgb_color", "s"),
        ("visual/sunrise_sunset_color", "argb_color", "s"),
        ("visual/cloud_color", "argb_color", "s"),
        ("visual/cloud_height", "float", "s"),
        ("visual/sun_angle", "angle_degrees", "s"),
        ("visual/moon_angle", "angle_degrees", "s"),
        ("visual/star_angle", "angle_degrees", "s"),
        ("visual/moon_phase", "moon_phase", "s"),
        ("visual/star_brightness", "float", "s"),
        ("visual/block_light_tint", "rgb_color", "s"),
        ("visual/sky_light_color", "rgb_color", "s"),
        ("visual/sky_light_factor", "float", "s"),
        ("visual/night_vision_color", "rgb_color", "s"),
        ("visual/ambient_light_color", "rgb_color", "s"),
        ("visual/default_dripstone_particle", "particle", "s"),
        ("visual/ambient_particles", "ambient_particles", "s"),
        ("audio/background_music", "background_music", "s"),
        ("audio/music_volume", "float", "s"),
        ("audio/ambient_sounds", "ambient_sounds", "s"),
        ("audio/firefly_bush_sounds", "boolean", "s"),
        ("gameplay/sky_light_level", "float", "sn"),
        ("gameplay/can_start_raid", "boolean", ""),
        ("gameplay/water_evaporates", "boolean", "s"),
        ("gameplay/bed_rule", "bed_rule", ""),
        ("gameplay/straw_bed_rule", "bed_rule", ""),
        ("gameplay/respawn_anchor_works", "boolean", ""),
        ("gameplay/nether_portal_spawns_piglin", "boolean", ""),
        ("gameplay/fast_lava", "boolean", "sn"),
        ("gameplay/increased_fire_burnout", "boolean", ""),
        ("gameplay/eyeblossom_open", "tri_state", ""),
        ("gameplay/turtle_egg_hatch_chance", "float", ""),
        ("gameplay/piglins_zombify", "boolean", "s"),
        ("gameplay/snow_golem_melts", "boolean", ""),
        ("gameplay/creaking_active", "boolean", "s"),
        ("gameplay/surface_slime_spawn_chance", "float", ""),
        ("gameplay/cat_waking_up_gift_chance", "float", ""),
        ("gameplay/bees_stay_in_hive", "boolean", ""),
        ("gameplay/monsters_burn", "boolean", ""),
        ("gameplay/can_pillager_patrol_spawn", "boolean", ""),
        ("gameplay/natural_mob_spawns", "mob_spawn_settings", ""),
        ("gameplay/creature_world_gen_spawn_probability", "float", ""),
        ("gameplay/villager_activity", "activity", ""),
        ("gameplay/baby_villager_activity", "activity", ""),
    ]
}

// The least and most the float attribute `name` may be, its `AttributeRange`, or nothing where
// it may be anything.
fn attribute_range(name: String) -> List<f32> {
    if name == "visual/fog_end_distance" or name == "visual/sky_fog_end_distance" or name == "visual/cloud_fog_end_distance" or name == "visual/water_fog_end_distance" {
        return [0.0f32, f32.INFINITY]
    }
    if name == "visual/star_brightness" or name == "visual/sky_light_factor" or name == "audio/music_volume" or name == "gameplay/turtle_egg_hatch_chance" or name == "gameplay/surface_slime_spawn_chance" or name == "gameplay/cat_waking_up_gift_chance" {
        return [0.0f32, 1.0f32]
    }
    if name == "gameplay/sky_light_level" {
        return [0.0f32, 15.0f32]
    }
    if name == "gameplay/creature_world_gen_spawn_probability" {
        return [0.0f32, 0.9999999f32]
    }
    return List<f32>()
}

// `EnvironmentAttribute.valueCodec`: its type's codec, then its range.
fn attribute_value(c: mut Codecs, name: String, kind: String) -> usize {
    let of = attribute_type(mut c, kind)
    let range = attribute_range(name)
    if range.is_empty() {
        return of
    }
    let bounds: List<Tag> = [Tag.Float(range[0]), Tag.Float(range[1])]
    return c.shared("attribute value {name}", Codec.Then(Then { of: of, then: check_attribute_range, with: Tag.List(bounds) }))
}

// `AttributeRange.ofFloat`'s check, which compares as `float`s do, so `-0.0` is in a range from
// `0.0`.
fn check_attribute_range(_c: Codecs, value: Tag, with: Tag) -> Read {
    let v = float_tag(value)
    let (min, max) = match with {
        Tag.List(b) => (float_tag(b[0]), float_tag(b[1])),
        _ => (f32.NEG_INFINITY, f32.INFINITY),
    }
    if v >= min and v <= max {
        return Read.ok(value.copy())
    }
    return Read.bad("{v} is not in range [{min}; {max}]")
}

// `AttributeTypes`: the codec of each type of attribute's values.
fn attribute_type(c: mut Codecs, kind: String) -> usize {
    if kind == "boolean" {
        return bool_codec(mut c)
    }
    if kind == "tri_state" {
        return tri_state(mut c)
    }
    if kind == "float" or kind == "angle_degrees" {
        return f32_codec(mut c)
    }
    if kind == "rgb_color" {
        return rgb_color(mut c)
    }
    if kind == "argb_color" {
        return argb_color(mut c)
    }
    if kind == "integer" {
        return i32_codec(mut c)
    }
    if kind == "moon_phase" {
        return c.shared(String("moon_phase"), Codec.Names([
            "full_moon", "waning_gibbous", "third_quarter", "waning_crescent", "new_moon", "waxing_crescent",
            "first_quarter", "waxing_gibbous",
        ]))
    }
    if kind == "activity" {
        return by_name(mut c, "minecraft:activity")
    }
    if kind == "bed_rule" {
        return c.named(String("bed_rule"), make_bed_rule)
    }
    if kind == "particle" {
        return particle(mut c)
    }
    if kind == "ambient_particles" {
        return c.named(String("ambient_particles"), make_ambient_particles)
    }
    if kind == "background_music" {
        return c.named(String("background_music"), make_background_music)
    }
    if kind == "ambient_sounds" {
        return c.named(String("ambient_sounds"), make_ambient_sounds)
    }
    return c.named(String("mob_spawn_settings"), make_mob_spawn_settings)
}

// `AttributeModifier.OperationId.CODEC`, every operation by name.
fn operation_names(c: mut Codecs) -> usize {
    return c.shared(String("attribute operations"), Codec.Names([
        "override", "alpha_blend", "add", "subtract", "multiply", "blend_to_gray", "minimum", "maximum",
        "and", "nand", "or", "nor", "xor", "xnor", "append", "overlay",
    ]))
}

// The operations an attribute of the type `kind` can have besides `override`, its
// `modifierLibrary`.
fn modifier_names(kind: String) -> List<String> {
    if kind == "boolean" {
        return ["and", "nand", "or", "nor", "xor", "xnor"]
    }
    if kind == "float" or kind == "angle_degrees" {
        return ["alpha_blend", "add", "subtract", "multiply", "minimum", "maximum"]
    }
    if kind == "rgb_color" or kind == "argb_color" {
        return ["alpha_blend", "add", "subtract", "multiply", "blend_to_gray"]
    }
    if kind == "integer" {
        return ["add", "subtract", "multiply", "minimum", "maximum"]
    }
    if kind == "ambient_particles" {
        return ["append"]
    }
    if kind == "mob_spawn_settings" {
        return ["overlay"]
    }
    return []
}

// `AttributeType.modifierCodec`: an operation by name, if attributes of the type `kind` can have
// it, as `ExtraCodecs.idResolverCodec` reads it.
fn modifier_codec(c: mut Codecs, kind: String) -> usize {
    let names = operation_names(mut c)
    var allowed = List<Tag>()
    for n in modifier_names(kind) {
        allowed.push(Tag.Str(n.copy()))
    }
    return c.shared("modifier {kind}", Codec.Then(Then { of: names, then: check_modifier, with: Tag.List(allowed) }))
}

fn check_modifier(_c: Codecs, value: Tag, with: Tag) -> Read {
    let name = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    if name == "override" {
        return Read.ok(value.copy())
    }
    match with {
        Tag.List(allowed) => {
            for a in allowed {
                if same(a, value) {
                    return Read.ok(value.copy())
                }
            }
        },
        _ => {},
    }
    // The operation as its enum constant's `toString` gives it.
    var upper = String()
    for i in 0..name.len() {
        let b = name.byte_at(i)
        upper.push(rune(if b >= 97 and b <= 122 { b - 32 } else { b }))
    }
    return Read.bad("Unknown element id: {upper}")
}

// `modifier.argumentCodec(attribute)`: what the operation `op` takes for the attribute `name` of
// the type `kind`.
fn argument_codec(c: mut Codecs, name: String, kind: String, op: String) -> usize {
    if op == "override" or op == "append" or op == "overlay" {
        return attribute_value(mut c, name, kind)
    }
    if kind == "boolean" {
        return bool_codec(mut c)
    }
    if kind == "integer" {
        return i32_codec(mut c)
    }
    if kind == "float" or kind == "angle_degrees" {
        if op == "alpha_blend" {
            return c.named(String("float_with_alpha"), make_float_with_alpha)
        }
        return f32_codec(mut c)
    }
    if op == "blend_to_gray" {
        return c.named(String("blend_to_gray"), make_blend_to_gray)
    }
    // A color: `ArgbModifier`s take an ARGB color, `RgbModifier`s an RGB one.
    if op == "alpha_blend" or (op == "multiply" and kind == "argb_color") {
        return argb_color(mut c)
    }
    return rgb_color(mut c)
}

// `AttributeTrack.createCodec`: its modifier, `override` if it isn't given, and keyframes of
// what the modifier takes.
fn attribute_track(c: mut Codecs, name: String, kind: String) -> usize {
    let by = modifier_codec(mut c, kind)
    var kinds = List<(String, usize)>()
    var ops: List<String> = ["override"]
    for n in modifier_names(kind) {
        ops.push(n.copy())
    }
    for op in ops {
        let argument = argument_codec(mut c, name, kind, op)
        let track = keyframe_track(mut c, argument)
        kinds.push((op.copy(), track))
    }
    return c.add(Codec.Dispatch(Kinds { key: "modifier", by: by, kinds: kinds, default: "override" }))
}

// `EnvironmentAttributeMap.Entry.createCodec`: a value, or `{modifier, argument}`, written as the
// value alone where it overrides.
fn attribute_entry(c: mut Codecs, name: String, kind: String) -> usize {
    let value = attribute_value(mut c, name, kind)
    let by = modifier_codec(mut c, kind)
    var kinds = List<(String, usize)>()
    var ops: List<String> = ["override"]
    for n in modifier_names(kind) {
        ops.push(n.copy())
    }
    for op in ops {
        let argument = argument_codec(mut c, name, kind, op)
        let fields: List<Field> = [req("argument", argument)]
        let full = c.add(Codec.Record(fields))
        kinds.push((op.copy(), full))
    }
    let full = c.add(Codec.Dispatch(Kinds { key: "modifier", by: by, kinds: kinds }))
    let either = c.add(Codec.Either(value, full))
    return c.add(Codec.Then(Then { of: either, then: unwrap_override, with: Tag.End }))
}

fn unwrap_override(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match field(value, "modifier") {
        Tag.Str(s) => {
            if s == "override" {
                return Read.ok(field(value, "argument"))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `EnvironmentAttributeMap.CODEC`: attributes by name, each with its value or a modifier.
fn attribute_map(c: mut Codecs) -> usize {
    return c.named(String("attribute_map"), make_attribute_map)
}

fn make_attribute_map(c: mut Codecs) -> Codec {
    let key = by_name(mut c, "minecraft:environment_attribute")
    var values = List<(String, usize)>()
    for (name, kind, _flags) in environment_attributes() {
        let entry = attribute_entry(mut c, name, kind)
        values.push(("minecraft:{name}", entry))
    }
    return Codec.Dispatched(Dispatched { key: key, values: values })
}

// `KeyframeTrack.mapCodec(value)`: keyframes of the value, in order, and how to ease between
// them.
fn keyframe_track(c: mut Codecs, value: usize) -> usize {
    if let at = c.find("keyframe track {value}") {
        return at
    }
    let ticks = non_negative_int(mut c)
    let keyframe_fields: List<Field> = [req("ticks", ticks), req("value", value)]
    let keyframe = c.add(Codec.Record(keyframe_fields))
    let list = c.add(Codec.ListOf(Many { of: keyframe }))
    let keyframes = c.add(Codec.Then(Then { of: list, then: check_keyframes, with: Tag.End }))
    let ease = c.named(String("easing"), make_easing)
    let fields: List<Field> = [req("keyframes", keyframes), def("ease", ease, Tag.Str(String("linear")))]
    return c.shared("keyframe track {value}", Codec.Record(fields))
}

// `KeyframeTrack.validateKeyframes`.
fn check_keyframes(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.List(frames) => {
            if frames.is_empty() {
                return Read.bad(String("Keyframes must not be empty"))
            }
            for i in 1..frames.len() {
                if int_tag(field(frames[i - 1], "ticks")) > int_tag(field(frames[i], "ticks")) {
                    return Read.bad(String("Keyframes must be ordered by ticks field"))
                }
            }
            if frames.len() > 1 {
                // As vanilla counts them: from the last keyframe's tick, and from 0 again after
                // a new tick.
                var repeats = 0
                var last = int_tag(field(frames[frames.len() - 1], "ticks"))
                for f in frames {
                    let t = int_tag(field(f, "ticks"))
                    if t == last {
                        repeats += 1
                        if repeats > 2 {
                            return Read.bad("More than 2 keyframes on same tick: {t}")
                        }
                    } else {
                        repeats = 0
                    }
                    last = t
                }
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `EasingType.CODEC`: an easing by name, or `{cubic_bezier: [x1, y1, x2, y2]}`.
fn make_easing(c: mut Codecs) -> Codec {
    let s = string(mut c)
    let simple = c.add(Codec.Then(Then { of: s, then: check_easing, with: Tag.End }))
    let f = f32_codec(mut c)
    let floats = c.add(Codec.ListOf(Many { of: f, min: 4, max: 4 }))
    let controls = c.add(Codec.Then(Then { of: floats, then: check_bezier, with: Tag.End }))
    let fields: List<Field> = [req("cubic_bezier", controls)]
    let bezier = c.add(Codec.Record(fields))
    return Codec.Either(simple, bezier)
}

fn check_easing(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let name = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    let names: List<String> = [
        "constant", "linear", "in_back", "in_bounce", "in_circ", "in_cubic", "in_elastic", "in_expo", "in_quad",
        "in_quart", "in_quint", "in_sine", "in_out_back", "in_out_bounce", "in_out_circ", "in_out_cubic",
        "in_out_elastic", "in_out_expo", "in_out_quad", "in_out_quart", "in_out_quint", "in_out_sine", "out_back",
        "out_bounce", "out_circ", "out_cubic", "out_elastic", "out_expo", "out_quad", "out_quart", "out_quint",
        "out_sine",
    ]
    if listed(names, name) {
        return Read.ok(value.copy())
    }
    return Read.bad("Unknown element id: {name}")
}

// `EasingType.CubicBezierControls.validate`.
fn check_bezier(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.List(items) => {
            if items.len() >= 4 {
                let x1 = float_tag(items[0])
                let x2 = float_tag(items[2])
                if x1 < 0.0f32 or x1 > 1.0f32 {
                    return Read.bad(String("x1 must be in range [0; 1]"))
                }
                if x2 < 0.0f32 or x2 > 1.0f32 {
                    return Read.bad(String("x2 must be in range [0; 1]"))
                }
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `FloatWithAlpha.CODEC`: a float, or `{value, alpha}`, written as the float where the alpha is 1.
fn make_float_with_alpha(c: mut Codecs) -> Codec {
    let f = f32_codec(mut c)
    let fields: List<Field> = [req("value", f), def("alpha", unit_float(mut c), Tag.Float(1.0f32))]
    let full = c.add(Codec.Record(fields))
    let either = c.add(Codec.Either(f, full))
    return Codec.Then(Then { of: either, then: unwrap_alpha, with: Tag.End })
}

fn unwrap_alpha(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.Compound(fields) => {
            if not fields.contains("alpha") {
                return Read.ok(field(value, "value"))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `ColorModifier.BlendToGray.CODEC`.
fn make_blend_to_gray(c: mut Codecs) -> Codec {
    let unit = unit_float(mut c)
    let fields: List<Field> = [req("brightness", unit), req("factor", unit)]
    return Codec.Record(fields)
}

// `Codec.floatRange(0.0F, 1.0F)`.
fn unit_float(c: mut Codecs) -> usize {
    return c.shared(String("unit_float"), Codec.Float(FloatRange { min: 0.0f32, max: 1.0f32, checked: true, before: "Value ", after: " outside of range [0.0:1.0]" }))
}

// `TriState.CODEC`: a boolean, or `true`, `false` or `default`, written as a boolean unless it's
// `default`.
fn tri_state(c: mut Codecs) -> usize {
    let b = bool_codec(mut c)
    let names = c.add(Codec.Names(["true", "false", "default"]))
    let either = c.add(Codec.Either(b, names))
    return c.shared(String("tri_state"), Codec.Then(Then { of: either, then: tri_state_of, with: Tag.End }))
}

fn tri_state_of(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.Str(s) => {
            if s == "true" {
                return Read.ok(Tag.Byte(1i8))
            }
            if s == "false" {
                return Read.ok(Tag.Byte(0i8))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `ExtraCodecs.STRING_RGB_VEC3_COLOR`: `#rrggbb`, three floats or an int, each made the floats
// `ARGB.vector3fFromRGB24` gives, and written as `#rrggbb` again.
fn rgb_color(c: mut Codecs) -> usize {
    return c.named(String("rgb_color"), make_rgb_color)
}

fn make_rgb_color(c: mut Codecs) -> Codec {
    let hex = hex_color(mut c, 6, rgb_of_int)
    let floats = vector_of(mut c, 3, rgb_of_floats)
    let i = i32_codec(mut c)
    let int = c.add(Codec.Then(Then { of: i, then: rgb_of_int, with: Tag.End }))
    let rest = c.add(Codec.Either(floats, int))
    return Codec.Either(hex, rest)
}

// `ExtraCodecs.STRING_ARGB_VEC4_COLOR`: `#aarrggbb`, four floats, red first, or an int.
fn argb_color(c: mut Codecs) -> usize {
    return c.named(String("argb_color"), make_argb_color)
}

fn make_argb_color(c: mut Codecs) -> Codec {
    let hex = hex_color(mut c, 8, argb_of_int)
    let floats = vector_of(mut c, 4, argb_of_floats)
    let i = i32_codec(mut c)
    let int = c.add(Codec.Then(Then { of: i, then: argb_of_int, with: Tag.End }))
    let rest = c.add(Codec.Either(floats, int))
    return Codec.Either(hex, rest)
}

// `ExtraCodecs.RGB_COLOR_CODEC`: an int, or three floats made one opaque, written as the int.
fn rgb_int(c: mut Codecs) -> usize {
    return c.named(String("rgb_int"), make_rgb_int)
}

fn make_rgb_int(c: mut Codecs) -> Codec {
    let i = i32_codec(mut c)
    let floats = vector_of(mut c, 3, rgb_int_of_floats)
    return Codec.Either(i, floats)
}

// `ExtraCodecs.ARGB_COLOR_CODEC`: an int, or four floats, alpha last.
fn argb_int(c: mut Codecs) -> usize {
    return c.named(String("argb_int"), make_argb_int)
}

fn make_argb_int(c: mut Codecs) -> Codec {
    let i = i32_codec(mut c)
    let floats = vector_of(mut c, 4, argb_int_of_floats)
    return Codec.Either(i, floats)
}

// `ExtraCodecs.hexColor(digits)`, then what `next` makes of the color.
fn hex_color(c: mut Codecs, digits: i32, next: fn(Codecs, Tag, Tag) -> Read) -> usize {
    let s = string(mut c)
    let hex = c.add(Codec.Then(Then { of: s, then: read_hex, with: Tag.Int(digits) }))
    return c.add(Codec.Then(Then { of: hex, then: next, with: Tag.End }))
}

fn read_hex(_c: Codecs, value: Tag, with: Tag) -> Read {
    let digits = int_tag(with)
    let s = match value {
        Tag.Str(t) => t.copy(),
        _ => String(),
    }
    if not s.starts_with("#") {
        return Read.bad(String("Hex color must begin with #"))
    }
    let got = i64.wrap(s.utf16_len()) - 1
    if got != i64(digits) {
        return Read.bad("Hex color is wrong size, expected {digits} digits but got {got}")
    }
    var v: i64 = 0
    for i in 1..s.len() {
        let d = hex_value(s.byte_at(i)) else return Read.bad("Invalid color value: {s}")
        v = (v << 4) | i64(d)
    }
    return Read.ok(Tag.Int(i32.wrap(v)))
}

// An ASCII hex digit's value, as `HexFormat.fromHexDigit` reads it.
fn hex_value(b: u8) -> u8? {
    if b >= 48 and b <= 57 {
        return some(b - 48)
    }
    if b >= 97 and b <= 102 {
        return some(b - 87)
    }
    if b >= 65 and b <= 70 {
        return some(b - 55)
    }
    return none
}

// `ExtraCodecs.VECTOR3F` and `VECTOR4F`: `n` floats, then what `next` makes of them.
fn vector_of(c: mut Codecs, n: i32, next: fn(Codecs, Tag, Tag) -> Read) -> usize {
    let f = f32_codec(mut c)
    let list = c.add(Codec.ListOf(Many { of: f }))
    let fixed = c.add(Codec.Then(Then { of: list, then: fixed_size, with: Tag.Int(n) }))
    return c.add(Codec.Then(Then { of: fixed, then: next, with: Tag.End }))
}

// `Util.fixedSize(list, n)`: the list if it has `n` items, and else an error, with its first `n`
// if it has more.
fn fixed_size(_c: Codecs, value: Tag, with: Tag) -> Read {
    let n = usize.wrap(i64(int_tag(with)))
    match value {
        Tag.List(items) => {
            if items.len() == n {
                return Read.ok(value.copy())
            }
            let message = "Input is not a list of {n} elements"
            if items.len() < n {
                return Read.bad(message)
            }
            var first = List<Tag>()
            for i in 0..n {
                first.push(items[i].copy())
            }
            return Read { value: some(Tag.List(first)), error: some(message) }
        },
        _ => return Read.ok(value.copy()),
    }
}

fn floats_of(value: Tag) -> List<f32> {
    var out = List<f32>()
    match value {
        Tag.List(items) => {
            for t in items {
                out.push(float_tag(t))
            }
        },
        _ => {},
    }
    while out.len() < 4 {
        out.push(0.0f32)
    }
    return out
}

// `ARGB.redFloat` and the like: the 8 bits `shift` up in `color`, from 0 to 1.
fn channel_of(color: i32, shift: i32) -> f32 {
    return f32(u8.wrap(color >> shift)) / 255.0f32
}

// `ARGB.colorFromFloat`.
fn color_of(a: f32, r: f32, g: f32, b: f32) -> i32 {
    return (as_8bit_channel(a) << 24) | (as_8bit_channel(r) << 16) | (as_8bit_channel(g) << 8) | as_8bit_channel(b)
}

// `#` and the low `digits` hex digits of `v`, in lower case, as `hexColor` writes a color.
fn hex_text(v: i32, digits: i32) -> String {
    let chars = "0123456789abcdef"
    var out = String("#")
    var shift = (digits - 1) * 4
    while shift >= 0 {
        out.push(rune(chars.byte_at(usize.wrap(i64((v >> shift) & 15)))))
        shift -= 4
    }
    return out
}

// An RGB color, as `ARGB.colorFromVector3f` and `hexColor(6)` write it.
fn rgb_hex(r: f32, g: f32, b: f32) -> Tag {
    return Tag.Str(hex_text(color_of(1.0f32, r, g, b), 6))
}

fn rgb_of_int(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let v = int_tag(value)
    return Read.ok(rgb_hex(channel_of(v, 16), channel_of(v, 8), channel_of(v, 0)))
}

fn rgb_of_floats(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let f = floats_of(value)
    return Read.ok(rgb_hex(f[0], f[1], f[2]))
}

fn argb_of_int(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let v = int_tag(value)
    let color = color_of(channel_of(v, 24), channel_of(v, 16), channel_of(v, 8), channel_of(v, 0))
    return Read.ok(Tag.Str(hex_text(color, 8)))
}

// Four floats, red first and alpha last, as `ARGB.colorFromVector4f` writes them.
fn argb_of_floats(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let f = floats_of(value)
    return Read.ok(Tag.Str(hex_text(color_of(f[3], f[0], f[1], f[2]), 8)))
}

fn rgb_int_of_floats(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let f = floats_of(value)
    return Read.ok(Tag.Int(color_of(1.0f32, f[0], f[1], f[2])))
}

fn argb_int_of_floats(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let f = floats_of(value)
    return Read.ok(Tag.Int(color_of(f[3], f[0], f[1], f[2])))
}

// `BedRule.CODEC`.
fn make_bed_rule(c: mut Codecs) -> Codec {
    let rule = c.add(Codec.Names(["always", "when_dark", "never"]))
    let flag = bool_codec(mut c)
    let fields: List<Field> = [
        req("can_sleep", rule),
        req("can_set_spawn", rule),
        def("destroy_on_use", flag, Tag.Byte(0i8)),
        def("destroy_on_leave", flag, Tag.Byte(0i8)),
        opt("error_message", text(mut c)),
    ]
    return Codec.Record(fields)
}

// `BackgroundMusic.CODEC`, each of its kinds a `Music.CODEC`.
fn make_background_music(c: mut Codecs) -> Codec {
    let n = non_negative_int(mut c)
    let music_fields: List<Field> = [
        req("sound", sound(mut c)),
        req("min_delay", n),
        req("max_delay", n),
        def("replace_current_music", bool_codec(mut c), Tag.Byte(0i8)),
    ]
    let music = c.add(Codec.Record(music_fields))
    let fields: List<Field> = [opt("default", music), opt("creative", music), opt("underwater", music)]
    return Codec.Record(fields)
}

// `AmbientSounds.CODEC`.
fn make_ambient_sounds(c: mut Codecs) -> Codec {
    let s = sound(mut c)
    let i = i32_codec(mut c)
    let d = f64_codec(mut c)
    let mood_fields: List<Field> = [req("sound", s), req("tick_delay", i), req("block_search_extent", i), req("offset", d)]
    let mood = c.add(Codec.Record(mood_fields))
    let addition_fields: List<Field> = [req("sound", s), req("tick_chance", d)]
    let addition = c.add(Codec.Record(addition_fields))
    let additions = c.add(Codec.Compact(addition))
    let fields: List<Field> = [opt("loop", s), opt("mood", mood), def("additions", additions, Tag.List(List<Tag>()))]
    return Codec.Record(fields)
}

// `AmbientParticle.CODEC.listOf()`.
fn make_ambient_particles(c: mut Codecs) -> Codec {
    let p = particle(mut c)
    let fields: List<Field> = [req("particle", p), req("probability", unit_float(mut c))]
    let one = c.add(Codec.Record(fields))
    return Codec.ListOf(Many { of: one })
}

// `MobSpawnSettings.CODEC`: the mobs that spawn, by category, and what each costs.
fn make_mob_spawn_settings(c: mut Codecs) -> Codec {
    let categories = c.add(Codec.Names([
        "monster", "creature", "ambient", "axolotls", "underground_water_creature", "water_creature", "water_ambient",
        "misc",
    ]))
    let entity = by_name(mut c, "minecraft:entity_type")
    let spawner_fields: List<Field> = [
        req("type", entity),
        req("count", int_provider(mut c)),
        req("weight", non_negative_int(mut c)),
    ]
    let spawner = c.add(Codec.Record(spawner_fields))
    // `WeightedList.codec(SpawnerData.CODEC).promotePartial`: the spawners that read, whatever
    // didn't.
    let spawners = c.add(Codec.ListOf(Many { of: spawner }))
    let promoted = c.add(Codec.Promote(spawners))
    let d = f64_codec(mut c)
    let cost_fields: List<Field> = [req("energy_budget", d), req("charge", d)]
    let cost = c.add(Codec.Record(cost_fields))
    // A category's `toString` is its constant's name, and an entity type's its description ID.
    let by_category = c.add(Codec.MapOf(MapOf { key: categories, value: promoted, upper: true }))
    let costs = c.add(Codec.MapOf(MapOf { key: entity, value: cost, before: "entity.", dotted: true }))
    let fields: List<Field> = [req("spawns_by_category", by_category), req("spawn_costs", costs)]
    return Codec.Record(fields)
}

// `ParticleTypes.CODEC`: a particle by its type, with that type's options.
fn particle(c: mut Codecs) -> usize {
    return c.named(String("particle"), make_particle)
}

fn make_particle(c: mut Codecs) -> Codec {
    let no_fields: List<Field> = []
    let simple = c.add(Codec.Record(no_fields))
    let state = particle_block_state(mut c)
    let block_fields: List<Field> = [req("block_state", state)]
    let block = c.add(Codec.Record(block_fields))
    let positive = positive_int(mut c)
    let f = f32_codec(mut c)
    let i = i32_codec(mut c)
    let geyser_fields: List<Field> = [req("water_blocks", positive)]
    let geyser = c.add(Codec.Record(geyser_fields))
    let base_fields: List<Field> = [req("water_blocks", positive), req("burst_impulse_base", f)]
    let geyser_base = c.add(Codec.Record(base_fields))
    // Its default is an option made anew each time a particle is read or written, which isn't
    // equal to another, so it's always written.
    let power_fields: List<Field> = [Field { name: "power", of: f, need: Need.Always(Tag.Float(1.0f32)) }]
    let power = c.add(Codec.Record(power_fields))
    let rgb = rgb_int(mut c)
    let argb = argb_int(mut c)
    let scale = c.add(Codec.Then(Then { of: f, then: check_scale, with: Tag.End }))
    let dust_fields: List<Field> = [req("color", rgb), req("scale", scale)]
    let dust = c.add(Codec.Record(dust_fields))
    let transition_fields: List<Field> = [req("from_color", rgb), req("to_color", rgb), req("scale", scale)]
    let transition = c.add(Codec.Record(transition_fields))
    let spell_fields: List<Field> = [def("color", rgb, Tag.Int(-1)), def("power", f, Tag.Float(1.0f32))]
    let spell = c.add(Codec.Record(spell_fields))
    let color_fields: List<Field> = [req("color", argb)]
    let color = c.add(Codec.Record(color_fields))
    let item_fields: List<Field> = [req("item", item_stack_template(mut c))]
    let item = c.add(Codec.Record(item_fields))
    let vibration_fields: List<Field> = [req("destination", position_source(mut c)), req("arrival_in_ticks", i)]
    let vibration = c.add(Codec.Record(vibration_fields))
    let trail_fields: List<Field> = [req("target", vec3(mut c)), req("color", rgb), req("duration", positive)]
    let trail = c.add(Codec.Record(trail_fields))
    let shriek_fields: List<Field> = [req("delay", i)]
    let shriek = c.add(Codec.Record(shriek_fields))
    let charge_fields: List<Field> = [req("roll", f)]
    let charge = c.add(Codec.Record(charge_fields))
    let with_options: List<(String, usize)> = [
        ("block", block), ("block_marker", block), ("falling_dust", block), ("dust_pillar", block),
        ("block_crumble", block), ("geyser", geyser), ("geyser_plume", geyser), ("geyser_base", geyser_base),
        ("geyser_poof", geyser_base), ("dragon_breath", power), ("dust", dust),
        ("dust_color_transition", transition), ("effect", spell), ("instant_effect", spell),
        ("entity_effect", color), ("tinted_leaves", color), ("flash", color), ("item", item),
        ("vibration", vibration), ("trail", trail), ("shriek", shriek), ("sculk_charge", charge),
    ]
    var kinds = List<(String, usize)>()
    let names = builtin_names()
    for n in 0..names.len() {
        if names[n] != "particle_type" {
            continue
        }
        for p in builtin_entries(n) {
            var of = simple
            for (name, options) in with_options {
                if name == p {
                    of = options
                }
            }
            kinds.push(("minecraft:{p}", of))
        }
    }
    let by = by_name(mut c, "minecraft:particle_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `ScalableParticleOptionsBase.SCALE`.
fn check_scale(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let v = float_tag(value)
    if v >= 0.01f32 and v <= 4.0f32 {
        return Read.ok(value.copy())
    }
    return Read.bad("Value must be within range [0.01;4.0]: {v}")
}

// `BlockParticleOption`'s block state: `BlockState.CODEC`, or a block by name for its default
// state.
fn particle_block_state(c: mut Codecs) -> usize {
    let state = block_state(mut c)
    let blocks = by_name(mut c, "minecraft:block")
    let block = c.add(Codec.Then(Then { of: blocks, then: default_state_of, with: Tag.End }))
    return c.add(Codec.Either(state, block))
}

// The default state of the block `value` names, as `BlockState.CODEC` writes it.
fn default_state_of(c: Codecs, value: Tag, _with: Tag) -> Read {
    let name = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    match c.states {
        some(states) => {
            return match states.blocks.parse(name) {
                ok(block) => Read.ok(states.encode(states.default_state(block))),
                err(e) => Read.bad(e),
            }
        },
        none => return Read.bad(String("no block states to read")),
    }
}

// `VibrationParticleOption`'s destination: `PositionSource.CODEC`, without entities.
fn position_source(c: mut Codecs) -> usize {
    let pos_fields: List<Field> = [req("pos", vec3i(mut c))]
    let block = c.add(Codec.Record(pos_fields))
    let entity_fields: List<Field> = [req("source_entity", uuid(mut c)), def("y_offset", f32_codec(mut c), Tag.Float(0.0f32))]
    let entity = c.add(Codec.Record(entity_fields))
    let kinds: List<(String, usize)> = [("minecraft:block", block), ("minecraft:entity", entity)]
    let by = by_name(mut c, "minecraft:position_source_type")
    let source = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    return c.add(Codec.Then(Then { of: source, then: no_entity_source, with: Tag.End }))
}

fn no_entity_source(_c: Codecs, value: Tag, _with: Tag) -> Read {
    if kind_of(value) == "minecraft:entity" {
        return Read.bad(String("Entity position sources are not allowed"))
    }
    return Read.ok(value.copy())
}

// `UUIDUtil.CODEC`: four ints, written as an int array.
fn uuid(c: mut Codecs) -> usize {
    return c.shared(String("uuid"), Codec.Custom(read_uuid))
}

fn read_uuid(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Array(items) => ints_of(value, items, 4),
        _ => Read.bad("Not a json array: {json_text(value)}"),
    }
}

// `Vec3.CODEC`: three doubles.
fn vec3(c: mut Codecs) -> usize {
    let d = f64_codec(mut c)
    let list = c.add(Codec.ListOf(Many { of: d }))
    return c.shared(String("vec3"), Codec.Then(Then { of: list, then: fixed_size, with: Tag.Int(3) }))
}

// `DimensionType.NETWORK_CODEC`. Its constructor's checks fail it with their message alone, as
// `ExtraCodecs.catchDecoderException` gives it, so it reads its record itself.
fn dimension_type(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    // `Codec.doubleRange(1.0E-5F, 3.0E7)`: its least is the `float` nearest 1.0E-5.
    let least = f64(0.00001f32)
    let most = 30000000.0
    let scale = c.add(Codec.Double(DoubleRange { min: least, max: most, checked: true, before: "Value ", after: " outside of range [{least}:{most}]" }))
    let min_y = c.add(Codec.Int(IntRange { min: -2032, max: 2031, before: "Value ", after: " outside of range [-2032:2031]" }))
    let height = c.add(Codec.Int(IntRange { min: 16, max: 4064, before: "Value ", after: " outside of range [16:4064]" }))
    let logical = c.add(Codec.Int(IntRange { min: 0, max: 4064, before: "Value ", after: " outside of range [0:4064]" }))
    let light = c.add(Codec.Int(IntRange { min: 0, max: 15, before: "Value ", after: " outside of range [0:15]" }))
    let blocks = c.add(Codec.Holders(HolderCodec { registry: "minecraft:block", inline: none, kind: HolderKind.Fixed }))
    let timelines = c.add(Codec.Holders(HolderCodec { registry: "minecraft:timeline", inline: none, kind: HolderKind.Fixed }))
    let clock = c.add(Codec.Holder(HolderCodec { registry: "minecraft:world_clock", inline: none, kind: HolderKind.Fixed }))
    let skyboxes = c.add(Codec.Names(["none", "overworld", "end"]))
    let lights = c.add(Codec.Names(["default", "nether"]))
    let provider = int_provider(mut c)
    let bounds: List<i32> = [0, 15]
    let light_test = c.add(Codec.Then(Then { of: provider, then: int_provider_within, with: Tag.IntArray(bounds) }))
    let fields: List<Field> = [
        def("has_fixed_time", flag, Tag.Byte(0i8)),
        req("has_skylight", flag),
        req("has_ceiling", flag),
        req("has_ender_dragon_fight", flag),
        req("coordinate_scale", scale),
        req("min_y", min_y),
        req("height", height),
        req("logical_height", logical),
        req("infiniburn", blocks),
        req("ambient_light", f32_codec(mut c)),
        req("monster_spawn_light_level", light_test),
        req("monster_spawn_block_light_limit", light),
        def("skybox", skyboxes, Tag.Str(String("overworld"))),
        def("cardinal_light", lights, Tag.Str(String("default"))),
        // Only the attributes clients are sent are written, but the field is left out only where
        // there were none at all, as `optionalFieldOf` compares the map before
        // `EnvironmentAttributeMap.NETWORK_CODEC` filters it.
        def("attributes", attribute_map(mut c), Tag.Compound(JavaHashMap<String, Tag>())),
        def("timelines", timelines, Tag.List(List<Tag>())),
        opt("default_clock", clock),
    ]
    let _record = c.shared(String("dimension_type_record"), Codec.Record(fields))
    return c.add(Codec.Custom(read_dimension_type))
}

fn read_dimension_type(c: Codecs, value: Json, r: Registries) -> Read {
    let at = c.find(String("dimension_type_record")) else return Read.bad(String("no codec for dimension types"))
    var got = c.read(at, value, r)
    let v = got.value.take() else return got
    // `DimensionType`'s constructor, which runs on a partial value too. The height is at least 16,
    // as its codec reads it.
    let min_y = int_tag(field(v, "min_y"))
    let height = int_tag(field(v, "height"))
    if min_y + height > 2032 {
        return Read.bad(String("min_y + height cannot be higher than: 2032"))
    }
    if int_tag(field(v, "logical_height")) > height {
        return Read.bad(String("logical_height cannot be higher than height"))
    }
    if height % 16 != 0 {
        return Read.bad(String("height has to be multiple of 16"))
    }
    if min_y % 16 != 0 {
        return Read.bad(String("min_y has to be a multiple of 16"))
    }
    return Read { value: some(synced_field(v, "attributes")), error: got.error.take() }
}

// `value` with only the attributes clients are sent in its map of attributes under `key`, if it
// has one.
fn synced_field(value: Tag, key: String) -> Tag {
    match value {
        Tag.Compound(fields) => {
            var out = JavaHashMap<String, Tag>()
            for (k, v) in fields {
                if k == key {
                    out.insert(k.copy(), synced_only(v))
                } else {
                    out.insert(k.copy(), v.copy())
                }
            }
            return Tag.Compound(out)
        },
        _ => return value.copy(),
    }
}

// `IntProviders.validateCodec(min, max, CODEC)`'s check of what a provider gives.
fn int_provider_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let (least, most) = match with {
        Tag.IntArray(b) => (b[0], b[1]),
        _ => (i32.MIN, i32.MAX),
    }
    let (min, max) = int_bounds(value)
    if min < least {
        return Read.bad("Value provider too low: {least} [{min}-{max}]")
    }
    if max > most {
        return Read.bad("Value provider too high: {most} [{min}-{max}]")
    }
    return Read.ok(value.copy())
}

// The least and most an int provider gives, as `IntProvider.minInclusive` and `maxInclusive` give
// them.
fn int_bounds(value: Tag) -> (i32, i32) {
    match value {
        Tag.Int(v) => return (v, v),
        _ => {},
    }
    let kind = kind_of(value)
    if kind == "minecraft:trapezoid" {
        return (int_tag(field(value, "min")), int_tag(field(value, "max")))
    }
    if kind == "minecraft:weighted_list" {
        var min = i32.MAX
        var max = i32.MIN
        match field(value, "distribution") {
            Tag.List(entries) => {
                for e in entries {
                    let (low, high) = int_bounds(field(e, "data"))
                    if low < min {
                        min = low
                    }
                    if high > max {
                        max = high
                    }
                }
            },
            _ => {},
        }
        return (min, max)
    }
    return (int_tag(field(value, "min_inclusive")), int_tag(field(value, "max_inclusive")))
}

// `Biome.NETWORK_CODEC`: a biome's climate, the attributes clients are sent and its effects, read
// as `DIRECT_CODEC` reads one from a data pack, with what it generates, which isn't sent.
fn biome(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let f = f32_codec(mut c)
    let modifiers = c.add(Codec.Names(["none", "frozen"]))
    let _map = attribute_map(mut c)
    let attributes = c.add(Codec.Custom(read_positional_attributes))
    let color = c.named(String("string_rgb_color"), make_string_rgb_color)
    let grass = c.add(Codec.Names(["none", "dark_forest", "swamp"]))
    let effect_fields: List<Field> = [
        req("water_color", color),
        opt("foliage_color", color),
        opt("dry_foliage_color", color),
        opt("grass_color", color),
        def("grass_color_modifier", grass, Tag.Str(String("none"))),
    ]
    let effects = c.add(Codec.Record(effect_fields))
    // `BiomeGenerationSettings.CODEC`: its carvers and its features by step, each logged and left
    // out where they don't read.
    let unchecked = c.shared(String("unchecked inline"), Codec.Custom(read_unchecked))
    let carver_set = c.add(Codec.Holders(HolderCodec { registry: "minecraft:worldgen/carver", inline: some(unchecked) }))
    let carvers = c.add(Codec.Promote(carver_set))
    let feature_set = c.add(Codec.Holders(HolderCodec { registry: "minecraft:worldgen/placed_feature", inline: some(unchecked) }))
    let feature_steps = c.add(Codec.ListOf(Many { of: feature_set }))
    let features = c.add(Codec.Promote(feature_steps))
    let fields: List<Field> = [
        req("has_precipitation", flag),
        req("temperature", f),
        def("temperature_modifier", modifiers, Tag.Str(String("none"))),
        req("downfall", f),
        // As a dimension type's: left out only where there were none at all.
        def("attributes", attributes, Tag.Compound(JavaHashMap<String, Tag>())),
        req("effects", effects),
        req("carvers", carvers),
        req("features", features),
    ]
    let _record = c.shared(String("biome_record"), Codec.Record(fields))
    return c.add(Codec.Custom(read_biome))
}

fn read_biome(c: Codecs, value: Json, r: Registries) -> Read {
    let at = c.find(String("biome_record")) else return Read.bad(String("no codec for biomes"))
    var got = c.read(at, value, r)
    let v = got.value.take() else return got
    return Read { value: some(network_biome(v)), error: got.error.take() }
}

// A biome as `NETWORK_CODEC` writes it: without what it generates, and with only the attributes
// clients are sent.
fn network_biome(value: Tag) -> Tag {
    let synced = synced_field(value, "attributes")
    match synced {
        Tag.Compound(fields) => {
            var out = JavaHashMap<String, Tag>()
            for (k, v) in fields {
                if k != "carvers" and k != "features" {
                    out.insert(k.copy(), v.copy())
                }
            }
            return Tag.Compound(out)
        },
        _ => return synced.copy(),
    }
}

// `EnvironmentAttributeMap.CODEC_ONLY_POSITIONAL`: attributes as `CODEC` reads them, with none
// that can only be set for a whole dimension, named in the order they're given.
fn read_positional_attributes(c: Codecs, value: Json, r: Registries) -> Read {
    let at = c.find(String("attribute_map")) else return Read.bad(String("no codec for attributes"))
    var got = c.read(at, value, r)
    let v = got.value.take() else return got
    var wrong = String()
    for name in object_ids(value) {
        if has_field(v, name) and attribute_flag(name, "n") {
            if not wrong.is_empty() {
                wrong.push_str(", ")
            }
            wrong.push_str(name)
        }
    }
    if wrong.is_empty() {
        return Read { value: some(v), error: got.error.take() }
    }
    return after(got.error.take(), Read.bad("The following attributes cannot be positional: [{wrong}]"))
}

// `ExtraCodecs.STRING_RGB_COLOR`: `#rrggbb`, or an int or three floats as `RGB_COLOR_CODEC` reads
// them, written as `#rrggbb`.
fn make_string_rgb_color(c: mut Codecs) -> Codec {
    let hex = hex_color(mut c, 6, hex6_of_int)
    let ints = rgb_int(mut c)
    let int = c.add(Codec.Then(Then { of: ints, then: hex6_of_int, with: Tag.End }))
    return Codec.Either(hex, int)
}

// A color as `hexColor(6)` writes it, with `ARGB.transparent`: its low 24 bits.
fn hex6_of_int(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return Read.ok(Tag.Str(hex_text(int_tag(value), 6)))
}

// An inline definition of a carver or a placed feature, which isn't sent. Only that it's an object
// is checked for now: the worldgen codecs that read them in full come with worldgen.
fn read_unchecked(_c: Codecs, value: Json, _r: Registries) -> Read {
    return match value {
        Json.Object(_) => Read.ok(Tag.End),
        _ => Read.bad("Not a JSON object: {json_text(value)}"),
    }
}
