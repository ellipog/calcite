/// Tags: named sets of a registry's entries, from the files under `tags/<registry>/` in data
/// packs, as vanilla's `TagLoader` reads and builds them. A tag holds entries and other tags,
/// each perhaps optional; a later pack's file adds to an earlier one's unless it says `replace`.
/// Tags are built after the tags they hold, in the order vanilla's `DependencySorter` goes, so
/// one that can't be built is logged as vanilla logs it.
module registry.tags

import json.tree.{Json, get, parse}
import pack.resources.{Resources}
import registry.registry.{Registry, Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}

// What a tag file lists: an entry or a tag, which may be optional, and the pack it's from.
struct TagEntry {
    id: Identifier
    tag: bool
    required: bool
    source: String
}

// How vanilla's `EntryWithSource.toString` writes it: `#minecraft:logs? (from vanilla)`.
fn entry_text(e: TagEntry) -> String {
    let mark = if e.tag { "#" } else { "" }
    let optional = if e.required { "" } else { "?" }
    return "{mark}{e.id.to_string()}{optional} (from {e.source})"
}

/// Loads the tags of `registry` from `resources` into it, logging the files and tags that can't
/// be read or built. False if the registry is synchronized and a tag needs an entry it hasn't,
/// which in vanilla stops the server.
pub fn load_tags(resources: Resources, registry: mut Registry, logs: mut List<Entry>) -> bool {
    let directory = "tags/{registry.name.path}"
    let prefix_len = directory.len() + 1
    // Each tag's entries, as vanilla's `load` collects them.
    var builders = JavaHashMap<Identifier, List<TagEntry>>()
    for stack in resources.stacks(directory, String(".json")) {
        let path = stack.id.path[prefix_len..stack.id.path.len() - 5]
        let id = Identifier { namespace: stack.id.namespace.copy(), path: path }
        for r in stack.resources {
            let source = resources.pack_id(r.pack)
            let problem = "Couldn't read tag list {id.to_string()} from {stack.id.to_string()} in data pack {source}"
            let bytes = match resources.read(r) {
                ok(b) => b,
                err(_) => {
                    logs.push(Entry.error(problem))
                    continue
                },
            }
            let text = String.from_utf8(bytes) else {
                logs.push(Entry.error(problem))
                continue
            }
            let json = parse(text) else {
                logs.push(Entry.error(problem))
                continue
            }
            // The tag exists once its file is JSON, even if it's not a tag file, as in vanilla.
            _ = builders.compute_if_absent(id.copy(), List<TagEntry>())
            let file = read_file(json, source) else {
                logs.push(Entry.error(problem))
                continue
            }
            if file.replace {
                builders[id].clear()
            }
            for e in file.entries {
                builders[id].push(e.copy())
            }
        }
    }
    var contents = JavaHashMap<Identifier, List<TagEntry>>()
    for (id, entries) in builders {
        contents.insert(id.copy(), entries.copy())
    }
    // Each tag's dependencies, those it needs before those it may have, leaving out any that
    // would make a cycle, in the sets of Guava's `HashMultimap`.
    var dependencies = JavaHashMap<Identifier, JavaHashSet<Identifier>>(17)
    for pass in 0..2 {
        let required = pass == 0
        for (id, entries) in contents {
            for e in entries {
                if e.tag and e.required == required and not cyclic(dependencies, id, e.id) {
                    _ = dependencies.compute_if_absent(id.copy(), JavaHashSet<Identifier>(3))
                    dependencies[id].insert(e.id.copy())
                }
            }
        }
    }
    var built = JavaHashMap<Identifier, List<i32>>()
    var visited = Set<String>()
    var unbound = List<String>()
    for (id, _) in contents {
        visit(id, contents, dependencies, mut visited, mut built, registry, mut unbound, mut logs)
    }
    var tags = List<Tag>()
    for (id, values) in built {
        tags.push(Tag { name: id.copy(), values: values.copy() })
    }
    tags.sort()
    registry.tags = tags
    if not unbound.is_empty() {
        unbound.sort()
        var list = String()
        for u in unbound {
            if not list.is_empty() {
                list.push_str(", ")
            }
            list.push_str(u)
        }
        logs.push(Entry.error("Unbound values in registry {registry.name.to_string()}: [{list}]"))
        return false
    }
    return true
}

// Whether `to` depends on `from`, so a dependency of `from` on it would make a cycle.
fn cyclic(dependencies: JavaHashMap<Identifier, JavaHashSet<Identifier>>, from: Identifier, to: Identifier) -> bool {
    if not dependencies.contains(to) {
        return false
    }
    if dependencies[to].contains(from) {
        return true
    }
    for d in dependencies[to] {
        if cyclic(dependencies, from, d) {
            return true
        }
    }
    return false
}

// Builds the tags `id` depends on, then `id`, as `DependencySorter.visitDependenciesAndElement`.
fn visit(id: Identifier, contents: JavaHashMap<Identifier, List<TagEntry>>, dependencies: JavaHashMap<Identifier, JavaHashSet<Identifier>>, visited: mut Set<String>, built: mut JavaHashMap<Identifier, List<i32>>, registry: Registry, unbound: mut List<String>, logs: mut List<Entry>) {
    let key = id.to_string()
    if visited.contains(key) {
        return
    }
    visited.insert(key)
    if dependencies.contains(id) {
        for d in dependencies[id] {
            visit(d, contents, dependencies, mut visited, mut built, registry, mut unbound, mut logs)
        }
    }
    if not contents.contains(id) {
        return
    }
    // The entries in the order they're listed, each once, as a `LinkedHashSet` keeps them.
    var values = List<i32>()
    var seen = Set<i32>()
    var missing = String()
    for e in contents[id] {
        if e.tag {
            if built.contains(e.id) {
                for v in built[e.id] {
                    if not seen.contains(v) {
                        seen.insert(v)
                        values.push(v)
                    }
                }
                continue
            }
        } else {
            if let v = registry.id(e.id) {
                if not seen.contains(v) {
                    seen.insert(v)
                    values.push(v)
                }
                continue
            }
            if e.required and registry.synced {
                // A synchronized registry makes a placeholder for an entry a tag needs, which
                // stops the server once it finds the entry never came.
                let text = e.id.to_string()
                if not unbound.contains(text) {
                    unbound.push(text)
                }
                continue
            }
        }
        if e.required {
            if not missing.is_empty() {
                missing.push_str(", ")
            }
            missing.push_str(entry_text(e))
        }
    }
    if not missing.is_empty() {
        logs.push(Entry.error("Couldn't load tag {id.to_string()} as it is missing following references: {missing}"))
        return
    }
    built.insert(id.copy(), values)
}

struct TagFile {
    entries: List<TagEntry>
    replace: bool
}

// A tag file, as vanilla's `TagFile.CODEC` reads it: `values`, a list of identifiers, `#` and a
// tag's, or objects with `id` and an optional `required`, and an optional `replace`.
fn read_file(json: Json, source: String) -> TagFile? {
    let Json.Object(members) = json else return none
    let values = get(members, "values") else return none
    let Json.Array(items) = values else return none
    var entries = List<TagEntry>()
    for item in items {
        let e = read_entry(item, source) else return none
        entries.push(e)
    }
    var replace = false
    match get(members, "replace") {
        some(Json.Bool(b)) => replace = b,
        none => {},
        _ => return none,
    }
    return some(TagFile { entries: entries, replace: replace })
}

fn read_entry(item: Json, source: String) -> TagEntry? {
    match item {
        Json.Str(s) => return reference(s, true, source),
        Json.Object(fields) => {
            let id = get(fields, "id") else return none
            let Json.Str(s) = id else return none
            var required = true
            match get(fields, "required") {
                some(Json.Bool(b)) => required = b,
                none => {},
                _ => return none,
            }
            return reference(s, required, source)
        },
        _ => return none,
    }
}

// An entry's or, after `#`, a tag's identifier.
fn reference(text: String, required: bool, source: String) -> TagEntry? {
    let tag = text.starts_with("#")
    let name = if tag { text[1..] } else { text.copy() }
    return match Identifier.parse(name) {
        ok(id) => some(TagEntry { id: id, tag: tag, required: required, source: source.copy() }),
        err(_) => none,
    }
}
