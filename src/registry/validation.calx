/// What vanilla checks of the loot conditions an enchantment's effects need, once a list of
/// effects is read, as `Validatable.listValidatorForContext` checks it: that each condition, and
/// each number a condition is given, uses only the parameters the effect's context has, as
/// `LootContextParamSets` has them, and that a number made of others has at least one. What's
/// wrong is reported as `ProblemReporter.Collector.getReport` puts it, each problem at its path,
/// such as `[0].requirements.terms[1]`.
///
/// One thing can't be vanilla's: where a condition uses two parameters the context hasn't, vanilla
/// lists them in the order of a `Set.of` of keys hashed by identity, which changes from run to run,
/// so Calcite lists them by name.
module registry.validation

import nbt.tag.{Tag}
import registry.codec.{Codecs, Read}
import registry.codecs.{environment_attributes}

/// The parameters a context of `LootContextParamSets` allows, required or optional, by the set's
/// name; only the sets an enchantment's effects are checked against.
pub fn allowed_in(set: String) -> List<String> {
    if set == "enchanted_damage" {
        return ["this_entity", "enchantment_level", "origin", "damage_source", "direct_attacking_entity", "attacking_entity"]
    }
    if set == "enchanted_item" {
        return ["tool", "enchantment_level"]
    }
    if set == "enchanted_location" {
        return ["this_entity", "enchantment_level", "origin", "enchantment_active"]
    }
    if set == "enchanted_entity" {
        return ["this_entity", "enchantment_level", "origin"]
    }
    if set == "hit_block" {
        return ["this_entity", "enchantment_level", "origin", "block_state"]
    }
    return List<String>()
}

/// `EnchantmentEffectComponents.validatedListCodec`'s check of a list of effects, each with the
/// condition it needs, if any, in `requirements`, against the set `with` names: a `Then` check.
pub fn check_effects(_c: Codecs, value: Tag, with: Tag) -> Read {
    let set = match with {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    var k = Checker { allowed: allowed_in(set), problems: List<(String, String)>() }
    match value {
        Tag.List(items) => {
            for i in 0..items.len() {
                if let r = member(items[i], "requirements") {
                    k.condition(r, "[{i}].requirements")
                }
            }
        },
        _ => {},
    }
    if k.problems.is_empty() {
        return Read.ok(value.copy())
    }
    return Read.bad("Validation error: {k.report()}")
}

// A `ValidationContext` over a `ProblemReporter.Collector`: the parameters allowed, and each
// problem reported, with its path, in the order they were.
struct Checker {
    allowed: List<String>
    problems: List<(String, String)>
}

impl Checker {
    // `validateContextUsage`: the parameters of `used` the context hasn't.
    fn uses(mut self, path: String, used: List<String>) {
        var missing = List<String>()
        for p in used {
            if not self.allowed.contains(p) and not missing.contains(p) {
                missing.push(p.copy())
            }
        }
        if missing.is_empty() {
            return
        }
        missing.sort()
        var listed = String()
        for p in missing {
            if not listed.is_empty() {
                listed.push_str(", ")
            }
            listed.push_str("<parameter minecraft:{p}>")
        }
        self.problems.push((path.copy(), "Parameters [{listed}] are not provided in this context"))
    }

    // `getReport`: the problems grouped by path in a `HashMultimap`, whose keys are a `HashMap`'s
    // made for 12 of them, each group ` at ` its path and its problems.
    fn report(self) -> String {
        var groups = JavaHashMap<String, List<String>>(16)
        for (path, description) in self.problems {
            if groups.contains(path) {
                groups[path].push(description.copy())
            } else {
                groups.insert(path.copy(), [description.copy()])
            }
        }
        var out = String()
        for (path, descriptions) in groups {
            if not out.is_empty() {
                out.push_str("\n")
            }
            out.push_str(" at {path}: ")
            for i in 0..descriptions.len() {
                if i > 0 {
                    out.push_str("; ")
                }
                out.push_str(descriptions[i])
            }
        }
        return out
    }

    // A condition's `validate`: the parameters it uses, then what it holds.
    fn condition(mut self, c: Tag, path: String) {
        let kind = kind_of(c)
        let used = condition_uses(c, kind)
        self.uses(path, used)
        if kind == "minecraft:inverted" {
            if let term = member(c, "term") {
                self.condition(term, "{path}.term")
            }
        } else if kind == "minecraft:any_of" or kind == "minecraft:all_of" {
            if let terms = member(c, "terms") {
                let each = holders(terms)
                for i in 0..each.len() {
                    self.condition(each[i], "{path}.terms[{i}]")
                }
            }
        } else if kind == "minecraft:entity_scores" {
            match member(c, "scores") {
                some(Tag.Compound(scores)) => {
                    for (name, range) in scores {
                        self.int_range(range, "{path}.scores[{name}]")
                    }
                },
                _ => {},
            }
        } else if kind == "minecraft:time_check" {
            if let value = member(c, "value") {
                self.int_range(value, "{path}.value")
            }
        } else if kind == "minecraft:int_value_check" {
            if let value = member(c, "value") {
                self.int_provider(value, "{path}.value")
            }
            if let test = member(c, "test") {
                self.int_range(test, "{path}.range")
            }
        } else if kind == "minecraft:float_value_check" {
            if let value = member(c, "value") {
                self.float_provider(value, "{path}.value")
            }
            if let test = member(c, "test") {
                self.float_range(test, "{path}.range")
            }
        }
    }

    // `IntRangePredicate`: a point, a provider in its own place, or a line, its ends at `min` and
    // `max`. A provider is a number or has a kind; a line has neither.
    fn int_range(mut self, r: Tag, path: String) {
        if is_line(r) {
            if let min = member(r, "min") {
                self.int_provider(min, "{path}.min")
            }
            if let max = member(r, "max") {
                self.int_provider(max, "{path}.max")
            }
            return
        }
        self.int_provider(r, path)
    }

    // `FloatRangePredicate`, as `int_range`.
    fn float_range(mut self, r: Tag, path: String) {
        if is_line(r) {
            if let min = member(r, "min") {
                self.float_provider(min, "{path}.min")
            }
            if let max = member(r, "max") {
                self.float_provider(max, "{path}.max")
            }
            return
        }
        self.float_provider(r, path)
    }

    // A `ContextIntProvider`'s `validate`.
    fn int_provider(mut self, p: Tag, path: String) {
        let kind = kind_of(p)
        if self.shared_provider(p, kind, path, false) {
            return
        }
        if kind == "minecraft:from_float" {
            if let input = member(p, "input") {
                self.float_provider(input, "{path}.input")
            }
        } else if kind == "minecraft:binomial" {
            if let n = member(p, "n") {
                self.int_provider(n, "{path}.n")
            }
            if let pr = member(p, "p") {
                self.float_provider(pr, "{path}.p")
            }
        } else if kind == "minecraft:score" {
            match member(p, "target") {
                some(Tag.Str(target)) => self.uses("{path}.target", [entity_param(target)]),
                _ => {},
            }
            if let fallback = member(p, "fallback") {
                self.int_provider(fallback, "{path}.fallback")
            }
        }
    }

    // A `ContextFloatProvider`'s `validate`.
    fn float_provider(mut self, p: Tag, path: String) {
        let kind = kind_of(p)
        if self.shared_provider(p, kind, path, true) {
            return
        }
        if kind == "minecraft:from_int" {
            if let input = member(p, "input") {
                self.int_provider(input, "{path}.input")
            }
        } else if kind == "minecraft:enchantment_level" {
            self.uses(path, [String("enchantment_level")])
        }
    }

    // What int and float providers of the same kind check alike, each part a provider of the same
    // type, `floats` or ints; whether the kind is one of those.
    fn shared_provider(mut self, p: Tag, kind: String, path: String, floats: bool) -> bool {
        if kind == "minecraft:abs" or kind == "minecraft:ceil" or kind == "minecraft:cos" or kind == "minecraft:floor" or kind == "minecraft:negate" or kind == "minecraft:round" or kind == "minecraft:sin" or kind == "minecraft:sqrt" or kind == "minecraft:truncate" {
            if let input = member(p, "input") {
                self.provider(input, "{path}.input", floats)
            }
            return true
        }
        if kind == "minecraft:avg" or kind == "minecraft:length" or kind == "minecraft:max" or kind == "minecraft:min" or kind == "minecraft:mul" or kind == "minecraft:add" {
            // `validateHolderSet` with at least one.
            var count: usize = 0
            if let inputs = member(p, "inputs") {
                let each = holders(inputs)
                count = each.len()
                for i in 0..each.len() {
                    self.provider(each[i], "{path}.inputs[{i}]", floats)
                }
            }
            if count < 1 {
                self.problems.push(("{path}.inputs", String("List must contain at least 1 element(s)")))
            }
            return true
        }
        if kind == "minecraft:sub" or kind == "minecraft:mod" or kind == "minecraft:div" or kind == "minecraft:floor_mod" or kind == "minecraft:floor_div" {
            for name in ["left", "right"] {
                if let part = member(p, name) {
                    self.provider(part, "{path}.{name}", floats)
                }
            }
            return true
        }
        if kind == "minecraft:pow" {
            for name in ["base", "exponent"] {
                if let part = member(p, name) {
                    self.provider(part, "{path}.{name}", floats)
                }
            }
            return true
        }
        if kind == "minecraft:uniform" {
            for name in ["min", "max"] {
                if let part = member(p, name) {
                    self.provider(part, "{path}.{name}", floats)
                }
            }
            return true
        }
        if kind == "minecraft:conditional" {
            if let test = member(p, "condition") {
                self.condition(test, "{path}.condition")
            }
            for name in ["on_true", "on_false"] {
                if let part = member(p, name) {
                    self.provider(part, "{path}.{name}", floats)
                }
            }
            return true
        }
        if kind == "minecraft:number_dispatcher" {
            match member(p, "cases") {
                some(Tag.List(cases)) => {
                    for i in 0..cases.len() {
                        if let test = member(cases[i], "condition") {
                            self.condition(test, "{path}.cases[{i}].condition")
                        }
                        if let value = member(cases[i], "value") {
                            self.provider(value, "{path}.cases[{i}].value", floats)
                        }
                    }
                },
                _ => {},
            }
            if let fallback = member(p, "default") {
                self.provider(fallback, "{path}.default", floats)
            }
            return true
        }
        if kind == "minecraft:weighted_list" {
            match member(p, "distribution") {
                some(Tag.List(entries)) => {
                    for i in 0..entries.len() {
                        if let data = member(entries[i], "data") {
                            self.provider(data, "{path}.distribution[{i}]", floats)
                        }
                    }
                },
                _ => {},
            }
            return true
        }
        if kind == "minecraft:storage" {
            if let fallback = member(p, "fallback") {
                self.provider(fallback, "{path}.fallback", floats)
            }
            return true
        }
        if kind == "minecraft:environment_attribute" {
            if positional(member(p, "attribute")) {
                self.uses(path, [String("origin")])
            }
            return true
        }
        return false
    }

    fn provider(mut self, p: Tag, path: String, floats: bool) {
        if floats {
            self.float_provider(p, path)
        } else {
            self.int_provider(p, path)
        }
    }
}

// The parameters a condition of `kind` uses, `getReferencedContextParams`.
fn condition_uses(c: Tag, kind: String) -> List<String> {
    if kind == "minecraft:random_chance_with_enchanted_bonus" {
        return [String("attacking_entity")]
    }
    if kind == "minecraft:entity_properties" {
        return [String("origin"), entity_param(target_of(c))]
    }
    if kind == "minecraft:entity_scores" {
        return [entity_param(target_of(c))]
    }
    if kind == "minecraft:killed_by_player" {
        return [String("last_damage_player")]
    }
    if kind == "minecraft:match_block" {
        // `willMatchBlockEntity`: a predicate on the block entity's data or components.
        if member(c, "nbt") != none or member(c, "components") != none or member(c, "predicates") != none {
            return [String("block_state"), String("block_entity")]
        }
        return [String("block_state")]
    }
    if kind == "minecraft:match_tool" or kind == "minecraft:table_bonus" {
        return [String("tool")]
    }
    if kind == "minecraft:survives_explosion" {
        return [String("explosion_radius")]
    }
    if kind == "minecraft:damage_source_properties" {
        return [String("origin"), String("damage_source")]
    }
    if kind == "minecraft:location_check" {
        return [String("origin")]
    }
    if kind == "minecraft:enchantment_active_check" {
        return [String("enchantment_active")]
    }
    if kind == "minecraft:environment_attribute_check" {
        if positional(member(c, "attribute")) {
            return [String("origin")]
        }
    }
    return List<String>()
}

// The parameter `LootContext.EntityTarget` gets an entity from.
fn entity_param(target: String) -> String {
    if target == "attacker" {
        return String("attacking_entity")
    }
    if target == "direct_attacker" {
        return String("direct_attacking_entity")
    }
    if target == "attacking_player" {
        return String("last_damage_player")
    }
    if target == "target_entity" {
        return String("target_entity")
    }
    if target == "interacting_entity" {
        return String("interacting_entity")
    }
    return String("this_entity")
}

fn target_of(c: Tag) -> String {
    return match member(c, "entity") {
        some(Tag.Str(s)) => s.copy(),
        _ => String(),
    }
}

// Whether the attribute named, as `minecraft:` and its path, is positional: it can be set for a
// place, not only for a dimension.
fn positional(name: Tag?) -> bool {
    let id = match name {
        some(Tag.Str(s)) => s.copy(),
        _ => return false,
    }
    for (n, _kind, flags) in environment_attributes() {
        if id == "minecraft:{n}" {
            return not flags.contains("n")
        }
    }
    return false
}

// A range with ends rather than a provider: a compound with no kind.
fn is_line(r: Tag) -> bool {
    return match r {
        Tag.Compound(m) => not m.contains("type"),
        _ => false,
    }
}

// Each entry of a set of holders given in full, which is written as its one entry alone.
fn holders(t: Tag) -> List<Tag> {
    return match t {
        Tag.List(items) => items.copy(),
        _ => [t.copy()],
    }
}

// A compound's kind, or nothing.
fn kind_of(t: Tag) -> String {
    return match member(t, "type") {
        some(Tag.Str(s)) => s.copy(),
        _ => String(),
    }
}

// A compound's member, if it has it.
fn member(t: Tag, key: str) -> Tag? {
    return match t {
        Tag.Compound(m) => if m.contains(key) { some(m[key].copy()) } else { none },
        _ => none,
    }
}
