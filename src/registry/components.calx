/// Item components, described for `registry.codec`: each type `DataComponents` registers that's
/// saved, with the codec vanilla reads it with from a data pack and writes it back with, and
/// `DataComponentPatch.CODEC`, the components a stack changes from its item's, which
/// `ItemStackTemplate`, item predicates and the components inside other components hold. A type
/// Calcite has no codec for yet says so where it's given (CAL-77).
module registry.components

import json.tree.{Json}
import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Dispatched, Field, FloatRange, HolderCodec, HolderKind, IntRange, Many, MapOf, Read, Then, json_text}
import registry.codecs.{bool_codec, def, f32_codec, i32_codec, i64_codec, id, item_stack_template, non_negative_int, opt, positive_float, positive_int, read_compound_tag, req, sound, string, text}
import registry.predicates.{block, holder_set, item, snbt_compound}
import registry.registries.{Registries}
import resources.identifier.{Identifier}

/// `DataComponentPatch.CODEC`, made in `c`: an object whose keys are component types, each the
/// component's value, or with `!` before it, `{}`, the component taken away. Written with each
/// type's whole ID. It's named `component patch`, so codecs made before it, such as
/// `ItemStackTemplate`'s, find it as they read.
pub fn component_patch(c: mut Codecs) -> usize {
    return c.named(String("component patch"), make_patch)
}

fn make_patch(c: mut Codecs) -> Codec {
    let key = c.add(Codec.Custom(read_key))
    // `Removed.CODEC`, `MapCodec.unitCodec`: any object, written `{}`.
    let removed = unit(mut c)
    var values = List<(String, usize)>()
    for (name, at) in component_codecs(mut c) {
        c.name("component {name}", at)
        values.push(("!{name}", removed))
        values.push((name.copy(), at))
    }
    for name in transient_names() {
        c.name("transient component minecraft:{name}", removed)
    }
    return Codec.Dispatched(Dispatched { key: key, values: values })
}

// `PatchKey.CODEC`: a type's ID, with `!` before it for one taken away, which must be a type that's
// saved. One that doesn't parse is looked for as `null`, as `Identifier.tryParse` gives it.
fn read_key(c: Codecs, value: Json, _r: Registries) -> Read {
    let s = match value {
        Json.Str(s) => s.copy(),
        _ => return Read.bad("Not a string: {json_text(value)}"),
    }
    let removed = s.starts_with("!")
    let rest = if removed { s[1..].copy() } else { s.copy() }
    let name = match Identifier.parse(rest) {
        ok(i) => i.to_string(),
        err(_) => return Read.bad(String("No component with type: 'null'")),
    }
    if c.find("component {name}") == none {
        if c.find("transient component {name}") != none {
            return Read.bad("'{name}' is not a persistent component")
        }
        return Read.bad("No component with type: '{name}'")
    }
    return Read.ok(Tag.Str(if removed { "!{name}" } else { name }))
}

// The types `DataComponents` registers that aren't saved, which a patch can't hold.
fn transient_names() -> List<String> {
    return [String("creative_slot_lock"), String("additional_trade_cost"), String("map_post_processing")]
}

// Each type that's saved, by its whole ID, in the order `DataComponents` registers them, with
// its codec.
fn component_codecs(c: mut Codecs) -> List<(String, usize)> {
    let custom = custom_data(mut c)
    let names = text(mut c)
    let enchantments = item_enchantments(mut c)
    let can = adventure_predicate(mut c)
    let ids = id(mut c)
    let flag = bool_codec(mut c)
    let template = item_stack_template(mut c)
    let dye = dye_color(mut c)
    let sounds = sound(mut c)
    let any_unit = unit(mut c)
    let positive = positive_int(mut c)
    let words = string(mut c)
    let damage_types = holder_set(mut c, "minecraft:damage_type")
    let items = holder_set(mut c, "minecraft:item")
    let list: List<(String, usize)> = [
        ("custom_data", custom),
        ("max_stack_size", int_within(mut c, 1, 99)),
        ("max_damage", positive_int(mut c)),
        ("damage", non_negative_int(mut c)),
        ("unbreakable", any_unit),
        ("use_effects", use_effects(mut c)),
        ("custom_name", names),
        ("minimum_attack_charge", float_within(mut c, 0.0f32, 1.0f32, "0.0", "1.0")),
        ("damage_type", fixed(mut c, "minecraft:damage_type")),
        ("item_name", names),
        ("item_model", ids),
        ("lore", c.add(Codec.ListOf(Many { of: names, max: 256 }))),
        ("rarity", c.add(Codec.Names([String("common"), String("uncommon"), String("rare"), String("epic")]))),
        ("enchantments", enchantments),
        ("can_place_on", can),
        ("can_break", can),
        ("attribute_modifiers", not_yet(mut c, "attribute_modifiers")),
        ("custom_model_data", not_yet(mut c, "custom_model_data")),
        ("tooltip_display", not_yet(mut c, "tooltip_display")),
        ("repair_cost", non_negative_int(mut c)),
        ("enchantment_glint_override", flag),
        ("intangible_projectile", any_unit),
        ("food", food(mut c)),
        ("consumable", not_yet(mut c, "consumable")),
        ("use_remainder", template),
        ("use_cooldown", use_cooldown(mut c)),
        ("damage_resistant", record1(mut c, "types", damage_types)),
        ("tool", not_yet(mut c, "tool")),
        ("weapon", weapon(mut c)),
        ("attack_range", attack_range(mut c)),
        ("enchantable", record1(mut c, "value", positive)),
        ("equippable", not_yet(mut c, "equippable")),
        ("repairable", record1(mut c, "items", items)),
        ("glider", any_unit),
        ("tooltip_style", ids),
        ("death_protection", not_yet(mut c, "death_protection")),
        ("blocks_attacks", not_yet(mut c, "blocks_attacks")),
        ("piercing_weapon", piercing_weapon(mut c)),
        ("kinetic_weapon", not_yet(mut c, "kinetic_weapon")),
        ("attack_animation", not_yet(mut c, "attack_animation")),
        ("interact_animation", not_yet(mut c, "interact_animation")),
        ("block_transformer", fixed(mut c, "minecraft:block_transformer")),
        ("villager_food", record1(mut c, "nutrition", positive)),
        ("stored_enchantments", enchantments),
        ("dye", dye),
        ("dyed_color", not_yet(mut c, "dyed_color")),
        ("map_id", i32_codec(mut c)),
        ("map_decorations", not_yet(mut c, "map_decorations")),
        ("charged_projectiles", c.add(Codec.ListOf(Many { of: template, max: 1024 }))),
        ("bundle_contents", c.add(Codec.ListOf(Many { of: template }))),
        ("potion_contents", not_yet(mut c, "potion_contents")),
        ("potion_duration_scale", non_negative_float(mut c)),
        ("suspicious_stew_effects", not_yet(mut c, "suspicious_stew_effects")),
        ("writable_book_content", not_yet(mut c, "writable_book_content")),
        ("written_book_content", not_yet(mut c, "written_book_content")),
        ("trim", not_yet(mut c, "trim")),
        ("debug_stick_state", not_yet(mut c, "debug_stick_state")),
        ("entity_data", not_yet(mut c, "entity_data")),
        ("bucket_entity_data", custom),
        ("block_entity_data", not_yet(mut c, "block_entity_data")),
        ("instrument", not_yet(mut c, "instrument")),
        ("provides_trim_material", not_yet(mut c, "provides_trim_material")),
        ("ominous_bottle_amplifier", int_within(mut c, 0, 4)),
        ("jukebox_playable", not_yet(mut c, "jukebox_playable")),
        ("provides_banner_patterns", holder_set(mut c, "minecraft:banner_pattern")),
        ("recipes", c.add(Codec.ListOf(Many { of: ids }))),
        ("lodestone_tracker", not_yet(mut c, "lodestone_tracker")),
        ("firework_explosion", not_yet(mut c, "firework_explosion")),
        ("fireworks", not_yet(mut c, "fireworks")),
        ("profile", not_yet(mut c, "profile")),
        ("note_block_sound", ids),
        ("banner_patterns", not_yet(mut c, "banner_patterns")),
        ("base_color", dye),
        ("pot_decorations", pot_decorations(mut c, template)),
        ("container", not_yet(mut c, "container")),
        ("block_state", c.add(Codec.MapOf(MapOf { key: words, value: words }))),
        ("bees", not_yet(mut c, "bees")),
        ("sulfur_cube_content", template),
        ("lock", item(mut c)),
        ("container_loot", container_loot(mut c)),
        ("break_sound", sounds),
        ("compostable", not_yet(mut c, "compostable")),
        ("cooking_fuel", not_yet(mut c, "cooking_fuel")),
        ("brewing_fuel", not_yet(mut c, "brewing_fuel")),
        ("mob_visibility", mob_visibility(mut c)),
        ("villager/variant", fixed(mut c, "minecraft:villager_type")),
        ("wolf/variant", fixed(mut c, "minecraft:wolf_variant")),
        ("wolf/sound_variant", fixed(mut c, "minecraft:wolf_sound_variant")),
        ("wolf/collar", dye),
        ("fox/variant", c.add(Codec.Names([String("red"), String("snow")]))),
        ("salmon/size", c.add(Codec.Names([String("small"), String("medium"), String("large")]))),
        ("parrot/variant", c.add(Codec.Names([String("red_blue"), String("blue"), String("green"), String("yellow_blue"), String("gray")]))),
        ("tropical_fish/pattern", tropical_fish_pattern(mut c)),
        ("tropical_fish/base_color", dye),
        ("tropical_fish/pattern_color", dye),
        ("mooshroom/variant", c.add(Codec.Names([String("red"), String("brown")]))),
        ("rabbit/variant", c.add(Codec.Names([String("brown"), String("white"), String("black"), String("white_splotched"), String("gold"), String("salt"), String("evil")]))),
        ("pig/variant", fixed(mut c, "minecraft:pig_variant")),
        ("pig/sound_variant", fixed(mut c, "minecraft:pig_sound_variant")),
        ("cow/variant", fixed(mut c, "minecraft:cow_variant")),
        ("cow/sound_variant", fixed(mut c, "minecraft:cow_sound_variant")),
        ("chicken/variant", fixed(mut c, "minecraft:chicken_variant")),
        ("chicken/sound_variant", fixed(mut c, "minecraft:chicken_sound_variant")),
        ("zombie_nautilus/variant", fixed(mut c, "minecraft:zombie_nautilus_variant")),
        ("frog/variant", fixed(mut c, "minecraft:frog_variant")),
        ("horse/variant", c.add(Codec.Names([String("white"), String("creamy"), String("chestnut"), String("brown"), String("black"), String("gray"), String("dark_brown")]))),
        ("painting/variant", fixed(mut c, "minecraft:painting_variant")),
        ("llama/variant", c.add(Codec.Names([String("creamy"), String("white"), String("brown"), String("gray")]))),
        ("axolotl/variant", c.add(Codec.Names([String("lucy"), String("wild"), String("gold"), String("cyan"), String("blue")]))),
        ("cat/variant", fixed(mut c, "minecraft:cat_variant")),
        ("cat/sound_variant", fixed(mut c, "minecraft:cat_sound_variant")),
        ("cat/collar", dye),
        ("sheep/color", dye),
        ("shulker/color", dye),
        ("provides_pottery_pattern", fixed(mut c, "minecraft:decorated_pot_pattern")),
        ("sign_text_front", not_yet(mut c, "sign_text_front")),
        ("sign_text_back", not_yet(mut c, "sign_text_back")),
        ("waxed", any_unit),
        ("cushion/color", dye),
    ]
    var out = List<(String, usize)>()
    for (name, at) in list {
        out.push(("minecraft:{name}", at))
    }
    return out
}

// `Unit.CODEC` and `Removed.CODEC`, `MapCodec.unitCodec`: any object, written `{}`.
fn unit(c: mut Codecs) -> usize {
    return c.shared(String("unit"), Codec.Record(List<Field>()))
}

// `RegistryCodecs.holder(registry)`, a `RegistryFixedCodec`: an entry of `registry` by its ID.
fn fixed(c: mut Codecs, registry: str) -> usize {
    return c.shared("fixed {registry}", Codec.Holder(HolderCodec { registry: String(registry), inline: none, kind: HolderKind.Fixed }))
}

// `ExtraCodecs.intRange`.
fn int_within(c: mut Codecs, min: i32, max: i32) -> usize {
    return c.add(Codec.Int(IntRange { min: min, max: max, before: "Value must be within range [{min};{max}]: " }))
}

// `ExtraCodecs.floatRange`, with `min` and `max` as `Float.toString` writes them.
fn float_within(c: mut Codecs, min: f32, max: f32, low: str, high: str) -> usize {
    return c.add(Codec.Float(FloatRange { min: min, max: max, checked: true, before: "Value must be within range [{low};{high}]: " }))
}

// DataFixerUpper's `Codec.floatRange`.
fn float_between(c: mut Codecs, min: f32, max: f32, low: str, high: str) -> usize {
    return c.add(Codec.Float(FloatRange { min: min, max: max, checked: true, before: String("Value "), after: " outside of range [{low}:{high}]" }))
}

// `ExtraCodecs.NON_NEGATIVE_FLOAT`.
fn non_negative_float(c: mut Codecs) -> usize {
    return c.shared(String("non_negative_float"), Codec.Float(FloatRange { min: 0.0f32, max: f32.MAX, checked: true, before: String("Value must be non-negative: ") }))
}

// A record of the one field `name`, which must be there.
fn record1(c: mut Codecs, name: str, of: usize) -> usize {
    let fields: List<Field> = [req(String(name), of)]
    return c.add(Codec.Record(fields))
}

// A type Calcite has no codec for yet: whatever's given, it says so.
fn not_yet(c: mut Codecs, name: str) -> usize {
    let any = c.shared(String("any json"), Codec.Custom(read_any))
    return c.add(Codec.Then(Then { of: any, then: unread, with: Tag.Str(String(name)) }))
}

fn read_any(_c: Codecs, _value: Json, _r: Registries) -> Read {
    return Read.ok(Tag.End)
}

fn unread(_c: Codecs, _value: Tag, with: Tag) -> Read {
    let name = match with {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    return Read.bad("Calcite can't read the component minecraft:{name} yet")
}

// `CustomData.CODEC`: a compound, as JSON, or as SNBT text, written as the compound.
fn custom_data(c: mut Codecs) -> usize {
    let key = String("custom data")
    if let at = c.find(key) {
        return at
    }
    let json = c.add(Codec.Custom(read_compound_tag))
    let snbt = snbt_compound(mut c)
    return c.shared(key, Codec.Either(json, snbt))
}

// `DyeColor.CODEC`.
fn dye_color(c: mut Codecs) -> usize {
    let names: List<String> = [
        String("white"), String("orange"), String("magenta"), String("light_blue"), String("yellow"), String("lime"), String("pink"), String("gray"),
        String("light_gray"), String("cyan"), String("purple"), String("blue"), String("brown"), String("green"), String("red"), String("black"),
    ]
    return c.shared(String("dye color"), Codec.Names(names))
}

// `TropicalFish.Pattern.CODEC`.
fn tropical_fish_pattern(c: mut Codecs) -> usize {
    let names: List<String> = [
        String("kob"), String("sunstreak"), String("snooper"), String("dasher"), String("brinely"), String("spotty"),
        String("flopper"), String("stripey"), String("glitter"), String("blockfish"), String("betty"), String("clayfish"),
    ]
    return c.add(Codec.Names(names))
}

// `ItemEnchantments.CODEC`: each enchantment by its ID, with its level, 1 to 255.
fn item_enchantments(c: mut Codecs) -> usize {
    let key = String("item enchantments")
    if let at = c.find(key) {
        return at
    }
    let enchantment = fixed(mut c, "minecraft:enchantment")
    let level = c.add(Codec.Int(IntRange { min: 1, max: 255, before: String("Value "), after: String(" outside of range [1:255]") }))
    return c.shared(key, Codec.MapOf(MapOf { key: enchantment, value: level }))
}

// `AdventureModePredicate.CODEC`: block predicates, at least one, or one alone, which is how a
// list of one is written.
fn adventure_predicate(c: mut Codecs) -> usize {
    let key = String("adventure mode predicate")
    if let at = c.find(key) {
        return at
    }
    let predicate = block(mut c)
    let list = c.add(Codec.ListOf(Many { of: predicate }))
    let some_of = c.add(Codec.Then(Then { of: list, then: one_alone, with: Tag.End }))
    return c.shared(key, Codec.Either(some_of, predicate))
}

// `ExtraCodecs.nonEmptyList`, with a list of one written as its one value, as
// `compactListCodec` writes it.
fn one_alone(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return match value {
        Tag.List(items) => {
            if items.is_empty() {
                Read.bad(String("List must have contents"))
            } else if items.len() == 1 {
                Read.ok(items[0].copy())
            } else {
                Read.ok(value.copy())
            }
        },
        _ => Read.ok(value.copy()),
    }
}

// `UseEffects.CODEC`.
fn use_effects(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let fields: List<Field> = [
        def("can_sprint", flag, Tag.Byte(0i8)),
        def("interact_vibrations", flag, Tag.Byte(1i8)),
        def("speed_multiplier", float_between(mut c, 0.0f32, 1.0f32, "0.0", "1.0"), Tag.Float(0.2f32)),
    ]
    return c.add(Codec.Record(fields))
}

// `FoodProperties.DIRECT_CODEC`.
fn food(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("nutrition", non_negative_int(mut c)),
        req("saturation", f32_codec(mut c)),
        def("can_always_eat", bool_codec(mut c), Tag.Byte(0i8)),
    ]
    return c.add(Codec.Record(fields))
}

// `UseCooldown.CODEC`.
fn use_cooldown(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("seconds", positive_float(mut c)),
        opt("cooldown_group", id(mut c)),
    ]
    return c.add(Codec.Record(fields))
}

// `Weapon.CODEC`.
fn weapon(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        def("item_damage_per_attack", non_negative_int(mut c), Tag.Int(1)),
        def("disable_blocking_for_seconds", non_negative_float(mut c), Tag.Float(0.0f32)),
    ]
    return c.add(Codec.Record(fields))
}

// `AttackRange.CODEC`.
fn attack_range(c: mut Codecs) -> usize {
    let reach = float_within(mut c, 0.0f32, 64.0f32, "0.0", "64.0")
    let fields: List<Field> = [
        def("min_reach", reach, Tag.Float(0.0f32)),
        def("max_reach", reach, Tag.Float(3.0f32)),
        def("min_creative_reach", reach, Tag.Float(0.0f32)),
        def("max_creative_reach", reach, Tag.Float(5.0f32)),
        def("hitbox_margin", float_within(mut c, 0.0f32, 1.0f32, "0.0", "1.0"), Tag.Float(0.3f32)),
        def("mob_factor", float_between(mut c, 0.0f32, 2.0f32, "0.0", "2.0"), Tag.Float(1.0f32)),
    ]
    return c.add(Codec.Record(fields))
}

// `PiercingWeapon.CODEC`.
fn piercing_weapon(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let sounds = sound(mut c)
    let fields: List<Field> = [
        def("deals_knockback", flag, Tag.Byte(1i8)),
        def("dismounts", flag, Tag.Byte(0i8)),
        opt("sound", sounds),
        opt("hit_sound", sounds),
    ]
    return c.add(Codec.Record(fields))
}

// `PotDecorations.CODEC`: the item on each side, each there or not.
fn pot_decorations(c: mut Codecs, template: usize) -> usize {
    let fields: List<Field> = [
        opt("back", template),
        opt("left", template),
        opt("right", template),
        opt("front", template),
    ]
    return c.add(Codec.Record(fields))
}

// `SeededContainerLoot.CODEC`: a loot table by its ID, and its seed.
fn container_loot(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("loot_table", id(mut c)),
        def("seed", i64_codec(mut c), Tag.Long(0i64)),
    ]
    return c.add(Codec.Record(fields))
}

// `MobVisibility.CODEC`.
fn mob_visibility(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("targeting_entity_types", holder_set(mut c, "minecraft:entity_type")),
        req("visibility", float_within(mut c, 0.0f32, 10.0f32, "0.0", "10.0")),
    ]
    return c.add(Codec.Record(fields))
}
