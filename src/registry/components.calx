/// Item components, described for `registry.codec`: each type `DataComponents` registers that's
/// saved, with the codec vanilla reads it with from a data pack and writes it back with, and
/// `DataComponentPatch.CODEC`, the components a stack changes from its item's, which
/// `ItemStackTemplate`, item predicates and the components inside other components hold.
module registry.components

import json.tree.{Json, Member, parse}
import nbt.snbt.{units_of}
import nbt.tag.{Tag}
import registry.builtin.{builtin_entries, builtin_names}
import registry.codec.{Codec, Codecs, Dispatched, Field, FloatRange, HolderCodec, HolderKind, IntRange, Kinds, Many, MapOf, Need, Read, Refs, Then, same}
import registry.codecs.{bool_codec, by_name, def, f32_codec, f64_codec, field, i32_codec, i64_codec, id, inline, item_stack_template, non_negative_int, not_air, opt, positive_float, positive_int, component_of, read_compound_tag, registry_codec, req, rgb_int, sound, string, text, uuid, vec3i}
import registry.predicates.{block, holder_set, item, snbt_compound}
import registry.registries.{Registries}
import registry.streams.{WireStack}
import resources.identifier.{Identifier}
import world.blocks.{block_properties, property_names, property_starts}
import world.item_defaults.{block_named_items, item_patches, shared_components}

/// `DataComponentPatch.CODEC`, made in `c`: an object whose keys are component types, each the
/// component's value, or with `!` before it, `{}`, the component taken away. Written with each
/// type's whole ID. It's named `component patch`, so codecs made before it, such as
/// `ItemStackTemplate`'s, find it as they read. `DataComponentType.VALUE_MAP_CODEC`, the
/// components an item predicate wants exactly, is made with it, named `component map`.
pub fn component_patch(c: mut Codecs) -> usize {
    return c.named(String("component patch"), make_patch)
}

fn make_patch(c: mut Codecs) -> Codec {
    let key = c.add(Codec.Custom(read_key))
    // `Removed.CODEC`, `MapCodec.unitCodec`: any object, written `{}`.
    let removed = unit(mut c)
    var values = List<(String, usize)>()
    var exact = List<(String, usize)>()
    for (name, at) in component_codecs(mut c) {
        c.name("component {name}", at)
        values.push(("!{name}", removed))
        values.push((name.copy(), at))
        exact.push((name.copy(), at))
    }
    for name in transient_names() {
        c.name("transient component minecraft:{name}", removed)
    }
    let map_key = c.add(Codec.Custom(read_map_key))
    let map = c.add(Codec.Dispatched(Dispatched { key: map_key, values: exact }))
    c.name(String("component map"), map)
    return Codec.Dispatched(Dispatched { key: key, values: values })
}

// `DataComponentType.PERSISTENT_CODEC`: a type by its ID, which must be one that's saved.
fn read_map_key(c: Codecs, value: Json, _r: Registries) -> Read {
    let s = match value {
        Json.Str(s) => s.copy(),
        _ => return Read.bad(c.not_string(value)),
    }
    let name = match Identifier.parse(s.copy()) {
        ok(i) => i.to_string(),
        err(e) => return Read.bad("Not a valid resource location: {s} {e}"),
    }
    if c.find("component {name}") == none {
        if c.find("transient component {name}") != none {
            return Read.bad("Encountered transient component {name}")
        }
        return Read.bad("Unknown registry key in ResourceKey[minecraft:root / minecraft:data_component_type]: {name}")
    }
    return Read.ok(Tag.Str(name))
}

/// `ItemStack.CODEC`, made in `c`: an item, which can't be air, how many, from 1 to 99 and
/// always written, and the components the stack changes from its item's. It doesn't check the
/// count against the item's stack size: `validateStrict` does that, where vanilla asks for it.
pub fn item_stack(c: mut Codecs) -> usize {
    let key = String("item stack")
    if let at = c.find(key) {
        return at
    }
    let items = by_name(mut c, "minecraft:item")
    let one = c.add(Codec.Then(Then { of: items, then: not_air, with: Tag.End }))
    let count = int_within(mut c, 1, 99)
    let patch = component_patch(mut c)
    let fields: List<Field> = [
        req("id", one),
        Field { name: "count", of: count, need: Need.Always(Tag.Int(1)) },
        def("components", patch, Tag.Compound(JavaHashMap<String, Tag>())),
    ]
    let record = c.add(Codec.Record(fields))
    c.name(String("item stack record"), record)
    return c.shared(key, Codec.Nested(read_item_stack))
}

// The stack's record, with its patch as `PatchedDataComponentMap.applyPatch` leaves it, applied
// to the item's default components as the stack is made: a component the same as the item's own
// is left out, and so is one taken away that the item hasn't. What's left keeps the order its
// keys were given in, as the patch's array map keeps it, so a compound written from it has its
// keys in vanilla's order. Where the item's defaults haven't been read, the patch is as given.
fn read_item_stack(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    let at = c.find(String("item stack record")) else return Read.bad(String("there's no item stack codec"))
    var got = c.read(at, value, r, mut refs)
    let read = got.value.take() else return got
    got.value = some(against_defaults(c, read, value, r))
    return got
}

fn against_defaults(c: Codecs, value: Tag, json: Json, r: Registries) -> Tag {
    var fields = match value {
        Tag.Compound(m) => m.copy(),
        _ => return value.copy(),
    }
    if not fields.contains(String("components")) {
        return value.copy()
    }
    let item_id = match fields[String("id")] {
        Tag.Str(s) => s.copy(),
        _ => return value.copy(),
    }
    if not c.item_defaults.contains(item_id.copy()) {
        return value.copy()
    }
    let defaults = match c.item_defaults[item_id] {
        Tag.Compound(m) => m.copy(),
        _ => return value.copy(),
    }
    let patch = match fields[String("components")] {
        Tag.Compound(m) => m.copy(),
        _ => return value.copy(),
    }
    let given = match field_of(json, "components") {
        some(Json.Object(m)) => m,
        _ => return value.copy(),
    }
    var kept = JavaHashMap<String, Tag>()
    for m in given {
        let k = match read_key(c, Json.Str(m.key.copy()), r).value {
            some(Tag.Str(s)) => s,
            _ => continue,
        }
        if not patch.contains(k.copy()) or kept.contains(k.copy()) {
            continue
        }
        let v = patch[k.copy()].copy()
        if k.starts_with("!") {
            if defaults.contains(k[1..].copy()) {
                kept.insert(k.copy(), v)
            }
        } else if not defaults.contains(k.copy()) or not same(defaults[k.copy()], v) {
            kept.insert(k.copy(), v)
        }
    }
    if kept.is_empty() {
        _ = fields.remove(String("components"))
    } else {
        fields.insert(String("components"), Tag.Compound(kept))
    }
    return Tag.Compound(fields)
}

/// A stack off the network, made as vanilla makes it: its patch applied to its item's default
/// components, and what `ItemStack.CODEC` would write of it.
pub struct Applied {
    /// The patch left, in its order, each type's whole ID, or `!` and the ID of one taken away,
    /// with its value as its codec writes it, or as the network gave it where the codec doesn't
    /// read it, to send it again.
    pub patch: List<(String, Tag)>
    /// The stack as `ItemStack.CODEC` writes it, or `none` where it can't.
    pub nbt: Tag?
    /// Why `ItemStack.CODEC` can't write it: a count or a value its codec doesn't take.
    pub error: String?
}

/// The stack `s` off the network, made as `ItemStack`'s constructor makes it (D364). The patch
/// is an array map, so a type given twice keeps the first's place and the second's value, and
/// `applyPatch` leaves out a value the same as the item's own and a type taken away that it
/// hasn't. Vanilla holds a value as the network gave it whether or not its codec takes it, so
/// each is read with its codec only to compare it with the item's and to write the NBT, which
/// a value the codec doesn't take, or a count that isn't 1 to 99, stops.
pub fn apply_wire(c: Codecs, s: WireStack, r: Registries) -> Applied {
    var keys = List<String>()
    var values = List<Tag?>()
    for (k, v) in s.patch {
        var found = false
        for i in 0..keys.len() {
            if keys[i] == k {
                values[i] = v.copy()
                found = true
            }
        }
        if not found {
            keys.push(k.copy())
            values.push(v.copy())
        }
    }
    var defaults = JavaHashMap<String, Tag>()
    if c.item_defaults.contains(s.item.copy()) {
        match c.item_defaults[s.item.copy()] {
            Tag.Compound(m) => defaults = m.copy(),
            _ => {},
        }
    }
    var patch = List<(String, Tag)>()
    var written = JavaHashMap<String, Tag>()
    var error: String? = none
    if s.count < 1 or s.count > 99 {
        error = some("Value must be within range [1;99]: {s.count}")
    }
    for i in 0..keys.len() {
        let k = keys[i].copy()
        match values[i] {
            none => {
                if defaults.contains(k.copy()) {
                    patch.push(("!{k}", Tag.Compound(JavaHashMap<String, Tag>())))
                    written.insert("!{k}", Tag.Compound(JavaHashMap<String, Tag>()))
                }
            },
            some(v) => {
                var refs = Refs.new()
                let at = c.find("component {k}") else {
                    patch.push((k.copy(), v.copy()))
                    if error == none {
                        error = some("Encountered transient component {k}")
                    }
                    continue
                }
                var got = c.read(at, v.to_typed_json(), r, mut refs)
                if let e = got.error.take() {
                    patch.push((k.copy(), v.copy()))
                    if error == none {
                        error = some(e)
                    }
                    continue
                }
                let form = got.value.take() ?? Tag.End
                if defaults.contains(k.copy()) and same(defaults[k.copy()], form) {
                    continue
                }
                patch.push((k.copy(), form.copy()))
                written.insert(k.copy(), form)
            },
        }
    }
    if error != none {
        return Applied { patch: patch, nbt: none, error: error }
    }
    var stack = JavaHashMap<String, Tag>()
    stack.insert(String("id"), Tag.Str(s.item.copy()))
    stack.insert(String("count"), Tag.Int(s.count))
    if not written.is_empty() {
        stack.insert(String("components"), Tag.Compound(written))
    }
    return Applied { patch: patch, nbt: some(Tag.Compound(stack)), error: none }
}

/// The order of the patch of `stack`, a stack `item_stack` read from `json`: its components'
/// whole IDs, `!` before one taken away, in the order `json` gave them, as the patch's array map
/// keeps them, which `DataComponentPatch.STREAM_CODEC` sends them in (D364).
pub fn patch_order(c: Codecs, stack: Tag, json: Json, r: Registries) -> List<String> {
    var out = List<String>()
    let patch = match stack {
        Tag.Compound(m) => {
            if not m.contains(String("components")) {
                return out
            }
            match m[String("components")] {
                Tag.Compound(p) => p.copy(),
                _ => return out,
            }
        },
        _ => return out,
    }
    let given = match field_of(json, "components") {
        some(Json.Object(m)) => m,
        _ => return out,
    }
    for m in given {
        let k = match read_key(c, Json.Str(m.key.copy()), r).value {
            some(Tag.Str(s)) => s,
            _ => continue,
        }
        if patch.contains(k.copy()) and not out.contains(k) {
            out.push(k)
        }
    }
    return out
}

// The member `name` of `value`, an object, or none.
fn field_of(value: Json, name: str) -> Json? {
    match value {
        Json.Object(members) => {
            for m in members {
                if m.key == String(name) {
                    return some(m.value.copy())
                }
            }
        },
        _ => {},
    }
    return none
}

/// Each item's default components, by its ID, as the component map, `DataComponentType`'s
/// `VALUE_MAP_CODEC`, reads them from `world.item_defaults` with `c`, which `component_patch`
/// has made the map in: a compound of each type's ID and its value. Fails where one doesn't read,
/// which can only be a broken build.
pub fn read_item_defaults(c: Codecs, r: Registries) -> Map<String, Tag> ! String {
    let at = c.find(String("component map")) else fail String("there's no component map codec")
    let b = r.find_builtin(String("item")) else fail String("there's no item registry")
    let names = r.builtin[b].entries.copy()
    let patches = item_patches()
    if names.len() != patches.len() {
        fail "the item registry has {names.len()} items, and their defaults {patches.len()}"
    }
    let shared = match parse(String(shared_components())) {
        some(Json.Object(m)) => m,
        _ => fail String("the shared default components aren't a JSON object"),
    }
    let blocks = block_named_items()
    var next_block: usize = 0
    var out = Map<String, Tag>()
    for i in 0..names.len() {
        let name = names[i].copy()
        var prefix = "item"
        if next_block < blocks.len() and usize(blocks[next_block]) == i {
            prefix = "block"
            next_block += 1
        }
        var members = shared.copy()
        members.push(Member { key: String("minecraft:item_model"), value: Json.Str(name.to_string()) })
        let translate: List<Member> = [Member { key: String("translate"), value: Json.Str("{prefix}.minecraft.{name.path}") }]
        members.push(Member { key: String("minecraft:item_name"), value: Json.Object(translate) })
        let given = match parse(String(patches[i])) {
            some(Json.Object(m)) => m,
            _ => fail "{name.to_string()}'s default components aren't a JSON object",
        }
        for m in given {
            let taken = m.key.starts_with("!")
            let key = if taken { m.key[1..].copy() } else { m.key.copy() }
            var kept = List<Member>()
            for each in members {
                if each.key != key {
                    kept.push(Member { key: each.key.copy(), value: each.value.copy() })
                }
            }
            if not taken {
                kept.push(Member { key: key, value: m.value.copy() })
            }
            members = kept
        }
        var refs = Refs.new()
        var got = c.read(at, Json.Object(members), r, mut refs)
        if let e = got.error.take() {
            fail "{name.to_string()}'s default components don't read: {e}"
        }
        out.insert(name.to_string(), got.value.take() ?? Tag.End)
    }
    return out
}

// `PatchKey.CODEC`: a type's ID, with `!` before it for one taken away, which must be a type that's
// saved. One that doesn't parse is looked for as `null`, as `Identifier.tryParse` gives it.
fn read_key(c: Codecs, value: Json, _r: Registries) -> Read {
    let s = match value {
        Json.Str(s) => s.copy(),
        _ => return Read.bad(c.not_string(value)),
    }
    let removed = s.starts_with("!")
    let rest = if removed { s[1..].copy() } else { s.copy() }
    let name = match Identifier.parse(rest) {
        ok(i) => i.to_string(),
        err(_) => return Read.bad(String("No component with type: 'null'")),
    }
    if c.find("component {name}") == none {
        if c.find("transient component {name}") != none {
            return Read.bad("'{name}' is not a persistent component")
        }
        return Read.bad("No component with type: '{name}'")
    }
    return Read.ok(Tag.Str(if removed { "!{name}" } else { name }))
}

// The types `DataComponents` registers that aren't saved, which a patch can't hold.
fn transient_names() -> List<String> {
    return [String("creative_slot_lock"), String("additional_trade_cost"), String("map_post_processing")]
}

// Each type that's saved, by its whole ID, in the order `DataComponents` registers them, with
// its codec.
fn component_codecs(c: mut Codecs) -> List<(String, usize)> {
    let custom = custom_data(mut c)
    let names = text(mut c)
    let enchantments = item_enchantments(mut c)
    let can = adventure_predicate(mut c)
    let ids = id(mut c)
    let flag = bool_codec(mut c)
    let template = item_stack_template(mut c)
    let dye = dye_color(mut c)
    let sounds = sound(mut c)
    let any_unit = unit(mut c)
    let positive = positive_int(mut c)
    let words = string(mut c)
    let damage_types = holder_set(mut c, "minecraft:damage_type")
    let items = holder_set(mut c, "minecraft:item")
    let swing = swing_animation(mut c)
    let resolvable = resolvable_int(mut c)
    let list: List<(String, usize)> = [
        ("custom_data", custom),
        ("max_stack_size", int_within(mut c, 1, 99)),
        ("max_damage", positive_int(mut c)),
        ("damage", non_negative_int(mut c)),
        ("unbreakable", any_unit),
        ("use_effects", use_effects(mut c)),
        ("custom_name", names),
        ("minimum_attack_charge", float_within(mut c, 0.0f32, 1.0f32, "0.0", "1.0")),
        ("damage_type", fixed(mut c, "minecraft:damage_type")),
        ("item_name", names),
        ("item_model", ids),
        ("lore", c.add(Codec.ListOf(Many { of: names, max: 256 }))),
        ("rarity", c.add(Codec.Names([String("common"), String("uncommon"), String("rare"), String("epic")]))),
        ("enchantments", enchantments),
        ("can_place_on", can),
        ("can_break", can),
        ("attribute_modifiers", attribute_modifiers(mut c)),
        ("custom_model_data", custom_model_data(mut c)),
        ("tooltip_display", tooltip_display(mut c)),
        ("repair_cost", non_negative_int(mut c)),
        ("enchantment_glint_override", flag),
        ("intangible_projectile", any_unit),
        ("food", food(mut c)),
        ("consumable", consumable(mut c)),
        ("use_remainder", template),
        ("use_cooldown", use_cooldown(mut c)),
        ("damage_resistant", record1(mut c, "types", damage_types)),
        ("tool", tool(mut c)),
        ("weapon", weapon(mut c)),
        ("attack_range", attack_range(mut c)),
        ("enchantable", record1(mut c, "value", positive)),
        ("equippable", equippable(mut c)),
        ("repairable", record1(mut c, "items", items)),
        ("glider", any_unit),
        ("tooltip_style", ids),
        ("death_protection", death_protection(mut c)),
        ("blocks_attacks", blocks_attacks(mut c)),
        ("piercing_weapon", piercing_weapon(mut c)),
        ("kinetic_weapon", kinetic_weapon(mut c)),
        ("attack_animation", swing),
        ("interact_animation", swing),
        ("block_transformer", fixed(mut c, "minecraft:block_transformer")),
        ("villager_food", record1(mut c, "nutrition", positive)),
        ("stored_enchantments", enchantments),
        ("dye", dye),
        ("dyed_color", rgb_int(mut c)),
        ("map_id", i32_codec(mut c)),
        ("map_decorations", map_decorations(mut c)),
        ("charged_projectiles", c.add(Codec.ListOf(Many { of: template, max: 1024 }))),
        ("bundle_contents", c.add(Codec.ListOf(Many { of: template }))),
        ("potion_contents", potion_contents(mut c)),
        ("potion_duration_scale", non_negative_float(mut c)),
        ("suspicious_stew_effects", stew_effects(mut c)),
        ("writable_book_content", writable_book_content(mut c)),
        ("written_book_content", written_book_content(mut c)),
        ("trim", trim(mut c)),
        ("debug_stick_state", debug_stick_state(mut c)),
        ("entity_data", entity_data(mut c)),
        ("bucket_entity_data", custom),
        ("block_entity_data", block_entity_data(mut c)),
        ("instrument", inline_holder(mut c, "instrument")),
        ("provides_trim_material", inline_holder(mut c, "trim_material")),
        ("ominous_bottle_amplifier", int_within(mut c, 0, 4)),
        ("jukebox_playable", fixed(mut c, "minecraft:jukebox_song")),
        ("provides_banner_patterns", holder_set(mut c, "minecraft:banner_pattern")),
        ("recipes", c.add(Codec.ListOf(Many { of: ids }))),
        ("lodestone_tracker", lodestone_tracker(mut c)),
        ("firework_explosion", firework_explosion(mut c)),
        ("fireworks", fireworks(mut c)),
        ("profile", profile(mut c)),
        ("note_block_sound", ids),
        ("banner_patterns", banner_patterns(mut c)),
        ("base_color", dye),
        ("pot_decorations", pot_decorations(mut c, template)),
        ("container", container(mut c, template)),
        ("block_state", c.add(Codec.MapOf(MapOf { key: words, value: words }))),
        ("bees", bees(mut c)),
        ("sulfur_cube_content", template),
        ("lock", item(mut c)),
        ("container_loot", container_loot(mut c)),
        ("break_sound", sounds),
        ("compostable", record1(mut c, "layers", resolvable)),
        ("cooking_fuel", fuel(mut c, "burn_time")),
        ("brewing_fuel", fuel(mut c, "uses")),
        ("mob_visibility", mob_visibility(mut c)),
        ("villager/variant", fixed(mut c, "minecraft:villager_type")),
        ("wolf/variant", fixed(mut c, "minecraft:wolf_variant")),
        ("wolf/sound_variant", fixed(mut c, "minecraft:wolf_sound_variant")),
        ("wolf/collar", dye),
        ("fox/variant", c.add(Codec.Names([String("red"), String("snow")]))),
        ("salmon/size", c.add(Codec.Names([String("small"), String("medium"), String("large")]))),
        ("parrot/variant", c.add(Codec.Names([String("red_blue"), String("blue"), String("green"), String("yellow_blue"), String("gray")]))),
        ("tropical_fish/pattern", tropical_fish_pattern(mut c)),
        ("tropical_fish/base_color", dye),
        ("tropical_fish/pattern_color", dye),
        ("mooshroom/variant", c.add(Codec.Names([String("red"), String("brown")]))),
        ("rabbit/variant", c.add(Codec.Names([String("brown"), String("white"), String("black"), String("white_splotched"), String("gold"), String("salt"), String("evil")]))),
        ("pig/variant", fixed(mut c, "minecraft:pig_variant")),
        ("pig/sound_variant", fixed(mut c, "minecraft:pig_sound_variant")),
        ("cow/variant", fixed(mut c, "minecraft:cow_variant")),
        ("cow/sound_variant", fixed(mut c, "minecraft:cow_sound_variant")),
        ("chicken/variant", fixed(mut c, "minecraft:chicken_variant")),
        ("chicken/sound_variant", fixed(mut c, "minecraft:chicken_sound_variant")),
        ("zombie_nautilus/variant", fixed(mut c, "minecraft:zombie_nautilus_variant")),
        ("frog/variant", fixed(mut c, "minecraft:frog_variant")),
        ("horse/variant", c.add(Codec.Names([String("white"), String("creamy"), String("chestnut"), String("brown"), String("black"), String("gray"), String("dark_brown")]))),
        ("painting/variant", fixed(mut c, "minecraft:painting_variant")),
        ("llama/variant", c.add(Codec.Names([String("creamy"), String("white"), String("brown"), String("gray")]))),
        ("axolotl/variant", c.add(Codec.Names([String("lucy"), String("wild"), String("gold"), String("cyan"), String("blue")]))),
        ("cat/variant", fixed(mut c, "minecraft:cat_variant")),
        ("cat/sound_variant", fixed(mut c, "minecraft:cat_sound_variant")),
        ("cat/collar", dye),
        ("sheep/color", dye),
        ("shulker/color", dye),
        ("provides_pottery_pattern", fixed(mut c, "minecraft:decorated_pot_pattern")),
        ("sign_text_front", sign_text(mut c)),
        ("sign_text_back", sign_text(mut c)),
        ("waxed", any_unit),
        ("cushion/color", dye),
    ]
    var out = List<(String, usize)>()
    for (name, at) in list {
        out.push(("minecraft:{name}", at))
    }
    return out
}

// `Unit.CODEC` and `Removed.CODEC`, `MapCodec.unitCodec`: any object, written `{}`.
fn unit(c: mut Codecs) -> usize {
    return c.shared(String("unit"), Codec.Record(List<Field>()))
}

// `RegistryCodecs.holder(registry)`, a `RegistryFixedCodec`: an entry of `registry` by its ID.
fn fixed(c: mut Codecs, registry: str) -> usize {
    return c.shared("fixed {registry}", Codec.Holder(HolderCodec { registry: String(registry), inline: none, kind: HolderKind.Fixed }))
}

// `ExtraCodecs.intRange`.
fn int_within(c: mut Codecs, min: i32, max: i32) -> usize {
    return c.add(Codec.Int(IntRange { min: min, max: max, before: "Value must be within range [{min};{max}]: " }))
}

// `ExtraCodecs.floatRange`, with `min` and `max` as `Float.toString` writes them.
fn float_within(c: mut Codecs, min: f32, max: f32, low: str, high: str) -> usize {
    return c.add(Codec.Float(FloatRange { min: min, max: max, checked: true, before: "Value must be within range [{low};{high}]: " }))
}

// DataFixerUpper's `Codec.floatRange`.
fn float_between(c: mut Codecs, min: f32, max: f32, low: str, high: str) -> usize {
    return c.add(Codec.Float(FloatRange { min: min, max: max, checked: true, before: String("Value "), after: " outside of range [{low}:{high}]" }))
}

// `ExtraCodecs.NON_NEGATIVE_FLOAT`.
fn non_negative_float(c: mut Codecs) -> usize {
    return c.shared(String("non_negative_float"), Codec.Float(FloatRange { min: 0.0f32, max: f32.MAX, checked: true, before: String("Value must be non-negative: ") }))
}

// A record of the one field `name`, which must be there.
fn record1(c: mut Codecs, name: str, of: usize) -> usize {
    let fields: List<Field> = [req(String(name), of)]
    return c.add(Codec.Record(fields))
}

// `CustomData.CODEC`: a compound, as JSON, or as SNBT text, written as the compound.
fn custom_data(c: mut Codecs) -> usize {
    let key = String("custom data")
    if let at = c.find(key) {
        return at
    }
    let json = c.add(Codec.Custom(read_compound_tag))
    let snbt = snbt_compound(mut c)
    return c.shared(key, Codec.Either(json, snbt))
}

// `DyeColor.CODEC`.
fn dye_color(c: mut Codecs) -> usize {
    let names: List<String> = [
        String("white"), String("orange"), String("magenta"), String("light_blue"), String("yellow"), String("lime"), String("pink"), String("gray"),
        String("light_gray"), String("cyan"), String("purple"), String("blue"), String("brown"), String("green"), String("red"), String("black"),
    ]
    return c.shared(String("dye color"), Codec.Names(names))
}

// `TropicalFish.Pattern.CODEC`.
fn tropical_fish_pattern(c: mut Codecs) -> usize {
    let names: List<String> = [
        String("kob"), String("sunstreak"), String("snooper"), String("dasher"), String("brinely"), String("spotty"),
        String("flopper"), String("stripey"), String("glitter"), String("blockfish"), String("betty"), String("clayfish"),
    ]
    return c.add(Codec.Names(names))
}

// `ItemEnchantments.CODEC`: each enchantment by its ID, with its level, 1 to 255.
fn item_enchantments(c: mut Codecs) -> usize {
    let key = String("item enchantments")
    if let at = c.find(key) {
        return at
    }
    let enchantment = fixed(mut c, "minecraft:enchantment")
    let level = c.add(Codec.Int(IntRange { min: 1, max: 255, before: String("Value "), after: String(" outside of range [1:255]") }))
    return c.shared(key, Codec.MapOf(MapOf { key: enchantment, value: level }))
}

// `AdventureModePredicate.CODEC`: block predicates, at least one, or one alone, which is how a
// list of one is written.
fn adventure_predicate(c: mut Codecs) -> usize {
    let key = String("adventure mode predicate")
    if let at = c.find(key) {
        return at
    }
    let predicate = block(mut c)
    let list = c.add(Codec.ListOf(Many { of: predicate }))
    let some_of = c.add(Codec.Then(Then { of: list, then: one_alone, with: Tag.End }))
    return c.shared(key, Codec.Either(some_of, predicate))
}

// `ExtraCodecs.nonEmptyList`, with a list of one written as its one value, as
// `compactListCodec` writes it.
fn one_alone(_c: Codecs, value: Tag, _with: Tag) -> Read {
    return match value {
        Tag.List(items) => {
            if items.is_empty() {
                Read.bad(String("List must have contents"))
            } else if items.len() == 1 {
                Read.ok(items[0].copy())
            } else {
                Read.ok(value.copy())
            }
        },
        _ => Read.ok(value.copy()),
    }
}

// `UseEffects.CODEC`.
fn use_effects(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let fields: List<Field> = [
        def("can_sprint", flag, Tag.Byte(0i8)),
        def("interact_vibrations", flag, Tag.Byte(1i8)),
        def("speed_multiplier", float_between(mut c, 0.0f32, 1.0f32, "0.0", "1.0"), Tag.Float(0.2f32)),
    ]
    return c.add(Codec.Record(fields))
}

// `FoodProperties.DIRECT_CODEC`.
fn food(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("nutrition", non_negative_int(mut c)),
        req("saturation", f32_codec(mut c)),
        def("can_always_eat", bool_codec(mut c), Tag.Byte(0i8)),
    ]
    return c.add(Codec.Record(fields))
}

// `UseCooldown.CODEC`.
fn use_cooldown(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("seconds", positive_float(mut c)),
        opt("cooldown_group", id(mut c)),
    ]
    return c.add(Codec.Record(fields))
}

// `Weapon.CODEC`.
fn weapon(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        def("item_damage_per_attack", non_negative_int(mut c), Tag.Int(1)),
        def("disable_blocking_for_seconds", non_negative_float(mut c), Tag.Float(0.0f32)),
    ]
    return c.add(Codec.Record(fields))
}

// `AttackRange.CODEC`.
fn attack_range(c: mut Codecs) -> usize {
    let reach = float_within(mut c, 0.0f32, 64.0f32, "0.0", "64.0")
    let fields: List<Field> = [
        def("min_reach", reach, Tag.Float(0.0f32)),
        def("max_reach", reach, Tag.Float(3.0f32)),
        def("min_creative_reach", reach, Tag.Float(0.0f32)),
        def("max_creative_reach", reach, Tag.Float(5.0f32)),
        def("hitbox_margin", float_within(mut c, 0.0f32, 1.0f32, "0.0", "1.0"), Tag.Float(0.3f32)),
        def("mob_factor", float_between(mut c, 0.0f32, 2.0f32, "0.0", "2.0"), Tag.Float(1.0f32)),
    ]
    return c.add(Codec.Record(fields))
}

// `PiercingWeapon.CODEC`.
fn piercing_weapon(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let sounds = sound(mut c)
    let fields: List<Field> = [
        def("deals_knockback", flag, Tag.Byte(1i8)),
        def("dismounts", flag, Tag.Byte(0i8)),
        opt("sound", sounds),
        opt("hit_sound", sounds),
    ]
    return c.add(Codec.Record(fields))
}

// `PotDecorations.CODEC`: the item on each side, each there or not.
fn pot_decorations(c: mut Codecs, template: usize) -> usize {
    let fields: List<Field> = [
        opt("back", template),
        opt("left", template),
        opt("right", template),
        opt("front", template),
    ]
    return c.add(Codec.Record(fields))
}

// `SeededContainerLoot.CODEC`: a loot table by its ID, and its seed.
fn container_loot(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("loot_table", id(mut c)),
        def("seed", i64_codec(mut c), Tag.Long(0i64)),
    ]
    return c.add(Codec.Record(fields))
}

// `MobVisibility.CODEC`.
fn mob_visibility(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("targeting_entity_types", holder_set(mut c, "minecraft:entity_type")),
        req("visibility", float_within(mut c, 0.0f32, 10.0f32, "0.0", "10.0")),
    ]
    return c.add(Codec.Record(fields))
}

// A registry's entry by its ID, or given in full with the registry's own codec, a
// `RegistryFileCodec`, as trims, instruments and banner patterns take theirs.
fn inline_holder(c: mut Codecs, name: str) -> usize {
    let direct = registry_codec(mut c, String(name))
    return c.add(Codec.Holder(HolderCodec { registry: "minecraft:{name}", inline: direct, kind: HolderKind.File }))
}

// `ExtraCodecs.UNSIGNED_BYTE`: a number, kept as the byte it makes, so 0 to 255 read back the same.
fn unsigned_byte(c: mut Codecs) -> usize {
    return c.shared(String("unsigned byte"), Codec.Custom(read_unsigned_byte))
}

fn read_unsigned_byte(c: Codecs, value: Json, _r: Registries) -> Read {
    let v = c.int_of(value) else return Read.bad(c.not_number(value))
    return Read.ok(Tag.Byte(i8.wrap(v)))
}

// `ItemAttributeModifiers.CODEC`: each modifier, the attribute it changes, its ID, amount and
// operation, the slots it's for, and how it's shown.
fn attribute_modifiers(c: mut Codecs) -> usize {
    let operations = c.add(Codec.Names(["add_value", "add_multiplied_base", "add_multiplied_total"]))
    let slots = c.add(Codec.Names(["any", "mainhand", "offhand", "hand", "feet", "legs", "chest", "head", "armor", "body", "saddle"]))
    let shown = modifier_display(mut c)
    var by_default = JavaHashMap<String, Tag>()
    by_default.insert(String("type"), Tag.Str(String("default")))
    let fields: List<Field> = [
        req("type", by_name(mut c, "minecraft:attribute")),
        req("id", id(mut c)),
        req("amount", f64_codec(mut c)),
        req("operation", operations),
        def("slot", slots, Tag.Str(String("any"))),
        def("display", shown, Tag.Compound(by_default)),
    ]
    let entry = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: entry }))
}

// `ItemAttributeModifiers.Display.CODEC`: shown as vanilla shows it, hidden, or as the text given.
fn modifier_display(c: mut Codecs) -> usize {
    let types = c.add(Codec.Names(["default", "hidden", "override"]))
    let nothing = unit(mut c)
    let override_fields: List<Field> = [req("value", text(mut c))]
    let kinds: List<(String, usize)> = [
        ("default", nothing),
        ("hidden", nothing),
        ("override", c.add(Codec.Record(override_fields))),
    ]
    return c.add(Codec.Dispatch(Kinds { key: "type", by: types, kinds: kinds }))
}

// `CustomModelData.CODEC`.
fn custom_model_data(c: mut Codecs) -> usize {
    let one_float = f32_codec(mut c)
    let floats = c.add(Codec.ListOf(Many { of: one_float }))
    let one_flag = bool_codec(mut c)
    let flags = c.add(Codec.ListOf(Many { of: one_flag }))
    let one_string = string(mut c)
    let strings = c.add(Codec.ListOf(Many { of: one_string }))
    let one_color = rgb_int(mut c)
    let colors = c.add(Codec.ListOf(Many { of: one_color }))
    let fields: List<Field> = [
        def("floats", floats, Tag.List(List<Tag>())),
        def("flags", flags, Tag.List(List<Tag>())),
        def("strings", strings, Tag.List(List<Tag>())),
        def("colors", colors, Tag.List(List<Tag>())),
    ]
    return c.add(Codec.Record(fields))
}

// `MobEffectInstance.CODEC`: an effect by its ID, with its details.
fn effect_instance(c: mut Codecs) -> usize {
    return c.named(String("mob effect instance"), make_effect_instance)
}

fn make_effect_instance(c: mut Codecs) -> Codec {
    let effect = by_name(mut c, "minecraft:mob_effect")
    let fields = effect_fields(mut c, some(effect))
    let record = c.add(Codec.Record(fields))
    return Codec.Then(Then { of: record, then: icon_follows_particles, with: Tag.End })
}

// `MobEffectInstance.Details.MAP_CODEC`, which holds itself as the effect it hides.
fn effect_details(c: mut Codecs) -> usize {
    return c.named(String("mob effect details"), make_effect_details)
}

fn make_effect_details(c: mut Codecs) -> Codec {
    let fields = effect_fields(mut c, none)
    let record = c.add(Codec.Record(fields))
    return Codec.Then(Then { of: record, then: icon_follows_particles, with: Tag.End })
}

// The details' fields, after the effect's ID where there's one.
fn effect_fields(c: mut Codecs, effect: usize?) -> List<Field> {
    let flag = bool_codec(mut c)
    let hidden = effect_details(mut c)
    var fields = List<Field>()
    if let e = effect {
        fields.push(req("id", e))
    }
    fields.push(def("amplifier", unsigned_byte(mut c), Tag.Byte(0i8)))
    fields.push(def("duration", i32_codec(mut c), Tag.Int(0)))
    fields.push(def("ambient", flag, Tag.Byte(0i8)))
    fields.push(def("show_particles", flag, Tag.Byte(1i8)))
    fields.push(opt("show_icon", flag))
    fields.push(opt("hidden_effect", hidden))
    return fields
}

// `Details.create`: an icon shown as the particles are where it isn't given, and always written,
// each field put in the order the record writes them, as a compound's keys that share a bucket
// keep it.
fn icon_follows_particles(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let fields = match value {
        Tag.Compound(m) => m.copy(),
        _ => return Read.ok(value.copy()),
    }
    var icon = field(value, String("show_icon"))
    if icon == Tag.End {
        let particles = field(value, String("show_particles"))
        icon = if particles == Tag.End { Tag.Byte(1i8) } else { particles }
    }
    var out = JavaHashMap<String, Tag>()
    let order: List<String> = [String("id"), String("amplifier"), String("duration"), String("ambient"), String("show_particles"), String("show_icon"), String("hidden_effect")]
    for key in order {
        if key == "show_icon" {
            out.insert(key.copy(), icon.copy())
        } else if fields.contains(key.copy()) {
            out.insert(key.copy(), field(value, key.copy()))
        }
    }
    return Read.ok(Tag.Compound(out))
}

// `ConsumeEffect.CODEC`: what eating or drinking an item does, by its type.
fn consume_effect(c: mut Codecs) -> usize {
    return c.named(String("consume effect"), make_consume_effect)
}

fn make_consume_effect(c: mut Codecs) -> Codec {
    let instance = effect_instance(mut c)
    let effects = c.add(Codec.ListOf(Many { of: instance }))
    let apply_fields: List<Field> = [
        req("effects", effects),
        def("probability", float_between(mut c, 0.0f32, 1.0f32, "0.0", "1.0"), Tag.Float(1.0f32)),
    ]
    let remove_fields: List<Field> = [req("effects", holder_set(mut c, "minecraft:mob_effect"))]
    let teleport_fields: List<Field> = [
        def("diameter", positive_float(mut c), Tag.Float(16.0f32)),
        def("directional_particles", bool_codec(mut c), Tag.Byte(1i8)),
    ]
    let sound_fields: List<Field> = [req("sound", sound(mut c))]
    let kinds: List<(String, usize)> = [
        ("minecraft:apply_effects", c.add(Codec.Record(apply_fields))),
        ("minecraft:remove_effects", c.add(Codec.Record(remove_fields))),
        ("minecraft:clear_all_effects", unit(mut c)),
        ("minecraft:teleport_randomly", c.add(Codec.Record(teleport_fields))),
        ("minecraft:play_sound", c.add(Codec.Record(sound_fields))),
    ]
    let by = by_name(mut c, "minecraft:consume_effect_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `Consumable.CODEC`.
fn consumable(c: mut Codecs) -> usize {
    let animations = c.add(Codec.Names(["none", "eat", "drink", "block", "bow", "trident", "crossbow", "spyglass", "toot_horn", "brush", "bundle", "spear"]))
    let effect = consume_effect(mut c)
    let effects = c.add(Codec.ListOf(Many { of: effect }))
    let fields: List<Field> = [
        def("consume_seconds", non_negative_float(mut c), Tag.Float(1.6f32)),
        def("animation", animations, Tag.Str(String("eat"))),
        def("sound", sound(mut c), Tag.Str(String("minecraft:entity.generic.eat"))),
        def("has_consume_particles", bool_codec(mut c), Tag.Byte(1i8)),
        def("on_consume_effects", effects, Tag.List(List<Tag>())),
    ]
    return c.add(Codec.Record(fields))
}

// `DeathProtection.CODEC`.
fn death_protection(c: mut Codecs) -> usize {
    let effect = consume_effect(mut c)
    let effects = c.add(Codec.ListOf(Many { of: effect }))
    let fields: List<Field> = [def("death_effects", effects, Tag.List(List<Tag>()))]
    return c.add(Codec.Record(fields))
}

// `Tool.CODEC`, with its rules, `Tool.Rule.CODEC`.
fn tool(c: mut Codecs) -> usize {
    let rule_fields: List<Field> = [
        req("blocks", holder_set(mut c, "minecraft:block")),
        opt("speed", positive_float(mut c)),
        opt("correct_for_drops", bool_codec(mut c)),
    ]
    let rule = c.add(Codec.Record(rule_fields))
    let fields: List<Field> = [
        req("rules", c.add(Codec.ListOf(Many { of: rule }))),
        def("default_mining_speed", f32_codec(mut c), Tag.Float(1.0f32)),
        def("damage_per_block", non_negative_int(mut c), Tag.Int(1)),
        def("can_destroy_blocks_in_creative", bool_codec(mut c), Tag.Byte(1i8)),
    ]
    return c.add(Codec.Record(fields))
}

// `Equippable.CODEC`.
fn equippable(c: mut Codecs) -> usize {
    let slots = c.add(Codec.Names(["mainhand", "offhand", "feet", "legs", "chest", "head", "body", "saddle"]))
    let flag = bool_codec(mut c)
    let sounds = sound(mut c)
    let fields: List<Field> = [
        req("slot", slots),
        def("equip_sound", sounds, Tag.Str(String("minecraft:item.armor.equip_generic"))),
        opt("asset_id", id(mut c)),
        opt("camera_overlay", id(mut c)),
        opt("allowed_entities", holder_set(mut c, "minecraft:entity_type")),
        def("dispensable", flag, Tag.Byte(1i8)),
        def("swappable", flag, Tag.Byte(1i8)),
        def("damage_on_hurt", flag, Tag.Byte(1i8)),
        def("equip_on_interact", flag, Tag.Byte(0i8)),
        def("can_be_sheared", flag, Tag.Byte(0i8)),
        def("shearing_sound", sounds, Tag.Str(String("minecraft:item.shears.snip"))),
    ]
    return c.add(Codec.Record(fields))
}

// `BlocksAttacks.CODEC`, with its damage reductions and the damage the item takes.
fn blocks_attacks(c: mut Codecs) -> usize {
    let damage_types = holder_set(mut c, "minecraft:damage_type")
    let float = f32_codec(mut c)
    let reduction_fields: List<Field> = [
        def("horizontal_blocking_angle", positive_float(mut c), Tag.Float(90.0f32)),
        opt("type", damage_types),
        req("base", float),
        req("factor", float),
    ]
    let reduction = c.add(Codec.Record(reduction_fields))
    let reductions = c.add(Codec.ListOf(Many { of: reduction }))
    let damage_fields: List<Field> = [
        req("threshold", non_negative_float(mut c)),
        req("base", float),
        req("factor", float),
    ]
    let damage = c.add(Codec.Record(damage_fields))
    var one = JavaHashMap<String, Tag>()
    one.insert(String("base"), Tag.Float(0.0f32))
    one.insert(String("factor"), Tag.Float(1.0f32))
    let by_default: List<Tag> = [Tag.Compound(one)]
    var item_damage = JavaHashMap<String, Tag>()
    item_damage.insert(String("threshold"), Tag.Float(1.0f32))
    item_damage.insert(String("base"), Tag.Float(0.0f32))
    item_damage.insert(String("factor"), Tag.Float(1.0f32))
    let sounds = sound(mut c)
    let fields: List<Field> = [
        def("block_delay_seconds", non_negative_float(mut c), Tag.Float(0.0f32)),
        def("disable_cooldown_scale", non_negative_float(mut c), Tag.Float(1.0f32)),
        def("damage_reductions", reductions, Tag.List(by_default)),
        def("item_damage", damage, Tag.Compound(item_damage)),
        opt("bypassed_by", damage_types),
        opt("block_sound", sounds),
        opt("disabled_sound", sounds),
    ]
    return c.add(Codec.Record(fields))
}

// `KineticWeapon.CODEC`, with its conditions.
fn kinetic_weapon(c: mut Codecs) -> usize {
    let float = f32_codec(mut c)
    let ticks = non_negative_int(mut c)
    let condition_fields: List<Field> = [
        req("max_duration_ticks", ticks),
        def("min_speed", float, Tag.Float(0.0f32)),
        def("min_relative_speed", float, Tag.Float(0.0f32)),
    ]
    let condition = c.add(Codec.Record(condition_fields))
    let sounds = sound(mut c)
    let fields: List<Field> = [
        def("contact_cooldown_ticks", ticks, Tag.Int(10)),
        def("delay_ticks", ticks, Tag.Int(0)),
        opt("dismount_conditions", condition),
        opt("knockback_conditions", condition),
        opt("damage_conditions", condition),
        def("forward_movement", float, Tag.Float(0.0f32)),
        def("damage_multiplier", float, Tag.Float(1.0f32)),
        opt("sound", sounds),
        opt("hit_sound", sounds),
    ]
    return c.add(Codec.Record(fields))
}

// `SwingAnimation.CODEC`.
fn swing_animation(c: mut Codecs) -> usize {
    let types = c.add(Codec.Names(["none", "whack", "stab"]))
    let fields: List<Field> = [
        def("type", types, Tag.Str(String("whack"))),
        def("duration", non_negative_int(mut c), Tag.Int(6)),
    ]
    return c.add(Codec.Record(fields))
}

// `MapDecorations.CODEC`: each decoration by its key.
fn map_decorations(c: mut Codecs) -> usize {
    let double = f64_codec(mut c)
    let fields: List<Field> = [
        req("type", by_name(mut c, "minecraft:map_decoration_type")),
        req("x", double),
        req("z", double),
        req("rotation", f32_codec(mut c)),
    ]
    let entry = c.add(Codec.Record(fields))
    let keys = string(mut c)
    return c.add(Codec.MapOf(MapOf { key: keys, value: entry }))
}

// `PotionContents.CODEC`: in full, or a potion alone, which is written in full. A custom effect's
// hidden effect is read, and must read, but vanilla gives its potion contents back without it,
// as the `packs` recordings show, where an effect a consume effect applies keeps its own (D359).
fn potion_contents(c: mut Codecs) -> usize {
    let potion = by_name(mut c, "minecraft:potion")
    let read = effect_instance(mut c)
    let instance = c.add(Codec.Then(Then { of: read, then: without_hidden, with: Tag.End }))
    let effects = c.add(Codec.ListOf(Many { of: instance }))
    let fields: List<Field> = [
        opt("potion", potion),
        opt("custom_color", i32_codec(mut c)),
        def("custom_effects", effects, Tag.List(List<Tag>())),
        opt("custom_name", string(mut c)),
    ]
    let full = c.add(Codec.Record(fields))
    let alone = c.add(Codec.Then(Then { of: potion, then: potion_alone, with: Tag.End }))
    return c.add(Codec.Either(full, alone))
}

fn without_hidden(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var fields = match value {
        Tag.Compound(m) => m.copy(),
        _ => return Read.ok(value.copy()),
    }
    _ = fields.remove(String("hidden_effect"))
    return Read.ok(Tag.Compound(fields))
}

fn potion_alone(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("potion"), value.copy())
    return Read.ok(Tag.Compound(m))
}

// `SuspiciousStewEffects.CODEC`: each effect, and how long it lasts, 160 ticks where it isn't
// given or doesn't read.
fn stew_effects(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("id", by_name(mut c, "minecraft:mob_effect")),
        Field { name: "duration", of: i32_codec(mut c), need: Need.Lenient(Tag.Int(160)) },
    ]
    let entry = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: entry }))
}

// `ArmorTrim.CODEC`.
fn trim(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("material", inline_holder(mut c, "trim_material")),
        req("pattern", inline_holder(mut c, "trim_pattern")),
    ]
    return c.add(Codec.Record(fields))
}

// `LodestoneTracker.CODEC`, with `GlobalPos.CODEC`.
fn lodestone_tracker(c: mut Codecs) -> usize {
    let position: List<Field> = [req("dimension", id(mut c)), req("pos", vec3i(mut c))]
    let target = c.add(Codec.Record(position))
    let fields: List<Field> = [
        opt("target", target),
        def("tracked", bool_codec(mut c), Tag.Byte(1i8)),
    ]
    return c.add(Codec.Record(fields))
}

// `FireworkExplosion.CODEC`.
fn firework_explosion(c: mut Codecs) -> usize {
    let key = String("firework explosion")
    if let at = c.find(key) {
        return at
    }
    let shapes = c.add(Codec.Names(["small_ball", "large_ball", "star", "creeper", "burst"]))
    let number = i32_codec(mut c)
    let colors = c.add(Codec.ListOf(Many { of: number }))
    let flag = bool_codec(mut c)
    let fields: List<Field> = [
        req("shape", shapes),
        def("colors", colors, Tag.List(List<Tag>())),
        def("fade_colors", colors, Tag.List(List<Tag>())),
        def("has_trail", flag, Tag.Byte(0i8)),
        def("has_twinkle", flag, Tag.Byte(0i8)),
    ]
    return c.shared(key, Codec.Record(fields))
}

// `Fireworks.CODEC`.
fn fireworks(c: mut Codecs) -> usize {
    let explosion = firework_explosion(mut c)
    let explosions = c.add(Codec.ListOf(Many { of: explosion, max: 256 }))
    let fields: List<Field> = [
        def("flight_duration", unsigned_byte(mut c), Tag.Byte(0i8)),
        def("explosions", explosions, Tag.List(List<Tag>())),
    ]
    return c.add(Codec.Record(fields))
}

// `BannerPatternLayers.CODEC`: each layer's pattern and color.
fn banner_patterns(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        req("pattern", inline_holder(mut c, "banner_pattern")),
        req("color", dye_color(mut c)),
    ]
    let layer = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: layer }))
}

// `ItemContainerContents.CODEC`: up to 256 slots, each its place and its item.
fn container(c: mut Codecs, template: usize) -> usize {
    let fields: List<Field> = [
        req("slot", c.add(Codec.Int(IntRange { min: 0, max: 255, before: String("Value "), after: String(" outside of range [0:255]") }))),
        req("item", template),
    ]
    let slot = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: slot, max: 256 }))
}

// `ResolvableInt.CODEC`: a number, or a context int provider by its ID.
fn resolvable_int(c: mut Codecs) -> usize {
    let number = i32_codec(mut c)
    let provider = id(mut c)
    return c.add(Codec.Either(number, provider))
}

// `ResolvableFloat.CODEC`.
fn resolvable_float(c: mut Codecs) -> usize {
    let number = f32_codec(mut c)
    let provider = id(mut c)
    return c.add(Codec.Either(number, provider))
}

// `CookingFuel.CODEC` and `BrewingFuel.CODEC`: how much, and how fast.
fn fuel(c: mut Codecs, amount: str) -> usize {
    let fields: List<Field> = [
        req(String(amount), resolvable_int(mut c)),
        req("speed_multiplier", resolvable_float(mut c)),
    ]
    return c.add(Codec.Record(fields))
}

// `TypedEntityData.codec(EntityType.CODEC)`: an entity's data, as custom data is given, with its
// type's ID as `id`, written back whole.
fn entity_data(c: mut Codecs) -> usize {
    _ = custom_data(mut c)
    _ = by_name(mut c, "minecraft:entity_type")
    return c.shared(String("entity data"), Codec.Nested(read_entity_data))
}

// `TypedEntityData.codec(BLOCK_ENTITY_TYPE.byNameCodec())`.
fn block_entity_data(c: mut Codecs) -> usize {
    _ = custom_data(mut c)
    _ = by_name(mut c, "minecraft:block_entity_type")
    return c.shared(String("block entity data"), Codec.Nested(read_block_entity_data))
}

fn read_entity_data(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    return read_typed(c, value, r, mut refs, "minecraft:entity_type")
}

fn read_block_entity_data(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    return read_typed(c, value, r, mut refs, "minecraft:block_entity_type")
}

// The data, then its `id` read as an entry of `registry`.
fn read_typed(c: Codecs, value: Json, r: Registries, refs: mut Refs, registry: str) -> Read {
    let data = c.find(String("custom data")) else return Read.bad(String("no codec for custom data"))
    let by = c.find("by_name {registry}") else return Read.bad("no codec for {registry}")
    var got = c.read(data, value, r, mut refs)
    if not got.is_ok() {
        return got
    }
    let tag = got.value.take() ?? Tag.End
    var fields = match tag {
        Tag.Compound(m) => m.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
    if not fields.contains(String("id")) {
        return Read.bad("Expected 'id' field in {c.shown(value)}")
    }
    var kind = c.read(by, c.as_read(field(tag, String("id"))), r, mut refs)
    if not kind.is_ok() {
        return kind
    }
    fields.insert(String("id"), kind.value.take() ?? Tag.End)
    return Read.ok(Tag.Compound(fields))
}

// `Bees.CODEC`: each bee in the hive, its data, and how long it's been in and must stay.
fn bees(c: mut Codecs) -> usize {
    let ticks = i32_codec(mut c)
    let fields: List<Field> = [
        req("entity_data", entity_data(mut c)),
        req("ticks_in_hive", ticks),
        req("min_ticks_in_hive", ticks),
    ]
    let occupant = c.add(Codec.Record(fields))
    return c.add(Codec.ListOf(Many { of: occupant }))
}

// `TooltipDisplay.CODEC`: whether the tooltip is hidden, and the types whose lines it hides, each
// once, in the order first given.
fn tooltip_display(c: mut Codecs) -> usize {
    let kinds = by_name(mut c, "minecraft:data_component_type")
    let list = c.add(Codec.ListOf(Many { of: kinds }))
    let set = c.add(Codec.Then(Then { of: list, then: distinct, with: Tag.End }))
    let nothing: List<Tag> = []
    let fields: List<Field> = [def("hide_tooltip", bool_codec(mut c), Tag.Byte(0i8)), def("hidden_components", set, Tag.List(nothing))]
    return c.add(Codec.Record(fields))
}

// A list with each value only where it's first, as a `ReferenceLinkedOpenHashSet` keeps them.
fn distinct(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let items = match value {
        Tag.List(items) => items.copy(),
        _ => return Read.ok(value.copy()),
    }
    var out = List<Tag>()
    for each in items {
        var seen = false
        for kept in out {
            if same(kept, each) {
                seen = true
            }
        }
        if not seen {
            out.push(each.copy())
        }
    }
    return Read.ok(Tag.List(out))
}

// DataFixerUpper's `Codec.string(min, max)`: a string whose length in UTF-16 units is from
// `min` to `max`.
fn string_within(c: mut Codecs, min: i32, max: i32) -> usize {
    let bounds: List<i32> = [min, max]
    let text_codec = string(mut c)
    return c.add(Codec.Then(Then { of: text_codec, then: length_within, with: Tag.IntArray(bounds) }))
}

fn length_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let s = match value {
        Tag.Str(s) => s.copy(),
        _ => return Read.ok(value.copy()),
    }
    let bounds: List<i32> = match with {
        Tag.IntArray(b) => b.copy(),
        _ => [0, 0],
    }
    let min = bounds[0]
    let max = bounds[1]
    let length = i32.wrap(units_of(s.copy()).len())
    if length < min {
        return Read.bad("String \"{s}\" is too short: {length}, expected range [{min}-{max}]")
    }
    if length > max {
        return Read.bad("String \"{s}\" is too long: {length}, expected range [{min}-{max}]")
    }
    return Read.ok(Tag.Str(s))
}

// `Filterable.codec`: the raw value and, if it's given, the filtered one, or the raw value alone,
// which is written as the first.
fn filterable(c: mut Codecs, of: usize) -> usize {
    let fields: List<Field> = [req("raw", of), opt("filtered", of)]
    let full = c.add(Codec.Record(fields))
    let alone = c.add(Codec.Then(Then { of: of, then: raw_alone, with: Tag.End }))
    return c.add(Codec.Either(full, alone))
}

fn raw_alone(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("raw"), value.copy())
    return Read.ok(Tag.Compound(m))
}

// `WritableBookContent.CODEC`: up to 100 pages of up to 1024 units each.
fn writable_book_content(c: mut Codecs) -> usize {
    let sized = string_within(mut c, 0, 1024)
    let page = filterable(mut c, sized)
    let pages = c.add(Codec.ListOf(Many { of: page, max: 100 }))
    let nothing: List<Tag> = []
    let fields: List<Field> = [def("pages", pages, Tag.List(nothing))]
    return c.add(Codec.Record(fields))
}

// `WrittenBookContent.CODEC`.
fn written_book_content(c: mut Codecs) -> usize {
    let sized = string_within(mut c, 0, 32)
    let title = filterable(mut c, sized)
    let flat = c.shared(String("flat text 32767"), Codec.Custom(read_flat_text))
    let page = filterable(mut c, flat)
    let pages = c.add(Codec.ListOf(Many { of: page }))
    let nothing: List<Tag> = []
    let fields: List<Field> = [
        req("title", title),
        req("author", string(mut c)),
        def("generation", int_within(mut c, 0, 3), Tag.Int(0)),
        def("pages", pages, Tag.List(nothing)),
        def("resolved", bool_codec(mut c), Tag.Byte(0i8)),
    ]
    return c.add(Codec.Record(fields))
}

// `ComponentSerialization.flatRestrictedCodec(32767)`: a text component whose JSON, as vanilla
// writes it, is at most 32767 units long.
fn read_flat_text(c: Codecs, value: Json, _r: Registries) -> Read {
    let t = match component_of(c, value) {
        ok(t) => t,
        err(e) => return Read.bad(e),
    }
    if units_of(t.to_json()).len() > 32767 {
        return Read.bad(String("Component was too large: greater than max size 32767"))
    }
    return Read.ok(t.to_nbt())
}

// `DebugStickState.CODEC`: for each block by its ID, the name of the property of its states the
// stick changes, which it must have.
fn debug_stick_state(c: mut Codecs) -> usize {
    let blocks = by_name(mut c, "minecraft:block")
    let text_codec = string(mut c)
    let property = c.add(Codec.Then(Then { of: text_codec, then: block_property, with: Tag.End }))
    let none_given = List<(String, usize)>()
    return c.add(Codec.Dispatched(Dispatched { key: blocks, values: none_given, keyed: some(property) }))
}

// Whether the block `with` names has a property `value`, as `StateDefinition.getProperty` finds.
fn block_property(_c: Codecs, value: Tag, with: Tag) -> Read {
    let name = match value {
        Tag.Str(n) => n.copy(),
        _ => return Read.ok(value.copy()),
    }
    let block_name = match with {
        Tag.Str(b) => b.copy(),
        _ => String(),
    }
    let names = builtin_names()
    var index: usize? = none
    for i in 0..names.len() {
        if names[i] != "block" {
            continue
        }
        let entries = builtin_entries(i)
        for b in 0..entries.len() {
            if "minecraft:{entries[b]}" == block_name {
                index = some(b)
            }
        }
    }
    if let b = index {
        let starts = property_starts()
        let properties = block_properties()
        let property_name = property_names()
        for p in usize(starts[b])..usize(starts[b + 1]) {
            if property_name[usize(properties[p])] == name {
                return Read.ok(Tag.Str(name))
            }
        }
    }
    return Read.bad("No property on {block_name} with name: {name}")
}

// `ResolvableProfile.CODEC`: a whole profile, an ID and name, or part of one, with the skin it
// shows, or a player's name alone, which is written as the name of a profile.
fn profile(c: mut Codecs) -> usize {
    let name = player_name(mut c)
    let uuids = uuid(mut c)
    let properties = property_map(mut c)
    let nothing: List<Tag> = []
    let stored_fields: List<Field> = [req("id", uuids), req("name", name), def("properties", properties, Tag.List(nothing.copy()))]
    let stored = c.add(Codec.Record(stored_fields))
    let partial_fields: List<Field> = [opt("name", name), opt("id", uuids), def("properties", properties, Tag.List(nothing))]
    let partial = c.add(Codec.Record(partial_fields))
    let either = c.add(Codec.Either(stored, partial))
    // `PlayerSkin.Patch.MAP_CODEC`.
    let texture = id(mut c)
    let models: List<String> = [String("slim"), String("wide")]
    let model = c.add(Codec.Names(models))
    let patch_fields: List<Field> = [opt("texture", texture), opt("cape", texture), opt("elytra", texture), opt("model", model)]
    let patch = c.add(Codec.Record(patch_fields))
    let full_fields: List<Field> = [inline(either), inline(patch)]
    let full = c.add(Codec.Record(full_fields))
    let alone = c.add(Codec.Then(Then { of: name, then: name_alone, with: Tag.End }))
    return c.add(Codec.Either(full, alone))
}

fn name_alone(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("name"), value.copy())
    return Read.ok(Tag.Compound(m))
}

// `ExtraCodecs.PLAYER_NAME`: up to 16 units, each from `!` to `~`.
fn player_name(c: mut Codecs) -> usize {
    let key = String("player name")
    if let at = c.find(key) {
        return at
    }
    let sized = string_within(mut c, 0, 16)
    return c.shared(key, Codec.Then(Then { of: sized, then: valid_player_name, with: Tag.End }))
}

fn valid_player_name(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let s = match value {
        Tag.Str(s) => s.copy(),
        _ => return Read.ok(value.copy()),
    }
    for each in units_of(s.copy()) {
        let v = u32(each)
        if v <= 32 or v >= 127 {
            return Read.bad("Player name contained disallowed characters: '{s}'")
        }
    }
    return Read.ok(Tag.Str(s))
}

// `ExtraCodecs.PROPERTY_MAP`: a profile's properties, as an object of each name's values, at
// most 16 names, or a list of at most 16 properties. Written as the list, the properties of a
// name together, the names in the order they're first given, as a `Multimap` keeps them.
fn property_map(c: mut Codecs) -> usize {
    let key = String("property map")
    if let at = c.find(key) {
        return at
    }
    let text_codec = string(mut c)
    let texts = c.add(Codec.ListOf(Many { of: text_codec }))
    let map = c.add(Codec.MapOf(MapOf { key: text_codec, value: texts }))
    let limited = c.add(Codec.Then(Then { of: map, then: at_most_16, with: Tag.End }))
    c.name(String("property map object"), limited)
    let in_order = c.add(Codec.Nested(read_property_object))
    let fields: List<Field> = [req("name", string_within(mut c, 0, 64)), req("value", string_within(mut c, 0, 32767)), opt("signature", string_within(mut c, 0, 1024))]
    let one = c.add(Codec.Record(fields))
    let list = c.add(Codec.ListOf(Many { of: one, max: 16 }))
    let either = c.add(Codec.Either(in_order, list))
    return c.shared(key, Codec.Then(Then { of: either, then: grouped, with: Tag.End }))
}

fn at_most_16(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let count = match value {
        Tag.Compound(m) => m.len(),
        _ => 0,
    }
    if count > 16 {
        return Read.bad("Cannot have more than 16 properties, but was {count}")
    }
    return Read.ok(value.copy())
}

// The object form as properties, each name's values in the order the object gives the names.
fn read_property_object(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    let at = c.find(String("property map object")) else return Read.bad(String("no property map codec"))
    var got = c.read(at, value, r, mut refs)
    let read = match got.value.take() {
        some(Tag.Compound(m)) => m,
        _ => return got,
    }
    var out = List<Tag>()
    match value {
        Json.Object(members) => {
            for m in members {
                if not read.contains(m.key.copy()) {
                    continue
                }
                match read[m.key.copy()] {
                    Tag.List(values) => {
                        for v in values {
                            var p = JavaHashMap<String, Tag>()
                            p.insert(String("name"), Tag.Str(m.key.copy()))
                            p.insert(String("value"), v.copy())
                            out.push(Tag.Compound(p))
                        }
                    },
                    _ => {},
                }
            }
        },
        _ => {},
    }
    return Read { value: some(Tag.List(out)), error: got.error.take() }
}

// Properties with each name's together, the names in the order they're first given.
fn grouped(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let items = match value {
        Tag.List(items) => items.copy(),
        _ => return Read.ok(value.copy()),
    }
    var names = List<Tag>()
    for each in items {
        let n = field(each.copy(), String("name"))
        var seen = false
        for kept in names {
            if same(kept, n) {
                seen = true
            }
        }
        if not seen {
            names.push(n)
        }
    }
    var out = List<Tag>()
    for n in names {
        for each in items {
            if same(field(each.copy(), String("name")), n) {
                out.push(each.copy())
            }
        }
    }
    return Read.ok(Tag.List(out))
}

// `SignText.CODEC`: four lines, the four a filter shows if they differ, which go unwritten where
// they don't, the color, black where it isn't given, and whether the text glows.
fn sign_text(c: mut Codecs) -> usize {
    let key = String("sign text")
    if let at = c.find(key) {
        return at
    }
    let line = text(mut c)
    let lines = c.add(Codec.ListOf(Many { of: line, min: 4, max: 4 }))
    let fields: List<Field> = [
        req("messages", lines),
        Field { name: "filtered_messages", of: lines, need: Need.Loose },
        Field { name: "color", of: dye_color(mut c), need: Need.Always(Tag.Str(String("black"))) },
        Field { name: "has_glowing_text", of: bool_codec(mut c), need: Need.Always(Tag.Byte(0i8)) },
    ]
    let record = c.add(Codec.Record(fields))
    return c.shared(key, Codec.Then(Then { of: record, then: filtered_if_differs, with: Tag.End }))
}

fn filtered_if_differs(_c: Codecs, value: Tag, _with: Tag) -> Read {
    var fields = match value {
        Tag.Compound(m) => m.copy(),
        _ => return Read.ok(value.copy()),
    }
    if fields.contains(String("filtered_messages")) and same(field(value.copy(), String("filtered_messages")), field(value.copy(), String("messages"))) {
        _ = fields.remove(String("filtered_messages"))
    }
    return Read.ok(Tag.Compound(fields))
}
