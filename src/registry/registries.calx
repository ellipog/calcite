/// The registries the server shares with clients: the built-in ones, which vanilla defines in
/// code and Calcite compiles in, and the synchronized ones, which come from data packs, each with
/// its tags. `registry.load` loads them as vanilla's `RegistryDataLoader` and `TagLoader` load
/// them, so entries get vanilla's IDs and tags hold what vanilla's do.
module registry.registries

import registry.builtin.{builtin_entries, builtin_names}
import registry.registry.{Registry}
import resources.identifier.{Identifier}

/// The registries vanilla sends a client in configuration, in the order it sends them: its
/// `RegistryDataLoader.SYNCHRONIZED_REGISTRIES`, by name without `minecraft:`.
pub fn synced_names() -> List<String> {
    return [
        "worldgen/biome", "chat_type", "trim_pattern", "trim_material", "wolf_variant", "wolf_sound_variant",
        "pig_variant", "pig_sound_variant", "frog_variant", "cat_variant", "cat_sound_variant", "cow_sound_variant",
        "cow_variant", "chicken_sound_variant", "chicken_variant", "zombie_nautilus_variant", "painting_variant",
        "sulfur_cube_archetype", "dimension_type", "damage_type", "banner_pattern", "enchantment", "jukebox_song",
        "instrument", "test_environment", "test_instance", "dialog", "world_clock", "timeline",
        "decorated_pot_pattern", "block_transformer", "worldgen/block_state_provider",
    ]
}

/// The registries vanilla loads from data packs with the synchronized ones and never sends a
/// client, in `RegistryDataLoader.WORLD_REGISTRIES` order, by name without `minecraft:`: what
/// worldgen and the trades are made of, which a pack's synchronized entries can name.
pub fn world_names() -> List<String> {
    return [
        "worldgen/carver", "worldgen/feature", "worldgen/placed_feature", "worldgen/structure",
        "worldgen/structure_set", "worldgen/processor_list", "worldgen/template_pool", "worldgen/noise_settings",
        "worldgen/noise", "worldgen/density_function", "worldgen/material_rule", "worldgen/material_condition",
        "worldgen/world_preset", "worldgen/flat_level_generator_preset", "trial_spawner",
        "worldgen/multi_noise_biome_source_parameter_list", "enchantment_provider", "villager_trade", "trade_set",
    ]
}

/// The registries a client is sent: the synchronized ones, then the built-in ones, and the world
/// registries a client isn't sent.
pub struct Registries {
    /// The synchronized registries, in `synced_names` order.
    pub synced: List<Registry>
    /// The built-in registries, in the order of their own IDs.
    pub builtin: List<Registry>
    /// The world registries, in `world_names` order, each with its entries' names and its tags,
    /// and no contents: Calcite's worldgen and trades are its own, so it reads them only to
    /// know what's in them. Empty once the registries load from the boot cache, which needs
    /// none of them.
    pub world: List<Registry> = List<Registry>()
    /// The reloadable registries vanilla loads with a server's resources once the others are
    /// frozen, as `ReloadableServerRegistries.reload` loads them, each entry's contents as its
    /// codec writes them in NBT: the recipes, which are all Calcite reads yet (CAL-146).
    pub reloadable: List<Registry> = List<Registry>()
}

/// The built-in registries, in the order of their own IDs, with their entries and no tags yet.
pub fn builtin_registries() -> List<Registry> {
    var builtin = List<Registry>()
    let names = builtin_names()
    for i in 0..names.len() {
        var r = Registry.new(Identifier { namespace: "minecraft", path: names[i].copy() }, false)
        for e in builtin_entries(i) {
            r.add(full(e), none)
        }
        builtin.push(r)
    }
    return builtin
}

impl Registries {
    /// The registry named `name`, with or without `minecraft:`, or `none`.
    pub fn find(self, name: String) -> usize? {
        let full_name = full(name).to_string()
        for i in 0..self.synced.len() {
            if self.synced[i].name.to_string() == full_name {
                return some(i)
            }
        }
        return none
    }

    /// The built-in registry named `name`, with or without `minecraft:`, or `none`.
    pub fn find_builtin(self, name: String) -> usize? {
        let full_name = full(name).to_string()
        for i in 0..self.builtin.len() {
            if self.builtin[i].name.to_string() == full_name {
                return some(i)
            }
        }
        return none
    }

    /// The reloadable registry named `name`, with or without `minecraft:`, or `none`.
    pub fn find_reloadable(self, name: String) -> usize? {
        let full_name = full(name).to_string()
        for i in 0..self.reloadable.len() {
            if self.reloadable[i].name.to_string() == full_name {
                return some(i)
            }
        }
        return none
    }

    /// The world registry named `name`, with or without `minecraft:`, or `none`.
    pub fn find_world(self, name: String) -> usize? {
        let full_name = full(name).to_string()
        for i in 0..self.world.len() {
            if self.world[i].name.to_string() == full_name {
                return some(i)
            }
        }
        return none
    }
}

// An entry as the built-in tables write it, without `minecraft:` where it's in it.
fn full(name: String) -> Identifier {
    if let c = name.find(":") {
        return Identifier { namespace: name[..c], path: name[c + 1..] }
    }
    return Identifier { namespace: "minecraft", path: name.copy() }
}
