/// The codecs of the trades villagers offer (CAL-160): `VillagerTrade.CODEC` and `TradeSet.CODEC`,
/// as a data pack's `villager_trade/` and `trade_set/` files give them. Vanilla reads both with
/// the world registries, before the reloadable ones, so a trade names no predicate, item
/// modifier or number provider by its ID, and gives each in full. Its check that a trade uses
/// only what a trade's loot context has, `validatorForContext(VILLAGER_TRADE)`, isn't here: what
/// vanilla's own data gives passes it.
module registry.trades

import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Field, Then}
import registry.codecs.{bool_codec, by_name, def, id, item_stack_template, not_air, opt, req}
import registry.loot.{condition, context_float, context_int}
import registry.loot_tables.{item_modifier}
import registry.predicates.{exact_components, holder_set}

/// `TradeCost.CODEC`: the item a trade wants, how many, a number from what's around the trade,
/// 1 where it's left out, and the components it must have, none where they're left out.
pub fn trade_cost(c: mut Codecs) -> usize {
    return c.named(String("trade cost"), make_trade_cost)
}

fn make_trade_cost(c: mut Codecs) -> Codec {
    let items = by_name(mut c, "minecraft:item")
    let item = c.add(Codec.Then(Then { of: items, then: not_air, with: Tag.End }))
    let fields: List<Field> = [
        req("id", item),
        def("count", context_int(mut c), Tag.Int(1)),
        def("components", exact_components(mut c), Tag.Compound(JavaHashMap<String, Tag>())),
    ]
    return Codec.Record(fields)
}

/// `VillagerTrade.CODEC`: what a trade wants, and maybe a second thing, what it gives, its uses,
/// 4 where they're left out, the experience it rewards, 1, and its discount for reputation, 0,
/// each a number from what's around the trade; and, where they're given, what the merchant must
/// be, what's done to what it gives, and the enchantments that double the cost the item adds.
pub fn villager_trade(c: mut Codecs) -> usize {
    return c.named(String("villager trade"), make_villager_trade)
}

fn make_villager_trade(c: mut Codecs) -> Codec {
    let cost = trade_cost(mut c)
    let ints = context_int(mut c)
    let fields: List<Field> = [
        req("wants", cost),
        opt("additional_wants", cost),
        req("gives", item_stack_template(mut c)),
        def("max_uses", ints, Tag.Int(4)),
        def("xp", ints, Tag.Int(1)),
        def("reputation_discount", context_float(mut c), Tag.Float(0.0f32)),
        opt("merchant_predicate", condition(mut c)),
        opt("given_item_modifier", item_modifier(mut c)),
        opt("double_trade_price_enchantments", holder_set(mut c, "minecraft:enchantment")),
    ]
    return Codec.Record(fields)
}

/// `TradeSet.CODEC`: the trades a set draws from, a tag of them or a list, how many it draws, a
/// number from what's around the trade, whether it may draw one again, and the random sequence it
/// draws from, where it names one.
pub fn trade_set(c: mut Codecs) -> usize {
    return c.named(String("trade set"), make_trade_set)
}

fn make_trade_set(c: mut Codecs) -> Codec {
    let fields: List<Field> = [
        req("trades", holder_set(mut c, "minecraft:villager_trade")),
        req("amount", context_int(mut c)),
        def("allow_duplicates", bool_codec(mut c), Tag.Byte(0i8)),
        opt("random_sequence", id(mut c)),
    ]
    return Codec.Record(fields)
}
