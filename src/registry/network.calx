/// The codecs the synchronized registries are read with: what each entry of a data pack's
/// registries is read as, with the server's codec where it reads more than clients are sent,
/// and the NBT clients are sent for it, as the network codec writes it.
module registry.network

import registry.codec.{Codecs}
import registry.codecs.{registry_codec}
import registry.enchantments.{enchantment}
import registry.variants.{variant_codec}

/// The codec of the synchronized registry `name`, such as `damage_type` or `enchantment`, made
/// in `c`, or `none` for a registry Calcite can't read yet. It reads what the server's codec
/// reads, and gives what the network codec writes.
pub fn network_codec(c: mut Codecs, name: String) -> usize? {
    if name == "enchantment" {
        return some(enchantment(mut c))
    }
    if let v = variant_codec(mut c, name) {
        return some(v)
    }
    return registry_codec(mut c, name)
}
