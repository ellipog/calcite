/// The network codecs of the synchronized registries: what each entry of a data pack's
/// registries is read as, and the NBT clients are sent for it.
module registry.network

import registry.codec.{Codecs}
import registry.codecs.{registry_codec}
import registry.enchantments.{enchantment}

/// The network codec of the synchronized registry `name`, such as `damage_type` or
/// `enchantment`, made in `c`, or `none` for a registry Calcite can't read yet.
pub fn network_codec(c: mut Codecs, name: String) -> usize? {
    if name == "enchantment" {
        return some(enchantment(mut c))
    }
    return registry_codec(mut c, name)
}
