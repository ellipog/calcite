/// Item components over the network, as each type's `STREAM_CODEC` sends its value, and the
/// patch and the item stack that hold them, as `DataComponentPatch.STREAM_CODEC` and
/// `ItemStack.OPTIONAL_STREAM_CODEC` send them (CAL-77, D364, D365). A value is held as the NBT
/// its codec writes, as `registry.components` reads it: a stream codec writes it from that, and
/// what one reads is that NBT as typed JSON, which keeps the order its maps came in.
module registry.streams

import java.text.{string_hash}
import java.uuid.{Uuid}
import json.tree.{Json, Member}
import nbt.snbt.{parse as parse_snbt}
import nbt.tag.{Accounter, Tag}
import protocol.wire.{DecodeError, Reader, Writer}
import registry.codec.{Codecs, Refs}
import registry.registries.{Registries}
import resources.identifier.{Identifier}

/// How a value goes over the network, between the wire and the NBT its codec writes.
pub enum Stream {
    /// `ByteBufCodecs.VAR_INT`, an int.
    VarInt,
    /// `ByteBufCodecs.INT`, an int in four bytes.
    Int,
    /// `ByteBufCodecs.FLOAT`.
    Float,
    /// `ByteBufCodecs.DOUBLE`.
    Double,
    /// `ByteBufCodecs.BOOL`, a byte 0 or 1 in NBT.
    Bool,
    /// `ByteBufCodecs.VAR_INT` of what `ExtraCodecs.UNSIGNED_BYTE` holds as a byte in NBT.
    UnsignedByte,
    /// An effect's amplifier, an unsigned byte, which `MobEffectInstance` clamps to 0 to 255.
    Amplifier,
    /// `ByteBufCodecs.stringUtf8(max)`, at most `max` UTF-16 units.
    Utf(i32),
    /// `Identifier.STREAM_CODEC`: an identifier as a string.
    Id,
    /// `Unit.STREAM_CODEC`: nothing, an empty compound in NBT.
    Unit,
    /// NBT, as a test of components is sent.
    Nbt,
    /// `ByteBufCodecs.fromCodecWithRegistries`: NBT, decoded with the codec named as it's read,
    /// as text is sent, and the value of a type with no stream codec of its own; true where it's
    /// `fromCodecWithRegistriesTrusted`, with no limit to the NBT's size.
    Decoded(String, bool),
    /// `ByteBufCodecs.COMPOUND_TAG`: NBT that must be a compound.
    Compound,
    /// `ByteBufCodecs.COMPOUND_TAG` of a compound held as SNBT, as `NbtPredicate` holds it.
    Snbt,
    /// `UUIDUtil.STREAM_CODEC`: two longs, four ints in NBT.
    UniqueId,
    /// `BlockPos.STREAM_CODEC`: a long, three ints in NBT.
    Pos,
    /// `ByteBufCodecs.idMapper` of an enum whose IDs run from 0, the place of its name here,
    /// with what `ByIdMap.continuous` gives for one out of range.
    Names(List<String>, Bound),
    /// `ByteBufCodecs.idMapper` of an enum with the IDs given, `ByIdMap.sparse`, the first for
    /// one that isn't there.
    Sparse(List<(i32, String)>),
    /// `ByteBufCodecs.BOOL` mapped to an enum: the name for false, then for true.
    Flag(String, String),
    /// `ByteBufCodecs.holderRegistry` and `registry`: an entry of the registry, by its network
    /// ID, its ID in NBT.
    Registry(String),
    /// `ByteBufCodecs.holder`: an entry by its network ID and one, or 0 and the value in full
    /// with the stream given, a compound in NBT.
    Holder(String, usize),
    /// `ByteBufCodecs.holderSet`: 0 and a tag's ID, or how many entries and one, then each. In
    /// NBT `#` and the tag's ID, one entry's ID, or a list of them.
    HolderSet(String),
    /// `ByteBufCodecs.list(max)`: a count, then each.
    ListOf(usize, usize),
    /// A list whose codec writes one alone as itself, as `ExtraCodecs.compactListCodec` does.
    Compact(usize),
    /// `ByteBufCodecs.fixedSizeList(n)`: exactly `n`, with no count.
    Fixed(usize, usize),
    /// `ByteBufCodecs.collection` into a `ReferenceLinkedOpenHashSet`: a count, then each, one
    /// given again kept where it was first.
    Set(usize),
    /// `ByteBufCodecs.optional`: whether there's one, then it. A record's field that isn't there.
    Optional(usize),
    /// `StreamCodec.composite`: each field in turn.
    Record(List<StreamField>),
    /// Streams that each write a part of the same compound, as a record's fields inlined from
    /// map codecs are.
    Inline(List<usize>),
    /// `ByteBufCodecs.map`, or a list of pairs: a count, then each key and its value, a compound
    /// in NBT, read into what's said.
    Map(usize, usize, Held),
    /// `ByteBufCodecs.either`: true and the first, or false and the second, which the NBT says.
    Either(usize, usize, Side),
    /// `StreamCodec.dispatch`: the kind, with the stream given, then the kind's own, all one
    /// compound in NBT whose field named says the kind.
    Dispatch(usize, String, List<(String, usize)>),
    /// `TypedEntityData.streamCodec`: the type with the stream given, then the rest of the data,
    /// the compound with the type as its `id` in NBT.
    Typed(usize),
    /// `ItemContainerContents.STREAM_CODEC`: each slot up to the last that's filled, whether it
    /// is and its item, a list of `{slot, item}` in NBT.
    Slots(usize),
    /// `ByteBufCodecs.GAME_PROFILE_PROPERTIES`: at most 16 properties, each as the record given,
    /// a list in NBT.
    Properties(usize),
    /// `ItemStackTemplate.STREAM_CODEC`: its item, how many, and its patch.
    Template,
    /// `DataComponentPatch.STREAM_CODEC`.
    Patch,
    /// `DataComponentExactPredicate.STREAM_CODEC`: each component, its type and its value.
    Exact,
    /// `DataComponentPredicate.STREAM_CODEC`: at most 64 tests, each a test's type or a
    /// component type, then the test as NBT.
    Partial,
}

/// What an enum's `ByIdMap.continuous` gives for an ID out of range: the first, the nearest, or
/// the ID wrapped around.
pub enum Bound {
    Zero,
    Clamp,
    Wrap,
}

/// What a map is read into: a list, which keeps its order and throws as `ArrayList` does for
/// fewer than none; a fastutil map of holders, whose identity hashes give its order, kept as it
/// came here; or an `Object2ObjectOpenHashMap` of strings, whose hashes give the order it's sent
/// on in.
pub enum Held {
    InList,
    ByIdentity,
    OpenHash,
}

/// What a collection is made as, which says what a count of fewer than none throws: an
/// `ArrayList`, a fastutil hash map or set, or nothing, which takes it as none.
pub enum Made {
    Array,
    Hashed,
    Loop,
}

/// Which side of an either NBT is: a profile with an ID and a name is a whole one, a string is
/// a matcher's exact value, and a number is a constant.
pub enum Side {
    Profile,
    Text,
    Number,
}

/// A record's field: its name in the NBT, its stream, and what's sent where the NBT leaves it
/// out, its codec's default, or `none` where it must be there or is optional.
pub struct StreamField {
    pub name: String
    pub of: usize
    pub absent: Tag?
}

/// The stream codecs, and each component type's, by its whole ID.
pub struct Streams {
    all: List<Stream>
    names: Map<String, usize>
    types: Map<String, usize>
}

/// A stack off the network, as `ItemStack.OPTIONAL_STREAM_CODEC` reads one: its item, how many,
/// and its patch, each type's whole ID with its value as its stream codec reads it, as typed
/// JSON, or `none` where the patch takes it away, in the order the patch's array map keeps them.
pub struct WireStack {
    pub item: String
    pub count: i32
    pub patch: List<(String, Json?)>
}

/// What a stack read from the network is: empty; a stack; a component type Calcite can't read
/// the stream of yet; or what vanilla throws, as its `toString` gives it.
pub enum Decoded {
    Empty,
    Stack(WireStack),
    Missing(String),
    Bad(String),
}

const MAX: usize = 2147483647

// The member a profile read as a part of one is marked with, which its codec doesn't read, so
// it's sent again as a part where it has an ID and a name too.
// The member the last filled slot of a container off the network is marked with, the slots it
// came with, which its codec doesn't read.
fn slots_key() -> String {
    return String("calcite:slots")
}

// A number's text, or nothing.
fn json_number(v: Json) -> String {
    return match v {
        Json.Number(text) => text.copy(),
        _ => String(),
    }
}

fn partial_key() -> String {
    return String("calcite:partial")
}

fn field(name: str, of: usize) -> StreamField {
    return StreamField { name: String(name), of: of, absent: none }
}

fn def(name: str, of: usize, absent: own Tag) -> StreamField {
    return StreamField { name: String(name), of: of, absent: some(absent) }
}

fn names(list: List<str>) -> List<String> {
    var out = List<String>()
    for each in list {
        out.push(String(each))
    }
    return out
}

fn empty_list() -> Tag {
    return Tag.List(List<Tag>())
}

fn empty_compound() -> Tag {
    return Tag.Compound(JavaHashMap<String, Tag>())
}

impl Streams {
    /// Every component type's stream codec.
    pub fn new() -> Streams {
        var s = Streams { all: List<Stream>(), names: Map<String, usize>(), types: Map<String, usize>() }
        s.build()
        return s
    }

    fn add(mut self, stream: own Stream) -> usize {
        self.all.push(stream)
        return self.all.len() - 1
    }

    // One stream of each kind that holds nothing else, shared.
    fn shared(mut self, name: str, stream: own Stream) -> usize {
        if let at = self.names.get(String(name)) {
            return at
        }
        let at = self.add(stream)
        self.names.insert(String(name), at)
        return at
    }

    fn list(mut self, of: usize, max: usize) -> usize {
        return self.add(Stream.ListOf(of, max))
    }

    fn optional(mut self, of: usize) -> usize {
        return self.add(Stream.Optional(of))
    }

    fn registry(mut self, name: str) -> usize {
        return self.add(Stream.Registry(String(name)))
    }

    fn holders(mut self, name: str) -> usize {
        return self.add(Stream.HolderSet(String(name)))
    }

    fn record(mut self, fields: own List<StreamField>) -> usize {
        return self.add(Stream.Record(fields))
    }

    fn enumerated(mut self, list: List<str>, bound: own Bound) -> usize {
        return self.add(Stream.Names(names(list), bound))
    }

    fn set(mut self, name: str, at: usize) {
        self.types.insert("minecraft:{name}", at)
    }

    fn build(mut self) {
        let var_int = self.shared("var int", Stream.VarInt)
        let int = self.shared("int", Stream.Int)
        let float = self.shared("float", Stream.Float)
        let double = self.shared("double", Stream.Double)
        let flag = self.shared("bool", Stream.Bool)
        let unsigned_byte = self.shared("unsigned byte", Stream.UnsignedByte)
        let utf = self.add(Stream.Utf(32767))
        let id = self.shared("id", Stream.Id)
        let unit = self.shared("unit", Stream.Unit)
        let compound = self.shared("compound", Stream.Compound)
        let text = self.shared("text", Stream.Decoded(String("text"), false))
        let trusted_text = self.shared("trusted text", Stream.Decoded(String("text"), true))
        let uuid = self.shared("uuid", Stream.UniqueId)
        let pos = self.shared("pos", Stream.Pos)
        let optional_text = self.optional(text)
        let optional_trusted_text = self.optional(trusted_text)
        let optional_float = self.optional(float)
        let optional_id = self.optional(id)
        let optional_utf = self.optional(utf)
        let dye = self.enumerated([
            "white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray",
            "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black",
        ], Bound.Zero)
        // `SoundEvent.STREAM_CODEC`: an entry, or the sound's ID and its fixed range if it has one.
        let sound_fields: List<StreamField> = [field("sound_id", id), field("range", optional_float)]
        let sound_direct = self.record(sound_fields)
        let sound = self.add(Stream.Holder(String("minecraft:sound_event"), sound_direct))
        let optional_sound = self.optional(sound)
        let template = self.shared("template", Stream.Template)
        let optional_template = self.optional(template)
        let enchantment = self.registry("minecraft:enchantment")
        let enchantments = self.add(Stream.Map(enchantment, var_int, Held.ByIdentity))
        let damage_types = self.holders("minecraft:damage_type")
        let optional_damage_types = self.optional(damage_types)
        let blocks = self.holders("minecraft:block")
        let entity_types = self.holders("minecraft:entity_type")

        for name in ["max_stack_size", "max_damage", "damage", "repair_cost", "map_id", "ominous_bottle_amplifier", "additional_trade_cost"] {
            self.set(name, var_int)
        }
        for name in ["unbreakable", "glider", "waxed", "creative_slot_lock"] {
            self.set(name, unit)
        }
        // The types with no stream codec of their own send their codec's NBT, as text does.
        for name in [
            "custom_data", "intangible_projectile", "map_decorations", "debug_stick_state", "recipes", "lock", "container_loot",
        ] {
            let at = self.add(Stream.Decoded("component minecraft:{name}", false))
            self.set(name, at)
        }
        self.set("custom_name", text)
        self.set("item_name", text)
        // `CustomData.STREAM_CODEC`, a compound.
        self.set("bucket_entity_data", compound)
        for name in ["minimum_attack_charge", "potion_duration_scale"] {
            self.set(name, float)
        }
        for name in ["item_model", "tooltip_style", "note_block_sound"] {
            self.set(name, id)
        }
        let lore = self.list(text, 256)
        self.set("lore", lore)
        let rarity = self.enumerated(["common", "uncommon", "rare", "epic"], Bound.Zero)
        self.set("rarity", rarity)
        for name in [
            "dye", "base_color", "wolf/collar", "tropical_fish/base_color", "tropical_fish/pattern_color", "cat/collar",
            "sheep/color", "shulker/color", "cushion/color",
        ] {
            self.set(name, dye)
        }
        self.set("enchantments", enchantments)
        self.set("stored_enchantments", enchantments)
        self.set("dyed_color", int)
        self.set("enchantment_glint_override", flag)
        let enchantable_fields: List<StreamField> = [field("value", var_int)]
        let enchantable = self.record(enchantable_fields)
        self.set("enchantable", enchantable)
        let villager_food_fields: List<StreamField> = [field("nutrition", var_int)]
        let villager_food = self.record(villager_food_fields)
        self.set("villager_food", villager_food)
        let food_fields: List<StreamField> = [field("nutrition", var_int), field("saturation", float), def("can_always_eat", flag, Tag.Byte(0i8))]
        let food = self.record(food_fields)
        self.set("food", food)
        let floats = self.list(float, MAX)
        let flags = self.list(flag, MAX)
        let strings = self.list(utf, MAX)
        let ints = self.list(int, MAX)
        let model_fields: List<StreamField> = [
            def("floats", floats, empty_list()),
            def("flags", flags, empty_list()),
            def("strings", strings, empty_list()),
            def("colors", ints, empty_list()),
        ]
        let model = self.record(model_fields)
        self.set("custom_model_data", model)
        let weapon_fields: List<StreamField> = [def("item_damage_per_attack", var_int, Tag.Int(1)), def("disable_blocking_for_seconds", float, Tag.Float(0.0f32))]
        let weapon = self.record(weapon_fields)
        self.set("weapon", weapon)
        let effects_fields: List<StreamField> = [
            def("can_sprint", flag, Tag.Byte(0i8)),
            def("interact_vibrations", flag, Tag.Byte(1i8)),
            def("speed_multiplier", float, Tag.Float(0.2f32)),
        ]
        let effects = self.record(effects_fields)
        self.set("use_effects", effects)
        let cooldown_fields: List<StreamField> = [field("seconds", float), field("cooldown_group", optional_id)]
        let cooldown = self.record(cooldown_fields)
        self.set("use_cooldown", cooldown)
        let range_fields: List<StreamField> = [
            def("min_reach", float, Tag.Float(0.0f32)),
            def("max_reach", float, Tag.Float(3.0f32)),
            def("min_creative_reach", float, Tag.Float(0.0f32)),
            def("max_creative_reach", float, Tag.Float(5.0f32)),
            def("hitbox_margin", float, Tag.Float(0.3f32)),
            def("mob_factor", float, Tag.Float(1.0f32)),
        ]
        let range = self.record(range_fields)
        self.set("attack_range", range)
        // The entries of a registry, by their network ID.
        let entries: List<(str, str)> = [
            ("damage_type", "minecraft:damage_type"), ("block_transformer", "minecraft:block_transformer"),
            ("villager/variant", "minecraft:villager_type"), ("wolf/variant", "minecraft:wolf_variant"),
            ("wolf/sound_variant", "minecraft:wolf_sound_variant"), ("pig/variant", "minecraft:pig_variant"),
            ("pig/sound_variant", "minecraft:pig_sound_variant"), ("cow/variant", "minecraft:cow_variant"),
            ("cow/sound_variant", "minecraft:cow_sound_variant"), ("chicken/variant", "minecraft:chicken_variant"),
            ("chicken/sound_variant", "minecraft:chicken_sound_variant"),
            ("zombie_nautilus/variant", "minecraft:zombie_nautilus_variant"), ("frog/variant", "minecraft:frog_variant"),
            ("cat/variant", "minecraft:cat_variant"), ("cat/sound_variant", "minecraft:cat_sound_variant"),
            ("provides_pottery_pattern", "minecraft:decorated_pot_pattern"),
        ]
        for (name, registry) in entries {
            let at = self.registry(registry)
            self.set(name, at)
        }

        // The enums of animals' variants, each with how its IDs map back.
        let fox = self.enumerated(["red", "snow"], Bound.Zero)
        self.set("fox/variant", fox)
        let salmon = self.enumerated(["small", "medium", "large"], Bound.Clamp)
        self.set("salmon/size", salmon)
        let parrot = self.enumerated(["red_blue", "blue", "green", "yellow_blue", "gray"], Bound.Clamp)
        self.set("parrot/variant", parrot)
        let patterns: List<(i32, String)> = [
            (0, String("kob")), (256, String("sunstreak")), (512, String("snooper")), (768, String("dasher")),
            (1024, String("brinely")), (1280, String("spotty")), (1, String("flopper")), (257, String("stripey")),
            (513, String("glitter")), (769, String("blockfish")), (1025, String("betty")), (1281, String("clayfish")),
        ]
        let pattern = self.add(Stream.Sparse(patterns))
        self.set("tropical_fish/pattern", pattern)
        let mooshroom = self.enumerated(["red", "brown"], Bound.Clamp)
        self.set("mooshroom/variant", mooshroom)
        let rabbits: List<(i32, String)> = [
            (0, String("brown")), (1, String("white")), (2, String("black")), (3, String("white_splotched")),
            (4, String("gold")), (5, String("salt")), (99, String("evil")),
        ]
        let rabbit = self.add(Stream.Sparse(rabbits))
        self.set("rabbit/variant", rabbit)
        let horse = self.enumerated(["white", "creamy", "chestnut", "brown", "black", "gray", "dark_brown"], Bound.Wrap)
        self.set("horse/variant", horse)
        let llama = self.enumerated(["creamy", "white", "brown", "gray"], Bound.Clamp)
        self.set("llama/variant", llama)
        let axolotl = self.enumerated(["lucy", "wild", "gold", "cyan", "blue"], Bound.Zero)
        self.set("axolotl/variant", axolotl)
        // `PaintingVariant.STREAM_CODEC`, an entry or one in full.
        let painting_fields: List<StreamField> = [
            field("width", var_int), field("height", var_int), field("asset_id", id),
            field("title", optional_trusted_text), field("author", optional_trusted_text),
        ]
        let painting_direct = self.record(painting_fields)
        let painting = self.add(Stream.Holder(String("minecraft:painting_variant"), painting_direct))
        self.set("painting/variant", painting)
        let post = self.enumerated(["lock", "scale"], Bound.Zero)
        self.set("map_post_processing", post)

        // `AdventureModePredicate.STREAM_CODEC`: block predicates, each the blocks if it names
        // them, their states, their data, and the components they must have and the tests of
        // the others.
        let ranged_fields: List<StreamField> = [field("min", optional_utf), field("max", optional_utf)]
        let ranged = self.record(ranged_fields)
        let matcher = self.add(Stream.Either(utf, ranged, Side.Text))
        let state = self.add(Stream.Map(utf, matcher, Held.InList))
        let snbt = self.shared("snbt", Stream.Snbt)
        let exact = self.shared("exact", Stream.Exact)
        let partial = self.shared("partial", Stream.Partial)
        let optional_blocks = self.optional(blocks)
        let optional_state = self.optional(state)
        let optional_snbt = self.optional(snbt)
        let block_fields: List<StreamField> = [
            field("blocks", optional_blocks),
            field("state", optional_state),
            field("nbt", optional_snbt),
            def("components", exact, empty_compound()),
            def("predicates", partial, empty_compound()),
        ]
        let block_predicate = self.record(block_fields)
        let adventure = self.add(Stream.Compact(block_predicate))
        self.set("can_place_on", adventure)
        self.set("can_break", adventure)

        // `ItemAttributeModifiers.STREAM_CODEC`: each modifier, the attribute it changes, its ID,
        // amount and operation, the slots it's for, and how it's shown.
        let attribute = self.registry("minecraft:attribute")
        let operation = self.enumerated(["add_value", "add_multiplied_base", "add_multiplied_total"], Bound.Zero)
        let slot_group = self.enumerated(["any", "mainhand", "offhand", "hand", "feet", "legs", "chest", "head", "armor", "body", "saddle"], Bound.Zero)
        let display_type = self.enumerated(["default", "hidden", "override"], Bound.Zero)
        let override_fields: List<StreamField> = [field("value", text)]
        let override_text = self.record(override_fields)
        let shown: List<(String, usize)> = [(String("default"), unit), (String("hidden"), unit), (String("override"), override_text)]
        let display = self.add(Stream.Dispatch(display_type, String("type"), shown))
        var by_default = JavaHashMap<String, Tag>()
        by_default.insert(String("type"), Tag.Str(String("default")))
        let modifier_fields: List<StreamField> = [
            field("type", attribute),
            field("id", id),
            field("amount", double),
            field("operation", operation),
            def("slot", slot_group, Tag.Str(String("any"))),
            def("display", display, Tag.Compound(by_default)),
        ]
        let modifier = self.record(modifier_fields)
        let modifiers = self.list(modifier, MAX)
        self.set("attribute_modifiers", modifiers)

        // `TooltipDisplay.STREAM_CODEC`.
        let component_type = self.registry("minecraft:data_component_type")
        let hidden = self.add(Stream.Set(component_type))
        let tooltip_fields: List<StreamField> = [def("hide_tooltip", flag, Tag.Byte(0i8)), def("hidden_components", hidden, empty_list())]
        let tooltip = self.record(tooltip_fields)
        self.set("tooltip_display", tooltip)

        // `MobEffectInstance.STREAM_CODEC`: an effect, with its details, which hold the effect
        // they hide, details too.
        let details = self.add(Stream.Unit)
        let hidden_effect = self.optional(details)
        var detail_fields = List<StreamField>()
        let amplifier = self.shared("amplifier", Stream.Amplifier)
        detail_fields.push(def("amplifier", amplifier, Tag.Byte(0i8)))
        detail_fields.push(def("duration", var_int, Tag.Int(0)))
        detail_fields.push(def("ambient", flag, Tag.Byte(0i8)))
        detail_fields.push(def("show_particles", flag, Tag.Byte(1i8)))
        detail_fields.push(def("show_icon", flag, Tag.Byte(1i8)))
        detail_fields.push(field("hidden_effect", hidden_effect))
        self.all[details] = Stream.Record(detail_fields)
        let mob_effect = self.registry("minecraft:mob_effect")
        let effect_fields: List<StreamField> = [field("id", mob_effect)]
        let effect_id = self.record(effect_fields)
        let effect_parts: List<usize> = [effect_id, details]
        let effect_instance = self.add(Stream.Inline(effect_parts))
        let effect_instances = self.list(effect_instance, MAX)

        // `ConsumeEffect.STREAM_CODEC`, by its type.
        let apply_fields: List<StreamField> = [field("effects", effect_instances), def("probability", float, Tag.Float(1.0f32))]
        let mob_effects = self.holders("minecraft:mob_effect")
        let remove_fields: List<StreamField> = [field("effects", mob_effects)]
        let teleport_fields: List<StreamField> = [def("diameter", float, Tag.Float(16.0f32)), def("directional_particles", flag, Tag.Byte(1i8))]
        let play_fields: List<StreamField> = [field("sound", sound)]
        let kinds: List<(String, usize)> = [
            (String("minecraft:apply_effects"), self.record(apply_fields)),
            (String("minecraft:remove_effects"), self.record(remove_fields)),
            (String("minecraft:clear_all_effects"), unit),
            (String("minecraft:teleport_randomly"), self.record(teleport_fields)),
            (String("minecraft:play_sound"), self.record(play_fields)),
        ]
        let effect_type = self.registry("minecraft:consume_effect_type")
        let consume_effect = self.add(Stream.Dispatch(effect_type, String("type"), kinds))
        let consume_effects = self.list(consume_effect, MAX)
        let animation = self.enumerated(["none", "eat", "drink", "block", "bow", "trident", "crossbow", "spyglass", "toot_horn", "brush", "bundle", "spear"], Bound.Zero)
        let consumable_fields: List<StreamField> = [
            def("consume_seconds", float, Tag.Float(1.6f32)),
            def("animation", animation, Tag.Str(String("eat"))),
            def("sound", sound, Tag.Str(String("minecraft:entity.generic.eat"))),
            def("has_consume_particles", flag, Tag.Byte(1i8)),
            def("on_consume_effects", consume_effects, empty_list()),
        ]
        let consumable = self.record(consumable_fields)
        self.set("consumable", consumable)
        let death_fields: List<StreamField> = [def("death_effects", consume_effects, empty_list())]
        let death = self.record(death_fields)
        self.set("death_protection", death)

        // The types that hold stacks.
        self.set("use_remainder", template)
        self.set("sulfur_cube_content", template)
        let projectiles = self.list(template, 1024)
        self.set("charged_projectiles", projectiles)
        let bundle = self.list(template, MAX)
        self.set("bundle_contents", bundle)
        let slots = self.add(Stream.Slots(template))
        self.set("container", slots)
        let pot_fields: List<StreamField> = [
            field("back", optional_template), field("left", optional_template),
            field("right", optional_template), field("front", optional_template),
        ]
        let pot = self.record(pot_fields)
        self.set("pot_decorations", pot)

        let resistant_fields: List<StreamField> = [field("types", damage_types)]
        let resistant = self.record(resistant_fields)
        self.set("damage_resistant", resistant)
        let optional_flag = self.optional(flag)
        let rule_fields: List<StreamField> = [field("blocks", blocks), field("speed", optional_float), field("correct_for_drops", optional_flag)]
        let rule = self.record(rule_fields)
        let rules = self.list(rule, MAX)
        let tool_fields: List<StreamField> = [
            field("rules", rules),
            def("default_mining_speed", float, Tag.Float(1.0f32)),
            def("damage_per_block", var_int, Tag.Int(1)),
            def("can_destroy_blocks_in_creative", flag, Tag.Byte(1i8)),
        ]
        let tool = self.record(tool_fields)
        self.set("tool", tool)
        let equipment_slot = self.enumerated(["mainhand", "feet", "legs", "chest", "head", "offhand", "body", "saddle"], Bound.Zero)
        let optional_entities = self.optional(entity_types)
        let equippable_fields: List<StreamField> = [
            field("slot", equipment_slot),
            def("equip_sound", sound, Tag.Str(String("minecraft:item.armor.equip_generic"))),
            field("asset_id", optional_id),
            field("camera_overlay", optional_id),
            field("allowed_entities", optional_entities),
            def("dispensable", flag, Tag.Byte(1i8)),
            def("swappable", flag, Tag.Byte(1i8)),
            def("damage_on_hurt", flag, Tag.Byte(1i8)),
            def("equip_on_interact", flag, Tag.Byte(0i8)),
            def("can_be_sheared", flag, Tag.Byte(0i8)),
            def("shearing_sound", sound, Tag.Str(String("minecraft:item.shears.snip"))),
        ]
        let equippable = self.record(equippable_fields)
        self.set("equippable", equippable)
        let items = self.holders("minecraft:item")
        let repairable_fields: List<StreamField> = [field("items", items)]
        let repairable = self.record(repairable_fields)
        self.set("repairable", repairable)

        // `BlocksAttacks.STREAM_CODEC`, with its damage reductions and the damage the item takes.
        let reduction_fields: List<StreamField> = [
            def("horizontal_blocking_angle", float, Tag.Float(90.0f32)),
            field("type", optional_damage_types),
            field("base", float),
            field("factor", float),
        ]
        let reduction = self.record(reduction_fields)
        let reductions = self.list(reduction, MAX)
        let damage_function_fields: List<StreamField> = [field("threshold", float), field("base", float), field("factor", float)]
        let damage_function = self.record(damage_function_fields)
        var one = JavaHashMap<String, Tag>()
        one.insert(String("base"), Tag.Float(0.0f32))
        one.insert(String("factor"), Tag.Float(1.0f32))
        let one_reduction: List<Tag> = [Tag.Compound(one)]
        var item_damage = JavaHashMap<String, Tag>()
        item_damage.insert(String("threshold"), Tag.Float(1.0f32))
        item_damage.insert(String("base"), Tag.Float(0.0f32))
        item_damage.insert(String("factor"), Tag.Float(1.0f32))
        let blocks_fields: List<StreamField> = [
            def("block_delay_seconds", float, Tag.Float(0.0f32)),
            def("disable_cooldown_scale", float, Tag.Float(1.0f32)),
            def("damage_reductions", reductions, Tag.List(one_reduction)),
            def("item_damage", damage_function, Tag.Compound(item_damage)),
            field("bypassed_by", optional_damage_types),
            field("block_sound", optional_sound),
            field("disabled_sound", optional_sound),
        ]
        let blocks_attacks = self.record(blocks_fields)
        self.set("blocks_attacks", blocks_attacks)
        let piercing_fields: List<StreamField> = [
            def("deals_knockback", flag, Tag.Byte(1i8)),
            def("dismounts", flag, Tag.Byte(0i8)),
            field("sound", optional_sound),
            field("hit_sound", optional_sound),
        ]
        let piercing = self.record(piercing_fields)
        self.set("piercing_weapon", piercing)
        let condition_fields: List<StreamField> = [
            field("max_duration_ticks", var_int),
            def("min_speed", float, Tag.Float(0.0f32)),
            def("min_relative_speed", float, Tag.Float(0.0f32)),
        ]
        let condition = self.record(condition_fields)
        let optional_condition = self.optional(condition)
        let kinetic_fields: List<StreamField> = [
            def("contact_cooldown_ticks", var_int, Tag.Int(10)),
            def("delay_ticks", var_int, Tag.Int(0)),
            field("dismount_conditions", optional_condition),
            field("knockback_conditions", optional_condition),
            field("damage_conditions", optional_condition),
            def("forward_movement", float, Tag.Float(0.0f32)),
            def("damage_multiplier", float, Tag.Float(1.0f32)),
            field("sound", optional_sound),
            field("hit_sound", optional_sound),
        ]
        let kinetic = self.record(kinetic_fields)
        self.set("kinetic_weapon", kinetic)
        let swing_type = self.enumerated(["none", "whack", "stab"], Bound.Zero)
        let swing_fields: List<StreamField> = [def("type", swing_type, Tag.Str(String("whack"))), def("duration", var_int, Tag.Int(6))]
        let swing = self.record(swing_fields)
        self.set("attack_animation", swing)
        self.set("interact_animation", swing)

        // `PotionContents.STREAM_CODEC` and the stew's effects.
        let potion = self.registry("minecraft:potion")
        let optional_potion = self.optional(potion)
        let optional_int = self.optional(int)
        let potion_fields: List<StreamField> = [
            field("potion", optional_potion),
            field("custom_color", optional_int),
            def("custom_effects", effect_instances, empty_list()),
            field("custom_name", optional_utf),
        ]
        let potion_contents = self.record(potion_fields)
        self.set("potion_contents", potion_contents)
        let stew_fields: List<StreamField> = [field("id", mob_effect), def("duration", var_int, Tag.Int(160))]
        let stew_effect = self.record(stew_fields)
        let stew = self.list(stew_effect, MAX)
        self.set("suspicious_stew_effects", stew)

        // Books' pages, each `Filterable`: the raw text, and the filtered if there's one.
        let page_text = self.add(Stream.Utf(1024))
        let optional_page_text = self.optional(page_text)
        let writable_page_fields: List<StreamField> = [field("raw", page_text), field("filtered", optional_page_text)]
        let writable_page = self.record(writable_page_fields)
        let writable_pages = self.list(writable_page, 100)
        let writable_fields: List<StreamField> = [def("pages", writable_pages, empty_list())]
        let writable = self.record(writable_fields)
        self.set("writable_book_content", writable)
        let title_text = self.add(Stream.Utf(32))
        let optional_title_text = self.optional(title_text)
        let title_fields: List<StreamField> = [field("raw", title_text), field("filtered", optional_title_text)]
        let title = self.record(title_fields)
        let written_page_fields: List<StreamField> = [field("raw", text), field("filtered", optional_text)]
        let written_page = self.record(written_page_fields)
        let written_pages = self.list(written_page, MAX)
        let written_fields: List<StreamField> = [
            field("title", title),
            field("author", utf),
            def("generation", var_int, Tag.Int(0)),
            def("pages", written_pages, empty_list()),
            def("resolved", flag, Tag.Byte(0i8)),
        ]
        let written = self.record(written_fields)
        self.set("written_book_content", written)

        // The registries' entries that can go in full: trims, instruments and songs.
        let material_fields: List<StreamField> = [field("palette_id", id), field("description", text)]
        let material_direct = self.record(material_fields)
        let material = self.add(Stream.Holder(String("minecraft:trim_material"), material_direct))
        let pattern_fields: List<StreamField> = [field("asset_id", id), field("description", text), def("decal", flag, Tag.Byte(0i8))]
        let pattern_direct = self.record(pattern_fields)
        let trim_pattern = self.add(Stream.Holder(String("minecraft:trim_pattern"), pattern_direct))
        let trim_fields: List<StreamField> = [field("material", material), field("pattern", trim_pattern)]
        let trim = self.record(trim_fields)
        self.set("trim", trim)
        self.set("provides_trim_material", material)
        let instrument_fields: List<StreamField> = [
            field("sound_event", sound),
            field("use_duration", float),
            field("range", float),
            def("durability_damage", var_int, Tag.Int(0)),
            field("description", text),
        ]
        let instrument_direct = self.record(instrument_fields)
        let instrument = self.add(Stream.Holder(String("minecraft:instrument"), instrument_direct))
        self.set("instrument", instrument)
        let song_fields: List<StreamField> = [
            field("sound_event", sound),
            field("description", text),
            field("length_in_seconds", float),
            field("comparator_output", var_int),
        ]
        let song_direct = self.record(song_fields)
        let song = self.add(Stream.Holder(String("minecraft:jukebox_song"), song_direct))
        self.set("jukebox_playable", song)
        let banner_patterns = self.holders("minecraft:banner_pattern")
        self.set("provides_banner_patterns", banner_patterns)
        let banner_fields: List<StreamField> = [field("asset_id", id), field("translation_key", utf)]
        let banner_direct = self.record(banner_fields)
        let banner_pattern = self.add(Stream.Holder(String("minecraft:banner_pattern"), banner_direct))
        let layer_fields: List<StreamField> = [field("pattern", banner_pattern), field("color", dye)]
        let layer = self.record(layer_fields)
        let layers = self.list(layer, MAX)
        self.set("banner_patterns", layers)

        // Entities and block entities in an item, by their type.
        let entity_type = self.registry("minecraft:entity_type")
        let entity_data = self.add(Stream.Typed(entity_type))
        self.set("entity_data", entity_data)
        let block_entity_type = self.registry("minecraft:block_entity_type")
        let block_entity_data = self.add(Stream.Typed(block_entity_type))
        self.set("block_entity_data", block_entity_data)
        let bee_fields: List<StreamField> = [field("entity_data", entity_data), field("ticks_in_hive", var_int), field("min_ticks_in_hive", var_int)]
        let bee = self.record(bee_fields)
        let bees = self.list(bee, MAX)
        self.set("bees", bees)
        let properties = self.add(Stream.Map(utf, utf, Held.OpenHash))
        self.set("block_state", properties)

        let global_fields: List<StreamField> = [field("dimension", id), field("pos", pos)]
        let global = self.record(global_fields)
        let optional_global = self.optional(global)
        let lodestone_fields: List<StreamField> = [field("target", optional_global), def("tracked", flag, Tag.Byte(1i8))]
        let lodestone = self.record(lodestone_fields)
        self.set("lodestone_tracker", lodestone)
        let shape = self.enumerated(["small_ball", "large_ball", "star", "creeper", "burst"], Bound.Zero)
        let explosion_fields: List<StreamField> = [
            field("shape", shape),
            def("colors", ints, empty_list()),
            def("fade_colors", ints, empty_list()),
            def("has_trail", flag, Tag.Byte(0i8)),
            def("has_twinkle", flag, Tag.Byte(0i8)),
        ]
        let explosion = self.record(explosion_fields)
        self.set("firework_explosion", explosion)
        let explosions = self.list(explosion, 256)
        let fireworks_fields: List<StreamField> = [def("flight_duration", unsigned_byte, Tag.Byte(0i8)), def("explosions", explosions, empty_list())]
        let fireworks = self.record(fireworks_fields)
        self.set("fireworks", fireworks)

        // `ResolvableProfile.STREAM_CODEC`: a whole profile, or part of one, then the skin it shows.
        let player_name = self.add(Stream.Utf(16))
        let optional_name = self.optional(player_name)
        let optional_uuid = self.optional(uuid)
        let property_name = self.add(Stream.Utf(64))
        let signature = self.add(Stream.Utf(1024))
        let optional_signature = self.optional(signature)
        let property_fields: List<StreamField> = [field("name", property_name), field("value", utf), field("signature", optional_signature)]
        let property = self.record(property_fields)
        let property_map = self.add(Stream.Properties(property))
        let whole_fields: List<StreamField> = [field("id", uuid), field("name", player_name), def("properties", property_map, empty_list())]
        let whole = self.record(whole_fields)
        let part_fields: List<StreamField> = [field("name", optional_name), field("id", optional_uuid), def("properties", property_map, empty_list())]
        let part = self.record(part_fields)
        let either = self.add(Stream.Either(whole, part, Side.Profile))
        let model_type = self.add(Stream.Flag(String("wide"), String("slim")))
        let optional_model = self.optional(model_type)
        let skin_fields: List<StreamField> = [
            field("texture", optional_id), field("cape", optional_id), field("elytra", optional_id), field("model", optional_model),
        ]
        let skin = self.record(skin_fields)
        let profile_parts: List<usize> = [either, skin]
        let profile = self.add(Stream.Inline(profile_parts))
        self.set("profile", profile)

        // Fuels, compost and how far mobs see.
        let number_int = self.add(Stream.Either(int, id, Side.Number))
        let number_float = self.add(Stream.Either(float, id, Side.Number))
        let compost_fields: List<StreamField> = [field("layers", number_int)]
        let compost = self.record(compost_fields)
        self.set("compostable", compost)
        let cooking_fields: List<StreamField> = [field("burn_time", number_int), field("speed_multiplier", number_float)]
        let cooking = self.record(cooking_fields)
        self.set("cooking_fuel", cooking)
        let brewing_fields: List<StreamField> = [field("uses", number_int), field("speed_multiplier", number_float)]
        let brewing = self.record(brewing_fields)
        self.set("brewing_fuel", brewing)
        let visibility_fields: List<StreamField> = [field("targeting_entity_types", entity_types), field("visibility", float)]
        let visibility = self.record(visibility_fields)
        self.set("mob_visibility", visibility)
        let break_sound = sound
        self.set("break_sound", break_sound)

        // `SignText.STREAM_CODEC`: four lines, the four a filter shows where they differ, the
        // color, and whether they glow.
        let lines = self.add(Stream.Fixed(text, 4))
        let optional_lines = self.optional(lines)
        let sign_fields: List<StreamField> = [
            field("messages", lines),
            field("filtered_messages", optional_lines),
            def("color", dye, Tag.Str(String("black"))),
            def("has_glowing_text", flag, Tag.Byte(0i8)),
        ]
        let sign = self.record(sign_fields)
        self.set("sign_text_front", sign)
        self.set("sign_text_back", sign)
    }

    /// Whether Calcite has the stream codec of the component type `name`, its whole ID.
    pub fn has(self, name: String) -> bool {
        return self.types.contains(name)
    }

    /// Writes `value`, the NBT its codec writes, with the stream at `at`, with the maps in it in
    /// the order `hint`, what it was read from, gives them. What can't be written is refused, as
    /// vanilla's encoder throws.
    pub fn write(self, at: usize, value: Tag, hint: Json, r: Registries, w: mut Writer) {
        match self.all[at] {
            Stream.VarInt => w.varint(value.int_value() ?? 0),
            Stream.Int => w.i32(value.int_value() ?? 0),
            Stream.Float => w.f32(value.number_float() ?? 0.0f32),
            Stream.Double => w.f64(value.number_double() ?? 0.0),
            Stream.Bool => w.bool((value.byte_value() ?? 0) != 0),
            Stream.UnsignedByte => w.varint(unsigned(value)),
            Stream.Amplifier => w.varint(unsigned(value)),
            Stream.Utf(max) => w.string(text_of(value), max),
            Stream.Id => w.string(text_of(value), 32767),
            Stream.Unit => {},
            Stream.Nbt => w.nbt(value),
            Stream.Decoded(_, _) => w.nbt(value),
            Stream.Compound => w.nbt(value),
            Stream.Snbt => {
                match parse_snbt(text_of(value)) {
                    ok(tag) => w.nbt(tag),
                    err(_) => w.refuse(String("an NBT predicate that isn't SNBT")),
                }
            },
            Stream.UniqueId => {
                let ints = value.int_stream() ?? List<i32>()
                if ints.len() != 4 {
                    w.refuse(String("a UUID that isn't four ints"))
                    return
                }
                w.uuid(Uuid.from_ints(ints))
            },
            Stream.Pos => {
                let p = value.int_stream() ?? List<i32>()
                if p.len() != 3 {
                    w.refuse(String("a position that isn't three ints"))
                    return
                }
                w.i64(((i64(p[0]) & 0x3FFFFFF) << 38) | ((i64(p[2]) & 0x3FFFFFF) << 12) | (i64(p[1]) & 0xFFF))
            },
            Stream.Names(list, _) => {
                let name = text_of(value)
                for i in 0..list.len() {
                    if list[i] == name {
                        w.varint(i32.wrap(i))
                        return
                    }
                }
                w.refuse("no ID for {name}")
            },
            Stream.Sparse(ids) => {
                let name = text_of(value)
                for (id, each) in ids {
                    if each == name {
                        w.varint(id)
                        return
                    }
                }
                w.refuse("no ID for {name}")
            },
            Stream.Flag(off, on) => {
                let name = text_of(value)
                if name == on {
                    w.bool(true)
                } else if name == off {
                    w.bool(false)
                } else {
                    w.refuse("no value for {name}")
                }
            },
            Stream.Registry(registry) => {
                let name = text_of(value)
                match network_id(r, registry.copy(), name.copy()) {
                    some(id) => w.varint(id),
                    none => w.refuse("Can't find id for '{name}' in registry {registry}"),
                }
            },
            Stream.Holder(registry, direct) => {
                match value {
                    Tag.Str(name) => {
                        match network_id(r, registry.copy(), name.copy()) {
                            some(id) => w.varint(id + 1),
                            none => w.refuse("Can't find id for '{name}' in registry {registry}"),
                        }
                    },
                    _ => {
                        w.varint(0)
                        self.write(direct, value, hint, r, mut w)
                    },
                }
            },
            Stream.HolderSet(registry) => {
                var entries = List<String>()
                match value {
                    Tag.Str(s) => {
                        if s.starts_with("#") {
                            w.varint(0)
                            w.string(s[1..].copy(), 32767)
                            return
                        }
                        entries.push(s.copy())
                    },
                    Tag.List(items) => {
                        for each in items {
                            entries.push(text_of(each))
                        }
                    },
                    _ => {
                        w.refuse(String("a holder set that isn't a tag or entries"))
                        return
                    },
                }
                w.varint(i32.wrap(entries.len()) + 1)
                for name in entries {
                    match network_id(r, registry.copy(), name.copy()) {
                        some(id) => w.varint(id),
                        none => w.refuse("Can't find id for '{name}' in registry {registry}"),
                    }
                }
            },
            Stream.ListOf(of, max) => {
                let items = list_of(value)
                w.count_at_most(items.len(), max)
                for i in 0..items.len() {
                    self.write(of, items[i], item_at(hint, i), r, mut w)
                }
            },
            Stream.Compact(of) => {
                match value {
                    Tag.List(items) => {
                        w.count(items.len())
                        for i in 0..items.len() {
                            self.write(of, items[i], item_at(hint, i), r, mut w)
                        }
                    },
                    _ => {
                        w.count(1)
                        self.write(of, value, hint, r, mut w)
                    },
                }
            },
            Stream.Fixed(of, n) => {
                let items = list_of(value)
                if items.len() != n {
                    w.refuse("Expected {n} elements, but got {items.len()}")
                    return
                }
                for i in 0..items.len() {
                    self.write(of, items[i], item_at(hint, i), r, mut w)
                }
            },
            Stream.Set(of) => {
                let items = list_of(value)
                w.count(items.len())
                for i in 0..items.len() {
                    self.write(of, items[i], item_at(hint, i), r, mut w)
                }
            },
            Stream.Properties(of) => {
                let items = list_of(value)
                w.count_at_most(items.len(), 16)
                for i in 0..items.len() {
                    self.write(of, items[i], item_at(hint, i), r, mut w)
                }
            },
            Stream.Optional(of) => {
                w.bool(true)
                self.write(of, value, hint, r, mut w)
            },
            Stream.Record(fields) => {
                let m = compound_of(value)
                for f in fields {
                    if m.contains(f.name.copy()) {
                        self.write(f.of, m[f.name.copy()], member_of(hint, f.name.copy()), r, mut w)
                    } else if let d = f.absent {
                        self.write(f.of, d, Json.Null, r, mut w)
                    } else {
                        match self.all[f.of] {
                            Stream.Optional(_) => w.bool(false),
                            _ => w.refuse("a record with no `{f.name}`"),
                        }
                    }
                }
            },
            Stream.Inline(parts) => {
                for part in parts {
                    self.write(part, value, hint, r, mut w)
                }
            },
            Stream.Map(key, of, _) => {
                let m = compound_of(value)
                let keys = ordered(m, hint)
                w.count(keys.len())
                for (k, part) in keys {
                    self.write(key, Tag.Str(k.copy()), Json.Null, r, mut w)
                    self.write(of, m[k.copy()], part, r, mut w)
                }
            },
            Stream.Either(left, right, side) => {
                let first = match side {
                    Side.Profile => member_of(hint, partial_key()) == Json.Null and has_field(value, "id") and has_field(value, "name"),
                    Side.Text => is_text(value),
                    Side.Number => not is_text(value),
                }
                w.bool(first)
                self.write(if first { left } else { right }, value, hint, r, mut w)
            },
            Stream.Dispatch(key, name, kinds) => {
                let m = compound_of(value)
                let kind = if m.contains(name.copy()) { text_of(m[name.copy()]) } else { String() }
                self.write(key, Tag.Str(kind.copy()), Json.Null, r, mut w)
                for (each, of) in kinds {
                    if each == kind {
                        self.write(of, value, hint, r, mut w)
                        return
                    }
                }
                w.refuse("no kind {kind}")
            },
            Stream.Typed(kind) => {
                var m = compound_of(value)
                let id = if m.contains(String("id")) { m[String("id")].copy() } else { Tag.End }
                self.write(kind, id, Json.Null, r, mut w)
                _ = m.remove(String("id"))
                w.nbt(Tag.Compound(m))
            },
            Stream.Slots(of) => {
                let items = list_of(value)
                var n: usize = 0
                for each in items {
                    let slot = usize.wrap(field_tag(each, "slot").int_value() ?? 0)
                    if slot + 1 > n {
                        n = slot + 1
                    }
                }
                // The slots it came with, past the last filled one.
                match hint {
                    Json.Array(given) => {
                        for each in given {
                            match member_of(each, slots_key()) {
                                Json.Number(text) => {
                                    let more = usize.wrap(i64.parse(text) ?? 0)
                                    if more > n {
                                        n = more
                                    }
                                },
                                _ => {},
                            }
                        }
                    },
                    _ => {},
                }
                w.count_at_most(n, 256)
                for slot in 0..n {
                    var found: Tag? = none
                    var part = Json.Null
                    for i in 0..items.len() {
                        if usize.wrap(field_tag(items[i], "slot").int_value() ?? 0) == slot {
                            found = some(field_tag(items[i], "item"))
                            part = member_of(item_at(hint, i), String("item"))
                        }
                    }
                    match found {
                        some(t) => {
                            w.bool(true)
                            self.write(of, t, part, r, mut w)
                        },
                        none => w.bool(false),
                    }
                }
            },
            Stream.Template => {
                var item = String()
                var count: i32 = 1
                var components = empty_compound()
                var components_hint = Json.Null
                match value {
                    Tag.Str(s) => item = s.copy(),
                    Tag.Compound(m) => {
                        if m.contains(String("id")) {
                            item = text_of(m[String("id")])
                        }
                        if m.contains(String("count")) {
                            count = m[String("count")].int_value() ?? 1
                        }
                        if m.contains(String("components")) {
                            components = m[String("components")].copy()
                        }
                        components_hint = member_of(hint, String("components"))
                    },
                    _ => {},
                }
                match network_id(r, String("minecraft:item"), item.copy()) {
                    some(id) => w.varint(id),
                    none => {
                        w.refuse("no item {item}")
                        return
                    },
                }
                w.varint(count)
                self.write_patch_of(components, components_hint, r, mut w)
            },
            Stream.Patch => self.write_patch_of(value, hint, r, mut w),
            Stream.Exact => {
                let m = compound_of(value)
                let keys = ordered(m, hint)
                w.count(keys.len())
                for (k, part) in keys {
                    let id = network_id(r, String("minecraft:data_component_type"), k.copy()) else {
                        w.refuse("no component type {k}")
                        return
                    }
                    w.varint(id)
                    let of = self.types.get(k.copy()) else {
                        w.refuse("Calcite sends the component {k} not yet")
                        return
                    }
                    self.write(of, m[k.copy()], part, r, mut w)
                }
            },
            Stream.Partial => {
                let m = compound_of(value)
                let keys = ordered(m, hint)
                w.count_at_most(keys.len(), 64)
                for (k, _) in keys {
                    if let id = network_id(r, String("minecraft:data_component_predicate_type"), k.copy()) {
                        w.bool(true)
                        w.varint(id)
                    } else if let id = network_id(r, String("minecraft:data_component_type"), k.copy()) {
                        w.bool(false)
                        w.varint(id)
                    } else {
                        w.refuse("no component test {k}")
                        return
                    }
                    w.nbt(m[k.copy()])
                }
            },
        }
    }

    /// Reads a value with the stream at `at`, as the NBT its codec can read, as typed JSON: a
    /// record's fields with their names, an optional field that isn't there left out.
    pub fn read(self, at: usize, rd: mut Reader, c: Codecs, r: Registries) -> Json ! DecodeError {
        match self.all[at] {
            Stream.VarInt => return number(try rd.varint()),
            Stream.Int => return number(try rd.i32()),
            Stream.Float => return Tag.float(try rd.f32()).to_typed_json(),
            Stream.Double => return Tag.double(try rd.f64()).to_typed_json(),
            Stream.Bool => return truth(try rd.bool()),
            Stream.UnsignedByte => return number(try rd.varint()),
            Stream.Amplifier => {
                let v = try rd.varint()
                return number(if v < 0 { 0 } else if v > 255 { 255 } else { v })
            },
            Stream.Utf(max) => return Json.Str(try rd.string(max)),
            Stream.Id => return Json.Str((try read_id(mut rd)).to_string()),
            Stream.Unit => return Json.Object(List<Member>()),
            Stream.Nbt => return (try rd.nbt(Accounter.with_quota(2097152))).to_typed_json(),
            Stream.Decoded(name, trusted) => {
                let tag = try rd.nbt(if trusted { Accounter.unlimited() } else { Accounter.with_quota(2097152) })
                let codec = c.find(name.copy()) else fail DecodeError { message: "Calcite reads the stream of {name} not yet" }
                var refs = Refs.new()
                var got = c.read(codec, tag.to_typed_json(), r, mut refs)
                if let e = got.error.take() {
                    fail DecodeError { message: "io.netty.handler.codec.DecoderException: Failed to decode: {e} {tag.to_snbt()}" }
                }
                return (got.value.take() ?? Tag.End).to_typed_json()
            },
            Stream.Compound => return (try read_compound(mut rd)).to_typed_json(),
            Stream.Snbt => return Json.Str((try read_compound(mut rd)).to_snbt()),
            Stream.UniqueId => {
                let u = try rd.uuid()
                return Tag.IntArray(u.ints()).to_typed_json()
            },
            Stream.Pos => {
                let l = try rd.i64()
                let p: List<i32> = [i32.wrap(l >> 38), i32.wrap((l << 52) >> 52), i32.wrap((l << 26) >> 38)]
                return Tag.IntArray(p).to_typed_json()
            },
            Stream.Names(list, bound) => {
                let i = try rd.varint()
                let n = i32.wrap(list.len())
                var k = i
                if i < 0 or i >= n {
                    k = match bound {
                        Bound.Zero => 0,
                        Bound.Clamp => if i < 0 { 0 } else { n - 1 },
                        Bound.Wrap => ((i % n) + n) % n,
                    }
                }
                return Json.Str(list[usize.wrap(k)].copy())
            },
            Stream.Sparse(ids) => {
                let i = try rd.varint()
                var fallback = String()
                var first = true
                for (id, name) in ids {
                    if first {
                        fallback = name.copy()
                        first = false
                    }
                    if id == i {
                        return Json.Str(name.copy())
                    }
                }
                return Json.Str(fallback)
            },
            Stream.Flag(off, on) => return Json.Str(if try rd.bool() { on.copy() } else { off.copy() }),
            Stream.Registry(registry) => {
                let id = try rd.varint()
                let name = entry_of(r, registry.copy(), id) else fail no_value(id)
                return Json.Str(name)
            },
            Stream.Holder(registry, direct) => {
                let id = try rd.varint()
                if id == 0 {
                    return try self.read(direct, mut rd, c, r)
                }
                let entry = i32.wrap(i64(id) - 1)
                let name = entry_of(r, registry.copy(), entry) else fail no_value(entry)
                return Json.Str(name)
            },
            Stream.HolderSet(registry) => {
                let n = i64(try rd.varint()) - 1
                if n < -1 {
                    fail DecodeError { message: "java.lang.IllegalArgumentException: Illegal Capacity: {n}" }
                }
                if n == -1 {
                    let tag = try read_id(mut rd)
                    if not has_tag(r, registry.copy(), tag.copy()) {
                        fail DecodeError { message: String("java.util.NoSuchElementException: No value present") }
                    }
                    return Json.Str("#{tag.to_string()}")
                }
                var items = List<Json>()
                var i: i64 = 0
                while i < n {
                    let id = try rd.varint()
                    let name = entry_of(r, registry.copy(), id) else fail no_value(id)
                    items.push(Json.Str(name))
                    i += 1
                }
                return Json.Array(items)
            },
            Stream.ListOf(of, max) => {
                let n = try list_count(mut rd, max, Made.Array)
                var items = List<Json>()
                for _ in 0..n {
                    items.push(try self.read(of, mut rd, c, r))
                }
                return Json.Array(items)
            },
            Stream.Compact(of) => {
                let n = try list_count(mut rd, MAX, Made.Array)
                var items = List<Json>()
                for _ in 0..n {
                    items.push(try self.read(of, mut rd, c, r))
                }
                return Json.Array(items)
            },
            Stream.Fixed(of, n) => {
                var items = List<Json>()
                for _ in 0..n {
                    items.push(try self.read(of, mut rd, c, r))
                }
                return Json.Array(items)
            },
            Stream.Set(of) => {
                let n = try list_count(mut rd, MAX, Made.Hashed)
                var items = List<Json>()
                var seen = List<String>()
                for _ in 0..n {
                    let v = try self.read(of, mut rd, c, r)
                    let key = json_text(v)
                    if not seen.contains(key) {
                        seen.push(key.copy())
                        items.push(v)
                    }
                }
                return Json.Array(items)
            },
            Stream.Properties(of) => {
                let n = try list_count(mut rd, 16, Made.Loop)
                var items = List<Json>()
                for _ in 0..n {
                    items.push(try self.read(of, mut rd, c, r))
                }
                return Json.Array(items)
            },
            Stream.Optional(of) => {
                if not try rd.bool() {
                    return Json.Null
                }
                return try self.read(of, mut rd, c, r)
            },
            Stream.Record(fields) => {
                var members = List<Member>()
                for f in fields {
                    let v = try self.read(f.of, mut rd, c, r)
                    if v != Json.Null {
                        members.push(Member { key: f.name.copy(), value: v })
                    }
                }
                return Json.Object(members)
            },
            Stream.Inline(parts) => {
                var members = List<Member>()
                for part in parts {
                    match try self.read(part, mut rd, c, r) {
                        Json.Object(more) => {
                            for m in more {
                                members.push(Member { key: m.key.copy(), value: m.value.copy() })
                            }
                        },
                        _ => {},
                    }
                }
                return Json.Object(members)
            },
            Stream.Map(key, of, held) => {
                let made = match held {
                    Held.InList => Made.Array,
                    _ => Made.Hashed,
                }
                let n = try list_count(mut rd, MAX, made)
                var members = List<Member>()
                for _ in 0..n {
                    let k = json_text(try self.read(key, mut rd, c, r))
                    let v = try self.read(of, mut rd, c, r)
                    put_member(mut members, k, v)
                }
                match held {
                    Held.OpenHash => return Json.Object(open_hash_order(members, n)),
                    _ => {},
                }
                return Json.Object(members)
            },
            Stream.Either(left, right, side) => {
                if try rd.bool() {
                    return try self.read(left, mut rd, c, r)
                }
                let v = try self.read(right, mut rd, c, r)
                // A part of a profile stays one, though it has an ID and a name as a whole one has.
                match side {
                    Side.Profile => {
                        match v {
                            Json.Object(members) => {
                                var marked = members.copy()
                                marked.push(Member { key: partial_key(), value: truth(true) })
                                return Json.Object(marked)
                            },
                            _ => {},
                        }
                    },
                    _ => {},
                }
                return v
            },
            Stream.Dispatch(key, name, kinds) => {
                let kind = json_text(try self.read(key, mut rd, c, r))
                for (each, of) in kinds {
                    if each == kind {
                        var members = List<Member>()
                        members.push(Member { key: name.copy(), value: Json.Str(kind.copy()) })
                        match try self.read(of, mut rd, c, r) {
                            Json.Object(more) => {
                                for m in more {
                                    members.push(Member { key: m.key.copy(), value: m.value.copy() })
                                }
                            },
                            _ => {},
                        }
                        return Json.Object(members)
                    }
                }
                fail DecodeError { message: "Calcite reads the stream of {kind} not yet" }
            },
            Stream.Typed(kind) => {
                let id = try self.read(kind, mut rd, c, r)
                let data = try read_compound(mut rd)
                var members = List<Member>()
                members.push(Member { key: String("id"), value: id })
                match data {
                    Tag.Compound(m) => {
                        for (k, v) in m {
                            if k != "id" {
                                members.push(Member { key: k.copy(), value: v.to_typed_json() })
                            }
                        }
                    },
                    _ => {},
                }
                return Json.Object(members)
            },
            Stream.Slots(of) => {
                let n = try list_count(mut rd, 256, Made.Array)
                var items = List<Json>()
                for slot in 0..n {
                    if try rd.bool() {
                        let v = try self.read(of, mut rd, c, r)
                        var members = List<Member>()
                        members.push(Member { key: String("slot"), value: number(i32.wrap(slot)) })
                        members.push(Member { key: String("item"), value: v })
                        items.push(Json.Object(members))
                    }
                }
                // Vanilla keeps the empty slots after the last filled one, which the slots don't
                // say, so the last says how many there were, where its codec doesn't read it.
                let last = items.len()
                if last > 0 {
                    let filled = usize.wrap(i64.parse(json_number(member_of(items[last - 1], String("slot")))) ?? 0)
                    if filled + 1 < n {
                        var marked = match items[last - 1] {
                            Json.Object(members) => members.copy(),
                            _ => List<Member>(),
                        }
                        marked.push(Member { key: slots_key(), value: number(i32.wrap(n)) })
                        items[last - 1] = Json.Object(marked)
                    }
                }
                return Json.Array(items)
            },
            Stream.Template => {
                let id = try rd.varint()
                let item = entry_of(r, String("minecraft:item"), id) else fail no_value(id)
                let count = try rd.varint()
                let patch = try self.read_patch(mut rd, c, r)
                if count == 0 or item == "minecraft:air" {
                    fail DecodeError { message: String("java.lang.IllegalStateException: Item must be non-empty") }
                }
                var members = List<Member>()
                members.push(Member { key: String("id"), value: Json.Str(item) })
                members.push(Member { key: String("count"), value: number(count) })
                if not patch.is_empty() {
                    members.push(Member { key: String("components"), value: Json.Object(patch) })
                }
                return Json.Object(members)
            },
            Stream.Patch => return Json.Object(try self.read_patch(mut rd, c, r)),
            Stream.Exact => {
                let n = try list_count(mut rd, MAX, Made.Array)
                var members = List<Member>()
                for _ in 0..n {
                    let type_id = try rd.varint()
                    let name = entry_of(r, String("minecraft:data_component_type"), type_id) else fail no_value(type_id)
                    let of = self.types.get(name.copy()) else fail DecodeError { message: "Calcite reads the stream of {name} not yet" }
                    let v = try self.read(of, mut rd, c, r)
                    put_member(mut members, name, v)
                }
                return Json.Object(members)
            },
            Stream.Partial => {
                let n = try list_count(mut rd, 64, Made.Array)
                var members = List<Member>()
                for _ in 0..n {
                    let test = try rd.bool()
                    let id = try rd.varint()
                    let registry = if test { String("minecraft:data_component_predicate_type") } else { String("minecraft:data_component_type") }
                    let name = entry_of(r, registry, id) else fail no_value(id)
                    let v = (try rd.nbt(Accounter.with_quota(2097152))).to_typed_json()
                    put_member(mut members, name, v)
                }
                return Json.Object(members)
            },
        }
    }

    /// Reads a patch as `DataComponentPatch.STREAM_CODEC` does: how many types it sets and takes
    /// away, each it sets by its type's network ID and its value, then each it takes away, into
    /// an array map, where a type given again keeps its place and takes the later value. Each
    /// member is a type's whole ID, or `!` and one taken away, with `{}`.
    pub fn read_patch(self, rd: mut Reader, c: Codecs, r: Registries) -> List<Member> ! DecodeError {
        let added = try rd.varint()
        let removed = try rd.varint()
        var out = List<Member>()
        if added == 0 and removed == 0 {
            return out
        }
        let total = i32.wrap(i64(added) + i64(removed))
        if total < 0 {
            fail DecodeError { message: "java.lang.NegativeArraySizeException: {total}" }
        }
        var i: i32 = 0
        while i < added {
            let type_id = try rd.varint()
            let name = entry_of(r, String("minecraft:data_component_type"), type_id) else fail no_value(type_id)
            let at = self.types.get(name.copy()) else fail DecodeError { message: "Calcite reads the stream of {name} not yet" }
            let v = try self.read(at, mut rd, c, r)
            put_component(mut out, name, some(v))
            i += 1
        }
        i = 0
        while i < removed {
            let type_id = try rd.varint()
            let name = entry_of(r, String("minecraft:data_component_type"), type_id) else fail no_value(type_id)
            put_component(mut out, name, none)
            i += 1
        }
        return out
    }

    /// Writes the patch `components`, each a component's whole ID, or `!` and the ID of one taken
    /// away, with its value as its codec writes it and the value it was read from, in the patch's
    /// order, as `DataComponentPatch.STREAM_CODEC` writes it: how many it sets and takes away,
    /// each it sets by its type's network ID and its value, then each it takes away.
    pub fn write_patch(self, components: List<(String, Tag, Json)>, r: Registries, w: mut Writer) {
        var added: i32 = 0
        var removed: i32 = 0
        for (k, _, _) in components {
            if k.starts_with("!") {
                removed += 1
            } else {
                added += 1
            }
        }
        w.varint(added)
        w.varint(removed)
        for (k, v, hint) in components {
            if k.starts_with("!") {
                continue
            }
            let id = network_id(r, String("minecraft:data_component_type"), k.copy()) else {
                w.refuse("no component type {k}")
                return
            }
            w.varint(id)
            let at = self.types.get(k.copy()) else {
                w.refuse("Calcite sends the component {k} not yet")
                return
            }
            self.write(at, v, hint, r, mut w)
        }
        for (k, _, _) in components {
            if not k.starts_with("!") {
                continue
            }
            let name = k[1..].copy()
            let id = network_id(r, String("minecraft:data_component_type"), name.copy()) else {
                w.refuse("no component type {name}")
                return
            }
            w.varint(id)
        }
    }

    // A patch held as a compound, in the order `hint` gives.
    fn write_patch_of(self, value: Tag, hint: Json, r: Registries, w: mut Writer) {
        let m = compound_of(value)
        var components = List<(String, Tag, Json)>()
        for (k, part) in ordered(m, hint) {
            components.push((k.copy(), m[k.copy()].copy(), part.copy()))
        }
        self.write_patch(components, r, mut w)
    }

    /// Writes the stack `stack`, as `ItemStack.CODEC` writes it to NBT, or `none` for an empty
    /// one, read from `hint`, whose order its patch keeps, as its array map does, as
    /// `ItemStack.OPTIONAL_STREAM_CODEC` writes it: its count, 0 for an empty one, its item by
    /// its network ID, and its patch.
    pub fn write_stack(self, stack: Tag?, hint: Json, r: Registries, w: mut Writer) {
        let m = match stack {
            some(Tag.Compound(m)) => m.copy(),
            _ => {
                w.varint(0)
                return
            },
        }
        let count = if m.contains(String("count")) { m[String("count")].int_value() ?? 1 } else { 1 }
        let item = text_of(if m.contains(String("id")) { m[String("id")].copy() } else { Tag.End })
        var components = List<(String, Tag, Json)>()
        if m.contains(String("components")) {
            let patch = compound_of(m[String("components")])
            for (k, part) in ordered(patch, member_of(hint, String("components"))) {
                components.push((k.copy(), patch[k.copy()].copy(), part.copy()))
            }
        }
        self.write_parts(item, count, components, r, mut w)
    }

    /// Writes a stack of `count` of `item`, a whole ID, with the patch `components`, as
    /// `write_patch` takes one: 0 for an empty one, which air or no items is.
    pub fn write_parts(self, item: String, count: i32, components: List<(String, Tag, Json)>, r: Registries, w: mut Writer) {
        if count <= 0 or item == "minecraft:air" {
            w.varint(0)
            return
        }
        w.varint(count)
        match network_id(r, String("minecraft:item"), item.copy()) {
            some(id) => w.varint(id),
            none => {
                w.refuse("no item {item}")
                return
            },
        }
        self.write_patch(components, r, mut w)
    }

    /// Reads a stack as `ItemStack.OPTIONAL_STREAM_CODEC` does: its count, and if it's more
    /// than 0, its item and its patch. A type or an entry that isn't there throws as
    /// `IdMap.byIdOrThrow` does.
    pub fn read_stack(self, rd: mut Reader, c: Codecs, r: Registries) -> Decoded {
        let count = match rd.varint() {
            ok(n) => n,
            err(e) => return Decoded.Bad(e.message),
        }
        if count <= 0 {
            return Decoded.Empty
        }
        let item_id = match rd.varint() {
            ok(n) => n,
            err(e) => return Decoded.Bad(e.message),
        }
        let item = entry_of(r, String("minecraft:item"), item_id) else {
            return Decoded.Bad("java.lang.IllegalArgumentException: No value with id {item_id}")
        }
        let patch = match self.read_patch(mut rd, c, r) {
            ok(p) => p,
            err(e) => {
                let prefix = "Calcite reads the stream of "
                if e.message.starts_with(prefix) {
                    return Decoded.Missing(e.message[prefix.len()..e.message.len() - 8].copy())
                }
                return Decoded.Bad(e.message)
            },
        }
        // Air in any number is an empty stack, once its patch is read.
        if item == "minecraft:air" {
            return Decoded.Empty
        }
        var components = List<(String, Json?)>()
        for m in patch {
            if m.key.starts_with("!") {
                components.push((m.key[1..].copy(), none))
            } else {
                components.push((m.key.copy(), some(m.value.copy())))
            }
        }
        return Decoded.Stack(WireStack { item: item, count: count, patch: components })
    }
}

// What `IdMap.byIdOrThrow` throws for an ID that isn't there.
fn no_value(id: i32) -> DecodeError {
    return DecodeError { message: "java.lang.IllegalArgumentException: No value with id {id}" }
}

// A collection's count, as `ByteBufCodecs.readCount` reads it: more than `max` throws, and so
// does fewer than none, as what it's `made` as is made with it, but for a loop, which takes none.
fn list_count(rd: mut Reader, max: usize, made: Made) -> usize ! DecodeError {
    let n = try rd.varint()
    if n < 0 {
        return match made {
            Made.Array => {
                fail DecodeError { message: "java.lang.IllegalArgumentException: Illegal Capacity: {n}" }
            },
            Made.Hashed => {
                fail DecodeError { message: String("java.lang.IllegalArgumentException: The expected number of elements must be nonnegative") }
            },
            Made.Loop => 0,
        }
    }
    if usize.wrap(n) > max {
        fail DecodeError { message: "{n} elements exceeded max size of: {max}" }
    }
    return usize.wrap(n)
}

// `Identifier.STREAM_CODEC`: a string, parsed.
fn read_id(rd: mut Reader) -> Identifier ! DecodeError {
    let s = try rd.string(32767)
    return match Identifier.parse(s.copy()) {
        ok(id) => id,
        err(e) => {
            fail DecodeError { message: "net.minecraft.IdentifierException: Non [a-z0-9_.-] character in namespace of location: {s} {e}" }
        },
    }
}

// `ByteBufCodecs.COMPOUND_TAG`: NBT that must be a compound.
fn read_compound(rd: mut Reader) -> Tag ! DecodeError {
    let tag = try rd.nbt(Accounter.with_quota(2097152))
    return match tag {
        Tag.Compound(_) => tag,
        _ => {
            fail DecodeError { message: "io.netty.handler.codec.DecoderException: Not a compound tag: {tag.to_snbt()}" }
        },
    }
}

// What an unsigned byte holds: a byte's bits, or the int the network gave.
fn unsigned(value: Tag) -> i32 {
    return match value {
        Tag.Byte(b) => i32(b) & 0xFF,
        _ => value.int_value() ?? 0,
    }
}

fn number(v: i32) -> Json {
    return Json.Number("{v}")
}

fn truth(v: bool) -> Json {
    return Json.Number(if v { String("1b") } else { String("0b") })
}

// A string's text, or nothing.
fn json_text(v: Json) -> String {
    return match v {
        Json.Str(s) => s.copy(),
        _ => String(),
    }
}

// Puts `value` at `key` in `members`, where it is if it's there, as a map's `put` does.
fn put_member(members: mut List<Member>, key: String, value: own Json) {
    for i in 0..members.len() {
        if members[i].key == key {
            members[i] = Member { key: key.copy(), value: value }
            return
        }
    }
    members.push(Member { key: key.copy(), value: value })
}

// Puts the component `name` in a patch, with its value or taken away, where the type is if it's
// there already, as the patch's array map does.
fn put_component(members: mut List<Member>, name: String, value: own Json?) {
    let removed = "!{name}"
    let (key, v) = match value {
        some(v) => (name.copy(), v),
        none => (removed.copy(), Json.Object(List<Member>())),
    }
    for i in 0..members.len() {
        if members[i].key == name or members[i].key == removed {
            members[i] = Member { key: key, value: v }
            return
        }
    }
    members.push(Member { key: key, value: v })
}

// The order an `Object2ObjectOpenHashMap` made for `expected` entries, as `ByteBufCodecs.map`
// makes it, iterates `members` in: each key in the slot its mixed hash finds, the next free one
// after it where that's taken, and the slots from the last to the first.
fn open_hash_order(members: List<Member>, expected: usize) -> List<Member> {
    var want = expected
    if want > 65536 {
        want = 65536
    }
    // `HashCommon.arraySize(expected, 0.75)`: a power of two at least `expected / 0.75`, and 2.
    let need = (want * 4 + 2) / 3
    var size: usize = 2
    while size < need {
        size *= 2
    }
    var slots = List<i64>()
    for _ in 0..size {
        slots.push(-1)
    }
    let mask = size - 1
    for i in 0..members.len() {
        let h = mix(string_hash(members[i].key.copy()))
        var place = usize.wrap(i64(h) & i64.wrap(mask))
        while slots[place] != -1 {
            place = (place + 1) & mask
        }
        slots[place] = i64.wrap(i)
    }
    var out = List<Member>()
    var place = size
    while place > 0 {
        place -= 1
        if slots[place] != -1 {
            let m = members[usize.wrap(slots[place])].copy()
            out.push(m)
        }
    }
    return out
}

// `HashCommon.mix`.
fn mix(x: i32) -> i32 {
    let h = x.wrapping_mul(-1640531527)
    return h ^ (h >>> 16)
}

// Whether the registry `registry` has the tag `id`.
fn has_tag(r: Registries, registry: String, id: Identifier) -> bool {
    if let s = r.find(registry.copy()) {
        return r.synced[s].has_tag(id)
    }
    if let w = r.find_world(registry.copy()) {
        return r.world[w].has_tag(id)
    }
    if let b = r.find_builtin(registry) {
        return r.builtin[b].has_tag(id)
    }
    return false
}

// The keys of `m` in the order `hint`, the value it was read from, gives them, each with its part
// of `hint`, a key given as an ID found as its whole ID; then those `hint` doesn't give, in `m`'s
// order.
fn ordered(m: JavaHashMap<String, Tag>, hint: Json) -> List<(String, Json)> {
    var out = List<(String, Json)>()
    var seen = List<String>()
    match hint {
        Json.Object(members) => {
            for each in members {
                var k = each.key.copy()
                if not m.contains(k.copy()) {
                    k = whole_key(k)
                }
                if m.contains(k.copy()) and not seen.contains(k) {
                    seen.push(k.copy())
                    out.push((k, each.value.copy()))
                }
            }
        },
        _ => {},
    }
    for (k, _) in m {
        if not seen.contains(k) {
            out.push((k.copy(), Json.Null))
        }
    }
    return out
}

// A key as a whole ID, with the `!` of a component taken away kept.
fn whole_key(key: String) -> String {
    let removed = key.starts_with("!")
    let rest = if removed { key[1..].copy() } else { key.copy() }
    return match Identifier.parse(rest) {
        ok(id) => if removed { "!{id.to_string()}" } else { id.to_string() },
        err(_) => key.copy(),
    }
}

fn member_of(hint: Json, name: String) -> Json {
    match hint {
        Json.Object(members) => {
            for m in members {
                if m.key == name {
                    return m.value.copy()
                }
            }
        },
        _ => {},
    }
    return Json.Null
}

fn item_at(hint: Json, i: usize) -> Json {
    return match hint {
        Json.Array(items) => if i < items.len() { items[i].copy() } else { Json.Null },
        _ => Json.Null,
    }
}

fn compound_of(value: Tag) -> JavaHashMap<String, Tag> {
    return match value {
        Tag.Compound(m) => m.copy(),
        _ => JavaHashMap<String, Tag>(),
    }
}

fn list_of(value: Tag) -> List<Tag> {
    return match value {
        Tag.List(items) => items.copy(),
        _ => List<Tag>(),
    }
}

fn field_tag(value: Tag, name: str) -> Tag {
    return match value {
        Tag.Compound(m) => if m.contains(String(name)) { m[String(name)].copy() } else { Tag.End },
        _ => Tag.End,
    }
}

fn has_field(value: Tag, name: str) -> bool {
    return match value {
        Tag.Compound(m) => m.contains(String(name)),
        _ => false,
    }
}

fn is_text(value: Tag) -> bool {
    return match value {
        Tag.Str(_) => true,
        _ => false,
    }
}

// A string tag's text, or nothing.
fn text_of(value: Tag) -> String {
    return match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}

/// The network ID of `entry` in the registry `registry`, both whole IDs: its ID in the
/// synchronized registry, as clients are sent it, or in the built-in one.
pub fn network_id(r: Registries, registry: String, entry: String) -> i32? {
    let id = match Identifier.parse(entry) {
        ok(id) => id,
        err(_) => return none,
    }
    if let s = r.find(registry.copy()) {
        return r.synced[s].id(id)
    }
    if let b = r.find_builtin(registry) {
        return r.builtin[b].id(id)
    }
    return none
}

/// The entry with the network ID `id` in the registry `registry`, its whole ID, or `none`.
pub fn entry_of(r: Registries, registry: String, id: i32) -> String? {
    if id < 0 {
        return none
    }
    let i = usize.wrap(id)
    if let s = r.find(registry.copy()) {
        if i < r.synced[s].entries.len() {
            return some(r.synced[s].entries[i].to_string())
        }
        return none
    }
    if let b = r.find_builtin(registry) {
        if i < r.builtin[b].entries.len() {
            return some(r.builtin[b].entries[i].to_string())
        }
    }
    return none
}
