/// Advancements' codecs, described for `registry.codec` (CAL-164): `Advancement.CODEC`, an
/// advancement's parent, how it's shown, its rewards, its criteria, each by the trigger
/// `CriteriaTriggers` registers under its name with the conditions that trigger reads, and
/// which of them it needs. Each reads what vanilla's codec reads from a data pack's
/// `advancement/` and gives what it writes back, with vanilla's messages for what doesn't read:
/// criteria that are empty, a root shown without a background or another with one, and
/// requirements that aren't the criteria.
///
/// What's written always has its requirements: those it was given, or, as vanilla makes them
/// where there are none, each criterion alone, in the order the criteria are given. Two things
/// can't be vanilla's: where requirements name two criteria that aren't there, or leave out two
/// that are, vanilla lists them in the order of a `Map.copyOf`'s keys, which changes from run to
/// run, and of a hash set's, where Calcite lists them as they're given; and vanilla's warnings of
/// a criterion's conditions that need what its trigger doesn't give, which it only logs, aren't
/// made, as a loot table's aren't.
module registry.advancements

import json.tree.{Json, Member}
import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Field, HolderCodec, Many, MapOf, Read, Refs, Then}
import registry.codecs.{bool_codec, by_name, def, field, i32_codec, id, item_stack_template, opt, positive_int, req, string, text}
import registry.loot.{condition}
import registry.loot_tables.{loot_table}
import registry.predicates.{damage, damage_source, distance, doubles, holder_set, ints, item, location, mob_effects, potions, state_properties, any_range}
import registry.recipes.{recipe}
import registry.registries.{Registries}

/// `Advancement.CODEC`: an advancement, with its requirements, checked as vanilla checks it.
pub fn advancement(c: mut Codecs) -> usize {
    if let at = c.find(String("advancement")) {
        return at
    }
    let fields = advancement_fields(mut c)
    c.name(String("advancement fields"), fields)
    return c.shared(String("advancement"), Codec.Nested(read_advancement))
}

// The fields of `Advancement.CODEC`'s record, before its requirements are made and it's checked.
fn advancement_fields(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let s = string(mut c)
    let names = c.add(Codec.ListOf(Many { of: s }))
    let requirements = c.add(Codec.ListOf(Many { of: names }))
    let one = criterion(mut c)
    let criteria = c.add(Codec.MapOf(MapOf { key: s, value: one }))
    let some_criteria = c.add(Codec.Then(Then { of: criteria, then: check_criteria, with: Tag.End }))
    let fields: List<Field> = [
        opt("parent", id(mut c)),
        opt("display", display(mut c)),
        def("rewards", rewards(mut c), no_rewards()),
        req("criteria", some_criteria),
        opt("requirements", requirements),
        def("sends_telemetry_event", flag, Tag.Byte(0i8)),
    ]
    return c.add(Codec.Record(fields))
}

// `AdvancementRewards.EMPTY`, as it's written.
fn no_rewards() -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("experience"), Tag.Int(0))
    m.insert(String("loot"), Tag.List(List<Tag>()))
    m.insert(String("recipes"), Tag.List(List<Tag>()))
    return Tag.Compound(m)
}

// `CRITERIA_CODEC`'s check: there's at least one.
fn check_criteria(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.Compound(m) => {
            if m.is_empty() {
                return Read.bad(String("Advancement criteria cannot be empty"))
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// An advancement's record, with its requirements where it gave none, `allOf` its criteria as the
// JSON gives them, then checked as `Advancement.validate` checks it.
fn read_advancement(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    let at = c.find(String("advancement fields")) else return Read.bad(String("there's no advancement codec"))
    var got = c.read(at, value, r, mut refs)
    if not got.is_ok() {
        return got
    }
    let read = got.value.take() else return got
    let Tag.Compound(m) = read else return Read.ok(read.copy())
    var out = m.copy()
    if not out.contains("requirements") {
        var all = List<Tag>()
        for name in criteria_order(value) {
            all.push(Tag.List([Tag.Str(name.copy())]))
        }
        out.insert(String("requirements"), Tag.List(all))
    }
    let root = not out.contains("parent")
    let shown = field(Tag.Compound(out.copy()), String("display"))
    let visible = shown != Tag.End
    let background = visible and field(shown, String("background")) != Tag.End
    if root and visible and not background {
        return Read.bad(String("Visible advancement roots must have background"))
    }
    if not root and background {
        return Read.bad(String("Only advancement roots can have background"))
    }
    if let e = mismatch(criteria_order(value), out["requirements"]) {
        return Read.bad(e)
    }
    return Read.ok(Tag.Compound(out))
}

// The names of the criteria of the advancement `value`, as its JSON gives them.
fn criteria_order(value: Json) -> List<String> {
    var out = List<String>()
    let Json.Object(members) = value else return out
    for m in members {
        if m.key != "criteria" {
            continue
        }
        let Json.Object(criteria) = m.value else return out
        for k in criteria {
            out.push(k.key.copy())
        }
    }
    return out
}

// What `AdvancementRequirements.validate` says of `requirements` against the criteria `expected`,
// or `none` where each criterion is named and nothing else is.
fn mismatch(expected: List<String>, requirements: Tag) -> String? {
    var named = List<String>()
    let Tag.List(sets) = requirements else return none
    for set in sets {
        let Tag.List(names) = set else continue
        if names.is_empty() and expected.is_empty() {
            return some(String("Requirement entry cannot be empty"))
        }
        for n in names {
            let Tag.Str(s) = n else continue
            if not named.contains(s) {
                named.push(s.copy())
            }
        }
    }
    var missing = List<String>()
    for e in expected {
        if not named.contains(e) {
            missing.push(e.copy())
        }
    }
    var unknown = List<String>()
    for n in named {
        if not expected.contains(n) {
            unknown.push(n.copy())
        }
    }
    if missing.is_empty() and unknown.is_empty() {
        return none
    }
    return some("Advancement completion requirements did not exactly match specified criteria. Missing: [{listed(missing)}]. Unknown: [{listed(unknown)}]")
}

// Names as `AbstractCollection.toString` lists them, between its brackets.
fn listed(names: List<String>) -> String {
    var out = String()
    for i in 0..names.len() {
        if i > 0 {
            out.push_str(", ")
        }
        out.push_str(names[i])
    }
    return out
}

// `DisplayInfo.CODEC`: an advancement's icon, title and description, its tab's background, its
// frame, and whether it's toasted, announced and hidden.
fn display(c: mut Codecs) -> usize {
    let flag = bool_codec(mut c)
    let words = text(mut c)
    let frame = c.add(Codec.Names(["task", "challenge", "goal"]))
    let fields: List<Field> = [
        req("icon", item_stack_template(mut c)),
        req("title", words),
        req("description", words),
        opt("background", id(mut c)),
        def("frame", frame, Tag.Str(String("task"))),
        def("show_toast", flag, Tag.Byte(1i8)),
        def("announce_to_chat", flag, Tag.Byte(1i8)),
        def("hidden", flag, Tag.Byte(0i8)),
    ]
    return c.add(Codec.Record(fields))
}

// `AdvancementRewards.CODEC`: the experience, loot, recipes and function an advancement gives.
fn rewards(c: mut Codecs) -> usize {
    let ids = id(mut c)
    let fields: List<Field> = [
        def("experience", i32_codec(mut c), Tag.Int(0)),
        def("loot", loot_tables(mut c), Tag.List(List<Tag>())),
        def("recipes", c.add(Codec.ListOf(Many { of: ids })), Tag.List(List<Tag>())),
        opt("function", ids),
    ]
    return c.add(Codec.Record(fields))
}

// `LootTable.LIST_CODEC`: a tag of loot tables, or tables by ID or given in full.
fn loot_tables(c: mut Codecs) -> usize {
    let direct = loot_table(mut c)
    return c.shared(String("loot tables"), Codec.Holders(HolderCodec { registry: "minecraft:loot_table", inline: some(direct) }))
}

// `Recipe.LIST_CODEC`: a tag of recipes, or recipes by ID or given in full.
fn recipes(c: mut Codecs) -> usize {
    let direct = recipe(mut c)
    return c.shared(String("recipes"), Codec.Holders(HolderCodec { registry: "minecraft:recipe", inline: some(direct) }))
}

/// `Criterion.CODEC`: a criterion, by the trigger its `trigger` names, with the conditions it
/// reads from its `conditions`, or from nothing where there are none, written only where they
/// aren't empty, as `ExtraCodecs.dispatchOptionalValue` reads and writes them.
pub fn criterion(c: mut Codecs) -> usize {
    if let at = c.find(String("criterion")) {
        return at
    }
    let types = by_name(mut c, "minecraft:trigger_type")
    c.name(String("trigger type"), types)
    for (name, fields) in triggers(mut c) {
        let at = c.add(Codec.Record(fields.copy()))
        c.name("trigger minecraft:{name}", at)
    }
    return c.shared(String("criterion"), Codec.Nested(read_criterion))
}

// A criterion: its trigger, from `trigger`, then that trigger's conditions, from `conditions`, or
// from an empty object where it isn't there.
fn read_criterion(c: Codecs, value: Json, r: Registries, refs: mut Refs) -> Read {
    let Json.Object(members) = value else return Read.bad(c.not_map(value))
    var trigger: Json? = none
    var conditions = Json.Object(List<Member>())
    for m in members {
        if m.key == "trigger" {
            trigger = some(m.value.copy())
        } else if m.key == "conditions" {
            conditions = m.value.copy()
        }
    }
    let t = trigger else return Read.bad("Missing \"trigger\" in: MapLike[{c.shown(value)}]")
    let types = c.find(String("trigger type")) else return Read.bad(String("there's no trigger codec"))
    var name = c.read(types, t, r, mut refs)
    if not name.is_ok() {
        return name
    }
    let Tag.Str(kind) = name.value.take() ?? Tag.End else return Read.bad(String("not a trigger"))
    let at = c.find("trigger {kind}") else return Read.bad("no codec for the trigger {kind}")
    // What its conditions read, with the trigger, partly where they partly read.
    var got = c.read(at, conditions, r, mut refs)
    let v = got.value.take() else return got
    var out = JavaHashMap<String, Tag>()
    out.insert(String("trigger"), Tag.Str(kind.copy()))
    if v != Tag.Compound(JavaHashMap<String, Tag>()) {
        out.insert(String("conditions"), v)
    }
    return Read { value: some(Tag.Compound(out)), error: got.error.take(), thrown: got.thrown.take() }
}

// Each trigger `CriteriaTriggers` registers, by its name, with the fields of its instance's
// codec, its player's condition first, as each reads it.
fn triggers(c: mut Codecs) -> List<(String, List<Field>)> {
    let cond = condition(mut c)
    let conds = c.add(Codec.ListOf(Many { of: cond }))
    let stack = item(mut c)
    let stacks = c.add(Codec.ListOf(Many { of: stack }))
    let n = ints(mut c)
    let d = doubles(mut c)
    let blocks = holder_set(mut c, "minecraft:block")
    let state = state_properties(mut c)
    let place = location(mut c)
    let far = distance(mut c)
    let made = recipes(mut c)
    let slot_fields: List<Field> = [def("occupied", n, any_range()), def("full", n, any_range()), def("empty", n, any_range())]
    let slots = c.add(Codec.Record(slot_fields))
    let killed: List<Field> = [opt("entity", cond), opt("killing_blow", damage_source(mut c))]
    let crafted: List<Field> = [req("recipes", made), def("ingredients", stacks, Tag.List(List<Tag>()))]
    let moved: List<Field> = [opt("start_position", place), opt("distance", far)]
    let used_on: List<Field> = [opt("location", cond)]
    let item_entity: List<Field> = [opt("item", stack), opt("entity", cond)]
    let just_item: List<Field> = [opt("item", stack)]
    let bare: List<Field> = []
    let out: List<(String, List<Field>)> = [
        (String("impossible"), List<Field>()),
        (String("player_killed_entity"), killed.copy()),
        (String("entity_killed_player"), killed.copy()),
        (String("enter_block"), [opt("blocks", blocks), opt("state", state)]),
        (String("inventory_changed"), [def("slots", slots, any_range()), def("items", stacks, Tag.List(List<Tag>()))]),
        (String("recipe_unlocked"), [req("recipes", made)]),
        (String("player_hurt_entity"), [opt("damage", damage(mut c)), opt("entity", cond)]),
        (String("entity_hurt_player"), [opt("damage", damage(mut c))]),
        (String("enchanted_item"), [opt("item", stack), def("levels", n, any_range())]),
        (String("filled_bucket"), just_item.copy()),
        (String("brewed_potion"), [opt("potion", potions(mut c))]),
        (String("construct_beacon"), [def("level", n, any_range())]),
        (String("used_ender_eye"), [def("distance", d, any_range())]),
        (String("summoned_entity"), [opt("entity", cond)]),
        (String("bred_animals"), [opt("parent", cond), opt("partner", cond), opt("child", cond)]),
        (String("location"), bare.copy()),
        (String("slept_in_bed"), bare.copy()),
        (String("cured_zombie_villager"), [opt("zombie", cond), opt("villager", cond)]),
        (String("villager_trade"), [opt("villager", cond), opt("item", stack)]),
        (String("item_durability_changed"), [opt("item", stack), def("durability", n, any_range()), def("delta", n, any_range())]),
        (String("levitation"), [opt("distance", far), def("duration", n, any_range())]),
        (String("changed_dimension"), [opt("from", id(mut c)), opt("to", id(mut c))]),
        (String("tick"), bare.copy()),
        (String("tame_animal"), [opt("entity", cond)]),
        (String("placed_block"), used_on.copy()),
        (String("consume_item"), just_item.copy()),
        (String("effects_changed"), [opt("effects", mob_effects(mut c)), opt("source", cond)]),
        (String("used_totem"), just_item.copy()),
        (String("nether_travel"), moved.copy()),
        (String("fishing_rod_hooked"), [opt("rod", stack), opt("entity", cond), opt("item", stack)]),
        (String("channeled_lightning"), [def("victims", conds, Tag.List(List<Tag>()))]),
        (String("shot_crossbow"), just_item.copy()),
        (String("spear_mobs"), [opt("count", positive_int(mut c))]),
        (String("killed_by_arrow"), [def("victims", conds, Tag.List(List<Tag>())), def("unique_entity_types", n, any_range()), opt("fired_from_weapon", stack)]),
        (String("hero_of_the_village"), bare.copy()),
        (String("voluntary_exile"), bare.copy()),
        (String("slide_down_block"), [opt("blocks", blocks), opt("state", state)]),
        (String("bee_nest_destroyed"), [opt("blocks", blocks), opt("state", state), opt("item", stack), def("num_bees_inside", n, any_range())]),
        (String("target_hit"), [def("signal_strength", n, any_range()), opt("projectile", cond)]),
        (String("item_used_on_block"), used_on.copy()),
        (String("default_block_use"), used_on.copy()),
        (String("any_block_use"), used_on.copy()),
        (String("player_generates_container_loot"), [req("loot_tables", loot_tables(mut c))]),
        (String("thrown_item_picked_up_by_entity"), item_entity.copy()),
        (String("thrown_item_picked_up_by_player"), item_entity.copy()),
        (String("player_interacted_with_entity"), item_entity.copy()),
        (String("player_sheared_equipment"), item_entity.copy()),
        (String("started_riding"), bare.copy()),
        (String("lightning_strike"), [opt("lightning", cond), opt("bystander", cond)]),
        (String("using_item"), just_item.copy()),
        (String("fall_from_height"), moved.copy()),
        (String("ride_entity_in_lava"), moved.copy()),
        (String("kill_mob_near_sculk_catalyst"), killed.copy()),
        (String("allay_drop_item_on_block"), used_on.copy()),
        (String("avoid_vibration"), bare.copy()),
        (String("recipe_crafted"), crafted.copy()),
        (String("crafter_recipe_crafted"), crafted.copy()),
        (String("fall_after_explosion"), [opt("start_position", place), opt("distance", far), opt("cause", cond)]),
    ]
    // Every trigger but the impossible one reads its player's condition first.
    var all = List<(String, List<Field>)>()
    for i in 0..out.len() {
        var fields = List<Field>()
        if i > 0 {
            fields.push(opt("player", cond))
        }
        for f in out[i].1 {
            fields.push(f.copy())
        }
        all.push((out[i].0.copy(), fields))
    }
    return all
}
