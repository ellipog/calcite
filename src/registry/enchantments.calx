/// Enchantments' codec, described for `registry.codec`: what an enchantment is, its cost and
/// slots, and its effects, each a component that holds values that grow with its level, things
/// it does to entities and places, and the conditions they need. It reads what vanilla's
/// `Enchantment.DIRECT_CODEC` reads from a data pack and gives what it writes back, which is what
/// clients are sent.
module registry.enchantments

import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Dispatched, Field, HolderCodec, HolderKind, IntRange, Kinds, Many, MapOf, Read, Then}
import registry.codecs.{block_predicate, block_state_provider, bool_codec, by_name, checked, def, f32_codec, field, float_bounds, float_provider, float_tag, i32_codec, id, inline, non_negative_int, opt, origin, particle, positive_float, registry_codec, req, sound, string, text, vec3, vec3i}
import registry.loot.{condition, level_based_value}
import registry.predicates.{holder_set, slot_groups}
import registry.validation.{check_effects}

/// `Enchantment.DIRECT_CODEC`: an enchantment in full.
pub fn enchantment(c: mut Codecs) -> usize {
    let key = String("enchantment direct")
    if let at = c.find(key) {
        return at
    }
    let i = i32_codec(mut c)
    let items = holder_set(mut c, "minecraft:item")
    let cost_fields: List<Field> = [req("base", i), req("per_level_above_first", i)]
    let cost = c.add(Codec.Record(cost_fields))
    let weight = c.add(Codec.Int(IntRange { min: 1, max: 1024, before: "Value must be within range [1;1024]: " }))
    let max_level = c.add(Codec.Int(IntRange { min: 1, max: 255, before: "Value must be within range [1;255]: " }))
    let slot = slot_groups(mut c)
    let slots = c.add(Codec.ListOf(Many { of: slot }))
    let definition_fields: List<Field> = [
        req("supported_items", items),
        opt("primary_items", items),
        req("weight", weight),
        req("max_level", max_level),
        req("min_cost", cost),
        req("max_cost", cost),
        req("anvil_cost", non_negative_int(mut c)),
        req("slots", slots),
    ]
    let definition = c.add(Codec.Record(definition_fields))
    let description = text(mut c)
    let exclusive = holder_set(mut c, "minecraft:enchantment")
    let effects = effect_components(mut c)
    let fields: List<Field> = [
        req("description", description),
        inline(definition),
        def("exclusive_set", exclusive, Tag.List(List<Tag>())),
        def("effects", effects, Tag.Compound(JavaHashMap<String, Tag>())),
    ]
    return c.shared(key, Codec.Record(fields))
}

// `EnchantmentEffectComponents.CODEC`: each effect component by its type, most of them lists of
// effects with the conditions they need, each list checked against the parameters its context
// has (`validatedListCodec`).
fn effect_components(c: mut Codecs) -> usize {
    let value = value_effect(mut c)
    let entity = entity_effect(mut c)
    let location = location_effect(mut c)
    let requirements = condition(mut c)
    let damage_values = conditional_list(mut c, value, "enchanted_damage")
    let item_values = conditional_list(mut c, value, "enchanted_item")
    let entity_values = conditional_list(mut c, value, "enchanted_entity")
    let no_fields: List<Field> = []
    let unit = c.add(Codec.Record(no_fields))
    let immunity = conditional_list(mut c, unit, "enchanted_damage")
    let targets = c.add(Codec.Names(["attacker", "damaging_entity", "victim"]))
    let targeted_fields: List<Field> = [
        req("enchanted", targets),
        req("affected", targets),
        req("effect", entity),
        opt("requirements", requirements),
    ]
    let targeted = c.add(Codec.Record(targeted_fields))
    let attacks = c.add(Codec.ListOf(Many { of: targeted }))
    let post_attack = validated(mut c, attacks, "enchanted_damage")
    let drop_targets = c.add(Codec.Names(["attacker", "victim"]))
    let drops_fields: List<Field> = [req("enchanted", drop_targets), req("effect", value), opt("requirements", requirements)]
    let drop = c.add(Codec.Record(drops_fields))
    let drop_list = c.add(Codec.ListOf(Many { of: drop }))
    let drops = validated(mut c, drop_list, "enchanted_damage")
    let damage_entities = conditional_list(mut c, entity, "enchanted_damage")
    let block_entities = conditional_list(mut c, entity, "hit_block")
    let entity_entities = conditional_list(mut c, entity, "enchanted_entity")
    let locations = conditional_list(mut c, location, "enchanted_location")
    let attribute = attribute_effect(mut c)
    let attributes = c.add(Codec.ListOf(Many { of: attribute }))
    let s = sound(mut c)
    let charging_fields: List<Field> = [opt("start", s), opt("mid", s), opt("end", s)]
    let charging = c.add(Codec.Record(charging_fields))
    let chargings = c.add(Codec.ListOf(Many { of: charging }))
    let sounds = c.add(Codec.ListOf(Many { of: s }))
    var all = List<(String, usize)>()
    for name in ["damage_protection", "damage", "smash_damage_per_fallen_block", "knockback", "armor_effectiveness"] {
        all.push(("minecraft:{name}", damage_values))
    }
    for name in ["item_damage", "ammo_use", "projectile_piercing", "block_experience", "repair_with_xp"] {
        all.push(("minecraft:{name}", item_values))
    }
    for name in ["projectile_spread", "projectile_count", "trident_return_acceleration", "fishing_time_reduction", "fishing_luck_bonus", "mob_experience"] {
        all.push(("minecraft:{name}", entity_values))
    }
    all.push((String("minecraft:post_piercing_attack"), damage_entities))
    all.push((String("minecraft:hit_block"), block_entities))
    for name in ["tick", "projectile_spawned"] {
        all.push(("minecraft:{name}", entity_entities))
    }
    let others: List<(String, usize)> = [
        ("minecraft:damage_immunity", immunity),
        ("minecraft:post_attack", post_attack),
        ("minecraft:equipment_drops", drops),
        ("minecraft:location_changed", locations),
        ("minecraft:attributes", attributes),
        ("minecraft:crossbow_charge_time", value),
        ("minecraft:crossbow_charging_sounds", chargings),
        ("minecraft:trident_sound", sounds),
        ("minecraft:prevent_equipment_drop", unit),
        ("minecraft:prevent_armor_change", unit),
        ("minecraft:trident_spin_attack_strength", value),
    ]
    for (name, of) in others {
        all.push((name.copy(), of))
    }
    let key = by_name(mut c, "minecraft:enchantment_effect_component_type")
    return c.add(Codec.Dispatched(Dispatched { key: key, values: all }))
}

// A list of `ConditionalEffect.codec(effect)`: each an effect, and the condition it needs, which
// may use only the parameters of the context `set`.
fn conditional_list(c: mut Codecs, effect: usize, set: str) -> usize {
    let requirements = condition(mut c)
    let fields: List<Field> = [req("effect", effect), opt("requirements", requirements)]
    let one = c.add(Codec.Record(fields))
    let list = c.add(Codec.ListOf(Many { of: one }))
    return validated(mut c, list, set)
}

// `validatedListCodec`'s check: `list`'s conditions use only the parameters of the context `set`.
fn validated(c: mut Codecs, list: usize, set: str) -> usize {
    return c.add(Codec.Then(Then { of: list, then: check_effects, with: Tag.Str(String(set)) }))
}

// `EnchantmentValueEffect.CODEC`: what's done to a value, such as damage, by its kind.
fn value_effect(c: mut Codecs) -> usize {
    return c.named(String("enchantment value effect"), make_value_effect)
}

fn make_value_effect(c: mut Codecs) -> Codec {
    let me = value_effect(mut c)
    let lbv = level_based_value(mut c)
    let list = c.add(Codec.ListOf(Many { of: me }))
    let value_fields: List<Field> = [req("value", lbv)]
    let set = c.add(Codec.Record(value_fields))
    let all_fields: List<Field> = [req("effects", list)]
    let factor_fields: List<Field> = [req("factor", lbv)]
    let chance_fields: List<Field> = [req("chance", lbv)]
    let exponential_fields: List<Field> = [req("base", lbv), req("exponent", lbv)]
    let kinds: List<(String, usize)> = [
        ("minecraft:add", set),
        ("minecraft:all_of", c.add(Codec.Record(all_fields))),
        ("minecraft:multiply", c.add(Codec.Record(factor_fields))),
        ("minecraft:remove_binomial", c.add(Codec.Record(chance_fields))),
        ("minecraft:exponential", c.add(Codec.Record(exponential_fields))),
        ("minecraft:set", set),
    ]
    let by = by_name(mut c, "minecraft:enchantment_value_effect_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `EnchantmentEntityEffect.CODEC`: what's done to an entity, by its kind.
fn entity_effect(c: mut Codecs) -> usize {
    return c.named(String("enchantment entity effect"), make_entity_effect)
}

fn make_entity_effect(c: mut Codecs) -> Codec {
    let me = entity_effect(mut c)
    let kinds = effect_kinds(mut c, me)
    let by = by_name(mut c, "minecraft:enchantment_entity_effect_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `EnchantmentLocationBasedEffect.CODEC`: what's done where an entity is, by its kind, which is
// what's done to an entity or an attribute it has while it's there.
fn location_effect(c: mut Codecs) -> usize {
    return c.named(String("enchantment location based effect"), make_location_effect)
}

fn make_location_effect(c: mut Codecs) -> Codec {
    let me = location_effect(mut c)
    var kinds = effect_kinds(mut c, me)
    kinds.push((String("minecraft:attribute"), attribute_effect(mut c)))
    let by = by_name(mut c, "minecraft:enchantment_location_based_effect_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// The kinds entity effects and location based ones share, where `all_of` holds a list of `me`.
fn effect_kinds(c: mut Codecs, me: usize) -> List<(String, usize)> {
    let lbv = level_based_value(mut c)
    let flag = bool_codec(mut c)
    let list = c.add(Codec.ListOf(Many { of: me }))
    let all_fields: List<Field> = [req("effects", list)]
    let mob_effects = holder_set(mut c, "minecraft:mob_effect")
    let mob_effect_fields: List<Field> = [
        req("to_apply", mob_effects),
        req("min_duration", lbv),
        req("max_duration", lbv),
        req("min_amplifier", lbv),
        req("max_amplifier", lbv),
    ]
    let amount_fields: List<Field> = [req("amount", lbv)]
    let amount = c.add(Codec.Record(amount_fields))
    let damage = damage_type(mut c)
    let damage_fields: List<Field> = [req("min_damage", lbv), req("max_damage", lbv), req("damage_type", damage)]
    let ignite_fields: List<Field> = [req("duration", lbv)]
    let v = vec3(mut c)
    let impulse_fields: List<Field> = [req("direction", v), req("coordinate_scale", v), req("magnitude", lbv)]
    let function_fields: List<Field> = [req("function", id(mut c))]
    let offset = vec3i(mut c)
    let event = game_event(mut c)
    let s = string(mut c)
    let properties = c.add(Codec.MapOf(MapOf { key: s, value: s }))
    let properties_fields: List<Field> = [
        req("properties", properties),
        def("offset", offset, origin()),
        opt("trigger_game_event", event),
    ]
    let entity_types = holder_set(mut c, "minecraft:entity_type")
    let summon_fields: List<Field> = [req("entity", entity_types), def("join_team", flag, Tag.Byte(0i8))]
    return [
        ("minecraft:all_of", c.add(Codec.Record(all_fields))),
        ("minecraft:apply_mob_effect", c.add(Codec.Record(mob_effect_fields))),
        ("minecraft:change_item_damage", amount),
        ("minecraft:damage_entity", c.add(Codec.Record(damage_fields))),
        ("minecraft:explode", explode(mut c)),
        ("minecraft:ignite", c.add(Codec.Record(ignite_fields))),
        ("minecraft:apply_impulse", c.add(Codec.Record(impulse_fields))),
        ("minecraft:apply_exhaustion", amount),
        ("minecraft:play_sound", play_sound(mut c)),
        ("minecraft:replace_block", replace_block(mut c)),
        ("minecraft:replace_disk", replace_disk(mut c)),
        ("minecraft:run_function", c.add(Codec.Record(function_fields))),
        ("minecraft:set_block_properties", c.add(Codec.Record(properties_fields))),
        ("minecraft:spawn_particles", spawn_particles(mut c)),
        ("minecraft:summon_entity", c.add(Codec.Record(summon_fields))),
    ]
}

// `DamageType.CODEC`: a damage type by its ID, or given in full.
fn damage_type(c: mut Codecs) -> usize {
    let key = String("damage type holder")
    if let at = c.find(key) {
        return at
    }
    let direct = registry_codec(mut c, "damage_type")
    return c.shared(key, Codec.Holder(HolderCodec { registry: "minecraft:damage_type", inline: direct }))
}

// `GameEvent.CODEC`: a game event by its ID.
fn game_event(c: mut Codecs) -> usize {
    return c.shared(String("game event holder"), Codec.Holder(HolderCodec { registry: "minecraft:game_event", inline: none, kind: HolderKind.Fixed }))
}

// `ExplodeEffect.CODEC`.
fn explode(c: mut Codecs) -> usize {
    let lbv = level_based_value(mut c)
    let flag = bool_codec(mut c)
    let f = f32_codec(mut c)
    let p = particle(mut c)
    let blocks = holder_set(mut c, "minecraft:block")
    let damage = damage_type(mut c)
    let interaction = c.add(Codec.Names(["none", "block", "mob", "tnt", "trigger"]))
    let particle_fields: List<Field> = [
        req("particle", p),
        def("scaling", f, Tag.Float(1.0f32)),
        def("speed", f, Tag.Float(1.0f32)),
        req("weight", non_negative_int(mut c)),
    ]
    let block_particle = c.add(Codec.Record(particle_fields))
    let block_particles = c.add(Codec.ListOf(Many { of: block_particle }))
    let zero: List<Tag> = [Tag.Double(0.0), Tag.Double(0.0), Tag.Double(0.0)]
    let fields: List<Field> = [
        def("attribute_to_user", flag, Tag.Byte(0i8)),
        opt("damage_type", damage),
        opt("knockback_multiplier", lbv),
        opt("immune_blocks", blocks),
        def("offset", vec3(mut c), Tag.List(zero)),
        req("radius", lbv),
        def("create_fire", flag, Tag.Byte(0i8)),
        req("block_interaction", interaction),
        req("small_particle", p),
        req("large_particle", p),
        def("block_particles", block_particles, Tag.List(List<Tag>())),
        req("sound", sound(mut c)),
    ]
    return c.add(Codec.Record(fields))
}

// `PlaySoundEffect.CODEC`: a sound, or up to 255 to pick from, written alone where there's one,
// and how loud and high it plays.
fn play_sound(c: mut Codecs) -> usize {
    let s = sound(mut c)
    let list = c.add(Codec.ListOf(Many { of: s, max: 255 }))
    let either = c.add(Codec.Either(list, s))
    let sounds = c.add(Codec.Then(Then { of: either, then: single, with: Tag.End }))
    let volume = float_within(mut c, 0.00001f32, 10.0f32)
    let pitch = float_within(mut c, 0.00001f32, 2.0f32)
    let fields: List<Field> = [req("sound", sounds), req("volume", volume), req("pitch", pitch)]
    return c.add(Codec.Record(fields))
}

// A list of one as `ExtraCodecs.compactListCodec` writes it: the one alone.
fn single(_c: Codecs, value: Tag, _with: Tag) -> Read {
    match value {
        Tag.List(items) => {
            if items.len() == 1 {
                return Read.ok(items[0].copy())
            }
        },
        _ => {},
    }
    return Read.ok(value.copy())
}

// `FloatProviders.codec(least, most)`: a float provider that gives from `least` to `most`.
fn float_within(c: mut Codecs, least: f32, most: f32) -> usize {
    let p = float_provider(mut c)
    let bounds: List<Tag> = [Tag.Float(least), Tag.Float(most)]
    return c.add(Codec.Then(Then { of: p, then: check_within, with: Tag.List(bounds) }))
}

fn check_within(_c: Codecs, value: Tag, with: Tag) -> Read {
    let (least, most) = match with {
        Tag.List(b) => (float_tag(b[0]), float_tag(b[1])),
        _ => (f32.NEG_INFINITY, f32.INFINITY),
    }
    let (min, max) = float_bounds(value)
    if min < least {
        return Read.bad("Value provider too low: {least} [{min}-{max}]")
    }
    if max > most {
        return Read.bad("Value provider too high: {most} [{min}-{max}]")
    }
    return Read.ok(value.copy())
}

// `ReplaceBlock.CODEC`.
fn replace_block(c: mut Codecs) -> usize {
    let fields: List<Field> = [
        def("offset", vec3i(mut c), origin()),
        opt("predicate", block_predicate(mut c)),
        req("block_state", block_state_provider(mut c)),
        opt("trigger_game_event", game_event(mut c)),
    ]
    return c.add(Codec.Record(fields))
}

// `ReplaceDisk.CODEC`.
fn replace_disk(c: mut Codecs) -> usize {
    let lbv = level_based_value(mut c)
    let fields: List<Field> = [
        req("radius", lbv),
        req("height", lbv),
        def("offset", vec3i(mut c), origin()),
        opt("predicate", block_predicate(mut c)),
        req("block_state", block_state_provider(mut c)),
        opt("trigger_game_event", game_event(mut c)),
    ]
    return c.add(Codec.Record(fields))
}

// `SpawnParticlesEffect.CODEC`: a particle, where it starts on each axis and how fast it goes.
fn spawn_particles(c: mut Codecs) -> usize {
    let f = f32_codec(mut c)
    let floats = float_provider(mut c)
    let types = c.add(Codec.Names(["entity_position", "in_bounding_box"]))
    let position_fields: List<Field> = [
        req("type", types),
        def("offset", f, Tag.Float(0.0f32)),
        def("scale", positive_float(mut c), Tag.Float(1.0f32)),
    ]
    let position = checked(mut c, position_fields, check_position)
    let velocity_fields: List<Field> = [def("movement_scale", f, Tag.Float(0.0f32)), def("base", floats, Tag.Float(0.0f32))]
    let velocity = c.add(Codec.Record(velocity_fields))
    let fields: List<Field> = [
        req("particle", particle(mut c)),
        req("horizontal_position", position),
        req("vertical_position", position),
        req("horizontal_velocity", velocity),
        req("vertical_velocity", velocity),
        def("speed", floats, Tag.Float(0.0f32)),
    ]
    return c.add(Codec.Record(fields))
}

// An entity's own position can't be scaled. A scale left out is 1, which isn't written.
fn check_position(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let scaled = match field(value, "scale") {
        Tag.Float(v) => v != 1.0f32,
        _ => false,
    }
    let at_entity = match field(value, "type") {
        Tag.Str(s) => s == "entity_position",
        _ => false,
    }
    if at_entity and scaled {
        return Read.bad(String("Cannot scale an entity position coordinate source"))
    }
    return Read.ok(value.copy())
}

// `EnchantmentAttributeEffect.MAP_CODEC`: a modifier of an attribute, by its ID, that grows with
// the enchantment's level.
fn attribute_effect(c: mut Codecs) -> usize {
    let key = String("enchantment attribute effect")
    if let at = c.find(key) {
        return at
    }
    let operations = c.add(Codec.Names(["add_value", "add_multiplied_base", "add_multiplied_total"]))
    let fields: List<Field> = [
        req("id", id(mut c)),
        req("attribute", by_name(mut c, "minecraft:attribute")),
        req("amount", level_based_value(mut c)),
        req("operation", operations),
    ]
    return c.shared(key, Codec.Record(fields))
}
