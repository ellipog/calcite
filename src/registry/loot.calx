/// Loot's codecs, described for `registry.codec`: the conditions loot and enchantments test, the
/// numbers they're given from what's around them, and the values that grow with an
/// enchantment's level. Each reads what vanilla's codec reads from a data pack and gives what it
/// writes back.
///
/// Predicates, context float providers and context int providers are registries of their own,
/// which vanilla loads after the ones whose entries use them, so while those load, an entry of
/// one can only be given in full, not named; `registry.codec` says so for them.
module registry.loot

import chat.language.{Language}
import nbt.path.{PathError, parse as parse_path}
import nbt.tag.{Tag}
import registry.codec.{Codec, Codecs, Field, FloatRange, HolderCodec, HolderKind, Kinds, Many, MapOf, Read, Then}
import registry.codecs.{attribute_value, bool_codec, by_name, checked, constant_or, def, environment_attributes, f32_codec, field, float_tag, i32_codec, i64_codec, id, kind_of, non_empty, opt, req, string, weighted}
import registry.predicates.{block, damage_source, entity, item, location}

/// `LootContext.EntityTarget.CODEC`: which of the entities around a loot roll is meant.
pub fn entity_target(c: mut Codecs) -> usize {
    return c.shared(String("entity target"), Codec.Names(["this", "attacker", "direct_attacker", "attacking_player", "target_entity", "interacting_entity"]))
}

/// `LevelBasedValue.CODEC`: a float, or one that grows with an enchantment's level by its kind.
pub fn level_based_value(c: mut Codecs) -> usize {
    return c.named(String("level_based_value"), make_level_based_value)
}

fn make_level_based_value(c: mut Codecs) -> Codec {
    let me = level_based_value(mut c)
    let f = f32_codec(mut c)
    let floats = c.add(Codec.ListOf(Many { of: f }))
    let clamped_fields: List<Field> = [req("value", me), req("min", f), req("max", f)]
    let fraction_fields: List<Field> = [req("numerator", me), req("denominator", me)]
    let squared_fields: List<Field> = [req("added", f)]
    let linear_fields: List<Field> = [req("base", f), req("per_level_above_first", f)]
    let exponent_fields: List<Field> = [req("base", me), req("power", me)]
    let lookup_fields: List<Field> = [req("values", floats), req("fallback", me)]
    let kinds: List<(String, usize)> = [
        ("minecraft:clamped", checked(mut c, clamped_fields, check_clamped)),
        ("minecraft:fraction", c.add(Codec.Record(fraction_fields))),
        ("minecraft:levels_squared", c.add(Codec.Record(squared_fields))),
        ("minecraft:linear", c.add(Codec.Record(linear_fields))),
        ("minecraft:exponent", c.add(Codec.Record(exponent_fields))),
        ("minecraft:lookup", c.add(Codec.Record(lookup_fields))),
    ]
    let by = by_name(mut c, "minecraft:enchantment_level_based_value_type")
    let typed = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    return Codec.Either(f, typed)
}

fn check_clamped(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let min = float_tag(field(value, "min"))
    let max = float_tag(field(value, "max"))
    if max <= min {
        return Read.bad("Max must be larger than min, min: {min}, max: {max}")
    }
    return Read.ok(value.copy())
}

/// `ContextFloatProviders.CODEC`: a float from what's around a loot roll, given in full.
pub fn context_float(c: mut Codecs) -> usize {
    return c.named(String("context_float_provider"), make_context_float)
}

fn make_context_float(c: mut Codecs) -> Codec {
    let direct = context_float_direct(mut c)
    return Codec.Holder(HolderCodec { registry: "minecraft:context_float_provider", inline: some(direct) })
}

/// `ContextFloatProviders.LIST_CODEC`: a list of them, or one alone.
pub fn context_floats(c: mut Codecs) -> usize {
    return c.named(String("context_float_providers"), make_context_floats)
}

fn make_context_floats(c: mut Codecs) -> Codec {
    let direct = context_float_direct(mut c)
    return Codec.Holders(HolderCodec { registry: "minecraft:context_float_provider", inline: some(direct) })
}

// `ContextFloatProviders.DIRECT_CODEC`: a float, or a provider of one by its kind, where a
// constant one is written as its value alone.
fn context_float_direct(c: mut Codecs) -> usize {
    return c.named(String("context_float_provider direct"), make_context_float_direct)
}

fn make_context_float_direct(c: mut Codecs) -> Codec {
    let me = context_float(mut c)
    let list = context_floats(mut c)
    let f = f32_codec(mut c)
    let zero = Tag.Float(0.0f32)
    let one = unary(mut c, me)
    let many = aggregate(mut c, list)
    let two = binary(mut c, me)
    let power_fields: List<Field> = [req("base", me), req("exponent", me)]
    let range_fields: List<Field> = [req("min", me), req("max", me)]
    let constant_fields: List<Field> = [req("value", f)]
    let level_fields: List<Field> = [req("amount", level_based_value(mut c))]
    let from = context_int(mut c)
    let from_fields: List<Field> = [req("input", from)]
    let weighted_fields: List<Field> = [req("distribution", weighted(mut c, me))]
    let attribute = by_name(mut c, "minecraft:environment_attribute")
    let to_float = c.add(Codec.Then(Then { of: attribute, then: float_attribute, with: Tag.End }))
    let attribute_fields: List<Field> = [req("attribute", to_float)]
    let kinds: List<(String, usize)> = [
        ("minecraft:abs", one),
        ("minecraft:avg", many),
        ("minecraft:ceil", one),
        ("minecraft:conditional", conditional(mut c, me, zero.copy())),
        ("minecraft:constant", c.add(Codec.Record(constant_fields))),
        ("minecraft:cos", one),
        ("minecraft:sub", two),
        ("minecraft:enchantment_level", c.add(Codec.Record(level_fields))),
        ("minecraft:environment_attribute", c.add(Codec.Record(attribute_fields))),
        ("minecraft:floor", one),
        ("minecraft:from_int", c.add(Codec.Record(from_fields))),
        ("minecraft:length", many),
        ("minecraft:max", many),
        ("minecraft:min", many),
        ("minecraft:mod", two),
        ("minecraft:negate", one),
        ("minecraft:number_dispatcher", dispatcher(mut c, me, zero.copy())),
        ("minecraft:pow", c.add(Codec.Record(power_fields))),
        ("minecraft:mul", many),
        ("minecraft:div", two),
        ("minecraft:round", one),
        ("minecraft:sin", one),
        ("minecraft:sqrt", one),
        ("minecraft:storage", storage(mut c, me, zero.copy())),
        ("minecraft:add", many),
        ("minecraft:truncate", one),
        ("minecraft:uniform", c.add(Codec.Record(range_fields))),
        ("minecraft:weighted_list", c.add(Codec.Record(weighted_fields))),
    ]
    return constant_or(mut c, f, kinds, "minecraft:context_float_provider_type")
}

// `EnvironmentAttributeValue`'s check that the attribute is a number a float can be made of.
fn float_attribute(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let name = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    for (n, kind, _flags) in environment_attributes() {
        if name == "minecraft:{n}" and (kind == "float" or kind == "angle_degrees") {
            return Read.ok(value.copy())
        }
    }
    return Read.bad("{name} cannot be converted to a float")
}

/// `ContextIntProviders.CODEC`: an int from what's around a loot roll, given in full.
pub fn context_int(c: mut Codecs) -> usize {
    return c.named(String("context_int_provider"), make_context_int)
}

fn make_context_int(c: mut Codecs) -> Codec {
    let direct = context_int_direct(mut c)
    return Codec.Holder(HolderCodec { registry: "minecraft:context_int_provider", inline: some(direct) })
}

/// `ContextIntProviders.LIST_CODEC`: a list of them, or one alone.
pub fn context_ints(c: mut Codecs) -> usize {
    return c.named(String("context_int_providers"), make_context_ints)
}

fn make_context_ints(c: mut Codecs) -> Codec {
    let direct = context_int_direct(mut c)
    return Codec.Holders(HolderCodec { registry: "minecraft:context_int_provider", inline: some(direct) })
}

// `ContextIntProviders.DIRECT_CODEC`: an int, or a provider of one by its kind, where a constant
// one is written as its value alone.
fn context_int_direct(c: mut Codecs) -> usize {
    return c.named(String("context_int_provider direct"), make_context_int_direct)
}

fn make_context_int_direct(c: mut Codecs) -> Codec {
    let me = context_int(mut c)
    let list = context_ints(mut c)
    let i = i32_codec(mut c)
    let zero = Tag.Int(0)
    let one = unary(mut c, me)
    let many = aggregate(mut c, list)
    let two = binary(mut c, me)
    let float = context_float(mut c)
    let binomial_fields: List<Field> = [req("n", me), req("p", float)]
    let power_fields: List<Field> = [req("base", me), req("exponent", me)]
    let range_fields: List<Field> = [req("min", me), req("max", me)]
    let constant_fields: List<Field> = [req("value", i)]
    let from_fields: List<Field> = [req("input", float)]
    let weighted_fields: List<Field> = [req("distribution", weighted(mut c, me))]
    let attribute = by_name(mut c, "minecraft:environment_attribute")
    let to_int = c.add(Codec.Then(Then { of: attribute, then: int_attribute, with: Tag.End }))
    let attribute_fields: List<Field> = [req("attribute", to_int)]
    let target = scoreboard_name(mut c)
    let score_fields: List<Field> = [req("target", target), req("score", string(mut c)), def("fallback", me, zero.copy())]
    let kinds: List<(String, usize)> = [
        ("minecraft:abs", one),
        ("minecraft:avg", many),
        ("minecraft:binomial", c.add(Codec.Record(binomial_fields))),
        ("minecraft:conditional", conditional(mut c, me, zero.copy())),
        ("minecraft:constant", c.add(Codec.Record(constant_fields))),
        ("minecraft:sub", two),
        ("minecraft:environment_attribute", c.add(Codec.Record(attribute_fields))),
        ("minecraft:from_float", c.add(Codec.Record(from_fields))),
        ("minecraft:max", many),
        ("minecraft:min", many),
        ("minecraft:floor_mod", two),
        ("minecraft:floor_div", two),
        ("minecraft:mod", two),
        ("minecraft:div", two),
        ("minecraft:negate", one),
        ("minecraft:number_dispatcher", dispatcher(mut c, me, zero.copy())),
        ("minecraft:pow", c.add(Codec.Record(power_fields))),
        ("minecraft:mul", many),
        ("minecraft:score", c.add(Codec.Record(score_fields))),
        ("minecraft:storage", storage(mut c, me, zero.copy())),
        ("minecraft:add", many),
        ("minecraft:uniform", c.add(Codec.Record(range_fields))),
        ("minecraft:weighted_list", c.add(Codec.Record(weighted_fields))),
    ]
    return constant_or(mut c, i, kinds, "minecraft:context_int_provider_type")
}

// No attribute is an int: `EnvironmentAttributeValue`'s check of ints fails for each.
fn int_attribute(_c: Codecs, value: Tag, _with: Tag) -> Read {
    let name = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    return Read.bad("{name} cannot be converted to an integer")
}

// `UnaryProvider.codec`: one input.
fn unary(c: mut Codecs, of: usize) -> usize {
    let fields: List<Field> = [req("input", of)]
    return c.add(Codec.Record(fields))
}

// `AggregateProvider.mapCodec`: a list of inputs.
fn aggregate(c: mut Codecs, list: usize) -> usize {
    let fields: List<Field> = [req("inputs", list)]
    return c.add(Codec.Record(fields))
}

// `BinaryProvider.mapCodec`: a left input and a right one.
fn binary(c: mut Codecs, of: usize) -> usize {
    let fields: List<Field> = [req("left", of), req("right", of)]
    return c.add(Codec.Record(fields))
}

// `ConditionalProvider.mapCodec`: one value where a condition passes, else another, `zero` by
// default.
fn conditional(c: mut Codecs, of: usize, zero: own Tag) -> usize {
    let test = condition(mut c)
    let fields: List<Field> = [req("condition", test), req("on_true", of), def("on_false", of, zero)]
    return c.add(Codec.Record(fields))
}

// `DispatcherProvider.mapCodec`: the value of the first case whose condition passes, else the
// default, `zero` by default.
fn dispatcher(c: mut Codecs, of: usize, zero: own Tag) -> usize {
    let test = condition(mut c)
    let case_fields: List<Field> = [req("condition", test), req("value", of)]
    let case = c.add(Codec.Record(case_fields))
    let cases = c.add(Codec.ListOf(Many { of: case }))
    let fields: List<Field> = [req("cases", cases), def("default", of, zero)]
    return c.add(Codec.Record(fields))
}

// `StorageValue`: a number from command storage, by its ID and the path to it, with a fallback,
// `zero` by default.
fn storage(c: mut Codecs, of: usize, zero: own Tag) -> usize {
    let fields: List<Field> = [req("storage", id(mut c)), req("path", nbt_path(mut c)), def("fallback", of, zero)]
    return c.add(Codec.Record(fields))
}

/// `NbtPathArgument.NbtPath.CODEC`: a string read as an NBT path, as `nbt.path` reads one, and
/// written as the text it was read from, which stops at a space (CAL-78).
pub fn nbt_path(c: mut Codecs) -> usize {
    let key = String("nbt path")
    if let at = c.find(key) {
        return at
    }
    let text = string(mut c)
    return c.shared(key, Codec.Then(Then { of: text, then: read_path, with: Tag.End }))
}

// A path that doesn't read fails with `getMessage` of its syntax error, in the language of `c`,
// or throws what brigadier's reader threw.
fn read_path(c: Codecs, value: Tag, _with: Tag) -> Read {
    let text = match value {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
    match parse_path(text) {
        ok(path) => return Read.ok(Tag.Str(path.original)),
        err(PathError.Syntax(e)) => {
            let message = match c.lang {
                some(lang) => e.text(lang),
                none => e.text(Language.empty()),
            }
            return Read.bad("Failed to parse path {text}: {message}")
        },
        err(PathError.PastEnd(at)) => return Read.exception("java.lang.StringIndexOutOfBoundsException: Index {at} out of bounds for length {at}"),
    }
}

// `ScoreboardNameProviders.CODEC`: whose score, by a fixed name or one of the entities around,
// which is written as the entity's name alone.
fn scoreboard_name(c: mut Codecs) -> usize {
    let key = String("scoreboard name provider")
    if let at = c.find(key) {
        return at
    }
    let target = entity_target(mut c)
    let fixed_fields: List<Field> = [req("name", string(mut c))]
    let context_fields: List<Field> = [req("target", target)]
    let kinds: List<(String, usize)> = [
        ("minecraft:fixed", c.add(Codec.Record(fixed_fields))),
        ("minecraft:context", c.add(Codec.Record(context_fields))),
    ]
    let by = by_name(mut c, "minecraft:loot_score_provider_type")
    let typed = c.add(Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds }))
    let either = c.add(Codec.Either(target, typed))
    return c.shared(key, Codec.Then(Then { of: either, then: inline_target, with: Tag.End }))
}

fn inline_target(_c: Codecs, value: Tag, _with: Tag) -> Read {
    if kind_of(value) == "minecraft:context" {
        return Read.ok(field(value, "target"))
    }
    return Read.ok(value.copy())
}

// `IntRangePredicate.CODEC`: one int, or a range of them, each from a provider.
fn int_range(c: mut Codecs) -> usize {
    let key = String("int range predicate")
    if let at = c.find(key) {
        return at
    }
    let point = context_int(mut c)
    let fields: List<Field> = [opt("min", point), opt("max", point)]
    let line = c.add(Codec.Record(fields))
    return c.shared(key, Codec.Either(point, line))
}

// `FloatRangePredicate.CODEC`: one float, or a range of them, each from a provider.
fn float_range(c: mut Codecs) -> usize {
    let key = String("float range predicate")
    if let at = c.find(key) {
        return at
    }
    let point = context_float(mut c)
    let fields: List<Field> = [opt("min", point), opt("max", point)]
    let line = c.add(Codec.Record(fields))
    return c.shared(key, Codec.Either(point, line))
}

/// `LootItemCondition.CODEC`: a condition, given in full.
pub fn condition(c: mut Codecs) -> usize {
    return c.named(String("loot condition"), make_condition)
}

fn make_condition(c: mut Codecs) -> Codec {
    let direct = condition_direct(mut c)
    return Codec.Holder(HolderCodec { registry: "minecraft:predicate", inline: some(direct) })
}

/// `LootItemCondition.LIST_CODEC`: a list of conditions, or one alone.
pub fn conditions(c: mut Codecs) -> usize {
    return c.named(String("loot conditions"), make_conditions)
}

fn make_conditions(c: mut Codecs) -> Codec {
    let direct = condition_direct(mut c)
    return Codec.Holders(HolderCodec { registry: "minecraft:predicate", inline: some(direct) })
}

// `LootItemCondition.DIRECT_CODEC`: a condition by its kind.
fn condition_direct(c: mut Codecs) -> usize {
    return c.named(String("loot condition direct"), make_condition_direct)
}

fn make_condition_direct(c: mut Codecs) -> Codec {
    let term = condition(mut c)
    let terms = conditions(mut c)
    let flag = bool_codec(mut c)
    let target = entity_target(mut c)
    let i = i32_codec(mut c)
    let ints = int_range(mut c)
    let inverted_fields: List<Field> = [req("term", term)]
    let composite_fields: List<Field> = [req("terms", terms)]
    let composite = c.add(Codec.Record(composite_fields))
    let chance_fields: List<Field> = [req("chance", context_float(mut c))]
    let unenchanted = c.add(Codec.Float(FloatRange { min: 0.0f32, max: 1.0f32, checked: true, before: "Value must be within range [0.0;1.0]: " }))
    let enchantment = c.add(Codec.Holder(HolderCodec { registry: "minecraft:enchantment", inline: none, kind: HolderKind.Fixed }))
    let bonus_fields: List<Field> = [
        req("unenchanted_chance", unenchanted),
        req("enchanted_chance", level_based_value(mut c)),
        req("enchantment", enchantment),
    ]
    let entity_fields: List<Field> = [opt("predicate", entity(mut c)), req("entity", target)]
    let s = string(mut c)
    let scores = c.add(Codec.MapOf(MapOf { key: s, value: ints }))
    let scores_fields: List<Field> = [req("scores", scores), req("entity", target)]
    let tool_fields: List<Field> = [opt("predicate", item(mut c))]
    let f = f32_codec(mut c)
    let floats = c.add(Codec.ListOf(Many { of: f }))
    let chances = non_empty(mut c, floats)
    let table_fields: List<Field> = [req("enchantment", enchantment), req("chances", chances)]
    let damage_fields: List<Field> = [opt("predicate", damage_source(mut c))]
    let location_fields: List<Field> = [
        opt("predicate", location(mut c)),
        def("offsetX", i, Tag.Int(0)),
        def("offsetY", i, Tag.Int(0)),
        def("offsetZ", i, Tag.Int(0)),
    ]
    let weather_fields: List<Field> = [opt("raining", flag), opt("thundering", flag)]
    let clock = c.add(Codec.Holder(HolderCodec { registry: "minecraft:world_clock", inline: none, kind: HolderKind.Fixed }))
    let time_fields: List<Field> = [req("clock", clock), opt("period", i64_codec(mut c)), req("value", ints)]
    let int_check_fields: List<Field> = [req("value", context_int(mut c)), req("test", ints)]
    let float_check_fields: List<Field> = [req("value", context_float(mut c)), req("test", float_range(mut c))]
    let active_fields: List<Field> = [req("active", flag)]
    let no_fields: List<Field> = []
    let unit = c.add(Codec.Record(no_fields))
    let kinds: List<(String, usize)> = [
        ("minecraft:inverted", c.add(Codec.Record(inverted_fields))),
        ("minecraft:any_of", composite),
        ("minecraft:all_of", composite),
        ("minecraft:random_chance", c.add(Codec.Record(chance_fields))),
        ("minecraft:random_chance_with_enchanted_bonus", c.add(Codec.Record(bonus_fields))),
        ("minecraft:entity_properties", c.add(Codec.Record(entity_fields))),
        ("minecraft:killed_by_player", unit),
        ("minecraft:entity_scores", c.add(Codec.Record(scores_fields))),
        ("minecraft:match_block", block(mut c)),
        ("minecraft:match_tool", c.add(Codec.Record(tool_fields))),
        ("minecraft:table_bonus", c.add(Codec.Record(table_fields))),
        ("minecraft:survives_explosion", unit),
        ("minecraft:damage_source_properties", c.add(Codec.Record(damage_fields))),
        ("minecraft:location_check", c.add(Codec.Record(location_fields))),
        ("minecraft:weather_check", c.add(Codec.Record(weather_fields))),
        ("minecraft:time_check", c.add(Codec.Record(time_fields))),
        ("minecraft:int_value_check", c.add(Codec.Record(int_check_fields))),
        ("minecraft:float_value_check", c.add(Codec.Record(float_check_fields))),
        ("minecraft:enchantment_active_check", c.add(Codec.Record(active_fields))),
        ("minecraft:environment_attribute_check", attribute_check(mut c)),
    ]
    let by = by_name(mut c, "minecraft:loot_condition_type")
    return Codec.Dispatch(Kinds { key: "type", by: by, kinds: kinds })
}

// `EnvironmentAttributeCheck.MAP_CODEC`: an attribute by its ID in `attribute`, and the value it
// must have, as that attribute's values are read.
fn attribute_check(c: mut Codecs) -> usize {
    var kinds = List<(String, usize)>()
    for (name, kind, _flags) in environment_attributes() {
        let value = attribute_value(mut c, name, kind)
        let fields: List<Field> = [req("value", value)]
        kinds.push(("minecraft:{name}", c.add(Codec.Record(fields))))
    }
    let by = by_name(mut c, "minecraft:environment_attribute")
    return c.add(Codec.Dispatch(Kinds { key: "attribute", by: by, kinds: kinds }))
}
