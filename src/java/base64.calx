/// Base64 as Java's `Base64.getEncoder()` writes it: RFC 4648's alphabet, with `=` padding and no
/// line breaks.
module java.base64

/// `bytes` in Base64.
pub fn encode(bytes: List<u8>) -> String {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var out = List<u8>()
    out.reserve((bytes.len() + 2) / 3 * 4)
    var i: usize = 0
    let n = bytes.len()
    while i + 3 <= n {
        let v = (u32(bytes[i]) << 16) | (u32(bytes[i + 1]) << 8) | u32(bytes[i + 2])
        out.push(alphabet.byte_at(usize(v >> 18)))
        out.push(alphabet.byte_at(usize((v >> 12) & 63)))
        out.push(alphabet.byte_at(usize((v >> 6) & 63)))
        out.push(alphabet.byte_at(usize(v & 63)))
        i += 3
    }
    if n - i == 1 {
        let v = u32(bytes[i]) << 16
        out.push(alphabet.byte_at(usize(v >> 18)))
        out.push(alphabet.byte_at(usize((v >> 12) & 63)))
        out.push(61)
        out.push(61)
    } else if n - i == 2 {
        let v = (u32(bytes[i]) << 16) | (u32(bytes[i + 1]) << 8)
        out.push(alphabet.byte_at(usize(v >> 18)))
        out.push(alphabet.byte_at(usize((v >> 12) & 63)))
        out.push(alphabet.byte_at(usize((v >> 6) & 63)))
        out.push(61)
    }
    return String.from_utf8(out)!
}
