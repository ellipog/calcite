/// Base64 as Java's `Base64.getEncoder()` writes it and `Base64.getDecoder()` reads it: RFC
/// 4648's alphabet, with `=` padding and no line breaks.
module java.base64

/// `bytes` in Base64.
pub fn encode(bytes: List<u8>) -> String {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var out = List<u8>()
    out.reserve((bytes.len() + 2) / 3 * 4)
    var i: usize = 0
    let n = bytes.len()
    while i + 3 <= n {
        let v = (u32(bytes[i]) << 16) | (u32(bytes[i + 1]) << 8) | u32(bytes[i + 2])
        out.push(alphabet.byte_at(usize(v >> 18)))
        out.push(alphabet.byte_at(usize((v >> 12) & 63)))
        out.push(alphabet.byte_at(usize((v >> 6) & 63)))
        out.push(alphabet.byte_at(usize(v & 63)))
        i += 3
    }
    if n - i == 1 {
        let v = u32(bytes[i]) << 16
        out.push(alphabet.byte_at(usize(v >> 18)))
        out.push(alphabet.byte_at(usize((v >> 12) & 63)))
        out.push(61)
        out.push(61)
    } else if n - i == 2 {
        let v = (u32(bytes[i]) << 16) | (u32(bytes[i + 1]) << 8)
        out.push(alphabet.byte_at(usize(v >> 18)))
        out.push(alphabet.byte_at(usize((v >> 12) & 63)))
        out.push(alphabet.byte_at(usize((v >> 6) & 63)))
        out.push(61)
    }
    return String.from_utf8(out)!
}

/// The bytes `text` holds, as Java's `Base64.getDecoder().decode` reads them, or `none` where it
/// throws. The padding may be left out, and the bits a last unit has over are ignored, but a last
/// unit of one character, padding where it doesn't belong, anything after it, and any character
/// outside the alphabet, white space too, are refused.
pub fn decode(text: String) -> List<u8>? {
    var out = List<u8>()
    out.reserve(text.len() / 4 * 3 + 2)
    var bits: u32 = 0
    // How many characters of the unit are in `bits`.
    var held = 0
    var i: usize = 0
    let n = text.len()
    while i < n {
        let c = text.byte_at(i)
        if c == 61 {
            // `=` ends the data: after two characters of a unit, as `==`, or after three, as `=`.
            if held < 2 or (held == 2 and (i + 1 >= n or text.byte_at(i + 1) != 61)) {
                return none
            }
            let width: usize = if held == 2 { 2 } else { 1 }
            if i + width != n {
                return none
            }
            break
        }
        let v = sextet(c) else return none
        bits = (bits << 6) | v
        held += 1
        if held == 4 {
            out.push(u8.wrap(bits >> 16))
            out.push(u8.wrap(bits >> 8))
            out.push(u8.wrap(bits))
            bits = 0
            held = 0
        }
        i += 1
    }
    if held == 1 {
        return none
    }
    if held == 2 {
        out.push(u8.wrap(bits >> 4))
    } else if held == 3 {
        out.push(u8.wrap(bits >> 10))
        out.push(u8.wrap(bits >> 2))
    }
    return some(out)
}

// The six bits a character of the alphabet stands for.
fn sextet(c: u8) -> u32? {
    if c >= 65 and c <= 90 {
        return some(u32(c - 65))
    }
    if c >= 97 and c <= 122 {
        return some(u32(c - 71))
    }
    if c >= 48 and c <= 57 {
        return some(u32(c) + 4)
    }
    if c == 43 {
        return some(62)
    }
    if c == 47 {
        return some(63)
    }
    return none
}
