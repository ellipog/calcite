/// Globs as Java's file systems read them: `FileSystem.getPathMatcher("glob:...")` turns a glob
/// into a regular expression, Unix's with `/` between names and Windows' with `\`, which is then
/// compiled as a `java.regex` pattern and matched against a whole path. Vanilla's
/// `allowed_symlinks.txt` takes `[glob]` lines.
///
/// Written from black-box tests of JDK 25: the regular expression each of thousands of random
/// globs gives, or the error it fails with, is the same as Java's, character for character.
///
/// `*` is any run of characters within a name, `**` any run at all, `?` one character within a
/// name, `[...]` one character of a class, with `!` first to negate it and `-` for ranges,
/// `{a,b}` either of its alternatives, which don't nest, and a backslash takes the character
/// after it as it is. Everything else is itself.
module java.glob

import java.regex.{PatternError}

const BACKSLASH: u32 = 0x5C
const SLASH: u32 = 0x2F
const LBRACKET: u32 = 0x5B
const RBRACKET: u32 = 0x5D
const LBRACE: u32 = 0x7B
const RBRACE: u32 = 0x7D
const COMMA: u32 = 0x2C
const STAR: u32 = 0x2A
const QUESTION: u32 = 0x3F
const CARET: u32 = 0x5E
const BANG: u32 = 0x21
const DASH: u32 = 0x2D
const AMP: u32 = 0x26

// Past the glob's end, as Java's reader gives it.
const END: u32 = 0

/// The regular expression `glob` stands for, as Java's `Globs.toUnixRegexPattern` gives it, or
/// `toWindowsRegexPattern` if `windows`, or the `PatternSyntaxException` it throws, its index
/// counting UTF-16 units.
pub fn glob_regex(glob: String, windows: bool) -> String ! PatternError {
    var g = List<u16>()
    for c in glob.chars() {
        g.push(u16(c))
    }
    let n = g.len()
    // What isn't a name separator.
    let name = if windows { "[^\\\\]" } else { "[^/]" }
    var out = List<u16>()
    push_str(mut out, "^")
    var in_group = false
    var i: usize = 0
    while i < n {
        let c = u32(g[i])
        i += 1
        if c == BACKSLASH {
            if i == n {
                fail error("No character to escape", glob, i - 1)
            }
            let next = u32(g[i])
            if is_glob_meta(next) or is_regex_meta(next) {
                out.push(u16.wrap(BACKSLASH))
            }
            out.push(g[i])
            i += 1
        } else if c == SLASH {
            if windows {
                push_str(mut out, "\\\\")
            } else {
                out.push(u16.wrap(c))
            }
        } else if c == LBRACKET {
            push_str(mut out, if windows { "[[^\\\\]&&[" } else { "[[^/]&&[" })
            if at(g, i) == CARET {
                push_str(mut out, "\\^")
                i += 1
            } else {
                if at(g, i) == BANG {
                    out.push(u16.wrap(CARET))
                    i += 1
                }
                if at(g, i) == DASH {
                    out.push(u16.wrap(DASH))
                    i += 1
                }
            }
            var has_start = false
            var last: u32 = 0
            var d = c
            while i < n {
                d = u32(g[i])
                i += 1
                if d == RBRACKET {
                    break
                }
                if d == SLASH or (windows and d == BACKSLASH) {
                    fail error("Explicit 'name separator' in class", glob, i - 1)
                }
                if d == BACKSLASH or d == LBRACKET or (d == AMP and at(g, i) == AMP) {
                    out.push(u16.wrap(BACKSLASH))
                }
                out.push(u16.wrap(d))
                if d == DASH {
                    if not has_start {
                        fail error("Invalid range", glob, i - 1)
                    }
                    d = at(g, i)
                    i += 1
                    if d == END or d == RBRACKET {
                        break
                    }
                    if d < last {
                        fail error("Invalid range", glob, i - 3)
                    }
                    out.push(u16.wrap(d))
                    has_start = false
                } else {
                    has_start = true
                    last = d
                }
            }
            if d != RBRACKET {
                fail error("Missing ']", glob, i - 1)
            }
            push_str(mut out, "]]")
        } else if c == LBRACE {
            if in_group {
                fail error("Cannot nest groups", glob, i - 1)
            }
            push_str(mut out, "(?:(?:")
            in_group = true
        } else if c == RBRACE {
            if in_group {
                push_str(mut out, "))")
                in_group = false
            } else {
                out.push(u16.wrap(c))
            }
        } else if c == COMMA {
            if in_group {
                push_str(mut out, ")|(?:")
            } else {
                out.push(u16.wrap(c))
            }
        } else if c == STAR {
            if at(g, i) == STAR {
                push_str(mut out, ".*")
                i += 1
            } else {
                push_str(mut out, name)
                push_str(mut out, "*")
            }
        } else if c == QUESTION {
            push_str(mut out, name)
        } else {
            if is_regex_meta(c) {
                out.push(u16.wrap(BACKSLASH))
            }
            out.push(u16.wrap(c))
        }
    }
    if in_group {
        fail error("Missing '\}", glob, i - 1)
    }
    push_str(mut out, "$")
    return text_of(out)
}

fn at(g: List<u16>, i: usize) -> u32 {
    if i < g.len() {
        return u32(g[i])
    }
    return END
}

fn push_str(out: mut List<u16>, s: str) {
    for c in s.chars() {
        out.push(u16(c))
    }
}

fn is_regex_meta(c: u32) -> bool {
    return match c {
        0x2E | 0x5E | 0x24 | 0x2B | 0x7B | 0x5B | 0x5D | 0x7C | 0x28 | 0x29 => true,
        _ => false,
    }
}

fn is_glob_meta(c: u32) -> bool {
    return match c {
        0x5C | 0x2A | 0x3F | 0x5B | 0x7B => true,
        _ => false,
    }
}

fn error(description: str, glob: String, index: usize) -> PatternError {
    return PatternError { description: String(description), index: i32.wrap(index), pattern: glob.copy(), unsupported: false }
}

// The text of UTF-16 units, each surrogate pair one code point. A glob's units come from a
// `String`, so none is alone.
fn text_of(units: List<u16>) -> String {
    var out = String()
    var i: usize = 0
    while i < units.len() {
        var c = u32(units[i])
        i += 1
        if c >= 0xD800 and c <= 0xDBFF and i < units.len() {
            let d = u32(units[i])
            if d >= 0xDC00 and d <= 0xDFFF {
                c = 0x10000 + ((c - 0xD800) << 10) + (d - 0xDC00)
                i += 1
            }
        }
        out.push(rune.try_from(c) ?? '?')
    }
    return out
}
