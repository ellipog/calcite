module java.names

/// A run of code points with no name of their own, which Java names by their block and
/// their number in uppercase hex, as `CJK UNIFIED IDEOGRAPHS 4E00`.
pub struct Block {
    pub name: String
    pub first: u32
    pub last: u32
}

/// The 20 runs, in code point order.
pub fn blocks() -> List<Block> {
    return [
        Block { name: "LATIN 1 SUPPLEMENT", first: 0x84, last: 0x84 },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION A", first: 0x3400, last: 0x4DBF },
        Block { name: "CJK UNIFIED IDEOGRAPHS", first: 0x4E00, last: 0x9FFF },
        Block { name: "HANGUL SYLLABLES", first: 0xAC00, last: 0xD7A3 },
        Block { name: "HIGH SURROGATES", first: 0xD800, last: 0xDB7F },
        Block { name: "HIGH PRIVATE USE SURROGATES", first: 0xDB80, last: 0xDBFF },
        Block { name: "LOW SURROGATES", first: 0xDC00, last: 0xDFFF },
        Block { name: "PRIVATE USE AREA", first: 0xE000, last: 0xF8FF },
        Block { name: "TANGUT", first: 0x17000, last: 0x187F7 },
        Block { name: "TANGUT SUPPLEMENT", first: 0x18D00, last: 0x18D08 },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION B", first: 0x20000, last: 0x2A6DF },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION C", first: 0x2A700, last: 0x2B739 },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION D", first: 0x2B740, last: 0x2B81D },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION E", first: 0x2B820, last: 0x2CEA1 },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION F", first: 0x2CEB0, last: 0x2EBE0 },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION I", first: 0x2EBF0, last: 0x2EE5D },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION G", first: 0x30000, last: 0x3134A },
        Block { name: "CJK UNIFIED IDEOGRAPHS EXTENSION H", first: 0x31350, last: 0x323AF },
        Block { name: "SUPPLEMENTARY PRIVATE USE AREA A", first: 0xF0000, last: 0xFFFFD },
        Block { name: "SUPPLEMENTARY PRIVATE USE AREA B", first: 0x100000, last: 0x10FFFD },
    ]
}

