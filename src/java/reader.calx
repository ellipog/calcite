/// A file's text as Java's `Files.newBufferedReader(path, UTF_8)` gives it to whatever reads
/// from it: its UTF-16 code units, and the first one a read can't reach without throwing
/// `MalformedInputException`, if the bytes aren't all UTF-8.
///
/// Java decodes a file in pieces, and throws as it decodes a piece with bytes in it that aren't
/// UTF-8, so a reader that stops early never meets bytes that are wrong further on. The
/// `BufferedReader` asks its decoder for 8192 chars at a time, or 8191 when a character past
/// U+FFFF, two chars, would end one past them. The decoder reads the file 8192 bytes at a time.
/// A piece that fills up just before bytes that aren't UTF-8 throws for them only when the
/// bytes it has read show it already: a byte that can't start a character, or a second or
/// third byte that can't follow the ones before it. Otherwise the next piece throws, as do the
/// bytes of a character that the file ends in the middle of, on the piece after the last whole
/// character. `json.strict` reads what's given here as Gson's `JsonReader` reads it.
module java.reader

// The chars a `BufferedReader` asks its decoder for at a time.
const PIECE: usize = 8192

// The bytes the decoder reads from the file at a time.
const BYTES: usize = 8192

/// A file's text, as it's read.
pub struct Chars {
    /// The UTF-16 code units, up to where a read throws if one does.
    pub units: List<u16>
    /// The first code unit a read can't ask for without throwing, or `none` if the file is all
    /// UTF-8.
    pub fails_from: usize?
}

/// The text in `bytes`, a file's, as Java's buffered UTF-8 reader reads it.
pub fn buffered_utf8(bytes: List<u8>) -> Chars {
    let n = bytes.len()
    var units = List<u16>()
    units.reserve(n)
    var i: usize = 0
    // The bytes the decoder has read, and where the piece it's decoding started.
    var read_end: usize = 0
    var piece = 0usize
    var room = PIECE
    loop {
        if room == 0 {
            // The piece is full. The decoder looks at the next character only if it has read
            // its first byte, and throws only for what it has read of it.
            if i < read_end and wrong_after_full(bytes, i, read_end) {
                return Chars { units: units, fails_from: some(piece) }
            }
            piece = units.len()
            room = PIECE
        }
        if i == n {
            return Chars { units: units, fails_from: none }
        }
        let b1 = bytes[i]
        let size = width(b1)
        if size == 0 {
            return Chars { units: units, fails_from: some(piece) }
        }
        if i + size > read_end {
            // Not all of the character is read. What's read of it may show it's wrong;
            // otherwise the decoder reads on from it, if the file has more.
            if wrong_start(bytes, i, read_end) {
                return Chars { units: units, fails_from: some(piece) }
            }
            if read_end < n {
                read_end = n.min(i + BYTES)
                continue
            }
            // The file ends inside the character: the piece ends before it, and the next throws.
            let at = units.len()
            return Chars { units: units, fails_from: some(at) }
        }
        if size == 1 {
            units.push(u16(b1))
            i += 1
            room -= 1
            continue
        }
        let b2 = bytes[i + 1]
        if size == 2 {
            if not follows(b2) {
                return Chars { units: units, fails_from: some(piece) }
            }
            units.push(u16.wrap((u32(b1 & 0x1F) << 6) | u32(b2 & 0x3F)))
            i += 2
            room -= 1
            continue
        }
        let b3 = bytes[i + 2]
        if size == 3 {
            if wrong_second_of_three(b1, b2) or not follows(b3) {
                return Chars { units: units, fails_from: some(piece) }
            }
            let c = (u32(b1 & 0x0F) << 12) | (u32(b2 & 0x3F) << 6) | u32(b3 & 0x3F)
            if c >= 0xD800 and c < 0xE000 {
                return Chars { units: units, fails_from: some(piece) }
            }
            units.push(u16.wrap(c))
            i += 3
            room -= 1
            continue
        }
        if room == 1 {
            // Two chars don't fit in the one left: the piece ends here, unless what's read
            // shows the character is wrong.
            if wrong_start(bytes, i, read_end) {
                return Chars { units: units, fails_from: some(piece) }
            }
            piece = units.len()
            room = PIECE
            continue
        }
        let b4 = bytes[i + 3]
        if wrong_start(bytes, i, i + 4) or not follows(b4) {
            return Chars { units: units, fails_from: some(piece) }
        }
        let cp = (u32(b1 & 0x07) << 18) | (u32(b2 & 0x3F) << 12) | (u32(b3 & 0x3F) << 6) | u32(b4 & 0x3F)
        let v = cp - 0x10000
        units.push(u16.wrap(0xD800u32 + (v >> 10)))
        units.push(u16.wrap(0xDC00u32 + (v & 0x3FF)))
        i += 4
        room -= 2
    }
}

// How many bytes the character the byte `b` starts has, or 0 if it can't start one: a
// continuation byte, 0xC0 and 0xC1, which start only overlong forms, and 0xF5 up, which start
// only characters past U+10FFFF.
fn width(b: u8) -> usize {
    if b < 0x80 {
        return 1
    }
    if b < 0xC2 {
        return 0
    }
    if b < 0xE0 {
        return 2
    }
    if b < 0xF0 {
        return 3
    }
    if b < 0xF5 {
        return 4
    }
    return 0
}

// Whether `b` can follow the first byte of a character.
fn follows(b: u8) -> bool {
    return (b & 0xC0) == 0x80
}

// Whether the second byte of a three-byte character can't follow its first: an overlong form
// after 0xE0, or not a continuation byte.
fn wrong_second_of_three(b1: u8, b2: u8) -> bool {
    return (b1 == 0xE0 and (b2 & 0xE0) == 0x80) or not follows(b2)
}

// Whether what the decoder has of the character at `i`, the bytes before `end`, shows it's
// wrong without the rest: for three bytes, the second; for four, the second, which can't make
// an overlong form or one past U+10FFFF, and the third.
fn wrong_start(bytes: List<u8>, i: usize, end: usize) -> bool {
    let b1 = bytes[i]
    let size = width(b1)
    if size == 3 {
        return end - i > 1 and wrong_second_of_three(b1, bytes[i + 1])
    }
    if size != 4 {
        return false
    }
    if end - i > 1 {
        let b2 = bytes[i + 1]
        if (b1 == 0xF0 and (b2 < 0x90 or b2 > 0xBF)) or (b1 == 0xF4 and (b2 & 0xF0) != 0x80) or not follows(b2) {
            return true
        }
    }
    return end - i > 2 and not follows(bytes[i + 2])
}

// Whether the decoder, its piece full, throws for the character at `i` from the bytes it has
// read, those before `end`.
fn wrong_after_full(bytes: List<u8>, i: usize, end: usize) -> bool {
    if width(bytes[i]) == 0 {
        return true
    }
    return wrong_start(bytes, i, end)
}
