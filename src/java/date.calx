/// Java's `java.util.Date`, as `Properties.store` shows one in the date line it writes.
module java.date

import std.time.{Timestamp}

/// `Date.toString()`: `Thu Oct 29 10:48:03 CET 2026`, the moment as it is `offset` seconds ahead
/// of UTC, in the zone Java names `zone`. Java's calendar is Julian before 15 October 1582; this
/// one is Gregorian throughout, as no date line vanilla writes is that old.
pub fn to_string(at: Timestamp, offset: i32, zone: String) -> String {
    let days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    let d = at.date_time(offset)
    let day = (at.unix_ms + i64(offset) * 1000).floor_div(86400000)
    // 1 January 1970 was a Thursday.
    let weekday = usize.wrap((day + 4).floor_mod(7))
    return "{days[weekday]} {months[usize.wrap(d.month - 1)]} {two(d.day)} {two(d.hour)}:{two(d.minute)}:{two(d.second)} {zone} {d.year}"
}

/// The zone's name in `Date.toString`, from its abbreviation in the system's time zone database
/// and its offset from UTC in seconds. Java names zones by tzdata's abbreviations, such as `CET`
/// and `CEST`, measured in 37 zones with JDK 25. Where tzdata has only a number, such as `+03` in
/// Istanbul, Java writes the offset as `GMT+03:00`, and so it is where the system has no
/// abbreviation at all, as on Windows, which Java names from its own tables.
pub fn zone_name(abbreviation: String?, offset: i32) -> String {
    if let a = abbreviation {
        if not a.is_empty() and not a.starts_with("+") and not a.starts_with("-") {
            return a.copy()
        }
    }
    if offset == 0 {
        return String("GMT")
    }
    let sign = if offset < 0 { "-" } else { "+" }
    let minutes = offset.abs() / 60
    return "GMT{sign}{two(minutes / 60)}:{two(minutes % 60)}"
}

// `n` in two digits at least.
fn two(n: i32) -> String {
    return if n < 10 { "0{n}" } else { "{n}" }
}
