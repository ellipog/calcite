/// Java's integer parsing: `Integer.parseInt` and the rest, in radixes 2 to 36, with the
/// messages of the `NumberFormatException`s they throw, which vanilla shows players, as for an
/// SNBT number too big for its type. Written from black-box tests of JDK 25, which these match
/// on 85,000 cases: every function on random strings of digits, signs and leading zeros, and the
/// unsigned ones with a bad digit at every place in numbers that grow too big, in radixes 2, 10
/// and 16.
///
/// Digits are ASCII only, `0` to `9` then `a` to `z` in either case. Java also takes other
/// scripts' digits, such as `١٢`, as Calx's own `parse` doesn't, since no file or packet vanilla
/// reads them from holds any.
module java.number

/// `Integer.parseInt(text, radix)`.
pub fn parse_int(text: String, radix: u32) -> i32 ! String {
    let v = signed(text, radix, 2147483647u64) else fail input_string(text, radix)
    return i32.wrap(v)
}

/// `Long.parseLong(text, radix)`.
pub fn parse_long(text: String, radix: u32) -> i64 ! String {
    let v = signed(text, radix, 9223372036854775807u64) else fail input_string(text, radix)
    return v
}

/// `Byte.parseByte(text, radix)`: an `int`, then checked to fit.
pub fn parse_byte(text: String, radix: u32) -> i8 ! String {
    let v = try parse_int(text, radix)
    if v < -128 or v > 127 {
        fail out_of_range(text, radix)
    }
    return i8.wrap(v)
}

/// `Short.parseShort(text, radix)`: an `int`, then checked to fit.
pub fn parse_short(text: String, radix: u32) -> i16 ! String {
    let v = try parse_int(text, radix)
    if v < -32768 or v > 32767 {
        fail out_of_range(text, radix)
    }
    return i16.wrap(v)
}

/// `Integer.parseUnsignedInt(text, radix)`: up to 2³² − 1, given as the `int` with the same
/// bits.
pub fn parse_unsigned_int(text: String, radix: u32) -> i32 ! String {
    let v = try unsigned(text, radix, 4294967295u64, "int")
    return i32.wrap(v)
}

/// `Long.parseUnsignedLong(text, radix)`: up to 2⁶⁴ − 1, given as the `long` with the same
/// bits.
pub fn parse_unsigned_long(text: String, radix: u32) -> i64 ! String {
    let v = try unsigned(text, radix, 18446744073709551615u64, "long")
    return i64.wrap(v)
}

// The value of a signed number no bigger than `max`, or no smaller than −`max` − 1: a sign or
// none, then digits. `none` if it isn't one, as Java then says only that it couldn't read it.
fn signed(text: String, radix: u32, max: u64) -> i64? {
    if text.is_empty() {
        return none
    }
    let first = text.byte_at(0)
    let negative = first == 45
    let start: usize = if negative or first == 43 { 1 } else { 0 }
    let m = magnitude(text, start, radix) else return none
    if negative {
        if m > max + 1 {
            return none
        }
        return some(i64.wrap(0u64.wrapping_sub(m)))
    }
    if m > max {
        return none
    }
    return some(i64.wrap(m))
}

// The value of an unsigned number no bigger than `max`, a `+` or nothing, then digits. Java goes
// through the digits in order and stops at the first that isn't one, or that takes the number
// past `max`, which decides which it says.
fn unsigned(text: String, radix: u32, max: u64, kind: str) -> u64 ! String {
    if not text.is_empty() and text.byte_at(0) == 45 {
        fail "Illegal leading minus sign on unsigned string {text}."
    }
    let start: usize = if not text.is_empty() and text.byte_at(0) == 43 { 1 } else { 0 }
    if start >= text.len() {
        fail input_string(text, radix)
    }
    var m = 0u64
    for i in start..text.len() {
        let d = digit(text.byte_at(i), radix) else fail input_string(text, radix)
        var next: u64? = none
        if let shifted = m.checked_mul(u64(radix)) {
            next = shifted.checked_add(u64(d))
        }
        let v = next else fail "String value {text} exceeds range of unsigned {kind}."
        if v > max {
            fail "String value {text} exceeds range of unsigned {kind}."
        }
        m = v
    }
    return m
}

// The digits from `start` as a number, or `none` if they aren't digits of `radix` or it's too
// big for a `u64`.
fn magnitude(text: String, start: usize, radix: u32) -> u64? {
    if start >= text.len() {
        return none
    }
    var m = 0u64
    for i in start..text.len() {
        let d = digit(text.byte_at(i), radix) else return none
        let shifted = m.checked_mul(u64(radix)) else return none
        let added = shifted.checked_add(u64(d)) else return none
        m = added
    }
    return some(m)
}

// The value of a digit in `radix`, or `none`.
fn digit(b: u8, radix: u32) -> u32? {
    var d = 99u32
    if b >= 48 and b <= 57 {
        d = u32(b) - 48
    } else if b >= 97 and b <= 122 {
        d = u32(b) - 87
    } else if b >= 65 and b <= 90 {
        d = u32(b) - 55
    }
    if d >= radix {
        return none
    }
    return some(d)
}

// Java's message for text it can't read as a number.
fn input_string(text: String, radix: u32) -> String {
    if radix == 10 {
        return "For input string: \"{text}\""
    }
    return "For input string: \"{text}\" under radix {radix}"
}

// `Byte.parseByte`'s and `Short.parseShort`'s message for a number that doesn't fit.
fn out_of_range(text: String, radix: u32) -> String {
    return "Value out of range. Value:\"{text}\" Radix:{radix}"
}
