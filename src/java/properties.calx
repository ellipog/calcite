/// Java's `.properties` format, as `Properties.load` reads it: what vanilla's `server.properties`
/// is written in. Written from the format's documentation and checked against Java 25.
module java.properties

/// A key and its value.
pub struct Property {
    pub key: String
    pub value: String
}

/// The keys and values of a properties file, each key once, in the order they first appeared.
pub struct Properties {
    list: List<Property>
}

impl Properties {
    pub fn new() -> Properties {
        return Properties { list: List<Property>() }
    }

    /// The properties in `text`, as `Properties.load` reads them. A key given twice keeps its
    /// last value. Fails with Java's message for a `\u` escape without four hex digits.
    ///
    /// - Lines end at `\n`, `\r` or `\r\n`. Blank lines, and lines whose first character other
    ///   than space, tab or form feed is `#` or `!`, are skipped.
    /// - A line that ends with an odd number of backslashes goes on to the next, without the
    ///   backslash, the line end, or the next line's leading white space. A comment line can't.
    /// - The key runs to the first unescaped `=`, `:`, space, tab or form feed. White space after
    ///   it is skipped, then one `=` or `:` and the white space after that. The rest is the value.
    /// - `\t`, `\n`, `\r`, `\f` and `\uXXXX` are escapes, and a backslash before anything else is
    ///   dropped. A `\u` escape of an unpaired surrogate gives U+FFFD, since a `String` can't
    ///   hold one; Java keeps it.
    pub fn parse(text: String) -> Properties ! String {
        var p = Properties.new()
        let n = text.len()
        var i: usize = 0
        while i < n {
            skip_space(text, mut i)
            if i >= n {
                break
            }
            let c = text.byte_at(i)
            if c == 10 or c == 13 {
                skip_line_end(text, mut i)
                continue
            }
            if c == 35 or c == 33 {
                while i < n and text.byte_at(i) != 10 and text.byte_at(i) != 13 {
                    i += 1
                }
                skip_line_end(text, mut i)
                continue
            }
            // One logical line, across as many natural lines as end in an escaped line end.
            var line = String()
            loop {
                let start = i
                while i < n and text.byte_at(i) != 10 and text.byte_at(i) != 13 {
                    i += 1
                }
                var backslashes: usize = 0
                while backslashes < i - start and text.byte_at(i - 1 - backslashes) == 92 {
                    backslashes += 1
                }
                if backslashes % 2 == 1 {
                    line.push_str(text[start..i - 1])
                    skip_line_end(text, mut i)
                    skip_space(text, mut i)
                    if i >= n {
                        break
                    }
                } else {
                    line.push_str(text[start..i])
                    skip_line_end(text, mut i)
                    break
                }
            }
            try p.add_line(line)
        }
        return p
    }

    // The key and value in one logical line, its leading white space gone.
    fn add_line(mut self, line: String) ! String {
        let n = line.len()
        var k: usize = 0
        while k < n {
            let c = line.byte_at(k)
            if c == 92 {
                k = (k + 2).min(n)
                continue
            }
            if c == 61 or c == 58 or is_space(c) {
                break
            }
            k += 1
        }
        var v = k
        while v < n and is_space(line.byte_at(v)) {
            v += 1
        }
        if v < n and (line.byte_at(v) == 61 or line.byte_at(v) == 58) {
            v += 1
            while v < n and is_space(line.byte_at(v)) {
                v += 1
            }
        }
        let key = try unescape(line[..k])
        let value = try unescape(line[v..])
        self.set(key, value)
    }

    /// The value of `key`, or `none`.
    pub fn get(self, key: String) -> String? {
        for e in self.list {
            if e.key == key {
                return some(e.value.copy())
            }
        }
        return none
    }

    /// Sets `key` to `value`, keeping its place if it's there.
    pub fn set(mut self, key: own String, value: own String) {
        for i in 0..self.list.len() {
            if self.list[i].key == key {
                self.list[i].value = value
                return
            }
        }
        self.list.push(Property { key: key, value: value })
    }

    /// Removes `key`, if it's there.
    pub fn remove(mut self, key: String) {
        for i in 0..self.list.len() {
            if self.list[i].key == key {
                _ = self.list.remove(i)
                return
            }
        }
    }

    /// Every key and value, in the order the keys first appeared.
    pub fn entries(self) -> List<Property> {
        var out = List<Property>()
        for e in self.list {
            out.push(Property { key: e.key.copy(), value: e.value.copy() })
        }
        return out
    }

    pub fn len(self) -> usize {
        return self.list.len()
    }
}

fn is_space(c: u8) -> bool {
    return c == 32 or c == 9 or c == 12
}

fn skip_space(text: String, i: mut usize) {
    while i < text.len() and is_space(text.byte_at(i)) {
        i += 1
    }
}

// Past one line end: `\n`, `\r` or `\r\n`.
fn skip_line_end(text: String, i: mut usize) {
    if i < text.len() and text.byte_at(i) == 13 {
        i += 1
    }
    if i < text.len() and text.byte_at(i) == 10 {
        i += 1
    }
}

// The text with its escapes replaced.
fn unescape(s: String) -> String ! String {
    var out = String()
    let n = s.len()
    var start: usize = 0
    var i: usize = 0
    while i < n {
        if s.byte_at(i) != 92 {
            i += 1
            continue
        }
        out.push_str(s[start..i])
        i += 1
        if i >= n {
            start = n
            break
        }
        let c = s.byte_at(i)
        if c == 117 {
            var unit = try hex4(s, i + 1)
            i += 5
            if unit >= 0xD800 and unit <= 0xDBFF and i + 6 <= n and s.byte_at(i) == 92 and s.byte_at(i + 1) == 117 {
                let low = try hex4(s, i + 2)
                if low >= 0xDC00 and low <= 0xDFFF {
                    unit = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
                    i += 6
                }
            }
            out.push(rune.try_from(unit) ?? '\u{FFFD}')
        } else {
            let escaped = match c {
                116 => some('\t'),
                110 => some('\n'),
                114 => some('\r'),
                102 => some('\u{C}'),
                _ => none,
            }
            if let r = escaped {
                out.push(r)
                i += 1
                start = i
            } else {
                // Anything else stays, without its backslash, and is never an escape itself.
                start = i
                i += 1
            }
            continue
        }
        start = i
    }
    out.push_str(s[start..n])
    return out
}

// The four hex digits at `at`, as a UTF-16 unit.
fn hex4(s: String, at: usize) -> u32 ! String {
    if at + 4 > s.len() {
        fail "Malformed \\uxxxx encoding."
    }
    var v: u32 = 0
    for i in at..at + 4 {
        let d = hex_digit(s.byte_at(i)) else {
            fail "Malformed \\uxxxx encoding."
        }
        v = v * 16 + d
    }
    return v
}

fn hex_digit(c: u8) -> u32? {
    if c >= 48 and c <= 57 {
        return some(u32(c - 48))
    }
    if c >= 97 and c <= 102 {
        return some(u32(c - 87))
    }
    if c >= 65 and c <= 70 {
        return some(u32(c - 55))
    }
    return none
}
