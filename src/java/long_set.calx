/// fastutil's `LongOpenHashSet`, as far as vanilla's chunk references need it: the longs kept by
/// open addressing on their mixed hash, so that they come out in the order vanilla's do.
module java.long_set

/// `HashCommon.mix`: the long's hash, its bits spread by the golden ratio.
fn mix(x: i64) -> i64 {
    let h = x.wrapping_mul(-7046029254386353131)
    let a = h ^ i64.wrap(u64.wrap(h) >> 32)
    return a ^ i64.wrap(u64.wrap(a) >> 16)
}

/// `HashCommon.arraySize`: the power of two at least `expected / f`, and at least 2.
fn array_size(expected: i32, f: f32) -> i32 {
    let want = (f64(expected) / f64(f)).ceil()
    var n = 2
    while f64(n) < want {
        n *= 2
    }
    return n
}

/// `HashCommon.maxFill`.
fn max_fill(n: i32, f: f32) -> i32 {
    return i32.saturate((f64(n) * f64(f)).ceil()).min(n - 1)
}

/// A `LongOpenHashSet` made with its defaults: room for 16 at a load factor of 0.75.
pub struct LongOpenHashSet {
    keys: List<i64>
    n: i32
    mask: i32
    max_fill: i32
    size: i32
    contains_null: bool
}

impl LongOpenHashSet {
    pub fn new() -> LongOpenHashSet {
        let n = array_size(16, 0.75f32)
        return LongOpenHashSet { keys: [0i64; usize.wrap(n) + 1], n: n, mask: n - 1, max_fill: max_fill(n, 0.75f32), size: 0, contains_null: false }
    }

    /// `add`: false if it was already there.
    pub fn add(mut self, k: i64) -> bool {
        if k == 0 {
            if self.contains_null {
                return false
            }
            self.contains_null = true
        } else {
            var pos = i32.wrap(mix(k)) & self.mask
            while self.keys[usize.wrap(pos)] != 0 {
                if self.keys[usize.wrap(pos)] == k {
                    return false
                }
                pos = (pos + 1) & self.mask
            }
            self.keys[usize.wrap(pos)] = k
        }
        let before = self.size
        self.size += 1
        if before >= self.max_fill {
            let n = array_size(self.size + 1, 0.75f32)
            self.rehash(n)
        }
        return true
    }

    // `rehash`: every key, from the top of the table down, put in a table `n` long.
    fn rehash(mut self, n: i32) {
        let mask = n - 1
        var fresh: List<i64> = [0i64; usize.wrap(n) + 1]
        var i = self.n
        let real = if self.contains_null { self.size - 1 } else { self.size }
        for _ in 0..real {
            i -= 1
            while self.keys[usize.wrap(i)] == 0 {
                i -= 1
            }
            let k = self.keys[usize.wrap(i)]
            var pos = i32.wrap(mix(k)) & mask
            while fresh[usize.wrap(pos)] != 0 {
                pos = (pos + 1) & mask
            }
            fresh[usize.wrap(pos)] = k
        }
        self.n = n
        self.mask = mask
        self.max_fill = max_fill(n, 0.75f32)
        self.keys = fresh
    }

    pub fn len(self) -> usize {
        return usize.wrap(self.size)
    }

    /// The keys in the iterator's order: 0 first if it's there, then down the table.
    pub fn values(self) -> List<i64> {
        var out = List<i64>()
        if self.contains_null {
            out.push(0)
        }
        var pos = self.n
        while pos > 0 {
            pos -= 1
            if self.keys[usize.wrap(pos)] != 0 {
                out.push(self.keys[usize.wrap(pos)])
            }
        }
        return out
    }
}
