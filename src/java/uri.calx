/// URIs as Java's `java.net.URI` reads them: a check that text is a URI, by RFC 2396 with Java's
/// changes to it, which finds the scheme and fails with Java's messages. Vanilla checks links
/// with it, the server's own and those in chat.
///
/// It gave JDK 25's answer for 80,000 random strings of URI parts, each scheme or exception,
/// but for one simplification: a mistake inside an IPv6 address in brackets is always
/// `Malformed IPv6 address` at the address's start, where Java has several messages for where
/// it went wrong.
module java.uri

/// A URI that Java's `new URI(text)` takes.
pub struct Uri {
    /// The text it was read from, which is what Java's `toString` gives.
    pub text: String
    /// Its scheme as it was written, such as `https`, or `none` for a relative URI.
    pub scheme: String?
}

impl Uri {
    /// The URI in `text`, or the `URISyntaxException` Java's `new URI(text)` throws, as its
    /// `toString` writes it, such as `java.net.URISyntaxException: Illegal character in path at
    /// index 21: https://example.com/a b`. An index counts UTF-16 units, as Java's do.
    pub fn parse(text: String) -> Uri ! String {
        var units = List<u16>()
        for c in text.chars() {
            units.push(u16(c))
        }
        let p = Parser { s: units, text: text.copy() }
        let scheme = try p.uri()
        return Uri { text: text.copy(), scheme: scheme }
    }

    /// A link vanilla lets players open, as its `Util.parseAndValidateUntrustedUri` checks it: a
    /// URI whose scheme is `http` or `https`, in any case.
    pub fn untrusted(text: String) -> Uri ! String {
        let uri = try Uri.parse(text)
        let lower = match uri.scheme {
            some(s) => s.to_lower_root(),
            none => {
                fail "java.net.URISyntaxException: Missing protocol in URI: {text}: {text}"
            },
        }
        if lower != "http" and lower != "https" {
            fail "java.net.URISyntaxException: Unsupported protocol in URI: {text}: {text}"
        }
        return uri
    }
}

// The text as UTF-16 units, as Java reads it, and the text itself, for the messages.
struct Parser {
    s: List<u16>
    text: String
}

impl Parser {
    // The exception for `reason` at unit `at`.
    fn error(self, reason: String, at: usize) -> String {
        return "java.net.URISyntaxException: {reason} at index {at}: {self.input()}"
    }

    // The input as Java's message shows it: without the spaces at either end, and with each run
    // of spaces between words one space, though an index counts them all.
    fn input(self) -> String {
        var out = String()
        var space = false
        var start: usize = 0
        for i in 0..self.text.len() {
            if self.text.byte_at(i) == 32 {
                if not space {
                    out.push_str(self.text[start..i])
                    space = true
                }
            } else if space {
                if not out.is_empty() {
                    out.push(' ')
                }
                start = i
                space = false
            }
        }
        if not space {
            out.push_str(self.text[start..])
        }
        return out
    }

    // The first unit from `from` that is one of `stops`, or the end.
    fn find(self, from: usize, stops: str) -> usize {
        var i = from
        while i < self.s.len() and not one_of(self.s[i], stops) {
            i += 1
        }
        return i
    }

    // `[scheme:]scheme-specific-part[#fragment]`, giving the scheme. A colon before any `/`, `?`
    // or `#` ends a scheme, which must be a letter, then letters, digits, `+`, `-` and `.`. A
    // scheme-specific part that doesn't start with `/` is opaque.
    fn uri(self) -> String? ! String {
        let n = self.s.len()
        let colon = self.find(0, ":/?#")
        if colon == n or self.s[colon] != 58 {
            try self.hierarchical(0)
            return none
        }
        if colon == 0 {
            fail self.error(String("Expected scheme name"), 0)
        }
        for i in 0..colon {
            let c = self.s[i]
            let allowed = if i == 0 { is_alpha(c) } else { is_alpha(c) or is_digit(c) or one_of(c, "+-.") }
            if not allowed {
                fail self.error(String("Illegal character in scheme name"), i)
            }
        }
        let start = colon + 1
        if start == n or self.s[start] == 35 {
            fail self.error(String("Expected scheme-specific part"), start)
        }
        if self.s[start] == 47 {
            try self.hierarchical(start)
        } else {
            let end = self.find(start, "#")
            try self.check(start, end, Part.Uric, "opaque part")
            try self.fragment(end)
        }
        // A scheme is ASCII, so its units are its bytes.
        return some(self.text[..colon])
    }

    // `[//authority][path][?query][#fragment]` from `from`. An authority may be empty, as in
    // `file:///x`, unless nothing follows it.
    fn hierarchical(self, from: usize) ! String {
        let n = self.s.len()
        var i = from
        if i + 1 < n and self.s[i] == 47 and self.s[i + 1] == 47 {
            i += 2
            let end = self.find(i, "/?#")
            if end == n and i == n {
                fail self.error(String("Expected authority"), i)
            }
            try self.authority(i, end)
            i = end
        }
        let path_end = self.find(i, "?#")
        try self.check(i, path_end, Part.Path, "path")
        i = path_end
        if i < n and self.s[i] == 63 {
            let query_end = self.find(i + 1, "#")
            try self.check(i + 1, query_end, Part.Uric, "query")
            i = query_end
        }
        try self.fragment(i)
    }

    // The fragment, if `at` is a `#`.
    fn fragment(self, at: usize) ! String {
        if at < self.s.len() {
            try self.check(at + 1, self.s.len(), Part.Uric, "fragment")
        }
    }

    // That each unit from `from` to `to` is an escape or may be in `part`, called `what` in the
    // message.
    fn check(self, from: usize, to: usize, part: Part, what: str) ! String {
        var i = from
        while i < to {
            let c = self.s[i]
            if c == 37 {
                try self.escape(i)
                i += 3
                continue
            }
            let allowed = match part {
                // What a path may have besides unreserved characters, escapes and others.
                Part.Path => is_unreserved(c) or is_other(c) or one_of(c, ":@&=+$,;/"),
                // RFC 2396's reserved characters, and Java's `[` and `]`.
                Part.Uric => is_unreserved(c) or is_other(c) or one_of(c, ";/?:@&=+$,[]"),
            }
            if not allowed {
                fail self.error("Illegal character in {what}", i)
            }
            i += 1
        }
    }

    // That the `%` at `at` has two hex digits after it.
    fn escape(self, at: usize) ! String {
        if at + 2 >= self.s.len() or not is_hex(self.s[at + 1]) or not is_hex(self.s[at + 2]) {
            fail self.error(String("Malformed escape pair"), at)
        }
    }

    // The authority from `from` to `to`. Java reads one that isn't a host, port and user info as
    // a name of its own, which may have what a path has but `/`. So only one with brackets, for
    // an IPv6 address, must be a server, and one with a character neither may have fails where
    // a name would stop: at a bracket, if one comes first. A `%` after the name stops may start
    // an IPv6 address's scope, unless the authority starts with `]`, when it's an escape too.
    fn authority(self, from: usize, to: usize) ! String {
        var name = from
        while name < to {
            let c = self.s[name]
            if c == 37 {
                try self.escape(name)
                name += 3
            } else if is_reg_name(c) {
                name += 1
            } else {
                break
            }
        }
        if name == to {
            return
        }
        let scopes = self.s[from] != 93
        var i = name
        while i < to {
            let c = self.s[i]
            if c == 37 and not scopes {
                try self.escape(i)
                i += 3
                continue
            }
            if not (is_reg_name(c) or c == 37 or c == 91 or c == 93) {
                fail self.error(String("Illegal character in authority"), name)
            }
            i += 1
        }
        try self.server(from, to)
    }

    // `[user-info@]host[:port]`, where the user info is up to the first `@`, and the host is a
    // name or an IPv6 address in brackets.
    fn server(self, from: usize, to: usize) ! String {
        var p = from
        var at = from
        while at < to and self.s[at] != 64 {
            at += 1
        }
        if at < to {
            for i in from..at {
                if self.s[i] == 91 or self.s[i] == 93 {
                    fail self.error(String("Illegal character in user info"), i)
                }
            }
            p = at + 1
        }
        if p < to and self.s[p] == 91 {
            var close = p + 1
            while close < to and self.s[close] != 93 {
                close += 1
            }
            if close == to {
                fail self.error(String("Expected closing bracket for IPv6 address"), to)
            }
            if close == p + 1 {
                fail self.error(String("Expected closing bracket for IPv6 address"), close)
            }
            try self.ipv6(p + 1, close)
            p = close + 1
            if p < to and self.s[p] != 58 {
                fail self.error(String("Expected port number"), p)
            }
        } else {
            if p == to or self.s[p] == 58 {
                fail self.error(String("Expected hostname"), p)
            }
            let host = p
            p = self.hostname(host, to)
            if p < to and self.s[p] != 58 {
                fail self.error(String("Illegal character in hostname"), p)
            }
            // Before a port, a name of more than one label that isn't an IPv4 address must end
            // with a label that starts with a letter.
            var end = p
            if self.s[end - 1] == 46 {
                end -= 1
            }
            var last = end
            while last > host and self.s[last - 1] != 46 {
                last -= 1
            }
            if last > host and is_digit(self.s[last]) and not self.ipv4_host(host, p) {
                fail self.error(String("Illegal character in hostname"), last)
            }
        }
        if p < to {
            for i in p + 1..to {
                if not is_digit(self.s[i]) {
                    fail self.error(String("Illegal character in port number"), i)
                }
            }
        }
    }

    // Where a host name from `from` stops: after its last whole label, each letters and digits
    // with `-`s between them, and a `.` after each but the last, which may have one too.
    fn hostname(self, from: usize, to: usize) -> usize {
        var p = from
        while p < to and is_alnum(self.s[p]) {
            var end = p
            while end < to and (is_alnum(self.s[end]) or self.s[end] == 45) {
                end += 1
            }
            while self.s[end - 1] == 45 {
                end -= 1
            }
            p = end
            if p == to or self.s[p] != 46 {
                break
            }
            p += 1
        }
        return p
    }

    // Whether the units from `from` to `to` are an IPv4 address as a host: four numbers to 255
    // between dots, with as many leading zeros as they like.
    fn ipv4_host(self, from: usize, to: usize) -> bool {
        var i = from
        for part in 0..4 {
            if part > 0 {
                if i == to or self.s[i] != 46 {
                    return false
                }
                i += 1
            }
            let start = i
            var value = 0
            while i < to and is_digit(self.s[i]) {
                value = value * 10 + i32(self.s[i] - 48)
                if value > 255 {
                    return false
                }
                i += 1
            }
            if i == start {
                return false
            }
        }
        return i == to
    }

    // An IPv6 address from `from` to `to`, by RFC 2373: eight groups of up to four hex digits,
    // or fewer with one `::` for the zeros, the last two of which may be an IPv4 address, then
    // a scope after `%`, of letters, digits, `_` and `.`.
    fn ipv6(self, from: usize, to: usize) ! String {
        var end = from
        while end < to and self.s[end] != 37 {
            end += 1
        }
        if not self.ipv6_groups(from, end) {
            fail self.error(String("Malformed IPv6 address"), from)
        }
        if end + 1 == to {
            fail "java.net.URISyntaxException: scope id expected: {self.input()}"
        }
        if end < to {
            for i in end + 1..to {
                let c = self.s[i]
                if not (is_alnum(c) or c == 95 or c == 46) {
                    fail self.error(String("Illegal character in scope id"), i)
                }
            }
        }
    }

    // Whether the units from `from` to `to` are an IPv6 address without a scope.
    fn ipv6_groups(self, from: usize, to: usize) -> bool {
        var i = from
        var groups = 0
        var doubled = false
        if i + 1 < to and self.s[i] == 58 and self.s[i + 1] == 58 {
            doubled = true
            i += 2
        }
        while i < to {
            var digits = i
            while digits < to and is_hex(self.s[digits]) {
                digits += 1
            }
            if digits < to and self.s[digits] == 46 {
                // An IPv4 address ends it, and counts as two groups.
                if not self.ipv4(i, to) {
                    return false
                }
                groups += 2
                i = to
                break
            }
            if digits == i or digits - i > 4 {
                return false
            }
            groups += 1
            i = digits
            if i == to {
                break
            }
            if self.s[i] != 58 {
                return false
            }
            i += 1
            if i < to and self.s[i] == 58 {
                if doubled {
                    return false
                }
                doubled = true
                i += 1
            } else if i == to {
                return false
            }
        }
        return if doubled { groups <= 7 } else { groups == 8 }
    }

    // Whether the units from `from` to `to` are four numbers to 255 between dots.
    fn ipv4(self, from: usize, to: usize) -> bool {
        var i = from
        for part in 0..4 {
            if part > 0 {
                if i == to or self.s[i] != 46 {
                    return false
                }
                i += 1
            }
            var value = 0
            var digits = 0
            while i < to and is_digit(self.s[i]) and digits < 3 {
                value = value * 10 + i32(self.s[i] - 48)
                digits += 1
                i += 1
            }
            if digits == 0 or value > 255 {
                return false
            }
        }
        return i == to
    }
}

// What a part of a URI may hold, besides unreserved characters, escapes and others.
enum Part {
    // A path's.
    Path
    // An opaque part's, a query's and a fragment's.
    Uric
}

fn one_of(c: u16, set: str) -> bool {
    for i in 0..set.len() {
        if c == u16(set.byte_at(i)) {
            return true
        }
    }
    return false
}

fn is_alpha(c: u16) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_digit(c: u16) -> bool {
    return c >= 48 and c <= 57
}

fn is_alnum(c: u16) -> bool {
    return is_alpha(c) or is_digit(c)
}

fn is_hex(c: u16) -> bool {
    return is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

// Whether a registry-based authority may have `c`, besides escapes: what a path may have but `/`.
fn is_reg_name(c: u16) -> bool {
    return is_unreserved(c) or is_other(c) or one_of(c, "$,;:@&=+")
}

fn is_unreserved(c: u16) -> bool {
    return is_alpha(c) or is_digit(c) or one_of(c, "-_.!~*'()")
}

// Whether `c` is one of the other characters Java lets a URI have: not ASCII, not a control
// character as Java's `Character.isISOControl` has them, and not a space as its `isSpaceChar`
// has them. Each half of a surrogate pair is one.
fn is_other(c: u16) -> bool {
    if c < 0xA0 {
        return false
    }
    return c != 0xA0 and c != 0x1680 and not (c >= 0x2000 and c <= 0x200A) and c != 0x2028 and c != 0x2029 and c != 0x202F and c != 0x205F and c != 0x3000
}
