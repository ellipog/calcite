/// fastutil's `ObjectOpenHashSet` of strings, as far as vanilla's advancement requirements need
/// it (CAL-164): the strings kept by open addressing on their mixed `hashCode`, so that they come
/// out in the order vanilla's do, which is the order its progress puts their criteria in.
module java.object_set

/// `HashCommon.mix` of an int: its bits spread by the golden ratio, `INT_PHI`.
fn mix(x: i32) -> i32 {
    let h = x.wrapping_mul(-1640531527)
    return h ^ i32.wrap(u32.wrap(h) >> 16)
}

/// `HashCommon.arraySize`, and `tryCapacity`'s size: the power of two at least `expected / f`,
/// and at least 2.
fn array_size(expected: i32, f: f32) -> i32 {
    let want = (f64(expected) / f64(f)).ceil()
    var n = 2
    while f64(n) < want {
        n *= 2
    }
    return n
}

/// `HashCommon.maxFill`.
fn max_fill(n: i32, f: f32) -> i32 {
    return i32.saturate((f64(n) * f64(f)).ceil()).min(n - 1)
}

/// An `ObjectOpenHashSet` of strings made with its defaults: room for 16 at a load factor of
/// 0.75. It has no `null`, which no requirement names.
pub struct StringOpenHashSet {
    keys: List<String?>
    n: i32
    mask: i32
    max_fill: i32
    size: i32
}

impl StringOpenHashSet {
    pub fn new() -> StringOpenHashSet {
        let n = array_size(16, 0.75f32)
        var keys = List<String?>()
        for _ in 0..n + 1 {
            keys.push(none)
        }
        return StringOpenHashSet { keys: keys, n: n, mask: n - 1, max_fill: max_fill(n, 0.75f32), size: 0 }
    }

    /// `addAll` of `c`: room tried for what it has and all of them, `tryCapacity`, then each
    /// added in turn.
    pub fn add_all(mut self, c: List<String>) {
        let needed = array_size(self.size + i32.wrap(c.len()), 0.75f32)
        if needed > self.n {
            self.rehash(needed)
        }
        for k in c {
            _ = self.add(k.copy())
        }
    }

    /// `add`: false if it was already there.
    pub fn add(mut self, k: String) -> bool {
        var pos = mix(k.java_hash()) & self.mask
        while let curr = self.keys[usize.wrap(pos)] {
            if curr == k {
                return false
            }
            pos = (pos + 1) & self.mask
        }
        self.keys[usize.wrap(pos)] = some(k.copy())
        let before = self.size
        self.size += 1
        if before >= self.max_fill {
            let n = array_size(self.size + 1, 0.75f32)
            self.rehash(n)
        }
        return true
    }

    // `rehash`: every key, from the top of the table down, put in a table `n` long.
    fn rehash(mut self, n: i32) {
        let mask = n - 1
        var fresh = List<String?>()
        for _ in 0..n + 1 {
            fresh.push(none)
        }
        var i = self.n
        for _ in 0..self.size {
            i -= 1
            while self.keys[usize.wrap(i)] == none {
                i -= 1
            }
            let k = self.keys[usize.wrap(i)].copy() ?? String()
            var pos = mix(k.java_hash()) & mask
            while fresh[usize.wrap(pos)] != none {
                pos = (pos + 1) & mask
            }
            fresh[usize.wrap(pos)] = some(k)
        }
        self.n = n
        self.mask = mask
        self.max_fill = max_fill(n, 0.75f32)
        self.keys = fresh
    }

    pub fn len(self) -> usize {
        return usize.wrap(self.size)
    }

    /// The keys in the iterator's order, down the table.
    pub fn values(self) -> List<String> {
        var out = List<String>()
        var pos = self.n
        while pos > 0 {
            pos -= 1
            if let k = self.keys[usize.wrap(pos)] {
                out.push(k.copy())
            }
        }
        return out
    }
}
