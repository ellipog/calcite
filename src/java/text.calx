/// Java's string algorithms that vanilla's results depend on.
module java.text

/// Java's `String.hashCode`: `31 * h + c` over the string's UTF-16 code units, wrapping. A
/// character past U+FFFF is two code units, a surrogate pair, as in Java.
pub fn string_hash(s: String) -> i32 {
    var h = 0
    var i: usize = 0
    let n = s.len()
    while i < n {
        let b = i32(s.byte_at(i))
        var cp = b
        var size: usize = 1
        if b >= 0xF0 {
            cp = ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
            size = 4
        } else if b >= 0xE0 {
            cp = ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
            size = 3
        } else if b >= 0xC0 {
            cp = ((b & 0x1F) << 6) | low6(s, i + 1)
            size = 2
        }
        if cp >= 0x10000 {
            h = 31 * h + (0xD800 + ((cp - 0x10000) >> 10))
            h = 31 * h + (0xDC00 + ((cp - 0x10000) & 0x3FF))
        } else {
            h = 31 * h + cp
        }
        i += size
    }
    return h
}

/// The payload bits of the continuation byte at `i`.
fn low6(s: String, i: usize) -> i32 {
    return i32(s.byte_at(i)) & 0x3F
}

/// Java's `String.compareTo`, by UTF-16 code unit. It's code point order, as `<` on a `String`
/// is, except that a character past U+FFFF, a surrogate pair, comes before U+E000 to U+FFFF.
pub fn compare_to(a: String, b: String) -> Ordering {
    let n = a.len().min(b.len())
    var i: usize = 0
    while i < n and a.byte_at(i) == b.byte_at(i) {
        i += 1
    }
    if i == n {
        return a.len().cmp(b.len())
    }
    // Back to where the character the two differ in starts, which is the same in both.
    while i > 0 and a.byte_at(i) & 0xC0 == 0x80 {
        i -= 1
    }
    let x = first_unit(a, i)
    let y = first_unit(b, i)
    if x != y {
        return x.cmp(y)
    }
    // Two pairs with the same high surrogate: their low ones are in code point order.
    return a[i..].cmp(b[i..])
}

/// The text Java's UTF-8 decoder gives for `bytes`, as `new String(bytes, UTF_8)` and an
/// `InputStreamReader` read them: each malformed sequence becomes one U+FFFD. As `sun.nio.cs.UTF_8`
/// judges them, a sequence is malformed from its first byte for as long as its bytes could still
/// start a character, except that a surrogate, three bytes from `ED A0`, is one U+FFFD for all
/// three, and a character cut off at the end is one for what's there.
pub fn decode_utf8(bytes: List<u8>) -> String {
    var out = List<u8>()
    var i: usize = 0
    while i < bytes.len() {
        let (size, whole) = utf8_step(bytes, i)
        if whole {
            for k in i..i + size {
                out.push(bytes[k])
            }
        } else {
            out.push(0xEF)
            out.push(0xBF)
            out.push(0xBD)
        }
        i += size
    }
    return String.from_utf8(out)!
}

// How many bytes from `i` Java's decoder takes at once, and whether they're a character, or a
// malformed sequence that becomes U+FFFD.
fn utf8_step(bytes: List<u8>, i: usize) -> (usize, bool) {
    let b1 = bytes[i]
    let left = bytes.len() - i
    if b1 < 0x80 {
        return (1, true)
    }
    if b1 >= 0xC2 and b1 <= 0xDF {
        if left < 2 {
            return (left, false)
        }
        return if continuation(bytes[i + 1]) { (2, true) } else { (1, false) }
    }
    if b1 >= 0xE0 and b1 <= 0xEF {
        if left < 3 {
            if left > 1 and bad_second_of_3(b1, bytes[i + 1]) {
                return (1, false)
            }
            return (left, false)
        }
        if bad_second_of_3(b1, bytes[i + 1]) {
            return (1, false)
        }
        if not continuation(bytes[i + 2]) {
            return (2, false)
        }
        if b1 == 0xED and bytes[i + 1] >= 0xA0 {
            return (3, false)
        }
        return (3, true)
    }
    if b1 >= 0xF0 and b1 <= 0xF7 {
        if b1 > 0xF4 or (left > 1 and bad_second_of_4(b1, bytes[i + 1])) {
            return (1, false)
        }
        if left > 2 and not continuation(bytes[i + 2]) {
            return (2, false)
        }
        if left < 4 {
            return (left, false)
        }
        if not continuation(bytes[i + 3]) {
            return (3, false)
        }
        return (4, true)
    }
    return (1, false)
}

fn continuation(b: u8) -> bool {
    return b & 0xC0 == 0x80
}

// Whether the second byte of a three-byte character can't follow `b1`: it isn't a continuation,
// or it makes an overlong form.
fn bad_second_of_3(b1: u8, b2: u8) -> bool {
    return (b1 == 0xE0 and b2 & 0xE0 == 0x80) or not continuation(b2)
}

// Whether the second byte of a four-byte character can't follow `b1`: it isn't a continuation,
// or it makes an overlong form or one past U+10FFFF.
fn bad_second_of_4(b1: u8, b2: u8) -> bool {
    return (b1 == 0xF0 and (b2 < 0x90 or b2 > 0xBF)) or (b1 == 0xF4 and b2 & 0xF0 != 0x80) or not continuation(b2)
}

/// Lines from a stream of bytes, as a `BufferedReader` over an `InputStreamReader` in UTF-8
/// reads them with `readLine`: each ends at `\n`, `\r` or `\r\n`, which aren't in it, and is
/// decoded as `decode_utf8` decodes. Bytes come in pieces, as they're read, and a line can span
/// them.
pub struct LineReader {
    line: List<u8> = []
    // The last piece ended in `\r`, so a `\n` that starts the next is part of the same end.
    skip_newline: bool = false
}

impl LineReader {
    /// The lines `bytes` ends, after what came before.
    pub fn push(mut self, bytes: List<u8>) -> List<String> {
        var lines = List<String>()
        for b in bytes {
            if self.skip_newline {
                self.skip_newline = false
                if b == 10 {
                    continue
                }
            }
            if b == 10 or b == 13 {
                lines.push(decode_utf8(self.line))
                self.line = List<u8>()
                self.skip_newline = b == 13
            } else {
                self.line.push(b)
            }
        }
        return lines
    }

    /// At the end of the stream, the last line, if it has no end of its own.
    pub fn finish(mut self) -> String? {
        if self.line.is_empty() {
            return none
        }
        let last = decode_utf8(self.line)
        self.line = List<u8>()
        return some(last)
    }
}

// The first UTF-16 unit of the character starting at `i`.
fn first_unit(s: String, i: usize) -> i32 {
    let b = i32(s.byte_at(i))
    if b >= 0xF0 {
        let cp = ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
        return 0xD800 + ((cp - 0x10000) >> 10)
    }
    if b >= 0xE0 {
        return ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
    }
    if b >= 0xC0 {
        return ((b & 0x1F) << 6) | low6(s, i + 1)
    }
    return b
}
