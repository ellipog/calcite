/// Java's string algorithms that vanilla's results depend on.
module java.text

/// Java's `String.hashCode`: `31 * h + c` over the string's UTF-16 code units, wrapping. A
/// character past U+FFFF is two code units, a surrogate pair, as in Java.
pub fn string_hash(s: String) -> i32 {
    var h = 0
    var i: usize = 0
    let n = s.len()
    while i < n {
        let b = i32(s.byte_at(i))
        var cp = b
        var size: usize = 1
        if b >= 0xF0 {
            cp = ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
            size = 4
        } else if b >= 0xE0 {
            cp = ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
            size = 3
        } else if b >= 0xC0 {
            cp = ((b & 0x1F) << 6) | low6(s, i + 1)
            size = 2
        }
        if cp >= 0x10000 {
            h = 31 * h + (0xD800 + ((cp - 0x10000) >> 10))
            h = 31 * h + (0xDC00 + ((cp - 0x10000) & 0x3FF))
        } else {
            h = 31 * h + cp
        }
        i += size
    }
    return h
}

/// The pieces of `text` between each `separator`, an ASCII character, each with whitespace
/// trimmed from both its ends, as Guava's `Splitter.on(separator).trimResults().splitToList`
/// gives them: an empty text is one empty piece. Whitespace is Unicode's `White_Space`, which is
/// what Guava's `CharMatcher.whitespace()` matches.
pub fn split_trimmed(text: String, separator: u8) -> List<String> {
    var out = List<String>()
    var start: usize = 0
    for i in 0..text.len() + 1 {
        if i == text.len() or text.byte_at(i) == separator {
            out.push(trimmed(text, start, i))
            start = i + 1
        }
    }
    return out
}

// The bytes of `s` from `from` to `to`, without the whitespace at either end.
fn trimmed(s: String, from: usize, to: usize) -> String {
    var a = from
    var b = to
    while a < b and is_white(code_point(s, a)) {
        a += char_size(s, a)
    }
    while b > a {
        var c = b - 1
        while c > a and s.byte_at(c) & 0xC0 == 0x80 {
            c -= 1
        }
        if not is_white(code_point(s, c)) {
            break
        }
        b = c
    }
    return s[a..b]
}

// Whether the character is in Unicode's `White_Space`.
fn is_white(cp: i32) -> bool {
    return (cp >= 0x09 and cp <= 0x0D) or cp == 0x20 or cp == 0x85 or cp == 0xA0 or cp == 0x1680 or (cp >= 0x2000 and cp <= 0x200A) or cp == 0x2028 or cp == 0x2029 or cp == 0x202F or cp == 0x205F or cp == 0x3000
}

// The character starting at `i`.
fn code_point(s: String, i: usize) -> i32 {
    let b = i32(s.byte_at(i))
    if b >= 0xF0 {
        return ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
    }
    if b >= 0xE0 {
        return ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
    }
    if b >= 0xC0 {
        return ((b & 0x1F) << 6) | low6(s, i + 1)
    }
    return b
}

// How many bytes the character starting at `i` takes.
fn char_size(s: String, i: usize) -> usize {
    let b = s.byte_at(i)
    return if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 }
}

/// The payload bits of the continuation byte at `i`.
fn low6(s: String, i: usize) -> i32 {
    return i32(s.byte_at(i)) & 0x3F
}

/// Java's `String.compareTo`, by UTF-16 code unit. It's code point order, as `<` on a `String`
/// is, except that a character past U+FFFF, a surrogate pair, comes before U+E000 to U+FFFF.
pub fn compare_to(a: String, b: String) -> Ordering {
    let n = a.len().min(b.len())
    var i: usize = 0
    while i < n and a.byte_at(i) == b.byte_at(i) {
        i += 1
    }
    if i == n {
        return a.len().cmp(b.len())
    }
    // Back to where the character the two differ in starts, which is the same in both.
    while i > 0 and a.byte_at(i) & 0xC0 == 0x80 {
        i -= 1
    }
    let x = first_unit(a, i)
    let y = first_unit(b, i)
    if x != y {
        return x.cmp(y)
    }
    // Two pairs with the same high surrogate: their low ones are in code point order.
    return a[i..].cmp(b[i..])
}

// The first UTF-16 unit of the character starting at `i`.
fn first_unit(s: String, i: usize) -> i32 {
    let b = i32(s.byte_at(i))
    if b >= 0xF0 {
        let cp = ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
        return 0xD800 + ((cp - 0x10000) >> 10)
    }
    if b >= 0xE0 {
        return ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
    }
    if b >= 0xC0 {
        return ((b & 0x1F) << 6) | low6(s, i + 1)
    }
    return b
}
