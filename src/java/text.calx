/// Java's string algorithms that vanilla's results depend on.
module java.text

/// `String.format(Locale.ROOT, "%.<places>f", v)` (CAL-165): the digits `Double.toString` gives,
/// rounded half up at `places` after the point as `FormattedFloatingDecimal.applyPrecision`
/// rounds them, then filled out with zeros, a minus kept where one rounds to nothing; `NaN` and
/// the infinities as they are. Java's `Formatter` takes the digits of its older `FloatingDecimal`,
/// which on rare values has one digit more than the shortest, so a value whose shortest digits
/// end in a 5 just past the places may round the other way there.
pub fn format_fixed(v: f64, places: usize) -> String {
    let shown = "{v}"
    if shown == "NaN" or shown == "Infinity" or shown == "-Infinity" {
        return shown
    }
    var digits = List<i32>()
    var point: i32 = 0
    var exponent: i32 = 0
    var after = false
    var negative = false
    var i: usize = 0
    let n = shown.len()
    while i < n {
        let b = i32(shown.byte_at(i))
        if b == 45 and i == 0 {
            negative = true
        } else if b == 46 {
            after = true
        } else if b == 69 {
            var sign = 1
            var j = i + 1
            if i32(shown.byte_at(j)) == 45 {
                sign = -1
                j += 1
            }
            while j < n {
                exponent = exponent * 10 + (i32(shown.byte_at(j)) - 48)
                j += 1
            }
            exponent *= sign
            break
        } else {
            digits.push(b - 48)
            if not after {
                point += 1
            }
        }
        i += 1
    }
    point += exponent
    let keep = point + i32.wrap(places)
    if keep < 0 {
        digits = List<i32>()
    } else if usize.wrap(keep) < digits.len() {
        let up = digits[usize.wrap(keep)] >= 5
        var kept = List<i32>()
        for k in 0..usize.wrap(keep) {
            kept.push(digits[k])
        }
        if up {
            var k = kept.len()
            var carry = true
            while carry and k > 0 {
                k -= 1
                if kept[k] == 9 {
                    kept[k] = 0
                } else {
                    kept[k] += 1
                    carry = false
                }
            }
            if carry {
                var longer = List<i32>()
                longer.push(1)
                for d in kept {
                    longer.push(d)
                }
                kept = longer
                point += 1
            }
        }
        digits = kept
    }
    var out = String()
    if negative {
        out.push_str("-")
    }
    if point <= 0 {
        out.push_str("0")
    } else {
        for k in 0..usize.wrap(point) {
            let d = if k < digits.len() { digits[k] } else { 0 }
            out.push_str("{d}")
        }
    }
    if places > 0 {
        out.push_str(".")
        for p in 0..places {
            let at = point + i32.wrap(p)
            let d = if at >= 0 and usize.wrap(at) < digits.len() { digits[usize.wrap(at)] } else { 0 }
            out.push_str("{d}")
        }
    }
    return out
}

/// Java's `String.hashCode`: `31 * h + c` over the string's UTF-16 code units, wrapping. A
/// character past U+FFFF is two code units, a surrogate pair, as in Java.
pub fn string_hash(s: String) -> i32 {
    var h = 0
    var i: usize = 0
    let n = s.len()
    while i < n {
        let b = i32(s.byte_at(i))
        var cp = b
        var size: usize = 1
        if b >= 0xF0 {
            cp = ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
            size = 4
        } else if b >= 0xE0 {
            cp = ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
            size = 3
        } else if b >= 0xC0 {
            cp = ((b & 0x1F) << 6) | low6(s, i + 1)
            size = 2
        }
        if cp >= 0x10000 {
            h = 31 * h + (0xD800 + ((cp - 0x10000) >> 10))
            h = 31 * h + (0xDC00 + ((cp - 0x10000) & 0x3FF))
        } else {
            h = 31 * h + cp
        }
        i += size
    }
    return h
}

/// The pieces of `text` between each `separator`, an ASCII character, each with whitespace
/// trimmed from both its ends, as Guava's `Splitter.on(separator).trimResults().splitToList`
/// gives them: an empty text is one empty piece. Whitespace is Unicode's `White_Space`, which is
/// what Guava's `CharMatcher.whitespace()` matches.
pub fn split_trimmed(text: String, separator: u8) -> List<String> {
    var out = List<String>()
    var start: usize = 0
    for i in 0..text.len() + 1 {
        if i == text.len() or text.byte_at(i) == separator {
            out.push(trimmed(text, start, i))
            start = i + 1
        }
    }
    return out
}

/// Java's `String.trim`: `text` without the characters up to U+0020 at either end, the control
/// characters and the space, which are each a byte of UTF-8.
pub fn java_trim(text: String) -> String {
    var start: usize = 0
    var end = text.len()
    while start < end and text.byte_at(start) <= 32 {
        start += 1
    }
    while end > start and text.byte_at(end - 1) <= 32 {
        end -= 1
    }
    return text[start..end]
}

// The bytes of `s` from `from` to `to`, without the whitespace at either end.
fn trimmed(s: String, from: usize, to: usize) -> String {
    var a = from
    var b = to
    while a < b and is_white(code_point(s, a)) {
        a += char_size(s, a)
    }
    while b > a {
        var c = b - 1
        while c > a and s.byte_at(c) & 0xC0 == 0x80 {
            c -= 1
        }
        if not is_white(code_point(s, c)) {
            break
        }
        b = c
    }
    return s[a..b]
}

// Whether the character is in Unicode's `White_Space`.
fn is_white(cp: i32) -> bool {
    return (cp >= 0x09 and cp <= 0x0D) or cp == 0x20 or cp == 0x85 or cp == 0xA0 or cp == 0x1680 or (cp >= 0x2000 and cp <= 0x200A) or cp == 0x2028 or cp == 0x2029 or cp == 0x202F or cp == 0x205F or cp == 0x3000
}

// The character starting at `i`.
fn code_point(s: String, i: usize) -> i32 {
    let b = i32(s.byte_at(i))
    if b >= 0xF0 {
        return ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
    }
    if b >= 0xE0 {
        return ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
    }
    if b >= 0xC0 {
        return ((b & 0x1F) << 6) | low6(s, i + 1)
    }
    return b
}

// How many bytes the character starting at `i` takes.
fn char_size(s: String, i: usize) -> usize {
    let b = s.byte_at(i)
    return if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 }
}

/// The payload bits of the continuation byte at `i`.
fn low6(s: String, i: usize) -> i32 {
    return i32(s.byte_at(i)) & 0x3F
}

/// Java's `String.compareTo`, by UTF-16 code unit. It's code point order, as `<` on a `String`
/// is, except that a character past U+FFFF, a surrogate pair, comes before U+E000 to U+FFFF.
pub fn compare_to(a: String, b: String) -> Ordering {
    let n = a.len().min(b.len())
    var i: usize = 0
    while i < n and a.byte_at(i) == b.byte_at(i) {
        i += 1
    }
    if i == n {
        return a.len().cmp(b.len())
    }
    // Back to where the character the two differ in starts, which is the same in both.
    while i > 0 and a.byte_at(i) & 0xC0 == 0x80 {
        i -= 1
    }
    let x = first_unit(a, i)
    let y = first_unit(b, i)
    if x != y {
        return x.cmp(y)
    }
    // Two pairs with the same high surrogate: their low ones are in code point order.
    return a[i..].cmp(b[i..])
}

// The first UTF-16 unit of the character starting at `i`.
fn first_unit(s: String, i: usize) -> i32 {
    let b = i32(s.byte_at(i))
    if b >= 0xF0 {
        let cp = ((b & 0x07) << 18) | (low6(s, i + 1) << 12) | (low6(s, i + 2) << 6) | low6(s, i + 3)
        return 0xD800 + ((cp - 0x10000) >> 10)
    }
    if b >= 0xE0 {
        return ((b & 0x0F) << 12) | (low6(s, i + 1) << 6) | low6(s, i + 2)
    }
    if b >= 0xC0 {
        return ((b & 0x1F) << 6) | low6(s, i + 1)
    }
    return b
}
