/// Java's `Character`, where vanilla's results depend on it: the UTF-16 units it counts as
/// whitespace, which brigadier skips between a command's parts and SNBT's, and the code point a
/// character's name names, which SNBT's `\N{...}` escape reads. Written from black-box tests of
/// JDK 25.
module java.character

import java.names.{blocks, named}

/// Whether Java's `Character.isWhitespace` takes the unit: the ASCII controls from U+0009 to
/// U+000D and from U+001C to U+001F, and the space, line and paragraph separators but the
/// no-break ones, U+00A0, U+2007 and U+202F.
pub fn is_whitespace(c: char) -> bool {
    let v = u32(c)
    if v <= 0x20 {
        return (v >= 0x09 and v <= 0x0D) or v >= 0x1C
    }
    if v < 0x1680 {
        return false
    }
    return v == 0x1680 or (v >= 0x2000 and v <= 0x200A and v != 0x2007) or v == 0x2028 or v == 0x2029 or v == 0x205F or v == 0x3000
}

/// The code point `name` names, as Java's `Character.codePointOf` finds it, or `none` where that
/// throws. The name is any case, and characters up to U+0020 around it are ignored. It's the name
/// `Character.getName` gives: Unicode's, such as `SNOWMAN`, or for a code point without one of
/// its own, its block and its number in hex, such as `CJK UNIFIED IDEOGRAPHS 4E00`.
pub fn code_point_of(name: String) -> u32? {
    var start: usize = 0
    var end = name.len()
    while start < end and name.byte_at(start) <= 0x20 {
        start += 1
    }
    while end > start and name.byte_at(end - 1) <= 0x20 {
        end -= 1
    }
    let target = name[start..end].to_upper_root()
    if let cp = in_block(target) {
        return some(cp)
    }
    return find_named(target)
}

// The code point a block's name and a number name: the number as `getName` writes it, in hex
// with no leading zeros, of a code point in a run of that block.
fn in_block(target: String) -> u32? {
    let space = target.find_last(" ") else return none
    let digits = target[space + 1..]
    if digits.is_empty() or digits.len() > 6 or digits.byte_at(0) == 48 {
        return none
    }
    let cp = hex(digits) else return none
    let block = target[..space]
    for b in blocks() {
        if b.name == block and cp >= b.first and cp <= b.last {
            return some(cp)
        }
    }
    return none
}

// Finds `target` in the sorted, front-coded table. Since it's sorted, a line that shares more of
// the line before than the target does comes before the target too, and one that shares less
// comes after it, so only the lines sharing exactly as much are compared, and the search stops
// at the first that comes after the target.
fn find_named(target: String) -> u32? {
    let table = named()
    // How many of the target's first bytes the last name had.
    var matched: usize = 0
    var i: usize = 0
    while i < table.len() {
        let shared = usize(table.byte_at(i) - 0x30)
        var semi = i + 1
        while table.byte_at(semi) != 59 {
            semi += 1
        }
        var end = semi + 1
        while end < table.len() and table.byte_at(end) != 10 {
            end += 1
        }
        if shared < matched {
            return none
        }
        if shared == matched {
            var at = i + 1
            while at < semi and matched < target.len() and table.byte_at(at) == target.byte_at(matched) {
                at += 1
                matched += 1
            }
            if at == semi and matched == target.len() {
                return hex(table[semi + 1..end])
            }
            if at < semi and (matched == target.len() or table.byte_at(at) > target.byte_at(matched)) {
                return none
            }
        }
        i = end + 1
    }
    return none
}

// Uppercase hex digits as a number, or `none` if they aren't.
fn hex(digits: String) -> u32? {
    var v = 0u32
    for i in 0..digits.len() {
        let b = digits.byte_at(i)
        var d = 0u32
        if b >= 48 and b <= 57 {
            d = u32(b) - 48
        } else if b >= 65 and b <= 70 {
            d = u32(b) - 55
        } else {
            return none
        }
        v = v * 16 + d
    }
    return some(v)
}
