module java.categories

/// Whether Java's `Character.getType` puts the code point in `NON_SPACING_MARK`, Unicode's Mn.
pub fn is_non_spacing_mark(c: u32) -> bool {
    if c < 0x300 {
        return false
    }
    var lo: usize = 0
    var hi: usize = 357
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if MARK_FIRST[mid] <= c {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo > 0 and c <= MARK_LAST[lo - 1]
}

/// Whether Java's `Character.isLetterOrDigit` takes the UTF-16 unit: a letter, of any of
/// Unicode's L categories, or a decimal digit, Nd. A surrogate never is.
pub fn is_letter_or_digit(c: u32) -> bool {
    if c < 0x80 {
        return (c >= 0x30 and c <= 0x39) or ((c | 0x20) >= 0x61 and (c | 0x20) <= 0x7A)
    }
    if c > 0xFFFF {
        return false
    }
    var lo: usize = 0
    var hi: usize = 401
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if LETTER_FIRST[mid] <= c {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo > 0 and c <= LETTER_LAST[lo - 1]
}

