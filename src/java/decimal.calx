/// Java's `DecimalFormat` for the pattern `#` in `Locale.ROOT`, with at most a given number of
/// fraction digits, as vanilla's `MacroFunction` writes a float or double it puts in a macro line
/// (D568): no grouping, no exponent, no zero before the point, the fraction's trailing zeros left
/// out, and `0` where no digit's left; rounded half to even by the value's exact place; `NaN`, and
/// `∞` for an infinity. Its digits are those JDK 25's `FloatingDecimal` gives `DigitList`: an
/// integer from 2⁵² to 2⁶³ exactly, its low digits rounded off from 2⁵⁸ on, and otherwise the
/// shortest that read back as the double, as `Double.toString` gives them. Written from black-box
/// tests of JDK 25, which these match on 72,697 doubles below 2⁶³. Past 2⁶³ the old
/// `FloatingDecimal` gives some doubles more digits than the shortest, such as `1e23`'s
/// `99999999999999990000000`, which this doesn't yet.
module java.decimal

import java.number.{parse_int}

/// `new DecimalFormat("#", DecimalFormatSymbols.getInstance(Locale.ROOT))` with
/// `setMaximumFractionDigits(max_fraction)`, formatting `d`.
pub fn format_plain(d: f64, max_fraction: i32) -> String {
    if d.is_nan() {
        return String("NaN")
    }
    let negative = d.to_bits() >> 63 != 0
    var out = String(if negative { "-" } else { "" })
    let magnitude = f64.from_bits(d.to_bits() & 0x7FFFFFFFFFFFFFFF)
    if magnitude == 1.0 / 0.0 {
        out.push_str("∞")
        return out
    }
    let (given, given_point) = digits_of(magnitude)
    var digits = given.copy()
    var point = given_point
    // `DigitList.set` with `fixedPoint`: rounded to the fraction digits allowed.
    let cut = i64(point) + i64(max_fraction)
    if cut < i64.wrap(digits.len()) {
        if cut < 0 {
            digits.clear()
        } else {
            let at = usize.wrap(cut)
            let up = rounds_up(magnitude, digits, point, at)
            while digits.len() > at {
                _ = digits.pop()
            }
            if up {
                // Carried up from the last digit kept; past the first, a 1 a place higher.
                var i = at
                var carried = true
                while i > 0 and carried {
                    i -= 1
                    if digits[i] == 9 {
                        digits[i] = 0
                    } else {
                        digits[i] += 1
                        carried = false
                    }
                }
                if carried {
                    digits.insert(0, 1)
                    point += 1
                }
            }
        }
        while digits.len() > 0 and digits[digits.len() - 1] == 0 {
            _ = digits.pop()
        }
    }
    if digits.is_empty() {
        out.push_str("0")
        return out
    }
    // The integer's digits, then the fraction's after a point, zeros between where it's past them.
    for i in 0..point.max(0) {
        let at = usize.wrap(i)
        out.push_str(if at < digits.len() { "{digits[at]}" } else { "0" })
    }
    if i64.wrap(digits.len()) > i64(point) {
        out.push_str(".")
        for _ in point..0 {
            out.push_str("0")
        }
        for i in usize.wrap(point.max(0))..digits.len() {
            out.push_str("{digits[i]}")
        }
    }
    return out
}

// The digits of a positive, finite `d`, without leading or trailing zeros, none for 0, and where
// the point is among them: `d` is `0.d₁d₂…` times 10 to that.
fn digits_of(d: f64) -> (List<u8>, i32) {
    var digits = List<u8>()
    if d == 0.0 {
        return (digits, 0)
    }
    let exponent = i32.wrap((d.to_bits() >> 52) & 0x7FF) - 1023
    if exponent >= 52 and exponent <= 62 {
        // An integer, exactly, its low digits rounded half up from 2⁵⁸: one there and from 2⁶¹
        // two, as `insignificantDigitsForPow2` counts them.
        var n = u64.wrap(i64.saturate(d))
        let low: u32 = if exponent >= 61 { 2 } else if exponent >= 58 { 1 } else { 0 }
        var scale: u64 = 1
        for _ in 0..low {
            scale *= 10
        }
        if scale > 1 {
            let rest = n % scale
            n = n / scale
            if rest >= scale / 2 {
                n += 1
            }
        }
        let text = "{n}"
        for b in text.to_bytes() {
            digits.push(b - 48)
        }
        let point = i32.wrap(digits.len()) + i32.wrap(low)
        while digits.len() > 0 and digits[digits.len() - 1] == 0 {
            _ = digits.pop()
        }
        return (digits, point)
    }
    // `Double.toString`'s: `1.2345E-7` or `123.45`.
    let text = "{d}"
    var mantissa = text.copy()
    var power: i32 = 0
    if let e = text.find("E") {
        mantissa = text[..e]
        power = match parse_int(text[e + 1..], 10) {
            ok(v) => v,
            err(_) => 0,
        }
    }
    var point: i32 = 0
    var seen_point = false
    for b in mantissa.to_bytes() {
        if b == 46 {
            seen_point = true
            continue
        }
        if digits.is_empty() and b == 48 {
            // A leading zero, before or after the point.
            if seen_point {
                point -= 1
            }
            continue
        }
        digits.push(b - 48)
        if not seen_point {
            point += 1
        }
    }
    while digits.len() > 0 and digits[digits.len() - 1] == 0 {
        _ = digits.pop()
    }
    return (digits, point + power)
}

// `DigitList.shouldRoundUp` for `HALF_EVEN`, cutting `digits` at `at`: up past half, down below
// it, and at a 5 that's the last digit, by where `d` is exactly against the digits: up where it's
// past them, down where it's short of them, and to an even digit where they're `d` exactly.
fn rounds_up(d: f64, digits: List<u8>, point: i32, at: usize) -> bool {
    if digits[at] != 5 {
        return digits[at] > 5
    }
    for i in at + 1..digits.len() {
        if digits[i] != 0 {
            return true
        }
    }
    let against = compare_exact(d, digits, point)
    if against != 0 {
        return against > 0
    }
    return at > 0 and digits[at - 1] % 2 == 1
}

// Whether `d`, positive and finite, is past (1), short of (-1) or exactly (0) the decimal
// `0.d₁d₂…` times 10 to `point`, by exact integers: `m` times 2 to `e` against `D` times 10 to
// `q`, each side times what makes both whole.
fn compare_exact(d: f64, digits: List<u8>, point: i32) -> i32 {
    let bits = d.to_bits()
    let biased = i32.wrap((bits >> 52) & 0x7FF)
    var m = bits & 0xFFFFFFFFFFFFF
    var e: i32 = 0
    if biased == 0 {
        e = -1074
    } else {
        m = m | (1 << 52)
        e = biased - 1075
    }
    var left = Big.of(m)
    var right = Big.of(0)
    for x in digits {
        right.times_add(10, u32(x))
    }
    let q = point - i32.wrap(digits.len())
    // m·2^e against D·10^q.
    if e >= 0 {
        left.shift(u32.wrap(e))
    } else {
        right.shift(u32.wrap(-e))
    }
    if q >= 0 {
        for _ in 0..q {
            right.times_add(10, 0)
        }
    } else {
        for _ in 0..-q {
            left.times_add(10, 0)
        }
    }
    return left.compare(right)
}

// A natural number, as base-2³² digits from the lowest, for `compare_exact`.
struct Big {
    limbs: List<u32>
}

impl Big {
    fn of(n: u64) -> Big {
        return Big { limbs: [u32.wrap(n), u32.wrap(n >> 32)] }
    }

    // The number times `by`, plus `add`.
    fn times_add(mut self, by: u32, add: u32) {
        var carry = u64(add)
        for i in 0..self.limbs.len() {
            let v = u64(self.limbs[i]) * u64(by) + carry
            self.limbs[i] = u32.wrap(v)
            carry = v >> 32
        }
        if carry > 0 {
            self.limbs.push(u32.wrap(carry))
        }
    }

    // The number times 2 to `bits`.
    fn shift(mut self, bits: u32) {
        let whole = bits / 32
        let part = bits % 32
        if part > 0 {
            var carry: u32 = 0
            for i in 0..self.limbs.len() {
                let v = self.limbs[i]
                self.limbs[i] = (v << part) | carry
                carry = v >> (32 - part)
            }
            if carry > 0 {
                self.limbs.push(carry)
            }
        }
        for _ in 0..whole {
            self.limbs.insert(0, 0)
        }
    }

    // 1, 0 or -1 as the number is past, at or short of `other`.
    fn compare(self, other: Big) -> i32 {
        let n = self.limbs.len().max(other.limbs.len())
        var i = n
        while i > 0 {
            i -= 1
            let a = if i < self.limbs.len() { self.limbs[i] } else { 0 }
            let b = if i < other.limbs.len() { other.limbs[i] } else { 0 }
            if a != b {
                return if a > b { 1 } else { -1 }
            }
        }
        return 0
    }
}
