/// Scratch, for CAL-88's light work: generates the chunks around 0, 0 as the server does, then
/// lights them as the level does, a chunk at a time once the 3×3 around it is initialized, and
/// says how long that took and a hash of every nibble, so a faster engine can be checked to light
/// the same. Not a test.
///
///     calx run --release src/light_real.calx -- RADIUS RUNS
module light_real

import pack.vanilla.{vanilla_data}
import rig.registries.{load_vanilla}
import server.chunk_jobs.{SavedChunk, generated}
import server.log.{Entry}
import server.play.{block_states}
import std.env.{args, variable}
import std.time.{Instant}
import world.light.{Light, LightChunks, LightStates, SectionStates, NO_CHUNK, light_sources, section_bytes, section_states}
import worldgen.generator.{GenSetup}
import worldgen.scheduler.{Generator}

const MIN_SECTION: i32 = -4
const SECTIONS: i32 = 24

fn key(x: i32, z: i32) -> i64 {
    return (i64(z) << 32) | (i64(x) & 0xFFFFFFFF)
}

struct World {
    states: LightStates
    chunks: Map<i64, SavedChunk> = Map<i64, SavedChunk>()
}

impl LightChunks for World {
    fn light_state(self, x: i32, y: i32, z: i32) -> u32? {
        let k = key(x >> 4, z >> 4)
        if not self.chunks.contains(k) {
            return none
        }
        return some(self.chunks[k].chunk.value.block(x & 15, y, z & 15))
    }

    fn light_section(self, chunk_x: i32, section_y: i32, chunk_z: i32) -> SectionStates? {
        let k = key(chunk_x, chunk_z)
        if not self.chunks.contains(k) {
            return none
        }
        return some(section_states(self.chunks[k].chunk.value, section_y))
    }

    fn light_bytes(self, chunk_x: i32, section_y: i32, chunk_z: i32, table: List<u8>, out: mut List<u8>) -> i32 {
        let k = key(chunk_x, chunk_z)
        if not self.chunks.contains(k) {
            return NO_CHUNK
        }
        return section_bytes(self.chunks[k].chunk.value, section_y, table, mut out)
    }

    fn lowest_sky_source(self, x: i32, z: i32) -> i32? {
        let k = key(x >> 4, z >> 4)
        if not self.chunks.contains(k) {
            return none
        }
        if let s = self.chunks[k].sources {
            return some(s.lowest_source_y(x & 15, z & 15))
        }
        return none
    }

    fn highest_sky_source(self, chunk_x: i32, chunk_z: i32) -> i32? {
        let k = key(chunk_x, chunk_z)
        if not self.chunks.contains(k) {
            return none
        }
        if let s = self.chunks[k].sources {
            return some(s.highest_lowest_source_y())
        }
        return none
    }

    fn light_sources_in(self, chunk_x: i32, chunk_z: i32) -> List<i64> {
        let k = key(chunk_x, chunk_z)
        if not self.chunks.contains(k) {
            return []
        }
        return light_sources(self.chunks[k].chunk.value, self.states, chunk_x, chunk_z)
    }
}

fn number(s: String) -> i32 {
    var n = 0
    for i in 0..s.len() {
        n = n * 10 + i32(s.byte_at(i) - 48)
    }
    return n
}

// Lights the chunks within `radius` of 0, 0, those one further initialized first, as the level
// does; gives the queue entries the runs went through and a hash of every nibble.
fn light_all(world: World, radius: i32) -> (Light, i64) {
    let init_start = unsafe { Instant.now() }
    var light = Light.new(MIN_SECTION * 16, SECTIONS * 16, variable(String("LIGHT_NO_SKY")) == none)
    let r = radius + 1
    let batch = number(variable(String("LIGHT_BATCH")) ?? String("0"))
    for cz in -r..r + 1 {
        for cx in -r..r + 1 {
            let k = key(cx, cz)
            for i in 0..world.chunks[k].chunk.value.section_count() {
                if not world.chunks[k].chunk.value.section_only_air(i) {
                    light.update_section_status(cx, MIN_SECTION + i32.wrap(i), cz, false)
                }
            }
            if batch == 0 {
                _ = light.run(world.states, world)
                light.set_light_enabled(world, cx, cz, false)
                light.retain_data(cx, cz, false)
            }
        }
    }
    if batch > 0 {
        _ = light.run(world.states, world)
        for cz in -r..r + 1 {
            for cx in -r..r + 1 {
                light.set_light_enabled(world, cx, cz, false)
                light.retain_data(cx, cz, false)
            }
        }
    }
    let init_done = unsafe { Instant.now() }
    var entries: i64 = 0
    var in_sources: u64 = 0
    var in_runs: u64 = 0
    var waiting = 0
    for cz in -radius..radius + 1 {
        for cx in -radius..radius + 1 {
            let a = unsafe { Instant.now() }
            light.propagate_light_sources(world.states, world, cx, cz)
            let b = unsafe { Instant.now() }
            in_sources += b.nanos_since(a)
            waiting += 1
            if batch == 0 or waiting >= batch {
                entries += i64(light.run(world.states, world))
                in_runs += unsafe { Instant.now() }.nanos_since(b)
                waiting = 0
            }
        }
    }
    if waiting > 0 {
        let b = unsafe { Instant.now() }
        entries += i64(light.run(world.states, world))
        in_runs += unsafe { Instant.now() }.nanos_since(b)
    }
    println("phases: initialized {init_done.nanos_since(init_start) / 1000} us, sources {in_sources / 1000} us, runs {in_runs / 1000} us")
    return (light, entries)
}

fn mix(hash: u64, bytes: List<u8>) -> u64 {
    var h = (hash ^ u64(bytes.len())) * 1099511628211
    for b in bytes {
        h = (h ^ u64(b)) * 1099511628211
    }
    return h
}

fn hash_of(light: Light, radius: i32) -> u64 {
    var hash: u64 = 14695981039346656037
    for cz in -radius..radius + 1 {
        for cx in -radius..radius + 1 {
            let d = light.light_data(cx, cz)
            hash = mix(hash, d.sky_mask)
            hash = mix(hash, d.block_mask)
            hash = mix(hash, d.empty_sky_mask)
            hash = mix(hash, d.empty_block_mask)
            for l in d.sky {
                hash = mix(hash, l.data)
            }
            for l in d.block {
                hash = mix(hash, l.data)
            }
        }
    }
    return hash
}

fn main() ! String {
    let a = args()
    let radius = number(a[0])
    let runs = number(a[1])
    let loaded = try load_vanilla()
    var lines = List<Entry>()
    let zip = try vanilla_data(String("build/fly/cache/vanilla-26.3.data"), mut lines)
    let b = loaded.registries.find_builtin(String("block")) else fail String("no block registry")
    let f = loaded.registries.find_builtin(String("fluid")) else fail String("no fluid registry")
    let bi = loaded.registries.find(String("worldgen/biome")) else fail String("no biome registry")
    let table = try block_states(loaded.registries)
    let uncarvable = loaded.registries.builtin[b].tag_values(String("uncarvable"))
    let setup = GenSetup { settings: String("minecraft:overworld"), blocks: loaded.registries.builtin[b].copy(), fluids: loaded.registries.builtin[f].copy(), biomes: loaded.registries.synced[bi].copy(), table: table, uncarvable: uncarvable, seed: 20261101 }
    var g = try Generator.new(zip, setup)
    var world = World { states: LightStates.new() }
    let r = radius + 1
    let made_at = unsafe { Instant.now() }
    for cz in -r..r + 1 {
        for cx in -r..r + 1 {
            let chunk = match g.full(cx, cz) {
                ok(c) => c,
                err(t) => fail "chunk {cx}, {cz}: {t.exception}: {t.message}",
            }
            world.chunks.insert(key(cx, cz), generated(chunk, world.states, SECTIONS))
        }
    }
    println("generated {(2 * r + 1) * (2 * r + 1)} chunks in {unsafe { Instant.now() }.secs_since(made_at)} s")
    var best: u64 = u64.MAX
    var entries: i64 = 0
    var hash: u64 = 0
    for _ in 0..runs {
        let start = unsafe { Instant.now() }
        let (light, n) = light_all(world, radius)
        let took = unsafe { Instant.now() }.nanos_since(start)
        if took < best {
            best = took
        }
        entries = n
        hash = hash_of(light, radius)
    }
    let scan_start = unsafe { Instant.now() }
    var sources: usize = 0
    for cz in -radius..radius + 1 {
        for cx in -radius..radius + 1 {
            sources += light_sources(world.chunks[key(cx, cz)].chunk.value, world.states, cx, cz).len()
        }
    }
    println("light_sources for every chunk: {unsafe { Instant.now() }.nanos_since(scan_start) / 1000} us, {sources} sources")
    let lit = (2 * radius + 1) * (2 * radius + 1)
    println("lit {lit} chunks: best {best / 1000} us, {best / u64.wrap(lit) / 1000} us a chunk, {entries} entries, {best / u64.wrap(entries)} ns an entry, hash {hash}")
    var bits_bytes: u64 = 0
    var sections: u64 = 0
    var by_bits = [0u64; 17]
    for (_, c) in world.chunks {
        for i in 0..c.chunk.value.section_count() {
            sections += 1
            let sb = c.chunk.value.section(i).states().bits()
            bits_bytes += u64.wrap(sb) * 4096 / 8
            by_bits[usize.wrap(sb)] += 1
        }
    }
    println("{world.chunks.len()} chunks, {sections} sections, block state bytes {bits_bytes}, {bits_bytes / u64(world.chunks.len())} a chunk, sections by bits {by_bits}")
}
