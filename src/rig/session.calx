        // own turn, still, heard there, those that see the stone told at once.
        ("summon pig 46.5 -60 40.5 \{NoAI:1b,Rotation:[90f,10f],UUID:[I;5,8,5,1]\}", "owned-pig"),
        ("summon item 48.5 -60 40.5 \{Item:\{id:stone,count:1\},PickupDelay:1000,UUID:[I;5,8,5,2]\}", "owned-item"),
        ("summon ender_pearl 46.5 -58 37.5 \{Owner:[I;5,8,5,1],Motion:[0.0,-0.5,0.0]\}", "owned-pig-pearl"),
        ("summon ender_pearl 48.5 -58 37.5 \{Owner:[I;5,8,5,2],Motion:[0.0,-0.5,0.0]\}", "owned-item-pearl"),
