// `knots`' steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival mode,
// summons a cow and a sheep without AI west and south of it and sets an oak fence between them,
// away from the end portal east of the spawn; leashes both and ties them to the fence, a knot made
// there; takes them back from the knot, which goes; ties them again, and cuts them from the new
// knot with shears; leashes and ties them again, and hits the knot, which goes, its mobs' leads
// dropped; ties the cow alone, and takes the fence away, the knot gone at its next look; sets the
// fence again and summons a pig saved tied to it, a knot made for it, in a step of its own, as
// `#all` would split its array at its `;`; and leashes the sheep and
// ties it to that knot by using it. It watches for 5 seconds.
fn knots_steps() -> List<(str, str)> {
    return [
        ("time set day", "knots-day"),
        ("gamemode survival", "knots-survival"),
        ("#all summon cow -2.5 -60 0.5 \{NoAI:1b\};summon sheep 0.5 -60 3.5 \{NoAI:1b\};setblock -2 -60 3 oak_fence", "knots-mobs"),
        ("item replace entity @s weapon.mainhand with lead 8", "knots-lead"),
        ("#use-mob 0", "knots-cow"),
        ("#use-mob 1", "knots-sheep"),
        ("#use -2 -60 3", "knots-tied"),
        ("", "knots-waited"),
        ("#use-mob 2", "knots-taken-back"),
        ("#use -2 -60 3", "knots-tied-again"),
        ("item replace entity @s weapon.mainhand with shears", "knots-shears"),
        ("#use-mob 3", "knots-cut"),
        ("item replace entity @s weapon.mainhand with lead 8", "knots-lead-again"),
        ("#use-mob 0", "knots-cow-again"),
        ("#use-mob 1", "knots-sheep-again"),
        ("#use -2 -60 3", "knots-tied-third"),
        ("#hit-mob 2", "knots-hit"),
        ("", "knots-dropped"),
        ("#use-mob 0", "knots-cow-third"),
        ("#use -2 -60 3", "knots-cow-tied"),
        ("#all setblock -2 -60 3 air", "knots-no-fence"),
        ("", "knots-looking-1"), ("", "knots-looking-2"), ("", "knots-looking-3"), ("", "knots-looking-4"), ("", "knots-looking-5"), ("", "knots-looking-6"),
        ("setblock -2 -60 3 oak_fence", "knots-fence-again"),
        ("summon pig -1.5 -60 2.5 \{NoAI:1b,leash:[I;-2,-60,3]\}", "knots-saved"),
        ("", "knots-restored"),
        ("#use-mob 1", "knots-sheep-fourth"),
        ("#use-mob 7", "knots-sheep-to-knot"),
        ("", "knots-1"), ("", "knots-2"), ("", "knots-3"), ("", "knots-4"), ("", "knots-5"),
        ("", "knots-after"),
    ]
}

// `beetied`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, summons a bee with its AI west of it and sets an oak fence south of that, away from the
// end portal east of the spawn; leashes the bee and ties it to the fence, its home about the
// knot; steps up by the fence, hits the bee and in the same tick steps south out of its home, so
// the bee doesn't take it up as who hurt it, `isWithinHome`; waits 3 seconds and steps back in,
// within the 5 seconds the bee remembers its hurt, and is taken up and stung. It watches for 5
// seconds.
fn beetied_steps() -> List<(str, str)> {
    return [
        ("time set day", "beetied-day"),
        ("gamemode survival", "beetied-survival"),
        ("#all summon bee -2.5 -59 1.5;setblock -2 -60 3 oak_fence", "beetied-bee"),
        ("item replace entity @s weapon.mainhand with lead", "beetied-lead"),
        ("#use-mob 0", "beetied-leashed"),
        ("#use -2 -60 3", "beetied-tied"),
        ("", "beetied-waited"),
        ("#move 0.5 -60 3.5", "beetied-by-fence"),
        ("#hit-move 0 0.5 -60 9.5", "beetied-hit"),
        ("", "beetied-out-1"), ("", "beetied-out-2"), ("", "beetied-out-3"),
        ("#move 0.5 -60 3.5", "beetied-back"),
        ("", "beetied-1"), ("", "beetied-2"), ("", "beetied-3"), ("", "beetied-4"), ("", "beetied-5"),
        ("", "beetied-after"),
    ]
}

// `horsefeed`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, summons without AI a hurt horse, a donkey, a tamed horse, a foal and a zombie horse about
// it, away from the end portal east of the spawn; feeds the hurt horse wheat, healed and its
// temper up; the donkey wheat, its temper up; the tamed horse a golden carrot, which it loves,
// then sugar, which does nothing, full and tamed; the foal an apple, which grows it; and the
// zombie horse a red mushroom; then uses a stick on the donkey, which makes it mad. It watches
// for 3 seconds, their mouths shut again.
fn horsefeed_steps() -> List<(str, str)> {
    return [
        ("time set day", "horsefeed-day"),
        ("gamemode survival", "horsefeed-survival"),
        ("#all summon horse -2.5 -60 0.5 \{NoAI:1b,Health:10f\};summon donkey 0.5 -60 3.5 \{NoAI:1b\};summon horse 0.5 -60 -2.5 \{NoAI:1b,Tame:1b\};summon horse -1.5 -60 2.5 \{NoAI:1b,Age:-24000\};summon zombie_horse -1.5 -60 -1.5 \{NoAI:1b\}", "horsefeed-mobs"),
        ("item replace entity @s weapon.mainhand with wheat 4", "horsefeed-wheat"),
        ("#use-mob 0", "horsefeed-healed"),
        ("#use-mob 1", "horsefeed-donkey"),
        ("item replace entity @s weapon.mainhand with golden_carrot 2", "horsefeed-carrot"),
        ("#use-mob 2", "horsefeed-love"),
        ("item replace entity @s weapon.mainhand with sugar 2", "horsefeed-sugar"),
        ("#use-mob 2", "horsefeed-full"),
        ("item replace entity @s weapon.mainhand with apple 2", "horsefeed-apple"),
        ("#use-mob 3", "horsefeed-foal"),
        ("item replace entity @s weapon.mainhand with red_mushroom 2", "horsefeed-mushroom"),
        ("#use-mob 4", "horsefeed-zombie"),
        ("item replace entity @s weapon.mainhand with stick", "horsefeed-stick"),
        ("#use-mob 1", "horsefeed-mad"),
        ("", "horsefeed-1"), ("", "horsefeed-2"), ("", "horsefeed-3"),
        ("", "horsefeed-after"),
    ]
}

// `steered`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, its hands empty, summons a tame saddled horse without AI beside it, gets on and steers it
// south, holding forward, at 0.2 and then 0.25 a tick, as its client moves it; then too far in a
// tick, which is sent back; then into a stone block set in its way, which is sent back too; lets
// go and sneaks off. Then, holding a carrot on a stick, it gets on a saddled pig without AI, steers
// it south at 0.15 a tick, uses the stick, which boosts the pig, steers it on at 0.3 a tick and
// sneaks off. Each wait is a second.
fn steered_steps() -> List<(str, str)> {
    return [
        ("time set day", "steered-day"),
        ("gamemode survival", "steered-survival"),
        ("item replace entity @s weapon.mainhand with air", "steered-empty"),
        ("summon horse -1.5 -60 0.5 \{Tame:1b,NoAI:1b,equipment:\{saddle:\{id:\"minecraft:saddle\",count:1\}\}\}", "steered-horse"),
        ("#use-mob 0", "steered-on"),
        ("", "steered-1"),
        ("#input 1", "steered-forward"),
        ("#ride -1.5 -60 0.5 0.2 10", "steered-ride"),
        ("#ride -1.5 -60 2.5 0.25 12", "steered-ride-on"),
        ("#ride -1.5 -60 5.5 11.0 1", "steered-too-far"),
        ("setblock -2 -60 7 stone", "steered-wall"),
        ("#ride -1.5 -60 5.5 0.5 4", "steered-into-wall"),
        ("#input 0", "steered-stop"),
        ("#sneak", "steered-sneak"),
        ("", "steered-off"),
        ("#unsneak", "steered-stand"),
        ("summon pig 0.5 -60 5.5 \{NoAI:1b,equipment:\{saddle:\{id:\"minecraft:saddle\",count:1\}\}\}", "steered-pig"),
        ("item replace entity @s weapon.mainhand with carrot_on_a_stick", "steered-stick"),
        ("#use-mob 1", "steered-pig-on"),
        ("", "steered-2"),
        ("#input 1", "steered-pig-forward"),
        ("#ride 0.5 -60 5.5 0.15 10", "steered-pig-ride"),
        ("#throw 0 0", "steered-boost"),
        ("#ride 0.5 -60 7.0 0.3 8", "steered-boosted"),
        ("#input 0", "steered-pig-stop"),
        ("#sneak", "steered-pig-sneak"),
        ("", "steered-pig-off"),
        ("#unsneak", "steered-pig-stand"),
        ("", "steered-after"),
    ]
}

// `donkeychest`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, holding a chest, with ten stone and a saddle in its hotbar's next two slots, summons a
// tame donkey without AI and puts the chest on it, then opens its inventory sneaking. The menu has
// the saddle's slot 0 and the armour's 1, the chest's 15 from 2, then the inventory's 27 from 17
// and the hotbar's 9 from 44. It shift-clicks the stone into the chest and the saddle on, picks the
// stone up, puts one in the chest's next slot with the right button and the rest back, and closes
// the menu; opens it again and closes it; then hits the donkey, summoned with half a heart, which
// dies and drops what its chest held, the chest and the saddle, `#hit-any`. Then it summons a
// donkey with a chest on and four dirt in its fourth slot, opens it sneaking and closes it, and
// leaves it to be saved with them. Each wait is a second.
fn donkeychest_steps() -> List<(str, str)> {
    return [
        ("time set day", "donkeychest-day"),
        ("gamemode survival", "donkeychest-survival"),
        ("item replace entity @s hotbar.0 with chest", "donkeychest-chest"),
        ("item replace entity @s hotbar.1 with stone 10", "donkeychest-stone"),
        ("item replace entity @s hotbar.2 with saddle", "donkeychest-saddle"),
        ("summon donkey -1.5 -60 0.5 \{Tame:1b,NoAI:1b,Health:1.0f\}", "donkeychest-donkey"),
        ("#use-mob 0", "donkeychest-chest-on"),
        ("#sneak", "donkeychest-sneak"),
        ("#sneak-use-mob 0", "donkeychest-open"),
        ("#unsneak", "donkeychest-stand"),
        ("#click 45 0 1", "donkeychest-stone-in"),
        ("#click 46 0 1", "donkeychest-saddle-on"),
        ("#click 2 0 0", "donkeychest-stone-up"),
        ("#click 3 1 0", "donkeychest-one-down"),
        ("#click 2 0 0", "donkeychest-rest-down"),
        ("#close", "donkeychest-close"),
        ("#sneak", "donkeychest-sneak-again"),
        ("#sneak-use-mob 0", "donkeychest-open-again"),
        ("#unsneak", "donkeychest-stand-again"),
        ("#close", "donkeychest-close-again"),
        ("#hit-any 0", "donkeychest-kill"),
        ("", "donkeychest-dropped"),
        ("summon donkey 1.5 -60 0.5 \{Tame:1b,NoAI:1b,ChestedHorse:1b,Items:[\{Slot:3b,id:\"minecraft:dirt\",count:4\}]\}", "donkeychest-loaded"),
        ("#sneak", "donkeychest-sneak-loaded"),
        ("#sneak-use-mob 1", "donkeychest-open-loaded"),
        ("#unsneak", "donkeychest-stand-loaded"),
        ("#close", "donkeychest-close-loaded"),
        ("", "donkeychest-after"),
    ]
}

// `leaps`' steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival mode,
// its hand empty, summons a tame saddled horse without AI, gets on and steers it south, holding
// forward, five moves of 0.2; then jumps it at full strength and leaps 3 blocks up and 5.4 on in
// 18 client ticks, landing from past a block; jumps it at no strength, which does nothing; jumps
// it at 40 and hops 0.7 up and 1.8 on, landing from less than a block; then lets go and sneaks
// off. Then a tame saddled donkey without AI, which it gets on, jumps standing and sneaks off.
// Each wait is a second.
fn leaps_steps() -> List<(str, str)> {
    return [
        ("time set day", "leaps-day"),
        ("gamemode survival", "leaps-survival"),
        ("item replace entity @s weapon.mainhand with air", "leaps-empty"),
        ("summon horse -1.5 -60 0.5 \{Tame:1b,NoAI:1b,equipment:\{saddle:\{id:\"minecraft:saddle\",count:1\}\}\}", "leaps-horse"),
        ("#use-mob 0", "leaps-on"),
        ("", "leaps-1"),
        ("#input 1", "leaps-forward"),
        ("#ride -1.5 -60 0.5 0.2 5", "leaps-ride"),
        ("#jump-leap 100 -1.5 -60 1.5 0.3 0.7", "leaps-leap"),
        ("", "leaps-landed"),
        ("#ride-jump 0", "leaps-no-jump"),
        ("#jump-leap 40 -1.5 -60 6.9 0.2 0.3", "leaps-hop"),
        ("", "leaps-hopped"),
        ("#input 0", "leaps-stop"),
        ("#sneak", "leaps-sneak"),
        ("", "leaps-off"),
        ("#unsneak", "leaps-stand"),
        ("summon donkey 1.5 -60 8.5 \{Tame:1b,NoAI:1b,equipment:\{saddle:\{id:\"minecraft:saddle\",count:1\}\}\}", "leaps-donkey"),
        ("#use-mob 1", "leaps-donkey-on"),
        ("", "leaps-2"),
        ("#ride-jump 100", "leaps-donkey-jump"),
        ("", "leaps-3"),
        ("#sneak", "leaps-donkey-sneak"),
        ("", "leaps-donkey-off"),
        ("#unsneak", "leaps-donkey-stand"),
        // A tame horse without a saddle, which its rider doesn't steer, ridden off a ledge 10 up:
        // its fall hurts it and is passed on to the bot, `propagateFallToPassengers` (CAL-282).
        ("setblock 6 -51 0 stone", "leaps-ledge"),
        ("summon horse 6.5 -50 0.5 \{Tame:1b,Tags:[\"fall\"]\}", "leaps-high-horse"),
        ("#all ride @s mount @e[type=horse,tag=fall,limit=1];setblock 6 -51 0 air", "leaps-dropped"),
        ("#wait 3", "leaps-fallen"),
        ("ride @s dismount", "leaps-fall-off"),
        ("", "leaps-after"),
    ]
}

// `horseinv`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, its hand empty, a saddle, iron horse armour and stone in its hotbar's next three slots,
// summons a tame horse without AI and opens its inventory sneaking. The horse's menu has the
// saddle's slot 0 and the armour's 1, then the inventory's 27 from 2 and the hotbar's 9 from 29.
// It shift-clicks the saddle and the armour on, then the saddle off, which goes to the hotbar's
// last slot; picks up the stone and tries it on the saddle's slot, then puts it back; picks the
// armour up and puts it down again; and closes the menu. Then it gets on the horse, opens its
// inventory as it rides, puts the saddle back on, closes it, and sneaks off. Each wait is a second.
fn horseinv_steps() -> List<(str, str)> {
    return [
        ("time set day", "horseinv-day"),
        ("gamemode survival", "horseinv-survival"),
        ("item replace entity @s hotbar.0 with air", "horseinv-empty"),
        ("item replace entity @s hotbar.1 with saddle", "horseinv-saddle"),
        ("item replace entity @s hotbar.2 with iron_horse_armor", "horseinv-armour"),
        ("item replace entity @s hotbar.3 with stone 5", "horseinv-stone"),
        ("summon horse -1.5 -60 0.5 \{Tame:1b,NoAI:1b\}", "horseinv-horse"),
        ("#sneak", "horseinv-sneak"),
        ("#sneak-use-mob 0", "horseinv-open"),
        ("#unsneak", "horseinv-stand"),
        ("#click 30 0 1", "horseinv-saddle-on"),
        ("#click 31 0 1", "horseinv-armour-on"),
        ("#click 0 0 1", "horseinv-saddle-off"),
        ("#click 32 0 0", "horseinv-stone-up"),
        ("#click 0 0 0", "horseinv-stone-refused"),
        ("#click 32 0 0", "horseinv-stone-back"),
        ("#click 1 0 0", "horseinv-armour-up"),
        ("#click 1 0 0", "horseinv-armour-down"),
        ("#close", "horseinv-close"),
        ("#use-mob 0", "horseinv-on"),
        ("", "horseinv-1"),
        ("#open-inventory", "horseinv-riding-open"),
        ("#click 37 0 1", "horseinv-saddle-again"),
        ("#close", "horseinv-riding-close"),
        ("#sneak", "horseinv-off"),
        ("", "horseinv-2"),
        ("#unsneak", "horseinv-after-off"),
        ("", "horseinv-after"),
    ]
}

// `mounted`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, its hands empty, summons beside it a wild horse, which it gets on, and which runs around
// with it till it throws it off, angry and more tempered; then a gentle horse, its temper at
// its most, beside where it is, which it gets on and which tames itself to it as it runs; then it
// sneaks off, and lets go of shift; then a saddled pig without AI, which it gets on, rides for a
// second and sneaks off too. Each wait is a second.
fn mounted_steps() -> List<(str, str)> {
    return [
        ("time set day", "mounted-day"),
        ("gamemode survival", "mounted-survival"),
        ("item replace entity @s weapon.mainhand with air", "mounted-empty"),
        ("summon horse -1.5 -60 0.5 \{Temper:0\}", "mounted-wild"),
        ("#use-mob 0", "mounted-on"),
        ("", "mounted-1"), ("", "mounted-2"), ("", "mounted-3"), ("", "mounted-4"), ("", "mounted-5"), ("", "mounted-6"),
        ("summon horse ~ ~ ~-1.5 \{Temper:100\}", "mounted-gentle"),
        ("#use-mob 1", "mounted-again"),
        ("", "mounted-7"), ("", "mounted-8"), ("", "mounted-9"), ("", "mounted-10"), ("", "mounted-11"), ("", "mounted-12"),
        ("#sneak", "mounted-sneak"),
        ("", "mounted-off"),
        ("#unsneak", "mounted-stand"),
        ("summon pig ~ ~ ~1.5 \{NoAI:1b,equipment:\{saddle:\{id:\"minecraft:saddle\",count:1\}\}\}", "mounted-pig"),
        ("#use-mob 2", "mounted-pig-on"),
        ("", "mounted-pig-ride"),
        ("#sneak", "mounted-pig-sneak"),
        ("", "mounted-pig-off"),
        ("#unsneak", "mounted-pig-stand"),
        ("", "mounted-after"),
    ]
}

fn naming_steps() -> List<(str, str)> {
    return [
        ("time set day", "naming-day"),
        ("gamemode creative", "naming-creative"),
        ("#all summon cow 2.5 -60 0.5 \{NoAI:1b\};summon sheep -1.5 -60 0.5 \{NoAI:1b,Color:3b\};summon zombie 0.5 -60 2.5 \{NoAI:1b\};summon creeper 0.5 -60 -1.5 \{NoAI:1b\};summon pig 2.5 -60 2.5 \{NoAI:1b\}", "naming-mobs"),
        ("item replace entity @s weapon.mainhand with name_tag[custom_name=\"Bessie\"] 2", "naming-tag"),
        ("#use-mob 0", "naming-cow"),
        ("item replace entity @s weapon.mainhand with cow_spawn_egg 2", "naming-cow-egg"),
        ("#use-mob 0", "naming-calf"),
        ("item replace entity @s weapon.mainhand with sheep_spawn_egg", "naming-sheep-egg"),
        ("#use-mob 1", "naming-lamb"),
        ("item replace entity @s weapon.mainhand with zombie_spawn_egg", "naming-zombie-egg"),
        ("#use-mob 2", "naming-baby-zombie"),
        ("item replace entity @s weapon.mainhand with creeper_spawn_egg", "naming-creeper-egg"),
        ("#use-mob 3", "naming-no-baby"),
        ("item replace entity @s weapon.mainhand with pig_spawn_egg", "naming-pig-egg"),
        ("#use-mob 0", "naming-not-its-kind"),
        ("item replace entity @s weapon.mainhand with name_tag", "naming-blank-tag"),
        ("#use-mob 4", "naming-blank"),
        ("item replace entity @s weapon.mainhand with cow_spawn_egg[custom_name=\"Daisy\"]", "naming-named-egg"),
        ("#use-mob 0", "naming-named-calf"),
        ("", "naming-1"), ("", "naming-2"), ("", "naming-3"), ("", "naming-4"), ("", "naming-5"),
        ("", "naming-after"),
    ]
}

// `hivebreak`'s steps (CAL-177), where `riding`'s are, by day, on normal: the bot, in survival
// mode with a netherite axe of efficiency 5 in its hand, which breaks a hive at once, sets a
// hive east of it with two bees in it and one over a lit campfire west of it with one, summons a
// bee near them and one far off, and breaks both hives. The first hive's bees come out angry at it, as its bee
// near comes to be, `angerNearbyBees`; the smoked hive's bee stays out of hives 400 ticks but is
// angered all the same; the far bee isn't. It watches them sting it, poisoning it, for 20 seconds.
fn hivebreak_steps() -> List<(str, str)> {
    return [
        ("time set day", "hivebreak-day"),
        ("gamemode survival", "hivebreak-survival"),
        ("item replace entity @s weapon.mainhand with netherite_axe[enchantments=\{efficiency:5\}]", "hivebreak-axe"),
        ("setblock 3 -60 0 beehive[facing=east]\{bees:[\{entity_data:\{id:\"minecraft:bee\"\},ticks_in_hive:0,min_ticks_in_hive:600\},\{entity_data:\{id:\"minecraft:bee\",HasNectar:1b\},ticks_in_hive:0,min_ticks_in_hive:2400\}]\}", "hivebreak-hive"),
        ("setblock -2 -60 0 campfire", "hivebreak-campfire"),
        ("setblock -2 -59 0 bee_nest[facing=west]\{bees:[\{entity_data:\{id:\"minecraft:bee\"\},ticks_in_hive:0,min_ticks_in_hive:600\}]\}", "hivebreak-nest"),
        ("summon bee 6.5 -59 4.5", "hivebreak-near"),
        ("summon bee 30.5 -59 0.5", "hivebreak-far"),
        ("#dig 3 -60 0", "hivebreak-broken"),
        ("#dig -2 -59 0", "hivebreak-nest-broken"),
        ("", "hivebreak-1"), ("", "hivebreak-2"), ("", "hivebreak-3"), ("", "hivebreak-4"), ("", "hivebreak-5"),
        ("", "hivebreak-6"), ("", "hivebreak-7"), ("", "hivebreak-8"), ("", "hivebreak-9"), ("", "hivebreak-10"),
        ("", "hivebreak-11"), ("", "hivebreak-12"), ("", "hivebreak-13"), ("", "hivebreak-14"), ("", "hivebreak-15"),
        ("", "hivebreak-16"), ("", "hivebreak-17"), ("", "hivebreak-18"), ("", "hivebreak-19"), ("", "hivebreak-20"),
        ("", "hivebreak-after"),
    ]
}

// `beehome`'s steps (CAL-177), where `riding`'s are, by day: the bot in creative mode sets a hive,
// a bed of poppies with a dandelion and a cornflower, a row of wheat on farmland between them and
// the hive, a nest whose bee's time in it is nearly up, and a block of water under glass; it
// summons a bee with nectar that knows the hive, across the wheat from it, one with neither over
// the flowers, one that has stung, and one in the water; then it watches them for 90 seconds. The
// bee with nectar goes to its hive, growing the wheat it passes over, and into it; the one over the
// flowers pollinates one and, with nectar, looks for a hive among the level's points of interest;
// the nest's bee comes out; the one that has stung may die of it; the one in the water drowns.
fn beehome_steps() -> List<(str, str)> {
    return [
        ("time set day", "beehome-day"),
        ("gamemode creative", "beehome-creative"),
        ("setblock 7 -60 14 beehive[facing=north]", "beehome-hive"),
        ("fill 2 -60 4 12 -60 8 poppy", "beehome-poppies"),
        ("setblock 4 -60 6 dandelion", "beehome-dandelion"),
        ("setblock 12 -60 5 cornflower", "beehome-cornflower"),
        ("fill 2 -61 11 12 -61 11 farmland", "beehome-farmland"),
        ("fill 2 -60 11 12 -60 11 wheat", "beehome-wheat"),
        ("setblock 11 -60 14 bee_nest[facing=north]\{bees:[\{entity_data:\{id:\"minecraft:bee\"\},ticks_in_hive:590,min_ticks_in_hive:600\}]\}", "beehome-nest"),
        ("setblock 15 -61 2 water", "beehome-water"),
        ("setblock 15 -60 2 glass", "beehome-glass"),
        ("summon bee 7.5 -58 3.5 \{HasNectar:1b,hive_pos:[I;7,-60,14]\}", "beehome-laden"),
        ("summon bee 4.5 -59 8.5", "beehome-seeker"),
        ("summon bee 10.5 -59 2.5 \{HasStung:1b\}", "beehome-stung"),
