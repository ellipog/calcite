        ("gamemode survival", "hurt-save-survival"),
        ("effect give @s resistance 600 4 true", "hurt-save-armor"),
        ("summon zombie 0.5 -60 2.5 \{PersistenceRequired:1b\}", "hurt-save-zombie"),
        ("", "hurt-save-1"), ("", "hurt-save-2"), ("", "hurt-save-3"), ("", "hurt-save-4"), ("", "hurt-save-5"),
        ("", "hurt-save-after"),
    ]
}

// `honey-smoke`'s steps (CAL-221), where `talk`'s are, by day: the bot, in survival mode with two
// glass bottles, sets a hive full of honey two blocks over a lit campfire and one with nothing
// under it, each with a bee in it, tests whether the first's place is `smokey`, and takes the
// honey from both, `BeehiveBlock.useItemOn`: the first gives it `safely_harvest_honey` and keeps
// its bee; the second lets its bee out, angry at the bot. Then it tests `smokey` with a slab and a stone between, and
// with the campfire out; and `fluid` at a water source, falling and flowing lava, air, and a
// waterlogged slab, each fluid in a hole so it doesn't spread, by its fluids, a tag of them, and
// its `falling` and `level`, exactly and within bounds, and a value `level` can't have.
fn honey_smoke_steps() -> List<(str, str)> {
    return [
        ("time set day", "honey-smoke-day"),
        ("gamemode survival", "honey-smoke-survival"),
        ("item replace entity @s weapon.mainhand with glass_bottle 2", "honey-smoke-bottles"),
        ("setblock 0 -60 3 campfire", "honey-smoke-campfire"),
        ("setblock 0 -58 3 beehive[facing=north,honey_level=5]\{bees:[\{entity_data:\{id:\"minecraft:bee\"\},ticks_in_hive:0,min_ticks_in_hive:2400\}]\}", "honey-smoke-hive"),
        ("setblock -3 -60 0 beehive[facing=east,honey_level=5]\{bees:[\{entity_data:\{id:\"minecraft:bee\"\},ticks_in_hive:0,min_ticks_in_hive:2400\}]\}", "honey-smoke-bare-hive"),
        ("execute positioned 0 -58 3 if predicate \{type:\"minecraft:location_check\",predicate:\{smokey:1b\}\}", "honey-smoke-smoky"),
        ("execute positioned 0 -58 3 if predicate \{type:\"minecraft:location_check\",predicate:\{smokey:0b\}\}", "honey-smoke-not-smoky"),
        ("execute positioned -3 -60 0 if predicate \{type:\"minecraft:location_check\",predicate:\{smokey:1b\}\}", "honey-smoke-bare-smoky"),
        ("#use 0 -58 3", "honey-smoke-harvested"),
        ("#use -3 -60 0", "honey-smoke-bare-harvested"),
        ("setblock 0 -59 3 oak_slab", "honey-smoke-slab"),
        ("execute positioned 0 -58 3 if predicate \{type:\"minecraft:location_check\",predicate:\{smokey:1b\}\}", "honey-smoke-slab-smoky"),
        ("setblock 0 -59 3 stone", "honey-smoke-stone"),
        ("execute positioned 0 -58 3 if predicate \{type:\"minecraft:location_check\",predicate:\{smokey:1b\}\}", "honey-smoke-stone-smoky"),
        ("execute positioned 0 -57 3 if predicate \{type:\"minecraft:location_check\",predicate:\{smokey:1b\}\}", "honey-smoke-over-hive"),
        ("setblock 0 -60 3 campfire[lit=false]", "honey-smoke-out"),
        ("execute positioned 0 -58 3 if predicate \{type:\"minecraft:location_check\",predicate:\{smokey:1b\}\}", "honey-smoke-out-smoky"),
        ("setblock 9 -61 -6 water", "honey-smoke-water"),
        ("execute positioned 9 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{fluids:\"minecraft:water\"\}\}\}", "honey-smoke-water-is"),
        ("execute positioned 9 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{fluids:\"minecraft:flowing_water\"\}\}\}", "honey-smoke-water-flowing"),
        ("execute positioned 9 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{state:\{falling:\"false\"\}\}\}\}", "honey-smoke-water-falling"),
        ("execute positioned 9 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{state:\{level:\"8\"\}\}\}\}", "honey-smoke-water-level"),
        ("setblock 11 -61 -6 lava[level=8]", "honey-smoke-lava"),
        ("execute positioned 11 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{fluids:\"#minecraft:lava\",state:\{falling:\"true\",level:\"8\"\}\}\}\}", "honey-smoke-lava-falling"),
        ("execute positioned 11 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{state:\{level:\{min:\"1\",max:\"7\"\}\}\}\}\}", "honey-smoke-lava-bounds"),
        ("execute positioned 11 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{state:\{level:\{min:\"9\"\}\}\}\}\}", "honey-smoke-lava-nine"),
        ("setblock 11 -61 -6 lava[level=3]", "honey-smoke-lava-flowing"),
        ("execute positioned 11 -61 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{fluids:[\"minecraft:water\",\"minecraft:flowing_lava\"],state:\{level:\{min:\"4\",max:\"6\"\},falling:\"false\"\}\}\}\}", "honey-smoke-lava-five"),
        ("execute positioned 13 -60 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{state:\{falling:\"false\"\}\}\}\}", "honey-smoke-air-falling"),
        ("execute positioned 13 -60 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{\}\}\}", "honey-smoke-air-any"),
        ("execute positioned 13 -60 -6 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{fluids:\"minecraft:empty\"\}\}\}", "honey-smoke-air-empty"),
        ("setblock 9 -60 -8 oak_slab[waterlogged=true]", "honey-smoke-logged"),
        ("execute positioned 9 -60 -8 if predicate \{type:\"minecraft:location_check\",predicate:\{fluid:\{fluids:\"minecraft:water\",state:\{falling:\"false\"\}\}\}\}", "honey-smoke-logged-is"),
        ("", "honey-smoke-1"), ("", "honey-smoke-2"), ("", "honey-smoke-3"),
        ("", "honey-smoke-after"),
    ]
}

// `container-loot`'s steps (CAL-295): the bot opens a chest with a loot table and a seed, and
// a barrel with a table and none, which draws from the table's random sequence, closes each and
// reads what each holds, then opens the barrel again, which makes nothing more; opens a chest
// with a bastion's table, which gives `nether/loot_bastion`; then a chest with a table and a
// dispenser with one are destroyed, each making its loot to drop it.
fn container_loot_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "container-loot-survival"),
        ("setblock 2 -60 0 chest\{LootTable:\"minecraft:chests/simple_dungeon\",LootTableSeed:42L\}", "container-loot-seeded"),
        ("#use 2 -60 0", "container-loot-open-seeded"),
        ("#close", "container-loot-close-seeded"),
        ("data get block 2 -60 0", "container-loot-seeded-data"),
        ("setblock 0 -60 2 barrel\{LootTable:\"minecraft:chests/village/village_weaponsmith\"\}", "container-loot-barrel"),
        ("#use 0 -60 2", "container-loot-open-barrel"),
        ("#close", "container-loot-close-barrel"),
        ("data get block 0 -60 2", "container-loot-barrel-data"),
        ("#use 0 -60 2", "container-loot-open-barrel-again"),
        ("#close", "container-loot-close-barrel-again"),
        ("setblock 2 -60 2 chest\{LootTable:\"minecraft:chests/bastion_other\",LootTableSeed:5L\}", "container-loot-bastion"),
        ("#use 2 -60 2", "container-loot-open-bastion"),
        ("#close", "container-loot-close-bastion"),
        ("setblock -2 -60 0 chest\{LootTable:\"minecraft:chests/abandoned_mineshaft\",LootTableSeed:7L\}", "container-loot-to-break"),
        ("setblock -2 -60 0 air destroy", "container-loot-broken"),
        ("setblock 0 -60 -2 dispenser\{LootTable:\"minecraft:chests/simple_dungeon\"\}", "container-loot-dispenser"),
        ("setblock 0 -60 -2 air destroy", "container-loot-dispenser-broken"),
        ("", "container-loot-1"),
        ("", "container-loot-2"),
        ("", "container-loot-after"),
    ]
}

// `furnaces`' steps (CAL-336): a furnace with raw iron and coal, which a comparator beside
// reads, a blast furnace with raw gold and a lava bucket, a smoker with beef and oak planks, a
// furnace still lit with a wet sponge and a bucket, one partway through cooking with nothing
// in it, which cools, and one with dirt and coal, which nothing cooks; their data read as they
// cook and once they're done, then the iron's furnace and the blast furnace destroyed, which
// drops what's in them and the experience of what they cooked.
fn furnaces_steps() -> List<(str, str)> {
    return [
        ("setblock 0 -60 2 furnace\{Items:[\{Slot:0b,id:\"minecraft:raw_iron\",count:3\},\{Slot:1b,id:\"minecraft:coal\",count:1\}]\}", "furnaces-iron"),
        ("setblock 1 -60 2 comparator[facing=west]", "furnaces-comparator"),
        ("setblock 2 -60 2 blast_furnace\{Items:[\{Slot:0b,id:\"minecraft:raw_gold\",count:2\},\{Slot:1b,id:\"minecraft:lava_bucket\",count:1\}]\}", "furnaces-blast"),
        ("setblock -2 -60 2 smoker\{Items:[\{Slot:0b,id:\"minecraft:beef\",count:2\},\{Slot:1b,id:\"minecraft:oak_planks\",count:1\}]\}", "furnaces-smoker"),
        ("setblock 0 -60 -2 furnace\{lit_time_remaining:250,lit_total_time:300,Items:[\{Slot:0b,id:\"minecraft:wet_sponge\",count:1\},\{Slot:1b,id:\"minecraft:bucket\",count:1\}]\}", "furnaces-sponge"),
        ("setblock -2 -60 -2 furnace\{cooking_time_spent:50,cooking_total_time:200\}", "furnaces-cooling"),
        ("setblock 2 -60 -2 furnace\{Items:[\{Slot:0b,id:\"minecraft:dirt\",count:1\},\{Slot:1b,id:\"minecraft:coal\",count:1\}]\}", "furnaces-no-recipe"),
        ("data get block 0 -60 2", "furnaces-iron-started"),
        ("#wait 6", "furnaces-wait"),
        ("data get block 0 -60 2", "furnaces-iron-cooking"),
        ("data get block -2 -60 -2", "furnaces-cooled"),
        ("data get block 2 -60 -2", "furnaces-no-recipe-data"),
        ("#wait 8", "furnaces-wait-more"),
        ("data get block 0 -60 2", "furnaces-iron-done"),
        ("data get block 2 -60 2", "furnaces-blast-done"),
        ("data get block -2 -60 2", "furnaces-smoker-done"),
        ("data get block 0 -60 -2", "furnaces-sponge-done"),
        ("setblock 0 -60 2 air destroy", "furnaces-iron-broken"),
        ("setblock 2 -60 2 air destroy", "furnaces-blast-broken"),
        ("", "furnaces-1"),
        ("", "furnaces-2"),
        ("", "furnaces-after"),
    ]
}

// `furnace-menu`'s steps (CAL-336): the bot, in survival with raw iron, coal, a bucket and sticks
// in its hotbar, opens a furnace and shift-clicks the sticks, the iron and the coal in, the
// sticks and the coal to the fuel slot; once the iron's cooking it takes up the result and puts
// it down, takes up half the input and puts it back, tries the bucket on the result slot, waits,
// shift-clicks the result and the input out, and closes the menu; then the furnace's data's
// read.
fn furnace_menu_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "furnace-menu-survival"),
        ("item replace entity @s hotbar.0 with raw_iron 5", "furnace-menu-iron"),
        ("item replace entity @s hotbar.1 with coal 2", "furnace-menu-coal"),
        ("item replace entity @s hotbar.2 with bucket", "furnace-menu-bucket"),
        ("item replace entity @s hotbar.3 with stick 3", "furnace-menu-sticks"),
        ("setblock 0 -60 2 furnace", "furnace-menu-placed"),
        ("#use 0 -60 2", "furnace-menu-open"),
        ("#click 33 0 1", "furnace-menu-sticks-fuel"),
        ("#click 30 0 1", "furnace-menu-iron-in"),
        ("#click 31 0 1", "furnace-menu-coal-in"),
        ("#wait 12", "furnace-menu-cooking"),
        ("#click 2 0 0", "furnace-menu-result-up"),
        ("#click 35 0 0", "furnace-menu-result-down"),
        ("#click 0 1 0", "furnace-menu-half-input"),
        ("#click 0 0 0", "furnace-menu-input-back"),
        ("#click 32 0 0", "furnace-menu-bucket-up"),
        ("#click 2 0 0", "furnace-menu-bucket-refused"),
        ("#click 32 0 0", "furnace-menu-bucket-back"),
        ("#wait 10", "furnace-menu-more"),
        ("#click 2 0 1", "furnace-menu-result-shift"),
        ("#click 0 0 1", "furnace-menu-input-out"),
        ("#wait 2", "furnace-menu-cooling"),
        ("#close", "furnace-menu-closed"),
        ("data get block 0 -60 2", "furnace-menu-data"),
        ("", "furnace-menu-after"),
    ]
}

// `brewing`'s steps (CAL-337): the bot, in survival with three water bottles, nether wart and
// blaze powder, opens a brewing stand and shift-clicks the powder, the bottles and the wart in;
// once they're brewed, it takes up an awkward potion and puts it down, which gives it
// `nether/brew_potion`, shift-clicks another and the wart out and closes the menu. Then a stand
// set with an awkward potion, redstone and powder brews alone and is destroyed.
fn brewing_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "brewing-survival"),
        ("item replace entity @s hotbar.0 with potion[potion_contents=\{potion:\"minecraft:water\"\}]", "brewing-water-0"),
        ("item replace entity @s hotbar.1 with potion[potion_contents=\{potion:\"minecraft:water\"\}]", "brewing-water-1"),
        ("item replace entity @s hotbar.2 with potion[potion_contents=\{potion:\"minecraft:water\"\}]", "brewing-water-2"),
        ("item replace entity @s hotbar.3 with nether_wart 2", "brewing-wart"),
        ("item replace entity @s hotbar.4 with blaze_powder 2", "brewing-powder"),
        ("setblock 0 -60 2 brewing_stand", "brewing-placed"),
        ("#use 0 -60 2", "brewing-open"),
        ("#click 36 0 1", "brewing-fuel-in"),
        ("#click 32 0 1", "brewing-bottle-0"),
        ("#click 33 0 1", "brewing-bottle-1"),
        ("#click 34 0 1", "brewing-bottle-2"),
        ("#click 35 0 1", "brewing-wart-in"),
        ("#wait 11", "brewing-brew"),
        ("#wait 11", "brewing-brew-more"),
        ("#click 0 0 0", "brewing-awkward-up"),
        ("#click 32 0 0", "brewing-awkward-down"),
        ("#click 1 0 1", "brewing-awkward-shift"),
        ("#click 3 0 1", "brewing-wart-out"),
        ("#close", "brewing-closed"),
        ("data get block 0 -60 2", "brewing-data"),
        ("setblock 2 -60 2 brewing_stand\{Items:[\{Slot:0b,id:\"minecraft:potion\",count:1,components:\{\"minecraft:potion_contents\":\{potion:\"minecraft:awkward\"\}\}\},\{Slot:3b,id:\"minecraft:sugar\",count:1\},\{Slot:4b,id:\"minecraft:blaze_powder\",count:1\}]\}", "brewing-stand"),
        ("#wait 11", "brewing-stand-brew"),
        ("#wait 11", "brewing-stand-brew-more"),
        ("data get block 2 -60 2", "brewing-stand-data"),
        ("setblock 2 -60 2 air destroy", "brewing-stand-broken"),
        ("", "brewing-after"),
    ]
}

// `stonecutter`'s steps (CAL-338): a stonecutter's menu opened, `INTERACT_WITH_STONECUTTER`; stone
// shift-clicked in, a recipe picked, picked again, which takes nothing, and one there isn't; the
// result taken, put down, taken by a hotbar key and thrown; another picked and shift-clicked out,
// till the stone's used up; cobblestone in and all of it cut at once; dirt, which nothing cuts,
// shift-clicked into the inventory; a double click, which takes nothing from the result; the input
// shift-clicked back; then its input given back as it's closed, and the menu closed as the
// stonecutter's broken.
fn stonecutter_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "cut-survival"),
        ("item replace entity @s hotbar.0 with stone 6", "cut-stone"),
        ("item replace entity @s hotbar.1 with cobblestone 64", "cut-cobble"),
        ("item replace entity @s hotbar.2 with dirt 2", "cut-dirt"),
        ("setblock 0 -60 2 stonecutter", "cut-placed"),
        ("#use 0 -60 2", "cut-open"),
        ("#click 29 0 1", "cut-stone-in"),
        ("#button 0", "cut-pick"),
        ("#button 0", "cut-pick-again"),
        ("#button 99", "cut-pick-none"),
        ("#button 1", "cut-pick-other"),
        ("#click 1 0 0", "cut-take"),
        ("#click 2 0 0", "cut-put"),
        ("#click 1 1 0", "cut-take-half"),
        ("#click 3 0 0", "cut-put-again"),
        ("#click 1 4 2", "cut-swap"),
        ("#click 1 0 4", "cut-throw"),
        ("#button 2", "cut-pick-third"),
        ("#click 1 0 1", "cut-shift"),
        ("#click 30 0 1", "cut-cobble-in"),
        ("#button 0", "cut-pick-cobble"),
        ("#click 1 0 1", "cut-shift-cobble"),
        ("#click 31 0 1", "cut-dirt-moved"),
        ("item replace entity @s hotbar.5 with stone 4", "cut-more-stone"),
        ("#click 34 0 1", "cut-more-in"),
        ("#button 3", "cut-pick-fourth"),
        ("#click 1 0 0", "cut-take-carried"),
        ("#click 20 0 6", "cut-double"),
        ("#click 4 0 0", "cut-put-down"),
        ("#click 0 0 1", "cut-input-out"),
        ("item replace entity @s hotbar.5 with stone 3", "cut-stone-again"),
        ("#click 34 0 1", "cut-input-back"),
        ("#close", "cut-closed"),
        ("#use 0 -60 2", "cut-reopen"),
        ("item replace entity @s hotbar.5 with stone 2", "cut-stone-last"),
        ("#click 34 0 1", "cut-in-again"),
        ("#button 0", "cut-pick-last"),
        ("setblock 0 -60 2 air", "cut-broken"),
        ("", "cut-after"),
    ]
}

// `grindstone`'s steps (CAL-338): a grindstone's menu opened, `INTERACT_WITH_GRINDSTONE`; two
// damaged, enchanted iron swords shift-clicked in, mended into one with their curses kept and the
// rest taken off, which is taken, giving experience; an enchanted book shift-clicked in alone,
// made a book, and shifted out; a pickaxe and dirt, which it doesn't take, shift-clicked; two
// stacks of a pickaxe, which make nothing; then the inputs given back as it's closed.
fn grindstone_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "grind-survival"),
        ("item replace entity @s hotbar.0 with iron_sword[enchantments=\{sharpness:3,vanishing_curse:1\},damage=100]", "grind-sword-0"),
        ("item replace entity @s hotbar.1 with iron_sword[enchantments=\{unbreaking:2,binding_curse:1,sharpness:4\},damage=200]", "grind-sword-1"),
        ("item replace entity @s hotbar.2 with enchanted_book[stored_enchantments=\{mending:1\}]", "grind-book"),
        ("item replace entity @s hotbar.3 with diamond_pickaxe[enchantments=\{efficiency:5,fortune:3\},repair_cost=3]", "grind-pickaxe"),
        ("item replace entity @s hotbar.4 with dirt 3", "grind-dirt"),
        ("item replace entity @s hotbar.5 with golden_hoe", "grind-hoe"),
        ("setblock 0 -60 2 grindstone[face=floor]", "grind-placed"),
        ("#use 0 -60 2", "grind-open"),
        ("#click 30 0 1", "grind-sword-in"),
        ("#click 31 0 1", "grind-other-in"),
        ("#click 2 0 0", "grind-take"),
        ("#click 3 0 0", "grind-put"),
        ("#wait 2", "grind-orbs"),
        ("#click 32 0 1", "grind-book-in"),
        ("#click 2 0 1", "grind-book-out"),
        ("#click 33 0 1", "grind-pickaxe-in"),
        ("#click 34 0 1", "grind-dirt-moved"),
        ("#click 35 0 1", "grind-hoe-in"),
        ("#click 2 0 0", "grind-unmatched"),
        ("#click 1 0 1", "grind-hoe-out"),
        ("#click 0 1 0", "grind-pickaxe-up"),
        ("#click 0 0 0", "grind-pickaxe-down"),
        ("#close", "grind-closed"),
        ("#use 0 -60 2", "grind-reopen"),
        ("item replace entity @s hotbar.6 with diamond_pickaxe[enchantments=\{efficiency:5\}]", "grind-pickaxe-again"),
        ("#click 36 0 1", "grind-pickaxe-again-in"),
        ("#click 2 0 0", "grind-ground-up"),
        ("#click 10 0 0", "grind-ground-down"),
        ("#close", "grind-closed-again"),
        ("", "grind-after"),
    ]
}

// `enchanting`'s steps (CAL-338): an enchanting table's menu opened in a ring of bookshelves, which
// counts no statistic; an iron sword and lapis shift-clicked in, which shows its offers, the third
// taken, using three lapis and levels and the seed; the sword shifted out; one of three books
// shift-clicked in and enchanted by the first; dirt and an enchanted pickaxe, which have no offers,
// pressed for nothing; a golden hoe with too few levels, then enough; a button there isn't; the
// lapis and hoe given back as it's closed; most bookshelves taken away and one cut off by a torch,
// a sword put in by hand with the books carried, the second taken; then the menu closed as the
// table's broken.
fn enchanting_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "ench-survival"),
        ("xp set @s 30 levels", "ench-levels"),
        ("item replace entity @s hotbar.0 with iron_sword", "ench-sword"),
        ("item replace entity @s hotbar.1 with lapis_lazuli 10", "ench-lapis"),
