        ("kill", "bed-kill"),
        ("", "bed-respawns"),
        ("", "bed-respawned"),
        ("spawnpoint", "spawnpoint-here"),
        ("spawnpoint @a 3 -60 3 90 10", "spawnpoint-all"),
        ("spawnpoint Bot 0 -60 30000000", "spawnpoint-out"),
        ("spawnpoint Nobody", "spawnpoint-nobody"),
        ("spawnpoint Bot 3 -60 3 ~5 ~", "spawnpoint-turned"),
        ("kill", "spawnpoint-kill"),
