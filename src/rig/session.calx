        ("time set 18000", "convert-midnight"),
        ("summon villager ~ ~ ~4 \{NoAI:1b,VillagerData:\{profession:\"minecraft:farmer\",level:1,type:\"minecraft:plains\"\}\}", "convert-farmer"),
        ("summon villager ~2 ~ ~7 \{NoAI:1b\}", "convert-villager"),
