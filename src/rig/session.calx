// 25, heard repaired at a pitch drawn, `IronGolem.mobInteract`, the third, at full health, not
// taken; then it hits the second, whose cracks change, heard, `IronGolem.hurtServer`. It watches
// for 3 seconds.
fn golem_repair_steps() -> List<(str, str)> {
    return [
