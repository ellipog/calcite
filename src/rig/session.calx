        ("fill 30 -61 30 33 -57 30 obsidian", "portal-frame"),
        ("fill 31 -60 30 32 -58 30 air", "portal-hollow"),
        ("setblock 31 -60 30 fire", "portal-light"),
        ("tp @s 31.5 -60 30.5", "portal-in"),
        ("", "portal-waiting-1"),
        ("", "portal-waiting-2"),
        ("", "portal-waiting-3"),
        ("", "portal-waiting-4"),
        ("", "portal-nether"),
        ("tp @s ~ ~ ~1", "nether-out"),
        // Entities through nether portals (D578): with the bot in the Nether by the portal it came
