}

// `salmon`'s steps (CAL-201), where `cod`'s are, by day, on normal: the bot, in survival mode,
// digs `cod`'s pool and a small one just east of it, and summons seven salmon in the first, each
// of a size drawn, small, medium or large, `Salmon.finalizeSpawn`, which school five at most,
// `getMaxSchoolSize`; a large one without AI in the second, its size loaded, `type`; and a small
// one on land, which flops, heard as a salmon, till it drowns. It takes the large one in a water
// bucket, a bucket of salmon of its size, `SALMON_SIZE`, and watches for 30 seconds.
fn salmon_steps() -> List<(str, str)> {
    return [
        ("time set day", "salmon-day"),
        ("gamemode survival", "salmon-survival"),
        ("fill 2 -63 2 12 -61 12 water", "salmon-pool"),
        ("fill 1 -62 -1 3 -61 1 water", "salmon-small-pool"),
        ("#all summon salmon 5.5 -62 5.5;summon salmon 6.5 -62 5.5;summon salmon 7.5 -62 6.5;summon salmon 8.5 -62 8.5;summon salmon 9.5 -62 9.5;summon salmon 10.5 -62 10.5;summon salmon 6.5 -62 10.5", "salmon-fish"),
        ("summon salmon 2.5 -62 0.5 \{NoAI:1b,type:\"large\"\}", "salmon-large"),
        ("summon salmon -9.5 -60 -9.5 \{type:\"small\"\}", "salmon-land"),
        ("item replace entity @s weapon.mainhand with water_bucket", "salmon-bucket"),
        ("#use-mob 7", "salmon-caught"),
        ("", "salmon-1"), ("", "salmon-2"), ("", "salmon-3"), ("", "salmon-4"), ("", "salmon-5"),
        ("", "salmon-6"), ("", "salmon-7"), ("", "salmon-8"), ("", "salmon-9"), ("", "salmon-10"),
        ("", "salmon-11"), ("", "salmon-12"), ("", "salmon-13"), ("", "salmon-14"), ("", "salmon-15"),
        ("", "salmon-16"), ("", "salmon-17"), ("", "salmon-18"), ("", "salmon-19"), ("", "salmon-20"),
        ("", "salmon-21"), ("", "salmon-22"), ("", "salmon-23"), ("", "salmon-24"), ("", "salmon-25"),
        ("", "salmon-26"), ("", "salmon-27"), ("", "salmon-28"), ("", "salmon-29"), ("", "salmon-30"),
        ("", "salmon-after"),
    ]
}

// `tropical-fish`'s steps (CAL-201), where `salmon`'s are: the bot, in survival mode, digs `cod`'s
// pool and a small one just east of it, and summons six tropical fish in the first, each of a
// variant drawn from the level's random, nine in ten a common one, `TropicalFish.finalizeSpawn`,
// which school; one without AI in the second whose saved variant names no pattern, read as a kob,
// white on white, `ByIdMap.sparse`; and one on land, which flops till it drowns. It takes the one
