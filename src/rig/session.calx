// `barter`'s steps (CAL-200), where `piglins`' are: the bot, in survival mode, with resistance V,
// wearing a golden helmet so no piglin takes it up, `isWearingSafeArmor`, holds three gold
// ingots in its main hand, which piglins see, jealous, then summons in one tick two piglins immune to
// zombification, from their data, one beside it and one south-east, and a gold ingot on the
// ground beyond the second. It gives the first an ingot, `PiglinAi.mobInteract`, which holds it in
// its off hand and admires it; the second sees the one on the ground, `StartAdmiringItemIfSeen`,
// walks to it, `GoToWantedItem`, picks it up, `PiglinAi.pickUpItem`, and admires it. After 119
// ticks each barters, `stopHoldingOffHandItem`: `gameplay/piglin_bartering` rolled and thrown
// toward the bot, which picks up what reaches it. It watches for 24 seconds.
fn barter_steps() -> List<(str, str)> {
    return [
        ("time set day", "barter-day"),
        ("gamemode survival", "barter-survival"),
        ("effect clear @s", "barter-clear"),
        ("effect give @s resistance 600 4 true", "barter-armor"),
        ("item replace entity @s armor.head with minecraft:golden_helmet", "barter-helmet"),
        ("item replace entity @s weapon.mainhand with minecraft:gold_ingot 3", "barter-gold"),
        ("#all summon piglin -1.5 -60 0.5 \{IsImmuneToZombification:1b\};summon piglin 4.5 -60 4.5 \{IsImmuneToZombification:1b\};summon item 7.5 -60 6.5 \{Item:\{id:\"minecraft:gold_ingot\",count:1\}\}", "barter-summon"),
        ("#use-mob 0", "barter-give"),
        ("", "barter-1"), ("", "barter-2"), ("", "barter-3"), ("", "barter-4"), ("", "barter-5"),
        ("", "barter-6"), ("", "barter-7"), ("", "barter-8"), ("", "barter-9"), ("", "barter-10"),
        ("", "barter-11"), ("", "barter-12"), ("", "barter-13"), ("", "barter-14"), ("", "barter-15"),
