        ("tp @s -2.5 98 -13.5", "pearl-nether-tp"),
        ("#pearl-south", "pearl-back"),
        ("", "pearl-overworld"),
        // A pig with no AI summoned south of where the first pearls were thrown, and a pearl thrown
        // at it from there, a little down, which hurts it by none, so it's hurt all the same,
        // knocked back and heard, then takes the bot to where it was (D581).
        ("summon pig 40.5 -60 43.5 \{NoAI:1b\}", "pearl-pig"),
        ("tp @s 40.5 -60 40.5", "pearl-pig-tp"),
        ("#pearl-pig", "pearl-pig-hit"),
        // Endermites (D583), the bot still in creative, which they don't take up: one with its AI
        // by the pig, 150 ticks from the end of its life, which strolls and looks about until it
        // comes to it, gone; and one without, a few ticks from the end of its own, gone at once.
        // Calcite can't select entities that aren't players yet, so they aren't killed.
        ("summon endermite 44.5 -60 44.5 \{Lifetime:2250\}", "mite"),
        ("summon endermite 36.5 -60 44.5 \{NoAI:1b,Lifetime:2395\}", "mite-old"),
        ("", "mite-walks"),
        ("", "mite-gone"),
        // Ender pearls owned by what isn't a player (D585): a pig with no AI, turned, and a stone
        // that isn't picked up, each of its own UUID, then a pearl of each summoned falling onto
        // the ground north of it, which takes it to where it was the tick before it landed, at its
        // own turn, still, heard there, those that see the stone told at once.
        ("summon pig 46.5 -60 40.5 \{NoAI:1b,Rotation:[90f,10f],UUID:[I;5,8,5,1]\}", "owned-pig"),
        ("summon item 48.5 -60 40.5 \{Item:\{id:stone,count:1\},PickupDelay:1000,UUID:[I;5,8,5,2]\}", "owned-item"),
        ("summon ender_pearl 46.5 -58 37.5 \{Owner:[I;5,8,5,1],Motion:[0.0,-0.5,0.0]\}", "owned-pig-pearl"),
        ("summon ender_pearl 48.5 -58 37.5 \{Owner:[I;5,8,5,2],Motion:[0.0,-0.5,0.0]\}", "owned-item-pearl"),
        ("", "owned-landed"),
        ("", "owned-after"),
        ("gamemode survival", "pearl-survival"),
        ("tp @s 18.5 -60 20.5", "bed-near-creeper"),
        ("summon creeper 23 -60 22 \{NoAI:1b\}", "bed-creeper"),
        ("#use-bed", "bed-use-creeper"),
        // An ender pearl thrown straight up, still flying as the bot leaves, so saved with it and
        // taken out of the level with it (D580).
        ("#pearl-up", "pearl-up"),
        ("", "fn-after"),
    ]
}

// `end`'s steps (D586): the bot, an operator, on the end fixture's grass, taken into the end portal
// there, which takes it into the End, onto the platform made for it; then an end portal set in
// the platform's floor east of it and the bot taken into that, which, as it hasn't seen them,
// shows it the credits, after which it respawns at the world's spawn keeping all it has; then its
// spawn set by it, and again into the End, the platform made again over the portal, which is set
// again, and out through it, which takes it to where its spawn's set, as it's seen them.
// What isn't a player goes through the end portals too (D587): first, with the bot by the
// Overworld's, whose chunks tick only while it's there, summoned in it, a stone, two stone, which
// merge with it where they come out, an orb, which comes to the bot once it's there, a splash
// potion and an arrow, falling, and an armor stand, turned, which comes out facing west, none of
// them pushing the bot as it comes out among them; then, before it goes out of the End again,
// with the bot aside on the platform, summoned in the platform's portal, a pig with no AI,
// turned, an armor stand and a stone, which come out onto the world's spawn, turned by its yaw
// and pitch.
fn end_steps() -> List<(str, str)> {
    return [
        ("summon item 4.5 -60.5 0.5 \{Item:\{id:stone,count:1\},PickupDelay:1000\}", "end-item"),
        ("summon item 4.5 -60.5 0.5 \{Item:\{id:stone,count:2\},PickupDelay:1000\}", "end-merge"),
        ("summon experience_orb 4.5 -60.5 0.5 \{Value:3\}", "end-orb"),
        ("summon splash_potion 4.5 -58 0.5", "end-potion"),
        ("summon arrow 4.5 -58 0.5", "end-arrow"),
        ("summon armor_stand 4.5 -61 0.5 \{Rotation:[30f,20f]\}", "end-stand"),
        ("", "end-entities-in"),
        ("tp @s 4.5 -60.5 0.5", "end-in"),
        ("", "end-arrived"),
        ("setblock 102 48 0 minecraft:end_portal", "end-exit"),
        ("tp @s 102.5 48.5 0.5", "end-credits"),
        ("", "end-respawned"),
        ("spawnpoint @s 8 -60 8", "end-spawnpoint"),
        ("tp @s 4.5 -60.5 0.5", "end-again"),
        ("", "end-again-arrived"),
        ("setblock 102 48 0 minecraft:end_portal", "end-exit-again"),
        ("tp @s 98.5 49 -1.5", "end-aside"),
        ("summon pig 102.5 48.3 0.5 \{NoAI:1b,Rotation:[30f,20f]\}", "end-out-pig"),
        ("summon armor_stand 102.5 48.3 0.5", "end-out-stand"),
        ("summon item 102.5 48.5 0.5 \{Item:\{id:stone,count:1\},PickupDelay:1000\}", "end-out-item"),
        ("", "end-entities-out"),
        ("tp @s 102.5 48.5 0.5", "end-out"),
        ("", "end-out-arrived"),
    ]
}

// `crystals`' steps (D590): the bot, an operator, in survival mode at the end fixture's spawn
// holding stone, sets water in the grass two blocks west and summons an end crystal in it,
// invulnerable and showing no bottom, then hits it, which doesn't hurt it; then in creative mode,
// an iron sword in its hand, it hits it again, which breaks it, as a player in creative mode
// breaks what's invulnerable, sweeping, as it's on the ground and still. The crystal then
// explodes (CAL-182); the water about the explosion keeps its blocks, and creative mode keeps the
// bot from being hurt, though it's pushed. Then a crystal summoned there again each time (D591):
// an arrow falling onto it, which breaks it; an ender pearl falling onto it, which does too, its
// owner none, so it takes nobody anywhere; and a splash potion falling onto it, which splashes
// there, its contents none, so the crystal stays. Then one summoned on the grass south-east, out
// of the water, and an arrow falling onto it (CAL-182): its explosion breaks the grass and dirt
// about it down to the bedrock, their drops decaying and merged, pushes the bot, and lets the
// water out. Last, in survival mode again, holding two end crystals, it uses one on obsidian it
// sets four blocks north (CAL-167), which puts a crystal on it showing no bottom and uses one up;
// then the other on it again, which fails, the first in the way; then on the grass, which fails.
fn crystal_steps() -> List<(str, str)> {
    return [
        ("setblock -2 -61 0 minecraft:water", "crystal-water"),
        ("summon end_crystal -1.5 -61 0.5 \{Invulnerable:1b,ShowBottom:0b\}", "crystal-summoned"),
        ("#hit-crystal", "crystal-hit"),
        ("gamemode creative", "crystal-creative"),
        ("item replace entity @s weapon.mainhand with minecraft:iron_sword", "crystal-sword"),
        ("#hit-crystal", "crystal-broken"),
        ("summon end_crystal -1.5 -61 0.5", "crystal-again"),
        ("summon arrow -1.5 -57.5 0.5 \{Motion:[0.0,-1.0,0.0]\}", "crystal-shot"),
        ("summon end_crystal -1.5 -61 0.5", "crystal-third"),
        ("summon ender_pearl -1.5 -57.5 0.5 \{Motion:[0.0,-1.0,0.0]\}", "crystal-pearled"),
        ("summon end_crystal -1.5 -61 0.5", "crystal-fourth"),
        ("summon splash_potion -1.5 -57.5 0.5 \{Motion:[0.0,-1.0,0.0]\}", "crystal-splashed"),
        ("summon end_crystal 4.5 -60 4.5", "crystal-dry"),
        ("summon arrow 4.5 -56.5 4.5 \{Motion:[0.0,-1.0,0.0]\}", "crystal-blown"),
        ("", "crystal-after"),
        ("gamemode survival", "crystal-survival"),
        ("item replace entity @s weapon.mainhand with minecraft:end_crystal 2", "crystal-item"),
        ("setblock 0 -61 -4 minecraft:obsidian", "crystal-obsidian"),
        ("#use 0 -61 -4", "crystal-placed"),
        ("#use 0 -61 -4", "crystal-in-the-way"),
        ("#use 1 -61 -3", "crystal-on-grass"),
    ]
}

// `tnt`'s steps (CAL-182): the bot, an operator, in survival mode at the end fixture's spawn, sets
// TNT on the grass 12 blocks east, out of its explosions' reach, and a redstone block beside it,
// which primes it, `neighborChanged`; it falls back, and 80 ticks on it explodes, breaking the
// grass about it, whose drops don't decay, and the redstone block. Then two TNT two blocks apart
// to the south, the west one primed by a redstone block, whose explosion primes the other on a
// short fuse, `wasExploded`, drawn from the level's random. Then TNT summoned to the north with a
// fuse of 30, which goes off sooner. Then TNT further north and a burning arrow falling onto it,
// which primes it, owned by nobody, `onProjectileHit`.
fn tnt_steps() -> List<(str, str)> {
    return [
        ("setblock 12 -60 0 minecraft:tnt", "tnt-set"),
        ("setblock 12 -60 1 minecraft:redstone_block", "tnt-powered"),
        ("", "tnt-fuse"),
        ("", "tnt-fuse-2"),
        ("", "tnt-fuse-3"),
        ("", "tnt-blown"),
        ("setblock 12 -60 8 minecraft:tnt", "tnt-pair"),
        ("setblock 14 -60 8 minecraft:tnt", "tnt-pair-2"),
        ("setblock 12 -60 9 minecraft:redstone_block", "tnt-chain"),
        ("", "tnt-chain-fuse"),
        ("", "tnt-chain-fuse-2"),
        ("", "tnt-chain-fuse-3"),
        ("", "tnt-chain-blown"),
        ("", "tnt-chain-short"),
        ("", "tnt-chain-after"),
        ("summon tnt 12.5 -60 -7.5 \{fuse:30s\}", "tnt-summoned"),
        ("", "tnt-summoned-fuse"),
        ("", "tnt-summoned-blown"),
        ("setblock 12 -60 -16 minecraft:tnt", "tnt-target"),
        ("summon arrow 12.5 -56.5 -15.5 \{Motion:[0.0,-1.0,0.0],Fire:100s\}", "tnt-shot"),
        ("", "tnt-shot-fuse"),
        ("", "tnt-shot-fuse-2"),
        ("", "tnt-shot-fuse-3"),
        ("", "tnt-shot-blown"),
        ("", "tnt-after"),
    ]
}

// `blasts`' steps (CAL-182): the bot, an operator, in creative mode, so explosions push it but
// don't hurt it, stays at the end fixture's spawn. It sets a respawn anchor on the grass to the
// south-west, away from the fixture's end portal, and uses it with nothing in its hand, which
// does nothing without a charge; then with glowstone, which charges it twice and isn't spent;
// then with a stick, which, not glowstone, tries the empty hand, which explodes it, as an anchor
// doesn't work in the overworld, breaking the grass and dirt about it, dropping some of them, and
// setting fires, which burn out. Then it sets water to the north-west and an anchor with a charge
// beside it, and uses it, which explodes it but breaks nothing, as it's in water. Then it summons
// creepers without AI, ignited, their fuses a tick, so each explodes as it first ticks (D661): one
// to the south-east, of a radius of 3; one to the south-west with speed, which leaves a lingering
// cloud, its explosion reaching some of what the anchor dropped; and one to the north-east,
// powered, so of a radius of 6, and silent, so its explosion isn't heard. Then it throws wind
// charges (CAL-182): straight down, which bursts on the ground under it, pushing it, after which
// it hops 8 up and falls back, its fall after the burst giving it `who_needs_rockets` (D666);
// at a pig without AI to the north, hurting it, then bursting; and at stone it sets to the
// south-east, bursting out of its face; and it summons one without an owner falling to the
// north, which, summoned, speeds up, as one read without its acceleration has 0.1, and bursts
// on the ground.
// Then it sets an oak door, a fence gate, a lever, a bell, a trapdoor, a stone button and a lit
// candle about a spot nine blocks south, and throws a wind charge to the ground there, whose
// burst swings, pulls, rings, presses and puts them out, the button letting go after (D663).
// Then it summons, each at no health, so it's taken out 20 ticks on, zombies without AI to the
// east with an effect that does something then (D665): wind charged, which bursts; weaving, which
// sets cobwebs on the grass about it; and oozing, which leaves two slimes; and a creeper to the
// west, ignited, with wind charged, which bursts after its explosion. One of each, as vanilla's
// order for two isn't the same from run to run. Last it takes the button away, after the
// anchor's last fire, beside it, has gone and the tick it set itself before it went has come:
// vanilla saves a chunk early by the wall clock, `saveChunksEagerly`, and running a tick doesn't
// mark it to be saved again, so a save between would keep the spent tick; the change has the
// chunk saved again at the end.
fn blast_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "blast-creative"),
        ("setblock -4 -60 3 minecraft:respawn_anchor", "anchor-set"),
        ("#use -4 -60 3", "anchor-unused"),
        ("item replace entity @s weapon.mainhand with minecraft:glowstone", "anchor-glowstone"),
        ("#use -4 -60 3", "anchor-charged"),
        ("#use -4 -60 3", "anchor-charged-twice"),
        ("item replace entity @s weapon.mainhand with minecraft:stick", "anchor-stick"),
        ("#use -4 -60 3", "anchor-blown"),
        ("", "anchor-burning"),
        ("", "anchor-burning-2"),
        ("", "anchor-burning-3"),
        ("setblock -3 -60 -3 minecraft:water", "anchor-water"),
        ("setblock -2 -60 -3 minecraft:respawn_anchor[charges=1]", "anchor-wet-set"),
        ("#use -2 -60 -3", "anchor-wet-blown"),
        ("", "anchor-after"),
        ("summon minecraft:creeper 10.5 -60 10.5 \{ignited:1b,NoAI:1b,Fuse:1s\}", "creeper-summoned"),
        ("", "creeper-blown"),
        ("summon minecraft:creeper -10.5 -60 10.5 \{ignited:1b,NoAI:1b,Fuse:1s,active_effects:[\{id:\"minecraft:speed\",duration:600\}]\}", "creeper-cloud-summoned"),
        ("", "creeper-cloud-blown"),
        ("", "creeper-cloud-after"),
        ("summon minecraft:creeper 10.5 -60 -10.5 \{ignited:1b,NoAI:1b,Fuse:1s,powered:1b,Silent:1b\}", "creeper-powered-summoned"),
        ("", "creeper-powered-blown"),
        ("", "creeper-after"),
        ("item replace entity @s weapon.mainhand with minecraft:wind_charge 4", "wind-held"),
        ("#throw 0 90", "wind-down"),
        ("", "wind-down-after"),
        ("#hop 0.5 -60 0.5 8", "wind-hop"),
        ("", "wind-hop-after"),
        ("summon minecraft:pig 0.5 -60 -6.5 \{NoAI:1b\}", "wind-pig-summoned"),
        ("#throw 180 9.5", "wind-pig"),
        ("", "wind-pig-after"),
        ("setblock 6 -59 6 minecraft:stone", "wind-stone"),
        ("#throw -45 0", "wind-stone-hit"),
        ("", "wind-stone-after"),
        ("summon minecraft:wind_charge 0.5 -56 -3.5 \{Motion:[0.0,-0.5,0.0]\}", "wind-summoned"),
        ("", "wind-summoned-after"),
        ("setblock 1 -60 9 minecraft:oak_door[half=lower]", "trigger-door"),
        ("setblock 1 -59 9 minecraft:oak_door[half=upper]", "trigger-door-upper"),
        ("setblock 1 -60 10 minecraft:oak_fence_gate", "trigger-gate"),
        ("setblock -1 -60 9 minecraft:lever[face=floor]", "trigger-lever"),
        ("setblock -1 -60 10 minecraft:bell[attachment=floor]", "trigger-bell"),
        ("setblock 0 -60 11 minecraft:oak_trapdoor", "trigger-trapdoor"),
        ("setblock -1 -60 8 minecraft:stone_button[face=floor]", "trigger-button"),
        ("setblock 1 -60 8 minecraft:candle[lit=true]", "trigger-candle"),
        ("#throw 0 10.2", "trigger-thrown"),
        ("", "trigger-burst"),
        ("", "trigger-after"),
        ("", "trigger-settled"),
        ("", "trigger-settled-2"),
        ("summon minecraft:zombie 14.5 -60 0.5 \{NoAI:1b,Health:0.0f,active_effects:[\{id:\"minecraft:wind_charged\",duration:600\}]\}", "removal-wind"),
        ("", "removal-wind-gone"),
        ("summon minecraft:zombie 14.5 -60 8.5 \{NoAI:1b,Health:0.0f,active_effects:[\{id:\"minecraft:weaving\",duration:600\}]\}", "removal-weave"),
        ("", "removal-weave-gone"),
        ("summon minecraft:zombie 14.5 -60 -8.5 \{NoAI:1b,Health:0.0f,active_effects:[\{id:\"minecraft:oozing\",duration:600\}]\}", "removal-ooze"),
        ("", "removal-ooze-gone"),
        ("summon minecraft:creeper -14.5 -60 0.5 \{ignited:1b,NoAI:1b,Fuse:1s,active_effects:[\{id:\"minecraft:wind_charged\",duration:600\}]\}", "removal-creeper"),
        ("", "removal-creeper-gone"),
        ("setblock -1 -60 8 minecraft:air", "trigger-cleared"),
    ]
}

// `gateways`' steps (D592): the bot, an operator, at the end fixture's spawn, sets an end gateway
// two blocks south-east of it, a block over the grass, 2380 ticks old, and reads its age as it
// ticks; at 2400 its cooldown begins, its block event sent, and its age is read again after; then
// it takes it away, as what vanilla saves of its age is as its chunk was saved early, by the wall
// clock, `saveChunksEagerly`. Then it goes through gateways set in the grass north-east (D593),
// each time put by it and left a step first, so the chunks about it are all sent, as vanilla's
// load slower and a gateway takes it on before they are: one with its exit exact at 20, -60, 20,
// which takes it there; one with its exit at 30, -61, 30, not exact, which takes it above the
// tallest block about it, the first column's grass, 25, -61, 25; and one with another gateway on
// it, whose block event is sent twice, as vanilla keeps one gone into's where the walk's cursor
// ends; each taken away after. Then, by one, it summons an item, a pig without its AI and an
// arrow into it, which take each to its exit (D594). Then it goes into the End, and on its
// platform sets gateways with no exit, which make themselves one, an island first where they
// find nothing to stand on, out past where the islands begin (D595): an item summoned into one
// and then the bot into another, each taken to the exit made.
fn gateway_steps() -> List<(str, str)> {
    return [
        ("setblock 2 -59 2 minecraft:end_gateway\{Age:2380L\}", "gateway-set"),
        ("data get block 2 -59 2", "gateway-age"),
        ("", "gateway-cooled"),
        ("data get block 2 -59 2", "gateway-age-again"),
        ("setblock 2 -59 2 minecraft:air", "gateway-gone"),
        ("setblock 6 -60 -6 minecraft:end_gateway\{exit_portal:[I;20,-60,20],ExactTeleport:1b\}", "gateway-exact-set"),
        ("tp @s 6.5 -60 -3.5", "gateway-exact-near"),
        ("", "gateway-exact-wait"),
        ("tp @s 6.5 -60 -5.5", "gateway-exact-in"),
        ("", "gateway-exact-out"),
        ("setblock 6 -60 -6 minecraft:end_gateway\{exit_portal:[I;30,-61,30]\}", "gateway-found-set"),
        ("tp @s 6.5 -60 -3.5", "gateway-found-near"),
        ("", "gateway-found-wait"),
        ("tp @s 6.5 -60 -5.5", "gateway-found-in"),
        ("", "gateway-found-out"),
        ("setblock 6 -60 -6 minecraft:air", "gateway-gone-again"),
        ("setblock 6 -60 -6 minecraft:end_gateway\{exit_portal:[I;20,-60,20],ExactTeleport:1b\}", "gateway-stacked-set"),
        ("setblock 6 -59 -6 minecraft:end_gateway", "gateway-stacked-above"),
        ("tp @s 6.5 -60 -3.5", "gateway-stacked-near"),
        ("", "gateway-stacked-wait"),
        ("tp @s 6.5 -60 -5.5", "gateway-stacked-in"),
        ("", "gateway-stacked-out"),
        ("setblock 6 -59 -6 minecraft:air", "gateway-stacked-gone"),
        ("setblock 6 -60 -6 minecraft:air", "gateway-stacked-gone-below"),
        ("setblock 6 -60 -6 minecraft:end_gateway\{exit_portal:[I;20,-60,20],ExactTeleport:1b\}", "gateway-things-set"),
        ("tp @s 6.5 -60 -3.5", "gateway-things-near"),
        ("", "gateway-things-wait"),
        ("summon minecraft:item 6.5 -59.5 -5.5 \{Item:\{id:\"minecraft:stone\",count:1\},PickupDelay:32767\}", "gateway-item"),
        ("", "gateway-item-out"),
        ("summon minecraft:pig 6.5 -59.9 -5.5 \{NoAI:1b\}", "gateway-pig"),
        ("", "gateway-pig-out"),
        ("summon minecraft:arrow 6.5 -59.5 -4.4 \{Motion:[0.0d,0.0d,-0.5d]\}", "gateway-arrow"),
        ("", "gateway-arrow-out"),
        ("setblock 6 -60 -6 minecraft:air", "gateway-things-gone"),
        ("tp @s 4.5 -60.5 0.5", "gateway-end-in"),
        ("", "gateway-end-arrived"),
        ("", "gateway-end-wait"),
        ("setblock 102 49 -2 minecraft:end_gateway", "gateway-none-item-set"),
        ("summon minecraft:item 102.5 49.5 -1.5 \{Item:\{id:\"minecraft:stone\",count:1\},PickupDelay:32767\}", "gateway-none-item"),
        ("", "gateway-none-item-out"),
        ("setblock 100 49 2 minecraft:end_gateway", "gateway-none-set"),
        ("tp @s 100.5 49 2.5", "gateway-none-in"),
        ("", "gateway-none-out"),
        ("", "gateway-none-after"),
    ]
}

// `eyes`' steps (D596): the bot, an operator, in survival mode at the end fixture's spawn, sets
// the frames of an end portal's ring in the grass west of it, a 3 by 3 inside, each with its eye
// and facing in, but the east side's southmost, which has none; a comparator east of that one,
// reading it; glass inside; and an item on the empty frame. Holding two eyes of ender, it uses
// one on that frame, which pushes the item up onto the eye, fills it, turns the comparator on and
// opens the portal, the glass broken; then uses the other on it, full now, which does nothing.
// Then it sets the frame again without its eye, the comparator going off and the item falling
// back, and fills it with the last eye, which opens the portal again over the portal there. Given
// another, it uses it looking at the frame, which does nothing, then looking up, which starts its
// use, as the world has no structures for it to find, till it lets go (D597). Then it summons an
// eye of ender rising to the east and a silent one of three diamonds drifting north, which fly on
// as they're moving till their life runs out, 81 ticks on, each heard and its event sent but the
// silent one, unheard (D598).
fn eye_steps() -> List<(str, str)> {
    return [
        ("fill -4 -60 -2 -2 -60 -2 minecraft:end_portal_frame[facing=south,eye=true]", "eyes-north"),
        ("fill -4 -60 2 -2 -60 2 minecraft:end_portal_frame[facing=north,eye=true]", "eyes-south"),
        ("fill -5 -60 -1 -5 -60 1 minecraft:end_portal_frame[facing=east,eye=true]", "eyes-west"),
        ("fill -1 -60 -1 -1 -60 0 minecraft:end_portal_frame[facing=west,eye=true]", "eyes-east"),
        ("setblock -1 -60 1 minecraft:end_portal_frame[facing=west]", "eyes-empty"),
        ("setblock 0 -60 1 minecraft:comparator[facing=west]", "eyes-comparator"),
        ("setblock -9 -60 0 minecraft:glass", "eyes-glass"),
        ("summon minecraft:item -0.5 -59.1875 1.5 \{Item:\{id:\"minecraft:stone\",count:1\},PickupDelay:32767\}", "eyes-item"),
        ("item replace entity @s weapon.mainhand with minecraft:ender_eye 2", "eyes-held"),
        ("#use-frame", "eyes-filled"),
        ("", "eyes-open"),
        ("#use-frame", "eyes-again"),
        ("setblock -1 -60 1 minecraft:end_portal_frame[facing=west]", "eyes-taken"),
        ("", "eyes-fallen"),
        ("#use-frame", "eyes-refilled"),
        ("", "eyes-after"),
        ("item replace entity @s weapon.mainhand with minecraft:ender_eye 1", "eyes-more"),
        ("#eye-frame", "eyes-at-frame"),
        ("#eye-up", "eyes-used"),
        ("", "eyes-using"),
        ("#release", "eyes-let-go"),
        ("summon minecraft:eye_of_ender 0.5 -58 4.5 \{Motion:[0.05d,0.1d,0.0d]\}", "eyes-eye"),
        ("summon minecraft:eye_of_ender -0.5 -58 5.5 \{Item:\{id:\"minecraft:diamond\",count:3\},Silent:1b,Motion:[0.0d,0.0d,-0.02d]\}", "eyes-diamond"),
        ("", "eyes-flying"),
        ("", "eyes-flying-more"),
        ("", "eyes-first-gone"),
        ("", "eyes-gone"),
    ]
}

// `bossbars`' steps (D606): the bot, an operator, with Mate, on a world whose saved boss bars are
// `calcite:saved`, shown, whose players it's among, so it's shown it as it joins;
// `calcite:hidden`, unseen, with Mate among its players; and `calcite:plain`, with only its name.
// It lists them and asks after them; shows the hidden one, to Mate, twice; adds one, again, and
// one whose name has a selector, then has the level's random draw; gives the new one both
// players, again, sets its value, again, its most, and a value past it, its color, again, its
// notches, its name, again; hides it, sets its value unseen and shows it again; gives it only
// Mate; stores a list's count into its value and a failure's into its most, which is then 0,
// and into a bar there isn't; gives it no one, twice; removes the one with a selector, twice;
// gives the saved one itself, which it has. Then it's killed and respawns, another player, so
// the saved bar still has the one who died, which it's sent on as before: asked after, its value
// set, and given no one, which takes the bar from it, and itself again, which shows it it. Last,
// the hidden one's removed and the plain one given both players, which it's saved with; and it
// asks for the bars' IDs, as `bossbar get` and `execute store` suggest them.
fn bossbar_steps() -> List<(str, str)> {
    return [
        ("bossbar list", "bossbars-list-saved"),
        ("bossbar get calcite:saved players", "bossbars-saved-players"),
        ("bossbar get calcite:saved value", "bossbars-saved-value"),
        ("bossbar get calcite:saved max", "bossbars-saved-max"),
        ("bossbar get calcite:hidden visible", "bossbars-hidden-visible"),
        ("bossbar get calcite:hidden players", "bossbars-hidden-players"),
        ("bossbar set calcite:hidden visible true", "bossbars-show"),
        ("bossbar set calcite:hidden visible true", "bossbars-show-again"),
        ("bossbar add calcite:new \"New\"", "bossbars-add"),
        ("bossbar add calcite:new \"Again\"", "bossbars-add-again"),
        ("bossbar add calcite:named [\{text:\"Hi \"\},\{selector:\"@s\"\}]", "bossbars-add-selector"),
        ("random value 1..1000000", "bossbars-random"),
        ("bossbar set calcite:new players @a", "bossbars-players-all"),
        ("bossbar set calcite:new players @a", "bossbars-players-again"),
        ("bossbar set calcite:new value 25", "bossbars-value"),
        ("bossbar set calcite:new value 25", "bossbars-value-again"),
        ("bossbar set calcite:new max 50", "bossbars-max"),
        ("bossbar set calcite:new value 80", "bossbars-value-past"),
        ("bossbar set calcite:new color purple", "bossbars-color"),
        ("bossbar set calcite:new color purple", "bossbars-color-again"),
        ("bossbar set calcite:new style notched_6", "bossbars-style"),
        ("bossbar set calcite:new name \{text:\"Renamed\",bold:true\}", "bossbars-name"),
        ("bossbar set calcite:new name \{text:\"Renamed\",bold:true\}", "bossbars-name-again"),
        ("bossbar set calcite:new visible false", "bossbars-hide"),
        ("bossbar set calcite:new value 10", "bossbars-value-hidden"),
        ("bossbar set calcite:new visible true", "bossbars-show-new"),
        ("bossbar set calcite:new players Mate", "bossbars-players-mate"),
        ("bossbar get calcite:new players", "bossbars-get-mate"),
        ("execute store result bossbar calcite:new value run bossbar list", "bossbars-store-value"),
        ("execute store success bossbar calcite:new max run bossbar get calcite:nothing value", "bossbars-store-max"),
        ("bossbar get calcite:new max", "bossbars-get-max"),
        ("execute store result bossbar calcite:nothing value run list", "bossbars-store-nothing"),
        ("bossbar set calcite:new players", "bossbars-no-one"),
        ("bossbar set calcite:new players", "bossbars-no-one-again"),
        ("bossbar remove calcite:named", "bossbars-remove"),
        ("bossbar remove calcite:named", "bossbars-remove-again"),
        ("bossbar set calcite:saved players @s", "bossbars-saved-self"),
        ("kill", "bossbars-kill"),
        ("", "bossbars-respawns"),
        ("", "bossbars-back"),
        ("bossbar get calcite:saved players", "bossbars-dead-players"),
        ("bossbar set calcite:saved value 60", "bossbars-dead-value"),
        ("bossbar set calcite:saved players", "bossbars-dead-no-one"),
        ("bossbar set calcite:saved players @s", "bossbars-alive-self"),
        ("bossbar get calcite:saved players", "bossbars-alive-players"),
        ("bossbar remove calcite:hidden", "bossbars-remove-hidden"),
        ("bossbar set calcite:plain players @a", "bossbars-plain-players"),
        ("bossbar list", "bossbars-list"),
        ("/bossbar get ", "bossbars-suggest-ids"),
        ("/execute store result bossbar calcite:s", "bossbars-suggest-store"),
    ]
}

// `dragon`'s steps (D608): the bot, an operator, in survival mode at the end fixture's spawn, with
// a netherite axe of sharpness 255, summons an ender dragon without AI 8 blocks south, which
// hovers, and hits it: the first hit's quarter and 1 more counted as it sits, the second's past a
// quarter of its health, so it takes off; then, as it no longer sits, knocked back, till it would
// die, its health left at 1 as it's dying; and once more, which hurts it no more; an arrow falls
// through it, as its body can't be hit (D610). Then an end crystal 12 blocks north, and a dragon
// without AI 8 north whose saved phase is none there is, so it's in its holding pattern, hit twice,
// knocked back, which the crystal then heals once it's found it. Then one without AI 8 east, its
// health 1, hit, which kills it as it sits: it rises for 200 ticks, its experience given from its
// 155th, its death heard by every player at its first, and it's gone at its 200th. Last, one with
// AI 24 blocks up and 16 west, which hovers where it first was, flying about it, its parts placed
// as it flies (D611); then primed TNT of a power of 6 where it was summoned, whose explosion
// hurts it through its parts as well as its body, the most of them, its neck's or head's whole
// hurt rather than its body's quarter and 1 (D667). A dragon without AI won't do, as its parts
// are placed only where it has AI. Then a powered creeper's explosion there, silent, whose
// creeper the dragon keeps as what last hurt it, `setLastHurtByMob`, saved with it though the
// creeper's gone (D676); the rest are saved.
fn dragon_steps() -> List<(str, str)> {
    return [
        ("item replace entity @s weapon.mainhand with minecraft:netherite_axe[enchantments=\{sharpness:255\}]", "dragon-axe"),
        ("summon ender_dragon ~ ~ ~8 \{NoAI:1b\}", "dragon-summoned"),
        ("#hit-dragon", "dragon-hit-sitting"),
        ("#hit-dragon", "dragon-hit-takeoff"),
        ("#hit-dragon", "dragon-hit-3"),
        ("#hit-dragon", "dragon-hit-4"),
        ("#hit-dragon", "dragon-hit-5"),
        ("#hit-dragon", "dragon-hit-dying"),
        ("#hit-dragon", "dragon-hit-dead"),
        ("summon arrow ~ ~10 ~8 \{Motion:[0.0,-1.0,0.0]\}", "dragon-arrow"),
        ("summon end_crystal ~ ~ ~-12", "dragon-crystal"),
        ("summon ender_dragon ~ ~ ~-8 \{NoAI:1b,DragonPhase:99\}", "dragon-holding"),
        ("#hit-dragon", "dragon-holding-hit"),
        ("#hit-dragon", "dragon-holding-hit-again"),
        ("", "dragon-healing"),
        ("", "dragon-healing-more"),
        ("", "dragon-healed"),
        ("summon ender_dragon ~8 ~ ~ \{NoAI:1b,Health:1f\}", "dragon-weak"),
        ("#hit-dragon", "dragon-killed"),
        ("", "dragon-dying-1"),
        ("", "dragon-dying-2"),
        ("", "dragon-dying-3"),
        ("", "dragon-dying-4"),
        ("", "dragon-dying-5"),
        ("", "dragon-dying-6"),
        ("", "dragon-dying-7"),
        ("", "dragon-dying-8"),
        ("", "dragon-dying-9"),
        ("", "dragon-dying-10"),
        ("", "dragon-dying-11"),
        ("summon ender_dragon ~-16 ~24 ~", "dragon-hovering"),
        ("", "dragon-hovering-1"),
        ("", "dragon-hovering-2"),
        ("", "dragon-hovering-3"),
        ("", "dragon-hovering-4"),
        ("", "dragon-hovering-5"),
        ("", "dragon-hovering-6"),
        ("summon tnt ~-16 ~24 ~ \{fuse:1s,explosion_power:6.0f\}", "dragon-blasted"),
        ("", "dragon-blasted-after"),
        ("summon minecraft:creeper ~-16 ~24 ~ \{ignited:1b,NoAI:1b,Fuse:1s,powered:1b,Silent:1b\}", "dragon-crept"),
        ("", "dragon-crept-after"),
    ]
}

// `dragon-parts`' steps (CAL-167): the bot, an operator, in creative mode, which an ender
// dragon's wings and head pass by, `NO_CREATIVE_OR_SPECTATOR`, holding a netherite axe of
// sharpness 5, summons one with AI 3 above it, alone, which hovers there, flying about where it
// first was, its parts placed as it flies (D611); then hits its parts, each 20 ticks after the
// last: its neck, which takes the whole of the hit, its body and a wing, which take a quarter of
// it and 1, its head, its first tail part and its other wing, any out of its reach not hit. As
// it sits, no hit knocks it back, and their sum is short of a quarter of its health, so it stays.
// Then an arrow the bot owns falls onto its body from 4 above where its flight about its place
// has it then, 3.45, -57, 3.67, which it takes a quarter of and 1 (D669), as `execute at` an
// entity that isn't a player isn't Calcite's yet; and another onto the body of a
// second, summoned scanning 24 east, beyond either's wings' reach of the other, which, sitting,
// takes none of it and sets it alight, the arrow turned back. The session's over before the
// second's scan, 100 ticks, has it take off.
fn dragon_parts_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "parts-creative"),
        ("item replace entity @s weapon.mainhand with minecraft:netherite_axe[enchantments=\{sharpness:5\}]", "parts-axe"),
        ("summon ender_dragon ~ ~3 ~", "parts-summoned"),
        ("", "parts-hovering"),
        ("#hit-part 1", "parts-neck"),
        ("#hit-part 2", "parts-body"),
        ("#hit-part 6", "parts-wing"),
        ("#hit-part 0", "parts-head"),
        ("#hit-part 3", "parts-tail"),
        ("#hit-part 7", "parts-wing-again"),
        ("summon arrow 3.45 -53 3.67 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],Motion:[0.0,-2.0,0.0]\}", "parts-arrow"),
        ("summon ender_dragon ~24 ~3 ~ \{DragonPhase:6\}", "parts-scanning"),
        ("summon arrow ~24 ~12 ~ \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],Motion:[0.0,-2.0,0.0]\}", "parts-spurned"),
    ]
}

// `dragon-strikes`' steps (D677): the bot, an operator, in creative mode, which an ender dragon's
// wings and head pass by, summons a cow without AI 4 east of it and an armor stand 4 west, then
// one with AI 3 above it, which hovers there, flying about where it first was; its wings push
// both away from the middle of its body and hurt the cow, by 5 where no mob hurt it in its last 2
// ticks, its head by 10, till it dies, and the stand, which a mob's attack never breaks, is only
// pushed.
fn dragon_strikes_steps() -> List<(str, str)> {
    return [
