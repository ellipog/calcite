// What `armadillo` does on the `armadillo` fixture's world (CAL-160), at the spawn with empty
// hands, penned with Dilly, by the server's clock from once it's loaded, as the armadillos never
// let the server go quiet: it stands while they idle; at 200 it sprints, which scares Dilly, who
// rolls up; at 260 it stops, and she unrolls once the danger she saw runs out; at 420 it hits her,
// the second armadillo the server sent, after Rolly, which rolls her up, and at 440 again, rolled
// up; and it leaves at 600.
fn armadillo_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "idle"))
    packets.push(Dug.SprintAt(true, 200, "sprint"))
    packets.push(Dug.SprintAt(false, 260, "stop"))
    packets.push(Dug.Mark(340, "unroll"))
    packets.push(Dug.HitZombie(1, 420, "hit"))
    packets.push(Dug.HitZombie(1, 440, "hit-rolled"))
    packets.push(Dug.Mark(500, "after"))
    packets.push(Dug.Leave(600))
    return [Dig { name: String(), packets: packets }]
}

// What `requeue` does on the `requeue` fixture's world (CAL-184), by the server's clock from once
// it's loaded, at the spawn in the pen in chunk (0, 0): at 100 it summons Bea, an armadillo, in
// the pen 40 blocks east, in chunk (2, 0), then Ann in its own, in one tick, so Bea ticks first;
// at 200 it goes 25 blocks west, into chunk −2, so Bea's chunk is 4 from it and ticks its blocks
// but not her; at 260 it comes back, and her chunk's entities tick again, at the tick list's end,
// after Ann; at 340 it goes 72 blocks east, into chunk 4, so Ann's chunk stops ticking her; at
// 400 it comes back, and Ann ticks after Bea again; it leaves at 560.
fn requeue_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.CommandsAt("#all summon armadillo 40.5 -60 1.5 \{PersistenceRequired:1b,CustomName:\"Bea\",Rotation:[90.0f,0.0f]\};summon armadillo 1.5 -60 1.5 \{PersistenceRequired:1b,CustomName:\"Ann\",Rotation:[90.0f,0.0f]\}", 100, "summons"))
    packets.push(Dug.CommandAt("tp @s -24.5 -60 0.5", 200, "west"))
    packets.push(Dug.CommandAt("tp @s 0.5 -60 0.5", 260, "back"))
    packets.push(Dug.CommandAt("tp @s 72.5 -60 0.5", 340, "east"))
    packets.push(Dug.CommandAt("tp @s 0.5 -60 0.5", 400, "back-again"))
    packets.push(Dug.Mark(480, "after"))
    packets.push(Dug.Leave(560))
    return [Dig { name: String(), packets: packets }]
}

// What `brush` does on the `armadillo` fixture's world (CAL-160), as `armadillo` but with a brush
// in its main hand: at 200, 240, 280 and 320 it uses it on Dilly, the second armadillo the server
// sent, who drops a scute each time, the brush worn by 16 each time and broken by the fourth; at
// 360 it uses its empty hand on her, which does nothing; it leaves at 500.
fn brush_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "idle"))
    packets.push(Dug.UseZombie(1, 200, "brush"))
    packets.push(Dug.UseZombie(1, 240, "brush-again"))
    packets.push(Dug.UseZombie(1, 280, ""))
    packets.push(Dug.UseZombie(1, 320, "brush-breaks"))
    packets.push(Dug.UseZombie(1, 360, "empty-hand"))
    packets.push(Dug.Mark(420, "after"))
    packets.push(Dug.Leave(500))
    return [Dig { name: String(), packets: packets }]
}

// What `cure` does on `end`'s world (CAL-175), in survival, by the server's clock from once it's
// loaded: at midnight it builds a hollow glass pen with a row of iron bars in it, which speed a
// cure, and summons a zombie villager in it, a desert farmer of level 2 with experience, whose
// cure has 300 ticks to go, the bot its curer; then two without AI by it, 2 blocks south and 2
// east, the second and third zombies the server sent, the second weakened as it's summoned, as
// Calcite can't select mobs for `effect` yet. It uses a golden apple on the first, which isn't
// weakened, so nothing comes of it; then on the weakened one, which starts its cure, its weakness
// taken away, its strength and entity event 16. The penned one is cured into a villager with
// level event 1027, nausea, the bot's gossip and the bot's advancement; it leaves at 500.
fn cure_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.CommandAt("time set midnight", 60, "cure-night"))
    packets.push(Dug.CommandAt("fill 8 -61 1 14 -57 7 glass hollow", 62, "cure-pen"))
    packets.push(Dug.CommandAt("fill 9 -60 2 13 -60 2 iron_bars", 64, "cure-bars"))
    packets.push(Dug.CommandAt("summon zombie_villager 11.5 -60 5.5 \{ConversionTime:300,ConversionPlayer:[I;-1155928273,798308776,-1951547997,-315148217],VillagerData:\{profession:\"minecraft:farmer\",level:2,type:\"minecraft:desert\"\},Xp:12\}", 66, "cure-penned"))
    packets.push(Dug.CommandAt("summon zombie_villager 0.5 -60 2.5 \{NoAI:1b\}", 68, "cure-still"))
    packets.push(Dug.CommandAt("summon zombie_villager 2.5 -60 0.5 \{NoAI:1b,active_effects:[\{id:\"minecraft:weakness\",duration:1200,amplifier:0b\}]\}", 69, "cure-weak"))
    packets.push(Dug.CommandAt("item replace entity @s weapon.mainhand with minecraft:golden_apple 3", 70, "cure-apples"))
    packets.push(Dug.UseZombie(1, 90, "cure-unweakened"))
    packets.push(Dug.UseZombie(2, 120, "cure-started"))
    packets.push(Dug.Mark(200, "curing"))
    packets.push(Dug.Mark(320, "cured"))
    packets.push(Dug.Mark(420, "after"))
    packets.push(Dug.Leave(500))
    return [Dig { name: String(), packets: packets }]
}

