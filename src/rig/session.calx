// `naming`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in creative mode,
// summons a cow, a light blue sheep, a zombie, a creeper and a pig without AI around it in one
// tick; then names the cow with a name tag; uses a cow's spawn egg on it, a calf; a sheep's on the
// sheep, a lamb of its colour; a zombie's on the zombie, a baby zombie; a creeper's on the
// creeper, which can't be a baby; a pig's on the cow, which isn't its kind; a name tag with no name
// on the pig; and a named cow's spawn egg on the cow, a named calf. It watches for 5 seconds.
// `bogged`'s steps (CAL-200), where `riding`'s are, at midnight, on normal: the bot, in survival
// mode, its speed taken off, whose updates every 600 ticks would meet its poison's hurts in an order
// vanilla's effects, kept by identity, don't fix, and with resistance III, so their arrows don't
// kill it, summons a bogged ten blocks south of it
// and a parched ten west, away from the end portal to its east, each with a bow as it spawns,
// which take it up as their target and shoot it every 70 ticks or so, a bogged's arrows poisoning
// it and a parched's weakening it. It watches for 12 seconds.
fn bogged_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "bogged-night"),
        ("gamemode survival", "bogged-survival"),
        ("effect clear @s", "bogged-clear"),
        ("effect give @s resistance 600 2 true", "bogged-armor"),
        ("summon bogged 0.5 -60 10.5", "bogged-shooter"),
        ("summon parched -9.5 -60 0.5", "bogged-parched"),
        ("", "bogged-1"), ("", "bogged-2"), ("", "bogged-3"), ("", "bogged-4"), ("", "bogged-5"), ("", "bogged-6"),
        ("", "bogged-7"), ("", "bogged-8"), ("", "bogged-9"), ("", "bogged-10"), ("", "bogged-11"),
        ("", "bogged-after"),
    ]
}

// `withered`'s steps (CAL-200), where `riding`'s are, at midnight, on normal: the bot, in survival
// mode, its speed taken off, as in `bogged`, and with resistance V, which takes all their hurts,
// summons a wither skeleton eight blocks south of it, given a stone sword as it spawns, which
// comes to it and hits it, each hit withering it for 10 seconds, and one ten blocks west with the
// bow its data gives it, which shoots it with arrows alight. It watches for 12 seconds.
fn withered_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "withered-night"),
