    ]
}

// `shulkers`' steps (CAL-200), where `zpiglins`' are: the bot, in creative mode, which no shulker
// takes as its target, summons three shulkers in one tick: one east of it, hurt down to 4, one
// south-west on the ground, and one 3 blocks up north, which can't stay there and teleports till
// it finds a face on the ground, `findNewAttachment`. Each looks across at it, peeks now and then,
// a third open, heard opening and closing. It hits the first, closed, heard so, which teleports
// 1 in 4 below half its health; then again later. It watches for 20 seconds.
fn shulkers_steps() -> List<(str, str)> {
    return [
        ("time set day", "shulkers-day"),
        ("gamemode creative", "shulkers-creative"),
        ("#all summon shulker 2.5 -60 0.5 \{Health:4f\};summon shulker -3.5 -60 4.5;summon shulker 0.5 -57 -4.5", "shulkers-summon"),
        ("#hit-any 0", "shulkers-hit"),
        ("", "shulkers-1"), ("", "shulkers-2"), ("", "shulkers-3"), ("", "shulkers-4"), ("", "shulkers-5"),
        ("", "shulkers-6"), ("", "shulkers-7"), ("", "shulkers-8"), ("", "shulkers-9"),
        ("#hit-any 0", "shulkers-hit-again"),
        ("", "shulkers-10"), ("", "shulkers-11"), ("", "shulkers-12"), ("", "shulkers-13"), ("", "shulkers-14"),
        ("", "shulkers-15"), ("", "shulkers-16"), ("", "shulkers-17"), ("", "shulkers-18"), ("", "shulkers-19"),
        ("", "shulkers-after"),
    ]
}

// `shulkerbullets`' steps (CAL-200), where `shulkers`' are: the bot, in survival mode, with
// resistance V, summons two shulkers, one east of it and one south-west. Each takes it as its
// target, seen, `ShulkerNearestAttackGoal`, opens all the way and shoots at it every 1 to 5.5
// seconds, its bullets homing on it a block at a time, `selectNextMoveDirection`, each that hits
// it hurting it by 4 and lifting it, levitation for 10 seconds. It watches for 20 seconds.
fn shulkerbullets_steps() -> List<(str, str)> {
    return [
        ("time set day", "bullets-day"),
        ("gamemode survival", "bullets-survival"),
        ("effect clear @s", "bullets-clear"),
        ("effect give @s resistance 600 4 true", "bullets-armor"),
        ("#all summon shulker 3.5 -60 0.5;summon shulker -4.5 -60 5.5", "bullets-summon"),
        ("", "bullets-1"), ("", "bullets-2"), ("", "bullets-3"), ("", "bullets-4"), ("", "bullets-5"),
        ("", "bullets-6"), ("", "bullets-7"), ("", "bullets-8"), ("", "bullets-9"), ("", "bullets-10"),
        ("", "bullets-11"), ("", "bullets-12"), ("", "bullets-13"), ("", "bullets-14"), ("", "bullets-15"),
        ("", "bullets-16"), ("", "bullets-17"), ("", "bullets-18"), ("", "bullets-19"),
        ("", "bullets-after"),
    ]
}

// `gamerules`' steps (CAL-298), where `riding`'s are: the bot, an operator, asks what
// `keep_inventory` is, sets it, and sets it again, which fails as it's that already; asks what
// `random_tick_speed` is by its full name and sets it to 0; then sets the rules vanilla's server
// tells its players of as they change, `onGameRuleChanged`: `reduced_debug_info`, an entity
// event; `immediate_respawn` and `limited_crafting`, game events; `locator_bar` off, its links
// broken; and `advance_time` off and on, the clocks sent each time.
fn gamerules_steps() -> List<(str, str)> {
    return [
        ("gamerule keep_inventory", "rules-ask"),
        ("gamerule keep_inventory true", "rules-keep"),
        ("gamerule keep_inventory true", "rules-again"),
        ("gamerule minecraft:random_tick_speed", "rules-ticks"),
        ("gamerule random_tick_speed 0", "rules-ticks-off"),
        ("gamerule reduced_debug_info true", "rules-debug"),
        ("gamerule immediate_respawn true", "rules-respawn"),
        ("gamerule limited_crafting true", "rules-crafting"),
        ("gamerule locator_bar false", "rules-bar"),
        ("gamerule advance_time false", "rules-clock"),
        ("gamerule advance_time true", "rules-clock-on"),
        ("", "rules-after"),
    ]
}

// `nightmares`' steps (CAL-200), where `riding`'s are, on normal, the bot's saved statistics
// 2,000,000 ticks since it last rested: at midnight, in survival mode, its speed taken off, as in
// `bogged`, and with resistance V, which takes all hurts, it turns natural spawning on, which
// spawns creatures only, as monsters wait for `updateMobSpawningFlags`, which `spawn_mobs` doesn't
// call; then `spawn_monsters` off and on, which does, so the spawners run, the phantoms' due at
// once, `PhantomSpawner.tick`, with the sky dark enough: a draw against the difficulty and one
// against its time since rest, then 1 to 3 phantoms 20 to 34 blocks above it, finalized as
// natural spawning finalizes them, which find it and bite it. The monsters natural spawning makes
// about it at night come too. It watches for 15 seconds.
fn nightmares_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "nightmares-night"),
        ("gamemode survival", "nightmares-survival"),
        ("effect clear @s", "nightmares-clear"),
        ("effect give @s resistance 600 4 true", "nightmares-armor"),
        ("gamerule spawn_mobs true", "nightmares-spawning"),
        ("", "nightmares-creatures"),
        ("gamerule spawn_monsters false", "nightmares-no-monsters"),
        ("gamerule spawn_monsters true", "nightmares-monsters"),
        ("#wait 15", "nightmares-wait"),
        ("", "nightmares-after"),
    ]
}

// `phantoms`' steps (CAL-200), where `riding`'s are, at midnight, on normal: the bot, in survival
// mode, its speed taken off, as in `bogged`, and with resistance V, which takes all their hurts,
// summons a phantom ten blocks up and eight south of it, finalized, so circling five blocks above
// where it was summoned, and one of size 3 twelve up and eight west, not finalized as its data
// has it, so circling where it first chooses to. They look for it, circle above it, swoop on it
// and bite it. It watches for 18 seconds.
fn phantoms_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "phantoms-night"),
        ("gamemode survival", "phantoms-survival"),
        ("effect clear @s", "phantoms-clear"),
        ("effect give @s resistance 600 4 true", "phantoms-armor"),
        ("summon phantom 0.5 -50 8.5", "phantoms-small"),
        ("summon phantom -7.5 -48 0.5 \{size:3\}", "phantoms-big"),
        ("", "phantoms-1"), ("", "phantoms-2"), ("", "phantoms-3"), ("", "phantoms-4"), ("", "phantoms-5"), ("", "phantoms-6"),
        ("", "phantoms-7"), ("", "phantoms-8"), ("", "phantoms-9"), ("", "phantoms-10"), ("", "phantoms-11"), ("", "phantoms-12"),
        ("", "phantoms-13"), ("", "phantoms-14"), ("", "phantoms-15"), ("", "phantoms-16"), ("", "phantoms-17"),
        ("", "phantoms-after"),
    ]
}

// `caves`' steps (CAL-200), where `riding`'s are, at midnight, on normal: the bot, in survival
// mode, its speed taken off, as in `bogged`, and with resistance V, which takes all their hurts,
// summons a cave spider six blocks south of it and one eight blocks west, which come to it and
// bite it, each bite poisoning it for 7 seconds. It watches for 12 seconds.
fn caves_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "caves-night"),
        ("gamemode survival", "caves-survival"),
        ("effect clear @s", "caves-clear"),
        ("effect give @s resistance 600 4 true", "caves-armor"),
        ("summon cave_spider 0.5 -60 6.5", "caves-south"),
        ("summon cave_spider -7.5 -60 0.5", "caves-west"),
        ("", "caves-1"), ("", "caves-2"), ("", "caves-3"), ("", "caves-4"), ("", "caves-5"), ("", "caves-6"),
        ("", "caves-7"), ("", "caves-8"), ("", "caves-9"), ("", "caves-10"), ("", "caves-11"),
        ("", "caves-after"),
    ]
}

// `bogshear`'s steps (CAL-200), where `riding`'s are, at midnight, on normal: the bot, in survival
// mode, summons a bogged without AI west of it, away from the end portal to its east, and shears
// it twice, the first time its mushrooms dropped at its height, the second time sheared already.
// It watches for 3 seconds, picking up what falls near it.
fn bogshear_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "bogshear-night"),
        ("gamemode survival", "bogshear-survival"),
        ("summon bogged -1.5 -60 0.5 \{NoAI:1b,PersistenceRequired:1b\}", "bogshear-mob"),
        ("item replace entity @s weapon.mainhand with shears", "bogshear-shears"),
        ("#use-mob 0", "bogshear-shear"),
        ("#use-mob 0", "bogshear-shorn"),
        ("", "bogshear-1"), ("", "bogshear-2"), ("", "bogshear-3"),
        ("", "bogshear-after"),
    ]
}

// `shearing`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, summons a red sheep, a lamb, a cow, a red mooshroom and a brown one fed a flower, all
// without AI, around it in one tick; then shears the sheep twice, the second time shorn, and the
// lamb, which can't be; milks the cow with a bucket, then with one of two; fills a bowl from the
// brown mooshroom, suspicious stew, then another, mushroom stew; and shears the red mooshroom into
// a cow, its mushrooms dropped. It watches for 5 seconds, picking up what falls near it.
fn shearing_steps() -> List<(str, str)> {
    return [
        ("time set day", "shearing-day"),
        ("gamemode survival", "shearing-survival"),
        ("#all summon sheep 2.5 -60 0.5 \{NoAI:1b,Color:14b\};summon sheep -1.5 -60 0.5 \{NoAI:1b,Age:-24000\};summon cow 0.5 -60 2.5 \{NoAI:1b\};summon mooshroom 0.5 -60 -1.5 \{NoAI:1b\};summon mooshroom 2.5 -60 2.5 \{NoAI:1b,Type:\"brown\",stew_effects:[\{id:\"minecraft:night_vision\",duration:100\}]\}", "shearing-mobs"),
        ("item replace entity @s weapon.mainhand with shears", "shearing-shears"),
        ("#use-mob 0", "shearing-sheep"),
        ("#use-mob 0", "shearing-shorn"),
        ("#use-mob 1", "shearing-lamb"),
        ("item replace entity @s weapon.mainhand with bucket", "shearing-bucket"),
        ("#use-mob 2", "shearing-milk"),
        ("item replace entity @s weapon.mainhand with bucket 2", "shearing-buckets"),
        ("#use-mob 2", "shearing-milk-more"),
        ("item replace entity @s weapon.mainhand with bowl 2", "shearing-bowls"),
        ("#use-mob 4", "shearing-suspicious"),
        ("#use-mob 4", "shearing-stew"),
        ("item replace entity @s weapon.mainhand with shears", "shearing-shears-again"),
        ("#use-mob 3", "shearing-mooshroom"),
        ("", "shearing-1"), ("", "shearing-2"), ("", "shearing-3"), ("", "shearing-4"), ("", "shearing-5"),
        ("", "shearing-after"),
    ]
}

// `flowered`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, holding two oxeye daisies, summons a brown mooshroom and a red one without AI, feeds the
// brown one a daisy, which it keeps the effect of, then tries the other, which only smokes; milks
// it into a bowl of suspicious stew, which it forgets the effect for; feeds it a poppy, which it
// keeps; and tries the red one with the last daisy, which does nothing. Each wait is a second.
fn flowered_steps() -> List<(str, str)> {
    return [
        ("time set day", "flowered-day"),
        ("gamemode survival", "flowered-survival"),
        ("#all summon mooshroom 2.5 -60 0.5 \{NoAI:1b,Type:\"brown\"\};summon mooshroom -1.5 -60 0.5 \{NoAI:1b\}", "flowered-mobs"),
        ("item replace entity @s weapon.mainhand with oxeye_daisy 2", "flowered-daisies"),
        ("#use-mob 0", "flowered-fed"),
        ("#use-mob 0", "flowered-smoke"),
        ("item replace entity @s weapon.mainhand with bowl", "flowered-bowl"),
        ("#use-mob 0", "flowered-stew"),
        ("item replace entity @s weapon.mainhand with poppy", "flowered-poppy"),
        ("#use-mob 0", "flowered-fed-again"),
        ("item replace entity @s weapon.mainhand with oxeye_daisy", "flowered-daisy"),
        ("#use-mob 1", "flowered-red"),
        ("", "flowered-after"),
    ]
}

// `agelock`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, summons a calf, a lamb and a cow without AI around it in one tick; then locks the calf's
// age with a golden dandelion and tries again while its particles show, which does nothing;
// feeds it wheat, which doesn't age it locked; waits, then lets its age go with another
// dandelion, locks the lamb's, and tries one on the cow, which is grown. It watches for 5
// seconds.
fn agelock_steps() -> List<(str, str)> {
    return [
        ("time set day", "agelock-day"),
        ("gamemode survival", "agelock-survival"),
