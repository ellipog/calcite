        ("", "frost-zombie-1"), ("", "frost-zombie-2"), ("", "frost-zombie-3"), ("", "frost-zombie-4"), ("", "frost-zombie-5"),
        ("", "frost-zombie-6"), ("", "frost-zombie-7"), ("", "frost-zombie-8"), ("", "frost-zombie-9"), ("", "frost-zombie-10"),
        ("", "frost-zombie-11"), ("", "frost-zombie-12"), ("", "frost-zombie-13"), ("", "frost-zombie-14"),
        ("", "frost-zombie-after"),
    ]
}

