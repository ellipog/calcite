        ("summon pufferfish 2.5 -62 -0.5 \{NoAI:1b,PuffState:2\}", "pufferfish-puffed"),
        ("summon pufferfish -9.5 -60 -9.5", "pufferfish-land"),
        ("item replace entity @s weapon.mainhand with water_bucket", "pufferfish-bucket"),
        ("#use-mob 3", "pufferfish-caught"),
        ("", "pufferfish-1"), ("", "pufferfish-2"), ("", "pufferfish-3"), ("", "pufferfish-4"), ("", "pufferfish-5"),
        ("", "pufferfish-6"), ("", "pufferfish-7"), ("", "pufferfish-8"), ("", "pufferfish-9"), ("", "pufferfish-10"),
        ("", "pufferfish-11"), ("", "pufferfish-12"), ("", "pufferfish-13"), ("", "pufferfish-14"), ("", "pufferfish-15"),
