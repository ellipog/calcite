// `dragon-fireball`'s steps (D618): the bot, an operator, in survival mode with resistance IV at
// the end fixture's spawn, summons dragon fireballs: one falling onto the ground 8 off, which
// leaves its cloud where it hits; one flying at an armor stand, which leaves its cloud where the
// stand is; one standing still, which stays; a silent one falling, whose event says so; and one
// flying at the bot with no acceleration, slowing, which leaves its cloud where the bot is,
// hurting it, till it goes off out of the clouds' way to watch them grow.
fn dragon_fireball_steps() -> List<(str, str)> {
    return [
        ("summon dragon_fireball 8.5 -56 0.5 \{Motion:[0.0,-0.2,0.0]\}", "dragon-fireball-down"),
        ("summon armor_stand -8.5 -60 0.5", "dragon-fireball-stand"),
        ("summon dragon_fireball -8.5 -59 6.5 \{Motion:[0.0,0.0,-0.3]\}", "dragon-fireball-at-stand"),
        ("summon dragon_fireball 0.5 -59.5 -20.5", "dragon-fireball-still"),
        ("summon dragon_fireball 4.5 -55 -8.5 \{Motion:[0.0,-0.3,0.0],Silent:1b\}", "dragon-fireball-silent"),
        ("summon dragon_fireball 0.5 -59 8.5 \{Motion:[0.0,0.0,-0.6],acceleration_power:0.0d\}", "dragon-fireball-at-bot"),
        ("", "dragon-fireball-1"),
        ("", "dragon-fireball-2"),
        ("tp @s 12.5 -60 14.5", "dragon-fireball-away"),
        ("", "dragon-fireball-3"),
        ("", "dragon-fireball-4"),
        ("", "dragon-fireball-5"),
        ("", "dragon-fireball-6"),
        ("", "dragon-fireball-7"),
        ("", "dragon-fireball-8"),
    ]
}

