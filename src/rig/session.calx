// `zombie-eggs`' steps (CAL-201), where `wolves`' are: by night, the bot, in creative mode, fills
// the end portal with stone, CAL-307, lays turtle eggs on stone, where they never hatch, and
// summons a zombie wearing a helmet a few blocks off. It goes for the eggs, `ZombieAttackTurtleEggGoal`,
// stamping on them, heard, `entity.zombie.destroy_egg`, with egg particles, until each block of
// them is gone with poofs, `entity.turtle.egg_break`. It watches for 20 seconds.
fn zombie_eggs_steps() -> List<(str, str)> {
    return [
        ("time set 18000", "zombie-eggs-night"),
        ("fill 3 -61 -1 5 -61 1 minecraft:stone", "zombie-eggs-portal"),
        ("gamemode creative", "zombie-eggs-creative"),
        ("fill -3 -61 3 3 -61 9 minecraft:stone", "zombie-eggs-stone"),
        ("setblock 0 -60 6 minecraft:turtle_egg[eggs=2]", "zombie-eggs-two"),
        ("setblock -2 -60 8 minecraft:turtle_egg[eggs=4]", "zombie-eggs-four"),
