// What `armadillo` does on the `armadillo` fixture's world (CAL-160), at the spawn with empty
// hands, penned with Dilly, by the server's clock from once it's loaded, as the armadillos never
// let the server go quiet: it stands while they idle; at 200 it sprints, which scares Dilly, who
// rolls up; at 260 it stops, and she unrolls once the danger she saw runs out; at 420 it hits her,
// the second armadillo the server sent, after Rolly, which rolls her up, and at 440 again, rolled
// up; and it leaves at 600.
fn armadillo_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "idle"))
    packets.push(Dug.SprintAt(true, 200, "sprint"))
    packets.push(Dug.SprintAt(false, 260, "stop"))
    packets.push(Dug.Mark(340, "unroll"))
    packets.push(Dug.HitZombie(1, 420, "hit"))
    packets.push(Dug.HitZombie(1, 440, "hit-rolled"))
    packets.push(Dug.Mark(500, "after"))
    packets.push(Dug.Leave(600))
    return [Dig { name: String(), packets: packets }]
}

// What `brush` does on the `armadillo` fixture's world (CAL-160), as `armadillo` but with a brush
// in its main hand: at 200, 240, 280 and 320 it uses it on Dilly, the second armadillo the server
// sent, who drops a scute each time, the brush worn by 16 each time and broken by the fourth; at
// 360 it uses its empty hand on her, which does nothing; it leaves at 500.
fn brush_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "idle"))
    packets.push(Dug.UseZombie(1, 200, "brush"))
    packets.push(Dug.UseZombie(1, 240, "brush-again"))
    packets.push(Dug.UseZombie(1, 280, ""))
    packets.push(Dug.UseZombie(1, 320, "brush-breaks"))
    packets.push(Dug.UseZombie(1, 360, "empty-hand"))
    packets.push(Dug.Mark(420, "after"))
    packets.push(Dug.Leave(500))
    return [Dig { name: String(), packets: packets }]
}

// What `arrows` does on the `arrows` fixture's world (CAL-159), at the spawn with empty hands, by
// the server's clock from once it's loaded: it stands while the arrows fly, one onto its head, and
// three land by it, one of which it picks up; at 100 a mark as they lie; at 140 a mark once the
