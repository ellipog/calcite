        ("summon endermite ~-6 ~ ~ \{NoAI:1b\}", "targets-endermite"),
        ("summon enderman ~-10 ~ ~ \{PersistenceRequired:1b\}", "targets-enderman"),
        ("", "targets-11"),
        ("", "targets-12"),
        ("", "targets-13"),
        ("", "targets-14"),
        ("", "targets-15"),
        ("", "targets-16"),
    ]
}

// `zombie-convert`'s steps (CAL-244): `mob-targets`' bot at midnight, on normal, summons a farmer
// without AI 4 south of it, who's made no offers yet, another villager without AI 7 south and 2
// east, and a zombie 12 south, who takes up the nearer of them he sees and hits her till she
// dies, then the other: each he kills is turned into a zombie villager or not by a draw of his,
// as `Zombie.killedEntity` has it on normal, and one turned keeps her trade, the farmer's offers
// made as she's turned, and may take up the other herself.
fn zombie_convert_steps() -> List<(str, str)> {
    return [
